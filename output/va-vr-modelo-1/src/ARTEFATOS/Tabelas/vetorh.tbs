  l_generate          BOOLEAN; /* INSERIU A PENDÊNCIA */
BEGIN
    l_numten   := 10; /* 10 tentativas de inserção da pendência, caso contrário será lançado uma exceção */
    l_generate := FALSE;

    SP_USUTEL(l_usutel OUT);
    /*Formata Campos*/
    SP_INTSTR(p_numsma,'9999999999',l_numserial OUT);
    SP_INTSTR(p_numcra,'999999999999',l_icard OUT);
    l_numcpo := p_numcpo;


    /* ESTE LOOP IRÁ TENTAR INCLUIR A PENDÊNCIA, CASO ELA DEE ERRO, SERÁ TENTADO NOVAMENTE ATÉ ESGOTAR OS Nº DE TENTATIVAS */
    LOOP

        IF (l_generate = TRUE) THEN
            EXIT;
        END IF;

        IF (l_numten = 0) THEN
            RAISERROR 103 'SP_Atuali: Erro ao gerar pendência. Excedeu o número de tentativas.';
        ELSE
            l_numten := l_numten - 1;
        END IF;

        l_generate := TRUE;

        l_inform := p_inform;

