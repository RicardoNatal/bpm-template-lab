  l_codcpa := 82;     /* Intervalos para desconto de IR (Tabela: R036IRF)*/
  l_codtpa := 276;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.CodDep <> :NEW.CodDep)
   OR (:OLD.CmpIni <> :NEW.CmpIni)
   OR (:OLD.CmpFim <> :NEW.CmpFim)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R036IRF_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDEP', CONVERT(NUMBER_TO_CHAR, :OLD.CODDEP));
        SP_DATSTR(:OLD.CMPINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R036IRF_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:OLD.CMPFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCMPFIM', l_datTemp);
        SP_DATSTR(:NEW.CMPFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCMPFIM', l_datTemp);
      END;
    END IF; 
  END IF; 
END␀(Ô␀␀		SENIOR;0€␀␀ 

/* DELETE (OLD) */
TRIGGER R036IRF_ED AFTER DELETE ON R036IRF FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Intervalos para desconto de IR (Tabela: R036IRF)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 82;     /* Intervalos para desconto de IR (Tabela: R036IRF)*/
  l_codtpa := 275;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R036IRF_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDEP', CONVERT(NUMBER_TO_CHAR, :OLD.CODDEP));
        SP_DATSTR(:OLD.CMPINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R036IRF_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:OLD.CMPFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPFIM', l_datTemp);
      END;
  END IF; 
END␀␀␀=”␀␀␀␀␀␀␀␀␀+Ô␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀}␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀P%€$0.w␀Æÿ␀␀…Ó␀␀␀c,­␀	␀␀␀␀␀␀␀H@}S}Sp␀Æÿ␀␀Ô␀␀␀mDÑ␀	␀␀␀␀␀␀␀•JşEşEqC␀êÿ␀␀ÿ␀Ô␀‘␀␀␀␀␀␀␀␀Í␀P!␀P!␀h)␀␀Æÿ␀␀ÿ␀EÑ␀␀␀␀␀␀␀␀±G‡”␀␀‡”␀␀qC␀êÿ␀␀ÿ␀¿,±␀␀␀␀␀␀␀␀ <\+␀b+␀q␀Æÿ␀␀nÑ␀␀␀¯[­␀␀␀␀␀␀␀␀{[1[4[p␀Æÿ␀␀ÿ␀½␀␀­␀␀␀␀␀␀␀␀g¿␀␀a¿␀␀c¿␀␀p␀Æÿ␀␀ÿ␀•¹␀␀*␀␀␀␀␀␀␀’¼␀␀q¼␀␀q¼␀␀c␀␀␀ÿ␀␀ÿ␀˜¹␀␀1␀␀␀␀␀␀␀š¼␀␀
fn␀Æÿ␀␀ÿ␀à¼␀␀­␀␀␀␀␀␀␀␀É¾␀␀Û½␀␀¾␀␀p␀Æÿ␀␀ÿ␀³¹␀␀=␀␀␀␀␀␀␀–¼␀␀1¸␀␀`»␀␀c␀␀␀ÿ␀␀ÿ␀¢¹␀␀=␀␀␀␀␀␀␀•¼␀␀§q§qc␀␀␀ÿ␀␀ÿ␀¯¹␀␀<␀␀␀␀␀␀␀4␀¯␀␀Ÿ¼␀␀n␀Æÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀¼␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀,Ô␀␀…¬␀␀´␀	Ôÿ!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ!␀␀␀␀␀}␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ!␀␀␀␀␀P%€$0.w␀Æÿ␀␀…Ó␀␀␀c,­␀	Ôÿ!␀␀␀␀␀H@}S}Sp␀Æÿ␀␀Ô␀␀␀mDÑ␀	Ôÿ!␀␀␀␀␀‡JşEşEqC␀êÿ␀␀ÿ␀Öü␀␀­␀	Ôÿ!␀␀␀␀␀xş␀␀xş␀␀xş␀␀3)␀␀Æÿ␀␀ÿ␀½␀␀¹␀␀␀␀␀␀␀␀¾␀␀¾␀␀¾␀␀Q)␀␀Æÿ␀␀ÿ␀\␀jÔÿ#␀␀␀␀␀K␀Í␀J␀p␀Æÿ␀␀Ó␀␀␀H*Ôÿ#␀␀␀␀␀***␀␀ÿ␀␀Ó␀␀␀␀␀␀0;1;2;3;4;5-Ô␀␀		SENIOR;0©␀␀TRIGGER R036PIX_EI AFTER INSERT ON R036PIX FOR EACH ROW

DECLARE
L_CODPES      R033PES.CODPES%TYPE;
  l_DatAtu    DATE;
  l_Data_zero DATE;
  l_existe    BOOLEAN;
  L_DATALT      R033PIX.DATALT%TYPE;
  L_ULTSEQCON   R033PIX.SEQCON%TYPE;
  L_SEQCON      R033PIX.SEQCON%TYPE;
  L_TPCPIX      R033PIX.TPCPIX%TYPE;
  L_CHVPIX      R033PIX.CHVPIX%TYPE;
  
BEGIN
  /*Data atual*/
  l_DatAtu := CURDATE();
  /*Data zerada*/
  l_data_zero  := '31/12/1900,00:00:00';

  BEGIN
    /*Verifca se colaborador tem vínculo com pessoa*/
    SELECT CODPES INTO L_CODPES FROM R036DEP
    WHERE NUMEMP = :NEW.NUMEMP
      AND TIPCOL = :NEW.TIPCOL
      AND NUMCAD = :NEW.NUMCAD
      AND CODDEP = :NEW.CODDEP;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_CODPES := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R036DEP.CODPES';
  END;

  /*Se existe o vínculo com pessoa*/
  IF (L_CODPES > 0) THEN
    l_existe := TRUE;
    BEGIN
      /*Verificar se chave já existe na base*/
      SELECT DATALT,  SEQCON,  TPCPIX,  CHVPIX
        INTO L_DATALT,L_SEQCON,L_TPCPIX,L_CHVPIX
      FROM R033PIX
      WHERE CODPES = L_CODPES
        AND DATALT = :NEW.DATALT
        AND TPCPIX = :NEW.TPCPIX
        AND CHVPIX = :NEW.CHVPIX;
      EXCEPTION WHEN NO_DATA_FOUND THEN
        L_SEQCON := 0;
        L_DATALT := :NEW.DATALT;
        L_TPCPIX := :NEW.TPCPIX;
        L_CHVPIX := :NEW.CHVPIX;
        l_existe := FALSE;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler R033PIX';
    END;
    
    IF (l_Existe = TRUE) THEN
      BEGIN
        /*Se chave já existir, atualiza os campos e zera a data de encerramento*/
        UPDATE R033PIX SET DATENC = l_data_zero,
                           EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                           DEPAUX = :NEW.CODDEP, COLATI = 0, CANAUX = 0, DATAUX = l_Data_zero
         WHERE CODPES = L_CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON AND TPCPIX = L_TPCPIX AND CHVPIX = L_CHVPIX;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar a R033PIX';
      END;
    ELSE
      BEGIN
        SELECT IFNULL(MAX(SEQCON),0) INTO L_ULTSEQCON FROM R033PIX
        WHERE CODPES = L_CODPES;
        EXCEPTION WHEN NO_DATA_FOUND THEN
          L_ULTSEQCON := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler R033PIX';
      END;
      /*Gera próxima sequencia*/
      L_SEQCON := L_ULTSEQCON + 1;
      BEGIN
        /*Insere nova chave em R033PIX*/
        INSERT INTO R033PIX (CODPES,  DATALT,  SEQCON, DATABE,  DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX, TPCPIX,  CHVPIX)
                     VALUES (L_CODPES,L_DATALT,L_SEQCON,l_DatAtu,l_data_zero,:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODDEP, 0, 0, l_Data_zero,L_TPCPIX,L_CHVPIX);
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao inserir na R033PIX';
      END;
    END IF;
  END IF;
END␀.Ô␀␀		SENIOR;0Ø␀␀

TRIGGER R036PIX_EU AFTER UPDATE ON R036PIX FOR EACH ROW

DECLARE
L_CODPES      R033PES.CODPES%TYPE;
  L_SITAFA      R034FUN.SITAFA%TYPE;
  L_DEMITIDOS BOOLEAN;
  l_DatAtu    DATE;
  l_Data_zero DATE;
  l_existe    BOOLEAN;
  L_DATALT      R033PIX.DATALT%TYPE;
  L_ULTSEQCON   R033PIX.SEQCON%TYPE;
  L_SEQCON      R033PIX.SEQCON%TYPE;
  L_TPCPIX      R033PIX.TPCPIX%TYPE;
  L_CHVPIX      R033PIX.CHVPIX%TYPE;
BEGIN
  /*Data atual*/
  l_DatAtu := CURDATE();
  /*Data zerada*/
  l_data_zero  := '31/12/1900,00:00:00';
  
  BEGIN
    /*Verifica se colaborador tem vínculo com pessoa*/
    SELECT CODPES INTO L_CODPES FROM R036DEP
    WHERE NUMEMP = :NEW.NUMEMP
      AND TIPCOL = :NEW.TIPCOL
      AND NUMCAD = :NEW.NUMCAD
      AND CODDEP = :NEW.CODDEP;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_CODPES := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R036DEP.CODPES';
  END;

  BEGIN
    /*Verificar situação de afastamento para verificar se colaborador do dependente não foi demitido*/
    SELECT SITAFA INTO L_SITAFA FROM R034FUN
    WHERE NUMEMP = :NEW.NUMEMP
      AND TIPCOL = :NEW.TIPCOL
      AND NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_SITAFA := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R034FUN.SITAFA';
  END;

  /*Se existe o vínculo com pessoa*/
  IF (L_CODPES > 0) THEN
    RH_VERCOLDEM(:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,L_CODPES,L_SITAFA, 'R036PIX', L_DEMITIDOS OUT);
    IF (L_DEMITIDOS = TRUE) THEN
      l_existe := TRUE;
      BEGIN
        /*Verificar se conta já não existe na base de pessoas*/
        SELECT DATALT,  SEQCON,  TPCPIX,  CHVPIX
          INTO L_DATALT,L_SEQCON,L_TPCPIX,L_CHVPIX
        FROM R033PIX
        WHERE CODPES = L_CODPES
          AND DATALT = :OLD.DATALT
          AND TPCPIX = :OLD.TPCPIX
          AND CHVPIX = :OLD.CHVPIX;
        EXCEPTION WHEN NO_DATA_FOUND THEN
          L_SEQCON := 0;
          L_DATALT := :NEW.DATALT;
          L_TPCPIX := :NEW.TPCPIX;
          L_CHVPIX := :NEW.CHVPIX;
          l_existe := FALSE;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler R033PIX';
      END;

      IF (l_Existe = TRUE) THEN
        BEGIN
          /*Se conta já existir, atualiza os campos e zera a data de encerramento*/
          UPDATE R033PIX SET TPCPIX = :NEW.TPCPIX, CHVPIX = :NEW.CHVPIX, DATENC = l_data_zero,
                             EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                             DEPAUX = :NEW.CODDEP, COLATI = 0, CANAUX = 0, DATAUX = l_Data_zero
           WHERE CODPES = L_CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON AND TPCPIX = L_TPCPIX AND CHVPIX = L_CHVPIX;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar a R033PIX';
        END;
      ELSE
        BEGIN
          /*Gerar próxima sequência*/
          SELECT IFNULL(MAX(SEQCON),0) INTO L_ULTSEQCON FROM R033PIX
          WHERE CODPES = L_CODPES;
          EXCEPTION WHEN NO_DATA_FOUND THEN
            L_ULTSEQCON := 0;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler R033PIX';
        END;
        L_SEQCON := L_ULTSEQCON + 1;
        BEGIN
          /*Se conta não existir inserir nova conta para a pessoa vinculada */
          INSERT INTO R033PIX (CODPES,  DATALT,  SEQCON, DATABE, DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX,  TPCPIX,  CHVPIX)
                       VALUES (L_CODPES,L_DATALT,L_SEQCON,l_DatAtu,l_data_zero, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODDEP, 0, 0, l_Data_zero,L_TPCPIX,L_CHVPIX);
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao inserir na R033PIX';
        END;
        
      END IF;
