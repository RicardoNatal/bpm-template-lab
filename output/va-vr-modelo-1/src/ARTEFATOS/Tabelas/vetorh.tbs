í␀␀

PROCEDURE SP_ATUNOMPES(P_IDTPES VARCHAR2(23), P_NOMPES VARCHAR2(40))
 IS

    l_nompes       VARCHAR2(40);
BEGIN
    IF (p_nompes IS NULL) THEN
        l_nompes := '';
    ELSE
        l_nompes := lTrim(p_nompes);
        l_nompes := rTrim(l_nompes);
    END IF;

    BEGIN
        UPDATE R158PES SET
            NOMPES = l_nompes
        WHERE IDTPES = p_idtpes;
    EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'SP_ATUNOMPES: Erro no UPDATE do nome da pessoa na R158PES.';
    END;
END		SENIOR;21
