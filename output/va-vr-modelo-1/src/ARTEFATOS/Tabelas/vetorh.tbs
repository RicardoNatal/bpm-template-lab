  l_BloAce         R010SIT.BLOACE%TYPE;

  CURSOR cursorPlanoContas IS 
  SELECT R017PLV.ESTPOS, R017PLV.CODPLV, R017PLV.DATINI
          FROM R017PLE, R017PLV
         WHERE R017PLE.ESTPOS = R017PLV.ESTPOS
           AND R017PLE.CODPLV = R017PLV.CODPLV
           AND R017PLV.DATINI <= l_data_fim
           AND R017PLV.DATTER >= l_r038afa_aux.DATAFA    
           AND R017PLE.NUMEMP = l_r038afa_aux.NUMEMP
           AND R017PLE.PLNATI = 'S' 
     ORDER BY DATINI;  

  x_ESTPOS    R017PLV.ESTPOS%TYPE;
  x_CODPLV    R017PLV.CODPLV%TYPE;
  x_DATINI    R017PLV.DATINI%TYPE;
  
  
  CURSOR C_AFAANT_EI IS
         SELECT AFA.DATAFA, AFA.HORAFA, AFA.HORTER, AFA.DATTER
           FROM R038AFA AFA 
          WHERE AFA.NUMEMP = l_r038afa_aux.NUMEMP AND AFA.TIPCOL = l_r038afa_aux.TIPCOL AND AFA.NUMCAD = l_r038afa_aux.NUMCAD
            AND AFA.DATTER = (SELECT MAX(AFA2.DATTER) FROM R038AFA AFA2
                               WHERE AFA2.NUMEMP = AFA.NUMEMP AND AFA2.TIPCOL = AFA.TIPCOL AND AFA2.NUMCAD = AFA.NUMCAD
                                 AND ((AFA2.DATTER = l_r038afa_aux.DATAFA AND AFA2.HORTER <= l_r038afa_aux.HORAFA) OR AFA2.DATTER = l_DataAnteriorAfastamento))
       ORDER BY AFA.HORTER DESC;   

BEGIN
  l_Valor := '';
  l_data_zero  := DATETIME(31, 12, 1900, 0, 0, 0);
  SP_VerOnLine(l_online OUT);

  /* Le Registro do CURSOR */
  FOREACH c_r038afa_ins INTO  l_r038afa_aux.NUMEMP,
                              l_r038afa_aux.TIPCOL,
                              l_r038afa_aux.NUMCAD,
                              l_r038afa_aux.DATAFA,
                              l_r038afa_aux.HORAFA,
                              l_r038afa_aux.SITAFA,
                              l_r038afa_aux.CAUDEM,
                              l_r038afa_aux.DATTER,
                              l_r038afa_aux.FIMQUA,
                              l_r038afa_aux.HORTER,
                              l_r038afa_aux.ORIAFA,
                              l_r038afa_aux.STAATU,
                              l_r038afa_aux.DIABLQ,
							  l_r038afa_aux.MOTALT
  LOOP
  	IF((l_r038afa_aux.DatTer IS NULL) AND (l_r038afa_aux.HorTer > 0 )) THEN
        RAISERROR 103 'O Campo Hora Término só deve ser preenchido quando a Data Término do afastamento for informada.';
    END IF;
    
    l_count := 0;
    /* SE FOR AFASTAMENTO DE PERDA DE FÉRIAS NÃO FAZER TESTE DE SOBREPOSIÇÃO */
    IF  (l_r038afa_aux.ORIAFA <> 1) OR (l_r038afa_aux.ORIAFA IS NULL) THEN
        BEGIN
          SELECT COUNT(*) INTO l_count
           FROM R038AFA A
          WHERE  A.NUMEMP = l_r038afa_aux.NUMEMP
            AND  A.TIPCOL = l_r038afa_aux.TIPCOL
            AND  A.NUMCAD = l_r038afa_aux.NUMCAD
            AND ((A.ORIAFA <> 1 OR A.ORIAFA IS NULL) OR EXISTS (SELECT CODSIT FROM R010SIT SIT WHERE SIT.CODSIT = l_r038afa_aux.SITAFA AND TIPSIT = 15))
            AND (A.DATAFA <> l_r038afa_aux.DATAFA OR (A.DATAFA = l_r038afa_aux.DATAFA AND A.HORAFA <> l_r038afa_aux.HORAFA))
            AND ( ( (A.DATAFA > l_r038afa_aux.DATAFA OR (A.DATAFA = l_r038afa_aux.DATAFA AND A.HORAFA >= l_r038afa_aux.HORAFA)) AND
                    (A.DATAFA < l_r038afa_aux.DATTER OR l_r038afa_aux.DATTER = l_data_zero OR (A.DATAFA = l_r038afa_aux.DATTER AND (A.HORAFA < l_r038afa_aux.HORTER OR l_r038afa_aux.HORTER = 0))) )
             OR   ( (A.DATTER > l_r038afa_aux.DATAFA OR A.DATTER = l_data_zero OR (A.DATTER = l_r038afa_aux.DATAFA AND (A.HORTER > l_r038afa_aux.HORAFA OR A.HORTER = 0))) AND
                    ((A.DATTER < l_r038afa_aux.DATTER AND A.DATTER <> l_data_zero) OR l_r038afa_aux.DATTER = l_data_zero OR (A.DATTER = l_r038afa_aux.DATTER AND (A.HORTER <= l_r038afa_aux.HORTER OR l_r038afa_aux.HORTER = 0)))
             OR   ( (l_r038afa_aux.DATAFA > A.DATAFA OR (l_r038afa_aux.DATAFA = A.DATAFA AND l_r038afa_aux.HORAFA >= A.HORAFA)) AND
                    ((l_r038afa_aux.DATTER < A.DATTER AND l_r038afa_aux.DATTER <> l_data_zero) OR A.DATTER = l_data_zero OR (l_r038afa_aux.DATTER = A.DATTER AND l_r038afa_aux.HORTER <= A.HORTER)) ) ) );
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
              l_count:=0;
            WHEN OTHERS THEN
              RAISERROR 103 'Erro no SELECT R038AFA - em R038AFA_AI';
        END;
    END IF;
    IF  l_count > 0 THEN
        l_strerr := 'Erro de Sobreposição de Afastamentos para Empresa = '||
                    CONVERT(NUMBER_TO_CHAR,l_r038afa_aux.NUMEMP)||' Colaborador = '||
                    CONVERT(NUMBER_TO_CHAR,l_r038afa_aux.NUMCAD);
        RAISERROR 103 l_strerr;
    END IF;
    /* atualiza a situcao do afastamento em r034fun se for historico atual */
    IF  l_r038afa_aux.STAATU = 1 THEN
        R038AFA_ATUSIT(l_r038afa_aux.SITAFA,l_r038afa_aux.SITAFA,
                       l_r038afa_aux.TIPCOL,
                       l_r038afa_aux.NUMEMP,
                       l_r038afa_aux.NUMCAD,
                       l_r038afa_aux.DATAFA,
                       l_r038afa_aux.HORAFA,
                       l_r038afa_aux.CAUDEM,
                       l_r038afa_aux.DATTER,
                       l_r038afa_aux.FIMQUA,
                       l_r038afa_aux.STAATU,
                       l_r038afa_aux.DIABLQ);
    END IF;
    
       /* tratamento para afastamentos */
       l_data_fim := DATETIME(04, 06, 2080, 0, 0, 0);
       
       IF (l_r038afa_aux.DATTER > l_data_zero) THEN
            l_data_fim := l_r038afa_aux.DATTER; 
       END IF;
    
            
       FOREACH cursorPlanoContas INTO x_ESTPOS, x_CODPLV, x_DATINI
       LOOP
           l_xEstPos := x_ESTPOS;
           l_xCodPlv := x_CODPLV;
          
           IF ( l_r038afa_aux.DATAFA < x_DATINI ) THEN
             l_DataAfasTmp := x_DATINI;
           ELSE
              l_DataAfasTmp := l_r038afa_aux.DATAFA; 
           END IF;
           QL_PROCEAFA('I', l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_r038afa_aux.SITAFA, l_xEstPos, l_xCodPlv, l_DataAfasTmp, l_data_zero, l_r038afa_aux.CAUDEM);
    
        END LOOP; /* fim loop cursor */
        
        IF (l_r038afa_aux.DATTER > l_data_zero) THEN
       	    /* adiciona um dia ao fim do afastamento */ 
    		l_data_fim := DATETIMEADD(DD, 1, l_r038afa_aux.DATTER);
    		QL_PROCEAFA('O', l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_r038afa_aux.SITAFA, l_xEstPos, l_xCodPlv, l_data_fim, l_data_zero, l_r038afa_aux.CAUDEM);
    	END IF;

    /* Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
    QL_UTIPOSTRA(l_r038afa_aux.NUMEMP, l_r038afa_aux.DATAFA, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
    IF (l_xUtiPos ='N') THEN
      /* rotina antiga */
      /* Atualiza o Quadro Efetivo - QL */
      QL_INCAFAST(l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_r038afa_aux.DATAFA, l_r038afa_aux.SITAFA, l_r038afa_aux.DATTER, l_r038afa_aux.DATAFA, l_r038afa_aux.SITAFA, l_r038afa_aux.DATTER);
    END IF;
	
    /* INÍCIO - eSocial */
    	l_gerarPendencia := FALSE;
		RH_LAYOUTCOLAB(l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_layout OUT);
    	N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    	
    	IF (l_gerarPendencia = TRUE) THEN
		    SP_RETORNAR_MOTESO(l_r038afa_aux.SITAFA, l_r038afa_aux.DATAFA, l_MotEso OUT, l_EnvObs OUT);
		    SP_RETORNAR_TIPSIT(l_r038afa_aux.SITAFA, l_TipSit OUT, l_BloAce OUT);
		    RH_RET_DATADM(l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_DataAdmissao OUT);
			
			l_EnvEso := 1; /* 1 - Sim*/
			/* Quando motivo eSocial for 14 - Cessão/Requisição ou 24 - Mandato Sindical - Afastamento temporário para exercício de mandato sindical obrigatoriamente deve existir histórico de cessão
			 * No histórico de cessão é indicado se deve enviar ao eSocial ou não (campo envEso), visto que existem cenários facultativos, sendo assim, o envio só deve ser efetuado para envEso = 1 - Sim */
			IF (l_MotEso IN (14, 24)) THEN
			  SP_RETENVESO_HCE(l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_r038afa_aux.DATAFA, l_EnvEso OUT);
			END IF;
			  
			l_data_zero := DATETIME(31, 12, 1900, 0, 0, 0);  
		    /* MotEso = 0 - Não enviar ao eSocial */
		    IF ((l_MotEso <> 0) AND (l_TipSit NOT IN (16,17,18)) AND (l_EnvEso = 1) AND ((l_r038afa_aux.DatTer >= l_DataAdmissao) OR (l_r038afa_aux.DatTer = l_data_zero))) THEN
		      
			  RH_DEF_ESOCIAL(l_r038afa_aux.NUMEMP, l_DataInicioTabelas OUT, l_DataInicioEsocial OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
		    
		      BEGIN
		      	SELECT DatAfa, HorAfa, SitAfa INTO l_DatAfaAux, l_HorAfaAux, l_SitAfaAux
				  FROM R038AFA
		      	 WHERE NUMEMP = l_r038afa_aux.NumEmp
		      	   AND TIPCOL = l_r038afa_aux.TipCol
		      	   AND NUMCAD = l_r038afa_aux.NumCad
		      	   AND DATAFA = l_r038afa_aux.DatAfa
		      	   AND HORAFA < l_r038afa_aux.HorAfa;
		      EXCEPTION
		      	WHEN OTHERS THEN
		      		l_DatAfaAux := l_data_zero;
		      		l_HorAfaAux := 0;
		      		l_SitAfaAux := 0;
		      END;
		      
		      /* Se tiver uma situação é porque encontrou um afastamento na mesma data, em um horário anterior */
		      IF (l_SitAfaAux > 0) THEN
		        /* Busca motivo do outro afastamento que existe no mesmo dia */
		        SP_RETORNAR_MOTESO(l_SitAfaAux, l_DatAfaAux, l_MotEsoAux OUT, l_EnvObs OUT);
		        
		     	/* Se o motivo for diferente de zero, significa que o afastamento foi ou ainda irá para o eSocial, então deverá enviar a exclusão deste afastamento para permitir enviar o novo */
		        IF (l_MotEsoAux <> 0) THEN
		          l_Valor := '';
			      SP_CONCATENAR_DAT('DATAFA', l_DatAfaAux, l_Valor OUT);
			      SP_CONCATENAR_NUM('HORAFA', l_HorAfaAux, l_Valor OUT);
			      SP_CONCATENAR_DES('LAYOUT', 'S-2230', l_Valor OUT);
			      SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
			      SP_E_SOCIAL('S-3000', 'R038AFA', 'N', 'A', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_DatAfaAux, 0, 'R038AFA_SI');
		        END IF;
		      END IF;
			  
			  IF (l_r038afa_aux.MOTALT = 'S') THEN
			     /* CONTROLE MOTIVO AFASTAMENTO NÃO RETROATIVO ESOCIAL */
			     /* RETORNAR AFASTAMENTO ANTERIOR */
			     l_DataAnteriorAfastamento := DATETIMEADD(DD, -1, l_r038afa_aux.DATAFA);  
			     l_DatAfa := DATETIME(31, 12, 1900, 0, 0, 0);
			     l_DatTer := DATETIME(31, 12, 1900, 0, 0, 0);
			     l_HorAfa := 0;
			       
			     FOREACH C_AFAANT_EI INTO l_DatAfaAux, l_HorAfaAux, l_HorTerAux, l_DatTerAux
			     LOOP
			       l_DatAfa := l_DatAfaAux;
				   l_HorAfa := l_HorAfaAux;
				   l_DatTer := l_DatTerAux;
				   EXIT; 
			     END LOOP;
			     
			     /* S-2230 - altAfastamento */ 
			     IF (l_DatAfa <> l_data_zero) THEN  
			       l_Valor := '';
			       SP_CONCATENAR_DAT('DATAFA', l_DatAfa, l_Valor OUT);
			       SP_CONCATENAR_NUM('HORAFA', l_HorAfa, l_Valor OUT);
			       SP_CONCATENAR_NUM('SECAFA', 1, l_Valor OUT); 
			       SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
			       SP_E_SOCIAL('S-2230', 'R038AFA', 'N', 'I', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_DatAfa, 0, 'R038AFA_SI');
			       
			       	  /** Tem data de término no afastamento anterior(S-2230) e o afastamento excluído for uma retificação não retroativa gera a exclusão (S-2230), indicando a inclusão do término do afastamento "SecAfa" - 3. Somente deve gerar a pendência quando o afastamento for realizado posteriormente ao iniício dos não periódicos. */
			       IF((l_DatTer <> l_data_zero) AND (l_DatAfa > l_DataInicioNaoPeriodicos)) THEN
			          l_Valor := '';
			      	  SP_CONCATENAR_DAT('DATAFA', l_DatAfa, l_Valor OUT);
			      	  SP_CONCATENAR_NUM('HORAFA', l_HorAfa, l_Valor OUT);
			      	  SP_CONCATENAR_NUM('SECAFA', 3, l_Valor OUT); /* 3 - Fim afastamento */
			      	  SP_CONCATENAR_DES('LAYOUT', 'S-2230', l_Valor OUT); 
			      	  SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
			      	  SP_E_SOCIAL('S-3000', 'R038AFA', 'N', 'A', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_DatTer, 0, 'R038AFA_SI');
			       END IF;
			       
			       /* S-2230 - fimAfastamento */
			       IF (l_r038afa_aux.DATTER <> l_data_zero) THEN  
			         l_Valor := '';
			         SP_CONCATENAR_DAT('DATAFA', l_DatAfa, l_Valor OUT);
			         SP_CONCATENAR_NUM('HORAFA', l_HorAfa, l_Valor OUT);
			         SP_CONCATENAR_NUM('SECAFA', 3, l_Valor OUT); /* 3 - Fim afastamento */
			         SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
			         SP_E_SOCIAL('S-2230', 'R038AFA', 'N', 'I', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_r038afa_aux.DATTER, 0, 'R038AFA_SI');
			       END IF;
				 END IF;
			     
			     IF (l_DataInicioNaoPeriodicos > l_DataAdmissao) THEN
			       IF (l_DatAfa < l_DataInicioNaoPeriodicos AND (l_r038afa_aux.DATTER = l_data_zero OR l_r038afa_aux.DATTER >= l_DataInicioNaoPeriodicos)) THEN
			         l_Valor := '';
		  	         SP_CONCATENAR_DAT('DATAFA', l_r038afa_aux.DATAFA, l_Valor OUT);
			         SP_CONCATENAR_NUM('HORAFA', l_r038afa_aux.HORAFA, l_Valor OUT);
			         SP_CONCATENAR_NUM('SECAFA', 1, l_Valor OUT); /* 1 - Início afastamento */
			         SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
			         SP_E_SOCIAL(l_layout, 'R038AFA', 'N', 'I', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_r038afa_aux.DATAFA, 0, 'R038AFA_SI');
			       
			       	  /* Tem data de término no afastamento anterior(S-2230) e o afastamento excluído for uma retificação não retroativa gera a exclusão (S-2230), indicando a inclusão do término do afastamento "SecAfa" - 3 */
			         IF(l_DatTer <> l_data_zero)THEN
			            l_Valor := '';
			      		SP_CONCATENAR_DAT('DATAFA', l_DatAfa, l_Valor OUT);
			      		SP_CONCATENAR_NUM('HORAFA', l_HorAfa, l_Valor OUT);
			      		SP_CONCATENAR_NUM('SECAFA', 3, l_Valor OUT); /* 3 - Fim afastamento */
			      		SP_CONCATENAR_DES('LAYOUT', 'S-2230', l_Valor OUT); 
			      		SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
			      		SP_E_SOCIAL('S-3000', 'R038AFA', 'N', 'A', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_DatTer, 0, 'R038AFA_SI');
			         END IF;
			       END IF;
			     END IF;
			  
			  ELSE
			    /* S-2230 - iniAfastamento */
			    l_Valor := '';
			    SP_CONCATENAR_DAT('DATAFA', l_r038afa_aux.DATAFA, l_Valor OUT);
			    SP_CONCATENAR_NUM('HORAFA', l_r038afa_aux.HORAFA, l_Valor OUT);
			    SP_CONCATENAR_NUM('SECAFA', 1, l_Valor OUT); /* 1 - Início afastamento */
			    SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
			    SP_E_SOCIAL('S-2230', 'R038AFA', 'N', 'I', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_r038afa_aux.DATAFA, 0, 'R038AFA_SI');
			  
			    /* S-2230 - fimAfastamento */
			    IF (l_r038afa_aux.DATTER <> l_data_zero) THEN  
			      l_Valor := '';
			      SP_CONCATENAR_DAT('DATAFA', l_r038afa_aux.DATAFA, l_Valor OUT);
			      SP_CONCATENAR_NUM('HORAFA', l_r038afa_aux.HORAFA, l_Valor OUT);
			      SP_CONCATENAR_NUM('SECAFA', 3, l_Valor OUT); /* 3 - Fim afastamento */
			      SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
			      SP_E_SOCIAL('S-2230', 'R038AFA', 'N', 'I', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_r038afa_aux.DATTER, 0, 'R038AFA_SI');
			    END IF;
			    
			    IF (l_DataInicioNaoPeriodicos > l_DataAdmissao) THEN
			      IF (l_r038afa_aux.DATAFA < l_DataInicioNaoPeriodicos AND (l_r038afa_aux.DATTER = l_data_zero OR l_r038afa_aux.DATTER >= l_DataInicioNaoPeriodicos)) THEN
			        l_Valor := '';
		  	        SP_CONCATENAR_DAT('DATAFA', l_r038afa_aux.DATAFA, l_Valor OUT);
			        SP_CONCATENAR_NUM('HORAFA', l_r038afa_aux.HORAFA, l_Valor OUT);
			        SP_CONCATENAR_NUM('SECAFA', 1, l_Valor OUT); /* 1 - Início afastamento */
			        SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
			        SP_E_SOCIAL(l_layout, 'R038AFA', 'N', 'I', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_DataInicioNaoPeriodicos, 0, 'R038AFA_SI');
			      END IF;
			    END IF;
			  END IF;
		    END IF;
	END IF;		    
    /* FIM - eSocial */	
  END LOOP;
  /* Apaga Registro OLD/NEW em R038AFA_AUX */
  BEGIN
    DELETE FROM R038AFA_AUX;
    DROP_TEMP_TABLE R038AFA_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀PÔ␀␀		SENIOR;0O␀␀

TRIGGER R038AFA_EI BEFORE INSERT ON R038AFA FOR EACH ROW
DECLARE
l_online       BOOLEAN;
  l_data_fim     DATE;
  l_data_zero     DATE;
  l_DatAdm         R034FUN.DATADM%TYPE;

  l_TemPenFut    BOOLEAN;
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_AltEmp         R038PEN.ALTEMP%TYPE;
  l_AltFil         R038PEN.ALTFIL%TYPE;
  l_AltLoc         R038PEN.ALTLOC%TYPE;
  l_AltCcu         R038PEN.ALTCCU%TYPE;
  l_AltCar         R038PEN.ALTCAR%TYPE;
  l_AltEsc         R038PEN.ALTESC%TYPE;
  l_AltDes         R038PEN.ALTDES%TYPE;
  l_SitChe         R038PEN.SITCHE%TYPE;
  l_SitUsu         R038PEN.SITUSU%TYPE;
  l_NesRev         R038PEN.NESREV%TYPE;
  l_EmpAtu         R038PEN.EMPATU%TYPE;
  l_CadAtu         R038PEN.CADATU%TYPE;
  l_ColChe       BOOLEAN;
  l_ColUsu       BOOLEAN;
  l_auxSitChe      R038PEN.SITCHE%TYPE;
  l_auxSitUsu      R038PEN.SITUSU%TYPE;
  l_AssDesCol      R000ASS.DESCOL%TYPE;
  l_TipSit         R010SIT.TIPSIT%TYPE;  
  l_BloAce         R010SIT.BLOACE%TYPE;
  /* VARIAVEIS DO LOG */
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);

  /* Declaracao para criar tabela temporária em SQL Server - Erros de DeadLock */
  CREATE_TEMP_TABLE R038AFA_AUX;
  /*VARIAVEIS DO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_Valor VARCHAR2(2000);
  
  l_chave       VARCHAR2(50);
  l_tippesstr    CHAR(2);
  l_numempstr    CHAR(4);
  l_tipcolstr    CHAR(1);
  l_numcadstr    CHAR(9);
  l_data         CHAR(8);
  l_hora         CHAR(4);
  l_IDTPES       VARCHAR(23);

BEGIN
  l_Valor := '';
  SP_RETORNAR_TIPSIT(:NEW.SITAFA, l_TipSit OUT, l_BloAce OUT);
  BEGIN
    SELECT DESCOL INTO l_AssDesCol
      FROM R000ASS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_AssDesCol := 0;
  END;

  IF (l_AssDesCol = 2) AND (l_TipSit = 7) THEN
    /* Verifica se o colaborador está associado ao cadastro de chefia ou
       se o colaborador está associado com algum usuário */
    R038PEN_COLCHEFE(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATAFA, l_ColChe OUT, l_ColUsu OUT);

    /* Busca data de admissão do colaborador */
    BEGIN
      SELECT R034FUN.DATADM INTO l_DatAdm
        FROM R034FUN
       WHERE R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_DatAdm := DATETIME(31, 12, 1900, 0, 0, 0);
    END;

    /* Se o colaborador é chefe ou está associado a um usuário, e a data admissão for diferente da data
       do histórico gera pendência */
    IF ((l_ColChe = TRUE OR l_ColUsu = TRUE) AND (:NEW.DATAFA <> l_DatAdm)) THEN
      /* Verifica se existe pendência numa data futura */
      R038PEN_TEMPENFUT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATAFA, l_TemPenFut OUT);

      /* se não existe pendência com data futura, verifica se existe pendência com data passada e situação não atendida */
      IF (l_TemPenFut = FALSE) THEN
        BEGIN
             SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU
               INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu
               FROM R038PEN
              WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                    R038PEN.TIPCOL = :NEW.TIPCOL AND
                    R038PEN.NUMCAD = :NEW.NUMCAD AND
                    R038PEN.DATTRF < :NEW.DATAFA AND
                    ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
                     (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));
        EXCEPTION
             WHEN NO_DATA_FOUND THEN
                  l_NumEmp := 0;
                  l_TipCol := 0;
                  l_NumCad := 0;
                  l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
        END;

        /* Considera que sempre altera Desligamento na inclusão do histórico de Afastamento para criação da pendência */
        l_AltDes := 'S';

        /* Verifica se deve gerar pendencia de chefia */
        IF (l_ColChe = TRUE) THEN
          l_SitChe := 1; /* Não Atendida */
        ELSE
          l_SitChe := 3; /* Sem necessidade de Alteração */
        END IF;

        /* Verifica se deve gerar pendencia de usuário */
        IF (l_ColUsu = TRUE) THEN
          l_SitUsu := 1; /* Não Atendida */
        ELSE
          l_SitUsu := 4; /* Sem necessidade de Alteração */
        END IF;

        /* Se existir uma pendência com data passada e situação 1 (Não atendida), esta
           será excluída e regerada com a nova data */
        IF (l_NumCad <> 0) THEN

          /* Insere nova pendência com base nos valores da pendência da data passada */
          BEGIN
            INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATAFA, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu);
          EXCEPTION
            WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
          END;

          /* Deleta pendência da data passada */
          R038PEN_DELPENPAS(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATAFA);

        ELSE
          /* Verifica se existe pendência na mesma data de alteração */
          BEGIN
               SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, SITCHE, SITUSU INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_auxSitChe, l_auxSitUsu
                 FROM R038PEN
                WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                      R038PEN.TIPCOL = :NEW.TIPCOL AND
                      R038PEN.NUMCAD = :NEW.NUMCAD AND
                      R038PEN.DATTRF = :NEW.DATAFA;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_NumEmp := 0;
                    l_TipCol := 0;
                    l_NumCad := 0;
                    l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
                    l_auxSitChe := 0;
                    l_auxSitUsu := 0;
          END;

          /* Se existir pendência na mesma data, atualiza a pendência */
          IF (l_NumCad <> 0) THEN

            IF ((l_auxSitChe = 1 OR l_auxSitChe = 3) AND
                (l_auxSitUsu = 1 OR l_auxSitUsu = 4)) THEN

              /* Atualiza pendência */
              BEGIN
                UPDATE R038PEN
                   SET ALTDES = l_AltDes, SITCHE = l_SitChe, SITUSU = l_SitUsu
                 WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                       R038PEN.TIPCOL = :NEW.TIPCOL AND
                       R038PEN.NUMCAD = :NEW.NUMCAD AND
                       R038PEN.DATTRF = :NEW.DATAFA;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;

            ELSE
              /* Se a Situação for diferente de "Não atendida" ou "Sem necessidade de alteração", então
                 indica na pendência que necessita Revisão */
              BEGIN
                UPDATE R038PEN SET ALTDES = l_AltDes, NESREV = 'S'
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATAFA;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            END IF;

          ELSE

            /* Insere nova pendência */
            BEGIN
              INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATAFA, 'N', 'N', 'N', 'N', 'N', 'N', l_AltDes, l_SitChe, l_SitUsu, 'N', 0, 0);
            EXCEPTION
              WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
            END;

          END IF;
        END IF;
      END IF;

    END IF;
  END IF;


  QL_ATUEFEFUN(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATAFA, :NEW.SITAFA);

  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN
      SP_HisAfa ('I', :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATAFA, :NEW.HORAFA, :NEW.DATTER, :NEW.HORTER, :NEW.SITAFA, :NEW.DATTER, :NEW.HORTER, :NEW.SITAFA);
      
      /* VERIFICA SE EH PARA INCLUIR NO CADASTRO DE PESSOAS NÃO GRATAS */
      /* Se o afastamento for gerado por troca de filial, não inclui como PNG */
      IF  (l_tipsit = 7) AND (:NEW.oriAfa <> 5) THEN
          R038AFA_ATUPNG('I',:NEW.numemp, :NEW.tipcol, :NEW.numcad, :NEW.datafa);
      END IF;
  END IF;
  
  
  BEGIN
  /* Insere Registro NEW */
    INSERT INTO R038AFA_AUX (NUMEMP,TIPCOL,NUMCAD,DATAFA,HORAFA,SITAFA,CAUDEM,DATTER,FIMQUA,HORTER,ORIAFA,STAATU,DIABLQ,MOTALT)
    VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATAFA,:NEW.HORAFA,:NEW.SITAFA,:NEW.CAUDEM,:NEW.DATTER,:NEW.FIMQUA,:NEW.HORTER,:NEW.ORIAFA,:NEW.STAATU,:NEW.DIABLQ,:NEW.MOTALT);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R038AFA_AUX.';
  END;

  /* Inclui as Solicitações de Exames Periódicos cadastrados para o Afastamento */
  RH_EXA_AFAST('I', :NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATAFA,:NEW.SITAFA,:NEW.DATTER,:NEW.DATTER,:NEW.EXMRET);

  /* Inclui as Solicitações de Exames Periódicos cadastrados para o Acompanhamento de Demissão - caso o afastamento seja de Demissão */
  RH_EXA_ACDEM(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATAFA,:NEW.SITAFA,:NEW.DATTER);

  /* OriAfa = 1 = Afastamentos de Perda de Férias Incluídos na Apuração do Ronda */
  /* Condição "IS NULL" incluída para tratar quando houver (por ex.) telas do SGI que não setam ORIAFA. */
  IF   (:NEW.ORIAFA <> 1) OR (:NEW.ORIAFA IS NULL) THEN
       l_data_zero := DATETIME(31, 12, 1900, 0, 0, 0);
       l_data_fim := :NEW.DATTER;
       IF   (l_data_fim = l_data_zero) THEN
            l_data_fim := DATETIME(04, 06, 2080, 0, 0, 0);
       END IF;

       BEGIN
       UPDATE R066APU SET DIAALT = 8
              WHERE NUMEMP = :NEW.NUMEMP AND
                    TIPCOL = :NEW.TIPCOL AND
                    NUMCAD = :NEW.NUMCAD AND
                    DATAPU >= :NEW.DATAFA AND
                    DATAPU <= l_data_fim;
       EXCEPTION WHEN OTHERS THEN
         NULL;
       END;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R038AFA');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R038AFA_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,DATAFA,HORAFA,DATTER,HORTER,PRVTER,
                                   SITAFA,DIAJUS,OBSAFA,STAATU,CAUDEM,DIABLQ,QHRAFA,ORIAFA,EXMRET,CONTOV,
                                   MOTRAI,NROAUT,CODOEM,CODSUB,DATPER,SITINI,RISNEX,DATNEX,DIAPRV,CODCUA,
                                   TMACUA,DATPAR,FIMQUA)
                           VALUES (l_seqreg,l_verseq,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATAFA,
                                  :NEW.HORAFA,:NEW.DATTER,:NEW.HORTER,:NEW.PRVTER,:NEW.SITAFA,:NEW.DIAJUS,
                                  :NEW.OBSAFA,:NEW.STAATU,:NEW.CAUDEM,:NEW.DIABLQ,:NEW.QHRAFA,:NEW.ORIAFA,
                                  :NEW.EXMRET,:NEW.CONTOV,:NEW.MOTRAI,:NEW.NROAUT,:NEW.CODOEM,:NEW.CODSUB,
                                  :NEW.DATPER,:NEW.SITINI,:NEW.RISNEX,:NEW.DATNEX,:NEW.DIAPRV,:NEW.CODCUA,
                                  :NEW.TMACUA,:NEW.DATPAR,:NEW.FIMQUA);

          SP_AUDGENREG(l_seqreg,l_verseq,'R038AFA','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
  
  IF (l_BloAce = 'S' OR l_TipSit = 7) THEN
     SP_INTSTR(:NEW.TIPCOL,'99',l_tippesstr OUT);
     SP_INTSTR(:NEW.NUMEMP,'9999',l_numempstr OUT);
     SP_INTSTR(:NEW.TIPCOL,'9',l_tipcolstr OUT);
     SP_INTSTR(:NEW.NUMCAD,'999999999',l_numcadstr OUT);
     SP_DATSTR(:NEW.DATAFA,'DDMMYYYY',l_data OUT);
     SP_INTSTR(:NEW.HORAFA,'9999',l_hora OUT);
     l_chave := l_tippesstr||l_numempstr||l_tipcolstr||l_numcadstr||l_data||l_hora;
     SP_SAM_PENDENCIES(3,1,l_chave);
  END IF;
  
  /* CONTROLE DO LOG */
  BEGIN
	l_codcpa := 16;        /*l_codcpa representa a categoria*/
	l_codtpa := 145;       /*l_codtpa representa a o tipo Inserir/Excluir/Alterar*/
	  
	SP_EXISTE_LOG(l_codcpa, l_codtpa, 1, l_temAud OUT);
	  
	IF (l_temAud = TRUE) THEN
	  SP_RET_REG_AUD(l_codrpa OUT);
	  SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R038AFA_EI', 'FR038AFA'); 
	 
	  BEGIN
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
		SP_DATSTR(:NEW.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAFA', l_datTemp);
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORAFA', CONVERT(NUMBER_TO_CHAR, :NEW.HORAFA));
	  EXCEPTION
		  WHEN OTHERS THEN RAISERROR 103 'R038AFA_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	  END;
		 
	  BEGIN
	    SP_DATSTR(:NEW.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATTER', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORTER', CONVERT(NUMBER_TO_CHAR, :NEW.HORTER));
		SP_DATSTR(:NEW.PRVTER, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRVTER', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITAFA', CONVERT(NUMBER_TO_CHAR, :NEW.SITAFA));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CAUDEM', CONVERT(NUMBER_TO_CHAR, :NEW.CAUDEM));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDREM', CONVERT(NUMBER_TO_CHAR, :NEW.INDREM));
		SP_DATSTR(:NEW.FIMQUA, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMQUA', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAJUS', CONVERT(NUMBER_TO_CHAR, :NEW.DIAJUS));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QHRAFA', CONVERT(NUMBER_TO_CHAR, :NEW.QHRAFA));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORIAFA', CONVERT(NUMBER_TO_CHAR, :NEW.ORIAFA));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EXMRET', :NEW.EXMRET);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONTOV', :NEW.CONTOV);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSAFA', :NEW.OBSAFA);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAATU', CONVERT(NUMBER_TO_CHAR, :NEW.STAATU));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MOTRAI', CONVERT(NUMBER_TO_CHAR, :NEW.MOTRAI));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NROAUT', :NEW.NROAUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOEM', CONVERT(NUMBER_TO_CHAR, :NEW.CODOEM));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSUB', :NEW.CODSUB);
		SP_DATSTR(:NEW.DATPER, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPER', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITINI', CONVERT(NUMBER_TO_CHAR, :NEW.SITINI));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RISNEX', :NEW.RISNEX);
		SP_DATSTR(:NEW.DATNEX, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATNEX', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAPRV', CONVERT(NUMBER_TO_CHAR, :NEW.DIAPRV));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCUA', CONVERT(NUMBER_TO_CHAR, :NEW.CODCUA));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TMACUA', CONVERT(NUMBER_TO_CHAR, :NEW.TMACUA));
		SP_DATSTR(:NEW.DATPAR, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPAR', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIABLQ', CONVERT(NUMBER_TO_CHAR, :NEW.DIABLQ));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', CONVERT(NUMBER_TO_CHAR, :NEW.SEQREG));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HRTRCS', CONVERT(NUMBER_TO_CHAR, :NEW.HRTRCS));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDOE', :NEW.CODDOE);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCID', :NEW.CODCID);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR, :NEW.CODATE));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ACITRA', CONVERT(NUMBER_TO_CHAR, :NEW.ACITRA));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EFERET', :NEW.EFERET);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENCAFA', CONVERT(NUMBER_TO_CHAR, :NEW.ENCAFA));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPSUC', CONVERT(NUMBER_TO_CHAR, :NEW.TIPSUC));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CGCSUC', CONVERT(NUMBER_TO_CHAR, :NEW.CGCSUC));
		SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITORI', CONVERT(NUMBER_TO_CHAR, :NEW.SITORI));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MOTALT', :NEW.MOTALT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMATE', :NEW.NOMATE);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORGCLA', CONVERT(NUMBER_TO_CHAR, :NEW.ORGCLA));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REGCON', :NEW.REGCON);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCON', :NEW.ESTCON);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CGCCES', CONVERT(NUMBER_TO_CHAR, :NEW.CGCCES));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ONUCES', CONVERT(NUMBER_TO_CHAR, :NEW.ONUCES));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CGCSIN', CONVERT(NUMBER_TO_CHAR, :NEW.CGCSIN));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ONUSIN', CONVERT(NUMBER_TO_CHAR, :NEW.ONUSIN));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ACIANT', :NEW.ACIANT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORIMOT', CONVERT(NUMBER_TO_CHAR, :NEW.ORIMOT));	
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMPRO', CONVERT(NUMBER_TO_CHAR, :NEW.NUMPRO));			 
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MSMMOT', :NEW.MSMMOT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MANCGC', CONVERT(NUMBER_TO_CHAR, :NEW.MANCGC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MANREM', :NEW.MANREM);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ATEPAT', :NEW.ATEPAT);
	  END;	
	END IF;  
  END; /* FIM DO CONTROLE DO LOG */
END␀UÔ␀␀	SENIOR;0ñC␀␀

TRIGGER R038AFA_SU AFTER UPDATE ON R038AFA

DECLARE
l_count               NUMBER(5);
  l_data_zero          DATE;
  l_online            BOOLEAN;
  l_strerr            VARCHAR2(255);
  l_xUtiPosOri        CHAR;
  l_xEstPosOri        NUMBER(3);
  l_xCodPlvOri        NUMBER(4);
  l_xUtiPosDes        CHAR;
  l_xEstPosDes        NUMBER(3);
  l_xCodPlvDes        NUMBER(4);
  l_DataAdmissao      DATE;
  l_DataInicioEsocial DATE;
  l_DataInicioTabelas DATE; 
  l_DataInicioNaoPeriodicos DATE;
  l_DataInicioPeriodicos DATE;
  l_DataInicioSST DATE;
  l_DataInicioMigracao DATE;
  l_layout            VARCHAR(6);   
  l_gerarPendencia BOOLEAN;
  l_data_fim          DATE;
  l_DataAfasTmp       DATE;
  l_xEstPos           NUMBER(3);
  l_xCodPlv           NUMBER(4);

  /* CURSOR c/ os registros gravados no R038afa_AUX */
  CURSOR c_r038afa_upd IS
  SELECT NUMEMP,TIPCOL,NUMCAD,DATAFA,HORAFA,SITAFA,CAUDEM,DATTER,FIMQUA,HORTER,ORIAFA,SITANT,STAATU, EMPOLD, TIPOLD, CADOLD, DTAOLD, HAFOLD, DTTOLD, DIABLQ, MOTALT FROM R038AFA_AUX;
  
  TYPE t_r038AFA_aux IS RECORD(
    NUMEMP   R038AFA_AUX.NUMEMP%TYPE,
    TIPCOL   R038AFA_AUX.TIPCOL%TYPE,
    NUMCAD   R038AFA_AUX.NUMCAD%TYPE,
    DATAFA   R038AFA_AUX.DATAFA%TYPE,
    HORAFA   R038AFA_AUX.HORAFA%TYPE,
    SITAFA   R038AFA_AUX.SITAFA%TYPE,
    CAUDEM   R038AFA_AUX.CAUDEM%TYPE,
    DATTER   R038AFA_AUX.DATTER%TYPE,
    FIMQUA   R038AFA_AUX.FIMQUA%TYPE,
    HORTER   R038AFA_AUX.HORTER%TYPE,
    ORIAFA   R038AFA_AUX.ORIAFA%TYPE,
    SITANT   R038AFA_AUX.SITANT%TYPE,
    STAATU   R038AFA_AUX.STAATU%TYPE,
    EMPOLD   R038AFA_AUX.EMPOLD%TYPE,
    TIPOLD   R038AFA_AUX.TIPOLD%TYPE,
    CADOLD   R038AFA_AUX.CADOLD%TYPE,
    DTAOLD   R038AFA_AUX.DTAOLD%TYPE,
    HAFOLD   R038AFA_AUX.HAFOLD%TYPE,
    DTTOLD   R038AFA_AUX.DTTOLD%TYPE,
    DIABLQ   R038AFA_AUX.DIABLQ%TYPE,
	MOTALT   R038AFA_AUX.MOTALT%TYPE);
  l_r038AFA_aux t_r038AFA_aux;
  
  
  /* VARIAVEIS DE CONTROLE E-SOCIAL */
  l_AlterouFim       BOOLEAN;
  l_Valor            VARCHAR(2000);
  l_Valido           BOOLEAN;
  l_ZerouDatTer      BOOLEAN;

  l_DataAnteriorAfastamento   R038AFA.DATAFA%TYPE;
  l_DatAfaAux                 R038AFA.DATAFA%TYPE;
  l_DatTerAux                 R038AFA.DATTER%TYPE;
  l_HorAfaAux                 R038AFA.HORAFA%TYPE;
  l_HorTerAux                 R038AFA.HORTER%TYPE;
  l_DatAfa                    R038AFA.DATAFA%TYPE;
  l_DatTer                    R038AFA.DATTER%TYPE;
  l_HorAfa                    R038AFA.HORAFA%TYPE;
  l_MotEso                    R010ESO.MOTESO%TYPE;
  l_EnvObs                    R010ESO.ENVOBS%TYPE;
  l_EnvEso                    R038HCE.ENVESO%TYPE;
  l_TipSit                    R010SIT.TIPSIT%TYPE;
  l_BloAce                    R010SIT.BLOACE%TYPE;
  l_JsonCamposAlterados VARCHAR2(2000);
  
  
   CURSOR cursorPlanoContas IS 
   SELECT R017PLV.ESTPOS, R017PLV.CODPLV, R017PLV.DATINI
           FROM R017PLE, R017PLV
          WHERE R017PLE.ESTPOS = R017PLV.ESTPOS
            AND R017PLE.CODPLV = R017PLV.CODPLV
            AND R017PLV.DATINI <= l_data_fim
            AND R017PLV.DATTER >= l_r038afa_aux.DATAFA    
            AND R017PLE.NUMEMP = l_r038afa_aux.NUMEMP
            AND R017PLE.PLNATI = 'S' 
      ORDER BY DATINI ;   
             
  x_ESTPOS    R017PLV.ESTPOS%TYPE;
  x_CODPLV    R017PLV.CODPLV%TYPE;
  x_DATINI    R017PLV.DATINI%TYPE; 
  
  CURSOR C_AFAANT_EU IS
         SELECT AFA.DATAFA, AFA.HORAFA, AFA.HORTER, AFA.DATTER
           FROM R038AFA AFA 
          WHERE AFA.NUMEMP = l_r038afa_aux.NUMEMP AND AFA.TIPCOL = l_r038afa_aux.TIPCOL AND AFA.NUMCAD = l_r038afa_aux.NUMCAD
            AND AFA.DATTER = (SELECT MAX(AFA2.DATTER) FROM R038AFA AFA2
                               WHERE AFA2.NUMEMP = AFA.NUMEMP AND AFA2.TIPCOL = AFA.TIPCOL AND AFA2.NUMCAD = AFA.NUMCAD
                                 AND ((AFA2.DATTER = l_r038afa_aux.DATAFA AND AFA2.HORTER <= l_r038afa_aux.HORTER) OR AFA2.DATTER = l_DataAnteriorAfastamento))
       ORDER BY AFA.HORTER DESC; 
	   
BEGIN
  l_Valor := '';
  l_data_zero  := DATETIME(31, 12, 1900, 0, 0, 0);  
  SP_VerOnLine(l_online OUT);

  /* Le Registro do CURSOR */
  FOREACH c_r038afa_upd INTO  l_r038afa_aux.NUMEMP,
                              l_r038afa_aux.TIPCOL,
                              l_r038afa_aux.NUMCAD,
                              l_r038afa_aux.DATAFA,
                              l_r038afa_aux.HORAFA,
                              l_r038afa_aux.SITAFA,
                              l_r038afa_aux.CAUDEM,
                              l_r038afa_aux.DATTER,
                              l_r038afa_aux.FIMQUA,
                              l_r038afa_aux.HORTER,
                              l_r038afa_aux.ORIAFA,
                              l_r038afa_aux.SITANT,
                              l_r038afa_aux.STAATU,
                              l_r038afa_aux.EMPOLD,
                              l_r038afa_aux.TIPOLD,
                              l_r038afa_aux.CADOLD,
                              l_r038afa_aux.DTAOLD,
                              l_r038afa_aux.HAFOLD,
                              l_r038afa_aux.DTTOLD,
                              l_r038afa_aux.DIABLQ,
							  l_r038afa_aux.MOTALT
  LOOP
  	IF((l_r038afa_aux.DatTer IS NULL) AND (l_r038afa_aux.HorTer > 0 )) THEN
        RAISERROR 103 'O Campo Hora Término só deve ser preenchido quando a Data Término do afastamento for informada.';
    END IF;
    
    l_count := 0;
    /* SE FOR AFASTAMENTO DE PERDA DE FÉRIAS NÃO FAZER TESTE DE SOBREPOSIÇÃO */
      IF  (l_r038afa_aux.ORIAFA <> 1) OR (l_r038afa_aux.ORIAFA IS NULL) THEN
        BEGIN
          SELECT COUNT(*) INTO l_count
           FROM R038AFA A
          WHERE  A.NUMEMP = l_r038afa_aux.NUMEMP
            AND  A.TIPCOL = l_r038afa_aux.TIPCOL
            AND  A.NUMCAD = l_r038afa_aux.NUMCAD
            AND ((A.ORIAFA <> 1 OR A.ORIAFA IS NULL) OR EXISTS (SELECT CODSIT FROM R010SIT SIT WHERE SIT.CODSIT = l_r038afa_aux.SITAFA AND TIPSIT = 15))
            AND (A.DATAFA <> l_r038afa_aux.DATAFA OR (A.DATAFA = l_r038afa_aux.DATAFA AND A.HORAFA <> l_r038afa_aux.HORAFA))
            AND ( ( (A.DATAFA > l_r038afa_aux.DATAFA OR (A.DATAFA = l_r038afa_aux.DATAFA AND A.HORAFA >= l_r038afa_aux.HORAFA)) AND
                    (A.DATAFA < l_r038afa_aux.DATTER OR l_r038afa_aux.DATTER = l_data_zero OR (A.DATAFA = l_r038afa_aux.DATTER AND (A.HORAFA < l_r038afa_aux.HORTER OR l_r038afa_aux.HORTER = 0))) )
             OR   ( (A.DATTER > l_r038afa_aux.DATAFA OR A.DATTER = l_data_zero OR (A.DATTER = l_r038afa_aux.DATAFA AND (A.HORTER > l_r038afa_aux.HORAFA OR A.HORTER = 0))) AND
                    ((A.DATTER < l_r038afa_aux.DATTER AND A.DATTER <> l_data_zero) OR l_r038afa_aux.DATTER = l_data_zero OR (A.DATTER = l_r038afa_aux.DATTER AND (A.HORTER <= l_r038afa_aux.HORTER OR l_r038afa_aux.HORTER = 0)))
             OR   ( (l_r038afa_aux.DATAFA > A.DATAFA OR (l_r038afa_aux.DATAFA = A.DATAFA AND l_r038afa_aux.HORAFA >= A.HORAFA)) AND
                    ((l_r038afa_aux.DATTER < A.DATTER AND l_r038afa_aux.DATTER <> l_data_zero) OR A.DATTER = l_data_zero OR (l_r038afa_aux.DATTER = A.DATTER AND l_r038afa_aux.HORTER <= A.HORTER)) ) ) );
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
              l_count:=0;
            WHEN OTHERS THEN
              RAISERROR 103 'Erro no SELECT R038AFA - em R038AFA_AU';
        END;
    END IF;
    IF  l_count > 0 THEN
        l_strerr := 'Erro de Sobreposição de Afastamentos para Empresa = '||
                     CONVERT(NUMBER_TO_CHAR,l_r038afa_aux.NUMEMP)||' Colaborador = '||
                     CONVERT(NUMBER_TO_CHAR,l_r038afa_aux.NUMCAD);
        RAISERROR 103 l_strerr;
    END IF;

    /* atualiza a situcao do afastamento em r034fun se for historico atual */
    IF  (l_r038afa_aux.STAATU = 1) OR (l_r038afa_aux.STAATU = 3) THEN
        R038AFA_ATUSIT(l_r038afa_aux.SITAFA,
                       l_r038afa_aux.SITANT,
                       l_r038afa_aux.TIPCOL,
                       l_r038afa_aux.NUMEMP,
                       l_r038afa_aux.NUMCAD,
                       l_r038afa_aux.DATAFA,
                       l_r038afa_aux.HORAFA,
                       l_r038afa_aux.CAUDEM,
                       l_r038afa_aux.DATTER,
                       l_r038afa_aux.FIMQUA,
                       l_r038afa_aux.STAATU,
                       l_r038afa_aux.DIABLQ);
    END IF;

    IF (l_r038afa_aux.SitAfa <> l_r038afa_aux.SitAnt) OR (l_r038afa_aux.DatTer <> l_r038afa_aux.DtTOld) THEN
    
    	  /* tratamento para afastamentos */
    	  l_data_fim := DATETIME(04, 06, 2080, 0, 0, 0);
          
          IF (l_r038afa_aux.DATTER > l_data_zero) THEN
               l_data_fim := l_r038afa_aux.DATTER; 
          END IF;
       
          FOREACH cursorPlanoContas INTO x_ESTPOS, x_CODPLV, x_DATINI
          LOOP
              l_xEstPos := x_ESTPOS;
              l_xCodPlv := x_CODPLV;
             
              IF ( l_r038afa_aux.DATAFA < x_DATINI ) THEN
                l_DataAfasTmp := x_DATINI;
              ELSE
                 l_DataAfasTmp := l_r038afa_aux.DATAFA; 
              END IF;
              
       	   /* desconta  */
       	   QL_PROCEAFA('O', l_r038afa_aux.EmpOld, l_r038afa_aux.TipOld, l_r038afa_aux.CadOld, l_r038afa_aux.SitAnt, l_xEstPos, l_xCodPlv, l_DataAfasTmp, l_r038afa_aux.DtTOld, 0); 
         
              /* atualiza o anterior */
              QL_PROCEAFA('U', l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_r038afa_aux.SITAFA, l_xEstPos, l_xCodPlv, l_DataAfasTmp, l_r038afa_aux.DatTer, 0);
         
          END LOOP; /* fim loop cursor */
    
      /* Caso trabalho com postos de trabalho atualizamos o efetivo por posto do registro origem e destino */
      QL_UTIPOSTRA(l_r038afa_aux.NUMEMP, l_r038afa_aux.DATAFA, l_xUtiPosOri OUT, l_xEstPosOri OUT, l_xCodPlvOri OUT);
      QL_UTIPOSTRA(l_r038afa_aux.EmpOld, l_r038afa_aux.DATAFA, l_xUtiPosDes OUT, l_xEstPosDes OUT, l_xCodPlvDes OUT);

      /* Atualiza o Quadro Efetivo - QL */
      IF (l_xUtiPosOri = 'N') THEN
        QL_EXCAFAST(l_r038afa_aux.EmpOld, l_r038afa_aux.TipOld, l_r038afa_aux.CadOld, l_r038afa_aux.DtAOld, l_r038afa_aux.SitAnt, l_r038afa_aux.DtTOld, l_r038afa_aux.DATAFA, l_r038afa_aux.SITAFA, l_r038afa_aux.DATTER);
      END IF;

      IF (l_xUtiPosDes = 'N') THEN
        QL_INCAFAST(l_r038afa_aux.NumEmp, l_r038afa_aux.TipCol, l_r038afa_aux.NumCad, l_r038afa_aux.DatAfa, l_r038afa_aux.SitAfa, l_r038afa_aux.DatTer, l_r038afa_aux.DATAFA, l_r038afa_aux.SITAFA, l_r038afa_aux.DATTER);
      END IF;
    END IF;

    /* INÍCIO - eSocial */
    l_gerarPendencia := FALSE;
	RH_LAYOUTCOLAB(l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_layout OUT);
	N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);

 	IF (l_gerarPendencia = TRUE) THEN
	    SP_RETORNAR_MOTESO(l_r038afa_aux.SITAFA, l_r038afa_aux.DATAFA, l_MotEso OUT, l_EnvObs OUT);
    	SP_RETORNAR_TIPSIT(l_r038afa_aux.SITAFA, l_TipSit OUT, l_BloAce OUT);
    	RH_RET_DATADM(l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_DataAdmissao OUT);
	
		l_EnvEso := 1; /* 1 - Sim*/
		/* Quando motivo eSocial for 14 - Cessão/Requisição ou 24 - Mandato Sindical - Afastamento temporário para exercício de mandato sindical obrigatoriamente deve existir histórico de cessão
		 * No histórico de cessão é indicado se deve enviar ao eSocial ou não (campo envEso), visto que existem cenários facultativos, sendo assim, o envio só deve ser efetuado para envEso = 1 - Sim */
		IF (l_MotEso IN (14, 24)) THEN
		  SP_RETENVESO_HCE(l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_r038afa_aux.DATAFA, l_EnvEso OUT);
		END IF;
			     
	    /* MotEso = 0 - Não enviar ao eSocial */
	    IF ((l_MotEso <> 0) AND (l_TipSit NOT IN (16,17,18)) AND (l_EnvEso = 1) AND ((l_r038afa_aux.DatTer >= l_DataAdmissao) OR (l_r038afa_aux.DatTer = l_data_zero))) THEN 
		  l_AlterouFim := FALSE;
		  l_ZerouDatTer := FALSE;
		  l_JsonCamposAlterados := '';
		  
		  /* S2230 - fimAfastamento */
		  SP_VALUPDATE_DAT(l_r038afa_aux.DtTOld, l_r038afa_aux.DatTer, l_Valido OUT);
		  IF (l_Valido = TRUE) THEN
			l_AlterouFim := TRUE;
			IF (l_r038afa_aux.DatTer = l_data_zero) THEN
			  l_ZerouDatTer := TRUE;
			END IF;
			SP_CONCAT_DAT_JSON('DATTER', l_r038afa_aux.DatTer, l_r038afa_aux.DtTOld, l_JsonCamposAlterados OUT);   
		  END IF;
	
		  IF (l_AlterouFim = TRUE) THEN
		    /* CONTROLE MOTIVO AFASTAMENTO NÃO RETROATIVO ESOCIAL */
		    IF (l_r038afa_aux.MOTALT = 'S') THEN 
		      l_DataAnteriorAfastamento := DATETIMEADD(DD, -1, l_r038afa_aux.DatAfa);
		      l_DatAfa := DATETIME(31, 12, 1900, 0, 0, 0);
		      l_DatTer := DATETIME(31, 12, 1900, 0, 0, 0);
		      l_HorAfa := 0;
		      
		      FOREACH C_AFAANT_EU INTO l_DatAfaAux, l_HorAfaAux, l_HorTerAux, l_DatTerAux
		      LOOP
		        l_DatAfa := l_DatAfaAux;
			    l_HorAfa := l_HorAfaAux;
			    l_DatTer := l_DatTerAux;
			    EXIT; 
		      END LOOP;
		    ELSE  
		      l_DatAfa := l_r038afa_aux.DatAfa;
		      l_HorAfa := l_r038afa_aux.HORAFA;      
		    END IF;
		    
	
			IF (l_DatAfa <> l_data_zero) THEN 
			    l_Valor := '';
			    SP_CONCATENAR_DAT('DATAFA', l_DatAfa, l_Valor OUT);
			    SP_CONCATENAR_NUM('HORAFA', l_HorAfa, l_Valor OUT);
			    SP_CONCATENAR_NUM('SECAFA', 3, l_Valor OUT); /* 3 - Fim afastamento */
			    SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
			      
			    RH_DEF_ESOCIAL(l_r038afa_aux.NUMEMP, l_DataInicioTabelas OUT, l_DataInicioEsocial OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
			      
			    /* SE ZEROU DATA DE TERMINO DEVE ENVIAR A EXCLUSÃO DA SEÇÃO fimAfastamento */
			    IF (l_ZerouDatTer = TRUE) THEN
			        SP_CONCATENAR_DES('LAYOUT', 'S-2230', l_Valor OUT);
			        SP_E_SOCIAL('S-3000', 'R038AFA', 'N', 'A', NULL, NULL, l_r038afa_aux.NumEmp, l_r038afa_aux.TipCol, l_r038afa_aux.NumCad, l_Valor, '', 0, NULL, l_DatAfa, 0, 'R038AFA_SU');
			        IF (l_DataInicioNaoPeriodicos > l_DataAdmissao) THEN
			            IF (l_DatAfa <= l_DataAdmissao) THEN
			                SP_E_SOCIAL(l_layout, 'R038AFA', 'N', 'A', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, l_JsonCamposAlterados, 0, NULL, l_DataInicioNaoPeriodicos, 0, 'R038AFA_SU');
			            END IF;
			        END IF;
			        /* Ao zerar a data de término do afastamento, caso o Fim do Afastamento foi enviado junto ao Início, esse vínculo do afastamento deve ser excluído ( Tratamento do Ambiente do eSocial)
			         * E para essa situação será criada uma pendência de início, afim de refazer o vínculo do afastamento com o ambiente do eSocial.
			         * 
			         * O comportamento será assim:
			         * - Início c/ Fim: Sera excluído e a geração da nova pendência irá se encarregar de fazer o novo vinculo.
			         * - Início e Fim Separados: Será excluído o envio de fim e a ratificado o vinculo do início do afastamento. 
			         */
					l_Valor := '';
		            SP_CONCATENAR_DAT('DATAFA', l_DatAfa, l_Valor OUT);
		            SP_CONCATENAR_NUM('HORAFA', l_HorAfa, l_Valor OUT);
		            SP_CONCATENAR_NUM('SECAFA', 1, l_Valor OUT); /* 1 - Início afastamento */	            
		            SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
		                
		            SP_E_SOCIAL('S-2230', 'R038AFA', 'N', 'A', NULL, NULL, l_r038afa_aux.NumEmp, l_r038afa_aux.TipCol, l_r038afa_aux.NumCad, l_Valor, '', 0, NULL, l_DatAfa, 0, 'R038AFA_SU');
			    ELSE
			        IF (l_r038afa_aux.DatTer >= l_DataInicioNaoPeriodicos) THEN
					    SP_E_SOCIAL('S-2230', 'R038AFA', 'N', 'A', NULL, NULL, l_r038afa_aux.NumEmp, l_r038afa_aux.TipCol, l_r038afa_aux.NumCad, l_Valor, '', 0, NULL, l_r038afa_aux.DatTer, 0, 'R038AFA_SU');
					    IF ((l_DataInicioNaoPeriodicos > l_DataAdmissao) AND (l_r038afa_aux.DtTOld <= l_DataInicioNaoPeriodicos) AND (l_r038afa_aux.DtTOld <> l_data_zero)) THEN
			                SP_E_SOCIAL(l_layout, 'R038AFA', 'N', 'A', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, l_JsonCamposAlterados, 0, NULL, l_DataInicioNaoPeriodicos, 0, 'R038AFA_SU');
			            END IF;			  
			        ELSE
			            SP_CONCATENAR_DES('LAYOUT', 'S-2230', l_Valor OUT);
			            SP_E_SOCIAL('S-3000', 'R038AFA', 'N', 'A', NULL, NULL, l_r038afa_aux.NumEmp, l_r038afa_aux.TipCol, l_r038afa_aux.NumCad, l_Valor, '', 0, NULL, l_DatAfa, 0, 'R038AFA_SU');	          
			            IF (l_DataInicioNaoPeriodicos > l_DataAdmissao) THEN
			                SP_E_SOCIAL(l_layout, 'R038AFA', 'N', 'A', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, l_JsonCamposAlterados, 0, NULL, l_DataInicioNaoPeriodicos, 0, 'R038AFA_SU');
			            END IF;
			        END IF;
			    END IF;
			END IF;
		  END IF;
		END IF;
	END IF;
	/* FIM - eSocial */
  END LOOP;
  
  /* Apaga Registro OLD/NEW em R038AFA_AUX */
  BEGIN
    DELETE FROM R038AFA_AUX;
    DROP_TEMP_TABLE R038AFA_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀QÔ␀␀		SENIOR;0ë¿␀␀

TRIGGER R038AFA_EU AFTER UPDATE ON R038AFA FOR EACH ROW
DECLARE
  l_online       BOOLEAN;
  l_TipSit         R010SIT.TIPSIT%TYPE;
  l_BloAce         R010SIT.BLOACE%TYPE;
  l_OriExa       NUMBER(3);
  l_TipOri       NUMBER(3);
  l_data_zero    DATE;
  l_data_fim     DATE;
  l_status       NUMBER;
  l_datter       CHAR(8);
  l_horter       CHAR(4);
  
  l_chave        VARCHAR2(50);
  l_tippesstr    CHAR(2);
  l_numempstr    CHAR(4);
  l_tipcolstr    CHAR(1);
  l_numcadstr    CHAR(9);
  l_data         CHAR(8);
  l_hora         CHAR(4);

  l_TemPenFut    BOOLEAN;
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_AltEmp         R038PEN.ALTEMP%TYPE;
  l_AltFil         R038PEN.ALTFIL%TYPE;
  l_AltLoc         R038PEN.ALTLOC%TYPE;
  l_AltCcu         R038PEN.ALTCCU%TYPE;
  l_AltCar         R038PEN.ALTCAR%TYPE;
  l_AltEsc         R038PEN.ALTESC%TYPE;
  l_AltDes         R038PEN.ALTDES%TYPE;
  l_SitChe         R038PEN.SITCHE%TYPE;
  l_SitUsu         R038PEN.SITUSU%TYPE;
  l_NesRev         R038PEN.NESREV%TYPE;
  l_EmpAtu         R038PEN.EMPATU%TYPE;
  l_CadAtu         R038PEN.CADATU%TYPE;
  l_ColChe       BOOLEAN;
  l_ColUsu       BOOLEAN;
  l_auxSitChe      R038PEN.SITCHE%TYPE;
  l_auxSitUsu      R038PEN.SITUSU%TYPE;
  l_AssDesCol      R000ASS.DESCOL%TYPE;
  
  /* VARIÁVEIS DE CONTROLE DO LOG */
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);

  /* Declaracao para criar tabela temporária em SQL Server - Erros de DeadLock */
  CREATE_TEMP_TABLE R038AFA_AUX;
  /*VARIAVEIS DO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_alterou          BOOLEAN;
  l_Valor            VARCHAR(2000); 
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_Valido           BOOLEAN;
  /* VARIAVEIS DE CONTROLE E-SOCIAL */
  l_AlterouFim       BOOLEAN;
  l_ZerouDatTer      BOOLEAN;
  l_ZerouDatAlt      BOOLEAN;
  l_DataAdmissao      DATE;
  l_DataInicioEsocial DATE;
  l_DataInicioTabelas DATE;
  l_DataInicioNaoPeriodicos DATE;
  l_DataInicioPeriodicos DATE;
  l_DataInicioSST        DATE;
  l_DataInicioMigracao DATE;
  l_AlterouSitAfa        BOOLEAN;
  l_layout               VARCHAR(6);
  l_InfoFacult           BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_gerarPendencia     BOOLEAN;
  
  l_DataAnteriorAfastamento   R038AFA.DATAFA%TYPE;
  l_DatAfaAux                 R038AFA.DATAFA%TYPE;
  l_HorAfaAux                 R038AFA.HORAFA%TYPE;
  l_HorTerAux                 R038AFA.HORTER%TYPE;
  l_DatAfa                    R038AFA.DATAFA%TYPE;
  l_HorAfa                    R038AFA.HORAFA%TYPE;
  l_MotEso                    R010ESO.MOTESO%TYPE;
  l_MotEso_Ant                R010ESO.MOTESO%TYPE;
  l_EnvObs                    R010ESO.ENVOBS%TYPE;
  l_EnvObs_Ant                R010ESO.ENVOBS%TYPE;
  l_EnvEso                    R038HCE.ENVESO%TYPE;
  l_JsonCamposAlterados VARCHAR2(2000);
  
  l_data_atual         DATE;    
  l_qtdDiasDatTer      NUMBER;
  l_qtdDiasDatAtu      NUMBER;
  l_difQtddiasAfa      NUMBER;
  l_excluir            BOOLEAN;
  l_R350PEN_Dathor_Ant NUMBER(14,6); 
  l_R350PEN_Dathor_Pos NUMBER(14,6);
  l_VersaoESocial NUMBER;
BEGIN
  l_data_atual := CURDATE();
  l_Valor := '';
  SP_RETORNAR_TIPSIT(:NEW.SITAFA, l_TipSit OUT, l_BloAce OUT);
  BEGIN
    SELECT DESCOL INTO l_AssDesCol
      FROM R000ASS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_AssDesCol := 0;
  END;

  IF (l_AssDesCol = 2) AND (l_TipSit = 7) THEN
    /* Verifica se o colaborador está associado ao cadastro de chefia ou
       se o colaborador está associado com algum usuário */
    R038PEN_COLCHEFE(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATAFA, l_ColChe OUT, l_ColUsu OUT);

    /* Se o colaborador é chefe ou está associado a um usuário gera pendência */
    IF (l_ColChe = TRUE OR l_ColUsu = TRUE) THEN
      /* Verifica se existe pendência numa data futura */
      R038PEN_TEMPENFUT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATAFA, l_TemPenFut OUT);

      /* se não existe pendência com data futura, verifica se existe pendência com data passada e situação não atendida */
      IF (l_TemPenFut = FALSE) THEN
        BEGIN
             SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU
               INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu
               FROM R038PEN
              WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                    R038PEN.TIPCOL = :NEW.TIPCOL AND
                    R038PEN.NUMCAD = :NEW.NUMCAD AND
                    R038PEN.DATTRF < :NEW.DATAFA AND
                    ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
                     (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));
        EXCEPTION
             WHEN NO_DATA_FOUND THEN
                  l_NumEmp := 0;
                  l_TipCol := 0;
                  l_NumCad := 0;
                  l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
        END;

        /* Considera que sempre altera Desligamento na inclusão do histórico de Afastamento para criação da pendência */
        l_AltDes := 'S';

        /* Verifica se deve gerar pendencia de chefia */
        IF (l_ColChe = TRUE) THEN
          l_SitChe := 1; /* Não Atendida */
        ELSE
          l_SitChe := 3; /* Sem necessidade de Alteração */
        END IF;

        /* Verifica se deve gerar pendencia de usuário */
        IF (l_ColUsu = TRUE) THEN
          l_SitUsu := 1; /* Não Atendida */
        ELSE
          l_SitUsu := 4; /* Sem necessidade de Alteração */
        END IF;

        /* Se existir uma pendência com data passada e situação 1 (Não atendida), esta
           será excluída e regerada com a nova data */
        IF (l_NumCad <> 0) THEN
          /* Insere nova pendência com base nos valores da pendência da data passada */
          BEGIN
            INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATAFA, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu);
          EXCEPTION
            WHEN OTHERS THEN
               RAISERROR 103 'Erro ao inserir registro na R038PEN.';
          END;

          /* Deleta pendência da data passada */
          R038PEN_DELPENPAS(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATAFA);

        ELSE
          /* Verifica se existe pendência na mesma data de alteração */
          BEGIN
               SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, SITCHE, SITUSU INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_auxSitChe, l_auxSitUsu
                 FROM R038PEN
                WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                      R038PEN.TIPCOL = :NEW.TIPCOL AND
                      R038PEN.NUMCAD = :NEW.NUMCAD AND
                      R038PEN.DATTRF = :NEW.DATAFA;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_NumEmp := 0;
                    l_TipCol := 0;
                    l_NumCad := 0;
                    l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
                    l_auxSitChe := 0;
                    l_auxSitUsu := 0;
          END;

          /* Se existir pendência na mesma data, atualiza a pendência */
          IF (l_NumCad <> 0) THEN

            IF ((l_auxSitChe = 1 OR l_auxSitChe = 3) AND
                (l_auxSitUsu = 1 OR l_auxSitUsu = 4)) THEN
              /* Atualiza pendência */
              BEGIN
                UPDATE R038PEN SET ALTDES = l_AltDes, SITCHE = l_SitChe, SITUSU = l_SitUsu
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATAFA;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            ELSE
              /* Se a Situação for diferente de "Não atendida" ou "Sem necessidade de alteração", então
                 indica na pendência que necessita Revisão */
              BEGIN
                UPDATE R038PEN SET ALTDES = l_AltDes, NESREV = 'S'
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATAFA;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            END IF;

          ELSE

            /* Insere nova pendência */
            BEGIN
              INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATAFA, 'N', 'N', 'N', 'N', 'N', 'N', l_AltDes, l_SitChe, l_SitUsu, 'N', 0, 0);
            EXCEPTION
              WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
            END;

          END IF;
        END IF;
      END IF;

    END IF;
  END IF;

  QL_ATUEFEFUN(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATAFA, :NEW.SITAFA);

  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       /* Se tinha um afastamento presente e ficou passado, então atualizar a controle, como exclusão de afastamento. */
       IF  (:NEW.STAATU = 2) AND (:OLD.STAATU = 1) THEN
           SP_HisAfa ('D', :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATAFA, :NEW.HORAFA, :NEW.DATTER, :NEW.HORTER, :NEW.SITAFA, :OLD.DATTER, :OLD.HORTER, :OLD.SITAFA);
       ELSE
           SP_HisAfa ('U', :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATAFA, :NEW.HORAFA, :NEW.DATTER, :NEW.HORTER, :NEW.SITAFA, :OLD.DATTER, :OLD.HORTER, :OLD.SITAFA);
       END IF;
       
      /* VERIFICA SE EH PARA INCLUIR NO CADASTRO DE PESSOAS NÃO GRATAS */
      /* Se o afastamento for gerado por troca de filial, não inclui como PNG */
      IF  (l_tipsit = 7) AND (:NEW.oriAfa <> 5) THEN
          R038AFA_ATUPNG('I',:NEW.numemp, :NEW.tipcol, :NEW.numcad, :NEW.datafa);
      END IF;       
  END IF;


  IF   (:NEW.STAATU = 2) AND (:OLD.STAATU = 1) THEN
       l_status := 3; /* alterou um historico que era atual para passado */
  ELSE l_status := :NEW.STAATU;
  END IF;

  BEGIN
  /* Insere Registro NEW */
    INSERT INTO R038AFA_AUX (NUMEMP,TIPCOL,NUMCAD,DATAFA,HORAFA,SITAFA,CAUDEM,DATTER,FIMQUA,HORTER,ORIAFA,SITANT,STAATU, EMPOLD, TIPOLD, CADOLD, DTAOLD, HAFOLD, DTTOLD,DIABLQ,MOTALT)
         VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATAFA,:NEW.HORAFA,:NEW.SITAFA,:NEW.CAUDEM,:NEW.DATTER,:NEW.FIMQUA,:NEW.HORTER,:NEW.ORIAFA,:OLD.SITAFA,l_status, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATAFA, :OLD.HORAFA, :OLD.DATTER, :NEW.DIABLQ,:NEW.MOTALT);
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro no INSERT em R038AFA_AUX.';
  END;

  /* Busca o Tipo da Situação */
  SP_RETORNAR_TIPSIT(:OLD.SITAFA, l_TipSit OUT, l_BloAce OUT);
  /* Dependendo do Tipo de situação, a Origem é diferente */
  l_TipOri := 0;
  IF   (l_TipSit = 3) THEN
       l_TipOri := 3;
  ELSIF (l_TipSit = 4) THEN
       l_TipOri := 4;
  ELSIF (l_TipSit = 5) THEN
       l_TipOri := 5;
  ELSIF (l_TipSit = 6) THEN
       l_TipOri := 6;
  ELSIF (l_TipSit = 14) THEN
       l_TipOri := 8;
  ELSIF (l_TipSit = 19) THEN
       l_TipOri := 7;
  END IF;

  /* Busca a Origem do Exame com o Tipo especificado */
  l_OriExa := 0;
  RH_RETORIEXA(l_TipOri, l_OriExa OUT);

  l_data_zero := DATETIME(31, 12, 1900, 0, 0, 0);
  IF   (l_OriExa > 0) AND ((:OLD.SITAFA <> :NEW.SITAFA) OR (:OLD.EXMRET <> :NEW.EXMRET) OR (:NEW.DATTER = l_data_zero)) THEN
       /* Inclui as Solicitações de Exames Periódicos cadastrados para o Afastamento e
          Exclui as Solicitações cadastradas anteriormente */
       RH_EXC_SOLIC('A', :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATAFA, l_OriExa);
       RH_EXA_AFAST('U',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATAFA,:NEW.SITAFA,:OLD.DATTER,:NEW.DATTER,:NEW.EXMRET);
  END IF;

  IF   (:OLD.SITAFA <> :NEW.SITAFA) THEN
       /* Inclui as Solicitações de Exames Periódicos cadastrados para o Acompanhamento de Demissão e
          Exclui as Solicitações cadastradas anteriormente */
       RH_EXC_SOLIC('D', :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATAFA, 12);
       RH_EXA_ACDEM(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATAFA,:NEW.SITAFA,:OLD.DATTER);
  END IF;

  /* OriAfa = 1 = Afastamentos de Perda de Férias Incluídos na Apuração do Ronda */
  /* Condição "IS NULL" incluída para tratar quando houver (por ex.) telas do SGI que não setam ORIAFA. */
  IF   (:NEW.ORIAFA <> 1) OR (:NEW.ORIAFA IS NULL) THEN
       /* Na Alteração do Registro seta todo o periodo como alterado */
       /* Também verifica a Data Final                               */
       IF   ((:OLD.DATTER = l_data_zero) OR (:NEW.DATTER = l_data_zero)) THEN
            l_data_fim := DATETIME(04, 06, 2080, 0, 0, 0);
       ELSIF (:NEW.DATTER > :OLD.DATTER) THEN
            l_data_fim := :NEW.DATTER;
       ELSE l_data_fim := :OLD.DATTER;
       END IF;

       /* Verifica se foi alterado alguma campo que infuencia. Campo status nao influencia. */
       IF  (:NEW.DATTER <> :OLD.DATTER) OR (:NEW.HORTER <> :OLD.HORTER) OR (:NEW.PRVTER <> :OLD.PRVTER) OR
           (:NEW.SITAFA <> :OLD.SITAFA) OR (:NEW.CAUDEM <> :OLD.CAUDEM) OR (:NEW.DIAJUS <> :OLD.DIAJUS) OR
           (:NEW.QHRAFA <> :OLD.QHRAFA) OR (:NEW.ORIAFA <> :OLD.ORIAFA) OR (:NEW.EXMRET <> :OLD.EXMRET) OR
           (:NEW.CONTOV <> :OLD.CONTOV) OR (:NEW.OBSAFA <> :OLD.OBSAFA) OR (:NEW.FIMQUA <> :OLD.FIMQUA) THEN
           BEGIN
           UPDATE R066APU SET DIAALT = 8
             WHERE NUMEMP = :NEW.NUMEMP AND
                   TIPCOL = :NEW.TIPCOL AND
                   NUMCAD = :NEW.NUMCAD AND
                   DATAPU >= :NEW.DATAFA AND
                   DATAPU <= l_data_fim;
           EXCEPTION WHEN OTHERS THEN
             NULL;
           END;
       END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R038AFA');

  IF (l_auditoria = 'S') THEN

       l_camposAlterados := 'Campo(s) alterado(s): ';
       l_alterou := FALSE;

      IF (:NEW.NUMEMP <> :OLD.NUMEMP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMEMP ';
      END IF;

      IF (:NEW.TIPCOL <> :OLD.TIPCOL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPCOL ';
      END IF;

      IF (:NEW.NUMCAD <> :OLD.NUMCAD) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCAD ';
      END IF;

      IF (:NEW.DATAFA <> :OLD.DATAFA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATAFA ';
      END IF;

      IF (:NEW.HORAFA <> :OLD.HORAFA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORAFA ';
      END IF;

      IF (:NEW.DATTER <> :OLD.DATTER) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATTER ';
      END IF;

      IF (:NEW.HORTER <> :OLD.HORTER) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORTER ';
      END IF;

      IF (:NEW.PRVTER <> :OLD.PRVTER) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PRVTER ';
      END IF;

      IF (:NEW.SITAFA <> :OLD.SITAFA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SITAFA ';
      END IF;

      IF (:NEW.DIAJUS <> :OLD.DIAJUS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DIAJUS ';
      END IF;

      IF (:NEW.OBSAFA <> :OLD.OBSAFA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'OBSAFA ';
      END IF;

      IF (:NEW.STAATU <> :OLD.STAATU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'STAATU ';
      END IF;

      IF (:NEW.CAUDEM <> :OLD.CAUDEM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CAUDEM ';
      END IF;

      IF (:NEW.FIMQUA <> :OLD.FIMQUA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'FIMQUA ';
      END IF;

      IF (:NEW.DIABLQ <> :OLD.DIABLQ) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DIABLQ ';
      END IF;

      IF (:NEW.QHRAFA <> :OLD.QHRAFA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'QHRAFA ';
      END IF;

      IF (:NEW.ORIAFA <> :OLD.ORIAFA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'ORIAFA ';
      END IF;

      IF (:NEW.EXMRET <> :OLD.EXMRET) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'EXMRET ';
      END IF;
      
      IF (:NEW.CONTOV <> :OLD.CONTOV) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CONTOV ';
      END IF;

      IF (:NEW.MOTRAI <> :OLD.MOTRAI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'MOTRAI ';
      END IF;

      IF (:NEW.NROAUT <> :OLD.NROAUT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NROAUT ';
      END IF;

      IF (:NEW.CODOEM <> :OLD.CODOEM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODOEM ';
      END IF;

      IF (:NEW.CODSUB <> :OLD.CODSUB) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODSUB ';
      END IF;

      IF (:NEW.DATPER <> :OLD.DATPER) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATPER ';
      END IF;

      IF (:NEW.SITINI <> :OLD.SITINI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SITINI ';
      END IF;

      IF (:NEW.RISNEX <> :OLD.RISNEX) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'RISNEX ';
      END IF;

      IF (:NEW.DATNEX <> :OLD.DATNEX) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATNEX ';
      END IF;

      IF (:NEW.DIAPRV <> :OLD.DIAPRV) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DIAPRV ';
      END IF;

      IF (:NEW.CODCUA <> :OLD.CODCUA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODCUA ';
      END IF;

      IF (:NEW.TMACUA <> :OLD.TMACUA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TMACUA ';
      END IF;
      
      IF (:NEW.ATEPAT <> :OLD.ATEPAT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'ATEPAT ';
      END IF;
      
      IF (:NEW.DATPAR <> :OLD.DATPAR) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'V ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R038AFA_AUD
                   WHERE NUMEMP = :OLD.NUMEMP AND
                         TIPCOL = :OLD.TIPCOL AND
                         NUMCAD = :OLD.NUMCAD AND
                         DATAFA = :OLD.DATAFA AND
                         HORAFA = :OLD.HORAFA;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R038AFA_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,DATAFA,HORAFA,DATTER,HORTER,PRVTER,
                                       SITAFA,DIAJUS,OBSAFA,STAATU,CAUDEM,DIABLQ,QHRAFA,ORIAFA,EXMRET,CONTOV,
                                       MOTRAI,NROAUT,CODOEM,CODSUB,DATPER,SITINI,RISNEX,DATNEX,DIAPRV,CODCUA,
                                       TMACUA,DATPAR,FIMQUA)
                               VALUES (l_seqreg,l_verseq,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATAFA,
                                      :NEW.HORAFA,:NEW.DATTER,:NEW.HORTER,:NEW.PRVTER,:NEW.SITAFA,:NEW.DIAJUS,
                                      :NEW.OBSAFA,:NEW.STAATU,:NEW.CAUDEM,:NEW.DIABLQ,:NEW.QHRAFA,:NEW.ORIAFA,
                                      :NEW.EXMRET,:NEW.CONTOV,:NEW.MOTRAI,:NEW.NROAUT,:NEW.CODOEM,:NEW.CODSUB,
                                      :NEW.DATPER,:NEW.SITINI,:NEW.RISNEX,:NEW.DATNEX,:NEW.DIAPRV,:NEW.CODCUA,
                                      :NEW.TMACUA,:NEW.DATPAR,:NEW.FIMQUA);

              SP_AUDGENREG(l_seqreg,l_verseq,'R038AFA',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
  
  /* INÍCIO - eSocial */
  l_gerarPendencia := FALSE;
  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
  N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    	
  IF (l_gerarPendencia = TRUE) THEN
	  SP_RETORNAR_MOTESO(:NEW.SITAFA, :NEW.DATAFA, l_MotEso OUT, l_EnvObs OUT);
	  SP_RETORNAR_TIPSIT(:NEW.SITAFA, l_TipSit OUT, l_BloAce OUT);
	  RH_RET_DATADM(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DataAdmissao OUT);
	  l_InfoFacult := TRUE;
	  l_SimplificaoESocial := FALSE;
	  l_VersaoESocial := 0;
	  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
	      
	  l_EnvEso := 1; /* 1 - Sim*/
	  /* Quando motivo eSocial for 14 - Cessão/Requisição ou 24 - Mandato Sindical - Afastamento temporário para exercício de mandato sindical obrigatoriamente deve existir histórico de cessão
	   * No histórico de cessão é indicado se deve enviar ao eSocial ou não (campo envEso), visto que existem cenários facultativos, sendo assim, o envio só deve ser efetuado para envEso = 1 - Sim */
	  IF (l_MotEso IN (14, 24)) THEN
	  	SP_RETENVESO_HCE(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATAFA, l_EnvEso OUT);
	  END IF;
		    
	  /* MotEso = 0 - Não enviar ao eSocial */
	  IF ((l_MotEso <> 0) AND (l_TipSit NOT IN (16,17,18)) AND (l_EnvEso = 1) AND ((:NEW.DatTer >= l_DataAdmissao) OR (:NEW.DatTer = DATETIME(31, 12, 1900, 0, 0, 0)))) THEN
	    l_AlterouFim := FALSE;
	    l_ZerouDatTer := FALSE;
	    l_ZerouDatAlt := FALSE;
	    l_JsonCamposAlterados := '';
		  
	    SP_RETORNAR_MOTESO(:OLD.SITAFA, :NEW.DATAFA, l_MotEso_Ant OUT, l_EnvObs_Ant OUT);
	
		/* iniAfastamento */
		SP_VALUPDATE_NUM(:OLD.SITAFA, :NEW.SITAFA, l_Valido OUT);
	    IF (l_Valido = TRUE) THEN
	      l_Alterou := TRUE;
	      l_AlterouSitAfa := TRUE;
	      SP_CONCAT_NUM_JSON('SITAFA', :NEW.SITAFA, :OLD.SITAFA, l_JsonCamposAlterados OUT);
	    END IF;
		
	    SP_VALUPDATE_DES(:OLD.MSMMOT, :NEW.MSMMOT, l_Valido OUT);
	    IF (l_Valido = TRUE) THEN
	      l_Alterou := TRUE;
	    END IF;
		
	    SP_VALUPDATE_NUM(:OLD.ACITRA, :NEW.ACITRA, l_Valido OUT);
	    IF (l_Valido = TRUE) THEN
	      l_Alterou := TRUE;
	    END IF;	
		
		SP_VALUPDATE_DES(:OLD.OBSAFA, :NEW.OBSAFA, l_Valido OUT); 
	    IF ((l_Valido = TRUE) AND (l_EnvObs = 1)) THEN
	      l_Alterou := TRUE;
	    END IF;
		
		IF (l_InfoFacult = TRUE AND l_SimplificaoESocial = FALSE) THEN
		  /* infoAtestado */
		  SP_VALUPDATE_DES(:OLD.CODDOE, :NEW.CODDOE, l_Valido OUT);
	      IF (l_Valido = TRUE) THEN
	      	l_Alterou := TRUE;
	      END IF;
	      	      		
		  /* emitente */
	      SP_VALUPDATE_DES(:OLD.NOMATE, :NEW.NOMATE, l_Valido OUT);
	      IF (l_Valido = TRUE) THEN
	      	l_Alterou := TRUE;
	      END IF;
		
	      SP_VALUPDATE_NUM(:OLD.ORGCLA, :NEW.ORGCLA, l_Valido OUT);
	      IF (l_Valido = TRUE) THEN
	      	l_Alterou := TRUE;
	      END IF;
		  
	      SP_VALUPDATE_DES(:OLD.REGCON, :NEW.REGCON, l_Valido OUT);
	      IF (l_Valido = TRUE) THEN
	      	l_Alterou := TRUE;
	      END IF;
		  
	      SP_VALUPDATE_DES(:OLD.ESTCON, :NEW.ESTCON, l_Valido OUT);
	      IF (l_Valido = TRUE) THEN
	      	l_Alterou := TRUE;
	      END IF;
	    END IF;	
		
		/* infoRetif */
		SP_VALUPDATE_NUM(:OLD.ORIMOT, :NEW.ORIMOT, l_Valido OUT);
	    IF (l_Valido = TRUE) THEN
	      l_Alterou := TRUE;
	    END IF;
		
	    SP_VALUPDATE_DES(:OLD.NUMPRO, :NEW.NUMPRO, l_Valido OUT);
	    IF (l_Valido = TRUE) THEN
	      l_Alterou := TRUE;
	    END IF;
	    
	    IF (l_SimplificaoESocial = TRUE) THEN
	      SP_VALUPDATE_NUM(:OLD.MANCGC, :NEW.MANCGC, l_Valido OUT);
	      IF (l_Valido = TRUE) THEN
	        l_Alterou := TRUE;
	      END IF;
		
	      SP_VALUPDATE_DES(:OLD.MANREM, :NEW.MANREM, l_Valido OUT);
	      IF (l_Valido = TRUE) THEN
	        l_Alterou := TRUE;
	      END IF;
	    END IF;
		  
	    /* S2230 - fimAfastamento */
	    SP_VALUPDATE_DAT(:OLD.DATTER, :NEW.DATTER, l_Valido OUT);
	    IF (l_Valido = TRUE) THEN    
	      l_AlterouFim := TRUE;
	      IF (:NEW.DATTER = l_data_zero) THEN
	        l_ZerouDatTer := TRUE;
	      END IF;   
	    END IF;
		  
	    /* Uma Alteração para aposentadoria não deve gerar retificação de início */
	    IF ((l_MotEso = 6) AND ((l_MotEso_Ant = 1) OR (l_MotEso_Ant = 3))) THEN
	      l_Alterou := FALSE;
	    END IF;
		  
	    IF (l_Alterou = TRUE) THEN
		    /*Controle para verificar se alterou a data final do afastamento para valor maior que 15/60 dias da data atual */
		    /*Se houver alteração na data final para um valor maior que 15/60 dias, deve enviar uma pendência de exclusão  */
		    IF (l_AlterouFim = TRUE) THEN
		        l_difQtddiasAfa := 0;
		        l_excluir := FALSE;
			    /* verifica se a data de término anterior é maior que 16/60 dias */
			    /* se for, não precisa mandar nada  */
			    IF (:OLD.datter = l_data_zero) THEN
			        l_excluir := FALSE;
			    ELSE
			        SP_DATETOINT(:OLD.datter,l_qtdDiasDatTer OUT);
			        SP_DATETOINT(l_data_atual,l_qtdDiasDatAtu OUT);	    
			        l_difQtddiasAfa := l_qtdDiasDatTer - l_qtdDiasDatAtu;
			        IF (l_difQtddiasAfa <= 15) THEN
			            l_excluir := TRUE;
			        ELSE
			            l_excluir := FALSE;
				        IF (((l_tipsit = 2) OR (l_tipsit = 12) OR (l_tipsit = 21)) AND (l_difQtddiasAfa <= 60 )) THEN
				            l_excluir := TRUE;
				        END IF;	        
			        END IF;
			    END IF;
			    
			    IF (l_excluir = TRUE) THEN 
			        l_excluir := FALSE;
				    IF (:NEW.DatTer = l_data_zero) OR (:NEW.DatTer > l_data_atual) THEN
			            IF (:NEW.DatTer = l_data_zero) THEN
				            l_difQtddiasAfa := 999;
				        ELSE
			                 SP_DATETOINT(:NEW.DatTer,l_qtdDiasDatTer OUT);
			                 SP_DATETOINT(l_data_atual,l_qtdDiasDatAtu OUT);	 
			                 l_difQtddiasAfa := l_qtdDiasDatTer - l_qtdDiasDatAtu;      
				        END IF;
				        
				        /* Para férias, considerar 60 dias. Demais situações considerar 15 dias */
				        IF ((l_tipsit = 2) OR (l_tipsit = 12) OR (l_tipsit = 21)) THEN
				            IF (l_difQtddiasAfa > 60 ) THEN
				                l_excluir := TRUE;
				            END IF;
				        ELSE 
				           IF (l_difQtddiasAfa > 15 ) THEN
				               l_excluir := TRUE;
				           END IF;
				        END IF;
				    END IF;  
		  		    IF (l_excluir = TRUE) THEN	    		    
					    /* gera S-3000 para excluir os registros enviados anteriormente */
					    l_Valor := '';
					    SP_CONCATENAR_DAT('DATAFA', :NEW.DatAfa, l_Valor OUT);
					    SP_CONCATENAR_NUM('HORAFA', :NEW.HorAfa, l_Valor OUT);
					    SP_CONCATENAR_DES('LAYOUT', 'S-2230', l_Valor OUT);
					    SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
					    
					    SP_E_SOCIAL('S-3000', 'R038AFA', 'N', 'A', NULL, NULL, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_Valor, '', 0, NULL, :NEW.DatAfa, 0, 'R038AFA_EU');
		
				        /* Loop para gerar o valor R350PEN.DATHOR maior que o anterior para a próxima pendência */
				        SP_DATAHORA(l_R350PEN_Dathor_Ant OUT, 'DH');
				        LOOP
				           SP_DATAHORA(l_R350PEN_Dathor_POS OUT, 'DH'); 
				           IF (l_R350PEN_Dathor_Ant < l_R350PEN_Dathor_Pos) THEN
				              EXIT;
				           END IF;
					    END LOOP; /* end loop*/
				    END IF;
				END IF;
		    END IF;
			
			l_Valor := '';
	        SP_CONCATENAR_DAT('DATAFA', :NEW.DATAFA, l_Valor OUT);
	        SP_CONCATENAR_NUM('HORAFA', :NEW.HORAFA, l_Valor OUT);
	        SP_CONCATENAR_NUM('SECAFA', 1, l_Valor OUT); /* 1 - Início afastamento */
	        SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
	        SP_CONCATENAR_DES('MOTALT', :NEW.MOTALT,  l_Valor OUT);
	        SP_E_SOCIAL('S-2230', 'R038AFA', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATAFA, 0, 'R038AFA_EU');
	        
	        /*Se houve uma alteração de Situação no Histórico de Afastamento, sendo que a situação anterior não gerava informação para o eSocial e a nova situação passa a gerar e já tem uma data termino informada, deve serar uma pendencia */
	        IF((l_AlterouSitAfa = TRUE) AND (l_MotEso <> 0) AND (l_MotEso_Ant = 0) AND (l_AlterouFim = FALSE)) THEN
	        	l_Valor := '';
	        	SP_CONCATENAR_DAT('DATAFA', :NEW.DATAFA, l_Valor OUT);
	        	SP_CONCATENAR_NUM('HORAFA', :NEW.HORAFA, l_Valor OUT);
	        	SP_CONCATENAR_NUM('SECAFA', 3, l_Valor OUT); /* 3 - Fim afastamento */
	        	SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
	        	SP_CONCATENAR_DES('MOTALT', :NEW.MOTALT,  l_Valor OUT);
	            SP_E_SOCIAL('S-2230', 'R038AFA', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATAFA, 0, 'R038AFA_EU');
			END IF;
	        RH_DEF_ESOCIAL(:NEW.NUMEMP, l_DataInicioTabelas OUT, l_DataInicioEsocial OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
			
	        IF (l_AlterouSitAfa = TRUE) THEN
	          IF (l_DataInicioNaoPeriodicos > l_DataAdmissao) THEN
	            IF (:NEW.DATAFA <= l_DataInicioNaoPeriodicos AND (:NEW.DATTER = l_data_zero OR :NEW.DATTER >= l_DataInicioNaoPeriodicos)) THEN
	              SP_E_SOCIAL(l_layout, 'R038AFA', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, l_JsonCamposAlterados, 0, NULL, l_DataInicioNaoPeriodicos, 0, 'R038AFA_EU');
	            END IF;
	          END IF;
	        END IF;
		END IF;
	  END IF;
  END IF;
  /* FIM - eSocial */

  IF (l_BloAce = 'S' OR l_TipSit = 7) THEN
     SP_INTSTR(:OLD.TIPCOL,'99',l_tippesstr OUT);
     SP_INTSTR(:OLD.NUMEMP,'9999',l_numempstr OUT);
     SP_INTSTR(:OLD.TIPCOL,'9',l_tipcolstr OUT);
     SP_INTSTR(:OLD.NUMCAD,'999999999',l_numcadstr OUT);
     SP_DATSTR(:OLD.DATAFA,'DDMMYYYY',l_data OUT);
     SP_INTSTR(:OLD.HORAFA,'9999',l_hora OUT);
     SP_DATSTR(:NEW.DATTER,'DDMMYYYY',l_datter OUT);
     SP_INTSTR(:NEW.HORTER,'9999',l_horter OUT);
     l_chave:= l_tippesstr||l_numempstr||l_tipcolstr||l_numcadstr||l_data||l_hora||l_datter||l_horter;

     /*Se mudou o SITAFA busca a nova definicao, senao utiliza a já carregada*/
     IF :NEW.SITAFA IS NOT NULL AND :NEW.SITAFA <> :OLD.SITAFA THEN
       /* Busca o Tipo da Situação */
       SP_RETORNAR_TIPSIT(:NEW.SITAFA, l_TipSit OUT, l_BloAce OUT);
     END IF;

     SP_SAM_PENDENCIES(3,2,l_chave);
  END IF;

  /* CONTROLE DO LOG */
  BEGIN
    l_codcpa := 16;        /*l_codcpa representa a categoria e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java  */
	l_codtpa := 146;       /*l_codtpa representa a o tipo Alteração e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java*/
	  
	SP_EXISTE_LOG(l_codcpa, l_codtpa, 1, l_temAud OUT);
	
	IF ((:OLD.NumEmp <> :NEW.NumEmp)
		OR (:OLD.TipCol <> :NEW.TipCol)
		OR (:OLD.NumCad <> :NEW.NumCad)
		OR (:OLD.DatAfa <> :NEW.DatAfa)
		OR (:OLD.HorAfa <> :NEW.HorAfa)
		OR (:OLD.DatTer <> :NEW.DatTer)
		OR (:OLD.HorTer <> :NEW.HorTer)
		OR (:OLD.PrvTer <> :NEW.PrvTer)
		OR (:OLD.SitAfa <> :NEW.SitAfa)
		OR (:OLD.CauDem <> :NEW.CauDem)
        OR (:OLD.IndRem <> :NEW.IndRem)
		OR (:OLD.FimQua <> :NEW.FimQua)
		OR (:OLD.DiaJus <> :NEW.DiaJus)
		OR (:OLD.QhrAfa <> :NEW.QhrAfa)
		OR (:OLD.OriAfa <> :NEW.OriAfa)
		OR (:OLD.ExmRet <> :NEW.ExmRet)
		OR (:OLD.ConTov <> :NEW.ConTov)
		OR (:OLD.ObsAfa <> :NEW.ObsAfa)
		OR (:OLD.StaAtu <> :NEW.StaAtu)
		OR (:OLD.MotRai <> :NEW.MotRai)
		OR (:OLD.NroAut <> :NEW.NroAut)
		OR (:OLD.CodOem <> :NEW.CodOem)
		OR (:OLD.CodSub <> :NEW.CodSub)
		OR (:OLD.DatPer <> :NEW.DatPer)
		OR (:OLD.SitIni <> :NEW.SitIni)
		OR (:OLD.RisNex <> :NEW.RisNex)
		OR (:OLD.DatNex <> :NEW.DatNex)
		OR (:OLD.DiaPrv <> :NEW.DiaPrv)
		OR (:OLD.CodCua <> :NEW.CodCua)
		OR (:OLD.TmaCua <> :NEW.TmaCua)
		OR (:OLD.DatPar <> :NEW.DatPar)
		OR (:OLD.DiaBlq <> :NEW.DiaBlq)
		OR (:OLD.SeqReg <> :NEW.SeqReg)
		OR (:OLD.HrTRcs <> :NEW.HrTRcs)
		OR (:OLD.CodDoe <> :NEW.CodDoe)
		OR (:OLD.CodCid <> :NEW.CodCid)
		OR (:OLD.CodAte <> :NEW.CodAte)
		OR (:OLD.AciTra <> :NEW.AciTra)
		OR (:OLD.EfeRet <> :NEW.EfeRet)
		OR (:OLD.EncAfa <> :NEW.EncAfa)
		OR (:OLD.TipSuc <> :NEW.TipSuc)
		OR (:OLD.CgcSuc <> :NEW.CgcSuc)
		OR (:OLD.DatAlt <> :NEW.DatAlt)
		OR (:OLD.SitOri <> :NEW.SitOri)
		OR (:OLD.MotAlt <> :NEW.MotAlt)
		OR (:OLD.NomAte <> :NEW.NomAte)
		OR (:OLD.OrgCla <> :NEW.OrgCla)
		OR (:OLD.RegCon <> :NEW.RegCon)
		OR (:OLD.EstCon <> :NEW.EstCon)
		OR (:OLD.CgcCes <> :NEW.CgcCes)
		OR (:OLD.OnuCes <> :NEW.OnuCes)
		OR (:OLD.CgcSin <> :NEW.CgcSin)
		OR (:OLD.OnuSin <> :NEW.OnuSin)
		OR (:OLD.AciAnt <> :NEW.AciAnt)
		OR (:OLD.OriMot <> :NEW.OriMot)
		OR (:OLD.NumPro <> :NEW.NumPro)
		OR (:OLD.MsmMot <> :NEW.MsmMot)
		OR (:OLD.ManCgc <> :NEW.ManCgc)
		OR (:OLD.AtePat <> :NEW.AtePat) 
		OR (:OLD.ManRem <> :NEW.ManRem)) THEN
	BEGIN	  
	  IF (l_temAud = TRUE) THEN
	    SP_RET_REG_AUD(l_codrpa OUT);
		SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R038AFA_EU', 'FR038AFA');  
	    	  
		BEGIN
		  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
		  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
		  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
		  SP_DATSTR(:OLD.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
		  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAFA', l_datTemp);
		  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORAFA', CONVERT(NUMBER_TO_CHAR, :OLD.HORAFA));
		EXCEPTION
		  WHEN OTHERS THEN RAISERROR 103 'R038AFA_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
		END;
				 
		BEGIN
		  SP_DATSTR(:OLD.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATTER', l_datTemp);
		  SP_DATSTR(:NEW.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATTER', l_datTemp);		  
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORTER', CONVERT(NUMBER_TO_CHAR, :OLD.HORTER));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORTER', CONVERT(NUMBER_TO_CHAR, :NEW.HORTER));		 
		  SP_DATSTR(:OLD.PRVTER, 'DD/MM/YYYY', l_datTemp OUT);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRVTER', l_datTemp);
		  SP_DATSTR(:NEW.PRVTER, 'DD/MM/YYYY', l_datTemp OUT);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRVTER', l_datTemp);		  
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSITAFA', CONVERT(NUMBER_TO_CHAR, :OLD.SITAFA));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSITAFA', CONVERT(NUMBER_TO_CHAR, :NEW.SITAFA));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCAUDEM', CONVERT(NUMBER_TO_CHAR, :OLD.CAUDEM));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCAUDEM', CONVERT(NUMBER_TO_CHAR, :NEW.CAUDEM));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINDREM', CONVERT(NUMBER_TO_CHAR, :OLD.INDREM));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINDREM', CONVERT(NUMBER_TO_CHAR, :NEW.INDREM));
		  SP_DATSTR(:OLD.FIMQUA, 'DD/MM/YYYY', l_datTemp OUT);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFIMQUA', l_datTemp);
		  SP_DATSTR(:NEW.FIMQUA, 'DD/MM/YYYY', l_datTemp OUT);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFIMQUA', l_datTemp);		
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDIAJUS', CONVERT(NUMBER_TO_CHAR, :OLD.DIAJUS));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDIAJUS', CONVERT(NUMBER_TO_CHAR, :NEW.DIAJUS));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQHRAFA', CONVERT(NUMBER_TO_CHAR, :OLD.QHRAFA));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQHRAFA', CONVERT(NUMBER_TO_CHAR, :NEW.QHRAFA));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDORIAFA', CONVERT(NUMBER_TO_CHAR, :OLD.ORIAFA));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWORIAFA', CONVERT(NUMBER_TO_CHAR, :NEW.ORIAFA));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDEXMRET', :OLD.EXMRET);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWEXMRET', :NEW.EXMRET);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONTOV', :OLD.CONTOV);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONTOV', :NEW.CONTOV);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSAFA', :OLD.OBSAFA);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSAFA', :NEW.OBSAFA);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSTAATU', CONVERT(NUMBER_TO_CHAR, :OLD.STAATU));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSTAATU', CONVERT(NUMBER_TO_CHAR, :NEW.STAATU));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDMOTRAI', CONVERT(NUMBER_TO_CHAR, :OLD.MOTRAI));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWMOTRAI', CONVERT(NUMBER_TO_CHAR, :NEW.MOTRAI));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNROAUT', :OLD.NROAUT);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNROAUT', :NEW.NROAUT);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODOEM', CONVERT(NUMBER_TO_CHAR, :OLD.CODOEM));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODOEM', CONVERT(NUMBER_TO_CHAR, :NEW.CODOEM));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODSUB', :OLD.CODSUB);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODSUB', :NEW.CODSUB);		  
		  SP_DATSTR(:OLD.DATPER, 'DD/MM/YYYY', l_datTemp OUT);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATPER', l_datTemp);
		  SP_DATSTR(:NEW.DATPER, 'DD/MM/YYYY', l_datTemp OUT);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATPER', l_datTemp);		  
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSITINI', CONVERT(NUMBER_TO_CHAR, :OLD.SITINI));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSITINI', CONVERT(NUMBER_TO_CHAR, :NEW.SITINI));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDRISNEX', :OLD.RISNEX);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWRISNEX', :NEW.RISNEX);		  
		  SP_DATSTR(:OLD.DATNEX, 'DD/MM/YYYY', l_datTemp OUT);
