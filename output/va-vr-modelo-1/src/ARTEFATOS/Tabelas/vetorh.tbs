kPROCEDURE ClearRecentAccess (P_MODID IN NUMBER, P_CODUSU IN NUMBER, P_ITKIND IN NUMBER) IS
BEGIN
	NULL;
END	ORACLE;0
‹␀␀CREATE OR REPLACE PROCEDURE ClearRecentAccess(P_MODID IN NUMBER,P_CODUSU IN NUMBER,P_ITKIND IN NUMBER) AS
BEGIN
	DELETE FROM R975RAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITKIND = P_ITKIND AND ITEMID NOT IN 
	(
		SELECT ITEMID FROM 
		(
			SELECT ITEMID FROM R975RAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITKIND = P_ITKIND ORDER BY DATACC DESC
		) WHERE ROWNUM <= 30
	);
END;	MSSQL;0
l␀␀CREATE PROCEDURE ClearRecentAccess(@P_MODID NUMERIC, @P_CODUSU NUMERIC, @P_ITKIND NUMERIC) AS
BEGIN
    SET NOCOUNT ON
	DELETE FROM R975RAC WHERE MODID = @P_MODID AND CODUSU = @P_CODUSU AND ITKIND = @P_ITKIND AND ITEMID NOT IN 
	(
		SELECT TOP 30 ITEMID FROM R975RAC WHERE MODID = @P_MODID AND CODUSU = @P_CODUSU AND ITKIND = @P_ITKIND ORDER BY DATACC DESC
	);
END	POSTGRESQL;0
„␀␀CREATE OR REPLACE PROCEDURE ClearRecentAccess(P_MODID NUMERIC, P_CODUSU NUMERIC, P_ITKIND NUMERIC)
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN
  DELETE FROM R975RAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITKIND = P_ITKIND AND ITEMID NOT IN 
  (
    SELECT ITEMID FROM R975RAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITKIND = P_ITKIND ORDER BY DATACC DESC LIMIT 30
  );
END
$BODY$;␀iÿÿÿÿÿÿÿÿ	SENIOR;0
PROCEDURE ExecSql(P_SQLTEXTO VARCHAR2(255))
 IS

L_SOUCUR INTEGER;
  l_ignore        INTEGER;
BEGIN
  L_SOUCUR := 0;
END		ORACLE;20
q␀␀CREATE OR REPLACE
PROCEDURE ExecSql(
    P_SQLTEXTO VARCHAR2)
IS
  L_SOUCUR INTEGER;
  l_ignore INTEGER;
BEGIN
  L_SOUCUR := DBMS_SQL.OPEN_CURSOR();
  BEGIN
    DBMS_SQL.PARSE(L_SOUCUR,p_sqltexto,DBMS_SQL.V7);
    l_ignore := DBMS_SQL.EXECUTE(L_SOUCUR);
    DBMS_SQL.CLOSE_CURSOR(L_SOUCUR);
  EXCEPTION
  WHEN TOO_MANY_ROWS THEN
    DBMS_SQL.CLOSE_CURSOR(L_SOUCUR);
    RAISE TOO_MANY_ROWS;
  WHEN NO_DATA_FOUND THEN
    DBMS_SQL.CLOSE_CURSOR(L_SOUCUR);
    RAISE NO_DATA_FOUND;
  WHEN OTHERS THEN
    DBMS_SQL.CLOSE_CURSOR(L_SOUCUR);
    raise_application_error(-20000 + -(103),SQLERRM());
  END;
END;␀}`ÿÿÿÿÿÿÿÿ	SENIOR;0

␀␀PROCEDURE EXECSQL1(P_SQLTEX VARCHAR2(255),P_GRUPO OUT CHAR,P_CODIG OUT CHAR,P_SUBNV OUT CHAR,P_FAIDOM OUT CHAR,P_FAISEG OUT CHAR,P_FAITER OUT CHAR,P_FAIQUA OUT CHAR,P_FAIQUI OUT CHAR,P_FAISEX OUT CHAR,P_FAISAB OUT CHAR,P_FAIREF OUT CHAR,P_DESMSG OUT CHAR,P_DATMSG OUT CHAR,P_QTDMSG OUT CHAR,P_CREFX1 OUT CHAR,P_FX1 OUT CHAR,P_CREFX2 OUT CHAR,P_FX2 OUT CHAR,P_CREFX3 OUT CHAR,P_FX3 OUT CHAR,P_CREFX4 OUT CHAR,P_FX4 OUT CHAR,P_NUMCRA OUT CHAR,P_SEQUENCIA OUT NUMBER)
 IS

  L_SOUCUR INTEGER;
BEGIN
  L_SOUCUR := 0;
END		ORACLE;20
0"␀␀CREATE OR REPLACE PROCEDURE EXECSQL1
( p_sqltex        IN VARCHAR2,
  p_grupo         OUT VARCHAR2,
  p_codig         OUT VARCHAR2,
  p_subnv         OUT VARCHAR2,
  p_fx_flg        OUT VARCHAR2,
  p_tempo_alm     OUT VARCHAR2,
  p_desmsg        OUT VARCHAR2,
  p_datmsg        OUT VARCHAR2,
  p_qtdmsg        OUT VARCHAR2, 
  p_crefx1        OUT VARCHAR2,
  p_fx1           OUT VARCHAR2,
  p_crefx2        OUT VARCHAR2,
  p_fx2           OUT VARCHAR2,
  p_crefx3        OUT VARCHAR2,
  p_fx3           OUT VARCHAR2,
  p_crefx4        OUT VARCHAR2,
  p_fx4           OUT VARCHAR2,
  p_crefx5        OUT VARCHAR2,
  p_fx5           OUT VARCHAR2,
  p_crefx6        OUT VARCHAR2,
  p_fx6           OUT VARCHAR2,
  p_ultpas_ref    OUT VARCHAR2,
  p_grupo1        OUT VARCHAR2,
  p_inigr1        OUT VARCHAR2,
  p_fimgr1        OUT VARCHAR2,
  p_grupo2        OUT VARCHAR2,
  p_inigr2        OUT VARCHAR2,
  p_fimgr2        OUT VARCHAR2,
  p_grupo3        OUT VARCHAR2,
  p_inigr3        OUT VARCHAR2,
  p_fimgr3        OUT VARCHAR2,
  p_grupo_sab     OUT VARCHAR2,
  p_grupo_dom     OUT VARCHAR2,
  p_grupo_fer     OUT VARCHAR2,
  p_anti_dupla    OUT VARCHAR2,
  p_bloq_falta    OUT VARCHAR2,
  p_ver_hora      OUT VARCHAR2,
  p_ver_local     OUT VARCHAR2,
  p_ver_valid     OUT VARCHAR2,
  p_ver_afast     OUT VARCHAR2,
  p_ver_cred      OUT VARCHAR2,
  p_sequencia     OUT NUMBER
) IS
  L_SOUCUR INTEGER;
  l_ret           INTEGER;
  l_grupo         CHAR(3);
  l_codig         CHAR(6);
  l_subnv         CHAR(5);
  l_fx_flg        CHAR(1);
  l_tempo_alm     CHAR(3);
  l_desmsg        CHAR(32);
  l_datmsg        CHAR(6);
  l_qtdmsg        CHAR(2);
  l_crefx1        CHAR(2);
  l_fx1           CHAR(8);
  l_crefx2        CHAR(2);
  l_fx2           CHAR(8);
  l_crefx3        CHAR(2);
  l_fx3           CHAR(8);
  l_crefx4        CHAR(2);
  l_fx4           CHAR(8);
  l_crefx5        CHAR(2);
  l_fx5           CHAR(8);
  l_crefx6        CHAR(2);
  l_fx6           CHAR(8);
  l_ultpas_ref    CHAR(10);
  l_grupo1        CHAR(3);
  l_inigr1        CHAR(10);
  l_fimgr1        CHAR(10);
  l_grupo2        CHAR(3);
  l_inigr2        CHAR(10);
  l_fimgr2        CHAR(10);
  l_grupo3        CHAR(3);
  l_inigr3        CHAR(10);
  l_fimgr3        CHAR(10);
  l_grupo_sab     CHAR(3);
  l_grupo_dom     CHAR(3);
  l_grupo_fer     CHAR(3);
  l_anti_dupla    CHAR(1);
  l_bloq_falta    CHAR(1);
  l_ver_hora      CHAR(1);
  l_ver_local     CHAR(1);
  l_ver_valid     CHAR(1);
  l_ver_afast     CHAR(1);
  l_ver_cred      CHAR(1);
  l_sequencia     NUMBER;
BEGIN
  L_SOUCUR := dbms_sql.open_cursor;
  BEGIN
    DBMS_SQL.PARSE(L_SOUCUR,p_sqltex,DBMS_SQL.V7);
    /* define colunas do select */
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR, 1, l_grupo,3);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR, 2, l_codig,6);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR, 3, l_subnv,5);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR, 4, l_fx_flg,1);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR, 5, l_tempo_alm,3);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR, 6, l_desmsg,32);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR, 7, l_datmsg,6);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR, 8, l_qtdmsg,2);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR, 9, l_crefx1,2);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,10, l_fx1,8);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,11, l_crefx2,2);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,12, l_fx2,8);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,13, l_crefx3,2);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,14, l_fx3,8);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,15, l_crefx4,2);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,16, l_fx4,8);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,17, l_crefx5,2);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,18, l_fx5,8);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,19, l_crefx6,2);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,20, l_fx6,8);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,21, l_ultpas_ref,10);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,22, l_grupo1,3);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,23, l_inigr1,10);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,24, l_fimgr1,10);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,25, l_grupo2,3);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,26, l_inigr2,10);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,27, l_fimgr2,10);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,28, l_grupo3,3);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,29, l_inigr3,10);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,30, l_fimgr3,10);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,31, l_grupo_sab ,3);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,32, l_grupo_dom ,3);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,33, l_grupo_fer ,3);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,34, l_anti_dupla,1);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,35, l_bloq_falta,1);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,36, l_ver_hora  ,1);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,37, l_ver_local ,1);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,38, l_ver_valid ,1);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,39, l_ver_afast ,1);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,40, l_ver_cred ,1);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR,41, l_sequencia);
    l_ret:=DBMS_SQL.Execute_And_Fetch(L_SOUCUR,True);
    /* pega o valor das colunas */
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR, 1, l_grupo);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR, 2, l_codig);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR, 3, l_subnv);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR, 4, l_fx_flg);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR, 5, l_tempo_alm);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR, 6, l_desmsg);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR, 7, l_datmsg);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR, 8, l_qtdmsg);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR, 9, l_crefx1);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,10, l_fx1);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,11, l_crefx2);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,12, l_fx2);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,13, l_crefx3);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,14, l_fx3);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,15, l_crefx4);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,16, l_fx4);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,17, l_crefx5);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,18, l_fx5);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,19, l_crefx6);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,20, l_fx6);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,21, l_ultpas_ref);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,22, l_grupo1);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,23, l_inigr1);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,24, l_fimgr1);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,25, l_grupo2);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,26, l_inigr2);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,27, l_fimgr2);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,28, l_grupo3);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,29, l_inigr3);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,30, l_fimgr3);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,31, l_grupo_sab);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,32, l_grupo_dom);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,33, l_grupo_fer);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,34, l_anti_dupla);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,35, l_bloq_falta);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,36, l_ver_hora);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,37, l_ver_local);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,38, l_ver_valid);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,39, l_ver_afast);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,40, l_ver_cred);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR,41, l_sequencia);
    DBMS_SQL.CLOSE_CURSOR(L_SOUCUR);
    p_grupo:=l_grupo;
    p_codig:=l_codig;
    p_subnv:=l_subnv;
    p_fx_flg:=l_fx_flg;
    p_tempo_alm:=l_tempo_alm;
    p_desmsg:=l_desmsg;
    p_qtdmsg:=l_qtdmsg;
    p_datmsg:=l_datmsg;
    p_crefx1:=l_crefx1;
    p_fx1:=l_fx1;
    p_crefx2:=l_crefx2;
    p_fx2:=l_fx2;
    p_crefx3:=l_crefx3;
    p_fx3:=l_fx3;
    p_crefx4:=l_crefx4;
    p_fx4:=l_fx4;
    p_crefx5:=l_crefx5;
    p_fx5:=l_fx5;
    p_crefx6:=l_crefx6;
    p_fx6:=l_fx6;
    p_ultpas_ref:=l_ultpas_ref;
    p_grupo1:=l_grupo1;
    p_inigr1:=l_inigr1;
    p_fimgr1:=l_fimgr1;
    p_grupo2:=l_grupo2;
    p_inigr2:=l_inigr2;
    p_fimgr2:=l_fimgr2;
    p_grupo3:=l_grupo3;
    p_inigr3:=l_inigr3;
    p_fimgr3:=l_fimgr3;
    p_grupo_sab:=l_grupo_sab;
    p_grupo_dom:=l_grupo_dom;
    p_grupo_fer:=l_grupo_fer;
    p_anti_dupla:=l_anti_dupla;
    p_bloq_falta:=l_bloq_falta;
    p_ver_hora:=l_ver_hora;
    p_ver_local:=l_ver_local;
    p_ver_valid:=l_ver_valid;
    p_ver_afast:=l_ver_afast;
    p_ver_cred:=l_ver_cred;
    p_sequencia:=l_sequencia;
  EXCEPTION
     WHEN TOO_MANY_ROWS THEN
      /* fecha o cursor */
       DBMS_SQL.CLOSE_CURSOR(L_SOUCUR);
       RAISE TOO_MANY_ROWS;
     WHEN NO_DATA_FOUND THEN
      /* fecha o cursor */
       DBMS_SQL.CLOSE_CURSOR(L_SOUCUR);
       RAISE NO_DATA_FOUND;
     WHEN OTHERS THEN
      /* fecha o cursor */
       DBMS_SQL.CLOSE_CURSOR(L_SOUCUR);
       raise_application_error(-20103,SQLERRM);
  END;
END;



