                         l_r073ata.DATFIM,
                         l_r073ata.horseg,
                         l_r073ata.horter,
                         l_r073ata.horqua,
                         l_r073ata.horqui,
                         l_r073ata.horsex,
                         l_r073ata.horsab,
                         l_r073ata.hordom
  LOOP
      FOREACH c_r004fhr INTO l_r004fhr.codhor,
                             l_r004fhr.iniace,
                             l_r004fhr.fimace,
                             l_r004fhr.inipto,
                             l_r004fhr.fimpto
      LOOP
