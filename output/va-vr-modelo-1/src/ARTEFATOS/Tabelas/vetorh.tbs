BEGIN
/* Utilizada tabela _AUX para controle, pois os UPDATES abaixo disparam triggers */
    /*   que fazem SELECT para o mesmo registro da tabela R074BAI e isso gera erro.  */
    /*   A _AUX irá servir como flag de controle, indicando que o update foi chamado */
    /*   via trigger r074bai e sendo assim, não é precisa executar as rotinas das    */
    /*   demais triggers.                                                            */
    BEGIN
      INSERT INTO R074BAI_AUX (CODCID, CODBAI)
                       VALUES (:NEW.CODCID, :NEW.CODBAI);
    EXCEPTION 
	  WHEN OTHERS THEN
        RAISERROR 103 'Erro ao inserir na R074BAI_AUX';
    END;
	
	/* Executa update para atualizar o nome do bairro alterado no cadastro do candidato */
    BEGIN
      UPDATE R122CEX
         SET NOMBAI = :NEW.NOMBAI
       WHERE CODCID = :NEW.CODCID
	     AND CODBAI = :NEW.CODBAI;
    EXCEPTION 
	  WHEN OTHERS THEN
        RAISERROR 103 'ERRO AO ATUALIZAR A TABELA R122CEX';
    END;
	
	/* Exclui o registro da tabela auxiliar utilizado como flag na trigger R122CEX_EU */
    BEGIN
      DELETE FROM R074BAI_AUX;
    EXCEPTION 
	  WHEN OTHERS THEN
        RAISERROR 103 'Erro ao excluir R074BAI_AUX';
    END;
END␀␀␀Œ␀␀␀␀␀Û␀␀A,Á␀	Ôÿ?␀␀␀␀␀e<o*o*/°†␀Æÿ␀␀Û␀␀␀,´␀	Ôÿ?␀␀␀␀␀Ö?~~r­†␀Æÿ␀␀ÿ␀␀␀␀0;1␀␀␀␀␀Û␀␀A,Á␀	Ôÿ?␀␀␀␀␀e<o*o*/°†␀Æÿ␀␀Û␀␀␀Z§␀␀EÔÿ?␀␀␀␀␀›¨␀␀ç§␀␀ç§␀␀G³†␀␀ÿ␀␀ÿ␀fåÔÿ1␀␀␀␀␀gfNfNfh␀²†␀␀ÿ␀␀ÿ␀'-´␀Ôÿ1␀␀␀␀␀AÉ»␀␀É»␀␀r␀Æÿ␀␀Û␀␀␀},TÔÿ1␀␀␀␀␀nfLfLfp␀␀␀ÿ␀␀Û␀␀␀-
