  l_cracha       NUMBER(12);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_faidom_a     CHAR(56);
  l_faiseg_a     CHAR(56);
  l_faiter_a     CHAR(56);
  l_faiqua_a     CHAR(56);
  l_faiqui_a     CHAR(56);
  l_faisex_a     CHAR(56);
  l_faisab_a     CHAR(56);
  l_faidom_p     CHAR(56);
  l_faiseg_p     CHAR(56);
  l_faiter_p     CHAR(56);
  l_faiqua_p     CHAR(56);
  l_faiqui_p     CHAR(56);
  l_faisex_p     CHAR(56);
  l_faisab_p     CHAR(56);
  l_fairef       CHAR(56);
  l_contpm       NUMBER(1);
BEGIN
  NULL;
END		SENIOR;24OSP_RETCRA
