DECLARE
l_CamOri      VARCHAR2(50);
 l_NumEmp      NUMBER;
 l_TipCol      NUMBER;
 l_NumCad      NUMBER;
 l_DatSol      DATE;
 l_Codsol      NUMBER;
BEGIN
     l_CamOri := IFNULL(:NEW.ABRTUR,' ');
     l_NumEmp := :NEW.NUMEMP;
     l_TipCol := :NEW.TIPCOL;
     l_NumCad := :NEW.NUMCAD;
     l_DatSol := :NEW.DATSOL;
     l_CodSol := :NEW.CODSOL;
     BEGIN
          RS_ABTUR124CSL(l_NumEmp, l_TipCol, l_NumCad, l_DatSol, l_CodSol, l_CamOri);
     EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro na Inclusão do Colaborador/1-Abrangência Turno';
     END;

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
END␀®à␀␀		SENIOR;0 ␀␀

TRIGGER R124CSL_EU AFTER UPDATE ON R124CSL FOR EACH ROW

DECLARE
l_CamOri      VARCHAR2(50);
 l_NumEmp      NUMBER;
 l_TipCol      NUMBER;
 l_NumCad      NUMBER;
 l_DatSol      DATE;
 l_Codsol      NUMBER;
BEGIN
     IF   (IFNULL(:NEW.ABRTUR,' ') <> IFNULL(:OLD.ABRTUR,' ')) THEN
          BEGIN
               DELETE FROM R124HTR WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD
                                     AND DATSOL = :OLD.DATSOL AND CODSOL = :OLD.CODSOL;
          EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro na exclusão da tabela de abrangência de Turno.';
          END;
     END IF;

     IF   (IFNULL(:NEW.ABRTUR,' ') <> IFNULL(:OLD.ABRTUR,' ')) THEN
          l_CamOri := IFNULL(:NEW.ABRTUR,' ');
          l_NumEmp := :NEW.NUMEMP;
          l_TipCol := :NEW.TIPCOL;
          l_NumCad := :NEW.NUMCAD;
          l_DatSol := :NEW.DATSOL;
          l_CodSol := :NEW.CODSOL;
          BEGIN
               RS_ABTUR124CSL(l_NumEmp, l_TipCol, l_NumCad, l_DatSol, l_CodSol, l_CamOri);
          EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro na Inclusão do Colaborador/1-Abrangência Turno';
          END;
     END IF;
  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
END␀¬à␀␀		SENIOR;0ÿ␀␀

