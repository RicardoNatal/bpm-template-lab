DECLARE
  l_Valor VARCHAR2(2000); 
  l_VersaoESocial NUMBER;
  l_DatRef DATE;
  l_isGerarPendencia BOOLEAN;
BEGIN 
  l_Valor := '';
  l_VersaoESocial := 0;  
  
  SP_GERAR_PEN_S2500(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODPRO, l_isGerarPendencia OUT);
  
  IF (l_isGerarPendencia = TRUE) THEN
    SP_RETDATREF_S2500(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, :NEW.CodPro, l_DatRef OUT);
    SP_ESOCIAL_S250X(:NEW.NumEmp, l_DatRef, l_VersaoESocial OUT);
    
    IF (l_VersaoESocial >= 6) THEN
      SP_CONCATENAR_NUM('CODPRO', :NEW.CODPRO, l_Valor OUT);
    
      SP_E_SOCIAL('S-2500', 'R346ABO', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, NULL, 0, 'R346ABO_EI');
    END IF;
  END IF;
END␀,æ␀␀		SENIOR;0æ␀␀

TRIGGER R346ABO_EU BEFORE UPDATE ON R346ABO FOR EACH ROW
DECLARE
  l_Valor VARCHAR2(2000);
  l_Alterou BOOLEAN;
  l_Valido BOOLEAN;
  l_JsonCamposAlterados VARCHAR2(2000);
  l_VersaoESocial NUMBER;
  l_DatRef DATE;
  l_isGerarPendencia BOOLEAN;
BEGIN 
  l_Valor := '';
  l_VersaoESocial := 0;
  l_JsonCamposAlterados := '';
  
  SP_GERAR_PEN_S2500(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODPRO, l_isGerarPendencia OUT);
  
  IF (l_isGerarPendencia = TRUE) THEN
    SP_RETDATREF_S2500(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, :NEW.CodPro, l_DatRef OUT);
    SP_ESOCIAL_S250X(:NEW.NumEmp, l_DatRef, l_VersaoESocial OUT);
    
    IF (l_VersaoESocial >= 6) THEN
    
    	SP_VALUPDATE_NUM(:OLD.ANOBAS, :NEW.ANOBAS, l_Valido OUT);
    	IF (l_Valido = TRUE) THEN
        l_Alterou := TRUE;
        SP_CONCAT_NUM_JSON('ANOBAS', :NEW.ANOBAS, :OLD.ANOBAS, l_JsonCamposAlterados OUT);
      END IF;
    
      IF (l_Alterou = TRUE) THEN
        SP_CONCATENAR_NUM('CODPRO', :NEW.CODPRO, l_Valor OUT);
      
        SP_E_SOCIAL('S-2500', 'R346ABO', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, l_JsonCamposAlterados, 0, NULL, NULL, 0, 'R346ABO_EU');
      END IF;
      
    END IF;
  END IF;
END␀*æ␀␀		SENIOR;00␀␀

