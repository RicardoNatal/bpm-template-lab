TRIGGER R058SVR_ED AFTER DELETE ON R058SVR FOR EACH ROW

DECLARE
l_online       BOOLEAN;

BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       BEGIN
         DELETE FROM R058POS WHERE R058POS.CODSVR = :OLD.CODSVR;
       EXCEPTION WHEN OTHERS THEN
         RAISERROR 103 'Erro na Exclusão da Posição Última Marcação Coletada.';
       END;
  END IF;
END␀␀␀Z␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0Ø␀␀m,Ì␀	␀␀␀␀␀␀N@ğ]N@{␀Æÿ␀␀…×␀␀␀kTc␀␀␀␀␀␀ÜX°V°V`␀␀ÿ␀␀ÿ␀˜␀␀␀␀␀␀␀␀␀␀␀n␀Æÿ␀␀ÿ␀;,­␀␀␀␀␀␀␀ú(ô(ø(p␀Æÿ␀␀t×␀␀␀Jd=␀␀␀␀␀␀*À␀␀…dˆdc␀␀␀ÿ␀␀ÿN0Æ␀␀=␀␀␀␀␀␀2‹Ç␀␀øÇ␀␀c␀␀␀ÿ␀␀ÿNOÆ␀␀=␀␀␀␀␀␀2Ç␀␀úÇ␀␀c␀␀␀ÿ␀␀ÿNCÆ␀␀=␀␀␀␀␀␀2Ç␀␀ùÇ␀␀c␀␀␀ÿ␀␀ÿN‘␀␀–␀␀␀␀␀␀␀llln␀Æÿ␀␀ÿ␀4o–␀␀␀␀␀␀␀llln␀Æÿ␀␀ÿ␀Ú␀␀–␀␀␀␀␀␀␀llln␀Æÿ␀␀ÿ␀ÿn–␀␀␀␀␀␀␀llln␀Æÿ␀␀ÿ␀
