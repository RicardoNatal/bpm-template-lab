TRIGGER R008LIM_EI AFTER INSERT ON R008LIM FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Limites do Evento (Tabela: R008LIM)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 103;     /* Limites do Evento (Tabela: R008LIM)*/
  l_codtpa := 351;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008LIM_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAB', CONVERT(NUMBER_TO_CHAR, :NEW.CODTAB));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CODEVE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', CONVERT(NUMBER_TO_CHAR, :NEW.SEQREG));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R008LIM_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONSIT', CONVERT(NUMBER_TO_CHAR, :NEW.CONSIT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIMMIN', :NEW.DIMMIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LIMMIN', CONVERT(NUMBER_TO_CHAR, :NEW.LIMMIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LIMMAX', CONVERT(NUMBER_TO_CHAR, :NEW.LIMMAX));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ABRFIL', :NEW.ABRFIL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCAR', CONVERT(NUMBER_TO_CHAR, :NEW.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ABRCAR', :NEW.ABRCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ABRESC', :NEW.ABRESC);
      END;
  END IF; 
END␀$Ï␀␀		SENIOR;0␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R008LIM_EU AFTER UPDATE ON R008LIM FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Limites do Evento (Tabela: R008LIM)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 103;     /* Limites do Evento (Tabela: R008LIM)*/
  l_codtpa := 352;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.CodTab <> :NEW.CodTab)
   OR (:OLD.CodEve <> :NEW.CodEve)
   OR (:OLD.SeqReg <> :NEW.SeqReg)
   OR (:OLD.ConSit <> :NEW.ConSit)
   OR (:OLD.DimMin <> :NEW.DimMin)
   OR (:OLD.LimMin <> :NEW.LimMin)
   OR (:OLD.LimMax <> :NEW.LimMax)
   OR (:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.AbrFil <> :NEW.AbrFil)
   OR (:OLD.EstCar <> :NEW.EstCar)
   OR (:OLD.AbrCar <> :NEW.AbrCar)
   OR (:OLD.AbrEsc <> :NEW.AbrEsc)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008LIM_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAB', CONVERT(NUMBER_TO_CHAR, :OLD.CODTAB));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :OLD.CODEVE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', CONVERT(NUMBER_TO_CHAR, :OLD.SEQREG));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R008LIM_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONSIT', CONVERT(NUMBER_TO_CHAR, :OLD.CONSIT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONSIT', CONVERT(NUMBER_TO_CHAR, :NEW.CONSIT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDIMMIN', :OLD.DIMMIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDIMMIN', :NEW.DIMMIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDLIMMIN', CONVERT(NUMBER_TO_CHAR, :OLD.LIMMIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWLIMMIN', CONVERT(NUMBER_TO_CHAR, :NEW.LIMMIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDLIMMAX', CONVERT(NUMBER_TO_CHAR, :OLD.LIMMAX));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWLIMMAX', CONVERT(NUMBER_TO_CHAR, :NEW.LIMMAX));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDABRFIL', :OLD.ABRFIL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWABRFIL', :NEW.ABRFIL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDESTCAR', CONVERT(NUMBER_TO_CHAR, :OLD.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWESTCAR', CONVERT(NUMBER_TO_CHAR, :NEW.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDABRCAR', :OLD.ABRCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWABRCAR', :NEW.ABRCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDABRESC', :OLD.ABRESC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWABRESC', :NEW.ABRESC);
      END;
    END IF; 
  END IF; 
END␀"Ï␀␀		SENIOR;0“	␀␀ 

