TRIGGER R006CES_EI AFTER INSERT ON R006CES FOR EACH ROW

DECLARE
  l_DataEsc_new DATE;
BEGIN   
  /*e-Social*/
  
  l_DataEsc_new := DATETIME(01, MONTH(:NEW.DATESC), YEAR(:NEW.DATESC), 0, 0, 0);
  SP_ESOCIAL_ESCALA(:NEW.CODESC, l_DataEsc_new, 'R006CES', 'I');
  /*e-Social*/
END␀ºÎ␀␀	SENIOR;0L

TRIGGER R006CES_SU AFTER UPDATE ON R006CES

BEGIN
RH_250ALT(33);
END␀·Î␀␀		SENIOR;0=␀␀

TRIGGER R006CES_EU AFTER UPDATE ON R006CES FOR EACH ROW

DECLARE
  l_Valido BOOLEAN;
BEGIN   
  /*e-Social*/
  
  SP_VALUPDATE_NUM(:OLD.CODHOR, :NEW.CODHOR, l_Valido OUT);
  IF (l_Valido = TRUE) THEN	
    SP_ESOCIAL_ESCALA(:NEW.CODESC, :NEW.DATESC, 'R006CES', 'A');
  END IF;   
  
  /*e-Social*/
END␀¸Î␀␀	SENIOR;0L

