DECLARE
  l_Valor VARCHAR2(2000);

  l_DataAlteracao   DATE;
  l_DataInicioTabelas DATE;
  l_DataInicioEsocial DATE;
  l_DataInicioNaoPeriodicos DATE;
  l_DataInicioPeriodicos DATE;
  l_DataInicioSST DATE;
  l_DataInicioMigracao DATE;
BEGIN
  IF ((:NEW.ADMFEC = 'S')  AND (:NEW.STAMIG <> 1 AND :NEW.STAMIG <> 2) AND (:NEW.LAYOUT IS NOT NULL AND LTRIM(RTRIM(:NEW.LAYOUT)) || 'VAZIO' <> 'VAZIO')) THEN
    l_Valor := '';
    IF (:NEW.LAYOUT = 'IMPORT') OR (:NEW.LAYOUT = 'S-2298') THEN
      IF (:NEW.LAYOUT = 'IMPORT') THEN
        RH_RET_MIN_DATHFI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DataAlteracao OUT);
      ELSE	     
        BEGIN
          SELECT DATRET INTO l_DataAlteracao
            FROM R034REI
           WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN 
             NO_DATA_FOUND THEN RAISERROR 103 'Erro R034MAT_EI. Erro no select R034REI.';               
        END;
    	/* Na reintegração, datadm pode estar antes do início do envio das tabelas do eSocial. */
    	RH_DEF_ESOCIAL(:NEW.NUMEMP, l_DataInicioTabelas OUT, l_DataInicioEsocial OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);	     
        IF (l_DataAlteracao < l_DataInicioNaoPeriodicos) THEN
          l_DataAlteracao := l_DataInicioNaoPeriodicos;
        END IF;
	  END IF;

      l_Valor := '';	  

	  IF ((:NEW.LayOri = 'S-2200') OR (:NEW.LayOri = 'S-2298')) THEN
        SP_CONCATENAR_DES('LAYOUT', 'S-2206', l_Valor OUT);
        SP_E_SOCIAL('S-2206', 'R034MAT', 'N', 'I', l_DataAlteracao, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, l_DataAlteracao, 0, 'R034MAT_EI');

        l_Valor := '';	  
        SP_CONCATENAR_DES('LAYOUT', 'S-2205', l_Valor OUT);
        SP_E_SOCIAL('S-2205', 'R034MAT', 'N', 'I', l_DataAlteracao, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, l_DataAlteracao, 0, 'R034MAT_EI');
	  END IF;
	  
	  IF (:NEW.LayOri = 'S-2300') THEN
      	l_Valor := '';
        SP_CONCATENAR_DES('LAYOUT', 'S-2306', l_Valor OUT);
        SP_E_SOCIAL('S-2306', 'R034MAT', 'N', 'I', l_DataAlteracao, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, l_DataAlteracao, 0, 'R034MAT_EI');
      END IF;	  
      
	  IF (:NEW.LayOri = 'S-2400') THEN     	          
      	l_Valor := '';
        SP_CONCATENAR_DES('LAYOUT', 'S-2405', l_Valor OUT);
        SP_E_SOCIAL('S-2405', 'R034MAT', 'N', 'I', l_DataAlteracao, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, l_DataAlteracao, 0, 'R034MAT_EI');	  
	  END IF;
	END IF;	
	  
    IF (:NEW.LAYOUT <> 'IMPORT') THEN
      l_Valor := '';
      SP_CONCATENAR_DES('LAYOUT', :NEW.LAYOUT, l_Valor OUT);
      SP_E_SOCIAL(:NEW.LAYOUT, 'R034MAT', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, NULL, 0, 'R034MAT_EI');
    END IF;	  
  END IF;
END␀ Ó␀␀		SENIOR;0h␀␀

TRIGGER R034MAT_EU AFTER UPDATE ON R034MAT FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);
  l_TemModuloAP VARCHAR2(1);

  l_Alterou BOOLEAN;
  l_Valido  BOOLEAN;

  l_Qtd NUMBER;
  
  l_DataAlteracao   DATE;
  l_DataInicioTabelas DATE;
  l_DataInicioEsocial DATE;
  l_DataInicioNaoPeriodicos DATE;
  l_DataInicioPeriodicos DATE;
  l_DataInicioSST DATE;
  l_DataInicioMigracao DATE;
BEGIN
  RH_VER_MODULO_PRP(9, l_TemModuloAP OUT);
  
  /* Se não estiver integrado com o módulo AP e já tiver algum envio enviado com sucesso, não permite alterar matrícula do eSocial */
  IF (l_TemModuloAP = 'N') THEN
    IF (:NEW.MatEso <> :OLD.MatEso) THEN
      BEGIN
        SELECT COUNT(1) INTO l_Qtd FROM R350STA
         WHERE NUMEMP = :NEW.NumEmp
           AND TIPCOL = :NEW.TipCol
           AND NUMCAD = :NEW.NumCad
           AND STASIT IN (4,5,6,7,8,9,11,12);
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'Erro no SELECT da tabela R350STA.';
      END;
    
      IF (l_Qtd > 0) THEN
        RAISERROR 103 'Não é possível alterar matrícula eSocial do colaborador, pois já teve algum evento enviado para o mesmo.';
      END IF;
    END IF;
  END IF;

  /* Gera pendências para os leiautes já "gerados", para retificar com a nova matrícula */
  IF ((:NEW.ADMFEC = 'S')  AND (:NEW.STAMIG <> 1 AND :NEW.STAMIG <> 2) AND (:NEW.LAYOUT IS NOT NULL AND LTRIM(RTRIM(:NEW.LAYOUT)) || 'VAZIO' <> 'VAZIO')) THEN
    l_Valor := '';
    SP_VALUPDATE_DES(:OLD.AdmFec, :NEW.AdmFec, l_Valido OUT);
    IF (l_Valido = TRUE) THEN	  
      IF (:NEW.LAYOUT = 'IMPORT') OR (:NEW.LAYOUT = 'S-2298') THEN
        IF (:NEW.LAYOUT = 'IMPORT') THEN
          RH_RET_MIN_DATHFI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DataAlteracao OUT);
	    ELSE
		    BEGIN
	           SELECT DATRET INTO l_DataAlteracao
	           FROM R034REI
	           WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
	     	EXCEPTION WHEN 
	           NO_DATA_FOUND THEN RAISERROR 103 'Erro R034MAT_EI. Erro no select R034REI.';               
	        END;
	        
    	   /* Na reintegração, datadm pode estar antes do início do envio das tabelas do eSocial. */
    	   RH_DEF_ESOCIAL(:NEW.NUMEMP, l_DataInicioTabelas OUT, l_DataInicioEsocial OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);	     
           IF (l_DataAlteracao < l_DataInicioNaoPeriodicos) THEN
             l_DataAlteracao := l_DataInicioNaoPeriodicos;
           END IF;
	    END IF;
      
        l_Valor := '';
		
		IF ((:NEW.LayOri = 'S-2200') OR (:NEW.LayOri = 'S-2298')) THEN
		  SP_CONCATENAR_DES('LAYOUT', 'S-2206', l_Valor OUT);
          SP_E_SOCIAL('S-2206', 'R034MAT', 'N', 'A', l_DataAlteracao, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, l_DataAlteracao, 0, 'R034MAT_EU');

          l_Valor := '';	  
          SP_CONCATENAR_DES('LAYOUT', 'S-2205', l_Valor OUT);
          SP_E_SOCIAL('S-2205', 'R034MAT', 'N', 'I', l_DataAlteracao, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, l_DataAlteracao, 0, 'R034MAT_EU');
        END IF;
	    
		IF (:NEW.LayOri = 'S-2300') THEN
          l_Valor := '';
		  SP_CONCATENAR_DES('LAYOUT', 'S-2306', l_Valor OUT);
		  SP_E_SOCIAL('S-2306', 'R034MAT', 'N', 'A', l_DataAlteracao, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, l_DataAlteracao, 0, 'R034MAT_EU');
        END IF;
        
       	IF (:NEW.LayOri = 'S-2400') THEN     	          
          l_Valor := '';
          SP_CONCATENAR_DES('LAYOUT', 'S-2405', l_Valor OUT);
          SP_E_SOCIAL('S-2405', 'R034MAT', 'N', 'I', l_DataAlteracao, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, l_DataAlteracao, 0, 'R034MAT_EU');	  
	    END IF;
      END IF;
		
      IF (:NEW.LAYOUT <> 'IMPORT') THEN
        l_Valor := '';
        SP_CONCATENAR_DES('LAYOUT', :NEW.LAYOUT, l_Valor OUT);
        SP_E_SOCIAL(:NEW.LAYOUT, 'R034MAT', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, NULL, 0, 'R034MAT_EU');
      END IF;	
    END IF;
  END IF;
END␀␀␀•␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀¡Ó␀␀…¬␀␀´␀	Ôï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôï!␀␀␀␀␀Ü␀t␀Ü␀nû‡␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôï!␀␀␀␀␀$0.0.wñ‡␀Æÿ␀␀…Ó␀␀␀-Q	Ôï!␀␀␀␀␀MBA¥␀␀A¥␀␀p¯‰␀Æÿ␀␀ÿ␀[␀␀=Ôï!␀␀␀␀␀ß3{3{3c␀␀␀ÿ␀␀ÿ␀␀␀¢Ó␀␀␀␀0;1;2;3¤Ó␀␀		SENIOR;0D␀␀TRIGGER R034MDL_EI AFTER INSERT ON R034MDL FOR EACH ROW
DECLARE
  l_qtde             NUMBER;
  l_DATCTL           DATE;
  l_DATCTLTOLERANCIA DATE;
  l_HORCTL             R034CTL.HORCTL%TYPE;
  l_HORCTLTOLERANCIA   R034CTL.HORCTL%TYPE;
  l_temAud           BOOLEAN;
  l_codRPA           NUMBER(15);
  l_codSistema       NUMBER(2);
  l_codcpa           NUMBER(4);
  l_codtpa           NUMBER(4);
  l_datTemp          VARCHAR(10);
BEGIN

  l_DATCTL := CURDATE();
  l_DATCTLTOLERANCIA := l_DATCTL;
  l_HORCTL := HOUR(CURTIME())* 60 + MINUTE(CURTIME());
  l_HORCTLTOLERANCIA := l_HORCTL;

  /* Calcula 1 minuto de tolerancia */
  l_HORCTLTOLERANCIA := l_HORCTL - 1;
  /* Se a hora for 00:00 com menos 1 minuto deve ficar 23:59 do dia anterior. */
  IF (l_HORCTLTOLERANCIA < 0) THEN
    l_HORCTLTOLERANCIA := 1439;
    l_DATCTLTOLERANCIA := DATETimeAdd(DD,-1,l_DATCTLTOLERANCIA);
  END IF;

  /* SELECT na R034CTL com tolerancia de 1 minuto */
  BEGIN
    SELECT COUNT(*) INTO l_qtde FROM R034CTL
      WHERE NUMEMP = :NEW.NUMEMP
        AND TIPCOL = :NEW.TIPCOL
        AND NUMCAD = :NEW.NUMCAD
        AND (DATCTL = l_DATCTL
         OR DATCTL = l_DATCTLTOLERANCIA)
        AND (HORCTL = l_HORCTL
         OR HORCTL = l_HORCTLTOLERANCIA);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no SELECT da tabela R034CTL.';
  END;

  IF (l_qtde = 0) THEN
    IF (:NEW.CODMOD = 1) THEN     /* TRATAMENTO PARA O MÓDULO BENEFÍCIOS */
      R034MDL_VERUSOBS(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
    ELSIF (:NEW.CODMOD = 2) THEN  /* TRATAMENTO PARA O MÓDULO CARGOS E SALÁRIOS */
      R034MDL_VERUSOCS(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
    ELSIF (:NEW.CODMOD = 3) THEN  /* TRATAMENTO PARA O MÓDULO JURÍDICO */
      R034MDL_VERUSOJR(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
    ELSIF (:NEW.CODMOD = 4) THEN  /* TRATAMENTO PARA O MÓDULO MEDICINA */
      R034MDL_VERUSOMC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
    ELSIF (:NEW.CODMOD = 5) THEN  /* TRATAMENTO PARA O MÓDULO PESQUISA */
      R034MDL_VERUSOPE(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
    ELSIF (:NEW.CODMOD = 6) THEN  /* TRATAMENTO PARA O MÓDULO PLR */
      R034MDL_VERUSOPLR(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
    ELSIF (:NEW.CODMOD = 8) THEN  /* TRATAMENTO PARA O MÓDULO RECRUTAMENTO E SELEÇÃO */
      R034MDL_VERUSORS(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
    ELSIF (:NEW.CODMOD = 9) THEN  /* TRATAMENTO PARA O MÓDULO RUBI */
      R034MDL_VERUSORUBI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
    ELSIF (:NEW.CODMOD = 10) THEN /* TRATAMENTO PARA O MÓDULO SEGURANÇA */
      R034MDL_VERUSOSG(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
    ELSIF (:NEW.CODMOD = 11) THEN /* TRATAMENTO PARA O MÓDULO TREINAMENTO */
      R034MDL_VERUSOTR(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
    ELSIF (:NEW.CODMOD = 13) THEN /* TRATAMENTO PARA O MÓDULO TAREFEIROS */
      R034MDL_VERUSOTF(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
    END IF;
  END IF;
  
  /* Geração de logs Indicação para os Módulos (Tabela: R034MDL)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 89;     /* Indicação para os Módulos (Tabela: R034MDL)*/
  l_codtpa := 289;
 
   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034MDL_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODMOD', CONVERT(NUMBER_TO_CHAR, :NEW.CODMOD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034MDL_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDCON', :NEW.INDCON);
      END;
  END IF;   
END␀¥Ó␀␀		SENIOR;0r␀␀

TRIGGER R034MDL_EU AFTER UPDATE ON R034MDL FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Indicação para os Módulos (Tabela: R034MDL)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 89;     /* Indicação para os Módulos (Tabela: R034MDL)*/
  l_codtpa := 290;
 
  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.CodMod <> :NEW.CodMod)
   OR (:OLD.IndCon <> :NEW.IndCon)) THEN

   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034MDL_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODMOD', CONVERT(NUMBER_TO_CHAR, :OLD.CODMOD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034MDL_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINDCON', :OLD.INDCON);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINDCON', :NEW.INDCON);
      END;
    END IF; 
  END IF; 
END␀£Ó␀␀		SENIOR;0¤␀␀ 


TRIGGER R034MDL_ED AFTER DELETE ON R034MDL FOR EACH ROW
