l_cracha       NUMBER(12);
  l_situa        CHAR(1);
  l_bloace       CHAR(1);
  l_strerr       VARCHAR2(255);
  l_codsta       NUMBER(2);
  l_horatu       NUMBER(4);
  l_data_zero    DATE;
  l_datatu       DATE;
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_contpm       NUMBER(1);
  l_tempac       NUMBER(3);
  l_conrea       NUMBER(1);
  l_conadp       NUMBER(1);
  l_pesblo       CHAR(1);
  l_desblo       VARCHAR2(30);
  l_tipdoc       NUMBER(1);
  l_numdoc       VARCHAR2(20);
  l_conree       NUMBER(1);
  l_usarfa       NUMBER(1);
BEGIN
    l_datatu    := CURDATE();
    l_horatu    := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_data_zero := '31/12/1900,00:00:00';
    SP_RetCra (1,0, 6,0, 0,p_nummat,0,'',l_cracha OUT);
    l_conrea := 1;

    IF  l_cracha = 0 THEN
        SP_RetCra (2,0, 6,0,0,p_nummat,0,'',l_cracha OUT);
    END IF;

    /* Verifica se Aluno possui Cracha */
    IF   l_cracha <> 0  THEN
         /* verifica qual a situação no histórico do aluno */
        l_codsta := 0;
        l_bloace := 'S';
        l_pesblo := '0';
        l_desblo := '';
        l_tipdoc := 0;
        l_numdoc := '';

        BEGIN
            SELECT CODSTA INTO l_codsta FROM R073HSA WHERE NUMMAT = p_nummat AND
                   ((DATINI < l_datatu) OR (DATINI = l_datatu AND HORINI <= l_horatu)) AND
                   ((DATFIM > l_datatu) OR (DATFIM = l_datatu AND HORFIM >= l_horatu) OR (DATFIM = l_data_zero));
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN l_strerr := 'SP_RETBLO: Erro em R073HSA - TOO MANY ROWS. Nummat = '||p_nummat;
                                    RAISERROR 103 l_strerr;
            WHEN NO_DATA_FOUND THEN l_codsta := 0;
            WHEN OTHERS THEN l_strerr := 'SP_RETBLO: Erro no SELECT em R073HSA. Nummat = '||p_nummat;
                             RAISERROR 103 l_strerr;
        END;

        /* verifica se a situação do aluno é de bloqueio */
        BEGIN
            SELECT BLOACE, DESSTA INTO l_bloace, l_desblo FROM R073STA WHERE CODSTA = l_codsta;
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN l_strerr := 'Erro na seleção do bloqueio em R073STA - TOO MANY ROWS. CodSta = '||l_codsta;
                                    RAISERROR 103 l_strerr;
            WHEN NO_DATA_FOUND THEN l_bloace := 'S';
            WHEN OTHERS THEN l_strerr := 'Erro no SELECT em R073STA. CodSta = '||CONVERT(NUMBER_TO_CHAR,l_codsta);
                             RAISERROR 103 l_strerr;
        END;

        IF  (l_bloace = 'S') THEN
          l_situa :='1';
          l_pesblo := '1';
        ELSE
          l_situa :='0';
          l_desblo := '';
        END IF;

        /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
        SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
        IF (l_crapri = 0) THEN
            l_crapri := l_cracha;
        END IF;

        IF (p_contpm = 'S') THEN
          l_contpm := 1;
          /* Busca definições do tempo de permanência de aluno na R070DAC. */
          BEGIN
              SELECT TEMPRA INTO l_tempac FROM R070DAC;
          EXCEPTION
              WHEN OTHERS THEN l_tempac := 0;
          END;
        ELSE
          l_contpm := 0;
          l_tempac := 0;
        END IF;

        IF (p_conadp = 'S') THEN
          l_conadp := '1';
        ELSE
          l_conadp := '0';
        END IF;

        /* Assinala na tabela Controle que o Aluno utiliza reconhecimento facial */
        IF  p_usarfa = 'S' THEN
          l_usarfa := 1;
        ELSE
          l_usarfa := 0;
        END IF;

        IF (p_tipdoc > 0 ) THEN
          l_tipdoc := p_tipdoc;
          l_numdoc := p_numdoc;
        END IF;

        IF (p_conree = 'S') THEN
          l_conree := '1';
        ELSE
          l_conree := '0';
        END IF;

        BEGIN
            UPDATE R070CON SET CODPRM = p_codprm, PRMSAB = p_prmsab, PRMDOM = p_prmdom, PRMFER = p_prmfer,
                               CONPAC = l_contpm, TEMPAC = l_tempac, USABIO = p_usabio, GRACON = p_gracon,
                               CONREA = l_conrea, CONADP = l_conadp, NOMPES = p_nompes, NUMFON = p_numfon, 
                               DDIFON = p_ddifon, DDDFON = p_dddfon, QTDPRV = 0, PESBLO = l_pesblo,
                               DESBLO = l_desblo, TIPDOC = l_tipdoc, NUMDOC = l_numdoc, CONREE = l_conree,
                               NUMEMP = 0, TIPCOL = 0, NUMCAD = 0, NUMMAT = p_nummat, PROPAC = '0', NUMCAN = 0,
                               USARFA = l_usarfa
             WHERE NUMFIS = l_crapri;
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro Na Atualização da R070CON (R073ALU_ATUCON).';
        END;
        /*Atualiza a situação dos demais crachás.*/
        SP_UPDFIS(l_cracha,l_situa,' ');
        /*Atualiza as permissões para os demais crachás da pessoa*/
        SP_UPDPRM(l_cracha, p_codprm, p_prmsab, p_prmdom, p_prmfer, ' ', ' ', ' ');

        /*Atualiza a Pend_grupo se possuir smart*/
        IF (l_numsma > 0) THEN
            /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
            IF (l_tecpri = 3) THEN
                SP_ATUPRM(l_cracha, l_numsma, p_codprm, 0, 0, 0, p_prmsab, p_prmdom, p_prmfer);
            ELSE
                SP_ATUPRM(l_crapri, l_numsma, p_codprm, 0, 0, 0, p_prmsab, p_prmdom, p_prmfer);
            END IF;
        END IF;
    END IF;
END␀ıÚ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_RETCRA
␀␀PROCEDURE R073hch_ATULN(P_TIPOPE CHAR,P_TIPCRA NUMBER,P_NUMMAT VARCHAR2(15),P_NUMCRA NUMBER)
 IS

l_data_atual      DATE;
  l_numcra          NUMBER(12);
  l_craprv          NUMBER(12);
  l_cratit          NUMBER(12);
  l_existe          BOOLEAN;

BEGIN
  l_data_atual := CURDATE();

  l_craprv := 0;
  l_cratit := 0;

  /* na inclusão de crachá e na baixa de provisorio verificar */
  IF   (p_tipope = 'I') OR ((p_tipope = 'U') AND (p_tipcra = 2)) OR ((p_tipope = 'D') AND (p_tipcra = 2)) THEN
       IF   p_tipcra = 1 THEN
            SP_RETCRA (2,0,6,0,0, p_nummat,0,'', l_craprv OUT);
       ELSE
       SP_RETCRA (1,0,6,0,0, p_nummat,0,'', l_cratit OUT);
       END IF;
  END IF;

  IF    (p_tipope = 'I')  THEN  /* ao atribuir um crachá */
         IF   p_tipcra = 1 THEN /* se for cracha titular */
              IF   l_craprv <> 0 THEN /* se existir um provisório ativo */

                   l_existe := TRUE;
                   BEGIN
                     SELECT NUMCRA INTO l_numcra FROM R058LNG WHERE NUMCRA = p_numcra;
                   EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                           l_existe := FALSE;
                   END;

                   /* incluir na lista negra o titular */
                   IF  (l_existe = FALSE) THEN
                       INSERT INTO R058LNG (NUMCRA,ORIINC,DATINC,CODUSU)
                       VALUES (p_numcra,4,l_data_atual,0);
                   END IF;

              ELSE
                   /* eliminar da lista negra o titular (caso esteja) */
                   BEGIN
                     DELETE FROM R058LNG WHERE NUMCRA = p_numcra;
                   EXCEPTION WHEN OTHERS THEN
                     NULL;
                   END;
              END IF;
         ELSE
              IF   l_cratit <> 0 THEN /* se existir um titular ativo */

                   l_existe := TRUE;
                   BEGIN
                     SELECT NUMCRA INTO l_numcra FROM R058LNG WHERE NUMCRA = l_cratit;
                   EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                           l_existe := FALSE;
                   END;

                   /* incluir na lista negra o titular */
                   IF  (l_existe = FALSE) THEN
                       INSERT INTO R058LNG (NUMCRA,ORIINC,DATINC,CODUSU)
                       VALUES (l_cratit,4,l_data_atual,0);
                   END IF;

              ELSE
                   /* eliminar da lista negra o provisorio (caso esteja) */
                   BEGIN
                     DELETE FROM R058LNG WHERE NUMCRA = p_numcra;
                   EXCEPTION WHEN OTHERS THEN
                     NULL;
                   END;
              END IF;
         END IF;
  ELSIF (p_tipope = 'U') OR (p_tipope = 'D') THEN /* na baixa do cracha e exclusão do crachá */

         IF   p_tipcra = 2 THEN /* se for cracha provisorio */

              IF   l_cratit <> 0 THEN /* se existir um titular ativo */
                   /* eliminar da lista negra o titular (caso esteja) */
                   BEGIN
                     DELETE FROM R058LNG WHERE NUMCRA = l_cratit;
                   EXCEPTION WHEN OTHERS THEN
                     NULL;
                   END;
              END IF;

         END IF;
  END IF;
END␀Û␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE R073hch_VSOB(P_TIPOPE CHAR,P_TIPCRA NUMBER,P_NUMMAT VARCHAR2(15),P_NUMCRA NUMBER,P_DATINI DATE,P_HORINI NUMBER,P_DATFIM DATE,P_HORFIM NUMBER)
 IS

l_data_zero    DATE;
  l_datini       DATE;
  l_datfim       DATE;
  l_datant       DATE;
  l_horant       NUMBER(5);
  l_horini       NUMBER(5);
  l_horfim       NUMBER(5);
  l_tipcra  	 NUMBER(2);
  l_nummat       VARCHAR2(15);
  l_comando_nulo BOOLEAN;
  l_errstr       VARCHAR2(255);
  l_count           NUMBER(5);
BEGIN
  l_data_zero  :='31/12/1900,00:00:00';

  /* verifica se já existe um historico para o colaborador ou para o crachá que não seja o que esta sendo incluído */
  BEGIN
      SELECT TIPCRA,NUMMAT,DATFIM,HORFIM,COUNT(*) INTO l_tipcra,l_nummat,l_datfim,l_horfim,l_count
      FROM R073hch A
      WHERE (A.TIPCRA <> p_tipcra OR A.NUMMAT <> p_nummat OR A.DATINI <> p_datini OR A.HORINI <> p_horini)AND
            ((A.TIPCRA = p_tipcra AND A.NUMMAT = p_nummat) OR (A.NUMCRA = p_numcra)) AND
            (((A.DATINI > p_datini OR (A.DATINI = p_datini AND A.HORINI >= p_horini)) AND
            (A.DATINI < p_datfim OR p_DATFIM = l_data_zero OR (A.DATINI = p_datfim AND (A.HORINI <= p_horfim OR p_horfim = 0))))OR
            ((A.DATFIM > p_datini OR A.DATFIM = l_data_zero OR (A.DATFIM = p_datini AND (A.HORFIM >= p_horini OR A.HORFIM = 0))) AND
            ((A.DATFIM < p_datfim AND A.DATFIM <> l_data_zero) OR p_datfim = l_data_zero OR (A.DATFIM = p_datfim AND (A.HORFIM <= p_horfim OR p_horfim = 0)))OR
            ((p_datini > A.DATINI OR (p_datini = A.DATINI AND p_horini >= A.HORINI)) AND
            ((p_datfim < A.DATFIM AND p_datfim <> l_data_zero) OR A.DATFIM = l_data_zero OR (p_DATFIM = A.DATFIM AND p_horfim <= A.HORFIM)) ) ) )
      GROUP BY TIPCRA,NUMMAT,DATFIM,HORFIM;
  EXCEPTION
      WHEN TOO_MANY_ROWS THEN
           l_errstr := 'Erro de Sobreposição - TOO MANY ROWS. '||
                         ' Aluno  : '||p_nummat||
                         ' Crachá : '||CONVERT(NUMBER_TO_CHAR,p_numcra);
           RAISERROR 103 l_errstr;
      WHEN NO_DATA_FOUND THEN
           l_count:=0;
           l_comando_nulo:=TRUE;
      WHEN OTHERS THEN RAISERROR 103 'Erro no SELECT R073hch. 1';
  END;

  IF  l_count > 0 THEN
      /* se estiver inserindo e for o mesmo colaborador que sobrepos */
      IF   (p_tipope = 'I') AND
           (l_tipcra = p_tipcra) AND
           (l_nummat = p_nummat) AND
           ((p_datini > l_datfim) OR (l_datfim = l_data_zero) OR
            ((p_datini = l_datfim) AND ((p_horini > l_horfim) AND (l_horfim <> 0)))) THEN
           /* Se tiver incluindo fechar o ultimo cracha */
           /* verifica se a sobreposição esta no ultimo historico */
           /* pega o ultimo historico em aberto checando também se*/
           /* não esta tentando incluir o mesmo número de crachá*/
           l_comando_nulo:=TRUE;
           BEGIN
               SELECT A.DATINI,A.HORINI INTO l_datini,l_horini FROM R073hch A
               WHERE A.TIPCRA = p_tipcra AND A.NUMMAT = p_nummat AND A.NUMCRA <> p_numcra AND A.DATFIM = l_data_zero AND
                     A.DATINI IN (SELECT MAX(DATINI) FROM R073hch WHERE TIPCRA = p_tipcra AND NUMMAT = p_nummat
                                 AND (DATINI < p_datini OR (DATINI = p_datini AND HORINI < p_horini))) AND
                     A.HORINI IN (SELECT MAX(HORINI) FROM R073hch WHERE TIPCRA = p_tipcra AND NUMMAT = p_nummat AND DATINI = A.DATINI);
           EXCEPTION
               WHEN TOO_MANY_ROWS THEN
                 l_errstr := 'Erro em R073hch - TOO MANY ROWS. '||
                             ' Matrícula: '||p_nummat;
                 RAISERROR 103 l_errstr;
               WHEN NO_DATA_FOUND THEN l_comando_nulo:=FALSE;
               WHEN OTHERS THEN RAISERROR 103 'Erro no SELECT R073hch';
           END;

           /* fecha o ultimo historico se este estiver aberto */
           IF   (l_comando_nulo = TRUE) THEN
                /* se a hora inicial do novo historico for 0 ou 1 min então decrementa o dia e a hora fica = 23:59 */
                IF  (p_horini = 0) OR (p_horini = 1) THEN
                    l_horant := 1439;
                    l_datant := DATETimeAdd(DD,-1,p_datini);
                ELSE
                    l_datant := p_datini;
                    l_horant := p_horini-1;
                END IF;
                /* fecha o ultimo historico em aberto */
                UPDATE R073hch SET DATFIM = l_datant, HORFIM = l_horant WHERE TIPCRA = p_tipcra
                  AND NUMMAT = p_nummat AND DATINI = l_datini AND HORINI = l_horini;
           ELSE
                l_errstr := 'Erro de Sobreposição de crachás : '||
                            ' Matrícula : '||p_nummat;
                RAISERROR 103 l_errstr;
           END IF;
           l_comando_nulo:=FALSE;
      ELSE
             l_errstr := 'Erro de Sobreposição de crachás :'||
                         ' Aluno : '||p_nummat||
                         ' Crachá: '||CONVERT(NUMBER_TO_CHAR,p_numcra);
             RAISERROR 103 l_errstr;
      END IF;
  END IF;
END␀Û␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_RETCRA
7␀␀PROCEDURE R073hcr_ATULN(P_TIPOPE CHAR,P_TIPCRA NUMBER,P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER)
 IS

l_data_atual      DATE;
  l_numcra          NUMBER(12);
  l_craprv          NUMBER(12);
  l_cratit          NUMBER(12);
  l_existe          BOOLEAN;

BEGIN
  l_data_atual := CURDATE();

  l_craprv := 0;
  l_cratit := 0;

  /* na inclusão de crachá e na baixa de provisorio verificar */
  IF   (p_tipope = 'I') OR ((p_tipope = 'U') AND (p_tipcra = 2)) OR ((p_tipope = 'D') AND (p_tipcra = 2)) THEN
       IF   p_tipcra = 1 THEN
            SP_RETCRA (2,0,7,0,0, '',p_tipdoc,p_numdoc,l_craprv OUT);
       ELSE
       SP_RETCRA (1,0,7,0,0, '',p_tipdoc,p_numdoc, l_cratit OUT);
       END IF;
  END IF;

  IF    (p_tipope = 'I')  THEN  /* ao atribuir um crachá */
         IF   p_tipcra = 1 THEN /* se for cracha titular */
              IF   l_craprv <> 0 THEN /* se existir um provisório ativo */

                   l_existe := TRUE;
                   BEGIN
                     SELECT NUMCRA INTO l_numcra FROM R058LNG WHERE NUMCRA = p_numcra;
                   EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                           l_existe := FALSE;
                   END;

                   /* incluir na lista negra o titular */
                   IF  (l_existe = FALSE) THEN
                       INSERT INTO R058LNG (NUMCRA,ORIINC,DATINC,CODUSU)
                       VALUES (p_numcra,4,l_data_atual,0);
                   END IF;

              ELSE
                   /* eliminar da lista negra o titular (caso esteja) */
                   BEGIN
                     DELETE FROM R058LNG WHERE NUMCRA = p_numcra;
                   EXCEPTION WHEN OTHERS THEN
                     NULL;
                   END;
              END IF;
         ELSE
              IF   l_cratit <> 0 THEN /* se existir um titular ativo */

                   l_existe := TRUE;
                   BEGIN
                     SELECT NUMCRA INTO l_numcra FROM R058LNG WHERE NUMCRA = l_cratit;
                   EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                           l_existe := FALSE;
                   END;

                   /* incluir na lista negra o titular */
                   IF  (l_existe = FALSE) THEN
                       INSERT INTO R058LNG (NUMCRA,ORIINC,DATINC,CODUSU)
                       VALUES (l_cratit,4,l_data_atual,0);
                   END IF;

              ELSE
                   /* eliminar da lista negra o provisorio (caso esteja) */
                   BEGIN
                     DELETE FROM R058LNG WHERE NUMCRA = p_numcra;
                   EXCEPTION WHEN OTHERS THEN
                     NULL;
                   END;
              END IF;
         END IF;
  ELSIF (p_tipope = 'U') OR (p_tipope = 'D') THEN /* na baixa do cracha e exclusão do crachá */

         IF   p_tipcra = 2 THEN /* se for cracha provisorio */

              IF   l_cratit <> 0 THEN /* se existir um titular ativo */
                   /* eliminar da lista negra o titular (caso esteja) */
                   BEGIN
                     DELETE FROM R058LNG WHERE NUMCRA = l_cratit;
                   EXCEPTION WHEN OTHERS THEN
                     NULL;
                   END;
              END IF;

         END IF;
  END IF;
END␀éÚ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
'␀␀PROCEDURE R073HCR_VSOB(P_TIPOPE CHAR,P_TIPCRA NUMBER,P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER,P_DATINI DATE,P_HORINI NUMBER,P_DATFIM DATE,P_HORFIM NUMBER)
 IS

l_data_zero    DATE;
  l_datini       DATE;
  l_datfim       DATE;
  l_datant       DATE;
  l_horant       NUMBER(5);
  l_horini       NUMBER(5);
  l_horfim       NUMBER(5);
  l_tipcra  	 NUMBER(2);
  l_tipdoc	 NUMBER(1);
  l_numdoc	 VARCHAR2(20);
  l_comando_nulo BOOLEAN;
  l_errstr       VARCHAR2(255);
  l_count           NUMBER(5);
BEGIN
  l_data_zero  :='31/12/1900,00:00:00';

  /* verifica se já existe um historico para o responsavel ou para o crachá que não seja o que esta sendo incluído */
  BEGIN
      SELECT TIPCRA,TIPDOC,NUMDOC,DATFIM,HORFIM,COUNT(*) INTO l_tipcra,l_tipdoc,l_numdoc,l_datfim,l_horfim,l_count
      FROM R073hcr A
      WHERE (A.TIPCRA <> p_tipcra OR A.TIPDOC <> p_tipdoc OR A.NUMDOC <> p_numdoc OR A.DATINI <> p_datini OR A.HORINI <> p_horini)AND
            ((A.TIPCRA = p_tipcra AND A.TIPDOC = p_tipdoc AND A.NUMDOC = p_numdoc) OR (A.NUMCRA = p_numcra)) AND
            (((A.DATINI > p_datini OR (A.DATINI = p_datini AND A.HORINI >= p_horini)) AND
            (A.DATINI < p_datfim OR p_DATFIM = l_data_zero OR (A.DATINI = p_datfim AND (A.HORINI <= p_horfim OR p_horfim = 0))))OR
            ((A.DATFIM > p_datini OR A.DATFIM = l_data_zero OR (A.DATFIM = p_datini AND (A.HORFIM >= p_horini OR A.HORFIM = 0))) AND
            ((A.DATFIM < p_datfim AND A.DATFIM <> l_data_zero) OR p_datfim = l_data_zero OR (A.DATFIM = p_datfim AND (A.HORFIM <= p_horfim OR p_horfim = 0)))OR
            ((p_datini > A.DATINI OR (p_datini = A.DATINI AND p_horini >= A.HORINI)) AND
            ((p_datfim < A.DATFIM AND p_datfim <> l_data_zero) OR A.DATFIM = l_data_zero OR (p_DATFIM = A.DATFIM AND p_horfim <= A.HORFIM)) ) ) )
      GROUP BY TIPCRA,TIPDOC,NUMDOC,DATFIM,HORFIM;
  EXCEPTION
      WHEN TOO_MANY_ROWS THEN
           l_errstr := 'Erro de Sobreposição - TOO MANY ROWS. '||
                         ' TipDoc  : '||CONVERT(NUMBER_TO_CHAR,p_tipdoc)||
                         ' NumDoc  : '||p_numdoc||
                         ' Crachá : '||CONVERT(NUMBER_TO_CHAR,p_numcra);
           RAISERROR 103 l_errstr;
      WHEN NO_DATA_FOUND THEN
           l_count:=0;
           l_comando_nulo:=TRUE;
      WHEN OTHERS THEN RAISERROR 103 'Erro no SELECT R073hcr. 1';
  END;

  IF  l_count > 0 THEN
      /* se estiver inserindo e for o mesmo responsavel que sobrepos */
      IF   (p_tipope = 'I') AND
           (l_tipcra = p_tipcra) AND
           (l_tipdoc = p_tipdoc) AND
           (l_numdoc = p_numdoc) AND
           ((p_datini > l_datfim) OR (l_datfim = l_data_zero) OR
            ((p_datini = l_datfim) AND ((p_horini > l_horfim) AND (l_horfim <> 0)))) THEN
           /* Se tiver incluindo fechar o ultimo cracha */
           /* verifica se a sobreposição esta no ultimo historico */
           /* pega o ultimo historico em aberto checando também se*/
           /* não esta tentando incluir o mesmo número de crachá*/
           l_comando_nulo:=TRUE;
           BEGIN
               SELECT A.DATINI,A.HORINI INTO l_datini,l_horini FROM R073hcr A
               WHERE A.TIPCRA = p_tipcra AND A.TIPDOC = p_tipdoc AND A.NUMDOC = p_numdoc AND A.NUMCRA <> p_numcra AND A.DATFIM = l_data_zero AND
                     A.DATINI IN (SELECT MAX(DATINI) FROM R073HCR WHERE TIPCRA = p_tipcra AND TIPDOC = p_tipdoc AND NUMDOC = p_numdoc
                                 AND (DATINI < p_datini OR (DATINI = p_datini AND HORINI < p_horini))) AND
                     A.HORINI IN (SELECT MAX(HORINI) FROM R073HCR WHERE TIPCRA = p_tipcra AND TIPDOC = p_tipdoc AND NUMDOC = p_numdoc AND DATINI = A.DATINI);
           EXCEPTION
               WHEN TOO_MANY_ROWS THEN
                 l_errstr := 'Erro em R073hcr - TOO MANY ROWS. '||
                             ' TIPDOC: '||CONVERT(NUMBER_TO_CHAR,p_tipdoc)||
                             ' NUMDOC: '||p_numdoc;
                 RAISERROR 103 l_errstr;
               WHEN NO_DATA_FOUND THEN l_comando_nulo:=FALSE;
               WHEN OTHERS THEN RAISERROR 103 'Erro no SELECT R073hcr';
           END;

           /* fecha o ultimo historico se este estiver aberto */
           IF   (l_comando_nulo = TRUE) THEN
                /* se a hora inicial do novo historico for 0 ou 1 min então decrementa o dia e a hora fica = 23:59 */
                IF  (p_horini = 0) OR (p_horini = 1) THEN
                    l_horant := 1439;
                    l_datant := DATETimeAdd(DD,-1,p_datini);
                ELSE
                    l_datant := p_datini;
                    l_horant := p_horini-1;
                END IF;
                /* fecha o ultimo historico em aberto */
                UPDATE R073hcr SET DATFIM = l_datant, HORFIM = l_horant WHERE TIPCRA = p_tipcra
                  AND TIPDOC = p_tipdoc AND NUMDOC = p_numdoc AND DATINI = l_datini AND HORINI = l_horini;
           ELSE
                l_errstr := 'Erro de Sobreposição de crachás : '||
                             ' TIPDOC: '||CONVERT(NUMBER_TO_CHAR,p_tipdoc)||
                             ' NUMDOC: '||p_numdoc;
                RAISERROR 103 l_errstr;
           END IF;
           l_comando_nulo:=FALSE;
      ELSE
             l_errstr := 'Erro de Sobreposição de crachás :'||
                             ' TIPDOC: '||CONVERT(NUMBER_TO_CHAR,p_tipdoc)||
                             ' NUMDOC: '||p_numdoc||
                         ' Crachá: '||CONVERT(NUMBER_TO_CHAR,p_numcra);
             RAISERROR 103 l_errstr;
      END IF;
  END IF;
END␀ëÚ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
