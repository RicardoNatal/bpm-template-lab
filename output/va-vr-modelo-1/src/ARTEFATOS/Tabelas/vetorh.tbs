			SP_PEND75('U', :NEW.IDTPES, :NEW.TECCRA, :NEW.NUMFIS, :NEW.PLAVEI, :NEW.CRAVEI, :NEW.DATVAL, :NEW.SITCRA, :NEW.CONLPR, :NEW.VEIFRO);
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'R088CON: Erro ao atualizar controle.';
		END;
