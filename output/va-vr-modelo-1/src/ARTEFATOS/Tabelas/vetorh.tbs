31/12/1900oS= ␀␀␀␀␀␀ŞSWS¼Sc␀␀␀ÿ␀␀ÿ␀=-Á␀	 ␀␀␀␀␀␀[<ÇÇ)␀␀Æÿ␀␀œŞ␀␀␀Ú³␀␀Ôÿ!␀␀␀␀␀:´␀␀ñ³␀␀ñ³␀␀␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3ŠÒ␀␀		SENIOR;0E␀␀TRIGGER R030PRS_EI BEFORE INSERT ON R030PRS FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);
  l_ProximaData DATE;
BEGIN 
  l_Valor := '';
  l_ProximaData := '31/12/1900,00:00:00';
  
  BEGIN
    SELECT MIN(DATINI) 
      INTO l_ProximaData 
      FROM R030PRH  
      WHERE NUMEMP = :NEW.NUMEMP 
        AND CODPRO = :NEW.CODPRO 
        AND DATINI > :NEW.DATINI
        AND (MONTH(DATINI) <> MONTH(:NEW.DATINI)
        OR YEAR(DATINI) <> YEAR(:NEW.DATINI));
      IF (MONTH(l_ProximaData) = 1) THEN
        l_ProximaData := DATETIME(1, 12, YEAR(l_ProximaData) -1, 0, 0, 0);
      ELSE
         l_ProximaData := DATETIME(1, MONTH(l_ProximaData) -1, YEAR(l_ProximaData), 0, 0, 0);
      END IF;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_ProximaData := '31/12/1900,00:00:00';	
      WHEN OTHERS THEN
        NULL;
  END;	
  
  SP_CONCATENAR_NUM('CODPRO', :NEW.CODPRO, l_Valor OUT);
  SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
  
  SP_E_SOCIAL('S-1070', 'R030PRH', 'T', 'I', :NEW.DATINI, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030PRS_EI');
END␀‹Ò␀␀		SENIOR;0-␀␀

TRIGGER R030PRS_EU BEFORE UPDATE ON R030PRS FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
  l_Alterou BOOLEAN;
  l_Valido BOOLEAN;
  l_ProximaData DATE;
BEGIN 
  l_Valor := '';
  l_ProximaData := '31/12/1900,00:00:00';

  SP_VALUPDATE_NUM(:OLD.TIPDEC, :NEW.TIPDEC, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
	l_Alterou := TRUE;
  END IF;	
  
  SP_VALUPDATE_DAT(:OLD.DATDEC, :NEW.DATDEC, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
	l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_DES(:OLD.DEPINT, :NEW.DEPINT, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
	l_Alterou := TRUE;
  END IF;
	
  IF (l_Alterou = TRUE) THEN
    BEGIN
      SELECT MIN(DATINI) 
        INTO l_ProximaData 
        FROM R030PRH  
        WHERE NUMEMP = :NEW.NUMEMP 
          AND CODPRO = :NEW.CODPRO 
          AND DATINI > :NEW.DATINI
          AND (MONTH(DATINI) <> MONTH(:NEW.DATINI)
          OR YEAR(DATINI) <> YEAR(:NEW.DATINI));
        IF (MONTH(l_ProximaData) = 1) THEN
          l_ProximaData := DATETIME(1, 12, YEAR(l_ProximaData) -1, 0, 0, 0);
        ELSE
           l_ProximaData := DATETIME(1, MONTH(l_ProximaData) -1, YEAR(l_ProximaData), 0, 0, 0);
        END IF;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_ProximaData := '31/12/1900,00:00:00';	
        WHEN OTHERS THEN
          NULL;
    END;
  
    SP_CONCATENAR_NUM('CODPRO', :NEW.CODPRO, l_Valor OUT);
    SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
    
    SP_E_SOCIAL('S-1070', 'R030PRH', 'T', 'A', :NEW.DATINI, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030PRS_EU');
  END IF;
END␀‰Ò␀␀		SENIOR;0B␀␀

TRIGGER R030PRS_ED BEFORE DELETE ON R030PRS FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
  l_ProximaData DATE;
BEGIN 
  l_Valor := '';
  l_ProximaData := '31/12/1900,00:00:00';
  
  BEGIN
    SELECT MIN(DATINI) 
      INTO l_ProximaData 
      FROM R030PRH  
      WHERE NUMEMP = :OLD.NUMEMP 
        AND CODPRO = :OLD.CODPRO 
        AND DATINI > :OLD.DATINI
        AND (MONTH(DATINI) <> MONTH(:OLD.DATINI)
        OR YEAR(DATINI) <> YEAR(:OLD.DATINI));
      IF (MONTH(l_ProximaData) = 1) THEN
        l_ProximaData := DATETIME(1, 12, YEAR(l_ProximaData) -1, 0, 0, 0);
      ELSE
         l_ProximaData := DATETIME(1, MONTH(l_ProximaData) -1, YEAR(l_ProximaData), 0, 0, 0);
      END IF;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
