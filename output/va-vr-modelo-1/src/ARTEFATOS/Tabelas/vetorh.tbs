TRIGGER R304BCP_SI AFTER INSERT ON R304BCP
DECLARE
	CURSOR c_R304BCP IS
	SELECT NUMEMP, NUMATO, DATATO, NUMMAT, NUMCPF, CODUNI, CPFBEN, SEQBEN, SEQREG
	  FROM R304BCP
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304BCP IS RECORD (
		NUMEMP   R304BCP.NumEmp%TYPE,
		NUMATO   R304BCP.NUMATO%TYPE,
		DATATO   R304BCP.DATATO%TYPE,
		NUMMAT   R304BCP.NUMMAT%TYPE,
		NUMCPF   R304BCP.NUMCPF%TYPE,
		CODUNI   R304BCP.CODUNI%TYPE,
		CPFBEN   R304BCP.CPFBEN%TYPE,
		SEQBEN   R304BCP.SEQBEN%TYPE,
		SEQREG   R304BCP.SEQREG%TYPE
	);
    
    l_R304BCP t_R304BCP;
    l_PidSta VARCHAR2(30);
    l_MsgErr VARCHAR2(255);
BEGIN
	FOREACH c_R304BCP INTO l_R304BCP.NumEmp, l_R304BCP.NUMATO, l_R304BCP.DATATO, l_R304BCP.NUMMAT, l_R304BCP.NUMCPF, l_R304BCP.CODUNI, l_R304BCP.CPFBEN, l_R304BCP.SEQBEN, l_R304BCP.SEQREG
	LOOP
		/* Busca PID gravado no registro do Concurso/Processo Seletivo */
		BEGIN
			SELECT CPE.PIDSTA INTO l_PidSta
			  FROM R304CPE CPE, R304STA STA
			 WHERE CPE.PIDSTA = STA.PIDSTA
			   AND CPE.NUMEMP = l_R304BCP.NumEmp
			   AND CPE.NUMATO = l_R304BCP.NUMATO
			   AND CPE.DATATO = l_R304BCP.DATATO
			   AND CPE.NUMMAT = l_R304BCP.NUMMAT
			   AND CPE.NUMCPF = l_R304BCP.NUMCPF
			   AND CPE.CODUNI = l_R304BCP.CODUNI
			   AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_MsgErr := 'Não existe registro de concessão pensão pendente com as seguintes chaves: ' ||
					'Empresa: ' || CONVERT(NUMBER_TO_CHAR, l_R304BCP.NumEmp) || ', Ato: ' || l_R304BCP.NUMATO || '.';
				RAISERROR 103 l_MsgErr;
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304BCP.';
		END;
		
		BEGIN
			UPDATE R304BCP
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304BCP.NumEmp
			   AND NUMATO = l_R304BCP.NUMATO
			   AND DATATO = l_R304BCP.DATATO
			   AND NUMMAT = l_R304BCP.NUMMAT
			   AND NUMCPF = l_R304BCP.NUMCPF
			   AND CODUNI = l_R304BCP.CODUNI
			   AND SEQBEN = l_R304BCP.SEQBEN
			   AND SEQREG = l_R304BCP.SEQREG;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304BCP.';
		END;
	END LOOP;
END␀Få␀␀		SENIOR;0%␀␀TRIGGER R304BCP_EI BEFORE INSERT ON R304BCP FOR EACH ROW
DECLARE
	l_SeqReg   R304BCP.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Verifica se está tentando incluir um registro com sequência maior do que a última já cadastrada */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304BCP
		 WHERE NUMEMP = :NEW.NumEmp
		   AND NUMATO = :NEW.NUMATO
		   AND DATATO = :NEW.DATATO
		   AND NUMMAT = :NEW.NUMMAT
		   AND NUMCPF = :NEW.NUMCPF
		   AND CODUNI = :NEW.CODUNI
		   AND CPFBEN = :NEW.CPFBEN
		   AND SEQBEN = :NEW.SEQBEN
		   AND SEQREG <> :NEW.SeqReg;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304BCP.';
	END;
	
	IF (l_SeqReg > 0) THEN
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀Gå␀␀		SENIOR;0ª␀␀

TRIGGER R304BCP_EU BEFORE UPDATE ON R304BCP FOR EACH ROW
DECLARE
	l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
	/* Somente permite alterar caso status do envio seja P - Pendente Envio e R - Erro Envio */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados/excluídos.';
	END IF;
END␀␀␀$*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Iå␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀[¬␀␀	Ôÿ?␀␀␀␀␀¯±␀␀3¯␀␀±␀␀%␀␀ÿ␀␀ÿ␀}DÑ␀	Ôÿ?␀␀␀␀␀^M!FğLqC␀êÿ␀␀ÿ␀ª¬␀␀	Ôÿ?␀␀␀␀␀R°␀␀H¯␀␀°␀␀%␀␀ÿ␀␀ÿ␀s¬␀␀␀	Ôÿ?␀␀␀␀␀¥?c°␀␀c°␀␀Q␀Æÿ␀␀ÿ␀Ö-¦␀	Ôÿ?␀␀␀␀␀-?:5>j␀Æÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀—È␀␀Ñ␀Ôÿ?␀␀␀␀␀{LoHhKqC␀êÿ␀␀ÿ␀ÿ␀*Ôÿ?␀␀␀␀␀␀Ÿ␀k␀p␀Æÿ␀␀ÿ␀Ø&␀Ñ␀Ôÿ?␀␀␀␀␀åMë”␀␀ÖGqC␀êÿ␀␀ÿ␀EÑ␀Ôÿ?␀␀␀␀␀L¸␀␀üJqC␀êÿ␀␀ÿ␀ EÑ␀Ôÿ?␀␀␀␀␀L¶␀␀ıJqC␀êÿ␀␀ÿ␀üŸ␀␀&Ôÿ?␀␀␀␀␀” ␀␀” ␀␀” ␀␀z␀Æÿ␀␀ÿ␀qWÔÿ?␀␀␀␀␀#q q qS␀␀␀ÿ␀␀ÿ␀f%Ôÿ?␀␀␀␀␀bfQfQfp␀Æÿ␀␀ÿ␀4T)Ôÿ?␀␀␀␀␀–YÆXÆX-␀␀ÿ␀␀ÿ␀ÙTÔÿ?␀␀␀␀␀@XWÇW␀␀ÿ␀␀ÿ␀µtÔÿ?␀␀␀␀␀u¬tát␀␀ÿ␀␀ÿ␀X'¦␀Ôÿ?␀␀␀␀␀
