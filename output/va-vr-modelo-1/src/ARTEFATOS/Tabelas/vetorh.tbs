¶␀␀+␀1␀␀ÿ␀␀6`␀få␀␀␀␀␀␀xfº␀ƒfh␀ŸŠ␀␀ÿ␀␀ÿ␀ [Ñ␀␀␀␀␀␀␀ØJgj®FqC␀êÿ␀␀ÿ␀-±␀␀␀␀␀␀␀W=¦␀␀¦␀␀q␀Æÿ␀␀Ñ␀␀␀Àú␀␀␀␀␀␀␀␀Üú␀␀µú␀␀Ôú␀␀n¾ˆ␀Æÿ␀␀|İ␀␀␀»ú␀␀(␀␀␀␀␀␀Úú␀␀´ú␀␀Ôú␀␀d␀¹ˆ␀␀ÿ␀␀{İ␀␀␀<EÑ␀␀␀␀␀␀␀RK(¦␀␀HqC␀êÿ␀␀ÿ␀qo␀␀␀␀␀␀|qPqzqi␀␀ÿ␀␀ÿ␀bË␀␀o␀␀␀␀␀␀–Ë␀␀Ë␀␀•Ë␀␀i␀␀ÿ␀␀ÿ␀Ò_Ñ␀␀␀␀␀␀␀ŸKôHøHqC␀êÿ␀␀ÿ␀Dº␀␀´␀␀␀␀␀␀␀Ù»␀␀Í»␀␀Ï»␀␀r␀Æÿ␀␀Û␀␀␀8␀²␀␀␀␀␀␀­␀␀Ÿ␀␀Ÿ␀␀c␀␀␀ÿ␀␀ÿ␀ş␀␀¢␀␀␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀␀␀␀	0;1;2;3;4İ␀␀		SENIOR;0Ñ␀␀TRIGGER R090ACO_EI BEFORE INSERT ON R090ACO FOR EACH ROW

DECLARE
  l_codprm      NUMBER(5);
  l_datval      DATE;
  l_horval      NUMBER(5);
  l_online      BOOLEAN;
  l_tipvis      NUMBER(3);
  l_bloaut      CHAR(1);
  l_numemp      NUMBER(4);
  l_tipcol      NUMBER(1);
  l_numcad      NUMBER(10);
  l_tippev      NUMBER(1);
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_andvis      NUMBER(3);

BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       /* Valida Cracha e Data */
       IF   :NEW.NUMCRA <> 0 THEN
            SELECT NUMEMP,TIPCOL,NUMCAD,CODPRM,DATVAL,HORVAL,TIPVIS,ANDVIS
              INTO l_numemp,l_tipcol,l_numcad,l_codprm,l_datval,l_horval,l_tipvis,l_andvis
              FROM R090MVI
             WHERE R090MVI.DATENT = :NEW.DATENT AND
                   R090MVI.HORENT = :NEW.HORENT AND
                   R090MVI.SEQENT = :NEW.SEQENT;

            BEGIN
               SELECT BLOAUT , TIPPEV INTO l_bloaut, l_tippev FROM R090TVI
               WHERE TIPVIS = l_tipvis;
            EXCEPTION WHEN OTHERS THEN
               l_bloaut := 'N';
               l_tippev := 1;
            END;

            IF   l_bloaut =  'S' THEN
                 l_bloaut := '1';
            ELSE l_bloaut := '0';
            END IF;

            SP_VISCON_PEND93 (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,l_codprm,:NEW.DATENT,:NEW.HORENT,l_datval,l_horval,l_bloaut,l_tippev,l_tipvis,0,0,0,1,1, l_andvis);

            SP_PEND93(:NEW.TIPDOC, :NEW.NUMDOC, :NEW.NUMCRA, l_codprm, l_tipvis, l_andvis);
            
            R090MVI_ATUCRV('I',l_numemp,l_tipcol,l_numcad,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATENT,l_datval,l_tipvis);  
       END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090ACO');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R090ACO_AUD (SEQREG,VERSEQ,DATENT,HORENT,SEQENT,TIPDOC,NUMDOC,NUMCRA,DATSLO,HORSLO,
                                   DATSAI,HORSAI,ASSVID,EMICID,ESTCID,DEXCID,CODNAC,SEGTDO,SEGDOC,DATNAS,
                                   FUNVIS,QUAVIS,DVADOC,PAIDOC,TIPSEX)
                           VALUES (l_seqreg,l_verseq,:NEW.DATENT,:NEW.HORENT,:NEW.SEQENT,:NEW.TIPDOC,
                                  :NEW.NUMDOC,:NEW.NUMCRA,:NEW.DATSLO,:NEW.HORSLO,:NEW.DATSAI,:NEW.HORSAI,
                                  :NEW.ASSVID,:NEW.EMICID,:NEW.ESTCID,:NEW.DEXCID,:NEW.CODNAC,:NEW.SEGTDO,
                                  :NEW.SEGDOC,:NEW.DATNAS,:NEW.FUNVIS,:NEW.QUAVIS,:NEW.DVADOC,:NEW.PAIDOC,
                                  :NEW.TIPSEX);

          SP_AUDGENREG(l_seqreg,l_verseq,'R090ACO','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀	İ␀␀		SENIOR;0(␀␀

TRIGGER R090ACO_EU AFTER UPDATE ON R090ACO FOR EACH ROW

DECLARE
l_codprm      NUMBER(5);
  l_datval      DATE;
  l_horval      NUMBER(5);
  l_online      BOOLEAN;
  l_data_zero   DATE;
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_andvis           NUMBER(3);

BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
      /* Se mudou a data de saida significa que esta sendo data baixa. */
      l_data_zero  := '31/12/1900,00:00:00';
      SELECT CODPRM,DATVAL,HORVAL,ANDVIS INTO l_codprm,l_datval,l_horval,l_andvis
      FROM R090MVI
      WHERE R090MVI.DATENT = :NEW.DATENT AND
           R090MVI.HORENT = :NEW.HORENT AND
           R090MVI.SEQENT = :NEW.SEQENT;
      IF  :NEW.DATSAI <> l_data_zero THEN
          SP_ATUCON (:NEW.NUMCRA,l_codprm,0,l_data_zero,0,l_data_zero,0,:NEW.DATSAI,:NEW.HORSAI,l_andvis);
      ELSE
          SP_ATUCON (:NEW.NUMCRA,l_codprm,0,l_datval,l_horval,l_data_zero,0,:NEW.DATSAI,:NEW.HORSAI,l_andvis);
      END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090ACO');

  IF (l_auditoria = 'S') THEN

       l_camposAlterados := 'Campo(s) alterado(s): ';
       l_alterou := FALSE;

      IF (:NEW.DATENT <> :OLD.DATENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATENT ';
      END IF;

      IF (:NEW.HORENT <> :OLD.HORENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORENT ';
      END IF;

      IF (:NEW.SEQENT <> :OLD.SEQENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEQENT ';
      END IF;

      IF (:NEW.TIPDOC <> :OLD.TIPDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPDOC ';
      END IF;

      IF (:NEW.NUMDOC <> :OLD.NUMDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMDOC ';
      END IF;

      IF (:NEW.NUMCRA <> :OLD.NUMCRA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCRA ';
      END IF;

      IF (:NEW.DATSLO <> :OLD.DATSLO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATSLO ';
      END IF;

      IF (:NEW.HORSLO <> :OLD.HORSLO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORSLO ';
      END IF;

      IF (:NEW.DATSAI <> :OLD.DATSAI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATSAI ';
      END IF;

      IF (:NEW.HORSAI <> :OLD.HORSAI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORSAI ';
      END IF;

        IF (:NEW.ASSVID <> :OLD.ASSVID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'ASSVID ';
      END IF;

      IF (:NEW.EMICID <> :OLD.EMICID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'EMICID ';
      END IF;

      IF (:NEW.ESTCID <> :OLD.ESTCID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'ESTCID ';
      END IF;

      IF (:NEW.DEXCID <> :OLD.DEXCID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DEXCID ';
      END IF;

      IF (:NEW.CODNAC <> :OLD.CODNAC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODNAC ';
      END IF;

      IF (:NEW.SEGTDO <> :OLD.SEGTDO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEGTDO ';
      END IF;

      IF (:NEW.SEGDOC <> :OLD.SEGDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEGDOC ';
      END IF;

      IF ((:NEW.DATNAS <> :OLD.DATNAS) OR (:OLD.DATNAS IS NULL AND :NEW.DATNAS IS NOT NULL) OR (:NEW.DATNAS IS NULL AND :OLD.DATNAS IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATNAS ';
      END IF;

      IF ((:NEW.TIPSEX <> :OLD.TIPSEX) OR (:OLD.TIPSEX IS NULL AND :NEW.TIPSEX IS NOT NULL) OR (:NEW.TIPSEX IS NULL AND :OLD.TIPSEX IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPSEX ';
      END IF;

      IF ((:NEW.FUNVIS <> :OLD.FUNVIS) OR (:OLD.FUNVIS IS NULL AND :NEW.FUNVIS IS NOT NULL) OR (:NEW.FUNVIS IS NULL AND :OLD.FUNVIS IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'FUNVIS ';
      END IF;

      IF ((:NEW.QUAVIS <> :OLD.QUAVIS) OR (:OLD.QUAVIS IS NULL AND :NEW.QUAVIS IS NOT NULL) OR (:NEW.QUAVIS IS NULL AND :OLD.QUAVIS IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'QUAVIS ';
      END IF;

      IF ((:NEW.DVADOC <> :OLD.DVADOC) OR (:OLD.DVADOC IS NULL AND :NEW.DVADOC IS NOT NULL) OR (:NEW.DVADOC IS NULL AND :OLD.DVADOC IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DVADOC ';
      END IF;

      IF ((:NEW.PAIDOC <> :OLD.PAIDOC) OR (:OLD.PAIDOC IS NULL AND :NEW.PAIDOC IS NOT NULL) OR (:NEW.PAIDOC IS NULL AND :OLD.PAIDOC IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PAIDOC ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R090ACO_AUD
                   WHERE DATENT = :OLD.DATENT AND
                         HORENT = :OLD.HORENT AND
                         SEQENT = :OLD.SEQENT AND
                         TIPDOC = :OLD.TIPDOC AND
                         NUMDOC = :OLD.NUMDOC;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
               INSERT INTO R090ACO_AUD (SEQREG,VERSEQ,DATENT,HORENT,SEQENT,TIPDOC,NUMDOC,NUMCRA,DATSLO,HORSLO,
                                        DATSAI,HORSAI,ASSVID,EMICID,ESTCID,DEXCID,CODNAC,SEGTDO,SEGDOC,DATNAS,
                                        FUNVIS,QUAVIS,DVADOC,PAIDOC,TIPSEX)
                                VALUES (l_seqreg,l_verseq,:NEW.DATENT,:NEW.HORENT,:NEW.SEQENT,:NEW.TIPDOC,
                                       :NEW.NUMDOC,:NEW.NUMCRA,:NEW.DATSLO,:NEW.HORSLO,:NEW.DATSAI,:NEW.HORSAI,
                                       :NEW.ASSVID,:NEW.EMICID,:NEW.ESTCID,:NEW.DEXCID,:NEW.CODNAC,:NEW.SEGTDO,
                                       :NEW.SEGDOC,:NEW.DATNAS,:NEW.FUNVIS,:NEW.QUAVIS,:NEW.DVADOC,:NEW.PAIDOC,
                                       :NEW.TIPSEX);

              SP_AUDGENREG(l_seqreg,l_verseq,'R090ACO',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀İ␀␀		SENIOR;0á	␀␀

TRIGGER R090ACO_ED AFTER DELETE ON R090ACO FOR EACH ROW

DECLARE
l_online       BOOLEAN;
  l_crafis       NUMBER(12);
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       IF   :OLD.NUMCRA > 0 THEN

            /* busca número de crachá fisico caso exista. */
            SP_RETFIS(:OLD.NUMCRA,0, l_crafis OUT);

            /* Apaga Cracha do CONTROLE */
            AtuSitCra('1',l_crafis);

           /* Procedure que atualiza os creditos de acesso.*/
            R090MVI_ATUCRV('D',0,0,0,:OLD.TIPDOC,:OLD.NUMDOC,:OLD.DATENT,:OLD.DATENT,0);
       END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/ 
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090ACO');

  IF (l_auditoria = 'S') THEN
      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg
                FROM R090ACO_AUD
               WHERE DATENT = :OLD.DATENT AND
                     HORENT = :OLD.HORENT AND
                     SEQENT = :OLD.SEQENT AND
                     TIPDOC = :OLD.TIPDOC AND
                     NUMDOC = :OLD.NUMDOC;
           EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
           INSERT INTO R090ACO_AUD (SEQREG,VERSEQ,DATENT,HORENT,SEQENT,TIPDOC,NUMDOC,NUMCRA,DATSLO,HORSLO,
                                    DATSAI,HORSAI,ASSVID,EMICID,ESTCID,DEXCID,CODNAC,SEGTDO,SEGDOC,DATNAS,
                                   FUNVIS,QUAVIS,DVADOC,PAIDOC,TIPSEX)
                            VALUES (l_seqreg,l_verseq,:OLD.DATENT,:OLD.HORENT,:OLD.SEQENT,:OLD.TIPDOC,
                                   :OLD.NUMDOC,:OLD.NUMCRA,:OLD.DATSLO,:OLD.HORSLO,:OLD.DATSAI,:OLD.HORSAI,
                                   :OLD.ASSVID,:OLD.EMICID,:OLD.ESTCID,:OLD.DEXCID,:OLD.CODNAC,:OLD.SEGTDO,
                                   :OLD.SEGDOC,:OLD.DATNAS,:OLD.FUNVIS,:OLD.QUAVIS,:OLD.DVADOC,:OLD.PAIDOC,
                                   :OLD.TIPSEX);

          SP_AUDGENREG(l_seqreg,l_verseq,'R090ACO','DELETE');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀␀␀û␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀İ␀␀ş␀␀¢␀	␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀­%␀‹␀	␀␀␀␀␀␀(&␀|%␀&␀a␀Æÿ␀␀ÿ␀ÈDÑ␀	␀␀␀␀␀␀ËJ“F“FqC␀êÿ␀␀ÿ␀…w·␀	␀␀␀␀␀␀ly+x+xì*␀␀Æÿ␀␀ÿ␀'ı␀␀­␀	␀␀␀␀␀␀£ÿ␀␀Eü␀␀xş␀␀p␀Æÿ␀␀ÿ␀N␀	␀␀␀␀␀␀£␀/␀0␀n␀Æÿ␀␀ÿ␀~¬␀␀(	␀␀␀␀␀␀V±␀␀†^¯␀␀d␀␀␀ÿ␀␀ÿ␀u¬␀␀–␀␀␀␀␀␀␀>±␀␀)8)8n␀Æÿ␀␀ÿ␀›EÑ␀␀␀␀␀␀␀äI;_®HqC␀êÿ␀␀ÿ␀İw·␀␀␀␀␀␀␀6y{{Ïxì*␀␀Æÿ␀␀ÿ␀EÑ␀␀␀␀␀␀␀ŞI­H­HqC␀êÿ␀␀ÿ␀ßw·␀␀␀␀␀␀␀1yÍxÍxì*␀␀Æÿ␀␀ÿ␀`=␀␀␀␀␀␀™˜˜c␀␀␀ÿ␀␀ÿ␀Ua(␀␀␀␀␀␀¶␀␀
