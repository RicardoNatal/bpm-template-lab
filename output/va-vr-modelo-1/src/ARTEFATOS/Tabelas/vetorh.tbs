          IF l_numpro <> 0 THEN
              BEGIN
                  UPDATE R070CON SET SITCRA = l_sitcra WHERE NUMFIS = l_numpro;
              EXCEPTION
                  WHEN OTHERS THEN
                      SP_INTSTR(l_numpro, '999999999999', l_numcra OUT);
                      l_strerr := 'SP_UPDFIS: Erro ao atribuir a situação '
                                               ||p_sitcra 
                                               ||' para o crachá de tecnologia 2 - Proximidade e número físico '
                                               ||l_numcra
                                               ||'.';
                      RAISERROR 103 l_strerr;
              END;
          END IF;
          /*Atualiza o Crachá Smart se exisir*/
          IF l_numsma <> 0 THEN
              BEGIN
                  UPDATE R070CON SET SITCRA = l_sitcra WHERE NUMFIS = l_numsma;
              EXCEPTION
                  WHEN OTHERS THEN
                      SP_INTSTR(l_numsma, '999999999999', l_numcra OUT);
                      l_strerr := 'SP_UPDFIS: Erro ao atribuir a situação '
                                               ||p_sitcra 
                                               ||' para o crachá de tecnologia 3 - Smartcard e número físico '
                                               ||l_numcra
                                               ||'.';
                      RAISERROR 103 l_strerr;
              END;
          END IF;
      END IF;
  /*Atualiza o Campo DatVal*/
  ELSE
      IF (l_tecpri = 0) THEN
              BEGIN
                  UPDATE R070CON SET DATVAL = p_datval WHERE NUMFIS = p_numcra;
              EXCEPTION
                  WHEN OTHERS THEN
                      SP_INTSTR(p_numcra, '999999999999', l_numcra OUT);
                      l_strerr := 'SP_UPDFIS: Erro ao atribuir a data de validade '
                                               ||p_datval 
                                               ||' para o crachá de número lógico '
                                               ||l_numcra
                                               ||'.';
                      RAISERROR 103 l_strerr;
              END;
      ELSE
          /*Atualiza o Crachá de Barras se exisir*/
          IF l_numbar <> 0 THEN
              BEGIN
                  UPDATE R070CON SET DATVAL = p_datval WHERE NUMFIS = l_numbar;
              EXCEPTION
                  WHEN OTHERS THEN
                      SP_INTSTR(l_numbar, '999999999999', l_numcra OUT);
                      l_strerr := 'SP_UPDFIS: Erro ao atribuir a data de validade '
