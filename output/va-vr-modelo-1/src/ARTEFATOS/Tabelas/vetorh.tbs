			l_Alterou := TRUE;
			SP_CONCAT_FLO_JSON('VLRANC', :NEW.VLRANC, :OLD.VLRANC, 2, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_NUM(:OLD.VLRANT, :NEW.VLRANT, l_Valido OUT);
