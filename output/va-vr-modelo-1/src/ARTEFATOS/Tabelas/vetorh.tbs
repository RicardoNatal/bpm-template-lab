DECLARE
l_xUtiPos CHAR;
  l_xEstPos NUMBER(3);
  l_xCodPlv NUMBER(4);
BEGIN
  /* Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
  QL_UTIPOSTRA(:NEW.NUMEMP, :NEW.DATSVA, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
  IF (l_xUtiPos = 'S') THEN
    QL_PROCESVA('I', :NEW.NUMEMP, l_xEstPos, l_xCodPlv, :NEW.POSTRA, :NEW.QTDVAG, :NEW.SITSVA, :NEW.DATSVA, :NEW.CODTAP, 'N', 'N', 'N');
  END IF;
END␀<á␀␀		SENIOR;0¢␀␀

TRIGGER R126SVA_EU AFTER UPDATE ON R126SVA FOR EACH ROW

DECLARE
l_xUtiPos CHAR;
  l_xEstPos NUMBER(3);
  l_xCodPlv NUMBER(4);
  l_xMsg    VARCHAR2(100);
  l_xDatDif CHAR;
  l_xVagDif CHAR;
  l_xSit33 CHAR;
BEGIN
  /* SITSVA
    1 - Em definição - Nada
    2 - Em aprovação - Soma
    3 - Solicitação de alteração - Subtrai
    4 - Aprovada - Subtrai
    5 - Rejeitada - Subtrai
    6 - Cancelada - Subtrai
  Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
  QL_UTIPOSTRA(:NEW.NUMEMP, :NEW.DATSVA, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
  IF (l_xUtiPos = 'S') THEN
  
    IF (:NEW.DATSVA <> :OLD.DATSVA) THEN
      l_xDatDif := 'S';
    ELSE
      l_xDatDif := 'N';
    END IF;  
      
    IF (:NEW.QTDVAG <> :OLD.QTDVAG) THEN
      l_xVagDif := 'S';
    ELSE
      l_xVagDif := 'N';
    END IF;  
      
    IF ((:NEW.SITSVA = 3) AND (:OLD.SITSVA = 3)) THEN
      l_xSit33 := 'S';
    ELSE
      l_xSit33 := 'N';  
    END IF;  
  
    /* Apenas dispara a trigger caso SITSVA 2 para 1,3,4,5,6 ou vice versa */
    IF ( (:NEW.DATSVA <> :OLD.DATSVA)
      OR ((:NEW.SITSVA = 2) AND (:OLD.SITSVA IN(1,3,4,5,6)))
      OR ((:OLD.SITSVA = 2) AND (:NEW.SITSVA IN(1,3,4,5,6))) ) THEN
      QL_PROCESVA('U', :NEW.NUMEMP, l_xEstPos, l_xCodPlv, :NEW.POSTRA, :NEW.QTDVAG, :NEW.SITSVA, :NEW.DATSVA, :NEW.CODTAP, l_xDatDif, l_xVagDif, l_xSit33);
    END IF;
  END IF;
END␀:á␀␀		SENIOR;0$␀␀

TRIGGER R126SVA_ED AFTER DELETE ON R126SVA FOR EACH ROW

DECLARE
l_xUtiPos CHAR;
  l_xEstPos NUMBER(3);
  l_xCodPlv NUMBER(4);
BEGIN
  /* SITSVA
    1 - Em definição - Nada
    2 - Em aprovação - Soma
    3 - Solicitação de alteração - Subtrai
    4 - Aprovada - Subtrai
    5 - Rejeitada - Subtrai
    6 - Cancelada - Subtrai
    Credita coluna "QTDSOL" somente quando "Em Definição" */
  IF (:OLD.SITSVA = 2) THEN
    /* Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
    QL_UTIPOSTRA(:OLD.NUMEMP, :OLD.DATSVA, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
    IF (l_xUtiPos = 'S') THEN
      QL_PROCESVA('D', :OLD.NUMEMP, l_xEstPos, l_xCodPlv, :OLD.POSTRA, :OLD.QTDVAG, :OLD.SITSVA, :OLD.DATSVA, :OLD.CODTAP, 'N', 'N', 'N');
    END IF;
  END IF;
