									:NEW.ROTTOM,:NEW.VALCAP,:NEW.TIPSIJ,:NEW.ALIRED,:NEW.HISCON,:NEW.ADMPER,:NEW.CODIDN,:NEW.HISPEN,:NEW.CODDGH,
									:NEW.BAIFGT,:NEW.SELCEN,:NEW.PASPRV,:NEW.GERVOC,:NEW.ENTCAS,:NEW.CLCSAI,:NEW.BAIPIS,:NEW.CONSIT,:NEW.MODINF,
									:NEW.MODP41,:NEW.ABRCEN,:NEW.INTDEM,:NEW.VINPES,:NEW.VINPE2,:NEW.VINPE3,:NEW.VIPEDE,:NEW.DIFIMP,:NEW.USAPEM,
