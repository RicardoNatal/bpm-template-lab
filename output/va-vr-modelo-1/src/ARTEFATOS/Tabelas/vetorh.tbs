  END IF;

  IF (:NEW.SEQNIV <> :OLD.SEQNIV) THEN
      SP_INTSTR(:NEW.SEQNIV, '999999', l_seqniv OUT);
  ELSE
      SP_INTSTR(:OLD.SEQNIV, '999999', l_seqniv OUT);
  END IF;

  IF  (l_datafa = '                ') OR (l_datafa = '')THEN
      l_datafa := '0000000000000000';
  END IF;

  IF  (l_datafa <> '0000000000000000') THEN
      l_iniafa := :NEW.INIAFA;
  ELSE
      l_iniafa := '0000000000000000';
  END IF;

  IF  ((:NEW.MSGACC <> :OLD.MSGACC) OR (:NEW.MSGACC IS NULL) OR (:OLD.MSGACC IS NULL)) THEN
      l_msgacc := :NEW.MSGACC;
  ELSE
      l_msgacc := :OLD.MSGACC;
  END IF;

  IF  (:NEW.DATMSG <> :OLD.DATMSG) THEN
      l_datmsg := :NEW.DATMSG;
  ELSE
      l_datmsg := :OLD.DATMSG;
  END IF;

  IF  (l_datmsg = '                ') OR (l_datmsg = '')THEN
      l_datmsg := '0000000000000000';
  END IF;

  IF  (:NEW.DATVAL <> :OLD.DATVAL) THEN
      l_datval := :NEW.DATVAL;
  ELSE
      l_datval := :OLD.DATVAL;
  END IF;

  IF (:NEW.INIVAL <> :OLD.INIVAL) THEN
