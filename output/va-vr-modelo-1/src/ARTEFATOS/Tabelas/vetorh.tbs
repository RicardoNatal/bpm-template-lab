Ê

PROCEDURE SP_RETFIS(P_NUMCRA NUMBER(12),P_TECCRA NUMBER(1),P_NUMFIS OUT NUMBER(12))
 IS
BEGIN
  /*Manter compatibilidade com as triggers para os TBS's abaixo de 20*/
  p_numfis := p_numcra;
END		SENIOR;20
å	␀␀PROCEDURE SP_RETFIS(P_NUMCRA NUMBER(12),P_TECCRA NUMBER(1),P_NUMFIS OUT NUMBER(12))
 IS

 l_numfis NUMBER(12);
 l_teccra NUMBER(1);
BEGIN
   /* Busca o numero fisico correspondente. */
   l_teccra := p_teccra;

   /* se possui teccra verifica registro correspondente na r069fis */
   IF  p_teccra <> 0 THEN
      BEGIN
          SELECT NUMFIS INTO l_numfis
          FROM R069FIS A
          WHERE A.NUMCRA = p_numcra
          AND   A.TECCRA = p_teccra
          AND   A.DATALT = (SELECT MAX(DATALT) FROM R069FIS B WHERE B.NUMCRA = A.NUMCRA AND B.TECCRA = A.TECCRA)
          AND   A.HORINI = (SELECT MAX(HORINI) FROM R069FIS C WHERE C.NUMCRA = A.NUMCRA AND C.TECCRA = A.TECCRA AND C.DATALT = A.DATALT);
      EXCEPTION
          WHEN NO_DATA_FOUND THEN
              l_numfis := p_numcra;
          WHEN OTHERS THEN
              RAISERROR 103 'SP_RetFis. Erro ao buscar o número físico do crachá (R069FIS) com base na tecnologia de crachá informada.';
      END;
   ELSE
      /* no caso de só existir 1 registro */
      BEGIN
          SELECT TECCRA, NUMFIS INTO l_teccra, l_numfis
          FROM R069FIS A
          WHERE A.NUMCRA = p_numcra
          AND   A.DATALT = (SELECT MAX(DATALT) FROM R069FIS B WHERE B.NUMCRA = A.NUMCRA)
          AND   A.HORINI = (SELECT MAX(HORINI) FROM R069FIS C WHERE C.NUMCRA = A.NUMCRA AND C.DATALT = A.DATALT);
      EXCEPTION
          WHEN TOO_MANY_ROWS THEN
              BEGIN
                  SELECT TECCRA, NUMFIS INTO l_teccra, l_numfis
                  FROM R069FIS A
                  WHERE A.NUMCRA = p_numcra
                  AND A.DATALT   = (SELECT MAX(DATALT) FROM R069FIS B WHERE B.NUMCRA = A.NUMCRA)
                  AND A.HORINI   = (SELECT MAX(HORINI) FROM R069FIS C WHERE C.NUMCRA = A.NUMCRA AND C.DATALT = A.DATALT)
                  AND A.TECCRA   = (SELECT MIN(TECCRA) FROM R069FIS D WHERE D.NUMCRA = A.NUMCRA AND D.DATALT = A.DATALT AND D.HORINI = A.HORINI);
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'SP_RetFis. Verifique pré cadastro de crachá (R069fis).';
              END;
          WHEN NO_DATA_FOUND THEN
              l_numfis := p_numcra;
          WHEN OTHERS THEN
              RAISERROR 103 'SP_RetFis. Erro ao buscar o número físico do crachá (R069FIS) sem informar tecnologia de crachá.';
      END;
   END IF;

   /* para teccra = 3 smart o crachá tem que ser o icard*/
   IF  l_teccra = 3 THEN
      l_numfis := p_numcra;
   END IF;

   p_numfis := l_numfis;
END		SENIOR;21
