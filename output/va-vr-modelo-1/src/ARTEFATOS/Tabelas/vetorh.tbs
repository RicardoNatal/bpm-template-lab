DECLARE
  l_Valor VARCHAR2(2000);
  l_DataAlteracao DATE;
  l_layout VARCHAR2(6);
  l_gerarPendencia BOOLEAN;    
BEGIN
  IF (:NEW.StaFec = 1) THEN
    l_gerarPendencia := TRUE;
    l_DataAlteracao := CURDATE();
    RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
    IF (l_layout IS NOT NULL) THEN
      N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
      IF (l_gerarPendencia = TRUE) THEN
        IF (l_layout = 'S-2300') THEN
          l_layout := 'S-2399';
        ELSE
          l_layout := 'S-2299';
        END IF;
        
        l_Valor := '';
	    SP_CONCATENAR_DAT('DATAFA', :NEW.DATAFA, l_Valor OUT);
        SP_E_SOCIAL(l_layout, 'R042FDE', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, l_DataAlteracao, 0, 'R042FDE_EI');
      END IF;
    END IF;
  END IF;
END␀¹Õ␀␀		SENIOR;0Ï␀␀

TRIGGER R042FDE_EU AFTER UPDATE ON R042FDE FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);
  l_DataAlteracao DATE;
  l_layout VARCHAR2(6);
  l_gerarPendencia BOOLEAN;   
BEGIN
  IF (:NEW.StaFec = 1) AND (:OLD.StaFec = 2) AND (:NEW.GerPen <> 'N') THEN
    l_gerarPendencia := TRUE;
    l_DataAlteracao := CURDATE();
    RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
    IF (l_layout IS NOT NULL) THEN
      N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
      IF (l_gerarPendencia = TRUE) THEN      
        IF (l_layout = 'S-2300') THEN
          l_layout := 'S-2399';
        ELSE
          l_layout := 'S-2299';
        END IF;
        
        l_Valor := '';
	    SP_CONCATENAR_DAT('DATAFA', :NEW.DATAFA, l_Valor OUT);
        SP_E_SOCIAL(l_layout, 'R042FDE', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, l_DataAlteracao, 0, 'R042FDE_EU');
      END IF;
    END IF;
  END IF;
END␀·Õ␀␀		SENIOR;0r␀␀

TRIGGER R042FDE_AD AFTER DELETE ON R042FDE FOR EACH ROW
DECLARE
  l_Valor VARCHAR2(2000);
  l_DataAlteracao DATE;
  l_layout VARCHAR2(6);  
  l_gerarPendencia BOOLEAN;    
BEGIN
  l_gerarPendencia := TRUE;
  RH_LAYOUTCOLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layout OUT);
  IF (l_layout IS NOT NULL) THEN
    N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    IF (l_gerarPendencia = TRUE) THEN
      IF (l_layout = 'S-2300') THEN
        l_layout := 'S-2399';
      ELSE
        l_layout := 'S-2299';
      END IF;
      
      l_Valor := '';
      SP_CONCATENAR_DES('LAYOUT', l_layout, l_Valor OUT);
      SP_CONCATENAR_DAT('DATAFA', :OLD.DATAFA, l_Valor OUT);
      
      SP_E_SOCIAL('S-3000', 'R042FDE', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0, NULL, :OLD.DATAFA, 0, 'R042FDE_AD');
