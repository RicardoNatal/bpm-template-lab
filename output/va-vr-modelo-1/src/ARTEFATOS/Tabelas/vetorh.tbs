			SP_E_SOCIAL('S-2410', 'R347BEI', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DatIni, 0, 'R347BEI_EU');
		END IF;
		
		IF (l_AlterouChave = TRUE) THEN
		    l_Valor := '';
			SP_CONCATENAR_DES('LAYOUT', 'S-2410', l_Valor OUT);
			SP_CONCATENAR_DES('NROBEN', :OLD.NroBen, l_Valor OUT);
			SP_CONCATENAR_NUM('SEQBEN', :OLD.SeqBei, l_Valor OUT);
