TRIGGER R070CON_EI AFTER INSERT ON R070CON FOR EACH ROW
DECLARE
  l_data_atual         DATE;
  l_hora_atual         NUMBER(4);
  l_seqenv             NUMBER(2);
  l_datval             DATE;
  l_datatu             DATE;
  l_enviar             BOOLEAN;
  l_datstr             CHAR(6);
  l_horstr             CHAR(4);
  l_seqstr             CHAR(2);
  l_datenv             CHAR(16);
  l_tipcol             CHAR(1);
  l_idtpesAux          CHAR(23);
  l_idtPes_trim        VARCHAR2(23);
  l_icard              CHAR(12);
  l_crapro             NUMBER(12);
  l_numemp             NUMBER(4);
  l_tipcol_int         NUMBER(1);
  l_numcad             NUMBER(10);
  /*Consistência do campo nome*/
  l_NomFunOriginal     VARCHAR2(40);
  l_NomFunConvertido   VARCHAR2(40);
  l_Nome               VARCHAR2(40);
  l_dat_conv           VARCHAR(25); /*Variável auxiliar para conversão de data*/
  l_propre             NUMBER(1);
  l_altbio             NUMBER(1);
  l_Straux             VARCHAR2(2047);
  l_numfis             CHAR(12);
  l_CenPen             VARCHAR2(255);
  l_numcpf             NUMBER(11); /* Variável para simplificar as operações com cpf. Quando o tipo de documento for diferente de 2, é zerada */
  l_fakepis            NUMBER(12); /* Utilizado para envio p/ tabela REPEMPR002 */
BEGIN
  IF (:NEW.NUMCRA = 0) THEN
      RAISERROR 103 'Não é permitido inserir número de crachá com valor zero.';
  END IF;

  IF (:NEW.NUMFIS = 0) THEN
      RAISERROR 103 'Não é permitido inserir número físico com valor zero.';
  END IF;

  /*Inicializações*/
  l_altbio        := 0; /* 0: Não altera biometria - 1: altera biometria - 2: excluir biometria */
  
  IF (:NEW.TIPDOC = 2) THEN
      l_numcpf := :NEW.NUMDOC;
  ELSE
      l_numcpf := 0;
  END IF;

  /* Busca parametro que indica se utiliza "Processamento prévio da tabela Controle" */
  l_propre := 0;
  IF :NEW.ProPre IS NULL THEN
      l_propre := 0;
  ELSE
      l_propre := :NEW.ProPre;
  END IF;

  /*Obtem a data/hora de envio da pendência.*/
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
  /*Obtem o Segundo*/
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

  /*Se for colaborador exceto crachá de autorização de entrada e mestre*/

  /*CONVERTE CARACTERE EM DATA*/
  l_dat_conv := SUBSTRING(:NEW.DATVAL,1,2) || '/' || SUBSTRING(:NEW.DATVAL,3,2) ||'/'||SUBSTRING(:NEW.DATVAL,5,2)||' '||
                                                     SUBSTRING(:NEW.DATVAL,7,2)||':'||SUBSTRING(:NEW.DATVAL,9,2)||':00';
  SP_STRTODATE(l_dat_conv, 'DD/MM/AA HH:MI:SS', l_datval OUT);
  l_dat_conv := SUBSTRING(l_datstr,1,2) || '/' || SUBSTRING(l_datstr,3,2) ||'/'||SUBSTRING(l_datstr,5,2)||' '||
                                                  SUBSTRING(l_horstr,1,2)||':'||SUBSTRING(l_horstr,3,2)||':00';
  SP_STRTODATE(l_dat_conv, 'DD/MM/AA HH:MI:SS', l_datatu OUT);

  /*Deletar um número físico, chama SP_R070ACR passando F, para exclusão normal*/
  l_enviar := TRUE;
  IF (l_datval <= l_datatu AND :NEW.DATVAL <> '3112502359000000') THEN
    l_enviar := FALSE;
  END IF;

  IF ((l_enviar = TRUE) AND (((:NEW.NUMPIS > 0) OR (l_numcpf > 0)) AND (:NEW.TIPCRA = 1))) THEN
    l_idtpes_trim :=  LTrim(RTrim(:NEW.IDTPES));
    l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes_trim,3,4));
    l_tipcol_int := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes_trim,7,1));
    l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes_trim,8,9));
    SP_RETCRA(2, l_numemp, l_tipcol_int, l_numcad, 0, '', 0, '', l_crapro OUT);
    IF (l_crapro > 0) THEN
      l_enviar := FALSE;
    END IF;
  END IF;

  IF (((:NEW.NUMPIS > 0) OR (l_numcpf > 0)) AND ((:NEW.TIPCRA = 1) OR (:NEW.TIPCRA = 2) OR (:NEW.TIPCRA = 6)) AND ((l_enviar = TRUE))) THEN

      /* retira os acentos e caracteres especiais do nome e atualiza RepEmpr002*/
      l_NomFunOriginal := UPPER(:NEW.NOMFUN);
      SP_STRTOSTR(l_NomFunOriginal, l_NomFunConvertido OUT);

      IF (:NEW.NUMPIS > 0) THEN
        SP_REPEMPR002_CPF(:NEW.NUMCRA, l_numcpf, :NEW.NUMPIS, l_NomFunConvertido);
        SP_REPEMPR002_CPF(:NEW.NUMFIS, l_numcpf, :NEW.NUMPIS, l_NomFunConvertido);
      ELSE
        SP_GETPISFROMCPF(l_numcpf, l_fakepis OUT);
        SP_REPEMPR002_CPF(:NEW.NUMCRA, l_numcpf, l_fakepis, l_NomFunConvertido);
        SP_REPEMPR002_CPF(:NEW.NUMFIS, l_numcpf, l_fakepis, l_NomFunConvertido);
      END IF;

      /* Parâmetro I para inclusão normal na R070ACR */
      IF (:NEW.USABIO > 1) THEN
        SP_R070ACR('A', :NEW.NUMCRA, :NEW.NUMFIS, :NEW.TECCRA, :NEW.VERPRM,
                        0, :NEW.CODPRM, :NEW.PRMSAB, :NEW.PRMDOM, :NEW.PRMFER,
                        :NEW.PRMRT1, :NEW.PRMRT2, :NEW.PRMRT3,
                        0, 0, 0, 0, 0, 0, 0,
                        l_datenv, :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis,1,0,0, l_numcpf);

        SP_R070ACR('H', :NEW.NUMCRA, :NEW.NUMFIS, :NEW.TECCRA, :NEW.VERPRM,
                        0, :NEW.CODPRM, :NEW.PRMSAB, :NEW.PRMDOM, :NEW.PRMFER,
                        :NEW.PRMRT1, :NEW.PRMRT2, :NEW.PRMRT3,
                        0, 0, 0, 0, 0, 0, 0,
                        l_datenv, :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis,0,0,0, l_numcpf);
      ELSE
        SP_R070ACR('I', :NEW.NUMCRA, :NEW.NUMFIS, :NEW.TECCRA, :NEW.VERPRM,
                        0, :NEW.CODPRM, :NEW.PRMSAB, :NEW.PRMDOM, :NEW.PRMFER,
                        :NEW.PRMRT1, :NEW.PRMRT2, :NEW.PRMRT3,
                        0, 0, 0, 0, 0, 0, 0,
                        l_datenv, :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis,0,0,0, l_numcpf);
      END IF;
  END IF;

  IF (:NEW.USABIO > 1) THEN
    l_altbio := 1;
  END IF;

  IF (l_enviar = TRUE) THEN
    SP_PEND62('I', :NEW.NUMCRA, :NEW.NUMFIS, :NEW.TECCRA, :NEW.VERPRM,
                   :NEW.CODPRM, :NEW.PRMSAB, :NEW.PRMDOM, :NEW.PRMFER,
                   :NEW.PRMRT1, :NEW.PRMRT2, :NEW.PRMRT3, :NEW.DATVAL,
                   :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis, l_altbio, l_numcpf);

    SP_PENDAce62('I', :NEW.NUMCRA, :NEW.NUMFIS, :NEW.TECCRA, :NEW.VERPRM,
                      :NEW.CODPRM, :NEW.PRMSAB, :NEW.PRMDOM, :NEW.PRMFER,
                      :NEW.PRMRT1, :NEW.PRMRT2, :NEW.PRMRT3, :NEW.DATVAL,
                      :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis, l_altbio, :NEW.TipCra,
                      0, 0, 0, 0,
                      0, 0, 0, l_numcpf);
  END IF;

  /*INICIO*/
  /*Chama a SP_AtuCpfTsi para atualizar o CPF na tabela CONTCPF da Telemática*/
  /*Pega o icard usando o número físico*/
  SP_INTSTR(:NEW.NUMFIS, '999999999999', l_icard OUT);

  /*Caso for SmartCard, pega o icard usando o crachá principal se tiver. Se não tiver crachá principal, usa o número do crachá*/
  IF (:NEW.TECCRA = 3) THEN
      IF (:NEW.CHCPRI <> 0) THEN
          SP_INTSTR(:NEW.CHCPRI, '999999999999', l_icard OUT);
      ELSE
          SP_INTSTR(:NEW.NUMCRA, '999999999999', l_icard OUT);
      END IF;
  END IF;

  /*Chama a procedure que atualiza a CONTCPF*/
  SP_ATUCPFTSI(l_icard, :NEW.TIPDOC, :NEW.NUMDOC);

  /* Sem processamento prévio (PEND93) */
  IF (l_propre = 0) THEN
      /* atualiza a pendência 60 para carga dos dados da pessoa */
      IF  (:NEW.NOMPES = '') OR (:NEW.NOMPES IS NULL) THEN
          l_nome := :NEW.NOMFUN;
      ELSE
          l_nome := :NEW.NOMPES;
      END IF;
      SP_PEND60(:NEW.IDTPES, l_nome, :NEW.NUMPIS, :NEW.DDIFON, :NEW.DDDFON, :NEW.NUMFON, :NEW.PESBLO, :NEW.DESBLO);
  END IF;

  l_CenPen := '0';

  SP_INTSTR(:NEW.NUMFIS,'999999999999',l_numfis OUT);

  l_Straux := '09'||l_datenv||l_numfis||:NEW.INIVAL||:NEW.DATVAL;
  SP_PorCom(l_straux, l_CenPen);

  /*FIM*/
END		SENIOR;21è␀␀

TRIGGER R070CON_EI AFTER INSERT ON R070CON FOR EACH ROW
DECLARE
  l_data_atual         DATE;
  l_hora_atual         NUMBER(4);
  l_seqenv             NUMBER(2);
  l_datval             DATE;
  l_datatu             DATE;
  l_enviar             BOOLEAN;
  l_datstr             CHAR(6);
  l_horstr             CHAR(4);
  l_seqstr             CHAR(2);
  l_datenv             CHAR(16);
  l_tipcol             CHAR(1);
  l_idtpesAux          CHAR(23);
  l_idtPes_trim        VARCHAR2(23);
  l_icard              CHAR(12);
  l_crapro             NUMBER(12);
  l_numemp             NUMBER(4);
  l_tipcol_int         NUMBER(1);
  l_numcad             NUMBER(10);
  /*Consistência do campo nome*/
  l_NomFunOriginal     VARCHAR2(40);
  l_NomFunConvertido   VARCHAR2(40);
  l_Nome               VARCHAR2(40);
  l_dat_conv           VARCHAR(25); /*Variável auxiliar para conversão de data*/
  l_propre             NUMBER(1);
  l_altbio             NUMBER(1);
  l_Straux             VARCHAR2(2047);
  l_numfis             CHAR(12);
  l_CenPen             VARCHAR2(255);
  l_numcpf             NUMBER(11); /* Variável para simplificar as operações com cpf. Quando o tipo de documento for diferente de 2, é zerada */
  l_fakepis            NUMBER(12); /* Utilizado para envio p/ tabela REPEMPR002 */
BEGIN
  IF (:NEW.NUMCRA = 0) THEN
      RAISERROR 103 'Não é permitido inserir número de crachá com valor zero.';
  END IF;

  IF (:NEW.NUMFIS = 0) THEN
      RAISERROR 103 'Não é permitido inserir número físico com valor zero.';
  END IF;

  /*Inicializações*/
  l_altbio        := 0; /* 0: Não altera biometria - 1: altera biometria - 2: excluir biometria */
  
  IF (:NEW.TIPDOC = 2) THEN
      l_numcpf := :NEW.NUMDOC;
  ELSE
      l_numcpf := 0;
  END IF;

  /* Busca parametro que indica se utiliza "Processamento prévio da tabela Controle" */
  l_propre := 0;
  IF :NEW.ProPre IS NULL THEN
      l_propre := 0;
  ELSE
      l_propre := :NEW.ProPre;
  END IF;

  /*Obtem a data/hora de envio da pendência.*/
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
  /*Obtem o Segundo*/
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

  /*Se for colaborador exceto crachá de autorização de entrada e mestre*/

  /*CONVERTE CARACTERE EM DATA*/
  l_dat_conv := SUBSTRING(:NEW.DATVAL,1,2) || '/' || SUBSTRING(:NEW.DATVAL,3,2) ||'/'||SUBSTRING(:NEW.DATVAL,5,2)||' '||
                                                     SUBSTRING(:NEW.DATVAL,7,2)||':'||SUBSTRING(:NEW.DATVAL,9,2)||':00';
  SP_STRTODATE(l_dat_conv, 'DD/MM/AA HH:MI:SS', l_datval OUT);
  l_dat_conv := SUBSTRING(l_datstr,1,2) || '/' || SUBSTRING(l_datstr,3,2) ||'/'||SUBSTRING(l_datstr,5,2)||' '||
                                                  SUBSTRING(l_horstr,1,2)||':'||SUBSTRING(l_horstr,3,2)||':00';
  SP_STRTODATE(l_dat_conv, 'DD/MM/AA HH:MI:SS', l_datatu OUT);

  /*Deletar um número físico, chama SP_R070ACR passando F, para exclusão normal*/
  l_enviar := TRUE;
  IF (l_datval <= l_datatu AND :NEW.DATVAL <> '3112502359000000') THEN
    l_enviar := FALSE;
  END IF;

  IF ((l_enviar = TRUE) AND (((:NEW.NUMPIS > 0) OR (l_numcpf > 0)) AND (:NEW.TIPCRA = 1))) THEN
    l_idtpes_trim :=  LTrim(RTrim(:NEW.IDTPES));
    l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes_trim,3,4));
    l_tipcol_int := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes_trim,7,1));
    l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes_trim,8,9));
    SP_RETCRA(2, l_numemp, l_tipcol_int, l_numcad, 0, '', 0, '', l_crapro OUT);
    IF (l_crapro > 0) THEN
      l_enviar := FALSE;
    END IF;
  END IF;

  IF (((:NEW.NUMPIS > 0) OR (l_numcpf > 0)) AND ((:NEW.TIPCRA = 1) OR (:NEW.TIPCRA = 2) OR (:NEW.TIPCRA = 6)) AND ((l_enviar = TRUE))) THEN

      /* retira os acentos e caracteres especiais do nome e atualiza RepEmpr002*/
      l_NomFunOriginal := UPPER(:NEW.NOMFUN);
      SP_STRTOSTR(l_NomFunOriginal, l_NomFunConvertido OUT);

      IF (:NEW.NUMPIS > 0) THEN
        SP_REPEMPR002_CPF(:NEW.NUMCRA, l_numcpf, :NEW.NUMPIS, l_NomFunConvertido);
        SP_REPEMPR002_CPF(:NEW.NUMFIS, l_numcpf, :NEW.NUMPIS, l_NomFunConvertido);
      ELSE
        SP_GETPISFROMCPF(l_numcpf, l_fakepis OUT);
        SP_REPEMPR002_CPF(:NEW.NUMCRA, l_numcpf, l_fakepis, l_NomFunConvertido);
        SP_REPEMPR002_CPF(:NEW.NUMFIS, l_numcpf, l_fakepis, l_NomFunConvertido);
      END IF;

      /* Parâmetro I para inclusão normal na R070ACR */
      IF (:NEW.USABIO > 1) THEN
        SP_R070ACR('A', :NEW.NUMCRA, :NEW.NUMFIS, :NEW.TECCRA, :NEW.VERPRM,
                        0, :NEW.CODPRM, :NEW.PRMSAB, :NEW.PRMDOM, :NEW.PRMFER,
                        :NEW.PRMRT1, :NEW.PRMRT2, :NEW.PRMRT3,
                        0, 0, 0, 0, 0, 0, 0,
                        l_datenv, :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis,1,0,0, l_numcpf);

        SP_R070ACR('H', :NEW.NUMCRA, :NEW.NUMFIS, :NEW.TECCRA, :NEW.VERPRM,
                        0, :NEW.CODPRM, :NEW.PRMSAB, :NEW.PRMDOM, :NEW.PRMFER,
                        :NEW.PRMRT1, :NEW.PRMRT2, :NEW.PRMRT3,
                        0, 0, 0, 0, 0, 0, 0,
                        l_datenv, :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis,0,0,0, l_numcpf);
      ELSE
        SP_R070ACR('I', :NEW.NUMCRA, :NEW.NUMFIS, :NEW.TECCRA, :NEW.VERPRM,
                        0, :NEW.CODPRM, :NEW.PRMSAB, :NEW.PRMDOM, :NEW.PRMFER,
                        :NEW.PRMRT1, :NEW.PRMRT2, :NEW.PRMRT3,
                        0, 0, 0, 0, 0, 0, 0,
                        l_datenv, :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis,0,0,0, l_numcpf);
      END IF;
  END IF;

  IF (:NEW.USABIO > 1) THEN
    l_altbio := 1;
  END IF;

  IF (l_enviar = TRUE) THEN
    SP_PEND62('I', :NEW.NUMCRA, :NEW.NUMFIS, :NEW.TECCRA, :NEW.VERPRM,
                   :NEW.CODPRM, :NEW.PRMSAB, :NEW.PRMDOM, :NEW.PRMFER,
                   :NEW.PRMRT1, :NEW.PRMRT2, :NEW.PRMRT3, :NEW.DATVAL,
                   :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis, l_altbio, l_numcpf);

    SP_PENDAce62('I', :NEW.NUMCRA, :NEW.NUMFIS, :NEW.TECCRA, :NEW.VERPRM,
                      :NEW.CODPRM, :NEW.PRMSAB, :NEW.PRMDOM, :NEW.PRMFER,
                      :NEW.PRMRT1, :NEW.PRMRT2, :NEW.PRMRT3, :NEW.DATVAL,
                      :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis, l_altbio, :NEW.TipCra,
                      0, 0, 0, 0,
                      0, 0, 0, l_numcpf);
  END IF;

  /*INICIO*/
  /*Chama a SP_AtuCpfTsi para atualizar o CPF na tabela CONTCPF da Telemática*/
  /*Pega o icard usando o número físico*/
  SP_INTSTR(:NEW.NUMFIS, '999999999999', l_icard OUT);

  /*Caso for SmartCard, pega o icard usando o crachá principal se tiver. Se não tiver crachá principal, usa o número do crachá*/
  IF (:NEW.TECCRA = 3) THEN
      IF (:NEW.CHCPRI <> 0) THEN
          SP_INTSTR(:NEW.CHCPRI, '999999999999', l_icard OUT);
      ELSE
          SP_INTSTR(:NEW.NUMCRA, '999999999999', l_icard OUT);
      END IF;
  END IF;

  /*Chama a procedure que atualiza a CONTCPF*/
  SP_ATUCPFTSI(l_icard, :NEW.TIPDOC, :NEW.NUMDOC);

  /* Sem processamento prévio (PEND93) */
  IF (l_propre = 0) THEN
      /* atualiza a pendência 60 para carga dos dados da pessoa */
      IF  (:NEW.NOMPES = '') OR (:NEW.NOMPES IS NULL) THEN
          l_nome := :NEW.NOMFUN;
      ELSE
          l_nome := :NEW.NOMPES;
      END IF;
      SP_PEND60(:NEW.IDTPES, l_nome, :NEW.NUMPIS, :NEW.DDIFON, :NEW.DDDFON, :NEW.NUMFON, :NEW.PESBLO, :NEW.DESBLO);
  END IF;

  l_CenPen := '0';

  SP_INTSTR(:NEW.NUMFIS,'999999999999',l_numfis OUT);

  l_Straux := '09'||l_datenv||l_numfis||:NEW.INIVAL||:NEW.DATVAL;
  SP_PorCom(l_straux, l_CenPen);

  /*FIM*/
END		SENIOR;22è␀␀

TRIGGER R070CON_EI AFTER INSERT ON R070CON FOR EACH ROW
DECLARE
  l_data_atual         DATE;
