        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSITATD', CONVERT(NUMBER_TO_CHAR,:OLD.SITATD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSITATD', CONVERT(NUMBER_TO_CHAR,:NEW.SITATD));
