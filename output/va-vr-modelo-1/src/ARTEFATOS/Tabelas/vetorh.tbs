m␀␀create or replace PROCEDURE SP_CMDTSI(p_cmdstr IN VARCHAR2) IS
  l_strerr VARCHAR2(3072);
begin
  begin
    EXECUTE IMMEDIATE(p_cmdstr);
  exception
    when OTHERS then
      l_strerr := '. Comando a ser executado:'||p_cmdstr||'.';
      raise_application_error(-20000 + -(103),'Erro ao executar procedure SP_CMDTSI:'||SQLERRM||l_strerr);
  end;
end;

	MSSQL;23
¸␀␀CREATE  PROCEDURE SP_CMDTSI(@p_cmdstr VARCHAR(2048)) AS
BEGIN
DECLARE @l_strerr VARCHAR(3072)
DECLARE @ChkError INTEGER
DECLARE @SE_EXC1 INTEGER
  SELECT @ChkError = 0
  /* TRY */
       EXECUTE (@p_cmdstr);
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC1:
    SELECT @SE_EXC1 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        SELECT @l_strerr = 'Erro ao executar procedure SP_CMDTSI. Comando:'+@p_cmdstr+'. '
        BEGIN
          RAISERROR(@l_strerr,11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
FIM:
  RETURN @ChkError
END

