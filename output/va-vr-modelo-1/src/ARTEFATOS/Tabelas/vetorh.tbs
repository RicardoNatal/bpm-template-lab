k␀␀PROCEDURE SM_PEN_RESP_PPRA(P_CODPRA NUMBER, P_OPERACAO CHAR, P_DATINI DATE, P_DATTER DATE, P_ORIGEM VARCHAR2(12), P_JSONALTERACOES VARCHAR2(2000))
 IS

	l_DataZero DATE;
	l_DataMax DATE;
	l_DatIniSST DATE;
	l_DataInicio DATE;
	l_DataTermino DATE;
	l_DatIniFil DATE;
	l_DatTerFil DATE;
	l_NumEmp   R583FIL.NumEmp%TYPE;
	l_CodFil   R583FIL.CodFil%TYPE;
	l_Json VARCHAR2(2000);
	
	CURSOR C_EMPRESAS IS
	SELECT NUMEMP, CODFIL, DATINI, DATTER
	  FROM R583FIL
     WHERE CODPRA = P_CODPRA 
       AND DATINI <= l_DataTermino AND (DATTER >= l_DataInicio OR DATTER = l_DataZero)
  ORDER BY NUMEMP, CODFIL;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DataMax := DATETIME(04, 06, 2080, 0, 0, 0);
	
	l_DataInicio := P_DATINI;

	IF (P_DATTER > l_DataZero) THEN
		l_DataTermino := P_DATTER;
	ELSE
		l_DataTermino := l_DataMax;
	END IF;
	
	FOREACH C_EMPRESAS INTO l_NumEmp, l_CodFil, l_DatIniFil, l_DatTerFil
	LOOP
		RH_RET_DATINISST(l_NumEmp, l_DatIniSST OUT);
		IF (l_DatIniSST > l_DataZero) THEN
			l_Json := '';
		  	SP_CONCATENAR_NUM('CODFIL', l_CodFil, l_Json OUT);
		  	
		  	IF (l_DatIniFil > l_DataInicio) THEN
		  		l_DataInicio := l_DatIniFil;
		  	END IF;
		  	
		  	IF (l_DatTerFil > l_DataZero AND l_DatTerFil < l_DataTermino) THEN
		  		l_DataTermino := l_DatTerFil;
		  	END IF;
		  				
			IF (l_DataTermino > l_DatIniSST) THEN
			  	IF (l_DataInicio < l_DatIniSST) THEN
			  		l_DataInicio := l_DatIniSST;
				END IF;
		  			
				SP_E_SOCIAL_SM('S-2240', 'R583RSP', 'N', P_OPERACAO, l_DataInicio, l_DataTermino, l_NumEmp, 0, 0, l_Json, P_JSONALTERACOES, 0, NULL, l_DataInicio, 0, P_ORIGEM);
			END IF;
		END IF;
	END LOOP;
END␀Ô÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
}␀␀PROCEDURE SM_RETDEFPPP(p_NumEmp NUMBER(4), p_CerEPI OUT CHAR)
