	l_Valor VARCHAR2(2000);
	l_InfoFacult BOOLEAN;
	l_SimplificaoESocial BOOLEAN;
	l_layout VARCHAR(6);   
	l_gerarPendencia BOOLEAN;
	l_VersaoESocial NUMBER;	
BEGIN
	l_InfoFacult := TRUE;
	l_SimplificaoESocial := FALSE;
	l_gerarPendencia := TRUE;
	l_VersaoESocial := 0;
		
	RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
	N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
	
	IF (l_gerarPendencia = TRUE) THEN
		SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);

		IF (l_InfoFacult = TRUE AND l_SimplificaoESocial = FALSE) THEN
			SP_CONCATENAR_FLO('CODCON', :NEW.CODCON, 0, l_Valor OUT);
			SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
			SP_CONCATENAR_DAT('DATFIM', :NEW.DATFIM, l_Valor OUT);
			SP_CONCATENAR_NUM('INDSTA', :NEW.INDSTA, l_Valor OUT);
			SP_E_SOCIAL('S-2260', 'R034INT', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATINI, 0, 'R034INT_EI');
		END IF;
	END IF;		
END␀’Ó␀␀		SENIOR;0µ␀␀

TRIGGER R034INT_EU AFTER UPDATE ON R034INT FOR EACH ROW DECLARE
	l_DataInicioEsocial DATE;
	l_DataInicioTabelas DATE;
	l_DataInicioNaoPeriodicos DATE;
	l_DataInicioPeriodicos DATE;
	l_DataInicioSST DATE;
	l_DataInicioMigracao DATE;
	l_Valor VARCHAR2(2000);
	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_Incluir BOOLEAN;
	l_Excluir BOOLEAN;
	l_InfoFacult BOOLEAN;
	l_SimplificaoESocial BOOLEAN;
	l_layout VARCHAR(6);   
	l_gerarPendencia BOOLEAN;
	l_VersaoESocial NUMBER;		
BEGIN
    RH_DEF_ESOCIAL(:NEW.NUMEMP, l_DataInicioTabelas OUT, l_DataInicioEsocial OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
	l_Valor := '';
	l_Valido := FALSE;
	l_Alterou := FALSE;
	l_Incluir := FALSE;
    l_Excluir := FALSE;	
	l_InfoFacult := TRUE;
	l_SimplificaoESocial := FALSE;
	l_gerarPendencia := TRUE;
	l_VersaoESocial := 0;
	
	RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
	N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
	
	IF (l_gerarPendencia = TRUE) THEN
		SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
	
		SP_VALUPDATE_DAT(:OLD.DATINI, :NEW.DATINI, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;
	
		SP_VALUPDATE_DAT(:OLD.DATFIM, :NEW.DATFIM, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
		  IF (:NEW.DATFIM >= l_DataInicioNaoPeriodicos) THEN
			l_Alterou := TRUE;
	      END IF;		
		END IF;
	
		SP_VALUPDATE_DAT(:OLD.DATPGT, :NEW.DATPGT, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
		  l_Alterou := TRUE;
		END IF;
	
		SP_VALUPDATE_DES(:OLD.DESJOR, :NEW.DESJOR, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;
	
		SP_VALUPDATE_NUM(:OLD.INDLOC, :NEW.INDLOC, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;
	
		SP_VALUPDATE_NUM(:OLD.ENDCEP, :NEW.ENDCEP, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;
	
		SP_VALUPDATE_DES(:OLD.TIPLGR, :NEW.TIPLGR, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;
	
		SP_VALUPDATE_DES(:OLD.DESLOG, :NEW.DESLOG, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;
	
		SP_VALUPDATE_DES(:OLD.NUMLOG, :NEW.NUMLOG, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;
	
		SP_VALUPDATE_DES(:OLD.CPLLOG, :NEW.CPLLOG, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;
	
		SP_VALUPDATE_NUM(:OLD.CODPAI, :NEW.CODPAI, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;
	
		SP_VALUPDATE_DES(:OLD.CODEST, :NEW.CODEST, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;
	
		SP_VALUPDATE_NUM(:OLD.CODCID, :NEW.CODCID, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;
	
		SP_VALUPDATE_NUM(:OLD.CODBAI, :NEW.CODBAI, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;
		
		/* Se Alterou a data de Fim da convocação */
		SP_VALUPDATE_DAT(:OLD.DATFIM, :NEW.DATFIM, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
		  /* Convocação passou a atuar sobre o período do eSocial */
		  IF ((:OLD.DATFIM < l_DataInicioNaoPeriodicos) AND (:NEW.DATFIM >= l_DataInicioNaoPeriodicos)) THEN
		    l_Incluir := TRUE;
		   /* Convocação deixou de atuar sobre o período do eSocial */
		  ELSE
		    IF ((:OLD.DATFIM >= l_DataInicioNaoPeriodicos) AND (:NEW.DATFIM < l_DataInicioNaoPeriodicos)) THEN
	  	      l_Excluir := TRUE;	
		    END IF;
		  END IF;
		END IF;
	
		IF (l_SimplificaoESocial = FALSE) THEN
		  /* Só Irá gerar pendência se foi alterada alguma informação ou o período passou a atuar no eSocial */
		  IF (((l_Alterou = TRUE) OR (l_Incluir = TRUE)) AND (l_Excluir = FALSE)) THEN
			SP_CONCATENAR_FLO('CODCON', :NEW.CODCON, 0, l_Valor OUT);
			SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
			SP_CONCATENAR_DAT('DATFIM', :NEW.DATFIM, l_Valor OUT);
			SP_CONCATENAR_NUM('INDSTA', :NEW.INDSTA, l_Valor OUT);
			SP_E_SOCIAL('S-2260', 'R034INT', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATINI, 0, 'R034INT_EU');
		  END IF;
		
		  IF (l_Excluir = TRUE) THEN
		    SP_CONCATENAR_DES('LAYOUT', 'S-2260', l_Valor OUT);
		    SP_CONCATENAR_FLO('CODCON', :NEW.CODCON, 0, l_Valor OUT);
		    SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
		    SP_CONCATENAR_DAT('DATFIM', :NEW.DATFIM, l_Valor OUT);
		    SP_CONCATENAR_NUM('INDSTA', :NEW.INDSTA, l_Valor OUT);
		    SP_E_SOCIAL('S-3000', 'R034INT', 'N', 'E', NULL, NULL, :NEW.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0, NULL, :OLD.DATINI, 0, 'R034INT_EU');	
		  END IF;
	    END IF;
	END IF;	    
END␀Ó␀␀		SENIOR;0/␀␀

TRIGGER R034INT_ED AFTER DELETE ON R034INT FOR EACH ROW DECLARE
	l_Valor VARCHAR2(2000);
	l_layout VARCHAR(6);   
	l_gerarPendencia BOOLEAN;			
BEGIN
    l_gerarPendencia := TRUE;
    
	RH_LAYOUTCOLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layout OUT);
	N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
	
	IF (l_gerarPendencia = TRUE) THEN    
		SP_CONCATENAR_DES('LAYOUT', 'S-2260', l_Valor OUT);
		SP_CONCATENAR_FLO('CODCON', :OLD.CODCON, 0, l_Valor OUT);
		SP_CONCATENAR_DAT('DATINI', :OLD.DATINI, l_Valor OUT);
		SP_CONCATENAR_DAT('DATFIM', :OLD.DATFIM, l_Valor OUT);
		SP_CONCATENAR_NUM('INDSTA', :OLD.INDSTA, l_Valor OUT);
		SP_E_SOCIAL('S-3000', 'R034INT', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0, NULL, :OLD.DATINI, 0, 'R034INT_ED');
	END IF;		
END␀␀␀a7␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀“Ó␀␀…¬␀␀´␀	Ôï1␀␀␀␀␀°␀␀XbXbr␀Æÿ␀␀Ò␀␀␀ã,´␀	Ôï1␀␀␀␀␀×@\›␀␀\›␀␀r␀Æÿ␀␀™Ó␀␀␀.␀t	Ôï1␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôï1␀␀␀␀␀$€$€$w␀Æÿ␀␀…Ó␀␀␀␀␀␀0;1;2;3•Ó␀␀	SENIOR;0HTRIGGER R034LCO_SI AFTER INSERT ON R034LCO

