D␀␀create or replace PROCEDURE SP_R034FUN_HIST(p_tipalt IN VARCHAR2,p_numemp IN NUMBER,p_tipcol IN NUMBER,p_numcad IN NUMBER,p_nomfun IN VARCHAR2,p_apefun IN VARCHAR2,p_tipsex IN VARCHAR2,p_raccor IN NUMBER,p_estciv IN NUMBER,p_grains IN NUMBER,p_datnas IN DATE,p_codnac IN NUMBER,p_numctp IN NUMBER,p_serctp IN VARCHAR2,p_digcar IN VARCHAR2,p_estctp IN VARCHAR2,p_dexctp IN DATE,p_numcpf IN NUMBER,p_numpis IN NUMBER,p_dcdpis IN DATE,p_movsef IN VARCHAR2,p_irrise IN VARCHAR2,p_apoida IN VARCHAR2,p_emtcar IN VARCHAR2,p_numins IN NUMBER,p_coddef IN NUMBER,p_deffis IN VARCHAR2,p_benrea IN VARCHAR2,p_nmfun1 IN VARCHAR2,p_nmfun2 IN VARCHAR2,p_nmfun3 IN VARCHAR2,p_nmfun4 IN VARCHAR2,p_codpro IN NUMBER,p_anoche IN NUMBER,p_visest IN NUMBER,p_dvlest IN DATE,p_regest IN VARCHAR2,p_dvlctp IN DATE,p_docest IN NUMBER,p_datche IN DATE,p_numpsp IN VARCHAR2,p_datadm IN DATE,p_tipadm IN NUMBER,p_tipcon IN NUMBER,p_tipopc IN VARCHAR2,p_datopc IN DATE,p_confgt IN NUMBER,p_modpag IN VARCHAR2,p_codban IN NUMBER,p_codage IN NUMBER,p_conban IN NUMBER,p_digban IN VARCHAR2,p_perpag IN VARCHAR2,p_recadi IN VARCHAR2,p_rec13s IN VARCHAR2,p_lisrai IN VARCHAR2,p_emicar IN VARCHAR2,p_codcha IN VARCHAR2,p_numcra IN NUMBER,p_outcon IN VARCHAR2,p_outtet IN VARCHAR2,p_outemp IN NUMBER,p_outtip IN NUMBER,p_outcad IN NUMBER,p_perdes IN NUMBER,p_periss IN NUMBER,p_faiins IN NUMBER,p_opcatu IN VARCHAR2,p_dctins IN NUMBER,p_cadfol IN VARCHAR2,p_catter IN VARCHAR2,p_fattpo IN NUMBER,p_empres IN NUMBER,p_tipres IN NUMBER,p_cadres IN NUMBER,p_tipter IN NUMBER,p_cauadv IN VARCHAR2,p_inscur IN NUMBER,p_assppr IN NUMBER,p_datppr IN DATE,p_verint IN VARCHAR2,p_contov IN VARCHAR2,p_apupfs IN VARCHAR2,p_tippfs IN VARCHAR2,p_ratpfs IN VARCHAR2,p_gpstri IN DATE,p_dedcar IN VARCHAR2,p_codfor IN NUMBER,p_rateve IN VARCHAR2,p_pertra IN NUMBER,p_perirt IN NUMBER,p_dedins IN NUMBER,p_tipsrv IN NUMBER,p_bushor IN NUMBER,p_recgra IN VARCHAR2,p_codidn IN NUMBER,p_tpctba IN NUMBER,p_codlim IN NUMBER,p_rettrp IN VARCHAR2, p_seqhis IN OUT NUMBER) is
begin
  begin
  	p_seqhis := R038HFB_SEQ.NEXTVAL;
    if (p_tipalt<>'E') then
	  begin
	    INSERT INTO R038HFB (numemp,tipcol,numcad,dathis,seqhis,tipalt,nomfun,apefun,tipsex,raccor,estciv,grains,datnas,codnac,numctp,serctp,digcar,estctp,dexctp,numcpf,numpis,dcdpis,movsef,irrise,apoida,emtcar,numins,coddef,deffis,benrea,nmfun1,nmfun2,nmfun3,nmfun4,codpro,anoche,visest,dvlest,regest,dvlctp,docest,datche,numpsp,datadm,tipadm,tipcon,tipopc,datopc,confgt,modpag,codban,codage,conban,digban,perpag,recadi,rec13s,lisrai,emicar,codcha,numcra,outcon,outtet,outemp,outtip,outcad,perdes,periss,faiins,opcatu,dctins,cadfol,catter,fattpo,empres,tipres,cadres,tipter,cauadv,inscur,assppr,datppr,verint,contov,apupfs,tippfs,ratpfs,gpstri,dedcar,codfor,rateve,pertra,perirt,dedins,tipsrv,bushor,recgra,codidn,tpctba,codlim,rettrp) 
				VALUES  (p_numemp,p_tipcol,p_numcad,SYSDATE,p_seqhis,p_tipalt,p_nomfun,p_apefun,p_tipsex,p_raccor,p_estciv,p_grains,p_datnas,p_codnac,p_numctp,p_serctp,p_digcar,p_estctp,p_dexctp,p_numcpf,p_numpis,p_dcdpis,p_movsef,p_irrise,p_apoida,p_emtcar,p_numins,p_coddef,p_deffis,p_benrea,p_nmfun1,p_nmfun2,p_nmfun3,p_nmfun4,p_codpro,p_anoche,p_visest,p_dvlest,p_regest,p_dvlctp,p_docest,p_datche,p_numpsp,p_datadm,p_tipadm,p_tipcon,p_tipopc,p_datopc,p_confgt,p_modpag,p_codban,p_codage,p_conban,p_digban,p_perpag,p_recadi,p_rec13s,p_lisrai,p_emicar,p_codcha,p_numcra,p_outcon,p_outtet,p_outemp,p_outtip,p_outcad,p_perdes,p_periss,p_faiins,p_opcatu,p_dctins,p_cadfol,p_catter,p_fattpo,p_empres,p_tipres,p_cadres,p_tipter,p_cauadv,p_inscur,p_assppr,p_datppr,p_verint,p_contov,p_apupfs,p_tippfs,p_ratpfs,p_gpstri,p_dedcar,p_codfor,p_rateve,p_pertra,p_perirt,p_dedins,p_tipsrv,p_bushor,p_recgra,p_codidn,p_tpctba,p_codlim,p_rettrp);
	  exception
	    when OTHERS then
		  raise_application_error(-20000 + -(103),'Erro ao registrar histórico de alteração da ficha básica.');
	  end;
    else
      begin
        DELETE FROM R038HFC 
        WHERE NUMEMP=p_numemp 
        AND TIPCOL=p_tipcol 
        AND NUMCAD=p_numcad;
        
		DELETE FROM R038HFB 
        WHERE NUMEMP=p_numemp 
        AND TIPCOL=p_tipcol 
        AND NUMCAD=p_numcad;
       exception
         when OTHERS then
           raise_application_error(-20000 + -(103),'Erro ao excluir históricos da ficha  básica e  ficha complementar.');
       end;
    end if;
  end;
end SP_R034FUN_HIST;
