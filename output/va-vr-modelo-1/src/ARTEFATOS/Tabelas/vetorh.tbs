TRIGGER R017PEP_EU AFTER UPDATE ON R017PEP FOR EACH ROW
DECLARE
	l_data_atual  DATE;
	l_hora_atual  NUMBER(4);
	l_estPos   R017PEP.EstPos%TYPE;
	l_posTra   R017PEP.PosTra%TYPE;
	l_temAud_Ins   NUMBER(2);
	l_codRPA      NUMBER(15);
	l_numempSTR   VARCHAR2(255);
	l_tipcolSTR   VARCHAR2(255);
	l_numcadSTR   VARCHAR2(255);
	l_datSTR VARCHAR2(10);
	l_horSTR VARCHAR2(5);
	l_prmSTR VARCHAR2(9);
	l_regFound NUMBER(1);
	
	CURSOR c_r038HPO IS
       SELECT NUMEMP, TIPCOL, NUMCAD, INIATU, TERATU
         FROM R038HPO
        WHERE R038HPO.ESTPOS = l_estPos AND
              R038HPO.POSTRA = l_posTra;

  TYPE t_r038HPO IS RECORD(
    NUMEMP   R038HPO.NUMEMP%TYPE,
    TIPCOL   R038HPO.TIPCOL%TYPE,
    NUMCAD   R038HPO.NUMCAD%TYPE,
    INIATU   R038HPO.INIATU%TYPE,
    TERATU   R038HPO.TERATU%TYPE);
  l_r038HPO t_r038HPO;
BEGIN
	l_temAud_Ins := 0;
	BEGIN
			SELECT COUNT(*) INTO l_temAud_Ins FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 110;
	EXCEPTION
			WHEN OTHERS THEN RAISERROR 103 'TR017PEP_EU: Erro ao realizar o SELECT na tabela R995CTE.';
	END;
	
	l_codRPA := 0;
	
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_posTra := :NEW.POSTRA;
	l_estPos := :NEW.ESTPOS;
  IF ((:OLD.CODPRM <> :NEW.CODPRM)  OR  (:OLD.OBSPRM <> :NEW.OBSPRM)) THEN
    FOREACH c_r038HPO INTO l_r038HPO.NUMEMP,
	                                                    l_r038HPO.TIPCOL,
                                                      l_r038HPO.NUMCAD,
                                                      l_r038HPO.INIATU,
                                                      l_r038HPO.TERATU
    LOOP
			l_numempSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMEMP);
			l_numempSTR := LTRIM(l_numempSTR);
			l_numempSTR := RTRIM(l_numempSTR);

			l_tipcolSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.TIPCOL);
			l_tipcolSTR := LTRIM(l_tipcolSTR);
			l_tipcolSTR := RTRIM(l_tipcolSTR);

			l_numcadSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMCAD);
			l_numcadSTR := LTRIM(l_numcadSTR);
			l_numcadSTR := RTRIM(l_numcadSTR);
			
			BEGIN
					SELECT 1 INTO l_regFound FROM R070PEC WHERE NUMEMP = l_r038HPO.NUMEMP AND TIPCOL = l_r038HPO.TIPCOL AND NUMCAD = l_r038HPO.NUMCAD AND DATINI = l_r038HPO.INIATU AND HORINI = 0 AND CODPRM = :NEW.CODPRM;
			EXCEPTION
				WHEN NO_DATA_FOUND THEN
						l_regFound := 0;
			END;						
			IF (l_regFound = 0) THEN
				IF (:OLD.CODPRM <> :NEW.CODPRM)  THEN
					BEGIN
							IF (l_temAud_Ins > 0) THEN
								SP_RET_REG_AUD(l_codRPA OUT);
									INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
																	VALUES (l_codRPA, 3, 6, 1, 110, 1, l_data_atual, l_hora_atual, 'FRGERPRM', :OLD.CODUSU);
									INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
									INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
									INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);
									
									SP_DATSTR(l_r038HPO.INIATU, 'DD/MM/YYYY', l_datSTR OUT);
									SP_INTSTR(0,'HH:MM', l_horSTR OUT);
									l_prmSTR := CONVERT(NUMBER_TO_CHAR, :OLD.CODPRM);
									l_prmSTR := LTRIM(l_prmSTR);
									l_prmSTR := RTRIM(l_prmSTR);					
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datSTR);
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORINI', l_horSTR);
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRM', l_prmSTR);					
									SP_DATSTR(l_r038HPO.TERATU, 'DD/MM/YYYY', l_datSTR OUT);
									SP_INTSTR(1439,'HH:MM', l_horSTR OUT);					
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATFIM', l_datSTR);
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORFIM', l_horSTR);
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR,:OLD.CODUSU));
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSPRM', :OLD.OBSPRM);
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'EXCLUSÃO');
							END IF;
							DELETE FROM R070PEC WHERE NUMEMP =  l_r038HPO.NUMEMP AND TIPCOL = l_r038HPO.TIPCOL AND NUMCAD = l_r038HPO.NUMCAD AND DATINI = l_r038HPO.INIATU AND DATFIM = l_r038HPO.TERATU AND CODPRM = :OLD.CODPRM;
							
							IF (l_temAud_Ins > 0) THEN
									SP_RET_REG_AUD(l_codRPA OUT);
									INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
																	VALUES (l_codRPA, 3, 6, 1, 110, 1, l_data_atual, l_hora_atual, 'FRGERPRM', :NEW.codusu);
									INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
									INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
									INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);
									
									SP_DATSTR(l_r038HPO.INIATU, 'DD/MM/YYYY', l_datSTR OUT);
									SP_INTSTR(0,'HH:MM', l_horSTR OUT);
									l_prmSTR := CONVERT(NUMBER_TO_CHAR, :NEW.CODPRM);
									l_prmSTR := LTRIM(l_prmSTR);
									l_prmSTR := RTRIM(l_prmSTR);					
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datSTR);
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORINI', l_horSTR);
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRM', l_prmSTR);					
									SP_DATSTR(l_r038HPO.TERATU, 'DD/MM/YYYY', l_datSTR OUT);
									SP_INTSTR(1439,'HH:MM', l_horSTR OUT);					
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATFIM', l_datSTR);
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORFIM', l_horSTR);
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR,:NEW.CODUSU));
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSPRM', :NEW.OBSPRM);
									INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'INCLUSÃO');						
							INSERT R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM) VALUES 
																						 (l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_r038HPO.INIATU, 0, :NEW.CODPRM, l_r038HPO.TERATU, 1439, :NEW.CODUSU, :NEW.OBSPRM);
							END IF;
					EXCEPTION WHEN OTHERS THEN
						RAISERROR 103 'R017PEP_EU: Erro ao atualizar a tabela R070PEC';
					END;
				END IF;
			END IF;
    END LOOP;
	END IF;
END		SENIOR;24-␀␀

