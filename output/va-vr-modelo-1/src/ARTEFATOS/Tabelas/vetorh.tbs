AFTER INSERT ON R110C11
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4); /* Código da categoria de auditoria*/
  l_codtpa NUMBER(4); /* Código do tipo de auditoria - Inclusão*/
  l_datTemp VARCHAR(10);
BEGIN
  l_codSistema:= 1;
  l_codcpa:= 141;  /* Código da categoria de auditoria - CID-11*/
  l_codtpa:= 413;  /* Código do tipo de auditoria - Inclusão*/

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110C11_AI', '');

    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:NEW.CODFIC));
      SP_DATSTR(:NEW.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR,:NEW.HORATE));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCID',:NEW.CODCID);
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110C11_AI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRIDEF',:NEW.PRIDEF);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR,:NEW.CODATE));
    END;
  END IF;
END␀%ß␀␀		SENIOR;0(
␀␀

TRIGGER R110C11_AU
AFTER UPDATE ON R110C11
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4); /* Código da categoria de auditoria*/
  l_codtpa NUMBER(4); /* Código do tipo de auditoria - Alteração*/
  l_datTemp VARCHAR(10);
BEGIN
  /* Verifica se algum dos campos relevantes foi alterado*/
  IF (
  :OLD.PRIDEF <>:NEW.PRIDEF OR
  :OLD.CODATE <>:NEW.CODATE OR
  :OLD.CODCID <>:NEW.CODCID
  ) THEN
    /* Se algum campo foi alterado, registra o log de alteração*/
    l_codSistema:= 1;
    l_codcpa:= 141;  /* Código da categoria de auditoria - CID-11*/
    l_codtpa:= 414;  /* Código do tipo de auditoria - Alteração*/

    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110C11_AU', '');

      /* Insere os campos chave na tabela de auditoria R995PRC*/
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:OLD.CODFIC));
        SP_DATSTR(:OLD.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR,:OLD.HORATE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCID',:OLD.CODCID);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110C11_AU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      /* Insere os valores dos campos na tabela de auditoria R995PRT*/
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCID',:OLD.CODCID);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCID',:NEW.CODCID);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRIDEF',:OLD.PRIDEF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRIDEF',:NEW.PRIDEF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODATE', CONVERT(NUMBER_TO_CHAR,:OLD.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODATE', CONVERT(NUMBER_TO_CHAR,:NEW.CODATE));
      END;
    END IF;
  END IF;
END␀#ß␀␀		SENIOR;0Ö␀␀

