ÿ␀␀Ò␀␀␀.␀t„␀␀␀␀␀Ü␀t␀Ü␀n¼‡␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀„␀␀␀␀␀.%€$0.w¼‡␀Æÿ␀␀…Ó␀␀␀ZÂ␀␀„␀␀␀␀␀}Â␀␀\Â␀␀\Â␀␀\␀Èˆ␀␀ÿ␀␀õÜ␀␀␀AO±␀Ôû?␀␀␀␀␀;␀;␀;q␀Æÿ␀␀ÿ␀YO±␀Ôû?␀␀␀␀␀8;;;q␀Æÿ␀␀ÿ␀2O±␀Ôû?␀␀␀␀␀;␀;␀;q␀Æÿ␀␀ÿ␀JO±␀Ôû?␀␀␀␀␀2;;;q␀Æÿ␀␀ÿ␀@O±␀Ôû?␀␀␀␀␀;␀;␀;q␀Æÿ␀␀ÿ␀XO±␀Ôû?␀␀␀␀␀7;;;q␀Æÿ␀␀ÿ␀␀␀␀0␀␀%␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ØÜ␀␀Ö-±␀	␀␀␀␀␀␀3>Ä␀Ä␀q␀Æÿ␀␀ÙÜ␀␀␀¢UU␀␀␀␀␀␀X°V°VV␀␀ÿ␀␀ÿ␀␀␀␀0␀␀â␀␀␀ÚÜ␀␀Ê¢␀␀±␀	␀␀␀␀␀␀£␀␀Î¢␀␀£␀␀q␀Æÿ␀␀ÛÜ␀␀␀£UE␀␀␀␀␀␀~Y°V°VGºˆ␀␀ÿ␀␀ÿ␀@␀Ò␀␀␀␀␀␀ˆ␀v␀v␀n␀Æÿ␀␀ÿ␀␀␀␀0␀␀„£␀␀␀␀␀ÜÜ␀␀ZÂ␀␀	␀␀␀␀␀␀}Â␀␀\Â␀␀\Â␀␀\␀Èˆ␀␀ÿ␀␀õÜ␀␀␀mDÑ␀	␀␀␀␀␀␀KI_şEqCvˆ␀êÿ␀␀ÿ␀%␀n␀␀␀␀␀␀Š␀w␀‰␀n␀Æÿ␀␀ÿ␀…¬␀␀´␀␀␀␀␀␀␀ñb¸aÛbr␀Æÿ␀␀Ò␀␀␀.␀t␀␀␀␀␀␀|␀w␀w␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀␀␀␀␀␀␀,%Â$Â$w¼‡␀Æÿ␀␀…Ó␀␀␀Y$Ì␀␀␀␀␀␀␀B%©$¬$w-ˆ␀Æÿ␀␀DÚ␀␀␀Y=␀␀␀␀␀␀­	␀‡‡c␀␀␀ÿ␀␀ÿ␀ÌEÑ␀␀␀␀␀␀␀¯K?_öHqCvˆ␀êÿ␀␀ÿ␀øw·␀␀␀␀␀␀␀ y{óxì*␀␀Æÿ␀␀ÿ␀9m␀␀␀␀␀␀␀Ã5Ã5n␀Æÿ␀␀ÿ␀␀␀İÜ␀␀␀ŞÜ␀␀␀␀0;1áÜ␀␀		SENIOR;0»␀␀TRIGGER R088USU_EI AFTER INSERT ON R088USU FOR EACH ROW

DECLARE
l_online      BOOLEAN;
  l_cravei      NUMBER(12);
  l_crapro      NUMBER(12);
  l_cracha      NUMBER(12);
  l_data_zero   DATE;
  l_data_histo  DATE;
  l_hora_histo  NUMBER(4);
  l_situa       NUMBER(1);
  l_usuonl      BOOLEAN;
  l_froonl      BOOLEAN;
  l_hora_atual   NUMBER(4);
  l_data_atual   DATE;
  l_libvei       NUMBER(1);
  l_datval       DATE;
  l_horval       NUMBER(4);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);

  /* CURSOR da tabela de agendamentos */
  CURSOR c_r088agf IS SELECT EMPCON,TCLCON,CADCON,DATRET,HORRET
                           FROM R088AGF
                           WHERE PLAVEI = :NEW.PLAVEI AND (VEIUTI = 'A' OR VEIUTI = 'S')
                           AND ((DATAGF > :NEW.DATALT) OR (DATAGF = :NEW.DATALT AND HORAGF >= 0))
                           AND (DATRET < :NEW.DATVAL OR (DATRET = :NEW.DATVAL AND HORRET <= :NEW.HORVAL) OR :NEW.DATVAL = l_data_zero);
       TYPE t_r088agf IS RECORD(
                EMPCON   R088AGF.EmpCon%TYPE,
                TCLCON   R088AGF.TclCon%TYPE,
                CADCON   R088AGF.CadCon%TYPE,
                DATRET   R088AGF.DatRet%TYPE,
                HORRET   R088AGF.HorRet%TYPE);
       l_r088agf t_r088agf;

BEGIN
/* DATA/HORA ATUAL */
l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
l_data_atual := CURDATE();

/* DEFINIÇÕES DE FROTA */
SP_VerOnLine(l_online OUT);
SP_UsaFronline(l_froonl OUT, l_libvei OUT);
SP_Usuonline(l_froonl OUT, l_usuonl OUT);

/* DATA ZERO E SITUA */
l_data_zero :=  DATETIME(31, 12, 1900, 0, 0, 0);
l_situa := 0;

/* SE POSSUI CONTROLE USUARIOS ONLINE E O USUARIO FOR DE ACESSO LIVRE */
IF   (l_online = TRUE) AND (l_usuonl = TRUE) AND (:NEW.ACELIV = 'S') THEN

     /* RETORNA O CRACHÁ DO VEÍCULO */
     BEGIN
		 SELECT NUMCRA, DATFIM, HORFIM INTO l_cravei, l_data_histo, l_hora_histo
				FROM R088HCH
				WHERE PLAVEI = :NEW.PLAVEI
				AND ((DATINI <= :NEW.DATALT) AND (DATFIM >= :NEW.DATALT
				OR DATFIM = l_data_zero)) AND STAACC = 1;
     EXCEPTION
		 WHEN TOO_MANY_ROWS THEN
			  RAISERROR 103 'Erro no R088HCH - TOO MANY ROWS.';
		 WHEN NO_DATA_FOUND THEN
			  l_cravei := 0;
		 WHEN OTHERS THEN
			  RAISERROR 103 'Erro no SELECT em R088HCH.';
     END;

     /* RETORNA O CRACHÁ DO CONDUTOR (COLABORADOR) */
     IF (:NEW.TIPCLB = 1) THEN
       /* Se tiver crachá provísório vale ele. senão pegar o titular */
       SP_RETCRA (2, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0,'',0,'',l_crapro OUT);
       IF   (l_crapro = 0)  THEN
           SP_RETCRA (1, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD,0,'',0,'', l_cracha OUT);
       ELSE  
	       l_cracha := l_crapro;
       END IF;
	   l_numemp := :NEW.NUMEMP;
	   l_tipcol := :NEW.TIPCOL;
	   l_numcad := :NEW.NUMCAD;
     /* RETORNA O CRACHÁ DO CONDUTOR (COLABORADOR DE OUTRAS UNIDADES) */
     ELSE
       /* Se tiver crachá provísório vale ele. senão pegar o titular */
       SP_RETCRA (2, :NEW.NUMEMP, 5, :NEW.CADOCR, 0,'',0,'',l_crapro OUT);
       IF   (l_crapro = 0)  THEN
           SP_RETCRA (1, :NEW.NUMEMP, 5, :NEW.CADOCR, 0,'',0,'',l_cracha OUT);
       ELSE  
	       l_cracha := l_crapro;
       END IF;
	   l_numemp := :NEW.NUMEMP;
	   l_tipcol := 5;
	   l_numcad := :NEW.CADOCR;
     END IF;

     /* SE A DATA FINAL DO HISTÓRICO DO VEICULO FOR ZERO OU MAIOR QUE 31/12/2050, ALTERA PARA  31/12/2050 */
     IF (l_data_histo = l_data_zero) OR (l_data_histo > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
        l_data_histo := DATETIME(31, 12, 2050, 0, 0, 0);
        l_hora_histo := 1439;
     END IF;

     /* SE A DATA FINAL DO CADASTRO DO USUÁRIO FOR ZERO OU MAIOR QUE 31/12/2050, ALTERA PARA  31/12/2050 */
     l_datval := :NEW.DATVAL;
     l_horval := :NEW.HORVAL;
     IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
        l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
        l_horval := 1439;
     END IF;

     /* SE POSSUI CRACHA DE VEICULO E DO CONDUTOR */
     IF (l_cracha <> 0) AND (l_cravei <> 0) THEN
       /* PEGA A MENOR DATA FINAL ENTRE O HISTORICO DE CRACHA E O CADASTRO DO USUARIO */
       IF  (l_data_histo < l_datval) OR ((l_data_histo = l_datval) AND (l_hora_histo <= l_horval)) THEN
		   SP_VEIPESCON('I', l_cravei, l_cracha, l_situa, :NEW.PLAVEI, 
						l_data_histo, l_hora_histo, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
       ELSE 
		   SP_VEIPESCON('I', l_cravei, l_cracha, l_situa, :NEW.PLAVEI, 
						l_datval, l_horval, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
       END IF;
     END IF;
END IF;

/* ATUALIZA REGISTROS DE AGENDAMENTOS NA CONTVEI */
IF  (l_froonl = TRUE) AND (l_online = TRUE) THEN

    /* SE LIBERAR VEICULO PELO AGENDAMENTO */
    IF  (l_libvei = 2) THEN
        /* FAZ LOOP EM TODOS OS REGISTROS VÁLIDOS NA TABELA DE AGENDAMENTO */
        FOREACH c_r088agf INTO  l_r088agf.EmpCon,
                                l_r088agf.TclCon,
                                l_r088agf.CadCon,
                                l_r088agf.DatRet,
                                l_r088agf.HorRet
        LOOP
            /*  BUSCA PELO CRACHÁ DO COLABORADOR. */
            SP_RETCRA (2, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon, 0,'',0,'',l_crapro OUT);
            IF   (l_crapro = 0)  THEN
                SP_RETCRA (1, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon,0,'',0,'', l_cracha OUT);
            ELSE 
			    l_cracha := l_crapro;
            END IF;

            /* SE A DATA FINAL DO CADASTRO DO USUÁRIO FOR ZERO OU MAIOR QUE 31/12/2050, ALTERA PARA  31/12/2050 */
            l_datval := :NEW.DATVAL;
            l_horval := :NEW.HORVAL;
            IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
               l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
               l_horval := 1439;
            END IF;

            /* SE A DATA FINAL DO AGENDAMENTO  FOR ZERO OU MAIOR QUE 31/12/2050, ALTERA PARA  31/12/2050 */
            IF (l_r088agf.datret = l_data_zero) OR (l_r088agf.datret > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
               l_r088agf.datret := DATETIME(31, 12, 2050, 0, 0, 0);
               l_r088agf.horret := 1439;
            END IF;

            /* SE POSSUI CRACHÁ DE VEICULO E DE CONDUTOR */
            IF (l_cracha <> 0) AND (l_cravei <> 0) THEN
               IF   (l_datval < l_r088agf.datret) OR (l_datval = l_r088agf.datret AND l_horval <= l_r088agf.horret) THEN
				   SP_VEIPESCON('I', l_cravei, l_cracha, l_situa, :NEW.PLAVEI, 
						        l_datval, l_horval, l_r088agf.tclcon, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon, 0, '');
               ELSE 
				   SP_VEIPESCON('I', l_cravei, l_cracha, l_situa, :NEW.PLAVEI, 
						        l_r088agf.datret, l_r088agf.horret, l_r088agf.tclcon, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon, 0, '');
               END IF;
            END IF;

        END LOOP;
    END IF;
END IF;
END␀âÜ␀␀		SENIOR;0³!␀␀

TRIGGER R088USU_EU AFTER UPDATE ON R088USU FOR EACH ROW

DECLARE
l_online       BOOLEAN;
  l_cravei       NUMBER(12);
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_data_zero    DATE;
  l_data_histo   DATE;
  l_hora_histo   NUMBER;
  l_situa        NUMBER(1);
  l_usuonl       BOOLEAN;
  l_froonl       BOOLEAN;
  l_hora_atual   NUMBER(4);
  l_data_atual   DATE;
  l_libvei       NUMBER(1);
  l_datval       DATE;
  l_horval       NUMBER(4);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);

  /* CURSOR da tabela de agendamentos */
  CURSOR c_r088agf IS SELECT EMPCON,TCLCON,CADCON,DATRET,HORRET
                           FROM R088AGF
                           WHERE PLAVEI = :NEW.PLAVEI AND (VEIUTI = 'A' OR VEIUTI = 'S')  
                           AND ((DATAGF > :NEW.DATALT) OR (DATAGF = :NEW.DATALT AND HORAGF >= 0))
                           AND (DATRET < :NEW.DATVAL OR (DATRET = :NEW.DATVAL AND HORRET <= :NEW.HORVAL) OR :NEW.DATVAL = l_data_zero);
       TYPE t_r088agf IS RECORD(
                EMPCON   R088AGF.EmpCon%TYPE,
                TCLCON   R088AGF.TclCon%TYPE,
                CADCON   R088AGF.CadCon%TYPE,
                DATRET   R088AGF.DatRet%TYPE,
                HORRET   R088AGF.HorRet%TYPE);
       l_r088agf t_r088agf;

BEGIN
	/* DATA/HORA ATUAL */
	l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
	l_data_atual := CURDATE();

	/* DEFINIÇÕES DE FROTA */
	SP_VerOnLine(l_online OUT);
	SP_UsaFronline(l_froonl OUT, l_libvei OUT);
	SP_Usuonline(l_froonl OUT, l_usuonl OUT);

	/* DATA ZERO E SITUA */
	l_data_zero :=  DATETIME(31, 12, 1900, 0, 0, 0);
	l_situa := 0;


	/* RETORNA O CRACHÁ DO VEÍCULO */
	BEGIN
	SELECT NUMCRA, DATFIM, HORFIM INTO l_cravei, l_data_histo, l_hora_histo
		   FROM R088HCH
		   WHERE PLAVEI = :NEW.PLAVEI
		   AND ((DATINI <= :NEW.DATALT) AND (DATFIM >= :NEW.DATALT
		   OR DATFIM = l_data_zero)) AND STAACC = 1;
	EXCEPTION
		WHEN TOO_MANY_ROWS THEN
			 RAISERROR 103 'Erro no R088HCH - TOO MANY ROWS.';
		WHEN NO_DATA_FOUND THEN
		   l_cravei := 0;
		WHEN OTHERS THEN
			 RAISERROR 103 'Erro no SELECT em R088HCH.';
	END;

	/* ATUALIZA OS USUÁRIOS ONLINE */
	IF   (l_online = TRUE) AND (l_usuonl = TRUE) THEN

		 /* SE POSSUI ACESSO LIVRE, OU SE MUDOU O ACESSO DE LIVRE PARA RESTRITO, ATUALIZA A CONTVEI */
		 IF (:NEW.ACELIV = 'S') OR ((:OLD.ACELIV = 'S') AND (:NEW.ACELIV = 'N')) THEN

		   /* RETORNA O CRACHÁ DO CONDUTOR (COLABORADOR) */
		   IF (:NEW.TIPCLB = 1) THEN
			 /* SE TIVER CRACHÁ PROVÍSÓRIO VALE ELE. SENÃO PEGAR O TITULAR */
			 SP_RETCRA (2, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0,'',0,'',l_crapro OUT);
			 IF   (l_crapro = 0)  THEN
				   SP_RETCRA (1, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD,0,'',0,'', l_cracha OUT);
			 ELSE  
				l_cracha := l_crapro;
			 END IF;
			 l_numemp := :NEW.NUMEMP;
			 l_tipcol := :NEW.TIPCOL;
			 l_numcad := :NEW.NUMCAD;
		   /* RETORNA O CRACHÁ DO CONDUTOR (COLABORADOR DE OUTRAS UNIDADES) */
		   ELSE
			 /* SE TIVER CRACHÁ PROVÍSÓRIO VALE ELE. SENÃO PEGAR O TITULAR */
			 SP_RETCRA (2, :NEW.NUMEMP, 5, :NEW.CADOCR, 0,'',0,'',l_crapro OUT);
			 IF   (l_crapro = 0)  THEN
				   SP_RETCRA (1, :NEW.NUMEMP, 5, :NEW.CADOCR, 0,'',0,'',l_cracha OUT);
			 ELSE  l_cracha := l_crapro;
			 END IF;
			 l_numemp := :NEW.NUMEMP;
			 l_tipcol := 5;
			 l_numcad := :NEW.CADOCR;
		   END IF;
		 END IF;

		 /* SE A DATA FINAL DO HISTÓRICO DO VEICULO FOR ZERO OU MAIOR QUE 31/12/2050, ALTERA PARA  31/12/2050 */
		 IF (l_data_histo = l_data_zero) OR (l_data_histo > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
			l_data_histo := DATETIME(31, 12, 2050, 0, 0, 0);
			l_hora_histo := 1439;
		 END IF;

		 /* SE A DATA FINAL DO CADASTRO DO USUÁRIO FOR ZERO OU MAIOR QUE 31/12/2050, ALTERA PARA  31/12/2050 */
		 l_datval := :NEW.DATVAL;
		 l_horval := :NEW.HORVAL;
		 IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
			l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
			l_horval := 1439;
		 END IF;

		 /* SE POSSUI CRACHA DE VEICULO E DO CONDUTOR */
		 IF  (l_cracha <> 0) AND (l_cravei <> 0) THEN
			 /* SE TEM ACESSO LIVRE */
			 IF (:NEW.ACELIV = 'S') THEN
				/* PEGA A MENOR DATA FINAL ENTRE O HISTORICO DE CRACHA E O CADASTRO DO USUARIO */
				IF  (l_data_histo < l_datval) OR ((l_data_histo = l_datval) AND (l_hora_histo <= l_horval)) THEN
					SP_VEIPESCON('U', l_cravei, l_cracha, l_situa, :NEW.PLAVEI, 
								 l_data_histo, l_hora_histo, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
				ELSE 
					SP_VEIPESCON('U', l_cravei, l_cracha, l_situa, :NEW.PLAVEI, 
								 l_datval, l_horval, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
				END IF;
			 END IF;

			 /* SE ALTEROU DE ACESSO LIVRE PARA RESTRITO, ATUALIZA A CONTVEI */
			 IF  (:OLD.ACELIV = 'S') AND (:NEW.ACELIV = 'N') THEN
				 SP_VEIPESCON('U', l_cravei, l_cracha, 1, :NEW.PLAVEI, 
							  l_data_atual, l_hora_atual, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
			 END IF;
		 END IF;

		 /* SE ALTEROU O CONDUTOR, BLOQUEIA O ANTIGO */
		 IF (:OLD.TIPCLB <> :NEW.TIPCOL) OR (:OLD.NUMEMP <> :NEW.NUMEMP) OR (:OLD.TIPCOL <> :NEW.TIPCOL) OR
			(:OLD.NUMCAD <> :NEW.NUMCAD) OR (:OLD.CADOCR <> :NEW.CADOCR) THEN

			/* RETORNA O CRACHÁ DO CONDUTOR ANTIGO (COLABORADOR) */
			IF  (:OLD.TIPCLB = 1) THEN
				/* SE TIVER CRACHÁ PROVÍSÓRIO VALE ELE. SENÃO PEGAR O TITULAR */
				SP_RETCRA (2, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, 0,'',0,'',l_crapro OUT);
				IF   (l_crapro = 0)  THEN
					 SP_RETCRA (1, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD,0,'',0,'', l_cracha OUT);
				ELSE 
					l_cracha := l_crapro;
				END IF;
				l_numemp := :OLD.NUMEMP;
				l_tipcol := :OLD.TIPCOL;
				l_numcad := :OLD.NUMCAD;
			/* RETORNA O CRACHÁ DO CONDUTOR ANTIGO (COLABORADOR DE OUTRAS UNIDADES) */
			ELSE
				/* SE TIVER CRACHÁ PROVÍSÓRIO VALE ELE. SENÃO PEGAR O TITULAR */
				SP_RETCRA (2, :OLD.NUMEMP, 5, :OLD.CADOCR, 0,'',0,'',l_crapro OUT);
				IF   (l_crapro = 0)  THEN
					 SP_RETCRA (1, :OLD.NUMEMP, 5, :OLD.CADOCR, 0,'',0,'',l_cracha OUT);
				ELSE 
					l_cracha := l_crapro;
				END IF;
				l_numemp := :OLD.NUMEMP;
				l_tipcol := 5;
				l_numcad := :OLD.CADOCR;
			END IF;

			IF  (l_cracha <> 0) AND (l_cravei <> 0) THEN            
				SP_VEIPESCON('U', l_cravei, l_cracha, 1, :NEW.PLAVEI, 
							 l_data_atual, l_hora_atual, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
			END IF;
		 END IF;
	END IF;

	/* ATUALIZA REGISTROS DE AGENDAMENTOS NA CONTVEI */
	IF  (l_froonl = TRUE) AND (l_online = TRUE) THEN

		/* SE LIBERAR VEICULO PELO AGENDAMENTO */
		IF  (l_libvei = 2) THEN

			/* FAZ LOOP EM TODOS OS REGISTROS VÁLIDOS NA TABELA DE AGENDAMENTO */
			FOREACH c_r088agf INTO  l_r088agf.EmpCon,
									l_r088agf.TclCon,
									l_r088agf.CadCon,
									l_r088agf.DatRet,
									l_r088agf.HorRet
			LOOP
				/*  BUSCA PELO CRACHÁ DO COLABORADOR. */
				SP_RETCRA (2, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon, 0,'',0,'',l_crapro OUT);
				IF   (l_crapro = 0)  THEN
					 SP_RETCRA (1, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon,0,'',0,'', l_cracha OUT);
				ELSE l_cracha := l_crapro;
				END IF;

				/* SE A DATA FINAL DO CADASTRO DO USUÁRIO FOR ZERO OU MAIOR QUE 31/12/2050, ALTERA PARA  31/12/2050 */
				l_datval := :NEW.DATVAL;
				l_horval := :NEW.HORVAL;
				IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
				   l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
				END IF;

				/* SE A DATA FINAL DO AGENDAMENTO  FOR ZERO OU MAIOR QUE 31/12/2050, ALTERA PARA  31/12/2050 */
				IF (l_r088agf.datret = l_data_zero) OR (l_r088agf.datret > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
				   l_r088agf.datret := DATETIME(31, 12, 2050, 0, 0, 0);
				END IF;

				/* SE POSSUI CRACHÁ DE VEICULO E DE CONDUTOR */
				IF (l_cracha <> 0) AND (l_cravei <> 0) THEN

				   /* ATUALIZA A CONTVEI DE ACORDO COM A MENOR DATA */
				   IF   (l_datval < l_r088agf.datret) OR (l_datval = l_r088agf.datret AND l_horval <= l_r088agf.horret) THEN
					   SP_VEIPESCON('U', l_cravei, l_cracha, l_situa, :NEW.PLAVEI, 
									l_datval, l_horval, l_r088agf.tclcon, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon, 0, '');
				   ELSE 
					   SP_VEIPESCON('U', l_cravei, l_cracha, l_situa, :NEW.PLAVEI, 
									l_r088agf.datret, l_r088agf.horret, l_r088agf.tclcon, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon, 0, '');
				   END IF;
				END IF;
			END LOOP;
		END IF;
	END IF;
END␀àÜ␀␀		SENIOR;0d
␀␀

TRIGGER R088USU_ED AFTER DELETE ON R088USU FOR EACH ROW

DECLARE
l_online      BOOLEAN;
  l_cravei      NUMBER(12);
  l_crapro      NUMBER(12);
  l_cracha      NUMBER(12);
  l_data_zero   DATE;
  l_situa       NUMBER(1);
  l_usuonl      BOOLEAN;
  l_froonl      BOOLEAN;
  l_hora_atual  NUMBER(4);
  l_data_atual  DATE;
  l_numemp      NUMBER(4);
  l_tipcol      NUMBER(1);
  l_numcad      NUMBER(9);
BEGIN
	/* DATA/HORA ATUAL */
	l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
	l_data_atual := CURDATE();

	/* DEFINIÇÕES DE FROTA */
	SP_VerOnLine(l_online OUT);
	SP_Usuonline(l_froonl OUT, l_usuonl OUT);

	/* DATA ZERO E SITUA */
	l_data_zero :=  DATETIME(31, 12, 1900, 0, 0, 0);
	l_situa := 1;

	/* SE POSSUI FROTA E USUARIOS ONLINE, E O USUÁRIO TIVER ACESSO LIVRE */
	IF   (l_online = TRUE) AND (l_froonl = TRUE) AND (l_usuonl = TRUE) AND (:OLD.ACELIV = 'S') THEN

		 /* RETORNA O CRACHÁ DO VEÍCULO */
		 BEGIN
		 SELECT NUMCRA INTO l_cravei
				FROM R088HCH
				WHERE PLAVEI = :OLD.PLAVEI
				AND ((DATINI <= :OLD.DATALT) AND (DATFIM >= :OLD.DATALT
				OR DATFIM = l_data_zero)) AND STAACC = 1;
		 EXCEPTION
		 WHEN TOO_MANY_ROWS THEN
			  RAISERROR 103 'Erro no R088HCH - TOO MANY ROWS.';
		 WHEN NO_DATA_FOUND THEN
			  l_cravei := 0;
		 WHEN OTHERS THEN
			  RAISERROR 103 'Erro no SELECT em R088HCH.';
		 END;

		 /* RETORNA O CRACHÁ DO CONDUTOR (COLABORADOR) */
		 IF (:OLD.TIPCLB = 1) THEN
		   /* Se tiver crachá provísório vale ele. senão pegar o titular */
		   SP_RETCRA (2, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, 0,'',0,'',l_crapro OUT);
		   IF   (l_crapro = 0)  THEN
		       SP_RETCRA (1, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD,0,'',0,'', l_cracha OUT);
		   ELSE  
		       l_cracha := l_crapro;
		   END IF;
		   l_numemp := :OLD.NUMEMP;
		   l_tipcol := :OLD.TIPCOL;
		   l_numcad := :OLD.NUMCAD;
		 /* RETORNA O CRACHÁ DO CONDUTOR (COLABORADOR DE OUTRA UNIDADE) */
		 ELSE
		   /* Se tiver crachá provísório vale ele. senão pegar o titular */
		   SP_RETCRA (2, :OLD.NUMEMP, 5, :OLD.CADOCR, 0,'',0,'',l_crapro OUT);
		   IF   (l_crapro = 0)  THEN
		       SP_RETCRA (1, :OLD.NUMEMP, 5, :OLD.CADOCR, 0,'',0,'',l_cracha OUT);
		   ELSE  
		       l_cracha := l_crapro;
		   END IF;
		   l_numemp := :OLD.NUMEMP;
		   l_tipcol := 5;
		   l_numcad := :OLD.CADOCR;
		 END IF;

		 /* SE POSSUI CRACHA DE VEICULO E DO CONDUTOR */
		 IF (l_cracha <> 0) AND (l_cravei <> 0) THEN
		     SP_VEIPESCON('D', l_cravei, l_cracha, l_situa, :OLD.PLAVEI, 
						  l_data_atual, l_hora_atual, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
		 END IF;
	END IF;
