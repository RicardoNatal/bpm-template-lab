TRIGGER R195HPO_SI AFTER INSERT ON R195HPO

DECLARE
CURSOR c_R195HPO IS SELECT NUMEMP, CODCEN, TIPCOL, NUMCAD, INIATU, TERATU, CODTAP, ESTPOS, POSTRA
                        FROM R195HPO_AUX;

  TYPE t_R195HPO_AUX IS RECORD(
    NUMEMP   R195HPO_AUX.NUMEMP%TYPE,
    CODCEN   R195HPO_AUX.CODCEN%TYPE,
    TIPCOL   R195HPO_AUX.TIPCOL%TYPE,
    NUMCAD   R195HPO_AUX.NUMCAD%TYPE,
    INIATU   R195HPO_AUX.INIATU%TYPE,
    TERATU   R195HPO_AUX.TERATU%TYPE,
    CODTAP   R195HPO_AUX.CODTAP%TYPE,
    ESTPOS   R195HPO_AUX.ESTPOS%TYPE,
    POSTRA   R195HPO_AUX.POSTRA%TYPE
  );

  l_R195HPO_AUX t_R195HPO_AUX;
  l_IniAtu      DATE;
  l_TerAtu      DATE;
  l_PosTra        R195HPO.PosTra%TYPE;
BEGIN
  FOREACH c_R195HPO INTO l_R195HPO_AUX.NUMEMP,
                         l_R195HPO_AUX.CODCEN,
                         l_R195HPO_AUX.TIPCOL,
                         l_R195HPO_AUX.NUMCAD,
                         l_R195HPO_AUX.INIATU,
                         l_R195HPO_AUX.TERATU,
                         l_R195HPO_AUX.CODTAP,
                         l_R195HPO_AUX.ESTPOS,
                         l_R195HPO_AUX.POSTRA
  LOOP
    /* Busca registro do histórico anterior */
    BEGIN
      SELECT INIATU, POSTRA INTO l_IniAtu, l_PosTra
        FROM R195HPO
       WHERE NUMEMP = l_R195HPO_AUX.NUMEMP
         AND CODCEN = l_R195HPO_AUX.CODCEN
         AND TIPCOL = l_R195HPO_AUX.TIPCOL
         AND NUMCAD = l_R195HPO_AUX.NUMCAD
         AND CODTAP = l_R195HPO_AUX.CODTAP
         AND ESTPOS = l_R195HPO_AUX.ESTPOS
         AND INIATU = (SELECT MAX(R195HPO2.INIATU)
                         FROM R195HPO R195HPO2
                        WHERE R195HPO2.NUMEMP = l_R195HPO_AUX.NUMEMP
                          AND R195HPO2.CODCEN = l_R195HPO_AUX.CODCEN
                          AND R195HPO2.TIPCOL = l_R195HPO_AUX.TIPCOL
                          AND R195HPO2.NUMCAD = l_R195HPO_AUX.NUMCAD
                          AND R195HPO2.CODTAP = l_R195HPO_AUX.CODTAP
                          AND R195HPO2.ESTPOS = l_R195HPO_AUX.ESTPOS
                          AND R195HPO2.INIATU < l_R195HPO_AUX.INIATU);
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_IniAtu := NULL;
        l_PosTra := NULL;
      WHEN OTHERS THEN
        NULL;
    END;

    /* Atualiza data de término do histórico anterior */
    IF (l_IniAtu IS NOT NULL) THEN
      l_TerAtu := DATETIMEADD(DD, -1, l_R195HPO_AUX.INIATU);

      BEGIN
      UPDATE R195HPO
         SET TERATU = l_TerAtu
       WHERE NUMEMP = l_R195HPO_AUX.NUMEMP
         AND CODCEN = l_R195HPO_AUX.CODCEN
         AND TIPCOL = l_R195HPO_AUX.TIPCOL
         AND NUMCAD = l_R195HPO_AUX.NUMCAD
         AND CODTAP = l_R195HPO_AUX.CODTAP
         AND ESTPOS = l_R195HPO_AUX.ESTPOS
         AND INIATU = l_IniAtu
         AND POSTRA = l_PosTra;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar hisórico anterior.';
      END;
    END IF;

    /* Busca registro do histórico posteior */
    BEGIN
      SELECT MIN(INIATU) INTO l_TerAtu
        FROM R195HPO
       WHERE NUMEMP = l_R195HPO_AUX.NUMEMP
         AND CODCEN = l_R195HPO_AUX.CODCEN
         AND TIPCOL = l_R195HPO_AUX.TIPCOL
         AND NUMCAD = l_R195HPO_AUX.NUMCAD
         AND CODTAP = l_R195HPO_AUX.CODTAP
         AND ESTPOS = l_R195HPO_AUX.ESTPOS
         AND INIATU > l_R195HPO_AUX.INIATU;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_TerAtu := NULL;
      WHEN OTHERS THEN
        NULL;
    END;

    /* Se localizou um próximo registro de histórico subtrai-se um dia, caso não localizada seta a data futura */
    IF (l_TerAtu IS NULL) THEN
      l_TerAtu := '04/06/2080,00:00:00';
    ELSE
      l_TerAtu := DATETIMEADD(DD, -1, l_TerAtu);
    END IF;

    /* Atualiza o registro de histórico */
    BEGIN
      UPDATE R195HPO
         SET TERATU = l_TerAtu
       WHERE NUMEMP = l_R195HPO_AUX.NUMEMP
         AND CODCEN = l_R195HPO_AUX.CODCEN
         AND TIPCOL = l_R195HPO_AUX.TIPCOL
         AND NUMCAD = l_R195HPO_AUX.NUMCAD
         AND CODTAP = l_R195HPO_AUX.CODTAP
         AND ESTPOS = l_R195HPO_AUX.ESTPOS
         AND INIATU = l_R195HPO_AUX.INIATU
         AND POSTRA = l_R195HPO_AUX.POSTRA;
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao atualizar histório.';
    END;
  END LOOP;

  /* Apaga registros da tabela auxiliar R195HPO_AUX */
  BEGIN
    DELETE FROM R195HPO_AUX;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao excluir registros da tabela R195HPO_AUX.';
  END;
END␀Lä␀␀		SENIOR;0°␀␀TRIGGER R195HPO_EI AFTER INSERT ON R195HPO FOR EACH ROW

BEGIN
BEGIN
    INSERT INTO R195HPO_AUX(NUMEMP, CODCEN, TIPCOL, NUMCAD, INIATU, TERATU, CODTAP, ESTPOS, POSTRA)
                     VALUES(:NEW.NUMEMP, :NEW.CODCEN, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, :NEW.CODTAP, :NEW.ESTPOS, :NEW.POSTRA);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao inserir registro na tabela R195HPO_AUX.';
  END;
END␀Mä␀␀	SENIOR;0R␀␀

TRIGGER R195HPO_SD AFTER DELETE ON R195HPO

DECLARE
CURSOR c_R195HPO IS SELECT NUMEMP, CODCEN, TIPCOL, NUMCAD, INIATU, TERATU, CODTAP, ESTPOS, POSTRA
                        FROM R195HPO_AUX;

  TYPE t_R195HPO_AUX IS RECORD(
    NUMEMP   R195HPO_AUX.NUMEMP%TYPE,
    CODCEN   R195HPO_AUX.CODCEN%TYPE,
    TIPCOL   R195HPO_AUX.TIPCOL%TYPE,
    NUMCAD   R195HPO_AUX.NUMCAD%TYPE,
    INIATU   R195HPO_AUX.INIATU%TYPE,
    TERATU   R195HPO_AUX.TERATU%TYPE,
    CODTAP   R195HPO_AUX.CODTAP%TYPE,
    ESTPOS   R195HPO_AUX.ESTPOS%TYPE,
    POSTRA   R195HPO_AUX.POSTRA%TYPE
  );

  l_R195HPO_AUX t_R195HPO_AUX;
  l_IniAtu      DATE;
  l_TerAtu      DATE;
  l_PosTra        R195HPO.PosTra%TYPE;
BEGIN
  FOREACH c_R195HPO INTO l_R195HPO_AUX.NUMEMP,
                         l_R195HPO_AUX.CODCEN,
                         l_R195HPO_AUX.TIPCOL,
                         l_R195HPO_AUX.NUMCAD,
                         l_R195HPO_AUX.INIATU,
                         l_R195HPO_AUX.TERATU,
                         l_R195HPO_AUX.CODTAP,
                         l_R195HPO_AUX.ESTPOS,
                         l_R195HPO_AUX.POSTRA
  LOOP
    /* Busca registro do histórico anterior */
    BEGIN
      SELECT INIATU, POSTRA INTO l_IniAtu, l_PosTra
        FROM R195HPO
       WHERE NUMEMP = l_R195HPO_AUX.NUMEMP
         AND CODCEN = l_R195HPO_AUX.CODCEN
         AND TIPCOL = l_R195HPO_AUX.TIPCOL
         AND NUMCAD = l_R195HPO_AUX.NUMCAD
         AND CODTAP = l_R195HPO_AUX.CODTAP
         AND ESTPOS = l_R195HPO_AUX.ESTPOS
         AND INIATU = (SELECT MAX(R195HPO2.INIATU)
                         FROM R195HPO R195HPO2
                        WHERE R195HPO2.NUMEMP = l_R195HPO_AUX.NUMEMP
                          AND R195HPO2.CODCEN = l_R195HPO_AUX.CODCEN
                          AND R195HPO2.TIPCOL = l_R195HPO_AUX.TIPCOL
                          AND R195HPO2.NUMCAD = l_R195HPO_AUX.NUMCAD
                          AND R195HPO2.CODTAP = l_R195HPO_AUX.CODTAP
                          AND R195HPO2.ESTPOS = l_R195HPO_AUX.ESTPOS
                          AND R195HPO2.INIATU < l_R195HPO_AUX.INIATU);
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_IniAtu := NULL;
        l_PosTra := NULL;
      WHEN OTHERS THEN
        NULL;
    END;

    /* Atualiza data de término do histórico */
    IF (l_IniAtu IS NOT NULL) THEN
      BEGIN
      UPDATE R195HPO
         SET TERATU = l_R195HPO_AUX.TERATU
       WHERE NUMEMP = l_R195HPO_AUX.NUMEMP
         AND CODCEN = l_R195HPO_AUX.CODCEN
         AND TIPCOL = l_R195HPO_AUX.TIPCOL
         AND NUMCAD = l_R195HPO_AUX.NUMCAD
         AND CODTAP = l_R195HPO_AUX.CODTAP
         AND ESTPOS = l_R195HPO_AUX.ESTPOS
         AND INIATU = l_IniAtu
         AND POSTRA = l_PosTra;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar hisórico anterior.';
      END;
    END IF;
  END LOOP;

  /* Apaga registros da tabela auxiliar R195HPO_AUX */
  BEGIN
    DELETE FROM R195HPO_AUX;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao excluir registros da tabela R195HPO_AUX.';
  END;
END␀Kä␀␀		SENIOR;0´␀␀

TRIGGER R195HPO_ED AFTER DELETE ON R195HPO FOR EACH ROW

BEGIN
BEGIN
    INSERT INTO R195HPO_AUX(NUMEMP, CODCEN, TIPCOL, NUMCAD, INIATU, TERATU, CODTAP, ESTPOS, POSTRA)
                     VALUES(:OLD.NUMEMP, :OLD.CODCEN, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.INIATU, :OLD.TERATU, :OLD.CODTAP, :OLD.ESTPOS, :OLD.POSTRA);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao inserir registro na tabela R195HPO_AUX.';
  END;
