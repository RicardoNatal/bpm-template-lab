 ␀␀

PROCEDURE SP_PROSIN(P_VALSTR VARCHAR2(2047),P_RETSIN OUT NUMBER)
 IS

    l_horSin    NUMBER(4);
    l_datSin    DATE;
    l_seqSin    NUMBER(2);
    l_codSin    NUMBER(2);
    l_coderr    NUMBER(2);
    l_count     NUMBER(4);    
BEGIN
    /* inicializa variáveis */
    l_codsin := 0;
    l_coderr := 0;
    p_RetSin := 0;

    l_datSin := CURDATE();
    l_horSin := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_seqSin := SECOND(CURTIME());

    /* Quebra a string para verificar qual o valor do comando de sincronismo */
    l_codsin := SUBSTRING(p_ValStr, 1,2);

    IF  (l_codSin = 1) THEN
        SP_SINHCH(p_ValStr, l_coderr OUT);   /* Histórico de crachás */
    END IF;

    IF  (l_codSin = 2) THEN
        SP_SINASA(p_ValStr, l_coderr OUT);   /* Autorização de saída */
    END IF;

    IF  (l_codSin = 3) THEN
        SP_SINFIS(p_ValStr, l_coderr OUT);   /* Número físico */
    END IF;

    IF  (l_codSin = 4) THEN
        SP_SINMEV(p_ValStr, l_coderr OUT);   /* Movimentação de locais físicos - Evacuação */
    END IF;
    
    IF  (l_codSin = 5) THEN
        SP_SINENTVIS(p_ValStr, l_coderr OUT);   /* Entrada de visitantes */
    END IF;
    
    IF  (l_codSin = 6) THEN
        SP_SINMVI(p_ValStr, l_coderr OUT);   /* Saída de visitantes */
    END IF;
    
   IF  (l_codSin = 11) THEN
        SP_SINLIJ(p_ValStr, l_coderr OUT);   /* Liberação de interjornada */
    END IF;
    
    IF  (l_codSin = 12) THEN
        SP_SINLFH(p_ValStr, l_coderr OUT);   /* Liberação de faixa horária */
    END IF;

    IF  (l_codSin = 13) THEN
        SP_SININC(p_ValStr, l_coderr OUT);   /* Ocorrência de incidente de pessoa não grata na portaria */
    END IF;
        
    /* Se gerou erros, grava na tabela de exceções  */
    IF  (l_codErr > 0) THEN
        
        /* verifica se existe registro com a mesma chave */
        LOOP
            l_count := 0;
            BEGIN
                SELECT COUNT(*) INTO l_count FROM R070SIN WHERE CODSIN = l_CodSIn AND DATSIN = l_DatSin AND HORSIN = l_HorSin AND SEQSIN = l_seqSin;
            EXCEPTION
                WHEN OTHERS THEN l_count := 1;
            END;
            
            IF (l_count = 0)  OR (l_seqSin > 60) THEN
                EXIT;
            ELSE
                l_seqSin := l_seqSin + 1;
            END IF;        
        END LOOP; /* End loop*/
        
        IF  (l_seqSin > 60) THEN
            p_retSin := 1;  /* Se retornar esse erro a CSM tem q gravar um log e continuar o sincronismo */
        ELSE
	        BEGIN
	            INSERT INTO R070SIN (CODSIN,DATSIN,HORSIN,SEQSIN,VALSIN,STASIN) VALUES
	                                (l_CodSIn, l_DatSin, l_HorSin, l_seqSin, p_valStr, l_codErr);
	        EXCEPTION
	            WHEN OTHERS THEN p_retSin := 1;  /* Se retornar esse erro a CSM tem q gravar um log e continuar o sincronismo */
	        END;        
        END IF;  
    END IF;
END␀’ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
¾PROCEDURE SP_PROXHIST_NPER(P_CAMPODATA VARCHAR2(255), P_TABELA VARCHAR2(255),P_SQL VARCHAR2(255),P_DATAINICIO DATE,P_DATAFIM OUT DATE)
 IS
BEGIN
  P_DATAFIM := '31/12/1900,00:00:00';
END	ORACLE;0
‡␀␀CREATE OR REPLACE
PROCEDURE SP_PROXHIST_NPER(
    P_CAMPODATA  IN VARCHAR2,
    P_TABELA     IN VARCHAR2,
    P_WHERE      IN VARCHAR2,
    P_DATAINICIO IN DATE,
    P_DATAFIM OUT DATE )
IS
  PRAGMA AUTONOMOUS_TRANSACTION;
  l_ProximaData DATE;
  l_Sql VARCHAR2(2000);
BEGIN
  BEGIN
    l_Sql := 'SELECT NVL(MIN('||P_CAMPODATA||')-1, TO_DATE(''31/12/1900'',''DD/MM/YYYY'')) FROM '||P_TABELA||' WHERE '||P_WHERE||' AND '||p_CampoData||' > :'||p_CampoData;
    EXECUTE IMMEDIATE l_Sql INTO l_ProximaData USING P_DATAINICIO;
  EXCEPTION
  WHEN OTHERS THEN
    NULL;
  END;

  P_DATAFIM := l_ProximaData;
END SP_PROXHIST_NPER;

	MSSQL;0
(␀␀CREATE PROCEDURE SP_PROXHIST_NPER
(
	@p_CampoData VARCHAR(100),
	@p_Tabela VARCHAR(100),
	@p_Where VARCHAR(1800),
	@p_DataInicio DATETIME,
	@p_DataFim DATETIME OUTPUT
) AS
BEGIN
DECLARE @l_ProximaData DATETIME
DECLARE @l_ParmDefinition nvarchar(500)
DECLARE @l_Sql NVARCHAR(2000)  

  SELECT @l_Sql = 'SELECT '+N'@l_ProximaDataOUT = ISNULL(MIN('+@p_CampoData+')-1, CONVERT(DATETIME,''31/12/1900'',103)) FROM '+@p_Tabela+' WHERE '+@p_Where+' AND '+@p_CampoData+' > @l_CampoData';  
  SET @l_ParmDefinition = N'@l_CampoData DATETIME, @l_ProximaDataOUT DATETIME OUTPUT';
  
  EXECUTE sp_executesql @l_Sql, @l_ParmDefinition,
                      @l_CampoData = @p_DataInicio,
                      @l_ProximaDataOUT = @l_ProximaData OUTPUT;
  
  SELECT @p_DataFim = @l_ProximaData;
END

	POSTGRESQL;0
˜␀␀CREATE OR REPLACE PROCEDURE SP_PROXHIST_NPER( P_CAMPODATA VARCHAR, P_TABELA VARCHAR, P_WHERE VARCHAR, P_DATAINICIO timestamp without time zone, P_DATAFIM IN OUT timestamp without time zone)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  l_ProximaData DATE;
  l_Sql VARCHAR(2000);
BEGIN
  BEGIN
    l_Sql := 'SELECT COALESCE(to_timestamp(EXTRACT(EPOCH from MIN('||P_CAMPODATA||'))-1), TO_DATE(''31/12/1900'',''DD/MM/YYYY'')) FROM '||P_TABELA||' WHERE '||P_WHERE||' AND '||p_CampoData||' > $1';
	BEGIN 
		EXECUTE l_Sql USING P_DATAINICIO INTO l_ProximaData;
	END;
  EXCEPTION
  WHEN OTHERS THEN
    NULL;
  END;

  P_DATAFIM := l_ProximaData;
END;
$BODY$;␀“ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ÁPROCEDURE SP_PROXIMOHIST(P_CAMPO VARCHAR2(255),P_TABELA VARCHAR2(255),P_SQL VARCHAR2(255),P_DATAINICIO DATE,P_DATAFIM OUT DATE)
 IS
BEGIN
  P_DATAFIM := DATETIME(30, 12, 1900, 0, 0, 0);
END	ORACLE;0
S␀␀create or replace PROCEDURE SP_PROXIMOHIST(
    P_CAMPODATA  IN VARCHAR2,
    P_TABELA     IN VARCHAR2,
    P_WHERE      IN VARCHAR2,
    P_DATAINICIO IN DATE,
    P_DATAFIM OUT DATE )
IS
  PRAGMA AUTONOMOUS_TRANSACTION;
  l_ProximaData DATE;
  l_DataInicio DATE;
  l_Sql VARCHAR2(2000);
BEGIN
  l_ProximaData := TO_DATE('31/12/1900,00:00:00','DD/MM/YYYY,HH24:MI:SS');  
  l_DataInicio  := ADD_MONTHS(TRUNC(P_DATAINICIO, 'MONTH'), 1);
  BEGIN
    l_Sql := 'SELECT MIN('||P_CAMPODATA||') FROM '||P_TABELA||' WHERE '||P_WHERE||' AND '||p_CampoData||' >= :'||p_CampoData;
    EXECUTE IMMEDIATE l_Sql
    INTO l_ProximaData
    USING l_DataInicio;   
    l_ProximaData := ADD_MONTHS(TRUNC(l_ProximaData, 'MONTH'), -1);    
  EXCEPTION  
  WHEN OTHERS THEN
    NULL;
  END;
  
  P_DATAFIM := l_ProximaData;
END SP_PROXIMOHIST;

	MSSQL;0
␀␀CREATE PROCEDURE SP_PROXIMOHIST
(
	@p_CampoData VARCHAR(100),
	@p_Tabela VARCHAR(100),
	@p_Where VARCHAR(1800),
	@p_DataInicio DATETIME,
	@p_DataFim DATETIME OUTPUT
) AS
BEGIN
DECLARE @l_ProximaData DATETIME
DECLARE @l_DataInicio DATETIME
DECLARE @l_ParmDefinition nvarchar(500)
DECLARE @l_Sql NVARCHAR(2000)  

  SELECT @l_ProximaData = CONVERT(DATETIME,'12/31/1900 00:00:00', 101);
  SELECT @l_DataInicio = DATEADD(mm, DATEDIFF(mm, 0, @p_DataInicio) + 1, 0);
  SELECT @l_Sql = 'SELECT '+N'@l_ProximaDataOUT = MIN('+@p_CampoData+') FROM '+@p_Tabela+' WHERE '+@p_Where+' AND '+@p_CampoData+' >= @l_CampoData';  
  SET @l_ParmDefinition = N'@l_CampoData DATETIME, @l_ProximaDataOUT DATETIME OUTPUT';
  
  EXECUTE sp_executesql @l_Sql, @l_ParmDefinition,
                      @l_CampoData = @l_DataInicio,
                      @l_ProximaDataOUT = @l_ProximaData OUTPUT;                    
  SELECT @l_ProximaData = DATEADD(mm, DATEDIFF(mm, 0, @l_ProximaData) - 1, 0);
  SELECT @p_DataFim = @l_ProximaData;
END

	POSTGRESQL;0
␀␀CREATE OR REPLACE PROCEDURE SP_PROXIMOHIST( 
	P_CAMPODATA VARCHAR, P_TABELA VARCHAR, 
	P_WHERE VARCHAR, 
	P_DATAINICIO timestamp without time zone, 
	P_DATAFIM IN OUT timestamp without time zone)
	
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  l_ProximaData timestamp without time zone;
  l_DataInicio timestamp without time zone;
  l_Sql VARCHAR(2000);
BEGIN
  l_ProximaData := TO_DATE('31/12/1900,00:00:00','DD/MM/YYYY,HH24:MI:SS');
  l_DataInicio  := (DATE_TRUNC('MONTH', P_DATAINICIO) + ('1 MONTHS')::INTERVAL)::timestamp;  
  BEGIN
    l_Sql := 'SELECT MIN('||P_CAMPODATA||') FROM '||P_TABELA||' WHERE '||P_WHERE||' AND '||p_CampoData||' >= $1';  
    EXECUTE l_Sql USING l_DataInicio INTO l_ProximaData;
	l_ProximaData := (DATE_TRUNC('MONTH', l_ProximaData) - ('1 MONTHS')::INTERVAL)::timestamp; 
  EXCEPTION
  WHEN OTHERS THEN
    NULL;
  END;
  P_DATAFIM := l_ProximaData;
END;
$BODY$;␀”ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
