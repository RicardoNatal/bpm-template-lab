␀␀0#é␀␀		SENIOR;0„␀␀TRIGGER R350STA_EI BEFORE INSERT ON R350STA FOR EACH ROW
DECLARE
   l_datahora_registro DATE;
BEGIN
	BEGIN
	    SP_DATAHORA_DATE(l_datahora_registro OUT);
		INSERT INTO R030STA (PIDEXC,SEQSTA,PIDPEN,DATHOR,LAYOUT,NUMREC,USUREC,DESRET,DESRES,CODUSU,STASIT,NUMEMP,FILEMP,TIPCOL,NUMCAD,CODFIL,TABORG,NUMLOC,CODSIT,CODESC,CODCCU,CODOEM,ESTSAL,CODVIN,TURINT,TIPATN,CODEXA,ESTCAR,CODCAR,CODTHP,CPFTRA,PERAPU,INDAPU,IDEEVE,ULTENV,INIVAL,CPFEMP,PENEXT,IDEANT,PIDORI,INDRET,NROREC,CLAEVE,DATREG, CFJINS) 
		VALUES (:NEW.PIDEXC,1,:NEW.PIDPEN,:NEW.DATHOR,:NEW.LAYOUT,:NEW.NUMREC,:NEW.USUREC,:NEW.DESRET,:NEW.DESRES,:NEW.CODUSU,:NEW.STASIT,:NEW.NUMEMP,:NEW.FILEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODFIL,:NEW.TABORG,:NEW.NUMLOC,:NEW.CODSIT,:NEW.CODESC,:NEW.CODCCU,:NEW.CODOEM,:NEW.ESTSAL,:NEW.CODVIN,:NEW.TURINT,:NEW.TIPATN,:NEW.CODEXA,:NEW.ESTCAR,:NEW.CODCAR,:NEW.CODTHP,:NEW.CPFTRA,:NEW.PERAPU,:NEW.INDAPU,:NEW.IDEEVE,:NEW.ULTENV,:NEW.INIVAL,:NEW.CPFEMP,:NEW.PENEXT,:NEW.IDEANT,:NEW.PIDORI,:NEW.INDRET,:NEW.NROREC,:NEW.CLAEVE, l_datahora_registro, :NEW.CFJINS);
	EXCEPTION
	  WHEN OTHERS THEN
			RAISERROR 103 'Erro ao registrar back-up do status.';
	END;
END␀$é␀␀		SENIOR;0{␀␀


TRIGGER R350STA_EU BEFORE UPDATE ON R350STA FOR EACH ROW
DECLARE
   l_Valido BOOLEAN;
   l_Sequencia INTEGER;
   l_datahora_registro DATE;
BEGIN

	/*##CNPJ-ALFA##*/
	/* Na criação do campo RUNCNV o mesmo está com null. No update feito pelo conversor CNPJ Alfa, 
	 * o RUNCNV é gravado com 1, neste caso, estando o OLD e NEW diferentes, neste caso o backup 
	 * na R030STA não será relizado. O campo RUNCNV somente é atualizado pelo conversor do cnpj alfa 
	 * e não pelo sistema. Quando o OLD e NEW estiverem iguais é um processo normal do sistema 
	 * e já ocorreu a conversão, a trigger segue normalmente.
	 */
	IF ( (IFNULL(:OLD.RUNCNV,0)) = (IFNULL(:NEW.RUNCNV,0)) ) THEN
	/*##CNPJ-ALFA##*/
	
		l_Sequencia := 0;
		/* Se o número do recibo for informado e for uma pendência dos leiautes de envio inicial do colaborador (S-2200, S-2300 ou S-2298),
		* então atualiza a R034MAT, campo RECESO, para sabermos que o leiaute foi retornado com sucesso pelo governo.
		*/
		/* Substituída chamada "SP_VALUPDATE_DES(:OLD.NUMREC, :NEW.NUMREC, l_Valido OUT);" pela validação abaixo. */
        l_Valido := FALSE;
        /* Verifica se o novo valor foi preenchido */
        IF (:NEW.NUMREC IS NOT NULL AND LENGTH(RTRIM(LTRIM(:NEW.NUMREC))) <> 0) THEN
          /* Verifica se o valor antigo estava vazio ou se mudou */
          IF (:OLD.NUMREC IS NULL OR LENGTH(RTRIM(LTRIM(:OLD.NUMREC))) = 0) THEN
            l_Valido := TRUE;
          ELSIF (:OLD.NUMREC <> :NEW.NUMREC) THEN
            l_Valido := TRUE;
          END IF;
        END IF;		
		IF (l_Valido = TRUE) THEN
			IF (LTRIM(RTRIM(:NEW.LAYOUT)) = 'S-2200' OR 
				LTRIM(RTRIM(:NEW.LAYOUT)) = 'S-2300' OR 
				LTRIM(RTRIM(:NEW.LAYOUT)) = 'S-2298' OR 
				LTRIM(RTRIM(:NEW.LAYOUT)) = 'S-2210' OR
				LTRIM(RTRIM(:NEW.LAYOUT)) = 'S-2220' OR
				LTRIM(RTRIM(:NEW.LAYOUT)) = 'S-2221' OR
				LTRIM(RTRIM(:NEW.LAYOUT)) = 'S-2240' OR
				LTRIM(RTRIM(:NEW.LAYOUT)) = 'S-2400') THEN    
				BEGIN
					UPDATE R034MAT SET RECESO = 'S'
					WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD AND (LTRIM(RTRIM(RECESO)) IS NULL OR LTRIM(RTRIM(RECESO)) <> 'S');
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'Erro ao atualizar registro na tabela de matrícula eSocial.';
				END;
			END IF;
		END IF;
	
		BEGIN
			SELECT IFNULL(MAX(SEQSTA), 0) + 1 INTO l_Sequencia
		  	FROM R030STA
		 	WHERE R030STA.PIDEXC = :NEW.PIDEXC;
		EXCEPTION
			WHEN OTHERS THEN 
				RAISERROR 103 'Erro ao consultar maior sequência de back-up.';	
		END;
	
		BEGIN
		    SP_DATAHORA_DATE(l_datahora_registro OUT);
			INSERT INTO R030STA (PIDEXC,SEQSTA,PIDPEN,DATHOR,LAYOUT,NUMREC,USUREC,DESRET,DESRES,CODUSU,STASIT,NUMEMP,FILEMP,TIPCOL,NUMCAD,CODFIL,TABORG,NUMLOC,CODSIT,CODESC,CODCCU,CODOEM,ESTSAL,CODVIN,TURINT,TIPATN,CODEXA,ESTCAR,CODCAR,CODTHP,CPFTRA,PERAPU,INDAPU,IDEEVE,ULTENV,INIVAL,CPFEMP,PENEXT,IDEANT,PIDORI,INDRET,NROREC,CLAEVE,DATREG,CFJINS) 
			VALUES (:NEW.PIDEXC,l_Sequencia,:NEW.PIDPEN,:NEW.DATHOR,:NEW.LAYOUT,:NEW.NUMREC,:NEW.USUREC,:NEW.DESRET,:NEW.DESRES,:NEW.CODUSU,:NEW.STASIT,:NEW.NUMEMP,:NEW.FILEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODFIL,:NEW.TABORG,:NEW.NUMLOC,:NEW.CODSIT,:NEW.CODESC,:NEW.CODCCU,:NEW.CODOEM,:NEW.ESTSAL,:NEW.CODVIN,:NEW.TURINT,:NEW.TIPATN,:NEW.CODEXA,:NEW.ESTCAR,:NEW.CODCAR,:NEW.CODTHP,:NEW.CPFTRA,:NEW.PERAPU,:NEW.INDAPU,:NEW.IDEEVE,:NEW.ULTENV,:NEW.INIVAL,:NEW.CPFEMP,:NEW.PENEXT,:NEW.IDEANT,:NEW.PIDORI,:NEW.INDRET,:NEW.NROREC,:NEW.CLAEVE, l_datahora_registro, :NEW.CFJINS);
		EXCEPTION
		  	WHEN OTHERS THEN
				RAISERROR 103 'Erro ao registrar back-up do status.';
		END;    

	/*##CNPJ-ALFA##*/
	END IF;
	/*##CNPJ-ALFA##*/
			
END␀"é␀␀		SENIOR;0Ô␀␀

TRIGGER R350STA_ED AFTER DELETE ON R350STA FOR EACH ROW
DECLARE
    l_Valor VARCHAR(300);
    l_datatu DATE;
    l_horatu NUMBER(5);
    l_Usuario NUMBER(10);
    l_nomeUsuario VARCHAR2(40); 
    l_usu_temp VARCHAR2(40);
    l_NumSec NUMBER(14);
    l_Programa VARCHAR2(100);
    l_Maquina VARCHAR2(100);
    l_datstr CHAR(6);
    l_horstr CHAR(4);
BEGIN
    /* Calcula data hora atual. */
    l_datatu := CURDATE();
    l_horatu := HOUR(CURTIME()) * 60 + MINUTE(CURTIME());
    SP_DATSTR(l_datatu, 'DDMMYY', l_datstr OUT);
    SP_INTSTR(l_horatu, 'HHMM', l_horstr OUT);

    l_NumSec := 0;
    l_Programa := '';
    l_Maquina := '';
     SP_GETSESSIONID(l_NumSec OUT, l_Programa OUT, l_Maquina OUT); 

    /* Retorna o código do usuário que está executando a ação */
    l_Usuario := 0;
    l_nomeUsuario := '';
    SP_GETCODUSU(l_Usuario OUT, l_nomeUsuario OUT); 

    IF (l_Usuario = 0) THEN
        l_usu_temp := '; Usuário: Não identificado';
    ELSE
        l_usu_temp := '; Usuário:' || CONVERT(NUMBER_TO_CHAR, l_Usuario) || '.' || l_nomeUsuario;
    END IF;

    l_Valor := ' Delete R350STA;' || :OLD.LayOut 
        || '; PidExc: ' || :OLD.PidExc 
        || '; Maquina: ' || LTRIM(RTRIM(l_Maquina)) 
        || '; Prog: ' || l_Programa 
        || '; Data: ' || l_datstr 
        || '; Hora: ' || l_horstr 
        || l_usu_temp;

    /* LTipLPr 242 eSocial - Log exclusão R350sta" */
    
    SP_GRAVALPR(242, l_Valor);
    
