    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R108NAC_AD: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINDAGR',CONVERT(NUMBER_TO_CHAR,:OLD.INDAGR));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDESAGR',:OLD.DESAGR);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOTENV',:OLD.NOTENV);
      SP_DATSTR(:OLD.DATENV, 'DD/MM/YYYY', l_datTemp OUT);
	  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATENV', l_datTemp);   
    END;
  END IF;
