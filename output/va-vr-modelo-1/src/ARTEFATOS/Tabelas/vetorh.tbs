␀␀PROCEDURE R064EXT_FH(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER)
 IS

l_cracha       NUMBER(12);
  l_crastr       CHAR(12);
  l_craaux       NUMBER(12);
  l_faidom_a     CHAR(56);
  l_faiseg_a     CHAR(56);
  l_faiter_a     CHAR(56);
  l_faiqua_a     CHAR(56);
  l_faiqui_a     CHAR(56);
  l_faisex_a     CHAR(56);
  l_faisab_a     CHAR(56);
  l_faidom_p     CHAR(56);
  l_faiseg_p     CHAR(56);
  l_faiter_p     CHAR(56);
  l_faiqua_p     CHAR(56);
  l_faiqui_p     CHAR(56);
  l_faisex_p     CHAR(56);
  l_faisab_p     CHAR(56);
  l_fairef       CHAR(56);
  /*Controle de permissão para 3º turno*/
  l_prmsabequal  NUMBER;
  l_prmdomequal  NUMBER;
  l_prmsegequal  NUMBER;
  /* afastamentos */
  l_datini       CHAR(6);
  l_datfim       CHAR(6);
  l_horini       CHAR(4);
  l_horfim       CHAR(4);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_apupfs       CHAR(1);
BEGIN
l_apupfs := 'E';
SP_RETCRA_IDTPES (1,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
IF   l_cracha = 0 THEN
     SP_RETCRA_IDTPES (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
END IF;

/* Verifica se Colaborador possui Cracha */
IF  l_cracha <> 0  THEN
    /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
    SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
    IF (l_crapri = 0) THEN
        l_crapri := l_cracha;
    END IF;

    SP_APUCOL(p_numemp, p_tipcol, p_numcad, l_apupfs OUT);
    /*Se o controle for por atividades do professor*/
    IF (l_apupfs = 'A') THEN
        SP_FaiPro(p_numemp,p_tipcol,p_numcad,
                  l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                  l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                  l_fairef OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);
    ELSE
        SP_FaiHor(p_numemp,p_tipcol,p_numcad,
                  l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                  l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                  l_fairef OUT, l_prmsabequal OUT, l_prmdomequal OUT, l_prmsegequal OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);
    END IF;

    /* atualiza a tabela R070CON */
    BEGIN
        UPDATE R070CON SET
               FAIAC1=l_faidom_a,FAIAC2=l_faiseg_a,FAIAC3=l_faiter_a,FAIAC4=l_faiqua_a,
               FAIAC5=l_faiqui_a,FAIAC6=l_faisex_a,FAIAC7=l_faisab_a,
               FAIPT1=l_faidom_p,FAIPT2=l_faiseg_p,FAIPT3=l_faiter_p,FAIPT4=l_faiqua_p,
               FAIPT5=l_faiqui_p,FAIPT6=l_faisex_p,FAIPT7=l_faisab_p,
               FAIREF=l_fairef
        WHERE NUMFIS = l_crapri;
    EXCEPTION
        WHEN OTHERS THEN NULL;
    END;

END IF;
END␀²Ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_ATUHOR
ä␀␀PROCEDURE R064PON_VerPon(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATHO1 DATE,P_DATHO2 DATE)
 IS

l_data_limite DATE;
  l_data_atual  DATE;
BEGIN
  /* Valida Datas */
  l_data_atual := CURDATE();
  l_data_limite := DATETimeAdd(DD,6,l_data_atual);
  IF   ((p_datho1 >= l_data_atual) AND (p_datho1 <= l_data_limite))
  OR   ((p_datho2 >= l_data_atual) AND (p_datho2 <= l_data_limite)) THEN
       SP_AtuHor (p_numemp, p_tipcol, p_numcad,'');
  END IF;
END␀ÆØ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_ATUHOR
a␀␀PROCEDURE R064TES_VTE(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATINI DATE,P_DATFIM DATE,P_STATUS NUMBER)
 IS

l_data_zero   DATE;
  l_data_limite DATE;
  l_data_atual  DATE;
BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_data_limite := DATETimeAdd(DD,6,l_data_atual);
  /* verifica se abrange periodo atual */
  IF   ((l_data_atual >= p_datini) OR (l_data_limite >= p_datini))
  AND  ((l_data_atual <= p_datfim) OR (l_data_limite <= p_datfim) OR (p_datfim = l_data_zero)) THEN
       SP_AtuHor (p_numemp, p_tipcol, p_numcad,'');
  END IF;
END␀ÉØ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_ATUHOR
␀␀PROCEDURE R064THR_CON(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATINI DATE)
 IS

l_data_limite DATE;
  l_data_atual  DATE;
BEGIN
  /* Valida Datas */
  l_data_atual := CURDATE();
  l_data_limite := DATETimeAdd(DD,6,l_data_atual);
  IF   (p_datini >= l_data_atual)
  AND  (p_datini <= l_data_limite) THEN
       SP_AtuHor (p_numemp, p_tipcol, p_numcad,'');
  END IF;
END␀ÑØ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
