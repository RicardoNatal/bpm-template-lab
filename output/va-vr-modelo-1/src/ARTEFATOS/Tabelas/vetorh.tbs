  /* Confirmação p/ o solicitante do agendamento por e-mail */
  ELSIF (p_TipPNo = 5)  AND (p_EmaSol IS NOT NULL AND LOCATE('@', p_EmaSol, 1) > 0) THEN
    /*GERA A STRING DO CODIGO LOCALIZADOR*/
    SP_CODLOCALIZADOR(p_CodOri, l_LocAgvStr OUT);  
  
    /* ORACLE */ 
    /*l_codnot := SEQ_R115NOT.nextval;
    
