				IF (l_r034EDP.AUTDBL = 2) THEN /* VALOR VEM DO POSTO ADICIONAL. RESTAURO O VALOR DO POSTO PRINCIPAL. */
					l_r034DAC.AUTDBL := l_r017DAC.AUTDBL;
					l_r034EDP.AUTDBL := 1;
