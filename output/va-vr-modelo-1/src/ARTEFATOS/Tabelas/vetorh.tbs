PROCEDURE SP_FAIVISPAC(P_PROPAC VARCHAR2(20),P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56))
 IS

l_striac      CHAR(4);
  l_strfac      CHAR(4);
  l_faidom_ace  VARCHAR2(255);
  l_faiseg_ace  VARCHAR2(255);
  l_faiter_ace  VARCHAR2(255);
  l_faiqua_ace  VARCHAR2(255);
  l_faiqui_ace  VARCHAR2(255);
  l_faisex_ace  VARCHAR2(255);
  l_faisab_ace  VARCHAR2(255);
  l_contfai     INTEGER;
  l_lengfai     INTEGER;
  l_horseg      NUMBER(4);
  l_horter      NUMBER(4);
  l_horqua      NUMBER(4);
  l_horqui      NUMBER(4);
  l_horsex      NUMBER(4);
  l_horsab      NUMBER(4);
  l_hordom      NUMBER(4);
  l_atualiza    BOOLEAN;

  /* HORÁRIOS */
  CURSOR c_r004fhr IS
  SELECT CODHOR,INIACE,FIMACE FROM R004FHR;
  TYPE t_r004fhr IS RECORD(
      CODHOR   R004FHR.CODHOR%TYPE,
      INIACE   R004FHR.INIACE%TYPE,
      FIMACE   R004FHR.FIMACE%TYPE);
  l_r004fhr t_r004fhr;

BEGIN
  /* Inicializa */
  l_faidom_ace  := '00002359240024002400240024002400240024002400240024002400';
  l_faiseg_ace  := '00002359240024002400240024002400240024002400240024002400';
  l_faiter_ace  := '00002359240024002400240024002400240024002400240024002400';
  l_faiqua_ace  := '00002359240024002400240024002400240024002400240024002400';
  l_faiqui_ace  := '00002359240024002400240024002400240024002400240024002400';
  l_faisex_ace  := '00002359240024002400240024002400240024002400240024002400';
  l_faisab_ace  := '00002359240024002400240024002400240024002400240024002400';
  l_atualiza    := TRUE;

 BEGIN
      SELECT R097HVI.HORDOM, R097HVI.HORSEG, R097HVI.HORTER, R097HVI.HORQUA,
             R097HVI.HORQUI, R097HVI.HORSEX, R097HVI.HORSAB
        INTO l_hordom, l_horseg, l_horter, l_horqua, l_horqui, l_horsex, l_horsab
        FROM R058PLF, R097MOP, R097HVI
       WHERE R058PLF.VERPLF = R097MOP.VERPLF AND R058PLF.CODPLF = R097MOP.CODPLF
             AND R058PLF.CODHVI = R097HVI.CODHVI AND R097MOP.PROPAC = p_propac
             AND R097MOP.DATMOV = (SELECT DISTINCT MAX(B.DATMOV) FROM R097MOP B WHERE B.PROPAC = p_propac)
             AND R097MOP.HORMOV = (SELECT DISTINCT MAX(B.HORMOV) FROM R097MOP B WHERE B.PROPAC = p_propac AND B.DATMOV = (SELECT DISTINCT MAX(B.DATMOV) FROM R097MOP B WHERE B.PROPAC = p_propac))
             AND R097MOP.SEQMOV = (SELECT DISTINCT MAX(B.SEQMOV) FROM R097MOP B WHERE B.PROPAC = p_propac AND B.DATMOV = (SELECT DISTINCT MAX(B.DATMOV) FROM R097MOP B WHERE B.PROPAC = p_propac) AND 
                                                                                      B.HORMOV = (SELECT DISTINCT MAX(B.HORMOV) FROM R097MOP B WHERE B.PROPAC = p_propac)
             );
  EXCEPTION
      WHEN OTHERS THEN l_atualiza := FALSE;
  END;

  IF (l_atualiza = TRUE) THEN

    l_faidom_ace  := '';
    l_faiseg_ace  := '';
    l_faiter_ace  := '';
    l_faiqua_ace  := '';
    l_faiqui_ace  := '';
    l_faisex_ace  := '';
    l_faisab_ace  := '';

    FOREACH c_r004fhr INTO l_r004fhr.codhor,
                           l_r004fhr.iniace,
                           l_r004fhr.fimace

    LOOP
        SP_INTSTR(l_r004fhr.iniace,'HHMM',l_striac OUT);
        SP_INTSTR(l_r004fhr.fimace,'HHMM',l_strfac OUT);
        IF  (l_r004fhr.codhor = l_hordom) THEN
            /* domingo */
            IF  ((LENGTH(l_faidom_ace)) < 49) OR ((LENGTH(l_faidom_ace) IS NULL)) THEN
                l_faidom_ace := l_faidom_ace || l_striac || l_strfac;
            END IF;
        END IF;
        IF  (l_r004fhr.codhor = l_horseg) THEN
            /* segunda-feira */
            IF  ((LENGTH(l_faiseg_ace)) < 49) OR ((LENGTH(l_faiseg_ace) IS NULL)) THEN
                l_faiseg_ace := l_faiseg_ace || l_striac || l_strfac;
            END IF;
        END IF;
        IF  (l_r004fhr.codhor = l_horter) THEN
            /* terça-feira */
            IF  ((LENGTH(l_faiter_ace)) < 49) OR ((LENGTH(l_faiter_ace) IS NULL)) THEN
                l_faiter_ace := l_faiter_ace || l_striac || l_strfac;
            END IF;
        END IF;
        IF  (l_r004fhr.codhor = l_horqua) THEN
            /* quarta-feira */
            IF  ((LENGTH(l_faiqua_ace)) < 49) OR ((LENGTH(l_faiqua_ace) IS NULL)) THEN
                l_faiqua_ace := l_faiqua_ace || l_striac || l_strfac;
            END IF;
        END IF;
        IF  (l_r004fhr.codhor = l_horqui) THEN
            /* quinta-feira */
            IF  ((LENGTH(l_faiqui_ace)) < 49) OR ((LENGTH(l_faiqui_ace) IS NULL)) THEN
                l_faiqui_ace := l_faiqui_ace || l_striac || l_strfac;
            END IF;
        END IF;
        IF  (l_r004fhr.codhor = l_horsex) THEN
            /* sexta-feira */
            IF  ((LENGTH(l_faisex_ace)) < 49) OR ((LENGTH(l_faisex_ace) IS NULL)) THEN
                l_faisex_ace := l_faisex_ace || l_striac || l_strfac;
            END IF;
        END IF;
        IF  (l_r004fhr.codhor = l_horsab) THEN
            /* sábado */
            IF  ((LENGTH(l_faisab_ace)) < 49) OR ((LENGTH(l_faisab_ace) IS NULL)) THEN
                l_faisab_ace := l_faisab_ace || l_striac || l_strfac;
            END IF;
        END IF;
    END LOOP; /* LOOP r004fhr */

    /* PREENCHE O RESTO DO CAMPO COM 2400 */
    l_faidom_ace := IFNULL(l_faidom_ace,'');
    IF  (l_faidom_ace IS NULL) OR (l_faidom_ace = '') THEN
        l_lengfai := 7;
        l_faidom_ace := '';
    ELSE
        l_lengfai := (56 - LENGTH(l_faidom_ace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
        IF  (l_contfai >= l_lengfai) THEN
            EXIT;
        END IF;
        l_faidom_ace := l_faidom_ace || '24002400';
        l_contfai := l_contfai + 1;
    END LOOP;

    l_faiseg_ace := IFNULL(l_faiseg_ace,'');
    IF  (l_faiseg_ace IS NULL) OR (l_faiseg_ace = '') THEN
        l_lengfai := 7;
        l_faiseg_ace := '';
    ELSE
        l_lengfai := (56 - LENGTH(l_faiseg_ace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
        IF  (l_contfai >= l_lengfai) THEN
            EXIT;
        END IF;
        l_faiseg_ace := l_faiseg_ace || '24002400';
        l_contfai := l_contfai + 1;
    END LOOP;

    l_faiter_ace := IFNULL(l_faiter_ace,'');
    IF  (l_faiter_ace IS NULL) OR (l_faiter_ace = '') THEN
        l_lengfai := 7;
        l_faiter_ace := '';
    ELSE
        l_lengfai := (56 - LENGTH(l_faiter_ace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
        IF  (l_contfai >= l_lengfai) THEN
            EXIT;
        END IF;
        l_faiter_ace := l_faiter_ace || '24002400';
        l_contfai := l_contfai + 1;
    END LOOP;

    l_faiqua_ace := IFNULL(l_faiqua_ace,'');
    IF  (l_faiqua_ace IS NULL) OR (l_faiqua_ace = '') THEN
        l_lengfai := 7;
        l_faiqua_ace := '';
    ELSE
        l_lengfai := (56 - LENGTH(l_faiqua_ace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
        IF  (l_contfai >= l_lengfai) THEN
            EXIT;
        END IF;
        l_faiqua_ace := l_faiqua_ace || '24002400';
        l_contfai := l_contfai + 1;
    END LOOP;

    l_faiqui_ace := IFNULL(l_faiqui_ace,'');
    IF  (l_faiqui_ace IS NULL) OR (l_faiqui_ace = '') THEN
        l_lengfai := 7;
        l_faiqui_ace := '';
    ELSE
        l_lengfai := (56 - LENGTH(l_faiqui_ace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
        IF  (l_contfai >= l_lengfai) THEN
            EXIT;
        END IF;
        l_faiqui_ace := l_faiqui_ace || '24002400';
        l_contfai := l_contfai + 1;
    END LOOP;

    l_faisex_ace := IFNULL(l_faisex_ace,'');
    IF  (l_faisex_ace IS NULL) OR (l_faisex_ace = '') THEN
        l_lengfai := 7;
        l_faisex_ace := '';
    ELSE
        l_lengfai := (56 - LENGTH(l_faisex_ace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
        IF  (l_contfai >= l_lengfai) THEN
            EXIT;
        END IF;
        l_faisex_ace := l_faisex_ace || '24002400';
        l_contfai := l_contfai + 1;
    END LOOP;

    l_faisab_ace := IFNULL(l_faisab_ace,'');
    IF  (l_faisab_ace IS NULL) OR (l_faisab_ace = '') THEN
        l_lengfai := 7;
        l_faisab_ace := '';
    ELSE
        l_lengfai := (56 - LENGTH(l_faisab_ace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
        IF  (l_contfai >= l_lengfai) THEN
            EXIT;
        END IF;
        l_faisab_ace := l_faisab_ace || '24002400';
        l_contfai := l_contfai + 1;
    END LOOP;

    l_faidom_ace  := SUBSTRING(l_faidom_ace,1,56);
    l_faiseg_ace  := SUBSTRING(l_faiseg_ace,1,56);
    l_faiter_ace  := SUBSTRING(l_faiter_ace,1,56);
    l_faiqua_ace  := SUBSTRING(l_faiqua_ace,1,56);
    l_faiqui_ace  := SUBSTRING(l_faiqui_ace,1,56);
    l_faisex_ace  := SUBSTRING(l_faisex_ace,1,56);
    l_faisab_ace  := SUBSTRING(l_faisab_ace,1,56);
  END IF;  /*If atualiza*/

  p_faidom_ace  := l_faidom_ace;
  p_faiseg_ace  := l_faiseg_ace;
  p_faiter_ace  := l_faiter_ace;
  p_faiqua_ace  := l_faiqua_ace;
  p_faiqui_ace  := l_faiqui_ace;
  p_faisex_ace  := l_faisex_ace;
  p_faisab_ace  := l_faisab_ace;
END		SENIOR;23SP_INTSTR
