␀␀CREATE OR REPLACE PROCEDURE GETNEXTVALUEINT64 (pKey IN VARCHAR2, pIncrement IN NUMBER, pSelect IN VARCHAR2, pRet OUT VARCHAR2) AS
BEGIN
  UPDATE R900NXV SET LSTVAL = LSTVAL + pIncrement WHERE CODPKY = pKey RETURNING (LSTVAL - pIncrement) + 1 INTO pRet;
  IF pRet IS NULL THEN
    IF NOT trim(pSelect) IS NULL THEN
      EXECUTE IMMEDIATE PSelect INTO pRet;
    ELSE
      pRet := 0;
    END IF;
    INSERT INTO R900NXV (CODPKY, LSTVAL) VALUES (pKey, TO_NUMBER(pRet) + pIncrement);
    pRet := TO_NUMBER(pRet) + 1;
  END IF;
END;

	MSSQL;0
␀␀CREATE PROCEDURE getnextvalueint64 @pKey VARCHAR(255), @pIncrement NUMERIC, @pSelect VARCHAR(1024), @pRet VARCHAR(19) OUTPUT AS
BEGIN
  SET NOCOUNT ON
  DECLARE @rowcount INTEGER
  DECLARE @xNselect NVARCHAR(1024)
  DECLARE @xSelectIndex INTEGER
  DECLARE @xRetBI BIGINT
  SET @xRetBI = NULL

  UPDATE r900nxv SET lstval = lstval + @pIncrement, @xRetBI = lstval + 1 WHERE codpky = @pKey
  SET @rowcount = @@ROWCOUNT
  IF @xRetBI IS NULL
  BEGIN
    IF @rowcount = 1
    DELETE r900nxv WHERE codpky = @pKey
    IF NOT @pSelect IS NULL
    BEGIN
      SET @xNselect = UPPER(@pSelect)
      SET @xSelectIndex = CHARINDEX('@PRET', @xNselect)
      IF @xSelectIndex = 0
      BEGIN
        SET @xSelectIndex = CHARINDEX('SELECT ', @xNselect)
        SET @xNselect = STUFF(@xNselect, @xSelectIndex, 7, 'SELECT @pRet = ')
      END
    ELSE
      SET @xNselect = @pSelect
      EXECUTE sp_executesql @xNselect, N'@pRet INTEGER OUTPUT', @xRetBI OUTPUT
      SET @xRetBI = COALESCE(@xRetBI, 0)
    END
  ELSE
    SET @xRetBI = 0
    INSERT INTO r900nxv (codpky, lstval) VALUES (@pKey, @xRetBI + @pIncrement)
    SET @xRetBI = @xRetBI + 1
  END
  SET @pRet = CONVERT(VARCHAR(19), @xRetBI)
END	POSTGRESQL;0
o␀␀CREATE OR REPLACE PROCEDURE GETNEXTVALUEINT64 (pKey IN VARCHAR, pIncrement IN NUMERIC, pSelect IN VARCHAR, pRet INOUT VARCHAR)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  xAux BIGINT;
BEGIN
  xAux := NULL;
  UPDATE R900NXV SET LSTVAL = LSTVAL + pIncrement WHERE CODPKY = pKey RETURNING (LSTVAL - pIncrement) + 1 INTO xAux;
  IF xAux IS NULL THEN
    IF TRIM(COALESCE(pSelect, '')) <> '' THEN
      EXECUTE PSelect INTO xAux;
    ELSE
      xAux := 0;
    END IF;
    INSERT INTO R900NXV (CODPKY, LSTVAL) VALUES (pKey, xAux + pIncrement);
    xAux := xAux + 1;
  END IF;
  pRet := xAux::varchar;
END;
$BODY$;
