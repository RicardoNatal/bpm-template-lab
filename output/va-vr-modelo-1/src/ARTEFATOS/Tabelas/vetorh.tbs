			l_Alterou := TRUE;
			SP_CONCAT_FLO_JSON('VLRANT', :NEW.VLRANT, :OLD.VLRANT, 2, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_NUM(:OLD.VLRSUS, :NEW.VLRSUS, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_FLO_JSON('VLRSUS', :NEW.VLRSUS, :OLD.VLRSUS, 2, l_JsonCamposAlterados OUT);
		END IF;
	END IF;

	IF (l_Alterou = TRUE) THEN
		SP_CONCATENAR_NUM('CODPRO', :NEW.CODPRO, l_Valor OUT);
		SP_CONCATENAR_DAT('CMPPAG', :NEW.CMPPAG, l_Valor OUT);

		SP_E_SOCIAL('S-2501', 'R346IVL', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, l_JsonCamposAlterados, 0, NULL, :NEW.CMPPAG, 0, 'R346IVL_EU');
	END IF;
  END IF;
