      l_nomfun := :NEW.NOMFUN;
  ELSE
      l_nomfun := :OLD.NOMFUN;
  END IF;

  IF (l_nomfun IS NULL) OR (l_nomfun = '') THEN
      l_nomfun := '';
      l_numpis := 0;
      IF (LENGTH(LTRIM(RTRIM(:OLD.NomFun))) > 0) THEN
        l_TipOpeRep := 'E';
      END IF;
  END IF;

  IF (:NEW.NUMPIS <> :OLD.NUMPIS) THEN
      l_numpis := :NEW.NUMPIS;
  ELSE
