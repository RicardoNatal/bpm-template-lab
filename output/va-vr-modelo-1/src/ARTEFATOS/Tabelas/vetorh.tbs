        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDFCA', CONVERT(NUMBER_TO_CHAR, :OLD.QTDFCA));
        SP_DATSTR(:OLD.DATCTB, 'DD/MM/YYYY', l_datTemp OUT);
