␀␀create or replace PROCEDURE SP_R034CPL_HIST(p_tipalt varchar,p_numemp smallint,p_tipcol smallint,p_numcad integer,p_ficreg integer,p_codpai smallint,p_codest varchar,p_codcid integer,p_codbai smallint,p_codrad smallint,p_nomrad varchar,p_endcep integer,p_tiplgr varchar,p_endrua varchar,p_endnum varchar,p_endcpl varchar,p_numtel varchar,p_painas smallint,p_estnas varchar,p_ccinas integer,p_docidn smallint,p_numcid varchar,p_emicid varchar,p_cidemi integer,p_estcid varchar,p_dexcid timestamp without time zone,p_zonele varchar,p_secele varchar,p_numele varchar,p_numcnh varchar,p_catcnh varchar,p_datcnh timestamp without time zone,p_vencnh timestamp without time zone,p_numres varchar,p_catres varchar,p_codprf smallint,p_regcon varchar,p_durcon smallint,p_procon smallint,p_proexm timestamp without time zone,p_ultexm timestamp without time zone,p_codqua smallint,p_estpad smallint,p_clasal varchar,p_nivsal varchar,p_matipe integer,p_altipe timestamp without time zone,p_sitipe smallint,p_tippsa varchar,p_codpsa varchar,p_matpsa bigint,p_incpsa timestamp without time zone,p_excpsa timestamp without time zone,p_codrlr smallint,p_codcas smallint,p_numram varchar,p_pretrb varchar,p_andtrb varchar,p_nroarm varchar,p_iniarm timestamp without time zone,p_fimarm timestamp without time zone,p_emapar varchar,p_emacom varchar,p_catvei smallint,p_sitreg varchar,p_nomcom varchar,p_nomsoc varchar,p_datven timestamp without time zone,p_dddtel smallint,p_dditel smallint,p_nmddi2 smallint,p_nmddd2 smallint,p_nmtel2 varchar,p_nmram2 varchar,p_nifext varchar,p_maspsa varchar,p_nasviv varchar,p_carsus varchar,p_tipcer varchar,p_demciv timestamp without time zone,p_matccv varchar,p_matciv varchar,p_livciv varchar,p_folciv varchar,p_carciv varchar,p_estciv varchar,p_cidciv integer,p_numpsp varchar,p_emipsp varchar,p_estpsp varchar,p_dempsp timestamp without time zone,p_dvapsp timestamp without time zone,p_paipsp smallint,p_numpor varchar,p_datpor timestamp without time zone,p_numric bigint,p_estric varchar,p_emiric varchar, p_seqhis in out bigint)
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN
  begin
	INSERT INTO R038HFC (numemp,tipcol,numcad,dathis,tipalt,ficreg,codpai,codest,codcid,codbai,codrad,nomrad,endcep,tiplgr,endrua,endnum,endcpl,numtel,painas,estnas,ccinas,docidn,numcid,emicid,cidemi,estcid,dexcid,zonele,secele,numele,numcnh,catcnh,datcnh,vencnh,numres,catres,codprf,regcon,durcon,procon,proexm,ultexm,codqua,estpad,clasal,nivsal,matipe,altipe,sitipe,tippsa,codpsa,matpsa,incpsa,excpsa,codrlr,codcas,numram,pretrb,andtrb,nroarm,iniarm,fimarm,emapar,emacom,catvei,sitreg,nomcom,nomsoc,datven,dddtel,dditel,nmddi2,nmddd2,nmtel2,nmram2,nifext,maspsa,nasviv,carsus,tipcer,demciv,matccv,matciv,livciv,folciv,carciv,estciv,cidciv,numpsp,emipsp,estpsp,dempsp,dvapsp,paipsp,numpor,datpor,numric,estric,emiric)  
			VALUES  (p_numemp,p_tipcol,p_numcad,TIMEOFDAY()::timestamp without time zone,p_tipalt,p_ficreg,p_codpai,p_codest,p_codcid,p_codbai,p_codrad,p_nomrad,p_endcep,p_tiplgr,p_endrua,p_endnum,p_endcpl,p_numtel,p_painas,p_estnas,p_ccinas,p_docidn,p_numcid,p_emicid,p_cidemi,p_estcid,p_dexcid,p_zonele,p_secele,p_numele,p_numcnh,p_catcnh,p_datcnh,p_vencnh,p_numres,p_catres,p_codprf,p_regcon,p_durcon,p_procon,p_proexm,p_ultexm,p_codqua,p_estpad,p_clasal,p_nivsal,p_matipe,p_altipe,p_sitipe,p_tippsa,p_codpsa,p_matpsa,p_incpsa,p_excpsa,p_codrlr,p_codcas,p_numram,p_pretrb,p_andtrb,p_nroarm,p_iniarm,p_fimarm,p_emapar,p_emacom,p_catvei,p_sitreg,p_nomcom,p_nomsoc,p_datven,p_dddtel,p_dditel,p_nmddi2,p_nmddd2,p_nmtel2,p_nmram2,p_nifext,p_maspsa,p_nasviv,p_carsus,p_tipcer,p_demciv,p_matccv,p_matciv,p_livciv,p_folciv,p_carciv,p_estciv,p_cidciv,p_numpsp,p_emipsp,p_estpsp,p_dempsp,p_dvapsp,p_paipsp,p_numpor,p_datpor,p_numric,p_estric,p_emiric)
			returning seqhis into p_seqhis;
  exception
	when OTHERS then
	  RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'Erro ao registrar histórico de alteração da ficha complementar.';
  end;
end;
