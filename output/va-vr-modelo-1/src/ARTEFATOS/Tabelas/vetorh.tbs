TRIGGER R024CAR_SI AFTER INSERT ON R024CAR FOR EACH ROW
BEGIN
    RH_250ALT(43);
END␀Ñ␀␀		SENIOR;0€␀␀

TRIGGER R024CAR_EU AFTER UPDATE ON R024CAR FOR EACH ROW

DECLARE
    l_EstCarPadrao   R126DEF.ESTCAR%TYPE;
	l_CargoPadrao   R126DEF.CODCAR%TYPE;
	l_Valor     VARCHAR2(2000);
	l_Alterou   BOOLEAN;
	l_Valido    BOOLEAN;
	l_data_zero DATE;
	l_datatu    DATE;
	l_informouEncerramento BOOLEAN;
	l_TituloAlterado NUMBER(1);

    l_valstr VARCHAR2(60);
    l_estcar_str VARCHAR2(4);
    l_codcar_str VARCHAR2(24);

	/* Tabela temporária */
	CREATE_TEMP_TABLE R024CAR_AUX;
	
BEGIN
    l_data_zero := '31/12/1900,00:00:00';
    l_datatu := CURDATE();
    l_informouEncerramento := FALSE;
    RH_250ALT(43);
    l_TituloAlterado := 0;
	l_Valor := '';
	BEGIN
	/* Busca o Cargo padrão definido nos assinalamentos - R126DEF */
    SELECT IFNULL(ESTCAR, 0), IFNULL(CODCAR, '') INTO l_EstCarPadrao, l_CargoPadrao
      FROM R126DEF;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_EstCarPadrao := 0;
			l_CargoPadrao := '';
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao ler R126DEF';
	END;

	/* Se NÃO é cargo Padrão E efetuou alteração no titulo do cargo deve Atualizar    */
	/* o titulo do cargo nas tabelas detalhes */
    IF ((l_EstCarPadrao <> :NEW.ESTCAR) OR (l_CargoPadrao <> :NEW.CODCAR)) AND (:OLD.TITCAR <> :NEW.TITCAR) THEN
	/* Utilizada tabela _AUX para controle, pois os UPDATES abaixo disparam triggers
       que fazem SELECT para o mesmo registro da tabela R024CAR e isso gera erro.
       A _AUX irá servir como flag de controle, indicando que o update foi chamado
       via trigger R024CAR e sendo assim, não é precisa executar as rotinas das
       demais triggers.                                                              */
		BEGIN
      INSERT INTO R024CAR_AUX (ESTCAR, CODCAR)
                       VALUES (:NEW.ESTCAR, :NEW.CODCAR);
    EXCEPTION WHEN OTHERS THEN
				RAISERROR 103 'Erro ao inserir na R024CAR_AUX';
		END;

		BEGIN
      UPDATE R122CEC
         SET TITCAR = :NEW.TITCAR
       WHERE ESTCAR = :NEW.ESTCAR
         AND CODCAR = :NEW.CODCAR;
    EXCEPTION WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar a tabela R122CEC';
		END;

		BEGIN
      UPDATE R124HEC
         SET TITCAR = :NEW.TITCAR
       WHERE ESTCAR = :NEW.ESTCAR
         AND CODCAR = :NEW.CODCAR;
    EXCEPTION WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar a tabela R124HEC';
		END;

		BEGIN
			DELETE FROM R024CAR_AUX;
    EXCEPTION WHEN OTHERS THEN
				RAISERROR 103 'Erro ao excluir R024CAR_AUX';
		END;
	END IF;

	l_Alterou := FALSE;

	SP_VALUPDATE_DES(:OLD.TITRED, :NEW.TITRED, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		l_TituloAlterado := 1;
	END IF;
	
	SP_VALUPDATE_DES(:OLD.TITCAR, :NEW.TITCAR, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		l_TituloAlterado := l_TituloAlterado +2;
	END IF;

	SP_VALUPDATE_DES(:OLD.CODCB2, :NEW.CODCB2, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		SP_CONCATENAR_DES('CODCB2', :NEW.CODCB2, l_Valor OUT);
		l_Alterou := TRUE;
	END IF;
	
	IF ((:OLD.DATEXT IS NULL OR :OLD.DATEXT = l_data_zero ) AND (:NEW.DATEXT > l_data_zero)) THEN
		  SP_VALUPDATE_DAT(:OLD.DATEXT, :NEW.DATEXT, l_Valido OUT);
	  IF (l_Valido = TRUE) THEN	      
		  l_informouEncerramento := TRUE;
	  END IF;
	END IF;
	
	IF (l_informouEncerramento = FALSE) THEN /* Se não é alteração de data de extinção */  
	    IF ((:NEW.DATEXT <= l_datatu) AND (:NEW.DATEXT > l_data_zero)) THEN  	 /* Se tiver preenchido data de extinção, não deve gerar pendência ao eSocial */
	        l_Alterou := FALSE;
	    END IF;
	END IF;	
	
	IF (l_Alterou = TRUE OR l_informouEncerramento = TRUE) THEN	
		SP_CONCATENAR_DES('CODCAR', :NEW.CODCAR, L_VALOR OUT);
		SP_CONCATENAR_NUM('ESTCAR', :NEW.ESTCAR, L_VALOR OUT);
		SP_CONCATENAR_DES('TITRED', :NEW.TITRED, L_VALOR OUT);
		SP_CONCATENAR_DES('TITCAR', :NEW.TITCAR, L_VALOR OUT);
		SP_CONCATENAR_NUM('TITALT', l_TituloAlterado, L_VALOR OUT);

		IF (l_informouEncerramento = TRUE) THEN
		    SP_CONCATENAR_DES('DATENC', 'S', L_VALOR OUT);
			SP_CARGOESOCIAL('R024CAR', :NEW.ESTCAR, :NEW.CODCAR, L_VALOR, NULL, NULL, :NEW.DATEXT); /*S-1030*/
			SP_FUNCAOESOCIAL('R024CAR', :NEW.ESTCAR, :NEW.CODCAR, L_VALOR, NULL, NULL, :NEW.DATEXT);		/*S-1040*/		
		END IF;
		
		IF (l_Alterou = TRUE) THEN		
			SP_CARGOESOCIAL('R024CAR', :NEW.ESTCAR, :NEW.CODCAR, L_VALOR, NULL, NULL, NULL);
			SP_FUNCAOESOCIAL('R024CAR', :NEW.ESTCAR, :NEW.CODCAR, L_VALOR, NULL, NULL, NULL);
		END IF;	
		
	END IF;

    /* Pendência SAMSenior */
    IF (:NEW.TITRED <> :OLD.TITRED) THEN
      SP_INTSTR(:NEW.ESTCAR, '9999', l_estcar_str OUT);
      SP_ESPSTR(:NEW.CODCAR, 24, l_codcar_str OUT);
      l_valstr := '2E' || l_estcar_str || l_codcar_str || :OLD.TITRED;
      SP_SAM_PENDENCIES(33, 2, l_valstr);
    END IF;

    /* Tabela temporária */
    BEGIN
        DELETE FROM R024CAR_AUX;
        DROP_TEMP_TABLE R024CAR_AUX;
    EXCEPTION 
        WHEN OTHERS THEN NULL;
    END;
    	
END␀Ñ␀␀		SENIOR;0WTRIGGER R024CAR_SD AFTER DELETE ON R024CAR FOR EACH ROW
BEGIN
    RH_250ALT(43);
