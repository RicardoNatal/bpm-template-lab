J␀␀PROCEDURE SP_R070ACR(P_TIPOPE VARCHAR2(1),P_NUMCRA NUMBER(12),P_NUMFIS NUMBER(12),P_TECCRA NUMBER(1),P_VERPRM NUMBER(1),P_DELPRM NUMBER(5),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_OLDPRM NUMBER(5),P_OLDSAB NUMBER(5),P_OLDDOM NUMBER(5),P_OLDFER NUMBER(5),P_OLDRT1 NUMBER(5),P_OLDRT2 NUMBER(5),P_OLDRT3 NUMBER(5),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1),P_REMREP NUMBER(1),P_TIPLIS NUMBER(2),P_NUMCPF NUMBER(11))
 IS
