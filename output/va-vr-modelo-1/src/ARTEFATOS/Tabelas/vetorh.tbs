TRIGGER R006ESC_SU AFTER UPDATE ON R006ESC FOR EACH ROW

DECLARE
  l_Alterou      BOOLEAN;
  l_Valido       BOOLEAN;
  l_DataReferencia DATE;
BEGIN  
  RH_250ALT(33);
  
  /*e-Social*/
  l_Alterou := FALSE;
  SP_VALUPDATE_DES(:OLD.TIPESC, :NEW.TIPESC, l_Valido OUT);
  IF (l_Valido = TRUE) THEN	
	l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.HORSEM, :NEW.HORSEM, l_Valido OUT);
  IF (l_Valido = TRUE) THEN	
	l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.TIPJOR, :NEW.TIPJOR, l_Valido OUT);
  IF (l_Valido = TRUE) THEN	
	l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.TIPJOS, :NEW.TIPJOS, l_Valido OUT);
  IF (l_Valido = TRUE) THEN	
	l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_DES(:OLD.EscNot, :NEW.EscNot, l_Valido OUT);  
  IF (l_Valido = TRUE) THEN
  	IF (:OLD.EscNot = 'S' OR :NEW.EscNot = 'S') THEN	
		l_Alterou := TRUE;
	END IF;	
  END IF;  
  
  SP_VALUPDATE_DES(:OLD.DESJOR, :NEW.DESJOR, l_Valido OUT);
  IF (l_Valido = TRUE) THEN	
	l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_DES(:OLD.DESSIM, :NEW.DESSIM, l_Valido OUT);
  IF (l_Valido = TRUE) THEN 
    l_Alterou := TRUE;
  END IF;
  
  IF (l_Alterou = TRUE) THEN 
    l_DataReferencia := CURDATE();
    SP_ESOCIAL_ESCALA(:NEW.CODESC, l_DataReferencia, 'R006ESC', 'A');
  END IF;
  /*e-Social*/
END␀ÁÎ␀␀		SENIOR;0Y

