PROCEDURE SP_PEND06(P_TIPOPE NUMBER(1),P_IDTPES CHAR(23),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7))
 IS

l_valstr      VARCHAR2(1400);
  l_fx_cred     VARCHAR2(1248);
  l_qtd_fx      NUMBER(2);
  l_tipope      CHAR(1);
  l_qtd_fx_str  CHAR(2);
  l_verplf      CHAR(3);
  l_codplf      CHAR(7);
BEGIN
  l_fx_cred := '';
  l_qtd_fx  := 0;

  SP_INTSTR(p_tipope,'9',l_tipope OUT);
  l_valstr := '06' || p_idtpes || l_tipope;

  /* CAMPOS NECESSÁRIOS SOMENTE QUANDO A OPERAÇÃO É INSERIR */
  IF (p_tipope = 1) THEN
    /*RETORNA AS FAIXAS POR LOCAL FÍSICO*/
    SP_RETCREATI(p_idtpes, p_verplf, p_codplf, l_qtd_fx OUT, l_fx_cred OUT);

    SP_INTSTR(l_qtd_fx,'99',l_qtd_fx_str OUT);
    SP_INTSTR(p_verplf,'999',l_verplf OUT);
    SP_INTSTR(p_codplf,'9999999',l_codplf OUT);

    l_valstr := l_valstr || l_verplf || l_codplf || l_qtd_fx_str;
    IF (l_qtd_fx > 0) THEN
      l_valstr := l_valstr || l_fx_cred;
    END IF;

  END IF;

  BEGIN
    SP_PORCOM(l_valstr, '0');
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'SP_PEND06: Erro ao gerar pendência 06.	updateCreditAccess.';
  END;
END		SENIOR;21$SP_INTSTR
SP_RETCREATI
SP_PORCOM
n␀␀


