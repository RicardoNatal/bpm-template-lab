DECLARE
l_online       BOOLEAN;
  l_froonl       BOOLEAN;
  l_emp_col      NUMBER(4);
  l_tip_col      NUMBER(1);
  l_num_cad      NUMBER(10);
  l_plavei       VARCHAR2(10);
  l_cod_por      NUMBER(3);
  l_cod_plt      VARCHAR2(5);
  l_cod_rlg      VARCHAR2(3);
  l_data_zero    DATE;
  l_data_teste   DATE;
  l_hora_zero    NUMBER(5);
  l_strerr       VARCHAR2(255);
  l_hora_atual   NUMBER(4);
  l_data_atual   DATE;
  l_libvei       NUMBER(1);
  l_tip_acc      NUMBER(3);
  l_dir_acc      VARCHAR2(1);

  BEGIN
SP_VerOnLine(l_online OUT);
SP_UsaFronline(l_froonl OUT, l_libvei OUT);
l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
l_data_atual := CURDATE();
l_data_zero := '31/12/1900,00:00:00';
/*l_data_teste := '28/07/2000,00:00:00';*/
l_hora_zero := 0;
IF   (l_online = TRUE) AND (l_froonl = TRUE) AND (l_libvei = 1) AND (:NEW.NUMCRA > 0) AND (:NEW.CRAVEI > 0) THEN
     BEGIN
     SELECT R038HCH.NUMEMP,R038HCH.TIPCOL,R038HCH.NUMCAD INTO l_emp_col, l_tip_col, l_num_cad
            FROM R038HCH WHERE (R038HCH.NUMCRA = :NEW.NUMCRA)
            AND (l_data_atual > R038HCH.DATINI OR (l_data_atual = R038HCH.DATINI
            AND l_hora_atual >= R038HCH.HORINI))  AND  ((R038HCH.DATFIM = l_data_zero
            OR (l_data_atual < R038HCH.DATFIM) OR (l_data_atual = R038HCH.DATFIM
            AND l_hora_atual <= R038HCH.HORFIM)));
     EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT em R038HCH.';
     END;
     BEGIN
        SELECT PLAVEI INTO l_plavei
               FROM R088HCH
               WHERE NUMCRA = :NEW.CRAVEI AND ((DATINI <= :NEW.DATACC) AND
               (DATFIM >= :NEW.DATACC OR DATFIM = l_data_zero)) AND STAACC = 1;
        EXCEPTION WHEN OTHERS THEN
        l_strerr := 'Veículo Não Cadastrado.   Placa: '||l_plavei;
        RAISERROR 103 l_strerr;
     END;

     SP_INTSTR(:NEW.CODRLG,'999',l_cod_rlg OUT);
     SP_INTSTR(:NEW.CODPLT,'99999',l_cod_plt OUT);
     BEGIN
        SELECT CODPOR INTO l_cod_por
          FROM R058RLG
         WHERE CODPLT = :NEW.CODPLT AND CODRLG = :NEW.CODRLG;
     EXCEPTION WHEN OTHERS THEN
        l_strerr := 'Erro ao Inserir o Registro: Relógio Não Encontrado.  CodRlg: '||l_cod_rlg||' CodPlt: '||l_cod_plt;
        RAISERROR 103 l_strerr;
     END;
     /* Insere os dados na tabela R088MFR. */
     l_tip_acc := :NEW.TIPACC;
     l_dir_acc := :NEW.DIRACC;
     IF ((l_tip_acc = 1) OR (l_tip_acc = 2) OR (l_tip_acc = 8) OR (l_tip_acc = 9) OR (l_tip_acc = 121)) THEN
        IF  (l_dir_acc = 'S') THEN
            INSERT INTO R088MFR (PLAVEI,DATSAI,HORSAI,EMPCON,TCLCON,CADCON,PORSAI,DATRET,HORRET)
            VALUES (l_plavei, l_data_atual, l_hora_atual, l_emp_col, l_tip_col, l_num_cad, l_cod_por,l_data_zero,l_hora_zero);
        ELSE
            UPDATE R088MFR SET DATRET = l_data_atual, HORRET = l_hora_atual, PORRET = l_cod_por
            WHERE PLAVEI = l_plavei AND DATRET = l_data_zero
            AND HORRET = l_hora_zero;
        END IF;
     END IF;
   END IF;
END␀␀␀ğï␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀1Ü␀␀í+±␀	␀␀␀␀␀␀¸?­:­:q␀Æÿ␀␀2Ü␀␀␀ïSE␀␀␀␀␀␀¨X°V¸VG␀␀ÿ␀␀ÿ␀␀␀␀0␀␀Ò$␀␀3Ü␀␀Ëœ␀␀	␀␀␀␀␀␀Ôœ␀␀Ñœ␀␀Ñœ␀␀_␀Æˆ␀␀ÿ␀␀Ü␀␀␀Œ ␀␀	␀␀␀␀␀␀Z¡␀␀Ÿ ␀␀Ÿ ␀␀_␀Çˆ␀␀ÿ␀␀™Ü␀␀␀k¬␀␀(	␀␀␀␀␀␀6±␀␀ş)u¯␀␀1␀␀ÿ␀␀ûÜ␀␀␀*EÑ␀	␀␀␀␀␀␀ªIW_ûGqCvˆ␀êÿ␀␀½Ü␀␀␀©w·␀	␀␀␀␀␀␀y‡{›xì*␀yˆ␀Æÿ␀␀¾Ü␀␀␀Öa´␀	␀␀␀␀␀␀¸<šaˆbr␀Æÿ␀␀Ò␀␀␀>␀t	␀␀␀␀␀␀R␀ÿ␀ÿ␀n␀Æÿ␀␀ˆÓ␀␀␀C$Ì␀	␀␀␀␀␀␀M%$™$w␀Æÿ␀␀…Ó␀␀␀^DÑ␀␀␀␀␀␀␀AM]_HqCvˆ␀êÿ␀␀ÿ␀Iw·␀␀␀␀␀␀␀åy‰{Æxì*␀yˆ␀Æÿ␀␀ÿ␀␀␀4Ü␀␀␀␀0;1;2;3;4;5;6;7␀␀ú␀␀␀␀␀␀␀␀␀␀␀5Ü␀␀ZÂ␀␀	␀␀␀␀␀␀}Â␀␀\Â␀␀\Â␀␀\␀Èˆ␀␀ÿ␀␀õÜ␀␀␀í+±␀	␀␀␀␀␀␀¸?­:­:q␀Æÿ␀␀2Ü␀␀␀␀␀␀0;1␀␀¥␀␀6Ü␀␀ZÂ␀␀	␀␀␀␀␀␀}Â␀␀\Â␀␀\Â␀␀\␀Èˆ␀␀ÿ␀␀õÜ␀␀␀cDÑ␀	␀␀␀␀␀␀ZN*F*FqC␀êÿ␀␀ÿ␀Lw·␀	␀␀␀␀␀␀.zxxì*␀␀Æÿ␀␀ÿ␀¢␀␀V␀␀␀␀␀␀.£␀␀Î¢␀␀Î¢␀␀n␀Æÿ␀␀ÿ␀b´␀␀␀␀␀␀␀™<±aÉbr␀Æÿ␀␀Ò␀␀␀	␀t␀␀␀␀␀␀W␀1␀1␀n␀Æÿ␀␀ˆÓ␀␀␀`$Ì␀␀␀␀␀␀␀%.$²$w␀Æÿ␀␀…Ó␀␀␀ÌEÑ␀␀␀␀␀␀␀ K K KqC␀êÿ␀␀ÿ␀øw·␀␀␀␀␀␀␀yyyì*␀␀Æÿ␀␀ÿ␀␀Š␀␀␀␀␀␀␀—␀—␀—␀n␀Æÿ␀␀ÿ␀␀␀␀0;1;2␀␀Â␀␀␀␀␀␀␀␀␀␀␀7Ü␀␀ZÂ␀␀	␀␀␀␀␀␀}Â␀␀\Â␀␀\Â␀␀\␀Èˆ␀␀ÿ␀␀õÜ␀␀␀jDÑ␀	␀␀␀␀␀␀èL_÷EqCvˆ␀êÿ␀␀ÿ␀Rw·␀	␀␀␀␀␀␀cyxıwì*␀ˆ␀Æÿ␀␀ÿ␀,-¼␀	␀␀␀␀␀␀‘=Ÿ:Õ;v␀Æÿ␀␀°Ü␀␀␀␀␀␀0;1;2;3␀␀˜␀␀␀␀␀8Ü␀␀ZÂ␀␀	␀␀␀␀␀␀}Â␀␀\Â␀␀\Â␀␀\␀Èˆ␀␀ÿ␀␀õÜ␀␀␀iDÑ␀	␀␀␀␀␀␀}KöE÷EqCvˆ␀êÿ␀␀:Ü␀␀␀Qw·␀	␀␀␀␀␀␀Ñxxxì*␀yˆ␀Æÿ␀␀>Ü␀␀␀Ê¢␀␀±␀␀␀␀␀␀␀£␀␀Î¢␀␀£␀␀q␀Æÿ␀␀ÛÜ␀␀␀b´␀␀␀␀␀␀␀Ÿ<´aÒbr␀Æÿ␀␀Ò␀␀␀@␀t␀␀␀␀␀␀c␀L␀