  l_codfil              NUMBER(6);
  l_temdsp              NUMBER(1);
  l_tamraz_emp          NUMBER(3);
  l_tamraz_emp_str      VARCHAR2(3);
  l_razsoc_emp          VARCHAR2(40);

  /* CURSOR QUE RETORNA AS FAIXAS HORARIAS DE ALMOCO. USO = REFEICAO OBRIGATORIA. */
  CURSOR c_dsprep IS
  SELECT R058RLG.VERPLF, R058RLG.CODPLF FROM R058MOD, R058RLG
    WHERE  R058MOD.MODRLG = R058RLG.MODRLG AND R058RLG.COMRLG = 2
    AND R058MOD.CLAMOD IN (13) AND R058MOD.TIPMOD IN (16,17);
  TYPE t_dsprep IS RECORD(
    verplf   R058RLG.VERPLF%TYPE,
    codplf   R058RLG.CODPLF%TYPE);
