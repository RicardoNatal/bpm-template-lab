	            INSERT INTO R070SIN (CODSIN,DATSIN,HORSIN,SEQSIN,VALSIN,STASIN) VALUES
	                                (l_CodSIn, l_DatSin, l_HorSin, l_seqSin, p_valStr, l_codErr);
	        EXCEPTION
	            WHEN OTHERS THEN p_retSin := 1;  /* Se retornar esse erro a CSM tem q gravar um log e continuar o sincronismo */
	        END;        
        END IF;  
    END IF;
END		SENIOR;24fSP_SINASA
