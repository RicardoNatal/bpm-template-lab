TRIGGER R304PCA_SI AFTER INSERT ON R304PCA
DECLARE
	CURSOR c_R304PCA IS
	SELECT NUMEMP, NUMATO, DATATO, NUMMAT, NUMCPF, CODUNI, SEQPRO, SEQREG
	  FROM R304PCA
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304PCA IS RECORD (
		NUMEMP   R304PCA.NUMEMP%TYPE,
		NUMATO   R304PCA.NUMATO%TYPE,
		DATATO   R304PCA.DATATO%TYPE,
		NUMMAT   R304PCA.NUMMAT%TYPE,
		NUMCPF   R304PCA.NUMCPF%TYPE,
		CODUNI   R304PCA.CODUNI%TYPE,
		SEQPRO   R304PCA.SEQPRO%TYPE,
		SEQREG   R304PCA.SeqReg%TYPE
	);
    
    l_R304PCA t_R304PCA;
    l_PidSta VARCHAR2(30);
    l_MsgErr VARCHAR2(255);
BEGIN
	FOREACH c_R304PCA INTO l_R304PCA.NumEmp, l_R304PCA.NUMATO, l_R304PCA.DATATO, l_R304PCA.NUMMAT, l_R304PCA.NUMCPF, l_R304PCA.CODUNI, l_R304PCA.SEQPRO, l_R304PCA.SeqReg
	LOOP
		/* Busca PID gravado no registro da Concessão Aposentadoria */
		BEGIN
			SELECT CAP.PIDSTA INTO l_PidSta
			  FROM R304CAP CAP, R304STA STA
			 WHERE CAP.PIDSTA = STA.PIDSTA
			   AND CAP.NUMEMP = l_R304PCA.NumEmp
			   AND CAP.NUMATO = l_R304PCA.NUMATO
			   AND CAP.DATATO = l_R304PCA.DATATO
			   AND CAP.NUMMAT = l_R304PCA.NUMMAT
			   AND CAP.NUMCPF = l_R304PCA.NUMCPF
			   AND CAP.CODUNI = l_R304PCA.CODUNI
			   AND CAP.SeqReg = l_R304PCA.SeqReg
			   AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_MsgErr := 'Não existe registro de concessão de aposentadoria pendente com as seguintes chaves: ' ||
					'Empresa: ' || CONVERT(NUMBER_TO_CHAR, l_R304PCA.NumEmp) || ', Ato: ' || l_R304PCA.NUMATO|| ', Data Ato: ' || CONVERT(DATE_TO_CHAR,l_R304PCA.DATATO)
					|| ', Número Matrícula: ' || l_R304PCA.NUMMAT ||', CPF: ' || CONVERT(NUMBER_TO_CHAR, l_R304PCA.NUMCPF) ||', Cod Unidade: ' || CONVERT(NUMBER_TO_CHAR, l_R304PCA.CODUNI) || '.';						
				RAISERROR 103 l_MsgErr;
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304CAP.';
		END;
		
		BEGIN
			UPDATE R304PCA
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304PCA.NumEmp
			   AND NUMATO = l_R304PCA.NUMATO
			   AND DATATO = l_R304PCA.DATATO
			   AND NUMMAT = l_R304PCA.NUMMAT
			   AND NUMCPF = l_R304PCA.NUMCPF
			   AND CODUNI = l_R304PCA.CODUNI
			   AND SEQPRO = l_R304PCA.SEQPRO
			   AND SEQREG = l_R304PCA.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304PCA,.';
		END;
	END LOOP;
END␀ºå␀␀		SENIOR;0␀␀TRIGGER R304PCA_EI BEFORE INSERT ON R304PCA FOR EACH ROW
DECLARE
	l_SeqReg   R304PCA.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Verifica se está tentando incluir um registro com sequência maior do que a última já cadastrada */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304PCA
		 WHERE NUMEMP = :NEW.NumEmp
		   AND NUMATO = :NEW.NUMATO
		   AND DATATO = :NEW.DATATO
		   AND NUMMAT = :NEW.NUMMAT
		   AND NUMCPF = :NEW.NUMCPF
		   AND CODUNI = :NEW.CODUNI
		   AND SEQPRO = :NEW.SEQPRO
		   AND SEQREG <> :NEW.SeqReg;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304PCA.';
	END;
	
	IF (l_SeqReg > 0) THEN
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
