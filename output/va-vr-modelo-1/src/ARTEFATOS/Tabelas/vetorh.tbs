  l_tipdoc       NUMBER(1);
  l_numdoc       VARCHAR2(20);

  CURSOR c_r088atu IS SELECT EMPCON,TCLCON,CADCON,DATFIM
                           FROM R088AUT
                           WHERE PLAVEI = :NEW.PLAVEI
                           AND ((DATINI >= :NEW.DATINI)
                           AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                           /*AND (DATFIM <= :NEW.DATFIM OR :NEW.DATFIM = l_data_zero));*/
       TYPE t_r088atu IS RECORD(
                EMPCON   R088AUT.EmpCon%TYPE,
                TCLCON   R088AUT.TclCon%TYPE,
                CADCON   R088AUT.CadCon%TYPE,
                DATFIM   R088AUT.DatFim%TYPE);
       l_r088atu t_r088atu;

  CURSOR c_r088agf IS SELECT EMPCON,TCLCON,CADCON,DATRET,HORRET
                           FROM R088AGF
                           WHERE PLAVEI = :NEW.PLAVEI AND (VEIUTI = 'A' OR VEIUTI = 'S')  
                           AND ((DATAGF > :NEW.DATINI) OR (DATAGF = :NEW.DATINI AND HORAGF >= :NEW.HORINI))
                           AND (DATRET >= l_data_atual OR (DATRET = l_data_atual AND HORRET >= l_hora_atual) OR DATRET = l_data_zero);
                           /*AND (DATRET < :NEW.DATFIM OR (DATRET = :NEW.DATFIM AND HORRET <= :NEW.HORFIM) OR :NEW.DATFIM = l_data_zero);*/
       TYPE t_r088agf IS RECORD(
                EMPCON   R088AGF.EmpCon%TYPE,
                TCLCON   R088AGF.TclCon%TYPE,
                CADCON   R088AGF.CadCon%TYPE,
                DATRET   R088AGF.DatRet%TYPE,
                HORRET   R088AGF.HorRet%TYPE);
       l_r088agf t_r088agf;

  CURSOR c_r088usu IS SELECT TIPCLB,NUMEMP,TIPCOL,NUMCAD,CADOCR,DATVAL,HORVAL
                           FROM R088USU
                           WHERE PLAVEI = :NEW.PLAVEI
                           AND DATALT >= :NEW.DATINI
                           AND ACELIV = 'S';
       TYPE t_r088usu IS RECORD(
                TIPCLB   R088USU.TipClb%TYPE,
                NUMEMP   R088USU.NumEmp%TYPE,
                TIPCOL   R088USU.TipCol%TYPE,
                NUMCAD   R088USU.NumCad%TYPE,
                CADOCR   R088USU.CadOcr%TYPE,
                DATVAL   R088USU.DatVal%TYPE,
                HORVAL   R088USU.HorVal%TYPE);
       l_r088usu t_r088usu;
       
  CURSOR c_r088VEC IS 
    SELECT NUMEMP, TIPCOL,NUMCAD, 0 TIPDOC, '' NUMDOC FROM R088VEC WHERE PLAVEI = :NEW.PLAVEI
  UNION(
    SELECT NUMEMP, 5 TIPCOL,NUMCAD, 0 TIPDOC, '' NUMDOC FROM R088VEO WHERE PLAVEI = :NEW.PLAVEI
  UNION(
    SELECT 0 NUMEMP, 4 TIPCOL, 0 NUMCAD, TIPDOC, NUMDOC FROM R088VEV WHERE PLAVEI = :NEW.PLAVEI));
  TYPE t_r088vec IS RECORD(
                NUMEMP   R088VEC.NumEmp%TYPE,
                TIPCOL   R088VEC.TipCol%TYPE,
                NUMCAD   R088VEC.NumCad%TYPE, 
                TIPDOC   R088VEV.TipDoc%TYPE,
                NUMDOC   R088VEV.NumDoc%TYPE);
   l_r088VEC t_r088VEC;       
         
BEGIN
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_VerOnLine(l_online OUT);
  SP_UsaFronline(l_froonl OUT, l_libvei OUT);
  SP_Usuonline(l_froonl OUT, l_usuonl OUT);
  l_situa := 0;
  l_data_zero :=  DATETIME(31, 12, 1900, 0, 0, 0);
  
  /* Seleciona os registros para a alteração. */
  /* CURSOR que busca a última marcação alteraçao de crachás de veículos */
  /* Só processa se o status for presente */
  IF (l_usuonl = TRUE) AND (l_online = TRUE) AND (:NEW.STAACC = 1) THEN
    /* Chama procedure para alteração */
    FOREACH c_r088usu INTO  l_r088usu.TipClb,
                            l_r088usu.NumEmp,
                            l_r088usu.TipCol,
                            l_r088usu.NumCad,
                            l_r088usu.CadOcr,
                            l_r088usu.DatVal,
                            l_r088usu.HorVal
    LOOP
        IF (l_r088usu.TipClb = 1) THEN
           /*  Busca pelo crachá do colaborador. */
           SP_RETCRA (2, l_r088usu.numemp, l_r088usu.tipcol, l_r088usu.numcad, 0,'',0,'',l_crapro OUT);
           IF   (l_crapro = 0)  THEN
                 SP_RETCRA (1, l_r088usu.numemp, l_r088usu.tipcol, l_r088usu.numcad,0,'',0,'', l_cracha OUT);
           ELSE l_cracha := l_crapro;
           END IF;
		   l_numemp := l_r088usu.numemp;
		   l_tipcol := l_r088usu.tipcol;
		   l_numcad := l_r088usu.numcad;
        ELSE
           /*  Busca pelo crachá do colaborador. */
           SP_RETCRA (2, l_r088usu.numemp, 5, l_r088usu.cadocr, 0,'',0,'',l_crapro OUT);
           IF   (l_crapro = 0)  THEN
                 SP_RETCRA (1, l_r088usu.numemp, 5, l_r088usu.cadocr,0,'',0,'', l_cracha OUT);
           ELSE l_cracha := l_crapro;
           END IF;
		   l_numemp := l_r088usu.numemp;
		   l_tipcol := 5;
		   l_numcad := l_r088usu.cadocr;
        END IF;

        l_datfim := :NEW.DATFIM;
        l_horfim := :NEW.HORFIM;
        IF (l_datfim = l_data_zero) OR (l_datfim > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
          l_datfim := DATETIME(31, 12, 2050, 0, 0, 0);
          l_horfim := 1439;
        END IF;

        l_datval := l_r088usu.DATVAL;
        l_horval := l_r088usu.horval;
        IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
          l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
          l_horval := 1439;
        END IF;

        IF   (l_datfim < l_datval) OR ((l_datfim = l_datval AND l_horfim <= l_horval)) THEN
		    SP_VEIPESCON('I', :NEW.NUMCRA, l_cracha, l_situa, :NEW.PLAVEI, 
						l_datfim, l_horfim, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
        ELSE 
			SP_VEIPESCON('I', :NEW.NUMCRA, l_cracha, l_situa, :NEW.PLAVEI, 
						l_datval, l_horval, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
        END IF;

    END LOOP;

    /* veículo que não são da frota*/
    FOREACH c_r088vec INTO  l_r088vec.NumEmp,
                            l_r088vec.TipCol,
                            l_r088vec.NumCad,
                            l_r088vec.TipDoc,
                            l_r088vec.NumDoc
    LOOP
        l_cracha := 0;
        IF (l_r088vec.TipCol = 4) THEN
            /* Visitante */
            SP_RetCra (1, 0, 4, 0,0,'',l_r088vec.tipdoc,l_r088vec.numdoc,l_cracha OUT);
           
            l_numemp := 0;
		    l_tipcol := 4;
		    l_numcad := 0;
		    l_tipdoc := l_r088vec.tipdoc;
		    l_numdoc := l_r088vec.numdoc;
		    l_datfim := :NEW.datfim;
		    l_horfim := :NEW.horfim;
		    
		    IF (l_cracha > 0) THEN
		        /* pesquisa pela data de validade */
		        BEGIN 
    		        SELECT DATFIM, HORFIM INTO l_datfim, l_horfim  FROM R090HCH WHERE 
	    	            R090HCH.NUMCRA = l_cracha AND
		                R090HCH.TIPDOC = l_tipdoc AND
                        R090HCH.NUMDOC = l_numdoc AND
                        (R090HCH.DATINI < l_data_atual OR
                        (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
                        (R090HCH.DATFIM = l_data_zero OR
                         R090HCH.DATFIM > l_data_atual OR
                        (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
                EXCEPTION WHEN OTHERS THEN 
		            l_datfim := :NEW.datfim;
		            l_horfim := :NEW.horfim;
		        END;
		    END IF;                     
        ELSE
            IF  (l_r088vec.TipCol = 5) THEN
                /* Outra unidade */
                SP_RetCra (1, l_r088vec.numemp,5,l_r088vec.numcad,0,'',0,'',l_cracha OUT);
                IF   l_cracha = 0 THEN
                    SP_RetCra (2, l_r088vec.numemp,5,l_r088vec.numcad,0,'',0,'',l_cracha OUT);
                END IF;                                
                l_numemp := l_r088vec.numemp;
		        l_tipcol := 5;
		        l_numcad := l_r088vec.numcad;
		        l_tipdoc := 0;
		        l_numdoc := '';
  	 	        l_datfim := :NEW.datfim;
		        l_horfim := :NEW.horfim;		                    
            ELSE
                /* Colaborador. */
                SP_RETCRA (2, l_r088vec.numemp, l_r088vec.tipcol, l_r088vec.numcad, 0,'',0,'',l_crapro OUT);
                IF   (l_crapro = 0)  THEN
                    SP_RETCRA (1, l_r088vec.numemp, l_r088vec.tipcol, l_r088vec.numcad,0,'',0,'', l_cracha OUT);
                ELSE l_cracha := l_crapro;
                END IF;
                l_numemp := l_r088vec.numemp;
		        l_tipcol := l_r088vec.tipcol;
		        l_numcad := l_r088vec.numcad;
		        l_tipdoc := 0;
		        l_numdoc := '';
		        l_datfim := :NEW.datfim;
		        l_horfim := :NEW.horfim;		        
            END IF;
        END IF;
		
		/* Atualiza pessoa no Data Mart de veículos */
		IF (l_cracha >0) THEN
		    SP_VEIPESCON('I', :NEW.NUMCRA, l_cracha, l_situa, :NEW.PLAVEI, l_datfim, l_horfim, l_tipcol, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
		END IF;
    END LOOP;
  END IF;

  /* Só processa se o status for presente */
  IF (l_froonl = TRUE) AND (l_online = TRUE) AND (:NEW.STAACC = 1) THEN
    IF  (l_libvei = 1) THEN
        /* Chama procedure para alteração */
        FOREACH c_r088atu INTO  l_r088atu.EmpCon,
                                l_r088atu.TclCon,
                                l_r088atu.CadCon,
                                l_r088atu.DatFim
        LOOP
            /*  Busca pelo crachá do colaborador. */
            SP_RETCRA (2, l_r088atu.empcon, l_r088atu.tclcon, l_r088atu.cadcon, 0,'',0,'',l_crapro OUT);
            IF   (l_crapro = 0)  THEN
                  SP_RETCRA (1, l_r088atu.empcon, l_r088atu.tclcon, l_r088atu.cadcon,0,'',0,'', l_cracha OUT);
            ELSE l_cracha := l_crapro;
            END IF;

            l_datfim := :NEW.DATFIM;
            l_horfim := :NEW.HORFIM;
            IF (l_datfim = l_data_zero) OR (l_datfim > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
              l_datfim := DATETIME(31, 12, 2050, 0, 0, 0);
              l_horfim := 1439;
            END IF;

            l_datval := l_r088atu.DATFIM;
            IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
              l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
            END IF;

            IF   ((l_datfim < l_datval) OR (l_datfim = l_datval AND l_horfim <= 1439)) AND (l_datfim <> l_data_zero) THEN
				SP_VEIPESCON('I', :NEW.NUMCRA, l_cracha, l_situa, :NEW.PLAVEI, 
						     l_datfim, l_horfim, l_r088atu.tclcon, l_r088atu.empcon, l_r088atu.tclcon, l_r088atu.cadcon, 0, '');
            ELSE 
				SP_VEIPESCON('I', :NEW.NUMCRA, l_cracha, l_situa, :NEW.PLAVEI, 
						     l_datval, 1439, l_r088atu.tclcon, l_r088atu.empcon, l_r088atu.tclcon, l_r088atu.cadcon, 0, '');
            END IF;

        END LOOP;
    ELSE
        /* Chama procedure para alteração */
        FOREACH c_r088agf INTO  l_r088agf.EmpCon,
                                l_r088agf.TclCon,
                                l_r088agf.CadCon,
                                l_r088agf.DatRet,
                                l_r088agf.HorRet
        LOOP
            /*  Busca pelo crachá do colaborador. */
            SP_RETCRA (2, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon, 0,'',0,'',l_crapro OUT);
            IF   (l_crapro = 0)  THEN
                  SP_RETCRA (1, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon,0,'',0,'', l_cracha OUT);
            ELSE l_cracha := l_crapro;
            END IF;

            l_datfim := :NEW.DATFIM;
            l_horfim := :NEW.HORFIM;
            IF (l_datfim = l_data_zero) OR (l_datfim > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
              l_datfim := DATETIME(31, 12, 2050, 0, 0, 0);
              l_horfim := 1439;
            END IF;

            l_datval := l_r088agf.datret;
            l_horval := l_r088agf.horret;
            IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
              l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
              l_horval := 1439;
            END IF;

            IF   (l_datfim < l_datval) OR (l_datfim = l_datval AND l_horfim <= l_horval) THEN
				SP_VEIPESCON('I', :NEW.NUMCRA, l_cracha, l_situa, :NEW.PLAVEI, 
						     l_datfim, l_horfim, l_r088agf.tclcon, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon, 0, '');
            ELSE 
				SP_VEIPESCON('I', :NEW.NUMCRA, l_cracha, l_situa, :NEW.PLAVEI, 
						     l_datval, l_horval, l_r088agf.tclcon, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon, 0, '');
            END IF;
        END LOOP;
    END IF;
  END IF;

  /* ADE-02 - Geração de pendência de credenciamento de veículos desativada */
  /* IF (:NEW.STAACC = 1 OR :NEW.CPFRes > 0) THEN
      SP_PENDADE_CREVEI('I', :NEW.PLAVEI, :NEW.DATINI, :NEW.HORINI, NULL);
  END; */
  
END␀tÜ␀␀		SENIOR;0©7␀␀

TRIGGER R088HCH_EU AFTER UPDATE ON R088HCH FOR EACH ROW

DECLARE
l_online       BOOLEAN;
  l_froonl       BOOLEAN;
  l_usuonl       BOOLEAN;
  l_situa        NUMBER(1);
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_data_zero    DATE;
  l_libvei       NUMBER(1);
  l_datfim       DATE;
  l_horfim       NUMBER(4);
  l_datval       DATE;
  l_horval       NUMBER(4);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_tipdoc       NUMBER(1);
  l_numdoc       VARCHAR2(20);
  l_data         CHAR(8);
  l_hora         CHAR(4);
  l_chave        CHAR(22);

  CURSOR c_r088atu IS SELECT EMPCON,TCLCON,CADCON,DATFIM
                           FROM R088AUT
                           WHERE PLAVEI = :NEW.PLAVEI
                           AND ((DATINI >= :NEW.DATINI)
						   AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                           /*AND (DATFIM <= :NEW.DATFIM OR :NEW.DATFIM = l_data_zero));*/
       TYPE t_r088atu IS RECORD(
                EMPCON   R088AUT.EmpCon%TYPE,
                TCLCON   R088AUT.TclCon%TYPE,
                CADCON   R088AUT.CadCon%TYPE,
                DATFIM   R088AUT.DatFim%TYPE);
       l_r088atu t_r088atu;

  CURSOR c_r088agf IS SELECT EMPCON,TCLCON,CADCON,DATRET,HORRET
                           FROM R088AGF
                           WHERE PLAVEI = :NEW.PLAVEI AND (VEIUTI = 'A' OR VEIUTI = 'S')
                           AND ((DATAGF > :NEW.DATINI) OR (DATAGF = :NEW.DATINI AND HORAGF >= :NEW.HORINI))
						   AND (DATRET >= l_data_atual OR (DATRET = l_data_atual AND HORRET >= l_hora_atual) OR DATRET = l_data_zero);
                           /*AND (DATRET < :NEW.DATFIM OR (DATRET = :NEW.DATFIM AND HORRET <= :NEW.HORFIM) OR :NEW.DATFIM = l_data_zero);*/
						   
       TYPE t_r088agf IS RECORD(
                EMPCON   R088AGF.EmpCon%TYPE,
                TCLCON   R088AGF.TclCon%TYPE,
                CADCON   R088AGF.CadCon%TYPE,
                DATRET   R088AGF.DatRet%TYPE,
                HORRET   R088AGF.HorRet%TYPE);
       l_r088agf t_r088agf;

  CURSOR c_r088usu IS SELECT TIPCLB,NUMEMP,TIPCOL,NUMCAD,CADOCR,DATVAL,HORVAL
                           FROM R088USU
                           WHERE PLAVEI = :NEW.PLAVEI
                           AND DATALT >= :NEW.DATINI
                           AND ACELIV = 'S';
       TYPE t_r088usu IS RECORD(
                TIPCLB   R088USU.TipClb%TYPE,
                NUMEMP   R088USU.NumEmp%TYPE,
                TIPCOL   R088USU.TipCol%TYPE,
                NUMCAD   R088USU.NumCad%TYPE,
                CADOCR   R088USU.CadOcr%TYPE,
                DATVAL   R088USU.DatVal%TYPE,
                HORVAL   R088USU.HorVal%TYPE);
       l_r088usu t_r088usu;

  CURSOR c_r088VEC IS 
    SELECT NUMEMP, TIPCOL,NUMCAD, 0 TIPDOC, '' NUMDOC FROM R088VEC WHERE PLAVEI = :NEW.PLAVEI
  UNION(
    SELECT NUMEMP, 5 TIPCOL,NUMCAD, 0 TIPDOC, '' NUMDOC FROM R088VEO WHERE PLAVEI = :NEW.PLAVEI
  UNION(
    SELECT 0 NUMEMP, 4 TIPCOL, 0 NUMCAD, TIPDOC, NUMDOC FROM R088VEV WHERE PLAVEI = :NEW.PLAVEI));
  TYPE t_r088vec IS RECORD(
                NUMEMP   R088VEC.NumEmp%TYPE,
                TIPCOL   R088VEC.TipCol%TYPE,
                NUMCAD   R088VEC.NumCad%TYPE, 
                TIPDOC   R088VEV.TipDoc%TYPE,
                NUMDOC   R088VEV.NumDoc%TYPE);
   l_r088VEC t_r088VEC;        
       
BEGIN
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_VerOnLine(l_online OUT);
  SP_UsaFronline(l_froonl OUT, l_libvei OUT);
  SP_Usuonline(l_froonl OUT, l_usuonl OUT);
  l_situa := 0;
  l_data_zero :=  DATETIME(31, 12, 1900, 0, 0, 0);

  /* Seleciona os registros para a alteração. */
  /* CURSOR que busca a última marcação alteraçao de crachás de veículos */
  /* Só processa se o status for presente */
  IF (l_usuonl = TRUE) AND (l_online = TRUE) AND (:NEW.STAACC >0) THEN
    /* Chama procedure para alteração */
    FOREACH c_r088usu INTO  l_r088usu.TipClb,
                            l_r088usu.NumEmp,
                            l_r088usu.TipCol,
                            l_r088usu.NumCad,
                            l_r088usu.CadOcr,
                            l_r088usu.DatVal,
                            l_r088usu.HorVal
    LOOP
        IF (l_r088usu.TipClb = 1) THEN
           /*  Busca pelo crachá do colaborador. */
           SP_RETCRA (2, l_r088usu.numemp, l_r088usu.tipcol, l_r088usu.numcad, 0,'',0,'',l_crapro OUT);
           IF   (l_crapro = 0)  THEN
                 SP_RETCRA (1, l_r088usu.numemp, l_r088usu.tipcol, l_r088usu.numcad,0,'',0,'', l_cracha OUT);
           ELSE l_cracha := l_crapro;
           END IF;
		   l_numemp := l_r088usu.numemp;
		   l_tipcol := l_r088usu.tipcol;
		   l_numcad := l_r088usu.numcad;
        ELSE
           /*  Busca pelo crachá do colaborador. */
           SP_RETCRA (2, l_r088usu.numemp, 5, l_r088usu.cadocr, 0,'',0,'',l_crapro OUT);
           IF   (l_crapro = 0)  THEN
                 SP_RETCRA (1, l_r088usu.numemp, 5, l_r088usu.cadocr,0,'',0,'', l_cracha OUT);
           ELSE l_cracha := l_crapro;
           END IF;
		   l_numemp := l_r088usu.numemp;
		   l_tipcol := 5;
		   l_numcad := l_r088usu.cadocr;
        END IF;

        l_datfim := :NEW.DATFIM;
        l_horfim := :NEW.HORFIM;
        IF (l_datfim = l_data_zero) OR (l_datfim > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
          l_datfim := DATETIME(31, 12, 2050, 0, 0, 0);
          l_horfim := 1439;
        END IF;

        l_datval := l_r088usu.DATVAL;
        l_horval := l_r088usu.horval;
        IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
          l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
          l_horval := 1439;
        END IF;

        IF   (l_datfim < l_datval) OR ((l_datfim = l_datval AND l_horfim <= l_horval)) THEN
			  SP_VEIPESCON('U', :NEW.NUMCRA, l_cracha, l_situa, :NEW.PLAVEI, 
                           l_datfim, l_horfim, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
        ELSE
			  SP_VEIPESCON('U', :NEW.NUMCRA, l_cracha, l_situa, :NEW.PLAVEI, 
                           l_datval, l_horval, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
        END IF;
    END LOOP;
            
    /* veículo que não são da frota*/
    FOREACH c_r088vec INTO  l_r088vec.NumEmp,
                            l_r088vec.TipCol,
                            l_r088vec.NumCad,
                            l_r088vec.TipDoc,
                            l_r088vec.NumDoc
    LOOP
        l_cracha := 0;
        IF (l_r088vec.TipCol = 4) THEN
            /* Visitante */
            SP_RetCra (1, 0, 4, 0,0,'',l_r088vec.tipdoc,l_r088vec.numdoc,l_cracha OUT);
            
            l_numemp := 0;
		    l_tipcol := 4;
		    l_numcad := 0;
		    l_tipdoc := l_r088vec.tipdoc;
		    l_numdoc := l_r088vec.numdoc;
		    l_datfim := :NEW.datfim;
		    l_horfim := :NEW.horfim;
		    IF (l_cracha > 0) THEN
		        /* pesquisa pela data de validade */
		        BEGIN 
    		        SELECT DATFIM, HORFIM INTO l_datfim, l_horfim  FROM R090HCH WHERE 
	    	            R090HCH.NUMCRA = l_cracha AND
		                R090HCH.TIPDOC = l_tipdoc AND
                        R090HCH.NUMDOC = l_numdoc AND
                        (R090HCH.DATINI < l_data_atual OR
                        (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
                        (R090HCH.DATFIM = l_data_zero OR
                         R090HCH.DATFIM > l_data_atual OR
                        (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
                EXCEPTION WHEN OTHERS THEN 
		            l_datfim := :NEW.datfim;
		            l_horfim := :NEW.horfim;
		        END;
		    END IF;           
        ELSE
            IF  (l_r088vec.TipCol = 5) THEN
                /* Outra unidade */
                SP_RetCra (1, l_r088vec.numemp,5,l_r088vec.numcad,0,'',0,'',l_cracha OUT);
                IF   l_cracha = 0 THEN
                    SP_RetCra (2, l_r088vec.numemp,5,l_r088vec.numcad,0,'',0,'',l_cracha OUT);
                END IF;                                
                l_numemp := l_r088vec.numemp;
		        l_tipcol := 5;
		        l_numcad := l_r088vec.numcad;
		        l_tipdoc := 0;
		        l_numdoc := '';
		        l_datfim := :NEW.datfim;
		        l_horfim := :NEW.horfim;
            ELSE
                /* Colaborador. */
                SP_RETCRA (2, l_r088vec.numemp, l_r088vec.tipcol, l_r088vec.numcad, 0,'',0,'',l_crapro OUT);
                IF   (l_crapro = 0)  THEN
                    SP_RETCRA (1, l_r088vec.numemp, l_r088vec.tipcol, l_r088vec.numcad,0,'',0,'', l_cracha OUT);
                ELSE l_cracha := l_crapro;
                END IF;
                l_numemp := l_r088vec.numemp;
		        l_tipcol := l_r088vec.tipcol;
		        l_numcad := l_r088vec.numcad;
		        l_tipdoc := 0;
		        l_numdoc := '';
		        l_datfim := :NEW.datfim;
		        l_horfim := :NEW.horfim;
            END IF;
        END IF;
		
		/* Atualiza pessoa no Data Mart de veículos */
		IF (l_cracha > 0) THEN
		    SP_VEIPESCON('I', :NEW.NUMCRA, l_cracha, l_situa, :NEW.PLAVEI, l_datfim, l_horfim, l_tipcol, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
		END IF;
    END LOOP;          
  END IF;

  /* Só processa se o status for presente */
  IF (l_froonl = TRUE) AND (l_online = TRUE) AND (:NEW.STAACC >0) THEN
    IF (l_libvei = 1) THEN
        /* Chama procedure para alteração */
        FOREACH c_r088atu INTO  l_r088atu.EmpCon,
                                l_r088atu.TclCon,
                                l_r088atu.CadCon,
                                l_r088atu.DatFim
        LOOP
            /*  Busca pelo crachá do colaborador. */
            SP_RETCRA (2, l_r088atu.empcon, l_r088atu.tclcon, l_r088atu.cadcon, 0,'',0,'',l_crapro OUT);
            IF   (l_crapro = 0)  THEN
                  SP_RETCRA (1, l_r088atu.empcon, l_r088atu.tclcon, l_r088atu.cadcon,0,'',0,'', l_cracha OUT);
            ELSE l_cracha := l_crapro;
            END IF;

            l_datfim := :NEW.DATFIM;
            l_horfim := :NEW.HORFIM;
            IF (l_datfim = l_data_zero) OR (l_datfim > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
              l_datfim := DATETIME(31, 12, 2050, 0, 0, 0);
              l_horfim := 1439;
            END IF;

            l_datval := l_r088atu.DATFIM;
            IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
              l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
            END IF;

            IF   ((l_datfim < l_datval) OR (l_datfim = l_datval AND l_horfim <= 1439)) AND (l_datfim <> l_data_zero) THEN               

 
				SP_VEIPESCON('U', :NEW.NUMCRA, l_cracha, l_situa, :NEW.PLAVEI, 
                             l_datfim, l_horfim, l_r088atu.tclcon, l_r088atu.empcon, l_r088atu.tclcon, l_r088atu.cadcon, 0, '');
            ELSE 
			    SP_VEIPESCON('U', :NEW.NUMCRA, l_cracha, l_situa, :NEW.PLAVEI, 
                             l_datval, 1439, l_r088atu.tclcon, l_r088atu.empcon, l_r088atu.tclcon, l_r088atu.cadcon, 0, '');
            END IF;
        END LOOP;
    ELSE
        /* Chama procedure para alteração */
        FOREACH c_r088agf INTO  l_r088agf.EmpCon,
                                l_r088agf.TclCon,
                                l_r088agf.CadCon,
                                l_r088agf.DatRet,
                                l_r088agf.HorRet
        LOOP
            /*  Busca pelo crachá do colaborador. */
            SP_RETCRA (2, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon, 0,'',0,'',l_crapro OUT);
            IF   (l_crapro = 0)  THEN
                  SP_RETCRA (1, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon,0,'',0,'', l_cracha OUT);
            ELSE l_cracha := l_crapro;
            END IF;

            l_datfim := :NEW.DATFIM;
            l_horfim := :NEW.HORFIM;
            IF (l_datfim = l_data_zero) OR (l_datfim > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
              l_datfim := DATETIME(31, 12, 2050, 0, 0, 0);
              l_horfim := 1439;
            END IF;

            l_datval := l_r088agf.datret;
            l_horval := l_r088agf.horret;
            IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
              l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
              l_horval := 1439;
            END IF;

            IF   (l_datfim < l_datval) OR (l_datfim = l_datval AND l_horfim <= l_horval) THEN                
			    SP_VEIPESCON('U', :NEW.NUMCRA, l_cracha, l_situa, :NEW.PLAVEI, 
                             l_datfim, l_horfim, l_r088agf.tclcon, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon, 0, '');
            ELSE 			    
			    SP_VEIPESCON('U', :NEW.NUMCRA, l_cracha, l_situa, :NEW.PLAVEI, 
                             l_datval, l_horval, l_r088agf.tclcon, l_r088agf.empcon, l_r088agf.tclcon, l_r088agf.cadcon, 0, '');
            END IF;
        END LOOP;
    END IF;
  END IF;

  /* Geração de pendência de alteração de crachá de veículo para o Integrador senior X */
  IF :OLD.DATINI <> :NEW.DATINI OR :OLD.DATFIM <> :NEW.DATFIM OR
     :OLD.HORINI <> :NEW.HORINI OR :OLD.HORFIM <> :NEW.HORFIM THEN
    SP_DATSTR(:NEW.DATINI,'DDMMYYYY',l_data OUT);
    SP_INTSTR(:NEW.HORINI,'9999',l_hora OUT);
    l_chave := :NEW.PLAVEI||l_data||l_hora;
    SP_SAM_PENDENCIES(48, 2, l_chave);
  END IF;

  /* ADE-02 - Geração de pendência de credenciamento de veículos desativada */
  /*IF (:NEW.PROTCL IS NULL OR (:OLD.PROTCL IS NOT NULL AND :OLD.PROTCL = :NEW.PROTCL)) THEN */
  /*    IF (:OLD.STAACC = 0 AND :NEW.STAACC = 1) THEN */
  /*        SP_PENDADE_CREVEI('I', :NEW.PLAVEI, :NEW.DATINI, :NEW.HORINI, NULL); */      
  /*    ELSE IF (:NEW.STAACC > 0) THEN */
  /*            SP_PENDADE_CREVEI('R', :NEW.PLAVEI, :NEW.DATINI, :NEW.HORINI, NULL); */
  /*        END; */
  /*    END; */
  /*END; */
END␀rÜ␀␀		SENIOR;0y␀␀

TRIGGER R088HCH_ED AFTER DELETE ON R088HCH FOR EACH ROW
DECLARE
  l_online          BOOLEAN;
  l_data            CHAR(8);
  l_hora            CHAR(4);
  l_chave           CHAR(22);
BEGIN
  SP_VerOnLine(l_online OUT);
  /* Verifica se o sistema de frota está trabalhando de forma on-line */
  IF (l_online = TRUE) THEN
      /* Verifica se é crachá titular. */     
	  /*EFETUA A ATUALIZAÇÃO DA ASSOCIAÇÃO DE VEICULO E PESSOA NA CONTROLE*/
	  SP_VEIPESCON('R', :OLD.NUMCRA, 0, 1, :OLD.PLAVEI, :OLD.DATFIM, :OLD.HORFIM, 0, 0, 0, 0, 0, '');
  END IF;

  /* Geração de pendência de alteração de crachá de veículo para o Integrador senior X */
  /* Para o Integrador, a exclusão de um crachá trata-se da alteração de uma credencial da G7 */
  SP_DATSTR(:OLD.DATINI,'DDMMYYYY',l_data OUT);
  SP_INTSTR(:OLD.HORINI,'9999',l_hora OUT);
  l_chave := :OLD.PLAVEI||l_data||l_hora;
  SP_SAM_PENDENCIES(48, 2, l_chave);

  /* ADE-02 - Geração de pendência de credenciamento de veículos desativada */  
  /* IF (:OLD.STAACC > 0) THEN
      SP_PENDADE_CREVEI('E', :OLD.PLAVEI, :OLD.DATINI, :OLD.HORINI, :OLD.PROTCL);
