          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ANOADM', :OLD.ANOADM);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ATEADM', CONVERT(NUMBER_TO_CHAR, :OLD.ATEADM));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDAPL', CONVERT(NUMBER_TO_CHAR, :OLD.QTDAPL));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDDOA', CONVERT(NUMBER_TO_CHAR, :OLD.QTDDOA));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODAPR', CONVERT(NUMBER_TO_CHAR, :OLD.CODAPR));         
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODAPD', CONVERT(NUMBER_TO_CHAR, :OLD.CODAPD));
