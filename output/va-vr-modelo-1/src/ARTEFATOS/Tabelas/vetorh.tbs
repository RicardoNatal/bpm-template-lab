     INSERT INTO R070HCH_AUX (TIPOPE,TIPCRA,NUMEMP,NUMCAD,DATINI,HORINI,NUMCRA,DATFIM,HORFIM,STAATU,STAACC)
     VALUES (1,:OLD.TIPCRA,:OLD.NUMEMP,:OLD.NUMCAD,:OLD.DATINI,:OLD.HORINI,:OLD.NUMCRA,:OLD.DATFIM,:OLD.HORFIM,:OLD.STAATU,:OLD.STAACC);
