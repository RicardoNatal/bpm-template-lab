@␀␀


PROCEDURE SP_VALCRA(P_NUMCRACHA NUMBER(12), P_RETVAL OUT BOOLEAN)
 IS

l_data_atual   DATE;
l_hora_atual   NUMBER(4);
l_data_zero    DATE;
l_numcra       NUMBER(12);
l_contador     INTEGER;
BEGIN  
    l_data_atual := CURDATE();
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());  
    l_data_zero  := '31/12/1900,00:00:00';     
    l_contador   := 0;
             
    BEGIN   
      BEGIN  
	    SELECT COUNT(*) INTO l_contador      
	      FROM r069fis a
	     WHERE (numfis = P_NUMCRACHA)
	       AND (numcra <> P_NUMCRACHA)
	       AND (
	            (datfim = l_data_zero)
	         OR (datfim > l_data_atual)
	         OR (datfim = l_data_atual AND horfim > l_hora_atual)
	       );   
	       IF (l_contador > 0) THEN
	         P_RETVAL := false;
	       END IF;
	  END;	         
    EXCEPTION 
      WHEN OTHERS THEN               
          IF (l_contador = 0) THEN
            P_RETVAL := true;   
          ELSE
            IF (l_contador > 0) THEN
              P_RETVAL := false;
            END IF;
          END IF;                         
    END;     
END		SENIOR;21
