{␀␀PROCEDURE AtuSitCra(P_SITUA VARCHAR2(255),P_CRACHA NUMBER(12))
 IS

l_SitAux       NUMBER(2);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
BEGIN
    /* atualiza r070con */
    l_sitAux := CONVERT(CHAR_TO_NUMBER,p_situa);
    /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
    SP_UPDFIS(p_cracha,l_SitAux,' ');
    /*Atualiza a Controle*/
    SP_MAPFIS(p_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
    IF (l_crapri = 0) THEN
