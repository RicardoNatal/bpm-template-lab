TRIGGER R038CAT_EI AFTER INSERT ON R038CAT FOR EACH ROW
DECLARE
	l_Valor VARCHAR2(2000);
	l_datces DATE;
	l_comando_nulo BOOLEAN;
	l_layoutAltContratual VARCHAR2(6);
BEGIN
	IF :NEW.STAHIS = 1 THEN
		BEGIN
			SELECT R034FUN.DATCES INTO l_datces
			FROM R034FUN
			WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
			R034FUN.NUMEMP = :NEW.NUMEMP AND
			R034FUN.NUMCAD = :NEW.NUMCAD;
		EXCEPTION WHEN OTHERS THEN
			l_comando_nulo:=TRUE;
		END;

		IF (:NEW.DATALT >= l_datces) OR (l_datces IS NULL) THEN
			UPDATE R034FUN
			SET CATESO = :NEW.CODCAT,
			DATCES = :NEW.DATALT
			WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
			R034FUN.NUMEMP = :NEW.NUMEMP AND
			R034FUN.NUMCAD = :NEW.NUMCAD;
		END IF;
	END IF;

	/* eSocial */
	RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAltContratual OUT);
	IF (l_layoutAltContratual = 'S-2206') THEN
		l_Valor :=  '';
		
		SP_HIST_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038CAT', 'DATALT', 'I', l_Valor, '', 1, 'R038CAT_EI');
	END IF;
	/* eSocial */
END␀cÔ␀␀		SENIOR;0Ì␀␀

TRIGGER R038CAT_EU AFTER UPDATE ON R038CAT FOR EACH ROW
DECLARE
	l_Valor VARCHAR2(2000);
	l_datces DATE;
	l_comando_nulo BOOLEAN;
	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_layoutAltContratual VARCHAR2(6);
	l_JsonCamposAlterados VARCHAR2(2000);
BEGIN
	IF  :NEW.STAHIS = 1 THEN
		BEGIN
			SELECT R034FUN.DATCES INTO l_datces
			FROM R034FUN
			WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
			R034FUN.NUMEMP = :NEW.NUMEMP AND
			R034FUN.NUMCAD = :NEW.NUMCAD;
		EXCEPTION WHEN OTHERS THEN
			l_comando_nulo:=TRUE;
		END;
		IF (:NEW.datalt >= l_datces) OR (l_datces IS NULL) THEN
			UPDATE R034FUN
			SET CATESO = :NEW.CODCAT,
			DATCES = :NEW.DATALT
			WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
			R034FUN.NUMEMP = :NEW.NUMEMP AND
			R034FUN.NUMCAD = :NEW.NUMCAD;
		END IF;
	END IF;

	/* eSocial */
	l_Alterou := FALSE;
	l_JsonCamposAlterados := '';

	SP_VALUPDATE_NUM(:OLD.CODCAT, :NEW.CODCAT, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_NUM_JSON('CODCAT', :NEW.CodCat, :OLD.CodCat, l_JsonCamposAlterados OUT);
	END IF;

	IF (l_Alterou = TRUE) THEN 
		RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAltContratual OUT);
		IF (l_layoutAltContratual = 'S-2206') THEN
			l_Valor :=  '';
		
			SP_HIST_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038CAT', 'DATALT', 'A', l_Valor, l_JsonCamposAlterados, 1, 'R038CAT_EU');
		END IF;
	END IF;
	/* eSocial */
END␀dÔ␀␀	SENIOR;0ï
␀␀TRIGGER R038CAT_SD AFTER DELETE ON R038CAT

DECLARE
l_CODCAT       NUMBER(4);
  l_DATCES       DATE;

  /* CURSOR c/ os registros gravados no R038CAT_AUX */
  CURSOR c_R038CAT_del IS SELECT NUMEMP,TIPCOL,NUMCAD,DATALT,CODCAT,STAHIS FROM R038CAT_AUX;

  TYPE t_R038CAT_aux IS RECORD(
    NUMEMP   R038CAT_AUX.NUMEMP%TYPE,
    TIPCOL   R038CAT_AUX.TIPCOL%TYPE,
    NUMCAD   R038CAT_AUX.NUMCAD%TYPE,
    DATALT   R038CAT_AUX.DATALT%TYPE,
    CODCAT   R038CAT_AUX.CODCAT%TYPE,
    STAHIS   R038CAT_AUX.STAHIS%TYPE);

  l_R038CAT_aux t_R038CAT_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_R038CAT_del INTO  l_R038CAT_aux.NUMEMP,
                              l_R038CAT_aux.TIPCOL,
                              l_R038CAT_aux.NUMCAD,
                              l_R038CAT_aux.DATALT,
                              l_R038CAT_AUX.CODCAT,
                              l_R038CAT_aux.STAHIS
  LOOP
    IF l_R038CAT_aux.STAHIS = 1 THEN
      SELECT CATESO, DATCES INTO  l_CODCAT, l_DATCES FROM R034FUN
       WHERE NUMEMP = l_R038CAT_aux.NUMEMP AND TIPCOL = l_R038CAT_aux.TIPCOL AND NUMCAD = l_R038CAT_aux.NUMCAD;

      IF (l_R038CAT_AUX.CODCAT =  l_CODCAT) AND (l_R038CAT_aux.DATALT = l_DATCES) THEN
        /* Pega o historico anterior */
        BEGIN
          SELECT A.CODCAT,A.DATALT
          INTO  l_CODCAT,l_DATCES
          FROM R038CAT A
          WHERE A.NUMEMP = l_R038CAT_aux.NUMEMP
          AND   A.TIPCOL = l_R038CAT_aux.TIPCOL
          AND   A.NUMCAD = l_R038CAT_aux.NUMCAD
          AND   A.STAHIS = 1
          AND DATALT IN (SELECT MAX(DATALT) FROM R038CAT
                         WHERE NUMEMP = l_R038CAT_aux.NUMEMP
                         AND   TIPCOL = l_R038CAT_aux.TIPCOL
                         AND   NUMCAD = l_R038CAT_aux.NUMCAD
                         AND   STAHIS = 1);
        EXCEPTION
          WHEN TOO_MANY_ROWS THEN
            RAISERROR 103 'Erro em R038CAT - TOO MANY ROWS';
          WHEN NO_DATA_FOUND THEN
            l_CODCAT:=0;
            l_DATCES:='31/12/1900,00:00:00';
          WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT R038CAT';
        END;

        /* Atualiza tabela de colaboradores */
        BEGIN
          UPDATE R034FUN
             SET CATESO = l_CODCAT,
                 DATCES = l_DATCES
           WHERE R034FUN.TIPCOL = l_R038CAT_aux.TIPCOL AND
                 R034FUN.NUMEMP = l_R038CAT_aux.NUMEMP AND
                 R034FUN.NUMCAD = l_R038CAT_aux.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro Na Atualização do R034FUN';
        END;
      END IF;
    END IF;

  END LOOP;

  /* Apaga Registro OLD em R038CAT_AUX */
  BEGIN
    DELETE FROM R038CAT_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀aÔ␀␀		SENIOR;0␀␀

TRIGGER R038CAT_ED AFTER DELETE ON R038CAT FOR EACH ROW
DECLARE
	l_layoutAltContratual VARCHAR2(6);
	l_Valor VARCHAR2(2000);
BEGIN
	BEGIN
		/* Insere Registro Old */
		INSERT INTO R038CAT_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, CODCAT, STAHIS) 
		VALUES (:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, :OLD.CODCAT, :OLD.STAHIS);
	EXCEPTION WHEN OTHERS THEN
		RAISERROR 103 'Erro no INSERT em R038CAT_AUX.';
	END;

	/* eSocial */ 
	RH_LAY_CONTR_COLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layoutAltContratual OUT);
	IF (l_layoutAltContratual = 'S-2206') THEN
		l_Valor :=  '';
		
		SP_HIST_ESOCIAL(l_layoutAltContratual, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, 'R038CAT', 'DATALT', 'E', l_Valor, '', 1, 'R038CAT_ED');
	END IF;
	/* eSocial */
