␀␀create or replace PROCEDURE SP_R034CPL_HIST_UP(p_seqhis in number, p_numemp IN NUMBER,p_tipcol IN NUMBER,p_numcad IN NUMBER,p_cidric IN NUMBER,p_dexric IN DATE,p_seqreg IN NUMBER,p_datexp IN DATE,p_orgcnh IN VARCHAR2) is
begin
  begin

	UPDATE R038HFC 
	SET 
		cidric = p_cidric, 
		dexric = p_dexric, 
		seqreg = p_seqreg, 
		datexp = p_datexp, 
		orgcnh = p_orgcnh
	WHERE numemp = p_numemp
	  AND tipcol = p_tipcol
	  AND numcad = p_numcad
	  AND seqhis = p_seqhis;
  exception
	when OTHERS then
	  raise_application_error(-20000 + -(103),'Erro ao atualizar histórico de alteração da ficha complementar.');
  end;
end;	MSSQL;0
ò␀␀CREATE  PROCEDURE SP_R034CPL_HIST_UP(@p_seqhis INTEGER, @p_numemp SMALLINT, @p_tipcol SMALLINT, @p_numcad INTEGER, @p_cidric INTEGER, @p_dexric DATETIME, @p_seqreg BIGINT, @p_datexp DATETIME, @p_orgcnh VARCHAR(20)) AS
BEGIN
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  /* TRY */
	UPDATE r038hfc
    SET 
		cidric = @p_cidric, 
		dexric = @p_dexric, 
		seqreg = @p_seqreg,
		datexp = @p_datexp,
		orgcnh = @p_orgcnh
	WHERE numemp = @p_numemp
	  AND tipcol = @p_tipcol
	  AND numcad = @p_numcad
	  AND seqhis = @p_seqhis   
	SELECT @ChkError = @@Error
	IF @ChkError <> 0
	BEGIN
	  GOTO EXC1
	END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
	EXC1:
	SELECT @SE_EXC1 = @ChkError
	IF @ChkError <> 0
	BEGIN
	  BEGIN
		SELECT @ChkError = 0
		BEGIN
		  RAISERROR('Erro ao atualizar histórico de alteração da ficha complementar.',11,1) WITH SETERROR
		  SELECT @ChkError = -30
		  GOTO FIM
		END
	  END
	END
  /* END EXCEPTION HANDLER */
FIM:
  RETURN @ChkError
END	POSTGRESQL;0
 ␀␀create or replace PROCEDURE SP_R034CPL_HIST_UP(p_seqhis bigint, p_numemp smallint,p_tipcol smallint,p_numcad integer,p_cidric integer,p_dexric timestamp,p_seqreg bigint,p_datexp timestamp,p_orgcnh varchar)
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN
  begin

	UPDATE R038HFC 
	SET 
		cidric = p_cidric, 
		dexric = p_dexric, 
		seqreg = p_seqreg, 
		datexp = p_datexp, 
		orgcnh = p_orgcnh
	WHERE numemp = p_numemp
	  AND tipcol = p_tipcol
	  AND numcad = p_numcad
	  AND seqhis = p_seqhis;
  exception
	when OTHERS then
	  RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'Erro ao atualizar histórico de alteração da ficha complementar.';
  end;
end;
