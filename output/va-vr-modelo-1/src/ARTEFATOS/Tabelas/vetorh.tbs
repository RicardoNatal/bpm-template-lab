TRIGGER R304VIN_SI AFTER INSERT ON R304VIN
DECLARE
	CURSOR c_R304VIN IS
	SELECT NUMEMP, TIPCOL, NUMCAD, NUMMAT, NUMCPF, DATVIG, SEQREG
	  FROM R304VIN 
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304VIN IS RECORD (
		NUMEMP   R304VIN.NumEmp%TYPE,
		TIPCOL   R304VIN.TipCol%TYPE,
		NUMCAD   R304VIN.NumCad%TYPE,
		NUMMAT   R304VIN.NumMat%TYPE,
		NUMCPF   R304VIN.NumCpf%TYPE,
		DATVIG   R304VIN.DatVig%TYPE,
		SEQREG   R304VIN.SeqReg%TYPE
	);
    
    l_R304VIN t_R304VIN;
	l_PidSta VARCHAR2(30);
	l_DesRes VARCHAR(250);
	l_NumCpfStr VARCHAR2(11);
	l_DatVigStr VARCHAR2(10);
BEGIN
	FOREACH c_R304VIN INTO l_R304VIN.NumEmp, l_R304VIN.TipCol, l_R304VIN.NumCad, l_R304VIN.NumMat, l_R304VIN.NumCpf, l_R304VIN.DatVig, l_R304VIN.SeqReg
	LOOP
		/* Gera um novo PID */
		SP_GERPIDSTA(l_R304VIN.NumEmp, 11, l_PidSta OUT);
		
		/* Adiciona zeros à esquerda do CPF quando necessário */
		l_NumCpfStr := CONVERT(NUMBER_TO_CHAR, l_R304VIN.NumCpf);
		WHILE (LENGTH(l_NumCpfStr) < 11) LOOP
			l_NumCpfStr := '0' || l_NumCpfStr;
		END LOOP;
		
		SP_DATSTR(l_R304VIN.DatVig, 'DD/MM/YYYY', l_DatVigStr OUT);
		
		l_DesRes := 'Matrícula: ' || l_R304VIN.NumMat || ', CPF: ' || l_NumCpfStr || ', Data Início Vigência: ' || l_DatVigStr;
			
		/* Inclui registro de status na tabela R304STA */
		SP_GERSTA_ESFINGE(11, l_PidSta, l_R304VIN.DatVig, l_DesRes, l_R304VIN.NumEmp, l_R304VIN.TipCol, l_R304VIN.NumCad);
		
		/* Grava o PID gerado no campo PIDSTA da própria tabela */
		BEGIN
			UPDATE R304VIN
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304VIN.NumEmp
			   AND TIPCOL = l_R304VIN.TipCol
			   AND NUMCAD = l_R304VIN.NumCad
			   AND NUMMAT = l_R304VIN.NumMat
			   AND NUMCPF = l_R304VIN.NumCpf
			   AND DATVIG = l_R304VIN.DatVig
			   AND SEQREG = l_R304VIN.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304VIN.';		
		END;
	END LOOP;
END␀ûå␀␀		SENIOR;0I␀␀TRIGGER R304VIN_EI BEFORE INSERT ON R304VIN FOR EACH ROW
DECLARE
	l_SeqReg NUMBER(9);
	l_StaEnv CHAR;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Busca última sequência cadastrada */
	BEGIN
		SELECT VIN.SEQREG, STA.STAENV INTO l_SeqReg, l_StaEnv FROM R304VIN VIN, R304STA STA
		 WHERE VIN.PIDSTA = STA.PIDSTA
		   AND VIN.NUMEMP = :NEW.NumEmp
		   AND VIN.TIPCOL = :NEW.TipCol
		   AND VIN.NUMCAD = :NEW.NumCad
		   AND VIN.NUMMAT = :NEW.NumMat
		   AND VIN.NUMCPF = :NEW.NumCpf
		   AND VIN.DATVIG = :NEW.DatVig
		   AND VIN.PIDSTA = STA.PIDSTA
		   AND VIN.SEQREG = (SELECT MAX(VIN2.SEQREG) FROM R304VIN VIN2
		   					  WHERE VIN2.NUMEMP = VIN.NUMEMP
		   					    AND VIN2.TIPCOL = VIN.TIPCOL
		   					    AND VIN2.NUMCAD = VIN.NUMCAD
		   					    AND VIN2.NUMMAT = VIN.NUMMAT
		   					    AND VIN2.NUMCPF = VIN.NUMCPF
		   					    AND VIN2.DATVIG = VIN.DATVIG);
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
			l_StaEnv := '';
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304VIN.';
	END;
	
	/* Verifica se encontrou última sequência */
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
		
		/* Verifica se a última sequência está com status Cancelado */
		IF (l_StaEnv <> 'N') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que registro de sequência anterior ' || l_SeqRegStr || ' esteja com status Cancelado.';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀üå␀␀		SENIOR;0•␀␀

TRIGGER R304VIN_EU BEFORE UPDATE ON R304VIN FOR EACH ROW
DECLARE
	l_StaEnv CHAR;
BEGIN
	/* Não deixa alterar registro caso status seja diferente de P - Pendente Envio ou R - Erro */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro podem ser alterados/excluídos.';
	END IF;
END␀ıå␀␀	SENIOR;0/␀␀

TRIGGER R304VIN_SD AFTER DELETE ON R304VIN
BEGIN
	BEGIN
		DELETE FROM R304STA
		 WHERE LAYOUT = 11
		   AND NOT EXISTS (SELECT 1 FROM R304VIN WHERE R304VIN.PIDSTA = R304STA.PIDSTA);
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao excluir registros não utilizados na tabela R304STA.';
	END;
END␀úå␀␀		SENIOR;0e


TRIGGER R304VIN_AD AFTER DELETE ON R304VIN FOR EACH ROW
BEGIN
	SP_EXCSTA_ESFINGE(:OLD.PidSta);
END␀␀␀*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿå␀␀…¬␀␀´␀	Ôÿ␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ␀␀␀␀␀P%€$0.w␀Æÿ␀␀…Ó␀␀␀ª¬␀␀	Ôÿ␀␀␀␀␀O°␀␀H¯␀␀°␀␀%␀␀ÿ␀␀ÿ␀s¬␀␀␀	Ôÿ␀␀␀␀␀¤?‰#‰#Q␀Æÿ␀␀ÿ␀ÓEÑ␀	Ôÿ␀␀␀␀␀6LÕGÕGqC␀êÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀ğ&␀		Ôÿ␀␀␀␀␀ÛeÌeĞep␀Æÿ␀␀ÿ␀8␀	Ôÿ␀␀␀␀␀›?À#Á#Q␀Æÿ␀␀ÿ␀§␀␀	Ôÿ␀␀␀␀␀¨␀␀‚ª␀␀ƒª␀␀␀␀ÿ␀␀ÿ␀5Â␀␀EÔÿ␀␀␀␀␀,Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀)+Ñ␀Ôÿ␀␀␀␀␀M&M&M&qC␀␀êÿ␀␀ÿ␀++Ñ␀Ôÿ␀␀␀␀␀U&U&U&qC␀␀êÿ␀␀ÿ␀,+Ç␀Ôÿ␀␀␀␀␀W&W&W&z␀Æÿ␀␀ÿ␀-+Ç␀Ôÿ␀␀␀␀␀Y&Y&Y&z␀Æÿ␀␀ÿ␀.+Ç␀Ôÿ␀␀␀␀␀[&[&[&z␀Æÿ␀␀ÿ␀/+Ç␀Ôÿ␀␀␀␀␀\&\&\&z␀Æÿ␀␀ÿ␀0+'Ôÿ␀␀␀␀␀]&]&]&D␀␀ÿ␀␀ÿ␀1+'Ôÿ␀␀␀␀␀^&^&^&D␀␀ÿ␀␀ÿ␀2+*Ôÿ␀␀␀␀␀_&_&_&,␀␀ÿ␀␀ÿ␀␀␀␀æ␀␀
