          END
        /*Fim Insert ProvisÃ³rio*/

        /* END EXCEPTION HANDLER */
        FETCH NEXT FROM c_r070PEA INTO @l_r070pea_CODPRM, @l_r070pea_DATINI, @l_r070pea_HORINI, @l_r070pea_DATFIM, @l_r070pea_HORFIM
