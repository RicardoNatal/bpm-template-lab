TRIGGER R006TMA_SU AFTER UPDATE ON R006TMA FOR EACH ROW
DECLARE
  l_Valor          VARCHAR2(2000);
  l_Valor2         VARCHAR2(2000);
  l_Alterou        BOOLEAN;
  l_Valido         BOOLEAN;
  l_dataZero       DATE;
  l_DataReferencia DATE;
  l_Empresa        NUMBER;
  CURSOR c_DefinicaoEsocial IS SELECT NUMEMP
    FROM R030DES 
   WHERE R030DES.SIMFOL > l_dataZero
   AND EXISTS (SELECT 1 FROM R038HES WHERE R038HES.NUMEMP = R030DES.NUMEMP AND R038HES.CODESC = :NEW.CODESC)
   ORDER BY NUMEMP;
BEGIN
RH_250ALT(33);
  
  /* eSocial */
  l_Alterou := FALSE;
  SP_VALUPDATE_NUM(:OLD.TIPJOS, :NEW.TIPJOS, l_Valido OUT);
  IF (l_Valido = TRUE) THEN	
	l_Alterou := TRUE;
  END IF;  
  
  SP_VALUPDATE_DES(:OLD.DESSIM, :NEW.DESSIM, l_Valido OUT);
  IF (l_Valido = TRUE) THEN	
	l_Alterou := TRUE;
  END IF;
  
  l_dataZero := '31/12/1900,00:00:00';
  IF (l_Alterou = TRUE) THEN   
    FOREACH c_DefinicaoEsocial INTO l_Empresa
    LOOP
      l_Valor := '';
      SP_CONCATENAR_NUM('CODESC', :NEW.CODESC, l_Valor OUT);
      l_DataReferencia := CURDATE();
      SP_CONCATENAR_DAT('DATALT', l_DataReferencia, l_Valor OUT);
      
      l_Valor2 := '';
      SP_CONCATENAR_NUM('CODESC', :OLD.CODESC, l_Valor2 OUT);
      
      SP_ESOCIAL_1050(l_Empresa, 'R006TMA', 'A', l_Valor, l_Valor2, 0, 'R006TMA_SU');
    END LOOP;
  END IF;    
  /* eSocial */
END␀êÎ␀␀		SENIOR;0W

