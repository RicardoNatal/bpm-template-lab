8␀	Ôÿ?␀␀␀␀␀&±␀␀6¯␀␀±␀␀Q␀Æÿ␀␀ÿ␀bDÑ␀	Ôÿ␀␀␀␀␀€JëîEqCÈ‡␀êÿ␀␀ÿ␀‡§␀␀UÔÿ?␀␀␀␀␀n©␀␀ç§␀␀ç§␀␀Vë‡␀␀ÿ␀␀ÿ␀<EÑ␀Ôÿ?␀␀␀␀␀oLjLkLqC␀êÿ␀␀ÿ␀␀␀␀0;2;3ÊÓ␀␀		SENIOR;0␀␀TRIGGER R034PRE_AI AFTER INSERT ON R034PRE FOR EACH ROW
DECLARE
  l_Valor VARCHAR2(2000);
  l_DataInicioTabelas DATE;
  l_VarDateAux DATE;
  l_DataInicioNaoPeriodicos DATE;
  l_DataInicioPeriodicos DATE;
  l_DataInicioSST DATE;
  l_infoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
  l_DataInicioMigracao DATE;
BEGIN
  l_Valor := '';
  l_infoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;

  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);

  SP_CONCATENAR_NUM('FILEMP', :NEW.FILEMP, l_Valor OUT);
  SP_CONCATENAR_NUM('CPFTRA', :NEW.CPFTRA, l_Valor OUT);
  SP_CONCATENAR_DES('NOMFUN', :NEW.NOMFUN, l_Valor OUT);
  SP_CONCATENAR_DAT('DATADM', :NEW.DATADM, l_Valor OUT);
  
  IF (l_SimplificaoESocial = FALSE) THEN
	  RH_DEF_ESOCIAL(:NEW.NUMEMP, l_DataInicioTabelas OUT, l_VarDateAux OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
	  IF ((l_DataInicioNaoPeriodicos <> DATETIME(31, 12, 1900, 0, 0, 0)) AND (l_DataInicioNaoPeriodicos <= :NEW.DATADM)) THEN
	  	SP_E_SOCIAL('S-2190', 'R034PRE', 'N', 'I', NULL, NULL, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, :NEW.DATADM, 0, 'R034PRE_AI');
	  END IF;
  END IF;
END␀ÉÓ␀␀		SENIOR;0␀␀

TRIGGER R034PRE_AD AFTER DELETE ON R034PRE FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
  l_DataInicioTabelas DATE;
  l_VarDateAux DATE;
  l_DataInicioNaoPeriodicos DATE;
  l_DataInicioPeriodicos DATE;
  l_DataInicioSST DATE;
  l_DataInicioMigracao DATE;
BEGIN
  l_Valor := '';
  
  SP_CONCATENAR_NUM('FILEMP', :OLD.FILEMP, l_Valor OUT);
  SP_CONCATENAR_NUM('CPFTRA', :OLD.CPFTRA, l_Valor OUT);
  SP_CONCATENAR_DES('LAYOUT', 'S-2190', l_Valor OUT);
  SP_CONCATENAR_DES('NOMFUN', :OLD.NOMFUN, l_Valor OUT);
  SP_CONCATENAR_DAT('DATADM', :OLD.DATADM, l_Valor OUT);
  
  RH_DEF_ESOCIAL(:OLD.NUMEMP, l_DataInicioTabelas OUT, l_VarDateAux OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
  IF ((l_DataInicioNaoPeriodicos <> DATETIME(31, 12, 1900, 0, 0, 0)) AND (l_DataInicioNaoPeriodicos <= :OLD.DATADM)) THEN
	SP_E_SOCIAL('S-3000', 'R034PRE', 'N', 'E', NULL, NULL, :OLD.NUMEMP, 0, 0, l_Valor, '', 0, NULL, :OLD.DATADM, 0, 'R034PRE_AD');
  END IF;
END␀␀␀åï␀␀␀␀␀␀␀␀␀ËÓ␀␀…¬␀␀´␀	Ôï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôï!␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôï!␀␀␀␀␀.%0.0.w␀Æÿ␀␀…Ó␀␀␀úDÑ␀	Ôï!␀␀␀␀␀GIşEşEqC␀êÿ␀␀ÿ␀Ù1=Ôï!␀␀␀␀␀6€6€6c␀␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3ÍÓ␀␀		SENIOR;0°␀␀/* INSERT (NEW) */
TRIGGER R034PRJ_EI AFTER INSERT ON R034PRJ FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN
  /* Geração de logs Projetos Colaborador (Tabela: R034PRJ)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 94;     /* Projetos Colaborador (Tabela: R034PRJ)*/
  l_codtpa := 302;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034PRJ_AI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATHIS, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATHIS', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034PRJ_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONPRJ', :NEW.CONPRJ);
      END;
  END IF; 
END␀ÎÓ␀␀		SENIOR;0Š␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R034PRJ_EU AFTER UPDATE ON R034PRJ FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN
  /* Geração de logs Projetos Colaborador (Tabela: R034PRJ)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 94;     /* Projetos Colaborador (Tabela: R034PRJ)*/
  l_codtpa := 303;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatHis <> :NEW.DatHis)
   OR (:OLD.ConPrj <> :NEW.ConPrj)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034PRJ_AU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATHIS, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATHIS', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034PRJ_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONPRJ', :OLD.CONPRJ);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONPRJ', :NEW.CONPRJ);
      END;
    END IF; 
  END IF; 
END␀ÌÓ␀␀		SENIOR;0µ␀␀ 

