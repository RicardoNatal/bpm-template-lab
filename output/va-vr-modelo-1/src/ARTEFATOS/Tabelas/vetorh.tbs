o
␀␀CREATE OR REPLACE PROCEDURE SP_CODLOCALIZADOR(p_codigo NUMBER,
                                              p_StrRet OUT VARCHAR) IS
  str               varchar2(10);
  straux            varchar2(10);
  digito            integer;
  indice            integer;
  campo             integer;
  offSET            integer;
  temp              integer;
  magic_index       int;
  magic             varchar2(10);
  result            varchar2(10);
  val               NUMBER(10);
  answer            varchar2(10);
  alldigits         varchar2(36);
  reversed_base_val varchar(100);
  weight            varchar2(30);
  i                 integer;
  soma              integer;
  remainder         integer;
BEGIN
  alldigits := '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  SP_INTSTR(p_codigo, '99999999', str);

  straux := '';
  FOR i IN REVERSE 1..LENGTH(str) LOOP
    straux := straux || substr(str, i, 1);
  END LOOP;
  str := straux; /* reverse(str); */

  weight            := '234567234567234567234567';
  reversed_base_val := str;
  i                 := 1;
  soma              := 0;

  WHILE (i <= LENGTH(reversed_base_val)) LOOP
    /* Calculate product and accumulate. */
    soma := soma + (CAST(SUBSTR(reversed_base_val, i, 1) AS INTEGER) *
            CAST(SUBSTR(weight, i, 1) AS INTEGER));
    i    := i + 1;
  END LOOP;

  /* Determine check digit, and concatenate to base value. */
  remainder := soma mod 11;
  IF (remainder = 0) OR (remainder = 1) THEN
    digito := '0';
  ELSE
    digito := CAST(11 - remainder AS varchar2);
  END IF;
  /*digito := CASE remainder WHEN 0 THEN '0' WHEN 1 THEN '0' ELSE CASE(11 - remainder AS varchar2) END;*/

  magic := '9182730645';

  result      := ' ';
  magic_index := digito + 1;
  indice      := 1;
  WHILE indice < 9 LOOP
    campo       := substr(str, indice, 1);
    offSET      := cast(substr(magic, magic_index, 1) as Integer);
    temp        := campo + offset;
    temp := case
              when temp > 9 then
               temp - 10
              else
               temp
            end;
    result      := result || CAST(temp as varchar2);
    magic_index := case
                     when magic_index = 10 then
                      1
                     else
                      magic_index + 1
                   end;
    indice      := indice + 1;
  END LOOP;
  result := result || CAST(digito as varchar);

  val    := cast(result as NUMBER);
  answer := '';

  WHILE val > 0 LOOP
    answer := substr(alldigits, val mod 36 + 1, 1) || answer;
    val    := trunc(val / 36);
  END LOOP;

  p_StrRet := answer;
END;


		ORACLE;22SP_INTSTR
