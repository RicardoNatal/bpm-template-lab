DECLARE
l_Straux             VARCHAR2(2047);
   l_gersen             BOOLEAN;
   l_data_atual         DATE;
   l_hora_atual         NUMBER(4);
   l_seqenv             NUMBER(2);
   l_datstr             CHAR(6);
   l_horstr             CHAR(4);
   l_seqstr             CHAR(2);
   l_datenv             CHAR(16);
BEGIN
  /* Envia pendência para Digicon */
  SP_GERSEN(l_gersen OUT);
  IF  (l_gersen = TRUE) THEN
      /* Monta data/hora de envio da pendência.*/
      l_data_atual := CURDATE();
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
      SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
      l_seqenv := SECOND(CURTIME());
      SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
      l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

      l_StrAux := '66'||l_datenv;
      SP_PorCom(l_StrAux, '0');
  END IF;
END␀µ×␀␀		SENIOR;0È␀␀

