      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCAR', CONVERT(NUMBER_TO_CHAR, :OLD.ESTCAR));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAR', :OLD.CODCAR);
      SP_DATSTR(:OLD.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATTER', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSRMJ', :OLD.OBSRMJ);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESMOT', :OLD.DESMOT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR, :OLD.CODATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONPPP', :OLD.CONPPP);      
    END;
  END IF;
END␀␀␀¾m␀␀␀␀␀␀␀␀␀␀␀␀␀gß␀␀…¬␀␀´␀	€␀␀␀␀␀␀G;XbXbr␀Æÿ␀␀Ò␀␀␀–,Ì␀	€␀␀␀␀␀␀=§m¹m”)␀␀Æÿ␀␀>ß␀␀␀EÑ␀	€␀␀␀␀␀␀9NZ”␀␀£GqC␀êÿ␀␀iß␀␀␀£-¼␀	€␀␀␀␀␀␀?Q␀Q␀vM‡␀Æÿ␀␀¬ß␀␀␀µEÑ␀€␀␀␀␀␀␀‡N6␀ÉHqC␀êÿ␀␀ÿ␀Ù³␀␀d€␀␀␀␀␀␀˜´␀␀ñ³␀␀ñ³␀␀C␀␀ÿ␀␀ÿ␀)-±␀€␀␀␀␀␀␀Aùº␀␀ùº␀␀q␀Æÿ␀␀ºŞ␀␀␀^DÑ␀€␀␀␀␀␀␀ŒMø+␀ù+␀qC␀êÿ␀␀ÿ␀P,­␀€␀␀␀␀␀␀?´6´6pM‡␀Æÿ␀␀1ß␀␀␀¼¦␀␀­␀€␀␀␀␀␀␀SB±®␀␀±®␀␀p␀Æÿ␀␀¡ß␀␀␀␀␀␀0;1;2;3nß␀␀	SENIOR;0›
␀␀TRIGGER R110HSN_SI AFTER INSERT ON R110HSN

DECLARE
l_data_zero   DATE;
  l_data_atual  DATE;
  l_TemSub        R110FIC.TEMSUB%TYPE;
  l_TemSubAtual   R110FIC.TEMSUB%TYPE;
  l_NumEmp        R110FIC.NUMEMP%TYPE;
  l_CodFic        R110FIC.CODFIC%TYPE;

  /* CURSOR c/ os registros gravados no R110HSN_AUX */
  CURSOR c_R110HSN_AUX IS
    SELECT NUMEMP,CODFIC,DATINI,DATTER FROM R110HSN_AUX;

  CURSOR c_R110HSN IS
    SELECT NUMEMP,CODFIC,DATINI,DATTER FROM R110HSN WHERE NUMEMP = l_NumEmp AND CODFIC = l_CodFic;

  TYPE t_R110HSN IS RECORD(
    NUMEMP   R110HSN.NUMEMP%TYPE,
    CODFIC   R110HSN.CODFIC%TYPE,
    DATINI   R110HSN.DATINI%TYPE,
    CODSUN   R110HSN.CODSUN%TYPE,
    DATTER   R110HSN.DATTER%TYPE,
    CODPAR   R110HSN.CODPAR%TYPE,
    DATACO   R110HSN.DATACO%TYPE,
    CODCON   R110HSN.CODCON%TYPE,
    NIVATE   R110HSN.NIVATE%TYPE);

  l_R110HSN t_R110HSN;
  l_R110HSN_AUX t_R110HSN;
BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();

  /* Le Registro do CURSOR */
  FOREACH c_R110HSN_AUX INTO l_R110HSN_AUX.NUMEMP,
                             l_R110HSN_AUX.CODFIC,
                             l_R110HSN_AUX.DATINI,
                             l_R110HSN_AUX.DATTER
  LOOP
    l_NumEmp := l_R110HSN_AUX.NUMEMP;
    l_CodFic := l_R110HSN_AUX.CODFIC;
    l_TemSub := 'N';

    FOREACH c_R110HSN INTO l_R110HSN.NUMEMP,
                           l_R110HSN.CODFIC,
                           l_R110HSN.DATINI,
                           l_R110HSN.DATTER
    LOOP
      /* Verifica se tem alguma subnormalidade válida na data atual. */
      IF (l_R110HSN.DATINI <= l_data_atual) AND ((l_R110HSN.DATTER >= l_data_atual) OR (l_R110HSN.DATTER = l_data_zero)) THEN
        l_TemSub := 'S';
      END IF;
    END LOOP;

    /* Lê o conteúdo atual do campo R110FIC.TemSub */
    BEGIN
      SELECT TEMSUB INTO l_TemSubAtual FROM R110FIC WHERE NUMEMP = l_R110HSN_AUX.NUMEMP AND CODFIC = l_R110HSN_AUX.CODFIC;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_TemSubAtual := ' ';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler campo TemSub da R110FIC.';
    END;

    IF (l_TemSub <> l_TemSubAtual) THEN
      /* Atualiza campo R110FIC.TemSub - Indica se possui ou não subnormalidade */
      BEGIN
        UPDATE R110FIC SET TEMSUB = l_TemSub WHERE NUMEMP = l_R110HSN_AUX.NUMEMP AND CODFIC = l_R110HSN_AUX.CODFIC;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao atualizar o campo TemSub na tabela R110FIC.';
      END;
    END IF;
  END LOOP;

  /* Apaga Registro OLD em R110HSN_AUX */
  BEGIN
    DELETE FROM R110HSN_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀kß␀␀		SENIOR;0d
␀␀

TRIGGER R110HSN_EI AFTER INSERT ON R110HSN FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
/* Insere os registros da tabela AUX */
  BEGIN
    INSERT INTO R110HSN_AUX (NUMEMP,CODFIC,DATINI,CODSUN,DATTER,CODPAR,DATACO,CODCON,NIVATE)
                     VALUES (:NEW.NUMEMP,:NEW.CODFIC,:NEW.DATINI,:NEW.CODSUN,:NEW.DATTER,:NEW.CODPAR,:NEW.DATACO,:NEW.CODCON,:NEW.NIVATE);
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro no INSERT em R110HSN_AUX.';
  END;
  
  l_codSistema := 1;
  l_codcpa := 129;  /* Código da categoria de auditoria - Histórico de Subnormalidades*/
  l_codtpa := 389;  /* Código do tipo de auditoria - Inclusão*/

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110HSN_EI', '');

    /* Insere os campos chave na tabela de auditoria R995PRC*/
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIC));
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', CONVERT(DATE_TO_CHAR, :NEW.DATINI));
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSUN', CONVERT(NUMBER_TO_CHAR, :NEW.CODSUN));
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110HSN_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    /* Insere os valores dos campos na tabela de auditoria R995PRT*/
    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
      SP_DATSTR(:NEW.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATTER', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSSUN', :NEW.OBSSUN);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPAR', CONVERT(NUMBER_TO_CHAR, :NEW.CODPAR));
      SP_DATSTR(:NEW.DATACO, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATACO', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCON', CONVERT(NUMBER_TO_CHAR, :NEW.CODCON));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NIVATE', CONVERT(NUMBER_TO_CHAR, :NEW.NIVATE));
    END;
  END IF;
END␀oß␀␀	SENIOR;0Ÿ
