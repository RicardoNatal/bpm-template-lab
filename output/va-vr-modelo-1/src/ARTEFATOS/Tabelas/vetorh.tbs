¡␀␀PROCEDURE RH_LAYOUTCOLAB(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_LAYOUT OUT VARCHAR2(10))
 IS

  l_DataZero DATE;
BEGIN
     l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
     BEGIN
         SELECT (LAYORI)
         INTO p_layout
         FROM R034MAT 
         WHERE NUMEMP = p_numemp AND
              TIPCOL = p_tipcol AND
              NUMCAD = p_numcad AND
			  (ADMFEC = 'S' OR DATSST <> l_DataZero OR STAMIG = 2);
     EXCEPTION
          WHEN NO_DATA_FOUND THEN
               p_layout := NULL;
     END;
	 
	 IF (p_layout IS NOT NULL AND LTRIM(RTRIM(p_layout)) || 'VAZIO' = 'VAZIO') THEN
		p_layout := NULL;
	 END IF;	
END␀ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
„␀␀PROCEDURE RH_LAYOUT_ALT_CAD(P_LAYOUT VARCHAR2(6),P_LAYOUTOUT OUT VARCHAR2(6))
 IS

l_layoutOut VARCHAR2(6);
BEGIN
  l_layoutOut := NULL;
  
  IF (p_layout = 'S-2200') OR (p_layout = 'S-2300') OR (p_layout = 'S-2298') THEN  
	l_layoutOut := 'S-2205';
  END IF;
  
  IF (p_layout = 'S-2400') THEN
    l_layoutOut := 'S-2405';
  END IF;  	
 
  p_layoutOut := l_layoutOut;
END␀€ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
x␀␀PROCEDURE RH_LAYOUT_ALT_CONT(P_LAYOUT VARCHAR2(6),P_LAYOUTOUT OUT VARCHAR2(6))
 IS

l_layoutOut VARCHAR2(6);
BEGIN
  l_layoutOut := NULL;
  
  IF (p_layout = 'S-2300') THEN  
	l_layoutOut := 'S-2306';
  END IF;
  
  IF (p_layout = 'S-2200') THEN
    l_layoutOut := 'S-2206';
  END IF;  	
 
  p_layoutOut := l_layoutOut; /*Leiaute S-2400 vai retornar NULL*/
END␀ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Ä␀␀PROCEDURE RH_LAYOUT_ENVIADO(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_LAYOUT VARCHAR2(10), P_ENVIADO OUT VARCHAR2(10))
 IS
BEGIN
  BEGIN	               
    SELECT DISTINCT(LAYOUT)
    INTO P_ENVIADO
    FROM R350STA
    WHERE NUMEMP = p_numemp AND
          TIPCOL = p_tipcol AND
          NUMCAD = p_numcad AND
          LAYOUT = p_layout AND              
      	  LENGTH(LTRIM(NUMREC)) > 0 AND
 		  NUMREC IS NOT NULL;
     	
  EXCEPTION WHEN NO_DATA_FOUND THEN
    P_ENVIADO := NULL;
  END;
   
  IF (P_ENVIADO IS NOT NULL) THEN  	 
    IF (P_ENVIADO = 'S-2300') THEN
    	P_ENVIADO := 'S-2306';		
	ELSE
	   P_ENVIADO := 'S-2206';
	END IF;		  	 	
  END IF; 
END␀‚ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0$RH_LAYOUTCOLAB
RH_LAYOUT_ALT_CONT
g␀␀PROCEDURE RH_LAY_CONTR_COLAB(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_LAYOUT OUT VARCHAR2(6))
 IS

l_layoutInicial VARCHAR(6);
  l_layoutAlteracao VARCHAR(6);
BEGIN
  RH_LAYOUTCOLAB(p_numemp, p_tipcol, p_numcad, l_layoutInicial OUT);
  RH_LAYOUT_ALT_CONT(l_layoutInicial, l_layoutAlteracao OUT);
  p_layout := l_layoutAlteracao;
END␀ƒì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
,␀␀PROCEDURE RH_LOCNIVPRA(ATABORG NUMBER(4),ANUMLOC NUMBER(9),ADATALT DATE,ANUMLOCNIV OUT NUMBER(9))
 IS

xMsg VARCHAR2(255);
  xNivPra   R016ORE.NIVPRA%TYPE;
  xPosLoc   R016HIE.POSLOC%TYPE;
  xCodLoc   R016HIE.CODLOC%TYPE;
  xPosLocNiv   R016HIE.POSLOC%TYPE;
  xQtdPos NUMBER(2);
BEGIN
  /* Busca o nível do PPRA/PCMSO no Organograma */
  BEGIN
    SELECT NIVPRA INTO xNivPra FROM R016ORE WHERE TABORG = aTabOrg;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      xNivPra := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na busca do Nível de controle do PPRA/PCMSO no Organograma.';
  END;

  /* Se tiver um Nível cadastrado, pega o Local deste Nível */
  IF (xNivPra <> 0) THEN
    /* Acha o nível do local */
    BEGIN
      SELECT POSLOC, CODLOC INTO xPosLoc, xCodLoc FROM R016HIE
       WHERE TABORG = aTabOrg AND NUMLOC = aNumLoc AND DATINI <= aDatAlt AND DATFIM >= aDatAlt;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        xPosLoc := ' ';
        xCodLoc := ' ';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao buscar o Nível do Local.';
    END;

    /* Busca o Local do Nível */
    IF (LENGTH(xPosLoc) >= (xNivPra * 2)) THEN
      xQtdPos := (xNivPra * 2);
      xPosLocNiv := SUBSTRING(xPosLoc, 1, xQtdPos);
      BEGIN
        SELECT NUMLOC INTO aNumLocNiv FROM R016HIE
         WHERE TABORG = aTabOrg AND POSLOC = xPosLocNiv AND DATINI <= aDatAlt AND DATFIM >= aDatAlt;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          xPosLoc := ' ';
          xCodLoc := ' ';
        WHEN OTHERS THEN
          RAISERROR 103 'Não existe um Local para o Nível cadastrado para o controle do PPRA/PCMSO.';
      END;
    ELSE
      xMsg := 'O Local ' || xCodLoc ||
              ' não está de acordo com o Nível do PPRA/PCMSO da Estrutura de Organograma. Altere o Local ou o Nível de controle do PPRA/PCMSO! Nível atual: ' ||
              CONVERT(NUMBER_TO_CHAR,xNivPra);
      RAISERROR 103 xMsg;
    END IF;
  ELSE
    /* Se não tiver um Nível cadastrado, retorna o mesmo Local */
    aNumLocNiv := aNumLoc;
  END IF;
END␀„ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_TRCINT

␀␀PROCEDURE RH_MODINT(P_NUMINT INTEGER,P_NUMDIV INTEGER,P_NUMRET OUT NUMBER)
 IS

  l_numint  NUMBER(12,5);
  l_numtrc  NUMBER;

BEGIN
  l_numint := p_numint / p_numdiv;
  RH_TRCINT(l_numint, l_numtrc OUT);
  p_numret := p_numint - (p_numdiv * l_numtrc);
END␀…ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ó␀␀/*-------------------------------- R034MAT -------------------------------*/
PROCEDURE RH_NUMMAT(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_ADMFECHADA_FOLHA OUT BOOLEAN, P_ADMFECHADA_SST OUT BOOLEAN, P_DATAFEC_TRE OUT DATE)
 IS

  l_count NUMBER;
  l_AdmissaoFechadaFolha VARCHAR2(1);
  l_AdmissaoFechadaSST DATE;
  l_DataFechamentoTreinamento DATE;
  l_DataZero DATE;
BEGIN
     l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
     P_ADMFECHADA_FOLHA := FALSE;
     P_ADMFECHADA_SST := FALSE;
     P_DATAFEC_TRE := l_DataZero;
     BEGIN
         SELECT ADMFEC, DATSST, DATTRE INTO l_AdmissaoFechadaFolha, l_AdmissaoFechadaSST, l_DataFechamentoTreinamento
           FROM R034MAT
           WHERE NUMEMP = p_numemp 
             AND TIPCOL = p_tipcol 
             AND NUMCAD = p_numcad; 
	EXCEPTION 
		WHEN NO_DATA_FOUND THEN
			l_AdmissaoFechadaFolha := 'N';
			l_AdmissaoFechadaSST := DATETIME(31, 12, 1900, 0, 0, 0);
			l_DataFechamentoTreinamento := DATETIME(31, 12, 1900, 0, 0, 0);
	END;
     
	IF (l_AdmissaoFechadaFolha = 'S') THEN
		P_ADMFECHADA_FOLHA := TRUE;
	END IF;
	
	IF (l_AdmissaoFechadaSST > l_DataZero) THEN
		P_ADMFECHADA_SST := TRUE;
	END IF;
	
	P_DATAFEC_TRE := l_DataFechamentoTreinamento;
END␀†ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0±RH_LAYOUT_ALT_CONT
SP_PROXHIST_NPER
SP_CONCATENAR_NUM
SP_TAB_ESOCIAL
