ğ␀␀PROCEDURE R057DIB_ATUBEN(P_TIPOPE CHAR,P_CRACHA NUMBER,P_CRAAUX NUMBER,P_CODBNF INTEGER,P_QTDENB INTEGER)
 IS

  l_comando_nulo BOOLEAN;
  l_crastr       CHAR(12);
  l_craaux       CHAR(12);
  l_codbnf       VARCHAR2(2);
  l_strerr       VARCHAR2(255);
  l_creditos     VARCHAR2(2);
  l_qtdenb       NUMBER(2);
  l_qtdstr       VARCHAR2(2);
  l_numser       VARCHAR(12);
  l_icardR    	 VARCHAR(12);

BEGIN
  /* Atualiza Controle */
  SP_INTSTR(p_codbnf,'99',l_codbnf OUT);
  SP_RETICARD(NULL, p_cracha, l_crastr OUT , l_icardR OUT, l_numser OUT);
  SP_RETICARD(NULL, p_craaux, l_craaux OUT , l_icardR OUT, l_numser OUT);

  l_comando_nulo := FALSE;
  IF  (p_tipope = 'U') THEN
      BEGIN
          ExecSql9('SELECT CREDITOS FROM LBENEF'||l_codbnf||' WHERE ICARD = '''||l_craaux||'''', l_creditos);
      EXCEPTION
          WHEN NO_DATA_FOUND THEN l_comando_nulo := TRUE;
          WHEN OTHERS THEN l_strerr := 'ON-Line 1: Erro No SELECT LBENEF'||l_codbnf;
                           RAISERROR 103 l_strerr;
      END;
      /* exclui registros do crachá titular se houver */
      BEGIN
          ExecSql('DELETE FROM LBENEF'||l_codbnf||' WHERE ICARD = '''||l_crastr||'''');
      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;
  ELSE
      BEGIN
          ExecSql9('SELECT CREDITOS FROM LBENEF'||l_codbnf||' WHERE ICARD = '''||l_crastr||'''', l_creditos);
      EXCEPTION
          WHEN NO_DATA_FOUND THEN l_comando_nulo := TRUE;
          WHEN OTHERS THEN l_strerr := 'ON-Line 1: Erro No SELECT LBENEF'||l_codbnf;
                           RAISERROR 103 l_strerr;
      END;
      /* exclui registros do crachá provisório se houver */
      BEGIN
          ExecSql('DELETE FROM LBENEF'||l_codbnf||' WHERE ICARD = '''||l_craaux||'''');
      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;
  END IF;

  /* se encontrou registro */
  IF   (l_comando_nulo = FALSE) THEN
        l_qtdenb := CONVERT(CHAR_TO_NUMBER,l_creditos);
        IF    (p_tipope = 'I') THEN
              l_qtdenb := l_qtdenb + p_qtdenb;  /* se for inclusão soma credito */
        ELSIF (p_tipope = 'E') THEN
              l_qtdenb := l_qtdenb - p_qtdenb;  /* se for exclusão diminui credito */
        ELSE  l_qtdenb := p_qtdenb;  /* se for reset inicializa creditos. */
        END IF;
        SP_INTSTR(l_qtdenb,'99',l_qtdstr OUT);

        IF  (p_tipope = 'U') THEN
            BEGIN
                EXECSQL('UPDATE LBENEF'||l_codbnf||' SET ICARD = '''||l_crastr||''' WHERE ICARD = '''||l_craaux||'''');
            EXCEPTION
                WHEN OTHERS THEN l_strerr := 'ON-Line 2: Erro no UPDATE em LBENEF'||l_codbnf;
                                 RAISERROR 103 l_strerr;
            END;
        ELSE
            BEGIN
                EXECSQL('UPDATE LBENEF'||l_codbnf||' SET CREDITOS = '''||l_qtdstr||''' WHERE ICARD = '''||l_crastr||'''');
            EXCEPTION
                WHEN OTHERS THEN l_strerr := 'ON-Line 3: Erro no UPDATE em LBENEF'||l_codbnf;
                                 RAISERROR 103 l_strerr;
            END;
        END IF;
  ELSE
        /* se não encontrou registro */
        IF   (p_tipope = 'I') OR (p_tipope = 'R')  OR (p_tipope = 'U') THEN /* se for Inclusão ou Reset */
             SP_INTSTR(p_qtdenb,'99',l_qtdstr OUT);
        ELSE
             SP_INTSTR(0,'99',l_qtdstr OUT);  /* se for exclusao e nao existe registro zera o credito. */
        END IF;

        IF  (l_qtdstr > 0) THEN
            /* limpa a tabela lbenef no caso de já haver o crachá */
            BEGIN
                ExecSql('DELETE FROM LBENEF'||l_codbnf||' WHERE ICARD = '''||l_crastr||'''');
            EXCEPTION
                WHEN OTHERS THEN NULL;
            END;
            BEGIN
                EXECSQL('INSERT INTO LBENEF'||l_codbnf||' (ICARD,CREDITOS) '||' VALUES ('''||l_crastr||''','''||l_qtdstr||''')');
            EXCEPTION
                WHEN OTHERS THEN l_strerr := 'ON-Line 4: Erro no INSERT em LBENEF'||l_codbnf;
                                 RAISERROR 103 l_strerr;
            END;
        END IF;
  END IF;
  /* limpa os crachás que estão com quantidade zerados */
  BEGIN
      ExecSql('DELETE FROM LBENEF'||l_codbnf||' WHERE CREDITOS = 0');
  EXCEPTION
      WHEN OTHERS THEN NULL;
  END;
END␀Q×␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
šPROCEDURE R057DIB_CRABEN(P_TIPOPE CHAR,P_NUMEMP NUMBER(4),P_TIPCOL INTEGER,P_NUMCAD NUMBER(9),P_CODBNF INTEGER,P_QTDENB INTEGER)
 IS
BEGIN
  NULL;
END		SENIOR;20)sp_VerOnLine
