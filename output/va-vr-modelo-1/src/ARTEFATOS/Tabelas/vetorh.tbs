öPROCEDURE SP_INITEMPTY_DAT(P_DATE IN OUT DATE)
IS

	l_IsEmpty BOOLEAN;
BEGIN
	SP_ISEMPTY_DAT(P_DATE, l_IsEmpty OUT);
	IF (l_IsEmpty = TRUE OR P_DATE = DATETIME(04, 06, 2080, 0, 0, 0)) THEN
		P_DATE := DATETIME(31, 12, 1900, 0, 0, 0);
	END IF;
END␀Wø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
‡B␀␀PROCEDURE SP_INSTRUTORES (P_NUMEMP NUMBER(4), P_TIPCOL NUMBER(1), P_NUMCAD NUMBER(9), P_CODCUA NUMBER(9),
	P_TMACUA NUMBER(6), P_SEQHCR NUMBER(4), P_OLDNUMEMP NUMBER(4), P_OLDTIPCOL NUMBER(1), P_OLDNUMCAD NUMBER(9),
	P_OPERACAO CHAR(1)) IS

	l_InsCua NUMBER(1);
	l_NroHis NUMBER(5);
	l_TipPro NUMBER(1);
	l_IndNac NUMBER(5);
	l_NumEmp NUMBER(4);
	l_TipCol NUMBER(1);
	l_NumCad NUMBER(9);
	l_CodCua NUMBER(9);
	l_SeqHcr NUMBER(4);
	l_NroIns NUMBER(4);
	l_NumCpf NUMBER(11);

	TYPE t_campos_aux IS RECORD (
		SEQHCR   R124PCR.SEQHCR%TYPE,
		CPFPRO   R124PCR.CPFPRO%TYPE,
		NOMPRO   R124PCR.NOMPRO%TYPE,
		FORPRO   R124PCR.FORPRO%TYPE,
		CODCBO   R124PCR.CODCBO%TYPE,
		INDNAC   R034FUN.CODNAC%TYPE
	);

   l_campos_aux t_campos_aux;

	TYPE t_r134ins_aux IS RECORD (
		NUMEMP   R134INS_AUX.NUMEMP%TYPE,
		TIPCOL   R134INS_AUX.TIPCOL%TYPE,
		NUMCAD   R134INS_AUX.NUMCAD%TYPE,
		CODCUA   R134INS_AUX.CODCUA%TYPE,
		TMACUA   R134INS_AUX.TMACUA%TYPE,
		OBSINS   R134INS_AUX.OBSINS%TYPE,
		TIPINS   R134INS_AUX.TIPINS%TYPE
	);

	l_r134ins_aux t_r134ins_aux;

	TYPE t_r134inp_aux IS RECORD (
		CODCUA   R134INP_AUX.CODCUA%TYPE,
		TMACUA   R134INP_AUX.TMACUA%TYPE,
		CODPES   R134INP_AUX.CODPES%TYPE,
		OBSINS   R134INP_AUX.OBSINS%TYPE,
		TIPINS   R134INP_AUX.TIPINS%TYPE
	);

	l_r134inp_aux t_r134inp_aux;

	CURSOR C_R134INS IS
	SELECT
		NUMEMP,
		TIPCOL,
		NUMCAD,
		CODCUA,
		TMACUA,
		OBSINS,
		TIPINS
	FROM
		R134INS
	WHERE
		CODCUA = P_CODCUA AND TMACUA = P_TMACUA;
		
 	CURSOR C_INS IS
	SELECT
		FUN.NUMCPF,
		FUN.NOMFUN,
		FUN.FORPRO,
		FUN.CODCBO,
		FUN.CODNAC
	FROM
		R034FUN FUN
	WHERE
		FUN.NUMEMP = l_r134ins_aux.NumEmp AND FUN.TIPCOL = l_r134ins_aux.TipCol AND FUN.NUMCAD = l_r134ins_aux.NumCad;

	CURSOR C_R124HCR_sel IS
	SELECT
		SEQHCR
	FROM
		R124HCR
	WHERE
		NUMEMP = P_NUMEMP AND TIPCOL = P_TIPCOL AND NUMCAD = P_NUMCAD AND CODCUA = P_CODCUA
	ORDER BY
		SEQHCR;

	CURSOR C_R134INP IS
	SELECT
		CODCUA,
		TMACUA,
		CODPES,
		OBSINS,
		TIPINS
	FROM
		R134INP
	WHERE
		CODCUA = P_CODCUA AND TMACUA = P_TMACUA;
		
	CURSOR C_INP IS
	SELECT DISTINCT
		PES.NUMCPF,
		PES.NOMPES,
		PES.FORPRO,
		PES.CODCBO,
		PES.CODNAC
	FROM
		R033PES PES,
		R034FUN FUN
	WHERE
		PES.CODPES = l_r134inp_aux.CodPes AND FUN.CODPES(+) = PES.CODPES; 

	/* Verifica se tem cadastro na R034FUN com aquele código de pessoa para buscar o TipCol do colaborador que não esteja demitido*/
	/* Como CodPes não é chave na R034FUN podem haver vários registros que utilizem o mesmo cadastro de pessoa, se tiver ao menos um com TipCol = 1 já deve levar TipPro = 1						  */
	CURSOR C_TIPCOL IS
	SELECT
		FUN.NUMCAD,
		FUN.TIPCOL
	FROM
		R034FUN FUN
	WHERE
		FUN.CODPES = l_r134inp_aux.CodPes AND FUN.NUMCPF = l_campos_aux.CPFPRO AND NUMEMP = P_NumEmp AND FUN.TIPCOL = 1 AND NOT EXISTS
		(SELECT
			1
		FROM
			R042RCM RCM
		WHERE
			RCM.NUMEMP = FUN.NUMEMP AND RCM.TIPCOL = FUN.TIPCOL AND RCM.NUMCAD = FUN.NUMCAD)
	ORDER BY
		FUN.NUMCAD;
		
	CURSOR C_REGISTROS_RETIFICAR IS
	SELECT PCR.NUMEMP, PCR.TIPCOL, PCR.NUMCAD, PCR.CODCUA, PCR.SEQHCR FROM R124PCR PCR, R124HCR HCR
	  WHERE HCR.NUMEMP = P_NUMEMP AND HCR.TIPCOL = P_TIPCOL AND HCR.NUMCAD = P_NUMCAD AND HCR.CODCUA = P_CODCUA AND HCR.TMACUA = P_TMACUA
	    AND PCR.NUMEMP = HCR.NUMEMP AND PCR.TIPCOL = HCR.TIPCOL AND PCR.NUMCAD = HCR.NUMCAD AND PCR.CODCUA = HCR.CODCUA AND PCR.SEQHCR = HCR.SEQHCR;
BEGIN
  SELECT
		INSCUA
	INTO
		l_InsCua
	FROM
		R000ASS;


	IF (P_OPERACAO = 'I') THEN
		BEGIN
		    DELETE FROM R124PCR WHERE NUMEMP = P_OLDNUMEMP AND TIPCOL = P_OLDTIPCOL AND NUMCAD = P_OLDNUMCAD AND CODCUA = P_CODCUA AND SEQHCR = P_SEQHCR;
		    
			IF (l_InsCua = 0) THEN
			  	BEGIN				
				    /* Percorre os instrutores gravados no curso*/
					FOREACH C_R134INS INTO l_r134ins_aux.NumEmp, l_r134ins_aux.TipCol, l_r134ins_aux.NumCad, l_r134ins_aux.CodCua,
					l_r134ins_aux.TmaCua, l_r134ins_aux.ObsIns, l_r134ins_aux.TipIns LOOP
						FOREACH C_INS INTO l_campos_aux.CpfPro, l_campos_aux.NomPro, l_campos_aux.ForPro,
						l_campos_aux.CodCbo, l_campos_aux.IndNac LOOP
						/* Verifica se já existe histórico deste curso para este candidato*/
							BEGIN
							  /* IndNac - Levar "1 - Brasileiro" se R033PES.CodNac estiver informado uma nacionalidade referente ao Brasil (R023NAC.PaiRfb = 105). Caso contrário levar 2.*/
							  IF (l_campos_aux.IndNac > 0) THEN
										SELECT
											NAC.PAIRFB
										INTO
											l_campos_aux.IndNac
										FROM
											R023NAC NAC
										WHERE
											NAC.CODNAC = l_campos_aux.IndNac;
								IF (l_campos_aux.IndNac = 105) THEN
								  l_IndNac := 1;
								ELSE
								  l_IndNac := 2;
								END IF;
							  END IF;

							  /* TipPro - Levar 1 se tiver algum colaborador empregado trabalhando vinculado na pessoa, caso contrário 2;*/
							  IF (l_r134ins_aux.TipCol = 1) THEN
								l_TipPro := 1;
							  ELSE
								l_TipPro := 2;
							  END IF;
							  
							  /* Pega a maior sequência de instrutor cadastrada */
						      SELECT MAX(SEQPCR) INTO l_NroIns FROM R124PCR
						          WHERE NUMEMP = P_NUMEMP AND TIPCOL = P_TIPCOL AND NUMCAD = P_NUMCAD
						                AND CODCUA = P_CODCUA AND SEQHCR = P_SEQHCR;
						      
							  IF (l_NroIns IS NULL) OR (l_NroIns = 0) THEN							  
							    l_NroIns := 1;
							  ELSE
							    l_NroIns := l_NroIns + 1;
							  END IF;	

							  /* Os campos chaves na R124PCR devem ser os mesmo da R124HCR.*/
							  /* Portanto o numemp tipcol e numcad é de quem fez o curso (R124HCR) e não do instrutor(R134INS). As informações do instrutor são apenas do CPF em diante.*/
							  INSERT R124PCR(NUMEMP,
											TIPCOL,
											NUMCAD,
											CODCUA,
											SEQHCR,
											SEQPCR,
											CPFPRO,
											NOMPRO,
											TIPPRO,
											FORPRO,
											CODCBO,
											INDNAC)
							  VALUES (P_NUMEMP,
											P_TIPCOL,
											P_NUMCAD,
											P_CODCUA,
											P_SEQHCR,
											l_NroIns,
											l_campos_aux.CpfPro,
											l_campos_aux.NomPro,
											l_TipPro,
											l_campos_aux.ForPro,
											l_campos_aux.CodCbo,
											l_IndNac);
							  EXCEPTION
								WHEN OTHERS THEN
								  RAISERROR 103 'Erro na Inclusão dos Instrutores na R124PCR.';
							  END;
						  END LOOP;
					  END LOOP;
				END;				
			ELSE
				BEGIN
					FOREACH C_R134INP INTO l_R134INP_aux.CodCua, l_R134INP_aux.TmaCua, l_R134INP_aux.CodPes, l_R134INP_aux.ObsIns, l_R134INP_aux.TipIns LOOP
						FOREACH C_INP INTO l_campos_aux.CpfPro, l_campos_aux.NomPro, l_campos_aux.ForPro, l_campos_aux.CodCbo, l_campos_aux.IndNac LOOP
						    /* Verifica se já existe histórico deste curso para este candidato */
							BEGIN
								/* IndNac - Levar "1 - Brasileiro" se R033PES.CodNac estiver informado uma nacionalidade referente ao Brasil (R023NAC.PaiRfb = 105). Caso contrário levar 2.*/
									IF (l_campos_aux.IndNac > 0) THEN
										SELECT
											NAC.PAIRFB
										INTO
											l_IndNac
										FROM
											R023NAC NAC
										WHERE
											NAC.CODNAC = l_campos_aux.IndNac;
											
										IF (l_IndNac = 105) THEN
											l_IndNac := 1;
										ELSE
											l_IndNac := 2;
										END IF;
									END IF;

									l_TipPro := 0;
									/* TipPro - Levar 1 se tiver algum colaborador empregado trabalhando vinculado na pessoa, caso contrário 2;*/
									FOREACH C_TIPCOL INTO l_NumCad, l_TipCol LOOP
										IF (l_TipCol = 1) THEN
											l_TipPro := 1;
										END IF;
									END LOOP;
									
									/* Se não entrou no loop é porque não tem cadastro na R034FUN, então deve levar TipPro = 2*/
						      		IF (l_TipPro <> 1) THEN
						      		    l_TipPro := 2;
						      		END IF;
						      		
						      		/* Pega a maior sequência de instrutor cadastrada */
							        SELECT MAX(SEQPCR) INTO l_NroIns FROM R124PCR
							            WHERE NUMEMP = P_NUMEMP AND TIPCOL = P_TIPCOL AND NUMCAD = P_NUMCAD
							                  AND CODCUA = P_CODCUA AND SEQHCR = P_SEQHCR;
							        
							        IF (l_NroIns IS NULL) OR (l_NroIns = 0) THEN							  
							    		l_NroIns := 1;
							  		ELSE
							    		l_NroIns := l_NroIns + 1;
							  		END IF;	

									/* Os campos chaves na R124PCR devem ser os mesmo da R124HCR.*/
									/* Portanto o numemp tipcol e numcad é de quem fez o curso (R124HCR) e não do instrutor(R134INP). As informações do instrutor são apenas do CPF em diante.*/
									INSERT R124PCR(
											NUMEMP,
											TIPCOL,
											NUMCAD,
											CODCUA,
											SEQHCR,
											SEQPCR,
											CPFPRO,
											NOMPRO,
											TIPPRO,
											FORPRO,
											CODCBO,
											INDNAC)
									VALUES (
											P_NUMEMP,
											P_TIPCOL,
											P_NUMCAD,
											P_CODCUA,
											P_SEQHCR,
											l_NroIns,
											l_campos_aux.CpfPro,
											l_campos_aux.NomPro,
											l_TipPro,
											l_campos_aux.ForPro,
											l_campos_aux.CodCbo,
											l_IndNac);
								EXCEPTION
									WHEN OTHERS THEN
										RAISERROR 103 'Erro na Inclusão dos Instrutores na R124PCR.';
								END;
							END LOOP;
						END LOOP;
					END;
				END IF;
			END;
	ELSE
		IF (P_OPERACAO = 'A') THEN
			BEGIN
			FOREACH C_REGISTROS_RETIFICAR INTO l_NumEmp, l_TipCol, l_NumCad, l_CodCua, l_SeqHcr LOOP
			BEGIN
				IF (l_InsCua = 0) THEN
					BEGIN
						/* Percorre os instrutores gravados no curso*/
						FOREACH C_R134INS INTO l_r134ins_aux.NumEmp, l_r134ins_aux.TipCol, l_r134ins_aux.NumCad, l_r134ins_aux.CodCua,
									l_r134ins_aux.TmaCua, l_r134ins_aux.ObsIns, l_r134ins_aux.TipIns LOOP
							FOREACH C_INS INTO l_campos_aux.CpfPro, l_campos_aux.NomPro, l_campos_aux.ForPro,
							l_campos_aux.CodCbo, l_campos_aux.IndNac LOOP
								    BEGIN
								    /* Os campos chaves na R124PCR devem ser os mesmo da R124HCR.*/
								    /* Portanto o numemp tipcol e numcad é de quem fez o curso (R124HCR) e não do instrutor (R134INS). As informações do instrutor são apenas do CPF em diante.*/
								    /* Se alterou o numemp, tipcol ou numcad do instrutor (R134INS) a única chave da R124PCR que será alterada é o CPFPRO.*/
								    IF ((P_OLDNUMEMP <> P_NUMEMP) OR (P_OLDTIPCOL <> P_TIPCOL) OR (P_OLDNUMCAD <> P_NUMCAD)) THEN
										BEGIN
										    DELETE FROM R124PCR WHERE NUMEMP = P_OLDNUMEMP AND TIPCOL = P_OLDTIPCOL AND NUMCAD = P_OLDNUMCAD AND CODCUA = P_CODCUA AND SEQHCR = P_SEQHCR;
										    
											/* IndNac - Levar "1 - Brasileiro" se R033PES.CodNac estiver informado uma nacionalidade referente ao Brasil (R023NAC.PaiRfb = 105). Caso contrário levar 2.*/
											IF (l_campos_aux.IndNac > 0) THEN
												SELECT NAC.PAIRFB INTO l_campos_aux.IndNac FROM R023NAC NAC WHERE NAC.CODNAC = l_campos_aux.IndNac;
											
												IF (l_campos_aux.IndNac = 105) THEN
													l_IndNac := 1;
												ELSE
												    l_IndNac := 2;
												END IF;
											END IF;

											/* TipPro - Levar 1 se Tipo Colaborador for 1 - Empregado ou 2 se for outro tipo de colaborador;*/
											IF (P_TipCol = 1) THEN
												l_TipPro := 1;
											ELSE
												l_TipPro := 2;
											END IF;
									
											/* Pega a maior sequência de instrutor cadastrada */
							    		    SELECT MAX(SEQPCR) INTO l_NroIns FROM R124PCR
							       		     WHERE NUMEMP = P_NUMEMP AND TIPCOL = P_TIPCOL AND NUMCAD = P_NUMCAD
							         		         AND CODCUA = P_CODCUA AND SEQHCR = P_SEQHCR;
							        
											IF (l_NroIns IS NULL) OR (l_NroIns = 0) THEN							  
							    				l_NroIns := 1;
							  				ELSE
							    				l_NroIns := l_NroIns + 1;
							  				END IF;	

											SELECT NUMCPF INTO l_NumCpf FROM R034FUN WHERE NUMEMP = P_OLDNUMEMP AND TIPCOL = P_OLDTIPCOL AND NUMCAD = P_OLDNUMCAD;

												INSERT R124PCR(
													NUMEMP,
													TIPCOL,
													NUMCAD,
													CODCUA,
													SEQHCR,
													SEQPCR,
													CPFPRO,
													NOMPRO,
													TIPPRO,
													FORPRO,
													CODCBO,
													INDNAC)
												VALUES (
													P_NUMEMP,
													P_TIPCOL,
													P_NUMCAD,
													P_CODCUA,
													l_SeqHcr,
													l_NroIns,
													l_campos_aux.CpfPro,
													l_campos_aux.NomPro,
													l_TipPro,
													l_campos_aux.ForPro,
													l_campos_aux.CodCbo,
													l_IndNac);
										END;
									END IF;
								EXCEPTION
									WHEN OTHERS THEN
										RAISERROR 103 'Erro na Atualização dos Instrutores na R124PCR.';
								END;
							END LOOP;
						END LOOP;
					END;
				ELSE
					BEGIN
						FOREACH C_R134INP INTO l_R134INP_aux.CodCua, l_R134INP_aux.TmaCua, l_R134INP_aux.CodPes, l_R134INP_aux.ObsIns, l_R134INP_aux.TipIns LOOP
							BEGIN
								FOREACH C_INP INTO l_campos_aux.CpfPro, l_campos_aux.NomPro, l_campos_aux.ForPro, l_campos_aux.CodCbo, l_campos_aux.IndNac LOOP
									BEGIN
									   IF ((P_OLDNUMEMP <> P_NUMEMP) OR (P_OLDTIPCOL <> P_TIPCOL) OR (P_OLDNUMCAD <> P_NUMCAD)) THEN
											BEGIN
											    DELETE FROM R124PCR WHERE NUMEMP = P_OLDNUMEMP AND TIPCOL = P_OLDTIPCOL AND NUMCAD = P_OLDNUMCAD AND CODCUA = P_CODCUA AND SEQHCR = P_SEQHCR;
											    
												/* IndNac - Levar "1 - Brasileiro" se R033PES.CodNac estiver informado uma nacionalidade referente ao Brasil (R023NAC.PaiRfb = 105). Caso contrário levar 2.*/
												IF (l_campos_aux.IndNac > 0) THEN
													SELECT NAC.PAIRFB INTO l_IndNac FROM R023NAC NAC WHERE NAC.CODNAC = l_campos_aux.IndNac;
												
													IF (l_IndNac = 105) THEN
														l_IndNac := 1;
													ELSE
														l_IndNac := 2;
													END IF;
												END IF;

												l_TipPro := 0;
												/* TipPro - Levar 1 se tiver algum colaborador empregado trabalhando vinculado na pessoa, caso contrário 2;*/
												FOREACH C_TIPCOL INTO l_NumCad, l_TipCol LOOP
													IF (l_TipCol = 1) THEN
														l_TipPro := 1;
													END IF;
												END LOOP;
										
												/* Se não entrou no loop é porque não tem cadastro na R034FUN, então deve levar TipPro = 2*/
							      				IF (l_TipPro <> 1) THEN
							      				    l_TipPro := 2;
							      				END IF;

												/* Os campos chaves na R124PCR devem ser os mesmo da R124HCR.*/
												/* Portanto o numemp tipcol e numcad é de quem fez o curso (R124HCR) e não do instrutor (R134INP). As informações do instrutor são apenas do CPF em diante.*/
												/* Se alterou o codpes do instrutor (R134INP) a única chave da R124PCR que será alterada é o CPFPRO.*/
												SELECT NUMCPF INTO l_NumCpf FROM R033PES WHERE CODPES = l_R134INP_aux.CodPes;
											
												/* Pega a maior sequência de instrutor cadastrada */
								       			 SELECT MAX(SEQPCR) + 1 INTO l_NroIns FROM R124PCR
								       			     WHERE NUMEMP = P_NUMEMP AND TIPCOL = P_TIPCOL AND NUMCAD = P_NUMCAD
								        	          AND CODCUA = P_CODCUA AND SEQHCR = P_SEQHCR;
								        
								   		    	 IF (l_NroIns IS NULL) OR (l_NroIns = 0) THEN							  
							    					l_NroIns := 1;
							  					 ELSE
							    					l_NroIns := l_NroIns + 1;
							 					 END IF;	

											      /* Os campos chaves na R124PCR devem ser os mesmo da R124HCR.*/
											      /* Portanto o numemp tipcol e numcad é de quem fez o curso (R124HCR) e não do instrutor(R134INP). As informações do instrutor são apenas do CPF em diante.*/
											      INSERT R124PCR(
														NUMEMP,
														TIPCOL,
														NUMCAD,
														CODCUA,
														SEQHCR,
														SEQPCR,
														CPFPRO,
														NOMPRO,
														TIPPRO,
														FORPRO,
														CODCBO,
														INDNAC)
											      VALUES (
														P_NUMEMP,
														P_TIPCOL,
														P_NUMCAD,
														P_CODCUA,
														l_SeqHcr,
														l_NroIns,
														l_campos_aux.CpfPro,
														l_campos_aux.NomPro,
														l_TipPro,
														l_campos_aux.ForPro,
														l_campos_aux.CodCbo,
														l_IndNac);
											     END;
										END IF;
									EXCEPTION
										WHEN OTHERS THEN
											RAISERROR 103 'Erro na Atualização dos Instrutores na R124PCR.';
									END;
								END LOOP;
							END;
						END LOOP;
					END;
				END IF;
			EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'Erro na Atualização dos Instrutores na R124PCR.';
				END;
			END LOOP;
			END;
		ELSE
			IF (P_OPERACAO = 'E') THEN
			  FOREACH C_REGISTROS_RETIFICAR INTO l_NumEmp, l_TipCol, l_NumCad, l_CodCua, l_SeqHcr LOOP
			  BEGIN
				  DELETE FROM R124PCR
				  WHERE
					 NUMEMP = l_NumEmp AND TIPCOL = l_TipCol AND NUMCAD = l_NumCad AND CODCUA = l_CodCua AND SEQHCR = l_SeqHcr;
			  EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'Erro na Atualização dos Instrutores na R124PCR.';
				END;
			  END LOOP;
			END IF;
		END IF;
	END IF;
	RETURN;
END␀Xø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
G␀␀PROCEDURE SP_INS_REG_AUD(p_CodRPA  NUMBER(15), p_CodSys NUMBER, p_CodCpa NUMBER, p_VerCpa NUMBER, p_CodTpa NUMBER, p_VerTpa NUMBER, p_Nome_Trigger VARCHAR(10), p_Nome_Tela VARCHAR(10))
 IS

  l_datAtu       DATE;
  l_horAtu       NUMBER(5);
  l_tipDoc       NUMBER(1);
  l_numDoc       VARCHAR(20);
  l_nomUsu       VARCHAR(40);
  l_codUsu       NUMBER(10);
  l_Mensagem     VARCHAR(1024);
  l_Erro_Banco   VARCHAR(1024);
  l_Version      VARCHAR(20);
  l_NumSec       NUMBER(14);
  l_program      VARCHAR2(100);
  l_machine      VARCHAR2(100);
BEGIN
  /* Geração de log de alterações da ficha básica */
  l_datAtu := CURDATE();
  l_horAtu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_horAtu := l_horAtu * 60;
  SP_GETCODUSU(l_codUsu OUT, l_nomUsu OUT);
  
  l_Mensagem := p_Nome_Trigger || ': Erro ao inserir registros mestre para a tabela de log de auditoria R995RPA. Código:' || CONVERT(NUMBER_TO_CHAR, p_CodRPA) || '.';   
  BEGIN
    INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
	     VALUES (p_CodRPA, p_CodSys, p_CodCpa, p_VerCpa, p_CodTpa, p_VerTpa, l_datatu, l_horatu, p_Nome_Tela, l_codUsu);
	     
	SP_RET_CUR_VERSION(l_Version OUT);
	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (p_CodRPA, 'VERSIS', l_Version);
	
	SP_GETSESSIONID(l_numsec OUT, l_program OUT, l_machine OUT);
	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (p_CodRPA, 'NOMMAQ', l_machine);
  EXCEPTION
    WHEN OTHERS THEN 
      SP_RET_ERROBANCO(l_Erro_Banco OUT);
      l_Mensagem := l_Mensagem || l_Erro_Banco; 
      RAISERROR 103 l_Mensagem; 
  END;
END␀Yø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_TRCINT
RH_MODINT
J	␀␀PROCEDURE SP_INTSTR(P_NUMBER NUMBER(12,0), P_MASC VARCHAR2(12), P_RET OUT VARCHAR2(12))
 IS

 l_horint NUMBER(12,5);
 l_hortrc NUMBER;
 l_tamstr INTEGER;
 l_tammas INTEGER;
 l_minint NUMBER;
 l_numint NUMBER(12,0);
 l_integer INTEGER;
 l_ret    VARCHAR2(12);

BEGIN
  l_ret := '';
  IF p_masc = 'HHMM' THEN

        /* pega as horas da hora e colaca zeros a esquerda se precisar */
        l_integer := p_number;
        l_horint := l_integer / 60;
        RH_TRCINT(l_horint, l_hortrc OUT);
        l_tamstr := LENGTH(CONVERT(NUMBER_TO_CHAR, l_hortrc));
        IF  l_tamstr IS NULL THEN
             l_tamstr := 0;
        END IF;
        l_ret := Repeat('0', 2 - l_tamstr) || CONVERT(NUMBER_TO_CHAR, l_hortrc);

        /* pega os minutos da hora e coloca zeros a esquerda se precisar */
        RH_MODINT(l_integer, 60, l_minint OUT);
        l_tamstr := LENGTH(CONVERT(NUMBER_TO_CHAR, l_minint));
        IF l_tamstr IS NULL THEN
            l_tamstr := 0;
        END IF;
        l_ret := l_ret || REPEAT('0', 2 - l_tamstr) || CONVERT(NUMBER_TO_CHAR, l_minint);

  ELSIF p_masc = 'HH:MM' THEN

        /* pega as horas da hora e colaca zeros a esquerda se precisar */
        l_integer := p_number;
        l_horint := l_integer / 60;
        RH_TRCINT(l_horint, l_hortrc OUT);
        l_tamstr := LENGTH(CONVERT(NUMBER_TO_CHAR, l_hortrc));
        IF l_tamstr IS NULL THEN
            l_tamstr := 0;
        END IF;
        l_ret := REPEAT('0', 2 - l_tamstr) || CONVERT(NUMBER_TO_CHAR, l_hortrc);

        /* pega os minutos da hora e coloca zeros a esquerda se precisar */
        RH_MODINT(l_integer, 60, l_minint OUT);
        l_tamstr := LENGTH(CONVERT(NUMBER_TO_CHAR, l_minint));
        IF l_tamstr IS NULL THEN
            l_tamstr := 0;
        END IF;
        l_ret := l_ret || ':' || Repeat('0', 2 - l_tamstr) || CONVERT(NUMBER_TO_CHAR, l_minint);

  ELSIF (LOCATE('9', p_masc) > 0) THEN

        l_numint := p_number;
        l_tamstr := LENGTH(CONVERT(NUMBER_TO_CHAR, l_numint));
        IF l_tamstr IS NULL THEN
            l_tamstr := 0;
        END IF;
        l_tammas := LENGTH(p_masc);
        IF l_tammas IS NULL THEN
            l_tammas := 0;
        END IF;
        l_ret := REPEAT('0', l_tammas-l_tamstr) || CONVERT(NUMBER_TO_CHAR, l_numint);

  END IF;
  
  p_ret := l_ret;
END␀\ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE SP_InvalidRes(PCODREC NUMBER(9))
 IS

/* variáveis */
 vVarCtl NUMBER(9);

 vExists NUMBER(1);   /* 0 - NÃO EXISTE / 1 - EXISTE */

BEGIN

 BEGIN 
  SELECT VarCtl INTO vVarCtl FROM R930VCV FOR UPDATE;
  vVarCtl := vVarCtl + 1;
  UPDATE R930VCV SET VarCtl = vVarCtl;
   EXCEPTION
          WHEN OTHERS  THEN
          BEGIN
              DELETE FROM  R930VCV;
               INSERT INTO R930VCV (VarCtl) VALUES (-999999999);
              UPDATE R930VRE SET VerRec = -999999999;
               vVarCtl := -999999999;
          END;
   END;

  SELECT count(*) INTO vExists FROM R930VRE WHERE CodRec = PCodRec;
  IF vExists > 0 THEN
    UPDATE R930VRE SET VerRec = vVarCtl WHERE CodRec = PCodRec;
  ELSE
    INSERT INTO R930VRE (CodRec, VerRec) VALUES (PCodRec,  vVarCtl);
  END IF;
END␀Zø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ÈPROCEDURE SP_ISEMPTY_DAT(P_DATE DATE, P_ISEMPTY OUT BOOLEAN)
	IS
BEGIN
	P_ISEMPTY := FALSE;
	IF ((P_DATE IS NULL) OR (P_DATE <= DATETIME(31, 12, 1900, 0, 0, 0))) THEN
		P_ISEMPTY := TRUE;
	END IF;
END␀[ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
