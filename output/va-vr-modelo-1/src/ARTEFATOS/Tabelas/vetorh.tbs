DECLARE
l_online BOOLEAN;
  l_codprm NUMBER(5);
  l_datval DATE;
  l_horval NUMBER;
  l_tipvis NUMBER(3);
  l_bloaut VARCHAR2(1);
  l_tippev NUMBER;
  l_propac VARCHAR2(20);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN
     BEGIN
       SELECT CODPRM,DATVAL,HORVAL,TIPVIS,PROPAC INTO l_codprm,l_datval,l_horval,l_tipvis, l_propac
         FROM R097MOV WHERE DATENT = :NEW.DATENT AND HORENT = :NEW.HORENT AND SEQENT = :NEW.SEQENT;
     EXCEPTION
       WHEN OTHERS THEN
          l_codprm := 0;
          l_tipvis := 0;
     END;

     BEGIN
        SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI WHERE TIPVIS = l_tipvis;
     EXCEPTION WHEN OTHERS THEN
        l_bloaut := 'N';
        l_tippev := 1;
     END;
     IF   l_bloaut =  'S' THEN
          l_bloaut := '1';
     ELSE l_bloaut := '0';
     END IF;
     SP_VISPAC (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,l_propac,l_codprm,:NEW.DATENT,:NEW.HORENT,l_datval,l_horval,l_bloaut,l_tippev,l_tipvis,1,1);
  END IF;
END␀òİ␀␀		SENIOR;0€␀␀

TRIGGER R097VMV_EU AFTER UPDATE ON R097VMV FOR EACH ROW

DECLARE
l_online BOOLEAN;
  l_codprm NUMBER(5);
  l_datval DATE;
  l_data_zero DATE;
  l_horval NUMBER;
  l_tipvis NUMBER(3);
  l_bloaut VARCHAR2(1);
  l_tippev NUMBER;
  l_propac VARCHAR2(20);
BEGIN
  l_data_zero := '31/12/1900,00:00:00';
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
     BEGIN
       SELECT CODPRM,DATVAL,HORVAL,TIPVIS,PROPAC INTO l_codprm,l_datval,l_horval,l_tipvis,l_propac
         FROM R097MOV WHERE DATENT = :NEW.DATENT AND HORENT = :NEW.HORENT AND SEQENT = :NEW.SEQENT;
     EXCEPTION
       WHEN OTHERS THEN
          l_codprm := 0;
          l_tipvis := 0;
     END;

     IF (:NEW.DATSAI <> l_data_zero) THEN
       IF (:NEW.DATSAI <= l_datval) THEN
         l_datval := :NEW.DATSAI;
         IF (:NEW.HORSAI <= l_horval) THEN
           l_horval := :NEW.HORSAI;
         END IF;
       END IF;
     END IF;

     BEGIN
        SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI WHERE TIPVIS = l_tipvis;
     EXCEPTION WHEN OTHERS THEN
        l_bloaut := 'N';
        l_tippev := 1;
     END;
     IF   l_bloaut =  'S' THEN
          l_bloaut := '1';
     ELSE l_bloaut := '0';
     END IF;
     SP_VISPAC (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,l_propac,l_codprm,:NEW.DATENT,:NEW.HORENT,l_datval,l_horval,l_bloaut,l_tippev,l_tipvis,1,1);
  END IF;
END␀ğİ␀␀		SENIOR;0í␀␀

TRIGGER R097VMV_ED AFTER DELETE ON R097VMV FOR EACH ROW

DECLARE
l_online BOOLEAN;
  l_data_zero DATE;
  l_crafis NUMBER(12);
BEGIN
SP_VerOnLine(l_online);
IF   (l_online = TRUE) THEN
     l_data_zero := '31/12/1900,00:00:00';
     /* Apaga Cracha do CONTROLE */
     IF   :OLD.DATSAI = l_data_zero THEN
          /* busca número de crachá fisico caso exista. */
          SP_RETFIS(:OLD.NUMCRA, 0,l_crafis OUT);
          AtuSitCra('1',l_crafis);
     END IF;
END IF;
