¥PROCEDURE SP_PENDADE_DSP(P_TIPOPE CHAR, P_CODDSP NUMBER(9), P_MODRLG NUMBER(4), P_VERPLF NUMBER(3), P_CODPLF NUMBER(7), P_PROORI VARCHAR2(36))
  IS
BEGIN
