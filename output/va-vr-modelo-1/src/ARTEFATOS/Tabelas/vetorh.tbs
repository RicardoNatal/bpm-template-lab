        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWBINSLD', CONVERT(NUMBER_TO_CHAR, :NEW.BINSLD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDBIN13S', CONVERT(NUMBER_TO_CHAR, :OLD.BIN13S));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWBIN13S', CONVERT(NUMBER_TO_CHAR, :NEW.BIN13S));
