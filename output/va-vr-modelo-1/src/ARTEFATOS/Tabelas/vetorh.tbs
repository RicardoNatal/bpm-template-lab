␀␀PROCEDURE SP_HISCON(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_DATMIN OUT DATE)
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_datmin      DATE;          /* data final do contrato */
  l_fimemc      DATE;          /* data final do histórico da empresa contratada */
  l_fimcon      DATE;          /* data final do contrato por colaborador */
  l_codoem      NUMBER;
  l_straux      VARCHAR2(255);
  l_numcon      VARCHAR(16);
BEGIN
  l_data_zero := '31/12/1900,00:00:00';
  l_data_atual:= CURDATE();
  l_datmin    := '31/12/1900,00:00:00';
  l_fimCon    := '31/12/1900,00:00:00';
  l_fimEmc    := '31/12/1900,00:00:00';


  /* verifica a data final do histórico de contrato para Terceiros ou Parceiros. */
  IF  (p_tipcol <> 1) THEN
      BEGIN
          SELECT NUMCON, CODOEM, DATFIM INTO l_numCon, l_codoem, l_fimcon FROM R038HCT
          WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                DATALT = (SELECT MAX(DATALT) FROM R038HCT WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND STAATU <> 0);
      EXCEPTION
          WHEN NO_DATA_FOUND THEN l_fimcon := l_data_zero;
                                  l_codoem := 0;
          WHEN OTHERS THEN l_straux := 'SP_HISCON: Erro no SELECT na tabela R038HCT para o colaborador: '||
                                       ' Num.Emp.: '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                                       ' Tip.Col.: '||CONVERT(NUMBER_TO_CHAR,p_tipcol)||
                                       ' Num.Cad.: '||CONVERT(NUMBER_TO_CHAR,p_numcad);
                           RAISERROR 103 l_straux;
      END;

      IF  (l_fimcon = l_data_zero) THEN
          l_fimcon := '31/12/1900,00:00:00';
      ELSE
          l_datmin := l_fimcon;
      END IF;

      /* Verifica o período do contrato. A data que chegar antes será a data final do terceiro. */
      IF  (l_codoem > 0) THEN
          BEGIN
              SELECT DATFIM INTO l_fimemc FROM R032EMC WHERE NUMCON = l_numCon AND CODOEM = l_codoem;
          EXCEPTION
              WHEN NO_DATA_FOUND THEN l_fimemc := l_data_zero;
              WHEN OTHERS THEN RAISERROR 103 'SP_HISCON: Erro no SELECT na tabela R032EMC para Outra Empresa.';
          END;
          IF  (l_fimemc = l_data_zero) THEN
              l_fimemc := '31/12/1900,00:00:00';
          ELSE
              IF  (l_datmin <> l_data_zero) THEN
                  IF  (l_fimemc < l_datmin) THEN
                      l_datmin := l_fimemc;
                  END IF;
              ELSE
                  l_datmin := l_fimemc;
              END IF;
          END IF;
      END IF;
  END IF;

  IF  (l_datmin = l_data_zero) THEN
      l_datmin := '31/12/1900,00:00:00';
  END IF;

  p_datmin := l_datmin;
END␀Nø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ÈPROCEDURE SP_HISTORICOANT(P_CAMPODATA VARCHAR2(255), P_TABELA VARCHAR2(255), P_WHERE VARCHAR2(255), P_DATAINICIO DATE, P_DATAANTERIOR OUT DATE)
 IS
BEGIN
  P_DATAANTERIOR := '31/12/1900,00:00:00';
END	ORACLE;0
Œ␀␀CREATE OR REPLACE
PROCEDURE SP_HISTORICOANT(
    P_CAMPODATA  IN VARCHAR2,
    P_TABELA     IN VARCHAR2,
    P_WHERE      IN VARCHAR2,
    P_DATAINICIO IN DATE,
    P_DATAANTERIOR OUT DATE )
IS
  PRAGMA AUTONOMOUS_TRANSACTION;
  l_DataAnterior DATE;
  l_Sql VARCHAR2(2000);
BEGIN
  BEGIN
    l_Sql := 'SELECT NVL(MAX('||P_CAMPODATA||'), TO_DATE(''31/12/1900'',''DD/MM/YYYY'')) FROM '||P_TABELA||' WHERE '||P_WHERE||' AND '||p_CampoData||' < :'||p_CampoData;
    EXECUTE IMMEDIATE l_Sql INTO l_DataAnterior USING P_DATAINICIO;
  EXCEPTION
  WHEN OTHERS THEN
    NULL;
  END;

  P_DATAANTERIOR := l_DataAnterior;
END SP_HISTORICOANT;	MSSQL;0
1␀␀CREATE PROCEDURE SP_HISTORICOANT
(
	@p_CampoData VARCHAR(100),
	@p_Tabela VARCHAR(100),
	@p_Where VARCHAR(1800),
	@p_DataInicio DATETIME,
	@p_DataAnterior DATETIME OUTPUT
) AS
BEGIN
DECLARE @l_DataAnterior DATETIME
DECLARE @l_ParmDefinition nvarchar(500)
DECLARE @l_Sql NVARCHAR(2000)  

  SELECT @l_Sql = 'SELECT '+N'@l_DataAnteriorOUT = ISNULL(MAX('+@p_CampoData+'), CONVERT(DATETIME,''31/12/1900'',103)) FROM '+@p_Tabela+' WHERE '+@p_Where+' AND '+@p_CampoData+' < @l_CampoData';  
  SET @l_ParmDefinition = N'@l_CampoData DATETIME, @l_DataAnteriorOUT DATETIME OUTPUT';
  
  EXECUTE sp_executesql @l_Sql, @l_ParmDefinition,
                      @l_CampoData = @p_DataInicio,
                      @l_DataAnteriorOUT = @l_DataAnterior OUTPUT;
  
  SELECT @p_DataAnterior = @l_DataAnterior;
END	POSTGRESQL;0
•␀␀CREATE OR REPLACE PROCEDURE sp_historicoant(
	p_campodata character varying,
	p_tabela character varying,
	p_where character varying,
	p_datainicio timestamp without time zone,
	INOUT p_dataanterior timestamp without time zone)
LANGUAGE 'plpgsql'
AS $BODY$

DECLARE
  l_DataAnterior DATE;
  l_Sql VARCHAR;
BEGIN
  BEGIN
    l_Sql := 'SELECT COALESCE(MAX('||P_CAMPODATA||'), TO_DATE(''31/12/1900'',''DD/MM/YYYY'')) FROM '||P_TABELA||' WHERE '||P_WHERE||' AND '||p_CampoData||' < $1';
    EXECUTE l_Sql USING p_CampoData INTO l_DataAnterior ;
  EXCEPTION
  WHEN OTHERS THEN
    NULL;
  END;

  P_DATAANTERIOR := l_DataAnterior;
END;
$BODY$;␀Oø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0"SP_PROXHIST_NPER
SP_TAB_ESOCIAL
␀␀PROCEDURE SP_HIST_DT_ESOCIAL(P_LAYOUTALTERACAO VARCHAR2(6),P_EMPRESA NUMBER(4),P_TIPOCOLABORADOR NUMBER(1),P_COLABORADOR NUMBER(9),P_DATAHISTORICO DATE,P_TABELAHISTORICO VARCHAR2(7),P_CAMPOHISTORICO VARCHAR2(6),P_ACAO VARCHAR2(1),P_VALORJSON VARCHAR2(2000),P_VALORJSON2 VARCHAR2(2000),P_FILTROSQL VARCHAR2(500), P_PENEXT NUMBER(1), P_ORIGEM VARCHAR2(60))
IS

  l_EmpresaStr VARCHAR(11);
  l_TipColaboradorStr VARCHAR(11);
  l_ColaboradorStr VARCHAR(11);
  l_Where VARCHAR(2000);
  l_ProximaData DATE;
  l_ProximaDataTest DATE;
  l_DataHistorico DATE;  
BEGIN
/* Esta intrução tem como função buscar próximos históricos e disparar uma pendência entre o intervalo de termino do histórico alterado + 1  e o início do próximo histórico - 1 */
  l_ProximaData := '31/12/1900,00:00:00';
  l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, p_Empresa);
  l_TipColaboradorStr := CONVERT(NUMBER_TO_CHAR, p_TipoColaborador);
  l_ColaboradorStr := CONVERT(NUMBER_TO_CHAR, p_Colaborador);

  l_Where := 'NUMEMP = ' || l_EmpresaStr || ' AND TIPCOL = ' || l_TipColaboradorStr || ' AND NUMCAD = ' || l_ColaboradorStr || P_FILTROSQL;
  SP_PROXHIST_NPER(p_CampoHistorico, p_TabelaHistorico, l_Where, p_DataHistorico, l_ProximaData OUT);
  l_DataHistorico := p_DataHistorico + 1;
  l_ProximaDataTest := l_ProximaData  + 1; 
  IF (l_ProximaDataTest <> (p_DataHistorico) ) THEN
    SP_TAB_ESOCIAL(p_LayoutAlteracao, p_Empresa, p_TipoColaborador, p_Colaborador, l_DataHistorico, l_ProximaData, P_TABELAHISTORICO, p_Acao, p_ValorJson, p_ValorJson2, P_PENEXT, P_ORIGEM);
  END IF;	    
END␀Pø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0"SP_PROXHIST_NPER
SP_TAB_ESOCIAL
{␀␀PROCEDURE SP_HIST_ESOCIAL(P_LAYOUTALTERACAO VARCHAR2(6),P_EMPRESA NUMBER(4),P_TIPOCOLABORADOR NUMBER(1),P_COLABORADOR NUMBER(9),P_DATAHISTORICO DATE,P_TABELAHISTORICO VARCHAR2(7),P_CAMPOHISTORICO VARCHAR2(6),P_ACAO VARCHAR2(1),P_VALORJSON VARCHAR2(2000), P_VALORJSON2 VARCHAR2(2000), P_PENEXT NUMBER(1), P_ORIGEM VARCHAR2(60))
 IS

  l_EmpresaStr VARCHAR(11);
  l_TipColaboradorStr VARCHAR(11);
  l_ColaboradorStr VARCHAR(11);
  l_Where VARCHAR(2000);
  l_ProximaData DATE;
BEGIN
  l_ProximaData := '31/12/1900,00:00:00';
  l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, p_Empresa);
  l_TipColaboradorStr := CONVERT(NUMBER_TO_CHAR, p_TipoColaborador);
  l_ColaboradorStr := CONVERT(NUMBER_TO_CHAR, p_Colaborador);

  l_Where := 'NUMEMP = ' || l_EmpresaStr || ' AND TIPCOL = ' || l_TipColaboradorStr || ' AND NUMCAD = ' || l_ColaboradorStr;
  SP_PROXHIST_NPER(p_CampoHistorico, p_TabelaHistorico, l_Where, p_DataHistorico, l_ProximaData OUT);
  
  SP_TAB_ESOCIAL(p_LayoutAlteracao, p_Empresa, p_TipoColaborador, p_Colaborador, p_DataHistorico, l_ProximaData, p_TabelaHistorico, p_Acao, p_ValorJson, p_ValorJson2, P_PENEXT, P_ORIGEM);
END␀Qø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
‘␀␀PROCEDURE SP_HORSTR(P_DATE DATE,P_MASC VARCHAR2(255),P_RET OUT VARCHAR2(255))
 IS

l_tamstr NUMBER(4);
 l_daystr VARCHAR2(2);
 l_monstr VARCHAR2(2);
 l_yeastr VARCHAR2(4);
 l_ret    VARCHAR2(10);

BEGIN
  l_ret:='';

  IF p_masc = 'HH:MM' THEN
    l_daystr := CONVERT(NUMBER_TO_CHAR, HOUR(p_date));
    l_tamstr:=Length(l_daystr);

    IF l_tamstr IS NULL THEN 
      l_tamstr:=0;
    END IF;
    l_ret:=Repeat('0',2-l_tamstr)||l_daystr;

    l_monstr := CONVERT(NUMBER_TO_CHAR, MINUTE(p_date));
    l_tamstr:=Length(l_monstr);
    IF l_tamstr IS NULL THEN 
      l_tamstr:=0;
    END IF;

    l_ret:=l_ret || ':' || Repeat('0',2-l_tamstr) || l_monstr;

    ELSIF p_masc = 'HHMM' THEN
    l_daystr := CONVERT(NUMBER_TO_CHAR, HOUR(p_date));
    l_tamstr:=Length(l_daystr);

    IF l_tamstr IS NULL THEN 
      l_tamstr:=0;
    END IF;
    l_ret:=Repeat('0',2-l_tamstr)||l_daystr;

    l_monstr := CONVERT(NUMBER_TO_CHAR, MINUTE(p_date));
    l_tamstr:=Length(l_monstr);
    IF l_tamstr IS NULL THEN 
      l_tamstr:=0;
    END IF;

    l_ret:=l_ret || Repeat('0',2-l_tamstr) || l_monstr;
  END IF;
  
  p_ret := l_ret;
END␀Tø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
