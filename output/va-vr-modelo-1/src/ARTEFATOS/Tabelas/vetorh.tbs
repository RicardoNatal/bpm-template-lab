‘␀␀PROCEDURE SP_PENDADE_IND(P_TIPOPE CHAR, P_CODDSP NUMBER(9), P_DATIND DATE, P_HORIND NUMBER(4), P_PROORI VARCHAR2(36))
  IS

  l_verplf NUMBER(3);
  l_codplf NUMBER(7);
  l_codrec NUMBER(15);
  l_codpen NUMBER(18);
  l_protcl VARCHAR2(36);
BEGIN
    l_protcl := '';
    BEGIN
        SELECT PROTCL INTO l_protcl FROM R058DSP WHERE CODDSP = P_CODDSP;
    EXCEPTION
        WHEN OTHERS THEN
            l_protcl := '';
    END;

    /*Somente gera se tiver protocolo. Significa que foi registrado as coordenadas na ADE-02. */
    IF (l_protcl IS NOT NULL AND LENGTH(LTRIM(RTRIM(l_protcl))) IS NOT NULL AND LENGTH(LTRIM(RTRIM(l_protcl))) > 0) THEN
        BEGIN
            SELECT PLF.VERPLF, PLF.CODPLF, PLF.CODREC INTO l_verplf, l_codplf, l_codrec
              FROM R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
             WHERE DSP.CODDSP = P_CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF AND PLF.CATPLF = 9
               AND PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3;
        EXCEPTION WHEN OTHERS THEN
            l_verplf := 0;
