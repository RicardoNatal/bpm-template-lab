						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAUTEXT', l_r034DAC.AUTEXT);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWAUTEXT)';
				END;
		END IF;
		

		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDUSAFRO', l_r034DAC.USAFRO);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDUSAFRO)';
				END;
		END IF;
		IF (:OLD.USAFRO <> :NEW.USAFRO AND l_r034EDP.USAFRO <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) OR (l_oridef = 2 AND :NEW.USAFRO = 'S') THEN /* UTILIZA VEICULO FROTA = 'S' EH MAIS ABRANGENTE */
				l_r034DAC.USAFRO := :NEW.USAFRO;
				l_r034EDP.USAFRO := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
