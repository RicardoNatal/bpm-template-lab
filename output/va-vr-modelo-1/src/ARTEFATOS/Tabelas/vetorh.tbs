␀c␀␀␀ÿ␀␀ÿ␀*␀áÔÿ!␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀öSŠÔÿ!␀␀␀␀␀Upw\Upn␀Æÿ␀␀ÿ1Æ␀␀…Ôÿ!␀␀␀␀␀“\p\“\n␀Æÿ␀␀ÿ2␀␀␀0;1ıÏ␀␀	SENIOR;0␀␀

/* Trigger Insert - Statement */
TRIGGER R014AVP_SI AFTER INSERT ON R014AVP

DECLARE
/* CURSOR c/ os registros gravados no R014AVP_AUX */
  CURSOR c_r014avp_ins IS
    SELECT CODSIN, DATALT, FORAVI, DIAAVI, DIAREA, SOMREA, SELIDA, SELSER FROM R014AVP_AUX;

  TYPE t_r014AVP_aux IS RECORD(
    CODSIN   R014AVP_AUX.CODSIN%TYPE,
    DATALT   R014AVP_AUX.DATALT%TYPE,
    FORAVI   R014AVP_AUX.FORAVI%TYPE,
    DIAAVI   R014AVP_AUX.DIAAVI%TYPE,
    DIAREA   R014AVP_AUX.DIAREA%TYPE,
    SOMREA   R014AVP_AUX.SOMREA%TYPE,
    SELIDA   R014AVP_AUX.SELIDA%TYPE,
    SELSER   R014AVP_AUX.SELSER%TYPE);

  l_r014AVP_aux t_r014AVP_aux;
BEGIN

  /* Apaga Registro OLD em R014AVP_AUX */
  BEGIN
    DELETE FROM R014AVP_AUX;
  EXCEPTION
    WHEN OTHERS THEN
      NULL;
  END;
END␀úÏ␀␀		SENIOR;0ª␀␀

/* Inclusao  */
TRIGGER R014AVP_EI AFTER INSERT ON R014AVP FOR EACH ROW

DECLARE
l_datavi       DATE;
  l_comando_nulo BOOLEAN;

BEGIN

  IF  :NEW.STAHIS = 1 THEN
    BEGIN
      SELECT R014SIN.DATAVI INTO l_datavi
        FROM R014SIN
       WHERE R014SIN.CODSIN = :NEW.CODSIN;
    EXCEPTION WHEN OTHERS THEN
      l_comando_nulo:=TRUE;
    END;

    IF   (:NEW.DATALT >= l_datavi)
    OR   (l_datavi IS NULL) THEN
         UPDATE R014SIN
            SET FORAVI = :NEW.FORAVI,
                DIAAVI = :NEW.DIAAVI,
                DIAREA = :NEW.DIAREA,
                SOMREA = :NEW.SOMREA,
                SELIDA = :NEW.SELIDA,
                SELSER = :NEW.SELSER,
                DATAVI = :NEW.DATALT
          WHERE R014SIN.CODSIN = :NEW.CODSIN;
    END IF;
  END IF;

  BEGIN
    /* Insere Registro Old */
    INSERT INTO R014AVP_AUX (CODSIN, DATALT, FORAVI, DIAAVI, DIAREA, SOMREA, SELIDA, SELSER, STAHIS)
                     VALUES (:NEW.CODSIN, :NEW.DATALT, :NEW.FORAVI, :NEW.DIAAVI, :NEW.DIAREA, :NEW.SOMREA, :NEW.SELIDA, :NEW.SELSER, :NEW.STAHIS);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R014AVP_AUX.';
  END;
END␀şÏ␀␀	SENIOR;0V␀␀

/* Trigger Update - Statement */
TRIGGER R014AVP_SU AFTER UPDATE ON R014AVP

DECLARE
/* CURSOR c/ os registros gravados no R014AVP_AUX */
  CURSOR c_r014AVP_upd IS
    SELECT CODSIN, DATALT, FORAVI, DIAAVI, DIAREA, SOMREA, SELIDA, SELSER, SINOLD, DATOLD, FOROLD, AVIOLD, REAOLD, SOMOLD, IDAOLD, SEROLD
      FROM R014AVP_AUX WHERE (FORAVI <> FOROLD OR DIAAVI <> AVIOLD OR DIAREA <> REAOLD OR SOMREA <> SOMOLD OR SELIDA <> IDAOLD OR SELSER <> SEROLD);

  TYPE t_r014AVP_aux IS RECORD(
    CODSIN   R014AVP_AUX.CODSIN%TYPE,
    DATALT   R014AVP_AUX.DATALT%TYPE,
    FORAVI   R014AVP_AUX.FORAVI%TYPE,
    DIAAVI   R014AVP_AUX.DIAAVI%TYPE,
    DIAREA   R014AVP_AUX.DIAREA%TYPE,
    SOMREA   R014AVP_AUX.SOMREA%TYPE,
    SELIDA   R014AVP_AUX.SELIDA%TYPE,
    SELSER   R014AVP_AUX.SELSER%TYPE,
    SINOLD   R014AVP_AUX.SINOLD%TYPE,
    DATOLD   R014AVP_AUX.DATOLD%TYPE,
    FOROLD   R014AVP_AUX.FOROLD%TYPE,
    AVIOLD   R014AVP_AUX.AVIOLD%TYPE,
    REAOLD   R014AVP_AUX.REAOLD%TYPE,
    SOMOLD   R014AVP_AUX.SOMOLD%TYPE,
    IDAOLD   R014AVP_AUX.IDAOLD%TYPE,
    SEROLD   R014AVP_AUX.SEROLD%TYPE
    );

  xR014AVP_aux t_r014AVP_aux;
BEGIN

  /* Apaga registros da R014AVP_AUX */
  BEGIN
    DELETE FROM R014AVP_AUX;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na exclusão dos registros da R014AVP_AUX';
  END;
END␀ûÏ␀␀		SENIOR;0*␀␀

/* Alteracao  */
TRIGGER R014AVP_EU AFTER UPDATE ON R014AVP FOR EACH ROW

DECLARE
l_datavi       DATE;
  l_comando_nulo BOOLEAN;

BEGIN

  IF  :NEW.STAHIS = 1 THEN
    BEGIN
      SELECT R014SIN.DATAVI INTO l_datavi
        FROM R014SIN
       WHERE R014SIN.CODSIN = :NEW.CODSIN;
    EXCEPTION WHEN OTHERS THEN
      l_comando_nulo:=TRUE;
    END;
    IF   (:NEW.datalt >= l_datavi)
    OR   (l_datavi IS NULL) THEN
         UPDATE R014SIN
            SET FORAVI = :NEW.FORAVI,
                DIAAVI = :NEW.DIAAVI,
                DIAREA = :NEW.DIAREA,
                SOMREA = :NEW.SOMREA,
                SELIDA = :NEW.SELIDA,
                SELSER = :NEW.SELSER,
                DATAVI = :NEW.DATALT
          WHERE R014SIN.CODSIN = :NEW.CODSIN;
    END IF;
  END IF;
END␀üÏ␀␀	SENIOR;0ÿ␀␀TRIGGER R014AVP_SD AFTER DELETE ON R014AVP

DECLARE
l_foravi        NUMBER(1);
  l_diaavi       NUMBER(3);
  l_diarea       NUMBER(3);
  l_somrea    VARCHAR2(1);
  l_selida       VARCHAR2(1);
  l_sELSEr       VARCHAR2(1);
  l_datavi       DATE;

  /* CURSOR c/ os registros gravados no R014AVP_AUX */
  CURSOR c_r014AVP_del IS SELECT CODSIN,DATALT,FORAVI,DIAAVI,DIAREA,SOMREA,SELIDA,SELSER,STAHIS FROM R014AVP_AUX;

  TYPE t_r014AVP_aux IS RECORD(
    CODSIN   R014AVP_AUX.CODSIN%TYPE,
    DATALT   R014AVP_AUX.DATALT%TYPE,
    FORAVI   R014AVP_AUX.FORAVI%TYPE,
    DIAAVI   R014AVP_AUX.DIAAVI%TYPE,
    DIAREA   R014AVP_AUX.DIAREA%TYPE,
    SOMREA   R014AVP_AUX.SOMREA%TYPE,
    SELIDA   R014AVP_AUX.SELIDA%TYPE,
    SELSER   R014AVP_AUX.SELSER%TYPE,
    STAHIS   R014AVP_AUX.STAHIS%TYPE);

  l_r014AVP_aux t_r014AVP_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r014AVP_del INTO  l_r014AVP_aux.CODSIN,
                              l_r014AVP_aux.DATALT,
                              l_r014AVP_aux.FORAVI,
                              l_r014AVP_aux.DIAAVI,
                              l_r014AVP_aux.DIAREA,
                              l_r014AVP_aux.SOMREA,
                              l_r014AVP_aux.SELIDA,
                              l_r014AVP_aux.SELSER,
                              l_r014AVP_aux.STAHIS
  LOOP
    IF l_r014AVP_aux.STAHIS = 1 THEN
      SELECT FORAVI,DIAAVI,DIAREA,SOMREA,SELIDA,SELSER,DATAVI INTO l_foravi, l_diaavi, l_diarea, l_somrea, l_selida, l_sELSEr, l_datavi FROM R014SIN
       WHERE CODSIN = l_r014AVP_aux.CODSIN;

      IF (l_r014AVP_aux.FORAVI = l_foravi) AND
           (l_r014AVP_aux.DIAAVI = l_diaavi) AND
           (l_r014AVP_aux.DIAREA = l_diarea) AND
           (l_r014AVP_aux.SOMREA = l_somrea) AND
           (l_r014AVP_aux.SELIDA = l_selida) AND
           (l_r014AVP_aux.SELSER = l_sELSEr) AND
           (l_r014AVP_aux.DATALT = l_datavi) THEN
        /* Pega o historico anterior */
        BEGIN
          SELECT A.FORAVI,A.DIAAVI,A.DIAREA,A.SOMREA,A.SELIDA, A.SELSER,A.DATALT
          INTO l_foravi,l_diaavi,l_diarea,l_somrea,l_selida,l_sELSEr,l_datavi
          FROM R014AVP A
          WHERE A.CODSIN = l_r014AVP_aux.CODSIN
          AND   A.STAHIS = 1
          AND DATALT IN (SELECT MAX(DATALT) FROM R014AVP
                         WHERE CODSIN = l_r014AVP_aux.CODSIN
                         AND   STAHIS = 1);
        EXCEPTION
          WHEN TOO_MANY_ROWS THEN
            RAISERROR 103 'Erro em R014AVP - TOO MANY ROWS';
          WHEN NO_DATA_FOUND THEN
            l_foravi:=0;
            l_diaavi:=0;
            l_diarea:=0;
            l_somrea:='';
            l_selida:='';
            l_sELSEr:='';
            l_datavi:='31/12/1900,00:00:00';
          WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT R014AVP';
        END;

        /* Atualiza tabela de sindicato */
        BEGIN
          UPDATE R014SIN
             SET FORAVI = l_foravi,
                 DIAAVI = l_diaavi,
                 DIAREA = l_diarea,
                 SOMREA = l_somrea,
                 SELIDA = l_selida,
                 SELSER = l_sELSEr,
                 DATAVI = l_datavi
           WHERE R014SIN.CODSIN = l_r014AVP_aux.CODSIN;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro Na Atualização do R014SIN';
        END;
      END IF;
    END IF;

  END LOOP;

  /* Apaga Registro OLD em R014AVP_AUX */
  BEGIN
    DELETE FROM R014AVP_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ùÏ␀␀		SENIOR;0Ô␀␀

/* Exclusao */
TRIGGER R014AVP_ED AFTER DELETE ON R014AVP FOR EACH ROW

BEGIN
BEGIN
    /* Insere Registro Old */
    INSERT INTO R014AVP_AUX (CODSIN, DATALT, FORAVI, DIAAVI, DIAREA, SOMREA, SELIDA, SELSER, STAHIS)
                     VALUES (:OLD.CODSIN, :OLD.DATALT, :OLD.FORAVI, :OLD.DIAAVI, :OLD.DIAREA, :OLD.SOMREA, :OLD.SELIDA, :OLD.SELSER, :OLD.STAHIS);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R014AVP_AUX.';
  END;
END␀␀␀ë$␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀÷Ï␀␀“-´␀Ôÿ!␀␀␀␀␀UA‚␀‚␀r"‡␀Æÿ␀␀ÿ␀mDÑ␀Ôÿ!␀␀␀␀␀JIşEşEqCˆ␀êÿ␀␀ÿ␀p4Ôÿ!␀␀␀␀␀	:	:	:n␀Æÿ␀␀ÿ␀[±␀Ôÿ!␀␀␀␀␀	\\	\q␀Æÿ␀␀ÿ␀À[±␀Ôÿ!␀␀␀␀␀\\\q␀Æÿ␀␀ÿ␀m␀=Ôÿ!␀␀␀␀␀Š␀ˆ␀ˆ␀c␀␀␀ÿ␀␀ÿ␀
