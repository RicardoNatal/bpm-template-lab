  SP_SIMNAO_INT(l_UtiCid IN OUT);
  SP_SIMNAO_INT(l_UtilOE IN OUT);
  SP_SIMNAO_INT(l_UtiCPF IN OUT);
  SP_SIMNAO_INT(l_UtiCNH IN OUT);
  SP_SIMNAO_INT(l_UtiPas IN OUT);
  SP_SIMNAO_INT(l_UtiOut IN OUT);
  SP_SIMNAO_INT(l_UtiSDO IN OUT);
  SP_SIMNAO_INT(l_UtiWav IN OUT);
  SP_SIMNAO_INT(l_LeiAut IN OUT);
  SP_SIMNAO_INT(l_FotPes IN OUT);
  SP_SIMNAO_INT(l_PerBcr IN OUT);
  SP_SIMNAO_INT(l_AgeAut IN OUT);
  SP_SIMNAO_INT(l_PerSAc IN OUT);
  SP_SIMNAO_INT(l_UtiREs IN OUT);
  
  l_valstr := '87' || l_datenv || l_tipOpe || l_codporStr || l_TamDesPorStr || l_desPor || l_PerAgv || l_SelPor ||
                      l_VisLma || l_QtdVisStr || l_horvisStr || l_UtiWav || p_UtiVei || p_ObrFmv || p_ModBio || p_LeiDoc ||l_AgeAut;
  l_valstr := l_valstr || l_UtiCid || l_UtilOE || l_UtiCPF || l_UtiCNH || l_UtiPas || l_UtiOut || l_UtiSDO || l_UtiREs;

  /* montando a lista de tipos de visita */
  l_qtd := 0;
  l_aux := '';
  FOREACH c_r090atv INTO l_TipVis
  LOOP
    SP_INTSTR(l_TipVis, '999', l_TipVisStr OUT);
    l_aux := l_aux || l_TipVisStr;  
    l_qtd := l_qtd + 1;
  END LOOP;
  SP_INTSTR(l_qtd, '999', l_qtdStr OUT);
  l_valstr := l_valstr || l_qtdStr || l_aux;

  /* montando a lista de permissões */
  l_qtd := 0;
  l_aux := '';
  FOREACH c_r090acp INTO l_CodPrm
