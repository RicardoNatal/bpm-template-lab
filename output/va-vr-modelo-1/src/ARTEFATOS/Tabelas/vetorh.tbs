  ELSE
      IF (l_dattse < l_datmin) THEN
          l_datpre := l_dattse;
      ELSE
          l_datpre := l_datmin;
      END IF;
  END IF;

  IF (p_datfim <= l_datpre) AND (p_datfim <> l_data_zero) THEN
      SP_DATSTR(p_datfim,'DDMMYY',l_datstr OUT);
      SP_INTSTR(p_horfim,'HHMM',l_horstr OUT);
  ELSE
      SP_DATSTR(l_datpre,'DDMMYY',l_datstr OUT);
      SP_INTSTR(1439,'HHMM',l_horstr OUT);
  END IF;
  l_datahora := l_datstr || l_horstr;

  IF (l_datahora IS NULL) OR (l_datahora = '') THEN
      IF (p_datfim <> l_data_zero) THEN
          SP_DATSTR(p_datfim,'DDMMYY',l_datstr OUT);
          SP_INTSTR(p_horfim,'HHMM',l_horstr OUT);
          l_datahora := l_datstr || l_horstr;
      ELSE
          l_datahora := '3112502359';
      END IF;
  END IF;

  p_datahora := l_datahora;

  /*SOMENTE PARA TBS 20 e 23, verifica R070TSI.CNTPLT*/
  BEGIN
      SELECT CNTPLT INTO l_cntplt FROM R070TSI;
  EXCEPTION
    WHEN OTHERS THEN
      l_cntplt := 'N';
  END;

  /* Atualiza registros da CONTPLANT nos TBSs 20 e 23 apenas se R070TI.CntPlt = S */
  IF (l_cntplt = 'S') THEN
      /*Remove este ICARD da tabela CONTPLANTA*/
      SP_DELCONTPLANTA(l_cratit);

      /*Se não estiver deletando, atualiza a tabela ContPlanta*/
      IF (p_tipope <> 'D') THEN
          FOREACH c_r034PLA INTO l_r034Pla.CODPLT,
                                 l_r034Pla.dataso,
                                 l_r034Pla.dattse,
                                 l_r034Pla.bloplt
          LOOP
            R034PLA_CONTPLANTA(p_tipope, l_cratit, p_numemp, p_tipcol, p_numcad, l_r034Pla.CODPLT, l_r034Pla.dataso, l_r034Pla.dattse, l_datstr, l_horstr, l_r034Pla.bloplt);
          END LOOP;
      END IF;
  END IF;
END␀ ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
