TRIGGER R346TPT_EU BEFORE UPDATE ON R346TPT FOR EACH ROW
DECLARE
  l_Valor VARCHAR2(2000);
  l_Alterou BOOLEAN;
  l_Valido BOOLEAN;
  l_JsonCamposAlterados VARCHAR2(2000);
  l_VersaoESocial NUMBER;
BEGIN 
  l_Valor := '';
  l_VersaoESocial := 0;
  l_JsonCamposAlterados := '';
  
  IF (:NEW.CODACA = 0 OR :NEW.ORIINF <> 2) THEN
    SP_ESOCIAL_S250X (:NEW.NUMEMP, :NEW.CMPPAG, l_VersaoESocial OUT);
    
    SP_VALUPDATE_DES(:OLD.OBSPRO, :NEW.OBSPRO, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_DES_JSON('OBSPRO', 'Observações Alteradas', 'Observações Alteradas', l_JsonCamposAlterados OUT);
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.ORIINF, :NEW.ORIINF, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_NUM_JSON('ORIINF', :NEW.ORIINF, :OLD.ORIINF, l_JsonCamposAlterados OUT);
    END IF;
    
    IF (l_VersaoESocial >= 6) THEN
    
      SP_VALUPDATE_DAT(:OLD.DATLAU, :NEW.DATLAU, l_Valido OUT);
    	IF (l_Valido = TRUE) THEN
        l_Alterou := TRUE;
        SP_CONCAT_DAT_JSON('DATLAU', :NEW.DATLAU, :OLD.DATLAU, l_JsonCamposAlterados OUT);
      END IF;
      
    END IF;
    
    IF (l_Alterou = TRUE) THEN
      SP_CONCATENAR_NUM('CODPRO', :NEW.CODPRO, l_Valor OUT);
      SP_CONCATENAR_DAT('CMPPAG', :NEW.CMPPAG, l_Valor OUT);
      
      SP_E_SOCIAL('S-2501', 'R346TPT', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, l_JsonCamposAlterados, 0, NULL, :NEW.CMPPAG, 0, 'R346TPT_EU');
    END IF;
  END IF;
END␀{æ␀␀		SENIOR;0␀␀

