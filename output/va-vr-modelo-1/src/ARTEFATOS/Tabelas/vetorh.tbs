␀Æÿ␀␀ÖÒ␀␀␀—,¼␀”ˆ␀␀␀␀␀␀=nnX)␀␀Æÿ␀␀!#␀␀␀åĞ␀␀␀␀0;1æĞ␀␀		SENIOR;0{␀␀TRIGGER R020TOM_EU AFTER UPDATE ON R020TOM FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
BEGIN
  IF ((:NEW.CODTOM <> 0) AND (:OLD.CODTOM = 0)) THEN
    l_Valor := '';
  
    SP_CONCATENAR_NUM('CODRAT', :NEW.CodRat, l_Valor OUT);

    SP_E_SOCIAL('S-1020', 'R020TOM', 'T', 'I', NULL, NULL, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R020TOM_EU');
  END IF;
END␀␀␀Ní␀␀␀␀␀␀␀çĞ␀␀,­␀	␀␀␀␀␀␀¤:¤:¤:p␀Æÿ␀␀èĞ␀␀␀Tc␀␀␀␀␀␀°V°V°V`␀␀ÿ␀␀ÿ␀¶␀␀Ë␀␀␀␀␀␀␀‘¶␀␀‘¶␀␀‘¶␀␀n␀Æÿ␀␀ÿ␀␀␀␀0␀␀g␀␀␀␀éĞ␀␀b,­␀	Ôÿ?␀␀␀␀␀ˆ<ˆPˆPpM‡␀Æÿ␀␀êĞ␀␀␀ZTcÔÿ?␀␀␀␀␀W°V°V`L‡␀␀ÿ␀␀ÿ␀I␀˜␀␀␀␀␀␀␀␀␀␀n␀Æÿ␀␀ÿ␀wP†␀␀␀␀␀␀␀ì␀␀␀n␀Æÿ␀␀ÿ␀? =Ôÿ?␀␀␀␀␀M E M c␀␀␀ÿ␀␀ÿN␀␀␀0ëĞ␀␀		SENIOR;0␀␀TRIGGER R022DEF_EU AFTER UPDATE ON R022DEF FOR EACH ROW

DECLARE
l_Valido       BOOLEAN;
  l_Alterou      BOOLEAN;
  l_Alterou_Beneficiario_Isento BOOLEAN;
  l_Alterou_DefSoc BOOLEAN;
  l_JsonCamposAlterados VARCHAR2(2000);
  l_dataReferencia DATE;
  l_dataZero DATE;
  l_codigoDeficiencia    R022DEF.CODDEF%TYPE;
  l_layout  VARCHAR2(6);  	
  l_layoutAlteracaoCadastral VARCHAR2(6);	
   
  TYPE T_COLABORADOR IS RECORD (NUMEMP   R034FUN.NUMEMP%TYPE, TIPCOL   R034FUN.TIPCOL%TYPE, NUMCAD   R034FUN.NUMCAD%TYPE);  
  COLABORADOR T_COLABORADOR;
  CURSOR C_DeficienciasColaborador IS SELECT FUN.NUMEMP, FUN.TIPCOL, FUN.NUMCAD FROM R034FUN FUN, R034MAT MAT
   WHERE MAT.NUMEMP = FUN.NUMEMP 
     AND MAT.TIPCOL = FUN.TIPCOL
     AND MAT.NUMCAD = FUN.NUMCAD
     AND FUN.CODDEF = l_codigoDeficiencia
     AND NOT EXISTS (SELECT 1 FROM R038AFA AFA, R010SIT SIT 
                      WHERE AFA.NUMEMP = FUN.NUMEMP
                        AND AFA.TIPCOL = FUN.TIPCOL
			  		    AND AFA.NUMCAD = FUN.NUMCAD
					    AND AFA.DATAFA = (SELECT MAX (AFA2.DATAFA) FROM R038AFA AFA2 
					                       WHERE AFA2.NUMEMP = AFA.NUMEMP
  										     AND AFA2.TIPCOL = AFA.TIPCOL
										     AND AFA2.NUMCAD = AFA.NUMCAD
										     AND AFA2.DATAFA <= l_dataReferencia
										     AND (AFA2.DATTER = l_dataZero OR AFA2.DATTER > l_dataReferencia))  
                        AND AFA.SITAFA = SIT.CODSIT AND SIT.TIPSIT = 7) 
  UNION (
  SELECT FUN.NUMEMP, FUN.TIPCOL, FUN.NUMCAD FROM R034FUN FUN, R034MAT MAT, R110FIC FIC, R110HDF HDF
   WHERE MAT.NUMEMP = FUN.NUMEMP 
     AND MAT.TIPCOL = FUN.TIPCOL
     AND MAT.NUMCAD = FUN.NUMCAD
     AND FIC.TIPATN = 1
     AND FIC.NUMEMP = FUN.NUMEMP
     AND FIC.TIPCOL = FUN.TIPCOL
     AND FIC.NUMCAD = FUN.NUMCAD
     AND HDF.NUMEMP = FIC.NUMEMP
     AND HDF.CODFIC = FIC.CODFIC
     AND HDF.CODDEF = l_codigoDeficiencia   
     AND HDF.DATDEF = (SELECT MAX(HDF2.DATDEF) FROM R110HDF HDF2
                        WHERE HDF2.NUMEMP = HDF.NUMEMP 
					      AND HDF2.CODFIC = HDF.CODFIC
						  AND HDF2.CODDEF = HDF.CODDEF
						  AND HDF2.DATDEF <= l_dataReferencia)
     AND NOT EXISTS (SELECT 1 FROM R038AFA AFA, R010SIT SIT 
                      WHERE AFA.NUMEMP = FUN.NUMEMP
					    AND AFA.TIPCOL = FUN.TIPCOL
					    AND AFA.NUMCAD = FUN.NUMCAD
					    AND AFA.DATAFA = (SELECT MAX (AFA2.DATAFA) FROM R038AFA AFA2 
					                       WHERE AFA2.NUMEMP = AFA.NUMEMP
										     AND AFA2.TIPCOL = AFA.TIPCOL
										     AND AFA2.NUMCAD = AFA.NUMCAD
										     AND AFA2.DATAFA <= l_dataReferencia
										     AND (AFA2.DATTER = l_dataZero OR AFA2.DATTER > l_dataReferencia))  
                        AND AFA.SITAFA = SIT.CODSIT AND SIT.TIPSIT = 7));  
BEGIN
  /*e-Social*/
  l_Alterou := FALSE;
  l_JsonCamposAlterados := '';
  l_Alterou_Beneficiario_Isento := FALSE;
  l_Alterou_DefSoc := FALSE;
  
  SP_VALUPDATE_DES(:OLD.BENCON, :NEW.BENCON, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
	l_Alterou := TRUE;
	SP_CONCAT_DES_JSON('BENCON', :NEW.BENCON, :OLD.BENCON, l_JsonCamposAlterados OUT);
	l_Alterou_Beneficiario_Isento := TRUE;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.DEFSOC, :NEW.DEFSOC, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
	l_Alterou := TRUE;
	SP_CONCAT_NUM_JSON('DEFSOC', :NEW.DefSoc, :OLD.DefSoc, l_JsonCamposAlterados OUT);
	l_Alterou_DefSoc := TRUE;
  END IF;
	
  IF (l_Alterou = TRUE) THEN 	
    l_dataReferencia := CURDATE();
    l_dataZero := '31/12/1900,00:00:00';
    l_codigoDeficiencia := :NEW.CODDEF;
	
    FOREACH C_DeficienciasColaborador INTO COLABORADOR.NUMEMP, COLABORADOR.TIPCOL,COLABORADOR.NUMCAD
    LOOP
      RH_LAYOUTCOLAB(COLABORADOR.NUMEMP, COLABORADOR.TIPCOL, COLABORADOR.NUMCAD, l_layout OUT);
      IF (l_layout IS NOT NULL) THEN
        RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
        
        IF (l_layout = 'S-2400') THEN
        	IF (l_Alterou_Beneficiario_Isento = TRUE) THEN
          		SP_E_SOCIAL(l_layout, 'R022DEF', 'N', 'A', NULL, NULL, COLABORADOR.NUMEMP, COLABORADOR.TIPCOL, COLABORADOR.NUMCAD, '', l_JsonCamposAlterados, 0, NULL, l_dataReferencia, 0, 'R022DEF_EU');	
        	END IF;
        ELSE
            IF (l_Alterou_DefSoc = TRUE) THEN
	      		SP_E_SOCIAL(l_layoutAlteracaoCadastral, 'R022DEF', 'N', 'A', NULL, NULL, COLABORADOR.NUMEMP, COLABORADOR.TIPCOL, COLABORADOR.NUMCAD, '', l_JsonCamposAlterados, 0, NULL, l_dataReferencia, 0, 'R022DEF_EU');	
	    	END IF;
	    END IF;
	    
	  END IF;      
    END LOOP;  
  END IF;  
  /*e-Social*/
END␀␀␀‹P␀␀␀␀␀␀ìĞ␀␀N␀´␀	Ôÿ?␀␀␀␀␀wAwA0␀r␀Æÿ␀␀íĞ␀␀␀‘UcÔÿ?␀␀␀␀␀^Y^Y^Y`␀␀ÿ␀␀ÿ␀␀␀␀0␀␀‘␀␀␀îĞ␀␀o,´␀	Ôÿ/␀␀␀␀␀®B¤:¤:r␀Æÿ␀␀ïĞ␀␀␀lToÔÿ/␀␀␀␀␀Z°V°Vi␀␀ÿ␀␀ÿ␀V␀¨Ôÿ/␀␀␀␀␀¶␀>␀µ␀n␀Æÿ␀␀ÿ5␀␀␀0␀␀”␀␀␀␀␀ğĞ␀␀	t­␀	Ôÿ3␀␀␀␀␀z@1tQtpM‡␀Æÿ␀␀òĞ␀␀␀TEÔÿ3␀␀␀␀␀êX°V°VGL‡␀␀ÿ␀␀ÿ␀Œ‘␀␀àÔÿ1␀␀␀␀␀{@øì␀␀XtpN‡␀Æÿ␀␀ÿ␀␀␀␀0ñĞ␀␀		SENIOR;0␀␀TRIGGER R022GRA_EU AFTER UPDATE ON R022GRA FOR EACH ROW

DECLARE
  l_Valido       BOOLEAN;
  l_Alterou      BOOLEAN;
  l_gerarPendencia BOOLEAN;
  l_JsonCamposAlterados VARCHAR2(2000);
  l_dataReferencia DATE;
  l_grauInstrucao   R022GRA.GRAINS%TYPE;
  l_layout  VARCHAR2(6);  					    
  TYPE T_COLABORADOR IS RECORD (NUMEMP   R034FUN.NUMEMP%TYPE, TIPCOL   R034FUN.TIPCOL%TYPE, NUMCAD   R034FUN.NUMCAD%TYPE);  
  COLABORADOR T_COLABORADOR;
  
  CURSOR c_grauInstrucaoColaborador IS SELECT FUN.NUMEMP, FUN.TIPCOL, FUN.NUMCAD FROM R034FUN FUN, R034MAT MAT, R010SIT SIT
   WHERE FUN.NUMEMP = MAT.NUMEMP
     AND FUN.TIPCOL = MAT.TIPCOL
	 AND FUN.NUMCAD = MAT.NUMCAD
	 AND FUN.SITAFA = SIT.CODSIT
	 AND SIT.TIPSIT <> 7
	 AND FUN.GRAINS = l_grauInstrucao;
  
BEGIN
  /*e-Social*/
  l_Alterou := FALSE;
  l_gerarPendencia := TRUE;
  l_JsonCamposAlterados := '';
      
  SP_VALUPDATE_NUM(:OLD.INSRAI, :NEW.INSRAI, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
	l_Alterou := TRUE;
	SP_CONCAT_NUM_JSON('INSRAI', :NEW.INSRAI, :OLD.INSRAI, l_JsonCamposAlterados OUT);
  END IF;
	
  IF (l_Alterou = TRUE) THEN
    l_grauInstrucao := :NEW.GRAINS;
	l_dataReferencia := CURDATE();
    
	FOREACH c_grauInstrucaoColaborador INTO COLABORADOR.NUMEMP, COLABORADOR.TIPCOL,COLABORADOR.NUMCAD
	LOOP
      RH_LAYOUTCOLAB(COLABORADOR.NUMEMP, COLABORADOR.TIPCOL, COLABORADOR.NUMCAD, l_layout OUT);
      IF (l_layout IS NOT NULL) THEN
        N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
        IF (l_gerarPendencia = TRUE) THEN
