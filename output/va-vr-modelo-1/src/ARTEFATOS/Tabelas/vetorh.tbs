­j␀

PROCEDURE SP_GESPER(P_TIPOPE CHAR(1),P_ESTPOS NUMBER(3),P_POSTRA VARCHAR2(25),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_INIATU DATE,P_TERATU DATE,P_ORIDEF NUMBER(1))
 IS

l_datatu      DATE;
	l_idtcol      CHAR(23);
	l_count       NUMBER(5);
	l_estpospri   NUMBER(3);
	l_postrapri   VARCHAR2(25);
	l_atucol      BOOLEAN;
	l_graedp      BOOLEAN;
	l_dacpos      BOOLEAN;
	l_coddsp      NUMBER(9);
	l_verplf      NUMBER(3);
	l_codplf      NUMBER(7);
	l_codRPA      NUMBER(15);
	l_temAud34DAC NUMBER(2);
	l_temAud34PRM NUMBER(2);
	l_temAud34FAP NUMBER(2);
	l_numempSTR   VARCHAR2(255);
	l_tipcolSTR   VARCHAR2(255);
	l_numcadSTR   VARCHAR2(255);
	l_ConCreSTR   VARCHAR(1);
	l_ConFaiSTR   VARCHAR(1);
	l_TemAlmSTR   VARCHAR(3);
	l_TemPacSTR   VARCHAR(3);
	l_GraConSTR   VARCHAR(3);
	l_CodRlgSTR   VARCHAR(5);
	l_VerPlfSTR   VARCHAR(3);
	l_CodPlfSTR   VARCHAR(7);
	l_CodDspSTR   VARCHAR(9);
	l_EstPosSTR   VARCHAR(3);
	l_TolIntSTR   VARCHAR(3);
	l_DiaSemSTR   VARCHAR(1);
	l_IniFaiSTR   VARCHAR(5);
	l_FimFaiSTR   VARCHAR(5);
	l_prmSTR      VARCHAR(5);
	l_UsaBioSTR   VARCHAR(1);
	l_TolAcpSTR   VARCHAR2(255);
	l_CodPltSTR	  VARCHAR2(5);
	l_horatu      NUMBER(5);
	l_codusu	  NUMBER(9);
	l_posseg      CHAR(1);

	/* CURSOR QUE OBTEM AS PERMISSOES POR LOCAL FIÂ?SICO/DISPOSITIVO */
	CURSOR c_r017PRM IS
		SELECT CODPLT, CODRLG, VERPLF, CODPLF, CODDSP
			FROM R017PRM WHERE ESTPOS = p_estpos AND POSTRA = p_postra;
	TYPE t_r017PRM IS RECORD(
		CODPLT   R017PRM.CODPLT%TYPE,
		CODRLG   R017PRM.CODRLG%TYPE,
		VERPLF   R017PRM.VERPLF%TYPE,
		CODPLF   R017PRM.CODPLF%TYPE,
		CODDSP   R017PRM.CODDSP%TYPE);
	l_r017PRM t_r017PRM;

	/* CURSOR QUE OBTEM AS ACOES DA FAIXA DO DISPOSITIVO POR POSTO DE TRABALHO */
	CURSOR c_r017AFD IS
		SELECT CODDSP, DIASEM, ACOFAI
			FROM R017AFD WHERE ESTPOS = p_estpos AND POSTRA = p_postra;
	TYPE t_r017AFD IS RECORD(
		CODDSP   R017AFD.CODDSP%TYPE,
		DIASEM   R017AFD.DIASEM%TYPE,
		ACOFAI   R017AFD.ACOFAI%TYPE);
	l_r017AFD t_r017AFD;

	/* CURSOR QUE OBTEM AS ACOES DA FAIXA DO LOCAL FISICO POR POSTO DE TRABALHO */
	CURSOR c_r017AFL IS
		SELECT VERPLF, CODPLF, DIASEM, ACOFAI
			FROM R017AFL WHERE ESTPOS = p_estpos AND POSTRA = p_postra;
	TYPE t_r017AFL IS RECORD(
			VERPLF   R017AFL.VERPLF%TYPE,
			CODPLF   R017AFL.CODPLF%TYPE,
			DIASEM   R017AFL.DIASEM%TYPE,
			ACOFAI   R017AFL.ACOFAI%TYPE);
	l_r017AFL t_r017AFL;

	/* CURSOR QUE OBTEM AS FAIXAS DE ACESSO DA PERMISSAO POR POSTO DE TRABALHO */
	CURSOR c_r017FAP IS
		SELECT CODPLT, CODRLG, CODDSP, VERPLF, CODPLF, INIFAI, FIMFAI, DIASEM
			FROM R017FAP WHERE ESTPOS = p_estpos AND POSTRA = p_postra;
	TYPE t_r017FAP IS RECORD(
		CODPLT   R017FAP.CODPLT%TYPE,
		CODRLG   R017FAP.CODRLG%TYPE,
		CODDSP   R017FAP.CODDSP%TYPE,
		VERPLF   R017FAP.VERPLF%TYPE,
		CODPLF   R017FAP.CODPLF%TYPE,
		INIFAI   R017FAP.INIFAI%TYPE,
		FIMFAI   R017FAP.FIMFAI%TYPE,
		DIASEM   R017FAP.DIASEM%TYPE);
		l_r017FAP t_r017FAP;

	TYPE t_r034EDP IS RECORD(
		VERPRM   R034EDP.VERPRM%TYPE,
		CONFAI   R034EDP.CONFAI%TYPE,
		CONADP   R034EDP.CONADP%TYPE,
		CONCRE   R034EDP.CONCRE%TYPE,
		CONIAL   R034EDP.CONIAL%TYPE,
		TEMALM   R034EDP.TEMALM%TYPE,
		BLOFAL   R034EDP.BLOFAL%TYPE,
		RECVIS   R034EDP.RECVIS%TYPE,
		AUTAGV   R034EDP.AUTAGV%TYPE,
		AUTASA   R034EDP.AUTASA%TYPE,
		AUTEXT   R034EDP.AUTEXT%TYPE,
		USAFRO   R034EDP.USAFRO%TYPE,
		GRACON   R034EDP.GRACON%TYPE,
		CONPAC   R034EDP.CONPAC%TYPE,
		TEMPAC   R034EDP.TEMPAC%TYPE,
		TOLACP   R034EDP.TOLACP%TYPE,
		USABIO   R034EDP.USABIO%TYPE,
		AUTDBL   R034EDP.AUTDBL%TYPE,
		VERAFA   R034EDP.VERAFA%TYPE,
		APRSOL   R034EDP.APRSOL%TYPE,
		CONINT   R034EDP.CONINT%TYPE,
		TOLINT   R034EDP.TOLINT%TYPE,
		CONREA   R034EDP.CONREA%TYPE,
		UTICHV   R034EDP.UTICHV%TYPE,
		REPONL   R034EDP.REPONL%TYPE,
		USARFA   R034EDP.USARFA%TYPE,
		CONREE   R034EDP.CONREE%TYPE);
	l_r034EDP t_r034EDP;

	TYPE t_r017DAC IS RECORD(
		VERPRM   R017DAC.VERPRM%TYPE,
		CONFAI   R017DAC.CONFAI%TYPE,
		CONADP   R017DAC.CONADP%TYPE,
		CONCRE   R017DAC.CONCRE%TYPE,
		CONIAL   R017DAC.CONIAL%TYPE,
		TEMALM   R017DAC.TEMALM%TYPE,
		BLOFAL   R017DAC.BLOFAL%TYPE,
		RECVIS   R017DAC.RECVIS%TYPE,
		AUTAGV   R017DAC.AUTAGV%TYPE,
		AUTASA   R017DAC.AUTASA%TYPE,
		AUTEXT   R017DAC.AUTEXT%TYPE,
		USAFRO   R017DAC.USAFRO%TYPE,
		GRACON   R017DAC.GRACON%TYPE,
		CONPAC   R017DAC.CONPAC%TYPE,
		TEMPAC   R017DAC.TEMPAC%TYPE,
		TOLACP   R017DAC.TOLACP%TYPE,
		USABIO   R017DAC.USABIO%TYPE,
		AUTDBL   R017DAC.AUTDBL%TYPE,
		VERAFA   R017DAC.VERAFA%TYPE,
		APRSOL   R017DAC.APRSOL%TYPE,
		CONINT   R017DAC.CONINT%TYPE,
		TOLINT   R017DAC.TOLINT%TYPE,
		CONREA   R017DAC.CONREA%TYPE,
		UTICHV   R017DAC.UTICHV%TYPE,
		REPONL   R017DAC.REPONL%TYPE,
		USARFA   R017DAC.USARFA%TYPE,
		CODPRM   R017DAC.CODPRM%TYPE,
		PRMFER   R017DAC.PRMFER%TYPE,
		PRMSAB   R017DAC.PRMSAB%TYPE,
		PRMDOM   R017DAC.PRMDOM%TYPE,
		PRMVIS   R017DAC.PRMVIS%TYPE,
		CONREE   R017DAC.CONREE%TYPE);
	l_r017DAC t_r017DAC;

	TYPE t_r034DAC IS RECORD(
		VERPRM   R034DAC.VERPRM%TYPE,
		CONFAI   R034DAC.CONFAI%TYPE,
		CONADP   R034DAC.CONADP%TYPE,
		CONCRE   R034DAC.CONCRE%TYPE,
		CONIAL   R034DAC.CONIAL%TYPE,
		TEMALM   R034DAC.TEMALM%TYPE,
		BLOFAL   R034DAC.BLOFAL%TYPE,
		RECVIS   R034DAC.RECVIS%TYPE,
		AUTAGV   R034DAC.AUTAGV%TYPE,
		AUTASA   R034DAC.AUTASA%TYPE,
		AUTEXT   R034DAC.AUTEXT%TYPE,
		USAFRO   R034DAC.USAFRO%TYPE,
		GRACON   R034DAC.GRACON%TYPE,
		CONPAC   R034DAC.CONPAC%TYPE,
		TEMPAC   R034DAC.TEMPAC%TYPE,
		TOLACP   R034DAC.TOLACP%TYPE,
		USABIO   R034DAC.USABIO%TYPE,
		AUTDBL   R034DAC.AUTDBL%TYPE,
		VERAFA   R034DAC.VERAFA%TYPE,
		APRSOL   R034DAC.APRSOL%TYPE,
		CONINT   R034DAC.CONINT%TYPE,
		TOLINT   R034DAC.TOLINT%TYPE,
		CONREA   R034DAC.CONREA%TYPE,
		UTICHV   R034DAC.UTICHV%TYPE,
		REPONL   R034DAC.REPONL%TYPE,
		USARFA   R034DAC.USARFA%TYPE,
		CODPRM   R034DAC.CODPRM%TYPE,
		PRMFER   R034DAC.PRMFER%TYPE,
		PRMSAB   R034DAC.PRMSAB%TYPE,
		PRMDOM   R034DAC.PRMDOM%TYPE,
		PRMVIS   R034DAC.PRMVIS%TYPE,
		CONREE   R034DAC.CONREE%TYPE);
	l_r034DAC t_r034DAC; 

BEGIN

	/* veririca se utiliza posto de trabalho com Gestão de Acesso e Segurança */
	BEGIN
		SELECT POSSEG INTO l_posseg FROM R000ASS;
	EXCEPTION
		WHEN OTHERS THEN l_posseg := 'N';
	END;		
	
	IF (l_posseg = 'S') THEN 
		l_atucol := FALSE;
		l_graedp := FALSE;
		l_dacpos := TRUE;
		l_datatu := CURDATE();
		l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
		SP_RETIDTPES(p_numemp, p_tipcol, p_numcad, NULL, NULL, NULL, NULL, l_idtcol OUT);
		
		/*Código de usuário que será usado para geração de todos os logs de auditoria.*/
		SELECT CODUSU INTO l_codusu FROM R038HPO_AUX WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND INIATU = p_iniatu AND TERATU = p_teratu;
		
		
		l_numempSTR := CONVERT(NUMBER_TO_CHAR,p_numemp);
		l_numempSTR := LTRIM(l_numempSTR);
		l_numempSTR := RTRIM(l_numempSTR);
		
		l_tipcolSTR := CONVERT(NUMBER_TO_CHAR,p_tipcol);
		l_tipcolSTR := LTRIM(l_tipcolSTR);
		l_tipcolSTR := RTRIM(l_tipcolSTR);
		
		l_numcadSTR := CONVERT(NUMBER_TO_CHAR,p_numcad);
		l_numcadSTR := LTRIM(l_numcadSTR);
		l_numcadSTR := RTRIM(l_numcadSTR);
		
		l_EstPosSTR := CONVERT(NUMBER_TO_CHAR, p_estpos);
		l_EstPosSTR := LTRIM(l_EstPosSTR);
		l_EstPosSTR := RTRIM(l_EstPosSTR);
		
		l_temAud34DAC := 0;
		BEGIN
			SELECT COUNT(*) INTO l_temAud34DAC FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 80;
		EXCEPTION
			WHEN OTHERS THEN RAISERROR 103 'SPGESPER: Erro ao realizar o SELECT na tabela R995CTE.';
		END;
			
		l_temAud34PRM := 0;
		BEGIN
			SELECT COUNT(*) INTO l_temAud34PRM FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 101;
		EXCEPTION
			WHEN OTHERS THEN RAISERROR 103 'SPGESPER: Erro ao realizar o SELECT na tabela R995CTE.';
		END;
			
		l_temAud34FAP := 0;
		BEGIN
			SELECT COUNT(*) INTO l_temAud34FAP FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 102;
		EXCEPTION
			WHEN OTHERS THEN RAISERROR 103 'SPGESPER: Erro ao realizar o SELECT na tabela R995CTE.';
		END;
			
		l_codRPA := 0;
		
		/* BUSCO AS EXCECOES DE DEFINICAO DE ACESSO POR COLABORADOR */
		BEGIN
			SELECT VERPRM, CONFAI, CONADP, CONCRE, CONIAL, TEMALM, BLOFAL, RECVIS, AUTAGV, AUTASA, AUTEXT, USAFRO, GRACON,
			  CONPAC, TEMPAC, TOLACP, USABIO, AUTDBL, VERAFA, APRSOL, CONINT, TOLINT, CONREA, UTICHV, REPONL, USARFA, CONREE
			INTO l_r034EDP.VERPRM, l_r034EDP.CONFAI, l_r034EDP.CONADP, l_r034EDP.CONCRE, l_r034EDP.CONIAL, l_r034EDP.TEMALM,
			  l_r034EDP.BLOFAL, l_r034EDP.RECVIS, l_r034EDP.AUTAGV, l_r034EDP.AUTASA, l_r034EDP.AUTEXT, l_r034EDP.USAFRO,
			  l_r034EDP.GRACON, l_r034EDP.CONPAC, l_r034EDP.TEMPAC, l_r034EDP.TOLACP, l_r034EDP.USABIO, l_r034EDP.AUTDBL,
			  l_r034EDP.VERAFA, l_r034EDP.APRSOL, l_r034EDP.CONINT, l_r034EDP.TOLINT, l_r034EDP.CONREA, l_r034EDP.UTICHV,
			  l_r034EDP.REPONL, l_r034EDP.USARFA, l_r034EDP.CONREE FROM R034EDP
			WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
			  l_r034EDP.VERPRM := 0;
			  l_r034EDP.CONFAI := 0;
			  l_r034EDP.CONADP := 0;
			  l_r034EDP.CONCRE := 0;
			  l_r034EDP.CONIAL := 0;
			  l_r034EDP.TEMALM := 0;
			  l_r034EDP.BLOFAL := 0;
			  l_r034EDP.RECVIS := 0;
			  l_r034EDP.AUTAGV := 0;
			  l_r034EDP.AUTASA := 0;
			  l_r034EDP.AUTEXT := 0;
			  l_r034EDP.USAFRO := 0;
			  l_r034EDP.GRACON := 0;
			  l_r034EDP.CONPAC := 0;
			  l_r034EDP.TEMPAC := 0;
			  l_r034EDP.TOLACP := 0;
			  l_r034EDP.USABIO := 0;
			  l_r034EDP.AUTDBL := 0;
			  l_r034EDP.VERAFA := 0;
			  l_r034EDP.APRSOL := 0;
			  l_r034EDP.CONINT := 0;
			  l_r034EDP.TOLINT := 0;
			  l_r034EDP.CONREA := 0;
			  l_r034EDP.UTICHV := 0;
			  l_r034EDP.REPONL := 0;
			  l_r034EDP.USARFA := 0;
			  l_r034EDP.CONREE := 0;
			  l_graedp := TRUE;
			WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro ao buscar excecoes de definicao de acesso do colaborador.';
		END;
		
		/* BUSCO AS DEFINICOES DE ACESSO DO COLABORADOR */
		BEGIN
			SELECT VERPRM, CONFAI, CONADP, CONCRE, CONIAL, TEMALM, BLOFAL, RECVIS, AUTAGV, AUTASA, AUTEXT, USAFRO, GRACON,
			  CONPAC, TEMPAC, TOLACP, USABIO, AUTDBL, VERAFA, APRSOL, CONINT, TOLINT, CONREA, UTICHV, REPONL, USARFA, CODPRM,
			  PRMFER, PRMSAB, PRMDOM, PRMVIS, CONREE
			INTO l_r034DAC.VERPRM, l_r034DAC.CONFAI, l_r034DAC.CONADP, l_r034DAC.CONCRE, l_r034DAC.CONIAL, l_r034DAC.TEMALM,
			  l_r034DAC.BLOFAL, l_r034DAC.RECVIS, l_r034DAC.AUTAGV, l_r034DAC.AUTASA, l_r034DAC.AUTEXT, l_r034DAC.USAFRO,
			  l_r034DAC.GRACON, l_r034DAC.CONPAC, l_r034DAC.TEMPAC, l_r034DAC.TOLACP, l_r034DAC.USABIO, l_r034DAC.AUTDBL,
			  l_r034DAC.VERAFA, l_r034DAC.APRSOL, l_r034DAC.CONINT, l_r034DAC.TOLINT, l_r034DAC.CONREA, l_r034DAC.UTICHV,
			  l_r034DAC.REPONL, l_r034DAC.USARFA, l_r034DAC.CODPRM, l_r034DAC.PRMFER, l_r034DAC.PRMSAB, l_r034DAC.PRMDOM, 
			  l_r034DAC.PRMVIS, l_r034DAC.CONREE FROM R034DAC
			WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
		EXCEPTION
			WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro ao buscar as definicoes de acesso do colaborador.';
		END;
		
		IF (p_tipope = 'I') OR (p_tipope = 'U') THEN
			/* -- ATRIBUICAO DE PERMISSOES POR LOCAL FISICO/DISPOSITIVO POR POSTO -- */
			FOREACH c_r017PRM INTO l_r017PRM.CODPLT, l_r017PRM.CODRLG, l_r017PRM.VERPLF, l_r017PRM.CODPLF, l_r017PRM.CODDSP
			LOOP			
				/* VERIFICO SE ESTE DISPOSITIVO JÁ ESTÁ ASSOCIADO AO COLABORADOR */
				BEGIN
					SELECT COUNT(1) INTO l_count FROM R034PRM WHERE IDTPES = l_idtcol AND CODDSP = l_r017PRM.CODDSP;
					EXCEPTION
						WHEN NO_DATA_FOUND THEN
							l_count := 0;
						WHEN OTHERS THEN
							RAISERROR 103 'SP_GESPER: Erro no SELECT da R034PRM.';
				END;
		
				/* INSERE REGISTRO NA TABELA R034PRM. */
				IF (l_count = 0) THEN
					IF (l_temAud34PRM > 0) THEN
							SP_RET_REG_AUD(l_codRPA OUT);
							/*Registro mestre do log*/
							INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
		                            VALUES (l_codRPA, 3, 6, 1, 101, 1, l_datatu, l_horatu, 'PROCESSO AUTOMÃ?TICO: PERMISSÃ"ES POR POSTO DE TRABALHO', l_codusu);
																
							/*Campos chave da alteração*/
							INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
							INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
							INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);
							
							/*Campos detalhe da alteração*/
							l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_r017PRM.CODPLT);
							l_CodPltSTR := LTRIM(l_CodPltSTR);
							l_CodPltSTR := RTRIM(l_CodPltSTR);
							
							l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_r017PRM.CODRLG);
							l_CodRlgSTR := LTRIM(l_CodRlgSTR);
							l_CodRlgSTR := RTRIM(l_CodRlgSTR);
							
							l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017PRM.VERPLF);
							l_VerPlfSTR := LTRIM(l_VerPlfSTR);
							l_VerPlfSTR := RTRIM(l_VerPlfSTR);
							
							l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017PRM.CODPLF);
							l_CodPlfSTR := LTRIM(l_CodPlfSTR);
							l_CodPlfSTR := RTRIM(l_CodPlfSTR);
							
							l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, l_r017PRM.CODDSP);
							l_CodDspSTR := LTRIM(l_CodDspSTR);
							l_CodDspSTR := RTRIM(l_CodDspSTR);
							
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', '0');
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'INCLUSÃ’O');
					END IF;
					
					BEGIN
						INSERT INTO R034PRM (IDTPES, CODPLT, CODRLG, VERPLF, CODPLF, CODDSP,
							NUMAMB, NUMEMP, TIPCOL, NUMCAD, ESTPOS, POSTRA,	SEQREG, ORIDEF)
						VALUES  (l_idtcol, l_r017PRM.CODPLT, l_r017PRM.CODRLG, l_r017PRM.VERPLF, l_r017PRM.CODPLF, l_r017PRM.CODDSP,
							0, p_numemp, p_tipcol, p_numcad, p_estpos, p_postra, 0, p_oridef);
						EXCEPTION
							WHEN OTHERS THEN
								RAISERROR 103 'SP_GESPER: Erro ao incluir permissao por local fisico/dispositivo do posto de trabalho para o colaborador.';
					END;
				END IF;
			END LOOP;			
		
			l_coddsp := l_r017PRM.CODDSP;
			l_verplf := l_r017PRM.VERPLF;
			l_codplf := l_r017PRM.CODPLF;
		
			/* BUSCO POR FAIXA */
			FOREACH c_r017FAP INTO l_r017FAP.CODPLT, l_r017FAP.CODRLG, l_r017FAP.CODDSP, l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.INIFAI, l_r017FAP.FIMFAI, l_r017FAP.DIASEM
			LOOP
				/* VERIFICO SE ESTA FAIXA JÁ ESTÁ ASSOCIADA AO COLABORADOR */
				BEGIN				
					SELECT COUNT(1) INTO l_count FROM R034FAP WHERE IDTPES = l_idtcol AND CODPLT = l_r017FAP.CODPLT AND CODRLG = l_r017FAP.CODRLG AND VERPLF = l_r017FAP.VERPLF
					  AND CODPLF = l_r017FAP.CODPLF AND INIFAI = l_r017FAP.INIFAI AND DIASEM = l_r017FAP.DIASEM AND CODDSP = l_r017FAP.CODDSP;
					EXCEPTION
						WHEN NO_DATA_FOUND THEN
							l_count := 0;
						WHEN OTHERS THEN
							RAISERROR 103 'SP_GESPER: Erro no SELECT da R034FAP.';
				END;
			
				/* INSERE REGISTRO NA TABELA R034FAP. */
				IF (l_count = 0) THEN
					BEGIN
						IF (l_temAud34FAP > 0) THEN
							SP_RET_REG_AUD(l_codRPA OUT);
							/*Registro mestre do log*/
							INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
		                            VALUES (l_codRPA, 3, 6, 1, 102, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);
																
							/*Campos chave da alteração*/
							INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
							INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
							INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);
							
							/*Campos detalhe da alteração*/
							l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLT);
							l_CodPltSTR := LTRIM(l_CodPltSTR);
							l_CodPltSTR := RTRIM(l_CodPltSTR);
							
							l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODRLG);
							l_CodRlgSTR := LTRIM(l_CodRlgSTR);
							l_CodRlgSTR := RTRIM(l_CodRlgSTR);
							
							l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.VERPLF);
							l_VerPlfSTR := LTRIM(l_VerPlfSTR);
							l_VerPlfSTR := RTRIM(l_VerPlfSTR);
							
							l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLF);
							l_CodPlfSTR := LTRIM(l_CodPlfSTR);
							l_CodPlfSTR := RTRIM(l_CodPlfSTR);
							
							l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODDSP);
							l_CodDspSTR := LTRIM(l_CodDspSTR);
							l_CodDspSTR := RTRIM(l_CodDspSTR);
							
							l_DiaSemSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.DIASEM);
							l_DiaSemSTR := LTRIM(l_DiaSemSTR);
							l_DiaSemSTR := RTRIM(l_DiaSemSTR);
							
							SP_INTSTR(l_r017FAP.INIFAI,'HH:MM', l_IniFaiSTR OUT);
							
							SP_INTSTR(l_r017FAP.FIMFAI,'HH:MM', l_FimFaiSTR OUT);
							
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIASEM', l_DiaSemSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIFAI', l_IniFaiSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMFAI', l_FimFaiSTR);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
							INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'INCLUSÃ’O');
						END IF;
						
						INSERT INTO R034FAP (IDTPES, CODPLT, CODRLG, NUMAMB, DIASEM, INIFAI, FIMFAI,
							VERPLF, CODPLF, CODDSP, ESTPOS, POSTRA)
						VALUES (l_idtcol, l_r017FAP.CODPLT, l_r017FAP.CODRLG, 0, l_r017FAP.DIASEM, l_r017FAP.INIFAI, l_r017FAP.FIMFAI,
								l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.CODDSP, p_estpos, p_postra);
					EXCEPTION
						WHEN OTHERS THEN
							RAISERROR 103 'SP_GESPER: Erro ao incluir as faixas de acesso da permissao por posto de trabaho para o colaborador.';
					END;
				END IF;
			END LOOP;			
			
			/* BUSCO POR ACOES DA FAIXA - DISPOSITIVO */
			FOREACH c_r017AFD INTO l_r017AFD.CODDSP, l_r017AFD.DIASEM, l_r017AFD.ACOFAI
			LOOP
				/* VERIFICO SE ESTA ACAO DA FAIXA - DISPOSITIVO JAÂ? ESTAÂ? ASSOCIADA AO COLABORADOR */
				BEGIN
					SELECT COUNT(1) INTO l_count FROM R034AFD WHERE IDTPES = l_idtcol AND CODDSP = l_r017AFD.CODDSP AND DIASEM = l_r017AFD.DIASEM;
					EXCEPTION
						WHEN NO_DATA_FOUND THEN
							l_count := 0;
						WHEN OTHERS THEN
							RAISERROR 103 'SP_GESPER: Erro no SELECT da R034AFD.';
				END;
		
				/* INSERE REGISTRO NA TABELA R034AFD. SE JÁ EXISTIR, IGNORAR. */
				IF (l_count = 0) THEN
					BEGIN
						INSERT INTO R034AFD (IDTPES, CODDSP, DIASEM, ACOFAI, ESTPOS, POSTRA)
						VALUES (l_idtcol, l_r017AFD.CODDSP, l_r017AFD.DIASEM, l_r017AFD.ACOFAI, p_estpos, p_postra);
					EXCEPTION
						WHEN OTHERS THEN
							RAISERROR 103 'SP_GESPER: Erro ao incluir acoes por faixa/dispositivo do posto de trabalho para o colaborador.';
					END;
				END IF;
			END LOOP;
		
			/* BUSCO POR ACOES DA FAIXA - LOCAL FISICO */
			FOREACH c_r017AFL INTO l_r017AFL.VERPLF, l_r017AFL.CODPLF, l_r017AFL.DIASEM, l_r017AFL.ACOFAI
			LOOP
				/* VERIFICO SE ESTA ACAO DA FAIXA - LOCAL FISICO JÁ ESTÁ ASSOCIADA AO COLABORADOR */
				BEGIN
					SELECT COUNT(1) INTO l_count FROM R034AFL WHERE IDTPES = l_idtcol AND VERPLF = l_r017AFL.VERPLF AND CODPLF = l_r017AFL.CODPLF AND DIASEM = l_r017AFL.DIASEM;
					EXCEPTION
						WHEN NO_DATA_FOUND THEN
							l_count := 0;
						WHEN OTHERS THEN
							RAISERROR 103 'SP_GESPER: Erro no SELECT da R034AFL.';
				END;
			
				/* INSERE REGISTRO NA TABELA R034AFL. SE JÁ EXISTIR, IGNORAR. */
				IF (l_count = 0) THEN
					BEGIN
						INSERT INTO R034AFL (IDTPES, VERPLF, CODPLF, DIASEM, ACOFAI, ESTPOS, POSTRA)
						VALUES (l_idtcol, l_r017AFL.VERPLF, l_r017AFL.CODPLF, l_r017AFL.DIASEM, l_r017AFL.ACOFAI, p_estpos, p_postra);
					EXCEPTION
						WHEN OTHERS THEN
							RAISERROR 103 'SP_GESPER: Erro ao incluir acoes por faixa/local fisico do posto de trabalho para o colaborador.';
					END;
				END IF;
			END LOOP;
		
			/* -- ATRIBUICAO DE DEFINICAO DE ACESSO POR POSTO -- */
			/* BUSCO AS DEFINICOES DE ACESSO POR POSTO DE TRABALHO, CONFORME POSTO VINDO POR PARAMETRO */
			BEGIN
				SELECT VERPRM, CONFAI, CONADP, CONCRE, CONIAL, TEMALM, BLOFAL, RECVIS, AUTAGV, AUTASA, AUTEXT, USAFRO, GRACON,
				  CONPAC, TEMPAC, TOLACP, USABIO, AUTDBL, VERAFA, APRSOL, CONINT, TOLINT, CONREA, UTICHV, REPONL, USARFA, CODPRM,
				  PRMFER, PRMSAB, PRMDOM, PRMVIS, CONREE
				INTO l_r017DAC.VERPRM, l_r017DAC.CONFAI, l_r017DAC.CONADP, l_r017DAC.CONCRE, l_r017DAC.CONIAL, l_r017DAC.TEMALM,
				  l_r017DAC.BLOFAL, l_r017DAC.RECVIS, l_r017DAC.AUTAGV, l_r017DAC.AUTASA, l_r017DAC.AUTEXT, l_r017DAC.USAFRO,
				  l_r017DAC.GRACON, l_r017DAC.CONPAC, l_r017DAC.TEMPAC, l_r017DAC.TOLACP, l_r017DAC.USABIO, l_r017DAC.AUTDBL,
				  l_r017DAC.VERAFA, l_r017DAC.APRSOL, l_r017DAC.CONINT, l_r017DAC.TOLINT, l_r017DAC.CONREA, l_r017DAC.UTICHV,
				  l_r017DAC.REPONL, l_r017DAC.USARFA, l_r017DAC.CODPRM, l_r017DAC.PRMFER, l_r017DAC.PRMSAB, l_r017DAC.PRMDOM, 
				  l_r017DAC.PRMVIS, l_r017DAC.CONREE 
				FROM R017DAC	  
				WHERE ESTPOS = p_estpos AND POSTRA = p_postra;
			EXCEPTION
				WHEN NO_DATA_FOUND THEN
					l_dacpos := FALSE;
				WHEN OTHERS THEN
					RAISERROR 103 'SP_GESPER: Erro ao buscar as definicoes de acesso por posto de trabalho.';
			END;
			
			IF (l_dacpos = TRUE) THEN /* SE NAO TIVER DEFINICAO DE ACESSO POR POSTO (R017DAC), NAO TENHO O QUE FAZER */
			
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								SP_RET_REG_AUD(l_codRPA OUT);
								/* insere registro mestre - Tabela R995RPA */
								INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
										VALUES (l_codRPA, 3, 6, 1, 80, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SPGESPER: Erro ao inserir registros mestre para a tabela de log de auditoria R995RPA.';
						END;
						BEGIN
								INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
								INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
								INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SPGESPER: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
						END;
				END IF;
			
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVERPRM', l_r034DAC.VERPRM);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (OLDVERPRM)';
						END;
				END IF;
				IF (l_r034EDP.VERPRM <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
					IF (p_oridef = 1) OR (p_oridef = 2 AND l_r017DAC.VERPRM = 'N') THEN /* VERIFICA PERMISSAO = 'N' EH MAIS ABRANGENTE */
						l_r034DAC.VERPRM := l_r017DAC.VERPRM;
						l_r034EDP.VERPRM := p_oridef;
					END IF;
				END IF;
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWVERPRM', l_r034DAC.VERPRM);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (NEWVERPRM)';
						END;
				END IF;
				
				
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								l_ConFaiSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.CONFAI);
								l_ConFaiSTR := LTRIM(l_ConFaiSTR);
								l_ConFaiSTR := RTRIM(l_ConFaiSTR);
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONFAI', l_ConFaiSTR);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (OLDCONFAI)';
						END;
				END IF;
				IF (l_r034EDP.CONFAI <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
					IF (p_oridef = 1) OR (p_oridef = 2 AND l_r017DAC.CONFAI = 0) THEN /* CONTROLA FAIXA HORAÂ?RIA = 0 EH MAIS ABRANGENTE */
						l_r034DAC.CONFAI := l_r017DAC.CONFAI;
						l_r034EDP.CONFAI := p_oridef;
					END IF;
				END IF;
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								l_ConFaiSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.CONFAI);
								l_ConFaiSTR := LTRIM(l_ConFaiSTR);
								l_ConFaiSTR := RTRIM(l_ConFaiSTR);
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONFAI', l_ConFaiSTR);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (NEWCONFAI)';
						END;
				END IF;
				
				
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONADP', l_r034DAC.CONADP);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (OLDCONADP)';
						END;
				END IF;
				IF (l_r034EDP.CONADP <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
					IF (p_oridef = 1) OR (p_oridef = 2 AND l_r017DAC.CONADP = 'N') THEN /* CONTROLA NIVEL E ANTI DUPLA = 'N' EH MAIS ABRANGENTE */
						l_r034DAC.CONADP := l_r017DAC.CONADP;
						l_r034EDP.CONADP := p_oridef;
					END IF;
				END IF;
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONADP', l_r034DAC.CONADP);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (NEWCONADP)';
						END;
				END IF;
		
				
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								l_ConCreSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.CONCRE);
								l_ConCreSTR := LTRIM(l_ConCreSTR);
								l_ConCreSTR := RTRIM(l_ConCreSTR);
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONCRE', l_ConCreSTR);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (OLDCONCRE)';
						END;
				END IF;
				IF (l_r034EDP.CONCRE <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
					IF (p_oridef = 1) OR (p_oridef = 2 AND l_r017DAC.CONCRE = 0) THEN /* CONTROLA CREDITOS DE ACESSO = 0 EH MAIS ABRANGENTE */
						l_r034DAC.CONCRE := l_r017DAC.CONCRE;
						l_r034EDP.CONCRE := p_oridef;
					END IF;
				END IF;
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								l_ConCreSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.CONCRE);
								l_ConCreSTR := LTRIM(l_ConCreSTR);
								l_ConCreSTR := RTRIM(l_ConCreSTR);
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONCRE', l_ConCreSTR);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (NEWCONCRE)';
						END;
				END IF;
				
		
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONIAL', l_r034DAC.CONIAL);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (OLDCONIAL)';
						END;
				END IF;
				IF (l_r034EDP.CONIAL <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
					IF (p_oridef = 1) OR (p_oridef = 2 AND l_r017DAC.CONIAL = 'N') THEN /* CONTROLA INTERVALO ALMOÇO = 'N' EH MAIS ABRANGENTE */
						l_r034DAC.CONIAL := l_r017DAC.CONIAL;
						l_r034EDP.CONIAL := p_oridef;
					END IF;
				END IF;
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONIAL', l_r034DAC.CONIAL);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (NEWCONIAL)';
						END;
				END IF;
				
				
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								l_TemAlmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.TEMALM);
								l_TemAlmSTR := LTRIM(l_TemAlmSTR);
								l_TemAlmSTR := RTRIM(l_TemAlmSTR);
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTEMALM', l_TemAlmSTR);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (OLDTEMALM)';
						END;
				END IF;
				IF (l_r034EDP.TEMALM <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
					IF (p_oridef = 1) THEN /* TEMPO MÍNIMO DE ALMOÇO VEM SOMENTE DO POSTO PRINICPAL */
						l_r034DAC.TEMALM := l_r017DAC.TEMALM;
						l_r034EDP.TEMALM := p_oridef;
					END IF;
				END IF;
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								l_TemAlmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.TEMALM);
								l_TemAlmSTR := LTRIM(l_TemAlmSTR);
								l_TemAlmSTR := RTRIM(l_TemAlmSTR);
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTEMALM', l_TemAlmSTR);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (NEWTEMALM)';
						END;
				END IF;
				
		
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDBLOFAL', l_r034DAC.BLOFAL);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (OLDBLOFAL)';
						END;
				END IF;
				IF (l_r034EDP.BLOFAL <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
					IF (p_oridef = 1) OR (p_oridef = 2 AND l_r017DAC.BLOFAL = 'N') THEN /* BLOQUEIA POR FALTA = 'N' EH MAIS ABRANGENTE */
						l_r034DAC.BLOFAL := l_r017DAC.BLOFAL;
						l_r034EDP.BLOFAL := p_oridef;
					END IF;
				END IF;
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWBLOFAL', l_r034DAC.BLOFAL);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (NEWBLOFAL)';
						END;
				END IF;
		
				
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDRECVIS', l_r034DAC.RECVIS);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (OLDRECVIS)';
						END;
				END IF;
				IF (l_r034EDP.RECVIS <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
					IF (p_oridef = 1) OR (p_oridef = 2 AND l_r017DAC.RECVIS = 'S') THEN /* PODE RECEBER VISITA = 'S' EH MAIS ABRANGENTE */
						l_r034DAC.RECVIS := l_r017DAC.RECVIS;
						l_r034EDP.RECVIS := p_oridef;
					END IF;
				END IF;
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWRECVIS', l_r034DAC.RECVIS);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (NEWRECVIS)';
						END;
				END IF;
		
				
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAUTAGV', l_r034DAC.AUTAGV);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (OLDAUTAGV)';
						END;
				END IF;
				IF (l_r034EDP.AUTAGV <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
					IF (p_oridef = 1) OR (p_oridef = 2 AND l_r017DAC.AUTAGV = 'S') THEN /* AUTORIZA AGENDAMENTO DE VISITA = 'S' EH MAIS ABRANGENTE */
						l_r034DAC.AUTAGV := l_r017DAC.AUTAGV;
						l_r034EDP.AUTAGV := p_oridef;
					END IF;
				END IF;
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAUTAGV', l_r034DAC.AUTAGV);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (NEWAUTAGV)';
						END;
				END IF;
				
		
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAUTASA', l_r034DAC.AUTASA);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (OLDAUTASA)';
						END;
				END IF;
				IF (l_r034EDP.AUTASA <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
					IF (p_oridef = 1) OR (p_oridef = 2 AND l_r017DAC.AUTASA = 'S') THEN /* AUTORIZA SAÍDA DE COLABORADOR = 'S' EH MAIS ABRANGENTE */
						l_r034DAC.AUTASA := l_r017DAC.AUTASA;
						l_r034EDP.AUTASA := p_oridef;
					END IF;
				END IF;
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAUTASA', l_r034DAC.AUTASA);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (NEWAUTASA)';
						END;
				END IF;
				
		
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAUTEXT', l_r034DAC.AUTEXT);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (OLDAUTEXT)';
						END;
				END IF;
				IF (l_r034EDP.AUTEXT <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
					IF (p_oridef = 1) OR (p_oridef = 2 AND l_r017DAC.AUTEXT = 'S') THEN /* AUTORIZA HORA EXTRA = 'S' EH MAIS ABRANGENTE */
						l_r034DAC.AUTEXT := l_r017DAC.AUTEXT;
						l_r034EDP.AUTEXT := p_oridef;
					END IF;
				END IF;
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAUTEXT', l_r034DAC.AUTEXT);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (NEWAUTEXT)';
