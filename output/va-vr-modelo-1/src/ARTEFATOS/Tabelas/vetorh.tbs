                       :NEW.DATVAL,
                       :NEW.HORVAL,
                       :NEW.NOMOEM,
                       NULL,  /*:NEW.DDITEL,*/
                       NULL,  /*:NEW.DDDTEL,*/
                       NULL,  /*:NEW.TELCON,*/
                       l_DesPor,
                       l_NomEmp,
                       l_NomFun,
                       NULL,  /* DDI Visitado */
                       NULL,  /* DDD Visitado */
                       NULL,  /* Fone do Visitado */
                       NULL,  /* SituacaoWAV */
                       NULL, /* TIPDOC */
                       '', /* Desc. TipDoc*/
                       '', /* NUMDOC */
                       NULL, /* TIPVIS */
                       '', /* NomTIPVIS */
                       NULL, /* CODPOR */
                       NULL, /* CODPRM */
                       '', /* DESPRM */
                       '', /* PLAVEI*/
                       '', /* NomAut */
                       '', /* OBSVIS */
                       '', /* NomSol */
                       NULL, /* EmaSol */
                       NULL, /* DATSAG */
                       NULL, /* HORSAG */
                       '', /* NOMUSU */
                       NULL, /* DATPSA */
                       NULL, /* HORPSA */
                       '' /* OBSREP */
                       );
      END IF;

      /* Envio Confirmacao Agendamento ao Visitante - SMS */
      IF (l_EnvAge = 2) OR (l_EnvAge = 9) THEN
        R115NOT_ATUNOT(2, 
                       l_LocAGV,
                       :NEW.NOMVIS,
                       NULL, /*:NEW.EMAVIS,*/
                       :NEW.DATPRV,
                       :NEW.HORPRV,
                       :NEW.DATVAL,
                       :NEW.HORVAL,
                       :NEW.NOMOEM,
                       :NEW.DDITEL, 
                       :NEW.DDDTEL, 
                       :NEW.TELCON,
                       l_DesPor,
                       l_NomEmp,
                       l_NomFun,        
                       NULL,  /* DDI Visitado */
                       NULL,  /* DDD Visitado */
                       NULL,  /* Fone do Visitado */
                       NULL,  /* SituacaoWAV */
                       NULL, /* TIPDOC */
                       '', /* Desc. TipDoc*/
                       '', /* NUMDOC */
                       NULL, /* TIPVIS */
                       '', /* NomTIPVIS */
                       NULL, /* CODPOR */
                       NULL, /* CODPRM */
                       '', /* DESPRM */
                       '', /* PLAVEI*/
                       '', /* NomAut */
                       '', /* OBSVIS */
                       '', /* NomSol */
                       NULL, /* EmaSol */
                       NULL, /* DATSAG */
                       NULL, /* HORSAG */
                       '', /* NOMUSU */
                       NULL, /* DATPSA */
                       NULL, /* HORPSA */
                       '' /* OBSREP */
                       );    
      END IF;
    END IF;
  END IF;

  /* NOTIFICACAO DE AGENDAMENTO PENDENTE DE AUTORIZACAO - E-MAIL E SMS */
  IF (:NEW.STAWAV = 0) AND (:NEW.TipVis IS NOT NULL) THEN
  
    BEGIN
      SELECT NOTCOL INTO l_EnvAge FROM R070DAC;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;

    BEGIN
      SELECT R030EMP.NomEmp INTO l_NomEmp FROM R030EMP WHERE R030EMP.NUMEMP = :NEW.EMPAUT;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;
    
    BEGIN
      SELECT R034FUN.NomFun INTO l_NomAut FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.EMPAUT AND R034FUN.TIPCOL = :NEW.TCLAUT AND R034FUN.NUMCAD = :NEW.CADAUT;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;
          
    BEGIN
      SELECT R034CPL.EmaCom
      INTO l_EmaAut
      FROM R034CPL
      WHERE R034CPL.NUMEMP = :NEW.EMPAUT AND R034CPL.TIPCOL = :NEW.TCLAUT AND R034CPL.NUMCAD = :NEW.CADAUT;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;
          
    /* EMAIL ou AMBOS */
    IF (l_EnvAge = 1) OR (l_EnvAge = 9) THEN
            R115NOT_ATUNOT(7, 
                           l_LocAGV,
                           '',
                           '',
                           NULL,
                           NULL,
                           NULL,
                           NULL,
                           '',
                           NULL,
                           NULL,
                           NULL,
                           '',
                           l_NomEmp,
                           '',       
                           NULL,
                           NULL,
                           NULL,
                           '',    /* SituacaoWAV */
                           NULL,
                           '',
                           '',
                           NULL,
                           '',
                           NULL,
                           NULL,
                           '',
                           '',
                           '',
                           '',
                           '',
                           l_EmaAut, /* Email Aprovador*/
                           NULL,
                           NULL,
                           '',
                           NULL,
                           NULL,
                           ''
                           );
    END IF;  /* IF (l_EnvAge = 1) OR (l_EnvAge = 9) */
          
    /* SMS ou AMBOS */
    IF (l_EnvAge = 2) OR (l_EnvAge = 9) THEN
        
          BEGIN
            SELECT R034CPL.NmDdi2, R034CPL.NmDdd2, R034CPL.NmTel2
            INTO l_DDITelAut, l_DDDTelAut, l_TelConAut
            FROM R034CPL
            WHERE R034CPL.NUMEMP = :NEW.EMPAUT AND R034CPL.TIPCOL = :NEW.TCLAUT AND R034CPL.NUMCAD = :NEW.CADAUT;
          EXCEPTION
            WHEN OTHERS THEN NULL;
          END;

          R115NOT_ATUNOT(8, 
                         l_LocAGV,
                         '',
                         '',
                         NULL,
                         NULL,
                         NULL,
                         NULL,
                         '',
                         NULL,
                         NULL,
                         NULL,
                         '',
                         l_NomEmp,
                         '',       
                         l_DDITelAut,  /* DDI Aprovador */
                         l_DDDTelAut,  /* DDD Aprovador */
                         l_TelConAut,  /* Fone do Aprovador */
                         '',  /* SituacaoWAV */
                         NULL,
                         '',
                         '',
                         NULL,
                         '',
                         NULL,
                         NULL,
                         '',
                         '',
                         '',
                         '',
                         '',
                         NULL,
                         NULL,
                         NULL,
                         '',
                         NULL,
                         NULL,
                         ''
                       );
    END IF;  /* IF (l_EnvAge = 2) OR (l_EnvAge = 9) */

  END IF;
  
  /* ATUALIZO O LOCAGV. NO ORACLE, POSSO ATUALIZAR DIRETO O :NEW.LOCAGV. NO SQL SERVER, PRECISO DAR UM UPDATE */
  /* ORACLE*/
  /*:NEW.LOCAGV := l_LocAGV;*/

  /* SQL-SERVER ---> */
  UPDATE R090AGV SET LOCAGV = l_LocAGV WHERE DATPRV = :NEW.DATPRV AND HORPRV = :NEW.HORPRV AND NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD AND SEQAGV = :NEW.SEQAGV;
END␀İ␀␀		SENIOR;0P

TRIGGER R090AGV_EU AFTER UPDATE ON R090AGV FOR EACH ROW
BEGIN
  NULL;
END		SENIOR;20Ô5␀␀

TRIGGER R090AGV_EU AFTER UPDATE ON R090AGV FOR EACH ROW
DECLARE
l_UsaTAA       VARCHAR(1);
  l_EnvAge       NUMBER(1);
  l_DesPor       VARCHAR2(20);
  l_NomEmp       VARCHAR2(40);
  l_NomFun       VARCHAR2(40);
  l_SituacaoWAV  VARCHAR2(40);
  l_NomTIPVIS    VARCHAR2(40);
  l_DesPrm       VARCHAR2(40);
  l_NomAut       VARCHAR2(40);
  l_NomSol       VARCHAR2(40);
  l_EmaSol       VARCHAR2(100);
  l_NomUsu       VARCHAR2(255);
  l_DesDoc       VARCHAR2(20);
  l_DDITelFun    NUMBER(3);
  l_DDDTelFun    NUMBER(3);
  l_TelConFun    VARCHAR2(20);
  l_TemNot    NUMBER(1);
BEGIN
  /* IMPORTANTE: O LOCAGV É ATRIBUÍDO NA TRIGGER R090AGV_BU */

  /* nao pode ser considerado o LOCAGV pois o INSERT */
  IF (:NEW.NOMVIS <> :OLD.NOMVIS) OR (:NEW.TIPVIS <> :OLD.TIPVIS) OR (:NEW.CODPRM <> :OLD.CODPRM) OR
     (:NEW.DATVAL <> :OLD.DATVAL) OR (:NEW.HORVAL <> :OLD.HORVAL) OR
     (:NEW.CODPOR <> :OLD.CODPOR) OR (:NEW.CODNAC <> :OLD.CODNAC) OR (:NEW.OBSVIS <> :OLD.OBSVIS) OR
     (:NEW.CODOEM <> :OLD.CODOEM) OR (:NEW.NOMOEM <> :OLD.NOMOEM) OR
     (:NEW.DDITEL <> :OLD.DDITEL) OR (:NEW.DDDTEL <> :OLD.DDDTEL) OR 
     (:NEW.TELCON <> :OLD.TELCON) OR (:NEW.EMAVIS <> :OLD.EMAVIS) OR 
     (:NEW.EMPAUT <> :OLD.EMPAUT) OR (:NEW.TCLAUT <> :OLD.TCLAUT) OR (:NEW.CADAUT <> :OLD.CADAUT) OR 
     (:NEW.STAWAV <> :OLD.STAWAV) THEN

      SP_PEND86('2', :NEW.DATPRV, :NEW.HORPRV, :NEW.SEQAGV, :NEW.NUMEMP, :NEW.TIPCOL,
                 :NEW.NUMCAD, :NEW.TIPDOC, :NEW.NUMDOC, :NEW.NOMVIS, :NEW.TIPVIS, :NEW.CODPRM,
                 :NEW.DATVAL, :NEW.HORVAL,:NEW.CODPOR,
                 :NEW.CODNAC, :NEW.OBSVIS, :NEW.CODOEM, :NEW.NOMOEM, :NEW.DDITEL, :NEW.DDDTEL, :NEW.TELCON, :NEW.EMAVIS,
                 :NEW.LOCAGV, :NEW.EMPAUT, :NEW.TCLAUT, :NEW.CADAUT, :NEW.STAWAV, :NEW.VERPLF, :NEW.CODPLF, :NEW.VISEFE);
  END IF;

  IF (:NEW.TipVis IS NOT NULL) THEN

    BEGIN
      SELECT UsaTAA, EnvAge, DESVIS INTO l_UsaTAA, l_EnvAge, l_NomTIPVIS FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_UsaTAA := 'N';
      WHEN OTHERS THEN NULL;
    END;

    /* SE JA EXISTE NOTIFICACAO TIPOS 1 E 2 GERADA PARA ESTE AGENDAMENTO DE VISITA, NAO GERO NOVAMENTE */
    BEGIN
      SELECT COUNT(CODORI) INTO l_TemNot FROM R115NOT WHERE :NEW.LOCAGV <> 0 AND CODORI = :NEW.LOCAGV AND TIPNOT IN (1, 2);
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_TemNot := 0;
      WHEN OTHERS THEN l_TemNot := 0;
    END;

	/* NOTIFICACAO DE AGENDAMENTO DE VISITA CRIADO - AO VISITANTE - TERMINAL DE AUTOATENDIMENTO */
    IF (:NEW.STAWAV = 1) AND (l_TemNot = 0) THEN

      IF (l_UsaTAA = 'S') AND (l_EnvAge > 0) THEN
        BEGIN
          SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R030EMP.NomEmp INTO l_NomEmp FROM R030EMP WHERE R030EMP.NUMEMP = :NEW.NUMEMP;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R034FUN.NomFun INTO l_NomFun FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.NUMEMP AND R034FUN.TIPCOL = :NEW.TIPCOL AND R034FUN.NUMCAD = :NEW.NUMCAD;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        /* Envio Confirmacao Agendamento ao Visitante - email */
        IF (l_EnvAge = 1) OR (l_EnvAge = 9) THEN
          R115NOT_ATUNOT(1, 
                         :NEW.LOCAGV,
                         :NEW.NOMVIS,
                         :NEW.EMAVIS,
                         :NEW.DATPRV,
                         :NEW.HORPRV,
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         :NEW.DDITEL, 
                         :NEW.DDDTEL, 
                         :NEW.TELCON,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,        
                         NULL,  /* DDI Visitado */
                         NULL,  /* DDD Visitado */
                         NULL,  /* Fone do Visitado */
                         NULL,  /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         NULL, /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );    
        END IF;

        /* Envio Confirmacao Agendamento ao Visitante - SMS */
        IF (l_EnvAge = 2) OR (l_EnvAge = 9) THEN
          R115NOT_ATUNOT(2, 
                         :NEW.LOCAGV,
                         :NEW.NOMVIS,
                         :NEW.EMAVIS,
                         :NEW.DATPRV,
                         :NEW.HORPRV,
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         :NEW.DDITEL, 
                         :NEW.DDDTEL, 
                         :NEW.TELCON,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,        
                         NULL,  /* DDI Visitado */
                         NULL,  /* DDD Visitado */
                         NULL,  /* Fone do Visitado */
                         NULL,  /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         NULL, /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );    
        END IF;
      END IF; /* IF (l_UsaTAA = 'S') AND (l_EnvAge > 0) THEN */
    END IF; /* FIM DA NOTIFICACAO DE AGENDAMENTO DE VISITA CRIADO - AO VISITANTE - TERMINAL DE AUTOATENDIMENTO */

    /* SE JA EXISTE NOTIFICACAO TIPOS 5 E 6 GERADA PARA ESTE AGENDAMENTO DE VISITA, NAO GERO NOVAMENTE */
    BEGIN
      SELECT COUNT(CODORI) INTO l_TemNot FROM R115NOT WHERE :NEW.LOCAGV <> 0 AND CODORI = :NEW.LOCAGV AND TIPNOT IN (5, 6);
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_TemNot := 0;
      WHEN OTHERS THEN l_TemNot := 0;
    END;

	/* NOTIFICACAO DE CONFIRMACAO DO AGENDAMENTO PELO AUTORIZADOR (1- AUTORIZADO E 2-NAO AUTORIZADO) - E-MAIL E SMS */
    IF (:OLD.STAWAV = 0) AND (:NEW.STAWAV >= 1) AND (l_TemNot = 0) THEN

      BEGIN
        SELECT NOTCOL INTO l_EnvAge FROM R070DAC;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      BEGIN
        SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      BEGIN
        SELECT R030EMP.NomEmp INTO l_NomEmp FROM R030EMP WHERE R030EMP.NUMEMP = :NEW.EMPSOL;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
      
      BEGIN
        SELECT DESPRM INTO l_DesPrm FROM R058PRM WHERE CODPRM = :NEW.CODPRM;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
      
      IF :NEW.STAWAV = 1 THEN 
        l_SituacaoWAV := 'AUTORIZADO';
      ELSIF :NEW.STAWAV = 2 THEN
        l_SituacaoWAV := 'NÃO AUTORIZADO';
      END IF;
      
      IF :NEW.TIPDOC = 1 THEN
        l_DesDoc := 'Identidade';
      ELSIF :NEW.TIPDOC = 2 THEN
        l_DesDoc := 'CPF';
      ELSIF :NEW.TIPDOC = 3 THEN
        l_DesDoc := 'CNH';
      ELSIF :NEW.TIPDOC = 4 THEN
        l_DesDoc := 'Passaporte';
      ELSIF :NEW.TIPDOC = 5 THEN
        l_DesDoc := 'Outros';
      ELSIF :NEW.TIPDOC = 6 THEN
        l_DesDoc := 'Sem Documento';
      END IF;
      
      BEGIN
        SELECT R034FUN.NomFun INTO l_NomAut FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.EMPAUT AND R034FUN.TIPCOL = :NEW.TCLAUT AND R034FUN.NUMCAD = :NEW.CADAUT;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
          
      BEGIN
        SELECT R034FUN.NomFun INTO l_NomSol FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.EMPSOL AND R034FUN.TIPCOL = :NEW.TCLSOL AND R034FUN.NUMCAD = :NEW.CADSOL;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      BEGIN
        SELECT NOMUSU INTO l_NomUsu FROM R999USU WHERE CODUSU = :NEW.CODUPS;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
        
      BEGIN
        SELECT R034CPL.EmaCom
        INTO l_EmaSol
        FROM R034CPL
        WHERE R034CPL.NUMEMP = :NEW.EMPSOL AND R034CPL.TIPCOL = :NEW.TCLSOL AND R034CPL.NUMCAD = :NEW.CADSOL;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
          
      /* EMAIL ou AMBOS */
      IF (l_EnvAge = 1) OR (l_EnvAge = 9) THEN
            R115NOT_ATUNOT(5, 
                           :NEW.LOCAGV,
                           :NEW.NOMVIS,
                           :NEW.EMAVIS,
                           :NEW.DATPRV,
                           :NEW.HORPRV,
                           :NEW.DATVAL,
                           :NEW.HORVAL,
                           :NEW.NOMOEM,
                           :NEW.DDITEL,
                           :NEW.DDDTEL,
                           :NEW.TELCON,
                           l_DesPor,
                           l_NomEmp,
                           l_NomFun,       
                           NULL,  /* DDI Visitado */
                           NULL,  /* DDD Visitado */
                           NULL,  /* Fone do Visitado */
                           l_SituacaoWAV,  /* SituacaoWAV */
                           :NEW.TIPDOC,
                           l_DesDoc,
                           :NEW.NUMDOC,
                           :NEW.TIPVIS,
                           l_NomTIPVIS,
                           :NEW.CODPOR,
                           :NEW.CODPRM,
                           l_DesPrm,
                           :NEW.PLAVEI,
                           l_NomAut,
                           :NEW.OBSVIS,
                           l_NomSol,
                           l_EmaSol,
                           :NEW.DATSAG,
                           :NEW.HORSAG,
                           l_NomUsu,
                           :NEW.DATPSA,
                           :NEW.HORPSA,
                           :NEW.OBSREP
                           );
      END IF;  /* IF (l_EnvAge = 1) OR (l_EnvAge = 9) */
          
      /* SMS ou AMBOS */
      IF (l_EnvAge = 2) OR (l_EnvAge = 9) THEN
        
          BEGIN
            SELECT R034CPL.NmDdi2, R034CPL.NmDdd2, R034CPL.NmTel2
            INTO l_DDITelFun, l_DDDTelFun, l_TelConFun
            FROM R034CPL
            WHERE R034CPL.NUMEMP = :NEW.EMPSOL AND R034CPL.TIPCOL = :NEW.TCLSOL AND R034CPL.NUMCAD = :NEW.CADSOL;
          EXCEPTION
            WHEN OTHERS THEN NULL;
          END;

          R115NOT_ATUNOT(6, 
                         :NEW.LOCAGV,
                         :NEW.NOMVIS,
                         :NEW.EMAVIS,
                         :NEW.DATPRV,
                         :NEW.HORPRV,
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         :NEW.DDITEL,
                         :NEW.DDDTEL,
                         :NEW.TELCON,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,       
                         l_DDITelFun,  /* DDI Solicitante */
                         l_DDDTelFun,  /* DDD Solicitante */
                         l_TelConFun,  /* Fone do Solicitante */
                         l_SituacaoWAV,  /* SituacaoWAV */
                         :NEW.TIPDOC,
                         l_DesDoc,
                         :NEW.NUMDOC,
                         :NEW.TIPVIS,
                         l_NomTIPVIS,
                         :NEW.CODPOR,
                         :NEW.CODPRM,
                         l_DesPrm,
                         :NEW.PLAVEI,
                         l_NomAut,
                         :NEW.OBSVIS,
                         l_NomSol,
                         '',
                         :NEW.DATSAG,
                         :NEW.HORSAG,
                         l_NomUsu,
                         :NEW.DATPSA,
                         :NEW.HORPSA,
                         :NEW.OBSREP
                         );
      END IF;  /* IF (l_EnvAge = 2) OR (l_EnvAge = 9) */
      
    END IF; /* FIM DA NOTIFICACAO DE CONFIRMACAO DO AGENDAMENTO PELO AUTORIZADOR (1- AUTORIZADO E 2-NAO AUTORIZADO) - E-MAIL E SMS */
  END IF; /* IF (:NEW.TipVis IS NOT NULL) THEN */
END		SENIOR;22Ô5␀␀

TRIGGER R090AGV_EU AFTER UPDATE ON R090AGV FOR EACH ROW
DECLARE
l_UsaTAA       VARCHAR(1);
  l_EnvAge       NUMBER(1);
  l_DesPor       VARCHAR2(20);
  l_NomEmp       VARCHAR2(40);
  l_NomFun       VARCHAR2(40);
  l_SituacaoWAV  VARCHAR2(40);
  l_NomTIPVIS    VARCHAR2(40);
  l_DesPrm       VARCHAR2(40);
  l_NomAut       VARCHAR2(40);
  l_NomSol       VARCHAR2(40);
  l_EmaSol       VARCHAR2(100);
  l_NomUsu       VARCHAR2(255);
  l_DesDoc       VARCHAR2(20);
  l_DDITelFun    NUMBER(3);
  l_DDDTelFun    NUMBER(3);
  l_TelConFun    VARCHAR2(20);
  l_TemNot    NUMBER(1);
BEGIN
  /* IMPORTANTE: O LOCAGV É ATRIBUÍDO NA TRIGGER R090AGV_BU */

  /* nao pode ser considerado o LOCAGV pois o INSERT */
  IF (:NEW.NOMVIS <> :OLD.NOMVIS) OR (:NEW.TIPVIS <> :OLD.TIPVIS) OR (:NEW.CODPRM <> :OLD.CODPRM) OR
     (:NEW.DATVAL <> :OLD.DATVAL) OR (:NEW.HORVAL <> :OLD.HORVAL) OR
     (:NEW.CODPOR <> :OLD.CODPOR) OR (:NEW.CODNAC <> :OLD.CODNAC) OR (:NEW.OBSVIS <> :OLD.OBSVIS) OR
     (:NEW.CODOEM <> :OLD.CODOEM) OR (:NEW.NOMOEM <> :OLD.NOMOEM) OR
     (:NEW.DDITEL <> :OLD.DDITEL) OR (:NEW.DDDTEL <> :OLD.DDDTEL) OR 
     (:NEW.TELCON <> :OLD.TELCON) OR (:NEW.EMAVIS <> :OLD.EMAVIS) OR 
     (:NEW.EMPAUT <> :OLD.EMPAUT) OR (:NEW.TCLAUT <> :OLD.TCLAUT) OR (:NEW.CADAUT <> :OLD.CADAUT) OR 
     (:NEW.STAWAV <> :OLD.STAWAV) THEN

      SP_PEND86('2', :NEW.DATPRV, :NEW.HORPRV, :NEW.SEQAGV, :NEW.NUMEMP, :NEW.TIPCOL,
                 :NEW.NUMCAD, :NEW.TIPDOC, :NEW.NUMDOC, :NEW.NOMVIS, :NEW.TIPVIS, :NEW.CODPRM,
                 :NEW.DATVAL, :NEW.HORVAL,:NEW.CODPOR,
                 :NEW.CODNAC, :NEW.OBSVIS, :NEW.CODOEM, :NEW.NOMOEM, :NEW.DDITEL, :NEW.DDDTEL, :NEW.TELCON, :NEW.EMAVIS,
                 :NEW.LOCAGV, :NEW.EMPAUT, :NEW.TCLAUT, :NEW.CADAUT, :NEW.STAWAV, :NEW.VERPLF, :NEW.CODPLF, :NEW.VISEFE);
  END IF;

  IF (:NEW.TipVis IS NOT NULL) THEN

    BEGIN
      SELECT UsaTAA, EnvAge, DESVIS INTO l_UsaTAA, l_EnvAge, l_NomTIPVIS FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_UsaTAA := 'N';
      WHEN OTHERS THEN NULL;
    END;

    /* SE JA EXISTE NOTIFICACAO TIPOS 1 E 2 GERADA PARA ESTE AGENDAMENTO DE VISITA, NAO GERO NOVAMENTE */
    BEGIN
      SELECT COUNT(CODORI) INTO l_TemNot FROM R115NOT WHERE :NEW.LOCAGV <> 0 AND CODORI = :NEW.LOCAGV AND TIPNOT IN (1, 2);
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_TemNot := 0;
      WHEN OTHERS THEN l_TemNot := 0;
    END;

	/* NOTIFICACAO DE AGENDAMENTO DE VISITA CRIADO - AO VISITANTE - TERMINAL DE AUTOATENDIMENTO */
    IF (:NEW.STAWAV = 1) AND (l_TemNot = 0) THEN

      IF (l_UsaTAA = 'S') AND (l_EnvAge > 0) THEN
        BEGIN
          SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R030EMP.NomEmp INTO l_NomEmp FROM R030EMP WHERE R030EMP.NUMEMP = :NEW.NUMEMP;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R034FUN.NomFun INTO l_NomFun FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.NUMEMP AND R034FUN.TIPCOL = :NEW.TIPCOL AND R034FUN.NUMCAD = :NEW.NUMCAD;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        /* Envio Confirmacao Agendamento ao Visitante - email */
        IF (l_EnvAge = 1) OR (l_EnvAge = 9) THEN
          R115NOT_ATUNOT(1, 
                         :NEW.LOCAGV,
                         :NEW.NOMVIS,
                         :NEW.EMAVIS,
                         :NEW.DATPRV,
                         :NEW.HORPRV,
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         :NEW.DDITEL, 
                         :NEW.DDDTEL, 
                         :NEW.TELCON,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,        
                         NULL,  /* DDI Visitado */
                         NULL,  /* DDD Visitado */
                         NULL,  /* Fone do Visitado */
                         NULL,  /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         NULL, /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );    
        END IF;

        /* Envio Confirmacao Agendamento ao Visitante - SMS */
        IF (l_EnvAge = 2) OR (l_EnvAge = 9) THEN
          R115NOT_ATUNOT(2, 
                         :NEW.LOCAGV,
                         :NEW.NOMVIS,
                         :NEW.EMAVIS,
                         :NEW.DATPRV,
                         :NEW.HORPRV,
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         :NEW.DDITEL, 
                         :NEW.DDDTEL, 
                         :NEW.TELCON,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,        
                         NULL,  /* DDI Visitado */
                         NULL,  /* DDD Visitado */
                         NULL,  /* Fone do Visitado */
                         NULL,  /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         NULL, /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );    
        END IF;
      END IF; /* IF (l_UsaTAA = 'S') AND (l_EnvAge > 0) THEN */
    END IF; /* FIM DA NOTIFICACAO DE AGENDAMENTO DE VISITA CRIADO - AO VISITANTE - TERMINAL DE AUTOATENDIMENTO */

    /* SE JA EXISTE NOTIFICACAO TIPOS 5 E 6 GERADA PARA ESTE AGENDAMENTO DE VISITA, NAO GERO NOVAMENTE */
    BEGIN
      SELECT COUNT(CODORI) INTO l_TemNot FROM R115NOT WHERE :NEW.LOCAGV <> 0 AND CODORI = :NEW.LOCAGV AND TIPNOT IN (5, 6);
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_TemNot := 0;
      WHEN OTHERS THEN l_TemNot := 0;
    END;

	/* NOTIFICACAO DE CONFIRMACAO DO AGENDAMENTO PELO AUTORIZADOR (1- AUTORIZADO E 2-NAO AUTORIZADO) - E-MAIL E SMS */
    IF (:OLD.STAWAV = 0) AND (:NEW.STAWAV >= 1) AND (l_TemNot = 0) THEN

      BEGIN
        SELECT NOTCOL INTO l_EnvAge FROM R070DAC;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      BEGIN
        SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      BEGIN
        SELECT R030EMP.NomEmp INTO l_NomEmp FROM R030EMP WHERE R030EMP.NUMEMP = :NEW.EMPSOL;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
      
      BEGIN
        SELECT DESPRM INTO l_DesPrm FROM R058PRM WHERE CODPRM = :NEW.CODPRM;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
      
      IF :NEW.STAWAV = 1 THEN 
        l_SituacaoWAV := 'AUTORIZADO';
      ELSIF :NEW.STAWAV = 2 THEN
        l_SituacaoWAV := 'NÃO AUTORIZADO';
      END IF;
      
      IF :NEW.TIPDOC = 1 THEN
        l_DesDoc := 'Identidade';
      ELSIF :NEW.TIPDOC = 2 THEN
        l_DesDoc := 'CPF';
      ELSIF :NEW.TIPDOC = 3 THEN
        l_DesDoc := 'CNH';
      ELSIF :NEW.TIPDOC = 4 THEN
        l_DesDoc := 'Passaporte';
      ELSIF :NEW.TIPDOC = 5 THEN
        l_DesDoc := 'Outros';
      ELSIF :NEW.TIPDOC = 6 THEN
        l_DesDoc := 'Sem Documento';
      END IF;
      
      BEGIN
        SELECT R034FUN.NomFun INTO l_NomAut FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.EMPAUT AND R034FUN.TIPCOL = :NEW.TCLAUT AND R034FUN.NUMCAD = :NEW.CADAUT;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
          
      BEGIN
        SELECT R034FUN.NomFun INTO l_NomSol FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.EMPSOL AND R034FUN.TIPCOL = :NEW.TCLSOL AND R034FUN.NUMCAD = :NEW.CADSOL;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      BEGIN
        SELECT NOMUSU INTO l_NomUsu FROM R999USU WHERE CODUSU = :NEW.CODUPS;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
        
      BEGIN
        SELECT R034CPL.EmaCom
        INTO l_EmaSol
        FROM R034CPL
        WHERE R034CPL.NUMEMP = :NEW.EMPSOL AND R034CPL.TIPCOL = :NEW.TCLSOL AND R034CPL.NUMCAD = :NEW.CADSOL;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
          
      /* EMAIL ou AMBOS */
      IF (l_EnvAge = 1) OR (l_EnvAge = 9) THEN
            R115NOT_ATUNOT(5, 
                           :NEW.LOCAGV,
                           :NEW.NOMVIS,
                           :NEW.EMAVIS,
                           :NEW.DATPRV,
                           :NEW.HORPRV,
                           :NEW.DATVAL,
                           :NEW.HORVAL,
                           :NEW.NOMOEM,
                           :NEW.DDITEL,
                           :NEW.DDDTEL,
                           :NEW.TELCON,
                           l_DesPor,
                           l_NomEmp,
                           l_NomFun,       
                           NULL,  /* DDI Visitado */
                           NULL,  /* DDD Visitado */
                           NULL,  /* Fone do Visitado */
                           l_SituacaoWAV,  /* SituacaoWAV */
                           :NEW.TIPDOC,
                           l_DesDoc,
                           :NEW.NUMDOC,
                           :NEW.TIPVIS,
                           l_NomTIPVIS,
                           :NEW.CODPOR,
                           :NEW.CODPRM,
                           l_DesPrm,
                           :NEW.PLAVEI,
                           l_NomAut,
                           :NEW.OBSVIS,
                           l_NomSol,
                           l_EmaSol,
                           :NEW.DATSAG,
                           :NEW.HORSAG,
                           l_NomUsu,
                           :NEW.DATPSA,
                           :NEW.HORPSA,
                           :NEW.OBSREP
                           );
      END IF;  /* IF (l_EnvAge = 1) OR (l_EnvAge = 9) */
          
      /* SMS ou AMBOS */
      IF (l_EnvAge = 2) OR (l_EnvAge = 9) THEN
        
          BEGIN
            SELECT R034CPL.NmDdi2, R034CPL.NmDdd2, R034CPL.NmTel2
            INTO l_DDITelFun, l_DDDTelFun, l_TelConFun
            FROM R034CPL
            WHERE R034CPL.NUMEMP = :NEW.EMPSOL AND R034CPL.TIPCOL = :NEW.TCLSOL AND R034CPL.NUMCAD = :NEW.CADSOL;
          EXCEPTION
            WHEN OTHERS THEN NULL;
          END;

          R115NOT_ATUNOT(6, 
                         :NEW.LOCAGV,
                         :NEW.NOMVIS,
                         :NEW.EMAVIS,
                         :NEW.DATPRV,
                         :NEW.HORPRV,
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         :NEW.DDITEL,
                         :NEW.DDDTEL,
                         :NEW.TELCON,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,       
                         l_DDITelFun,  /* DDI Solicitante */
                         l_DDDTelFun,  /* DDD Solicitante */
                         l_TelConFun,  /* Fone do Solicitante */
                         l_SituacaoWAV,  /* SituacaoWAV */
                         :NEW.TIPDOC,
                         l_DesDoc,
                         :NEW.NUMDOC,
                         :NEW.TIPVIS,
                         l_NomTIPVIS,
                         :NEW.CODPOR,
                         :NEW.CODPRM,
                         l_DesPrm,
                         :NEW.PLAVEI,
                         l_NomAut,
                         :NEW.OBSVIS,
                         l_NomSol,
                         '',
                         :NEW.DATSAG,
                         :NEW.HORSAG,
                         l_NomUsu,
                         :NEW.DATPSA,
                         :NEW.HORPSA,
                         :NEW.OBSREP
                         );
      END IF;  /* IF (l_EnvAge = 2) OR (l_EnvAge = 9) */
      
    END IF; /* FIM DA NOTIFICACAO DE CONFIRMACAO DO AGENDAMENTO PELO AUTORIZADOR (1- AUTORIZADO E 2-NAO AUTORIZADO) - E-MAIL E SMS */
  END IF; /* IF (:NEW.TipVis IS NOT NULL) THEN */
END		SENIOR;21Ô5␀␀

TRIGGER R090AGV_EU AFTER UPDATE ON R090AGV FOR EACH ROW
DECLARE
l_UsaTAA       VARCHAR(1);
  l_EnvAge       NUMBER(1);
  l_DesPor       VARCHAR2(20);
  l_NomEmp       VARCHAR2(40);
  l_NomFun       VARCHAR2(40);
  l_SituacaoWAV  VARCHAR2(40);
  l_NomTIPVIS    VARCHAR2(40);
  l_DesPrm       VARCHAR2(40);
  l_NomAut       VARCHAR2(40);
  l_NomSol       VARCHAR2(40);
  l_EmaSol       VARCHAR2(100);
  l_NomUsu       VARCHAR2(255);
  l_DesDoc       VARCHAR2(20);
  l_DDITelFun    NUMBER(3);
  l_DDDTelFun    NUMBER(3);
  l_TelConFun    VARCHAR2(20);
  l_TemNot    NUMBER(1);
BEGIN
  /* IMPORTANTE: O LOCAGV É ATRIBUÍDO NA TRIGGER R090AGV_BU */

  /* nao pode ser considerado o LOCAGV pois o INSERT */
  IF (:NEW.NOMVIS <> :OLD.NOMVIS) OR (:NEW.TIPVIS <> :OLD.TIPVIS) OR (:NEW.CODPRM <> :OLD.CODPRM) OR
     (:NEW.DATVAL <> :OLD.DATVAL) OR (:NEW.HORVAL <> :OLD.HORVAL) OR
     (:NEW.CODPOR <> :OLD.CODPOR) OR (:NEW.CODNAC <> :OLD.CODNAC) OR (:NEW.OBSVIS <> :OLD.OBSVIS) OR
     (:NEW.CODOEM <> :OLD.CODOEM) OR (:NEW.NOMOEM <> :OLD.NOMOEM) OR
     (:NEW.DDITEL <> :OLD.DDITEL) OR (:NEW.DDDTEL <> :OLD.DDDTEL) OR 
     (:NEW.TELCON <> :OLD.TELCON) OR (:NEW.EMAVIS <> :OLD.EMAVIS) OR 
     (:NEW.EMPAUT <> :OLD.EMPAUT) OR (:NEW.TCLAUT <> :OLD.TCLAUT) OR (:NEW.CADAUT <> :OLD.CADAUT) OR 
     (:NEW.STAWAV <> :OLD.STAWAV) THEN

      SP_PEND86('2', :NEW.DATPRV, :NEW.HORPRV, :NEW.SEQAGV, :NEW.NUMEMP, :NEW.TIPCOL,
                 :NEW.NUMCAD, :NEW.TIPDOC, :NEW.NUMDOC, :NEW.NOMVIS, :NEW.TIPVIS, :NEW.CODPRM,
                 :NEW.DATVAL, :NEW.HORVAL,:NEW.CODPOR,
                 :NEW.CODNAC, :NEW.OBSVIS, :NEW.CODOEM, :NEW.NOMOEM, :NEW.DDITEL, :NEW.DDDTEL, :NEW.TELCON, :NEW.EMAVIS,
                 :NEW.LOCAGV, :NEW.EMPAUT, :NEW.TCLAUT, :NEW.CADAUT, :NEW.STAWAV, :NEW.VERPLF, :NEW.CODPLF, :NEW.VISEFE);
  END IF;

  IF (:NEW.TipVis IS NOT NULL) THEN

    BEGIN
      SELECT UsaTAA, EnvAge, DESVIS INTO l_UsaTAA, l_EnvAge, l_NomTIPVIS FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_UsaTAA := 'N';
      WHEN OTHERS THEN NULL;
    END;

    /* SE JA EXISTE NOTIFICACAO TIPOS 1 E 2 GERADA PARA ESTE AGENDAMENTO DE VISITA, NAO GERO NOVAMENTE */
    BEGIN
      SELECT COUNT(CODORI) INTO l_TemNot FROM R115NOT WHERE :NEW.LOCAGV <> 0 AND CODORI = :NEW.LOCAGV AND TIPNOT IN (1, 2);
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_TemNot := 0;
      WHEN OTHERS THEN l_TemNot := 0;
    END;

	/* NOTIFICACAO DE AGENDAMENTO DE VISITA CRIADO - AO VISITANTE - TERMINAL DE AUTOATENDIMENTO */
    IF (:NEW.STAWAV = 1) AND (l_TemNot = 0) THEN

      IF (l_UsaTAA = 'S') AND (l_EnvAge > 0) THEN
        BEGIN
          SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R030EMP.NomEmp INTO l_NomEmp FROM R030EMP WHERE R030EMP.NUMEMP = :NEW.NUMEMP;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R034FUN.NomFun INTO l_NomFun FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.NUMEMP AND R034FUN.TIPCOL = :NEW.TIPCOL AND R034FUN.NUMCAD = :NEW.NUMCAD;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        /* Envio Confirmacao Agendamento ao Visitante - email */
        IF (l_EnvAge = 1) OR (l_EnvAge = 9) THEN
          R115NOT_ATUNOT(1, 
                         :NEW.LOCAGV,
                         :NEW.NOMVIS,
                         :NEW.EMAVIS,
                         :NEW.DATPRV,
                         :NEW.HORPRV,
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         :NEW.DDITEL, 
                         :NEW.DDDTEL, 
                         :NEW.TELCON,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,        
                         NULL,  /* DDI Visitado */
                         NULL,  /* DDD Visitado */
                         NULL,  /* Fone do Visitado */
                         NULL,  /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         NULL, /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );    
        END IF;

        /* Envio Confirmacao Agendamento ao Visitante - SMS */
        IF (l_EnvAge = 2) OR (l_EnvAge = 9) THEN
          R115NOT_ATUNOT(2, 
                         :NEW.LOCAGV,
                         :NEW.NOMVIS,
                         :NEW.EMAVIS,
                         :NEW.DATPRV,
                         :NEW.HORPRV,
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         :NEW.DDITEL, 
                         :NEW.DDDTEL, 
                         :NEW.TELCON,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,        
                         NULL,  /* DDI Visitado */
                         NULL,  /* DDD Visitado */
                         NULL,  /* Fone do Visitado */
                         NULL,  /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         NULL, /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );    
        END IF;
      END IF; /* IF (l_UsaTAA = 'S') AND (l_EnvAge > 0) THEN */
    END IF; /* FIM DA NOTIFICACAO DE AGENDAMENTO DE VISITA CRIADO - AO VISITANTE - TERMINAL DE AUTOATENDIMENTO */

    /* SE JA EXISTE NOTIFICACAO TIPOS 5 E 6 GERADA PARA ESTE AGENDAMENTO DE VISITA, NAO GERO NOVAMENTE */
    BEGIN
      SELECT COUNT(CODORI) INTO l_TemNot FROM R115NOT WHERE :NEW.LOCAGV <> 0 AND CODORI = :NEW.LOCAGV AND TIPNOT IN (5, 6);
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_TemNot := 0;
      WHEN OTHERS THEN l_TemNot := 0;
    END;

	/* NOTIFICACAO DE CONFIRMACAO DO AGENDAMENTO PELO AUTORIZADOR (1- AUTORIZADO E 2-NAO AUTORIZADO) - E-MAIL E SMS */
    IF (:OLD.STAWAV = 0) AND (:NEW.STAWAV >= 1) AND (l_TemNot = 0) THEN

      BEGIN
        SELECT NOTCOL INTO l_EnvAge FROM R070DAC;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      BEGIN
        SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      BEGIN
        SELECT R030EMP.NomEmp INTO l_NomEmp FROM R030EMP WHERE R030EMP.NUMEMP = :NEW.EMPSOL;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
      
      BEGIN
        SELECT DESPRM INTO l_DesPrm FROM R058PRM WHERE CODPRM = :NEW.CODPRM;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
      
      IF :NEW.STAWAV = 1 THEN 
        l_SituacaoWAV := 'AUTORIZADO';
      ELSIF :NEW.STAWAV = 2 THEN
        l_SituacaoWAV := 'NÃO AUTORIZADO';
      END IF;
      
      IF :NEW.TIPDOC = 1 THEN
        l_DesDoc := 'Identidade';
      ELSIF :NEW.TIPDOC = 2 THEN
        l_DesDoc := 'CPF';
      ELSIF :NEW.TIPDOC = 3 THEN
        l_DesDoc := 'CNH';
      ELSIF :NEW.TIPDOC = 4 THEN
        l_DesDoc := 'Passaporte';
      ELSIF :NEW.TIPDOC = 5 THEN
        l_DesDoc := 'Outros';
      ELSIF :NEW.TIPDOC = 6 THEN
        l_DesDoc := 'Sem Documento';
      END IF;
      
      BEGIN
        SELECT R034FUN.NomFun INTO l_NomAut FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.EMPAUT AND R034FUN.TIPCOL = :NEW.TCLAUT AND R034FUN.NUMCAD = :NEW.CADAUT;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
          
      BEGIN
        SELECT R034FUN.NomFun INTO l_NomSol FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.EMPSOL AND R034FUN.TIPCOL = :NEW.TCLSOL AND R034FUN.NUMCAD = :NEW.CADSOL;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      BEGIN
        SELECT NOMUSU INTO l_NomUsu FROM R999USU WHERE CODUSU = :NEW.CODUPS;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
        
      BEGIN
        SELECT R034CPL.EmaCom
        INTO l_EmaSol
        FROM R034CPL
        WHERE R034CPL.NUMEMP = :NEW.EMPSOL AND R034CPL.TIPCOL = :NEW.TCLSOL AND R034CPL.NUMCAD = :NEW.CADSOL;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
          
      /* EMAIL ou AMBOS */
      IF (l_EnvAge = 1) OR (l_EnvAge = 9) THEN
            R115NOT_ATUNOT(5, 
                           :NEW.LOCAGV,
                           :NEW.NOMVIS,
                           :NEW.EMAVIS,
                           :NEW.DATPRV,
                           :NEW.HORPRV,
                           :NEW.DATVAL,
                           :NEW.HORVAL,
                           :NEW.NOMOEM,
                           :NEW.DDITEL,
                           :NEW.DDDTEL,
                           :NEW.TELCON,
                           l_DesPor,
                           l_NomEmp,
                           l_NomFun,       
                           NULL,  /* DDI Visitado */
                           NULL,  /* DDD Visitado */
                           NULL,  /* Fone do Visitado */
                           l_SituacaoWAV,  /* SituacaoWAV */
                           :NEW.TIPDOC,
                           l_DesDoc,
                           :NEW.NUMDOC,
                           :NEW.TIPVIS,
                           l_NomTIPVIS,
                           :NEW.CODPOR,
                           :NEW.CODPRM,
                           l_DesPrm,
                           :NEW.PLAVEI,
                           l_NomAut,
                           :NEW.OBSVIS,
                           l_NomSol,
                           l_EmaSol,
                           :NEW.DATSAG,
                           :NEW.HORSAG,
                           l_NomUsu,
                           :NEW.DATPSA,
                           :NEW.HORPSA,
                           :NEW.OBSREP
                           );
      END IF;  /* IF (l_EnvAge = 1) OR (l_EnvAge = 9) */
          
      /* SMS ou AMBOS */
      IF (l_EnvAge = 2) OR (l_EnvAge = 9) THEN
        
          BEGIN
            SELECT R034CPL.NmDdi2, R034CPL.NmDdd2, R034CPL.NmTel2
            INTO l_DDITelFun, l_DDDTelFun, l_TelConFun
            FROM R034CPL
            WHERE R034CPL.NUMEMP = :NEW.EMPSOL AND R034CPL.TIPCOL = :NEW.TCLSOL AND R034CPL.NUMCAD = :NEW.CADSOL;
          EXCEPTION
            WHEN OTHERS THEN NULL;
          END;

          R115NOT_ATUNOT(6, 
                         :NEW.LOCAGV,
                         :NEW.NOMVIS,
                         :NEW.EMAVIS,
                         :NEW.DATPRV,
                         :NEW.HORPRV,
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         :NEW.DDITEL,
                         :NEW.DDDTEL,
                         :NEW.TELCON,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,       
                         l_DDITelFun,  /* DDI Solicitante */
                         l_DDDTelFun,  /* DDD Solicitante */
                         l_TelConFun,  /* Fone do Solicitante */
                         l_SituacaoWAV,  /* SituacaoWAV */
                         :NEW.TIPDOC,
                         l_DesDoc,
                         :NEW.NUMDOC,
                         :NEW.TIPVIS,
                         l_NomTIPVIS,
                         :NEW.CODPOR,
                         :NEW.CODPRM,
                         l_DesPrm,
                         :NEW.PLAVEI,
                         l_NomAut,
                         :NEW.OBSVIS,
                         l_NomSol,
                         '',
                         :NEW.DATSAG,
                         :NEW.HORSAG,
                         l_NomUsu,
                         :NEW.DATPSA,
                         :NEW.HORPSA,
                         :NEW.OBSREP
                         );
      END IF;  /* IF (l_EnvAge = 2) OR (l_EnvAge = 9) */
      
    END IF; /* FIM DA NOTIFICACAO DE CONFIRMACAO DO AGENDAMENTO PELO AUTORIZADOR (1- AUTORIZADO E 2-NAO AUTORIZADO) - E-MAIL E SMS */
  END IF; /* IF (:NEW.TipVis IS NOT NULL) THEN */
END		SENIOR;23Ô5␀␀

TRIGGER R090AGV_EU AFTER UPDATE ON R090AGV FOR EACH ROW
DECLARE
l_UsaTAA       VARCHAR(1);
  l_EnvAge       NUMBER(1);
  l_DesPor       VARCHAR2(20);
  l_NomEmp       VARCHAR2(40);
  l_NomFun       VARCHAR2(40);
  l_SituacaoWAV  VARCHAR2(40);
  l_NomTIPVIS    VARCHAR2(40);
  l_DesPrm       VARCHAR2(40);
  l_NomAut       VARCHAR2(40);
  l_NomSol       VARCHAR2(40);
  l_EmaSol       VARCHAR2(100);
  l_NomUsu       VARCHAR2(255);
  l_DesDoc       VARCHAR2(20);
  l_DDITelFun    NUMBER(3);
  l_DDDTelFun    NUMBER(3);
  l_TelConFun    VARCHAR2(20);
  l_TemNot    NUMBER(1);
BEGIN
  /* IMPORTANTE: O LOCAGV É ATRIBUÍDO NA TRIGGER R090AGV_BU */

  /* nao pode ser considerado o LOCAGV pois o INSERT */
  IF (:NEW.NOMVIS <> :OLD.NOMVIS) OR (:NEW.TIPVIS <> :OLD.TIPVIS) OR (:NEW.CODPRM <> :OLD.CODPRM) OR
     (:NEW.DATVAL <> :OLD.DATVAL) OR (:NEW.HORVAL <> :OLD.HORVAL) OR
     (:NEW.CODPOR <> :OLD.CODPOR) OR (:NEW.CODNAC <> :OLD.CODNAC) OR (:NEW.OBSVIS <> :OLD.OBSVIS) OR
     (:NEW.CODOEM <> :OLD.CODOEM) OR (:NEW.NOMOEM <> :OLD.NOMOEM) OR
     (:NEW.DDITEL <> :OLD.DDITEL) OR (:NEW.DDDTEL <> :OLD.DDDTEL) OR 
     (:NEW.TELCON <> :OLD.TELCON) OR (:NEW.EMAVIS <> :OLD.EMAVIS) OR 
     (:NEW.EMPAUT <> :OLD.EMPAUT) OR (:NEW.TCLAUT <> :OLD.TCLAUT) OR (:NEW.CADAUT <> :OLD.CADAUT) OR 
     (:NEW.STAWAV <> :OLD.STAWAV) THEN

      SP_PEND86('2', :NEW.DATPRV, :NEW.HORPRV, :NEW.SEQAGV, :NEW.NUMEMP, :NEW.TIPCOL,
                 :NEW.NUMCAD, :NEW.TIPDOC, :NEW.NUMDOC, :NEW.NOMVIS, :NEW.TIPVIS, :NEW.CODPRM,
                 :NEW.DATVAL, :NEW.HORVAL,:NEW.CODPOR,
                 :NEW.CODNAC, :NEW.OBSVIS, :NEW.CODOEM, :NEW.NOMOEM, :NEW.DDITEL, :NEW.DDDTEL, :NEW.TELCON, :NEW.EMAVIS,
                 :NEW.LOCAGV, :NEW.EMPAUT, :NEW.TCLAUT, :NEW.CADAUT, :NEW.STAWAV, :NEW.VERPLF, :NEW.CODPLF, :NEW.VISEFE);
  END IF;

  IF (:NEW.TipVis IS NOT NULL) THEN

    BEGIN
      SELECT UsaTAA, EnvAge, DESVIS INTO l_UsaTAA, l_EnvAge, l_NomTIPVIS FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_UsaTAA := 'N';
      WHEN OTHERS THEN NULL;
    END;

    /* SE JA EXISTE NOTIFICACAO TIPOS 1 E 2 GERADA PARA ESTE AGENDAMENTO DE VISITA, NAO GERO NOVAMENTE */
    BEGIN
      SELECT COUNT(CODORI) INTO l_TemNot FROM R115NOT WHERE :NEW.LOCAGV <> 0 AND CODORI = :NEW.LOCAGV AND TIPNOT IN (1, 2);
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_TemNot := 0;
      WHEN OTHERS THEN l_TemNot := 0;
    END;

	/* NOTIFICACAO DE AGENDAMENTO DE VISITA CRIADO - AO VISITANTE - TERMINAL DE AUTOATENDIMENTO */
    IF (:NEW.STAWAV = 1) AND (l_TemNot = 0) THEN

      IF (l_UsaTAA = 'S') AND (l_EnvAge > 0) THEN
        BEGIN
          SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R030EMP.NomEmp INTO l_NomEmp FROM R030EMP WHERE R030EMP.NUMEMP = :NEW.NUMEMP;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R034FUN.NomFun INTO l_NomFun FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.NUMEMP AND R034FUN.TIPCOL = :NEW.TIPCOL AND R034FUN.NUMCAD = :NEW.NUMCAD;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        /* Envio Confirmacao Agendamento ao Visitante - email */
        IF (l_EnvAge = 1) OR (l_EnvAge = 9) THEN
          R115NOT_ATUNOT(1, 
                         :NEW.LOCAGV,
                         :NEW.NOMVIS,
                         :NEW.EMAVIS,
                         :NEW.DATPRV,
                         :NEW.HORPRV,
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         :NEW.DDITEL, 
                         :NEW.DDDTEL, 
                         :NEW.TELCON,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,        
                         NULL,  /* DDI Visitado */
                         NULL,  /* DDD Visitado */
                         NULL,  /* Fone do Visitado */
                         NULL,  /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         NULL, /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );    
        END IF;

        /* Envio Confirmacao Agendamento ao Visitante - SMS */
        IF (l_EnvAge = 2) OR (l_EnvAge = 9) THEN
          R115NOT_ATUNOT(2, 
                         :NEW.LOCAGV,
                         :NEW.NOMVIS,
                         :NEW.EMAVIS,
                         :NEW.DATPRV,
                         :NEW.HORPRV,
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         :NEW.DDITEL, 
                         :NEW.DDDTEL, 
                         :NEW.TELCON,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,        
                         NULL,  /* DDI Visitado */
                         NULL,  /* DDD Visitado */
                         NULL,  /* Fone do Visitado */
                         NULL,  /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         NULL, /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );    
        END IF;
      END IF; /* IF (l_UsaTAA = 'S') AND (l_EnvAge > 0) THEN */
    END IF; /* FIM DA NOTIFICACAO DE AGENDAMENTO DE VISITA CRIADO - AO VISITANTE - TERMINAL DE AUTOATENDIMENTO */

    /* SE JA EXISTE NOTIFICACAO TIPOS 5 E 6 GERADA PARA ESTE AGENDAMENTO DE VISITA, NAO GERO NOVAMENTE */
    BEGIN
      SELECT COUNT(CODORI) INTO l_TemNot FROM R115NOT WHERE :NEW.LOCAGV <> 0 AND CODORI = :NEW.LOCAGV AND TIPNOT IN (5, 6);
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_TemNot := 0;
      WHEN OTHERS THEN l_TemNot := 0;
    END;

	/* NOTIFICACAO DE CONFIRMACAO DO AGENDAMENTO PELO AUTORIZADOR (1- AUTORIZADO E 2-NAO AUTORIZADO) - E-MAIL E SMS */
    IF (:OLD.STAWAV = 0) AND (:NEW.STAWAV >= 1) AND (l_TemNot = 0) THEN

      BEGIN
        SELECT NOTCOL INTO l_EnvAge FROM R070DAC;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      BEGIN
        SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      BEGIN
        SELECT R030EMP.NomEmp INTO l_NomEmp FROM R030EMP WHERE R030EMP.NUMEMP = :NEW.EMPSOL;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
      
      BEGIN
        SELECT DESPRM INTO l_DesPrm FROM R058PRM WHERE CODPRM = :NEW.CODPRM;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
      
      IF :NEW.STAWAV = 1 THEN 
        l_SituacaoWAV := 'AUTORIZADO';
      ELSIF :NEW.STAWAV = 2 THEN
        l_SituacaoWAV := 'NÃO AUTORIZADO';
      END IF;
      
      IF :NEW.TIPDOC = 1 THEN
        l_DesDoc := 'Identidade';
      ELSIF :NEW.TIPDOC = 2 THEN
        l_DesDoc := 'CPF';
      ELSIF :NEW.TIPDOC = 3 THEN
        l_DesDoc := 'CNH';
      ELSIF :NEW.TIPDOC = 4 THEN
        l_DesDoc := 'Passaporte';
      ELSIF :NEW.TIPDOC = 5 THEN
        l_DesDoc := 'Outros';
      ELSIF :NEW.TIPDOC = 6 THEN
        l_DesDoc := 'Sem Documento';
      END IF;
      
      BEGIN
        SELECT R034FUN.NomFun INTO l_NomAut FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.EMPAUT AND R034FUN.TIPCOL = :NEW.TCLAUT AND R034FUN.NUMCAD = :NEW.CADAUT;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
          
      BEGIN
        SELECT R034FUN.NomFun INTO l_NomSol FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.EMPSOL AND R034FUN.TIPCOL = :NEW.TCLSOL AND R034FUN.NUMCAD = :NEW.CADSOL;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      BEGIN
        SELECT NOMUSU INTO l_NomUsu FROM R999USU WHERE CODUSU = :NEW.CODUPS;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
        
      BEGIN
        SELECT R034CPL.EmaCom
        INTO l_EmaSol
        FROM R034CPL
        WHERE R034CPL.NUMEMP = :NEW.EMPSOL AND R034CPL.TIPCOL = :NEW.TCLSOL AND R034CPL.NUMCAD = :NEW.CADSOL;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
          
      /* EMAIL ou AMBOS */
      IF (l_EnvAge = 1) OR (l_EnvAge = 9) THEN
            R115NOT_ATUNOT(5, 
                           :NEW.LOCAGV,
                           :NEW.NOMVIS,
                           :NEW.EMAVIS,
                           :NEW.DATPRV,
                           :NEW.HORPRV,
                           :NEW.DATVAL,
                           :NEW.HORVAL,
                           :NEW.NOMOEM,
                           :NEW.DDITEL,
                           :NEW.DDDTEL,
                           :NEW.TELCON,
                           l_DesPor,
                           l_NomEmp,
                           l_NomFun,       
                           NULL,  /* DDI Visitado */
                           NULL,  /* DDD Visitado */
                           NULL,  /* Fone do Visitado */
                           l_SituacaoWAV,  /* SituacaoWAV */
                           :NEW.TIPDOC,
                           l_DesDoc,
                           :NEW.NUMDOC,
                           :NEW.TIPVIS,
                           l_NomTIPVIS,
                           :NEW.CODPOR,
                           :NEW.CODPRM,
                           l_DesPrm,
                           :NEW.PLAVEI,
                           l_NomAut,
                           :NEW.OBSVIS,
                           l_NomSol,
                           l_EmaSol,
                           :NEW.DATSAG,
                           :NEW.HORSAG,
                           l_NomUsu,
                           :NEW.DATPSA,
                           :NEW.HORPSA,
                           :NEW.OBSREP
                           );
      END IF;  /* IF (l_EnvAge = 1) OR (l_EnvAge = 9) */
          
      /* SMS ou AMBOS */
      IF (l_EnvAge = 2) OR (l_EnvAge = 9) THEN
        
          BEGIN
            SELECT R034CPL.NmDdi2, R034CPL.NmDdd2, R034CPL.NmTel2
            INTO l_DDITelFun, l_DDDTelFun, l_TelConFun
            FROM R034CPL
            WHERE R034CPL.NUMEMP = :NEW.EMPSOL AND R034CPL.TIPCOL = :NEW.TCLSOL AND R034CPL.NUMCAD = :NEW.CADSOL;
          EXCEPTION
            WHEN OTHERS THEN NULL;
          END;

          R115NOT_ATUNOT(6, 
                         :NEW.LOCAGV,
                         :NEW.NOMVIS,
                         :NEW.EMAVIS,
                         :NEW.DATPRV,
                         :NEW.HORPRV,
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         :NEW.DDITEL,
                         :NEW.DDDTEL,
                         :NEW.TELCON,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,       
                         l_DDITelFun,  /* DDI Solicitante */
                         l_DDDTelFun,  /* DDD Solicitante */
                         l_TelConFun,  /* Fone do Solicitante */
                         l_SituacaoWAV,  /* SituacaoWAV */
                         :NEW.TIPDOC,
                         l_DesDoc,
                         :NEW.NUMDOC,
                         :NEW.TIPVIS,
                         l_NomTIPVIS,
                         :NEW.CODPOR,
                         :NEW.CODPRM,
                         l_DesPrm,
                         :NEW.PLAVEI,
                         l_NomAut,
                         :NEW.OBSVIS,
                         l_NomSol,
                         '',
                         :NEW.DATSAG,
                         :NEW.HORSAG,
                         l_NomUsu,
                         :NEW.DATPSA,
                         :NEW.HORPSA,
                         :NEW.OBSREP
                         );
      END IF;  /* IF (l_EnvAge = 2) OR (l_EnvAge = 9) */
      
    END IF; /* FIM DA NOTIFICACAO DE CONFIRMACAO DO AGENDAMENTO PELO AUTORIZADOR (1- AUTORIZADO E 2-NAO AUTORIZADO) - E-MAIL E SMS */
  END IF; /* IF (:NEW.TipVis IS NOT NULL) THEN */
END␀İ␀␀		SENIOR;09␀␀

TRIGGER R090AGV_ED AFTER DELETE ON R090AGV FOR EACH ROW
DECLARE
l_UsaTAA VARCHAR(1);
  l_EnvAge       NUMBER(1);
  l_DesPor       VARCHAR2(20);
  l_NomEmp       VARCHAR2(40);
  l_NomFun       VARCHAR2(40);
  l_NomTIPVIS    VARCHAR2(40);
  l_DesPrm       VARCHAR2(40);
  l_NomAut       VARCHAR2(40);
  l_NomSol       VARCHAR2(40);
  l_EmaSol       VARCHAR2(100);
  l_NomUsu       VARCHAR2(255);
  l_DesDoc       VARCHAR2(20);
  l_DDITelFun    NUMBER(3);
  l_DDDTelFun    NUMBER(3);
  l_TelConFun    VARCHAR2(20);
BEGIN
  SP_PEND86('3', :OLD.DATPRV, :OLD.HORPRV, :OLD.SEQAGV, :OLD.NUMEMP, :OLD.TIPCOL,
                 :OLD.NUMCAD, :OLD.TIPDOC, :OLD.NUMDOC, :OLD.NOMVIS, :OLD.TIPVIS, :OLD.CODPRM,
                 :OLD.DATVAL, :OLD.HORVAL, :OLD.CODPOR, 
                 :OLD.CODNAC, :OLD.OBSVIS, :OLD.CODOEM, :OLD.NOMOEM, :OLD.DDITEL, :OLD.DDDTEL, :OLD.TELCON, :OLD.EMAVIS,
                 :OLD.LOCAGV, :OLD.EMPAUT, :OLD.TCLAUT, :OLD.CADAUT, :OLD.STAWAV, :OLD.VERPLF, :OLD.CODPLF, :OLD.VISEFE);
                 
  IF (:OLD.TipVis IS NOT NULL) AND (:OLD.LOCAGV IS NOT NULL) THEN
    BEGIN
      SELECT UsaTAA, EnvAge, DESVIS INTO l_UsaTAA, l_EnvAge, l_NomTIPVIS FROM R090TVI WHERE TIPVIS = :OLD.TIPVIS;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_UsaTAA := 'N';
      WHEN OTHERS THEN NULL;
    END;

    /* excluir notificacao do tipo 1 e 2 (agendamento ao visitante) e tambem as 7 e 8 (agendamento pendente de aprovacao), se tiver*/
    DELETE FROM R115CNO WHERE CODNOT IN (SELECT CODNOT FROM R115NOT WHERE CODORI = :OLD.LOCAGV AND STANOT = 0);
    DELETE FROM R115NOT WHERE CODORI = :OLD.LOCAGV AND STANOT = 0;
      
    BEGIN
      SELECT R034FUN.NomFun INTO l_NomFun FROM R034FUN WHERE R034FUN.NUMEMP = :OLD.NUMEMP AND R034FUN.TIPCOL = :OLD.TIPCOL AND R034FUN.NUMCAD = :OLD.NUMCAD;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;
      
    BEGIN
      SELECT NOTCOL INTO l_EnvAge FROM R070DAC;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;

    BEGIN
      SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :OLD.CODPOR;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;

    BEGIN
      SELECT R030EMP.NomEmp INTO l_NomEmp FROM R030EMP WHERE R030EMP.NUMEMP = :OLD.NUMEMP;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;
      
    BEGIN
      SELECT DESPRM INTO l_DesPrm FROM R058PRM WHERE CODPRM = :OLD.CODPRM;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;
      
      IF :OLD.TIPDOC = 1 THEN
        l_DesDoc := 'Identidade';
      ELSIF :OLD.TIPDOC = 2 THEN
        l_DesDoc := 'CPF';
      ELSIF :OLD.TIPDOC = 3 THEN
        l_DesDoc := 'CNH';
      ELSIF :OLD.TIPDOC = 4 THEN
        l_DesDoc := 'Passaporte';
      ELSIF :OLD.TIPDOC = 5 THEN
        l_DesDoc := 'Outros';
      ELSIF :OLD.TIPDOC = 6 THEN
        l_DesDoc := 'Sem Documento';
      END IF;
      
        BEGIN
          SELECT R034FUN.NomFun INTO l_NomAut FROM R034FUN WHERE R034FUN.NUMEMP = :OLD.EMPAUT AND R034FUN.TIPCOL = :OLD.TCLAUT AND R034FUN.NUMCAD = :OLD.CADAUT;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;
          
        BEGIN
          SELECT R034FUN.NomFun INTO l_NomSol FROM R034FUN WHERE R034FUN.NUMEMP = :OLD.EMPSOL AND R034FUN.TIPCOL = :OLD.TCLSOL AND R034FUN.NUMCAD = :OLD.CADSOL;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT NOMUSU INTO l_NomUsu FROM R999USU WHERE CODUSU = :OLD.CODUPS;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;
        
        BEGIN
          SELECT R034CPL.EmaCom
          INTO l_EmaSol
          FROM R034CPL
          WHERE R034CPL.NUMEMP = :OLD.EMPSOL AND R034CPL.TIPCOL = :OLD.TCLSOL AND R034CPL.NUMCAD = :OLD.CADSOL;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;
          
        /* EMAIL ou AMBOS */
        IF (l_EnvAge = 1) OR (l_EnvAge = 9) THEN
            R115NOT_ATUNOT(5, 
                           :OLD.LOCAGV,
                           :OLD.NOMVIS,
                           :OLD.EMAVIS,
                           :OLD.DATPRV,
                           :OLD.HORPRV,
                           :OLD.DATVAL,
                           :OLD.HORVAL,
                           :OLD.NOMOEM,
                           :OLD.DDITEL,
                           :OLD.DDDTEL,
                           :OLD.TELCON,
                           l_DesPor,
                           l_NomEmp,
                           l_NomFun,       
                           NULL,  /* DDI Solicitante */
                           NULL,  /* DDD Solicitante */
                           NULL,  /* Fone do Solicitante */
                           'EXCLUÍDO',  /* SituacaoWAV */
                           :OLD.TIPDOC,
                           l_DesDoc,
                           :OLD.NUMDOC,
                           :OLD.TIPVIS,
                           l_NomTIPVIS,
                           :OLD.CODPOR,
                           :OLD.CODPRM,
                           l_DesPrm,
                           :OLD.PLAVEI,
                           l_NomAut,
                           :OLD.OBSVIS,
                           l_NomSol,
                           l_EmaSol,
                           :OLD.DATSAG,
                           :OLD.HORSAG,
                           l_NomUsu,
                           :OLD.DATPSA,
                           :OLD.HORPSA,
                           :OLD.OBSREP
                           );
        END IF;  /* IF (l_EnvAge = 1) OR (l_EnvAge = 9) */
          
        /* SMS ou AMBOS */
        IF (l_EnvAge = 2) OR (l_EnvAge = 9) THEN
        
          BEGIN
            SELECT R034CPL.NmDdi2, R034CPL.NmDdd2, R034CPL.NmTel2
            INTO l_DDITelFun, l_DDDTelFun, l_TelConFun
            FROM R034CPL
            WHERE R034CPL.NUMEMP = :OLD.EMPSOL AND R034CPL.TIPCOL = :OLD.TCLSOL AND R034CPL.NUMCAD = :OLD.CADSOL;
          EXCEPTION
            WHEN OTHERS THEN NULL;
          END;

          R115NOT_ATUNOT(6, 
                         :OLD.LOCAGV,
                         :OLD.NOMVIS,
                         :OLD.EMAVIS,
                         :OLD.DATPRV,
                         :OLD.HORPRV,
                         :OLD.DATVAL,
                         :OLD.HORVAL,
                         :OLD.NOMOEM,
                         :OLD.DDITEL,
                         :OLD.DDDTEL,
                         :OLD.TELCON,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,       
                         l_DDITelFun,  /* DDI Solicitante */
                         l_DDDTelFun,  /* DDD Solicitante */
                         l_TelConFun,  /* Fone do Solicitante */
                         'EXCLUÍDO',  /* SituacaoWAV */
                         :OLD.TIPDOC,
                         l_DesDoc,
                         :OLD.NUMDOC,
                         :OLD.TIPVIS,
                         l_NomTIPVIS,
                         :OLD.CODPOR,
                         :OLD.CODPRM,
                         l_DesPrm,
                         :OLD.PLAVEI,
                         l_NomAut,
                         :OLD.OBSVIS,
                         l_NomSol,
                         '',
                         :OLD.DATSAG,
                         :OLD.HORSAG,
                         l_NomUsu,
                         :OLD.DATPSA,
                         :OLD.HORPSA,
                         :OLD.OBSREP
                         );
        END IF;  /* IF (l_EnvAge = 2) OR (l_EnvAge = 9) */

  END IF;
