>'␀␀CREATE  PROCEDURE sp_porcomdsp(@p_Straux VARCHAR(255), @p_CenPen VARCHAR(255)) AS
BEGIN
DECLARE @l_retpen CHAR(3)
DECLARE @l_datenv DATETIME
DECLARE @l_datenv_str CHAR(16)
DECLARE @l_horenv SMALLINT
DECLARE @l_idtpes VARCHAR(23)
DECLARE @l_numfis BIGINT
DECLARE @l_dirsvr VARCHAR(250)
DECLARE @l_codcmd SMALLINT
DECLARE @l_stacmd SMALLINT
DECLARE @l_seqenv SMALLINT
DECLARE @l_coddsp INTEGER
DECLARE @l_tipope SMALLINT
DECLARE @l_dat_conv VARCHAR(25)
DECLARE @l_straux VARCHAR(2047)
DECLARE @l_logpen VARCHAR(2047)
DECLARE @l_cenpen VARCHAR(255)
DECLARE @l_codcen SMALLINT
DECLARE @l_aux SMALLINT
DECLARE @l_gersen CHAR(1)
DECLARE @l_cenati CHAR(1)
DECLARE @c_r058cen2_cnt integer
DECLARE @l_r058cen_DIRSVR VARCHAR(250)
DECLARE @l_r058cen_GERSEN VARCHAR(1)
DECLARE @l_r058cen_CENATI VARCHAR(1)
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @SE_EXC3 INTEGER
  DECLARE @NULL_VAR INTEGER
  DECLARE @SE_EXC2 INTEGER
  DECLARE @SE_EXC4 INTEGER
  DECLARE @SE_EXC6 INTEGER
  DECLARE @SE_EXC5 INTEGER
  SELECT @ChkError = 0
  SELECT @l_datenv = CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(MM, GETDATE()))))+ '/' + LTRIM(RTRIM(STR(DATEPART(DD, GETDATE()))))+ '/' + LTRIM(RTRIM(STR(DATEPART(YY, GETDATE())))))
  SELECT @l_horenv = DATEPART(HOUR,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))*60+DATEPART(MINUTE,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))
  SELECT @l_seqenv = DATEPART(ss,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))
  SELECT @l_stacmd = 1
  SELECT @l_tipope = 0
  SELECT @l_retpen = '001'
  SELECT @l_CodCmd = 162
  /* TRY */
    SELECT @l_idtpes = SUBSTRING(@p_Straux,42,23)
    SELECT @l_numfis = SUBSTRING(@p_Straux,29,12)
    SELECT @l_tipope = SUBSTRING(@p_Straux,28,1)
    SELECT @l_datenv_str = SUBSTRING(@p_Straux,3,16)
    SELECT @l_dat_conv = SUBSTRING(@l_datenv_str,1,2)+'/'+SUBSTRING(@l_datenv_str,3,2)+'/'+SUBSTRING(@l_datenv_str,5,2)
    EXECUTE  @ChkError = SP_STRTODATE @l_dat_conv,'DD/MM/AA',@l_datenv 
    IF @ChkError <> 0
    BEGIN
      GOTO EXC1
    END
	SELECT @l_horenv = CONVERT(NUMERIC,(SUBSTRING(@l_datenv_str,7,2)))*60+CONVERT(NUMERIC,(SUBSTRING(@l_datenv_str,9,2)))
    IF (@l_tipope=1)
    BEGIN
      IF (@l_seqenv>2)
      BEGIN
        SELECT @l_seqenv = @l_seqenv-3
      END
      ELSE
      BEGIN
        IF (@l_horenv>0)
        BEGIN
          SELECT @l_horenv = @l_horenv-1
          SELECT @l_seqenv = 57
        END
        ELSE
        BEGIN
          SELECT @l_datenv = (@l_datenv+-1)
          SELECT @l_horenv = 1439
          SELECT @l_seqenv = 57
        END
      END
    END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC1:
    SELECT @SE_EXC1 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
		RAISERROR('SP_PorComDSP: Problemas ao Formatar a Pendência.',11,1) WITH SETERROR
        SELECT @ChkError = -30
        IF @ChkError <> 0
        BEGIN
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
  SELECT @l_CenPen = @p_CenPen
  SELECT @l_CenPen = LTRIM(@l_CenPen)
  SELECT @l_CenPen = RTRIM(@l_CenPen)
  SELECT @l_straux = @p_Straux
  IF (@l_CenPen='0')
  BEGIN
    DECLARE c_r058cen2 CURSOR FOR SELECT 
      r058cen.dirsvr DIRSVR, r058cen.gersen GERSEN, r058cen.cenati CENATI
       FROM r058cen r058cen
       WHERE gersen='S' 
      and tipger=2
    OPEN c_r058cen2
    SELECT @ChkError = @@Error
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
      FETCH NEXT FROM c_r058cen2 INTO @l_r058cen_dirsvr, @l_r058cen_gersen, @l_r058cen_cenati
      WHILE (@@FETCH_STATUS=0)
      BEGIN
        IF (@l_r058cen_gersen='S') and (@l_r058cen_cenati='S')
        BEGIN
          SELECT @l_CodDsp = SUBSTRING(@l_straux,19,9)
          IF (@l_tipope<>3)
          BEGIN
            UPDATE r070dsp SET 
      stacmd=7 
       WHERE numfis=@l_numfis
	  and SUBSTRING(valstr,42,23)=@l_idtpes 
      and stacmd in (0,1,5,8,9) 
      and codcmd=@l_codcmd 
      and dirsvr=@l_r058cen_dirsvr 
      and coddsp=@l_coddsp
            SELECT @ChkError = @@Error
            IF @ChkError <> 0
            BEGIN
              GOTO EXC2
            END
          END
          ELSE
          BEGIN
            SELECT @l_straux = SUBSTRING(@p_Straux,1,27)+'0'+SUBSTRING(@p_Straux,29,DATALENGTH(@p_Straux)-28)
          END
          /* TRY */
            EXECUTE  @ChkError = SP_RETLOGPEN @l_logpen OUTPUT 
            IF @ChkError <> 0
            BEGIN
              GOTO EXC3
            END
            INSERT INTO r070dsp
       (datenv,horenv,dirsvr,valstr,retpen,qtdten,cicatu,numfis,codcmd,stacmd,seqenv,logpen,coddsp) 
      VALUES 
      (@l_datenv,@l_horenv,@l_r058cen_dirsvr,@l_straux,@l_retpen,0,0,@l_numfis,@l_codcmd,@l_stacmd,@l_seqenv,@l_logpen,@l_CodDsp)
            SELECT @ChkError = @@Error
            IF @ChkError <> 0
            BEGIN
              GOTO EXC3
            END
          /* END TRY */
          /* BEGIN EXCEPTION HANDLER */
            EXC3:
            SELECT @SE_EXC3 = @ChkError
            IF @ChkError <> 0
            BEGIN
              BEGIN
                SELECT @ChkError = 0
                SELECT @NULL_VAR = 1
				RAISERROR('SP_PorComDSP: Erro na inserção da pendência na R070DSP Insert 1.',11,1) WITH SETERROR
                IF @ChkError <> 0
                BEGIN
                  GOTO EXC2
                END
              END
            END
          /* END EXCEPTION HANDLER */
        END
        FETCH NEXT FROM c_r058cen2 INTO @l_r058cen_dirsvr, @l_r058cen_gersen, @l_r058cen_cenati
      END
      IF @ChkError <> 0
        GOTO EXC2
    /* END TRY */
    /* BEGIN EXCEPTION HANDLER */
      EXC2:
      SELECT @SE_EXC2 = @ChkError
      IF @ChkError <> 0
      BEGIN
        BEGIN
          SELECT @ChkError = 0
          CLOSE c_r058cen2
          SELECT @ChkError = @@Error
          IF @ChkError <> 0
          BEGIN
            GOTO FIM
          END
          SELECT @ChkError = @SE_EXC2
          GOTO FIM
        END
      END
    /* END EXCEPTION HANDLER */
    FNc_r058cen25: /* FINALLY OPEN CURSOR */
    CLOSE c_r058cen2
    SELECT @ChkError = @@Error
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  ELSE
  BEGIN
    WHILE 1=1
    BEGIN
      /* TRY */
		SELECT @l_aux = CHARINDEX(SUBSTRING(',',1,255),@l_cenpen)
        IF (@l_aux=0)
        BEGIN
          SELECT @l_codcen = @l_cenpen
          SELECT @l_cenpen = 'FIM'
        END
        ELSE
        BEGIN
          SELECT @l_codcen = SUBSTRING(@l_cenpen,1,1)
          SELECT @l_cenpen = SUBSTRING(@l_cenpen,(@l_aux+1),(DATALENGTH(@l_cenpen)))
        END
      /* END TRY */
      /* BEGIN EXCEPTION HANDLER */
        EXC4:
        SELECT @SE_EXC4 = @ChkError
        IF @ChkError <> 0
        BEGIN
          BEGIN
            RAISERROR('SP_PorComDSP: Problemas ao Obter a Concentradora.',11,1) WITH SETERROR
            SELECT @ChkError = -30
            GOTO FIM
          END
        END
      /* END EXCEPTION HANDLER */
      /* TRY */
        SELECT 
      @l_dirsvr=r058cen.dirsvr, @l_gersen=r058cen.gersen, @l_cenati=r058cen.cenati
       FROM r058cen r058cen
       WHERE codcen=@l_codcen
        SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
        IF @ChkError <> 0
        BEGIN
          GOTO EXC5
        END
        IF (@l_gersen='S') and (@l_cenati='S')
        BEGIN
          SELECT @l_CodDsp = SUBSTRING(@l_straux,19,9)
          IF (@l_tipope<>3)
          BEGIN
            UPDATE r070dsp SET 
      stacmd=7 
       WHERE numfis=@l_numfis
	  and SUBSTRING(valstr,42,23)=@l_idtpes 
      and stacmd in (0,1,5,8,9) 
      and codcmd=@l_codcmd 
      and dirsvr=@l_dirsvr 
      and coddsp=@l_coddsp
            SELECT @ChkError = @@Error
            IF @ChkError <> 0
            BEGIN
              GOTO EXC5
            END
          END
          ELSE
          BEGIN
            SELECT @l_straux = SUBSTRING(@p_Straux,1,27)+'0'+SUBSTRING(@p_Straux,29,DATALENGTH(@p_Straux)-28)
          END
          /* TRY */
            EXECUTE  @ChkError = SP_RETLOGPEN @l_logpen OUTPUT 
            IF @ChkError <> 0
            BEGIN
              GOTO EXC6
            END
            INSERT INTO r070dsp
       (datenv,horenv,dirsvr,valstr,retpen,qtdten,cicatu,numfis,codcmd,stacmd,seqenv,logpen,coddsp) 
      VALUES 
      (@l_datenv,@l_horenv,@l_dirsvr,@l_straux,@l_retpen,0,0,@l_numfis,@l_codcmd,@l_stacmd,@l_seqenv,@l_logpen,@l_CodDsp)
            SELECT @ChkError = @@Error
            IF @ChkError <> 0
            BEGIN
              GOTO EXC6
            END
          /* END TRY */
          /* BEGIN EXCEPTION HANDLER */
            EXC6:
            SELECT @SE_EXC6 = @ChkError
            IF @ChkError <> 0
            BEGIN
              BEGIN
                SELECT @NULL_VAR = 1
                RAISERROR('SP_PorComDSP: Erro na inserção da pendência na R070DSP Insert 1.',11,1) WITH SETERROR
                SELECT @ChkError = -30
                GOTO EXC5
              END
            END
          /* END EXCEPTION HANDLER */
        END
      /* END TRY */
      /* BEGIN EXCEPTION HANDLER */
        EXC5:
        SELECT @SE_EXC5 = @ChkError
        IF @ChkError <> 0
        BEGIN
          BEGIN
            SELECT @ChkError = 0
            SELECT @NULL_VAR = 1
          END
        END
      /* END EXCEPTION HANDLER */
      IF (@l_cenpen='FIM')
      BEGIN
        BREAK
      END
    END
  END
FIM:
  RETURN @ChkError
END	MSSQL;23
