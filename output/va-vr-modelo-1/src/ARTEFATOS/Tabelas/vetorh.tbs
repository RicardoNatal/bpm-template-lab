DECLARE
l_online      BOOLEAN;
  l_dsppai      NUMBER(9);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) THEN
    IF :NEW.ENDENT = 0 THEN
      BEGIN
        SELECT DSPPAI INTO l_dsppai FROM R058DSP WHERE CODDSP = :NEW.CODDSP;     
      EXCEPTION WHEN OTHERS THEN
        l_dsppai := 0;
      END;
      BEGIN
        INSERT INTO R062HSC (CODDSP, DSPPAI, MODOPE, DATSCO, HORSCO)
        VALUES (:NEW.CODDSP, l_dsppai, :NEW.MODOPE, :NEW.DATSCO, :NEW.HORSCO);
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no INSERT em R062HSC.';
      END;
    END IF;
  END IF;
END␀uØ␀␀		SENIOR;0ï␀␀

TRIGGER R062SCO_EU AFTER UPDATE ON R062SCO FOR EACH ROW

DECLARE
l_online      BOOLEAN;
  l_dsppai      NUMBER(9);
BEGIN
  IF :NEW.MODOPE <> :OLD.MODOPE THEN
    SP_VerOnLine(l_online OUT);
    IF (l_online = TRUE) THEN
      IF :NEW.ENDENT = 0 THEN
        BEGIN
          SELECT DSPPAI INTO l_dsppai FROM R058DSP WHERE CODDSP = :NEW.CODDSP;
        EXCEPTION WHEN OTHERS THEN
          l_dsppai := 0;
        END;
        BEGIN
          INSERT INTO R062HSC (CODDSP, DSPPAI, MODOPE, DATSCO, HORSCO)
          VALUES (:NEW.CODDSP, l_dsppai, :NEW.MODOPE, :NEW.DATSCO, :NEW.HORSCO);
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro no INSERT em R062HSC.';
        END;
      END IF;
    END IF;
  END IF;
END␀sØ␀␀		SENIOR;0…␀␀

TRIGGER R062SCO_ED AFTER DELETE ON R062SCO FOR EACH ROW

DECLARE
l_online      BOOLEAN;
BEGIN
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) THEN
    IF :OLD.ENDENT = 0 THEN
      BEGIN 
        DELETE FROM R062HSC WHERE CODDSP = :OLD.CODDSP;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no DELETE em R062HSC.';
      END;
