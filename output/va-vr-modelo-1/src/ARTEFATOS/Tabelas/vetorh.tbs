DECLARE
	l_DatIni   R583REV.DatIni%TYPE;
	l_DatTer   R583REV.DatTer%TYPE;
	l_CodPra   R583REV.CodPra%TYPE;
	l_CodGhe   R583REV.CodGHE%TYPE;
	l_RevGhe   R583REV.RevGHE%TYPE;
	l_DatAlt   R583INF.DatAlt%TYPE;
	l_DatZero DATE;

	TYPE t_r583INF_aux IS RECORD(
		NUMAMB   R583INF_AUX.NUMAMB%TYPE,
		DATALT   R583INF_AUX.DATALT%TYPE,
		DESAMB   R583INF_AUX.DESAMB%TYPE,
		CNDAMB   R583INF_AUX.CNDAMB%TYPE);	
    l_R583INF_aux t_R583INF_aux;
	
    CURSOR C_R583REV IS SELECT CODPRA,CODGHE,REVGHE,DATINI,DATTER FROM R583REV REV
    WHERE REV.NUMAMB = l_R583INF_aux.NUMAMB
    AND (REV.DATINI >= DATETIME(01,MONTH(l_R583INF_aux.DATALT),YEAR(l_R583INF_aux.DATALT),0,0,0) OR (REV.DATINI <= DATETIME(01,MONTH(l_R583INF_aux.DATALT),YEAR(l_R583INF_aux.DATALT),0,0,0) AND (REV.DATTER >= DATETIME(01,MONTH(l_R583INF_aux.DATALT),YEAR(l_R583INF_aux.DATALT),0,0,0) OR (REV.DATTER =  l_DatZero))));

	CURSOR C_R583INF_Aux IS SELECT NUMAMB, DATALT,DESAMB,CNDAMB FROM R583INF_Aux;

BEGIN
	l_DatZero := DATETIME(31, 12, 1900, 0, 0, 0);
	FOREACH C_R583INF_Aux INTO l_R583INF_aux.NUMAMB,l_R583INF_aux.DATALT,l_R583INF_aux.DESAMB,l_R583INF_aux.CNDAMB
	LOOP
		FOREACH C_R583REV INTO l_CodPra,l_CodGhe,l_RevGhe, l_datIni, l_DatTer
		LOOP
			IF (l_DatTer <> l_DatZero) THEN	
				SELECT INF.DATALT
				INTO l_datalt
				FROM R583INF INF
				WHERE INF.NUMAMB = l_R583INF_aux.NUMAMB
				AND INF.DATALT = (SELECT MAX(INF2.DATALT)
									 FROM R583INF INF2 
									 WHERE INF2.NUMAMB = INF.NUMAMB 
									 AND DATETIME(01,MONTH(INF2.DATALT),YEAR(INF2.DATALT),0,0,0) <= DATETIME(01,MONTH(l_DatTer),YEAR(l_DatTer),0,0,0));
			ELSE
				BEGIN
					SELECT INF.DATALT
					INTO l_datalt
					FROM R583INF INF
					WHERE INF.NUMAMB = l_R583INF_aux.NUMAMB
					AND INF.DATALT = (SELECT MAX(INF2.DATALT)
									 FROM R583INF INF2 
									 WHERE INF2.NUMAMB = INF.NUMAMB 
									 AND DATETIME(01,MONTH(INF2.DATALT),YEAR(INF2.DATALT),0,0,0) >= DATETIME(01,MONTH(l_datIni),YEAR(l_datIni),0,0,0)); 
				EXCEPTION WHEN NO_DATA_FOUND THEN
					SELECT INF.DATALT
					INTO l_datalt
					FROM R583INF INF
					WHERE INF.NUMAMB = l_R583INF_aux.NUMAMB
					AND INF.DATALT = (SELECT MAX(INF2.DATALT)
									 FROM R583INF INF2 
									 WHERE INF2.NUMAMB = INF.NUMAMB 
									AND DATETIME(01,MONTH(INF2.DATALT),YEAR(INF2.DATALT),0,0,0) <= DATETIME(01,MONTH(l_datIni),YEAR(l_datIni),0,0,0)); 
				END;
			END IF;
			IF (l_datalt = l_R583INF_aux.DATALT) THEN
				BEGIN					
					UPDATE R583REV
					SET DESARI =  l_R583INF_aux.DESAMB, CONAMB = l_R583INF_aux.CNDAMB
					WHERE CODPRA = l_CodPra AND
					CODGHE = l_CodGhe AND
					REVGHE = l_RevGhe;	
				EXCEPTION WHEN OTHERS THEN
					RAISERROR 103 'Erro ao atualizar tabela R583REV';
				END;
			END IF;
		END LOOP;
	END LOOP;	
	BEGIN
		DELETE FROM R583INF_AUX;
		DROP_TEMP_TABLE R583INF_AUX;
	EXCEPTION WHEN OTHERS THEN
		NULL;
	END;
END␀4ê␀␀	SENIOR;0“␀␀

TRIGGER R583INF_SU AFTER UPDATE ON R583INF

DECLARE	
	l_DatZero DATE;
	l_DatIni   R583REV.DatIni%TYPE;
	l_DatTer   R583REV.DatTer%TYPE;
	l_CodPra   R583REV.CodPra%TYPE;
	l_CodGhe   R583REV.CodGHE%TYPE;
	l_RevGhe   R583REV.RevGHE%TYPE;
	l_DatAlt   R583INF.DatAlt%TYPE;

	TYPE t_r583INF_aux IS RECORD(
		NUMAMB   R583INF_AUX.NUMAMB%TYPE,
		DATALT   R583INF_AUX.DATALT%TYPE,
		DESAMB   R583INF_AUX.DESAMB%TYPE,
		CNDAMB   R583INF_AUX.CNDAMB%TYPE);
    l_R583INF_aux t_R583INF_aux;
	
	CURSOR C_R583REV IS SELECT CODPRA,CODGHE,REVGHE,DATINI,DATTER FROM R583REV REV
	WHERE REV.NUMAMB = l_R583INF_aux.NUMAMB
    AND (REV.DATINI >= DATETIME(01,MONTH(l_R583INF_aux.DATALT),YEAR(l_R583INF_aux.DATALT),0,0,0) OR (REV.DATINI <= DATETIME(01,MONTH(l_R583INF_aux.DATALT),YEAR(l_R583INF_aux.DATALT),0,0,0) AND (REV.DATTER >= DATETIME(01,MONTH(l_R583INF_aux.DATALT),YEAR(l_R583INF_aux.DATALT),0,0,0) OR (REV.DATTER =  l_DatZero))));
   
	CURSOR C_R583INF_Aux IS SELECT NUMAMB, DATALT,DESAMB,CNDAMB FROM R583INF_Aux;
	
BEGIN
	l_DatZero := DATETIME(31, 12, 1900, 0, 0, 0);
	FOREACH C_R583INF_Aux INTO l_R583INF_aux.NUMAMB,l_R583INF_aux.DATALT,l_R583INF_aux.DESAMB,l_R583INF_aux.CNDAMB
	LOOP
		FOREACH C_R583REV INTO l_CodPra,l_CodGhe,l_RevGhe, l_datIni, l_DatTer
		LOOP
			IF (l_DatTer <> l_DatZero) THEN
				SELECT INF.DATALT
				INTO l_datalt
				FROM R583INF INF
				WHERE INF.NUMAMB = l_R583INF_aux.NUMAMB
				AND INF.DATALT = (SELECT MAX(INF2.DATALT)
									 FROM R583INF INF2 
									 WHERE INF2.NUMAMB = INF.NUMAMB 
									AND DATETIME(01,MONTH(INF2.DATALT),YEAR(INF2.DATALT),0,0,0) <= DATETIME(01,MONTH(l_DatTer),YEAR(l_DatTer),0,0,0));
			ELSE
				BEGIN
					SELECT INF.DATALT
					INTO l_datalt
					FROM R583INF INF
					WHERE INF.NUMAMB = l_R583INF_aux.NUMAMB
					AND INF.DATALT = (SELECT MAX(INF2.DATALT)
									 FROM R583INF INF2 
									 WHERE INF2.NUMAMB = INF.NUMAMB 
									 AND DATETIME(01,MONTH(INF2.DATALT),YEAR(INF2.DATALT),0,0,0) >= DATETIME(01,MONTH(l_datIni),YEAR(l_datIni),0,0,0));
				EXCEPTION WHEN NO_DATA_FOUND THEN
					SELECT INF.DATALT
					INTO l_datalt
					FROM R583INF INF
					WHERE INF.NUMAMB = l_R583INF_aux.NUMAMB
					AND INF.DATALT = (SELECT MAX(INF2.DATALT)
									 FROM R583INF INF2 
									 WHERE INF2.NUMAMB = INF.NUMAMB 
									 AND DATETIME(01,MONTH(INF2.DATALT),YEAR(INF2.DATALT),0,0,0) <= DATETIME(01,MONTH(l_datIni),YEAR(l_datIni),0,0,0));
				END;
			END IF;
			IF (l_datalt = l_R583INF_aux.DATALT) THEN
				BEGIN
					UPDATE R583REV
					SET DESARI = l_R583INF_aux.DESAMB, CONAMB = l_R583INF_aux.CNDAMB
					WHERE CODPRA = l_CodPra AND
					CODGHE = l_CodGhe AND
					REVGHE = l_RevGhe;
				EXCEPTION WHEN OTHERS THEN
					RAISERROR 103 'Erro ao atualizar tabela R583REV';
				END;
			END IF;
		END LOOP;
	END LOOP;
	BEGIN
		DELETE FROM R583INF_AUX;
		DROP_TEMP_TABLE R583INF_AUX;
	EXCEPTION WHEN OTHERS THEN
		NULL;
	END;
END␀2ê␀␀	SENIOR;0␀␀␀

TRIGGER R583INF_SD AFTER DELETE ON R583INF

DECLARE
	l_DatZero DATE;
	l_DatIni   R583REV.DatIni%TYPE;
	l_DatTer   R583REV.DatTer%TYPE;
	l_DatAlt   R583INF.DatAlt%TYPE;
	l_CodPra   R583REV.CodPra%TYPE;
	l_CodGhe   R583REV.CodGHE%TYPE;
	l_RevGhe   R583REV.RevGHE%TYPE;
	l_DesAmb   R583INF.DesAmb%TYPE;
	l_CndAmb   R583INF.CndAmb%TYPE;
	
	TYPE t_r583INF_aux IS RECORD(
		NUMAMB   R583INF_AUX.NUMAMB%TYPE,
		DATALT   R583INF_AUX.DATALT%TYPE);
    l_R583INF_aux t_R583INF_aux;
	
    CURSOR C_R583REV IS SELECT CODPRA,CODGHE,REVGHE,DATINI,DATTER FROM R583REV REV
    WHERE REV.NUMAMB = l_R583INF_aux.NUMAMB
    AND (REV.DATINI >= DATETIME(01,MONTH(l_R583INF_aux.DATALT),YEAR(l_R583INF_aux.DATALT),0,0,0) OR (REV.DATINI <= DATETIME(01,MONTH(l_R583INF_aux.DATALT),YEAR(l_R583INF_aux.DATALT),0,0,0) AND (REV.DATTER >= DATETIME(01,MONTH(l_R583INF_aux.DATALT),YEAR(l_R583INF_aux.DATALT),0,0,0) OR (REV.DATTER =  l_DatZero))));
    
    CURSOR C_R583INF_Aux IS SELECT NUMAMB, DATALT FROM R583INF_Aux;

BEGIN	
	l_DatZero := DATETIME(31, 12, 1900, 0, 0, 0);
	FOREACH C_R583INF_Aux INTO l_R583INF_aux.NUMAMB,l_R583INF_aux.DATALT
	LOOP
		FOREACH C_R583REV INTO l_CodPra,l_CodGhe,l_RevGhe, l_DatIni, l_DatTer
		LOOP
			BEGIN
				IF (l_DatTer <> l_DatZero) THEN
					SELECT INF.DATALT,INF.CNDAMB,INF.DESAMB
					INTO l_datalt,l_CndAmb,l_DesAmb
					FROM R583INF INF
					WHERE INF.NUMAMB = l_R583INF_aux.NUMAMB
					AND INF.DATALT = (SELECT MAX(INF2.DATALT)
									 FROM R583INF INF2 
									 WHERE INF2.NUMAMB = INF.NUMAMB 
									 AND DATETIME(01,MONTH(INF2.DATALT),YEAR(INF2.DATALT),0,0,0) <= DATETIME(01,MONTH(l_DatTer),YEAR(l_DatTer),0,0,0));
				ELSE
					BEGIN
						SELECT INF.DATALT,INF.CNDAMB,INF.DESAMB
						INTO l_datalt,l_CndAmb,l_DesAmb
						FROM R583INF INF
						WHERE INF.NUMAMB = l_R583INF_aux.NUMAMB
						AND INF.DATALT = (SELECT MAX(INF2.DATALT)
									 FROM R583INF INF2 
									 WHERE INF2.NUMAMB = INF.NUMAMB 
									 AND DATETIME(01,MONTH(INF2.DATALT),YEAR(INF2.DATALT),0,0,0) >= DATETIME(01,MONTH(l_DatIni),YEAR(l_DatIni),0,0,0));
					
					EXCEPTION WHEN NO_DATA_FOUND THEN
						SELECT INF.DATALT,INF.CNDAMB,INF.DESAMB
						INTO l_datalt,l_CndAmb,l_DesAmb
						FROM R583INF INF
						WHERE INF.NUMAMB = l_R583INF_aux.NUMAMB
						AND INF.DATALT = (SELECT MAX(INF2.DATALT)
									 FROM R583INF INF2 
									 WHERE INF2.NUMAMB = INF.NUMAMB 
									 AND DATETIME(01,MONTH(INF2.DATALT),YEAR(INF2.DATALT),0,0,0) <= DATETIME(01,MONTH(l_DatIni),YEAR(l_DatIni),0,0,0));
					END;
				END IF;
			EXCEPTION WHEN NO_DATA_FOUND THEN
				l_DesAmb := '';
				l_CndAmb := '';
			END;			
			BEGIN	
				UPDATE R583REV
				SET DESARI = l_DesAmb, CONAMB = l_CndAmb
				WHERE CODPRA = l_CodPra AND
				CODGHE = l_CodGhe AND
				REVGHE = l_RevGhe;
			EXCEPTION WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar tabela R583REV';
			END;
		END LOOP;
	END LOOP;
	BEGIN
		DELETE FROM R583INF_AUX;
		DROP_TEMP_TABLE R583INF_AUX;
	EXCEPTION WHEN OTHERS THEN
		NULL;
	END;
END␀␀␀Ô$␀␀␀␀␀1ê␀␀V¬␀␀Á␀€␀␀␀␀␀␀È?aay␀Æÿ␀␀ê␀␀␀mDÑ␀€␀␀␀␀␀␀ÁKşEşEœ␀␀␀êÿ␀␀ÿ␀şS‚␀€␀␀␀␀␀␀‰YÛU°X␀␀ÿ␀␀ÿ␀+G€␀␀␀␀␀␀Š2d2€2␀␀ÿ␀␀ÿ␀␀␀␀␀␀␀Ô$␀␀␀␀␀5ê␀␀$-Ì␀	€␀␀␀␀␀␀ö?•¸␀␀Â;{␀Æÿ␀␀.#␀ ,Ì␀	€␀␀␀␀␀␀ö?•¸␀␀Â;{␀Æÿ␀␀##␀~ô␀␀	€␀␀␀␀␀␀è=ô␀␀šô␀␀\␀␀␀ÿ␀␀Rì␀␀␀ú+¼␀	€␀␀␀␀␀␀AX¿␀␀X¿␀␀v␀Æÿ␀␀#␀t-­␀	€␀␀␀␀␀␀–Bş;ş;p␀Æÿ␀␀ÿ␀FU€␀€␀␀␀␀␀␀õYïô␀␀ïô␀␀w␀␀ÿ␀␀ÿ␀L␀␀¼␀€␀␀␀␀␀␀/␀'␀+␀v␀Æÿ␀␀[ê␀␀␀ß¦␀␀Š␀€␀␀␀␀␀␀¯␀␀RÆ␀␀RÆ␀␀n␀␀Æÿ␀␀_ê␀␀␀ä¦␀␀Š␀€␀␀␀␀␀␀¯␀␀–␀␀–␀␀n␀␀Æÿ␀␀aê␀␀␀Á¦␀␀Š␀€␀␀␀␀␀␀ì®␀␀±®␀␀±®␀␀n␀␀Æÿ␀␀]ê␀␀␀¤*9€␀␀␀␀␀␀k/Ù*Ù*:␀␀␀ÿ␀␀ÿ␀$␀´␀€␀␀␀␀␀␀9$␀´ó␀␀´ó␀␀r␀␀Æÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀ñq␀␀␀␀␀␀␀␀␀␀␀␀␀6ê␀␀$-Ì␀	␀␀␀␀␀␀ö?•¸␀␀Â;{␀Æÿ␀␀.#␀ ,Ì␀	␀␀␀␀␀␀x@áqw@{␀Æÿ␀␀##␀~ô␀␀	␀␀␀␀␀␀è=ô␀␀šô␀␀\␀␀␀ÿ␀␀Rì␀␀␀ú+¼␀	␀␀␀␀␀␀AX¿␀␀X¿␀␀v␀Æÿ␀␀#␀&EÑ␀€␀␀␀␀␀␀'MÙEõGqC␀êÿ␀␀ÿ␀§w·␀€␀␀␀␀␀␀Şyıw™xì*␀␀Æÿ␀␀ÿ␀ïw·␀€␀␀␀␀␀␀¼y6␀ßxì*␀␀Æÿ␀␀ÿ␀A␀ª€␀␀␀␀␀␀Lµ␀␀Dµ␀␀SÍ␀␀D␀␀ÿ␀␀ÿ␀WË␀␀”␀€␀␀␀␀␀␀iÍ␀␀OÍ␀␀SÍ␀␀^␀Æÿ␀␀ÿ␀F␀ª€␀␀␀␀␀␀Nµ␀␀Kµ␀␀UÍ␀␀D␀␀ÿ␀␀ÿ␀ZË␀␀”␀€␀␀␀␀␀␀jÍ␀␀¯Ë␀␀UÍ␀␀^␀Æÿ␀␀ÿ␀B␀ª€␀␀␀␀␀␀Mµ␀␀Hµ␀␀PÍ␀␀D␀␀ÿ␀␀ÿ␀XË␀␀”␀€␀␀␀␀␀␀oÍ␀␀®Ë␀␀PÍ␀␀^␀Æÿ␀␀ÿ␀'(␀”␀€␀␀␀␀␀␀Ó®␀␀Ú—␀␀Ú—␀␀^␀Æÿ␀␀ÿ␀û'␀”␀€␀␀␀␀␀␀Ò®␀␀_˜␀␀_˜␀␀^␀Æÿ␀␀ÿ␀(␀”␀€␀␀␀␀␀␀û®␀␀y¥␀␀y¥␀␀^␀Æÿ␀␀ÿ␀7	␀´␀€␀␀␀␀␀␀1>(␀(␀r␀Æÿ␀␀·Û␀␀␀tl€␀␀␀␀␀␀utíô␀␀`tn␀Æÿ␀␀ÿ␀¸¦␀␀”␀€␀␀␀␀␀␀Ü“␀␀¶®␀␀¶®␀␀^␀Æÿ␀␀ÿ␀™␀␀”␀€␀␀␀␀␀␀Ù“␀␀Ş˜␀␀Ş˜␀␀^␀Æÿ␀␀ÿ␀üÉ␀␀¾␀€␀␀␀␀␀␀Ã^Ã^Ã^\␀Æÿ␀␀ÿ␀ ␀␀d€␀␀␀␀␀␀(␀␀!␀␀