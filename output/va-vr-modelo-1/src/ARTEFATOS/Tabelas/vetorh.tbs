)␀␀


PROCEDURE SP_PEND93(p_TipDoc INTEGER, p_NumDoc VARCHAR2(20), p_NumCra NUMBER, p_CodPrm NUMBER, p_TipVis NUMBER, p_AndVis NUMBER)
 IS

  l_Comando             VARCHAR2(2047);
  l_DatEnv              CHAR(16);
  l_datatu_str   		CHAR(16);
  l_Data_Atual          DATE;
  l_Hora_Atual          NUMBER(4);
  l_Data_Zero           DATE;
  l_SeqEnv              NUMBER(2);
  l_DatStr              CHAR(6);
  l_HorStr              CHAR(4);
  l_SeqStr              CHAR(2);
 
  /* Variaveis SP_MAPFIS */
  l_CraPri              NUMBER(12);
  l_TecPri              NUMBER(1);
  l_NumBar              NUMBER(12);
  l_NumPro              NUMBER(12);
  l_NumSma              NUMBER(12);
  
  /* Variaveis dos Crachas */
  l_NumCra              CHAR(12);
  l_NumFis              CHAR(12);
  l_TipCra              CHAR(2);
  l_IniVal              CHAR(16);
  l_DatVal              CHAR(16);
  l_SitCra              CHAR(2);
  l_TecCra              CHAR(2);
  l_CmdCra              VARCHAR2(1023);
  l_QntCra              NUMBER(9);
  l_QntCra_str          CHAR(9);
  l_PrmAut              CHAR(5);

  l_CodPrm              CHAR(5);
  l_IdtPes              VARCHAR2(23);
  l_TipDoc              CHAR(1);
  l_SegTDo              NUMBER(1);
  l_SegDoc              VARCHAR2(20);
  l_TipDocCon_int       NUMBER(1);
  l_TipDocCon           VARCHAR2(1);
  l_NumDocCon           VARCHAR2(20);
  l_TamDoc              NUMBER(2);
  l_TamDoc_str          CHAR(2);
  l_TamNom              NUMBER(2);
  l_TamNom_str          CHAR(2);
  l_NomVis              VARCHAR2(40);
  l_TipVis              CHAR(3);
  l_AndVis              CHAR(3);  
  

  /* Variaveis perm. area restrita */
  l_TemPev              NUMBER(4);
  l_TemPev_str          CHAR(1);
  
  /* Variaveis perm. p/ local fisico/disp. */
  l_TemPrm              NUMBER(4);
  l_TemPrm_str          CHAR(1);

  /* Variaveis mensagem ao visitante */
  l_DesMsg              VARCHAR2(32);
  l_DatMsg              VARCHAR2(16);
  l_QtdMsg              VARCHAR2(2);

  /* Variaveis credito de acesso visitante */
  l_CreFx1              CHAR(2);
  l_Fx1                 CHAR(8);
  l_CreFx2              CHAR(2);
  l_Fx2                 CHAR(8);
  l_CreFx3              CHAR(2);
  l_Fx3                 CHAR(8);
  l_CreFx4              CHAR(2);
  l_Fx4                 CHAR(8);
  l_CreFx5              CHAR(2);
  l_Fx5                 CHAR(8);
  l_CreFx6              CHAR(2);
  l_Fx6                 CHAR(8); 
  
  l_CmdBio              VARCHAR2(31);
  l_CodTbi              CHAR(2);
  l_QntBio              NUMBER(2);
  l_QntBio_str          CHAR(2);

  /* Cursor que obtem os crachas da Pessoa */
  CURSOR c_r070con IS
  SELECT NUMCRA, NUMFIS, TIPCRA, INIVAL, DATVAL, SITCRA, TECCRA
  FROM R070CON WHERE IDTPES = l_IdtPes AND ( SUBSTRING(DATVAL,5,2)||SUBSTRING(DATVAL,3,2)||
                     SUBSTRING(DATVAL,1,2)||SUBSTRING(DATVAL,7,10) ) > l_datatu_str;
  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NUMCRA%TYPE,
    NUMFIS   R070CON.NUMFIS%TYPE,
    TIPCRA   R070CON.TIPCRA%TYPE,
    INIVAL   R070CON.INIVAL%TYPE,
    DATVAL   R070CON.DATVAL%TYPE,
    SITCRA   R070CON.SITCRA%TYPE,
    TECCRA   R070CON.TECCRA%TYPE);
  l_r070con t_r070con;

  /* Cursor c/ os registros da tabela R070BIO */
  CURSOR c_r070bio IS SELECT CODTBI FROM R070BIO WHERE IDTPES = l_idtpes GROUP BY CODTBI;
  TYPE t_r070bio IS RECORD(
    CODTBI   R070BIO.CodTbi%TYPE);
  l_r070bio t_r070bio;

BEGIN
  /* Inicializacoes */
  /* Obtem a data/hora de envio da pendencia. */
  l_Data_Atual := CURDATE();
  l_Hora_Atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_Data_Atual,'DDMMYY', l_DatStr OUT);
  SP_INTSTR(l_Hora_Atual,'HHMM',l_HorStr OUT);
  /* Obtem o Segundo */
  l_SeqEnv := SECOND(CURTIME());
  SP_INTSTR(l_SeqEnv, '99', l_SeqStr OUT);
  l_DatEnv := l_DatStr||l_HorStr||l_SeqStr||'0000';
  l_PrmAut := '00000'; /*Se nao for cracha de autorizacao de entrada permissao de autorizacao eh zero.*/
  l_Data_Zero  := '31/12/1900,00:00:00';
  
  l_datatu_str := SUBSTRING(l_DatStr, 5,2) || SUBSTRING(l_DatStr, 3,2)
                    || SUBSTRING(l_DatStr, 1,2) || l_HorStr || '000000';

  /* Obtem o Cracha Principal */
  SP_MAPFIS(p_NumCra, l_NumBar OUT, l_NumPro OUT, l_NumSma OUT, l_TecPri OUT, l_CraPri OUT);
  IF (l_CraPri = 0) THEN
      l_CraPri := p_NumCra;
  END IF;
  
  SP_INTSTR(p_CodPrm, '99999', l_CodPrm OUT);
  SP_INTSTR(p_TipVis, '999', l_TipVis OUT);  

  IF (p_AndVis IS NULL) THEN
     SP_INTSTR(0, '999', l_AndVis OUT);
  ELSE
     SP_INTSTR(p_AndVis, '999', l_AndVis OUT);
  END IF;

  /* Obtem o IDTPES */
  SP_INTSTR(p_TipDoc, '9', l_TipDoc OUT);
  l_IdtPes := '04'||l_TipDoc||p_NumDoc;

  /* Preenche o campo com espaços para completar 23 posicoes para o identificador da pessoa */
  l_IdtPes := lTrim(l_IdtPes);
  l_IdtPes := rTrim(l_IdtPes);
  LOOP
      /*Controle do Loop.*/
      IF (length(l_IdtPes) > 22) THEN
          EXIT;
      END IF;
      l_IdtPes := ' '||l_IdtPes;
  END LOOP;
  
  SP_RET_DOC_CONTCPF(l_TipDoc, p_NumDoc, l_TipDocCon_int OUT, l_NumDocCon OUT);
  SP_INTSTR(l_TipDocCon_int, '9', l_TipDocCon OUT);

  /* Busca o nome do visitante */
  BEGIN
	  SELECT NOMVIS INTO l_NomVis FROM R090VIS
          WHERE TIPDOC = p_TipDoc AND NUMDOC = p_NumDoc;
  EXCEPTION
      WHEN OTHERS THEN
          l_NomVis := '';
  END;
  
  /* Pega o tamanho do nome do visitante */
  l_TamNom := length(l_NomVis);
  SP_INTSTR(l_TamNom, '99', l_TamNom_str OUT);

  l_TamDoc := length(l_NumDocCon);
  SP_INTSTR(l_TamDoc, '99', l_TamDoc_str OUT);
  /* ---------- */

  /* Verifica se o visitante possui permissao de area restrita */
  BEGIN
      SELECT COUNT(*) INTO l_TemPev
              FROM R070PEV
          WHERE R070PEV.TIPDOC = p_TipDoc AND
              R070PEV.NUMDOC = p_NumDoc AND
              R070PEV.STAACC = 1 AND
              (R070PEV.DATFIM = l_data_zero OR R070PEV.DATFIM > l_Data_Atual OR
              (R070PEV.DATFIM = l_Data_Atual AND R070PEV.HORFIM > l_Hora_Atual));
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
          l_TemPev := 0;
      WHEN OTHERS THEN
          l_TemPev := 0;
  END;
  IF (l_TemPev = 0) THEN
      l_TemPev_str := '0';      
  ELSE 
      l_TemPev_str := '1';  
  END IF;
  /* ---------- */

  /* Verifica se o visitante possui permissao por local fisico/dispositivo */
  BEGIN
      SELECT COUNT(*)  INTO l_TemPrm
              FROM R034PRM
          WHERE R034PRM.IDTPES = l_IdtPes;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
          l_TemPrm := 0;
      WHEN OTHERS THEN
          l_TemPrm := 0;
  END;
  
  IF (l_TemPrm = 0) THEN
      l_TemPrm_str := '0';      
  ELSE 
      l_TemPrm_str := '1';  
  END IF;
  
  /* ---------- */

  /* Busca as mensagens do visitante */
  SP_RETMSV (p_TipDoc, p_NumDoc, l_DesMsg OUT, l_DatMsg OUT, l_QtdMsg OUT);
  /* Preenche o campo com espaços para completar 32 posicoes (maximo) para a mensagem */
  l_DesMsg := rTrim(l_DesMsg);
  LOOP
      /*Controle do Loop.*/
      IF (length(l_DesMsg) > 31) THEN
          EXIT;
      END IF;
      l_DesMsg := l_DesMsg||' ';
  END LOOP;

  /* Busca os creditos de acesso do visitante */
  SP_RETCRV (p_TipDoc, p_NumDoc, l_CreFx1 OUT, l_Fx1 OUT, l_CreFx2 OUT, l_Fx2 OUT, l_CreFx3 OUT, l_Fx3 OUT, l_CreFx4 OUT, l_Fx4 OUT, l_CreFx5 OUT, l_Fx5 OUT, l_CreFx6 OUT, l_Fx6 OUT);

  /* Montagem do(s) Crachas */
  l_CmdCra := '';
  l_QntCra := 0;
  FOREACH c_r070con INTO l_r070con.NumCra, l_r070con.NumFis, l_r070con.TipCra, l_r070con.IniVal,
                         l_r070con.DatVal, l_r070con.SitCra, l_r070con.TecCra LOOP
      /* Numero do Cracha */
      SP_INTSTR(l_r070con.NumCra,'999999999999',l_NumCra OUT);
      /* Numero Fisico do Cracha */
      SP_INTSTR(l_r070con.NumFis,'999999999999',l_NumFis OUT);
      /* Tipo do Cartao */
      SP_INTSTR(l_r070con.TipCra,'99',l_TipCra OUT);
      /* Data Inicial */
      l_IniVal := lTrim(l_r070con.IniVal);
      l_IniVal := rTrim(l_r070con.IniVal);
      IF (l_IniVal IS NULL) THEN
          l_IniVal:= '0000000000000000';
      END IF;
      LOOP
          /* Controle do Loop */
          IF (Length(l_IniVal) > 15) THEN
              EXIT;
          END IF;
          l_IniVal := l_IniVal||'0';
      END LOOP;
      /* Data Final */
      l_DatVal := lTrim(l_r070con.DatVal);
      l_DatVal := rTrim(l_r070con.DatVal);
      IF (l_DatVal IS NULL) THEN
          l_DatVal:= '0000000000000000';
      END IF;
      LOOP
          /* Controle do Loop */
          IF (Length(l_DatVal) > 15 ) THEN
              EXIT;
          END IF;
          l_DatVal := l_DatVal||'0';
      END LOOP;
			
      /* Sitacao do Cracha */
      SP_INTSTR(l_r070con.SitCra,'99',l_SitCra OUT);
      IF (l_SitCra = '00') THEN
          l_SitCra := '10';
          /* Retirei o envio da pendencia 05 - LockCard.
           * Eh preciso testar a concessao do cracha a um visitante atraves da pendencia 93, fazer a saida do visitante 
           * (e consequentemente a baixa do cracha), e uma nova entrada, com o mesmo nro de cracha, para ver o
           * comportamento. O cracha tem que estar liberado para esta nova entrada de visitante.
           * Nao deve ser gerada a pendencia de LockCard para cada cracha. Se necessitar liberar os crachas
           * anteriores associados ao idtpes, que o tratamento seja efetuado ao receber a string com os crachas, abaixo
           */
      END IF;

      /* Tecnologia do Cracha */
      SP_INTSTR(l_r070con.TecCra,'99',l_TecCra OUT);

      /* Monta o comando dos crachas */
      l_CmdCra := l_CmdCra||l_NumFis||l_TipCra||l_IniVal||l_DatVal||l_SitCra||l_TecCra||l_NumCra||l_PrmAut;
      l_QntCra := l_QntCra + 1;
  END LOOP;
  SP_INTSTR(l_QntCra, '999999999', l_QntCra_str OUT);
  /* ---------- */

  /* Montagem da(s) Tecnologia(s) Biometrica(s) */
  l_CmdBio := '';
  l_QntBio := 0;
  FOREACH c_r070bio INTO l_r070bio.CodTbi
  LOOP
    SP_INTSTR(l_r070bio.CodTbi, '99', l_CodTbi OUT);
    l_CmdBio := l_CmdBio||l_CodTbi;
    l_QntBio := l_QntBio + 1;
  END LOOP;
  SP_INTSTR(l_QntBio, '99', l_QntBio_str OUT);
  /* ---------- */


  /* Montagem do comando 93 - IncludeVisitorEntrance */
  l_Comando := '93'||l_DatEnv||l_IdtPes||l_TamNom_str||l_NomVis||l_CodPrm||l_TipDocCon||l_TamDoc_str||l_NumDocCon||l_TemPev_str||l_TemPrm_str||
      l_DatMsg||l_QtdMsg||l_DesMsg||l_CreFx1||l_CreFx2||l_CreFx3||l_CreFx4||l_CreFx5||l_CreFx6||l_Fx1||l_Fx2||l_Fx3||l_Fx4||l_Fx5||l_Fx6||
      l_TipVis||l_AndVis||l_QntCra_str||l_CmdCra||l_QntBio_str||l_CmdBio;

  /* Envia a Pendencia com parametro zero = envia para todas as CSM */
  SP_PorCom(l_Comando, '0');  
END		SENIOR;21VSP_DATSTR
SP_INTSTR
SP_MAPFIS
SP_RETMSV
SP_RETCRV
SP_PORCOM
SP_RET_DOC_CONTCPF
)␀␀


PROCEDURE SP_PEND93(p_TipDoc INTEGER, p_NumDoc VARCHAR2(20), p_NumCra NUMBER, p_CodPrm NUMBER, p_TipVis NUMBER, p_AndVis NUMBER)
 IS

  l_Comando             VARCHAR2(2047);
  l_DatEnv              CHAR(16);
  l_datatu_str   		CHAR(16);
  l_Data_Atual          DATE;
  l_Hora_Atual          NUMBER(4);
  l_Data_Zero           DATE;
  l_SeqEnv              NUMBER(2);
  l_DatStr              CHAR(6);
  l_HorStr              CHAR(4);
  l_SeqStr              CHAR(2);
 
  /* Variaveis SP_MAPFIS */
  l_CraPri              NUMBER(12);
  l_TecPri              NUMBER(1);
  l_NumBar              NUMBER(12);
  l_NumPro              NUMBER(12);
  l_NumSma              NUMBER(12);
  
  /* Variaveis dos Crachas */
  l_NumCra              CHAR(12);
  l_NumFis              CHAR(12);
  l_TipCra              CHAR(2);
  l_IniVal              CHAR(16);
  l_DatVal              CHAR(16);
  l_SitCra              CHAR(2);
  l_TecCra              CHAR(2);
  l_CmdCra              VARCHAR2(1023);
  l_QntCra              NUMBER(9);
  l_QntCra_str          CHAR(9);
  l_PrmAut              CHAR(5);

  l_CodPrm              CHAR(5);
  l_IdtPes              VARCHAR2(23);
  l_TipDoc              CHAR(1);
  l_SegTDo              NUMBER(1);
  l_SegDoc              VARCHAR2(20);
  l_TipDocCon_int       NUMBER(1);
  l_TipDocCon           VARCHAR2(1);
  l_NumDocCon           VARCHAR2(20);
  l_TamDoc              NUMBER(2);
  l_TamDoc_str          CHAR(2);
  l_TamNom              NUMBER(2);
  l_TamNom_str          CHAR(2);
  l_NomVis              VARCHAR2(40);
  l_TipVis              CHAR(3);
  l_AndVis              CHAR(3);  
  

  /* Variaveis perm. area restrita */
  l_TemPev              NUMBER(4);
  l_TemPev_str          CHAR(1);
  
  /* Variaveis perm. p/ local fisico/disp. */
  l_TemPrm              NUMBER(4);
  l_TemPrm_str          CHAR(1);

  /* Variaveis mensagem ao visitante */
  l_DesMsg              VARCHAR2(32);
  l_DatMsg              VARCHAR2(16);
  l_QtdMsg              VARCHAR2(2);

  /* Variaveis credito de acesso visitante */
  l_CreFx1              CHAR(2);
  l_Fx1                 CHAR(8);
  l_CreFx2              CHAR(2);
  l_Fx2                 CHAR(8);
  l_CreFx3              CHAR(2);
  l_Fx3                 CHAR(8);
  l_CreFx4              CHAR(2);
  l_Fx4                 CHAR(8);
  l_CreFx5              CHAR(2);
  l_Fx5                 CHAR(8);
  l_CreFx6              CHAR(2);
  l_Fx6                 CHAR(8); 
  
  l_CmdBio              VARCHAR2(31);
  l_CodTbi              CHAR(2);
  l_QntBio              NUMBER(2);
  l_QntBio_str          CHAR(2);

  /* Cursor que obtem os crachas da Pessoa */
  CURSOR c_r070con IS
  SELECT NUMCRA, NUMFIS, TIPCRA, INIVAL, DATVAL, SITCRA, TECCRA
  FROM R070CON WHERE IDTPES = l_IdtPes AND ( SUBSTRING(DATVAL,5,2)||SUBSTRING(DATVAL,3,2)||
                     SUBSTRING(DATVAL,1,2)||SUBSTRING(DATVAL,7,10) ) > l_datatu_str;
  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NUMCRA%TYPE,
    NUMFIS   R070CON.NUMFIS%TYPE,
    TIPCRA   R070CON.TIPCRA%TYPE,
    INIVAL   R070CON.INIVAL%TYPE,
    DATVAL   R070CON.DATVAL%TYPE,
    SITCRA   R070CON.SITCRA%TYPE,
    TECCRA   R070CON.TECCRA%TYPE);
  l_r070con t_r070con;

  /* Cursor c/ os registros da tabela R070BIO */
  CURSOR c_r070bio IS SELECT CODTBI FROM R070BIO WHERE IDTPES = l_idtpes GROUP BY CODTBI;
  TYPE t_r070bio IS RECORD(
    CODTBI   R070BIO.CodTbi%TYPE);
  l_r070bio t_r070bio;

BEGIN
  /* Inicializacoes */
  /* Obtem a data/hora de envio da pendencia. */
  l_Data_Atual := CURDATE();
  l_Hora_Atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_Data_Atual,'DDMMYY', l_DatStr OUT);
  SP_INTSTR(l_Hora_Atual,'HHMM',l_HorStr OUT);
  /* Obtem o Segundo */
  l_SeqEnv := SECOND(CURTIME());
  SP_INTSTR(l_SeqEnv, '99', l_SeqStr OUT);
  l_DatEnv := l_DatStr||l_HorStr||l_SeqStr||'0000';
  l_PrmAut := '00000'; /*Se nao for cracha de autorizacao de entrada permissao de autorizacao eh zero.*/
  l_Data_Zero  := '31/12/1900,00:00:00';
  
  l_datatu_str := SUBSTRING(l_DatStr, 5,2) || SUBSTRING(l_DatStr, 3,2)
                    || SUBSTRING(l_DatStr, 1,2) || l_HorStr || '000000';

  /* Obtem o Cracha Principal */
  SP_MAPFIS(p_NumCra, l_NumBar OUT, l_NumPro OUT, l_NumSma OUT, l_TecPri OUT, l_CraPri OUT);
  IF (l_CraPri = 0) THEN
      l_CraPri := p_NumCra;
  END IF;
  
  SP_INTSTR(p_CodPrm, '99999', l_CodPrm OUT);
  SP_INTSTR(p_TipVis, '999', l_TipVis OUT);  

  IF (p_AndVis IS NULL) THEN
     SP_INTSTR(0, '999', l_AndVis OUT);
  ELSE
     SP_INTSTR(p_AndVis, '999', l_AndVis OUT);
  END IF;

  /* Obtem o IDTPES */
  SP_INTSTR(p_TipDoc, '9', l_TipDoc OUT);
  l_IdtPes := '04'||l_TipDoc||p_NumDoc;

  /* Preenche o campo com espaços para completar 23 posicoes para o identificador da pessoa */
  l_IdtPes := lTrim(l_IdtPes);
  l_IdtPes := rTrim(l_IdtPes);
  LOOP
      /*Controle do Loop.*/
      IF (length(l_IdtPes) > 22) THEN
          EXIT;
      END IF;
      l_IdtPes := ' '||l_IdtPes;
  END LOOP;
  
  SP_RET_DOC_CONTCPF(l_TipDoc, p_NumDoc, l_TipDocCon_int OUT, l_NumDocCon OUT);
  SP_INTSTR(l_TipDocCon_int, '9', l_TipDocCon OUT);

  /* Busca o nome do visitante */
  BEGIN
	  SELECT NOMVIS INTO l_NomVis FROM R090VIS
          WHERE TIPDOC = p_TipDoc AND NUMDOC = p_NumDoc;
  EXCEPTION
      WHEN OTHERS THEN
          l_NomVis := '';
  END;
  
  /* Pega o tamanho do nome do visitante */
  l_TamNom := length(l_NomVis);
  SP_INTSTR(l_TamNom, '99', l_TamNom_str OUT);

  l_TamDoc := length(l_NumDocCon);
  SP_INTSTR(l_TamDoc, '99', l_TamDoc_str OUT);
  /* ---------- */

  /* Verifica se o visitante possui permissao de area restrita */
  BEGIN
      SELECT COUNT(*) INTO l_TemPev
              FROM R070PEV
          WHERE R070PEV.TIPDOC = p_TipDoc AND
              R070PEV.NUMDOC = p_NumDoc AND
              R070PEV.STAACC = 1 AND
              (R070PEV.DATFIM = l_data_zero OR R070PEV.DATFIM > l_Data_Atual OR
              (R070PEV.DATFIM = l_Data_Atual AND R070PEV.HORFIM > l_Hora_Atual));
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
          l_TemPev := 0;
      WHEN OTHERS THEN
          l_TemPev := 0;
  END;
  IF (l_TemPev = 0) THEN
      l_TemPev_str := '0';      
  ELSE 
      l_TemPev_str := '1';  
  END IF;
  /* ---------- */

  /* Verifica se o visitante possui permissao por local fisico/dispositivo */
  BEGIN
      SELECT COUNT(*)  INTO l_TemPrm
              FROM R034PRM
          WHERE R034PRM.IDTPES = l_IdtPes;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
          l_TemPrm := 0;
      WHEN OTHERS THEN
          l_TemPrm := 0;
  END;
  
  IF (l_TemPrm = 0) THEN
      l_TemPrm_str := '0';      
  ELSE 
      l_TemPrm_str := '1';  
  END IF;
  
  /* ---------- */

  /* Busca as mensagens do visitante */
  SP_RETMSV (p_TipDoc, p_NumDoc, l_DesMsg OUT, l_DatMsg OUT, l_QtdMsg OUT);
  /* Preenche o campo com espaços para completar 32 posicoes (maximo) para a mensagem */
  l_DesMsg := rTrim(l_DesMsg);
  LOOP
      /*Controle do Loop.*/
      IF (length(l_DesMsg) > 31) THEN
          EXIT;
      END IF;
      l_DesMsg := l_DesMsg||' ';
  END LOOP;

  /* Busca os creditos de acesso do visitante */
  SP_RETCRV (p_TipDoc, p_NumDoc, l_CreFx1 OUT, l_Fx1 OUT, l_CreFx2 OUT, l_Fx2 OUT, l_CreFx3 OUT, l_Fx3 OUT, l_CreFx4 OUT, l_Fx4 OUT, l_CreFx5 OUT, l_Fx5 OUT, l_CreFx6 OUT, l_Fx6 OUT);

  /* Montagem do(s) Crachas */
  l_CmdCra := '';
  l_QntCra := 0;
  FOREACH c_r070con INTO l_r070con.NumCra, l_r070con.NumFis, l_r070con.TipCra, l_r070con.IniVal,
                         l_r070con.DatVal, l_r070con.SitCra, l_r070con.TecCra LOOP
      /* Numero do Cracha */
      SP_INTSTR(l_r070con.NumCra,'999999999999',l_NumCra OUT);
      /* Numero Fisico do Cracha */
      SP_INTSTR(l_r070con.NumFis,'999999999999',l_NumFis OUT);
      /* Tipo do Cartao */
      SP_INTSTR(l_r070con.TipCra,'99',l_TipCra OUT);
      /* Data Inicial */
      l_IniVal := lTrim(l_r070con.IniVal);
      l_IniVal := rTrim(l_r070con.IniVal);
      IF (l_IniVal IS NULL) THEN
          l_IniVal:= '0000000000000000';
      END IF;
      LOOP
          /* Controle do Loop */
          IF (Length(l_IniVal) > 15) THEN
              EXIT;
          END IF;
          l_IniVal := l_IniVal||'0';
      END LOOP;
      /* Data Final */
      l_DatVal := lTrim(l_r070con.DatVal);
      l_DatVal := rTrim(l_r070con.DatVal);
      IF (l_DatVal IS NULL) THEN
          l_DatVal:= '0000000000000000';
      END IF;
      LOOP
          /* Controle do Loop */
          IF (Length(l_DatVal) > 15 ) THEN
              EXIT;
          END IF;
          l_DatVal := l_DatVal||'0';
      END LOOP;
			
      /* Sitacao do Cracha */
      SP_INTSTR(l_r070con.SitCra,'99',l_SitCra OUT);
      IF (l_SitCra = '00') THEN
          l_SitCra := '10';
          /* Retirei o envio da pendencia 05 - LockCard.
           * Eh preciso testar a concessao do cracha a um visitante atraves da pendencia 93, fazer a saida do visitante 
           * (e consequentemente a baixa do cracha), e uma nova entrada, com o mesmo nro de cracha, para ver o
           * comportamento. O cracha tem que estar liberado para esta nova entrada de visitante.
           * Nao deve ser gerada a pendencia de LockCard para cada cracha. Se necessitar liberar os crachas
           * anteriores associados ao idtpes, que o tratamento seja efetuado ao receber a string com os crachas, abaixo
           */
      END IF;

      /* Tecnologia do Cracha */
      SP_INTSTR(l_r070con.TecCra,'99',l_TecCra OUT);

      /* Monta o comando dos crachas */
      l_CmdCra := l_CmdCra||l_NumFis||l_TipCra||l_IniVal||l_DatVal||l_SitCra||l_TecCra||l_NumCra||l_PrmAut;
      l_QntCra := l_QntCra + 1;
  END LOOP;
  SP_INTSTR(l_QntCra, '999999999', l_QntCra_str OUT);
  /* ---------- */

  /* Montagem da(s) Tecnologia(s) Biometrica(s) */
  l_CmdBio := '';
  l_QntBio := 0;
  FOREACH c_r070bio INTO l_r070bio.CodTbi
  LOOP
    SP_INTSTR(l_r070bio.CodTbi, '99', l_CodTbi OUT);
    l_CmdBio := l_CmdBio||l_CodTbi;
    l_QntBio := l_QntBio + 1;
  END LOOP;
  SP_INTSTR(l_QntBio, '99', l_QntBio_str OUT);
  /* ---------- */


  /* Montagem do comando 93 - IncludeVisitorEntrance */
  l_Comando := '93'||l_DatEnv||l_IdtPes||l_TamNom_str||l_NomVis||l_CodPrm||l_TipDocCon||l_TamDoc_str||l_NumDocCon||l_TemPev_str||l_TemPrm_str||
      l_DatMsg||l_QtdMsg||l_DesMsg||l_CreFx1||l_CreFx2||l_CreFx3||l_CreFx4||l_CreFx5||l_CreFx6||l_Fx1||l_Fx2||l_Fx3||l_Fx4||l_Fx5||l_Fx6||
      l_TipVis||l_AndVis||l_QntCra_str||l_CmdCra||l_QntBio_str||l_CmdBio;

  /* Envia a Pendencia com parametro zero = envia para todas as CSM */
  SP_PorCom(l_Comando, '0');  
END		SENIOR;22VSP_DATSTR
SP_INTSTR
SP_MAPFIS
SP_RETMSV
SP_RETCRV
SP_PORCOM
SP_RET_DOC_CONTCPF
)␀␀


PROCEDURE SP_PEND93(p_TipDoc INTEGER, p_NumDoc VARCHAR2(20), p_NumCra NUMBER, p_CodPrm NUMBER, p_TipVis NUMBER, p_AndVis NUMBER)
 IS

  l_Comando             VARCHAR2(2047);
  l_DatEnv              CHAR(16);
  l_datatu_str   		CHAR(16);
  l_Data_Atual          DATE;
  l_Hora_Atual          NUMBER(4);
  l_Data_Zero           DATE;
  l_SeqEnv              NUMBER(2);
  l_DatStr              CHAR(6);
  l_HorStr              CHAR(4);
  l_SeqStr              CHAR(2);
 
  /* Variaveis SP_MAPFIS */
  l_CraPri              NUMBER(12);
  l_TecPri              NUMBER(1);
  l_NumBar              NUMBER(12);
  l_NumPro              NUMBER(12);
  l_NumSma              NUMBER(12);
  
  /* Variaveis dos Crachas */
  l_NumCra              CHAR(12);
  l_NumFis              CHAR(12);
  l_TipCra              CHAR(2);
  l_IniVal              CHAR(16);
  l_DatVal              CHAR(16);
  l_SitCra              CHAR(2);
  l_TecCra              CHAR(2);
  l_CmdCra              VARCHAR2(1023);
  l_QntCra              NUMBER(9);
  l_QntCra_str          CHAR(9);
  l_PrmAut              CHAR(5);

  l_CodPrm              CHAR(5);
  l_IdtPes              VARCHAR2(23);
  l_TipDoc              CHAR(1);
  l_SegTDo              NUMBER(1);
  l_SegDoc              VARCHAR2(20);
  l_TipDocCon_int       NUMBER(1);
  l_TipDocCon           VARCHAR2(1);
  l_NumDocCon           VARCHAR2(20);
  l_TamDoc              NUMBER(2);
  l_TamDoc_str          CHAR(2);
  l_TamNom              NUMBER(2);
  l_TamNom_str          CHAR(2);
  l_NomVis              VARCHAR2(40);
  l_TipVis              CHAR(3);
  l_AndVis              CHAR(3);  
  

  /* Variaveis perm. area restrita */
  l_TemPev              NUMBER(4);
  l_TemPev_str          CHAR(1);
  
  /* Variaveis perm. p/ local fisico/disp. */
  l_TemPrm              NUMBER(4);
  l_TemPrm_str          CHAR(1);

  /* Variaveis mensagem ao visitante */
  l_DesMsg              VARCHAR2(32);
  l_DatMsg              VARCHAR2(16);
  l_QtdMsg              VARCHAR2(2);

  /* Variaveis credito de acesso visitante */
  l_CreFx1              CHAR(2);
  l_Fx1                 CHAR(8);
  l_CreFx2              CHAR(2);
  l_Fx2                 CHAR(8);
  l_CreFx3              CHAR(2);
  l_Fx3                 CHAR(8);
  l_CreFx4              CHAR(2);
  l_Fx4                 CHAR(8);
  l_CreFx5              CHAR(2);
  l_Fx5                 CHAR(8);
  l_CreFx6              CHAR(2);
  l_Fx6                 CHAR(8); 
  
  l_CmdBio              VARCHAR2(31);
  l_CodTbi              CHAR(2);
  l_QntBio              NUMBER(2);
  l_QntBio_str          CHAR(2);

  /* Cursor que obtem os crachas da Pessoa */
  CURSOR c_r070con IS
  SELECT NUMCRA, NUMFIS, TIPCRA, INIVAL, DATVAL, SITCRA, TECCRA
  FROM R070CON WHERE IDTPES = l_IdtPes AND ( SUBSTRING(DATVAL,5,2)||SUBSTRING(DATVAL,3,2)||
                     SUBSTRING(DATVAL,1,2)||SUBSTRING(DATVAL,7,10) ) > l_datatu_str;
  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NUMCRA%TYPE,
    NUMFIS   R070CON.NUMFIS%TYPE,
    TIPCRA   R070CON.TIPCRA%TYPE,
    INIVAL   R070CON.INIVAL%TYPE,
    DATVAL   R070CON.DATVAL%TYPE,
    SITCRA   R070CON.SITCRA%TYPE,
    TECCRA   R070CON.TECCRA%TYPE);
  l_r070con t_r070con;

  /* Cursor c/ os registros da tabela R070BIO */
  CURSOR c_r070bio IS SELECT CODTBI FROM R070BIO WHERE IDTPES = l_idtpes GROUP BY CODTBI;
  TYPE t_r070bio IS RECORD(
    CODTBI   R070BIO.CodTbi%TYPE);
  l_r070bio t_r070bio;

BEGIN
  /* Inicializacoes */
  /* Obtem a data/hora de envio da pendencia. */
  l_Data_Atual := CURDATE();
  l_Hora_Atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_Data_Atual,'DDMMYY', l_DatStr OUT);
  SP_INTSTR(l_Hora_Atual,'HHMM',l_HorStr OUT);
  /* Obtem o Segundo */
  l_SeqEnv := SECOND(CURTIME());
  SP_INTSTR(l_SeqEnv, '99', l_SeqStr OUT);
  l_DatEnv := l_DatStr||l_HorStr||l_SeqStr||'0000';
  l_PrmAut := '00000'; /*Se nao for cracha de autorizacao de entrada permissao de autorizacao eh zero.*/
  l_Data_Zero  := '31/12/1900,00:00:00';
  
  l_datatu_str := SUBSTRING(l_DatStr, 5,2) || SUBSTRING(l_DatStr, 3,2)
                    || SUBSTRING(l_DatStr, 1,2) || l_HorStr || '000000';

  /* Obtem o Cracha Principal */
  SP_MAPFIS(p_NumCra, l_NumBar OUT, l_NumPro OUT, l_NumSma OUT, l_TecPri OUT, l_CraPri OUT);
  IF (l_CraPri = 0) THEN
      l_CraPri := p_NumCra;
  END IF;
  
  SP_INTSTR(p_CodPrm, '99999', l_CodPrm OUT);
  SP_INTSTR(p_TipVis, '999', l_TipVis OUT);  

  IF (p_AndVis IS NULL) THEN
     SP_INTSTR(0, '999', l_AndVis OUT);
  ELSE
     SP_INTSTR(p_AndVis, '999', l_AndVis OUT);
  END IF;

  /* Obtem o IDTPES */
  SP_INTSTR(p_TipDoc, '9', l_TipDoc OUT);
  l_IdtPes := '04'||l_TipDoc||p_NumDoc;

  /* Preenche o campo com espaços para completar 23 posicoes para o identificador da pessoa */
  l_IdtPes := lTrim(l_IdtPes);
  l_IdtPes := rTrim(l_IdtPes);
  LOOP
      /*Controle do Loop.*/
      IF (length(l_IdtPes) > 22) THEN
          EXIT;
      END IF;
      l_IdtPes := ' '||l_IdtPes;
  END LOOP;
  
  SP_RET_DOC_CONTCPF(l_TipDoc, p_NumDoc, l_TipDocCon_int OUT, l_NumDocCon OUT);
  SP_INTSTR(l_TipDocCon_int, '9', l_TipDocCon OUT);

  /* Busca o nome do visitante */
  BEGIN
	  SELECT NOMVIS INTO l_NomVis FROM R090VIS
          WHERE TIPDOC = p_TipDoc AND NUMDOC = p_NumDoc;
  EXCEPTION
      WHEN OTHERS THEN
          l_NomVis := '';
  END;
  
  /* Pega o tamanho do nome do visitante */
  l_TamNom := length(l_NomVis);
  SP_INTSTR(l_TamNom, '99', l_TamNom_str OUT);

  l_TamDoc := length(l_NumDocCon);
  SP_INTSTR(l_TamDoc, '99', l_TamDoc_str OUT);
  /* ---------- */

  /* Verifica se o visitante possui permissao de area restrita */
  BEGIN
      SELECT COUNT(*) INTO l_TemPev
              FROM R070PEV
          WHERE R070PEV.TIPDOC = p_TipDoc AND
              R070PEV.NUMDOC = p_NumDoc AND
              R070PEV.STAACC = 1 AND
              (R070PEV.DATFIM = l_data_zero OR R070PEV.DATFIM > l_Data_Atual OR
              (R070PEV.DATFIM = l_Data_Atual AND R070PEV.HORFIM > l_Hora_Atual));
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
          l_TemPev := 0;
      WHEN OTHERS THEN
          l_TemPev := 0;
  END;
  IF (l_TemPev = 0) THEN
      l_TemPev_str := '0';      
  ELSE 
      l_TemPev_str := '1';  
  END IF;
  /* ---------- */

  /* Verifica se o visitante possui permissao por local fisico/dispositivo */
  BEGIN
      SELECT COUNT(*)  INTO l_TemPrm
              FROM R034PRM
          WHERE R034PRM.IDTPES = l_IdtPes;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
          l_TemPrm := 0;
      WHEN OTHERS THEN
          l_TemPrm := 0;
  END;
  
  IF (l_TemPrm = 0) THEN
      l_TemPrm_str := '0';      
  ELSE 
      l_TemPrm_str := '1';  
  END IF;
  
  /* ---------- */

  /* Busca as mensagens do visitante */
  SP_RETMSV (p_TipDoc, p_NumDoc, l_DesMsg OUT, l_DatMsg OUT, l_QtdMsg OUT);
  /* Preenche o campo com espaços para completar 32 posicoes (maximo) para a mensagem */
  l_DesMsg := rTrim(l_DesMsg);
  LOOP
      /*Controle do Loop.*/
      IF (length(l_DesMsg) > 31) THEN
          EXIT;
      END IF;
      l_DesMsg := l_DesMsg||' ';
  END LOOP;

  /* Busca os creditos de acesso do visitante */
  SP_RETCRV (p_TipDoc, p_NumDoc, l_CreFx1 OUT, l_Fx1 OUT, l_CreFx2 OUT, l_Fx2 OUT, l_CreFx3 OUT, l_Fx3 OUT, l_CreFx4 OUT, l_Fx4 OUT, l_CreFx5 OUT, l_Fx5 OUT, l_CreFx6 OUT, l_Fx6 OUT);

  /* Montagem do(s) Crachas */
  l_CmdCra := '';
  l_QntCra := 0;
  FOREACH c_r070con INTO l_r070con.NumCra, l_r070con.NumFis, l_r070con.TipCra, l_r070con.IniVal,
                         l_r070con.DatVal, l_r070con.SitCra, l_r070con.TecCra LOOP
      /* Numero do Cracha */
      SP_INTSTR(l_r070con.NumCra,'999999999999',l_NumCra OUT);
      /* Numero Fisico do Cracha */
      SP_INTSTR(l_r070con.NumFis,'999999999999',l_NumFis OUT);
      /* Tipo do Cartao */
      SP_INTSTR(l_r070con.TipCra,'99',l_TipCra OUT);
      /* Data Inicial */
      l_IniVal := lTrim(l_r070con.IniVal);
      l_IniVal := rTrim(l_r070con.IniVal);
      IF (l_IniVal IS NULL) THEN
          l_IniVal:= '0000000000000000';
      END IF;
      LOOP
          /* Controle do Loop */
          IF (Length(l_IniVal) > 15) THEN
              EXIT;
          END IF;
          l_IniVal := l_IniVal||'0';
      END LOOP;
      /* Data Final */
      l_DatVal := lTrim(l_r070con.DatVal);
      l_DatVal := rTrim(l_r070con.DatVal);
      IF (l_DatVal IS NULL) THEN
          l_DatVal:= '0000000000000000';
      END IF;
      LOOP
          /* Controle do Loop */
          IF (Length(l_DatVal) > 15 ) THEN
              EXIT;
          END IF;
          l_DatVal := l_DatVal||'0';
      END LOOP;
			
      /* Sitacao do Cracha */
      SP_INTSTR(l_r070con.SitCra,'99',l_SitCra OUT);
      IF (l_SitCra = '00') THEN
          l_SitCra := '10';
          /* Retirei o envio da pendencia 05 - LockCard.
           * Eh preciso testar a concessao do cracha a um visitante atraves da pendencia 93, fazer a saida do visitante 
           * (e consequentemente a baixa do cracha), e uma nova entrada, com o mesmo nro de cracha, para ver o
           * comportamento. O cracha tem que estar liberado para esta nova entrada de visitante.
           * Nao deve ser gerada a pendencia de LockCard para cada cracha. Se necessitar liberar os crachas
           * anteriores associados ao idtpes, que o tratamento seja efetuado ao receber a string com os crachas, abaixo
           */
      END IF;

      /* Tecnologia do Cracha */
      SP_INTSTR(l_r070con.TecCra,'99',l_TecCra OUT);

      /* Monta o comando dos crachas */
      l_CmdCra := l_CmdCra||l_NumFis||l_TipCra||l_IniVal||l_DatVal||l_SitCra||l_TecCra||l_NumCra||l_PrmAut;
      l_QntCra := l_QntCra + 1;
  END LOOP;
  SP_INTSTR(l_QntCra, '999999999', l_QntCra_str OUT);
  /* ---------- */

  /* Montagem da(s) Tecnologia(s) Biometrica(s) */
  l_CmdBio := '';
  l_QntBio := 0;
  FOREACH c_r070bio INTO l_r070bio.CodTbi
  LOOP
    SP_INTSTR(l_r070bio.CodTbi, '99', l_CodTbi OUT);
    l_CmdBio := l_CmdBio||l_CodTbi;
    l_QntBio := l_QntBio + 1;
  END LOOP;
  SP_INTSTR(l_QntBio, '99', l_QntBio_str OUT);
  /* ---------- */


  /* Montagem do comando 93 - IncludeVisitorEntrance */
  l_Comando := '93'||l_DatEnv||l_IdtPes||l_TamNom_str||l_NomVis||l_CodPrm||l_TipDocCon||l_TamDoc_str||l_NumDocCon||l_TemPev_str||l_TemPrm_str||
      l_DatMsg||l_QtdMsg||l_DesMsg||l_CreFx1||l_CreFx2||l_CreFx3||l_CreFx4||l_CreFx5||l_CreFx6||l_Fx1||l_Fx2||l_Fx3||l_Fx4||l_Fx5||l_Fx6||
      l_TipVis||l_AndVis||l_QntCra_str||l_CmdCra||l_QntBio_str||l_CmdBio;

  /* Envia a Pendencia com parametro zero = envia para todas as CSM */
  SP_PorCom(l_Comando, '0');  
END		SENIOR;23VSP_DATSTR
SP_INTSTR
SP_MAPFIS
SP_RETMSV
SP_RETCRV
SP_PORCOM
SP_RET_DOC_CONTCPF
)␀␀


PROCEDURE SP_PEND93(p_TipDoc INTEGER, p_NumDoc VARCHAR2(20), p_NumCra NUMBER, p_CodPrm NUMBER, p_TipVis NUMBER, p_AndVis NUMBER)
 IS

  l_Comando             VARCHAR2(2047);
  l_DatEnv              CHAR(16);
  l_datatu_str   		CHAR(16);
  l_Data_Atual          DATE;
  l_Hora_Atual          NUMBER(4);
  l_Data_Zero           DATE;
  l_SeqEnv              NUMBER(2);
  l_DatStr              CHAR(6);
  l_HorStr              CHAR(4);
  l_SeqStr              CHAR(2);
 
  /* Variaveis SP_MAPFIS */
  l_CraPri              NUMBER(12);
  l_TecPri              NUMBER(1);
  l_NumBar              NUMBER(12);
  l_NumPro              NUMBER(12);
  l_NumSma              NUMBER(12);
  
  /* Variaveis dos Crachas */
  l_NumCra              CHAR(12);
  l_NumFis              CHAR(12);
  l_TipCra              CHAR(2);
  l_IniVal              CHAR(16);
  l_DatVal              CHAR(16);
  l_SitCra              CHAR(2);
  l_TecCra              CHAR(2);
  l_CmdCra              VARCHAR2(1023);
  l_QntCra              NUMBER(9);
  l_QntCra_str          CHAR(9);
  l_PrmAut              CHAR(5);

  l_CodPrm              CHAR(5);
  l_IdtPes              VARCHAR2(23);
  l_TipDoc              CHAR(1);
  l_SegTDo              NUMBER(1);
  l_SegDoc              VARCHAR2(20);
  l_TipDocCon_int       NUMBER(1);
  l_TipDocCon           VARCHAR2(1);
  l_NumDocCon           VARCHAR2(20);
  l_TamDoc              NUMBER(2);
  l_TamDoc_str          CHAR(2);
  l_TamNom              NUMBER(2);
  l_TamNom_str          CHAR(2);
  l_NomVis              VARCHAR2(40);
  l_TipVis              CHAR(3);
  l_AndVis              CHAR(3);  
  

  /* Variaveis perm. area restrita */
  l_TemPev              NUMBER(4);
  l_TemPev_str          CHAR(1);
  
  /* Variaveis perm. p/ local fisico/disp. */
  l_TemPrm              NUMBER(4);
  l_TemPrm_str          CHAR(1);

  /* Variaveis mensagem ao visitante */
  l_DesMsg              VARCHAR2(32);
  l_DatMsg              VARCHAR2(16);
  l_QtdMsg              VARCHAR2(2);

  /* Variaveis credito de acesso visitante */
  l_CreFx1              CHAR(2);
  l_Fx1                 CHAR(8);
  l_CreFx2              CHAR(2);
  l_Fx2                 CHAR(8);
  l_CreFx3              CHAR(2);
  l_Fx3                 CHAR(8);
  l_CreFx4              CHAR(2);
  l_Fx4                 CHAR(8);
  l_CreFx5              CHAR(2);
  l_Fx5                 CHAR(8);
  l_CreFx6              CHAR(2);
  l_Fx6                 CHAR(8); 
  
  l_CmdBio              VARCHAR2(31);
  l_CodTbi              CHAR(2);
  l_QntBio              NUMBER(2);
  l_QntBio_str          CHAR(2);

  /* Cursor que obtem os crachas da Pessoa */
  CURSOR c_r070con IS
  SELECT NUMCRA, NUMFIS, TIPCRA, INIVAL, DATVAL, SITCRA, TECCRA
  FROM R070CON WHERE IDTPES = l_IdtPes AND ( SUBSTRING(DATVAL,5,2)||SUBSTRING(DATVAL,3,2)||
                     SUBSTRING(DATVAL,1,2)||SUBSTRING(DATVAL,7,10) ) > l_datatu_str;
  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NUMCRA%TYPE,
    NUMFIS   R070CON.NUMFIS%TYPE,
    TIPCRA   R070CON.TIPCRA%TYPE,
    INIVAL   R070CON.INIVAL%TYPE,
    DATVAL   R070CON.DATVAL%TYPE,
    SITCRA   R070CON.SITCRA%TYPE,
    TECCRA   R070CON.TECCRA%TYPE);
  l_r070con t_r070con;

  /* Cursor c/ os registros da tabela R070BIO */
  CURSOR c_r070bio IS SELECT CODTBI FROM R070BIO WHERE IDTPES = l_idtpes GROUP BY CODTBI;
  TYPE t_r070bio IS RECORD(
    CODTBI   R070BIO.CodTbi%TYPE);
  l_r070bio t_r070bio;

BEGIN
  /* Inicializacoes */
  /* Obtem a data/hora de envio da pendencia. */
  l_Data_Atual := CURDATE();
  l_Hora_Atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_Data_Atual,'DDMMYY', l_DatStr OUT);
  SP_INTSTR(l_Hora_Atual,'HHMM',l_HorStr OUT);
  /* Obtem o Segundo */
  l_SeqEnv := SECOND(CURTIME());
  SP_INTSTR(l_SeqEnv, '99', l_SeqStr OUT);
  l_DatEnv := l_DatStr||l_HorStr||l_SeqStr||'0000';
  l_PrmAut := '00000'; /*Se nao for cracha de autorizacao de entrada permissao de autorizacao eh zero.*/
  l_Data_Zero  := '31/12/1900,00:00:00';
  
  l_datatu_str := SUBSTRING(l_DatStr, 5,2) || SUBSTRING(l_DatStr, 3,2)
                    || SUBSTRING(l_DatStr, 1,2) || l_HorStr || '000000';

  /* Obtem o Cracha Principal */
  SP_MAPFIS(p_NumCra, l_NumBar OUT, l_NumPro OUT, l_NumSma OUT, l_TecPri OUT, l_CraPri OUT);
  IF (l_CraPri = 0) THEN
      l_CraPri := p_NumCra;
  END IF;
  
  SP_INTSTR(p_CodPrm, '99999', l_CodPrm OUT);
  SP_INTSTR(p_TipVis, '999', l_TipVis OUT);  

  IF (p_AndVis IS NULL) THEN
     SP_INTSTR(0, '999', l_AndVis OUT);
  ELSE
     SP_INTSTR(p_AndVis, '999', l_AndVis OUT);
  END IF;

  /* Obtem o IDTPES */
  SP_INTSTR(p_TipDoc, '9', l_TipDoc OUT);
  l_IdtPes := '04'||l_TipDoc||p_NumDoc;

  /* Preenche o campo com espaços para completar 23 posicoes para o identificador da pessoa */
  l_IdtPes := lTrim(l_IdtPes);
  l_IdtPes := rTrim(l_IdtPes);
  LOOP
      /*Controle do Loop.*/
      IF (length(l_IdtPes) > 22) THEN
          EXIT;
      END IF;
      l_IdtPes := ' '||l_IdtPes;
  END LOOP;
  
  SP_RET_DOC_CONTCPF(l_TipDoc, p_NumDoc, l_TipDocCon_int OUT, l_NumDocCon OUT);
  SP_INTSTR(l_TipDocCon_int, '9', l_TipDocCon OUT);

  /* Busca o nome do visitante */
  BEGIN
	  SELECT NOMVIS INTO l_NomVis FROM R090VIS
          WHERE TIPDOC = p_TipDoc AND NUMDOC = p_NumDoc;
  EXCEPTION
      WHEN OTHERS THEN
          l_NomVis := '';
  END;
  
  /* Pega o tamanho do nome do visitante */
  l_TamNom := length(l_NomVis);
  SP_INTSTR(l_TamNom, '99', l_TamNom_str OUT);

  l_TamDoc := length(l_NumDocCon);
  SP_INTSTR(l_TamDoc, '99', l_TamDoc_str OUT);
  /* ---------- */

  /* Verifica se o visitante possui permissao de area restrita */
  BEGIN
      SELECT COUNT(*) INTO l_TemPev
              FROM R070PEV
          WHERE R070PEV.TIPDOC = p_TipDoc AND
              R070PEV.NUMDOC = p_NumDoc AND
              R070PEV.STAACC = 1 AND
              (R070PEV.DATFIM = l_data_zero OR R070PEV.DATFIM > l_Data_Atual OR
              (R070PEV.DATFIM = l_Data_Atual AND R070PEV.HORFIM > l_Hora_Atual));
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
          l_TemPev := 0;
      WHEN OTHERS THEN
          l_TemPev := 0;
  END;
  IF (l_TemPev = 0) THEN
      l_TemPev_str := '0';      
  ELSE 
      l_TemPev_str := '1';  
  END IF;
  /* ---------- */

  /* Verifica se o visitante possui permissao por local fisico/dispositivo */
  BEGIN
      SELECT COUNT(*)  INTO l_TemPrm
              FROM R034PRM
          WHERE R034PRM.IDTPES = l_IdtPes;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
          l_TemPrm := 0;
      WHEN OTHERS THEN
          l_TemPrm := 0;
  END;
  
  IF (l_TemPrm = 0) THEN
      l_TemPrm_str := '0';      
  ELSE 
      l_TemPrm_str := '1';  
  END IF;
  
  /* ---------- */

  /* Busca as mensagens do visitante */
  SP_RETMSV (p_TipDoc, p_NumDoc, l_DesMsg OUT, l_DatMsg OUT, l_QtdMsg OUT);
  /* Preenche o campo com espaços para completar 32 posicoes (maximo) para a mensagem */
  l_DesMsg := rTrim(l_DesMsg);
  LOOP
      /*Controle do Loop.*/
      IF (length(l_DesMsg) > 31) THEN
          EXIT;
      END IF;
      l_DesMsg := l_DesMsg||' ';
  END LOOP;

  /* Busca os creditos de acesso do visitante */
  SP_RETCRV (p_TipDoc, p_NumDoc, l_CreFx1 OUT, l_Fx1 OUT, l_CreFx2 OUT, l_Fx2 OUT, l_CreFx3 OUT, l_Fx3 OUT, l_CreFx4 OUT, l_Fx4 OUT, l_CreFx5 OUT, l_Fx5 OUT, l_CreFx6 OUT, l_Fx6 OUT);

  /* Montagem do(s) Crachas */
  l_CmdCra := '';
  l_QntCra := 0;
  FOREACH c_r070con INTO l_r070con.NumCra, l_r070con.NumFis, l_r070con.TipCra, l_r070con.IniVal,
                         l_r070con.DatVal, l_r070con.SitCra, l_r070con.TecCra LOOP
      /* Numero do Cracha */
      SP_INTSTR(l_r070con.NumCra,'999999999999',l_NumCra OUT);
      /* Numero Fisico do Cracha */
      SP_INTSTR(l_r070con.NumFis,'999999999999',l_NumFis OUT);
      /* Tipo do Cartao */
      SP_INTSTR(l_r070con.TipCra,'99',l_TipCra OUT);
      /* Data Inicial */
      l_IniVal := lTrim(l_r070con.IniVal);
      l_IniVal := rTrim(l_r070con.IniVal);
      IF (l_IniVal IS NULL) THEN
          l_IniVal:= '0000000000000000';
      END IF;
      LOOP
          /* Controle do Loop */
          IF (Length(l_IniVal) > 15) THEN
              EXIT;
          END IF;
          l_IniVal := l_IniVal||'0';
      END LOOP;
      /* Data Final */
      l_DatVal := lTrim(l_r070con.DatVal);
      l_DatVal := rTrim(l_r070con.DatVal);
      IF (l_DatVal IS NULL) THEN
          l_DatVal:= '0000000000000000';
      END IF;
      LOOP
          /* Controle do Loop */
          IF (Length(l_DatVal) > 15 ) THEN
              EXIT;
          END IF;
          l_DatVal := l_DatVal||'0';
      END LOOP;
			
      /* Sitacao do Cracha */
      SP_INTSTR(l_r070con.SitCra,'99',l_SitCra OUT);
      IF (l_SitCra = '00') THEN
          l_SitCra := '10';
          /* Retirei o envio da pendencia 05 - LockCard.
           * Eh preciso testar a concessao do cracha a um visitante atraves da pendencia 93, fazer a saida do visitante 
           * (e consequentemente a baixa do cracha), e uma nova entrada, com o mesmo nro de cracha, para ver o
           * comportamento. O cracha tem que estar liberado para esta nova entrada de visitante.
           * Nao deve ser gerada a pendencia de LockCard para cada cracha. Se necessitar liberar os crachas
           * anteriores associados ao idtpes, que o tratamento seja efetuado ao receber a string com os crachas, abaixo
           */
      END IF;

      /* Tecnologia do Cracha */
      SP_INTSTR(l_r070con.TecCra,'99',l_TecCra OUT);

      /* Monta o comando dos crachas */
      l_CmdCra := l_CmdCra||l_NumFis||l_TipCra||l_IniVal||l_DatVal||l_SitCra||l_TecCra||l_NumCra||l_PrmAut;
      l_QntCra := l_QntCra + 1;
  END LOOP;
  SP_INTSTR(l_QntCra, '999999999', l_QntCra_str OUT);
  /* ---------- */

  /* Montagem da(s) Tecnologia(s) Biometrica(s) */
  l_CmdBio := '';
  l_QntBio := 0;
  FOREACH c_r070bio INTO l_r070bio.CodTbi
  LOOP
    SP_INTSTR(l_r070bio.CodTbi, '99', l_CodTbi OUT);
    l_CmdBio := l_CmdBio||l_CodTbi;
    l_QntBio := l_QntBio + 1;
  END LOOP;
  SP_INTSTR(l_QntBio, '99', l_QntBio_str OUT);
  /* ---------- */


  /* Montagem do comando 93 - IncludeVisitorEntrance */
  l_Comando := '93'||l_DatEnv||l_IdtPes||l_TamNom_str||l_NomVis||l_CodPrm||l_TipDocCon||l_TamDoc_str||l_NumDocCon||l_TemPev_str||l_TemPrm_str||
      l_DatMsg||l_QtdMsg||l_DesMsg||l_CreFx1||l_CreFx2||l_CreFx3||l_CreFx4||l_CreFx5||l_CreFx6||l_Fx1||l_Fx2||l_Fx3||l_Fx4||l_Fx5||l_Fx6||
      l_TipVis||l_AndVis||l_QntCra_str||l_CmdCra||l_QntBio_str||l_CmdBio;

  /* Envia a Pendencia com parametro zero = envia para todas as CSM */
  SP_PorCom(l_Comando, '0');  
END		SENIOR;24VSP_DATSTR
SP_INTSTR
SP_MAPFIS
SP_RETMSV
SP_RETCRV
SP_PORCOM
SP_RET_DOC_CONTCPF
)␀␀


PROCEDURE SP_PEND93(p_TipDoc INTEGER, p_NumDoc VARCHAR2(20), p_NumCra NUMBER, p_CodPrm NUMBER, p_TipVis NUMBER, p_AndVis NUMBER)
 IS

  l_Comando             VARCHAR2(2047);
  l_DatEnv              CHAR(16);
  l_datatu_str   		CHAR(16);
  l_Data_Atual          DATE;
  l_Hora_Atual          NUMBER(4);
  l_Data_Zero           DATE;
  l_SeqEnv              NUMBER(2);
  l_DatStr              CHAR(6);
  l_HorStr              CHAR(4);
  l_SeqStr              CHAR(2);
 
  /* Variaveis SP_MAPFIS */
  l_CraPri              NUMBER(12);
  l_TecPri              NUMBER(1);
  l_NumBar              NUMBER(12);
  l_NumPro              NUMBER(12);
  l_NumSma              NUMBER(12);
  
  /* Variaveis dos Crachas */
  l_NumCra              CHAR(12);
  l_NumFis              CHAR(12);
  l_TipCra              CHAR(2);
  l_IniVal              CHAR(16);
  l_DatVal              CHAR(16);
  l_SitCra              CHAR(2);
  l_TecCra              CHAR(2);
  l_CmdCra              VARCHAR2(1023);
  l_QntCra              NUMBER(9);
  l_QntCra_str          CHAR(9);
  l_PrmAut              CHAR(5);

  l_CodPrm              CHAR(5);
  l_IdtPes              VARCHAR2(23);
  l_TipDoc              CHAR(1);
  l_SegTDo              NUMBER(1);
  l_SegDoc              VARCHAR2(20);
  l_TipDocCon_int       NUMBER(1);
  l_TipDocCon           VARCHAR2(1);
  l_NumDocCon           VARCHAR2(20);
  l_TamDoc              NUMBER(2);
  l_TamDoc_str          CHAR(2);
  l_TamNom              NUMBER(2);
  l_TamNom_str          CHAR(2);
  l_NomVis              VARCHAR2(40);
  l_TipVis              CHAR(3);
  l_AndVis              CHAR(3);  
  

  /* Variaveis perm. area restrita */
  l_TemPev              NUMBER(4);
  l_TemPev_str          CHAR(1);
  
  /* Variaveis perm. p/ local fisico/disp. */
  l_TemPrm              NUMBER(4);
  l_TemPrm_str          CHAR(1);

  /* Variaveis mensagem ao visitante */
  l_DesMsg              VARCHAR2(32);
  l_DatMsg              VARCHAR2(16);
  l_QtdMsg              VARCHAR2(2);

  /* Variaveis credito de acesso visitante */
  l_CreFx1              CHAR(2);
  l_Fx1                 CHAR(8);
  l_CreFx2              CHAR(2);
  l_Fx2                 CHAR(8);
  l_CreFx3              CHAR(2);
  l_Fx3                 CHAR(8);
  l_CreFx4              CHAR(2);
  l_Fx4                 CHAR(8);
  l_CreFx5              CHAR(2);
  l_Fx5                 CHAR(8);
  l_CreFx6              CHAR(2);
  l_Fx6                 CHAR(8); 
  
  l_CmdBio              VARCHAR2(31);
  l_CodTbi              CHAR(2);
  l_QntBio              NUMBER(2);
  l_QntBio_str          CHAR(2);

  /* Cursor que obtem os crachas da Pessoa */
  CURSOR c_r070con IS
  SELECT NUMCRA, NUMFIS, TIPCRA, INIVAL, DATVAL, SITCRA, TECCRA
  FROM R070CON WHERE IDTPES = l_IdtPes AND ( SUBSTRING(DATVAL,5,2)||SUBSTRING(DATVAL,3,2)||
                     SUBSTRING(DATVAL,1,2)||SUBSTRING(DATVAL,7,10) ) > l_datatu_str;
  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NUMCRA%TYPE,
    NUMFIS   R070CON.NUMFIS%TYPE,
    TIPCRA   R070CON.TIPCRA%TYPE,
    INIVAL   R070CON.INIVAL%TYPE,
    DATVAL   R070CON.DATVAL%TYPE,
    SITCRA   R070CON.SITCRA%TYPE,
    TECCRA   R070CON.TECCRA%TYPE);
  l_r070con t_r070con;

  /* Cursor c/ os registros da tabela R070BIO */
  CURSOR c_r070bio IS SELECT CODTBI FROM R070BIO WHERE IDTPES = l_idtpes GROUP BY CODTBI;
  TYPE t_r070bio IS RECORD(
    CODTBI   R070BIO.CodTbi%TYPE);
  l_r070bio t_r070bio;

BEGIN
  /* Inicializacoes */
  /* Obtem a data/hora de envio da pendencia. */
  l_Data_Atual := CURDATE();
  l_Hora_Atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_Data_Atual,'DDMMYY', l_DatStr OUT);
  SP_INTSTR(l_Hora_Atual,'HHMM',l_HorStr OUT);
  /* Obtem o Segundo */
  l_SeqEnv := SECOND(CURTIME());
  SP_INTSTR(l_SeqEnv, '99', l_SeqStr OUT);
  l_DatEnv := l_DatStr||l_HorStr||l_SeqStr||'0000';
  l_PrmAut := '00000'; /*Se nao for cracha de autorizacao de entrada permissao de autorizacao eh zero.*/
  l_Data_Zero  := '31/12/1900,00:00:00';
  
  l_datatu_str := SUBSTRING(l_DatStr, 5,2) || SUBSTRING(l_DatStr, 3,2)
                    || SUBSTRING(l_DatStr, 1,2) || l_HorStr || '000000';

  /* Obtem o Cracha Principal */
  SP_MAPFIS(p_NumCra, l_NumBar OUT, l_NumPro OUT, l_NumSma OUT, l_TecPri OUT, l_CraPri OUT);
  IF (l_CraPri = 0) THEN
      l_CraPri := p_NumCra;
  END IF;
  
  SP_INTSTR(p_CodPrm, '99999', l_CodPrm OUT);
  SP_INTSTR(p_TipVis, '999', l_TipVis OUT);  

  IF (p_AndVis IS NULL) THEN
     SP_INTSTR(0, '999', l_AndVis OUT);
  ELSE
     SP_INTSTR(p_AndVis, '999', l_AndVis OUT);
  END IF;

  /* Obtem o IDTPES */
  SP_INTSTR(p_TipDoc, '9', l_TipDoc OUT);
  l_IdtPes := '04'||l_TipDoc||p_NumDoc;

  /* Preenche o campo com espaços para completar 23 posicoes para o identificador da pessoa */
  l_IdtPes := lTrim(l_IdtPes);
  l_IdtPes := rTrim(l_IdtPes);
  LOOP
      /*Controle do Loop.*/
      IF (length(l_IdtPes) > 22) THEN
          EXIT;
      END IF;
      l_IdtPes := ' '||l_IdtPes;
  END LOOP;
  
  SP_RET_DOC_CONTCPF(l_TipDoc, p_NumDoc, l_TipDocCon_int OUT, l_NumDocCon OUT);
  SP_INTSTR(l_TipDocCon_int, '9', l_TipDocCon OUT);

  /* Busca o nome do visitante */
  BEGIN
	  SELECT NOMVIS INTO l_NomVis FROM R090VIS
          WHERE TIPDOC = p_TipDoc AND NUMDOC = p_NumDoc;
  EXCEPTION
      WHEN OTHERS THEN
          l_NomVis := '';
  END;
  
  /* Pega o tamanho do nome do visitante */
  l_TamNom := length(l_NomVis);
  SP_INTSTR(l_TamNom, '99', l_TamNom_str OUT);

  l_TamDoc := length(l_NumDocCon);
  SP_INTSTR(l_TamDoc, '99', l_TamDoc_str OUT);
  /* ---------- */

  /* Verifica se o visitante possui permissao de area restrita */
  BEGIN
      SELECT COUNT(*) INTO l_TemPev
              FROM R070PEV
          WHERE R070PEV.TIPDOC = p_TipDoc AND
              R070PEV.NUMDOC = p_NumDoc AND
              R070PEV.STAACC = 1 AND
              (R070PEV.DATFIM = l_data_zero OR R070PEV.DATFIM > l_Data_Atual OR
              (R070PEV.DATFIM = l_Data_Atual AND R070PEV.HORFIM > l_Hora_Atual));
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
          l_TemPev := 0;
      WHEN OTHERS THEN
          l_TemPev := 0;
  END;
  IF (l_TemPev = 0) THEN
      l_TemPev_str := '0';      
  ELSE 
      l_TemPev_str := '1';  
  END IF;
  /* ---------- */

  /* Verifica se o visitante possui permissao por local fisico/dispositivo */
  BEGIN
      SELECT COUNT(*)  INTO l_TemPrm
              FROM R034PRM
          WHERE R034PRM.IDTPES = l_IdtPes;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
          l_TemPrm := 0;
      WHEN OTHERS THEN
          l_TemPrm := 0;
  END;
  
  IF (l_TemPrm = 0) THEN
      l_TemPrm_str := '0';      
  ELSE 
      l_TemPrm_str := '1';  
  END IF;
  
  /* ---------- */

  /* Busca as mensagens do visitante */
  SP_RETMSV (p_TipDoc, p_NumDoc, l_DesMsg OUT, l_DatMsg OUT, l_QtdMsg OUT);
  /* Preenche o campo com espaços para completar 32 posicoes (maximo) para a mensagem */
  l_DesMsg := rTrim(l_DesMsg);
  LOOP
      /*Controle do Loop.*/
      IF (length(l_DesMsg) > 31) THEN
          EXIT;
      END IF;
      l_DesMsg := l_DesMsg||' ';
  END LOOP;

  /* Busca os creditos de acesso do visitante */
  SP_RETCRV (p_TipDoc, p_NumDoc, l_CreFx1 OUT, l_Fx1 OUT, l_CreFx2 OUT, l_Fx2 OUT, l_CreFx3 OUT, l_Fx3 OUT, l_CreFx4 OUT, l_Fx4 OUT, l_CreFx5 OUT, l_Fx5 OUT, l_CreFx6 OUT, l_Fx6 OUT);

  /* Montagem do(s) Crachas */
  l_CmdCra := '';
  l_QntCra := 0;
  FOREACH c_r070con INTO l_r070con.NumCra, l_r070con.NumFis, l_r070con.TipCra, l_r070con.IniVal,
                         l_r070con.DatVal, l_r070con.SitCra, l_r070con.TecCra LOOP
      /* Numero do Cracha */
      SP_INTSTR(l_r070con.NumCra,'999999999999',l_NumCra OUT);
      /* Numero Fisico do Cracha */
      SP_INTSTR(l_r070con.NumFis,'999999999999',l_NumFis OUT);
      /* Tipo do Cartao */
      SP_INTSTR(l_r070con.TipCra,'99',l_TipCra OUT);
      /* Data Inicial */
      l_IniVal := lTrim(l_r070con.IniVal);
      l_IniVal := rTrim(l_r070con.IniVal);
      IF (l_IniVal IS NULL) THEN
          l_IniVal:= '0000000000000000';
      END IF;
      LOOP
          /* Controle do Loop */
          IF (Length(l_IniVal) > 15) THEN
              EXIT;
          END IF;
          l_IniVal := l_IniVal||'0';
      END LOOP;
      /* Data Final */
      l_DatVal := lTrim(l_r070con.DatVal);
      l_DatVal := rTrim(l_r070con.DatVal);
      IF (l_DatVal IS NULL) THEN
          l_DatVal:= '0000000000000000';
      END IF;
      LOOP
          /* Controle do Loop */
          IF (Length(l_DatVal) > 15 ) THEN
              EXIT;
          END IF;
          l_DatVal := l_DatVal||'0';
      END LOOP;
			
      /* Sitacao do Cracha */
      SP_INTSTR(l_r070con.SitCra,'99',l_SitCra OUT);
      IF (l_SitCra = '00') THEN
          l_SitCra := '10';
          /* Retirei o envio da pendencia 05 - LockCard.
           * Eh preciso testar a concessao do cracha a um visitante atraves da pendencia 93, fazer a saida do visitante 
           * (e consequentemente a baixa do cracha), e uma nova entrada, com o mesmo nro de cracha, para ver o
           * comportamento. O cracha tem que estar liberado para esta nova entrada de visitante.
           * Nao deve ser gerada a pendencia de LockCard para cada cracha. Se necessitar liberar os crachas
           * anteriores associados ao idtpes, que o tratamento seja efetuado ao receber a string com os crachas, abaixo
           */
      END IF;

      /* Tecnologia do Cracha */
      SP_INTSTR(l_r070con.TecCra,'99',l_TecCra OUT);

      /* Monta o comando dos crachas */
      l_CmdCra := l_CmdCra||l_NumFis||l_TipCra||l_IniVal||l_DatVal||l_SitCra||l_TecCra||l_NumCra||l_PrmAut;
      l_QntCra := l_QntCra + 1;
  END LOOP;
  SP_INTSTR(l_QntCra, '999999999', l_QntCra_str OUT);
  /* ---------- */

  /* Montagem da(s) Tecnologia(s) Biometrica(s) */
  l_CmdBio := '';
  l_QntBio := 0;
  FOREACH c_r070bio INTO l_r070bio.CodTbi
  LOOP
    SP_INTSTR(l_r070bio.CodTbi, '99', l_CodTbi OUT);
    l_CmdBio := l_CmdBio||l_CodTbi;
    l_QntBio := l_QntBio + 1;
  END LOOP;
  SP_INTSTR(l_QntBio, '99', l_QntBio_str OUT);
  /* ---------- */


  /* Montagem do comando 93 - IncludeVisitorEntrance */
  l_Comando := '93'||l_DatEnv||l_IdtPes||l_TamNom_str||l_NomVis||l_CodPrm||l_TipDocCon||l_TamDoc_str||l_NumDocCon||l_TemPev_str||l_TemPrm_str||
      l_DatMsg||l_QtdMsg||l_DesMsg||l_CreFx1||l_CreFx2||l_CreFx3||l_CreFx4||l_CreFx5||l_CreFx6||l_Fx1||l_Fx2||l_Fx3||l_Fx4||l_Fx5||l_Fx6||
      l_TipVis||l_AndVis||l_QntCra_str||l_CmdCra||l_QntBio_str||l_CmdBio;

  /* Envia a Pendencia com parametro zero = envia para todas as CSM */
  SP_PorCom(l_Comando, '0');  
END␀}ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Æ␀␀/* 95 = UpdatePersonSituation */
/* Informa para a CSM Concentradora a descrição da situação da pessoa */
/* Esta informação é exibida na console e utilizada pela Portaria Avançada para controle de visitados */

/* Importante*/
/* A pendência não é enviada só quando atualiza a data de afastamento */
/* Pois pode ter afastamentos que não bloqueiam o acesso e por isso não geram a pendência updateRemoval */ 

/* VALSTR*/
/* 02 = Código da pendência (95)         */
/* 16 = Data de envio                    */
/* 23 = Identificador da Pessoa (IDTPES) */
/* 02 = Tipo da situação (TIPSIT)      */


PROCEDURE SP_PEND95(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_CODSIT VARCHAR2(30))
 IS
BEGIN
  NULL;
END		SENIOR;24KSP_DATSTR
SP_INTSTR
SP_SIMNAO_INT
SP_RETIDTPES
SP_PORCOM
SP_STRTOINT
K␀␀

PROCEDURE SP_PEND95(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_CODSIT VARCHAR2(30))
 IS

  l_idtpes        VARCHAR2(23);
  l_tipSit        NUMBER(2);  
  l_tipSit_Str    VARCHAR2(3);
  l_valstr     VARCHAR2(2047);
  l_datatu     DATE;
  l_horatu     NUMBER(4);
  l_seqenv     NUMBER(2);
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datenv     CHAR(16);
  l_seqstr     CHAR(2);  
  l_codsit     NUMBER;
BEGIN
  	
  /* Calcula  data/hora de envio da pendência.*/
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';
  
  /* Monta o IDTPES */
  SP_RETIDTPES(p_numemp, p_tipcol, p_numcad, 0, '', '', '', l_idtpes OUT);
  
  SP_STRTOINT(p_codSit , l_codsit OUT);
  
  /* Busca a descrição da situação */
  BEGIN
      SELECT TIPSIT INTO l_tipSit FROM R010SIT WHERE CODSIT = l_codsit;
  EXCEPTION
      WHEN OTHERS THEN l_tipSit := 1;
  END;

  /* Converte o tipSit para string */
  SP_INTSTR(l_tipSit,'99',l_tipsit_Str OUT);

  /* monta o VALSTR*/
  /* 02 = Código da pendência (95)         */
  /* 16 = Data de envio                    */
  /* 23 = Identificador da Pessoa (IDTPES) */
  /* 02 = Tipo da situação (TIPSIT)      */
  l_valstr := '95' || l_datenv || l_idtpes || l_tipSit_Str;
  
  BEGIN
      SP_PORCOM(l_valstr, '0');
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'SP_PEND95: Erro ao gerar pendência 95 (UpdatePersonSituation).';
  END;
END		SENIOR;20>SP_DATSTR
SP_INTSTR
SP_SIMNAO_INT
SP_RETIDTPES
SP_PORCOM
