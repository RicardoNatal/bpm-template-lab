TRIGGER R070PEC_SI AFTER INSERT ON R070PEC
BEGIN
  R070PEC_ATUCON();

  R070PEC_RECALF();

  /* Tabela temporária */
  BEGIN
      DELETE FROM R070PEC_AUX;
      DROP_TEMP_TABLE R070PEC_AUX;
      DELETE FROM R070PEC_API;
      DROP_TEMP_TABLE R070PEC_API;
  EXCEPTION 
      WHEN OTHERS THEN NULL;
   END;
END␀^Ú␀␀		SENIOR;0Ñ	␀␀TRIGGER R070PEC_EI BEFORE INSERT ON R070PEC FOR EACH ROW
DECLARE
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_online       BOOLEAN;
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_ade_gerpen   BOOLEAN;

  /* Tabela temporária */
  CREATE_TEMP_TABLE R070PEC_AUX;
  CREATE_TEMP_TABLE R070PEC_API;

BEGIN
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) THEN
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       IF (:NEW.DATFIM = l_data_zero OR :NEW.DATFIM > l_data_atual OR
          (:NEW.DATFIM = l_data_atual AND :NEW.HORFIM > l_hora_atual)) THEN
            BEGIN
            /* Insere Registro NEW */
                INSERT INTO R070PEC_AUX (NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI)
                                 VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI);
            EXCEPTION WHEN OTHERS THEN
                RAISERROR 103 'Erro no INSERT em R070PEC_AUX.';
            END;

            SP_RECALF_GERPEN_1(:NEW.TIPCOL, l_ade_gerpen OUT);
            IF (l_ade_gerpen = TRUE) THEN
                BEGIN
                    /* Insere Registro NEW */
                    INSERT INTO R070PEC_API (NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI)
                                     VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI);
                EXCEPTION WHEN OTHERS THEN
                    RAISERROR 103 'Erro no INSERT em R070PEC_API.';
                END;
            END IF;
       END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R070PEC');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R070PEC_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,CODPRM,DATFIM,HORFIM,CODUSU,OBSPRM,STAACC)
                           VALUES (l_seqreg,l_verseq,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI,
                                   :NEW.CODPRM,:NEW.DATFIM,:NEW.HORFIM,:NEW.CODUSU,:NEW.OBSPRM,:NEW.STAACC);

          SP_AUDGENREG(l_seqreg,l_verseq,'R070PEC','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀cÚ␀␀	SENIOR;0I␀␀

TRIGGER R070PEC_SU AFTER UPDATE ON R070PEC
BEGIN
  R070PEC_ATUCON();

  R070PEC_RECALF();

  /* Tabela temporária */
  BEGIN
      DELETE FROM R070PEC_AUX;
      DROP_TEMP_TABLE R070PEC_AUX;
      DELETE FROM R070PEC_API;
      DROP_TEMP_TABLE R070PEC_API;
  EXCEPTION 
      WHEN OTHERS THEN NULL;
   END;
END␀_Ú␀␀		SENIOR;0æ␀␀

TRIGGER R070PEC_EU AFTER UPDATE ON R070PEC FOR EACH ROW
DECLARE
  l_online           BOOLEAN;
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_ade_gerpen       BOOLEAN;
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R070PEC_AUX;
  CREATE_TEMP_TABLE R070PEC_API;
  
BEGIN
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) THEN
      BEGIN
          /* Insere Registro NEW */
          INSERT INTO R070PEC_AUX (NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI)
                           VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI);
      EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro no INSERT em R070PEC_AUX.';
      END;

      IF (:OLD.STAACC = 1 OR :NEW.STAACC = 1) THEN
          SP_RECALF_GERPEN_1(:NEW.TIPCOL, l_ade_gerpen OUT);
          IF (l_ade_gerpen = TRUE) THEN
              BEGIN
              /* Insere Registro NEW */
                  INSERT INTO R070PEC_API (NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI)
                                   VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI);
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no INSERT em R070PEC_API.';
              END;
          END IF;
      END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R070PEC');

  IF (l_auditoria = 'S') THEN

      l_camposAlterados := 'Campo(s) alterado(s): ';
      l_alterou := FALSE;

      IF (:NEW.NUMEMP <> :OLD.NUMEMP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMEMP ';
      END IF;

      IF (:NEW.TIPCOL <> :OLD.TIPCOL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPCOL ';
      END IF;

      IF (:NEW.NUMCAD <> :OLD.NUMCAD) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCAD ';
      END IF;

      IF (:NEW.DATINI <> :OLD.DATINI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATINI ';
      END IF;

      IF (:NEW.HORINI <> :OLD.HORINI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORINI ';
      END IF;

      IF (:NEW.CODPRM <> :OLD.CODPRM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPRM ';
      END IF;

      IF (:NEW.DATFIM <> :OLD.DATFIM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATFIM ';
      END IF;

      IF (:NEW.HORFIM <> :OLD.HORFIM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORFIM ';
      END IF;

      IF (:NEW.CODUSU <> :OLD.CODUSU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODUSU ';
      END IF;

      IF (:NEW.OBSPRM <> :OLD.OBSPRM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'OBSPRM ';
      END IF;

        IF (:NEW.STAACC <> :OLD.STAACC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'STAACC ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R070PEC_AUD
                   WHERE NUMEMP = :OLD.NUMEMP AND
                         TIPCOL = :OLD.TIPCOL AND
                         NUMCAD = :OLD.NUMCAD AND
                         DATINI = :OLD.DATINI AND
                         HORINI = :OLD.HORINI AND
                         CODPRM = :OLD.CODPRM;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R070PEC_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,CODPRM,DATFIM,HORFIM,CODUSU,OBSPRM,STAACC)
                               VALUES (l_seqreg,l_verseq,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI,
                                       :NEW.CODPRM,:NEW.DATFIM,:NEW.HORFIM,:NEW.CODUSU,:NEW.OBSPRM,:NEW.STAACC);

              SP_AUDGENREG(l_seqreg,l_verseq,'R070PEC',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀aÚ␀␀	SENIOR;0I␀␀

TRIGGER R070PEC_SD AFTER DELETE ON R070PEC
BEGIN
  R070PEC_ATUCON();

  R070PEC_RECALF();

  /* Tabela temporária */
  BEGIN
      DELETE FROM R070PEC_AUX;
      DROP_TEMP_TABLE R070PEC_AUX;
      DELETE FROM R070PEC_API;
      DROP_TEMP_TABLE R070PEC_API;
  EXCEPTION 
      WHEN OTHERS THEN NULL;
   END;
END␀]Ú␀␀		SENIOR;0␀␀

TRIGGER R070PEC_ED AFTER DELETE ON R070PEC FOR EACH ROW
DECLARE
  l_online       BOOLEAN;
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_ade_gerpen   BOOLEAN;

  /* Tabela temporária */
  CREATE_TEMP_TABLE R070PEC_AUX;
  CREATE_TEMP_TABLE R070PEC_API;

BEGIN
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) THEN
      BEGIN
      /* Insere Registro OLD */
          INSERT INTO R070PEC_AUX (NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI)
                           VALUES (:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.DATINI,:OLD.HORINI);
      EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro no INSERT em R070PEC_AUX. ';
      END;

      /* Caso o histórico for presente, verifica se tem que remover o credenciamento da pessoa da ADE02. */
      IF (:OLD.STAACC = 1) THEN
          SP_RECALF_GERPEN_1(:OLD.TIPCOL, l_ade_gerpen OUT);
          IF (l_ade_gerpen = TRUE) THEN
              BEGIN
                  /* Insere Registro OLD */
                  INSERT INTO R070PEC_API (NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI)
                                   VALUES (:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.DATINI,:OLD.HORINI);
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no INSERT em R070PEC_API. ';
              END;
          END IF;
      END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R070PEC');

  IF (l_auditoria = 'S') THEN
      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg
                FROM R070PEC_AUD
               WHERE NUMEMP = :OLD.NUMEMP AND
                     TIPCOL = :OLD.TIPCOL AND
                     NUMCAD = :OLD.NUMCAD AND
                     DATINI = :OLD.DATINI AND
                     HORINI = :OLD.HORINI AND
                     CODPRM = :OLD.CODPRM;
           EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
          INSERT INTO R070PEC_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,CODPRM,DATFIM,HORFIM,CODUSU,OBSPRM,STAACC)
                           VALUES (l_seqreg,l_verseq,:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.DATINI,:OLD.HORINI,
                                   :OLD.CODPRM,:OLD.DATFIM,:OLD.HORFIM,:OLD.CODUSU,:OLD.OBSPRM,:OLD.STAACC);

          SP_AUDGENREG(l_seqreg,l_verseq,'R070PEC','DELETE');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀␀␀–¿␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀YÚ␀␀…¬␀␀´␀„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t„␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀„␀␀␀␀␀␀$0.0.w␀Æÿ␀␀ÿ␀EÑ␀„␀␀␀␀␀␀sG]G]GqC␀êÿ␀␀ÿ␀¤w·␀„␀␀␀␀␀␀oxdxdxì*␀␀Æÿ␀␀ÿ␀C-·␀„␀␀␀␀␀␀€=¿␀␀¿␀␀t␀Æÿ␀␀ÿ␀åDÑ␀„␀␀␀␀␀␀úFÔFÔFqC␀êÿ␀␀ÿ␀w·␀„␀␀␀␀␀␀Gx<x<xì*␀␀Æÿ␀␀ÿ␀×-‹␀„␀␀␀␀␀␀¥Am␀m␀—)␀␀Æÿ␀␀ÿ␀␀␀␀␀␀	␀˜¿␀␀␀	␀␀␀␀␀␀␀␀␀[Ú␀␀ş␀␀¢␀	„␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀­%␀‹␀	„␀␀␀␀␀␀(&␀|%␀&␀a␀Æÿ␀␀ÿ␀…¬␀␀´␀„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t„␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀„␀␀␀␀␀␀$0.0.w␀Æÿ␀␀ÿ␀EÑ␀„␀␀␀␀␀␀sG]G]GqC␀êÿ␀␀ÿ␀¤w·␀„␀␀␀␀␀␀oxdxdxì*␀␀Æÿ␀␀ÿ␀C-·␀„␀␀␀␀␀␀€=¿␀␀¿␀␀t␀Æÿ␀␀ÿ␀åDÑ␀„␀␀␀␀␀␀úFÔFÔFqC␀êÿ␀␀ÿ␀w·␀„␀␀␀␀␀␀Gx<x<xì*␀␀Æÿ␀␀ÿ␀×-‹␀„␀␀␀␀␀␀¥Am␀m␀—)␀␀Æÿ␀␀ÿ␀»³␀␀€␀„␀␀␀␀␀␀ñ³␀␀ñ³␀␀ñ³␀␀!|ˆ␀␀ÿ␀␀ÿ␀␀Ã„␀␀␀␀␀␀Å␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀0;1␀␀H␀␀␀␀␀␀␀␀␀␀␀␀␀␀\Ú␀␀…¬␀␀´␀„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t„␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀„␀␀␀␀␀␀$0.0.w␀Æÿ␀␀ÿ␀EÑ␀„␀␀␀␀␀␀sG]G]GqC␀êÿ␀␀ÿ␀¤w·␀„␀␀␀␀␀␀oxdxdxì*␀␀Æÿ␀␀ÿ␀C-·␀„␀␀␀␀␀␀€=¿␀␀¿␀␀t␀Æÿ␀␀ÿ␀åDÑ␀„␀␀␀␀␀␀úFÔFÔFqC␀êÿ␀␀ÿ␀w·␀„␀␀␀␀␀␀Gx<x<xì*␀␀Æÿ␀␀ÿ␀×-‹␀„␀␀␀␀␀␀¥Am␀m␀—)␀␀Æÿ␀␀ÿ␀␀␀␀␀␀	␀—¿␀␀␀	␀␀␀␀␀␀␀␀␀dÚ␀␀…¬␀␀´␀	„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀c¬␀␀Ì␀	„␀␀␀␀␀␀$0.0.w␀Æÿ␀␀DÚ␀␀␀EÑ␀	„␀␀␀␀␀␀sG]G]GqC␀êÿ␀␀ÿ␀¤w·␀	„␀␀␀␀␀␀oxdxdxì*␀␀Æÿ␀␀ÿ␀C-·␀	„␀␀␀␀␀␀€=¿␀␀¿␀␀t␀Æÿ␀␀ı×␀␀␀åDÑ␀„␀␀␀␀␀␀úFÔFÔFqC␀êÿ␀␀ÿ␀w·␀„␀␀␀␀␀␀Gx