END␀ßø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0 SP_PESFROMIDTPES
SP_STRTODATE
ï	␀␀PROCEDURE SP_SINASA(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

l_idtpes    VARCHAR2(23);
    l_nummat     VARCHAR2(15);
    l_datAsa     DATE;
    l_horAsa     NUMBER(4);
    l_horTer     NUMBER(4);
    l_codusu     NUMBER(10);
    l_staAcc     NUMBER(1);


    l_numemp    NUMBER(4);
    l_tipcol    NUMBER(1);
    l_numcad    NUMBER(9);
    l_tipdoc    NUMBER(1);
    l_numdoc    VARCHAR2(20);
    l_propac    VARCHAR2(20);
    l_tippes    NUMBER(2);

    l_coderr     NUMBER(2);
    l_datatu     DATE;
    l_count      NUMBER(1);

    /*Variáveis auxiliares para conversão de data*/
    l_datstr     CHAR(16);
    l_datcon     VARCHAR(25);

BEGIN
    /* inicializa variáveis */
    l_coderr := 0;
    p_RetErr := 0;
    l_idtpes := '';
    l_nummat := '';
    l_horTer := 1439;
    l_codusu := 0;
    l_staAcc := 0;
    l_datatu := CURDATE();
    l_datasa := CURDATE();
    
    /* separa os valores da string do p_valStr em cada variável */
    BEGIN
        l_idtpes := SUBSTRING(p_ValStr, 3,23);
        SP_PESFROMIDTPES(l_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT,
                         l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);

        /* converte data/hora inicial */
        l_datstr := SUBSTRING(p_ValStr, 26,16);
        l_datcon := SUBSTRING(l_datstr,1,2) || '/' || SUBSTRING(l_datstr,3,2) ||'/'||SUBSTRING(l_datstr,5,2);
        SP_STRTODATE(l_datcon,'DD/MM/AA', l_datAsa OUT);
        l_horAsa := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datstr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datstr,9,2)));

        l_horter := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(p_ValStr,42,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(p_ValStr,44,2)));

        l_codusu := SUBSTRING(p_ValStr, 46,10);

    EXCEPTION
        WHEN OTHERS THEN l_coderr := 1; /* erro de conversão na string */
    END;


    IF  (l_coderr = 0) THEN
        /* calcula o STAACC */
        IF (l_datAsa = l_datAtu)  THEN
            l_staacc := 1; /* presente */
        ELSE
            l_staacc := 2; /* passado */
        END IF;

        BEGIN
            INSERT INTO R073ASA (NUMMAT, DATASA, HORASA, HORTER, EMPAUT, TCLAUT, CADAUT, CODUSU, STAACC)
                         VALUES (l_nummat, l_datasa, l_horasa, l_horter, 0, 0, 0, l_codusu, l_staacc);
        EXCEPTION
            WHEN OTHERS THEN l_coderr := 10;   /* erro no INSERT do registro*/
        END;
    END IF;

    /* retorna Código do erro */
    p_retErr := l_codErr;
END␀àø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
&␀␀PROCEDURE SP_SINAUD(P_TIPOPE NUMBER(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATINI DATE,P_HORINI NUMBER(4),P_NUMCRA NUMBER(12),P_DATFIM DATE,P_HORFIM NUMBER(4),P_CODUSU NUMBER(10),P_RETSIN OUT NUMBER(2))
 IS
BEGIN
    /* inicializa variáveis */
    p_RetSin := 0;
END		ORACLE;20SP_DATSTR
SP_INTSTR
ü%␀␀create or replace PROCEDURE SP_SINAUD(p_tipope IN NUMBER,p_numemp IN NUMBER,p_tipcol IN NUMBER,p_numcad IN NUMBER,p_datini IN DATE,p_horini IN NUMBER,p_numcra IN NUMBER,p_datfim IN DATE,p_horfim IN NUMBER,p_codusu IN NUMBER,p_RetSin OUT NUMBER) IS
  l_temAud NUMBER(2);
  l_coderr NUMBER(2);
  l_codRPA NUMBER(9);
  l_datatu DATE;
  l_horatu NUMBER(5);
  l_datzer DATE;
  l_datfimANT DATE;
  l_horfimANT NUMBER(4);
  l_staaccANT NUMBER(1);
  l_staatuANT NUMBER(1);
  l_numempSTR VARCHAR2(255);
  l_tipcolSTR VARCHAR2(255);
  l_numcadSTR VARCHAR2(255);
  l_datiniSTR VARCHAR2(255);
  l_horiniStr VARCHAR2(255);
  l_numcraSTR VARCHAR2(255);
  l_OLDnumcra VARCHAR2(255);
  l_datfimSTR VARCHAR2(255);
  l_OLDdatfim VARCHAR2(255);
  l_horfimSTR VARCHAR2(255);
  l_OLDhorfim VARCHAR2(255);
  l_staacc VARCHAR2(255);
  l_OLDstaacc VARCHAR2(255);
  l_staatu VARCHAR2(255);
  l_OLDstaatu VARCHAR2(255);
  l_tamstr NUMBER(2);
begin
  p_RetSin := 0;
  l_coderr := 0;
  l_datatu := TO_DATE(TO_CHAR(GETDBDATETIME,'DD/MM/YYYY'),'DD/MM/YYYY');
  
  SELECT TO_CHAR(SYSTIMESTAMP, 'SSSSS') INTO l_horatu FROM DUAL;
  
  l_datzer :=  TO_DATE('31/12/1900,00:00:00','DD/MM/YYYY,HH24:MI:SS');


  l_tamstr := LENGTH(p_numemp);
  if (l_tamstr=1) then
    SP_INTSTR(p_numemp,'9',l_numempSTR);
  end if;
  if (l_tamstr=2) then
    SP_INTSTR(p_numemp,'99',l_numempSTR);
  end if;
  if (l_tamstr=3) then
    SP_INTSTR(p_numemp,'999',l_numempSTR);
  end if;
  if (l_tamstr=4) then
    SP_INTSTR(p_numemp,'9999',l_numempSTR);
  end if;
  SP_INTSTR(p_tipcol,'9',l_tipcolSTR);
  l_tamstr := LENGTH(p_numcad);
  if (l_tamstr=1) then
    SP_INTSTR(p_numcad,'9',l_numcadSTR);
  end if;
  if (l_tamstr=2) then
    SP_INTSTR(p_numcad,'99',l_numcadSTR);
  end if;
  if (l_tamstr=3) then
    SP_INTSTR(p_numcad,'999',l_numcadSTR);
  end if;
  if (l_tamstr=4) then
    SP_INTSTR(p_numcad,'9999',l_numcadSTR);
  end if;
  if (l_tamstr=5) then
    SP_INTSTR(p_numcad,'99999',l_numcadSTR);
  end if;
  if (l_tamstr=6) then
    SP_INTSTR(p_numcad,'999999',l_numcadSTR);
  end if;
  if (l_tamstr=7) then
    SP_INTSTR(p_numcad,'9999999',l_numcadSTR);
  end if;
  if (l_tamstr=8) then
    SP_INTSTR(p_numcad,'99999999',l_numcadSTR);
  end if;
  if (l_tamstr=9) then
    SP_INTSTR(p_numcad,'999999999',l_numcadSTR);
  end if;
  SP_INTSTR(p_numcra,'999999999999',l_numcraSTR);
  SP_DATSTR(p_datini,'DDMMYY',l_datiniSTR);
  l_datiniSTR := SUBSTR(l_datiniSTR,1,2)||'/'||SUBSTR(l_datiniSTR,3,2)||'/20'||SUBSTR(l_datiniSTR,5,2);
  SP_INTSTR(p_horini,'HHMM',l_horiniSTR);
  l_horiniSTR := SUBSTR(l_horiniSTR,1,2)||':'||SUBSTR(l_horiniSTR,3,2);
  SP_DATSTR(p_datfim,'DDMMYY',l_datfimSTR);
  l_datfimSTR := SUBSTR(l_datfimSTR,1,2)||'/'||SUBSTR(l_datfimSTR,3,2)||'/20'||SUBSTR(l_datfimSTR,5,2);
  SP_INTSTR(p_horfim,'HHMM',l_horfimSTR);
  l_horfimSTR := SUBSTR(l_horfimSTR,1,2)||':'||SUBSTR(l_horfimSTR,3,2);
  if (p_DatIni>l_datatu) 
      OR ((p_DatIni=l_datatu) 
      and (p_HorIni>l_horatu)) then
    l_staAtu := '0';
    l_staAcc := '0';
  else
    if (p_DatFim<>l_datzer) 
      AND ((p_DatFim<l_datatu) 
      OR ((p_DatFim=l_datatu) 
      AND ((p_HorFim<=l_horatu) 
      AND (p_HorFim<>0)))) then
      l_StaAtu := '2';
      l_StaAcc := '2';
    else
      l_StaAtu := '1';
