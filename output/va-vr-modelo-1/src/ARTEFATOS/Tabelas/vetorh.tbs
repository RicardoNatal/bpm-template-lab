DECLARE
l_DthCan     NUMBER(14,6);
BEGIN
  BEGIN
    SP_DATETIME(l_DthCan OUT);
    UPDATE R122CCO
       SET DTHCAN = l_DthCan
     WHERE NumCan = :NEW.NumCan;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar curriculo compilado do candidato (R122CCO).';
  END;
END␀|à␀␀		SENIOR;0h␀␀

