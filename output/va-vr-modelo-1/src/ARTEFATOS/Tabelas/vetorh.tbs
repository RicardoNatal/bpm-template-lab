TRIGGER R017PRM_EI AFTER INSERT ON R017PRM FOR EACH ROW
DECLARE
	l_datatu DATE;
	l_estpos   R017PRM.EstPos%TYPE;
	l_postra   R017PRM.PosTra%TYPE;
	l_idtcol CHAR(23);
	l_count  NUMBER(5);
	l_oridef NUMBER(1);
	
	CURSOR c_r038HPO IS
		SELECT R038HPO.NUMEMP, R038HPO.TIPCOL, R038HPO.NUMCAD, R017TAP.HISPRI FROM R038HPO, R017TAP
			WHERE R038HPO.CODTAP = R017TAP.CODTAP AND ESTPOS = l_estpos AND POSTRA = l_postra
			  AND R038HPO.INIATU <= l_datatu AND R038HPO.TERATU >= l_datatu;
	TYPE t_r038HPO IS RECORD(
		NUMEMP   R038HPO.NUMEMP%TYPE,
		TIPCOL   R038HPO.TIPCOL%TYPE,
		NUMCAD   R038HPO.NUMCAD%TYPE,
		HISPRI   R017TAP.HISPRI%TYPE);
	l_r038HPO t_r038HPO;
	
	/* CURSOR QUE OBTEM AS ACOES DA FAIXA DO DISPOSITIVO POR POSTO DE TRABALHO */
	CURSOR c_r017AFD IS
		SELECT CODDSP, DIASEM, ACOFAI
			FROM R017AFD WHERE ESTPOS = l_estpos AND POSTRA = l_postra;
	TYPE t_r017AFD IS RECORD(
		CODDSP   R017AFD.CODDSP%TYPE,
		DIASEM   R017AFD.DIASEM%TYPE,
		ACOFAI   R017AFD.ACOFAI%TYPE);
	l_r017AFD t_r017AFD;

	/* CURSOR QUE OBTEM AS ACOES DA FAIXA DO LOCAL FISICO POR POSTO DE TRABALHO */
	CURSOR c_r017AFL IS
		SELECT VERPLF, CODPLF, DIASEM, ACOFAI
			FROM R017AFL WHERE ESTPOS = l_estpos AND POSTRA = l_postra;
	TYPE t_r017AFL IS RECORD(
			VERPLF   R017AFL.VERPLF%TYPE,
			CODPLF   R017AFL.CODPLF%TYPE,
			DIASEM   R017AFL.DIASEM%TYPE,
			ACOFAI   R017AFL.ACOFAI%TYPE);
	l_r017AFL t_r017AFL;

	/* CURSOR QUE OBTEM AS FAIXAS DE ACESSO DA PERMISSAO POR POSTO DE TRABALHO */
	CURSOR c_r017FAP IS
		SELECT CODPLT, CODRLG, CODDSP, VERPLF, CODPLF, INIFAI, FIMFAI, DIASEM
			FROM R017FAP WHERE ESTPOS = l_estpos AND POSTRA = l_postra;
	TYPE t_r017FAP IS RECORD(
		CODPLT   R017FAP.CODPLT%TYPE,
		CODRLG   R017FAP.CODRLG%TYPE,
		CODDSP   R017FAP.CODDSP%TYPE,
		VERPLF   R017FAP.VERPLF%TYPE,
		CODPLF   R017FAP.CODPLF%TYPE,
		INIFAI   R017FAP.INIFAI%TYPE,
		FIMFAI   R017FAP.FIMFAI%TYPE,
		DIASEM   R017FAP.DIASEM%TYPE);
	l_r017FAP t_r017FAP;
BEGIN
	l_datatu := CURDATE();
	l_estpos := :NEW.ESTPOS;
	l_postra := :NEW.POSTRA;

	/* BUSCO TODOS OS COLABORADORES QUE POSSUEM ESTE POSTO DE TRABALHO VIGENTE NA DATA ATUAL */
	FOREACH c_r038HPO INTO l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_r038HPO.HISPRI
	LOOP
		IF (l_r038HPO.HISPRI = 'S') THEN
			l_oridef := 1; /* HISTORICO PRINCIPAL */
		ELSE
			l_oridef := 2; /* HISTORICO ADICIONAL */
		END IF;

		SP_RETIDTPES(l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, NULL, NULL, NULL, NULL, l_idtcol OUT);
		
		/* -- ATRIBUICAO DE PERMISSOES POR LOCAL FISICO/DISPOSITIVO POR POSTO -- */
		/* VERIFICO SE ESTE DISPOSITIVO JA ESTA ASSOCIADO AO COLABORADOR */
		BEGIN
			SELECT COUNT(1) INTO l_count FROM R034PRM WHERE IDTPES = l_idtcol AND CODDSP = :NEW.CODDSP;
			EXCEPTION
				WHEN NO_DATA_FOUND THEN
					l_count := 0;
				WHEN OTHERS THEN
					RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034PRM.';
		END;
	
		/* INSERE REGISTRO NA TABELA R034PRM. */
		IF (l_count = 0) THEN
			BEGIN
				INSERT INTO R034PRM (IDTPES, CODPLT, CODRLG, VERPLF, CODPLF, CODDSP,
					NUMAMB, NUMEMP, TIPCOL, NUMCAD, ESTPOS, POSTRA,	SEQREG, ORIDEF)
				VALUES  (l_idtcol, :NEW.CODPLT, :NEW.CODRLG, :NEW.VERPLF, :NEW.CODPLF, :NEW.CODDSP,
					0, l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_estpos, l_postra, 0, l_oridef);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir permissao por local fisico/dispositivo do posto de trabalho para o colaborador.';
			END;
		END IF;

		/* BUSCO POR FAIXA */
		FOREACH c_r017FAP INTO l_r017FAP.CODPLT, l_r017FAP.CODRLG, l_r017FAP.CODDSP, l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.INIFAI, l_r017FAP.FIMFAI, l_r017FAP.DIASEM
		LOOP
			/* VERIFICO SE ESTA FAIXA JA ESTA ASSOCIADA AO COLABORADOR */
			BEGIN
				SELECT COUNT(1) INTO l_count FROM R034FAP WHERE IDTPES = l_idtcol AND CODPLT = l_r017FAP.CODPLT AND CODRLG = l_r017FAP.CODRLG AND VERPLF = l_r017FAP.VERPLF
				  AND CODPLF = l_r017FAP.CODPLF AND INIFAI = l_r017FAP.INIFAI AND DIASEM = l_r017FAP.DIASEM AND CODDSP = l_r017FAP.CODDSP;
				EXCEPTION
					WHEN NO_DATA_FOUND THEN
						l_count := 0;
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034FAP.';
			END;
		
			/* INSERE REGISTRO NA TABELA R034FAP. */
			IF (l_count = 0) THEN
				BEGIN
					INSERT INTO R034FAP (IDTPES, CODPLT, CODRLG, NUMAMB, DIASEM, INIFAI, FIMFAI,
						VERPLF, CODPLF, CODDSP, ESTPOS, POSTRA)
					VALUES (l_idtcol, l_r017FAP.CODPLT, l_r017FAP.CODRLG, 0, l_r017FAP.DIASEM, l_r017FAP.INIFAI, l_r017FAP.FIMFAI,
							l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.CODDSP, l_estpos, l_postra);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir as faixas de acesso da permissao por posto de trabaho para o colaborador.';
				END;
			END IF;
		END LOOP;			
		
		/* BUSCO POR ACOES DA FAIXA - DISPOSITIVO */
		FOREACH c_r017AFD INTO l_r017AFD.CODDSP, l_r017AFD.DIASEM, l_r017AFD.ACOFAI
		LOOP
			/* VERIFICO SE ESTA ACAO DA FAIXA - DISPOSITIVO JA ESTA ASSOCIADA AO COLABORADOR */
			BEGIN
				SELECT COUNT(1) INTO l_count FROM R034AFD WHERE IDTPES = l_idtcol AND CODDSP = l_r017AFD.CODDSP AND DIASEM = l_r017AFD.DIASEM;
				EXCEPTION
					WHEN NO_DATA_FOUND THEN
						l_count := 0;
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034AFD.';
			END;
	
			/* INSERE REGISTRO NA TABELA R034AFD. SE JA EXISTIR, IGNORAR. */
			IF (l_count = 0) THEN
				BEGIN
					INSERT INTO R034AFD (IDTPES, CODDSP, DIASEM, ACOFAI, ESTPOS, POSTRA)
					VALUES (l_idtcol, l_r017AFD.CODDSP, l_r017AFD.DIASEM, l_r017AFD.ACOFAI, l_estpos, l_postra);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir acoes por faixa/dispositivo do posto de trabalho para o colaborador.';
				END;
			END IF;
		END LOOP;
	
		/* BUSCO POR ACOES DA FAIXA - LOCAL FISICO */
		FOREACH c_r017AFL INTO l_r017AFL.VERPLF, l_r017AFL.CODPLF, l_r017AFL.DIASEM, l_r017AFL.ACOFAI
		LOOP
			/* VERIFICO SE ESTA ACAO DA FAIXA - LOCAL FISICO JA ESTA ASSOCIADA AO COLABORADOR */
			BEGIN
				SELECT COUNT(1) INTO l_count FROM R034AFL WHERE IDTPES = l_idtcol AND VERPLF = l_r017AFL.VERPLF AND CODPLF = l_r017AFL.CODPLF AND DIASEM = l_r017AFL.DIASEM;
				EXCEPTION
					WHEN NO_DATA_FOUND THEN
						l_count := 0;
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034AFL.';
			END;
		
			/* INSERE REGISTRO NA TABELA R034AFL. SE JA EXISTIR, IGNORAR. */
			IF (l_count = 0) THEN
				BEGIN
					INSERT INTO R034AFL (IDTPES, VERPLF, CODPLF, DIASEM, ACOFAI, ESTPOS, POSTRA)
					VALUES (l_idtcol, l_r017AFL.VERPLF, l_r017AFL.CODPLF, l_r017AFL.DIASEM, l_r017AFL.ACOFAI, l_estpos, l_postra);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir acoes por faixa/local fisico do posto de trabalho para o colaborador.';
				END;
			END IF;
		END LOOP;
		
	END LOOP; /* FOREACH c_r038HPO */
END		SENIOR;21r␀␀

TRIGGER R017PRM_EI AFTER INSERT ON R017PRM FOR EACH ROW
DECLARE
	l_datatu DATE;
	l_estpos   R017PRM.EstPos%TYPE;
	l_postra   R017PRM.PosTra%TYPE;
	l_idtcol CHAR(23);
	l_count  NUMBER(5);
	l_oridef NUMBER(1);
	
	CURSOR c_r038HPO IS
		SELECT R038HPO.NUMEMP, R038HPO.TIPCOL, R038HPO.NUMCAD, R017TAP.HISPRI FROM R038HPO, R017TAP
			WHERE R038HPO.CODTAP = R017TAP.CODTAP AND ESTPOS = l_estpos AND POSTRA = l_postra
			  AND R038HPO.INIATU <= l_datatu AND R038HPO.TERATU >= l_datatu;
	TYPE t_r038HPO IS RECORD(
		NUMEMP   R038HPO.NUMEMP%TYPE,
		TIPCOL   R038HPO.TIPCOL%TYPE,
		NUMCAD   R038HPO.NUMCAD%TYPE,
		HISPRI   R017TAP.HISPRI%TYPE);
	l_r038HPO t_r038HPO;
	
	/* CURSOR QUE OBTEM AS ACOES DA FAIXA DO DISPOSITIVO POR POSTO DE TRABALHO */
	CURSOR c_r017AFD IS
		SELECT CODDSP, DIASEM, ACOFAI
			FROM R017AFD WHERE ESTPOS = l_estpos AND POSTRA = l_postra;
	TYPE t_r017AFD IS RECORD(
		CODDSP   R017AFD.CODDSP%TYPE,
		DIASEM   R017AFD.DIASEM%TYPE,
		ACOFAI   R017AFD.ACOFAI%TYPE);
	l_r017AFD t_r017AFD;

	/* CURSOR QUE OBTEM AS ACOES DA FAIXA DO LOCAL FISICO POR POSTO DE TRABALHO */
	CURSOR c_r017AFL IS
		SELECT VERPLF, CODPLF, DIASEM, ACOFAI
			FROM R017AFL WHERE ESTPOS = l_estpos AND POSTRA = l_postra;
	TYPE t_r017AFL IS RECORD(
			VERPLF   R017AFL.VERPLF%TYPE,
			CODPLF   R017AFL.CODPLF%TYPE,
			DIASEM   R017AFL.DIASEM%TYPE,
			ACOFAI   R017AFL.ACOFAI%TYPE);
	l_r017AFL t_r017AFL;

	/* CURSOR QUE OBTEM AS FAIXAS DE ACESSO DA PERMISSAO POR POSTO DE TRABALHO */
	CURSOR c_r017FAP IS
		SELECT CODPLT, CODRLG, CODDSP, VERPLF, CODPLF, INIFAI, FIMFAI, DIASEM
			FROM R017FAP WHERE ESTPOS = l_estpos AND POSTRA = l_postra;
	TYPE t_r017FAP IS RECORD(
		CODPLT   R017FAP.CODPLT%TYPE,
		CODRLG   R017FAP.CODRLG%TYPE,
		CODDSP   R017FAP.CODDSP%TYPE,
		VERPLF   R017FAP.VERPLF%TYPE,
		CODPLF   R017FAP.CODPLF%TYPE,
		INIFAI   R017FAP.INIFAI%TYPE,
		FIMFAI   R017FAP.FIMFAI%TYPE,
		DIASEM   R017FAP.DIASEM%TYPE);
	l_r017FAP t_r017FAP;
BEGIN
	l_datatu := CURDATE();
	l_estpos := :NEW.ESTPOS;
	l_postra := :NEW.POSTRA;

	/* BUSCO TODOS OS COLABORADORES QUE POSSUEM ESTE POSTO DE TRABALHO VIGENTE NA DATA ATUAL */
	FOREACH c_r038HPO INTO l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_r038HPO.HISPRI
	LOOP
		IF (l_r038HPO.HISPRI = 'S') THEN
			l_oridef := 1; /* HISTORICO PRINCIPAL */
		ELSE
			l_oridef := 2; /* HISTORICO ADICIONAL */
		END IF;

		SP_RETIDTPES(l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, NULL, NULL, NULL, NULL, l_idtcol OUT);
		
		/* -- ATRIBUICAO DE PERMISSOES POR LOCAL FISICO/DISPOSITIVO POR POSTO -- */
		/* VERIFICO SE ESTE DISPOSITIVO JA ESTA ASSOCIADO AO COLABORADOR */
		BEGIN
			SELECT COUNT(1) INTO l_count FROM R034PRM WHERE IDTPES = l_idtcol AND CODDSP = :NEW.CODDSP;
			EXCEPTION
				WHEN NO_DATA_FOUND THEN
					l_count := 0;
				WHEN OTHERS THEN
					RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034PRM.';
		END;
	
		/* INSERE REGISTRO NA TABELA R034PRM. */
		IF (l_count = 0) THEN
			BEGIN
				INSERT INTO R034PRM (IDTPES, CODPLT, CODRLG, VERPLF, CODPLF, CODDSP,
					NUMAMB, NUMEMP, TIPCOL, NUMCAD, ESTPOS, POSTRA,	SEQREG, ORIDEF)
				VALUES  (l_idtcol, :NEW.CODPLT, :NEW.CODRLG, :NEW.VERPLF, :NEW.CODPLF, :NEW.CODDSP,
					0, l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_estpos, l_postra, 0, l_oridef);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir permissao por local fisico/dispositivo do posto de trabalho para o colaborador.';
			END;
		END IF;

		/* BUSCO POR FAIXA */
		FOREACH c_r017FAP INTO l_r017FAP.CODPLT, l_r017FAP.CODRLG, l_r017FAP.CODDSP, l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.INIFAI, l_r017FAP.FIMFAI, l_r017FAP.DIASEM
		LOOP
			/* VERIFICO SE ESTA FAIXA JA ESTA ASSOCIADA AO COLABORADOR */
			BEGIN
				SELECT COUNT(1) INTO l_count FROM R034FAP WHERE IDTPES = l_idtcol AND CODPLT = l_r017FAP.CODPLT AND CODRLG = l_r017FAP.CODRLG AND VERPLF = l_r017FAP.VERPLF
				  AND CODPLF = l_r017FAP.CODPLF AND INIFAI = l_r017FAP.INIFAI AND DIASEM = l_r017FAP.DIASEM AND CODDSP = l_r017FAP.CODDSP;
				EXCEPTION
					WHEN NO_DATA_FOUND THEN
						l_count := 0;
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034FAP.';
			END;
		
			/* INSERE REGISTRO NA TABELA R034FAP. */
			IF (l_count = 0) THEN
				BEGIN
					INSERT INTO R034FAP (IDTPES, CODPLT, CODRLG, NUMAMB, DIASEM, INIFAI, FIMFAI,
						VERPLF, CODPLF, CODDSP, ESTPOS, POSTRA)
					VALUES (l_idtcol, l_r017FAP.CODPLT, l_r017FAP.CODRLG, 0, l_r017FAP.DIASEM, l_r017FAP.INIFAI, l_r017FAP.FIMFAI,
							l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.CODDSP, l_estpos, l_postra);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir as faixas de acesso da permissao por posto de trabaho para o colaborador.';
				END;
			END IF;
		END LOOP;			
		
		/* BUSCO POR ACOES DA FAIXA - DISPOSITIVO */
		FOREACH c_r017AFD INTO l_r017AFD.CODDSP, l_r017AFD.DIASEM, l_r017AFD.ACOFAI
		LOOP
			/* VERIFICO SE ESTA ACAO DA FAIXA - DISPOSITIVO JA ESTA ASSOCIADA AO COLABORADOR */
			BEGIN
				SELECT COUNT(1) INTO l_count FROM R034AFD WHERE IDTPES = l_idtcol AND CODDSP = l_r017AFD.CODDSP AND DIASEM = l_r017AFD.DIASEM;
				EXCEPTION
					WHEN NO_DATA_FOUND THEN
						l_count := 0;
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034AFD.';
			END;
	
			/* INSERE REGISTRO NA TABELA R034AFD. SE JA EXISTIR, IGNORAR. */
			IF (l_count = 0) THEN
				BEGIN
					INSERT INTO R034AFD (IDTPES, CODDSP, DIASEM, ACOFAI, ESTPOS, POSTRA)
					VALUES (l_idtcol, l_r017AFD.CODDSP, l_r017AFD.DIASEM, l_r017AFD.ACOFAI, l_estpos, l_postra);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir acoes por faixa/dispositivo do posto de trabalho para o colaborador.';
				END;
			END IF;
		END LOOP;
	
		/* BUSCO POR ACOES DA FAIXA - LOCAL FISICO */
		FOREACH c_r017AFL INTO l_r017AFL.VERPLF, l_r017AFL.CODPLF, l_r017AFL.DIASEM, l_r017AFL.ACOFAI
		LOOP
			/* VERIFICO SE ESTA ACAO DA FAIXA - LOCAL FISICO JA ESTA ASSOCIADA AO COLABORADOR */
			BEGIN
				SELECT COUNT(1) INTO l_count FROM R034AFL WHERE IDTPES = l_idtcol AND VERPLF = l_r017AFL.VERPLF AND CODPLF = l_r017AFL.CODPLF AND DIASEM = l_r017AFL.DIASEM;
				EXCEPTION
					WHEN NO_DATA_FOUND THEN
						l_count := 0;
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034AFL.';
			END;
		
			/* INSERE REGISTRO NA TABELA R034AFL. SE JA EXISTIR, IGNORAR. */
			IF (l_count = 0) THEN
				BEGIN
					INSERT INTO R034AFL (IDTPES, VERPLF, CODPLF, DIASEM, ACOFAI, ESTPOS, POSTRA)
					VALUES (l_idtcol, l_r017AFL.VERPLF, l_r017AFL.CODPLF, l_r017AFL.DIASEM, l_r017AFL.ACOFAI, l_estpos, l_postra);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir acoes por faixa/local fisico do posto de trabalho para o colaborador.';
				END;
			END IF;
		END LOOP;
		
	END LOOP; /* FOREACH c_r038HPO */
END		SENIOR;22r␀␀

TRIGGER R017PRM_EI AFTER INSERT ON R017PRM FOR EACH ROW
DECLARE
	l_datatu DATE;
	l_estpos   R017PRM.EstPos%TYPE;
	l_postra   R017PRM.PosTra%TYPE;
	l_idtcol CHAR(23);
	l_count  NUMBER(5);
	l_oridef NUMBER(1);
	
	CURSOR c_r038HPO IS
		SELECT R038HPO.NUMEMP, R038HPO.TIPCOL, R038HPO.NUMCAD, R017TAP.HISPRI FROM R038HPO, R017TAP
			WHERE R038HPO.CODTAP = R017TAP.CODTAP AND ESTPOS = l_estpos AND POSTRA = l_postra
			  AND R038HPO.INIATU <= l_datatu AND R038HPO.TERATU >= l_datatu;
	TYPE t_r038HPO IS RECORD(
		NUMEMP   R038HPO.NUMEMP%TYPE,
		TIPCOL   R038HPO.TIPCOL%TYPE,
		NUMCAD   R038HPO.NUMCAD%TYPE,
		HISPRI   R017TAP.HISPRI%TYPE);
	l_r038HPO t_r038HPO;
	
	/* CURSOR QUE OBTEM AS ACOES DA FAIXA DO DISPOSITIVO POR POSTO DE TRABALHO */
	CURSOR c_r017AFD IS
		SELECT CODDSP, DIASEM, ACOFAI
			FROM R017AFD WHERE ESTPOS = l_estpos AND POSTRA = l_postra;
	TYPE t_r017AFD IS RECORD(
		CODDSP   R017AFD.CODDSP%TYPE,
		DIASEM   R017AFD.DIASEM%TYPE,
		ACOFAI   R017AFD.ACOFAI%TYPE);
	l_r017AFD t_r017AFD;

	/* CURSOR QUE OBTEM AS ACOES DA FAIXA DO LOCAL FISICO POR POSTO DE TRABALHO */
	CURSOR c_r017AFL IS
		SELECT VERPLF, CODPLF, DIASEM, ACOFAI
			FROM R017AFL WHERE ESTPOS = l_estpos AND POSTRA = l_postra;
	TYPE t_r017AFL IS RECORD(
			VERPLF   R017AFL.VERPLF%TYPE,
			CODPLF   R017AFL.CODPLF%TYPE,
			DIASEM   R017AFL.DIASEM%TYPE,
			ACOFAI   R017AFL.ACOFAI%TYPE);
	l_r017AFL t_r017AFL;

	/* CURSOR QUE OBTEM AS FAIXAS DE ACESSO DA PERMISSAO POR POSTO DE TRABALHO */
	CURSOR c_r017FAP IS
		SELECT CODPLT, CODRLG, CODDSP, VERPLF, CODPLF, INIFAI, FIMFAI, DIASEM
			FROM R017FAP WHERE ESTPOS = l_estpos AND POSTRA = l_postra;
	TYPE t_r017FAP IS RECORD(
		CODPLT   R017FAP.CODPLT%TYPE,
		CODRLG   R017FAP.CODRLG%TYPE,
		CODDSP   R017FAP.CODDSP%TYPE,
		VERPLF   R017FAP.VERPLF%TYPE,
		CODPLF   R017FAP.CODPLF%TYPE,
		INIFAI   R017FAP.INIFAI%TYPE,
		FIMFAI   R017FAP.FIMFAI%TYPE,
		DIASEM   R017FAP.DIASEM%TYPE);
	l_r017FAP t_r017FAP;
BEGIN
	l_datatu := CURDATE();
	l_estpos := :NEW.ESTPOS;
	l_postra := :NEW.POSTRA;

	/* BUSCO TODOS OS COLABORADORES QUE POSSUEM ESTE POSTO DE TRABALHO VIGENTE NA DATA ATUAL */
	FOREACH c_r038HPO INTO l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_r038HPO.HISPRI
	LOOP
		IF (l_r038HPO.HISPRI = 'S') THEN
			l_oridef := 1; /* HISTORICO PRINCIPAL */
		ELSE
			l_oridef := 2; /* HISTORICO ADICIONAL */
		END IF;

		SP_RETIDTPES(l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, NULL, NULL, NULL, NULL, l_idtcol OUT);
		
		/* -- ATRIBUICAO DE PERMISSOES POR LOCAL FISICO/DISPOSITIVO POR POSTO -- */
		/* VERIFICO SE ESTE DISPOSITIVO JA ESTA ASSOCIADO AO COLABORADOR */
		BEGIN
			SELECT COUNT(1) INTO l_count FROM R034PRM WHERE IDTPES = l_idtcol AND CODDSP = :NEW.CODDSP;
			EXCEPTION
				WHEN NO_DATA_FOUND THEN
					l_count := 0;
				WHEN OTHERS THEN
					RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034PRM.';
		END;
	
		/* INSERE REGISTRO NA TABELA R034PRM. */
		IF (l_count = 0) THEN
			BEGIN
				INSERT INTO R034PRM (IDTPES, CODPLT, CODRLG, VERPLF, CODPLF, CODDSP,
					NUMAMB, NUMEMP, TIPCOL, NUMCAD, ESTPOS, POSTRA,	SEQREG, ORIDEF)
				VALUES  (l_idtcol, :NEW.CODPLT, :NEW.CODRLG, :NEW.VERPLF, :NEW.CODPLF, :NEW.CODDSP,
					0, l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_estpos, l_postra, 0, l_oridef);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir permissao por local fisico/dispositivo do posto de trabalho para o colaborador.';
			END;
		END IF;

		/* BUSCO POR FAIXA */
		FOREACH c_r017FAP INTO l_r017FAP.CODPLT, l_r017FAP.CODRLG, l_r017FAP.CODDSP, l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.INIFAI, l_r017FAP.FIMFAI, l_r017FAP.DIASEM
		LOOP
			/* VERIFICO SE ESTA FAIXA JA ESTA ASSOCIADA AO COLABORADOR */
			BEGIN
				SELECT COUNT(1) INTO l_count FROM R034FAP WHERE IDTPES = l_idtcol AND CODPLT = l_r017FAP.CODPLT AND CODRLG = l_r017FAP.CODRLG AND VERPLF = l_r017FAP.VERPLF
				  AND CODPLF = l_r017FAP.CODPLF AND INIFAI = l_r017FAP.INIFAI AND DIASEM = l_r017FAP.DIASEM AND CODDSP = l_r017FAP.CODDSP;
				EXCEPTION
					WHEN NO_DATA_FOUND THEN
						l_count := 0;
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034FAP.';
			END;
		
			/* INSERE REGISTRO NA TABELA R034FAP. */
			IF (l_count = 0) THEN
				BEGIN
					INSERT INTO R034FAP (IDTPES, CODPLT, CODRLG, NUMAMB, DIASEM, INIFAI, FIMFAI,
						VERPLF, CODPLF, CODDSP, ESTPOS, POSTRA)
					VALUES (l_idtcol, l_r017FAP.CODPLT, l_r017FAP.CODRLG, 0, l_r017FAP.DIASEM, l_r017FAP.INIFAI, l_r017FAP.FIMFAI,
							l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.CODDSP, l_estpos, l_postra);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir as faixas de acesso da permissao por posto de trabaho para o colaborador.';
				END;
			END IF;
		END LOOP;			
		
		/* BUSCO POR ACOES DA FAIXA - DISPOSITIVO */
		FOREACH c_r017AFD INTO l_r017AFD.CODDSP, l_r017AFD.DIASEM, l_r017AFD.ACOFAI
		LOOP
			/* VERIFICO SE ESTA ACAO DA FAIXA - DISPOSITIVO JA ESTA ASSOCIADA AO COLABORADOR */
			BEGIN
				SELECT COUNT(1) INTO l_count FROM R034AFD WHERE IDTPES = l_idtcol AND CODDSP = l_r017AFD.CODDSP AND DIASEM = l_r017AFD.DIASEM;
				EXCEPTION
					WHEN NO_DATA_FOUND THEN
						l_count := 0;
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034AFD.';
			END;
	
			/* INSERE REGISTRO NA TABELA R034AFD. SE JA EXISTIR, IGNORAR. */
			IF (l_count = 0) THEN
				BEGIN
					INSERT INTO R034AFD (IDTPES, CODDSP, DIASEM, ACOFAI, ESTPOS, POSTRA)
					VALUES (l_idtcol, l_r017AFD.CODDSP, l_r017AFD.DIASEM, l_r017AFD.ACOFAI, l_estpos, l_postra);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir acoes por faixa/dispositivo do posto de trabalho para o colaborador.';
				END;
			END IF;
		END LOOP;
	
		/* BUSCO POR ACOES DA FAIXA - LOCAL FISICO */
		FOREACH c_r017AFL INTO l_r017AFL.VERPLF, l_r017AFL.CODPLF, l_r017AFL.DIASEM, l_r017AFL.ACOFAI
		LOOP
			/* VERIFICO SE ESTA ACAO DA FAIXA - LOCAL FISICO JA ESTA ASSOCIADA AO COLABORADOR */
			BEGIN
				SELECT COUNT(1) INTO l_count FROM R034AFL WHERE IDTPES = l_idtcol AND VERPLF = l_r017AFL.VERPLF AND CODPLF = l_r017AFL.CODPLF AND DIASEM = l_r017AFL.DIASEM;
				EXCEPTION
					WHEN NO_DATA_FOUND THEN
						l_count := 0;
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034AFL.';
			END;
		
			/* INSERE REGISTRO NA TABELA R034AFL. SE JA EXISTIR, IGNORAR. */
			IF (l_count = 0) THEN
				BEGIN
					INSERT INTO R034AFL (IDTPES, VERPLF, CODPLF, DIASEM, ACOFAI, ESTPOS, POSTRA)
					VALUES (l_idtcol, l_r017AFL.VERPLF, l_r017AFL.CODPLF, l_r017AFL.DIASEM, l_r017AFL.ACOFAI, l_estpos, l_postra);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir acoes por faixa/local fisico do posto de trabalho para o colaborador.';
				END;
			END IF;
		END LOOP;
		
	END LOOP; /* FOREACH c_r038HPO */
END		SENIOR;23r␀␀

TRIGGER R017PRM_EI AFTER INSERT ON R017PRM FOR EACH ROW
DECLARE
	l_datatu DATE;
	l_estpos   R017PRM.EstPos%TYPE;
	l_postra   R017PRM.PosTra%TYPE;
	l_idtcol CHAR(23);
	l_count  NUMBER(5);
	l_oridef NUMBER(1);
	
	CURSOR c_r038HPO IS
		SELECT R038HPO.NUMEMP, R038HPO.TIPCOL, R038HPO.NUMCAD, R017TAP.HISPRI FROM R038HPO, R017TAP
			WHERE R038HPO.CODTAP = R017TAP.CODTAP AND ESTPOS = l_estpos AND POSTRA = l_postra
			  AND R038HPO.INIATU <= l_datatu AND R038HPO.TERATU >= l_datatu;
	TYPE t_r038HPO IS RECORD(
		NUMEMP   R038HPO.NUMEMP%TYPE,
		TIPCOL   R038HPO.TIPCOL%TYPE,
		NUMCAD   R038HPO.NUMCAD%TYPE,
		HISPRI   R017TAP.HISPRI%TYPE);
	l_r038HPO t_r038HPO;
	
	/* CURSOR QUE OBTEM AS ACOES DA FAIXA DO DISPOSITIVO POR POSTO DE TRABALHO */
	CURSOR c_r017AFD IS
		SELECT CODDSP, DIASEM, ACOFAI
			FROM R017AFD WHERE ESTPOS = l_estpos AND POSTRA = l_postra;
	TYPE t_r017AFD IS RECORD(
		CODDSP   R017AFD.CODDSP%TYPE,
		DIASEM   R017AFD.DIASEM%TYPE,
		ACOFAI   R017AFD.ACOFAI%TYPE);
	l_r017AFD t_r017AFD;

	/* CURSOR QUE OBTEM AS ACOES DA FAIXA DO LOCAL FISICO POR POSTO DE TRABALHO */
	CURSOR c_r017AFL IS
		SELECT VERPLF, CODPLF, DIASEM, ACOFAI
			FROM R017AFL WHERE ESTPOS = l_estpos AND POSTRA = l_postra;
	TYPE t_r017AFL IS RECORD(
			VERPLF   R017AFL.VERPLF%TYPE,
			CODPLF   R017AFL.CODPLF%TYPE,
			DIASEM   R017AFL.DIASEM%TYPE,
			ACOFAI   R017AFL.ACOFAI%TYPE);
	l_r017AFL t_r017AFL;

	/* CURSOR QUE OBTEM AS FAIXAS DE ACESSO DA PERMISSAO POR POSTO DE TRABALHO */
	CURSOR c_r017FAP IS
		SELECT CODPLT, CODRLG, CODDSP, VERPLF, CODPLF, INIFAI, FIMFAI, DIASEM
			FROM R017FAP WHERE ESTPOS = l_estpos AND POSTRA = l_postra;
	TYPE t_r017FAP IS RECORD(
		CODPLT   R017FAP.CODPLT%TYPE,
		CODRLG   R017FAP.CODRLG%TYPE,
		CODDSP   R017FAP.CODDSP%TYPE,
		VERPLF   R017FAP.VERPLF%TYPE,
		CODPLF   R017FAP.CODPLF%TYPE,
		INIFAI   R017FAP.INIFAI%TYPE,
		FIMFAI   R017FAP.FIMFAI%TYPE,
		DIASEM   R017FAP.DIASEM%TYPE);
	l_r017FAP t_r017FAP;
BEGIN
	l_datatu := CURDATE();
	l_estpos := :NEW.ESTPOS;
	l_postra := :NEW.POSTRA;

	/* BUSCO TODOS OS COLABORADORES QUE POSSUEM ESTE POSTO DE TRABALHO VIGENTE NA DATA ATUAL */
	FOREACH c_r038HPO INTO l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_r038HPO.HISPRI
	LOOP
		IF (l_r038HPO.HISPRI = 'S') THEN
			l_oridef := 1; /* HISTORICO PRINCIPAL */
		ELSE
			l_oridef := 2; /* HISTORICO ADICIONAL */
		END IF;

		SP_RETIDTPES(l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, NULL, NULL, NULL, NULL, l_idtcol OUT);
		
		/* -- ATRIBUICAO DE PERMISSOES POR LOCAL FISICO/DISPOSITIVO POR POSTO -- */
		/* VERIFICO SE ESTE DISPOSITIVO JA ESTA ASSOCIADO AO COLABORADOR */
		BEGIN
			SELECT COUNT(1) INTO l_count FROM R034PRM WHERE IDTPES = l_idtcol AND CODDSP = :NEW.CODDSP;
			EXCEPTION
				WHEN NO_DATA_FOUND THEN
					l_count := 0;
				WHEN OTHERS THEN
					RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034PRM.';
		END;
	
		/* INSERE REGISTRO NA TABELA R034PRM. */
		IF (l_count = 0) THEN
			BEGIN
				INSERT INTO R034PRM (IDTPES, CODPLT, CODRLG, VERPLF, CODPLF, CODDSP,
					NUMAMB, NUMEMP, TIPCOL, NUMCAD, ESTPOS, POSTRA,	SEQREG, ORIDEF)
				VALUES  (l_idtcol, :NEW.CODPLT, :NEW.CODRLG, :NEW.VERPLF, :NEW.CODPLF, :NEW.CODDSP,
					0, l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_estpos, l_postra, 0, l_oridef);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir permissao por local fisico/dispositivo do posto de trabalho para o colaborador.';
			END;
		END IF;

		/* BUSCO POR FAIXA */
		FOREACH c_r017FAP INTO l_r017FAP.CODPLT, l_r017FAP.CODRLG, l_r017FAP.CODDSP, l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.INIFAI, l_r017FAP.FIMFAI, l_r017FAP.DIASEM
		LOOP
			/* VERIFICO SE ESTA FAIXA JA ESTA ASSOCIADA AO COLABORADOR */
			BEGIN
				SELECT COUNT(1) INTO l_count FROM R034FAP WHERE IDTPES = l_idtcol AND CODPLT = l_r017FAP.CODPLT AND CODRLG = l_r017FAP.CODRLG AND VERPLF = l_r017FAP.VERPLF
				  AND CODPLF = l_r017FAP.CODPLF AND INIFAI = l_r017FAP.INIFAI AND DIASEM = l_r017FAP.DIASEM AND CODDSP = l_r017FAP.CODDSP;
				EXCEPTION
					WHEN NO_DATA_FOUND THEN
						l_count := 0;
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034FAP.';
			END;
		
			/* INSERE REGISTRO NA TABELA R034FAP. */
			IF (l_count = 0) THEN
				BEGIN
					INSERT INTO R034FAP (IDTPES, CODPLT, CODRLG, NUMAMB, DIASEM, INIFAI, FIMFAI,
						VERPLF, CODPLF, CODDSP, ESTPOS, POSTRA)
					VALUES (l_idtcol, l_r017FAP.CODPLT, l_r017FAP.CODRLG, 0, l_r017FAP.DIASEM, l_r017FAP.INIFAI, l_r017FAP.FIMFAI,
							l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.CODDSP, l_estpos, l_postra);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir as faixas de acesso da permissao por posto de trabaho para o colaborador.';
				END;
			END IF;
		END LOOP;			
		
		/* BUSCO POR ACOES DA FAIXA - DISPOSITIVO */
		FOREACH c_r017AFD INTO l_r017AFD.CODDSP, l_r017AFD.DIASEM, l_r017AFD.ACOFAI
		LOOP
			/* VERIFICO SE ESTA ACAO DA FAIXA - DISPOSITIVO JA ESTA ASSOCIADA AO COLABORADOR */
			BEGIN
				SELECT COUNT(1) INTO l_count FROM R034AFD WHERE IDTPES = l_idtcol AND CODDSP = l_r017AFD.CODDSP AND DIASEM = l_r017AFD.DIASEM;
				EXCEPTION
					WHEN NO_DATA_FOUND THEN
						l_count := 0;
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034AFD.';
			END;
	
			/* INSERE REGISTRO NA TABELA R034AFD. SE JA EXISTIR, IGNORAR. */
			IF (l_count = 0) THEN
				BEGIN
					INSERT INTO R034AFD (IDTPES, CODDSP, DIASEM, ACOFAI, ESTPOS, POSTRA)
					VALUES (l_idtcol, l_r017AFD.CODDSP, l_r017AFD.DIASEM, l_r017AFD.ACOFAI, l_estpos, l_postra);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir acoes por faixa/dispositivo do posto de trabalho para o colaborador.';
				END;
			END IF;
		END LOOP;
	
		/* BUSCO POR ACOES DA FAIXA - LOCAL FISICO */
		FOREACH c_r017AFL INTO l_r017AFL.VERPLF, l_r017AFL.CODPLF, l_r017AFL.DIASEM, l_r017AFL.ACOFAI
		LOOP
			/* VERIFICO SE ESTA ACAO DA FAIXA - LOCAL FISICO JA ESTA ASSOCIADA AO COLABORADOR */
			BEGIN
				SELECT COUNT(1) INTO l_count FROM R034AFL WHERE IDTPES = l_idtcol AND VERPLF = l_r017AFL.VERPLF AND CODPLF = l_r017AFL.CODPLF AND DIASEM = l_r017AFL.DIASEM;
				EXCEPTION
					WHEN NO_DATA_FOUND THEN
						l_count := 0;
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034AFL.';
			END;
		
			/* INSERE REGISTRO NA TABELA R034AFL. SE JA EXISTIR, IGNORAR. */
			IF (l_count = 0) THEN
				BEGIN
					INSERT INTO R034AFL (IDTPES, VERPLF, CODPLF, DIASEM, ACOFAI, ESTPOS, POSTRA)
					VALUES (l_idtcol, l_r017AFL.VERPLF, l_r017AFL.CODPLF, l_r017AFL.DIASEM, l_r017AFL.ACOFAI, l_estpos, l_postra);
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'R017PRM_EI: Erro ao incluir acoes por faixa/local fisico do posto de trabalho para o colaborador.';
				END;
			END IF;
		END LOOP;
		
	END LOOP; /* FOREACH c_r038HPO */
END␀£Ğ␀␀		SENIOR;0P

TRIGGER R017PRM_ED AFTER DELETE ON R017PRM FOR EACH ROW
BEGIN
  NULL;
