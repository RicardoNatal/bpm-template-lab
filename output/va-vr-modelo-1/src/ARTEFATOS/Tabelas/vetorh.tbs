       R038AFA.TIPCOL, 
       R038AFA.NUMCAD, 
       R038AFA.DATAFA, 
       R038AFA.HORAFA, 
       CASE IFNULL(R038AFA.DATTER,DAY(1900,12,31))
         WHEN DAY(1900,12,31) THEN DAY(2059,12,31)
         ELSE R038AFA.DATTER
       END DATTER, 
       IFNULL(R038AFA.PRVTER,DAY(1900,12,31)) PRVTER, 
       R038AFA.HORTER, 
       R038AFA.SITAFA 
  FROM R038AFA 
  
UNION 

SELECT R034FUN.NUMEMP, 
       R034FUN.TIPCOL, 
       R034FUN.NUMCAD, 
       R034FUN.DATADM, 
       0 HORAFA, 
       R038AFA.DATAFA - 1 DATTER, 
       DAY(1900,12,31) PRVTER, 
       0 HORTER, 
       1 SITAFA 
  FROM R034FUN, R038AFA 
 WHERE R034FUN.NUMEMP = R038AFA.NUMEMP 
   AND R034FUN.TIPCOL = R038AFA.TIPCOL 
   AND R034FUN.NUMCAD = R038AFA.NUMCAD 
   AND R038AFA.DATAFA = (SELECT MIN(B.DATAFA) 
                           FROM R038AFA B 
                          WHERE R034FUN.NUMEMP = B.NUMEMP 
                            AND R034FUN.TIPCOL = B.TIPCOL 
                            AND R034FUN.NUMCAD = B.NUMCAD) 

UNION 

SELECT A.NUMEMP, 
       A.TIPCOL, 
       A.NUMCAD, 
       A.DATADM DATAFA, 
       0 HORAFA, 
       DAY(2059,12,31) DATTER, 
       DAY(1900,12,31) PRVTER, 
       0 HORTER, 
       1 SITAFA 
  FROM R034FUN A 
 WHERE NOT EXISTS(SELECT 1 FROM R038AFA B 
                   WHERE A.NUMEMP = B.NUMEMP 
                     AND A.TIPCOL = B.TIPCOL 
                     AND A.NUMCAD = B.NUMCAD) 

UNION 

SELECT A.NUMEMP, 
       A.TIPCOL, 
       A.NUMCAD,
       A.DATTER + 1 DATAFA, 
       0 HORAFA, 
       B.DATAFA - 1 DATTER, 
       DAY(1900,12,31) PRVTER, 
       0 HORTER, 
       1 SITAFA 
  FROM R038AFA A, R038AFA B 
 WHERE NOT EXISTS(SELECT 1 
                    FROM R038AFA C 
                   WHERE A.NUMEMP = C.NUMEMP 
                     AND A.NUMCAD = C.NUMCAD 
                     AND A.TIPCOL = C.TIPCOL 
                     AND C.DATTER = A.DATTER + 1) 
                     AND A.DATTER + 1 < TODAY 
                     AND A.NUMEMP = B.NUMEMP 
                     AND A.TIPCOL = B.TIPCOL 
                     AND A.NUMCAD = B.NUMCAD 
                     AND B.DATAFA <> A.DATTER + 1 
                     AND B.DATAFA <> A.DATTER 
                     AND B.DATAFA = (SELECT MIN(D.DATAFA) 
                                       FROM R038AFA D 
                                      WHERE D.NUMEMP = B.NUMEMP 
                                        AND D.TIPCOL = B.TIPCOL 
                                        AND D.NUMCAD = B.NUMCAD 
                                        AND D.DATAFA > A.DATTER) 
                     AND A.DATAFA < (SELECT MAX(D.DATAFA) 
                                       FROM R038AFA D 
                                      WHERE D.NUMEMP = A.NUMEMP 
                                        AND D.TIPCOL = A.TIPCOL 
                                        AND D.NUMCAD = A.NUMCAD) 
                                        
UNION 

SELECT A.NUMEMP, 
       A.TIPCOL, 
       A.NUMCAD, 
       A.DATTER + 1 DATAFA, 
       0 HORAFA, 
       DAY(2059,12,31) DATTER, 
       DAY(1900,12,31) PRVTER, 
       0 HORTER, 
       1 SITAFA 
  FROM R038AFA A 
 WHERE A.DATAFA = (SELECT MAX(B.DATAFA) 
                     FROM R038AFA B 
                    WHERE A.NUMEMP = B.NUMEMP AND A.TIPCOL = B.TIPCOL AND A.NUMCAD = B.NUMCAD) 
   AND A.DATTER < TODAY 
   AND A.SITAFA <> 7␀␀ÿ½␀+␀Š␀␀␀␀␀␀␀␀␀ÿÿÿÿ␀␀Æÿ␀␀ÿ␀␀ SELECT 2 tampos FROM r000ass WHERE upper(novloc)='N' OR novloc=''
