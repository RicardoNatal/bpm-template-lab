            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'STAATU',l_staatu);
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TIPCRA','2');
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TIPOPE','INCLUSÃO');
          exception
            when OTHERS then
              l_coderr := 1;
          end;
        end if;
      end if;
    end if;
