TRIGGER R530REV_SI AFTER INSERT ON R530REV

DECLARE
/* CURSOR c/ os registros gravados na tabela R530REV_AUX */
  CURSOR c_R530REV_AuxI IS SELECT DISTINCT R530REV_AUX.GRUREQ FROM R530REV_AUX;

  TYPE t_R530REV_AuxI IS RECORD(
    GRUREQ   R530REV_AUX.GRUREQ%TYPE);

  l_R530REV_AuxI t_R530REV_AuxI;
BEGIN
  /* Seta flag de controle para 1, evitando que a trigger seja
     processada em mais de uma instancia, controle necessário para evitar a Recursividade */
  BEGIN
    UPDATE R530REV_AUX SET FLGCON = 1;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro flag de controle da tabela R530REV_AUX.';
  END;

  /* Calcula data final para todos os registros do Grupo de requisitos informado */
  FOREACH c_R530REV_AuxI INTO l_R530REV_AuxI.GRUREQ
  LOOP
    BEGIN
      UPDATE R530REV
         SET DATTER = (SELECT IFNULL((DATETIMEADD(DD, -1, MIN(REV.DATINI))), DATETIME(31, 12, 1900, 0, 0, 0)) FROM R530REV REV
                        WHERE REV.GRUREQ = R530REV.GRUREQ
                          AND REV.DATINI > R530REV.DATINI)
       WHERE GRUREQ = l_R530REV_AuxI.GRUREQ;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar data de término da revisão.';
    END;
  END LOOP;

  /* Apaga Registros em R530REV_AUX */
  BEGIN
    DELETE FROM R530REV_AUX;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao excluir registros da tabela R530REV_AUX.';
  END;
END␀ïé␀␀		SENIOR;0␀␀TRIGGER R530REV_EI AFTER INSERT ON R530REV FOR EACH ROW

BEGIN
BEGIN
    /* Insere Registro New */
    INSERT INTO R530REV_AUX (GRUREQ, FLGCON) VALUES (:NEW.GRUREQ, 0);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao inserir registro na tabela R530REV_AUX.';
  END;
END␀óé␀␀	SENIOR;0‰␀␀

TRIGGER R530REV_SU AFTER UPDATE ON R530REV

DECLARE
/* CURSOR c/ os registros gravados na tabela R530REV_AUX */
  CURSOR c_R530REV_AuxU IS SELECT DISTINCT R530REV_AUX.GRUREQ FROM R530REV_AUX;

  TYPE t_R530REV_AuxU IS RECORD(
    GRUREQ   R530REV_AUX.GRUREQ%TYPE);

  l_R530REV_AuxU t_R530REV_AuxU;
  l_Count        NUMBER;
BEGIN
  /* Garante que está sendo processado a trigger uma unica vez, evitando assim LOOP */
  BEGIN
    SELECT COUNT(*) INTO l_Count FROM R530REV_AUX
     WHERE FLGCON = 1;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao retornar flag de controle da tabela R530REV_AUX.';
  END;

  /* Se não existe registro com Flag = 1 significa estar passando pela primeira vez na trigger */
  IF (l_Count  = 0) THEN
    /* Seta flag de controle para 1, evitando que a trigger seja
       processada em mais de uma instancia, controle necessário para evitar a Recursividade */
    BEGIN
      UPDATE R530REV_AUX SET FLGCON = 1;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro flag de controle da tabela R530REV_AUX.';
    END;

    /* Calcula data final para todos os registros do Grupo de requisitos informado */
    FOREACH c_R530REV_AuxU INTO l_R530REV_AuxU.GRUREQ
    LOOP
      BEGIN
        UPDATE R530REV
           SET DATTER = (SELECT IFNULL((DATETIMEADD(DD, -1, MIN(REV.DATINI))), DATETIME(31, 12, 1900, 0, 0, 0)) FROM R530REV REV
                          WHERE REV.GRUREQ = R530REV.GRUREQ
                            AND REV.DATINI > R530REV.DATINI)
         WHERE GRUREQ = l_R530REV_AuxU.GRUREQ;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao atualizar data de término da revisão.';
      END;
    END LOOP;

    /* Apaga Registros em R530REV_AUX */
    BEGIN
      DELETE FROM R530REV_AUX;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao excluir registros da tabela R530REV_AUX.';
    END;
  END IF;
END␀ğé␀␀		SENIOR;0‚␀␀

TRIGGER R530REV_EU AFTER UPDATE ON R530REV FOR EACH ROW

DECLARE
l_New_DatIni   R530REV.DATINI%TYPE;
  l_Old_DatIni   R530REV.DATINI%TYPE;
BEGIN
  BEGIN
    l_New_DatIni := IFNULL(:NEW.DATINI, DATETIME(31, 12, 1900, 0, 0, 0));
    l_Old_DatIni := IFNULL(:OLD.DATINI, DATETIME(31, 12, 1900, 0, 0, 0));
    /* Somente processa se alterou a data inicial */
    IF (l_New_DatIni <> l_Old_DatIni) THEN
      /* Insere Registro New */
      INSERT INTO R530REV_AUX (GRUREQ, FLGCON) VALUES (:NEW.GRUREQ, 0);
    END IF;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao inserir registro na tabela R530REV_AUX.';
  END;
END␀ñé␀␀	SENIOR;0␀␀

TRIGGER R530REV_SD AFTER DELETE ON R530REV

DECLARE
/* CURSOR c/ os registros gravados na tabela R530REV_AUX */
  CURSOR c_R530REV_AuxD IS SELECT DISTINCT R530REV_AUX.GRUREQ FROM R530REV_AUX;

  TYPE t_R530REV_AuxD IS RECORD(
    GRUREQ   R530REV_AUX.GRUREQ%TYPE);

  l_R530REV_AuxD t_R530REV_AuxD;
BEGIN
  /* Seta flag de controle para 1, evitando que a trigger seja
     processada em mais de uma instancia, controle necessário para evitar a Recursividade */
  BEGIN
    UPDATE R530REV_AUX SET FLGCON = 1;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro flag de controle da tabela R530REV_AUX.';
  END;

  /* Calcula data final para todos os registros do Grupo de requisitos informado */
  FOREACH c_R530REV_AuxD INTO l_R530REV_AuxD.GRUREQ
  LOOP
    BEGIN
      UPDATE R530REV
         SET DATTER = (SELECT IFNULL((DATETIMEADD(DD, -1, MIN(REV.DATINI))), DATETIME(31, 12, 1900, 0, 0, 0)) FROM R530REV REV
                        WHERE REV.GRUREQ = R530REV.GRUREQ
                          AND REV.DATINI > R530REV.DATINI)
       WHERE GRUREQ = l_R530REV_AuxD.GRUREQ;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar data de término da revisão.';
    END;
  END LOOP;

  /* Apaga Registros em R530REV_AUX */
  BEGIN
    DELETE FROM R530REV_AUX;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao excluir registros da tabela R530REV_AUX.';
  END;
END␀îé␀␀		SENIOR;0"␀␀

TRIGGER R530REV_ED AFTER DELETE ON R530REV FOR EACH ROW

BEGIN
BEGIN
    /* Insere Registro Old */
    INSERT INTO R530REV_AUX (GRUREQ, FLGCON) VALUES (:OLD.GRUREQ, 0);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao inserir registro na tabela R530REV_AUX.';
  END;
