DECLARE
  l_layout VARCHAR2(6);
  l_layoutAlteracaoCadastral VARCHAR2(6);
BEGIN
	/* Se a alteração do número de dependentes aconteceu durante a geração de um leiaute de colaborador, não deve gerar uma nova pendência*/
	IF (:NEW.GERLEI <> 'S') THEN		
	    RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
	    IF (l_layout IS NOT NULL) THEN
	      RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
		  SP_HIST_ESOCIAL(l_layoutAlteracaoCadastral, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R036INF', 'DATALT', 'I', '', '', 0, 'R036INF_EI');
	    END IF;
	END IF;
END␀&Ô␀␀		SENIOR;0␀␀

TRIGGER R036INF_EU BEFORE UPDATE ON R036INF FOR EACH ROW
DECLARE
	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_JsonCamposAlterados VARCHAR2(2000);
	l_layout VARCHAR2(6);
    l_layoutAlteracaoCadastral VARCHAR2(6);
BEGIN
	/* Se a alteração do número de dependentes aconteceu durante a geração de um leiaute de colaborador, não deve gerar uma nova pendência*/
	IF (:NEW.GERLEI <> 'S') THEN
		l_Alterou := FALSE;
		l_JsonCamposAlterados := '';

		SP_VALUPDATE_NUM(:OLD.DEPIRF, :NEW.DEPIRF, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('DEPIRF', :NEW.DepIrf, :OLD.DepIrf, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_NUM(:OLD.DEPSAF, :NEW.DEPSAF, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('DEPSAF', :NEW.DepSaf, :OLD.DepSaf, l_JsonCamposAlterados OUT);
		END IF;

		IF (l_Alterou = TRUE) THEN
		    RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
		    IF (l_layout IS NOT NULL) THEN
	          RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
			  SP_HIST_ESOCIAL(l_layoutAlteracaoCadastral, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R036INF', 'DATALT', 'A', '', l_JsonCamposAlterados, 0, 'R036INF_EU');
		    END IF;
		END IF;
	END IF;
END␀$Ô␀␀		SENIOR;0Ÿ␀␀

