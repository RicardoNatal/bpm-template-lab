 ␀␀create or replace PROCEDURE SP_R034CPL_HIST(p_tipalt IN VARCHAR2,p_numemp IN NUMBER,p_tipcol IN NUMBER,p_numcad IN NUMBER,p_ficreg IN NUMBER,p_codpai IN NUMBER,p_codest IN VARCHAR2,p_codcid IN NUMBER,p_codbai IN NUMBER,p_codrad IN NUMBER,p_nomrad IN VARCHAR2,p_endcep IN NUMBER,p_tiplgr IN VARCHAR2,p_endrua IN VARCHAR2,p_endnum IN VARCHAR2,p_endcpl IN VARCHAR2,p_numtel IN VARCHAR2,p_painas IN NUMBER,p_estnas IN VARCHAR2,p_ccinas IN NUMBER,p_docidn IN NUMBER,p_numcid IN VARCHAR2,p_emicid IN VARCHAR2,p_cidemi IN NUMBER,p_estcid IN VARCHAR2,p_dexcid IN DATE,p_zonele IN VARCHAR2,p_secele IN VARCHAR2,p_numele IN VARCHAR2,p_numcnh IN VARCHAR2,p_catcnh IN VARCHAR2,p_datcnh IN DATE,p_vencnh IN DATE,p_numres IN VARCHAR2,p_catres IN VARCHAR2,p_codprf IN NUMBER,p_regcon IN VARCHAR2,p_durcon IN NUMBER,p_procon IN NUMBER,p_proexm IN DATE,p_ultexm IN DATE,p_codqua IN NUMBER,p_estpad IN NUMBER,p_clasal IN VARCHAR2,p_nivsal IN VARCHAR2,p_matipe IN NUMBER,p_altipe IN DATE,p_sitipe IN NUMBER,p_tippsa IN VARCHAR2,p_codpsa IN VARCHAR2,p_matpsa IN NUMBER,p_incpsa IN DATE,p_excpsa IN DATE,p_codrlr IN NUMBER,p_codcas IN NUMBER,p_numram IN VARCHAR2,p_pretrb IN VARCHAR2,p_andtrb IN VARCHAR2,p_nroarm IN VARCHAR2,p_iniarm IN DATE,p_fimarm IN DATE,p_emapar IN VARCHAR2,p_emacom IN VARCHAR2,p_catvei IN NUMBER,p_sitreg IN VARCHAR2,p_nomcom IN VARCHAR2,p_nomsoc IN VARCHAR2,p_datven IN DATE,p_dddtel IN NUMBER,p_dditel IN NUMBER,p_nmddi2 IN NUMBER,p_nmddd2 IN NUMBER,p_nmtel2 IN VARCHAR2,p_nmram2 IN VARCHAR2,p_nifext IN VARCHAR2,p_maspsa IN VARCHAR2,p_nasviv IN VARCHAR2,p_carsus IN VARCHAR2,p_tipcer IN VARCHAR2,p_demciv IN DATE,p_matccv IN VARCHAR2,p_matciv IN VARCHAR2,p_livciv IN VARCHAR2,p_folciv IN VARCHAR2,p_carciv IN VARCHAR2,p_estciv IN VARCHAR2,p_cidciv IN NUMBER,p_numpsp IN VARCHAR2,p_emipsp IN VARCHAR2,p_estpsp IN VARCHAR2,p_dempsp IN DATE,p_dvapsp IN DATE,p_paipsp IN NUMBER,p_numpor IN VARCHAR2,p_datpor IN DATE,p_numric IN NUMBER,p_estric IN VARCHAR2,p_emiric IN VARCHAR2, p_seqhis IN OUT NUMBER) is
begin
  p_seqhis := R038HFC_SEQ.NEXTVAL;
  begin
	INSERT INTO R038HFC (numemp,tipcol,numcad,dathis,seqhis,tipalt,ficreg,codpai,codest,codcid,codbai,codrad,nomrad,endcep,tiplgr,endrua,endnum,endcpl,numtel,painas,estnas,ccinas,docidn,numcid,emicid,cidemi,estcid,dexcid,zonele,secele,numele,numcnh,catcnh,datcnh,vencnh,numres,catres,codprf,regcon,durcon,procon,proexm,ultexm,codqua,estpad,clasal,nivsal,matipe,altipe,sitipe,tippsa,codpsa,matpsa,incpsa,excpsa,codrlr,codcas,numram,pretrb,andtrb,nroarm,iniarm,fimarm,emapar,emacom,catvei,sitreg,nomcom,nomsoc,datven,dddtel,dditel,nmddi2,nmddd2,nmtel2,nmram2,nifext,maspsa,nasviv,carsus,tipcer,demciv,matccv,matciv,livciv,folciv,carciv,estciv,cidciv,numpsp,emipsp,estpsp,dempsp,dvapsp,paipsp,numpor,datpor,numric,estric,emiric) 
			VALUES  (p_numemp,p_tipcol,p_numcad,SYSDATE,p_seqhis,p_tipalt,p_ficreg,p_codpai,p_codest,p_codcid,p_codbai,p_codrad,p_nomrad,p_endcep,p_tiplgr,p_endrua,p_endnum,p_endcpl,p_numtel,p_painas,p_estnas,p_ccinas,p_docidn,p_numcid,p_emicid,p_cidemi,p_estcid,p_dexcid,p_zonele,p_secele,p_numele,p_numcnh,p_catcnh,p_datcnh,p_vencnh,p_numres,p_catres,p_codprf,p_regcon,p_durcon,p_procon,p_proexm,p_ultexm,p_codqua,p_estpad,p_clasal,p_nivsal,p_matipe,p_altipe,p_sitipe,p_tippsa,p_codpsa,p_matpsa,p_incpsa,p_excpsa,p_codrlr,p_codcas,p_numram,p_pretrb,p_andtrb,p_nroarm,p_iniarm,p_fimarm,p_emapar,p_emacom,p_catvei,p_sitreg,p_nomcom,p_nomsoc,p_datven,p_dddtel,p_dditel,p_nmddi2,p_nmddd2,p_nmtel2,p_nmram2,p_nifext,p_maspsa,p_nasviv,p_carsus,p_tipcer,p_demciv,p_matccv,p_matciv,p_livciv,p_folciv,p_carciv,p_estciv,p_cidciv,p_numpsp,p_emipsp,p_estpsp,p_dempsp,p_dvapsp,p_paipsp,p_numpor,p_datpor,p_numric,p_estric,p_emiric);
  exception
	when OTHERS then
	  raise_application_error(-20000 + -(103),'Erro ao registrar histórico de alteração da ficha complementar.');
  end;
end SP_R034CPL_HIST;	MSSQL;0
w␀␀CREATE  PROCEDURE sp_r034cpl_hist(@p_tipalt VARCHAR(1), @p_numemp SMALLINT, @p_tipcol SMALLINT, @p_numcad INTEGER, @p_ficreg INTEGER, @p_codpai SMALLINT, @p_codest VARCHAR(4), @p_codcid INTEGER, @p_codbai SMALLINT, @p_codrad SMALLINT, @p_nomrad VARCHAR(40), @p_endcep INTEGER, @p_tiplgr VARCHAR(5), @p_endrua VARCHAR(100), @p_endnum VARCHAR(6), @p_endcpl VARCHAR(25), @p_numtel VARCHAR(20), @p_painas SMALLINT, @p_estnas VARCHAR(4), @p_ccinas INTEGER, @p_docidn SMALLINT, @p_numcid VARCHAR(16), @p_emicid VARCHAR(20), @p_cidemi INTEGER, @p_estcid VARCHAR(2), @p_dexcid DATETIME, @p_zonele VARCHAR(3), @p_secele VARCHAR(4), @p_numele VARCHAR(13), @p_numcnh VARCHAR(20), @p_catcnh VARCHAR(4), @p_datcnh DATETIME, @p_vencnh DATETIME, @p_numres VARCHAR(13), @p_catres VARCHAR(5), @p_codprf SMALLINT, @p_regcon VARCHAR(20), @p_durcon SMALLINT, @p_procon SMALLINT, @p_proexm DATETIME, @p_ultexm DATETIME, @p_codqua SMALLINT, @p_estpad SMALLINT, @p_clasal VARCHAR(5), @p_nivsal VARCHAR(5), @p_matipe INTEGER, @p_altipe DATETIME, @p_sitipe SMALLINT, @p_tippsa VARCHAR(15), @p_codpsa VARCHAR(20), @p_matpsa BIGINT, @p_incpsa DATETIME, @p_excpsa DATETIME, @p_codrlr SMALLINT, @p_codcas SMALLINT, @p_numram VARCHAR(15), @p_pretrb VARCHAR(50), @p_andtrb VARCHAR(5), @p_nroarm VARCHAR(5), @p_iniarm DATETIME, @p_fimarm DATETIME, @p_emapar VARCHAR(100), @p_emacom VARCHAR(100), @p_catvei SMALLINT, @p_sitreg VARCHAR(1), @p_nomcom VARCHAR(80), @p_nomsoc VARCHAR(70), @p_datven DATETIME, @p_dddtel SMALLINT, @p_dditel SMALLINT, @p_nmddi2 SMALLINT, @p_nmddd2 SMALLINT, @p_nmtel2 VARCHAR(20), @p_nmram2 VARCHAR(15), @p_nifext VARCHAR(30), @p_maspsa VARCHAR(20), @p_nasviv VARCHAR(20), @p_carsus VARCHAR(16), @p_tipcer VARCHAR(1), @p_demciv DATETIME, @p_matccv VARCHAR(32), @p_matciv VARCHAR(15), @p_livciv VARCHAR(6), @p_folciv VARCHAR(6), @p_carciv VARCHAR(20), @p_estciv VARCHAR(2), @p_cidciv INTEGER, @p_numpsp VARCHAR(20), @p_emipsp VARCHAR(6), @p_estpsp VARCHAR(4), @p_dempsp DATETIME, @p_dvapsp DATETIME, @p_paipsp SMALLINT, @p_numpor VARCHAR(16), @p_datpor DATETIME, @p_numric BIGINT, @p_estric VARCHAR(2), @p_emiric VARCHAR(6), @p_seqhis bigint output) AS
BEGIN
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  /* TRY */
	INSERT INTO r038hfc
   (numemp,tipcol,numcad,dathis,tipalt,ficreg,codpai,codest,codcid,codbai,codrad,nomrad,endcep,tiplgr,endrua,endnum,endcpl,numtel,painas,estnas,ccinas,docidn,numcid,emicid,cidemi,estcid,dexcid,zonele,secele,numele,numcnh,catcnh,datcnh,vencnh,numres,catres,codprf,regcon,durcon,procon,proexm,ultexm,codqua,estpad,clasal,nivsal,matipe,altipe,sitipe,tippsa,codpsa,matpsa,incpsa,excpsa,codrlr,codcas,numram,pretrb,andtrb,nroarm,iniarm,fimarm,emapar,emacom,catvei,sitreg,nomcom,nomsoc,datven,dddtel,dditel,nmddi2,nmddd2,nmtel2,nmram2,nifext,maspsa,nasviv,carsus,tipcer,demciv,matccv,matciv,livciv,folciv,carciv,estciv,cidciv,numpsp,emipsp,estpsp,dempsp,dvapsp,paipsp,numpor,datpor,numric,estric,emiric) 
  VALUES 
  (@p_numemp,@p_tipcol,@p_numcad,GETDATE(),@p_tipalt,@p_ficreg,@p_codpai,@p_codest,@p_codcid,@p_codbai,@p_codrad,@p_nomrad,@p_endcep,@p_tiplgr,@p_endrua,@p_endnum,@p_endcpl,@p_numtel,@p_painas,@p_estnas,@p_ccinas,@p_docidn,@p_numcid,@p_emicid,@p_cidemi,@p_estcid,@p_dexcid,@p_zonele,@p_secele,@p_numele,@p_numcnh,@p_catcnh,@p_datcnh,@p_vencnh,@p_numres,@p_catres,@p_codprf,@p_regcon,@p_durcon,@p_procon,@p_proexm,@p_ultexm,@p_codqua,@p_estpad,@p_clasal,@p_nivsal,@p_matipe,@p_altipe,@p_sitipe,@p_tippsa,@p_codpsa,@p_matpsa,@p_incpsa,@p_excpsa,@p_codrlr,@p_codcas,@p_numram,@p_pretrb,@p_andtrb,@p_nroarm,@p_iniarm,@p_fimarm,@p_emapar,@p_emacom,@p_catvei,@p_sitreg,@p_nomcom,@p_nomsoc,@p_datven,@p_dddtel,@p_dditel,@p_nmddi2,@p_nmddd2,@p_nmtel2,@p_nmram2,@p_nifext,@p_maspsa,@p_nasviv,@p_carsus,@p_tipcer,@p_demciv,@p_matccv,@p_matciv,@p_livciv,@p_folciv,@p_carciv,@p_estciv,@p_cidciv,@p_numpsp,@p_emipsp,@p_estpsp,@p_dempsp,@p_dvapsp,@p_paipsp,@p_numpor,@p_datpor,@p_numric,@p_estric,@p_emiric)
    SELECT @p_seqhis = cast(SCOPE_IDENTITY() as bigint)
	SELECT @ChkError = @@Error
	IF @ChkError <> 0
	BEGIN
	  GOTO EXC1
	END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
	EXC1:
	SELECT @SE_EXC1 = @ChkError
	IF @ChkError <> 0
	BEGIN
	  BEGIN
		SELECT @ChkError = 0
		BEGIN
		  RAISERROR('Erro ao registrar histórico de alteração da ficha complementar.',11,1) WITH SETERROR
		  SELECT @ChkError = -30
		  GOTO FIM
		END
	  END
	END
  /* END EXCEPTION HANDLER */
FIM:
  RETURN @ChkError
END
