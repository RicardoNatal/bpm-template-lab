PROCEDURE R070MSV_ATUCON(P_TIPOPE CHAR,P_TIPDOC NUMBER,P_NUMDOC VARCHAR2(20),P_DATFIM DATE,P_HORFIM INTEGER,P_QTDMSG NUMBER,P_MSGACC VARCHAR2(32))
 IS

l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_lnkcon       VARCHAR2(31);
  l_datmsg       CHAR(6);
  l_qtdmsg       CHAR(2);
  l_dataux       CHAR(6);
  l_horstr       CHAR(4);
  l_comando_nulo BOOLEAN;
  l_sequencia    NUMBER;
  l_crastr       CHAR(12);
  l_msgacc       VARCHAR2(32);
  l_qtde         NUMBER(2);
  l_datstr       CHAR(16);  
  l_craaux       NUMBER(12);  
  l_Straux       VARCHAR2(2047);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tipdoc       CHAR(1);
  l_tippes       CHAR(2);
  
BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  /* retira caracteres especiais da mensagem */
  SP_STRTOSTR(p_msgacc, l_msgacc OUT);

  BEGIN
    SELECT NUMCRA INTO l_cracha
      FROM R090HCH
     WHERE R090HCH.TIPDOC = p_tipdoc AND
           R090HCH.NUMDOC = p_numdoc AND
           (R090HCH.DATINI < l_data_atual OR
            (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
           (R090HCH.DATFIM = l_data_zero OR
            R090HCH.DATFIM > l_data_atual OR
            (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
  EXCEPTION
    WHEN TOO_MANY_ROWS THEN
      RAISERROR 103 'Erro no SELECT R090HCH - TOO MANY ROWS';
    WHEN NO_DATA_FOUND THEN
      l_cracha := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'ON-Line: Erro no SELECT R090HCH.';
  END;

  /* Verifica se Colaborador possui Cracha */
  IF   (l_cracha <> 0) THEN
       /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
       SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
       IF (l_crapri = 0) THEN
           l_crapri := l_cracha;
       END IF;
       l_comando_nulo := FALSE;
       BEGIN
          SELECT NUMFIS INTO l_craaux FROM R070CON WHERE NUMFIS = l_crapri;
       EXCEPTION
          WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUFIS: Erro em R070CON - TOO MANY ROWS.=';
          WHEN NO_DATA_FOUND THEN l_comando_nulo:= TRUE;
          WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro No SELECT R070CON';
       END;

       IF  (l_comando_nulo = FALSE) THEN

           IF   p_tipope = 'D' THEN
                l_datmsg := '      ';
                l_datstr := '0000000000000000';
                l_msgacc := '                                ';
                l_qtdmsg := '00';
                l_qtde   := 0;
           ELSE
                /* se for updade verificar se esta fechando o historico */
                IF  (p_tipope = 'U') AND
                    (p_datfim <> l_data_zero) AND
                    ((p_datfim < l_data_atual) OR
                    ((p_datfim = l_data_atual) AND (p_horfim < l_hora_atual))) THEN
                     l_datmsg := '      ';
                     l_datstr := '0000000000000000';
                     l_qtdmsg := '00';
                     l_qtde   := 0;
                ELSE
                     l_qtde := p_qtdmsg;
                     IF   (NOT(p_msgacc IS NULL)) THEN
                         IF (p_datfim = l_data_zero) THEN
                             l_dataux := '311250';
                             l_horstr := '2359';
                         ELSE
                             SP_DATSTR(p_datfim,'DDMMYY',l_dataux OUT);
                             SP_INTSTR(p_horfim,'HHMM',l_horstr OUT);
                         END IF;
                             l_datstr := l_dataux||l_horstr||'000000';
                     ELSE
                         l_datstr := '0000000000000000';
                         l_qtde   := 0;
                     END IF;
                END IF;
           END IF;

           /* atualiza r070con */
           BEGIN
                UPDATE R070CON SET MSGACC = l_msgacc, DATMSG = l_datstr, QTDMSG = l_qtde, MSGATU = l_qtde WHERE NUMFIS = l_crapri;
           EXCEPTION
                WHEN OTHERS THEN NULL;
           END;
           /*Montagem do Identificador*/
           l_tippes:= '04';
           SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
           /*Monta o Identificador da Pessoa*/
           l_idtpes := l_tippes||l_tipdoc||p_numdoc;
           /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
          l_idtpes := lTrim(l_idtpes);
          l_idtpes := rTrim(l_idtpes);
          LOOP
              /*Controle do Loop.*/
              IF (Length(l_idtpes) > 22) THEN
                  EXIT;
              END IF;
              l_idtpes := ' '||l_idtpes;
          END LOOP;
          /*Atualiza Controle*/
          SP_ATUTSI(l_idtpes, l_crapri, FALSE, TRUE, FALSE, FALSE);

       END IF;
  END IF;
END		SENIOR;239SP_STRTOSTR
