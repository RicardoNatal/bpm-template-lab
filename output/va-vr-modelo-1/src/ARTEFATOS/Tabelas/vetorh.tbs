DECLARE
	l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
	/* Somente permite alterar caso status do envio seja P - Pendente Envio e R - Erro Envio */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados/excluídos.';
	END IF;
END␀␀␀,*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀nå␀␀…¬␀␀´␀	Ôÿ?ü␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀‚¬␀␀	Ôÿ?ü␀␀␀␀Ä±␀␀<¯␀␀\±␀␀%␀␀ÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀X␀§Ôÿ?ü␀␀␀␀ó␀²␀²␀p␀␀Æÿ␀␀ÿ␀ıDÑ␀	Ôÿ?ü␀␀␀␀ŞM>GšIqC␀êÿ␀␀ÿ␀ÌEÑ␀Ôÿ?ü␀␀␀␀ÎLöHóIqC␀␀êÿ␀␀ÿ␀5Â␀␀EÔÿ␀␀␀␀␀,Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀)+Ñ␀Ôÿ␀␀␀␀␀M&M&M&qC␀␀êÿ␀␀ÿ␀++Ñ␀Ôÿ␀␀␀␀␀U&U&U&qC␀␀êÿ␀␀ÿ␀,+Ç␀Ôÿ␀␀␀␀␀W&W&W&z␀Æÿ␀␀ÿ␀-+Ç␀Ôÿ␀␀␀␀␀Y&Y&Y&z␀Æÿ␀␀ÿ␀.+Ç␀Ôÿ␀␀␀␀␀[&[&[&z␀Æÿ␀␀ÿ␀/+Ç␀Ôÿ␀␀␀␀␀\&\&\&z␀Æÿ␀␀ÿ␀0+'Ôÿ␀␀␀␀␀]&]&]&D␀␀ÿ␀␀ÿ␀1+'Ôÿ␀␀␀␀␀^&^&^&D␀␀ÿ␀␀ÿ␀2+*Ôÿ␀␀␀␀␀_&_&_&,␀␀ÿ␀␀ÿ␀␀␀oå␀␀␀␀0;1;2vå␀␀	SENIOR;0R␀␀

TRIGGER R304CON_SI AFTER INSERT ON R304CON
DECLARE
	CURSOR c_R304CON IS
	SELECT NUMEMP, NUMEDI, SEQREG, DATHOM
	  FROM R304CON
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304CON IS RECORD (
		NUMEMP   R304CON.NumEmp%TYPE,
		NUMEDI   R304CON.NumEdi%TYPE,
		SEQREG   R304CON.SeqReg%TYPE,
		DATHOM   R304CON.DatHom%TYPE
	);
    
    l_R304CON t_R304CON;    
	l_PidSta VARCHAR2(30);
	l_DesRes VARCHAR2(250);
BEGIN
	FOREACH c_R304CON INTO l_R304CON.NumEmp, l_R304CON.NumEdi, l_R304CON.SeqReg, l_R304CON.DatHom
	LOOP
		/* Gera um novo PID */
		SP_GERPIDSTA(l_R304CON.NumEmp, 3, l_PidSta OUT);
		
		/* Inclui registro de status na tabela R304STA */
		l_DesRes := 'Número do Edital: ' || l_R304CON.NumEdi;
		SP_GERSTA_ESFINGE(3, l_PidSta, l_R304CON.DatHom, l_DesRes, l_R304CON.NumEmp, 0, 0);
		
		BEGIN
			UPDATE R304CON 
			   SET PIDSTA = l_PidSta 
			 WHERE NUMEMP = l_R304CON.NumEmp 
			   AND NUMEDI = l_R304CON.NumEdi
			   AND SEQREG = l_R304CON.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304CON.';
		END;
	END LOOP;
END␀så␀␀		SENIOR;0␀␀TRIGGER R304CON_EI BEFORE INSERT ON R304CON FOR EACH ROW
DECLARE
	l_SeqReg   R304COE.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_StaEnv   R304STA.StaEnv%TYPE;
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Busca a última sequência cadastrada para a mesma Empresa/Edital */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304CON
		 WHERE NUMEMP = :NEW.NumEmp
		   AND NUMEDI = :NEW.NumEdi
		   AND SEQREG <> :NEW.SeqReg;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304CON.';
	END;
	
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
		
		/* Busca o status da última sequência */
		BEGIN
			SELECT STA.STAENV INTO l_StaEnv
			  FROM R304CON CON, R304STA STA
			 WHERE CON.NUMEMP = :NEW.NumEmp
			   AND CON.NUMEDI = :NEW.NumEdi
			   AND CON.SEQREG = l_SeqReg
			   AND CON.PIDSTA = STA.PIDSTA;
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				RAISERROR 103 'Não encontrou status do último registro.';
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar status do registro com última sequência na tabela R304CON.';
		END;
		
		/* Verifica se a última sequência está com status Cancelado */
		IF (l_StaEnv <> 'N') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que o registro de sequência ' || l_SeqRegStr || ' esteja com status Cancelado.';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀qå␀␀		SENIOR;04␀␀

TRIGGER R304CON_AU AFTER UPDATE ON R304CON FOR EACH ROW
BEGIN
	IF (:OLD.DatHom <> :NEW.DatHom) THEN
		BEGIN
			UPDATE R304STA SET DATREF = :NEW.DatHom WHERE PIDSTA = :NEW.PidSta;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar data de referência na tabela R304STA';
		END;
	END IF;
END␀tå␀␀		SENIOR;0±␀␀

TRIGGER R304CON_EU BEFORE UPDATE ON R304CON FOR EACH ROW
DECLARE
	l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
	/* Não deixa alterar registro caso status seja diferente de P - Pendente Envio e R - Erro Envio */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados/excluídos.';
	END IF;
END␀uå␀␀	SENIOR;0.␀␀

TRIGGER R304CON_SD AFTER DELETE ON R304CON
BEGIN
	BEGIN
		DELETE FROM R304STA
		 WHERE LAYOUT = 3
		   AND NOT EXISTS (SELECT 1 FROM R304CON WHERE R304CON.PIDSTA = R304STA.PIDSTA);
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao excluir registros não utilizados na tabela R304STA.';
	END;
END␀på␀␀		SENIOR;0˜

TRIGGER R304CON_AD AFTER DELETE ON R304CON FOR EACH ROW
BEGIN
	/* Exclui registro de status na tabela R304STA */	
	SP_EXCSTA_ESFINGE(:OLD.PidSta);
END␀rå␀␀		SENIOR;0Ó␀␀

TRIGGER R304CON_ED BEFORE DELETE ON R304CON FOR EACH ROW
DECLARE
	l_QtdReg NUMBER;
BEGIN
	/* Verifica se tem registros na tabela filha R304COE */
	l_QtdReg := 0;	
	BEGIN
		SELECT COUNT(1) INTO l_QtdReg FROM R304COE WHERE PIDSTA = :OLD.PidSta;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar quantidade de registros na tabela R304COE.';
	END;	
	IF (l_QtdReg > 0) THEN
		RAISERROR 103 'Não é possível efetuar a exclusão do Concurso/Processo Seletivo, pois existem especialidade(s) cadastrados para o mesmo.';
	END IF;
	
	/* Verifica se tem registros na tabela filha R304COD */
	l_QtdReg := 0;		
	BEGIN
		SELECT COUNT(1) INTO l_QtdReg FROM R304COD WHERE PIDSTA = :OLD.PidSta;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar quantidade de registros na tabela R304COD.';
	END;	
	IF (l_QtdReg > 0) THEN
		RAISERROR 103 'Não é possível efetuar a exclusão do Concurso/Processo Seletivo, pois existe(m) documento(s) cadastrados para o mesmo.';
	END IF;
END␀␀␀'*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀wå␀␀…¬␀␀´␀	Ôÿ?ü␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀‚¬␀␀	Ôÿ?ü␀␀␀␀Ä±␀␀<¯␀␀\±␀␀%␀␀ÿ␀␀ÿ␀ˆ¬␀␀¼␀	Ôÿ?ü␀␀␀␀°␀␀=¯␀␀°␀␀v␀Æÿ␀␀ÿ␀␀¤	Ôÿ␀␀␀␀␀U␀U␀U␀p␀Æÿ␀␀ÿ␀U'	Ôÿ?␀␀␀␀␀ûAİ'	@%␀␀ÿ␀␀ÿ␀EÑ␀	Ôÿ␀␀␀␀␀+Kì”␀␀+KqC␀êÿ␀␀ÿ␀s¬␀␀␀	Ôÿ␀␀␀␀␀±␀␀‰#‰#Q␀␀Æÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀š¬␀␀	Ôÿ␀␀␀␀␀°␀␀B¯␀␀°␀␀%␀␀ÿ␀␀ÿ␀)§␀␀	Ôÿ?␀␀␀␀␀A©␀␀␀¨␀␀A©␀␀␀␀ÿ␀␀ÿ␀¤µ␀␀Á␀	Ôÿ␀␀␀␀␀Âµ␀␀ºµ␀␀²µ␀␀y␀Æÿ␀␀ÿ␀␀#	Ôÿ␀␀␀␀␀f␀+␀,␀p␀␀Æÿ␀␀ÿ␀¬µ␀␀Á␀Ôÿ␀␀␀␀␀Ëµ␀␀¾µ␀␀³µ␀␀y␀␀Æÿ␀␀ÿ␀«␀␀Ä␀	Ôÿ␀␀␀␀␀(«␀␀«␀␀(«␀␀S)␀␀␀Æÿ␀␀ÿ␀f´␀Ôÿ?␀␀␀␀␀÷<ïe»fr␀␀Æÿ␀␀)Ñ␀␀␀0,4Ôÿ?␀␀␀␀␀ÿ?µ'µ'}␀␀␀ÿ␀␀Ñ␀␀␀5Â␀␀EÔÿ␀␀␀␀␀,Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀)+Ñ␀Ôÿ␀␀␀␀␀M&M&M&qC␀␀êÿ␀␀ÿ␀++Ñ␀Ôÿ␀␀␀␀␀U&U&U&qC␀␀êÿ␀␀ÿ␀,+Ç␀Ôÿ␀␀␀␀␀W&W&W&z␀Æÿ␀␀ÿ␀-+Ç␀Ôÿ␀␀␀␀␀Y&Y&Y&z␀Æÿ␀␀ÿ␀.+Ç␀Ôÿ␀␀␀␀␀[&[&[&z␀Æÿ␀␀ÿ␀/+Ç␀Ôÿ␀␀␀␀␀\&\&\&z␀Æÿ␀␀ÿ␀0+'Ôÿ␀␀␀␀␀]&]&]&D␀␀ÿ␀␀ÿ␀1+'Ôÿ␀␀␀␀␀^&^&^&D␀␀ÿ␀␀ÿ␀2+*Ôÿ␀␀␀␀␀_&_&_&,␀␀ÿ␀␀ÿ␀␀␀xå␀␀␀␀0;1;2;3;4;5;6;8;7{å␀␀	SENIOR;0•␀␀

TRIGGER R304COR_SI AFTER INSERT ON R304COR
DECLARE
	CURSOR c_R304COR IS
	SELECT NUMEMP, NUMEDI, NUMESP, TIPQUA, CARFUN, DATINI, NUMCPF, SEQREG
	  FROM R304COR
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304COR IS RECORD (
		NUMEMP   R304COR.NumEmp%TYPE,
		NUMEDI   R304COR.NumEdi%TYPE,
		NUMESP   R304COR.NumEsp%TYPE,
		TIPQUA   R304COR.TipQua%TYPE,
		CARFUN   R304COR.CarFun%TYPE,
		DATINI   R304COR.DatIni%TYPE,
		NUMCPF   R304COR.NumCpf%TYPE,
		SEQREG   R304COR.SeqReg%TYPE
	);
    
    l_R304COR t_R304COR;
    l_PidSta VARCHAR2(30);
    l_MsgErr VARCHAR2(255);
BEGIN
	FOREACH c_R304COR INTO l_R304COR.NumEmp, l_R304COR.NumEdi, l_R304COR.NumEsp, l_R304COR.TipQua, l_R304COR.CarFun, l_R304COR.DatIni, l_R304COR.NumCpf, l_R304COR.SeqReg
	LOOP
		/* Busca PID gravado no registro do Concurso/Processo Seletivo */
		BEGIN
			SELECT CON.PIDSTA INTO l_PidSta
			  FROM R304CON CON, R304STA STA
			 WHERE CON.PIDSTA = STA.PIDSTA
			   AND CON.NUMEMP = l_R304COR.NumEmp
			   AND CON.NUMEDI = l_R304COR.NumEdi
			   AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_MsgErr := 'Não existe registro de Concurso/Processo Seletivo pendente com a seguinte chave: ' || 
					'Empresa: ' || CONVERT(NUMBER_TO_CHAR, l_R304COR.NumEmp) || ', Edital: ' || l_R304COR.NumEdi || '.';
				RAISERROR 103 l_MsgErr; 
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304CON.';
		END;
		
		BEGIN
			UPDATE R304COR
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304COR.NumEmp
			   AND NUMEDI = l_R304COR.NumEdi
			   AND NUMESP = l_R304COR.NumEsp
			   AND TIPQUA = l_R304COR.TipQua
			   AND CARFUN = l_R304COR.CarFun
			   AND DATINI = l_R304COR.DatIni
			   AND NUMCPF = l_R304COR.NumCpf
			   AND SEQREG = l_R304COR.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304COR.';
		END;
	END LOOP;
END␀yå␀␀		SENIOR;0␀␀TRIGGER R304COR_EI BEFORE INSERT ON R304COR FOR EACH ROW
DECLARE
	l_SeqReg   R304COR.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR(255);
BEGIN
	/* Verifica se está tentando incluir um registro com sequência maior do que a última já cadastrada */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304COR
		 WHERE NUMEMP = :NEW.NumEmp
		   AND NUMEDI = :NEW.NumEdi
		   AND NUMESP = :NEW.NumEsp
		   AND TIPQUA = :NEW.TipQua
		   AND CARFUN = :NEW.CarFun
		   AND DATINI = :NEW.DatIni
		   AND NUMCPF = :NEW.NumCpf
		   AND SEQREG <> :NEW.SeqReg;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304COR.';
	END;
	
	IF (l_SeqReg > 0) THEN
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀zå␀␀		SENIOR;0¥␀␀

TRIGGER R304COR_EU BEFORE UPDATE ON R304COR FOR EACH ROW
DECLARE
	l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
	/* Somente permite alterar caso status do envio seja P - Pendente Envio ou R - Erro */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados/excluídos.';
	END IF;
END␀␀␀;*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀|å␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀[¬␀␀	Ôÿ?␀␀␀␀␀¯±␀␀3¯␀␀±␀␀%␀␀ÿ␀␀ÿ␀}DÑ␀	Ôÿ?␀␀␀␀␀^M!FğLqC␀êÿ␀␀ÿ␀ª¬␀␀	Ôÿ?␀␀␀␀␀R°␀␀H¯␀␀°␀␀%␀␀ÿ␀␀ÿ␀s¬␀␀␀	Ôÿ?␀␀␀␀␀¥?c°␀␀c°␀␀Q␀Æÿ␀␀ÿ␀Ö-¦␀	Ôÿ?␀␀␀␀␀-?:5>j␀Æÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀—È␀␀Ñ␀Ôÿ?␀␀␀␀␀{LoHhKqC␀êÿ␀␀ÿ␀ÿ␀*Ôÿ?␀␀␀␀␀␀Ÿ␀k␀p␀Æÿ␀␀ÿ␀ÓEÑ␀Ôÿ?␀␀␀␀␀åMë”␀␀ÖGqC␀êÿ␀␀ÿ␀HEÑ␀Ôÿ?␀␀␀␀␀İLÛLÛLqC␀êÿ␀␀ÿ␀(␀£␀Ôÿ?␀␀␀␀␀ë$␀."␀2"␀l)␀␀Æÿ␀␀ÿ␀ÙTÔÿ?␀␀␀␀␀@XWÇW␀␀ÿ␀␀ÿ␀4T)Ôÿ?␀␀␀␀␀–YÆXÆX-␀␀ÿ␀␀ÿ␀µtÔÿ?␀␀␀␀␀u¬tát␀␀ÿ␀␀ÿ␀qWÔÿ?␀␀␀␀␀#q q qS␀␀ÿ␀␀ÿ␀”␀␀=Ôÿ?␀␀␀␀␀£␀␀!␀␀E␀␀c␀␀␀ÿ␀␀ÿ␀␀0Ôÿ?␀␀␀␀␀?␀␀Ò␀q␀␀Æÿ␀␀ÿ␀È¬␀␀Ôÿ?␀␀␀␀␀æ±␀␀Y¯␀␀±␀␀␀␀␀ÿ␀␀ÿ␀IT9Ôÿ?␀␀␀␀␀ XWW:␀␀␀ÿ␀␀ÿ␀<␀␀=Ôÿ?␀␀␀␀␀O␀␀ôŒ␀␀0␀␀c␀␀␀ÿ␀␀ÿ␀â␀)Ôÿ?␀␀␀␀␀©␀␀	␀p␀␀Æÿ␀␀ÿ␀Œ␀␀=Ôÿ?␀␀␀␀␀›␀␀íŒ␀␀–␀␀c␀␀␀ÿ␀␀ÿ␀¬␀␀=Ôÿ?␀␀␀␀␀¨␀␀ïŒ␀␀M␀␀c␀␀␀ÿ␀␀ÿ␀X¬␀␀Ôÿ?␀␀␀␀␀ê¯␀␀1¯␀␀b¯␀␀␀␀␀ÿ␀␀ÿ␀“DÑ␀Ôÿ?␀␀␀␀␀J_I`IqC␀êÿ␀␀ÿ␀i¬␀␀cÔÿ?␀␀␀␀␀A°␀␀9¯␀␀ú¯␀␀`␀␀ÿ␀␀ÿ␀f%Ôÿ?␀␀␀␀␀bfQfQfp␀␀Æÿ␀␀ÿ␀5Â␀␀EÔÿ?␀␀␀␀␀-Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀␀␀}å␀␀␀␀0;1;2;3;4;5;6„å␀␀	SENIOR;0ì␀␀

TRIGGER R304CPE_SI AFTER INSERT ON R304CPE
DECLARE
	CURSOR c_R304CPE IS
	SELECT NUMEMP, NUMATO, DATATO, NUMMAT, NUMCPF, CODUNI, SEQREG, PUBATO
	  FROM R304CPE
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304CPE IS RECORD (
		NUMEMP   R304CPE.NumEmp%TYPE,
		NUMATO   R304CPE.NUMATO%TYPE,
		DATATO   R304CPE.DATATO%TYPE,
		NUMMAT   R304CPE.NUMMAT%TYPE,
		NUMCPF   R304CPE.NUMCPF%TYPE,
		CODUNI   R304CPE.CODUNI%TYPE,
		SEQREG   R304CPE.SEQREG%TYPE,
		PUBATO   R304CPE.PUBATO%TYPE		
	);
    
    l_R304CPE t_R304CPE;    
	l_PidSta VARCHAR2(30);
	l_DesRes VARCHAR2(250);
BEGIN
	FOREACH c_R304CPE INTO l_R304CPE.NUMEMP, l_R304CPE.NUMATO, l_R304CPE.DATATO, l_R304CPE.NUMMAT, l_R304CPE.NUMCPF, l_R304CPE.CODUNI, l_R304CPE.SEQREG, l_R304CPE.PUBATO
	LOOP
		/* Gera um novo PID */
		SP_GERPIDSTA(l_R304CPE.NumEmp, 19, l_PidSta OUT);
		
		/* Inclui registro de status na tabela R304STA */
		l_DesRes := 'Número do Ato: ' || l_R304CPE.NUMATO||', Data Ato: ' || CONVERT(DATE_TO_CHAR,l_R304CPE.DATATO)
		            || ', Número Matrícula: ' || l_R304CPE.NUMMAT ||', CPF: ' || CONVERT(NUMBER_TO_CHAR, l_R304CPE.NUMCPF) 
		            ||', Cod Unidade: ' || CONVERT(NUMBER_TO_CHAR, l_R304CPE.CODUNI) || '.';
		            
		SP_GERSTA_ESFINGE(19, l_PidSta, l_R304CPE.PUBATO, l_DesRes, l_R304CPE.NumEmp, 0, 0);
		
		BEGIN
			UPDATE R304CPE 
			   SET PIDSTA = l_PidSta 
			 WHERE NUMEMP = l_R304CPE.NumEmp 
			   AND NUMATO = l_R304CPE.NUMATO
		   	   AND DATATO = l_R304CPE.DATATO
		       AND NUMMAT = l_R304CPE.NUMMAT
		       AND NUMCPF = l_R304CPE.NUMCPF
		       AND CODUNI = l_R304CPE.CODUNI
			   AND SEQREG = l_R304CPE.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304CPE.';
		END;
	END LOOP;
END␀å␀␀		SENIOR;0␀␀TRIGGER R304CPE_EI BEFORE INSERT ON R304CPE FOR EACH ROW
DECLARE
	l_SeqReg   R304CPE.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_StaEnv   R304STA.StaEnv%TYPE;
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Busca a última sequência cadastrada para a mesma Empresa/Edital */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304CPE
		 WHERE NUMEMP = :NEW.NumEmp
		   AND NUMATO = :NEW.NUMATO
		   AND DATATO = :NEW.DATATO
		   AND NUMMAT = :NEW.NUMMAT
		   AND NUMCPF = :NEW.NUMCPF
		   AND CODUNI = :NEW.CODUNI
		   AND SEQREG <> :NEW.SeqReg;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304CPE.';
	END;
	
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
		
		/* Busca o status da última sequência */
		BEGIN
			SELECT STA.STAENV INTO l_StaEnv
			  FROM R304CPE CON, R304STA STA
			 WHERE CON.NUMEMP = :NEW.NumEmp
			   AND CON.NUMATO = :NEW.NUMATO
		   	   AND CON.DATATO = :NEW.DATATO
		       AND CON.NUMMAT = :NEW.NUMMAT
		       AND CON.NUMCPF = :NEW.NUMCPF
		       AND CON.CODUNI = :NEW.CODUNI
			   AND CON.SEQREG = l_SeqReg
			   AND CON.PIDSTA = STA.PIDSTA;
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				RAISERROR 103 'Não encontrou status do último registro.';
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar status do registro com última sequência na tabela R304CPE.';
		END;
		
		/* Verifica se a última sequência está com status Cancelado */
		IF (l_StaEnv <> 'N') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que o registro de sequência ' || l_SeqRegStr || ' esteja com status Cancelado.';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀å␀␀		SENIOR;04␀␀

TRIGGER R304CPE_AU AFTER UPDATE ON R304CPE FOR EACH ROW
BEGIN
	IF (:OLD.PUBATO <> :NEW.PUBATO) THEN
		BEGIN
			UPDATE R304STA SET DATREF = :NEW.PUBATO WHERE PIDSTA = :NEW.PidSta;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar data de referência na tabela R304STA';
		END;
	END IF;
END␀‚å␀␀		SENIOR;0±␀␀

TRIGGER R304CPE_EU BEFORE UPDATE ON R304CPE FOR EACH ROW
DECLARE
	l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
	/* Não deixa alterar registro caso status seja diferente de P - Pendente Envio e R - Erro Envio */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados/excluídos.';
	END IF;
END␀ƒå␀␀	SENIOR;0/␀␀

TRIGGER R304CPE_SD AFTER DELETE ON R304CPE
BEGIN
	BEGIN
		DELETE FROM R304STA
		 WHERE LAYOUT = 19
		   AND NOT EXISTS (SELECT 1 FROM R304CPE WHERE R304CPE.PIDSTA = R304STA.PIDSTA);
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao excluir registros não utilizados na tabela R304STA.';
	END;
END␀~å␀␀		SENIOR;0˜

