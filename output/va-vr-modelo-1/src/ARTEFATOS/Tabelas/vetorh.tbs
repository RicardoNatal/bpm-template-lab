        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TERFPA', CONVERT(NUMBER_TO_CHAR, :OLD.TERFPA));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030GRT_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRO', CONVERT(NUMBER_TO_CHAR, :OLD.CODPRO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSUS', CONVERT(NUMBER_TO_CHAR, :OLD.CODSUS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :OLD.TABEVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ABREVE', :OLD.ABREVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ABR13S', :OLD.ABR13S);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPAU1', CONVERT(NUMBER_TO_CHAR, :OLD.CMPAU1));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPAU2', CONVERT(NUMBER_TO_CHAR, :OLD.CMPAU2));
		SP_DATSTR(:OLD.CMPAU3, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPAU3', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPAU4', :OLD.CMPAU4);
      END;
  END IF; 
END␀␀␀n␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀PÒ␀␀°,±␀	Ôÿ!␀␀␀␀␀„@Çtìtq␀Æÿ␀␀QÒ␀␀␀£T(Ôÿ!␀␀␀␀␀°V°V°V1␀␀ÿ␀␀ÿ␀␀␀␀0␀␀ìt␀␀␀RÒ␀␀…¬␀␀´␀	Ôÿ!␀␀␀␀␀‘<XbXbr‡␀Æÿ␀␀Ò␀␀␀—,¼␀	Ôÿ!␀␀␀␀␀=nnX)␀␀Æÿ␀␀!#␀R␀IÔÿ!␀␀␀␀␀ˆ␀ˆ␀ˆ␀n␀Æÿ␀␀ÿ␀“-´␀Ôÿ!␀␀␀␀␀UA‚␀‚␀r"‡␀Æÿ␀␀+Ğ␀␀␀j¬␀␀¢␀Ôÿ!␀␀␀␀␀±␀␀²"±␀␀;)␀␀Æÿ␀␀ÿ␀Ì)Ôÿ!␀␀␀␀␀±␀␀²"±␀␀£␀␀ÿ␀␀O"␀t,–␀Ôÿ!␀␀␀␀␀å<Ndá<T␀Æÿ␀␀ÿ␀~␀=Ôÿ!␀␀␀␀␀l␀l␀l␀c␀␀␀ÿ␀␀ÿ␀:d(Ôÿ!␀␀␀␀␀æ<1dä<1␀␀ÿ␀␀ÿ␀␀␀␀0;1TÒ␀␀		SENIOR;0r␀␀/* INSERT (NEW) */
TRIGGER R030HOM_EI AFTER INSERT ON R030HOM FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Filiais da Empresa - Configurações do HomologNet*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 48;     /* Filiais da Empresa - Configurações do HomologNet*/
  l_codtpa := 207;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030HOM_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030HOM_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SINPAT', CONVERT(NUMBER_TO_CHAR, :NEW.SINPAT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSIN', CONVERT(NUMBER_TO_CHAR, :NEW.CODSIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCGC', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCGC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODENT', CONVERT(NUMBER_TO_CHAR, :NEW.CODENT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'USAHOM', :NEW.USAHOM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENTALF', :NEW.ENTALF);
      END;
  END IF; 
END␀UÒ␀␀		SENIOR;0g␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R030HOM_EU AFTER UPDATE ON R030HOM FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Filiais da Empresa - Configurações do HomologNet*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 48;     /* Filiais da Empresa - Configurações do HomologNet*/
  l_codtpa := 208;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFil <> :NEW.CodFil)
   OR (:OLD.SinPat <> :NEW.SinPat)
   OR (:OLD.CodSin <> :NEW.CodSin)
   OR (:OLD.NumCgc <> :NEW.NumCgc)
   OR (:OLD.CodEnt <> :NEW.CodEnt)
   OR (:OLD.UsaHom <> :NEW.UsaHom)
   OR (:OLD.EntAlf <> :NEW.EntAlf)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030HOM_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030HOM_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSINPAT', CONVERT(NUMBER_TO_CHAR, :OLD.SINPAT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSINPAT', CONVERT(NUMBER_TO_CHAR, :NEW.SINPAT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODSIN', CONVERT(NUMBER_TO_CHAR, :OLD.CODSIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODSIN', CONVERT(NUMBER_TO_CHAR, :NEW.CODSIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMCGC', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCGC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMCGC', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCGC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODENT', CONVERT(NUMBER_TO_CHAR, :OLD.CODENT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODENT', CONVERT(NUMBER_TO_CHAR, :NEW.CODENT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDUSAHOM', :OLD.USAHOM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWUSAHOM', :NEW.USAHOM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENTALF', :OLD.ENTALF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENTALF', :NEW.ENTALF);
      END;
    END IF; 
  END IF; 
END␀SÒ␀␀		SENIOR;0u␀␀ 

