PROCEDURE R070PEA_ATUCON
 IS

l_cracha       NUMBER(12);
  l_grupo1       CHAR(5);
  l_inigr1       CHAR(10);
  l_fimgr1       CHAR(10);
  l_grupo2       CHAR(5);
  l_inigr2       CHAR(10);
  l_fimgr2       CHAR(10);
  l_grupo3       CHAR(5);
  l_inigr3       CHAR(10);
  l_fimgr3       CHAR(10);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);

  /* CURSOR c/ os registros gravados no R070PEA_AUX */
  CURSOR c_r070PEA_ins IS SELECT NUMMAT,DATINI,HORINI FROM R070PEA_AUX;
  TYPE t_r070PEA_aux IS RECORD(
    NUMMAT   R070PEA_AUX.NUMMAT%TYPE,
    DATINI   R070PEA_AUX.DATINI%TYPE,
    HORINI   R070PEA_AUX.HORINI%TYPE);
  l_r070PEA_aux t_r070PEA_aux;

BEGIN

  /* Le Registro do CURSOR */
  FOREACH c_R070PEA_ins INTO  l_r070PEA_aux.NUMMAT,
                              l_r070PEA_aux.DATINI,
                              l_r070PEA_aux.HORINI
  LOOP
       SP_RetCra (1,0,6,0,0,l_r070PEA_aux.NUMMAT,0,'',l_cracha OUT);
       IF   l_cracha = 0 THEN
            SP_RetCra (2,0,6,0,0,l_r070PEA_aux.NUMMAT,0,'',l_cracha OUT);
       END IF;

       /* Verifica se Colaborador possui Cracha */
       IF   (l_cracha <> 0) THEN

            /* Retornas as tres permissoes ativas, caso houver */
            SP_RETPEA(l_r070PEA_aux.NUMMAT, l_cracha, 
                      l_grupo1 OUT, l_inigr1 OUT, l_fimgr1 OUT, l_grupo2 OUT, l_inigr2 OUT, l_fimgr2 OUT, l_grupo3 OUT, l_inigr3 OUT, l_fimgr3 OUT);

            /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
            SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
            IF (l_crapri = 0) THEN
                l_crapri := l_cracha;
            END IF;
            /*Atualiza somente o crachá principal*/
            BEGIN
              UPDATE R070CON SET PRMRT1 = CONVERT(CHAR_TO_NUMBER, l_grupo1), DINPR1 = l_inigr1, DFNPR1 = l_fimgr1,
                                 PRMRT2 = CONVERT(CHAR_TO_NUMBER, l_grupo2), DINPR2 = l_inigr2, DFNPR2 = l_fimgr2,
                                 PRMRT3 = CONVERT(CHAR_TO_NUMBER, l_grupo3), DINPR3 = l_inigr3, DFNPR3 = l_fimgr3
                                 WHERE NUMFIS = l_crapri;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'R070PEC_ATUCON: Erro Na Atualização da tabela R070CON.';
            END;

            /*Atualiza os crachás secundários da R070CON*/
            SP_UPDPRM(l_cracha,0,0,0,0,l_grupo1,l_grupo2,l_grupo3);

            BEGIN
                SELECT IDTPES INTO l_idtpes FROM R070CON WHERE NUMCRA = l_cracha AND NUMFIS = l_crapri;
            EXCEPTION
              WHEN OTHERS THEN
                NULL;
            END;
       END IF;

       BEGIN
         DELETE FROM R070PEA_AUX
         WHERE NUMMAT = l_r070PEA_aux.NUMMAT AND
               DATINI = l_r070PEA_aux.DATINI AND
               HORINI = l_r070PEA_aux.HORINI;
       EXCEPTION
         WHEN OTHERS THEN
           NULL;
       END;

  END LOOP;
END		SENIOR;20MSP_RETCRA
