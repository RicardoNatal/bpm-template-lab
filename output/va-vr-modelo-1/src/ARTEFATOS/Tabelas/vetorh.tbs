DECLARE
  l_layoutAltContratual VARCHAR2(6);
  l_DataZero     DATE;
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_InfoFacult   BOOLEAN;
  l_SimplificacaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  /*e-Social*/
  l_InfoFacult := TRUE;
  l_SimplificacaoESocial := FALSE;
  l_VersaoESocial := 0;
  
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificacaoESocial OUT, l_VersaoESocial OUT);
  
  /* Só monitora se o cliente opta por enviar as informações facultativas*/
  IF (l_InfoFacult = TRUE AND l_SimplificacaoESocial = FALSE) THEN 
    IF (:NEW.SOCSIN = 'S') THEN
      RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAltContratual OUT);
      IF (l_layoutAltContratual = 'S-2206') THEN
        SP_TAB_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATINI, :NEW.DATFIM, 'R034SIN', 'I', '', '', 0, 'R034SIN_EI');
        l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	    IF (l_DataZero <> :NEW.DATFIM) THEN
          SP_HIST_DT_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATFIM, 'R034SIN', 'DATINI', 'I', '', '', '', 0, 'R034SIN_EI');
        END IF;   	  
      END IF;
    END IF;
  END IF;
  /*e-Social*/
  
  /* Geração de logs Outros Sindicatos do Empregado (Tabela: R034SIN)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 85;     /* Outros Sindicatos do Empregado (Tabela: R034SIN)*/
  l_codtpa := 281;
 
  l_temAud := FALSE;
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 
   

  IF (l_temAud = TRUE) THEN      
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034SIN_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSIN', CONVERT(NUMBER_TO_CHAR, :NEW.CODSIN));
        SP_DATSTR(:NEW.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034SIN_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SOCSIN', :NEW.SOCSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PAGSIN', :NEW.PAGSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TASSIN', :NEW.TASSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CUSSIN', :NEW.CUSSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REVSIN', :NEW.REVSIN);
        SP_DATSTR(:NEW.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATFIM', l_datTemp);
      END;
  END IF;   
END␀ñÓ␀␀		SENIOR;0Ú␀␀

TRIGGER R034SIN_EU AFTER UPDATE ON R034SIN FOR EACH ROW
DECLARE
  l_Valido       BOOLEAN;
  l_Alterou      BOOLEAN;
  l_AlterouSomenteDataFim BOOLEAN;
  l_layoutAltContratual VARCHAR2(6);
  l_JsonCamposAlterados VARCHAR2(2000);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_InfoFacult   BOOLEAN;	
  l_SimplificacaoESocial BOOLEAN;	
  l_VersaoESocial NUMBER;
BEGIN
  /* eSocial */
  l_InfoFacult := TRUE;
  l_SimplificacaoESocial := FALSE;
  l_VersaoESocial := 0;  
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificacaoESocial OUT, l_VersaoESocial OUT);
  
  /* Só monitora se o cliente opta por enviar as informações facultativas*/
  IF (l_InfoFacult = TRUE AND l_SimplificacaoESocial = FALSE) THEN
	IF ((:OLD.SOCSIN = 'S') OR (:NEW.SOCSIN = 'S')) THEN
		l_Alterou := FALSE;
		l_AlterouSomenteDataFim := FALSE;
		l_JsonCamposAlterados := '';

		SP_VALUPDATE_NUM(:OLD.CODSIN, :NEW.CODSIN, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('CODSIN', :NEW.CodSin, :OLD.CodSin, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DES(:OLD.SOCSIN, :NEW.SOCSIN, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('SOCSIN', :NEW.SocSin, :OLD.SocSin, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DAT(:OLD.DATFIM, :NEW.DATFIM, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			IF (l_Alterou = FALSE) THEN
				l_AlterouSomenteDataFim := TRUE;
			END IF;
			l_Alterou := TRUE;
			SP_CONCAT_DAT_JSON('DATFIM', :NEW.DatFim, :OLD.DatFim, l_JsonCamposAlterados OUT);
		END IF;
		
		IF (l_Alterou = TRUE) THEN
			RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAltContratual OUT);
			IF (l_layoutAltContratual = 'S-2206') THEN
				SP_ALT_TAB_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATINI, :NEW.DATFIM, :OLD.DATFIM, 'R034SIN', '', l_JsonCamposAlterados, l_AlterouSomenteDataFim, 'DATINI', '', 0, 'R034SIN_EU');
			END IF;
		END IF;
	END IF;
  END IF;
  /* eSocial */
	
  /* Geração de logs Outros Sindicatos do Empregado (Tabela: R034SIN)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 85;     /* Outros Sindicatos do Empregado (Tabela: R034SIN)*/
  l_codtpa := 282;
 
  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.CodSin <> :NEW.CodSin)
   OR (:OLD.SocSin <> :NEW.SocSin)
   OR (:OLD.PagSin <> :NEW.PagSin)
   OR (:OLD.TasSin <> :NEW.TasSin)
   OR (:OLD.CusSin <> :NEW.CusSin)
   OR (:OLD.RevSin <> :NEW.RevSin)
   OR (:OLD.DatIni <> :NEW.DatIni)
   OR (:OLD.DatFim <> :NEW.DatFim)) THEN
   
   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034SIN_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSIN', CONVERT(NUMBER_TO_CHAR, :OLD.CODSIN));
        SP_DATSTR(:OLD.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034SIN_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSOCSIN', :OLD.SOCSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSOCSIN', :NEW.SOCSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPAGSIN', :OLD.PAGSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPAGSIN', :NEW.PAGSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTASSIN', :OLD.TASSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTASSIN', :NEW.TASSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCUSSIN', :OLD.CUSSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCUSSIN', :NEW.CUSSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDREVSIN', :OLD.REVSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWREVSIN', :NEW.REVSIN);
        SP_DATSTR(:OLD.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATFIM', l_datTemp);
        SP_DATSTR(:NEW.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATFIM', l_datTemp);
      END;
    END IF; 
  END IF;  	
END␀ïÓ␀␀		SENIOR;0·␀␀

