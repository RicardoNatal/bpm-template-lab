PROCEDURE SP_AUDGETSEQREG(P_RETSEQ OUT NUMBER(15))
IS

 l_seqreg       NUMBER(15);
 l_ret          NUMBER(15);
 l_data_atual   DATE;
 l_anostr       VARCHAR(8);
 l_anoreg       NUMBER(4);
BEGIN
  l_ret:=0;

  l_data_atual := CURDATE();
  SP_DATSTR(l_data_atual,'DDMMYYYY',l_anostr OUT);
  l_anostr :=  SUBSTRING(l_anostr,5,4);
  SP_INTSTR(l_anostr, '9999', l_anoreg OUT);

  BEGIN
      INSERT INTO R151SEQ (ANOREG) VALUES (l_anoreg);
  EXCEPTION
    WHEN OTHERS THEN
        RAISERROR 103 'Erro ao gerar sequencial de registros na R151SEQ 1. ';
  END;

  BEGIN
      SELECT MAX(SEQREG) INTO l_seqreg
        FROM R151SEQ
       WHERE ANOREG = l_anoreg;
  EXCEPTION
    WHEN OTHERS THEN
        RAISERROR 103 'Erro ao gerar sequencial de registros na R151SEQ 2. ';
  END;

  P_RETSEQ := l_anoreg * 100000000000 + l_seqreg;
END		SENIOR;23SP_DATSTR
SP_INTSTR
