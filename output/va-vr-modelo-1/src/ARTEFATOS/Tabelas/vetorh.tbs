    NIVATE   R110HSN.NIVATE%TYPE);

  l_R110HSN t_R110HSN;
  l_R110HSN_AUX t_R110HSN;
BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();

  /* Le Registro do CURSOR */
  FOREACH c_R110HSN_AUX INTO l_R110HSN_AUX.NUMEMP,
                             l_R110HSN_AUX.CODFIC,
                             l_R110HSN_AUX.DATINI,
                             l_R110HSN_AUX.DATTER
  LOOP
    l_NumEmp := l_R110HSN_AUX.NUMEMP;
    l_CodFic := l_R110HSN_AUX.CODFIC;
    l_TemSub := 'N';

    FOREACH c_R110HSN INTO l_R110HSN.NUMEMP,
                           l_R110HSN.CODFIC,
                           l_R110HSN.DATINI,
                           l_R110HSN.DATTER
    LOOP
      /* Verifica se tem alguma subnormalidade válida na data atual. */
      IF (l_R110HSN.DATINI <= l_data_atual) AND ((l_R110HSN.DATTER >= l_data_atual) OR (l_R110HSN.DATTER = l_data_zero)) THEN
        l_TemSub := 'S';
      END IF;
    END LOOP;

    /* Lê o conteúdo atual do campo R110FIC.TemSub */
    BEGIN
      SELECT TEMSUB INTO l_TemSubAtual FROM R110FIC WHERE NUMEMP = l_R110HSN_AUX.NUMEMP AND CODFIC = l_R110HSN_AUX.CODFIC;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_TemSubAtual := ' ';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler campo TemSub da R110FIC.';
    END;

    IF (l_TemSub <> l_TemSubAtual) THEN
      /* Atualiza campo R110FIC.TemSub - Indica se possui ou não subnormalidade */
      BEGIN
        UPDATE R110FIC SET TEMSUB = l_TemSub WHERE NUMEMP = l_R110HSN_AUX.NUMEMP AND CODFIC = l_R110HSN_AUX.CODFIC;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao atualizar o campo TemSub na tabela R110FIC.';
      END;
    END IF;
  END LOOP;

  /* Apaga Registro OLD em R110HSN_AUX */
  BEGIN
    DELETE FROM R110HSN_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀jß␀␀		SENIOR;0…
