TRIGGER R042RCS_EI AFTER INSERT ON R042RCS FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs R042RCS - Rescisão Complementar*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 38;     /* R042RCS - Rescisão Complementar*/
  l_codtpa := 187;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R042RCS_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATPAG, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPAG', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R042RCS_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:NEW.FINAVI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FINAVI', l_datTemp);
        SP_DATSTR(:NEW.FIMCTT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMCTT', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDIND', CONVERT(NUMBER_TO_CHAR, :NEW.QTDIND));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDREA', CONVERT(NUMBER_TO_CHAR, :NEW.QTDREA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDSSL', CONVERT(NUMBER_TO_CHAR, :NEW.QTDSSL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDGRA', CONVERT(NUMBER_TO_CHAR, :NEW.QTDGRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDEST', CONVERT(NUMBER_TO_CHAR, :NEW.QTDEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERIND', CONVERT(NUMBER_TO_CHAR, :NEW.PERIND));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDFCA', CONVERT(NUMBER_TO_CHAR, :NEW.QTDFCA));
        SP_DATSTR(:NEW.DATCTB, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATCTB', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SALFAV', CONVERT(NUMBER_TO_CHAR, :NEW.SALFAV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SLDFGT', CONVERT(NUMBER_TO_CHAR, :NEW.SLDFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BINSLD', CONVERT(NUMBER_TO_CHAR, :NEW.BINSLD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BIN13S', CONVERT(NUMBER_TO_CHAR, :NEW.BIN13S));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BIRSLD', CONVERT(NUMBER_TO_CHAR, :NEW.BIRSLD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AIRSLD', CONVERT(NUMBER_TO_CHAR, :NEW.AIRSLD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BIR13S', CONVERT(NUMBER_TO_CHAR, :NEW.BIR13S));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AIR13S', CONVERT(NUMBER_TO_CHAR, :NEW.AIR13S));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BIRFER', CONVERT(NUMBER_TO_CHAR, :NEW.BIRFER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AIRFER', CONVERT(NUMBER_TO_CHAR, :NEW.AIRFER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BASFGT', CONVERT(NUMBER_TO_CHAR, :NEW.BASFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ABAFGT', CONVERT(NUMBER_TO_CHAR, :NEW.ABAFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BASFGD', CONVERT(NUMBER_TO_CHAR, :NEW.BASFGD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ABAFGD', CONVERT(NUMBER_TO_CHAR, :NEW.ABAFGD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BAAPFG', CONVERT(NUMBER_TO_CHAR, :NEW.BAAPFG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AFGIND', CONVERT(NUMBER_TO_CHAR, :NEW.AFGIND));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BAAPFD', CONVERT(NUMBER_TO_CHAR, :NEW.BAAPFD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AFGI13', CONVERT(NUMBER_TO_CHAR, :NEW.AFGI13));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TOTPRO', CONVERT(NUMBER_TO_CHAR, :NEW.TOTPRO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TOTDES', CONVERT(NUMBER_TO_CHAR, :NEW.TOTDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INTRCS', CONVERT(NUMBER_TO_CHAR, :NEW.INTRCS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TOTVAN', CONVERT(NUMBER_TO_CHAR, :NEW.TOTVAN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MAIREM', CONVERT(NUMBER_TO_CHAR, :NEW.MAIREM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BIRPAR', CONVERT(NUMBER_TO_CHAR, :NEW.BIRPAR));
        SP_DATSTR(:NEW.DISCOL, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DISCOL', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TEMDIS', :NEW.TEMDIS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SALBAS', CONVERT(NUMBER_TO_CHAR, :NEW.SALBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CALRCS', CONVERT(NUMBER_TO_CHAR, :NEW.CALRCS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AVIPRE', CONVERT(NUMBER_TO_CHAR, :NEW.AVIPRE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BINTOT', CONVERT(NUMBER_TO_CHAR, :NEW.BINTOT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BIN13T', CONVERT(NUMBER_TO_CHAR, :NEW.BIN13T));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BIPSLD', CONVERT(NUMBER_TO_CHAR, :NEW.BIPSLD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BIP13S', CONVERT(NUMBER_TO_CHAR, :NEW.BIP13S));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDIAC', CONVERT(NUMBER_TO_CHAR, :NEW.QTDIAC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDRAC', CONVERT(NUMBER_TO_CHAR, :NEW.QTDRAC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VLRERA', CONVERT(NUMBER_TO_CHAR, :NEW.VLRERA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TERQUI', CONVERT(NUMBER_TO_CHAR, :NEW.TERQUI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BAIFGT', CONVERT(NUMBER_TO_CHAR, :NEW.BAIFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BAIFGD', CONVERT(NUMBER_TO_CHAR, :NEW.BAIFGD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALINS', CONVERT(NUMBER_TO_CHAR, :NEW.VALINS));
      END;
  END IF; 
END␀ØÕ␀␀		SENIOR;0*>␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R042RCS_EU AFTER UPDATE ON R042RCS FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs R042RCS - Rescisão Complementar*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 38;     /* R042RCS - Rescisão Complementar*/
  l_codtpa := 188;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatPag <> :NEW.DatPag)
   OR (:OLD.FinAvi <> :NEW.FinAvi)
   OR (:OLD.FimCtt <> :NEW.FimCtt)
   OR (:OLD.QtdInd <> :NEW.QtdInd)
   OR (:OLD.QtdRea <> :NEW.QtdRea)
   OR (:OLD.QtdSsl <> :NEW.QtdSsl)
   OR (:OLD.QtdGra <> :NEW.QtdGra)
   OR (:OLD.QtdEst <> :NEW.QtdEst)
   OR (:OLD.PerInd <> :NEW.PerInd)
   OR (:OLD.QtdFca <> :NEW.QtdFca)
   OR (:OLD.DatCtb <> :NEW.DatCtb)
   OR (:OLD.SalFav <> :NEW.SalFav)
   OR (:OLD.SldFgt <> :NEW.SldFgt)
   OR (:OLD.BinSld <> :NEW.BinSld)
   OR (:OLD.Bin13s <> :NEW.Bin13s)
   OR (:OLD.BirSld <> :NEW.BirSld)
   OR (:OLD.AirSld <> :NEW.AirSld)
   OR (:OLD.Bir13s <> :NEW.Bir13s)
