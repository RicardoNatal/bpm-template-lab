ğ␀␀Òï␀␀Ôï␀␀ ␀␀ÿ␀␀ÿ␀f'Ôÿ1␀␀␀␀␀Ï␀Â␀Ã␀‚␀␀␀ÿ␀␀ÿ␀«î␀Ôÿ1␀␀␀␀␀␀²␀n␀Æÿ␀␀ÿ␀j,TÔÿ1␀␀␀␀␀ß*\"\"␀␀␀␀ÿ␀␀ä␀␀␀A,Ôÿ1␀␀␀␀␀s<^"^"␀␀ÿ␀␀ä␀␀␀¢-DÔÿ1␀␀␀␀␀#‹␀␀A␀A␀€␀␀␀ÿ␀␀ä␀␀␀␀␀␀0;1;2;3qÕ␀␀		SENIOR;0‡␀␀TRIGGER R039AFA_EI BEFORE INSERT ON R039AFA FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);
  l_layout VARCHAR(6);
  l_gerarPendencia BOOLEAN;
BEGIN
  /* S-2230 - iniAfastamento */
  l_gerarPendencia := TRUE;
  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
  N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
  IF (l_gerarPendencia = TRUE) THEN  	
    
    l_Valor := '';
    SP_CONCATENAR_DAT('DATAFA', :NEW.DATAFA, l_Valor OUT);
    SP_CONCATENAR_NUM('HORAFA', 0, l_Valor OUT);
    SP_CONCATENAR_NUM('SECAFA', 1, l_Valor OUT); /* 1 - Início afastamento */
    SP_E_SOCIAL('S-2230', 'R039AFA', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATAFA, 0, 'R039AFA_EI');
  
    /* S-2230 - fimAfastamento */
    l_Valor := '';
    SP_CONCATENAR_DAT('DATAFA', :NEW.DATAFA, l_Valor OUT);
    SP_CONCATENAR_NUM('HORAFA', 0, l_Valor OUT);
    SP_CONCATENAR_NUM('SECAFA', 3, l_Valor OUT); /* 3 - Fim afastamento */
    SP_E_SOCIAL('S-2230', 'R039AFA', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATTER, 0, 'R039AFA_EI');
  END IF;
END␀rÕ␀␀		SENIOR;0
␀␀

TRIGGER R039AFA_EU AFTER UPDATE ON R039AFA FOR EACH ROW

DECLARE
  l_Valor         VARCHAR2(2000);
  l_Valido        BOOLEAN;
  l_AlterouIni    BOOLEAN;
  l_AlterouFim    BOOLEAN;
  l_InfoFacult    BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_layout VARCHAR(6);
  l_gerarPendencia BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  l_gerarPendencia := TRUE;
  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
  N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
  IF (l_gerarPendencia = TRUE) THEN  
  	  
    l_AlterouIni := FALSE;
    l_AlterouFim := FALSE;
    l_InfoFacult := TRUE;
    l_SimplificaoESocial := FALSE;
    l_VersaoESocial := 0;
    SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
    
    IF (l_InfoFacult = TRUE) THEN
      SP_VALUPDATE_DES(:OLD.CODDOE, :NEW.CODDOE, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_AlterouIni := TRUE;
      END IF;
    
      SP_VALUPDATE_DES(:OLD.NOMATE, :NEW.NOMATE, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_AlterouIni := TRUE;
      END IF;  
    
      SP_VALUPDATE_NUM(:OLD.ORGCLA, :NEW.ORGCLA, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_AlterouIni := TRUE;
      END IF;  
    
      SP_VALUPDATE_DES(:OLD.REGCON, :NEW.REGCON, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_AlterouIni := TRUE;
      END IF;
    
      SP_VALUPDATE_DES(:OLD.ESTCON, :NEW.ESTCON, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_AlterouIni := TRUE;
      END IF;
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.ACITRA, :NEW.ACITRA, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
  	l_AlterouIni := TRUE;
    END IF;	
    
    SP_VALUPDATE_DAT(:OLD.DATTER, :NEW.DATTER, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
  	l_AlterouFim := TRUE;
    END IF;
    
    IF (l_AlterouIni = TRUE) THEN
  	l_Valor := '';
  	SP_CONCATENAR_DAT('DATAFA', :NEW.DATAFA, l_Valor OUT);
  	SP_CONCATENAR_NUM('HORAFA', 0, l_Valor OUT);
  	SP_CONCATENAR_NUM('SECAFA', 1, l_Valor OUT); /* 1 - Início afastamento */
  	SP_E_SOCIAL('S-2230', 'R039AFA', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATAFA, 0, 'R039AFA_EU');	
    END IF;
       
    IF (l_AlterouFim = TRUE) THEN
    	l_Valor := '';
      SP_CONCATENAR_DAT('DATAFA', :NEW.DATAFA, l_Valor OUT);
      SP_CONCATENAR_NUM('HORAFA', 0, l_Valor OUT);
      SP_CONCATENAR_NUM('SECAFA', 3, l_Valor OUT); /* 3 - Fim afastamento */
      SP_E_SOCIAL('S-2230', 'R039AFA', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATAFA, 0, 'R039AFA_EU');	
    END IF;
  END IF;    
END␀pÕ␀␀		SENIOR;0Ë␀␀

TRIGGER R039AFA_ED AFTER DELETE ON R039AFA FOR EACH ROW

DECLARE
  l_Valor      VARCHAR2(2000);
  l_layout VARCHAR(6);
  l_gerarPendencia BOOLEAN;
BEGIN
  l_gerarPendencia := TRUE;
  RH_LAYOUTCOLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layout OUT);
  N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
  IF (l_gerarPendencia = TRUE) THEN    
    l_Valor := '';
    SP_CONCATENAR_DAT('DATAFA', :OLD.DATAFA, l_Valor OUT);
    SP_CONCATENAR_NUM('HORAFA', 0, l_Valor OUT);
    SP_CONCATENAR_DES('LAYOUT', 'S-2230', l_Valor OUT); 
    SP_E_SOCIAL('S-3000', 'R039AFA', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0, NULL, :OLD.DATAFA, 0, 'R039AFA_ED');
  END IF;    
END␀␀␀i␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀tÕ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀XbXbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀Ü␀.␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀0.0.0.w␀Æÿ␀␀…Ó␀␀␀‘␀␀Ñ␀	␀␀␀␀␀␀␀º”␀␀áÀ␀␀¹”␀␀qC␀êÿ␀␀‘Õ␀␀␀Ó␀±␀	␀␀␀␀␀␀␀>´␀û␀q␀Æÿ␀␀Ï␀␀␀È-´␀	␀␀␀␀␀␀␀û␀û␀û␀r␀Æÿ␀␀¢Õ␀␀␀?␀‘␀␀␀␀␀␀␀␀³Ë␀␀¦␀¦␀h)␀␀Æÿ␀␀ÿ␀~␀‘␀␀␀␀␀␀␀␀´Ë␀␀å␀å␀h)␀␀Æÿ␀␀ÿ␀␀␀uÕ␀␀␀␀0;1;2;3;4;5wÕ␀␀		SENIOR;0g␀␀TRIGGER  R040ACU_SI AFTER INSERT ON R040ACU FOR EACH ROW

DECLARE
  l_codrpa NUMBER(15);
  l_temAud BOOLEAN;
  l_datTemp VARCHAR(10);
BEGIN
  SP_EXISTE_LOG(17, 148, 1, l_temAud OUT);  
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, 17, 1, 148, 1, 'R040ACU_SI', 'FR040ACU'); 
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
      SP_DATSTR(:NEW.INIPER, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIPER', l_datTemp);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TABEVE));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTOT', CONVERT(NUMBER_TO_CHAR, :NEW.CODTOT));
    EXCEPTION
  	  WHEN OTHERS THEN RAISERROR 103 'R040ACU_SI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;
   
   BEGIN 
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALTOT', CONVERT(NUMBER_TO_CHAR, :NEW.VALTOT)); 
    END;
  END IF;    
END␀xÕ␀␀		SENIOR;0␀␀

TRIGGER R040ACU_SU AFTER UPDATE ON R040ACU FOR EACH ROW
DECLARE
  l_codrpa NUMBER(15);
  l_temAud BOOLEAN;
  l_datTemp VARCHAR(10);
BEGIN
IF ((:OLD.NumEmp <> :NEW.NumEmp)
OR (:OLD.TipCol <> :NEW.TipCol)
OR (:OLD.NumCad <> :NEW.NumCad)
OR (:OLD.IniPer <> :NEW.IniPer)
OR (:OLD.TabEve <> :NEW.TabEve)
OR (:OLD.CodTot <> :NEW.CodTot)
OR (:OLD.ValTot <> :NEW.ValTot)) THEN
    SP_EXISTE_LOG(17, 147, 1, l_temAud OUT);    
  
    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, 1, 17, 1, 147, 1, 'R040ACU_SU', 'FR040ACU');
     
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
	    SP_DATSTR(:OLD.INIPER, 'DD/MM/YYYY', l_datTemp OUT);
	    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIPER', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :OLD.TABEVE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTOT', CONVERT(NUMBER_TO_CHAR, :OLD.CODTOT));  
      EXCEPTION
  	    WHEN OTHERS THEN RAISERROR 103 'R040ACU_SU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
    
      BEGIN 
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVALTOT', CONVERT(NUMBER_TO_CHAR, :OLD.VALTOT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWVALTOT', CONVERT(NUMBER_TO_CHAR, :NEW.VALTOT));       
      END;
	END IF;
  END IF;  
END␀vÕ␀␀		SENIOR;0j␀␀

TRIGGER R040ACU_SD AFTER DELETE ON R040ACU FOR EACH ROW

DECLARE
  l_codrpa NUMBER(15);
  l_temAud BOOLEAN;
  l_datTemp VARCHAR(10);
BEGIN
  SP_EXISTE_LOG(17, 147, 1, l_temAud OUT);  
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, 17, 1, 147, 1, 'R040ACU_SD', 'FR040ACU');
   
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
	  SP_DATSTR(:OLD.INIPER, 'DD/MM/YYYY', l_datTemp OUT);
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIPER', l_datTemp);      
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :OLD.TABEVE));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTOT', CONVERT(NUMBER_TO_CHAR, :OLD.CODTOT));
    EXCEPTION
  	  WHEN OTHERS THEN RAISERROR 103 'R040ACU_SD: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;
   
   BEGIN 
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALTOT', CONVERT(NUMBER_TO_CHAR, :OLD.VALTOT));
    END;
  END IF;    
END␀␀␀9Á␀␀␀␀␀␀␀␀␀␀␀yÕ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀}␀×␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀P%€$0.w␀Æÿ␀␀…Ó␀␀␀‘␀␀Ñ␀	␀␀␀␀␀␀␀êGáÀ␀␀îÀ␀␀qC␀êÿ␀␀‘Õ␀␀␀Ò␀␀Ñ␀	␀␀␀␀␀␀␀ìGZ”␀␀Æ”␀␀qC␀êÿ␀␀ÿ␀ûnÑ␀␀␀␀␀␀␀␀M¿F¢nqC␀êÿ␀␀ÿ␀[¶␀␀␀␀␀␀␀␀‰\İ[W\4)␀␀Æÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀ûs␀␀␀␀␀␀␀␀zÕ␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀XbXbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ?␀␀␀␀␀Ü␀Ü␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ?␀␀␀␀␀$$$w␀Æÿ␀␀…Ó␀␀␀‘␀␀Ñ␀	␀␀␀␀␀␀␀êGZ”␀␀¹”␀␀qC␀êÿ␀␀ÿ␀ñ␀␀Ñ␀	␀␀␀␀␀␀␀äGZ”␀␀#•␀␀qC␀êÿ␀␀ÿ␀0␀'	Ôÿ?␀␀␀␀␀æ␀(␀å␀c␀␀␀ÿ␀␀ÿ␀™µ␀␀Ì␀	Ôÿ?␀␀␀␀␀¶µ␀␀¶µ␀␀¶µ␀␀{␀Æÿ␀␀ÿ␀¢1Š␀Ôÿ?␀␀␀␀␀ê5ê5ê5n␀Æÿ␀␀ÿ␀ÿ‘␀Ôÿ?␀␀␀␀␀ë„ h)␀␀Æÿ␀␀ÿ␀õ'␀‘␀Ôÿ?␀␀␀␀␀Á#␀S!␀!␀h)␀␀Æÿ␀␀ÿ␀øZ‘␀Ôÿ?␀␀␀␀␀…␀…␀…␀h)␀␀Æÿ␀␀ÿ␀‘␀Ôÿ?␀␀␀␀␀<<<h)␀␀Æÿ␀␀ÿ␀‘␀Ôÿ?␀␀␀␀␀h)␀␀Æÿ␀␀ÿ␀N¶␀␀öÔÿ?␀␀␀␀␀·␀␀‘¶␀␀‘¶␀␀c␀␀␀ÿ␀␀ÿ␀)+‘␀Ôÿ?␀␀␀␀␀M&M&M&h)␀␀Æÿ␀␀ÿ␀++‘␀Ôÿ?␀␀␀␀␀U&U&U&h)␀␀Æÿ␀␀ÿ␀,+‘␀Ôÿ?␀␀␀␀␀W&W&W&h)␀␀Æÿ␀␀ÿ␀-+­␀Ôÿ?␀␀␀␀␀Y&Y&Y&p␀Æÿ␀␀ÿ␀.+Ñ␀Ôÿ?␀␀␀␀␀[&[&[&qC␀êÿ␀␀ÿ␀/+␀Ôÿ?␀␀␀␀␀\&\&\&c␀␀␀ÿ␀␀ÿ␀0+FÔÿ?␀␀␀␀␀]&]&]&=␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3;4;5;6␀␀&%␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀{Õ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀}␀Ü␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀.%€$€$w␀Æÿ␀␀…Ó␀␀␀‘␀␀Ñ␀	␀␀␀␀␀␀␀4•␀␀¹”␀␀¹”␀␀qC␀êÿ␀␀‘Õ␀␀␀ñ␀␀Ñ␀	␀␀␀␀␀␀␀#•␀␀ ”␀␀ ”␀␀qC␀êÿ␀␀ƒÕ␀␀␀€ü␀␀­␀	␀␀␀␀␀␀␀sÿ␀␀xş␀␀xş␀␀p␀Æÿ␀␀ÿ␀Ë␀␀Ñ␀␀␀␀␀␀␀␀*•␀␀f”␀␀f”␀␀qC␀êÿ␀␀ÿ␀»
