TRIGGER R304ACA_SI AFTER INSERT ON R304ACA
DECLARE
	CURSOR c_R304ACA IS
	SELECT NUMEMP, NUMATO, DATATO, NUMMAT, NUMCPF, CODUNI, NOMARQ, TIPDOC, SEQREG
	  FROM R304ACA
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304ACA IS RECORD (
		NUMEMP   R304ACA.NUMEMP%TYPE,
		NUMATO   R304ACA.NUMATO%TYPE,
		DATATO   R304ACA.DATATO%TYPE,
		NUMMAT   R304ACA.NUMMAT%TYPE,
		NUMCPF   R304ACA.NUMCPF%TYPE,
		CODUNI   R304ACA.CODUNI%TYPE,
		NOMARQ   R304ACA.NOMARQ%TYPE,
		TIPDOC   R304ACA.TIPDOC%TYPE,
		SEQREG   R304ACA.SeqReg%TYPE
	);
    
    l_R304ACA t_R304ACA;
    l_PidSta VARCHAR2(30);
    l_MsgErr VARCHAR2(255);
BEGIN
	FOREACH c_R304ACA INTO l_R304ACA.NumEmp, l_R304ACA.NUMATO, l_R304ACA.DATATO, l_R304ACA.NUMMAT, l_R304ACA.NUMCPF, l_R304ACA.CODUNI, l_R304ACA.NOMARQ, l_R304ACA.TIPDOC, l_R304ACA.SeqReg
	LOOP
		/* Busca PID gravado no registro da Concessão Aposentadoria */
		BEGIN
			SELECT CAP.PIDSTA INTO l_PidSta
			  FROM R304CAP CAP, R304STA STA
			 WHERE CAP.PIDSTA = STA.PIDSTA
			   AND CAP.NUMEMP = l_R304ACA.NumEmp
			   AND CAP.NUMATO = l_R304ACA.NUMATO
			   AND CAP.DATATO = l_R304ACA.DATATO
			   AND CAP.NUMMAT = l_R304ACA.NUMMAT
			   AND CAP.NUMCPF = l_R304ACA.NUMCPF
			   AND CAP.CODUNI = l_R304ACA.CODUNI
			   AND CAP.SeqReg = l_R304ACA.SeqReg
			   AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_MsgErr := 'Não existe registro de concessão de aposentadoria pendente com as seguintes chaves: ' ||
					'Empresa: ' || CONVERT(NUMBER_TO_CHAR, l_R304ACA.NumEmp) || ', Ato: ' || l_R304ACA.NUMATO|| ', Data Ato: ' || CONVERT(DATE_TO_CHAR,l_R304ACA.DATATO)
					|| ', Número Matrícula: ' || l_R304ACA.NUMMAT ||', CPF: ' || CONVERT(NUMBER_TO_CHAR, l_R304ACA.NUMCPF) ||', Cod Unidade: ' || CONVERT(NUMBER_TO_CHAR, l_R304ACA.CODUNI) || '.';
				RAISERROR 103 l_MsgErr;
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304CAP.';
		END;
		
		BEGIN
			UPDATE R304ACA
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304ACA.NumEmp
			   AND NUMATO = l_R304ACA.NUMATO
			   AND DATATO = l_R304ACA.DATATO
			   AND NUMMAT = l_R304ACA.NUMMAT
			   AND NUMCPF = l_R304ACA.NUMCPF
			   AND CODUNI = l_R304ACA.CODUNI
			   AND NOMARQ = l_R304ACA.NOMARQ
			   AND TIPDOC = l_R304ACA.TIPDOC
			   AND SEQREG = l_R304ACA.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304ACA,.';
		END;
	END LOOP;
END␀å␀␀		SENIOR;0%␀␀TRIGGER R304ACA_EI BEFORE INSERT ON R304ACA FOR EACH ROW
DECLARE
	l_SeqReg   R304ACA.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Verifica se está tentando incluir um registro com sequência maior do que a última já cadastrada */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304ACA
		 WHERE NUMEMP = :NEW.NumEmp
		   AND NUMATO = :NEW.NUMATO
		   AND DATATO = :NEW.DATATO
		   AND NUMMAT = :NEW.NUMMAT
		   AND NUMCPF = :NEW.NUMCPF
		   AND CODUNI = :NEW.CODUNI
		   AND NOMARQ = :NEW.NOMARQ
		   AND TIPDOC = :NEW.TIPDOC
		   AND SEQREG <> :NEW.SEQREG;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304ACA.';
	END;
	
	IF (l_SeqReg > 0) THEN
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀å␀␀		SENIOR;0ª␀␀

TRIGGER R304ACA_EU BEFORE UPDATE ON R304ACA FOR EACH ROW
DECLARE
	l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
	/* Somente permite alterar caso status do envio seja P - Pendente Envio e R - Erro Envio */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados/excluídos.';
	END IF;
END␀␀␀ *␀␀␀␀␀␀␀␀␀␀␀␀␀␀ å␀␀…¬␀␀´␀	Ôÿ?ü␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀b␀H	Ôÿ␀␀␀␀␀P␀g␀ò␀p␀Æÿ␀␀ÿ␀î¬␀␀	Ôÿ␀␀␀␀␀²␀␀W¯␀␀¦±␀␀%␀␀ÿ␀␀ÿ␀+§␀␀	Ôÿ␀␀␀␀␀ô©␀␀B©␀␀B©␀␀␀␀ÿ␀␀ÿ␀d␀
