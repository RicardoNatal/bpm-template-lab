TRIGGER R108RES_AD AFTER DELETE ON R108RES FOR EACH ROW
DECLARE
	l_TipAtn NUMBER(1);
	l_AtnFic NUMBER(1);
	l_TipCol NUMBER(1);
	l_NumCad NUMBER(9);
	l_CodDep NUMBER(2);
	l_NumCan NUMBER(7);
	l_DataASO DATE;
	l_Valor VARCHAR2(2000);
	l_EnvEso VARCHAR2(1);
	l_temAud BOOLEAN;
    l_codRPA NUMBER(15);
    l_codSistema NUMBER(2);
    l_codcpa NUMBER(4);
    l_codtpa NUMBER(4);
    l_datTemp VARCHAR(10);
    NEW_NUMEMP NUMBER(4);
    NEW_CODFIC NUMBER(9);
    NEW_CODEXA NUMBER(4);
    NEW_DATSOL DATE;
    NEW_ORIEXA NUMBER(3);
BEGIN
	/* eSocial S-2220 - Início */
	l_Valor := '';
	
	RH_RETENVESO(:OLD.NumEmp, :OLD.AteAso, :OLD.NumAte, l_EnvEso OUT);
	RH_RETATNFICMED(:OLD.NumEmp, :OLD.CodFic, :OLD.DatSol, l_TipAtn OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
    RH_RETFICMED(:OLD.NumEmp, :OLD.CodFic, l_TipAtn OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
	IF (l_EnvEso = 'S') THEN
		IF (:OLD.SitExa = 'R') THEN	/* 'R' = Realizado */
			IF (l_TipAtn = 1) OR (l_AtnFic = 1) THEN /* 1 - Colaborador */
				IF ((:OLD.AteAso > 0) AND (:OLD.NumAte > 0)) THEN	
					RH_RETDATATE(:OLD.NumEmp, :OLD.AteAso, :OLD.NumAte, l_DataASO OUT);
	
					SP_CONCATENAR_NUM('CODATE', :OLD.AteAso, l_Valor OUT);
					SP_CONCATENAR_NUM('NUMATE', :OLD.NumAte, l_Valor OUT);
					SP_CONCATENAR_DAT('DATATE', l_DataASO, l_Valor OUT);
				
					SP_E_SOCIAL_SM('S-2220', 'R108RES', 'N', 'E', NULL, NULL, :OLD.NumEmp, l_TipCol, l_NumCad, l_Valor, '', 0, NULL, l_DataASO, 0, 'R108RES_AD');	  					
				END IF;
			END IF;
		END IF;
	END IF;
	/* eSocial S-2220 - Fim */
	
