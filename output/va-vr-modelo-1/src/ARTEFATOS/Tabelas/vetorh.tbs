^"␀␀/* Processa demanda de sicronismo - 11 = Liberação de Interjornada (R070LIJ) */
PROCEDURE SP_SINLIJ(P_VALSTR VARCHAR2(255),P_RETERR OUT NUMBER(2))
 IS

    l_codErr     NUMBER(2);
    l_datCon     VARCHAR2(25);
    l_idtPes     VARCHAR2(23);
    l_idtAut     VARCHAR2(23);
    l_datStr     VARCHAR2(16);
    l_pos        NUMBER(3);
    l_tam        NUMBER(3);
    l_obsSij     VARCHAR2(80);
    l_codUsu     NUMBER(10);
    l_datIni     DATE;
    l_horIni     NUMBER(4);
    l_count      NUMBER(1);
    l_temInt     CHAR(1);
    l_temDat     CHAR(1);
    l_craPro     NUMBER(12);
    l_craTit     NUMBER(12);
    l_craAti     NUMBER(12);
    /*l_craAtiStr  CHAR(12);*/
    l_numBar     NUMBER(12);
    l_numPro     NUMBER(12);
    l_numSma     NUMBER(12);
    l_craPri     NUMBER(12);
    l_tecPri     NUMBER(1);
    l_datAtu     DATE;
    l_horAtu     NUMBER(4);
    l_datAnt     DATE;
    l_staAcc     NUMBER(1);
    l_usuTel     VARCHAR2(31);
    l_comando    VARCHAR2(255);
    l_ultRs      VARCHAR2(25);    
    
    /*Variáveis auxiliares para desmontar IDTPES do colaborador*/
    l_tipPes     NUMBER(2);
    l_numEmp     NUMBER(4);
    l_tipCol     NUMBER(1);
    l_numCad     NUMBER(9);
    l_tipDoc     NUMBER(1);
    l_numDoc     VARCHAR2(20);
    l_numMat     VARCHAR2(15);
    l_proPac     VARCHAR2(20);
    
    /*Variáveis auxiliares para desmontar IDTPES do autorizador*/
    l_tipPesAut  NUMBER(2);
    l_numEmpAut  NUMBER(4);
    l_tipColAut  NUMBER(1);
    l_numCadAut  NUMBER(9);
    l_tipDocAut  NUMBER(1);
    l_numDocAut  VARCHAR2(20);
    l_numMatAut  VARCHAR2(15);
    l_proPacAut  VARCHAR2(20);
    
    l_icardA     VARCHAR2(12);
    l_icardR     VARCHAR2(12);
    l_numser     VARCHAR2(12);
BEGIN
    /* inicializa variáveis */
    l_codErr := 0;
    p_retErr := 0;
    l_count  := 0;
    l_craAti := 0;
    l_codUsu := 0;
    
    /* separa os valores da string do p_valStr em cada variável */
    BEGIN
        l_pos := 3;    
        l_idtPes := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_datStr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
        l_idtAut := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_obsSij := NULL;
        
        l_tam := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_valStr, l_pos, 3)); l_pos := l_pos + 3;        
        IF (l_tam > 0) THEN
            l_obsSij := LTRIM(RTRIM(SUBSTRING(p_valStr, l_pos, l_tam))); l_pos := l_pos + l_tam;

            IF  (l_obsSij = '') THEN
              l_obsSij := NULL;
            END IF;
        END IF;
        
        /* CODUSU */
        l_codUsu := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;

        /* converte data/hora inicial */
        l_datCon := SUBSTRING(l_datStr,1,2) || '/' || SUBSTRING(l_datStr,3,2) ||'/'||SUBSTRING(l_datStr,5,2);
        SP_STRTODATE(l_datCon,'DD/MM/AA', l_datIni OUT);
        l_horIni := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datStr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datStr,9,2)));

        /* desmontar IDTPES do visitante */
        SP_PESFROMIDTPES(l_idtPes, l_tipPes OUT, l_numEmp OUT, l_tipCol OUT, l_numCad OUT, l_tipDoc OUT, l_numDoc OUT, l_numMat OUT, l_proPac OUT);

        /* desmontar IDTPES do autorizador */
        SP_PESFROMIDTPES(l_idtAut, l_tipPesAut OUT, l_numEmpAut OUT, l_tipColAut OUT, l_numCadAut OUT, l_tipDocAut OUT, l_numDocAut OUT, l_numMatAut OUT, l_proPacAut OUT);
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 47; /* erro de conversão na string */
    END;

    /* Calcula data/hora */
    l_datAtu := CURDATE();
    l_horAtu := HOUR(CURTIME())*60 + MINUTE(CURTIME());

    /* Calcula o status */
    l_staAcc := 0;
    IF (l_datIni > l_datAtu) OR ((l_datIni = l_datAtu) AND (l_horIni > l_horAtu)) THEN
        l_staAcc := 0; /* liberação futura */
    ELSE
        l_staAcc := 1; /* liberação presente */
    END IF; 

    /* Verifica se tem registro com a mesma chave */
    IF  (l_coderr = 0) THEN
        /* busca autorização de liberação de interjornada */
        BEGIN
            SELECT COUNT(*) INTO l_count FROM R070LIJ WHERE NUMEMP = l_numEmp AND TIPCOL = l_tipCol AND NUMCAD = l_numCad AND DATINI = l_datIni AND HORINI = l_horIni;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN l_count := 0;
            WHEN OTHERS THEN l_count := 0;
        END;

        /* se tem a mesma chave, siginifca q foi gravado no mesmo momento */
        /* então só mantem o ultimo número físico */
        IF (l_count > 0) THEN
            /* fecha o histórico anterior do número físico, se existir */
            BEGIN
                UPDATE R070LIJ SET 
                        EMPAUT = l_numEmpAut,
                        TCLAUT = l_tipColAut,
                        CADAUT = l_numCadAut,
                        OBSSIJ = l_obsSij,
                        CODUSU = l_codUsu,
                        STAACC = l_staAcc
                    WHERE
                        NUMEMP = l_numEmp AND
                        TIPCOL = l_tipCol AND
                        NUMCAD = l_numCad AND
                        DATINI = l_datIni AND
                        HORINI = l_horIni;
            EXCEPTION
                WHEN OTHERS THEN l_coderr := 48;
            END;
        ELSE
            BEGIN
                INSERT INTO R070LIJ (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI,
                                     EMPAUT, TCLAUT, CADAUT, OBSSIJ, CODUSU, STAACC)
                             VALUES (l_numEmp, l_tipCol, l_numCad, l_datIni, l_horIni,
                                      l_numEmpAut, l_tipColAut, l_numCadAut, l_obsSij, l_codUsu, l_staAcc);
            EXCEPTION
                WHEN OTHERS THEN l_coderr := 49;
            END;
        END IF;

        /* TELEMÁTICA */

        /* verifica na tabala R070TSI quais os campos que a Controle opera */                               
        BEGIN
            SELECT CONINT, DATHOR INTO l_temInt, l_temDat FROM R070TSI;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN l_temInt := 'N'; l_temDat := 'N';
            WHEN OTHERS THEN l_temInt := 'N'; l_temDat := 'N';
        END;

        IF l_temInt = 'S' THEN
            /* Busca o usuário da Telemática */
            SP_USUTEL(l_usuTel OUT);

            /* busca crachá provisório */
            SP_RETCRA(2, l_numEmp, l_tipCol, l_numCad, 0, '', 0, '', l_craPro OUT);
            IF  l_craPro = 0 THEN
                /* se não encontrou provisório, busca titular */
                SP_RETCRA(1, l_numEmp, l_tipCol, l_numCad, 0, '', 0, '', l_craTit OUT);
                l_craAti := l_craTit;
            ELSE
                l_craAti := l_craPro;
            END IF;
            
            /* Só continuo se o colaborador possui crachá, e utiliza tabela DATAHORA da Telemática */
            IF  l_craAti > 0 THEN
                /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
                SP_RETICARD(l_idtPes, l_craAti, l_icardA OUT, l_icardR OUT, l_numser OUT);
            
                IF l_temDat = 'S' THEN
                    /* Deleta da tabela DATAHORA */
                    BEGIN
                        l_comando := 'DELETE FROM '|| l_usutel ||'DATAHORA WHERE ICARD = '''|| l_icardA ||'''';
                        SP_CMDTSI(l_comando);
                    EXCEPTION
                        WHEN OTHERS THEN NULL;
                    END;
                END IF;
                
                /* Monta a pendência para o dia anterior a partir das 00:01h */
                l_datAnt := DATETIMEADD(DD, -1, l_datAtu);
                SP_DATSTR(l_datAnt, 'DDMMYY', l_ultRs OUT);
                l_ultRs := CONCAT(l_ultRs, '0001');
                
                /* Atualiza a tabela Controle */
                BEGIN
                    l_comando := 'UPDATE '|| l_usutel ||'CONTROLE SET ULTRS = '''|| l_ultRs ||''' WHERE ICARD = '''|| l_icardA ||'''';
                    SP_CMDTSI(l_comando);
                EXCEPTION
                    WHEN OTHERS THEN NULL;
                END;
                
                /* Cria pendência na tabela Atuali */
                SP_MAPFIS(l_craAti, l_numBar OUT, l_numPro OUT, l_numSma OUT, l_tecPri OUT, l_craPri OUT);

                /* Verifica se possui crachá smart */
                IF l_numSma <> 0 THEN
                    /* Grava Atuali/R600PEN */
                    SP_ATUALI(l_numSma, l_craAti, '59', l_ultRs);
                END IF;
            END IF; /* l_craAti > 0 */
        END IF; /* l_temInt = 'S' */
        
        
        /* não vou gerar a pendência 25 - updateRestTime como a tela G5 faz, pois a Portaria Avançada
         * é responsável por atualizar o Data Mart instantaneamente */
    END IF; /* l_coderr = 0 */
    
    /* retorna Código do erro */
    p_retErr := l_codErr;
END		SENIOR;23oSP_STRTODATE
SP_PESFROMIDTPES
SP_USUTEL
SP_RETCRA
SP_DATSTR
SP_CMDTSI
SP_MAPFIS
SP_ATUALI
SP_RETICARD
^"␀␀/* Processa demanda de sicronismo - 11 = Liberação de Interjornada (R070LIJ) */
PROCEDURE SP_SINLIJ(P_VALSTR VARCHAR2(255),P_RETERR OUT NUMBER(2))
 IS

    l_codErr     NUMBER(2);
    l_datCon     VARCHAR2(25);
    l_idtPes     VARCHAR2(23);
    l_idtAut     VARCHAR2(23);
    l_datStr     VARCHAR2(16);
    l_pos        NUMBER(3);
    l_tam        NUMBER(3);
    l_obsSij     VARCHAR2(80);
    l_codUsu     NUMBER(10);
    l_datIni     DATE;
    l_horIni     NUMBER(4);
    l_count      NUMBER(1);
    l_temInt     CHAR(1);
    l_temDat     CHAR(1);
    l_craPro     NUMBER(12);
    l_craTit     NUMBER(12);
    l_craAti     NUMBER(12);
    /*l_craAtiStr  CHAR(12);*/
    l_numBar     NUMBER(12);
    l_numPro     NUMBER(12);
    l_numSma     NUMBER(12);
    l_craPri     NUMBER(12);
    l_tecPri     NUMBER(1);
    l_datAtu     DATE;
    l_horAtu     NUMBER(4);
    l_datAnt     DATE;
    l_staAcc     NUMBER(1);
    l_usuTel     VARCHAR2(31);
    l_comando    VARCHAR2(255);
    l_ultRs      VARCHAR2(25);    
    
    /*Variáveis auxiliares para desmontar IDTPES do colaborador*/
    l_tipPes     NUMBER(2);
    l_numEmp     NUMBER(4);
    l_tipCol     NUMBER(1);
    l_numCad     NUMBER(9);
    l_tipDoc     NUMBER(1);
    l_numDoc     VARCHAR2(20);
    l_numMat     VARCHAR2(15);
    l_proPac     VARCHAR2(20);
    
    /*Variáveis auxiliares para desmontar IDTPES do autorizador*/
    l_tipPesAut  NUMBER(2);
    l_numEmpAut  NUMBER(4);
    l_tipColAut  NUMBER(1);
    l_numCadAut  NUMBER(9);
    l_tipDocAut  NUMBER(1);
    l_numDocAut  VARCHAR2(20);
    l_numMatAut  VARCHAR2(15);
    l_proPacAut  VARCHAR2(20);
    
    l_icardA     VARCHAR2(12);
    l_icardR     VARCHAR2(12);
    l_numser     VARCHAR2(12);
BEGIN
    /* inicializa variáveis */
    l_codErr := 0;
    p_retErr := 0;
    l_count  := 0;
    l_craAti := 0;
    l_codUsu := 0;
    
    /* separa os valores da string do p_valStr em cada variável */
    BEGIN
        l_pos := 3;    
        l_idtPes := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_datStr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
        l_idtAut := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_obsSij := NULL;
        
        l_tam := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_valStr, l_pos, 3)); l_pos := l_pos + 3;        
        IF (l_tam > 0) THEN
            l_obsSij := LTRIM(RTRIM(SUBSTRING(p_valStr, l_pos, l_tam))); l_pos := l_pos + l_tam;

            IF  (l_obsSij = '') THEN
              l_obsSij := NULL;
            END IF;
        END IF;
        
        /* CODUSU */
        l_codUsu := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;

        /* converte data/hora inicial */
        l_datCon := SUBSTRING(l_datStr,1,2) || '/' || SUBSTRING(l_datStr,3,2) ||'/'||SUBSTRING(l_datStr,5,2);
        SP_STRTODATE(l_datCon,'DD/MM/AA', l_datIni OUT);
        l_horIni := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datStr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datStr,9,2)));

        /* desmontar IDTPES do visitante */
        SP_PESFROMIDTPES(l_idtPes, l_tipPes OUT, l_numEmp OUT, l_tipCol OUT, l_numCad OUT, l_tipDoc OUT, l_numDoc OUT, l_numMat OUT, l_proPac OUT);

        /* desmontar IDTPES do autorizador */
        SP_PESFROMIDTPES(l_idtAut, l_tipPesAut OUT, l_numEmpAut OUT, l_tipColAut OUT, l_numCadAut OUT, l_tipDocAut OUT, l_numDocAut OUT, l_numMatAut OUT, l_proPacAut OUT);
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 47; /* erro de conversão na string */
    END;

    /* Calcula data/hora */
    l_datAtu := CURDATE();
    l_horAtu := HOUR(CURTIME())*60 + MINUTE(CURTIME());

    /* Calcula o status */
    l_staAcc := 0;
    IF (l_datIni > l_datAtu) OR ((l_datIni = l_datAtu) AND (l_horIni > l_horAtu)) THEN
        l_staAcc := 0; /* liberação futura */
    ELSE
        l_staAcc := 1; /* liberação presente */
    END IF; 

    /* Verifica se tem registro com a mesma chave */
    IF  (l_coderr = 0) THEN
        /* busca autorização de liberação de interjornada */
        BEGIN
            SELECT COUNT(*) INTO l_count FROM R070LIJ WHERE NUMEMP = l_numEmp AND TIPCOL = l_tipCol AND NUMCAD = l_numCad AND DATINI = l_datIni AND HORINI = l_horIni;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN l_count := 0;
            WHEN OTHERS THEN l_count := 0;
        END;

        /* se tem a mesma chave, siginifca q foi gravado no mesmo momento */
        /* então só mantem o ultimo número físico */
        IF (l_count > 0) THEN
            /* fecha o histórico anterior do número físico, se existir */
            BEGIN
                UPDATE R070LIJ SET 
                        EMPAUT = l_numEmpAut,
                        TCLAUT = l_tipColAut,
                        CADAUT = l_numCadAut,
                        OBSSIJ = l_obsSij,
                        CODUSU = l_codUsu,
                        STAACC = l_staAcc
                    WHERE
                        NUMEMP = l_numEmp AND
                        TIPCOL = l_tipCol AND
                        NUMCAD = l_numCad AND
                        DATINI = l_datIni AND
                        HORINI = l_horIni;
            EXCEPTION
                WHEN OTHERS THEN l_coderr := 48;
            END;
        ELSE
            BEGIN
                INSERT INTO R070LIJ (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI,
                                     EMPAUT, TCLAUT, CADAUT, OBSSIJ, CODUSU, STAACC)
                             VALUES (l_numEmp, l_tipCol, l_numCad, l_datIni, l_horIni,
                                      l_numEmpAut, l_tipColAut, l_numCadAut, l_obsSij, l_codUsu, l_staAcc);
            EXCEPTION
                WHEN OTHERS THEN l_coderr := 49;
            END;
        END IF;

        /* TELEMÁTICA */

        /* verifica na tabala R070TSI quais os campos que a Controle opera */                               
        BEGIN
            SELECT CONINT, DATHOR INTO l_temInt, l_temDat FROM R070TSI;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN l_temInt := 'N'; l_temDat := 'N';
            WHEN OTHERS THEN l_temInt := 'N'; l_temDat := 'N';
        END;

        IF l_temInt = 'S' THEN
            /* Busca o usuário da Telemática */
            SP_USUTEL(l_usuTel OUT);

            /* busca crachá provisório */
            SP_RETCRA(2, l_numEmp, l_tipCol, l_numCad, 0, '', 0, '', l_craPro OUT);
            IF  l_craPro = 0 THEN
                /* se não encontrou provisório, busca titular */
                SP_RETCRA(1, l_numEmp, l_tipCol, l_numCad, 0, '', 0, '', l_craTit OUT);
                l_craAti := l_craTit;
            ELSE
                l_craAti := l_craPro;
            END IF;
            
            /* Só continuo se o colaborador possui crachá, e utiliza tabela DATAHORA da Telemática */
            IF  l_craAti > 0 THEN
                /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
                SP_RETICARD(l_idtPes, l_craAti, l_icardA OUT, l_icardR OUT, l_numser OUT);
            
                IF l_temDat = 'S' THEN
                    /* Deleta da tabela DATAHORA */
                    BEGIN
                        l_comando := 'DELETE FROM '|| l_usutel ||'DATAHORA WHERE ICARD = '''|| l_icardA ||'''';
                        SP_CMDTSI(l_comando);
                    EXCEPTION
                        WHEN OTHERS THEN NULL;
                    END;
                END IF;
                
                /* Monta a pendência para o dia anterior a partir das 00:01h */
                l_datAnt := DATETIMEADD(DD, -1, l_datAtu);
                SP_DATSTR(l_datAnt, 'DDMMYY', l_ultRs OUT);
                l_ultRs := CONCAT(l_ultRs, '0001');
                
                /* Atualiza a tabela Controle */
                BEGIN
                    l_comando := 'UPDATE '|| l_usutel ||'CONTROLE SET ULTRS = '''|| l_ultRs ||''' WHERE ICARD = '''|| l_icardA ||'''';
                    SP_CMDTSI(l_comando);
                EXCEPTION
                    WHEN OTHERS THEN NULL;
                END;
                
                /* Cria pendência na tabela Atuali */
                SP_MAPFIS(l_craAti, l_numBar OUT, l_numPro OUT, l_numSma OUT, l_tecPri OUT, l_craPri OUT);

                /* Verifica se possui crachá smart */
                IF l_numSma <> 0 THEN
                    /* Grava Atuali/R600PEN */
                    SP_ATUALI(l_numSma, l_craAti, '59', l_ultRs);
                END IF;
            END IF; /* l_craAti > 0 */
        END IF; /* l_temInt = 'S' */
        
        
        /* não vou gerar a pendência 25 - updateRestTime como a tela G5 faz, pois a Portaria Avançada
         * é responsável por atualizar o Data Mart instantaneamente */
    END IF; /* l_coderr = 0 */
    
    /* retorna Código do erro */
    p_retErr := l_codErr;
END		SENIOR;21 SP_STRTODATE
SP_PESFROMIDTPES
ø␀␀/* Processa demanda de sicronismo - 11 = Liberação de Interjornada (R070LIJ) */
PROCEDURE SP_SINLIJ(P_VALSTR VARCHAR2(255),P_RETERR OUT NUMBER(2))
 IS

    l_codErr     NUMBER(2);
    l_datCon     VARCHAR2(25);
    l_idtPes     VARCHAR2(23);
    l_idtAut     VARCHAR2(23);
    l_datStr     VARCHAR2(16);
    l_pos        NUMBER(3);
    l_tam        NUMBER(3);
    l_obsSij     VARCHAR2(80);
    l_codUsu     NUMBER(10);
    l_datIni     DATE;
    l_horIni     NUMBER(4);
    l_count      NUMBER(1);
    l_temInt     CHAR(1);
    l_temDat     CHAR(1);
    l_craPro     NUMBER(12);
    l_craTit     NUMBER(12);
    l_craAti     NUMBER(12);
    l_craAtiStr  CHAR(12);
    l_datAtu     DATE;
    l_horAtu     NUMBER(4);
    l_staAcc     NUMBER(1);
    
    /*Variáveis auxiliares para desmontar IDTPES do colaborador*/
    l_tipPes     NUMBER(2);
    l_numEmp     NUMBER(4);
    l_tipCol     NUMBER(1);
    l_numCad     NUMBER(9);
    l_tipDoc     NUMBER(1);
    l_numDoc     VARCHAR2(20);
    l_numMat     VARCHAR2(15);
    l_proPac     VARCHAR2(20);
    
    /*Variáveis auxiliares para desmontar IDTPES do autorizador*/
    l_tipPesAut  NUMBER(2);
    l_numEmpAut  NUMBER(4);
    l_tipColAut  NUMBER(1);
    l_numCadAut  NUMBER(9);
    l_tipDocAut  NUMBER(1);
    l_numDocAut  VARCHAR2(20);
    l_numMatAut  VARCHAR2(15);
    l_proPacAut  VARCHAR2(20);
BEGIN
    /* inicializa variáveis */
    l_codErr := 0;
    p_retErr := 0;
    l_count  := 0;
    l_craAti := 0;
    l_codUsu := 0;
    
    /* separa os valores da string do p_valStr em cada variável */
    BEGIN
        l_pos := 3;    
        l_idtPes := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_datStr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
        l_idtAut := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_obsSij := NULL;
        
        l_tam := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_valStr, l_pos, 3)); l_pos := l_pos + 3;        
        IF (l_tam > 0) THEN
            l_obsSij := LTRIM(RTRIM(SUBSTRING(p_valStr, l_pos, l_tam))); l_pos := l_pos + l_tam;

            IF  (l_obsSij = '') THEN
              l_obsSij := NULL;
            END IF;
        END IF;
        
        /* CODUSU */
        l_codUsu := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        
        /* converte data/hora inicial */
        l_datCon := SUBSTRING(l_datStr,1,2) || '/' || SUBSTRING(l_datStr,3,2) ||'/'||SUBSTRING(l_datStr,5,2);
        SP_STRTODATE(l_datCon,'DD/MM/AA', l_datIni OUT);
        l_horIni := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datStr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datStr,9,2)));

        /* desmontar IDTPES do visitante */
        SP_PESFROMIDTPES(l_idtPes, l_tipPes OUT, l_numEmp OUT, l_tipCol OUT, l_numCad OUT, l_tipDoc OUT, l_numDoc OUT, l_numMat OUT, l_proPac OUT);
        
        /* desmontar IDTPES do autorizador */
        SP_PESFROMIDTPES(l_idtAut, l_tipPesAut OUT, l_numEmpAut OUT, l_tipColAut OUT, l_numCadAut OUT, l_tipDocAut OUT, l_numDocAut OUT, l_numMatAut OUT, l_proPacAut OUT);
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 47; /* erro de conversão na string */
    END;
    
    /* Calcula data/hora */
    l_datAtu := CURDATE();
    l_horAtu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  
    /* Calcula o status */
    l_staAcc := 0;
    IF (l_datIni > l_datAtu) OR ((l_datIni = l_datAtu) AND (l_horIni > l_horAtu)) THEN
        l_staAcc := 0; /* liberação futura */
    ELSE
        l_staAcc := 1; /* liberação presente */
    END IF; 

    /* Verifica se tem registro com a mesma chave */
    IF  (l_coderr = 0) THEN
        /* busca autorização de liberação de interjornada */
        BEGIN
            SELECT COUNT(*) INTO l_count FROM R070LIJ WHERE NUMEMP = l_numEmp AND TIPCOL = l_tipCol AND NUMCAD = l_numCad AND DATINI = l_datIni AND HORINI = l_horIni;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN l_count := 0;
            WHEN OTHERS THEN l_count := 0;
        END;
        
        /* se tem a mesma chave, siginifca q foi gravado no mesmo momento */
        /* então só mantem o ultimo número físico */
        IF (l_count > 0) THEN
            /* fecha o histórico anterior do número físico, se existir */
            BEGIN
                UPDATE R070LIJ SET 
                        EMPAUT = l_numEmpAut,
                        TCLAUT = l_tipColAut,
                        CADAUT = l_numCadAut,
                        OBSSIJ = l_obsSij,
                        CODUSU = l_codUsu,
                        STAACC = l_staAcc
                    WHERE
                        NUMEMP = l_numEmp AND
                        TIPCOL = l_tipCol AND
                        NUMCAD = l_numCad AND
                        DATINI = l_datIni AND
                        HORINI = l_horIni;
            EXCEPTION
                WHEN OTHERS THEN l_coderr := 48;
            END;
        ELSE
            BEGIN
                INSERT INTO R070LIJ (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI,
                                     EMPAUT, TCLAUT, CADAUT, OBSSIJ, CODUSU, STAACC)
                             VALUES (l_numEmp, l_tipCol, l_numCad, l_datIni, l_horIni,
                                      l_numEmpAut, l_tipColAut, l_numCadAut, l_obsSij, l_codUsu, l_staAcc);
            EXCEPTION
                WHEN OTHERS THEN l_coderr := 49;
            END;
        END IF;

        /* não vou gerar a pendência 25 - updateRestTime como a tela G5 faz, pois a Portaria Avançada
         * é responsável por atualizar o Data Mart instantaneamente */
    END IF; /* l_coderr = 0 */
    
    /* retorna Código do erro */
    p_retErr := l_codErr;
END		SENIOR;22 SP_STRTODATE
