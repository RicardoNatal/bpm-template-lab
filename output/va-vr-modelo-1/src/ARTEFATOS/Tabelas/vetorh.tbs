   1 TIPLEN, LEE.NUMEMP NUMEMP, LEE.TIPCOL TIPCOL, LEE.NUMCAD NUMCAD, LEE.CODLEN CODLEN, LEE.DATALT 
   DATLEN, FUN.DATADM DATHIS, LEE.DATEXC DATFIM, LEN.LOCFAT, LEN.LOCCOB, LEN.LENFAT
FROM 
   R038LEE LEE, R034FUN FUN, R250TAB TAB, R044LEN LEN, R044CAL CAL
WHERE 
   LEE.NUMEMP = FUN.NUMEMP
   AND LEE.TIPCOL = FUN.TIPCOL
   AND LEE.NUMCAD = FUN.NUMCAD
   AND LEE.DATALT = (SELECT MAX(TAB001.DATALT) FROM R038LEE TAB001 WHERE 
                     TAB001.NUMEMP = LEE.NUMEMP AND
                     TAB001.TIPCOL = LEE.TIPCOL AND
                     TAB001.NUMCAD = LEE.NUMCAD AND
                     TAB001.DATALT <= CAL.FIMCMP)
   AND (LEE.DATEXC = STRTODATE ('1900/12/31') OR LEE.DATEXC > CAL.FIMCMP)
   AND LEN.CODLEN = LEE.CODLEN
   AND CAL.CODCAL = TAB.CODCAL
   AND CAL.NUMEMP = FUN.NUMEMP

UNION 

SELECT 
   2 TIPLEN, LEC.NUMEMP NUMEMP, HCC.TIPCOL TIPCOL, HCC.NUMCAD NUMCAD, LEC.CODLEN CODLEN, LEC.DATALT 
   DATLEN, HCC.DATALT DATHIS, LEC.DATEXC DATFIM, LEN.LOCFAT, LEN.LOCCOB, LEN.LENFAT
FROM 
   R038HCC HCC, R038LEC LEC, R250TAB TAB, R044LEN LEN, R044CAL CAL
WHERE 
   HCC.NUMEMP = LEC.NUMEMP
   AND HCC.CODCCU = LEC.CODCCU
   AND HCC.DATALT = (SELECT MAX(TAB001.DATALT) FROM R038HCC TAB001 WHERE 
                     TAB001.NUMEMP = HCC.NUMEMP AND
                     TAB001.TIPCOL = HCC.TIPCOL AND
                     TAB001.NUMCAD = HCC.NUMCAD AND
                     TAB001.DATALT <= CAL.FIMCMP)
   AND (LEC.DATEXC = STRTODATE ('1900/12/31') OR LEC.DATEXC > CAL.FIMCMP)
   AND LEN.CODLEN = LEC.CODLEN
   AND CAL.CODCAL = TAB.CODCAL
   AND CAL.NUMEMP = LEC.NUMEMP
UNION

SELECT 
   3 TIPLEN, LEL.NUMEMP NUMEMP, HLO.TIPCOL TIPCOL, HLO.NUMCAD NUMCAD, LEL.CODLEN CODLEN, LEL.DATALT 
   DATLEN, HLO.DATALT DATHIS, LEL.DATEXC DATFIM, LEN.LOCFAT, LEN.LOCCOB, LEN.LENFAT
FROM 
   R038HLO HLO, R038LEL LEL, R250TAB TAB, R044LEN LEN, R044CAL CAL
WHERE 
   HLO.NUMEMP = LEL.NUMEMP
   AND HLO.TABORG = LEL.TABORG
   AND HLO.NUMLOC = LEL.NUMLOC
   AND HLO.DATALT = (SELECT MAX(TAB001.DATALT) FROM R038HLO TAB001 WHERE 
                     TAB001.NUMEMP = HLO.NUMEMP AND
                     TAB001.TIPCOL = HLO.TIPCOL AND
                     TAB001.NUMCAD = HLO.NUMCAD AND
                     TAB001.DATALT <= CAL.FIMCMP)
   AND (LEL.DATEXC = STRTODATE ('1900/12/31') OR LEL.DATEXC > CAL.FIMCMP)
   AND LEN.CODLEN = LEL.CODLEN
   AND CAL.CODCAL = TAB.CODCAL
   AND CAL.NUMEMP = LEL.NUMEMP

UNION

SELECT 
   4 TIPLEN, LEF.NUMEMP NUMEMP, HFI.TIPCOL TIPCOL, HFI.NUMCAD NUMCAD, LEF.CODLEN CODLEN, LEF.DATALT 
   DATLEN, HFI.DATALT DATHIS, STRTODATE ('1900/12/31') DATFIM, LEN.LOCFAT, LEN.LOCCOB, LEN.LENFAT
FROM 
   R038HFI HFI, R038LEF LEF, R044LEN LEN, R250TAB TAB, R044CAL CAL
WHERE 
   HFI.NUMEMP = LEF.NUMEMP
   AND HFI.CODFIL = LEF.CODFIL
   AND HFI.DATALT = (SELECT MAX(TAB001.DATALT) FROM R038HFI TAB001 WHERE 
                     TAB001.NUMEMP = HFI.NUMEMP AND
                     TAB001.TIPCOL = HFI.TIPCOL AND
                     TAB001.NUMCAD = HFI.NUMCAD AND
                     TAB001.DATALT <= CAL.FIMCMP)
   AND LEN.CODLEN = LEF.CODLEN
   AND CAL.CODCAL = TAB.CODCAL
   AND CAL.NUMEMP = LEF.NUMEMP
   AND LEF.DATALT = (SELECT MAX(TAB002.DATALT) FROM R038LEF TAB002 WHERE
                     TAB002.NUMEMP = LEF.NUMEMP AND
                     TAB002.CODFIL = LEF.CODFIL AND
                     TAB002.DATALT <= CAL.FIMCMP)␀␀ÿ]␀a␀Š␀␀␀␀␀␀␀␀␀ÿ½␀¿␀n␀␀Æÿ␀␀ÿ␀ó¥␀␀´␀	␀␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀W␀Š␀	␀␀␀␀␀␀␀␀O␀t␀Ü␀n¼‡␀Æÿ␀␀ÿ␀ê¥␀␀Ì␀	␀␀␀␀␀␀␀␀.%0.0.w¼‡␀Æÿ␀␀ÿ␀'#´␀␀␀␀␀␀␀␀␀Ãš␀␀“š␀␀“š␀␀q␀Æÿ␀␀ÿ␀VCÑ␀	␀␀␀␀␀␀␀␀:I¼şEqC␀êÿ␀␀ÿ␀RCÑ␀␀␀␀␀␀␀␀␀€JëîEqCÈ‡␀êÿ␀␀ÿ␀PCÑ␀␀␀␀␀␀␀␀␀‰I£F£FqC␀êÿ␀␀ÿ␀Y—␀␀´␀␀␀␀␀␀␀␀␀Ëš␀␀m—š␀␀q␀Æÿ␀␀ÿ␀X—␀␀´␀␀␀␀␀␀␀␀␀¿š␀␀»+š␀␀q␀Æÿ␀␀ÿ␀8—␀␀´␀␀␀␀␀␀␀␀␀Äš␀␀™d”š␀␀q␀Æÿ␀␀ÿ␀␀e␀␀ SELECT 
  TIPLEN,
  NUMEMP,
  TIPCOL, 
  NUMCAD,
  CODLEN,
  DATLEN,
  DATHIS,
  DATFIM,
  LOCFAT,
  LOCCOB,
  LENFAT  
FROM
  VBS_LOCENTA
WHERE
  TIPLEN = (SELECT MIN(A.TIPLEN) FROM VBS_LOCENTA A
            WHERE A.NUMEMP = VBS_LOCENTA.NUMEMP AND
            A.TIPCOL = VBS_LOCENTA.TIPCOL AND 
            A.NUMCAD = VBS_LOCENTA.NUMCAD)VBS_LOCENTA
␀ÿ¹␀ó¥␀␀´␀	␀␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀#	␀␀␀␀␀␀␀␀@Ø!)b␀ˆ␀␀ÿ␀␀ÿ␀c`´␀	␀␀␀␀␀␀␀␀÷<ïe»fr␀Æÿ␀␀ÿ␀#4	␀␀␀␀␀␀␀␀ÿ?µ'µ'}␀␀ÿ␀␀ÿ␀"Ñ␀	␀␀␀␀␀␀␀␀;MÙEÙEqC␀êÿ␀␀ÿ␀r␀­␀	␀␀␀␀␀␀␀␀³B␀␀pM‡␀Æÿ␀␀ÿ␀␀␀␀ SELECT 
R087QUD.NUMEMP NUMEMP,
R087QUD.CODCCU CODCCU,
R087QUD.ESTCAR ESTCAR,
R087QUD.CODCAR CODCAR,
R087QUD.CMPQUA CMPQUA,
R087QUD.TIPVAG TIPVAG
FROM 	
R087QUD,R080PAR
WHERE
R087QUD.CMPQUA = (SELECT MAX(QUD.CMPQUA) FROM R087QUD QUD WHERE
                         QUD.NUMEMP = R087QUD.NUMEMP AND
                         QUD.CODCCU = R087QUD.CODCCU AND
                         QUD.ESTCAR = R087QUD.ESTCAR AND 
                         QUD.CODCAR = R087QUD.CODCAR AND
                         QUD.TIPVAG = R087QUD.TIPVAG AND 
                         QUD.CMPQUA <= R080PAR.DATREF) AND
NOT EXISTS (SELECT 1 FROM R087EFD WHERE
R087EFD.NUMEMP = R087QUD.NUMEMP AND
R087EFD.CODCCU = R087QUD.CODCCU AND
R087EFD.ESTCAR = R087QUD.ESTCAR AND
R087EFD.CODCAR = R087QUD.CODCAR AND
R087EFD.TIPVAG = R087QUD.TIPVAG AND
R087EFD.CMPQUA > R087QUD.CMPQUA AND
R087EFD.CMPQUA <= R080PAR.DATREF)

UNION 
SELECT 
R087EFD.NUMEMP NUMEMP,
R087EFD.CODCCU CODCCU,
R087EFD.ESTCAR ESTCAR,
R087EFD.CODCAR CODCAR,
R087EFD.CMPQUA CMPQUA,
R087EFD.TIPVAG TIPVAG
FROM 	
R087EFD,R080PAR
WHERE
R087EFD.CMPQUA = (SELECT MAX(EFD.CMPQUA) FROM R087EFD EFD WHERE
                         EFD.NUMEMP = R087EFD.NUMEMP AND
                         EFD.CODCCU = R087EFD.CODCCU AND
                         EFD.ESTCAR = R087EFD.ESTCAR AND 
                         EFD.CODCAR = R087EFD.CODCAR AND
                         EFD.TIPVAG = R087EFD.TIPVAG AND 
                         EFD.CMPQUA <= R080PAR.DATREF) AND
NOT EXISTS (SELECT 1 FROM R087QUD WHERE
R087QUD.NUMEMP = R087EFD.NUMEMP AND
R087QUD.CODCCU = R087EFD.CODCCU AND
R087QUD.ESTCAR = R087EFD.ESTCAR AND
R087QUD.CODCAR = R087EFD.CODCAR AND
R087QUD.TIPVAG = R087EFD.TIPVAG AND
R087QUD.CMPQUA > R087EFD.CMPQUA AND
R087QUD.CMPQUA <= R080PAR.DATREF)␀␀ÿ‘␀‰¸␀␀Š␀␀␀␀␀␀␀␀␀Â␀␀Â␀␀Â␀␀n␀␀Æÿ␀␀ÿ␀ó¥␀␀´␀	␀␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀W␀t	␀␀␀␀␀␀␀␀Ù␀t␀Ü␀n¼‡␀Æÿ␀␀ÿ␀ê¥␀␀Ì␀	␀␀␀␀␀␀␀␀.%€$0.w¼‡␀Æÿ␀␀ÿ␀Z␀Š␀␀␀␀␀␀␀␀␀0␀0␀0␀n␀␀Æÿ␀␀ÿ␀ñ¥␀␀(␀␀␀␀␀␀␀␀L±␀␀L±␀␀L±␀␀1␀␀␀ÿ␀␀ÿ␀t␀±␀␀␀␀␀␀␀␀␀␀␀␀q␀␀Æÿ␀␀ÿ␀(␀´␀␀␀␀␀␀␀␀␀>½␀␀r␀Æÿ␀␀ÿ␀ù¥␀␀Ì␀␀␀␀␀␀␀␀␀İ«␀␀Û«␀␀Û«␀␀m$ˆ␀Æÿ␀␀ÿ␀ü¸␀␀y␀␀␀␀␀␀␀␀3Ä␀␀1Ä␀␀3Ä␀␀~‡␀␀ÿ␀␀ÿ␀(#␀␀␀␀␀␀␀␀Ö@‘;Í@"␀␀ÿ␀␀ÿ␀Ö¥␀␀U␀␀␀␀␀␀␀␀n©␀␀ç§␀␀ç§␀␀Vë‡␀␀ÿ␀␀ÿ␀ğ¥␀␀–␀	␀␀␀␀␀␀␀␀>±␀␀)8)8n␀Æÿ␀␀ÿ␀:CÑ␀	␀␀␀␀␀␀␀␀âLŞEŞEqC␀êÿ␀␀ÿ␀»u·␀	␀␀␀␀␀␀␀␀Àyxxì*␀␀Æÿ␀␀ÿ␀š÷␀␀­␀	␀␀␀␀␀␀␀␀£ÿ␀␀xş␀␀xş␀␀p␀Æÿ␀␀ÿ␀,#·␀␀␀␀␀␀␀␀␀\A“␀“␀s␀Æÿ␀␀ÿ␀9#·␀␀␀␀␀␀␀␀␀(@¥.¥.u␀Æÿ␀␀ÿ␀"#­␀␀␀␀␀␀␀␀␀-=PqPqp␀Æÿ␀␀ÿ␀É␀␀˜␀␀␀␀␀␀␀␀␀=Í␀␀°Ë␀␀°Ë␀␀e)␀␀Æÿ␀␀ÿ␀{²␀␀Å␀␀␀␀␀␀␀␀ú¶␀␀Ã¶␀␀ú¶␀␀c␀␀␀ÿ␀␀ÿ␀DCÑ␀␀␀␀␀␀␀␀␀ JFJqC␀êÿ␀␀ÿ␀6#±␀␀␀␀␀␀␀␀␀³=øî␀␀øî␀␀q␀Æÿ␀␀ÿ␀ö␀c	␀␀␀␀␀␀␀␀␀ù␀␀n␀Æÿ␀␀ÿ␀(␀˜␀␀␀␀␀␀␀␀␀®"␀Ù!␀®"␀e)␀␀Æÿ␀␀ÿ␀³C®␀␀␀␀␀␀␀␀«]Ÿ]Ÿ]c␀␀␀ÿ␀␀ÿ␀␀2␀␀ SELECT
1 AS PESMAR,
FUN.NUMEMP NUMEMP,
FUN.TIPCOL TIPCOL,
FUN.NUMCAD NUMCAD,
0  TIPDOC,
'0'  NUMDOC,
0  TIPVIS,
HLO.TABORG TABORG,
HLO.NUMLOC NUMLOC,
HIE.POSLOC POSLOC,
HIE.CODLOC CODLOC,
FUN.NOMFUN  NOMPES,
ACC.NUMCRA NUMCRA,
ACC.DATACC DATACC,
ACC.HORACC HORACC,
ACC.SEQACC SEQACC,
ACC.CODPLT CODPLT,
ACC.CODRLG CODRLG,
ACC.CODFNC CODFNC,
ACC.QTDACC QTDACC,
ACC.ORIACC ORIACC,
ACC.DATAPU DATAPU,
ACC.CODREF CODREF,
ACC.USOREF USOREF,
ACC.VALREF VALREF,
ACC.DIRACC DIRACC
FROM
((((R034FUN FUN INNER JOIN R070ACC ACC ON ACC.NUMEMP = FUN.NUMEMP AND ACC.TIPCOL = FUN.TIPCOL AND ACC.NUMCAD = FUN.NUMCAD)
  INNER JOIN R038HLO HLO ON FUN.NUMEMP = HLO.NUMEMP AND FUN.TIPCOL = HLO.TIPCOL AND FUN.NUMCAD = HLO.NUMCAD)
  INNER JOIN R016HIE HIE ON HLO.TABORG = HIE.TABORG AND HLO.NUMLOC = HIE.NUMLOC) 
  INNER JOIN R154RHR RHR ON ACC.DATACC BETWEEN RHR.DATINI AND RHR.DATFIM)
WHERE
HIE.DATINI <= RHR.DATFIM AND
HIE.DATFIM >= RHR.DATFIM
AND HLO.DATALT = (SELECT MAX(datalt) COL_0
                               FROM  r038hlo a
                               WHERE  FUN.numemp = a.numemp AND FUN.tipcol = a.tipcol AND FUN.numcad = a.numcad AND a.datalt <= RHR.datfim) AND
ACC.USOMAR IN (3,4)
AND ACC.CODREF <> 0

UNION ALL
(SELECT
2 AS PESMAR,
OCR.NUMEMP NUMEMP,
5  TIPCOL ,
OCR.NUMCAD NUMCAD,
0  TIPDOC,
'0'  NUMDOC,
0  TIPVIS,
OCR.TABORG TABORG,
OCR.NUMLOC NUMLOC,
HIE.POSLOC POSLOC,
HIE.CODLOC CODLOC, 
OCR.NOMCRA  NOMPES,
ACC.NUMCRA NUMCRA,
ACC.DATACC DATACC,
ACC.HORACC HORACC,
ACC.SEQACC SEQACC,
ACC.CODPLT CODPLT,
ACC.CODRLG CODRLG,
ACC.CODFNC CODFNC,
ACC.QTDACC QTDACC,
ACC.ORIACC ORIACC,
ACC.DATAPU DATAPU,
ACC.CODREF CODREF,
ACC.USOREF USOREF,
ACC.VALREF VALREF,
ACC.DIRACC DIRACC
FROM (((((R070ACC ACC INNER JOIN R070HCH HCH ON ACC.NUMCRA = HCH.NUMCRA)
      INNER JOIN R070OCR OCR ON HCH.NUMEMP = OCR.NUMEMP AND HCH.NUMCAD = OCR.NUMCAD)
      INNER JOIN R016HIE HIE ON OCR.TABORG = HIE.TABORG AND OCR.NUMLOC = HIE.NUMLOC)
      INNER JOIN R154RHR RHR ON ACC.DATACC BETWEEN RHR.DATINI AND RHR.DATFIM)
      INNER JOIN R070TAC TAC ON ACC.TIPACC = TAC.TIPACC)
WHERE
ACC.USOMAR IN (3,4)
AND TAC.CONAPU = 'S'
AND ((ACC.DATACC > HCH.DATINI) OR (ACC.DATACC = HCH.DATINI AND ACC.HORACC >= HCH.HORINI))
AND ((ACC.DATACC < HCH.DATFIM) OR (ACC.DATACC = HCH.DATFIM AND (HCH.HORFIM = 0 OR ACC.HORACC <= HCH.HORFIM)) OR HCH.DATFIM = DAY(1900,12,31))
AND HIE.DATINI <= RHR.DATFIM
AND HIE.DATFIM >= RHR.DATFIM

UNION ALL
(SELECT
3 AS PESMAR,
MVI.NUMEMP NUMEMP,
MVI.TIPCOL TIPCOL,
MVI.NUMCAD NUMCAD,
VIS.TIPDOC TIPDOC,
VIS.NUMDOC NUMDOC,
MVI.TIPVIS TIPVIS,
MVI.TABORG TABORG,
MVI.NUMLOC NUMLOC,
HIE.POSLOC POSLOC,
HIE.CODLOC CODLOC,
VIS.NOMVIS  NOMPES,
ACC.NUMCRA NUMCRA,
ACC.DATACC DATACC,
ACC.HORACC HORACC,
ACC.SEQACC SEQACC,
ACC.CODPLT CODPLT,
ACC.CODRLG CODRLG,
ACC.CODFNC CODFNC,
ACC.QTDACC QTDACC,
ACC.ORIACC ORIACC,
ACC.DATAPU DATAPU,
ACC.CODREF CODREF,
ACC.USOREF USOREF,
ACC.VALREF VALREF,
ACC.DIRACC DIRACC
FROM ((((((R090VIS VIS INNER JOIN R090MVI MVI ON VIS.TIPDOC = MVI.TIPDOC AND VIS.NUMDOC = MVI.NUMDOC)
      INNER JOIN R034FUN FUN ON FUN.NUMEMP = MVI.NUMEMP AND FUN.TIPCOL = MVI.TIPCOL AND FUN.NUMCAD = MVI.NUMCAD)
      INNER JOIN R070ACC ACC ON ACC.NUMCRA = MVI.NUMCRA)
      INNER JOIN R154RHR RHR ON ACC.DATACC BETWEEN RHR.DATINI AND RHR.DATFIM)
      INNER JOIN R070TAC TAC ON ACC.TIPACC = TAC.TIPACC)
      INNER JOIN R016HIE HIE ON HIE.TABORG = MVI.TABORG AND HIE.NUMLOC = MVI.NUMLOC)
WHERE
TAC.CONAPU = 'S'
AND ACC.USOMAR IN (3,4)
AND ((ACC.DATACC > MVI.DATENT)
OR (ACC.DATACC = MVI.DATENT AND ACC.HORACC >= MVI.HORENT))
AND ((ACC.DATACC < MVI.DATSAI)
OR (ACC.DATACC = MVI.DATSAI AND (MVI.HORSAI = 0 OR ACC.HORACC <= MVI.HORSAI))
OR MVI.DATSAI = DAY(1900,12,31))
AND HIE.DATINI <= RHR.DATFIM
AND HIE.DATFIM >= RHR.DATFIM

UNION ALL
(SELECT
3 AS PESMAR,
MVI.NUMEMP NUMEMP,
MVI.TIPCOL TIPCOL,
MVI.NUMCAD NUMCAD,
VIS.TIPDOC TIPDOC,
VIS.NUMDOC NUMDOC,
MVI.TIPVIS TIPVIS,
MVI.TABORG TABORG,
MVI.NUMLOC NUMLOC,
HIE.POSLOC POSLOC,
HIE.CODLOC CODLOC,
VIS.NOMVIS NOMPES,
ACC.NUMCRA NUMCRA,
ACC.DATACC DATACC,
ACC.HORACC HORACC,
ACC.SEQACC SEQACC,
ACC.CODPLT CODPLT,
ACC.CODRLG CODRLG,
ACC.CODFNC CODFNC,
ACC.QTDACC QTDACC,
ACC.ORIACC ORIACC,
ACC.DATAPU DATAPU,
ACC.CODREF CODREF,
ACC.USOREF USOREF,
ACC.VALREF VALREF,
ACC.DIRACC DIRACC
FROM (((((((R090VIS VIS INNER JOIN R090ACO ACO ON VIS.TIPDOC = ACO.TIPDOC AND VIS.NUMDOC = ACO.NUMDOC)
      INNER JOIN R090MVI MVI ON MVI.DATENT = ACO.DATENT AND MVI.HORENT = ACO.HORENT AND MVI.SEQENT = ACO.SEQENT)
      INNER JOIN R034FUN FUN ON FUN.NUMEMP = MVI.NUMEMP AND FUN.TIPCOL = MVI.TIPCOL AND FUN.NUMCAD = MVI.NUMCAD)
      INNER JOIN R070ACC ACC ON ACC.NUMCRA = ACO.NUMCRA)
      INNER JOIN R154RHR RHR ON ACC.DATACC BETWEEN RHR.DATINI AND RHR.DATFIM)
      INNER JOIN R070TAC TAC ON ACC.TIPACC = TAC.TIPACC)
      INNER JOIN R016HIE HIE ON HIE.TABORG = MVI.TABORG AND HIE.NUMLOC = MVI.NUMLOC)
WHERE
TAC.CONAPU = 'S'
AND ACC.USOMAR IN (3,4)
AND ((ACC.DATACC > ACO.DATENT) OR (ACC.DATACC = ACO.DATENT AND ACC.HORACC >= ACO.HORENT))
AND ((ACC.DATACC < ACO.DATSAI)
OR (ACC.DATACC = ACO.DATSAI AND (ACO.HORSAI = 0 OR ACC.HORACC <= ACO.HORSAI))
OR ACO.DATSAI = DAY(1900,12,31))
AND HIE.DATINI <= RHR.DATFIM
AND HIE.DATFIM >= RHR.DATFIM

UNION ALL
(SELECT
3 AS PESMAR,
MGV.NUMEMP NUMEMP,
MGV.TIPCOL TIPCOL,
MGV.NUMCAD NUMCAD,
0  TIPDOC,
'0' NUMDOC,
0 TIPVIS,
MGV.TABORG TABORG,
MGV.NUMLOC NUMLOC,
HIE.POSLOC POSLOC,
HIE.CODLOC CODLOC,
HCG.NOMVIS  NOMPES,
ACC.NUMCRA NUMCRA,
ACC.DATACC DATACC,
ACC.HORACC HORACC,
ACC.SEQACC SEQACC,
ACC.CODPLT CODPLT,
ACC.CODRLG CODRLG,
ACC.CODFNC CODFNC,
ACC.QTDACC QTDACC,
ACC.ORIACC ORIACC,
ACC.DATAPU DATAPU,
ACC.CODREF CODREF,
ACC.USOREF USOREF,
ACC.VALREF VALREF,
ACC.DIRACC DIRACC
FROM ((((((R090MGV MGV INNER JOIN R090HCG HCG ON MGV.DATENT = HCG.DATENT AND MGV.HORENT = HCG.HORENT AND MGV.SEQENT = HCG.SEQENT AND MGV.GRUVIS = HCG.GRUVIS)
      INNER JOIN R034FUN FUN ON FUN.NUMEMP = MGV.NUMEMP AND FUN.TIPCOL = MGV.TIPCOL AND FUN.NUMCAD = MGV.NUMCAD)
      INNER JOIN R070ACC ACC ON ACC.NUMCRA = HCG.NUMCRA)
      INNER JOIN R154RHR RHR ON ACC.DATACC BETWEEN RHR.DATINI AND RHR.DATFIM)
      INNER JOIN R070TAC TAC ON ACC.TIPACC = TAC.TIPACC)
      INNER JOIN R016HIE HIE ON HIE.TABORG = MGV.TABORG AND HIE.NUMLOC = MGV.NUMLOC)
WHERE
TAC.CONAPU = 'S'
AND ACC.USOMAR IN (3,4)
AND ((ACC.DATACC > MGV.DATENT) OR (ACC.DATACC = MGV.DATENT AND ACC.HORACC >= MGV.HORENT))
AND ((ACC.DATACC < MGV.DATSAI)
OR (ACC.DATACC = MGV.DATSAI AND (MGV.HORSAI = 0 OR ACC.HORACC <= MGV.HORSAI))
OR MGV.DATSAI = DAY(1900,12,31))
AND HIE.DATINI <= RHR.DATFIM
AND HIE.DATFIM >= RHR.DATFIM

UNION ALL
(SELECT
4 AS PESMAR,
CEX.NUMEMP NUMEMP,
CEX.TIPCOL TIPCOL,
CEX.NUMCAD NUMCAD,
0  TIPDOC,
'0'  NUMDOC,
0  TIPVIS,
CEX.TABORG TABORG,
CEX.NUMLOC NUMLOC,
HIE.POSLOC POSLOC,
HIE.CODLOC CODLOC,
CEX.NOMCAN NOMPES,
ACC.NUMCRA NUMCRA,
ACC.DATACC DATACC,
ACC.HORACC HORACC,
ACC.SEQACC SEQACC,
ACC.CODPLT CODPLT,
ACC.CODRLG CODRLG,
ACC.CODFNC CODFNC,
ACC.QTDACC QTDACC,
ACC.ORIACC ORIACC,
ACC.DATAPU DATAPU,
ACC.CODREF CODREF,
ACC.USOREF USOREF,
ACC.VALREF VALREF,
ACC.DIRACC DIRACC
FROM (((((R122CEX CEX 
     INNER JOIN R091MCA MCA ON CEX.NUMCAN = MCA.NUMCAN)
     INNER JOIN R070ACC ACC ON ACC.NUMCRA = MCA.NUMCRA)
     INNER JOIN R154RHR RHR ON ACC.DATACC BETWEEN RHR.DATINI AND RHR.DATFIM)
     INNER JOIN R070TAC TAC ON ACC.TIPACC = TAC.TIPACC)
     INNER JOIN R016HIE HIE ON HIE.TABORG = CEX.TABORG AND HIE.NUMLOC = CEX.NUMLOC)
WHERE
HIE.DATINI <= RHR.DATFIM
AND HIE.DATFIM >= RHR.DATFIM
AND TAC.CONAPU = 'S'
AND ACC.USOMAR IN (3, 4)
AND ((ACC.DATACC > MCA.DATENT) OR (ACC.DATACC = MCA.DATENT AND ACC.HORACC >= MCA.HORENT))
AND ((ACC.DATACC < MCA.DATSAI)
OR (ACC.DATACC = MCA.DATSAI AND (MCA.HORSAI = 0 OR ACC.HORACC <= MCA.HORSAI))
OR MCA.DATSAI = DAY(1900,12,31)
))))))␀␀ÿ­␀3#±␀	␀␀␀␀␀␀␀␀7AŒÍ␀␀¤:q␀Æÿ␀␀ÿ␀ Cc␀␀␀␀␀␀␀␀BYûUBY`␀␀ÿ␀␀ÿ␀*#±␀	␀␀␀␀␀␀␀␀z=8¿␀␀¤:q␀Æÿ␀␀ÿ␀CS␀␀␀␀␀␀␀␀JXøUİW8␀␀ÿ␀␀ÿ␀#±␀␀␀␀␀␀␀␀␀ØA¬±q␀Æÿ␀␀ÿ␀k␀␀␀␀␀␀␀␀␀␀™QÉ␀É␀c␀␀␀ÿ␀␀ÿ␀šCo␀␀␀␀␀␀␀␀µPVÕWi␀␀ÿ␀␀ÿ␀A#±␀␀␀␀␀␀␀␀␀>Ç␀=␀q␀Æÿ␀␀ÿ␀2#¼␀	␀␀␀␀␀␀␀␀‰=ÙÁ␀␀ÙÁ␀␀v␀Æÿ␀␀ÿ␀¡÷␀␀­␀	␀␀␀␀␀␀␀␀?ÿ␀␀?ü␀␀xş␀␀p␀Æÿ␀␀ÿ␀Lì␀␀C␀␀␀␀␀␀␀␀–ó␀␀•ó␀␀•ó␀␀A␀␀ÿ␀␀ÿ␀)␀‘␀␀␀␀␀␀␀␀␀×$␀Õ$␀Õ$␀•)␀␀Æÿ␀␀ÿ␀g²␀␀7␀␀␀␀␀␀␀␀‚´␀␀"³␀␀´␀␀6␀␀ÿ␀␀ÿ␀\CÑ␀␀␀␀␀␀␀␀␀N~N~NqC␀êÿ␀␀ÿ␀8#­␀	␀␀␀␀␀␀␀␀ä=Šó␀␀¤:p␀Æÿ␀␀ÿ␀£C%␀␀␀␀␀␀␀␀YXVôW7␀␀ÿ␀␀ÿ␀B#±␀␀␀␀␀␀␀␀␀>È␀>␀q␀Æÿ␀␀ÿ␀Iì␀␀␀␀␀␀␀␀␀␀␀,Š␀␀gó␀␀c␀␀␀ÿ␀␀ÿ␀*␀‘␀␀␀␀␀␀␀␀␀Ö$␀Õ$␀Õ$␀•)␀␀Æÿ␀␀ÿ␀÷␀␀·␀␀␀␀␀␀␀␀␀7ÿ␀␀0ü␀␀ëÿ␀␀s␀Æÿ␀␀ÿ␀ó¥␀␀´␀	␀␀␀␀␀␀␀␀½<Xb±br␀Æÿ␀␀ÿ␀W␀Š␀	␀␀␀␀␀␀␀␀é␀t␀ë␀n␀Æÿ␀␀ÿ␀ê¥␀␀Ì␀	␀␀␀␀␀␀␀␀7%€$®$w␀Æÿ␀␀ÿ␀!#¼␀␀␀␀␀␀␀␀␀^=nÄ«␀␀rˆ␀Æÿ␀␀ÿ␀(␀´␀␀␀␀␀␀␀␀␀>½␀¶␀␀r␀Æÿ␀␀ÿ␀ù¥␀␀Ì␀␀␀␀␀␀␀␀␀İ«␀␀€š␀␀¬š␀␀m$ˆ␀Æÿ␀␀ÿ␀c`´␀␀␀␀␀␀␀␀␀÷<ïe»fr␀Æÿ␀␀ÿ␀#4␀␀␀␀␀␀␀␀Aµ'×«␀␀}␀ˆ␀␀ÿ␀␀ÿ␀I#Š␀␀␀␀␀␀␀␀␀␀␀␀n␀Æÿ␀␀ÿ␀#␀␀␀␀␀␀␀␀AØ!Ù«␀␀b␀ˆ␀␀ÿ␀␀ÿ␀$#±␀␀␀␀␀␀␀␀␀7=:v:vq␀Æÿ␀␀ÿ␀=#´␀␀␀␀␀␀␀␀␀UA‚␀‚␀rÖ‡␀Æÿ␀␀ÿ␀q␀␀␀␀␀␀␀␀␀␀©␀␀Ÿ␀␀Ÿ␀␀c␀Õ‡␀␀ÿ␀␀ÿ␀+É␀␀␀␀␀␀␀␀␀␀␀␀␀á␀ê␀c␀␀␀ÿ␀␀ÿ␀ü¸␀␀y␀␀␀␀␀␀␀␀2Ä␀␀1Ä␀␀1Ä␀␀~‡␀␀ÿ␀␀ÿ␀TCÑ␀␀␀␀␀␀␀␀␀-N]GºNqC␀êÿ␀␀ÿ␀`CÑ␀␀␀␀␀␀␀␀␀RNƒNOqC␀êÿ␀␀ÿ␀Ã÷␀␀␀␀␀␀␀␀␀␀␀!␀Ş␀æ␀c␀␀␀ÿ␀␀ÿ␀n␀␀␀␀␀␀␀␀␀␀iQt␀Ê␀c␀␀␀ÿ␀␀ÿ␀Co␀␀␀␀␀␀␀␀áWùUáWi␀␀ÿ␀␀ÿ␀␀Ñ␀␀ SELECT /* PESQUISA ABERTA*/
  R210QUE.CODQUE, R210QUE.DESQUE,
  R210PER.CODPER, R210PER.DESPER, R210PER.CODASS, R210PER.TIPPEQ, R210PER.DESOBS, R210PER.CODTBN CODTBNPER,
  R211PER.CODPSQ, R211PER.SEQPSQ, R211PER.RESSUB, R211PER.VALRES VALRESPER, R211PER.OBSRES, R211PER.DATRES,
  R210RES.CODRES, R210RES.DESRES, R210RES.CODTBN CODTBNRES,
  R211RES.RESASS, R211RES.VALRES VALRESRES,
  R211PAP.SEQIDE, R211PAP.NUMEMP, R211PAP.TIPCOL, R211PAP.NUMCAD, R038HFI.CODFIL, R038HLO.TABORG, R038HLO.NUMLOC, 
  R038HCA.ESTCAR, R038HCA.CODCAR, R006ESC.TURESC CODTUR, R038HCC.CODCCU, R024CAR.CODHIE, R038HSI.CODSIN, R034FUN.TIPSEX, R211IDP.QUECON,
  R016HIE.POSLOC,
  R211DEF.DATINI, R211DEF.DATTER, R211DEF.SITPSQ,
  R211PSQ.TIPPSQ, R211PSQ.DESPSQ
FROM
  (R211PER LEFT OUTER JOIN (R211RES LEFT OUTER JOIN R210RES ON R211RES.CODQUE = R210RES.CODQUE AND
  R211RES.CODPER = R210RES.CODPER AND
  R211RES.CODRES = R210RES.CODRES) ON R211PER.CODPSQ = R211RES.CODPSQ AND
  R211PER.SEQPSQ = R211RES.SEQPSQ AND
  R211PER.SEQIDE = R211RES.SEQIDE AND
  R211PER.CODQUE = R211RES.CODQUE AND
  R211PER.CODPER = R211RES.CODPER),
  R211PAP, 
  R211IDP, 
  R210PER, 
  R210QUE, 
  R211DEF, 
  R211PSQ, 
  R016HIE, 
  R038HFI, 
  (R038HLO LEFT OUTER JOIN R038HCC ON R038HCC.NUMEMP = R038HLO.NUMEMP AND
                                      R038HCC.TIPCOL = R038HLO.TIPCOL AND
                                      R038HCC.NUMCAD = R038HLO.NUMCAD), 
  R038HCA, 
  R024CAR, 
  R038HES,
  R006ESC,  
  (R034FUN LEFT OUTER JOIN R038HSI ON R038HSI.NUMEMP = R034FUN.NUMEMP AND
                                      R038HSI.TIPCOL = R034FUN.TIPCOL AND
                                      R038HSI.NUMCAD = R034FUN.NUMCAD)
WHERE
  R211PER.CODQUE = R210QUE.CODQUE AND
  R211PER.CODQUE = R210PER.CODQUE AND
  R211PER.CODPER = R210PER.CODPER AND
  R211PER.CODPSQ = R211PAP.CODPSQ AND
  R211PER.SEQPSQ = R211PAP.SEQPSQ AND
  R211PER.SEQIDE = R211PAP.SEQIDE AND
  R211PER.CODPSQ = R211DEF.CODPSQ AND
  R211PER.SEQPSQ = R211DEF.SEQPSQ AND
  R211PER.CODPSQ = R211PSQ.CODPSQ AND
  R211PAP.CODPSQ = R211IDP.CODPSQ AND
  R211PAP.SEQPSQ = R211IDP.SEQPSQ AND
  R211PAP.SEQIDE = R211IDP.SEQIDE AND
  /* ================ HISTÓRICOS ================== */
  /* FILIAL*/
  R211PAP.NUMEMP = R038HFI.NUMEMP AND
  R211PAP.TIPCOL = R038HFI.TIPCOL AND
  R211PAP.NUMCAD = R038HFI.NUMCAD AND
  (R038HFI.DATALT = (SELECT MAX(DATALT) FROM R038HFI HFI
                          WHERE HFI.NUMEMP = R038HFI.NUMEMP
                            AND HFI.TIPCOL = R038HFI.TIPCOL
                            AND HFI.NUMCAD = R038HFI.NUMCAD
                            AND HFI.DATALT <= R211DEF.DATTER)) AND
  /* LOCAL */
  R211PAP.NUMEMP = R038HLO.NUMEMP AND
  R211PAP.TIPCOL = R038HLO.TIPCOL AND
  R211PAP.NUMCAD = R038HLO.NUMCAD AND
  (R038HLO.DATALT = (SELECT MAX(DATALT) FROM R038HLO HLO
                          WHERE HLO.NUMEMP = R038HLO.NUMEMP
                            AND HLO.TIPCOL = R038HLO.TIPCOL
                            AND HLO.NUMCAD = R038HLO.NUMCAD
                            AND HLO.DATALT <= R211DEF.DATTER)) AND
  R038HLO.TABORG = R016HIE.TABORG AND
  R038HLO.NUMLOC = R016HIE.NUMLOC AND
  R016HIE.DATINI <= R211DEF.DATTER AND
  R016HIE.DATFIM >= R211DEF.DATTER AND
  /* CARGO */
  R211PAP.NUMEMP = R038HCA.NUMEMP AND
  R211PAP.TIPCOL = R038HCA.TIPCOL AND
  R211PAP.NUMCAD = R038HCA.NUMCAD AND
  (R038HCA.DATALT = (SELECT MAX(DATALT) FROM R038HCA HCA
                          WHERE HCA.NUMEMP = R038HCA.NUMEMP
                            AND HCA.TIPCOL = R038HCA.TIPCOL
                            AND HCA.NUMCAD = R038HCA.NUMCAD
                            AND HCA.DATALT <= R211DEF.DATTER)) AND
  /* HIERARQUIA */
  R024CAR.ESTCAR = R038HCA.ESTCAR AND
  R024CAR.CODCAR = R038HCA.CODCAR AND
  /* ESCALA */
  R211PAP.NUMEMP = R038HES.NUMEMP AND
  R211PAP.TIPCOL = R038HES.TIPCOL AND
  R211PAP.NUMCAD = R038HES.NUMCAD AND
  (R038HES.DATALT = (SELECT MAX(DATALT) FROM R038HES HES
                          WHERE HES.NUMEMP = R038HES.NUMEMP
                            AND HES.TIPCOL = R038HES.TIPCOL
                            AND HES.NUMCAD = R038HES.NUMCAD
                            AND HES.DATALT <= R211DEF.DATTER)) AND
  /* TURNO */
  R006ESC.CODESC = R038HES.CODESC AND
  /* CENTRO DE CUSTO */
  (R038HCC.DATALT IS NULL OR
   R038HCC.DATALT = (SELECT MAX(DATALT) FROM R038HCC HCC
                          WHERE HCC.NUMEMP = R038HCC.NUMEMP
                            AND HCC.TIPCOL = R038HCC.TIPCOL
                            AND HCC.NUMCAD = R038HCC.NUMCAD
                            AND HCC.DATALT <= R211DEF.DATTER)) AND
  /* SINDICATO */
 (R038HSI.DATALT IS NULL OR
  R038HSI.DATALT = (SELECT MAX(DATALT) FROM R038HSI HSI 
                         WHERE HSI.NUMEMP = R038HSI.NUMEMP 
                           AND HSI.TIPCOL = R038HSI.TIPCOL 
                           AND HSI.NUMCAD = R038HSI.NUMCAD 
                           AND HSI.DATALT <= R211DEF.DATTER)) AND
  /* SEXO */
  R034FUN.NUMEMP = R211PAP.NUMEMP AND
  R034FUN.TIPCOL = R211PAP.TIPCOL AND
  R034FUN.NUMCAD = R211PAP.NUMCAD AND
  R211PSQ.TIPPSQ = 'A' /* PESQUISA ABERTA*/
UNION
SELECT /* PESQUISA FECHADA*/
  R210QUE.CODQUE, R210QUE.DESQUE,
  R210PER.CODPER, R210PER.DESPER, R210PER.CODASS, R210PER.TIPPEQ, R210PER.DESOBS, R210PER.CODTBN CODTBNPER,
  R211PER.CODPSQ, R211PER.SEQPSQ, R211PER.RESSUB, R211PER.VALRES VALRESPER, R211PER.OBSRES, R211PER.DATRES,
  R210RES.CODRES, R210RES.DESRES, R210RES.CODTBN CODTBNRES,
  R211RES.RESASS, R211RES.VALRES VALRESRES,
  R211IDP.SEQIDE, R211IDP.NUMEMP, R211IDP.TIPCOL, 0 NUMCAD, R211IDP.CODFIL, R211IDP.TABORG, R211IDP.NUMLOC, 
  R211IDP.ESTCAR, R211IDP.CODCAR, R211IDP.CODTUR, R211IDP.CODCCU, R211IDP.CODHIE, R211IDP.CODSIN, R211IDP.TIPSEX, R211IDP.QUECON,
  R016HIE.POSLOC,
  R211DEF.DATINI, R211DEF.DATTER, R211DEF.SITPSQ,
  R211PSQ.TIPPSQ, R211PSQ.DESPSQ
FROM
  (R211PER LEFT OUTER JOIN (R211RES LEFT OUTER JOIN R210RES ON R211RES.CODQUE = R210RES.CODQUE AND
  R211RES.CODPER = R210RES.CODPER AND
  R211RES.CODRES = R210RES.CODRES) ON R211PER.CODPSQ = R211RES.CODPSQ AND
  R211PER.SEQPSQ = R211RES.SEQPSQ AND
  R211PER.SEQIDE = R211RES.SEQIDE AND
  R211PER.CODQUE = R211RES.CODQUE AND
  R211PER.CODPER = R211RES.CODPER),
  (R211DEF INNER JOIN (R211IDP LEFT OUTER JOIN R016HIE ON
                        R211IDP.TABORG=R016HIE.TABORG AND
                        R211IDP.NUMLOC=R016HIE.NUMLOC AND
                        R016HIE.DATINI <= R211IDP.DATRES AND
                        R016HIE.DATFIM >= R211IDP.DATRES) ON R211DEF.CODPSQ = R211IDP.CODPSQ AND R211DEF.SEQPSQ = R211IDP.SEQPSQ)
  , R210PER, R210QUE, R211PSQ
WHERE
  R211PER.CODQUE = R210QUE.CODQUE AND
  R211PER.CODQUE = R210PER.CODQUE AND
  R211PER.CODPER = R210PER.CODPER AND
  R211PER.CODPSQ = R211IDP.CODPSQ AND
  R211PER.SEQPSQ = R211IDP.SEQPSQ AND
  R211PER.SEQIDE = R211IDP.SEQIDE AND
  R211PER.CODPSQ = R211DEF.CODPSQ AND
  R211PER.SEQPSQ = R211DEF.SEQPSQ AND
  R211PER.CODPSQ = R211PSQ.CODPSQ AND
  R211PSQ.TIPPSQ = 'F'␀␀ÿ¨␀}²␀␀D␀␀␀␀␀␀␀␀Ä␀␀‘¶␀␀•¶␀␀m␀␀␀␀ÿ␀␀ÿ␀ó¥␀␀´␀␀␀␀␀␀␀␀␀F°␀␀XbXbr␀Æÿ␀␀ÿ␀W␀Š␀␀␀␀␀␀␀␀␀É␀t␀Ü␀n¼‡␀Æÿ␀␀ÿ␀ê¥␀␀Ì␀␀␀␀␀␀␀␀␀‚%0.0.w¼‡␀Æÿ␀␀ÿ␀¹¥␀␀U␀␀␀␀␀␀␀␀ª␀␀¨␀␀ç§␀␀Vë‡␀␀ÿ␀␀ÿ␀#´␀␀␀␀␀␀␀␀␀4Bt"t"r␀Æÿ␀␀ÿ␀³¥␀␀␀␀␀␀␀␀␀␀$X²V²V␀␀ÿ␀␀ÿ␀F‰␀␀±␀	␀␀␀␀␀␀␀␀3B¦•␀␀¦•␀␀O)␀␀Æÿ␀␀ÿ␀º¥␀␀U␀␀␀␀␀␀␀␀±Y³V³VV␀␀ÿ␀␀ÿ␀$␀Ÿ␀␀␀␀␀␀␀␀␀$$␀Ì!␀c!␀l)␀␀Æÿ␀␀ÿ␀'␀Ÿ␀␀␀␀␀␀␀␀␀#$␀–!␀–!␀Z␀Æÿ␀␀ÿ␀Y#E␀␀␀␀␀␀␀␀ 555G␀␀ÿ␀␀ÿ␀†¸␀␀Ñ␀␀␀␀␀␀␀␀␀&0Ó/Ó/œ␀␀␀êÿ␀␀ÿ␀␀â␀␀ SELECT 'CTB' ORILAN, R048CTB.NUMEMP, R048CTB.TIPCOL, R048CTB.NUMCAD, R034FUN.NOMFUN, R048CTB.CODCLC, R048CLC.NOMCON,
0 ITEORC, ' ' NOMITE, R048CTB.VALLAN, 0 VALORC, R048CTB.CONDEB CONCTB, R044CAL.PERREF
FROM R034FUN, R048CTB, R048CLC, R044CAL WHERE
R048CTB.NUMEMP = R034FUN.NUMEMP AND
R048CTB.TIPCOL = R034FUN.TIPCOL AND
R048CTB.NUMCAD = R034FUN.NUMCAD AND
R048CTB.TABEVE = R048CLC.TABEVE AND
R048CTB.CODCLC = R048CLC.CODCLC AND
R048CTB.NUMEMP = R044CAL.NUMEMP AND
R048CTB.CODCAL = R044CAL.CODCAL AND
R048CTB.DEBCRE = 'D' AND
R048CTB.CONDEB <> ' '
