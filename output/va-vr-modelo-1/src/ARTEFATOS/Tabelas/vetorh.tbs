TRIGGER R107PLN_EU AFTER UPDATE ON R107PLN FOR EACH ROW

BEGIN
/* Se alterou o curso, exclui os vínculos entre plano de ação e reserva para o curso antigo */
  IF (:OLD.CODCUA <> :NEW.CODCUA) THEN
    BEGIN
      DELETE FROM R132PLN
       WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD
         AND CODPLN = :OLD.CODPLN AND CODOBJ = :OLD.CODOBJ AND CODACO = :OLD.CODACO;
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na exclusão dos vínculos entre plano de ação e reserva.';
    END;
  END IF;
END␀ÎŞ␀␀		SENIOR;0Æ␀␀TRIGGER R107PLN_ED AFTER DELETE ON R107PLN FOR EACH ROW

BEGIN
/* Exclui os vínculos entre plano de ação e reserva */
  BEGIN
    DELETE FROM R132PLN
     WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD
       AND CODPLN = :OLD.CODPLN AND CODOBJ = :OLD.CODOBJ AND CODACO = :OLD.CODACO;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na exclusão dos vínculos entre plano de ação e reserva.';
  END;
