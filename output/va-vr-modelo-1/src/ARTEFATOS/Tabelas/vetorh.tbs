2␀␀create or replace PROCEDURE SP_SinAudMVI(p_tipope IN NUMBER,p_codpor IN NUMBER,p_datent IN DATE,p_horent IN NUMBER,p_seqent IN NUMBER,p_tipdoc IN NUMBER,p_numdoc IN VARCHAR2,p_numemp IN NUMBER,p_tipcol IN NUMBER,p_numcad IN NUMBER,p_numcra IN NUMBER,p_codnac IN NUMBER,p_nomvis IN VARCHAR2,p_codoem IN NUMBER,p_nomoem IN VARCHAR2,p_dditel IN NUMBER,p_dddtel IN NUMBER,p_telcon IN VARCHAR2,p_tipvis IN NUMBER,p_codprm IN NUMBER,p_datval IN DATE,p_horval IN NUMBER,p_obsvis IN VARCHAR2,p_plavee IN VARCHAR2,p_placae IN VARCHAR2,p_place2 IN VARCHAR2,p_place3 IN VARCHAR2,p_numlau IN VARCHAR2,p_regrod IN NUMBER,p_assvid IN VARCHAR2,p_pcodoem IN NUMBER,p_numcon IN VARCHAR2,p_pnumemp IN NUMBER,p_ptipcol IN NUMBER,p_pnumcad IN NUMBER,p_codusu IN NUMBER,p_datsai IN DATE,p_horsai IN NUMBER,p_emavis IN VARCHAR2,p_verplf IN NUMBER,p_codplf IN NUMBER,p_RetSin OUT NUMBER) IS
  l_temAud NUMBER(2);
  l_coderr NUMBER(2);
  l_codRPA NUMBER(9);
  l_datatu DATE;
  l_horatu NUMBER(5);
  l_tipdocSTR VARCHAR2(255);
  l_numdocSTR VARCHAR2(255);
  l_codporSTR VARCHAR2(255);
  l_datentSTR VARCHAR2(255);
  l_horentSTR VARCHAR2(255);
  l_seqentSTR VARCHAR2(255);
  l_numempSTR VARCHAR2(255);
  l_tipcolSTR VARCHAR2(255);
  l_numcadSTR VARCHAR2(255);
  l_numcraSTR VARCHAR2(255);
  l_taborgSTR VARCHAR2(255);
  l_numlocSTR VARCHAR2(255);
  l_segtdoSTR VARCHAR2(255);
  l_segdocSTR VARCHAR2(255);
  l_emicidSTR VARCHAR2(255);
  l_estcidSTR VARCHAR2(255);
  l_dexcidSTR VARCHAR2(255);
  l_codnacSTR VARCHAR2(255);
  l_nomvisSTR VARCHAR2(255);
  l_codormSTR VARCHAR2(255);
  l_nomoemSTR VARCHAR2(255);
  l_dditelSTR VARCHAR2(255);
  l_dddtelSTR VARCHAR2(255);
  l_telconSTR VARCHAR2(255);
  l_tipvisSTR VARCHAR2(255);
  l_codprmSTR VARCHAR2(255);
  l_codmotSTR VARCHAR2(255);
  l_datvalSTR VARCHAR2(255);
  l_horvalSTR VARCHAR2(255);
  l_obsvisSTR VARCHAR2(255);
  l_plaveeSTR VARCHAR2(255);
  l_placaeSTR VARCHAR2(255);
  l_place2STR VARCHAR2(255);
  l_place3STR VARCHAR2(255);
  l_numlauSTR VARCHAR2(255);
  l_regrodSTR VARCHAR2(255);
  l_codoemSTR VARCHAR2(255);
  l_pcodoemSTR VARCHAR2(255);
  l_numconSTR VARCHAR2(255);
  l_pnumempSTR VARCHAR2(255);
  l_ptipcolSTR VARCHAR2(255);
  l_pnumcadSTR VARCHAR2(255);
  l_emavisSTR VARCHAR2(255);
  l_verplfSTR VARCHAR2(255);
  l_codplfSTR VARCHAR2(255);
  l_datsaiSTR VARCHAR2(255);
  l_horsaiSTR VARCHAR2(255);
  l_tamstr NUMBER(2);
  l_auxtam NUMBER(2);
  l_mascara VARCHAR2(255);
begin
  p_RetSin := 0;
  l_coderr := 0;
  l_datatu := TO_DATE(TO_CHAR(GETDBDATETIME,'DD/MM/YYYY'),'DD/MM/YYYY');
  SELECT TO_CHAR(SYSTIMESTAMP, 'SSSSS') INTO l_horatu FROM DUAL;
  SP_INTSTR(p_tipdoc,'9',l_tipdocSTR);
  l_numdocSTR := p_numdoc;
  SP_TAMSTR(p_codpor,l_mascara);
  SP_INTSTR(p_codpor,l_mascara,l_codporSTR);
  SP_DATSTR(p_datent,'DDMMYY',l_datentSTR);
  l_datentSTR := SUBSTR(l_datentSTR,1,2)||'/'||SUBSTR(l_datentSTR,3,2)||'/20'||SUBSTR(l_datentSTR,5,2);
  SP_INTSTR(p_horent,'HHMM',l_horentSTR);
  l_horentSTR := SUBSTR(l_horentSTR,1,2)||':'||SUBSTR(l_horentSTR,3,2);
  SP_TAMSTR(p_seqent,l_mascara);
  SP_INTSTR(p_seqent,l_mascara,l_seqentSTR);
  SP_TAMSTR(p_numemp,l_mascara);
  SP_INTSTR(p_numemp,l_mascara,l_numempSTR);
  SP_INTSTR(p_tipcol,'9',l_tipcolSTR);
  SP_TAMSTR(p_numcad,l_mascara);
  SP_INTSTR(p_numcad,l_mascara,l_numcadSTR);
  SP_INTSTR(p_numcra,'999999999999',l_numcraSTR);
  SP_TAMSTR(p_codnac,l_mascara);
  SP_INTSTR(p_codnac,l_mascara,l_codnacSTR);
  l_nomvisSTR := p_nomvis;
  SP_TAMSTR(p_codoem,l_mascara);
  SP_INTSTR(p_codoem,l_mascara,l_codoemSTR);
  l_nomoemSTR := p_nomoem;
  SP_TAMSTR(p_dditel,l_mascara);
  SP_INTSTR(p_dditel,l_mascara,l_dditelSTR);
  SP_TAMSTR(p_dddtel,l_mascara);
  SP_INTSTR(p_dddtel,l_mascara,l_dddtelSTR);
  l_telconSTR := p_telcon;
  SP_TAMSTR(p_tipvis,l_mascara);
  SP_INTSTR(p_tipvis,l_mascara,l_tipvisSTR);
  SP_TAMSTR(p_codprm,l_mascara);
  SP_INTSTR(p_codprm,l_mascara,l_codprmSTR);
  SP_DATSTR(p_datval,'DDMMYY',l_datvalSTR);
  l_datvalSTR := SUBSTR(l_datvalSTR,1,2)||'/'||SUBSTR(l_datvalSTR,3,2)||'/20'||SUBSTR(l_datvalSTR,5,2);
  SP_INTSTR(p_horval,'HHMM',l_horvalSTR);
  l_horvalSTR := SUBSTR(l_horvalSTR,1,2)||':'||SUBSTR(l_horvalSTR,3,2);
  l_obsvisSTR := p_obsVis;
  l_plaveeSTR := p_plavee;
  l_placaeSTR := p_placae;
  l_place2STR := p_place2;
  l_place3STR := p_place3;
  l_numlauSTR := p_numlau;
  SP_TAMSTR(p_regrod,l_mascara);
  SP_INTSTR(p_regrod,l_mascara,l_regrodSTR);
  l_numconSTR := p_numcon;
  SP_TAMSTR(p_pnumemp,l_mascara);
  SP_INTSTR(p_pnumemp,l_mascara,l_pnumempSTR);
  SP_INTSTR(p_ptipcol,'9',l_ptipcolSTR);
  SP_TAMSTR(p_pnumcad,l_mascara);
  SP_INTSTR(p_pnumcad,l_mascara,l_pnumcadSTR);
  l_emavisSTR := p_emavis;
  SP_TAMSTR(p_verplf,l_mascara);
  SP_INTSTR(p_verplf,l_mascara,l_verplfSTR);
  SP_TAMSTR(p_codplf,l_mascara);
  SP_INTSTR(p_codplf,l_mascara,l_codplfSTR);
  SP_DATSTR(p_datsai,'DDMMYY',l_datsaiSTR);
  l_datsaiSTR := SUBSTR(l_datsaiSTR,1,2)||'/'||SUBSTR(l_datsaiSTR,3,2)||'/20'||SUBSTR(l_datsaiSTR,5,2);
  SP_INTSTR(p_horsai,'HHMM',l_horsaiSTR);
  l_horsaiSTR := SUBSTR(l_horsaiSTR,1,2)||':'||SUBSTR(l_horsaiSTR,3,2);
  l_codRPA := 0;
  SP_RET_REG_AUD(l_codRPA);
  if (p_tipope=0) then
    l_temAud := 0;
    begin
      SELECT 
      COUNT(*) EXPR1759134873
       INTO l_temAud 
       FROM R995CTE R995CTE
       WHERE CODCPA=7 
      AND CODTPA=112;
    exception
      when OTHERS then
        l_coderr := 21;
    end;
    if (l_coderr=0) then
      if (l_temAud>0) then
        begin
          INSERT INTO R995RPA (CODRPA,CODSYS,CODCPA,VERCPA,CODTPA,VERTPA,DATRPA,HORRPA,SCRACT,CODUSU) VALUES  (l_codRPA,3,7,1,120,1,l_datatu,l_horatu,'PORTARIA AVANCADA',p_codusu);
        exception
          when OTHERS then
            l_coderr := 22;
        end;
        begin
          INSERT INTO R995PRC (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TIPDOC',l_tipdocSTR);
          INSERT INTO R995PRC (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMDOC',l_numdocSTR);
        exception
          when OTHERS then
            l_coderr := 23;
        end;
        begin
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CODPOR',l_codporSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DATENT',l_datentSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'HORENT',l_horentSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'SEQENT',l_seqentSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMEMP',l_numempSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TIPCOL',l_tipcolSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMCAD',l_numcadSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMCRA',l_numcraSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TABORG','');
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMLOC','');
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'SEGTDO','');
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'SEGDOC','');
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'EMICID','');
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'ESTCID','');
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DEXCID','');
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CODNAC',l_codnacSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NOMVIS',l_nomvisSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CODOEM',l_codoemSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NOMOEM',l_nomoemSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DDITEL',l_dditelSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DDDTEL',l_dddtelSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TELCON',l_telconSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TIPVIS',l_tipvisSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CODPRM',l_codprmSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CODMOT','');
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DATVAL',l_datvalSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'HORVAL',l_horvalSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'OBSVIS',l_obsvisSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PLACAE',l_placaeSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PLACE2',l_place2STR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PLACE3',l_place3STR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMLAU',l_numlauSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'REGROD',l_regrodSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMCHN','');
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CATCNH','');
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'VENCNH','');
          if (p_assVid='1') then
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DATVID',l_datentSTR);
          end if;
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PCODOEM',l_codoemSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMCON',l_numconSTR);
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'VISVAU','');
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CODLOT','');
