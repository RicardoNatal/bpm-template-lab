TRIGGER R030GRC_EI AFTER INSERT ON R030GRC FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Filiais da Empresa - Convênios Grps*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 47;     /* Filiais da Empresa - Convênios Grps*/
  l_codtpa := 205;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030GRC_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPGRP', CONVERT(NUMBER_TO_CHAR, :NEW.TIPGRP));
        SP_DATSTR(:NEW.DATGRP, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATGRP', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TERFPA', CONVERT(NUMBER_TO_CHAR, :NEW.TERFPA));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030GRC_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERDCO', CONVERT(NUMBER_TO_CHAR, :NEW.PERDCO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERREM', CONVERT(NUMBER_TO_CHAR, :NEW.PERREM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TEMLIM', :NEW.TEMLIM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRO', CONVERT(NUMBER_TO_CHAR, :NEW.CODPRO));
      END;
  END IF; 
END␀AÒ␀␀		SENIOR;0@␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R030GRC_EU AFTER UPDATE ON R030GRC FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Filiais da Empresa - Convênios Grps*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 47;     /* Filiais da Empresa - Convênios Grps*/
  l_codtpa := 206;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFil <> :NEW.CodFil)
   OR (:OLD.TipGrp <> :NEW.TipGrp)
   OR (:OLD.DatGrp <> :NEW.DatGrp)
   OR (:OLD.TerFpa <> :NEW.TerFpa)
   OR (:OLD.PerDco <> :NEW.PerDco)
   OR (:OLD.PerRem <> :NEW.PerRem)
   OR (:OLD.TemLim <> :NEW.TemLim)
   OR (:OLD.CodPro <> :NEW.CodPro)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030GRC_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPGRP', CONVERT(NUMBER_TO_CHAR, :OLD.TIPGRP));
        SP_DATSTR(:OLD.DATGRP, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATGRP', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TERFPA', CONVERT(NUMBER_TO_CHAR, :OLD.TERFPA));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030GRC_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERDCO', CONVERT(NUMBER_TO_CHAR, :OLD.PERDCO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERDCO', CONVERT(NUMBER_TO_CHAR, :NEW.PERDCO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERREM', CONVERT(NUMBER_TO_CHAR, :OLD.PERREM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERREM', CONVERT(NUMBER_TO_CHAR, :NEW.PERREM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTEMLIM', :OLD.TEMLIM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTEMLIM', :NEW.TEMLIM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPRO', CONVERT(NUMBER_TO_CHAR, :OLD.CODPRO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPRO', CONVERT(NUMBER_TO_CHAR, :NEW.CODPRO));
      END;
    END IF; 
  END IF; 
END␀?Ò␀␀		SENIOR;0␀␀ 

