TRIGGER R347BEA_EU AFTER UPDATE ON R347BEA FOR EACH ROW DECLARE
	l_Valor VARCHAR2(2000);
	l_Alterou BOOLEAN;
	l_AlterouChave BOOLEAN;
	l_Valido BOOLEAN;
	l_Incluir BOOLEAN;
	l_Excluir BOOLEAN;
	l_InfoFacult BOOLEAN;
	l_SimplificaoESocial BOOLEAN;
	l_VersaoESocial NUMBER;
BEGIN
	l_Valor := '';
	l_Valido := FALSE;
	l_Alterou := FALSE;
	l_AlterouChave := FALSE;
	l_Incluir := FALSE;
    l_Excluir := FALSE;	
	l_InfoFacult := TRUE;
	l_SimplificaoESocial := FALSE;
	
	SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);

	IF (l_SimplificaoESocial = TRUE) THEN
		SP_VALUPDATE_DAT(:OLD.DatAlt, :NEW.DatAlt, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;	
		  
		SP_VALUPDATE_NUM(:OLD.TipBen, :NEW.TipBen, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;

		SP_VALUPDATE_NUM(:OLD.PanSeg, :NEW.PanSeg, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;

