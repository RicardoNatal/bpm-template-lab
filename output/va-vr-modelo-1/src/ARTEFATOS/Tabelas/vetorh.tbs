‰␀␀CREATE OR REPLACE PROCEDURE SP_PENDPAL(P_CODDSP NUMBER, P_TIPOPE VARCHAR2, P_NUMFIS NUMBER, P_TECCRA NUMBER, P_IDTPES CHAR)
IS
  l_count SMALLINT;
BEGIN
  BEGIN

  SELECT COUNT(*) INTO l_count
  FROM R070PAL
  WHERE TIPOPE=P_TIPOPE AND NUMFIS=P_NUMFIS AND TECCRA=P_TECCRA AND IDTPES=P_IDTPES;

  IF (l_count = 0) THEN
    INSERT INTO R070PAL(CODPAL, CODDSP, TIPOPE, NUMFIS, TECCRA, IDTPES) VALUES (SEQ_R070PAL.nextval, P_CODDSP, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
  END IF;

  EXCEPTION
    WHEN OTHERS THEN
      raise_application_error(-20000 + - (103), 'SP_PENDPAL: Erro na inserção da pendência na R070PAL.');
  END;
END;		ORACLE;22
‰␀␀CREATE OR REPLACE PROCEDURE SP_PENDPAL(P_CODDSP NUMBER, P_TIPOPE VARCHAR2, P_NUMFIS NUMBER, P_TECCRA NUMBER, P_IDTPES CHAR)
IS
  l_count SMALLINT;
BEGIN
  BEGIN

  SELECT COUNT(*) INTO l_count
  FROM R070PAL
  WHERE TIPOPE=P_TIPOPE AND NUMFIS=P_NUMFIS AND TECCRA=P_TECCRA AND IDTPES=P_IDTPES;

  IF (l_count = 0) THEN
    INSERT INTO R070PAL(CODPAL, CODDSP, TIPOPE, NUMFIS, TECCRA, IDTPES) VALUES (SEQ_R070PAL.nextval, P_CODDSP, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
  END IF;

  EXCEPTION
    WHEN OTHERS THEN
      raise_application_error(-20000 + - (103), 'SP_PENDPAL: Erro na inserção da pendência na R070PAL.');
