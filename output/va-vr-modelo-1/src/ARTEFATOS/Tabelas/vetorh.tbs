/* INSERT (NEW) */
TRIGGER R008VIN_EI AFTER INSERT ON R008VIN FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Eventos - Vínculos Inválidos (Tabela: R008VIN)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 105;     /* Eventos - Vínculos Inválidos (Tabela: R008VIN)*/
  l_codtpa := 355;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008VIN_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAB', CONVERT(NUMBER_TO_CHAR, :NEW.CODTAB));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CODEVE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODVIN', CONVERT(NUMBER_TO_CHAR, :NEW.CODVIN));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R008VIN_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      
      BEGIN
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
	  END;
  END IF; 
END␀XÏ␀␀	SENIOR;0L

