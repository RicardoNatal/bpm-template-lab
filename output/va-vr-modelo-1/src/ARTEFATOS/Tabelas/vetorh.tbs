   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034SIN_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSIN', CONVERT(NUMBER_TO_CHAR, :OLD.CODSIN));
        SP_DATSTR(:OLD.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034SIN_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SOCSIN', :OLD.SOCSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PAGSIN', :OLD.PAGSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TASSIN', :OLD.TASSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CUSSIN', :OLD.CUSSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REVSIN', :OLD.REVSIN);
        SP_DATSTR(:OLD.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATFIM', l_datTemp);
      END;
  END IF; 
END␀␀␀¸␀␀␀␀␀␀␀␀␀␀␀␀␀␀òÓ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀Ü␀t␀Ü␀nˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀.%0.0.wˆ␀Æÿ␀␀…Ó␀␀␀j␀­␀	␀␀␀␀␀␀␀ú␀ú␀ú␀p␀Æÿ␀␀ÓÜ␀␀␀␀␀␀0;1;2;3␀␀\␀␀␀␀␀óÓ␀␀…¬␀␀´␀Ôÿ␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀tÔÿ␀␀␀␀␀Ù␀t␀Ü␀n¼‡␀Æÿ␀␀ÿ␀c¬␀␀Ì␀Ôÿ␀␀␀␀␀.%€$0.w¼‡␀Æÿ␀␀ÿ␀8=Ôÿ␀␀␀␀␀¢8¢8¢8c␀␀␀ÿ␀␀ÿ␀␀␀ôÓ␀␀␀␀␀␀␀␀ªm␀␀␀␀õÓ␀␀…¬␀␀´␀	Ğï!␀␀␀␀␀XbXbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ğï!␀␀␀␀␀Ü␀Ü␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ğï!␀␀␀␀␀.%0.0.w␀Æÿ␀␀…Ó␀␀␀e␀h		Ğï!␀␀␀␀␀‡␀á␀‡␀p␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3÷Ó␀␀		SENIOR;0␀␀/* INSERT (NEW) */
TRIGGER R034USO_EI AFTER INSERT ON R034USO FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN
  /* Geração de logs Terceiros - Tipos de Uso (Tabela: R034USO)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 95;     /* Terceiros - Tipos de Uso (Tabela: R034USO)*/
  l_codtpa := 304;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT); 
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034USO_AI', '');

    /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPUSO', CONVERT(NUMBER_TO_CHAR, :NEW.TIPUSO));
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R034USO_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;
    
    BEGIN
	  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
	END;
  END IF; 
END␀øÓ␀␀		SENIOR;0l␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R034USO_EU AFTER UPDATE ON R034USO FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Terceiros - Tipos de Uso (Tabela: R034USO)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 95;     /* Terceiros - Tipos de Uso (Tabela: R034USO)*/
  l_codtpa := 305;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.TipUso <> :NEW.TipUso)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034USO_AU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPUSO', CONVERT(NUMBER_TO_CHAR, :OLD.TIPUSO));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034USO_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
    END IF; 
  END IF; 
END␀öÓ␀␀		SENIOR;0␀␀ 

