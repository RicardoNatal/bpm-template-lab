TRIGGER R068RSP_SI AFTER INSERT ON R068RSP

DECLARE
/* CURSOR c/ os registros gravados no R068RSP_AUXl */
  CURSOR c_r068RSP_INS IS SELECT NUMEMP,TIPCOL,NUMCAD,DATALT,REARES
                            FROM R068RSP_AUX
                           WHERE TIPOPE = 'I';
  TYPE t_r068RSP_aux IS RECORD(
    NUMEMP   R068RSP_AUX.NUMEMP%TYPE,
    TIPCOL   R068RSP_AUX.TIPCOL%TYPE,
    NUMCAD   R068RSP_AUX.NUMCAD%TYPE,
    DATALT   R068RSP_AUX.DATALT%TYPE,
    REARES   R068RSP_AUX.REARES%TYPE);
  l_r068RSP_aux t_r068RSP_aux;

BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r068RSP_INS INTO  l_r068rsp_aux.NUMEMP,
                              l_r068rsp_aux.TIPCOL,
                              l_r068rsp_aux.NUMCAD,
                              l_r068rsp_aux.DATALT,
                              l_r068rsp_aux.REARES
  LOOP
     R068RSP_ATUCON ('I',l_r068rsp_aux.NUMEMP,l_r068rsp_aux.TIPCOL,l_r068rsp_aux.NUMCAD,
                     l_r068rsp_aux.DATALT,l_r068rsp_aux.REARES);
  END LOOP;
 /* Apaga Registro OLD em R068RSP_AUX */
  BEGIN
    DELETE FROM R068RSP_AUX  WHERE TIPOPE = 'I';
    DROP_TEMP_TABLE R068RSP_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀Ù␀␀		SENIOR;0+␀␀

