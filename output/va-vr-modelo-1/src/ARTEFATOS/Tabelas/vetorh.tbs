␀ì*␀␀Æÿ␀␀ÿ␀¢-D€␀␀␀␀␀␀#‹␀␀A␀A␀€␀␀␀ÿ␀␀ä␀␀␀E¡␀€␀␀␀␀␀␀)JB_$Np␀Æÿ␀␀ÿ␀€␀¡␀€␀␀␀␀␀␀oJÆ+␀ì+␀p␀Æÿ␀␀ÿ␀«î␀Ôÿ1␀␀␀␀␀␀²␀n␀Æÿ␀␀ÿ␀×£␀␀=Ôÿ1␀␀␀␀␀?#Ÿ␀␀&Ÿ␀␀c␀␀␀ÿ␀␀ÿ␀,§␀␀v€␀␀␀␀␀␀?ª␀␀L¨␀␀³©␀␀n␀␀ÿ␀␀ÿ␀?-´␀€␀␀␀␀␀␀BW3X3r␀Æÿ␀␀ıĞ␀␀␀sï␀␀€␀␀␀␀␀␀â°␀␀Òï␀␀Ôï␀␀ ␀␀ÿ␀␀ÿ␀ø7␀€␀␀␀␀␀␀"±␀␀‰#±␀␀Q␀Æÿ␀␀Î#␀@Â␀␀␀€␀␀␀␀␀␀w±␀␀µ¸␀␀z±␀␀U␀Æÿ␀␀Œ¥␀␀␀ïµ␀␀Â€␀␀␀␀␀␀éBŒ+␀¡+␀n␀␀Æÿ␀␀ÿ␀'f'€␀␀␀␀␀␀Ù␀␀Ñ␀Ó␀‚␀␀␀␀ÿ␀␀ÿ␀¸d=€␀␀␀␀␀␀:␀␀eec␀␀␀ÿ␀␀ÿ␀‚^c€␀␀␀␀␀␀„^ƒ^ƒ^`␀␀␀ÿ␀␀ÿ␀Çdc€␀␀␀␀␀␀ÉdÈdÈd`␀␀␀ÿ␀␀ÿ␀␀_€␀␀␀␀␀␀´␀f␀f␀n␀␀Æÿ␀␀ÿ␀‰qC€␀␀␀␀␀␀ŒqŒqŒqp␀Æÿ␀␀ÿ␀␀␀yß␀␀␀	␀␀0;1;2{ß␀␀		SENIOR;0h␀␀TRIGGER R110MAM_AI AFTER INSERT ON R110MAM FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataInicioSST DATE;
	l_TipAtn NUMBER(1);
	l_AtnFic NUMBER(1);
	l_TipCol NUMBER(1);
	l_NumCad NUMBER(9);
	l_CodDep NUMBER(2);
	l_NumCan NUMBER(7);
	l_Valor VARCHAR2(2000);
	l_temAud       BOOLEAN;
    l_codRPA       NUMBER(15);
    l_codSistema   NUMBER(2);
    l_codcpa       NUMBER(4);
    l_codtpa       NUMBER(4);
    l_datTemp      VARCHAR(10);
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
   
	/* eSocial S-2220 - Início */
	IF (:NEW.TipAso > 0) AND (:NEW.Enveso = 'S') THEN
		RH_RET_DATINISST(:NEW.NumEmp, l_DataInicioSST OUT);
		IF (l_DataInicioSST > l_DataZero) THEN
			IF (:NEW.DatAte >= l_DataInicioSST) THEN
				RH_RETATNFICMED(:NEW.NumEmp, :NEW.CodFic, :NEW.DatAte, l_TipAtn OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
				RH_RETFICMED(:NEW.NumEmp, :NEW.CodFic, l_AtnFic OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
				IF (l_TipAtn = 1) OR (l_AtnFic = 1 AND :NEW.TipAso = 1) THEN /* 1 - Colaborador, 4 - Candidato. Se For um Candidato e ASO for Admissional, busca os dados vinculados diretamente na ficha médica */
					l_Valor := '';
					
					SP_CONCATENAR_NUM('CODATE', :NEW.CodAte, l_Valor OUT);
					SP_CONCATENAR_NUM('NUMATE', :NEW.NumAte, l_Valor OUT);
					SP_CONCATENAR_DAT('DATASO', :NEW.DatAte, l_Valor OUT);
					
					SP_E_SOCIAL_SM('S-2220', 'R110MAM', 'N', 'I', NULL, NULL, :NEW.NUMEMP, l_TipCol, l_NumCad, l_Valor, '', 0, NULL, :NEW.DATATE, 0, 'R110MAM_AI');
				END IF;
			END IF;
		END IF;
	END IF;
	/* eSocial S-2220 - Fim */
	/* Geração de logs Número do Atestado Médico (Tabela: R110MAM)*/ 
	l_codSistema := 1;  /* Código do sistema vetorh. */
	l_codcpa := 117;     /* Número do Atestado Médico (Tabela: R110MAM)*/
	l_codtpa := 365;
	
	SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
	  SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110MAM_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR, :NEW.CODATE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMATE', CONVERT(NUMBER_TO_CHAR, :NEW.NUMATE));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110MAM_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIC));
        SP_DATSTR(:NEW.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPATE', CONVERT(NUMBER_TO_CHAR, :NEW.TIPATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPMAM', CONVERT(NUMBER_TO_CHAR, :NEW.TIPMAM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAATE', CONVERT(NUMBER_TO_CHAR, :NEW.DIAATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOCO', CONVERT(NUMBER_TO_CHAR, :NEW.CODOCO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPAR', CONVERT(NUMBER_TO_CHAR, :NEW.CODPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPOS', CONVERT(NUMBER_TO_CHAR, :NEW.CODPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESATE', :NEW.DESATE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDOE', :NEW.CODDOE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCID', :NEW.CODCID); 
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPASO', CONVERT(NUMBER_TO_CHAR, :NEW.TIPASO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORIATE', :NEW.ORIATE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR, :NEW.CODUSU));
        SP_DATSTR(:NEW.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAFA', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITATE', CONVERT(NUMBER_TO_CHAR, :NEW.SITATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORAFA', CONVERT(NUMBER_TO_CHAR, :NEW.HORAFA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORTER', CONVERT(NUMBER_TO_CHAR, :NEW.HORTER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSATE', 'registro incluído (excede limite de exibição)');
        SP_DATSTR(:NEW.FIMATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMATE', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR, :NEW.HORATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSUB', :NEW.CODSUB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINC', CONVERT(NUMBER_TO_CHAR, :NEW.DATINC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ULTALT', CONVERT(NUMBER_TO_CHAR, :NEW.ULTALT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ACITRA', CONVERT(NUMBER_TO_CHAR, :NEW.ACITRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MSMMOT', :NEW.MSMMOT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORGCLA', CONVERT(NUMBER_TO_CHAR, :NEW.ORGCLA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTORG', :NEW.ESTORG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENVESO', :NEW.ENVESO);
      END;
  END IF;
END␀|ß␀␀		SENIOR;0ª>␀␀

TRIGGER R110MAM_AU AFTER UPDATE ON R110MAM FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataInicioSST DATE;
	l_TipAtn NUMBER(1);
	l_AtnFic NUMBER(1);
	l_TipCol NUMBER(1);
	l_NumCad NUMBER(9);
	l_CodDep NUMBER(2);
	l_NumCan NUMBER(7);
	l_Valor VARCHAR2(2000);
	l_ValorAux VARCHAR2(2000);
	l_JsonCamposAlterados VARCHAR2(2000);
	l_Valido  BOOLEAN;
  	l_Alterou BOOLEAN;
  	l_AlterouDataAtendimento BOOLEAN;
  	l_AlterouFichaMedica BOOLEAN;
  	l_temAud       BOOLEAN;
    l_codRPA       NUMBER(15);
    l_codSistema   NUMBER(2);
    l_codcpa       NUMBER(4);
    l_codtpa       NUMBER(4);
    l_datTemp      VARCHAR(10);
    l_AlterouEnvEsoParaNao BOOLEAN;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
    l_JsonCamposAlterados  := '';
    l_AlterouEnvEsoParaNao := FALSE;
    
    IF (:OLD.EnvEso = 'S') AND (:NEW.EnvEso <> 'S') THEN
      l_AlterouEnvEsoParaNao := TRUE;
    END IF; 
	
	/* eSocial S-2220 - Início */
	IF ((:NEW.TipAso > 0) AND (:NEW.EnvEso = 'S')) OR ((:NEW.TipAso > 0) AND (l_AlterouEnvEsoParaNao = TRUE)) THEN
		RH_RET_DATINISST(:NEW.NumEmp, l_DataInicioSST OUT);
		IF (l_DataInicioSST > l_DataZero) THEN
			IF (:NEW.DatAte >= l_DataInicioSST OR :OLD.DatAte >= l_DataInicioSST) THEN
				l_Valor := '';
				
				SP_CONCATENAR_NUM('CODATE', :NEW.CodAte, l_Valor OUT);
				SP_CONCATENAR_NUM('NUMATE', :NEW.NumAte, l_Valor OUT);
				SP_CONCATENAR_DAT('DATASO', :NEW.DatAte, l_Valor OUT);
		
				l_AlterouFichaMedica := FALSE;
		
				SP_VALUPDATE_NUM(:OLD.CodFic, :NEW.CodFic, l_Valido OUT);
				IF (l_Valido = TRUE) THEN
					l_AlterouFichaMedica := TRUE;
					SP_CONCAT_NUM_JSON('CODFIC', :NEW.CodFic, :OLD.CodFic, l_JsonCamposAlterados OUT);
				END IF;
			
				IF (l_AlterouFichaMedica = TRUE) THEN
					/* Gera uma pendência para enviar o S-2220 para o colaborador vinculado na nova ficha médica */
					RH_RETATNFICMED(:NEW.NumEmp, :NEW.CodFic, :NEW.DatAte, l_TipAtn OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
					RH_RETFICMED(:NEW.NumEmp, :NEW.CodFic, l_AtnFic OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
					IF (l_TipAtn = 1) OR (l_AtnFic = 1 AND :NEW.TipAso = 1 ) THEN /* 1 - Colaborador, 4 - Candidato. Se For um Candidato e ASO for Admissional, busca os dados vinculados diretamente na ficha médica */
						l_ValorAux := l_Valor;
						SP_E_SOCIAL_SM('S-2220', 'R110MAM', 'N', 'I', NULL, NULL, :NEW.NUMEMP, l_TipCol, l_NumCad, l_ValorAux, l_JsonCamposAlterados, 0, NULL, :NEW.DatAte, 0, 'R110MAM_AU');
					END IF;
				
					/* Gera uma pendência do S-3000 para enviar a exclusão do S-2220 referente ao colaborador da ficha médica anterior */
					RH_RETATNFICMED(:OLD.NumEmp, :OLD.CodFic, :OLD.DatAte, l_TipAtn OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
					RH_RETFICMED(:OLD.NumEmp, :OLD.CodFic, l_AtnFic OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
					IF (l_TipAtn = 1) OR (l_AtnFic = 1 AND :NEW.TipAso = 1 ) THEN /* 1 - Colaborador, 4 - Candidato. Se For um Candidato e ASO for Admissional, busca os dados vinculados diretamente na ficha médica */ 
						l_ValorAux := l_Valor;
						SP_CONCATENAR_DES('LAYOUT', 'S-2220', l_ValorAux OUT);
						SP_E_SOCIAL_SM('S-3000', 'R110MAM', 'N', 'E', NULL, NULL, :OLD.NUMEMP, l_TipCol, l_NumCad, l_ValorAux, l_JsonCamposAlterados, 0, NULL, :OLD.DatAte, 0, 'R110MAM_AU');
					END IF;
				ELSE
					RH_RETATNFICMED(:NEW.NumEmp, :NEW.CodFic, :NEW.DatAte, l_TipAtn OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
					RH_RETFICMED(:NEW.NumEmp, :NEW.CodFic, l_AtnFic OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
					IF (l_TipAtn = 1) OR (l_AtnFic = 1 AND :NEW.TipAso = 1 ) THEN /* 1 - Colaborador, 4 - Candidato. Se For um Candidato e ASO for Admissional, busca os dados vinculados diretamente na ficha médica */ 
						l_Alterou := FALSE;
			
						SP_VALUPDATE_DAT(:OLD.DatAte, :NEW.DatAte, l_Valido OUT);
						IF (l_Valido = TRUE) THEN
		   					l_Alterou := TRUE;
		   					SP_CONCAT_DAT_JSON('DATATE', :NEW.DatAte, :OLD.DatAte, l_JsonCamposAlterados OUT);
		  				END IF;
		  	
						SP_VALUPDATE_NUM(:OLD.TipAso, :NEW.TipAso, l_Valido OUT);
		  				IF (l_Valido = TRUE) THEN
		    				l_Alterou := TRUE;
		    				SP_CONCAT_NUM_JSON('TIPASO', :NEW.TipAso, :OLD.TipAso, l_JsonCamposAlterados OUT);
		  				END IF;
		  
						SP_VALUPDATE_NUM(:OLD.CodPar, :NEW.CodPar, l_Valido OUT);
		  				IF (l_Valido = TRUE) THEN
		    				l_Alterou := TRUE;
		    				SP_CONCAT_NUM_JSON('CODPAR', :NEW.CodPar, :OLD.CodPar, l_JsonCamposAlterados OUT);
		  				END IF;
		  				
		  				SP_VALUPDATE_DES(:OLD.NomAte, :NEW.NomAte, l_Valido OUT);
		  				IF (l_Valido = TRUE) THEN
		    				l_Alterou := TRUE;
		    				SP_CONCAT_DES_JSON('NOMATE', :NEW.NomAte, :OLD.NomAte, l_JsonCamposAlterados OUT);
		    			END IF;
		    			
		  				SP_VALUPDATE_DES(:OLD.EstOrg, :NEW.EstOrg, l_Valido OUT);
		  				IF (l_Valido = TRUE) THEN
		    				l_Alterou := TRUE;
		    				SP_CONCAT_DES_JSON('ESTORG', :NEW.EstOrg, :OLD.EstOrg, l_JsonCamposAlterados OUT);
		    			END IF;		  				
		  				
		  				SP_VALUPDATE_DES(:OLD.RegCon, :NEW.RegCon, l_Valido OUT);
		  				IF (l_Valido = TRUE) THEN
		    				l_Alterou := TRUE;
		    				SP_CONCAT_DES_JSON('REGCON', :NEW.RegCon, :OLD.RegCon, l_JsonCamposAlterados OUT);
		    			END IF;		
		    			
		    			IF (:OLD.EnvEso <> 'S' AND :NEW.EnvEso = 'S') THEN
		    				l_Alterou := TRUE;
		    				SP_CONCAT_DES_JSON('ENVESO', :NEW.EnvEso, :OLD.EnvEso, l_JsonCamposAlterados OUT);
		    			END IF;    	
		    
						IF (l_Alterou = TRUE) THEN
							SP_E_SOCIAL_SM('S-2220', 'R110MAM', 'N', 'A', NULL, NULL, :NEW.NUMEMP, l_TipCol, l_NumCad, l_Valor, l_JsonCamposAlterados, 0, NULL, :NEW.DatAte, 0, 'R110MAM_AU');
						END IF;
									
		    			SP_VALUPDATE_DAT(:OLD.DatAte, :NEW.DatAte, l_AlterouDataAtendimento OUT);
						IF (l_AlterouDataAtendimento = TRUE) OR (l_AlterouEnvEsoParaNao = TRUE) THEN
							SP_CONCATENAR_DES('LAYOUT', 'S-2220', l_Valor OUT);
		   				    SP_E_SOCIAL_SM('S-3000', 'R110MAM', 'N', 'E', NULL, NULL, :NEW.NUMEMP, l_TipCol, l_NumCad, l_Valor, l_JsonCamposAlterados, 0, NULL, :OLD.DatAte, 0, 'R110MAM_AU');						
		  				END IF;
		  	
					END IF;
				END IF;
			END IF;
		END IF;
	END IF;
	/* eSocial S-2220 - Fim */
	/* Geração de logs Número do Atestado Médico (Tabela: R110MAM)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 117;     /* Número do Atestado Médico (Tabela: R110MAM)*/
  l_codtpa := 366;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodAte <> :NEW.CodAte)
   OR (:OLD.NumAte <> :NEW.NumAte)
   OR (:OLD.CodFic <> :NEW.CodFic)
   OR (:OLD.DatAte <> :NEW.DatAte)
   OR (:OLD.TipAte <> :NEW.TipAte)
   OR (:OLD.TipMam <> :NEW.TipMam)
   OR (:OLD.DiaAte <> :NEW.DiaAte)
   OR (:OLD.CodOco <> :NEW.CodOco)
   OR (:OLD.CodPar <> :NEW.CodPar)
   OR (:OLD.CodPos <> :NEW.CodPos)
   OR (:OLD.DesAte <> :NEW.DesAte)
   OR (:OLD.CodDoe <> :NEW.CodDoe)
   OR (:OLD.CodCid <> :NEW.CodCid)
   OR (:OLD.TipAso <> :NEW.TipAso)
   OR (:OLD.OriAte <> :NEW.OriAte)
   OR (:OLD.CodUsu <> :NEW.CodUsu)
   OR (:OLD.DatAfa <> :NEW.DatAfa)
   OR (:OLD.SitAte <> :NEW.SitAte)
   OR (:OLD.HorAfa <> :NEW.HorAfa)
   OR (:OLD.HorTer <> :NEW.HorTer)
   OR (:OLD.ObsAte <> :NEW.ObsAte)
   OR (:OLD.FimAte <> :NEW.FimAte)
   OR (:OLD.HorAte <> :NEW.HorAte)
   OR (:OLD.CodSub <> :NEW.CodSub)
   OR (:OLD.DatInc <> :NEW.DatInc)
   OR (:OLD.UltAlt <> :NEW.UltAlt)
   OR (:OLD.AciTra <> :NEW.AciTra)
   OR (:OLD.MsmMot <> :NEW.MsmMot)
   OR (:OLD.OrgCla <> :NEW.OrgCla)
   OR (:OLD.EstOrg <> :NEW.EstOrg)
   OR (:OLD.EnvEso <> :NEW.EnvEso)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110MAM_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR, :OLD.CODATE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMATE', CONVERT(NUMBER_TO_CHAR, :OLD.NUMATE));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110MAM_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN

        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODFIC', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODFIC', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIC));
        SP_DATSTR(:OLD.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATATE', l_datTemp);
        SP_DATSTR(:NEW.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATATE', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPATE', CONVERT(NUMBER_TO_CHAR, :OLD.TIPATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPATE', CONVERT(NUMBER_TO_CHAR, :NEW.TIPATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPMAM', CONVERT(NUMBER_TO_CHAR, :OLD.TIPMAM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPMAM', CONVERT(NUMBER_TO_CHAR, :NEW.TIPMAM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDIAATE', CONVERT(NUMBER_TO_CHAR, :OLD.DIAATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDIAATE', CONVERT(NUMBER_TO_CHAR, :NEW.DIAATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODOCO', CONVERT(NUMBER_TO_CHAR, :OLD.CODOCO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODOCO', CONVERT(NUMBER_TO_CHAR, :NEW.CODOCO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPAR', CONVERT(NUMBER_TO_CHAR, :OLD.CODPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPAR', CONVERT(NUMBER_TO_CHAR, :NEW.CODPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPOS', CONVERT(NUMBER_TO_CHAR, :OLD.CODPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPOS', CONVERT(NUMBER_TO_CHAR, :NEW.CODPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDESATE', :OLD.DESATE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDESATE', :NEW.DESATE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODDOE', :OLD.CODDOE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODDOE', :NEW.CODDOE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCID', :OLD.CODCID);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCID', :NEW.CODCID);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPASO', CONVERT(NUMBER_TO_CHAR, :OLD.TIPASO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPASO', CONVERT(NUMBER_TO_CHAR, :NEW.TIPASO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDORIATE', :OLD.ORIATE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWORIATE', :NEW.ORIATE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODUSU', CONVERT(NUMBER_TO_CHAR, :OLD.CODUSU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODUSU', CONVERT(NUMBER_TO_CHAR, :NEW.CODUSU));
        SP_DATSTR(:OLD.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATAFA', l_datTemp);
        SP_DATSTR(:NEW.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATAFA', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSITATE', CONVERT(NUMBER_TO_CHAR, :OLD.SITATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSITATE', CONVERT(NUMBER_TO_CHAR, :NEW.SITATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORAFA', CONVERT(NUMBER_TO_CHAR, :OLD.HORAFA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORAFA', CONVERT(NUMBER_TO_CHAR, :NEW.HORAFA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORTER', CONVERT(NUMBER_TO_CHAR, :OLD.HORTER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORTER', CONVERT(NUMBER_TO_CHAR, :NEW.HORTER));
        IF (:OLD.OBSATE <> :NEW.OBSATE) THEN
        	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSATE', 'alterado (excede limite de exibição)');
        	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSATE', 'alterado (excede limite de exibição)');
        ELSE
        	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSATE', 'não houve alteração (excede limite de exibição)');
        	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSATE', 'não houve alteração (excede limite de exibição)');
        END IF;
        SP_DATSTR(:OLD.FIMATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFIMATE', l_datTemp);
        SP_DATSTR(:NEW.FIMATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFIMATE', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORATE', CONVERT(NUMBER_TO_CHAR, :OLD.HORATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORATE', CONVERT(NUMBER_TO_CHAR, :NEW.HORATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODSUB', :OLD.CODSUB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODSUB', :NEW.CODSUB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATINC', CONVERT(NUMBER_TO_CHAR, :OLD.DATINC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATINC', CONVERT(NUMBER_TO_CHAR, :NEW.DATINC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDULTALT', CONVERT(NUMBER_TO_CHAR, :OLD.ULTALT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWULTALT', CONVERT(NUMBER_TO_CHAR, :NEW.ULTALT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDACITRA', CONVERT(NUMBER_TO_CHAR, :OLD.ACITRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWACITRA', CONVERT(NUMBER_TO_CHAR, :NEW.ACITRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDMSMMOT', :OLD.MSMMOT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWMSMMOT', :NEW.MSMMOT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDORGCLA', CONVERT(NUMBER_TO_CHAR, :OLD.ORGCLA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWORGCLA', CONVERT(NUMBER_TO_CHAR, :NEW.ORGCLA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDESTORG', :OLD.ESTORG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWESTORG', :NEW.ESTORG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENVESO', :OLD.ENVESO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENVESO', :NEW.ENVESO);     
      END;
    END IF; 
  END IF; 
END␀zß␀␀		SENIOR;0ï␀␀

TRIGGER R110MAM_AD AFTER DELETE ON R110MAM FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataInicioSST DATE;
	l_TipAtn NUMBER(1);
	l_AtnFic NUMBER(1);
	l_TipCol NUMBER(1);
	l_NumCad NUMBER(9);
	l_CodDep NUMBER(2);
	l_NumCan NUMBER(7);
	l_Valor VARCHAR2(2000);
	l_temAud       BOOLEAN;
    l_codRPA       NUMBER(15);
    l_codSistema   NUMBER(2);
    l_codcpa       NUMBER(4);
    l_codtpa       NUMBER(4);
    l_datTemp      VARCHAR(10);
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	
	/* eSocial S-2220 - Início */
	IF (:OLD.TipAso > 0) AND (:OLD.EnvEso = 'S') THEN
		RH_RET_DATINISST(:OLD.NumEmp, l_DataInicioSST OUT);
		IF (l_DataInicioSST > l_DataZero) THEN
			IF (:OLD.DatAte >= l_DataInicioSST) THEN
				RH_RETATNFICMED(:OLD.NumEmp, :OLD.CodFic, :OLD.DatAte, l_TipAtn OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
				RH_RETFICMED(:OLD.NumEmp, :OLD.CodFic, l_AtnFic OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);		
				IF (l_TipAtn = 1) OR (l_AtnFic = 1 AND :OLD.TipAso = 1 ) THEN /* 1 - Colaborador, 4 - Candidato. Se For um Candidato e ASO for Admissional, busca os dados vinculados diretamente na ficha médica */
					l_Valor := '';
					
					SP_CONCATENAR_NUM('CODATE', :OLD.CodAte, l_Valor OUT);
					SP_CONCATENAR_NUM('NUMATE', :OLD.NumAte, l_Valor OUT);
					SP_CONCATENAR_DAT('DATASO', :OLD.DatAte, l_Valor OUT);
					SP_CONCATENAR_DES('LAYOUT', 'S-2220', l_Valor OUT);
		
					SP_E_SOCIAL_SM('S-3000', 'R110MAM', 'N', 'E', NULL, NULL, :OLD.NUMEMP, l_TipCol, l_NumCad, l_Valor, '', 0, NULL, :OLD.DatAte, 0, 'R110MAM_AD');
				END IF;
			END IF;
		END IF;
	END IF;
	/* eSocial S-2220 - Fim */
	/* Geração de logs Número do Atestado Médico (Tabela: R110MAM)*/ 
	l_codSistema := 1;  /* Código do sistema vetorh. */
	l_codcpa := 117;     /* Número do Atestado Médico (Tabela: R110MAM)*/
	l_codtpa := 365;
	
	SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
	  SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110MAM_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR, :OLD.CODATE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMATE', CONVERT(NUMBER_TO_CHAR, :OLD.NUMATE));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110MAM_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIC));
        SP_DATSTR(:OLD.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPATE', CONVERT(NUMBER_TO_CHAR, :OLD.TIPATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPMAM', CONVERT(NUMBER_TO_CHAR, :OLD.TIPMAM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAATE', CONVERT(NUMBER_TO_CHAR, :OLD.DIAATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOCO', CONVERT(NUMBER_TO_CHAR, :OLD.CODOCO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPAR', CONVERT(NUMBER_TO_CHAR, :OLD.CODPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPOS', CONVERT(NUMBER_TO_CHAR, :OLD.CODPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESATE', :OLD.DESATE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDOE', :OLD.CODDOE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCID', :OLD.CODCID);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPASO', CONVERT(NUMBER_TO_CHAR, :OLD.TIPASO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORIATE', :OLD.ORIATE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR, :OLD.CODUSU));
        SP_DATSTR(:OLD.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAFA', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITATE', CONVERT(NUMBER_TO_CHAR, :OLD.SITATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORAFA', CONVERT(NUMBER_TO_CHAR, :OLD.HORAFA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORTER', CONVERT(NUMBER_TO_CHAR, :OLD.HORTER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSATE', 'registro excluído (excede limite de exibição)');
        SP_DATSTR(:OLD.FIMATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMATE', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR, :OLD.HORATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSUB', :OLD.CODSUB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINC', CONVERT(NUMBER_TO_CHAR, :OLD.DATINC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ULTALT', CONVERT(NUMBER_TO_CHAR, :OLD.ULTALT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ACITRA', CONVERT(NUMBER_TO_CHAR, :OLD.ACITRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MSMMOT', :OLD.MSMMOT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORGCLA', CONVERT(NUMBER_TO_CHAR, :OLD.ORGCLA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTORG', :OLD.ESTORG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENVESO', :OLD.ENVESO);
      END;
  END IF;
  DELETE FROM R240EXA WHERE CODATE = :OLD.CodAte AND NUMATE = :OLD.NumAte;
