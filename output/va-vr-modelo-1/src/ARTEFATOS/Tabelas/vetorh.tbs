  LOOP
    R030FIL_ATUCON(p_tipope, p_numemp, l_codfil, l_tipins, l_numcgc, l_inscei, l_razsoc, 0, 0, p_nomemp);
  END LOOP;
END		SENIOR;24R030FIL_ATUCON
