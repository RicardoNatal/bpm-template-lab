PROCEDURE SP_FAIALU(P_NUMMAT VARCHAR2(15),P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56))
 IS

l_data_atual  DATE;
  l_striac      CHAR(4);
  l_strfac      CHAR(4);
  l_stript      CHAR(4);
  l_strfpt      CHAR(4);
  l_faidom_ace  VARCHAR2(255);
  l_faiseg_ace  VARCHAR2(255);
  l_faiter_ace  VARCHAR2(255);
  l_faiqua_ace  VARCHAR2(255);
  l_faiqui_ace  VARCHAR2(255);
  l_faisex_ace  VARCHAR2(255);
  l_faisab_ace  VARCHAR2(255);
  l_faidom_pto  VARCHAR2(255);
  l_faiseg_pto  VARCHAR2(255);
  l_faiter_pto  VARCHAR2(255);
  l_faiqua_pto  VARCHAR2(255);
  l_faiqui_pto  VARCHAR2(255);
  l_faisex_pto  VARCHAR2(255);
  l_faisab_pto  VARCHAR2(255);
  l_contfai     INTEGER;
  l_lengfai     INTEGER;
  l_data_zero   DATE;
  l_horseg      NUMBER(4);
  l_horter      NUMBER(4);
  l_horqua      NUMBER(4);
  l_horqui      NUMBER(4);
  l_horsex      NUMBER(4);
  l_horsab      NUMBER(4);
  l_hordom      NUMBER(4);
  l_dia_semana  NUMBER(1);
  l_tipcra      NUMBER(1);
  l_count       NUMBER(2);

  /* DISCIPLINAS DOS ALUNOS */
  CURSOR c_r073dia IS
  SELECT CURALU,CODFAS,CODDPF,TMAALU  FROM R073DIA WHERE
      NUMMAT = p_nummat AND DATINI <= l_data_atual AND ((DATFIM >= l_data_atual) OR (DATFIM = l_data_zero)) ORDER BY 1;
  TYPE t_r073dia IS RECORD(
      CURALU   R073DIA.CURALU%TYPE,
      CODFAS   R073DIA.CODFAS%TYPE,
      CODDPF   R073DIA.CODDPF%TYPE,
      TMAALU   R073DIA.TMAALU%TYPE);
  l_r073dia t_r073dia;

  /* HORÁRIOS */
  CURSOR c_r004fhr IS
  SELECT CODHOR,INIACE,FIMACE,INIPTO,FIMPTO FROM R004FHR;
  TYPE t_r004fhr IS RECORD(
      CODHOR   R004FHR.CODHOR%TYPE,
      INIACE   R004FHR.INIACE%TYPE,
      FIMACE   R004FHR.FIMACE%TYPE,
      INIPTO   R004FHR.INIPTO%TYPE,
      FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;

  /* ATIVIDADES DO ALUNO*/
  CURSOR c_r073ata IS
  SELECT NUMMAT,DATINI,DATFIM,HORSEG,HORTER,HORQUA,HORQUI,HORSEX,HORSAB,HORDOM
      FROM R073ATA WHERE
      NUMMAT = p_nummat AND DATINI <= l_data_atual AND ((DATFIM >= l_data_atual) OR (DATFIM = l_data_zero))
      ORDER BY 1;
  TYPE t_r073ata IS RECORD(
      NUMMAT   R073ATA.NUMMAT%TYPE,
      DATINI   R073ATA.DATINI%TYPE,
      DATFIM   R073ATA.DATFIM%TYPE,
      HORSEG   R073ATA.HORSEG%TYPE,
      HORTER   R073ATA.HORTER%TYPE,
      HORQUA   R073ATA.HORQUA%TYPE,
      HORQUI   R073ATA.HORQUI%TYPE,
      HORSEX   R073ATA.HORSEX%TYPE,
      HORSAB   R073ATA.HORSAB%TYPE,
      HORDOM   R073ATA.HORDOM%TYPE);
  l_r073ata t_r073ata;

  /* AUTORIZAÇÃO DE SAÍDA */
  CURSOR c_r073asa IS
  SELECT DATASA, HORASA,HORTER FROM R073ASA WHERE NUMMAT = p_nummat AND DATASA = l_data_atual;
  TYPE t_r073asa IS RECORD(
      DATASA   R073ASA.DATASA%TYPE,
      HORASA   R073ASA.HORASA%TYPE,
      HORTER   R073ASA.HORTER%TYPE);
  l_r073asa t_r073asa;

  /*CURSOR para Verificar as Liberações de Faixas Horárias*/
  CURSOR c_r070lfh IS
  SELECT A.NUMCRA, A.DATLIB, A.HORINI, A.HORFIM FROM
             R070LFH A, R073HCH B WHERE A.DATLIB >= l_data_atual AND B.TIPCRA = l_tipcra AND B.STAATU = 1 AND
             A.NUMCRA = B.NUMCRA AND B.NUMMAT = p_nummat AND
             ((A.DATLIB > B.DATINI) OR (A.DATLIB = B.DATINI AND A.HORINI >= B.HORINI)) AND
             ((B.DATINI < l_data_atual) OR (B.DATINI = l_data_atual)) AND
             ((B.DATFIM > l_data_atual) OR (B.DATFIM = l_data_atual) OR B.DATFIM = l_data_zero);
  TYPE t_r070lfh IS RECORD(
    NUMCRA   R070LFH.NUMCRA%TYPE,
    DATLIB   R070LFH.DATLIB%TYPE,
    HORINI   R070LFH.HORINI%TYPE,
    HORFIM   R070LFH.HORFIM%TYPE);
  l_r070lfh t_r070lfh;

BEGIN
  /* Inicializa */
  l_data_zero := '31/12/1900,00:00:00';
  l_data_atual:= CURDATE();

  l_faidom_ace  := '';
  l_faiseg_ace  := '';
  l_faiter_ace  := '';
  l_faiqua_ace  := '';
  l_faiqui_ace  := '';
  l_faisex_ace  := '';
  l_faisab_ace  := '';
  l_faidom_pto  := '';
  l_faiseg_pto  := '';
  l_faiter_pto  := '';
  l_faiqua_pto  := '';
  l_faiqui_pto  := '';
  l_faisex_pto  := '';
  l_faisab_pto  := '';

  /* LOOP para pegar as disciplinas do aluno */
  FOREACH c_r073dia INTO l_r073dia.curalu,
                         l_r073dia.codfas,
                         l_r073dia.coddpf,
                         l_r073dia.tmaalu
  LOOP
      BEGIN
          SELECT HORSEG,HORTER,HORQUA,HORQUI,HORSEX,HORSAB,HORDOM
          INTO l_horseg,l_horter,l_horqua,l_horqui,l_horsex,l_horsab,l_hordom
          FROM R073DPF WHERE CURALU = l_r073dia.curalu AND CODFAS = l_r073dia.codfas
          AND CODDPF = l_r073dia.coddpf AND TMAALU = l_r073dia.tmaAlu;
      EXCEPTION
          WHEN OTHERS THEN EXIT;
      END;

      FOREACH c_r004fhr INTO l_r004fhr.codhor,
                             l_r004fhr.iniace,
                             l_r004fhr.fimace,
                             l_r004fhr.inipto,
                             l_r004fhr.fimpto
      LOOP
          SP_INTSTR(l_r004fhr.iniace,'HHMM',l_striac OUT);
          SP_INTSTR(l_r004fhr.fimace,'HHMM',l_strfac OUT);
          SP_INTSTR(l_r004fhr.inipto,'HHMM',l_stript OUT);
          SP_INTSTR(l_r004fhr.fimpto,'HHMM',l_strfpt OUT);

          IF  (l_r004fhr.codhor = l_hordom) THEN
              /* domingo */
              IF  ((LENGTH(l_faidom_ace)) < 49) OR ((LENGTH(l_faidom_ace) IS NULL)) THEN
                  l_faidom_ace := l_faidom_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faidom_pto)) < 49) OR ((LENGTH(l_faidom_pto) IS NULL)) THEN
                  l_faidom_pto := l_faidom_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_horseg) THEN
              /* segunda-feira */
              IF  ((LENGTH(l_faiseg_ace)) < 49) OR ((LENGTH(l_faiseg_ace) IS NULL)) THEN
                  l_faiseg_ace := l_faiseg_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiseg_pto)) < 49) OR ((LENGTH(l_faiseg_pto) IS NULL)) THEN
                  l_faiseg_pto := l_faiseg_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_horter) THEN
              /* terça-feira */
              IF  ((LENGTH(l_faiter_ace)) < 49) OR ((LENGTH(l_faiter_ace) IS NULL)) THEN
                  l_faiter_ace := l_faiter_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiter_pto)) < 49) OR ((LENGTH(l_faiter_pto) IS NULL)) THEN
                  l_faiter_pto := l_faiter_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_horqua) THEN
              /* quarta-feira */
              IF  ((LENGTH(l_faiqua_ace)) < 49) OR ((LENGTH(l_faiqua_ace) IS NULL)) THEN
                  l_faiqua_ace := l_faiqua_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiqua_pto)) < 49) OR ((LENGTH(l_faiqua_pto) IS NULL)) THEN
                  l_faiqua_pto := l_faiqua_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_horqui) THEN
              /* quinta-feira */
              IF  ((LENGTH(l_faiqui_ace)) < 49) OR ((LENGTH(l_faiqui_ace) IS NULL)) THEN
                  l_faiqui_ace := l_faiqui_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiqui_pto)) < 49) OR ((LENGTH(l_faiqui_pto) IS NULL)) THEN
                  l_faiqui_pto := l_faiqui_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_horsex) THEN
              /* sexta-feira */
              IF  ((LENGTH(l_faisex_ace)) < 49) OR ((LENGTH(l_faisex_ace) IS NULL)) THEN
                  l_faisex_ace := l_faisex_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faisex_pto)) < 49) OR ((LENGTH(l_faisex_pto) IS NULL)) THEN
                  l_faisex_pto := l_faisex_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_horsab) THEN
              /* sábado */
              IF  ((LENGTH(l_faisab_ace)) < 49) OR ((LENGTH(l_faisab_ace) IS NULL)) THEN
                  l_faisab_ace := l_faisab_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faisab_pto)) < 49) OR ((LENGTH(l_faisab_pto) IS NULL)) THEN
                  l_faisab_pto := l_faisab_pto || l_stript || l_strfpt;
              END IF;
          END IF;
      END LOOP; /* LOOP r004fhr */
  END LOOP; /* LOOP r073dia */

  /* Atividades do Aluno */
  /* LOOP para pegar as atividades do aluno */
  FOREACH c_r073ata INTO l_r073ata.nummat,
                         l_r073ata.DATINI,
                         l_r073ata.DATFIM,
                         l_r073ata.horseg,
                         l_r073ata.horter,
                         l_r073ata.horqua,
                         l_r073ata.horqui,
                         l_r073ata.horsex,
                         l_r073ata.horsab,
                         l_r073ata.hordom
  LOOP
      FOREACH c_r004fhr INTO l_r004fhr.codhor,
                             l_r004fhr.iniace,
                             l_r004fhr.fimace,
                             l_r004fhr.inipto,
                             l_r004fhr.fimpto
      LOOP
          SP_INTSTR(l_r004fhr.iniace,'HHMM',l_striac OUT);
          SP_INTSTR(l_r004fhr.fimace,'HHMM',l_strfac OUT);
          SP_INTSTR(l_r004fhr.inipto,'HHMM',l_stript OUT);
          SP_INTSTR(l_r004fhr.fimpto,'HHMM',l_strfpt OUT);

          IF  (l_r004fhr.codhor = l_r073ata.hordom) THEN
              /* domingo */
              IF  ((LENGTH(l_faidom_ace)) < 49) OR ((LENGTH(l_faidom_ace) IS NULL)) THEN
                  l_faidom_ace := l_faidom_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faidom_pto)) < 49) OR ((LENGTH(l_faidom_pto) IS NULL)) THEN
                  l_faidom_pto := l_faidom_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_r073ata.horseg) THEN
              /* segunda-feira */
              IF  ((LENGTH(l_faiseg_ace)) < 49) OR ((LENGTH(l_faiseg_ace) IS NULL)) THEN
                  l_faiseg_ace := l_faiseg_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiseg_pto)) < 49) OR ((LENGTH(l_faiseg_pto) IS NULL)) THEN
                  l_faiseg_pto := l_faiseg_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_r073ata.horter) THEN
              /* terça-feira */
              IF  ((LENGTH(l_faiter_ace)) < 49) OR ((LENGTH(l_faiter_ace) IS NULL)) THEN
                  l_faiter_ace := l_faiter_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiter_pto)) < 49) OR ((LENGTH(l_faiter_pto) IS NULL)) THEN
                  l_faiter_pto := l_faiter_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_r073ata.horqua) THEN
              /* quarta-feira */
              IF  ((LENGTH(l_faiqua_ace)) < 49) OR ((LENGTH(l_faiqua_ace) IS NULL)) THEN
                  l_faiqua_ace := l_faiqua_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiqua_pto)) < 49) OR ((LENGTH(l_faiqua_pto) IS NULL)) THEN
                  l_faiqua_pto := l_faiqua_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_r073ata.horqui) THEN
              /* quinta-feira */
              IF  ((LENGTH(l_faiqui_ace)) < 49) OR ((LENGTH(l_faiqui_ace) IS NULL)) THEN
                  l_faiqui_ace := l_faiqui_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiqui_pto)) < 49) OR ((LENGTH(l_faiqui_pto) IS NULL)) THEN
                  l_faiqui_pto := l_faiqui_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_r073ata.horsex) THEN
              /* sexta-feira */
              IF  ((LENGTH(l_faisex_ace)) < 49) OR ((LENGTH(l_faisex_ace) IS NULL)) THEN
                  l_faisex_ace := l_faisex_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faisex_pto)) < 49) OR ((LENGTH(l_faisex_pto) IS NULL)) THEN
                  l_faisex_pto := l_faisex_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_r073ata.horsab) THEN
              /* sábado */
              IF  ((LENGTH(l_faisab_ace)) < 49) OR ((LENGTH(l_faisab_ace) IS NULL)) THEN
                  l_faisab_ace := l_faisab_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faisab_pto)) < 49) OR ((LENGTH(l_faisab_pto) IS NULL)) THEN
                  l_faisab_pto := l_faisab_pto || l_stript || l_strfpt;
              END IF;
          END IF;
      END LOOP; /* LOOP r004fhr */
  END LOOP; /* LOOP r073ata */


  /* Autorização de Saída */
  FOREACH c_r073asa INTO l_r073asa.datasa,
                         l_r073asa.horasa,
                         l_r073asa.horter
  LOOP
      SP_INTSTR(l_r073asa.horasa,'HHMM',l_striac OUT);
      SP_INTSTR(l_r073asa.horter,'HHMM',l_strfac OUT);
      SP_INTSTR(l_r073asa.horasa,'HHMM',l_stript OUT);
      SP_INTSTR(l_r073asa.horter,'HHMM',l_strfpt OUT);

      l_dia_semana := DAYOFWEEK(l_r073asa.datasa);
      IF    l_dia_semana = 1 THEN /* domingo */
            IF  ((LENGTH(l_faidom_ace)) < 49) OR ((LENGTH(l_faidom_ace) IS NULL)) THEN
                l_faidom_ace := l_faidom_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faidom_pto)) < 49) OR ((LENGTH(l_faidom_pto) IS NULL)) THEN
                l_faidom_pto := l_faidom_pto || l_stript || l_strfpt;
            END IF;
      ELSIF l_dia_semana = 2 THEN /* segunda */
            IF  ((LENGTH(l_faiseg_ace)) < 49) OR ((LENGTH(l_faiseg_ace) IS NULL)) THEN
                l_faiseg_ace := l_faiseg_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faiseg_pto)) < 49) OR ((LENGTH(l_faiseg_pto) IS NULL)) THEN
                l_faiseg_pto := l_faiseg_pto || l_stript || l_strfpt;
            END IF;
      ELSIF l_dia_semana = 3 THEN /* terca */
            IF  ((LENGTH(l_faiter_ace)) < 49) OR ((LENGTH(l_faiter_ace) IS NULL)) THEN
                l_faiter_ace := l_faiter_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faiter_pto)) < 49) OR ((LENGTH(l_faiter_pto) IS NULL)) THEN
                l_faiter_pto := l_faiter_pto || l_stript || l_strfpt;
            END IF;
      ELSIF l_dia_semana = 4 THEN /* quarta */
            IF  ((LENGTH(l_faiqua_ace)) < 49) OR ((LENGTH(l_faiqua_ace) IS NULL)) THEN
                l_faiqua_ace := l_faiqua_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faiqua_pto)) < 49) OR ((LENGTH(l_faiqua_pto) IS NULL)) THEN
                l_faiqua_pto := l_faiqua_pto || l_stript || l_strfpt;
            END IF;
      ELSIF l_dia_semana = 5 THEN /* quinta */
            IF  ((LENGTH(l_faiqui_ace)) < 49) OR ((LENGTH(l_faiqui_ace) IS NULL)) THEN
                l_faiqui_ace := l_faiqui_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faiqui_pto)) < 49) OR ((LENGTH(l_faiqui_pto) IS NULL)) THEN
                l_faiqui_pto := l_faiqui_pto || l_stript || l_strfpt;
            END IF;
      ELSIF l_dia_semana = 6 THEN /* sexta */
            IF  ((LENGTH(l_faisex_ace)) < 49) OR ((LENGTH(l_faisex_ace) IS NULL)) THEN
                l_faisex_ace := l_faisex_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faisex_pto)) < 49) OR ((LENGTH(l_faisex_pto) IS NULL)) THEN
                l_faisex_pto := l_faisex_pto || l_stript || l_strfpt;
            END IF;
      ELSIF  l_dia_semana = 7 THEN /* sábado */
            IF  ((LENGTH(l_faisab_ace)) < 49) OR ((LENGTH(l_faisab_ace) IS NULL)) THEN
                l_faisab_ace := l_faisab_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faisab_pto)) < 49) OR ((LENGTH(l_faisab_pto) IS NULL)) THEN
                l_faisab_pto := l_faisab_pto || l_stript || l_strfpt;
            END IF;
      END IF;
  END LOOP; /* LOOP r073asa */

  l_tipcra := 2;
  l_count := 0;
  /*Verifica Liberação de Faixa Horária para Crachá Provisório*/
  FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM LOOP
      SP_INTSTR(l_r070lfh.HORINI,'HHMM',l_striac OUT);
      SP_INTSTR(l_r070lfh.HORFIM,'HHMM',l_strfac OUT);
      SP_INTSTR(l_r070lfh.HORINI,'HHMM',l_stript OUT);
      SP_INTSTR(l_r070lfh.HORFIM,'HHMM',l_strfpt OUT);
      l_dia_semana := DAYOFWEEK(l_r070lfh.datlib);
      IF    l_dia_semana = 1 THEN /* domingo */
            IF  ((LENGTH(l_faidom_ace)) < 49) OR ((LENGTH(l_faidom_ace) IS NULL)) THEN
                l_faidom_ace := l_faidom_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faidom_pto)) < 49) OR ((LENGTH(l_faidom_pto) IS NULL)) THEN
                l_faidom_pto := l_faidom_pto || l_stript || l_strfpt;
            END IF;
      ELSIF l_dia_semana = 2 THEN /* segunda */
            IF  ((LENGTH(l_faiseg_ace)) < 49) OR ((LENGTH(l_faiseg_ace) IS NULL)) THEN
                l_faiseg_ace := l_faiseg_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faiseg_pto)) < 49) OR ((LENGTH(l_faiseg_pto) IS NULL)) THEN
                l_faiseg_pto := l_faiseg_pto || l_stript || l_strfpt;
            END IF;
      ELSIF l_dia_semana = 3 THEN /* terca */
            IF  ((LENGTH(l_faiter_ace)) < 49) OR ((LENGTH(l_faiter_ace) IS NULL)) THEN
                l_faiter_ace := l_faiter_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faiter_pto)) < 49) OR ((LENGTH(l_faiter_pto) IS NULL)) THEN
                l_faiter_pto := l_faiter_pto || l_stript || l_strfpt;
            END IF;
      ELSIF l_dia_semana = 4 THEN /* quarta */
            IF  ((LENGTH(l_faiqua_ace)) < 49) OR ((LENGTH(l_faiqua_ace) IS NULL)) THEN
                l_faiqua_ace := l_faiqua_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faiqua_pto)) < 49) OR ((LENGTH(l_faiqua_pto) IS NULL)) THEN
                l_faiqua_pto := l_faiqua_pto || l_stript || l_strfpt;
            END IF;
      ELSIF l_dia_semana = 5 THEN /* quinta */
            IF  ((LENGTH(l_faiqui_ace)) < 49) OR ((LENGTH(l_faiqui_ace) IS NULL)) THEN
                l_faiqui_ace := l_faiqui_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faiqui_pto)) < 49) OR ((LENGTH(l_faiqui_pto) IS NULL)) THEN
                l_faiqui_pto := l_faiqui_pto || l_stript || l_strfpt;
            END IF;
      ELSIF l_dia_semana = 6 THEN /* sexta */
            IF  ((LENGTH(l_faisex_ace)) < 49) OR ((LENGTH(l_faisex_ace) IS NULL)) THEN
                l_faisex_ace := l_faisex_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faisex_pto)) < 49) OR ((LENGTH(l_faisex_pto) IS NULL)) THEN
                l_faisex_pto := l_faisex_pto || l_stript || l_strfpt;
            END IF;
      ELSIF  l_dia_semana = 7 THEN /* sábado */
            IF  ((LENGTH(l_faisab_ace)) < 49) OR ((LENGTH(l_faisab_ace) IS NULL)) THEN
                l_faisab_ace := l_faisab_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faisab_pto)) < 49) OR ((LENGTH(l_faisab_pto) IS NULL)) THEN
                l_faisab_pto := l_faisab_pto || l_stript || l_strfpt;
            END IF;
      END IF;
      l_count := l_count + 1;
  END LOOP; /* LOOP r070lfh para provisórios. */

  IF l_count = 0 THEN
      l_tipcra := 1;
      /*Verifica Liberação de Faixa Horária para Crachá Titular*/
      FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM LOOP
          SP_INTSTR(l_r070lfh.HORINI,'HHMM',l_striac OUT);
          SP_INTSTR(l_r070lfh.HORFIM,'HHMM',l_strfac OUT);
          SP_INTSTR(l_r070lfh.HORINI,'HHMM',l_stript OUT);
          SP_INTSTR(l_r070lfh.HORFIM,'HHMM',l_strfpt OUT);
          l_dia_semana := DAYOFWEEK(l_r070lfh.datlib);
          IF    l_dia_semana = 1 THEN /* domingo */
                IF  ((LENGTH(l_faidom_ace)) < 49) OR ((LENGTH(l_faidom_ace) IS NULL)) THEN
                    l_faidom_ace := l_faidom_ace || l_striac || l_strfac;
                END IF;
                IF  ((LENGTH(l_faidom_pto)) < 49) OR ((LENGTH(l_faidom_pto) IS NULL)) THEN
                    l_faidom_pto := l_faidom_pto || l_stript || l_strfpt;
                END IF;
          ELSIF l_dia_semana = 2 THEN /* segunda */
                IF  ((LENGTH(l_faiseg_ace)) < 49) OR ((LENGTH(l_faiseg_ace) IS NULL)) THEN
                    l_faiseg_ace := l_faiseg_ace || l_striac || l_strfac;
                END IF;
                IF  ((LENGTH(l_faiseg_pto)) < 49) OR ((LENGTH(l_faiseg_pto) IS NULL)) THEN
                    l_faiseg_pto := l_faiseg_pto || l_stript || l_strfpt;
                END IF;
          ELSIF l_dia_semana = 3 THEN /* terca */
                IF  ((LENGTH(l_faiter_ace)) < 49) OR ((LENGTH(l_faiter_ace) IS NULL)) THEN
                    l_faiter_ace := l_faiter_ace || l_striac || l_strfac;
                END IF;
                IF  ((LENGTH(l_faiter_pto)) < 49) OR ((LENGTH(l_faiter_pto) IS NULL)) THEN
                    l_faiter_pto := l_faiter_pto || l_stript || l_strfpt;
                END IF;
          ELSIF l_dia_semana = 4 THEN /* quarta */
                IF  ((LENGTH(l_faiqua_ace)) < 49) OR ((LENGTH(l_faiqua_ace) IS NULL)) THEN
                    l_faiqua_ace := l_faiqua_ace || l_striac || l_strfac;
                END IF;
                IF  ((LENGTH(l_faiqua_pto)) < 49) OR ((LENGTH(l_faiqua_pto) IS NULL)) THEN
                    l_faiqua_pto := l_faiqua_pto || l_stript || l_strfpt;
                END IF;
          ELSIF l_dia_semana = 5 THEN /* quinta */
                IF  ((LENGTH(l_faiqui_ace)) < 49) OR ((LENGTH(l_faiqui_ace) IS NULL)) THEN
                    l_faiqui_ace := l_faiqui_ace || l_striac || l_strfac;
                END IF;
                IF  ((LENGTH(l_faiqui_pto)) < 49) OR ((LENGTH(l_faiqui_pto) IS NULL)) THEN
                    l_faiqui_pto := l_faiqui_pto || l_stript || l_strfpt;
                END IF;
          ELSIF l_dia_semana = 6 THEN /* sexta */
                IF  ((LENGTH(l_faisex_ace)) < 49) OR ((LENGTH(l_faisex_ace) IS NULL)) THEN
                    l_faisex_ace := l_faisex_ace || l_striac || l_strfac;
                END IF;
                IF  ((LENGTH(l_faisex_pto)) < 49) OR ((LENGTH(l_faisex_pto) IS NULL)) THEN
                    l_faisex_pto := l_faisex_pto || l_stript || l_strfpt;
                END IF;
          ELSIF  l_dia_semana = 7 THEN /* sábado */
                IF  ((LENGTH(l_faisab_ace)) < 49) OR ((LENGTH(l_faisab_ace) IS NULL)) THEN
                    l_faisab_ace := l_faisab_ace || l_striac || l_strfac;
                END IF;
                IF  ((LENGTH(l_faisab_pto)) < 49) OR ((LENGTH(l_faisab_pto) IS NULL)) THEN
                    l_faisab_pto := l_faisab_pto || l_stript || l_strfpt;
                END IF;
          END IF;
      END LOOP; /* LOOP r070lfh para cracha principal. */
  END IF;

  /* PREENCHE O RESTO DO CAMPO COM 2400 */
  l_faidom_ace := IFNULL(l_faidom_ace,'');
  IF  (l_faidom_ace IS NULL) OR (l_faidom_ace = '') THEN
      l_lengfai := 7;
      l_faidom_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faidom_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faidom_ace := l_faidom_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faidom_pto := IFNULL(l_faidom_pto,'');
  IF  (l_faidom_pto IS NULL) OR (l_faidom_pto = '') THEN
      l_lengfai := 7;
      l_faidom_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faidom_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faidom_pto := l_faidom_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiseg_ace := IFNULL(l_faiseg_ace,'');
  IF  (l_faiseg_ace IS NULL) OR (l_faiseg_ace = '') THEN
      l_lengfai := 7;
      l_faiseg_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiseg_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiseg_ace := l_faiseg_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiseg_pto := IFNULL(l_faiseg_pto,'');
  IF  (l_faiseg_pto IS NULL) OR (l_faiseg_pto = '') THEN
      l_lengfai := 7;
      l_faiseg_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiseg_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiseg_pto := l_faiseg_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiter_ace := IFNULL(l_faiter_ace,'');
  IF  (l_faiter_ace IS NULL) OR (l_faiter_ace = '') THEN
      l_lengfai := 7;
      l_faiter_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiter_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiter_ace := l_faiter_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiter_pto := IFNULL(l_faiter_pto,'');
  IF  (l_faiter_pto IS NULL) OR (l_faiter_pto = '') THEN
      l_lengfai := 7;
      l_faiter_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiter_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiter_pto := l_faiter_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqua_ace := IFNULL(l_faiqua_ace,'');
  IF  (l_faiqua_ace IS NULL) OR (l_faiqua_ace = '') THEN
      l_lengfai := 7;
      l_faiqua_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqua_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqua_ace := l_faiqua_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqua_pto := IFNULL(l_faiqua_pto,'');
  IF  (l_faiqua_pto IS NULL) OR (l_faiqua_pto = '') THEN
      l_lengfai := 7;
      l_faiqua_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqua_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqua_pto := l_faiqua_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqui_ace := IFNULL(l_faiqui_ace,'');
  IF  (l_faiqui_ace IS NULL) OR (l_faiqui_ace = '') THEN
      l_lengfai := 7;
      l_faiqui_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqui_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqui_ace := l_faiqui_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqui_pto := IFNULL(l_faiqui_pto,'');
  IF  (l_faiqui_pto IS NULL) OR (l_faiqui_pto = '') THEN
      l_lengfai := 7;
      l_faiqui_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqui_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqui_pto := l_faiqui_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisex_ace := IFNULL(l_faisex_ace,'');
  IF  (l_faisex_ace IS NULL) OR (l_faisex_ace = '') THEN
      l_lengfai := 7;
      l_faisex_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisex_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisex_ace := l_faisex_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisex_pto := IFNULL(l_faisex_pto,'');
  IF  (l_faisex_pto IS NULL) OR (l_faisex_pto = '') THEN
      l_lengfai := 7;
      l_faisex_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisex_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisex_pto := l_faisex_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisab_ace := IFNULL(l_faisab_ace,'');
  IF  (l_faisab_ace IS NULL) OR (l_faisab_ace = '') THEN
      l_lengfai := 7;
      l_faisab_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisab_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisab_ace := l_faisab_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisab_pto := IFNULL(l_faisab_pto,'');
  IF  (l_faisab_pto IS NULL) OR (l_faisab_pto = '') THEN
      l_lengfai := 7;
      l_faisab_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisab_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisab_pto := l_faisab_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  /* monta a faixa do refeitorio que deve sempre comecar pelo domingo. */
  p_fairef := '24002400240024002400240024002400240024002400240024002400';

  l_faidom_ace  := SUBSTRING(l_faidom_ace,1,56);
  l_faiseg_ace  := SUBSTRING(l_faiseg_ace,1,56);
  l_faiter_ace  := SUBSTRING(l_faiter_ace,1,56);
  l_faiqua_ace  := SUBSTRING(l_faiqua_ace,1,56);
  l_faiqui_ace  := SUBSTRING(l_faiqui_ace,1,56);
  l_faisex_ace  := SUBSTRING(l_faisex_ace,1,56);
  l_faisab_ace  := SUBSTRING(l_faisab_ace,1,56);
  l_faidom_pto  := SUBSTRING(l_faidom_pto,1,56);
  l_faiseg_pto  := SUBSTRING(l_faiseg_pto,1,56);
  l_faiter_pto  := SUBSTRING(l_faiter_pto,1,56);
  l_faiqua_pto  := SUBSTRING(l_faiqua_pto,1,56);
  l_faiqui_pto  := SUBSTRING(l_faiqui_pto,1,56);
  l_faisex_pto  := SUBSTRING(l_faisex_pto,1,56);
  l_faisab_pto  := SUBSTRING(l_faisab_pto,1,56);

  p_faidom_ace  := l_faidom_ace;
  p_faiseg_ace  := l_faiseg_ace;
  p_faiter_ace  := l_faiter_ace;
  p_faiqua_ace  := l_faiqua_ace;
  p_faiqui_ace  := l_faiqui_ace;
  p_faisex_ace  := l_faisex_ace;
  p_faisab_ace  := l_faisab_ace;
  p_faidom_pto  := l_faidom_pto;
  p_faiseg_pto  := l_faiseg_pto;
  p_faiter_pto  := l_faiter_pto;
  p_faiqua_pto  := l_faiqua_pto;
  p_faiqui_pto  := l_faiqui_pto;
  p_faisex_pto  := l_faisex_pto;
  p_faisab_pto  := l_faisab_pto;
END␀3ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0PRH_DATFIM
RH_RETHOR
SP_GRA004TMP
SP_UNEFAI
RH_DATFER
SP_INTSTR
SP_DATSTR
¦␀PROCEDURE SP_FAIHOR(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56),P_PRMSABEQUAL OUT NUMBER,P_PRMDOMEQUAL OUT NUMBER,P_PRMSEGEQUAL OUT NUMBER,P_DATINI OUT VARCHAR2(6),P_DATFIM OUT VARCHAR2(6),P_HORINI OUT VARCHAR2(4),P_HORFIM OUT VARCHAR2(4))
 IS

  l_data          DATE;
  l_datini        DATE;
  l_data_limite   DATE;
  l_dia_anterior  DATE;
  l_dia_posterior DATE;
  l_dia_semana  NUMBER(1);
  l_codhor      NUMBER(4);
  l_horant      NUMBER(4);
  l_horbu1      NUMBER(4);
  l_horbu2      NUMBER(4);
  l_horbu3      NUMBER(4);
  l_horbu4      NUMBER(4);
  l_horbu5      NUMBER(4);
  l_diafer      NUMBER(1);
  l_coderr      NUMBER(2);
  l_horref      NUMBER(5);
  l_codesc        R006ESC.CodEsc%TYPE;
  l_codtur      NUMBER(1);
  l_turint      NUMBER(9);
  l_codint      NUMBER(9);
  l_faiace      VARCHAR2(255);
  l_faipto      VARCHAR2(255);
  l_fairef      VARCHAR2(255);
  l_strini      CHAR(4);
  l_strfim      CHAR(4);
  l_horbat      INTEGER;
  l_total1      NUMBER(5);
  l_totalA      NUMBER(5);
  l_totalP      NUMBER(5);
  l_iniace      NUMBER(5);
  l_inipto      NUMBER(5);
  l_fimace      NUMBER(5);
  l_fimpto      NUMBER(5);
  l_iniref      NUMBER(5);
  l_faidom_ace  VARCHAR(56);
  l_faiseg_ace  VARCHAR(56);
  l_faiter_ace  VARCHAR(56);
  l_faiqua_ace  VARCHAR(56);
  l_faiqui_ace  VARCHAR(56);
  l_faisex_ace  VARCHAR(56);
  l_faisab_ace  VARCHAR(56);
  l_faidom_pto  VARCHAR(56);
  l_faiseg_pto  VARCHAR(56);
  l_faiter_pto  VARCHAR(56);
  l_faiqua_pto  VARCHAR(56);
  l_faiqui_pto  VARCHAR(56);
  l_faisex_pto  VARCHAR(56);
  l_faisab_pto  VARCHAR(56);
  l_faidom_ref  VARCHAR(08);
  l_faiseg_ref  VARCHAR(08);
  l_faiter_ref  VARCHAR(08);
  l_faiqua_ref  VARCHAR(08);
  l_faiqui_ref  VARCHAR(08);
  l_faisex_ref  VARCHAR(08);
  l_faisab_ref  VARCHAR(08);
  l_tipcnv      NUMBER(1);
  l_contfai     INTEGER;
  l_lengfai     INTEGER;
  l_cont        INTEGER;
  l_codfil      NUMBER(6);
  l_tipfer      CHAR;
  l_tabfer      NUMBER;
  l_turesc      NUMBER(3);
  l_feriado     BOOLEAN;
  l_perace      NUMBER(1);
  l_tipcmp      NUMBER(1);
  l_percmp      NUMBER(1);
  l_iniint      NUMBER(5);
  l_fimint      NUMBER(5);
  l_qtdhor      NUMBER(4);
  l_maxseq      NUMBER(2);
  l_jorhor      CHAR;
  l_hora_atual  NUMBER(4);
  l_datafa      DATE;
  l_datter      DATE;
  l_iniafa      CHAR(6);
  l_fimafa      CHAR(6);
  l_horafa      NUMBER(4);
  l_horter      NUMBER(4);
  l_data_zero   DATE;
  l_data2050    DATE;  
  l_datatu      DATE;
  l_datant      DATE;
  l_fimjor      NUMBER;
  l_TemAfa      BOOLEAN;
  l_jorace      NUMBER;  
  l_prifxA      NUMBER;
  l_prifxP      NUMBER;
  l_codHorAtu   NUMBER;
  l_numcra      NUMBER(12);
  l_HorIni      NUMBER(4);
  l_HorFim      NUMBER(4);
  l_curs        INTEGER;
  l_TipCra      NUMBER(1);
  l_seqhba        r006hba.seqreg%TYPE;
  l_alterado    BOOLEAN;

  /* PEGA AS FAIXAS HORARIAS DO HORARIO, AS PROGRAMAÇÕES DE HORAS EXTRAS */
  /* E OS AFASTAMENTOS CUJA ORIGEM FOR SAIDA AUTORIZADA */
  CURSOR c_r004fhr IS
    SELECT 1 CODREG, FHR.CODHOR CODHOR, CURDATE() DATINI, FHR.SEQFAI SEQFAI, FHR.INIACE INIACE, FHR.FIMACE FIMACE, FHR.INIPTO INIPTO, FHR.FIMPTO FIMPTO,
      CURDATE() DATFIM, 0 TOLAEA, 0 TOLASA, 0 TOLAEP, 0 TOLASP
    FROM R004FHR FHR WHERE NOT EXISTS (SELECT 1 FROM R004FHF WHERE R004FHF.CODHOR = FHR.CODHOR AND R004FHF.NUMEMP = p_numemp AND R004FHF.CODFIL = l_codfil) AND
             (FHR.CODHOR = l_codhor OR FHR.CODHOR = l_horbu1 OR
              FHR.CODHOR = l_horbu2 OR FHR.CODHOR = l_horbu3 OR
              FHR.CODHOR = l_horbu4 OR FHR.CODHOR = l_horbu5)
    UNION(
    SELECT 1 CODREG, FHF.CODHOR CODHOR, CURDATE() DATINI, FHF.SEQFAI SEQFAI, FHF.INIACE INIACE, FHF.FIMACE FIMACE, FHF.INIPTO INIPTO, FHF.FIMPTO FIMPTO,
      CURDATE() DATFIM, 0 TOLAEA, 0 TOLASA, 0 TOLAEP, 0 TOLASP
    FROM R004FHF FHF WHERE FHF.NUMEMP = p_numemp AND FHF.CODFIL = l_codfil AND
             (FHF.CODHOR = l_codhor OR FHF.CODHOR = l_horbu1 OR
              FHF.CODHOR = l_horbu2 OR FHF.CODHOR = l_horbu3 OR
              FHF.CODHOR = l_horbu4 OR FHF.CODHOR = l_horbu5)
    UNION
   (SELECT 2 CODREG, 0 CODHOR, DATINI, 0 SEQFAI, HORINI INIACE, HORFIM FIMACE, HORINI INIPTO, HORFIM FIMPTO, DATFIM, TOLAEA, TOLASA, TOLAEP, TOLASP
    FROM R064EXT WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI <= l_data AND DATFIM >= l_data
    UNION
   (SELECT 3 CODREG, 0 CODHOR, DATASA DATINI, 0 SEQFAI, HORASA INIACE, HORTER FIMACE, HORASA INIPTO, HORTER FIMPTO, DATASA DATFIM, 0 TOLAEA, 0 TOLASA, 0 TOLAEP, 0 TOLASP
    FROM R064ASA WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATASA = l_data)))
    ORDER BY 1,2,3,4;

  TYPE t_r004fhr IS RECORD(
    CODREG   R004FHR.CODHOR%TYPE,
    CODHOR   R004FHR.CODHOR%TYPE,
    DATINI DATE,
    SEQFAI   R004FHR.SEQFAI%TYPE,
    INIACE   R004FHR.INIACE%TYPE,
    FIMACE   R004FHR.FIMACE%TYPE,
    INIPTO   R004FHR.INIPTO%TYPE,
    FIMPTO   R004FHR.FIMPTO%TYPE,
    DATFIM DATE,
    TOLAEA   R064EXT.TOLAEA%TYPE,
    TOLASA   R064EXT.TOLASA%TYPE,
    TOLAEP   R064EXT.TOLAEP%TYPE,
    TOLASP   R064EXT.TOLASP%TYPE);
  l_r004fhr t_r004fhr;

  /* CURSOR QUE RETORNA AS FAIXAS HORARIAS DE ALMOCO. USO = REFEICAO OBRIGATORIA. */
  CURSOR c_r004mhr IS
  SELECT HORBAT,FAIMOV,SEQMAR FROM R004MHR WHERE USOBAT IN (4,6)
     AND CODHOR = l_codhor ORDER BY SEQMAR;
  TYPE t_r004MHR IS RECORD(
    HORBAT   R004MHR.HORBAT%TYPE,
    FAIMOV   R004MHR.FAIMOV%TYPE,
    SEQMAR   R004MHR.SEQMAR%TYPE);
  l_r004MHR t_r004MHR;

  /* CURSOR DA TABELA TEMPORARIA.. */
  CURSOR c_r004TMP IS
  SELECT DATHOR,TIPFAI,FAIINI,FAIFIM,TURTRB FROM R004TMP WHERE DATHOR = l_data AND NUMEMP = p_numemp AND
         TIPCOL = p_tipcol AND NUMCAD = p_numcad ORDER BY 1,2,3;
  TYPE t_r004TMP IS RECORD(
    DATHOR   R004TMP.DATHOR%TYPE,
    TIPFAI   R004TMP.TIPFAI%TYPE,
    FAIINI   R004TMP.FAIINI%TYPE,
    FAIFIM   R004TMP.FAIFIM%TYPE,
    TURTRB   R004TMP.TURTRB%TYPE);
  l_r004TMP t_r004TMP;

  /*CURSOR para Verificar as Liberações de Faixas Horárias*/
  CURSOR c_r070lfh IS
  SELECT A.NUMCRA, A.DATLIB, A.HORINI, A.HORFIM FROM R070LFH A, R038HCH B
             WHERE
             B.TIPCRA = l_tipcra AND B.STAACC = 1 AND ((A.DATLIB > B.DATINI) OR (A.DATLIB = B.DATINI AND A.HORINI >= B.HORINI)) AND
             A.NUMCRA = B.NUMCRA AND B.NUMEMP = p_numemp AND B.TIPCOL = p_tipcol AND B.NUMCAD = p_numcad AND
             ((B.DATINI < l_data) OR (B.DATINI = l_data)) AND
             ((B.DATFIM > l_data) OR (B.DATFIM = l_data) OR B.DATFIM = L_DATA_ZERO) AND
             ((A.DATLIB = l_data) OR
              (A.DATLIB = l_dia_anterior AND (A.HORINI > A.HORFIM) AND (A.HORFIM > l_hora_atual))
             );
  TYPE t_r070lfh IS RECORD(
    NUMCRA   R070LFH.NUMCRA%TYPE,
    DATLIB   R070LFH.DATLIB%TYPE,
    HORINI   R070LFH.HORINI%TYPE,
    HORFIM   R070LFH.HORFIM%TYPE);
  l_r070lfh t_r070lfh;

  /*CURSOR para verificar as compensações*/
  CURSOR c_r064cmp IS
  SELECT TIPCMP,PERCMP,INIINT,FIMINT,QTDHOR
    FROM R064CMP
   WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI <= l_data AND DATFIM >= l_data
     AND (TIPCMP = 5 OR TIPCMP = 6 OR (TIPCMP = 1 AND (PERCMP = 2 OR PERCMP = 4 OR PERCMP = 5 OR PERCMP = 6 OR PERCMP = 7)));
  TYPE t_r064cmp IS RECORD(
    TIPCMP   R064CMP.TIPCMP%TYPE,
    PERCMP   R064CMP.PERCMP%TYPE,
    INIINT   R064CMP.INIINT%TYPE,
    FIMINT   R064CMP.FIMINT%TYPE,
    QTDHOR   R064CMP.QTDHOR%TYPE);
  l_r064cmp t_r064cmp;  

  /* Declaracao para criar tabela temporária */
  CREATE_TEMP_TABLE R004TMP;
  
BEGIN

  /* Limpa tabela temporaria R004TMP */
  DELETE FROM R004TMP WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
  /* Verifica se a permissão de acesso é pela entrada ou pela saída */

  BEGIN
      SELECT PERACE INTO l_perace FROM R070DAC;
  EXCEPTION WHEN OTHERS THEN
      l_perace := 1;
  END;

  /* Inicializa */
  l_datini := CURDATE();
  /* começar um dia antes em caso de haver 3o. turno. */
  l_datini := DATETIMEADD(DD,-1,l_datini);
  l_data := l_datini;

  l_horant := 0;

  l_faidom_ace  := '';
  l_faiseg_ace  := '';
  l_faiter_ace  := '';
  l_faiqua_ace  := '';
  l_faiqui_ace  := '';
  l_faisex_ace  := '';
  l_faisab_ace  := '';
  l_faidom_pto  := '';
  l_faiseg_pto  := '';
  l_faiter_pto  := '';
  l_faiqua_pto  := '';
  l_faiqui_pto  := '';
  l_faisex_pto  := '';
  l_faisab_pto  := '';
  l_faidom_ref  := '';
  l_faiseg_ref  := '';
  l_faiter_ref  := '';
  l_faiqua_ref  := '';
  l_faiqui_ref  := '';
  l_faisex_ref  := '';
  l_faisab_ref  := '';
  l_data_zero   := '31/12/1900,00:00:00';
  l_data2050    := '31/12/2050,00:00:00';  
  l_datafa      := '';
  l_datter      := '';
  l_horafa      := 0 ;
  l_iniafa      := '';
  l_fimafa      := '';
  l_datatu      := CURDATE();
  l_datant      := DATETIMEADD(DD, -1, l_datatu);
  l_hora_atual  := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_fimjor      := 0;
  l_TemAfa      := TRUE;

  RH_DatFim (l_data_limite OUT);

  LOOP
    l_faiace := '';
    l_faipto := '';

    l_dia_anterior  := DATETIMEADD(DD, -1, l_data);
    l_dia_posterior := DATETIMEADD(DD, 1, l_data);

    l_diafer := 0;
    /* Pega o codigo do horário */
    RH_RetHor (p_numemp, p_tipcol, p_numcad, l_data, 1,
               l_codhor OUT, l_horbu1 OUT, l_horbu2 OUT, l_horbu3 OUT,
               l_horbu4 OUT, l_horbu5 OUT, l_codesc OUT, l_codtur OUT,
               l_turint OUT, l_codint OUT, l_diafer OUT, l_tipcnv OUT,
               l_coderr OUT, l_seqhba OUT);

    IF   (l_diafer = 1) THEN
        l_codhor := 9997;
    END IF;
    
    /* Pega o codigo da filial */
    BEGIN
        SELECT HFI.CODFIL INTO l_codfil FROM R038HFI HFI WHERE
               HFI.NUMEMP = p_numemp AND HFI.TIPCOL = p_tipcol AND HFI.NUMCAD = p_numcad AND
               HFI.DATALT = (SELECT MAX(HFI2.DATALT) FROM R038HFI HFI2
                               WHERE HFI2.NUMEMP = p_numemp AND HFI2.TIPCOL = p_tipcol AND HFI2.NUMCAD = p_numcad AND HFI2.DATALT <= CURDATE());
    EXCEPTION
        WHEN OTHERS THEN l_codfil := 0;
    END;

    /* Pego a qtd máxima de faixas por filial */
    BEGIN
        SELECT MAX(SEQFAI) INTO l_maxseq FROM R004FHF WHERE CODHOR = l_codhor AND NUMEMP = p_numemp AND CODFIL = l_codfil;
    EXCEPTION WHEN OTHERS THEN
        l_maxseq := 1;
    END;
    
    /* Não existe faixa por filial. Pego a qtd máxima de faixas no cadastro de horário */
    IF (l_maxseq IS NULL) OR (l_maxseq = 1) THEN
        BEGIN
            SELECT MAX(SEQFAI) INTO l_maxseq FROM R004FHR WHERE CODHOR = l_codhor;
        EXCEPTION WHEN OTHERS THEN
            l_maxseq := 1;
        END;
    END IF;

    l_prifxA    := 0;
    l_prifxP    := 0;
    l_codHorAtu := 0;

    IF  l_coderr = 0 THEN

        FOREACH c_r004fhr INTO l_r004fhr.codreg,
                                 l_r004fhr.codhor,
                                 l_r004fhr.DATINI,
                                 l_r004fhr.seqfai,
                                 l_r004fhr.iniace,
                                 l_r004fhr.fimace,
                                 l_r004fhr.inipto,
                                 l_r004fhr.fimpto,
                                 l_r004fhr.DATFIM,
                                 l_r004fhr.tolaea,
                                 l_r004fhr.tolasa,
                                 l_r004fhr.tolaep,
                                 l_r004fhr.tolasp
        LOOP
            /* se for um registro de faixa horaria. */
            l_iniace := l_r004fhr.iniace;
            l_fimace := l_r004fhr.fimace;
            l_inipto := l_r004fhr.inipto;
            l_fimpto := l_r004fhr.fimpto;

            l_horbat  := -1;
            IF  l_r004fhr.codreg = 1 THEN
                /* pega a primeira hora do horario */
                BEGIN
                  SELECT HORBAT INTO l_horbat FROM R004MHR WHERE CODHOR = l_r004fhr.codhor AND SEQMAR = 1;
                EXCEPTION
                  WHEN TOO_MANY_ROWS THEN
                      RAISERROR 103 'SP_Faihor: Erro No SELECT R004MHR (TOO_MANY_ROWS).';
                  WHEN NO_DATA_FOUND THEN /* no caso dos horários 9997 e 9998 */
                      l_horbat := -1;
                  WHEN OTHERS THEN
                      RAISERROR 103 'SP_Faihor: Erro No SELECT R004MHR.';
                END;

                /* verifica o tipo de jornada do horario. */
                /* Pela Saída atualiza próximo dia, Pela Entrada atualiza dia anterior */
                BEGIN
                  SELECT JORHOR, JORACE INTO l_jorhor, l_jorace FROM R004HOR WHERE CODHOR = l_r004fhr.codhor;
                EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'RH_Faihor: Erro No SELECT R004HOR.';
                END;
                /* salva o valor da primeira faixa do horáio para ser verificado quando for 3º turno */
                IF  l_r004fhr.codhor <> l_codhoratu THEN
                    l_prifxA    := l_iniace;
                    l_priFxP    := l_inipto;
                    l_codHorAtu := l_r004fhr.codhor;
                END IF;
            END IF;
            IF  (l_r004fhr.iniace = 0) AND (l_r004fhr.fimace = 0) THEN
                IF   (l_r004fhr.codreg = 2) THEN
                    SP_GRA004TMP(l_data, 'A', 0, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                END IF;
            ELSE
                /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
                IF   (l_r004fhr.iniace > l_r004fhr.fimace) THEN
                     /* tipo de jornada pela Saída ou Hora da batida as 00:00 a faixa começa no dia anterior. */
                     /* tipo de jornada pela Entrada a faixa termina no próximo dia. */
                     IF  (l_jorhor = 'S') OR (l_horbat = 0) THEN
                         IF  (l_horant <> 0) THEN
                             /* verificar tolerâncias para hora extra */
                             IF  (l_r004fhr.codreg = 2) AND (l_r004fhr.tolaea > 0) THEN
                                 IF   l_r004fhr.tolaea < l_r004fhr.iniace THEN
                                      l_iniace := l_r004fhr.iniace - l_r004fhr.tolaea;
                                 ELSE
                                      l_iniace := 1440 - l_r004fhr.tolaea + l_r004fhr.iniace;
                                 END IF;
                                 /*Se o final do acesso for zero, então a faixa a ser gerada é na data atual, caso contrário na data anterior*/
                                 IF l_r004fhr.fimace = 0 THEN
                                      SP_GRA004TMP(l_data, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                                 ELSE
                                      SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                                 END IF;
                             ELSE
                                 IF l_r004fhr.fimace = 0 THEN
                                      SP_GRA004TMP(l_data, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                                 ELSE
                                      SP_GRA004TMP(l_dia_anterior, 'A', l_r004fhr.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                                 END IF;
                             END IF;
                         END IF;
                         /* verificar tolerâncias para hora extra */
                         IF  (l_r004fhr.codreg = 2) THEN
                             IF  (l_r004fhr.tolasa > 0) THEN
                                 l_total1 := l_r004fhr.fimace + l_r004fhr.tolasa;
                                 IF l_r004fhr.fimace = 0 THEN
                                     l_total1 := l_total1 + 1440;
                                 END IF;
                                 IF   l_total1 < 1439 THEN
                                      l_fimace := l_total1;
                                 ELSE
                                      l_fimace := l_total1 - 1440;
                                 END IF;
                                 SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                             /*Gera a faixa de horas extras*/
                             SP_GRA004TMP(l_data, 'A', l_iniace, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                             IF (l_r004fhr.fimace > 0) THEN
                                 SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace , 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         ELSE
                             IF   l_r004fhr.fimace > 0 AND l_r004fhr.tolasa <= 0 THEN
                                 SP_GRA004TMP(l_data, 'A', 0, l_r004fhr.fimace , 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                          IF  (l_r004fhr.codreg = 2) THEN
                              IF  l_r004fhr.tolaea > 0 THEN
                                  IF   l_r004fhr.tolaea < l_r004fhr.iniace THEN
                                       l_iniace := l_r004fhr.iniace - l_r004fhr.tolaea;
                                  ELSE l_iniace := 1440 - l_r004fhr.tolaea + l_r004fhr.iniace;
                                       SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                                       l_iniace := 0;
                                  END IF;
                              END IF;
                              IF  l_r004fhr.tolasa > 0 THEN
                                  l_total1 := l_r004fhr.fimace + l_r004fhr.tolasa;
                                  IF l_r004fhr.fimace = 0 THEN
                                       l_total1 := l_total1 + 1440;
                                  END IF;
                                  IF   l_total1 < 1439 THEN
                                       l_fimace := l_total1;
                                  ELSE
                                       l_fimace := l_total1 - 1440;
                                       SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                                       l_fimace := 1439;
                                  END IF;
                              END IF;
                              SP_GRA004TMP(l_data, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                              IF   l_r004fhr.fimace > 0 THEN
                                   SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,3, p_numemp, p_tipcol, p_numcad);
                              END IF;
                          ELSE
                              SP_GRA004TMP(l_data, 'A', l_r004fhr.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                              IF   l_r004fhr.fimace > 0 THEN
                                   SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r004fhr.fimace ,3, p_numemp, p_tipcol, p_numcad);
                              END IF;
                          END IF;
                     END IF;
                ELSE
                     /* 3º turno com intervalos nas faixas                            */
                     /* será verificado se a faixa atual é menor que a primeira faixa */
                     /* neste caso a faixa atual diz respeito ao próximo dia          */
                     IF  (l_r004fhr.codreg = 1) THEN
                         IF (l_jorace = 1) THEN
                             IF  l_iniace < l_prifxA THEN
                                 IF  (l_jorhor = 'E') THEN
                                     SP_GRA004TMP(l_dia_posterior, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                                 ELSE
                                     SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                                 END IF;
                             ELSE
                                 /* primeiro horário da faixa */
                                 IF  (l_jorhor = 'S') THEN
                                     SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                                 ELSE
                                     SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                                 END IF;
                             END IF;
                         ELSE
                             /* horário turno 1 (inicia e finaliza no mesmo dia) */
                             SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     ELSE
                         /* se for registro de programação de horas extras ver tolerancias */
                         IF  l_r004fhr.codreg = 2 THEN
                             IF  l_r004fhr.tolaea > 0 THEN
                                 IF   l_r004fhr.tolaea < l_r004fhr.iniace THEN
                                      l_iniace := l_r004fhr.iniace - l_r004fhr.tolaea;
                                 ELSE l_iniace := 1440 - l_r004fhr.tolaea + l_r004fhr.iniace;
                                      SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                                      l_iniace := 0;
                                 END IF;
                             END IF;

                             /* se tolerancia para acesso for maior que 0 */
                             IF  l_r004fhr.tolasa > 0 THEN
                                 l_total1 := l_r004fhr.fimace + l_r004fhr.tolasa;
                                 IF l_r004fhr.fimace = 0 THEN
                                      l_total1 := l_total1 + 1440;
                                 END IF;
                                 IF   l_total1 < 1439 THEN
                                      l_fimace := l_total1;
                                 ELSE
                                      l_fimace := l_total1 - 1440;
                                      SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                                      l_fimace := 1439;
                                 END IF;
                             END IF;
                             SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     END IF;
                END IF;
            END IF;

            IF  (l_r004fhr.inipto = 0) AND (l_r004fhr.fimpto = 0) THEN
                IF   (l_r004fhr.codreg = 2) THEN
                    SP_GRA004TMP(l_data, 'P', 0, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                END IF;                
            ELSE
                /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
                IF   (l_r004fhr.inipto > l_r004fhr.fimpto) THEN
                     /* se a faixa finaliza no próximo dia */
                     IF  (l_jorhor = 'S') OR (l_horbat = 0) THEN
                         IF  (l_horant <> 0) THEN
                             /* verificar tolerâncias para hora extra */
                             IF  (l_r004fhr.codreg = 2) AND (l_r004fhr.tolaep > 0) THEN
                                 IF   l_r004fhr.tolaep < l_r004fhr.inipto THEN
                                      l_inipto := l_r004fhr.inipto - l_r004fhr.tolaep;
                                 ELSE
                                      l_inipto := 1440 - l_r004fhr.tolaep + l_r004fhr.inipto;
                                 END IF;
                                 /*Se o final do ponto for zero, então a faixa a ser gerada é na data atual, caso contrário na data anterior*/
                                 IF l_r004fhr.fimpto = 0 THEN
                                      SP_GRA004TMP(l_data, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                                 ELSE
                                      SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                                 END IF;
                             ELSE
                                 IF l_r004fhr.fimpto = 0 THEN
                                      SP_GRA004TMP(l_data, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                                 ELSE
                                      SP_GRA004TMP(l_dia_anterior, 'P', l_r004fhr.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                                 END IF;
                             END IF;
                         END IF;
                         /* verificar tolerâncias para hora extra */
                         IF  (l_r004fhr.codreg = 2) THEN
                             IF  (l_r004fhr.tolasp > 0) THEN
                                 l_total1 := l_r004fhr.fimpto + l_r004fhr.tolasp;
                                 IF l_r004fhr.fimpto = 0 THEN
                                      l_total1 := l_total1 + 1440;
                                 END IF;
                                 IF   l_total1 < 1439 THEN
                                      l_fimpto := l_total1;
                                 ELSE
                                      l_fimpto := l_total1 - 1440;
                                 END IF;
                                 SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto , 0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                             SP_GRA004TMP(l_data, 'P', l_inipto, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                             IF   l_r004fhr.fimpto > 0 THEN
                                  SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto , 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         ELSE
                             IF   l_r004fhr.fimpto > 0 AND l_r004fhr.tolasp <= 0 THEN
                                 SP_GRA004TMP(l_data, 'P', 0, l_r004fhr.fimpto , 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                          IF  (l_r004fhr.codreg = 2) THEN
                              IF  l_r004fhr.tolaep > 0 THEN
                                  IF   l_r004fhr.tolaep < l_r004fhr.inipto THEN
                                       l_inipto := l_r004fhr.inipto - l_r004fhr.tolaep;
                                  ELSE l_inipto := 1440 - l_r004fhr.tolaep + l_r004fhr.inipto;
                                       SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                                       l_inipto := 0;
                                  END IF;
                              END IF;
                              IF  l_r004fhr.tolasp > 0 THEN
                                  l_total1 := l_r004fhr.fimpto + l_r004fhr.tolasp;
                                  IF l_r004fhr.fimpto = 0 THEN
                                       l_total1 := l_total1 + 1440;
                                  END IF;
                                  IF   l_total1 < 1439 THEN
                                       l_fimpto := l_total1;
                                  ELSE
                                       l_fimpto := l_total1 - 1440;
                                       SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                                       l_fimpto := 1439;
                                  END IF;
                              END IF;
                              SP_GRA004TMP(l_data, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                              IF   l_r004fhr.fimpto > 0 THEN
                                   SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,3, p_numemp, p_tipcol, p_numcad);
                              END IF;

                          ELSE
                              SP_GRA004TMP(l_data, 'P', l_r004fhr.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                              IF   l_r004fhr.fimpto > 0 THEN
                                   SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r004fhr.fimpto ,3, p_numemp, p_tipcol, p_numcad);
                              END IF;
                          END IF;
                     END IF;
                ELSE
                     /* 3º turno com intervalos nas faixas                            */
                     /* será verificado se a faixa atual é menor que a primeira faixa */
                     /* neste caso a faixa atual diz respeito ao próximo dia          */
                     IF  (l_r004fhr.codreg = 1) THEN
                         IF (l_jorace = 1) THEN
                             IF  l_inipto < l_prifxP THEN
                                 IF  (l_jorhor = 'E') THEN
                                     SP_GRA004TMP(l_dia_posterior, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                                 ELSE
                                     SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                                 END IF;
                             ELSE
                                 /* primeiro horário da faixa */
                                 IF  (l_jorhor = 'S') THEN
                                     SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                                 ELSE
                                     SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                                 END IF;
                             END IF;
                         ELSE
                             /* horário turno 1 (inicia e finaliza no mesmo dia) */
                             SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     ELSE
                         /* se for registro de programação de horas extras ver tolerancias */
                         IF  l_r004fhr.codreg = 2 THEN
                             /* se tolerancia para ponto for maior que 0 */
                             IF  l_r004fhr.tolaep > 0 THEN
                                 IF   l_r004fhr.tolaep < l_r004fhr.inipto THEN
                                      l_inipto := l_r004fhr.inipto - l_r004fhr.tolaep;
                                 ELSE l_inipto := 1440 - l_r004fhr.tolaep + l_r004fhr.inipto;
                                      SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                                      l_inipto := 0;
                                 END IF;
                             END IF;

                             /* se tolerancia para ponto for maior que 0 */
                             IF  l_r004fhr.tolasp > 0 THEN
                                 l_total1 := l_r004fhr.fimpto + l_r004fhr.tolasp;
                                 IF   l_total1 < 1439 THEN
                                      l_fimpto := l_total1;
                                 ELSE
                                      l_fimpto := l_total1 - 1440;
                                      SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                                      l_fimpto := 1439;
                                 END IF;
                             END IF;
                             SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     END IF;
                END IF;
            END IF;

            /* Verifica se tem programação de compensação */
            IF  l_r004fhr.codreg = 1 THEN

                FOREACH c_r064cmp INTO l_r064cmp.TIPCMP,
                                       l_r064cmp.PERCMP,
                                       l_r064cmp.INIINT,
                                       l_r064cmp.FIMINT,
                                       l_r064cmp.QTDHOR
                LOOP
                    l_tipcmp := l_r064cmp.TIPCMP;
                    l_percmp := l_r064cmp.PERCMP;
                    l_iniint := l_r064cmp.INIINT;
                    l_fimint := l_r064cmp.FIMINT;
                    l_qtdhor := l_r064cmp.QTDHOR;

                    /* TipCmp 5 - Dispensar intervalo de horas / TipCmp 6 - Programar intervalo fora do expediente */
                    /* Gerar a faixa de acordo com a informada na programação. */
                    IF  (l_tipcmp = 5) OR (l_tipcmp = 6) THEN
                        /*Se o início for maior que o fim*/
                        IF (l_iniint > l_fimint) THEN
                            SP_GRA004TMP(l_data, 'A', l_iniint, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                            SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimint , 0, p_numemp, p_tipcol, p_numcad);

                            SP_GRA004TMP(l_data, 'P', l_iniint, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                            SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimint , 0, p_numemp, p_tipcol, p_numcad);
                        ELSE
                            SP_GRA004TMP(l_data, 'A', l_iniint, l_fimint , 0, p_numemp, p_tipcol, p_numcad);
                            SP_GRA004TMP(l_data, 'P', l_iniint, l_fimint , 0, p_numemp, p_tipcol, p_numcad);
                        END IF;
                    END IF;
                    IF   (l_r004fhr.iniace > l_r004fhr.fimace) THEN
                        /*Se compensação para escala de terceiro turno*/
                        /* TipCmp : 1 - Extras para Compensação */
                        IF  l_tipcmp = 1 THEN
                            /* PerCmp: 2 - Inicio e Fim de Expediente */
                            /* Somar a qtde de horas no inicio e fim da faixa horária do acesso e ponto */
                            IF  (l_percmp = 2) THEN
                                IF   l_r004fhr.seqfai = 1 THEN
                                     IF   l_qtdhor  < l_r004fhr.iniace THEN
                                          l_iniace := l_r004fhr.iniace - l_qtdhor;
                                     ELSE
                                          l_iniace := 1440 - l_qtdhor + l_r004fhr.iniace;
                                          SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                                          l_iniace := 0;
                                     END IF;

                                     IF   l_qtdhor < l_r004fhr.inipto THEN
                                          l_inipto := l_r004fhr.inipto - l_qtdhor;
                                     ELSE
                                          l_inipto := 1440 - l_qtdhor + l_r004fhr.inipto;
                                          SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                                          l_inipto := 0;
                                     END IF;
                                ELSE
                                     l_iniace := l_r004fhr.iniace;
                                END IF;

                                IF   l_r004fhr.seqfai = l_maxseq THEN

                                     l_totalA := l_r004fhr.fimace + l_qtdhor;
                                     IF   l_totalA < 1439 THEN
                                          l_fimace := l_totalA;
                                          SP_GRA004TMP(l_data, 'A', l_iniace, 1439, 0, p_numemp, p_tipcol, p_numcad);
                                          SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                                     ELSE
                                          l_fimace := l_totalA - 1440;
                                          SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace , 0, p_numemp, p_tipcol, p_numcad);
                                          l_fimace := 1439;
                                     END IF;

                                     l_totalP := l_r004fhr.fimpto + l_qtdhor;
                                     IF   l_totalP < 1439 THEN
                                          l_fimpto := l_totalP;
                                          SP_GRA004TMP(l_data, 'P', l_inipto, 1439, 0, p_numemp, p_tipcol, p_numcad);
                                          SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                                     ELSE
                                          l_fimpto := l_totalP - 1440;
                                          SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto , 0, p_numemp, p_tipcol, p_numcad);
                                          l_fimpto := 1439;
                                     END IF;
                                ELSE
                                     IF   l_r004fhr.seqfai = 1 THEN
                                          SP_GRA004TMP(l_data, 'A', l_iniace, l_r004fhr.fimace, 0, p_numemp, p_tipcol, p_numcad);
                                          SP_GRA004TMP(l_data, 'P', l_inipto, l_r004fhr.fimpto, 0, p_numemp, p_tipcol, p_numcad);
                                     END IF;
                                END IF;
                            END IF;

                            /* PerCmp 4 - Inicio do Expediente  / PerCmd 6 - Inicio do Expediente antecipando horario */
                            /* Subtrair a qtde de horas no inicio da faixa horaria do acesso e do ponto */
                            IF  (l_percmp = 4) OR (l_percmp = 6) THEN
                                IF   l_r004fhr.seqfai = 1 THEN
                                     IF   l_qtdhor < l_r004fhr.iniace THEN
                                          l_iniace := l_r004fhr.iniace - l_qtdhor;
                                          SP_GRA004TMP(l_data, 'A', l_iniace, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                                     ELSE
                                          /*Lança para o dia anterior*/
                                          l_iniace := 1440 - l_qtdhor + l_r004fhr.iniace;
                                          SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                                          /*Lança para a data atual*/
                                          SP_GRA004TMP(l_data, 'A', 0, l_r004fhr.iniace , 0, p_numemp, p_tipcol, p_numcad);

                                          l_iniace := 0;
                                     END IF;

                                     IF   l_qtdhor < l_r004fhr.inipto THEN
                                          l_inipto := l_r004fhr.inipto - l_qtdhor;
                                          SP_GRA004TMP(l_data, 'P', l_inipto, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                                     ELSE
                                          l_inipto := 1440 - l_qtdhor + l_r004fhr.inipto;
                                          SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                                          /*Lança para a data atual*/
                                          SP_GRA004TMP(l_data, 'P', 0, l_r004fhr.inipto , 0, p_numemp, p_tipcol, p_numcad);
                                          l_inipto := 0;
                                     END IF;
                                END IF;
                            END IF;

                            /* PerCmp 5 - Final do Expediente  /  PerCmd 7 - Final do Expediente prorrogando horario */
                            /* (somar a qtde de horas no final da faixa horaria do acesso e do ponto */
                            IF  (l_percmp = 5) OR (l_percmp = 7) THEN
                                IF   l_r004fhr.seqfai = l_maxseq THEN
                                     l_totalA := l_r004fhr.fimace + l_qtdhor;
                                     IF   l_totalA < 1439 THEN
                                          l_fimace := l_totalA;
                                          IF (l_r004fhr.iniace > l_fimace) THEN
                                              SP_GRA004TMP(l_data, 'A', l_r004fhr.iniace, 1439, 0, p_numemp, p_tipcol, p_numcad);
                                              SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                                          ELSE
                                              SP_GRA004TMP(l_data, 'A', l_r004fhr.fimace, l_fimace , 0, p_numemp, p_tipcol, p_numcad);
                                          END IF;

                                     ELSE
                                          l_fimace := l_totalA - 1440;
                                          SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace , 0, p_numemp, p_tipcol, p_numcad);
                                          l_fimace := 1439;
                                     END IF;

                                     l_totalP := l_r004fhr.fimpto + l_qtdhor;
                                     IF   l_totalP < 1439 THEN
                                          l_fimpto := l_totalP;
                                          IF (l_r004fhr.inipto > l_fimpto) THEN
                                              SP_GRA004TMP(l_data, 'P', l_r004fhr.inipto, 1439, 0, p_numemp, p_tipcol, p_numcad);
                                              SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                                          ELSE
                                              SP_GRA004TMP(l_data, 'P', l_r004fhr.fimpto, l_fimpto , 0, p_numemp, p_tipcol, p_numcad);
                                          END IF;
                                     ELSE
                                          l_fimpto := l_totalP - 1440;
                                          SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto , 0, p_numemp, p_tipcol, p_numcad);
                                          l_fimpto := 1439;
                                     END IF;
                                END IF;
                            END IF;
                        END IF;
                    ELSE
                        /* TipCmp : 1 - Extras para Compensação */
                        IF  l_tipcmp = 1 THEN
                            /* PerCmp: 2 - Inicio e Fim de Expediente */
                            /* Somar a qtde de horas no inicio e fim da faixa horária do acesso e ponto */
                            IF  (l_percmp = 2) THEN
                                IF   l_r004fhr.seqfai = 1 THEN
                                     IF   l_qtdhor  < l_r004fhr.iniace THEN
                                          l_iniace := l_r004fhr.iniace - l_qtdhor;
                                     ELSE
                                          l_iniace := 1440 - l_qtdhor + l_r004fhr.iniace;
                                          SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                                          l_iniace := 0;
                                     END IF;

                                     IF   l_qtdhor < l_r004fhr.inipto THEN
                                          l_inipto := l_r004fhr.inipto - l_qtdhor;
                                     ELSE
                                          l_inipto := 1440 - l_qtdhor + l_r004fhr.inipto;
                                          SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                                          l_inipto := 0;
                                     END IF;
                                ELSE
                                     l_iniace := l_r004fhr.iniace;
                                END IF;

                                IF   l_r004fhr.seqfai = l_maxseq THEN
                                     l_totalA := l_r004fhr.fimace + l_qtdhor;
                                     IF   l_totalA < 1439 THEN
                                          l_fimace := l_totalA;
                                          SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                                     ELSE
                                          l_fimace := l_totalA - 1440;
                                          SP_GRA004TMP(l_data, 'A', l_iniace, 1439, 0, p_numemp, p_tipcol, p_numcad);
                                          SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace , 0, p_numemp, p_tipcol, p_numcad);
                                          l_fimace := 1439;
                                     END IF;

                                     l_totalP := l_r004fhr.fimpto + l_qtdhor;
                                     IF   l_totalP < 1439 THEN
                                          l_fimpto := l_totalP;
                                          SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                                     ELSE
                                          l_fimpto := l_totalP - 1440;
                                          SP_GRA004TMP(l_data, 'P', l_inipto, 1439, 0, p_numemp, p_tipcol, p_numcad);
                                          SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto , 0, p_numemp, p_tipcol, p_numcad);
                                          l_fimpto := 1439;
                                     END IF;
                                ELSE
                                     IF   l_r004fhr.seqfai = 1 THEN
                                          SP_GRA004TMP(l_data, 'A', l_iniace, l_r004fhr.fimace, 0, p_numemp, p_tipcol, p_numcad);
                                          SP_GRA004TMP(l_data, 'P', l_inipto, l_r004fhr.fimpto, 0, p_numemp, p_tipcol, p_numcad);
                                     END IF;
                                END IF;
                            END IF;

                            /* PerCmp 4 - Inicio do Expediente  / PerCmd 6 - Inicio do Expediente antecipando horario */
                            /* Subtrair a qtde de horas no inicio da faixa horaria do acesso e do ponto */
                            IF  (l_percmp = 4) OR (l_percmp = 6) THEN
                                IF   l_r004fhr.seqfai = 1 THEN
                                     IF   l_qtdhor < l_r004fhr.iniace THEN
                                          l_iniace := l_r004fhr.iniace - l_qtdhor;
                                          SP_GRA004TMP(l_data, 'A', l_iniace, l_r004fhr.fimace , 0, p_numemp, p_tipcol, p_numcad);
                                     ELSE
                                          l_iniace := 1440 - l_qtdhor + l_r004fhr.iniace;
                                          SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                                          l_iniace := 0;
                                     END IF;

                                     IF   l_qtdhor < l_r004fhr.inipto THEN
                                          l_inipto := l_r004fhr.inipto - l_qtdhor;
                                          SP_GRA004TMP(l_data, 'P', l_inipto, l_r004fhr.fimpto , 0, p_numemp, p_tipcol, p_numcad);
                                     ELSE
                                          l_inipto := 1440 - l_qtdhor + l_r004fhr.inipto;
                                          SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                                          l_inipto := 0;
                                     END IF;
                                END IF;
                            END IF;

                            /* PerCmp 5 - Final do Expediente  /  PerCmd 7 - Final do Expediente prorrogando horario */
                            /* (somar a qtde de horas no final da faixa horaria do acesso e do ponto */
                            IF  (l_percmp = 5) OR (l_percmp = 7) THEN
                                IF   l_r004fhr.seqfai = l_maxseq THEN
                                     l_totalA := l_r004fhr.fimace + l_qtdhor;
                                     IF   l_totalA < 1439 THEN
                                          l_fimace := l_totalA;
                                          SP_GRA004TMP(l_data, 'A', l_r004fhr.iniace, l_fimace , 0, p_numemp, p_tipcol, p_numcad);
                                     ELSE
                                          l_fimace := l_totalA - 1440;
                                          SP_GRA004TMP(l_data, 'A', l_r004fhr.iniace, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                                          SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace , 0, p_numemp, p_tipcol, p_numcad);
                                          l_fimace := 1439;
                                     END IF;

                                     l_totalP := l_r004fhr.fimpto + l_qtdhor;
                                     IF   l_totalP < 1439 THEN
                                          l_fimpto := l_totalP;
                                          SP_GRA004TMP(l_data, 'P', l_r004fhr.inipto, l_fimpto , 0, p_numemp, p_tipcol, p_numcad);
                                     ELSE
                                          l_fimpto := l_totalP - 1440;
                                          SP_GRA004TMP(l_data, 'P', l_r004fhr.inipto, 1439 , 0, p_numemp, p_tipcol, p_numcad);
                                          SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto , 0, p_numemp, p_tipcol, p_numcad);
                                          l_fimpto := 1439;
                                     END IF;
                                END IF;
                            END IF;
                        END IF;
                    END IF;
                END LOOP;
            END IF;

            /* codreg 3 = autorização de saída     */
            IF  (l_r004fhr.codreg = 3) THEN
                 SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                 SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
            END IF;

        END LOOP;



        l_iniref := 0;
        l_cont := 0;
        FOREACH c_r004mhr INTO  l_r004mhr.horbat,
                                l_r004mhr.faimov,
                                l_r004mhr.seqmar
        LOOP
            /* SE TIVER MOBILIDADE DE HORARIO ENTAO CONSIDERA-LA.*/
            IF   l_r004mhr.faimov > 0 THEN
                 l_horref := l_r004mhr.faimov;
            ELSE
                 l_horref := l_r004mhr.horbat;
            END IF;
            IF l_cont = 0 THEN
               l_iniref := l_horref;
               l_cont := l_cont + 1;
            ELSE
               SP_GRA004TMP(l_data, 'R', l_iniref, l_horref ,0, p_numemp, p_tipcol, p_numcad);
               l_cont := 0;
            END IF;
        END LOOP;
    END IF;

    /* salva o valor do horário anterior */
    l_horant := l_codhor;
    
    
	/* verifica liberação da faixa horária (R070LFH) */
	l_numcra:= 0;
	l_tipcra:= 2;
	
	/*Verifica Liberação de Faixa Horária para Crachá Provisório*/
	FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM
	LOOP
	    /* para data atual, verifica se hora termina no dia ou no próximo dia */
	    IF  (l_r070lfh.datlib = l_data) THEN
	        IF (l_r070lfh.HORFIM < l_r070lfh.HORINI) THEN
	            /*termina no outro dia*/
	            SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);
	            SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);
	
	            SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
	            SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
	        ELSE
	            /*termina no dia atual*/
	            SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
	            SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
	        END IF;
	    ELSE
	        /* para o dia anteior, então libera da hora zero até a hora final*/
	        SP_GRA004TMP(l_data, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
	        SP_GRA004TMP(l_data, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
	    END IF;
	
	    l_numcra := l_r070lfh.NUMCRA;
	END LOOP;
	
	/*Se não encontrou, Verifica Liberação de Faixa Horária para o Crachá do Titular*/
	IF  (l_NumCra = 0) THEN
	    l_tipcra := 1;
	    FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM
	    LOOP
	        /* para data atual, verifica se hora termina no dia ou no próximo dia */
	        IF  (l_r070lfh.datlib = l_data) THEN
	            IF (l_r070lfh.HORFIM < l_r070lfh.HORINI) THEN
	                /*termina no outro dia*/
	                SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);
	                SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);
	
	                SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
	                SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
	            ELSE
	                /*termina no dia atual*/
	                SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
	                SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
	            END IF;
	        ELSE
	            /* para o dia anteior, então libera da hora zero até a hora final*/
	            SP_GRA004TMP(l_data, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
	            SP_GRA004TMP(l_data, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
	        END IF;
	    END LOOP;
	END IF;
    

    /* Condicao p/ Controle LOOP. Deve estar antes de incrementar a data, pois deve percorrer um dia a mais. */
    /* Motivo para isso é quando o proximo dia inicia no dia anterior. */
    IF   (l_data > l_data_limite) THEN
         EXIT;
    END IF;

    /* Incremento p/ Controle LOOP */
    l_data := DATETimeAdd(DD,1,l_data);
  END LOOP;

  l_data := CURDATE();

  /* verifica o tipo de feriado utilizado */
  /* no caso da não atualização correta da faixa horária nos feriados deve-se verificar o cadastro de escala */
  l_tipfer := 'N';
  BEGIN
      SELECT A.TIPFER,A.TABFER,A.TURESC INTO l_tipfer,l_tabfer,l_turesc FROM R006ESC A, R038HES B WHERE
             A.CODESC = B.CODESC AND
             B.DATALT= (SELECT MAX(C.DATALT) FROM R038HES C WHERE C.NUMEMP = p_numemp AND
             C.TIPCOL = p_tipcol AND C.NUMCAD = p_numcad)AND
             B.NUMEMP = p_numemp AND B.TIPCOL = p_tipcol AND B.NUMCAD = p_numcad;
  EXCEPTION
      WHEN OTHERS THEN l_tipfer:= 'N';
                       l_tabfer:= 0;
                       l_turesc:= 0;
  END;

  /* verifica o tipo de feriado da filial */
  IF  l_tipfer <> 'F' THEN
      l_codfil := 0;
  END IF;

  p_prmsabequal := 1;
  p_prmdomequal := 2;
  p_prmsegequal := 0;

  l_datatu        := CURDATE();
  l_datant        := DATETIMEADD(DD, -1, l_datatu);
  l_dia_posterior := DATETIMEADD(DD, 1, l_datatu);
  l_hora_atual    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  /* calcula as faixas que estão no mesmo período */
  LOOP
    SP_UneFai(l_datini, l_data_limite, 'A', p_numemp, p_tipcol, p_numcad, l_alterado OUT);
    IF l_alterado = FALSE THEN
      EXIT;
    END IF;
  END LOOP;
  LOOP
    SP_UneFai(l_datini, l_data_limite, 'P', p_numemp, p_tipcol, p_numcad, l_alterado OUT);
    IF l_alterado = FALSE THEN
      EXIT;
    END IF;
  END LOOP;

  LOOP
    l_faiace := '';
    l_faipto := '';
    l_fairef := '';

    FOREACH c_r004TMP INTO l_r004TMP.DatHor,
                           l_r004TMP.TipFai,
                           l_r004TMP.FaiIni,
                           l_r004TMP.FaiFim,
                           l_r004TMP.TurTrb

    LOOP
      IF  (l_r004TMP.TurTrb = 3) AND (l_perace = 2) THEN
          l_dia_semana  := DAYOFWEEK(l_r004TMP.DatHor);

          /*Verifica se é feriado*/
          RH_DATFER (p_numemp, p_tipcol, p_numcad, l_codfil, l_tipfer, l_tabfer, l_turesc, l_r004TMP.DatHor, '', l_feriado OUT);

          /* PRM_EQUAL =>   0 = dia normal, 1 = sabado,  2 = domingo, 3 = feriado*/
          IF   l_dia_semana = 7 THEN     /* DAYOFWEEK 7  = sábado */
               p_prmsabequal := 0;        /* permissão dias normais */
               IF l_feriado = TRUE  THEN
                  p_prmsabequal := 3;     /* permissão feriado */
               END IF;
          END IF;

          IF   l_dia_semana = 1 THEN     /* DAYOFWEEK 1  = domingo */
               p_prmdomequal := 1;        /* permissão sábado */
               IF l_feriado = TRUE  THEN
                  p_prmdomequal := 3;
               END IF;
          END IF;

          IF   l_dia_semana = 2 THEN     /* DAYOFWEEK 2  = segunda */
               p_prmsegequal := 2;        /* permissão domingo */
               IF l_feriado = TRUE  THEN
                  p_prmsegequal := 3;
               END IF;
          END IF;
      END IF;

      /* SE TIVER MOBILIDADE DE HORARIO ENTAO CONSIDERA-LA.*/
      SP_INTSTR(l_r004tmp.FaiIni,'HHMM',l_strini OUT);
      SP_INTSTR(l_r004tmp.FaiFim,'HHMM',l_strfim OUT);
      IF  l_r004TMP.TipFai = 'A' THEN
          l_faiace := l_faiace || l_strini || l_strfim;
      END IF;
      IF  l_r004TMP.TipFai = 'P' THEN
          l_faipto := l_faipto || l_strini || l_strfim;
      END IF;
      IF  l_r004TMP.TipFai = 'R' THEN
          l_fairef := l_fairef || l_strini || l_strfim;
      END IF;

      /* verifica último turno para afastamento (final jornada = maior horario do 3º turno).*/
      IF  (l_r004TMP.DatHor = l_datatu) AND
          (l_r004TMP.TurTrb = 3)        AND
          (l_fimjor < l_r004TMP.FaiFim) AND
          (l_r004TMP.tipfai = 'A')      THEN
          l_fimjor := l_r004TMP.FaiFim;
      END IF;

    END LOOP;

    /* PREENCHE O RESTO DO CAMPO COM 2400 */
    l_faiace := IFNULL(l_faiace,'');
    IF (l_faiace IS NULL) OR (l_faiace = '0') OR (l_faiace = '') THEN
      l_lengfai := 7;
      l_faiace :='';
    ELSE
      l_lengfai := (56 - LENGTH(l_faiace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
      l_faiace := l_faiace || '24002400';
      l_contfai := l_contfai + 1;
      IF (l_contfai >= l_lengfai) THEN
        EXIT;
      END IF;
    END LOOP;
    /* PREENCHE O RESTO DO CAMPO COM 2400 */
    l_faipto := IFNULL(l_faipto,'');
    IF (l_faipto IS NULL) OR (l_faipto = '0') OR (l_faipto = '') THEN
      l_lengfai := 7;
      l_faipto := '';
    ELSE
      l_lengfai := (56 - LENGTH(l_faipto)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
      l_faipto := l_faipto || '24002400';
      l_contfai := l_contfai + 1;
      IF (l_contfai >= l_lengfai) THEN
        EXIT;
      END IF;
    END LOOP;

    /* PREENCHE O RESTO DO CAMPO COM 2400 */
    IF (LENGTH(l_fairef) < 8) OR (l_fairef IS NULL) OR (l_fairef = '0') OR (l_fairef = '') THEN
       l_fairef := '';
       l_fairef := '24002400';
    END IF;

    l_faiace     := SUBSTRING(l_faiace,1,56);
    l_faipto     := SUBSTRING(l_faipto,1,56);
    l_fairef     := SUBSTRING(l_fairef,1,8);
    l_dia_semana := DAYOFWEEK(l_data);
    IF    l_dia_semana = 1 THEN /* domingo */
          l_faidom_ace := l_faiace;
          l_faidom_pto := l_faipto;
          l_faidom_ref := l_fairef;
    ELSIF l_dia_semana = 2 THEN /* segunda */
          l_faiseg_ace := l_faiace;
          l_faiseg_pto := l_faipto;
          l_faiseg_ref := l_fairef;
    ELSIF l_dia_semana = 3 THEN /* terca */
          l_faiter_ace := l_faiace;
          l_faiter_pto := l_faipto;
          l_faiter_ref := l_fairef;
    ELSIF l_dia_semana = 4 THEN /* quarta */
          l_faiqua_ace := l_faiace;
          l_faiqua_pto := l_faipto;
          l_faiqua_ref := l_fairef;
    ELSIF l_dia_semana = 5 THEN /* quinta */
          l_faiqui_ace := l_faiace;
          l_faiqui_pto := l_faipto;
          l_faiqui_ref := l_fairef;
    ELSIF l_dia_semana = 6 THEN /* sexta */
          l_faisex_ace := l_faiace;
          l_faisex_pto := l_faipto;
          l_faisex_ref := l_fairef;
    ELSE  l_faisab_ace := l_faiace;
          l_faisab_pto := l_faipto;
          l_faisab_ref := l_fairef;
    END IF;

    /* Incremento p/ Controle LOOP */
    l_data := DATETimeAdd(DD,1,l_data);
    IF   (l_data > l_data_limite) THEN
         EXIT;
    END IF;
  END LOOP;

  /* monta a faixa do refeitorio que deve sempre comecar pelo domingo. */
  p_fairef := l_faidom_ref || l_faiseg_ref || l_faiter_ref || l_faiqua_ref ||
              l_faiqui_ref || l_faisex_ref || l_faisab_ref;

  l_faidom_ace := SUBSTRING(l_faidom_ace,1,56);
  l_faiseg_ace := SUBSTRING(l_faiseg_ace,1,56);
  l_faiter_ace := SUBSTRING(l_faiter_ace,1,56);
  l_faiqua_ace := SUBSTRING(l_faiqua_ace,1,56);
  l_faiqui_ace := SUBSTRING(l_faiqui_ace,1,56);
  l_faisex_ace := SUBSTRING(l_faisex_ace,1,56);
  l_faisab_ace := SUBSTRING(l_faisab_ace,1,56);
  l_faidom_pto := SUBSTRING(l_faidom_pto,1,56);
  l_faiseg_pto := SUBSTRING(l_faiseg_pto,1,56);
  l_faiter_pto := SUBSTRING(l_faiter_pto,1,56);
  l_faiqua_pto := SUBSTRING(l_faiqua_pto,1,56);
  l_faiqui_pto := SUBSTRING(l_faiqui_pto,1,56);
  l_faisex_pto := SUBSTRING(l_faisex_pto,1,56);
  l_faisab_pto := SUBSTRING(l_faisab_pto,1,56);

  p_faidom_ace  := l_faidom_ace;
  p_faiseg_ace  := l_faiseg_ace;
  p_faiter_ace  := l_faiter_ace;
  p_faiqua_ace  := l_faiqua_ace;
  p_faiqui_ace  := l_faiqui_ace;
  p_faisex_ace  := l_faisex_ace;
  p_faisab_ace  := l_faisab_ace;
  p_faidom_pto  := l_faidom_pto;
  p_faiseg_pto  := l_faiseg_pto;
  p_faiter_pto  := l_faiter_pto;
  p_faiqua_pto  := l_faiqua_pto;
  p_faiqui_pto  := l_faiqui_pto;
  p_faisex_pto  := l_faisex_pto;
  p_faisab_pto  := l_faisab_pto;

  /* Atualiza Afastamentos */
  BEGIN
      SELECT R038AFA.DATAFA, R038AFA.HORAFA, R038AFA.DATTER, R038AFA.HORTER
      INTO l_datafa, l_horafa, l_datter, l_horter
      FROM R010SIT,R038AFA
      WHERE R038AFA.NUMEMP = p_numemp AND R038AFA.TIPCOL = p_tipcol AND R038AFA.NUMCAD = p_numcad AND
           (R038AFA.DATAFA < l_datatu OR (R038AFA.DATAFA = l_datatu AND R038AFA.HORAFA <= l_hora_atual)) AND
           (R038AFA.DATTER = l_data_zero OR R038AFA.DATTER > l_datatu OR
           (R038AFA.DATTER = l_datatu AND R038AFA.HORTER >= l_hora_atual) OR
           (R038AFA.DATTER = l_datatu AND R038AFA.HORTER = 0)) AND
            R038AFA.SITAFA = R010SIT.CODSIT AND R010SIT.BLOACE = 'S' AND
            R010SIT.TIPSIT <> 7;
  EXCEPTION
      WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SPFaihor: Este colaborador possui mais de um registro ativo com situação de bloqueio no cadastro de afastamentos. Favor regularizar estes registros.';
      WHEN NO_DATA_FOUND THEN l_TemAfa := FALSE;
      WHEN OTHERS        THEN RAISERROR 103 'SPFaihor: Erro na seleção de registros de afastamentos para este colaborador.';
  END;

  IF  (l_TemAfa = TRUE) THEN
      SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);
      SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
      /* para terceiro turno é inserido afastamento com data inicial zero.  */
      /* neste caso é necessário verificar se já finalizou a jornada para   */
      /* não bloquear o colaborador na saída. se o final da jornado for 1439*/
      /* significa que ele tem faixa de acesso livre e não precisa verificar*/
      /* a jornada.                                                         */

      IF  (l_datatu = l_datafa AND l_horafa = 0) THEN
          IF  (l_hora_atual > l_fimjor) OR (l_fimjor = 1439) THEN
              SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);
              IF  (l_datter <> l_data_zero) THEN
                  SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
              ELSE
                  l_fimafa := '311250';
                  l_horter:= 1439;
              END IF;
          END IF;
      ELSE
          IF  (l_datatu > l_datafa) OR (l_datatu = l_datafa AND l_hora_atual >= l_horafa) THEN
              SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);
              IF  (l_datter <> l_data_zero) THEN
                  SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
              ELSE
                  l_fimafa := '311250';
                  l_horter:= 1439;
              END IF;
          END IF;
      END IF;

      /* Verifica último turno para afastamento (final jornada = maior horario do 3º turno).*/
      /* Só verifica se muda o dia de acordo com escala se a data final não é zerada */
      IF (l_fimafa <> '311250') THEN 
          BEGIN
              SELECT FHF.INIACE, FHF.FIMACE INTO l_iniace, l_fimace FROM R004FHF FHF
              WHERE FHF.NUMEMP = p_numemp AND FHF.CODFIL = l_codfil AND
                   (FHF.CODHOR = l_codhor OR FHF.CODHOR = l_horbu1 OR
                    FHF.CODHOR = l_horbu2 OR FHF.CODHOR = l_horbu3 OR
                    FHF.CODHOR = l_horbu4 OR FHF.CODHOR = l_horbu5) AND (FHF.SEQFAI = 1);                     
          EXCEPTION
              WHEN OTHERS THEN
                  l_iniace := 0;
                  l_fimace := 0;
          END;

          IF (l_iniace = 0 AND l_fimace = 0) THEN
              BEGIN
                  SELECT FHR.INIACE, FHR.FIMACE INTO l_iniace, l_fimace FROM R004FHR FHR
                  WHERE (FHR.CODHOR = l_codhor OR FHR.CODHOR = l_horbu1 OR
                  	     FHR.CODHOR = l_horbu2 OR FHR.CODHOR = l_horbu3 OR
                         FHR.CODHOR = l_horbu4 OR FHR.CODHOR = l_horbu5) AND (FHR.SEQFAI = 1);
              EXCEPTION
                  WHEN OTHERS THEN
                      l_iniace := 0;
                      l_fimace := 0;
              END;
          END IF; 

          /*SELECT já considera que é 3º turno conforme SP_HISAFA */
          IF ( (l_iniace > l_fimace) AND (l_horafa = 0) AND (l_horter = 0) ) THEN
              IF (l_jorHor = 'E') THEN
                  SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);

                  l_datter := DATETIMEADD(DD, 1, l_datter);
                  SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
              END IF;
              IF (l_jorHor = 'S') THEN
                  SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);
         
                  l_datter := DATETIMEADD(DD, -1, l_datter);		 
                  SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
              END IF;
          END IF;
      END IF;

      /*Hora final 00:00 considerar como 23:59*/
      IF l_horter = 0 THEN
          l_horter:= 1439;
      END IF;
  ELSE
      l_iniafa := '      ';
      l_fimafa := '      ';
      l_horafa := 0;
      l_horter := 0;
  END IF;
  
  /* se a data form maior que 2050, joga o limite de 2050 para que a CSM entenda que é data em aberto */
  IF (l_datter > l_data2050) THEN
      l_fimafa := '311250';
      l_horter:= 1439;
  END IF;
  
  IF (l_horafa = 0) THEN
      p_horini:= '0000';
  ELSE
      SP_INTSTR(l_horafa,'HHMM',p_horini OUT);
  END IF;
  IF (l_horter = 0) THEN                                            
      p_horfim:= '0000';
  ELSE
      SP_INTSTR(l_horter,'HHMM',p_horfim OUT);
  END IF;

  p_datini := l_iniafa;
  p_datfim := l_fimafa;

  /* Limpa tabela temporaria R004TMP */
  BEGIN
      DELETE FROM R004TMP WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
      DROP_TEMP_TABLE R004TMP;
  EXCEPTION WHEN OTHERS THEN
      NULL;
  END;      
END␀4ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
2␀␀PROCEDURE SP_FAIOCR(P_NUMEMP NUMBER(4),P_NUMCAD NUMBER(9),P_CODESC NUMBER,P_CODTMA NUMBER,P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56))
 IS
BEGIN
  NULL;
END		SENIOR;20!RH_DATFIM
SP_INTSTR
HR_HOROCR
Æ%␀␀


PROCEDURE SP_FAIOCR(P_NUMEMP NUMBER(4),P_NUMCAD NUMBER(9),P_CODESC NUMBER,P_CODTMA NUMBER,P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56))
 IS

l_data        DATE;
  l_data_zero   DATE;
  l_data_inicio DATE;
  l_data_limite DATE;
  l_dia_semana  NUMBER(1);
  l_codhor      NUMBER(4);
  l_hora        NUMBER(4);
  l_coderr      NUMBER(2);
  l_faiace      VARCHAR2(255);
  l_faixa       VARCHAR2(255);
  l_faipto      VARCHAR2(255);
  l_horstr      CHAR(4);
  l_timenextday NUMBER(5);
  l_datent      DATE;
  l_datval      DATE;
  l_horent      NUMBER(5);
  l_horval      NUMBER(5);
  l_achou       BOOLEAN;
  l_iniref      NUMBER(5);
  l_fairef      VARCHAR(08);
  l_faidom_ref  VARCHAR(08);
  l_faiseg_ref  VARCHAR(08);
  l_faiter_ref  VARCHAR(08);
  l_faiqua_ref  VARCHAR(08);
  l_faiqui_ref  VARCHAR(08);
  l_faisex_ref  VARCHAR(08);
  l_faisab_ref  VARCHAR(08);
  l_cont        INTEGER;
  l_horref      NUMBER(5);
  l_strini      CHAR(4);
  l_strfim      CHAR(4);
  
      
  CURSOR c_r004fhr IS
      SELECT INIACE INIACE,FIMACE FIMACE, INIPTO INIPTO, FIMPTO FIMPTO FROM R004FHR
             WHERE R004FHR.CODHOR = l_codhor ORDER BY 1;
  TYPE t_r004fhr IS RECORD(
      INIACE   R004FHR.INIACE%TYPE,
      FIMACE   R004FHR.FIMACE%TYPE,
      INIPTO   R004FHR.INIPTO%TYPE,
      FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;

  CURSOR c_r004mhr IS
      SELECT HORBAT, FAIMOV, SEQMAR FROM R004MHR R004MHR
             WHERE USOBAT IN (4,6) AND CODHOR=l_codhor ORDER BY SEQMAR;
  TYPE t_r004mhr IS RECORD(
      HORBAT   R004MHR.HORBAT%TYPE,
      FAIMOV   R004MHR.FAIMOV%TYPE,
      SEQMAR   R004MHR.SEQMAR%TYPE);
  l_r004mhr t_r004mhr;

BEGIN
  /* Inicializa */
  l_data := CURDATE();
  l_hora := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_inicio := l_data;
  l_timenextday := 0;
  l_fairef := '';
  l_faidom_ref := '';
  l_faiseg_ref := '';
  l_faiter_ref := '';
  l_faiqua_ref := '';
  l_faiqui_ref := '';
  l_faisex_ref := '';
  l_faisab_ref := '';
  RH_DatFim (l_data_limite OUT);

  LOOP
    /* Condicao p/ Controle LOOP */
    IF   l_data > l_data_limite THEN
         EXIT;
    END IF;

    l_faiace := '';
    l_faipto := '';
    IF  l_timenextday > 0 THEN
        SP_INTSTR(l_timenextday,'HHMM',l_horstr OUT);
        l_faiace := '0000' || l_horstr;
        l_faipto := '0000' || l_horstr;
    END IF;

    /* Pega o codigo do horário */
    HR_HOROCR (p_numemp,p_codesc, p_codtma, l_data, l_codhor OUT, l_coderr OUT);

    IF   l_coderr = 0 THEN

          l_timenextday := 0;
          FOREACH c_r004fhr INTO  l_r004fhr.iniace,
                                  l_r004fhr.fimace,
                                  l_r004fhr.inipto,
                                  l_r004fhr.fimpto
          LOOP
            IF   l_r004fhr.iniace > 0 THEN
                 SP_INTSTR(l_r004fhr.iniace,'HHMM',l_horstr OUT);
                 l_faiace := l_faiace || l_horstr;
            ELSE l_faiace := l_faiace || '0000';
            END IF;

            IF   l_r004fhr.inipto > 0 THEN
                 SP_INTSTR(l_r004fhr.iniace,'HHMM',l_horstr OUT);
                 l_faipto := l_faipto || l_horstr;
            ELSE l_faipto := l_faipto || '0000';
            END IF;

            IF   l_r004fhr.fimace > 0 THEN
                 /* qdo a hora final for menor que a hora inicial significa que */
                 /* a faixa termina no proximo dia.                             */
                 IF   l_r004fhr.fimace < l_r004fhr.iniace THEN
                      IF  l_r004fhr.fimace > l_timenextday THEN
                          l_timenextday := l_r004fhr.fimace;
                      END IF;
                      l_horstr := '2359';
                 ELSE SP_INTSTR(l_r004fhr.fimace,'HHMM',l_horstr OUT);
                 END IF;
                 l_faiace := l_faiace || l_horstr;
            ELSE l_faiace := l_faiace || '0000';
            END IF;

            IF   l_r004fhr.fimpto > 0 THEN
                 /* qdo a hora final for menor que a hora inicial significa que */
                 /* a faixa termina no proximo dia.                             */
                 IF   l_r004fhr.fimpto < l_r004fhr.iniace THEN
                      IF  l_r004fhr.fimpto > l_timenextday THEN
                          l_timenextday := l_r004fhr.fimpto;
                      END IF;
                      l_horstr := '2359';
                 ELSE SP_INTSTR(l_r004fhr.fimpto,'HHMM',l_horstr OUT);
                 END IF;
                 l_faipto := l_faipto || l_horstr;
            ELSE l_faipto := l_faipto || '0000';
            END IF;


            IF   LENGTH(l_faipto) >= 56 THEN
                 EXIT;
            END IF;
          END LOOP;

    ELSE l_faipto := '24002400';
         l_faiace := '24002400';
    END IF;

    l_achou := TRUE;
    BEGIN
         SELECT DATENT,HORENT,DATVAL,HORVAL
           INTO l_datent,l_horent,l_datval,l_horval
           FROM R071AEO
          WHERE NUMEMP = p_numemp
            AND NUMCAD = p_numcad
            AND DATENT <= l_data  /*VALIDA PELA SAÍDA SE SAÍDA MENOR QUE VALIDADE, OU O CONTRÁRIO.*/
            AND ( ( (DATSAI <> l_data_zero AND DATSAI < DATVAL) AND ( (DATSAI > l_data) OR (DATSAI = l_data AND HORSAI > l_hora) ) )
                 OR ( (DATVAL = l_data_zero OR DATVAL > l_data) OR (DATVAL = l_data AND HORVAL > l_hora) ) );
    EXCEPTION
         WHEN NO_DATA_FOUND THEN l_achou := FALSE;
         WHEN OTHERS THEN RAISERROR 103 'SPFaiOcr: Erro No SELECT R071AEO.';
    END;

    IF (l_achou = TRUE) THEN
        l_faixa := '';
        IF    l_datent = l_datval THEN /* entrada e saida no mesmo dia */
              SP_INTSTR(l_horent,'HHMM',l_horstr OUT);
              l_faixa := l_horstr;
              SP_INTSTR(l_horval,'HHMM',l_horstr OUT);
              l_faixa := l_faixa || l_horstr;
        ELSIF l_datent = l_data THEN /* não sai no mesmo dia */
              SP_INTSTR(l_horent,'HHMM',l_horstr OUT);
              l_faixa := l_horstr || '2359';
        ELSIF l_datval = l_data THEN /* esta saindo no dia */
              SP_INTSTR(l_horval,'HHMM',l_horstr OUT);
              l_faixa :=  '0000' || l_horstr;
        ELSE  l_faixa :=  '00002359'; /* entrada e saida fora do dia */
        END IF;
        l_faiace := l_faiace || l_faixa;
        l_faipto := l_faipto || l_faixa;
    END IF;

    LOOP
        IF  (LENGTH(l_faiace) < 56) OR (l_faiace IS NULL) THEN
            l_faiace := l_faiace || '24002400';
        ELSIF (LENGTH(l_faipto) < 56) OR (l_faipto IS NULL) THEN
            l_faipto := l_faipto || '24002400';
        ELSE  EXIT;
        END IF;
    END LOOP;

      l_iniref := 0;
      l_cont := 0;
      l_fairef := '';
      FOREACH c_r004mhr INTO  l_r004mhr.horbat,
                              l_r004mhr.faimov,
                              l_r004mhr.seqmar
      LOOP
          IF  l_r004mhr.faimov > 0 THEN
              l_horref := l_r004mhr.faimov;
          ELSE
              l_horref := l_r004mhr.horbat;
          END IF;
          IF  l_cont = 0 THEN
              l_iniref := l_horref;
              l_cont := l_cont + 1;
          ELSE
              SP_INTSTR(l_iniref,'HHMM',l_strini OUT);
              SP_INTSTR(l_horref,'HHMM',l_strfim OUT);
              l_fairef := l_strini||l_strfim;
              l_cont := 0;
          END IF;
      END LOOP;

      IF  (LENGTH(l_fairef)<8) OR (l_fairef IS NULL) OR (l_fairef='0') OR (l_fairef='') THEN
          l_fairef := '';
          l_fairef := '24002400';
      END IF;

      l_faiace     := SUBSTRING(l_faiace,1,56);
      l_faipto     := SUBSTRING(l_faipto,1,56);

      l_dia_semana := DAYOFWEEK(l_data);
      IF  l_dia_semana = 1 THEN
          p_faidom_ace := l_faiace;
          p_faidom_pto := l_faipto;
          l_faidom_ref := l_fairef;
      ELSIF l_dia_semana = 2 THEN
          p_faiseg_ace := l_faiace;
          p_faiseg_pto := l_faipto;
          l_faiseg_ref := l_fairef;
      ELSIF l_dia_semana = 3 THEN
          p_faiter_ace := l_faiace;
          p_faiter_pto := l_faipto;
          l_faiter_ref := l_fairef;
      ELSIF l_dia_semana = 4 THEN
          p_faiqua_ace := l_faiace;
          p_faiqua_pto := l_faipto;
          l_faiqua_ref := l_fairef;
      ELSIF l_dia_semana = 5 THEN
          p_faiqui_ace := l_faiace;
          p_faiqui_pto := l_faipto;
          l_faiqui_ref := l_fairef;
      ELSIF l_dia_semana = 6 THEN
          p_faisex_ace := l_faiace;
          p_faisex_pto := l_faipto;
          l_faisex_ref := l_fairef;
      ELSE p_faisab_ace := l_faiace;
          p_faisab_pto := l_faipto;
          l_faisab_ref := l_fairef;          
      END IF;

    /* Quando o horário é do terceiro turno percorrer um dia a mais para completar o horario do dia anterior. */
    IF   (l_data > l_data_limite) THEN
         l_timenextday := 0;
    END IF;

    l_data := DATETimeAdd(DD,1,l_data);
  END LOOP;

  p_fairef := l_faidom_ref || l_faiseg_ref || l_faiter_ref || l_faiqua_ref ||
              l_faiqui_ref || l_faisex_ref || l_faisab_ref;
END		SENIOR;21!RH_DATFIM
SP_INTSTR
HR_HOROCR
Æ%␀␀


PROCEDURE SP_FAIOCR(P_NUMEMP NUMBER(4),P_NUMCAD NUMBER(9),P_CODESC NUMBER,P_CODTMA NUMBER,P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56))
 IS

l_data        DATE;
  l_data_zero   DATE;
  l_data_inicio DATE;
  l_data_limite DATE;
  l_dia_semana  NUMBER(1);
  l_codhor      NUMBER(4);
  l_hora        NUMBER(4);
  l_coderr      NUMBER(2);
  l_faiace      VARCHAR2(255);
  l_faixa       VARCHAR2(255);
  l_faipto      VARCHAR2(255);
  l_horstr      CHAR(4);
  l_timenextday NUMBER(5);
  l_datent      DATE;
  l_datval      DATE;
  l_horent      NUMBER(5);
  l_horval      NUMBER(5);
  l_achou       BOOLEAN;
  l_iniref      NUMBER(5);
  l_fairef      VARCHAR(08);
  l_faidom_ref  VARCHAR(08);
  l_faiseg_ref  VARCHAR(08);
  l_faiter_ref  VARCHAR(08);
  l_faiqua_ref  VARCHAR(08);
  l_faiqui_ref  VARCHAR(08);
  l_faisex_ref  VARCHAR(08);
  l_faisab_ref  VARCHAR(08);
  l_cont        INTEGER;
  l_horref      NUMBER(5);
  l_strini      CHAR(4);
  l_strfim      CHAR(4);
  
      
  CURSOR c_r004fhr IS
      SELECT INIACE INIACE,FIMACE FIMACE, INIPTO INIPTO, FIMPTO FIMPTO FROM R004FHR
             WHERE R004FHR.CODHOR = l_codhor ORDER BY 1;
  TYPE t_r004fhr IS RECORD(
      INIACE   R004FHR.INIACE%TYPE,
      FIMACE   R004FHR.FIMACE%TYPE,
      INIPTO   R004FHR.INIPTO%TYPE,
      FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;

  CURSOR c_r004mhr IS
      SELECT HORBAT, FAIMOV, SEQMAR FROM R004MHR R004MHR
             WHERE USOBAT IN (4,6) AND CODHOR=l_codhor ORDER BY SEQMAR;
  TYPE t_r004mhr IS RECORD(
      HORBAT   R004MHR.HORBAT%TYPE,
      FAIMOV   R004MHR.FAIMOV%TYPE,
      SEQMAR   R004MHR.SEQMAR%TYPE);
  l_r004mhr t_r004mhr;

BEGIN
  /* Inicializa */
  l_data := CURDATE();
  l_hora := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_inicio := l_data;
  l_timenextday := 0;
  l_fairef := '';
  l_faidom_ref := '';
  l_faiseg_ref := '';
  l_faiter_ref := '';
  l_faiqua_ref := '';
  l_faiqui_ref := '';
  l_faisex_ref := '';
  l_faisab_ref := '';
  RH_DatFim (l_data_limite OUT);

  LOOP
    /* Condicao p/ Controle LOOP */
    IF   l_data > l_data_limite THEN
         EXIT;
    END IF;

    l_faiace := '';
    l_faipto := '';
    IF  l_timenextday > 0 THEN
        SP_INTSTR(l_timenextday,'HHMM',l_horstr OUT);
        l_faiace := '0000' || l_horstr;
        l_faipto := '0000' || l_horstr;
    END IF;

    /* Pega o codigo do horário */
    HR_HOROCR (p_numemp,p_codesc, p_codtma, l_data, l_codhor OUT, l_coderr OUT);

    IF   l_coderr = 0 THEN

          l_timenextday := 0;
          FOREACH c_r004fhr INTO  l_r004fhr.iniace,
                                  l_r004fhr.fimace,
                                  l_r004fhr.inipto,
                                  l_r004fhr.fimpto
          LOOP
            IF   l_r004fhr.iniace > 0 THEN
                 SP_INTSTR(l_r004fhr.iniace,'HHMM',l_horstr OUT);
                 l_faiace := l_faiace || l_horstr;
            ELSE l_faiace := l_faiace || '0000';
            END IF;

            IF   l_r004fhr.inipto > 0 THEN
                 SP_INTSTR(l_r004fhr.iniace,'HHMM',l_horstr OUT);
                 l_faipto := l_faipto || l_horstr;
            ELSE l_faipto := l_faipto || '0000';
            END IF;

            IF   l_r004fhr.fimace > 0 THEN
                 /* qdo a hora final for menor que a hora inicial significa que */
                 /* a faixa termina no proximo dia.                             */
                 IF   l_r004fhr.fimace < l_r004fhr.iniace THEN
                      IF  l_r004fhr.fimace > l_timenextday THEN
                          l_timenextday := l_r004fhr.fimace;
                      END IF;
                      l_horstr := '2359';
                 ELSE SP_INTSTR(l_r004fhr.fimace,'HHMM',l_horstr OUT);
                 END IF;
                 l_faiace := l_faiace || l_horstr;
            ELSE l_faiace := l_faiace || '0000';
            END IF;

            IF   l_r004fhr.fimpto > 0 THEN
                 /* qdo a hora final for menor que a hora inicial significa que */
                 /* a faixa termina no proximo dia.                             */
                 IF   l_r004fhr.fimpto < l_r004fhr.iniace THEN
                      IF  l_r004fhr.fimpto > l_timenextday THEN
                          l_timenextday := l_r004fhr.fimpto;
                      END IF;
                      l_horstr := '2359';
                 ELSE SP_INTSTR(l_r004fhr.fimpto,'HHMM',l_horstr OUT);
                 END IF;
                 l_faipto := l_faipto || l_horstr;
            ELSE l_faipto := l_faipto || '0000';
            END IF;


            IF   LENGTH(l_faipto) >= 56 THEN
                 EXIT;
            END IF;
          END LOOP;

    ELSE l_faipto := '24002400';
         l_faiace := '24002400';
    END IF;

    l_achou := TRUE;
    BEGIN
         SELECT DATENT,HORENT,DATVAL,HORVAL
           INTO l_datent,l_horent,l_datval,l_horval
           FROM R071AEO
          WHERE NUMEMP = p_numemp
            AND NUMCAD = p_numcad
            AND DATENT <= l_data  /*VALIDA PELA SAÍDA SE SAÍDA MENOR QUE VALIDADE, OU O CONTRÁRIO.*/
            AND ( ( (DATSAI <> l_data_zero AND DATSAI < DATVAL) AND ( (DATSAI > l_data) OR (DATSAI = l_data AND HORSAI > l_hora) ) )
                 OR ( (DATVAL = l_data_zero OR DATVAL > l_data) OR (DATVAL = l_data AND HORVAL > l_hora) ) );
    EXCEPTION
         WHEN NO_DATA_FOUND THEN l_achou := FALSE;
         WHEN OTHERS THEN RAISERROR 103 'SPFaiOcr: Erro No SELECT R071AEO.';
    END;

    IF (l_achou = TRUE) THEN
        l_faixa := '';
        IF    l_datent = l_datval THEN /* entrada e saida no mesmo dia */
              SP_INTSTR(l_horent,'HHMM',l_horstr OUT);
              l_faixa := l_horstr;
              SP_INTSTR(l_horval,'HHMM',l_horstr OUT);
              l_faixa := l_faixa || l_horstr;
        ELSIF l_datent = l_data THEN /* não sai no mesmo dia */
              SP_INTSTR(l_horent,'HHMM',l_horstr OUT);
              l_faixa := l_horstr || '2359';
        ELSIF l_datval = l_data THEN /* esta saindo no dia */
              SP_INTSTR(l_horval,'HHMM',l_horstr OUT);
              l_faixa :=  '0000' || l_horstr;
        ELSE  l_faixa :=  '00002359'; /* entrada e saida fora do dia */
        END IF;
        l_faiace := l_faiace || l_faixa;
        l_faipto := l_faipto || l_faixa;
    END IF;

    LOOP
        IF  (LENGTH(l_faiace) < 56) OR (l_faiace IS NULL) THEN
            l_faiace := l_faiace || '24002400';
        ELSIF (LENGTH(l_faipto) < 56) OR (l_faipto IS NULL) THEN
            l_faipto := l_faipto || '24002400';
        ELSE  EXIT;
        END IF;
    END LOOP;

      l_iniref := 0;
      l_cont := 0;
      l_fairef := '';
      FOREACH c_r004mhr INTO  l_r004mhr.horbat,
                              l_r004mhr.faimov,
                              l_r004mhr.seqmar
      LOOP
          IF  l_r004mhr.faimov > 0 THEN
              l_horref := l_r004mhr.faimov;
          ELSE
              l_horref := l_r004mhr.horbat;
          END IF;
          IF  l_cont = 0 THEN
              l_iniref := l_horref;
              l_cont := l_cont + 1;
          ELSE
              SP_INTSTR(l_iniref,'HHMM',l_strini OUT);
              SP_INTSTR(l_horref,'HHMM',l_strfim OUT);
              l_fairef := l_strini||l_strfim;
              l_cont := 0;
          END IF;
      END LOOP;

      IF  (LENGTH(l_fairef)<8) OR (l_fairef IS NULL) OR (l_fairef='0') OR (l_fairef='') THEN
          l_fairef := '';
          l_fairef := '24002400';
      END IF;

      l_faiace     := SUBSTRING(l_faiace,1,56);
      l_faipto     := SUBSTRING(l_faipto,1,56);

      l_dia_semana := DAYOFWEEK(l_data);
      IF  l_dia_semana = 1 THEN
          p_faidom_ace := l_faiace;
          p_faidom_pto := l_faipto;
          l_faidom_ref := l_fairef;
      ELSIF l_dia_semana = 2 THEN
          p_faiseg_ace := l_faiace;
          p_faiseg_pto := l_faipto;
          l_faiseg_ref := l_fairef;
      ELSIF l_dia_semana = 3 THEN
          p_faiter_ace := l_faiace;
          p_faiter_pto := l_faipto;
          l_faiter_ref := l_fairef;
      ELSIF l_dia_semana = 4 THEN
          p_faiqua_ace := l_faiace;
          p_faiqua_pto := l_faipto;
          l_faiqua_ref := l_fairef;
      ELSIF l_dia_semana = 5 THEN
          p_faiqui_ace := l_faiace;
          p_faiqui_pto := l_faipto;
          l_faiqui_ref := l_fairef;
      ELSIF l_dia_semana = 6 THEN
          p_faisex_ace := l_faiace;
          p_faisex_pto := l_faipto;
          l_faisex_ref := l_fairef;
      ELSE p_faisab_ace := l_faiace;
          p_faisab_pto := l_faipto;
          l_faisab_ref := l_fairef;          
      END IF;

    /* Quando o horário é do terceiro turno percorrer um dia a mais para completar o horario do dia anterior. */
    IF   (l_data > l_data_limite) THEN
         l_timenextday := 0;
    END IF;

    l_data := DATETimeAdd(DD,1,l_data);
  END LOOP;

  p_fairef := l_faidom_ref || l_faiseg_ref || l_faiter_ref || l_faiqua_ref ||
              l_faiqui_ref || l_faisex_ref || l_faisab_ref;
END		SENIOR;22!RH_DATFIM
SP_INTSTR
HR_HOROCR
Æ%␀␀


PROCEDURE SP_FAIOCR(P_NUMEMP NUMBER(4),P_NUMCAD NUMBER(9),P_CODESC NUMBER,P_CODTMA NUMBER,P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56))
 IS

l_data        DATE;
  l_data_zero   DATE;
  l_data_inicio DATE;
  l_data_limite DATE;
  l_dia_semana  NUMBER(1);
  l_codhor      NUMBER(4);
  l_hora        NUMBER(4);
  l_coderr      NUMBER(2);
  l_faiace      VARCHAR2(255);
  l_faixa       VARCHAR2(255);
  l_faipto      VARCHAR2(255);
  l_horstr      CHAR(4);
  l_timenextday NUMBER(5);
  l_datent      DATE;
  l_datval      DATE;
  l_horent      NUMBER(5);
  l_horval      NUMBER(5);
  l_achou       BOOLEAN;
  l_iniref      NUMBER(5);
  l_fairef      VARCHAR(08);
  l_faidom_ref  VARCHAR(08);
  l_faiseg_ref  VARCHAR(08);
  l_faiter_ref  VARCHAR(08);
  l_faiqua_ref  VARCHAR(08);
  l_faiqui_ref  VARCHAR(08);
  l_faisex_ref  VARCHAR(08);
  l_faisab_ref  VARCHAR(08);
  l_cont        INTEGER;
  l_horref      NUMBER(5);
  l_strini      CHAR(4);
  l_strfim      CHAR(4);
  
      
  CURSOR c_r004fhr IS
      SELECT INIACE INIACE,FIMACE FIMACE, INIPTO INIPTO, FIMPTO FIMPTO FROM R004FHR
             WHERE R004FHR.CODHOR = l_codhor ORDER BY 1;
  TYPE t_r004fhr IS RECORD(
      INIACE   R004FHR.INIACE%TYPE,
      FIMACE   R004FHR.FIMACE%TYPE,
      INIPTO   R004FHR.INIPTO%TYPE,
      FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;

  CURSOR c_r004mhr IS
      SELECT HORBAT, FAIMOV, SEQMAR FROM R004MHR R004MHR
             WHERE USOBAT IN (4,6) AND CODHOR=l_codhor ORDER BY SEQMAR;
  TYPE t_r004mhr IS RECORD(
      HORBAT   R004MHR.HORBAT%TYPE,
      FAIMOV   R004MHR.FAIMOV%TYPE,
      SEQMAR   R004MHR.SEQMAR%TYPE);
  l_r004mhr t_r004mhr;

BEGIN
  /* Inicializa */
  l_data := CURDATE();
  l_hora := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_inicio := l_data;
  l_timenextday := 0;
  l_fairef := '';
  l_faidom_ref := '';
  l_faiseg_ref := '';
  l_faiter_ref := '';
  l_faiqua_ref := '';
  l_faiqui_ref := '';
  l_faisex_ref := '';
  l_faisab_ref := '';
  RH_DatFim (l_data_limite OUT);

  LOOP
    /* Condicao p/ Controle LOOP */
    IF   l_data > l_data_limite THEN
         EXIT;
    END IF;

    l_faiace := '';
    l_faipto := '';
    IF  l_timenextday > 0 THEN
        SP_INTSTR(l_timenextday,'HHMM',l_horstr OUT);
        l_faiace := '0000' || l_horstr;
        l_faipto := '0000' || l_horstr;
    END IF;

    /* Pega o codigo do horário */
    HR_HOROCR (p_numemp,p_codesc, p_codtma, l_data, l_codhor OUT, l_coderr OUT);

    IF   l_coderr = 0 THEN

          l_timenextday := 0;
          FOREACH c_r004fhr INTO  l_r004fhr.iniace,
                                  l_r004fhr.fimace,
                                  l_r004fhr.inipto,
                                  l_r004fhr.fimpto
          LOOP
            IF   l_r004fhr.iniace > 0 THEN
                 SP_INTSTR(l_r004fhr.iniace,'HHMM',l_horstr OUT);
                 l_faiace := l_faiace || l_horstr;
            ELSE l_faiace := l_faiace || '0000';
            END IF;

            IF   l_r004fhr.inipto > 0 THEN
                 SP_INTSTR(l_r004fhr.iniace,'HHMM',l_horstr OUT);
                 l_faipto := l_faipto || l_horstr;
            ELSE l_faipto := l_faipto || '0000';
            END IF;

            IF   l_r004fhr.fimace > 0 THEN
                 /* qdo a hora final for menor que a hora inicial significa que */
                 /* a faixa termina no proximo dia.                             */
                 IF   l_r004fhr.fimace < l_r004fhr.iniace THEN
                      IF  l_r004fhr.fimace > l_timenextday THEN
                          l_timenextday := l_r004fhr.fimace;
                      END IF;
                      l_horstr := '2359';
                 ELSE SP_INTSTR(l_r004fhr.fimace,'HHMM',l_horstr OUT);
                 END IF;
                 l_faiace := l_faiace || l_horstr;
            ELSE l_faiace := l_faiace || '0000';
            END IF;

            IF   l_r004fhr.fimpto > 0 THEN
                 /* qdo a hora final for menor que a hora inicial significa que */
                 /* a faixa termina no proximo dia.                             */
                 IF   l_r004fhr.fimpto < l_r004fhr.iniace THEN
                      IF  l_r004fhr.fimpto > l_timenextday THEN
                          l_timenextday := l_r004fhr.fimpto;
                      END IF;
                      l_horstr := '2359';
                 ELSE SP_INTSTR(l_r004fhr.fimpto,'HHMM',l_horstr OUT);
                 END IF;
                 l_faipto := l_faipto || l_horstr;
            ELSE l_faipto := l_faipto || '0000';
            END IF;


            IF   LENGTH(l_faipto) >= 56 THEN
                 EXIT;
            END IF;
          END LOOP;

    ELSE l_faipto := '24002400';
         l_faiace := '24002400';
    END IF;

    l_achou := TRUE;
    BEGIN
         SELECT DATENT,HORENT,DATVAL,HORVAL
           INTO l_datent,l_horent,l_datval,l_horval
           FROM R071AEO
          WHERE NUMEMP = p_numemp
            AND NUMCAD = p_numcad
            AND DATENT <= l_data  /*VALIDA PELA SAÍDA SE SAÍDA MENOR QUE VALIDADE, OU O CONTRÁRIO.*/
            AND ( ( (DATSAI <> l_data_zero AND DATSAI < DATVAL) AND ( (DATSAI > l_data) OR (DATSAI = l_data AND HORSAI > l_hora) ) )
                 OR ( (DATVAL = l_data_zero OR DATVAL > l_data) OR (DATVAL = l_data AND HORVAL > l_hora) ) );
    EXCEPTION
         WHEN NO_DATA_FOUND THEN l_achou := FALSE;
         WHEN OTHERS THEN RAISERROR 103 'SPFaiOcr: Erro No SELECT R071AEO.';
    END;

    IF (l_achou = TRUE) THEN
        l_faixa := '';
        IF    l_datent = l_datval THEN /* entrada e saida no mesmo dia */
              SP_INTSTR(l_horent,'HHMM',l_horstr OUT);
              l_faixa := l_horstr;
              SP_INTSTR(l_horval,'HHMM',l_horstr OUT);
              l_faixa := l_faixa || l_horstr;
        ELSIF l_datent = l_data THEN /* não sai no mesmo dia */
              SP_INTSTR(l_horent,'HHMM',l_horstr OUT);
              l_faixa := l_horstr || '2359';
        ELSIF l_datval = l_data THEN /* esta saindo no dia */
              SP_INTSTR(l_horval,'HHMM',l_horstr OUT);
              l_faixa :=  '0000' || l_horstr;
        ELSE  l_faixa :=  '00002359'; /* entrada e saida fora do dia */
        END IF;
        l_faiace := l_faiace || l_faixa;
        l_faipto := l_faipto || l_faixa;
    END IF;

    LOOP
        IF  (LENGTH(l_faiace) < 56) OR (l_faiace IS NULL) THEN
            l_faiace := l_faiace || '24002400';
        ELSIF (LENGTH(l_faipto) < 56) OR (l_faipto IS NULL) THEN
            l_faipto := l_faipto || '24002400';
        ELSE  EXIT;
        END IF;
    END LOOP;

      l_iniref := 0;
      l_cont := 0;
      l_fairef := '';
      FOREACH c_r004mhr INTO  l_r004mhr.horbat,
                              l_r004mhr.faimov,
                              l_r004mhr.seqmar
      LOOP
          IF  l_r004mhr.faimov > 0 THEN
              l_horref := l_r004mhr.faimov;
          ELSE
              l_horref := l_r004mhr.horbat;
          END IF;
          IF  l_cont = 0 THEN
              l_iniref := l_horref;
              l_cont := l_cont + 1;
          ELSE
              SP_INTSTR(l_iniref,'HHMM',l_strini OUT);
              SP_INTSTR(l_horref,'HHMM',l_strfim OUT);
              l_fairef := l_strini||l_strfim;
              l_cont := 0;
          END IF;
      END LOOP;

      IF  (LENGTH(l_fairef)<8) OR (l_fairef IS NULL) OR (l_fairef='0') OR (l_fairef='') THEN
          l_fairef := '';
          l_fairef := '24002400';
      END IF;

      l_faiace     := SUBSTRING(l_faiace,1,56);
      l_faipto     := SUBSTRING(l_faipto,1,56);

      l_dia_semana := DAYOFWEEK(l_data);
      IF  l_dia_semana = 1 THEN
          p_faidom_ace := l_faiace;
          p_faidom_pto := l_faipto;
          l_faidom_ref := l_fairef;
      ELSIF l_dia_semana = 2 THEN
          p_faiseg_ace := l_faiace;
          p_faiseg_pto := l_faipto;
          l_faiseg_ref := l_fairef;
      ELSIF l_dia_semana = 3 THEN
          p_faiter_ace := l_faiace;
          p_faiter_pto := l_faipto;
          l_faiter_ref := l_fairef;
      ELSIF l_dia_semana = 4 THEN
          p_faiqua_ace := l_faiace;
          p_faiqua_pto := l_faipto;
          l_faiqua_ref := l_fairef;
      ELSIF l_dia_semana = 5 THEN
          p_faiqui_ace := l_faiace;
          p_faiqui_pto := l_faipto;
          l_faiqui_ref := l_fairef;
      ELSIF l_dia_semana = 6 THEN
          p_faisex_ace := l_faiace;
          p_faisex_pto := l_faipto;
          l_faisex_ref := l_fairef;
      ELSE p_faisab_ace := l_faiace;
          p_faisab_pto := l_faipto;
          l_faisab_ref := l_fairef;          
      END IF;

    /* Quando o horário é do terceiro turno percorrer um dia a mais para completar o horario do dia anterior. */
    IF   (l_data > l_data_limite) THEN
         l_timenextday := 0;
    END IF;

    l_data := DATETimeAdd(DD,1,l_data);
  END LOOP;

  p_fairef := l_faidom_ref || l_faiseg_ref || l_faiter_ref || l_faiqua_ref ||
              l_faiqui_ref || l_faisex_ref || l_faisab_ref;
END		SENIOR;23!RH_DATFIM
SP_INTSTR
HR_HOROCR
Æ%␀␀


PROCEDURE SP_FAIOCR(P_NUMEMP NUMBER(4),P_NUMCAD NUMBER(9),P_CODESC NUMBER,P_CODTMA NUMBER,P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56))
 IS

l_data        DATE;
  l_data_zero   DATE;
  l_data_inicio DATE;
  l_data_limite DATE;
  l_dia_semana  NUMBER(1);
  l_codhor      NUMBER(4);
  l_hora        NUMBER(4);
  l_coderr      NUMBER(2);
  l_faiace      VARCHAR2(255);
  l_faixa       VARCHAR2(255);
  l_faipto      VARCHAR2(255);
  l_horstr      CHAR(4);
  l_timenextday NUMBER(5);
  l_datent      DATE;
  l_datval      DATE;
  l_horent      NUMBER(5);
  l_horval      NUMBER(5);
  l_achou       BOOLEAN;
  l_iniref      NUMBER(5);
  l_fairef      VARCHAR(08);
  l_faidom_ref  VARCHAR(08);
  l_faiseg_ref  VARCHAR(08);
  l_faiter_ref  VARCHAR(08);
  l_faiqua_ref  VARCHAR(08);
  l_faiqui_ref  VARCHAR(08);
  l_faisex_ref  VARCHAR(08);
  l_faisab_ref  VARCHAR(08);
  l_cont        INTEGER;
  l_horref      NUMBER(5);
  l_strini      CHAR(4);
  l_strfim      CHAR(4);
  
      
  CURSOR c_r004fhr IS
      SELECT INIACE INIACE,FIMACE FIMACE, INIPTO INIPTO, FIMPTO FIMPTO FROM R004FHR
             WHERE R004FHR.CODHOR = l_codhor ORDER BY 1;
  TYPE t_r004fhr IS RECORD(
      INIACE   R004FHR.INIACE%TYPE,
      FIMACE   R004FHR.FIMACE%TYPE,
      INIPTO   R004FHR.INIPTO%TYPE,
      FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;

  CURSOR c_r004mhr IS
      SELECT HORBAT, FAIMOV, SEQMAR FROM R004MHR R004MHR
             WHERE USOBAT IN (4,6) AND CODHOR=l_codhor ORDER BY SEQMAR;
  TYPE t_r004mhr IS RECORD(
      HORBAT   R004MHR.HORBAT%TYPE,
      FAIMOV   R004MHR.FAIMOV%TYPE,
      SEQMAR   R004MHR.SEQMAR%TYPE);
  l_r004mhr t_r004mhr;

BEGIN
  /* Inicializa */
  l_data := CURDATE();
  l_hora := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_inicio := l_data;
  l_timenextday := 0;
  l_fairef := '';
  l_faidom_ref := '';
  l_faiseg_ref := '';
  l_faiter_ref := '';
  l_faiqua_ref := '';
  l_faiqui_ref := '';
  l_faisex_ref := '';
  l_faisab_ref := '';
  RH_DatFim (l_data_limite OUT);

  LOOP
    /* Condicao p/ Controle LOOP */
    IF   l_data > l_data_limite THEN
         EXIT;
    END IF;

    l_faiace := '';
    l_faipto := '';
    IF  l_timenextday > 0 THEN
        SP_INTSTR(l_timenextday,'HHMM',l_horstr OUT);
        l_faiace := '0000' || l_horstr;
        l_faipto := '0000' || l_horstr;
    END IF;

    /* Pega o codigo do horário */
    HR_HOROCR (p_numemp,p_codesc, p_codtma, l_data, l_codhor OUT, l_coderr OUT);

    IF   l_coderr = 0 THEN

          l_timenextday := 0;
          FOREACH c_r004fhr INTO  l_r004fhr.iniace,
                                  l_r004fhr.fimace,
                                  l_r004fhr.inipto,
                                  l_r004fhr.fimpto
          LOOP
            IF   l_r004fhr.iniace > 0 THEN
                 SP_INTSTR(l_r004fhr.iniace,'HHMM',l_horstr OUT);
                 l_faiace := l_faiace || l_horstr;
            ELSE l_faiace := l_faiace || '0000';
            END IF;

            IF   l_r004fhr.inipto > 0 THEN
                 SP_INTSTR(l_r004fhr.iniace,'HHMM',l_horstr OUT);
                 l_faipto := l_faipto || l_horstr;
            ELSE l_faipto := l_faipto || '0000';
            END IF;

            IF   l_r004fhr.fimace > 0 THEN
                 /* qdo a hora final for menor que a hora inicial significa que */
                 /* a faixa termina no proximo dia.                             */
                 IF   l_r004fhr.fimace < l_r004fhr.iniace THEN
                      IF  l_r004fhr.fimace > l_timenextday THEN
                          l_timenextday := l_r004fhr.fimace;
                      END IF;
                      l_horstr := '2359';
                 ELSE SP_INTSTR(l_r004fhr.fimace,'HHMM',l_horstr OUT);
                 END IF;
                 l_faiace := l_faiace || l_horstr;
            ELSE l_faiace := l_faiace || '0000';
            END IF;

            IF   l_r004fhr.fimpto > 0 THEN
                 /* qdo a hora final for menor que a hora inicial significa que */
                 /* a faixa termina no proximo dia.                             */
                 IF   l_r004fhr.fimpto < l_r004fhr.iniace THEN
                      IF  l_r004fhr.fimpto > l_timenextday THEN
                          l_timenextday := l_r004fhr.fimpto;
                      END IF;
                      l_horstr := '2359';
                 ELSE SP_INTSTR(l_r004fhr.fimpto,'HHMM',l_horstr OUT);
                 END IF;
                 l_faipto := l_faipto || l_horstr;
            ELSE l_faipto := l_faipto || '0000';
            END IF;


            IF   LENGTH(l_faipto) >= 56 THEN
                 EXIT;
            END IF;
          END LOOP;

    ELSE l_faipto := '24002400';
         l_faiace := '24002400';
    END IF;

    l_achou := TRUE;
    BEGIN
         SELECT DATENT,HORENT,DATVAL,HORVAL
           INTO l_datent,l_horent,l_datval,l_horval
           FROM R071AEO
          WHERE NUMEMP = p_numemp
            AND NUMCAD = p_numcad
            AND DATENT <= l_data  /*VALIDA PELA SAÍDA SE SAÍDA MENOR QUE VALIDADE, OU O CONTRÁRIO.*/
            AND ( ( (DATSAI <> l_data_zero AND DATSAI < DATVAL) AND ( (DATSAI > l_data) OR (DATSAI = l_data AND HORSAI > l_hora) ) )
                 OR ( (DATVAL = l_data_zero OR DATVAL > l_data) OR (DATVAL = l_data AND HORVAL > l_hora) ) );
    EXCEPTION
         WHEN NO_DATA_FOUND THEN l_achou := FALSE;
         WHEN OTHERS THEN RAISERROR 103 'SPFaiOcr: Erro No SELECT R071AEO.';
    END;

    IF (l_achou = TRUE) THEN
        l_faixa := '';
        IF    l_datent = l_datval THEN /* entrada e saida no mesmo dia */
              SP_INTSTR(l_horent,'HHMM',l_horstr OUT);
              l_faixa := l_horstr;
              SP_INTSTR(l_horval,'HHMM',l_horstr OUT);
              l_faixa := l_faixa || l_horstr;
        ELSIF l_datent = l_data THEN /* não sai no mesmo dia */
              SP_INTSTR(l_horent,'HHMM',l_horstr OUT);
              l_faixa := l_horstr || '2359';
        ELSIF l_datval = l_data THEN /* esta saindo no dia */
              SP_INTSTR(l_horval,'HHMM',l_horstr OUT);
              l_faixa :=  '0000' || l_horstr;
        ELSE  l_faixa :=  '00002359'; /* entrada e saida fora do dia */
        END IF;
        l_faiace := l_faiace || l_faixa;
        l_faipto := l_faipto || l_faixa;
    END IF;

    LOOP
        IF  (LENGTH(l_faiace) < 56) OR (l_faiace IS NULL) THEN
            l_faiace := l_faiace || '24002400';
        ELSIF (LENGTH(l_faipto) < 56) OR (l_faipto IS NULL) THEN
            l_faipto := l_faipto || '24002400';
        ELSE  EXIT;
        END IF;
    END LOOP;

      l_iniref := 0;
      l_cont := 0;
      l_fairef := '';
      FOREACH c_r004mhr INTO  l_r004mhr.horbat,
                              l_r004mhr.faimov,
                              l_r004mhr.seqmar
      LOOP
          IF  l_r004mhr.faimov > 0 THEN
              l_horref := l_r004mhr.faimov;
          ELSE
              l_horref := l_r004mhr.horbat;
          END IF;
          IF  l_cont = 0 THEN
              l_iniref := l_horref;
              l_cont := l_cont + 1;
          ELSE
              SP_INTSTR(l_iniref,'HHMM',l_strini OUT);
              SP_INTSTR(l_horref,'HHMM',l_strfim OUT);
              l_fairef := l_strini||l_strfim;
              l_cont := 0;
          END IF;
      END LOOP;

      IF  (LENGTH(l_fairef)<8) OR (l_fairef IS NULL) OR (l_fairef='0') OR (l_fairef='') THEN
          l_fairef := '';
          l_fairef := '24002400';
      END IF;

      l_faiace     := SUBSTRING(l_faiace,1,56);
      l_faipto     := SUBSTRING(l_faipto,1,56);

      l_dia_semana := DAYOFWEEK(l_data);
      IF  l_dia_semana = 1 THEN
          p_faidom_ace := l_faiace;
          p_faidom_pto := l_faipto;
          l_faidom_ref := l_fairef;
      ELSIF l_dia_semana = 2 THEN
          p_faiseg_ace := l_faiace;
          p_faiseg_pto := l_faipto;
          l_faiseg_ref := l_fairef;
      ELSIF l_dia_semana = 3 THEN
          p_faiter_ace := l_faiace;
          p_faiter_pto := l_faipto;
          l_faiter_ref := l_fairef;
      ELSIF l_dia_semana = 4 THEN
          p_faiqua_ace := l_faiace;
          p_faiqua_pto := l_faipto;
          l_faiqua_ref := l_fairef;
      ELSIF l_dia_semana = 5 THEN
          p_faiqui_ace := l_faiace;
          p_faiqui_pto := l_faipto;
          l_faiqui_ref := l_fairef;
      ELSIF l_dia_semana = 6 THEN
          p_faisex_ace := l_faiace;
          p_faisex_pto := l_faipto;
          l_faisex_ref := l_fairef;
      ELSE p_faisab_ace := l_faiace;
          p_faisab_pto := l_faipto;
          l_faisab_ref := l_fairef;          
      END IF;

    /* Quando o horário é do terceiro turno percorrer um dia a mais para completar o horario do dia anterior. */
    IF   (l_data > l_data_limite) THEN
         l_timenextday := 0;
    END IF;

    l_data := DATETimeAdd(DD,1,l_data);
  END LOOP;

  p_fairef := l_faidom_ref || l_faiseg_ref || l_faiter_ref || l_faiqua_ref ||
              l_faiqui_ref || l_faisex_ref || l_faisab_ref;
END		SENIOR;24!RH_DATFIM
SP_INTSTR
HR_HOROCR
Æ%␀␀


PROCEDURE SP_FAIOCR(P_NUMEMP NUMBER(4),P_NUMCAD NUMBER(9),P_CODESC NUMBER,P_CODTMA NUMBER,P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56))
 IS

l_data        DATE;
  l_data_zero   DATE;
  l_data_inicio DATE;
  l_data_limite DATE;
  l_dia_semana  NUMBER(1);
  l_codhor      NUMBER(4);
  l_hora        NUMBER(4);
  l_coderr      NUMBER(2);
  l_faiace      VARCHAR2(255);
  l_faixa       VARCHAR2(255);
  l_faipto      VARCHAR2(255);
  l_horstr      CHAR(4);
  l_timenextday NUMBER(5);
  l_datent      DATE;
  l_datval      DATE;
  l_horent      NUMBER(5);
  l_horval      NUMBER(5);
  l_achou       BOOLEAN;
  l_iniref      NUMBER(5);
  l_fairef      VARCHAR(08);
  l_faidom_ref  VARCHAR(08);
  l_faiseg_ref  VARCHAR(08);
  l_faiter_ref  VARCHAR(08);
  l_faiqua_ref  VARCHAR(08);
  l_faiqui_ref  VARCHAR(08);
  l_faisex_ref  VARCHAR(08);
  l_faisab_ref  VARCHAR(08);
  l_cont        INTEGER;
  l_horref      NUMBER(5);
  l_strini      CHAR(4);
  l_strfim      CHAR(4);
  
      
  CURSOR c_r004fhr IS
      SELECT INIACE INIACE,FIMACE FIMACE, INIPTO INIPTO, FIMPTO FIMPTO FROM R004FHR
             WHERE R004FHR.CODHOR = l_codhor ORDER BY 1;
  TYPE t_r004fhr IS RECORD(
      INIACE   R004FHR.INIACE%TYPE,
      FIMACE   R004FHR.FIMACE%TYPE,
      INIPTO   R004FHR.INIPTO%TYPE,
      FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;

  CURSOR c_r004mhr IS
      SELECT HORBAT, FAIMOV, SEQMAR FROM R004MHR R004MHR
             WHERE USOBAT IN (4,6) AND CODHOR=l_codhor ORDER BY SEQMAR;
  TYPE t_r004mhr IS RECORD(
      HORBAT   R004MHR.HORBAT%TYPE,
      FAIMOV   R004MHR.FAIMOV%TYPE,
      SEQMAR   R004MHR.SEQMAR%TYPE);
  l_r004mhr t_r004mhr;

BEGIN
  /* Inicializa */
  l_data := CURDATE();
  l_hora := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_inicio := l_data;
  l_timenextday := 0;
  l_fairef := '';
  l_faidom_ref := '';
  l_faiseg_ref := '';
  l_faiter_ref := '';
  l_faiqua_ref := '';
  l_faiqui_ref := '';
  l_faisex_ref := '';
  l_faisab_ref := '';
  RH_DatFim (l_data_limite OUT);

  LOOP
    /* Condicao p/ Controle LOOP */
    IF   l_data > l_data_limite THEN
         EXIT;
    END IF;

    l_faiace := '';
    l_faipto := '';
    IF  l_timenextday > 0 THEN
        SP_INTSTR(l_timenextday,'HHMM',l_horstr OUT);
        l_faiace := '0000' || l_horstr;
        l_faipto := '0000' || l_horstr;
    END IF;

    /* Pega o codigo do horário */
    HR_HOROCR (p_numemp,p_codesc, p_codtma, l_data, l_codhor OUT, l_coderr OUT);

    IF   l_coderr = 0 THEN

          l_timenextday := 0;
          FOREACH c_r004fhr INTO  l_r004fhr.iniace,
                                  l_r004fhr.fimace,
                                  l_r004fhr.inipto,
                                  l_r004fhr.fimpto
          LOOP
            IF   l_r004fhr.iniace > 0 THEN
                 SP_INTSTR(l_r004fhr.iniace,'HHMM',l_horstr OUT);
                 l_faiace := l_faiace || l_horstr;
            ELSE l_faiace := l_faiace || '0000';
            END IF;

            IF   l_r004fhr.inipto > 0 THEN
                 SP_INTSTR(l_r004fhr.iniace,'HHMM',l_horstr OUT);
                 l_faipto := l_faipto || l_horstr;
            ELSE l_faipto := l_faipto || '0000';
            END IF;

            IF   l_r004fhr.fimace > 0 THEN
                 /* qdo a hora final for menor que a hora inicial significa que */
                 /* a faixa termina no proximo dia.                             */
                 IF   l_r004fhr.fimace < l_r004fhr.iniace THEN
                      IF  l_r004fhr.fimace > l_timenextday THEN
                          l_timenextday := l_r004fhr.fimace;
                      END IF;
                      l_horstr := '2359';
                 ELSE SP_INTSTR(l_r004fhr.fimace,'HHMM',l_horstr OUT);
                 END IF;
                 l_faiace := l_faiace || l_horstr;
            ELSE l_faiace := l_faiace || '0000';
            END IF;

            IF   l_r004fhr.fimpto > 0 THEN
                 /* qdo a hora final for menor que a hora inicial significa que */
                 /* a faixa termina no proximo dia.                             */
                 IF   l_r004fhr.fimpto < l_r004fhr.iniace THEN
                      IF  l_r004fhr.fimpto > l_timenextday THEN
                          l_timenextday := l_r004fhr.fimpto;
                      END IF;
                      l_horstr := '2359';
                 ELSE SP_INTSTR(l_r004fhr.fimpto,'HHMM',l_horstr OUT);
                 END IF;
                 l_faipto := l_faipto || l_horstr;
            ELSE l_faipto := l_faipto || '0000';
            END IF;


            IF   LENGTH(l_faipto) >= 56 THEN
                 EXIT;
            END IF;
          END LOOP;

    ELSE l_faipto := '24002400';
         l_faiace := '24002400';
    END IF;

    l_achou := TRUE;
    BEGIN
         SELECT DATENT,HORENT,DATVAL,HORVAL
           INTO l_datent,l_horent,l_datval,l_horval
           FROM R071AEO
          WHERE NUMEMP = p_numemp
            AND NUMCAD = p_numcad
            AND DATENT <= l_data  /*VALIDA PELA SAÍDA SE SAÍDA MENOR QUE VALIDADE, OU O CONTRÁRIO.*/
            AND ( ( (DATSAI <> l_data_zero AND DATSAI < DATVAL) AND ( (DATSAI > l_data) OR (DATSAI = l_data AND HORSAI > l_hora) ) )
                 OR ( (DATVAL = l_data_zero OR DATVAL > l_data) OR (DATVAL = l_data AND HORVAL > l_hora) ) );
    EXCEPTION
         WHEN NO_DATA_FOUND THEN l_achou := FALSE;
         WHEN OTHERS THEN RAISERROR 103 'SPFaiOcr: Erro No SELECT R071AEO.';
    END;

    IF (l_achou = TRUE) THEN
        l_faixa := '';
        IF    l_datent = l_datval THEN /* entrada e saida no mesmo dia */
              SP_INTSTR(l_horent,'HHMM',l_horstr OUT);
              l_faixa := l_horstr;
              SP_INTSTR(l_horval,'HHMM',l_horstr OUT);
              l_faixa := l_faixa || l_horstr;
        ELSIF l_datent = l_data THEN /* não sai no mesmo dia */
              SP_INTSTR(l_horent,'HHMM',l_horstr OUT);
              l_faixa := l_horstr || '2359';
        ELSIF l_datval = l_data THEN /* esta saindo no dia */
              SP_INTSTR(l_horval,'HHMM',l_horstr OUT);
              l_faixa :=  '0000' || l_horstr;
        ELSE  l_faixa :=  '00002359'; /* entrada e saida fora do dia */
        END IF;
        l_faiace := l_faiace || l_faixa;
        l_faipto := l_faipto || l_faixa;
    END IF;

    LOOP
        IF  (LENGTH(l_faiace) < 56) OR (l_faiace IS NULL) THEN
            l_faiace := l_faiace || '24002400';
        ELSIF (LENGTH(l_faipto) < 56) OR (l_faipto IS NULL) THEN
            l_faipto := l_faipto || '24002400';
        ELSE  EXIT;
        END IF;
    END LOOP;

      l_iniref := 0;
      l_cont := 0;
      l_fairef := '';
      FOREACH c_r004mhr INTO  l_r004mhr.horbat,
                              l_r004mhr.faimov,
                              l_r004mhr.seqmar
      LOOP
          IF  l_r004mhr.faimov > 0 THEN
              l_horref := l_r004mhr.faimov;
          ELSE
              l_horref := l_r004mhr.horbat;
          END IF;
          IF  l_cont = 0 THEN
              l_iniref := l_horref;
              l_cont := l_cont + 1;
          ELSE
              SP_INTSTR(l_iniref,'HHMM',l_strini OUT);
              SP_INTSTR(l_horref,'HHMM',l_strfim OUT);
              l_fairef := l_strini||l_strfim;
              l_cont := 0;
          END IF;
      END LOOP;

      IF  (LENGTH(l_fairef)<8) OR (l_fairef IS NULL) OR (l_fairef='0') OR (l_fairef='') THEN
          l_fairef := '';
          l_fairef := '24002400';
      END IF;

      l_faiace     := SUBSTRING(l_faiace,1,56);
      l_faipto     := SUBSTRING(l_faipto,1,56);

      l_dia_semana := DAYOFWEEK(l_data);
      IF  l_dia_semana = 1 THEN
          p_faidom_ace := l_faiace;
          p_faidom_pto := l_faipto;
          l_faidom_ref := l_fairef;
      ELSIF l_dia_semana = 2 THEN
          p_faiseg_ace := l_faiace;
          p_faiseg_pto := l_faipto;
          l_faiseg_ref := l_fairef;
      ELSIF l_dia_semana = 3 THEN
          p_faiter_ace := l_faiace;
          p_faiter_pto := l_faipto;
          l_faiter_ref := l_fairef;
      ELSIF l_dia_semana = 4 THEN
          p_faiqua_ace := l_faiace;
          p_faiqua_pto := l_faipto;
          l_faiqua_ref := l_fairef;
      ELSIF l_dia_semana = 5 THEN
          p_faiqui_ace := l_faiace;
          p_faiqui_pto := l_faipto;
          l_faiqui_ref := l_fairef;
      ELSIF l_dia_semana = 6 THEN
          p_faisex_ace := l_faiace;
          p_faisex_pto := l_faipto;
          l_faisex_ref := l_fairef;
      ELSE p_faisab_ace := l_faiace;
          p_faisab_pto := l_faipto;
          l_faisab_ref := l_fairef;          
      END IF;

    /* Quando o horário é do terceiro turno percorrer um dia a mais para completar o horario do dia anterior. */
    IF   (l_data > l_data_limite) THEN
         l_timenextday := 0;
    END IF;

    l_data := DATETimeAdd(DD,1,l_data);
  END LOOP;

  p_fairef := l_faidom_ref || l_faiseg_ref || l_faiter_ref || l_faiqua_ref ||
              l_faiqui_ref || l_faisex_ref || l_faisab_ref;
END␀5ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
