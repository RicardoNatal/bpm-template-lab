i␀␀PROCEDURE SP_PENDAce62(P_TIPOPE VARCHAR2(1),P_NUMCRA NUMBER(12),P_NUMFIS NUMBER(12),P_TECCRA NUMBER(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1),P_TIPCRA NUMBER(1),
	                   P_CODPRMOLD NUMBER(5),P_PRMSABOLD NUMBER(5),P_PRMDOMOLD NUMBER(5),P_PRMFEROLD NUMBER(5),
	                   P_PRMRT1OLD NUMBER(5),P_PRMRT2OLD NUMBER(5),P_PRMRT3OLD NUMBER(5),P_NUMCPF NUMBER(11)
)
 IS
