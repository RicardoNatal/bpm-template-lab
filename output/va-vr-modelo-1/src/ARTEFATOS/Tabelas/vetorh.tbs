 G␀␀

PROCEDURE SP_CRECON(P_TIPPES INTEGER,P_NUMEMP NUMBER,P_TIPCOL INTEGER,P_NUMCAD NUMBER,P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMMAT VARCHAR2(15),P_PROPAC VARCHAR2(20),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7))
 IS

l_cracha       NUMBER(12);
  l_cracha_pro   NUMBER(12);
  l_comando_nulo BOOLEAN;
  l_fxX          CHAR(8);
  l_crefxX       NUMBER(2);
  l_qtdCrX       NUMBER(2);
  l_creac1       NUMBER(2);
  l_fx1          CHAR(8);
  l_faixa1       CHAR(8);
  l_crefx1       CHAR(2);
  l_qtdcr1       NUMBER(2);
  l_qtd1         NUMBER(2);
  l_creac2       NUMBER(2);
  l_fx2          CHAR(8);
  l_faixa2       CHAR(8);
  l_crefx2       CHAR(2);
  l_qtdcr2       NUMBER(2);
  l_qtd2         NUMBER(2);
  l_creac3       NUMBER(2);
  l_fx3          CHAR(8);
  l_faixa3       CHAR(8);
  l_crefx3       CHAR(2);
  l_qtdcr3       NUMBER(2);
  l_qtd3         NUMBER(2);
  l_creac4       NUMBER(2);
  l_fx4          CHAR(8);
  l_faixa4       CHAR(8);
  l_crefx4       CHAR(2);
  l_qtdcr4       NUMBER(2);
  l_qtd4         NUMBER(2);
  l_creac5       NUMBER(2);
  l_fx5          CHAR(8);
  l_faixa5       CHAR(8);
  l_crefx5       CHAR(2);
  l_qtdcr5       NUMBER(2);
  l_qtd5         NUMBER(2);
  l_creac6       NUMBER(2);
  l_fx6          CHAR(8);
  l_faixa6       CHAR(8);
  l_crefx6       CHAR(2);
  l_qtdcr6       NUMBER(2);
  l_qtd6         NUMBER(2);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_count        NUMBER(1);
  l_atuqtd       BOOLEAN;
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_tipdoc       CHAR(1);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_updatecredit BOOLEAN;
  l_crefx1_nmb   NUMBER;
  l_crefx2_nmb   NUMBER;
  l_crefx3_nmb   NUMBER;
  l_crefx4_nmb   NUMBER;
  l_crefx5_nmb   NUMBER;
  l_crefx6_nmb   NUMBER;
BEGIN
  /*Inicializações*/
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  l_cracha     := 0;

  /*MONTA O IDTPES DE ACORDO COM A PESSOA*/

  /*Colaborador*/
  IF (p_tippes < 4) THEN
      SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
  /*Visitante.*/
  ELSIF (p_tippes = 4) THEN
      l_tippes:= '04';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  /*Outras Unidades*/
  ELSIF (p_tippes = 5) THEN
      l_tippes:= '05';
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes||l_numemp||l_numcad;
  /*Aluno*/
  ELSIF (p_tippes = 6) THEN
      l_idtpes:= '10'||p_nummat;
   /*Responsavel do Aluno */
  ELSIF (p_tippes = 7) THEN
      l_tippes:= '07';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  /*Pacientes*/
  ELSIF (p_tippes = 9) THEN
      l_idtpes := '09'||p_propac;
  /*Acompanhante de Paciente*/
  ELSIF (p_tippes = 11) THEN
      l_tippes:= '11';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  ELSE
      RAISERROR 103 'SP_CRECON: Tipo de pessoa inválida para operação.';    
  END IF;

  /*Preenche o campo com espaços para completar 23 posições*/
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
     /*Controle do Loop.*/
     IF (Length(l_idtpes) > 22) THEN
         EXIT;
     END IF;
     l_idtpes := ' '||l_idtpes;
  END LOOP;

  /*Obtem o Crachá do Colaborador*/
  IF (p_tippes < 4) THEN
      SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
      IF   (l_cracha = 0)  THEN
          SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
      END IF;
  /*Obtem o Crachá do Visitante.*/
  ELSIF (p_tippes = 4) THEN
      BEGIN
        SELECT NUMCRA INTO l_cracha
          FROM R090HCH
         WHERE R090HCH.TIPDOC = p_tipdoc AND
               R090HCH.NUMDOC = p_numdoc AND
               (R090HCH.DATINI < l_data_atual OR
                (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
               (R090HCH.DATFIM = l_data_zero OR
                R090HCH.DATFIM > l_data_atual OR
                (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
      EXCEPTION
        WHEN TOO_MANY_ROWS THEN
          RAISERROR 103 'SP_CRECON: Erro em R090VIS - TOO MANY ROWS';
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'SP_CRECON: ON-Line: Erro no SELECT R090HCH em R090VIS.';
      END;
  /*Obtem o Crachá de Outras Unidades*/
  ELSIF (p_tippes = 5) THEN
      SP_RetCra (1, p_numemp, 5, p_numcad, 0,'',0,'',l_cracha OUT);
      IF   l_cracha = 0 THEN
           SP_RetCra (2, p_numemp, 5, p_numcad, 0,'',0,'',l_cracha OUT);
      END IF;
  /*Obtem o Crachá do Aluno*/
  ELSIF (p_tippes = 6) THEN
      SP_RETCRA (1,0,6,0, 0,p_nummat,0,'', l_cracha OUT);
      IF  (l_cracha = 0)  THEN
          SP_RETCRA (2,0,6,0,0,p_nummat,0,'', l_cracha OUT);
      END IF;
   /*Obtem o Crachá do Responsavel do Aluno */ 
  ELSIF (p_tippes = 7) THEN
      SP_RetCra (1, 0, 7, 0, 0,'',p_tipdoc,p_numdoc,l_cracha OUT);
      IF   l_cracha = 0 THEN
        SP_RetCra (2, 0, 7, 0, 0,'',p_tipdoc,p_numdoc,l_cracha OUT);
      END IF;
  /*Obtem o crachá de pacientes*/
  ELSIF (p_tippes = 9) THEN
      BEGIN
          SELECT NUMCRA INTO l_cracha
          FROM R097INT
          WHERE PROPAC = p_propac
          AND ((DATFIM > l_data_atual) OR
               ((DATFIM = l_data_atual) AND (HORFIM >= l_hora_atual)) OR
               (DATFIM = l_data_zero));
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
      END;
  /*Obtem o crachá do acompanhante do paciente*/
  ELSIF (p_tippes = 11) THEN
      BEGIN
          SELECT NUMCRA INTO l_cracha
          FROM R097AIN
          WHERE TIPDOC = p_tipdoc
          AND NUMDOC = p_numdoc
          AND ((DATFAC > l_data_atual) OR
               ((DATFAC = l_data_atual) AND (HORFAC >= l_hora_atual)) OR
               (DATFAC = l_data_zero));
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
      END;
  END IF;

  /*SEM LOCAL FÍSICO*/
  IF (p_codplf = 0) THEN
      /* Verifica se encontrou o crachá para pessoa */
      IF   l_cracha <> 0  THEN
           l_updatecredit := TRUE;
           /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
           SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
           IF (l_crapri = 0) THEN
               l_crapri := l_cracha;
           END IF;

           /*Verifica se o Crachá está na R070CON*/
           l_comando_nulo := FALSE;
           BEGIN
               SELECT CREAC1, CREFX1, QTDCR1, CREAC2, CREFX2, QTDCR2, CREAC3, CREFX3, QTDCR3, CREAC4, CREFX4, QTDCR4, CREAC5, CREFX5, QTDCR5, CREAC6, CREFX6, QTDCR6
               INTO l_creac1,l_faixa1,l_qtdcr1,l_creac2,l_faixa2,l_qtdcr2,l_creac3,l_faixa3,l_qtdcr3,l_creac4,l_faixa4,l_qtdcr4,l_creac5,l_faixa5,l_qtdcr5,l_creac6,l_faixa6,l_qtdcr6
               FROM R070CON WHERE NUMFIS = l_crapri;
           EXCEPTION
               WHEN NO_DATA_FOUND THEN l_comando_nulo := TRUE;
               WHEN OTHERS THEN RAISERROR 103 'SP_CRECON: ON-Line: Erro No SELECT R070CON 3.';
           END;

           /*Se encontrou o crachá na R070CON*/
           IF  (l_comando_nulo = FALSE) THEN

               /*Obtem as Informações Referentes ao Crédito de Acesso*/
               IF (p_tippes < 4) THEN
                   SP_RETCRC (p_numemp, p_tipcol, p_numcad, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 4) THEN
                   SP_RETCRV (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 5) THEN
                   SP_RETCRO (p_numemp, p_numcad, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 6) THEN
                   SP_RETCAA (p_nummat, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 7) THEN
                   SP_RETCRR(p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 9) THEN
                   SP_RETCRP (p_propac, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 11) THEN
                   SP_RETCAP (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               END IF;

               l_count := 1;
               /*Consistência para adquirir a QtdCrX da Pessoa*/
               /*O Looping irá comparar os créditos obtidos pela procedure que retorna os créditos de
                 Acesso da Pessoa com a Informação Gravada na R070CON. Se tiver alteração da quantidade
                 de créditos então atualiza o campo qtdCrX.*/
               LOOP
                   IF (l_count = 1) THEN
                       l_fxX := l_fx1;
                       l_crefxX := l_crefx1;
                   ELSIF (l_count = 2) THEN
                       l_fxX := l_fx2;
                       l_crefxX := l_crefx2;
                   ELSIF (l_count = 3) THEN
                       l_fxX := l_fx3;
                       l_crefxX := l_crefx3;
                   ELSIF (l_count = 4) THEN
                       l_fxX := l_fx4;
                       l_crefxX := l_crefx4;
                   ELSIF (l_count = 5) THEN
                       l_fxX := l_fx5;
                       l_crefxX := l_crefx5;
                   ELSIF (l_count = 6) THEN
                       l_fxX := l_fx6;
                       l_crefxX := l_crefx6;
                   ELSE
                       /*Controle do Loop*/
                       EXIT;
                   END IF;

                   l_atuqtd := TRUE;
                   /*Verifica se a Faixa (1..6) foi alterada, para efetuar o update na r070con
                     apenas da faixa alterada*/
                   IF ((l_fxX = l_faixa1) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = CONVERT(NUMBER_TO_CHAR, l_creac1)) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr1;
                       END IF;
                   ELSIF ((l_fxX = l_faixa2) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = CONVERT(NUMBER_TO_CHAR, l_creac2)) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr2;
                       END IF;
                   ELSIF ((l_fxX = l_faixa3) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = CONVERT(NUMBER_TO_CHAR, l_creac3)) THEN
                          l_atuqtd := FALSE;
                          l_qtdCrX := l_qtdcr3;
                       END IF;
                   ELSIF ((l_fxX = l_faixa4) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = CONVERT(NUMBER_TO_CHAR, l_creac4)) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr4;
                       END IF;
                   ELSIF ((l_fxX = l_faixa5) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = CONVERT(NUMBER_TO_CHAR, l_creac5)) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr5;
                       END IF;
                   ELSIF ((l_fxX = l_faixa6) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = CONVERT(NUMBER_TO_CHAR, l_creac6)) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr6;
                       END IF;
                   END IF;

                   IF (l_count = 1) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd1 := l_qtdCrX;
                       ELSE
                           l_qtd1 := l_crefx1;
                       END IF;
                   ELSIF (l_count = 2) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd2 := l_qtdCrX;
                       ELSE
                           l_qtd2 := l_crefx2;
                       END IF;
                   ELSIF (l_count = 3) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd3 := l_qtdCrX;
                       ELSE
                           l_qtd3 := l_crefx3;
                       END IF;
                   ELSIF (l_count = 4) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd4 := l_qtdCrX;
                       ELSE
                           l_qtd4 := l_crefx4;
                       END IF;
                   ELSIF (l_count = 5) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd5 := l_qtdCrX;
                       ELSE
                           l_qtd5 := l_crefx5;
                       END IF;
                   ELSIF (l_count = 6) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd6 := l_qtdCrX;
                       ELSE
                           l_qtd6 := l_crefx6;
                       END IF;
                   END IF;

                   l_count := l_count + 1;
               END LOOP;

               /*VALIDA SE HÁ A NECESSIDADE DE GERAR PENDÊNCIA UPDATECreditAcess - 6*/
               /*CASO HOUVE ALTERAÇÃO, ENTÃO NÃO GERA PENDÊNCIA, POIS, A R070CON_EU VAI GERAR*/
               IF ( (CONVERT(NUMBER_TO_CHAR, l_creac1) <> l_crefx1) OR (l_faixa1 <> l_fx1) OR (l_qtdcr1 <> l_qtd1) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (CONVERT(NUMBER_TO_CHAR, l_creac2) <> l_crefx2) OR (l_faixa2 <> l_fx2) OR (l_qtdcr2 <> l_qtd2) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (CONVERT(NUMBER_TO_CHAR, l_creac3) <> l_crefx3) OR (l_faixa3 <> l_fx3) OR (l_qtdcr3 <> l_qtd3) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (CONVERT(NUMBER_TO_CHAR, l_creac4) <> l_crefx4) OR (l_faixa4 <> l_fx4) OR (l_qtdcr4 <> l_qtd4) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (CONVERT(NUMBER_TO_CHAR, l_creac5) <> l_crefx5) OR (l_faixa5 <> l_fx5) OR (l_qtdcr5 <> l_qtd5) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (CONVERT(NUMBER_TO_CHAR, l_creac6) <> l_crefx6) OR (l_faixa6 <> l_fx6) OR (l_qtdcr6 <> l_qtd6) ) THEN
                   l_updatecredit := FALSE;
               END IF;

               SP_STRTOINT(l_crefx1 , l_crefx1_nmb OUT);
               SP_STRTOINT(l_crefx2 , l_crefx2_nmb OUT);
               SP_STRTOINT(l_crefx3 , l_crefx3_nmb OUT);
               SP_STRTOINT(l_crefx4 , l_crefx4_nmb OUT);
               SP_STRTOINT(l_crefx5 , l_crefx5_nmb OUT);
               SP_STRTOINT(l_crefx6 , l_crefx6_nmb OUT);

               LOOP
                 /* atualiza r070con */
                 BEGIN
                      UPDATE R070CON SET
                             CREAC1=l_crefx1_nmb, CREFX1=l_fx1, QTDCR1=l_qtd1,
                             CREAC2=l_crefx2_nmb, CREFX2=l_fx2, QTDCR2=l_qtd2,
                             CREAC3=l_crefx3_nmb, CREFX3=l_fx3, QTDCR3=l_qtd3,
                             CREAC4=l_crefx4_nmb, CREFX4=l_fx4, QTDCR4=l_qtd4,
                             CREAC5=l_crefx5_nmb, CREFX5=l_fx5, QTDCR5=l_qtd5,
                             CREAC6=l_crefx6_nmb, CREFX6=l_fx6, QTDCR6=l_qtd6
                       WHERE NUMFIS = l_crapri;
                 EXCEPTION
                      WHEN OTHERS THEN NULL;
                 END;
                 /*Controle do Looping, onde deve ser efetuado o update no crachá provisório caso o mesmo exista.*/
                 SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                 IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) OR (p_tippes >= 4) THEN
                   EXIT;
                 ELSE
                    l_cracha := l_cracha_pro;
                    /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
                    SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                    IF (l_crapri = 0) THEN
                        l_crapri := l_cracha;
                    END IF;
                 END IF;
               END LOOP;

               /*SE NÃO ATUALIZOU NADA NA R070CON, DEVE GERAR PENDÊNCIA UPDATECREDITACESS, PARA QUE AS CONCENTRADORAS FIQUEM ATUALIZADAS*/
               IF (l_updatecredit = TRUE) THEN
                   /*ESTA PENDÊNCIA VAI ATUALIZA OS CRÉDITOS DA PESSOA NAS CONCENTRADORAS*/
                   SP_PEND06(1, l_idtpes, p_verplf, p_codplf);
               END IF;
           END IF;
      END IF;


  ELSE /* POR LOCAL FÍSICO */
      /*Gera pendência para a CSM Center, informando os créditos de acesso, SOMENTE SE EXISTIR CRACHÁ ASSOCIADO A PESSOA*/
      IF (l_cracha <> 0) THEN
          SP_PEND06(1, l_idtpes, p_verplf, p_codplf);
      END IF;
  END IF;
END		SENIOR;20²SP_USUTEL
SP_INTSTR
SP_RETCRA
SP_MAPFIS
SP_RETCRC
SP_RETCRV
SP_RETCRO
SP_RETCAA
SP_RETCRR
SP_RETCRP
SP_RETCAP
SP_PEND06
SP_ATUTSI
SP_DATSTR
SP_CMDTSI
SP_RETICARD
	o␀␀PROCEDURE SP_CRECON(P_TIPPES INTEGER,P_NUMEMP NUMBER,P_TIPCOL INTEGER,P_NUMCAD NUMBER,P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMMAT VARCHAR2(15),P_PROPAC VARCHAR2(20),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7))
 IS

  l_cracha       NUMBER(12);
  l_cracha_pro   NUMBER(12);
  l_comando_nulo BOOLEAN;
  l_fxX          CHAR(8);
  l_crefxX       CHAR(2);
  l_qtdCrX       NUMBER(2);
  l_creac1       NUMBER(2);
  l_fx1          CHAR(8);
  l_faixa1       CHAR(8);
  l_crefx1       CHAR(2);
  l_qtdcr1       NUMBER(2);
  l_qtd1         NUMBER(2);
  l_creac2       NUMBER(2);
  l_fx2          CHAR(8);
  l_faixa2       CHAR(8);
  l_crefx2       CHAR(2);
  l_qtdcr2       NUMBER(2);
  l_qtd2         NUMBER(2);
  l_creac3       NUMBER(2);
  l_fx3          CHAR(8);
  l_faixa3       CHAR(8);
  l_crefx3       CHAR(2);
  l_qtdcr3       NUMBER(2);
  l_qtd3         NUMBER(2);
  l_creac4       NUMBER(2);
  l_fx4          CHAR(8);
  l_faixa4       CHAR(8);
  l_crefx4       CHAR(2);
  l_qtdcr4       NUMBER(2);
  l_qtd4         NUMBER(2);
  l_creac5       NUMBER(2);
  l_fx5          CHAR(8);
  l_faixa5       CHAR(8);
  l_crefx5       CHAR(2);
  l_qtdcr5       NUMBER(2);
  l_qtd5         NUMBER(2);
  l_creac6       NUMBER(2);
  l_fx6          CHAR(8);
  l_faixa6       CHAR(8);
  l_crefx6       CHAR(2);
  l_qtdcr6       NUMBER(2);
  l_qtd6         NUMBER(2);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_count        NUMBER(1);
  l_atuqtd       BOOLEAN;
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_tipdoc       CHAR(1);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);

  l_craupd_con   VARCHAR2(96); /*RECEBE OS CRACHÁS QUE SOFRERAM ATUALIZAÇÃO NA CONTROLE*/
  l_ultpasref    CHAR(10);
  l_craauxstr    CHAR(12);
  l_datcon       DATE;
  l_horcon       NUMBER(5);
  l_horstr       CHAR(4);
  l_datstr       CHAR(6);
  l_comando      VARCHAR2(256);
  l_usutel       VARCHAR(31);
  l_updatecredit BOOLEAN;
  l_numser       VARCHAR(12);
  l_icardR       VARCHAR(12);
BEGIN
  /*Inicializações*/
  /*Usuário da telemática*/
  SP_USUTEL(l_usutel OUT);
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  l_cracha     := 0;
  l_craupd_con := ' ';

  /*MONTA O IDTPES DE ACORDO COM A PESSOA*/

  /*Colaborador*/
  IF (p_tippes < 4) THEN
      SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
  /*Visitante.*/
  ELSIF (p_tippes = 4) THEN
      l_tippes:= '04';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  /*Outras Unidades*/
  ELSIF (p_tippes = 5) THEN
      l_tippes:= '05';
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes||l_numemp||l_numcad;
  /*Aluno*/
  ELSIF (p_tippes = 6) THEN
      l_idtpes:= '10'||p_nummat;
   /*Responsavel do Aluno */
  ELSIF (p_tippes = 7) THEN
      l_tippes:= '07';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  /*Pacientes*/
  ELSIF (p_tippes = 9) THEN
      l_idtpes := '09'||p_propac;
  /*Acompanhante de Paciente*/
  ELSIF (p_tippes = 11) THEN
      l_tippes:= '11';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  ELSE
      RAISERROR 103 'SP_CRECON: Tipo de pessoa inválida para operação.';
  END IF;

  /*Preenche o campo com espaços para completar 23 posições*/
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
     /*Controle do Loop.*/
     IF (Length(l_idtpes) > 22) THEN
         EXIT;
     END IF;
     l_idtpes := ' '||l_idtpes;
  END LOOP;

  /*Obtem o Crachá do Colaborador*/
  IF (p_tippes < 4) THEN
      SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
      IF   (l_cracha = 0)  THEN
          SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
      END IF;
  /*Obtem o Crachá do Visitante.*/
  ELSIF (p_tippes = 4) THEN
      BEGIN
        SELECT NUMCRA INTO l_cracha
          FROM R090HCH
         WHERE R090HCH.TIPDOC = p_tipdoc AND
               R090HCH.NUMDOC = p_numdoc AND
               (R090HCH.DATINI < l_data_atual OR
                (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
               (R090HCH.DATFIM = l_data_zero OR
                R090HCH.DATFIM > l_data_atual OR
                (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
      EXCEPTION
        WHEN TOO_MANY_ROWS THEN
          RAISERROR 103 'SP_CRECON: Erro em R090VIS - TOO MANY ROWS';
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'SP_CRECON: ON-Line: Erro no SELECT R090HCH em R090VIS.';
      END;
  /*Obtem o Crachá de Outras Unidades*/
  ELSIF (p_tippes = 5) THEN
      SP_RetCra (1, p_numemp, 5, p_numcad, 0,'',0,'',l_cracha OUT);
      IF   l_cracha = 0 THEN
           SP_RetCra (2, p_numemp, 5, p_numcad, 0,'',0,'',l_cracha OUT);
      END IF;
  /*Obtem o Crachá do Aluno*/
  ELSIF (p_tippes = 6) THEN
      SP_RETCRA (1,0,6,0, 0,p_nummat,0,'', l_cracha OUT);
      IF  (l_cracha = 0)  THEN
          SP_RETCRA (2,0,6,0,0,p_nummat,0,'', l_cracha OUT);
      END IF;
   /*Obtem o Crachá do Responsavel do Aluno */
  ELSIF (p_tippes = 7) THEN
      SP_RetCra (1, 0, 7, 0, 0,'',p_tipdoc,p_numdoc,l_cracha OUT);
      IF   l_cracha = 0 THEN
        SP_RetCra (2, 0, 7, 0, 0,'',p_tipdoc,p_numdoc,l_cracha OUT);
      END IF;
  /*Obtem o crachá de pacientes*/
  ELSIF (p_tippes = 9) THEN
      BEGIN
          SELECT NUMCRA INTO l_cracha
          FROM R097INT
          WHERE PROPAC = p_propac
          AND ((DATFIM > l_data_atual) OR
               ((DATFIM = l_data_atual) AND (HORFIM >= l_hora_atual)) OR
               (DATFIM = l_data_zero));
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
      END;
  /*Obtem o crachá do acompanhante do paciente*/
  ELSIF (p_tippes = 11) THEN
      BEGIN
          SELECT NUMCRA INTO l_cracha
          FROM R097AIN
          WHERE R097AIN.TIPDOC = p_tipdoc
          AND R097AIN.NUMDOC = p_numdoc
          AND ((DATFAC > l_data_atual) OR
               ((DATFAC = l_data_atual) AND (HORFAC >= l_hora_atual)) OR
               (DATFAC = l_data_zero));
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
      END;
  END IF;

  /*SEM LOCAL FÍSICO*/
  IF (p_codplf = 0) THEN
      /* Verifica se encontrou o crachá para pessoa */
      IF   l_cracha <> 0  THEN
           l_updatecredit := TRUE;
           /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
           SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
           IF (l_crapri = 0) THEN
               l_crapri := l_cracha;
           END IF;

           /*Verifica se o Crachá está na R070CON*/
           l_comando_nulo := FALSE;
           BEGIN
               SELECT CREAC1, CREFX1, QTDCR1, CREAC2, CREFX2, QTDCR2, CREAC3, CREFX3, QTDCR3, CREAC4, CREFX4, QTDCR4, CREAC5, CREFX5, QTDCR5, CREAC6, CREFX6, QTDCR6
               INTO l_creac1,l_faixa1,l_qtdcr1,l_creac2,l_faixa2,l_qtdcr2,l_creac3,l_faixa3,l_qtdcr3,l_creac4,l_faixa4,l_qtdcr4,l_creac5,l_faixa5,l_qtdcr5,l_creac6,l_faixa6,l_qtdcr6
               FROM R070CON WHERE NUMFIS = l_crapri;
           EXCEPTION
               WHEN NO_DATA_FOUND THEN l_comando_nulo := TRUE;
               WHEN OTHERS THEN RAISERROR 103 'SP_CRECON: ON-Line: Erro No SELECT R070CON 3.';
           END;

           /*Se encontrou o crachá na R070CON*/
           IF  (l_comando_nulo = FALSE) THEN

               /*Obtem as Informações Referentes ao Crédito de Acesso*/
               IF (p_tippes < 4) THEN
                   SP_RETCRC (p_numemp, p_tipcol, p_numcad, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 4) THEN
                   SP_RETCRV (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 5) THEN
                   SP_RETCRO (p_numemp, p_numcad, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 6) THEN
                   SP_RETCAA (p_nummat, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 7) THEN
                   SP_RETCRR(p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 9) THEN
                   SP_RETCRP (p_propac, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 11) THEN
                   SP_RETCAP (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               END IF;

               l_count := 1;
               /*Consistência para adquirir a QtdCrX da Pessoa*/
               /*O Looping irá comparar os créditos obtidos pela procedure que retorna os créditos de
                 Acesso da Pessoa com a Informação Gravada na R070CON. Se tiver alteração da quantidade
                 de créditos então atualiza o campo qtdCrX.*/
               LOOP
                   IF (l_count = 1) THEN
                       l_fxX := l_fx1;
                       l_crefxX := l_crefx1;
                   ELSIF (l_count = 2) THEN
                       l_fxX := l_fx2;
                       l_crefxX := l_crefx2;
                   ELSIF (l_count = 3) THEN
                       l_fxX := l_fx3;
                       l_crefxX := l_crefx3;
                   ELSIF (l_count = 4) THEN
                       l_fxX := l_fx4;
                       l_crefxX := l_crefx4;
                   ELSIF (l_count = 5) THEN
                       l_fxX := l_fx5;
                       l_crefxX := l_crefx5;
                   ELSIF (l_count = 6) THEN
                       l_fxX := l_fx6;
                       l_crefxX := l_crefx6;
                   ELSE
                       /*Controle do Loop*/
                       EXIT;
                   END IF;

                   l_atuqtd := TRUE;
                   /*Verifica se a Faixa (1..6) foi alterada, para efetuar o update na r070con
                     apenas da faixa alterada*/
                   IF ((l_fxX = l_faixa1) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac1) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr1;
                       END IF;
                   ELSIF ((l_fxX = l_faixa2) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac2) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr2;
                       END IF;
                   ELSIF ((l_fxX = l_faixa3) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac3) THEN
                          l_atuqtd := FALSE;
                          l_qtdCrX := l_qtdcr3;
                       END IF;
                   ELSIF ((l_fxX = l_faixa4) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac4) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr4;
                       END IF;
                   ELSIF ((l_fxX = l_faixa5) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac5) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr5;
                       END IF;
                   ELSIF ((l_fxX = l_faixa6) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac6) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr6;
                       END IF;
                   END IF;

                   IF (l_count = 1) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd1 := l_qtdCrX;
                       ELSE
                           l_qtd1 := l_crefx1;
                       END IF;
                   ELSIF (l_count = 2) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd2 := l_qtdCrX;
                       ELSE
                           l_qtd2 := l_crefx2;
                       END IF;
                   ELSIF (l_count = 3) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd3 := l_qtdCrX;
                       ELSE
                           l_qtd3 := l_crefx3;
                       END IF;
                   ELSIF (l_count = 4) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd4 := l_qtdCrX;
                       ELSE
                           l_qtd4 := l_crefx4;
                       END IF;
                   ELSIF (l_count = 5) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd5 := l_qtdCrX;
                       ELSE
                           l_qtd5 := l_crefx5;
                       END IF;
                   ELSIF (l_count = 6) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd6 := l_qtdCrX;
                       ELSE
                           l_qtd6 := l_crefx6;
                       END IF;
                   END IF;

                   l_count := l_count + 1;
               END LOOP;

               /*VALIDA SE HÁ A NECESSIDADE DE GERAR PENDÊNCIA UPDATECreditAcess - 6*/
               /*CASO HOUVE ALTERAÇÃO, ENTÃO NÃO GERA PENDÊNCIA, POIS, A R070CON_EU VAI GERAR*/
               IF ( (l_creac1 <> l_crefx1) OR (l_faixa1 <> l_fx1) OR (l_qtdcr1 <> l_qtd1) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac2 <> l_crefx2) OR (l_faixa2 <> l_fx2) OR (l_qtdcr2 <> l_qtd2) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac3 <> l_crefx3) OR (l_faixa3 <> l_fx3) OR (l_qtdcr3 <> l_qtd3) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac4 <> l_crefx4) OR (l_faixa4 <> l_fx4) OR (l_qtdcr4 <> l_qtd4) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac5 <> l_crefx5) OR (l_faixa5 <> l_fx5) OR (l_qtdcr5 <> l_qtd5) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac6 <> l_crefx6) OR (l_faixa6 <> l_fx6) OR (l_qtdcr6 <> l_qtd6) ) THEN
                   l_updatecredit := FALSE;
               END IF;

               LOOP
                 /* atualiza r070con */
                 BEGIN
                      UPDATE R070CON SET
                             CREAC1=l_crefx1, CREFX1=l_fx1, QTDCR1=l_qtd1,
                             CREAC2=l_crefx2, CREFX2=l_fx2, QTDCR2=l_qtd2,
                             CREAC3=l_crefx3, CREFX3=l_fx3, QTDCR3=l_qtd3,
                             CREAC4=l_crefx4, CREFX4=l_fx4, QTDCR4=l_qtd4,
                             CREAC5=l_crefx5, CREFX5=l_fx5, QTDCR5=l_qtd5,
                             CREAC6=l_crefx6, CREFX6=l_fx6, QTDCR6=l_qtd6
                       WHERE NUMFIS = l_crapri;
                 EXCEPTION
                      WHEN OTHERS THEN NULL;
                 END;

                 /*Guarda os crachás para atualizar a última passagem no refeitório, somente para definição 3*/
                 BEGIN
                     IF (l_crapri <> l_cracha) AND (l_tecpri < 3) THEN

                         IF (l_numpro > 0) THEN
                             SP_INTSTR(l_numpro, '999999999999', l_craauxstr OUT);
                             IF (l_craupd_con <> ' ') THEN
                                 l_craupd_con := l_craupd_con || ',' ||''''||l_craauxstr||'''';
                             ELSE
                                 l_craupd_con := ''''||l_craauxstr||'''';
                             END IF;
                         END IF;

                         IF (l_numbar > 0) THEN
                             SP_INTSTR(l_numbar, '999999999999', l_craauxstr OUT);
                             IF (l_craupd_con <> ' ') THEN
                                 l_craupd_con := l_craupd_con || ',' ||''''||l_craauxstr||'''';
                             ELSE
                                 l_craupd_con := ''''||l_craauxstr||'''';
                             END IF;
                         END IF;

                     ELSE
                         SP_RETICARD(l_idtpes, l_cracha, l_craauxstr OUT , l_icardR OUT, l_numser OUT);

                         IF (l_craupd_con <> ' ') THEN
                             l_craupd_con := l_craupd_con || ',' ||''''||l_craauxstr||'''';
                         ELSE
                             l_craupd_con := ''''||l_craauxstr||'''';
                         END IF;
                     END IF;

                 EXCEPTION
                     WHEN OTHERS THEN
                         l_craupd_con := ' ';
                 END;

                 /*Controle do Looping, onde deve ser efetuado o update no crachá provisório caso o mesmo exista.*/
                 SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                 IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) OR (p_tippes >= 4) THEN
                   EXIT;
                 ELSE
                    l_cracha := l_cracha_pro;
                    /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
                    SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                    IF (l_crapri = 0) THEN
                        l_crapri := l_cracha;
                    END IF;
                 END IF;

               END LOOP;

               /*SE NÃO ATUALIZOU NADA NA R070CON, DEVE GERAR PENDÊNCIA UPDATECREDITACESS, PARA QUE AS CONCENTRADORAS FIQUEM ATUALIZADAS*/
               IF (l_updatecredit = TRUE) THEN
                   /*ESTA PENDÊNCIA VAI ATUALIZA OS CRÉDITOS DA PESSOA NAS CONCENTRADORAS*/
                   SP_PEND06(1, l_idtpes, p_verplf, p_codplf);
               END IF;
               SP_ATUTSI(l_idtpes, l_crapri, TRUE, FALSE, FALSE, FALSE);

               /*Verifica se deve alterar a última data de passagem em dispositivo refeitório para Telemática*/
               IF (l_craupd_con <> ' ') THEN
                   /*Colaborador*/
                  IF (p_tippes < 4) THEN
                      BEGIN
                          SELECT MAX(DATCON)
                               , MAX(HORCON)
                            INTO l_datcon,l_horcon
                            FROM R070CRC
                           WHERE CODPLF = p_codplf
                             AND VERPLF = p_verplf
                             AND NUMEMP = p_numemp
                             AND TIPCOL = p_tipcol
                             AND NUMCAD = p_numcad
                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
                             AND DATCON = (SELECT MAX(DATCON) FROM R070CRC WHERE CODPLF = p_codplf
                                 AND VERPLF = p_verplf
                                 AND NUMEMP = p_numemp
                                 AND TIPCOL = p_tipcol
                                 AND NUMCAD = p_numcad
                                 AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                      EXCEPTION
                          WHEN OTHERS THEN
                              l_datcon := l_data_zero;
                              l_horcon := 0;
                      END;
                  /*Visitante.*/
                  ELSIF (p_tippes = 4) THEN
                      BEGIN
                          SELECT MAX(DATCON)
                               , MAX(HORCON)
                            INTO l_datcon,l_horcon
                            FROM R070CRV
                           WHERE CODPLF = p_codplf
                             AND VERPLF = p_verplf
                             AND TIPDOC = p_tipdoc
                             AND NUMDOC = p_numdoc
                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
                             AND DATCON = (SELECT MAX(DATCON) FROM R070CRV WHERE CODPLF = p_codplf
                                 AND VERPLF = p_verplf
                                 AND TIPDOC = p_tipdoc
                                 AND NUMDOC = p_numdoc
                                 AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                      EXCEPTION
                          WHEN OTHERS THEN
                              l_datcon := l_data_zero;
                              l_horcon := 0;
                      END;
                  /*Outras Unidades*/
                  ELSIF (p_tippes = 5) THEN
                      BEGIN
                          SELECT MAX(DATCON)
                               , MAX(HORCON)
                            INTO l_datcon,l_horcon
                            FROM R070CRO
                           WHERE CODPLF = p_codplf
                             AND VERPLF = p_verplf
                             AND NUMEMP = p_numemp
                             AND NUMCAD = p_numcad
                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
                             AND DATCON = (SELECT MAX(DATCON) FROM R070CRO WHERE CODPLF = p_codplf
	                             AND VERPLF = p_verplf
	                             AND NUMEMP = p_numemp
	                             AND NUMCAD = p_numcad
	                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                      EXCEPTION
                          WHEN OTHERS THEN
                              l_datcon := l_data_zero;
                              l_horcon := 0;
                      END;
                  /*Aluno*/
                  ELSIF (p_tippes = 6) THEN
                      BEGIN
                          SELECT MAX(DATCON)
                               , MAX(HORCON)
                            INTO l_datcon,l_horcon
                            FROM R070CRA
                           WHERE CODPLF = p_codplf
                             AND VERPLF = p_verplf
                             AND NUMMAT = p_nummat
                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
	                             AND DATCON = (SELECT MAX(DATCON) FROM R070CRA WHERE CODPLF = p_codplf
	                             AND VERPLF = p_verplf
	                             AND NUMMAT = p_nummat
	                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                      EXCEPTION
                          WHEN OTHERS THEN
                              l_datcon := l_data_zero;
                              l_horcon := 0;
                      END;
                   /*Responsavel do Aluno */
                  ELSIF (p_tippes = 7) THEN
                      BEGIN
                          SELECT MAX(DATCON)
                               , MAX(HORCON)
                            INTO l_datcon,l_horcon
                            FROM R070CRR
                           WHERE CODPLF = p_codplf
                             AND VERPLF = p_verplf
                             AND TIPDOC = p_tipdoc
                             AND NUMDOC = p_numdoc
                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
                             AND DATCON = (SELECT MAX(DATCON) FROM R070CRR WHERE CODPLF = p_codplf
	                             AND VERPLF = p_verplf
	                             AND TIPDOC = p_tipdoc
	                             AND NUMDOC = p_numdoc
	                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                      EXCEPTION
                          WHEN OTHERS THEN
                              l_datcon := l_data_zero;
                              l_horcon := 0;
                      END;
                  /*Pacientes*/
                  ELSIF (p_tippes = 9) THEN
                      BEGIN
                          SELECT MAX(DATCON)
                               , MAX(HORCON)
                            INTO l_datcon,l_horcon
                            FROM R070CRP
                           WHERE CODPLF = p_codplf
                             AND VERPLF = p_verplf
                             AND PROPAC = p_propac
                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
                             AND DATCON = (SELECT MAX(DATCON) FROM R070CRP WHERE CODPLF = p_codplf
	                             AND VERPLF = p_verplf
	                             AND PROPAC = p_propac
	                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                      EXCEPTION
                          WHEN OTHERS THEN
                              l_datcon := l_data_zero;
                              l_horcon := 0;
                      END;
                  /*Acompanhante de Paciente*/
                  ELSIF (p_tippes = 11) THEN
                      BEGIN
                          SELECT MAX(DATCON)
                               , MAX(HORCON)
                            INTO l_datcon,l_horcon
                            FROM R070CAP
                           WHERE CODPLF = p_codplf
                             AND VERPLF = p_verplf
                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
                             AND DATCON = (SELECT MAX(DATCON) FROM R070CAP WHERE CODPLF = p_codplf
	                             AND VERPLF = p_verplf
	                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                      EXCEPTION
                          WHEN OTHERS THEN
                              l_datcon := l_data_zero;
                              l_horcon := 0;
                      END;
                  ELSE
                      l_datcon := l_data_zero;
                      l_horcon := 0;
                  END IF;

                  IF (l_datcon IS NULL) OR (l_datcon = l_data_zero) THEN
                      l_ultpasref := '          ';
                  ELSE
                      SP_INTSTR(l_horcon,'HHMM',l_horstr OUT);
                      SP_DATSTR(l_datcon,'DDMMYY',l_datstr OUT);
                      l_ultpasref := l_datstr || l_horstr;
                  END IF;

                  l_comando := 'UPDATE '||l_usutel||'CONTROLE SET ULTPAS_REF = '''||l_ultpasref||
                               ''' WHERE ICARD IN('||l_craupd_con||') AND VER_CRED = 3';
                  SP_CMDTSI(l_comando);
               END IF;

           END IF;
      END IF;


  ELSE /* POR LOCAL FÍSICO */
      /*Gera pendência para a CSM Center, informando os créditos de acesso, SOMENTE SE EXISTIR CRACHÁ ASSOCIADO A PESSOA*/
      IF (l_cracha <> 0) THEN
          SP_PEND06(1, l_idtpes, p_verplf, p_codplf);
      END IF;
  END IF;
END		SENIOR;23²SP_USUTEL
SP_INTSTR
SP_RETCRA
SP_MAPFIS
SP_RETCRC
SP_RETCRV
SP_RETCRO
SP_RETCAA
SP_RETCRR
SP_RETCRP
SP_RETCAP
SP_PEND06
SP_ATUTSI
SP_DATSTR
SP_CMDTSI
SP_RETICARD
	o␀␀PROCEDURE SP_CRECON(P_TIPPES INTEGER,P_NUMEMP NUMBER,P_TIPCOL INTEGER,P_NUMCAD NUMBER,P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMMAT VARCHAR2(15),P_PROPAC VARCHAR2(20),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7))
 IS

  l_cracha       NUMBER(12);
  l_cracha_pro   NUMBER(12);
  l_comando_nulo BOOLEAN;
  l_fxX          CHAR(8);
  l_crefxX       CHAR(2);
  l_qtdCrX       NUMBER(2);
  l_creac1       NUMBER(2);
  l_fx1          CHAR(8);
  l_faixa1       CHAR(8);
  l_crefx1       CHAR(2);
  l_qtdcr1       NUMBER(2);
  l_qtd1         NUMBER(2);
  l_creac2       NUMBER(2);
  l_fx2          CHAR(8);
  l_faixa2       CHAR(8);
  l_crefx2       CHAR(2);
  l_qtdcr2       NUMBER(2);
  l_qtd2         NUMBER(2);
  l_creac3       NUMBER(2);
  l_fx3          CHAR(8);
  l_faixa3       CHAR(8);
  l_crefx3       CHAR(2);
  l_qtdcr3       NUMBER(2);
  l_qtd3         NUMBER(2);
  l_creac4       NUMBER(2);
  l_fx4          CHAR(8);
  l_faixa4       CHAR(8);
  l_crefx4       CHAR(2);
  l_qtdcr4       NUMBER(2);
  l_qtd4         NUMBER(2);
  l_creac5       NUMBER(2);
  l_fx5          CHAR(8);
  l_faixa5       CHAR(8);
  l_crefx5       CHAR(2);
  l_qtdcr5       NUMBER(2);
  l_qtd5         NUMBER(2);
  l_creac6       NUMBER(2);
  l_fx6          CHAR(8);
  l_faixa6       CHAR(8);
  l_crefx6       CHAR(2);
  l_qtdcr6       NUMBER(2);
  l_qtd6         NUMBER(2);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_count        NUMBER(1);
  l_atuqtd       BOOLEAN;
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_tipdoc       CHAR(1);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);

  l_craupd_con   VARCHAR2(96); /*RECEBE OS CRACHÁS QUE SOFRERAM ATUALIZAÇÃO NA CONTROLE*/
  l_ultpasref    CHAR(10);
  l_craauxstr    CHAR(12);
  l_datcon       DATE;
  l_horcon       NUMBER(5);
  l_horstr       CHAR(4);
  l_datstr       CHAR(6);
  l_comando      VARCHAR2(256);
  l_usutel       VARCHAR(31);
  l_updatecredit BOOLEAN;
  l_numser       VARCHAR(12);
  l_icardR       VARCHAR(12);
BEGIN
  /*Inicializações*/
  /*Usuário da telemática*/
  SP_USUTEL(l_usutel OUT);
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  l_cracha     := 0;
  l_craupd_con := ' ';

  /*MONTA O IDTPES DE ACORDO COM A PESSOA*/

  /*Colaborador*/
  IF (p_tippes < 4) THEN
      SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
  /*Visitante.*/
  ELSIF (p_tippes = 4) THEN
      l_tippes:= '04';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  /*Outras Unidades*/
  ELSIF (p_tippes = 5) THEN
      l_tippes:= '05';
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes||l_numemp||l_numcad;
  /*Aluno*/
  ELSIF (p_tippes = 6) THEN
      l_idtpes:= '10'||p_nummat;
   /*Responsavel do Aluno */
  ELSIF (p_tippes = 7) THEN
      l_tippes:= '07';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  /*Pacientes*/
  ELSIF (p_tippes = 9) THEN
      l_idtpes := '09'||p_propac;
  /*Acompanhante de Paciente*/
  ELSIF (p_tippes = 11) THEN
      l_tippes:= '11';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  ELSE
      RAISERROR 103 'SP_CRECON: Tipo de pessoa inválida para operação.';
  END IF;

  /*Preenche o campo com espaços para completar 23 posições*/
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
     /*Controle do Loop.*/
     IF (Length(l_idtpes) > 22) THEN
         EXIT;
     END IF;
     l_idtpes := ' '||l_idtpes;
  END LOOP;

  /*Obtem o Crachá do Colaborador*/
  IF (p_tippes < 4) THEN
      SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
      IF   (l_cracha = 0)  THEN
          SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
      END IF;
  /*Obtem o Crachá do Visitante.*/
  ELSIF (p_tippes = 4) THEN
      BEGIN
        SELECT NUMCRA INTO l_cracha
          FROM R090HCH
         WHERE R090HCH.TIPDOC = p_tipdoc AND
               R090HCH.NUMDOC = p_numdoc AND
               (R090HCH.DATINI < l_data_atual OR
                (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
               (R090HCH.DATFIM = l_data_zero OR
                R090HCH.DATFIM > l_data_atual OR
                (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
      EXCEPTION
        WHEN TOO_MANY_ROWS THEN
          RAISERROR 103 'SP_CRECON: Erro em R090VIS - TOO MANY ROWS';
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'SP_CRECON: ON-Line: Erro no SELECT R090HCH em R090VIS.';
      END;
  /*Obtem o Crachá de Outras Unidades*/
  ELSIF (p_tippes = 5) THEN
      SP_RetCra (1, p_numemp, 5, p_numcad, 0,'',0,'',l_cracha OUT);
      IF   l_cracha = 0 THEN
           SP_RetCra (2, p_numemp, 5, p_numcad, 0,'',0,'',l_cracha OUT);
      END IF;
  /*Obtem o Crachá do Aluno*/
  ELSIF (p_tippes = 6) THEN
      SP_RETCRA (1,0,6,0, 0,p_nummat,0,'', l_cracha OUT);
      IF  (l_cracha = 0)  THEN
          SP_RETCRA (2,0,6,0,0,p_nummat,0,'', l_cracha OUT);
      END IF;
   /*Obtem o Crachá do Responsavel do Aluno */
  ELSIF (p_tippes = 7) THEN
      SP_RetCra (1, 0, 7, 0, 0,'',p_tipdoc,p_numdoc,l_cracha OUT);
      IF   l_cracha = 0 THEN
        SP_RetCra (2, 0, 7, 0, 0,'',p_tipdoc,p_numdoc,l_cracha OUT);
      END IF;
  /*Obtem o crachá de pacientes*/
  ELSIF (p_tippes = 9) THEN
      BEGIN
          SELECT NUMCRA INTO l_cracha
          FROM R097INT
          WHERE PROPAC = p_propac
          AND ((DATFIM > l_data_atual) OR
               ((DATFIM = l_data_atual) AND (HORFIM >= l_hora_atual)) OR
               (DATFIM = l_data_zero));
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
      END;
  /*Obtem o crachá do acompanhante do paciente*/
  ELSIF (p_tippes = 11) THEN
      BEGIN
          SELECT NUMCRA INTO l_cracha
          FROM R097AIN
          WHERE R097AIN.TIPDOC = p_tipdoc
          AND R097AIN.NUMDOC = p_numdoc
          AND ((DATFAC > l_data_atual) OR
               ((DATFAC = l_data_atual) AND (HORFAC >= l_hora_atual)) OR
               (DATFAC = l_data_zero));
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
      END;
  END IF;

  /*SEM LOCAL FÍSICO*/
  IF (p_codplf = 0) THEN
      /* Verifica se encontrou o crachá para pessoa */
      IF   l_cracha <> 0  THEN
           l_updatecredit := TRUE;
           /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
           SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
           IF (l_crapri = 0) THEN
               l_crapri := l_cracha;
           END IF;

           /*Verifica se o Crachá está na R070CON*/
           l_comando_nulo := FALSE;
           BEGIN
               SELECT CREAC1, CREFX1, QTDCR1, CREAC2, CREFX2, QTDCR2, CREAC3, CREFX3, QTDCR3, CREAC4, CREFX4, QTDCR4, CREAC5, CREFX5, QTDCR5, CREAC6, CREFX6, QTDCR6
               INTO l_creac1,l_faixa1,l_qtdcr1,l_creac2,l_faixa2,l_qtdcr2,l_creac3,l_faixa3,l_qtdcr3,l_creac4,l_faixa4,l_qtdcr4,l_creac5,l_faixa5,l_qtdcr5,l_creac6,l_faixa6,l_qtdcr6
               FROM R070CON WHERE NUMFIS = l_crapri;
           EXCEPTION
               WHEN NO_DATA_FOUND THEN l_comando_nulo := TRUE;
               WHEN OTHERS THEN RAISERROR 103 'SP_CRECON: ON-Line: Erro No SELECT R070CON 3.';
           END;

           /*Se encontrou o crachá na R070CON*/
           IF  (l_comando_nulo = FALSE) THEN

               /*Obtem as Informações Referentes ao Crédito de Acesso*/
               IF (p_tippes < 4) THEN
                   SP_RETCRC (p_numemp, p_tipcol, p_numcad, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 4) THEN
                   SP_RETCRV (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 5) THEN
                   SP_RETCRO (p_numemp, p_numcad, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 6) THEN
                   SP_RETCAA (p_nummat, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 7) THEN
                   SP_RETCRR(p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 9) THEN
                   SP_RETCRP (p_propac, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 11) THEN
                   SP_RETCAP (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               END IF;

               l_count := 1;
               /*Consistência para adquirir a QtdCrX da Pessoa*/
               /*O Looping irá comparar os créditos obtidos pela procedure que retorna os créditos de
                 Acesso da Pessoa com a Informação Gravada na R070CON. Se tiver alteração da quantidade
                 de créditos então atualiza o campo qtdCrX.*/
               LOOP
                   IF (l_count = 1) THEN
                       l_fxX := l_fx1;
                       l_crefxX := l_crefx1;
                   ELSIF (l_count = 2) THEN
                       l_fxX := l_fx2;
                       l_crefxX := l_crefx2;
                   ELSIF (l_count = 3) THEN
                       l_fxX := l_fx3;
                       l_crefxX := l_crefx3;
                   ELSIF (l_count = 4) THEN
                       l_fxX := l_fx4;
                       l_crefxX := l_crefx4;
                   ELSIF (l_count = 5) THEN
                       l_fxX := l_fx5;
                       l_crefxX := l_crefx5;
                   ELSIF (l_count = 6) THEN
                       l_fxX := l_fx6;
                       l_crefxX := l_crefx6;
                   ELSE
                       /*Controle do Loop*/
                       EXIT;
                   END IF;

                   l_atuqtd := TRUE;
                   /*Verifica se a Faixa (1..6) foi alterada, para efetuar o update na r070con
                     apenas da faixa alterada*/
                   IF ((l_fxX = l_faixa1) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac1) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr1;
                       END IF;
                   ELSIF ((l_fxX = l_faixa2) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac2) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr2;
                       END IF;
                   ELSIF ((l_fxX = l_faixa3) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac3) THEN
                          l_atuqtd := FALSE;
                          l_qtdCrX := l_qtdcr3;
                       END IF;
                   ELSIF ((l_fxX = l_faixa4) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac4) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr4;
                       END IF;
                   ELSIF ((l_fxX = l_faixa5) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac5) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr5;
                       END IF;
                   ELSIF ((l_fxX = l_faixa6) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac6) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr6;
                       END IF;
                   END IF;

                   IF (l_count = 1) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd1 := l_qtdCrX;
                       ELSE
                           l_qtd1 := l_crefx1;
                       END IF;
                   ELSIF (l_count = 2) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd2 := l_qtdCrX;
                       ELSE
                           l_qtd2 := l_crefx2;
                       END IF;
                   ELSIF (l_count = 3) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd3 := l_qtdCrX;
                       ELSE
                           l_qtd3 := l_crefx3;
                       END IF;
                   ELSIF (l_count = 4) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd4 := l_qtdCrX;
                       ELSE
                           l_qtd4 := l_crefx4;
                       END IF;
                   ELSIF (l_count = 5) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd5 := l_qtdCrX;
                       ELSE
                           l_qtd5 := l_crefx5;
                       END IF;
                   ELSIF (l_count = 6) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd6 := l_qtdCrX;
                       ELSE
                           l_qtd6 := l_crefx6;
                       END IF;
                   END IF;

                   l_count := l_count + 1;
               END LOOP;

               /*VALIDA SE HÁ A NECESSIDADE DE GERAR PENDÊNCIA UPDATECreditAcess - 6*/
               /*CASO HOUVE ALTERAÇÃO, ENTÃO NÃO GERA PENDÊNCIA, POIS, A R070CON_EU VAI GERAR*/
               IF ( (l_creac1 <> l_crefx1) OR (l_faixa1 <> l_fx1) OR (l_qtdcr1 <> l_qtd1) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac2 <> l_crefx2) OR (l_faixa2 <> l_fx2) OR (l_qtdcr2 <> l_qtd2) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac3 <> l_crefx3) OR (l_faixa3 <> l_fx3) OR (l_qtdcr3 <> l_qtd3) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac4 <> l_crefx4) OR (l_faixa4 <> l_fx4) OR (l_qtdcr4 <> l_qtd4) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac5 <> l_crefx5) OR (l_faixa5 <> l_fx5) OR (l_qtdcr5 <> l_qtd5) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac6 <> l_crefx6) OR (l_faixa6 <> l_fx6) OR (l_qtdcr6 <> l_qtd6) ) THEN
                   l_updatecredit := FALSE;
               END IF;

               LOOP
                 /* atualiza r070con */
                 BEGIN
                      UPDATE R070CON SET
                             CREAC1=l_crefx1, CREFX1=l_fx1, QTDCR1=l_qtd1,
                             CREAC2=l_crefx2, CREFX2=l_fx2, QTDCR2=l_qtd2,
                             CREAC3=l_crefx3, CREFX3=l_fx3, QTDCR3=l_qtd3,
                             CREAC4=l_crefx4, CREFX4=l_fx4, QTDCR4=l_qtd4,
                             CREAC5=l_crefx5, CREFX5=l_fx5, QTDCR5=l_qtd5,
                             CREAC6=l_crefx6, CREFX6=l_fx6, QTDCR6=l_qtd6
                       WHERE NUMFIS = l_crapri;
                 EXCEPTION
                      WHEN OTHERS THEN NULL;
                 END;

                 /*Guarda os crachás para atualizar a última passagem no refeitório, somente para definição 3*/
                 BEGIN
                     IF (l_crapri <> l_cracha) AND (l_tecpri < 3) THEN

                         IF (l_numpro > 0) THEN
                             SP_INTSTR(l_numpro, '999999999999', l_craauxstr OUT);
                             IF (l_craupd_con <> ' ') THEN
                                 l_craupd_con := l_craupd_con || ',' ||''''||l_craauxstr||'''';
                             ELSE
                                 l_craupd_con := ''''||l_craauxstr||'''';
                             END IF;
                         END IF;

                         IF (l_numbar > 0) THEN
                             SP_INTSTR(l_numbar, '999999999999', l_craauxstr OUT);
                             IF (l_craupd_con <> ' ') THEN
                                 l_craupd_con := l_craupd_con || ',' ||''''||l_craauxstr||'''';
                             ELSE
                                 l_craupd_con := ''''||l_craauxstr||'''';
                             END IF;
                         END IF;

                     ELSE
                         SP_RETICARD(l_idtpes, l_cracha, l_craauxstr OUT , l_icardR OUT, l_numser OUT);

                         IF (l_craupd_con <> ' ') THEN
                             l_craupd_con := l_craupd_con || ',' ||''''||l_craauxstr||'''';
                         ELSE
                             l_craupd_con := ''''||l_craauxstr||'''';
                         END IF;
                     END IF;

                 EXCEPTION
                     WHEN OTHERS THEN
                         l_craupd_con := ' ';
                 END;

                 /*Controle do Looping, onde deve ser efetuado o update no crachá provisório caso o mesmo exista.*/
                 SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                 IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) OR (p_tippes >= 4) THEN
                   EXIT;
                 ELSE
                    l_cracha := l_cracha_pro;
                    /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
                    SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                    IF (l_crapri = 0) THEN
                        l_crapri := l_cracha;
                    END IF;
                 END IF;

               END LOOP;

               /*SE NÃO ATUALIZOU NADA NA R070CON, DEVE GERAR PENDÊNCIA UPDATECREDITACESS, PARA QUE AS CONCENTRADORAS FIQUEM ATUALIZADAS*/
               IF (l_updatecredit = TRUE) THEN
                   /*ESTA PENDÊNCIA VAI ATUALIZA OS CRÉDITOS DA PESSOA NAS CONCENTRADORAS*/
                   SP_PEND06(1, l_idtpes, p_verplf, p_codplf);
               END IF;
               SP_ATUTSI(l_idtpes, l_crapri, TRUE, FALSE, FALSE, FALSE);

               /*Verifica se deve alterar a última data de passagem em dispositivo refeitório para Telemática*/
               IF (l_craupd_con <> ' ') THEN
                   /*Colaborador*/
                  IF (p_tippes < 4) THEN
                      BEGIN
                          SELECT MAX(DATCON)
                               , MAX(HORCON)
                            INTO l_datcon,l_horcon
                            FROM R070CRC
                           WHERE CODPLF = p_codplf
                             AND VERPLF = p_verplf
                             AND NUMEMP = p_numemp
                             AND TIPCOL = p_tipcol
                             AND NUMCAD = p_numcad
                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
                             AND DATCON = (SELECT MAX(DATCON) FROM R070CRC WHERE CODPLF = p_codplf
                                 AND VERPLF = p_verplf
                                 AND NUMEMP = p_numemp
                                 AND TIPCOL = p_tipcol
                                 AND NUMCAD = p_numcad
                                 AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                      EXCEPTION
                          WHEN OTHERS THEN
                              l_datcon := l_data_zero;
                              l_horcon := 0;
                      END;
                  /*Visitante.*/
                  ELSIF (p_tippes = 4) THEN
                      BEGIN
                          SELECT MAX(DATCON)
                               , MAX(HORCON)
                            INTO l_datcon,l_horcon
                            FROM R070CRV
                           WHERE CODPLF = p_codplf
                             AND VERPLF = p_verplf
                             AND TIPDOC = p_tipdoc
                             AND NUMDOC = p_numdoc
                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
                             AND DATCON = (SELECT MAX(DATCON) FROM R070CRV WHERE CODPLF = p_codplf
                                 AND VERPLF = p_verplf
                                 AND TIPDOC = p_tipdoc
                                 AND NUMDOC = p_numdoc
                                 AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                      EXCEPTION
                          WHEN OTHERS THEN
                              l_datcon := l_data_zero;
                              l_horcon := 0;
                      END;
                  /*Outras Unidades*/
                  ELSIF (p_tippes = 5) THEN
                      BEGIN
                          SELECT MAX(DATCON)
                               , MAX(HORCON)
                            INTO l_datcon,l_horcon
                            FROM R070CRO
                           WHERE CODPLF = p_codplf
                             AND VERPLF = p_verplf
                             AND NUMEMP = p_numemp
                             AND NUMCAD = p_numcad
                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
                             AND DATCON = (SELECT MAX(DATCON) FROM R070CRO WHERE CODPLF = p_codplf
	                             AND VERPLF = p_verplf
	                             AND NUMEMP = p_numemp
	                             AND NUMCAD = p_numcad
	                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                      EXCEPTION
                          WHEN OTHERS THEN
                              l_datcon := l_data_zero;
                              l_horcon := 0;
                      END;
                  /*Aluno*/
                  ELSIF (p_tippes = 6) THEN
                      BEGIN
                          SELECT MAX(DATCON)
                               , MAX(HORCON)
                            INTO l_datcon,l_horcon
                            FROM R070CRA
                           WHERE CODPLF = p_codplf
                             AND VERPLF = p_verplf
                             AND NUMMAT = p_nummat
                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
	                             AND DATCON = (SELECT MAX(DATCON) FROM R070CRA WHERE CODPLF = p_codplf
	                             AND VERPLF = p_verplf
	                             AND NUMMAT = p_nummat
	                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                      EXCEPTION
                          WHEN OTHERS THEN
                              l_datcon := l_data_zero;
                              l_horcon := 0;
                      END;
                   /*Responsavel do Aluno */
                  ELSIF (p_tippes = 7) THEN
                      BEGIN
                          SELECT MAX(DATCON)
                               , MAX(HORCON)
                            INTO l_datcon,l_horcon
                            FROM R070CRR
                           WHERE CODPLF = p_codplf
                             AND VERPLF = p_verplf
                             AND TIPDOC = p_tipdoc
                             AND NUMDOC = p_numdoc
                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
                             AND DATCON = (SELECT MAX(DATCON) FROM R070CRR WHERE CODPLF = p_codplf
	                             AND VERPLF = p_verplf
	                             AND TIPDOC = p_tipdoc
	                             AND NUMDOC = p_numdoc
	                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                      EXCEPTION
                          WHEN OTHERS THEN
                              l_datcon := l_data_zero;
                              l_horcon := 0;
                      END;
                  /*Pacientes*/
                  ELSIF (p_tippes = 9) THEN
                      BEGIN
                          SELECT MAX(DATCON)
                               , MAX(HORCON)
                            INTO l_datcon,l_horcon
                            FROM R070CRP
                           WHERE CODPLF = p_codplf
                             AND VERPLF = p_verplf
                             AND PROPAC = p_propac
                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
                             AND DATCON = (SELECT MAX(DATCON) FROM R070CRP WHERE CODPLF = p_codplf
	                             AND VERPLF = p_verplf
	                             AND PROPAC = p_propac
	                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                      EXCEPTION
                          WHEN OTHERS THEN
                              l_datcon := l_data_zero;
                              l_horcon := 0;
                      END;
                  /*Acompanhante de Paciente*/
                  ELSIF (p_tippes = 11) THEN
                      BEGIN
                          SELECT MAX(DATCON)
                               , MAX(HORCON)
                            INTO l_datcon,l_horcon
                            FROM R070CAP
                           WHERE CODPLF = p_codplf
                             AND VERPLF = p_verplf
                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
                             AND DATCON = (SELECT MAX(DATCON) FROM R070CAP WHERE CODPLF = p_codplf
	                             AND VERPLF = p_verplf
	                             AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero));
                      EXCEPTION
                          WHEN OTHERS THEN
                              l_datcon := l_data_zero;
                              l_horcon := 0;
                      END;
                  ELSE
                      l_datcon := l_data_zero;
                      l_horcon := 0;
                  END IF;

                  IF (l_datcon IS NULL) OR (l_datcon = l_data_zero) THEN
                      l_ultpasref := '          ';
                  ELSE
                      SP_INTSTR(l_horcon,'HHMM',l_horstr OUT);
                      SP_DATSTR(l_datcon,'DDMMYY',l_datstr OUT);
                      l_ultpasref := l_datstr || l_horstr;
                  END IF;

                  l_comando := 'UPDATE '||l_usutel||'CONTROLE SET ULTPAS_REF = '''||l_ultpasref||
                               ''' WHERE ICARD IN('||l_craupd_con||') AND VER_CRED = 3';
                  SP_CMDTSI(l_comando);
               END IF;

           END IF;
      END IF;


  ELSE /* POR LOCAL FÍSICO */
      /*Gera pendência para a CSM Center, informando os créditos de acesso, SOMENTE SE EXISTIR CRACHÁ ASSOCIADO A PESSOA*/
      IF (l_cracha <> 0) THEN
          SP_PEND06(1, l_idtpes, p_verplf, p_codplf);
      END IF;
  END IF;
END		SENIOR;21ySP_INTSTR
SP_RETCRA
SP_MAPFIS
SP_RETCRC
SP_RETCRV
SP_RETCRO
SP_RETCAA
SP_RETCRR
SP_RETCRP
SP_RETCAP
SP_PEND06
\D␀␀PROCEDURE SP_CRECON(P_TIPPES INTEGER,P_NUMEMP NUMBER,P_TIPCOL INTEGER,P_NUMCAD NUMBER,P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMMAT VARCHAR2(15),P_PROPAC VARCHAR2(20),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7))
 IS

l_cracha       NUMBER(12);
  l_cracha_pro   NUMBER(12);
  l_comando_nulo BOOLEAN;
  l_fxX          CHAR(8);
  l_crefxX       CHAR(2);
  l_qtdCrX       NUMBER(2);
  l_creac1       NUMBER(2);
  l_fx1          CHAR(8);
  l_faixa1       CHAR(8);
  l_crefx1       CHAR(2);
  l_qtdcr1       NUMBER(2);
  l_qtd1         NUMBER(2);
  l_creac2       NUMBER(2);
  l_fx2          CHAR(8);
  l_faixa2       CHAR(8);
  l_crefx2       CHAR(2);
  l_qtdcr2       NUMBER(2);
  l_qtd2         NUMBER(2);
  l_creac3       NUMBER(2);
  l_fx3          CHAR(8);
  l_faixa3       CHAR(8);
  l_crefx3       CHAR(2);
  l_qtdcr3       NUMBER(2);
  l_qtd3         NUMBER(2);
  l_creac4       NUMBER(2);
  l_fx4          CHAR(8);
  l_faixa4       CHAR(8);
  l_crefx4       CHAR(2);
  l_qtdcr4       NUMBER(2);
  l_qtd4         NUMBER(2);
  l_creac5       NUMBER(2);
  l_fx5          CHAR(8);
  l_faixa5       CHAR(8);
  l_crefx5       CHAR(2);
  l_qtdcr5       NUMBER(2);
  l_qtd5         NUMBER(2);
  l_creac6       NUMBER(2);
  l_fx6          CHAR(8);
  l_faixa6       CHAR(8);
  l_crefx6       CHAR(2);
  l_qtdcr6       NUMBER(2);
  l_qtd6         NUMBER(2);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_count        NUMBER(1);
  l_atuqtd       BOOLEAN;
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_tipdoc       CHAR(1);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_updatecredit BOOLEAN;
BEGIN
  /*Inicializações*/
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  l_cracha     := 0;

  /*MONTA O IDTPES DE ACORDO COM A PESSOA*/

  /*Colaborador*/
  IF (p_tippes < 4) THEN
      SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
  /*Visitante.*/
  ELSIF (p_tippes = 4) THEN
      l_tippes:= '04';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  /*Outras Unidades*/
  ELSIF (p_tippes = 5) THEN
      l_tippes:= '05';
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes||l_numemp||l_numcad;
  /*Aluno*/
  ELSIF (p_tippes = 6) THEN
      l_idtpes:= '10'||p_nummat;
   /*Responsavel do Aluno */
  ELSIF (p_tippes = 7) THEN
      l_tippes:= '07';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  /*Pacientes*/
  ELSIF (p_tippes = 9) THEN
      l_idtpes := '09'||p_propac;
  /*Acompanhante de Paciente*/
  ELSIF (p_tippes = 11) THEN
      l_tippes:= '11';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  ELSE
      RAISERROR 103 'SP_CRECON: Tipo de pessoa inválida para operação.';    
  END IF;

  /*Preenche o campo com espaços para completar 23 posições*/
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
     /*Controle do Loop.*/
     IF (Length(l_idtpes) > 22) THEN
         EXIT;
     END IF;
     l_idtpes := ' '||l_idtpes;
  END LOOP;

  /*Obtem o Crachá do Colaborador*/
  IF (p_tippes < 4) THEN
      SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
      IF   (l_cracha = 0)  THEN
          SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
      END IF;
  /*Obtem o Crachá do Visitante.*/
  ELSIF (p_tippes = 4) THEN
      BEGIN
        SELECT NUMCRA INTO l_cracha
          FROM R090HCH
         WHERE R090HCH.TIPDOC = p_tipdoc AND
               R090HCH.NUMDOC = p_numdoc AND
               (R090HCH.DATINI < l_data_atual OR
                (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
               (R090HCH.DATFIM = l_data_zero OR
                R090HCH.DATFIM > l_data_atual OR
                (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
      EXCEPTION
        WHEN TOO_MANY_ROWS THEN
          RAISERROR 103 'SP_CRECON: Erro em R090VIS - TOO MANY ROWS';
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'SP_CRECON: ON-Line: Erro no SELECT R090HCH em R090VIS.';
      END;
  /*Obtem o Crachá de Outras Unidades*/
  ELSIF (p_tippes = 5) THEN
      SP_RetCra (1, p_numemp, 5, p_numcad, 0,'',0,'',l_cracha OUT);
      IF   l_cracha = 0 THEN
           SP_RetCra (2, p_numemp, 5, p_numcad, 0,'',0,'',l_cracha OUT);
      END IF;
  /*Obtem o Crachá do Aluno*/
  ELSIF (p_tippes = 6) THEN
      SP_RETCRA (1,0,6,0, 0,p_nummat,0,'', l_cracha OUT);
      IF  (l_cracha = 0)  THEN
          SP_RETCRA (2,0,6,0,0,p_nummat,0,'', l_cracha OUT);
      END IF;
   /*Obtem o Crachá do Responsavel do Aluno */ 
  ELSIF (p_tippes = 7) THEN
      SP_RetCra (1, 0, 7, 0, 0,'',p_tipdoc,p_numdoc,l_cracha OUT);
      IF   l_cracha = 0 THEN
        SP_RetCra (2, 0, 7, 0, 0,'',p_tipdoc,p_numdoc,l_cracha OUT);
      END IF;
  /*Obtem o crachá de pacientes*/
  ELSIF (p_tippes = 9) THEN
      BEGIN
          SELECT NUMCRA INTO l_cracha
          FROM R097INT
          WHERE PROPAC = p_propac
          AND ((DATFIM > l_data_atual) OR
               ((DATFIM = l_data_atual) AND (HORFIM >= l_hora_atual)) OR
               (DATFIM = l_data_zero));
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
      END;
  /*Obtem o crachá do acompanhante do paciente*/
  ELSIF (p_tippes = 11) THEN
      BEGIN
          SELECT NUMCRA INTO l_cracha
          FROM R097AIN
          WHERE TIPDOC = p_tipdoc
          AND NUMDOC = p_numdoc
          AND ((DATFAC > l_data_atual) OR
               ((DATFAC = l_data_atual) AND (HORFAC >= l_hora_atual)) OR
               (DATFAC = l_data_zero));
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
      END;
  END IF;

  /*SEM LOCAL FÍSICO*/
  IF (p_codplf = 0) THEN
      /* Verifica se encontrou o crachá para pessoa */
      IF   l_cracha <> 0  THEN
           l_updatecredit := TRUE;
           /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
           SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
           IF (l_crapri = 0) THEN
               l_crapri := l_cracha;
           END IF;

           /*Verifica se o Crachá está na R070CON*/
           l_comando_nulo := FALSE;
           BEGIN
               SELECT CREAC1, CREFX1, QTDCR1, CREAC2, CREFX2, QTDCR2, CREAC3, CREFX3, QTDCR3, CREAC4, CREFX4, QTDCR4, CREAC5, CREFX5, QTDCR5, CREAC6, CREFX6, QTDCR6
               INTO l_creac1,l_faixa1,l_qtdcr1,l_creac2,l_faixa2,l_qtdcr2,l_creac3,l_faixa3,l_qtdcr3,l_creac4,l_faixa4,l_qtdcr4,l_creac5,l_faixa5,l_qtdcr5,l_creac6,l_faixa6,l_qtdcr6
               FROM R070CON WHERE NUMFIS = l_crapri;
           EXCEPTION
               WHEN NO_DATA_FOUND THEN l_comando_nulo := TRUE;
               WHEN OTHERS THEN RAISERROR 103 'SP_CRECON: ON-Line: Erro No SELECT R070CON 3.';
           END;

           /*Se encontrou o crachá na R070CON*/
           IF  (l_comando_nulo = FALSE) THEN

               /*Obtem as Informações Referentes ao Crédito de Acesso*/
               IF (p_tippes < 4) THEN
                   SP_RETCRC (p_numemp, p_tipcol, p_numcad, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 4) THEN
                   SP_RETCRV (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 5) THEN
                   SP_RETCRO (p_numemp, p_numcad, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 6) THEN
                   SP_RETCAA (p_nummat, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 7) THEN
                   SP_RETCRR(p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 9) THEN
                   SP_RETCRP (p_propac, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 11) THEN
                   SP_RETCAP (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               END IF;

               l_count := 1;
               /*Consistência para adquirir a QtdCrX da Pessoa*/
               /*O Looping irá comparar os créditos obtidos pela procedure que retorna os créditos de
                 Acesso da Pessoa com a Informação Gravada na R070CON. Se tiver alteração da quantidade
                 de créditos então atualiza o campo qtdCrX.*/
               LOOP
                   IF (l_count = 1) THEN
                       l_fxX := l_fx1;
                       l_crefxX := l_crefx1;
                   ELSIF (l_count = 2) THEN
                       l_fxX := l_fx2;
                       l_crefxX := l_crefx2;
                   ELSIF (l_count = 3) THEN
                       l_fxX := l_fx3;
                       l_crefxX := l_crefx3;
                   ELSIF (l_count = 4) THEN
                       l_fxX := l_fx4;
                       l_crefxX := l_crefx4;
                   ELSIF (l_count = 5) THEN
                       l_fxX := l_fx5;
                       l_crefxX := l_crefx5;
                   ELSIF (l_count = 6) THEN
                       l_fxX := l_fx6;
                       l_crefxX := l_crefx6;
                   ELSE
                       /*Controle do Loop*/
                       EXIT;
                   END IF;

                   l_atuqtd := TRUE;
                   /*Verifica se a Faixa (1..6) foi alterada, para efetuar o update na r070con
                     apenas da faixa alterada*/
                   IF ((l_fxX = l_faixa1) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac1) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr1;
                       END IF;
                   ELSIF ((l_fxX = l_faixa2) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac2) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr2;
                       END IF;
                   ELSIF ((l_fxX = l_faixa3) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac3) THEN
                          l_atuqtd := FALSE;
                          l_qtdCrX := l_qtdcr3;
                       END IF;
                   ELSIF ((l_fxX = l_faixa4) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac4) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr4;
                       END IF;
                   ELSIF ((l_fxX = l_faixa5) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac5) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr5;
                       END IF;
                   ELSIF ((l_fxX = l_faixa6) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac6) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr6;
                       END IF;
                   END IF;

                   IF (l_count = 1) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd1 := l_qtdCrX;
                       ELSE
                           l_qtd1 := l_crefx1;
                       END IF;
                   ELSIF (l_count = 2) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd2 := l_qtdCrX;
                       ELSE
                           l_qtd2 := l_crefx2;
                       END IF;
                   ELSIF (l_count = 3) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd3 := l_qtdCrX;
                       ELSE
                           l_qtd3 := l_crefx3;
                       END IF;
                   ELSIF (l_count = 4) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd4 := l_qtdCrX;
                       ELSE
                           l_qtd4 := l_crefx4;
                       END IF;
                   ELSIF (l_count = 5) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd5 := l_qtdCrX;
                       ELSE
                           l_qtd5 := l_crefx5;
                       END IF;
                   ELSIF (l_count = 6) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd6 := l_qtdCrX;
                       ELSE
                           l_qtd6 := l_crefx6;
                       END IF;
                   END IF;

                   l_count := l_count + 1;
               END LOOP;

               /*VALIDA SE HÁ A NECESSIDADE DE GERAR PENDÊNCIA UPDATECreditAcess - 6*/
               /*CASO HOUVE ALTERAÇÃO, ENTÃO NÃO GERA PENDÊNCIA, POIS, A R070CON_EU VAI GERAR*/
               IF ( (l_creac1 <> l_crefx1) OR (l_faixa1 <> l_fx1) OR (l_qtdcr1 <> l_qtd1) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac2 <> l_crefx2) OR (l_faixa2 <> l_fx2) OR (l_qtdcr2 <> l_qtd2) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac3 <> l_crefx3) OR (l_faixa3 <> l_fx3) OR (l_qtdcr3 <> l_qtd3) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac4 <> l_crefx4) OR (l_faixa4 <> l_fx4) OR (l_qtdcr4 <> l_qtd4) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac5 <> l_crefx5) OR (l_faixa5 <> l_fx5) OR (l_qtdcr5 <> l_qtd5) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac6 <> l_crefx6) OR (l_faixa6 <> l_fx6) OR (l_qtdcr6 <> l_qtd6) ) THEN
                   l_updatecredit := FALSE;
               END IF;

               LOOP
                 /* atualiza r070con */
                 BEGIN
                      UPDATE R070CON SET
                             CREAC1=l_crefx1, CREFX1=l_fx1, QTDCR1=l_qtd1,
                             CREAC2=l_crefx2, CREFX2=l_fx2, QTDCR2=l_qtd2,
                             CREAC3=l_crefx3, CREFX3=l_fx3, QTDCR3=l_qtd3,
                             CREAC4=l_crefx4, CREFX4=l_fx4, QTDCR4=l_qtd4,
                             CREAC5=l_crefx5, CREFX5=l_fx5, QTDCR5=l_qtd5,
                             CREAC6=l_crefx6, CREFX6=l_fx6, QTDCR6=l_qtd6
                       WHERE NUMFIS = l_crapri;
                 EXCEPTION
                      WHEN OTHERS THEN NULL;
                 END;
                 /*Controle do Looping, onde deve ser efetuado o update no crachá provisório caso o mesmo exista.*/
                 SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                 IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) OR (p_tippes >= 4) THEN
                   EXIT;
                 ELSE
                    l_cracha := l_cracha_pro;
                    /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
                    SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                    IF (l_crapri = 0) THEN
                        l_crapri := l_cracha;
                    END IF;
                 END IF;
               END LOOP;

               /*SE NÃO ATUALIZOU NADA NA R070CON, DEVE GERAR PENDÊNCIA UPDATECREDITACESS, PARA QUE AS CONCENTRADORAS FIQUEM ATUALIZADAS*/
               IF (l_updatecredit = TRUE) THEN
                   /*ESTA PENDÊNCIA VAI ATUALIZA OS CRÉDITOS DA PESSOA NAS CONCENTRADORAS*/
                   SP_PEND06(1, l_idtpes, p_verplf, p_codplf);
               END IF;
           END IF;
      END IF;


  ELSE /* POR LOCAL FÍSICO */
      /*Gera pendência para a CSM Center, informando os créditos de acesso, SOMENTE SE EXISTIR CRACHÁ ASSOCIADO A PESSOA*/
      IF (l_cracha <> 0) THEN
          SP_PEND06(1, l_idtpes, p_verplf, p_codplf);
      END IF;
  END IF;
END		SENIOR;22ySP_INTSTR
SP_RETCRA
SP_MAPFIS
SP_RETCRC
SP_RETCRV
SP_RETCRO
SP_RETCAA
SP_RETCRR
SP_RETCRP
SP_RETCAP
SP_PEND06
\D␀␀PROCEDURE SP_CRECON(P_TIPPES INTEGER,P_NUMEMP NUMBER,P_TIPCOL INTEGER,P_NUMCAD NUMBER,P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMMAT VARCHAR2(15),P_PROPAC VARCHAR2(20),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7))
 IS

l_cracha       NUMBER(12);
  l_cracha_pro   NUMBER(12);
  l_comando_nulo BOOLEAN;
  l_fxX          CHAR(8);
  l_crefxX       CHAR(2);
  l_qtdCrX       NUMBER(2);
  l_creac1       NUMBER(2);
  l_fx1          CHAR(8);
  l_faixa1       CHAR(8);
  l_crefx1       CHAR(2);
  l_qtdcr1       NUMBER(2);
  l_qtd1         NUMBER(2);
  l_creac2       NUMBER(2);
  l_fx2          CHAR(8);
  l_faixa2       CHAR(8);
  l_crefx2       CHAR(2);
  l_qtdcr2       NUMBER(2);
  l_qtd2         NUMBER(2);
  l_creac3       NUMBER(2);
  l_fx3          CHAR(8);
  l_faixa3       CHAR(8);
  l_crefx3       CHAR(2);
  l_qtdcr3       NUMBER(2);
  l_qtd3         NUMBER(2);
  l_creac4       NUMBER(2);
  l_fx4          CHAR(8);
  l_faixa4       CHAR(8);
  l_crefx4       CHAR(2);
  l_qtdcr4       NUMBER(2);
  l_qtd4         NUMBER(2);
  l_creac5       NUMBER(2);
  l_fx5          CHAR(8);
  l_faixa5       CHAR(8);
  l_crefx5       CHAR(2);
  l_qtdcr5       NUMBER(2);
  l_qtd5         NUMBER(2);
  l_creac6       NUMBER(2);
  l_fx6          CHAR(8);
  l_faixa6       CHAR(8);
  l_crefx6       CHAR(2);
  l_qtdcr6       NUMBER(2);
  l_qtd6         NUMBER(2);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_count        NUMBER(1);
  l_atuqtd       BOOLEAN;
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_tipdoc       CHAR(1);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_updatecredit BOOLEAN;
BEGIN
  /*Inicializações*/
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  l_cracha     := 0;

  /*MONTA O IDTPES DE ACORDO COM A PESSOA*/

  /*Colaborador*/
  IF (p_tippes < 4) THEN
      SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
  /*Visitante.*/
  ELSIF (p_tippes = 4) THEN
      l_tippes:= '04';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  /*Outras Unidades*/
  ELSIF (p_tippes = 5) THEN
      l_tippes:= '05';
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes||l_numemp||l_numcad;
  /*Aluno*/
  ELSIF (p_tippes = 6) THEN
      l_idtpes:= '10'||p_nummat;
   /*Responsavel do Aluno */
  ELSIF (p_tippes = 7) THEN
      l_tippes:= '07';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  /*Pacientes*/
  ELSIF (p_tippes = 9) THEN
      l_idtpes := '09'||p_propac;
  /*Acompanhante de Paciente*/
  ELSIF (p_tippes = 11) THEN
      l_tippes:= '11';
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := l_tippes||l_tipdoc||p_numdoc;
  ELSE
      RAISERROR 103 'SP_CRECON: Tipo de pessoa inválida para operação.';    
  END IF;

  /*Preenche o campo com espaços para completar 23 posições*/
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
     /*Controle do Loop.*/
     IF (Length(l_idtpes) > 22) THEN
         EXIT;
     END IF;
     l_idtpes := ' '||l_idtpes;
  END LOOP;

  /*Obtem o Crachá do Colaborador*/
  IF (p_tippes < 4) THEN
      SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
      IF   (l_cracha = 0)  THEN
          SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
      END IF;
  /*Obtem o Crachá do Visitante.*/
  ELSIF (p_tippes = 4) THEN
      BEGIN
        SELECT NUMCRA INTO l_cracha
          FROM R090HCH
         WHERE R090HCH.TIPDOC = p_tipdoc AND
               R090HCH.NUMDOC = p_numdoc AND
               (R090HCH.DATINI < l_data_atual OR
                (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
               (R090HCH.DATFIM = l_data_zero OR
                R090HCH.DATFIM > l_data_atual OR
                (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
      EXCEPTION
        WHEN TOO_MANY_ROWS THEN
          RAISERROR 103 'SP_CRECON: Erro em R090VIS - TOO MANY ROWS';
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'SP_CRECON: ON-Line: Erro no SELECT R090HCH em R090VIS.';
      END;
  /*Obtem o Crachá de Outras Unidades*/
  ELSIF (p_tippes = 5) THEN
      SP_RetCra (1, p_numemp, 5, p_numcad, 0,'',0,'',l_cracha OUT);
      IF   l_cracha = 0 THEN
           SP_RetCra (2, p_numemp, 5, p_numcad, 0,'',0,'',l_cracha OUT);
      END IF;
  /*Obtem o Crachá do Aluno*/
  ELSIF (p_tippes = 6) THEN
      SP_RETCRA (1,0,6,0, 0,p_nummat,0,'', l_cracha OUT);
      IF  (l_cracha = 0)  THEN
          SP_RETCRA (2,0,6,0,0,p_nummat,0,'', l_cracha OUT);
      END IF;
   /*Obtem o Crachá do Responsavel do Aluno */ 
  ELSIF (p_tippes = 7) THEN
      SP_RetCra (1, 0, 7, 0, 0,'',p_tipdoc,p_numdoc,l_cracha OUT);
      IF   l_cracha = 0 THEN
        SP_RetCra (2, 0, 7, 0, 0,'',p_tipdoc,p_numdoc,l_cracha OUT);
      END IF;
  /*Obtem o crachá de pacientes*/
  ELSIF (p_tippes = 9) THEN
      BEGIN
          SELECT NUMCRA INTO l_cracha
          FROM R097INT
          WHERE PROPAC = p_propac
          AND ((DATFIM > l_data_atual) OR
               ((DATFIM = l_data_atual) AND (HORFIM >= l_hora_atual)) OR
               (DATFIM = l_data_zero));
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
      END;
  /*Obtem o crachá do acompanhante do paciente*/
  ELSIF (p_tippes = 11) THEN
      BEGIN
          SELECT NUMCRA INTO l_cracha
          FROM R097AIN
          WHERE TIPDOC = p_tipdoc
          AND NUMDOC = p_numdoc
          AND ((DATFAC > l_data_atual) OR
               ((DATFAC = l_data_atual) AND (HORFAC >= l_hora_atual)) OR
               (DATFAC = l_data_zero));
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_cracha := 0;
      END;
  END IF;

  /*SEM LOCAL FÍSICO*/
  IF (p_codplf = 0) THEN
      /* Verifica se encontrou o crachá para pessoa */
      IF   l_cracha <> 0  THEN
           l_updatecredit := TRUE;
           /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
           SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
           IF (l_crapri = 0) THEN
               l_crapri := l_cracha;
           END IF;

           /*Verifica se o Crachá está na R070CON*/
           l_comando_nulo := FALSE;
           BEGIN
               SELECT CREAC1, CREFX1, QTDCR1, CREAC2, CREFX2, QTDCR2, CREAC3, CREFX3, QTDCR3, CREAC4, CREFX4, QTDCR4, CREAC5, CREFX5, QTDCR5, CREAC6, CREFX6, QTDCR6
               INTO l_creac1,l_faixa1,l_qtdcr1,l_creac2,l_faixa2,l_qtdcr2,l_creac3,l_faixa3,l_qtdcr3,l_creac4,l_faixa4,l_qtdcr4,l_creac5,l_faixa5,l_qtdcr5,l_creac6,l_faixa6,l_qtdcr6
               FROM R070CON WHERE NUMFIS = l_crapri;
           EXCEPTION
               WHEN NO_DATA_FOUND THEN l_comando_nulo := TRUE;
               WHEN OTHERS THEN RAISERROR 103 'SP_CRECON: ON-Line: Erro No SELECT R070CON 3.';
           END;

           /*Se encontrou o crachá na R070CON*/
           IF  (l_comando_nulo = FALSE) THEN

               /*Obtem as Informações Referentes ao Crédito de Acesso*/
               IF (p_tippes < 4) THEN
                   SP_RETCRC (p_numemp, p_tipcol, p_numcad, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 4) THEN
                   SP_RETCRV (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 5) THEN
                   SP_RETCRO (p_numemp, p_numcad, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 6) THEN
                   SP_RETCAA (p_nummat, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 7) THEN
                   SP_RETCRR(p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 9) THEN
                   SP_RETCRP (p_propac, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               ELSIF (p_tippes = 11) THEN
                   SP_RETCAP (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
               END IF;

               l_count := 1;
               /*Consistência para adquirir a QtdCrX da Pessoa*/
               /*O Looping irá comparar os créditos obtidos pela procedure que retorna os créditos de
                 Acesso da Pessoa com a Informação Gravada na R070CON. Se tiver alteração da quantidade
                 de créditos então atualiza o campo qtdCrX.*/
               LOOP
                   IF (l_count = 1) THEN
                       l_fxX := l_fx1;
                       l_crefxX := l_crefx1;
                   ELSIF (l_count = 2) THEN
                       l_fxX := l_fx2;
                       l_crefxX := l_crefx2;
                   ELSIF (l_count = 3) THEN
                       l_fxX := l_fx3;
                       l_crefxX := l_crefx3;
                   ELSIF (l_count = 4) THEN
                       l_fxX := l_fx4;
                       l_crefxX := l_crefx4;
                   ELSIF (l_count = 5) THEN
                       l_fxX := l_fx5;
                       l_crefxX := l_crefx5;
                   ELSIF (l_count = 6) THEN
                       l_fxX := l_fx6;
                       l_crefxX := l_crefx6;
                   ELSE
                       /*Controle do Loop*/
                       EXIT;
                   END IF;

                   l_atuqtd := TRUE;
                   /*Verifica se a Faixa (1..6) foi alterada, para efetuar o update na r070con
                     apenas da faixa alterada*/
                   IF ((l_fxX = l_faixa1) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac1) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr1;
                       END IF;
                   ELSIF ((l_fxX = l_faixa2) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac2) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr2;
                       END IF;
                   ELSIF ((l_fxX = l_faixa3) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac3) THEN
                          l_atuqtd := FALSE;
                          l_qtdCrX := l_qtdcr3;
                       END IF;
                   ELSIF ((l_fxX = l_faixa4) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac4) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr4;
                       END IF;
                   ELSIF ((l_fxX = l_faixa5) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac5) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr5;
                       END IF;
                   ELSIF ((l_fxX = l_faixa6) AND (l_fxX <> '24002400')) THEN
                       IF (l_crefxX = l_creac6) THEN
                           l_atuqtd := FALSE;
                           l_qtdCrX := l_qtdcr6;
                       END IF;
                   END IF;

                   IF (l_count = 1) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd1 := l_qtdCrX;
                       ELSE
                           l_qtd1 := l_crefx1;
                       END IF;
                   ELSIF (l_count = 2) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd2 := l_qtdCrX;
                       ELSE
                           l_qtd2 := l_crefx2;
                       END IF;
                   ELSIF (l_count = 3) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd3 := l_qtdCrX;
                       ELSE
                           l_qtd3 := l_crefx3;
                       END IF;
                   ELSIF (l_count = 4) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd4 := l_qtdCrX;
                       ELSE
                           l_qtd4 := l_crefx4;
                       END IF;
                   ELSIF (l_count = 5) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd5 := l_qtdCrX;
                       ELSE
                           l_qtd5 := l_crefx5;
                       END IF;
                   ELSIF (l_count = 6) THEN
                       IF (l_atuqtd = FALSE) THEN
                           l_qtd6 := l_qtdCrX;
                       ELSE
                           l_qtd6 := l_crefx6;
                       END IF;
                   END IF;

                   l_count := l_count + 1;
               END LOOP;

               /*VALIDA SE HÁ A NECESSIDADE DE GERAR PENDÊNCIA UPDATECreditAcess - 6*/
               /*CASO HOUVE ALTERAÇÃO, ENTÃO NÃO GERA PENDÊNCIA, POIS, A R070CON_EU VAI GERAR*/
               IF ( (l_creac1 <> l_crefx1) OR (l_faixa1 <> l_fx1) OR (l_qtdcr1 <> l_qtd1) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac2 <> l_crefx2) OR (l_faixa2 <> l_fx2) OR (l_qtdcr2 <> l_qtd2) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac3 <> l_crefx3) OR (l_faixa3 <> l_fx3) OR (l_qtdcr3 <> l_qtd3) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac4 <> l_crefx4) OR (l_faixa4 <> l_fx4) OR (l_qtdcr4 <> l_qtd4) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac5 <> l_crefx5) OR (l_faixa5 <> l_fx5) OR (l_qtdcr5 <> l_qtd5) ) THEN
                   l_updatecredit := FALSE;
               ELSIF ( (l_creac6 <> l_crefx6) OR (l_faixa6 <> l_fx6) OR (l_qtdcr6 <> l_qtd6) ) THEN
                   l_updatecredit := FALSE;
               END IF;

               LOOP
                 /* atualiza r070con */
                 BEGIN
                      UPDATE R070CON SET
                             CREAC1=l_crefx1, CREFX1=l_fx1, QTDCR1=l_qtd1,
                             CREAC2=l_crefx2, CREFX2=l_fx2, QTDCR2=l_qtd2,
                             CREAC3=l_crefx3, CREFX3=l_fx3, QTDCR3=l_qtd3,
                             CREAC4=l_crefx4, CREFX4=l_fx4, QTDCR4=l_qtd4,
                             CREAC5=l_crefx5, CREFX5=l_fx5, QTDCR5=l_qtd5,
                             CREAC6=l_crefx6, CREFX6=l_fx6, QTDCR6=l_qtd6
                       WHERE NUMFIS = l_crapri;
                 EXCEPTION
                      WHEN OTHERS THEN NULL;
                 END;
                 /*Controle do Looping, onde deve ser efetuado o update no crachá provisório caso o mesmo exista.*/
                 SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                 IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) OR (p_tippes >= 4) THEN
                   EXIT;
                 ELSE
                    l_cracha := l_cracha_pro;
                    /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
                    SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                    IF (l_crapri = 0) THEN
                        l_crapri := l_cracha;
                    END IF;
                 END IF;
               END LOOP;

               /*SE NÃO ATUALIZOU NADA NA R070CON, DEVE GERAR PENDÊNCIA UPDATECREDITACESS, PARA QUE AS CONCENTRADORAS FIQUEM ATUALIZADAS*/
               IF (l_updatecredit = TRUE) THEN
                   /*ESTA PENDÊNCIA VAI ATUALIZA OS CRÉDITOS DA PESSOA NAS CONCENTRADORAS*/
                   SP_PEND06(1, l_idtpes, p_verplf, p_codplf);
               END IF;
           END IF;
      END IF;


  ELSE /* POR LOCAL FÍSICO */
      /*Gera pendência para a CSM Center, informando os créditos de acesso, SOMENTE SE EXISTIR CRACHÁ ASSOCIADO A PESSOA*/
      IF (l_cracha <> 0) THEN
          SP_PEND06(1, l_idtpes, p_verplf, p_codplf);
      END IF;
  END IF;
END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
N␀␀PROCEDURE SP_DATAHORA(P_RESULT OUT NUMBER(14,6),L_AOPCAO CHAR(2))
 IS

l_xDATA NUMBER(14,6);
  l_xHORA NUMBER(14,6);
BEGIN
  p_result := 0;
  l_xDATA := DATETIMEDIF(DD, CURDATE(), DATETIME(30,12,1899,0,0,0));
  l_xHORA := ((HOUR(CURTIME()) * 3600000.0 + MINUTE(CURTIME()) * 60000.0 + SECOND(CURTIME()) * 1000.0)/86400000.0);
  IF (l_aOpcao = 'DH') THEN
    p_result := (l_xDATA+l_xHORA);
  ELSE
    IF (l_aOpcao = 'D') THEN
      p_result := l_xDATA;
    ELSE
      IF (l_aOpcao = 'H') THEN
        p_result := l_xHORA;
      END IF;
    END IF;
  END IF;
  RETURN;
END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
GPROCEDURE SP_DATAHORA_DATE(P_RESULT OUT DATE)
 IS
BEGIN
  NULL;
END	ORACLE;0
²CREATE OR REPLACE PROCEDURE SP_DATAHORA_DATE (
  P_RESULT OUT DATE
) AS
BEGIN
  -- pega data e hora atuais do servidor Oracle
  P_RESULT := SYSDATE;
END SP_DATAHORA_DATE;
	MSSQL;0
µCREATE PROCEDURE SP_DATAHORA_DATE
  @P_RESULT DATETIME OUTPUT
AS
BEGIN
  SET NOCOUNT ON;
  -- pega data e hora atuais do servidor SQL Server
  SET @P_RESULT = GETDATE();
END;	POSTGRESQL;0
Ş--  PostgreSQL
CREATE OR REPLACE PROCEDURE SP_DATAHORA_DATE(
  INOUT p_result TIMESTAMP
)
LANGUAGE plpgsql
AS $$
BEGIN
  -- pega data e hora atuais do servidor PostgreSQL
  p_result := CURRENT_TIMESTAMP;
END;
$$;␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Y␀␀PROCEDURE SP_DATETIME(P_RESULT OUT NUMBER(14,6))
 IS

DATA NUMBER(14,6);
  HORA NUMBER(14,6);
BEGIN
  p_result := 0;
  DATA := DATETIMEDIF(DD, CURDATE(), DATETIME(30,12,1899,0,0,0));
  HORA := ((HOUR(CURTIME()) * 3600000.0 + MINUTE(CURTIME()) * 60000.0 + SECOND(CURTIME()) * 1000.0)/86400000.0);
  p_result := DATA+HORA;
  RETURN;
END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
çPROCEDURE SP_DATETOINT(P_DATE DATE,P_RESULT OUT NUMBER)
 IS

	DATA NUMBER(8);
BEGIN
  p_result := 0;

  DATA := TRUNC(DATETIMEDIF(DD, p_DATE, DATETIME(30, 12, 1899, 0, 0, 0)), 0);
  
  p_result := DATA;
  
  RETURN;
END	MSSQL;0
÷␀␀CREATE  PROCEDURE sp_datetoint(@p_DATE DATETIME, @p_result FLOAT OUTPUT) AS
BEGIN
DECLARE @data INTEGER
  DECLARE @ChkError INTEGER
  SELECT @ChkError = 0
  SELECT @p_result = 0
  SELECT @DATA = ROUND((CONVERT(NUMERIC, @p_DATE - CONVERT(DATETIME,CONVERT(VARCHAR,12)+'/'+CONVERT(VARCHAR,30)+'/'+CONVERT(VARCHAR,1899)+' '+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)))), 0, 1)
  SELECT @p_result = @DATA
  BEGIN
    RETURN @ChkError
  END
FIM:
  RETURN @ChkError
END


␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
PROCEDURE SP_DATETONUMBER(P_DATE DATE,P_RESULT OUT NUMBER(14,6))
 IS

DATA NUMBER(14,6);
  HORA NUMBER(14,6);
BEGIN
  p_result := 0;
END		ORACLE;20
Û␀␀create or replace PROCEDURE SP_DATETONUMBER(p_DATE IN DATE,p_result OUT NUMBER) IS
  DATA NUMBER(14,6);
  HORA NUMBER(14,6);
begin
  p_result := 0;
  DATA := TRUNC(DATETIMEDIFF('DD', p_DATE, TO_DATE(TO_CHAR(30)||'/'||TO_CHAR(12)||'/'||TO_CHAR(1899)||' '||TO_CHAR(0)||':'||TO_CHAR(0)||':'||TO_CHAR(0),'DD/MM/YYYY HH24:MI:SS')));
  HORA := ((TO_NUMBER(TO_CHAR(p_DATE,'HH24'))*60.0+TO_NUMBER(TO_CHAR(p_DATE,'MI')))/1440.0);
  p_result := DATA+HORA;
  RETURN;
end;


		ORACLE;22
Û␀␀create or replace PROCEDURE SP_DATETONUMBER(p_DATE IN DATE,p_result OUT NUMBER) IS
  DATA NUMBER(14,6);
  HORA NUMBER(14,6);
begin
  p_result := 0;
  DATA := TRUNC(DATETIMEDIFF('DD', p_DATE, TO_DATE(TO_CHAR(30)||'/'||TO_CHAR(12)||'/'||TO_CHAR(1899)||' '||TO_CHAR(0)||':'||TO_CHAR(0)||':'||TO_CHAR(0),'DD/MM/YYYY HH24:MI:SS')));
  HORA := ((TO_NUMBER(TO_CHAR(p_DATE,'HH24'))*60.0+TO_NUMBER(TO_CHAR(p_DATE,'MI')))/1440.0);
  p_result := DATA+HORA;
  RETURN;
end;


	MSSQL;21
d␀␀CREATE PROCEDURE sp_datetonumber(@p_DATE DATETIME, @p_result FLOAT OUTPUT) AS
BEGIN
DECLARE @data FLOAT
DECLARE @hora FLOAT
  DECLARE @ChkError INTEGER
  SELECT @ChkError = 0
  SELECT @p_result = 0
  SELECT @DATA = ROUND((CONVERT(NUMERIC, @p_DATE - CONVERT(DATETIME,CONVERT(VARCHAR,12)+'/'+CONVERT(VARCHAR,30)+'/'+CONVERT(VARCHAR,1899)+' '+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)))), 0, 1)
  SELECT @HORA = ((DATEPART(HOUR,@p_DATE)*60.0+DATEPART(MINUTE,@p_DATE))/1440.0)
  SELECT @p_result = @DATA+@HORA
  BEGIN
    RETURN @ChkError
  END
FIM:
  RETURN @ChkError
END


	MSSQL;23
d␀␀CREATE PROCEDURE sp_datetonumber(@p_DATE DATETIME, @p_result FLOAT OUTPUT) AS
BEGIN
DECLARE @data FLOAT
DECLARE @hora FLOAT
  DECLARE @ChkError INTEGER
  SELECT @ChkError = 0
  SELECT @p_result = 0
  SELECT @DATA = ROUND((CONVERT(NUMERIC, @p_DATE - CONVERT(DATETIME,CONVERT(VARCHAR,12)+'/'+CONVERT(VARCHAR,30)+'/'+CONVERT(VARCHAR,1899)+' '+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)))), 0, 1)
  SELECT @HORA = ((DATEPART(HOUR,@p_DATE)*60.0+DATEPART(MINUTE,@p_DATE))/1440.0)
  SELECT @p_result = @DATA+@HORA
  BEGIN
    RETURN @ChkError
  END
FIM:
  RETURN @ChkError
END


