␀␀TRIGGER R057CON_EI AFTER INSERT ON R057CON FOR EACH ROW

BEGIN
R057CON_CONBNF (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODBNF,
                  :NEW.DATINI,:NEW.HORINI,:NEW.QTDCON,:NEW.GERCON);
  /* SOMENTE ATUALIZA A TABELA DE BENEFICIOS SE INCLUIU O REGISTRO PELA TELA DO RONDA. */
  /* QUANDO A ORIGEM É DO COLETOR, SIGNIFICA QUE O PROPRIO RELOGIO JA DECREMENTOU O CREDITO. */
  IF  (:NEW.GERCON = 1)  THEN
      R057DIB_CRABEN('E',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODBNF,:NEW.QTDCON);
  END IF;
END␀M×␀␀		SENIOR;0a␀␀

TRIGGER R057CON_EU AFTER UPDATE ON R057CON FOR EACH ROW

DECLARE
l_qtdcon  NUMBER;
BEGIN
 IF  :OLD.QTDCON > 0 THEN
     l_qtdcon := :NEW.QTDCON - :OLD.QTDCON;
 ELSE
     l_qtdcon := :NEW.QTDCON;
 END IF;
 R057CON_CONBNF (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODBNF,
                 :NEW.DATINI,:NEW.HORINI,l_qtdcon,:NEW.GERCON);
END␀K×␀␀		SENIOR;0␀␀

TRIGGER R057CON_ED AFTER DELETE ON R057CON FOR EACH ROW

DECLARE
L_QTDREB NUMBER;
BEGIN
BEGIN
  SELECT QTDREB INTO L_QTDREB FROM R057DIB
   WHERE NUMEMP=:OLD.NUMEMP
     AND TIPCOL=:OLD.TIPCOL
     AND NUMCAD=:OLD.NUMCAD
     AND CODBNF=:OLD.CODBNF
     AND DATINI=:OLD.DATINI
     AND HORINI=:OLD.HORINI;
 EXCEPTION
    WHEN NO_DATA_FOUND THEN
        l_QTDREB := 0;
 END;
 IF :OLD.QTDCON > L_QTDREB THEN
     UPDATE R057DIB  SET QTDREB=0
      WHERE NUMEMP=:OLD.NUMEMP
        AND TIPCOL=:OLD.TIPCOL
        AND NUMCAD=:OLD.NUMCAD
        AND CODBNF=:OLD.CODBNF
        AND DATINI=:OLD.DATINI
        AND HORINI=:OLD.HORINI;
 ELSIF :OLD.QTDCON <= L_QTDREB THEN
     UPDATE R057DIB  SET QTDREB=QTDREB-:OLD.QTDCON
      WHERE NUMEMP=:OLD.NUMEMP
        AND TIPCOL=:OLD.TIPCOL
        AND NUMCAD=:OLD.NUMCAD
        AND CODBNF=:OLD.CODBNF
        AND DATINI=:OLD.DATINI
        AND HORINI=:OLD.HORINI;
 END IF;

R057DIB_CRABEN('I',:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.CODBNF,:OLD.QTDCON);
END␀␀␀ä4␀␀␀␀␀␀␀␀␀␀␀␀␀N×␀␀…¬␀␀´␀	␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀$0.0.w␀Æÿ␀␀…Ó␀␀␀1EÑ␀	␀␀␀␀␀¯IH¯IqC␀êÿ␀␀ÿ␀¸w·␀	␀␀␀␀␀y£x£xì*␀␀Æÿ␀␀ÿ␀œı␀␀­␀	␀␀␀␀␀£ÿ␀␀xş␀␀xş␀␀p␀Æÿ␀␀ÿ␀u¬␀␀–␀␀␀␀␀␀>±␀␀)8)8n
