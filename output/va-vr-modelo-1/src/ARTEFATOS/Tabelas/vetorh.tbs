FROM R046PRV PRV, R250TAB TAB, R038HCC HCC
WHERE 
  PRV.MESANO = TAB.INIPER AND HCC.NUMEMP = PRV.NUMEMP AND HCC.TIPCOL = PRV.TIPCOL AND
  HCC.NUMCAD = PRV.NUMCAD AND 
  HCC.DATALT = (SELECT MAX(HCC2.DATALT) FROM R038HCC HCC2 
                WHERE HCC2.NUMEMP = PRV.NUMEMP AND HCC2.TIPCOL = PRV.TIPCOL AND 
                HCC2.NUMCAD = PRV.NUMCAD AND HCC2.DATALT <= TAB.FIMPER)
