DECLARE
  l_ade_gerpen BOOLEAN;
  l_dsp_camera BOOLEAN;
  l_assapi     NUMBER(2);
BEGIN
    SP_VERCAM(:NEW.CODDSP, l_dsp_camera OUT);
    IF (l_dsp_camera = FALSE) THEN
        l_assapi := 61; /* Dispositivos de acesso */
    ELSE
        l_assapi := 62; /* Câmeras */
    END IF;

    SP_RECALF_GERPEN(l_assapi, l_ade_gerpen OUT);
    IF (l_ade_gerpen = TRUE) THEN
        SP_PENDADE_IND('I', :NEW.CODDSP, :NEW.DATIND, :NEW.HORIND, NULL);
    END IF;
END␀¼×␀␀		SENIOR;0>␀␀

TRIGGER R058IND_EU AFTER UPDATE ON R058IND FOR EACH ROW
DECLARE
  l_ade_gerpen BOOLEAN;
  l_dsp_camera BOOLEAN;
  l_assapi     NUMBER(2);
BEGIN
    SP_VERCAM(:NEW.CODDSP, l_dsp_camera OUT);
    IF (l_dsp_camera = FALSE) THEN
        l_assapi := 61; /* Dispositivos de acesso */
    ELSE
        l_assapi := 62; /* Câmeras */
    END IF;

    SP_RECALF_GERPEN(l_assapi, l_ade_gerpen OUT);
    IF (l_ade_gerpen = TRUE) THEN
        IF (:NEW.PROTCL IS NULL OR (:OLD.PROTCL IS NOT NULL AND :OLD.PROTCL = :NEW.PROTCL)) THEN
            IF (:OLD.DATRET IS NULL AND :NEW.DATRET IS NOT NULL) THEN
                SP_PENDADE_IND('I', :NEW.CODDSP, :NEW.DATIND, :NEW.HORIND, NULL);
            ELSE
                SP_PENDADE_IND('R', :NEW.CODDSP, :NEW.DATIND, :NEW.HORIND, :OLD.PROTCL);
            END IF;
        END IF;
    END IF;
END␀º×␀␀		SENIOR;0␀␀

TRIGGER R058IND_ED AFTER DELETE ON R058IND FOR EACH ROW
DECLARE
  l_ade_gerpen BOOLEAN;
  l_dsp_camera BOOLEAN;
  l_assapi     NUMBER(2);
BEGIN
    SP_VERCAM(:OLD.CODDSP, l_dsp_camera OUT);
    IF (l_dsp_camera = FALSE) THEN
        l_assapi := 61; /* Dispositivos de acesso */
    ELSE
        l_assapi := 62; /* Câmeras */
    END IF;

    SP_RECALF_GERPEN(l_assapi, l_ade_gerpen OUT);
    IF (l_ade_gerpen = TRUE) THEN
        SP_PENDADE_IND('E', :OLD.CODDSP, :OLD.DATIND, :OLD.HORIND, :OLD.PROTCL);
    END IF;
END␀␀␀Å␀␀␀␀␀␀␀␀␀␀␀␀½×␀␀u¬␀␀–␀	„␀␀␀␀␀D±␀␀)8)8n␀Æÿ␀␀ÿ␀M¶␀␀õ„␀␀␀␀␀ø¶␀␀‘¶␀␀Á¶␀␀n␀Æÿ␀␀ÿ␀EÑ␀„␀␀␀␀␀IRGRGqC␀êÿ␀␀ÿ␀×-‹␀„␀␀␀␀␀°Am␀m␀—)␀␀Æÿ␀␀ÿ␀␀␀␀0␀␀š␀␀␀␀␀␀␀¾×␀␀×,±␀	␀␀␀␀␀␀İ@×@×@q␀Æÿ␀␀À×␀␀␀:ı␀␀±␀	␀␀␀␀␀␀ÿ␀␀xş␀␀xş␀␀q␀Æÿ␀␀ÿ␀5-·␀␀␀␀␀␀␀\A“␀“␀s␀Æÿ␀␀ë×␀␀␀x-·␀␀␀␀␀␀␀@¥.¥.u␀Æÿ␀␀Ø␀␀␀I,æ␀␀␀␀␀␀-@ê:-@q␀Æÿ␀␀ÿ␀‚º␀␀␀␀␀␀␀␀o»␀␀n»␀␀n»␀␀#␀␀ÿ␀␀ÿ␀m,Ì␀␀␀␀␀␀␀N@¤:¤:{␀Æÿ␀␀…×␀␀␀␀␀␀0;1␀␀˜$␀␀␀␀␀␀␀␀¿×␀␀×,±␀	„␀␀␀␀␀␀İ@×@×@q␀Æÿ␀␀À×␀␀␀ÏTE„␀␀␀␀␀␀Y°V°VG␀␀ÿ␀␀ÿ␀␀␀␀0␀␀ô$␀␀␀Á×␀␀m,Ì␀	␀␀␀␀␀␀N@¤:¤:{␀Æÿ␀␀Â×␀␀␀\ ␀␀±␀␀␀␀␀␀␀&¡␀␀&¡␀␀&¡␀␀q␀Æÿ␀␀ÿ␀˜␀␀␀␀␀␀␀␀¼␀´␀␀n␀Æÿ␀␀ÿ␀fš␀␀!␀␀␀␀␀␀ıš␀␀ıš␀␀ıš␀␀p␀Æÿ␀␀ÿ␀¦q=␀␀␀␀␀␀Å%␀Å%␀Å%␀c␀␀␀ÿ␀␀ÿ␀¥qª␀␀␀␀␀␀Ä%␀Ä%␀Ä%␀n␀Æÿ␀␀ÿ␀¦%␀=␀␀␀␀␀␀Ğ%␀Ï%␀Ï%␀c␀␀␀ÿ␀␀ÿ␀‚%␀=␀␀␀␀␀␀»%␀»%␀»%␀c␀␀␀ÿ␀␀ÿ␀®%␀=␀␀␀␀␀␀Ş%␀Ş%␀Ş%␀c␀␀␀ÿ␀␀ÿ␀%␀~	␀␀␀␀␀␀Ã%␀Â%␀Â%␀n␀Æÿ␀␀ÿ␀¢%␀=␀␀␀␀␀␀Î%␀Î%␀Î%␀c␀␀␀ÿ␀␀ÿ␀’%␀=␀␀␀␀␀␀½%␀½%␀½%␀c␀␀␀ÿ␀␀ÿ␀—1=␀␀␀␀␀␀t6t6t6c␀␀␀ÿ␀␀ÿ␀¦ =␀␀␀␀␀␀ù ù ù c␀␀␀ÿ␀␀ÿ␀%␀=␀␀␀␀␀␀Ì%␀Ì%␀Ì%␀c␀␀␀ÿ␀␀ÿ␀%␀=␀␀␀␀␀␀Ë%␀Ë%␀Ë%␀c␀␀␀ÿ␀␀ÿ␀§1=␀␀␀␀␀␀r6r6r6c␀␀␀ÿ␀␀ÿ␀¬%␀ˆ	␀␀␀␀␀␀×%␀×%␀×%␀n␀Æÿ␀␀ÿ␀q␀¼␀␀␀␀␀␀­␀­␀­␀n␀Æÿ␀␀ÿ␀q␀=␀␀␀␀␀␀␀␀␀c␀␀␀ÿ␀␀ÿ␀Ú¦␀␀­␀␀␀␀␀␀␀¯␀␀¯␀␀¯␀␀p␀Æÿ␀␀ÿ␀Å¦␀␀­␀␀␀␀␀␀␀ø®␀␀÷®␀␀÷®␀␀p␀Æÿ␀␀ÿ␀ù␀O␀␀␀␀␀␀ù␀ù␀ù␀N␀␀ÿ␀␀ÿ␀R]­␀␀␀␀␀␀ª]ª]ª