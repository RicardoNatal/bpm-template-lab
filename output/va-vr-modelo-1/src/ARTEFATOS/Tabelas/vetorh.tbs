ğ/*
Return Value on Function Acesso_Release

0 success
3 parameter error
4 do not own lock specified by ID or LOCKHANDLE
5 illegal lock handle
*/
PROCEDURE Acesso_Release(SEQUENCIA NUMBER,RETORNO OUT NUMBER)
 IS
BEGIN
  NULL;
END		ORACLE;20
L␀␀/*
Return Value on Function Acesso_Release

0 success
3 parameter error
4 do not own lock specified by ID or LOCKHANDLE
5 illegal lock handle
*/

CREATE  OR REPLACE PROCEDURE Acesso_Release (sequencia in NUMBER, retorno OUT NUMBER)
IS
BEGIN
   retorno := sys.dbms_lock.release (sequencia);
END Acesso_Release;




␀¡ÿÿÿÿÿÿÿÿ	SENIOR;0
WPROCEDURE Acesso_Request(SEQUENCIA NUMBER,RETORNO OUT NUMBER)
 IS
BEGIN
  NULL;
END		ORACLE;20
j␀␀/*
Return Value on Function Acesso_Request

0 success
1 timeout
2 deadlock
3 parameter error
4 already own lock specified by ID or LOCKHANDLE
5 illegal lock handle
*/

CREATE OR REPLACE PROCEDURE Acesso_Request (sequencia in NUMBER, retorno OUT NUMBER)
IS
BEGIN
   retorno := sys.dbms_lock.request (sequencia, 6, 0, FALSE);
END Acesso_Request;

␀³ÿÿÿÿÿÿÿÿ	SENIOR;0
­/* Efetua Request ou Release */
PROCEDURE ACREQREL(P_TIPO NUMBER,P_SEQUENCIA NUMBER)
 IS

l_retorno       NUMBER;
  l_hora_inicio   DATE;
BEGIN
  l_retorno := 0;
END		ORACLE;20
ü␀␀CREATE OR REPLACE PROCEDURE ACREQREL(P_TIPO NUMBER, P_SEQUENCIA NUMBER) IS
  l_retorno     NUMBER;
  l_hora_inicio DATE;
  l_msg         VARCHAR2(255);
begin
  if NOT p_sequencia IS NULL then
    l_retorno     := -1;
    l_hora_inicio := TO_DATE(TO_CHAR(GETDBDATETIME, 'DD/MM/YYYY'),
                             'DD/MM/YYYY');
    loop
      if (p_tipo = 1) then
        l_retorno := DBMS_LOCK.REQUEST(p_sequencia, 6, 0, FALSE);
      elsif p_tipo = 2 then
        l_retorno := DBMS_LOCK.RELEASE(p_sequencia);
      end if;
      if (l_retorno = 0) OR
         ((TO_DATE(TO_CHAR(GETDBDATETIME, 'DD/MM/YYYY'), 'DD/MM/YYYY') -
         l_hora_inicio) > (1 / 24 / 60 / 60 * 5)) then
        EXIT;
      end if;
    end loop;
    if l_retorno <> 0 then
      if (p_tipo = 1) then
        l_msg := 'Erro no Bloqueio da Sequencia: ';
        if l_retorno = 1 then
          l_msg := l_msg || 'timeout';
        elsif l_retorno = 2 then
          l_msg := l_msg || 'deadlock';
        elsif l_retorno = 3 then
          l_msg := l_msg || 'parameter error';
        elsif l_retorno = 4 then
          l_msg := l_msg ||
                   'already own lock specified by ID OR LOCKHANDLE';
        elsif l_retorno = 5 then
          l_msg := l_msg || 'illegal lock handle';
        else
          l_msg := l_msg || 'unknown error code =' || to_char(l_retorno);
        end if;
      elsif p_tipo = 2 then
        l_msg := 'Erro no Desbloqueio da Sequencia: ';
        if l_retorno = 3 then
          l_msg := l_msg || 'parameter error';
        elsif l_retorno = 4 then
          l_msg := l_msg ||
                   'already own lock specified by ID OR LOCKHANDLE';
        elsif l_retorno = 5 then
          l_msg := l_msg || 'illegal lock handle';
        else
          l_msg := l_msg || 'unknown error code =' || to_char(l_retorno);
        end if;
      end if;
      l_msg := l_msg || ' seq= ' || to_char(p_sequencia);
      raise_application_error(-20103, l_msg);
    end if;
  end if;
end;	MSSQL;23
Ì␀␀CREATE  PROCEDURE AcReqRel(@p_tipo FLOAT, @p_numcra CHAR(12)) AS
BEGIN
  DECLARE @l_usutel VARCHAR(21)
  DECLARE @l_comando VARCHAR(1024)
  DECLARE @ChkError INTEGER
  SELECT @ChkError = 0

  EXECUTE  @ChkError = SP_USUTEL @l_usutel OUTPUT
  
  IF (@p_tipo=1)
  BEGIN
    SELECT @l_comando = @l_usutel+'Request_Lock ' + @p_numcra + ',''101'''
    EXECUTE  @ChkError = SP_CMDTSI @l_comando
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  ELSE IF @p_tipo=2
  BEGIN
    SELECT @l_comando = @l_usutel+'Release_Lock ' + @p_numcra + ',''101'''
    EXECUTE  @ChkError = SP_CMDTSI @l_comando
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
FIM:
  RETURN @ChkError
END␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
