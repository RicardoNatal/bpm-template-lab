  END
FIM:
  RETURN @ChkError
END

␀$ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0(SP_DATAHORA
SP_DATSTR
SP_MILLISECOND
␀␀PROCEDURE SP_ESOCIAL_1050(P_EMPRESA NUMBER, P_TABELA VARCHAR2(7), P_OPERACAO VARCHAR(1), P_VALOR VARCHAR2(2000), P_VALOR2 VARCHAR2(2000), P_USUARIO NUMBER(10), P_ORIGEM VARCHAR2(60))
 IS

l_CargaInicialFeita BOOLEAN;
  l_Cie NUMBER;
  l_DataStr VARCHAR2(8);
  l_HoraStr VARCHAR2(2);
  l_MinutoStr VARCHAR2(2);
  l_SegundoStr VARCHAR2(2);
  l_Milisegundo NUMBER;
  l_MilisegundoStr VARCHAR2(2);  
  l_Contador NUMBER(2);
  l_ContadorStr VARCHAR2(2);
  l_ChaveExiste VARCHAR2(1);
  l_DataHoraAtual NUMBER(14,6);
  l_PidPen VARCHAR2(25);
  l_DataReferencia DATE;
  l_Usuario NUMBER(10);
  l_NomeUsuario VARCHAR2(40);
BEGIN
  l_CargaInicialFeita := TRUE;
  l_HoraStr := CONVERT(NUMBER_TO_CHAR, HOUR(CURTIME()));
  l_MinutoStr := CONVERT(NUMBER_TO_CHAR, MINUTE(CURTIME()));
  l_ChaveExiste := NULL;
  l_Contador := 1;
  l_DataReferencia := DATETIME(DAYOFMONTH(CURDATE()), MONTH(CURDATE()), YEAR(CURDATE()), 0, 0, 0);
  BEGIN
    SELECT 1 INTO l_Cie
      FROM R350STA STA, R350EMP EMP
     WHERE EMP.NUMEMP = p_Empresa
       AND EMP.PIDEXC = STA.PIDEXC
	   AND (STA.NUMREC IS NOT NULL AND LTRIM(RTRIM(STA.NUMREC)) || 'VAZIO' <> 'VAZIO')
       AND EMP.INIVAL <= l_DataReferencia;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_CargaInicialFeita := FALSE;
      WHEN TOO_MANY_ROWS THEN
        l_CargaInicialFeita := TRUE;
  END;
  
  l_Usuario := 0;
  IF (p_Usuario = 0) THEN
     SP_GETCODUSU(l_Usuario OUT, l_nomeUsuario OUT);
  ELSE
     l_Usuario := p_Usuario;
  END IF;
  
  IF (l_CargaInicialFeita = TRUE) THEN
    SP_DATAHORA(l_DataHoraAtual OUT, 'DH');
    SP_DATSTR(l_DataReferencia, 'YYYYMMDD', l_DataStr OUT);
    IF (LENGTH(l_HoraStr)) = 1 THEN
      l_HoraStr := '0' || l_HoraStr;
    END IF;
    IF (LENGTH(l_MinutoStr)) = 1 THEN
      l_MinutoStr := '0' || l_MinutoStr;
    END IF;
    WHILE ((l_ChaveExiste = 'S') OR (l_ChaveExiste IS NULL)) LOOP
      l_SegundoStr := CONVERT(NUMBER_TO_CHAR, SECOND(CURTIME()));
      IF (LENGTH(l_SegundoStr)) = 1 THEN
        l_SegundoStr := '0' || l_SegundoStr;
      END IF;
      SP_MILLISECOND(l_Milisegundo OUT, 2);
      l_MilisegundoStr := CONVERT(NUMBER_TO_CHAR, l_Milisegundo);
      IF (LENGTH(l_MilisegundoStr)) = 1 THEN
        l_MilisegundoStr := '0' || l_MilisegundoStr;
      END IF;
      l_ContadorStr := CONVERT(NUMBER_TO_CHAR, l_Contador);
      IF (LENGTH(l_ContadorStr)) = 1 THEN
        l_ContadorStr := '0' || l_ContadorStr;
      END IF;
      l_PidPen := p_Tabela || l_DataStr || l_HoraStr || l_MinutoStr || l_SegundoStr || l_MilisegundoStr || l_ContadorStr;
      BEGIN
        SELECT 'S' INTO l_ChaveExiste
        FROM R350PHO 
        WHERE PIDPEN = l_PidPen;
        IF (l_ChaveExiste = 'S') THEN
          l_Contador := l_Contador + 1;
        ELSE
          l_ChaveExiste := 'N';
        END IF;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_ChaveExiste := 'N';
      END;
    END LOOP;
    BEGIN
      INSERT INTO R350PHO (PIDPEN, NUMEMP, DATHOR, TABPEN, OPEPEN, UsuPen, VLRPEN, VLRPE2, ORIPEN)
      VALUES (l_PidPen, p_Empresa, l_DataHoraAtual, p_Tabela, p_Operacao, l_Usuario, p_Valor, p_Valor2 , p_Origem);
    EXCEPTION
      WHEN DUPVALONINDEX THEN
        RAISERROR 103 'Erro ao inserir registro duplicado na tabela de Pendências eSocial.';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao inserir registro na tabela de Pendências eSocial.';
    END;
  END IF;
END␀%ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;07SP_CONCATENAR_NUM
SP_CONCATENAR_DAT
SP_ESOCIAL_1050
›␀␀PROCEDURE SP_ESOCIAL_ESCALA(P_CODESC NUMBER, P_DATAREFERENCIA DATE, P_TABELA VARCHAR2(7),P_OPERACAO VARCHAR(1))
 IS

  l_Empresa NUMBER;
  CURSOR c_Empresa IS
    SELECT NUMEMP
    FROM R030EMP
    WHERE EXISTS (SELECT 1 FROM R038HES WHERE R038HES.NUMEMP = R030EMP.NUMEMP AND R038HES.CODESC = P_CODESC)     
    ORDER BY NUMEMP;
  l_Valor VARCHAR2(2000);
BEGIN

  l_Valor := '';
  SP_CONCATENAR_NUM('CODESC',P_CODESC, l_Valor OUT);
  SP_CONCATENAR_DAT('DATALT', P_DATAREFERENCIA, l_Valor OUT);

  FOREACH c_Empresa INTO l_Empresa
  LOOP
    SP_ESOCIAL_1050(l_Empresa, P_TABELA, P_OPERACAO, l_Valor , '' , 0, 'SP_ESOCIAL_ESCALA');
  END LOOP;

END␀&ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Ä␀␀PROCEDURE SP_ESOCIAL_INFO(P_NUMEMP NUMBER(4), P_INFFAC OUT BOOLEAN, P_SIMESO OUT BOOLEAN, P_VERSAO_ESOCIAL OUT NUMBER)
 IS

  l_inffac   R030DES.INFFAC%TYPE;
  l_TipAmb   R030DES.TIPAMB%TYPE;
  alfmen   VARCHAR2(255);
  l_DataAtual DATE;
  l_IniS13 DATE;
  l_FimS13 DATE;
  l_DataComparar DATE;

BEGIN
  l_DataAtual := CURDATE();
  P_INFFAC := TRUE;
  P_SIMESO := TRUE;
  l_inffac := 0;

  BEGIN
    SELECT R030DES.INFFAC, R030DES.TIPAMB, R030DES.INIS13
      INTO l_inffac, l_TipAmb, l_IniS13
      FROM R030DES
     WHERE R030DES.NUMEMP = p_numemp;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
       l_inffac := 0;
    WHEN OTHERS THEN
      ALFMEN := 'Erro no SELECT em R030DES.';
      RAISERROR 103 alfmen;
  END;

  IF (l_inffac = 2) THEN
      P_INFFAC := FALSE;
  END IF;

  BEGIN
    SELECT FIMS13 INTO l_FimS13
      FROM R030DAT
     WHERE GRUESO = 0;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      ALFMEN := 'Erro no SELECT em R030DAT.';
      RAISERROR 103 alfmen;
  END;

  /* Para clientes que tem problema com o atualizador, se não inicializou a data, usa a fixa */
  IF ((l_FimS13 IS NULL) OR (l_FimS13 = DATETIME(31, 12, 1900, 0, 0, 0))) THEN
    l_FimS13 := DATETIME(2, 12, 2024, 0, 0, 0);
  END IF;
  
  IF ((l_IniS13 IS NOT NULL) AND (l_IniS13 > DATETIME(31, 12, 1900, 0, 0, 0)) ) THEN
     l_DataComparar := l_IniS13;
  ELSE
     IF (l_TipAmb = 1) THEN
        l_DataComparar := l_FimS13 + 1;
     ELSE
        l_DataComparar := l_DataAtual;
     END IF;
  END IF;
  
  /* Conforme enumeração VersaoEsocial */
  IF (l_DataAtual >= l_DataComparar) THEN
    P_VERSAO_ESOCIAL := 7;  /*S-1.3*/
  ELSE
    P_VERSAO_ESOCIAL := 6;  /*S-1.2*/
  END IF;

END␀'ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
}␀␀PROCEDURE SP_ESOCIAL_R000ESO(P_TIPAMB NUMBER(1), P_GRUESO NUMBER(1), P_TIPDAT NUMBER(2), P_DATESO OUT DATE)
 IS

  l_DataEsocial DATE;
  alfmen   VARCHAR2(255);

BEGIN

  l_DataEsocial := DATETIME(31, 12, 1900, 0, 0, 0);

  BEGIN
    SELECT R000ESO.DATESO
      INTO l_DataEsocial
      FROM R000ESO
     WHERE R000ESO.TIPAMB = P_TIPAMB AND
           R000ESO.GRUESO = P_GRUESO AND
           R000ESO.TIPDAT = P_TIPDAT; /* conforme enumeração LTipDatEso */
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      ALFMEN := 'Erro no SELECT em R000ESO.';
      RAISERROR 103 alfmen;
  END;

  P_DATESO := l_DataEsocial;

END␀(ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
°␀␀PROCEDURE SP_ESOCIAL_S250X (P_NUMEMP NUMBER(4), P_DATREF DATE, P_VERSAO_ESOCIAL OUT NUMBER)
IS

  l_TipAmb   R030DES.TIPAMB%TYPE;  
  l_IniS13 DATE;
  l_In13Ex DATE;
  l_FimS13 DATE;
  alfmen VARCHAR2(255);
  l_DataAtual DATE;
BEGIN   
  l_DataAtual := CURDATE();
  
  BEGIN
    SELECT R030DES.TipAmb, R030DES.IniS13
      INTO l_TipAmb, l_IniS13
      FROM R030DES
     WHERE R030DES.NUMEMP = p_numemp;
  EXCEPTION         
    WHEN NO_DATA_FOUND THEN
      ALFMEN := 'Erro no SELECT em R030DES.';
      RAISERROR 103 alfmen;
  END;
    
  /* 1 - Produção      */
  IF (l_TipAmb = 1) THEN
    P_VERSAO_ESOCIAL := 6; /* 1.2 */
  
  	/* Possui Data Início 1.3 informada nas Definições eSocial                       */
  	IF ((l_IniS13 IS NOT NULL) AND (l_IniS13 > DATETIME(31, 12, 1900, 0, 0, 0))) THEN
  	  IF (l_DataAtual >= l_IniS13) THEN
  	    P_VERSAO_ESOCIAL := 7; /* 1.3 */
  	  END IF;
  	ELSE /* Não possui Data Início 1.3 informada nas Definições eSocial, então verifica datas da R030DAT */
    BEGIN
      SELECT FimS13, In13Ex
        INTO l_FimS13, l_In13Ex
        FROM R030DAT
       WHERE GRUESO = 0;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        ALFMEN := 'Erro no SELECT em R030DAT.';
        RAISERROR 103 alfmen;
    END;

    /* Para clientes que tem problema com o atualizador, se não inicializou a data, usa a fixa */
    IF ((l_FimS13 IS NULL ) OR (l_FimS13 = DATETIME(31, 12, 1900, 0, 0, 0))) THEN
      l_FimS13 := DATETIME(2, 12, 2024, 0, 0, 0);
    END IF;

    /* Para clientes que tem problema com o atualizador, se não inicializou a data, usa a fixa */
    IF ((l_In13Ex IS NULL) OR (l_In13Ex = DATETIME(31, 12, 1900, 0, 0, 0))) THEN
      l_In13Ex := DATETIME(1, 1, 2025, 0, 0, 0);
    END IF;

    IF ((l_DataAtual > l_FimS13) OR (P_DATREF >= l_In13Ex)) THEN
      P_VERSAO_ESOCIAL := 7; /* 1.3 */
    END IF;
  END IF;
    
  ELSE /* 2 - Produção Restrita */
  	P_VERSAO_ESOCIAL := 7; /* 1.3 */
  	
    IF ((l_IniS13 IS NOT NULL) AND (l_IniS13 > DATETIME(31, 12, 1900, 0, 0, 0))) THEN
      IF (l_DataAtual < l_IniS13) THEN
        P_VERSAO_ESOCIAL := 6; /* 1.2 */
      END IF;  
    END IF;
    
  END IF;  

END␀)ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
w␀␀PROCEDURE SP_ESPSTR(P_STR VARCHAR2(255), P_TAM NUMBER(3,0), P_RET OUT VARCHAR2(255))
 IS

 l_ret VARCHAR2(255);
BEGIN
  IF (P_STR IS NULL) THEN
    l_ret := ' ';
  ELSE
    l_ret := p_str;
  END IF;

  LOOP
    /*Controle do Loop.*/
    IF (LENGTH(l_ret) >= p_tam) THEN
      EXIT;
    END IF;
    l_ret := ' ' || l_ret;
  END LOOP;

  p_ret := l_ret;
END␀*ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
