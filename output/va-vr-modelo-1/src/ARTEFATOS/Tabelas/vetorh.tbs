  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Indicação para os Módulos (Tabela: R034MDL)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 89;     /* Indicação para os Módulos (Tabela: R034MDL)*/
  l_codtpa := 289;
 
   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
