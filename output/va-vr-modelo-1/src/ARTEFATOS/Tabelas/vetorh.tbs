/* Trigger Insert - Statement */
TRIGGER R350PEN_SI AFTER INSERT ON R350PEN
DECLARE
  /* CURSOR c/ os registros gravados na r350en_aux */
  CURSOR c_r350pen_aux_ins IS SELECT PIDPEN, DATHOR, TABPEN, OPEPEN, EVEPEN, USUPEN, NUMEMP, FILEMP, TIPCOL, NUMCAD, INIVAL, FIMVAL, VLRPE1, VLRPE2, LAYOUT, DATENC, DATREF, PENEXT, ORIPEN FROM R350PEN_AUX;
  
  TYPE t_r350pen_aux IS RECORD(
    PIDPEN   R350PEN_AUX.PIDPEN%TYPE,
    DATHOR   R350PEN_AUX.DATHOR%TYPE,
    TABPEN   R350PEN_AUX.TABPEN%TYPE,
    OPEPEN   R350PEN_AUX.OPEPEN%TYPE,
    EVEPEN   R350PEN_AUX.EVEPEN%TYPE,
    USUPEN   R350PEN_AUX.USUPEN%TYPE,
    NUMEMP   R350PEN_AUX.NUMEMP%TYPE,
    FILEMP   R350PEN_AUX.FILEMP%TYPE, 
	TIPCOL   R350PEN_AUX.TIPCOL%TYPE,
	NUMCAD   R350PEN_AUX.NUMCAD%TYPE,
	INIVAL   R350PEN_AUX.INIVAL%TYPE,
	FIMVAL   R350PEN_AUX.FIMVAL%TYPE,
	VLRPE1   R350PEN_AUX.VLRPE1%TYPE,
	VLRPE2   R350PEN_AUX.VLRPE2%TYPE,
	LAYOUT   R350PEN_AUX.LAYOUT%TYPE,
	DATENC   R350PEN_AUX.DATENC%TYPE,
	DATREF   R350PEN_AUX.DATREF%TYPE,
	PENEXT   R350PEN_AUX.PENEXT%TYPE,
	ORIPEN   R350PEN_AUX.ORIPEN%TYPE);

  l_r350pen_aux 						t_r350pen_aux;
  l_DataFechamentoTreinamento 			DATE;
  l_DataAdmissaoColaboradorSemMatricula DATE;
  l_DataInicioTabelas 					DATE;
  l_DataInicioEsocial 					DATE;
  l_DataInicioNaoPeriodicos 			DATE;
  l_DataInicioPeriodicos 				DATE;
  l_DataInicioSST 						DATE;
  l_DataInicioMigracao					DATE;  
  l_statusMigracao				     	INTEGER;
  l_exists_matricula					NUMBER;
  l_DataZero DATE;
  
BEGIN
  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  FOREACH c_r350pen_aux_ins INTO l_r350pen_aux.PIDPEN,
    							 l_r350pen_aux.DATHOR,
    							 l_r350pen_aux.TABPEN,
    							 l_r350pen_aux.OPEPEN,
    							 l_r350pen_aux.EVEPEN,
    							 l_r350pen_aux.USUPEN,
    							 l_r350pen_aux.NUMEMP,
    							 l_r350pen_aux.FILEMP, 
    							 l_r350pen_aux.TipCol,
    							 l_r350pen_aux.NumCad,
    							 l_r350pen_aux.IniVal,
    							 l_r350pen_aux.FimVal,
    							 l_r350pen_aux.VlrPe1,
    							 l_r350pen_aux.VlrPe2,
    							 l_r350pen_aux.LayOut,
    							 l_r350pen_aux.DatEnc,
    							 l_r350pen_aux.DatRef,
    							 l_r350pen_aux.PenExt,
    							 l_r350pen_aux.OriPen
  LOOP
		IF (((l_r350pen_aux.TABPEN <> 'R034MAT') AND (l_r350pen_aux.NUMCAD > 0)) OR l_r350pen_aux.LayOut = 'S-2190') THEN
			SELECT IFNULL(MAX(stamig), 0), IFNULL(MAX(1), 0) INTO l_statusMigracao, l_exists_matricula FROM R034MAT WHERE NumEmp = l_r350pen_aux.NumEmp AND tipCol = l_r350pen_aux.tipCol AND numcad = l_r350pen_aux.NumCad;
        			
    		IF (l_exists_matricula = 0) THEN
        		RH_RET_DATADM(l_r350pen_aux.NUMEMP, l_r350pen_aux.TIPCOL, l_r350pen_aux.NUMCAD, l_DataAdmissaoColaboradorSemMatricula OUT);
		  		RH_DEF_ESOCIAL(l_r350pen_aux.NUMEMP, l_DataInicioTabelas OUT, l_DataInicioEsocial OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
        	END IF;
        	
        	IF ((l_statusMigracao = 2) OR 
        		(l_exists_matricula = 0 AND 
        			(l_DataInicioMigracao IS NOT NULL) AND 
        			(l_DataInicioMigracao >  l_DataZero) AND 
        			(l_DataInicioMigracao < l_DataAdmissaoColaboradorSemMatricula)
        		)
        	) THEN
				BEGIN         
					INSERT INTO R350TMP(PidPen, DatHor, TabPen, OpePen, EvePen, UsuPen, NumEmp, FilEmp, TipCol, NumCad, IniVal, FimVal, VlrPe1, VlrPe2, LayOut, DatEnc, DatRef, PenExt, OriPen) 
					VALUES (l_r350pen_aux.PIDPEN, l_r350pen_aux.DATHOR, l_r350pen_aux.TABPEN, l_r350pen_aux.OPEPEN, l_r350pen_aux.EVEPEN, l_r350pen_aux.USUPEN, l_r350pen_aux.NUMEMP, l_r350pen_aux.FILEMP, l_r350pen_aux.TIPCOL, l_r350pen_aux.NUMCAD, l_r350pen_aux.INIVAL, l_r350pen_aux.FIMVAL, l_r350pen_aux.VLRPE1, l_r350pen_aux.VLRPE2, l_r350pen_aux.LAYOUT, l_r350pen_aux.DATENC, l_r350pen_aux.DATREF, l_r350pen_aux.PENEXT, l_r350pen_aux.ORIPEN);   
						    
					DELETE FROM R350PEN WHERE PIDPEN = l_r350pen_aux.PIDPEN;
				EXCEPTION WHEN OTHERS THEN
					RAISERROR 103 'Erro ao incluir registro na tabela de R350TMP.';
				END;			
	        END IF;
		END IF;
  END LOOP;
    
  /* Apaga Registro OLD/NEW em R350PEN_AUX */
  BEGIN  
  	DELETE FROM R350PEN_AUX;
    DROP_TEMP_TABLE R350PEN_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀¸è␀␀		SENIOR;0×␀␀TRIGGER R350PEN_EI AFTER INSERT ON R350PEN FOR EACH ROW
DECLARE
  /* Declaracao para criar tabela temporária em SQL Server - Erros de DeadLock */
  CREATE_TEMP_TABLE R350PEN_AUX;
  
BEGIN
	BEGIN
		INSERT INTO R350PEN_AUX(PidPen, DatHor, TabPen, OpePen, EvePen, UsuPen, NumEmp, FilEmp, TipCol, NumCad, IniVal, FimVal, VlrPe1, VlrPe2, LayOut, DatEnc, DatRef, PenExt, OriPen) 
		VALUES(:NEW.PIDPEN, :NEW.DATHOR, :NEW.TABPEN, :NEW.OPEPEN, :NEW.EVEPEN, :NEW.USUPEN, :NEW.NUMEMP, 0, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIVAL, :NEW.FIMVAL, :NEW.VLRPE1, :NEW.VLRPE2, :NEW.LAYOUT, :NEW.DATENC, :NEW.DATREF, :NEW.PENEXT, :NEW.ORIPEN);
	EXCEPTION WHEN OTHERS THEN
    	RAISERROR 103 'Erro no INSERT em R350PEN_AUX.';
  	END; 	
END␀·è␀␀		SENIOR;0Š
␀␀

TRIGGER R350PEN_ED AFTER DELETE ON R350PEN FOR EACH ROW
DECLARE
	l_Log	VARCHAR(1000);	
	l_LogData 	VARCHAR2(20);
	l_LogDatRef VARCHAR2(20);
	l_LogIniVal VARCHAR2(20);
    l_Usuario NUMBER(10);
    l_nomeUsuario VARCHAR2(40); 
    l_usu_temp VARCHAR2(40);
    l_NumSec NUMBER(14);
    l_Programa VARCHAR2(100);
    l_Maquina VARCHAR2(100);
    l_datstr CHAR(6);
    l_horstr CHAR(4);
    l_datcri DATE;
BEGIN
   /* Faz um backup de todos os leiaute S-3000 na exclusão das pendências. */
   IF (:OLD.LAYOUT = 'S-3000') THEN   
       BEGIN         
   			INSERT INTO R350PEB (PidPen, DatHor, TabPen, OpePen, EvePen, UsuPen, NumEmp, FilEmp, TipCol, NumCad, IniVal, FimVal, VlrPe1, VlrPe2, LayOut, DatEnc, DatRef, PenExt, OriPen) 
   						 VALUES (:OLD.PIDPEN, :OLD.DATHOR, :OLD.TABPEN, :OLD.OPEPEN, :OLD.EVEPEN, :OLD.USUPEN, :OLD.NUMEMP, :OLD.FILEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.INIVAL, :OLD.FIMVAL, :OLD.VLRPE1, :OLD.VLRPE2, :OLD.LAYOUT, :OLD.DATENC, :OLD.DATREF, :OLD.PENEXT, :OLD.ORIPEN);
   
       EXCEPTION
            WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao incluir registro na tabela de R350PEB.';
       END;
   END IF;
   /* Registra em log o leiaute S-2206 na exclusão das pendências Termino Contrato. */
   IF ((:OLD.LAYOUT = 'S-2206') AND (:OLD.TABPEN = 'R034CPL')) THEN   
       BEGIN         
   			SP_NUMBERTODATE(:OLD.DATHOR, l_datcri OUT);
   			SP_DATSTR(l_datcri, 'DD/MM/YYYY', l_LogData OUT);
			SP_DATSTR(:OLD.DATREF, 'DD/MM/YYYY', l_LogDatRef OUT);
			SP_DATSTR(:OLD.INIVAL, 'DD/MM/YYYY', l_LogIniVal OUT);

			l_NumSec := 0;
			l_Programa := '';
			l_Maquina := '';
			SP_GETSESSIONID(l_NumSec OUT, l_Programa OUT, l_Maquina OUT); 

			/* Retorna o código do usuário que está executando a ação */
			l_Usuario := 0;
			l_nomeUsuario := '';
			SP_GETCODUSU(l_Usuario OUT, l_nomeUsuario OUT); 

			IF (l_Usuario = 0) THEN
				l_usu_temp := '; Usuário: Não identificado';
			ELSE
				l_usu_temp := '; Usuário:' || CONVERT(NUMBER_TO_CHAR, l_Usuario) || '.' || l_nomeUsuario;
			END IF;
			
  	        l_Log := 'Excluído Pendência TERCON criada em ' || l_LogData || ' DatRef: ' || l_LogDatRef || ' IniVal: ' || l_LogIniVal
			    || ' Empresa '   || CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP) 
			    || ' TipCol '   || CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL) 
			    || ' Colab. ' || CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD)
			    || ' Origem Pend: ' || :OLD.ORIPEN 
			    || '; Maquina: ' || LTRIM(RTRIM(l_Maquina)) 
				|| '; Prog: ' || l_Programa  
				|| l_usu_temp;
			   			   			 			   
			/* LTipLPr 185 eSocial - Diversos" */
	        SP_GRAVALPR(185, l_Log);
	   END;     
   END IF;
   
END␀␀␀®*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀¶è␀␀4Â␀␀E	Ôÿ?␀␀␀␀␀ßŠ␀␀HŠ␀␀]Š␀␀G␀␀ÿ␀␀ÿ␀şD¡␀Ôÿ?␀␀␀␀␀¾M˜MŸMp␀Æÿ␀␀ÿ␀à␀uÔÿ?␀␀␀␀␀t␀␀␀q␀␀ÿ␀␀ÿ␀=µ␀␀␀Ôÿ?␀␀␀␀␀aµ␀␀Rµ␀␀Rµ␀␀+␀␀ÿ␀␀ÿ␀Dg␀Ôÿ?␀␀␀␀␀Ígªgªg+␀␀ÿ␀␀ÿ␀^␀‹␀Ôÿ?␀␀␀␀␀Î␀m␀‘A—)␀␀Æÿ␀␀ÿ␀…¬␀␀´␀Ôÿ?␀␀␀␀␀XbXbXbr␀Æÿ␀␀Ò␀␀␀Şm¼␀	Ôÿ?␀␀␀␀␀=/n/nX)␀␀␀Æÿ␀␀nk0.␀tÔÿ?␀␀␀␀␀␀Ü␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀Ôÿ?␀␀␀␀␀€$€$€$w␀Æÿ␀␀…Ó␀␀␀‘␀␀Ñ␀Ôÿ?␀␀␀␀␀_‘␀␀]‘␀␀]‘␀␀qC␀êÿ␀␀ÿ␀2oÑ␀Ôÿ?␀␀␀␀␀Ôn°n°nqC␀êÿ␀␀ÿ␀(␀*Ôÿ?␀␀␀␀␀DDD,␀␀ÿ␀␀ÿ␀(␀*Ôÿ?␀␀␀␀␀DDD,␀␀ÿ␀␀ÿ␀à—␀␀nÔÿ?␀␀␀␀␀&˜␀␀"˜␀␀"˜␀␀l␀␀ÿ␀␀ÿ␀ÆDÑ␀Ôÿ?␀␀␀␀␀çKÈJÈJqC␀êÿ␀␀ÿ␀…EÑ␀Ôÿ?␀␀␀␀␀‚LmKmKqC␀êÿ␀␀ÿ␀*¼␀␀=Ôÿ?␀␀␀␀␀Q¼␀␀B¼␀␀C¼␀␀c␀␀␀ÿ␀␀ÿ␀e¶␀␀oÔÿ?␀␀␀␀␀·␀␀ş¶␀␀ş¶␀␀i␀␀ÿ␀␀ÿ␀␀␀␀␀␀␀	­*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ºè␀␀à—␀␀ş	Ôÿ?ü␀␀␀␀'˜␀␀'˜␀␀'˜␀␀l␀␀ÿ␀␀ÿ␀D-Ì␀Ôÿ?ü␀␀␀␀Ğ>m:}={␀Æÿ␀␀ÿ␀pT9Ôÿ?ü␀␀␀␀$`"`#`:␀␀ÿ␀␀ÿ␀␀␀␀0␀␀±*␀␀␀␀␀»è␀␀4Â␀␀8	Ôÿ?␀␀␀␀␀ßŠ␀␀HŠ␀␀ßŠ␀␀?␀␀ÿ␀␀ÿ␀…¬␀␀´␀Ôÿ?␀␀␀␀␀XbXbXbr␀Æÿ␀␀Ò␀␀␀şD¡␀Ôÿ?␀␀␀␀␀¢MªM¢Mp␀Æÿ␀␀ÿ␀à␀uÔÿ?␀␀␀␀␀u␀!␀!␀q␀␀ÿ␀␀ÿ␀=µ␀␀␀Ôÿ?␀␀␀␀␀aµ␀␀_µ␀␀_µ␀␀+␀␀ÿ␀␀ÿ␀^␀‹␀Ôÿ?␀␀␀␀␀Î␀m␀‘A—)␀␀Æÿ␀␀ÿ␀(␀*Ôÿ?␀␀␀␀␀DDD,␀␀ÿ␀␀ÿ␀(␀*Ôÿ?␀␀␀␀␀DDD,␀␀ÿ␀␀ÿ␀e¶␀␀oÔÿ?␀␀␀␀␀ş¶␀␀ş¶␀␀ş¶␀␀i␀␀ÿ␀␀ÿ␀␀␀␀0␀␀¬*␀␀␀␀␀␀␀␀␀␀␀¼è␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀XbXbXbr␀Æÿ␀␀Ò␀␀␀Şm¼␀	Ôÿ?␀␀␀␀␀=/n/nX)␀␀␀Æÿ␀␀nk0í¼␀␀Ñ␀	Ôÿ?␀␀␀␀␀ìÀ␀␀ìÀ␀␀ìÀ␀␀œ␀␀␀êÿ␀␀|¸␀␀␀E␀␀¡	Ôÿ?␀␀␀␀␀‹␀␀ùŒ␀␀\␀␀n␀Æÿ␀␀$|␀şı␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ ÷␀␀␀İı␀␀Ì␀	Ôÿ?␀␀