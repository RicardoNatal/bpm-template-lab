             FAIPT5=l_fx_qui_p,FAIPT6=l_fx_sex_p,FAIPT7=l_fx_sab_p,
             FAIREF=l_fx_ref
      WHERE NUMFIS = l_crapri;
  EXCEPTION
      WHEN OTHERS THEN NULL;
