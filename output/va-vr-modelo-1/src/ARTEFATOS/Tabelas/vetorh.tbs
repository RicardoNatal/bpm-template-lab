PROCEDURE SP_PEND63(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9))
 IS

l_valstr        VARCHAR2(2047);
  l_data_atual    DATE;
  l_hora_atual    NUMBER(4);
  l_data_zero     DATE;
  l_dat_site      DATE;
  l_data_tse      DATE;
  l_data_aso      DATE;
  l_dat_site_str  CHAR(8);
  l_codplt_str    CHAR(5);
  l_seqenv        NUMBER(2);
  l_count         NUMBER(5);
  l_count_str     CHAR(5);
  l_datstr        CHAR(6);
  l_horstr        CHAR(4);
  l_seqstr        CHAR(2);
  l_datenv        CHAR(16);
  l_idtpes        VARCHAR2(23);
  l_tipcol_str    CHAR(1);
  l_tippes_str    CHAR(2);
  l_numemp_str    CHAR(4);
  l_numcad_str    CHAR(9);

  CURSOR C_R034PLA_PEND IS
          SELECT R034PLA.DATASO
               , R034PLA.DATTSE
               , R034PLA.BLOPLT
               , R034PLA.CODPLT
            FROM R034PLA R034PLA
           WHERE R034PLA.NUMEMP = p_numemp
             AND R034PLA.TIPCOL = p_tipcol
             AND R034PLA.NUMCAD = p_numcad
           ORDER BY 4;
           
  TYPE T_r034pla_pend IS RECORD (
                                  DATASO   R034PLA.DATASO%TYPE
                                 ,DATTSE   R034PLA.DATTSE%TYPE
                                 ,BLOPLT   R034PLA.BLOPLT%TYPE
                                 ,CODPLT   R034PLA.CODPLT%TYPE);

  l_r034pla_pend  T_r034pla_pEND;
BEGIN
  l_valstr := '';
  /*DATA ZERO*/
  SP_STRTODATE('31-12-1900', 'DD-MM-AAAA', l_data_zero OUT);
  l_count := 0;
  /*MONTA A DATA DO EVENTO*/
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

  /*MONTA O IDENTIFICADOR DA PESSOA*/
  SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
  SP_INTSTR(p_tipcol,'9',l_tipcol_str OUT);
  SP_INTSTR(p_numemp,'9999',l_numemp_str OUT);
  SP_INTSTR(p_numcad,'999999999',l_numcad_str OUT);
  l_idtpes:= l_tippes_str||l_numemp_str||l_tipcol_str||l_numcad_str;
  /*Preenche o campo com espaços para completar 23 posições*/
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
     /*Controle do Loop.*/
     IF (Length(l_idtpes) > 22) THEN
         EXIT;
     END IF;
     l_idtpes := ' '||l_idtpes;
  END LOOP;

  FOREACH C_R034PLA_PEND INTO
                             l_r034pla_pend.DATASO,
                             l_r034pla_pend.DATTSE,
                             l_r034pla_pend.BLOPLT,
                             l_r034pla_pend.CODPLT
  LOOP
    l_count := l_count + 1;

    /*VALIDA O BLOQUEIO NO SITE*/
    IF (l_r034pla_pend.BLOPLT = 'S') THEN
      /*01/01/1970 para bloquear a pessoa*/
      SP_STRTODATE('01-01-1970', 'DD/MM/AAAA', l_dat_site OUT);
    ELSE
      /*valida a menor data entre ASO e TSE*/
      IF (l_r034pla_pend.DATASO = l_data_zero) THEN
        SP_STRTODATE('31-12-2050', 'DD/MM/AAAA', l_data_aso OUT);
      ELSE
        l_data_aso := l_r034pla_pend.DATASO;
      END IF;
      IF (l_r034pla_pend.DATTSE = l_data_zero) THEN
        SP_STRTODATE('31-12-2050', 'DD/MM/AAAA', l_data_tse OUT);
      ELSE
        l_data_tse := l_r034pla_pend.DATTSE;
      END IF;

      IF (l_data_tse < l_data_aso) THEN
        l_dat_site := l_data_tse;
      ELSE
        l_dat_site := l_data_aso;
      END IF;

    END IF;

    SP_DATSTR(l_dat_site,'DDMMYYYY',l_dat_site_str OUT);
    SP_INTSTR(l_r034pla_pend.CODPLT,'99999',l_codplt_str OUT);

    /*VERIFICA SE EXCEDEU O LIMITE DE SITES*/
    IF (LENGTH(l_valstr) > 1991) THEN
       RAISERROR 103 'SP_PEND63: Excedeu o limite de validade por site.';
    ELSE
      l_valstr := l_valstr || l_codplt_str || l_dat_site_str;
    END IF;

  END LOOP;

  SP_INTSTR(l_count,'99999',l_count_str OUT);

  /*ADICIONA O CABEÇALHO DO COMANDO*/
  IF (l_count > 0) THEN
    l_valstr := '63' || l_datenv || l_idtpes || l_count_str || l_valstr;
  ELSE
    l_valstr := '63' || l_datenv || l_idtpes || l_count_str;
  END IF;
  
  /*GERA COMANDO PARA TODAS AS CONCENTRADORAS*/
  SP_PORCOM(l_valstr, '0');
END		SENIOR;21/SP_STRTODATE
SP_DATSTR
SP_INTSTR
SP_PORCOM
