		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSEQREG', CONVERT(NUMBER_TO_CHAR, :NEW.SEQREG));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHRTRCS', CONVERT(NUMBER_TO_CHAR, :OLD.HRTRCS));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHRTRCS', CONVERT(NUMBER_TO_CHAR, :NEW.HRTRCS));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODDOE', :OLD.CODDOE);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODDOE', :NEW.CODDOE);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCID', :OLD.CODCID);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCID', :NEW.CODCID);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODATE', CONVERT(NUMBER_TO_CHAR, :OLD.CODATE));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODATE', CONVERT(NUMBER_TO_CHAR, :NEW.CODATE));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDACITRA', CONVERT(NUMBER_TO_CHAR, :OLD.ACITRA));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWACITRA', CONVERT(NUMBER_TO_CHAR, :NEW.ACITRA));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDEFERET', :OLD.EFERET);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWEFERET', :NEW.EFERET);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENCAFA', CONVERT(NUMBER_TO_CHAR, :OLD.ENCAFA));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENCAFA', CONVERT(NUMBER_TO_CHAR, :NEW.ENCAFA));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPSUC', CONVERT(NUMBER_TO_CHAR, :OLD.TIPSUC));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPSUC', CONVERT(NUMBER_TO_CHAR, :NEW.TIPSUC));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCGCSUC', CONVERT(NUMBER_TO_CHAR, :OLD.CGCSUC));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCGCSUC', CONVERT(NUMBER_TO_CHAR, :NEW.CGCSUC));		  
		  SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATALT', l_datTemp);
		  SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATALT', l_datTemp);		  
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSITORI', CONVERT(NUMBER_TO_CHAR, :OLD.SITORI));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSITORI', CONVERT(NUMBER_TO_CHAR, :NEW.SITORI));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDMOTALT', :OLD.MOTALT);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWMOTALT', :NEW.MOTALT);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOMATE', :OLD.NOMATE);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNOMATE', :NEW.NOMATE);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDORGCLA', CONVERT(NUMBER_TO_CHAR, :OLD.ORGCLA));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWORGCLA', CONVERT(NUMBER_TO_CHAR, :NEW.ORGCLA));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDREGCON', :OLD.REGCON);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWREGCON', :NEW.REGCON);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDESTCON', :OLD.ESTCON);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWESTCON', :NEW.ESTCON);
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCGCCES', CONVERT(NUMBER_TO_CHAR, :OLD.CGCCES));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCGCCES', CONVERT(NUMBER_TO_CHAR, :NEW.CGCCES));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDONUCES', CONVERT(NUMBER_TO_CHAR, :OLD.ONUCES));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWONUCES', CONVERT(NUMBER_TO_CHAR, :NEW.ONUCES));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCGCSIN', CONVERT(NUMBER_TO_CHAR, :OLD.CGCSIN));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCGCSIN', CONVERT(NUMBER_TO_CHAR, :NEW.CGCSIN));
