$␀␀/*-------------------------------- R090MVI ----------------------------*/
PROCEDURE R090MVI_ATUCRV(P_TIPOPE CHAR(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_DATENT DATE,P_DATVAL DATE,P_TIPVIS NUMBER(3))
 IS

l_gercrv      CHAR(1);
  l_uticcr      CHAR(1);
  l_codfil      NUMBER(6);
  l_codesc        R006ESC.CodEsc%TYPE;
  l_verplf      NUMBER(3);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_tem_escala  BOOLEAN;
  l_alt_cred    BOOLEAN;
  l_idtpes      VARCHAR2(23);
  l_tipdoc      CHAR(1);

  /* CURSOR que busca os créditos de acesso para o visitante com escala. */
  CURSOR c_R070DCA IS
         SELECT INIFAI,FIMFAI,CREDIA,LIMCON,VERPLF,CODPLF FROM R070DCA
         WHERE NUMEMP = p_numemp AND CODFIL = l_codfil AND CODESC = l_codesc AND TIPPES = 4;
  TYPE t_R070DCA IS RECORD(
    INIFAI   R070DCA.INIFAI%TYPE,
    FIMFAI   R070DCA.FIMFAI%TYPE,
    CREDIA   R070DCA.CREDIA%TYPE,
    LIMCON   R070DCA.LIMCON%TYPE,
    VERPLF   R070DCA.VERPLF%TYPE,
    CODPLF   R070DCA.CODPLF%TYPE);
  l_r070DCA t_R070DCA;

    /* CURSOR que busca os créditos de acesso para o visitante sem escala. */
  CURSOR c_R070DCA_2 IS
         SELECT INIFAI,FIMFAI,CREDIA,LIMCON,VERPLF,CODPLF FROM R070DCA
         WHERE NUMEMP = p_numemp AND CODFIL = l_codfil AND CODESC = 0 AND TIPPES = 4;
  TYPE t_R070DCA_2 IS RECORD(
    INIFAI   R070DCA.INIFAI%TYPE,
    FIMFAI   R070DCA.FIMFAI%TYPE,
    CREDIA   R070DCA.CREDIA%TYPE,
    LIMCON   R070DCA.LIMCON%TYPE,
    VERPLF   R070DCA.VERPLF%TYPE,
    CODPLF   R070DCA.CODPLF%TYPE);
  l_r070DCA_2 t_R070DCA_2;

  /*CURSOR PARA BUSCAR OS LOCAIS FÍSICOS QUE O VISITANTE POSSÚI CRÉDITOS ATIVOS, SOMENTE LOCAL FÍSICO MAIOR QUE ZERO*/
  CURSOR c_CREDVIS IS
         SELECT DISTINCT VERPLF
                        ,CODPLF
           FROM R070CRV
          WHERE R070CRV.TIPDOC = p_tipdoc
            AND R070CRV.NUMDOC = p_numdoc
            AND R070CRV.DATINI <= l_data_atual
            AND R070CRV.CODPLF > 0
            AND (R070CRV.DATFIM = l_data_zero OR R070CRV.DATFIM > l_data_atual OR
                 (R070CRV.DATFIM = l_data_atual AND R070CRV.FIMFAI >= l_hora_atual));
  TYPE t_CREDVIS IS RECORD(
    VERPLF   R070CRV.INIFAI%TYPE,
    CODPLF   R070CRV.FIMFAI%TYPE);
  l_CREDVIS t_CREDVIS;

BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_alt_cred   := FALSE;
  /* Busca parâmetro que indica se é para gerar créditos de acesso automaticamente. */
  BEGIN
      SELECT GERCRV INTO l_gercrv FROM R090TVI WHERE TIPVIS = P_TIPVIS;
  EXCEPTION
      WHEN OTHERS THEN l_gercrv := 'N';
  END;

  /*Busca versão do plano ativa*/
  BEGIN
      SELECT VERPLF INTO l_verplf
        FROM R058VPL
       WHERE DATCRI <= l_data_atual
         AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
  EXCEPTION
      WHEN OTHERS THEN
          l_verplf := 1;
  END;

  IF  (l_gercrv = 'S') AND (p_numemp <> 0) AND (p_tipcol <> 0) AND (p_numcad <> 0) THEN
      /* busca a filial do visitado */
      BEGIN
          SELECT CODFIL INTO l_codfil FROM R038HFI
          WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                DATALT = (SELECT MAX(DATALT) FROM R038HFI
                          WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT <= l_data_atual);
      EXCEPTION
          WHEN OTHERS THEN l_codfil := 0;
      END;

      /* busca a escala do visitado */
      BEGIN
          SELECT CODESC INTO l_codesc FROM R038HES
          WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                DATALT = (SELECT MAX(DATALT) FROM R038HES
                          WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT <= l_data_atual);
      EXCEPTION
          WHEN OTHERS THEN l_codesc := 0;
      END;


      /*Se utilizar a rotina de compra de créditos, não deve prosseguir com a geração automática de créditos*/
      BEGIN
          SELECT UTICCR INTO l_uticcr FROM R070DAC;
      EXCEPTION
          WHEN OTHERS THEN l_uticcr := 'N';
      END;

      IF  (p_tipope = 'I') OR (p_tipope = 'U')  THEN

          IF  (p_tipope = 'U') THEN
              /* elimina as os creditos para regravar. */
              DELETE FROM R070CRV WHERE TIPDOC = p_tipdoc AND NUMDOC = p_numdoc AND DATINI = p_datent;
              l_alt_cred := TRUE;
          END IF;

          l_tem_escala := FALSE;
          /* busca os créditos de acesso para o visitante. */
          FOREACH c_r070dca INTO  l_r070dca.IniFai,
                                  l_r070dca.FimFai,
                                  l_r070dca.CreDia,
                                  l_r070dca.LimCon,
                                  l_r070dca.VerPlf,
                                  l_r070dca.CodPlf
          LOOP
              /* verifica se já existe o registro. */
              l_tem_escala := TRUE;

              /*Deleta os registros com mesma faixa e que estão em aberto para inserir o atualizado*/
              DELETE FROM R070CRV
               WHERE TIPDOC = p_tipdoc
                 AND NUMDOC = p_numdoc
                 AND INIFAI = l_r070dca.IniFai
                 AND VERPLF = l_r070dca.VerPlf
                 AND CODPLF = l_r070dca.CodPlf
                 AND ((FIMFAI = l_r070dca.FimFai AND
                       DATFIM >= l_data_atual) OR (DATINI = p_datent));

              /* inclui os creditos de acesso do visitante. */
              INSERT INTO R070CRV (TIPDOC,NUMDOC,DATINI,DATFIM,INIFAI,FIMFAI,
                                   CREDIA,SALATU,STAACC,LIMCON,DATCON,QTDCON,VERPLF,CODPLF) VALUES
                    (p_tipdoc,p_numdoc,p_datent,p_datval,l_r070dca.IniFai,
                     l_r070dca.FimFai,l_r070dca.CreDia,l_r070dca.CreDia,1,
                     l_r070dca.LimCon,l_data_zero,0,l_r070dca.VerPlf,l_r070dca.CodPlf);

              l_alt_cred := TRUE;
          END LOOP;

          /* se não encontrou nenhum registro no CURSOR com escala. procura os registros com escala zero*/
          IF  (l_tem_escala = FALSE) THEN
              FOREACH c_r070dca_2 INTO l_r070dca_2.IniFai,
                                       l_r070dca_2.FimFai,
                                       l_r070dca_2.CreDia,
                                       l_r070dca_2.LimCon,
                                       l_r070dca_2.VerPlf,
                                       l_r070dca_2.CodPlf
              LOOP
                  /*Deleta os registros com mesma faixa e que estão em aberto para inserir o atualizado*/

                  DELETE FROM R070CRV
                   WHERE TIPDOC = p_tipdoc
                     AND NUMDOC = p_numdoc
                     AND INIFAI = l_r070dca_2.IniFai
                     AND VERPLF = l_r070dca_2.VerPlf
                     AND CODPLF = l_r070dca_2.CodPlf
                     AND ((FIMFAI = l_r070dca_2.FimFai AND
                           DATFIM >= l_data_atual) OR (DATINI = p_datent));

                  /* inclui os creditos de acesso do visitante. */
                  INSERT INTO R070CRV (TIPDOC,NUMDOC,DATINI,DATFIM,INIFAI,FIMFAI,
                                       CREDIA,SALATU,STAACC,LIMCON,DATCON,QTDCON,VERPLF,CODPLF) VALUES
                        (p_tipdoc,p_numdoc,p_datent,p_datval,l_r070dca_2.IniFai,
                         l_r070dca_2.FimFai,l_r070dca_2.CreDia,l_r070dca_2.CreDia,1,
                         l_r070dca_2.LimCon,l_data_zero,0,l_r070dca_2.VerPlf,l_r070dca_2.CodPlf);

                  l_alt_cred := TRUE;
              END LOOP;
          END IF;
      ELSIF (p_tipope = 'D') THEN
          /* elimina as os creditos. */
          DELETE FROM R070CRV WHERE TIPDOC = p_tipdoc AND NUMDOC = p_numdoc AND DATINI = p_datent;
          l_alt_cred := TRUE;
      END IF;

      /* SE HOUVE ALTERAÇÕES NOS CRÉDITOS DE ACESSO DA PESSOA */
      IF ( l_alt_cred = TRUE ) THEN
          SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
          l_idtpes := '04' ||l_tipdoc||p_numdoc;
          LOOP
            /*Controle do Loop.*/
            IF (Length(l_idtpes) > 22) THEN
                EXIT;
            END IF;
            l_idtpes := ' '||l_idtpes;
          END LOOP;

          IF  (p_tipope <> 'I') THEN
              /*Remove os créditos globais e créditos por local físico da pessoa*/
              SP_PEND06(4,l_idtpes,0,0);
          END IF;

          IF  (p_tipope <> 'D') THEN
              /*Atualiza os créditos para local físico zero*/
              SP_CRECON(4, p_numemp,0,0,p_tipdoc,p_numdoc,'0','0', l_verplf, 0);

              /*INSERE OS CRÉDITOS ATIVOS*/
              FOREACH c_CREDVIS INTO  l_CREDVIS.VerPlf,
                                      l_CREDVIS.CodPlf
              LOOP
                  /*Atualiza os créditos*/
                  SP_CRECON(4, p_numemp,0,0,p_tipdoc,p_numdoc,'0','0', l_CREDVIS.VerPlf, l_CREDVIS.CodPlf);
              END LOOP;
          END IF;
          
      END IF;
  END IF;
END␀vİ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
jPROCEDURE R090VIS_ATUCON(P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_CODPRM NUMBER)
 IS
BEGIN
