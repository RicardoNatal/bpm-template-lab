      HORINI   R151CVR.HORINI%TYPE,
      SEQENT   R151CVR.SEQENT%TYPE,
      CODREC   R151CVR.CODREC%TYPE,
      VERPLF   R151CVR.VERPLF%TYPE,
      CODPLF   R151CVR.CODPLF%TYPE,
      PROTCL   R151CVR.PROTCL%TYPE);

    l_codpen NUMBER(18);
    l_151cvr T_R151CVR;
BEGIN
    /* Busco todos os recintos por crachá do visitante, para gerar pendência de exclusão */
    FOREACH C_R151CVR INTO l_151cvr.DATINI,
                           l_151cvr.HORINI,
                           l_151cvr.SEQENT,
                           l_151cvr.CODREC,
                           l_151cvr.VERPLF,
                           l_151cvr.CODPLF,
                           l_151cvr.PROTCL
    LOOP
        SP_PENDADE02(1, 'E', l_151cvr.VERPLF, l_151cvr.CODPLF, l_151cvr.CODREC, l_codpen OUT);

        BEGIN
            INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                VALUES (l_codpen, 4, NULL, NULL, NULL, p_tipdoc, p_numdoc, l_151cvr.DATINI, l_151cvr.HORINI, NULL, l_151cvr.SEQENT, l_151cvr.PROTCL);
        EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'SP_RECALF_E_CRAVIS: Erro ao inserir pendência de exclusão de Credenciamento de Pessoas';
        END;
    END LOOP;

    /* Excluo todos os registros de recintos por crachá, do visitante */
    BEGIN
        DELETE FROM R151CVR WHERE TIPDOC = p_tipdoc AND NUMDOC = p_numdoc AND STAREC = 1;
    EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'SP_RECALF_E_CRAVIS: Erro ao excluir os crachás do visitante na R151CVR.';
    END;

    /* Garanto para que o status não permaneça como 2 - Ativo */
    BEGIN
        UPDATE R090VIS SET STAALF = 1 WHERE TIPDOC = p_tipdoc AND NUMDOC = p_numdoc;
    EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'SP_RECALF_E_CRAVIS: Erro ao atualizar status da permissão para local alfandegado na R090VIS.';
    END;

END␀ ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
”␀␀/* API-Recintos - Verifica se deve gerar pendências */
PROCEDURE SP_RECALF_GERPEN(P_ASSAPI NUMBER(2), P_MARGER OUT BOOLEAN)
 IS

  l_marger CHAR(1);
BEGIN

  BEGIN
    SELECT MARGER INTO l_marger FROM R151API WHERE ASSAPI = p_assapi;
  EXCEPTION WHEN OTHERS THEN
    l_marger := 'N';
  END;

  IF (l_marger = 'S') THEN
    p_marger := TRUE;
  ELSE
    p_marger := FALSE;
  END IF;

END␀¡ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
L␀␀/* API-Recintos - Credenciamento-pessoas */
PROCEDURE SP_RECALF_GERPEN_1(P_TIPPES NUMBER(1), P_MARGER OUT BOOLEAN)
 IS

  l_assapi NUMBER(2);
  l_marger CHAR(1);
BEGIN

  /* Empregado */
  IF (p_tippes = 1) THEN
    l_assapi := 11;
  ELSE
    /* Terceiro */
    IF (p_tippes = 2) THEN
      l_assapi := 12;
    ELSE
      /* Parceiro */
      IF (p_tippes = 3) THEN
        l_assapi := 13;
      ELSE
        /* Visitante */
        IF (p_tippes = 4) THEN
          l_assapi := 14;
        ELSE
          l_assapi := 0;
        END IF;
      END IF;
    END IF;
  END IF;

  BEGIN
    SELECT MARGER INTO l_marger FROM R151API WHERE ASSAPI = l_assapi;
  EXCEPTION WHEN OTHERS THEN
    l_marger := 'N';
  END;

  IF (l_marger = 'S') THEN
    p_marger := TRUE;
  ELSE
    p_marger := FALSE;
  END IF;

END␀¢ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
D␀␀/* API-Recintos - Acesso-pessoas */
PROCEDURE SP_RECALF_GERPEN_2(P_TIPPES NUMBER(1), P_MARGER OUT BOOLEAN)
 IS

  l_assapi NUMBER(2);
  l_marger CHAR(1);
BEGIN

  /* Empregado */
  IF (p_tippes = 1) THEN
    l_assapi := 21;
  ELSE
    /* Terceiro */
    IF (p_tippes = 2) THEN
      l_assapi := 22;
    ELSE
      /* Parceiro */
      IF (p_tippes = 3) THEN
        l_assapi := 23;
      ELSE
        /* Visitante */
        IF (p_tippes = 4) THEN
          l_assapi := 24;
        ELSE
          l_assapi := 0;
        END IF;
      END IF;
    END IF;
  END IF;

  BEGIN
    SELECT MARGER INTO l_marger FROM R151API WHERE ASSAPI = l_assapi;
  EXCEPTION WHEN OTHERS THEN
    l_marger := 'N';
  END;

  IF (l_marger = 'S') THEN
    p_marger := TRUE;
  ELSE
    p_marger := FALSE;
  END IF;

END␀£ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE SP_RECALF_PRMCOL(P_NUMEMP NUMBER, P_TIPCOL NUMBER, P_NUMCAD NUMBER, P_CODPRM NUMBER, P_PRMSAB NUMBER, P_PRMDOM NUMBER, P_PRMFER NUMBER, P_NUMCRA NUMBER(12), P_DATINI DATE, P_HORINI NUMBER(4), P_DATFIM DATE, P_HORFIM NUMBER(4), P_TIPCRA NUMBER)
 IS
BEGIN
    NULL;
END		SENIOR;20SP_RETCRA
SP_PENDADE02
²A␀␀

PROCEDURE SP_RECALF_PRMCOL(P_NUMEMP NUMBER, P_TIPCOL NUMBER, P_NUMCAD NUMBER, P_CODPRM NUMBER, P_PRMSAB NUMBER, P_PRMDOM NUMBER, P_PRMFER NUMBER, P_NUMCRA NUMBER(12), P_DATINI DATE, P_HORINI NUMBER(4), P_DATFIM DATE, P_HORFIM NUMBER(4), P_TIPCRA NUMBER)
 IS

    l_numemp     NUMBER(4);
    l_tipcol     NUMBER(1);
    l_numcad     NUMBER(9);
    l_codprm     NUMBER;
    l_prmsab     NUMBER;
    l_prmdom     NUMBER;
    l_prmfer     NUMBER;
    l_data_atual DATE;
    l_data_zero  DATE;
    l_hora_atual NUMBER(4);
    l_codpen     NUMBER(18);
    l_count      NUMBER(3);
    l_staalf     NUMBER(1);

    l_cracha     NUMBER(12);
    l_datini     DATE;
    l_horini     NUMBER(4);
    l_datfim     DATE;
    l_horfim     NUMBER(4);
    l_tipcra     NUMBER;
    l_numcra     NUMBER(12);
    alfmen       VARCHAR2(255);

    CURSOR C_RECINTOS IS
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND GRP.CODPRM IN (l_codprm, l_prmsab, l_prmdom, l_prmfer) AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM IN (l_codprm, l_prmsab, l_prmdom, l_prmfer) AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R058PLF PLF, R070PEC PEC, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND GRP.CODPRM = PEC.CODPRM AND PEC.NUMEMP = l_numemp AND PEC.TIPCOL = l_tipcol AND PEC.NUMCAD = l_numcad
         AND PEC.STAACC = 1 AND (PEC.DATFIM = l_data_zero OR PEC.DATFIM > l_data_atual OR (PEC.DATFIM = l_data_atual AND PEC.HORFIM > l_hora_atual))
         AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R058PLF PLF, R070PEC PEC, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM = PEC.CODPRM AND PEC.NUMEMP = l_numemp AND PEC.TIPCOL = l_tipcol AND PEC.NUMCAD = l_numcad
         AND PEC.STAACC = 1 AND (PEC.DATFIM = l_data_zero OR PEC.DATFIM > l_data_atual OR (PEC.DATFIM = l_data_atual AND PEC.HORFIM > l_hora_atual))
         AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0)));

    CURSOR C_R151CCR IS
      SELECT CODREC, VERPLF, CODPLF, PROTCL FROM R151CCR WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND STAREC = 0;

    TYPE T_RECINTO IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE);

    TYPE T_R151CCR IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE,
      PROTCL   R058PLF.PROTCL%TYPE);

    l_recinc T_RECINTO;
    l_recexc T_R151CCR;

BEGIN
    /* Trouxe a atualização da l_data_zero pra cá, porque p/ SQL Server está dando problema se a procedure iniciar a partir da linha seguinte l_cracha := p_numcra;
     * Infelizmente, a tec está deixando bastante a desejar */
    l_data_zero := '31/12/1900,00:00:00';
    l_cracha := p_numcra;
    l_numemp := p_numemp;
    l_tipcol := p_tipcol;
    l_numcad := p_numcad;
    l_codprm := p_codprm;
    l_prmsab := p_prmsab;
    l_prmdom := p_prmdom;
    l_prmfer := p_prmfer;
    l_data_atual := CURDATE();
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

    /* Defino o crachá do colaborador a utilizar, se o passado como parâmetro ou buscando o vigente */
    IF (l_cracha IS NULL OR l_cracha = 0) THEN
        /* Verifica se a pessoa tem crachá válido */
        /* Obtem o crachá Provisório, se não existir obtem o Titular */
        BEGIN
          SP_RETCRA(2, l_numemp, l_tipcol, l_numcad, 0, '', 0, '', l_cracha OUT);
          IF (l_cracha = 0) THEN
            SP_RETCRA(1, l_numemp, l_tipcol, l_numcad, 0, '', 0, '', l_cracha OUT);
          END IF;
        EXCEPTION
          WHEN OTHERS THEN l_cracha := 0;
        END;

        IF (l_cracha <> 0) THEN
            /* Obtem a data/hora inicial e final do crachá ativo do colaborador. */
            BEGIN
                SELECT DATINI, HORINI, DATFIM, HORFIM, TIPCRA
                INTO l_datini, l_horini, l_datfim, l_horfim, l_tipcra
                FROM R038HCH
                WHERE NUMCRA = l_cracha AND NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND
                      (DATINI < l_data_atual OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                      (DATFIM = l_data_zero OR DATFIM > l_data_atual OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
            EXCEPTION
                WHEN TOO_MANY_ROWS THEN
                    RAISERROR 103 'SP_RECALF_PRMCOL: Erro em R038HCH - TOO MANY ROWS.';
                WHEN NO_DATA_FOUND THEN
                    RAISERROR 103 'SP_RECALF_PRMCOL: Erro em R038HCH - NO DATA FOUND.';
                WHEN OTHERS THEN
                    RAISERROR 103 'SP_RECALF_PRMCOL: Erro no SELECT R038HCH.';
            END;
        END IF;
    ELSE
        l_datini := p_datini;
        l_horini := p_horini;
        l_datfim := p_datfim;
        l_horfim := p_horfim;
        l_tipcra := p_tipcra;
    END IF;

    IF (l_cracha <> 0)  THEN
        /* Quando não vier as permissões normais do colaborador, busco. Áreas restritas já são contempladas no cursor.
           Importante: primeiro verifico se existe troca de permissão. Se não exisir, vale as permissões normais. */
        IF (l_codprm IS NULL OR l_codprm = 0) THEN
            BEGIN
                SELECT CODPRM, PRMFER, PRMDOM, PRMSAB INTO l_codprm, l_prmfer, l_prmdom, l_prmsab FROM R064TPE
                 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad
                   AND STAACC = 1 AND (DATFIM = l_data_zero OR DATFIM > l_data_atual OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
            EXCEPTION
                WHEN OTHERS THEN 
                    l_codprm := 0;
                    l_prmsab := 0;
                    l_prmdom := 0;
                    l_prmfer := 0;
            END;

            IF (l_codprm = 0) THEN
                BEGIN
                    SELECT CODPRM, PRMFER, PRMDOM, PRMSAB INTO l_codprm, l_prmfer, l_prmdom, l_prmsab FROM R034DAC 
                        WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
                EXCEPTION
                    WHEN OTHERS THEN 
                        l_codprm := 0;
                        l_prmsab := 0;
                        l_prmdom := 0;
                        l_prmfer := 0;
                END;
            END IF;
        END IF;

        /* MERGE - CREDENCIAL X RECINTOS */
        /* Atualizo os registros atuais do colaborador, com o status alfandegado 2 - Ativo, para 0 - Não Atualizado */
        BEGIN
            UPDATE R151CCR SET STAREC = 0 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND STAREC = 1 AND STAALF = 2;
        EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMCOL: Erro de UPDATE na R151CCR p/ Não Atualizado na Base. Nro. Emp.: '
                  || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                  || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad);
                RAISERROR 103 alfmen;
        END;

        /* Incluo registros para os novos recintos, e atualizo os existentes para 1 - Atualizado */
        FOREACH C_RECINTOS INTO l_recinc.CODREC,
                                l_recinc.VERPLF,
                                l_recinc.CODPLF
        LOOP
            /* Verifico se esse recinto já está presente p/ o colaborador */
            BEGIN
                SELECT NUMCRA INTO l_numcra FROM R151CCR 
                 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND
                       VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN l_numcra := 0;
            END;

            IF (l_numcra <> 0) THEN
                /* Já existe, muda o status deste recinto pra 1 - Atualizado */
                /* Obs.: Atualizo também o status alfandegado para 2 - Ativo. */
                BEGIN
                    UPDATE R151CCR SET STAREC = 1, STAALF = 2 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND
                        VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
                EXCEPTION
                    WHEN OTHERS THEN
                        alfmen := 'SP_RECALF_PRMCOL: Erro de UPDATE na R151CCR p/ Atualizado na Base. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                        RAISERROR 103 alfmen;
                END;
            ELSE
                /* Não existe, gero uma nova pendência para este novo recinto */
                /* Insere uma pendência do evento 1 - Credenciamento de Pessoas, para envio pelo eDocs */
                SP_PENDADE02(1, 'I', l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, l_codpen OUT);

                BEGIN
                    INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                         VALUES (l_codpen, l_tipcol, l_numemp, l_tipcol, l_numcad, NULL, NULL, l_datini, l_horini, l_tipcra, NULL, NULL);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao inserir pendência de inclusão de Credenciamento de Pessoas. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;

                BEGIN
                    INSERT INTO R151CCR (CODPEN, NUMEMP, TIPCOL, NUMCAD, NUMCRA, DATINI, HORINI, DATFIM, HORFIM, TIPCRA, VERPLF, CODPLF, CODREC, STAREC, STAALF)
                         VALUES (l_codpen, l_numemp, l_tipcol, l_numcad, l_cracha, l_datini, l_horini, l_datfim, l_horfim, l_tipcra,
                                 l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, 1, 2);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao inserir crachá atual do colaborador na R151CCR. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;
            END IF;
        END LOOP; /* LOOP */

        /* Retifico registros em que as permissões da pessoa não dê mais acesso aos recintos */
        FOREACH C_R151CCR INTO l_recexc.CODREC,
                               l_recexc.VERPLF,
                               l_recexc.CODPLF,
                               l_recexc.PROTCL
        LOOP
            /* --- Envio a pendência de retificação de credencial --- */
            SP_PENDADE02(1, 'R', l_recexc.VERPLF, l_recexc.CODPLF, l_recexc.CODREC, l_codpen OUT);

            BEGIN
                INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                        VALUES (l_codpen, l_tipcol, l_numemp, l_tipcol, l_numcad, NULL, NULL, l_datini, l_horini, l_tipcra, NULL, l_recexc.PROTCL);
            EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMCOL: Erro ao inserir pendência de retificação de Credenciamento de Pessoas. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */
    
            /* --- Atualizo o status do registro para 2 - Histórico, e o recinto para 1 - Inativo. Apenas para este recinto --- */
            BEGIN
                UPDATE R151CCR SET STAREC = 2, STAALF = 1, DATFIM = l_data_atual, HORFIM = l_hora_atual
                 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND CODREC = l_recexc.CODREC AND STAREC = 0;
            EXCEPTION WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMCOL: Erro ao atualizar crachá atual do colaborador na R151CCR. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */
        END LOOP;  /* LOOP */

        /* Atualizo o status da pessoa, verificando se possui algum recinto (1 - Atualizado) com o status 2 - Ativo */
        BEGIN
            SELECT COUNT(1) INTO l_count FROM R151CCR WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND STAREC = 1 AND STAALF = 2;
        EXCEPTION WHEN NO_DATA_FOUND THEN
            l_count := 0;
        END;

        l_staalf := 1;
        BEGIN
            SELECT STAALF INTO l_staalf FROM R034FUN WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        IF (l_count > 0) THEN
            IF (l_staalf <> 2) THEN
                /* Atualizo para 2 - Ativo */
                l_staalf := 2;

                BEGIN
                    UPDATE R034FUN SET STAALF = l_staalf
                       WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao atualizar status da permissão para local alfandegado p/ ATIVO na R034FUN. Nro. Emp.: '
                      || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                      || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad);
                    RAISERROR 103 alfmen;
                END;
            END IF;
        ELSE
            IF (l_staalf = 2) THEN
                /* Atualizo para 1 - Inativo */
                l_staalf := 1;

                BEGIN
                    UPDATE R034FUN SET STAALF = l_staalf
                       WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao atualizar status da permissão para local alfandegado p/ INATIVO na R034FUN. Nro. Emp.: '
                      || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                      || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad);
                    RAISERROR 103 alfmen;
                END;
            END IF; /* IF (l_staalf = 2) THEN */
        END IF; /* IF (l_count > 0) THEN */
    END IF; /* IF (l_cracha <> 0)  THEN */
END		SENIOR;21SP_RETCRA
SP_PENDADE02
²A␀␀

PROCEDURE SP_RECALF_PRMCOL(P_NUMEMP NUMBER, P_TIPCOL NUMBER, P_NUMCAD NUMBER, P_CODPRM NUMBER, P_PRMSAB NUMBER, P_PRMDOM NUMBER, P_PRMFER NUMBER, P_NUMCRA NUMBER(12), P_DATINI DATE, P_HORINI NUMBER(4), P_DATFIM DATE, P_HORFIM NUMBER(4), P_TIPCRA NUMBER)
 IS

    l_numemp     NUMBER(4);
    l_tipcol     NUMBER(1);
    l_numcad     NUMBER(9);
    l_codprm     NUMBER;
    l_prmsab     NUMBER;
    l_prmdom     NUMBER;
    l_prmfer     NUMBER;
    l_data_atual DATE;
    l_data_zero  DATE;
    l_hora_atual NUMBER(4);
    l_codpen     NUMBER(18);
    l_count      NUMBER(3);
    l_staalf     NUMBER(1);

    l_cracha     NUMBER(12);
    l_datini     DATE;
    l_horini     NUMBER(4);
    l_datfim     DATE;
    l_horfim     NUMBER(4);
    l_tipcra     NUMBER;
    l_numcra     NUMBER(12);
    alfmen       VARCHAR2(255);

    CURSOR C_RECINTOS IS
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND GRP.CODPRM IN (l_codprm, l_prmsab, l_prmdom, l_prmfer) AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM IN (l_codprm, l_prmsab, l_prmdom, l_prmfer) AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R058PLF PLF, R070PEC PEC, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND GRP.CODPRM = PEC.CODPRM AND PEC.NUMEMP = l_numemp AND PEC.TIPCOL = l_tipcol AND PEC.NUMCAD = l_numcad
         AND PEC.STAACC = 1 AND (PEC.DATFIM = l_data_zero OR PEC.DATFIM > l_data_atual OR (PEC.DATFIM = l_data_atual AND PEC.HORFIM > l_hora_atual))
         AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R058PLF PLF, R070PEC PEC, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM = PEC.CODPRM AND PEC.NUMEMP = l_numemp AND PEC.TIPCOL = l_tipcol AND PEC.NUMCAD = l_numcad
         AND PEC.STAACC = 1 AND (PEC.DATFIM = l_data_zero OR PEC.DATFIM > l_data_atual OR (PEC.DATFIM = l_data_atual AND PEC.HORFIM > l_hora_atual))
         AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0)));

    CURSOR C_R151CCR IS
      SELECT CODREC, VERPLF, CODPLF, PROTCL FROM R151CCR WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND STAREC = 0;

    TYPE T_RECINTO IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE);

    TYPE T_R151CCR IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE,
      PROTCL   R058PLF.PROTCL%TYPE);

    l_recinc T_RECINTO;
    l_recexc T_R151CCR;

BEGIN
    /* Trouxe a atualização da l_data_zero pra cá, porque p/ SQL Server está dando problema se a procedure iniciar a partir da linha seguinte l_cracha := p_numcra;
     * Infelizmente, a tec está deixando bastante a desejar */
    l_data_zero := '31/12/1900,00:00:00';
    l_cracha := p_numcra;
    l_numemp := p_numemp;
    l_tipcol := p_tipcol;
    l_numcad := p_numcad;
    l_codprm := p_codprm;
    l_prmsab := p_prmsab;
    l_prmdom := p_prmdom;
    l_prmfer := p_prmfer;
    l_data_atual := CURDATE();
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

    /* Defino o crachá do colaborador a utilizar, se o passado como parâmetro ou buscando o vigente */
    IF (l_cracha IS NULL OR l_cracha = 0) THEN
        /* Verifica se a pessoa tem crachá válido */
        /* Obtem o crachá Provisório, se não existir obtem o Titular */
        BEGIN
          SP_RETCRA(2, l_numemp, l_tipcol, l_numcad, 0, '', 0, '', l_cracha OUT);
          IF (l_cracha = 0) THEN
            SP_RETCRA(1, l_numemp, l_tipcol, l_numcad, 0, '', 0, '', l_cracha OUT);
          END IF;
        EXCEPTION
          WHEN OTHERS THEN l_cracha := 0;
        END;

        IF (l_cracha <> 0) THEN
            /* Obtem a data/hora inicial e final do crachá ativo do colaborador. */
            BEGIN
                SELECT DATINI, HORINI, DATFIM, HORFIM, TIPCRA
                INTO l_datini, l_horini, l_datfim, l_horfim, l_tipcra
                FROM R038HCH
                WHERE NUMCRA = l_cracha AND NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND
                      (DATINI < l_data_atual OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                      (DATFIM = l_data_zero OR DATFIM > l_data_atual OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
            EXCEPTION
                WHEN TOO_MANY_ROWS THEN
                    RAISERROR 103 'SP_RECALF_PRMCOL: Erro em R038HCH - TOO MANY ROWS.';
                WHEN NO_DATA_FOUND THEN
                    RAISERROR 103 'SP_RECALF_PRMCOL: Erro em R038HCH - NO DATA FOUND.';
                WHEN OTHERS THEN
                    RAISERROR 103 'SP_RECALF_PRMCOL: Erro no SELECT R038HCH.';
            END;
        END IF;
    ELSE
        l_datini := p_datini;
        l_horini := p_horini;
        l_datfim := p_datfim;
        l_horfim := p_horfim;
        l_tipcra := p_tipcra;
    END IF;

    IF (l_cracha <> 0)  THEN
        /* Quando não vier as permissões normais do colaborador, busco. Áreas restritas já são contempladas no cursor.
           Importante: primeiro verifico se existe troca de permissão. Se não exisir, vale as permissões normais. */
        IF (l_codprm IS NULL OR l_codprm = 0) THEN
            BEGIN
                SELECT CODPRM, PRMFER, PRMDOM, PRMSAB INTO l_codprm, l_prmfer, l_prmdom, l_prmsab FROM R064TPE
                 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad
                   AND STAACC = 1 AND (DATFIM = l_data_zero OR DATFIM > l_data_atual OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
            EXCEPTION
                WHEN OTHERS THEN 
                    l_codprm := 0;
                    l_prmsab := 0;
                    l_prmdom := 0;
                    l_prmfer := 0;
            END;

            IF (l_codprm = 0) THEN
                BEGIN
                    SELECT CODPRM, PRMFER, PRMDOM, PRMSAB INTO l_codprm, l_prmfer, l_prmdom, l_prmsab FROM R034DAC 
                        WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
                EXCEPTION
                    WHEN OTHERS THEN 
                        l_codprm := 0;
                        l_prmsab := 0;
                        l_prmdom := 0;
                        l_prmfer := 0;
                END;
            END IF;
        END IF;

        /* MERGE - CREDENCIAL X RECINTOS */
        /* Atualizo os registros atuais do colaborador, com o status alfandegado 2 - Ativo, para 0 - Não Atualizado */
        BEGIN
            UPDATE R151CCR SET STAREC = 0 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND STAREC = 1 AND STAALF = 2;
        EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMCOL: Erro de UPDATE na R151CCR p/ Não Atualizado na Base. Nro. Emp.: '
                  || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                  || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad);
                RAISERROR 103 alfmen;
        END;

        /* Incluo registros para os novos recintos, e atualizo os existentes para 1 - Atualizado */
        FOREACH C_RECINTOS INTO l_recinc.CODREC,
                                l_recinc.VERPLF,
                                l_recinc.CODPLF
        LOOP
            /* Verifico se esse recinto já está presente p/ o colaborador */
            BEGIN
                SELECT NUMCRA INTO l_numcra FROM R151CCR 
                 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND
                       VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN l_numcra := 0;
            END;

            IF (l_numcra <> 0) THEN
                /* Já existe, muda o status deste recinto pra 1 - Atualizado */
                /* Obs.: Atualizo também o status alfandegado para 2 - Ativo. */
                BEGIN
                    UPDATE R151CCR SET STAREC = 1, STAALF = 2 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND
                        VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
                EXCEPTION
                    WHEN OTHERS THEN
                        alfmen := 'SP_RECALF_PRMCOL: Erro de UPDATE na R151CCR p/ Atualizado na Base. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                        RAISERROR 103 alfmen;
                END;
            ELSE
                /* Não existe, gero uma nova pendência para este novo recinto */
                /* Insere uma pendência do evento 1 - Credenciamento de Pessoas, para envio pelo eDocs */
                SP_PENDADE02(1, 'I', l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, l_codpen OUT);

                BEGIN
                    INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                         VALUES (l_codpen, l_tipcol, l_numemp, l_tipcol, l_numcad, NULL, NULL, l_datini, l_horini, l_tipcra, NULL, NULL);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao inserir pendência de inclusão de Credenciamento de Pessoas. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;

                BEGIN
                    INSERT INTO R151CCR (CODPEN, NUMEMP, TIPCOL, NUMCAD, NUMCRA, DATINI, HORINI, DATFIM, HORFIM, TIPCRA, VERPLF, CODPLF, CODREC, STAREC, STAALF)
                         VALUES (l_codpen, l_numemp, l_tipcol, l_numcad, l_cracha, l_datini, l_horini, l_datfim, l_horfim, l_tipcra,
                                 l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, 1, 2);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao inserir crachá atual do colaborador na R151CCR. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;
            END IF;
        END LOOP; /* LOOP */

        /* Retifico registros em que as permissões da pessoa não dê mais acesso aos recintos */
        FOREACH C_R151CCR INTO l_recexc.CODREC,
                               l_recexc.VERPLF,
                               l_recexc.CODPLF,
                               l_recexc.PROTCL
        LOOP
            /* --- Envio a pendência de retificação de credencial --- */
            SP_PENDADE02(1, 'R', l_recexc.VERPLF, l_recexc.CODPLF, l_recexc.CODREC, l_codpen OUT);

            BEGIN
                INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                        VALUES (l_codpen, l_tipcol, l_numemp, l_tipcol, l_numcad, NULL, NULL, l_datini, l_horini, l_tipcra, NULL, l_recexc.PROTCL);
            EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMCOL: Erro ao inserir pendência de retificação de Credenciamento de Pessoas. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */
    
            /* --- Atualizo o status do registro para 2 - Histórico, e o recinto para 1 - Inativo. Apenas para este recinto --- */
            BEGIN
                UPDATE R151CCR SET STAREC = 2, STAALF = 1, DATFIM = l_data_atual, HORFIM = l_hora_atual
                 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND CODREC = l_recexc.CODREC AND STAREC = 0;
            EXCEPTION WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMCOL: Erro ao atualizar crachá atual do colaborador na R151CCR. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */
        END LOOP;  /* LOOP */

        /* Atualizo o status da pessoa, verificando se possui algum recinto (1 - Atualizado) com o status 2 - Ativo */
        BEGIN
            SELECT COUNT(1) INTO l_count FROM R151CCR WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND STAREC = 1 AND STAALF = 2;
        EXCEPTION WHEN NO_DATA_FOUND THEN
            l_count := 0;
        END;

        l_staalf := 1;
        BEGIN
            SELECT STAALF INTO l_staalf FROM R034FUN WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        IF (l_count > 0) THEN
            IF (l_staalf <> 2) THEN
                /* Atualizo para 2 - Ativo */
                l_staalf := 2;

                BEGIN
                    UPDATE R034FUN SET STAALF = l_staalf
                       WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao atualizar status da permissão para local alfandegado p/ ATIVO na R034FUN. Nro. Emp.: '
                      || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                      || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad);
                    RAISERROR 103 alfmen;
                END;
            END IF;
        ELSE
            IF (l_staalf = 2) THEN
                /* Atualizo para 1 - Inativo */
                l_staalf := 1;

                BEGIN
                    UPDATE R034FUN SET STAALF = l_staalf
                       WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao atualizar status da permissão para local alfandegado p/ INATIVO na R034FUN. Nro. Emp.: '
                      || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                      || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad);
                    RAISERROR 103 alfmen;
                END;
            END IF; /* IF (l_staalf = 2) THEN */
        END IF; /* IF (l_count > 0) THEN */
    END IF; /* IF (l_cracha <> 0)  THEN */
END		SENIOR;22SP_RETCRA
SP_PENDADE02
²A␀␀

PROCEDURE SP_RECALF_PRMCOL(P_NUMEMP NUMBER, P_TIPCOL NUMBER, P_NUMCAD NUMBER, P_CODPRM NUMBER, P_PRMSAB NUMBER, P_PRMDOM NUMBER, P_PRMFER NUMBER, P_NUMCRA NUMBER(12), P_DATINI DATE, P_HORINI NUMBER(4), P_DATFIM DATE, P_HORFIM NUMBER(4), P_TIPCRA NUMBER)
 IS

    l_numemp     NUMBER(4);
    l_tipcol     NUMBER(1);
    l_numcad     NUMBER(9);
    l_codprm     NUMBER;
    l_prmsab     NUMBER;
    l_prmdom     NUMBER;
    l_prmfer     NUMBER;
    l_data_atual DATE;
    l_data_zero  DATE;
    l_hora_atual NUMBER(4);
    l_codpen     NUMBER(18);
    l_count      NUMBER(3);
    l_staalf     NUMBER(1);

    l_cracha     NUMBER(12);
    l_datini     DATE;
    l_horini     NUMBER(4);
    l_datfim     DATE;
    l_horfim     NUMBER(4);
    l_tipcra     NUMBER;
    l_numcra     NUMBER(12);
    alfmen       VARCHAR2(255);

    CURSOR C_RECINTOS IS
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND GRP.CODPRM IN (l_codprm, l_prmsab, l_prmdom, l_prmfer) AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM IN (l_codprm, l_prmsab, l_prmdom, l_prmfer) AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R058PLF PLF, R070PEC PEC, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND GRP.CODPRM = PEC.CODPRM AND PEC.NUMEMP = l_numemp AND PEC.TIPCOL = l_tipcol AND PEC.NUMCAD = l_numcad
         AND PEC.STAACC = 1 AND (PEC.DATFIM = l_data_zero OR PEC.DATFIM > l_data_atual OR (PEC.DATFIM = l_data_atual AND PEC.HORFIM > l_hora_atual))
         AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R058PLF PLF, R070PEC PEC, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM = PEC.CODPRM AND PEC.NUMEMP = l_numemp AND PEC.TIPCOL = l_tipcol AND PEC.NUMCAD = l_numcad
         AND PEC.STAACC = 1 AND (PEC.DATFIM = l_data_zero OR PEC.DATFIM > l_data_atual OR (PEC.DATFIM = l_data_atual AND PEC.HORFIM > l_hora_atual))
         AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0)));

    CURSOR C_R151CCR IS
      SELECT CODREC, VERPLF, CODPLF, PROTCL FROM R151CCR WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND STAREC = 0;

    TYPE T_RECINTO IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE);

    TYPE T_R151CCR IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE,
      PROTCL   R058PLF.PROTCL%TYPE);

    l_recinc T_RECINTO;
    l_recexc T_R151CCR;

BEGIN
    /* Trouxe a atualização da l_data_zero pra cá, porque p/ SQL Server está dando problema se a procedure iniciar a partir da linha seguinte l_cracha := p_numcra;
     * Infelizmente, a tec está deixando bastante a desejar */
    l_data_zero := '31/12/1900,00:00:00';
    l_cracha := p_numcra;
    l_numemp := p_numemp;
    l_tipcol := p_tipcol;
    l_numcad := p_numcad;
    l_codprm := p_codprm;
    l_prmsab := p_prmsab;
    l_prmdom := p_prmdom;
    l_prmfer := p_prmfer;
    l_data_atual := CURDATE();
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

    /* Defino o crachá do colaborador a utilizar, se o passado como parâmetro ou buscando o vigente */
    IF (l_cracha IS NULL OR l_cracha = 0) THEN
        /* Verifica se a pessoa tem crachá válido */
        /* Obtem o crachá Provisório, se não existir obtem o Titular */
        BEGIN
          SP_RETCRA(2, l_numemp, l_tipcol, l_numcad, 0, '', 0, '', l_cracha OUT);
          IF (l_cracha = 0) THEN
            SP_RETCRA(1, l_numemp, l_tipcol, l_numcad, 0, '', 0, '', l_cracha OUT);
          END IF;
        EXCEPTION
          WHEN OTHERS THEN l_cracha := 0;
        END;

        IF (l_cracha <> 0) THEN
            /* Obtem a data/hora inicial e final do crachá ativo do colaborador. */
            BEGIN
                SELECT DATINI, HORINI, DATFIM, HORFIM, TIPCRA
                INTO l_datini, l_horini, l_datfim, l_horfim, l_tipcra
                FROM R038HCH
                WHERE NUMCRA = l_cracha AND NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND
                      (DATINI < l_data_atual OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                      (DATFIM = l_data_zero OR DATFIM > l_data_atual OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
            EXCEPTION
                WHEN TOO_MANY_ROWS THEN
                    RAISERROR 103 'SP_RECALF_PRMCOL: Erro em R038HCH - TOO MANY ROWS.';
                WHEN NO_DATA_FOUND THEN
                    RAISERROR 103 'SP_RECALF_PRMCOL: Erro em R038HCH - NO DATA FOUND.';
                WHEN OTHERS THEN
                    RAISERROR 103 'SP_RECALF_PRMCOL: Erro no SELECT R038HCH.';
            END;
        END IF;
    ELSE
        l_datini := p_datini;
        l_horini := p_horini;
        l_datfim := p_datfim;
        l_horfim := p_horfim;
        l_tipcra := p_tipcra;
    END IF;

    IF (l_cracha <> 0)  THEN
        /* Quando não vier as permissões normais do colaborador, busco. Áreas restritas já são contempladas no cursor.
           Importante: primeiro verifico se existe troca de permissão. Se não exisir, vale as permissões normais. */
        IF (l_codprm IS NULL OR l_codprm = 0) THEN
            BEGIN
                SELECT CODPRM, PRMFER, PRMDOM, PRMSAB INTO l_codprm, l_prmfer, l_prmdom, l_prmsab FROM R064TPE
                 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad
                   AND STAACC = 1 AND (DATFIM = l_data_zero OR DATFIM > l_data_atual OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
            EXCEPTION
                WHEN OTHERS THEN 
                    l_codprm := 0;
                    l_prmsab := 0;
                    l_prmdom := 0;
                    l_prmfer := 0;
            END;

            IF (l_codprm = 0) THEN
                BEGIN
                    SELECT CODPRM, PRMFER, PRMDOM, PRMSAB INTO l_codprm, l_prmfer, l_prmdom, l_prmsab FROM R034DAC 
                        WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
                EXCEPTION
                    WHEN OTHERS THEN 
                        l_codprm := 0;
                        l_prmsab := 0;
                        l_prmdom := 0;
                        l_prmfer := 0;
                END;
            END IF;
        END IF;

        /* MERGE - CREDENCIAL X RECINTOS */
        /* Atualizo os registros atuais do colaborador, com o status alfandegado 2 - Ativo, para 0 - Não Atualizado */
        BEGIN
            UPDATE R151CCR SET STAREC = 0 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND STAREC = 1 AND STAALF = 2;
        EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMCOL: Erro de UPDATE na R151CCR p/ Não Atualizado na Base. Nro. Emp.: '
                  || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                  || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad);
                RAISERROR 103 alfmen;
        END;

        /* Incluo registros para os novos recintos, e atualizo os existentes para 1 - Atualizado */
        FOREACH C_RECINTOS INTO l_recinc.CODREC,
                                l_recinc.VERPLF,
                                l_recinc.CODPLF
        LOOP
            /* Verifico se esse recinto já está presente p/ o colaborador */
            BEGIN
                SELECT NUMCRA INTO l_numcra FROM R151CCR 
                 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND
                       VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN l_numcra := 0;
            END;

            IF (l_numcra <> 0) THEN
                /* Já existe, muda o status deste recinto pra 1 - Atualizado */
                /* Obs.: Atualizo também o status alfandegado para 2 - Ativo. */
                BEGIN
                    UPDATE R151CCR SET STAREC = 1, STAALF = 2 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND
                        VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
                EXCEPTION
                    WHEN OTHERS THEN
                        alfmen := 'SP_RECALF_PRMCOL: Erro de UPDATE na R151CCR p/ Atualizado na Base. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                        RAISERROR 103 alfmen;
                END;
            ELSE
                /* Não existe, gero uma nova pendência para este novo recinto */
                /* Insere uma pendência do evento 1 - Credenciamento de Pessoas, para envio pelo eDocs */
                SP_PENDADE02(1, 'I', l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, l_codpen OUT);

                BEGIN
                    INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                         VALUES (l_codpen, l_tipcol, l_numemp, l_tipcol, l_numcad, NULL, NULL, l_datini, l_horini, l_tipcra, NULL, NULL);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao inserir pendência de inclusão de Credenciamento de Pessoas. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;

                BEGIN
                    INSERT INTO R151CCR (CODPEN, NUMEMP, TIPCOL, NUMCAD, NUMCRA, DATINI, HORINI, DATFIM, HORFIM, TIPCRA, VERPLF, CODPLF, CODREC, STAREC, STAALF)
                         VALUES (l_codpen, l_numemp, l_tipcol, l_numcad, l_cracha, l_datini, l_horini, l_datfim, l_horfim, l_tipcra,
                                 l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, 1, 2);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao inserir crachá atual do colaborador na R151CCR. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;
            END IF;
        END LOOP; /* LOOP */

        /* Retifico registros em que as permissões da pessoa não dê mais acesso aos recintos */
        FOREACH C_R151CCR INTO l_recexc.CODREC,
                               l_recexc.VERPLF,
                               l_recexc.CODPLF,
                               l_recexc.PROTCL
        LOOP
            /* --- Envio a pendência de retificação de credencial --- */
            SP_PENDADE02(1, 'R', l_recexc.VERPLF, l_recexc.CODPLF, l_recexc.CODREC, l_codpen OUT);

            BEGIN
                INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                        VALUES (l_codpen, l_tipcol, l_numemp, l_tipcol, l_numcad, NULL, NULL, l_datini, l_horini, l_tipcra, NULL, l_recexc.PROTCL);
            EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMCOL: Erro ao inserir pendência de retificação de Credenciamento de Pessoas. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */
    
            /* --- Atualizo o status do registro para 2 - Histórico, e o recinto para 1 - Inativo. Apenas para este recinto --- */
            BEGIN
                UPDATE R151CCR SET STAREC = 2, STAALF = 1, DATFIM = l_data_atual, HORFIM = l_hora_atual
                 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND CODREC = l_recexc.CODREC AND STAREC = 0;
            EXCEPTION WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMCOL: Erro ao atualizar crachá atual do colaborador na R151CCR. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */
        END LOOP;  /* LOOP */

        /* Atualizo o status da pessoa, verificando se possui algum recinto (1 - Atualizado) com o status 2 - Ativo */
        BEGIN
            SELECT COUNT(1) INTO l_count FROM R151CCR WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND STAREC = 1 AND STAALF = 2;
        EXCEPTION WHEN NO_DATA_FOUND THEN
            l_count := 0;
        END;

        l_staalf := 1;
        BEGIN
            SELECT STAALF INTO l_staalf FROM R034FUN WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        IF (l_count > 0) THEN
            IF (l_staalf <> 2) THEN
                /* Atualizo para 2 - Ativo */
                l_staalf := 2;

                BEGIN
                    UPDATE R034FUN SET STAALF = l_staalf
                       WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao atualizar status da permissão para local alfandegado p/ ATIVO na R034FUN. Nro. Emp.: '
                      || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                      || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad);
                    RAISERROR 103 alfmen;
                END;
            END IF;
        ELSE
            IF (l_staalf = 2) THEN
                /* Atualizo para 1 - Inativo */
                l_staalf := 1;

                BEGIN
                    UPDATE R034FUN SET STAALF = l_staalf
                       WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao atualizar status da permissão para local alfandegado p/ INATIVO na R034FUN. Nro. Emp.: '
                      || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                      || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad);
                    RAISERROR 103 alfmen;
                END;
            END IF; /* IF (l_staalf = 2) THEN */
        END IF; /* IF (l_count > 0) THEN */
    END IF; /* IF (l_cracha <> 0)  THEN */
END		SENIOR;23SP_RETCRA
SP_PENDADE02
²A␀␀

PROCEDURE SP_RECALF_PRMCOL(P_NUMEMP NUMBER, P_TIPCOL NUMBER, P_NUMCAD NUMBER, P_CODPRM NUMBER, P_PRMSAB NUMBER, P_PRMDOM NUMBER, P_PRMFER NUMBER, P_NUMCRA NUMBER(12), P_DATINI DATE, P_HORINI NUMBER(4), P_DATFIM DATE, P_HORFIM NUMBER(4), P_TIPCRA NUMBER)
 IS

    l_numemp     NUMBER(4);
    l_tipcol     NUMBER(1);
    l_numcad     NUMBER(9);
    l_codprm     NUMBER;
    l_prmsab     NUMBER;
    l_prmdom     NUMBER;
    l_prmfer     NUMBER;
    l_data_atual DATE;
    l_data_zero  DATE;
    l_hora_atual NUMBER(4);
    l_codpen     NUMBER(18);
    l_count      NUMBER(3);
    l_staalf     NUMBER(1);

    l_cracha     NUMBER(12);
    l_datini     DATE;
    l_horini     NUMBER(4);
    l_datfim     DATE;
    l_horfim     NUMBER(4);
    l_tipcra     NUMBER;
    l_numcra     NUMBER(12);
    alfmen       VARCHAR2(255);

    CURSOR C_RECINTOS IS
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND GRP.CODPRM IN (l_codprm, l_prmsab, l_prmdom, l_prmfer) AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM IN (l_codprm, l_prmsab, l_prmdom, l_prmfer) AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R058PLF PLF, R070PEC PEC, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND GRP.CODPRM = PEC.CODPRM AND PEC.NUMEMP = l_numemp AND PEC.TIPCOL = l_tipcol AND PEC.NUMCAD = l_numcad
         AND PEC.STAACC = 1 AND (PEC.DATFIM = l_data_zero OR PEC.DATFIM > l_data_atual OR (PEC.DATFIM = l_data_atual AND PEC.HORFIM > l_hora_atual))
         AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R058PLF PLF, R070PEC PEC, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM = PEC.CODPRM AND PEC.NUMEMP = l_numemp AND PEC.TIPCOL = l_tipcol AND PEC.NUMCAD = l_numcad
         AND PEC.STAACC = 1 AND (PEC.DATFIM = l_data_zero OR PEC.DATFIM > l_data_atual OR (PEC.DATFIM = l_data_atual AND PEC.HORFIM > l_hora_atual))
         AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0)));

    CURSOR C_R151CCR IS
      SELECT CODREC, VERPLF, CODPLF, PROTCL FROM R151CCR WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND STAREC = 0;

    TYPE T_RECINTO IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE);

    TYPE T_R151CCR IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE,
      PROTCL   R058PLF.PROTCL%TYPE);

    l_recinc T_RECINTO;
    l_recexc T_R151CCR;

BEGIN
    /* Trouxe a atualização da l_data_zero pra cá, porque p/ SQL Server está dando problema se a procedure iniciar a partir da linha seguinte l_cracha := p_numcra;
     * Infelizmente, a tec está deixando bastante a desejar */
    l_data_zero := '31/12/1900,00:00:00';
    l_cracha := p_numcra;
    l_numemp := p_numemp;
    l_tipcol := p_tipcol;
    l_numcad := p_numcad;
    l_codprm := p_codprm;
    l_prmsab := p_prmsab;
    l_prmdom := p_prmdom;
    l_prmfer := p_prmfer;
    l_data_atual := CURDATE();
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

    /* Defino o crachá do colaborador a utilizar, se o passado como parâmetro ou buscando o vigente */
    IF (l_cracha IS NULL OR l_cracha = 0) THEN
        /* Verifica se a pessoa tem crachá válido */
        /* Obtem o crachá Provisório, se não existir obtem o Titular */
        BEGIN
          SP_RETCRA(2, l_numemp, l_tipcol, l_numcad, 0, '', 0, '', l_cracha OUT);
          IF (l_cracha = 0) THEN
            SP_RETCRA(1, l_numemp, l_tipcol, l_numcad, 0, '', 0, '', l_cracha OUT);
          END IF;
        EXCEPTION
          WHEN OTHERS THEN l_cracha := 0;
        END;

        IF (l_cracha <> 0) THEN
            /* Obtem a data/hora inicial e final do crachá ativo do colaborador. */
            BEGIN
                SELECT DATINI, HORINI, DATFIM, HORFIM, TIPCRA
                INTO l_datini, l_horini, l_datfim, l_horfim, l_tipcra
                FROM R038HCH
                WHERE NUMCRA = l_cracha AND NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND
                      (DATINI < l_data_atual OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                      (DATFIM = l_data_zero OR DATFIM > l_data_atual OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
            EXCEPTION
                WHEN TOO_MANY_ROWS THEN
                    RAISERROR 103 'SP_RECALF_PRMCOL: Erro em R038HCH - TOO MANY ROWS.';
                WHEN NO_DATA_FOUND THEN
                    RAISERROR 103 'SP_RECALF_PRMCOL: Erro em R038HCH - NO DATA FOUND.';
                WHEN OTHERS THEN
                    RAISERROR 103 'SP_RECALF_PRMCOL: Erro no SELECT R038HCH.';
            END;
        END IF;
    ELSE
        l_datini := p_datini;
        l_horini := p_horini;
        l_datfim := p_datfim;
        l_horfim := p_horfim;
        l_tipcra := p_tipcra;
    END IF;

    IF (l_cracha <> 0)  THEN
        /* Quando não vier as permissões normais do colaborador, busco. Áreas restritas já são contempladas no cursor.
           Importante: primeiro verifico se existe troca de permissão. Se não exisir, vale as permissões normais. */
        IF (l_codprm IS NULL OR l_codprm = 0) THEN
            BEGIN
                SELECT CODPRM, PRMFER, PRMDOM, PRMSAB INTO l_codprm, l_prmfer, l_prmdom, l_prmsab FROM R064TPE
                 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad
                   AND STAACC = 1 AND (DATFIM = l_data_zero OR DATFIM > l_data_atual OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
            EXCEPTION
                WHEN OTHERS THEN 
                    l_codprm := 0;
                    l_prmsab := 0;
                    l_prmdom := 0;
                    l_prmfer := 0;
            END;

            IF (l_codprm = 0) THEN
                BEGIN
                    SELECT CODPRM, PRMFER, PRMDOM, PRMSAB INTO l_codprm, l_prmfer, l_prmdom, l_prmsab FROM R034DAC 
                        WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
                EXCEPTION
                    WHEN OTHERS THEN 
                        l_codprm := 0;
                        l_prmsab := 0;
                        l_prmdom := 0;
                        l_prmfer := 0;
                END;
            END IF;
        END IF;

        /* MERGE - CREDENCIAL X RECINTOS */
        /* Atualizo os registros atuais do colaborador, com o status alfandegado 2 - Ativo, para 0 - Não Atualizado */
        BEGIN
            UPDATE R151CCR SET STAREC = 0 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND STAREC = 1 AND STAALF = 2;
        EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMCOL: Erro de UPDATE na R151CCR p/ Não Atualizado na Base. Nro. Emp.: '
                  || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                  || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad);
                RAISERROR 103 alfmen;
        END;

        /* Incluo registros para os novos recintos, e atualizo os existentes para 1 - Atualizado */
        FOREACH C_RECINTOS INTO l_recinc.CODREC,
                                l_recinc.VERPLF,
                                l_recinc.CODPLF
        LOOP
            /* Verifico se esse recinto já está presente p/ o colaborador */
            BEGIN
                SELECT NUMCRA INTO l_numcra FROM R151CCR 
                 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND
                       VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN l_numcra := 0;
            END;

            IF (l_numcra <> 0) THEN
                /* Já existe, muda o status deste recinto pra 1 - Atualizado */
                /* Obs.: Atualizo também o status alfandegado para 2 - Ativo. */
                BEGIN
                    UPDATE R151CCR SET STAREC = 1, STAALF = 2 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND
                        VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
                EXCEPTION
                    WHEN OTHERS THEN
                        alfmen := 'SP_RECALF_PRMCOL: Erro de UPDATE na R151CCR p/ Atualizado na Base. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                        RAISERROR 103 alfmen;
                END;
            ELSE
                /* Não existe, gero uma nova pendência para este novo recinto */
                /* Insere uma pendência do evento 1 - Credenciamento de Pessoas, para envio pelo eDocs */
                SP_PENDADE02(1, 'I', l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, l_codpen OUT);

                BEGIN
                    INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                         VALUES (l_codpen, l_tipcol, l_numemp, l_tipcol, l_numcad, NULL, NULL, l_datini, l_horini, l_tipcra, NULL, NULL);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao inserir pendência de inclusão de Credenciamento de Pessoas. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;

                BEGIN
                    INSERT INTO R151CCR (CODPEN, NUMEMP, TIPCOL, NUMCAD, NUMCRA, DATINI, HORINI, DATFIM, HORFIM, TIPCRA, VERPLF, CODPLF, CODREC, STAREC, STAALF)
                         VALUES (l_codpen, l_numemp, l_tipcol, l_numcad, l_cracha, l_datini, l_horini, l_datfim, l_horfim, l_tipcra,
                                 l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, 1, 2);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao inserir crachá atual do colaborador na R151CCR. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;
            END IF;
        END LOOP; /* LOOP */

        /* Retifico registros em que as permissões da pessoa não dê mais acesso aos recintos */
        FOREACH C_R151CCR INTO l_recexc.CODREC,
                               l_recexc.VERPLF,
                               l_recexc.CODPLF,
                               l_recexc.PROTCL
        LOOP
            /* --- Envio a pendência de retificação de credencial --- */
            SP_PENDADE02(1, 'R', l_recexc.VERPLF, l_recexc.CODPLF, l_recexc.CODREC, l_codpen OUT);

            BEGIN
                INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                        VALUES (l_codpen, l_tipcol, l_numemp, l_tipcol, l_numcad, NULL, NULL, l_datini, l_horini, l_tipcra, NULL, l_recexc.PROTCL);
            EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMCOL: Erro ao inserir pendência de retificação de Credenciamento de Pessoas. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */
    
            /* --- Atualizo o status do registro para 2 - Histórico, e o recinto para 1 - Inativo. Apenas para este recinto --- */
            BEGIN
                UPDATE R151CCR SET STAREC = 2, STAALF = 1, DATFIM = l_data_atual, HORFIM = l_hora_atual
                 WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND CODREC = l_recexc.CODREC AND STAREC = 0;
            EXCEPTION WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMCOL: Erro ao atualizar crachá atual do colaborador na R151CCR. Nro. Emp.: '
                          || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                          || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */
        END LOOP;  /* LOOP */

        /* Atualizo o status da pessoa, verificando se possui algum recinto (1 - Atualizado) com o status 2 - Ativo */
        BEGIN
            SELECT COUNT(1) INTO l_count FROM R151CCR WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad AND STAREC = 1 AND STAALF = 2;
        EXCEPTION WHEN NO_DATA_FOUND THEN
            l_count := 0;
        END;

        l_staalf := 1;
        BEGIN
            SELECT STAALF INTO l_staalf FROM R034FUN WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        IF (l_count > 0) THEN
            IF (l_staalf <> 2) THEN
                /* Atualizo para 2 - Ativo */
                l_staalf := 2;

                BEGIN
                    UPDATE R034FUN SET STAALF = l_staalf
                       WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao atualizar status da permissão para local alfandegado p/ ATIVO na R034FUN. Nro. Emp.: '
                      || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                      || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad);
                    RAISERROR 103 alfmen;
                END;
            END IF;
        ELSE
            IF (l_staalf = 2) THEN
                /* Atualizo para 1 - Inativo */
                l_staalf := 1;

                BEGIN
                    UPDATE R034FUN SET STAALF = l_staalf
                       WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMCOL: Erro ao atualizar status da permissão para local alfandegado p/ INATIVO na R034FUN. Nro. Emp.: '
                      || CONVERT(NUMBER_TO_CHAR, l_numemp) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_tipcol)
                      || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_numcad);
                    RAISERROR 103 alfmen;
                END;
            END IF; /* IF (l_staalf = 2) THEN */
        END IF; /* IF (l_count > 0) THEN */
    END IF; /* IF (l_cracha <> 0)  THEN */
END␀¤ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ÛPROCEDURE SP_RECALF_PRMVIS(P_TIPDOC INTEGER, P_NUMDOC VARCHAR2(20), P_CODPRM NUMBER, P_NUMCRA NUMBER(12), P_DATINI DATE, P_HORINI NUMBER(4), P_DATFIM DATE, P_HORFIM NUMBER(4), P_SEQENT NUMBER(2))
 IS
BEGIN
    NULL;
END		SENIOR;20SP_PENDADE02
ş4␀␀

PROCEDURE SP_RECALF_PRMVIS(P_TIPDOC INTEGER, P_NUMDOC VARCHAR2(20), P_CODPRM NUMBER, P_NUMCRA NUMBER(12), P_DATINI DATE, P_HORINI NUMBER(4), P_DATFIM DATE, P_HORFIM NUMBER(4), P_SEQENT NUMBER(2))
 IS

    l_tipdoc     NUMBER(1);
    l_numdoc     VARCHAR2(20);
    l_codprm     NUMBER;
    l_data_atual DATE;
    l_data_zero  DATE;
    l_hora_atual NUMBER(4);
    l_codpen     NUMBER(18);
    l_count      NUMBER(3);
    l_staalf     NUMBER(1);

    l_cracha     NUMBER(12);
    l_datini     DATE;
    l_horini     NUMBER(4);
    l_datfim     DATE;
    l_horfim     NUMBER(4);
    l_seqent     NUMBER(2);
    l_numcra     NUMBER(12);
    alfmen       VARCHAR2(255);

    CURSOR C_RECINTOS IS
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND GRP.CODPRM = l_codprm AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM = l_codprm AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R070PEV PEV, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
		 AND GRP.CODPRM = PEV.CODPRM AND PEV.TIPDOC = l_tipdoc AND PEV.NUMDOC = l_numdoc
		 AND PEV.STAACC = 1 AND (PEV.DATFIM = l_data_zero OR PEV.DATFIM > l_data_atual OR (PEV.DATFIM = l_data_atual AND PEV.HORFIM > l_hora_atual))
         AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R070PEV PEV, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM = PEV.CODPRM AND PEV.TIPDOC = l_tipdoc AND PEV.NUMDOC = l_numdoc
		 AND PEV.STAACC = 1 AND (PEV.DATFIM = l_data_zero OR PEV.DATFIM > l_data_atual OR (PEV.DATFIM = l_data_atual AND PEV.HORFIM > l_hora_atual))
		 AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0)));

    CURSOR C_R151CVR IS
      SELECT CODREC, VERPLF, CODPLF, PROTCL FROM R151CVR WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND STAREC = 0;

    TYPE T_RECINTO IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE);

    TYPE T_R151CVR IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE,
      PROTCL   R058PLF.PROTCL%TYPE);

    l_recinc T_RECINTO;
    l_recexc T_R151CVR;

BEGIN
    /* Trouxe a atualização da l_data_zero pra cá, porque p/ SQL Server está dando problema se a procedure iniciar a partir da linha seguinte l_cracha := p_numcra;
     * Infelizmente, a tec está deixando bastante a desejar */
    l_data_zero := '31/12/1900,00:00:00';
    l_cracha := p_numcra;
    l_tipdoc := p_tipdoc;
    l_numdoc := p_numdoc;
    l_codprm := p_codprm;
    l_data_atual := CURDATE();
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

    /* Defino o crachá do visitante a utilizar, se o passado como parâmetro ou buscando o vigente */
    IF (l_cracha IS NULL OR l_cracha = 0) THEN
        /* Verifica se a pessoa tem crachá válido */
        /* Obtem o crachá do visitante, e data/hora inicial/final */
        BEGIN
          SELECT NUMCRA, DATINI, HORINI, DATFIM, HORFIM, SEQENT
            INTO l_cracha, l_datini, l_horini, l_datfim, l_horfim, l_seqent FROM R090HCH
           WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND
                 (DATINI < l_data_atual OR
                  (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                 (DATFIM = l_data_zero OR
                  DATFIM > l_data_atual OR
                  (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
        EXCEPTION
          WHEN TOO_MANY_ROWS THEN
            RAISERROR 103 'SP_RECALF_PRMVIS: Erro em R090HCH - TOO MANY ROWS.';
          WHEN NO_DATA_FOUND THEN
            l_cracha := 0;
          WHEN OTHERS THEN
            RAISERROR 103 'SP_RECALF_PRMVIS: Erro no SELECT R090HCH.';
        END;
    ELSE
        l_datini := p_datini;
        l_horini := p_horini;
        l_datfim := p_datfim;
        l_horfim := p_horfim;
        l_seqent := p_seqent;
    END IF;

    IF (l_cracha <> 0)  THEN
        /* Quando não vier a permissão do visitante, busco. Áreas restritas já são contempladas no cursor. */
        IF (l_codprm IS NULL OR l_codprm = 0) THEN
            BEGIN
                SELECT CODPRM INTO l_codprm FROM R090MVI
                 WHERE DATENT = l_datini AND HORENT = l_horini AND SEQENT = l_seqent;
            EXCEPTION
                WHEN OTHERS THEN l_codprm := 0;
            END;
        END IF;

        /* MERGE - CREDENCIAL X RECINTOS */
        /* Atualizo os registros atuais do visitante, com o status alfandegado 2 - Ativo, para 0 - Não Atualizado */
        BEGIN
            UPDATE R151CVR SET STAREC = 0 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND STAREC = 1 AND STAALF = 2;
        EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMVIS: Erro de UPDATE na R151CVR p/ Não Atualizado na Base. Tipo Doc.: '
                  || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc;
                RAISERROR 103 alfmen;
        END;

        /* Incluo registros para os novos recintos, e atualizo os existentes para 1 - Atualizado */
        FOREACH C_RECINTOS INTO l_recinc.CODREC,
                                l_recinc.VERPLF,
                                l_recinc.CODPLF
        LOOP
            /* Verifico se esse recinto já está presente p/ o visitante */
            BEGIN
                SELECT NUMCRA INTO l_numcra FROM R151CVR
                 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND
                       VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN l_numcra := 0;
            END;

            IF (l_numcra <> 0) THEN
                /* Já existe, muda o status deste recinto pra 1 - Atualizado */
                /* Obs.: Atualização de crachá de visitante já é tratado na R090HCH_EU. Detalhes lá. */
                /* Obs2.: Atualizo também o status alfandegado para 2 - Ativo. */
                BEGIN
                    UPDATE R151CVR SET STAREC = 1, STAALF = 2 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND
                        VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
                EXCEPTION
                    WHEN OTHERS THEN
                        alfmen := 'SP_RECALF_PRMVIS: Erro de UPDATE na R151CVR p/ Atualizado na Base. Tipo Doc.: '
                          || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                        RAISERROR 103 alfmen;
                END;
            ELSE
                /* Não existe, gero uma nova pendência para este novo recinto */
                /* Insere uma pendência do evento 1 - Credenciamento de Pessoas, para envio pelo eDocs */
                SP_PENDADE02(1, 'I', l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, l_codpen OUT);

                BEGIN
                    INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                         VALUES (l_codpen, 4, NULL, NULL, NULL, l_tipdoc, l_numdoc, l_datini, l_horini, NULL, l_seqent, NULL);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao inserir pendência de inclusão de Credenciamento de Pessoas. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;

                BEGIN
                    INSERT INTO R151CVR (CODPEN, TIPDOC, NUMDOC, NUMCRA, DATINI, HORINI, DATFIM, HORFIM, SEQENT, VERPLF, CODPLF, CODREC, STAREC, STAALF)
                         VALUES (l_codpen, l_tipdoc, l_numdoc, l_cracha, l_datini, l_horini, l_datfim, l_horfim, l_seqent,
                      	         l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, 1, 2);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao inserir crachá atual do visitante na R151CVR. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;
            END IF;
        END LOOP; /* LOOP */

        /* Retifico registros em que as permissões da pessoa não dê mais acesso aos recintos */
        FOREACH C_R151CVR INTO l_recexc.CODREC,
                               l_recexc.VERPLF,
                               l_recexc.CODPLF,
                               l_recexc.PROTCL
        LOOP
            /* --- Envio a pendência de retificação de credencial --- */
            SP_PENDADE02(1, 'R', l_recexc.VERPLF, l_recexc.CODPLF, l_recexc.CODREC, l_codpen OUT);

            BEGIN
                INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                        VALUES (l_codpen, 4, NULL, NULL, NULL, l_tipdoc, l_numdoc, l_datini, l_horini, NULL, l_seqent, l_recexc.PROTCL);
            EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMVIS: Erro ao inserir pendência de retificação de Credenciamento de Pessoas. Tipo Doc.: '
                  || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */

            /* --- Atualizo o status do registro para 2 - Histórico, e o recinto para 1 - Inativo. Apenas para este recinto --- */
            BEGIN
                UPDATE R151CVR SET STAREC = 2, STAALF = 1, DATFIM = l_data_atual, HORFIM = l_hora_atual
                 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND CODREC = l_recexc.CODREC AND STAREC = 0;
            EXCEPTION WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMVIS: Erro ao atualizar crachá atual do visitante na R151CVR. Tipo Doc.: '
                  || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */
        END LOOP;  /* LOOP */

        /* Atualizo o status da pessoa, verificando se possui algum recinto (1 - Atualizado) com o status 2 - Ativo */
        BEGIN
            SELECT COUNT(1) INTO l_count FROM R151CVR WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND STAREC = 1 AND STAALF = 2;
        EXCEPTION WHEN NO_DATA_FOUND THEN
            l_count := 0;
        END;

        l_staalf := 1;
        BEGIN
            SELECT STAALF INTO l_staalf FROM R090VIS WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        IF (l_count > 0) THEN
            IF (l_staalf <> 2) THEN
                /* Atualizo para 2 - Ativo */
                l_staalf := 2;

                BEGIN
                    UPDATE R090VIS SET STAALF = l_staalf
                       WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao atualizar status da permissão para local alfandegado p/ ATIVO na R090VIS. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc;
                    RAISERROR 103 alfmen;
                END;
            END IF;
        ELSE
            IF (l_staalf = 2) THEN
                /* Atualizo para 1 - Inativo */
                l_staalf := 1;

                BEGIN
                    UPDATE R090VIS SET STAALF = l_staalf
                       WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao atualizar status da permissão para local alfandegado p/ INATIVO na R090VIS. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc;
                    RAISERROR 103 alfmen;
                END;
            END IF; /* IF (l_staalf = 2) THEN */
        END IF; /* IF (l_count > 0) THEN */
    END IF; /* IF (l_cracha <> 0)  THEN */
END		SENIOR;21SP_PENDADE02
ş4␀␀

PROCEDURE SP_RECALF_PRMVIS(P_TIPDOC INTEGER, P_NUMDOC VARCHAR2(20), P_CODPRM NUMBER, P_NUMCRA NUMBER(12), P_DATINI DATE, P_HORINI NUMBER(4), P_DATFIM DATE, P_HORFIM NUMBER(4), P_SEQENT NUMBER(2))
 IS

    l_tipdoc     NUMBER(1);
    l_numdoc     VARCHAR2(20);
    l_codprm     NUMBER;
    l_data_atual DATE;
    l_data_zero  DATE;
    l_hora_atual NUMBER(4);
    l_codpen     NUMBER(18);
    l_count      NUMBER(3);
    l_staalf     NUMBER(1);

    l_cracha     NUMBER(12);
    l_datini     DATE;
    l_horini     NUMBER(4);
    l_datfim     DATE;
    l_horfim     NUMBER(4);
    l_seqent     NUMBER(2);
    l_numcra     NUMBER(12);
    alfmen       VARCHAR2(255);

    CURSOR C_RECINTOS IS
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND GRP.CODPRM = l_codprm AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM = l_codprm AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R070PEV PEV, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
		 AND GRP.CODPRM = PEV.CODPRM AND PEV.TIPDOC = l_tipdoc AND PEV.NUMDOC = l_numdoc
		 AND PEV.STAACC = 1 AND (PEV.DATFIM = l_data_zero OR PEV.DATFIM > l_data_atual OR (PEV.DATFIM = l_data_atual AND PEV.HORFIM > l_hora_atual))
         AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R070PEV PEV, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM = PEV.CODPRM AND PEV.TIPDOC = l_tipdoc AND PEV.NUMDOC = l_numdoc
		 AND PEV.STAACC = 1 AND (PEV.DATFIM = l_data_zero OR PEV.DATFIM > l_data_atual OR (PEV.DATFIM = l_data_atual AND PEV.HORFIM > l_hora_atual))
		 AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0)));

    CURSOR C_R151CVR IS
      SELECT CODREC, VERPLF, CODPLF, PROTCL FROM R151CVR WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND STAREC = 0;

    TYPE T_RECINTO IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE);

    TYPE T_R151CVR IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE,
      PROTCL   R058PLF.PROTCL%TYPE);

    l_recinc T_RECINTO;
    l_recexc T_R151CVR;

BEGIN
    /* Trouxe a atualização da l_data_zero pra cá, porque p/ SQL Server está dando problema se a procedure iniciar a partir da linha seguinte l_cracha := p_numcra;
     * Infelizmente, a tec está deixando bastante a desejar */
    l_data_zero := '31/12/1900,00:00:00';
    l_cracha := p_numcra;
    l_tipdoc := p_tipdoc;
    l_numdoc := p_numdoc;
    l_codprm := p_codprm;
    l_data_atual := CURDATE();
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

    /* Defino o crachá do visitante a utilizar, se o passado como parâmetro ou buscando o vigente */
    IF (l_cracha IS NULL OR l_cracha = 0) THEN
        /* Verifica se a pessoa tem crachá válido */
        /* Obtem o crachá do visitante, e data/hora inicial/final */
        BEGIN
          SELECT NUMCRA, DATINI, HORINI, DATFIM, HORFIM, SEQENT
            INTO l_cracha, l_datini, l_horini, l_datfim, l_horfim, l_seqent FROM R090HCH
           WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND
                 (DATINI < l_data_atual OR
                  (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                 (DATFIM = l_data_zero OR
                  DATFIM > l_data_atual OR
                  (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
        EXCEPTION
          WHEN TOO_MANY_ROWS THEN
            RAISERROR 103 'SP_RECALF_PRMVIS: Erro em R090HCH - TOO MANY ROWS.';
          WHEN NO_DATA_FOUND THEN
            l_cracha := 0;
          WHEN OTHERS THEN
            RAISERROR 103 'SP_RECALF_PRMVIS: Erro no SELECT R090HCH.';
        END;
    ELSE
        l_datini := p_datini;
        l_horini := p_horini;
        l_datfim := p_datfim;
        l_horfim := p_horfim;
        l_seqent := p_seqent;
    END IF;

    IF (l_cracha <> 0)  THEN
        /* Quando não vier a permissão do visitante, busco. Áreas restritas já são contempladas no cursor. */
        IF (l_codprm IS NULL OR l_codprm = 0) THEN
            BEGIN
                SELECT CODPRM INTO l_codprm FROM R090MVI
                 WHERE DATENT = l_datini AND HORENT = l_horini AND SEQENT = l_seqent;
            EXCEPTION
                WHEN OTHERS THEN l_codprm := 0;
            END;
        END IF;

        /* MERGE - CREDENCIAL X RECINTOS */
        /* Atualizo os registros atuais do visitante, com o status alfandegado 2 - Ativo, para 0 - Não Atualizado */
        BEGIN
            UPDATE R151CVR SET STAREC = 0 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND STAREC = 1 AND STAALF = 2;
        EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMVIS: Erro de UPDATE na R151CVR p/ Não Atualizado na Base. Tipo Doc.: '
                  || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc;
                RAISERROR 103 alfmen;
        END;

        /* Incluo registros para os novos recintos, e atualizo os existentes para 1 - Atualizado */
        FOREACH C_RECINTOS INTO l_recinc.CODREC,
                                l_recinc.VERPLF,
                                l_recinc.CODPLF
        LOOP
            /* Verifico se esse recinto já está presente p/ o visitante */
            BEGIN
                SELECT NUMCRA INTO l_numcra FROM R151CVR
                 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND
                       VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN l_numcra := 0;
            END;

            IF (l_numcra <> 0) THEN
                /* Já existe, muda o status deste recinto pra 1 - Atualizado */
                /* Obs.: Atualização de crachá de visitante já é tratado na R090HCH_EU. Detalhes lá. */
                /* Obs2.: Atualizo também o status alfandegado para 2 - Ativo. */
                BEGIN
                    UPDATE R151CVR SET STAREC = 1, STAALF = 2 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND
                        VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
                EXCEPTION
                    WHEN OTHERS THEN
                        alfmen := 'SP_RECALF_PRMVIS: Erro de UPDATE na R151CVR p/ Atualizado na Base. Tipo Doc.: '
                          || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                        RAISERROR 103 alfmen;
                END;
            ELSE
                /* Não existe, gero uma nova pendência para este novo recinto */
                /* Insere uma pendência do evento 1 - Credenciamento de Pessoas, para envio pelo eDocs */
                SP_PENDADE02(1, 'I', l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, l_codpen OUT);

                BEGIN
                    INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                         VALUES (l_codpen, 4, NULL, NULL, NULL, l_tipdoc, l_numdoc, l_datini, l_horini, NULL, l_seqent, NULL);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao inserir pendência de inclusão de Credenciamento de Pessoas. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;

                BEGIN
                    INSERT INTO R151CVR (CODPEN, TIPDOC, NUMDOC, NUMCRA, DATINI, HORINI, DATFIM, HORFIM, SEQENT, VERPLF, CODPLF, CODREC, STAREC, STAALF)
                         VALUES (l_codpen, l_tipdoc, l_numdoc, l_cracha, l_datini, l_horini, l_datfim, l_horfim, l_seqent,
                      	         l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, 1, 2);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao inserir crachá atual do visitante na R151CVR. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;
            END IF;
        END LOOP; /* LOOP */

        /* Retifico registros em que as permissões da pessoa não dê mais acesso aos recintos */
        FOREACH C_R151CVR INTO l_recexc.CODREC,
                               l_recexc.VERPLF,
                               l_recexc.CODPLF,
                               l_recexc.PROTCL
        LOOP
            /* --- Envio a pendência de retificação de credencial --- */
            SP_PENDADE02(1, 'R', l_recexc.VERPLF, l_recexc.CODPLF, l_recexc.CODREC, l_codpen OUT);

            BEGIN
                INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                        VALUES (l_codpen, 4, NULL, NULL, NULL, l_tipdoc, l_numdoc, l_datini, l_horini, NULL, l_seqent, l_recexc.PROTCL);
            EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMVIS: Erro ao inserir pendência de retificação de Credenciamento de Pessoas. Tipo Doc.: '
                  || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */

            /* --- Atualizo o status do registro para 2 - Histórico, e o recinto para 1 - Inativo. Apenas para este recinto --- */
            BEGIN
                UPDATE R151CVR SET STAREC = 2, STAALF = 1, DATFIM = l_data_atual, HORFIM = l_hora_atual
                 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND CODREC = l_recexc.CODREC AND STAREC = 0;
            EXCEPTION WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMVIS: Erro ao atualizar crachá atual do visitante na R151CVR. Tipo Doc.: '
                  || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */
        END LOOP;  /* LOOP */

        /* Atualizo o status da pessoa, verificando se possui algum recinto (1 - Atualizado) com o status 2 - Ativo */
        BEGIN
            SELECT COUNT(1) INTO l_count FROM R151CVR WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND STAREC = 1 AND STAALF = 2;
        EXCEPTION WHEN NO_DATA_FOUND THEN
            l_count := 0;
        END;

        l_staalf := 1;
        BEGIN
            SELECT STAALF INTO l_staalf FROM R090VIS WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        IF (l_count > 0) THEN
            IF (l_staalf <> 2) THEN
                /* Atualizo para 2 - Ativo */
                l_staalf := 2;

                BEGIN
                    UPDATE R090VIS SET STAALF = l_staalf
                       WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao atualizar status da permissão para local alfandegado p/ ATIVO na R090VIS. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc;
                    RAISERROR 103 alfmen;
                END;
            END IF;
        ELSE
            IF (l_staalf = 2) THEN
                /* Atualizo para 1 - Inativo */
                l_staalf := 1;

                BEGIN
                    UPDATE R090VIS SET STAALF = l_staalf
                       WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao atualizar status da permissão para local alfandegado p/ INATIVO na R090VIS. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc;
                    RAISERROR 103 alfmen;
                END;
            END IF; /* IF (l_staalf = 2) THEN */
        END IF; /* IF (l_count > 0) THEN */
    END IF; /* IF (l_cracha <> 0)  THEN */
END		SENIOR;22SP_PENDADE02
ş4␀␀

PROCEDURE SP_RECALF_PRMVIS(P_TIPDOC INTEGER, P_NUMDOC VARCHAR2(20), P_CODPRM NUMBER, P_NUMCRA NUMBER(12), P_DATINI DATE, P_HORINI NUMBER(4), P_DATFIM DATE, P_HORFIM NUMBER(4), P_SEQENT NUMBER(2))
 IS

    l_tipdoc     NUMBER(1);
    l_numdoc     VARCHAR2(20);
    l_codprm     NUMBER;
    l_data_atual DATE;
    l_data_zero  DATE;
    l_hora_atual NUMBER(4);
    l_codpen     NUMBER(18);
    l_count      NUMBER(3);
    l_staalf     NUMBER(1);

    l_cracha     NUMBER(12);
    l_datini     DATE;
    l_horini     NUMBER(4);
    l_datfim     DATE;
    l_horfim     NUMBER(4);
    l_seqent     NUMBER(2);
    l_numcra     NUMBER(12);
    alfmen       VARCHAR2(255);

    CURSOR C_RECINTOS IS
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND GRP.CODPRM = l_codprm AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM = l_codprm AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R070PEV PEV, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
		 AND GRP.CODPRM = PEV.CODPRM AND PEV.TIPDOC = l_tipdoc AND PEV.NUMDOC = l_numdoc
		 AND PEV.STAACC = 1 AND (PEV.DATFIM = l_data_zero OR PEV.DATFIM > l_data_atual OR (PEV.DATFIM = l_data_atual AND PEV.HORFIM > l_hora_atual))
         AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R070PEV PEV, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM = PEV.CODPRM AND PEV.TIPDOC = l_tipdoc AND PEV.NUMDOC = l_numdoc
		 AND PEV.STAACC = 1 AND (PEV.DATFIM = l_data_zero OR PEV.DATFIM > l_data_atual OR (PEV.DATFIM = l_data_atual AND PEV.HORFIM > l_hora_atual))
		 AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0)));

    CURSOR C_R151CVR IS
      SELECT CODREC, VERPLF, CODPLF, PROTCL FROM R151CVR WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND STAREC = 0;

    TYPE T_RECINTO IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE);

    TYPE T_R151CVR IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE,
      PROTCL   R058PLF.PROTCL%TYPE);

    l_recinc T_RECINTO;
    l_recexc T_R151CVR;

BEGIN
    /* Trouxe a atualização da l_data_zero pra cá, porque p/ SQL Server está dando problema se a procedure iniciar a partir da linha seguinte l_cracha := p_numcra;
     * Infelizmente, a tec está deixando bastante a desejar */
    l_data_zero := '31/12/1900,00:00:00';
    l_cracha := p_numcra;
    l_tipdoc := p_tipdoc;
    l_numdoc := p_numdoc;
    l_codprm := p_codprm;
    l_data_atual := CURDATE();
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

    /* Defino o crachá do visitante a utilizar, se o passado como parâmetro ou buscando o vigente */
    IF (l_cracha IS NULL OR l_cracha = 0) THEN
        /* Verifica se a pessoa tem crachá válido */
        /* Obtem o crachá do visitante, e data/hora inicial/final */
        BEGIN
          SELECT NUMCRA, DATINI, HORINI, DATFIM, HORFIM, SEQENT
            INTO l_cracha, l_datini, l_horini, l_datfim, l_horfim, l_seqent FROM R090HCH
           WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND
                 (DATINI < l_data_atual OR
                  (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                 (DATFIM = l_data_zero OR
                  DATFIM > l_data_atual OR
                  (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
        EXCEPTION
          WHEN TOO_MANY_ROWS THEN
            RAISERROR 103 'SP_RECALF_PRMVIS: Erro em R090HCH - TOO MANY ROWS.';
          WHEN NO_DATA_FOUND THEN
            l_cracha := 0;
          WHEN OTHERS THEN
            RAISERROR 103 'SP_RECALF_PRMVIS: Erro no SELECT R090HCH.';
        END;
    ELSE
        l_datini := p_datini;
        l_horini := p_horini;
        l_datfim := p_datfim;
        l_horfim := p_horfim;
        l_seqent := p_seqent;
    END IF;

    IF (l_cracha <> 0)  THEN
        /* Quando não vier a permissão do visitante, busco. Áreas restritas já são contempladas no cursor. */
        IF (l_codprm IS NULL OR l_codprm = 0) THEN
            BEGIN
                SELECT CODPRM INTO l_codprm FROM R090MVI
                 WHERE DATENT = l_datini AND HORENT = l_horini AND SEQENT = l_seqent;
            EXCEPTION
                WHEN OTHERS THEN l_codprm := 0;
            END;
        END IF;

        /* MERGE - CREDENCIAL X RECINTOS */
        /* Atualizo os registros atuais do visitante, com o status alfandegado 2 - Ativo, para 0 - Não Atualizado */
        BEGIN
            UPDATE R151CVR SET STAREC = 0 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND STAREC = 1 AND STAALF = 2;
        EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMVIS: Erro de UPDATE na R151CVR p/ Não Atualizado na Base. Tipo Doc.: '
                  || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc;
                RAISERROR 103 alfmen;
        END;

        /* Incluo registros para os novos recintos, e atualizo os existentes para 1 - Atualizado */
        FOREACH C_RECINTOS INTO l_recinc.CODREC,
                                l_recinc.VERPLF,
                                l_recinc.CODPLF
        LOOP
            /* Verifico se esse recinto já está presente p/ o visitante */
            BEGIN
                SELECT NUMCRA INTO l_numcra FROM R151CVR
                 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND
                       VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN l_numcra := 0;
            END;

            IF (l_numcra <> 0) THEN
                /* Já existe, muda o status deste recinto pra 1 - Atualizado */
                /* Obs.: Atualização de crachá de visitante já é tratado na R090HCH_EU. Detalhes lá. */
                /* Obs2.: Atualizo também o status alfandegado para 2 - Ativo. */
                BEGIN
                    UPDATE R151CVR SET STAREC = 1, STAALF = 2 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND
                        VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
                EXCEPTION
                    WHEN OTHERS THEN
                        alfmen := 'SP_RECALF_PRMVIS: Erro de UPDATE na R151CVR p/ Atualizado na Base. Tipo Doc.: '
                          || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                        RAISERROR 103 alfmen;
                END;
            ELSE
                /* Não existe, gero uma nova pendência para este novo recinto */
                /* Insere uma pendência do evento 1 - Credenciamento de Pessoas, para envio pelo eDocs */
                SP_PENDADE02(1, 'I', l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, l_codpen OUT);

                BEGIN
                    INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                         VALUES (l_codpen, 4, NULL, NULL, NULL, l_tipdoc, l_numdoc, l_datini, l_horini, NULL, l_seqent, NULL);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao inserir pendência de inclusão de Credenciamento de Pessoas. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;

                BEGIN
                    INSERT INTO R151CVR (CODPEN, TIPDOC, NUMDOC, NUMCRA, DATINI, HORINI, DATFIM, HORFIM, SEQENT, VERPLF, CODPLF, CODREC, STAREC, STAALF)
                         VALUES (l_codpen, l_tipdoc, l_numdoc, l_cracha, l_datini, l_horini, l_datfim, l_horfim, l_seqent,
                      	         l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, 1, 2);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao inserir crachá atual do visitante na R151CVR. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;
            END IF;
        END LOOP; /* LOOP */

        /* Retifico registros em que as permissões da pessoa não dê mais acesso aos recintos */
        FOREACH C_R151CVR INTO l_recexc.CODREC,
                               l_recexc.VERPLF,
                               l_recexc.CODPLF,
                               l_recexc.PROTCL
        LOOP
            /* --- Envio a pendência de retificação de credencial --- */
            SP_PENDADE02(1, 'R', l_recexc.VERPLF, l_recexc.CODPLF, l_recexc.CODREC, l_codpen OUT);

            BEGIN
                INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                        VALUES (l_codpen, 4, NULL, NULL, NULL, l_tipdoc, l_numdoc, l_datini, l_horini, NULL, l_seqent, l_recexc.PROTCL);
            EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMVIS: Erro ao inserir pendência de retificação de Credenciamento de Pessoas. Tipo Doc.: '
                  || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */

            /* --- Atualizo o status do registro para 2 - Histórico, e o recinto para 1 - Inativo. Apenas para este recinto --- */
            BEGIN
                UPDATE R151CVR SET STAREC = 2, STAALF = 1, DATFIM = l_data_atual, HORFIM = l_hora_atual
                 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND CODREC = l_recexc.CODREC AND STAREC = 0;
            EXCEPTION WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMVIS: Erro ao atualizar crachá atual do visitante na R151CVR. Tipo Doc.: '
                  || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */
        END LOOP;  /* LOOP */

        /* Atualizo o status da pessoa, verificando se possui algum recinto (1 - Atualizado) com o status 2 - Ativo */
        BEGIN
            SELECT COUNT(1) INTO l_count FROM R151CVR WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND STAREC = 1 AND STAALF = 2;
        EXCEPTION WHEN NO_DATA_FOUND THEN
            l_count := 0;
        END;

        l_staalf := 1;
        BEGIN
            SELECT STAALF INTO l_staalf FROM R090VIS WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        IF (l_count > 0) THEN
            IF (l_staalf <> 2) THEN
                /* Atualizo para 2 - Ativo */
                l_staalf := 2;

                BEGIN
                    UPDATE R090VIS SET STAALF = l_staalf
                       WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao atualizar status da permissão para local alfandegado p/ ATIVO na R090VIS. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc;
                    RAISERROR 103 alfmen;
                END;
            END IF;
        ELSE
            IF (l_staalf = 2) THEN
                /* Atualizo para 1 - Inativo */
                l_staalf := 1;

                BEGIN
                    UPDATE R090VIS SET STAALF = l_staalf
                       WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao atualizar status da permissão para local alfandegado p/ INATIVO na R090VIS. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc;
                    RAISERROR 103 alfmen;
                END;
            END IF; /* IF (l_staalf = 2) THEN */
        END IF; /* IF (l_count > 0) THEN */
    END IF; /* IF (l_cracha <> 0)  THEN */
END		SENIOR;23SP_PENDADE02
ş4␀␀

PROCEDURE SP_RECALF_PRMVIS(P_TIPDOC INTEGER, P_NUMDOC VARCHAR2(20), P_CODPRM NUMBER, P_NUMCRA NUMBER(12), P_DATINI DATE, P_HORINI NUMBER(4), P_DATFIM DATE, P_HORFIM NUMBER(4), P_SEQENT NUMBER(2))
 IS

    l_tipdoc     NUMBER(1);
    l_numdoc     VARCHAR2(20);
    l_codprm     NUMBER;
    l_data_atual DATE;
    l_data_zero  DATE;
    l_hora_atual NUMBER(4);
    l_codpen     NUMBER(18);
    l_count      NUMBER(3);
    l_staalf     NUMBER(1);

    l_cracha     NUMBER(12);
    l_datini     DATE;
    l_horini     NUMBER(4);
    l_datfim     DATE;
    l_horfim     NUMBER(4);
    l_seqent     NUMBER(2);
    l_numcra     NUMBER(12);
    alfmen       VARCHAR2(255);

    CURSOR C_RECINTOS IS
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND GRP.CODPRM = l_codprm AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM = l_codprm AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058GRP GRP, R058GRL GRL, R058DSP DSP, R070PEV PEV, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
		 AND GRP.CODPRM = PEV.CODPRM AND PEV.TIPDOC = l_tipdoc AND PEV.NUMDOC = l_numdoc
		 AND PEV.STAACC = 1 AND (PEV.DATFIM = l_data_zero OR PEV.DATFIM > l_data_atual OR (PEV.DATFIM = l_data_atual AND PEV.HORFIM > l_hora_atual))
         AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0
      UNION(
      SELECT PLF.CODREC CODREC, PLF.VERPLF, PLF.CODPLF
        FROM R058RLP RLP, R058DSP DSP, R070PEV PEV, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3
         AND RLP.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF
         AND RLP.CODPRM = PEV.CODPRM AND PEV.TIPDOC = l_tipdoc AND PEV.NUMDOC = l_numdoc
		 AND PEV.STAACC = 1 AND (PEV.DATFIM = l_data_zero OR PEV.DATFIM > l_data_atual OR (PEV.DATFIM = l_data_atual AND PEV.HORFIM > l_hora_atual))
		 AND PLF.CATPLF = 9 AND PLF.CODREC IS NOT NULL AND PLF.CODREC > 0)));

    CURSOR C_R151CVR IS
      SELECT CODREC, VERPLF, CODPLF, PROTCL FROM R151CVR WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND STAREC = 0;

    TYPE T_RECINTO IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE);

    TYPE T_R151CVR IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE,
      PROTCL   R058PLF.PROTCL%TYPE);

    l_recinc T_RECINTO;
    l_recexc T_R151CVR;

BEGIN
    /* Trouxe a atualização da l_data_zero pra cá, porque p/ SQL Server está dando problema se a procedure iniciar a partir da linha seguinte l_cracha := p_numcra;
     * Infelizmente, a tec está deixando bastante a desejar */
    l_data_zero := '31/12/1900,00:00:00';
    l_cracha := p_numcra;
    l_tipdoc := p_tipdoc;
    l_numdoc := p_numdoc;
    l_codprm := p_codprm;
    l_data_atual := CURDATE();
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

    /* Defino o crachá do visitante a utilizar, se o passado como parâmetro ou buscando o vigente */
    IF (l_cracha IS NULL OR l_cracha = 0) THEN
        /* Verifica se a pessoa tem crachá válido */
        /* Obtem o crachá do visitante, e data/hora inicial/final */
        BEGIN
          SELECT NUMCRA, DATINI, HORINI, DATFIM, HORFIM, SEQENT
            INTO l_cracha, l_datini, l_horini, l_datfim, l_horfim, l_seqent FROM R090HCH
           WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND
                 (DATINI < l_data_atual OR
                  (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                 (DATFIM = l_data_zero OR
                  DATFIM > l_data_atual OR
                  (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
        EXCEPTION
          WHEN TOO_MANY_ROWS THEN
            RAISERROR 103 'SP_RECALF_PRMVIS: Erro em R090HCH - TOO MANY ROWS.';
          WHEN NO_DATA_FOUND THEN
            l_cracha := 0;
          WHEN OTHERS THEN
            RAISERROR 103 'SP_RECALF_PRMVIS: Erro no SELECT R090HCH.';
        END;
    ELSE
        l_datini := p_datini;
        l_horini := p_horini;
        l_datfim := p_datfim;
        l_horfim := p_horfim;
        l_seqent := p_seqent;
    END IF;

    IF (l_cracha <> 0)  THEN
        /* Quando não vier a permissão do visitante, busco. Áreas restritas já são contempladas no cursor. */
        IF (l_codprm IS NULL OR l_codprm = 0) THEN
            BEGIN
                SELECT CODPRM INTO l_codprm FROM R090MVI
                 WHERE DATENT = l_datini AND HORENT = l_horini AND SEQENT = l_seqent;
            EXCEPTION
                WHEN OTHERS THEN l_codprm := 0;
            END;
        END IF;

        /* MERGE - CREDENCIAL X RECINTOS */
        /* Atualizo os registros atuais do visitante, com o status alfandegado 2 - Ativo, para 0 - Não Atualizado */
        BEGIN
            UPDATE R151CVR SET STAREC = 0 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND STAREC = 1 AND STAALF = 2;
        EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMVIS: Erro de UPDATE na R151CVR p/ Não Atualizado na Base. Tipo Doc.: '
                  || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc;
                RAISERROR 103 alfmen;
        END;

        /* Incluo registros para os novos recintos, e atualizo os existentes para 1 - Atualizado */
        FOREACH C_RECINTOS INTO l_recinc.CODREC,
                                l_recinc.VERPLF,
                                l_recinc.CODPLF
        LOOP
            /* Verifico se esse recinto já está presente p/ o visitante */
            BEGIN
                SELECT NUMCRA INTO l_numcra FROM R151CVR
                 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND
                       VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN l_numcra := 0;
            END;

            IF (l_numcra <> 0) THEN
                /* Já existe, muda o status deste recinto pra 1 - Atualizado */
                /* Obs.: Atualização de crachá de visitante já é tratado na R090HCH_EU. Detalhes lá. */
                /* Obs2.: Atualizo também o status alfandegado para 2 - Ativo. */
                BEGIN
                    UPDATE R151CVR SET STAREC = 1, STAALF = 2 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND
                        VERPLF = l_recinc.VERPLF AND CODPLF = l_recinc.CODPLF AND STAREC = 0;
                EXCEPTION
                    WHEN OTHERS THEN
                        alfmen := 'SP_RECALF_PRMVIS: Erro de UPDATE na R151CVR p/ Atualizado na Base. Tipo Doc.: '
                          || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                        RAISERROR 103 alfmen;
                END;
            ELSE
                /* Não existe, gero uma nova pendência para este novo recinto */
                /* Insere uma pendência do evento 1 - Credenciamento de Pessoas, para envio pelo eDocs */
                SP_PENDADE02(1, 'I', l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, l_codpen OUT);

                BEGIN
                    INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                         VALUES (l_codpen, 4, NULL, NULL, NULL, l_tipdoc, l_numdoc, l_datini, l_horini, NULL, l_seqent, NULL);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao inserir pendência de inclusão de Credenciamento de Pessoas. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;

                BEGIN
                    INSERT INTO R151CVR (CODPEN, TIPDOC, NUMDOC, NUMCRA, DATINI, HORINI, DATFIM, HORFIM, SEQENT, VERPLF, CODPLF, CODREC, STAREC, STAALF)
                         VALUES (l_codpen, l_tipdoc, l_numdoc, l_cracha, l_datini, l_horini, l_datfim, l_horfim, l_seqent,
                      	         l_recinc.VERPLF, l_recinc.CODPLF, l_recinc.CODREC, 1, 2);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao inserir crachá atual do visitante na R151CVR. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recinc.CODREC);
                    RAISERROR 103 alfmen;
                END;
            END IF;
        END LOOP; /* LOOP */

        /* Retifico registros em que as permissões da pessoa não dê mais acesso aos recintos */
        FOREACH C_R151CVR INTO l_recexc.CODREC,
                               l_recexc.VERPLF,
                               l_recexc.CODPLF,
                               l_recexc.PROTCL
        LOOP
            /* --- Envio a pendência de retificação de credencial --- */
            SP_PENDADE02(1, 'R', l_recexc.VERPLF, l_recexc.CODPLF, l_recexc.CODREC, l_codpen OUT);

            BEGIN
                INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                        VALUES (l_codpen, 4, NULL, NULL, NULL, l_tipdoc, l_numdoc, l_datini, l_horini, NULL, l_seqent, l_recexc.PROTCL);
            EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMVIS: Erro ao inserir pendência de retificação de Credenciamento de Pessoas. Tipo Doc.: '
                  || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */

            /* --- Atualizo o status do registro para 2 - Histórico, e o recinto para 1 - Inativo. Apenas para este recinto --- */
            BEGIN
                UPDATE R151CVR SET STAREC = 2, STAALF = 1, DATFIM = l_data_atual, HORFIM = l_hora_atual
                 WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND CODREC = l_recexc.CODREC AND STAREC = 0;
            EXCEPTION WHEN OTHERS THEN
                alfmen := 'SP_RECALF_PRMVIS: Erro ao atualizar crachá atual do visitante na R151CVR. Tipo Doc.: '
                  || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_recexc.CODREC);
                RAISERROR 103 alfmen;
            END;
            /* --- --- */
        END LOOP;  /* LOOP */

        /* Atualizo o status da pessoa, verificando se possui algum recinto (1 - Atualizado) com o status 2 - Ativo */
        BEGIN
            SELECT COUNT(1) INTO l_count FROM R151CVR WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc AND STAREC = 1 AND STAALF = 2;
        EXCEPTION WHEN NO_DATA_FOUND THEN
            l_count := 0;
        END;

        l_staalf := 1;
        BEGIN
            SELECT STAALF INTO l_staalf FROM R090VIS WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        IF (l_count > 0) THEN
            IF (l_staalf <> 2) THEN
                /* Atualizo para 2 - Ativo */
                l_staalf := 2;

                BEGIN
                    UPDATE R090VIS SET STAALF = l_staalf
                       WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao atualizar status da permissão para local alfandegado p/ ATIVO na R090VIS. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc;
                    RAISERROR 103 alfmen;
                END;
            END IF;
        ELSE
            IF (l_staalf = 2) THEN
                /* Atualizo para 1 - Inativo */
                l_staalf := 1;

                BEGIN
                    UPDATE R090VIS SET STAALF = l_staalf
                       WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'SP_RECALF_PRMVIS: Erro ao atualizar status da permissão para local alfandegado p/ INATIVO na R090VIS. Tipo Doc.: '
                      || CONVERT(NUMBER_TO_CHAR, l_tipdoc) || '. Nro. Doc.: ' || l_numdoc;
                    RAISERROR 103 alfmen;
                END;
            END IF; /* IF (l_staalf = 2) THEN */
        END IF; /* IF (l_count > 0) THEN */
    END IF; /* IF (l_cracha <> 0)  THEN */
END␀¥ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
„PROCEDURE SP_RECALF_R_CRAVIS(P_TIPDOC INTEGER, P_NUMDOC VARCHAR2(20), P_DATFIM DATE, P_HORFIM NUMBER(4))
 IS
BEGIN
    NULL;
END		SENIOR;20SP_PENDADE02
␀␀

PROCEDURE SP_RECALF_R_CRAVIS(P_TIPDOC INTEGER, P_NUMDOC VARCHAR2(20), P_DATFIM DATE, P_HORFIM NUMBER(4))
 IS

    CURSOR C_R151CVR IS
      SELECT DATINI, HORINI, SEQENT, CODREC, VERPLF, CODPLF, PROTCL FROM R151CVR
       WHERE TIPDOC = p_tipdoc AND NUMDOC = p_numdoc AND STAREC = 1;

    TYPE T_R151CVR IS RECORD (
      DATINI   R151CVR.DATINI%TYPE,
      HORINI   R151CVR.HORINI%TYPE,
      SEQENT   R151CVR.SEQENT%TYPE,
      CODREC   R151CVR.CODREC%TYPE,
      VERPLF   R151CVR.VERPLF%TYPE,
      CODPLF   R151CVR.CODPLF%TYPE,
      PROTCL   R151CVR.PROTCL%TYPE);

    l_codpen NUMBER(18);
    alfmen   VARCHAR2(255);
    l_151cvr T_R151CVR;
    l_datval DATE;
    l_horval NUMBER(4);
BEGIN
    /* Busco todos os recintos por crachá do visitante, para gerar pendência de retificação */
    FOREACH C_R151CVR INTO l_151cvr.DATINI,
                           l_151cvr.HORINI,
                           l_151cvr.SEQENT,
                           l_151cvr.CODREC,
                           l_151cvr.VERPLF,
                           l_151cvr.CODPLF,
                           l_151cvr.PROTCL
    LOOP
        BEGIN
            SELECT DATVAL, HORVAL INTO l_datval, l_horval FROM R090MVI
             WHERE DATENT = l_151cvr.DATINI AND HORENT = l_151cvr.HORINI AND SEQENT = l_151cvr.SEQENT;
        EXCEPTION
            WHEN OTHERS THEN 
                l_datval := '31/12/2050,00:00:00';
                l_horval := 0;
        END;

        /* Gero pendência de retificação APENAS se a data/hora fim for menor que a data/hora da validade da movimentação de visita  */
        IF (p_datfim < l_datval) OR ((p_datfim = l_datval) AND (p_horfim < l_horval)) THEN
            SP_PENDADE02(1, 'R', l_151cvr.VERPLF, l_151cvr.CODPLF, l_151cvr.CODREC, l_codpen OUT);

            BEGIN
                INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                    VALUES (l_codpen, 4, NULL, NULL, NULL, p_tipdoc, p_numdoc, l_151cvr.DATINI, l_151cvr.HORINI, NULL, l_151cvr.SEQENT, l_151cvr.PROTCL);
            EXCEPTION
            WHEN OTHERS THEN
                alfmen := 'SP_RECALF_R_CRAVIS: Erro ao inserir pendência de retificação de Credenciamento de Pessoas. Tipo Doc.: '
                  || CONVERT(NUMBER_TO_CHAR, p_tipdoc) || '. Nro. Doc.: ' || p_numdoc || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_151cvr.CODREC);
                RAISERROR 103 alfmen;
            END;
        END IF;
    END LOOP;

    /* --- Atualizo o status do registro para 2 - Histórico, e o recinto para 1 - Inativo. Para todos os recintos --- */
    BEGIN
        UPDATE R151CVR SET STAREC = 2, STAALF = 1, DATFIM = p_datfim, HORFIM = p_horfim
         WHERE TIPDOC = p_tipdoc AND NUMDOC = p_numdoc;
    EXCEPTION WHEN OTHERS THEN
        alfmen := 'SP_RECALF_R_CRAVIS: Erro ao atualizar crachá atual do visitante na R151CVR. Tipo Doc.: '
          || CONVERT(NUMBER_TO_CHAR, p_tipdoc) || '. Nro. Doc.: ' || p_numdoc || '. Recinto: Todos';
        RAISERROR 103 alfmen;
    END;
    /* --- --- */

    /* Garanto para que o status não permaneça como 2 - Ativo */
    BEGIN
        UPDATE R090VIS SET STAALF = 1 WHERE TIPDOC = p_tipdoc AND NUMDOC = p_numdoc;
    EXCEPTION WHEN OTHERS THEN
        alfmen := 'SP_RECALF_R_CRAVIS: Erro ao atualizar status da permissão para local alfandegado p/ INATIVO na R090VIS. Tipo Doc.: '
          || CONVERT(NUMBER_TO_CHAR, p_tipdoc) || '. Nro. Doc.: ' || p_numdoc;
        RAISERROR 103 alfmen;
    END;

