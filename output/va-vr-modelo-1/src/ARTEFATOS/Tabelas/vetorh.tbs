      SP_PORCOM(l_valstr, '0');
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'SP_PEND60: Erro ao gerar pendência 60.';
  END;
END		SENIOR;23.SP_DATSTR
SP_INTSTR
SP_STRTOSTR
SP_PORCOM
«␀␀

PROCEDURE SP_PEND60(P_IDTPES CHAR(23),P_NOMPES VARCHAR2(40),P_NUMPIS NUMBER(11),P_DDIFON NUMBER(3),P_DDDFON NUMBER(3),P_NUMFON VARCHAR2(20),P_PESBLO NUMBER(1),P_DESBLO VARCHAR2(30))
 IS

l_PisStr      VARCHAR2(11);
  l_tamNum      NUMBER(3);    /* variável auxiliar para determinar o tamanho das strings */
  l_tamNom      VARCHAR2(3);  /* tamanho do nome da pessoa */
  l_tamFon      VARCHAR2(2);  /* tamanho do telefone */
  l_tamMot      VARCHAR2(2);  /* tamanho do motivo de bloqueio */

  l_NomOri      VARCHAR2(40); /* Nome original */
  l_NomCon      VARCHAR2(40); /* Nome convertido */

  l_DDIStr      VARCHAR2(5);
  l_DDDStr      VARCHAR2(7);
  l_FonStr      VARCHAR2(50);
  l_BloStr      CHAR(1);

  l_valstr     VARCHAR2(2047);

  l_datatu     DATE;
  l_horatu     NUMBER(4);
  l_seqenv     NUMBER(2);
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datenv     CHAR(16);
  l_seqstr     CHAR(2);
  l_desblo     CHAR(30);
BEGIN

  /* Calcula  data/hora de envio da pendência.*/
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

  /* retira os acentos e caracteres especiais do nome */
  IF (p_NomPes IS NULL) THEN
    l_NomOri := '';
  ELSE
    l_NomOri := UPPER(p_NomPes);
  END IF;
  
  SP_STRTOSTR(l_NomOri, l_NomCon OUT);

  SP_INTSTR(p_numpis,'99999999999',l_PisStr OUT);
  
  IF (l_PisStr IS NULL) THEN
	l_PisStr := '';
  END IF;
  
  IF (P_PESBLO IS NULL) THEN
    l_BloStr := '0';
  ELSE
    SP_INTSTR(p_pesBlo,'9',l_BloStr OUT);
  END IF;

  /* Concatena o telefone */
  IF (p_DDIFon > 0) THEN
      SP_INTSTR(p_DDIFon,'999',l_DDIStr OUT);
      l_DDIStr := lTrim(l_DDIStr);
      l_DDIStr := rTrim(l_DDIStr);
      l_DDIStr := '+' || l_DDIStr;
  ELSE
      l_DDIStr := '';
  END IF;


  IF (p_DDDFon > 0) THEN
      SP_INTSTR(p_DDDFon,'999',l_DDDStr OUT);
      l_DDDStr := lTrim(l_DDDStr);
      l_DDDStr := rTrim(l_DDDStr);
      l_DDDStr := '(' || l_DDDStr ||')';
  ELSE
      l_DDDStr := '';
  END IF;

  IF (p_NumFon = '') OR (p_NumFon IS NULL) THEN
      l_FonStr := '';
  ELSE
      l_FonStr := lTrim(p_NumFon);
      l_FonStr := rTrim(l_FonStr);
      l_FonStr :=  l_DDISTr || l_DDDStr || l_FonStr;
  END IF;

  /* Calcula o tamanho das strings */
  l_TamNum := LENGTH(l_NomCon);
  SP_INTSTR(l_TamNum,'999',l_tamNom OUT);

  l_TamNum := LENGTH(l_FonStr);
  SP_INTSTR(l_TamNum,'99',l_tamFon OUT);

  IF (p_desBlo IS NULL) THEN
    l_desblo := '';
    l_TamNum := 0;
    l_tamMot := '00';
  ELSE
    l_desblo := p_DesBlo;
    l_TamNum := LENGTH(p_desBlo);
    SP_INTSTR(l_TamNum,'99',l_tamMot OUT);
  END IF;

  /* monta o comando */
  l_valstr := '60' || l_datenv || p_idtpes;
  IF (l_TamNom IS NULL) OR (l_TamNom = 0) THEN
    l_valstr := l_valstr || '000';
  ELSE
    l_valstr := l_valstr || l_TamNom || l_NomCon;
  END IF;

  l_valstr := l_valstr || l_PisStr;

  IF (l_TamFon IS NULL) OR (l_TamFon = 0) THEN
    l_valstr := l_valstr || '00';
  ELSE
    l_valstr := l_valstr || l_TamFon || l_FonStr;
  END IF;

  IF (l_BloStr IS NULL) THEN
      l_BloStr := '0';
  END IF;

  IF  (l_BloStr = '0') AND ((l_TamMot IS NULL) OR (l_TamMot = 0)) THEN
    l_valstr := l_valstr || l_BloStr || '00';
  ELSE
    l_valstr := l_valstr || l_BloStr || l_TamMot || l_desblo;
  END IF;

  /* envia o comando */
  BEGIN
      SP_PORCOM(l_valstr, '0');
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'SP_PEND60: Erro ao gerar pendência 60.';
  END;
END␀qø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀
PROCEDURE SP_PEND62(P_TIPOPE VARCHAR2(1),P_NUMCRA NUMBER(12),P_NUMFIS NUMBER(12),P_TECCRA NUMBER(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1), P_NUMCPF NUMBER(11))
 IS
BEGIN
   NULL;
END		SENIOR;24?SP_GERSEN
SP_DATSTR
SP_INTSTR
SP_PORCOMDSP
SP_RET_RESPLEG
»N␀␀

PROCEDURE SP_PEND62(P_TIPOPE VARCHAR2(1),P_NUMCRA NUMBER(12),P_NUMFIS NUMBER(12),P_TECCRA NUMBER(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1), P_NUMCPF NUMBER(11))
 IS

  l_datatu        DATE;
  l_horatu        NUMBER(4);
  l_datstr        CHAR(6);
  l_horstr        CHAR(4);
  l_datAux        CHAR(10);
  l_ValAux        CHAR(10);
  l_datenv        CHAR(16);
  l_count         NUMBER;
  l_insere        BOOLEAN;
  l_anostr        CHAR(2);
  l_tipope        VARCHAR2(1);
  l_coddsp        CHAR(9);
  l_Straux        VARCHAR2(2047);
  l_CenPen        VARCHAR2(1);
  l_data_atual    DATE;
  l_hora_atual    NUMBER(4);
  l_seqenv        NUMBER(2);
  l_seqstr        CHAR(2);
  l_gersen        BOOLEAN;
  l_numfis        CHAR(12);
  l_teccra        NUMBER(1);
  l_tcraux        CHAR(1);
  l_idtpes        VARCHAR2(23);
  l_tamnom        NUMBER(3);
  l_tamnom_str    CHAR(3);
  l_nomfun        VARCHAR2(40);
  l_numId         CHAR(11);
  l_numpis        CHAR(11);
  l_numcpf        CHAR(11);
  l_altbio        CHAR(1);
  l_cpf_repleg    NUMBER(11);
  l_cpf_repleg_str CHAR(11);
  
  /* busca dispositivos SDK, não REPs, verificando todas permissões */
  CURSOR c_r058prm IS
  SELECT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN
         FROM R058RLP A, R058RLG B, R058MOD D, R058DRV E, R058DSP F
         WHERE
         A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = E.CODDRV AND E.VERDRV > 5 AND
		 F.CODDSP = B.CODDSP AND F.STADSP = 1     /*Dispositivo deve estar ativo*/
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DRV E, R058DSP F
         WHERE A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = E.CODDRV AND E.VERDRV > 5 AND
		 F.CODDSP = C.CODDSP AND F.STADSP = 1);   /*Dispositivo deve estar ativo*/

  TYPE t_r058prm IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm t_r058prm;

  /* busca todos os dispositivos SDK, indepentende de permissão*/
  CURSOR c_r058prm2 IS
  SELECT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN
         FROM R058RLG A, R058MOD B, R058DRV E, R058DSP F
         WHERE A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND ((B.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (B.FABMOD > 2) AND
               B.CODDRV = E.CODDRV AND E.VERDRV > 5)  AND
			   F.CODDSP = A.CODDSP AND F.STADSP = 1;   /*Dispositivo deve estar ativo*/

  TYPE t_r058prm2 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm2 t_r058prm2;

  /* CURSOR para gerar a lista de exclusão
   o primeiro parãmetro p_codprm não é o codprm normal
   é usado a primeira posição como parâmtro da permissão que vai mudar
   os outros parâmetros são as demais permissões que ele tem
   busca dispositivos SDK que estão na permissão informada no primeiro parâmetro p_CodPrm */
  CURSOR c_r058prm3 IS
  SELECT DISTINCT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN
         FROM R058RLP A, R058RLG B, R058MOD D, R058DRV I, R058DSP F
         WHERE
         A.CODPRM  = (p_CodPrm) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = I.CODDRV AND I.VERDRV > 5
         AND
         B.CODDSP NOT IN
           (SELECT F.CODDSP
            FROM R058RLP E, R058RLG F, R058MOD H, R058DRV J
            WHERE
            E.CODPRM IN (p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
            E.CODPLT = F.CODPLT AND E.CODRLG = F.CODRLG AND
            F.MODRLG = H.MODRLG AND F.COMRLG = 2 AND
            ((H.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (H.FABMOD > 2)) AND
            H.CODDRV = J.CODDRV AND J.VERDRV > 5) AND
		 F.CODDSP = B.CODDSP AND F.STADSP = 1   /*Dispositivo deve estar ativo*/
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DRV I, R058DSP F
         WHERE A.CODPRM = p_CodPrm AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = I.CODDRV AND I.VERDRV > 5
         AND
         C.CODDSP NOT IN
           (SELECT G.CODDSP
            FROM R058GRP E, R058GRL F, R058RLG G, R058MOD H, R058DRV J
            WHERE E.CODPRM IN (p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
            E.CODGRR = F.CODGRR AND
            F.CODPLT = G.CODPLT  AND F.CODRLG = G.CODRLG AND G.COMRLG = 2 AND
            G.MODRLG = H.MODRLG AND ((H.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (H.FABMOD > 2)) AND
            H.CODDRV = J.CODDRV AND J.VERDRV > 5) AND
		 F.CODDSP = C.CODDSP AND F.STADSP = 1); /*Dispositivo deve estar ativo*/

  TYPE t_r058prm3 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm3 t_r058prm3;


  /* CURSOR para buscar todos os dispositivos SDK que não
  estão na permissão, para gerar delete ao trocar VERPRM */
  CURSOR c_r058prm4 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN
        FROM R058RLG A, R058MOD B, R058DRV E, R058DSP F
        WHERE
        A.MODRLG = B.MODRLG AND A.COMRLG = 2
        AND ((B.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (B.FABMOD > 2))
        AND NOT EXISTS (SELECT C.CODPLT, C.CODRLG FROM R058RLP C WHERE
        C.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
        A.CODPLT = C.CODPLT AND A.CODRLG = C.CODRLG)
        AND NOT EXISTS (SELECT D.CODPLT, D.CODRLG FROM R058GRL D, R058GRP E, R058DRV F WHERE
        E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
        E.CODGRR = D.CODGRR AND
        A.CODPLT = D.CODPLT AND A.CODRLG = D.CODRLG AND
	      B.CODDRV = F.CODDRV AND F.VERDRV > 5) AND
	      F.CODDSP = A.CODDSP AND F.STADSP = 1 AND /*Dispositivo deve estar ativo*/
              B.CODDRV = E.CODDRV;
  
  TYPE t_r058prm4 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm4 t_r058prm4;

BEGIN
   l_count:= 0;
   /* Verifica se a pessoa tem biometria quando não é um evento de exlusão ou inclusão(p_altbio = 2 ou 3). */
   IF p_altbio < 2 THEN
      BEGIN
          SELECT COUNT(*) INTO l_count FROM R070BIO WHERE IDTPES = p_idtpes;
      EXCEPTION
           WHEN OTHERS THEN l_count:= 0;
      END;
   END IF;

   IF (l_count > 0) OR (p_altbio > 1) THEN
       SP_GERSEN(l_gersen OUT);
       l_CenPen:= '0';

       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

       SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
       SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);

       /*Obtem o Segundo*/
       l_seqenv := SECOND(CURTIME());
       SP_INTSTR(l_seqenv, '99', l_seqstr OUT);

       l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

       /*Número Crachá*/
       SP_INTSTR(p_numfis,'999999999999',l_numfis OUT);

       /*Tecnologia do Crachá*/
       l_teccra := p_teccra;
       SP_INTSTR(l_teccra,'9',l_tcraux OUT);

       /*Identificador da Pessoa*/
       l_idtpes := p_idtpes;

       /*Responsável Legal pela alteração*/
       SP_RET_RESPLEG(l_idtpes, l_cpf_repleg OUT);
       IF l_cpf_repleg IS NULL THEN
         l_cpf_repleg := 0;
       END IF;
       SP_INTSTR(l_cpf_repleg,'99999999999', l_cpf_repleg_str OUT);

       /*Nome da Pessoa*/
       l_nomfun := p_nomfun;
       l_nomfun := lTrim(l_nomfun);
       l_nomfun := rTrim(l_nomfun);

       /*tamanho do Nome da pessoa*/
       l_tamnom := Length(l_nomfun);
       SP_INTSTR(l_tamnom,'999',l_tamnom_str OUT);

       /* Repasso tambem o PIS e o CPF em campos distintos, 
        * para que a CSM Center não precise adivinhar o documento */
       SP_INTSTR(p_numpis,'99999999999',l_numpis OUT);
       SP_INTSTR(p_numcpf,'99999999999',l_numcpf OUT);

       /* Informa o CPF quando não há PIS (alteração para a portaria 671) */
       IF (p_numpis > 0) THEN
         l_numId := l_numpis;
       ELSE
         l_numId := l_numcpf;
       END IF;

       /* Se operação for excluir crachá ou pessoa... */
       IF (CONVERT(CHAR_TO_NUMBER, l_tipope) > 0) THEN
	     l_altbio := '2'; /* Excluir bio */
	   ELSE
	     l_altbio := '1'; /* Alterar bio */
	   END IF;

       l_datatu    := CURDATE();
       l_horatu    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

       SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
       SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);

       /* data atual string no formato YYMMDDHHmm*/
       l_DatAux := SUBSTRING(l_datstr,5,2)||SUBSTRING(l_datstr,3,2)||SUBSTRING(l_datstr,1,2)||l_horstr;
       /* converte a data de validade no formato string YYMMDDHHmm*/
       l_ValAux :=  SUBSTRING(p_datval,5,2)||SUBSTRING(p_datval,3,2)||SUBSTRING(p_datval,1,2)||SUBSTRING(p_datval,7,4);

       /*Evitar que seja inserido registro INSERT com data passada. Se for I, data validade tem que ser maior igual a data atual*/
       IF (p_tipOpe <> 'I') OR ((p_tipOpe = 'I') AND (l_valAux >= l_DatAux)) THEN
         /* verifica se é geração da lista de exclusão */
         IF (p_tipOpe = 'D') OR (p_tipOpe = 'E') THEN
           /*Parâmetro "D" é usado em todas as exclusões do REP, na TR070CON, exceto na troca do VERPRM.*/
           /*Gera na R070ACR registros para exclusão no REP, que alteraram alguma permissão*/
           IF (p_tipOpe = 'D') THEN
               /* LOOP dos dispositivos que estão dentro da permissão */
               FOREACH c_r058prm3 INTO l_r058prm3.numeip,
                                       l_r058prm3.tiplei,
                                       l_r058prm3.coddsp,
                                       l_r058prm3.fabmod,
                                       l_r058prm3.codcen
               LOOP
                    /* Multitecnologia */
                    IF (l_r058prm3.tiplei = 11) THEN
                        BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                          SELECT COUNT(1) INTO l_count
                            FROM R058RLG A
                                ,R058LEC B
                           WHERE A.CODDSP = l_r058prm3.coddsp
                             AND A.CODPLT = B.CODPLT
                             AND A.CODRLG = B.CODRLG
                             AND B.LEICRA = 4;
                          IF (l_count > 0) THEN
                            l_insere := TRUE;
                          END IF;
                        EXCEPTION
                          WHEN OTHERS THEN l_count := 0;
                        END;
                    END IF;

                    IF (p_numcra = p_numfis) THEN
                       l_insere := TRUE;
                    END IF;

                    IF (l_insere = TRUE) THEN
                      IF (l_gersen = TRUE) THEN
                         SP_INTSTR(l_r058prm3.coddsp,'999999999',l_coddsp OUT);

                         /* tipope 1 = remove card */
                         l_tipope := '1';
                         l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                         SP_PORCOMDSP(l_StrAux, l_r058prm3.codcen);

                      END IF;
                    END IF;
               END LOOP;
            ELSE
               /*Passa aqui, quando o parâmetro de exclusão for "E" */
               /*Parâmetro "E" é passado na troca do VERPRM, caso seja feita alteração de Não para SIM (Verifica Permissão)*/
               /*Gera na R070ACR registros para exclusão no REP, que estão fora da permissão do colaborador*/
               /* LOOP dos dispositivos que estão dentro da permissão */
               FOREACH c_r058prm4 INTO l_r058prm4.numeip,
                                       l_r058prm4.tiplei,
                                       l_r058prm4.coddsp,
                                       l_r058prm4.fabmod,
                                       l_r058prm4.codcen
               LOOP
                   /* trata registro de acordo com a leitora e tecnologia do crachá */
                   l_insere := FALSE;

                   /* Multitecnologia */
                   IF (l_r058prm4.tiplei = 11) THEN
                       BEGIN
                         /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                         SELECT COUNT(1) INTO l_count
                           FROM R058RLG A
                               ,R058LEC B
                          WHERE A.CODDSP = l_r058prm4.coddsp
                            AND A.CODPLT = B.CODPLT
                            AND A.CODRLG = B.CODRLG
                            AND B.LEICRA = 4;
                         IF (l_count > 0) THEN
                           l_insere := TRUE;
                         END IF;
                       EXCEPTION
                         WHEN OTHERS THEN
                           l_count := 0;
                       END;
                   END IF;

                   IF (p_numcra = p_numfis) THEN
                      l_insere := TRUE;
                   END IF;

                   IF (l_insere = TRUE) THEN
                     IF (l_gersen = TRUE) THEN
                       SP_INTSTR(l_r058prm4.coddsp,'999999999',l_coddsp OUT);

                       /* tipope 1 = remove card */
                       l_tipope := '1';
                       l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                       SP_PORCOMDSP(l_StrAux, l_r058prm4.codcen);
                     END IF;
                   END IF;
               END LOOP;
            END IF;
         ELSE
             /* para operação normal de INSERT e delete */
             IF (p_tipope = 'F') OR (p_tipope = 'D') THEN
               l_tipope := '1';
             ELSE
               l_tipope := '0';
             END IF;

             IF (p_verPrm = 1) THEN /* verprm = 'S' */

                 /* LOOP dos dispositivos que estão dentro da permissão*/
                 FOREACH c_r058prm INTO l_r058prm.numeip,
                                        l_r058prm.tiplei,
                                        l_r058prm.coddsp,
                                        l_r058prm.fabmod,
                                        l_r058prm.codcen
                 LOOP
                     /* trata registro de acordo com a leitora e tecnologia do crachá */
                     l_insere := FALSE;
                       /* Multitecnologia */
                     IF (l_r058prm.tiplei = 11) THEN
                         BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                           SELECT COUNT(1) INTO l_count
                             FROM R058RLG A
                                 ,R058LEC B
                            WHERE A.CODDSP = l_r058prm.coddsp
                              AND A.CODPLT = B.CODPLT
                              AND A.CODRLG = B.CODRLG
                              AND B.LEICRA = 4;
                           IF (l_count > 0) THEN
                             l_insere := TRUE;
                           END IF;
                         EXCEPTION
                           WHEN OTHERS THEN
                             l_count := 0;
                         END;

                       IF (p_numcra = p_numfis) THEN
                        l_insere := TRUE;
                       END IF;

                     END IF;

                     IF (l_insere = TRUE) THEN
                         /*verifica se já existe um registro ainda não enviado para este crachá e dispositivo */
                       IF (l_gersen = TRUE) THEN
                         SP_INTSTR(l_r058prm.coddsp,'999999999',l_coddsp OUT);
                         l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                         SP_PORCOMDSP(l_StrAux, l_r058prm.codcen);
                       END IF;
                     END IF;
                 END LOOP;
             ELSE
                 /* se não verifica permissão, gera para todos os dispositivos REP */
                 FOREACH c_r058prm2 INTO l_r058prm2.numeip,
                                         l_r058prm2.tiplei,
                                         l_r058prm2.coddsp,
                                         l_r058prm2.fabmod,
                                         l_r058prm2.codcen
                 LOOP
                     /* trata registro de acordo com a leitora e tecnologia do crachá */
                     l_insere := FALSE;

                     /* Multitecnologia */
                     IF (l_r058prm2.tiplei = 11) THEN
                         BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                           SELECT COUNT(1) INTO l_count
                             FROM R058RLG A
                                 ,R058LEC B
                            WHERE A.CODDSP = l_r058prm2.coddsp
                              AND A.CODPLT = B.CODPLT
                              AND A.CODRLG = B.CODRLG
                              AND B.LEICRA = 4;
                           IF (l_count > 0) THEN
                             l_insere := TRUE;
                           END IF;
                         EXCEPTION
                           WHEN OTHERS THEN
                             l_count := 0;
                         END;

                         IF (p_numcra = p_numfis) THEN
                          l_insere := TRUE;
                         END IF;
                     END IF;

                     IF (l_insere = TRUE) THEN
                       IF (l_gersen = TRUE) THEN
                          SP_INTSTR(l_r058prm2.CodDsp,'999999999',l_coddsp OUT);
                          l_tipope := '0';
                          l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                          SP_PORCOMDSP(l_StrAux, l_r058prm2.codcen);
                       END IF;
                     END IF;

                 END LOOP;
             END IF;
         END IF;
       END IF;
   END IF;
END		SENIOR;20?SP_GERSEN
SP_DATSTR
SP_INTSTR
SP_PORCOMDSP
SP_RET_RESPLEG
¢N␀␀

PROCEDURE SP_PEND62(P_TIPOPE VARCHAR2(1),P_NUMCRA NUMBER(12),P_NUMFIS NUMBER(12),P_TECCRA NUMBER(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1), P_NUMCPF NUMBER(11))
 IS

  l_datatu        DATE;
  l_horatu        NUMBER(4);
  l_datstr        CHAR(6);
  l_horstr        CHAR(4);
  l_datAux        CHAR(10);
  l_ValAux        CHAR(10);
  l_datenv        CHAR(16);
  l_count         NUMBER;
  l_insere        BOOLEAN;
  l_anostr        CHAR(2);
  l_tipope        VARCHAR2(1);
  l_coddsp        CHAR(9);
  l_Straux        VARCHAR2(2047);
  l_CenPen        VARCHAR2(1);
  l_data_atual    DATE;
  l_hora_atual    NUMBER(4);
  l_seqenv        NUMBER(2);
  l_seqstr        CHAR(2);
  l_gersen        BOOLEAN;
  l_numfis        CHAR(12);
  l_teccra        NUMBER(1);
  l_tcraux        CHAR(1);
  l_idtpes        VARCHAR2(23);
  l_tamnom        NUMBER(3);
  l_tamnom_str    CHAR(3);
  l_nomfun        VARCHAR2(40);
  l_numId         CHAR(11);
  l_numpis        CHAR(11);
  l_numcpf        CHAR(11);
  l_altbio        CHAR(1);
  l_cpf_repleg    NUMBER(11);
  l_cpf_repleg_str CHAR(11);
  
  /* busca dispositivos SDK, não REPs, verificando todas permissões */
  CURSOR c_r058prm IS
  SELECT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN
         FROM R058RLP A, R058RLG B, R058MOD D, R058DRV E, R058DSP F
         WHERE
         A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = E.CODDRV AND E.VERDRV > 5 AND
		 F.CODDSP = B.CODDSP AND F.STADSP = 1     /*Dispositivo deve estar ativo*/
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DRV E, R058DSP F
         WHERE A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = E.CODDRV AND E.VERDRV > 5 AND
		 F.CODDSP = C.CODDSP AND F.STADSP = 1);   /*Dispositivo deve estar ativo*/

  TYPE t_r058prm IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm t_r058prm;

  /* busca todos os dispositivos SDK, indepentende de permissão*/
  CURSOR c_r058prm2 IS
  SELECT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN
         FROM R058RLG A, R058MOD B, R058DRV E, R058DSP F
         WHERE A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND ((B.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (B.FABMOD > 2) AND
               B.CODDRV = E.CODDRV AND E.VERDRV > 5)  AND
			   F.CODDSP = A.CODDSP AND F.STADSP = 1;   /*Dispositivo deve estar ativo*/

  TYPE t_r058prm2 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm2 t_r058prm2;

  /* CURSOR para gerar a lista de exclusão
   o primeiro parãmetro p_codprm não é o codprm normal
   é usado a primeira posição como parâmtro da permissão que vai mudar
   os outros parâmetros são as demais permissões que ele tem
   busca dispositivos SDK que estão na permissão informada no primeiro parâmetro p_CodPrm */
  CURSOR c_r058prm3 IS
  SELECT DISTINCT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN
         FROM R058RLP A, R058RLG B, R058MOD D, R058DRV I, R058DSP F
         WHERE
         A.CODPRM  = (p_CodPrm) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = I.CODDRV AND I.VERDRV > 5
         AND
         B.CODDSP NOT IN
           (SELECT F.CODDSP
            FROM R058RLP E, R058RLG F, R058MOD H, R058DRV J
            WHERE
            E.CODPRM IN (p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
            E.CODPLT = F.CODPLT AND E.CODRLG = F.CODRLG AND
            F.MODRLG = H.MODRLG AND F.COMRLG = 2 AND
            ((H.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (H.FABMOD > 2)) AND
            H.CODDRV = J.CODDRV AND J.VERDRV > 5) AND
		 F.CODDSP = B.CODDSP AND F.STADSP = 1   /*Dispositivo deve estar ativo*/
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DRV I, R058DSP F
         WHERE A.CODPRM = p_CodPrm AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = I.CODDRV AND I.VERDRV > 5
         AND
         C.CODDSP NOT IN
           (SELECT G.CODDSP
            FROM R058GRP E, R058GRL F, R058RLG G, R058MOD H, R058DRV J
            WHERE E.CODPRM IN (p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
            E.CODGRR = F.CODGRR AND
            F.CODPLT = G.CODPLT  AND F.CODRLG = G.CODRLG AND G.COMRLG = 2 AND
            G.MODRLG = H.MODRLG AND ((H.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (H.FABMOD > 2)) AND
            H.CODDRV = J.CODDRV AND J.VERDRV > 5) AND
		 F.CODDSP = C.CODDSP AND F.STADSP = 1); /*Dispositivo deve estar ativo*/

  TYPE t_r058prm3 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm3 t_r058prm3;


  /* CURSOR para buscar todos os dispositivos SDK que não
  estão na permissão, para gerar delete ao trocar VERPRM */
  CURSOR c_r058prm4 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN
        FROM R058RLG A, R058MOD B, R058DRV E, R058DSP F
        WHERE
        A.MODRLG = B.MODRLG AND A.COMRLG = 2
        AND ((B.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (B.FABMOD > 2))
        AND NOT EXISTS (SELECT C.CODPLT, C.CODRLG FROM R058RLP C WHERE
        C.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
        A.CODPLT = C.CODPLT AND A.CODRLG = C.CODRLG)
        AND NOT EXISTS (SELECT D.CODPLT, D.CODRLG FROM R058GRL D, R058GRP E, R058DRV F WHERE
        E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
        E.CODGRR = D.CODGRR AND
        A.CODPLT = D.CODPLT AND A.CODRLG = D.CODRLG AND
	      B.CODDRV = F.CODDRV AND F.VERDRV > 5) AND
	      F.CODDSP = A.CODDSP AND F.STADSP = 1 AND /*Dispositivo deve estar ativo*/
              B.CODDRV = E.CODDRV;
  
  TYPE t_r058prm4 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm4 t_r058prm4;

BEGIN
   l_count:= 0;
   /* Verifica se a pessoa tem biometria quando não é um evento de exlusão ou inclusão(p_altbio = 2 ou 3). */
   IF p_altbio < 2 THEN
      BEGIN
          SELECT COUNT(*) INTO l_count FROM R070BIO WHERE IDTPES = p_idtpes;
      EXCEPTION
           WHEN OTHERS THEN l_count:= 0;
      END;
   END IF;

   IF (l_count > 0) OR (p_altbio > 1) THEN
       SP_GERSEN(l_gersen OUT);
       l_CenPen:= '0';

       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

       SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
       SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);

       /*Obtem o Segundo*/
       l_seqenv := SECOND(CURTIME());
       SP_INTSTR(l_seqenv, '99', l_seqstr OUT);

       l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

       /*Número Crachá*/
       SP_INTSTR(p_numfis,'999999999999',l_numfis OUT);

       /*Tecnologia do Crachá*/
       l_teccra := p_teccra;
       SP_INTSTR(l_teccra,'9',l_tcraux OUT);

       /*Identificador da Pessoa*/
       l_idtpes := p_idtpes;

       /*Responsável Legal pela alteração*/
       SP_RET_RESPLEG(l_idtpes, l_cpf_repleg OUT);
       IF l_cpf_repleg IS NULL THEN
         l_cpf_repleg := 0;
       END IF;
       SP_INTSTR(l_cpf_repleg,'99999999999', l_cpf_repleg_str OUT);

       /*Nome da Pessoa*/
       l_nomfun := p_nomfun;
       l_nomfun := lTrim(l_nomfun);
       l_nomfun := rTrim(l_nomfun);

       /*tamanho do Nome da pessoa*/
       l_tamnom := Length(l_nomfun);
       SP_INTSTR(l_tamnom,'999',l_tamnom_str OUT);

       /* Repasso tambem o PIS e o CPF em campos distintos, 
        * para que a CSM Center não precise adivinhar o documento */
       SP_INTSTR(p_numpis,'99999999999',l_numpis OUT);
       SP_INTSTR(p_numcpf,'99999999999',l_numcpf OUT);

       /* Informa o CPF quando não há PIS (alteração para a portaria 671) */
       IF (p_numpis > 0) THEN
         l_numId := l_numpis;
       ELSE
         l_numId := l_numcpf;
       END IF;

       /* Se operação for excluir crachá ou pessoa... */
       IF (l_tipope > 0) THEN
	     l_altbio := '2'; /* Excluir bio */
	   ELSE
	     l_altbio := '1'; /* Alterar bio */
	   END IF;

       l_datatu    := CURDATE();
       l_horatu    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

       SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
       SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);

       /* data atual string no formato YYMMDDHHmm*/
       l_DatAux := SUBSTRING(l_datstr,5,2)||SUBSTRING(l_datstr,3,2)||SUBSTRING(l_datstr,1,2)||l_horstr;
       /* converte a data de validade no formato string YYMMDDHHmm*/
       l_ValAux :=  SUBSTRING(p_datval,5,2)||SUBSTRING(p_datval,3,2)||SUBSTRING(p_datval,1,2)||SUBSTRING(p_datval,7,4);

       /*Evitar que seja inserido registro INSERT com data passada. Se for I, data validade tem que ser maior igual a data atual*/
       IF (p_tipOpe <> 'I') OR ((p_tipOpe = 'I') AND (l_valAux >= l_DatAux)) THEN
         /* verifica se é geração da lista de exclusão */
         IF (p_tipOpe = 'D') OR (p_tipOpe = 'E') THEN
           /*Parâmetro "D" é usado em todas as exclusões do REP, na TR070CON, exceto na troca do VERPRM.*/
           /*Gera na R070ACR registros para exclusão no REP, que alteraram alguma permissão*/
           IF (p_tipOpe = 'D') THEN
               /* LOOP dos dispositivos que estão dentro da permissão */
               FOREACH c_r058prm3 INTO l_r058prm3.numeip,
                                       l_r058prm3.tiplei,
                                       l_r058prm3.coddsp,
                                       l_r058prm3.fabmod,
                                       l_r058prm3.codcen
               LOOP
                    /* Multitecnologia */
                    IF (l_r058prm3.tiplei = 11) THEN
                        BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                          SELECT COUNT(1) INTO l_count
                            FROM R058RLG A
                                ,R058LEC B
                           WHERE A.CODDSP = l_r058prm3.coddsp
                             AND A.CODPLT = B.CODPLT
                             AND A.CODRLG = B.CODRLG
                             AND B.LEICRA = 4;
                          IF (l_count > 0) THEN
                            l_insere := TRUE;
                          END IF;
                        EXCEPTION
                          WHEN OTHERS THEN l_count := 0;
                        END;
                    END IF;

                    IF (p_numcra = p_numfis) THEN
                       l_insere := TRUE;
                    END IF;

                    IF (l_insere = TRUE) THEN
                      IF (l_gersen = TRUE) THEN
                         SP_INTSTR(l_r058prm3.coddsp,'999999999',l_coddsp OUT);

                         /* tipope 1 = remove card */
                         l_tipope := '1';
                         l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                         SP_PORCOMDSP(l_StrAux, l_r058prm3.codcen);

                      END IF;
                    END IF;
               END LOOP;
            ELSE
               /*Passa aqui, quando o parâmetro de exclusão for "E" */
               /*Parâmetro "E" é passado na troca do VERPRM, caso seja feita alteração de Não para SIM (Verifica Permissão)*/
               /*Gera na R070ACR registros para exclusão no REP, que estão fora da permissão do colaborador*/
               /* LOOP dos dispositivos que estão dentro da permissão */
               FOREACH c_r058prm4 INTO l_r058prm4.numeip,
                                       l_r058prm4.tiplei,
                                       l_r058prm4.coddsp,
                                       l_r058prm4.fabmod,
                                       l_r058prm4.codcen
               LOOP
                   /* trata registro de acordo com a leitora e tecnologia do crachá */
                   l_insere := FALSE;

                   /* Multitecnologia */
                   IF (l_r058prm4.tiplei = 11) THEN
                       BEGIN
                         /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                         SELECT COUNT(1) INTO l_count
                           FROM R058RLG A
                               ,R058LEC B
                          WHERE A.CODDSP = l_r058prm4.coddsp
                            AND A.CODPLT = B.CODPLT
                            AND A.CODRLG = B.CODRLG
                            AND B.LEICRA = 4;
                         IF (l_count > 0) THEN
                           l_insere := TRUE;
                         END IF;
                       EXCEPTION
                         WHEN OTHERS THEN
                           l_count := 0;
                       END;
                   END IF;

                   IF (p_numcra = p_numfis) THEN
                      l_insere := TRUE;
                   END IF;

                   IF (l_insere = TRUE) THEN
                     IF (l_gersen = TRUE) THEN
                       SP_INTSTR(l_r058prm4.coddsp,'999999999',l_coddsp OUT);

                       /* tipope 1 = remove card */
                       l_tipope := '1';
                       l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                       SP_PORCOMDSP(l_StrAux, l_r058prm4.codcen);
                     END IF;
                   END IF;
               END LOOP;
            END IF;
         ELSE
             /* para operação normal de INSERT e delete */
             IF (p_tipope = 'F') OR (p_tipope = 'D') THEN
               l_tipope := '1';
             ELSE
               l_tipope := '0';
             END IF;

             IF (p_verPrm = 1) THEN /* verprm = 'S' */

                 /* LOOP dos dispositivos que estão dentro da permissão*/
                 FOREACH c_r058prm INTO l_r058prm.numeip,
                                        l_r058prm.tiplei,
                                        l_r058prm.coddsp,
                                        l_r058prm.fabmod,
                                        l_r058prm.codcen
                 LOOP
                     /* trata registro de acordo com a leitora e tecnologia do crachá */
                     l_insere := FALSE;
                       /* Multitecnologia */
                     IF (l_r058prm.tiplei = 11) THEN
                         BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                           SELECT COUNT(1) INTO l_count
                             FROM R058RLG A
                                 ,R058LEC B
                            WHERE A.CODDSP = l_r058prm.coddsp
                              AND A.CODPLT = B.CODPLT
                              AND A.CODRLG = B.CODRLG
                              AND B.LEICRA = 4;
                           IF (l_count > 0) THEN
                             l_insere := TRUE;
                           END IF;
                         EXCEPTION
                           WHEN OTHERS THEN
                             l_count := 0;
                         END;

                       IF (p_numcra = p_numfis) THEN
                        l_insere := TRUE;
                       END IF;

                     END IF;

                     IF (l_insere = TRUE) THEN
                         /*verifica se já existe um registro ainda não enviado para este crachá e dispositivo */
                       IF (l_gersen = TRUE) THEN
                         SP_INTSTR(l_r058prm.coddsp,'999999999',l_coddsp OUT);
                         l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                         SP_PORCOMDSP(l_StrAux, l_r058prm.codcen);
                       END IF;
                     END IF;
                 END LOOP;
             ELSE
                 /* se não verifica permissão, gera para todos os dispositivos REP */
                 FOREACH c_r058prm2 INTO l_r058prm2.numeip,
                                         l_r058prm2.tiplei,
                                         l_r058prm2.coddsp,
                                         l_r058prm2.fabmod,
                                         l_r058prm2.codcen
                 LOOP
                     /* trata registro de acordo com a leitora e tecnologia do crachá */
                     l_insere := FALSE;

                     /* Multitecnologia */
                     IF (l_r058prm2.tiplei = 11) THEN
                         BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                           SELECT COUNT(1) INTO l_count
                             FROM R058RLG A
                                 ,R058LEC B
                            WHERE A.CODDSP = l_r058prm2.coddsp
                              AND A.CODPLT = B.CODPLT
                              AND A.CODRLG = B.CODRLG
                              AND B.LEICRA = 4;
                           IF (l_count > 0) THEN
                             l_insere := TRUE;
                           END IF;
                         EXCEPTION
                           WHEN OTHERS THEN
                             l_count := 0;
                         END;

                         IF (p_numcra = p_numfis) THEN
                          l_insere := TRUE;
                         END IF;
                     END IF;

                     IF (l_insere = TRUE) THEN
                       IF (l_gersen = TRUE) THEN
                          SP_INTSTR(l_r058prm2.CodDsp,'999999999',l_coddsp OUT);
                          l_tipope := '0';
                          l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                          SP_PORCOMDSP(l_StrAux, l_r058prm2.codcen);
                       END IF;
                     END IF;

                 END LOOP;
             END IF;
         END IF;
       END IF;
   END IF;
END		SENIOR;21?SP_GERSEN
SP_DATSTR
SP_INTSTR
SP_PORCOMDSP
SP_RET_RESPLEG
¢N␀␀

PROCEDURE SP_PEND62(P_TIPOPE VARCHAR2(1),P_NUMCRA NUMBER(12),P_NUMFIS NUMBER(12),P_TECCRA NUMBER(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1), P_NUMCPF NUMBER(11))
 IS

  l_datatu        DATE;
  l_horatu        NUMBER(4);
  l_datstr        CHAR(6);
  l_horstr        CHAR(4);
  l_datAux        CHAR(10);
  l_ValAux        CHAR(10);
  l_datenv        CHAR(16);
  l_count         NUMBER;
  l_insere        BOOLEAN;
  l_anostr        CHAR(2);
  l_tipope        VARCHAR2(1);
  l_coddsp        CHAR(9);
  l_Straux        VARCHAR2(2047);
  l_CenPen        VARCHAR2(1);
  l_data_atual    DATE;
  l_hora_atual    NUMBER(4);
  l_seqenv        NUMBER(2);
  l_seqstr        CHAR(2);
  l_gersen        BOOLEAN;
  l_numfis        CHAR(12);
  l_teccra        NUMBER(1);
  l_tcraux        CHAR(1);
  l_idtpes        VARCHAR2(23);
  l_tamnom        NUMBER(3);
  l_tamnom_str    CHAR(3);
  l_nomfun        VARCHAR2(40);
  l_numId         CHAR(11);
  l_numpis        CHAR(11);
  l_numcpf        CHAR(11);
  l_altbio        CHAR(1);
  l_cpf_repleg    NUMBER(11);
  l_cpf_repleg_str CHAR(11);
  
  /* busca dispositivos SDK, não REPs, verificando todas permissões */
  CURSOR c_r058prm IS
  SELECT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN
         FROM R058RLP A, R058RLG B, R058MOD D, R058DRV E, R058DSP F
         WHERE
         A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = E.CODDRV AND E.VERDRV > 5 AND
		 F.CODDSP = B.CODDSP AND F.STADSP = 1     /*Dispositivo deve estar ativo*/
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DRV E, R058DSP F
         WHERE A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = E.CODDRV AND E.VERDRV > 5 AND
		 F.CODDSP = C.CODDSP AND F.STADSP = 1);   /*Dispositivo deve estar ativo*/

  TYPE t_r058prm IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm t_r058prm;

  /* busca todos os dispositivos SDK, indepentende de permissão*/
  CURSOR c_r058prm2 IS
  SELECT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN
         FROM R058RLG A, R058MOD B, R058DRV E, R058DSP F
         WHERE A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND ((B.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (B.FABMOD > 2) AND
               B.CODDRV = E.CODDRV AND E.VERDRV > 5)  AND
			   F.CODDSP = A.CODDSP AND F.STADSP = 1;   /*Dispositivo deve estar ativo*/

  TYPE t_r058prm2 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm2 t_r058prm2;

  /* CURSOR para gerar a lista de exclusão
   o primeiro parãmetro p_codprm não é o codprm normal
   é usado a primeira posição como parâmtro da permissão que vai mudar
   os outros parâmetros são as demais permissões que ele tem
   busca dispositivos SDK que estão na permissão informada no primeiro parâmetro p_CodPrm */
  CURSOR c_r058prm3 IS
  SELECT DISTINCT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN
         FROM R058RLP A, R058RLG B, R058MOD D, R058DRV I, R058DSP F
         WHERE
         A.CODPRM  = (p_CodPrm) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = I.CODDRV AND I.VERDRV > 5
         AND
         B.CODDSP NOT IN
           (SELECT F.CODDSP
            FROM R058RLP E, R058RLG F, R058MOD H, R058DRV J
            WHERE
            E.CODPRM IN (p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
            E.CODPLT = F.CODPLT AND E.CODRLG = F.CODRLG AND
            F.MODRLG = H.MODRLG AND F.COMRLG = 2 AND
            ((H.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (H.FABMOD > 2)) AND
            H.CODDRV = J.CODDRV AND J.VERDRV > 5) AND
		 F.CODDSP = B.CODDSP AND F.STADSP = 1   /*Dispositivo deve estar ativo*/
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DRV I, R058DSP F
         WHERE A.CODPRM = p_CodPrm AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = I.CODDRV AND I.VERDRV > 5
         AND
         C.CODDSP NOT IN
           (SELECT G.CODDSP
            FROM R058GRP E, R058GRL F, R058RLG G, R058MOD H, R058DRV J
            WHERE E.CODPRM IN (p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
            E.CODGRR = F.CODGRR AND
            F.CODPLT = G.CODPLT  AND F.CODRLG = G.CODRLG AND G.COMRLG = 2 AND
            G.MODRLG = H.MODRLG AND ((H.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (H.FABMOD > 2)) AND
            H.CODDRV = J.CODDRV AND J.VERDRV > 5) AND
		 F.CODDSP = C.CODDSP AND F.STADSP = 1); /*Dispositivo deve estar ativo*/

  TYPE t_r058prm3 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm3 t_r058prm3;


  /* CURSOR para buscar todos os dispositivos SDK que não
  estão na permissão, para gerar delete ao trocar VERPRM */
  CURSOR c_r058prm4 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN
        FROM R058RLG A, R058MOD B, R058DRV E, R058DSP F
        WHERE
        A.MODRLG = B.MODRLG AND A.COMRLG = 2
        AND ((B.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (B.FABMOD > 2))
        AND NOT EXISTS (SELECT C.CODPLT, C.CODRLG FROM R058RLP C WHERE
        C.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
        A.CODPLT = C.CODPLT AND A.CODRLG = C.CODRLG)
        AND NOT EXISTS (SELECT D.CODPLT, D.CODRLG FROM R058GRL D, R058GRP E, R058DRV F WHERE
        E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
        E.CODGRR = D.CODGRR AND
        A.CODPLT = D.CODPLT AND A.CODRLG = D.CODRLG AND
	      B.CODDRV = F.CODDRV AND F.VERDRV > 5) AND
	      F.CODDSP = A.CODDSP AND F.STADSP = 1 AND /*Dispositivo deve estar ativo*/
              B.CODDRV = E.CODDRV;
  
  TYPE t_r058prm4 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm4 t_r058prm4;

BEGIN
   l_count:= 0;
   /* Verifica se a pessoa tem biometria quando não é um evento de exlusão ou inclusão(p_altbio = 2 ou 3). */
   IF p_altbio < 2 THEN
      BEGIN
          SELECT COUNT(*) INTO l_count FROM R070BIO WHERE IDTPES = p_idtpes;
      EXCEPTION
           WHEN OTHERS THEN l_count:= 0;
      END;
   END IF;

   IF (l_count > 0) OR (p_altbio > 1) THEN
       SP_GERSEN(l_gersen OUT);
       l_CenPen:= '0';

       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

       SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
       SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);

       /*Obtem o Segundo*/
       l_seqenv := SECOND(CURTIME());
       SP_INTSTR(l_seqenv, '99', l_seqstr OUT);

       l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

       /*Número Crachá*/
       SP_INTSTR(p_numfis,'999999999999',l_numfis OUT);

       /*Tecnologia do Crachá*/
       l_teccra := p_teccra;
       SP_INTSTR(l_teccra,'9',l_tcraux OUT);

       /*Identificador da Pessoa*/
       l_idtpes := p_idtpes;

       /*Responsável Legal pela alteração*/
       SP_RET_RESPLEG(l_idtpes, l_cpf_repleg OUT);
       IF l_cpf_repleg IS NULL THEN
         l_cpf_repleg := 0;
       END IF;
       SP_INTSTR(l_cpf_repleg,'99999999999', l_cpf_repleg_str OUT);

       /*Nome da Pessoa*/
       l_nomfun := p_nomfun;
       l_nomfun := lTrim(l_nomfun);
       l_nomfun := rTrim(l_nomfun);

       /*tamanho do Nome da pessoa*/
       l_tamnom := Length(l_nomfun);
       SP_INTSTR(l_tamnom,'999',l_tamnom_str OUT);

       /* Repasso tambem o PIS e o CPF em campos distintos, 
        * para que a CSM Center não precise adivinhar o documento */
       SP_INTSTR(p_numpis,'99999999999',l_numpis OUT);
       SP_INTSTR(p_numcpf,'99999999999',l_numcpf OUT);

       /* Informa o CPF quando não há PIS (alteração para a portaria 671) */
       IF (p_numpis > 0) THEN
         l_numId := l_numpis;
       ELSE
         l_numId := l_numcpf;
       END IF;

       /* Se operação for excluir crachá ou pessoa... */
       IF (l_tipope > 0) THEN
	     l_altbio := '2'; /* Excluir bio */
	   ELSE
	     l_altbio := '1'; /* Alterar bio */
	   END IF;

       l_datatu    := CURDATE();
       l_horatu    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

       SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
       SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);

       /* data atual string no formato YYMMDDHHmm*/
       l_DatAux := SUBSTRING(l_datstr,5,2)||SUBSTRING(l_datstr,3,2)||SUBSTRING(l_datstr,1,2)||l_horstr;
       /* converte a data de validade no formato string YYMMDDHHmm*/
       l_ValAux :=  SUBSTRING(p_datval,5,2)||SUBSTRING(p_datval,3,2)||SUBSTRING(p_datval,1,2)||SUBSTRING(p_datval,7,4);

       /*Evitar que seja inserido registro INSERT com data passada. Se for I, data validade tem que ser maior igual a data atual*/
       IF (p_tipOpe <> 'I') OR ((p_tipOpe = 'I') AND (l_valAux >= l_DatAux)) THEN
         /* verifica se é geração da lista de exclusão */
         IF (p_tipOpe = 'D') OR (p_tipOpe = 'E') THEN
           /*Parâmetro "D" é usado em todas as exclusões do REP, na TR070CON, exceto na troca do VERPRM.*/
           /*Gera na R070ACR registros para exclusão no REP, que alteraram alguma permissão*/
           IF (p_tipOpe = 'D') THEN
               /* LOOP dos dispositivos que estão dentro da permissão */
               FOREACH c_r058prm3 INTO l_r058prm3.numeip,
                                       l_r058prm3.tiplei,
                                       l_r058prm3.coddsp,
                                       l_r058prm3.fabmod,
                                       l_r058prm3.codcen
               LOOP
                    /* Multitecnologia */
                    IF (l_r058prm3.tiplei = 11) THEN
                        BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                          SELECT COUNT(1) INTO l_count
                            FROM R058RLG A
                                ,R058LEC B
                           WHERE A.CODDSP = l_r058prm3.coddsp
                             AND A.CODPLT = B.CODPLT
                             AND A.CODRLG = B.CODRLG
                             AND B.LEICRA = 4;
                          IF (l_count > 0) THEN
                            l_insere := TRUE;
                          END IF;
                        EXCEPTION
                          WHEN OTHERS THEN l_count := 0;
                        END;
                    END IF;

                    IF (p_numcra = p_numfis) THEN
                       l_insere := TRUE;
                    END IF;

                    IF (l_insere = TRUE) THEN
                      IF (l_gersen = TRUE) THEN
                         SP_INTSTR(l_r058prm3.coddsp,'999999999',l_coddsp OUT);

                         /* tipope 1 = remove card */
                         l_tipope := '1';
                         l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                         SP_PORCOMDSP(l_StrAux, l_r058prm3.codcen);

                      END IF;
                    END IF;
               END LOOP;
            ELSE
               /*Passa aqui, quando o parâmetro de exclusão for "E" */
               /*Parâmetro "E" é passado na troca do VERPRM, caso seja feita alteração de Não para SIM (Verifica Permissão)*/
               /*Gera na R070ACR registros para exclusão no REP, que estão fora da permissão do colaborador*/
               /* LOOP dos dispositivos que estão dentro da permissão */
               FOREACH c_r058prm4 INTO l_r058prm4.numeip,
                                       l_r058prm4.tiplei,
                                       l_r058prm4.coddsp,
                                       l_r058prm4.fabmod,
                                       l_r058prm4.codcen
               LOOP
                   /* trata registro de acordo com a leitora e tecnologia do crachá */
                   l_insere := FALSE;

                   /* Multitecnologia */
                   IF (l_r058prm4.tiplei = 11) THEN
                       BEGIN
                         /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                         SELECT COUNT(1) INTO l_count
                           FROM R058RLG A
                               ,R058LEC B
                          WHERE A.CODDSP = l_r058prm4.coddsp
                            AND A.CODPLT = B.CODPLT
                            AND A.CODRLG = B.CODRLG
                            AND B.LEICRA = 4;
                         IF (l_count > 0) THEN
                           l_insere := TRUE;
                         END IF;
                       EXCEPTION
                         WHEN OTHERS THEN
                           l_count := 0;
                       END;
                   END IF;

                   IF (p_numcra = p_numfis) THEN
                      l_insere := TRUE;
                   END IF;

                   IF (l_insere = TRUE) THEN
                     IF (l_gersen = TRUE) THEN
                       SP_INTSTR(l_r058prm4.coddsp,'999999999',l_coddsp OUT);

                       /* tipope 1 = remove card */
                       l_tipope := '1';
                       l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                       SP_PORCOMDSP(l_StrAux, l_r058prm4.codcen);
                     END IF;
                   END IF;
               END LOOP;
            END IF;
         ELSE
             /* para operação normal de INSERT e delete */
             IF (p_tipope = 'F') OR (p_tipope = 'D') THEN
               l_tipope := '1';
             ELSE
               l_tipope := '0';
             END IF;

             IF (p_verPrm = 1) THEN /* verprm = 'S' */

                 /* LOOP dos dispositivos que estão dentro da permissão*/
                 FOREACH c_r058prm INTO l_r058prm.numeip,
                                        l_r058prm.tiplei,
                                        l_r058prm.coddsp,
                                        l_r058prm.fabmod,
                                        l_r058prm.codcen
                 LOOP
                     /* trata registro de acordo com a leitora e tecnologia do crachá */
                     l_insere := FALSE;
                       /* Multitecnologia */
                     IF (l_r058prm.tiplei = 11) THEN
                         BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                           SELECT COUNT(1) INTO l_count
                             FROM R058RLG A
                                 ,R058LEC B
                            WHERE A.CODDSP = l_r058prm.coddsp
                              AND A.CODPLT = B.CODPLT
                              AND A.CODRLG = B.CODRLG
                              AND B.LEICRA = 4;
                           IF (l_count > 0) THEN
                             l_insere := TRUE;
                           END IF;
                         EXCEPTION
                           WHEN OTHERS THEN
                             l_count := 0;
                         END;

                       IF (p_numcra = p_numfis) THEN
                        l_insere := TRUE;
                       END IF;

                     END IF;

                     IF (l_insere = TRUE) THEN
                         /*verifica se já existe um registro ainda não enviado para este crachá e dispositivo */
                       IF (l_gersen = TRUE) THEN
                         SP_INTSTR(l_r058prm.coddsp,'999999999',l_coddsp OUT);
                         l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                         SP_PORCOMDSP(l_StrAux, l_r058prm.codcen);
                       END IF;
                     END IF;
                 END LOOP;
             ELSE
                 /* se não verifica permissão, gera para todos os dispositivos REP */
                 FOREACH c_r058prm2 INTO l_r058prm2.numeip,
                                         l_r058prm2.tiplei,
                                         l_r058prm2.coddsp,
                                         l_r058prm2.fabmod,
                                         l_r058prm2.codcen
                 LOOP
                     /* trata registro de acordo com a leitora e tecnologia do crachá */
                     l_insere := FALSE;

                     /* Multitecnologia */
                     IF (l_r058prm2.tiplei = 11) THEN
                         BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                           SELECT COUNT(1) INTO l_count
                             FROM R058RLG A
                                 ,R058LEC B
                            WHERE A.CODDSP = l_r058prm2.coddsp
                              AND A.CODPLT = B.CODPLT
                              AND A.CODRLG = B.CODRLG
                              AND B.LEICRA = 4;
                           IF (l_count > 0) THEN
                             l_insere := TRUE;
                           END IF;
                         EXCEPTION
                           WHEN OTHERS THEN
                             l_count := 0;
                         END;

                         IF (p_numcra = p_numfis) THEN
                          l_insere := TRUE;
                         END IF;
                     END IF;

                     IF (l_insere = TRUE) THEN
                       IF (l_gersen = TRUE) THEN
                          SP_INTSTR(l_r058prm2.CodDsp,'999999999',l_coddsp OUT);
                          l_tipope := '0';
                          l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                          SP_PORCOMDSP(l_StrAux, l_r058prm2.codcen);
                       END IF;
                     END IF;

                 END LOOP;
             END IF;
         END IF;
       END IF;
   END IF;
END		SENIOR;22?SP_GERSEN
SP_DATSTR
SP_INTSTR
SP_PORCOMDSP
SP_RET_RESPLEG
¢N␀␀

PROCEDURE SP_PEND62(P_TIPOPE VARCHAR2(1),P_NUMCRA NUMBER(12),P_NUMFIS NUMBER(12),P_TECCRA NUMBER(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1), P_NUMCPF NUMBER(11))
 IS

  l_datatu        DATE;
  l_horatu        NUMBER(4);
  l_datstr        CHAR(6);
  l_horstr        CHAR(4);
  l_datAux        CHAR(10);
  l_ValAux        CHAR(10);
  l_datenv        CHAR(16);
  l_count         NUMBER;
  l_insere        BOOLEAN;
  l_anostr        CHAR(2);
  l_tipope        VARCHAR2(1);
  l_coddsp        CHAR(9);
  l_Straux        VARCHAR2(2047);
  l_CenPen        VARCHAR2(1);
  l_data_atual    DATE;
  l_hora_atual    NUMBER(4);
  l_seqenv        NUMBER(2);
  l_seqstr        CHAR(2);
  l_gersen        BOOLEAN;
  l_numfis        CHAR(12);
  l_teccra        NUMBER(1);
  l_tcraux        CHAR(1);
  l_idtpes        VARCHAR2(23);
  l_tamnom        NUMBER(3);
  l_tamnom_str    CHAR(3);
  l_nomfun        VARCHAR2(40);
  l_numId         CHAR(11);
  l_numpis        CHAR(11);
  l_numcpf        CHAR(11);
  l_altbio        CHAR(1);
  l_cpf_repleg    NUMBER(11);
  l_cpf_repleg_str CHAR(11);
  
  /* busca dispositivos SDK, não REPs, verificando todas permissões */
  CURSOR c_r058prm IS
  SELECT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN
         FROM R058RLP A, R058RLG B, R058MOD D, R058DRV E, R058DSP F
         WHERE
         A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = E.CODDRV AND E.VERDRV > 5 AND
		 F.CODDSP = B.CODDSP AND F.STADSP = 1     /*Dispositivo deve estar ativo*/
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DRV E, R058DSP F
         WHERE A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = E.CODDRV AND E.VERDRV > 5 AND
		 F.CODDSP = C.CODDSP AND F.STADSP = 1);   /*Dispositivo deve estar ativo*/

  TYPE t_r058prm IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm t_r058prm;

  /* busca todos os dispositivos SDK, indepentende de permissão*/
  CURSOR c_r058prm2 IS
  SELECT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN
         FROM R058RLG A, R058MOD B, R058DRV E, R058DSP F
         WHERE A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND ((B.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (B.FABMOD > 2) AND
               B.CODDRV = E.CODDRV AND E.VERDRV > 5)  AND
			   F.CODDSP = A.CODDSP AND F.STADSP = 1;   /*Dispositivo deve estar ativo*/

  TYPE t_r058prm2 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm2 t_r058prm2;

  /* CURSOR para gerar a lista de exclusão
   o primeiro parãmetro p_codprm não é o codprm normal
   é usado a primeira posição como parâmtro da permissão que vai mudar
   os outros parâmetros são as demais permissões que ele tem
   busca dispositivos SDK que estão na permissão informada no primeiro parâmetro p_CodPrm */
  CURSOR c_r058prm3 IS
  SELECT DISTINCT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN
         FROM R058RLP A, R058RLG B, R058MOD D, R058DRV I, R058DSP F
         WHERE
         A.CODPRM  = (p_CodPrm) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = I.CODDRV AND I.VERDRV > 5
         AND
         B.CODDSP NOT IN
           (SELECT F.CODDSP
            FROM R058RLP E, R058RLG F, R058MOD H, R058DRV J
            WHERE
            E.CODPRM IN (p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
            E.CODPLT = F.CODPLT AND E.CODRLG = F.CODRLG AND
            F.MODRLG = H.MODRLG AND F.COMRLG = 2 AND
            ((H.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (H.FABMOD > 2)) AND
            H.CODDRV = J.CODDRV AND J.VERDRV > 5) AND
		 F.CODDSP = B.CODDSP AND F.STADSP = 1   /*Dispositivo deve estar ativo*/
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DRV I, R058DSP F
         WHERE A.CODPRM = p_CodPrm AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = I.CODDRV AND I.VERDRV > 5
         AND
         C.CODDSP NOT IN
           (SELECT G.CODDSP
            FROM R058GRP E, R058GRL F, R058RLG G, R058MOD H, R058DRV J
            WHERE E.CODPRM IN (p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
            E.CODGRR = F.CODGRR AND
            F.CODPLT = G.CODPLT  AND F.CODRLG = G.CODRLG AND G.COMRLG = 2 AND
            G.MODRLG = H.MODRLG AND ((H.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (H.FABMOD > 2)) AND
            H.CODDRV = J.CODDRV AND J.VERDRV > 5) AND
		 F.CODDSP = C.CODDSP AND F.STADSP = 1); /*Dispositivo deve estar ativo*/

  TYPE t_r058prm3 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm3 t_r058prm3;


  /* CURSOR para buscar todos os dispositivos SDK que não
  estão na permissão, para gerar delete ao trocar VERPRM */
  CURSOR c_r058prm4 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN
        FROM R058RLG A, R058MOD B, R058DRV E, R058DSP F
        WHERE
        A.MODRLG = B.MODRLG AND A.COMRLG = 2
        AND ((B.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (B.FABMOD > 2))
        AND NOT EXISTS (SELECT C.CODPLT, C.CODRLG FROM R058RLP C WHERE
        C.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
        A.CODPLT = C.CODPLT AND A.CODRLG = C.CODRLG)
        AND NOT EXISTS (SELECT D.CODPLT, D.CODRLG FROM R058GRL D, R058GRP E, R058DRV F WHERE
        E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
        E.CODGRR = D.CODGRR AND
        A.CODPLT = D.CODPLT AND A.CODRLG = D.CODRLG AND
	      B.CODDRV = F.CODDRV AND F.VERDRV > 5) AND
	      F.CODDSP = A.CODDSP AND F.STADSP = 1 AND /*Dispositivo deve estar ativo*/
              B.CODDRV = E.CODDRV;
  
  TYPE t_r058prm4 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm4 t_r058prm4;

BEGIN
   l_count:= 0;
   /* Verifica se a pessoa tem biometria quando não é um evento de exlusão ou inclusão(p_altbio = 2 ou 3). */
   IF p_altbio < 2 THEN
      BEGIN
          SELECT COUNT(*) INTO l_count FROM R070BIO WHERE IDTPES = p_idtpes;
      EXCEPTION
           WHEN OTHERS THEN l_count:= 0;
      END;
   END IF;

   IF (l_count > 0) OR (p_altbio > 1) THEN
       SP_GERSEN(l_gersen OUT);
       l_CenPen:= '0';

       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

       SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
       SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);

       /*Obtem o Segundo*/
       l_seqenv := SECOND(CURTIME());
       SP_INTSTR(l_seqenv, '99', l_seqstr OUT);

       l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

       /*Número Crachá*/
       SP_INTSTR(p_numfis,'999999999999',l_numfis OUT);

       /*Tecnologia do Crachá*/
       l_teccra := p_teccra;
       SP_INTSTR(l_teccra,'9',l_tcraux OUT);

       /*Identificador da Pessoa*/
       l_idtpes := p_idtpes;

       /*Responsável Legal pela alteração*/
       SP_RET_RESPLEG(l_idtpes, l_cpf_repleg OUT);
       IF l_cpf_repleg IS NULL THEN
         l_cpf_repleg := 0;
       END IF;
       SP_INTSTR(l_cpf_repleg,'99999999999', l_cpf_repleg_str OUT);

       /*Nome da Pessoa*/
       l_nomfun := p_nomfun;
       l_nomfun := lTrim(l_nomfun);
       l_nomfun := rTrim(l_nomfun);

       /*tamanho do Nome da pessoa*/
       l_tamnom := Length(l_nomfun);
       SP_INTSTR(l_tamnom,'999',l_tamnom_str OUT);

       /* Repasso tambem o PIS e o CPF em campos distintos, 
        * para que a CSM Center não precise adivinhar o documento */
       SP_INTSTR(p_numpis,'99999999999',l_numpis OUT);
       SP_INTSTR(p_numcpf,'99999999999',l_numcpf OUT);

       /* Informa o CPF quando não há PIS (alteração para a portaria 671) */
       IF (p_numpis > 0) THEN
         l_numId := l_numpis;
       ELSE
         l_numId := l_numcpf;
       END IF;

       /* Se operação for excluir crachá ou pessoa... */
       IF (l_tipope > 0) THEN
	     l_altbio := '2'; /* Excluir bio */
	   ELSE
	     l_altbio := '1'; /* Alterar bio */
	   END IF;

       l_datatu    := CURDATE();
       l_horatu    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

       SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
       SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);

       /* data atual string no formato YYMMDDHHmm*/
       l_DatAux := SUBSTRING(l_datstr,5,2)||SUBSTRING(l_datstr,3,2)||SUBSTRING(l_datstr,1,2)||l_horstr;
       /* converte a data de validade no formato string YYMMDDHHmm*/
       l_ValAux :=  SUBSTRING(p_datval,5,2)||SUBSTRING(p_datval,3,2)||SUBSTRING(p_datval,1,2)||SUBSTRING(p_datval,7,4);

       /*Evitar que seja inserido registro INSERT com data passada. Se for I, data validade tem que ser maior igual a data atual*/
       IF (p_tipOpe <> 'I') OR ((p_tipOpe = 'I') AND (l_valAux >= l_DatAux)) THEN
         /* verifica se é geração da lista de exclusão */
         IF (p_tipOpe = 'D') OR (p_tipOpe = 'E') THEN
           /*Parâmetro "D" é usado em todas as exclusões do REP, na TR070CON, exceto na troca do VERPRM.*/
           /*Gera na R070ACR registros para exclusão no REP, que alteraram alguma permissão*/
           IF (p_tipOpe = 'D') THEN
               /* LOOP dos dispositivos que estão dentro da permissão */
               FOREACH c_r058prm3 INTO l_r058prm3.numeip,
                                       l_r058prm3.tiplei,
                                       l_r058prm3.coddsp,
                                       l_r058prm3.fabmod,
                                       l_r058prm3.codcen
               LOOP
                    /* Multitecnologia */
                    IF (l_r058prm3.tiplei = 11) THEN
                        BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                          SELECT COUNT(1) INTO l_count
                            FROM R058RLG A
                                ,R058LEC B
                           WHERE A.CODDSP = l_r058prm3.coddsp
                             AND A.CODPLT = B.CODPLT
                             AND A.CODRLG = B.CODRLG
                             AND B.LEICRA = 4;
                          IF (l_count > 0) THEN
                            l_insere := TRUE;
                          END IF;
                        EXCEPTION
                          WHEN OTHERS THEN l_count := 0;
                        END;
                    END IF;

                    IF (p_numcra = p_numfis) THEN
                       l_insere := TRUE;
                    END IF;

                    IF (l_insere = TRUE) THEN
                      IF (l_gersen = TRUE) THEN
                         SP_INTSTR(l_r058prm3.coddsp,'999999999',l_coddsp OUT);

                         /* tipope 1 = remove card */
                         l_tipope := '1';
                         l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                         SP_PORCOMDSP(l_StrAux, l_r058prm3.codcen);

                      END IF;
                    END IF;
               END LOOP;
            ELSE
               /*Passa aqui, quando o parâmetro de exclusão for "E" */
               /*Parâmetro "E" é passado na troca do VERPRM, caso seja feita alteração de Não para SIM (Verifica Permissão)*/
               /*Gera na R070ACR registros para exclusão no REP, que estão fora da permissão do colaborador*/
               /* LOOP dos dispositivos que estão dentro da permissão */
               FOREACH c_r058prm4 INTO l_r058prm4.numeip,
                                       l_r058prm4.tiplei,
                                       l_r058prm4.coddsp,
                                       l_r058prm4.fabmod,
                                       l_r058prm4.codcen
               LOOP
                   /* trata registro de acordo com a leitora e tecnologia do crachá */
                   l_insere := FALSE;

                   /* Multitecnologia */
                   IF (l_r058prm4.tiplei = 11) THEN
                       BEGIN
                         /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                         SELECT COUNT(1) INTO l_count
                           FROM R058RLG A
                               ,R058LEC B
                          WHERE A.CODDSP = l_r058prm4.coddsp
                            AND A.CODPLT = B.CODPLT
                            AND A.CODRLG = B.CODRLG
                            AND B.LEICRA = 4;
                         IF (l_count > 0) THEN
                           l_insere := TRUE;
                         END IF;
                       EXCEPTION
                         WHEN OTHERS THEN
                           l_count := 0;
                       END;
                   END IF;

                   IF (p_numcra = p_numfis) THEN
                      l_insere := TRUE;
                   END IF;

                   IF (l_insere = TRUE) THEN
                     IF (l_gersen = TRUE) THEN
                       SP_INTSTR(l_r058prm4.coddsp,'999999999',l_coddsp OUT);

                       /* tipope 1 = remove card */
                       l_tipope := '1';
                       l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                       SP_PORCOMDSP(l_StrAux, l_r058prm4.codcen);
                     END IF;
                   END IF;
               END LOOP;
            END IF;
         ELSE
             /* para operação normal de INSERT e delete */
             IF (p_tipope = 'F') OR (p_tipope = 'D') THEN
               l_tipope := '1';
             ELSE
               l_tipope := '0';
             END IF;

             IF (p_verPrm = 1) THEN /* verprm = 'S' */

                 /* LOOP dos dispositivos que estão dentro da permissão*/
                 FOREACH c_r058prm INTO l_r058prm.numeip,
                                        l_r058prm.tiplei,
                                        l_r058prm.coddsp,
                                        l_r058prm.fabmod,
                                        l_r058prm.codcen
                 LOOP
                     /* trata registro de acordo com a leitora e tecnologia do crachá */
                     l_insere := FALSE;
                       /* Multitecnologia */
                     IF (l_r058prm.tiplei = 11) THEN
                         BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                           SELECT COUNT(1) INTO l_count
                             FROM R058RLG A
                                 ,R058LEC B
                            WHERE A.CODDSP = l_r058prm.coddsp
                              AND A.CODPLT = B.CODPLT
                              AND A.CODRLG = B.CODRLG
                              AND B.LEICRA = 4;
                           IF (l_count > 0) THEN
                             l_insere := TRUE;
                           END IF;
                         EXCEPTION
                           WHEN OTHERS THEN
                             l_count := 0;
                         END;

                       IF (p_numcra = p_numfis) THEN
                        l_insere := TRUE;
                       END IF;

                     END IF;

                     IF (l_insere = TRUE) THEN
                         /*verifica se já existe um registro ainda não enviado para este crachá e dispositivo */
                       IF (l_gersen = TRUE) THEN
                         SP_INTSTR(l_r058prm.coddsp,'999999999',l_coddsp OUT);
                         l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                         SP_PORCOMDSP(l_StrAux, l_r058prm.codcen);
                       END IF;
                     END IF;
                 END LOOP;
             ELSE
                 /* se não verifica permissão, gera para todos os dispositivos REP */
                 FOREACH c_r058prm2 INTO l_r058prm2.numeip,
                                         l_r058prm2.tiplei,
                                         l_r058prm2.coddsp,
                                         l_r058prm2.fabmod,
                                         l_r058prm2.codcen
                 LOOP
                     /* trata registro de acordo com a leitora e tecnologia do crachá */
                     l_insere := FALSE;

                     /* Multitecnologia */
                     IF (l_r058prm2.tiplei = 11) THEN
                         BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                           SELECT COUNT(1) INTO l_count
                             FROM R058RLG A
                                 ,R058LEC B
                            WHERE A.CODDSP = l_r058prm2.coddsp
                              AND A.CODPLT = B.CODPLT
                              AND A.CODRLG = B.CODRLG
                              AND B.LEICRA = 4;
                           IF (l_count > 0) THEN
                             l_insere := TRUE;
                           END IF;
                         EXCEPTION
                           WHEN OTHERS THEN
                             l_count := 0;
                         END;

                         IF (p_numcra = p_numfis) THEN
                          l_insere := TRUE;
                         END IF;
                     END IF;

                     IF (l_insere = TRUE) THEN
                       IF (l_gersen = TRUE) THEN
                          SP_INTSTR(l_r058prm2.CodDsp,'999999999',l_coddsp OUT);
                          l_tipope := '0';
                          l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                          SP_PORCOMDSP(l_StrAux, l_r058prm2.codcen);
                       END IF;
                     END IF;

                 END LOOP;
             END IF;
         END IF;
       END IF;
   END IF;
END		SENIOR;23?SP_GERSEN
SP_DATSTR
SP_INTSTR
SP_PORCOMDSP
SP_RET_RESPLEG
¢N␀␀

PROCEDURE SP_PEND62(P_TIPOPE VARCHAR2(1),P_NUMCRA NUMBER(12),P_NUMFIS NUMBER(12),P_TECCRA NUMBER(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1), P_NUMCPF NUMBER(11))
 IS

  l_datatu        DATE;
  l_horatu        NUMBER(4);
  l_datstr        CHAR(6);
  l_horstr        CHAR(4);
  l_datAux        CHAR(10);
  l_ValAux        CHAR(10);
  l_datenv        CHAR(16);
  l_count         NUMBER;
  l_insere        BOOLEAN;
  l_anostr        CHAR(2);
  l_tipope        VARCHAR2(1);
  l_coddsp        CHAR(9);
  l_Straux        VARCHAR2(2047);
  l_CenPen        VARCHAR2(1);
  l_data_atual    DATE;
  l_hora_atual    NUMBER(4);
  l_seqenv        NUMBER(2);
  l_seqstr        CHAR(2);
  l_gersen        BOOLEAN;
  l_numfis        CHAR(12);
  l_teccra        NUMBER(1);
  l_tcraux        CHAR(1);
  l_idtpes        VARCHAR2(23);
  l_tamnom        NUMBER(3);
  l_tamnom_str    CHAR(3);
  l_nomfun        VARCHAR2(40);
  l_numId         CHAR(11);
  l_numpis        CHAR(11);
  l_numcpf        CHAR(11);
  l_altbio        CHAR(1);
  l_cpf_repleg    NUMBER(11);
  l_cpf_repleg_str CHAR(11);
  
  /* busca dispositivos SDK, não REPs, verificando todas permissões */
  CURSOR c_r058prm IS
  SELECT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN
         FROM R058RLP A, R058RLG B, R058MOD D, R058DRV E, R058DSP F
         WHERE
         A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = E.CODDRV AND E.VERDRV > 5 AND
		 F.CODDSP = B.CODDSP AND F.STADSP = 1     /*Dispositivo deve estar ativo*/
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DRV E, R058DSP F
         WHERE A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = E.CODDRV AND E.VERDRV > 5 AND
		 F.CODDSP = C.CODDSP AND F.STADSP = 1);   /*Dispositivo deve estar ativo*/

  TYPE t_r058prm IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm t_r058prm;

  /* busca todos os dispositivos SDK, indepentende de permissão*/
  CURSOR c_r058prm2 IS
  SELECT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN
         FROM R058RLG A, R058MOD B, R058DRV E, R058DSP F
         WHERE A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND ((B.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (B.FABMOD > 2) AND
               B.CODDRV = E.CODDRV AND E.VERDRV > 5)  AND
			   F.CODDSP = A.CODDSP AND F.STADSP = 1;   /*Dispositivo deve estar ativo*/

  TYPE t_r058prm2 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm2 t_r058prm2;

  /* CURSOR para gerar a lista de exclusão
   o primeiro parãmetro p_codprm não é o codprm normal
   é usado a primeira posição como parâmtro da permissão que vai mudar
   os outros parâmetros são as demais permissões que ele tem
   busca dispositivos SDK que estão na permissão informada no primeiro parâmetro p_CodPrm */
  CURSOR c_r058prm3 IS
  SELECT DISTINCT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN
         FROM R058RLP A, R058RLG B, R058MOD D, R058DRV I, R058DSP F
         WHERE
         A.CODPRM  = (p_CodPrm) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = I.CODDRV AND I.VERDRV > 5
         AND
         B.CODDSP NOT IN
           (SELECT F.CODDSP
            FROM R058RLP E, R058RLG F, R058MOD H, R058DRV J
            WHERE
            E.CODPRM IN (p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
            E.CODPLT = F.CODPLT AND E.CODRLG = F.CODRLG AND
            F.MODRLG = H.MODRLG AND F.COMRLG = 2 AND
            ((H.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (H.FABMOD > 2)) AND
            H.CODDRV = J.CODDRV AND J.VERDRV > 5) AND
		 F.CODDSP = B.CODDSP AND F.STADSP = 1   /*Dispositivo deve estar ativo*/
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DRV I, R058DSP F
         WHERE A.CODPRM = p_CodPrm AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND ((D.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (D.FABMOD > 2)) AND
         D.CODDRV = I.CODDRV AND I.VERDRV > 5
         AND
         C.CODDSP NOT IN
           (SELECT G.CODDSP
            FROM R058GRP E, R058GRL F, R058RLG G, R058MOD H, R058DRV J
            WHERE E.CODPRM IN (p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
            E.CODGRR = F.CODGRR AND
            F.CODPLT = G.CODPLT  AND F.CODRLG = G.CODRLG AND G.COMRLG = 2 AND
            G.MODRLG = H.MODRLG AND ((H.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (H.FABMOD > 2)) AND
            H.CODDRV = J.CODDRV AND J.VERDRV > 5) AND
		 F.CODDSP = C.CODDSP AND F.STADSP = 1); /*Dispositivo deve estar ativo*/

  TYPE t_r058prm3 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm3 t_r058prm3;


  /* CURSOR para buscar todos os dispositivos SDK que não
  estão na permissão, para gerar delete ao trocar VERPRM */
  CURSOR c_r058prm4 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN
        FROM R058RLG A, R058MOD B, R058DRV E, R058DSP F
        WHERE
        A.MODRLG = B.MODRLG AND A.COMRLG = 2
        AND ((B.CLAMOD IN (1,2,3,4,5,6,7,8,9,99)) AND (B.FABMOD > 2))
        AND NOT EXISTS (SELECT C.CODPLT, C.CODRLG FROM R058RLP C WHERE
        C.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
        A.CODPLT = C.CODPLT AND A.CODRLG = C.CODRLG)
        AND NOT EXISTS (SELECT D.CODPLT, D.CODRLG FROM R058GRL D, R058GRP E, R058DRV F WHERE
        E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
        E.CODGRR = D.CODGRR AND
        A.CODPLT = D.CODPLT AND A.CODRLG = D.CODRLG AND
	      B.CODDRV = F.CODDRV AND F.VERDRV > 5) AND
	      F.CODDSP = A.CODDSP AND F.STADSP = 1 AND /*Dispositivo deve estar ativo*/
              B.CODDRV = E.CODDRV;
  
  TYPE t_r058prm4 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE);
  l_r058prm4 t_r058prm4;

BEGIN
   l_count:= 0;
   /* Verifica se a pessoa tem biometria quando não é um evento de exlusão ou inclusão(p_altbio = 2 ou 3). */
   IF p_altbio < 2 THEN
      BEGIN
          SELECT COUNT(*) INTO l_count FROM R070BIO WHERE IDTPES = p_idtpes;
      EXCEPTION
           WHEN OTHERS THEN l_count:= 0;
      END;
   END IF;

   IF (l_count > 0) OR (p_altbio > 1) THEN
       SP_GERSEN(l_gersen OUT);
       l_CenPen:= '0';

       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

       SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
       SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);

       /*Obtem o Segundo*/
       l_seqenv := SECOND(CURTIME());
       SP_INTSTR(l_seqenv, '99', l_seqstr OUT);

       l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

       /*Número Crachá*/
       SP_INTSTR(p_numfis,'999999999999',l_numfis OUT);

       /*Tecnologia do Crachá*/
       l_teccra := p_teccra;
       SP_INTSTR(l_teccra,'9',l_tcraux OUT);

       /*Identificador da Pessoa*/
       l_idtpes := p_idtpes;

       /*Responsável Legal pela alteração*/
       SP_RET_RESPLEG(l_idtpes, l_cpf_repleg OUT);
       IF l_cpf_repleg IS NULL THEN
         l_cpf_repleg := 0;
       END IF;
       SP_INTSTR(l_cpf_repleg,'99999999999', l_cpf_repleg_str OUT);

       /*Nome da Pessoa*/
       l_nomfun := p_nomfun;
       l_nomfun := lTrim(l_nomfun);
       l_nomfun := rTrim(l_nomfun);

       /*tamanho do Nome da pessoa*/
       l_tamnom := Length(l_nomfun);
       SP_INTSTR(l_tamnom,'999',l_tamnom_str OUT);

       /* Repasso tambem o PIS e o CPF em campos distintos, 
        * para que a CSM Center não precise adivinhar o documento */
       SP_INTSTR(p_numpis,'99999999999',l_numpis OUT);
       SP_INTSTR(p_numcpf,'99999999999',l_numcpf OUT);

       /* Informa o CPF quando não há PIS (alteração para a portaria 671) */
       IF (p_numpis > 0) THEN
         l_numId := l_numpis;
       ELSE
         l_numId := l_numcpf;
       END IF;

       /* Se operação for excluir crachá ou pessoa... */
       IF (l_tipope > 0) THEN
	     l_altbio := '2'; /* Excluir bio */
	   ELSE
	     l_altbio := '1'; /* Alterar bio */
	   END IF;

       l_datatu    := CURDATE();
       l_horatu    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

       SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
       SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);

       /* data atual string no formato YYMMDDHHmm*/
       l_DatAux := SUBSTRING(l_datstr,5,2)||SUBSTRING(l_datstr,3,2)||SUBSTRING(l_datstr,1,2)||l_horstr;
       /* converte a data de validade no formato string YYMMDDHHmm*/
       l_ValAux :=  SUBSTRING(p_datval,5,2)||SUBSTRING(p_datval,3,2)||SUBSTRING(p_datval,1,2)||SUBSTRING(p_datval,7,4);

       /*Evitar que seja inserido registro INSERT com data passada. Se for I, data validade tem que ser maior igual a data atual*/
       IF (p_tipOpe <> 'I') OR ((p_tipOpe = 'I') AND (l_valAux >= l_DatAux)) THEN
         /* verifica se é geração da lista de exclusão */
         IF (p_tipOpe = 'D') OR (p_tipOpe = 'E') THEN
           /*Parâmetro "D" é usado em todas as exclusões do REP, na TR070CON, exceto na troca do VERPRM.*/
           /*Gera na R070ACR registros para exclusão no REP, que alteraram alguma permissão*/
           IF (p_tipOpe = 'D') THEN
               /* LOOP dos dispositivos que estão dentro da permissão */
               FOREACH c_r058prm3 INTO l_r058prm3.numeip,
                                       l_r058prm3.tiplei,
                                       l_r058prm3.coddsp,
                                       l_r058prm3.fabmod,
                                       l_r058prm3.codcen
               LOOP
                    /* Multitecnologia */
                    IF (l_r058prm3.tiplei = 11) THEN
                        BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                          SELECT COUNT(1) INTO l_count
                            FROM R058RLG A
                                ,R058LEC B
                           WHERE A.CODDSP = l_r058prm3.coddsp
                             AND A.CODPLT = B.CODPLT
                             AND A.CODRLG = B.CODRLG
                             AND B.LEICRA = 4;
                          IF (l_count > 0) THEN
                            l_insere := TRUE;
                          END IF;
                        EXCEPTION
                          WHEN OTHERS THEN l_count := 0;
                        END;
                    END IF;

                    IF (p_numcra = p_numfis) THEN
                       l_insere := TRUE;
                    END IF;

                    IF (l_insere = TRUE) THEN
                      IF (l_gersen = TRUE) THEN
                         SP_INTSTR(l_r058prm3.coddsp,'999999999',l_coddsp OUT);

                         /* tipope 1 = remove card */
                         l_tipope := '1';
                         l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                         SP_PORCOMDSP(l_StrAux, l_r058prm3.codcen);

                      END IF;
                    END IF;
               END LOOP;
            ELSE
               /*Passa aqui, quando o parâmetro de exclusão for "E" */
               /*Parâmetro "E" é passado na troca do VERPRM, caso seja feita alteração de Não para SIM (Verifica Permissão)*/
               /*Gera na R070ACR registros para exclusão no REP, que estão fora da permissão do colaborador*/
               /* LOOP dos dispositivos que estão dentro da permissão */
               FOREACH c_r058prm4 INTO l_r058prm4.numeip,
                                       l_r058prm4.tiplei,
                                       l_r058prm4.coddsp,
                                       l_r058prm4.fabmod,
                                       l_r058prm4.codcen
               LOOP
                   /* trata registro de acordo com a leitora e tecnologia do crachá */
                   l_insere := FALSE;

                   /* Multitecnologia */
                   IF (l_r058prm4.tiplei = 11) THEN
                       BEGIN
                         /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                         SELECT COUNT(1) INTO l_count
                           FROM R058RLG A
                               ,R058LEC B
                          WHERE A.CODDSP = l_r058prm4.coddsp
                            AND A.CODPLT = B.CODPLT
                            AND A.CODRLG = B.CODRLG
                            AND B.LEICRA = 4;
                         IF (l_count > 0) THEN
                           l_insere := TRUE;
                         END IF;
                       EXCEPTION
                         WHEN OTHERS THEN
                           l_count := 0;
                       END;
                   END IF;

                   IF (p_numcra = p_numfis) THEN
                      l_insere := TRUE;
                   END IF;

                   IF (l_insere = TRUE) THEN
                     IF (l_gersen = TRUE) THEN
                       SP_INTSTR(l_r058prm4.coddsp,'999999999',l_coddsp OUT);

                       /* tipope 1 = remove card */
                       l_tipope := '1';
                       l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                       SP_PORCOMDSP(l_StrAux, l_r058prm4.codcen);
                     END IF;
                   END IF;
               END LOOP;
            END IF;
         ELSE
             /* para operação normal de INSERT e delete */
             IF (p_tipope = 'F') OR (p_tipope = 'D') THEN
               l_tipope := '1';
             ELSE
               l_tipope := '0';
             END IF;

             IF (p_verPrm = 1) THEN /* verprm = 'S' */

                 /* LOOP dos dispositivos que estão dentro da permissão*/
                 FOREACH c_r058prm INTO l_r058prm.numeip,
                                        l_r058prm.tiplei,
                                        l_r058prm.coddsp,
                                        l_r058prm.fabmod,
                                        l_r058prm.codcen
                 LOOP
                     /* trata registro de acordo com a leitora e tecnologia do crachá */
                     l_insere := FALSE;
                       /* Multitecnologia */
                     IF (l_r058prm.tiplei = 11) THEN
                         BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                           SELECT COUNT(1) INTO l_count
                             FROM R058RLG A
                                 ,R058LEC B
                            WHERE A.CODDSP = l_r058prm.coddsp
                              AND A.CODPLT = B.CODPLT
                              AND A.CODRLG = B.CODRLG
                              AND B.LEICRA = 4;
                           IF (l_count > 0) THEN
                             l_insere := TRUE;
                           END IF;
                         EXCEPTION
                           WHEN OTHERS THEN
                             l_count := 0;
                         END;

                       IF (p_numcra = p_numfis) THEN
                        l_insere := TRUE;
                       END IF;

                     END IF;

                     IF (l_insere = TRUE) THEN
                         /*verifica se já existe um registro ainda não enviado para este crachá e dispositivo */
                       IF (l_gersen = TRUE) THEN
                         SP_INTSTR(l_r058prm.coddsp,'999999999',l_coddsp OUT);
                         l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                         SP_PORCOMDSP(l_StrAux, l_r058prm.codcen);
                       END IF;
                     END IF;
                 END LOOP;
             ELSE
                 /* se não verifica permissão, gera para todos os dispositivos REP */
                 FOREACH c_r058prm2 INTO l_r058prm2.numeip,
                                         l_r058prm2.tiplei,
                                         l_r058prm2.coddsp,
                                         l_r058prm2.fabmod,
                                         l_r058prm2.codcen
                 LOOP
                     /* trata registro de acordo com a leitora e tecnologia do crachá */
                     l_insere := FALSE;

                     /* Multitecnologia */
                     IF (l_r058prm2.tiplei = 11) THEN
                         BEGIN
                           /* VERIFICA SE O DISPOSITIVO POSSÚI LEITORA BIOMÉTRICA(LEICRA = 4), CASO EXISTA INSERE */
                           SELECT COUNT(1) INTO l_count
                             FROM R058RLG A
                                 ,R058LEC B
                            WHERE A.CODDSP = l_r058prm2.coddsp
                              AND A.CODPLT = B.CODPLT
                              AND A.CODRLG = B.CODRLG
                              AND B.LEICRA = 4;
                           IF (l_count > 0) THEN
                             l_insere := TRUE;
                           END IF;
                         EXCEPTION
                           WHEN OTHERS THEN
                             l_count := 0;
                         END;

                         IF (p_numcra = p_numfis) THEN
                          l_insere := TRUE;
                         END IF;
                     END IF;

                     IF (l_insere = TRUE) THEN
                       IF (l_gersen = TRUE) THEN
                          SP_INTSTR(l_r058prm2.CodDsp,'999999999',l_coddsp OUT);
                          l_tipope := '0';
                          l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
                          SP_PORCOMDSP(l_StrAux, l_r058prm2.codcen);
                       END IF;
                     END IF;

                 END LOOP;
             END IF;
         END IF;
       END IF;
   END IF;
END␀rø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
