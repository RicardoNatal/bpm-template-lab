Á␀␀

PROCEDURE SP_RET_DOC_CONTCPF(p_tipdoc INTEGER, p_numdoc VARCHAR2(20), p_rettdo OUT NUMBER(1), p_retdoc OUT VARCHAR2(20))
 IS

  l_segtdo            NUMBER(1);
  l_segdoc            VARCHAR2(20);
  l_CPF               NUMBER(1);
  l_PASSAPORTE        NUMBER(1);
  l_REG_ESTRANGEIRO   NUMBER(1);
BEGIN
  /*Será priorizado os documentos na seguinte ordem:
   * - CPF
   * - Registro Estrangeiro
   * - Passaporte
   * 
   * OBS: O Registro Estrangeiro será retornado como Passaporte, para ser utilizado nas demais rotinas.
   */

  l_CPF := 2;
  l_PASSAPORTE := 4;
  l_REG_ESTRANGEIRO := 7;
  p_rettdo := p_tipdoc;
  p_retdoc := p_numdoc;
  
  IF (p_tipdoc = l_CPF) THEN
      p_rettdo := p_tipdoc;
      p_retdoc := p_numdoc;
  ELSE
	  BEGIN
		  SELECT SEGTDO, SEGDOC INTO l_segtdo, l_segdoc FROM R090VIS WHERE TIPDOC = p_tipdoc AND NUMDOC = p_numdoc;
	  EXCEPTION
		  WHEN OTHERS THEN
			l_segtdo := 0;
			l_segdoc := '0';
	  END;
	  
      IF (l_segtdo = l_CPF) THEN
      	  p_rettdo := l_CPF;
          p_retdoc := l_segdoc;
      ELSE
          IF ((p_tipdoc = l_REG_ESTRANGEIRO) OR (p_tipdoc = l_PASSAPORTE AND l_segtdo <> l_REG_ESTRANGEIRO)) THEN
          	  p_rettdo := l_PASSAPORTE;
              p_retdoc := p_numdoc;
          ELSE
              IF (l_segtdo = l_REG_ESTRANGEIRO OR l_segtdo = l_PASSAPORTE) THEN
                  p_rettdo := l_PASSAPORTE;
                  p_retdoc := l_segdoc;
		      END IF;    
          END IF;
      END IF;
  END IF;
END		SENIOR;21
Á␀␀

