␀␀PROCEDURE R066SIT_ATUSAL(IN_TIPOPE VARCHAR2(255),IN_NUMEMP NUMBER(4),IN_TIPCOL NUMBER(1),IN_NUMCAD NUMBER(9),IN_DATAPU DATE,IN_CODSIT NUMBER,IN_NEWQTDHOR NUMBER,IN_OLDQTDHOR NUMBER)
 IS

/* V_DESOPE      VARCHAR2(20); */
     /* V_CONDEP      NUMBER(3);    */
     /* V_DATATU      VARCHAR2(20); */
     V_CODSAL      NUMBER(2);
     V_SITSOM      NUMBER(3);
     V_SITDIM      NUMBER(3);
     V_ALTSAL      NUMBER(10);
     V_SALATU      NUMBER(10);
     V_TIPOPE      NUMBER(1);
     CURSOR C_BUSSALSIT IS
            SELECT CODSAL,SITSOM,SITDIM FROM R010CSA
            WHERE  SITSOM = IN_CODSIT OR
                   SITDIM = IN_CODSIT
            ORDER BY CODSAL;
     BEGIN
     /* Seta Descricao do Tipo de Operacao. */
     /*
     IF  (IN_TIPOPE = 'I') THEN
         V_DESOPE := ' R066SIT_INSERT ';
     ELSIF (IN_TIPOPE = 'U') THEN
         V_DESOPE := ' R066SIT_UPDATE ';
     ELSIF (IN_TIPOPE = 'D') THEN
         V_DESOPE := ' R066SIT_DELETE ';
     END;
     */

     /* Busca Data/Hora Atual do Oracle p/ Log de Depuracao. */
     /* SELECT TO_CHAR (SYSDATE, 'DD/MM/YYYY hh:mi') INTO V_DATATU FROM DUAL; */
     /* V_CONDEP := 1; */

     /* Inicializa Variaveis Auxiliares. */
     V_ALTSAL := 0;
     V_SALATU := 0;

     /* Busca os Saldos de Situacoes a Serem Alterados. */
     FOREACH C_BUSSALSIT INTO V_CODSAL,V_SITSOM,V_SITDIM
     LOOP
          /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'[CODSAL,SITSOM,SITDIM]: '||V_CODSAL||' '||V_SITSOM||' '||V_SITDIM); */
          /* V_CONDEP := V_CONDEP + 1; */

          /* Calcula o Valor da Alteracao do Saldo. */
          IF   (IN_TIPOPE = 'I') THEN
               BEGIN
               V_ALTSAL := IN_NEWQTDHOR;
               IF   (IN_CODSIT = V_SITDIM) THEN
                    V_ALTSAL := V_ALTSAL * (-1);
               END IF;
               END;
          ELSIF (IN_TIPOPE = 'U') THEN
               BEGIN
               V_ALTSAL := IN_OLDQTDHOR - IN_NEWQTDHOR;
               IF   (IN_CODSIT = V_SITSOM) THEN
                    V_ALTSAL := V_ALTSAL * (-1);
               END IF;
               END;
          ELSIF (IN_TIPOPE = 'D') THEN
               BEGIN
               V_ALTSAL := IN_OLDQTDHOR;
               IF   (IN_CODSIT = V_SITSOM) THEN
                    V_ALTSAL := V_ALTSAL * (-1);
               END IF;
               END;
          END IF;

          /* Inicializa Variavel c/ Tipo de Operacao a Ser Realizada no Calculo. */
          V_TIPOPE := 0;

          /* Verifica se Existe Historico do Saldo de Situacao na Data. */
          BEGIN
               SELECT IFNULL (HORSAL,0) INTO V_SALATU FROM R010SAL
                      WHERE NUMEMP = IN_NUMEMP AND TIPCOL = IN_TIPCOL AND NUMCAD = IN_NUMCAD AND
                            CODSAL = V_CODSAL AND DATALT = IN_DATAPU AND ORIALT = 'A';
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    V_SALATU := 0;
                    V_TIPOPE := 1;
          END;
          /* Seta o Valor do Saldo Atual. */
          V_SALATU := V_SALATU + V_ALTSAL;
          IF   (V_SALATU = 0) THEN
               /* Verifica se tem registro. */
               IF    (V_TIPOPE = 0) THEN
                    BEGIN
                    DELETE FROM R010SAL
                    WHERE NUMEMP = IN_NUMEMP AND TIPCOL = IN_TIPCOL AND NUMCAD = IN_NUMCAD AND
                          CODSAL = V_CODSAL AND DATALT = IN_DATAPU AND ORIALT = 'A';

                    END;
                END IF;
          /* Realiza Alteracao/Inclusao do Historico do Saldo de Situacoes. */
          ELSIF   (V_TIPOPE = 0) THEN
               BEGIN
               UPDATE R010SAL SET HORSAL = V_SALATU
                      WHERE NUMEMP = IN_NUMEMP AND TIPCOL = IN_TIPCOL AND NUMCAD = IN_NUMCAD AND
                            CODSAL = V_CODSAL AND DATALT = IN_DATAPU AND ORIALT = 'A';

               /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'Alterado Valor Saldo: '||V_SALATU); */
               /* V_CONDEP := V_CONDEP + 1; */
               END;
          ELSIF (V_TIPOPE = 1) THEN
               BEGIN
               INSERT INTO R010SAL(NUMEMP,TIPCOL,NUMCAD,CODSAL,DATALT,ORIALT,HORSAL)
                      VALUES (IN_NUMEMP,IN_TIPCOL,IN_NUMCAD,V_CODSAL,IN_DATAPU,'A',V_SALATU);

               /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'Incluido Valor Saldo: '||V_SALATU); */
               /* V_CONDEP := V_CONDEP + 1; */
               END;
          END IF;
     END LOOP;
     END␀Ù␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE R068RSP_ATUCON(P_TIPOPE CHAR(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_DATALT DATE,P_REARES CHAR(1))
 IS

l_data_atual  DATE;
  l_datalt      CHAR(1);
  l_reares      CHAR(1);
  l_concre      NUMBER(1);
BEGIN
  NULL;
END		SENIOR;20
"␀␀PROCEDURE R068RSP_ATUCON(P_TIPOPE CHAR(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_DATALT DATE,P_REARES CHAR(1))
 IS

l_data_atual  DATE;
  l_datalt      CHAR(1);
  l_reares      CHAR(1);
  l_concre      NUMBER(1);
BEGIN
  l_data_atual := CURDATE();

  /*Ontem a situação atual da R068RSP*/
  BEGIN
      SELECT REARES INTO l_reares
      FROM R068RSP
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND
            NUMCAD = p_numcad AND
            DATALT IN (SELECT MAX(DATALT)
                       FROM R068RSP
                       WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND
                       NUMCAD = p_numcad AND DATALT <= l_data_atual);
  EXCEPTION
      WHEN NO_DATA_FOUND THEN l_reares := 'N';
      WHEN OTHERS THEN RAISERROR 103 'R068RSP_ATUCON 1: Erro No SELECT R068RSP.';
  END;

  IF ((l_reares IS NULL) OR (l_reares = '')) THEN
      l_reares := 'N';
  END IF;

  IF (l_reares = 'S') THEN
      l_concre := 4;
  ELSE
      l_concre := 0;
  END IF;

  /*Atualiza a R034DAC*/
  BEGIN
      UPDATE R034DAC
      SET CONCRE = l_concre
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R068RSP_ATUCON 1: Erro na atualização da R034DAC.';
  END;
END		SENIOR;21
