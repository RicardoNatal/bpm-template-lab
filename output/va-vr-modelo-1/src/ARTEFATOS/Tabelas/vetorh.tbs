TRIGGER R036DEP_AD AFTER DELETE ON R036DEP FOR EACH ROW

DECLARE
    l_DataAlteracao DATE;
    l_layout VARCHAR2(6);
    l_layoutAlteracaoCadastral VARCHAR2(6);
    l_JsonFlags VARCHAR2(2000);
    l_temAud       BOOLEAN;
  	l_codRPA       NUMBER(15);
  	l_codSistema   NUMBER(2);
 	l_codcpa       NUMBER(4);
  	l_codtpa       NUMBER(4);
 	l_datTemp      VARCHAR(10);
BEGIN
  /*e-Social*/
  
  IF(:OLD.TIPDEP <> 0) THEN
  l_JsonFlags := '';
  
  RH_LAYOUTCOLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layout OUT);
  IF (l_layout IS NOT NULL) THEN
    l_DataAlteracao := CURDATE();
    IF (:OLD.GRAPAR = 3) THEN
      SP_CONCATENAR_DES('INFNAS', '0', l_JsonFlags OUT);
      SP_E_SOCIAL(l_layout, 'R036DEP', 'N', 'I', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_JsonFlags, '', 0, NULL, l_DataAlteracao, 0, 'R036DEP_AD');
    END IF;

    IF ((:OLD.GRAPAR = 3) OR (:OLD.TIPDEP <> 0)) THEN
      IF (:OLD.TIPDEP = 0) THEN
        SP_CONCATENAR_DES('INFNAS', '0', l_JsonFlags OUT);
      END IF;
      RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
      SP_E_SOCIAL(l_layoutAlteracaoCadastral, 'R036DEP', 'N', 'I', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_JsonFlags, '', 0, NULL, l_DataAlteracao, 0, 'R036DEP_AD');
    END IF;
   END IF;
  END IF;
  /*e-Social*/
  /* Geração de logs Dependente (Tabela: R036DEP)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 80;     /* Dependente (Tabela: R036DEP)*/
  l_codtpa := 271;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R036DEP_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDEP', CONVERT(NUMBER_TO_CHAR, :OLD.CODDEP));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R036DEP_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMDEP', :OLD.NOMDEP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMMAE', :OLD.NOMMAE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'GRAPAR', CONVERT(NUMBER_TO_CHAR, :OLD.GRAPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPDEP', CONVERT(NUMBER_TO_CHAR, :OLD.TIPDEP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPSEX', :OLD.TIPSEX);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCIV', CONVERT(NUMBER_TO_CHAR, :OLD.ESTCIV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'GRAINS', CONVERT(NUMBER_TO_CHAR, :OLD.GRAINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LIMIRF', CONVERT(NUMBER_TO_CHAR, :OLD.LIMIRF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LIMSAF', CONVERT(NUMBER_TO_CHAR, :OLD.LIMSAF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AVIIMP', :OLD.AVIIMP);
        SP_DATSTR(:OLD.DATNAS, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATNAS', l_datTemp);
        SP_DATSTR(:OLD.DATINV, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINV', l_datTemp);
        SP_DATSTR(:OLD.DATVAC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATVAC', l_datTemp);
        SP_DATSTR(:OLD.ENTCER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENTCER', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PAINAS', CONVERT(NUMBER_TO_CHAR, :OLD.PAINAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTNAS', :OLD.ESTNAS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LOCNAS', CONVERT(NUMBER_TO_CHAR, :OLD.LOCNAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMCAR', :OLD.NOMCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLIV', :OLD.NUMLIV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMREG', :OLD.NUMREG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMFOL', :OLD.NUMFOL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DEPBOL', :OLD.DEPBOL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DSPINS', :OLD.DSPINS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCPF', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCPF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMMAT', CONVERT(NUMBER_TO_CHAR, :OLD.NUMMAT));
        SP_DATSTR(:OLD.DATINC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINC', l_datTemp);
        SP_DATSTR(:OLD.DATEXC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATEXC', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AUXCRE', :OLD.AUXCRE);
