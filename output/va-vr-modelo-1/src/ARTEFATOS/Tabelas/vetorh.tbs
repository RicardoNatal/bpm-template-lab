TRIGGER R304CAP_SI AFTER INSERT ON R304CAP
DECLARE
	CURSOR c_R304CAP IS
	SELECT NUMEMP, NUMATO, DATATO, NUMMAT, NUMCPF, CODUNI, SEQREG, PUBATO
	  FROM R304CAP
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304CAP IS RECORD (
		NUMEMP   R304CAP.NumEmp%TYPE,
		NUMATO   R304CAP.NUMATO%TYPE,
		DATATO   R304CAP.DATATO%TYPE,
		NUMMAT   R304CAP.NUMMAT%TYPE,
		NUMCPF   R304CAP.NUMCPF%TYPE,
		CODUNI   R304CAP.CODUNI%TYPE,
		SEQREG   R304CAP.SeqReg%TYPE,
		PUBATO   R304CAP.PubAto%TYPE
	);
    
    l_R304CAP t_R304CAP;    
	l_PidSta VARCHAR2(30);
	l_DesRes VARCHAR2(250);
BEGIN
	FOREACH c_R304CAP INTO l_R304CAP.NumEmp, l_R304CAP.NUMATO, l_R304CAP.DATATO, l_R304CAP.NUMMAT, l_R304CAP.NUMCPF, l_R304CAP.CODUNI, l_R304CAP.SeqReg, l_R304CAP.PubAto
	LOOP
		/* Gera um novo PID */
		SP_GERPIDSTA(l_R304CAP.NumEmp, 18, l_PidSta OUT);
		
		/* Inclui registro de status na tabela R304STA */
		l_DesRes := 'Número do ato : ' || l_R304CAP.NUMATO||', Data Ato: ' || CONVERT(DATE_TO_CHAR,l_R304CAP.DATATO)
		            || ', Número Matrícula: ' || l_R304CAP.NUMMAT ||', CPF: ' || CONVERT(NUMBER_TO_CHAR, l_R304CAP.NUMCPF) 
		            ||', Cod Unidade: ' || CONVERT(NUMBER_TO_CHAR, l_R304CAP.CODUNI) || '.';
		            
		SP_GERSTA_ESFINGE(18, l_PidSta, l_R304CAP.PubAto, l_DesRes, l_R304CAP.NumEmp, 0, 0);
		
		BEGIN
			UPDATE R304CAP 
			   SET PIDSTA = l_PidSta 
			 WHERE NUMEMP = l_R304CAP.NumEmp 
			   AND NUMATO = l_R304CAP.NUMATO
			   AND DATATO = l_R304CAP.DATATO
			   AND NUMMAT = l_R304CAP.NUMMAT
			   AND NUMCPF = l_R304CAP.NUMCPF
			   AND CODUNI = l_R304CAP.CODUNI
			   AND SEQREG = l_R304CAP.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304CAP.';
		END;
	END LOOP;
END␀Nå␀␀		SENIOR;0␀␀TRIGGER R304CAP_EI BEFORE INSERT ON R304CAP FOR EACH ROW
DECLARE
	l_SeqReg   R304CAP.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_StaEnv   R304STA.StaEnv%TYPE;
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Busca a última sequência cadastrada para a mesma Empresa/Edital */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304CAP
		 WHERE NUMEMP = :NEW.NumEmp
		   AND numato = :NEW.numato
		   AND datato = :NEW.datato
		   AND nummat = :NEW.nummat
		   AND numcpf = :NEW.numcpf
		   AND coduni = :NEW.coduni
		   AND SEQREG <> :NEW.SeqReg;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304CAP.';
	END;
	
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
		
		/* Busca o status da última sequência */
		BEGIN
			SELECT STA.STAENV INTO l_StaEnv
			  FROM R304CAP CAP, R304STA STA
			 WHERE CAP.NUMEMP = :NEW.NumEmp
			   AND CAP.numato = :NEW.numato
		   	   AND CAP.datato = :NEW.datato
		  	   AND CAP.nummat = :NEW.nummat
		       AND CAP.numcpf = :NEW.numcpf
		       AND CAP.coduni = :NEW.coduni
			   AND CAP.SEQREG = l_SeqReg
			   AND CAP.PIDSTA = STA.PIDSTA;
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				RAISERROR 103 'Não encontrou status do último registro.';
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar status do registro com última sequência na tabela R304CAP.';
		END;
		
		/* Verifica se a última sequência está com status Cancelado */
		IF (l_StaEnv <> 'N') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que o registro de sequência ' || l_SeqRegStr || ' esteja com status Cancelado.';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀Lå␀␀		SENIOR;04␀␀

TRIGGER R304CAP_AU AFTER UPDATE ON R304CAP FOR EACH ROW
BEGIN
	IF (:OLD.PUBATO <> :NEW.PUBATO) THEN
		BEGIN
			UPDATE R304STA SET DATREF = :NEW.PUBATO WHERE PIDSTA = :NEW.PidSta;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar data de referência na tabela R304STA';
		END;
	END IF;
END␀Oå␀␀		SENIOR;0±␀␀

TRIGGER R304CAP_EU BEFORE UPDATE ON R304CAP FOR EACH ROW
DECLARE
	l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
	/* Não deixa alterar registro caso status seja diferente de P - Pendente Envio e R - Erro Envio */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados/excluídos.';
	END IF;
END␀På␀␀	SENIOR;0/␀␀

TRIGGER R304CAP_SD AFTER DELETE ON R304CAP
BEGIN
	BEGIN
		DELETE FROM R304STA
		 WHERE LAYOUT = 18
		   AND NOT EXISTS (SELECT 1 FROM R304CAP WHERE R304CAP.PIDSTA = R304STA.PIDSTA);
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao excluir registros não utilizados na tabela R304STA.';
	END;
END␀Kå␀␀		SENIOR;0˜

TRIGGER R304CAP_AD AFTER DELETE ON R304CAP FOR EACH ROW
BEGIN
	/* Exclui registro de status na tabela R304STA */	
	SP_EXCSTA_ESFINGE(:OLD.PidSta);
END␀Må␀␀		SENIOR;0␀␀

TRIGGER R304CAP_ED BEFORE DELETE ON R304CAP FOR EACH ROW
DECLARE
	l_QtdReg NUMBER;
BEGIN
	/* Verifica se tem registros na tabela filha R304PCA */
	l_QtdReg := 0;	
	BEGIN
		SELECT COUNT(1) INTO l_QtdReg FROM R304PCA WHERE PIDSTA = :OLD.PidSta;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar quantidade de registros na tabela R304PCA.';
	END;	
	IF (l_QtdReg > 0) THEN
		RAISERROR 103 'Não é possível efetuar a exclusão da Concessão Aposentadoria, pois existem provento(s) da concessão aposentadoria.';
	END IF;
	
	l_QtdReg := 0;	
	BEGIN
		SELECT COUNT(1) INTO l_QtdReg FROM R304ACA WHERE PIDSTA = :OLD.PidSta;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar quantidade de registros na tabela R304ACA.';
	END;	
	IF (l_QtdReg > 0) THEN
		RAISERROR 103 'Não é possível efetuar a exclusão da Concessão Aposentadoria, pois existem arquivos(s) da concessão aposentadoria.';
	END IF;
	
	l_QtdReg := 0;	
	BEGIN
		SELECT COUNT(1) INTO l_QtdReg FROM R304TCA WHERE PIDSTA = :OLD.PidSta;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar quantidade de registros na tabela R304TCA.';
	END;	
	IF (l_QtdReg > 0) THEN
		RAISERROR 103 'Não é possível efetuar a exclusão da Concessão Aposentadoria, pois existem tempos de serviço da concessão aposentadoria.';
	END IF;	
END␀␀␀%*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Rå␀␀…¬␀␀´␀	Ôÿ␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀‚¬␀␀	Ôÿ␀␀␀␀␀Ä±␀␀<¯␀␀\±␀␀%␀␀ÿ␀␀ÿ␀£DÑ␀	Ôÿ␀␀␀␀␀nI\FnIqC␀êÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀5Â␀␀EÔÿ␀␀␀␀␀,Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀␀␀Så␀␀␀␀0;1;2;3Zå␀␀	SENIOR;0½␀␀

TRIGGER R304CCO_SI AFTER INSERT ON R304CCO
DECLARE
	CURSOR c_R304CCO IS
	SELECT NUMEMP, NUMEDI, SEQREG, DATCON
	  FROM R304CCO
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304CCO IS RECORD (
		NUMEMP   R304CCO.NumEmp%TYPE,
		NUMEDI   R304CCO.NumEdi%TYPE,
		SEQREG   R304CCO.SeqReg%TYPE,
		DATCON   R304CCO.DATCON%TYPE
	);
    
    l_R304CCO t_R304CCO;    
	l_PidSta VARCHAR2(30);
	l_DesRes VARCHAR2(250);
BEGIN
	FOREACH c_R304CCO INTO l_R304CCO.NumEmp, l_R304CCO.NumEdi, l_R304CCO.SeqReg, l_R304CCO.DATCON
	LOOP
		/* Gera um novo PID */
		SP_GERPIDSTA(l_R304CCO.NumEmp, 17, l_PidSta OUT);
		
		/* Inclui registro de status na tabela R304STA */
		l_DesRes := 'Número do Edital: ' || l_R304CCO.NumEdi ||', Data da Convocação: ' || CONVERT(DATE_TO_CHAR,l_R304CCO.DATCON);
		SP_GERSTA_ESFINGE(17, l_PidSta, l_R304CCO.DATCON, l_DesRes, l_R304CCO.NumEmp, 0, 0);
		
		BEGIN
			UPDATE R304CCO 
			   SET PIDSTA = l_PidSta 
			 WHERE NUMEMP = l_R304CCO.NumEmp 
			   AND NUMEDI = l_R304CCO.NumEdi
			   AND DATCON = l_R304CCO.DATCON
			   AND SEQREG = l_R304CCO.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304CCO.';
		END;
	END LOOP;
END␀Wå␀␀		SENIOR;0H␀␀TRIGGER R304CCO_EI BEFORE INSERT ON R304CCO FOR EACH ROW
DECLARE
	l_SeqReg   R304CCO.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_StaEnv   R304STA.StaEnv%TYPE;
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Busca a última sequência cadastrada para a mesma Empresa/Edital */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304CCO
		 WHERE NUMEMP = :NEW.NumEmp
		   AND NUMEDI = :NEW.NumEdi
		   AND DATCON = :NEW.DATCON
		   AND SEQREG <> :NEW.SeqReg;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304CCO.';
	END;
	
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
		
		/* Busca o status da última sequência */
		BEGIN
			SELECT STA.STAENV INTO l_StaEnv
			  FROM R304CCO CCO, R304STA STA
			 WHERE CCO.NUMEMP = :NEW.NumEmp
			   AND CCO.NUMEDI = :NEW.NumEdi
			   AND CCO.DATCON = :NEW.DATCON
			   AND CCO.SEQREG = l_SeqReg
			   AND CCO.PIDSTA = STA.PIDSTA;
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				RAISERROR 103 'Não encontrou status do último registro.';
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar status do registro com última sequência na tabela R304CCO.';
		END;
		
		/* Verifica se a última sequência está com status Cancelado */
		IF (l_StaEnv <> 'N') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que o registro de sequência ' || l_SeqRegStr || ' esteja com status Cancelado.';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀Uå␀␀		SENIOR;04␀␀

TRIGGER R304CCO_AU AFTER UPDATE ON R304CCO FOR EACH ROW
BEGIN
	IF (:OLD.DATCON <> :NEW.DATCON) THEN
		BEGIN
			UPDATE R304STA SET DATREF = :NEW.DATCON WHERE PIDSTA = :NEW.PidSta;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar data de referência na tabela R304STA';
		END;
	END IF;
END␀Xå␀␀		SENIOR;0±␀␀

TRIGGER R304CCO_EU BEFORE UPDATE ON R304CCO FOR EACH ROW
DECLARE
	l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
	/* Não deixa alterar registro caso status seja diferente de P - Pendente Envio e R - Erro Envio */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados/excluídos.';
	END IF;
END␀Yå␀␀	SENIOR;0/␀␀

TRIGGER R304CCO_SD AFTER DELETE ON R304CCO
BEGIN
	BEGIN
		DELETE FROM R304STA
		 WHERE LAYOUT = 17
		   AND NOT EXISTS (SELECT 1 FROM R304CCO WHERE R304CCO.PIDSTA = R304STA.PIDSTA);
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao excluir registros não utilizados na tabela R304STA.';
	END;
END␀Tå␀␀		SENIOR;0˜

TRIGGER R304CCO_AD AFTER DELETE ON R304CCO FOR EACH ROW
BEGIN
	/* Exclui registro de status na tabela R304STA */	
	SP_EXCSTA_ESFINGE(:OLD.PidSta);
END␀Vå␀␀		SENIOR;0%␀␀

TRIGGER R304CCO_ED BEFORE DELETE ON R304CCO FOR EACH ROW
DECLARE
	l_QtdReg NUMBER;
BEGIN
	/* Verifica se tem registros na tabela filha R304RCO */
	l_QtdReg := 0;	
	BEGIN
		SELECT COUNT(1) INTO l_QtdReg FROM R304RCO WHERE PIDSTA = :OLD.PidSta;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar quantidade de registros na tabela R304RCO.';
	END;	
	IF (l_QtdReg > 0) THEN
		RAISERROR 103 'Não é possível efetuar a exclusão do convocação do concurso, pois existem relação da convocação do concurso cadastrados para o mesmo.';
	END IF;
END␀␀␀(*␀␀␀␀␀␀␀[å␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀O,	Ôÿ?␀␀␀␀␀0@…:/@x␀␀ÿ␀␀^å␀␀␀ëÑ␀	Ôÿ␀␀␀␀␀¥␀␀¥␀␀¥␀␀œ␀␀␀êÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀8¦␀␀t	Ôÿ␀␀␀␀␀å␀␀3¦␀␀Òep␀Æÿ␀␀ÿ␀D¦␀␀yÔÿ?␀␀␀␀␀^¦␀␀T¦␀␀Ñer␀Æÿ␀␀ÿ␀IT	Ôÿ?␀␀␀␀␀ĞXØVÏX␀␀ÿ␀␀ÿ␀	Ôÿ?␀␀␀␀␀]Yşÿ␀␀ÿ␀␀ÿ␀Z␀␀¥	Ôÿ␀␀␀␀␀ì␀␀*␀␀ë␀␀c␀␀␀ÿ␀␀ÿ␀­-±␀Ôÿ␀␀␀␀␀	>´␀û␀q␀␀Æÿ␀␀Ï␀␀␀…,´␀Ôÿ␀␀␀␀␀_@NgNgr␀␀Æÿ␀␀#␀5Â␀␀EÔÿ␀␀␀␀␀,Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀)+Ñ␀Ôÿ␀␀␀␀␀M&M&M&qC␀␀êÿ␀␀ÿ␀++Ñ␀Ôÿ␀␀␀␀␀U&U&U&qC␀␀êÿ␀␀ÿ␀,+Ç␀Ôÿ␀␀␀␀␀W&W&W&z␀Æÿ␀␀ÿ␀-+Ç␀Ôÿ␀␀␀␀␀Y&Y&Y&z␀Æÿ␀␀ÿ␀.+Ç␀Ôÿ␀␀␀␀␀[&[&[&z␀Æÿ␀␀ÿ␀/+Ç␀Ôÿ␀␀␀␀␀\&\&\&z␀Æÿ␀␀ÿ␀0+'Ôÿ␀␀␀␀␀]&]&]&D␀␀ÿ␀␀ÿ␀1+'Ôÿ␀␀␀␀␀^&^&^&D␀␀ÿ␀␀ÿ␀2+*Ôÿ␀␀␀␀␀_&_&_&,␀␀ÿ␀␀ÿ␀␀␀\å␀␀␀␀0;1;2;3cå␀␀	SENIOR;0␀␀

TRIGGER R304CFP_SI AFTER INSERT ON R304CFP
DECLARE
	CURSOR c_R304CFP IS
	SELECT NUMEMP, CODCOM, ANOMES, SEQREG
	  FROM R304CFP
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304CFP IS RECORD (
		NUMEMP   R304CFP.NumEmp%TYPE,
		CODCOM   R304CFP.CodCom%TYPE,
		ANOMES   R304CFP.AnoMes%TYPE,		
		SEQREG   R304CFP.SeqReg%TYPE
	);
	
    l_R304CFP t_R304CFP;
    
	l_PidSta VARCHAR2(30);
	l_AnoMesStr VARCHAR(7);
	l_DesRes VARCHAR(250);
BEGIN
	FOREACH c_R304CFP INTO l_R304CFP.NumEmp, l_R304CFP.CodCom, l_R304CFP.AnoMes, l_R304CFP.SeqReg
	LOOP		
		/* Gera um novo PID */
		SP_GERPIDSTA(l_R304CFP.NumEmp, 13, l_PidSta OUT);
		
		SP_DATSTR(l_R304CFP.AnoMes, 'MM/YYYY', l_AnoMesStr OUT);
		
		/* Inclui registro de status na tabela R304STA */
		l_DesRes := 'Empresa: ' || CONVERT(NUMBER_TO_CHAR, l_R304CFP.NumEmp) ||
						', Código do componente: ' || l_R304CFP.CodCom ||
						', Mês e ano componente: ' || l_AnoMesStr;		
			
		SP_GERSTA_ESFINGE(13, l_PidSta, l_R304CFP.AnoMes, l_DesRes, l_R304CFP.NumEmp, 0, 0);					
		
		/* Altera registro recém inserido informado campo PID */
		BEGIN
			UPDATE R304CFP
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304CFP.NumEmp
			   AND CODCOM = l_R304CFP.CodCom
			   AND ANOMES = l_R304CFP.AnoMes
			   AND SEQREG = l_R304CFP.SeqReg;
		EXCEPTION WHEN OTHERS THEN
	    	RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304CFP.';
		END;			
	END LOOP;
END␀`å␀␀		SENIOR;0í␀␀TRIGGER R304CFP_EI BEFORE INSERT ON R304CFP FOR EACH ROW
DECLARE
	l_SeqReg NUMBER(9);
	l_StaEnv CHAR;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Busca última sequência cadastrada */
	BEGIN
		SELECT CFP.SEQREG, STA.STAENV INTO l_SeqReg, l_StaEnv 
		  FROM R304CFP CFP, R304STA STA
		 WHERE CFP.PIDSTA = STA.PIDSTA
		   AND CFP.NUMEMP = :NEW.NumEmp
		   AND CFP.CODCOM = :NEW.CodCom
		   AND CFP.ANOMES = :NEW.AnoMes		   			   
		   AND CFP.SEQREG = (SELECT MAX(CFP2.SEQREG) FROM R304CFP CFP2
		   					  WHERE CFP2.NUMEMP = CFP.NUMEMP
		   						AND CFP2.CODCOM = CFP.CodCom
		   						AND CFP2.ANOMES = CFP.AnoMes		   			   
		   					    AND CFP2.SEQREG < CFP.SeqReg);
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
			l_StaEnv := '';
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304CFP.';
	END;
	
	/* Verifica se encontrou última sequência */
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
		
		/* Verifica se a última sequência está com status Cancelado. Se não estiver, não permite o cadastro de um novo registro para a mesma empresa/componente da folha/ano e mês. */
		IF (l_StaEnv <> 'N') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que o registro de sequência ' || l_SeqRegStr || ' esteja com status Cancelado.';			
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀aå␀␀		SENIOR;01␀␀

