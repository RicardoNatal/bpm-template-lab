  l_CenPen       VARCHAR2(255);

BEGIN
  /* verifica se existe alguma centralizadora gerenciada pela Senior */
  SP_GERSEN(l_gersen OUT);
  IF   (l_gersen = TRUE) THEN
      l_CenPen := '0';

      /*Obtem a data/hora de envio da pendência.*/
      l_data_atual := CURDATE();
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
      SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
      /*Obtem o Segundo*/
      l_seqenv := SECOND(CURTIME());
      SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
      l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

      l_idtpes := :OLD.IdtPes;
      SP_DATSTR(:OLD.DatRev,'DDMMYYYY',l_datrev OUT);

      l_StrAux := '61'||l_datenv||l_idtpes||l_datrev||'2';
      SP_PorCom(l_StrAux, l_CenPen);
  END IF;
END␀␀␀Â␀␀␀␀␀␀␀~Ú␀␀f-Ì␀	␀␀␀␀␀␀ı;Œô␀␀ı;{␀Æÿ	11€Ú␀␀␀7‹␀␀3	␀␀␀␀␀␀bŠ␀␀YŠ␀␀bŠ␀␀4␀␀ÿ␀␀ÿ␀u¬␀␀–␀	␀␀␀␀␀␀>±␀␀)8)8n
