          SELECT @l_OLDhorfim = SUBSTRING(@l_OLDhorfim,1,2)+':'+SUBSTRING(@l_OLDhorfim,3,2)
          EXECUTE  @ChkError = SP_INTSTR @l_staaccANT,'9',@l_OLDstaacc OUTPUT
          IF @ChkError <> 0
