  END;

  SP_CONCATENAR_NUM('CODPRO', :OLD.CODPRO, l_Valor OUT);
  SP_CONCATENAR_DAT('DATINI', :OLD.DATINI, l_Valor OUT);
  
  SP_E_SOCIAL('S-1070', 'R030PRH', 'T', 'E', :OLD.DATINI, l_ProximaData, :OLD.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030PRS_ED');
END␀␀␀šÆ␀␀␀␀␀␀␀␀␀␀␀␀ŒÒ␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀—,¼␀	Ôÿ?␀␀␀␀␀=nnX)␀␀Æÿ␀␀!#␀mDÑ␀	Ôÿ?␀␀␀␀␀şEşEşEœ␀␀␀êÿ␀␀Ò␀␀␀¡␀␀nÔÿ?␀␀␀␀␀Ú¯␀␀Ú¯␀␀Ú¯␀␀l␀␀ÿ␀␀ÿ␀£ï␀␀=Ôï!␀␀␀␀␀¼ï␀␀¼ì␀␀»ï␀␀c␀␀␀ÿ␀␀ÿ␀'-´␀Ôÿ1␀␀␀␀␀AÉ»␀␀Ñ»␀␀r␀Æÿ␀␀Û␀␀␀},TÔÿ1␀␀␀␀␀ifLf[fp␀␀␀ÿ␀␀Û␀␀␀A,Á␀Ôÿ1␀␀␀␀␀j<o*w*/›‡␀Æÿ␀␀Û␀␀␀ä␀SÔÿ1␀␀␀␀␀_␀|␀_␀n␀Æÿ␀␀ÿ␀~‘␀␀␀Ôÿ1␀␀␀␀␀â"E¯␀␀¢¯␀␀.␀Æÿ␀␀ÿ␀Ğ)Ôÿ1␀␀␀␀␀â"E¯␀␀¢¯␀␀£␀␀ÿ␀␀O"␀v§␀␀Ôÿ1␀␀␀␀␀}©␀␀6¨␀␀|©␀␀␀␀ÿ␀␀ÿ␀ş␀KÔÿ1␀␀␀␀␀²Â␀␀±Â␀␀±Â␀␀n␀Æÿ␀␀ÿ␀9␀Ÿ␀Ôï!␀␀␀␀␀D$␀"␀"␀l)␀␀Æÿ␀␀ÿ␀␀␀␀0;1;2Ò␀␀		SENIOR;0¬␀␀TRIGGER R030PUB_EI BEFORE INSERT ON R030PUB FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);  
  l_ProximaData DATE;
  l_EmpresaStr VARCHAR2(11);
  l_FilialStr VARCHAR2(11);
  l_Where VARCHAR2(50);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN 
  /*e-Social -> S-1000 */ 
  l_Valor := '';
  l_ProximaData := '31/12/1900,00:00:00';

  l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP);
  l_FilialStr := CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL);

  l_Where := 'NUMEMP = ' ||  l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr;    
  SP_PROXIMOHIST('DATALT', 'R030PUB', l_Where, :NEW.DATALT, l_ProximaData OUT);

  SP_CONCATENAR_NUM('CODFIL', :NEW.CODFIL, l_Valor OUT);
  SP_E_SOCIAL('S-1000', 'R030PUB', 'T', 'I', :NEW.DATALT, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030PUB_EI');
  /*e-Social -> S-1000 */
  
  
  /* Geração de logs - Filiais - Informações Órgão Público */ 
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 56;     /* Filiais - Informações Órgão Público */
  l_codtpa := 223;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030PUB_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
        SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030PUB_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDSIA', :NEW.INDSIA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REGPRO', :NEW.REGPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPAI', CONVERT(NUMBER_TO_CHAR, :NEW.CODPAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEST', :NEW.CODEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCID', CONVERT(NUMBER_TO_CHAR, :NEW.CODCID));
        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPORG', CONVERT(NUMBER_TO_CHAR, :NEW.TIPORG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INSEFR', CONVERT(NUMBER_TO_CHAR, :NEW.INSEFR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMENT', :NEW.NOMENT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPPOD', CONVERT(NUMBER_TO_CHAR, :NEW.TIPPOD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALSUP', CONVERT(NUMBER_TO_CHAR, :NEW.VALSUP));
      END;
  END IF; 
END␀Ò␀␀		SENIOR;0X␀␀

TRIGGER R030PUB_EU BEFORE UPDATE ON R030PUB FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);  
  l_ProximaData DATE;
  l_EmpresaStr VARCHAR2(11);
  l_FilialStr VARCHAR2(11);
  l_Where VARCHAR2(50);
  l_SimplificaoESocial BOOLEAN;
  l_InfoFacult BOOLEAN;    
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_Valido       BOOLEAN;
  l_AlterouRegistro_S1000 BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN 
  /*e-Social -> S-1000 */ 
  l_Valor := '';
  l_ProximaData := '31/12/1900,00:00:00';
  l_AlterouRegistro_S1000 := FALSE;
  l_SimplificaoESocial := FALSE;  
  l_VersaoESocial := 0;
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  
  IF (l_SimplificaoESocial = FALSE) THEN  
    SP_VALUPDATE_DES(:OLD.INDSIA, :NEW.INDSIA, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S1000 := TRUE;
    END IF;
  
    SP_VALUPDATE_NUM(:OLD.CODCID, :NEW.CODCID, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S1000 := TRUE;
    END IF;
  
    SP_VALUPDATE_DES(:OLD.CODEST, :NEW.CODEST, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S1000 := TRUE;
    END IF;
  
    SP_VALUPDATE_DES(:OLD.REGPRO, :NEW.REGPRO, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S1000 := TRUE;
    END IF;
  
    SP_VALUPDATE_NUM(:OLD.TIPORG, :NEW.TIPORG, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S1000 := TRUE;
    END IF;
  
    SP_VALUPDATE_DES(:OLD.NOMENT, :NEW.NOMENT, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S1000 := TRUE;
    END IF;
  
    SP_VALUPDATE_NUM(:OLD.TIPPOD, :NEW.TIPPOD, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S1000 := TRUE;
    END IF;
  
    SP_VALUPDATE_NUM(:OLD.VALSUP, :NEW.VALSUP, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S1000 := TRUE;
    END IF;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.INSEFR, :NEW.INSEFR, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
     l_AlterouRegistro_S1000 := TRUE;
  END IF;

  IF (l_AlterouRegistro_S1000 = TRUE) THEN
  	l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP);
  	l_FilialStr := CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL);

  	l_Where := 'NUMEMP = ' || l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr;
  	SP_PROXIMOHIST('DATALT', 'R030PUB', l_Where, :NEW.DATALT, l_ProximaData OUT);

  	SP_CONCATENAR_NUM('CODFIL', :NEW.CODFIL, l_Valor OUT);
  	SP_E_SOCIAL('S-1000', 'R030PUB', 'T', 'A', :NEW.DATALT, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030PUB_EU');
  END IF;
  /*e-Social -> S-1000 */
  
  /* Geração de logs - Filiais - Informações Órgão Público */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 56;     /* Filiais - Informações Órgão Público */
  l_codtpa := 224;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFil <> :NEW.CodFil)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.IndSIA <> :NEW.IndSIA)
   OR (:OLD.RegPro <> :NEW.RegPro)
   OR (:OLD.CodPai <> :NEW.CodPai)
   OR (:OLD.CodEst <> :NEW.CodEst)
   OR (:OLD.CodCid <> :NEW.CodCid)
   OR (:OLD.TipOrg <> :NEW.TipOrg)
   OR (:OLD.InsEfr <> :NEW.InsEfr)
   OR (:OLD.NomEnt <> :NEW.NomEnt)
   OR (:OLD.TipPod <> :NEW.TipPod)
   OR (:OLD.ValSup <> :NEW.ValSup)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030PUB_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030PUB_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINDSIA', :OLD.INDSIA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINDSIA', :NEW.INDSIA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDREGPRO', :OLD.REGPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWREGPRO', :NEW.REGPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPAI', CONVERT(NUMBER_TO_CHAR, :OLD.CODPAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPAI', CONVERT(NUMBER_TO_CHAR, :NEW.CODPAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODEST', :OLD.CODEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODEST', :NEW.CODEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCID', CONVERT(NUMBER_TO_CHAR, :OLD.CODCID));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCID', CONVERT(NUMBER_TO_CHAR, :NEW.CODCID));
        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPORG', CONVERT(NUMBER_TO_CHAR, :OLD.TIPORG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPORG', CONVERT(NUMBER_TO_CHAR, :NEW.TIPORG));        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINSEFR', CONVERT(NUMBER_TO_CHAR, :OLD.INSEFR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINSEFR', CONVERT(NUMBER_TO_CHAR, :NEW.INSEFR));        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOMENT', :OLD.NOMENT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNOMENT', :NEW.NOMENT);        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPPOD', CONVERT(NUMBER_TO_CHAR, :OLD.TIPPOD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPPOD', CONVERT(NUMBER_TO_CHAR, :NEW.TIPPOD));        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVALSUP', CONVERT(NUMBER_TO_CHAR, :OLD.VALSUP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWVALSUP', CONVERT(NUMBER_TO_CHAR, :NEW.VALSUP));
      END;
    END IF; 
  END IF; 
END␀Ò␀␀		SENIOR;0¯␀␀

TRIGGER R030PUB_ED BEFORE DELETE ON R030PUB FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);  
  l_ProximaData DATE;
  l_EmpresaStr VARCHAR2(11);
  l_FilialStr VARCHAR2(11);
  l_Where VARCHAR2(50);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);  
BEGIN 
  /*e-Social -> S-1000 */ 
  l_Valor := '';
  l_ProximaData := '31/12/1900,00:00:00';
  
  l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP);
  l_FilialStr := CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL);

  l_Where := 'NUMEMP = ' ||  l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr;    
  SP_PROXIMOHIST('DATALT', 'R030PUB', l_Where, :OLD.DATALT, l_ProximaData OUT);

  SP_CONCATENAR_NUM('CODFIL', :OLD.CODFIL, l_Valor OUT);
  SP_E_SOCIAL('S-1000', 'R030PUB', 'T', 'E', :OLD.DATALT, l_ProximaData, :OLD.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030PUB_ED');
  /*e-Social -> S-1000 */
  
  /* Geração de logs - Filiais - Informações Órgão Público */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 56;     /* Filiais - Informações Órgão Público */
  l_codtpa := 223;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030PUB_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030PUB_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDSIA', :OLD.INDSIA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REGPRO', :OLD.REGPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPAI', CONVERT(NUMBER_TO_CHAR, :OLD.CODPAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEST', :OLD.CODEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCID', CONVERT(NUMBER_TO_CHAR, :OLD.CODCID));
        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPORG', CONVERT(NUMBER_TO_CHAR, :OLD.TIPORG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INSEFR', CONVERT(NUMBER_TO_CHAR, :OLD.INSEFR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMENT', :OLD.NOMENT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPPOD', CONVERT(NUMBER_TO_CHAR, :OLD.TIPPOD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALSUP', CONVERT(NUMBER_TO_CHAR, :OLD.VALSUP));
      END;
  END IF; 
END␀␀␀n␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀‘Ò␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀—,¼␀	Ôÿ?␀␀␀␀␀=nnX)␀␀Æÿ␀␀!#␀ ½␀␀k	Ôÿ?␀␀␀␀␀Á␀␀¿¼␀␀çÀ␀␀n␀Æÿ␀␀ÿ␀$+Ñ␀	Ôÿ?␀␀␀␀␀:0–/ß/qC␀êÿ␀␀ÿ␀öı␀␀Ì␀	Ôÿ?␀␀␀␀␀ÿ␀␀İş␀␀İş␀␀{␀Æÿ␀␀ÿ␀/UEÔÿ?␀␀␀␀␀çW°V°VG␀␀ÿ␀␀ÿ␀°DÑ␀	Ôÿ?␀␀␀␀␀ÌIrHrHqC␀êÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀n␀␀␀␀␀␀␀␀’Ò␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀X-Ì␀	␀␀␀␀␀␀␀9A0í␀␀0í␀␀{␀Æÿ␀␀ØĞ␀␀␀—,¼␀␀␀␀␀␀␀␀=nnX)␀␀Æÿ␀␀!#␀␀␀␀0;1“Ò␀␀		SENIOR;0c␀␀TRIGGER R030RAT_EI AFTER INSERT ON R030RAT FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
BEGIN
  IF (:NEW.CODFIL <> 0) THEN
    l_Valor := '';
  
    SP_CONCATENAR_NUM('CODRAT', :NEW.CodRat, l_Valor OUT);

    SP_E_SOCIAL('S-1020', 'R030RAT', 'T', 'I', NULL, NULL, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030RAT_EI');
  END IF;
