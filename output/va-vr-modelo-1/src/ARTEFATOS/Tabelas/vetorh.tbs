Ã␀␀PROCEDURE SP_RETIDTPES(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(21),P_NUMMAT VARCHAR2(15),P_PROPAC VARCHAR2(20),P_IDTPES OUT CHAR(23))
 IS

l_idtpes       VARCHAR2(23);
    l_tippes       CHAR(2);
    l_numemp       CHAR(4);
    l_tipcol       CHAR(1);
    l_numcad       CHAR(10);
    l_tipdoc       CHAR(1);
BEGIN
  IF  p_tipcol < 4 THEN
      SP_INTSTR(p_tipcol,'99',l_tippes OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes||l_numemp||l_tipcol||l_numcad;
  END IF;
  IF  p_tipcol = 4 THEN  /* Visitante */
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes:= '04'||l_tipdoc||p_numdoc;
  END IF;
  IF  p_tipcol = 5 THEN
      SP_INTSTR(p_tipcol,'99',l_tippes OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes||l_numemp||l_numcad;
  END IF;
  IF  p_tipcol = 6 THEN  /* Aluno */
      l_idtpes:= '10'||p_nummat;
  END IF;
  IF  p_tipcol = 7 THEN  /*Responsáveis de alunos*/
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes:= '07'||l_tipdoc||p_numdoc;
  END IF;
  IF  p_tipcol = 9 THEN  /*Paciente*/
      l_idtpes:= '09'||p_propac;
  END IF;

  /*Preenche o campo com espaços para completar 23 posições*/
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);

  IF l_idtpes IS NULL THEN
      l_idtpes := ' ';
  END IF;

  LOOP
    /*Controle do Loop.*/
    IF (Length(l_idtpes) > 22) THEN
      EXIT;
    END IF;
    l_idtpes := ' '||l_idtpes;
  END LOOP;

  p_idtpes := l_idtpes;
END␀Âø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
OPROCEDURE SP_RETLOGPEN(P_LOGPEN OUT VARCHAR2(2047))
 IS
BEGIN
    NULL;
END		ORACLE;20
Æ␀␀/*
 * LINGUAGEM: ORACLE - PL/SQL
 * Procedure responsável por gerar o log de pendências
 * Retorna um log com as seguintes informações: Usuário de banco de dados, do sistema operacional, da aplicação senior,
 * nome da aplicação ativa, Host, Data e hora da ação e Call Stack da pilha atual.
 * Para este log se tornar ativo, o campo R070DAC.GERLPE deve estar setado com 'S'
 */
CREATE OR REPLACE PROCEDURE SP_RETLOGPEN
(
  p_logpen OUT varchar2
)
IS
  l_logpen       varchar2(2047);
  l_os_user      varchar2(20);
  l_app_user     varchar2(30);
  l_app_name     varchar2(30);
  l_session_user varchar2(20);
  l_host         varchar2(60);
  l_call_stack   varchar2(2000);
  l_data_atual   varchar2(20);
  l_gerlpe       CHAR(1);
  l_session_id   NUMBER(14);
BEGIN
  l_logpen := ' ';
  BEGIN
    SELECT GERLPE INTO l_gerlpe FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_gerlpe := 'N';
  END;

  IF (l_gerlpe = 'S') THEN
    l_data_atual := to_char(sysdate, 'dd/mm/yyyy hh24:mi:ss');
    /*BUSCA O USUÁRIO DA SESSÃO*/
    BEGIN
      l_session_user := sys_context('USERENV','SESSION_USER',20);
      if ( (l_session_user = '') or (l_session_user is null) ) then
        l_session_user := ' ';
      end if;
    EXCEPTION
      WHEN OTHERS THEN
        l_session_user := ' ';
    END;

    /*BUSCA O HOST DO CLIENT*/
    BEGIN
      l_host := sys_context('USERENV','HOST',60);
      if ( (l_host = '') or (l_host is null) ) then
        l_host := ' ';
      end if;
    EXCEPTION
      WHEN OTHERS THEN
        l_host := ' ';
    END;

    /*BUSCA O USUÁRIO DO S.O*/
    BEGIN
      l_os_user := sys_context('USERENV','OS_USER',20);
      if ( (l_os_user = '') or (l_os_user is null) ) then
        l_os_user := ' ';
      end if;
    EXCEPTION
      WHEN OTHERS THEN
        l_os_user := ' ';
    END;

    /*BUSCA O NOME DA APLICAÇÃO DONA DA SESSÃO*/
    BEGIN
      l_app_name := sys_context('USERENV','MODULE',30);
      if ( (l_app_name = '') or (l_app_name is null) ) then
        l_app_name := ' ';
      end if;
    EXCEPTION
      WHEN OTHERS THEN
        l_app_name := ' ';
    END;

    /*RETORNA O USUÁRIO DA APLICAÇÃO, CASO EXISTA SESSÃO ATIVA*/
    BEGIN
      SELECT APPUSR INTO l_app_user
        FROM R911SEC
       WHERE NUMSEC = sys_context('USERENV','SESSIONID');
    EXCEPTION
      WHEN OTHERS THEN
        l_app_user := ' ';
    END;
    /*Valida o campo*/
    if ( (l_app_user = '') or (l_app_user is null) ) then
      l_app_user := ' ';
    end if;

    /*RETORNA A CALL STACK DO CONTEXTO ATUAL*/
    BEGIN
      l_call_stack := dbms_utility.format_call_stack;
      if ( (l_call_stack = '') or (l_call_stack is null) ) then
        l_call_stack := ' ';
      else
        /*Valida o limite do campo*/
        if ( length(l_call_stack) > 1700 ) then
          l_call_stack := substr(l_call_stack, 1, 1700);
        end if;
      end if;
    EXCEPTION
      WHEN OTHERS THEN
        l_call_stack := ' ';
    END;
    
    /*Monta o Log*/
    /*O usuário da aplicação existe somente se existir sessão ativa na r911sec*/
    l_logpen := 'Usuário do banco de dados:' || l_session_user || chr(13) || chr(10);
    l_logpen := l_logpen || 'Usuário do sistema operacional:' || l_os_user || chr(13) || chr(10);
    l_logpen := l_logpen || 'Usuário da aplicação:' || l_app_user || chr(13) || chr(10);
    l_logpen := l_logpen || 'Nome da aplicação ativa:' || l_app_name || chr(13) || chr(10);
    l_logpen := l_logpen || 'Host:' || l_host||chr(13)||chr(10);
    l_logpen := l_logpen || 'Data e hora:' || l_data_atual || chr(13) || chr(10);
    l_logpen := l_logpen || 'Call stack:' || l_call_stack;
  END IF;

  p_logpen := l_logpen;
END;

		ORACLE;22
Æ␀␀/*
 * LINGUAGEM: ORACLE - PL/SQL
 * Procedure responsável por gerar o log de pendências
 * Retorna um log com as seguintes informações: Usuário de banco de dados, do sistema operacional, da aplicação senior,
 * nome da aplicação ativa, Host, Data e hora da ação e Call Stack da pilha atual.
 * Para este log se tornar ativo, o campo R070DAC.GERLPE deve estar setado com 'S'
 */
CREATE OR REPLACE PROCEDURE SP_RETLOGPEN
(
  p_logpen OUT varchar2
)
IS
  l_logpen       varchar2(2047);
  l_os_user      varchar2(20);
  l_app_user     varchar2(30);
  l_app_name     varchar2(30);
  l_session_user varchar2(20);
  l_host         varchar2(60);
  l_call_stack   varchar2(2000);
  l_data_atual   varchar2(20);
  l_gerlpe       CHAR(1);
  l_session_id   NUMBER(14);
BEGIN
  l_logpen := ' ';
  BEGIN
    SELECT GERLPE INTO l_gerlpe FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_gerlpe := 'N';
  END;

  IF (l_gerlpe = 'S') THEN
    l_data_atual := to_char(sysdate, 'dd/mm/yyyy hh24:mi:ss');
    /*BUSCA O USUÁRIO DA SESSÃO*/
    BEGIN
      l_session_user := sys_context('USERENV','SESSION_USER',20);
      if ( (l_session_user = '') or (l_session_user is null) ) then
        l_session_user := ' ';
      end if;
    EXCEPTION
      WHEN OTHERS THEN
        l_session_user := ' ';
    END;

    /*BUSCA O HOST DO CLIENT*/
    BEGIN
      l_host := sys_context('USERENV','HOST',60);
      if ( (l_host = '') or (l_host is null) ) then
        l_host := ' ';
      end if;
    EXCEPTION
      WHEN OTHERS THEN
        l_host := ' ';
    END;

    /*BUSCA O USUÁRIO DO S.O*/
    BEGIN
      l_os_user := sys_context('USERENV','OS_USER',20);
      if ( (l_os_user = '') or (l_os_user is null) ) then
        l_os_user := ' ';
      end if;
    EXCEPTION
      WHEN OTHERS THEN
        l_os_user := ' ';
    END;

    /*BUSCA O NOME DA APLICAÇÃO DONA DA SESSÃO*/
    BEGIN
      l_app_name := sys_context('USERENV','MODULE',30);
      if ( (l_app_name = '') or (l_app_name is null) ) then
        l_app_name := ' ';
      end if;
    EXCEPTION
      WHEN OTHERS THEN
        l_app_name := ' ';
    END;

    /*RETORNA O USUÁRIO DA APLICAÇÃO, CASO EXISTA SESSÃO ATIVA*/
    BEGIN
      SELECT APPUSR INTO l_app_user
        FROM R911SEC
       WHERE NUMSEC = sys_context('USERENV','SESSIONID');
    EXCEPTION
      WHEN OTHERS THEN
        l_app_user := ' ';
    END;
    /*Valida o campo*/
    if ( (l_app_user = '') or (l_app_user is null) ) then
      l_app_user := ' ';
    end if;

    /*RETORNA A CALL STACK DO CONTEXTO ATUAL*/
    BEGIN
      l_call_stack := dbms_utility.format_call_stack;
      if ( (l_call_stack = '') or (l_call_stack is null) ) then
        l_call_stack := ' ';
      else
        /*Valida o limite do campo*/
        if ( length(l_call_stack) > 1700 ) then
          l_call_stack := substr(l_call_stack, 1, 1700);
        end if;
      end if;
    EXCEPTION
      WHEN OTHERS THEN
        l_call_stack := ' ';
    END;
    
    /*Monta o Log*/
    /*O usuário da aplicação existe somente se existir sessão ativa na r911sec*/
    l_logpen := 'Usuário do banco de dados:' || l_session_user || chr(13) || chr(10);
    l_logpen := l_logpen || 'Usuário do sistema operacional:' || l_os_user || chr(13) || chr(10);
    l_logpen := l_logpen || 'Usuário da aplicação:' || l_app_user || chr(13) || chr(10);
    l_logpen := l_logpen || 'Nome da aplicação ativa:' || l_app_name || chr(13) || chr(10);
    l_logpen := l_logpen || 'Host:' || l_host||chr(13)||chr(10);
    l_logpen := l_logpen || 'Data e hora:' || l_data_atual || chr(13) || chr(10);
    l_logpen := l_logpen || 'Call stack:' || l_call_stack;
  END IF;

  p_logpen := l_logpen;
END;

	MSSQL;21
^␀␀/*
 * LINGUAGEM: SQL SERVER - TRANSACT SQL
 * Procedure responsável por gerar o log de pendências
 * Retorna um log com as seguintes informações: Usuário de banco de dados, do sistema operacional, da aplicação senior,
 * nome da aplicação ativa, Host e Data e hora da ação.
 * Para este log se tornar ativo, o campo R070DAC.GERLPE deve estar setado com 'S'
 */
CREATE  PROCEDURE SP_RETLOGPEN(@p_logpen VARCHAR(416) OUTPUT) AS
BEGIN
DECLARE @ChkError       INTEGER
DECLARE @SE_EXC1        INTEGER
DECLARE @l_logpen       VARCHAR(416);
DECLARE @l_session_user VARCHAR(30);
DECLARE @l_os_user      VARCHAR(20);
DECLARE @l_app_user     VARCHAR(30);
DECLARE @l_app_name     VARCHAR(62);
DECLARE @l_host         VARCHAR(30);
DECLARE @l_data_atual   VARCHAR(20);
DECLARE @l_gerlpe       CHAR(1);

  SELECT @ChkError = 0
  SELECT @l_logpen = ' '

  SELECT @l_gerlpe = R070DAC.GERLPE
    FROM R070DAC R070DAC
  SELECT @ChkError = CASE @@RowCount WHEN 1 THEN 0 ELSE 1 END
  /*WHEN OTHERS*/
  IF (@ChkError > 0)
  BEGIN
    SELECT @l_gerlpe = 'N'
  END
  SELECT @ChkError = 0

  IF (@l_gerlpe = 'S')
  BEGIN
    SELECT @l_data_atual = CONVERT(VARCHAR(20), GETDATE(), 113)
    /*BUSCA O USUÁRIO DA SESSÃO*/
    SELECT @l_session_user = SESSION_USER
    IF ( (@l_session_user IS NULL) OR (@l_session_user = '') )
    BEGIN
      SELECT @l_session_user = ' '
    END
    /*BUSCA O HOST DO CLIENT*/
    SELECT @l_host = HOST_NAME()
    IF ( (@l_host IS NULL) OR (@l_host = '') )
    BEGIN
      SELECT @l_host = ' '
    END
    /*BUSCA O NOME DA APLICAÇÃO DONA DA SESSÃO*/
    SELECT @l_app_name = APP_NAME()
    IF ( (@l_app_name IS NULL) OR (@l_app_name = '') )
    BEGIN
      SELECT @l_app_name = ' '
    END
    /*BUSCA O USUÁRIO DA APLICAÇÃO E O USUÁRIO DO WINDOWS(CASO EXISTA SESSÃO ATIVA NA R911SEC)*/
    SELECT @l_os_user = USRNAM, @l_app_user = APPUSR
     FROM R911SEC
    WHERE NUMSEC = @@SPID
    SELECT @ChkError = CASE @@RowCount WHEN 1 THEN 0 ELSE 1 END
    /*WHEN OTHERS*/
    IF (@ChkError > 0)
    BEGIN
      SELECT @l_os_user = ' '
      SELECT @l_app_user = ' '
    END
    SELECT @ChkError = 0
    /*Valida os campos*/
    IF ( (@l_os_user IS NULL) OR (@l_os_user = '') )
    BEGIN
      SELECT @l_os_user = ' '
    END
    IF ( (@l_app_user IS NULL) OR (@l_app_user = '') )
    BEGIN
      SELECT @l_app_user = ' '
    END

    /*Monta o Log*/
    /*Para Sql Server o usuário da aplicação e do sistema operacional irão existir somente se existir sessão ativa na r911sec*/
    SELECT @l_logpen = 'Usuário do banco de dados:' + @l_session_user + char(13) + char(10)
    SELECT @l_logpen = @l_logpen + 'Usuário do sistema operacional:' + @l_os_user + char(13) + char(10)
    SELECT @l_logpen = @l_logpen + 'Usuário da aplicação:' + @l_app_user + char(13) + char(10)
    SELECT @l_logpen = @l_logpen + 'Nome da aplicação ativa:' + @l_app_name + char(13) + char(10)
    SELECT @l_logpen = @l_logpen + 'Host:' + @l_host + char(13) + char(10)
    SELECT @l_logpen = @l_logpen + 'Data e hora:' + @l_data_atual
  END

  SELECT @p_logpen = @l_logpen

  RETURN @ChkError
END

