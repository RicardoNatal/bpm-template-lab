DECLARE
    l_idtpes VARCHAR(23);
    l_deve_enviar NUMBER(1);
    l_tem_dsp_fac NUMBER(1);
BEGIN
    SP_RETIDTPES(NULL, 4, NULL, :NEW.TIPDOC, :NEW.NUMDOC, NULL, NULL, l_idtpes OUT);

    SP_USARFA_RES(:NEW.TIPDOC, :NEW.NUMDOC, l_deve_enviar OUT);
    IF (l_deve_enviar = 1) THEN
      SP_CHECKDSP_PEND82(l_tem_dsp_fac OUT);
      IF (l_tem_dsp_fac = 1) THEN
        SP_PEND82(l_idtpes, 2);
      END IF;
    END IF;
END␀ÓÚ␀␀		SENIOR;0Ş␀␀

