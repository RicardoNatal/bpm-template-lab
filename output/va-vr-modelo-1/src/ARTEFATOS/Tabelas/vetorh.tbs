^␀␀create or replace PROCEDURE SP_STRTOINT(p_valstr varchar, p_valNumber IN OUT numeric)
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN
  begin
    if (length(p_valstr) > 11) then
      p_valNumber := p_valStr::bigint;
    else
      p_valNumber := p_valStr::integer;
    end if;
  exception
	when OTHERS then
	  p_valNumber := 0;
  end;
end;
$BODY$;␀ïø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
