(R016HIE.DATFIM >= R081EFE.CMPQUA) AND
(R016HIE.NUMLOC = R081EFE.NUMLOC))␀ÿX␀;#Ì␀	␀␀␀␀␀␀␀␀÷;ò␀␀÷;{␀Æÿ␀␀ÿ␀É␀␀Ì␀␀␀␀␀␀␀␀␀ÿÿÿÿ␀␀Æÿ␀␀ÿ␀␀N SELECT 
     codrqu, 
     count(*) qtdefe 
FROM r126cpe 
GROUP BY codrqu␀␀ÿa␀s␀Š␀␀␀␀␀␀␀␀␀ay␀␀n␀␀Æÿ␀␀ÿ␀/#A␀␀␀␀␀␀␀␀ã•␀␀¢Æ␀␀¢Æ␀␀C␀␀ÿ␀␀ÿ␀ó¥␀␀´␀	␀␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀W␀Š␀	␀␀␀␀␀␀␀␀›␀t␀Ü␀n␀Æÿ␀␀ÿ␀ê¥␀␀Ì␀	␀␀␀␀␀␀␀␀õ?0.0.w␀Æÿ␀␀ÿ␀$␀±␀	␀␀␀␀␀␀␀␀>´␀,␀q␀Æÿ␀␀ÿ␀K#·␀	␀␀␀␀␀␀␀␀I=K␀ÅAs␀Æÿ␀␀ÿ␀NCÑ␀␀␀␀␀␀␀␀␀ÿä”␀␀jqC␀␀êÿ␀␀ÿ␀eCÑ␀	␀␀␀␀␀␀␀␀“MÙERMqC␀êÿ␀␀ÿ␀#É␀␀¯␀␀␀␀␀␀␀␀␀Ë␀␀>Ë␀␀°Ë␀␀)␀␀Æÿ␀␀ÿ␀£␀¯␀␀␀␀␀␀␀␀␀Q$␀¦␀W$␀_)␀␀Æÿ␀␀ÿ␀¤␀‘␀␀␀␀␀␀␀␀␀Q$␀ª␀X$␀_)␀␀Æÿ␀␀ÿ␀ø¥␀␀␀␀␀␀␀␀␀␀j±␀␀j±␀␀j±␀␀#␀␀ÿ␀␀ÿ␀ë¥␀␀8␀␀␀␀␀␀␀␀³±␀␀²±␀␀²±␀␀?␀␀ÿ␀␀ÿ␀␀ª␀␀ SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PVT.NUMEMP, PVT.TIPCOL, PVT.NUMCAD, 0 TABEVE, PVT.CODLIN CODVAL, 
            PER.INIVTR DATENT, PVT.DATVTR DATVAL, PVT.QTDPAS QTDVAL, PVT.VALPAS VLRVAL, PVT.VALPAS VLRVL2, LVT.NUMITN NUMITN, EVN.NUMCAR NUMCAR
FROM
  R028PVT PVT, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVN EVN, R038EVT EVT
WHERE
  PVT.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PVT.CODLIN = LVT.CODLIN
  AND PVT.STAPVT = 'E'
  AND PVT.DATVTR >= PER.INIVTR
  AND PVT.DATVTR <= PER.FIMVTR
  AND PER.NUMEMP = PVT.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
  AND PVT.NUMEMP = EVT.NUMEMP
  AND PVT.TIPCOL = EVT.TIPCOL
  AND PVT.NUMCAD = EVT.NUMCAD
  AND PVT.DATVTR >= EVT.INIEVT
  AND ((PVT.DATVTR <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND EVN.NUMEMP = EVT.NUMEMP
  AND EVN.TIPCOL = EVT.TIPCOL
  AND EVN.NUMCAD = EVT.NUMCAD
  AND EVN.INIEVT = EVT.INIEVT
  AND EVN.CODLIN = PVT.CODLIN	
UNION

SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PVT.NUMEMP, PVT.TIPCOL, PVT.NUMCAD, 0 TABEVE, PVT.CODLIN CODVAL, 
            PER.INIVTR DATENT, PVT.DATVTR DATVAL, PVT.QTDPAS QTDVAL, PVT.VALPAS VLRVAL, PVT.VALPAS VLRVL2, LVT.NUMITN NUMITN, '' NUMCAR
FROM
  R028PVT PVT, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVT EVT
WHERE
  PVT.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PVT.CODLIN = LVT.CODLIN
  AND PVT.STAPVT = 'E'
  AND PVT.DATVTR >= PER.INIVTR
  AND PVT.DATVTR <= PER.FIMVTR
  AND PER.NUMEMP = PVT.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
  AND PVT.NUMEMP = EVT.NUMEMP
  AND PVT.TIPCOL = EVT.TIPCOL
  AND PVT.NUMCAD = EVT.NUMCAD
  AND PVT.DATVTR >= EVT.INIEVT
  AND ((PVT.DATVTR <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND NOT EXISTS (SELECT 1 FROM R038EVN EVN 	
                   WHERE EVN.NUMEMP = EVT.NUMEMP
                     AND EVN.TIPCOL = EVT.TIPCOL
                     AND EVN.NUMCAD = EVT.NUMCAD
                     AND EVN.INIEVT = EVT.INIEVT
                     AND EVN.CODLIN = PVT.CODLIN)
										 
UNION

SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, 0 TABEVE, PDI.CODLIN CODVAL, 
            PER.INIFVT DATENT, PER.INIVTR DATVAL, SUM(PDI.QTDPAS * -1) QTDVAL, PDI.VALPAS * -1 VLRVAL, PDI.VALPAS VLRVL2, LVT.NUMITN NUMITN, EVN.NUMCAR NUMCAR
FROM 
  R028PDI PDI, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVN EVN, R038EVT EVT
WHERE 
  PDI.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PER.INIFVT <> DAY(1900,12,31)
  AND PER.FIMFVT <> DAY(1900,12,31)
  AND PDI.CODLIN = LVT.CODLIN
  AND PDI.DATFAL >= PER.INIFVT
  AND PDI.DATFAL <= PER.FIMFVT
  AND PER.NUMEMP = PDI.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
  AND PDI.NUMEMP = EVT.NUMEMP
  AND PDI.TIPCOL = EVT.TIPCOL 
  AND PDI.NUMCAD = EVT.NUMCAD	
  AND PDI.DATFAL >= EVT.INIEVT
  AND ((PDI.DATFAL <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND EVN.NUMEMP = EVT.NUMEMP
  AND EVN.TIPCOL = EVT.TIPCOL
  AND EVN.NUMCAD = EVT.NUMCAD
  AND EVN.INIEVT = EVT.INIEVT
  AND EVN.CODLIN = PDI.CODLIN			
  GROUP BY LVT.CODITN, LVT.NUMITN, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, PDI.CODLIN, PER.INIFVT, PER.INIVTR, PDI.VALPAS, EVN.NUMCAR

UNION

SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, 0 TABEVE, PDI.CODLIN CODVAL, 
            PER.INIFVT DATENT, PER.INIVTR DATVAL, SUM(PDI.QTDPAS * -1) QTDVAL, PDI.VALPAS * -1 VLRVAL, PDI.VALPAS VLRVL2, LVT.NUMITN NUMITN, '' NUMCAR
FROM 
  R028PDI PDI, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVT EVT
WHERE 
  PDI.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PER.INIFVT <> DAY(1900,12,31)
  AND PER.FIMFVT <> DAY(1900,12,31)
  AND PDI.CODLIN = LVT.CODLIN
  AND PDI.DATFAL >= PER.INIFVT
  AND PDI.DATFAL <= PER.FIMFVT
  AND PER.NUMEMP = PDI.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
  AND PDI.NUMEMP = EVT.NUMEMP
  AND PDI.TIPCOL = EVT.TIPCOL
  AND PDI.NUMCAD = EVT.NUMCAD
  AND PDI.DATFAL >= EVT.INIEVT
  AND ((PDI.DATFAL <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND NOT EXISTS (SELECT 1 FROM R038EVN EVN 	
                   WHERE EVN.NUMEMP = EVT.NUMEMP
                     AND EVN.TIPCOL = EVT.TIPCOL
                     AND EVN.NUMCAD = EVT.NUMCAD
                     AND EVN.INIEVT = EVT.INIEVT
                     AND EVN.CODLIN = PDI.CODLIN)			
  GROUP BY LVT.CODITN, LVT.NUMITN, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, PDI.CODLIN, PER.INIFVT, PER.INIVTR, PDI.VALPAS

UNION

SELECT 
  2 TIPVAL, TVL.CODPRD, GER.NUMEMP, GER.TIPCOL, GER.NUMCAD, TVL.TABEVE, TVL.CODVAL, 
            GER.DATVAL DATENT, GER.DATVAL DATVAL, GER.QTDVAL, GER.VLRVAL, GER.VLRVAL VLRVL2, '0' NUMITN, '' NUMCAR
FROM 
  R162GER GER, R044TVL TVL, VBS_PERVAL PER, R030EMP EMP, R250TAB TAB
WHERE 
  TVL.CODVAL = GER.CODVAL 
  AND GER.QTDVAL > 0
  AND GER.STAVAL IN ('E', 'F')
  AND GER.DATVAL >= PER.INIAPU
  AND GER.DATVAL <= PER.FIMAPU
  AND PER.NUMEMP = GER.NUMEMP
  AND PER.CODVAL = TVL.CODVAL
  AND PER.NUMEMP = EMP.NUMEMP
  AND TVL.TABEVE = EMP.TABEVE
  AND GER.NUMEMP = EMP.NUMEMP
  AND NOT TVL.CODPRD IS NULL
  AND (TVL.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)

UNION

SELECT 
  2 TIPVAL, TVL.CODPRD, GER.NUMEMP, GER.TIPCOL, GER.NUMCAD, TVL.TABEVE, TVL.CODVAL, 
            GER.DATVAL DATENT, PER.INICMP DATVAL, GER.QTDVAL * -1, GER.VLRVAL * -1, GER.VLRVAL VLRVL2, '0' NUMITN, '' NUMCAR
FROM 
  R162GER GER, R044TVL TVL, VBS_PERVAL PER, R030EMP EMP, R250TAB TAB
WHERE 
  TVL.CODVAL = GER.CODVAL 
  AND GER.QTDVAL > 0
  AND GER.STAVAL = 'F'
  AND GER.DATVAL >= PER.INIFAL
  AND GER.DATVAL <= PER.FIMFAL
  AND PER.NUMEMP = GER.NUMEMP
  AND PER.CODVAL = TVL.CODVAL
  AND PER.NUMEMP = EMP.NUMEMP
  AND TVL.TABEVE = EMP.TABEVE
  AND GER.NUMEMP = EMP.NUMEMP
  AND NOT TVL.CODPRD IS NULL
  AND (TVL.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)VBS_PERVTR
VBS_PERVAL
