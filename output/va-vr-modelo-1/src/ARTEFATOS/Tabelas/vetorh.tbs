DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs - Filiais - Liminares */ 
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 54;     /* Filiais - Liminares */
  l_codtpa := 219;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030LIF_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
        SP_DATSTR(:NEW.CMPLIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPLIM', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODLIM', CONVERT(NUMBER_TO_CHAR, :NEW.CODLIM));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030LIF_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESLIM', :NEW.DESLIM);
        SP_DATSTR(:NEW.CMPTER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPTER', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'APLEMP', :NEW.APLEMP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'APLRAT', :NEW.APLRAT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'APLTER', :NEW.APLTER);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPLIM', CONVERT(NUMBER_TO_CHAR, :NEW.TIPLIM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRO', CONVERT(NUMBER_TO_CHAR, :NEW.CODPRO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EXTDEC', CONVERT(NUMBER_TO_CHAR, :NEW.EXTDEC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSUS', CONVERT(NUMBER_TO_CHAR, :NEW.CODSUS));
      END;
  END IF; 
END␀kÒ␀␀		SENIOR;0«␀␀ 

TRIGGER R030LIF_EU AFTER UPDATE ON R030LIF FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs - Filiais - Liminares */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 54;     /* Filiais - Liminares */
  l_codtpa := 220;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFil <> :NEW.CodFil)
   OR (:OLD.CmpLim <> :NEW.CmpLim)
   OR (:OLD.CodLim <> :NEW.CodLim)
   OR (:OLD.DesLim <> :NEW.DesLim)
   OR (:OLD.CmpTer <> :NEW.CmpTer)
   OR (:OLD.AplEmp <> :NEW.AplEmp)
   OR (:OLD.AplRAT <> :NEW.AplRAT)
   OR (:OLD.AplTer <> :NEW.AplTer)
   OR (:OLD.TipLim <> :NEW.TipLim)
   OR (:OLD.CodPro <> :NEW.CodPro)
   OR (:OLD.ExtDec <> :NEW.ExtDec)
   OR (:OLD.CodSus <> :NEW.CodSus)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030LIF_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        SP_DATSTR(:OLD.CMPLIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPLIM', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODLIM', CONVERT(NUMBER_TO_CHAR, :OLD.CODLIM));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030LIF_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDESLIM', :OLD.DESLIM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDESLIM', :NEW.DESLIM);
        SP_DATSTR(:OLD.CMPTER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCMPTER', l_datTemp);
        SP_DATSTR(:NEW.CMPTER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCMPTER', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAPLEMP', :OLD.APLEMP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAPLEMP', :NEW.APLEMP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAPLRAT', :OLD.APLRAT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAPLRAT', :NEW.APLRAT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAPLTER', :OLD.APLTER);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAPLTER', :NEW.APLTER);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPLIM', CONVERT(NUMBER_TO_CHAR, :OLD.TIPLIM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPLIM', CONVERT(NUMBER_TO_CHAR, :NEW.TIPLIM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPRO', CONVERT(NUMBER_TO_CHAR, :OLD.CODPRO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPRO', CONVERT(NUMBER_TO_CHAR, :NEW.CODPRO));        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDEXTDEC', CONVERT(NUMBER_TO_CHAR, :OLD.EXTDEC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWEXTDEC', CONVERT(NUMBER_TO_CHAR, :NEW.EXTDEC));        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODSUS', CONVERT(NUMBER_TO_CHAR, :OLD.CODSUS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODSUS', CONVERT(NUMBER_TO_CHAR, :NEW.CODSUS));
      END;
    END IF; 
  END IF; 
END␀iÒ␀␀		SENIOR;0”	␀␀ 

TRIGGER R030LIF_ED AFTER DELETE ON R030LIF FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs - Filiais - Liminares */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 54;     /* Filiais - Liminares */
  l_codtpa := 219;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030LIF_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        SP_DATSTR(:OLD.CMPLIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPLIM', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODLIM', CONVERT(NUMBER_TO_CHAR, :OLD.CODLIM));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030LIF_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESLIM', :OLD.DESLIM);
        SP_DATSTR(:OLD.CMPTER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPTER', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'APLEMP', :OLD.APLEMP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'APLRAT', :OLD.APLRAT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'APLTER', :OLD.APLTER);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPLIM', CONVERT(NUMBER_TO_CHAR, :OLD.TIPLIM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRO', CONVERT(NUMBER_TO_CHAR, :OLD.CODPRO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EXTDEC', CONVERT(NUMBER_TO_CHAR, :OLD.EXTDEC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSUS', CONVERT(NUMBER_TO_CHAR, :OLD.CODSUS));
      END;
  END IF; 
END␀␀␀n␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀lÒ␀␀…¬␀␀´␀	Ôï!␀␀␀␀␀‘<XbXbr‡␀Æÿ␀␀Ò␀␀␀a+Ñ␀	Ôï!␀␀␀␀␀20Ó/Ó/œ␀␀␀êÿ␀␀mÒ␀␀␀Ş,­␀	Ôï!␀␀␀␀␀H=H=H=p␀Æÿ␀␀nÒ␀␀␀ÓTUÔï!␀␀␀␀␀ÅWÅWÅWV␀␀ÿ␀␀ÿ␀…+Ñ␀Ôï!␀␀␀␀␀000œ␀␀␀êÿ␀␀ÿ␀È=Ôï!␀␀␀␀␀áÏ×c␀␀␀ÿ␀␀ÿSÌ=Ôï!␀␀␀␀␀ãĞÙc␀␀␀ÿ␀␀ÿSÍ=Ôï!␀␀␀␀␀âÆØc␀␀␀ÿ␀␀ÿS²␀EÔï!␀␀␀␀␀¾␀t␀t␀n␀Æÿ␀␀ÿ1D-Ì␀Ôï!␀␀␀␀␀-AvÆ␀␀vÆ␀␀l␀Æÿ␀␀1#␀¤-␀ ␀␀␀␀␀␀<<<)␀␀	Æÿ␀␀ˆÒ␀␀␀Ÿj ␀␀␀␀␀␀jšj›jn␀Æÿ␀␀ÿ␀ ␀␀␀␀␀␀ñ0˜/ñ0n␀Æÿ␀␀ÿ1␀␀␀0;1;2␀␀<c␀␀␀␀␀␀␀␀␀␀␀␀␀␀oÒ␀␀…¬␀␀´␀	Ôï1␀␀␀␀␀cXbXbr␀Æÿ␀␀Ò␀␀␀1›␀␀Ò␀Ôï1␀␀␀␀␀C›␀␀A›␀␀A›␀␀ÿ␀ÿÿ␀␀ÿ␀␀␀␀0␀␀C›␀␀␀␀pÒ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀÷,´␀	␀␀␀␀␀␀␀Ş@zœ␀␀zœ␀␀r␀Æÿ␀␀qÒ␀␀␀İT€␀␀␀␀␀␀␀␀Y°V°Vw␀␀ÿ␀␀ÿ␀EÑ␀␀␀␀␀␀␀␀DKZ”␀␀áÀ␀␀qC␀êÿ␀␀ÿ␀µEÑ␀␀␀␀␀␀␀␀™K6␀6␀qC␀êÿ␀␀ÿ␀0Ê␀␀±␀␀␀␀␀␀␀␀IÌ␀␀‹É␀␀áË␀␀q␀␀Æÿ␀␀ÿ␀š`´␀␀␀␀␀␀␀␀_±␀␀"­␀␀#­␀␀r␀␀Æÿ␀␀ÿ␀£DÑ␀␀␀␀␀␀␀␀­J\F\FqC␀␀êÿ␀␀ÿ␀q_Ñ␀␀␀␀␀␀␀␀0K»G¬”␀␀qC␀␀êÿ␀␀ÿ␀“{·␀␀␀␀␀␀␀␀{xxì*␀␀␀Æÿ␀␀ÿ␀w_Ñ␀␀␀␀␀␀␀␀”KÓHO␀qC␀␀êÿ␀␀ÿ␀–{·␀␀␀␀␀␀␀␀#{ãxãxì*␀␀␀Æÿ␀␀ÿ␀eš␀␀␀␀␀␀␀␀␀¼š␀␀£š␀␀£š␀␀␀␀␀ÿ␀␀ÿ␀p_Ñ␀␀␀␀␀␀␀␀K³G”␀␀qC␀␀êÿ␀␀ÿ␀’{·␀␀␀␀␀␀␀␀{‹x‹xì*␀␀␀Æÿ␀␀ÿ␀v_Ñ␀␀␀␀␀␀␀␀KĞHH␀qC␀␀êÿ␀␀ÿ␀•{·␀␀␀␀␀␀␀␀!{âxâxì*␀␀␀Æÿ␀␀ÿ␀]š␀␀o␀␀␀␀␀␀␀¶š␀␀‘š␀␀‘š␀␀i␀␀ÿ␀␀ÿ␀v³␀␀␀␀␀␀␀␀␀¿´␀␀¯´␀␀¯´␀␀?␀␀␀ÿ␀␀ÿ␀pEÑ␀␀␀␀␀␀␀␀ÀIEHÁNqC␀␀êÿ␀␀ÿ␀Ëw·␀␀␀␀␀␀␀␀$y¯x¯xì*␀␀␀Æÿ␀␀ÿ␀nš␀␀␀␀␀␀␀␀␀¹š␀␀­š␀␀­š␀␀␀␀ÿ␀␀ÿ␀¶³␀␀␀␀␀␀␀␀␀À´␀␀¯´␀␀¯´␀␀?␀␀␀ÿ␀␀ÿ␀Ê␀␀·␀␀␀␀␀␀␀␀Í␀