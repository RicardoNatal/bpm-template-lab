/* INSERT (NEW) */
TRIGGER R026IPE_EI AFTER INSERT ON R026IPE FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Previdência - Faixas IPE*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 42;     /* Previdência - Faixas IPE*/
  l_codtpa := 195;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R026IPE_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        SP_DATSTR(:NEW.PERREF, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERREF', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFAI', CONVERT(NUMBER_TO_CHAR, :NEW.CODFAI));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R026IPE_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TETFAI', CONVERT(NUMBER_TO_CHAR, :NEW.TETFAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERFAI', CONVERT(NUMBER_TO_CHAR, :NEW.PERFAI));
      END;
  END IF; 
END␀Ñ␀␀	SENIOR;0L

