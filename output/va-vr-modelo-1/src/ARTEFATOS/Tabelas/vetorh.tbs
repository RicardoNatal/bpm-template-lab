    END IF;
    
    /* Pendência SAMSenior */
    IF (:NEW.RAZSOC <> :OLD.RAZSOC) THEN
    	SP_INTSTR(:NEW.NUMEMP, '9999', l_numemp_str OUT);
    	SP_INTSTR(:NEW.CODFIL, '999999', l_codfil_str OUT);
    	l_valstr := 'E' || l_numemp_str || l_codfil_str || :OLD.RAZSOC;
    	SP_SAM_PENDENCIES(32, 2, l_valstr);
  	END IF;
  END IF;
END␀;Ò␀␀	SENIOR;0L

TRIGGER R030FIL_SD AFTER DELETE ON R030FIL

BEGIN
RH_250ALT(16);
END␀9Ò␀␀		SENIOR;0?9␀␀

TRIGGER R030FIL_ED AFTER DELETE ON R030FIL FOR EACH ROW

DECLARE
    l_online BOOLEAN;
	l_temAud       BOOLEAN;
	l_codRPA       NUMBER(15);
	l_codSistema   NUMBER(2);
	l_codcpa       NUMBER(4);
	l_codtpa       NUMBER(4);
	l_datTemp      VARCHAR(10);
BEGIN
  SP_VerOnLine(l_online OUT);

  IF (l_online = TRUE) THEN
    R030FIL_ATUCON(3, :OLD.NUMEMP, :OLD.CODFIL, :OLD.TIPINS, :OLD.NUMCGC, :OLD.INSCEI, :OLD.RAZSOC, :OLD.TIPINS, :OLD.NUMCGC, NULL);
  END IF;
  
  
  /* Geração de logs Filial - Cadastro*/
  l_codSistema := 1;  /* Código do sistema vetorh.*/
  l_codcpa := 30;     /* R030FIL - CADASTRO FILIAIS */
  l_codtpa := 170;    /* Incluir/Excluir   */
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);  
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R030FIL_ED', 'FR030FIL'); 
     
     /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
    BEGIN
	    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));	
	EXCEPTION
	    WHEN OTHERS THEN RAISERROR 103 'R030FIL_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	END;
	 
	BEGIN	
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RAZSOC', :OLD.RAZSOC);
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMFIL', :OLD.NOMFIL);
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ATVFIL', :OLD.ATVFIL);
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CPLFIL', :OLD.CPLFIL);
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPLGR', :OLD.TIPLGR);
