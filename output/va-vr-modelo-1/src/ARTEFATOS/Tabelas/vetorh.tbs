TRIGGER R110CBH_AU
AFTER UPDATE ON R110CBH
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  IF (
  :OLD.CODATE <>:NEW.CODATE OR
  :OLD.ATEPOS <>:NEW.ATEPOS OR
  :OLD.INDREA <>:NEW.INDREA OR
  :OLD.OBSPRO <>:NEW.OBSPRO OR
  :OLD.OBSREA <>:NEW.OBSREA OR
  :OLD.CODCBH <>:NEW.CODCBH
  ) THEN
    l_codSistema:= 1;
    l_codcpa:= 139;  /* Código da categoria de auditoria - Atendimentos - Procedimentos CBHPM*/
    l_codtpa:= 410;  /* Código do tipo de auditoria - Alteração*/

    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110CBH_AU', '');

      /* Insere os campos chave na tabela de auditoria R995PRC*/
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:OLD.CODFIC));
        SP_DATSTR(:OLD.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR,:OLD.HORATE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCBH', CONVERT(NUMBER_TO_CHAR,:OLD.CODCBH));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110CBH_AU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      /* Insere os valores dos campos na tabela de auditoria R995PRT*/
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODATE', CONVERT(NUMBER_TO_CHAR,:OLD.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODATE', CONVERT(NUMBER_TO_CHAR,:NEW.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDATEPOS', CONVERT(NUMBER_TO_CHAR,:OLD.ATEPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWATEPOS', CONVERT(NUMBER_TO_CHAR,:NEW.ATEPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINDREA',:OLD.INDREA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINDREA',:NEW.INDREA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSPRO',:OLD.OBSPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSPRO',:NEW.OBSPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSREA',:OLD.OBSREA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSREA',:NEW.OBSREA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCBH',CONVERT(NUMBER_TO_CHAR,:OLD.CODCBH));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCBH',CONVERT(NUMBER_TO_CHAR,:NEW.CODCBH));
      END;
    END IF;
  END IF;
