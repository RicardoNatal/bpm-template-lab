                  UPDATE R070CON SET DATVAL = p_datval WHERE NUMFIS = l_numpro;
              EXCEPTION
                  WHEN OTHERS THEN
                      SP_INTSTR(l_numpro, '999999999999', l_numcra OUT);
                      l_strerr := 'SP_UPDFIS: Erro ao atribuir a data de validade '
                                               ||p_datval 
                                               ||' para o crachá de tecnologia 2 - Proximidade e número físico '
                                               ||l_numcra
                                               ||'.';
                      RAISERROR 103 l_strerr;
              END;
          END IF;
          /*Atualiza o Crachá Smart se exisir*/
          IF l_numsma <> 0 THEN
              BEGIN
                  UPDATE R070CON SET DATVAL = p_datval WHERE NUMFIS = l_numsma;
              EXCEPTION
                  WHEN OTHERS THEN
                      SP_INTSTR(l_numsma, '999999999999', l_numcra OUT);
                      l_strerr := 'SP_UPDFIS: Erro ao atribuir a data de validade '
                                               ||p_datval 
                                               ||' para o crachá de tecnologia 3 - Smartcard e número físico '
                                               ||l_numcra
                                               ||'.';
                      RAISERROR 103 l_strerr;
              END;
          END IF;
      END IF;
  END IF;
END		SENIOR;24SP_MAPFIS
