   OR (:OLD.EmiPsp <> :NEW.EmiPsp)
   OR (:OLD.EstPsp <> :NEW.EstPsp)
   OR (:OLD.DemPsp <> :NEW.DemPsp)
   OR (:OLD.DvaPsp <> :NEW.DvaPsp)
   OR (:OLD.PaiPsp <> :NEW.PaiPsp)
   OR (:OLD.NumPor <> :NEW.NumPor)
   OR (:OLD.DatPor <> :NEW.DatPor)
   OR (:OLD.NumRic <> :NEW.NumRic)
   OR (:OLD.EstRic <> :NEW.EstRic)
   OR (:OLD.EmiRic <> :NEW.EmiRic)
   OR (:OLD.CidRic <> :NEW.CidRic)
   OR (:OLD.DexRic <> :NEW.DexRic)
   OR (:OLD.SeqReg <> :NEW.SeqReg)
   OR (:OLD.DatExp <> :NEW.DatExp)
   OR (:OLD.OrgCnh <> :NEW.OrgCnh)
   OR (:OLD.AltSen <> :NEW.AltSen)
   OR (:OLD.EstCnh <> :NEW.EstCnh)
   OR (:OLD.PriCnh <> :NEW.PriCnh)
   OR (:OLD.TerCon <> :NEW.TerCon)
   OR (:OLD.RegMte <> :NEW.RegMte)
   OR (:OLD.NomSoc <> :NEW.NomSoc)
   OR (:OLD.ClaAss <> :NEW.ClaAss)
   OR (:OLD.ObjDet <> :NEW.ObjDet)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034CPL_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034CPL_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      BEGIN
        SP_AUDI_34CPL_NUMB(l_codrpa, 'OLDFICREG', :OLD.FICREG, 'NEWFICREG', :NEW.FICREG);
