PROCEDURE R073HSA_ATUCON(P_NUMMAT VARCHAR2(15),P_CODSTA NUMBER(2))
 IS

  l_situa      CHAR(1);
  l_bloace     CHAR(1);
  l_cratit     NUMBER(12);
  l_crapro     NUMBER(12);
  l_crastr     CHAR(12);
  l_strerr     VARCHAR2(255);
  l_pesBlo     NUMBER(1);
  l_desBlo     VARCHAR2(30);
  l_sitcra     NUMBER;
BEGIN
    l_situa  := '0';
    l_bloace := 'S';
    l_pesBlo := 0;
    l_desBlo := '';

    /* verifica o crachá do aluno*/
    SP_RetCra (2,0,6,0,0, p_nummat,0,'',l_crapro OUT);
    IF  l_crapro = 0 THEN
        SP_RetCra (1,0,6,0,0,p_nummat,0,'',l_cratit OUT);
    ELSE
        l_cratit := l_crapro;
    END IF;
    SP_INTSTR(l_cratit,'999999999999',l_crastr OUT);

    /* busca bloqueio de acesso no cadastro da situação */
    BEGIN
        SELECT BLOACE, DESSTA INTO l_bloace, l_DesBlo FROM R073STA WHERE CODSTA = p_codsta;
    EXCEPTION
        WHEN TOO_MANY_ROWS THEN l_strerr := 'R073HSA: Erro em R073STA - TOO MANY ROWS. Situação = '|| CONVERT(NUMBER_TO_CHAR, p_codsta);
                                RAISERROR 103 l_strerr;
        WHEN NO_DATA_FOUND THEN l_bloace := 'S'; l_DesBlo := '';
        WHEN OTHERS THEN l_strerr := 'R073HSA: Erro no SELECT em R073STA. Situação = '|| CONVERT(NUMBER_TO_CHAR, p_codsta);
                         RAISERROR 103 l_strerr;
    END;

    IF  (l_bloace = 'S') THEN
        l_situa := '1';
        l_pesBlo:= 1;
    ELSE
        l_situa := '0';
        l_pesBlo:= 0;
        l_DesBlo := '';
    END IF;

    SP_STRTOINT(l_situa , l_sitcra OUT);

    BEGIN
         UPDATE R070CON SET SITCRA = l_sitcra, PESBLO = l_pesBlo, DESBLO = l_desblo WHERE NUMCRA = l_cratit;
    EXCEPTION
         WHEN OTHERS THEN RAISERROR 103 'R073HSA_AtuCon: Erro Na Atualização da tabela R070CON.';
    END;
    AtuSitCra(l_situa,l_crastr);
END		SENIOR;20!SP_RETCRA
SP_INTSTR
AtuSitCra
