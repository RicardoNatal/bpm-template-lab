DECLARE
  l_codcmd      NUMBER(2);
  l_datcol      CHAR(8);
  l_horcol      CHAR(5);
  l_seqcol      CHAR(9);
  l_valstr      VARCHAR2(22);
BEGIN
  SP_DATSTR(:NEW.DATCOL,'DDMMYYYY',l_datcol OUT);
  SP_INTSTR(:NEW.HORCOL,'99999',l_horcol OUT);
  SP_INTSTR(:NEW.SEQCOL,'999999999',l_seqcol OUT);
  l_valstr := l_datcol || l_horcol || l_seqcol;
  
  /*0 - Inativo, 1 - Ativo */
  IF (:NEW.TIPALM = 0 OR :NEW.TIPALM = 1) THEN  
  	l_codcmd := 18;
  ELSE
    l_codcmd := 19;
  END IF;
  
  SP_SAM_PENDENCIES(l_codcmd, 1, l_valstr);
