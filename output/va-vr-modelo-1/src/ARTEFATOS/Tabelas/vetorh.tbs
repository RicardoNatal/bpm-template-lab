íPROCEDURE R034PLA_CONTPLANTA(P_TIPOPE CHAR(1),P_NUMCRA NUMBER(12),P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_CODPLT NUMBER,P_DATASO DATE,P_DATTSE DATE,P_DATMIN CHAR(6),P_HORMIN CHAR(4),P_BLOPLT CHAR(1))
 IS
BEGIN
    NULL;
END		SENIOR;20(SP_DATSTR
SP_RETCRA
SP_ATUCONTPLANTA
ÿ␀␀PROCEDURE R034PLA_CONTPLANTA(P_TIPOPE CHAR(1),P_NUMCRA NUMBER(12),P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_CODPLT NUMBER,P_DATASO DATE,P_DATTSE DATE,P_DATMIN CHAR(6),P_HORMIN CHAR(4),P_BLOPLT CHAR(1))
 IS

  l_crapro      NUMBER(12);
  l_cratit      NUMBER(12);
  l_cntplt      CHAR(1);
  l_dataso      DATE;
  l_dattse      DATE;
  l_data_ant    DATE;
  l_datmin      CHAR(6);
  l_hormin      CHAR(4);
BEGIN
  /*SOMENTE PARA TBS 20 e 23, verifica R070TSI.CNTPLT*/
  BEGIN
      SELECT CNTPLT INTO l_cntplt FROM R070TSI;
  EXCEPTION
    WHEN OTHERS THEN
      l_cntplt := 'N';
  END;

  IF (l_cntplt = 'S') THEN

      /*SE O REGISTRO DA R034PLA ESTIVER PARA BLOQUEAR NO SITE(R034PLA.BLOPLT = 'S'), ENTÃO ENVIA 01/01/1970 PARA BLOQUEAR NA TELEMÁTICA*/
      IF (p_bloplt = 'S') THEN
          l_dataso := '31/12/2050,00:00:00';
          l_dattse := '31/12/2050,00:00:00';
          /*01/01/1970 para bloquear a pessoa no Site*/
          l_data_ant := '01/01/1970,00:00:00';
          SP_DATSTR(l_data_ant,'DDMMYY',l_datmin OUT);
          l_hormin := '0000';
      ELSE
          l_dataso := p_dataso;
          l_dattse := p_dattse;
          l_datmin := p_datmin;
          l_hormin := p_hormin;
      END IF;

      IF  (p_numcra = 0) THEN
          /*busca crachá provisório*/
          SP_RetCra (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_crapro OUT);
          IF  l_crapro = 0 THEN
              /*se não encontrou provisório, busca titular*/
              SP_RetCra (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cratit OUT);
          ELSE
              /*
               * SE TEM CRACHÁ PROVISÓRIO O ATUALIZA E,
               * ATUALIZA O CRACHÁ TITULAR TAMBÉM, AMBOS NA CONTPLANTA
               */
              SP_RetCra (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cratit OUT);
              SP_ATUCONTPLANTA(p_tipope, l_cratit, p_codplt, l_dataso, l_dattse, l_datmin, l_hormin);

              l_cratit := l_crapro;
          END IF;
      ELSE
          /*se o crachá foi informado no parâmetro*/
          l_cratit := p_numcra;
      END IF;
      /*
       * ATUALIZA o crachá na CONTPLANTA
       */
      SP_ATUCONTPLANTA(p_tipope, l_cratit, p_codplt, l_dataso, l_dattse, l_datmin, l_hormin);
  END IF;
END		SENIOR;23(SP_DATSTR
SP_RETCRA
SP_ATUCONTPLANTA
ÿ␀␀PROCEDURE R034PLA_CONTPLANTA(P_TIPOPE CHAR(1),P_NUMCRA NUMBER(12),P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_CODPLT NUMBER,P_DATASO DATE,P_DATTSE DATE,P_DATMIN CHAR(6),P_HORMIN CHAR(4),P_BLOPLT CHAR(1))
 IS

  l_crapro      NUMBER(12);
  l_cratit      NUMBER(12);
  l_cntplt      CHAR(1);
  l_dataso      DATE;
  l_dattse      DATE;
  l_data_ant    DATE;
  l_datmin      CHAR(6);
  l_hormin      CHAR(4);
BEGIN
  /*SOMENTE PARA TBS 20 e 23, verifica R070TSI.CNTPLT*/
  BEGIN
      SELECT CNTPLT INTO l_cntplt FROM R070TSI;
  EXCEPTION
    WHEN OTHERS THEN
      l_cntplt := 'N';
  END;

  IF (l_cntplt = 'S') THEN

      /*SE O REGISTRO DA R034PLA ESTIVER PARA BLOQUEAR NO SITE(R034PLA.BLOPLT = 'S'), ENTÃO ENVIA 01/01/1970 PARA BLOQUEAR NA TELEMÁTICA*/
      IF (p_bloplt = 'S') THEN
          l_dataso := '31/12/2050,00:00:00';
          l_dattse := '31/12/2050,00:00:00';
          /*01/01/1970 para bloquear a pessoa no Site*/
          l_data_ant := '01/01/1970,00:00:00';
          SP_DATSTR(l_data_ant,'DDMMYY',l_datmin OUT);
          l_hormin := '0000';
      ELSE
          l_dataso := p_dataso;
          l_dattse := p_dattse;
          l_datmin := p_datmin;
          l_hormin := p_hormin;
      END IF;

      IF  (p_numcra = 0) THEN
          /*busca crachá provisório*/
          SP_RetCra (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_crapro OUT);
          IF  l_crapro = 0 THEN
              /*se não encontrou provisório, busca titular*/
              SP_RetCra (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cratit OUT);
          ELSE
              /*
               * SE TEM CRACHÁ PROVISÓRIO O ATUALIZA E,
               * ATUALIZA O CRACHÁ TITULAR TAMBÉM, AMBOS NA CONTPLANTA
               */
              SP_RetCra (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cratit OUT);
              SP_ATUCONTPLANTA(p_tipope, l_cratit, p_codplt, l_dataso, l_dattse, l_datmin, l_hormin);

              l_cratit := l_crapro;
          END IF;
      ELSE
          /*se o crachá foi informado no parâmetro*/
          l_cratit := p_numcra;
      END IF;
      /*
       * ATUALIZA o crachá na CONTPLANTA
       */
      SP_ATUCONTPLANTA(p_tipope, l_cratit, p_codplt, l_dataso, l_dattse, l_datmin, l_hormin);
  END IF;
END␀HÔ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_RETCRA
AtuSitCra
ô0␀␀PROCEDURE R038AFA_ATUHCH(P_TIPOPE CHAR(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATATU DATE,P_DATAFANEW DATE,P_HORAFANEW NUMBER(5),P_SITAFANEW NUMBER(3),P_DIABLQ NUMBER(1))
 IS

l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_diablq       NUMBER(1);
  l_databloqcra  DATE;
  l_dataux       DATE;
  l_horaux       NUMBER(4);
  l_numpro       NUMBER(12);
  l_numcra       NUMBER(12);
  l_datmar       DATE;
  l_hormar       NUMBER(4);
  l_datpro       DATE;
  l_horpro       NUMBER(4);
  l_maidat       DATE;
  l_maihor       NUMBER(4);
  l_crames       NUMBER(12);
  l_craproaux    NUMBER(12);
  l_cramesaux    NUMBER(12);
  l_StaAtu       NUMBER(1);
  l_StaAcc       NUMBER(1);
  l_UsaCpd       CHAR(1);
BEGIN
  l_data_zero := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_hora_atual:= HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_datpro := l_data_zero;
  l_horpro := 0;
  l_datmar := l_data_zero;
  l_hormar := 0;
  l_MaiDat := l_data_zero;
  l_MaiHor := 0;
  l_crames := 0;

  /* excluir uma demissão abre o histórico de crachá */
  /*Obtem o Crachá Titular, se não existir obtem o Provísório */
  SP_RetCra (1,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
  IF   l_cracha = 0 THEN
       SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
  END IF;
  SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_crapro OUT);

  /*Busca o crachá mestre aberto*/
  BEGIN
  	  SELECT NUMCRA INTO l_crames FROM R070MES WHERE
             NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
      	     (DATFIM > l_data_atual OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
  EXCEPTION
  	  WHEN NO_DATA_FOUND THEN
          l_crames := 0;
  END;

  /*Necessário somar os dias para bloqueio na data de bloqueio*/
  /*Essa data deve ser utilizando tanto para bloquear como para desbloquer o crachá*/
  /*No DESBLOQUEIO há as seguintes limitações nas quais o sistema NÃO reabrirá o crachá:*/
  /* 1 - Se entre o registro do histórico de afastamento e sua exclusão forem alterados: */
  /*                                            1 - Data/Hora Final do histórico do crachá.*/
  /*                                            2 - Alterar a quantidade de dias para bloqueio.*/
  /*2 - Caso houver marcações posteriores a data/hora do histórico de afastamento. */

  /*Dias para bloqueio*/
  IF (p_diablq IS NULL) THEN
      l_diablq := 0;
  ELSE
      l_diablq := p_diablq;
  END IF;

  l_databloqcra := DATETIMEADD(DD, l_diablq, p_datafanew);

  IF  (p_tipope = 'D') THEN
	  l_craproaux := l_crapro;
	  l_cramesaux := l_crames;

      /*Atualiza o Situa na Controle/R070CON*/
      IF (l_cracha > 0 OR l_crames > 0) THEN
         LOOP
              /*Se EXITe crachá provisório, não libera o titular*/
              IF ((l_crapro = 0) OR (l_cracha = l_crapro)) THEN
                  ATUSITCRA('0', l_cracha);
              END IF;
              /*Controle do Looping, onde deve ser efetuado o update no crachá provisório caso o mesmo exista.*/
              IF ((l_craproaux = l_cracha) OR (l_craproaux = 0)) AND (l_cramesaux = 0) THEN
                  EXIT;
              ELSE
                  IF (l_craproaux > 0) THEN
                      l_cracha := l_craproaux;
                      l_craproaux := 0;
                  ELSE
                      IF (l_cramesaux > 0) THEN
                          l_cracha := l_cramesaux;
                          l_cramesaux := 0;
                      END IF;
                 END IF;
              END IF;
         END LOOP;
      END IF;

      BEGIN
      	  /*Crachá do tipo provisório não deve ser reaberto caso seja cancelada a demissão do colaborador.*/
          UPDATE R038HCH SET DATFIM = l_data_zero, HORFIM = 0, STAATU = 1, STAACC = 1 WHERE
                 R038HCH.NUMEMP = p_numemp AND R038HCH.TIPCOL = p_tipcol AND R038HCH.NUMCAD = p_numcad AND R038HCH.DATFIM = l_databloqcra AND
                 R038HCH.TIPCRA <> 2 AND
                 R038HCH.DATINI = (SELECT MAX(B.DATINI) FROM R038HCH B WHERE R038HCH.NUMEMP = B.NUMEMP AND R038HCH.TIPCOL = B.TIPCOL AND R038HCH.NUMCAD = B.NUMCAD AND B.DATFIM = l_databloqcra AND B.TIPCRA <> 2) AND
                 R038HCH.HORINI = (SELECT MAX(C.HORINI) FROM R038HCH C WHERE R038HCH.NUMEMP = C.NUMEMP AND R038HCH.TIPCOL = C.TIPCOL AND R038HCH.NUMCAD = C.NUMCAD AND R038HCH.DATINI = C.DATINI AND C.TIPCRA <> 2);

          UPDATE R070MES SET DATFIM = l_data_zero, HORFIM = 0, STAATU = 1 WHERE
                 R070MES.NUMEMP = p_numemp AND R070MES.TIPCOL = p_tipcol AND R070MES.NUMCAD = p_numcad AND R070MES.DATFIM = l_databloqcra AND
                 R070MES.DATINI = (SELECT MAX(B.DATINI) FROM R070MES B WHERE R070MES.NUMEMP = B.NUMEMP AND R070MES.TIPCOL = B.TIPCOL AND R070MES.NUMCAD = B.NUMCAD AND B.DATFIM = l_databloqcra) AND
                 R070MES.HORINI = (SELECT MAX(C.HORINI) FROM R070MES C WHERE R070MES.NUMEMP = C.NUMEMP AND R070MES.TIPCOL = C.TIPCOL AND R070MES.NUMCAD = C.NUMCAD AND R070MES.DATINI = C.DATINI );

      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;
  ELSE
      BEGIN
          l_craproaux := l_crapro;
	      l_cramesaux := l_crames;

          /*Atualiza o Situa na Controle/R070CON*/
          IF (((l_cracha > 0) OR (l_crames > 0)) AND ((l_databloqcra < l_data_atual) OR
             (l_databloqcra = l_data_atual AND p_horafanew <= l_hora_atual))) THEN
              LOOP
                  IF (l_cracha > 0) THEN
                  	  ATUSITCRA('1', l_cracha);
                  END IF;

                  /*Controle do Looping, onde deve ser efetuado o update no crachá provisório caso o mesmo exista.*/
                  IF ((l_craproaux = l_cracha) OR (l_craproaux = 0)) AND (l_cramesaux = 0) THEN
                      EXIT;
                  ELSE
                  	  IF (l_craproaux > 0) THEN
                          l_cracha := l_craproaux;
                          l_craproaux := 0;
                      ELSE
                          IF (l_cramesaux > 0) THEN
                              l_cracha := l_cramesaux;
                              l_cramesaux := 0;
                          END IF;
                      END IF;
                  END IF;
             END LOOP;
          END IF;

          SP_RetCra (1,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_numcra OUT);
          SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_numpro OUT);

          /*Verifica se tem marcação com data maior do que o histórico de demissão*/
          IF (l_numpro <> 0) THEN
              SELECT MAX(DATACC) DATACC
              INTO l_dataux
              FROM R070ACC
              WHERE NUMCRA = l_numpro;
              IF ((NOT(l_dataux IS NULL)) AND (l_databloqcra <= l_dataux)) THEN
                  SELECT MAX(HORACC) HORACC
                  INTO l_horaux
                  FROM R070ACC
                  WHERE NUMCRA = l_numpro AND DATACC = l_dataux;

                  IF ((l_databloqcra < l_dataux) OR ((l_databloqcra = l_dataux) AND (p_horafanew <= l_horaux))) THEN
                      l_datpro := l_dataux;
                      l_horpro := l_horaux;
                  END IF;
              END IF;
          END IF;

          /*Busca a máxima marcação do crachá titular*/
          IF (l_numcra <> 0) THEN
              SELECT MAX(DATACC) DATACC
              INTO l_dataux
              FROM R070ACC
              WHERE NUMCRA = l_numcra;
              IF ((NOT(l_dataux IS NULL)) AND (l_databloqcra <= l_dataux)) THEN
                  SELECT MAX(HORACC) HORACC
                  INTO l_horaux
                  FROM R070ACC
                  WHERE NUMCRA = l_numcra AND DATACC = l_dataux;

                  IF ((l_databloqcra < l_dataux) OR ((l_databloqcra = l_dataux) AND (p_horafanew <= l_horaux))) THEN
                      l_datmar := l_dataux;
                      l_hormar := l_horaux;
                  END IF;
              END IF;
          END IF;

          IF (l_crames <> 0) THEN
          	  /*Busca a máxima marcação do crachá mestre*/
              SELECT MAX(DATACC) DATACC
              INTO l_dataux
              FROM R070ACC
              WHERE NUMCRA = l_crames;
              IF ((NOT(l_dataux IS NULL)) AND (l_databloqcra <= l_dataux)) THEN
                  SELECT MAX(HORACC) HORACC
                  INTO l_horaux
                  FROM R070ACC
                  WHERE NUMCRA = l_numcra AND DATACC = l_dataux;

                  IF ((l_databloqcra < l_dataux) OR ((l_databloqcra = l_dataux) AND (p_horafanew <= l_horaux))) THEN
                      l_datmar := l_dataux;
                      l_hormar := l_horaux;
                  END IF;
              END IF;
          END IF;

          /*Verifica onde foi a maior marcação provisório ou titular*/
          IF (l_DatPro <> l_DatMar) THEN
            IF (l_DatPro > l_DatMar) THEN
              l_MaiDat := l_DatPro;
              l_MaiHor := l_HorPro;
            ELSE
              l_MaiDat := l_DatMar;
              l_MaiHor := l_HorMar;
            END IF;
          ELSE
            IF ((l_DatPro <> l_data_zero) AND (l_DatMar <> l_data_zero)) THEN
            /*Datas iguais, verifica a maior hora da marcação.*/
              IF (l_HorPro > l_HorMar) THEN
                l_MaiDat := l_DatPro;
                l_MaiHor := l_HorPro;
              ELSE
                l_MaiDat := l_DatMar;
                l_MaiHor := l_HorMar;
              END IF;
            END IF;
          END IF;
          /*Se encontrou alguma marcação maior do que o histórico de demissão, */
          /*utiliza esta data mais 1 minuto para fechar o(s) crachá(s)*/
          IF (l_MaiDat <> l_data_zero) THEN
              /*Se for 23:59, soma 1 dia*/
              IF (l_MaiHor = 1439) THEN
                  l_dataux := DATETIMEADD(DD, 1, l_MaiDat);
                  l_horaux := 0;
              ELSE
                  /*Incrementa 1 minuto no fechamento do crachá*/
                  l_dataux := l_MaiDat;
                  l_horaux := l_MaiHor + 1;
              END IF;
          ELSE
            l_dataux := l_databloqcra;
            l_horaux := p_horafanew;
            IF (l_dataux = p_datatu AND l_horaux = l_hora_atual) THEN
              IF (l_horaux = 0) THEN
                l_dataux := DATETIMEADD(DD, -1, l_dataux);
                l_horaux := 1439;
              ELSE
                l_horaux := l_horaux - 1;
              END IF;
            END IF;
          END IF;

          l_StaAtu := 1;
          l_StaAcc := 1;

          IF ((l_dataux < p_datatu) OR (l_dataux = p_datatu AND l_horaux < l_hora_atual)) THEN
              l_StaAtu := 2;
              l_StaAcc := 2;
          END IF;

          BEGIN
            SELECT USACPD INTO l_UsaCpd FROM R070DAC;
          EXCEPTION
            WHEN OTHERS THEN l_UsaCpd := 'N';
          END;

          IF (l_UsaCpd = 'S') THEN
            BEGIN
              UPDATE R038HCH SET CRAENT = 'S' WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND TIPCRA = 2 /*Provisório*/ AND
                     ((DATINI < p_datatu) OR (DATINI = p_datatu AND HORINI <= l_hora_atual)) AND
                     ((DATFIM = p_datatu AND HORFIM >= l_hora_atual) OR DATFIM > p_datatu OR DATFIM = l_data_zero);
            EXCEPTION
              WHEN OTHERS THEN NULL;
            END;
          END IF;

          UPDATE R038HCH SET DATFIM = l_dataux, HORFIM = l_horaux, STAATU = l_StaAtu, STAACC = l_StaAcc WHERE
                 NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                 ((DATINI < p_datatu) OR (DATINI = p_datatu AND HORINI <= l_hora_atual)) AND
                 ((DATFIM = p_datatu AND HORFIM >= l_hora_atual) OR DATFIM > p_datatu OR DATFIM = l_data_zero);

          UPDATE R070MES SET DATFIM = l_dataux, HORFIM = l_horaux, STAATU = l_StaAtu WHERE
          	     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                 ((DATINI < p_datatu) OR (DATINI = p_datatu AND HORINI <= l_hora_atual)) AND
                 ((DATFIM = p_datatu AND HORFIM >= l_hora_atual) OR DATFIM > p_datatu OR DATFIM = l_data_zero);
      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;
  END IF;
END␀IÔ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_INTSTR
SP_CONCOLPNG
Ó␀␀PROCEDURE R038AFA_ATUPNG(P_TIPOPE CHAR(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATAFA DATE)
 IS

l_incdem  VARCHAR2(1);
  l_codmot  NUMBER(2);
  l_propng  VARCHAR2(1000);
  l_numcid  VARCHAR2(16);
  l_nomfun  VARCHAR2(40);
  l_apefun  VARCHAR2(50);
  l_datnas  DATE;
  l_numcpf  NUMBER(11);
  l_semdoc  BOOLEAN;
  l_tipdoc1 NUMBER(1);
  l_numdoc1 VARCHAR2(20);
  l_tipdoc2 NUMBER(1);
  l_numdoc2 VARCHAR2(20);
  l_tempng  NUMBER(1);
  l_incluir BOOLEAN;
BEGIN
  BEGIN
      SELECT INCDEM,CODMOT INTO l_incdem,l_codmot FROM R090DPN;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN L_INCDEM:='N';
      WHEN OTHERS THEN RAISERROR 103 'Erro no SELECT R090DPN';
  END;

  /* Se estiver assinalado que inclui demitidos no cadastro de PNG */
  IF   l_incdem = 'S' THEN
       IF  p_tipope = 'I' THEN
           /* Busca informações da ficha complementar. */
           BEGIN
               SELECT NUMCID INTO l_numcid FROM R034CPL
               WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
           EXCEPTION
               WHEN NO_DATA_FOUND THEN L_NUMCID:='';
               WHEN OTHERS THEN RAISERROR 103 'R038AFA_ATUPNG - Erro no SELECT R034CPL';
           END;

           /* Busca informações da ficha básica. */
           BEGIN
               SELECT NUMCPF,NOMFUN,APEFUN,DATNAS INTO l_numcpf,l_nomfun,l_apefun,l_datnas
               FROM R034FUN WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
           EXCEPTION
               WHEN NO_DATA_FOUND THEN RAISERROR 103 'R038AFA_ATUPNG - Não Encontrou o Cadastro na R034FUN';
               WHEN OTHERS THEN RAISERROR 103 'R038AFA_ATUPNG - Erro no SELECT R034FUN';
           END;

           IF  l_codmot > 0 THEN
               /* Busca o procedimento padrão para demitidos. */
               BEGIN
                   SELECT PROPNG INTO l_propng FROM R090MPN WHERE CODMOT = L_CODMOT;
               EXCEPTION
                   WHEN NO_DATA_FOUND THEN l_propng:='';
                   WHEN OTHERS THEN RAISERROR 103 'Erro no SELECT R090MPN';
               END;
           END IF;

           /* Verifica os documentos do colaborador. */
           l_semdoc := FALSE;
           IF  (l_numcid = '') OR (l_numcid = ' ') OR (l_numcid IS NULL) THEN
               IF  (l_numcpf = 0) OR (l_numcpf IS NULL) THEN
                   l_semdoc := TRUE;
               ELSE
                   l_tipdoc1 := 2;                   
                   l_numdoc1 := CONVERT(NUMBER_TO_CHAR,l_numcpf);
                   l_tipdoc2 := 0;
                   l_numdoc2 := '';
               END IF;
           ELSE
               l_tipdoc1 := 1;
               l_numdoc1 := l_numcid;
               l_tipdoc2 := 2;
               l_numdoc2 := CONVERT(NUMBER_TO_CHAR,l_numcpf);
           END IF;

           IF  l_semdoc = FALSE THEN
               SP_CONCOLPNG(p_numemp,p_tipcol,p_numcad,l_incluir OUT);
               /* Verifica se colaborador já esta incluso como PNG. */
               BEGIN
                   SELECT COUNT(*) INTO l_tempng FROM R090PNG
                   WHERE (TIPDOC=l_tipdoc1 AND NUMDOC=l_numdoc1) OR (TIPDOC=l_tipdoc2 AND NUMDOC=l_numdoc2);
               EXCEPTION
                   WHEN OTHERS THEN RAISERROR 103 'R038AFA_ATUPNG - Erro no SELECT R090Png';
               END;

               /* Insere no cadastro de PNG */
               IF (l_incluir=TRUE) AND (l_tempng < 1) THEN
                  BEGIN
                      INSERT INTO R090PNG (TIPDOC,NUMDOC,SEGTDO,SEGDOC,NOMPNG,APEPNG,NOMPAI,NOMMAE,
                                           DATNAS,VINPNG,PROPNG,MOTPNG,PERENT,CODMOT,DATCAD,NUMEMP,
                                           TIPCOL,NUMCAD,BLOHOM,PERHOM)
                      VALUES (l_tipdoc1,l_numdoc1,l_tipdoc2,l_numdoc2,l_nomfun,l_apefun,'','',
                                           l_datnas,'0',l_propng,'DEMITIDO','N',l_codmot,p_datafa,p_numemp,
                                           p_tipcol,p_numcad,'S','N');
                  EXCEPTION
                      WHEN OTHERS THEN NULL;
                  END;
               END IF;
           END IF;
       ELSIF  p_tipope = 'E' THEN
           /* ELIMINA O COLABORADOR DO CADASTRO DE NÃO GRATAS */
           BEGIN
              DELETE FROM R090PNG
               WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
           EXCEPTION WHEN OTHERS THEN
              NULL;
           END;
       END IF;
  END IF;
END␀JÔ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0R038AFA_ATUHCH
SP_RETIDTPES
ê␀␀PROCEDURE R038AFA_ATUSIT(P_SITAFANEW NUMBER(3),P_SITAFAOLD NUMBER(3),P_TIPCOL NUMBER(1),P_NUMEMP NUMBER(4),P_NUMCAD NUMBER(9),P_DATAFA DATE,P_HORAFA NUMBER(5),P_CAUDEM NUMBER(2),P_DATTER DATE,P_FIMQUA DATE,P_STAATU NUMBER(1),P_DIABLQ NUMBER(1))
 IS

l_TipSitNew    NUMBER(2);
  l_TipSitOld    NUMBER(2);
  l_data_zero    DATE;
  l_datatu       DATE;
  l_sittra       NUMBER(3);
  l_strerr       VARCHAR2(255);
  l_idtpes       CHAR(23);
  l_horafa       NUMBER(5);
BEGIN
  l_datatu   := CURDATE();
  /* Acha o tipo de situacao da situacao do afastamento */
  SELECT R010SIT.TIPSIT INTO L_TipSitNew
    FROM R010SIT
   WHERE R010SIT.CODSIT = p_sitafanew;

  l_data_zero:='31/12/1900,00:00:00';
  /* BUSCA SITUACAO DE TRABALHANDO */
  BEGIN
    SELECT MIN(CODSIT) INTO l_sittra
      FROM R010SIT
     WHERE R010SIT.TIPSIT = 1;
  EXCEPTION WHEN OTHERS THEN
     RAISERROR 103 'Erro No SELECT do R010SIT';
  END;

  IF   (L_TipSitNew <> 15)
  AND  (L_TipSitNew <> 16)
  AND  (L_TipSitNew <> 17)
  AND  (L_TipSitNew <> 18) THEN

       /* se for atualização de um historico atual atualiza o afastamento, senão seta como trabalhando.*/
       IF   p_staatu = 1 THEN
            IF  (p_sitafaold <> p_sitafanew) THEN

                SELECT R010SIT.TIPSIT INTO L_TipSitOld
                  FROM R010SIT
                 WHERE R010SIT.CODSIT = p_sitafaold;

                /* SE ALTEROU UM HISTORICO QUE ERA DEMISSÃO ENTÃO RE-ABRIR HISTORICO DE CRACHÁS */
                IF   (L_TipSitOld = 7) THEN
                     R038AFA_ATUHCH('D', p_numemp, p_tipcol, p_numcad, l_datatu, p_datafa, p_horafa, p_sitafanew, p_diablq);
                END IF;
            END IF;

            /* SE SITUACAO DO AFASTAMENTO FOR DEMISSÃO ENTÃO FECHAR HISTÓRICO DE CRACHÁS */
            IF  (L_TipSitNew = 7) THEN
                 /* CONSIDERANDO QUE O ULTIMO HISTORICO DO COLABORADOR É AQUELE CUJA DATA FIM É ZERO */
                 /* se a hora for zero, veio da rescisão, utilizar a data/hora  atual para fechar o histórico */
                 IF (p_datafa <= l_datatu) AND (p_horafa = 0) THEN
                     l_horafa := HOUR(CURTIME())*60 + MINUTE(CURTIME());
                 ELSE
                     l_horafa := p_horafa;                     
                 END IF;                                  
                 R038AFA_ATUHCH('I',p_numemp, p_tipcol, p_numcad, l_datatu, p_datafa, l_horafa, p_sitafanew, p_diablq);
                 
                 SP_RETIDTPES(p_numemp, p_tipcol, p_numcad, 0, '', '', '', l_idtpes OUT);
                 
                 /*Desatualiza as pendências para REP Telemática que estão aguardando envio*/
                 BEGIN
                 	UPDATE R070ACR SET STAATU = 2 WHERE IDTPES = l_idtpes AND STAATU = 0 AND TIPLIS = 27;
                 EXCEPTION
                 	WHEN OTHERS THEN
                 		l_strerr := 'R038AFA_ATUSIT - Erro Na Atualização do R070ACR '||
                                    ' numemp = '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                                    ' tipcol = '||CONVERT(NUMBER_TO_CHAR,p_tipcol)||                                    
                                    ' numcad = '||CONVERT(NUMBER_TO_CHAR,p_numcad);
                        RAISERROR 103 l_strerr;
                 END;	

                 BEGIN
                   UPDATE R034FUN
                      SET SITAFA = p_sitafanew,
                          DATAFA = p_datafa,
                          HORAFA = p_horafa,
                          CAUDEM = p_caudem
                    WHERE R034FUN.TIPCOL = p_tipcol AND
                          R034FUN.NUMEMP = p_numemp AND
                          R034FUN.NUMCAD = p_numcad;
                 EXCEPTION
                   WHEN NO_DATA_FOUND THEN
                        l_strerr := 'Erro Na Atualização do R034FUN - NO DATA FOUND'||
                                    ' tipcol = '||CONVERT(NUMBER_TO_CHAR,p_tipcol)||
                                    ' numemp = '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                                    ' numcad = '||CONVERT(NUMBER_TO_CHAR,p_numcad);
                        RAISERROR 103 l_strerr;
                   WHEN OTHERS THEN
                        l_strerr := 'Erro Na Atualização do R034FUN '||
                                    ' sitafa = '||CONVERT(NUMBER_TO_CHAR,p_sitafanew)||
                                    ' datafa = '||CONVERT(NUMBER_TO_CHAR,p_datafa)||
                                    ' horafa = '||CONVERT(NUMBER_TO_CHAR,p_horafa)||
                                    ' caudem = '||CONVERT(NUMBER_TO_CHAR,p_caudem);
                        RAISERROR 103 l_strerr;
                 END;
                 
                 /* Fecha possíveis históricos de permissão alternativa do colaborador */
                 BEGIN
                   UPDATE R070PEC
                      SET DATFIM = p_datafa,
                          HORFIM = p_horafa,
                          STAACC = 2
                    WHERE R070PEC.NUMEMP = p_numemp AND
                          R070PEC.TIPCOL = p_tipcol AND
                          R070PEC.NUMCAD = p_numcad AND
                          (R070PEC.DATFIM = l_data_zero OR
                          	R070PEC.DATFIM > p_datafa OR
                          	(R070PEC.DATFIM = p_datafa 
                          	 AND R070PEC.HORFIM > p_horafa)
                          );
                    EXCEPTION
                 	WHEN OTHERS THEN
                 		l_strerr := 'R038AFA_ATUSIT - Erro Na Atualização do R070PEC '||
                                    ' numemp = '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                                    ' tipcol = '||CONVERT(NUMBER_TO_CHAR,p_tipcol)||                                    
                                    ' numcad = '||CONVERT(NUMBER_TO_CHAR,p_numcad);
                        RAISERROR 103 l_strerr;
                 END;
            ELSE
                 BEGIN
                   UPDATE R034FUN
                      SET SITAFA = p_sitafanew,
                          DATAFA = p_datafa,
                          HORAFA = p_horafa
                    WHERE R034FUN.TIPCOL = p_tipcol AND
                          R034FUN.NUMEMP = p_numemp AND
                          R034FUN.NUMCAD = p_numcad;
                 EXCEPTION
                   WHEN NO_DATA_FOUND THEN
                        l_strerr := 'Erro Na Atualização do R034FUN - NO DATA FOUND'||
                                    ' tipcol = '||CONVERT(NUMBER_TO_CHAR,p_tipcol)||
                                    ' numemp = '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                                    ' numcad = '||CONVERT(NUMBER_TO_CHAR,p_numcad);
                        RAISERROR 103 l_strerr;
                   WHEN OTHERS THEN
                        l_strerr := 'Erro Na Atualização do R034FUN '||
                                    ' sitafa = '||CONVERT(NUMBER_TO_CHAR,p_sitafanew)||
                                    ' datafa = '||CONVERT(NUMBER_TO_CHAR,p_datafa)||
                                    ' horafa = '||CONVERT(NUMBER_TO_CHAR,p_horafa);
                        RAISERROR 103 l_strerr;
                 END;
            END IF;

       ELSE
            UPDATE R034FUN
               SET SITAFA = l_sittra,
                   DATAFA = l_data_zero,
                   HORAFA = 0
             WHERE R034FUN.TIPCOL = p_tipcol AND
                   R034FUN.NUMEMP = p_numemp AND
                   R034FUN.NUMCAD = p_numcad;

       END IF;


  ELSE
       UPDATE R034FUN
          SET SITAFA = l_sittra,
              DATAFA = l_data_zero,
              HORAFA = 0
        WHERE R034FUN.TIPCOL = p_tipcol AND
              R034FUN.NUMEMP = p_numemp AND
              R034FUN.NUMCAD = p_numcad;
  END IF;
END␀MÔ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
5␀␀PROCEDURE R038AFA_COLATI(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_COLATI OUT NUMBER(1))
IS

	l_QtdAfa NUMBER(2);
BEGIN
    l_QtdAfa := 0;
	BEGIN
		SELECT
			COUNT(*) QTD
		INTO
			l_QtdAfa
		FROM
			R038AFA AFA,
			R010SIT SIT
		WHERE AFA.NUMEMP = P_NUMEMP AND AFA.TIPCOL = P_TIPCOL AND AFA.NUMCAD = P_NUMCAD 
		  AND AFA.SITAFA = SIT.CODSIT AND SIT.TIPSIT = 7;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao retornar COUNT(*) da tabela R038AFA.';
	END;
	
    IF (l_QtdAfa > 0) THEN
		P_COLATI := 0;
	ELSE 
		P_COLATI := 1; 
	END IF; 
END␀›Ô␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
*␀␀/*-------------------------------- R038HCC ----------------------------*/
PROCEDURE R038HCC_HFI(P_TIPCOL INTEGER,P_NUMEMP NUMBER(4),P_NUMCAD NUMBER(9),P_DATALT DATE,P_CODCCU VARCHAR2(18))
 IS

l_datccu       DATE;
  l_comando_nulo BOOLEAN;
BEGIN
  BEGIN
    SELECT R034FUN.DATCCU INTO l_datccu
      FROM R034FUN
     WHERE R034FUN.TIPCOL = p_tipcol AND
           R034FUN.NUMEMP = p_numemp AND
           R034FUN.NUMCAD = p_numcad;
  EXCEPTION WHEN OTHERS THEN
    l_comando_nulo:=TRUE;
  END;
  IF   (p_DATALT >= l_datccu)
  OR   (l_datccu IS NULL) THEN
       UPDATE R034FUN
          SET CODCCU = p_codccu,
              DATCCU = p_datalt
        WHERE R034FUN.TIPCOL = p_tipcol AND
              R034FUN.NUMEMP = p_numemp AND
              R034FUN.NUMCAD = p_numcad;
  END IF;
END␀¨Ô␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
