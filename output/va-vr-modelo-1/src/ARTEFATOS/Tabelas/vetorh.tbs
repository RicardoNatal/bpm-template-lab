        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENTEED', :NEW.ENTEED);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CNPRES', CONVERT(NUMBER_TO_CHAR, :NEW.CNPRES));
      END;
  END IF; 
