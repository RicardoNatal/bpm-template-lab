TRIGGER R038HEX_ED AFTER DELETE ON R038HEX FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataInicioS2221 DATE;
	l_Valor VARCHAR2(2000);
	l_temAud BOOLEAN;
    l_codRPA NUMBER(15);
    l_codSistema NUMBER(2);
    l_codcpa NUMBER(4);
    l_codtpa NUMBER(4);
    l_datTemp VARCHAR(10);
BEGIN
	IF (:OLD.EnvEso = 'S') THEN
		l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
		
		SP_DATINI_S2221(:OLD.NumEmp, l_DataInicioS2221 OUT);
		IF (l_DataInicioS2221 > l_DataZero) THEN
			IF (:OLD.DatExm >= l_DataInicioS2221) THEN
				l_Valor := '';
				SP_CONCATENAR_DES('LAYOUT', 'S-2221', l_Valor OUT);
				SP_CONCATENAR_DAT('DATALT', :OLD.DatAlt, l_Valor OUT);
				SP_CONCATENAR_DAT('DATREA', :OLD.DatExm, l_Valor OUT);
				SP_E_SOCIAL('S-3000', 'R038HEX', 'N', 'E', NULL, NULL, :OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, l_Valor, '', 0, NULL, :OLD.DatExm, 0, 'R038HEX_ED');
			END IF;
		END IF;
	END IF;
  l_codSistema:= 1;
  l_codcpa := 147;
  l_codtpa := 425;

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HEX_ED', '');

    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR,:OLD.TIPCOL));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR,:OLD.NUMCAD));
      SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R038HEX_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
      SP_DATSTR(:OLD.DATEXM, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATEXM', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMEXA', :OLD.NUMEXA);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODLAB', CONVERT(NUMBER_TO_CHAR,:OLD.CODLAB));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMCGC', CONVERT(NUMBER_TO_CHAR,:OLD.NUMCGC));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODATE', CONVERT(NUMBER_TO_CHAR,:OLD.CODATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDREGCON', :OLD.REGCON);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDESTCON', :OLD.ESTCON);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDRECEXA', :OLD.RECEXA);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPEXM', CONVERT(NUMBER_TO_CHAR,:OLD.TIPEXM));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOMMED', :OLD.NOMMED);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDIAVAL', CONVERT(NUMBER_TO_CHAR,:OLD.DIAVAL));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENVESO', :OLD.ENVESO);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODESO', :OLD.CODESO);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDRESEXA', :OLD.RESEXA);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSORTEA', CONVERT(NUMBER_TO_CHAR,:OLD.SORTEA));
      SP_DATSTR(:OLD.DATSOR, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATSOR', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCFJINS', :OLD.CFJINS);
    END;
