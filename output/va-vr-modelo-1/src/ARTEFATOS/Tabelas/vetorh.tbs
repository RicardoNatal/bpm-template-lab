  l_Valor := '';

  IF (:OLD.CODACA = 0 OR :OLD.ORIINF <> 2) THEN
    SP_CONCATENAR_NUM('CODPRO', :OLD.CODPRO, l_Valor OUT);
    SP_CONCATENAR_DAT('CMPPAG', :OLD.CMPPAG, l_Valor OUT);
    SP_CONCATENAR_DES('LAYOUT', 'S-2501', l_Valor OUT);
  
    SP_E_SOCIAL('S-3500', 'R346TPT', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0, NULL, :OLD.CMPPAG, 0, 'R346TPT_ED');
