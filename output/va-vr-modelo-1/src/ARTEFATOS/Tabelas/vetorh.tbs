DECLARE
  l_online          BOOLEAN;
  l_codprm          NUMBER(5);
  l_VerPlf          NUMBER(3);
  l_CodPlf          NUMBER(9);
  l_tippes          NUMBER(2);
  l_hora_atual      NUMBER(4);
  l_data_zero       DATE;
  l_data_atual      DATE;
  l_tipdoc          NUMBER(1);
  l_numdoc          VARCHAR2(20);
  l_IDTPES          VARCHAR(23);
  l_data            CHAR(8);
  l_hora            CHAR(4);
  l_chave           VARCHAR2(35);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN

    l_data_zero  := '31/12/1900,00:00:00';
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_data_atual := CURDATE();

    /*Se for um histórico válido*/
    IF (:NEW.STAATU = 1) THEN
        BEGIN
            SELECT A.VERPLF, A.CODPLF INTO l_VerPlf, l_CodPlf
            FROM R097MOP A
            WHERE SEQMOV = (SELECT MAX(C.SEQMOV)
                         FROM R097MOP C
                         WHERE C.PROPAC = A.PROPAC
                         AND C.DATINI = A.DATINI
                         AND C.HORINI = A.HORINI)
               AND A.PROPAC = :NEW.PROPAC
               AND A.DATINI = :NEW.DATINI
               AND A.HORINI = :NEW.HORINI;
        EXCEPTION
            WHEN OTHERS THEN
                l_VerPlf := 0;
                l_CodPlf := 0;
        END;

        BEGIN
            SELECT TIPDOC, NUMDOC INTO l_tipdoc, l_numdoc FROM R097PAC WHERE PROPAC = :NEW.PROPAC;
        EXCEPTION
            WHEN OTHERS THEN l_tipdoc := 0; l_numdoc := ' ';
        END;

        l_tippes := 9;

        /*Atualiza o paciente na r070con/controle*/
        SP_PACCON(l_tippes,:NEW.PROPAC,l_tipdoc,l_numdoc,:NEW.NUMCRA,l_verplf,l_codplf,:NEW.DATINI,:NEW.HORINI,:NEW.DATFIM,:NEW.HORFIM,0,0);
    END IF;
  END IF;

  SP_RETIDTPES(NULL, 9, NULL, NULL, NULL, NULL, :NEW.PROPAC, l_IDTPES OUT);
  SP_DATSTR(:NEW.DATINI,'DDMMYYYY',l_data OUT);
  SP_INTSTR(:NEW.HORINI,'9999',l_hora OUT);
  l_chave := l_IDTPES||l_data||l_hora;
  SP_SAM_PENDENCIES(14, 1, l_chave);
END␀Úİ␀␀		SENIOR;0Î␀␀

