				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDTOLINT)';
				END;
		END IF;
		IF (:OLD.TOLINT <> :NEW.TOLINT AND l_r034EDP.TOLINT <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) THEN /* TOL. P/ CONTROLE DE INTERJORNADA VEM SOMENTE DO POSTO PRINICPAL */
				l_r034DAC.TOLINT := :NEW.TOLINT;
				l_r034EDP.TOLINT := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						l_TolIntSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.TOLINT);
						l_TolIntSTR := LTRIM(l_TolIntSTR);
						l_TolIntSTR := RTRIM(l_TolIntSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTOLINT', l_TolIntSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWTOLINT)';
				END;
		END IF;
		

		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONREA', l_r034DAC.CONREA);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDCONREA)';
				END;
		END IF;
		IF (:OLD.CONREA <> :NEW.CONREA AND l_r034EDP.CONREA <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) OR (l_oridef = 2 AND :NEW.CONREA = 'N') THEN /* PARTICIPA DA REVISTA ALEATORIA = 'N' EH MAIS ABRANGENTE */
				l_r034DAC.CONREA := :NEW.CONREA;
				l_r034EDP.CONREA := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONREA', l_r034DAC.CONREA);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWCONREA)';
				END;
		END IF;

		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDUTICHV', l_r034DAC.UTICHV);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDUTICHV)';
				END;
		END IF;
		IF (:OLD.UTICHV <> :NEW.UTICHV AND l_r034EDP.UTICHV <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) OR (l_oridef = 2 AND :NEW.UTICHV = 'S') THEN /* UTILIZA CONTROLE DE CHAVES = 'S' EH MAIS ABRANGENTE */
				l_r034DAC.UTICHV := :NEW.UTICHV;
				l_r034EDP.UTICHV := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWUTICHV', l_r034DAC.UTICHV);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWUTICHV)';
				END;
		END IF;
		

		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDREPONL', l_r034DAC.REPONL);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDREPONL)';
				END;
		END IF;
		IF (:OLD.REPONL <> :NEW.REPONL AND l_r034EDP.REPONL <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) THEN /* UTILIZA REP VEM SOMENTE DO POSTO PRINICPAL */
				l_r034DAC.REPONL := :NEW.REPONL;
				l_r034EDP.REPONL := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWREPONL', l_r034DAC.REPONL);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWREPONL)';
				END;
		END IF;
		
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDUSARFA', l_r034DAC.USARFA);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDUSARFA)';
				END;
		END IF;
		IF (:OLD.USARFA <> :NEW.USARFA AND l_r034EDP.USARFA <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) THEN /* UTILIZA REC. FACIAL VEM SOMENTE DO POSTO PRINICPAL */
				l_r034DAC.USARFA := :NEW.USARFA;
				l_r034EDP.USARFA := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWUSARFA', l_r034DAC.USARFA);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWUSARFA)';
				END;
		END IF;
		
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONREE', l_r034DAC.CONREE);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDCONREE)';
				END;
		END IF;
		IF (:OLD.CONREE <> :NEW.CONREE AND l_r034EDP.CONREE <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) THEN /* CONTROLA REENTRADA VEM SOMENTE DO POSTO PRINICPAL */
				l_r034DAC.CONREE := :NEW.CONREE;
				l_r034EDP.CONREE := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONREE', l_r034DAC.CONREE);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWCONREE)';
				END;
		END IF;		

		IF (l_temAud > 0) THEN
				BEGIN
						l_prmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.CODPRM);
						l_prmSTR := LTRIM(l_prmSTR);
						l_prmSTR := RTRIM(l_prmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPRM', l_prmSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDCODPRM)';
				END;
				
				BEGIN
						l_prmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.PRMFER);
						l_prmSTR := LTRIM(l_prmSTR);
						l_prmSTR := RTRIM(l_prmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRMFER', l_prmSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDPRMFER)';
				END;
				
				BEGIN
						l_prmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.PRMSAB);
						l_prmSTR := LTRIM(l_prmSTR);
						l_prmSTR := RTRIM(l_prmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRMSAB', l_prmSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDPRMSAB)';
				END;
				
				BEGIN
						l_prmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.PRMDOM);
						l_prmSTR := LTRIM(l_prmSTR);
						l_prmSTR := RTRIM(l_prmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRMDOM', l_prmSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDPRMDOM)';
				END;
				
				BEGIN
						l_prmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.PRMVIS);
						l_prmSTR := LTRIM(l_prmSTR);
						l_prmSTR := RTRIM(l_prmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRMVIS', l_prmSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDPRMVIS)';
				END;
		END IF;
		IF (l_oridef = 1) THEN /* SETO AS PERMISSOES, SE O POSTO EH POSTO PRINICPAL */
			l_r034DAC.CODPRM := :NEW.CODPRM; /* AS PERMISSOES DE ACESSO SAO SEMPRE ATUALIZADAS */
			l_r034DAC.PRMFER := :NEW.PRMFER;
			l_r034DAC.PRMSAB := :NEW.PRMSAB;
			l_r034DAC.PRMDOM := :NEW.PRMDOM;
			l_r034DAC.PRMVIS := :NEW.PRMVIS;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						l_prmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.CODPRM);
						l_prmSTR := LTRIM(l_prmSTR);
						l_prmSTR := RTRIM(l_prmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPRM', l_prmSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWCODPRM)';
				END;
				
				BEGIN
						l_prmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.PRMFER);
						l_prmSTR := LTRIM(l_prmSTR);
						l_prmSTR := RTRIM(l_prmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRMFER', l_prmSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWPRMFER)';
				END;
				
				BEGIN
						l_prmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.PRMSAB);
						l_prmSTR := LTRIM(l_prmSTR);
						l_prmSTR := RTRIM(l_prmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRMSAB', l_prmSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWPRMSAB)';
				END;
				
				BEGIN
						l_prmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.PRMDOM);
						l_prmSTR := LTRIM(l_prmSTR);
						l_prmSTR := RTRIM(l_prmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRMDOM', l_prmSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWPRMDOM)';
				END;
				
				BEGIN
						l_prmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.PRMVIS);
						l_prmSTR := LTRIM(l_prmSTR);
						l_prmSTR := RTRIM(l_prmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRMVIS', l_prmSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWPRMVIS)';
				END;
		END IF;


		/* ATUALIZO A TABELA R034DAC, ALTERANDO AS DEFINICOES DE ACESSO QUE VEM DE POSTO */
		BEGIN
			UPDATE R034DAC SET
				VERPRM = l_r034DAC.VERPRM, CONFAI = l_r034DAC.CONFAI, CONADP = l_r034DAC.CONADP, CONCRE = l_r034DAC.CONCRE, CONIAL = l_r034DAC.CONIAL,
				TEMALM = l_r034DAC.TEMALM, BLOFAL = l_r034DAC.BLOFAL, RECVIS = l_r034DAC.RECVIS, AUTAGV = l_r034DAC.AUTAGV, AUTASA = l_r034DAC.AUTASA,
				AUTEXT = l_r034DAC.AUTEXT, USAFRO = l_r034DAC.USAFRO, GRACON = l_r034DAC.GRACON, CONPAC = l_r034DAC.CONPAC, TEMPAC = l_r034DAC.TEMPAC,
				TOLACP = l_r034DAC.TOLACP, USABIO = l_r034DAC.USABIO, AUTDBL = l_r034DAC.AUTDBL, VERAFA = l_r034DAC.VERAFA, APRSOL = l_r034DAC.APRSOL,
				CONINT = l_r034DAC.CONINT, TOLINT = l_r034DAC.TOLINT, CONREA = l_r034DAC.CONREA, UTICHV = l_r034DAC.UTICHV, REPONL = l_r034DAC.REPONL,
				USARFA = l_r034DAC.USARFA, CONREE = l_r034DAC.CONREE, CODPRM = l_r034DAC.CODPRM, PRMFER = l_r034DAC.PRMFER, PRMSAB = l_r034DAC.PRMSAB, 
				PRMDOM = l_r034DAC.PRMDOM, PRMVIS = l_r034DAC.PRMVIS
			WHERE NUMEMP = l_r038HPO.NUMEMP AND TIPCOL = l_r038HPO.TIPCOL AND NUMCAD = l_r038HPO.NUMCAD;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'R017DAC_EU: Erro ao atualizar as definicoes de acesso do colaborador.';
		END;

		/* ATUALIZO A TABELA R034EDP, COM AS ORIGENS DE CADA DEFINICAO DE ACESSSO.
			 SE O COLABORADOR NAO POSSUIR REGISTRO NA TABELA R034EDP, GRAVO-O. */
		IF (l_graedp = TRUE) THEN
			BEGIN
				INSERT INTO R034EDP (NUMEMP, TIPCOL, NUMCAD, VERPRM, CONFAI, CONADP, CONCRE, CONIAL, TEMALM, BLOFAL, RECVIS, AUTAGV, AUTASA,
					AUTEXT, USAFRO, GRACON, CONPAC, TEMPAC, TOLACP, USABIO, AUTDBL, VERAFA, APRSOL, CONINT, TOLINT, CONREA, UTICHV, REPONL, USARFA, CONREE)
				VALUES (l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_r034EDP.VERPRM, l_r034EDP.CONFAI, l_r034EDP.CONADP, l_r034EDP.CONCRE, l_r034EDP.CONIAL, 
					l_r034EDP.TEMALM, l_r034EDP.BLOFAL, l_r034EDP.RECVIS, l_r034EDP.AUTAGV, l_r034EDP.AUTASA, l_r034EDP.AUTEXT, l_r034EDP.USAFRO,
					l_r034EDP.GRACON, l_r034EDP.CONPAC, l_r034EDP.TEMPAC, l_r034EDP.TOLACP, l_r034EDP.USABIO, l_r034EDP.AUTDBL, l_r034EDP.VERAFA,
					l_r034EDP.APRSOL, l_r034EDP.CONINT, l_r034EDP.TOLINT, l_r034EDP.CONREA, l_r034EDP.UTICHV, l_r034EDP.REPONL, l_r034EDP.USARFA, l_r034EDP.CONREE);
			EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'R017DAC_EU: Erro ao incluir as excecoes de definicoes de acesso do colaborador.';
			END;
		ELSE
			BEGIN
				UPDATE R034EDP SET
					VERPRM = l_r034EDP.VERPRM, CONFAI = l_r034EDP.CONFAI, CONADP = l_r034EDP.CONADP, CONCRE = l_r034EDP.CONCRE, CONIAL = l_r034EDP.CONIAL,
					TEMALM = l_r034EDP.TEMALM, BLOFAL = l_r034EDP.BLOFAL, RECVIS = l_r034EDP.RECVIS, AUTAGV = l_r034EDP.AUTAGV, AUTASA = l_r034EDP.AUTASA,
					AUTEXT = l_r034EDP.AUTEXT, USAFRO = l_r034EDP.USAFRO, GRACON = l_r034EDP.GRACON, CONPAC = l_r034EDP.CONPAC, TEMPAC = l_r034EDP.TEMPAC,
					TOLACP = l_r034EDP.TOLACP, USABIO = l_r034EDP.USABIO, AUTDBL = l_r034EDP.AUTDBL, VERAFA = l_r034EDP.VERAFA, APRSOL = l_r034EDP.APRSOL,
					CONINT = l_r034EDP.CONINT, TOLINT = l_r034EDP.TOLINT, CONREA = l_r034EDP.CONREA, UTICHV = l_r034EDP.UTICHV, REPONL = l_r034EDP.REPONL,
					USARFA = l_r034EDP.USARFA, CONREE = l_r034EDP.CONREE
				WHERE NUMEMP = l_r038HPO.NUMEMP AND TIPCOL = l_r038HPO.TIPCOL AND NUMCAD = l_r038HPO.NUMCAD;
			EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'R017DAC_EU: Erro ao atualizar as excecoes de definicoes de acesso do colaborador.';
			END;
		END IF;
	END LOOP;
END		SENIOR;214§␀␀

TRIGGER R017DAC_EU AFTER UPDATE ON R017DAC FOR EACH ROW
DECLARE
l_datatu DATE;
	l_estpos   R017DAC.EstPos%TYPE;
	l_postra   R017DAC.PosTra%TYPE;
	l_graedp BOOLEAN;
	l_oridef NUMBER(1);
	l_codRPA      NUMBER(15);
	l_temAud      NUMBER(2);
	l_numempSTR   VARCHAR2(255);
	l_tipcolSTR   VARCHAR2(255);
	l_numcadSTR   VARCHAR2(255);
	l_ConCreSTR VARCHAR(1);
	l_ConFaiSTR VARCHAR(1);
	l_TemAlmSTR VARCHAR(3);
	l_TemPacSTR VARCHAR(3);
	l_GraConSTR VARCHAR(3);
	l_TolIntSTR VARCHAR(3);
	l_prmSTR VARCHAR(5);
	l_UsaBioSTR VARCHAR(1);
	l_TolAcpSTR   VARCHAR2(255);
	l_horatu      NUMBER(5);

	TYPE t_r034DAC IS RECORD(
		VERPRM   R034DAC.VERPRM%TYPE,
		CONFAI   R034DAC.CONFAI%TYPE,
		CONADP   R034DAC.CONADP%TYPE,
		CONCRE   R034DAC.CONCRE%TYPE,
		CONIAL   R034DAC.CONIAL%TYPE,
		TEMALM   R034DAC.TEMALM%TYPE,
		BLOFAL   R034DAC.BLOFAL%TYPE,
		RECVIS   R034DAC.RECVIS%TYPE,
		AUTAGV   R034DAC.AUTAGV%TYPE,
		AUTASA   R034DAC.AUTASA%TYPE,
		AUTEXT   R034DAC.AUTEXT%TYPE,
		USAFRO   R034DAC.USAFRO%TYPE,
		GRACON   R034DAC.GRACON%TYPE,
		CONPAC   R034DAC.CONPAC%TYPE,
		TEMPAC   R034DAC.TEMPAC%TYPE,
		TOLACP   R034DAC.TOLACP%TYPE,
		USABIO   R034DAC.USABIO%TYPE,
		AUTDBL   R034DAC.AUTDBL%TYPE,
		VERAFA   R034DAC.VERAFA%TYPE,
		APRSOL   R034DAC.APRSOL%TYPE,
		CONINT   R034DAC.CONINT%TYPE,
		TOLINT   R034DAC.TOLINT%TYPE,
		CONREA   R034DAC.CONREA%TYPE,
		UTICHV   R034DAC.UTICHV%TYPE,
		REPONL   R034DAC.REPONL%TYPE,
		USARFA   R034DAC.USARFA%TYPE,
		CONREE   R034DAC.CONREE%TYPE,
		CODPRM   R034DAC.CODPRM%TYPE,
		PRMFER   R034DAC.PRMFER%TYPE,
		PRMSAB   R034DAC.PRMSAB%TYPE,
		PRMDOM   R034DAC.PRMDOM%TYPE,
		PRMVIS   R034DAC.PRMVIS%TYPE);
	l_r034DAC t_r034DAC;

	TYPE t_r034EDP IS RECORD(
		VERPRM   R034EDP.VERPRM%TYPE,
		CONFAI   R034EDP.CONFAI%TYPE,
		CONADP   R034EDP.CONADP%TYPE,
		CONCRE   R034EDP.CONCRE%TYPE,
		CONIAL   R034EDP.CONIAL%TYPE,
		TEMALM   R034EDP.TEMALM%TYPE,
		BLOFAL   R034EDP.BLOFAL%TYPE,
		RECVIS   R034EDP.RECVIS%TYPE,
		AUTAGV   R034EDP.AUTAGV%TYPE,
		AUTASA   R034EDP.AUTASA%TYPE,
		AUTEXT   R034EDP.AUTEXT%TYPE,
		USAFRO   R034EDP.USAFRO%TYPE,
		GRACON   R034EDP.GRACON%TYPE,
		CONPAC   R034EDP.CONPAC%TYPE,
		TEMPAC   R034EDP.TEMPAC%TYPE,
		TOLACP   R034EDP.TOLACP%TYPE,
		USABIO   R034EDP.USABIO%TYPE,
		AUTDBL   R034EDP.AUTDBL%TYPE,
		VERAFA   R034EDP.VERAFA%TYPE,
		APRSOL   R034EDP.APRSOL%TYPE,
		CONINT   R034EDP.CONINT%TYPE,
		TOLINT   R034EDP.TOLINT%TYPE,
		CONREA   R034EDP.CONREA%TYPE,
		UTICHV   R034EDP.UTICHV%TYPE,
		REPONL   R034EDP.REPONL%TYPE,
		USARFA   R034EDP.USARFA%TYPE,
		CONREE   R034EDP.CONREE%TYPE);
	l_r034EDP t_r034EDP;

	CURSOR c_r038HPO IS
		SELECT R038HPO.NUMEMP, R038HPO.TIPCOL, R038HPO.NUMCAD, R017TAP.HISPRI FROM R038HPO, R017TAP
			WHERE R038HPO.CODTAP = R017TAP.CODTAP AND ESTPOS = l_estpos AND POSTRA = l_postra
				AND R038HPO.INIATU <= l_datatu AND R038HPO.TERATU >= l_datatu;
	TYPE t_r038HPO IS RECORD(
		NUMEMP   R038HPO.NUMEMP%TYPE,
		TIPCOL   R038HPO.TIPCOL%TYPE,
		NUMCAD   R038HPO.NUMCAD%TYPE,
		HISPRI   R017TAP.HISPRI%TYPE);
	l_r038HPO t_r038HPO;
BEGIN
	l_datatu := CURDATE();
	l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
	l_estpos := :NEW.ESTPOS;
	l_postra := :NEW.POSTRA;
	
	l_temAud := 0;
	BEGIN
			SELECT COUNT(*) INTO l_temAud FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 80;
	EXCEPTION
			WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao realizar o SELECT na tabela R995CTE.';
	END;
	
	l_codRPA := 0;

	/* BUSCO TODOS OS COLABORADORES QUE POSSUEM ESTE POSTO DE TRABALHO VIGENTE NA DATA ATUAL */
	FOREACH c_r038HPO INTO l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_r038HPO.HISPRI
	LOOP
		SP_RET_REG_AUD(l_codRPA OUT);
	
		l_numempSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMEMP);
		l_numempSTR := LTRIM(l_numempSTR);
		l_numempSTR := RTRIM(l_numempSTR);
		
		l_tipcolSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.TIPCOL);
		l_tipcolSTR := LTRIM(l_tipcolSTR);
		l_tipcolSTR := RTRIM(l_tipcolSTR);

		l_numcadSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMCAD);
		l_numcadSTR := LTRIM(l_numcadSTR);
		l_numcadSTR := RTRIM(l_numcadSTR);
		
		IF (l_temAud > 0) THEN
				BEGIN
						/* insere registro mestre - Tabela R995RPA */
						INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
								VALUES (l_codRPA, 3, 6, 1, 80, 1, l_datatu, l_horatu, 'FRGERPRM', :NEW.CODUSU);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao inserir registros mestre para a tabela de log de auditoria R995RPA.';
				END;
				/* insere os campos chave  - Tabela R995PRC */
				BEGIN
						INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
						INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
						INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
				END;
		END IF;
	
		l_graedp := FALSE;

		IF (l_r038HPO.HISPRI = 'S') THEN
			l_oridef := 1; /* HISTORICO PRINCIPAL */
		ELSE
			l_oridef := 2; /* HISTORICO ADICIONAL */
		END IF;

		/* BUSCO AS DEFINICOES DE ACESSO DO COLABORADOR */
		BEGIN
			SELECT VERPRM, CONFAI, CONADP, CONCRE, CONIAL, TEMALM, BLOFAL, RECVIS, AUTAGV, AUTASA, AUTEXT, USAFRO, GRACON,
				CONPAC, TEMPAC, TOLACP, USABIO, AUTDBL, VERAFA, APRSOL, CONINT, TOLINT, CONREA, UTICHV, REPONL, USARFA, CONREE,
				CODPRM, PRMFER, PRMSAB, PRMDOM, PRMVIS
			INTO l_r034DAC.VERPRM, l_r034DAC.CONFAI, l_r034DAC.CONADP, l_r034DAC.CONCRE, l_r034DAC.CONIAL, l_r034DAC.TEMALM,
				l_r034DAC.BLOFAL, l_r034DAC.RECVIS, l_r034DAC.AUTAGV, l_r034DAC.AUTASA, l_r034DAC.AUTEXT, l_r034DAC.USAFRO,
				l_r034DAC.GRACON, l_r034DAC.CONPAC, l_r034DAC.TEMPAC, l_r034DAC.TOLACP, l_r034DAC.USABIO, l_r034DAC.AUTDBL,
				l_r034DAC.VERAFA, l_r034DAC.APRSOL, l_r034DAC.CONINT, l_r034DAC.TOLINT, l_r034DAC.CONREA, l_r034DAC.UTICHV,
				l_r034DAC.REPONL, l_r034DAC.USARFA, l_r034DAC.CONREE, l_r034DAC.CODPRM, l_r034DAC.PRMFER, l_r034DAC.PRMSAB, 
				l_r034DAC.PRMDOM, l_r034DAC.PRMVIS FROM R034DAC
			WHERE NUMEMP = l_r038HPO.NUMEMP AND TIPCOL = l_r038HPO.TIPCOL AND NUMCAD = l_r038HPO.NUMCAD;
		EXCEPTION
			WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao buscar as definicoes de acesso do colaborador.';
		END;

		/* BUSCO AS EXCECOES DE DEFINICAO DE ACESSO POR COLABORADOR */
		BEGIN
			SELECT VERPRM, CONFAI, CONADP, CONCRE, CONIAL, TEMALM, BLOFAL, RECVIS, AUTAGV, AUTASA, AUTEXT, USAFRO, GRACON,
				CONPAC, TEMPAC, TOLACP, USABIO, AUTDBL, VERAFA, APRSOL, CONINT, TOLINT, CONREA, UTICHV, REPONL, USARFA, CONREE
			INTO l_r034EDP.VERPRM, l_r034EDP.CONFAI, l_r034EDP.CONADP, l_r034EDP.CONCRE, l_r034EDP.CONIAL, l_r034EDP.TEMALM,
				l_r034EDP.BLOFAL, l_r034EDP.RECVIS, l_r034EDP.AUTAGV, l_r034EDP.AUTASA, l_r034EDP.AUTEXT, l_r034EDP.USAFRO,
				l_r034EDP.GRACON, l_r034EDP.CONPAC, l_r034EDP.TEMPAC, l_r034EDP.TOLACP, l_r034EDP.USABIO, l_r034EDP.AUTDBL,
				l_r034EDP.VERAFA, l_r034EDP.APRSOL, l_r034EDP.CONINT, l_r034EDP.TOLINT, l_r034EDP.CONREA, l_r034EDP.UTICHV,
				l_r034EDP.REPONL, l_r034EDP.USARFA, l_r034EDP.CONREE FROM R034EDP
			WHERE NUMEMP = l_r038HPO.NUMEMP AND TIPCOL = l_r038HPO.TIPCOL AND NUMCAD = l_r038HPO.NUMCAD;
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_r034EDP.VERPRM := 0;
				l_r034EDP.CONFAI := 0;
				l_r034EDP.CONADP := 0;
				l_r034EDP.CONCRE := 0;
				l_r034EDP.CONIAL := 0;
				l_r034EDP.TEMALM := 0;
				l_r034EDP.BLOFAL := 0;
				l_r034EDP.RECVIS := 0;
				l_r034EDP.AUTAGV := 0;
				l_r034EDP.AUTASA := 0;
				l_r034EDP.AUTEXT := 0;
				l_r034EDP.USAFRO := 0;
				l_r034EDP.GRACON := 0;
				l_r034EDP.CONPAC := 0;
				l_r034EDP.TEMPAC := 0;
				l_r034EDP.TOLACP := 0;
				l_r034EDP.USABIO := 0;
				l_r034EDP.AUTDBL := 0;
				l_r034EDP.VERAFA := 0;
				l_r034EDP.APRSOL := 0;
				l_r034EDP.CONINT := 0;
				l_r034EDP.TOLINT := 0;
				l_r034EDP.CONREA := 0;
				l_r034EDP.UTICHV := 0;
				l_r034EDP.REPONL := 0;
				l_r034EDP.USARFA := 0;
				l_r034EDP.CONREE := 0;
				l_graedp := TRUE;
			WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao buscar excecoes de definicao de acesso do colaborador.';
		END;

		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVERPRM', l_r034DAC.VERPRM);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDVERPRM)';
				END;
		END IF;
		IF (:OLD.VERPRM <> :NEW.VERPRM AND l_r034EDP.VERPRM <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) OR (l_oridef = 2 AND :NEW.VERPRM = 'N') THEN /* VERIFICA PERMISSAO = 'N' EH MAIS ABRANGENTE */
				l_r034DAC.VERPRM := :NEW.VERPRM;
				l_r034EDP.VERPRM := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWVERPRM', l_r034DAC.VERPRM);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWVERPRM)';
				END;
		END IF;
		

		IF (l_temAud > 0) THEN
				BEGIN
						l_ConFaiSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.CONFAI);
						l_ConFaiSTR := LTRIM(l_ConFaiSTR);
						l_ConFaiSTR := RTRIM(l_ConFaiSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONFAI', l_ConFaiSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDCONFAI)';
				END;
		END IF;
		IF (:OLD.CONFAI <> :NEW.CONFAI AND l_r034EDP.CONFAI <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) OR (l_oridef = 2 AND :NEW.CONFAI = 0) THEN /* CONTROLA FAIXA HORARIA = 0 EH MAIS ABRANGENTE */
				l_r034DAC.CONFAI := :NEW.CONFAI;
				l_r034EDP.CONFAI := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						l_ConFaiSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.CONFAI);
						l_ConFaiSTR := LTRIM(l_ConFaiSTR);
						l_ConFaiSTR := RTRIM(l_ConFaiSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONFAI', l_ConFaiSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWCONFAI)';
				END;
		END IF;
		
		
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONADP', l_r034DAC.CONADP);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDCONADP)';
				END;
		END IF;
		IF (:OLD.CONADP <> :NEW.CONADP AND l_r034EDP.CONADP <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) OR (l_oridef = 2 AND :NEW.CONADP = 'N') THEN /* CONTROLA NIVEL E ANTI DUPLA = 'N' EH MAIS ABRANGENTE */
				l_r034DAC.CONADP := :NEW.CONADP;
				l_r034EDP.CONADP := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONADP', l_r034DAC.CONADP);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWCONADP)';
				END;
		END IF;
		

		IF (l_temAud > 0) THEN
				BEGIN
						l_ConCreSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.CONCRE);
						l_ConCreSTR := LTRIM(l_ConCreSTR);
						l_ConCreSTR := RTRIM(l_ConCreSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONCRE', l_ConCreSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDCONCRE)';
				END;
		END IF;
		IF (:OLD.CONCRE <> :NEW.CONCRE AND l_r034EDP.CONCRE <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) OR (l_oridef = 2 AND :NEW.CONCRE = 0) THEN /* CONTROLA CREDITOS DE ACESSO = 0 EH MAIS ABRANGENTE */
				l_r034DAC.CONCRE := :NEW.CONCRE;
				l_r034EDP.CONCRE := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						l_ConCreSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.CONCRE);
						l_ConCreSTR := LTRIM(l_ConCreSTR);
						l_ConCreSTR := RTRIM(l_ConCreSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONCRE',l_ConCreSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWCONCRE)';
				END;
		END IF;
		

		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONIAL', l_r034DAC.CONIAL);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDCONIAL)';
				END;
		END IF;
		IF (:OLD.CONIAL <> :NEW.CONIAL AND l_r034EDP.CONIAL <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) OR (l_oridef = 2 AND :NEW.CONIAL = 'N') THEN /* CONTROLA INTERVALO ALMOÃ!O = 'N' EH MAIS ABRANGENTE */
				l_r034DAC.CONIAL := :NEW.CONIAL;
				l_r034EDP.CONIAL := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONIAL', l_r034DAC.CONIAL);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWCONIAL)';
				END;
		END IF;
		

		IF (l_temAud > 0) THEN
				BEGIN
						l_TemAlmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.TEMALM);
						l_TemAlmSTR := LTRIM(l_TemAlmSTR);
						l_TemAlmSTR := RTRIM(l_TemAlmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTEMALM', l_TemAlmSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDTEMALM)';
				END;
		END IF;
		IF (:OLD.TEMALM <> :NEW.TEMALM AND l_r034EDP.TEMALM <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) THEN /* TEMPO MINIMO DE ALMOCO VEM SOMENTE DO POSTO PRINICPAL */
				l_r034DAC.TEMALM := :NEW.TEMALM;
				l_r034EDP.TEMALM := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						l_TemAlmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.TEMALM);
						l_TemAlmSTR := LTRIM(l_TemAlmSTR);
						l_TemAlmSTR := RTRIM(l_TemAlmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTEMALM', l_TemAlmSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWTEMALM)';
				END;
		END IF;
		

		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDBLOFAL', l_r034DAC.BLOFAL);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDBLOFAL)';
				END;
		END IF;
		IF (:OLD.BLOFAL <> :NEW.BLOFAL AND l_r034EDP.BLOFAL <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) OR (l_oridef = 2 AND :NEW.BLOFAL = 'N') THEN /* BLOQUEIA POR FALTA = 'N' EH MAIS ABRANGENTE */
				l_r034DAC.BLOFAL := :NEW.BLOFAL;
				l_r034EDP.BLOFAL := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWBLOFAL', l_r034DAC.BLOFAL);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWBLOFAL)';
				END;
		END IF;
		

		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDRECVIS', l_r034DAC.RECVIS);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDRECVIS)';
				END;
		END IF;
		IF (:OLD.RECVIS <> :NEW.RECVIS AND l_r034EDP.RECVIS <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) OR (l_oridef = 2 AND :NEW.RECVIS = 'S') THEN /* PODE RECEBER VISITA = 'S' EH MAIS ABRANGENTE */
				l_r034DAC.RECVIS := :NEW.RECVIS;
				l_r034EDP.RECVIS := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWRECVIS', l_r034DAC.RECVIS);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWRECVIS)';
				END;
		END IF;
		

		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAUTAGV', l_r034DAC.AUTAGV);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDAUTAGV)';
				END;
		END IF;
		IF (:OLD.AUTAGV <> :NEW.AUTAGV AND l_r034EDP.AUTAGV <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) OR (l_oridef = 2 AND :NEW.AUTAGV = 'S') THEN /* AUTORIZA AGENDAMENTO DE VISITA = 'S' EH MAIS ABRANGENTE */
				l_r034DAC.AUTAGV := :NEW.AUTAGV;
				l_r034EDP.AUTAGV := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAUTAGV', l_r034DAC.AUTAGV);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWAUTAGV)';
				END;
		END IF;
		

		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAUTASA', l_r034DAC.AUTASA);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDAUTASA)';
				END;
		END IF;
		IF (:OLD.AUTASA <> :NEW.AUTASA AND l_r034EDP.AUTASA <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) OR (l_oridef = 2 AND :NEW.AUTASA = 'S') THEN /* AUTORIZA SAIDA COLABORADOR = 'S' EH MAIS ABRANGENTE */
				l_r034DAC.AUTASA := :NEW.AUTASA;
				l_r034EDP.AUTASA := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAUTASA', l_r034DAC.AUTASA);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWAUTASA)';
				END;
		END IF;
		

		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAUTEXT', l_r034DAC.AUTEXT);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDAUTEXT)';
