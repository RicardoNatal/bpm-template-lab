TRIGGER R304QUA_SI AFTER INSERT ON R304QUA
DECLARE
	CURSOR c_R304QUA IS
	SELECT NUMEMP, MESANO, TIPQUA, CARFUN, DATINI, SEQREG
	  FROM R304QUA
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304QUA IS RECORD (
		NUMEMP   R304QUA.NumEmp%TYPE,
		MESANO   R304QUA.MesAno%TYPE,
		TIPQUA   R304QUA.TipQua%TYPE,
		CARFUN   R304QUA.CarFun%TYPE,
		DATINI   R304QUA.DatIni%TYPE,
		SEQREG   R304QUA.SeqReg%TYPE
	);
	
	l_NumEmpAux   R304QUA.NumEmp%TYPE;
	l_MesAnoAux   R304QUA.MesAno%TYPE;
    
    l_R304QUA t_R304QUA;
    
	l_PidSta VARCHAR2(30);
	l_DesRes VARCHAR(250);
	l_MesAnoStr VARCHAR(7);
	l_DatIniStr VARCHAR(10);
BEGIN
	l_NumEmpAux := 0;
	l_MesAnoAux := DATETIME(31, 12, 1900, 0, 0, 0);
	l_PidSta := NULL;

	FOREACH c_R304QUA INTO l_R304QUA.NumEmp, l_R304QUA.MesAno, l_R304QUA.TipQua, l_R304QUA.CarFun, l_R304QUA.DatIni, l_R304QUA.SeqReg
	LOOP
		/* Se último registro se tratava da mesma Competência, utiliza o PID encontrando anteriormente */
		IF ((l_R304QUA.NumEmp <> l_NumEmpAux) OR (l_R304QUA.MesAno <> l_MesAnoAux)) THEN
			l_PidSta := NULL;
		END IF;
		
		/* Verifica se já tem algum outro registro na mesma competência que esteja pendente (P - Pendente Envio ou R - Erro Envio) */
		IF (l_PidSta IS NULL) THEN
			BEGIN
				SELECT DISTINCT R304QUA.PIDSTA INTO l_PidSta
				  FROM R304QUA, R304STA
				 WHERE R304QUA.PIDSTA = R304STA.PIDSTA
				   AND R304QUA.NUMEMP = l_R304QUA.NumEmp
				   AND R304QUA.MESANO = l_R304QUA.MesAno
				   AND (R304STA.STAENV = 'P' OR R304STA.STAENV = 'R');
			EXCEPTION
				WHEN NO_DATA_FOUND THEN
					l_PidSta := NULL;
				WHEN TOO_MANY_ROWS THEN
					RAISERROR 103 'Foi encontrado mais de um registro de status Pendente Envio e/ou Erro Envio para a mesma competência.';	
				WHEN OTHERS THEN
					RAISERROR 103 'Erro ao buscar PID já existente para a mesma competência.';
			END;
		END IF;
		
		/* Se não encontrou PID na mesma competência gera um novo */
		IF (l_PidSta IS NULL) THEN
			/* Gera um novo PID */
			SP_GERPIDSTA(l_R304QUA.NumEmp, 2, l_PidSta OUT);
				
			SP_DATSTR(l_R304QUA.MesAno, 'MM/YYYY', l_MesAnoStr OUT);
			l_DesRes := 'Mês/Ano: ' || l_MesAnoStr;
		
			/* Inclui registro de status na tabela R304STA */
			SP_GERSTA_ESFINGE(2, l_PidSta, l_R304QUA.MesAno, l_DesRes, l_R304QUA.NumEmp, 0, 0);
		END IF;
		
		BEGIN
			UPDATE R304QUA
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304QUA.NumEmp
			   AND MESANO = l_R304QUA.MesAno
			   AND TIPQUA = l_R304QUA.TipQua
			   AND CARFUN = l_R304QUA.CarFun
			   AND DATINI = l_R304QUA.DatIni
			   AND SEQREG = l_R304QUA.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304QUA.';
		END;
		
		l_NumEmpAux := l_R304QUA.NumEmp;
		l_MesAnoAux := l_R304QUA.MesAno;
	END LOOP;
END␀Ìå␀␀		SENIOR;0İ␀␀TRIGGER R304QUA_EI BEFORE INSERT ON R304QUA FOR EACH ROW
DECLARE
	l_SeqReg NUMBER(9);
	l_StaEnv CHAR;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Busca última sequência cadastrada */
	BEGIN
		SELECT QUA.SEQREG, STA.STAENV INTO l_SeqReg, l_StaEnv FROM R304QUA QUA, R304STA STA
		 WHERE QUA.NUMEMP = :NEW.NumEmp
		   AND QUA.MESANO = :NEW.MesAno
		   AND QUA.TIPQUA = :NEW.TipQua
		   AND QUA.CARFUN = :NEW.CarFun
		   AND QUA.DATINI = :NEW.DatIni
		   AND QUA.PIDSTA = STA.PIDSTA
		   AND QUA.SEQREG = (SELECT MAX(QUA2.SEQREG) FROM R304QUA QUA2
		   					  WHERE QUA2.NUMEMP = QUA.NUMEMP
		   					    AND QUA2.MESANO = QUA.MESANO
		   					    AND QUA2.TIPQUA = QUA.TIPQUA
		   					    AND QUA2.CARFUN = QUA.CARFUN
		   					    AND QUA2.DATINI = QUA.DATINI);
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
			l_StaEnv := '';
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304QUA.';
	END;
	
	/* Verifica se encontrou última sequência */
	IF ( l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
		
		/* Verifica se a última sequência está com status Cancelado */
		IF (l_StaEnv <> 'N') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que registro de sequência anterior ' || l_SeqRegStr || ' esteja com status Cancelado.';
			RAISERROR 103 l_MsgErr;
		END IF;	
	END IF;
END␀Íå␀␀		SENIOR;0•␀␀

TRIGGER R304QUA_EU BEFORE UPDATE ON R304QUA FOR EACH ROW
DECLARE
	l_StaEnv CHAR;
BEGIN
	/* Não deixa alterar registro caso status seja diferente de P - Pendente Envio ou R - Erro */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro podem ser alterados/excluídos.';
	END IF;
END␀Îå␀␀	SENIOR;0/␀␀


TRIGGER R304QUA_SD AFTER DELETE ON R304QUA
BEGIN
	BEGIN
		DELETE FROM R304STA
		 WHERE LAYOUT = 2
		   AND NOT EXISTS (SELECT 1 FROM R304QUA WHERE R304QUA.PIDSTA = R304STA.PIDSTA);
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao excluir registros não utilizados na tabela R304STA.';
	END;
END␀␀␀5*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Ğå␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀‚¬␀␀	Ôÿ?␀␀␀␀␀Ä±␀␀<¯␀␀\±␀␀%␀␀ÿ␀␀ÿ␀ˆ¬␀␀¼␀	Ôÿ?␀␀␀␀␀I°␀␀=¯␀␀°␀␀v␀Æÿ␀␀ÿ␀␀¤	Ôÿ?␀␀␀␀␀=␀U␀U␀p␀Æÿ␀␀ÿ␀U'	Ôÿ?␀␀␀␀␀ûAİ'	@%␀␀ÿ␀␀ÿ␀EÑ␀	Ôÿ?␀␀␀␀␀8Lì”␀␀+KqC␀êÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀ıDÑ␀	Ôÿ?␀␀␀␀␀%J@G—IqC␀␀êÿ␀␀ÿ␀/␀+	Ôÿ?␀␀␀␀␀Ñ␀û␀€␀p␀Æÿ␀␀ÿ␀5Â␀␀EÔÿ?␀␀␀␀␀-Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀␀␀Ñå␀␀	␀␀0;1;2;3;4;5;6×å␀␀	SENIOR;0X
