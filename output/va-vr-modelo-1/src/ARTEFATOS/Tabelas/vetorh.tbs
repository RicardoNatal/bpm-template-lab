TRIGGER R038EVT_EI AFTER INSERT ON R038EVT FOR EACH ROW

DECLARE
l_datevt       DATE;
BEGIN
  IF  (:NEW.STAATU = 1) THEN

      SELECT R034FUN.DATEVT INTO l_datevt
        FROM R034FUN
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
             
      IF  ((:NEW.INIEVT >= l_datevt) OR (l_datevt IS NULL)) THEN
          BEGIN
            UPDATE R034FUN
               SET ESCVTR = :NEW.ESCVTR,
                   PONEMB = :NEW.PONEMB,
                   DATEVT = :NEW.INIEVT
             WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                   R034FUN.NUMEMP = :NEW.NUMEMP AND
                   R034FUN.NUMCAD = :NEW.NUMCAD;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro Na Atualização do R034FUN';
          END;
      END IF;
  END IF;
END␀vÔ␀␀	SENIOR;0ö␀␀

TRIGGER R038EVT_SU AFTER UPDATE ON R038EVT

DECLARE
l_escvtr       NUMBER(5);
  l_ponemb       NUMBER(4);
  l_inievt       DATE;
  l_fimevt       DATE;
  l_nofound      BOOLEAN;

  /* CURSOR c/ os registros gravados no R038EVT_AUX */
  CURSOR c_r038evt_del IS SELECT NUMEMP,TIPCOL,NUMCAD FROM R038EVT_AUX;
  TYPE t_r038EVT_aux IS RECORD(
    NUMEMP   R038EVT_AUX.NUMEMP%TYPE,
    TIPCOL   R038EVT_AUX.TIPCOL%TYPE,
    NUMCAD   R038EVT_AUX.NUMCAD%TYPE);
  l_r038EVT_aux t_r038EVT_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r038evt_del INTO  l_r038EVT_aux.NUMEMP,
                              l_r038EVT_aux.TIPCOL,
                              l_r038EVT_aux.NUMCAD
  LOOP
   /* Pega o historico anterior */
    l_nofound:=FALSE;
    BEGIN
      SELECT A.ESCVTR,A.PONEMB,A.INIEVT,A.FIMEVT INTO l_escvtr,l_ponemb,l_inievt,l_fimevt
      FROM R038EVT A
      WHERE A.NUMEMP = l_r038evt_aux.NUMEMP
      AND   A.TIPCOL = l_r038evt_aux.TIPCOL
      AND   A.NUMCAD = l_r038evt_aux.NUMCAD
      AND   A.STAATU = 1
      AND INIEVT IN (SELECT MAX(INIEVT) FROM R038EVT
                     WHERE NUMEMP = l_r038evt_aux.NUMEMP
                     AND   TIPCOL = l_r038evt_aux.TIPCOL
                     AND   NUMCAD = l_r038evt_aux.NUMCAD
                     AND   STAATU = 1);
    EXCEPTION
      WHEN TOO_MANY_ROWS THEN
        RAISERROR 103 'Erro em R038EVT - TOO MANY ROWS';
      WHEN NO_DATA_FOUND THEN
        l_nofound := TRUE;
        l_escvtr:=0;
        l_ponemb:=0;
        l_inievt:='31/12/1900,00:00:00';
        l_fimevt:='31/12/1900,00:00:00';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT R038EVT';
    END;
   /* Atualiza tabela de colaboradores */

    BEGIN
       UPDATE R034FUN
          SET ESCVTR = l_escvtr,
              PONEMB = l_ponemb,
              DATEVT = l_inievt
        WHERE R034FUN.TIPCOL = l_r038evt_aux.TIPCOL AND
              R034FUN.NUMEMP = l_r038evt_aux.NUMEMP AND
              R034FUN.NUMCAD = l_r038evt_aux.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro Na Atualização do R034FUN';
    END;
    
  END LOOP;

 /* Apaga Registro OLD em R038EVT_AUX */
  BEGIN
    DELETE FROM R038EVT_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀sÔ␀␀		SENIOR;0%␀␀

TRIGGER R038EVT_EU AFTER UPDATE ON R038EVT FOR EACH ROW

DECLARE
l_datevt       DATE;
  l_datzer       DATE;
BEGIN
  l_datzer:='31/12/1900,00:00:00';
  SELECT R034FUN.DATEVT INTO l_datevt
    FROM R034FUN
   WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
         R034FUN.NUMEMP = :NEW.NUMEMP AND
         R034FUN.NUMCAD = :NEW.NUMCAD;

  IF  ((:NEW.INIEVT >= l_datevt) OR (l_datevt IS NULL)) THEN
      IF  (:NEW.STAATU = 1) THEN
           BEGIN
             UPDATE R034FUN
                SET ESCVTR = :NEW.ESCVTR,
                    PONEMB = :NEW.PONEMB,
                    DATEVT = :NEW.INIEVT
              WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                    R034FUN.NUMEMP = :NEW.NUMEMP AND
                    R034FUN.NUMCAD = :NEW.NUMCAD;
           EXCEPTION WHEN OTHERS THEN
             RAISERROR 103 'Erro Na Atualização do R034FUN';
           END;
      ELSE
           /* se alterou para historico passado, verificar se tem outra em aberto. */
           BEGIN
           /* Insere Registro Old */
             INSERT INTO R038EVT_AUX (NUMEMP,TIPCOL,NUMCAD)
             VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD);
           EXCEPTION WHEN OTHERS THEN
             RAISERROR 103 'Erro no INSERT em R038EVT_AUX.';
           END;
      END IF;
  END IF;
END␀uÔ␀␀	SENIOR;0ò␀␀TRIGGER R038EVT_SD AFTER DELETE ON R038EVT

DECLARE
l_escvtr       NUMBER(5);
  l_ponemb       NUMBER(4);
  l_inievt       DATE;
  l_fimevt       DATE;
  l_nofound      BOOLEAN;

  /* CURSOR c/ os registros gravados no R038EVT_AUX */
  CURSOR c_r038evt_del IS SELECT NUMEMP,TIPCOL,NUMCAD FROM R038EVT_AUX;
  TYPE t_r038EVT_aux IS RECORD(
    NUMEMP   R038EVT_AUX.NUMEMP%TYPE,
    TIPCOL   R038EVT_AUX.TIPCOL%TYPE,
    NUMCAD   R038EVT_AUX.NUMCAD%TYPE);
  l_r038EVT_aux t_r038EVT_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r038evt_del INTO  l_r038EVT_aux.NUMEMP,
                              l_r038EVT_aux.TIPCOL,
                              l_r038EVT_aux.NUMCAD
  LOOP
   /* Pega o historico anterior */
    l_nofound:=FALSE;
    BEGIN
      SELECT A.ESCVTR,A.PONEMB,A.INIEVT,A.FIMEVT INTO l_escvtr,l_ponemb,l_inievt,l_fimevt
      FROM R038EVT A
      WHERE A.NUMEMP = l_r038evt_aux.NUMEMP
      AND   A.TIPCOL = l_r038evt_aux.TIPCOL
      AND   A.NUMCAD = l_r038evt_aux.NUMCAD
      AND   A.STAATU = 1
      AND INIEVT IN (SELECT MAX(INIEVT) FROM R038EVT
                     WHERE NUMEMP = l_r038evt_aux.NUMEMP
                     AND   TIPCOL = l_r038evt_aux.TIPCOL
                     AND   NUMCAD = l_r038evt_aux.NUMCAD
                     AND   STAATU = 1);
    EXCEPTION
      WHEN TOO_MANY_ROWS THEN
        RAISERROR 103 'Erro em R038EVT - TOO MANY ROWS';
      WHEN NO_DATA_FOUND THEN
        l_nofound := TRUE;
        l_escvtr:=0;
        l_ponemb:=0;
        l_inievt:='31/12/1900,00:00:00';
        l_fimevt:='31/12/1900,00:00:00';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT R038EVT';
    END;
   /* Atualiza tabela de colaboradores */

    BEGIN
       UPDATE R034FUN
          SET ESCVTR = l_escvtr,
              PONEMB = l_ponemb,
              DATEVT = l_inievt
        WHERE R034FUN.TIPCOL = l_r038evt_aux.TIPCOL AND
              R034FUN.NUMEMP = l_r038evt_aux.NUMEMP AND
              R034FUN.NUMCAD = l_r038evt_aux.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro Na Atualização do R034FUN';
    END;
    
  END LOOP;

 /* Apaga Registro OLD em R038EVT_AUX */
  BEGIN
    DELETE FROM R038EVT_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀qÔ␀␀		SENIOR;0t␀␀

TRIGGER R038EVT_ED AFTER DELETE ON R038EVT FOR EACH ROW

BEGIN
IF  (:OLD.STAATU = 1) THEN
      BEGIN
      /* Insere Registro Old */
        INSERT INTO R038EVT_AUX (NUMEMP,TIPCOL,NUMCAD)
        VALUES (:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD);
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no INSERT em R038EVT_AUX.';
      END;
  END IF;
END␀␀␀çv␀␀␀␀␀␀␀␀pÔ␀␀…¬␀␀´␀‘␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t‘␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀‘␀␀␀␀␀␀/%€$0.w␀Æÿ␀␀ÿ␀ë␀␀Ñ␀‘␀␀␀␀␀␀K]G]GqC␀êÿ␀␀ÿ␀oÑ␀‘␀␀␀␀␀␀ñFÔFÔFqC␀êÿ␀␀ÿ␀™e·␀‘␀␀␀␀␀␀ï<e¡es␀Æÿ␀␀ÊÑ␀␀␀ìÂ␀␀´␀‘␀␀␀␀␀␀Ã␀␀MaÿÂ␀␀r␀Æÿ␀␀ÿ␀␀É‘␀␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀␀␀␀èv␀␀␀␀␀␀␀␀␀wÔ␀␀…¬␀␀´␀	Ôÿ/␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ/␀␀␀␀␀Ü␀t␀Ü␀n%ˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ/␀␀␀␀␀.%0.0.w"ˆ␀Æÿ␀␀…Ó␀␀␀EÑ␀	Ôÿ/␀␀␀␀␀LZ”␀␀KqC#ˆ␀êÿ␀␀ÿ␀^ı␀␀­␀	Ôÿ/␀␀␀␀␀ÿ␀␀xş␀␀xş␀␀p␀Æÿ␀␀ÿ␀$-Ì␀Ôÿ/␀␀␀␀␀ö?•¸␀␀Â;{␀Æÿ␀␀.#␀ ,Ì␀Ôÿ/␀␀␀␀␀x@áqw@{␀Æÿ␀␀##␀µEÑ␀Ôÿ/␀␀␀␀␀—L6␀…KqC#ˆ␀êÿ␀␀ÿ␀Š³␀␀*Ôÿ/␀␀␀␀␀l´␀␀ñ³␀␀ñ³␀␀?␀␀ÿ␀␀ÿ␀␀␀␀	0;1;2;3;4yÔ␀␀		SENIOR;0␀␀TRIGGER R038GHE_EI AFTER INSERT ON R038GHE FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataInicio DATE;
	l_DataTermino DATE;
	l_DataInicioSST DATE;
	l_DataAux DATE;
	l_LigacaoGHE NUMBER(1);
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DataInicio := :NEW.DatIni;
	l_DataTermino := :NEW.DatTer;
	
	SM_LIGACAOGHE(:NEW.NumEmp, l_LigacaoGHE OUT);
	RH_RET_DATINISST(:NEW.NumEmp, l_DataInicioSST OUT);
	IF (l_DataInicioSST > l_DataZero) AND (l_LigacaoGHE = 1) THEN /* Ligação GHE: 1 - Colaborador */
		IF (l_DataTermino > l_DataInicioSST OR l_DataTermino = l_DataZero) THEN
		  	IF (l_DataInicio < l_DataInicioSST) THEN
		  		l_DataInicio := l_DataInicioSST;
		  	END IF;
		  	
			SP_E_SOCIAL_SM('S-2240', 'R038GHE', 'N', 'I', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038GHE_EI');
		
			/* Se o histórico que está sendo incluído tiver data de término, já cria uma pendência para o dia seguinte à data informada */
			IF (l_DataTermino > l_DataZero) THEN
				l_DataAux := DATETIMEADD(DD, 1, l_DataTermino);
				SP_E_SOCIAL_SM('S-2240', 'R038GHE', 'N', 'I', l_DataAux, l_DataAux, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataAux, 0, 'R038GHE_EI');
			END IF;
		END IF;
	END IF;
END␀zÔ␀␀		SENIOR;0é␀␀

TRIGGER R038GHE_EU AFTER UPDATE ON R038GHE FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataInicioSST DATE;
	l_AlterouCampo BOOLEAN;
	l_AlterouGHE BOOLEAN;
	l_AlterouTermino BOOLEAN;
	l_DataInicio DATE;
	l_DataTermino DATE;
	l_DataAux DATE;
	l_LigacaoGHE NUMBER(1);
	l_JsonAlteracao VARCHAR2(2000);
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
    l_JsonAlteracao := '';
    
    SM_LIGACAOGHE(:NEW.NumEmp, l_LigacaoGHE OUT);
	RH_RET_DATINISST(:NEW.NumEmp, l_DataInicioSST OUT);
	IF (l_DataInicioSST > l_DataZero) AND (l_LigacaoGHE = 1) THEN /* Ligação GHE: 1 - Colaborador */
		IF (:NEW.DatTer > l_DataInicioSST OR :OLD.DatTer > l_DataInicioSST OR :NEW.DatTer = l_DataZero OR :OLD.DatTer = l_DataZero) THEN	
		  	l_AlterouGHE := FALSE;
		  	l_AlterouTermino := FALSE;
		  
		  	SP_VALUPDATE_NUM(:OLD.CodPRA, :NEW.CodPRA, l_AlterouCampo OUT);
		  	IF (l_AlterouCampo = TRUE) THEN
				l_AlterouGHE := TRUE;
				SP_CONCAT_NUM_JSON('CODPRA', :NEW.CodPRA, :OLD.CodPRA, l_JsonAlteracao OUT);
		  	END IF;
		  
		  	SP_VALUPDATE_NUM(:OLD.CodGHE, :NEW.CodGHE, l_AlterouCampo OUT);
		  	IF (l_AlterouCampo = TRUE) THEN
				l_AlterouGHE := TRUE;
				SP_CONCAT_NUM_JSON('CODGHE', :NEW.CodGHE, :OLD.CodGHE, l_JsonAlteracao OUT);
		  	END IF;
			
			SP_VALUPDATE_DAT(:OLD.DatTer, :NEW.DatTer, l_AlterouCampo OUT);
		  	IF (l_AlterouCampo = TRUE) THEN
				l_AlterouTermino := TRUE;
				SP_CONCAT_DAT_JSON('DATTER', :NEW.DatTer, :OLD.DatTer, l_JsonAlteracao OUT);
			END IF;
			
			IF (l_AlterouGHE = TRUE) THEN
				l_DataInicio := :NEW.DatIni;
				IF (l_DataInicio < l_DataInicioSST) THEN
		  			l_DataInicio := l_DataInicioSST;
		  		END IF;
		  		
		  		IF (:OLD.DatTer < :NEW.DatTer) THEN
		  			l_DataTermino := :OLD.DatTer;
		  		ELSE
		  			l_DataTermino := :NEW.DatTer;
		  		END IF;
		  		
				SP_E_SOCIAL_SM('S-2240', 'R038GHE', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonAlteracao, 0, NULL, l_DataInicio, 0, 'R038GHE_EU');
			END IF;
			
			IF (l_AlterouTermino = TRUE) THEN
				/* Se as datas de término nova e antiga forem maiores que zero */
				IF (:OLD.DatTer > l_DataZero AND :NEW.DatTer > l_DataZero) THEN
					IF (:NEW.DatTer > :OLD.DatTer) THEN
						/* Aumentou a data de término, então cria pendência da data de término antiga até a data de término nova */
						l_DataInicio := DATETIMEADD(DD, 1, :OLD.DatTer);
						l_DataTermino := :NEW.DatTer;
						SP_E_SOCIAL_SM('S-2240', 'R038GHE', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonAlteracao, 0, NULL, l_DataInicio, 0, 'R038GHE_EU');
						
						/* Cria uma pendência também para o dia posterior ao novo término informado */
						l_DataAux := DATETIMEADD(DD, 1, :NEW.DatTer);
						SP_E_SOCIAL_SM('S-2240', 'R038GHE', 'N', 'A', l_DataAux, l_DataAux, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonAlteracao, 0, NULL, l_DataAux, 0, 'R038GHE_EU');
					ELSE
						/* Diminuiu a data de término, então cria pendência da data de término nova até a data de término antiga */
						l_DataInicio := DATETIMEADD(DD, 1, :NEW.DatTer);
						l_DataTermino := :OLD.DatTer;
						SP_E_SOCIAL_SM('S-2240', 'R038GHE', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonAlteracao, 0, NULL, l_DataInicio, 0, 'R038GHE_EU');
					END IF;				
				ELSE
					/* Se alterou o término de 00/00/0000 para uma data válida */
					IF (:OLD.DatTer = l_DataZero AND :NEW.DatTer > l_DataZero) THEN
						l_DataInicio := DATETIMEADD(DD, 1, :NEW.DatTer);
						l_DataTermino := :OLD.DatTer;
						SP_E_SOCIAL_SM('S-2240', 'R038GHE', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonAlteracao, 0, NULL, l_DataInicio, 0, 'R038GHE_EU');
					ELSE
						/* Se alterou o término de uma data válida para 00/00/0000 */
						IF (:NEW.DatTer = l_DataZero AND :OLD.DatTer > l_DataZero) THEN
							l_DataInicio := DATETIMEADD(DD, 1, :OLD.DatTer);
							l_DataTermino := :NEW.DatTer;
							SP_E_SOCIAL_SM('S-2240', 'R038GHE', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonAlteracao, 0, NULL, l_DataInicio, 0, 'R038GHE_EU');
						END IF;
					END IF;
				END IF;
			END IF;
		END IF;
	END IF;
END␀xÔ␀␀		SENIOR;0m␀␀

