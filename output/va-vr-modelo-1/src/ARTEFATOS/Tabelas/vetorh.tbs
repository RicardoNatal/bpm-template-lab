TRIGGER R038AAF_EI AFTER INSERT ON R038AAF FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs HistoricoAfastamentosAcompanhamento*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 74;     /* HistoricoAfastamentosAcompanhamento*/
  l_codtpa := 259;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038AAF_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAFA', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORAFA', CONVERT(NUMBER_TO_CHAR, :NEW.HORAFA));
        SP_DATSTR(:NEW.DATACO, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATACO', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038AAF_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:NEW.DATPRX, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPRX', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSACO', :NEW.OBSACO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODREC', CONVERT(NUMBER_TO_CHAR, :NEW.CODREC));
        SP_DATSTR(:NEW.DATDEC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATDEC', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RESREC', CONVERT(NUMBER_TO_CHAR, :NEW.RESREC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRXREC', CONVERT(NUMBER_TO_CHAR, :NEW.PRXREC));
      END;
  END IF; 
END␀?Ô␀␀		SENIOR;0µ␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R038AAF_EU AFTER UPDATE ON R038AAF FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs HistoricoAfastamentosAcompanhamento*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 74;     /* HistoricoAfastamentosAcompanhamento*/
  l_codtpa := 260;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatAfa <> :NEW.DatAfa)
   OR (:OLD.HorAfa <> :NEW.HorAfa)
   OR (:OLD.DatAco <> :NEW.DatAco)
   OR (:OLD.DatPrx <> :NEW.DatPrx)
   OR (:OLD.ObsAco <> :NEW.ObsAco)
   OR (:OLD.CodRec <> :NEW.CodRec)
   OR (:OLD.DatDec <> :NEW.DatDec)
   OR (:OLD.ResRec <> :NEW.ResRec)
   OR (:OLD.PrxRec <> :NEW.PrxRec)) THEN

    IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038AAF_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAFA', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORAFA', CONVERT(NUMBER_TO_CHAR, :OLD.HORAFA));
        SP_DATSTR(:OLD.DATACO, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATACO', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038AAF_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:OLD.DATPRX, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATPRX', l_datTemp);
        SP_DATSTR(:NEW.DATPRX, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATPRX', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSACO', :OLD.OBSACO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSACO', :NEW.OBSACO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODREC', CONVERT(NUMBER_TO_CHAR, :OLD.CODREC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODREC', CONVERT(NUMBER_TO_CHAR, :NEW.CODREC));
        SP_DATSTR(:OLD.DATDEC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATDEC', l_datTemp);
        SP_DATSTR(:NEW.DATDEC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATDEC', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDRESREC', CONVERT(NUMBER_TO_CHAR, :OLD.RESREC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWRESREC', CONVERT(NUMBER_TO_CHAR, :NEW.RESREC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRXREC', CONVERT(NUMBER_TO_CHAR, :OLD.PRXREC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRXREC', CONVERT(NUMBER_TO_CHAR, :NEW.PRXREC));
      END;
    END IF; 
  END IF; 
END␀=Ô␀␀		SENIOR;0Ü	␀␀ 

