$␀␀PROCEDURE SP_GRA004TMP(P_DATHOR DATE,P_TIPFAI CHAR(1),P_FAIINI NUMBER(5),P_FAIFIM NUMBER(5),P_TURTRB NUMBER(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10))
 IS

l_count        NUMBER(3);
BEGIN
  /* TIPFAI:  */
  /* A = ACESSO */
  /* P = PONTO */
  /* R = REFEITORIO */


    /* verifica se já existe*/
    l_count := 0;
    BEGIN
        SELECT COUNT(*) INTO l_count FROM R004TMP
         WHERE dathor = p_dathor AND tipfai = p_tipfai AND faiini = p_faiini AND
               faifim = p_faifim AND turtrb = p_turtrb AND numemp = p_numemp AND
               tipcol = p_tipcol AND numcad = p_numcad;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN l_count := 0;
        WHEN OTHERS THEN  l_count := 0;
    END;

    IF (l_count = 0) THEN
        BEGIN
            INSERT INTO R004TMP (DATHOR,TIPFAI,FAIINI,FAIFIM,TURTRB,NUMEMP,TIPCOL,NUMCAD)
            VALUES(p_dathor, p_tipfai,p_faiini, p_faifim,p_turtrb,p_numemp,p_tipcol,p_numcad);
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;
    END IF;
END␀Kø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_DATAHORA
SP_GETCODUSU
š␀␀PROCEDURE SP_GRAVALPR(L_ATIPLOG NUMBER(3), L_AMSGLOG VARCHAR2(1000))
 IS

	l_xDataHora		NUMBER(14,6);
	l_xDataHoraAux	NUMBER(14,6);
	l_xSeqLog     	NUMBER(9);
	l_Usuario		NUMBER(10);
	l_NomeUsuario 	VARCHAR2(40); 
	l_Inserir     	BOOLEAN;
BEGIN
	l_Usuario := 0;
 	l_xSeqLog := 1;
	
	/* Retorna o código do usuário que está executando a ação */
	SP_GETCODUSU(l_Usuario OUT, l_nomeUsuario OUT);
  
  	SP_DATAHORA(l_xDataHoraAux OUT,'DH');
    l_xDataHora := l_xDataHoraAux;
  
	/* Busca a data do último log inserido na tabela R067LPR para o TIPLPR = 185. 
	 * Isto é necessário pois o usuário pode alterar vários registros de uma única vez, 
	 * neste caso o sistema acaba gerando chave duplicada pois a inclusão dos logs é muito rápida. */
	SELECT (IFNULL(MAX(DTHLOG),0) + 0.000001) INTO l_xDataHora FROM R067LPR WHERE TIPLPR = L_ATIPLOG;
	IF (l_xDataHoraAux > l_xDataHora) THEN
  		l_xDataHora := l_xDataHoraAux;
  	END IF;
  
  	l_Inserir := TRUE;
  	WHILE (l_Inserir = TRUE) LOOP
    	BEGIN      
      		INSERT INTO R067LPR (TIPLPR, DTHLOG, CNXUSU, SEQLOG, CODUSU, MSGLOG) VALUES (L_ATIPLOG, l_xDataHora, 0, l_xSeqLog, l_Usuario, L_AMSGLOG);
      		l_Inserir := FALSE;
    	EXCEPTION
      		WHEN DUPVALONINDEX THEN
        		l_Inserir := TRUE; /* Se der erro de chave duplicada seta a flag para tentar inserir novamente com outro código */
				l_xDataHora := l_xDataHora + 0.000001;
        		l_xSeqLog := l_xSeqLog + 1;
      		WHEN OTHERS THEN
        		l_Inserir := FALSE; /* Para garantir que saia do LOOP quando der outro tipo de exceção */
        		RAISERROR 103 'Erro ao Inserir R067LPR. (SP_GRAVALPR)';
    	END;
  	END LOOP;    
END␀Rø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
