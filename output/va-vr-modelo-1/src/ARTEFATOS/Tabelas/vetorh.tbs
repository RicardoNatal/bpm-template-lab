:␀␀

PROCEDURE SP_SINMVI(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

l_datins     DATE;
    l_datstr     VARCHAR2(16);
    l_datSaiStr  VARCHAR2(16);
    l_usocra     NUMBER(2);
    l_numcra     NUMBER(12);
    l_idtvis     VARCHAR2(23);
    l_tam        NUMBER(2);
    l_pos        NUMBER(3);
    l_datsai     DATE;
    l_horsai     NUMBER(4);
    l_plavee     VARCHAR2(10); 
    l_place1     VARCHAR2(10); 
    l_place2     VARCHAR2(10);
    l_place3     VARCHAR2(10);
    l_numlau     VARCHAR2(12);
    l_datent     DATE;
    l_datentaco  DATE;
    l_coderr     NUMBER(2);
    l_datval     DATE;
    l_horval     NUMBER(4);
    l_cravei     NUMBER(12);
    /*Variáveis auxiliares para conversão de data*/
    l_datcon     VARCHAR2(25);
    l_horent     NUMBER(4);
    l_seqent     NUMBER(2);
    l_horentaco  NUMBER(4);
    l_seqentaco  NUMBER(2);
    l_count      NUMBER(1);
    l_tiptpv     NUMBER(4);
    /*Variáveis auxiliares para desmontar IDTPES*/
    l_tippes     NUMBER(2);
    l_numemp     NUMBER(4);
    l_tipcol     NUMBER(1);
    l_numcad     NUMBER(9);
    l_nummat     VARCHAR2(15);
    l_propac     VARCHAR2(20);

    l_tipdocVis  NUMBER(1);
    l_numdocVis  VARCHAR2(20);
    l_data_zero  DATE;
    l_tipvis     VARCHAR2(3);
    l_tipvis_nmb NUMBER(3);
    l_codusu     NUMBER(10);
    l_codpor     NUMBER(3);
    l_persac     VARCHAR2(1);    
    
    /*acompanhantes*/
	l_qtdaco     NUMBER(2);
	l_nomaco     VARCHAR2(99);
	l_idtpesaco  VARCHAR2(23);
	l_numcraaco  NUMBER(12);
	l_contLoop   NUMBER(2);
BEGIN
    /* inicializa variáveis */
    l_coderr := 0;
    p_RetErr := 0;
    l_data_zero := '31/12/1900,00:00:00';
    l_datins := CURDATE();
    
    /* separa os valores da string do p_valStr em cada variável */
    BEGIN
	    l_pos := 3;    
        l_idtVis := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_numcra := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, l_pos, 12)); l_pos := l_pos + 12;
        l_datstr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
        l_datSaiStr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
        l_plavee := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place1 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place2 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place3 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_numlau := NULL;
        
        l_tam := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, l_pos, 2)); l_pos := l_pos + 2;        
        IF (l_tam > 0) THEN
            l_numlau := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, l_tam))); l_pos := l_pos + l_tam;

            IF  (l_numlau = '') THEN
              l_numlau := NULL;
            END IF;
        END IF;
        
        /* converte data saída */
        l_datcon := SUBSTRING(l_datSaiStr,1,2) || '/' || SUBSTRING(l_datSaiStr,3,2) ||'/'||SUBSTRING(l_datSaiStr,5,2);
        SP_STRTODATE(l_datcon,'DD/MM/AA', l_datsai OUT);
        l_horsai := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datSaiStr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datSaiStr,9,2)));

        /* desmontar IDTPES do visitante */
        SP_PESFROMIDTPES(l_idtVis, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT, l_tipdocVis OUT, l_numdocVis OUT, l_nummat OUT, l_propac OUT);
        
        /* CODUSU */
        l_codusu := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;

        /* padronizar as placas tirando espaços e traços */
        l_plavee := LTRIM(RTRIM(REPLACE(REPLACE(l_plavee, '-', ''), ' ', '')));
        l_place1 := LTRIM(RTRIM(REPLACE(REPLACE(l_place1, '-', ''), ' ', '')));
        l_place2 := LTRIM(RTRIM(REPLACE(REPLACE(l_place2, '-', ''), ' ', '')));
        l_place3 := LTRIM(RTRIM(REPLACE(REPLACE(l_place3, '-', ''), ' ', '')));
        
        /* por causa do ORACLE que considera '' como NULL e no SQL-SERVER não */
        IF  (l_plavee = '') THEN
          l_plavee := NULL;
        END IF;
        
        IF  (l_place1 = '') THEN
          l_place1 := NULL;
        END IF;
        
        IF  (l_place2 = '') THEN
          l_place2 := NULL;
        END IF;

        IF  (l_place3 = '') THEN
          l_place3 := NULL;
        END IF;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 41; /* erro de conversão na string */
    END;

    BEGIN
        SELECT TipVis, DATENT, HORENT, SEQENT, DATVAL, HORVAL, CODPOR
	      INTO l_tipvis_nmb, l_datent, l_horent, l_seqent, l_datval, l_horval, l_codpor
          FROM R090MVI 
         WHERE R090MVI.NUMCRA = l_numcra AND R090MVI.TIPDOC = l_tipdocVis AND R090MVI.NUMDOC = l_numdocVis AND DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;

    BEGIN
        SELECT PERSAC
	      INTO l_persac
          FROM R058POR 
         WHERE R058POR.CODPOR = l_codpor;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    IF (l_codErr = 0) THEN
        /* verificar procedimentos */
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R090PRO WHERE TIPVIS = l_tipvis_nmb AND PROVIS = 2 AND CONPRO = 3;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN l_count := 0;
            WHEN TOO_MANY_ROWS THEN l_codErr := 44; l_count := 0;
            WHEN OTHERS THEN l_codErr := 44; l_count := 0;
        END;

        IF (l_count >= 1) AND (l_numlau IS NOT NULL) THEN
            BEGIN
	            SELECT COUNT(*) QNTREG INTO l_count 
	              FROM R090LAU 
	             WHERE datent = l_datent AND horent = l_horent AND seqent = l_seqent;
            EXCEPTION
	            WHEN OTHERS THEN l_codErr := 44;
            END;
        
            IF (l_count = 0) THEN        
                BEGIN
                    INSERT INTO R090LAU (datent, horent, seqent, numlau, regrod, datins)
                         VALUES (l_datent, l_horent, l_seqent, l_numlau, NULL, l_datins);
                EXCEPTION
                    WHEN OTHERS THEN l_coderr := 44;
                END;
            ELSE
              UPDATE R090LAU SET numlau = l_numlau 
               WHERE datent = l_datent AND horent = l_horent AND seqent = l_seqent;            
            END IF;            
        END IF;
    END IF;
        
    BEGIN
        SELECT MIN(tiptpv) INTO l_tiptpv FROM R088TPV;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 46;
    END;
	    
    /* Veículos */
    IF (l_plavee IS NOT NULL) THEN
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_plavee;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;

        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_plavee, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
   	END IF;
	
    IF (l_place1 IS NOT NULL) THEN
   	    BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place1;
        EXCEPTION
   	        WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
   	            INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place1, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
    END IF;
	
    IF (l_place2 IS NOT NULL) THEN
   	    BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place2;
   	    EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place2, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
   	        END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
        END;
    END IF;
	    
    IF (l_place3 IS NOT NULL) THEN
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place3;
   	    EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place3, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
    END IF;
    
    BEGIN
	    UPDATE R090MVI 
           SET DATSLO = l_datsai, HORSLO = l_horsai, DATSAI = l_datsai, HORSAI = l_horsai, PLAVES = l_plavee, PLACAS = l_place1, PLACS2 = l_place2, PLACS3 = l_place3 
         WHERE R090MVI.NUMCRA = l_numcra AND R090MVI.TIPDOC = l_tipdocVis AND R090MVI.NUMDOC = l_numdocVis AND R090MVI.DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    /* Histórico de crachá */
    BEGIN
	    UPDATE R090HCH 
	    SET DATFIM = l_datsai, HORFIM = l_horsai 
        WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATINI = l_datent AND HORINI= l_horent AND SEQENT = l_seqent AND NUMCRA = l_numcra;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 43;
    END;
    
    /* Atribui os valores de Data/Hora de entrada caso seja acompanhante */
    BEGIN
        SELECT DATENT, HORENT, SEQENT
	      INTO l_datentaco, l_horentaco, l_seqentaco
          FROM R090ACO 
         WHERE R090ACO.NUMCRA = l_numcra AND R090ACO.TIPDOC = l_tipdocVis AND R090ACO.NUMDOC = l_numdocVis AND DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    /* Se achou o DatEntAco é pq o IDTPES passado foi de um Acompanhante */
    IF (l_datentaco IS NOT NULL) THEN
        /* Acompanhantes */
   	    BEGIN
   		    UPDATE R090ACO 
        	SET DATSLO = l_datsai, HORSLO = l_horsai, DATSAI = l_datsai, HORSAI = l_horsai 
            WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATENT = l_datentaco AND HORENT= l_horentaco AND SEQENT = l_seqentaco AND NUMCRA = l_numcra;
   	    EXCEPTION
       	    WHEN OTHERS THEN l_coderr := 53;
       	END;
   
         /* Histórico de crachá de Acompanhantes */
   	    BEGIN
   		    UPDATE R090HCH 
        	SET DATFIM = l_datsai, HORFIM = l_horsai 
            WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATINI = l_datentaco AND HORINI= l_horentaco AND SEQENT = l_seqentaco AND NUMCRA = l_numcra;
   	    EXCEPTION
       	    WHEN OTHERS THEN l_coderr := 43;
        END;
    END IF;

    IF (l_persac = 'N') THEN
		BEGIN
		    /* Baixar qualquer possivel Acompanhante do "suposto visitante" informado. Se for passado um crachá de Acompanhante no lugar do visitante, nao faz nada */
	  		UPDATE R090ACO SET
				DATSLO = l_datsai,
				HORSLO = l_horsai,
				DATSAI = l_datsai,
				HORSAI = l_horsai				
	  		WHERE
				DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
		EXCEPTION
	 		WHEN OTHERS THEN
				l_codErr := 53;
	  	END;

        /* Histórico de crachá de Acompanhantes */
	    BEGIN
		    UPDATE R090HCH 
       		SET DATFIM = l_datsai, HORFIM = l_horsai 
            WHERE DATINI = l_datent AND HORINI= l_horent AND SEQENT = l_seqent AND DATFIM = l_data_zero;
	    EXCEPTION
   		    WHEN OTHERS THEN l_coderr := 43;
        END;
    END IF;

    IF (l_plavee IS NOT NULL) THEN
        /* Finaliza o histórico de crachá do veículo */        
        BEGIN
            UPDATE R088HCH 
            SET DATFIM = l_datsai, HORFIM = l_horsai, STAACC = 2
            WHERE PLAVEI = l_plavee AND DATINI = l_datent AND HORINI = l_horent AND DATFIM = l_datval;           
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;

        /* Baixar registro na R088CON */
        BEGIN
            SELECT NUMCRA INTO l_cravei FROM R088HCH WHERE PLAVEI = l_plavee AND DATINI = l_datent AND HORINI = l_horent AND DATFIM = l_datsai;
            
            IF (l_numcra <> 0) AND (l_cravei <> 0) THEN
	            SP_VEIPESCON('D', l_cravei, l_numcra, 0 /*p_sitcra*/, l_plavee, l_datval, l_horval, l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdocVis, l_numdocVis);
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
        END;        
    END IF;
    
    /* Trata auditoria de registros */
    /* Saída */    
    BEGIN
        SP_SinAudMVI(1, 0, l_datEnt, l_horEnt, l_seqent,
                      l_tipdocVis, l_numdocVis, 0, 0, 0,
                      l_numcra, 0, '', 0, '',
                      0, 0, '', 0, 0, 
                      l_datsai, 0, '',
                      l_plavee, l_place1, l_place2, l_place3,
                      l_numlau, 0,
                      /*p_numcnh   IN NUMBER(4), p_catcnh   IN VARCHAR2(20), p_vencnh   IN DATE,*/
                      '', 0, '',
                      0, 0, 0, l_codusu, l_datSai, l_horSai, 
                      '',0,0, l_codErr OUT); 
    END;

    IF (l_codErr = 0) THEN
		l_qtdaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
		l_pos := l_pos + 2;
		l_contLoop := 1;

		/* LOOP Acompanhantes */
		WHILE (l_contLoop <= l_qtdaco) LOOP
			l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
			l_pos := l_pos + 2;
			IF (l_tam > 0) THEN
				l_nomaco := SUBSTRING(p_ValStr, l_pos, l_tam);
				l_pos := l_pos + l_tam;
			END IF;

			l_idtpesaco := SUBSTRING(p_ValStr, l_pos, 23);
			l_pos := l_pos + 23;
			
			l_numcraaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
			l_pos := l_pos + 12;
			
			l_contLoop := l_contLoop + 1;
		END LOOP;
		/* FIM - LOOP Acompanhantes */
		
		/** Realiza a saida dos acompanhantes */
		IF(l_qtdaco > 0) THEN
			BEGIN
		  		UPDATE R090ACO SET
					DATSLO = l_datsai,
					HORSLO = l_horsai,
					DATSAI = l_datsai,
					HORSAI = l_horsai				
		  		WHERE
					DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
		  		EXCEPTION
			 		WHEN OTHERS THEN
					l_codErr := 53;
		  	END;
		  	
		  	/** Fecha os históricos de crachá dos acompanhantes */
		  	BEGIN
		  		UPDATE R090HCH SET
					DATFIM = l_datsai,
					HORFIM = l_horsai				
		  		WHERE
					DATINI = l_datent AND HORINI = l_horent AND SEQENT = l_seqent;
		  		EXCEPTION
			 		WHEN OTHERS THEN
					l_codErr := 53;
		  	END;
	    END IF;
	END IF;
    
    /* retorna Código do erro */
    p_retErr := l_codErr;
END		SENIOR;20<SP_STRTODATE
SP_PESFROMIDTPES
SP_VEIPESCON
SP_SinAudMVI
¹:␀␀

/* Processa demanda de sicronismo - 06 = Saida de visitantes (R090MVI)    */
PROCEDURE SP_SINMVI(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

l_datins     DATE;
    l_datstr     VARCHAR2(16);
    l_datSaiStr  VARCHAR2(16);
    l_usocra     NUMBER(2);
    l_numcra     NUMBER(12);
    l_idtvis     VARCHAR2(23);
    l_tam        NUMBER(2);
    l_pos        NUMBER(3);
    l_datsai     DATE;
    l_horsai     NUMBER(4);
    l_plavee     VARCHAR2(10); 
    l_place1     VARCHAR2(10); 
    l_place2     VARCHAR2(10);
    l_place3     VARCHAR2(10);
    l_numlau     VARCHAR2(12);
    l_datent     DATE;
    l_datentaco  DATE;
    l_coderr     NUMBER(2);
    l_datval     DATE;
    l_horval     NUMBER(4);
    l_cravei     NUMBER(12);
    /*Variáveis auxiliares para conversão de data*/
    l_datcon     VARCHAR2(25);
    l_horent     NUMBER(4);
    l_seqent     NUMBER(2);
    l_horentaco  NUMBER(4);
    l_seqentaco  NUMBER(2);
    l_count      NUMBER(1);
    l_tiptpv     NUMBER(4);
    /*Variáveis auxiliares para desmontar IDTPES*/
    l_tippes     NUMBER(2);
    l_numemp     NUMBER(4);
    l_tipcol     NUMBER(1);
    l_numcad     NUMBER(9);
    l_nummat     VARCHAR2(15);
    l_propac     VARCHAR2(20);

    l_tipdocVis  NUMBER(1);
    l_numdocVis  VARCHAR2(20);
    l_data_zero  DATE;
    l_tipvis     VARCHAR2(3);
    l_codusu     NUMBER(10);
    l_codpor     NUMBER(3);
    l_persac     VARCHAR2(1);    
    
    /*acompanhantes*/
	l_qtdaco     NUMBER(2);
	l_nomaco     VARCHAR2(99);
	l_idtpesaco  VARCHAR2(23);
	l_numcraaco  NUMBER(12);
	l_contLoop   NUMBER(2);
BEGIN
    /* inicializa variáveis */
    l_coderr := 0;
    p_RetErr := 0;
    l_data_zero := '31/12/1900,00:00:00';
    l_datins := CURDATE();
    
    /* separa os valores da string do p_valStr em cada variável */
    BEGIN
	    l_pos := 3;    
        l_idtVis := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_numcra := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, l_pos, 12)); l_pos := l_pos + 12;
        l_datstr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
        l_datSaiStr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
        l_plavee := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place1 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place2 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place3 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_numlau := NULL;
        
        l_tam := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, l_pos, 2)); l_pos := l_pos + 2;        
        IF (l_tam > 0) THEN
            l_numlau := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, l_tam))); l_pos := l_pos + l_tam;

            IF  (l_numlau = '') THEN
              l_numlau := NULL;
            END IF;
        END IF;
        
        /* converte data saída */
        l_datcon := SUBSTRING(l_datSaiStr,1,2) || '/' || SUBSTRING(l_datSaiStr,3,2) ||'/'||SUBSTRING(l_datSaiStr,5,2);
        SP_STRTODATE(l_datcon,'DD/MM/AA', l_datsai OUT);
        l_horsai := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datSaiStr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datSaiStr,9,2)));

        /* desmontar IDTPES do visitante */
        SP_PESFROMIDTPES(l_idtVis, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT, l_tipdocVis OUT, l_numdocVis OUT, l_nummat OUT, l_propac OUT);
        
        /* CODUSU */
        l_codusu := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;

        /* padronizar as placas tirando espaços e traços */
        l_plavee := LTRIM(RTRIM(REPLACE(REPLACE(l_plavee, '-', ''), ' ', '')));
        l_place1 := LTRIM(RTRIM(REPLACE(REPLACE(l_place1, '-', ''), ' ', '')));
        l_place2 := LTRIM(RTRIM(REPLACE(REPLACE(l_place2, '-', ''), ' ', '')));
        l_place3 := LTRIM(RTRIM(REPLACE(REPLACE(l_place3, '-', ''), ' ', '')));
        
        /* por causa do ORACLE que considera '' como NULL e no SQL-SERVER não */
        IF  (l_plavee = '') THEN
          l_plavee := NULL;
        END IF;
        
        IF  (l_place1 = '') THEN
          l_place1 := NULL;
        END IF;
        
        IF  (l_place2 = '') THEN
          l_place2 := NULL;
        END IF;

        IF  (l_place3 = '') THEN
          l_place3 := NULL;
        END IF;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 41; /* erro de conversão na string */
    END;

    BEGIN
        SELECT TipVis, DATENT, HORENT, SEQENT, DATVAL, HORVAL, CODPOR
	      INTO l_tipvis, l_datent, l_horent, l_seqent, l_datval, l_horval, l_codpor
          FROM R090MVI 
         WHERE R090MVI.NUMCRA = l_numcra AND R090MVI.TIPDOC = l_tipdocVis AND R090MVI.NUMDOC = l_numdocVis AND DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;

    BEGIN
        SELECT PERSAC
	      INTO l_persac
          FROM R058POR 
         WHERE R058POR.CODPOR = l_codpor;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    IF (l_codErr = 0) THEN
        /* verificar procedimentos */
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R090PRO WHERE TIPVIS = l_tipvis AND PROVIS = 2 AND CONPRO = 3;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN l_count := 0;
            WHEN TOO_MANY_ROWS THEN l_codErr := 44; l_count := 0;
            WHEN OTHERS THEN l_codErr := 44; l_count := 0;
        END;

        IF (l_count >= 1) AND (l_numlau IS NOT NULL) THEN
            BEGIN
	            SELECT COUNT(*) QNTREG INTO l_count 
	              FROM R090LAU 
	             WHERE datent = l_datent AND horent = l_horent AND seqent = l_seqent;
            EXCEPTION
	            WHEN OTHERS THEN l_codErr := 44;
            END;
        
            IF (l_count = 0) THEN        
                BEGIN
                    INSERT INTO R090LAU (datent, horent, seqent, numlau, regrod, datins)
                         VALUES (l_datent, l_horent, l_seqent, l_numlau, NULL, l_datins);
                EXCEPTION
                    WHEN OTHERS THEN l_coderr := 44;
                END;
            ELSE
              UPDATE R090LAU SET numlau = l_numlau 
               WHERE datent = l_datent AND horent = l_horent AND seqent = l_seqent;            
            END IF;            
        END IF;
    END IF;
        
    BEGIN
        SELECT MIN(tiptpv) INTO l_tiptpv FROM R088TPV;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 46;
    END;
	    
    /* Veículos */
    IF (l_plavee IS NOT NULL) THEN
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_plavee;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;

        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_plavee, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
   	END IF;
	
    IF (l_place1 IS NOT NULL) THEN
   	    BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place1;
        EXCEPTION
   	        WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
   	            INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place1, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
    END IF;
	
    IF (l_place2 IS NOT NULL) THEN
   	    BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place2;
   	    EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place2, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
   	        END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
        END;
    END IF;
	    
    IF (l_place3 IS NOT NULL) THEN
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place3;
   	    EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place3, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
    END IF;
    
    BEGIN
	    UPDATE R090MVI 
           SET DATSLO = l_datsai, HORSLO = l_horsai, DATSAI = l_datsai, HORSAI = l_horsai, PLAVES = l_plavee, PLACAS = l_place1, PLACS2 = l_place2, PLACS3 = l_place3 
         WHERE R090MVI.NUMCRA = l_numcra AND R090MVI.TIPDOC = l_tipdocVis AND R090MVI.NUMDOC = l_numdocVis AND R090MVI.DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    /* Histórico de crachá */
    BEGIN
	    UPDATE R090HCH 
	    SET DATFIM = l_datsai, HORFIM = l_horsai 
        WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATINI = l_datent AND HORINI= l_horent AND SEQENT = l_seqent AND NUMCRA = l_numcra;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 43;
    END;
    
    /* Atribui os valores de Data/Hora de entrada caso seja acompanhante */
    BEGIN
        SELECT DATENT, HORENT, SEQENT
	      INTO l_datentaco, l_horentaco, l_seqentaco
          FROM R090ACO 
         WHERE R090ACO.NUMCRA = l_numcra AND R090ACO.TIPDOC = l_tipdocVis AND R090ACO.NUMDOC = l_numdocVis AND DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    /* Se achou o DatEntAco é pq o IDTPES passado foi de um Acompanhante */
    IF (l_datentaco IS NOT NULL) THEN
        /* Acompanhantes */
   	    BEGIN
   		    UPDATE R090ACO 
        	SET DATSLO = l_datsai, HORSLO = l_horsai, DATSAI = l_datsai, HORSAI = l_horsai 
            WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATENT = l_datentaco AND HORENT= l_horentaco AND SEQENT = l_seqentaco AND NUMCRA = l_numcra;
   	    EXCEPTION
       	    WHEN OTHERS THEN l_coderr := 53;
       	END;
   
         /* Histórico de crachá de Acompanhantes */
   	    BEGIN
   		    UPDATE R090HCH 
        	SET DATFIM = l_datsai, HORFIM = l_horsai 
            WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATINI = l_datentaco AND HORINI= l_horentaco AND SEQENT = l_seqentaco AND NUMCRA = l_numcra;
   	    EXCEPTION
       	    WHEN OTHERS THEN l_coderr := 43;
        END;
    END IF;

    IF (l_persac = 'N') THEN
		BEGIN
		    /* Baixar qualquer possivel Acompanhante do "suposto visitante" informado. Se for passado um crachá de Acompanhante no lugar do visitante, nao faz nada */
	  		UPDATE R090ACO SET
				DATSLO = l_datsai,
				HORSLO = l_horsai,
				DATSAI = l_datsai,
				HORSAI = l_horsai				
	  		WHERE
				DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
		EXCEPTION
	 		WHEN OTHERS THEN
				l_codErr := 53;
	  	END;

        /* Histórico de crachá de Acompanhantes */
	    BEGIN
		    UPDATE R090HCH 
       		SET DATFIM = l_datsai, HORFIM = l_horsai 
            WHERE DATINI = l_datent AND HORINI= l_horent AND SEQENT = l_seqent AND DATFIM = l_data_zero;
	    EXCEPTION
   		    WHEN OTHERS THEN l_coderr := 43;
        END;
    END IF;

    IF (l_plavee IS NOT NULL) THEN
        /* Finaliza o histórico de crachá do veículo */        
        BEGIN
            UPDATE R088HCH 
            SET DATFIM = l_datsai, HORFIM = l_horsai, STAACC = 2
            WHERE PLAVEI = l_plavee AND DATINI = l_datent AND HORINI = l_horent AND DATFIM = l_datval;           
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;

        /* Baixar registro na R088CON */
        BEGIN
            SELECT NUMCRA INTO l_cravei FROM R088HCH WHERE PLAVEI = l_plavee AND DATINI = l_datent AND HORINI = l_horent AND DATFIM = l_datsai;
            
            IF (l_numcra <> 0) AND (l_cravei <> 0) THEN
	            SP_VEIPESCON('D', l_cravei, l_numcra, 0 /*p_sitcra*/, l_plavee, l_datval, l_horval, l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdocVis, l_numdocVis);
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
        END;        
    END IF;
    
    /* Trata auditoria de registros */
    /* Saída */    
    BEGIN
        SP_SinAudMVI(1, 0, l_datEnt, l_horEnt, l_seqent,
                      l_tipdocVis, l_numdocVis, 0, 0, 0,
                      l_numcra, 0, '', 0, '',
                      0, 0, '', 0, 0, 
                      l_datsai, 0, '',
                      l_plavee, l_place1, l_place2, l_place3,
                      l_numlau, 0,
                      /*p_numcnh   IN NUMBER(4), p_catcnh   IN VARCHAR2(20), p_vencnh   IN DATE,*/
                      '', 0, '',
                      0, 0, 0, l_codusu, l_datSai, l_horSai, 
                      '',0,0, l_codErr OUT); 
    END;

    IF (l_codErr = 0) THEN
		l_qtdaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
		l_pos := l_pos + 2;
		l_contLoop := 1;

		/* LOOP Acompanhantes */
		WHILE (l_contLoop <= l_qtdaco) LOOP
			l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
			l_pos := l_pos + 2;
			IF (l_tam > 0) THEN
				l_nomaco := SUBSTRING(p_ValStr, l_pos, l_tam);
				l_pos := l_pos + l_tam;
			END IF;

			l_idtpesaco := SUBSTRING(p_ValStr, l_pos, 23);
			l_pos := l_pos + 23;
			
			l_numcraaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
			l_pos := l_pos + 12;
			
			l_contLoop := l_contLoop + 1;
		END LOOP;
		/* FIM - LOOP Acompanhantes */
		
		/** Realiza a saida dos acompanhantes */
		IF(l_qtdaco > 0) THEN
			BEGIN
		  		UPDATE R090ACO SET
					DATSLO = l_datsai,
					HORSLO = l_horsai,
					DATSAI = l_datsai,
					HORSAI = l_horsai				
		  		WHERE
					DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
		  		EXCEPTION
			 		WHEN OTHERS THEN
					l_codErr := 53;
		  	END;
		  	
		  	/** Fecha os históricos de crachá dos acompanhantes */
		  	BEGIN
		  		UPDATE R090HCH SET
					DATFIM = l_datsai,
					HORFIM = l_horsai				
		  		WHERE
					DATINI = l_datent AND HORINI = l_horent AND SEQENT = l_seqent;
		  		EXCEPTION
			 		WHEN OTHERS THEN
					l_codErr := 53;
		  	END;
	    END IF;
	END IF;
    
    /* retorna Código do erro */
    p_retErr := l_codErr;
END		SENIOR;21<SP_STRTODATE
SP_PESFROMIDTPES
SP_VEIPESCON
SP_SinAudMVI
¹:␀␀

/* Processa demanda de sicronismo - 06 = Saida de visitantes (R090MVI)    */
PROCEDURE SP_SINMVI(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

l_datins     DATE;
    l_datstr     VARCHAR2(16);
    l_datSaiStr  VARCHAR2(16);
    l_usocra     NUMBER(2);
    l_numcra     NUMBER(12);
    l_idtvis     VARCHAR2(23);
    l_tam        NUMBER(2);
    l_pos        NUMBER(3);
    l_datsai     DATE;
    l_horsai     NUMBER(4);
    l_plavee     VARCHAR2(10); 
    l_place1     VARCHAR2(10); 
    l_place2     VARCHAR2(10);
    l_place3     VARCHAR2(10);
    l_numlau     VARCHAR2(12);
    l_datent     DATE;
    l_datentaco  DATE;
    l_coderr     NUMBER(2);
    l_datval     DATE;
    l_horval     NUMBER(4);
    l_cravei     NUMBER(12);
    /*Variáveis auxiliares para conversão de data*/
    l_datcon     VARCHAR2(25);
    l_horent     NUMBER(4);
    l_seqent     NUMBER(2);
    l_horentaco  NUMBER(4);
    l_seqentaco  NUMBER(2);
    l_count      NUMBER(1);
    l_tiptpv     NUMBER(4);
    /*Variáveis auxiliares para desmontar IDTPES*/
    l_tippes     NUMBER(2);
    l_numemp     NUMBER(4);
    l_tipcol     NUMBER(1);
    l_numcad     NUMBER(9);
    l_nummat     VARCHAR2(15);
    l_propac     VARCHAR2(20);

    l_tipdocVis  NUMBER(1);
    l_numdocVis  VARCHAR2(20);
    l_data_zero  DATE;
    l_tipvis     VARCHAR2(3);
    l_codusu     NUMBER(10);
    l_codpor     NUMBER(3);
    l_persac     VARCHAR2(1);    
    
    /*acompanhantes*/
	l_qtdaco     NUMBER(2);
	l_nomaco     VARCHAR2(99);
	l_idtpesaco  VARCHAR2(23);
	l_numcraaco  NUMBER(12);
	l_contLoop   NUMBER(2);
BEGIN
    /* inicializa variáveis */
    l_coderr := 0;
    p_RetErr := 0;
    l_data_zero := '31/12/1900,00:00:00';
    l_datins := CURDATE();
    
    /* separa os valores da string do p_valStr em cada variável */
    BEGIN
	    l_pos := 3;    
        l_idtVis := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_numcra := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, l_pos, 12)); l_pos := l_pos + 12;
        l_datstr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
        l_datSaiStr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
        l_plavee := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place1 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place2 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place3 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_numlau := NULL;
        
        l_tam := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, l_pos, 2)); l_pos := l_pos + 2;        
        IF (l_tam > 0) THEN
            l_numlau := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, l_tam))); l_pos := l_pos + l_tam;

            IF  (l_numlau = '') THEN
              l_numlau := NULL;
            END IF;
        END IF;
        
        /* converte data saída */
        l_datcon := SUBSTRING(l_datSaiStr,1,2) || '/' || SUBSTRING(l_datSaiStr,3,2) ||'/'||SUBSTRING(l_datSaiStr,5,2);
        SP_STRTODATE(l_datcon,'DD/MM/AA', l_datsai OUT);
        l_horsai := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datSaiStr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datSaiStr,9,2)));

        /* desmontar IDTPES do visitante */
        SP_PESFROMIDTPES(l_idtVis, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT, l_tipdocVis OUT, l_numdocVis OUT, l_nummat OUT, l_propac OUT);
        
        /* CODUSU */
        l_codusu := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;

        /* padronizar as placas tirando espaços e traços */
        l_plavee := LTRIM(RTRIM(REPLACE(REPLACE(l_plavee, '-', ''), ' ', '')));
        l_place1 := LTRIM(RTRIM(REPLACE(REPLACE(l_place1, '-', ''), ' ', '')));
        l_place2 := LTRIM(RTRIM(REPLACE(REPLACE(l_place2, '-', ''), ' ', '')));
        l_place3 := LTRIM(RTRIM(REPLACE(REPLACE(l_place3, '-', ''), ' ', '')));
        
        /* por causa do ORACLE que considera '' como NULL e no SQL-SERVER não */
        IF  (l_plavee = '') THEN
          l_plavee := NULL;
        END IF;
        
        IF  (l_place1 = '') THEN
          l_place1 := NULL;
        END IF;
        
        IF  (l_place2 = '') THEN
          l_place2 := NULL;
        END IF;

        IF  (l_place3 = '') THEN
          l_place3 := NULL;
        END IF;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 41; /* erro de conversão na string */
    END;

    BEGIN
        SELECT TipVis, DATENT, HORENT, SEQENT, DATVAL, HORVAL, CODPOR
	      INTO l_tipvis, l_datent, l_horent, l_seqent, l_datval, l_horval, l_codpor
          FROM R090MVI 
         WHERE R090MVI.NUMCRA = l_numcra AND R090MVI.TIPDOC = l_tipdocVis AND R090MVI.NUMDOC = l_numdocVis AND DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;

    BEGIN
        SELECT PERSAC
	      INTO l_persac
          FROM R058POR 
         WHERE R058POR.CODPOR = l_codpor;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    IF (l_codErr = 0) THEN
        /* verificar procedimentos */
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R090PRO WHERE TIPVIS = l_tipvis AND PROVIS = 2 AND CONPRO = 3;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN l_count := 0;
            WHEN TOO_MANY_ROWS THEN l_codErr := 44; l_count := 0;
            WHEN OTHERS THEN l_codErr := 44; l_count := 0;
        END;

        IF (l_count >= 1) AND (l_numlau IS NOT NULL) THEN
            BEGIN
	            SELECT COUNT(*) QNTREG INTO l_count 
	              FROM R090LAU 
	             WHERE datent = l_datent AND horent = l_horent AND seqent = l_seqent;
            EXCEPTION
	            WHEN OTHERS THEN l_codErr := 44;
            END;
        
            IF (l_count = 0) THEN        
                BEGIN
                    INSERT INTO R090LAU (datent, horent, seqent, numlau, regrod, datins)
                         VALUES (l_datent, l_horent, l_seqent, l_numlau, NULL, l_datins);
                EXCEPTION
                    WHEN OTHERS THEN l_coderr := 44;
                END;
            ELSE
              UPDATE R090LAU SET numlau = l_numlau 
               WHERE datent = l_datent AND horent = l_horent AND seqent = l_seqent;            
            END IF;            
        END IF;
    END IF;
        
    BEGIN
        SELECT MIN(tiptpv) INTO l_tiptpv FROM R088TPV;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 46;
    END;
	    
    /* Veículos */
    IF (l_plavee IS NOT NULL) THEN
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_plavee;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;

        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_plavee, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
   	END IF;
	
    IF (l_place1 IS NOT NULL) THEN
   	    BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place1;
        EXCEPTION
   	        WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
   	            INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place1, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
    END IF;
	
    IF (l_place2 IS NOT NULL) THEN
   	    BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place2;
   	    EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place2, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
   	        END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
        END;
    END IF;
	    
    IF (l_place3 IS NOT NULL) THEN
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place3;
   	    EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place3, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
    END IF;
    
    BEGIN
	    UPDATE R090MVI 
           SET DATSLO = l_datsai, HORSLO = l_horsai, DATSAI = l_datsai, HORSAI = l_horsai, PLAVES = l_plavee, PLACAS = l_place1, PLACS2 = l_place2, PLACS3 = l_place3 
         WHERE R090MVI.NUMCRA = l_numcra AND R090MVI.TIPDOC = l_tipdocVis AND R090MVI.NUMDOC = l_numdocVis AND R090MVI.DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    /* Histórico de crachá */
    BEGIN
	    UPDATE R090HCH 
	    SET DATFIM = l_datsai, HORFIM = l_horsai 
        WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATINI = l_datent AND HORINI= l_horent AND SEQENT = l_seqent AND NUMCRA = l_numcra;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 43;
    END;
    
    /* Atribui os valores de Data/Hora de entrada caso seja acompanhante */
    BEGIN
        SELECT DATENT, HORENT, SEQENT
	      INTO l_datentaco, l_horentaco, l_seqentaco
          FROM R090ACO 
         WHERE R090ACO.NUMCRA = l_numcra AND R090ACO.TIPDOC = l_tipdocVis AND R090ACO.NUMDOC = l_numdocVis AND DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    /* Se achou o DatEntAco é pq o IDTPES passado foi de um Acompanhante */
    IF (l_datentaco IS NOT NULL) THEN
        /* Acompanhantes */
   	    BEGIN
   		    UPDATE R090ACO 
        	SET DATSLO = l_datsai, HORSLO = l_horsai, DATSAI = l_datsai, HORSAI = l_horsai 
            WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATENT = l_datentaco AND HORENT= l_horentaco AND SEQENT = l_seqentaco AND NUMCRA = l_numcra;
   	    EXCEPTION
       	    WHEN OTHERS THEN l_coderr := 53;
       	END;
   
         /* Histórico de crachá de Acompanhantes */
   	    BEGIN
   		    UPDATE R090HCH 
        	SET DATFIM = l_datsai, HORFIM = l_horsai 
            WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATINI = l_datentaco AND HORINI= l_horentaco AND SEQENT = l_seqentaco AND NUMCRA = l_numcra;
   	    EXCEPTION
       	    WHEN OTHERS THEN l_coderr := 43;
        END;
    END IF;

    IF (l_persac = 'N') THEN
		BEGIN
		    /* Baixar qualquer possivel Acompanhante do "suposto visitante" informado. Se for passado um crachá de Acompanhante no lugar do visitante, nao faz nada */
	  		UPDATE R090ACO SET
				DATSLO = l_datsai,
				HORSLO = l_horsai,
				DATSAI = l_datsai,
				HORSAI = l_horsai				
	  		WHERE
				DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
		EXCEPTION
	 		WHEN OTHERS THEN
				l_codErr := 53;
	  	END;

        /* Histórico de crachá de Acompanhantes */
	    BEGIN
		    UPDATE R090HCH 
       		SET DATFIM = l_datsai, HORFIM = l_horsai 
            WHERE DATINI = l_datent AND HORINI= l_horent AND SEQENT = l_seqent AND DATFIM = l_data_zero;
	    EXCEPTION
   		    WHEN OTHERS THEN l_coderr := 43;
        END;
    END IF;

    IF (l_plavee IS NOT NULL) THEN
        /* Finaliza o histórico de crachá do veículo */        
        BEGIN
            UPDATE R088HCH 
            SET DATFIM = l_datsai, HORFIM = l_horsai, STAACC = 2
            WHERE PLAVEI = l_plavee AND DATINI = l_datent AND HORINI = l_horent AND DATFIM = l_datval;           
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;

        /* Baixar registro na R088CON */
        BEGIN
            SELECT NUMCRA INTO l_cravei FROM R088HCH WHERE PLAVEI = l_plavee AND DATINI = l_datent AND HORINI = l_horent AND DATFIM = l_datsai;
            
            IF (l_numcra <> 0) AND (l_cravei <> 0) THEN
	            SP_VEIPESCON('D', l_cravei, l_numcra, 0 /*p_sitcra*/, l_plavee, l_datval, l_horval, l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdocVis, l_numdocVis);
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
        END;        
    END IF;
    
    /* Trata auditoria de registros */
    /* Saída */    
    BEGIN
        SP_SinAudMVI(1, 0, l_datEnt, l_horEnt, l_seqent,
                      l_tipdocVis, l_numdocVis, 0, 0, 0,
                      l_numcra, 0, '', 0, '',
                      0, 0, '', 0, 0, 
                      l_datsai, 0, '',
                      l_plavee, l_place1, l_place2, l_place3,
                      l_numlau, 0,
                      /*p_numcnh   IN NUMBER(4), p_catcnh   IN VARCHAR2(20), p_vencnh   IN DATE,*/
                      '', 0, '',
                      0, 0, 0, l_codusu, l_datSai, l_horSai, 
                      '',0,0, l_codErr OUT); 
    END;

    IF (l_codErr = 0) THEN
		l_qtdaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
		l_pos := l_pos + 2;
		l_contLoop := 1;

		/* LOOP Acompanhantes */
		WHILE (l_contLoop <= l_qtdaco) LOOP
			l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
			l_pos := l_pos + 2;
			IF (l_tam > 0) THEN
				l_nomaco := SUBSTRING(p_ValStr, l_pos, l_tam);
				l_pos := l_pos + l_tam;
			END IF;

			l_idtpesaco := SUBSTRING(p_ValStr, l_pos, 23);
			l_pos := l_pos + 23;
			
			l_numcraaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
			l_pos := l_pos + 12;
			
			l_contLoop := l_contLoop + 1;
		END LOOP;
		/* FIM - LOOP Acompanhantes */
		
		/** Realiza a saida dos acompanhantes */
		IF(l_qtdaco > 0) THEN
			BEGIN
		  		UPDATE R090ACO SET
					DATSLO = l_datsai,
					HORSLO = l_horsai,
					DATSAI = l_datsai,
					HORSAI = l_horsai				
		  		WHERE
					DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
		  		EXCEPTION
			 		WHEN OTHERS THEN
					l_codErr := 53;
		  	END;
		  	
		  	/** Fecha os históricos de crachá dos acompanhantes */
		  	BEGIN
		  		UPDATE R090HCH SET
					DATFIM = l_datsai,
					HORFIM = l_horsai				
		  		WHERE
					DATINI = l_datent AND HORINI = l_horent AND SEQENT = l_seqent;
		  		EXCEPTION
			 		WHEN OTHERS THEN
					l_codErr := 53;
		  	END;
	    END IF;
	END IF;
    
    /* retorna Código do erro */
    p_retErr := l_codErr;
END		SENIOR;22<SP_STRTODATE
SP_PESFROMIDTPES
SP_VEIPESCON
SP_SinAudMVI
¹:␀␀

/* Processa demanda de sicronismo - 06 = Saida de visitantes (R090MVI)    */
PROCEDURE SP_SINMVI(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

l_datins     DATE;
    l_datstr     VARCHAR2(16);
    l_datSaiStr  VARCHAR2(16);
    l_usocra     NUMBER(2);
    l_numcra     NUMBER(12);
    l_idtvis     VARCHAR2(23);
    l_tam        NUMBER(2);
    l_pos        NUMBER(3);
    l_datsai     DATE;
    l_horsai     NUMBER(4);
    l_plavee     VARCHAR2(10); 
    l_place1     VARCHAR2(10); 
    l_place2     VARCHAR2(10);
    l_place3     VARCHAR2(10);
    l_numlau     VARCHAR2(12);
    l_datent     DATE;
    l_datentaco  DATE;
    l_coderr     NUMBER(2);
    l_datval     DATE;
    l_horval     NUMBER(4);
    l_cravei     NUMBER(12);
    /*Variáveis auxiliares para conversão de data*/
    l_datcon     VARCHAR2(25);
    l_horent     NUMBER(4);
    l_seqent     NUMBER(2);
    l_horentaco  NUMBER(4);
    l_seqentaco  NUMBER(2);
    l_count      NUMBER(1);
    l_tiptpv     NUMBER(4);
    /*Variáveis auxiliares para desmontar IDTPES*/
    l_tippes     NUMBER(2);
    l_numemp     NUMBER(4);
    l_tipcol     NUMBER(1);
    l_numcad     NUMBER(9);
    l_nummat     VARCHAR2(15);
    l_propac     VARCHAR2(20);

    l_tipdocVis  NUMBER(1);
    l_numdocVis  VARCHAR2(20);
    l_data_zero  DATE;
    l_tipvis     VARCHAR2(3);
    l_codusu     NUMBER(10);
    l_codpor     NUMBER(3);
    l_persac     VARCHAR2(1);    
    
    /*acompanhantes*/
	l_qtdaco     NUMBER(2);
	l_nomaco     VARCHAR2(99);
	l_idtpesaco  VARCHAR2(23);
	l_numcraaco  NUMBER(12);
	l_contLoop   NUMBER(2);
BEGIN
    /* inicializa variáveis */
    l_coderr := 0;
    p_RetErr := 0;
    l_data_zero := '31/12/1900,00:00:00';
    l_datins := CURDATE();
    
    /* separa os valores da string do p_valStr em cada variável */
    BEGIN
	    l_pos := 3;    
        l_idtVis := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_numcra := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, l_pos, 12)); l_pos := l_pos + 12;
        l_datstr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
        l_datSaiStr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
        l_plavee := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place1 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place2 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place3 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_numlau := NULL;
        
        l_tam := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, l_pos, 2)); l_pos := l_pos + 2;        
        IF (l_tam > 0) THEN
            l_numlau := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, l_tam))); l_pos := l_pos + l_tam;

            IF  (l_numlau = '') THEN
              l_numlau := NULL;
            END IF;
        END IF;
        
        /* converte data saída */
        l_datcon := SUBSTRING(l_datSaiStr,1,2) || '/' || SUBSTRING(l_datSaiStr,3,2) ||'/'||SUBSTRING(l_datSaiStr,5,2);
        SP_STRTODATE(l_datcon,'DD/MM/AA', l_datsai OUT);
        l_horsai := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datSaiStr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datSaiStr,9,2)));

        /* desmontar IDTPES do visitante */
        SP_PESFROMIDTPES(l_idtVis, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT, l_tipdocVis OUT, l_numdocVis OUT, l_nummat OUT, l_propac OUT);
        
        /* CODUSU */
        l_codusu := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;

        /* padronizar as placas tirando espaços e traços */
        l_plavee := LTRIM(RTRIM(REPLACE(REPLACE(l_plavee, '-', ''), ' ', '')));
        l_place1 := LTRIM(RTRIM(REPLACE(REPLACE(l_place1, '-', ''), ' ', '')));
        l_place2 := LTRIM(RTRIM(REPLACE(REPLACE(l_place2, '-', ''), ' ', '')));
        l_place3 := LTRIM(RTRIM(REPLACE(REPLACE(l_place3, '-', ''), ' ', '')));
        
        /* por causa do ORACLE que considera '' como NULL e no SQL-SERVER não */
        IF  (l_plavee = '') THEN
          l_plavee := NULL;
        END IF;
        
        IF  (l_place1 = '') THEN
          l_place1 := NULL;
        END IF;
        
        IF  (l_place2 = '') THEN
          l_place2 := NULL;
        END IF;

        IF  (l_place3 = '') THEN
          l_place3 := NULL;
        END IF;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 41; /* erro de conversão na string */
    END;

    BEGIN
        SELECT TipVis, DATENT, HORENT, SEQENT, DATVAL, HORVAL, CODPOR
	      INTO l_tipvis, l_datent, l_horent, l_seqent, l_datval, l_horval, l_codpor
          FROM R090MVI 
         WHERE R090MVI.NUMCRA = l_numcra AND R090MVI.TIPDOC = l_tipdocVis AND R090MVI.NUMDOC = l_numdocVis AND DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;

    BEGIN
        SELECT PERSAC
	      INTO l_persac
          FROM R058POR 
         WHERE R058POR.CODPOR = l_codpor;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    IF (l_codErr = 0) THEN
        /* verificar procedimentos */
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R090PRO WHERE TIPVIS = l_tipvis AND PROVIS = 2 AND CONPRO = 3;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN l_count := 0;
            WHEN TOO_MANY_ROWS THEN l_codErr := 44; l_count := 0;
            WHEN OTHERS THEN l_codErr := 44; l_count := 0;
        END;

        IF (l_count >= 1) AND (l_numlau IS NOT NULL) THEN
            BEGIN
	            SELECT COUNT(*) QNTREG INTO l_count 
	              FROM R090LAU 
	             WHERE datent = l_datent AND horent = l_horent AND seqent = l_seqent;
            EXCEPTION
	            WHEN OTHERS THEN l_codErr := 44;
            END;
        
            IF (l_count = 0) THEN        
                BEGIN
                    INSERT INTO R090LAU (datent, horent, seqent, numlau, regrod, datins)
                         VALUES (l_datent, l_horent, l_seqent, l_numlau, NULL, l_datins);
                EXCEPTION
                    WHEN OTHERS THEN l_coderr := 44;
                END;
            ELSE
              UPDATE R090LAU SET numlau = l_numlau 
               WHERE datent = l_datent AND horent = l_horent AND seqent = l_seqent;            
            END IF;            
        END IF;
    END IF;
        
    BEGIN
        SELECT MIN(tiptpv) INTO l_tiptpv FROM R088TPV;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 46;
    END;
	    
    /* Veículos */
    IF (l_plavee IS NOT NULL) THEN
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_plavee;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;

        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_plavee, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
   	END IF;
	
    IF (l_place1 IS NOT NULL) THEN
   	    BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place1;
        EXCEPTION
   	        WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
   	            INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place1, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
    END IF;
	
    IF (l_place2 IS NOT NULL) THEN
   	    BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place2;
   	    EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place2, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
   	        END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
        END;
    END IF;
	    
    IF (l_place3 IS NOT NULL) THEN
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place3;
   	    EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place3, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
    END IF;
    
    BEGIN
	    UPDATE R090MVI 
           SET DATSLO = l_datsai, HORSLO = l_horsai, DATSAI = l_datsai, HORSAI = l_horsai, PLAVES = l_plavee, PLACAS = l_place1, PLACS2 = l_place2, PLACS3 = l_place3 
         WHERE R090MVI.NUMCRA = l_numcra AND R090MVI.TIPDOC = l_tipdocVis AND R090MVI.NUMDOC = l_numdocVis AND R090MVI.DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    /* Histórico de crachá */
    BEGIN
	    UPDATE R090HCH 
	    SET DATFIM = l_datsai, HORFIM = l_horsai 
        WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATINI = l_datent AND HORINI= l_horent AND SEQENT = l_seqent AND NUMCRA = l_numcra;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 43;
    END;
    
    /* Atribui os valores de Data/Hora de entrada caso seja acompanhante */
    BEGIN
        SELECT DATENT, HORENT, SEQENT
	      INTO l_datentaco, l_horentaco, l_seqentaco
          FROM R090ACO 
         WHERE R090ACO.NUMCRA = l_numcra AND R090ACO.TIPDOC = l_tipdocVis AND R090ACO.NUMDOC = l_numdocVis AND DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    /* Se achou o DatEntAco é pq o IDTPES passado foi de um Acompanhante */
    IF (l_datentaco IS NOT NULL) THEN
        /* Acompanhantes */
   	    BEGIN
   		    UPDATE R090ACO 
        	SET DATSLO = l_datsai, HORSLO = l_horsai, DATSAI = l_datsai, HORSAI = l_horsai 
            WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATENT = l_datentaco AND HORENT= l_horentaco AND SEQENT = l_seqentaco AND NUMCRA = l_numcra;
   	    EXCEPTION
       	    WHEN OTHERS THEN l_coderr := 53;
       	END;
   
         /* Histórico de crachá de Acompanhantes */
   	    BEGIN
   		    UPDATE R090HCH 
        	SET DATFIM = l_datsai, HORFIM = l_horsai 
            WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATINI = l_datentaco AND HORINI= l_horentaco AND SEQENT = l_seqentaco AND NUMCRA = l_numcra;
   	    EXCEPTION
       	    WHEN OTHERS THEN l_coderr := 43;
        END;
    END IF;

    IF (l_persac = 'N') THEN
		BEGIN
		    /* Baixar qualquer possivel Acompanhante do "suposto visitante" informado. Se for passado um crachá de Acompanhante no lugar do visitante, nao faz nada */
	  		UPDATE R090ACO SET
				DATSLO = l_datsai,
				HORSLO = l_horsai,
				DATSAI = l_datsai,
				HORSAI = l_horsai				
	  		WHERE
				DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
		EXCEPTION
	 		WHEN OTHERS THEN
				l_codErr := 53;
	  	END;

        /* Histórico de crachá de Acompanhantes */
	    BEGIN
		    UPDATE R090HCH 
       		SET DATFIM = l_datsai, HORFIM = l_horsai 
            WHERE DATINI = l_datent AND HORINI= l_horent AND SEQENT = l_seqent AND DATFIM = l_data_zero;
	    EXCEPTION
   		    WHEN OTHERS THEN l_coderr := 43;
        END;
    END IF;

    IF (l_plavee IS NOT NULL) THEN
        /* Finaliza o histórico de crachá do veículo */        
        BEGIN
            UPDATE R088HCH 
            SET DATFIM = l_datsai, HORFIM = l_horsai, STAACC = 2
            WHERE PLAVEI = l_plavee AND DATINI = l_datent AND HORINI = l_horent AND DATFIM = l_datval;           
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;

        /* Baixar registro na R088CON */
        BEGIN
            SELECT NUMCRA INTO l_cravei FROM R088HCH WHERE PLAVEI = l_plavee AND DATINI = l_datent AND HORINI = l_horent AND DATFIM = l_datsai;
            
            IF (l_numcra <> 0) AND (l_cravei <> 0) THEN
	            SP_VEIPESCON('D', l_cravei, l_numcra, 0 /*p_sitcra*/, l_plavee, l_datval, l_horval, l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdocVis, l_numdocVis);
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
        END;        
    END IF;
    
    /* Trata auditoria de registros */
    /* Saída */    
    BEGIN
        SP_SinAudMVI(1, 0, l_datEnt, l_horEnt, l_seqent,
                      l_tipdocVis, l_numdocVis, 0, 0, 0,
                      l_numcra, 0, '', 0, '',
                      0, 0, '', 0, 0, 
                      l_datsai, 0, '',
                      l_plavee, l_place1, l_place2, l_place3,
                      l_numlau, 0,
                      /*p_numcnh   IN NUMBER(4), p_catcnh   IN VARCHAR2(20), p_vencnh   IN DATE,*/
                      '', 0, '',
                      0, 0, 0, l_codusu, l_datSai, l_horSai, 
                      '',0,0, l_codErr OUT); 
    END;

    IF (l_codErr = 0) THEN
		l_qtdaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
		l_pos := l_pos + 2;
		l_contLoop := 1;

		/* LOOP Acompanhantes */
		WHILE (l_contLoop <= l_qtdaco) LOOP
			l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
			l_pos := l_pos + 2;
			IF (l_tam > 0) THEN
				l_nomaco := SUBSTRING(p_ValStr, l_pos, l_tam);
				l_pos := l_pos + l_tam;
			END IF;

			l_idtpesaco := SUBSTRING(p_ValStr, l_pos, 23);
			l_pos := l_pos + 23;
			
			l_numcraaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
			l_pos := l_pos + 12;
			
			l_contLoop := l_contLoop + 1;
		END LOOP;
		/* FIM - LOOP Acompanhantes */
		
		/** Realiza a saida dos acompanhantes */
		IF(l_qtdaco > 0) THEN
			BEGIN
		  		UPDATE R090ACO SET
					DATSLO = l_datsai,
					HORSLO = l_horsai,
					DATSAI = l_datsai,
					HORSAI = l_horsai				
		  		WHERE
					DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
		  		EXCEPTION
			 		WHEN OTHERS THEN
					l_codErr := 53;
		  	END;
		  	
		  	/** Fecha os históricos de crachá dos acompanhantes */
		  	BEGIN
		  		UPDATE R090HCH SET
					DATFIM = l_datsai,
					HORFIM = l_horsai				
		  		WHERE
					DATINI = l_datent AND HORINI = l_horent AND SEQENT = l_seqent;
		  		EXCEPTION
			 		WHEN OTHERS THEN
					l_codErr := 53;
		  	END;
	    END IF;
	END IF;
    
    /* retorna Código do erro */
    p_retErr := l_codErr;
END		SENIOR;23<SP_STRTODATE
SP_PESFROMIDTPES
SP_VEIPESCON
SP_SinAudMVI
¹:␀␀

/* Processa demanda de sicronismo - 06 = Saida de visitantes (R090MVI)    */
PROCEDURE SP_SINMVI(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

l_datins     DATE;
    l_datstr     VARCHAR2(16);
    l_datSaiStr  VARCHAR2(16);
    l_usocra     NUMBER(2);
    l_numcra     NUMBER(12);
    l_idtvis     VARCHAR2(23);
    l_tam        NUMBER(2);
    l_pos        NUMBER(3);
    l_datsai     DATE;
    l_horsai     NUMBER(4);
    l_plavee     VARCHAR2(10); 
    l_place1     VARCHAR2(10); 
    l_place2     VARCHAR2(10);
    l_place3     VARCHAR2(10);
    l_numlau     VARCHAR2(12);
    l_datent     DATE;
    l_datentaco  DATE;
    l_coderr     NUMBER(2);
    l_datval     DATE;
    l_horval     NUMBER(4);
    l_cravei     NUMBER(12);
    /*Variáveis auxiliares para conversão de data*/
    l_datcon     VARCHAR2(25);
    l_horent     NUMBER(4);
    l_seqent     NUMBER(2);
    l_horentaco  NUMBER(4);
    l_seqentaco  NUMBER(2);
    l_count      NUMBER(1);
    l_tiptpv     NUMBER(4);
    /*Variáveis auxiliares para desmontar IDTPES*/
    l_tippes     NUMBER(2);
    l_numemp     NUMBER(4);
    l_tipcol     NUMBER(1);
    l_numcad     NUMBER(9);
    l_nummat     VARCHAR2(15);
    l_propac     VARCHAR2(20);

    l_tipdocVis  NUMBER(1);
    l_numdocVis  VARCHAR2(20);
    l_data_zero  DATE;
    l_tipvis     VARCHAR2(3);
    l_codusu     NUMBER(10);
    l_codpor     NUMBER(3);
    l_persac     VARCHAR2(1);    
    
    /*acompanhantes*/
	l_qtdaco     NUMBER(2);
	l_nomaco     VARCHAR2(99);
	l_idtpesaco  VARCHAR2(23);
	l_numcraaco  NUMBER(12);
	l_contLoop   NUMBER(2);
BEGIN
    /* inicializa variáveis */
    l_coderr := 0;
    p_RetErr := 0;
    l_data_zero := '31/12/1900,00:00:00';
    l_datins := CURDATE();
    
    /* separa os valores da string do p_valStr em cada variável */
    BEGIN
	    l_pos := 3;    
        l_idtVis := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_numcra := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, l_pos, 12)); l_pos := l_pos + 12;
        l_datstr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
        l_datSaiStr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
        l_plavee := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place1 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place2 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_place3 := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        l_numlau := NULL;
        
        l_tam := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, l_pos, 2)); l_pos := l_pos + 2;        
        IF (l_tam > 0) THEN
            l_numlau := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, l_tam))); l_pos := l_pos + l_tam;

            IF  (l_numlau = '') THEN
              l_numlau := NULL;
            END IF;
        END IF;
        
        /* converte data saída */
        l_datcon := SUBSTRING(l_datSaiStr,1,2) || '/' || SUBSTRING(l_datSaiStr,3,2) ||'/'||SUBSTRING(l_datSaiStr,5,2);
        SP_STRTODATE(l_datcon,'DD/MM/AA', l_datsai OUT);
        l_horsai := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datSaiStr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datSaiStr,9,2)));

        /* desmontar IDTPES do visitante */
        SP_PESFROMIDTPES(l_idtVis, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT, l_tipdocVis OUT, l_numdocVis OUT, l_nummat OUT, l_propac OUT);
        
        /* CODUSU */
        l_codusu := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;

        /* padronizar as placas tirando espaços e traços */
        l_plavee := LTRIM(RTRIM(REPLACE(REPLACE(l_plavee, '-', ''), ' ', '')));
        l_place1 := LTRIM(RTRIM(REPLACE(REPLACE(l_place1, '-', ''), ' ', '')));
        l_place2 := LTRIM(RTRIM(REPLACE(REPLACE(l_place2, '-', ''), ' ', '')));
        l_place3 := LTRIM(RTRIM(REPLACE(REPLACE(l_place3, '-', ''), ' ', '')));
        
        /* por causa do ORACLE que considera '' como NULL e no SQL-SERVER não */
        IF  (l_plavee = '') THEN
          l_plavee := NULL;
        END IF;
        
        IF  (l_place1 = '') THEN
          l_place1 := NULL;
        END IF;
        
        IF  (l_place2 = '') THEN
          l_place2 := NULL;
        END IF;

        IF  (l_place3 = '') THEN
          l_place3 := NULL;
        END IF;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 41; /* erro de conversão na string */
    END;

    BEGIN
        SELECT TipVis, DATENT, HORENT, SEQENT, DATVAL, HORVAL, CODPOR
	      INTO l_tipvis, l_datent, l_horent, l_seqent, l_datval, l_horval, l_codpor
          FROM R090MVI 
         WHERE R090MVI.NUMCRA = l_numcra AND R090MVI.TIPDOC = l_tipdocVis AND R090MVI.NUMDOC = l_numdocVis AND DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;

    BEGIN
        SELECT PERSAC
	      INTO l_persac
          FROM R058POR 
         WHERE R058POR.CODPOR = l_codpor;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    IF (l_codErr = 0) THEN
        /* verificar procedimentos */
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R090PRO WHERE TIPVIS = l_tipvis AND PROVIS = 2 AND CONPRO = 3;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN l_count := 0;
            WHEN TOO_MANY_ROWS THEN l_codErr := 44; l_count := 0;
            WHEN OTHERS THEN l_codErr := 44; l_count := 0;
        END;

        IF (l_count >= 1) AND (l_numlau IS NOT NULL) THEN
            BEGIN
	            SELECT COUNT(*) QNTREG INTO l_count 
	              FROM R090LAU 
	             WHERE datent = l_datent AND horent = l_horent AND seqent = l_seqent;
            EXCEPTION
	            WHEN OTHERS THEN l_codErr := 44;
            END;
        
            IF (l_count = 0) THEN        
                BEGIN
                    INSERT INTO R090LAU (datent, horent, seqent, numlau, regrod, datins)
                         VALUES (l_datent, l_horent, l_seqent, l_numlau, NULL, l_datins);
                EXCEPTION
                    WHEN OTHERS THEN l_coderr := 44;
                END;
            ELSE
              UPDATE R090LAU SET numlau = l_numlau 
               WHERE datent = l_datent AND horent = l_horent AND seqent = l_seqent;            
            END IF;            
        END IF;
    END IF;
        
    BEGIN
        SELECT MIN(tiptpv) INTO l_tiptpv FROM R088TPV;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 46;
    END;
	    
    /* Veículos */
    IF (l_plavee IS NOT NULL) THEN
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_plavee;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;

        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_plavee, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
   	END IF;
	
    IF (l_place1 IS NOT NULL) THEN
   	    BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place1;
        EXCEPTION
   	        WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
   	            INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place1, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
    END IF;
	
    IF (l_place2 IS NOT NULL) THEN
   	    BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place2;
   	    EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place2, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
   	        END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
        END;
    END IF;
	    
    IF (l_place3 IS NOT NULL) THEN
        BEGIN
            SELECT COUNT(*) QNTREG INTO l_count FROM R088VEI WHERE PLAVEI = l_place3;
   	    EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;
	
        BEGIN
            IF (l_count = 0) THEN
                INSERT INTO R088VEI (plavei, tipvei, datinc, horinc, conlpr, obsvei) VALUES (l_place3, l_tiptpv, l_datent, l_horent, 'N', 'Registro inserido em movimentação de veículos realizada em modo de contingência');
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
   	    END;
    END IF;
    
    BEGIN
	    UPDATE R090MVI 
           SET DATSLO = l_datsai, HORSLO = l_horsai, DATSAI = l_datsai, HORSAI = l_horsai, PLAVES = l_plavee, PLACAS = l_place1, PLACS2 = l_place2, PLACS3 = l_place3 
         WHERE R090MVI.NUMCRA = l_numcra AND R090MVI.TIPDOC = l_tipdocVis AND R090MVI.NUMDOC = l_numdocVis AND R090MVI.DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    /* Histórico de crachá */
    BEGIN
	    UPDATE R090HCH 
	    SET DATFIM = l_datsai, HORFIM = l_horsai 
        WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATINI = l_datent AND HORINI= l_horent AND SEQENT = l_seqent AND NUMCRA = l_numcra;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 43;
    END;
    
    /* Atribui os valores de Data/Hora de entrada caso seja acompanhante */
    BEGIN
        SELECT DATENT, HORENT, SEQENT
	      INTO l_datentaco, l_horentaco, l_seqentaco
          FROM R090ACO 
         WHERE R090ACO.NUMCRA = l_numcra AND R090ACO.TIPDOC = l_tipdocVis AND R090ACO.NUMDOC = l_numdocVis AND DATSAI = l_data_zero;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 42;
    END;
    
    /* Se achou o DatEntAco é pq o IDTPES passado foi de um Acompanhante */
    IF (l_datentaco IS NOT NULL) THEN
        /* Acompanhantes */
   	    BEGIN
   		    UPDATE R090ACO 
        	SET DATSLO = l_datsai, HORSLO = l_horsai, DATSAI = l_datsai, HORSAI = l_horsai 
            WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATENT = l_datentaco AND HORENT= l_horentaco AND SEQENT = l_seqentaco AND NUMCRA = l_numcra;
   	    EXCEPTION
       	    WHEN OTHERS THEN l_coderr := 53;
       	END;
   
         /* Histórico de crachá de Acompanhantes */
   	    BEGIN
   		    UPDATE R090HCH 
        	SET DATFIM = l_datsai, HORFIM = l_horsai 
            WHERE TIPDOC = l_tipdocVis AND NUMDOC = l_numdocVis AND DATINI = l_datentaco AND HORINI= l_horentaco AND SEQENT = l_seqentaco AND NUMCRA = l_numcra;
   	    EXCEPTION
       	    WHEN OTHERS THEN l_coderr := 43;
        END;
    END IF;

    IF (l_persac = 'N') THEN
		BEGIN
		    /* Baixar qualquer possivel Acompanhante do "suposto visitante" informado. Se for passado um crachá de Acompanhante no lugar do visitante, nao faz nada */
	  		UPDATE R090ACO SET
				DATSLO = l_datsai,
				HORSLO = l_horsai,
				DATSAI = l_datsai,
				HORSAI = l_horsai				
	  		WHERE
				DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
		EXCEPTION
	 		WHEN OTHERS THEN
				l_codErr := 53;
	  	END;

        /* Histórico de crachá de Acompanhantes */
	    BEGIN
		    UPDATE R090HCH 
       		SET DATFIM = l_datsai, HORFIM = l_horsai 
            WHERE DATINI = l_datent AND HORINI= l_horent AND SEQENT = l_seqent AND DATFIM = l_data_zero;
	    EXCEPTION
   		    WHEN OTHERS THEN l_coderr := 43;
        END;
    END IF;

    IF (l_plavee IS NOT NULL) THEN
        /* Finaliza o histórico de crachá do veículo */        
        BEGIN
            UPDATE R088HCH 
            SET DATFIM = l_datsai, HORFIM = l_horsai, STAACC = 2
            WHERE PLAVEI = l_plavee AND DATINI = l_datent AND HORINI = l_horent AND DATFIM = l_datval;           
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;    
        END;

        /* Baixar registro na R088CON */
        BEGIN
            SELECT NUMCRA INTO l_cravei FROM R088HCH WHERE PLAVEI = l_plavee AND DATINI = l_datent AND HORINI = l_horent AND DATFIM = l_datsai;
            
            IF (l_numcra <> 0) AND (l_cravei <> 0) THEN
	            SP_VEIPESCON('D', l_cravei, l_numcra, 0 /*p_sitcra*/, l_plavee, l_datval, l_horval, l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdocVis, l_numdocVis);
            END IF;
        EXCEPTION
            WHEN OTHERS THEN l_codErr := 46;
        END;        
    END IF;
    
    /* Trata auditoria de registros */
    /* Saída */    
    BEGIN
        SP_SinAudMVI(1, 0, l_datEnt, l_horEnt, l_seqent,
                      l_tipdocVis, l_numdocVis, 0, 0, 0,
                      l_numcra, 0, '', 0, '',
                      0, 0, '', 0, 0, 
                      l_datsai, 0, '',
                      l_plavee, l_place1, l_place2, l_place3,
                      l_numlau, 0,
                      /*p_numcnh   IN NUMBER(4), p_catcnh   IN VARCHAR2(20), p_vencnh   IN DATE,*/
                      '', 0, '',
                      0, 0, 0, l_codusu, l_datSai, l_horSai, 
                      '',0,0, l_codErr OUT); 
    END;

    IF (l_codErr = 0) THEN
		l_qtdaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
		l_pos := l_pos + 2;
		l_contLoop := 1;

		/* LOOP Acompanhantes */
		WHILE (l_contLoop <= l_qtdaco) LOOP
			l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
			l_pos := l_pos + 2;
			IF (l_tam > 0) THEN
				l_nomaco := SUBSTRING(p_ValStr, l_pos, l_tam);
				l_pos := l_pos + l_tam;
			END IF;

			l_idtpesaco := SUBSTRING(p_ValStr, l_pos, 23);
			l_pos := l_pos + 23;
			
			l_numcraaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
			l_pos := l_pos + 12;
			
			l_contLoop := l_contLoop + 1;
		END LOOP;
		/* FIM - LOOP Acompanhantes */
		
		/** Realiza a saida dos acompanhantes */
		IF(l_qtdaco > 0) THEN
			BEGIN
		  		UPDATE R090ACO SET
					DATSLO = l_datsai,
					HORSLO = l_horsai,
					DATSAI = l_datsai,
					HORSAI = l_horsai				
		  		WHERE
					DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
		  		EXCEPTION
			 		WHEN OTHERS THEN
					l_codErr := 53;
		  	END;
		  	
		  	/** Fecha os históricos de crachá dos acompanhantes */
		  	BEGIN
		  		UPDATE R090HCH SET
					DATFIM = l_datsai,
					HORFIM = l_horsai				
		  		WHERE
					DATINI = l_datent AND HORINI = l_horent AND SEQENT = l_seqent;
		  		EXCEPTION
			 		WHEN OTHERS THEN
					l_codErr := 53;
		  	END;
	    END IF;
	END IF;
    
    /* retorna Código do erro */
    p_retErr := l_codErr;
END␀êø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_VER_MODULO_PRP
Â␀␀PROCEDURE SP_SOMENTE_SM_PRP(P_RETORNA OUT BOOLEAN)
 IS

l_TemMod VARCHAR2(2);
  l_TemModSeguranca BOOLEAN; 
  l_TemModMedicina BOOLEAN; 
BEGIN
	p_retorna := TRUE;
	
	RH_VER_MODULO_PRP(1, l_TemMod OUT); /* MÓDULO BENEFÍCIOS */
	IF l_TemMod = 'S' THEN
		p_retorna := FALSE;
	END IF;
		
	RH_VER_MODULO_PRP(2, l_TemMod OUT); /* MÓDULO CARGOS E SALÁRIOS */
	IF l_TemMod = 'S' THEN
		p_retorna := FALSE;
	END IF;

	RH_VER_MODULO_PRP(3, l_TemMod OUT); /* MÓDULO JURÍDICO */
	IF l_TemMod = 'S' THEN
		p_retorna := FALSE;
	END IF;

	RH_VER_MODULO_PRP(4, l_TemMod OUT); /* MÓDULO MEDICINA */
	IF l_TemMod = 'S' THEN
		l_TemModMedicina := TRUE;
	END IF;

	RH_VER_MODULO_PRP(5, l_TemMod OUT); /* MÓDULO PESQUISA */
	IF l_TemMod = 'S' THEN
		p_retorna := FALSE;
	END IF;

	RH_VER_MODULO_PRP(6, l_TemMod OUT); /* MÓDULO PLR */
	IF l_TemMod = 'S' THEN
		p_retorna := FALSE;
	END IF;

	RH_VER_MODULO_PRP(8, l_TemMod OUT); /* MÓDULO RECRUTAMENTO E SELEÇÃO */
	IF l_TemMod = 'S' THEN
		p_retorna := FALSE;
	END IF;

	RH_VER_MODULO_PRP(9, l_TemMod OUT); /* MÓDULO RUBI */
	IF l_TemMod = 'S' THEN
		p_retorna := FALSE;		
	END IF;
	
    RH_VER_MODULO_PRP(10, l_TemMod OUT); /* MÓDULO SEGURANÇA */
	IF l_TemMod = 'S' THEN
	  l_TemModSeguranca	:= TRUE;	
	END IF;
			
    RH_VER_MODULO_PRP(11, l_TemMod OUT); /* MÓDULO TREINAMENTO */
	IF l_TemMod = 'S' THEN
		p_retorna := FALSE;		
	END IF;

    RH_VER_MODULO_PRP(13, l_TemMod OUT); /* MÓDULO TAREFEIROS */ 
	IF l_TemMod = 'S' THEN
		p_retorna := FALSE;
	END IF;

    /* Se tiver apenas Segurança e Medicina */
	IF ((l_TemModMedicina = TRUE) AND (l_TemModSeguranca = TRUE) AND (p_retorna = TRUE)) THEN	
		p_retorna := TRUE;
	END IF;
END␀ëø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Ù

