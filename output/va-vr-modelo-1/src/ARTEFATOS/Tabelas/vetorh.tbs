ù0␀␀create or replace PROCEDURE SP_PORCOM(p_Straux IN VARCHAR2,p_CenPen IN VARCHAR2) IS
  l_retpen CHAR(3);
  l_datenv DATE;
  l_datenv_str CHAR(16);
  l_horenv NUMBER(4);
  l_numfis NUMBER(12);
  l_codcmd NUMBER(3);
  l_CodCmd_Str CHAR(3);
  l_stacmd NUMBER(1);
  l_seqenv NUMBER(2);
  l_numcra NUMBER(12);
  l_idtpes VARCHAR2(23);
  l_CenPen VARCHAR2(255);
  l_codcen NUMBER(2);
  l_dirsvr VARCHAR2(250);
  l_gersen CHAR(1);
  l_cenati CHAR(1);
  l_stacsm NUMBER(1);
  l_porcom VARCHAR2(16);
  l_aux NUMBER(2);
  l_coddsp NUMBER(9);
  l_tipope NUMBER(1);
  l_dat_conv VARCHAR(25);
  l_logpen VARCHAR(2047);
  l_straux VARCHAR2(2047);
  l_CodTraduzido NUMBER(3);
  l_SubCmd NUMBER(5);
  temrlg NUMBER(5);

  cursor c_r058CEN is 
    SELECT 
      R058CEN.DIRSVR DIRSVR, R058CEN.GERSEN GERSEN, R058CEN.CENATI CENATI, R058CEN.STACSM STACSM, R058CEN.CODCEN CODCEN
       FROM R058CEN R058CEN
       WHERE GERSEN='S' 
      AND TIPGER=2;
  c_r058CEN_cnt integer;
  type t_r058cen is record (
    DIRSVR R058CEN.DIRSVR%TYPE,
    GERSEN R058CEN.GERSEN%TYPE,
	CENATI R058CEN.CENATI%TYPE,
    STACSM R058CEN.STACSM%TYPE,
    CODCEN R058CEN.CODCEN%TYPE
  );
  l_r058cen t_r058cen;
begin
  l_datenv := TO_DATE(TO_CHAR(SYSDATE,'DD/MM/YYYY'),'DD/MM/YYYY');
  l_horenv := TO_NUMBER(TO_CHAR(TO_DATE(TO_CHAR(SYSDATE,'HH24:MI:SS'),'HH24:MI:SS'),'HH24'))*60+TO_NUMBER(TO_CHAR(TO_DATE(TO_CHAR(SYSDATE,'HH24:MI:SS'),'HH24:MI:SS'),'MI'));
  l_seqenv := TO_NUMBER(TO_CHAR(TO_DATE(TO_CHAR(SYSDATE,'HH24:MI:SS'),'HH24:MI:SS'),'SS'));
  l_idtpes := '                       ';
  l_numcra := 0;
  l_numfis := 0;
  l_stacmd := 1;
  l_retpen := '001';
  l_tipope := 0;
  begin
    l_codcmd := SUBSTR(p_Straux,1,2);
    
    if (l_codcmd=62) then
      SP_PORCOMDSP(p_Straux, p_CenPen);   
      return;
    end if;
    
    if (l_codcmd = 99) then
      l_SubCmd := SUBSTR(p_Straux,3,5);
    else
      l_SubCmd := 0;
    end if;
  
    SP_TRADUZIRCODCMD(l_CodCmd, l_SubCmd, l_CodTraduzido);
    
    if ((l_codcmd=2) 
      OR (l_codcmd=5) 
      OR (l_codcmd=9) 
      OR (l_codcmd=13) 
      OR (l_codcmd=21) 
      OR (l_codcmd=38) 
      OR (l_codcmd=83)) then
      l_numfis := SUBSTR(p_Straux,19,12);
      if (l_codcmd=21) then
        l_numcra := SUBSTR(p_Straux,69,12);
      end if;
      if (l_codcmd=38) then
        l_numfis := SUBSTR(p_Straux,22,12);
      end if;
      if (l_codcmd=83) then
        l_numcra := SUBSTR(p_Straux,19,12);
        l_numfis := 0;
      end if;
    else
      if ((l_codcmd=1) 
      OR (l_codcmd=3) 
      OR (l_codcmd=4) 
      OR (l_codcmd=8) 
      OR (l_codcmd=19) 
      OR (l_codcmd=22) 
      OR (l_codcmd=23) 
      OR (l_codcmd=24) 
      OR (l_codcmd=25) 
      OR (l_codcmd=26) 
      OR (l_codcmd=27) 
      OR (l_codcmd=60) 
      OR (l_codcmd=63) 
      OR (l_codcmd=82)
      OR (l_codcmd=93) 
      OR (l_codcmd=95)
      OR (l_codcmd=96)) then
        l_idtpes := SUBSTR(p_Straux,19,23);
      else
        if (l_codcmd=12) then
          l_idtpes := SUBSTR(p_Straux,20,23);
        else
          if (l_codcmd=62) then
            l_idtpes := SUBSTR(p_Straux,42,23);
            l_numfis := SUBSTR(p_Straux,29,12);
            l_tipope := SUBSTR(p_Straux,28,1);
            l_datenv_str := SUBSTR(p_Straux,3,16);
            l_dat_conv := SUBSTR(l_datenv_str,1,2)||'/'||SUBSTR(l_datenv_str,3,2)||'/'||SUBSTR(l_datenv_str,5,2);
            SP_STRTODATE(l_dat_conv,'DD/MM/AA',l_datenv);
            l_horenv := TO_NUMBER((SUBSTR(l_datenv_str,7,2)))*60+TO_NUMBER((SUBSTR(l_datenv_str,9,2)));
          else
            if (l_codcmd=75) then
              l_idtpes := SUBSTR(p_Straux,20,23);
              l_numfis := SUBSTR(p_Straux,44,12);
            else
              if (l_codcmd=6) then
                l_idtpes := SUBSTR(p_Straux,3,23);
                l_tipope := SUBSTR(p_Straux,26,1);
              else
                if (l_codcmd=79) then
                  l_idtpes := SUBSTR(p_Straux,3,23);
                else
                  if (l_codcmd=86) then
                    l_idtpes := SUBSTR(p_Straux,59,23);
                  end if;                    
                end if;
              end if;
            end if;
          end if;
        end if;
      end if;
    end if;
    if (l_codcmd=62) then
      begin
        UPDATE R070ADM  SET  STACMD = 7  WHERE IDTPES<>l_idtpes 
      AND NUMFIS=l_numfis 
      AND NUMCRA=l_numcra 
      AND STACMD IN (0,1,5,8,9) 
      AND CODCMD = l_CodTraduzido;
      exception
        when OTHERS then
          NULL;
      end;
    end if;
    if (l_codcmd=19)
      OR (l_codcmd=93)
      OR (l_codcmd=1) 
      OR (l_codcmd=3)	  
      OR ((l_codcmd=62) 
      AND (l_tipope=1)) 
      OR ((l_codcmd=6) 
      AND (l_tipope>1)) then
      if (l_seqenv>1) then
        l_seqenv := l_seqenv-2;
      else
        if (l_horenv>0) then
          l_horenv := l_horenv-1;
          l_seqenv := 59;
        else
          l_datenv := (l_datenv+-1);
          l_horenv := 1439;
          l_seqenv := 59;
        end if;
      end if;
    end if;
  exception
    when OTHERS then
      raise_application_error(-20000 + -(103),'SP_PORCOM: Problemas ao Formatar a Pendência.');
  end;
  
  l_CenPen := p_CenPen;
  l_CenPen := LTRIM(l_CenPen);
  l_CenPen := RTRIM(l_CenPen);
  l_straux := p_Straux;
  if (l_CenPen='0') then
    open c_r058cen;
