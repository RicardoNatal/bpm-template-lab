RH_250ALT(33);
END␀␀␀ªe␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÄÎ␀␀y,Ì␀	Ôï1␀␀␀␀␀\?œeœe)␀␀Æÿ␀␀ÀÎ␀␀␀ş␀␀±␀	Ôï1␀␀␀␀␀£ÿ␀␀xş␀␀xş␀␀q␀Æÿ␀␀ÓÎ␀␀␀Vı␀␀±␀	Ôï1␀␀␀␀␀¨ÿ␀␀xş␀␀xş␀␀q␀Æÿ␀␀ÿ␀³,´␀Ôï1␀␀␀␀␀’@ìz	{r␀Æÿ␀␀fÎ␀␀␀␀␀␀0;1;2ÊÎ␀␀	SENIOR;0␀␀


/* Trigger Insert - Statement */
TRIGGER R006HBA_SI AFTER INSERT ON R006HBA
DECLARE
  /* CURSOR c/ os registros gravados na r006hba_aux */
  CURSOR c_r006hba_aux_ins IS
  SELECT CODESC, SEQREG, SEQHOP, CODHOP FROM R006HBA_AUX;
  TYPE t_r006hba_aux IS RECORD(
    CODESC   R006HBA_AUX.CODESC%TYPE,
    SEQREG   R006HBA_AUX.SEQREG%TYPE,
    SEQHOP   R006HBA_AUX.SEQHOP%TYPE,
    CODHOP   R006HBA_AUX.CODHOP%TYPE);
  l_r006hba_aux t_r006hba_aux;
  l_horario   R006HBA.CodHop%TYPE;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r006hba_aux_ins INTO l_r006hba_aux.CODESC,
    							 l_r006hba_aux.SEQREG,
    							 l_r006hba_aux.SEQHOP,
    							 l_r006hba_aux.CODHOP
  LOOP
	l_horario := IFNULL(l_r006hba_aux.CODHOP, 0);
	RH_ATUALIZAR006HOR(l_r006hba_aux.CODESC, l_r006hba_aux.SEQREG, l_r006hba_aux.SEQHOP, l_horario);
  END LOOP;
  
  /* Apaga Registro OLD/NEW em R006HBA_AUX */
  BEGIN
    DELETE FROM R006HBA_AUX;
    DROP_TEMP_TABLE R006HBA_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ÇÎ␀␀		SENIOR;0Á␀␀TRIGGER R006HBA_EI AFTER INSERT ON R006HBA FOR EACH ROW
DECLARE
  /* Declaracao para criar tabela temporária em SQL Server - Erros de DeadLock */
  CREATE_TEMP_TABLE R006HBA_AUX;
BEGIN
	BEGIN
	  /* Insere Registro NEW */
    	INSERT INTO R006HBA_AUX (CODESC, SEQREG, SEQHOP, CODHOP) VALUES (:NEW.CODESC, :NEW.SEQREG, :NEW.SEQHOP, :NEW.CODHOP);
  	EXCEPTION WHEN OTHERS THEN
    	RAISERROR 103 'Erro no INSERT em R006HBA_AUX.';
  	END;
END␀ËÎ␀␀	SENIOR;0␀␀



