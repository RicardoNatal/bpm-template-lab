TRIGGER R140NPC_EI AFTER INSERT ON R140NPC FOR EACH ROW

BEGIN
/* Inclui Itens de Notas por Participante */
     BEGIN
          INSERT R140NPA (CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, CODTNT, NOTPAR)
                  SELECT :NEW.CODCUA, :NEW.TMACUA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, R134DTN.CODTNT, 0
                    FROM R134DTN, R140NTR WHERE CODCUA = :NEW.CODCUA AND TMACUA = :NEW.TMACUA
                                            AND R134DTN.CODTNT = R140NTR.CODTNT AND R140NTR.TIPTNT = 'P';
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Inclusão dos Itens de Notas para os Participantes.';
     END;

     /* Inclui Itens de Notas por Curso */
     BEGIN
          INSERT R140NCU (CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, CODTNT, NOTCUR)
          SELECT :NEW.CODCUA, :NEW.TMACUA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, R134DTN.CODTNT, 0
            FROM R134DTN, R140NTR WHERE CODCUA = :NEW.CODCUA AND TMACUA = :NEW.TMACUA
                                    AND R134DTN.CODTNT = R140NTR.CODTNT AND R140NTR.TIPTNT = 'C';
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Inclusão dos Itens de Notas para os Cursos.';
     END;
END␀tâ␀␀	SENIOR;0Ã]␀␀

/* Atualiza o Histórico de Curso dos Participantes */
TRIGGER R140NPC_SU AFTER UPDATE ON R140NPC

DECLARE
l_nrohis       NUMBER(10);
  l_SeqHcr         R124HCR.SEQHCR%TYPE;
  l_DatIni         R124HCR.PERINI%TYPE;
  l_DatFim         R124HCR.PERFIM%TYPE;
  l_CodOem         R124HCR.CODOEM%TYPE;
  l_CarHor         R124HCR.CARHOR%TYPE;
  l_MedCua         R124HCR.MEDCUA%TYPE;
  l_FreCua         R124HCR.FRECUA%TYPE;
  l_TipCer         R124HCR.TIPCER%TYPE;
  l_TipTre         R124HCR.TIPTRE%TYPE;
  l_QtdAul         R134DTU.QTDAUL%TYPE;
  l_TipCnf         R134DTU.TIPCNF%TYPE;
  l_TipCua         R128CUA.TIPCUA%TYPE;
  l_ConFre         R128CUA.CONFRE%TYPE;
  xSeqReg        NUMBER(3);
  
  CREATE_TEMP_TABLE R140NPC_AUX2;  

  CURSOR C_R140NPC_up1 IS SELECT CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, QTDFAL, TIPCER, NUMCER,
                                  SITCUA, CODMIN, FALOLD, SITOLD, MINOLD, CEROLD, TIPOPE, HORFAL, HOROLD
                             FROM R140NPC_AUX2 WHERE SEQREG = 1 AND TIPOPE = 'U';
  CURSOR C_R140NPC_up2 IS SELECT CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, QTDFAL, TIPCER, NUMCER,
                                  SITCUA, CODMIN, FALOLD, SITOLD, MINOLD, CEROLD, TIPOPE, HORFAL, HOROLD
                             FROM R140NPC_AUX2 WHERE SEQREG = 2 AND TIPOPE = 'U';

  TYPE t_r140NPC_aux IS RECORD(
      CODCUA   R140NPC_AUX.CODCUA%TYPE,
      TMACUA   R140NPC_AUX.TMACUA%TYPE,
      NUMEMP   R140NPC_AUX.NUMEMP%TYPE,
      TIPCOL   R140NPC_AUX.TIPCOL%TYPE,
      NUMCAD   R140NPC_AUX.NUMCAD%TYPE,
      QTDFAL   R140NPC_AUX.QTDFAL%TYPE,
      TIPCER   R140NPC_AUX.TIPCER%TYPE,
      NUMCER   R140NPC_AUX.NUMCER%TYPE,
      SITCUA   R140NPC_AUX.SITCUA%TYPE,
      CODMIN   R140NPC_AUX.CODMIN%TYPE,
      FALOLD   R140NPC_AUX.FALOLD%TYPE,
      SITOLD   R140NPC_AUX.SITOLD%TYPE,
      MINOLD   R140NPC_AUX.MINOLD%TYPE,
      CEROLD   R140NPC_AUX.CEROLD%TYPE,
      TIPOPE   R140NPC_AUX.TIPOPE%TYPE,
      HORFAL   R140NPC_AUX.HORFAL%TYPE,
      HOROLD   R140NPC_AUX.HOROLD%TYPE,
      SITARE   R140NPC_AUX.SITARE%TYPE);

  l_r140NPC_aux t_r140NPC_aux;

  CURSOR C_R124HCR_sel IS SELECT SEQHCR FROM R124HCR
                           WHERE NUMEMP = l_r140NPC_aux.NUMEMP AND TIPCOL = l_r140NPC_aux.TIPCOL
                             AND NUMCAD = l_r140NPC_aux.NUMCAD AND CODCUA = l_r140NPC_aux.CODCUA
                        ORDER BY SEQHCR;
                        
  CURSOR C_R140NPC_AUX IS SELECT CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, QTDFAL, TIPCER, NUMCER, SITCUA, CODMIN, FALOLD, SITOLD, MINOLD, CEROLD, TIPOPE, HORFAL, HOROLD, SITARE
                        FROM R140NPC_AUX WHERE TIPOPE = 'U';

  TYPE t_r124hcr_aux IS RECORD(
      SEQHCR   R124HCR.SEQHCR%TYPE);

  l_r124hcr_aux t_r124hcr_aux;  

BEGIN

  /* Nesta Trigger os dados da AUX estão sendo inseridos na AUX2 porque os processamentos desta trigger disparam
     Triggers de outras tabelas que podem efetuar um UPDATE (segundo update) nesta mesma Tabela. Se isto acontecesse ]
     e tivesse algum registro na AUX, as triggers entrariam em LOOP porque a Trigger de statement daquele
     segundo update pegaria os registros processados pelo primeiro UPDATE.
     Jogando os valores para a AUX2 com uma sequencia, isto não mais acontecerá. */
     
  /* Busca a maior sequencia da AUX */
  BEGIN
    SELECT IFNULL(MAX(SEQREG), 0) INTO xSeqReg FROM R140NPC_AUX2;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      xSeqReg := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na Busca da sequencia da R140NPC_AUX';
  END;

  /* Incrementa a sequencia para incluir registros com a mesma. */
  xSeqReg := xSeqReg + 1;
  
  /* Le Registro da AUX para inserir na AUX2 com a sequencia */
  FOREACH C_R140NPC_AUX INTO l_r140NPC_aux.CODCUA,
                             l_r140NPC_aux.TMACUA,
                             l_r140NPC_aux.NUMEMP,
                             l_r140NPC_aux.TIPCOL,
                             l_r140NPC_aux.NUMCAD,
                             l_r140NPC_aux.QTDFAL,
                             l_r140NPC_aux.TIPCER,
                             l_r140NPC_aux.NUMCER,
                             l_r140NPC_aux.SITCUA,
                             l_r140NPC_aux.CODMIN,
                             l_r140NPC_aux.FALOLD,
                             l_r140NPC_aux.SITOLD,
                             l_r140NPC_aux.MINOLD,
                             l_r140NPC_aux.CEROLD,
                             l_r140NPC_aux.TIPOPE,
                             l_r140NPC_aux.HORFAL,
                             l_r140NPC_aux.HOROLD,
                             l_r140NPC_aux.SITARE
    LOOP
    BEGIN
      INSERT INTO R140NPC_AUX2 (SEQREG, CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, QTDFAL, TIPCER, NUMCER, SITCUA, CODMIN, FALOLD, SITOLD, MINOLD, CEROLD, TIPOPE, SITARE, HORFAL, HOROLD)
         VALUES (xSeqReg, l_r140npc_aux.CODCUA, l_r140npc_aux.TMACUA, l_r140npc_aux.NUMEMP, l_r140npc_aux.TIPCOL, l_r140npc_aux.NUMCAD, l_r140npc_aux.QTDFAL, l_r140npc_aux.TIPCER, l_r140npc_aux.NUMCER, l_r140npc_aux.SITCUA, l_r140npc_aux.CODMIN, l_r140npc_aux.FALOLD, l_r140npc_aux.SITOLD, l_r140npc_aux.MINOLD, l_r140npc_aux.CEROLD, l_r140npc_aux.TIPOPE, l_r140npc_aux.SITARE, l_r140npc_aux.HORFAL, l_r140npc_aux.HOROLD);
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no INSERT na R140NPC_AUX2.';
    END;                      
  END LOOP;

  /* Apaga Registro OLD em R140NPC_AUX */
  BEGIN
    DELETE FROM R140NPC_AUX WHERE TIPOPE = 'U';
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;

  /* Le Registro do CURSOR - AUX2*/
  IF (xSeqReg = 1) THEN
    FOREACH C_R140NPC_up1 INTO l_r140NPC_aux.CODCUA,
                               l_r140NPC_aux.TMACUA,
                               l_r140NPC_aux.NUMEMP,
                               l_r140NPC_aux.TIPCOL,
                               l_r140NPC_aux.NUMCAD,
                               l_r140NPC_aux.QTDFAL,
                               l_r140NPC_aux.TIPCER,
                               l_r140NPC_aux.NUMCER,
                               l_r140NPC_aux.SITCUA,
                               l_r140NPC_aux.CODMIN,
                               l_r140NPC_aux.FALOLD,
                               l_r140NPC_aux.SITOLD,
                               l_r140NPC_aux.MINOLD,
                               l_r140NPC_aux.CEROLD,
                               l_r140NPC_aux.TIPOPE,
                               l_r140NPC_aux.HORFAL,
                               l_r140NPC_aux.HOROLD
    LOOP
       IF   (IFNULL(l_r140NPC_aux.FALOLD,0) <> IFNULL(l_r140NPC_aux.QTDFAL,0)) OR
            (IFNULL(l_r140NPC_aux.HOROLD,0) <> IFNULL(l_r140NPC_aux.HORFAL,0)) OR
            (IFNULL(l_r140NPC_aux.SITOLD,0) <> IFNULL(l_r140NPC_aux.SITCUA,0)) OR
            ((IFNULL(l_r140NPC_aux.SITOLD,0) = IFNULL(l_r140NPC_aux.SITCUA,0)) AND (IFNULL(l_r140NPC_aux.MINOLD,0) <> IFNULL(l_r140NPC_aux.CODMIN,0))) OR
            (IFNULL(l_r140NPC_aux.CEROLD,' ') <> IFNULL(l_r140NPC_aux.TIPCER,' ')) THEN

            /* Busca se a Turma é do tipo Modular e qual é a forma de controle de frequência */
            SELECT IFNULL(TIPCUA,' '), IFNULL(CONFRE,0) INTO l_TipCua, l_ConFre FROM R128CUA WHERE R128CUA.CODCUA = l_r140NPC_aux.CODCUA;

            /* Busca os dados da Turma */
            SELECT DATINI, DATFIM, CODFES, IFNULL(CARHOR,0), IFNULL(QTDAUL,0), TIPCNF, TIPTRE INTO l_DatIni, l_DatFim, l_CodOem, l_CarHor, l_QtdAul, l_TipCnf, l_TipTre
              FROM R134DTU WHERE R134DTU.CODCUA = l_r140NPC_aux.CODCUA AND R134DTU.TMACUA = l_r140NPC_aux.TMACUA;

            /* Se for uma Turma Modular, a Data inicial e final são as que estão na 134DRE */
            IF (l_TipCua = 'S') THEN
              BEGIN
                SELECT DATINS, DATTER INTO l_DatIni, l_DatFim FROM R134DRE
                 WHERE CODCUA = l_r140NPC_aux.CODCUA AND TMACUA = l_r140NPC_aux.TMACUA AND
                       NUMEMP = l_r140NPC_aux.NUMEMP AND TIPCOL = l_r140NPC_aux.TIPCOL AND NUMCAD = l_r140NPC_aux.NUMCAD;
              EXCEPTION
                WHEN NO_DATA_FOUND THEN
                  l_DatIni := '31/12/1900,00:00:00';
                  l_DatFim := '31/12/1900,00:00:00';
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro na Busca do Participante da Turma';
              END;
            END IF;

            /* Se a turma for de um tipo maior que 2, não altera histórico */
            IF   (l_TipCnf < 3) THEN
                 /* Se a Situação for diferente de 7 atualiza o Histórico, senão exclui o mesmo */
                 IF   (IFNULL(l_r140NPC_aux.SITCUA,0) <> 7) THEN

                      /* Se o Tipo do Certificado for N, então deve gravar branco no Histórico */
                      IF   IFNULL(l_r140NPC_aux.TIPCER,' ') = 'N' THEN
                           l_TipCer := ' ';
                      ELSE
                           l_TipCer := l_r140NPC_aux.TIPCER;
                      END IF;

                      l_FreCua := 0;
                      l_MedCua := 0;
                      IF (l_TipCua <> 'S') AND (IFNULL(l_r140NPC_aux.SITCUA,0) <> 1) THEN
                           /* Calcula Frequencia somente se o Participante tiver Certificado A ou P */
                           /* Calcula a frequência pela quantidade de aulas */
                           IF   (l_ConFre = 0) THEN
                                IF   (l_QtdAul <> 0) THEN
                                     l_FreCua := 100 - (IFNULL(l_r140NPC_aux.QTDFAL,0) * 100) / l_QtdAul;
                                END IF;
                           ELSE
                           /* Calcula a frequência pela carga horária */
                                IF   (l_CarHor <> 0) THEN
                                     l_FreCua := 100 - (IFNULL(l_r140NPC_aux.HORFAL,0) * 100) / l_CarHor;
                                END IF;
                           END IF;

                           /* Calcula a média do Participante */
                           TR_CALCMEDIA(l_r140NPC_aux.CODCUA, l_r140NPC_aux.TMACUA,
                                        l_r140NPC_aux.NUMEMP, l_r140NPC_aux.TIPCOL,
                                        l_r140NPC_aux.NUMCAD, l_MedCua OUT);
                      END IF;

                      /* Verifica se já existe histórico deste curso para este candidato */
                      BEGIN
                           SELECT COUNT(*) INTO l_nrohis FROM R124HCR
                            WHERE NUMEMP = l_r140NPC_aux.NUMEMP AND TIPCOL = l_r140NPC_aux.TIPCOL AND NUMCAD = l_r140NPC_aux.NUMCAD
                              AND CODCUA = l_r140NPC_aux.CODCUA AND TMACUA = l_r140NPC_aux.TMACUA;
                      EXCEPTION
                           WHEN NO_DATA_FOUND THEN
                                l_nrohis := 0;
                      END;

                      /* Se nao existe Histórico, inclui o mesmo na tabela */
                      IF   l_nrohis = 0 THEN
                           /* Verifica qual é a menor sequencia cadastrada para este curso neste colaborador */
                           l_SeqHcr := 1;
                           FOREACH C_R124HCR_SEL INTO l_r124hcr_aux.SEQHCR
                           LOOP
                                IF   (l_SeqHcr < l_r124hcr_aux.SEQHCR) THEN
                                     EXIT;
                                END IF;
                                l_SeqHcr := l_SeqHcr + 1;
                           END LOOP;

                           BEGIN
                                INSERT R124HCR (NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, PERINI, PERFIM, CODOEM, SITCUA, CODMIN, TIPCER, MEDCUA, FRECUA, CARHOR, FASCUA, COMCUA, INDVCT, IDILEI, IDIESC, IDICON, ORIHCR, IDICUA, TMACUA, TIPTRE)
                                        VALUES (l_r140NPC_aux.NUMEMP, l_r140NPC_aux.TIPCOL, l_r140NPC_aux.NUMCAD, l_r140NPC_aux.CODCUA, l_SeqHcr, l_DatIni, l_DatFim, l_CodOem, l_r140NPC_aux.SITCUA, l_r140NPC_aux.CODMIN, l_TipCer, l_MedCua, l_FreCua, l_CarHor, ' ', ' ', ' ', ' ', ' ', ' ', 'T', 'C', l_r140NPC_aux.TMACUA, l_TipTre);
                           EXCEPTION
                                WHEN OTHERS THEN
                                     RAISERROR 103 'Erro na Inclusão do Histórico de Curso do Participante.';
                           END;
                      ELSE
                        IF (l_TipCua <> 'S') THEN
                          BEGIN
                            UPDATE R124HCR SET TIPCER = l_TipCer, FRECUA = l_FreCua, MEDCUA = l_MedCua, SITCUA = l_r140NPC_aux.SITCUA, CODMIN = l_r140NPC_aux.CODMIN, ORIHCR = 'T'
                             WHERE NUMEMP = l_r140NPC_aux.NUMEMP AND TIPCOL = l_r140NPC_aux.TIPCOL AND NUMCAD = l_r140NPC_aux.NUMCAD
                               AND CODCUA = l_r140NPC_aux.CODCUA AND TMACUA = l_r140NPC_aux.TMACUA;
                          EXCEPTION
                            WHEN OTHERS THEN
                              RAISERROR 103 'Erro na Atualização do Histórico de Curso do Participante.';
                          END;
                        ELSE
                          BEGIN
                            UPDATE R124HCR SET TIPCER = l_TipCer, SITCUA = l_r140NPC_aux.SITCUA, CODMIN = l_r140NPC_aux.CODMIN, ORIHCR = 'T'
                             WHERE NUMEMP = l_r140NPC_aux.NUMEMP AND TIPCOL = l_r140NPC_aux.TIPCOL AND NUMCAD = l_r140NPC_aux.NUMCAD
                               AND CODCUA = l_r140NPC_aux.CODCUA AND TMACUA = l_r140NPC_aux.TMACUA;
                          EXCEPTION
                            WHEN OTHERS THEN
                              RAISERROR 103 'Erro na Atualização do Histórico de Curso do Participante.';
                          END;
                        END IF;
                      END IF;
                 ELSE
                      BEGIN
                           DELETE FROM R124HCR WHERE CODCUA = l_r140NPC_aux.CODCUA AND NUMEMP = l_r140NPC_aux.NUMEMP
                                                 AND TIPCOL = l_r140NPC_aux.TIPCOL AND NUMCAD = l_r140NPC_aux.NUMCAD
                                                 AND TMACUA = l_r140NPC_aux.TMACUA;
                      EXCEPTION
                           WHEN OTHERS THEN
                                RAISERROR 103 'Erro na Exclusão do Histórico de Curso do Participante.';
                      END;
                 END IF;
            END IF;
       END IF;
    END LOOP;
  ELSE
    FOREACH C_R140NPC_up2 INTO l_r140NPC_aux.CODCUA,
                               l_r140NPC_aux.TMACUA,
                               l_r140NPC_aux.NUMEMP,
                               l_r140NPC_aux.TIPCOL,
                               l_r140NPC_aux.NUMCAD,
                               l_r140NPC_aux.QTDFAL,
                               l_r140NPC_aux.TIPCER,
                               l_r140NPC_aux.NUMCER,
                               l_r140NPC_aux.SITCUA,
                               l_r140NPC_aux.CODMIN,
                               l_r140NPC_aux.FALOLD,
                               l_r140NPC_aux.SITOLD,
                               l_r140NPC_aux.MINOLD,                               
                               l_r140NPC_aux.CEROLD,
                               l_r140NPC_aux.TIPOPE,
                               l_r140NPC_aux.HORFAL,
                               l_r140NPC_aux.HOROLD
    LOOP
       IF   (IFNULL(l_r140NPC_aux.FALOLD,0) <> IFNULL(l_r140NPC_aux.QTDFAL,0)) OR
            (IFNULL(l_r140NPC_aux.HOROLD,0) <> IFNULL(l_r140NPC_aux.HORFAL,0)) OR
            (IFNULL(l_r140NPC_aux.SITOLD,0) <> IFNULL(l_r140NPC_aux.SITCUA,0)) OR
            ((IFNULL(l_r140NPC_aux.SITOLD,0) = IFNULL(l_r140NPC_aux.SITCUA,0)) AND (IFNULL(l_r140NPC_aux.MINOLD,0) <> IFNULL(l_r140NPC_aux.CODMIN,0))) OR
            (IFNULL(l_r140NPC_aux.CEROLD,' ') <> IFNULL(l_r140NPC_aux.TIPCER,' ')) THEN

            /* Busca se a Turma é do tipo Modular */
            SELECT IFNULL(TIPCUA,' '), IFNULL(CONFRE,0) INTO l_TipCua, l_ConFre FROM R128CUA WHERE R128CUA.CODCUA = l_r140NPC_aux.CODCUA;

            /* Busca os dados da Turma */
            SELECT DATINI, DATFIM, CODFES, IFNULL(CARHOR,0), IFNULL(QTDAUL,0), TIPCNF, TIPTRE INTO l_DatIni, l_DatFim, l_CodOem, l_CarHor, l_QtdAul, l_TipCnf, l_TipTre
              FROM R134DTU WHERE R134DTU.CODCUA = l_r140NPC_aux.CODCUA AND R134DTU.TMACUA = l_r140NPC_aux.TMACUA;

            /* Se for uma Turma Modular, a Data inicial e final são as que estão na 134DRE */
            IF (l_TipCua = 'S') THEN
              BEGIN
                SELECT DATINS, DATTER INTO l_DatIni, l_DatFim FROM R134DRE
                 WHERE CODCUA = l_r140NPC_aux.CODCUA AND TMACUA = l_r140NPC_aux.TMACUA AND
                       NUMEMP = l_r140NPC_aux.NUMEMP AND TIPCOL = l_r140NPC_aux.TIPCOL AND NUMCAD = l_r140NPC_aux.NUMCAD;
              EXCEPTION
                WHEN NO_DATA_FOUND THEN
                  l_DatIni := '31/12/1900,00:00:00';
                  l_DatFim := '31/12/1900,00:00:00';
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro na Busca do Participante da Turma';
              END;
            END IF;

            /* Se a turma for de um tipo maior que 2, não altera histórico */
            IF   (l_TipCnf < 3) THEN
                 /* Se a Situação for diferente de 7 atualiza o Histórico, senão exclui o mesmo */
                 IF   (IFNULL(l_r140NPC_aux.SITCUA,0) <> 7) THEN

                      /* Se o Tipo do Certificado for N, então deve gravar branco no Histórico */
                      IF   IFNULL(l_r140NPC_aux.TIPCER,' ') = 'N' THEN
                           l_TipCer := ' ';
                      ELSE
                           l_TipCer := l_r140NPC_aux.TIPCER;
                      END IF;

                      l_FreCua := 0;
                      l_MedCua := 0;
                      IF (l_TipCua <> 'S') AND (IFNULL(l_r140NPC_aux.SITCUA,0) <> 1) THEN
                           /* Calcula Frequencia somente se o Participante tiver Certificado A ou P */
                           /* Calcula a frequência pela quantidade de aulas */
                           IF   (l_ConFre = 0) THEN
                                IF   (l_QtdAul <> 0) THEN
                                     l_FreCua := 100 - (IFNULL(l_r140NPC_aux.QTDFAL,0) * 100) / l_QtdAul;
                                END IF;
                           ELSE
                           /* Calcula a frequência pela carga horária */
                                IF   (l_CarHor <> 0) THEN
                                     l_FreCua := 100 - (IFNULL(l_r140NPC_aux.HORFAL,0) * 100) / l_CarHor;
                                END IF;
                           END IF;

                           /* Calcula a média do Participante */
                           TR_CALCMEDIA(l_r140NPC_aux.CODCUA, l_r140NPC_aux.TMACUA,
                                        l_r140NPC_aux.NUMEMP, l_r140NPC_aux.TIPCOL,
                                        l_r140NPC_aux.NUMCAD, l_MedCua OUT);
                      END IF;

                      /* Verifica se já existe histórico deste curso para este candidato */
                      BEGIN
                           SELECT COUNT(*) INTO l_nrohis FROM R124HCR
                            WHERE NUMEMP = l_r140NPC_aux.NUMEMP AND TIPCOL = l_r140NPC_aux.TIPCOL AND NUMCAD = l_r140NPC_aux.NUMCAD
                              AND CODCUA = l_r140NPC_aux.CODCUA AND TMACUA = l_r140NPC_aux.TMACUA;
                      EXCEPTION
                           WHEN NO_DATA_FOUND THEN
                                l_nrohis := 0;
                      END;

                      /* Se nao existe Histórico, inclui o mesmo na tabela */
                      IF   l_nrohis = 0 THEN
                           /* Verifica qual é a menor sequencia cadastrada para este curso neste colaborador */
                           l_SeqHcr := 1;
                           FOREACH C_R124HCR_SEL INTO l_r124hcr_aux.SEQHCR
                           LOOP
                                IF   (l_SeqHcr < l_r124hcr_aux.SEQHCR) THEN
                                     EXIT;
                                END IF;
                                l_SeqHcr := l_SeqHcr + 1;
                           END LOOP;

                           BEGIN
                                INSERT R124HCR (NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, PERINI, PERFIM, CODOEM, SITCUA, CODMIN, TIPCER, MEDCUA, FRECUA, CARHOR, FASCUA, COMCUA, INDVCT, IDILEI, IDIESC, IDICON, ORIHCR, IDICUA, TMACUA, TIPTRE)
                                        VALUES (l_r140NPC_aux.NUMEMP, l_r140NPC_aux.TIPCOL, l_r140NPC_aux.NUMCAD, l_r140NPC_aux.CODCUA, l_SeqHcr, l_DatIni, l_DatFim, l_CodOem, l_r140NPC_aux.SITCUA, l_r140NPC_aux.CODMIN, l_TipCer, l_MedCua, l_FreCua, l_CarHor, ' ', ' ', ' ', ' ', ' ', ' ', 'T', 'C', l_r140NPC_aux.TMACUA, l_TipTre);
                           EXCEPTION
                                WHEN OTHERS THEN
                                     RAISERROR 103 'Erro na Inclusão do Histórico de Curso do Participante.';
                           END;
                      ELSE
                        IF (l_TipCua <> 'S') THEN
                          BEGIN
                            UPDATE R124HCR SET TIPCER = l_TipCer, FRECUA = l_FreCua, MEDCUA = l_MedCua, SITCUA = l_r140NPC_aux.SITCUA, CODMIN = l_r140NPC_aux.CODMIN, ORIHCR = 'T', TIPTRE = l_TipTre
                             WHERE NUMEMP = l_r140NPC_aux.NUMEMP AND TIPCOL = l_r140NPC_aux.TIPCOL AND NUMCAD = l_r140NPC_aux.NUMCAD
                               AND CODCUA = l_r140NPC_aux.CODCUA AND TMACUA = l_r140NPC_aux.TMACUA;
                          EXCEPTION
                            WHEN OTHERS THEN
                              RAISERROR 103 'Erro na Atualização do Histórico de Curso do Participante.';
                          END;
                        ELSE
                          BEGIN
                            UPDATE R124HCR SET TIPCER = l_TipCer, SITCUA = l_r140NPC_aux.SITCUA, CODMIN = l_r140NPC_aux.CODMIN, ORIHCR = 'T', TIPTRE = l_TipTre
                             WHERE NUMEMP = l_r140NPC_aux.NUMEMP AND TIPCOL = l_r140NPC_aux.TIPCOL AND NUMCAD = l_r140NPC_aux.NUMCAD
                               AND CODCUA = l_r140NPC_aux.CODCUA AND TMACUA = l_r140NPC_aux.TMACUA;
                          EXCEPTION
                            WHEN OTHERS THEN
                              RAISERROR 103 'Erro na Atualização do Histórico de Curso do Participante.';
                          END;
                        END IF;
                      END IF;
                 ELSE
                      BEGIN
                           DELETE FROM R124HCR WHERE CODCUA = l_r140NPC_aux.CODCUA AND NUMEMP = l_r140NPC_aux.NUMEMP
                                                 AND TIPCOL = l_r140NPC_aux.TIPCOL AND NUMCAD = l_r140NPC_aux.NUMCAD
                                                 AND TMACUA = l_r140NPC_aux.TMACUA;
                      EXCEPTION
                           WHEN OTHERS THEN
                                RAISERROR 103 'Erro na Exclusão do Histórico de Curso do Participante.';
                      END;
                 END IF;
            END IF;
       END IF;
    END LOOP;
  END IF;
  
  BEGIN
    /* Limpar tabela auxiliar */
    DELETE FROM R140NPC_AUX;
    DROP_TEMP_TABLE R140NPC_AUX;
    EXCEPTION WHEN OTHERS THEN
	    RAISERROR 103 'Erro ao excluir registros da tabela R140NPC_AUX';
  END;  

  BEGIN
    /* Limpar tabela auxiliar */
    DELETE FROM R140NPC_AUX2;
    DROP_TEMP_TABLE R140NPC_AUX2;
    EXCEPTION WHEN OTHERS THEN
	    RAISERROR 103 'Erro ao excluir registros da tabela R140NPC_AUX2';
  END; 
END␀sâ␀␀		SENIOR;08␀␀

/* Inclui o registro da R140NPC na AUX para processar o registro */
TRIGGER R140NPC_EU AFTER UPDATE ON R140NPC FOR EACH ROW
DECLARE
  CREATE_TEMP_TABLE R140NPC_AUX;
BEGIN

IF ((:OLD.TIPCER <> 'X') AND (:OLD.TIPCER <> 'Y') AND (:OLD.TIPCER <> 'Z') AND (:OLD.TIPCER <> 'W') AND
      (:NEW.TIPCER <> 'X') AND (:NEW.TIPCER <> 'Y') AND (:NEW.TIPCER <> 'Z') AND (:NEW.TIPCER <> 'W')) AND
     ((:NEW.NUMEMP = :OLD.NUMEMP) AND
      (:NEW.TIPCOL = :OLD.TIPCOL) AND
      (:NEW.NUMCAD = :OLD.NUMCAD)) THEN
    BEGIN
      INSERT INTO R140NPC_AUX (CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, QTDFAL, TIPCER, NUMCER, SITCUA, CODMIN, FALOLD, SITOLD, MINOLD, CEROLD, TIPOPE, SITARE, HORFAL, HOROLD)
                       VALUES (:NEW.CODCUA, :NEW.TMACUA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.QTDFAL, :NEW.TIPCER, :NEW.NUMCER, :NEW.SITCUA, :NEW.CODMIN, :OLD.QTDFAL, :OLD.SITCUA, :OLD.CODMIN, :OLD.TIPCER, 'U', :OLD.SITARE, :NEW.HORFAL, :OLD.HORFAL);
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no delete na R140NPC_AUX.';
    END;
  END IF;
END␀qâ␀␀		SENIOR;0|␀␀

TRIGGER R140NPC_ED AFTER DELETE ON R140NPC FOR EACH ROW

BEGIN
/* Exclui Itens de Notas por Participante */
     BEGIN
          DELETE FROM R140NPA WHERE CODCUA = :OLD.CODCUA AND TMACUA = :OLD.TMACUA AND
                                    NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD =  :OLD.NUMCAD;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Exclusão dos Itens de Notas dos Participantes.';
     END;

     /* Exclui Itens de Notas por Curso */
     BEGIN
          DELETE FROM R140NCU WHERE CODCUA = :OLD.CODCUA AND TMACUA = :OLD.TMACUA AND
                                    NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD =  :OLD.NUMCAD;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Exclusão dos Itens de Notas dos Cursos.';
     END;
     /* Exclui Comentários do participante do Curso*/
     BEGIN
          DELETE FROM R134COM WHERE CODCUA = :OLD.CODCUA AND TMACUA = :OLD.TMACUA AND
                                    NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD =  :OLD.NUMCAD;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Exclusão dos Comentários do Participante.';
     END;
     /* Exclui Exceções do participante do Curso*/
     BEGIN
          DELETE FROM R134EDR WHERE CODCUA = :OLD.CODCUA AND TMACUA = :OLD.TMACUA AND
                                    NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD =  :OLD.NUMCAD;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Exclusão das Exceções do Participante.';
     END;
END␀␀␀óp␀␀␀␀␀␀␀␀␀␀␀␀␀␀oâ␀␀Y,Ì␀€␀␀␀␀␀␀?@V9Y9{␀Æÿ␀␀ÿ␀â␀¼␀€␀␀␀␀␀␀'>Ì␀Ì␀v␀Æÿ␀␀ÿ␀…¬␀␀´␀€␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t€␀␀␀␀␀␀Ç␀t␀ë␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀€␀␀␀␀␀␀X%W»␀␀®$w␀Æÿ␀␀ÿ␀
