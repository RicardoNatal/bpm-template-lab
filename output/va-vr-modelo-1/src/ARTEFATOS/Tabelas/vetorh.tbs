TRIGGER R090HCG_EI AFTER INSERT ON R090HCG FOR EACH ROW

DECLARE
l_codprm      NUMBER(5);
  l_datval      DATE;
  l_horval      NUMBER(5);
  l_online      BOOLEAN;
  l_tipvis      NUMBER(3);
  l_bloaut      CHAR(1);
  l_tippev      NUMBER(1);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       /* Inicializa */
       /* Valida Cracha e Data */
       IF   :NEW.NUMCRA <> 0 THEN
            SELECT CODPRM,DATVAL,HORVAL,TIPVIS INTO l_codprm,l_datval,l_horval,l_tipvis
              FROM R090MGV
             WHERE R090MGV.DATENT = :NEW.DATENT AND
                   R090MGV.HORENT = :NEW.HORENT AND
                   R090MGV.SEQENT = :NEW.SEQENT;

            BEGIN
               SELECT BLOAUT, TIPPEV INTO l_bloaut,l_tippev FROM R090TVI
               WHERE TIPVIS = l_tipvis;
            EXCEPTION WHEN OTHERS THEN
               l_bloaut := 'N';
               l_tippev := 1;
            END;

            IF   l_bloaut =  'S' THEN
                 l_bloaut := '1';
            ELSE l_bloaut := '0';
            END IF;

            SP_VISCON (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA, l_codprm,:NEW.DATENT,:NEW.HORENT,l_datval,l_horval,l_bloaut,l_tippev,l_tipvis,0,0,0,1,1, NULL);
       END IF;
  END IF;
END␀0İ␀␀		SENIOR;0O␀␀TRIGGER R090HCG_EU AFTER UPDATE ON R090HCG FOR EACH ROW

DECLARE
l_codprm       NUMBER(5);
  l_datval       DATE;
  l_horval       NUMBER(5);
  l_online       BOOLEAN;
  l_data_zero    DATE;
  l_tipvis       NUMBER(3);
  l_bloaut       CHAR(1);
  l_crafis       NUMBER(12);
  l_tippev       NUMBER(1);

BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       l_data_zero  := '31/12/1900,00:00:00';

       IF   :NEW.DATSAI <> l_data_zero THEN
             /* busca número de crachá fisico caso exista. */
             SP_RETFIS(:NEW.NUMCRA, 0,l_crafis OUT);

             AtuSitCra('1',l_crafis);
       ELSE
            IF  (:OLD.NUMCRA <> :NEW.NUMCRA) THEN
                 /* busca número de crachá fisico caso exista. */
                 SP_RETFIS(:OLD.NUMCRA, 0,l_crafis OUT);

                 AtuSitCra('1',l_crafis);
            END IF;

            SELECT CODPRM,DATVAL,HORVAL,TIPVIS INTO l_codprm,l_datval,l_horval,l_tipvis
              FROM R090MGV
             WHERE R090MGV.DATENT = :NEW.DATENT AND
                   R090MGV.HORENT = :NEW.HORENT AND
                   R090MGV.SEQENT = :NEW.SEQENT;

            BEGIN
               SELECT BLOAUT , TIPPEV INTO l_bloaut, l_tippev FROM R090TVI
               WHERE TIPVIS = l_tipvis;
            EXCEPTION WHEN OTHERS THEN
               l_bloaut := '0';
               l_tippev := 1;
            END;

            SP_VISCON (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,l_codprm,:NEW.DATENT,:NEW.HORENT,l_datval,l_horval,l_bloaut,l_tippev,l_tipvis,0,0,0,1,1, NULL);
       END IF;
  END IF;
END␀.İ␀␀		SENIOR;0^␀␀

TRIGGER R090HCG_ED AFTER DELETE ON R090HCG FOR EACH ROW

DECLARE
l_online       BOOLEAN;
  l_crafis       NUMBER(12);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       /* busca número de crachá fisico caso exista. */
       SP_RETFIS(:OLD.NUMCRA, 0,l_crafis OUT);

       AtuSitCra('1',l_crafis);
  END IF;
END␀␀␀İv␀␀␀␀␀␀␀␀␀␀␀␀␀1İ␀␀N␀	„␀␀␀␀␀␀£␀/␀0␀n␀Æÿ␀␀|İ␀␀␀~¬␀␀(	„␀␀␀␀␀␀V±␀␀†^¯␀␀d␀␀␀ÿ␀␀{İ␀␀␀EÑ␀	„␀␀␀␀␀␀KK¢G¢GqC␀êÿ␀␀ÿ␀¤w·␀	„␀␀␀␀␀␀’yˆxˆxì*␀␀Æÿ␀␀ÿ␀'ı␀␀­␀	„␀␀␀␀␀␀£ÿ␀␀Eü␀␀xş␀␀pˆ␀Æÿ␀␀ÿ␀u¬␀␀–␀„␀␀␀␀␀␀I±␀␀)8)8n␀Æÿ␀␀ÿ␀åDÑ␀„␀␀␀␀␀␀)GÔFÔFqC␀êÿ␀␀ÿ␀w·␀„␀␀␀␀␀␀[x<x<xì*␀␀Æÿ␀␀ÿ␀ş␀␀¢␀„␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀{Ç␀␀N„␀␀␀␀␀␀‰Ç␀␀yÇ␀␀†Ç␀␀M␀␀ÿ␀␀ÿ␀␀␀2İ␀␀␀␀	0;1;2;3;45İ␀␀		SENIOR;0ƒ␀␀TRIGGER R090HCH_EI BEFORE INSERT ON R090HCH FOR EACH ROW
DECLARE
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_data         CHAR(8);
  l_hora         CHAR(4);
  l_seq          CHAR(2);
  l_chave        CHAR(37);
  l_IDTPES       VARCHAR(23);
  l_codprm       NUMBER(5);
  l_ade_gerpen   BOOLEAN;
BEGIN
  /* Atualiza o campo Status Alfandegado no colaborador (ADE-02)
   * - Pego o código da permissão através da movimentação de visitante */
  SP_RECALF_GERPEN_1(4, l_ade_gerpen OUT);
  IF (l_ade_gerpen = TRUE) THEN
      BEGIN
          SELECT CODPRM INTO l_codprm FROM R090MVI
            WHERE DATENT = :NEW.DATINI AND HORENT = :NEW.HORINI AND SEQENT = :NEW.SEQENT;
      EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_codprm := 0;
          WHEN OTHERS THEN
            l_codprm := 0;
      END;
      IF (l_codprm > 0) THEN
          SP_RECALF_PRMVIS(:NEW.TIPDOC, :NEW.NUMDOC, l_codprm, :NEW.NUMCRA, :NEW.DATINI, :NEW.HORINI, :NEW.DATFIM, :NEW.HORFIM, :NEW.SEQENT);
      END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090HCH');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R090HCH_AUD (SEQREG,VERSEQ,TIPDOC,NUMDOC,DATINI,HORINI,SEQENT,NUMCRA,DATFIM,HORFIM)
                           VALUES (l_seqreg,l_verseq,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATINI,:NEW.HORINI,
                                  :NEW.SEQENT,:NEW.NUMCRA,:NEW.DATFIM,:NEW.HORFIM);

          SP_AUDGENREG(l_seqreg,l_verseq,'R090HCH','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  SP_RETIDTPES(NULL, 4, NULL, :NEW.TIPDOC, :NEW.NUMDOC, NULL, NULL, l_IDTPES OUT);
  SP_DATSTR(:NEW.DATINI,'DDMMYYYY',l_data OUT);
  SP_INTSTR(:NEW.HORINI,'9999',l_hora OUT);
  SP_INTSTR(:NEW.SEQENT,'99',l_seq OUT);
  l_chave := l_IDTPES||l_data||l_hora||l_seq;
  SP_SAM_PENDENCIES(8, 1, l_chave);
END␀6İ␀␀		SENIOR;0N␀␀

TRIGGER R090HCH_EU AFTER UPDATE ON R090HCH FOR EACH ROW
DECLARE
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_data             CHAR(8);
  l_hora             CHAR(4);
  l_seq              CHAR(2);
  l_chave            CHAR(37);
  l_IDTPES           VARCHAR(23);
  l_ade_gerpen       BOOLEAN;
  l_data_zero        DATE;
BEGIN
  /* Atualiza o campo Status Alfandegado no colaborador (ADE-02)
   * - Se estou alterando a data ou hora fim, significa que estou fechando o crachá.
   *   Não há campo StaAtu para crachá de visitante/acompanhante, então se estou
   *   alterando, suponho que estou fechando. Também não comparo com a data/hora
   *   atual, porque se não passar o status para Inativo agora, o histórico não será
   *   atualizado em outro momento.
   */
  SP_RECALF_GERPEN_1(4, l_ade_gerpen OUT);
  IF (l_ade_gerpen = TRUE) THEN
      l_data_zero  := '31/12/1900,00:00:00';
      IF (:NEW.DATFIM <> l_data_zero) AND ((:NEW.DATFIM <> :OLD.DATFIM) OR (:NEW.HORFIM <> :OLD.HORFIM)) THEN
          /* Garanto para que o status não permaneça como 2 - Ativo */
          SP_RECALF_R_CRAVIS(:NEW.TIPDOC, :NEW.NUMDOC, :NEW.DATFIM, :NEW.HORFIM);
      END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090HCH');

  IF (l_auditoria = 'S') THEN

       l_camposAlterados := 'Campo(s) alterado(s): ';
       l_alterou := FALSE;

      IF (:NEW.TIPDOC <> :OLD.TIPDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPDOC ';
      END IF;

      IF (:NEW.NUMDOC <> :OLD.NUMDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMDOC ';
      END IF;

      IF (:NEW.DATINI <> :OLD.DATINI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATINI ';
      END IF;

      IF (:NEW.HORINI <> :OLD.HORINI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORINI ';
      END IF;

      IF (:NEW.SEQENT <> :OLD.SEQENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEQENT ';
      END IF;

      IF (:NEW.NUMCRA <> :OLD.NUMCRA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCRA ';
      END IF;

      IF (:NEW.DATFIM <> :OLD.DATFIM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATFIM ';
      END IF;

      IF (:NEW.HORFIM <> :OLD.HORFIM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORFIM ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R090HCH_AUD
                   WHERE TIPDOC = :OLD.TIPDOC AND
                         NUMDOC = :OLD.NUMDOC AND
                         DATINI = :OLD.DATINI AND
                         HORINI = :OLD.HORINI AND
                         SEQENT = :OLD.SEQENT;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R090HCH_AUD (SEQREG,VERSEQ,TIPDOC,NUMDOC,DATINI,HORINI,SEQENT,NUMCRA,DATFIM,HORFIM)
                               VALUES (l_seqreg,l_verseq,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATINI,:NEW.HORINI,
                                      :NEW.SEQENT,:NEW.NUMCRA,:NEW.DATFIM,:NEW.HORFIM);

              SP_AUDGENREG(l_seqreg,l_verseq,'R090HCH',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  IF :OLD.DATINI <> :NEW.DATINI OR :OLD.DATFIM <> :NEW.DATFIM OR
     :OLD.HORINI <> :NEW.HORINI OR :OLD.HORFIM <> :NEW.HORFIM THEN
    SP_RETIDTPES(NULL, 4, NULL, :NEW.TIPDOC, :NEW.NUMDOC, NULL, NULL, l_IDTPES OUT);
    SP_DATSTR(:NEW.DATINI,'DDMMYYYY',l_data OUT);
    SP_INTSTR(:NEW.HORINI,'9999',l_hora OUT);
    SP_INTSTR(:NEW.SEQENT,'99',l_seq OUT);
    l_chave := l_IDTPES||l_data||l_hora||l_seq;
    SP_SAM_PENDENCIES(8, 2, l_chave);
  END IF;

END␀4İ␀␀		SENIOR;0	␀␀

TRIGGER R090HCH_ED AFTER DELETE ON R090HCH FOR EACH ROW
DECLARE
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_data         CHAR(8);
  l_hora         CHAR(4);
  l_seq          CHAR(2);
  l_chave        CHAR(37);
  l_IDTPES       VARCHAR(23);
  l_ade_gerpen   BOOLEAN;
BEGIN
  /* Atualiza o campo Status Alfandegado no colaborador (ADE-02) */
  /* Garanto para que o status não permaneça como 2 - Ativo, pois o vínculo com as permissões foi excluído */
  SP_RECALF_GERPEN_1(4, l_ade_gerpen OUT);
  IF (l_ade_gerpen = TRUE) THEN
      SP_RECALF_E_CRAVIS(:OLD.TIPDOC, :OLD.NUMDOC);
  END IF;

  /*INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090HCH');

  IF (l_auditoria = 'S') THEN
      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg
                FROM R090HCH_AUD
               WHERE TIPDOC = :OLD.TIPDOC AND
                     NUMDOC = :OLD.NUMDOC AND
                     DATINI = :OLD.DATINI AND
                     HORINI = :OLD.HORINI AND
                     SEQENT = :OLD.SEQENT;
           EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
          INSERT INTO R090HCH_AUD (SEQREG,VERSEQ,TIPDOC,NUMDOC,DATINI,HORINI,SEQENT,NUMCRA,DATFIM,HORFIM)
                           VALUES (l_seqreg,l_verseq,:OLD.TIPDOC,:OLD.NUMDOC,:OLD.DATINI,:OLD.HORINI,
                                  :OLD.SEQENT,:OLD.NUMCRA,:OLD.DATFIM,:OLD.HORFIM);

          SP_AUDGENREG(l_seqreg,l_verseq,'R090HCH','DELETE');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  SP_RETIDTPES(NULL, 4, NULL, :OLD.TIPDOC, :OLD.NUMDOC, NULL, NULL, l_IDTPES OUT);
  SP_DATSTR(:OLD.DATINI,'DDMMYYYY',l_data OUT);
  SP_INTSTR(:OLD.HORINI,'9999',l_hora OUT);
  SP_INTSTR(:OLD.SEQENT,'99',l_seq OUT);
  l_chave := l_IDTPES||l_data||l_hora||l_seq;
