BEGIN
BEGIN
    IF (:NEW.NOMPES <> :OLD.NOMPES) THEN
      UPDATE R235REC SET NOMREI = :NEW.NOMPES
       WHERE R235REC.TIPREC = 1 /* LTpoRec = 1 -> Pessoa */
         AND R235REC.CODPES = :NEW.CODPES;
    END IF;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao atualizar a tabela R235REC com o nome da pessoa.';
  END;
END␀␀␀Â␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Ó␀␀/-Ì␀	„“␀␀␀␀␀Š=íÁ␀␀íÁ␀␀”)␀␀Æÿ␀␀Ó␀␀␀¶ü␀␀¼␀	„“␀␀␀␀␀~ÿ␀␀xş␀␀xş␀␀Š)␀␀Æÿ␀␀ÿ␀Üı␀␀´␀	„“␀␀␀␀␀ÿ␀␀xş␀␀xş␀␀r␀Æÿ␀␀ÿ␀8␀„“␀␀␀␀␀·#‰#‰#Q␀␀Æÿ␀␀ÿ␀µ§␀␀v„“␀␀␀␀␀Sª␀␀ç§␀␀ç§␀␀n␀␀ÿ␀␀ÿ␀␀M„“␀␀␀␀␀C␀t␀t␀n␀Æÿ␀␀ÿ␀p>„“␀␀␀␀␀upopop?␀␀␀ÿ␀␀ÿ␀7,n„“␀␀␀␀␀ """l␀␀ÿ␀␀Ñ␀␀␀␀␀¶„“␀␀␀␀␀†␀␀␀␀␀␀n␀Æÿ␀␀ÿ␀␀␀␀0;1;2␀␀âv␀␀␀␀␀␀␀␀␀␀Ó␀␀/-Ì␀	Ôÿ/␀␀␀␀␀Š=íÁ␀␀íÁ␀␀”)␀␀Æÿ␀␀Ó␀␀␀mDÑ␀	Ôÿ/␀␀␀␀␀‡JşEşEqC␀êÿ␀␀ÿ␀Öü␀␀­␀	Ôÿ/␀␀␀␀␀xş␀␀xş␀␀xş␀␀3)␀␀Æÿ␀␀ÿ␀YDÑ␀Ôÿ/␀␀␀␀␀}J©©qC␀êÿ␀␀ÿ␀ÆDÑ␀Ôÿ/␀␀␀␀␀ÈJ~c~cqC␀êÿ␀␀ÿ␀Ía´␀Ôÿ/␀␀␀␀␀õ␀õ␀õ␀r␀Æÿ␀␀Ò␀␀␀␀tÔÿ/␀␀␀␀␀õ␀õ␀õ␀n␀Æÿ␀␀ˆÓ␀␀␀;$Ì␀Ôÿ/␀␀␀␀␀õ␀õ␀õ␀w␀Æÿ␀␀…Ó␀␀␀hS­␀Ôÿ/␀␀␀␀␀õ␀õ␀õ␀p␀Æÿ␀␀Ô␀␀␀.?Ôÿ/␀␀␀␀␀õ␀õ␀õ␀n␀Æÿ␀␀ÿ␀²&Á␀Ôÿ/␀␀␀␀␀õ␀õ␀õ␀y␀Æÿ␀␀aà␀␀␀DÑ␀Ôÿ/␀␀␀␀␀õ␀õ␀õ␀qC␀êÿ␀␀ÿ␀\␀jÔÿ/␀␀␀␀␀K␀Í␀J␀p␀Æÿ␀␀Ó␀␀␀H*Ôÿ/␀␀␀␀␀***␀␀ÿ␀␀Ó␀␀␀␀␀␀0;1;2␀␀îÁ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Ó␀␀.¶␀␀Ù	Ôÿ␀␀␀␀␀·␀␀‘¶␀␀‘¶␀␀n␀Æÿ␀␀Ó␀␀␀`-­␀	Ôÿ␀␀␀␀␀ä>¤:¤:p␀Æÿ␀␀Ó␀␀␀=UoÔÿ␀␀␀␀␀VX°V°Vi␀␀ÿ␀␀ÿ␀«µ␀␀­␀Ôÿ␀␀␀␀␀Åµ␀␀®µ␀␀®µ␀␀p␀Æÿ␀␀ÿ␀öu=Ôÿ␀␀␀␀␀vvvc␀␀␀ÿ␀␀ÿS␀␀␀0;1␀␀Â␀␀␀␀␀␀␀␀Ó␀␀…¬␀␀´␀	Ôÿ1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ1␀␀␀␀␀Ü␀t␀Ü␀n¼‡␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ1␀␀␀␀␀.%€$0.w¼‡␀Æÿ␀␀…Ó␀␀␀bDÑ␀Ôÿ␀␀␀␀␀„JéE„JqCÈ‡␀êÿ␀␀ÿ␀Èş␀