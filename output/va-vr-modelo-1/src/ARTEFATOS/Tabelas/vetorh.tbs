TRIGGER R304ACD_SI AFTER INSERT ON R304ACD
DECLARE
	CURSOR c_R304ACD IS
	SELECT NUMEMP, TIPTXT, NUMTXT, NOMARQ, TIPENV, SEQREG
	  FROM R304ACD
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304ACD IS RECORD (
		NUMEMP   R304ACD.NumEmp%TYPE,
		TIPTXT   R304ACD.TipTxt%TYPE,
		NUMTXT   R304ACD.NumTxt%TYPE,
		NOMARQ   R304ACD.NomArq%TYPE,
		TIPENV   R304ACD.TipEnv%TYPE,
		SEQREG   R304ACD.SeqReg%TYPE
	);
    
    l_R304ACD t_R304ACD;
    l_PidSta VARCHAR2(30);
    l_MsgErr VARCHAR2(255);
BEGIN
	FOREACH c_R304ACD INTO l_R304ACD.NumEmp, l_R304ACD.TipTxt, l_R304ACD.NumTxt, l_R304ACD.NomArq, l_R304ACD.TipEnv, l_R304ACD.SeqReg
	LOOP
		BEGIN
			SELECT DISTINCT ACF.PIDSTA INTO l_PidSta
			  FROM R304ACF ACF, R304STA STA
			 WHERE ACF.PIDSTA = STA.PIDSTA
			   AND ACF.NUMEMP = l_R304ACD.NumEmp 
			   AND ACF.TIPTXT = l_R304ACD.TipTxt 
			   AND ACF.NUMTXT = l_R304ACD.NumTxt 
			   AND ACF.TIPENV = l_R304ACD.TipEnv
			   AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_MsgErr := 'Não existe registro de Atualização do Cargo ou Função pendente com as seguintes chaves: ' ||
					'Empresa: ' || CONVERT(NUMBER_TO_CHAR, l_R304ACD.NumEmp) || 
					', Tipo do Texto Jurídico: ' || CONVERT(NUMBER_TO_CHAR, l_R304ACD.TipTxt) || 
					', Número do Texto Jurídico: ' || l_R304ACD.NumTxt || '.';
				RAISERROR 103 l_MsgErr;
			WHEN TOO_MANY_ROWS THEN
				RAISERROR 103 'Foi encontrado mais de um registro de status com situação Pendente Envio ou Erro Envio para o Texto Jurídico.';				
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304ACF.';
		END;
			
		BEGIN
			UPDATE R304ACD
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304ACD.NumEmp
			   AND TIPTXT = l_R304ACD.TipTxt
			   AND NUMTXT = l_R304ACD.NumTxt
			   AND NOMARQ = l_R304ACD.NomArq
			   AND TIPENV = l_R304ACD.TipEnv
			   AND SEQREG = l_R304ACD.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304ACD.';
		END;
	END LOOP;
END␀"å␀␀		SENIOR;0u␀␀TRIGGER R304ACD_EI BEFORE INSERT ON R304ACD FOR EACH ROW
DECLARE
	l_SeqReg NUMBER(9);
	l_SeqRegStr VARCHAR2(9);
	l_StaEnv CHAR;
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Busca última sequência cadastrada */
	BEGIN
		SELECT ACD.SEQREG, STA.STAENV INTO l_SeqReg, l_StaEnv 
		  FROM R304ACD ACD, R304STA STA
		 WHERE ACD.PIDSTA = STA.PIDSTA
		   AND ACD.NUMEMP = :NEW.NumEmp
		   AND ACD.TIPTXT = :NEW.TipTxt
		   AND ACD.NUMTXT = :NEW.NumTxt		   			   
		   AND ACD.NOMARQ = :NEW.NOMARQ
		   AND ACD.TIPENV = :NEW.TipEnv		   		   
		   AND ACD.SEQREG = (SELECT MAX(ACD2.SEQREG) FROM R304ACD ACD2
		   					  WHERE ACD2.NUMEMP = ACD.NUMEMP
		   						AND ACD2.TIPTXT = ACD.TipTxt
		   						AND ACD2.NUMTXT = ACD.NumTxt		   			   
		   						AND ACD2.NOMARQ = ACD.NomArq
		   						AND ACD2.TIPENV = ACD.TipEnv
		   					    AND ACD2.SEQREG < ACD.SeqReg);
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
			l_StaEnv := '';
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304ACD.';
	END;
	
	/* Verifica se encontrou última sequência */
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
		
		/* Verifica se a última sequência está com status Cancelado. Se não estiver, não permite o cadastro de um novo registro para a mesma folha de pagamento. */
		IF (l_StaEnv <> 'N') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que o registro de sequência ' || l_SeqRegStr || ' esteja com status Cancelado.';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀#å␀␀		SENIOR;04␀␀

TRIGGER R304ACD_EU BEFORE UPDATE ON R304ACD FOR EACH ROW
DECLARE
	l_StaEnv CHAR;
BEGIN
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio e Erro Envio podem ser alterados.';			
	END IF;
END␀␀␀)*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀%å␀␀…¬␀␀´␀	Ôÿ?ü␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀b␀H	Ôÿ␀␀␀␀␀P␀g␀ò␀p␀Æÿ␀␀ÿ␀î¬␀␀	Ôÿ␀␀␀␀␀²␀␀W¯␀␀¦±␀␀%␀␀ÿ␀␀ÿ␀␀J	Ôÿ␀␀␀␀␀·␀¢␀'␀p␀Æÿ␀␀ÿ␀␀¤	Ôÿ␀␀␀␀␀U␀U␀U␀p␀Æÿ␀␀ÿ␀U'	Ôÿ?␀␀␀␀␀ûAİ'	@%␀␀ÿ␀␀ÿ␀EÑ␀	Ôÿ␀␀␀␀␀+Kì”␀␀+KqC␀êÿ␀␀ÿ␀d␀
		Ôÿ␀␀␀␀␀÷␀␀¸␀p␀Æÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀W§␀␀Ôÿ?␀␀␀␀␀ª␀␀¨␀␀j©␀␀␀␀␀ÿ␀␀ÿ␀åDÑ␀Ôÿ?ü␀␀␀␀æM²nëJqC␀␀êÿ␀␀ÿ␀␀[Ôÿ␀␀␀␀␀Æ␀Æ␀B␀p␀␀Æÿ␀␀ÿ␀␀iÔÿ?␀␀␀␀␀İ␀Å␀­␀p␀␀Æÿ␀␀ÿ␀ÏÉ␀␀Á␀Ôÿ␀␀␀␀␀>Í␀␀nÉ␀␀Ì␀␀y␀␀Æÿ␀␀ÿ␀â␀îÔÿ␀␀␀␀␀Ç␀␀C␀p␀␀Æÿ␀␀ÿ␀f´␀Ôÿ?␀␀␀␀␀÷<ïe»fr␀␀Æÿ␀␀)Ñ␀␀␀0,4Ôÿ?␀␀␀␀␀ÿ?µ'µ'}␀␀␀ÿ␀␀Ñ␀␀␀5Â␀␀EÔÿ␀␀␀␀␀,Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀)+Ñ␀Ôÿ␀␀␀␀␀M&M&M&qC␀␀êÿ␀␀ÿ␀++Ñ␀Ôÿ␀␀␀␀␀U&U&U&qC␀␀êÿ␀␀ÿ␀,+Ç␀Ôÿ␀␀␀␀␀W&W&W&z␀Æÿ␀␀ÿ␀-+Ç␀Ôÿ␀␀␀␀␀Y&Y&Y&z␀Æÿ␀␀ÿ␀.+Ç␀Ôÿ␀␀␀␀␀[&[&[&z␀Æÿ␀␀ÿ␀/+Ç␀Ôÿ␀␀␀␀␀\&\&\&z␀Æÿ␀␀ÿ␀0+'Ôÿ␀␀␀␀␀]&]&]&D␀␀ÿ␀␀ÿ␀1+'Ôÿ␀␀␀␀␀^&^&^&D␀␀ÿ␀␀ÿ␀2+*Ôÿ␀␀␀␀␀_&_&_&,␀␀ÿ␀␀ÿ␀i␀ûÔÿ␀␀␀␀␀ú␀°e°ep␀␀Æÿ␀␀ÿ␀7,nÔÿ␀␀␀␀␀È(""l␀␀ÿ␀␀Ñ␀␀␀␀␀&å␀␀␀␀0;1;2;3;4;5;6;7;8+å␀␀	SENIOR;0=␀␀

TRIGGER R304ACF_SI AFTER INSERT ON R304ACF
DECLARE
	CURSOR c_R304ACF IS
	SELECT NUMEMP, TIPTXT, NUMTXT, TIPATU, TIPQUA, CARFUN, DATINI, TIPENV, SEQREG
	  FROM R304ACF
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304ACF IS RECORD (
		NUMEMP   R304ACF.NumEmp%TYPE,
		TIPTXT   R304ACF.TipTxt%TYPE,
		NUMTXT   R304ACF.NumTxt%TYPE,
		TIPATU   R304ACF.TipAtu%TYPE,
		TIPQUA   R304ACF.TipQua%TYPE,
		CARFUN   R304QUA.CarFun%TYPE,
		DATINI   R304ACF.DatIni%TYPE,
		TIPENV   R304ACF.TipEnv%TYPE,
		SEQREG   R304ACF.SeqReg%TYPE
	);
	
	l_NumEmpAux   R304ACF.NumEmp%TYPE;
	l_TipTxtAux   R304ACF.TipTxt%TYPE;
	l_NumTxtAux   R304ACF.NumTxt%TYPE;
	l_TipEnvAux   R304ACF.TipEnv%TYPE;
    
    l_R304ACF t_R304ACF;
    
	l_PidSta VARCHAR2(30);
	l_DesRes VARCHAR(250);
BEGIN
	l_NumEmpAux := 0;
	l_TipTxtAux := 0;
	l_NumTxtAux := '';
	l_TipEnvAux := 0;
	l_PidSta := NULL;

	FOREACH c_R304ACF INTO l_R304ACF.NumEmp, l_R304ACF.TipTxt, l_R304ACF.NumTxt, l_R304ACF.TipAtu, l_R304ACF.TipQua, l_R304ACF.CarFun, l_R304ACF.DatIni, l_R304ACF.TipEnv, l_R304ACF.SeqReg
	LOOP
		/* Se último registro se tratava do mesmo Texto Jurídico, utiliza o PID encontrando anteriormente */
		IF ((l_R304ACF.NumEmp <> l_NumEmpAux) OR 
			(l_R304ACF.TipTxt <> l_TipTxtAux) OR
			(l_R304ACF.NumTxt <> l_NumTxtAux) OR
			(l_R304ACF.TipEnv <> l_TipEnvAux)) THEN
			l_PidSta := NULL;
		END IF;
		
		/* Verifica se já tem algum outro registro do mesmo texto jurídico que esteja pendente (P - Pendente Envio ou R - Erro Envio) */
		IF (l_PidSta IS NULL) THEN
			BEGIN
				SELECT DISTINCT ACF.PIDSTA INTO l_PidSta 
				  FROM R304ACF ACF, R304STA STA 
				 WHERE ACF.PIDSTA = STA.PIDSTA 
				   AND ACF.NUMEMP = l_R304ACF.NumEmp 
				   AND ACF.TIPTXT = l_R304ACF.TipTxt 
				   AND ACF.NUMTXT = l_R304ACF.NumTxt
				   AND ACF.TIPENV = l_R304ACF.TipEnv
				   AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
			EXCEPTION
				WHEN NO_DATA_FOUND THEN
					l_PidSta := NULL; 
				WHEN TOO_MANY_ROWS THEN
					RAISERROR 103 'Foi encontrado mais de um registro de status com situação Pendente Envio para o Texto Jurídico.';				
				WHEN OTHERS THEN
					RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304ACF.';
			END;
		END IF;
		
		IF (l_PidSta IS NULL) THEN		
			l_DesRes := 'Tipo Texto Jurídico: ' || CONVERT(NUMBER_TO_CHAR, l_R304ACF.TipTxt) || ', Número Texto Jurídico: ' || l_R304ACF.NumTxt;	

			IF (l_R304ACF.TipEnv = 1) THEN
				SP_GERPIDSTA(l_R304ACF.NumEmp, 1, l_PidSta OUT);
				SP_GERSTA_ESFINGE(1, l_PidSta, l_R304ACF.DatIni, l_DesRes, l_R304ACF.NumEmp, 0, 0);
			ELSE
				SP_GERPIDSTA(l_R304ACF.NumEmp, 15, l_PidSta OUT);
				SP_GERSTA_ESFINGE(15, l_PidSta, l_R304ACF.DatIni, l_DesRes, l_R304ACF.NumEmp, 0, 0);
			END IF;		
		END IF;
		
		BEGIN
			UPDATE R304ACF
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304ACF.NumEmp
			   AND TIPTXT = l_R304ACF.TipTxt
			   AND NUMTXT = l_R304ACF.NumTxt
			   AND TIPATU = l_R304ACF.TipAtu
			   AND TIPQUA = l_R304ACF.TipQua
			   AND CARFUN = l_R304ACF.CarFun
			   AND DATINI = l_R304ACF.DatIni
			   AND TIPENV = l_R304ACF.TipEnv
			   AND SEQREG = l_R304ACF.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304ACF.';
		END;
		
		l_NumEmpAux := l_R304ACF.NumEmp;
		l_TipTxtAux := l_R304ACF.TipTxt;
		l_NumTxtAux := l_R304ACF.NumTxt;
		l_TipEnvAux := l_R304ACF.TipEnv;
	END LOOP;
END␀(å␀␀		SENIOR;0Q␀␀TRIGGER R304ACF_EI BEFORE INSERT ON R304ACF FOR EACH ROW
DECLARE
	l_SeqReg NUMBER(9);
	l_StaEnv CHAR;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR(255);
BEGIN
	/* Busca última sequência cadastrada */
	BEGIN
		SELECT ACF.SEQREG, STA.STAENV INTO l_SeqReg, l_StaEnv 
		  FROM R304ACF ACF, R304STA STA
		 WHERE ACF.PIDSTA = STA.PIDSTA 
		   AND ACF.NUMEMP = :NEW.NumEmp
		   AND ACF.TIPTXT = :NEW.TipTxt
		   AND ACF.NUMTXT = :NEW.NumTxt		   			   
		   AND ACF.TIPATU = :NEW.TipAtu
		   AND ACF.TIPQUA = :NEW.TipQua
		   AND ACF.CARFUN = :NEW.CarFun
		   AND ACF.DATINI = :NEW.DatIni
		   AND ACF.TIPENV = :NEW.TipEnv		   		   
		   AND ACF.SEQREG = (SELECT MAX(ACF2.SEQREG) FROM R304ACF ACF2
		   					  WHERE ACF2.NUMEMP = ACF.NUMEMP
		   						AND ACF2.TIPTXT = ACF.TipTxt
		   						AND ACF2.NUMTXT = ACF.NumTxt		   			   
		   						AND ACF2.TIPATU = ACF.TipAtu
		   						AND ACF2.TIPQUA = ACF.TipQua
		   						AND ACF2.CARFUN = ACF.CarFun
		   						AND ACF2.DATINI = ACF.DatIni
		   						AND ACF2.TIPENV = ACF.TipEnv
		   					    AND ACF2.SEQREG < ACF.SeqReg);
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
			l_StaEnv := '';
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304ACF.';
	END;
	
	/* Verifica se encontrou última sequência */
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
				
		/* Verifica se a última sequência está com status Cancelado. Se não estiver, não permite o cadastro de um novo registro para o mesmo texto jurídico. */
		IF (l_StaEnv <> 'N') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que o registro de sequência ' || l_SeqRegStr || ' esteja com status Cancelado.';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀)å␀␀		SENIOR;02␀␀

TRIGGER R304ACF_EU BEFORE UPDATE ON R304ACF FOR EACH ROW
DECLARE
	l_StaEnv CHAR;
BEGIN
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio e Erro Envio podem ser alterados.';
	END IF;	
END␀*å␀␀	SENIOR;0?␀␀

TRIGGER R304ACF_SD AFTER DELETE ON R304ACF
BEGIN
	BEGIN
		DELETE FROM R304STA
		 WHERE (LAYOUT = 1 OR LAYOUT = 15)
		   AND NOT EXISTS (SELECT 1 FROM R304ACF WHERE R304ACF.PIDSTA = R304STA.PIDSTA);
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao excluir registros não utilizados na tabela R304STA.';
	END;
END␀'å␀␀		SENIOR;0ò␀␀

TRIGGER R304ACF_ED BEFORE DELETE ON R304ACF FOR EACH ROW
DECLARE
	l_PidSta VARCHAR2(30);
	l_QtdReg NUMBER;
BEGIN	
	BEGIN
		SELECT COUNT(*) INTO l_QtdReg FROM R304ACD WHERE PIDSTA = :OLD.PidSta;
	EXCEPTION 
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304ACD.';
	END;		
	
	IF (l_QtdReg > 0) THEN	
		RAISERROR 103 'Não é possível excluir o registro pois existem registros relacionados ao Texto Jurídico na tabela de Documentos (R304ACD).';	
	END IF;
END␀␀␀#*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀,å␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀[¬␀␀	Ôÿ?␀␀␀␀␀¯±␀␀3¯␀␀±␀␀%␀␀ÿ␀␀ÿ␀}DÑ␀	Ôÿ?␀␀␀␀␀^M!FğLqC␀êÿ␀␀ÿ␀ª¬␀␀	Ôÿ?␀␀␀␀␀R°␀␀H¯␀␀°␀␀%␀␀ÿ␀␀ÿ␀s¬␀␀␀	Ôÿ?␀␀␀␀␀¥?c°␀␀c°␀␀Q␀Æÿ␀␀ÿ␀Ö-¦␀	Ôÿ?␀␀␀␀␀-?:5>j␀Æÿ␀␀ÿ␀+§␀␀>	Ôÿ?␀␀␀␀␀î©␀␀B©␀␀B©␀␀=␀␀ÿ␀␀ÿ␀N␀.	Ôÿ?␀␀␀␀␀$␀˜␀˜␀q␀Æÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀ü␀Ôÿ␀␀␀␀␀é␀â␀æ␀␀␀␀ÿ␀␀ÿ␀ÚÒ␀Ôÿ/␀␀␀␀␀ììÿ␀ÿÿ␀␀ÿ␀5Â␀␀EÔÿ?␀␀␀␀␀-Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀␀␀-å␀␀␀␀0;1;2;3;4;5;6;7;80å␀␀	SENIOR;0Ï␀␀

TRIGGER R304ACP_SI AFTER INSERT ON R304ACP
DECLARE
	CURSOR c_R304ACP IS
	SELECT NUMEMP, NUMATO, DATATO, NUMMAT, NUMCPF, CODUNI, NOMARQ, TIPDOC, SEQREG
	  FROM R304ACP
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304ACP IS RECORD (
		NUMEMP   R304ACP.NumEmp%TYPE,
		NUMATO   R304ACP.NUMATO%TYPE,
		DATATO   R304ACP.DATATO%TYPE,
		NUMMAT   R304ACP.NUMMAT%TYPE,
		NUMCPF   R304ACP.NUMCPF%TYPE,
		CODUNI   R304ACP.CODUNI%TYPE,
		NOMARQ   R304ACP.NOMARQ%TYPE,
		TIPDOC   R304ACP.TIPDOC%TYPE,
		SEQREG   R304ACP.SEQREG%TYPE
	);
    
    l_R304ACP t_R304ACP;
    l_PidSta VARCHAR2(30);
    l_MsgErr VARCHAR2(255);
BEGIN
	FOREACH c_R304ACP INTO l_R304ACP.NumEmp, l_R304ACP.NUMATO, l_R304ACP.DATATO, l_R304ACP.NUMMAT, l_R304ACP.NUMCPF, l_R304ACP.CODUNI, l_R304ACP.NOMARQ, l_R304ACP.TIPDOC, l_R304ACP.SEQREG
	LOOP
		/* Busca PID gravado no registro do Concurso/Processo Seletivo */
		BEGIN
			SELECT CPE.PIDSTA INTO l_PidSta
			  FROM R304CPE CPE, R304STA STA
			 WHERE CPE.PIDSTA = STA.PIDSTA
			   AND CPE.NUMEMP = l_R304ACP.NumEmp
			   AND CPE.NUMATO = l_R304ACP.NUMATO
			   AND CPE.DATATO = l_R304ACP.DATATO
			   AND CPE.NUMMAT = l_R304ACP.NUMMAT
			   AND CPE.NUMCPF = l_R304ACP.NUMCPF
			   AND CPE.CODUNI = l_R304ACP.CODUNI
			   AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_MsgErr := 'Não existe registro de concessão pensão pendente com as seguintes chaves: ' ||
					'Empresa: ' || CONVERT(NUMBER_TO_CHAR, l_R304ACP.NumEmp) || ', ato: ' || l_R304ACP.NUMATO || '.';
				RAISERROR 103 l_MsgErr;
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304ACP.';
		END;
		
		BEGIN
			UPDATE R304ACP
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304ACP.NumEmp
			   AND NUMATO = l_R304ACP.NUMATO
			   AND DATATO = l_R304ACP.DATATO
			   AND NUMMAT = l_R304ACP.NUMMAT
			   AND NUMCPF = l_R304ACP.NUMCPF
			   AND CODUNI = l_R304ACP.CODUNI
			   AND NUMCPF = l_R304ACP.NUMCPF
			   AND CODUNI = l_R304ACP.CODUNI
			   AND TIPDOC = l_R304ACP.TIPDOC
			   AND NOMARQ = l_R304ACP.NOMARQ
			   AND SEQREG = l_R304ACP.SEQREG;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304TCP.';
		END;
	END LOOP;
END␀.å␀␀		SENIOR;0%␀␀TRIGGER R304ACP_EI BEFORE INSERT ON R304ACP FOR EACH ROW
DECLARE
	l_SeqReg   R304ACP.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Verifica se está tentando incluir um registro com sequência maior do que a última já cadastrada */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304ACP
		 WHERE NUMEMP = :NEW.NumEmp
		   AND NUMATO = :NEW.NUMATO
		   AND DATATO = :NEW.DATATO
		   AND NUMMAT = :NEW.NUMMAT
		   AND NUMCPF = :NEW.NUMCPF
		   AND CODUNI = :NEW.CODUNI
		   AND NOMARQ = :NEW.NOMARQ
		   AND TIPDOC = :NEW.TIPDOC
		   AND SEQREG <> :NEW.SeqReg;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304ACP.';
	END;
	
	IF (l_SeqReg > 0) THEN
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀/å␀␀		SENIOR;0ª␀␀

TRIGGER R304ACP_EU BEFORE UPDATE ON R304ACP FOR EACH ROW
DECLARE
	l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
	/* Somente permite alterar caso status do envio seja P - Pendente Envio e R - Erro Envio */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados/excluídos.';
	END IF;
END␀␀␀!*␀␀␀␀␀␀␀␀␀␀␀␀␀␀1å␀␀…¬␀␀´␀	Ôÿ?ü␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀‚¬␀␀	Ôÿ?ü␀␀␀␀Ä±␀␀<¯␀␀\±␀␀%␀␀ÿ␀␀ÿ␀+§␀␀	Ôÿ␀␀␀␀␀õ©␀␀B©␀␀B©␀␀␀␀ÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀4¦␀␀pÔÿ␀␀␀␀␀r¦␀␀d¦␀␀e¦␀␀p␀Æÿ␀␀ÿ␀ü␀Ôÿ␀␀␀␀␀é␀â␀æ␀␀␀␀ÿ␀␀ÿ␀ÚÒ␀Ôÿ/␀␀␀␀␀ììÿ␀ÿÿ␀␀ÿ␀5Â␀␀EÔÿ␀␀␀␀␀,Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀␀␀2å␀␀␀␀0;1;2;35å␀␀	SENIOR;0>␀␀

TRIGGER R304AEC_SI AFTER INSERT ON R304AEC
DECLARE
    CURSOR c_R304AEC IS
    SELECT NUMEMP, NUMEDI, NOMARQ, SEQREG
      FROM R304AEC
     WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
    TYPE t_R304AEC IS RECORD (
        NUMEMP   R304AEC.NumEmp%TYPE,
        NUMEDI   R304AEC.NumEdi%TYPE,
        NOMARQ   R304AEC.NomArq%TYPE,
        SEQREG   R304AEC.SeqReg%TYPE
    );

    l_R304AEC t_R304AEC;
    l_PidSta VARCHAR2(30);
    l_MsgErr VARCHAR2(255);
BEGIN
    FOREACH c_R304AEC INTO l_R304AEC.NumEmp, l_R304AEC.NumEdi, l_R304AEC.NomArq, l_R304AEC.SeqReg
    LOOP
        /* Busca PID gravado no registro do Concurso/Processo Seletivo */
        BEGIN
            SELECT ECO.PIDSTA INTO l_PidSta
              FROM R304ECO ECO, R304STA STA
             WHERE ECO.PIDSTA = STA.PIDSTA
               AND ECO.NUMEMP = l_R304AEC.NumEmp
               AND ECO.NUMEDI = l_R304AEC.NumEdi
               AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_MsgErr := 'Não existe registro de Concursos/Processos Seletivos pendente com as seguintes chaves: ' ||
                    'Empresa: ' || CONVERT(NUMBER_TO_CHAR, l_R304AEC.NumEmp) || ', Edital: ' || l_R304AEC.NumEdi || '.';
                RAISERROR 103 l_MsgErr;
            WHEN OTHERS THEN
                RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304ECO.';
        END;

        BEGIN
            UPDATE R304AEC
               SET PIDSTA = l_PidSta
             WHERE NUMEMP = l_R304AEC.NumEmp
               AND NUMEDI = l_R304AEC.NumEdi
               AND NOMARQ = l_R304AEC.NomArq
               AND SEQREG = l_R304AEC.SeqReg;
        EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304AEC.';
        END;
    END LOOP;
END␀3å␀␀		SENIOR;0␀␀TRIGGER R304AEC_EI BEFORE INSERT ON R304AEC FOR EACH ROW
DECLARE
    l_SeqReg   R304AEC.SeqReg%TYPE;
    l_SeqRegStr VARCHAR2(9);
    l_MsgErr VARCHAR2(255);
BEGIN
    /* Verifica se está tentando incluir um registro com sequência maior do que a última já cadastrada */
    BEGIN
        SELECT MAX(SEQREG) INTO l_SeqReg
          FROM R304AEC
         WHERE NUMEMP = :NEW.NumEmp
           AND NUMEDI = :NEW.NumEdi
           AND NOMARQ = :NEW.NomArq
           AND SEQREG <> :NEW.SeqReg;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            l_SeqReg := 0;
        WHEN OTHERS THEN
            RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304AEC.';
    END;

    IF (l_SeqReg > 0) THEN
        IF (:NEW.SeqReg < l_SeqReg) THEN
            l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
            l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
            RAISERROR 103 l_MsgErr;
        END IF;
    END IF;
END␀4å␀␀		SENIOR;0µ␀␀

TRIGGER R304AEC_EU BEFORE UPDATE ON R304AEC FOR EACH ROW
DECLARE
    l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
    /* Somente permite alterar caso status do envio seja P - Pendente Envio e R - Erro Envio */
    SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
    IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
        RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados.';
    END IF;
END␀␀␀"*␀␀␀␀␀␀␀␀␀␀6å␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ?␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ?␀␀␀␀␀P%€$0.w␀Æÿ␀␀…Ó␀␀␀ª¬␀␀	Ôÿ?␀␀␀␀␀"°␀␀H¯␀␀°␀␀%␀␀ÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀®§␀␀	Ôÿ?␀␀␀␀␀ ¨␀␀\¨␀␀·¨␀␀␀␀ÿ␀␀ÿ␀<EÑ␀	Ôÿ␀␀␀␀␀RKHRKqC␀êÿ␀␀ÿ␀™§␀␀	Ôÿ?␀␀␀␀␀¨␀␀µ¨␀␀µ¨␀␀␀␀ÿ␀␀ÿ␀ª§␀␀Ôÿ?␀␀␀␀␀!¨␀␀¸©␀␀¸©␀␀␀␀␀ÿ␀␀ÿ␀s¬␀␀␀	Ôÿ␀␀␀␀␀b?‰#‰#Q␀Æÿ␀␀ÿ␀”¬␀␀Ôÿ?␀␀␀␀␀õ¯␀␀Yì␀␀‰±␀␀%␀␀␀ÿ␀␀ÿ␀ì¬␀␀Ôÿ?␀␀␀␀␀¨±␀␀y␀y␀%␀␀␀ÿ␀␀ÿ␀Õ¬␀␀Ôÿ?␀␀␀␀␀4±␀␀S¯␀␀‡)%␀␀␀ÿ␀␀ÿ␀À¬␀␀␀Ôÿ␀␀␀␀␀t±␀␀±¸␀␀±¸␀␀U␀␀Æÿ␀␀ÿ␀-ø	Ôÿ␀␀␀␀␀PAŸ␀␀Ÿ␀␀p␀Æÿ␀␀ÿ␀-.	Ôÿ␀␀␀␀␀¦␀␀¦␀␀¦␀␀p␀Æÿ␀␀ÿ␀5Â␀␀EÔÿ␀␀␀␀␀,Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀)+Ñ␀Ôÿ␀␀␀␀␀M&M&M&qC␀␀êÿ␀␀ÿ␀++Ñ␀Ôÿ␀␀␀␀␀U&U&U&qC␀␀êÿ␀␀ÿ␀,+Ç␀Ôÿ␀␀␀␀␀W&W&W&z␀Æÿ␀␀ÿ␀-+Ç␀Ôÿ␀␀␀␀␀Y&Y&Y&z␀Æÿ␀␀ÿ␀.+Ç␀Ôÿ␀␀␀␀␀[&[&[&z␀Æÿ␀␀ÿ␀/+Ç␀Ôÿ␀␀␀␀␀\&\&\&z␀Æÿ␀␀ÿ␀0+'Ôÿ␀␀␀␀␀]&]&]&D␀␀ÿ␀␀ÿ␀1+'Ôÿ␀␀␀␀␀^&^&^&D␀␀ÿ␀␀ÿ␀2+*Ôÿ␀␀␀␀␀_&_&_&,␀␀ÿ␀␀ÿ␀␀␀7å␀␀␀␀	0;1;2;3;4<å␀␀	SENIOR;0Z␀␀

TRIGGER R304AGE_SI AFTER INSERT ON R304AGE
DECLARE
	CURSOR c_R304AGE IS
	SELECT NUMEMP, TIPCOL, NUMCAD, NUMMAT, SEQREG
	  FROM R304AGE
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304AGE IS RECORD (
		NUMEMP   R304AGE.NumEmp%TYPE,
		TIPCOL   R304AGE.TipCol%TYPE,
		NUMCAD   R304AGE.NumCad%TYPE,
		NUMMAT   R304AGE.NumMat%TYPE,
		SEQREG   R304AGE.SeqReg%TYPE
	);
    
    l_R304AGE t_R304AGE;
    l_PidSta VARCHAR2(30);
    l_DesRes VARCHAR(250);
    l_DatZer DATE;
BEGIN
	FOREACH c_R304AGE INTO l_R304AGE.NumEmp, l_R304AGE.TipCol, l_R304AGE.NumCad, l_R304AGE.NumMat, l_R304AGE.SeqReg
	LOOP
		/* Gera um novo PID */
		SP_GERPIDSTA(l_R304AGE.NumEmp, 6, l_PidSta OUT);
				
		l_DesRes := 'Matrícula: ' || l_R304AGE.NumMat;
		l_DatZer := '31/12/1900,00:00:00';
		
		/* Inclui registro de status na tabela R304STA */
		SP_GERSTA_ESFINGE(6, l_PidSta, l_DatZer, l_DesRes, l_R304AGE.NumEmp, l_R304AGE.TipCol, l_R304AGE.NumCad);
		
		/* Altera registro recém inserido informando campo PID */
		BEGIN
			UPDATE R304AGE
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304AGE.NumEmp
			   AND TIPCOL = l_R304AGE.TipCol
			   AND NUMCAD = l_R304AGE.NumCad
			   AND NUMMAT = l_R304AGE.NumMat
			   AND SEQREG = l_R304AGE.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304AGE.';
		END;
	END LOOP;
END␀9å␀␀		SENIOR;0B␀␀TRIGGER R304AGE_EI BEFORE INSERT ON R304AGE FOR EACH ROW
DECLARE
	l_SeqReg NUMBER(9);
	l_StaEnv CHAR;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR(255);
BEGIN
	/* Busca a maior sequência cadastrada */
	BEGIN
		SELECT AGE.SEQREG INTO l_SeqReg FROM R304AGE AGE, R304STA STA
		 WHERE AGE.PIDSTA = STA.PIDSTA
		   AND AGE.NUMEMP = :NEW.NumEmp
		   AND AGE.TIPCOL = :NEW.TipCol
		   AND AGE.NUMCAD = :NEW.NumCad
		   AND AGE.NUMMAT = :NEW.NumMat
		   AND AGE.SEQREG = (SELECT MAX(AGE2.SEQREG) FROM R304AGE AGE2
		   					  WHERE AGE2.NUMEMP = AGE.NUMEMP
		   					    AND AGE2.TIPCOL = AGE.TIPCOL
		   					    AND AGE2.NUMCAD = AGE.NUMCAD
		   					    AND AGE2.NUMMAT = AGE.NUMMAT
		   					    AND AGE2.SEQREG <> :NEW.SeqReg);
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304AGE.';
	END;
	
	/* Verifica se encontrou última sequência */
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀:å␀␀		SENIOR;0•␀␀


TRIGGER R304AGE_EU BEFORE UPDATE ON R304AGE FOR EACH ROW
DECLARE
	l_StaEnv CHAR;
BEGIN
	/* Não deixa alterar registro caso status seja diferente de P - Pendente Envio e R - Erro */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro podem ser alterados/excluídos.';
	END IF;
END␀;å␀␀	SENIOR;0.␀␀

TRIGGER R304AGE_SD AFTER DELETE ON R304AGE
BEGIN
	BEGIN
		DELETE FROM R304STA
		 WHERE LAYOUT = 6
		   AND NOT EXISTS (SELECT 1 FROM R304AGE WHERE R304AGE.PIDSTA = R304STA.PIDSTA);
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao excluir registros não utilizados na tabela R304STA.';
	END;
END␀8å␀␀		SENIOR;0d

TRIGGER R304AGE_AD AFTER DELETE ON R304AGE FOR EACH ROW
BEGIN
	SP_EXCSTA_ESFINGE(:OLD.PidSta);
END␀␀␀-*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀=å␀␀…¬␀␀´␀	Ôÿ?ü␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀‚¬␀␀	Ôÿ?ü␀␀␀␀Ä±␀␀<¯␀␀\±␀␀%␀␀ÿ␀␀ÿ␀ˆ¬␀␀¼␀	Ôÿ?ü␀␀␀␀°␀␀=¯␀␀°␀␀v␀Æÿ␀␀ÿ␀š¬␀␀	Ôÿ␀␀␀␀␀°␀␀B¯␀␀°␀␀%␀␀ÿ␀␀ÿ␀␀¤	Ôÿ␀␀␀␀␀U␀U␀U␀p␀Æÿ␀␀ÿ␀U'	Ôÿ?␀␀␀␀␀ûAİ'	@%␀␀ÿ␀␀ÿ␀EÑ␀	Ôÿ␀␀␀␀␀+Kì”␀␀+KqC␀êÿ␀␀ÿ␀mDÑ␀	Ôÿ␀␀␀␀␀‡JşE‡JqC␀êÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀î␀ê	Ôÿ␀␀␀␀␀␀Î␀␀p␀Æÿ␀␀ÿ␀pEÑ␀Ôÿ␀␀␀␀␀ÀIEHÀIqC␀␀êÿ␀␀ÿ␀f´␀Ôÿ?␀␀␀␀␀÷<ïe»fr␀␀Æÿ␀␀)Ñ␀␀␀0,4Ôÿ?␀␀␀␀␀ÿ?µ'µ'}␀␀␀ÿ␀␀Ñ␀␀␀5Â␀␀EÔÿ␀␀␀␀␀,Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀)+Ñ␀Ôÿ␀␀␀␀␀M&M&M&qC␀␀êÿ␀␀ÿ␀++Ñ␀Ôÿ␀␀␀␀␀U&U&U&qC␀␀êÿ␀␀ÿ␀,+Ç␀Ôÿ␀␀␀␀␀W&W&W&z␀Æÿ␀␀ÿ␀-+Ç␀Ôÿ␀␀␀␀␀Y&Y&Y&z␀Æÿ␀␀ÿ␀.+Ç␀Ôÿ␀␀␀␀␀[&[&[&z␀Æÿ␀␀ÿ␀/+Ç␀Ôÿ␀␀␀␀␀\&\&\&z␀Æÿ␀␀ÿ␀0+'Ôÿ␀␀␀␀␀]&]&]&D␀␀ÿ␀␀ÿ␀1+'Ôÿ␀␀␀␀␀^&^&^&D␀␀ÿ␀␀ÿ␀2+*Ôÿ␀␀␀␀␀_&_&_&,␀␀ÿ␀␀ÿ␀␀␀>å␀␀␀␀0;1;2;3;4;5;6;7;8Bå␀␀	SENIOR;0K␀␀

TRIGGER R304ALT_SI AFTER INSERT ON R304ALT
DECLARE
	CURSOR c_R304ALT IS
	SELECT NUMEMP, NUMEDI, NUMESP, NUMINS, TIPQUA, CARFUN, DATINI, DATALT, SEQREG
	  FROM R304ALT
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304ALT IS RECORD (
		NUMEMP   R304ALT.NumEmp%TYPE,
		NUMEDI   R304ALT.NumEdi%TYPE,
		NUMESP   R304ALT.NumEsp%TYPE,
		NUMINS   R304ALT.NumIns%TYPE,
		TIPQUA   R304ALT.TipQua%TYPE,
		CARFUN   R304ALT.CarFun%TYPE,
		DATINI   R304ALT.DatIni%TYPE,
		DATALT   R304ALT.DatAlt%TYPE,
		SEQREG   R304ALT.SeqReg%TYPE
	);
	
	l_NumEmpAux   R304ALT.NumEmp%TYPE;
	l_NumEdiAux   R304ALT.NumEdi%TYPE;
    
    l_R304ALT t_R304ALT;
    
	l_PidSta VARCHAR2(30);
	l_DesRes VARCHAR(250);
BEGIN
	l_NumEmpAux := 0;
	l_NumEdiAux := '';
	l_PidSta := NULL;

	FOREACH c_R304ALT INTO l_R304ALT.NumEmp, l_R304ALT.NumEdi, l_R304ALT.NumEsp, l_R304ALT.NumIns, l_R304ALT.TipQua, l_R304ALT.CarFun, l_R304ALT.DatIni, l_R304ALT.DatAlt, l_R304ALT.SeqReg
	LOOP
		/* Se último registro se tratava do mesmo edital, utiliza o PID encontrando anteriormente */
		IF ((l_R304ALT.NumEmp <> l_NumEmpAux) OR (l_R304ALT.NumEdi <> l_NumEdiAux)) THEN
			l_PidSta := NULL;
		END IF;
		
		/* Verifica se já tem algum outro registro do mesmo edital que esteja pendente (P - Pendente Envio ou R - Erro Envio) */
		IF (l_PidSta IS NULL) THEN
			BEGIN
				SELECT DISTINCT R304ALT.PIDSTA INTO l_PidSta
				  FROM R304ALT, R304STA
				 WHERE R304ALT.PIDSTA = R304STA.PIDSTA
				   AND R304ALT.NUMEMP = l_R304ALT.NumEmp
				   AND R304ALT.NUMEDI = l_R304ALT.NumEdi
				   AND (R304STA.STAENV = 'P' OR R304STA.STAENV = 'R');
			EXCEPTION
				WHEN NO_DATA_FOUND THEN
					l_PidSta := NULL;
				WHEN TOO_MANY_ROWS THEN
					RAISERROR 103 'Foi encontrado mais de um registro de status Pendente Envio e/ou Erro para o mesmo edital.';	
				WHEN OTHERS THEN
					RAISERROR 103 'Erro ao buscar PID já existente para o mesmo edital.';
			END;
		END IF;
		
		/* Se não encontrou PID do mesmo edital gera um novo */
		IF (l_PidSta IS NULL) THEN
			/* Gera um novo PID */
			SP_GERPIDSTA(l_R304ALT.NumEmp, 5, l_PidSta OUT);
				
			l_DesRes := 'Número do Edital: ' || l_R304ALT.NumEdi;
			
			/* Inclui registro de status na tabela R304STA */			
			SP_GERSTA_ESFINGE(5, l_PidSta, l_R304ALT.DatAlt, l_DesRes, l_R304ALT.NumEmp, 0, 0);
		END IF;
		
		BEGIN
			UPDATE R304ALT
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304ALT.NumEmp
			   AND NUMEDI = l_R304ALT.NumEdi
			   AND NUMESP = l_R304ALT.NumEsp
			   AND NUMINS = l_R304ALT.NumIns
			   AND TIPQUA = l_R304ALT.TipQua
			   AND CARFUN = l_R304ALT.CarFun
			   AND DATINI = l_R304ALT.DatIni
			   AND DATALT = l_R304ALT.DatAlt
			   AND SEQREG = l_R304ALT.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304ALT.';
		END;
		
		l_NumEmpAux := l_R304ALT.NumEmp;
		l_NumEdiAux := l_R304ALT.NumEdi;
	END LOOP;
END␀?å␀␀		SENIOR;0
␀␀TRIGGER R304ALT_EI BEFORE INSERT ON R304ALT FOR EACH ROW
DECLARE
	l_QtdReg NUMBER;
	l_SeqReg NUMBER(9);
	l_StaEnv CHAR;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR(255);
BEGIN
	/* Verifica se já existe o concurso/processo seletivo na R304CON */
	BEGIN
		SELECT COUNT(1) INTO l_QtdReg FROM R304CON WHERE NUMEMP = :NEW.NumEmp AND NUMEDI = :NEW.NumEdi;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_QtdReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao verificar se já existe registro de Concurso/Processo Seletivo.';
	END;
	
	IF (l_QtdReg = 0) THEN
		l_MsgErr := 'Não existe registro de Concurso/Processo Seletivo com as seguintes chaves: ' ||
			'Empresa: ' || CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp) || ', Edital: ' || :NEW.NumEdi || '.';
		RAISERROR 103 l_MsgErr;
	END IF;

	/* Busca última sequência cadastrada */
	BEGIN
		SELECT ALT.SEQREG, STA.STAENV INTO l_SeqReg, l_StaEnv FROM R304ALT ALT, R304STA STA
		 WHERE ALT.NUMEMP = :NEW.NumEmp
		   AND ALT.NUMEDI = :NEW.NumEdi
		   AND ALT.NUMESP = :NEW.NumEsp
		   AND ALT.NUMINS = :NEW.NumIns
		   AND ALT.TIPQUA = :NEW.TipQua
		   AND ALT.CARFUN = :NEW.CarFun
		   AND ALT.DATINI = :NEW.DatIni
		   AND ALT.DATALT = :NEW.DatAlt
		   AND ALT.PIDSTA = STA.PIDSTA
		   AND ALT.SEQREG = (SELECT MAX(ALT2.SEQREG) FROM R304ALT ALT2
		 					  WHERE ALT2.NUMEMP = ALT.NUMEMP
		 					    AND ALT2.NUMEDI = ALT.NUMEDI
		 					    AND ALT2.NUMESP = ALT.NUMESP
		 					    AND ALT2.NUMINS = ALT.NUMINS
		 					    AND ALT2.TIPQUA = ALT.TIPQUA
		 					    AND ALT2.CARFUN = ALT.CARFUN
		 					    AND ALT2.DATINI = ALT.DATINI
		 					    AND ALT2.DATALT = ALT.DATALT);
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
			l_StaEnv := '';
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304ALT.';
	END;
	
	/* Verifica se encontrou última sequência */
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
		
		/* Verifica se a última sequência está com status Cancelado */
		IF (l_StaEnv <> 'N') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que registro de sequência anterior ' || l_SeqRegStr || ' esteja com status Cancelado.';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀@å␀␀		SENIOR;0”␀␀

TRIGGER R304ALT_EU BEFORE UPDATE ON R304ALT FOR EACH ROW
DECLARE
	l_StaEnv CHAR;
BEGIN
	/* Não deixa alterar registro caso status seja diferente de P - Pendente Envio e R - Erro */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro podem ser alterados/excluídos.';
	END IF;
END␀Aå␀␀	SENIOR;0/␀␀


TRIGGER R304ALT_SD AFTER DELETE ON R304ALT
BEGIN
	BEGIN
		DELETE FROM R304STA
		 WHERE LAYOUT = 5
		   AND NOT EXISTS (SELECT 1 FROM R304ALT WHERE R304ALT.PIDSTA = R304STA.PIDSTA);
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao excluir registros não utilizados na tabela R304STA.';
	END;
END␀␀␀*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Cå␀␀…¬␀␀´␀	Ôÿ?ü␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀Õ-Ì␀Ôÿ␀␀␀␀␀4>Í␀4>{␀␀Æÿ␀␀ÿ␀â§␀␀Ôÿ␀␀␀␀␀“␀“␀“␀␀␀␀ÿ␀␀ÿ␀„û␀␀Ôÿ␀␀␀␀␀©û␀␀©û␀␀©û␀␀␀␀␀ÿ␀␀ÿ␀ï␀Ôÿ?␀␀␀␀␀␀␀␀n␀␀Æÿ␀␀ÿ␀û␀Ôÿ␀␀␀␀␀ú␀ú␀ú␀!␀␀␀ÿ␀␀ÿ␀)+Ñ␀Ôÿ␀␀␀␀␀M&M&M&qC␀␀êÿ␀␀ÿ␀++Ñ␀Ôÿ␀␀␀␀␀U&U&U&qC␀␀êÿ␀␀ÿ␀,+Ç␀Ôÿ␀␀␀␀␀W&W&W&z␀Æÿ␀␀ÿ␀-+Ç␀Ôÿ␀␀␀␀␀Y&Y&Y&z␀Æÿ␀␀ÿ␀.+Ç␀Ôÿ␀␀␀␀␀[&[&[&z␀Æÿ␀␀ÿ␀/+Ç␀Ôÿ␀␀␀␀␀\&\&\&z␀Æÿ␀␀ÿ␀0+'Ôÿ␀␀␀␀␀]&]&]&D␀␀ÿ␀␀ÿ␀1+'Ôÿ␀␀␀␀␀^&^&^&D␀␀ÿ␀␀ÿ␀2+*Ôÿ␀␀␀␀␀_&_&_&,␀␀ÿ␀␀ÿ␀EÑ␀Ôÿ␀␀␀␀␀?L¢G¢Gœ␀␀␀êÿ␀␀ÿ␀ı␀2Ôÿ␀␀␀␀␀¶␀␀%␀p␀Æÿ␀␀ÿ␀j␀¶Ôÿ␀␀␀␀␀ß␀G␀»␀p␀Æÿ␀␀ÿ␀<1­␀Ôÿ␀␀␀␀␀2Ë␀␀\\p␀Æÿ␀␀ÿ30␀␀␀0␀␀1*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Då␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀[¬␀␀	Ôÿ?␀␀␀␀␀¯±␀␀3¯␀␀±␀␀%␀␀ÿ␀␀ÿ␀}DÑ␀	Ôÿ?␀␀␀␀␀^M!FğLqC␀êÿ␀␀ÿ␀ª¬␀␀	Ôÿ?␀␀␀␀␀R°␀␀H¯␀␀°␀␀%␀␀ÿ␀␀ÿ␀s¬␀␀␀	Ôÿ?␀␀␀␀␀¥?c°␀␀c°␀␀Q␀Æÿ␀␀ÿ␀Ö-¦␀	Ôÿ?␀␀␀␀␀-?:5>j␀Æÿ␀␀ÿ␀ú7␀	Ôÿ?␀␀␀␀␀¦?c°␀␀d°␀␀Q␀Æÿ␀␀ÿ␀¬ü␀␀Ç␀	Ôÿ?␀␀␀␀␀qş␀␀mş␀␀oş␀␀z␀Æÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀C§␀␀Ôÿ?␀␀␀␀␀ş©␀␀Q©␀␀Q©␀␀␀␀ÿ␀␀ÿ␀“DÑ␀Ôÿ?␀␀␀␀␀J_I_IqC␀êÿ␀␀ÿ␀ ␀£␀Ôÿ?␀␀␀␀␀í"␀"␀"␀l)␀␀Æÿ␀␀ÿ␀<EÑ␀Ôÿ␀␀␀␀␀kLHRKqC␀êÿ␀␀ÿ␀G␀-Ôÿ?␀␀␀␀␀d␀"␀$␀p␀Æÿ␀␀ÿ␀Š␀␀=Ôÿ?␀␀␀␀␀ˆ␀␀␀␀n␀␀c␀␀␀ÿ␀␀ÿ␀
