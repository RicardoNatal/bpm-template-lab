TRIGGER R004HOR_SU AFTER UPDATE ON R004HOR FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);  
  l_Valor2 VARCHAR2(2000);
  l_Valido BOOLEAN;
  l_Empresa NUMBER;
  CURSOR c_Empresa IS
    SELECT NUMEMP
    FROM R030EMP
    ORDER BY NUMEMP;
  l_AlterouHorario BOOLEAN;
  l_DataReferencia DATE;
BEGIN
  RH_250ALT(33);
  RH_250ALT(34);

  l_Valido := FALSE;
  SP_VALUPDATE_DES(:OLD.FLEESO, :NEW.FLEESO, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouHorario := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.TIPINT, :NEW.TIPINT, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouHorario := TRUE;
  END IF;

  IF (l_AlterouHorario = TRUE) THEN
    FOREACH c_Empresa INTO l_Empresa
    LOOP
      l_Valor := '';
      SP_CONCATENAR_NUM('CODHOR', :NEW.CODHOR, l_Valor OUT);
      l_DataReferencia := CURDATE();           
      SP_CONCATENAR_DAT('DATALT', l_DataReferencia, l_Valor OUT);
      
      l_Valor2 := '';
       SP_CONCATENAR_NUM('CODHOR', :OLD.CODHOR, l_Valor2 OUT);

      SP_ESOCIAL_1050(l_Empresa, 'R004HOR', 'A', l_Valor, l_Valor2, 0, 'R004HOR_SU' );

    END LOOP;
  END IF;
END␀gÎ␀␀		SENIOR;0i

