SP_MILLISECOND
—␀␀PROCEDURE SP_R350PEM(P_NUMEMP NUMBER(4),P_CODFIL NUMBER(6),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_CMPREF DATE,P_TIPFOL NUMBER(1),P_ORIPEM NUMBER(1),P_VALIDAESOCIAL NUMBER(1), P_LAYOUT VARCHAR(6))
 IS

  l_DataInicioTabelas DATE;
  l_DataInicioEsocial DATE;
  l_DataInicioNaoPeriodicos DATE;
  l_DataInicioPeriodicos DATE;
  l_DataInicioSST DATE;
  l_DataAtual DATE;
  l_CmpDataInicio DATE;
  l_DataStr VARCHAR2(8);
  l_HoraStr VARCHAR2(2);
  l_MinutoStr VARCHAR2(2);
  l_SegundoStr VARCHAR2(2);
  l_Milisegundo NUMBER;
  l_MilisegundoStr VARCHAR2(3);  
  l_Contador NUMBER(4);
  l_ContadorStr VARCHAR2(4);
  l_PidPem VARCHAR2(35);
  l_ChaveExiste VARCHAR2(1);
  l_EmpresaStr VARCHAR2(4);
  l_TipColStr VARCHAR2(1);
  l_NumCadStr VARCHAR2(9);
  l_DataInicioMigracao DATE;
BEGIN
	
	IF (p_Tipcol <> 3) THEN
		IF (p_ValidaESocial = 1) THEN
			RH_DEF_ESOCIAL(p_NumEmp, l_DataInicioTabelas OUT, l_DataInicioEsocial OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);   
			l_CmpDataInicio := DATETIME(1,MONTH(l_DataInicioEsocial),YEAR(l_DataInicioEsocial),0,0,0);			
		ELSE
			l_CmpDataInicio := p_CmpRef;
		END IF;		
		IF (p_CmpRef >= l_CmpDataInicio) THEN		
			l_HoraStr := CONVERT(NUMBER_TO_CHAR, HOUR(CURTIME()));
			l_MinutoStr := CONVERT(NUMBER_TO_CHAR, MINUTE(CURTIME()));
			l_ChaveExiste := NULL;
			l_Contador := 1;		
			l_DataAtual := CURDATE();		
			SP_DATSTR(l_DataAtual, 'YYYYMMDD', l_DataStr OUT);
			
			IF (LENGTH(l_HoraStr)) = 1 THEN
				l_HoraStr := '0' || l_HoraStr;
			END IF;
			
			IF (LENGTH(l_MinutoStr)) = 1 THEN
				l_MinutoStr := '0' || l_MinutoStr;
			END IF;
			
			l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, p_NumEmp);
			IF (LENGTH(l_EmpresaStr)) = 1 THEN
				l_EmpresaStr := '000' || l_EmpresaStr;
			END IF;	
			IF (LENGTH(l_EmpresaStr)) = 2 THEN						
				l_EmpresaStr := '00' || l_EmpresaStr;
			END IF;	
			IF (LENGTH(l_EmpresaStr)) = 3 THEN						
				l_EmpresaStr := '0' || l_EmpresaStr;						
			END IF;
			
			l_TipColStr := CONVERT(NUMBER_TO_CHAR, p_TipCol);						
			
			l_NumCadStr := CONVERT(NUMBER_TO_CHAR, p_NumCad);
			IF (LENGTH(l_NumCadStr)) = 1 THEN
				l_NumCadStr := '00000000' || l_NumCadStr;
			END IF;	
			IF (LENGTH(l_NumCadStr)) = 2 THEN						
				l_NumCadStr := '0000000' || l_NumCadStr;
			END IF;	
			IF (LENGTH(l_NumCadStr)) = 3 THEN						
				l_NumCadStr := '000000' || l_NumCadStr;						
			END IF;
			IF (LENGTH(l_NumCadStr)) = 4 THEN						
				l_NumCadStr := '00000' || l_NumCadStr;						
			END IF;
			IF (LENGTH(l_NumCadStr)) = 5 THEN						
				l_NumCadStr := '0000' || l_NumCadStr;						
			END IF;
			IF (LENGTH(l_NumCadStr)) = 6 THEN						
				l_NumCadStr := '000' || l_NumCadStr;						
			END IF;			
			IF (LENGTH(l_NumCadStr)) = 7 THEN						
				l_NumCadStr := '00' || l_NumCadStr;						
			END IF;			
			IF (LENGTH(l_NumCadStr)) = 8 THEN						
				l_NumCadStr := '0' || l_NumCadStr;						
			END IF;			
	   
			WHILE ((l_ChaveExiste = 'S') OR (l_ChaveExiste IS NULL)) LOOP
				l_SegundoStr := CONVERT(NUMBER_TO_CHAR, SECOND(CURTIME()));
				IF (LENGTH(l_SegundoStr)) = 1 THEN
					l_SegundoStr := '0' || l_SegundoStr;
				END IF;
				
				SP_MILLISECOND(l_Milisegundo OUT, 3);
				l_MilisegundoStr := CONVERT(NUMBER_TO_CHAR, l_Milisegundo);
				IF (LENGTH(l_MilisegundoStr)) = 1 THEN
					l_MilisegundoStr := '00' || l_MilisegundoStr;
				END IF;	
				IF (LENGTH(l_MilisegundoStr)) = 2 THEN
					l_MilisegundoStr := '0' || l_MilisegundoStr;
				END IF;
				
				l_ContadorStr := CONVERT(NUMBER_TO_CHAR, l_Contador);
				IF (LENGTH(l_ContadorStr)) = 1 THEN
					l_ContadorStr := '000' || l_ContadorStr;	
				END IF;	
				IF (LENGTH(l_ContadorStr)) = 2 THEN						
					l_ContadorStr := '00' || l_ContadorStr;
				END IF;	
				IF (LENGTH(l_ContadorStr)) = 3 THEN						
					l_ContadorStr := '0' || l_ContadorStr;						
				END IF;
				
				l_PidPem := l_EmpresaStr || l_TipColStr || l_NumCadStr || l_DataStr || l_HoraStr || l_MinutoStr || l_SegundoStr || l_MilisegundoStr || l_ContadorStr;  
				
				BEGIN
					SELECT 'S' INTO l_ChaveExiste
						FROM R350PEM 
					 WHERE PIDPEM = l_PidPem;
					
					IF (l_ChaveExiste = 'S') THEN
						l_Contador := l_Contador + 1;
					ELSE
						l_ChaveExiste := 'N';
					END IF;
				EXCEPTION
					WHEN NO_DATA_FOUND THEN
						l_ChaveExiste := 'N';
				END;
			END LOOP;

			BEGIN
				INSERT INTO R350PEM(PidPem, NumEmp, CodFil, TipCol, NumCad, CmpRef, TipFol, OriPem, LayOut) 
						 VALUES(l_PidPem, p_NumEmp, p_CodFil, p_TipCol, p_NumCad, p_CmpRef, p_TipFol, p_OriPem, p_LayOut);
			EXCEPTION
				WHEN DUPVALONINDEX THEN
					RAISERROR 103 'Erro ao inserir registro duplicado na tabela de pendências de envio - declaração mensal - eSocial.';
				WHEN OTHERS THEN
					RAISERROR 103 'Erro ao inserir registro na tabela de pendências de envio - declaração mensal - eSocial.';
			END;
		END IF;
	END IF;
END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
kPROCEDURE SP_RECALF_E_CRACOL(P_NUMEMP NUMBER, P_TIPCOL NUMBER, P_NUMCAD NUMBER)
 IS
BEGIN
    NULL;
END		SENIOR;20SP_PENDADE02
E	␀␀

PROCEDURE SP_RECALF_E_CRACOL(P_NUMEMP NUMBER, P_TIPCOL NUMBER, P_NUMCAD NUMBER)
 IS

    CURSOR C_R151CCR IS
      SELECT DATINI, HORINI, TIPCRA, CODREC, VERPLF, CODPLF, PROTCL FROM R151CCR
       WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND STAREC = 1;

    TYPE T_R151CCR IS RECORD (
      DATINI   R151CCR.DATINI%TYPE,
      HORINI   R151CCR.HORINI%TYPE,
      TIPCRA   R151CCR.TIPCRA%TYPE,
      CODREC   R151CCR.CODREC%TYPE,
      VERPLF   R151CCR.VERPLF%TYPE,
      CODPLF   R151CCR.CODPLF%TYPE,
      PROTCL   R151CCR.PROTCL%TYPE);

    l_codpen NUMBER(18);
    l_151ccr T_R151CCR;
BEGIN
    /* Busco todos os recintos por crachá do colaborador, para gerar pendência de exclusão */
    FOREACH C_R151CCR INTO l_151ccr.DATINI,
                           l_151ccr.HORINI,
                           l_151ccr.TIPCRA,
                           l_151ccr.CODREC,
                           l_151ccr.VERPLF,
                           l_151ccr.CODPLF,
                           l_151ccr.PROTCL
    LOOP
        SP_PENDADE02(1, 'E', l_151ccr.VERPLF, l_151ccr.CODPLF, l_151ccr.CODREC, l_codpen OUT);

        BEGIN
            INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                VALUES (l_codpen, p_tipcol, p_numemp, p_tipcol, p_numcad, NULL, NULL, l_151ccr.DATINI, l_151ccr.HORINI, l_151ccr.TIPCRA, NULL, l_151ccr.PROTCL);
        EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'SP_RECALF_E_CRACOL: Erro ao inserir pendência de exclusão de Credenciamento de Pessoas';
        END;
    END LOOP;

    /* Excluo todos os registros de recintos por crachá, do colaborador */
    BEGIN
        DELETE FROM R151CCR WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND STAREC = 1;
    EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'SP_RECALF_E_CRACOL: Erro ao excluir os crachás do colaborador na R151CCR.';
