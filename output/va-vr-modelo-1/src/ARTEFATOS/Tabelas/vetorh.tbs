TRIGGER R090VIS_EI BEFORE INSERT ON R090VIS FOR EACH ROW
DECLARE
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_IDTPES       VARCHAR(23);
BEGIN
  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090VIS');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R090VIS_AUD (SEQREG,VERSEQ,TIPDOC,NUMDOC,NOMVIS,CODOEM,NOMOEM,CODPRM,DDITEL,DDDTEL,
                                   TELCON,SEGTDO,SEGDOC,NUMCNH,CATCNH,DATCNH,VENCNH,OBSVIS,DATVID,
                                   DATFOT,FLAFOT,DATRGV,EMICID,ESTCID,DEXCID,CONTPM,CODNAC,UTICHV,
                                   DATNAS,TIPSEX,FUNVIS,QUAVIS,DVADOC,PAIDOC,STAALF)
                           VALUES (l_seqreg,l_verseq,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NOMVIS,:NEW.CODOEM,:NEW.NOMOEM,
                                  :NEW.CODPRM,:NEW.DDITEL,:NEW.DDDTEL,:NEW.TELCON,:NEW.SEGTDO,:NEW.SEGDOC,
                                  :NEW.NUMCNH,:NEW.CATCNH,:NEW.DATCNH,:NEW.VENCNH,:NEW.OBSVIS,
                                  :NEW.DATVID,:NEW.DATFOT,:NEW.FLAFOT,:NEW.DATRGV,:NEW.EMICID,:NEW.ESTCID,
                                  :NEW.DEXCID,:NEW.CONTPM,:NEW.CODNAC,:NEW.UTICHV,:NEW.DATNAS,:NEW.TIPSEX,
                                  :NEW.FUNVIS,:NEW.QUAVIS,:NEW.DVADOC,:NEW.PAIDOC,:NEW.STAALF);

          SP_AUDGENREG(l_seqreg,l_verseq,'R090VIS','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            NULL; /* Erro em auditoria não pode parar o cadastro todo. */
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
  
  SP_RETIDTPES(NULL, 4, NULL, :NEW.TIPDOC, :NEW.NUMDOC, NULL, NULL, l_IDTPES OUT);
  SP_SAM_PENDENCIES(7, 1, l_IDTPES);
  SP_SAM_PENDENCIES(30, 1, l_IDTPES);
END␀zİ␀␀		SENIOR;0}2␀␀

TRIGGER R090VIS_EU AFTER UPDATE ON R090VIS FOR EACH ROW
DECLARE
  l_online           BOOLEAN;
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_tippes           VARCHAR2(2);
  l_tipdoc           CHAR(1);
  l_numdoc           VARCHAR2(20);
  l_idtpes           VARCHAR2(23);
  l_tipdoccon        NUMBER(1);
  l_numdoccon        VARCHAR2(20);
  l_segtdo           NUMBER(1);
  l_segdoc           VARCHAR2(20);
  l_nompes           VARCHAR2(40);
  l_ddifon           NUMBER(3);
  l_dddfon           NUMBER(3);
  l_numfon           VARCHAR2(20);
BEGIN
  IF (:NEW.CODPRM <> :OLD.CODPRM) THEN
       SP_VerOnLine(l_online OUT);
       IF   (l_online = TRUE) THEN
             R090VIS_ATUCON (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.CODPRM);
       END IF;
  END IF;

  /*INICIO Atualiza o TIPDOC e NUMDOC da R070CON*/
  /*Somente se alterado o segundo documento*/
  IF (:OLD.SEGTDO <> :NEW.SEGTDO) OR (:OLD.SEGDOC <> :OLD.SEGDOC) THEN
      l_numdoc := :NEW.NUMDOC;
      l_tippes:= '04';
      SP_INTSTR(:NEW.TIPDOC, '9', l_tipdoc OUT);

      /*Monta o Identificador da Pessoa*/
      l_idtpes := l_tippes||l_tipdoc||l_numdoc;

      /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_idtpes) > 22) THEN
              EXIT;
          END IF;
          l_idtpes := ' '||l_idtpes;
      END LOOP;

      /*Inicializa o tipo e o documento para atualizar a r070con*/
      l_tipdoccon := 0;
      l_numdoccon := '0';
      l_segtdo := :NEW.SEGTDO;
      l_segdoc := :NEW.SEGDOC;

      /*Atribui os valores dando prioridade ao CPF*/
      IF (l_tipdoc = '2') THEN
          /*Primeiro doc CPF*/
          l_tipdoccon := 2;
          l_numdoccon := l_numdoc;
      ELSE
          /*Segundo doc CPF*/
          IF (l_segtdo = 2) THEN
              l_tipdoccon := 2;
              l_numdoccon := l_segdoc;
          ELSE
              /*Primeiro doc Registro Estrangeiro ou Passaporte e o segundo documento não for Registro Estrangeiro*/
              IF ((l_tipdoc = '7') OR (l_tipdoc = '4' AND l_segtdo <> 7)) THEN
                  l_tipdoccon := 4;
                  l_numdoccon := l_numdoc;
              ELSE
                  /*Segundo doc Registro Estrangeiro ou Passaporte*/
                  IF (l_segtdo = 7 OR l_segtdo = 4) THEN
                      l_tipdoccon := 4;
                      l_numdoccon := l_segdoc;           
                  END IF;
              END IF;
          END IF;
      END IF;

      /*Atualiza o TIPDOC e NUMDOC da R070CON pelo IDTPES*/
      UPDATE R070CON SET
          TIPDOC = l_tipdoccon, NUMDOC = l_numdoccon
      WHERE IDTPES = l_idtpes;
  END IF;
  /*FIM Atualiza o TIPDOC e NUMDOC da R070CON*/

  /*INICIO Atualiza DDI, DDD, Fone e NomePes da R070CON*/
  IF (:OLD.NOMVIS <> :NEW.NOMVIS) OR
     (:OLD.DDITEL <> :NEW.DDITEL) OR
     (:OLD.DDDTEL <> :NEW.DDDTEL) OR
     (:OLD.TELCON <> :NEW.TELCON) THEN

      SP_VerOnLine(l_online OUT);
      IF   (l_online = TRUE) THEN
        l_numdoc := :NEW.NUMDOC;
        l_tippes:= '04';
        SP_INTSTR(:NEW.TIPDOC, '9', l_tipdoc OUT);

        /*Monta o Identificador da Pessoa*/
        l_idtpes := l_tippes||l_tipdoc||l_numdoc;

        /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
        l_idtpes := lTrim(l_idtpes);
        l_idtpes := rTrim(l_idtpes);
        LOOP
            /*Controle do Loop.*/
            IF (Length(l_idtpes) > 22) THEN
                EXIT;
            END IF;
            l_idtpes := ' '||l_idtpes;
        END LOOP;

        SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

        /*Atualiza o TIPDOC e NUMDOC da R070CON pelo IDTPES*/
        UPDATE R070CON SET
            NOMPES = l_nompes, DDIFON = l_ddifon, DDDFON = l_dddfon, NUMFON = l_numfon
        WHERE IDTPES = l_idtpes;
    END IF;
  END IF;
  /*FIM Atualiza DDI, DDD, Fone e NomePes da R070CON*/

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090VIS');

  IF (l_auditoria = 'S') THEN

       l_camposAlterados := 'Campo(s) alterado(s): ';
       l_alterou := FALSE;

      IF (:NEW.TIPDOC <> :OLD.TIPDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPDOC ';
      END IF;

      IF (:NEW.NUMDOC <> :OLD.NUMDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMDOC ';
      END IF;

      IF (:NEW.NOMVIS <> :OLD.NOMVIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NOMVIS ';
      END IF;

      IF (:NEW.CODOEM <> :OLD.CODOEM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODOEM ';
      END IF;

      IF (:NEW.NOMOEM <> :OLD.NOMOEM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NOMOEM ';
      END IF;

      IF (:NEW.CODPRM <> :OLD.CODPRM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPRM ';
      END IF;

      IF (:NEW.DDITEL <> :OLD.DDITEL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DDITEL ';
      END IF;

      IF (:NEW.DDDTEL <> :OLD.DDDTEL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DDDTEL ';
      END IF;

      IF (:NEW.TELCON <> :OLD.TELCON) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TELCON ';
      END IF;

      IF (:NEW.SEGTDO <> :OLD.SEGTDO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEGTDO ';
      END IF;

      IF (:NEW.SEGDOC <> :OLD.SEGDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEGDOC ';
      END IF;

      IF (:NEW.NUMCNH <> :OLD.NUMCNH) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCNH ';
      END IF;

      IF (:NEW.CATCNH <> :OLD.CATCNH) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CATCNH ';
      END IF;

      IF (:NEW.DATCNH <> :OLD.DATCNH) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATCNH ';
      END IF;

      IF (:NEW.VENCNH <> :OLD.VENCNH) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'VENCNH ';
      END IF;

      IF (:NEW.OBSVIS <> :OLD.OBSVIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'OBSVIS ';
      END IF;

      IF (:NEW.DATVID <> :OLD.DATVID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATVID ';
      END IF;

      IF ((:NEW.DATFOT <> :OLD.DATFOT) OR (:OLD.DATFOT IS NULL AND :NEW.DATFOT IS NOT NULL) OR (:NEW.DATFOT IS NULL AND :OLD.DATFOT IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATFOT ';
      END IF;

      IF (:NEW.FLAFOT <> :OLD.FLAFOT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'FLAFOT ';
      END IF;

      IF (:NEW.DATRGV <> :OLD.DATRGV) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATRGV ';
      END IF;

      IF (:NEW.EMICID <> :OLD.EMICID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'EMICID ';
      END IF;

      IF (:NEW.ESTCID <> :OLD.ESTCID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'ESTCID ';
      END IF;

      IF (:NEW.DEXCID <> :OLD.DEXCID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DEXCID ';
      END IF;

      IF (:NEW.CONTPM <> :OLD.CONTPM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CONTPM ';
      END IF;

      IF (:NEW.CODNAC <> :OLD.CODNAC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODNAC ';
      END IF;

      IF (:NEW.UTICHV <> :OLD.UTICHV) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'UTICHV ';
      END IF;

      IF ((:NEW.DATNAS <> :OLD.DATNAS) OR (:OLD.DATNAS IS NULL AND :NEW.DATNAS IS NOT NULL) OR (:NEW.DATNAS IS NULL AND :OLD.DATNAS IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATNAS ';
      END IF;

      IF ((:NEW.TIPSEX <> :OLD.TIPSEX) OR (:OLD.TIPSEX IS NULL AND :NEW.TIPSEX IS NOT NULL) OR (:NEW.TIPSEX IS NULL AND :OLD.TIPSEX IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPSEX ';
      END IF;

      IF ((:NEW.FUNVIS <> :OLD.FUNVIS) OR (:OLD.FUNVIS IS NULL AND :NEW.FUNVIS IS NOT NULL) OR (:NEW.FUNVIS IS NULL AND :OLD.FUNVIS IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'FUNVIS ';
      END IF;

      IF ((:NEW.QUAVIS <> :OLD.QUAVIS) OR (:OLD.QUAVIS IS NULL AND :NEW.QUAVIS IS NOT NULL) OR (:NEW.QUAVIS IS NULL AND :OLD.QUAVIS IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'QUAVIS ';
      END IF;

      IF ((:NEW.DVADOC <> :OLD.DVADOC) OR (:OLD.DVADOC IS NULL AND :NEW.DVADOC IS NOT NULL) OR (:NEW.DVADOC IS NULL AND :OLD.DVADOC IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DVADOC ';
      END IF;

      IF ((:NEW.PAIDOC <> :OLD.PAIDOC) OR (:OLD.PAIDOC IS NULL AND :NEW.PAIDOC IS NOT NULL) OR (:NEW.PAIDOC IS NULL AND :OLD.PAIDOC IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PAIDOC ';
      END IF;

      IF ((:NEW.STAALF <> :OLD.STAALF) OR (:OLD.STAALF IS NULL AND :NEW.STAALF IS NOT NULL) OR (:NEW.STAALF IS NULL AND :OLD.STAALF IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'STAALF ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R090VIS_AUD
                   WHERE TIPDOC = :OLD.TIPDOC AND
                         NUMDOC = :OLD.NUMDOC;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R090VIS_AUD (SEQREG,VERSEQ,TIPDOC,NUMDOC,NOMVIS,CODOEM,NOMOEM,CODPRM,DDITEL,DDDTEL,
                                       TELCON,SEGTDO,SEGDOC,NUMCNH,CATCNH,DATCNH,VENCNH,OBSVIS,DATVID,
                                       DATFOT,FLAFOT,DATRGV,EMICID,ESTCID,DEXCID,CONTPM,CODNAC,UTICHV,
                                       DATNAS,TIPSEX,FUNVIS,QUAVIS,DVADOC,PAIDOC,STAALF)
                               VALUES (l_seqreg,l_verseq,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NOMVIS,:NEW.CODOEM,:NEW.NOMOEM,
                                      :NEW.CODPRM,:NEW.DDITEL,:NEW.DDDTEL,:NEW.TELCON,:NEW.SEGTDO,:NEW.SEGDOC,
                                      :NEW.NUMCNH,:NEW.CATCNH,:NEW.DATCNH,:NEW.VENCNH,:NEW.OBSVIS,
                                      :NEW.DATVID,:NEW.DATFOT,:NEW.FLAFOT,:NEW.DATRGV,:NEW.EMICID,:NEW.ESTCID,
                                      :NEW.DEXCID,:NEW.CONTPM,:NEW.CODNAC,:NEW.UTICHV,:NEW.DATNAS,:NEW.TIPSEX,
                                      :NEW.FUNVIS,:NEW.QUAVIS,:NEW.DVADOC,:NEW.PAIDOC,:NEW.STAALF);

              SP_AUDGENREG(l_seqreg,l_verseq,'R090VIS',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  SP_RETIDTPES(NULL, 4, NULL, :NEW.TIPDOC, :NEW.NUMDOC, NULL, NULL, l_IDTPES OUT);
  SP_SAM_PENDENCIES(7, 2, l_IDTPES);

  IF ((:NEW.DATFOT <> :OLD.DATFOT) OR (:OLD.DATFOT IS NULL AND :NEW.DATFOT IS NOT NULL) OR (:NEW.DATFOT IS NULL AND :OLD.DATFOT IS NOT NULL)) THEN
      SP_SAM_PENDENCIES(30, 2, l_IDTPES);
  END IF;

  /* ATUALIZAÇÃO DO NOME NA TABELA R158PES */
  IF (:NEW.NOMVIS <> :OLD.NOMVIS) THEN
      SP_ATUNOMPES(l_IDTPES, :NEW.NOMVIS);
  END IF;
END		SENIOR;20é1␀␀TRIGGER R090VIS_EU AFTER UPDATE ON R090VIS FOR EACH ROW
DECLARE
  l_online           BOOLEAN;
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_tippes           VARCHAR2(2);
  l_tipdoc           CHAR(1);
  l_numdoc           VARCHAR2(20);
  l_idtpes           VARCHAR2(23);
  l_tipdoccon        NUMBER(1);
  l_numdoccon        VARCHAR2(20);
  l_segtdo           NUMBER(1);
  l_segdoc           VARCHAR2(20);
  l_nompes           VARCHAR2(40);
  l_ddifon           NUMBER(3);
  l_dddfon           NUMBER(3);
  l_numfon           VARCHAR2(20);
BEGIN
  IF (:NEW.CODPRM <> :OLD.CODPRM) THEN
       SP_VerOnLine(l_online OUT);
       IF   (l_online = TRUE) THEN
             R090VIS_ATUCON (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.CODPRM);
       END IF;
  END IF;

  /*INICIO Atualiza o TIPDOC e NUMDOC da R070CON*/
  /*Somente se alterado o segundo documento*/
  IF (:OLD.SEGTDO <> :NEW.SEGTDO) OR (:OLD.SEGDOC <> :OLD.SEGDOC) THEN
      l_numdoc := :NEW.NUMDOC;
      l_tippes:= '04';
      SP_INTSTR(:NEW.TIPDOC, '9', l_tipdoc OUT);

      /*Monta o Identificador da Pessoa*/
      l_idtpes := l_tippes||l_tipdoc||l_numdoc;

      /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_idtpes) > 22) THEN
              EXIT;
          END IF;
          l_idtpes := ' '||l_idtpes;
      END LOOP;

      /*Inicializa o tipo e o documento para atualizar a r070con*/
      l_tipdoccon := 0;
      l_numdoccon := '0';
      l_segtdo := :NEW.SEGTDO;
      l_segdoc := :NEW.SEGDOC;

      /*Atribui os valores dando prioridade ao CPF*/
      IF (l_tipdoc = '2') THEN
          /*Primeiro doc CPF*/
          l_tipdoccon := 2;
          l_numdoccon := l_numdoc;
      ELSE
          /*Segundo doc CPF*/
          IF (l_segtdo = 2) THEN
              l_tipdoccon := 2;
              l_numdoccon := l_segdoc;
          ELSE
              /*Primeiro doc Registro Estrangeiro ou Passaporte e o segundo documento não for Registro Estrangeiro*/
              IF ((l_tipdoc = '7') OR (l_tipdoc = '4' AND l_segtdo <> 7)) THEN
                  l_tipdoccon := 4;
                  l_numdoccon := l_numdoc;
              ELSE
                  /*Segundo doc Registro Estrangeiro ou Passaporte*/
                  IF (l_segtdo = 7 OR l_segtdo = 4) THEN
                      l_tipdoccon := 4;
                      l_numdoccon := l_segdoc;           
                  END IF;
              END IF;
          END IF;
      END IF;

      /*Atualiza o TIPDOC e NUMDOC da R070CON pelo IDTPES*/
      UPDATE R070CON SET
          TIPDOC = l_tipdoccon, NUMDOC = l_numdoccon
      WHERE IDTPES = l_idtpes;
  END IF;
  /*FIM Atualiza o TIPDOC e NUMDOC da R070CON*/

  /*INICIO Atualiza DDI, DDD, Fone e NomePes da R070CON*/
  IF (:OLD.NOMVIS <> :NEW.NOMVIS) OR
     (:OLD.DDITEL <> :NEW.DDITEL) OR
     (:OLD.DDDTEL <> :NEW.DDDTEL) OR
     (:OLD.TELCON <> :NEW.TELCON) THEN

      SP_VerOnLine(l_online OUT);
      IF   (l_online = TRUE) THEN
        l_numdoc := :NEW.NUMDOC;
        l_tippes:= '04';
        SP_INTSTR(:NEW.TIPDOC, '9', l_tipdoc OUT);

        /*Monta o Identificador da Pessoa*/
        l_idtpes := l_tippes||l_tipdoc||l_numdoc;

        /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
        l_idtpes := lTrim(l_idtpes);
        l_idtpes := rTrim(l_idtpes);
        LOOP
            /*Controle do Loop.*/
            IF (Length(l_idtpes) > 22) THEN
                EXIT;
            END IF;
            l_idtpes := ' '||l_idtpes;
        END LOOP;

        SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

        /*Atualiza o TIPDOC e NUMDOC da R070CON pelo IDTPES*/
        UPDATE R070CON SET
            NOMPES = l_nompes, DDIFON = l_ddifon, DDDFON = l_dddfon, NUMFON = l_numfon
        WHERE IDTPES = l_idtpes;
    END IF;
  END IF;
  /*FIM Atualiza DDI, DDD, Fone e NomePes da R070CON*/

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090VIS');

  IF (l_auditoria = 'S') THEN

       l_camposAlterados := 'Campo(s) alterado(s): ';
       l_alterou := FALSE;

      IF (:NEW.TIPDOC <> :OLD.TIPDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPDOC ';
      END IF;

      IF (:NEW.NUMDOC <> :OLD.NUMDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMDOC ';
      END IF;

      IF (:NEW.NOMVIS <> :OLD.NOMVIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NOMVIS ';
      END IF;

      IF (:NEW.CODOEM <> :OLD.CODOEM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODOEM ';
      END IF;

      IF (:NEW.NOMOEM <> :OLD.NOMOEM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NOMOEM ';
      END IF;

      IF (:NEW.CODPRM <> :OLD.CODPRM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPRM ';
      END IF;

      IF (:NEW.DDITEL <> :OLD.DDITEL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DDITEL ';
      END IF;

      IF (:NEW.DDDTEL <> :OLD.DDDTEL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DDDTEL ';
      END IF;

      IF (:NEW.TELCON <> :OLD.TELCON) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TELCON ';
      END IF;

      IF (:NEW.SEGTDO <> :OLD.SEGTDO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEGTDO ';
      END IF;

      IF (:NEW.SEGDOC <> :OLD.SEGDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEGDOC ';
      END IF;

      IF (:NEW.NUMCNH <> :OLD.NUMCNH) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCNH ';
      END IF;

      IF (:NEW.CATCNH <> :OLD.CATCNH) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CATCNH ';
      END IF;

      IF (:NEW.DATCNH <> :OLD.DATCNH) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATCNH ';
      END IF;

      IF (:NEW.VENCNH <> :OLD.VENCNH) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'VENCNH ';
      END IF;

      IF (:NEW.OBSVIS <> :OLD.OBSVIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'OBSVIS ';
      END IF;

      IF (:NEW.DATVID <> :OLD.DATVID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATVID ';
      END IF;

      IF ((:NEW.DATFOT <> :OLD.DATFOT) OR (:OLD.DATFOT IS NULL AND :NEW.DATFOT IS NOT NULL) OR (:NEW.DATFOT IS NULL AND :OLD.DATFOT IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATFOT ';
      END IF;

      IF (:NEW.FLAFOT <> :OLD.FLAFOT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'FLAFOT ';
      END IF;

      IF (:NEW.DATRGV <> :OLD.DATRGV) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATRGV ';
      END IF;

      IF (:NEW.EMICID <> :OLD.EMICID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'EMICID ';
      END IF;

      IF (:NEW.ESTCID <> :OLD.ESTCID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'ESTCID ';
      END IF;

      IF (:NEW.DEXCID <> :OLD.DEXCID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DEXCID ';
      END IF;

      IF (:NEW.CONTPM <> :OLD.CONTPM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CONTPM ';
      END IF;

      IF (:NEW.CODNAC <> :OLD.CODNAC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODNAC ';
      END IF;

      IF (:NEW.UTICHV <> :OLD.UTICHV) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'UTICHV ';
      END IF;

      IF ((:NEW.DATNAS <> :OLD.DATNAS) OR (:OLD.DATNAS IS NULL AND :NEW.DATNAS IS NOT NULL) OR (:NEW.DATNAS IS NULL AND :OLD.DATNAS IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATNAS ';
      END IF;

      IF ((:NEW.TIPSEX <> :OLD.TIPSEX) OR (:OLD.TIPSEX IS NULL AND :NEW.TIPSEX IS NOT NULL) OR (:NEW.TIPSEX IS NULL AND :OLD.TIPSEX IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPSEX ';
      END IF;

      IF ((:NEW.FUNVIS <> :OLD.FUNVIS) OR (:OLD.FUNVIS IS NULL AND :NEW.FUNVIS IS NOT NULL) OR (:NEW.FUNVIS IS NULL AND :OLD.FUNVIS IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'FUNVIS ';
      END IF;

      IF ((:NEW.QUAVIS <> :OLD.QUAVIS) OR (:OLD.QUAVIS IS NULL AND :NEW.QUAVIS IS NOT NULL) OR (:NEW.QUAVIS IS NULL AND :OLD.QUAVIS IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'QUAVIS ';
      END IF;

      IF ((:NEW.DVADOC <> :OLD.DVADOC) OR (:OLD.DVADOC IS NULL AND :NEW.DVADOC IS NOT NULL) OR (:NEW.DVADOC IS NULL AND :OLD.DVADOC IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DVADOC ';
      END IF;

      IF ((:NEW.PAIDOC <> :OLD.PAIDOC) OR (:OLD.PAIDOC IS NULL AND :NEW.PAIDOC IS NOT NULL) OR (:NEW.PAIDOC IS NULL AND :OLD.PAIDOC IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PAIDOC ';
      END IF;

      IF ((:NEW.STAALF <> :OLD.STAALF) OR (:OLD.STAALF IS NULL AND :NEW.STAALF IS NOT NULL) OR (:NEW.STAALF IS NULL AND :OLD.STAALF IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'STAALF ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R090VIS_AUD
                   WHERE TIPDOC = :OLD.TIPDOC AND
                         NUMDOC = :OLD.NUMDOC;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R090VIS_AUD (SEQREG,VERSEQ,TIPDOC,NUMDOC,NOMVIS,CODOEM,NOMOEM,CODPRM,DDITEL,DDDTEL,
                                       TELCON,SEGTDO,SEGDOC,NUMCNH,CATCNH,DATCNH,VENCNH,OBSVIS,DATVID,
                                       DATFOT,FLAFOT,DATRGV,EMICID,ESTCID,DEXCID,CONTPM,CODNAC,UTICHV,
                                       DATNAS,TIPSEX,FUNVIS,QUAVIS,DVADOC,PAIDOC,STAALF)
                               VALUES (l_seqreg,l_verseq,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NOMVIS,:NEW.CODOEM,:NEW.NOMOEM,
                                      :NEW.CODPRM,:NEW.DDITEL,:NEW.DDDTEL,:NEW.TELCON,:NEW.SEGTDO,:NEW.SEGDOC,
                                      :NEW.NUMCNH,:NEW.CATCNH,:NEW.DATCNH,:NEW.VENCNH,:NEW.OBSVIS,
                                      :NEW.DATVID,:NEW.DATFOT,:NEW.FLAFOT,:NEW.DATRGV,:NEW.EMICID,:NEW.ESTCID,
                                      :NEW.DEXCID,:NEW.CONTPM,:NEW.CODNAC,:NEW.UTICHV,:NEW.DATNAS,:NEW.TIPSEX,
                                      :NEW.FUNVIS,:NEW.QUAVIS,:NEW.DVADOC,:NEW.PAIDOC,:NEW.STAALF);

              SP_AUDGENREG(l_seqreg,l_verseq,'R090VIS',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  SP_RETIDTPES(NULL, 4, NULL, :NEW.TIPDOC, :NEW.NUMDOC, NULL, NULL, l_IDTPES OUT);
  SP_SAM_PENDENCIES(7, 2, l_IDTPES);

  IF ((:NEW.DATFOT <> :OLD.DATFOT) OR (:OLD.DATFOT IS NULL AND :NEW.DATFOT IS NOT NULL) OR (:NEW.DATFOT IS NULL AND :OLD.DATFOT IS NOT NULL)) THEN
      SP_SAM_PENDENCIES(30, 2, l_IDTPES);
  END IF;

  /* ATUALIZAÇÃO DO NOME NA TABELA R158PES */
  IF (:NEW.NOMVIS <> :OLD.NOMVIS) THEN
      SP_ATUNOMPES(l_IDTPES, :NEW.NOMVIS);
  END IF;
  
  /* Gera pendência para remover a foto da concentradora. Isto devido a exclusão da foto via LGPD. */
  IF (:OLD.FOTVIS IS NOT NULL AND :NEW.FOTVIS IS NULL) THEN
      SP_PEND82(l_IDTPES, 3);
  END IF;
END		SENIOR;22é1␀␀TRIGGER R090VIS_EU AFTER UPDATE ON R090VIS FOR EACH ROW
DECLARE
  l_online           BOOLEAN;
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_tippes           VARCHAR2(2);
  l_tipdoc           CHAR(1);
  l_numdoc           VARCHAR2(20);
  l_idtpes           VARCHAR2(23);
  l_tipdoccon        NUMBER(1);
  l_numdoccon        VARCHAR2(20);
  l_segtdo           NUMBER(1);
  l_segdoc           VARCHAR2(20);
  l_nompes           VARCHAR2(40);
  l_ddifon           NUMBER(3);
  l_dddfon           NUMBER(3);
  l_numfon           VARCHAR2(20);
BEGIN
  IF (:NEW.CODPRM <> :OLD.CODPRM) THEN
       SP_VerOnLine(l_online OUT);
       IF   (l_online = TRUE) THEN
             R090VIS_ATUCON (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.CODPRM);
       END IF;
  END IF;

  /*INICIO Atualiza o TIPDOC e NUMDOC da R070CON*/
  /*Somente se alterado o segundo documento*/
  IF (:OLD.SEGTDO <> :NEW.SEGTDO) OR (:OLD.SEGDOC <> :OLD.SEGDOC) THEN
      l_numdoc := :NEW.NUMDOC;
      l_tippes:= '04';
      SP_INTSTR(:NEW.TIPDOC, '9', l_tipdoc OUT);

      /*Monta o Identificador da Pessoa*/
      l_idtpes := l_tippes||l_tipdoc||l_numdoc;

      /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_idtpes) > 22) THEN
              EXIT;
          END IF;
          l_idtpes := ' '||l_idtpes;
      END LOOP;

      /*Inicializa o tipo e o documento para atualizar a r070con*/
      l_tipdoccon := 0;
      l_numdoccon := '0';
      l_segtdo := :NEW.SEGTDO;
      l_segdoc := :NEW.SEGDOC;

      /*Atribui os valores dando prioridade ao CPF*/
      IF (l_tipdoc = '2') THEN
          /*Primeiro doc CPF*/
          l_tipdoccon := 2;
          l_numdoccon := l_numdoc;
      ELSE
          /*Segundo doc CPF*/
          IF (l_segtdo = 2) THEN
              l_tipdoccon := 2;
              l_numdoccon := l_segdoc;
          ELSE
              /*Primeiro doc Registro Estrangeiro ou Passaporte e o segundo documento não for Registro Estrangeiro*/
              IF ((l_tipdoc = '7') OR (l_tipdoc = '4' AND l_segtdo <> 7)) THEN
                  l_tipdoccon := 4;
                  l_numdoccon := l_numdoc;
              ELSE
                  /*Segundo doc Registro Estrangeiro ou Passaporte*/
                  IF (l_segtdo = 7 OR l_segtdo = 4) THEN
                      l_tipdoccon := 4;
                      l_numdoccon := l_segdoc;           
                  END IF;
              END IF;
          END IF;
      END IF;

      /*Atualiza o TIPDOC e NUMDOC da R070CON pelo IDTPES*/
      UPDATE R070CON SET
          TIPDOC = l_tipdoccon, NUMDOC = l_numdoccon
      WHERE IDTPES = l_idtpes;
  END IF;
  /*FIM Atualiza o TIPDOC e NUMDOC da R070CON*/

  /*INICIO Atualiza DDI, DDD, Fone e NomePes da R070CON*/
  IF (:OLD.NOMVIS <> :NEW.NOMVIS) OR
     (:OLD.DDITEL <> :NEW.DDITEL) OR
     (:OLD.DDDTEL <> :NEW.DDDTEL) OR
     (:OLD.TELCON <> :NEW.TELCON) THEN

      SP_VerOnLine(l_online OUT);
      IF   (l_online = TRUE) THEN
        l_numdoc := :NEW.NUMDOC;
        l_tippes:= '04';
        SP_INTSTR(:NEW.TIPDOC, '9', l_tipdoc OUT);

        /*Monta o Identificador da Pessoa*/
        l_idtpes := l_tippes||l_tipdoc||l_numdoc;

        /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
        l_idtpes := lTrim(l_idtpes);
        l_idtpes := rTrim(l_idtpes);
        LOOP
            /*Controle do Loop.*/
            IF (Length(l_idtpes) > 22) THEN
                EXIT;
            END IF;
            l_idtpes := ' '||l_idtpes;
        END LOOP;

        SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

        /*Atualiza o TIPDOC e NUMDOC da R070CON pelo IDTPES*/
        UPDATE R070CON SET
            NOMPES = l_nompes, DDIFON = l_ddifon, DDDFON = l_dddfon, NUMFON = l_numfon
        WHERE IDTPES = l_idtpes;
    END IF;
  END IF;
  /*FIM Atualiza DDI, DDD, Fone e NomePes da R070CON*/

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090VIS');

  IF (l_auditoria = 'S') THEN

       l_camposAlterados := 'Campo(s) alterado(s): ';
       l_alterou := FALSE;

      IF (:NEW.TIPDOC <> :OLD.TIPDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPDOC ';
      END IF;

      IF (:NEW.NUMDOC <> :OLD.NUMDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMDOC ';
      END IF;

      IF (:NEW.NOMVIS <> :OLD.NOMVIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NOMVIS ';
      END IF;

      IF (:NEW.CODOEM <> :OLD.CODOEM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODOEM ';
      END IF;

      IF (:NEW.NOMOEM <> :OLD.NOMOEM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NOMOEM ';
      END IF;

      IF (:NEW.CODPRM <> :OLD.CODPRM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPRM ';
      END IF;

      IF (:NEW.DDITEL <> :OLD.DDITEL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DDITEL ';
      END IF;

      IF (:NEW.DDDTEL <> :OLD.DDDTEL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DDDTEL ';
      END IF;

      IF (:NEW.TELCON <> :OLD.TELCON) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TELCON ';
      END IF;

      IF (:NEW.SEGTDO <> :OLD.SEGTDO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEGTDO ';
      END IF;

      IF (:NEW.SEGDOC <> :OLD.SEGDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEGDOC ';
      END IF;

      IF (:NEW.NUMCNH <> :OLD.NUMCNH) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCNH ';
      END IF;

      IF (:NEW.CATCNH <> :OLD.CATCNH) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CATCNH ';
      END IF;

      IF (:NEW.DATCNH <> :OLD.DATCNH) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATCNH ';
      END IF;

      IF (:NEW.VENCNH <> :OLD.VENCNH) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'VENCNH ';
      END IF;

      IF (:NEW.OBSVIS <> :OLD.OBSVIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'OBSVIS ';
      END IF;

      IF (:NEW.DATVID <> :OLD.DATVID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATVID ';
      END IF;

      IF ((:NEW.DATFOT <> :OLD.DATFOT) OR (:OLD.DATFOT IS NULL AND :NEW.DATFOT IS NOT NULL) OR (:NEW.DATFOT IS NULL AND :OLD.DATFOT IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATFOT ';
      END IF;

      IF (:NEW.FLAFOT <> :OLD.FLAFOT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'FLAFOT ';
      END IF;

      IF (:NEW.DATRGV <> :OLD.DATRGV) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATRGV ';
      END IF;

      IF (:NEW.EMICID <> :OLD.EMICID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'EMICID ';
      END IF;

      IF (:NEW.ESTCID <> :OLD.ESTCID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'ESTCID ';
      END IF;

      IF (:NEW.DEXCID <> :OLD.DEXCID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DEXCID ';
      END IF;

      IF (:NEW.CONTPM <> :OLD.CONTPM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CONTPM ';
      END IF;

      IF (:NEW.CODNAC <> :OLD.CODNAC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODNAC ';
      END IF;

      IF (:NEW.UTICHV <> :OLD.UTICHV) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'UTICHV ';
      END IF;

      IF ((:NEW.DATNAS <> :OLD.DATNAS) OR (:OLD.DATNAS IS NULL AND :NEW.DATNAS IS NOT NULL) OR (:NEW.DATNAS IS NULL AND :OLD.DATNAS IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATNAS ';
      END IF;

      IF ((:NEW.TIPSEX <> :OLD.TIPSEX) OR (:OLD.TIPSEX IS NULL AND :NEW.TIPSEX IS NOT NULL) OR (:NEW.TIPSEX IS NULL AND :OLD.TIPSEX IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPSEX ';
      END IF;

      IF ((:NEW.FUNVIS <> :OLD.FUNVIS) OR (:OLD.FUNVIS IS NULL AND :NEW.FUNVIS IS NOT NULL) OR (:NEW.FUNVIS IS NULL AND :OLD.FUNVIS IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'FUNVIS ';
      END IF;

      IF ((:NEW.QUAVIS <> :OLD.QUAVIS) OR (:OLD.QUAVIS IS NULL AND :NEW.QUAVIS IS NOT NULL) OR (:NEW.QUAVIS IS NULL AND :OLD.QUAVIS IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'QUAVIS ';
      END IF;

      IF ((:NEW.DVADOC <> :OLD.DVADOC) OR (:OLD.DVADOC IS NULL AND :NEW.DVADOC IS NOT NULL) OR (:NEW.DVADOC IS NULL AND :OLD.DVADOC IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DVADOC ';
      END IF;

      IF ((:NEW.PAIDOC <> :OLD.PAIDOC) OR (:OLD.PAIDOC IS NULL AND :NEW.PAIDOC IS NOT NULL) OR (:NEW.PAIDOC IS NULL AND :OLD.PAIDOC IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PAIDOC ';
      END IF;

      IF ((:NEW.STAALF <> :OLD.STAALF) OR (:OLD.STAALF IS NULL AND :NEW.STAALF IS NOT NULL) OR (:NEW.STAALF IS NULL AND :OLD.STAALF IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'STAALF ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R090VIS_AUD
                   WHERE TIPDOC = :OLD.TIPDOC AND
                         NUMDOC = :OLD.NUMDOC;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R090VIS_AUD (SEQREG,VERSEQ,TIPDOC,NUMDOC,NOMVIS,CODOEM,NOMOEM,CODPRM,DDITEL,DDDTEL,
                                       TELCON,SEGTDO,SEGDOC,NUMCNH,CATCNH,DATCNH,VENCNH,OBSVIS,DATVID,
                                       DATFOT,FLAFOT,DATRGV,EMICID,ESTCID,DEXCID,CONTPM,CODNAC,UTICHV,
                                       DATNAS,TIPSEX,FUNVIS,QUAVIS,DVADOC,PAIDOC,STAALF)
                               VALUES (l_seqreg,l_verseq,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NOMVIS,:NEW.CODOEM,:NEW.NOMOEM,
                                      :NEW.CODPRM,:NEW.DDITEL,:NEW.DDDTEL,:NEW.TELCON,:NEW.SEGTDO,:NEW.SEGDOC,
                                      :NEW.NUMCNH,:NEW.CATCNH,:NEW.DATCNH,:NEW.VENCNH,:NEW.OBSVIS,
                                      :NEW.DATVID,:NEW.DATFOT,:NEW.FLAFOT,:NEW.DATRGV,:NEW.EMICID,:NEW.ESTCID,
                                      :NEW.DEXCID,:NEW.CONTPM,:NEW.CODNAC,:NEW.UTICHV,:NEW.DATNAS,:NEW.TIPSEX,
                                      :NEW.FUNVIS,:NEW.QUAVIS,:NEW.DVADOC,:NEW.PAIDOC,:NEW.STAALF);

              SP_AUDGENREG(l_seqreg,l_verseq,'R090VIS',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  SP_RETIDTPES(NULL, 4, NULL, :NEW.TIPDOC, :NEW.NUMDOC, NULL, NULL, l_IDTPES OUT);
  SP_SAM_PENDENCIES(7, 2, l_IDTPES);

  IF ((:NEW.DATFOT <> :OLD.DATFOT) OR (:OLD.DATFOT IS NULL AND :NEW.DATFOT IS NOT NULL) OR (:NEW.DATFOT IS NULL AND :OLD.DATFOT IS NOT NULL)) THEN
      SP_SAM_PENDENCIES(30, 2, l_IDTPES);
  END IF;

  /* ATUALIZAÇÃO DO NOME NA TABELA R158PES */
  IF (:NEW.NOMVIS <> :OLD.NOMVIS) THEN
      SP_ATUNOMPES(l_IDTPES, :NEW.NOMVIS);
  END IF;
  
  /* Gera pendência para remover a foto da concentradora. Isto devido a exclusão da foto via LGPD. */
  IF (:OLD.FOTVIS IS NOT NULL AND :NEW.FOTVIS IS NULL) THEN
      SP_PEND82(l_IDTPES, 3);
  END IF;
END	MSSQL;21/a␀␀CREATE TRIGGER r090vis_eu
ON r090vis
FOR UPDATE
AS
BEGIN
  SET XACT_ABORT OFF
  DECLARE @OLD_TipDoc SMALLINT
  DECLARE @OLD_NumDoc VARCHAR(20)
  DECLARE @OLD_NomVis VARCHAR(40)
  DECLARE @OLD_CodOem INTEGER
  DECLARE @OLD_NomOem VARCHAR(60)
  DECLARE @OLD_CodPrm INTEGER
  DECLARE @OLD_DdiTel SMALLINT
  DECLARE @OLD_DddTel SMALLINT
  DECLARE @OLD_TelCon VARCHAR(20)
  DECLARE @OLD_SegTDo SMALLINT
  DECLARE @OLD_SegDoc VARCHAR(20)
  DECLARE @OLD_NumCnh VARCHAR(20)
  DECLARE @OLD_CatCnh VARCHAR(4)
  DECLARE @OLD_DatCnh DATETIME
  DECLARE @OLD_VenCnh DATETIME
  DECLARE @OLD_ObsVis VARCHAR(160)
  DECLARE @OLD_DatVid DATETIME
  DECLARE @OLD_DatFot DATETIME
  DECLARE @OLD_FlaFot SMALLINT
  DECLARE @OLD_DatRgv DATETIME
  DECLARE @OLD_EmiCid VARCHAR(20)
  DECLARE @OLD_EstCid VARCHAR(2)
  DECLARE @OLD_DexCid DATETIME
  DECLARE @OLD_ConTpm VARCHAR(1)
  DECLARE @OLD_CodNac SMALLINT
  DECLARE @OLD_UtiChv VARCHAR(1)
  DECLARE @OLD_SeqReg BIGINT
  DECLARE @OLD_EmaVis VARCHAR(100)
  DECLARE @OLD_DatIdx DATETIME
  DECLARE @OLD_NomDoc VARCHAR(40)
  DECLARE @OLD_DatNas DATETIME
  DECLARE @OLD_FunVis VARCHAR(60)
  DECLARE @OLD_QuaVis VARCHAR(60)
  DECLARE @OLD_StaAlf SMALLINT
  DECLARE @OLD_DvaDoc DATETIME
  DECLARE @OLD_PaiDoc SMALLINT
  DECLARE @OLD_TipSex VARCHAR(1)
  DECLARE @NEW_TipDoc SMALLINT
  DECLARE @NEW_NumDoc VARCHAR(20)
  DECLARE @NEW_NomVis VARCHAR(40)
  DECLARE @NEW_CodOem INTEGER
  DECLARE @NEW_NomOem VARCHAR(60)
  DECLARE @NEW_CodPrm INTEGER
  DECLARE @NEW_DdiTel SMALLINT
  DECLARE @NEW_DddTel SMALLINT
  DECLARE @NEW_TelCon VARCHAR(20)
  DECLARE @NEW_SegTDo SMALLINT
  DECLARE @NEW_SegDoc VARCHAR(20)
  DECLARE @NEW_NumCnh VARCHAR(20)
  DECLARE @NEW_CatCnh VARCHAR(4)
  DECLARE @NEW_DatCnh DATETIME
  DECLARE @NEW_VenCnh DATETIME
  DECLARE @NEW_ObsVis VARCHAR(160)
  DECLARE @NEW_DatVid DATETIME
  DECLARE @NEW_DatFot DATETIME
  DECLARE @NEW_FlaFot SMALLINT
  DECLARE @NEW_DatRgv DATETIME
  DECLARE @NEW_EmiCid VARCHAR(20)
  DECLARE @NEW_EstCid VARCHAR(2)
  DECLARE @NEW_DexCid DATETIME
  DECLARE @NEW_ConTpm VARCHAR(1)
  DECLARE @NEW_CodNac SMALLINT
  DECLARE @NEW_UtiChv VARCHAR(1)
  DECLARE @NEW_SeqReg BIGINT
  DECLARE @NEW_EmaVis VARCHAR(100)
  DECLARE @NEW_DatIdx DATETIME
  DECLARE @NEW_NomDoc VARCHAR(40)
  DECLARE @NEW_DatNas DATETIME
  DECLARE @NEW_FunVis VARCHAR(60)
  DECLARE @NEW_QuaVis VARCHAR(60)
  DECLARE @NEW_StaAlf SMALLINT
  DECLARE @NEW_DvaDoc DATETIME
  DECLARE @NEW_PaiDoc SMALLINT
  DECLARE @NEW_TipSex VARCHAR(1)
  DECLARE CUR_r090vis_UPD_OLD CURSOR LOCAL FOR SELECT 
      old.tipdoc O_TipDoc,old.numdoc O_NumDoc,old.nomvis O_NomVis,old.codoem O_CodOem,old.nomoem O_NomOem,old.codprm O_CodPrm,old.dditel O_DdiTel,old.dddtel O_DddTel,old.telcon O_TelCon,old.segtdo O_SegTDo,
      old.segdoc O_SegDoc,old.numcnh O_NumCnh,old.catcnh O_CatCnh,old.datcnh O_DatCnh,old.vencnh O_VenCnh,old.obsvis O_ObsVis,old.datvid O_DatVid,old.datfot O_DatFot,old.flafot O_FlaFot,old.datrgv O_DatRgv,
      old.emicid O_EmiCid,old.estcid O_EstCid,old.dexcid O_DexCid,old.contpm O_ConTpm,old.codnac O_CodNac,old.utichv O_UtiChv,old.seqreg O_SeqReg,old.emavis O_EmaVis,old.datidx O_DatIdx,old.nomdoc O_NomDoc,
      old.datnas O_DatNas,old.funvis O_FunVis,old.quavis O_QuaVis,old.staalf O_StaAlf,old.dvadoc O_DvaDoc,old.paidoc O_PaiDoc,old.tipsex O_TipSex
       FROM deleted old
  DECLARE CUR_r090vis_UPD_NEW CURSOR LOCAL FOR SELECT 
      new.tipdoc N_TipDoc,new.numdoc N_NumDoc,new.nomvis N_NomVis,new.codoem N_CodOem,new.nomoem N_NomOem,new.codprm N_CodPrm,new.dditel N_DdiTel,new.dddtel N_DddTel,new.telcon N_TelCon,new.segtdo N_SegTDo,
      new.segdoc N_SegDoc,new.numcnh N_NumCnh,new.catcnh N_CatCnh,new.datcnh N_DatCnh,new.vencnh N_VenCnh,new.obsvis N_ObsVis,new.datvid N_DatVid,new.datfot N_DatFot,new.flafot N_FlaFot,new.datrgv N_DatRgv,
      new.emicid N_EmiCid,new.estcid N_EstCid,new.dexcid N_DexCid,new.contpm N_ConTpm,new.codnac N_CodNac,new.utichv N_UtiChv,new.seqreg N_SeqReg,new.emavis N_EmaVis,new.datidx N_DatIdx,new.nomdoc N_NomDoc,
      new.datnas N_DatNas,new.funvis N_FunVis,new.quavis N_QuaVis,new.staalf N_StaAlf,new.dvadoc N_DvaDoc,new.paidoc N_PaiDoc,new.tipsex N_TipSex
       FROM inserted new
  DECLARE @l_online NUMERIC(1,0)
  DECLARE @l_alterou NUMERIC(1,0)
  DECLARE @l_camposalterados VARCHAR(2000)
  DECLARE @l_verseq BIGINT
  DECLARE @l_seqreg BIGINT
  DECLARE @l_auditoria CHAR(1)
  DECLARE @l_tippes VARCHAR(2)
  DECLARE @l_tipdoc CHAR(1)
  DECLARE @l_numdoc VARCHAR(20)
  DECLARE @l_idtpes VARCHAR(23)
  DECLARE @l_tipdoccon SMALLINT
  DECLARE @l_numdoccon VARCHAR(20)
  DECLARE @l_segtdo SMALLINT
  DECLARE @l_segdoc VARCHAR(20)
  DECLARE @l_nompes VARCHAR(40)
  DECLARE @l_ddifon SMALLINT
  DECLARE @l_dddfon SMALLINT
  DECLARE @l_numfon VARCHAR(20)
  DECLARE @l_fotvis VARBINARY(max)
  DECLARE @l_tipoarmazenamentofoto SMALLINT
  DECLARE @l_datazerada DATETIME
  DECLARE @ChkError INTEGER
  SET NOCOUNT ON;
  SET XACT_ABORT OFF;
  SAVE TRANSACTION TR_r090vis_eu
  DECLARE @SE_EXC3 INTEGER
  DECLARE @SE_EXC4 INTEGER
  SELECT @l_datazerada = CONVERT(DATETIME,'12/31/1900 00:00:00', 101)
  SELECT @ChkError = 0
  OPEN CUR_r090vis_UPD_OLD
  SELECT @ChkError = @@Error
  IF @ChkError <> 0
  BEGIN
    CLOSE CUR_r090vis_UPD_OLD
    DEALLOCATE CUR_r090vis_UPD_OLD
    CLOSE CUR_r090vis_UPD_NEW
    DEALLOCATE CUR_r090vis_UPD_NEW
    GOTO FIM
  END
  OPEN CUR_r090vis_UPD_NEW
  SELECT @ChkError = @@Error
  IF @ChkError <> 0
  BEGIN
    CLOSE CUR_r090vis_UPD_OLD
    DEALLOCATE CUR_r090vis_UPD_OLD
    CLOSE CUR_r090vis_UPD_NEW
    DEALLOCATE CUR_r090vis_UPD_NEW
