RH_250ALT(63);
END␀uÎ␀␀		SENIOR;0O␀␀

TRIGGER R005DAT_EI AFTER INSERT ON R005DAT FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);  
  l_Empresa NUMBER;
  CURSOR c_Empresa IS
    SELECT NUMEMP
    FROM R030EMP
    ORDER BY NUMEMP;
BEGIN   
  /*e-Social*/
  
  FOREACH c_Empresa INTO l_Empresa
  LOOP
    l_Valor := '';
    SP_CONCATENAR_NUM('CODSRV', :NEW.CODSRV, l_Valor OUT);
    SP_CONCATENAR_NUM('CODTSE', :NEW.CODTSE, l_Valor OUT);
    SP_CONCATENAR_DAT('DATALT', :NEW.DATALT, l_Valor OUT);

    SP_ESOCIAL_1050(l_Empresa, 'R005DAT', 'I', l_Valor, '', 0, 'R005DAT_EI');

  END LOOP;
  /*e-Social*/
END␀yÎ␀␀	SENIOR;0L

TRIGGER R005DAT_SU AFTER UPDATE ON R005DAT

BEGIN
RH_250ALT(63);
END␀vÎ␀␀		SENIOR;0Ş␀␀

TRIGGER R005DAT_EU AFTER UPDATE ON R005DAT FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);  
l_Valor2 VARCHAR2(2000);
  l_Empresa NUMBER;
  CURSOR c_Empresa IS
    SELECT NUMEMP
    FROM R030EMP
    ORDER BY NUMEMP;
  l_Valido BOOLEAN;
BEGIN   
  /*e-Social*/
  
  SP_VALUPDATE_NUM(:OLD.CODHOR, :NEW.CODHOR, l_Valido OUT);
  IF (l_Valido = TRUE) THEN	
    FOREACH c_Empresa INTO l_Empresa
    LOOP
      l_Valor := '';
      SP_CONCATENAR_NUM('CODSRV', :NEW.CODSRV, l_Valor OUT);
      SP_CONCATENAR_NUM('CODTSE', :NEW.CODTSE, l_Valor OUT);
      SP_CONCATENAR_DAT('DATALT', :NEW.DATALT, l_Valor OUT);
      
      l_Valor2 := '';
      SP_CONCATENAR_NUM('CODSRV', :OLD.CODSRV, l_Valor2 OUT);
      SP_CONCATENAR_NUM('CODTSE', :OLD.CODTSE, l_Valor2 OUT);
      SP_CONCATENAR_DAT('DATALT', :OLD.DATALT, l_Valor2 OUT);

      SP_ESOCIAL_1050(l_Empresa, 'R005DAT', 'A', l_Valor, l_Valor2, 0, 'R005DAT_EU');

    END LOOP;	
  END IF;   
  
  /*e-Social*/
END␀wÎ␀␀	SENIOR;0L

TRIGGER R005DAT_SD AFTER DELETE ON R005DAT

