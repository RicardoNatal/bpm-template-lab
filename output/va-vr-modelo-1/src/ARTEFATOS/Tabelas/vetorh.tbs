			l_Alterou := TRUE;
			SP_CONCAT_FLO_JSON('VLRJUR', :NEW.VLRJUR, :OLD.VLRJUR, 2, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_NUM(:OLD.VLRRNT, :NEW.VLRRNT, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_FLO_JSON('VLRRNT', :NEW.VLRRNT, :OLD.VLRRNT, 2, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DES(:OLD.DESRNT, :NEW.DESRNT, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('DESRNT', :NEW.DESRNT, :OLD.DESRNT, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_NUM(:OLD.VLRPRE, :NEW.VLRPRE, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_FLO_JSON('VLRPRE', :NEW.VLRPRE, :OLD.VLRPRE, 2, l_JsonCamposAlterados OUT);
		END IF;
		
		IF (l_VersaoESocial >= 7) THEN
	  		SP_VALUPDATE_NUM(:OLD.VLMO13, :NEW.VLMO13, l_Valido OUT);
	  	  	IF (l_Valido = TRUE) THEN
	  			l_Alterou := TRUE;
	  		  	SP_CONCAT_FLO_JSON('VLMO13', :NEW.VLMO13, :OLD.VLMO13, 2, l_JsonCamposAlterados OUT);
	  	  	END IF;
	  	
	  		SP_VALUPDATE_NUM(:OLD.VLAP13, :NEW.VLAP13, l_Valido OUT);
	  	  	IF (l_Valido = TRUE) THEN
	  			l_Alterou := TRUE;
	  		  	SP_CONCAT_FLO_JSON('VLAP13', :NEW.VLAP13, :OLD.VLAP13, 2, l_JsonCamposAlterados OUT);
	  	  	END IF;
	  	  
	  	  	SP_VALUPDATE_NUM(:OLD.VLJU13, :NEW.VLJU13, l_Valido OUT);
	  	  	IF (l_Valido = TRUE) THEN
	  		  	l_Alterou := TRUE;
	  		  	SP_CONCAT_FLO_JSON('VLJU13', :NEW.VLJU13, :OLD.VLJU13, 2, l_JsonCamposAlterados OUT);
	  	  	END IF;
	  	  
	  	  	SP_VALUPDATE_NUM(:OLD.VLPR13, :NEW.VLPR13, l_Valido OUT);
	  	  	IF (l_Valido = TRUE) THEN
	  		  	l_Alterou := TRUE;
	  		  	SP_CONCAT_FLO_JSON('VLPR13', :NEW.VLPR13, :OLD.VLPR13, 2, l_JsonCamposAlterados OUT);
	  	  	END IF;
	  	END IF;
	END IF;

	IF (l_Alterou = TRUE) THEN
		SP_CONCATENAR_NUM('CODPRO', :NEW.CODPRO, l_Valor OUT);
		SP_CONCATENAR_DAT('CMPPAG', :NEW.CMPPAG, l_Valor OUT);

		SP_E_SOCIAL('S-2501', 'R346IRT', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, l_JsonCamposAlterados, 0, NULL, :NEW.CMPPAG, 0, 'R346IRT_EU');
