␀␀PROCEDURE SP_RETORNAENDERECO(P_TIPOLOGRADOURO VARCHAR2(255),P_ENDERECOESO VARCHAR2(255),P_ENDERECO IN OUT VARCHAR2(255))
 IS

l_Endereco VARCHAR2(39);
  l_DescTipoLogradouro VARCHAR(6);
BEGIN
	l_Endereco := '';
	l_DescTipoLogradouro := '';
	
	SP_RETORNATIPLGR(p_TipoLogradouro, l_DescTipoLogradouro OUT);
	
	l_Endereco := l_DescTipoLogradouro || ' ' || p_EnderecoESO;

	p_Endereco :=  l_Endereco;
END␀Éø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
<␀␀PROCEDURE SP_RETORNAR_MOTESO(P_CODSIT NUMBER(3),P_DATREF DATE,P_MOTESO OUT NUMBER(2), P_ENVOBS OUT NUMBER(1))
 IS

l_moteso   R010ESO.MOTESO%TYPE;
l_envObs   R010ESO.ENVOBS%TYPE;
BEGIN
  BEGIN
    SELECT MOTESO, ENVOBS INTO l_moteso, l_envObs FROM R010ESO WHERE R010ESO.CODSIT = P_CODSIT AND R010ESO.CMPMOV = (SELECT MAX(ESO2.CMPMOV) FROM R010ESO ESO2 WHERE ESO2.CODSIT = R010ESO.CODSIT AND ESO2.CMPMOV <= P_DATREF);
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_moteso := 0;
	  l_envObs := 0;
  END; 

  P_MOTESO := l_moteso;
  P_ENVOBS := l_envObs;
END␀Êø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
¹␀␀PROCEDURE SP_RETORNAR_TIPSIT(P_CODSIT NUMBER(3),P_TIPSIT OUT NUMBER(2), P_BLOACE OUT VARCHAR(1))
 IS

l_TipSit   R010SIT.TIPSIT%TYPE;
l_BloAce   R010SIT.BLOACE%TYPE;
BEGIN
  BEGIN
     SELECT TIPSIT, BLOACE 
       INTO l_TipSit, l_BloAce
       FROM R010SIT
      WHERE CODSIT = P_CODSIT;
  EXCEPTION
     WHEN NO_DATA_FOUND THEN
        l_TipSit := 0;
        l_BloAce := 'N';
  END; 
  
  P_TIPSIT := l_TipSit;
  P_BLOACE := l_BloAce;
END␀Ëø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
N␀␀PROCEDURE SP_RETORNATIPLGR(P_TIPOLOGRADOURO VARCHAR2(255),P_DESCTIPOLOGRADOURO IN OUT VARCHAR2(255))
 IS

l_TipoLogradouro VARCHAR2(5);
BEGIN
	l_TipoLogradouro := UPPER(p_TipoLogradouro);
	
	IF l_TipoLogradouro = 'PRQ' THEN 
	  p_DescTipoLogradouro := 'Parque';
	ELSIF l_TipoLogradouro = 'RES' THEN 
