PROCEDURE SP_PROSIN(P_VALSTR VARCHAR2(2047),P_RETSIN OUT NUMBER)
 IS

    l_horSin    NUMBER(4);
    l_datSin    DATE;
    l_seqSin    NUMBER(2);
    l_codSin    NUMBER(2);
    l_coderr    NUMBER(2);
    l_count     NUMBER(4);    
BEGIN
    /* inicializa variáveis */
    l_codsin := 0;
    l_coderr := 0;
    p_RetSin := 0;

    l_datSin := CURDATE();
    l_horSin := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_seqSin := SECOND(CURTIME());

    /* Quebra a string para verificar qual o valor do comando de sincronismo */
    l_codsin := SUBSTRING(p_ValStr, 1,2);

    IF  (l_codSin = 1) THEN
        SP_SINHCH(p_ValStr, l_coderr OUT);   /* Histórico de crachás */
    END IF;

    IF  (l_codSin = 2) THEN
        SP_SINASA(p_ValStr, l_coderr OUT);   /* Autorização de saída */
    END IF;

    IF  (l_codSin = 3) THEN
        SP_SINFIS(p_ValStr, l_coderr OUT);   /* Número físico */
    END IF;

    IF  (l_codSin = 4) THEN
        SP_SINMEV(p_ValStr, l_coderr OUT);   /* Movimentação de locais físicos - Evacuação */
    END IF;
    
    IF  (l_codSin = 5) THEN
        SP_SINENTVIS(p_ValStr, l_coderr OUT);   /* Entrada de visitantes */
    END IF;
    
    IF  (l_codSin = 6) THEN
        SP_SINMVI(p_ValStr, l_coderr OUT);   /* Saída de visitantes */
    END IF;
    
   IF  (l_codSin = 11) THEN
        SP_SINLIJ(p_ValStr, l_coderr OUT);   /* Liberação de interjornada */
    END IF;
    
    IF  (l_codSin = 12) THEN
        SP_SINLFH(p_ValStr, l_coderr OUT);   /* Liberação de faixa horária */
    END IF;

    IF  (l_codSin = 13) THEN
        SP_SININC(p_ValStr, l_coderr OUT);   /* Ocorrência de incidente de pessoa não grata na portaria */
    END IF;
        
    /* Se gerou erros, grava na tabela de exceções  */
    IF  (l_codErr > 0) THEN
        
        /* verifica se existe registro com a mesma chave */
        LOOP
            l_count := 0;
            BEGIN
                SELECT COUNT(*) INTO l_count FROM R070SIN WHERE CODSIN = l_CodSIn AND DATSIN = l_DatSin AND HORSIN = l_HorSin AND SEQSIN = l_seqSin;
            EXCEPTION
                WHEN OTHERS THEN l_count := 1;
            END;
            
            IF (l_count = 0)  OR (l_seqSin > 60) THEN
                EXIT;
            ELSE
                l_seqSin := l_seqSin + 1;
            END IF;        
        END LOOP; /* End loop*/
        
        IF  (l_seqSin > 60) THEN
            p_retSin := 1;  /* Se retornar esse erro a CSM tem q gravar um log e continuar o sincronismo */
        ELSE
	        BEGIN
	            INSERT INTO R070SIN (CODSIN,DATSIN,HORSIN,SEQSIN,VALSIN,STASIN) VALUES
	                                (l_CodSIn, l_DatSin, l_HorSin, l_seqSin, p_valStr, l_codErr);
	        EXCEPTION
	            WHEN OTHERS THEN p_retSin := 1;  /* Se retornar esse erro a CSM tem q gravar um log e continuar o sincronismo */
	        END;        
        END IF;  
    END IF;
END		SENIOR;21fSP_SINASA
SP_SINENTVIS
SP_SINFIS
SP_SINHCH
SP_SINMEV
SP_SINMVI
SP_SININC
SP_SINLIJ
SP_SINLFH
