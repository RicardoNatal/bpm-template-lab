                   ((p_tipcol = 1) OR (p_tipcol = 2)) THEN
                   UPDATE R070CON SET
                           NOMFUN = l_nomfun,
                           NUMPIS = l_numpis,
                           NOMPES = l_nomfun,
                           DDIFON = l_ddifon,
                           DDDFON = l_dddfon,
                           NUMFON = l_numfon,
                           TIPDOC = l_tipdoccol,
                           NUMDOC = l_numdoccol
                    WHERE NUMCRA = l_cracha;
                ELSE
                   UPDATE R070CON SET
                           NOMPES = l_nomfun,
                           DDIFON = l_ddifon,
                           DDDFON = l_dddfon,
                           NUMFON = l_numfon,
                           TIPDOC = l_tipdoccol,
