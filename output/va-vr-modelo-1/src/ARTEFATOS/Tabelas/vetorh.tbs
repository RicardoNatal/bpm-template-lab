TRIGGER R018CCU_EU AFTER UPDATE ON R018CCU FOR EACH ROW

DECLARE
  l_numemp_str VARCHAR2(4);
  l_codccu_str VARCHAR2(18);
  l_valstr     VARCHAR2(103);

BEGIN
  RH_250ALT(41);

  /* Pendência SAMSenior */
  IF (:NEW.NOMCCU <> :OLD.NOMCCU) THEN
    SP_INTSTR(:NEW.NUMEMP, '9999', l_numemp_str OUT);
    SP_ESPSTR(:NEW.CODCCU, 18, l_codccu_str OUT);
    l_valstr := 'E' || l_numemp_str || l_codccu_str || :OLD.NOMCCU;
    SP_SAM_PENDENCIES(34, 2, l_valstr);
  END IF;
END␀ÄĞ␀␀		SENIOR;0Y

