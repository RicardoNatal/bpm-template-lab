␀␀␀␀␀N±␀␀†^¯␀␀d␀␀␀ÿ␀␀{İ␀␀␀u¬␀␀–␀␀␀␀␀␀␀7@)8)8n␀Æÿ␀␀ÿ␀EÑ␀␀␀␀␀␀␀«G¢G¢GqC␀êÿ␀␀ÿ␀”w·␀␀␀␀␀␀␀exdxdxì*␀␀Æÿ␀␀ÿ␀ÚDÑ␀␀␀␀␀␀␀GÔFÔFqC␀êÿ␀␀ÿ␀‹w·␀␀␀␀␀␀␀?x<x<xì*␀␀Æÿ␀␀ÿ␀␀É␀␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3Íİ␀␀		SENIOR;0_␀␀TRIGGER R097AIN_EI AFTER INSERT ON R097AIN FOR EACH ROW
DECLARE
  l_online          BOOLEAN;
  l_verplf          NUMBER(3);
  l_codplf          NUMBER(9);
  l_tippes          NUMBER(2);
  l_hora_atual      NUMBER(4);
  l_data_zero       DATE;
  l_data_atual      DATE;
  l_data            CHAR(8);
  l_hora            CHAR(4);
  l_seq             CHAR(4);
  l_chave           CHAR(39);
  l_IDTPES          VARCHAR(23);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN
    l_data_zero  := '31/12/1900,00:00:00';
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_data_atual := CURDATE();

    /*Se for um histórico válido*/
    IF (:NEW.STAATU = 1) THEN
        BEGIN
            SELECT VERPLF, CODPLF
            INTO l_verplf,l_codplf
            FROM R097MOP A
            WHERE SEQMOV = (SELECT MAX(SEQMOV)
                            FROM R097MOP
                            WHERE PROPAC = A.PROPAC
                            AND DATINI = A.DATINI
                            AND HORINI = A.HORINI)
            AND PROPAC = :NEW.PROPAC
            AND DATINI = :NEW.DATINI
            AND HORINI = :NEW.HORINI;
        EXCEPTION
          WHEN OTHERS THEN
             l_verplf := 0;
             l_codplf := 0;
        END;

        l_tippes := 11;
        /*Atualiza o acompanhante de paciente na r070con/controle*/
        SP_PACCON(l_tippes,:NEW.PROPAC,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,l_verplf,l_codplf,:NEW.DATIAC,:NEW.HORIAC,:NEW.DATFAC,:NEW.HORFAC,1,0);
    END IF;
  END IF;

  SP_RETIDTPES(NULL, 4, NULL, :NEW.TIPDOC, :NEW.NUMDOC, NULL, :NEW.ProPac, l_IDTPES OUT);
  SP_DATSTR(:NEW.DATINI,'DDMMYYYY',l_data OUT);
  SP_INTSTR(:NEW.HORINI,'9999',l_hora OUT);
  SP_INTSTR(:NEW.SEQACO,'9999',l_seq OUT);
  l_chave := l_IDTPES||l_data||l_hora||l_seq;
  SP_SAM_PENDENCIES(8, 1, l_chave);
END␀Îİ␀␀		SENIOR;0¬␀␀

TRIGGER R097AIN_EU AFTER UPDATE ON R097AIN FOR EACH ROW
DECLARE
  l_online          BOOLEAN;
  l_verplf          NUMBER(3);
  l_codplf          NUMBER(9);
  l_tippes          NUMBER(2);
  l_hora_atual      NUMBER(4);
  l_subnv           NUMBER(1);
  l_data_zero       DATE;
  l_data_atual      DATE;
  l_data            CHAR(8);
  l_hora            CHAR(4);
  l_seq             CHAR(4);
  l_chave           CHAR(39);
  l_IDTPES          VARCHAR(23);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN

      l_data_zero  := '31/12/1900,00:00:00';
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_data_atual := CURDATE();

      /*Se for um histórico válido*/
      IF (:NEW.STAATU > 0) THEN

         BEGIN
           SELECT VERPLF, CODPLF
           INTO l_verplf,l_codplf
           FROM R097MOP A
           WHERE SEQMOV = (SELECT MAX(SEQMOV)
                           FROM R097MOP
                           WHERE PROPAC = A.PROPAC
                           AND DATINI = A.DATINI
                           AND HORINI = A.HORINI)
           AND PROPAC = :NEW.PROPAC
           AND DATINI = :NEW.DATINI
           AND HORINI = :NEW.HORINI;
         EXCEPTION
           WHEN OTHERS THEN
              l_verplf := 0;
              l_codplf := 0;
         END;

         l_tippes := 11;

         l_subnv := 0;
         IF (:NEW.NUMDOC<>:OLD.NUMDOC) THEN
             l_subnv := 1;
         END IF;

         /*Atualiza o acompanhante de paciente na r070con/controle*/
         SP_PACCON(l_tippes,:NEW.PROPAC,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,l_verplf,l_codplf,:NEW.DATIAC,:NEW.HORIAC,:NEW.DATFAC,:NEW.HORFAC,l_subnv,0);
      END IF;
  END IF;

  IF :OLD.DATINI <> :NEW.DATINI OR :OLD.DATFAC <> :NEW.DATFAC OR
     :OLD.HORINI <> :NEW.HORINI OR :OLD.HORFAC <> :NEW.HORFAC THEN
    SP_RETIDTPES(NULL, 4, NULL, :NEW.TIPDOC, :NEW.NUMDOC, NULL, :NEW.ProPac, l_IDTPES OUT);
    SP_DATSTR(:NEW.DATINI,'DDMMYYYY',l_data OUT);
    SP_INTSTR(:NEW.HORINI,'9999',l_hora OUT);
    SP_INTSTR(:NEW.SEQACO,'9999',l_seq OUT);
    l_chave := l_IDTPES||l_data||l_hora||l_seq;
    SP_SAM_PENDENCIES(8, 2, l_chave);
  END IF;
END␀Ìİ␀␀		SENIOR;0ã␀␀

TRIGGER R097AIN_ED AFTER DELETE ON R097AIN FOR EACH ROW
DECLARE
  l_online          BOOLEAN;
  l_crafis          NUMBER(12);
  l_hora_atual      NUMBER(4);
  l_data_zero       DATE;
  l_data_atual      DATE;
  l_data            CHAR(8);
  l_hora            CHAR(4);
  l_seq             CHAR(4);
  l_chave           CHAR(39);
  l_IDTPES          VARCHAR(23);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
      l_data_zero  := '31/12/1900,00:00:00';
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_data_atual := CURDATE();

      /*Se for um histórico válido*/
      IF ((:OLD.DATFAC > l_data_atual) OR
          ((:OLD.DATFAC = l_data_atual) AND (:OLD.HORFAC >= l_hora_atual)) OR
          (:OLD.DATFAC = l_data_zero)) THEN

          /* Bloqueia todos os crachás do acompanhante de visitante */
          AtuSitCra('1', :OLD.NUMCRA);
      END IF;
  END IF;

  SP_RETIDTPES(NULL, 4, NULL, :OLD.TIPDOC, :OLD.NUMDOC, NULL, :OLD.ProPac, l_IDTPES OUT);
  SP_DATSTR(:OLD.DATINI,'DDMMYYYY',l_data OUT);
  SP_INTSTR(:OLD.HORINI,'9999',l_hora OUT);
  SP_INTSTR(:OLD.SEQACO,'9999',l_seq OUT);
  l_chave := l_IDTPES||l_data||l_hora||l_seq;
  SP_SAM_PENDENCIES(8, 2, l_chave);
END␀␀␀÷␀␀␀␀␀␀␀␀␀␀␀␀␀Ïİ␀␀BÆ␀␀(	␀␀␀␀␀␀#Ç␀␀"Ç␀␀"Ç␀␀d␀␀␀ÿ␀␀ìİ␀␀␀)OÑ␀	␀␀␀␀␀␀pG]G]GqC␀êÿ␀␀×İ␀␀␀¤w·␀	␀␀␀␀␀␀lxdxdxì*␀␀Æÿ␀␀Ûİ␀␀␀Ûı␀␀­␀	␀␀␀␀␀␀ÿ␀␀@ü␀␀×ş␀␀p␀Æÿ␀␀ÿ␀N␀␀␀␀␀␀␀œ␀␀0␀n␀Æÿ␀␀|İ␀␀␀~¬␀␀(␀␀␀␀␀␀N±␀␀†^¯␀␀d␀␀␀ÿ␀␀{İ␀␀␀®§␀␀U␀␀␀␀␀␀¸¨␀␀ç§␀␀ç§␀␀V␀␀ÿ␀␀ÿ␀º¢␀␀k␀␀␀␀␀␀(£␀␀Î¢␀␀Î¢␀␀f␀␀ÿ␀␀ÿ␀•o=␀␀␀␀␀␀ïÁ␀␀ªªc␀␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3␀␀Æ␀␀␀␀␀␀␀␀␀␀Ğİ␀␀BÆ␀␀(	␀␀␀␀␀␀#Ç␀␀"Ç␀␀"Ç␀␀d␀␀␀ÿ␀␀ìİ␀␀␀pÒ␀␀␀␀␀␀␀»p£p£pÿ␀ÿÿ␀␀ÿ␀ëDÑ␀␀␀␀␀␀␀“I,G“IqC␀êÿ␀␀ÿ␀’w·␀␀␀␀␀␀␀y]xyì*␀␀Æÿ␀␀ÿ␀␀␀␀0Òİ␀␀		SENIOR;0m␀␀TRIGGER R097FOT_EI BEFORE INSERT ON R097FOT FOR EACH ROW
DECLARE
    l_idtpes VARCHAR(23);
    l_deve_enviar NUMBER(1);
BEGIN
    SP_RETIDTPES(NULL, 9, NULL, NULL, NULL, :NEW.PROPAC, NULL, l_idtpes OUT);
