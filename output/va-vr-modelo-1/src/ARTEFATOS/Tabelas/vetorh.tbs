	l_SitEsoRevGhe   R583REV.SitEso%TYPE;
	l_DataZero DATE;
	l_DatIniSST DATE;
	
	CURSOR C_EMPRESAS IS 
	SELECT DISTINCT NumEmp 
	FROM R583FIL 
	WHERE CodPRA = :OLD.CodPRA
	ORDER BY NumEmp;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	
	l_ConsideraEPI := TRUE;
	
	/* Se o EPI é específico de um agente de risco, verifica se o agente de risco está sendo considerado no PPP/eSocial */
	IF (:OLD.CodAgt > 0) THEN
		SM_RETINFAGT(:OLD.CodAgt, l_EmiPPPAgt OUT);
		SM_RETINFLAU(:OLD.CodPRA, :OLD.CodGHE, :OLD.RevGHE, :OLD.CodAgt, l_EmiPPPLau OUT);
		
		IF (l_EmiPPPAgt = 'N' OR l_EmiPPPLau = 'N') THEN
			l_ConsideraEPI := FALSE;
		END IF;
	END IF;
	
	IF (l_ConsideraEPI = TRUE) THEN
		SM_RETINFREVGHE(:OLD.CodPRA, :OLD.CodGHE, :OLD.RevGHE, l_DatIniRevGhe OUT, l_DatTerRevGhe OUT, l_SitEsoRevGhe OUT);
		
		/* Gera pendência apenas se a revisão do GHE estiver com situação 1 - Ativo */
		IF (l_SitEsoRevGhe = 1) THEN
			SP_CONCATENAR_NUM('CODPRA', :OLD.CodPRA, l_Json OUT);
			SP_CONCATENAR_NUM('CODGHE', :OLD.CodGHE, l_Json OUT);
			SP_CONCATENAR_DES('REVGHE', :OLD.RevGHE, l_Json OUT);
	
	  		FOREACH C_EMPRESAS INTO l_NumEmp
	  		LOOP
	  			RH_RET_DATINISST(l_NumEmp, l_DatIniSST OUT);
	  			IF (l_DatIniSST > l_DataZero) THEN
	  				IF (l_DatTerRevGhe > l_DatIniSST OR l_DatTerRevGhe = l_DataZero) THEN
  						IF (l_DatIniRevGhe < l_DatIniSST) THEN
  							l_DatIniRevGhe := l_DatIniSST;
  						END IF;
  						
  						SP_E_SOCIAL_SM('S-2240', 'R583EPI', 'N', 'E', l_DatIniRevGhe, l_DatTerRevGhe, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DatIniRevGhe, 0, 'R583EPI_ED');
  					END IF;
  				END IF;
			END LOOP;
		END IF;
	END IF;
END␀␀␀ëq␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀%ê␀␀$-Ì␀	␀␀␀␀␀␀␀ö?•¸␀␀Â;{␀Æÿ␀␀.#␀mDÑ␀	␀␀␀␀␀␀␀‡JşEşEqC␀êÿ␀␀ÿ␀2Ÿ␀␀ˆ␀␀␀␀␀␀␀␀BXHŸ␀␀HŸ␀␀7␀␀ÿ␀␀ÿ␀b³␀␀ˆ␀␀␀␀␀␀␀␀­´␀␀´´␀␀´´␀␀7␀␀ÿ␀␀ÿ␀␀␀␀0;1'ê␀␀		SENIOR;0w	␀␀TRIGGER R583ESO_EI BEFORE INSERT ON R583ESO FOR EACH ROW
DECLARE
	l_Json VARCHAR(2000);
	l_Where VARCHAR(2000);
	l_DataTerHis DATE;
	l_CodPraStr VARCHAR(9);
	l_DataZero DATE;
	l_CodPra VARCHAR(9);
	l_DataReferencia DATE;
	l_CamposZeros BOOLEAN;
	l_DataMax DATE;
	
	CURSOR C_EMPRESA IS SELECT R583FIL.NUMEMP, R583FIL.CODFIL, R583FIL.DATINI, R583FIL.DATTER, R030DES.INISST FROM R583FIL, R030DES
						 WHERE R030DES.NUMEMP = R583FIL.NUMEMP 
						   AND R583FIL.CODPRA = CONVERT(CHAR_TO_NUMBER, l_CodPra)
						   AND R030DES.INISST <> l_DataZero
   					     ORDER BY NUMEMP;
   					    
   	TYPE T_EMPRESA IS RECORD (
		NUMEMP   R030EMP.NUMEMP%TYPE,
		CODFIL   R030FIL.CODFIL%TYPE,
		DATINI   R583FIL.DATINI%TYPE,
		DATTER   R583FIL.DATTER%TYPE,
		INISST   R030DES.INISST%TYPE
	);
	
	EMPRESA_SST T_EMPRESA;
	
BEGIN
	l_CodPra := :NEW.CodPRA;
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DataReferencia := :NEW.DATALT;
	l_CamposZeros := FALSE;
	l_DataMax := DATETIME(04, 06, 2080, 0, 0, 0);

	l_CodPraStr := CONVERT(NUMBER_TO_CHAR, :NEW.CODPRA);
	l_Where := 'CODPRA = ''' || l_CodPraStr || '''';
	SP_PROXHIST_NPER('DATALT', 'R583ESO', l_Where, :NEW.DATALT, l_DataTerHis OUT);

	FOREACH C_EMPRESA INTO EMPRESA_SST.NUMEMP, EMPRESA_SST.CODFIL, EMPRESA_SST.DATINI, EMPRESA_SST.DATTER, EMPRESA_SST.INISST LOOP
		l_Json := '';
		IF (l_DataTerHis >= EMPRESA_SST.INISST OR l_DataTerHis = l_DataZero) THEN 
			
			IF (l_DataTerHis = l_DataZero AND EMPRESA_SST.DATTER = l_DataZero) THEN
				l_CamposZeros := TRUE;
			END IF;
			
			IF (l_DataReferencia < EMPRESA_SST.INISST) THEN
				l_DataReferencia := EMPRESA_SST.INISST;
			END IF;
			
			IF (l_DataTerHis = l_DataZero) THEN
				l_DataTerHis := l_DataMax;
				
			END IF;
			
			IF (EMPRESA_SST.DATTER = l_DataZero) THEN
				EMPRESA_SST.DATTER := l_DataMax;
			END IF;

			IF ((EMPRESA_SST.DATINI >= l_DataReferencia AND (EMPRESA_SST.DATTER <= l_DataTerHis OR l_CamposZeros = TRUE OR EMPRESA_SST.DATTER = l_DataMax)) OR 
				(EMPRESA_SST.DATINI < l_DataReferencia AND (EMPRESA_SST.DATTER > l_DataReferencia OR l_CamposZeros = TRUE))) THEN
				
				SP_CONCATENAR_NUM('CODPRA', :NEW.CODPRA, l_Json OUT);
				SP_CONCATENAR_NUM('CODFIL', EMPRESA_SST.CODFIL, l_Json OUT);
				
				SP_E_SOCIAL_SM('S-2240', 'R583ESO', 'N', 'I', l_DataReferencia, l_DataTerHis, EMPRESA_SST.NUMEMP, 0, 0, l_Json, '', 0, NULL, l_DataReferencia, 0, 'R583ESO_EI');			
			END IF;
		END IF;
	END LOOP;
END␀(ê␀␀		SENIOR;0ˆ␀␀

TRIGGER R583ESO_EU BEFORE UPDATE ON R583ESO FOR EACH ROW
DECLARE
	l_Json VARCHAR(2000);
	l_Where VARCHAR(2000);
	l_DataTerHis DATE;
	l_CodPraStr VARCHAR(9);
	l_DataZero DATE;
	l_CodPra VARCHAR(9);
	l_DataReferencia DATE;
	l_CamposZeros BOOLEAN;
	l_DataMax DATE;
	l_AlterouRegistro BOOLEAN;
	l_AlterouCampo BOOLEAN;
	l_JsonAlteracao VARCHAR2(2000);
	
	CURSOR C_EMPRESA IS SELECT R583FIL.NUMEMP, R583FIL.CODFIL, R583FIL.DATINI, R583FIL.DATTER, R030DES.INISST FROM R583FIL, R030DES
						 WHERE R030DES.NUMEMP = R583FIL.NUMEMP 
						   AND R583FIL.CODPRA = CONVERT(CHAR_TO_NUMBER, l_CodPra)
						   AND R030DES.INISST <> l_DataZero
   					     ORDER BY NUMEMP;
   					    
   	TYPE T_EMPRESA IS RECORD (
		NUMEMP   R030EMP.NUMEMP%TYPE,
		CODFIL   R030FIL.CODFIL%TYPE,
		DATINI   R583FIL.DATINI%TYPE,
		DATTER   R583FIL.DATTER%TYPE,
		INISST   R030DES.INISST%TYPE
	);
	
	EMPRESA_SST T_EMPRESA;
	
BEGIN
	l_CodPra := :OLD.CodPRA;
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DataReferencia := :OLD.DATALT;
	l_CamposZeros := FALSE;
	l_DataMax := DATETIME(04, 06, 2080, 0, 0, 0);
  	l_JsonAlteracao := '';
  	
  	SP_VALUPDATE_DES(:OLD.ObsCom, :NEW.ObsCom, l_AlterouCampo OUT);
  	IF (l_AlterouCampo = TRUE) THEN
		l_AlterouRegistro := TRUE;
		l_JsonAlteracao := '{"OBSCOM":{"NEW":"O texto do campo Observações Complementares foi alterado.","OLD":"O texto do campo Observações Complementares foi alterado."}}';
  	END IF;
	
	IF (l_AlterouRegistro = TRUE)  THEN
		
		l_CodPraStr := CONVERT(NUMBER_TO_CHAR, :OLD.CODPRA);
		l_Where := 'CODPRA = ''' || l_CodPraStr || '''';
		SP_PROXHIST_NPER('DATALT', 'R583ESO', l_Where, :OLD.DATALT, l_DataTerHis OUT);
		
		FOREACH C_EMPRESA INTO EMPRESA_SST.NUMEMP, EMPRESA_SST.CODFIL, EMPRESA_SST.DATINI, EMPRESA_SST.DATTER, EMPRESA_SST.INISST LOOP
			l_Json := '';
			IF (l_DataTerHis >= EMPRESA_SST.INISST OR l_DataTerHis = l_DataZero) THEN 
				
				IF (l_DataTerHis = l_DataZero AND EMPRESA_SST.DATTER = l_DataZero) THEN
					l_CamposZeros := TRUE;
				END IF;
				
				IF (l_DataReferencia < EMPRESA_SST.INISST) THEN
					l_DataReferencia := EMPRESA_SST.INISST;
				END IF;
				
				IF (l_DataTerHis = l_DataZero) THEN
					l_DataTerHis := l_DataMax;
					
				END IF;
				
				IF (EMPRESA_SST.DATTER = l_DataZero) THEN
					EMPRESA_SST.DATTER := l_DataMax;
				END IF;
	
				IF ((EMPRESA_SST.DATINI >= l_DataReferencia AND (EMPRESA_SST.DATTER <= l_DataTerHis OR l_CamposZeros = TRUE OR EMPRESA_SST.DATTER = l_DataMax)) OR 
					(EMPRESA_SST.DATINI < l_DataReferencia AND (EMPRESA_SST.DATTER > l_DataReferencia OR l_CamposZeros = TRUE))) THEN
					
					SP_CONCATENAR_NUM('CODPRA', :OLD.CODPRA, l_Json OUT);
					SP_CONCATENAR_NUM('CODFIL', EMPRESA_SST.CODFIL, l_Json OUT);
					
					SP_E_SOCIAL_SM('S-2240', 'R583ESO', 'N', 'A', l_DataReferencia, l_DataTerHis, EMPRESA_SST.NUMEMP, 0, 0, l_Json, l_JsonAlteracao, 0, NULL, l_DataReferencia, 0, 'R583ESO_EU');				
				END IF;
			END IF;
		END LOOP;
	END IF;
END␀&ê␀␀		SENIOR;0v	␀␀

