1␀␀PROCEDURE SP_AUltRs(P_CRAATU NUMBER(12),P_CRAOLD NUMBER(12))
 IS

  l_craAtu       CHAR(12);
  l_craOld       CHAR(12);
  l_craAux       CHAR(12);
  l_ultrs        CHAR(25);
  l_update       BOOLEAN;
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_usutel       VARCHAR(31);
  l_comando      VARCHAR(2048);
  l_retnumberaux NUMBER;
  l_reterr       NUMBER(1);
  l_craAux_num   NUMBER(12);
  l_icardA       VARCHAR2(12);
  l_icardR       VARCHAR2(12);
  l_numser       VARCHAR2(12);
  l_subnv        VARCHAR2(7);  
  l_nivatu       CHAR(5);
  l_datniv       DATE;
  l_horniv       CHAR(5);
  l_seqniv       CHAR(6);  
BEGIN

  /*Atualiza Nível na R070CON*/
  l_nivatu := '99000';
  l_datniv := CURDATE();
  l_horniv := '2359';
  l_seqniv := '000001';  
  BEGIN
      SELECT nivatu, datniv, horniv, seqniv INTO l_nivatu, l_datniv, l_horniv, l_seqniv 
        FROM R070CON WHERE NUMCRA = p_craold AND CHCPRI = 0;
  EXCEPTION
      WHEN OTHERS THEN  l_nivatu := '99000';
                        l_datniv := CURDATE();
                        l_horniv := '2359';
                        l_seqniv := '000001';
  END;
  BEGIN
	  UPDATE R070CON SET NIVATU = l_nivatu, DATNIV = l_datniv, HORNIV = l_horniv, SEQNIV = l_seqniv WHERE NUMCRA = p_craatu;                     
	  /*SP_PEND26(l_idtpes, l_nivatu, l_datniv, l_horniv, l_seqniv);*/
  EXCEPTION 
      WHEN OTHERS THEN RAISERROR 103 'SP_AultRs: Erro Na Atualização do nível.';
  END;  


  /*Busca o usuário da Telemática*/
  SP_USUTEL(l_usutel OUT);

  SP_INTSTR(p_craAtu,'999999999999',l_craAtu OUT);
  SP_INTSTR(p_craOld,'999999999999',l_craOld OUT);

  SP_MAPFIS(l_craOld, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

  /* se não conseguir encontrar o principal, ou se o principal é smart, então considera o numcra */
  IF (l_crapri > 0) AND (l_tecpri <> 3) THEN
      SP_INTSTR(l_crapri,'999999999999',l_craAux OUT);
  ELSE
      l_craAux := l_craOld;
  END IF;

  /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
  l_craAux_num := CONVERT(CHAR_TO_NUMBER, l_craAux);
  SP_RETICARD(NULL, l_craAux_num, l_icardA OUT, l_icardR OUT, l_numser OUT);

  /* Verifica qual o valor do ultrs da crachá titular*/
  l_update := TRUE;
  l_comando := 'SELECT ULTRS FROM '|| l_usutel ||'CONTROLE WHERE ICARD = '''||l_icardA||'''';
  SP_SELTSI(1, 'l_ultrs', l_comando, l_retnumberaux OUT, l_ultrs OUT, l_reterr OUT);

  IF (l_reterr = 1) THEN
      /*EXCEÇÃO: NO DATA FOUND*/
      l_update := FALSE;
  END IF;

  l_comando := 'SELECT SUBNV FROM '|| l_usutel ||'CONTROLE WHERE ICARD = '''||l_icardA||'''';
  SP_SELTSI(1, 'l_subnv', l_comando, l_retnumberaux OUT, l_subnv OUT, l_reterr OUT);

  IF (l_reterr = 1) THEN
      /*EXCEÇÃO: NO DATA FOUND*/
      l_update := FALSE;
  END IF;

  /* atualiza o UltRs com valor do crachá anterior */
  IF (l_update =  TRUE) THEN

      SP_MAPFIS(l_craAtu, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
      IF (l_crapri > 0) AND (l_tecpri <> 3) THEN
          SP_INTSTR(l_crapri,'999999999999',l_craAux OUT);
      ELSE
          l_craAux := l_craAtu;
      END IF;

      /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
      l_craAux_num := CONVERT(CHAR_TO_NUMBER, l_craAux);
      SP_RETICARD(NULL, l_craAux_num, l_icardA OUT, l_icardR OUT, l_numser OUT);

      BEGIN
          l_comando := 'UPDATE '|| l_usutel ||'CONTROLE SET ULTRS = '''||l_ultRs||''', SUBNV = '''|| l_subnv|| ''' WHERE ICARD = '''||l_icardA||'''';
          SP_CMDTSI(l_comando);
      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;
  END IF;
END		SENIOR;23DSP_USUTEL
SP_INTSTR
SP_MAPFIS
SP_SELTSI
SP_CMDTSI
SP_RETICARD
