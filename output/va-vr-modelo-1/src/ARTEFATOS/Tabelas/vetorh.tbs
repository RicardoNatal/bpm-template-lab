      ELSIF  l_dia_semana = 7 THEN /* sábado */
            IF  ((LENGTH(l_faisab_ace)) < 49) OR ((LENGTH(l_faisab_ace) IS NULL)) THEN
                l_faisab_ace := l_faisab_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faisab_pto)) < 49) OR ((LENGTH(l_faisab_pto) IS NULL)) THEN
                l_faisab_pto := l_faisab_pto || l_stript || l_strfpt;
            END IF;
      END IF;
  END LOOP; /* LOOP r073asa */

  l_tipcra := 2;
  l_count := 0;
  /*Verifica Liberação de Faixa Horária para Crachá Provisório*/
  FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM LOOP
      SP_INTSTR(l_r070lfh.HORINI,'HHMM',l_striac OUT);
