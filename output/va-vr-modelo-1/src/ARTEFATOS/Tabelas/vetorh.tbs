/* Informa para a CSM Concentradora as portarias por usuário  */
/* Esta informação é exibida na console e utilizada pela Portaria Avançada para controle de agendamentos e de login */

/* VALSTR*/
/* 02 = Código da pendência (97)         */
/* 16 = Data de envio                    */
/* 01 = Tipo de Operação (2 - Insert/Update, 3 - Delete) */
/* 03 = Código da Portaria (CODPOR)      */
/* 10 = Código do Usuário (CODUSU)		 */
/* 01 = Portária Principal (PORPRI, 0 - Não, 1 - Sim) */

PROCEDURE SP_PEND97(P_TIPOPE CHAR(1), P_CODPOR NUMBER(3),P_CODUSU NUMBER(10),P_PORPRI CHAR(1))
 IS
BEGIN
  NULL;
