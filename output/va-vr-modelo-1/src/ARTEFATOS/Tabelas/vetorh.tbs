␀␀␀PROCEDURE HABILITAR_TRIGGER(P_TABELA VARCHAR2(255),P_TRIGGER VARCHAR2(255),P_HABILITAR NUMBER(1))
 IS

L_TODAS BOOLEAN;
BEGIN
	L_TODAS := TRUE;
	IF (LENGTH(P_TRIGGER) > 0) THEN
		L_TODAS := FALSE;
	END IF;
	
	BEGIN
		IF (P_HABILITAR = 1) THEN
			IF (L_TODAS = TRUE) THEN
				NULL;
			ELSE
				NULL;
			END IF;
		ELSE
			IF (L_TODAS = TRUE) THEN
				NULL;
			ELSE
				NULL;
			END IF;
		END IF;
	EXCEPTION WHEN OTHERS THEN
		RAISERROR 103 'Erro ao executar HABILITAR_TRIGGER';
	END;
END	ORACLE;0
„␀␀create or replace PROCEDURE HABILITAR_TRIGGER(P_TABELA IN VARCHAR2,P_TRIGGER IN VARCHAR2,P_HABILITAR IN NUMBER) IS
  PRAGMA AUTONOMOUS_TRANSACTION;
  L_TODAS BOOLEAN;
begin
  L_TODAS := TRUE;
  if (LENGTH(P_TRIGGER)>0) then
    L_TODAS := FALSE;
  end if;
  begin
    if (P_HABILITAR=1) then
      if (L_TODAS=TRUE) then
        EXECUTE IMMEDIATE 'ALTER TABLE ' || P_TABELA || ' ENABLE ALL TRIGGERS';
      else
        EXECUTE IMMEDIATE 'ALTER TRIGGER ' || P_TRIGGER || ' ENABLE';
      end if;
    else
      if (L_TODAS=TRUE) then
        EXECUTE IMMEDIATE 'ALTER TABLE ' || P_TABELA || ' DISABLE ALL TRIGGERS';
      else
        EXECUTE IMMEDIATE 'ALTER TRIGGER ' || P_TRIGGER || ' DISABLE';
      end if;
    end if;
  exception
    when OTHERS then
      raise_application_error(-20000 + -(103),'Erro ao executar HABILITAR_TRIGGER');
  end;
end HABILITAR_TRIGGER;

	MSSQL;0
␀␀CREATE  PROCEDURE habilitar_trigger(@P_TABELA VARCHAR(255), @P_TRIGGER VARCHAR(255), @P_HABILITAR SMALLINT) AS
BEGIN
DECLARE @l_todas NUMERIC(1,0)
  DECLARE @ChkError INTEGER
  DECLARE @NULL_VAR INTEGER
  DECLARE @SE_EXC1 INTEGER
  SELECT @ChkError = 0
  SELECT @L_TODAS = 1
  IF (DATALENGTH(@P_TRIGGER)>0)
  BEGIN
    SELECT @L_TODAS = 0
  END
  /* TRY */
    IF (@P_HABILITAR=1)
    BEGIN
      IF (@L_TODAS=1)
      BEGIN
        EXEC('ALTER TABLE ' + @P_TABELA + ' ENABLE TRIGGER ALL');
      END
      ELSE
      BEGIN
        EXEC('ENABLE TRIGGER ' + @P_TRIGGER + ' ON ' + @P_TABELA);
      END
    END
    ELSE
    BEGIN
      IF (@L_TODAS=1)
      BEGIN
        EXEC('ALTER TABLE ' + @P_TABELA + ' DISABLE TRIGGER ALL');
      END
      ELSE
      BEGIN
        EXEC('DISABLE TRIGGER ' + @P_TRIGGER + ' ON ' + @P_TABELA);
      END
    END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC1:
    SELECT @SE_EXC1 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        BEGIN
          RAISERROR('Erro ao executar HABILITAR_TRIGGER',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
FIM:
  RETURN @ChkError
END

	POSTGRESQL;0
c␀␀create or replace PROCEDURE HABILITAR_TRIGGER(P_TABELA IN VARCHAR(4000),P_TRIGGER IN VARCHAR(4000),P_HABILITAR IN INT) 
LANGUAGE 'plpgsql'
AS $BODY$
 DECLARE
  L_TODAS BOOLEAN;
BEGIN
  L_TODAS := TRUE;
  if (LENGTH(P_TRIGGER)>0) then
    L_TODAS := FALSE;
  end if;
  begin
    if (P_HABILITAR=1) then
      if (L_TODAS=TRUE) then
        EXECUTE 'ALTER TABLE ' || P_TABELA || ' ENABLE ALL TRIGGERS';
      else
        EXECUTE 'ALTER TRIGGER ' || P_TRIGGER || ' ENABLE';
      end if;
    else
      if (L_TODAS=TRUE) then
        EXECUTE 'ALTER TABLE ' || P_TABELA || ' DISABLE ALL TRIGGERS';
      else
        EXECUTE 'ALTER TRIGGER ' || P_TRIGGER || ' DISABLE';
      end if;
    end if;
  exception
    when OTHERS then
      RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'Erro ao executar HABILITAR_TRIGGER';
  end;
end;
$BODY$;␀Óuÿÿÿÿÿÿÿÿ	SENIOR;0
„␀␀PROCEDURE HR_ALTMAR(P_NUMCRA NUMBER(12),P_DATACC DATE,P_HORACC NUMBER(5),P_SEQACC NUMBER(2),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9))
 IS

V_DATZER                DATE;
  ALFMEN          VARCHAR2(255);
BEGIN
  V_DATZER := '31/12/1900,00:00:00';
  BEGIN
    UPDATE R070ACC SET NUMEMP = P_NUMEMP,TIPCOL = P_TIPCOL,NUMCAD = P_NUMCAD,DATAPU = V_DATZER
           WHERE NUMCRA = P_NUMCRA AND
                 DATACC = P_DATACC AND
                 HORACC = P_HORACC AND
                 SEQACC = P_SEQACC;
  EXCEPTION  WHEN OTHERS THEN
    ALFMEN := ' Erro de UPDATE na R070ACC na Base. Crachá : '
              ||CONVERT(NUMBER_TO_CHAR,p_numcra)
              ||'. Data:'||CONVERT(DATE_TO_CHAR,p_datacc)
              ||'. Hora:'||CONVERT(NUMBER_TO_CHAR,p_horacc)
              ||'. Sequência: '||CONVERT(NUMBER_TO_CHAR,p_seqacc);
    RAISERROR 103 ALFMEN;
  END;
END␀Ôuÿÿÿÿÿÿÿÿ	SENIOR;0RH_MODINT
­␀␀PROCEDURE HR_CALSEQ(P_CODESC NUMBER,P_CODTMA NUMBER,P_DATESC DATE,P_SEQESC OUT NUMBER)
 IS

/* Auxiliares. */
     l_datzer     DATE;
     l_fatrep    NUMBER;
     l_seqreg    NUMBER;
     l_difdat    NUMBER;

     /* Tabela R006TMA. */
     l_datbas   r006tma.datbas%TYPE;
BEGIN
l_seqreg := 0;
l_datzer := '31/12/1900,00:00:00';

/* Calcula FatRep, baseado maior SEQREG da Escala */
BEGIN
     SELECT COUNT(*) INTO l_fatrep FROM R006HOR WHERE CODESC=p_codesc;
EXCEPTION
WHEN OTHERS THEN
     l_fatrep := 0;
END;

IF   (l_fatrep <> 0) THEN
     /* Carrega Data Base conforme Escala/Turma */
     BEGIN
          SELECT DATBAS INTO l_datbas FROM R006TMA WHERE CODESC=p_codesc AND CODTMA=p_codtma;
     EXCEPTION
     WHEN OTHERS THEN
          l_datbas := l_datzer;
     END;

     /* Verifica qual dia deve buscar horários. */
     IF   (l_datbas <> l_datzer) THEN
          IF   (p_datesc > l_datbas) THEN
               l_difdat := DATETIMEDIF(DD, p_datesc, l_datbas);
               RH_MODINT(l_difdat, l_fatrep, l_seqreg OUT);
          ELSE l_difdat := DATETIMEDIF(DD, l_datbas, p_datesc);
               RH_MODINT(l_difdat, l_fatrep, l_seqreg OUT);
               IF   (l_seqreg > 0) THEN
                    l_seqreg := l_fatrep - l_seqreg;
               END IF;
          END IF;
     l_seqreg := l_seqreg + 1;
     END IF;
END IF;

/* Atualiza Variáveis de Retorno. */
p_seqesc := l_seqreg;
END␀Õuÿÿÿÿÿÿÿÿ	SENIOR;0RH_RETESC
RH_DATFER
û␀␀PROCEDURE HR_FOLPRF(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATINI DATE,P_DATFIM DATE)
 IS

/* Auxiliares. */
     v_datant DATE;
     v_diasem NUMBER;
     l_turint NUMBER(9);
     l_coderr NUMBER(2);
     l_codeqp NUMBER(4);
     l_codcat NUMBER(3);
     l_feriado BOOLEAN;

     /* Tabela R066HOR. */
     v_datapu   r066hor.datapu%TYPE;
     v_codhor   r066hor.hordat%TYPE;

     /* Tabela R066APU. */
     v_hordat   r066apu.hordat%TYPE;

     /* Tabela R006ESC. */
     l_codesc   r006esc.codesc%TYPE;
     l_escant   r006esc.codesc%TYPE;
     l_tipfer   r006esc.tipfer%TYPE;
     l_tabfer   r006esc.tabfer%TYPE;
     l_turesc   r006esc.turesc%TYPE;

     /* Tabela R034FUN. */
     l_codfil   r034fun.codfil%TYPE;
     
     /* CURSOR QUE LE OS HORÁRIOS DOS PROFESSORES. */
     CURSOR C_LERHORPRF IS
            SELECT   DATAPU
            FROM     R066HOR
            WHERE    NUMEMP =  p_numemp AND
                     TIPCOL =  p_tipcol AND
                     NUMCAD =  p_numcad AND
                     DATAPU >= p_datini AND
                     DATAPU <= p_datfim
            ORDER BY 1;
            
BEGIN
/* Inicializa Variáveis. */
v_datant := DATETIMEADD(DD, -1, p_datini);
l_escant := 0;
l_codfil := 0;

/* Verifica Atividades e Disciplinas do Professor. */
FOREACH C_LERHORPRF INTO V_DATAPU
LOOP
     IF   (V_DATAPU <> V_DATANT) THEN
          LOOP
               v_datant := DATETIMEADD(DD, 1, v_datant);
               IF  (v_datant >= v_datapu) THEN
                    EXIT;
               END IF;
               
               v_hordat := 0;
               /* Busca Tipo Da Escala. */
               RH_RETESC(p_numemp,p_tipcol,p_numcad,v_datant,l_codesc OUT,l_turesc OUT,l_turint OUT,l_coderr OUT,l_codeqp OUT,l_codcat OUT);
               IF   (l_codesc <> l_escant) THEN
                    BEGIN
                         SELECT TIPFER,TABFER,TURESC INTO l_tipfer,l_tabfer,l_turesc FROM R006ESC WHERE CODESC=l_codesc;
                    EXCEPTION
                    WHEN OTHERS THEN
                         l_tipfer := 'N';
                    END;
                    l_escant := l_codesc;
               END IF;
     
               /* Busca Filial do Colaborador. */
               IF   ((l_tipfer = 'F') AND (l_codfil = 0)) THEN
                    BEGIN
                         SELECT CODFIL INTO l_codfil FROM R034FUN 
                          WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND 
                                NUMCAD = p_numcad;
                    EXCEPTION
                    WHEN OTHERS THEN
                         l_codfil := 0;
                    END;
               END IF;
    
               /* Verifica se dia é um feriado. */
               RH_DATFER(p_numemp,p_tipcol,p_numcad,l_codfil,l_tipfer,l_tabfer,l_turesc,v_datant,'',l_feriado OUT);
               IF   (l_feriado = TRUE) THEN
                    v_hordat := 9997;
               END IF;

               /* Verifica horário.
                  Feriado = 9997, Em Dias da semana = 9996, No Domingo = 9999.*/
               IF   (v_hordat = 9997) THEN
                    v_codhor := 9997;
               ELSE
                    v_diasem := dayofweek(v_datant);
                    IF    (v_diasem = 1) THEN
                          v_codhor := 9999;
                    ELSE
                          v_codhor := 9996;
                    END IF;
               END IF;

               /* Insere registro na tabela r066hor. */
               BEGIN
                    INSERT INTO R066HOR (NUMEMP, TIPCOL, NUMCAD, DATAPU,
                                         HORDAT, CODRAT, CODAPF, CODDPF)
                                VALUES  (p_numemp,p_tipcol,p_numcad, v_datant,
                                         v_codhor, 0, 0, 0);
               EXCEPTION WHEN OTHERS THEN
                    NULL;
               END;
          END LOOP;
     END IF;
END LOOP;


LOOP
     v_datant := DATETIMEADD(DD, 1, v_datant);
     IF  (v_datant > p_datfim) THEN
          EXIT;
     END IF;

     v_hordat := 0;
     /* Busca Tipo Da Escala. */
     RH_RETESC(p_numemp,p_tipcol,p_numcad,v_datant,l_codesc OUT,l_turesc OUT,l_turint OUT,l_coderr OUT,l_codeqp OUT,l_codcat OUT);
     IF   (l_codesc <> l_escant) THEN
          BEGIN
               SELECT TIPFER,TABFER,TURESC INTO l_tipfer,l_tabfer,l_turesc FROM R006ESC WHERE CODESC=l_codesc;
          EXCEPTION
          WHEN OTHERS THEN
               l_tipfer := 'N';
          END;
          l_escant := l_codesc;
     END IF;
     
     /* Busca Filial do Colaborador. */
     IF   ((l_tipfer = 'F') AND (l_codfil = 0)) THEN
          BEGIN
               SELECT CODFIL INTO l_codfil FROM R034FUN 
                WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND 
                      NUMCAD = p_numcad;
          EXCEPTION
          WHEN OTHERS THEN
               l_codfil := 0;
          END;
     END IF;
    
     /* Verifica se dia é um feriado. */
     RH_DATFER(p_numemp,p_tipcol,p_numcad,l_codfil,l_tipfer,l_tabfer,l_turesc,v_datant,'',l_feriado OUT);
     IF   (l_feriado = TRUE) THEN
          v_hordat := 9997;
     END IF;

     /* Verifica se é um feriado. Não inclui dias em feriados. */
     /* Verifica horário. Em Dias da semana = 9996,No Domingo = 9999.*/
     /* Pega dia da semana da data parâmetro. */
     IF   (v_hordat = 9997) THEN
          v_codhor := 9997;
     ELSE
          v_diasem := dayofweek(v_datant);
          IF    (v_diasem = 1) THEN
                v_codhor := 9999;
          ELSE
                v_codhor := 9996;
          END IF;
     END IF;

     /* Insere registro na tabela r066hor. */
     BEGIN
          INSERT INTO R066HOR (NUMEMP, TIPCOL, NUMCAD, DATAPU,
                               HORDAT, CODRAT, CODAPF, CODDPF)
                      VALUES  (p_numemp,p_tipcol,p_numcad, v_datant,
                               v_codhor, 0, 0, 0);
     EXCEPTION WHEN OTHERS THEN
          NULL;
     END;
END LOOP;
END␀Öuÿÿÿÿÿÿÿÿ	SENIOR;0
{␀␀/* Procedure de Atualizado dos Saldos de Eventos Antes */
PROCEDURE HR_GEREVE(IN_NUMEMP NUMBER(4),IN_TIPCOL NUMBER(1),IN_NUMCAD NUMBER(9),IN_CODCAL NUMBER)
 IS

/* V_CONDEP      NUMBER(3);    */
     /* V_DATATU      VARCHAR2(20); */
     V_TABEVE      NUMBER(3);
     V_CODCAL        R044CAL.CODCAL%TYPE;
     V_PERCAL      DATE;
     V_PERREF      DATE;
     V_CODSAL      NUMBER(4);
     V_CODANT      NUMBER(4);
     V_SALANT      NUMBER(10);
     V_SALATU      NUMBER(10);
     V_TIPOPE      NUMBER(1);
     CURSOR C_LERCMPSAL IS
            SELECT   R044CAL.CODCAL,R044CAL.PERREF,R008CSE.CODSAL
            FROM     R044CAL,R008CSE
            WHERE    R044CAL.NUMEMP = IN_NUMEMP AND
                     R044CAL.TIPCAL = 11 AND
                     R008CSE.CODTAB = V_TABEVE AND
                     R044CAL.PERREF >= R008CSE.CMPINI AND
                     R044CAL.PERREF <= V_PERCAL
            GROUP BY R044CAL.CODCAL,R044CAL.PERREF,R008CSE.CODSAL
            ORDER BY R008CSE.CODSAL,R044CAL.PERREF;
     BEGIN
     /* Busca Data/Hora Atual do Oracle p/ Log de Depuracao. */
     /* SELECT TO_CHAR (SYSDATE, 'DD/MM/YYYY hh:mi') INTO V_DATATU FROM DUAL; */
     /* V_CONDEP := 1; */

     /* Buca Competencia do Calculo Atual. */
     BEGIN
          SELECT PERREF INTO V_PERCAL FROM R044CAL WHERE NUMEMP = IN_NUMEMP AND CODCAL = IN_CODCAL;
     EXCEPTION
          WHEN NO_DATA_FOUND THEN
               RAISERROR 103 'Cálculo do Lançamento do Evento Não Cadastrado.';
     END;

     /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||' ATUSALEVE '||'[PERCAL]: '||V_PERCAL); */
     /* V_CONDEP := V_CONDEP + 1; */

     /* Buca Tabela de Eventos Segundo a Empresa do Colaborador. */
     BEGIN
          SELECT TABEVE INTO V_TABEVE FROM R030EMP
                 WHERE NUMEMP = IN_NUMEMP;
     EXCEPTION
          WHEN NO_DATA_FOUND THEN
               RAISERROR 103 'Empresa do Lançamento do Evento Não Cadastrada.';
     END;

     /* Inicializa Variavel c/ Codigo/Valor do Saldo Anterior do Evento. */
     V_CODANT := 0;
     V_SALANT := 0;

     /* Busca as Competencias dos Calculos Onde Deve Existir Valor p/ o Saldos de Eventos. */
     FOREACH C_LERCMPSAL INTO V_CODCAL,V_PERREF,V_CODSAL
     LOOP
          /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||' ATUSALEVE '||'[CODSAL,CODCAL,CODANT,SALANT]: '||V_CODSAL||' '||V_CODCAL||' '||V_CODANT||' '||V_SALANT); */
          /* V_CONDEP := V_CONDEP + 1; */

          /* Verifica se o Saldo Anterior e Zero. */
          IF  (V_CODANT = 0) THEN
              V_CODANT := V_CODSAL;
          END IF;
          /* Verifica se Alterou de Saldo. */
          IF  (V_CODANT <> V_CODSAL) THEN
              BEGIN
              V_SALANT := 0;
              V_CODANT := V_CODSAL;
              END;
          END IF;

          /* Inicializa Variavel c/ Tipo de Operacao a Ser Realizada no Calculo para o Saldo do Evento (Inclusao/Alteracao). */
          V_TIPOPE := 0;

          /* Verifica se o Saldo do Evento Neste Calculo Ja Existe. */
          BEGIN
          SELECT IFNULL (HORSAL,0) INTO V_SALATU FROM R008SAL
                 WHERE NUMEMP = IN_NUMEMP AND TIPCOL = IN_TIPCOL AND NUMCAD = IN_NUMCAD AND
                       CODCAL = V_CODCAL AND CODSAL = V_CODSAL;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    V_SALATU :=0;
                    V_TIPOPE := 1;
                    INSERT INTO R008SAL (NUMEMP,TIPCOL,NUMCAD,CODCAL,TABEVE,CODSAL,HORSAL,ORIALT)
                           VALUES (IN_NUMEMP,IN_TIPCOL,IN_NUMCAD,V_CODCAL,V_TABEVE,V_CODSAL,V_SALANT,'P');

                    /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||' ATUSALEVE '||'Insere Valor Saldo: '||V_SALANT); */
                    /* V_CONDEP := V_CONDEP + 1; */
          END;
          IF   (V_TIPOPE = 0) THEN
               BEGIN
               V_SALANT := V_SALATU;

               /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||' ATUSALEVE '||'Incrementa Valor Saldo: '||V_SALANT); */
               /* V_CONDEP := V_CONDEP + 1; */
               END;
          END IF;
     END LOOP;
     END␀×uÿÿÿÿÿÿÿÿ	SENIOR;0RH_MODINT
RH_DATFER
k␀␀PROCEDURE HR_HOROCR(P_NUMEMP NUMBER(4),P_CODESC NUMBER,P_CODTMA NUMBER,P_DATHOR DATE,P_CODHOR OUT NUMBER(4),P_CODERR OUT NUMBER(2))
 IS

l_data_zero DATE;
   l_data      DATE;
   l_fatrep    NUMBER;
   l_seqreg    NUMBER;
   l_datbas    DATE;
   l_tipfer   CHAR(1);
   l_tabfer   NUMBER;
   l_tipesc   CHAR(1);
   l_codhor   INTEGER;
   l_coderr   INTEGER;
   l_prgfer   CHAR(1);
   l_feriado  BOOLEAN;
   l_dataux   NUMBER;
   l_vetrpo   CHAR(1);
BEGIN
   l_data_zero  := '31/12/1900,00:00:00';
   l_codhor := 0;
   l_coderr := 0;

   l_data := p_dathor;
   /* Verifica o Tipo de Escala */
   BEGIN
      SELECT TIPFER,TABFER,TIPESC INTO l_tipfer,l_tabfer,l_tipesc FROM R006ESC WHERE CODESC=p_codesc;
   EXCEPTION
     WHEN NO_DATA_FOUND THEN
      l_coderr := 5;
     WHEN OTHERS THEN
      l_coderr := 10;
   END;

   /* Verifica se é integrado com o Ronda Ponto */
   BEGIN
      SELECT VETRPO INTO l_vetrpo FROM R000PRP;
   EXCEPTION
     WHEN OTHERS THEN
      l_vetrpo := 'N';
   END;

   IF  (l_coderr = 0) THEN

       /* Escala Tipo Definida */
       IF (l_tipesc = 'D') THEN
          BEGIN
             SELECT CODHOR INTO l_codhor FROM R006CES WHERE CODESC=p_codesc AND DATESC=l_data;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
             l_coderr := 6;
            WHEN OTHERS THEN
             l_coderr := 10;
          END;
       END IF;

       /* Escala Tipo Permanente/Busca Automatica */
       IF (l_tipesc = 'P') OR (l_tipesc = 'B') THEN

          /* Calcula FatRep, baseado maior SEQREG da Escala */
          BEGIN
             SELECT COUNT(*) INTO l_fatrep FROM R006HOR WHERE CODESC=p_codesc;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
             l_coderr := 7;
            WHEN OTHERS THEN
             l_coderr := 10;
          END;

          IF   (l_fatrep = 0) THEN
               l_coderr := 7;
          END IF;

          IF   (l_coderr = 0) THEN
               /* Carrega Data Base conforme Escala/Turma */
               BEGIN
                  SELECT DATBAS INTO l_datbas FROM R006TMA WHERE CODESC=p_codesc AND CODTMA=p_codtma;
               EXCEPTION
                 WHEN NO_DATA_FOUND THEN
                  l_coderr := 8;
                 WHEN OTHERS THEN
                  l_coderr := 10;
               END;

               IF   (l_coderr = 0) THEN

                    /* calcula a seq. do dia da semana */
                    IF   (l_data > l_datbas) THEN
                         l_dataux := DATETIMEDIF(DD, l_data, l_datbas);
                         RH_MODINT(l_dataux, l_fatrep, l_seqreg OUT);
                    ELSE l_dataux := DATETIMEDIF(DD, l_datbas, l_data);
                         RH_MODINT(l_dataux, l_fatrep, l_seqreg OUT);
                         IF   (l_seqreg > 0) THEN
                              l_seqreg := l_fatrep - l_seqreg;
                         END IF;
                    END IF;
                    l_seqreg := l_seqreg + 1;

                    /* Carrega Horario */
                    BEGIN
                       SELECT CODHOR INTO l_codhor FROM R006HOR
                       WHERE CODESC=p_codesc AND SEQREG=l_seqreg;
                    EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                       l_coderr := 7;
                      WHEN OTHERS THEN
                       l_coderr := 10;
                    END;

                    IF   (l_coderr = 0) AND (l_vetrpo = 'S') THEN
                         /* Verifica se as Programacoes Sobrepoe o Feriado */
                         BEGIN
                            SELECT PRGFER INTO l_prgfer FROM R060DAP,R030EMP WHERE R030EMP.NUMEMP = p_numemp AND R060DAP.CODDAP = R030EMP.CODDAP;
                         EXCEPTION
                             WHEN NO_DATA_FOUND THEN
                            l_coderr := 9;
                           WHEN OTHERS THEN
                            l_coderr := 10;
                         END;

                         IF   (l_coderr = 0) THEN
                              IF (l_prgfer = 'S') THEN
                                 /* Verifica Se a data é Feriado */
                                 Rh_DatFer(0,0,0,0,l_tipfer,l_tabfer,p_codtma,l_data,'',l_feriado OUT);
                                 IF  (l_feriado = TRUE) THEN
                                     l_codhor := 9997;
                                 END IF;
                              END IF;
                         END IF;
                    END IF;
               END IF;
          END IF;
       END IF;
   END IF;

   p_codhor := l_codhor;
   p_coderr := l_coderr;
END␀Øuÿÿÿÿÿÿÿÿ	SENIOR;0HR_INCHOR
HR_FOLPRF
™␀␀PROCEDURE HR_HORPRF(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATINI DATE,P_DATFIM DATE)
 IS

/* Auxiliares. */
     v_datzer DATE;
     v_auxdatini DATE;
     v_auxdatfim DATE;
     
     /* Tabala R171APF. */
     v_datini   r171apf.DATINI%TYPE;
     v_datfim   r171apf.DATFIM%TYPE;
     v_codrat   r171apf.codrat%TYPE;
     v_horseg   r171apf.horseg%TYPE;
     v_horter   r171apf.horter%TYPE;
     v_horqua   r171apf.horqua%TYPE;
     v_horqui   r171apf.horqui%TYPE;
     v_horsex   r171apf.horsex%TYPE;
     v_horsab   r171apf.horsab%TYPE;
     v_hordom   r171apf.hordom%TYPE;
     v_codapf   r171apf.codapf%TYPE;
     v_coddpf   r171dpf.coddpf%TYPE;

     /* CURSOR QUE BUSCA AS ATIVIDADES E DISCIPLINAS DO COLABORADOR. */
     CURSOR C_LERATIDISCOL IS
            SELECT DATINI,DATFIM,CODRAT,HORSEG,HORTER,HORQUA,
                   HORQUI,HORSEX,HORSAB,HORDOM,CODAPF,0 CODDPF
            FROM   R171APF
            WHERE  NUMEMP =  p_numemp AND
                   TIPCOL =  p_tipcol AND
                   NUMCAD =  p_numcad AND
                   DATINI <= p_datfim AND
                   (DATFIM >= p_datini OR
                   DATFIM = v_datzer)
            UNION ALL
           (SELECT DATINI,DATFIM,CODRAT,HORSEG,HORTER,HORQUA,
                   HORQUI,HORSEX,HORSAB,HORDOM,0 CODAPF,CODDPF
             FROM  R171DPF
            WHERE  NUMEMP =  p_numemp AND
                   TIPCOL =  p_tipcol AND
                   NUMCAD =  p_numcad AND
                   DATINI <= p_datfim AND
                   (DATFIM >= p_datini OR
                    DATFIM = v_datzer));
BEGIN
v_datzer := '31/12/1900,00:00:00';

/* Elimina Registros na tabela R066HOR. Serão calculados novamente. */
BEGIN
     DELETE FROM R066HOR
      WHERE NUMEMP =  p_numemp AND
            TIPCOL =  p_tipcol AND
            NUMCAD =  p_numcad AND
            DATAPU >= p_datini AND
            DATAPU <= p_datfim;
EXCEPTION WHEN OTHERS THEN
     NULL;
END;

/* Verifica Atividades e Disciplinas do Professor. */
FOREACH C_LERATIDISCOL INTO V_DATINI,V_DATFIM,V_CODRAT,V_HORSEG,V_HORTER,V_HORQUA,V_HORQUI,V_HORSEX,V_HORSAB,V_HORDOM,V_CODAPF,V_CODDPF
LOOP
     /* Calcula Data Inicial. */
     IF   (v_datini < p_datini) THEN
          v_auxdatini := p_datini;
     ELSE v_auxdatini := v_datini;
     END IF;

     /* Calcula Data Final. */
     IF   ((v_datfim > p_datfim) OR (v_datfim = v_datzer)) THEN
          v_auxdatfim := p_datfim;
     ELSE v_auxdatfim := v_datfim;
     END IF;

     /* Chama procedure que grava registro na tabela R066HOR. */
     HR_INCHOR(p_numemp,p_tipcol,p_numcad,v_auxdatini,v_auxdatfim,v_codrat,v_horseg,v_horter,v_horqua,v_horqui,v_horsex,v_horsab,v_hordom,v_codapf,v_coddpf);
END LOOP;

/* Nos dias que não tem atividade e não tem disciplina devo incluir um registro de horário 9996 ou 9999. */
HR_FOLPRF(p_numemp,p_tipcol,p_numcad,p_datini,p_datfim);
END␀Ùuÿÿÿÿÿÿÿÿ	SENIOR;0RH_RETESC
RH_DATFER
␀␀PROCEDURE HR_INCHOR(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATINI DATE,P_DATFIM DATE,P_CODRAT NUMBER,P_HORSEG NUMBER,P_HORTER NUMBER,P_HORQUA NUMBER,P_HORQUI NUMBER,P_HORSEX NUMBER,P_HORSAB NUMBER,P_HORDOM NUMBER,P_CODAPF NUMBER,P_CODDPF NUMBER)
 IS

/* Auxiliares. */
     v_diasem NUMBER;
     l_feriado BOOLEAN;
     l_turint NUMBER(9);
     l_codeqp NUMBER(4);
     l_codcat NUMBER(3);
     l_coderr NUMBER(2);

     /* Tabela R066HOR. */
     v_datapu   r066hor.datapu%TYPE;
     v_codhor   r066hor.hordat%TYPE;
     v_tipcol   r066hor.tipcol%TYPE;

     /* Tabela R066APU. */
     v_hordat   r066apu.hordat%TYPE;

     /* Tabela R006ESC. */
     l_codesc   r006esc.codesc%TYPE;
     l_escant   r006esc.codesc%TYPE;
     l_tipfer   r006esc.tipfer%TYPE;
     l_tabfer   r006esc.tabfer%TYPE;
     l_turesc   r006esc.turesc%TYPE;

     /* Tabela R034FUN. */
     l_codfil   r034fun.codfil%TYPE;
BEGIN
/* Inicializa Variáveis. */
v_datapu := p_datini;
l_codfil := 0;
l_escant := 0;

/* Loop que vai incluindo em todas as datas. */
LOOP
     IF  (v_datapu > p_datfim) THEN
          EXIT;
     END IF;
     
     v_codhor := 0;
     v_hordat := 0;

     /* Busca Tipo Da Escala. */
     RH_RETESC(p_numemp,p_tipcol,p_numcad,v_datapu,l_codesc OUT,l_turesc OUT,l_turint OUT,l_coderr OUT,l_codeqp OUT,l_codcat OUT);
     IF   (l_codesc <> l_escant) THEN
          BEGIN
               SELECT TIPFER,TABFER,TURESC INTO l_tipfer,l_tabfer,l_turesc FROM R006ESC WHERE CODESC=l_codesc;
          EXCEPTION
          WHEN OTHERS THEN
               l_tipfer := 'N';
          END;
          l_escant := l_codesc;
     END IF;
     
     /* Busca Filial do Colaborador. */
     IF   ((l_tipfer = 'F') AND (l_codfil = 0)) THEN
          BEGIN
               SELECT CODFIL INTO l_codfil FROM R034FUN 
                WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND 
                      NUMCAD = p_numcad;
          EXCEPTION
          WHEN OTHERS THEN
               l_codfil := 0;
          END;
     END IF;
    
     /* Verifica se dia é um feriado. */
     RH_DATFER(p_numemp,p_tipcol,p_numcad,l_codfil,l_tipfer,l_tabfer,l_turesc,v_datapu,'',l_feriado OUT);
     IF   (l_feriado = TRUE) THEN
          v_hordat := 9997;
     END IF;
     
     IF   (V_HORDAT <> 9997) THEN
          /* Verifica horário. Cada dia da semana tem um horário diferente. */
          /* Pega dia da semana da data parâmetro. */
          v_diasem := dayofweek(v_datapu);
          IF    (v_diasem = 1) THEN
                v_codhor := p_hordom;
          ELSIF (v_diasem = 2) THEN
               v_codhor := p_horseg;
          ELSIF (v_diasem = 3) THEN
               v_codhor := p_horter;
          ELSIF (v_diasem = 4) THEN
               v_codhor := p_horqua;
          ELSIF (v_diasem = 5) THEN
               v_codhor := p_horqui;
          ELSIF (v_diasem = 6) THEN
               v_codhor := p_horsex;
          ELSIF (v_diasem = 7) THEN
               v_codhor := p_horsab;
          END IF;

          IF   (v_codhor <> 0) THEN
               /* Verifica se existe registro para não dar violação de chave. */
               BEGIN
                    SELECT TIPCOL INTO V_TIPCOL FROM R066HOR
                           WHERE NUMEMP = p_numemp AND 
                                 TIPCOL = p_tipcol AND
                                 NUMCAD = p_numcad AND
                                 DATAPU = v_datapu AND
                                 HORDAT = v_codhor;
               EXCEPTION WHEN OTHERS THEN
                    V_TIPCOL := 0;
               END;
               
               IF   (V_TIPCOL = 0) THEN
                    /* Insere registro na tabela r066hor. */
                    BEGIN
                         INSERT INTO R066HOR (NUMEMP, TIPCOL, NUMCAD, DATAPU,
                                              HORDAT, CODRAT, CODAPF, CODDPF)
                                     VALUES  (p_numemp,p_tipcol,p_numcad,v_datapu,
                                              v_codhor, p_codrat,p_codapf, p_coddpf);
                    EXCEPTION WHEN OTHERS THEN
                         NULL;
                    END;
               END IF;
          END IF;
     END IF;

     v_datapu := DATETIMEADD(DD, 1, v_datapu);
END LOOP;
END␀Úuÿÿÿÿÿÿÿÿ	SENIOR;0HR_MESLAN
HR_SEMLAN
:j␀␀PROCEDURE HR_LANBHR(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATINI DATE,P_DATFIM DATE)
 IS

/* Tabela R011DBH. */
     l_fecmes   r011dbh.fecmes%TYPE;
     l_fecsem   r011dbh.fecsem%TYPE;
     l_verlim   r011dbh.verlim%TYPE;

     /* TABELA R011BHR. */
     l_diacre   r011bhr.diacre%TYPE;
     l_semcre   r011bhr.semcre%TYPE;
     l_mescre   r011bhr.mescre%TYPE;
     l_salcre   r011bhr.salcre%TYPE;
     l_diadeb   r011bhr.diadeb%TYPE;
     l_semdeb   r011bhr.semdeb%TYPE;
     l_mesdeb   r011bhr.mesdeb%TYPE;
     l_saldeb   r011bhr.saldeb%TYPE;

     /* Tabela R011SIT. */
     l_sinsit   r011sit.sinsit%TYPE;
     l_ordcom   r011sit.ordcom%TYPE;

     /* Tabela R011LAN e R011EST. */
     l_codbhr   r011lan.codbhr%TYPE;
     l_datlan   r011lan.datlan%TYPE;
     l_codsit   r011lan.codsit%TYPE;
     l_orilan   r011lan.orilan%TYPE;
     l_sinlan   r011lan.sinlan%TYPE;
     l_qtdhor   r011lan.qtdhor%TYPE;
     l_qtdpag   r011lan.qtdpag%TYPE;
     l_datcmp   r011lan.datcmp%TYPE;

     /* Variáveis utilizadas no cálculo de horas. */
     qtd11lan   r011lan.qtdhor%TYPE;
     qtd11est   r011lan.qtdhor%TYPE;
     l_totmescre   r011lan.qtdhor%TYPE;
     l_totsemcre   r011lan.qtdhor%TYPE;
     l_totdiacre   r011lan.qtdhor%TYPE;
     l_totmesdeb   r011lan.qtdhor%TYPE;
     l_totsemdeb   r011lan.qtdhor%TYPE;
     l_totdiadeb   r011lan.qtdhor%TYPE;
     l_estbhr   r011lan.qtdhor%TYPE;
     l_bhrant   r011lan.codbhr%TYPE;
     l_orilanant   r011lan.orilan%TYPE;
     l_sinlanant   r011lan.sinlan%TYPE;
     l_codbhrant   r011lan.codbhr%TYPE;
     l_datlanant   r011lan.datlan%TYPE;
     l_codsitant   r011lan.codsit%TYPE;
     l_datcmpant   r011lan.datcmp%TYPE;
     l_tablan NUMBER;

     /* Auxiliares. */
     l_datini DATE;
     l_datfim DATE;
     l_iniaux DATE;
     l_fimaux DATE;
     l_mesdatini DATE;
     l_mesdatfim DATE;
     l_semdatini DATE;
     l_semdatfim DATE;
     l_slvmesini DATE;
     l_slvmesfim DATE;
     l_slvsemini DATE;
     l_slvsemfim DATE;
     l_datant DATE;
     l_codcal NUMBER;
     V_DATZER DATE;

     /* CURSOR QUE BUSCA OS LANÇAMENTOS DO BANCO DE HORAS(R011LAN e R011EST). */
     CURSOR C_LANBHR IS
          SELECT R011LAN.CODBHR,DATLAN,R011SIT.ORDCOM,R011LAN.CODSIT,ORILAN,SINLAN,QTDHOR,QTDPAG,DATCMP,14 TABLAN
            FROM R011LAN,R011SIT
           WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                 DATLAN >= l_datini AND DATLAN <= l_datfim AND ORILAN = 'A' AND 
                 R011LAN.CODBHR = R011SIT.CODBHR AND R011LAN.CODSIT = R011SIT.CODSIT
           UNION ALL
         (SELECT R011EST.CODBHR,DATLAN,R011SIT.ORDCOM,R011EST.CODSIT,'A' ORILAN,SINLAN,QTDHOR,0 QTDPAG,DATCMP,15 TABLAN
            FROM R011EST,R011SIT
           WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                 DATLAN >= l_datini AND DATLAN <= l_datfim AND 
                 R011EST.CODBHR = R011SIT.CODBHR AND R011EST.CODSIT = R011SIT.CODSIT
         )ORDER BY 1,2,3,4,10;
         
BEGIN
l_datant := '31/12/1900,00:00:00';
v_datzer := '31/12/1900,00:00:00';

/* Busca Definições do Banco de Horas. */
BEGIN
     SELECT FECMES,FECSEM,VERLIM INTO
            l_fecmes,l_fecsem,l_verlim FROM R011DBH;
EXCEPTION
WHEN OTHERS THEN
     /* Valores Default: Pelo Período Folha, Semana termina no Sábado,   */
     /* Verificar somente pelo total de créditos.                        */
     l_fecmes := 'F';
     l_fecsem := 7;
     l_verlim := 'C';
END;

/* Calcula Período que deve ser dado select. */
/* Busca Período de Cálculo da Data Inicial para verificar estouro de limites. */
HR_MESLAN(p_numemp,p_datini,l_fecmes,l_codcal OUT,l_datini OUT,l_datfim OUT);
/* Calcula Ínicio e Fim do Mês. */
l_mesdatini := l_datini;
l_mesdatfim := l_datfim;
IF    (p_datfim > l_datfim) THEN
     /* Busca Período de Cálculo da Data Final para verificar estouro de limites. */
     HR_MESLAN(p_numemp,p_datfim,l_fecmes,l_codcal OUT,l_datini OUT,l_datfim OUT);
     l_datini := l_mesdatini;

     /* Se não encontrar cálculo para data final verifica pela data inicial. */
     IF   (l_datfim = v_datzer) THEN
          l_datfim := p_datfim;
     END IF;
END IF;

/* Calcula Ínicio e Fim da Semana. */
HR_SEMLAN(p_datini,l_fecsem,l_semdatini OUT,l_semdatfim OUT);
/* Se semana começa antes do início do mês antecipa início select. */
IF   (l_semdatini <> v_datzer) AND (l_semdatini < l_datini) THEN
     l_datini := l_semdatini;
END IF;

IF   (p_datfim > l_semdatfim) THEN
     HR_SEMLAN(p_datfim,l_fecsem,l_iniaux OUT,l_fimaux OUT);
     IF   (l_fimaux > l_datfim) THEN
          l_datfim := l_fimaux;
     END IF;
ELSIF (l_semdatfim > l_datfim) THEN
     l_datfim := l_semdatfim;
END IF;

/* Guarda Variáveis que serão utilizadas caso colaborador tenha mais de um banco de horas. */
l_slvmesini := l_mesdatini;
l_slvmesfim := l_mesdatfim;
l_slvsemini := l_semdatini;
l_slvsemfim := l_semdatfim;

/* Inicializa variáveis auxiliares do LOOP. */
QTD11EST := 0;
L_BHRANT := 0;
L_ORILANANT := 'A';
L_SINLANANT := '+';

/* CURSOR que Busca as Marcações de Refeitório no Período. */
FOREACH C_LANBHR INTO L_CODBHR,L_DATLAN,L_ORDCOM,L_CODSIT,L_ORILAN,L_SINLAN,L_QTDHOR,L_QTDPAG,L_DATCMP,L_TABLAN
LOOP
     /* Verifica se tem horas para atribuir na R011EST. */
     IF   (QTD11EST > 0) AND
          (l_codbhrant = l_codbhr) AND
          (l_datlanant = l_datlan) AND
          (l_codsitant = l_codsit) AND
          (l_orilanant = l_orilan) AND
          (l_tablan = 15) THEN
          QTD11EST := QTD11EST + L_QTDHOR;
          /* UPDATE na tabela R011EST. */
          IF   (l_datlan >= p_datini) THEN
               BEGIN
                    UPDATE R011EST SET QTDHOR = QTD11EST
                          WHERE NUMEMP = p_numemp AND
                                TIPCOL = p_tipcol AND
                                NUMCAD = p_numcad AND
                                CODBHR = l_codbhr AND
                                DATLAN = l_datlan AND
                                CODSIT = l_codsit;
               EXCEPTION WHEN OTHERS THEN
                    NULL;
               END;
          END IF;
          QTD11EST := 0;
     ELSE
          /* Insere registro na tabela r011est. */
          IF   (QTD11EST > 0) THEN
               IF   (l_datlanant >= p_datini) THEN
                    BEGIN
                         INSERT INTO R011EST (NUMEMP, TIPCOL, NUMCAD, CODBHR, DATLAN, 
                                              CODSIT, SINLAN, QTDHOR, DATCMP)
                                     VALUES  (p_numemp,p_tipcol,p_numcad,l_codbhrant,l_datlanant,
                                             l_codsitant,l_sinlanant,QTD11EST,l_datcmpant);
                    EXCEPTION WHEN OTHERS THEN
                         NULL;
                    END;
               END IF;
          END IF;

          /* LÊ INFORMAÇÕES DA TABELA DE BANCO DE HORAS. */
          IF   (L_CODBHR <> L_BHRANT) THEN
               BEGIN
                    SELECT DIACRE,SEMCRE,MESCRE,SALCRE,DIADEB,SEMDEB,MESDEB,SALDEB
                      INTO l_diacre,l_semcre,l_mescre,l_salcre,l_diadeb,l_semdeb,l_mesdeb,l_saldeb
                      FROM R011BHR
                     WHERE CODBHR = l_codbhr;
               EXCEPTION
               WHEN OTHERS THEN
                    NULL;
               END;

               /* Inicializa variáveis que controlam limites. */
               l_mesdatini := l_slvmesini;
               l_mesdatfim := l_slvmesfim;
               l_semdatini := l_slvsemini;
               l_semdatfim := l_slvsemfim;
               l_datant := '31/12/1900,00:00:00';
               L_BHRANT := L_CODBHR;
               L_TOTMESCRE := 0;
               L_TOTSEMCRE := 0;
               L_TOTDIACRE := 0;
               L_TOTMESDEB := 0;
               L_TOTSEMDEB := 0;
               L_TOTDIADEB := 0;
          END IF;


          /* Verifica se é uma situação de débito. */
          BEGIN
               SELECT SINSIT
                 INTO l_sinsit
                 FROM R011SIT
                WHERE CODBHR = l_codbhr AND
                      CODSIT = l_codsit;
          EXCEPTION
          WHEN OTHERS THEN
               l_sinsit := '+';
          END;

          /* Ajusta período do mês para consistir os limites . */
          IF   (L_DATLAN > l_mesdatfim) AND ((l_mesdeb > 0) OR (l_mescre > 0)) THEN
               HR_MESLAN(p_numemp,L_DATLAN,l_fecmes,l_codcal OUT,l_mesdatini OUT,l_mesdatfim OUT);
               L_TOTMESCRE := 0;
               L_TOTMESDEB := 0;
          END IF;

          /* Ajusta período da semana para consistir os limites . */
          IF   (L_DATLAN > l_semdatfim) AND ((l_semcre > 0) OR (l_semdeb > 0)) THEN
               LOOP
                    IF   (l_semdatfim >= L_DATLAN) THEN
                         EXIT;
                    END IF;
                    l_semdatini := DATETIMEADD(DD, 7, l_semdatini);
                    l_semdatfim := DATETIMEADD(DD, 7, l_semdatfim);
                    L_TOTSEMCRE := 0;
                    L_TOTSEMDEB := 0;
               END LOOP;
          END IF;

          /* Ajusta período do dia para consistir os limites . */
          IF   (L_DATLAN > l_datant) THEN
               l_datant := L_DATLAN;
               L_TOTDIACRE := 0;
               L_TOTDIADEB := 0;
          END IF;

          /* Inicializa Variáveis que Calculam Horas dos Lançamentos. */
          QTD11LAN := L_QTDHOR;
          QTD11EST := 0;
          
          /* Verifica qual o sinal do lançamento para verificar limites. */
          IF   (l_sinsit = '-') THEN
               /* Calcula Quantidade de horas ainda permitidas para lançamentos do banco. */
               /* Verifica se ultrapassa máximo do mês.                                   */
               IF   (L_DATLAN >= p_datini) THEN
                    IF   (L_DATLAN >= l_mesdatini) AND (L_DATLAN <= l_mesdatfim) AND (l_mesdeb > 0) THEN
                         /* Calcula quantidade que vai para tabela r011lan e quantidade que vai para tabela r011est. */
                         L_ESTBHR := L_TOTMESDEB + QTD11LAN - l_mesdeb;
                         IF   (L_ESTBHR > 0) THEN
                              /* Este IF apenas poderá acontecer se diminuirem o limite e 
                              calcular a apuração em períodos posteriores, quando a rotina 
                              voltar para verificar os limites, o l_totmesdeb pode ficar 
                              maior que o l_mesdeb. */
                              IF   (L_ESTBHR > QTD11LAN) THEN
                                   QTD11EST := QTD11LAN + QTD11EST;
                                   QTD11LAN := 0;
                              ELSE
                                   QTD11LAN := QTD11LAN - L_ESTBHR;
                                   QTD11EST := QTD11EST + L_ESTBHR;
                              END IF;
                         END IF;
                    END IF;

                    /* Verifica se ultrapassa máximo da semana. */
                    IF   (L_DATLAN >= l_semdatini) AND (L_DATLAN <= l_semdatfim) AND (l_semdeb > 0) THEN
                         /* Calcula quantidade que vai para tabela r011lan e quantidade que vai para tabela r011est. */
                         L_ESTBHR := L_TOTSEMDEB + QTD11LAN - l_semdeb;
                         IF   (L_ESTBHR > 0) THEN
                              /* Este IF apenas poderá acontecer se diminuirem o limite e 
                              calcular a apuração em períodos posteriores, quando a rotina 
                              voltar para verificar os limites, o l_totsemdeb pode ficar 
                              maior que o l_semdeb. */
                              IF   (L_ESTBHR > QTD11LAN) THEN
                                   QTD11EST := QTD11LAN + QTD11EST;
                                   QTD11LAN := 0;
                              ELSE
                                   QTD11EST := QTD11EST + L_ESTBHR;
                                   QTD11LAN := QTD11LAN - L_ESTBHR;
                              END IF;
                         END IF;
                    END IF;

                    /* Verifica se ultrapassa máximo do dia. */
                    IF   (l_diadeb > 0)  THEN
                         /* Calcula quantidade que vai para tabela r011lan e quantidade que vai para tabela r011est. */
                         L_ESTBHR := L_TOTDIADEB + QTD11LAN - l_diadeb;
                         IF   (L_ESTBHR > 0) THEN
                              /* Este IF apenas poderá acontecer se diminuirem o limite e 
                              calcular a apuração em períodos posteriores, quando a rotina 
                              voltar para verificar os limites, o l_totdiadeb pode ficar 
                              maior que o l_diadeb. */
                              IF   (L_ESTBHR > QTD11LAN) THEN
                                   QTD11EST := QTD11LAN + QTD11EST;
                                   QTD11LAN := 0;
                              ELSE
                                   QTD11EST := QTD11EST + L_ESTBHR;
                                   QTD11LAN := QTD11LAN - L_ESTBHR;
                              END IF;
                         END IF;
                    END IF;

                    /* Verifica se ultrapassa máximo de saldo.  */
                    
               ELSE
                    /* Verifica se está na tabela r011lan(14) ou r011est(15). */
                    IF   (L_TABLAN = 14) THEN
                         QTD11LAN := L_QTDHOR;
                         QTD11EST := 0;
                    ELSE 
                         QTD11LAN := 0;
                         QTD11EST := L_QTDHOR;
                    END IF;
               END IF;

               /* Atualiza variáveis de total. */
               IF   ((l_datlan >= l_mesdatini) AND (l_datlan <= l_mesdatfim)) THEN
                    L_TOTMESDEB := L_TOTMESDEB + QTD11LAN;
               END IF;
               IF   ((l_datlan >= l_semdatini) AND (l_datlan <= l_semdatfim)) THEN
                    L_TOTSEMDEB := L_TOTSEMDEB + QTD11LAN;
               END IF;
               L_TOTDIADEB := L_TOTDIADEB + QTD11LAN;

               IF   (l_verlim = 'D') THEN
                    L_TOTMESCRE := L_TOTMESCRE - QTD11LAN;
                    L_TOTSEMCRE := L_TOTSEMCRE - QTD11LAN;
                    L_TOTDIACRE := L_TOTDIACRE - QTD11LAN;
               END IF;
               
          ELSE
               /* Calcula Quantidade de horas ainda permitidas para lançamentos do banco. */
               /* Verifica se ultrapassa máximo do mês.                                   */
               IF   (L_DATLAN >= p_datini) THEN
                    IF   (L_DATLAN >= l_mesdatini) AND (L_DATLAN <= l_mesdatfim) AND (l_mescre > 0) THEN
                         /* Calcula quantidade que vai para tabela r011lan e quantidade que vai para tabela r011est. */
                         L_ESTBHR := L_TOTMESCRE + QTD11LAN - l_mescre;
                         IF   (L_ESTBHR > 0) THEN
                              /* Este IF apenas poderá acontecer se diminuirem o limite e 
                              calcular a apuração em períodos posteriores, quando a rotina 
                              voltar para verificar os limites, o l_totmescre pode ficar 
                              maior que o l_mescre. */
                              IF   (L_ESTBHR > QTD11LAN) THEN
                                   QTD11EST := QTD11LAN + QTD11EST;
                                   QTD11LAN := 0;
                              ELSE
                                   QTD11LAN := QTD11LAN - L_ESTBHR;
                                   QTD11EST := QTD11EST + L_ESTBHR;
                              END IF;
                         END IF;
                    END IF;

                    /* Verifica se ultrapassa máximo da semana. */
                    IF   (L_DATLAN >= l_semdatini) AND (L_DATLAN <= l_semdatfim) AND (l_semcre > 0) THEN
                         /* Calcula quantidade que vai para tabela r011lan e quantidade que vai para tabela r011est. */
                         L_ESTBHR := L_TOTSEMCRE + QTD11LAN - l_semcre;
                         IF   (L_ESTBHR > 0) THEN
                              /* Este IF apenas poderá acontecer se diminuirem o limite e 
                              calcular a apuração em períodos posteriores, quando a rotina 
                              voltar para verificar os limites, o l_totsemcre pode ficar 
                              maior que o l_semcre. */
                              IF   (L_ESTBHR > QTD11LAN) THEN
                                   QTD11EST := QTD11LAN + QTD11EST;
                                   QTD11LAN := 0;
                              ELSE
                                   QTD11EST := QTD11EST + L_ESTBHR;
                                   QTD11LAN := QTD11LAN - L_ESTBHR;
                              END IF;
                         END IF;
                    END IF;

                    /* Verifica se ultrapassa máximo do dia. */
                    IF   (l_diacre > 0)  THEN
                         /* Calcula quantidade que vai para tabela r011lan e quantidade que vai para tabela r011est. */
                         L_ESTBHR := L_TOTDIACRE + QTD11LAN - l_diacre;
                         IF   (L_ESTBHR > 0) THEN
                              /* Este IF apenas poderá acontecer se diminuirem o limite e 
                              calcular a apuração em períodos posteriores, quando a rotina 
                              voltar para verificar os limites, o l_totdiacre pode ficar 
                              maior que o l_diacre. */
                              IF   (L_ESTBHR > QTD11LAN) THEN
                                   QTD11EST := QTD11LAN + QTD11EST;
                                   QTD11LAN := 0;
                              ELSE
                                   QTD11EST := QTD11EST + L_ESTBHR;
                                   QTD11LAN := QTD11LAN - L_ESTBHR;
                              END IF;
                         END IF;
                    END IF;

                    /* Verifica se ultrapassa máximo de saldo.  */
                    
               ELSE
                    IF   (L_TABLAN = 14) THEN
                         QTD11LAN := L_QTDHOR;
                         QTD11EST := 0;
                    ELSE 
                         QTD11LAN := 0;
                         QTD11EST := L_QTDHOR;
                    END IF;
               END IF;

               /* Atualiza variáveis de total. */
               IF   ((l_datlan >= l_mesdatini) AND (l_datlan <= l_mesdatfim)) THEN
                    L_TOTMESCRE := L_TOTMESCRE + QTD11LAN;
               END IF;
               IF   ((l_datlan >= l_semdatini) AND (l_datlan <= l_semdatfim)) THEN
                    L_TOTSEMCRE := L_TOTSEMCRE + QTD11LAN;
               END IF;
               L_TOTDIACRE := L_TOTDIACRE + QTD11LAN;

               IF   (l_verlim = 'D') THEN
                    L_TOTMESDEB := L_TOTMESDEB - QTD11LAN;
                    L_TOTSEMDEB := L_TOTSEMDEB - QTD11LAN;
                    L_TOTDIADEB := L_TOTDIADEB - QTD11LAN;
               END IF;
          END IF;

          /* Verifica se lançamento está na tabela correta. */
          /* R011LAN. */
          IF   (L_TABLAN = 14) THEN
               /* Acerta Quantidade de Horas na tabela R011LAN. */
               IF   (QTD11LAN <> L_QTDHOR) THEN
                    IF   (QTD11LAN > 0) THEN
                         IF   (L_QTDPAG > L_QTDHOR) THEN
                              L_QTDPAG := L_QTDHOR;
                         END IF;

                         /* UPDATE na tabela R011LAN. */
                         IF   (l_datlan >= p_datini) THEN
                              BEGIN
                                   UPDATE R011LAN SET QTDHOR = QTD11LAN,
                                                      QTDPAG = L_QTDPAG
                                         WHERE NUMEMP = p_numemp AND
                                               TIPCOL = p_tipcol AND
                                               NUMCAD = p_numcad AND
                                               CODBHR = l_codbhr AND
                                               DATLAN = l_datlan AND
                                               CODSIT = l_codsit AND
                                               ORILAN = l_orilan;
                              EXCEPTION WHEN OTHERS THEN
                                   NULL;
                              END;
                         END IF;
                    ELSE
                         IF   (l_datlan >= p_datini) THEN
                              /* DELETE na tabela R011LAN. */
                              BEGIN
                                   DELETE FROM R011LAN
                                         WHERE NUMEMP = p_numemp AND
                                               TIPCOL = p_tipcol AND
                                               NUMCAD = p_numcad AND
                                               CODBHR = l_codbhr AND
                                               DATLAN = l_datlan AND
                                               CODSIT = l_codsit AND
                                               ORILAN = l_orilan;
                              EXCEPTION WHEN OTHERS THEN
                                   NULL;
                              END;
                         END IF;
                    END IF;
               END IF;
               /* Guarda valores para próximo registro. Se próximo registro = r011est */
               /* e deve voltar para r011lan irá precisar destas informações.         */
               l_codbhrant := l_codbhr;
               l_datlanant := l_datlan;
               l_codsitant := l_codsit;
               l_orilanant := l_orilan;
               l_sinlanant := l_sinlan;
               l_datcmpant := l_datcmp;
          /* R011EST. */
          ELSE
               IF   (QTD11LAN <> 0) THEN
                    IF   (l_codbhrant = l_codbhr) AND
                         (l_datlanant = l_datlan) AND
                         (l_codsitant = l_codsit) AND
                         (l_orilanant = l_orilan) THEN
                         IF   (l_datlan >= p_datini) THEN
                              /* UPDATE na tabela R011LAN. */
                              BEGIN
                                   UPDATE R011LAN SET QTDHOR = QTDHOR + QTD11LAN
                                         WHERE NUMEMP = p_numemp AND
                                               TIPCOL = p_tipcol AND
                                               NUMCAD = p_numcad AND
                                               CODBHR = l_codbhr AND
                                               DATLAN = l_datlan AND
                                               CODSIT = l_codsit AND
                                               ORILAN = l_orilan;
                              EXCEPTION WHEN OTHERS THEN
                                   NULL;
                              END;
                         END IF;
                    ELSE
                         IF   (l_datlan >= p_datini) THEN
                              /* INSERT na tabela R011LAN. */
                              BEGIN
                                   INSERT INTO R011LAN (NUMEMP, TIPCOL, NUMCAD,
                                                       CODBHR, DATLAN, CODSIT,
                                                       ORILAN, SINLAN, QTDHOR, 
                                                       QTDPAG, DATCMP)
                                               VALUES  (p_numemp,p_tipcol,p_numcad,
                                                        l_codbhr,l_datlan,l_codsit,
                                                        l_orilan,l_sinlan,QTD11LAN,
                                                        0,l_datcmp);
                              EXCEPTION WHEN OTHERS THEN
                                   NULL;
                              END;
                         END IF;
                    END IF;
               END IF;

               IF   (QTD11EST <> L_QTDHOR) THEN
                    IF   (QTD11EST <> 0) THEN
                         IF   (l_datlan >= p_datini) THEN
                              /* UPDATE na tabela R011EST. */
                              BEGIN
                                   UPDATE R011EST SET QTDHOR = QTD11EST
                                         WHERE NUMEMP = p_numemp AND
                                               TIPCOL = p_tipcol AND
                                               NUMCAD = p_numcad AND
                                               CODBHR = l_codbhr AND
                                               DATLAN = l_datlan AND
                                               CODSIT = l_codsit;
                              EXCEPTION WHEN OTHERS THEN
                                   NULL;
                              END;
                         END IF;
                    ELSE
                         IF   (l_datlan >= p_datini) THEN
                              /* DELETE na tabela R011EST. */
                              BEGIN
                                   DELETE FROM R011EST
                                         WHERE NUMEMP = p_numemp AND
                                               TIPCOL = p_tipcol AND
                                               NUMCAD = p_numcad AND
                                               CODBHR = l_codbhr AND
                                               DATLAN = l_datlan AND
                                               CODSIT = l_codsit;
                              EXCEPTION WHEN OTHERS THEN
                                   NULL;
                              END;
                         END IF;
                    END IF;
               END IF;
               /* Zera variázeis para não deixar sujeira após LOOP. */
               QTD11EST := 0;
               QTD11LAN := 0;
          END IF;

     END IF;
END LOOP;

/* Insere registro na tabela r011est. */
IF   (QTD11EST > 0) THEN
     IF   (l_datlanant >= p_datini) THEN
          BEGIN
               INSERT INTO R011EST (NUMEMP, TIPCOL, NUMCAD, CODBHR, DATLAN, 
                                    CODSIT, SINLAN, QTDHOR, DATCMP)
                           VALUES  (p_numemp,p_tipcol,p_numcad,l_codbhrant,l_datlanant,
                                    l_codsitant,l_sinlanant,QTD11EST,l_datcmpant);
          EXCEPTION WHEN OTHERS THEN
               NULL;
          END;
     END IF;
END IF;


END␀Ûuÿÿÿÿÿÿÿÿ	SENIOR;0RH_RETHOR
¿␀␀PROCEDURE HR_LERAPU(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATAPU DATE,P_HORDAT OUT NUMBER(4),P_CODUSU OUT NUMBER(10),P_DIAALT OUT NUMBER(2),P_CODESC OUT NUMBER(9),P_CODTMA OUT NUMBER(1),P_TURINT OUT NUMBER(9))
 IS

/* Auxiliares. */
     l_diafer NUMBER(1);
     l_coderr NUMBER(2);

     /* Tabela R066APU. */
     l_hordat   r066apu.hordat%TYPE;
     l_codusu   r066apu.codusu%TYPE;
     l_diaalt   r066apu.diaalt%TYPE;
     l_codesc   r066apu.codesc%TYPE;
     l_codtma   r066apu.codtma%TYPE;
     l_turint   r066apu.turint%TYPE;

     /* TABELA R006HOR. */
     l_horbu1   r006hba.codhop%TYPE;
     l_horbu2   r006hba.codhop%TYPE;
     l_horbu3   r006hba.codhop%TYPE;
     l_horbu4   r006hba.codhop%TYPE;
     l_horbu5   r006hba.codhop%TYPE;
     l_seqhba   r006hba.seqreg%TYPE;

     /* TABELA R064CNV. */
     l_tipcnv   r064cnv.tipcnv%TYPE;

     /* TABELA R006TIH. */
     l_codint   r006tih.codint%TYPE;
BEGIN
/* CURSOR QUE LE INFORMAÇÕES DA APURAÇÃO. */
BEGIN
     SELECT   HORDAT,   CODUSU,   DIAALT,
              CODESC,   CODTMA,   TURINT
       INTO l_hordat, l_codusu, l_diaalt,
            l_codesc, l_codtma, l_turint
       FROM   R066APU
      WHERE NUMEMP = p_numemp AND
            TIPCOL = p_tipcol AND
            NUMCAD = p_numcad AND
            DATAPU = p_datapu;
EXCEPTION
WHEN OTHERS THEN
     l_hordat := 0;
     l_codusu := 0;
     l_diaalt := 0;
     l_codesc := 0;
     l_codtma := 0;
     l_turint := 0;
END;

/* Caso não encontrou registro calcula na hora. */
IF   (l_hordat = 0) THEN
     RH_RETHOR(p_numemp,p_tipcol,p_numcad,p_datapu,1,l_hordat OUT,l_horbu1 OUT,l_horbu2 OUT,l_horbu3 OUT,l_horbu4 OUT,l_horbu5 OUT,l_codesc OUT,l_codtma OUT,l_turint OUT,l_codint OUT,l_diafer OUT,l_tipcnv OUT,l_coderr OUT, l_seqhba OUT);

     /* Verifica se é um feriado. */
     IF   (l_diafer = 1) THEN
          l_hordat := 9997;
     END IF;

     /* Seta campos que são calculados na apuração. */
     l_codusu := 0;
     l_diaalt := 0;
END IF;

/* Atualiza variáveis de parâmetros. */
p_hordat := l_hordat;
p_codusu := l_codusu;
p_diaalt := l_diaalt;
p_codesc := l_codesc;
p_codtma := l_codtma;
p_turint := l_turint;
END␀Üuÿÿÿÿÿÿÿÿ	SENIOR;0HR_ALTMAR
‚␀␀PROCEDURE HR_MARCOL(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATINI DATE,P_DATFIM DATE,P_SOMREF NUMBER(1))
 IS

V_DATZER   R070ACC.DATACC%TYPE;
     V_NUMCRA   R070ACC.NUMCRA%TYPE;
     V_DATACC   R070ACC.DATACC%TYPE;
     V_HORACC   R070ACC.HORACC%TYPE;
     V_SEQACC   R070ACC.SEQACC%TYPE;
     V_USOMAR   R070ACC.USOMAR%TYPE;
     V_TIPACC   R070TAC.TIPACC%TYPE;

     /* CURSOR QUE BUSCA AS MARCAÇÕES. */
     CURSOR LerMar IS
          SELECT R070ACC.NUMCRA,R070ACC.DATACC,R070ACC.HORACC,R070ACC.SEQACC,R070ACC.USOMAR
          FROM   R038HCH,R070ACC,R070TAC
          WHERE  R038HCH.NUMEMP = P_NUMEMP AND
                 R038HCH.TIPCOL = P_TIPCOL AND
                 R038HCH.NUMCAD = P_NUMCAD AND
                 (R070ACC.NUMCRA = R038HCH.NUMCRA) AND
                 (R070ACC.DATACC >= P_DATINI AND
                 R070ACC.DATACC <= P_DATFIM) AND
                 (R070ACC.DATACC > R038HCH.DATINI OR
                 (R070ACC.DATACC = R038HCH.DATINI AND
                 R070ACC.HORACC >= R038HCH.HORINI)) AND
                 (R038HCH.DATFIM = V_DATZER OR
                 R070ACC.DATACC < R038HCH.DATFIM OR
                 (R070ACC.DATACC = R038HCH.DATFIM AND
                 ((R070ACC.HORACC <= R038HCH.HORFIM) OR
                 (R038HCH.HORFIM = 0)))) AND
                 (R070ACC.NUMEMP = 0 OR R070ACC.NUMEMP IS NULL) AND
                 (R070ACC.TIPCOL = 0 OR R070ACC.TIPCOL IS NULL) AND
                 (R070ACC.NUMCAD = 0 OR R070ACC.NUMCAD IS NULL) AND
                 R070ACC.TIPACC = R070TAC.TIPACC AND
                 R070TAC.CONAPU = 'S' AND
                 R070ACC.EXCPON <> 'S' AND
                 R070ACC.USOMAR IN (2,3,4,5,6,7,8,10,11,12,13,14,15,16,18,20,21,22,23);

     /* CURSOR QUE BUSCA AS MARCAÇÕES. */
     CURSOR LerMarTipAcc IS
          SELECT R070ACC.NUMCRA,R070ACC.DATACC,R070ACC.HORACC,R070ACC.SEQACC,R070ACC.USOMAR
          FROM   R038HCH,R070ACC
          WHERE  R038HCH.NUMEMP = P_NUMEMP AND
                 R038HCH.TIPCOL = P_TIPCOL AND
                 R038HCH.NUMCAD = P_NUMCAD AND
                 (R070ACC.NUMCRA = R038HCH.NUMCRA) AND
                 (R070ACC.DATACC >= P_DATINI AND
                 R070ACC.DATACC <= P_DATFIM) AND
                 (R070ACC.DATACC > R038HCH.DATINI OR
                 (R070ACC.DATACC = R038HCH.DATINI AND
                 R070ACC.HORACC >= R038HCH.HORINI)) AND
                 (R038HCH.DATFIM = V_DATZER OR
                 R070ACC.DATACC < R038HCH.DATFIM OR
                 (R070ACC.DATACC = R038HCH.DATFIM AND
                 ((R070ACC.HORACC <= R038HCH.HORFIM) OR
                 (R038HCH.HORFIM = 0)))) AND
                 (R070ACC.NUMEMP = 0 OR R070ACC.NUMEMP IS NULL) AND
                 (R070ACC.TIPCOL = 0 OR R070ACC.TIPCOL IS NULL) AND
                 (R070ACC.NUMCAD = 0 OR R070ACC.NUMCAD IS NULL) AND
                 R070ACC.TIPACC IN (1,2,6,8,9) AND
                 R070ACC.EXCPON <> 'S' AND
                 R070ACC.USOMAR IN (2,3,4,5,6,7,8,10,11,12,13,14,15,16,18,20,21,22,23);
BEGIN
V_DATZER := '31/12/1900,00:00:00';

/* Verifica Se Cadastramento de Tipo Acesso está correto. */
V_TIPACC := 0;
BEGIN
   SELECT IFNULL (MIN(TIPACC),0) TIPACC INTO V_TIPACC FROM R070TAC WHERE CONAPU = 'S';
EXCEPTION
  WHEN NO_DATA_FOUND THEN
   V_TIPACC := 0;
  WHEN OTHERS THEN
   V_TIPACC := 0;
END;

/* Verifica se deve utilizar SELECT que tenha tabela r070tac. */
IF   (V_TIPACC <> 0) THEN

     /* CURSOR que Busca as Marcações de Acesso do Colaborador. */
     FOREACH LerMar INTO V_NUMCRA,V_DATACC,V_HORACC,V_SEQACC,V_USOMAR
     LOOP
          IF   ((P_SOMREF <> 2) OR (V_USOMAR = 3) OR (V_USOMAR = 4)) THEN
               HR_ALTMAR(V_NUMCRA,V_DATACC,V_HORACC,V_SEQACC,P_NUMEMP,P_TIPCOL,P_NUMCAD);
          END IF;
     END LOOP;

ELSE

     /* CURSOR que Busca as Marcações de Acesso do Colaborador. */
     FOREACH LerMarTipAcc INTO V_NUMCRA,V_DATACC,V_HORACC,V_SEQACC,V_USOMAR
     LOOP
          IF   ((P_SOMREF <> 2) OR (V_USOMAR = 3) OR (V_USOMAR = 4)) THEN
               HR_ALTMAR(V_NUMCRA,V_DATACC,V_HORACC,V_SEQACC,P_NUMEMP,P_TIPCOL,P_NUMCAD);
          END IF;
     END LOOP;

END IF;
END␀İuÿÿÿÿÿÿÿÿ	SENIOR;0
Ë␀␀PROCEDURE HR_MESLAN(P_NUMEMP NUMBER(4),P_DATVER DATE,P_FECMES VARCHAR2(1),P_CODCAL OUT NUMBER,P_DATINI OUT DATE,P_DATFIM OUT DATE)
 IS

/* Auxiliares. */
     l_codcal NUMBER;
     l_datini DATE;
     l_datfim DATE;
BEGIN
l_codcal := 0;
l_datini := '31/12/1900,00:00:00';
l_datfim := l_datini;
IF   (p_fecmes = 'F') THEN
     /* Busca Período afetado por lançamento. */
     BEGIN
          SELECT CODCAL,INICMP,FIMCMP
            INTO l_codcal,l_datini,l_datfim
            FROM R044CAL
           WHERE NUMEMP = p_numemp AND
                 TIPCAL = 11 AND
                 INICMP <= p_datver AND
                 FIMCMP >= p_datver;
     EXCEPTION
     WHEN OTHERS THEN
          NULL;
     END;
ELSIF (p_fecmes = 'A') THEN
     /* Busca Período afetado por lançamento. */
     BEGIN
          SELECT CODCAL,INIAPU,FIMAPU
            INTO l_codcal,l_datini,l_datfim
            FROM R044CAL
           WHERE NUMEMP = p_numemp AND
                 TIPCAL = 11 AND
                 INIAPU <= p_datver AND
                 FIMAPU >= p_datver;
     EXCEPTION
     WHEN OTHERS THEN
          NULL;
     END;
END IF;
p_codcal := l_codcal;
p_datini := l_datini;
p_datfim := l_datfim;
END␀Şuÿÿÿÿÿÿÿÿ	SENIOR;0
n␀␀PROCEDURE HR_RETINIAPU(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_INIAPU OUT DATE)
 IS

v_iniapu   r038apu.iniapu%TYPE;
     alfmen         VARCHAR2(255);
     
     BEGIN
     /* Seta Variável que retorna Data Mínima. */
     BEGIN
          SELECT MIN(INIAPU)
            INTO v_iniapu
            FROM R038APU
           WHERE NUMEMP = p_numemp AND
                 TIPCOL = p_tipcol AND
                 NUMCAD = p_numcad;
     EXCEPTION WHEN OTHERS THEN
          alfmen := ' Empresa ' ||CONVERT(NUMBER_TO_CHAR,p_numemp) ||
                    ' Tipo ' ||CONVERT(NUMBER_TO_CHAR,p_tipcol)||
                    ' Colaborador ' ||CONVERT(NUMBER_TO_CHAR,p_numcad)||
                    ' Não Foi Apurado.';
          RAISERROR 103 alfmen;
     END;

     /* Joga valores nas variáveis de retorno. */
     p_iniapu := v_iniapu;
     END␀ßuÿÿÿÿÿÿÿÿ	SENIOR;0
i␀␀PROCEDURE HR_RETULTAPU(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_ULTAPU OUT DATE)
 IS

v_ultapu   r038apu.ultapu%TYPE;
     alfmen         VARCHAR2(255);

     BEGIN
     /* Seta Variável que retorna Data Máxima. */
     BEGIN
          SELECT MAX(ULTAPU)
            INTO v_ultapu
            FROM R038APU
           WHERE NUMEMP = p_numemp AND
                 TIPCOL = p_tipcol AND
                 NUMCAD = p_numcad;
     EXCEPTION WHEN OTHERS THEN
          alfmen := ' Empresa ' ||CONVERT(NUMBER_TO_CHAR,p_numemp) ||
                    ' Tipo ' ||CONVERT(NUMBER_TO_CHAR,p_tipcol)||
                    ' Colaborador ' ||CONVERT(NUMBER_TO_CHAR,p_numcad)||
                    ' Não Foi Apurado.';
          RAISERROR 103 alfmen;
     END;

     /* Joga valores nas variáveis de retorno. */
     p_ultapu := v_ultapu;
     END␀àuÿÿÿÿÿÿÿÿ	SENIOR;0
n␀␀PROCEDURE HR_SEMLAN(P_DATVER DATE,P_FECSEM NUMBER,P_DATINI OUT DATE,P_DATFIM OUT DATE)
 IS

/* Auxiliares. */
     l_datini   DATE;
     l_datfim   DATE;
     v_diasem NUMBER;
     v_auxsem INTEGER;
BEGIN
l_datini := '31/12/1900,00:00:00';
l_datfim := l_datini;

/* Calcula Ínicio e Fim da Semana. */
IF   (p_fecsem <> 0) THEN

     /* Pega dia da semana da data parâmetro. */
     v_diasem := dayofweek(p_datver);

     /* encontra qual a data inicial da semana(depende da data de fechamento). */
     v_auxsem := p_fecsem + 1;
     IF    (v_auxsem = 8) THEN
          v_auxsem := 1;
     END IF;
     
     /* procura diferença entre data da marcação e início semana. */
     v_auxsem := v_diasem - v_auxsem;
     IF    (v_auxsem < 0) THEN
          v_auxsem := v_auxsem + 7;
     END IF;

     /* DESConta a diferença entre início semana e data marcação. */
     v_auxsem := v_auxsem * (-1);
     l_datini := datetimeadd(DD, v_auxsem, p_datver);

     /* Calcula data final da semana. */
     l_datfim := datetimeadd(DD, 6, l_datini);
END IF;

p_datini := l_datini;
p_datfim := l_datfim;
END␀áuÿÿÿÿÿÿÿÿ	SENIOR;0HR_ZERSUB
HR_LERAPU
¿6␀␀PROCEDURE HR_SUBREFCOL(IN_NUMEMP NUMBER(4),IN_TIPCOL NUMBER(1),IN_NUMCAD NUMBER(9),IN_DATINI DATE,IN_DATFIM DATE)
 IS

V_DATAPU                 DATE;
     V_DATACC                 DATE;
     V_HORACC            NUMBER(5);
     V_CODREF            NUMBER(3);
     V_USOREF            NUMBER(1);
     V_QTDACC    R070ACC.QTDACC%TYPE;
     V_VALREF         NUMBER(12,4);
     V_VALCAL         NUMBER(12,4);
     V_HORARIO   R066APU.HORDAT%TYPE;
     V_CODESC              R006ESC.CodEsc%TYPE;
     V_CODTUR            NUMBER(1);
     V_TURINT            NUMBER(9);
     V_VALNOR         NUMBER(12,4);
     V_VALSRE         NUMBER(12,4);
     V_VALSCO         NUMBER(12,4);
     V_VALSUB         NUMBER(12,4);
     V_QTDMAR               NUMBER;
     V_DATANT                 DATE;
     V_REFANT            NUMBER(3);
     V_INTSUB    R068TRF.INTSUB%TYPE;
     V_QTDSUB            NUMBER(1);
     V_NUMCRA         NUMBER(20,4);
     V_SEQACC            NUMBER(2);
     V_CODERRAUX            NUMBER;
     V_DATZER                 DATE;
     ALFMEN          VARCHAR2(255);
     VERCADVAL         VARCHAR2(1);
     V_VALSEG         NUMBER(12,4);
     V_VALTER         NUMBER(12,4);
     V_VALDEM         NUMBER(12,4);
     P_CODERR               NUMBER;
     V_TEMDIF               NUMBER;
     V_ORIACC          VARCHAR2(1);
     V_TIPDIA            NUMBER(1);
     V_CODRFT    R068RFT.CODRFT%TYPE;
     V_CODPLT    R070ACC.CODPLT%TYPE;
     V_CODRLG    R070ACC.CODRLG%TYPE;
     V_MARSUB          VARCHAR2(1);
     V_DATANTSUB              DATE;
     V_HORANTSUB         NUMBER(5);
     V_QTDMIN            NUMBER(5);
     V_CODUSU            NUMBER(10);
     V_DIAALT            NUMBER(2);
     V_HORANT            NUMBER;

     /* CURSOR QUE BUSCA AS MARCAÇÕES PARA ATRIBUIR VALORES. */
     CURSOR C_LERMARREF IS
            SELECT   R070ACC.DATAPU, R070ACC.CODREF, R070ACC.DATACC, R070ACC.HORACC,
                     R070ACC.SEQACC, R070ACC.NUMCRA, R070ACC.USOREF, R070ACC.ORIACC,
                     R070ACC.VALREF, R070ACC.QTDACC, R070ACC.CODPLT, R070ACC.CODRLG
            FROM     R070ACC
            WHERE    R070ACC.NUMEMP =  IN_NUMEMP AND
                     R070ACC.TIPCOL =  IN_TIPCOL AND
                     R070ACC.NUMCAD =  IN_NUMCAD AND
                     R070ACC.DATAPU >= IN_DATINI AND
                     R070ACC.DATAPU <= IN_DATFIM AND
                     R070ACC.CODREF <> 0
            ORDER BY 1,2,3,4,5;
     BEGIN
     V_DATZER := '31/12/1900,00:00:00';
     V_QTDMAR := 0;
     V_CODESC := 0;
     V_CODTUR := 0;
     V_TURINT := 0;
     V_DATANT := V_DATZER;
     V_REFANT := 0;
     V_DATANTSUB := V_DATZER;
     V_HORANTSUB := 0;

     /* Rotina que zera os subsidios. Serão calculados novamente no final da rotina. */
     HR_ZERSUB(in_numemp,in_tipcol,in_numcad,in_datini,in_datfim);

     FOREACH C_LERMARREF INTO V_DATAPU,V_CODREF,V_DATACC,V_HORACC,V_SEQACC,V_NUMCRA,V_USOREF,V_ORIACC,V_VALREF,V_QTDACC,V_CODPLT, V_CODRLG
     LOOP

          V_VALCAL := 0;
          VERCADVAL := 'S';
          V_CODRFT := 0;
          V_MARSUB := 'N';
          BEGIN
               /* SELECT que verifica se refeição pode ser de graça */
               SELECT R068RRF.CODRFT
                 INTO V_CODRFT
                 FROM R068RRF,R068GRA
                WHERE R068RRF.CODPLT = V_CODPLT AND
                      R068RRF.CODRLG = V_CODRLG AND
                      R068RRF.CODRFT = R068GRA.CODRFT AND
                      R068GRA.DATINI <= V_DATAPU AND
                      (R068GRA.DATFIM >= V_DATAPU OR
                      R068GRA.DATFIM = V_DATZER);
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    V_CODRFT := 0;
               WHEN OTHERS THEN
               ALFMEN := ' Erro no SELECT de refeições gratuitas.';
               RAISERROR 103 ALFMEN;
          END;

          /* Se não é uma marcação de reserva busca os valores. */
          IF   (V_USOREF <> 2) THEN
               /* Buscar Horário da Data Para Verificar se Valor Diferenciado se aplica a ele. */
               HR_LERAPU(in_numemp,in_tipcol,in_numcad,v_datapu,v_horario OUT,v_codusu OUT,v_diaalt OUT,v_codesc OUT,v_codtur OUT, v_turint OUT);

               IF   (V_HORARIO < 9996) THEN
                    V_TIPDIA := 1;
               ELSE V_TIPDIA := 2;
               END IF;

               V_TEMDIF := 1;
               V_VALSEG := 0;
               V_VALTER := 0;
               V_VALDEM := 0;
               V_VALNOR := 0;

               /* Procura valores diferenciados para o Colaborador. */
               BEGIN
                    SELECT VALNOR,    VALSEG,  VALTER,  VALDEM,  VALSRE,  VALSCO INTO
                           V_VALNOR,V_VALSEG,V_VALTER,V_VALDEM,V_VALSRE,V_VALSCO FROM R068VDR
                           WHERE NUMEMP = IN_NUMEMP AND
                                 TIPCOL = IN_TIPCOL AND
                                 NUMCAD = IN_NUMCAD AND
                                 (CODREF = V_CODREF) AND
                                 (TIPDIA = V_TIPDIA OR TIPDIA = 3) AND
                                 DATINI <= V_DATAPU AND
                                 (DATFIM >= V_DATAPU OR DATFIM = V_DATZER);
               EXCEPTION
                    WHEN OTHERS THEN
                         V_TEMDIF := 0;
               END;

               IF   (V_TEMDIF = 0) THEN
                    V_TEMDIF := 1;
                    BEGIN
                         SELECT VALNOR,    VALSEG,  VALTER,  VALDEM,  VALSRE,  VALSCO INTO
                                V_VALNOR,V_VALSEG,V_VALTER,V_VALDEM,V_VALSRE,V_VALSCO FROM R068VDR
                                WHERE NUMEMP = IN_NUMEMP AND
                                      TIPCOL = IN_TIPCOL AND
                                      NUMCAD = IN_NUMCAD AND
                                      (CODREF = 0) AND
                                      (TIPDIA = V_TIPDIA OR TIPDIA = 3) AND
                                      DATINI <= V_DATAPU AND
                                      (DATFIM >= V_DATAPU OR DATFIM = V_DATZER);
                    EXCEPTION
                         WHEN OTHERS THEN
                              V_TEMDIF := 0;
                    END;
               END IF;

               IF   (V_TEMDIF = 0) THEN
                    /* Busca da Tabela de Valores. */
                    BEGIN
                         SELECT VALNOR,    VALSRE,  VALSCO,  VALSUB INTO
                                V_VALNOR,V_VALSRE,V_VALSCO,V_VALSUB FROM R068VRF
                                WHERE NUMEMP = IN_NUMEMP AND
                                      CODREF = V_CODREF AND
                                      DATALT = (SELECT MAX(DATALT) FROM R068VRF
                                               WHERE NUMEMP = IN_NUMEMP AND
                                                     CODREF = V_CODREF AND
                                                     DATALT <= V_DATACC);
                    EXCEPTION
                         WHEN NO_DATA_FOUND THEN
                              VERCADVAL := 'N';
                         WHEN OTHERS THEN
                              NULL;
                    END;
               END IF;
          END IF;

          /* Caso não tenha valores cadastrados zera o valref. */
          IF   (VERCADVAL = 'N') THEN
               IF   (V_VALREF <> 0) THEN
                    BEGIN
                         UPDATE R070ACC SET VALREF = 0
                                WHERE NUMCRA = V_NUMCRA AND
                                      DATACC = V_DATACC AND
                                      HORACC = V_HORACC AND
                                      SEQACC = V_SEQACC;
                    EXCEPTION  WHEN OTHERS THEN
                         ALFMEN := ' Erro de Sobreposição na Base. Crachá : '
                                   ||CONVERT(NUMBER_TO_CHAR,v_numcra)
                                   ||'. Data:'||CONVERT(DATE_TO_CHAR,v_datacc)
                                   ||'. Hora:'||CONVERT(NUMBER_TO_CHAR,v_horacc)
                                   ||'. Sequência: '||CONVERT(NUMBER_TO_CHAR,v_seqacc);
                         RAISERROR 103 ALFMEN;
                    END;
               END IF;
          /* Marcações de consumo. */
          ELSIF (V_USOREF = 1) THEN
               /* Número da refeição na data. */
               IF   ((V_DATANT <> V_DATAPU) OR (V_REFANT <> V_CODREF)) THEN
                    V_QTDMAR := 0;
                    V_DATANTSUB := V_DATZER;
                    V_HORANTSUB := 0;
               END IF;
               V_QTDMAR := V_QTDMAR + 1;
               V_DATANT := V_DATAPU;
               V_REFANT := V_CODREF;

               /* Verifica se tem refeitório gratuito. */
               IF   (V_CODRFT <> 0) THEN
                    V_VALCAL := 0;
               /* Verifica se Não tem Valores Diferenciados. */
               ELSIF (V_TEMDIF = 0) THEN
                    /* Verifica se tem subsídio. */
                    BEGIN
                         SELECT IFNULL (R068TRF.INTSUB,0),IFNULL (R068TRF.NUMSUB,0)
                           INTO V_INTSUB,V_QTDSUB FROM R068TRF
                          WHERE NUMEMP = IN_NUMEMP AND
                                CODREF = V_CODREF;
                    EXCEPTION WHEN OTHERS THEN
                         V_QTDSUB := 0;
                         V_INTSUB := 0;
                    END;

                    IF   (V_QTDSUB = 0) THEN
                         BEGIN
                              SELECT IFNULL (R068DRF.NUMSUB,0) INTO V_QTDSUB FROM R068DRF
                                     WHERE NUMEMP = IN_NUMEMP;
                         EXCEPTION WHEN OTHERS THEN
                              V_QTDSUB := 0;
                         END;
                    END IF;

                    /* Verifica se refeição tem subsídio.   */
                    IF   (V_QTDSUB >  0) THEN
                         /* Verifica se tem intervalo no subsídio. */
                         IF   (V_INTSUB > 0) THEN
                              /* Calcula quantidade de minutos entre as marcações subsidiadas. */
                              IF   (V_DATANTSUB = V_DATZER) THEN
                                   V_QTDMIN := 1440;
                              ELSE
                                   V_QTDMIN := DATETIMEDIF(DD, V_DATACC, V_DATANTSUB);
                                   V_QTDMIN := (V_QTDMIN * 1440) + V_HORACC - V_HORANTSUB;
                              END IF;
                         ELSE
                              V_QTDMIN := 0;
                         END IF;

                         IF   (V_QTDMIN > V_INTSUB) THEN
                              V_DATANTSUB := V_DATACC;
                              V_HORANTSUB := V_HORACC;
                              V_VALCAL := V_VALSUB;
                              V_MARSUB := 'S';
                              V_QTDMAR := 1;
                         ELSIF (V_QTDMAR <= V_QTDSUB) THEN
                              V_VALCAL := V_VALSUB;
                              V_MARSUB := 'S';
                         ELSE
                              V_VALCAL := V_VALNOR;
                         END IF;
                    ELSE
                         V_VALCAL := V_VALNOR;
                    END IF;
               ELSIF (V_QTDMAR = 1) THEN
                    V_VALCAL := V_VALNOR;
               ELSIF (V_QTDMAR = 2) THEN
                    V_VALCAL := V_VALSEG;
               ELSIF (V_QTDMAR = 3) THEN
                    V_VALCAL := V_VALTER;
               ELSIF (V_QTDMAR > 3) THEN
                    V_VALCAL := V_VALDEM;
               END IF;
          /* Marcações de Reserva. */
          ELSIF (V_USOREF = 2) THEN
               V_VALCAL := 0;
               V_QTDMAR := 0;
               V_DATANT := V_DATZER;
               V_REFANT := 0;
          /* Marcações de Consumo sem Reserva. */
          ELSIF (V_USOREF = 3) THEN
               IF   (V_CODRFT <> 0) THEN
                    V_VALCAL := 0;
               ELSE V_VALCAL := V_VALSRE;
               END IF;
               V_QTDMAR := 0;
               V_DATANT := V_DATZER;
               V_REFANT := 0;
          /* Marcações de Reserva sem Consumo. */
          ELSIF (V_USOREF = 4) THEN
               IF   (V_CODRFT <> 0) THEN
                    V_VALCAL := 0;
               ELSE V_VALCAL := V_VALSCO;
               END IF;
               V_QTDMAR := 0;
               V_DATANT := V_DATZER;
               V_REFANT := 0;
          END IF;

     IF   (V_QTDACC = 0) THEN
          V_QTDACC := 1;
     END IF;

     V_VALCAL := V_VALCAL * V_QTDACC;
     IF   ((V_VALCAL <> V_VALREF) OR (V_MARSUB = 'S')) THEN
          /* Verifica se deve alterar uso. */
          IF   (V_MARSUB = 'S') THEN
               V_USOREF := 5;
          END IF;
          
          /* Verifica se deve alterar valor. */
          IF   ((V_VALREF = 0) OR (V_ORIACC <> 'D')) THEN
               V_VALREF := V_VALCAL;
          END IF;
               
          BEGIN
               UPDATE R070ACC SET VALREF = V_VALREF,USOREF = V_USOREF
                      WHERE NUMCRA = V_NUMCRA AND
                            DATACC = V_DATACC AND
                            HORACC = V_HORACC AND
                            SEQACC = V_SEQACC;
          EXCEPTION WHEN OTHERS THEN
               ALFMEN := ' Erro de Sobreposição na Base. Crachá : '
                         ||CONVERT(NUMBER_TO_CHAR,v_numcra)
                         ||'. Data:'||CONVERT(DATE_TO_CHAR,v_datacc)
                         ||'. Hora:'||CONVERT(NUMBER_TO_CHAR,v_horacc)
                         ||'. Sequência: '||CONVERT(NUMBER_TO_CHAR,v_seqacc);
               RAISERROR 103 ALFMEN;
          END;
     END IF;
     END LOOP;
END␀âuÿÿÿÿÿÿÿÿ	SENIOR;0

␀␀PROCEDURE HR_ULTMAR(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATINI DATE,P_DATACC OUT DATE,P_HORACC OUT NUMBER,P_CODPLT OUT NUMBER,P_CODRLG OUT NUMBER,P_CODFNC OUT NUMBER,P_USOMAR OUT NUMBER)
 IS

V_DATZER   R070ACC.DATACC%TYPE;
     V_DATACC   R070ACC.DATACC%TYPE;
     V_HORACC   R070ACC.HORACC%TYPE;
     V_SEQACC   R070ACC.SEQACC%TYPE;
     V_CODPLT   R070ACC.CODPLT%TYPE;
     V_CODRLG   R070ACC.CODRLG%TYPE;
     V_CODFNC   R070ACC.CODFNC%TYPE;
     V_USOMAR   R070ACC.USOMAR%TYPE;

     /* CURSOR QUE BUSCA AS MARCAÇÕES. */
     CURSOR C_ULTMARCOL IS
          SELECT DATACC,HORACC,CODPLT,CODRLG,CODFNC,USOMAR,SEQACC
          FROM R070ACC
          WHERE  R070ACC.NUMEMP = P_NUMEMP AND
                 R070ACC.TIPCOL = P_TIPCOL AND
                 R070ACC.NUMCAD = P_NUMCAD AND
                 R070ACC.DATAPU < P_DATINI AND
                 R070ACC.DATAPU <> V_DATZER AND
                 USOMAR IN (2,3,4,5,6,7,8,10,11,12,13,14,15,16,18,20,21,22,23)
                 ORDER BY DATACC DESC,HORACC DESC,SEQACC DESC;
BEGIN
V_DATZER := '31/12/1900,00:00:00';
V_DATACC := '31/12/1900,00:00:00';
V_HORACC := 0;
V_CODPLT := 0;
V_CODRLG := 0;
V_CODFNC := 0;
V_USOMAR := 0;

/* CURSOR que Busca a última marcação do colaborador. */
FOREACH C_ULTMARCOL INTO V_DATACC,V_HORACC,V_CODPLT,V_CODRLG,V_CODFNC,V_USOMAR,V_SEQACC
LOOP
     EXIT;
END LOOP;

P_DATACC := V_DATACC;
P_HORACC := V_HORACC;
P_CODPLT := V_CODPLT;
P_CODRLG := V_CODRLG;
P_CODFNC := V_CODFNC;
P_USOMAR := V_USOMAR;
END␀ãuÿÿÿÿÿÿÿÿ	SENIOR;0@HR_RETINIAPU
HR_RETULTAPU
SP_RETAFA
HR_LERAPU
HR_SUBREFCOL
vW␀␀PROCEDURE HR_VALREFCOL(IN_NUMEMP NUMBER(4),IN_TIPCOL NUMBER(1),IN_NUMCAD NUMBER(9),IN_DATINI DATE,IN_DATFIM DATE)
 IS

V_DATAPU                 DATE;
     V_NUMCRA         NUMBER(20,4);
     V_DATACC                 DATE;
     V_HORACC            NUMBER(5);
     V_SEQACC            NUMBER(2);
     V_CODREF            NUMBER(3);
     V_USOREF            NUMBER(1);
     V_ORIACC          VARCHAR2(1);
     V_VALRES          VARCHAR2(1);
     V_USOCAL            NUMBER(1);
     V_DATPRO                 DATE;
     V_HORARIO   R066APU.HORDAT%TYPE;
     V_CODESC              R006ESC.CodEsc%TYPE;
     V_CODTUR            NUMBER(1);
     V_TURINT            NUMBER(9);
     V_INIAPU                 DATE;
     V_ULTAPU                 DATE;
     V_NUMCRAAUX      NUMBER(20,4);
     V_DATACCAUX              DATE;
     V_HORACCAUX         NUMBER(5);
     V_SEQACCAUX         NUMBER(2);
     V_VALREFAUX      NUMBER(12,3);
     V_CODERRAUX            NUMBER;
     V_USOREFAUX         NUMBER(1);
     V_ORIACCAUX       VARCHAR2(1);
     V_DATZER                 DATE;
     ALFMEN          VARCHAR2(255);
     V_AFASTO               NUMBER;
     V_INIRES            NUMBER(5);
     V_INICON            NUMBER(5);
     V_RESREF          VARCHAR2(1);
     P_CODERR               NUMBER(2);
     V_CODUSU               NUMBER(10);
     V_DIAALT               NUMBER(2);
     V_CODPLT            NUMBER(5);
     V_RLGRES            NUMBER(3);
     V_FNCRES            NUMBER(3);


     /* CURSOR QUE BUSCA AS MARCAÇÕES DE CANCELAMENTO DE RESERVA. */
     CURSOR C_LERMARCAN IS
            SELECT   R070ACC.DATAPU, R070ACC.CODREF, R070ACC.HORACC, R070ACC.NUMCRA,
                     R070ACC.DATACC, R070ACC.SEQACC, R070ACC.USOREF, IFNULL(R070ACC.ORIACC,'E')
            FROM     R070ACC
            WHERE    R070ACC.NUMEMP =  IN_NUMEMP AND
                     R070ACC.TIPCOL =  IN_TIPCOL AND
                     R070ACC.NUMCAD =  IN_NUMCAD AND
                     R070ACC.DATAPU >= IN_DATINI AND
                     R070ACC.DATAPU <= IN_DATFIM AND
                     R070ACC.CODREF <> 0 AND
                     R070ACC.USOREF = 6
            ORDER BY 1,5,2,3,6;


     /* CURSOR QUE BUSCA AS MARCAÇÕES DE CONSUMO QUE PRECISAM VERIFICAR RESERVA. */
     CURSOR C_LERMARCON IS
            SELECT   R070ACC.DATAPU, R070ACC.CODREF, R070ACC.HORACC, R070ACC.NUMCRA,
                     R070ACC.DATACC, R070ACC.SEQACC, R070ACC.USOREF, IFNULL(R070ACC.ORIACC,'E')
            FROM     R070ACC
            WHERE    R070ACC.NUMEMP =  IN_NUMEMP AND
                     R070ACC.TIPCOL =  IN_TIPCOL AND
                     R070ACC.NUMCAD =  IN_NUMCAD AND
                     R070ACC.DATAPU >= IN_DATINI AND
                     R070ACC.DATAPU <= IN_DATFIM AND
                     R070ACC.CODREF <> 0 AND
                     R070ACC.USOREF = 3
            ORDER BY 1,5,2,3,6;


     /* CURSOR QUE BUSCA AS MARCAÇÕES DE RESERVA QUE PRECISAM VERIFICAR CONSUMO. */
     CURSOR C_LERMARRES IS
            SELECT   R070ACC.DATAPU, R070ACC.CODREF, R070ACC.HORACC, R070ACC.DATACC,
                     R070ACC.SEQACC, R070ACC.NUMCRA, R070ACC.USOREF, IFNULL(R070ACC.ORIACC,'E')
            FROM     R070ACC
            WHERE    R070ACC.NUMEMP =  IN_NUMEMP AND
                     R070ACC.TIPCOL =  IN_TIPCOL AND
                     R070ACC.NUMCAD =  IN_NUMCAD AND
                     R070ACC.DATAPU >= IN_DATINI AND
                     R070ACC.DATAPU <= IN_DATFIM AND
                     R070ACC.CODREF <> 0 AND
                     R070ACC.USOREF = 4
            ORDER BY 1,4,2,3,5;


     /* CURSOR QUE BUSCA AS MARCAÇÕES DE RESERVA. */
     CURSOR C_MARRES IS
     SELECT R070ACC.DATACC,R070ACC.HORACC,R070ACC.SEQACC,R070ACC.NUMCRA,IFNULL (R070ACC.VALREF,0),R070ACC.USOREF,IFNULL (R070ACC.ORIACC,'E') 
            FROM R070ACC
            WHERE NUMEMP = IN_NUMEMP AND
                  TIPCOL = IN_TIPCOL AND
                  NUMCAD = IN_NUMCAD AND
                  DATAPU = V_DATPRO AND
                  CODREF = V_CODREF AND
                  USOMAR IN (3,4) AND
                  USOREF = 4
            ORDER BY 1,2,3;

     /* CURSOR QUE BUSCA AS MARCAÇÕES DE CONSUMO. */
     CURSOR C_MARCON IS
     SELECT R070ACC.DATACC,R070ACC.HORACC,R070ACC.SEQACC,R070ACC.NUMCRA,IFNULL (R070ACC.VALREF,0),R070ACC.USOREF,IFNULL (R070ACC.ORIACC, 'E')
            FROM R070ACC
            WHERE NUMEMP = IN_NUMEMP AND
                  TIPCOL = IN_TIPCOL AND
                  NUMCAD = IN_NUMCAD AND
                  DATAPU = V_DATPRO AND
                  CODREF = V_CODREF AND
                  USOMAR IN (3,4) AND
                  USOREF = 3
            ORDER BY 1,2,3;


     /* CURSOR QUE BUSCA AS RESERVAS DE REFEIÇÃO. */
     CURSOR C_LERESREF IS
     SELECT R068RSR.CODPLT,R068RSR.RLGRES,R068RSR.FNCRES,R068RSR.INIRES
            FROM R068RSR
            WHERE NUMEMP = IN_NUMEMP  AND
                  CODREF = V_CODREF
            ORDER BY 1, 2, 3, 4;

     BEGIN
     V_DATZER := '31/12/1900,00:00:00';
     V_CODESC := 0;
     V_CODTUR := 0;
     V_TURINT := 0;

     /* Busca a primeira e última data apurada do colaborador.         */
     /* ISto é utilizado na procura de marcações de reserva e consumo. */
     HR_RETINIAPU(in_numemp,in_tipcol,in_numcad,v_iniapu OUT);
     HR_RETULTAPU(in_numemp,in_tipcol,in_numcad,v_ultapu OUT);

     /* CURSOR que Busca as Marcações de Refeitório no Período com Cancelamento de Reserva. */
     FOREACH C_LERMARCAN INTO V_DATAPU,V_CODREF,V_HORACC,V_NUMCRA,V_DATACC,V_SEQACC,V_USOREF,V_ORIACC
     LOOP
         V_DATPRO := V_DATAPU;
         V_NUMCRAAUX := 0;
         V_DATACCAUX := V_DATZER;
         V_HORACCAUX := 0;
         V_SEQACCAUX := 0;
         
         /* Procura Marcação de Reserva. */
         FOREACH C_MARRES INTO V_DATACCAUX,V_HORACCAUX,V_SEQACCAUX,V_NUMCRAAUX,V_VALREFAUX,V_USOREFAUX,V_ORIACCAUX
         LOOP
             EXIT;
         END LOOP;
         
         /* Caso encontrou altera uso da reserva. */
         IF  (V_NUMCRAAUX <> 0) THEN
             BEGIN
                 UPDATE R070ACC SET USOREF = 7,VALREF = 0
                     WHERE NUMCRA = V_NUMCRAAUX AND
                           DATACC = V_DATACCAUX AND
                           HORACC = V_HORACCAUX AND
                           SEQACC = V_SEQACCAUX;
             EXCEPTION WHEN OTHERS THEN
                 ALFMEN := ' Erro de Sobreposição na Base. Crachá : '
                           ||CONVERT(NUMBER_TO_CHAR,v_numcraaux)
                           ||'. Data:'||CONVERT(DATE_TO_CHAR,v_dataccaux)
                           ||'. Hora:'||CONVERT(NUMBER_TO_CHAR,v_horaccaux)
                           ||'. Sequência: '||CONVERT(NUMBER_TO_CHAR,v_seqaccaux);
                 RAISERROR 103 ALFMEN;
             END;
             
             BEGIN
                 UPDATE R070ACC SET USOREF = 8,VALREF = 0
                     WHERE NUMCRA = V_NUMCRA AND
                           DATACC = V_DATACC AND
                           HORACC = V_HORACC AND
                           SEQACC = V_SEQACC;
             EXCEPTION WHEN OTHERS THEN
                 ALFMEN := ' Erro de Sobreposição na Base. Crachá : '
                           ||CONVERT(NUMBER_TO_CHAR,v_numcra)
                           ||'. Data:'||CONVERT(DATE_TO_CHAR,v_datacc)
                           ||'. Hora:'||CONVERT(NUMBER_TO_CHAR,v_horacc)
                           ||'. Sequência: '||CONVERT(NUMBER_TO_CHAR,v_seqacc);
                 RAISERROR 103 ALFMEN;
             END;
         END IF;
     END LOOP;

     /* CURSOR que Busca as Marcações de Refeitório no Período. */
     FOREACH C_LERMARCON INTO V_DATAPU,V_CODREF,V_HORACC,V_NUMCRA,V_DATACC,V_SEQACC,V_USOREF,V_ORIACC
     LOOP
          v_usocal := 0;

          /* Verifica se está afastado. */
          v_afasto := 0;
          SP_RETAFA(in_numemp,in_tipcol,in_numcad,v_datapu,v_horacc,v_afasto OUT);
          IF   (v_afasto <> 0) THEN
               v_usocal := 3;
          END IF;

          IF   (V_USOCAL = 0) THEN
               /* Verifica se é um dia de folga. */
               HR_LERAPU(in_numemp,in_tipcol,in_numcad,v_datapu,v_horario OUT,v_codusu OUT,v_diaalt OUT,v_codesc OUT,v_codtur OUT, v_turint OUT);

               IF   (V_HORARIO > 9995) THEN
                    v_usocal := 3;
               END IF;
          END IF;

	     /* Verifica se foi um dia de folga ou afastamento. */
          IF   (V_USOCAL = 3) THEN
               /* Verifica se Refeição Tem Reserva. */
               BEGIN
                    SELECT IFNULL (VALRES,'N'),RESREF INTO V_VALRES,V_RESREF FROM R068TRF
                           WHERE NUMEMP = IN_NUMEMP AND
                                 CODREF = V_CODREF;
               EXCEPTION WHEN OTHERS THEN
                    ALFMEN := ' Refeição ' ||CONVERT(NUMBER_TO_CHAR,V_CODREF)||
                              ' Da Empresa ' ||CONVERT(NUMBER_TO_CHAR,IN_NUMEMP)||
                              ' Não Cadastrada.';
                    RAISERROR 103 ALFMEN;
               END;

               /* Verifica se reserva é pela data atual. */
               IF   ((V_RESREF = 'S') AND (V_VALRES = 'J'))THEN
                    V_DATPRO := V_DATAPU;
                    V_CODREF := V_CODREF;

                    /* Busca Marcação de Reserva. */
                    V_NUMCRAAUX := 0;
                    V_DATACCAUX := V_DATZER;
                    V_HORACCAUX := 0;
                    V_SEQACCAUX := 0;
                    V_VALREFAUX := 0;
                    V_USOREFAUX := 0;
                    /* Procura Marcação de Reserva. */
                    FOREACH C_MARRES INTO V_DATACCAUX,V_HORACCAUX,V_SEQACCAUX,V_NUMCRAAUX,V_VALREFAUX,V_USOREFAUX,V_ORIACCAUX
                    LOOP
                         EXIT;
                    END LOOP;

                    IF   (V_NUMCRAAUX <> 0) THEN
                         /* Caso encontrou considera consumo com reserva. */
                         v_usocal := 1;
                         /* Caso encontrou altera uso da reserva. */
                         IF   (V_VALREFAUX <> 0) OR (V_USOREFAUX = 4) THEN
                              IF   (V_ORIACCAUX <> 'D') THEN
                                   BEGIN
                                        UPDATE R070ACC SET USOREF = 2,VALREF = 0,QTDACC = 0
                                               WHERE NUMCRA = V_NUMCRAAUX AND
                                                     DATACC = V_DATACCAUX AND
                                                     HORACC = V_HORACCAUX AND
                                                     SEQACC = V_SEQACCAUX;
                                   EXCEPTION WHEN OTHERS THEN
                                        ALFMEN := ' Erro de Sobreposição na Base. Crachá : '
                                                  ||CONVERT(NUMBER_TO_CHAR,v_numcraaux)
                                                  ||'. Data:'||CONVERT(DATE_TO_CHAR,v_dataccaux)
                                                  ||'. Hora:'||CONVERT(NUMBER_TO_CHAR,v_horaccaux)
                                                  ||'. Sequência: '||CONVERT(NUMBER_TO_CHAR,v_seqaccaux);
                                        RAISERROR 103 ALFMEN;
                                   END;
                              ELSE
                                   BEGIN
                                        UPDATE R070ACC SET USOREF = 2, QTDACC = 0
                                               WHERE NUMCRA = V_NUMCRAAUX AND
                                                     DATACC = V_DATACCAUX AND
                                                     HORACC = V_HORACCAUX AND
                                                     SEQACC = V_SEQACCAUX;
                                   EXCEPTION WHEN OTHERS THEN
                                        ALFMEN := ' Erro de Sobreposição na Base. Crachá : '
                                                  ||CONVERT(NUMBER_TO_CHAR,v_numcraaux)
                                                  ||'. Data:'||CONVERT(DATE_TO_CHAR,v_dataccaux)
                                                  ||'. Hora:'||CONVERT(NUMBER_TO_CHAR,v_horaccaux)
                                                  ||'. Sequência: '||CONVERT(NUMBER_TO_CHAR,v_seqaccaux);
                                        RAISERROR 103 ALFMEN;
                                   END;
                              END IF;
                         END IF;
                    END IF;
               END IF;
	     END IF;

          IF   (V_USOCAL = 0) THEN
               /* Verifica se Refeição Tem Reserva. */
               BEGIN
                    SELECT IFNULL (VALRES,'N'),RESREF INTO V_VALRES,V_RESREF FROM R068TRF
                           WHERE NUMEMP = IN_NUMEMP AND
                                 CODREF = V_CODREF;
               EXCEPTION WHEN OTHERS THEN
                    ALFMEN := ' Refeição ' ||CONVERT(NUMBER_TO_CHAR,V_CODREF)||
                              ' Da Empresa ' ||CONVERT(NUMBER_TO_CHAR,IN_NUMEMP)||
                              ' Não Cadastrada.';
                    RAISERROR 103 ALFMEN;
               END;

               IF  (V_RESREF = 'N') THEN
                    v_usocal := 1;
               END IF;
          END IF;

          IF   (V_USOCAL = 0) THEN
               V_DATPRO := V_DATAPU;
               /* Verifica se Reserva é em Próxima Jornada. */
               IF   ((V_RESREF = 'S') AND (V_VALRES = 'P'))THEN
                    /* Procura Data com Horário de Trabalho. */
                    V_HORARIO := 0;
                    V_INIRES := 0;
                    LOOP
                         V_DATPRO := DATETIMEADD(DD, -1, V_DATPRO);
                         IF   (V_DATPRO < V_INIAPU) THEN
                              EXIT;
                         END IF;

                         /* Verifica se é um dia de folga. */
                         HR_LERAPU(in_numemp,in_tipcol,in_numcad,v_datpro,v_horario OUT,v_codusu OUT,v_diaalt OUT,v_codesc OUT,v_codtur OUT, v_turint OUT);

                         IF   (V_HORARIO < 9995) THEN
                              /* Busca Horário da Reserva para Verificar Afastamento. */
                              IF (V_INIRES = 0) THEN
                                BEGIN
                                  V_CODPLT := 0;
                                  V_RLGRES := 0;
                                  V_FNCRES := 0;
                                  FOREACH C_LERESREF INTO V_CODPLT,V_RLGRES,V_FNCRES,V_INIRES
                                  LOOP
                                     EXIT;
                                  END LOOP;
                                END;
                              END IF;

                              V_AFASTO := 0;
                              SP_RETAFA(in_numemp,in_tipcol,in_numcad,v_datpro,v_inires,v_afasto OUT);
                              IF   (v_afasto = 0) THEN
                                   EXIT;
                              END IF;
                         END IF;
                    END LOOP;
               END IF;

               /* Busca Marcação de Reserva. */
               V_NUMCRAAUX := 0;
               V_DATACCAUX := V_DATZER;
               V_HORACCAUX := 0;
               V_SEQACCAUX := 0;
               V_VALREFAUX := 0;
               V_USOREFAUX := 0;
               FOREACH C_MARRES INTO V_DATACCAUX,V_HORACCAUX,V_SEQACCAUX,V_NUMCRAAUX,V_VALREFAUX,V_USOREFAUX,V_ORIACCAUX
               LOOP
                    EXIT;
               END LOOP;

               /* Verifica se existe reserva. */
               v_usocal := 3;
               IF   (V_NUMCRAAUX <> 0) THEN
                    v_usocal := 1;
                    IF   (V_VALREFAUX <> 0) OR (V_USOREFAUX = 4) THEN
					  BEGIN
						   UPDATE R070ACC SET USOREF = 2,VALREF = 0,QTDACC = 0
								  WHERE NUMCRA = V_NUMCRAAUX AND
										DATACC = V_DATACCAUX AND
										HORACC = V_HORACCAUX AND
										SEQACC = V_SEQACCAUX;
					  EXCEPTION WHEN OTHERS THEN
						   ALFMEN := ' Erro de Sobreposição na Base. Crachá : '
									 ||CONVERT(NUMBER_TO_CHAR,v_numcraaux)
									 ||'. Data:'||CONVERT(DATE_TO_CHAR,v_dataccaux)
									 ||'. Hora:'||CONVERT(NUMBER_TO_CHAR,v_horaccaux)
									 ||'. Sequência: '||CONVERT(NUMBER_TO_CHAR,v_seqaccaux);
						   RAISERROR 103 ALFMEN;
					  END;
                    END IF;
               END IF;
          END IF;

          /* Sobrepõe o Uso da Marcação. */
          IF   (v_usocal <> v_usoref) THEN
		BEGIN
			 UPDATE R070ACC SET USOREF = V_USOCAL, VALREF = 0
					WHERE NUMCRA = V_NUMCRA AND
						  DATACC = V_DATACC AND
						  HORACC = V_HORACC AND
						  SEQACC = V_SEQACC;
		EXCEPTION WHEN OTHERS THEN
			 ALFMEN := ' Erro de Sobreposição na Base. Crachá : '
					   ||CONVERT(NUMBER_TO_CHAR,v_numcra)
					   ||'. Data:'||CONVERT(DATE_TO_CHAR,v_datacc)
					   ||'. Hora:'||CONVERT(NUMBER_TO_CHAR,v_horacc)
					   ||'. Sequência: '||CONVERT(NUMBER_TO_CHAR,v_seqacc);
			 RAISERROR 103 ALFMEN;
		END;	
          END IF;
     END LOOP;


     /* CURSOR que Busca as Marcações de Refeitório no Período. */
     FOREACH C_LERMARRES INTO V_DATAPU,V_CODREF,V_HORACC,V_DATACC,V_SEQACC,V_NUMCRA,V_USOREF,V_ORIACC
     LOOP
          v_usocal := 0;

          /* Verifica se está afastado. */
          v_afasto := 0;
          SP_RETAFA(in_numemp,in_tipcol,in_numcad,v_datapu,v_horacc,v_afasto OUT);
          IF   (v_afasto <> 0) THEN
               v_usocal := 4;
          END IF;

          IF   (V_USOCAL = 0) THEN
               /* Verifica se é um dia de folga. */
               HR_LERAPU(in_numemp,in_tipcol,in_numcad,v_datapu,v_horario OUT,v_codusu OUT,v_diaalt OUT,v_codesc OUT,v_codtur OUT, v_turint OUT);
               
               IF   (V_HORARIO > 9995) THEN
                    v_usocal := 4;
               END IF;
          END IF;

          IF   (V_USOCAL = 0) THEN
               /* Verifica se Refeição Tem Reserva. */
               BEGIN
                    SELECT IFNULL (VALRES,'N'),RESREF,INICON INTO V_VALRES,V_RESREF,V_INICON FROM R068TRF
                           WHERE NUMEMP = IN_NUMEMP AND
                                 CODREF = V_CODREF;
               EXCEPTION WHEN OTHERS THEN
                    ALFMEN := ' Refeição ' ||CONVERT(NUMBER_TO_CHAR,V_CODREF)||
                              ' Da Empresa ' ||CONVERT(NUMBER_TO_CHAR,IN_NUMEMP)||
                              ' Não Cadastrada.';
                    RAISERROR 103 ALFMEN;
               END;

               IF  (V_RESREF = 'N') THEN
                    v_usocal := 2;
               END IF;
          END IF;

          IF   (V_USOCAL = 0) THEN
               V_DATPRO := V_DATAPU;
               /* Verifica se Reserva é em Próxima Jornada. */
               IF   ((V_RESREF = 'S') AND (V_VALRES = 'P'))THEN
                    /* Procura Data com Horário de Trabalho. */
                    V_HORARIO := 0;
                    V_INIRES := 0;
                    LOOP
                         V_DATPRO := DATETIMEADD(DD, +1, V_DATPRO);
                         IF   (V_DATPRO > V_ULTAPU) THEN
                              EXIT;
                         END IF;

                         /* Verifica se é um dia de folga. */
                         HR_LERAPU(in_numemp,in_tipcol,in_numcad,v_datpro,v_horario OUT,v_codusu OUT,v_diaalt OUT,v_codesc OUT,v_codtur OUT, v_turint OUT);

                         IF   (V_HORARIO < 9995) THEN
                              V_AFASTO := 0;
                              SP_RETAFA(in_numemp,in_tipcol,in_numcad,v_datpro,v_inicon,v_afasto OUT);
                              IF   (v_afasto = 0) THEN
                                   EXIT;
                              END IF;
                         END IF;
                    END LOOP;
               END IF;

               /* Busca Marcação de Consumo. */
               V_NUMCRAAUX := 0;
               V_DATACCAUX := V_DATZER;
               V_HORACCAUX := 0;
               V_SEQACCAUX := 0;
               V_VALREFAUX := 0;
               FOREACH C_MARCON INTO V_DATACCAUX,V_HORACCAUX,V_SEQACCAUX,V_NUMCRAAUX,V_VALREFAUX,V_USOREFAUX,V_ORIACCAUX
               LOOP
                    EXIT;
               END LOOP;

               /* Verifica se existe consumo. */
               v_usocal := 4;
               IF   (V_NUMCRAAUX <> 0) THEN
                    v_usocal := 2;
                    IF   (V_VALREFAUX <> 0) OR (V_USOREFAUX = 3) THEN
					  BEGIN
						   UPDATE R070ACC SET USOREF = 1,VALREF = 0
								  WHERE NUMCRA = V_NUMCRAAUX AND
										DATACC = V_DATACCAUX AND
										HORACC = V_HORACCAUX AND
										SEQACC = V_SEQACCAUX;
					  EXCEPTION WHEN OTHERS THEN
						   ALFMEN := ' Erro de Sobreposição na Base. Crachá : '
									 ||CONVERT(NUMBER_TO_CHAR,v_numcraaux)
									 ||'. Data:'||CONVERT(DATE_TO_CHAR,v_dataccaux)
									 ||'. Hora:'||CONVERT(NUMBER_TO_CHAR,v_horaccaux)
									 ||'. Sequência: '||CONVERT(NUMBER_TO_CHAR,v_seqaccaux);
						   RAISERROR 103 ALFMEN;
					  END;
                    END IF;
               END IF;
          END IF;

          /* Sobrepõe o Uso da Marcação. */
          IF   (v_usocal <> v_usoref) THEN
				BEGIN
					 UPDATE R070ACC SET USOREF = V_USOCAL,VALREF = 0,QTDACC = 0
							WHERE NUMCRA = V_NUMCRA AND
								  DATACC = V_DATACC AND
								  HORACC = V_HORACC AND
								  SEQACC = V_SEQACC;
				EXCEPTION WHEN OTHERS THEN
					 ALFMEN := ' Erro de Sobreposição na Base. Crachá : '
							   ||CONVERT(NUMBER_TO_CHAR,v_numcra)
							   ||'. Data:'||CONVERT(DATE_TO_CHAR,v_datacc)
							   ||'. Hora:'||CONVERT(NUMBER_TO_CHAR,v_horacc)
							   ||'. Sequência: '||CONVERT(NUMBER_TO_CHAR,v_seqacc);
					 RAISERROR 103 ALFMEN;
				END;
          END IF;
     END LOOP;

     /* Rotina que calcula os subsidios e atribui valores as marcações. */
     HR_SUBREFCOL(in_numemp,in_tipcol,in_numcad,in_datini,in_datfim);
END␀äuÿÿÿÿÿÿÿÿ	SENIOR;0
N
␀␀PROCEDURE HR_ZERCMPBHR(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATINI DATE,P_CODBHR NUMBER(5))
 IS

/* Tabela R011ASS. */
     l_codbhr   r011ass.codbhr%TYPE;
     l_datcre   r011ass.datcre%TYPE;
     l_sitcre   r011ass.sitcre%TYPE;
     l_oricre   r011ass.oricre%TYPE;
     l_datdeb   r011ass.datdeb%TYPE;
     l_sitdeb   r011ass.sitdeb%TYPE;
     l_orideb   r011ass.orideb%TYPE;
     l_qtdass   r011ass.qtdass%TYPE;

     /* CURSOR QUE BUSCA AS COMPENSAÇÕES JÁ REALIZADAS. */
     CURSOR C_CMPBHR IS
          SELECT CODBHR,DATCRE,SITCRE,ORICRE,DATDEB,SITDEB,ORIDEB,QTDASS
            FROM R011ASS
           WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                 (DATCRE >= p_datini OR DATDEB >= p_datini) AND
                 ((0 = p_codbhr) OR (CODBHR = p_codbhr));  
BEGIN
/* CURSOR que Busca as Marcações de Refeitório no Período. */
FOREACH C_CMPBHR INTO L_CODBHR,L_DATCRE,L_SITCRE,L_ORICRE,L_DATDEB,L_SITDEB,L_ORIDEB,L_QTDASS
LOOP
     /* UPDATE no Crédito. */
     BEGIN
          UPDATE R011LAN SET QTDPAG = QTDPAG - L_QTDASS, HORCMP = HORCMP + L_QTDASS

                WHERE NUMEMP = p_numemp AND
                      TIPCOL = p_tipcol AND
                      NUMCAD = p_numcad AND
                      CODBHR = l_codbhr AND
                      DATLAN = l_datcre AND
                      CODSIT = l_sitcre AND
                      ORILAN = l_oricre;
     EXCEPTION WHEN OTHERS THEN
          NULL;
     END;

     /* UPDATE no Débito. */
     BEGIN
          UPDATE R011LAN SET QTDPAG = QTDPAG - L_QTDASS, HORCMP = HORCMP + L_QTDASS

                WHERE NUMEMP = p_numemp AND
                      TIPCOL = p_tipcol AND
                      NUMCAD = p_numcad AND
                      CODBHR = l_codbhr AND
                      DATLAN = l_datdeb AND
                      CODSIT = l_sitdeb AND
                      ORILAN = l_orideb;
     EXCEPTION WHEN OTHERS THEN
          NULL;
     END;

     /* Deleta Registro Da Tabela R011ASS. */
     BEGIN
          DELETE FROM R011ASS
                WHERE NUMEMP = p_numemp AND
                      TIPCOL = p_tipcol AND
                      NUMCAD = p_numcad AND
                      CODBHR = l_codbhr AND
                      DATCRE = l_datcre AND
                      ORICRE = l_oricre AND
                      SITCRE = l_sitcre AND
                      DATDEB = l_datdeb AND
                      SITDEB = l_sitdeb AND
                      ORIDEB = l_orideb;
     EXCEPTION WHEN OTHERS THEN
          NULL;
     END;
END LOOP;
END␀åuÿÿÿÿÿÿÿÿ	SENIOR;0
=␀␀PROCEDURE HR_ZERSUB(IN_NUMEMP NUMBER(4),IN_TIPCOL NUMBER(1),IN_NUMCAD NUMBER(9),IN_DATINI DATE,IN_DATFIM DATE)
 IS
BEGIN

/* UPDATE para calcular novamente subsidios. */
BEGIN
     UPDATE R070ACC SET USOREF = 1
           WHERE    R070ACC.NUMEMP =  IN_NUMEMP AND
                    R070ACC.TIPCOL =  IN_TIPCOL AND
                    R070ACC.NUMCAD =  IN_NUMCAD AND
                    R070ACC.DATAPU >= IN_DATINI AND
                    R070ACC.DATAPU <= IN_DATFIM AND
                    R070ACC.USOREF = 5;
EXCEPTION WHEN OTHERS THEN
     NULL;
END;
END␀K–␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
#␀␀PROCEDURE JR_LAYOUT_PROCTRAB(P_LAYOUT VARCHAR(6), P_RETORNO OUT BOOLEAN)
IS

  l_Layout VARCHAR(6);
BEGIN
  P_RETORNO := FALSE;
  l_Layout := UPPER(P_LAYOUT);
  
  IF (l_Layout = 'S-2500') OR
     (l_Layout = 'S-2501') OR
     (l_Layout = 'S-3500') THEN
    P_RETORNO := TRUE;
  END IF; 
END␀Ë›␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
œ␀␀/* A janela de execução é grava na tabela R960WIN em intervalos de meia em meia hora.
   Ou seja, o valor 0 representa 00:00 às 00:29, o valor 1 representa das 0:30 às 0:59 e assim por diante, de domingo a sábado */
PROCEDURE MCCheckExecWindow(ATIPSER VARCHAR2(255),ACANEXEC OUT VARCHAR(1),AEXECDATETIME OUT DATE)
 IS

xBaseDate DATE;  
  xTimeNow DATE;
  xCanExec INTEGER;
  xHour INTEGER;
  xHourAux INTEGER;
  xNextHour INTEGER;
  xDayOfWeek INTEGER;
  xDif INTEGER;
  CURSOR xCURSORForw IS SELECT HORBLO FROM R960WIN WHERE TIPSER = aTipSer AND HORBLO > xHour ORDER BY HORBLO;
  CURSOR xCURSORBack IS SELECT HORBLO FROM R960WIN WHERE TIPSER = aTipSer AND HORBLO < xHour ORDER BY HORBLO;
BEGIN
  /* Soma quantas "meia hora" tem na data atual*/
  xBaseDate := CURDATE();
  xTimeNow := CURTIME();
  xDayOfWeek := DAYOFWEEK(xBaseDate);
  /* inicializa o DATETime de retorno com um valor default. BDE não aceita DATETime com valor NULL. */
  aExecDateTime := DATETIME(31,12,1900,0,0,0);
  IF (xDayOfWeek = 1) THEN
    xHour := 0;
  ELSE
    xHour := ((xDayOfWeek-1) * 48)-1;
    /* ajusta a data base para domingo, para calcular a data da proxima execucao*/
    xDif := (-1)*(xDayOfWeek-1);
    xBaseDate := DATETIMEADD(DD, xDif, xBaseDate);
  END IF;  
  xHour := xHour + HOUR(xTimeNow) * 2;    
  IF (MINUTE(xTimeNow) <= 29) THEN
    xHour := xHour + 1;
  ELSE
    xHour := xHour + 2;
  END IF; 
  aCanExec := 'T';    
  xCanExec := 1;
  BEGIN
    SELECT 0 INTO xCanExec FROM R960WIN WHERE TIPSER = aTipSer AND HORBLO = xHour;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
  IF (xCanExec = 0) THEN
    aCanExec := 'F';

    /* está bloqueado neste horário, verifica se pode reagendar e procura o próximo horário disponível */
    
    SELECT 1 INTO xCanExec FROM R900GPR WHERE PRMID = 44 AND PRMVAL <> '0';
    IF (xCanExec = 1) THEN /* testa se pode reagendar para o proximo horário disponível */

      xHourAux := xHour;
      FOREACH xCURSORForw INTO xNextHour
      LOOP
        IF xNextHour = xHourAux + 1 THEN
          xHourAux := xHourAux + 1;
        ELSE 
          EXIT;
        END IF; 
      END LOOP;
      xNextHour := xHourAux + 1;
    
      /* se chegou a 336 foi pra frente até o final da semana e não achou nada, procura do 0 até a hora corrente*/
      IF (xNextHour = 336) THEN
        xHourAux := 0;
        FOREACH xCURSORBack INTO xNextHour
        LOOP
          IF (xNextHour = xHourAux) THEN
           xHourAux := xHourAux + 1;
          ELSE
            EXIT;
          END IF;  
        END LOOP;
        /* se chegou até o final e não encontrou, está tudo bloqueado, retorna 0 */
        IF (xHourAux = xHour) THEN
          aExecDateTime := DATETIME(31,12,1900,0,0,0);
        ELSE
          xDif := (336 + xHourAux)*30;
          aExecDateTime := DATETIMEADD(MI, xDif, xBaseDate);
        END IF; 
      ELSE
        xDif := xNextHour*30;
        aExecDateTime := DATETIMEADD(MI, xDif, xBaseDate);
      END IF;
    END IF;
  END IF;
END␀¦␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
¸PROCEDURE N_GR_PEN_BENEF(P_LAYOUT VARCHAR2(6), P_GERAR OUT BOOLEAN)
IS
BEGIN
    P_GERAR := TRUE;
    IF (p_layout = 'S-2400') THEN
        P_GERAR := FALSE;
    END IF;    
END␀%¹␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_RETHOR
Ç␀␀PROCEDURE PP_HorFun(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATINI DATE,P_DATFIM DATE,P_QTDHOR OUT NUMBER)
 IS

/* Definicao de Variaveis Locais */
  l_dataux DATE;
  l_codhor   R066APU.HORDAT%TYPE;
  l_horbu1 NUMBER(4);
  l_horbu2 NUMBER(4);
  l_horbu3 NUMBER(4);
  l_horbu4 NUMBER(4);
  l_horbu5 NUMBER(4);
  l_codesc   R006ESC.CodEsc%TYPE;
  l_codtur NUMBER(1);
  l_turint NUMBER(9);
  l_codint NUMBER(9);
  l_coderr NUMBER(2);
  l_qtdhor NUMBER;
  l_tipcnv NUMBER(1);

  l_diafer NUMBER(1);

  l_hora1 NUMBER;
  l_hora2 NUMBER;
  l_hora3 NUMBER;
  l_hora4 NUMBER;
  l_hora5 NUMBER;
  l_hora6 NUMBER;
  l_hora7 NUMBER;
  l_hora8 NUMBER;
  l_hddprd NUMBER;
  
  l_seqhba   r006hba.seqreg%TYPE;

  /* CURSOR para Retornar as Batidas do Horario */
  CURSOR c_R004MHR IS SELECT HORBAT,SEQMAR FROM R004MHR WHERE CODHOR = l_codhor ORDER BY SEQMAR;
  TYPE t_R004MHR IS RECORD(HORBAT   R004MHR.HORBAT%TYPE,
                           SEQMAR   R004MHR.SEQMAR%TYPE);

  l_R004MHR t_R004MHR;

BEGIN
  l_hddprd:=0;
  l_qtdhor := 0;
  l_hora1 := 0; l_hora2 := 0; l_hora3 := 0; l_hora4 := 0; l_hora5 := 0; l_hora6 := 0; l_hora7 := 0; l_hora8 := 0;

  /* Looping das Datas */
  l_dataux := p_datini;
  LOOP
    IF l_dataux > p_datfim THEN
      EXIT;
    END IF;

    /* Retornar o Codigo do Horario */
    RH_RetHor(p_numemp,p_tipcol,p_numcad,l_dataux, 1,
              l_codhor OUT, l_horbu1 OUT, l_horbu2 OUT, l_horbu3 OUT,
              l_horbu4 OUT, l_horbu5 OUT, l_codesc OUT, l_codtur OUT,
              l_turint OUT, l_codint OUT, l_diafer OUT, l_tipcnv OUT,
              l_coderr OUT, l_seqhba OUT);

    IF  (l_diafer = 1) THEN
        l_codhor := 9997;
    END IF;

    /* Retorna as Horas Deduzir Produção */
    BEGIN
    	 SELECT HDDPRD INTO l_hddprd FROM R004HOR WHERE CODHOR = l_codhor;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_hddprd:=0;
      WHEN OTHERS THEN
        RAISERROR 103 'ERRO NO SELECT EM R004HOR';
    END;

    /* Ler Registro do CURSOR das Batidas */
    FOREACH c_R004MHR INTO l_R004MHR.HorBat,l_R004MHR.SeqMar
    LOOP

      /* Acumular os Horarios das Batidas */
      IF l_hora1 = 0 THEN l_hora1 := l_R004MHR.HORBAT;
      ELSIF l_hora2 = 0 THEN l_hora2 := l_R004MHR.HORBAT;
      ELSIF l_hora3 = 0 THEN l_hora3 := l_R004MHR.HORBAT;
      ELSIF l_hora4 = 0 THEN l_hora4 := l_R004MHR.HORBAT;
      ELSIF l_hora5 = 0 THEN l_hora5 := l_R004MHR.HORBAT;
      ELSIF l_hora6 = 0 THEN l_hora6 := l_R004MHR.HORBAT;
      ELSIF l_hora7 = 0 THEN l_hora7 := l_R004MHR.HORBAT;
      ELSIF l_hora8 = 0 THEN l_hora8 := l_R004MHR.HORBAT;
      END IF;
    END LOOP;

    /* Prever Quebra de Dia */
    IF l_hora2 < l_hora1 THEN l_hora2 := l_hora2 + 1440; END IF;
    IF l_hora3 < l_hora2 THEN l_hora3 := l_hora3 + 1440; END IF;
    IF l_hora4 < l_hora3 THEN l_hora4 := l_hora4 + 1440; END IF;
    IF l_hora5 < l_hora4 THEN l_hora5 := l_hora5 + 1440; END IF;
    IF l_hora6 < l_hora5 THEN l_hora6 := l_hora6 + 1440; END IF;
    IF l_hora7 < l_hora6 THEN l_hora7 := l_hora7 + 1440; END IF;
    IF l_hora8 < l_hora7 THEN l_hora8 := l_hora8 + 1440; END IF;

    l_qtdhor := l_qtdhor + ((l_hora8 - l_hora7) + (l_hora6 - l_hora5) + (l_hora4 - l_hora3) + (l_hora2 - l_hora1));
    IF   l_hddprd > l_qtdhor THEN
         l_qtdhor := 0;
    ELSE
         l_qtdhor := l_qtdhor - l_hddprd;
    END IF;
    l_dataux := DATETimeAdd(DD,1,l_dataux);
  END LOOP;

  p_qtdhor := l_qtdhor;
END␀&¹␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_RETHOR
ï␀␀PROCEDURE PP_HorLoc(P_NUMEMP NUMBER(4),P_CODLOC VARCHAR2(255),P_DATINI DATE,P_DATFIM DATE,P_QTDHOR OUT NUMBER)
 IS

/* Definicao de Variaveis Locais */
  l_codloc   R016HIE.CODLOC%TYPE;
  l_dataux DATE;
  l_codhor   R066APU.HORDAT%TYPE;
  l_horbu1 NUMBER(4);
  l_horbu2 NUMBER(4);
  l_horbu3 NUMBER(4);
  l_horbu4 NUMBER(4);
  l_horbu5 NUMBER(4);
  l_codesc   R006ESC.CodEsc%TYPE;
  l_codtur NUMBER(1);
  l_turint NUMBER(9);
  l_codint NUMBER(9);
  l_coderr NUMBER(2);
  l_qtdhor NUMBER;
  l_tipcnv NUMBER(1);
  l_diafer NUMBER(1);

  l_hora1 NUMBER;
  l_hora2 NUMBER;
  l_hora3 NUMBER;
  l_hora4 NUMBER;
  l_hora5 NUMBER;
  l_hora6 NUMBER;
  l_hora7 NUMBER;
  l_hora8 NUMBER;
  l_hddprd NUMBER;
  
  l_seqhba   r006hba.seqreg%TYPE;

  /* CURSOR para Procurar os Empregados Deste Local */
  CURSOR c_R034FUN IS SELECT R034FUN.NUMEMP,R034FUN.TIPCOL,R034FUN.NUMCAD FROM R034FUN,R010SIT,R038HPP,R038HLO,R016HIE
   WHERE R034FUN.SITAFA = R010SIT.CODSIT AND ((R010SIT.TIPSIT <> 7) OR (R010SIT.TIPSIT = 7 AND R034FUN.DATAFA >= p_datfim))
   /* Histórico de Local */
   AND (R038HLO.NUMEMP = R034FUN.NUMEMP
   AND R038HLO.TIPCOL = R034FUN.TIPCOL
   AND R038HLO.NUMCAD = R034FUN.NUMCAD
   AND R016HIE.TABORG = R038HLO.TABORG
   AND R016HIE.NUMLOC = R038HLO.NUMLOC
   AND R016HIE.CODLOC LIKE l_codloc
   AND R016HIE.DATINI <= p_datini
   AND R016HIE.DATFIM >= p_datini
   AND R038HLO.DATALT =
       (SELECT MAX(DATALT) FROM R038HLO
        WHERE R038HLO.NUMEMP = R034FUN.NUMEMP
        AND R038HLO.TIPCOL = R034FUN.TIPCOL
        AND R038HLO.NUMCAD = R034FUN.NUMCAD
        AND R038HLO.DATALT <= p_datini))
   /* Colaboradores que não estão afastados desta data */
   AND NOT EXISTS
      (SELECT NUMEMP FROM R038AFA
       WHERE R038AFA.NUMEMP = R034FUN.NUMEMP
       AND R038AFA.TIPCOL = R034FUN.TIPCOL
       AND R038AFA.NUMCAD = R034FUN.NUMCAD
       AND (R038AFA.DATTER >= p_datini OR  R038AFA.DATTER = DATETIME(31,12,1900,0,0,0))
       AND R038AFA.DATAFA =
          (SELECT MAX(DATAFA) FROM R038AFA
           WHERE R038AFA.NUMEMP = R034FUN.NUMEMP
           AND R038AFA.TIPCOL = R034FUN.TIPCOL
           AND R038AFA.NUMCAD = R034FUN.NUMCAD
           AND R038AFA.DATAFA <= p_datini))
   /* Histórico de Assinalamento de PPR */
   AND (R038HPP.NUMEMP = R034FUN.NUMEMP
   AND R038HPP.TIPCOL = R034FUN.TIPCOL
   AND R038HPP.NUMCAD = R034FUN.NUMCAD
   AND (R038HPP.ASSPPR = 1 OR R038HPP.ASSPPR = 3)
   AND R038HPP.DATALT =
       (SELECT MAX(DATALT) FROM R038HPP
        WHERE R038HPP.NUMEMP = R034FUN.NUMEMP
        AND R038HPP.TIPCOL = R034FUN.TIPCOL
        AND R038HPP.NUMCAD = R034FUN.NUMCAD
        AND R038HPP.DATALT <= p_datini));
  TYPE t_R034FUN IS RECORD(NUMEMP   R034FUN.NUMEMP%TYPE,
                           TIPCOL   R034FUN.TIPCOL%TYPE,
                           NUMCAD   R034FUN.NUMCAD%TYPE);
  l_R034FUN t_R034FUN;

  /* CURSOR para Retornar as Batidas do Horario */
  CURSOR c_R004MHR IS SELECT HORBAT,SEQMAR FROM R004MHR WHERE CODHOR = l_codhor ORDER BY SEQMAR;
  TYPE t_R004MHR IS RECORD(HORBAT   R004MHR.HORBAT%TYPE,
                           SEQMAR   R004MHR.SEQMAR%TYPE);
  l_R004MHR t_R004MHR;

BEGIN
  /* Apenas para Depurar */
  /* raise_application_error(-20103,' NUMEMP ' || p_numemp ||
                                    ' CODLOC ' || p_codloc ||
                                    ' DATINI ' || p_datini ||
                                    ' DATFIM ' || p_datfim); */

  l_codloc := p_codloc || '%';
  l_hddprd := 0;
  l_qtdhor := 0;


  /* Ler Registro do CURSOR dos Empregados */
  FOREACH c_R034FUN INTO l_R034FUN.NUMEMP,l_R034FUN.TIPCOL,l_R034FUN.NUMCAD
  LOOP
    /* Looping das Datas */
    l_dataux := p_datini;
    LOOP
      IF l_dataux > p_datfim THEN
        EXIT;
      END IF;
      l_hora1 := 0; l_hora2 := 0; l_hora3 := 0; l_hora4 := 0; l_hora5 := 0; l_hora6 := 0; l_hora7 := 0; l_hora8 := 0;

      /* Retornar o Codigo do Horario */
      RH_RetHor(l_R034FUN.NumEmp,l_R034FUN.TipCol,l_R034FUN.NumCad,l_dataux, 1,
               l_codhor OUT, l_horbu1 OUT, l_horbu2 OUT, l_horbu3 OUT,
               l_horbu4 OUT, l_horbu5 OUT, l_codesc OUT, l_codtur OUT,
               l_turint OUT, l_codint OUT, l_diafer OUT, l_tipcnv OUT,
               l_coderr OUT, l_seqhba OUT);

      IF   (l_diafer = 1) THEN
          l_codhor := 9997;
      END IF;

      /* Retorna as Horas Deduzir Produção */
      BEGIN
           SELECT HDDPRD INTO l_hddprd FROM R004HOR WHERE CODHOR = l_codhor;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_hddprd:=0;
        WHEN OTHERS THEN
          RAISERROR 103 'ERRO NO SELECT EM R004HOR';
      END;

      /* Apenas para Depurar */
      /* raise_application_error(-20103,' NUMEMP ' || l_R034FUN.NumEmp ||
                                        ' TIPCOL ' || l_R034FUN.TipCol ||
                                        ' NUMCAD ' || l_R034FUN.NumCad ||
                                        ' DATAUX ' || l_dataux ||
                                        ' CODHOR ' || l_codhor ||
                                        ' CODERR ' || l_coderr); */


      /* Ler Registro do CURSOR das Batidas */
      FOREACH c_R004MHR INTO l_R004MHR.HorBat,l_R004MHR.SeqMar
      LOOP
        /* Acumular os Horarios das Batidas */
        IF l_hora1 = 0 THEN l_hora1 := l_R004MHR.HORBAT;
        ELSIF l_hora2 = 0 THEN l_hora2 := l_R004MHR.HORBAT;
        ELSIF l_hora3 = 0 THEN l_hora3 := l_R004MHR.HORBAT;
        ELSIF l_hora4 = 0 THEN l_hora4 := l_R004MHR.HORBAT;
        ELSIF l_hora5 = 0 THEN l_hora5 := l_R004MHR.HORBAT;
        ELSIF l_hora6 = 0 THEN l_hora6 := l_R004MHR.HORBAT;
        ELSIF l_hora7 = 0 THEN l_hora7 := l_R004MHR.HORBAT;
        ELSIF l_hora8 = 0 THEN l_hora8 := l_R004MHR.HORBAT;
        END IF;
      END LOOP;

      /* Prever Quebra de Dia */
      IF l_hora2 < l_hora1 THEN l_hora2 := l_hora2 + 1440; END IF;
      IF l_hora3 < l_hora2 THEN l_hora3 := l_hora3 + 1440; END IF;
      IF l_hora4 < l_hora3 THEN l_hora4 := l_hora4 + 1440; END IF;
      IF l_hora5 < l_hora4 THEN l_hora5 := l_hora5 + 1440; END IF;
      IF l_hora6 < l_hora5 THEN l_hora6 := l_hora6 + 1440; END IF;
      IF l_hora7 < l_hora6 THEN l_hora7 := l_hora7 + 1440; END IF;
      IF l_hora8 < l_hora7 THEN l_hora8 := l_hora8 + 1440; END IF;

      /* Apenas para Depurar */
      /* raise_application_error(-20103,' HORA1 ' || l_hora1 ||
                                        ' HORA2 ' || l_hora2 ||
                                        ' HORA3 ' || l_hora3 ||
                                        ' HORA4 ' || l_hora4 ||
                                        ' HORA5 ' || l_hora5 ||
                                        ' HORA6 ' || l_hora6 ||
                                        ' HORA7 ' || l_hora7 ||
                                        ' HORA8 ' || l_hora8); */

      l_qtdhor := l_qtdhor + ((l_hora8 - l_hora7) + (l_hora6 - l_hora5) + (l_hora4 - l_hora3) + (l_hora2 - l_hora1));
      IF   l_hddprd > l_qtdhor THEN
           l_qtdhor := 0;
      ELSE
           l_qtdhor := l_qtdhor - l_hddprd;
      END IF;
      l_dataux := DATETimeAdd(DD,1,l_dataux);
    END LOOP;
  END LOOP;
  p_qtdhor := l_qtdhor;

  /* Apenas para Depurar */
  /* raise_application_error(-20103,' L_QTDHOR ' || l_qtdhor); */
END␀ÕÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Œ␀␀/* R126SVA, R126RQU, R038HPO, R038AFA, R038HFI */
PROCEDURE QL_AJUQTDEFE(L_ATABOPE VARCHAR2(7),L_AESTPOS NUMBER(3),L_ACODPLV NUMBER(4),L_APOSTRA VARCHAR2(25),L_AINIAJU DATE,L_ATERAJU DATE,L_AQTDAJU NUMBER(6))
 IS

l_xSQTDVAG NUMBER(6);
  l_xSQTDAFA NUMBER(6);
  l_xSQTDRQU NUMBER(6);
  l_xSQTDSOL NUMBER(6);
BEGIN
  l_xSQTDVAG := 0;
  l_xSQTDAFA := 0;
  l_xSQTDRQU := 0;
  l_xSQTDSOL := 0;

  IF (l_aTabOpe = 'R126SVA') THEN /* Solicitação de abertura de vagas */
    l_xSQTDSOL := l_aQtdAju;
    BEGIN
    UPDATE R092EFE SET QTDSOL = (QTDSOL+l_xSQTDSOL)
     WHERE ESTPOS = l_aEstPos
       AND CODPLV = l_aCodPlv
       AND POSTRA = l_aPosTra
       AND DATEFE > l_aIniAju
       AND DATEFE <= l_aTerAju
       AND QTDSOL+l_xSQTDSOL >= 0;
  	EXCEPTION
     WHEN OTHERS THEN
       RAISERROR 103 'Erro ao ajustar quadro do efetivo(R126SVA).';
  END;
  ELSE
    IF (l_aTabOpe = 'R038AFA') THEN /* Afastamentos */
      l_xSQTDAFA := l_aQtdAju;
      BEGIN
      UPDATE R092EFE SET QTDAFA = (QTDAFA+l_xSQTDAFA)
       WHERE ESTPOS = l_aEstPos
         AND CODPLV = l_aCodPlv
         AND POSTRA = l_aPosTra
         AND DATEFE > l_aIniAju
         AND DATEFE <= l_aTerAju
         AND QTDAFA+l_xSQTDAFA >= 0;
  	   EXCEPTION
        WHEN OTHERS THEN
         RAISERROR 103 'Erro ao ajustar quadro do efetivo(R038AFA).';
    END;
    ELSE
      IF (l_aTabOpe = 'R126RQU') THEN /* Requisições */
        l_xSQTDRQU := l_aQtdAju;
        BEGIN
	    UPDATE R092EFE SET QTDRQU = (QTDRQU+l_xSQTDRQU)
	     WHERE ESTPOS = l_aEstPos
	       AND CODPLV = l_aCodPlv
	       AND POSTRA = l_aPosTra
	       AND DATEFE > l_aIniAju
	       AND DATEFE <= l_aTerAju
	       AND QTDRQU+l_xSQTDRQU >= 0;
	  	EXCEPTION
	     WHEN OTHERS THEN
	       RAISERROR 103 'Erro ao ajustar quadro do efetivo(R126RQU).';
	  END;
      ELSE
        IF (l_aTabOpe = 'R038HPO') THEN /* Histórico de postos */
          l_xSQTDVAG := l_aQtdAju;
          BEGIN
		  UPDATE R092EFE SET QTDVAG = (QTDVAG+l_xSQTDVAG)
		   WHERE ESTPOS = l_aEstPos
		      AND CODPLV = l_aCodPlv
		      AND POSTRA = l_aPosTra
		      AND DATEFE > l_aIniAju
		      AND DATEFE <= l_aTerAju
		      AND QTDVAG+l_xSQTDVAG >= 0;
		  EXCEPTION
		   WHEN OTHERS THEN
		      RAISERROR 103 'Erro ao ajustar quadro do efetivo(R038HPO).';
		END;
        ELSE
          IF (l_aTabOpe = 'R038HFI') THEN /* Histórico de filial */
            l_xSQTDVAG := l_aQtdAju;
            BEGIN
		    UPDATE R092EFE SET QTDVAG = (QTDVAG+l_xSQTDVAG)
		     WHERE ESTPOS = l_aEstPos
		       AND CODPLV = l_aCodPlv
		       AND POSTRA = l_aPosTra
		       AND DATEFE > l_aIniAju
		       AND DATEFE <= l_aTerAju
		       AND QTDVAG+l_xSQTDVAG >= 0;
		  	EXCEPTION
		     WHEN OTHERS THEN
		       RAISERROR 103 'Erro ao ajustar quadro do efetivo(R038HFI).';
		    END;
          END IF;
        END IF;
      END IF;
    END IF;
  END IF;
END␀ÖÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;00GETQTDADMITIDOSRQU
QL_ATUEFEPOS
QL_AJUQTDEFE
ş	␀␀PROCEDURE QL_AJUSTARSALDORQU(P_OLDSIT NUMBER(1),P_NEWSIT NUMBER(1),P_NUMEMP NUMBER(4),P_ESTPOS NUMBER(3),P_CODPLV NUMBER(4),P_POSTRA VARCHAR2(25),P_CODRQU NUMBER(9),P_DATINI DATE,P_DATFIM DATE,P_QTDRQU NUMBER(4))
 IS

l_SalRqu NUMBER(6);
  	l_QtdRqu NUMBER(6);
	l_QtdAdm NUMBER(6);
	l_Nao_Iniciada NUMBER(1);
	l_Em_Andamento NUMBER(1);
	l_Cancelada NUMBER(1);
	l_Finalizada NUMBER(1);
	l_Proposta NUMBER(1);
	l_Suspensa NUMBER(1);
BEGIN
	l_Nao_Iniciada := 0;
	l_Em_Andamento := 1;
	l_Cancelada := 2;
	l_Finalizada := 3;
	l_Proposta := 4;
	l_Suspensa := 5;

    GETQTDADMITIDOSRQU(p_CodRqu, p_DatIni, l_QtdAdm OUT);
    l_SalRqu := (p_QtdRqu - l_QtdAdm);
						
	IF (((p_OldSit = l_Nao_Iniciada) OR (p_OldSit = l_Em_Andamento)) AND ((p_NewSit = l_Cancelada) OR (p_NewSit = l_Proposta) OR (p_NewSit = l_Suspensa) OR (p_NewSit = l_Finalizada))) THEN
		l_SalRqu := l_SalRqu *(-1);
	ELSE
		IF (((p_OldSit = l_Cancelada) OR (p_OldSit = l_Proposta) OR (p_OldSit = l_Suspensa) OR (p_OldSit = l_Finalizada)) AND ((p_NewSit = l_Nao_Iniciada) OR (p_NewSit = l_Em_Andamento))) THEN
			l_SalRqu := l_SalRqu;
		ELSE
			l_SalRqu := 0;
		END IF;
	END IF;			

	IF (l_SalRqu <> 0) THEN
		QL_ATUEFEPOS('U', 'R126RQU', p_NumEmp, p_EstPos, p_CodPlv, p_PosTra, l_SalRqu, p_DatIni, 'N', 'N', 'N');
		QL_AJUQTDEFE('R126RQU', p_EstPos, p_CodPlv, p_PosTra, p_DatIni, p_DatFim, l_SalRqu);
	END IF;						
    
	IF ((p_OldSit = l_Finalizada) OR (p_OldSit = l_Cancelada) OR (p_OldSit = l_Suspensa)) THEN							
		BEGIN
			SELECT COUNT(*) INTO l_QtdRqu FROM R126CPE WHERE CODRQU = p_CodRqu AND (CANEFE <> 'S' OR (CANEFE = 'S' AND DATADM > p_DatIni));
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar saldo da requisição.';
		END;
		l_QtdRqu := l_QtdRqu *(-1);
		QL_ATUEFEPOS('U', 'R126RQU', p_NumEmp, p_EstPos, p_CodPlv, p_PosTra, l_QtdRqu, p_DatIni, 'N', 'N', 'N');
		QL_AJUQTDEFE('R126RQU', p_EstPos, p_CodPlv, p_PosTra, p_DatIni, p_DatFim, l_QtdRqu);							
	END IF;					

	IF ((p_NewSit = l_Finalizada) OR (p_NewSit = l_Cancelada) OR (p_NewSit = l_Suspensa)) THEN	
		BEGIN
			SELECT COUNT(*) INTO l_QtdRqu FROM R126CPE WHERE CODRQU = p_CodRqu AND (CANEFE <> 'S' OR (CANEFE = 'S' AND DATADM > p_DatIni)); 
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar saldo da requisição.';
		END;
		QL_ATUEFEPOS('U', 'R126RQU', p_NumEmp, p_EstPos, p_CodPlv, p_PosTra, l_QtdRqu, p_DatIni, 'N', 'N', 'N');
		QL_AJUQTDEFE('R126RQU', p_EstPos, p_CodPlv, p_PosTra, p_DatIni, p_DatFim, l_QtdRqu);	
	END IF;
END␀×È␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
â#␀␀PROCEDURE QL_ATUEFEFUN(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATAFA DATE,ASITAFA NUMBER(3))
 IS

xTipSit NUMBER(3);
  xVetQlo CHAR;
  xVerQuF CHAR;
  xCntReg NUMBER;
  xRetNotFnd NUMBER;
  xCmpQua DATE;
  xDatTer DATE;
  xVagGer NUMBER;
  xCmpQuaEfe DATE;
  xDatAux DATE;
  xDatMax DATE;

  /* CURSOR c/ os históricos de função vigente do colaborador */
  CURSOR xCsrVigenteR038HFU IS SELECT R038HFU.DATINI, R038HFU.DATFIM, R038HFU.SEQALT, R038HFU.ESTCAR, R038HFU.CODCAR, R038HFU.TABORG, R038HFU.NUMLOC
						                     FROM R038HFU
						                    WHERE R038HFU.NUMEMP = aNumEmp AND R038HFU.TIPCOL = aTipCol
                                  AND R038HFU.NUMCAD = aNumCad AND R038HFU.DATINI <= aDatAfa
                                  AND ((R038HFU.DATFIM > aDatAfa) OR (R038HFU.DATFIM = DATETIME(31,12,1900,0,0,0)) OR (R038HFU.DATFIM IS NULL))
                                  AND R038HFU.TIPSBS = 'T';

  /* CURSOR c/ os históricos de função vigente do colaborador */
    CURSOR xCsrFuturoR038HFU IS SELECT R038HFU.DATINI, R038HFU.DATFIM, R038HFU.SEQALT, R038HFU.ESTCAR, R038HFU.CODCAR, R038HFU.TABORG, R038HFU.NUMLOC
						                      FROM R038HFU
                                 WHERE R038HFU.NUMEMP = aNumEmp AND R038HFU.TIPCOL = aTipCol
                                   AND R038HFU.NUMCAD = aNumCad AND R038HFU.DATINI > aDatAfa
                                   AND R038HFU.TIPSBS = 'T';


  TYPE t_r038hfu IS RECORD(
    DATINI   R038HFU.DATINI%TYPE,
    DATFIM   R038HFU.DATFIM%TYPE,
    SEQALT   R038HFU.SEQALT%TYPE,
    ESTCAR   R038HFU.ESTCAR%TYPE,
    CODCAR   R038HFU.CODCAR%TYPE,
    TABORG   R038HFU.TABORG%TYPE,
    NUMLOC   R038HFU.NUMLOC%TYPE
  );

  xR038HFU t_r038hfu;
  
BEGIN
  xRetNotFnd := 0;
  
  /* Verifica quantos registros existem na tabela da Proprietária. */
  SELECT COUNT(*) INTO xCntReg FROM R000PRP;

  /* a tabela da proprietária não pode ter mais de 1 registro */
  IF (xCntReg > 1) THEN
    RAISERROR 103 'Erro ao buscar dados da tabela da Proprietária (R000PRP): A tabela possui mais de um registro';
  END IF;

  /* Verifica se está integrado com o Módulo do Quadro de lotação */
  BEGIN
    SELECT VETQLO INTO xVetQlo FROM R000PRP;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      xVetQlo := 'N';
  END;

  /* Verifica se está assinalado para Verificar Quadro de Função */
  BEGIN
    SELECT VERQUF INTO xVerQuF FROM R030EMP WHERE NUMEMP = aNumEmp;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      xVerQuF := '0';
  END;
  
  /* Busca o Tipo da Situação */
  BEGIN
    SELECT TIPSIT INTO xTipSit FROM R010SIT WHERE CODSIT = aSitAfa;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      xTipSit := 0;
  END;

  IF (xVetQlo = 'S') AND ((xVerQuF = '1') OR (xVerQuF = '2')) THEN
    /* Se a situação for de Demissão e o Colaborador estiver designado em uma Função, atualizar o quadro de função */
    IF (xTipSit = 7) THEN
      FOREACH xCsrVigenteR038HFU INTO xR038HFU.DATINI,
                                      xR038HFU.DATFIM,
                                      xR038HFU.SEQALT,
                                      xR038HFU.ESTCAR,
                                      xR038HFU.CODCAR,
                                      xR038HFU.TABORG,
                                      xR038HFU.NUMLOC
      LOOP
        /* Atualiza data final do histórico de função */
        BEGIN
          UPDATE R038HFU
             SET DATFIM = aDatAfa
             WHERE NUMEMP = aNumEmp
               AND TIPCOL = aTipCol
               AND NUMCAD = aNumCad
               AND DATINI = xR038HFU.DATINI
               AND SEQALT = xR038HFU.SEQALT;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar histórico de função.';
        END;

        /* Atualiza o efetivo */
        BEGIN
          SELECT CMPQUA, DATTER, VAGGER
            INTO xCmpQua, xDatTer, xVagGer
            FROM R089EFE
           WHERE NUMEMP = aNumEmp
             AND TABORG = xR038HFU.TABORG
             AND NUMLOC = xR038HFU.NUMLOC
             AND ESTCAR = xR038HFU.ESTCAR
             AND CODCAR = xR038HFU.CODCAR
             AND CMPQUA <= aDatAfa
             AND DATTER >= aDatAfa;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            xRetNotFnd := 1;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao carregar dados do efetivo.';
        END;

        IF xRetNotFnd <> 1 THEN
          /* Atualiza o periodo do efetivo vigente */
          BEGIN
            UPDATE R089EFE
               SET DATTER = aDatAfa
             WHERE NUMEMP = aNumEmp
               AND TABORG = xR038HFU.TABORG
               AND NUMLOC = xR038HFU.NUMLOC
               AND ESTCAR = xR038HFU.ESTCAR
               AND CODCAR = xR038HFU.CODCAR
               AND CMPQUA = xCmpQua;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar atualizar o periodo do efetivo vigente.';
          END;

           /* Carrega o proximo périodo */
          BEGIN
            SELECT MIN(CMPQUA)
              INTO xCmpQuaEfe
              FROM R089EFE
             WHERE NUMEMP = aNumEmp
               AND TABORG = xR038HFU.TABORG
               AND NUMLOC = xR038HFU.NUMLOC
               AND ESTCAR = xR038HFU.ESTCAR
               AND CODCAR = xR038HFU.CODCAR
               AND CMPQUA > aDatAfa;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao carregar o proximo périodo.';
          END;
          xDatAux := DATETIMEADD(DD, +1, aDatAfa);

          IF (xCmpQuaEfe IS NULL) OR (xCmpQuaEfe = DATETIME(31,12,1900,0,0,0)) THEN
            xDatMax := '04/06/2080,00:00:00';
            /* Inseri periodo do efetivo futuro */
            BEGIN
              INSERT INTO R089EFE (NUMEMP, TABORG, NUMLOC, ESTCAR, CODCAR, CMPQUA, VAGGER, DATTER)
              VALUES (aNumEmp, xR038HFU.TABORG, xR038HFU.NUMLOC, xR038HFU.ESTCAR, xR038HFU.CODCAR, xDatAux, 0, xDatMax);
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao inserir periodo do efetivo futuro.';
            END;
          ELSE
            /* Atualiza a data do periodo do efetivo futuro */
            BEGIN
              UPDATE R089EFE
                 SET CMPQUA = xDatAux
               WHERE NUMEMP = aNumEmp
                 AND TABORG = xR038HFU.TABORG
                 AND NUMLOC = xR038HFU.NUMLOC
                 AND ESTCAR = xR038HFU.ESTCAR
                 AND CODCAR = xR038HFU.CODCAR
                 AND CMPQUA = xCmpQuaEfe;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a data do periodo do efetivo futuro.';
            END;

            IF (xR038HFU.DATFIM IS NULL) OR (xR038HFU.DATFIM = DATETIME(31,12,1900,0,0,0)) THEN
              xR038HFU.DATFIM := '04/06/2080,00:00:00';
            END IF;


            /* Atualiza o efetivo futuro */
            BEGIN
              UPDATE R089EFE
                 SET VAGGER = VAGGER - 1
               WHERE NUMEMP = aNumEmp
                 AND TABORG = xR038HFU.TABORG
                 AND NUMLOC = xR038HFU.NUMLOC
                 AND ESTCAR = xR038HFU.ESTCAR
                 AND CODCAR = xR038HFU.CODCAR
                 AND CMPQUA > aDatAfa
                 AND DATTER <= xR038HFU.DATFIM
                 AND VAGGER > 0;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar o efetivo futuro.';
            END;
          END IF;
        END IF;
      END LOOP;

      /* Verifica se tem históricos futuros */
      FOREACH xCsrFuturoR038HFU INTO xR038HFU.DATINI,
                                     xR038HFU.DATFIM,
                                     xR038HFU.SEQALT,
                                     xR038HFU.ESTCAR,
                                     xR038HFU.CODCAR,
                                     xR038HFU.TABORG,
                                     xR038HFU.NUMLOC
      LOOP
        IF (xR038HFU.DATFIM IS NULL) OR (xR038HFU.DATFIM = DATETIME(31,12,1900,0,0,0)) THEN
            xR038HFU.DATFIM := '04/06/2080,00:00:00';
        END IF;

        BEGIN
          DELETE FROM R038HFU
           WHERE NUMEMP = aNumEmp
             AND TIPCOL = aTipCol
             AND NUMCAD = aNumCad
             AND DATINI = xR038HFU.DATINI
             AND SEQALT = xR038HFU.SEQALT;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao excluir registros da tabela R038HFU.';
        END;

        /* Atualiza o efetivo futuro */
        BEGIN
          UPDATE R089EFE
             SET VAGGER = VAGGER - 1
           WHERE NUMEMP = aNumEmp
             AND TABORG = xR038HFU.TABORG
             AND NUMLOC = xR038HFU.NUMLOC
             AND ESTCAR = xR038HFU.ESTCAR
             AND CODCAR = xR038HFU.CODCAR
             AND CMPQUA >= xR038HFU.DATINI
             AND DATTER <= xR038HFU.DATFIM
             AND VAGGER > 0;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar o efetivo futuro.';
        END;
      END LOOP;
    END IF;
  END IF;
END␀ØÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_LOGEFETIVO
SP_GETCODUSU
ª␀␀/* I - insert, U - update, D - delete */
PROCEDURE QL_ATUEFEPOS(L_ATIPOPE CHAR,L_ATABOPE VARCHAR2(7),L_ANUMEMP NUMBER(4),L_AESTPOS NUMBER(3),L_ACODPLV NUMBER(4),L_APOSTRA VARCHAR2(25),L_AQTDOPE NUMBER(6),L_ADATOPE DATE,L_ADATDIF CHAR,L_AVAGDIF CHAR,L_ASIT33 CHAR)
 IS

  l_xDatZer  DATE;
  l_xDatOpe  DATE;
  l_xTipAlt  VARCHAR2(100);
  l_xTipOpe  VARCHAR2(30);
  l_xExiEfe  CHAR;
  l_xQTDVAG  NUMBER(6);
  l_xSQTDVAG NUMBER(6);
  l_xOLDVAG  NUMBER(6);
  l_xQTDAFA  NUMBER(6);
  l_xSQTDAFA NUMBER(6);
  l_xOLDAFA  NUMBER(6);
  l_xQTDRQU  NUMBER(6);
  l_xSQTDRQU NUMBER(6);
  l_xOLDRQU  NUMBER(6);
  l_xQTDSOL  NUMBER(6);
  l_xSQTDSOL NUMBER(6);
  l_xOLDSOL  NUMBER(6);
  l_xTabAlt  NUMBER(1);
  l_xObsLog  VARCHAR2(300);
  l_xOpeInt  NUMBER(1);
  l_xCount  NUMBER(6);
  l_Usuario NUMBER(10);
  l_NomeUsuario VARCHAR2(40);
BEGIN
  l_xOLDVAG := 0;
  l_xOLDAFA := 0;
  l_xOLDRQU := 0;
  l_xOLDSOL := 0;
  l_xCount := 0;
 
  l_xSQTDVAG := 0;
  l_xSQTDAFA := 0;
  l_xSQTDRQU := 0;
  l_xSQTDSOL := 0;
  l_xDatZer := '31/12/1900,00:00:00';
  l_xExiEfe := 'N';

  IF (l_aDatOpe = l_xDatZer) THEN
    l_xDatOpe := CURDATE();
  ELSE
    l_xDatOpe := l_aDatOpe;
  END IF;
  
  /* Inicializa variáveis conforme parâmetros de entrada */
  IF (l_aTabOpe = 'R126SVA') THEN /* Solicitação de abertura de vagas */
    l_xSQTDSOL := l_aQtdOpe;
    l_xTabAlt := 1;
  ELSE
    IF (l_aTabOpe = 'R038AFA') THEN /* Afastamentos */
      l_xSQTDAFA := l_aQtdOpe;
      l_xTabAlt := 4;
    ELSE
      IF (l_aTabOpe = 'R126RQU') THEN /* Requisições */
        l_xSQTDRQU := l_aQtdOpe;
        l_xTabAlt := 2;
      ELSE
        IF (l_aTabOpe = 'R038HPO') THEN /* Histórico de postos */
          l_xSQTDVAG := l_aQtdOpe;
          l_xTabAlt := 3;
        ELSE
          IF (l_aTabOpe = 'R038HFI') THEN /* Histórico de filial */
            l_xSQTDVAG := l_aQtdOpe;
            l_xTabAlt := 5;
          END IF;
        END IF;
      END IF;
    END IF;
  END IF;


  /* Verifica se existe registro de efetivção para os parâmetros informados */
  BEGIN
    SELECT 'S' EXIEFE, QTDVAG, QTDAFA, QTDRQU, QTDSOL INTO l_xExiEfe, l_xOLDVAG, l_xOLDAFA, l_xOLDRQU , l_xOLDSOL FROM R092EFE
     WHERE ESTPOS = l_aEstPos
       AND CODPLV = l_aCodPlv
       AND POSTRA = l_aPosTra
       AND DATEFE = l_xDatOpe;
  EXCEPTION
    /* Caso não existir o registro inserimos ele com os valores do último registro */
    WHEN NO_DATA_FOUND THEN
      /* Busca último registro do efetivo */
      BEGIN
        SELECT QTDVAG, QTDAFA, QTDRQU, QTDSOL INTO l_xQTDVAG, l_xQTDAFA, l_xQTDRQU, l_xQTDSOL FROM R092EFE
         WHERE ESTPOS = l_aEstPos
           AND CODPLV = l_aCodPlv
           AND POSTRA = l_aPosTra
           AND DATEFE = (SELECT MAX(R092EFE2.DATEFE) FROM R092EFE R092EFE2
                          WHERE R092EFE2.ESTPOS = R092EFE.ESTPOS
                            AND R092EFE2.CODPLV = R092EFE.CODPLV
                            AND R092EFE2.POSTRA = R092EFE.POSTRA
                            AND R092EFE2.DATEFE <= l_xDatOpe);
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_xQTDVAG := 0;
          l_xQTDAFA := 0;
          l_xQTDRQU := 0;
          l_xQTDSOL := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao buscar último registro do efetivo.';
      END;

      /* Insere registro do efetivo para o periodo não existente */
      BEGIN
        IF ((l_aDatDif = 'S') AND (l_aVagDif = 'N') AND (l_aSit33 = 'S')) THEN
          INSERT INTO R092EFE(ESTPOS, CODPLV, POSTRA, DATEFE, QTDVAG, QTDAFA, QTDRQU, QTDSOL, ORIEFE)
                     VALUES(l_aEstPos, l_aCodPlv, l_aPosTra, l_xDatOpe, (l_xQTDVAG+l_xSQTDVAG), (l_xQTDAFA+l_xSQTDAFA), (l_xQTDRQU+l_xSQTDRQU), (l_xQTDSOL), 2);
        ELSE
          INSERT INTO R092EFE(ESTPOS, CODPLV, POSTRA, DATEFE, QTDVAG, QTDAFA, QTDRQU, QTDSOL, ORIEFE)
                     VALUES(l_aEstPos, l_aCodPlv, l_aPosTra, l_xDatOpe, (l_xQTDVAG+l_xSQTDVAG), (l_xQTDAFA+l_xSQTDAFA), (l_xQTDRQU+l_xSQTDRQU), (l_xQTDSOL+l_xSQTDSOL), 2);
        END IF;
                                  
        l_xOpeInt := 1;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao inserir registro da tabela do efetivo.';
      END;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao buscar último registro do efetivo.';
  END;

  /* Caso exista registro na tabela do efetivo apenas atualizamos sua informação */
  IF ((l_xExiEfe = 'S') AND (l_xTabAlt = 2)) THEN
  	BEGIN
		SELECT COUNT(*) INTO l_xCount
		FROM R092EFE
       	WHERE ESTPOS = l_aEstPos
        	AND CODPLV = l_aCodPlv
         	AND POSTRA = l_aPosTra
         	AND DATEFE = l_xDatOpe
       	 	AND QTDRQU+l_xSQTDRQU >= 0;
    	EXCEPTION
      	WHEN OTHERS THEN
        	RAISERROR 103 'Erro ao contabilizar efetivo.';	
	END;  	
  		
	IF (l_xCount > 0) THEN
		BEGIN
     		UPDATE R092EFE SET QTDVAG = (QTDVAG+l_xSQTDVAG), QTDAFA = (QTDAFA+l_xSQTDAFA), QTDRQU = (QTDRQU+l_xSQTDRQU), QTDSOL = (QTDSOL+l_xSQTDSOL)
         	WHERE ESTPOS = l_aEstPos
           		AND CODPLV = l_aCodPlv
           		AND POSTRA = l_aPosTra
           		AND DATEFE = l_xDatOpe
       	   		AND QTDRQU+l_xSQTDRQU >= 0;
        	l_xOpeInt := 2;
      		EXCEPTION
        	WHEN OTHERS THEN
          		RAISERROR 103 'Erro ao atualizar informações do efetivo.';
    	END;
    ELSE
    	l_xOpeInt := 0;
    	l_xObsLog := 'Não foi possível atualizar a Quantidade de Requisições do quadro.' 
    		|| ' Qtd atual: ' || CONVERT(NUMBER_TO_CHAR, l_xOLDRQU)
    		|| ', Estrutura: ' || CONVERT(NUMBER_TO_CHAR, l_aEstPos) 
    		|| ', Plano Vagas: ' || CONVERT(NUMBER_TO_CHAR, l_aCodPlv) 
    		|| ', Posto: ' || l_aPosTra 
    		|| ', Data: ' || CONVERT(DATE_TO_CHAR, l_xDatOpe);
    END IF;
   
  ELSE
  	IF(l_xExiEfe = 'S') THEN
  		BEGIN
	  		SELECT COUNT(*) INTO l_xCount
	  		FROM R092EFE
       		WHERE ESTPOS = l_aEstPos
         		AND CODPLV = l_aCodPlv
         		AND POSTRA = l_aPosTra
         		AND DATEFE = l_xDatOpe;
    		EXCEPTION
      		WHEN OTHERS THEN
       		 RAISERROR 103 'Erro ao contabilizar efetivo.';
	  	END;  	
  		
	  	IF (l_xCount > 0) THEN
			BEGIN
      			UPDATE R092EFE SET QTDVAG = (QTDVAG+l_xSQTDVAG), QTDAFA = (QTDAFA+l_xSQTDAFA), QTDRQU = (QTDRQU+l_xSQTDRQU), QTDSOL = (QTDSOL+l_xSQTDSOL)
       			WHERE ESTPOS = l_aEstPos
         			AND CODPLV = l_aCodPlv
         			AND POSTRA = l_aPosTra
         			AND DATEFE = l_xDatOpe;
      			l_xOpeInt := 2;
    			EXCEPTION
      			WHEN OTHERS THEN
       		 		RAISERROR 103 'Erro ao atualizar informações do efetivo.';
    		END;
    	END IF;
  	END IF;
  END IF;

  /* Monta e Grava LOG da operação */
  SP_GETCODUSU(l_Usuario OUT, l_nomeUsuario OUT);
  IF (l_xOpeInt = 1) THEN /* Inseriu */
    l_xObsLog := 'Inseriu registro na tabela do efetivo pelo usuário: '
      || CONVERT(NUMBER_TO_CHAR, l_Usuario) 
      ||'.';
  ELSE
    IF (l_xOpeInt = 2) THEN /* Atualizou */
      l_xObsLog := 'Atualizou registro na tabela do efetivo pelo usuário: '
        || CONVERT(NUMBER_TO_CHAR, l_Usuario) 
        ||'. Dados anteriores, ' 
     	|| 'Vagas: ' || CONVERT(NUMBER_TO_CHAR, l_xOLDVAG) 
     	|| ', Afastamentos: ' || CONVERT(NUMBER_TO_CHAR, l_xOLDAFA) 
     	|| ', Requisições: ' || CONVERT(NUMBER_TO_CHAR, l_xOLDRQU) 
     	|| ', Solicitações: ' || CONVERT(NUMBER_TO_CHAR, l_xOLDSOL);
    END IF;
  END IF;
  SP_LOGEFETIVO(l_aNumEmp, l_aCodPlv, l_aEstPos, l_aPosTra, l_xDatOpe, l_aQtdOpe, l_aTipOpe, l_xTabAlt, l_xObsLog);
END␀ÙÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0␀␀QL_RETATUQUA
QL_RETLOCANT
QL_RETPROLOC
QL_RETLOCNIV
QL_RETCCUANT
QL_RETPROCCU
QL_RETCARANT
QL_RETPROCAR
QL_RETFILANT
QL_RETESCANT
QL_RETPROESC
QL_RETSITANT
QL_RETVINANT
QL_RETPROVIN
QL_RETTIPTUR
QL_RETCARNIV
