TRIGGER R097FOT_ED AFTER DELETE ON R097FOT FOR EACH ROW
DECLARE
	l_idtpes VARCHAR(23);
BEGIN
    SP_RETIDTPES(NULL, 9, NULL, NULL, NULL, NULL, :OLD.PROPAC, l_idtpes OUT);
    SP_SAM_PENDENCIES(30, 3, l_idtpes);

    /* Gera pendência para remover a foto da concentradora. Isto devido a exclusão da foto via LGPD. */
    SP_PEND82(l_idtpes, 3);
