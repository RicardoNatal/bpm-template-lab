  END IF;

  /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
  l_craAux_num := CONVERT(CHAR_TO_NUMBER, l_craAux);
  SP_RETICARD(NULL, l_craAux_num, l_icardA OUT, l_icardR OUT, l_numser OUT);

