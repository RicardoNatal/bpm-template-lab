TRIGGER R036EDU_EI AFTER INSERT ON R036EDU FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Controle de Frequência Escolar (Tabela: R036EDU) */ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 81;     /* Controle de Frequência Escolar (Tabela: R036EDU) */
  l_codtpa := 273;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R036EDU_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDEP', CONVERT(NUMBER_TO_CHAR, :NEW.CODDEP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ANOESC', CONVERT(NUMBER_TO_CHAR, :NEW.ANOESC));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R036EDU_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DEPBOL', :NEW.DEPBOL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOEM', CONVERT(NUMBER_TO_CHAR, :NEW.CODOEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SERINS', CONVERT(NUMBER_TO_CHAR, :NEW.SERINS));
        SP_DATSTR(:NEW.ENTMAI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENTMAI', l_datTemp);
        SP_DATSTR(:NEW.ENTNOV, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENTNOV', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERMAI', CONVERT(NUMBER_TO_CHAR, :NEW.PERMAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERNOV', CONVERT(NUMBER_TO_CHAR, :NEW.PERNOV));
        SP_DATSTR(:NEW.DATVAC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATVAC', l_datTemp);
      END;
  END IF; 
END␀!Ô␀␀		SENIOR;0²␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R036EDU_EU AFTER UPDATE ON R036EDU FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Controle de Frequência Escolar (Tabela: R036EDU) */ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 81;     /* Controle de Frequência Escolar (Tabela: R036EDU) */
  l_codtpa := 274;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.CodDep <> :NEW.CodDep)
   OR (:OLD.AnoEsc <> :NEW.AnoEsc)
   OR (:OLD.DepBol <> :NEW.DepBol)
   OR (:OLD.CodOem <> :NEW.CodOem)
   OR (:OLD.SerIns <> :NEW.SerIns)
   OR (:OLD.EntMai <> :NEW.EntMai)
   OR (:OLD.EntNov <> :NEW.EntNov)
   OR (:OLD.PerMai <> :NEW.PerMai)
   OR (:OLD.PerNov <> :NEW.PerNov)
   OR (:OLD.DatVac <> :NEW.DatVac)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R036EDU_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDEP', CONVERT(NUMBER_TO_CHAR, :OLD.CODDEP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ANOESC', CONVERT(NUMBER_TO_CHAR, :OLD.ANOESC));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R036EDU_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDEPBOL', :OLD.DEPBOL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDEPBOL', :NEW.DEPBOL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODOEM', CONVERT(NUMBER_TO_CHAR, :OLD.CODOEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODOEM', CONVERT(NUMBER_TO_CHAR, :NEW.CODOEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSERINS', CONVERT(NUMBER_TO_CHAR, :OLD.SERINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSERINS', CONVERT(NUMBER_TO_CHAR, :NEW.SERINS));
        SP_DATSTR(:OLD.ENTMAI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENTMAI', l_datTemp);
        SP_DATSTR(:NEW.ENTMAI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENTMAI', l_datTemp);
        SP_DATSTR(:OLD.ENTNOV, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENTNOV', l_datTemp);
        SP_DATSTR(:NEW.ENTNOV, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENTNOV', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERMAI', CONVERT(NUMBER_TO_CHAR, :OLD.PERMAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERMAI', CONVERT(NUMBER_TO_CHAR, :NEW.PERMAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERNOV', CONVERT(NUMBER_TO_CHAR, :OLD.PERNOV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERNOV', CONVERT(NUMBER_TO_CHAR, :NEW.PERNOV));
        SP_DATSTR(:OLD.DATVAC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATVAC', l_datTemp);
        SP_DATSTR(:NEW.DATVAC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATVAC', l_datTemp);
      END;
    END IF; 
  END IF; 
END␀Ô␀␀		SENIOR;0Û
