G␀␀PROCEDURE R088USU_ATUCON(P_CRAVEI NUMBER,P_CRACON NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_SITUA CHAR)
 IS

  l_icard        CHAR(12);
  l_icardv       CHAR(12);
  l_datahora     CHAR(10);
  l_count        NUMBER;
  l_comando_nulo BOOLEAN;
  l_lnkcon       VARCHAR2(31);
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_data_zero    DATE;
  l_situa        CHAR(1);
  l_hora_atual   NUMBER(4);
  l_data_atual   DATE;
  l_veifis       NUMBER(12);
  l_crafis       NUMBER(12);
  l_numser       VARCHAR(12);
  l_icardR    	 VARCHAR(12);
  /*TELEMÁTICA*/
  l_usutel       VARCHAR2(31);
  l_comando      VARCHAR2(1024);
  l_retstr     VARCHAR(1);
  l_reterr     NUMBER(1);
BEGIN
  /* TSI */
  SP_USUTEL(l_usutel);    

  l_data_zero :=  '31/12/1900,00:00:00';
  /* coloca zeros a esquerda do numero */

  /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
  SP_RETICARD(NULL, p_cravei, l_icardv OUT , l_icardR OUT, l_numser OUT);
  SP_RETICARD(NULL, p_cracon, l_icard OUT , l_icardR OUT, l_numser OUT);  

  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();

  /* COLOCA ZEROS A ESQUERDA DO NUMERO */
  SP_DATSTR(p_datval,'DDMMYY',l_datstr OUT);
  SP_INTSTR(p_horval,'HHMM',l_horstr OUT);

  /* CORRIGE A DATA SE VIER COM VALOR ZERO */
  IF  (l_datstr = '311200') OR (p_datval > '31/12/2050,00:00:00') THEN
      l_datstr :=  '311250';
  END IF;
  IF  (l_horstr = '0000') THEN
      l_horstr :=  '2359';
  END IF;
  l_datahora := l_datstr || l_horstr;

  /* Atualiza CONTVEI */
  l_comando_nulo:=FALSE;
  l_situa := p_situa;

  l_comando := 'SELECT COUNT(1) FROM '||l_usutel||'CONTVEI WHERE ICARD ='''|| l_icard ||''' AND ICARDV ='''|| l_icardv ||''' ';
  SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
  IF (l_reterr = 1) THEN
    l_comando_nulo:=TRUE;
  ELSIF (l_reterr = 2) THEN
    l_count := 0;
    RAISERROR 103 'Erro no CONTVEI - TOO MANY ROWS.';
  ELSIF (l_reterr = 3) THEN
    RAISERROR 103 'ON-Line: Erro no SELECT CONTVEI.';
  END IF;

  /* SE A DATA FOR PASSADA, O SITUA É ALTERADO PARA 1 */
  IF  (p_datval < l_data_atual) OR (p_datval = l_data_atual AND p_horval <= l_hora_atual) THEN
      l_situa := '1';
  END IF;

  /* INSERE/ALTERA A CONTVEI */
  IF  (L_COMANDO_NULO = TRUE) OR (L_COUNT = 0) THEN
      l_comando := 'INSERT INTO '||l_usutel||'CONTVEI (ICARD, ICARDV, DATAHORA, SITUA)';
      l_comando := l_comando||' VALUES ('''|| l_icard ||''','''|| l_icardv ||''','''|| l_datahora ||''','''||l_situa ||''') ';
  ELSE
      l_comando := 'UPDATE '||l_usutel||'CONTVEI SET DATAHORA='''|| l_datahora ||''', SITUA='''||
                   l_situa ||''' WHERE ICARD = '''|| l_icard ||''' AND ICARDV = '''|| l_icardv ||''' ';
  END IF;
  
  SP_CMDTSI(l_comando);
END	MSSQL;23#SP_DATSTR
SP_INTSTR
SP_RETICARD
I␀␀CREATE PROCEDURE R088USU_ATUCON(@p_cravei FLOAT, @p_cracon FLOAT, @p_datval DATETIME, @p_horval FLOAT, @p_situa CHAR) AS
BEGIN
DECLARE @l_icard CHAR(12)
DECLARE @l_icardv CHAR(12)
DECLARE @l_datahora CHAR(10)
DECLARE @l_count INTEGER
DECLARE @l_comando_nulo NUMERIC(1,0)
DECLARE @l_lnkcon VARCHAR(31)
DECLARE @l_datstr CHAR(6)
DECLARE @l_horstr CHAR(4)
DECLARE @l_data_zero DATETIME
DECLARE @l_situa CHAR(1)
DECLARE @l_hora_atual SMALLINT
DECLARE @l_data_atual DATETIME
DECLARE @l_usutel VARCHAR(21)
DECLARE @l_comando VARCHAR(1024)
DECLARE @l_retstr VARCHAR(1)
DECLARE @l_reterr SMALLINT
DECLARE @l_numser CHAR(12);
DECLARE @l_icardR VARCHAR(12);
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  SELECT @ChkError = 0
  EXECUTE  @ChkError = SP_USUTEL @l_usutel OUTPUT
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  SELECT @l_data_zero =  CONVERT(DATETIME,'12/31/1900 00:00:00', 101)
  EXECUTE  @ChkError = SP_RETICARD NULL,@p_cravei,@l_icardv OUTPUT,@l_icardR OUTPUT,@l_numser OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  EXECUTE  @ChkError = SP_RETICARD NULL,@p_cracon,@l_icard OUTPUT,@l_icardR OUTPUT,@l_numser OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  SELECT @l_hora_atual = DATEPART(HOUR,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))*60+DATEPART(MINUTE,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))
  SELECT @l_data_atual = CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(MM, GETDATE())))) + '/' + LTRIM(RTRIM(STR(DATEPART(DD, GETDATE())))) + '/' + LTRIM(RTRIM(STR(DATEPART(YY, GETDATE())))))
  EXECUTE  @ChkError = SP_DATSTR @p_datval,'DDMMYY',@l_datstr OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  EXECUTE  @ChkError = SP_INTSTR @p_horval,'HHMM',@l_horstr OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  IF (@l_datstr='311200') 
      OR (@p_datval> CONVERT(DATETIME,'12/31/2050 00:00:00', 101))
  BEGIN
    SELECT @l_datstr = '311250'
  END
  IF (@l_horstr='0000')
  BEGIN
    SELECT @l_horstr = '2359'
  END
  SELECT @l_datahora = @l_datstr+@l_horstr
  SELECT @l_comando_nulo = 0
  SELECT @l_situa = @p_situa
  SELECT @l_comando = 'SELECT COUNT(1) FROM '+@l_usutel+'CONTVEI WHERE ICARD ='''+@l_icard+''' AND ICARDV ='''+@l_icardv+''' '
  EXECUTE  @ChkError = SP_SELTSI 0,'l_count',@l_comando,@l_count OUTPUT ,@l_retstr OUTPUT ,@l_reterr OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  IF (@l_reterr=1)
  BEGIN
    SELECT @l_comando_nulo = 1
    SELECT @ChkError = 0
  END
  ELSE IF (@l_reterr=2)
  BEGIN
    SELECT @l_count = 0
    BEGIN
      RAISERROR('Erro no CONTVEI - TOO MANY ROWS.',11,1) WITH SETERROR
      SELECT @ChkError = -30
      GOTO FIM
    END
  END
  ELSE IF (@l_reterr=3)
  BEGIN
    BEGIN
      RAISERROR('ON-Line: Erro no SELECT CONTVEI.',11,1) WITH SETERROR
      SELECT @ChkError = -30
      GOTO FIM
    END
  END
  IF (@p_datval<@l_data_atual) 
      OR (@p_datval=@l_data_atual 
      AND @p_horval<=@l_hora_atual)
  BEGIN
    SELECT @l_situa = '1'
  END
  IF (@L_COMANDO_NULO=1) 
      OR (@L_COUNT=0)
  BEGIN
    SELECT @l_comando = 'INSERT INTO '+@l_usutel+'CONTVEI (ICARD, ICARDV, DATAHORA, SITUA)'
    SELECT @l_comando = @l_comando+' VALUES ('''+@l_icard+''','''+@l_icardv+''','''+@l_datahora+''','''+@l_situa+''') '
  END
  ELSE
  BEGIN
    SELECT @l_comando = 'UPDATE '+@l_usutel+'CONTVEI SET DATAHORA='''+@l_datahora+''', SITUA='''+@l_situa+''' WHERE ICARD = '''+@l_icard+''' AND ICARDV = '''+@l_icardv+''' '
  END
  EXECUTE  @ChkError = SP_CMDTSI @l_comando 
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
FIM:
  RETURN @ChkError
END␀7İ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
