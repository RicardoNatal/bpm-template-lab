TRIGGER R070BIO_EI AFTER INSERT ON R070BIO FOR EACH ROW

DECLARE
l_idtpes          CHAR(23);
l_numcpf          NUMBER(11);
l_codtbi_str      VARCHAR2(2);
l_tiptem_str      VARCHAR2(1);
l_idregister      VARCHAR2(26);

/* CURSOR c/ os Crachás principais na R070CON */
  CURSOR c_r070con IS SELECT NUMCRA,NUMFIS,TECCRA,VERPRM,CODPRM,PRMSAB,PRMDOM,PRMFER,
                             PRMRT1,PRMRT2,PRMRT3,DATVAL,NOMFUN,NUMPIS,TIPCRA,TIPDOC, NUMDOC, USABIO
                            FROM R070CON
                            WHERE IDTPES = l_idtpes AND CHCPRI = 0;
  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NUMCRA%TYPE,
    NUMFIS   R070CON.NUMFIS%TYPE,
    TECCRA   R070CON.TECCRA%TYPE,
    VERPRM   R070CON.VERPRM%TYPE,
    CODPRM   R070CON.CODPRM%TYPE,
    PRMSAB   R070CON.PRMSAB%TYPE,
    PRMDOM   R070CON.PRMDOM%TYPE,
    PRMFER   R070CON.PRMFER%TYPE,
    PRMRT1   R070CON.PRMRT1%TYPE,
    PRMRT2   R070CON.PRMRT2%TYPE,
    PRMRT3   R070CON.PRMRT3%TYPE,
    DATVAL   R070CON.DATVAL%TYPE,
    NOMFUN   R070CON.NOMFUN%TYPE,
    NUMPIS   R070CON.NUMPIS%TYPE,
    TIPCRA   R070CON.TIPCRA%TYPE,
    TIPDOC   R070CON.TIPDOC%TYPE,
    NUMDOC   R070CON.NUMDOC%TYPE,
    USABIO   R070CON.USABIO%TYPE);
  l_r070con t_r070con;
BEGIN
  l_idtpes := :NEW.IDTPES;

  /* Busca todos os registros de crachá principal na R070CON para gerar na R070ACR */
  FOREACH c_r070con INTO l_r070con.NUMCRA,
                         l_r070con.NUMFIS,
                         l_r070con.TECCRA,
                         l_r070con.VERPRM,
                         l_r070con.CODPRM,
                         l_r070con.PRMSAB,
                         l_r070con.PRMDOM,
                         l_r070con.PRMFER,
                         l_r070con.PRMRT1,
                         l_r070con.PRMRT2,
                         l_r070con.PRMRT3,
                         l_r070con.DATVAL,
                         l_r070con.NOMFUN,
                         l_r070con.NUMPIS,
                         l_r070con.TIPCRA,
                         l_r070con.TIPDOC,
                         l_r070con.NUMDOC,
                         l_r070con.USABIO
  LOOP
      IF (l_r070con.TIPDOC = 2) THEN
          l_numcpf := l_r070con.NUMDOC;
      ELSE
          l_numcpf := 0;
      END IF;
      /*Insere registro na R070ACR com ultimo parametro AltBio=2 (excluir).*/
      /* Somente se a pessoa utilizar biometria */  
      IF ((l_r070con.TIPCRA = 1) OR (l_r070con.TIPCRA = 2) OR (l_r070con.TIPCRA = 6)) AND 
         ((l_r070con.NUMPIS > 0) OR (l_numcpf > 0)) AND
         (l_r070con.USABIO > 1) AND 
         (:NEW.TIPTEM = 1) THEN
          SP_R070ACR('A', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                          0, l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                          l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3,
                          0, 0, 0, 0, 0, 0, 0,
                          l_r070con.DATVAL, l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,3,0,0, l_numcpf);
		  
		  SP_R070ACR('H', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                          0, l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                          l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3,
                          0, 0, 0, 0, 0, 0, 0,
                          l_r070con.DATVAL, l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,0,0,27, l_numcpf);
      END IF;

      SP_PEND62('I', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                     l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                     l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3, l_r070con.DATVAL,
                     l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,3, l_numcpf);
  END LOOP;

  /* Geração de pendência de biometria p/ o Ronda senior X */
  IF (:NEW.INTEGR IS NULL) OR (:NEW.INTEGR ='N') THEN
      SP_INTSTR(:NEW.CODTBI, '99', l_codtbi_str OUT);
      SP_INTSTR(:NEW.TIPTEM, '9', l_tiptem_str OUT);
      l_idregister := l_idtpes || l_codtbi_str || l_tiptem_str;
      SP_SAM_PENDENCIES(47, 1, l_idregister);
  END IF;
END		SENIOR;20¯␀␀

TRIGGER R070BIO_EI AFTER INSERT ON R070BIO FOR EACH ROW
DECLARE
l_idtpes          CHAR(23);
l_numcpf          NUMBER(11);
l_codtbi_str      VARCHAR2(2);
l_tiptem_str      VARCHAR2(1);
l_idregister      VARCHAR2(26);

/* CURSOR c/ os Crachás principais na R070CON */
  CURSOR c_r070con IS SELECT NUMCRA,NUMFIS,TECCRA,VERPRM,CODPRM,PRMSAB,PRMDOM,PRMFER,
                             PRMRT1,PRMRT2,PRMRT3,DATVAL,NOMFUN,NUMPIS,TIPCRA,TIPDOC,NUMDOC,USABIO
                            FROM R070CON
                            WHERE IDTPES = l_idtpes AND CHCPRI = 0;
  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NUMCRA%TYPE,
    NUMFIS   R070CON.NUMFIS%TYPE,
    TECCRA   R070CON.TECCRA%TYPE,
    VERPRM   R070CON.VERPRM%TYPE,
    CODPRM   R070CON.CODPRM%TYPE,
    PRMSAB   R070CON.PRMSAB%TYPE,
    PRMDOM   R070CON.PRMDOM%TYPE,
    PRMFER   R070CON.PRMFER%TYPE,
    PRMRT1   R070CON.PRMRT1%TYPE,
    PRMRT2   R070CON.PRMRT2%TYPE,
    PRMRT3   R070CON.PRMRT3%TYPE,
    DATVAL   R070CON.DATVAL%TYPE,
    NOMFUN   R070CON.NOMFUN%TYPE,
    NUMPIS   R070CON.NUMPIS%TYPE,
    TIPCRA   R070CON.TIPCRA%TYPE,
    TIPDOC   R070CON.TIPDOC%TYPE,
    NUMDOC   R070CON.NUMDOC%TYPE,
    USABIO   R070CON.USABIO%TYPE);
  l_r070con t_r070con;
BEGIN
  l_idtpes := :NEW.IDTPES;

  SP_ATUBIOTELEMAT ('I', :NEW.idtpes, :NEW.codtbi, :NEW.tiptem, :NEW.tembio);
  
  /* Busca todos os registros de crachá principal na R070CON para gerar na R070ACR */
  FOREACH c_r070con INTO l_r070con.NUMCRA,
                         l_r070con.NUMFIS,
                         l_r070con.TECCRA,
                         l_r070con.VERPRM,
                         l_r070con.CODPRM,
                         l_r070con.PRMSAB,
                         l_r070con.PRMDOM,
                         l_r070con.PRMFER,
                         l_r070con.PRMRT1,
                         l_r070con.PRMRT2,
                         l_r070con.PRMRT3,
                         l_r070con.DATVAL,
                         l_r070con.NOMFUN,
                         l_r070con.NUMPIS,
                         l_r070con.TIPCRA,
                         l_r070con.TIPDOC,
                         l_r070con.NUMDOC,
                         l_r070con.USABIO
  LOOP
      IF (l_r070con.TIPDOC = 2) THEN
          l_numcpf := l_r070con.NUMDOC;
      ELSE
          l_numcpf := 0;
      END IF;
      /*Insere registro na R070ACR com ultimo parametro AltBio=2 (excluir).*/
      /* Somente se a pessoa utilizar biometria */  
      IF ((l_r070con.TIPCRA = 1) OR (l_r070con.TIPCRA = 2) OR (l_r070con.TIPCRA = 6)) AND 
         ((l_r070con.NUMPIS > 0) OR (l_numcpf > 0)) AND
         (l_r070con.USABIO > 1) AND
         (:NEW.TIPTEM = 1) THEN
          SP_R070ACR('A', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                          0, l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                          l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3,
                          0, 0, 0, 0, 0, 0, 0,
                          l_r070con.DATVAL, l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,3,0,0,l_numcpf);
		  SP_R070ACR('H', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                          0, l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                          l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3,
                          0, 0, 0, 0, 0, 0, 0,
                          l_r070con.DATVAL, l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,0,0,27,l_numcpf);
      END IF;

      SP_PEND62('I', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                     l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                     l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3, l_r070con.DATVAL,
                     l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,3,l_numcpf);
  END LOOP;

  /* Geração de pendência de biometria p/ o Ronda senior X */
  IF (:NEW.INTEGR IS NULL) OR (:NEW.INTEGR ='N') THEN
      SP_INTSTR(:NEW.CODTBI, '99', l_codtbi_str OUT);
      SP_INTSTR(:NEW.TIPTEM, '9', l_tiptem_str OUT);
      l_idregister := l_idtpes || l_codtbi_str || l_tiptem_str;
      SP_SAM_PENDENCIES(47, 1, l_idregister);
  END IF;
END	MSSQL;23~%␀␀CREATE TRIGGER r070bio_ei
ON r070bio
FOR INSERT
AS
BEGIN
  DECLARE @NEW_IdtPes varchar(23)
  DECLARE @l_temBio varbinary(max)
  DECLARE @NEW_CodTBi smallint
  DECLARE @NEW_TipTem smallint
  DECLARE @NEW_CodUsu bigint
  DECLARE @NEW_DatCol datetime
  DECLARE @NEW_HorCol integer
  DECLARE @NEW_CarBio varchar(1)
  DECLARE @NEW_Integr varchar(1)
  DECLARE CUR_r070bio_INS_NEW CURSOR FOR
  SELECT
    new.idtpes N_IdtPes,
    new.codtbi N_CodTBi,
    new.tiptem N_TipTem,
    new.codusu N_CodUsu,
    new.datcol N_DatCol,
    new.horcol N_HorCol,
    new.carbio N_CarBio,
    new.integr N_Integr
  FROM inserted new
  DECLARE @l_idtpes char(23)
  DECLARE @l_numcpf bigint
  DECLARE @l_codtbi smallint
  DECLARE @l_tiptem smallint
  DECLARE @l_integr varchar(1)
  DECLARE @l_codtbi_str varchar(2)
  DECLARE @l_tiptem_str varchar(1)
  DECLARE @l_idregister varchar(26)
  DECLARE @l_r070con_NUMCRA bigint
  DECLARE @l_r070con_NUMFIS bigint
  DECLARE @l_r070con_TECCRA smallint
  DECLARE @l_r070con_VERPRM smallint
  DECLARE @l_r070con_CODPRM integer
  DECLARE @l_r070con_PRMSAB integer
  DECLARE @l_r070con_PRMDOM integer
  DECLARE @l_r070con_PRMFER integer
  DECLARE @l_r070con_PRMRT1 integer
  DECLARE @l_r070con_PRMRT2 integer
  DECLARE @l_r070con_PRMRT3 integer
  DECLARE @l_r070con_DATVAL varchar(16)
  DECLARE @l_r070con_NOMFUN varchar(40)
  DECLARE @l_r070con_NUMPIS bigint
  DECLARE @l_r070con_TIPCRA smallint
  DECLARE @l_r070con_TIPDOC smallint
  DECLARE @l_r070con_NUMDOC varchar(20)
  DECLARE @l_r070con_USABIO smallint
  DECLARE @ChkError integer
  SET NOCOUNT ON;
  SET XACT_ABORT OFF;
  SAVE TRANSACTION TR_r070bio_ei
  SELECT
    @ChkError = 0
  OPEN CUR_r070bio_INS_NEW
  SELECT
    @ChkError = @@Error
  IF @ChkError <> 0
  BEGIN
    CLOSE CUR_r070bio_INS_NEW
    DEALLOCATE CUR_r070bio_INS_NEW
    GOTO FIM
  END
  FETCH NEXT FROM CUR_r070bio_INS_NEW INTO
  @NEW_IdtPes, @NEW_CodTBi, @NEW_TipTem, @NEW_CodUsu, @NEW_DatCol, @NEW_HorCol, @NEW_CarBio, @NEW_Integr
  WHILE (@@FETCH_STATUS = 0)
  BEGIN
    SELECT
      @l_idtpes = @NEW_IDTPES

	  SELECT
      @l_codtbi = @NEW_CodTBi

    SELECT
      @l_tiptem = @NEW_TipTem

    SELECT
      @l_integr = @NEW_Integr

    SELECT
      @l_temBio = TEMBIO
    FROM R070BIO
    WHERE IDTPES = @NEW_IdtPes
    AND CODTBI = @NEW_CodTBi
    AND TIPTEM = @NEW_TipTem
    AND CODUSU = @NEW_CodUsu
    AND DATCOL = @NEW_DatCol
    AND HORCOL = @NEW_HorCol

    EXEC SP_ATUBIOTELEMAT 'I',
                          @NEW_IdtPes,
                          @NEW_CodTbi,
                          @NEW_TipTem,
                          @l_temBio

    DECLARE c_r070con CURSOR FOR
    SELECT
      r070con.numcra NUMCRA,
      r070con.numfis NUMFIS,
      r070con.teccra TECCRA,
      r070con.verprm VERPRM,
      r070con.codprm CODPRM,
      r070con.prmsab PRMSAB,
      r070con.prmdom PRMDOM,
      r070con.prmfer PRMFER,
      r070con.prmrt1 PRMRT1,
      r070con.prmrt2 PRMRT2,
      r070con.prmrt3 PRMRT3,
      r070con.datval DATVAL,
      r070con.nomfun NOMFUN,
      r070con.numpis NUMPIS,
      r070con.tipcra TIPCRA,
	  r070con.tipdoc TIPDOC,
	  r070con.numdoc NUMDOC,
      r070con.usabio USABIO
    FROM r070con r070con
    WHERE idtpes = @l_idtpes
    AND chcpri = 0
    OPEN c_r070con
    FETCH NEXT FROM c_r070con INTO @l_r070con_NUMCRA, @l_r070con_NUMFIS, @l_r070con_TECCRA, @l_r070con_VERPRM, @l_r070con_CODPRM, @l_r070con_PRMSAB, @l_r070con_PRMDOM, @l_r070con_PRMFER, @l_r070con_PRMRT1, @l_r070con_PRMRT2, @l_r070con_PRMRT3,
    @l_r070con_DATVAL, @l_r070con_NOMFUN, @l_r070con_NUMPIS, @l_r070con_TIPCRA, @l_r070con_TIPDOC, @l_r070con_NUMDOC, @l_r070con_USABIO
    WHILE (@@FETCH_STATUS = 0)
    BEGIN
	  IF (@l_r070con_TIPDOC = 2)
	  BEGIN
	      SELECT @l_numcpf=@l_r070con_NUMDOC
	  END
	  ELSE
	  BEGIN
	      SELECT @l_numcpf=0 
	  END
      IF ((@l_r070con_TIPCRA = 1)
        OR (@l_r070con_TIPCRA = 2)
        OR (@l_r070con_TIPCRA = 6))
        AND ((@l_r070con_NUMPIS > 0) OR (@l_numcpf > 0))
        AND (@l_r070con_USABIO > 1)
		AND (@NEW_TipTem = 1)
      BEGIN
        EXECUTE @ChkError = SP_R070ACR 'A',
                                       @l_r070con_NumCra,
                                       @l_r070con_NumFis,
                                       @l_r070con_TecCra,
                                       @l_r070con_VERPRM,
                                       0,
                                       @l_r070con_CODPrm,
                                       @l_r070con_PrmSab,
                                       @l_r070con_PrmDom,
                                       @l_r070con_PrmFer,
                                       @l_r070con_PrmRt1,
                                       @l_r070con_PrmRt2,
                                       @l_r070con_PrmRt3,
                                       0,
                                       0,
                                       0,
                                       0,
                                       0,
                                       0,
                                       0,
                                       @l_r070con_DATVAL,
                                       @l_Idtpes,
                                       @l_r070con_NomFun,
                                       @l_r070con_NumPis,
                                       3,
                                       0,
                                       0,
                                       @l_numcpf
        IF @ChkError <> 0
        BEGIN
          GOTO FNc_r070con3
        END
        EXECUTE @ChkError = SP_R070ACR 'H',
                                       @l_r070con_NumCra,
                                       @l_r070con_NumFis,
                                       @l_r070con_TecCra,
                                       @l_r070con_VERPRM,
                                       0,
                                       @l_r070con_CODPrm,
                                       @l_r070con_PrmSab,
                                       @l_r070con_PrmDom,
                                       @l_r070con_PrmFer,
                                       @l_r070con_PrmRt1,
                                       @l_r070con_PrmRt2,
                                       @l_r070con_PrmRt3,
                                       0,
                                       0,
                                       0,
                                       0,
                                       0,
                                       0,
                                       0,
                                       @l_r070con_DATVAL,
                                       @l_Idtpes,
                                       @l_r070con_NomFun,
                                       @l_r070con_NumPis,
                                       0,
                                       0,
                                       27,
                                       @l_numcpf
        IF @ChkError <> 0
        BEGIN
          GOTO FNc_r070con3
        END
      END
      EXECUTE @ChkError = SP_PEND62 'I',
                                    @l_r070con_NumCra,
                                    @l_r070con_NumFis,
                                    @l_r070con_TecCra,
                                    @l_r070con_VERPRM,
                                    @l_r070con_CODPrm,
                                    @l_r070con_PrmSab,
                                    @l_r070con_PrmDom,
                                    @l_r070con_PrmFer,
                                    @l_r070con_PrmRt1,
                                    @l_r070con_PrmRt2,
                                    @l_r070con_PrmRt3,
                                    @l_r070con_DATVAL,
                                    @l_Idtpes,
                                    @l_r070con_NomFun,
                                    @l_r070con_NumPis,
                                    3,
									@l_numcpf
      IF @ChkError <> 0
      BEGIN
        GOTO FNc_r070con3
      END
      FETCH NEXT FROM c_r070con INTO @l_r070con_NUMCRA, @l_r070con_NUMFIS, @l_r070con_TECCRA, @l_r070con_VERPRM, @l_r070con_CODPRM, @l_r070con_PRMSAB, @l_r070con_PRMDOM, @l_r070con_PRMFER, @l_r070con_PRMRT1, @l_r070con_PRMRT2, @l_r070con_PRMRT3,
      @l_r070con_DATVAL, @l_r070con_NOMFUN, @l_r070con_NUMPIS, @l_r070con_TIPCRA, @l_r070con_TIPDOC, @l_r070con_NUMDOC, @l_r070con_USABIO
    END
  FNc_r070con3: /* FINALLY OPEN CURSOR */
    CLOSE c_r070con
    DEALLOCATE c_r070con
    IF @ChkError <> 0
      GOTO FIM
    FETCH NEXT FROM CUR_r070bio_INS_NEW INTO
    @NEW_IdtPes, @NEW_CodTBi, @NEW_TipTem, @NEW_CodUsu, @NEW_DatCol, @NEW_HorCol, @NEW_CarBio, @NEW_Integr
  END
  CLOSE CUR_r070bio_INS_NEW
  DEALLOCATE CUR_r070bio_INS_NEW

  IF (@l_integr IS NULL) OR (@l_integr='N')
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @l_codtbi,'99',@l_codtbi_str OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END

    EXECUTE  @ChkError = SP_INTSTR @l_tiptem,'9',@l_tiptem_str OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END

    SELECT @l_idregister = @l_idtpes+@l_codtbi_str+@l_tiptem_str

    EXECUTE  @ChkError = SP_SAM_PENDENCIES 47,1,@l_idregister
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END;

FIM:
  IF @ChkError <> 0
    ROLLBACK TRANSACTION TR_r070bio_ei
END␀^Ù␀␀		SENIOR;0Ñ␀␀

TRIGGER R070BIO_EU AFTER UPDATE ON R070BIO FOR EACH ROW

DECLARE
l_idtpes          CHAR(23);
l_numcpf          NUMBER(11);
l_codtbi_str      VARCHAR2(2);
l_tiptem_str      VARCHAR2(1);
l_idregister      VARCHAR2(26);
  
/* CURSOR c/ os Crachás principais na R070CON */
  CURSOR c_r070con IS SELECT NUMCRA,NUMFIS,TECCRA,VERPRM,CODPRM,PRMSAB,PRMDOM,PRMFER,
                             PRMRT1,PRMRT2,PRMRT3,DATVAL,NOMFUN,NUMPIS,TIPCRA,TIPDOC,NUMDOC,USABIO
                            FROM R070CON
                            WHERE IDTPES = l_idtpes AND CHCPRI = 0;
  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NUMCRA%TYPE,
    NUMFIS   R070CON.NUMFIS%TYPE,
    TECCRA   R070CON.TECCRA%TYPE,
    VERPRM   R070CON.VERPRM%TYPE,
    CODPRM   R070CON.CODPRM%TYPE,
    PRMSAB   R070CON.PRMSAB%TYPE,
    PRMDOM   R070CON.PRMDOM%TYPE,
    PRMFER   R070CON.PRMFER%TYPE,
    PRMRT1   R070CON.PRMRT1%TYPE,
    PRMRT2   R070CON.PRMRT2%TYPE,
    PRMRT3   R070CON.PRMRT3%TYPE,
    DATVAL   R070CON.DATVAL%TYPE,
    NOMFUN   R070CON.NOMFUN%TYPE,
    NUMPIS   R070CON.NUMPIS%TYPE,
    TIPCRA   R070CON.TIPCRA%TYPE,
    TIPDOC   R070CON.TIPDOC%TYPE,
    NUMDOC   R070CON.NUMDOC%TYPE,
    USABIO   R070CON.USABIO%TYPE
    );
  l_r070con t_r070con;
BEGIN
  l_idtpes := :NEW.IDTPES;

  /* Busca todos os registros de crachá principal na R070CON para gerar na R070ACR */
  FOREACH c_r070con INTO l_r070con.NUMCRA,
                         l_r070con.NUMFIS,
                         l_r070con.TECCRA,
                         l_r070con.VERPRM,
                         l_r070con.CODPRM,
                         l_r070con.PRMSAB,
                         l_r070con.PRMDOM,
                         l_r070con.PRMFER,
                         l_r070con.PRMRT1,
                         l_r070con.PRMRT2,
                         l_r070con.PRMRT3,
                         l_r070con.DATVAL,
                         l_r070con.NOMFUN,
                         l_r070con.NUMPIS,
                         l_r070con.TIPCRA,
                         l_r070con.TIPDOC,
                         l_r070con.NUMDOC,
                         l_r070con.USABIO
  LOOP
      IF (l_r070con.TIPDOC = 2) THEN
          l_numcpf := l_r070con.NUMDOC;
      ELSE
          l_numcpf := 0;
      END IF;
      /*Insere registro na R070ACR com ultimo parametro AltBio=2 (excluir).*/
      /* Somente se a pessoa utilizar biometria */
      IF ((l_r070con.TIPCRA = 1) OR (l_r070con.TIPCRA = 2) OR (l_r070con.TIPCRA = 6)) AND 
         ((l_r070con.NUMPIS > 0) OR (l_numcpf > 0)) AND
         (l_r070con.USABIO > 1) AND 
         (:NEW.TIPTEM = 1) THEN
          SP_R070ACR('A', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                          0, l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                          l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3,
                          0, 0, 0, 0, 0, 0, 0,
                          l_r070con.DATVAL, l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,3,0,0, l_numcpf);
						  
		  SP_R070ACR('H', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                          0, l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                          l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3,
                          0, 0, 0, 0, 0, 0, 0,
                          l_r070con.DATVAL, l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,0,0,27, l_numcpf);
      END IF;

      SP_PEND62('I', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                     l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                     l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3, l_r070con.DATVAL,
                     l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,3,l_numcpf);
  END LOOP;

  /* Geração de pendência de biometria p/ o Ronda senior X */
  IF (:NEW.INTEGR IS NULL) OR (:NEW.INTEGR ='N') THEN
      SP_INTSTR(:NEW.CODTBI, '99', l_codtbi_str OUT);
      SP_INTSTR(:NEW.TIPTEM, '9', l_tiptem_str OUT);
      l_idregister := l_idtpes || l_codtbi_str || l_tiptem_str;
      SP_SAM_PENDENCIES(47, 2, l_idregister);
  END IF;
END		SENIOR;20¶␀␀

TRIGGER R070BIO_EU AFTER UPDATE ON R070BIO FOR EACH ROW
DECLARE
l_idtpes          CHAR(23);
l_numcpf          NUMBER(11);
l_codtbi_str      VARCHAR2(2);
l_tiptem_str      VARCHAR2(1);
l_idregister      VARCHAR2(26);
/* CURSOR c/ os Crachás principais na R070CON */
  CURSOR c_r070con IS SELECT NUMCRA,NUMFIS,TECCRA,VERPRM,CODPRM,PRMSAB,PRMDOM,PRMFER,
                             PRMRT1,PRMRT2,PRMRT3,DATVAL,NOMFUN,NUMPIS,TIPCRA,TIPDOC,NUMDOC,USABIO
                            FROM R070CON
                            WHERE IDTPES = l_idtpes AND CHCPRI = 0;
  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NUMCRA%TYPE,
    NUMFIS   R070CON.NUMFIS%TYPE,
    TECCRA   R070CON.TECCRA%TYPE,
    VERPRM   R070CON.VERPRM%TYPE,
    CODPRM   R070CON.CODPRM%TYPE,
    PRMSAB   R070CON.PRMSAB%TYPE,
    PRMDOM   R070CON.PRMDOM%TYPE,
    PRMFER   R070CON.PRMFER%TYPE,
    PRMRT1   R070CON.PRMRT1%TYPE,
    PRMRT2   R070CON.PRMRT2%TYPE,
    PRMRT3   R070CON.PRMRT3%TYPE,
    DATVAL   R070CON.DATVAL%TYPE,
    NOMFUN   R070CON.NOMFUN%TYPE,
    NUMPIS   R070CON.NUMPIS%TYPE,
    TIPCRA   R070CON.TIPCRA%TYPE,
    TIPDOC   R070CON.TIPDOC%TYPE,
    NUMDOC   R070CON.NUMDOC%TYPE,
    USABIO   R070CON.USABIO%TYPE
    );
  l_r070con t_r070con;
BEGIN
  l_idtpes := :NEW.IDTPES;
	
  SP_ATUBIOTELEMAT ('U', :NEW.idtpes, :NEW.codtbi, :NEW.tiptem, :NEW.tembio);
	
  /* Busca todos os registros de crachá principal na R070CON para gerar na R070ACR */
  FOREACH c_r070con INTO l_r070con.NUMCRA,
                         l_r070con.NUMFIS,
                         l_r070con.TECCRA,
                         l_r070con.VERPRM,
                         l_r070con.CODPRM,
                         l_r070con.PRMSAB,
                         l_r070con.PRMDOM,
                         l_r070con.PRMFER,
                         l_r070con.PRMRT1,
                         l_r070con.PRMRT2,
                         l_r070con.PRMRT3,
                         l_r070con.DATVAL,
                         l_r070con.NOMFUN,
                         l_r070con.NUMPIS,
                         l_r070con.TIPCRA,
                         l_r070con.TIPDOC,
                         l_r070con.NUMDOC,
                         l_r070con.USABIO
  LOOP
      IF (l_r070con.TIPDOC = 2) THEN
          l_numcpf := l_r070con.NUMDOC;
      ELSE
          l_numcpf := 0;
      END IF;
      /*Insere registro na R070ACR com ultimo parametro AltBio=2 (excluir).*/
      /* Somente se a pessoa utilizar biometria */
      IF ((l_r070con.TIPCRA = 1) OR (l_r070con.TIPCRA = 2) OR (l_r070con.TIPCRA = 6)) AND 
         ((l_r070con.NUMPIS > 0) OR (l_numcpf > 0)) AND
         (l_r070con.USABIO > 1) AND
         (:NEW.TIPTEM = 1) THEN
          SP_R070ACR('A', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                          0, l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                          l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3,
                          0, 0, 0, 0, 0, 0, 0,
                          l_r070con.DATVAL, l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,3,0,0,l_numcpf);
		  
		  SP_R070ACR('H', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                          0, l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                          l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3,
                          0, 0, 0, 0, 0, 0, 0,
                          l_r070con.DATVAL, l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,0,0,27,l_numcpf);
      END IF;

      SP_PEND62('I', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                     l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                     l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3, l_r070con.DATVAL,
                     l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,3,l_numcpf);
  END LOOP;

  /* Geração de pendência de biometria p/ o Ronda senior X */
  IF (:NEW.INTEGR IS NULL) OR (:NEW.INTEGR ='N') THEN
      SP_INTSTR(:NEW.CODTBI, '99', l_codtbi_str OUT);
      SP_INTSTR(:NEW.TIPTEM, '9', l_tiptem_str OUT);
      l_idregister := l_idtpes || l_codtbi_str || l_tiptem_str;
      SP_SAM_PENDENCIES(47, 2, l_idregister);
  END IF;
END	MSSQL;23/*␀␀CREATE TRIGGER r070bio_eu
ON r070bio
FOR UPDATE
AS
BEGIN
  DECLARE @OLD_IdtPes varchar(23)
  DECLARE @l_temBio varbinary(max)
  DECLARE @OLD_CodTBi smallint
  DECLARE @OLD_TipTem smallint
  DECLARE @OLD_CodUsu bigint
  DECLARE @OLD_DatCol datetime
  DECLARE @OLD_HorCol integer
  DECLARE @OLD_CarBio varchar(1)
  DECLARE @OLD_Integr varchar(1)
  DECLARE @NEW_IdtPes varchar(23)
  DECLARE @NEW_CodTBi smallint
  DECLARE @NEW_TipTem smallint
  DECLARE @NEW_CodUsu bigint
  DECLARE @NEW_DatCol datetime
  DECLARE @NEW_HorCol integer
  DECLARE @NEW_CarBio varchar(1)
  DECLARE @NEW_Integr varchar(1)
  DECLARE CUR_r070bio_UPD_OLD CURSOR FOR
  SELECT
    old.idtpes O_IdtPes,
    old.codtbi O_CodTBi,
    old.tiptem O_TipTem,
    old.codusu O_CodUsu,
    old.datcol O_DatCol,
    old.horcol O_HorCol,
    old.carbio O_CarBio,
    old.integr O_Integr
  FROM deleted old
  DECLARE CUR_r070bio_UPD_NEW CURSOR FOR
  SELECT
    new.idtpes N_IdtPes,
    new.codtbi N_CodTBi,
    new.tiptem N_TipTem,
    new.codusu N_CodUsu,
    new.datcol N_DatCol,
    new.horcol N_HorCol,
    new.carbio N_CarBio,
    new.integr N_Integr
  FROM inserted new
  DECLARE @l_idtpes char(23)
  DECLARE @l_numcpf bigint
  DECLARE @l_codtbi smallint
  DECLARE @l_tiptem smallint
  DECLARE @l_integr varchar(1)
  DECLARE @l_codtbi_str varchar(2)
  DECLARE @l_tiptem_str varchar(1)
  DECLARE @l_idregister varchar(26)
  DECLARE @l_r070con_NUMCRA bigint
  DECLARE @l_r070con_NUMFIS bigint
  DECLARE @l_r070con_TECCRA smallint
  DECLARE @l_r070con_VERPRM smallint
  DECLARE @l_r070con_CODPRM integer
  DECLARE @l_r070con_PRMSAB integer
  DECLARE @l_r070con_PRMDOM integer
  DECLARE @l_r070con_PRMFER integer
  DECLARE @l_r070con_PRMRT1 integer
  DECLARE @l_r070con_PRMRT2 integer
  DECLARE @l_r070con_PRMRT3 integer
  DECLARE @l_r070con_DATVAL varchar(16)
  DECLARE @l_r070con_NOMFUN varchar(40)
  DECLARE @l_r070con_NUMPIS bigint
  DECLARE @l_r070con_TIPCRA smallint
  DECLARE @l_r070con_TIPDOC smallint
  DECLARE @l_r070con_NUMDOC varchar(20)
  DECLARE @l_r070con_USABIO smallint
  DECLARE @ChkError integer
  SET NOCOUNT ON;
  SET XACT_ABORT OFF;
  SAVE TRANSACTION TR_r070bio_eu
  SELECT
    @ChkError = 0
  OPEN CUR_r070bio_UPD_OLD
  SELECT
    @ChkError = @@Error
  IF @ChkError <> 0
  BEGIN
    CLOSE CUR_r070bio_UPD_OLD
    DEALLOCATE CUR_r070bio_UPD_OLD
    CLOSE CUR_r070bio_UPD_NEW
    DEALLOCATE CUR_r070bio_UPD_NEW
    GOTO FIM
  END
  OPEN CUR_r070bio_UPD_NEW
  SELECT
    @ChkError = @@Error
  IF @ChkError <> 0
  BEGIN
    CLOSE CUR_r070bio_UPD_OLD
    DEALLOCATE CUR_r070bio_UPD_OLD
    CLOSE CUR_r070bio_UPD_NEW
    DEALLOCATE CUR_r070bio_UPD_NEW
    GOTO FIM
  END
  FETCH NEXT FROM CUR_r070bio_UPD_OLD INTO
  @OLD_IdtPes, @OLD_CodTBi, @OLD_TipTem, @OLD_CodUsu, @OLD_DatCol, @OLD_HorCol, @OLD_CarBio, @OLD_Integr
  FETCH NEXT FROM CUR_r070bio_UPD_NEW INTO
  @NEW_IdtPes, @NEW_CodTBi, @NEW_TipTem, @NEW_CodUsu, @NEW_DatCol, @NEW_HorCol, @NEW_CarBio, @NEW_Integr
  WHILE (@@FETCH_STATUS = 0)
  BEGIN
    SELECT
      @l_idtpes = @NEW_IDTPES

    SELECT
      @l_codtbi = @NEW_CodTBi

    SELECT
      @l_tiptem = @NEW_TipTem

    SELECT
      @l_integr = @NEW_Integr

    SELECT
      @l_temBio = TEMBIO
    FROM R070BIO
    WHERE IDTPES = @NEW_IdtPes
    AND CODTBI = @NEW_CodTBi
    AND TIPTEM = @NEW_TipTem
    AND CODUSU = @NEW_CodUsu
    AND DATCOL = @NEW_DatCol
    AND HORCOL = @NEW_HorCol

    EXEC SP_ATUBIOTELEMAT 'U',
                          @NEW_IdtPes,
                          @NEW_CodTbi,
                          @NEW_TipTem,
                          @l_temBio

    DECLARE c_r070con CURSOR FOR
    SELECT
      r070con.numcra NUMCRA,
      r070con.numfis NUMFIS,
      r070con.teccra TECCRA,
      r070con.verprm VERPRM,
      r070con.codprm CODPRM,
      r070con.prmsab PRMSAB,
      r070con.prmdom PRMDOM,
      r070con.prmfer PRMFER,
      r070con.prmrt1 PRMRT1,
      r070con.prmrt2 PRMRT2,
      r070con.prmrt3 PRMRT3,
      r070con.datval DATVAL,
      r070con.nomfun NOMFUN,
      r070con.numpis NUMPIS,
      r070con.tipcra TIPCRA,
	  r070con.tipdoc TIPDOC,
	  r070con.numdoc NUMDOC,
      r070con.usabio USABIO
    FROM r070con r070con
    WHERE idtpes = @l_idtpes
    AND chcpri = 0
    OPEN c_r070con
    FETCH NEXT FROM c_r070con INTO @l_r070con_NUMCRA, @l_r070con_NUMFIS, @l_r070con_TECCRA, @l_r070con_VERPRM, @l_r070con_CODPRM, @l_r070con_PRMSAB, @l_r070con_PRMDOM, @l_r070con_PRMFER, @l_r070con_PRMRT1, @l_r070con_PRMRT2, @l_r070con_PRMRT3, @l_r070con_DATVAL, @l_r070con_NOMFUN, @l_r070con_NUMPIS, @l_r070con_TIPCRA, @l_r070con_TIPDOC, @l_r070con_NUMDOC, @l_r070con_USABIO
    WHILE (@@FETCH_STATUS = 0)
    BEGIN
	  IF (@l_r070con_TIPDOC = 2)
	  BEGIN
	      SELECT @l_numcpf=@l_r070con_NUMDOC
	  END
	  ELSE
	  BEGIN
	      SELECT @l_numcpf=0 
	  END
      IF ((@l_r070con_TIPCRA = 1)
        OR (@l_r070con_TIPCRA = 2)
        OR (@l_r070con_TIPCRA = 6))
        AND ((@l_r070con_NUMPIS > 0) OR ( @l_numcpf > 0))
        AND (@l_r070con_USABIO > 1)
		AND (@NEW_TipTem = 1)
      BEGIN
        EXECUTE @ChkError = SP_R070ACR 'A',
                                       @l_r070con_NumCra,
                                       @l_r070con_NumFis,
                                       @l_r070con_TecCra,
                                       @l_r070con_VERPRM,
                                       0,
                                       @l_r070con_CODPrm,
                                       @l_r070con_PrmSab,
                                       @l_r070con_PrmDom,
                                       @l_r070con_PrmFer,
                                       @l_r070con_PrmRt1,
                                       @l_r070con_PrmRt2,
                                       @l_r070con_PrmRt3,
                                       0,
                                       0,
                                       0,
                                       0,
                                       0,
                                       0,
                                       0,
                                       @l_r070con_DATVAL,
                                       @l_Idtpes,
                                       @l_r070con_NomFun,
                                       @l_r070con_NumPis,
                                       3,
                                       0,
                                       0,
                                       @l_numcpf
        IF @ChkError <> 0
        BEGIN
          GOTO FNc_r070con2
        END
        EXECUTE @ChkError = SP_R070ACR 'H',
                                       @l_r070con_NumCra,
                                       @l_r070con_NumFis,
                                       @l_r070con_TecCra,
                                       @l_r070con_VERPRM,
                                       0,
                                       @l_r070con_CODPrm,
                                       @l_r070con_PrmSab,
                                       @l_r070con_PrmDom,
                                       @l_r070con_PrmFer,
                                       @l_r070con_PrmRt1,
                                       @l_r070con_PrmRt2,
                                       @l_r070con_PrmRt3,
                                       0,
                                       0,
                                       0,
                                       0,
                                       0,
                                       0,
                                       0,
                                       @l_r070con_DATVAL,
                                       @l_Idtpes,
                                       @l_r070con_NomFun,
                                       @l_r070con_NumPis,
                                       0,
                                       0,
                                       27,
                                       @l_numcpf
        IF @ChkError <> 0
        BEGIN
          GOTO FNc_r070con2
        END
      END
      EXECUTE @ChkError = SP_PEND62 'I',
                                    @l_r070con_NumCra,
                                    @l_r070con_NumFis,
                                    @l_r070con_TecCra,
                                    @l_r070con_VERPRM,
                                    @l_r070con_CODPrm,
                                    @l_r070con_PrmSab,
                                    @l_r070con_PrmDom,
                                    @l_r070con_PrmFer,
                                    @l_r070con_PrmRt1,
                                    @l_r070con_PrmRt2,
                                    @l_r070con_PrmRt3,
                                    @l_r070con_DATVAL,
                                    @l_Idtpes,
                                    @l_r070con_NomFun,
                                    @l_r070con_NumPis,
                                    3,
									@l_numcpf
      IF @ChkError <> 0
      BEGIN
        GOTO FNc_r070con2
      END
      FETCH NEXT FROM c_r070con INTO @l_r070con_NUMCRA, @l_r070con_NUMFIS, @l_r070con_TECCRA, @l_r070con_VERPRM, @l_r070con_CODPRM, @l_r070con_PRMSAB, @l_r070con_PRMDOM, @l_r070con_PRMFER, @l_r070con_PRMRT1, @l_r070con_PRMRT2, @l_r070con_PRMRT3, @l_r070con_DATVAL, @l_r070con_NOMFUN, @l_r070con_NUMPIS, @l_r070con_TIPCRA, @l_r070con_TIPDOC, @l_r070con_NUMDOC, @l_r070con_USABIO
    END
  FNc_r070con2: /* FINALLY OPEN CURSOR */
    CLOSE c_r070con
    DEALLOCATE c_r070con
    IF @ChkError <> 0
      GOTO FIM
    FETCH NEXT FROM CUR_r070bio_UPD_OLD INTO @OLD_IdtPes, @OLD_CodTBi, @OLD_TipTem, @OLD_CodUsu, @OLD_DatCol, @OLD_HorCol, @OLD_CarBio, @OLD_Integr
    FETCH NEXT FROM CUR_r070bio_UPD_NEW INTO @NEW_IdtPes, @NEW_CodTBi, @NEW_TipTem, @NEW_CodUsu, @NEW_DatCol, @NEW_HorCol, @NEW_CarBio, @NEW_Integr
  END
  CLOSE CUR_r070bio_UPD_OLD
  DEALLOCATE CUR_r070bio_UPD_OLD
  CLOSE CUR_r070bio_UPD_NEW
  DEALLOCATE CUR_r070bio_UPD_NEW

  IF (@l_integr IS NULL) OR (@l_integr='N')
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @l_codtbi,'99',@l_codtbi_str OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END

    EXECUTE  @ChkError = SP_INTSTR @l_tiptem,'9',@l_tiptem_str OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END

    SELECT @l_idregister = @l_idtpes+@l_codtbi_str+@l_tiptem_str

    EXECUTE  @ChkError = SP_SAM_PENDENCIES 47,2,@l_idregister
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END;

FIM:
  IF @ChkError <> 0
    ROLLBACK TRANSACTION TR_r070bio_eu
END␀\Ù␀␀		SENIOR;0X␀␀/*
=============================ATENÇÃO!====================================
Toda e qualquer aleração feita nestas triggers devem ser feitas também em 
    suas equivalentes nativas conforme declarado no fim do código.
*/
TRIGGER R070BIO_ED AFTER DELETE ON R070BIO FOR EACH ROW

DECLARE
l_idtpes          CHAR(23);
l_numcpf          NUMBER(11);
l_codtbi_str      VARCHAR2(2);
l_tiptem_str      VARCHAR2(1);
l_idregister      VARCHAR2(26);

/* CURSOR c/ os Crachás principais na R070CON */
  CURSOR c_r070con IS SELECT NUMCRA,NUMFIS,TECCRA,VERPRM,CODPRM,PRMSAB,PRMDOM,PRMFER,
                             PRMRT1,PRMRT2,PRMRT3,DATVAL,NOMFUN,NUMPIS,TIPCRA,TIPDOC,NUMDOC,USABIO
                            FROM R070CON
                            WHERE IDTPES = l_idtpes AND CHCPRI = 0;
  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NUMCRA%TYPE,
    NUMFIS   R070CON.NUMFIS%TYPE,
    TECCRA   R070CON.TECCRA%TYPE,
    VERPRM   R070CON.VERPRM%TYPE,
    CODPRM   R070CON.CODPRM%TYPE,
    PRMSAB   R070CON.PRMSAB%TYPE,
    PRMDOM   R070CON.PRMDOM%TYPE,
    PRMFER   R070CON.PRMFER%TYPE,
    PRMRT1   R070CON.PRMRT1%TYPE,
    PRMRT2   R070CON.PRMRT2%TYPE,
    PRMRT3   R070CON.PRMRT3%TYPE,
    DATVAL   R070CON.DATVAL%TYPE,
    NOMFUN   R070CON.NOMFUN%TYPE,
    NUMPIS   R070CON.NUMPIS%TYPE,
    TIPCRA   R070CON.TIPCRA%TYPE,
    TIPDOC   R070CON.TIPDOC%TYPE,
    NUMDOC   R070CON.NUMDOC%TYPE,
    USABIO   R070CON.USABIO%TYPE);
  l_r070con t_r070con;
BEGIN
  l_idtpes := :OLD.IDTPES;

  /* Busca todos os registros de crachá principal na R070CON para gerar na R070ACR */
  FOREACH c_r070con INTO l_r070con.NUMCRA,
                         l_r070con.NUMFIS,
                         l_r070con.TECCRA,
                         l_r070con.VERPRM,
                         l_r070con.CODPRM,
                         l_r070con.PRMSAB,
                         l_r070con.PRMDOM,
                         l_r070con.PRMFER,
                         l_r070con.PRMRT1,
                         l_r070con.PRMRT2,
                         l_r070con.PRMRT3,
                         l_r070con.DATVAL,
                         l_r070con.NOMFUN,
                         l_r070con.NUMPIS,
                         l_r070con.TIPCRA,
                         l_r070con.TIPDOC,
                         l_r070con.NUMDOC,
                         l_r070con.USABIO
  LOOP
      IF (l_r070con.TIPDOC = 2) THEN
          l_numcpf := l_r070con.NUMDOC;
      ELSE
          l_numcpf := 0;
      END IF;
      /*Insere registro na R070ACR com parametro AltBio=2 (excluir).*/
      /* Somente se a pessoa utilizar biometria */
      IF ((l_r070con.TIPCRA = 1) OR (l_r070con.TIPCRA = 2) OR (l_r070con.TIPCRA = 6)) AND 
         ((l_r070con.NUMPIS > 0) OR (l_numcpf > 0)) AND
         (l_r070con.USABIO > 1) AND 
         (:OLD.TIPTEM = 1) THEN
          SP_R070ACR('A', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                          0, l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                          l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3,
                          0, 0, 0, 0, 0, 0, 0,
                          l_r070con.DATVAL, l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,2,0,0,l_numcpf);
						  
		  SP_R070ACR('Y', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                          0, l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                          l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3,
                          0, 0, 0, 0, 0, 0, 0,
                          l_r070con.DATVAL, l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,0,0,27,l_numcpf);
                                    
          /* desatualiza todas as pendencias para dispositivos Telemática na exclusão da biometria*/
          /* o registro não existe mais na CONTIDIG_xxx e com isso não pode permanecer na lista */
          BEGIN
              UPDATE R070ACR SET STAATU = 2 WHERE 
                  NUMCRA = l_r070con.NumCra AND 
                  NUMFIS = l_r070con.NumFis AND 
                  STAATU IN (0,3,4) AND
                  TIPLIS = 27 AND 
                  NUMEIP IN (SELECT NUMEIP FROM R058RLG WHERE CODCEN IN (SELECT CODCEN FROM R058CEN WHERE GERSEN = 'N'));
          EXCEPTION
              WHEN OTHERS THEN NULL;
          END;            
      END IF;

      SP_PEND62('I', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                     l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                     l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3, l_r070con.DATVAL,
                     l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,2, l_numcpf);
  END LOOP;

  /* Geração de pendência de biometria p/ o Ronda senior X */
  IF (:OLD.INTEGR IS NULL) OR (:OLD.INTEGR ='N') THEN
      SP_INTSTR(:OLD.CODTBI, '99', l_codtbi_str OUT);
      SP_INTSTR(:OLD.TIPTEM, '9', l_tiptem_str OUT);
      l_idregister := l_idtpes || l_codtbi_str || l_tiptem_str;
      SP_SAM_PENDENCIES(47, 3, l_idregister);
  END IF;
END		SENIOR;20k␀␀/*
======================================ATENÇÃO!=============================================
