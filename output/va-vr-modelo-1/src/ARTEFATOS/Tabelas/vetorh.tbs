TRIGGER R042RCM_EI AFTER INSERT ON R042RCM FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs R042RCM - Rescisão Mestre*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 34;     /* R042RCM - Rescisão Mestre*/
  l_codtpa := 179;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R042RCM_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R042RCM_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:NEW.DATDEM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATDEM', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CAUDEM', CONVERT(NUMBER_TO_CHAR, :NEW.CAUDEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDREM', CONVERT(NUMBER_TO_CHAR, :NEW.INDREM));
        SP_DATSTR(:NEW.FIMQUA, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMQUA', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRMD', CONVERT(NUMBER_TO_CHAR, :NEW.CODRMD));
        SP_DATSTR(:NEW.DATAVI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAVI', l_datTemp);
        SP_DATSTR(:NEW.FINAVI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FINAVI', l_datTemp);
        SP_DATSTR(:NEW.DATPAG, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPAG', l_datTemp);
        SP_DATSTR(:NEW.FIMCTT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMCTT', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDIND', CONVERT(NUMBER_TO_CHAR, :NEW.QTDIND));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDREA', CONVERT(NUMBER_TO_CHAR, :NEW.QTDREA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDSSL', CONVERT(NUMBER_TO_CHAR, :NEW.QTDSSL));
