P␀␀

PROCEDURE R073ALU_ATUCON(P_NUMMAT VARCHAR2(15),P_CODPRM NUMBER,P_PRMSAB NUMBER,P_PRMDOM NUMBER,P_PRMFER NUMBER,P_CONTPM CHAR,P_USABIO NUMBER,P_GRACON NUMBER,P_CONADP CHAR,P_NOMPES VARCHAR2(40),P_DDIFON VARCHAR2(3),P_DDDFON VARCHAR2(3),P_NUMFON VARCHAR2(20),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_CONREE CHAR,P_USARFA CHAR)
 IS

l_cracha       NUMBER(12);
  l_situa        CHAR(1);
  l_bloace       CHAR(1);
  l_strerr       VARCHAR2(255);
  l_codsta       NUMBER(2);
  l_horatu       NUMBER(4);
  l_data_zero    DATE;
  l_datatu       DATE;
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_contpm       NUMBER(1);
  l_tempac       NUMBER(3);
  l_conrea       NUMBER(1);
  l_conadp       NUMBER(1);
  l_pesblo       CHAR(1);
  l_pesblo_nmb   NUMBER;
  l_desblo       VARCHAR2(30);
  l_tipdoc       NUMBER(1);
  l_numdoc       VARCHAR2(20);
  l_conree       NUMBER(1);
  l_ddifon       NUMBER;
  l_dddfon       NUMBER;
  l_usarfa       NUMBER(1);
BEGIN
    l_datatu    := CURDATE();
    l_horatu    := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_data_zero  := '31/12/1900,00:00:00';
    SP_RetCra (1,0, 6,0, 0,p_nummat,0,'',l_cracha OUT);
    l_conrea := 1;
    
    SP_STRTOINT(p_ddifon , l_ddifon OUT);
    SP_STRTOINT(p_dddfon , l_dddfon OUT);

    IF  l_cracha = 0 THEN
        SP_RetCra (2,0, 6,0,0,p_nummat,0,'',l_cracha OUT);
    END IF;

    /* Verifica se Aluno possui Cracha */
    IF   l_cracha <> 0  THEN
         /* verifica qual a situação no histórico do aluno */
        l_codsta := 0;
        l_bloace := 'S';
        l_pesblo := '0';
        l_desblo := '';
        l_tipdoc := 0;
        l_numdoc := '';

        BEGIN
            SELECT CODSTA INTO l_codsta FROM R073HSA WHERE NUMMAT = p_nummat AND
                   ((DATINI < l_datatu) OR (DATINI = l_datatu AND HORINI <= l_horatu)) AND
                   ((DATFIM > l_datatu) OR (DATFIM = l_datatu AND HORFIM >= l_horatu) OR (DATFIM = l_data_zero));
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN l_strerr := 'SP_RETBLO: Erro em R073HSA - TOO MANY ROWS. Nummat = '||p_nummat;
                                    RAISERROR 103 l_strerr;
            WHEN NO_DATA_FOUND THEN l_codsta := 0;
            WHEN OTHERS THEN l_strerr := 'SP_RETBLO: Erro no SELECT em R073HSA. Nummat = '||p_nummat;
                             RAISERROR 103 l_strerr;
        END;

        /* verifica se a situação do aluno é de bloqueio */
        BEGIN
            SELECT BLOACE, DESSTA INTO l_bloace, l_desblo FROM R073STA WHERE CODSTA = l_codsta;
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN l_strerr := 'Erro na seleção do bloqueio em R073STA - TOO MANY ROWS. CodSta = '|| CONVERT(NUMBER_TO_CHAR, l_codsta);
                                    RAISERROR 103 l_strerr;
            WHEN NO_DATA_FOUND THEN l_bloace := 'S';
            WHEN OTHERS THEN l_strerr := 'Erro no SELECT em R073STA. CodSta = '||CONVERT(NUMBER_TO_CHAR,l_codsta);
                             RAISERROR 103 l_strerr;
        END;

        IF  (l_bloace = 'S') THEN
            l_situa :='1';
            l_pesblo := '1';
        ELSE
            l_situa :='0';
            l_desblo := '';
        END IF;

        /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
        SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
        IF (l_crapri = 0) THEN
            l_crapri := l_cracha;
        END IF;

        IF (p_contpm = 'S') THEN
          l_contpm := 1;
          /* Busca definições do tempo de permanência de aluno na R070DAC. */
          BEGIN
              SELECT TEMPRA INTO l_tempac FROM R070DAC;
          EXCEPTION
              WHEN OTHERS THEN l_tempac := 0;
          END;
        ELSE
          l_contpm := 0;
          l_tempac := 0;
        END IF;

        IF (p_conadp = 'S') THEN
           l_conadp := '1';
        ELSE
           l_conadp := '0';
        END IF;

        /* Assinala na tabela Controle que o Aluno utiliza reconhecimento facial */
        IF  p_usarfa = 'S' THEN
            l_usarfa := 1;
        ELSE
            l_usarfa := 0;
        END IF;

        IF (p_tipdoc > 0 ) THEN
            l_tipdoc := p_tipdoc;
            l_numdoc := p_numdoc;
        END IF;

        IF (p_conree = 'S') THEN
            l_conree := '1';
        ELSE
            l_conree := '0';
        END IF;

        SP_STRTOINT(l_pesblo , l_pesblo_nmb OUT);

        BEGIN
            UPDATE R070CON SET CODPRM = p_codprm, PRMSAB = p_prmsab, PRMDOM = p_prmdom, PRMFER = p_prmfer,
                               CONPAC = l_contpm, TEMPAC = l_tempac, USABIO = p_usabio, GRACON = p_gracon,
                               CONREA = l_conrea, CONADP = l_conadp, NOMPES = p_nompes, NUMFON = p_numfon, 
                               DDIFON = l_ddifon, DDDFON = l_dddfon, QTDPRV = 0, PESBLO = l_pesblo_nmb,
                               DESBLO = l_desblo, TIPDOC = l_tipdoc, NUMDOC = l_numdoc, CONREE = l_conree,
                               NUMEMP = 0, TIPCOL = 0, NUMCAD = 0, NUMMAT = p_nummat, PROPAC = '0', NUMCAN = 0,
                               USARFA = l_usarfa
             WHERE NUMFIS = l_crapri;
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro Na Atualização da R070CON (R073ALU_ATUCON).';
        END;
        /*Atualiza a situação dos demais crachás.*/
        SP_UPDFIS(l_cracha,l_situa,' ');
        /*Atualiza as permissões para os demais crachás da pessoa*/
        SP_UPDPRM(l_cracha, p_codprm, p_prmsab, p_prmdom, p_prmfer, ' ', ' ', ' ');

        /*Atualiza a Pend_grupo se possuir smart*/
        IF (l_numsma > 0) THEN
            /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
            IF (l_tecpri = 3) THEN
                SP_ATUPRM(l_cracha, l_numsma, p_codprm, 0, 0, 0, p_prmsab, p_prmdom, p_prmfer);
            ELSE
                SP_ATUPRM(l_crapri, l_numsma, p_codprm, 0, 0, 0, p_prmsab, p_prmdom, p_prmfer);
            END IF;
        END IF;
    END IF;
END		SENIOR;20BSP_RETCRA
