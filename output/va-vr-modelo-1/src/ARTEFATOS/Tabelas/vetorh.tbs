      WHERE EXISTS
        (SELECT 1 FROM R058DSP
           WHERE R058DSP.CODDSP = R158PEN.CODDSP AND R058DSP.VERPLF = l_VerPlf
           AND (R058DSP.PLFENT = l_CodPlf OR R058DSP.PLFSAI = l_CodPlf));
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao deletar registros da tabela R158PEN.';
  END;
END		SENIOR;23
‘␀␀

PROCEDURE R058PLF_DELPLF(P_VERPLF NUMBER(3), P_CODPLF NUMBER(7))
 IS

  l_VerPlf      NUMBER(3);
  l_CodPlf      NUMBER(7);
BEGIN
  l_VerPlf := P_VERPLF;
  l_CodPlf := P_CODPLF;

  BEGIN
    DELETE FROM R158PLF
      WHERE R158PLF.VERPLF = l_VerPlf AND
            R158PLF.CODPLF = l_CodPlf;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao deletar registros da tabela R158PLF.';
  END;

  BEGIN
    DELETE FROM R158USU
      WHERE R158USU.VERPLF = l_VerPlf AND
            R158USU.CODPLF = l_CodPlf;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao deletar registros da tabela R158USU.';
  END;

  BEGIN
    DELETE FROM R158PES
      WHERE R158PES.VERPLF = l_VerPlf AND
            R158PES.CODPLF = l_CodPlf;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao deletar registros da tabela R158PES.';
  END;

  BEGIN
    DELETE FROM R158PEN
      WHERE EXISTS
        (SELECT 1 FROM R058DSP
           WHERE R058DSP.CODDSP = R158PEN.CODDSP AND R058DSP.VERPLF = l_VerPlf
           AND (R058DSP.PLFENT = l_CodPlf OR R058DSP.PLFSAI = l_CodPlf));
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao deletar registros da tabela R158PEN.';
  END;
END		SENIOR;24
