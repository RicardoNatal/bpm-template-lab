TRIGGER R110HDO_AU
AFTER UPDATE ON R110HDO
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  IF (:OLD.DATDOA <>:NEW.DATDOA) THEN
    l_codSistema:= 1;
    l_codcpa:= 133;  /* Código da categoria de auditoria - Histórico de Doação de Sangue*/
    l_codtpa:= 398;  /* Código do tipo de auditoria - Alteração*/

    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110HDO_AU', '');

      /* Insere os campos chave na tabela de auditoria R995PRC*/
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:OLD.CODFIC));
        SP_DATSTR(:OLD.DATDOA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATDOA', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110HDO_AU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      /* Insere os valores dos campos na tabela de auditoria R995PRT*/
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
        SP_DATSTR(:OLD.DATDOA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATDOA', l_datTemp);
        SP_DATSTR(:NEW.DATDOA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATDOA', l_datTemp);
      END;
    END IF;
  END IF;
END␀Sß␀␀		SENIOR;0ü␀␀

