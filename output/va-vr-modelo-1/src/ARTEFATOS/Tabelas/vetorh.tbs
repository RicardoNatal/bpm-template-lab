TRIGGER R036DEP_EU AFTER UPDATE ON R036DEP FOR EACH ROW

DECLARE
L_DEMITIDOS BOOLEAN;
  L_SITAFA      R034FUN.SITAFA%TYPE;
  l_Valor     VARCHAR2(2000);  
  l_Valido    BOOLEAN;
  l_DataAlteracao   DATE;
  l_data_zero DATE;
  l_AlterouPessoa   BOOLEAN; 
  
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  
  l_layout VARCHAR2(6);
  l_layoutAlteracaoCadastral VARCHAR2(6);
  l_AlterouInfoCadastral BOOLEAN;
  l_AlterouInfoVinculo BOOLEAN;
  l_AlterouInfoNascimento BOOLEAN;
  l_AlterouDataObito BOOLEAN;
  l_JsonFlags VARCHAR2(2000);
  l_JsonFlagsCadastral VARCHAR2(2000);
  l_JsonFlagsVinculo VARCHAR2(2000);
  l_JsonInfoVinculo VARCHAR2(2000);
  l_JsonInfoCadastral VARCHAR2(2000);
  l_DataObitoOld DATE;
  l_DataObitoNew DATE;
  l_InfoFacult BOOLEAN;
  l_SimplificacaoESocial BOOLEAN;
  l_gerarPendencia BOOLEAN;
  l_VersaoESocial NUMBER;  
BEGIN

  /*Verifica situação do afastamento para verificar se colaborador do dependente foi demitido*/
  BEGIN
    SELECT SITAFA INTO L_SITAFA FROM R034FUN
    WHERE NUMEMP = :NEW.NUMEMP
      AND TIPCOL = :NEW.TIPCOL
      AND NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_SITAFA := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R034FUN.SITAFA';
  END;

  /*Se colaborador do dependente possuí vinculo com pessoas*/
  IF (:NEW.CODPES>0) THEN
    RH_VERCOLDEM(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODPES,L_SITAFA,'R036DEP',L_DEMITIDOS OUT);
    IF (L_DEMITIDOS=TRUE) THEN
      l_AlterouPessoa := FALSE;
      /*Verificar todos os campos em comum entre R036DEP e R033PES, se existir diferença atulizar na R033PES*/
      IF (:NEW.NOMDEP <> :OLD.NOMDEP) THEN
        BEGIN
          UPDATE R033PES SET NOMPES = :NEW.NOMDEP WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NOMPES';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (:NEW.TIPSEX <> :OLD.TIPSEX) THEN
        BEGIN
          UPDATE R033PES SET TIPSEX = :NEW.TIPSEX WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo TIPSEX';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (:NEW.ESTCIV <> :OLD.ESTCIV) THEN
        BEGIN
          UPDATE R033PES SET ESTCIV = :NEW.ESTCIV WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo ESTCIV';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (:NEW.NUMCPF <> :OLD.NUMCPF) THEN
        BEGIN
          UPDATE R033PES SET NUMCPF = :NEW.NUMCPF WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NUMCPF';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (:NEW.DATNAS <> :OLD.DATNAS) THEN
        BEGIN
          UPDATE R033PES SET DATNAS = :NEW.DATNAS WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DATNAS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (:NEW.LOCNAS <> :OLD.LOCNAS) THEN
        BEGIN
          UPDATE R033PES SET CCINAS = :NEW.LOCNAS WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo CCINAS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (:NEW.GRAINS <> :OLD.GRAINS) THEN
        BEGIN
          UPDATE R033PES SET GRAINS = :NEW.GRAINS WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo GRAINS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (:NEW.NOMCOM <> :OLD.NOMCOM) THEN
        BEGIN
          UPDATE R033PES SET NOMCOM = :NEW.NOMCOM WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NOMCOM';
        END;
        l_AlterouPessoa := TRUE;
      END IF;
  
      IF (:NEW.NUMCTP <> :OLD.NUMCTP) THEN
        BEGIN
          UPDATE R033PES SET NUMCTP = :NEW.NUMCTP WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NUMCTP';
        END;
        l_AlterouPessoa := TRUE;
      END IF;  
  
      IF (:NEW.SERCTP <> :OLD.SERCTP) THEN
        BEGIN
          UPDATE R033PES SET SERCTP = :NEW.SERCTP WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo SERCTP';
        END;
        l_AlterouPessoa := TRUE;
      END IF;
  
      IF (:NEW.DIGCAR <> :OLD.DIGCAR) THEN
        BEGIN
          UPDATE R033PES SET DIGCAR = :NEW.DIGCAR WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DIGCAR';
        END;
        l_AlterouPessoa := TRUE;
      END IF;
  
      IF (:NEW.ESTCTP <> :OLD.ESTCTP) THEN
        BEGIN
          UPDATE R033PES SET ESTCTP = :NEW.ESTCTP WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo ESTCTP';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (:NEW.NUMPIS <> :OLD.NUMPIS) THEN
        BEGIN
          UPDATE R033PES SET NUMPIS = :NEW.NUMPIS WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NUMPIS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;
  
      IF (:NEW.NUMELE <> :OLD.NUMELE) THEN
        BEGIN
          UPDATE R033PES SET NUMELE = :NEW.NUMELE WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NUMELE';
        END;
        l_AlterouPessoa := TRUE;
      END IF;
  
      IF (:NEW.NASVIV <> :OLD.NASVIV) THEN
        BEGIN
          UPDATE R033PES SET NASVIV = :NEW.NASVIV WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NASVIV';
        END;
        l_AlterouPessoa := TRUE;
      END IF;  
      
      IF (:NEW.CARSUS <> :OLD.CARSUS) THEN
        BEGIN
          UPDATE R033PES SET CARSUS = :NEW.CARSUS WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo CARSUS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;
  
      IF (:NEW.NUMRIC <> :OLD.NUMRIC) THEN
        BEGIN
          UPDATE R033PES SET NUMRIC = :NEW.NUMRIC WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NUMRIC';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (:NEW.NUMCID <> :OLD.NUMCID) THEN
        BEGIN
          UPDATE R033PES SET NUMCID = :NEW.NUMCID WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NUMCID';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (:NEW.EMICID <> :OLD.EMICID) THEN
        BEGIN
          UPDATE R033PES SET EMICID = :NEW.EMICID WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo EMICID';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (:NEW.ESTCID <> :OLD.ESTCID) THEN
        BEGIN
          UPDATE R033PES SET ESTCID = :NEW.ESTCID WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo ESTCID';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (:NEW.DEXCID <> :OLD.DEXCID) THEN
        BEGIN
          UPDATE R033PES SET DEXCID = :NEW.DEXCID WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DEXCID';
        END;
        l_AlterouPessoa := TRUE;
      END IF;
      
      IF (l_AlterouPessoa = TRUE) THEN    
        l_data_zero  := '31/12/1900,00:00:00';  
	    BEGIN
          UPDATE R033PES SET EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                             DEPAUX = :NEW.CODDEP, COLATI = 0, CANAUX = 0, DATAUX = l_data_zero WHERE CODPES = :NEW.CODPES;
        EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'Erro ao atualizar campos auxiliares da R033PES';
        END;	
	  END IF;
    END IF;  
  END IF;
  
  /*e-Social*/
  l_AlterouInfoCadastral := FALSE;
  l_AlterouInfoVinculo := FALSE;
  l_AlterouInfoNascimento := FALSE;
  l_AlterouDataObito := FALSE;
  l_JsonFlags := '';
  l_JsonFlagsCadastral := '';
  l_JsonFlagsVinculo := '';
  l_JsonInfoVinculo := '';
  l_JsonInfoCadastral := '';
  l_InfoFacult := FALSE;
  l_SimplificacaoESocial := FALSE;
  l_gerarPendencia := TRUE;
  l_VersaoESocial := 0;
  
  IF (:NEW.TIPDEP <> 0) THEN
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificacaoESocial OUT, l_VersaoESocial OUT);
  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
  N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
  
  /* Infos Pai/Mãe */
  IF (((:OLD.GRAPAR = 3) OR (:NEW.GRAPAR = 3)) AND l_SimplificacaoESocial = FALSE AND l_gerarPendencia = TRUE) THEN
    SP_VALUPDATE_NUM(:OLD.GRAPAR, :NEW.GRAPAR, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouInfoNascimento := TRUE;
      SP_CONCAT_NUM_JSON('GRAPAR', :NEW.GRAPAR, :OLD.GRAPAR, l_JsonInfoCadastral OUT);
      SP_CONCAT_NUM_JSON('GRAPAR', :NEW.GRAPAR, :OLD.GRAPAR, l_JsonInfoVinculo OUT);
    END IF;
    
    SP_VALUPDATE_DES(:OLD.NOMCOM, :NEW.NOMCOM, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouInfoNascimento := TRUE;
      SP_CONCAT_DES_JSON('NOMCOM', :NEW.NOMCOM, :OLD.NOMCOM, l_JsonInfoCadastral OUT);
      SP_CONCAT_DES_JSON('NOMCOM', :NEW.NOMCOM, :OLD.NOMCOM, l_JsonInfoVinculo OUT);
    END IF;

    SP_VALUPDATE_DES(:OLD.NOMDEP, :NEW.NOMDEP, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouInfoNascimento := TRUE;
      SP_CONCAT_DES_JSON('NOMDEP', :NEW.NOMDEP, :OLD.NOMDEP, l_JsonInfoCadastral OUT);
      SP_CONCAT_DES_JSON('NOMDEP', :NEW.NOMDEP, :OLD.NOMDEP, l_JsonInfoVinculo OUT);
    END IF;
    
    SP_VALUPDATE_DES(:OLD.TIPSEX, :NEW.TIPSEX, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouInfoNascimento := TRUE;
      SP_CONCAT_DES_JSON('TIPSEX', :NEW.TIPSEX, :OLD.TIPSEX, l_JsonInfoCadastral OUT);
      SP_CONCAT_DES_JSON('TIPSEX', :NEW.TIPSEX, :OLD.TIPSEX, l_JsonInfoVinculo OUT);
    END IF;     
  END IF;

  /* Infos Dependentes */
  IF ((:OLD.TIPDEP <> 0) OR (:NEW.TIPDEP <> 0)) THEN
    SP_VALUPDATE_DES(:OLD.NOMCOM, :NEW.NOMCOM, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouInfoCadastral := TRUE;
      IF (l_AlterouInfoNascimento = FALSE) THEN
        SP_CONCAT_DES_JSON('NOMCOM', :NEW.NOMCOM, :OLD.NOMCOM, l_JsonInfoCadastral OUT);
      END IF;
    END IF;

    SP_VALUPDATE_DES(:OLD.NOMDEP, :NEW.NOMDEP, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouInfoCadastral := TRUE;
      IF (l_AlterouInfoNascimento = FALSE) THEN
        SP_CONCAT_DES_JSON('NOMDEP', :NEW.NOMDEP, :OLD.NOMDEP, l_JsonInfoCadastral OUT);
      END IF;
    END IF;

    SP_VALUPDATE_DAT(:OLD.DATNAS, :NEW.DATNAS, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      SP_CONCAT_DAT_JSON('DATNAS', :NEW.DATNAS, :OLD.DATNAS, l_JsonInfoCadastral OUT);
      l_AlterouInfoCadastral := TRUE;
    END IF;

    SP_VALUPDATE_NUM(:OLD.NUMCPF, :NEW.NUMCPF, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      SP_CONCAT_FLO_JSON('NUMCPF', :NEW.NUMCPF, :OLD.NUMCPF, 0, l_JsonInfoCadastral OUT);
      l_AlterouInfoCadastral := TRUE;
    END IF;

    SP_VALUPDATE_NUM(:OLD.LIMIRF, :NEW.LIMIRF, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      SP_CONCAT_NUM_JSON('LIMIRF', :NEW.LIMIRF, :OLD.LIMIRF, l_JsonInfoCadastral OUT);
      l_AlterouInfoCadastral := TRUE;
    END IF;

    SP_VALUPDATE_NUM(:OLD.LIMSAF, :NEW.LIMSAF, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      SP_CONCAT_NUM_JSON('LIMSAF', :NEW.LIMSAF, :OLD.LIMSAF, l_JsonInfoCadastral OUT);
      l_AlterouInfoCadastral := TRUE;
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.TIPDEP, :NEW.TIPDEP, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      SP_CONCAT_NUM_JSON('TIPDEP', :NEW.TIPDEP, :OLD.TIPDEP, l_JsonInfoCadastral OUT);
      l_AlterouInfoCadastral := TRUE;
    END IF;

    SP_VALUPDATE_DAT(:OLD.DATINV, :NEW.DATINV, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_data_zero  := '31/12/1900,00:00:00';
      IF (((:OLD.DATINV = l_data_zero OR :OLD.DATINV IS NULL) AND (:NEW.DATINV > l_data_zero)) OR ((:NEW.DATINV = l_data_zero OR :NEW.DATINV IS NULL) AND (:OLD.DATINV > l_data_zero))) THEN
        SP_CONCAT_DAT_JSON('DATINV', :NEW.DATINV, :OLD.DATINV, l_JsonInfoCadastral OUT);
        l_AlterouInfoCadastral := TRUE;
      END IF;
    END IF;
    
    /* Verifica se alterou o mês da data de óbito */
    l_data_zero := '31/12/1900,00:00:00';
    l_DataObitoOld := '31/12/1900,00:00:00';
    l_DataObitoNew := '31/12/1900,00:00:00';
    
    IF (:OLD.DATOBI > l_data_zero) THEN
      /* Tratamento para ignorar o dia da data de óbito anterior */
      l_DataObitoOld := DATETIME(01, MONTH(:OLD.DATOBI), YEAR(:OLD.DATOBI), 0, 0, 0);
    END IF;
    
    IF (:NEW.DATOBI > l_data_zero) THEN
      /* Tratamento para ignorar o dia da data de óbito nova */
      l_DataObitoNew := DATETIME(01, MONTH(:NEW.DATOBI), YEAR(:NEW.DATOBI), 0, 0, 0);
    END IF;
    
    SP_VALUPDATE_DAT(l_DataObitoOld, l_DataObitoNew, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      SP_CONCAT_DAT_JSON('DATOBI', :NEW.DATOBI, :OLD.DATOBI, l_JsonInfoCadastral OUT);
      l_AlterouDataObito := TRUE;
    END IF;
    
    SP_VALUPDATE_DES(:OLD.TIPSEX, :NEW.TIPSEX, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      IF (l_SimplificacaoESocial = TRUE) THEN
        RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
        IF (l_layout <> 'S-2300') THEN
          l_AlterouInfoCadastral := TRUE;
          SP_CONCAT_DES_JSON('TIPSEX', :NEW.TIPSEX, :OLD.TIPSEX, l_JsonInfoCadastral OUT);
        END IF;
      END IF;
    END IF;
 
 	IF (l_VersaoESocial >= 6) THEN /*S-1.2*/ 
    	SP_VALUPDATE_DES(:OLD.DESDEP, :NEW.DESDEP, l_Valido OUT);
    	IF (l_Valido = TRUE) THEN 
       		SP_CONCAT_DES_JSON('DESDEP', :NEW.DESDEP, :OLD.DESDEP, l_JsonInfoCadastral OUT);
       		l_AlterouInfoCadastral := TRUE;
       	END IF;
    END IF;
  
  END IF;

  l_JsonFlagsCadastral := l_JsonFlags;
  l_JsonFlagsVinculo := l_JsonFlags;
  
  /* Flag para sinalizar que alterou exclusivamente informações de nascimento */
  IF (l_AlterouInfoNascimento = TRUE) THEN
    IF (l_AlterouInfoVinculo = FALSE) THEN
      SP_CONCATENAR_DES('INFNAS', '0', l_JsonFlagsVinculo OUT);
    END IF;
    IF (l_AlterouInfoCadastral = FALSE) THEN
      SP_CONCATENAR_DES('INFNAS', '0', l_JsonFlagsCadastral OUT);
    END IF;
  END IF;
  
  IF (l_AlterouInfoNascimento = TRUE) THEN
    l_AlterouInfoCadastral := TRUE;
    l_AlterouInfoVinculo := TRUE;
  END IF;
   
  IF ((l_AlterouInfoVinculo = TRUE) OR (l_AlterouInfoCadastral = TRUE)) THEN
    l_DataAlteracao := CURDATE();

    IF (l_layout IS NOT NULL) THEN
     
      IF (l_AlterouInfoVinculo = TRUE) THEN
        SP_E_SOCIAL(l_layout, 'R036DEP', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_JsonFlagsVinculo, l_JsonInfoVinculo, 0, NULL, l_DataAlteracao, 0, 'R036DEP_EU');
      END IF;

      IF (l_AlterouInfoCadastral = TRUE) THEN
      	RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
        SP_E_SOCIAL(l_layoutAlteracaoCadastral, 'R036DEP', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_JsonFlagsCadastral, l_JsonInfoCadastral, 0, NULL, l_DataAlteracao, 0, 'R036DEP_EU');
      END IF;
    
    END IF;
  END IF;
  
  /* Tratamento para quando informar, apagar ou alterar a data de óbito do dependente */
  IF (l_AlterouDataObito = TRUE) THEN
    l_data_zero := '31/12/1900,00:00:00';
    RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
    
    IF (l_DataObitoOld > l_data_zero AND l_DataObitoNew > l_data_zero) THEN 
      /* Já tinha uma data de óbito informada e foi alterado para uma outra data */
      IF (l_DataObitoNew > l_DataObitoOld) THEN
        /* Usuário alterou a data de óbito informando uma superior, desta forma deve gerar pendência para o mês seguinte da data antiga e para o mês seguinte da data nova */
        l_DataAlteracao := DATETIMEADD(MM, 1, l_DataObitoOld); /* Gera pendência com data de referência para o mês seguinte à data de óbito antiga */
        SP_HIST_ESOCIAL(l_layoutAlteracaoCadastral, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DataAlteracao, 'R036DEP', 'DATOBI', 'A', l_JsonFlagsCadastral, l_JsonInfoCadastral, 0, 'R036DEP_EU');
        
        l_DataAlteracao := DATETIMEADD(MM, 1, l_DataObitoNew); /* Gera pendência com data de referência para o mês seguinte à nova data de óbito informada */
        SP_HIST_ESOCIAL(l_layoutAlteracaoCadastral, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DataAlteracao, 'R036DEP', 'DATOBI', 'A', l_JsonFlagsCadastral, l_JsonInfoCadastral, 0, 'R036DEP_EU');
      ELSE
        /* Usuário alterou a data de óbito informando uma data inferior, desta forma basta gerar pendência para o mês seguinte à data nova */
        l_DataAlteracao := DATETIMEADD(MM, 1, l_DataObitoNew); /* Gera pendência com data de referência para o mês seguinte à nova data de óbito informada */
        SP_HIST_ESOCIAL(l_layoutAlteracaoCadastral, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DataAlteracao, 'R036DEP', 'DATOBI', 'A', l_JsonFlagsCadastral, l_JsonInfoCadastral, 0, 'R036DEP_EU');
      END IF;
    ELSE
      /* Usuário informou pela primeira vez ou zerou o campo data de óbito */
      IF (l_DataObitoOld = l_data_zero AND l_DataObitoNew > l_data_zero) THEN
        /* Informou uma data de óbito */ 
        l_DataAlteracao := DATETIMEADD(MM, 1, l_DataObitoNew); /* Gera pendência para o mês seguinte à nova data de óbito informada */
        SP_HIST_ESOCIAL(l_layoutAlteracaoCadastral, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DataAlteracao, 'R036DEP', 'DATOBI', 'A', l_JsonFlagsCadastral, l_JsonInfoCadastral, 0, 'R036DEP_EU');
      ELSE
        IF (l_DataObitoNew = l_data_zero AND l_DataObitoOld > l_data_zero) THEN
          /* Zerou a data de óbito */
          l_DataAlteracao := DATETIMEADD(MM, 1, l_DataObitoOld); /* Gera pendência para o mês seguinte à data de óbito que estava informada anteriormente */
          SP_HIST_ESOCIAL(l_layoutAlteracaoCadastral, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DataAlteracao, 'R036DEP', 'DATOBI', 'A', l_JsonFlagsCadastral, l_JsonInfoCadastral, 0, 'R036DEP_EU');
        END IF;
      END IF;  
    END IF;
   END IF;
  END IF;
  /*e-Social*/
  /* Geração de logs Dependente (Tabela: R036DEP)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 80;     /* Dependente (Tabela: R036DEP)*/
  l_codtpa := 272;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.CodDep <> :NEW.CodDep)
   OR (:OLD.NomDep <> :NEW.NomDep)
   OR (:OLD.NomMae <> :NEW.NomMae)
   OR (:OLD.GraPar <> :NEW.GraPar)
   OR (:OLD.TipDep <> :NEW.TipDep)
   OR (:OLD.TipSex <> :NEW.TipSex)
   OR (:OLD.EstCiv <> :NEW.EstCiv)
   OR (:OLD.GraIns <> :NEW.GraIns)
   OR (:OLD.LimIrf <> :NEW.LimIrf)
   OR (:OLD.LimSaf <> :NEW.LimSaf)
   OR (:OLD.AviImp <> :NEW.AviImp)
   OR (:OLD.DatNas <> :NEW.DatNas)
   OR (:OLD.DatInv <> :NEW.DatInv)
   OR (:OLD.DatVac <> :NEW.DatVac)
   OR (:OLD.EntCer <> :NEW.EntCer)
   OR (:OLD.PaiNas <> :NEW.PaiNas)
   OR (:OLD.EstNas <> :NEW.EstNas)
   OR (:OLD.LocNas <> :NEW.LocNas)
   OR (:OLD.NomCar <> :NEW.NomCar)
   OR (:OLD.NumLiv <> :NEW.NumLiv)
   OR (:OLD.NumReg <> :NEW.NumReg)
   OR (:OLD.NumFol <> :NEW.NumFol)
   OR (:OLD.DepBol <> :NEW.DepBol)
   OR (:OLD.DspIns <> :NEW.DspIns)
   OR (:OLD.NumCpf <> :NEW.NumCpf)
   OR (:OLD.NumMat <> :NEW.NumMat)
   OR (:OLD.DatInc <> :NEW.DatInc)
   OR (:OLD.DatExc <> :NEW.DatExc)
   OR (:OLD.AuxCre <> :NEW.AuxCre)
   OR (:OLD.NmeCre <> :NEW.NmeCre)
   OR (:OLD.CodOem <> :NEW.CodOem)
   OR (:OLD.SerIns <> :NEW.SerIns)
   OR (:OLD.IniTut <> :NEW.IniTut)
   OR (:OLD.DatTut <> :NEW.DatTut)
   OR (:OLD.PenJud <> :NEW.PenJud)
   OR (:OLD.NmDep1 <> :NEW.NmDep1)
   OR (:OLD.NmDep2 <> :NEW.NmDep2)
   OR (:OLD.NmDep3 <> :NEW.NmDep3)
   OR (:OLD.NmDep4 <> :NEW.NmDep4)
   OR (:OLD.DatObi <> :NEW.DatObi)
   OR (:OLD.NumCer <> :NEW.NumCer)
   OR (:OLD.NomCom <> :NEW.NomCom)
   OR (:OLD.CodFor <> :NEW.CodFor)
   OR (:OLD.CodPes <> :NEW.CodPes)
   OR (:OLD.CriPes <> :NEW.CriPes)
   OR (:OLD.MatNas <> :NEW.MatNas)
   OR (:OLD.MatObi <> :NEW.MatObi)
   OR (:OLD.NasViv <> :NEW.NasViv)
   OR (:OLD.MatStr <> :NEW.MatStr)
   OR (:OLD.NumCtp <> :NEW.NumCtp)
   OR (:OLD.SerCtp <> :NEW.SerCtp)
   OR (:OLD.DigCar <> :NEW.DigCar)
   OR (:OLD.EstCtp <> :NEW.EstCtp)
   OR (:OLD.NumPis <> :NEW.NumPis)
   OR (:OLD.NumEle <> :NEW.NumEle)
   OR (:OLD.CarSus <> :NEW.CarSus)
   OR (:OLD.NumRic <> :NEW.NumRic)
   OR (:OLD.NumCid <> :NEW.NumCid)
   OR (:OLD.EmiCid <> :NEW.EmiCid)
   OR (:OLD.EstCid <> :NEW.EstCid)
   OR (:OLD.DexCid <> :NEW.DexCid)
   OR (:OLD.DepRPP <> :NEW.DepRPP)
   OR (:OLD.DesDep <> :NEW.DesDep)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R036DEP_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDEP', CONVERT(NUMBER_TO_CHAR, :OLD.CODDEP));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R036DEP_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOMDEP', :OLD.NOMDEP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNOMDEP', :NEW.NOMDEP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOMMAE', :OLD.NOMMAE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNOMMAE', :NEW.NOMMAE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDGRAPAR', CONVERT(NUMBER_TO_CHAR, :OLD.GRAPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWGRAPAR', CONVERT(NUMBER_TO_CHAR, :NEW.GRAPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPDEP', CONVERT(NUMBER_TO_CHAR, :OLD.TIPDEP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPDEP', CONVERT(NUMBER_TO_CHAR, :NEW.TIPDEP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPSEX', :OLD.TIPSEX);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPSEX', :NEW.TIPSEX);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDESTCIV', CONVERT(NUMBER_TO_CHAR, :OLD.ESTCIV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWESTCIV', CONVERT(NUMBER_TO_CHAR, :NEW.ESTCIV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDGRAINS', CONVERT(NUMBER_TO_CHAR, :OLD.GRAINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWGRAINS', CONVERT(NUMBER_TO_CHAR, :NEW.GRAINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDLIMIRF', CONVERT(NUMBER_TO_CHAR, :OLD.LIMIRF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWLIMIRF', CONVERT(NUMBER_TO_CHAR, :NEW.LIMIRF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDLIMSAF', CONVERT(NUMBER_TO_CHAR, :OLD.LIMSAF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWLIMSAF', CONVERT(NUMBER_TO_CHAR, :NEW.LIMSAF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAVIIMP', :OLD.AVIIMP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAVIIMP', :NEW.AVIIMP);
        SP_DATSTR(:OLD.DATNAS, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATNAS', l_datTemp);
        SP_DATSTR(:NEW.DATNAS, 'DD/MM/YYYY', l_datTemp OUT);
