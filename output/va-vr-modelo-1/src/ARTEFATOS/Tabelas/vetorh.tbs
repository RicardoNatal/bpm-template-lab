¶␀␀+␀d␀␀␀ÿ␀␀4`␀fåÔÿ1␀␀␀␀␀|f¹␀ƒfh␀␀␀ÿ␀␀ÿ␀ [Ñ␀Ôÿ1␀␀␀␀␀ØJbj®FqC␀êÿ␀␀ÿ␀wS=”!␀␀␀␀␀‡S5‡Sc␀␀␀ÿ␀␀ÿ␀\TÔÿ1␀␀␀␀␀(XâUÜV␀␀ÿ␀␀ÿ␀␀Ñ␀ÿÿÿÿÿÿÿÿÂFÂFÂFqC␀␀␀ÿÿ␀␀ÿ␀␀␀Ô␀␀␀Ô␀␀.␀␀0;1;2;3Ô␀␀	SENIOR;0L␀␀

TRIGGER R036DEP_SI AFTER INSERT ON R036DEP

DECLARE
/*CURSOR para buscar código de pessoa armazendo na tabela auxiliar*/
  CURSOR C_R036DEP_AUX IS
  SELECT NUMEMP,TIPCOL,NUMCAD,CODDEP,CODPES FROM R036DEP_AUX;
  TYPE T_R036DEP_AUX IS RECORD(
    NUMEMP   R036DEP_AUX.NUMEMP%TYPE,
    TIPCOL   R036DEP_AUX.TIPCOL%TYPE,
    NUMCAD   R036DEP_AUX.NUMCAD%TYPE,
    CODDEP   R036DEP_AUX.CODDEP%TYPE,
    CODPES   R036DEP_AUX.CODPES%TYPE);
  L_R036DEP_AUX T_R036DEP_AUX;


BEGIN
  FOREACH C_R036DEP_AUX INTO  L_R036DEP_AUX.NUMEMP,
                              L_R036DEP_AUX.TIPCOL,
                              L_R036DEP_AUX.NUMCAD,
                              L_R036DEP_AUX.CODDEP,
                              L_R036DEP_AUX.CODPES
  LOOP
    BEGIN
      /*atualizar o código da pessoa na R036DEP armazenada na tabela auxiliar*/
      UPDATE R036DEP SET CODPES = L_R036DEP_AUX.CODPES
      WHERE NUMEMP = L_R036DEP_AUX.NUMEMP
        AND TIPCOL = L_R036DEP_AUX.TIPCOL
        AND NUMCAD = L_R036DEP_AUX.NUMCAD
        AND CODDEP = L_R036DEP_AUX.CODDEP;
    EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao atualizar R036DEP';
    END;
  END LOOP;

  /*limpar tabela auxliar*/
  BEGIN
    DELETE FROM R036DEP_AUX;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro na Exclusão do R036DEP_AUX';
  END;
END␀Ô␀␀		SENIOR;0:␀␀TRIGGER R036DEP_EI AFTER INSERT ON R036DEP FOR EACH ROW

DECLARE
l_strerr    VARCHAR2(255);
  l_UltPes      R033PES.CODPES%TYPE;
  l_CodPes      R033PES.CODPES%TYPE;
  l_CodPesAux   R033PES.CODPES%TYPE;
  l_CriPes      R036DEP.CRIPES%TYPE;
  l_DatAtu      R033PES.DATALT%TYPE;
  l_HorAtu      R033PES.HORALT%TYPE;
  l_HabPes      R000ASS.HABPES%TYPE;
  l_VinPes      R000ASS.VIPEDE%TYPE;
  l_data_zero DATE;
  l_DataAlteracao   DATE; 
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);

  l_layout       VARCHAR2(6);
  l_layoutAlteracaoCadastral VARCHAR2(6);
  l_JsonFlags VARCHAR2(2000);
/* CURSOR para buscar os códigos de pessoas*/
  CURSOR C_R033PES IS
  SELECT CODPES FROM R033PES ORDER BY CODPES;

BEGIN
  /*Se não existir pessoa vinculada ao dependente gerar uma nova pessoa apartir dos dados do dependente*/
  IF (:NEW.CODPES = 0) THEN
    /*data zerada*/
    l_data_zero  := '31/12/1900,00:00:00';

    /*Verificar assinalamentos para verificar se as rotinas de pessoas estão habilitadas e se o vínculo é obrigatório*/
    BEGIN
      SELECT HABPES,VIPEDE INTO l_HabPes,l_VinPes FROM R000ASS;
      EXCEPTION WHEN NO_DATA_FOUND THEN
        l_HabPes := 'N';
        l_VinPes := 0;
      WHEN OTHERS THEN
        l_strerr := 'Erro ao ler R000ASS'; RAISERROR 103 l_strerr;
    END;

    IF (l_HabPes = 'S') THEN
      IF (l_VinPes = 1) THEN
        l_CriPes := 'S';
      ELSIF (l_VinPes = 2) THEN
        BEGIN
          /*Verifica assinalamentos de obrigatóriedade conforme empresa do colaborador do dependente*/
          SELECT VIPEDE INTO l_VinPes FROM R030EMP WHERE NUMEMP = :NEW.NUMEMP;
          EXCEPTION WHEN NO_DATA_FOUND THEN
            l_VinPes := 0;
          WHEN OTHERS THEN
            l_strerr := 'Erro ao ler R030EMP'; RAISERROR 103 l_strerr;
        END;

        IF (l_VinPes = 1) THEN
          l_CriPes := 'S';
        ELSE
          /*Se o vínculo não for obrigatório buscar resposta se vai ser criada um nova pessoa*/
          l_CriPes := :NEW.CRIPES;
        END IF;
      ELSIF (l_VinPes = 0) THEN
        /*Se o vínculo não for obrigatório buscar resposta se vai ser criada um nova pessoa*/
        l_CriPes := :NEW.CRIPES;
      END IF;

      IF (l_CriPes = 'S') THEN
        BEGIN  
        	SELECT IFNULL(MAX(REFPES), 1) INTO l_CodPes FROM R033ORD;
        EXCEPTION
        	WHEN OTHERS THEN
            	RAISERROR 103 'Falha ao retornar código da pessoa (R033ORD)';
        END;
        
        IF (l_CodPes = 0) THEN
            l_CodPes := 1;
        END IF;
        	
        /*Busca o primeiro código livre para a nova pessoa */
        FOREACH C_R033PES INTO l_CodPesAux
        LOOP
          /* Encontrou um código vago */
          IF (l_CodPes < l_CodPesAux) THEN
            EXIT;
          END IF;

          /* Limite foi atingido */
          IF (l_CodPes = 999999999) THEN
            RAISERROR 103 'Não existem códigos disponíveis para a nova Pessoa. Inclusão não permitida';
          END IF;

          l_CodPes := l_CodPes + 1;
        END LOOP;

        /*Data e hora atual*/
        l_DatAtu := CURDATE();
        l_HorAtu := HOUR(CURTIME())*60 + MINUTE(CURTIME());

        BEGIN
          /*Insere nova pessoa com base nos dados do dependente*/
          INSERT INTO R033PES (CodPes, NomPes, ApePes, NomSoc, TipSex, EstCiv, NumCpf, DatNas, CciNas, CodNac, GraIns, NomCom, DatAlt, HorAlt, CodUsu, DefFis, CodDef, BenRea, RacCor, NumPis, DcdPis, NumCid, EmiCid, EstCid, DexCid, CidEmi, NumCtp, SerCtp, DigCar, DexCtp, EstCtp, NumEle, ZonEle, SecEle, NumCnh, CatCnh, DatCnh, VenCnh, EmaCom, EmaPar, NumTel, NumRam, NumCel, TelCom, DddCel, DdiCel, DddTel, DdiTel, DddCom, DdiCom,EmpAux, TipAux, CadAux, DepAux, ColAti, CanAux, DatAux)
                       VALUES (l_CodPes, :NEW.NOMDEP, '', '', :NEW.TIPSEX, :NEW.ESTCIV, :NEW.NUMCPF, :NEW.DATNAS, :NEW.LOCNAS, 0, :NEW.GRAINS, :NEW.NOMCOM, l_DatAtu, l_HorAtu, 0, '', 0, '', 0, 0, l_data_zero, '', '', '', l_data_zero, 0, 0, '', '', l_data_zero, '', '', '', '', '', '', l_data_zero, l_data_zero, '', '', '', '', '', '', 0, 0, 0, 0,  0, 0,:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODDEP, 0, 0, l_data_zero);
          EXCEPTION WHEN OTHERS THEN
            l_strerr := 'Erro ao Inserir Pessoa Código: '||CONVERT(NUMBER_TO_CHAR, l_CodPes); RAISERROR 103 l_strerr;
        END;

        BEGIN
          /*Insere novo código da pessoa na tabela auxiliar para na ser atualizado na R036DEP*/
          INSERT INTO R036DEP_AUX (NUMEMP,TIPCOL,NUMCAD,CODDEP,CODPES)
                          VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODDEP,l_CodPes);
          EXCEPTION WHEN OTHERS THEN
            l_strerr := 'Erro ao Inserir R036DEP_AUX'; RAISERROR 103 l_strerr;
        END;

      END IF;
    END IF;
  ELSE
    BEGIN
      /*Atualiza os dados do dependente na pessoa*/
      UPDATE R033PES SET
      NOMPES=:NEW.NOMDEP,
      TIPSEX=:NEW.TIPSEX,
      ESTCIV=:NEW.ESTCIV,
      NUMCPF=:NEW.NUMCPF,
      DATNAS=:NEW.DATNAS,
      CCINAS=:NEW.LOCNAS,
      GRAINS=:NEW.GRAINS,
      NOMCOM=:NEW.NOMCOM,
      NUMCTP=:NEW.NUMCTP,
      SERCTP=:NEW.SERCTP,
      DIGCAR=:NEW.DIGCAR,
      ESTCTP=:NEW.ESTCTP,
      NUMPIS=:NEW.NUMPIS,
      NUMELE=:NEW.NUMELE,
      CARSUS=:NEW.CARSUS,
      NUMRIC=:NEW.NUMRIC
      WHERE CODPES = :NEW.CODPES;
      EXCEPTION WHEN OTHERS THEN
       RAISERROR 103 'Erro ao atualizar R033PES';
    END;
  END IF;
  
  /*e-Social*/
  l_JsonFlags := '';
  IF  (:NEW.TIPDEP <> 0) THEN
  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
  IF (l_layout IS NOT NULL) THEN
    l_DataAlteracao := CURDATE();
    IF (:NEW.GRAPAR = 3) THEN
      SP_CONCATENAR_DES('INFNAS', '0', l_JsonFlags OUT);
      SP_E_SOCIAL(l_layout, 'R036DEP', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_JsonFlags, '', 0, NULL, l_DataAlteracao, 0, 'R036DEP_EI');
    END IF;
    IF ((:NEW.GRAPAR = 3) OR (:NEW.TIPDEP <> 0)) THEN
      IF (:NEW.TIPDEP = 0) THEN
        SP_CONCATENAR_DES('INFNAS', '0', l_JsonFlags OUT);
      END IF;
      RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
      SP_E_SOCIAL(l_layoutAlteracaoCadastral, 'R036DEP', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_JsonFlags, '', 0, NULL, l_DataAlteracao, 0, 'R036DEP_EI');
    END IF;
   END IF;
  END IF;
  /*e-Social*/
  
  /* Geração de logs Dependente (Tabela: R036DEP)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 80;     /* Dependente (Tabela: R036DEP)*/
  l_codtpa := 271;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R036DEP_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDEP', CONVERT(NUMBER_TO_CHAR, :NEW.CODDEP));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R036DEP_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMDEP', :NEW.NOMDEP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMMAE', :NEW.NOMMAE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'GRAPAR', CONVERT(NUMBER_TO_CHAR, :NEW.GRAPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPDEP', CONVERT(NUMBER_TO_CHAR, :NEW.TIPDEP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPSEX', :NEW.TIPSEX);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCIV', CONVERT(NUMBER_TO_CHAR, :NEW.ESTCIV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'GRAINS', CONVERT(NUMBER_TO_CHAR, :NEW.GRAINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LIMIRF', CONVERT(NUMBER_TO_CHAR, :NEW.LIMIRF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LIMSAF', CONVERT(NUMBER_TO_CHAR, :NEW.LIMSAF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AVIIMP', :NEW.AVIIMP);
        SP_DATSTR(:NEW.DATNAS, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATNAS', l_datTemp);
        SP_DATSTR(:NEW.DATINV, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINV', l_datTemp);
        SP_DATSTR(:NEW.DATVAC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATVAC', l_datTemp);
        SP_DATSTR(:NEW.ENTCER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENTCER', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PAINAS', CONVERT(NUMBER_TO_CHAR, :NEW.PAINAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTNAS', :NEW.ESTNAS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LOCNAS', CONVERT(NUMBER_TO_CHAR, :NEW.LOCNAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMCAR', :NEW.NOMCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLIV', :NEW.NUMLIV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMREG', :NEW.NUMREG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMFOL', :NEW.NUMFOL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DEPBOL', :NEW.DEPBOL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DSPINS', :NEW.DSPINS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCPF', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCPF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMMAT', CONVERT(NUMBER_TO_CHAR, :NEW.NUMMAT));
        SP_DATSTR(:NEW.DATINC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINC', l_datTemp);
        SP_DATSTR(:NEW.DATEXC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATEXC', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AUXCRE', :NEW.AUXCRE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NMECRE', CONVERT(NUMBER_TO_CHAR, :NEW.NMECRE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOEM', CONVERT(NUMBER_TO_CHAR, :NEW.CODOEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SERINS', CONVERT(NUMBER_TO_CHAR, :NEW.SERINS));
        SP_DATSTR(:NEW.INITUT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INITUT', l_datTemp);
        SP_DATSTR(:NEW.DATTUT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATTUT', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PENJUD', :NEW.PENJUD);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NMDEP1', :NEW.NMDEP1);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NMDEP2', :NEW.NMDEP2);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NMDEP3', :NEW.NMDEP3);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NMDEP4', :NEW.NMDEP4);
        SP_DATSTR(:NEW.DATOBI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATOBI', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCER', :NEW.NUMCER);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMCOM', :NEW.NOMCOM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFOR', CONVERT(NUMBER_TO_CHAR, :NEW.CODFOR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPES', CONVERT(NUMBER_TO_CHAR, :NEW.CODPES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CRIPES', :NEW.CRIPES);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MATNAS', :NEW.MATNAS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MATOBI', :NEW.MATOBI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NASVIV', :NEW.NASVIV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MATSTR', :NEW.MATSTR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCTP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCTP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SERCTP', :NEW.SERCTP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIGCAR', :NEW.DIGCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCTP', :NEW.ESTCTP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMPIS', CONVERT(NUMBER_TO_CHAR, :NEW.NUMPIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMELE', :NEW.NUMELE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CARSUS', :NEW.CARSUS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMRIC', CONVERT(NUMBER_TO_CHAR, :NEW.NUMRIC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCID', :NEW.NUMCID);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EMICID', :NEW.EMICID);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCID', :NEW.ESTCID);
        SP_DATSTR(:NEW.DEXCID, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DEXCID', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DEPRPP', :NEW.DEPRPP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESDEP', :NEW.DESDEP);
      END;
  END IF; 
