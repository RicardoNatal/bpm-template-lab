×'␀␀CREATE OR REPLACE PROCEDURE SP_SINAUD(p_tipope IN smallint,p_numemp IN smallint,p_tipcol IN smallint,p_numcad IN INT,p_datini IN TIMESTAMP(0),p_horini IN smallint,p_numcra IN bigint,p_datfim IN TIMESTAMP(0),p_horfim IN smallint,p_codusu IN bigint,p_RetSin IN OUT smallint)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  l_temAud SMALLINT;
  l_coderr SMALLINT;
  l_codRPA BIGINT;
  l_datatu TIMESTAMP(0);
  l_horatu INT;
  l_datzer TIMESTAMP(0);
  l_datfimANT TIMESTAMP(0);
  l_horfimANT SMALLINT;
  l_staaccANT SMALLINT;
  l_staatuANT SMALLINT;
  l_numempSTR VARCHAR(255);
  l_tipcolSTR VARCHAR(255);
  l_numcadSTR VARCHAR(255);
  l_datiniSTR VARCHAR(255);
  l_horiniStr VARCHAR(255);
  l_numcraSTR VARCHAR(255);
  l_OLDnumcra VARCHAR(255);
  l_datfimSTR VARCHAR(255);
  l_OLDdatfim VARCHAR(255);
  l_horfimSTR VARCHAR(255);
  l_OLDhorfim VARCHAR(255);
  l_staacc VARCHAR(255);
  l_OLDstaacc VARCHAR(255);
  l_staatu VARCHAR(255);
  l_OLDstaatu VARCHAR(255);
  l_tamstr SMALLINT;
BEGIN
  p_RetSin := 0;
  l_coderr := 0;
  l_datatu := TO_DATE(TO_CHAR(CURRENT_TIMESTAMP,'DD/MM/YYYY'),'DD/MM/YYYY');
  
  
  SELECT TO_CHAR(CURRENT_TIMESTAMP, 'SSSSS') INTO l_horatu;
  
  l_datzer :=  TO_DATE('31/12/1900,00:00:00','DD/MM/YYYY,HH24:MI:SS');


  l_tamstr := LENGTH(p_numemp::varchar);
  if (l_tamstr=1) then
    CALL SP_INTSTR(p_numemp,'9',l_numempSTR);
  end if;
  if (l_tamstr=2) then
    CALL SP_INTSTR(p_numemp,'99',l_numempSTR);
  end if;
  if (l_tamstr=3) then
    CALL SP_INTSTR(p_numemp,'999',l_numempSTR);
  end if;
  if (l_tamstr=4) then
    CALL SP_INTSTR(p_numemp,'9999',l_numempSTR);
  end if;
  CALL SP_INTSTR(p_tipcol,'9',l_tipcolSTR);
  l_tamstr := LENGTH(p_numcad::varchar);
  if (l_tamstr=1) then
    CALL SP_INTSTR(p_numcad,'9',l_numcadSTR);
  end if;
  if (l_tamstr=2) then
    CALL SP_INTSTR(p_numcad,'99',l_numcadSTR);
  end if;
  if (l_tamstr=3) then
    CALL SP_INTSTR(p_numcad,'999',l_numcadSTR);
  end if;
  if (l_tamstr=4) then
    CALL SP_INTSTR(p_numcad,'9999',l_numcadSTR);
  end if;
  if (l_tamstr=5) then
    CALL SP_INTSTR(p_numcad,'99999',l_numcadSTR);
  end if;
  if (l_tamstr=6) then
    CALL SP_INTSTR(p_numcad,'999999',l_numcadSTR);
  end if;
  if (l_tamstr=7) then
    CALL SP_INTSTR(p_numcad,'9999999',l_numcadSTR);
  end if;
  if (l_tamstr=8) then
    CALL SP_INTSTR(p_numcad,'99999999',l_numcadSTR);
  end if;
  if (l_tamstr=9) then
    CALL SP_INTSTR(p_numcad,'999999999',l_numcadSTR);
  end if;
  CALL SP_INTSTR(p_numcra,'999999999999',l_numcraSTR);
  CALL SP_DATSTR(p_datini,'DDMMYY',l_datiniSTR);
  l_datiniSTR := SUBSTR(l_datiniSTR,1,2)||'/'||SUBSTR(l_datiniSTR,3,2)||'/20'||SUBSTR(l_datiniSTR,5,2);
  CALL SP_INTSTR(p_horini,'HHMM',l_horiniSTR);
  l_horiniSTR := SUBSTR(l_horiniSTR,1,2)||':'||SUBSTR(l_horiniSTR,3,2);
  CALL SP_DATSTR(p_datfim,'DDMMYY',l_datfimSTR);
  l_datfimSTR := SUBSTR(l_datfimSTR,1,2)||'/'||SUBSTR(l_datfimSTR,3,2)||'/20'||SUBSTR(l_datfimSTR,5,2);
  CALL SP_INTSTR(p_horfim,'HHMM',l_horfimSTR);
  l_horfimSTR := SUBSTR(l_horfimSTR,1,2)||':'||SUBSTR(l_horfimSTR,3,2);
  if (p_DatIni>l_datatu) 
      OR ((p_DatIni=l_datatu) 
      and (p_HorIni>l_horatu)) then
    l_staAtu := '0';
    l_staAcc := '0';
  else
    if (p_DatFim<>l_datzer) 
      AND ((p_DatFim<l_datatu) 
      OR ((p_DatFim=l_datatu) 
      AND ((p_HorFim<=l_horatu) 
      AND (p_HorFim<>0)))) then
      l_StaAtu := '2';
      l_StaAcc := '2';
    else
      l_StaAtu := '1';
      l_StaAcc := '1';
    end if;
  end if;
  l_codRPA := 0;
  CALL SP_RET_REG_AUD(l_codRPA);
  if (p_tipope=0) then
    l_temAud := 0;
    begin
      
      SELECT 
      COUNT(*) EXPR1333540570
       INTO l_temAud 
       FROM R995CTE R995CTE
       WHERE CODCPA=6 
      AND CODTPA=97;
    exception
      when OTHERS then
        l_coderr := 1;
    end;
    if (l_coderr=0) then
      if (l_temAud>0) then
        if (l_coderr=0) then
          begin
            
            INSERT INTO R995RPA (CODRPA,CODSYS,CODCPA,VERCPA,CODTPA,VERTPA,DATRPA,HORRPA,SCRACT,CODUSU) VALUES  (l_codRPA,3,6,1,97,1,l_datatu,l_horatu,'PORTARIA ENTERPRISE',p_codusu);
          exception
            when OTHERS then
              l_coderr := 1;
          end;
          begin
            
            INSERT INTO R995PRC (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMEMP',l_numempSTR);
            
            INSERT INTO R995PRC (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TIPCOL',l_tipcolSTR);
            
            INSERT INTO R995PRC (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMCAD',l_numcadSTR);
          exception
            when OTHERS then
              l_coderr := 1;
          end;
          begin
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DATINI',l_datiniSTR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'HORINI',l_horiniSTR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMCRA',l_numcraSTR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'VIACRA','0');
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DATFIM',l_datfimSTR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'HORFIM',l_horfimSTR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'RECEPR','');
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'STAACC',l_staacc);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'STAATU',l_staatu);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TIPCRA','2');
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TIPOPE','INCLUSÃ’O');
          exception
            when OTHERS then
              l_coderr := 1;
          end;
        end if;
      end if;
    end if;
  end if;
  if (p_tipope=1) then
    l_temAud := 0;
    begin
      
      SELECT 
      COUNT(*) EXPR680394311
       INTO l_temAud 
       FROM R995CTE R995CTE
       WHERE CODCPA=6 
      AND CODTPA=98;
    exception
      when OTHERS then
        l_coderr := 1;
    end;
    if (l_coderr=0) then
      if (l_temAud>0) then
        if (l_coderr=0) then
          begin
            
            SELECT 
      R038HCH.DATFIM DATFIM,R038HCH.HORFIM HORFIM,R038HCH.STAACC STAACC,R038HCH.STAATU STAATU
       INTO l_datfimANT,l_horfimANT,l_staaccANT,l_staatuANT 
       FROM R038HCH R038HCH
       WHERE TIPCRA=2 
      AND NUMEMP=p_numemp 
      AND TIPCOL=p_tipcol 
      AND NUMCAD=p_numcad 
      AND DATINI=p_datini 
      AND HORINI=p_horini;
          exception
            when OTHERS then
              l_coderr := 1;
          end;
          CALL SP_DATSTR(l_datfimANT,'DDMMYY',l_OLDdatfim);
          l_OLDdatfim := SUBSTR(l_OLDdatfim,1,2)||'/'||SUBSTR(l_OLDdatfim,3,2)||'/20'||SUBSTR(l_OLDdatfim,5,2);
          CALL SP_INTSTR(l_horfimANT,'HHMM',l_OLDhorfim);
          l_OLDhorfim := SUBSTR(l_OLDhorfim,1,2)||':'||SUBSTR(l_OLDhorfim,3,2);
          CALL SP_INTSTR(l_staaccANT,'9',l_OLDstaacc);
          CALL SP_INTSTR(l_staatuANT,'9',l_OLDstaatu);
          if (l_coderr=0) then
            begin

              INSERT INTO R995RPA (CODRPA,CODSYS,CODCPA,VERCPA,CODTPA,VERTPA,DATRPA,HORRPA,SCRACT,CODUSU) VALUES  (l_codRPA,3,6,1,98,1,l_datatu,l_horatu,'PORTARIA ENTERPRISE',p_codusu);
            exception
              when OTHERS then
                l_coderr := 1;
            end;
            begin

              INSERT INTO R995PRC (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMEMP',l_numempSTR);

              INSERT INTO R995PRC (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TIPCOL',l_tipcolSTR);

              INSERT INTO R995PRC (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMCAD',l_numcadSTR);
            exception
              when OTHERS then
                l_coderr := 1;
            end;
            begin

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DATINI',l_datiniSTR);

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'HORINI',l_horiniSTR);

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NEWTIPCRA','2');

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'OLDTIPCRA','2');

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NEWNUMCRA',l_numcraSTR);

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'OLDNUMCRA',l_numcraSTR);

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NEWVIACRA','0');

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'OLDVIACRA','0');

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NEWDATFIM',l_datfimSTR);

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'OLDDATFIM',l_OLDdatfim);

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NEWHORFIM',l_horfimSTR);

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'OLDHORFIM',l_OLDhorfim);

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NEWRECEPR','');

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'OLDRECEPR','');

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NEWSTAACC',l_staacc);

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'OLDSTAACC',l_OLDstaacc);

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NEWSTAATU',l_staatu);

              INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'OLDSTAATU',l_OLDstaatu);
            exception
              when OTHERS then
                l_coderr := 1;
            end;
          end if;
        end if;
      end if;
    end if;
  end if;
  p_RetSin := l_coderr;
END
