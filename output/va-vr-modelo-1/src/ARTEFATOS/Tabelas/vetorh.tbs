DECLARE
l_online      BOOLEAN;
  l_crapro      NUMBER(12);
  l_cracha      NUMBER(12);
  l_numdoc      VARCHAR2(20);
BEGIN
SP_VerOnLine(l_online OUT);
IF   (l_online = TRUE) THEN

    /* verifica documento */
    BEGIN
        SELECT NUMCPF INTO l_numdoc FROM R034FUN WHERE
               NUMEMP = :NEW.NUMEMP AND
               TIPCOL = :NEW.TIPCOL AND
               NUMCAD = :NEW.NUMCAD;
    EXCEPTION
        WHEN OTHERS THEN l_numdoc := ' ';
    END;

    /* Valida Cracha e Data */
    IF  :NEW.NUMCRA <> 0  THEN
       SP_VISCON (0,l_NumDoc,:NEW.NUMCRA, :NEW.CODPRM,:NEW.DATENT,:NEW.HORENT,:NEW.DATVAL,:NEW.HORVAL,'0',8,0,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,1,1,NULL);
       /* Se tiver crachá provísório vale ele. senão pegar o titular */
       SP_RETCRA (2, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD,0,'',0,'',l_crapro OUT);
       IF   (l_crapro = 0)  THEN
             SP_RETCRA (1, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD,0,'',0,'',l_cracha OUT);
       ELSE  l_cracha := l_crapro;
       END IF;
       AtuSitCra('1',l_cracha);
       AtuSitCra('0',:NEW.NUMCRA);
    END IF;
END IF;
END␀œÚ␀␀		SENIOR;0Ú␀␀

TRIGGER R071AEN_EU AFTER UPDATE ON R071AEN FOR EACH ROW

DECLARE
l_online       BOOLEAN;
  l_data_zero    DATE;
  l_datmin       DATE;
  l_datsai       DATE;
  l_datval       DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_hormin       NUMBER(4);
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
BEGIN
SP_VerOnLine(l_online OUT);
IF   (l_online = TRUE) THEN
    l_data_zero  := '31/12/1900,00:00:00';
    l_datmin := '31/12/2050,00:00:00';
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_data_atual := CURDATE();

    SP_ATUCON (:NEW.NUMCRA,:NEW.CODPRM,:OLD.CODPRM,:NEW.DATVAL,
               :NEW.HORVAL,:OLD.DATVAL,:OLD.HORVAL,:NEW.DATSAI,
               :NEW.HORSAI, NULL);


    /*Verifica a menor das datas*/
    IF (:NEW.DATSAI = l_data_zero) THEN
        l_datsai := '31/12/2050,00:00:00';
    ELSE
        l_datsai := :NEW.DATSAI;
    END IF;

    IF (:NEW.DATVAL = l_data_zero) THEN
        l_datval := '31/12/2050,00:00:00';
    ELSE
        l_datval := :NEW.DATVAL;
    END IF;

    IF (l_datval <> l_datsai) THEN
        IF (l_datval < l_datsai) THEN
            l_datmin := l_datval;
            l_hormin := :NEW.HORVAL;
        ELSE
            l_datmin := l_datsai;
            l_hormin := :NEW.HORSAI;
        END IF;
    /*Data igual, verifica a hora*/
    ELSE
        IF (:NEW.HORVAL < :NEW.HORSAI) THEN
            l_datmin := l_datval;
            l_hormin := :NEW.HORVAL;
        ELSE
            l_datmin := l_datsai;
            l_hormin := :NEW.HORSAI;
        END IF;
    END IF;

    /* Se tiver crachá provísório vale ele. senão pegar o titular */
    SP_RETCRA (2, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD,0,'',0,'',l_crapro OUT);
    IF   (l_crapro = 0)  THEN
         SP_RETCRA (1, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD,0,'',0,'',l_cracha OUT);
    ELSE
       l_cracha := l_crapro;
    END IF;
    
    /* Se a data for menor que a atual, libera o crachá do titular */
    IF  ((l_datmin < l_data_atual) OR (l_datmin = l_data_atual AND l_hormin <= l_hora_atual)) THEN
        /*Libera se o crachá não estiver bloqueado*/
        AtuSitCra('0',l_cracha);
    ELSE
        AtuSitCra('1',l_cracha);
    END IF;
END IF;
END␀šÚ␀␀		SENIOR;0·␀␀

TRIGGER R071AEN_ED AFTER DELETE ON R071AEN FOR EACH ROW

DECLARE
l_data_zero    DATE;
  l_online       BOOLEAN;
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);

BEGIN
/*------------- Trata Visitante ------------*/
SP_VerOnLine(l_online OUT);
IF   (l_online = TRUE)
AND  (:OLD.NUMCRA <> 0) THEN
     /*------------- Trata Visitante ------------*/
     l_data_zero := '31/12/1900,00:00:00';
     /* Apaga Cracha do CONTROLE */
     IF   :OLD.DATSAI = l_data_zero THEN
          AtuSitCra('1',:OLD.NUMCRA);
          /* Se tiver crachá provísório vale ele. senão pegar o titular */
          SP_RETCRA (2, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD,0,'',0,'',l_crapro OUT);
          IF   (l_crapro = 0)  THEN
                SP_RETCRA (1, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD,0,'',0,'',l_cracha OUT);
          ELSE  l_cracha := l_crapro;
          END IF;
          AtuSitCra('0',l_cracha);
     END IF;
END IF;
END␀␀␀¿␀␀␀␀␀␀␀␀␀␀␀␀Ú␀␀…¬␀␀´␀	␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀B%€$$w␀Æÿ␀␀DÚ␀␀␀ÈDÑ␀	␀␀␀␀␀␀K“F“FqC␀êÿ␀␀ÿ␀…w·␀	␀␀␀␀␀␀zy+x+xì*␀␀Æÿ␀␀ÿ␀ÌEÑ␀␀␀␀␀␀␀ KöHÕNqC␀êÿ␀␀ÿ␀øw·␀␀␀␀␀␀␀yóxóxì*␀␀Æÿ␀␀ÿ␀EÑ␀␀␀␀␀␀␀àI­HÎNqC␀êÿ␀␀ÿ␀ßw·␀␀␀␀␀␀␀3yÍxÍxì*␀␀Æÿ␀␀ÿ␀8³␀␀€␀␀␀␀␀␀␀´␀␀ñ³␀␀ñ³␀␀!␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3¤Ú␀␀	SENIOR;0İ␀␀

TRIGGER R071AEO_SI AFTER INSERT ON R071AEO

DECLARE
/* CURSOR c/ os registros gravados no R071AEO_AUX */
  CURSOR c_r071AEO_ins IS
  SELECT NUMEMP,NUMCAD FROM R071AEO_AUX;
  TYPE t_R071AEO_aux IS RECORD(
    NUMEMP   R071AEO_AUX.NUMEMP%TYPE,
    NUMCAD   R071AEO_AUX.NUMCAD%TYPE);
  l_r071AEO_aux t_r071AEO_aux;


BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r071AEO_ins INTO  l_r071AEO_aux.NUMEMP,
                              l_r071AEO_aux.NUMCAD
  LOOP
      R071AEO_ATUCON (l_r071AEO_aux.NUMEMP,l_r071AEO_aux.NUMCAD);
  END LOOP;
  /* Apaga Registro OLD/NEW em R071AEO_AUX */
  BEGIN
    DELETE FROM R071AEO_AUX;
    DROP_TEMP_TABLE R071AEO_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀¡Ú␀␀		SENIOR;0␀␀TRIGGER R071AEO_EI AFTER INSERT ON R071AEO FOR EACH ROW
DECLARE
  l_online       BOOLEAN;
  l_data_limite  DATE;
  l_data_atual   DATE;

  /* Tabela temporária */
  CREATE_TEMP_TABLE R071AEO_AUX;

BEGIN
SP_VerOnLine(l_online OUT);
IF   (l_online = TRUE) THEN
     l_data_atual := CURDATE();
     l_data_limite := DATETimeAdd(DD,6,l_data_atual);
     IF  ((:NEW.DATENT >= l_data_atual) OR (:NEW.DATVAL >= l_data_atual))
     AND  (:NEW.DATENT <= l_data_Limite) THEN
         BEGIN
         /* Insere Registro NEW */
           INSERT INTO R071AEO_AUX (NUMEMP,NUMCAD)
           VALUES (:NEW.NUMEMP,:NEW.NUMCAD);
         EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'Erro no INSERT em R071AEO_AUX.';
         END;
     END IF;
END IF;
END␀¥Ú␀␀	SENIOR;0İ␀␀

