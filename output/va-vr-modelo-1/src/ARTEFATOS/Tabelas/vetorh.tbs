DECLARE
l_CmpDatPag DATE;
l_InfoFacult   BOOLEAN;
l_SimplificacaoESocial BOOLEAN;
l_layout VARCHAR2(6);
l_VersaoESocial NUMBER;
  
BEGIN
  l_InfoFacult := TRUE;
  l_SimplificacaoESocial := FALSE;	
  IF (:NEW.CALIRF = 'S') THEN
		l_CmpDatPag := DATETIME(1,MONTH(:NEW.DATPAG),YEAR(:NEW.DATPAG),0,0,0);
		l_layout := 'S-1200';	  
  		l_VersaoESocial := 0;
  		
  		SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult, l_SimplificacaoESocial OUT, l_VersaoESocial OUT);
  		IF(l_SimplificacaoESocial = TRUE) THEN
  			l_layout := ''; /* Será ajustado o leiaute ao buscar as pendências na tela de declaração mensal */
  		END IF;
	  BEGIN
        SP_R350PEM(:NEW.NUMEMP,0,:NEW.TIPCOL,:NEW.NUMCAD,l_CmpDatPag,1,3,1,l_layout);
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro de pendência mensal para envio do layout S-1200.';
      END;
  END IF;
END␀5Ö␀␀		SENIOR;0(␀␀

TRIGGER R044VAL_EU AFTER UPDATE ON R044VAL FOR EACH ROW

DECLARE
l_alterouValBru BOOLEAN;
  l_alterouValIrf BOOLEAN;
  l_CmpDatPag DATE;
  l_InfoFacult   BOOLEAN;
  l_SimplificacaoESocial BOOLEAN;
  l_layout VARCHAR2(6);
  l_VersaoESocial NUMBER;

BEGIN
	l_alterouValBru	:= FALSE;
	l_alterouValIrf	:= FALSE;	
	l_InfoFacult := TRUE;
  	l_SimplificacaoESocial := FALSE;
	l_VersaoESocial := 0;
	
	IF (:OLD.CALIRF = 'S') OR (:NEW.CALIRF = 'S') THEN
		SP_VALUPDATE_NUM(:OLD.VALBRU, :NEW.VALBRU, l_alterouValBru OUT);
		SP_VALUPDATE_NUM(:OLD.VALIRF, :NEW.VALIRF, l_alterouValIrf OUT);		
		IF ((l_alterouValBru = TRUE) OR (l_alterouValIrf = TRUE)) THEN
			l_CmpDatPag := DATETIME(1,MONTH(:NEW.DATPAG),YEAR(:NEW.DATPAG),0,0,0);
			
  			l_layout := 'S-1200';
			
			SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult, l_SimplificacaoESocial OUT, l_VersaoESocial OUT);
  			IF(l_SimplificacaoESocial = TRUE) THEN
  				l_layout := ''; /* Será ajustado o leiaute ao buscar as pendências na tela de declaração mensal */
  			END IF;
			BEGIN				  						
				SP_R350PEM(:NEW.NUMEMP,0,:NEW.TIPCOL,:NEW.NUMCAD,l_CmpDatPag,1,3,1,l_layout);
			EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'Erro gerar registro de pendência mensal para envio do layout S-1200.';
			END;
		END IF;  					
	END IF;
END␀3Ö␀␀		SENIOR;0´␀␀

TRIGGER R044VAL_ED AFTER DELETE ON R044VAL FOR EACH ROW

DECLARE
l_CmpDatPag DATE;
l_layout VARCHAR2(6);
l_InfoFacult   BOOLEAN;
  l_SimplificacaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  l_InfoFacult := TRUE;
  l_SimplificacaoESocial := FALSE;
  IF (:OLD.CALIRF = 'S') THEN
			l_CmpDatPag := DATETIME(1,MONTH(:OLD.DATPAG),YEAR(:OLD.DATPAG),0,0,0);	
			l_layout := 'S-1200'; 
			l_VersaoESocial := 0;
			SP_ESOCIAL_INFO(:OLD.NUMEMP, l_InfoFacult, l_SimplificacaoESocial OUT, l_VersaoESocial OUT);
  			IF(l_SimplificacaoESocial = TRUE) THEN
  				l_layout := ''; /* Será ajustado o leiaute ao buscar as pendências na tela de declaração mensal */
  			END IF; 
		BEGIN	
			SP_R350PEM(:OLD.NUMEMP,0,:OLD.TIPCOL,:OLD.NUMCAD,l_CmpDatPag,1,3,1,l_layout);
		EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro de pendência mensal para envio do layout S-1200.';
      END;
