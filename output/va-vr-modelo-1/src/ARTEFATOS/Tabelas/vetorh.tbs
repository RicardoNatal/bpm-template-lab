ÕPROCEDURE R069FIS_ATUCON(P_TIPOPE CHAR(1),P_NUMCRA NUMBER(12),P_DATALT DATE,P_HORINI NUMBER(4),P_NUMFIS NUMBER(12),P_OLDFIS NUMBER(12),P_TECCRA NUMBER(1),P_DATFIM DATE,P_HORFIM NUMBER(4))
 IS
BEGIN
  NULL;
END		SENIOR;20§SP_USUTEL
SP_TROCRA
SP_ATULNG
SP_STRTODATE
SP_VEIPESCON
SP_MAPFIS
SP_INTSTR
SP_CMDTSI
SP_CHCTSI
SP_ColCon
SP_VISCON
R070MES_ATUCON
SP_ATUTSI
SP_RETICARD
È‰␀␀PROCEDURE R069FIS_ATUCON(P_TIPOPE CHAR(1),P_NUMCRA NUMBER(12),P_DATALT DATE,P_HORINI NUMBER(4),P_NUMFIS NUMBER(12),P_OLDFIS NUMBER(12),P_TECCRA NUMBER(1),P_DATFIM DATE,P_HORFIM NUMBER(4))
 IS

  l_numfis      NUMBER(12);
  l_numfis_del  NUMBER(12);
  l_usocra      NUMBER(2);
  l_datalt      DATE;
  l_horfis      NUMBER(4);
  l_tipcra      NUMBER(2);
  l_numemp      NUMBER;
  l_tipcol      NUMBER(2);
  l_numcad      NUMBER;
  l_tippes      NUMBER(2);
  l_datini      DATE;
  l_horini      NUMBER(5);
  l_datfim      DATE;
  l_horfim      NUMBER(5);
  l_tipdoc      NUMBER(1);
  l_numdoc      VARCHAR2(20);
  l_codprm      NUMBER(5);
  l_datval      DATE;
  l_horval      NUMBER(5);
  l_bloaut      VARCHAR2(1);
  l_tipvis      NUMBER(3);
  l_andvis      NUMBER(3);
  l_datent      DATE;
  l_horent      NUMBER(5);
  l_seqent      NUMBER(2);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_teccra      NUMBER(1);
  l_tippev      NUMBER(1);
  l_nummat      VARCHAR2(15);
  l_craser      VARCHAR2(10);
  l_icard       VARCHAR2(12);
  l_icardpri    VARCHAR2(12);
  l_numbar      NUMBER(12);
  l_numpro      NUMBER(12);
  l_numsma      NUMBER(12);
  l_crapri      NUMBER(12);
  l_tecpri      NUMBER(1);
  l_chcpri      NUMBER(12);
  l_idtpes      VARCHAR2(23);
  l_datsai      DATE;
  l_horsai      NUMBER(4);
  l_datmin      DATE;
  l_hormin      NUMBER(4);
  l_dataux      VARCHAR2(6);
  l_usutel      VARCHAR(31);
  l_comando     VARCHAR(2048);
  l_numser      VARCHAR(12);
  l_icardA      VARCHAR(12);
  l_icardR      VARCHAR(12);

  CURSOR c_r088con IS
  SELECT DISTINCT IDTPES, SITCRA, DATVAL, PLAVEI
    FROM R088CON
   WHERE CRAVEI = p_numcra
     AND SITCRA = 0; /*BUSCA AS ASSOCIAÇÕES DE PESSOA/VEÍCULO ATIVAS, SITCRA = 0*/
  TYPE t_r088con IS RECORD(
    IDTPES   R088CON.IDTPES%TYPE,
    SITCRA   R088CON.SITCRA%TYPE,
    DATVAL   R088CON.DATVAL%TYPE,
    PLAVEI   R088CON.PLAVEI%TYPE);
  l_r088con t_r088con;

BEGIN
  SP_USUTEL(l_usutel OUT);
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  l_numemp := 0;
  l_tipcol := 0;
  l_numcad := 0;
  l_nummat := '0';
  l_tipdoc := 0;
  l_numdoc := '0';
  l_andvis := NULL;

  /*Apenas para históricos válidos*/
  IF ((p_datfim = l_data_zero) OR ((p_datfim > l_data_atual) OR (p_datfim = l_data_atual AND p_horfim >= l_hora_atual))) THEN

      BEGIN
          /* Busca o ultimo Cracha Físico para realizar a troca. */
          SELECT DATALT, HORINI, NUMFIS, TECCRA INTO l_datalt, l_horfis, l_numfis, l_teccra
          FROM R069FIS A
          WHERE NUMCRA = p_numcra
          AND TECCRA = p_teccra
          AND HORINI = (SELECT MAX(HORINI)
                       FROM R069FIS
                       WHERE NUMCRA = A.NUMCRA AND
                       DATALT = (SELECT MAX(DATALT)
                                 FROM R069FIS
                                 WHERE NUMCRA = A.NUMCRA AND
                                 TECCRA = p_teccra AND
                                 ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini )) AND
                                 DATFIM = l_data_zero
                                 )
                       AND TECCRA = p_teccra AND ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini ))
                       AND DATFIM = l_data_zero
                       )
          AND DATALT = (SELECT MAX(DATALT)
                       FROM R069FIS
                       WHERE NUMCRA = A.NUMCRA AND
                       TECCRA = p_teccra AND
                       ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini ))
                       AND DATFIM = l_data_zero
                       );
      EXCEPTION
          WHEN NO_DATA_FOUND THEN l_datalt := l_data_zero;
                                  l_numfis := 0;
          WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon 2: Erro No SELECT R069fis.';
      END;

      /* se achou algum crachá já cadastrado então apenas altera a controle. */
      IF  l_numfis > 0 THEN
          /*se tiver excluindo atualiza o crachá anterior. */
          l_numfis_del := 0;
          IF   p_tipope = 'D' THEN

              /* se tiver excluindo e a data for maior que a já existente. */
              IF  ((p_datalt > l_datalt) OR (p_datalt = l_datalt AND p_horini > l_horfis)) THEN
                 /* troca um cracha pelo outro na tabela controle. OLD,NEW */
                 SP_TROCRA(p_numfis, l_teccra, l_numfis);
                 /* atualiza o crachá na tabela de lista negra. */
                 SP_ATULNG(p_numfis,7);
                 l_numfis_del := p_numfis;
              END IF;
          ELSE
              /* se tiver incluindo e a data for maior que a já existente. */
              IF  ((p_datalt > l_datalt) OR (p_datalt = l_datalt AND p_horini > l_horfis)) THEN
                   /* atualiza o crachá na tabela de lista negra. */
                   SP_ATULNG(l_numfis,7);
                   /* troca um cracha pelo outro na tabela controle. OLD,NEW */
                   SP_TROCRA(l_numfis, l_teccra, p_numfis);
                   l_numfis_del := l_numfis;
              END IF;
          END IF;

          /*VEÍCULOS: Caso tenha número físico que houve troca, limpa o físico da troca e atualiza a associação*/
          IF (l_numfis_del > 0) THEN
              /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
              FOREACH c_r088con INTO l_r088con.IDTPES,
                                     l_r088con.SITCRA,
                                     l_r088con.DATVAL,
                                     l_r088con.PLAVEI
              LOOP
                  /*IDTPES COM 23 POSIÇÕES*/
                  l_idtpes := LTrim(RTrim(l_r088con.IDTPES));

                  IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                      l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                      l_numdoc := SUBSTRING(l_idtpes,4,20);
                      l_tippes := 4;
                  ELSE
                      l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                      l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                      l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                      l_tippes := l_tipcol;
                  END IF;
                  l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                  SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                  l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                              + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));

                  /*Como esta sendo inserido uma nova técnologia, limpa os registros para esta técnologia*/
                  DELETE
                    FROM R088CON
                   WHERE IDTPES = l_r088con.IDTPES
                     AND CRAVEI = p_numcra
                     AND TECCRA = p_teccra
                     AND NUMFIS = l_numfis_del;
                  /*atualiza a associação entre pessoa e veículo*/
                  SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                               , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
              END LOOP;
          END IF;
          /*FIM VEÍCULOS*/

      ELSE
          /* se nao estiver excluindo atualiza o novo crachá. */
          IF  p_tipope <> 'D' THEN
              /* Se não tiver nenhum entao inclui novo crachá na controle */
              BEGIN
                  SELECT USOCRA INTO l_usocra FROM R069CRA WHERE NUMCRA = p_numcra;
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon - TOO MANY ROWS';
                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R069cra.';
              END;

              /*Verifica se o crachá incluído é principal*/
              /*Obtem o Crachá Principal Atual*/
              SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
              IF (l_crapri = 0) THEN
                  l_crapri := p_numcra;
              END IF;

              SP_RETICARD(NULL, l_crapri, l_icardA OUT , l_icardR OUT, l_numser OUT);

              BEGIN
                  /*Se o colaborador não possuia número físico, então efetua o update para o primeiro */
                  SP_INTSTR(p_numfis, '999999999999',l_icardpri OUT);
                  SP_INTSTR(p_numcra, '999999999999',l_icard OUT);

                  IF (l_tecpri = 3 AND l_numpro = 0 AND l_numbar = 0) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;
                  ELSIF (l_tecpri = 2 AND l_numbar = 0) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;
                      l_comando := 'DELETE '||l_usutel||'CONTROLE WHERE ICARD = '''||l_icardpri||'''';
                      SP_CMDTSI(l_comando);

                      l_comando := 'UPDATE '||l_usutel||'CONTROLE SET ICARD = '''||l_icardpri||''' WHERE ICARD = '''||l_icard||'''';
                      SP_CMDTSI(l_comando);
                  ELSIF (l_tecpri = 1 AND p_teccra = 1) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;
                      l_comando := 'DELETE '||l_usutel||'CONTROLE WHERE ICARD = '''||l_icardpri||'''';
                      SP_CMDTSI(l_comando);

                      l_comando := 'UPDATE '||l_usutel||'CONTROLE SET ICARD = '''||l_icardpri||''' WHERE ICARD = '''||l_icard||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
              EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'R069FIS_ATUCON: Problema ao efetuar a troca do crachá principal.';
              END;

              /*Efetuar a Troca dos Crachás na Pend_Grupo*/
              /*Obtem o Crachá Principal antigo*/
              /*Se o crachá a ser incluído é barras, verifica se tem proximidade, caso contrário o crachá antigo*/
              /*é a matrícula*/
              IF (p_teccra = 1) THEN
                  IF (l_numpro <> 0) THEN
                      SP_CHCTSI(2, l_crapri, l_numpro, 0, 0);
                  ELSE
                      SP_CHCTSI(2, l_crapri, p_numcra, 0, 0);
                  END IF;
              ELSIF (p_teccra = 2) THEN
                  /*Se o crachá inserido é Tecnologia 2 então verifica se já não existe tecnologia 1 */
                  /*Se se não existe efetua a troca de icard Pend_Grupo*/
                  IF (l_tecpri = 2) THEN
                      SP_CHCTSI(2, l_crapri, p_numcra, 0, 0);
                  END IF;
              ELSIF (p_teccra = 3) THEN
                  SP_CHCTSI(3, l_icardA, 0, p_numfis, 0);
              END IF;



              IF    (l_usocra = 1)
              OR    (l_usocra = 2)
              OR    (l_usocra = 3)
              OR    (l_usocra = 5)
              OR    (l_usocra = 6)
              OR    (l_usocra = 12)
              OR    (l_usocra = 14)
              OR    (l_usocra = 15) THEN /* colaborador */

                    /* procura pelo histórico do colaborador. */
                    IF   (l_usocra = 5) THEN
                         l_tipcol := 5;
                         BEGIN
                              SELECT TIPCRA,NUMEMP,NUMCAD,DATINI,HORINI,DATFIM,HORFIM
                              INTO l_tipcra,l_numemp,l_numcad,l_datini,l_horini,l_datfim,l_horfim
                              FROM R070HCH
                              WHERE (NUMCRA = p_numcra) AND
                                    ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                    (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                    (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R070Hch - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R070HCH.';
                         END;
                    ELSE
                        /* alunos */
                        IF   (l_usocra = 14) THEN
                             l_tipcol := 6;
                             BEGIN
                                  SELECT TIPCRA,NUMMAT,DATINI,HORINI,DATFIM,HORFIM
                                  INTO l_tipcra,l_nummat,l_datini,l_horini,l_datfim,l_horfim
                                  FROM R073HCH
                                  WHERE (NUMCRA = p_numcra) AND
                                        ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                        (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                        (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                             EXCEPTION
                                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R073Hch - TOO MANY ROWS';
                                  WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R073HCH.';
                             END;
                        ELSE
                             /* Rsponsável de alunos */
                             IF   (l_usocra = 15) THEN
                                  l_tipcol := 7;
                                  BEGIN
                                       SELECT TIPCRA,TIPDOC,NUMDOC,DATINI,HORINI,DATFIM,HORFIM
                                       INTO l_tipcra,l_tipdoc,l_numdoc,l_datini,l_horini,l_datfim,l_horfim
                                       FROM R073HCR
                                       WHERE (NUMCRA = p_numcra) AND
                                             ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                             (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                             (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                                  EXCEPTION
                                       WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R073HCR - TOO MANY ROWS';
                                       WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                       WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R073HCR.';
                                  END;
                             ELSE
                                BEGIN
                                     SELECT TIPCRA,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,DATFIM,HORFIM
                                     INTO l_tipcra,l_numemp,l_tipcol,l_numcad,l_datini,l_horini,l_datfim,l_horfim
                                     FROM R038HCH
                                     WHERE (NUMCRA = p_numcra) AND
                                           ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                           (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                           (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                                EXCEPTION
                                     WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R038Hch - TOO MANY ROWS';
                                     WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                     WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R038HCH.';
                                END;
                            END IF;
                        END IF;
                    END IF;
                    /* se encontrou histórico aberto então atualiza a tabela controle */
                    IF  l_tipcra <> 0 THEN
                        /*Atualiza Tabela Controle. */
                        SP_ColCon ('U', l_tipcra,
                                        l_numemp,
                                        l_tipcol,
                                        l_numcad,
                                        l_tipdoc,
                                        l_numdoc,
                                        l_nummat,
                                        l_datini,
                                        l_horini,
                                        p_numcra,
                                        l_datfim,
                                        l_horfim,
                                        p_numcra,
                                        1,1,1);
                    END IF;
              ELSIF (l_usocra = 4)
              OR    (l_usocra = 7) THEN
                    IF   (l_usocra = 4) THEN
                         /* procura pelo histórico do colaborador. */
                         BEGIN
                              SELECT TIPDOC,NUMDOC,CODPRM,TIPVIS,DATENT,HORENT,DATVAL,HORVAL,ANDVIS
                              INTO l_tipdoc,l_numdoc,l_codprm,l_tipvis,l_datent,l_horent,l_datval,l_horval,l_andvis
                              FROM R090MVI
                              WHERE (NUMCRA = p_numcra) AND (DATSAI = l_data_zero);
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090MVI - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_tipdoc := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090MVI.';
                         END;
                    ELSE
                         /* procura pelo histórico do colaborador. */
                         BEGIN
                              SELECT DATENT,HORENT,SEQENT,TIPDOC,NUMDOC
                              INTO l_datent,l_horent,l_seqent,l_tipdoc,l_numdoc
                              FROM R090HCG
                              WHERE (NUMCRA = p_numcra) AND (DATSAI = l_data_zero);
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090HCG - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_seqent := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090HCG.';
                         END;

                         IF   l_seqent <> 0 THEN
                              BEGIN
                                   SELECT CODPRM,TIPVIS,DATVAL,HORVAL
                                   INTO l_codprm,l_tipvis,l_datval,l_horval
                                   FROM R090MGV
                                   WHERE DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
                              EXCEPTION
                                   WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090MGV - TOO MANY ROWS';
                                   WHEN NO_DATA_FOUND THEN NULL;
                                   WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090MGV.';
                              END;
                         END IF;
                    END IF;
                    /* se encontrou histórico aberto então atualiza a tabela controle */
                    IF  l_tipdoc <> 0 THEN
                        BEGIN
                           SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI
                           WHERE TIPVIS = l_tipvis;
                        EXCEPTION WHEN OTHERS THEN
                           l_bloaut := 'N';
                           l_tippev := 1;
                        END;

                        IF   l_bloaut =  'S' THEN
                             l_bloaut := '1';
                        ELSE l_bloaut := '0';
                        END IF;
                        /* Atualiza Tabela Controle. */
                        SP_VISCON (l_tipdoc,
                                   l_numdoc,
                                   p_numcra,
                                   l_codprm,
                                   l_datent,
                                   l_horent,
                                   l_datval,
                                   l_horval,
                                   l_bloaut,
                                   l_tippev,
                                   l_tipvis,0,0,0,1,1,
                                   l_andvis);
                    END IF;
              ELSIF (l_usocra = 8) THEN  /*veiculos*/
                  /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
                  FOREACH c_r088con INTO l_r088con.IDTPES,
                                         l_r088con.SITCRA,
                                         l_r088con.DATVAL,
                                         l_r088con.PLAVEI
                  LOOP
                      /*IDTPES COM 23 POSIÇÕES*/
                      l_idtpes := LTrim(RTrim(l_r088con.IDTPES));

                      IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                          l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                          l_numdoc := SUBSTRING(l_idtpes,4,20);
                          l_tippes := 4;
                      ELSE
                          l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                          l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                          l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                          l_tippes := l_tipcol;
                      END IF;
                      l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                      SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                      l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                                  + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));
                      /*atualiza a associação entre pessoa e veículo*/
                      SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                                 , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
                  END LOOP;
              ELSIF (l_usocra = 9) THEN  /*autorizacao de entrada*/
                  BEGIN
                      SELECT NUMEMP, TIPCOL, NUMCAD, CODPRM, DATENT, HORENT, DATVAL, HORVAL, DATSAI, HORSAI
                      INTO l_numemp, l_tipcol, l_numcad, l_codprm, l_datent, l_horent, l_datval, l_horval, l_datsai, l_horsai
                      FROM R071AEN
                      WHERE NUMCRA = p_numcra AND
                      (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                      (
                      (DATSAI > l_data_atual OR DATSAI = l_data_zero OR (DATSAI = l_data_atual AND HORSAI >= l_hora_atual))
                      AND
                      (DATVAL > l_data_atual OR DATVAL = l_data_zero OR (DATVAL = l_data_atual AND HORVAL >= l_hora_atual))
                      );
                  EXCEPTION
                    WHEN OTHERS THEN
                      l_numcad := 0;
                  END;

                  IF (l_numcad > 0) THEN

                      /*Verifica a menor entre as datas datval e datsai*/
                      IF (l_datsai = l_data_zero) THEN
                          l_datsai := '31/12/2050,00:00:00';
                      END IF;

                      IF (l_datval = l_data_zero) THEN
                          l_datval := '31/12/2050,00:00:00';
                      END IF;


                      IF (l_datval <> l_datsai) THEN
                          IF (l_datval < l_datsai) THEN
                              l_datmin := l_datval;
                              l_hormin := l_horval;
                          ELSE
                              l_datmin := l_datsai;
                              l_hormin := l_horsai;
                          END IF;
                      /*Data igual, verifica a hora*/
                      ELSE
                          IF (l_horval < l_horsai) THEN
                              l_datmin := l_datval;
                              l_hormin := l_horval;
                          ELSE
                              l_datmin := l_datsai;
                              l_hormin := l_horsai;
                          END IF;
                      END IF;

                      SP_VISCON (0,
                                 '',
                                 p_numcra,
                                 l_codprm,
                                 l_datent,
                                 l_horent,
                                 l_datmin,
                                 l_hormin,
                                 '0',
                                 8,
                                 0,
                                 l_numemp,
                                 l_tipcol,
                                 l_numcad,
                                 1,
                                 1,
                                 l_andvis);
                  END IF;

              ELSIF (l_usocra = 10) THEN
                    BEGIN
                         SELECT DATFIM,HORFIM,NUMEMP,TIPCOL,NUMCAD INTO l_datfim,l_horfim,l_numemp,l_tipcol,l_numcad
                         FROM R070MES
                         WHERE (NUMCRA = p_numcra) AND
                               ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                               (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                               (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                    EXCEPTION
                         WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R070MES - TOO MANY ROWS';
                         WHEN NO_DATA_FOUND THEN l_datfim := '31/12/1900,00:00:00';
                                                 l_horfim := 0;
                                                 l_numemp := 0;
                                                 l_tipcol := 0;
                                                 l_numcad := 0;
                         WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R070MES.';
                    END;
                    R070MES_ATUCON('I',p_numcra,l_datfim,l_horfim,l_numemp,l_tipcol,l_numcad);
              END IF;
          ELSE
              /*Situação de DELETE, e não existe outro número físico de mesma tecnologia para substituir o atual*/

              BEGIN
                  SELECT USOCRA INTO l_usocra FROM R069CRA WHERE NUMCRA = p_numcra;
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon - TOO MANY ROWS 02';
                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R069cra. 02';
              END;

              IF (l_usocra = 8) THEN
                  /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
                  FOREACH c_r088con INTO l_r088con.IDTPES,
                                         l_r088con.SITCRA,
                                         l_r088con.DATVAL,
                                         l_r088con.PLAVEI
                  LOOP
                      /*IDTPES COM 23 POSIÇÕES*/
                      l_idtpes := LTrim(RTrim(l_r088con.IDTPES));

                      IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                          l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                          l_numdoc := SUBSTRING(l_idtpes,4,20);
                          l_tippes := 4;
                      ELSE
                          l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                          l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                          l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                          l_tippes := l_tipcol;
                      END IF;
                      l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                      SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                      l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                                  + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));
                      /*DELETA ESTA TÉCNOLOGIA DE CRACHÁ E NÚMERO FÍSICO PARA A PESSOA*/
                      BEGIN
                          DELETE FROM R088CON WHERE IDTPES = l_r088con.IDTPES AND NUMFIS = p_numfis AND TECCRA = p_teccra;
                      EXCEPTION
                          WHEN OTHERS THEN
                              RAISERROR 103 'R069FIS_AtuCon: Erro ao deletar r088con.';
                      END;
                      /*atualiza a associação entre pessoa e veículo*/
                      SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                                 , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
                  END LOOP;
              END IF;

              /*Verifica se o crachá deletado é principal*/
              BEGIN
                  SELECT IDTPES, CHCPRI INTO l_idtpes, l_chcpri FROM R070CON WHERE NUMFIS = p_numfis;
              EXCEPTION
                WHEN OTHERS THEN
                  l_chcpri := -1;
              END;
               /*Obtem o Crachá Principal Atual*/
              SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
              /*Efetuar a Troca dos Crachás*/
              IF (l_crapri = 0) THEN
                  l_crapri := p_numcra;
                  l_tecpri := 1;
              END IF;

              SP_RETICARD(NULL, l_crapri, l_icardA OUT, l_icardR OUT, l_numser OUT);

              /*Se o Crachá Excluído é diferente do principal, então exclui */
              IF (l_chcpri > 0) THEN
                  /*Deleta na Controle para evitar Violação de Chave*/
                  BEGIN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                  EXCEPTION
                      WHEN OTHERS THEN RAISERROR 103 'TR069FIS_ATUCON 3: Problemas ao Excluir o Crachá da Tabela R070CON.';
                  END;

                  /*Tratamento Controle*/
                  /*Verifica se o crachá (secundário) é smart*/
                  BEGIN
                      IF (p_teccra <> 3) THEN
                          SP_INTSTR(p_numfis, '999999999999',l_icard OUT);
                          /*Deleta o Crachá da Controle*/
                          l_comando := 'DELETE '||l_usutel||'CONTROLE WHERE ICARD = '''||l_icard||'''';
                          SP_CMDTSI(l_comando);
                          /*Atualiza demais tabelas telemática*/
                          SP_CHCTSI(5, l_icard, 0, 0, 0);
                      END IF;
                  EXCEPTION
                      WHEN OTHERS THEN RAISERROR 103 'TR069FIS_ATUCON 3: Problemas ao Excluir o Crachá da Tabela Controle.';
                  END;

              ELSE
                  /*Se o Crachá Excluído é o principal*/
                  IF (l_chcpri = 0) AND (l_crapri <> p_numfis) AND (p_teccra <> 1) THEN
                      /*Deleta na R070CON para evitar Violação de Chave*/
                      BEGIN
                          DELETE FROM R070CON WHERE NUMFIS = l_crapri;
                      EXCEPTION
                          WHEN OTHERS THEN RAISERROR 103 'TR069FIS_ATUCON 4: Problemas ao Excluir o Crachá da Tabela R070CON.';
                      END;
                      /*Efetua o UPDATE para o Novo crachá Principal*/
                      UPDATE R070CON SET NUMFIS = l_crapri, TECCRA = l_tecpri WHERE NUMFIS = p_numfis;

                      /*Efetua o Mesmo procedimento anterior para a Controle*/
                      /*Tecnologia diferente de smart OU tinha número físico diferente de barras e foi deletado*/
                      IF (p_teccra <> 3 OR (p_teccra <> l_tecpri AND l_tecpri = 1)) THEN
                          SP_INTSTR(l_icardA, '999999999999',l_icardpri OUT);
                          SP_INTSTR(p_numfis, '999999999999',l_icard OUT);
                          /*Deleta o Crachá da Controle*/
                          l_comando := 'DELETE '||l_usutel||'CONTROLE WHERE ICARD = '''||l_icard||'''';
                          SP_CMDTSI(l_comando);
                          /*Efetua o UPDATE para o Novo crachá Principal*/
                          l_comando := 'UPDATE '||l_usutel||'CONTROLE SET ICARD = '''||l_icardpri||''' WHERE ICARD = '''||l_icard||'''';
                          SP_CMDTSI(l_comando);
                          /*Atualiza a Pend_Grupo / Icard*/
                          /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
                          IF (l_tecpri = 3) THEN
                              SP_CHCTSI(2, l_icardA, p_numfis, 0, 0);
                          END IF;
                      END IF;
                      /*Atualiza os demais crachás para apontar para o novo principal*/
                      /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
                      IF (l_tecpri = 1) THEN
                          /*Atualiza o crachá de proximidade*/
                          IF (l_numpro <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numpro;
                          END IF;
                          /*Atualiza o crachá Smart*/
                          IF (l_numsma <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numsma;
                          END IF;
                      /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
                      ELSIF (l_tecpri = 2) THEN
                          /*Atualiza o crachá Smart*/
                          IF (l_numsma <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numsma;
                          END IF;
                      END IF;
                  END IF;
              END IF;
              /*Procedure que atualiza a controle*/
              SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);
          END IF;
      END IF;
  END IF;
END		SENIOR;23§SP_USUTEL
SP_TROCRA
SP_ATULNG
SP_STRTODATE
SP_VEIPESCON
SP_MAPFIS
SP_INTSTR
SP_CMDTSI
SP_CHCTSI
SP_ColCon
SP_VISCON
R070MES_ATUCON
SP_ATUTSI
SP_RETICARD
È‰␀␀PROCEDURE R069FIS_ATUCON(P_TIPOPE CHAR(1),P_NUMCRA NUMBER(12),P_DATALT DATE,P_HORINI NUMBER(4),P_NUMFIS NUMBER(12),P_OLDFIS NUMBER(12),P_TECCRA NUMBER(1),P_DATFIM DATE,P_HORFIM NUMBER(4))
 IS

  l_numfis      NUMBER(12);
  l_numfis_del  NUMBER(12);
  l_usocra      NUMBER(2);
  l_datalt      DATE;
  l_horfis      NUMBER(4);
  l_tipcra      NUMBER(2);
  l_numemp      NUMBER;
  l_tipcol      NUMBER(2);
  l_numcad      NUMBER;
  l_tippes      NUMBER(2);
  l_datini      DATE;
  l_horini      NUMBER(5);
  l_datfim      DATE;
  l_horfim      NUMBER(5);
  l_tipdoc      NUMBER(1);
  l_numdoc      VARCHAR2(20);
  l_codprm      NUMBER(5);
  l_datval      DATE;
  l_horval      NUMBER(5);
  l_bloaut      VARCHAR2(1);
  l_tipvis      NUMBER(3);
  l_andvis      NUMBER(3);
  l_datent      DATE;
  l_horent      NUMBER(5);
  l_seqent      NUMBER(2);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_teccra      NUMBER(1);
  l_tippev      NUMBER(1);
  l_nummat      VARCHAR2(15);
  l_craser      VARCHAR2(10);
  l_icard       VARCHAR2(12);
  l_icardpri    VARCHAR2(12);
  l_numbar      NUMBER(12);
  l_numpro      NUMBER(12);
  l_numsma      NUMBER(12);
  l_crapri      NUMBER(12);
  l_tecpri      NUMBER(1);
  l_chcpri      NUMBER(12);
  l_idtpes      VARCHAR2(23);
  l_datsai      DATE;
  l_horsai      NUMBER(4);
  l_datmin      DATE;
  l_hormin      NUMBER(4);
  l_dataux      VARCHAR2(6);
  l_usutel      VARCHAR(31);
  l_comando     VARCHAR(2048);
  l_numser      VARCHAR(12);
  l_icardA      VARCHAR(12);
  l_icardR      VARCHAR(12);

  CURSOR c_r088con IS
  SELECT DISTINCT IDTPES, SITCRA, DATVAL, PLAVEI
    FROM R088CON
   WHERE CRAVEI = p_numcra
     AND SITCRA = 0; /*BUSCA AS ASSOCIAÇÕES DE PESSOA/VEÍCULO ATIVAS, SITCRA = 0*/
  TYPE t_r088con IS RECORD(
    IDTPES   R088CON.IDTPES%TYPE,
    SITCRA   R088CON.SITCRA%TYPE,
    DATVAL   R088CON.DATVAL%TYPE,
    PLAVEI   R088CON.PLAVEI%TYPE);
  l_r088con t_r088con;

BEGIN
  SP_USUTEL(l_usutel OUT);
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  l_numemp := 0;
  l_tipcol := 0;
  l_numcad := 0;
  l_nummat := '0';
  l_tipdoc := 0;
  l_numdoc := '0';
  l_andvis := NULL;

  /*Apenas para históricos válidos*/
  IF ((p_datfim = l_data_zero) OR ((p_datfim > l_data_atual) OR (p_datfim = l_data_atual AND p_horfim >= l_hora_atual))) THEN

      BEGIN
          /* Busca o ultimo Cracha Físico para realizar a troca. */
          SELECT DATALT, HORINI, NUMFIS, TECCRA INTO l_datalt, l_horfis, l_numfis, l_teccra
          FROM R069FIS A
          WHERE NUMCRA = p_numcra
          AND TECCRA = p_teccra
          AND HORINI = (SELECT MAX(HORINI)
                       FROM R069FIS
                       WHERE NUMCRA = A.NUMCRA AND
                       DATALT = (SELECT MAX(DATALT)
                                 FROM R069FIS
                                 WHERE NUMCRA = A.NUMCRA AND
                                 TECCRA = p_teccra AND
                                 ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini )) AND
                                 DATFIM = l_data_zero
                                 )
                       AND TECCRA = p_teccra AND ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini ))
                       AND DATFIM = l_data_zero
                       )
          AND DATALT = (SELECT MAX(DATALT)
                       FROM R069FIS
                       WHERE NUMCRA = A.NUMCRA AND
                       TECCRA = p_teccra AND
                       ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini ))
                       AND DATFIM = l_data_zero
                       );
      EXCEPTION
          WHEN NO_DATA_FOUND THEN l_datalt := l_data_zero;
                                  l_numfis := 0;
          WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon 2: Erro No SELECT R069fis.';
      END;

      /* se achou algum crachá já cadastrado então apenas altera a controle. */
      IF  l_numfis > 0 THEN
          /*se tiver excluindo atualiza o crachá anterior. */
          l_numfis_del := 0;
          IF   p_tipope = 'D' THEN

              /* se tiver excluindo e a data for maior que a já existente. */
              IF  ((p_datalt > l_datalt) OR (p_datalt = l_datalt AND p_horini > l_horfis)) THEN
                 /* troca um cracha pelo outro na tabela controle. OLD,NEW */
                 SP_TROCRA(p_numfis, l_teccra, l_numfis);
                 /* atualiza o crachá na tabela de lista negra. */
                 SP_ATULNG(p_numfis,7);
                 l_numfis_del := p_numfis;
              END IF;
          ELSE
              /* se tiver incluindo e a data for maior que a já existente. */
              IF  ((p_datalt > l_datalt) OR (p_datalt = l_datalt AND p_horini > l_horfis)) THEN
                   /* atualiza o crachá na tabela de lista negra. */
                   SP_ATULNG(l_numfis,7);
                   /* troca um cracha pelo outro na tabela controle. OLD,NEW */
                   SP_TROCRA(l_numfis, l_teccra, p_numfis);
                   l_numfis_del := l_numfis;
              END IF;
          END IF;

          /*VEÍCULOS: Caso tenha número físico que houve troca, limpa o físico da troca e atualiza a associação*/
          IF (l_numfis_del > 0) THEN
              /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
              FOREACH c_r088con INTO l_r088con.IDTPES,
                                     l_r088con.SITCRA,
                                     l_r088con.DATVAL,
                                     l_r088con.PLAVEI
              LOOP
                  /*IDTPES COM 23 POSIÇÕES*/
                  l_idtpes := LTrim(RTrim(l_r088con.IDTPES));

                  IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                      l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                      l_numdoc := SUBSTRING(l_idtpes,4,20);
                      l_tippes := 4;
                  ELSE
                      l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                      l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                      l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                      l_tippes := l_tipcol;
                  END IF;
                  l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                  SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                  l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                              + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));

                  /*Como esta sendo inserido uma nova técnologia, limpa os registros para esta técnologia*/
                  DELETE
                    FROM R088CON
                   WHERE IDTPES = l_r088con.IDTPES
                     AND CRAVEI = p_numcra
                     AND TECCRA = p_teccra
                     AND NUMFIS = l_numfis_del;
                  /*atualiza a associação entre pessoa e veículo*/
                  SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                               , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
              END LOOP;
          END IF;
          /*FIM VEÍCULOS*/

      ELSE
          /* se nao estiver excluindo atualiza o novo crachá. */
          IF  p_tipope <> 'D' THEN
              /* Se não tiver nenhum entao inclui novo crachá na controle */
              BEGIN
                  SELECT USOCRA INTO l_usocra FROM R069CRA WHERE NUMCRA = p_numcra;
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon - TOO MANY ROWS';
                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R069cra.';
              END;

              /*Verifica se o crachá incluído é principal*/
              /*Obtem o Crachá Principal Atual*/
              SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
              IF (l_crapri = 0) THEN
                  l_crapri := p_numcra;
              END IF;

              SP_RETICARD(NULL, l_crapri, l_icardA OUT , l_icardR OUT, l_numser OUT);

              BEGIN
                  /*Se o colaborador não possuia número físico, então efetua o update para o primeiro */
                  SP_INTSTR(p_numfis, '999999999999',l_icardpri OUT);
                  SP_INTSTR(p_numcra, '999999999999',l_icard OUT);

                  IF (l_tecpri = 3 AND l_numpro = 0 AND l_numbar = 0) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;
                  ELSIF (l_tecpri = 2 AND l_numbar = 0) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;
                      l_comando := 'DELETE '||l_usutel||'CONTROLE WHERE ICARD = '''||l_icardpri||'''';
                      SP_CMDTSI(l_comando);

                      l_comando := 'UPDATE '||l_usutel||'CONTROLE SET ICARD = '''||l_icardpri||''' WHERE ICARD = '''||l_icard||'''';
                      SP_CMDTSI(l_comando);
                  ELSIF (l_tecpri = 1 AND p_teccra = 1) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;
                      l_comando := 'DELETE '||l_usutel||'CONTROLE WHERE ICARD = '''||l_icardpri||'''';
                      SP_CMDTSI(l_comando);

                      l_comando := 'UPDATE '||l_usutel||'CONTROLE SET ICARD = '''||l_icardpri||''' WHERE ICARD = '''||l_icard||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
              EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'R069FIS_ATUCON: Problema ao efetuar a troca do crachá principal.';
              END;

              /*Efetuar a Troca dos Crachás na Pend_Grupo*/
              /*Obtem o Crachá Principal antigo*/
              /*Se o crachá a ser incluído é barras, verifica se tem proximidade, caso contrário o crachá antigo*/
              /*é a matrícula*/
              IF (p_teccra = 1) THEN
                  IF (l_numpro <> 0) THEN
                      SP_CHCTSI(2, l_crapri, l_numpro, 0, 0);
                  ELSE
                      SP_CHCTSI(2, l_crapri, p_numcra, 0, 0);
                  END IF;
              ELSIF (p_teccra = 2) THEN
                  /*Se o crachá inserido é Tecnologia 2 então verifica se já não existe tecnologia 1 */
                  /*Se se não existe efetua a troca de icard Pend_Grupo*/
                  IF (l_tecpri = 2) THEN
                      SP_CHCTSI(2, l_crapri, p_numcra, 0, 0);
                  END IF;
              ELSIF (p_teccra = 3) THEN
                  SP_CHCTSI(3, l_icardA, 0, p_numfis, 0);
              END IF;



              IF    (l_usocra = 1)
              OR    (l_usocra = 2)
              OR    (l_usocra = 3)
              OR    (l_usocra = 5)
              OR    (l_usocra = 6)
              OR    (l_usocra = 12)
              OR    (l_usocra = 14)
              OR    (l_usocra = 15) THEN /* colaborador */

                    /* procura pelo histórico do colaborador. */
                    IF   (l_usocra = 5) THEN
                         l_tipcol := 5;
                         BEGIN
                              SELECT TIPCRA,NUMEMP,NUMCAD,DATINI,HORINI,DATFIM,HORFIM
                              INTO l_tipcra,l_numemp,l_numcad,l_datini,l_horini,l_datfim,l_horfim
                              FROM R070HCH
                              WHERE (NUMCRA = p_numcra) AND
                                    ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                    (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                    (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R070Hch - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R070HCH.';
                         END;
                    ELSE
                        /* alunos */
                        IF   (l_usocra = 14) THEN
                             l_tipcol := 6;
                             BEGIN
                                  SELECT TIPCRA,NUMMAT,DATINI,HORINI,DATFIM,HORFIM
                                  INTO l_tipcra,l_nummat,l_datini,l_horini,l_datfim,l_horfim
                                  FROM R073HCH
                                  WHERE (NUMCRA = p_numcra) AND
                                        ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                        (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                        (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                             EXCEPTION
                                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R073Hch - TOO MANY ROWS';
                                  WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R073HCH.';
                             END;
                        ELSE
                             /* Rsponsável de alunos */
                             IF   (l_usocra = 15) THEN
                                  l_tipcol := 7;
                                  BEGIN
                                       SELECT TIPCRA,TIPDOC,NUMDOC,DATINI,HORINI,DATFIM,HORFIM
                                       INTO l_tipcra,l_tipdoc,l_numdoc,l_datini,l_horini,l_datfim,l_horfim
                                       FROM R073HCR
                                       WHERE (NUMCRA = p_numcra) AND
                                             ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                             (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                             (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                                  EXCEPTION
                                       WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R073HCR - TOO MANY ROWS';
                                       WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                       WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R073HCR.';
                                  END;
                             ELSE
                                BEGIN
                                     SELECT TIPCRA,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,DATFIM,HORFIM
                                     INTO l_tipcra,l_numemp,l_tipcol,l_numcad,l_datini,l_horini,l_datfim,l_horfim
                                     FROM R038HCH
                                     WHERE (NUMCRA = p_numcra) AND
                                           ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                           (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                           (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                                EXCEPTION
                                     WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R038Hch - TOO MANY ROWS';
                                     WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                     WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R038HCH.';
                                END;
                            END IF;
                        END IF;
                    END IF;
                    /* se encontrou histórico aberto então atualiza a tabela controle */
                    IF  l_tipcra <> 0 THEN
                        /*Atualiza Tabela Controle. */
                        SP_ColCon ('U', l_tipcra,
                                        l_numemp,
                                        l_tipcol,
                                        l_numcad,
                                        l_tipdoc,
                                        l_numdoc,
                                        l_nummat,
                                        l_datini,
                                        l_horini,
                                        p_numcra,
                                        l_datfim,
                                        l_horfim,
                                        p_numcra,
                                        1,1,1);
                    END IF;
              ELSIF (l_usocra = 4)
              OR    (l_usocra = 7) THEN
                    IF   (l_usocra = 4) THEN
                         /* procura pelo histórico do colaborador. */
                         BEGIN
                              SELECT TIPDOC,NUMDOC,CODPRM,TIPVIS,DATENT,HORENT,DATVAL,HORVAL,ANDVIS
                              INTO l_tipdoc,l_numdoc,l_codprm,l_tipvis,l_datent,l_horent,l_datval,l_horval,l_andvis
                              FROM R090MVI
                              WHERE (NUMCRA = p_numcra) AND (DATSAI = l_data_zero);
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090MVI - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_tipdoc := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090MVI.';
                         END;
                    ELSE
                         /* procura pelo histórico do colaborador. */
                         BEGIN
                              SELECT DATENT,HORENT,SEQENT,TIPDOC,NUMDOC
                              INTO l_datent,l_horent,l_seqent,l_tipdoc,l_numdoc
                              FROM R090HCG
                              WHERE (NUMCRA = p_numcra) AND (DATSAI = l_data_zero);
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090HCG - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_seqent := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090HCG.';
                         END;

                         IF   l_seqent <> 0 THEN
                              BEGIN
                                   SELECT CODPRM,TIPVIS,DATVAL,HORVAL
                                   INTO l_codprm,l_tipvis,l_datval,l_horval
                                   FROM R090MGV
                                   WHERE DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
                              EXCEPTION
                                   WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090MGV - TOO MANY ROWS';
                                   WHEN NO_DATA_FOUND THEN NULL;
                                   WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090MGV.';
                              END;
                         END IF;
                    END IF;
                    /* se encontrou histórico aberto então atualiza a tabela controle */
                    IF  l_tipdoc <> 0 THEN
                        BEGIN
                           SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI
                           WHERE TIPVIS = l_tipvis;
                        EXCEPTION WHEN OTHERS THEN
                           l_bloaut := 'N';
                           l_tippev := 1;
                        END;

                        IF   l_bloaut =  'S' THEN
                             l_bloaut := '1';
                        ELSE l_bloaut := '0';
                        END IF;
                        /* Atualiza Tabela Controle. */
                        SP_VISCON (l_tipdoc,
                                   l_numdoc,
                                   p_numcra,
                                   l_codprm,
                                   l_datent,
                                   l_horent,
                                   l_datval,
                                   l_horval,
                                   l_bloaut,
                                   l_tippev,
                                   l_tipvis,0,0,0,1,1,
                                   l_andvis);
                    END IF;
              ELSIF (l_usocra = 8) THEN  /*veiculos*/
                  /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
                  FOREACH c_r088con INTO l_r088con.IDTPES,
                                         l_r088con.SITCRA,
                                         l_r088con.DATVAL,
                                         l_r088con.PLAVEI
                  LOOP
                      /*IDTPES COM 23 POSIÇÕES*/
                      l_idtpes := LTrim(RTrim(l_r088con.IDTPES));

                      IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                          l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                          l_numdoc := SUBSTRING(l_idtpes,4,20);
                          l_tippes := 4;
                      ELSE
                          l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                          l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                          l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                          l_tippes := l_tipcol;
                      END IF;
                      l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                      SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                      l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                                  + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));
                      /*atualiza a associação entre pessoa e veículo*/
                      SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                                 , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
                  END LOOP;
              ELSIF (l_usocra = 9) THEN  /*autorizacao de entrada*/
                  BEGIN
                      SELECT NUMEMP, TIPCOL, NUMCAD, CODPRM, DATENT, HORENT, DATVAL, HORVAL, DATSAI, HORSAI
                      INTO l_numemp, l_tipcol, l_numcad, l_codprm, l_datent, l_horent, l_datval, l_horval, l_datsai, l_horsai
                      FROM R071AEN
                      WHERE NUMCRA = p_numcra AND
                      (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                      (
                      (DATSAI > l_data_atual OR DATSAI = l_data_zero OR (DATSAI = l_data_atual AND HORSAI >= l_hora_atual))
                      AND
                      (DATVAL > l_data_atual OR DATVAL = l_data_zero OR (DATVAL = l_data_atual AND HORVAL >= l_hora_atual))
                      );
                  EXCEPTION
                    WHEN OTHERS THEN
                      l_numcad := 0;
                  END;

                  IF (l_numcad > 0) THEN

                      /*Verifica a menor entre as datas datval e datsai*/
                      IF (l_datsai = l_data_zero) THEN
                          l_datsai := '31/12/2050,00:00:00';
                      END IF;

                      IF (l_datval = l_data_zero) THEN
                          l_datval := '31/12/2050,00:00:00';
                      END IF;


                      IF (l_datval <> l_datsai) THEN
                          IF (l_datval < l_datsai) THEN
                              l_datmin := l_datval;
                              l_hormin := l_horval;
                          ELSE
                              l_datmin := l_datsai;
                              l_hormin := l_horsai;
                          END IF;
                      /*Data igual, verifica a hora*/
                      ELSE
                          IF (l_horval < l_horsai) THEN
                              l_datmin := l_datval;
                              l_hormin := l_horval;
                          ELSE
                              l_datmin := l_datsai;
                              l_hormin := l_horsai;
                          END IF;
                      END IF;

                      SP_VISCON (0,
                                 '',
                                 p_numcra,
                                 l_codprm,
                                 l_datent,
                                 l_horent,
                                 l_datmin,
                                 l_hormin,
                                 '0',
                                 8,
                                 0,
                                 l_numemp,
                                 l_tipcol,
                                 l_numcad,
                                 1,
                                 1,
                                 l_andvis);
                  END IF;

              ELSIF (l_usocra = 10) THEN
                    BEGIN
                         SELECT DATFIM,HORFIM,NUMEMP,TIPCOL,NUMCAD INTO l_datfim,l_horfim,l_numemp,l_tipcol,l_numcad
                         FROM R070MES
                         WHERE (NUMCRA = p_numcra) AND
                               ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                               (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                               (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                    EXCEPTION
                         WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R070MES - TOO MANY ROWS';
                         WHEN NO_DATA_FOUND THEN l_datfim := '31/12/1900,00:00:00';
                                                 l_horfim := 0;
                                                 l_numemp := 0;
                                                 l_tipcol := 0;
                                                 l_numcad := 0;
                         WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R070MES.';
                    END;
                    R070MES_ATUCON('I',p_numcra,l_datfim,l_horfim,l_numemp,l_tipcol,l_numcad);
              END IF;
          ELSE
              /*Situação de DELETE, e não existe outro número físico de mesma tecnologia para substituir o atual*/

              BEGIN
                  SELECT USOCRA INTO l_usocra FROM R069CRA WHERE NUMCRA = p_numcra;
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon - TOO MANY ROWS 02';
                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R069cra. 02';
              END;

              IF (l_usocra = 8) THEN
                  /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
                  FOREACH c_r088con INTO l_r088con.IDTPES,
                                         l_r088con.SITCRA,
                                         l_r088con.DATVAL,
                                         l_r088con.PLAVEI
                  LOOP
                      /*IDTPES COM 23 POSIÇÕES*/
                      l_idtpes := LTrim(RTrim(l_r088con.IDTPES));

                      IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                          l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                          l_numdoc := SUBSTRING(l_idtpes,4,20);
                          l_tippes := 4;
                      ELSE
                          l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                          l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                          l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                          l_tippes := l_tipcol;
                      END IF;
                      l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                      SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                      l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                                  + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));
                      /*DELETA ESTA TÉCNOLOGIA DE CRACHÁ E NÚMERO FÍSICO PARA A PESSOA*/
                      BEGIN
                          DELETE FROM R088CON WHERE IDTPES = l_r088con.IDTPES AND NUMFIS = p_numfis AND TECCRA = p_teccra;
                      EXCEPTION
                          WHEN OTHERS THEN
                              RAISERROR 103 'R069FIS_AtuCon: Erro ao deletar r088con.';
                      END;
                      /*atualiza a associação entre pessoa e veículo*/
                      SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                                 , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
                  END LOOP;
              END IF;

              /*Verifica se o crachá deletado é principal*/
              BEGIN
                  SELECT IDTPES, CHCPRI INTO l_idtpes, l_chcpri FROM R070CON WHERE NUMFIS = p_numfis;
              EXCEPTION
                WHEN OTHERS THEN
                  l_chcpri := -1;
              END;
               /*Obtem o Crachá Principal Atual*/
              SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
              /*Efetuar a Troca dos Crachás*/
              IF (l_crapri = 0) THEN
                  l_crapri := p_numcra;
                  l_tecpri := 1;
              END IF;

              SP_RETICARD(NULL, l_crapri, l_icardA OUT, l_icardR OUT, l_numser OUT);

              /*Se o Crachá Excluído é diferente do principal, então exclui */
              IF (l_chcpri > 0) THEN
                  /*Deleta na Controle para evitar Violação de Chave*/
                  BEGIN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                  EXCEPTION
                      WHEN OTHERS THEN RAISERROR 103 'TR069FIS_ATUCON 3: Problemas ao Excluir o Crachá da Tabela R070CON.';
                  END;

                  /*Tratamento Controle*/
                  /*Verifica se o crachá (secundário) é smart*/
                  BEGIN
                      IF (p_teccra <> 3) THEN
                          SP_INTSTR(p_numfis, '999999999999',l_icard OUT);
                          /*Deleta o Crachá da Controle*/
                          l_comando := 'DELETE '||l_usutel||'CONTROLE WHERE ICARD = '''||l_icard||'''';
                          SP_CMDTSI(l_comando);
                          /*Atualiza demais tabelas telemática*/
                          SP_CHCTSI(5, l_icard, 0, 0, 0);
                      END IF;
                  EXCEPTION
                      WHEN OTHERS THEN RAISERROR 103 'TR069FIS_ATUCON 3: Problemas ao Excluir o Crachá da Tabela Controle.';
                  END;

              ELSE
                  /*Se o Crachá Excluído é o principal*/
                  IF (l_chcpri = 0) AND (l_crapri <> p_numfis) AND (p_teccra <> 1) THEN
                      /*Deleta na R070CON para evitar Violação de Chave*/
                      BEGIN
                          DELETE FROM R070CON WHERE NUMFIS = l_crapri;
                      EXCEPTION
                          WHEN OTHERS THEN RAISERROR 103 'TR069FIS_ATUCON 4: Problemas ao Excluir o Crachá da Tabela R070CON.';
                      END;
                      /*Efetua o UPDATE para o Novo crachá Principal*/
                      UPDATE R070CON SET NUMFIS = l_crapri, TECCRA = l_tecpri WHERE NUMFIS = p_numfis;

                      /*Efetua o Mesmo procedimento anterior para a Controle*/
                      /*Tecnologia diferente de smart OU tinha número físico diferente de barras e foi deletado*/
                      IF (p_teccra <> 3 OR (p_teccra <> l_tecpri AND l_tecpri = 1)) THEN
                          SP_INTSTR(l_icardA, '999999999999',l_icardpri OUT);
                          SP_INTSTR(p_numfis, '999999999999',l_icard OUT);
                          /*Deleta o Crachá da Controle*/
                          l_comando := 'DELETE '||l_usutel||'CONTROLE WHERE ICARD = '''||l_icard||'''';
                          SP_CMDTSI(l_comando);
                          /*Efetua o UPDATE para o Novo crachá Principal*/
                          l_comando := 'UPDATE '||l_usutel||'CONTROLE SET ICARD = '''||l_icardpri||''' WHERE ICARD = '''||l_icard||'''';
                          SP_CMDTSI(l_comando);
                          /*Atualiza a Pend_Grupo / Icard*/
                          /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
                          IF (l_tecpri = 3) THEN
                              SP_CHCTSI(2, l_icardA, p_numfis, 0, 0);
                          END IF;
                      END IF;
                      /*Atualiza os demais crachás para apontar para o novo principal*/
                      /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
                      IF (l_tecpri = 1) THEN
                          /*Atualiza o crachá de proximidade*/
                          IF (l_numpro <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numpro;
                          END IF;
                          /*Atualiza o crachá Smart*/
                          IF (l_numsma <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numsma;
                          END IF;
                      /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
                      ELSIF (l_tecpri = 2) THEN
                          /*Atualiza o crachá Smart*/
                          IF (l_numsma <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numsma;
                          END IF;
                      END IF;
                  END IF;
              END IF;
              /*Procedure que atualiza a controle*/
              SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);
          END IF;
      END IF;
  END IF;
END		SENIOR;21cSP_TROCRA
SP_ATULNG
SP_STRTODATE
SP_VEIPESCON
SP_MAPFIS
SP_ColCon
SP_VISCON
R070MES_ATUCON
Áx␀␀PROCEDURE R069FIS_ATUCON(P_TIPOPE CHAR(1),P_NUMCRA NUMBER(12),P_DATALT DATE,P_HORINI NUMBER(4),P_NUMFIS NUMBER(12),P_OLDFIS NUMBER(12),P_TECCRA NUMBER(1),P_DATFIM DATE,P_HORFIM NUMBER(4))
 IS

  l_numfis      NUMBER(12);
  l_numfis_del  NUMBER(12);
  l_usocra      NUMBER(2);
  l_datalt      DATE;
  l_horfis      NUMBER(4);
  l_tipcra      NUMBER(2);
  l_numemp      NUMBER;
  l_tipcol      NUMBER(2);
  l_numcad      NUMBER;
  l_tippes      NUMBER(2);
  l_datini      DATE;
  l_horini      NUMBER(5);
  l_datfim      DATE;
  l_horfim      NUMBER(5);
  l_tipdoc      NUMBER(1);
  l_numdoc      VARCHAR2(20);
  l_codprm      NUMBER(5);
  l_datval      DATE;
  l_horval      NUMBER(5);
  l_bloaut      VARCHAR2(1);
  l_tipvis      NUMBER(3);
  l_andvis      NUMBER(3);
  l_datent      DATE;
  l_horent      NUMBER(5);
  l_seqent      NUMBER(2);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_teccra      NUMBER(1);
  l_tippev      NUMBER(1);
  l_nummat      VARCHAR2(15);
  l_craser      VARCHAR2(10);
  l_numcra      VARCHAR2(12);
  l_numbar      NUMBER(12);
  l_numpro      NUMBER(12);
  l_numsma      NUMBER(12);
  l_crapri      NUMBER(12);
  l_tecpri      NUMBER(1);
  l_chcpri      NUMBER(12);
  l_idtpes      VARCHAR2(23);
  l_datsai      DATE;
  l_horsai      NUMBER(4);
  l_datmin      DATE;
  l_hormin      NUMBER(4);
  l_dataux      VARCHAR2(6);

  CURSOR c_r088con IS
  SELECT DISTINCT IDTPES, SITCRA, DATVAL, PLAVEI
    FROM R088CON
   WHERE CRAVEI = p_numcra
     AND SITCRA = 0; /*BUSCA AS ASSOCIAÇÕES DE PESSOA/VEÍCULO ATIVAS, SITCRA = 0*/
  TYPE t_r088con IS RECORD(
    IDTPES   R088CON.IDTPES%TYPE,
    SITCRA   R088CON.SITCRA%TYPE,
    DATVAL   R088CON.DATVAL%TYPE,
    PLAVEI   R088CON.PLAVEI%TYPE);
  l_r088con t_r088con;

BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  l_numemp := 0;
  l_tipcol := 0;
  l_numcad := 0;
  l_nummat := '0';
  l_tipdoc := 0;
  l_numdoc := '0';
  l_andvis := NULL;

  /*Apenas para históricos válidos*/
  IF ((p_datfim = l_data_zero) OR ((p_datfim > l_data_atual) OR (p_datfim = l_data_atual AND p_horfim >= l_hora_atual))) THEN

      BEGIN
          /* Busca o ultimo Cracha Físico para realizar a troca. */
          SELECT DATALT, HORINI, NUMFIS, TECCRA INTO l_datalt, l_horfis, l_numfis, l_teccra
          FROM R069FIS A
          WHERE NUMCRA = p_numcra
          AND TECCRA = p_teccra
          AND HORINI = (SELECT MAX(HORINI)
                       FROM R069FIS
                       WHERE NUMCRA = A.NUMCRA AND
                       DATALT = (SELECT MAX(DATALT)
                                 FROM R069FIS
                                 WHERE NUMCRA = A.NUMCRA AND
                                 TECCRA = p_teccra AND
                                 ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini )) AND
                                 DATFIM = l_data_zero
                                 )
                       AND TECCRA = p_teccra AND ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini ))
                       AND DATFIM = l_data_zero
                       )
          AND DATALT = (SELECT MAX(DATALT)
                       FROM R069FIS
                       WHERE NUMCRA = A.NUMCRA AND
                       TECCRA = p_teccra AND
                       ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini ))
                       AND DATFIM = l_data_zero
                       );
      EXCEPTION
          WHEN NO_DATA_FOUND THEN l_datalt := l_data_zero;
                                  l_numfis := 0;
          WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon 2: Erro No SELECT R069fis.';
      END;

      /* se achou algum crachá já cadastrado então apenas altera a controle. */
      IF  l_numfis > 0 THEN
          /*se tiver excluindo atualiza o crachá anterior. */
          l_numfis_del := 0;
          IF   p_tipope = 'D' THEN

              /* se tiver excluindo e a data for maior que a já existente. */
              IF  ((p_datalt > l_datalt) OR (p_datalt = l_datalt AND p_horini > l_horfis)) THEN
                 /* troca um cracha pelo outro na tabela controle. OLD,NEW */
                 SP_TROCRA(p_numfis, l_teccra, l_numfis);
                 /* atualiza o crachá na tabela de lista negra. */
                 SP_ATULNG(p_numfis,7);
                 l_numfis_del := p_numfis;
              END IF;
          ELSE
              /* se tiver incluindo e a data for maior que a já existente. */
              IF  ((p_datalt > l_datalt) OR (p_datalt = l_datalt AND p_horini > l_horfis)) THEN
                   /* atualiza o crachá na tabela de lista negra. */
                   SP_ATULNG(l_numfis,7);
                   /* troca um cracha pelo outro na tabela controle. OLD,NEW */
                   SP_TROCRA(l_numfis, l_teccra, p_numfis);
                   l_numfis_del := l_numfis;
              END IF;
          END IF;

          /*VEÍCULOS: Caso tenha número físico que houve troca, limpa o físico da troca e atualiza a associação*/
          IF (l_numfis_del > 0) THEN
              /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
              FOREACH c_r088con INTO l_r088con.IDTPES,
                                     l_r088con.SITCRA,
                                     l_r088con.DATVAL,
                                     l_r088con.PLAVEI
              LOOP
                  /*IDTPES COM 23 POSIÇÕES*/
                  l_idtpes := LTrim(RTrim(l_r088con.IDTPES));

                  IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                      l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                      l_numdoc := SUBSTRING(l_idtpes,4,20);
                      l_tippes := 4;
                  ELSE
                      l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                      l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                      l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                      l_tippes := l_tipcol;
                  END IF;
                  l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                  SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                  l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                              + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));

                  /*Como esta sendo inserido uma nova técnologia, limpa os registros para esta técnologia*/
                  DELETE
                    FROM R088CON
                   WHERE IDTPES = l_r088con.IDTPES
                     AND CRAVEI = p_numcra
                     AND TECCRA = p_teccra
                     AND NUMFIS = l_numfis_del;
                  /*atualiza a associação entre pessoa e veículo*/
                  SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                               , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
              END LOOP;
          END IF;
          /*FIM VEÍCULOS*/

      ELSE
          /* se nao estiver excluindo atualiza o novo crachá. */
          IF  p_tipope <> 'D' THEN
              /* Se não tiver nenhum entao inclui novo crachá na controle */
              BEGIN
                  SELECT USOCRA INTO l_usocra FROM R069CRA WHERE NUMCRA = p_numcra;
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon - TOO MANY ROWS';
                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R069cra.';
              END;

              /*Verifica se o crachá incluído é principal*/
              /*Obtem o Crachá Principal Atual*/
              SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

              IF (l_crapri = 0) THEN
                  l_crapri := p_numcra;
              END IF;

              BEGIN                 
                  IF (l_tecpri = 3 AND l_numpro = 0 AND l_numbar = 0) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;
                  ELSIF (l_tecpri = 2 AND l_numbar = 0) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;                   
                  ELSIF (l_tecpri = 1 AND p_teccra = 1) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;
                  END IF;
              EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'R069FIS_ATUCON: Problema ao efetuar a troca do crachá principal.';
              END;   

              IF    (l_usocra = 1)
              OR    (l_usocra = 2)
              OR    (l_usocra = 3)
              OR    (l_usocra = 5)
              OR    (l_usocra = 6)
              OR    (l_usocra = 12)
              OR    (l_usocra = 14)
              OR    (l_usocra = 15) THEN /* colaborador */

                    /* procura pelo histórico do colaborador. */
                    IF   (l_usocra = 5) THEN
                         l_tipcol := 5;
                         BEGIN
                              SELECT TIPCRA,NUMEMP,NUMCAD,DATINI,HORINI,DATFIM,HORFIM
                              INTO l_tipcra,l_numemp,l_numcad,l_datini,l_horini,l_datfim,l_horfim
                              FROM R070HCH
                              WHERE (NUMCRA = p_numcra) AND
                                    ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                    (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                    (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R070Hch - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R070HCH.';
                         END;
                    ELSE
                        /* alunos */
                        IF   (l_usocra = 14) THEN
                             l_tipcol := 6;
                             BEGIN
                                  SELECT TIPCRA,NUMMAT,DATINI,HORINI,DATFIM,HORFIM
                                  INTO l_tipcra,l_nummat,l_datini,l_horini,l_datfim,l_horfim
                                  FROM R073HCH
                                  WHERE (NUMCRA = p_numcra) AND
                                        ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                        (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                        (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                             EXCEPTION
                                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R073Hch - TOO MANY ROWS';
                                  WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R073HCH.';
                             END;
                        ELSE
                             /* Rsponsável de alunos */
                             IF   (l_usocra = 15) THEN
                                  l_tipcol := 7;
                                  BEGIN
                                       SELECT TIPCRA,TIPDOC,NUMDOC,DATINI,HORINI,DATFIM,HORFIM
                                       INTO l_tipcra,l_tipdoc,l_numdoc,l_datini,l_horini,l_datfim,l_horfim
                                       FROM R073HCR
                                       WHERE (NUMCRA = p_numcra) AND
                                             ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                             (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                             (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                                  EXCEPTION
                                       WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R073HCR - TOO MANY ROWS';
                                       WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                       WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R073HCR.';
                                  END;
                             ELSE
                                BEGIN
                                     SELECT TIPCRA,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,DATFIM,HORFIM
                                     INTO l_tipcra,l_numemp,l_tipcol,l_numcad,l_datini,l_horini,l_datfim,l_horfim
                                     FROM R038HCH
                                     WHERE (NUMCRA = p_numcra) AND
                                           ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                           (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                           (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                                EXCEPTION
                                     WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R038Hch - TOO MANY ROWS';
                                     WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                     WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R038HCH.';
                                END;
                            END IF;
                        END IF;
                    END IF;
                    /* se encontrou histórico aberto então atualiza a tabela controle */
                    IF  l_tipcra <> 0 THEN
                        /*Atualiza Tabela Controle. */
                        SP_ColCon ('U', l_tipcra,
                                        l_numemp,
                                        l_tipcol,
                                        l_numcad,
                                        l_tipdoc,
                                        l_numdoc,
                                        l_nummat,
                                        l_datini,
                                        l_horini,
                                        p_numcra,
                                        l_datfim,
                                        l_horfim,
                                        p_numcra,
                                        1,1,1);
                    END IF;
              ELSIF (l_usocra = 4)
              OR    (l_usocra = 7) THEN
                    IF   (l_usocra = 4) THEN
                         /* procura pelo histórico do colaborador. */
                         BEGIN
                              SELECT TIPDOC,NUMDOC,CODPRM,TIPVIS,DATENT,HORENT,DATVAL,HORVAL,ANDVIS
                              INTO l_tipdoc,l_numdoc,l_codprm,l_tipvis,l_datent,l_horent,l_datval,l_horval,l_andvis
                              FROM R090MVI
                              WHERE (NUMCRA = p_numcra) AND (DATSAI = l_data_zero);
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090MVI - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_tipdoc := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090MVI.';
                         END;
                    ELSE
                         /* procura pelo histórico do colaborador. */
                         BEGIN
                              SELECT DATENT,HORENT,SEQENT,TIPDOC,NUMDOC
                              INTO l_datent,l_horent,l_seqent,l_tipdoc,l_numdoc
                              FROM R090HCG
                              WHERE (NUMCRA = p_numcra) AND (DATSAI = l_data_zero);
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090HCG - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_seqent := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090HCG.';
                         END;

                         IF   l_seqent <> 0 THEN
                              BEGIN
                                   SELECT CODPRM,TIPVIS,DATVAL,HORVAL
                                   INTO l_codprm,l_tipvis,l_datval,l_horval
                                   FROM R090MGV
                                   WHERE DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
                              EXCEPTION
                                   WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090MGV - TOO MANY ROWS';
                                   WHEN NO_DATA_FOUND THEN NULL;
                                   WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090MGV.';
                              END;
                         END IF;
                    END IF;
                    /* se encontrou histórico aberto então atualiza a tabela controle */
                    IF  l_tipdoc <> 0 THEN
                        BEGIN
                           SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI
                           WHERE TIPVIS = l_tipvis;
                        EXCEPTION WHEN OTHERS THEN
                           l_bloaut := 'N';
                           l_tippev := 1;
                        END;

                        IF   l_bloaut =  'S' THEN
                             l_bloaut := '1';
                        ELSE l_bloaut := '0';
                        END IF;
                        /* Atualiza Tabela Controle. */
                        SP_VISCON (l_tipdoc,
                                   l_numdoc,
                                   p_numcra,
                                   l_codprm,
                                   l_datent,
                                   l_horent,
                                   l_datval,
                                   l_horval,
                                   l_bloaut,
                                   l_tippev,
                                   l_tipvis,0,0,0,1,1,
                                   l_andvis);
                    END IF;
              ELSIF (l_usocra = 8) THEN  /*veiculos*/
                  /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
                  FOREACH c_r088con INTO l_r088con.IDTPES,
                                         l_r088con.SITCRA,
                                         l_r088con.DATVAL,
                                         l_r088con.PLAVEI
                  LOOP
                      /*IDTPES COM 23 POSIÇÕES*/
                      l_idtpes := LTrim(RTrim(l_r088con.IDTPES));
                      
                      IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                          l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                          l_numdoc := SUBSTRING(l_idtpes,4,20);
                          l_tippes := 4;
                      ELSE
                          l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                          l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                          l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                          l_tippes := l_tipcol;
                      END IF;
                      l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                      SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                      l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                                  + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));
                      /*atualiza a associação entre pessoa e veículo*/
                      SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                                 , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
                  END LOOP;
              ELSIF (l_usocra = 9) THEN  /*autorizacao de entrada*/
                  BEGIN
                      SELECT NUMEMP, TIPCOL, NUMCAD, CODPRM, DATENT, HORENT, DATVAL, HORVAL, DATSAI, HORSAI
                      INTO l_numemp, l_tipcol, l_numcad, l_codprm, l_datent, l_horent, l_datval, l_horval, l_datsai, l_horsai
                      FROM R071AEN
                      WHERE NUMCRA = p_numcra AND
                      (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                      (
                      (DATSAI > l_data_atual OR DATSAI = l_data_zero OR (DATSAI = l_data_atual AND HORSAI >= l_hora_atual))
                      AND
                      (DATVAL > l_data_atual OR DATVAL = l_data_zero OR (DATVAL = l_data_atual AND HORVAL >= l_hora_atual))
                      );
                  EXCEPTION
                    WHEN OTHERS THEN
                      l_numcad := 0;
                  END;

                  IF (l_numcad > 0) THEN

                      /*Verifica a menor entre as datas datval e datsai*/
                      IF (l_datsai = l_data_zero) THEN
                          l_datsai := '31/12/2050,00:00:00';
                      END IF;

                      IF (l_datval = l_data_zero) THEN
                          l_datval := '31/12/2050,00:00:00';
                      END IF;


                      IF (l_datval <> l_datsai) THEN
                          IF (l_datval < l_datsai) THEN
                              l_datmin := l_datval;
                              l_hormin := l_horval;
                          ELSE
                              l_datmin := l_datsai;
                              l_hormin := l_horsai;
                          END IF;
                      /*Data igual, verifica a hora*/
                      ELSE
                          IF (l_horval < l_horsai) THEN
                              l_datmin := l_datval;
                              l_hormin := l_horval;
                          ELSE
                              l_datmin := l_datsai;
                              l_hormin := l_horsai;
                          END IF;
                      END IF;

                      SP_VISCON (0,
                                 '',
                                 p_numcra,
                                 l_codprm,
                                 l_datent,
                                 l_horent,
                                 l_datmin,
                                 l_hormin,
                                 '0',
                                 8,
                                 0,
                                 l_numemp,
                                 l_tipcol,
                                 l_numcad,
                                 1,
                                 1, 
                                 l_andvis);
                  END IF;

              ELSIF (l_usocra = 10) THEN
                    BEGIN
                         SELECT DATFIM,HORFIM,NUMEMP,TIPCOL,NUMCAD INTO l_datfim,l_horfim,l_numemp,l_tipcol,l_numcad
                         FROM R070MES
                         WHERE (NUMCRA = p_numcra) AND
                               ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                               (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                               (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                    EXCEPTION
                         WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R070MES - TOO MANY ROWS';
                         WHEN NO_DATA_FOUND THEN l_datfim := '31/12/1900,00:00:00';
                                                 l_horfim := 0;
                                                 l_numemp := 0;
                                                 l_tipcol := 0;
                                                 l_numcad := 0;
                         WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R070MES.';
                    END;
                    R070MES_ATUCON('I',p_numcra,l_datfim,l_horfim,l_numemp,l_tipcol,l_numcad);
              END IF;
          ELSE
              /*Situação de DELETE, e não existe outro número físico de mesma tecnologia para substituir o atual*/

              BEGIN
                  SELECT USOCRA INTO l_usocra FROM R069CRA WHERE NUMCRA = p_numcra;
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon - TOO MANY ROWS 02';
                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R069cra. 02';
              END;

              IF (l_usocra = 8) THEN
                  /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
                  FOREACH c_r088con INTO l_r088con.IDTPES,
                                         l_r088con.SITCRA,
                                         l_r088con.DATVAL,
                                         l_r088con.PLAVEI
                  LOOP
                      /*IDTPES COM 23 POSIÇÕES*/
                      l_idtpes := LTrim(RTrim(l_r088con.IDTPES));
                      
                      IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                          l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                          l_numdoc := SUBSTRING(l_idtpes,4,20);
                          l_tippes := 4;
                      ELSE
                          l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                          l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                          l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                          l_tippes := l_tipcol;
                      END IF;
                      l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                      SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                      l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                                  + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));
                      /*DELETA ESTA TÉCNOLOGIA DE CRACHÁ E NÚMERO FÍSICO PARA A PESSOA*/
                      BEGIN
                          DELETE FROM R088CON WHERE IDTPES = l_r088con.IDTPES AND NUMFIS = p_numfis AND TECCRA = p_teccra;
                      EXCEPTION
                          WHEN OTHERS THEN
                              RAISERROR 103 'R069FIS_AtuCon: Erro ao deletar r088con.';
                      END;
                      /*atualiza a associação entre pessoa e veículo*/
                      SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                                 , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
                  END LOOP;
              END IF;

              /*Verifica se o crachá deletado é principal*/
              BEGIN
                  SELECT CHCPRI INTO l_chcpri FROM R070CON WHERE NUMFIS = p_numfis;
              EXCEPTION
                WHEN OTHERS THEN
                  l_chcpri := -1;
              END; 

	      /*Obtem o Crachá Principal Atual*/
              SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
              /*Efetuar a Troca dos Crachás*/
              IF (l_crapri = 0) THEN
                  l_crapri := p_numcra;
                  l_tecpri := 1;
              END IF;              

              /*Se o Crachá Excluído é diferente do principal, então exclui */
              IF (l_chcpri > 0) THEN
                  /*Deleta na Controle para evitar Violação de Chave*/
                  BEGIN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                  EXCEPTION
                      WHEN OTHERS THEN RAISERROR 103 'TR069FIS_ATUCON 3: Problemas ao Excluir o Crachá da Tabela R070CON.';
                  END;             

              ELSE
                  /*Se o Crachá Excluído é o principal*/
                  IF (l_chcpri = 0) AND (l_crapri <> p_numfis) AND (p_teccra <> 1) THEN                      

		      /*Deleta na R070CON para evitar Violação de Chave*/
                      BEGIN
                          DELETE FROM R070CON WHERE NUMFIS = l_crapri;
                      EXCEPTION
                          WHEN OTHERS THEN RAISERROR 103 'TR069FIS_ATUCON 4: Problemas ao Excluir o Crachá da Tabela R070CON.';
                      END;
                      /*Efetua o UPDATE para o Novo crachá Principal*/
                      UPDATE R070CON SET NUMFIS = l_crapri, TECCRA = l_tecpri WHERE NUMFIS = p_numfis;

                      
                      /*Atualiza os demais crachás para apontar para o novo principal*/
                      /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
                      IF (l_tecpri = 1) THEN
                          /*Atualiza o crachá de proximidade*/
                          IF (l_numpro <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numpro;
                          END IF;
                          /*Atualiza o crachá Smart*/
                          IF (l_numsma <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numsma;
                          END IF;
                      /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
                      ELSIF (l_tecpri = 2) THEN
                          /*Atualiza o crachá Smart*/
                          IF (l_numsma <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numsma;
                          END IF;
                      END IF;
                  END IF;
              END IF;
          END IF;
      END IF;
  END IF;
END		SENIOR;22cSP_TROCRA
SP_ATULNG
SP_STRTODATE
SP_VEIPESCON
SP_MAPFIS
SP_ColCon
SP_VISCON
R070MES_ATUCON
Áx␀␀PROCEDURE R069FIS_ATUCON(P_TIPOPE CHAR(1),P_NUMCRA NUMBER(12),P_DATALT DATE,P_HORINI NUMBER(4),P_NUMFIS NUMBER(12),P_OLDFIS NUMBER(12),P_TECCRA NUMBER(1),P_DATFIM DATE,P_HORFIM NUMBER(4))
 IS

  l_numfis      NUMBER(12);
  l_numfis_del  NUMBER(12);
  l_usocra      NUMBER(2);
  l_datalt      DATE;
  l_horfis      NUMBER(4);
  l_tipcra      NUMBER(2);
  l_numemp      NUMBER;
  l_tipcol      NUMBER(2);
  l_numcad      NUMBER;
  l_tippes      NUMBER(2);
  l_datini      DATE;
  l_horini      NUMBER(5);
  l_datfim      DATE;
  l_horfim      NUMBER(5);
  l_tipdoc      NUMBER(1);
  l_numdoc      VARCHAR2(20);
  l_codprm      NUMBER(5);
  l_datval      DATE;
  l_horval      NUMBER(5);
  l_bloaut      VARCHAR2(1);
  l_tipvis      NUMBER(3);
  l_andvis      NUMBER(3);
  l_datent      DATE;
  l_horent      NUMBER(5);
  l_seqent      NUMBER(2);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_teccra      NUMBER(1);
  l_tippev      NUMBER(1);
  l_nummat      VARCHAR2(15);
  l_craser      VARCHAR2(10);
  l_numcra      VARCHAR2(12);
  l_numbar      NUMBER(12);
  l_numpro      NUMBER(12);
  l_numsma      NUMBER(12);
  l_crapri      NUMBER(12);
  l_tecpri      NUMBER(1);
  l_chcpri      NUMBER(12);
  l_idtpes      VARCHAR2(23);
  l_datsai      DATE;
  l_horsai      NUMBER(4);
  l_datmin      DATE;
  l_hormin      NUMBER(4);
  l_dataux      VARCHAR2(6);

  CURSOR c_r088con IS
  SELECT DISTINCT IDTPES, SITCRA, DATVAL, PLAVEI
    FROM R088CON
   WHERE CRAVEI = p_numcra
     AND SITCRA = 0; /*BUSCA AS ASSOCIAÇÕES DE PESSOA/VEÍCULO ATIVAS, SITCRA = 0*/
  TYPE t_r088con IS RECORD(
    IDTPES   R088CON.IDTPES%TYPE,
    SITCRA   R088CON.SITCRA%TYPE,
    DATVAL   R088CON.DATVAL%TYPE,
    PLAVEI   R088CON.PLAVEI%TYPE);
  l_r088con t_r088con;

BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  l_numemp := 0;
  l_tipcol := 0;
  l_numcad := 0;
  l_nummat := '0';
  l_tipdoc := 0;
  l_numdoc := '0';
  l_andvis := NULL;

  /*Apenas para históricos válidos*/
  IF ((p_datfim = l_data_zero) OR ((p_datfim > l_data_atual) OR (p_datfim = l_data_atual AND p_horfim >= l_hora_atual))) THEN

      BEGIN
          /* Busca o ultimo Cracha Físico para realizar a troca. */
          SELECT DATALT, HORINI, NUMFIS, TECCRA INTO l_datalt, l_horfis, l_numfis, l_teccra
          FROM R069FIS A
          WHERE NUMCRA = p_numcra
          AND TECCRA = p_teccra
          AND HORINI = (SELECT MAX(HORINI)
                       FROM R069FIS
                       WHERE NUMCRA = A.NUMCRA AND
                       DATALT = (SELECT MAX(DATALT)
                                 FROM R069FIS
                                 WHERE NUMCRA = A.NUMCRA AND
                                 TECCRA = p_teccra AND
                                 ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini )) AND
                                 DATFIM = l_data_zero
                                 )
                       AND TECCRA = p_teccra AND ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini ))
                       AND DATFIM = l_data_zero
                       )
          AND DATALT = (SELECT MAX(DATALT)
                       FROM R069FIS
                       WHERE NUMCRA = A.NUMCRA AND
                       TECCRA = p_teccra AND
                       ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini ))
                       AND DATFIM = l_data_zero
                       );
      EXCEPTION
          WHEN NO_DATA_FOUND THEN l_datalt := l_data_zero;
                                  l_numfis := 0;
          WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon 2: Erro No SELECT R069fis.';
      END;

      /* se achou algum crachá já cadastrado então apenas altera a controle. */
      IF  l_numfis > 0 THEN
          /*se tiver excluindo atualiza o crachá anterior. */
          l_numfis_del := 0;
          IF   p_tipope = 'D' THEN

              /* se tiver excluindo e a data for maior que a já existente. */
              IF  ((p_datalt > l_datalt) OR (p_datalt = l_datalt AND p_horini > l_horfis)) THEN
                 /* troca um cracha pelo outro na tabela controle. OLD,NEW */
                 SP_TROCRA(p_numfis, l_teccra, l_numfis);
                 /* atualiza o crachá na tabela de lista negra. */
                 SP_ATULNG(p_numfis,7);
                 l_numfis_del := p_numfis;
              END IF;
          ELSE
              /* se tiver incluindo e a data for maior que a já existente. */
              IF  ((p_datalt > l_datalt) OR (p_datalt = l_datalt AND p_horini > l_horfis)) THEN
                   /* atualiza o crachá na tabela de lista negra. */
                   SP_ATULNG(l_numfis,7);
                   /* troca um cracha pelo outro na tabela controle. OLD,NEW */
                   SP_TROCRA(l_numfis, l_teccra, p_numfis);
                   l_numfis_del := l_numfis;
              END IF;
          END IF;

          /*VEÍCULOS: Caso tenha número físico que houve troca, limpa o físico da troca e atualiza a associação*/
          IF (l_numfis_del > 0) THEN
              /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
              FOREACH c_r088con INTO l_r088con.IDTPES,
                                     l_r088con.SITCRA,
                                     l_r088con.DATVAL,
                                     l_r088con.PLAVEI
              LOOP
                  /*IDTPES COM 23 POSIÇÕES*/
                  l_idtpes := LTrim(RTrim(l_r088con.IDTPES));

                  IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                      l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                      l_numdoc := SUBSTRING(l_idtpes,4,20);
                      l_tippes := 4;
                  ELSE
                      l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                      l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                      l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                      l_tippes := l_tipcol;
                  END IF;
                  l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                  SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                  l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                              + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));

                  /*Como esta sendo inserido uma nova técnologia, limpa os registros para esta técnologia*/
                  DELETE
                    FROM R088CON
                   WHERE IDTPES = l_r088con.IDTPES
                     AND CRAVEI = p_numcra
                     AND TECCRA = p_teccra
                     AND NUMFIS = l_numfis_del;
                  /*atualiza a associação entre pessoa e veículo*/
                  SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                               , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
              END LOOP;
          END IF;
          /*FIM VEÍCULOS*/

      ELSE
          /* se nao estiver excluindo atualiza o novo crachá. */
          IF  p_tipope <> 'D' THEN
              /* Se não tiver nenhum entao inclui novo crachá na controle */
              BEGIN
                  SELECT USOCRA INTO l_usocra FROM R069CRA WHERE NUMCRA = p_numcra;
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon - TOO MANY ROWS';
                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R069cra.';
              END;

              /*Verifica se o crachá incluído é principal*/
              /*Obtem o Crachá Principal Atual*/
              SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

              IF (l_crapri = 0) THEN
                  l_crapri := p_numcra;
              END IF;

              BEGIN                 
                  IF (l_tecpri = 3 AND l_numpro = 0 AND l_numbar = 0) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;
                  ELSIF (l_tecpri = 2 AND l_numbar = 0) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;                   
                  ELSIF (l_tecpri = 1 AND p_teccra = 1) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;
                  END IF;
              EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'R069FIS_ATUCON: Problema ao efetuar a troca do crachá principal.';
              END;   

              IF    (l_usocra = 1)
              OR    (l_usocra = 2)
              OR    (l_usocra = 3)
              OR    (l_usocra = 5)
              OR    (l_usocra = 6)
              OR    (l_usocra = 12)
              OR    (l_usocra = 14)
              OR    (l_usocra = 15) THEN /* colaborador */

                    /* procura pelo histórico do colaborador. */
                    IF   (l_usocra = 5) THEN
                         l_tipcol := 5;
                         BEGIN
                              SELECT TIPCRA,NUMEMP,NUMCAD,DATINI,HORINI,DATFIM,HORFIM
                              INTO l_tipcra,l_numemp,l_numcad,l_datini,l_horini,l_datfim,l_horfim
                              FROM R070HCH
                              WHERE (NUMCRA = p_numcra) AND
                                    ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                    (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                    (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R070Hch - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R070HCH.';
                         END;
                    ELSE
                        /* alunos */
                        IF   (l_usocra = 14) THEN
                             l_tipcol := 6;
                             BEGIN
                                  SELECT TIPCRA,NUMMAT,DATINI,HORINI,DATFIM,HORFIM
                                  INTO l_tipcra,l_nummat,l_datini,l_horini,l_datfim,l_horfim
                                  FROM R073HCH
                                  WHERE (NUMCRA = p_numcra) AND
                                        ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                        (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                        (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                             EXCEPTION
                                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R073Hch - TOO MANY ROWS';
                                  WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R073HCH.';
                             END;
                        ELSE
                             /* Rsponsável de alunos */
                             IF   (l_usocra = 15) THEN
                                  l_tipcol := 7;
                                  BEGIN
                                       SELECT TIPCRA,TIPDOC,NUMDOC,DATINI,HORINI,DATFIM,HORFIM
                                       INTO l_tipcra,l_tipdoc,l_numdoc,l_datini,l_horini,l_datfim,l_horfim
                                       FROM R073HCR
                                       WHERE (NUMCRA = p_numcra) AND
                                             ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                             (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                             (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                                  EXCEPTION
                                       WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R073HCR - TOO MANY ROWS';
                                       WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                       WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R073HCR.';
                                  END;
                             ELSE
                                BEGIN
                                     SELECT TIPCRA,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,DATFIM,HORFIM
                                     INTO l_tipcra,l_numemp,l_tipcol,l_numcad,l_datini,l_horini,l_datfim,l_horfim
                                     FROM R038HCH
                                     WHERE (NUMCRA = p_numcra) AND
                                           ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                           (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                           (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                                EXCEPTION
                                     WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R038Hch - TOO MANY ROWS';
                                     WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                     WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R038HCH.';
                                END;
                            END IF;
                        END IF;
                    END IF;
                    /* se encontrou histórico aberto então atualiza a tabela controle */
                    IF  l_tipcra <> 0 THEN
                        /*Atualiza Tabela Controle. */
                        SP_ColCon ('U', l_tipcra,
                                        l_numemp,
                                        l_tipcol,
                                        l_numcad,
                                        l_tipdoc,
                                        l_numdoc,
                                        l_nummat,
                                        l_datini,
                                        l_horini,
                                        p_numcra,
                                        l_datfim,
                                        l_horfim,
                                        p_numcra,
                                        1,1,1);
                    END IF;
              ELSIF (l_usocra = 4)
              OR    (l_usocra = 7) THEN
                    IF   (l_usocra = 4) THEN
                         /* procura pelo histórico do colaborador. */
                         BEGIN
                              SELECT TIPDOC,NUMDOC,CODPRM,TIPVIS,DATENT,HORENT,DATVAL,HORVAL,ANDVIS
                              INTO l_tipdoc,l_numdoc,l_codprm,l_tipvis,l_datent,l_horent,l_datval,l_horval,l_andvis
                              FROM R090MVI
                              WHERE (NUMCRA = p_numcra) AND (DATSAI = l_data_zero);
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090MVI - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_tipdoc := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090MVI.';
                         END;
                    ELSE
                         /* procura pelo histórico do colaborador. */
                         BEGIN
                              SELECT DATENT,HORENT,SEQENT,TIPDOC,NUMDOC
                              INTO l_datent,l_horent,l_seqent,l_tipdoc,l_numdoc
                              FROM R090HCG
                              WHERE (NUMCRA = p_numcra) AND (DATSAI = l_data_zero);
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090HCG - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_seqent := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090HCG.';
                         END;

                         IF   l_seqent <> 0 THEN
                              BEGIN
                                   SELECT CODPRM,TIPVIS,DATVAL,HORVAL
                                   INTO l_codprm,l_tipvis,l_datval,l_horval
                                   FROM R090MGV
                                   WHERE DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
                              EXCEPTION
                                   WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090MGV - TOO MANY ROWS';
                                   WHEN NO_DATA_FOUND THEN NULL;
                                   WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090MGV.';
                              END;
                         END IF;
                    END IF;
                    /* se encontrou histórico aberto então atualiza a tabela controle */
                    IF  l_tipdoc <> 0 THEN
                        BEGIN
                           SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI
                           WHERE TIPVIS = l_tipvis;
                        EXCEPTION WHEN OTHERS THEN
                           l_bloaut := 'N';
                           l_tippev := 1;
                        END;

                        IF   l_bloaut =  'S' THEN
                             l_bloaut := '1';
                        ELSE l_bloaut := '0';
                        END IF;
                        /* Atualiza Tabela Controle. */
                        SP_VISCON (l_tipdoc,
                                   l_numdoc,
                                   p_numcra,
                                   l_codprm,
                                   l_datent,
                                   l_horent,
                                   l_datval,
                                   l_horval,
                                   l_bloaut,
                                   l_tippev,
                                   l_tipvis,0,0,0,1,1,
                                   l_andvis);
                    END IF;
              ELSIF (l_usocra = 8) THEN  /*veiculos*/
                  /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
                  FOREACH c_r088con INTO l_r088con.IDTPES,
                                         l_r088con.SITCRA,
                                         l_r088con.DATVAL,
                                         l_r088con.PLAVEI
                  LOOP
                      /*IDTPES COM 23 POSIÇÕES*/
                      l_idtpes := LTrim(RTrim(l_r088con.IDTPES));
                      
                      IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                          l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                          l_numdoc := SUBSTRING(l_idtpes,4,20);
                          l_tippes := 4;
                      ELSE
                          l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                          l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                          l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                          l_tippes := l_tipcol;
                      END IF;
                      l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                      SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                      l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                                  + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));
                      /*atualiza a associação entre pessoa e veículo*/
                      SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                                 , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
                  END LOOP;
              ELSIF (l_usocra = 9) THEN  /*autorizacao de entrada*/
                  BEGIN
                      SELECT NUMEMP, TIPCOL, NUMCAD, CODPRM, DATENT, HORENT, DATVAL, HORVAL, DATSAI, HORSAI
                      INTO l_numemp, l_tipcol, l_numcad, l_codprm, l_datent, l_horent, l_datval, l_horval, l_datsai, l_horsai
                      FROM R071AEN
                      WHERE NUMCRA = p_numcra AND
                      (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                      (
                      (DATSAI > l_data_atual OR DATSAI = l_data_zero OR (DATSAI = l_data_atual AND HORSAI >= l_hora_atual))
                      AND
                      (DATVAL > l_data_atual OR DATVAL = l_data_zero OR (DATVAL = l_data_atual AND HORVAL >= l_hora_atual))
                      );
                  EXCEPTION
                    WHEN OTHERS THEN
                      l_numcad := 0;
                  END;

                  IF (l_numcad > 0) THEN

                      /*Verifica a menor entre as datas datval e datsai*/
                      IF (l_datsai = l_data_zero) THEN
                          l_datsai := '31/12/2050,00:00:00';
                      END IF;

                      IF (l_datval = l_data_zero) THEN
                          l_datval := '31/12/2050,00:00:00';
                      END IF;


                      IF (l_datval <> l_datsai) THEN
                          IF (l_datval < l_datsai) THEN
                              l_datmin := l_datval;
                              l_hormin := l_horval;
                          ELSE
                              l_datmin := l_datsai;
                              l_hormin := l_horsai;
                          END IF;
                      /*Data igual, verifica a hora*/
                      ELSE
                          IF (l_horval < l_horsai) THEN
                              l_datmin := l_datval;
                              l_hormin := l_horval;
                          ELSE
                              l_datmin := l_datsai;
                              l_hormin := l_horsai;
                          END IF;
                      END IF;

                      SP_VISCON (0,
                                 '',
                                 p_numcra,
                                 l_codprm,
                                 l_datent,
                                 l_horent,
                                 l_datmin,
                                 l_hormin,
                                 '0',
                                 8,
                                 0,
                                 l_numemp,
                                 l_tipcol,
                                 l_numcad,
                                 1,
                                 1, 
                                 l_andvis);
                  END IF;

              ELSIF (l_usocra = 10) THEN
                    BEGIN
                         SELECT DATFIM,HORFIM,NUMEMP,TIPCOL,NUMCAD INTO l_datfim,l_horfim,l_numemp,l_tipcol,l_numcad
                         FROM R070MES
                         WHERE (NUMCRA = p_numcra) AND
                               ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                               (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                               (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                    EXCEPTION
                         WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R070MES - TOO MANY ROWS';
                         WHEN NO_DATA_FOUND THEN l_datfim := '31/12/1900,00:00:00';
                                                 l_horfim := 0;
                                                 l_numemp := 0;
                                                 l_tipcol := 0;
                                                 l_numcad := 0;
                         WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R070MES.';
                    END;
                    R070MES_ATUCON('I',p_numcra,l_datfim,l_horfim,l_numemp,l_tipcol,l_numcad);
              END IF;
          ELSE
              /*Situação de DELETE, e não existe outro número físico de mesma tecnologia para substituir o atual*/

              BEGIN
                  SELECT USOCRA INTO l_usocra FROM R069CRA WHERE NUMCRA = p_numcra;
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon - TOO MANY ROWS 02';
                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R069cra. 02';
              END;

              IF (l_usocra = 8) THEN
                  /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
                  FOREACH c_r088con INTO l_r088con.IDTPES,
                                         l_r088con.SITCRA,
                                         l_r088con.DATVAL,
                                         l_r088con.PLAVEI
                  LOOP
                      /*IDTPES COM 23 POSIÇÕES*/
                      l_idtpes := LTrim(RTrim(l_r088con.IDTPES));
                      
                      IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                          l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                          l_numdoc := SUBSTRING(l_idtpes,4,20);
                          l_tippes := 4;
                      ELSE
                          l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                          l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                          l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                          l_tippes := l_tipcol;
                      END IF;
                      l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                      SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                      l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                                  + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));
                      /*DELETA ESTA TÉCNOLOGIA DE CRACHÁ E NÚMERO FÍSICO PARA A PESSOA*/
                      BEGIN
                          DELETE FROM R088CON WHERE IDTPES = l_r088con.IDTPES AND NUMFIS = p_numfis AND TECCRA = p_teccra;
                      EXCEPTION
                          WHEN OTHERS THEN
                              RAISERROR 103 'R069FIS_AtuCon: Erro ao deletar r088con.';
                      END;
                      /*atualiza a associação entre pessoa e veículo*/
                      SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                                 , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
                  END LOOP;
              END IF;

              /*Verifica se o crachá deletado é principal*/
              BEGIN
                  SELECT CHCPRI INTO l_chcpri FROM R070CON WHERE NUMFIS = p_numfis;
              EXCEPTION
                WHEN OTHERS THEN
                  l_chcpri := -1;
              END; 

	      /*Obtem o Crachá Principal Atual*/
              SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
              /*Efetuar a Troca dos Crachás*/
              IF (l_crapri = 0) THEN
                  l_crapri := p_numcra;
                  l_tecpri := 1;
              END IF;              

              /*Se o Crachá Excluído é diferente do principal, então exclui */
              IF (l_chcpri > 0) THEN
                  /*Deleta na Controle para evitar Violação de Chave*/
                  BEGIN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                  EXCEPTION
                      WHEN OTHERS THEN RAISERROR 103 'TR069FIS_ATUCON 3: Problemas ao Excluir o Crachá da Tabela R070CON.';
                  END;             

              ELSE
                  /*Se o Crachá Excluído é o principal*/
                  IF (l_chcpri = 0) AND (l_crapri <> p_numfis) AND (p_teccra <> 1) THEN                      

		      /*Deleta na R070CON para evitar Violação de Chave*/
                      BEGIN
                          DELETE FROM R070CON WHERE NUMFIS = l_crapri;
                      EXCEPTION
                          WHEN OTHERS THEN RAISERROR 103 'TR069FIS_ATUCON 4: Problemas ao Excluir o Crachá da Tabela R070CON.';
                      END;
                      /*Efetua o UPDATE para o Novo crachá Principal*/
                      UPDATE R070CON SET NUMFIS = l_crapri, TECCRA = l_tecpri WHERE NUMFIS = p_numfis;

                      
                      /*Atualiza os demais crachás para apontar para o novo principal*/
                      /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
                      IF (l_tecpri = 1) THEN
                          /*Atualiza o crachá de proximidade*/
                          IF (l_numpro <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numpro;
                          END IF;
                          /*Atualiza o crachá Smart*/
                          IF (l_numsma <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numsma;
                          END IF;
                      /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
                      ELSIF (l_tecpri = 2) THEN
                          /*Atualiza o crachá Smart*/
                          IF (l_numsma <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numsma;
                          END IF;
                      END IF;
                  END IF;
              END IF;
          END IF;
      END IF;
  END IF;
END		SENIOR;24cSP_TROCRA
SP_ATULNG
SP_STRTODATE
SP_VEIPESCON
SP_MAPFIS
SP_ColCon
SP_VISCON
R070MES_ATUCON
Áx␀␀PROCEDURE R069FIS_ATUCON(P_TIPOPE CHAR(1),P_NUMCRA NUMBER(12),P_DATALT DATE,P_HORINI NUMBER(4),P_NUMFIS NUMBER(12),P_OLDFIS NUMBER(12),P_TECCRA NUMBER(1),P_DATFIM DATE,P_HORFIM NUMBER(4))
 IS

  l_numfis      NUMBER(12);
  l_numfis_del  NUMBER(12);
  l_usocra      NUMBER(2);
  l_datalt      DATE;
  l_horfis      NUMBER(4);
  l_tipcra      NUMBER(2);
  l_numemp      NUMBER;
  l_tipcol      NUMBER(2);
  l_numcad      NUMBER;
  l_tippes      NUMBER(2);
  l_datini      DATE;
  l_horini      NUMBER(5);
  l_datfim      DATE;
  l_horfim      NUMBER(5);
  l_tipdoc      NUMBER(1);
  l_numdoc      VARCHAR2(20);
  l_codprm      NUMBER(5);
  l_datval      DATE;
  l_horval      NUMBER(5);
  l_bloaut      VARCHAR2(1);
  l_tipvis      NUMBER(3);
  l_andvis      NUMBER(3);
  l_datent      DATE;
  l_horent      NUMBER(5);
  l_seqent      NUMBER(2);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_teccra      NUMBER(1);
  l_tippev      NUMBER(1);
  l_nummat      VARCHAR2(15);
  l_craser      VARCHAR2(10);
  l_numcra      VARCHAR2(12);
  l_numbar      NUMBER(12);
  l_numpro      NUMBER(12);
  l_numsma      NUMBER(12);
  l_crapri      NUMBER(12);
  l_tecpri      NUMBER(1);
  l_chcpri      NUMBER(12);
  l_idtpes      VARCHAR2(23);
  l_datsai      DATE;
  l_horsai      NUMBER(4);
  l_datmin      DATE;
  l_hormin      NUMBER(4);
  l_dataux      VARCHAR2(6);

  CURSOR c_r088con IS
  SELECT DISTINCT IDTPES, SITCRA, DATVAL, PLAVEI
    FROM R088CON
   WHERE CRAVEI = p_numcra
     AND SITCRA = 0; /*BUSCA AS ASSOCIAÇÕES DE PESSOA/VEÍCULO ATIVAS, SITCRA = 0*/
  TYPE t_r088con IS RECORD(
    IDTPES   R088CON.IDTPES%TYPE,
    SITCRA   R088CON.SITCRA%TYPE,
    DATVAL   R088CON.DATVAL%TYPE,
    PLAVEI   R088CON.PLAVEI%TYPE);
  l_r088con t_r088con;

BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  l_numemp := 0;
  l_tipcol := 0;
  l_numcad := 0;
  l_nummat := '0';
  l_tipdoc := 0;
  l_numdoc := '0';
  l_andvis := NULL;

  /*Apenas para históricos válidos*/
  IF ((p_datfim = l_data_zero) OR ((p_datfim > l_data_atual) OR (p_datfim = l_data_atual AND p_horfim >= l_hora_atual))) THEN

      BEGIN
          /* Busca o ultimo Cracha Físico para realizar a troca. */
          SELECT DATALT, HORINI, NUMFIS, TECCRA INTO l_datalt, l_horfis, l_numfis, l_teccra
          FROM R069FIS A
          WHERE NUMCRA = p_numcra
          AND TECCRA = p_teccra
          AND HORINI = (SELECT MAX(HORINI)
                       FROM R069FIS
                       WHERE NUMCRA = A.NUMCRA AND
                       DATALT = (SELECT MAX(DATALT)
                                 FROM R069FIS
                                 WHERE NUMCRA = A.NUMCRA AND
                                 TECCRA = p_teccra AND
                                 ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini )) AND
                                 DATFIM = l_data_zero
                                 )
                       AND TECCRA = p_teccra AND ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini ))
                       AND DATFIM = l_data_zero
                       )
          AND DATALT = (SELECT MAX(DATALT)
                       FROM R069FIS
                       WHERE NUMCRA = A.NUMCRA AND
                       TECCRA = p_teccra AND
                       ((DATALT <> p_datalt) OR (DATALT = p_datalt AND HORINI <> p_horini ))
                       AND DATFIM = l_data_zero
                       );
      EXCEPTION
          WHEN NO_DATA_FOUND THEN l_datalt := l_data_zero;
                                  l_numfis := 0;
          WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon 2: Erro No SELECT R069fis.';
      END;

      /* se achou algum crachá já cadastrado então apenas altera a controle. */
      IF  l_numfis > 0 THEN
          /*se tiver excluindo atualiza o crachá anterior. */
          l_numfis_del := 0;
          IF   p_tipope = 'D' THEN

              /* se tiver excluindo e a data for maior que a já existente. */
              IF  ((p_datalt > l_datalt) OR (p_datalt = l_datalt AND p_horini > l_horfis)) THEN
                 /* troca um cracha pelo outro na tabela controle. OLD,NEW */
                 SP_TROCRA(p_numfis, l_teccra, l_numfis);
                 /* atualiza o crachá na tabela de lista negra. */
                 SP_ATULNG(p_numfis,7);
                 l_numfis_del := p_numfis;
              END IF;
          ELSE
              /* se tiver incluindo e a data for maior que a já existente. */
              IF  ((p_datalt > l_datalt) OR (p_datalt = l_datalt AND p_horini > l_horfis)) THEN
                   /* atualiza o crachá na tabela de lista negra. */
                   SP_ATULNG(l_numfis,7);
                   /* troca um cracha pelo outro na tabela controle. OLD,NEW */
                   SP_TROCRA(l_numfis, l_teccra, p_numfis);
                   l_numfis_del := l_numfis;
              END IF;
          END IF;

          /*VEÍCULOS: Caso tenha número físico que houve troca, limpa o físico da troca e atualiza a associação*/
          IF (l_numfis_del > 0) THEN
              /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
              FOREACH c_r088con INTO l_r088con.IDTPES,
                                     l_r088con.SITCRA,
                                     l_r088con.DATVAL,
                                     l_r088con.PLAVEI
              LOOP
                  /*IDTPES COM 23 POSIÇÕES*/
                  l_idtpes := LTrim(RTrim(l_r088con.IDTPES));

                  IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                      l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                      l_numdoc := SUBSTRING(l_idtpes,4,20);
                      l_tippes := 4;
                  ELSE
                      l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                      l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                      l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                      l_tippes := l_tipcol;
                  END IF;
                  l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                  SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                  l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                              + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));

                  /*Como esta sendo inserido uma nova técnologia, limpa os registros para esta técnologia*/
                  DELETE
                    FROM R088CON
                   WHERE IDTPES = l_r088con.IDTPES
                     AND CRAVEI = p_numcra
                     AND TECCRA = p_teccra
                     AND NUMFIS = l_numfis_del;
                  /*atualiza a associação entre pessoa e veículo*/
                  SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                               , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
              END LOOP;
          END IF;
          /*FIM VEÍCULOS*/

      ELSE
          /* se nao estiver excluindo atualiza o novo crachá. */
          IF  p_tipope <> 'D' THEN
              /* Se não tiver nenhum entao inclui novo crachá na controle */
              BEGIN
                  SELECT USOCRA INTO l_usocra FROM R069CRA WHERE NUMCRA = p_numcra;
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon - TOO MANY ROWS';
                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R069cra.';
              END;

              /*Verifica se o crachá incluído é principal*/
              /*Obtem o Crachá Principal Atual*/
              SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

              IF (l_crapri = 0) THEN
                  l_crapri := p_numcra;
              END IF;

              BEGIN                 
                  IF (l_tecpri = 3 AND l_numpro = 0 AND l_numbar = 0) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;
                  ELSIF (l_tecpri = 2 AND l_numbar = 0) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;                   
                  ELSIF (l_tecpri = 1 AND p_teccra = 1) THEN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                      UPDATE R070CON SET NUMFIS = p_numfis, TECCRA = l_tecpri WHERE NUMFIS = p_numcra AND TECCRA = 1;
                  END IF;
              EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'R069FIS_ATUCON: Problema ao efetuar a troca do crachá principal.';
              END;   

              IF    (l_usocra = 1)
              OR    (l_usocra = 2)
              OR    (l_usocra = 3)
              OR    (l_usocra = 5)
              OR    (l_usocra = 6)
              OR    (l_usocra = 12)
              OR    (l_usocra = 14)
              OR    (l_usocra = 15) THEN /* colaborador */

                    /* procura pelo histórico do colaborador. */
                    IF   (l_usocra = 5) THEN
                         l_tipcol := 5;
                         BEGIN
                              SELECT TIPCRA,NUMEMP,NUMCAD,DATINI,HORINI,DATFIM,HORFIM
                              INTO l_tipcra,l_numemp,l_numcad,l_datini,l_horini,l_datfim,l_horfim
                              FROM R070HCH
                              WHERE (NUMCRA = p_numcra) AND
                                    ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                    (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                    (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R070Hch - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R070HCH.';
                         END;
                    ELSE
                        /* alunos */
                        IF   (l_usocra = 14) THEN
                             l_tipcol := 6;
                             BEGIN
                                  SELECT TIPCRA,NUMMAT,DATINI,HORINI,DATFIM,HORFIM
                                  INTO l_tipcra,l_nummat,l_datini,l_horini,l_datfim,l_horfim
                                  FROM R073HCH
                                  WHERE (NUMCRA = p_numcra) AND
                                        ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                        (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                        (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                             EXCEPTION
                                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R073Hch - TOO MANY ROWS';
                                  WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R073HCH.';
                             END;
                        ELSE
                             /* Rsponsável de alunos */
                             IF   (l_usocra = 15) THEN
                                  l_tipcol := 7;
                                  BEGIN
                                       SELECT TIPCRA,TIPDOC,NUMDOC,DATINI,HORINI,DATFIM,HORFIM
                                       INTO l_tipcra,l_tipdoc,l_numdoc,l_datini,l_horini,l_datfim,l_horfim
                                       FROM R073HCR
                                       WHERE (NUMCRA = p_numcra) AND
                                             ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                             (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                             (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                                  EXCEPTION
                                       WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R073HCR - TOO MANY ROWS';
                                       WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                       WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R073HCR.';
                                  END;
                             ELSE
                                BEGIN
                                     SELECT TIPCRA,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,DATFIM,HORFIM
                                     INTO l_tipcra,l_numemp,l_tipcol,l_numcad,l_datini,l_horini,l_datfim,l_horfim
                                     FROM R038HCH
                                     WHERE (NUMCRA = p_numcra) AND
                                           ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                           (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                                           (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                                EXCEPTION
                                     WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R038Hch - TOO MANY ROWS';
                                     WHEN NO_DATA_FOUND THEN l_tipcra := 0;
                                     WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R038HCH.';
                                END;
                            END IF;
                        END IF;
                    END IF;
                    /* se encontrou histórico aberto então atualiza a tabela controle */
                    IF  l_tipcra <> 0 THEN
                        /*Atualiza Tabela Controle. */
                        SP_ColCon ('U', l_tipcra,
                                        l_numemp,
                                        l_tipcol,
                                        l_numcad,
                                        l_tipdoc,
                                        l_numdoc,
                                        l_nummat,
                                        l_datini,
                                        l_horini,
                                        p_numcra,
                                        l_datfim,
                                        l_horfim,
                                        p_numcra,
                                        1,1,1);
                    END IF;
              ELSIF (l_usocra = 4)
              OR    (l_usocra = 7) THEN
                    IF   (l_usocra = 4) THEN
                         /* procura pelo histórico do colaborador. */
                         BEGIN
                              SELECT TIPDOC,NUMDOC,CODPRM,TIPVIS,DATENT,HORENT,DATVAL,HORVAL,ANDVIS
                              INTO l_tipdoc,l_numdoc,l_codprm,l_tipvis,l_datent,l_horent,l_datval,l_horval,l_andvis
                              FROM R090MVI
                              WHERE (NUMCRA = p_numcra) AND (DATSAI = l_data_zero);
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090MVI - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_tipdoc := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090MVI.';
                         END;
                    ELSE
                         /* procura pelo histórico do colaborador. */
                         BEGIN
                              SELECT DATENT,HORENT,SEQENT,TIPDOC,NUMDOC
                              INTO l_datent,l_horent,l_seqent,l_tipdoc,l_numdoc
                              FROM R090HCG
                              WHERE (NUMCRA = p_numcra) AND (DATSAI = l_data_zero);
                         EXCEPTION
                              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090HCG - TOO MANY ROWS';
                              WHEN NO_DATA_FOUND THEN l_seqent := 0;
                              WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090HCG.';
                         END;

                         IF   l_seqent <> 0 THEN
                              BEGIN
                                   SELECT CODPRM,TIPVIS,DATVAL,HORVAL
                                   INTO l_codprm,l_tipvis,l_datval,l_horval
                                   FROM R090MGV
                                   WHERE DATENT = l_datent AND HORENT = l_horent AND SEQENT = l_seqent;
                              EXCEPTION
                                   WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R090MGV - TOO MANY ROWS';
                                   WHEN NO_DATA_FOUND THEN NULL;
                                   WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R090MGV.';
                              END;
                         END IF;
                    END IF;
                    /* se encontrou histórico aberto então atualiza a tabela controle */
                    IF  l_tipdoc <> 0 THEN
                        BEGIN
                           SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI
                           WHERE TIPVIS = l_tipvis;
                        EXCEPTION WHEN OTHERS THEN
                           l_bloaut := 'N';
                           l_tippev := 1;
                        END;

                        IF   l_bloaut =  'S' THEN
                             l_bloaut := '1';
                        ELSE l_bloaut := '0';
                        END IF;
                        /* Atualiza Tabela Controle. */
                        SP_VISCON (l_tipdoc,
                                   l_numdoc,
                                   p_numcra,
                                   l_codprm,
                                   l_datent,
                                   l_horent,
                                   l_datval,
                                   l_horval,
                                   l_bloaut,
                                   l_tippev,
                                   l_tipvis,0,0,0,1,1,
                                   l_andvis);
                    END IF;
              ELSIF (l_usocra = 8) THEN  /*veiculos*/
                  /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
                  FOREACH c_r088con INTO l_r088con.IDTPES,
                                         l_r088con.SITCRA,
                                         l_r088con.DATVAL,
                                         l_r088con.PLAVEI
                  LOOP
                      /*IDTPES COM 23 POSIÇÕES*/
                      l_idtpes := LTrim(RTrim(l_r088con.IDTPES));
                      
                      IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                          l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                          l_numdoc := SUBSTRING(l_idtpes,4,20);
                          l_tippes := 4;
                      ELSE
                          l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                          l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                          l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                          l_tippes := l_tipcol;
                      END IF;
                      l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                      SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                      l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                                  + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));
                      /*atualiza a associação entre pessoa e veículo*/
                      SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                                 , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
                  END LOOP;
              ELSIF (l_usocra = 9) THEN  /*autorizacao de entrada*/
                  BEGIN
                      SELECT NUMEMP, TIPCOL, NUMCAD, CODPRM, DATENT, HORENT, DATVAL, HORVAL, DATSAI, HORSAI
                      INTO l_numemp, l_tipcol, l_numcad, l_codprm, l_datent, l_horent, l_datval, l_horval, l_datsai, l_horsai
                      FROM R071AEN
                      WHERE NUMCRA = p_numcra AND
                      (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                      (
                      (DATSAI > l_data_atual OR DATSAI = l_data_zero OR (DATSAI = l_data_atual AND HORSAI >= l_hora_atual))
                      AND
                      (DATVAL > l_data_atual OR DATVAL = l_data_zero OR (DATVAL = l_data_atual AND HORVAL >= l_hora_atual))
                      );
                  EXCEPTION
                    WHEN OTHERS THEN
                      l_numcad := 0;
                  END;

                  IF (l_numcad > 0) THEN

                      /*Verifica a menor entre as datas datval e datsai*/
                      IF (l_datsai = l_data_zero) THEN
                          l_datsai := '31/12/2050,00:00:00';
                      END IF;

                      IF (l_datval = l_data_zero) THEN
                          l_datval := '31/12/2050,00:00:00';
                      END IF;


                      IF (l_datval <> l_datsai) THEN
                          IF (l_datval < l_datsai) THEN
                              l_datmin := l_datval;
                              l_hormin := l_horval;
                          ELSE
                              l_datmin := l_datsai;
                              l_hormin := l_horsai;
                          END IF;
                      /*Data igual, verifica a hora*/
                      ELSE
                          IF (l_horval < l_horsai) THEN
                              l_datmin := l_datval;
                              l_hormin := l_horval;
                          ELSE
                              l_datmin := l_datsai;
                              l_hormin := l_horsai;
                          END IF;
                      END IF;

                      SP_VISCON (0,
                                 '',
                                 p_numcra,
                                 l_codprm,
                                 l_datent,
                                 l_horent,
                                 l_datmin,
                                 l_hormin,
                                 '0',
                                 8,
                                 0,
                                 l_numemp,
                                 l_tipcol,
                                 l_numcad,
                                 1,
                                 1, 
                                 l_andvis);
                  END IF;

              ELSIF (l_usocra = 10) THEN
                    BEGIN
                         SELECT DATFIM,HORFIM,NUMEMP,TIPCOL,NUMCAD INTO l_datfim,l_horfim,l_numemp,l_tipcol,l_numcad
                         FROM R070MES
                         WHERE (NUMCRA = p_numcra) AND
                               ((DATINI < l_data_atual) OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                               (DATFIM > l_data_atual OR DATFIM = l_data_zero OR
                               (DATFIM = l_data_atual AND HORFIM > l_hora_atual));
                    EXCEPTION
                         WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon: R070MES - TOO MANY ROWS';
                         WHEN NO_DATA_FOUND THEN l_datfim := '31/12/1900,00:00:00';
                                                 l_horfim := 0;
                                                 l_numemp := 0;
                                                 l_tipcol := 0;
                                                 l_numcad := 0;
                         WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R070MES.';
                    END;
                    R070MES_ATUCON('I',p_numcra,l_datfim,l_horfim,l_numemp,l_tipcol,l_numcad);
              END IF;
          ELSE
              /*Situação de DELETE, e não existe outro número físico de mesma tecnologia para substituir o atual*/

              BEGIN
                  SELECT USOCRA INTO l_usocra FROM R069CRA WHERE NUMCRA = p_numcra;
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'R069FIS_AtuCon - TOO MANY ROWS 02';
                  WHEN OTHERS THEN RAISERROR 103 'R069FIS_AtuCon: Erro No SELECT R069cra. 02';
              END;

              IF (l_usocra = 8) THEN
                  /*ASSOCIAÇÕES DE PESSOAS E VEÍCULOS*/
                  FOREACH c_r088con INTO l_r088con.IDTPES,
                                         l_r088con.SITCRA,
                                         l_r088con.DATVAL,
                                         l_r088con.PLAVEI
                  LOOP
                      /*IDTPES COM 23 POSIÇÕES*/
                      l_idtpes := LTrim(RTrim(l_r088con.IDTPES));
                      
                      IF (SUBSTRING(l_idtpes,1,2) = '04') THEN
                          l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                          l_numdoc := SUBSTRING(l_idtpes,4,20);
                          l_tippes := 4;
                      ELSE
                          l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
                          l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
                          l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
                          l_tippes := l_tipcol;
                      END IF;
                      l_dataux := SUBSTRING(l_r088con.DATVAL,1,6);
                      SP_STRTODATE(l_dataux, 'DDMMAA', l_datval OUT);
                      l_horval := ( CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,7,2))*60 )
                                  + CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_r088con.DATVAL,9,2));
                      /*DELETA ESTA TÉCNOLOGIA DE CRACHÁ E NÚMERO FÍSICO PARA A PESSOA*/
                      BEGIN
                          DELETE FROM R088CON WHERE IDTPES = l_r088con.IDTPES AND NUMFIS = p_numfis AND TECCRA = p_teccra;
                      EXCEPTION
                          WHEN OTHERS THEN
                              RAISERROR 103 'R069FIS_AtuCon: Erro ao deletar r088con.';
                      END;
                      /*atualiza a associação entre pessoa e veículo*/
                      SP_VEIPESCON('U', p_numcra, 0, l_r088con.SITCRA, l_r088con.PLAVEI, l_datval, l_horval
                                 , l_tippes, l_numemp, l_tipcol, l_numcad, l_tipdoc, l_numdoc);
                  END LOOP;
              END IF;

              /*Verifica se o crachá deletado é principal*/
              BEGIN
                  SELECT CHCPRI INTO l_chcpri FROM R070CON WHERE NUMFIS = p_numfis;
              EXCEPTION
                WHEN OTHERS THEN
                  l_chcpri := -1;
              END; 

	      /*Obtem o Crachá Principal Atual*/
              SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
              /*Efetuar a Troca dos Crachás*/
              IF (l_crapri = 0) THEN
                  l_crapri := p_numcra;
                  l_tecpri := 1;
              END IF;              

              /*Se o Crachá Excluído é diferente do principal, então exclui */
              IF (l_chcpri > 0) THEN
                  /*Deleta na Controle para evitar Violação de Chave*/
                  BEGIN
                      DELETE FROM R070CON WHERE NUMFIS = p_numfis;
                  EXCEPTION
                      WHEN OTHERS THEN RAISERROR 103 'TR069FIS_ATUCON 3: Problemas ao Excluir o Crachá da Tabela R070CON.';
                  END;             

              ELSE
                  /*Se o Crachá Excluído é o principal*/
                  IF (l_chcpri = 0) AND (l_crapri <> p_numfis) AND (p_teccra <> 1) THEN                      

		      /*Deleta na R070CON para evitar Violação de Chave*/
                      BEGIN
                          DELETE FROM R070CON WHERE NUMFIS = l_crapri;
                      EXCEPTION
                          WHEN OTHERS THEN RAISERROR 103 'TR069FIS_ATUCON 4: Problemas ao Excluir o Crachá da Tabela R070CON.';
                      END;
                      /*Efetua o UPDATE para o Novo crachá Principal*/
                      UPDATE R070CON SET NUMFIS = l_crapri, TECCRA = l_tecpri WHERE NUMFIS = p_numfis;

                      
                      /*Atualiza os demais crachás para apontar para o novo principal*/
                      /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
                      IF (l_tecpri = 1) THEN
                          /*Atualiza o crachá de proximidade*/
                          IF (l_numpro <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numpro;
                          END IF;
                          /*Atualiza o crachá Smart*/
                          IF (l_numsma <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numsma;
                          END IF;
                      /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
                      ELSIF (l_tecpri = 2) THEN
                          /*Atualiza o crachá Smart*/
                          IF (l_numsma <> 0) THEN
                              UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numsma;
                          END IF;
                      END IF;
                  END IF;
              END IF;
          END IF;
      END IF;
  END IF;
END␀`Ù␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
çPROCEDURE R070BLC_ATUCON(P_TIPOPE CHAR,P_NUMCRA NUMBER,P_CODMOT NUMBER)
 IS

l_crastr       CHAR(12);
  l_comando_nulo BOOLEAN;
  l_situa        CHAR(1);
  l_sequencia    NUMBER;
  l_count        NUMBER;
BEGIN
  NULL;
END		SENIOR;20BSP_MAPFIS
SP_UPDFAL
SP_UPDFIS
SP_ATUTSI
SP_INTSTR
SP_PEND83
␀␀PROCEDURE R070BLC_ATUCON(P_TIPOPE CHAR,P_NUMCRA NUMBER(12),P_CODMOT NUMBER)
 IS

l_situa        CHAR(1);
  l_blofal       NUMBER(2);
  l_count        NUMBER;
  l_SitAux       NUMBER(2);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_desMot       VARCHAR2(30);
  l_tipOpe       NUMBER(1);
  l_craStr       CHAR(12);  
BEGIN
    l_count := 0;
    /* Verifica se Colaborador possui Cracha */
    IF   p_numcra <> 0  THEN

       /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
       SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
       IF (l_crapri = 0) THEN
           l_crapri := p_numcra;
       END IF;
       /* Verifica se é bloqueio por Falta */
       BEGIN
           SELECT MOTBLO INTO l_blofal FROM R070DAC;
       EXCEPTION
           WHEN OTHERS THEN l_blofal := 0;
       END;

       /* verifica se o crachá esta na lista de bloqueio. se sim o crachá permanece bloqueado */
       BEGIN
           SELECT COUNT(*) INTO l_count FROM R058LNG WHERE NUMCRA = p_numcra;
       EXCEPTION
           WHEN NO_DATA_FOUND THEN l_count := 0;
           WHEN OTHERS THEN NULL;
       END;

        IF   (p_tipope = 'I') THEN
             l_situa := '1';
        ELSE
            l_situa := '0';
        END IF;

        /* atualiza r070con */
        l_sitAux := CONVERT(CHAR_TO_NUMBER,l_situa);
        IF  (l_blofal = p_codmot) THEN
            BEGIN
                UPDATE R070CON SET BLOFAL = l_SitAux WHERE NUMFIS = l_crapri;
            EXCEPTION
                WHEN OTHERS THEN NULL;
            END;
            /*Atualiza os demais crachás na R070CON*/
            SP_UPDFAL(p_numcra,l_sitAux);
        ELSE
            /*Se alterar o Situa, altera para os demais crachás.*/
            /*UPDATE na R070CON.SITCRA*/
            SP_UPDFIS(p_numcra,l_SitAux,' ');
        END IF;

        /*Atualiza a Controle*/
        BEGIN
            SELECT IDTPES INTO l_idtpes FROM R070CON WHERE NUMCRA = p_numcra AND NUMFIS = l_crapri;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);


        /* Envia pendência para informar sobre crachá extraviado */
        BEGIN
            SELECT DESMOT INTO l_desmot FROM R070MBL WHERE CODMOT = p_codmot;
        EXCEPTION
            WHEN OTHERS THEN l_desmot := '';
        END;

        IF   (p_tipope = 'I') THEN
             l_tipOpe := 2;
        ELSE
             l_tipOpe := 3;
        END IF;

        SP_INTSTR(p_numcra,'999999999999',l_craStr OUT);

        SP_PEND83(l_craStr, l_tipOpe, 2, l_desMot);
  END IF;
END		SENIOR;23BSP_MAPFIS
SP_UPDFAL
SP_UPDFIS
SP_ATUTSI
SP_INTSTR
SP_PEND83
␀␀PROCEDURE R070BLC_ATUCON(P_TIPOPE CHAR,P_NUMCRA NUMBER(12),P_CODMOT NUMBER)
 IS

l_situa        CHAR(1);
  l_blofal       NUMBER(2);
  l_count        NUMBER;
  l_SitAux       NUMBER(2);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_desMot       VARCHAR2(30);
  l_tipOpe       NUMBER(1);
  l_craStr       CHAR(12);  
BEGIN
    l_count := 0;
    /* Verifica se Colaborador possui Cracha */
    IF   p_numcra <> 0  THEN

       /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
       SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
       IF (l_crapri = 0) THEN
           l_crapri := p_numcra;
       END IF;
       /* Verifica se é bloqueio por Falta */
       BEGIN
           SELECT MOTBLO INTO l_blofal FROM R070DAC;
       EXCEPTION
           WHEN OTHERS THEN l_blofal := 0;
       END;

       /* verifica se o crachá esta na lista de bloqueio. se sim o crachá permanece bloqueado */
       BEGIN
           SELECT COUNT(*) INTO l_count FROM R058LNG WHERE NUMCRA = p_numcra;
       EXCEPTION
           WHEN NO_DATA_FOUND THEN l_count := 0;
           WHEN OTHERS THEN NULL;
       END;

        IF   (p_tipope = 'I') THEN
             l_situa := '1';
        ELSE
            l_situa := '0';
        END IF;

        /* atualiza r070con */
        l_sitAux := CONVERT(CHAR_TO_NUMBER,l_situa);
        IF  (l_blofal = p_codmot) THEN
            BEGIN
                UPDATE R070CON SET BLOFAL = l_SitAux WHERE NUMFIS = l_crapri;
            EXCEPTION
                WHEN OTHERS THEN NULL;
            END;
            /*Atualiza os demais crachás na R070CON*/
            SP_UPDFAL(p_numcra,l_sitAux);
        ELSE
            /*Se alterar o Situa, altera para os demais crachás.*/
            /*UPDATE na R070CON.SITCRA*/
            SP_UPDFIS(p_numcra,l_SitAux,' ');
        END IF;

        /*Atualiza a Controle*/
        BEGIN
            SELECT IDTPES INTO l_idtpes FROM R070CON WHERE NUMCRA = p_numcra AND NUMFIS = l_crapri;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);


        /* Envia pendência para informar sobre crachá extraviado */
        BEGIN
            SELECT DESMOT INTO l_desmot FROM R070MBL WHERE CODMOT = p_codmot;
        EXCEPTION
            WHEN OTHERS THEN l_desmot := '';
        END;

        IF   (p_tipope = 'I') THEN
             l_tipOpe := 2;
        ELSE
             l_tipOpe := 3;
        END IF;

        SP_INTSTR(p_numcra,'999999999999',l_craStr OUT);

        SP_PEND83(l_craStr, l_tipOpe, 2, l_desMot);
  END IF;
END		SENIOR;217SP_MAPFIS
