  p_crefx4 := l_crefx4;
  p_fx4 := l_fx4;
  p_crefx5 := l_crefx5;
  p_fx5 := l_fx5;
  p_crefx6 := l_crefx6;
  p_fx6 := l_fx6;
END		SENIOR;23SP_INTSTR
¦␀␀

PROCEDURE SP_RETCAP(P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_CREFX1 OUT CHAR(2),P_FX1 OUT CHAR(8),P_CREFX2 OUT CHAR(2),P_FX2 OUT CHAR(8),P_CREFX3 OUT CHAR(2),P_FX3 OUT CHAR(8),P_CREFX4 OUT CHAR(2),P_FX4 OUT CHAR(8),P_CREFX5 OUT CHAR(2),P_FX5 OUT CHAR(8),P_CREFX6 OUT CHAR(2),P_FX6 OUT CHAR(8))
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_verplf      NUMBER(3);
  l_codplf      NUMBER(7);
  l_inifai      CHAR(4);
  l_fimfai      CHAR(4);
  l_faixa       CHAR(8);
  l_salatu      CHAR(2);
  l_crefx1      CHAR(2);
  l_fx1         CHAR(8);
  l_crefx2      CHAR(2);
  l_fx2         CHAR(8);
  l_crefx3      CHAR(2);
  l_fx3         CHAR(8);
  l_crefx4      CHAR(2);
  l_fx4         CHAR(8);
  l_crefx5      CHAR(2);
  l_fx5         CHAR(8);
  l_crefx6      CHAR(2);
  l_fx6         CHAR(8);

  CURSOR c_r070CAP IS
       SELECT INIFAI,FIMFAI,SALATU
         FROM R070CAP
        WHERE R070CAP.TIPDOC = p_tipdoc
          AND R070CAP.NUMDOC = p_numdoc
          AND R070CAP.DATINI <= l_data_atual
          AND (R070CAP.DATFIM = l_data_zero OR R070CAP.DATFIM > l_data_atual OR R070CAP.DATFIM = l_data_atual)
          AND R070CAP.VERPLF = l_verplf
          AND R070CAP.CODPLF = l_codplf;

  TYPE t_r070CAP IS RECORD(
    INIFAI   R070CRP.INIFAI%TYPE,
    FIMFAI   R070CRP.FIMFAI%TYPE,
    SALATU   R070CRP.SALATU%TYPE);
  l_r070CAP t_r070CAP;

BEGIN
  /* Inicializa */
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';

  /*Busca versão do plano ativa*/
  l_codplf := 0;
  BEGIN
      SELECT VERPLF INTO l_verplf
        FROM R058VPL
       WHERE DATCRI <= l_data_atual
         AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
  EXCEPTION
      WHEN OTHERS THEN
          l_verplf := 1;
  END;

  l_crefx1 := '00';
  l_fx1 := '24002400';
  l_crefx2 := '00';
  l_fx2 := '24002400';
  l_crefx3 := '00';
  l_fx3 := '24002400';
  l_crefx4 := '00';
  l_fx4 := '24002400';
  l_crefx5 := '00';
  l_fx5 := '24002400';
  l_crefx6 := '00';
  l_fx6 := '24002400';

  FOREACH c_R070CAP INTO  l_R070CAP.inifai,
                          l_R070CAP.fimfai,
                          l_R070CAP.salatu
  LOOP
      SP_INTSTR(l_R070CAP.inifai,'HHMM',l_inifai OUT);
      SP_INTSTR(l_R070CAP.fimfai,'HHMM',l_fimfai OUT);

      IF (l_R070CAP.SalAtu > 0) THEN
        SP_INTSTR(l_R070CAP.salatu,'99',l_salatu OUT);
      ELSE
        l_salatu := 0;
      END IF;

      l_faixa := l_inifai || l_fimfai;

      IF    l_fx1 = '24002400' THEN
           l_fx1 := l_faixa;
           l_crefx1 := l_salatu;
      ELSIF l_fx2 = '24002400' THEN
           l_fx2 := l_faixa;
           l_crefx2 := l_salatu;
      ELSIF l_fx3 = '24002400' THEN
           l_fx3 := l_faixa;
           l_crefx3 := l_salatu;
      ELSIF l_fx4 = '24002400' THEN
           l_fx4 := l_faixa;
           l_crefx4 := l_salatu;
      ELSIF l_fx5 = '24002400' THEN
           l_fx5 := l_faixa;
           l_crefx5 := l_salatu;
      ELSIF l_fx6 = '24002400' THEN
           l_fx6 := l_faixa;
           l_crefx6 := l_salatu;
      END IF;
  END LOOP;

  p_crefx1 := l_crefx1;
  p_fx1 := l_fx1;
  p_crefx2 := l_crefx2;
  p_fx2 := l_fx2;
  p_crefx3 := l_crefx3;
  p_fx3 := l_fx3;
  p_crefx4 := l_crefx4;
  p_fx4 := l_fx4;
  p_crefx5 := l_crefx5;
  p_fx5 := l_fx5;
  p_crefx6 := l_crefx6;
  p_fx6 := l_fx6;
END		SENIOR;24SP_INTSTR
¦␀␀

