'.␀␀PROCEDURE R038HCH_ATUBIO(P_CRANEW NUMBER(12),P_CRAOLD NUMBER(12))
 IS

  l_cranew    CHAR(12);
  l_craold    CHAR(12);
  l_exemapa   BOOLEAN;
  l_exebios   BOOLEAN;
  l_exegeom   BOOLEAN;
  l_exesage   BOOLEAN;
  l_comando   CHAR(2048);
  l_mapbio    CHAR(1); 
  l_cntdig    CHAR(1); 
  l_digver    CHAR(1); 
  l_digomo    CHAR(1); 
  l_digsag    CHAR(1);
  l_count     NUMBER;
  l_usutel    VARCHAR(31);
  l_retstr    VARCHAR(1);
  l_reterr    NUMBER(1);
  l_icardR    VARCHAR2(12);
  l_numser    VARCHAR2(12);

  /*CURSOR para verificar os tipos de leitoras*/
  CURSOR c_r058rlg IS
      SELECT DISTINCT TIPLEI FROM R058RLG WHERE TIPLEI IN (3,7,8,9,10,12,13,14,15,16,17);
  TYPE t_r058rlg IS RECORD(
    TIPLEI   R058RLG.TIPLEI%TYPE);
  l_r058rlg t_r058rlg;

BEGIN
  SP_USUTEL(l_usutel OUT);  
  
  BEGIN
      SELECT MAPBIO, CNTDIG, DIGVER, DIGOMO, DIGSAG
      INTO l_mapbio, l_cntdig, l_digver, l_digomo, l_digsag
      FROM R070TSI;
  EXCEPTION
    WHEN OTHERS THEN
      l_mapbio := 'N';
      l_cntdig := 'N';
      l_digver := 'N';
      l_digomo := 'N';
      l_digsag := 'N';
  END;

  IF l_mapbio = 'S' THEN
      /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
      SP_RETICARD(NULL, p_cranew, l_cranew OUT, l_icardR OUT, l_numser OUT);
      SP_RETICARD(NULL, p_craold, l_craold OUT, l_icardR OUT, l_numser OUT);  
  
      /*Variaveis de controle*/
      l_exemapa := TRUE;
      l_exebios := TRUE;
      l_exegeom := TRUE;
      l_exesage := TRUE;

      BEGIN
          FOREACH c_r058rlg INTO l_r058rlg.tiplei
          LOOP
              IF l_exemapa = TRUE THEN
                  l_count := 0;
                  BEGIN
                      l_comando := 'SELECT COUNT(*) FROM '||l_usutel||'MAPABIO WHERE ICARD = '''||l_craold||'''';
                      SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
                      /*NO DATA FOUND E TO MANY ROWS*/
                      IF (l_reterr = 1) OR (l_reterr = 2) THEN
                          l_count := 0;
                      END IF;
                  EXCEPTION
                      WHEN OTHERS THEN l_count := 0;
                  END;
                  IF (l_count > 0) THEN
                      l_comando := 'DELETE FROM '||l_usutel||'MAPABIO WHERE ICARD = '''||l_cranew||'''';
                      SP_CMDTSI(l_comando);
                      l_comando := 'UPDATE '||l_usutel||'MAPABIO SET ICARD = '''||l_cranew||''' WHERE ICARD = '''||l_craold||'''';
                      SP_CMDTSI(l_comando);
                      l_exemapa:= FALSE;
                  END IF;
              END IF;
              /*Tipo de leitora Biométrico Sony. Não é necessário variável de controle pois o SELECT garante que será executado apenas uma vez*/
              IF  l_r058rlg.tiplei = 3 AND l_cntdig = 'S' THEN
                  l_count := 0;
                  BEGIN
                    /* ORACLE */
                    l_comando := 'SELECT COUNT(*) FROM '||l_usutel||'CONTDIG WHERE ICARD = '''||l_craold||'''';
                    SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
                    /*NO DATA FOUND E TO MANY ROWS*/
                    IF (l_reterr = 1) OR (l_reterr = 2) THEN
                        l_count := 0;
                    END IF;
                  EXCEPTION
                      WHEN OTHERS THEN l_count := 0;
                  END;

                  IF  (l_count > 0) THEN
                      l_comando := 'DELETE FROM '||l_usutel||'CONTDIG WHERE ICARD = '''||l_cranew||'''';
                      SP_CMDTSI(l_comando);

                      l_comando := 'UPDATE '||l_usutel||'CONTDIG SET ICARD = '''||l_cranew||''' WHERE ICARD = '''||l_craold||'''';
                      SP_CMDTSI(l_comando);

	                  /* se retirou o registro na tabela de biometria, muda para não gerar a lista com o crachá anterior, só com o novo */
	                  BEGIN
	                      UPDATE R070ACR SET NUMCRA = p_cranew WHERE NUMCRA = p_craold AND TIPLIS = 27 AND STAATU = 0;
	                  EXCEPTION
	                      WHEN OTHERS THEN l_count := NULL;
	                  END;
                      
                  END IF;
                  
              /*Tipo de leitora BioScrypt - Contdig_veri*/
              ELSIF (l_r058rlg.tiplei = 7 OR l_r058rlg.tiplei = 8) AND (l_digver = 'S') THEN
                  IF l_exebios = TRUE THEN
                     l_count := 0;
                     BEGIN
                         l_comando := 'SELECT COUNT(*) FROM '||l_usutel||'CONTDIG_VERI WHERE ICARD = '''||l_craold||'''';
                         SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
                         /*NO DATA FOUND E TO MANY ROWS*/
                         IF (l_reterr = 1) OR (l_reterr = 2) THEN
                             l_count := 0;
                         END IF;
                     EXCEPTION
                         WHEN OTHERS THEN l_count := 0;
                     END;

                     IF  (l_count > 0) THEN
                         l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_VERI WHERE ICARD = '''||l_cranew||'''';
                         SP_CMDTSI(l_comando);
                         l_comando := 'UPDATE '||l_usutel||'CONTDIG_VERI SET ICARD = '''||l_cranew||''' WHERE ICARD = '''||l_craold||'''';
                         SP_CMDTSI(l_comando);
                         
		                 /* se retirou o registro na tabela de biometria, muda para não gerar a lista com o crachá anterior, só com o novo */
		                 BEGIN
		                     UPDATE R070ACR SET NUMCRA = p_cranew WHERE NUMCRA = p_craold AND TIPLIS = 27 AND STAATU = 0;
		                 EXCEPTION
		                     WHEN OTHERS THEN l_count := NULL;
		                 END;                         
                         
                         l_exebios:= FALSE;
                     END IF;

                  END IF;
              /*Tipo de leitora Geomok*/
              ELSIF  (l_r058rlg.tiplei = 9 OR l_r058rlg.tiplei = 10) AND (l_digomo = 'S') THEN
                  IF  l_exegeom = TRUE THEN
                      l_count := 0;
                      BEGIN
                          l_comando := 'SELECT COUNT(*) FROM '||l_usutel||'CONTDIG_OMOK WHERE ICARD = '''||l_craold||'''';
                          SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
                          /*NO DATA FOUND E TO MANY ROWS*/
                          IF (l_reterr = 1) OR (l_reterr = 2) THEN
                              l_count := 0;
                          END IF;

                      EXCEPTION
                          WHEN OTHERS THEN l_count := 0;
                      END;

                      IF (l_count > 0) THEN
                          l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_OMOK WHERE ICARD = '''||l_cranew||'''';
                          SP_CMDTSI(l_comando);
                          l_comando := 'UPDATE '||l_usutel||'CONTDIG_OMOK SET ICARD = '''||l_cranew||''' WHERE ICARD = '''||l_craold||'''';
                          SP_CMDTSI(l_comando);
                          
		                  /* se retirou o registro na tabela de biometria, muda para não gerar a lista com o crachá anterior, só com o novo */
		                  BEGIN
		                      UPDATE R070ACR SET NUMCRA = p_cranew WHERE NUMCRA = p_craold AND TIPLIS = 27 AND STAATU = 0;
		                  EXCEPTION
		                      WHEN OTHERS THEN l_count := NULL;
		                  END;                          
                          
                          l_exegeom:= FALSE;
                      END IF;
                  END IF;
              /*Tipo de leitora Sagem*/
              ELSIF  (l_r058rlg.tiplei = 12 OR l_r058rlg.tiplei = 13 OR l_r058rlg.tiplei = 16) AND (l_digsag = 'S') THEN
                  IF  l_exesage = TRUE THEN
                      l_count := 0;
                      BEGIN
                          l_comando := 'SELECT COUNT(*) FROM '||l_usutel||'CONTDIG_SAGEM WHERE ICARD = '''||l_craold||'''';
                          SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
                          /*NO DATA FOUND E TO MANY ROWS*/
                          IF (l_reterr = 1) OR (l_reterr = 2) THEN
                              l_count := 0;
                          END IF;
                      EXCEPTION
                          WHEN OTHERS THEN l_count := 0;
                      END;

                      IF  (l_count > 0) THEN
                          l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_SAGEM WHERE ICARD = '''||l_cranew||'''';
                          SP_CMDTSI(l_comando);

                          l_comando := 'UPDATE '||l_usutel||'CONTDIG_SAGEM SET ICARD = '''||l_cranew||''' WHERE ICARD = '''||l_craold||'''';
                          SP_CMDTSI(l_comando);
                          
		                  /* se retirou o registro na tabela de biometria, muda para não gerar a lista com o crachá anterior, só com o novo */
		                  BEGIN
		                      UPDATE R070ACR SET NUMCRA = p_cranew WHERE NUMCRA = p_craold AND TIPLIS = 27 AND STAATU = 0;
		                  EXCEPTION
		                      WHEN OTHERS THEN l_count := NULL;
		                  END;                          
                          
                          l_exesage:= FALSE;
                      END IF;
                  END IF;
              /*Tipo de leitora Suprema*/
              ELSIF  (l_r058rlg.tiplei = 14 OR l_r058rlg.tiplei = 15 OR l_r058rlg.tiplei = 17) AND (l_digsag = 'S') THEN
                  IF  l_exesage = TRUE THEN
                      l_count := 0;
                      BEGIN
                          l_comando := 'SELECT COUNT(*) FROM '||l_usutel||'CONTDIG_TSI1 WHERE ICARD = '''||l_craold||'''';
                          SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
                          /*NO DATA FOUND E TO MANY ROWS*/
                          IF (l_reterr = 1) OR (l_reterr = 2) THEN
                              l_count := 0;
                          END IF;
                      EXCEPTION
                          WHEN OTHERS THEN l_count := 0;
                      END;

                    IF  (l_count > 0) THEN
                        l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_TSI1 WHERE ICARD = '''||l_cranew||'''';
                        SP_CMDTSI(l_comando);

                        l_comando := 'UPDATE '||l_usutel||'CONTDIG_TSI1 SET ICARD = '''||l_cranew||''' WHERE ICARD = '''||l_craold||'''';
                        SP_CMDTSI(l_comando);
                        
		                /* se retirou o registro na tabela de biometria, muda para não gerar a lista com o crachá anterior, só com o novo */
		                BEGIN
		                    UPDATE R070ACR SET NUMCRA = p_cranew WHERE NUMCRA = p_craold AND TIPLIS = 27 AND STAATU = 0;
		                EXCEPTION
		                    WHEN OTHERS THEN l_count := NULL;
		                END;
	                  
                        l_exesage:= FALSE;
                    END IF;
                  END IF;
              END IF;
          END LOOP;
      EXCEPTION
          WHEN OTHERS THEN l_exemapa := FALSE;
                           l_exebios := FALSE;
                           l_exegeom := FALSE;
                           l_exesage := FALSE;
      END;
  END IF;
END		SENIOR;23DSP_USUTEL
SP_INTSTR
SP_MAPFIS
SP_SELTSI
SP_CMDTSI
SP_RETICARD
'.␀␀PROCEDURE R038HCH_ATUBIO(P_CRANEW NUMBER(12),P_CRAOLD NUMBER(12))
 IS

  l_cranew    CHAR(12);
  l_craold    CHAR(12);
  l_exemapa   BOOLEAN;
  l_exebios   BOOLEAN;
  l_exegeom   BOOLEAN;
  l_exesage   BOOLEAN;
  l_comando   CHAR(2048);
  l_mapbio    CHAR(1); 
  l_cntdig    CHAR(1); 
  l_digver    CHAR(1); 
  l_digomo    CHAR(1); 
  l_digsag    CHAR(1);
  l_count     NUMBER;
  l_usutel    VARCHAR(31);
  l_retstr    VARCHAR(1);
  l_reterr    NUMBER(1);
  l_icardR    VARCHAR2(12);
  l_numser    VARCHAR2(12);

  /*CURSOR para verificar os tipos de leitoras*/
  CURSOR c_r058rlg IS
      SELECT DISTINCT TIPLEI FROM R058RLG WHERE TIPLEI IN (3,7,8,9,10,12,13,14,15,16,17);
  TYPE t_r058rlg IS RECORD(
    TIPLEI   R058RLG.TIPLEI%TYPE);
  l_r058rlg t_r058rlg;

BEGIN
  SP_USUTEL(l_usutel OUT);  
  
  BEGIN
      SELECT MAPBIO, CNTDIG, DIGVER, DIGOMO, DIGSAG
      INTO l_mapbio, l_cntdig, l_digver, l_digomo, l_digsag
      FROM R070TSI;
  EXCEPTION
    WHEN OTHERS THEN
      l_mapbio := 'N';
      l_cntdig := 'N';
      l_digver := 'N';
      l_digomo := 'N';
      l_digsag := 'N';
  END;

  IF l_mapbio = 'S' THEN
      /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
      SP_RETICARD(NULL, p_cranew, l_cranew OUT, l_icardR OUT, l_numser OUT);
      SP_RETICARD(NULL, p_craold, l_craold OUT, l_icardR OUT, l_numser OUT);  
  
      /*Variaveis de controle*/
      l_exemapa := TRUE;
      l_exebios := TRUE;
      l_exegeom := TRUE;
      l_exesage := TRUE;

      BEGIN
          FOREACH c_r058rlg INTO l_r058rlg.tiplei
          LOOP
              IF l_exemapa = TRUE THEN
                  l_count := 0;
                  BEGIN
                      l_comando := 'SELECT COUNT(*) FROM '||l_usutel||'MAPABIO WHERE ICARD = '''||l_craold||'''';
                      SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
                      /*NO DATA FOUND E TO MANY ROWS*/
                      IF (l_reterr = 1) OR (l_reterr = 2) THEN
                          l_count := 0;
                      END IF;
                  EXCEPTION
                      WHEN OTHERS THEN l_count := 0;
                  END;
                  IF (l_count > 0) THEN
                      l_comando := 'DELETE FROM '||l_usutel||'MAPABIO WHERE ICARD = '''||l_cranew||'''';
                      SP_CMDTSI(l_comando);
                      l_comando := 'UPDATE '||l_usutel||'MAPABIO SET ICARD = '''||l_cranew||''' WHERE ICARD = '''||l_craold||'''';
                      SP_CMDTSI(l_comando);
                      l_exemapa:= FALSE;
                  END IF;
              END IF;
              /*Tipo de leitora Biométrico Sony. Não é necessário variável de controle pois o SELECT garante que será executado apenas uma vez*/
              IF  l_r058rlg.tiplei = 3 AND l_cntdig = 'S' THEN
                  l_count := 0;
                  BEGIN
                    /* ORACLE */
                    l_comando := 'SELECT COUNT(*) FROM '||l_usutel||'CONTDIG WHERE ICARD = '''||l_craold||'''';
                    SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
                    /*NO DATA FOUND E TO MANY ROWS*/
                    IF (l_reterr = 1) OR (l_reterr = 2) THEN
                        l_count := 0;
                    END IF;
                  EXCEPTION
                      WHEN OTHERS THEN l_count := 0;
                  END;

                  IF  (l_count > 0) THEN
                      l_comando := 'DELETE FROM '||l_usutel||'CONTDIG WHERE ICARD = '''||l_cranew||'''';
                      SP_CMDTSI(l_comando);

                      l_comando := 'UPDATE '||l_usutel||'CONTDIG SET ICARD = '''||l_cranew||''' WHERE ICARD = '''||l_craold||'''';
                      SP_CMDTSI(l_comando);

	                  /* se retirou o registro na tabela de biometria, muda para não gerar a lista com o crachá anterior, só com o novo */
	                  BEGIN
	                      UPDATE R070ACR SET NUMCRA = p_cranew WHERE NUMCRA = p_craold AND TIPLIS = 27 AND STAATU = 0;
	                  EXCEPTION
	                      WHEN OTHERS THEN l_count := NULL;
	                  END;
                      
                  END IF;
                  
              /*Tipo de leitora BioScrypt - Contdig_veri*/
              ELSIF (l_r058rlg.tiplei = 7 OR l_r058rlg.tiplei = 8) AND (l_digver = 'S') THEN
                  IF l_exebios = TRUE THEN
                     l_count := 0;
                     BEGIN
                         l_comando := 'SELECT COUNT(*) FROM '||l_usutel||'CONTDIG_VERI WHERE ICARD = '''||l_craold||'''';
                         SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
                         /*NO DATA FOUND E TO MANY ROWS*/
                         IF (l_reterr = 1) OR (l_reterr = 2) THEN
                             l_count := 0;
                         END IF;
                     EXCEPTION
                         WHEN OTHERS THEN l_count := 0;
                     END;

                     IF  (l_count > 0) THEN
                         l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_VERI WHERE ICARD = '''||l_cranew||'''';
                         SP_CMDTSI(l_comando);
                         l_comando := 'UPDATE '||l_usutel||'CONTDIG_VERI SET ICARD = '''||l_cranew||''' WHERE ICARD = '''||l_craold||'''';
                         SP_CMDTSI(l_comando);
                         
		                 /* se retirou o registro na tabela de biometria, muda para não gerar a lista com o crachá anterior, só com o novo */
		                 BEGIN
		                     UPDATE R070ACR SET NUMCRA = p_cranew WHERE NUMCRA = p_craold AND TIPLIS = 27 AND STAATU = 0;
		                 EXCEPTION
		                     WHEN OTHERS THEN l_count := NULL;
		                 END;                         
                         
                         l_exebios:= FALSE;
                     END IF;

                  END IF;
              /*Tipo de leitora Geomok*/
              ELSIF  (l_r058rlg.tiplei = 9 OR l_r058rlg.tiplei = 10) AND (l_digomo = 'S') THEN
                  IF  l_exegeom = TRUE THEN
                      l_count := 0;
                      BEGIN
                          l_comando := 'SELECT COUNT(*) FROM '||l_usutel||'CONTDIG_OMOK WHERE ICARD = '''||l_craold||'''';
                          SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
                          /*NO DATA FOUND E TO MANY ROWS*/
                          IF (l_reterr = 1) OR (l_reterr = 2) THEN
                              l_count := 0;
                          END IF;

                      EXCEPTION
                          WHEN OTHERS THEN l_count := 0;
                      END;

                      IF (l_count > 0) THEN
                          l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_OMOK WHERE ICARD = '''||l_cranew||'''';
                          SP_CMDTSI(l_comando);
                          l_comando := 'UPDATE '||l_usutel||'CONTDIG_OMOK SET ICARD = '''||l_cranew||''' WHERE ICARD = '''||l_craold||'''';
                          SP_CMDTSI(l_comando);
                          
		                  /* se retirou o registro na tabela de biometria, muda para não gerar a lista com o crachá anterior, só com o novo */
		                  BEGIN
		                      UPDATE R070ACR SET NUMCRA = p_cranew WHERE NUMCRA = p_craold AND TIPLIS = 27 AND STAATU = 0;
		                  EXCEPTION
		                      WHEN OTHERS THEN l_count := NULL;
		                  END;                          
                          
                          l_exegeom:= FALSE;
                      END IF;
                  END IF;
              /*Tipo de leitora Sagem*/
              ELSIF  (l_r058rlg.tiplei = 12 OR l_r058rlg.tiplei = 13 OR l_r058rlg.tiplei = 16) AND (l_digsag = 'S') THEN
                  IF  l_exesage = TRUE THEN
                      l_count := 0;
                      BEGIN
                          l_comando := 'SELECT COUNT(*) FROM '||l_usutel||'CONTDIG_SAGEM WHERE ICARD = '''||l_craold||'''';
                          SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
                          /*NO DATA FOUND E TO MANY ROWS*/
                          IF (l_reterr = 1) OR (l_reterr = 2) THEN
                              l_count := 0;
                          END IF;
                      EXCEPTION
                          WHEN OTHERS THEN l_count := 0;
                      END;

                      IF  (l_count > 0) THEN
                          l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_SAGEM WHERE ICARD = '''||l_cranew||'''';
                          SP_CMDTSI(l_comando);

                          l_comando := 'UPDATE '||l_usutel||'CONTDIG_SAGEM SET ICARD = '''||l_cranew||''' WHERE ICARD = '''||l_craold||'''';
                          SP_CMDTSI(l_comando);
                          
		                  /* se retirou o registro na tabela de biometria, muda para não gerar a lista com o crachá anterior, só com o novo */
		                  BEGIN
		                      UPDATE R070ACR SET NUMCRA = p_cranew WHERE NUMCRA = p_craold AND TIPLIS = 27 AND STAATU = 0;
		                  EXCEPTION
		                      WHEN OTHERS THEN l_count := NULL;
		                  END;                          
                          
                          l_exesage:= FALSE;
                      END IF;
                  END IF;
              /*Tipo de leitora Suprema*/
              ELSIF  (l_r058rlg.tiplei = 14 OR l_r058rlg.tiplei = 15 OR l_r058rlg.tiplei = 17) AND (l_digsag = 'S') THEN
                  IF  l_exesage = TRUE THEN
                      l_count := 0;
                      BEGIN
                          l_comando := 'SELECT COUNT(*) FROM '||l_usutel||'CONTDIG_TSI1 WHERE ICARD = '''||l_craold||'''';
                          SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
                          /*NO DATA FOUND E TO MANY ROWS*/
                          IF (l_reterr = 1) OR (l_reterr = 2) THEN
                              l_count := 0;
                          END IF;
                      EXCEPTION
                          WHEN OTHERS THEN l_count := 0;
                      END;

                    IF  (l_count > 0) THEN
                        l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_TSI1 WHERE ICARD = '''||l_cranew||'''';
                        SP_CMDTSI(l_comando);

                        l_comando := 'UPDATE '||l_usutel||'CONTDIG_TSI1 SET ICARD = '''||l_cranew||''' WHERE ICARD = '''||l_craold||'''';
                        SP_CMDTSI(l_comando);
                        
		                /* se retirou o registro na tabela de biometria, muda para não gerar a lista com o crachá anterior, só com o novo */
		                BEGIN
		                    UPDATE R070ACR SET NUMCRA = p_cranew WHERE NUMCRA = p_craold AND TIPLIS = 27 AND STAATU = 0;
		                EXCEPTION
		                    WHEN OTHERS THEN l_count := NULL;
		                END;
	                  
                        l_exesage:= FALSE;
                    END IF;
                  END IF;
              END IF;
          END LOOP;
      EXCEPTION
          WHEN OTHERS THEN l_exemapa := FALSE;
                           l_exebios := FALSE;
                           l_exegeom := FALSE;
                           l_exesage := FALSE;
      END;
  END IF;
END␀©Ô␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_RETCRA
c␀␀PROCEDURE R038HCH_ATULN(P_TIPOPE CHAR,P_TIPCRA NUMBER,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_NUMCRA NUMBER)
 IS

l_data_atual      DATE;
  l_numcra          NUMBER(12);
  l_craprv          NUMBER(12);
  l_cratit          NUMBER(12);
  l_existe          BOOLEAN;

BEGIN
  l_data_atual := CURDATE();

  l_craprv := 0;
  l_cratit := 0;

  /* na inclusão de crachá e na baixa de provisorio verificar */
  IF   (p_tipope = 'I') OR ((p_tipope = 'U') AND (p_tipcra = 2)) OR ((p_tipope = 'D') AND (p_tipcra = 2)) THEN
       IF   p_tipcra = 1 THEN
            SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0, '',0,'',l_craprv OUT);
       ELSE
            SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0, '',0,'',l_cratit OUT);
       END IF;
  END IF;

  IF    (p_tipope = 'I')  THEN  /* ao atribuir um crachá */
         IF   p_tipcra = 1 THEN /* se for cracha titular */
              IF   l_craprv <> 0 THEN /* se existir um provisório ativo */

                   l_existe := TRUE;
                   BEGIN
                     SELECT NUMCRA INTO l_numcra FROM R058LNG WHERE NUMCRA = p_numcra;
                   EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                           l_existe := FALSE;
                   END;

                   /* incluir na lista negra o titular */
                   IF  (l_existe = FALSE) THEN
                       INSERT INTO R058LNG (NUMCRA,ORIINC,DATINC,CODUSU)
                       VALUES (p_numcra,4,l_data_atual,0);
                   END IF;

              ELSE
                   /* eliminar da lista negra o titular (caso esteja) */
                   BEGIN
                     DELETE FROM R058LNG WHERE NUMCRA = p_numcra;
                   EXCEPTION WHEN OTHERS THEN
                     NULL;
                   END;
              END IF;
         ELSE
              IF   l_cratit <> 0 THEN /* se existir um titular ativo */

                   l_existe := TRUE;
                   BEGIN
                     SELECT NUMCRA INTO l_numcra FROM R058LNG WHERE NUMCRA = l_cratit;
                   EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                           l_existe := FALSE;
                   END;

                   /* incluir na lista negra o titular */
                   IF  (l_existe = FALSE) THEN
                       INSERT INTO R058LNG (NUMCRA,ORIINC,DATINC,CODUSU)
                       VALUES (l_cratit,4,l_data_atual,0);
                   END IF;

              ELSE
                   /* eliminar da lista negra o provisorio (caso esteja) */
                   BEGIN
                     DELETE FROM R058LNG WHERE NUMCRA = p_numcra;
                   EXCEPTION WHEN OTHERS THEN
                     NULL;
                   END;
              END IF;
         END IF;
  ELSIF (p_tipope = 'U') OR (p_tipope = 'D') THEN /* na baixa do cracha e exclusão do crachá */

         IF   p_tipcra = 2 THEN /* se for cracha provisorio */

              IF   l_cratit <> 0 THEN /* se existir um titular ativo */
                   /* eliminar da lista negra o titular (caso esteja) */
                   BEGIN
                     DELETE FROM R058LNG WHERE NUMCRA = l_cratit;
                   EXCEPTION WHEN OTHERS THEN
                     NULL;
                   END;
              END IF;

         END IF;
  END IF;
END␀¬Ô␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
%␀␀PROCEDURE R038HCH_CRABNF(P_TIPCRA NUMBER,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_NUMCRA NUMBER,P_DATINI DATE,P_HORINI NUMBER)
 IS

l_data_zero       DATE;
  l_data_atual      DATE;
  l_craprv          NUMBER(12);
  l_cratit          NUMBER(12);
  l_craAux          NUMBER(12);
  l_hora_atual      NUMBER(4);
  l_qtdenb          NUMBER(2);
  l_achou           BOOLEAN;
  l_codbnf          NUMBER(2);
  l_crafis          NUMBER(12);
  l_tipope          CHAR;
  l_somacre         NUMBER;

/* CURSOR c/ os beneficios atuais do colaborador */
  CURSOR c_r057dib IS
         SELECT DATINI,HORINI,CODBNF,QTDENB,QTDREB,DATFIM,HORFIM FROM R057DIB
         WHERE
         NUMEMP = p_numemp AND
         TIPCOL = p_tipcol AND
         NUMCAD = p_numcad
         AND (DATINI <= l_data_atual OR (DATINI = l_data_atual AND HORINI <= l_hora_atual))
         AND (DATFIM >= l_data_atual OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual) OR (DATFIM = l_data_zero));
  TYPE t_r057dib IS RECORD(
    DATINI   R057DIB.DATINI%TYPE,
    HORINI   R057DIB.HORINI%TYPE,
    CODBNF   R057DIB.CODBNF%TYPE,
    QTDENB   R057DIB.QTDENB%TYPE,
    QTDREB   R057DIB.QTDREB%TYPE,
    DATFIM   R057DIB.DATFIM%TYPE,
    HORFIM   R057DIB.HORFIM%TYPE);

  l_r057dib t_r057dib;
BEGIN
  NULL;
END		SENIOR;20&SP_RETCRA
SP_RETFIS
R057DIB_ATUBEN
␀␀PROCEDURE R038HCH_CRABNF(P_TIPCRA NUMBER,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_NUMCRA NUMBER,P_DATINI DATE,P_HORINI NUMBER)
 IS

l_data_zero       DATE;
  l_data_atual      DATE;
  l_craprv          NUMBER(12);
  l_cratit          NUMBER(12);
  l_craAux          NUMBER(12);
  l_hora_atual      NUMBER(4);
  l_qtdenb          NUMBER(2);
  l_achou           BOOLEAN;
  l_codbnf          NUMBER(2);
  l_crafis          NUMBER(12);
  l_tipope          CHAR;
  l_somacre         NUMBER;

/* CURSOR c/ os beneficios atuais do colaborador */
  CURSOR c_r057dib IS
         SELECT DATINI,HORINI,CODBNF,QTDENB,QTDREB,DATFIM,HORFIM FROM R057DIB
         WHERE
         NUMEMP = p_numemp AND
         TIPCOL = p_tipcol AND
         NUMCAD = p_numcad
         AND (DATINI <= l_data_atual OR (DATINI = l_data_atual AND HORINI <= l_hora_atual))
         AND (DATFIM >= l_data_atual OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual) OR (DATFIM = l_data_zero));
  TYPE t_r057dib IS RECORD(
    DATINI   R057DIB.DATINI%TYPE,
    HORINI   R057DIB.HORINI%TYPE,
    CODBNF   R057DIB.CODBNF%TYPE,
    QTDENB   R057DIB.QTDENB%TYPE,
    QTDREB   R057DIB.QTDREB%TYPE,
    DATFIM   R057DIB.DATFIM%TYPE,
    HORFIM   R057DIB.HORFIM%TYPE);

  l_r057dib t_r057dib;
BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  l_achou := FALSE;

  l_craprv := 0;
  IF  p_tipcra = 1 THEN
      /* Se tiver crachá provisório em aberto o crachá atual em uso continua sendo o provisório. */
      SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0, '',0,'',l_craprv OUT);
  ELSE
      /* se for provisório verifica se tem crachá titular e faz um UPDATE na lBenef */
      SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0, '',0,'',l_cratit OUT);
      IF  (l_cratit > 0) THEN
          l_tipope := 'U';
          SP_RETFIS(l_cratit , 0, l_craAux OUT);
      ELSE
          l_tipope := 'I';
          l_craAux := 0;
      END IF;
  END IF;

  /* se tiver crachá provisório o controle fica ainda com o provisório, então não atualiza beneficios */
  IF  l_craprv = 0 THEN

      SP_RETFIS(p_numcra , 0, l_crafis OUT);

      /* Le Registro do CURSOR */
      FOREACH c_r057dib INTO  l_r057dib.DatIni,
                              l_r057dib.HorIni,
                              l_r057dib.CodBnf,
                              l_r057dib.QtdEnb,
                              l_r057dib.QtdReb,
                              l_r057dib.DatFim,
                              l_r057dib.HorFim
      LOOP
           /* testa se o histórico a ser incluído esta presente no periodo atual do beneficio */
           IF  (p_datini > l_r057dib.DatIni OR
               (p_datini = l_r057dib.DatIni AND p_horini >= l_r057dib.HorIni))
           AND ((p_datini < l_r057dib.DatFim) OR (l_r057dib.DatFim = l_data_zero) OR
               (p_datini = l_r057dib.DatFim AND p_horini <= l_r057dib.HorFim)) THEN
               l_achou := TRUE;
               l_qtdenb := l_r057dib.QtdEnb - l_r057dib.QtdReb;
               /* Atualiza Tabela de Beneficios */
               R057DIB_ATUBEN(l_tipope,l_crafis,l_craAux,l_r057dib.CodBnf,l_qtdenb);
           END IF;

      END LOOP;
  END IF;

 /* Se não achou nenhum benefício atual então excluir os beneficios do crachá */
  IF (l_achou = FALSE) THEN
      /* Elimina o crachá de todas as listas. */
      l_codbnf := 1;
      LOOP
          /* verifica se tem créditos pendentes */
          BEGIN
              SELECT SUM(QTDENB)- SUM(QTDREB) SOMACRE INTO l_somacre FROM R057DIB WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                     CODBNF = l_codbnf AND DATINI < p_datini AND STADIB = 0;
          EXCEPTION
              WHEN NO_DATA_FOUND THEN l_somacre := 0;
              WHEN OTHERS THEN l_somacre := 0;
          END;

          IF (l_somacre > 0) THEN
              R057DIB_ATUBEN(l_tipope,l_crafis,l_craAux,l_CodBnf,l_somacre);
          ELSE
              R057DIB_ATUBEN('E',l_crafis,0,l_codbnf,0);
          END IF;
          l_codbnf := l_codbnf + 1;
          /* existem 24 listas de 0 a 23. */
          IF  l_codbnf = 24 THEN
             EXIT;
          END IF;

      END LOOP;
  END IF;
END␀³Ô␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE R038HCH_TITBNF(P_TIPOPE CHAR,P_TIPCRA NUMBER,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_NUMCRA NUMBER)
 IS

l_cratit          CHAR(12);
  l_craprv          CHAR(12);
  l_auxtit          NUMBER(12);
  l_auxprv          NUMBER(12);
  l_indaux          NUMBER(2);
  l_codbnf          VARCHAR2(2);
  l_achou_tit       NUMBER(2);
  l_achou_prv       NUMBER(2);

BEGIN
  NULL;
END		SENIOR;206SP_INTSTR
SP_RETCRA
ExecSql
ExecSql9
SP_RETICARD
>␀␀PROCEDURE R038HCH_TITBNF(P_TIPOPE CHAR,P_TIPCRA NUMBER,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_NUMCRA NUMBER)
 IS

  l_cratit          CHAR(12);
  l_craprv          CHAR(12);
  l_auxtit          NUMBER(12);
  l_auxprv          NUMBER(12);
  l_indaux          NUMBER(2);
  l_codbnf          VARCHAR2(2);
  l_achou_tit       NUMBER(2);
  l_achou_prv       NUMBER(2);
  l_numser    		VARCHAR(12);
  l_icardR    		VARCHAR(12);

BEGIN
  /* verifica o crachá titular e provisório */
  IF  (p_tipcra = 1) THEN
      SP_INTSTR(p_numcra,'999999999999',l_cratit OUT);
      SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0, '',0,'',l_auxprv OUT);
      SP_RETICARD(NULL, l_auxprv, l_craprv OUT , l_icardR OUT, l_numser OUT);
  ELSE
      SP_INTSTR(p_numcra,'999999999999',l_craprv OUT);
      SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0, '',0,'',l_auxtit OUT);
      SP_RETICARD(NULL, l_auxtit, l_cratit OUT , l_icardR OUT, l_numser OUT);
  END IF;

  IF  (p_tipope = 'F') THEN
      /* se estiver fechando um crachá titular o mesmo deve ser excluído */
      /* se estiver fechando um crachá provisório precisa verificar se tem um titular */
      l_indaux := 1;
      LOOP
          SP_INTSTR(l_indaux,'99',l_codbnf OUT);
          IF  (p_tipcra = 1) THEN
              IF (l_cratit > 0) THEN
                  ExecSql('DELETE FROM LBENEF'||l_codbnf||' WHERE ICARD = '''||l_craprv||'''');
                  /* update lbenef SET cracha = l_craprv WHERE cracha = l_cratit*/
                  EXECSQL('UPDATE LBENEF'||l_codbnf||' SET ICARD = '''||l_craprv||''' WHERE ICARD = '''||l_cratit||'''');
              ELSE
                  /* delete lbenef WHERE cracha = l_cratit*/
                  ExecSql('DELETE FROM LBENEF'||l_codbnf||' WHERE ICARD = '''||l_cratit||'''');
              END IF;
          ELSE
              IF (l_cratit > 0) THEN
                  /* delete lbenef WHERE cracha = l_cratit*/
                  ExecSql('DELETE FROM LBENEF'||l_codbnf||' WHERE ICARD = '''||l_cratit||'''');
                  /* update lbenef SET cracha = l_cratit WHERE cracha = l_craprv*/
                  EXECSQL('UPDATE LBENEF'||l_codbnf||' SET ICARD = '''||l_cratit||''' WHERE ICARD = '''||l_craprv||'''');
              ELSE
                  /* delete lbenef WHERE cracha = l_craprv*/
                  ExecSql('DELETE FROM LBENEF'||l_codbnf||' WHERE ICARD = '''||l_craprv||'''');
              END IF;
          END IF;
          l_indaux := l_indaux + 1;
          /* existem 24 listas de 0 a 23. */
          IF  l_indaux = 24 THEN
              EXIT;
          END IF;
      END LOOP;
  ELSE
      l_indaux := 1;
      LOOP
          SP_INTSTR(l_indaux,'99',l_codbnf OUT);

          /* procura o crachá titular/ provisório */
          l_achou_tit := 0;
          BEGIN
              ExecSql9('SELECT 1 FROM LBENEF'||l_codbnf||' WHERE ICARD = '||l_cratit, l_achou_tit);
          EXCEPTION
              WHEN NO_DATA_FOUND THEN l_achou_tit := 0;
              WHEN OTHERS THEN l_achou_tit := 0;
          END;

          l_achou_prv := 0;
          BEGIN
              ExecSql9('SELECT 1 FROM LBENEF'||l_codbnf||' WHERE ICARD = '||l_craprv, l_achou_prv);
          EXCEPTION
              WHEN NO_DATA_FOUND THEN l_achou_prv := 0;
              WHEN OTHERS THEN l_achou_prv := 0;
          END;

          IF  (p_tipcra = 2) AND (l_achou_tit = 1) AND (l_achou_prv = 0) THEN
              ExecSql('DELETE FROM LBENEF'||l_codbnf||' WHERE ICARD = '''||l_craprv||'''');
              EXECSQL('UPDATE LBENEF'||l_codbnf||' SET ICARD = '''||l_craprv||''' WHERE ICARD = '''||l_cratit||'''');          
          END IF;

          l_indaux := l_indaux + 1;
          /* existem 24 listas de 0 a 23. */
          IF  l_indaux = 24 THEN
              EXIT;
          END IF;
      END LOOP;
  END IF;
END␀´Ô␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
3"␀␀PROCEDURE R038HCH_VSOB(P_TIPOPE CHAR,P_TIPCRA NUMBER,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_NUMCRA NUMBER(12),P_DATINI DATE,P_HORINI NUMBER,P_DATFIM DATE,P_HORFIM NUMBER)
 IS

l_data_zero    DATE;
  l_datini       DATE;
  l_datfim       DATE;
  l_datant       DATE;
  l_count        NUMBER(5);
  l_horant       NUMBER(5);
  l_horini       NUMBER(5);
  l_horfim       NUMBER(5);
  l_tipcra  	  NUMBER(2);
  l_tipcol  	  NUMBER(2);
  l_numemp       NUMBER;
  l_numcad       NUMBER;
  l_comando_nulo BOOLEAN;
  l_errstr       VARCHAR2(255);


BEGIN
  /* Faz consistencia de sobreposição de crachá */
  l_count := 0;
  l_data_zero  :='31/12/1900,00:00:00';
  /* Verifica se o crachá esta sendo utilizado por um colaborador de outra unidade */
  BEGIN
    SELECT COUNT(*) INTO l_count
     FROM R070HCH A
    WHERE  (A.NUMCRA = p_numcra)
      AND ( ( (A.DATINI > p_datini OR (A.DATINI = p_datini AND A.HORINI >= p_horini)) AND
              (A.DATINI < p_datfim OR p_DATFIM = l_data_zero OR (A.DATINI = p_datfim AND (A.HORINI <= p_horfim OR p_horfim = 0))) )
       OR   ( (A.DATFIM > p_datini OR A.DATFIM = l_data_zero OR (A.DATFIM = p_datini AND (A.HORFIM >= p_horini OR A.HORFIM = 0))) AND
              ((A.DATFIM < p_datfim AND A.DATFIM <> l_data_zero) OR p_datfim = l_data_zero OR (A.DATFIM = p_datfim AND (A.HORFIM <= p_horfim OR p_horfim = 0)))
       OR   ( (p_datini > A.DATINI OR (p_datini = A.DATINI AND p_horini >= A.HORINI)) AND
              ((p_datfim < A.DATFIM AND p_datfim <> l_data_zero) OR A.DATFIM = l_data_zero OR (p_DATFIM = A.DATFIM AND p_horfim <= A.HORFIM)) ) ) );
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_count:=0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT R070HCH';
  END;
  /* Se não houver sobreposição de crachá em outras unidades */
  IF  l_count = 0 THEN
      /* verifica se já existe um historico para o colaborador ou para o crachá que não seja o que esta sendo incluído */
      BEGIN
        SELECT TIPCRA,NUMEMP,TIPCOL,NUMCAD,DATFIM,HORFIM,COUNT(*) INTO l_tipcra,l_numemp,l_tipcol,l_numcad,l_datfim,l_horfim,l_count
         FROM R038HCH A
        WHERE  (A.TIPCRA <> p_tipcra OR A.NUMEMP <> p_numemp OR A.TIPCOL <> p_tipcol OR A.NUMCAD <> p_numcad OR A.DATINI <> p_datini OR A.HORINI <> p_horini)
          AND  ((A.TIPCRA = p_tipcra AND  A.NUMEMP = p_numemp AND  A.TIPCOL = p_tipcol AND A.NUMCAD = p_numcad) OR (A.NUMCRA = p_numcra))
          AND ( ( (A.DATINI > p_datini OR (A.DATINI = p_datini AND A.HORINI >= p_horini)) AND
                  (A.DATINI < p_datfim OR p_DATFIM = l_data_zero OR (A.DATINI = p_datfim AND (A.HORINI <= p_horfim OR p_horfim = 0))) )
           OR   ( (A.DATFIM > p_datini OR A.DATFIM = l_data_zero OR (A.DATFIM = p_datini AND (A.HORFIM >= p_horini OR A.HORFIM = 0))) AND
                  ((A.DATFIM < p_datfim AND A.DATFIM <> l_data_zero) OR p_datfim = l_data_zero OR (A.DATFIM = p_datfim AND (A.HORFIM <= p_horfim OR p_horfim = 0)))
           OR   ( (p_datini > A.DATINI OR (p_datini = A.DATINI AND p_horini >= A.HORINI)) AND
                  ((p_datfim < A.DATFIM AND p_datfim <> l_data_zero) OR A.DATFIM = l_data_zero OR (p_DATFIM = A.DATFIM AND p_horfim <= A.HORFIM)) ) ) )
        GROUP BY TIPCRA,NUMEMP,TIPCOL,NUMCAD,DATFIM,HORFIM;
      EXCEPTION
          WHEN TOO_MANY_ROWS THEN
               l_errstr := 'Erro de Sobreposição - TOO MANY ROWS. '||
                           ' Empresa : '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                           ' Tip.Col : '||CONVERT(NUMBER_TO_CHAR,p_tipcol)||
                           ' Cadastro: '||CONVERT(NUMBER_TO_CHAR,p_numcad)||
                           ' Crachá  : '||CONVERT(NUMBER_TO_CHAR,p_numcra);
               RAISERROR 103 l_errstr;
          WHEN NO_DATA_FOUND THEN
               l_count:=0;
               l_comando_nulo:=TRUE;
          WHEN OTHERS THEN
               RAISERROR 103 'Erro no SELECT R038HCH-1';
      END;
      IF  l_count > 0 THEN
          /* se estiver inserindo e for o mesmo colaborador que sobrepos */
          IF   (p_tipope = 'I') AND
               (l_tipcra = p_tipcra) AND
               (l_numemp = p_numemp) AND
               (l_tipcol = p_tipcol) AND
               (l_numcad = p_numcad) AND
               ((p_datini > l_datfim) OR (l_datfim = l_data_zero) OR
                ((p_datini = l_datfim) AND ((p_horini > l_horfim) AND (l_horfim <> 0)))) THEN
               /* Se tiver incluindo fechar o ultimo cracha */
               /* verifica se a sobreposição esta no ultimo historico */
               /* pega o ultimo historico em aberto checando também se*/
               /* não esta tentando incluir o mesmo número de crachá*/
               l_comando_nulo:=TRUE;
               BEGIN
                SELECT A.DATINI,A.HORINI INTO l_datini,l_horini
                FROM R038HCH A
                WHERE A.TIPCRA = p_tipcra
                  AND A.NUMEMP = p_numemp
                  AND A.TIPCOL = p_tipcol
                  AND A.NUMCAD = p_numcad
                  AND A.NUMCRA <> p_numcra
                  AND A.DATFIM = l_data_zero
                  AND A.DATINI IN (SELECT MAX(DATINI) FROM R038HCH
                                 WHERE   TIPCRA = p_tipcra
                                   AND   NUMEMP = p_numemp
                                   AND   TIPCOL = p_tipcol
                                   AND   NUMCAD = p_numcad
                                   AND   (DATINI < p_datini OR
                                         (DATINI = p_datini AND HORINI < p_horini)))
                  AND A.HORINI IN (SELECT MAX(HORINI) FROM R038HCH
                                  WHERE   TIPCRA = p_tipcra
                                    AND   NUMEMP = p_numemp
                                    AND   TIPCOL = p_tipcol
                                    AND   NUMCAD = p_numcad
                                    AND   DATINI = A.DATINI);
               EXCEPTION
                 WHEN TOO_MANY_ROWS THEN
                   l_errstr := 'Erro em R038HCH - TOO MANY ROWS. '||
                               ' Empresa : '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                               ' Tip.Col : '||CONVERT(NUMBER_TO_CHAR,p_tipcol)||
                               ' Cadastro: '||CONVERT(NUMBER_TO_CHAR,p_numcad);
                   RAISERROR 103 l_errstr;

                 WHEN NO_DATA_FOUND THEN
                   l_comando_nulo:=FALSE;
                 WHEN OTHERS THEN
                   RAISERROR 103 'Erro no SELECT R038HCH';
               END;
               /* fecha o ultimo historico se este estiver aberto */
               IF   (l_comando_nulo = TRUE) THEN
                    /* se a hora inicial do novo historico for 0 ou 1 min então decrementa o dia e a hora fica = 23:59 */
                    IF  (p_horini = 0) OR (p_horini = 1) THEN
                        l_horant := 1439;
                        l_datant := DATETimeAdd(DD,-1,p_datini);
                    ELSE
                        l_datant := p_datini;
                        l_horant := p_horini-1;
                    END IF;
                    /* fecha o ultimo historico em aberto */
                    UPDATE R038HCH
                    SET DATFIM = l_datant, HORFIM = l_horant
                    WHERE TIPCRA = p_tipcra
                    AND   NUMEMP = p_numemp
                    AND   TIPCOL = p_tipcol
                    AND   NUMCAD = p_numcad
                    AND   DATINI = l_datini
                    AND   HORINI = l_horini;
               ELSE
                    l_errstr := 'Erro de Sobreposição de crachás para Empresa : '||
                                 CONVERT(NUMBER_TO_CHAR,p_numemp)||' Tip.Col : '||
                                 CONVERT(NUMBER_TO_CHAR,p_tipcol)||' Colaborador : '||
                                 CONVERT(NUMBER_TO_CHAR,p_numcad);
                    RAISERROR 103 l_errstr;
               END IF;
               l_comando_nulo:=FALSE;
          ELSE
               l_errstr := 'Erro de Sobreposição de crachás para Empresa = '||
                            CONVERT(NUMBER_TO_CHAR,p_numemp)||' Tip.Col : '||
                            CONVERT(NUMBER_TO_CHAR,p_tipcol)||' Colaborador : '||
                            CONVERT(NUMBER_TO_CHAR,p_numcad)||' Crachá : '||
                            CONVERT(NUMBER_TO_CHAR,p_numcra);
               RAISERROR 103 l_errstr;
          END IF;
      END IF;
  ELSE
      l_errstr := 'Sobreposição de crachás com Histórico de Outras Unidades para Crachá = '||
                   CONVERT(NUMBER_TO_CHAR,p_numcra);
      RAISERROR 103 l_errstr;
  END IF;
END␀¿Ô␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
¥PROCEDURE R038HCT_ATUCON(P_TIPOPE CHAR,P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_CODOEM NUMBER,P_NUMCON VARCHAR2(16),P_DATFIM DATE)
 IS
BEGIN
  NULL;
END		SENIOR;20BSP_RETCRA
SP_DATSTR
SP_INTSTR
SP_UPDFIS
SP_MAPFIS
SP_ATUTSI
]␀␀PROCEDURE R038HCT_ATUCON(P_TIPOPE CHAR,P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_CODOEM NUMBER,P_NUMCON VARCHAR2(16),P_DATFIM DATE)
 IS

l_cracha       NUMBER(12);
  l_crapro       NUMBER(12);
  l_crastr       CHAR(12);
  l_craaux       NUMBER(12);
  l_sqlstr       VARCHAR2(255);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_datahora     CHAR(10);
  l_datstr       CHAR(6);
  l_dathch       DATE;
  l_dataso       DATE;
  l_datpre       DATE;
  l_dattse       DATE;
  l_nodatafound  BOOLEAN;
  l_sequencia    NUMBER;
  l_datmin       DATE;
  l_fimemc       DATE;
  l_fimcon       DATE;
  l_horstr       CHAR(4);
  l_auxval       CHAR(16);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);

BEGIN
l_data_zero   := '31/12/1900,00:00:00';
l_data_atual  := CURDATE();
l_datahora    := '';
l_nodatafound := FALSE;

/*Obtem o Crachá Titular, se não existir obtem o Provísório */
SP_RetCra (1,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
IF l_cracha = 0 THEN
    /*Se não encontrou o crachá titular, obtem o provisório*/
    SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
    l_crapro := l_cracha;
ELSE
    /*Obtem o Crachá Provisório*/
    SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_crapro OUT);
END IF;

/* Verifica se Colaborador possui Cracha */
IF   l_cracha <> 0  THEN
     LOOP
         l_datmin := '31/12/2050,00:00:00';
         l_fimcon := p_datfim;

         /*Se estiver Deletando, não considera a data de validade do Contrato para
         atualizar a controle*/

         IF (p_tipope = 'D') THEN
              l_datmin := '31/12/2050,00:00:00';

         ELSE
             IF  (l_fimcon = l_data_zero) THEN
                 l_fimcon := '31/12/2050,00:00:00';
             END IF;
             IF (l_fimcon < l_datmin) THEN
                 l_datmin := l_fimcon;
             END IF;

             BEGIN
                 SELECT DATFIM INTO l_fimemc FROM R032EMC WHERE NUMCON = p_numcon AND CODOEM = p_codoem;
             EXCEPTION
                 WHEN NO_DATA_FOUND THEN l_fimemc := '31/12/2050,00:00:00';
                 WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No SELECT R038HCT.';
             END;
             IF  (l_fimemc = l_data_zero) THEN
                 l_fimemc := '31/12/2050,00:00:00';
             END IF;
             IF (l_fimemc < l_datmin) THEN
                 l_datmin := l_fimemc;
             END IF;
         END IF;
         /*Obtem a Data de Validade do Crachá*/
         BEGIN
             SELECT DATFIM INTO l_dathch
             FROM R038HCH A
             WHERE NUMCRA = l_cracha AND
             DATINI = (SELECT MAX(DATINI) FROM R038HCH WHERE NUMCRA = l_cracha) AND
             HORINI = (SELECT MAX(HORINI) FROM R038HCH WHERE NUMCRA = l_cracha AND DATINI = A.DATINI);
         EXCEPTION
             WHEN OTHERS THEN NULL;
         END;

         BEGIN
             SELECT DATASO, DATTSE INTO l_dataso, l_dattse FROM R034DAC
             WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
         EXCEPTION
             WHEN NO_DATA_FOUND THEN l_dataso := '31/12/2050,00:00:00';
                                     l_dattse := '31/12/2050,00:00:00';
             WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No SELECT R034DAC.';
         END;

         /*Consistência das datas Obtidas*/
         IF  (l_dataso = l_data_zero) THEN
             l_dataso := '31/12/2050,00:00:00';
         END IF;
         IF  (l_dattse = l_data_zero) THEN
             l_dattse := '31/12/2050,00:00:00';
         END IF;
         IF  (l_datmin = l_data_zero) THEN
             l_datmin := '31/12/2050,00:00:00';
         END IF;
         IF (l_dathch = l_data_zero) THEN
             l_dathch := '31/12/2050,00:00:00';
         END IF;

         IF  (l_dataso < l_dattse) THEN
             IF  (l_dataso < l_datmin) THEN
                 l_datpre := l_dataso;
             ELSE
                 IF  (l_dattse < l_datmin) THEN
                     l_datpre := l_dattse;
                 ELSE
                     l_datpre := l_datmin;
                 END IF;
             END IF;
         ELSE
             IF  (l_dattse < l_datmin)  THEN
                 l_datpre := l_dattse;
             ELSE
                 l_datpre := l_datmin;
             END IF;
         END IF;
         /*Compara se a data do crachá é a menor entre as datas*/
         IF l_dathch < l_datpre THEN
             l_datpre := l_dathch;
         END IF;

         IF  (p_datfim < l_datpre) AND (p_datfim <> l_data_zero) THEN
             SP_DATSTR(p_datfim,'DDMMYY',l_datstr OUT);
             SP_INTSTR(1439,'HHMM',l_horstr OUT);
         ELSE
             SP_DATSTR(l_datpre,'DDMMYY',l_datstr OUT);
             SP_INTSTR(1439,'HHMM',l_horstr OUT);
         END IF;
         l_datahora := l_datstr || l_horstr;

         IF  (l_datahora IS NULL) OR (l_datahora = '') OR (l_datahora = '          ') THEN
             IF  p_datfim <> l_data_zero THEN
                 SP_DATSTR(p_datfim,'DDMMYY',l_datstr OUT);
                 SP_INTSTR(1439,'HHMM',l_horstr OUT);
                 l_datahora := l_datstr || l_horstr;
             ELSE
                 l_datahora := '3112502359';
             END IF;
         END IF;

         /* atualiza r070con */
         l_AuxVal := l_datahora||'000000';
         /*Atualiza o(s) crachá(s) na R070CON*/
         SP_UPDFIS(l_cracha,' ',l_auxval);
         /*Controle do Looping, onde o Processo é efetuado novamente caso exista crachá titular e provisório*/
         IF (l_crapro = l_cracha) OR (l_crapro = 0) THEN
            EXIT;
         ELSE
            l_cracha := l_crapro;
         END IF;
    END LOOP;
    /*Atualiza Controle*/
    /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
    SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
    IF (l_crapri = 0) THEN
        l_crapri := l_cracha;
    END IF;
    /*Obtem o Tipo de Pessoa*/
    SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
    SP_INTSTR(p_numemp,'9999',l_numemp OUT);
    SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
    SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
    l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
    /*Preenche o campo com espaços para completar 23 posições*/
    l_idtpes := lTrim(l_idtpes);
    l_idtpes := rTrim(l_idtpes);
    LOOP
        /*Controle do Loop.*/
        IF (Length(l_idtpes) > 22) THEN
            EXIT;
        END IF;
        l_idtpes := ' '||l_idtpes;
    END LOOP;
    /*Procedure que atualiza a controle*/
    SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
END IF;
END		SENIOR;23BSP_RETCRA
SP_DATSTR
SP_INTSTR
SP_UPDFIS
SP_MAPFIS
SP_ATUTSI
]␀␀PROCEDURE R038HCT_ATUCON(P_TIPOPE CHAR,P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_CODOEM NUMBER,P_NUMCON VARCHAR2(16),P_DATFIM DATE)
 IS

l_cracha       NUMBER(12);
  l_crapro       NUMBER(12);
  l_crastr       CHAR(12);
  l_craaux       NUMBER(12);
  l_sqlstr       VARCHAR2(255);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_datahora     CHAR(10);
  l_datstr       CHAR(6);
  l_dathch       DATE;
  l_dataso       DATE;
  l_datpre       DATE;
  l_dattse       DATE;
  l_nodatafound  BOOLEAN;
  l_sequencia    NUMBER;
  l_datmin       DATE;
  l_fimemc       DATE;
  l_fimcon       DATE;
  l_horstr       CHAR(4);
  l_auxval       CHAR(16);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);

BEGIN
l_data_zero   := '31/12/1900,00:00:00';
l_data_atual  := CURDATE();
l_datahora    := '';
l_nodatafound := FALSE;

/*Obtem o Crachá Titular, se não existir obtem o Provísório */
SP_RetCra (1,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
IF l_cracha = 0 THEN
    /*Se não encontrou o crachá titular, obtem o provisório*/
    SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
    l_crapro := l_cracha;
ELSE
    /*Obtem o Crachá Provisório*/
    SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_crapro OUT);
END IF;

/* Verifica se Colaborador possui Cracha */
IF   l_cracha <> 0  THEN
     LOOP
         l_datmin := '31/12/2050,00:00:00';
         l_fimcon := p_datfim;

         /*Se estiver Deletando, não considera a data de validade do Contrato para
         atualizar a controle*/

         IF (p_tipope = 'D') THEN
              l_datmin := '31/12/2050,00:00:00';

         ELSE
             IF  (l_fimcon = l_data_zero) THEN
                 l_fimcon := '31/12/2050,00:00:00';
             END IF;
             IF (l_fimcon < l_datmin) THEN
                 l_datmin := l_fimcon;
             END IF;

             BEGIN
                 SELECT DATFIM INTO l_fimemc FROM R032EMC WHERE NUMCON = p_numcon AND CODOEM = p_codoem;
             EXCEPTION
                 WHEN NO_DATA_FOUND THEN l_fimemc := '31/12/2050,00:00:00';
                 WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No SELECT R038HCT.';
             END;
             IF  (l_fimemc = l_data_zero) THEN
                 l_fimemc := '31/12/2050,00:00:00';
             END IF;
             IF (l_fimemc < l_datmin) THEN
                 l_datmin := l_fimemc;
             END IF;
         END IF;
         /*Obtem a Data de Validade do Crachá*/
         BEGIN
             SELECT DATFIM INTO l_dathch
             FROM R038HCH A
             WHERE NUMCRA = l_cracha AND
             DATINI = (SELECT MAX(DATINI) FROM R038HCH WHERE NUMCRA = l_cracha) AND
             HORINI = (SELECT MAX(HORINI) FROM R038HCH WHERE NUMCRA = l_cracha AND DATINI = A.DATINI);
         EXCEPTION
             WHEN OTHERS THEN NULL;
         END;

         BEGIN
             SELECT DATASO, DATTSE INTO l_dataso, l_dattse FROM R034DAC
             WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
         EXCEPTION
             WHEN NO_DATA_FOUND THEN l_dataso := '31/12/2050,00:00:00';
                                     l_dattse := '31/12/2050,00:00:00';
             WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No SELECT R034DAC.';
         END;

         /*Consistência das datas Obtidas*/
         IF  (l_dataso = l_data_zero) THEN
             l_dataso := '31/12/2050,00:00:00';
         END IF;
         IF  (l_dattse = l_data_zero) THEN
             l_dattse := '31/12/2050,00:00:00';
         END IF;
         IF  (l_datmin = l_data_zero) THEN
             l_datmin := '31/12/2050,00:00:00';
         END IF;
         IF (l_dathch = l_data_zero) THEN
             l_dathch := '31/12/2050,00:00:00';
         END IF;

         IF  (l_dataso < l_dattse) THEN
             IF  (l_dataso < l_datmin) THEN
                 l_datpre := l_dataso;
             ELSE
                 IF  (l_dattse < l_datmin) THEN
                     l_datpre := l_dattse;
                 ELSE
                     l_datpre := l_datmin;
                 END IF;
             END IF;
         ELSE
             IF  (l_dattse < l_datmin)  THEN
                 l_datpre := l_dattse;
             ELSE
                 l_datpre := l_datmin;
             END IF;
         END IF;
         /*Compara se a data do crachá é a menor entre as datas*/
         IF l_dathch < l_datpre THEN
             l_datpre := l_dathch;
         END IF;

         IF  (p_datfim < l_datpre) AND (p_datfim <> l_data_zero) THEN
             SP_DATSTR(p_datfim,'DDMMYY',l_datstr OUT);
             SP_INTSTR(1439,'HHMM',l_horstr OUT);
         ELSE
             SP_DATSTR(l_datpre,'DDMMYY',l_datstr OUT);
             SP_INTSTR(1439,'HHMM',l_horstr OUT);
         END IF;
         l_datahora := l_datstr || l_horstr;

         IF  (l_datahora IS NULL) OR (l_datahora = '') OR (l_datahora = '          ') THEN
             IF  p_datfim <> l_data_zero THEN
                 SP_DATSTR(p_datfim,'DDMMYY',l_datstr OUT);
                 SP_INTSTR(1439,'HHMM',l_horstr OUT);
                 l_datahora := l_datstr || l_horstr;
             ELSE
                 l_datahora := '3112502359';
             END IF;
         END IF;

         /* atualiza r070con */
         l_AuxVal := l_datahora||'000000';
         /*Atualiza o(s) crachá(s) na R070CON*/
         SP_UPDFIS(l_cracha,' ',l_auxval);
         /*Controle do Looping, onde o Processo é efetuado novamente caso exista crachá titular e provisório*/
         IF (l_crapro = l_cracha) OR (l_crapro = 0) THEN
            EXIT;
         ELSE
            l_cracha := l_crapro;
         END IF;
    END LOOP;
    /*Atualiza Controle*/
    /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
    SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
    IF (l_crapri = 0) THEN
        l_crapri := l_cracha;
    END IF;
    /*Obtem o Tipo de Pessoa*/
    SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
    SP_INTSTR(p_numemp,'9999',l_numemp OUT);
    SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
    SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
    l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
    /*Preenche o campo com espaços para completar 23 posições*/
    l_idtpes := lTrim(l_idtpes);
    l_idtpes := rTrim(l_idtpes);
    LOOP
        /*Controle do Loop.*/
        IF (Length(l_idtpes) > 22) THEN
            EXIT;
        END IF;
        l_idtpes := ' '||l_idtpes;
    END LOOP;
    /*Procedure que atualiza a controle*/
    SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
END IF;
END		SENIOR;21,SP_RETCRA
SP_DATSTR
SP_INTSTR
SP_UPDFIS
␀␀PROCEDURE R038HCT_ATUCON(P_TIPOPE CHAR,P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_CODOEM NUMBER,P_NUMCON VARCHAR2(16),P_DATFIM DATE)
 IS

l_cracha       NUMBER(12);
  l_crapro       NUMBER(12);
  l_crastr       CHAR(12);
  l_craaux       NUMBER(12);
  l_sqlstr       VARCHAR2(255);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_datahora     CHAR(10);
  l_datstr       CHAR(6);
  l_dathch       DATE;
  l_dataso       DATE;
  l_datpre       DATE;
  l_dattse       DATE;
  l_nodatafound  BOOLEAN;
  l_sequencia    NUMBER;
  l_datmin       DATE;
  l_fimemc       DATE;
  l_fimcon       DATE;
  l_horstr       CHAR(4);
  l_auxval       CHAR(16);

BEGIN
l_data_zero   := '31/12/1900,00:00:00';
l_data_atual  := CURDATE();
l_datahora    := '';
l_nodatafound := FALSE;

/*Obtem o Crachá Titular, se não existir obtem o Provísório */
SP_RetCra (1,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
IF l_cracha = 0 THEN
    /*Se não encontrou o crachá titular, obtem o provisório*/
    SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
    l_crapro := l_cracha;
ELSE
    /*Obtem o Crachá Provisório*/
    SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_crapro OUT);
END IF;

/* Verifica se Colaborador possui Cracha */
IF   l_cracha <> 0  THEN
     LOOP
         l_datmin := '31/12/2050,00:00:00';
         l_fimcon := p_datfim;

         /*Se estiver Deletando, não considera a data de validade do Contrato para
         atualizar a controle*/

         IF (p_tipope = 'D') THEN
              l_datmin := '31/12/2050,00:00:00';

         ELSE
             IF  (l_fimcon = l_data_zero) THEN
                 l_fimcon := '31/12/2050,00:00:00';
             END IF;
             IF (l_fimcon < l_datmin) THEN
                 l_datmin := l_fimcon;
             END IF;

             BEGIN
                 SELECT DATFIM INTO l_fimemc FROM R032EMC WHERE NUMCON = p_numcon AND CODOEM = p_codoem;
             EXCEPTION
                 WHEN NO_DATA_FOUND THEN l_fimemc := '31/12/2050,00:00:00';
                 WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No SELECT R038HCT.';
             END;
             IF  (l_fimemc = l_data_zero) THEN
                 l_fimemc := '31/12/2050,00:00:00';
             END IF;
             IF (l_fimemc < l_datmin) THEN
                 l_datmin := l_fimemc;
             END IF;
         END IF;
         /*Obtem a Data de Validade do Crachá*/
         BEGIN
             SELECT DATFIM INTO l_dathch
             FROM R038HCH A
             WHERE NUMCRA = l_cracha AND
             DATINI = (SELECT MAX(DATINI) FROM R038HCH WHERE NUMCRA = l_cracha) AND
             HORINI = (SELECT MAX(HORINI) FROM R038HCH WHERE NUMCRA = l_cracha AND DATINI = A.DATINI);
         EXCEPTION
             WHEN OTHERS THEN NULL;
         END;

         BEGIN
             SELECT DATASO, DATTSE INTO l_dataso, l_dattse FROM R034DAC
             WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
         EXCEPTION
             WHEN NO_DATA_FOUND THEN l_dataso := '31/12/2050,00:00:00';
                                     l_dattse := '31/12/2050,00:00:00';
             WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No SELECT R034DAC.';
         END;

         /*Consistência das datas Obtidas*/
         IF  (l_dataso = l_data_zero) THEN
             l_dataso := '31/12/2050,00:00:00';
         END IF;
         IF  (l_dattse = l_data_zero) THEN
             l_dattse := '31/12/2050,00:00:00';
         END IF;
         IF  (l_datmin = l_data_zero) THEN
             l_datmin := '31/12/2050,00:00:00';
         END IF;
         IF (l_dathch = l_data_zero) THEN
             l_dathch := '31/12/2050,00:00:00';
         END IF;

         IF  (l_dataso < l_dattse) THEN
             IF  (l_dataso < l_datmin) THEN
                 l_datpre := l_dataso;
             ELSE
                 IF  (l_dattse < l_datmin) THEN
                     l_datpre := l_dattse;
                 ELSE
                     l_datpre := l_datmin;
                 END IF;
             END IF;
         ELSE
             IF  (l_dattse < l_datmin)  THEN
                 l_datpre := l_dattse;
             ELSE
                 l_datpre := l_datmin;
             END IF;
         END IF;
         /*Compara se a data do crachá é a menor entre as datas*/
         IF l_dathch < l_datpre THEN
             l_datpre := l_dathch;
         END IF;

         IF  (p_datfim < l_datpre) AND (p_datfim <> l_data_zero) THEN
             SP_DATSTR(p_datfim,'DDMMYY',l_datstr OUT);
             SP_INTSTR(1439,'HHMM',l_horstr OUT);
         ELSE
             SP_DATSTR(l_datpre,'DDMMYY',l_datstr OUT);
             SP_INTSTR(1439,'HHMM',l_horstr OUT);
         END IF;
         l_datahora := l_datstr || l_horstr;

         IF  (l_datahora IS NULL) OR (l_datahora = '') OR (l_datahora = '          ') THEN
             IF  p_datfim <> l_data_zero THEN
                 SP_DATSTR(p_datfim,'DDMMYY',l_datstr OUT);
                 SP_INTSTR(1439,'HHMM',l_horstr OUT);
                 l_datahora := l_datstr || l_horstr;
             ELSE
                 l_datahora := '3112502359';
             END IF;
         END IF;

         /* atualiza r070con */
         l_AuxVal := l_datahora||'000000';
         /*Atualiza o(s) crachá(s) na R070CON*/
         SP_UPDFIS(l_cracha,' ',l_auxval);
         /*Controle do Looping, onde o Processo é efetuado novamente caso exista crachá titular e provisório*/
         IF (l_crapro = l_cracha) OR (l_crapro = 0) THEN
            EXIT;
         ELSE
            l_cracha := l_crapro;
         END IF;
    END LOOP;
END IF;
END		SENIOR;22,SP_RETCRA
SP_DATSTR
SP_INTSTR
SP_UPDFIS
␀␀PROCEDURE R038HCT_ATUCON(P_TIPOPE CHAR,P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_CODOEM NUMBER,P_NUMCON VARCHAR2(16),P_DATFIM DATE)
 IS

l_cracha       NUMBER(12);
  l_crapro       NUMBER(12);
  l_crastr       CHAR(12);
  l_craaux       NUMBER(12);
  l_sqlstr       VARCHAR2(255);
