          /*Atualiza a Controle/FxHoraria*/
          SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);
          l_atutsi := TRUE;
      END IF;
      /*Controle do Looping, onde o Processo é efetuado novamente caso exista crachá titular e provisório*/
      IF (l_crapro = l_cracha) OR (l_crapro = 0) THEN
        EXIT;
      ELSE
        l_cracha := l_crapro;
