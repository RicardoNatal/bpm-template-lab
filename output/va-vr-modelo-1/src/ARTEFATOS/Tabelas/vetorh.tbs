TRIGGER R346CPT_ED BEFORE DELETE ON R346CPT FOR EACH ROW
DECLARE
  l_Valor VARCHAR2(2000);    
BEGIN
  l_Valor := '';
 
  IF (:OLD.CODACA = 0 OR :OLD.ORIINF <> 2) THEN
    SP_CONCATENAR_NUM('CODPRO', :OLD.CODPRO, l_Valor OUT);
    SP_CONCATENAR_NUM('CPFTRA', :OLD.CPFTRA, l_Valor OUT);
    SP_CONCATENAR_DES('NOMTRA', :OLD.NOMTRA, l_Valor OUT);
    SP_CONCATENAR_DAT('DATSEN', :OLD.DATSEN, l_Valor OUT);
    SP_CONCATENAR_DAT('DATCON', :OLD.DATCON, l_Valor OUT);
    SP_CONCATENAR_DES('LAYOUT', 'S-2500', l_Valor OUT);
    
    SP_E_SOCIAL('S-3500', 'R346CPT', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0, NULL, NULL, 0, 'R346CPT_ED');
  END IF;
