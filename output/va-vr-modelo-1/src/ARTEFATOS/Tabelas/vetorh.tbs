                                        SET
                                          EVTNBR = VEVTNBR,
                                          EVTIDT = PEVTIDT,
                                          EVTTIM = PEVTTIM,
                                          EVTUSR = PEVTUSR,
                                          EVTDA1 = PEVTDA31,
