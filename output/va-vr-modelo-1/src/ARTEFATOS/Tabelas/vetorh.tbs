␀␀/* Trigger de Atualizacao dos Saldos de Eventos apos */
/* Inclusao de Evento do Movimento.                  */
TRIGGER R044MOV_EI AFTER INSERT ON R044MOV FOR EACH ROW

DECLARE
l_temAud       BOOLEAN;
l_codRPA       NUMBER(15);
l_codcpa       NUMBER(4);
l_codtpa       NUMBER(4);

BEGIN
R044MOV_ATUSAL ('I',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODCAL,:NEW.CODEVE,:NEW.TABEVE,:NEW.REFEVE,0);

/* Geração de log de inserção de eventos variáveis */
  l_codcpa := 12;        /*l_codcpa representa a categoria e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java  */
  l_codtpa := 137;       /*l_codtpa representa a o tipo Inserir/Excluir e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java*/
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, 1, l_temAud OUT);    
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R044MOV_EI', 'FRFIXVAR'); 
     
     /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
    BEGIN
	    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TipCol));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NumCad));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAL', CONVERT(NUMBER_TO_CHAR, :NEW.CodCal));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TabEve));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CodEve));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRAT', CONVERT(NUMBER_TO_CHAR, :NEW.CodRat));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQEVE', CONVERT(NUMBER_TO_CHAR, :NEW.SeqEve));		
	EXCEPTION
	    WHEN OTHERS THEN RAISERROR 103 'R044MOV_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	END;
	 
	BEGIN
	    /* insere os campos que não são chave na Tabela R995PRT (Tipo de auditoria) */
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORIMOV', :NEW.OriMov);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REFEVE', CONVERT(NUMBER_TO_CHAR, :NEW.RefEve));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALEVE', CONVERT(NUMBER_TO_CHAR, :NEW.ValEve));	 
	END;	
  END IF;  
END␀"Ö␀␀		SENIOR;0Z␀␀

/* Trigger de Atualizacao dos Saldos de Eventos apos */
/* Alteracao de Evento do Movimento.                 */
TRIGGER R044MOV_EU AFTER UPDATE ON R044MOV FOR EACH ROW

DECLARE
l_temAud       BOOLEAN;
l_codRPA       NUMBER(15);
l_codcpa       NUMBER(4);
l_codtpa       NUMBER(4);

BEGIN
R044MOV_ATUSAL ('U',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODCAL,:NEW.CODEVE,:NEW.TABEVE,:NEW.REFEVE,:OLD.REFEVE);

/* Geração de log de alteração de eventos fixos */
  l_codcpa := 12;        /*l_codcpa representa a categoria e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java  */
  l_codtpa := 138;       /*l_codtpa representa a o tipo Alteração e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java*/
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, 1, l_temAud OUT);    
    
  IF ((:OLD.NumEmp <> :NEW.NumEmp)
	OR (:OLD.TipCol <> :NEW.TipCol)
	OR (:OLD.NumCad <> :NEW.NumCad)
	OR (:OLD.CodCal <> :NEW.CodCal)
	OR (:OLD.TabEve <> :NEW.TabEve)
	OR (:OLD.CodEve <> :NEW.CodEve)
	OR (:OLD.CodRat <> :NEW.CodRat)
	OR (:OLD.SeqEve <> :NEW.SeqEve)
	OR (:OLD.OriMov <> :NEW.OriMov)
	OR (:OLD.RefEve <> :NEW.RefEve)
	OR (:OLD.ValEve <> :NEW.ValEve)) THEN
  BEGIN
	  IF (l_temAud = TRUE) THEN
        SP_RET_REG_AUD(l_codrpa OUT);
	    SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R044MOV_EU', 'FRFIXVAR'); 
	     
	     /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
	    BEGIN
		    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp));		
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TipCol));		
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NumCad));		
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAL', CONVERT(NUMBER_TO_CHAR, :NEW.CodCal));		
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TabEve));		
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CodEve));		
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRAT', CONVERT(NUMBER_TO_CHAR, :NEW.CodRat));		
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQEVE', CONVERT(NUMBER_TO_CHAR, :NEW.SeqEve));	
		EXCEPTION
		    WHEN OTHERS THEN RAISERROR 103 'R044MOV_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
		END;
		 
		BEGIN
		    /* insere os campos que não são chave na Tabela R995PRT (Tipo de auditoria) */
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDORIMOV', :OLD.OriMov);
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWORIMOV', :NEW.OriMov);
			
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDREFEVE', CONVERT(NUMBER_TO_CHAR, :OLD.RefEve));
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWREFEVE', CONVERT(NUMBER_TO_CHAR, :NEW.RefEve));
			
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVALEVE', CONVERT(NUMBER_TO_CHAR, :OLD.ValEve));
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWVALEVE', CONVERT(NUMBER_TO_CHAR, :NEW.ValEve));	 
		END;	
	  END IF; 
	END;
  END IF; 
END␀ Ö␀␀		SENIOR;0d
␀␀


/* Trigger de Atualizacao dos Saldos de Eventos apos */
/* Exclusao de Evento do Movimento.                  */
TRIGGER R044MOV_ED AFTER DELETE ON R044MOV FOR EACH ROW

DECLARE
l_temAud       BOOLEAN;
l_codRPA       NUMBER(15);
l_codcpa       NUMBER(4);
l_codtpa       NUMBER(4);

BEGIN
R044MOV_ATUSAL ('D',:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.CODCAL,:OLD.CODEVE,:OLD.TABEVE,0,:OLD.REFEVE);

  /* Geração de log de exclusão de eventos fixos */
  l_codcpa := 12;        /*l_codcpa representa a categoria e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java  */
  l_codtpa := 137;       /*l_codtpa representa a o tipo Inserir/Excluir e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java*/
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, 1, l_temAud OUT);    
  
  IF (l_temAud = TRUE) THEN
    BEGIN
        SP_RET_REG_AUD(l_codrpa OUT);
		SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R044MOV_ED', 'FRFIXVAR'); 
     
	     /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
	    BEGIN
		    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NumEmp));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TipCol));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NumCad));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAL', CONVERT(NUMBER_TO_CHAR, :OLD.CodCal));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :OLD.TabEve));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :OLD.CodEve));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRAT', CONVERT(NUMBER_TO_CHAR, :OLD.CodRat));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQEVE', CONVERT(NUMBER_TO_CHAR, :OLD.SeqEve));		
		EXCEPTION
		    WHEN OTHERS THEN RAISERROR 103 'R044MOV_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
		END;
		 
		BEGIN
		    /* insere os campos que não são chave na Tabela R995PRT (Tipo de auditoria) */
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORIMOV', :OLD.OriMov);
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REFEVE', CONVERT(NUMBER_TO_CHAR, :OLD.RefEve));
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALEVE', CONVERT(NUMBER_TO_CHAR, :OLD.ValEve));		 
		END;	
