TRIGGER R038HPP_EI AFTER INSERT ON R038HPP FOR EACH ROW

DECLARE
l_datalt       DATE;
  l_comando_nulo BOOLEAN;
BEGIN
IF  :NEW.STAHIS = 1 THEN
    BEGIN
      SELECT R034FUN.DATPPR INTO l_datalt
        FROM R034FUN
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      l_comando_nulo:=TRUE;
    END;
    IF   :NEW.DATALT >= l_datalt THEN
         UPDATE R034FUN
            SET ASSPPR = :NEW.ASSPPR,
                DATPPR = :NEW.DATALT
          WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                R034FUN.NUMEMP = :NEW.NUMEMP AND
                R034FUN.NUMCAD = :NEW.NUMCAD;
    END IF;
END IF;
END␀Õ␀␀		SENIOR;0ğ␀␀

TRIGGER R038HPP_EU AFTER UPDATE ON R038HPP FOR EACH ROW

DECLARE
l_datalt       DATE;
  l_comando_nulo BOOLEAN;
BEGIN
IF  :NEW.STAHIS = 1 THEN
    BEGIN
      SELECT R034FUN.DATPPR INTO l_datalt
        FROM R034FUN
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      l_comando_nulo:=TRUE;
    END;
    IF   :NEW.DATALT >= l_datalt THEN
         UPDATE R034FUN
            SET ASSPPR = :NEW.ASSPPR,
                DATPPR = :NEW.DATALT
          WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                R034FUN.NUMEMP = :NEW.NUMEMP AND
                R034FUN.NUMCAD = :NEW.NUMCAD;
    END IF;
END IF;
END␀Õ␀␀	SENIOR;00␀␀TRIGGER R038HPP_SD AFTER DELETE ON R038HPP

DECLARE
l_assppr       NUMBER(1);
  l_datalt       DATE;
  l_comando_nulo BOOLEAN;

  /* CURSOR c/ os registros gravados no R038HPP_AUX */
  CURSOR c_r038hpp_del IS SELECT NUMEMP,TIPCOL,NUMCAD FROM R038HPP_AUX;
  TYPE t_r038hpp_aux IS RECORD(
    NUMEMP   R038hpp_AUX.NUMEMP%TYPE,
    TIPCOL   R038hpp_AUX.TIPCOL%TYPE,
    NUMCAD   R038hpp_AUX.NUMCAD%TYPE);
  l_r038hpp_aux t_r038hpp_aux;

  BEGIN
  l_comando_nulo:=FALSE;

  /* Ler Registro do CURSOR */
  FOREACH c_r038hpp_del INTO  l_r038hpp_aux.NUMEMP,
                              l_r038hpp_aux.TIPCOL,
                              l_r038hpp_aux.NUMCAD
  LOOP
    /* Procurar o historico anterior */
    BEGIN
      SELECT A.ASSPPR,A.DATALT INTO l_assppr,l_datalt
        FROM R038HPP A
      WHERE A.NUMEMP = l_r038hpp_aux.NUMEMP
        AND A.TIPCOL = l_r038hpp_aux.TIPCOL
        AND A.NUMCAD = l_r038hpp_aux.NUMCAD
        AND A.STAHIS = 1
        AND DATALT IN (SELECT MAX(DATALT) FROM R038HPP
                        WHERE NUMEMP = l_r038hpp_aux.NUMEMP
                          AND TIPCOL = l_r038hpp_aux.TIPCOL
                          AND NUMCAD = l_r038hpp_aux.NUMCAD
                          AND STAHIS = 1);
    EXCEPTION
      WHEN TOO_MANY_ROWS THEN
        RAISERROR 103 'Erro em R038HPP - TOO MANY ROWS';
      WHEN NO_DATA_FOUND THEN
        l_assppr:=0;
        l_datalt:='31/12/1900,00:00:00';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT R038HPP';
    END;
   /* Atualizar tabela de colaboradores */
    BEGIN
      UPDATE R034FUN
         SET ASSPPR = l_assppr,
             DATPPR = l_datalt
       WHERE R034FUN.TIPCOL = l_r038hpp_aux.TIPCOL AND
             R034FUN.NUMEMP = l_r038hpp_aux.NUMEMP AND
             R034FUN.NUMCAD = l_r038hpp_aux.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro Na Atualização do R034FUN';
    END;

  END LOOP;

 /* Apagar Registro OLD em R038HPP_AUX */
  BEGIN
    DELETE FROM R038HPP_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀Õ␀␀		SENIOR;0ø␀␀

TRIGGER R038HPP_ED AFTER DELETE ON R038HPP FOR EACH ROW

DECLARE
l_assppr       NUMBER(1);
  l_datalt       DATE;
  l_comando_nulo BOOLEAN;
BEGIN
IF  :OLD.STAHIS = 1 THEN
    l_comando_nulo:=FALSE;
    BEGIN
      SELECT R034FUN.ASSPPR,R034FUN.DATPPR INTO l_assppr,l_datalt
        FROM R034FUN
       WHERE R034FUN.TIPCOL = :OLD.TIPCOL AND
             R034FUN.NUMEMP = :OLD.NUMEMP AND
             R034FUN.NUMCAD = :OLD.NUMCAD;
    EXCEPTION  WHEN OTHERS THEN
        l_comando_nulo:=TRUE;
    END;
    IF  (l_comando_nulo = FALSE) THEN
        IF   (:OLD.ASSPPR = l_assppr)
        AND  (:OLD.DATALT = l_datalt) THEN
             BEGIN
             /* Inserir Registro Old */
               INSERT INTO R038HPP_AUX (NUMEMP,TIPCOL,NUMCAD,DATALT)
               VALUES (:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.DATALT);
             EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro no INSERT em R038HPP_AUX.';
             END;
        END IF;
    END IF;
END IF;
END␀␀␀vv␀␀␀␀␀␀Õ␀␀…¬␀␀´␀€␀ ␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t€␀ ␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀€␀ ␀␀␀␀␀P%€$0.w␀Æÿ␀␀ÿ␀mDÑ␀€␀ ␀␀␀␀␀:IÙE¼qC␀êÿ␀␀ÿ␀ZL€␀ ␀␀␀␀␀k¹␀␀jn␀Æÿ␀␀ÿ␀*␀á€␀ ␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀␀␀␀wv␀␀␀␀␀␀␀Õ␀␀…¬␀␀´␀	Ôï1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôï1␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôï1␀␀␀␀␀.%0.0.w␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ôï1␀␀␀␀␀FşEşEqC␀êÿ␀␀ÿ␀t␀ŸÔï1␀␀␀␀␀é␀é␀é␀p␀Æÿ␀␀ÿ␀×³␀␀cÔï1␀␀␀␀␀´␀␀2³␀␀3³␀␀`␀␀ÿ␀␀ÿ␀7¦␀␀rÔï1␀␀␀␀␀g¦␀␀K¦␀␀K¦␀␀n␀Æÿ␀␀ÿ␀£³␀␀cÔï1␀␀␀␀␀´␀␀*³␀␀*³␀␀`␀␀ÿ␀␀ÿ␀ ï␀␀ÍÔï1␀␀␀␀␀¹ï␀␀Lï␀␀¹ï␀␀p␀Æÿ␀␀ÿ␀Â³␀␀cÔï1␀␀␀␀␀´␀␀/³␀␀0³␀␀`␀␀ÿ␀␀ÿ␀ï␀␀ÊÔï1␀␀␀␀␀¸ï␀␀¸ï␀␀¸ï␀␀n␀Æÿ␀␀ÿ␀Á³␀␀cÔï1␀␀␀␀␀´␀␀.³␀␀.³␀␀`␀␀ÿ␀␀ÿ␀xUÔï1␀␀␀␀␀qqqp␀Æÿ␀␀ÿ␀±ï␀␀ÑÔï1␀␀␀␀␀¿ï␀␀¿ï␀␀¿ï␀␀n␀Æÿ␀␀ÿ␀ó&␀‘	Ôï1␀␀␀␀␀¥(␀¥(␀¥(␀p␀Æÿ␀␀ÿ␀␀•Ôï1␀␀␀␀␀D␀A␀D␀n␀Æÿ␀␀ÿ␀sº␀␀BÔÿ1␀␀␀␀␀8␀Â␀␀Â␀␀p␀Æÿ␀␀ÿ␀]ñ␀␀ÔÔÿ1␀␀␀␀␀"␀␀~ñ␀␀Œñ␀␀n␀␀Æÿ␀␀ÿ␀C␀=Ôÿ1␀␀␀␀␀!␀␀d␀d␀c␀␀␀ÿ␀␀ÿ␀;␀␀=Ôÿ1␀␀␀␀␀#␀␀»/␀␀c␀␀␀ÿ␀␀ÿ␀ZDÑ␀Ôï1␀␀␀␀␀KL©GªGqC␀êÿ␀␀ÿ␀␀␀␀0;1;2;3Õ␀␀		SENIOR;0ë␀␀TRIGGER R038HPU_EI AFTER INSERT ON R038HPU FOR EACH ROW DECLARE
	l_layoutAltContratual VARCHAR2(6);
BEGIN
	/* eSocial */
	RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAltContratual OUT);
	IF ((l_layoutAltContratual IS NOT NULL) AND LENGTH(LTRIM(RTRIM(l_layoutAltContratual))) > 0)  THEN
	   SP_HIST_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038HPU', 'DATALT', 'I', '', '', 0, 'R038HPU_EI');
	END IF;
	/* eSocial */
END␀Õ␀␀		SENIOR;0º	␀␀

TRIGGER R038HPU_EU AFTER UPDATE ON R038HPU FOR EACH ROW DECLARE
	l_layoutAltContratual VARCHAR2(6);
	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_JsonCamposAlterados VARCHAR2(2000);
	l_InfoFacult BOOLEAN;
	l_SimplificaoESocial BOOLEAN;
	l_VersaoESocial NUMBER;
BEGIN
	/* eSocial */
	l_VersaoESocial := 0;
    l_JsonCamposAlterados := '';

	SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);

	l_Alterou := FALSE;

	SP_VALUPDATE_NUM(:OLD.TIPREG, :NEW.TIPREG, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_NUM_JSON('TIPREG', :NEW.TipReg, :OLD.TipReg, l_JsonCamposAlterados OUT);
	END IF;

	SP_VALUPDATE_NUM(:OLD.REGPRE, :NEW.REGPRE, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_NUM_JSON('REGPRE', :NEW.RegPre, :OLD.RegPre, l_JsonCamposAlterados OUT);
	END IF;

	SP_VALUPDATE_NUM(:OLD.PANSEG, :NEW.PANSEG, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_NUM_JSON('PANSEG', :NEW.PanSeg, :OLD.PanSeg, l_JsonCamposAlterados OUT);
	END IF;
	
	IF (l_SimplificaoESocial = TRUE) THEN
		SP_VALUPDATE_NUM(:OLD.RemCar, :NEW.RemCar, l_Valido OUT);
	  	IF (l_Valido = TRUE) THEN
	  		l_Alterou := TRUE;
	  		SP_CONCAT_NUM_JSON('REMCAR', :NEW.RemCar, :OLD.RemCar, l_JsonCamposAlterados OUT);
	    END IF;
	    
	    SP_VALUPDATE_DES(:OLD.TetRgp, :NEW.TetRgp, l_Valido OUT);
	  	IF (l_Valido = TRUE) THEN
	  		l_Alterou := TRUE;
	  		SP_CONCAT_DES_JSON('TETRGP', :NEW.TetRgp, :OLD.TetRgp, l_JsonCamposAlterados OUT);
	    END IF;
	    
	    SP_VALUPDATE_DES(:OLD.IndAbo, :NEW.IndAbo, l_Valido OUT);
	  	IF (l_Valido = TRUE) THEN
	  		l_Alterou := TRUE;
	  		SP_CONCAT_DES_JSON('INDABO', :NEW.IndAbo, :OLD.IndAbo, l_JsonCamposAlterados OUT);
	    END IF;
	    
	    SP_VALUPDATE_DAT(:OLD.DatAbo, :NEW.DatAbo, l_Valido OUT);
	  	IF (l_Valido = TRUE) THEN
	  		l_Alterou := TRUE;
	  		SP_CONCAT_DAT_JSON('DATABO', :NEW.DatAbo, :OLD.DatAbo, l_JsonCamposAlterados OUT);
	    END IF;
	END IF;

	IF (l_Alterou = TRUE) THEN
		RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAltContratual OUT);
		IF ((l_layoutAltContratual IS NOT NULL) AND LENGTH(LTRIM(RTRIM(l_layoutAltContratual))) > 0)  THEN
		   SP_HIST_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038HPU', 'DATALT', 'A', '', l_JsonCamposAlterados, 0, 'R038HPU_EU');
		END IF;
	END IF;
	/* eSocial */
END␀Õ␀␀		SENIOR;0ï␀␀

TRIGGER R038HPU_ED AFTER DELETE ON R038HPU FOR EACH ROW DECLARE
	l_layoutAltContratual VARCHAR2(6);
BEGIN
	/* eSocial */
	RH_LAY_CONTR_COLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layoutAltContratual OUT);
	IF ((l_layoutAltContratual IS NOT NULL) AND LENGTH(LTRIM(RTRIM(l_layoutAltContratual))) > 0)  THEN
	   SP_HIST_ESOCIAL(l_layoutAltContratual, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, 'R038HPU', 'DATALT', 'E', '', '', 0, 'R038HPU_ED');
	END IF;
	/* eSocial */
END␀␀␀¥v␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Õ␀␀…¬␀␀´␀	Ôï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôï!␀␀␀␀␀Ü␀t␀Ü␀nˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôï!␀␀␀␀␀.%0.0.wˆ␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ôï!␀␀␀␀␀BIşEşEqC␀êÿ␀␀ÿ␀\-´␀Ôï!␀␀␀␀␀¬=î␀␀î␀␀r␀Æÿ␀␀õÖ␀␀␀¡␀úÔï!␀␀␀␀␀:::c␀␀␀ÿ␀␀ÿ␀ä¼␀␀¹␀Ôï!␀␀␀␀␀JJJQ)␀␀Æÿ␀␀ÿ␀␀™Ôï!␀␀␀␀␀b␀b␀b␀q␀Æÿ␀␀ÿ␀p=Ôï!␀␀␀␀␀IpIpIpp␀Æÿ␀␀ÿ␀3EÑ␀Ôï!␀␀␀␀␀,IôGöGqC␀êÿ␀␀ÿ␀ñ␀␀ÒÔï!␀␀␀␀␀;ñ␀␀ñ␀␀<ñ␀␀q␀Æÿ␀␀ÿ␀ÕO3Ôï!␀␀␀␀␀:ê9:n␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3Õ␀␀		SENIOR;01␀␀TRIGGER  R038HRE_SI AFTER INSERT ON R038HRE FOR EACH ROW

DECLARE
  l_codrpa NUMBER(15);
  l_temAud BOOLEAN;
  l_datTemp VARCHAR(10);
BEGIN
  SP_EXISTE_LOG(15, 143, 1, l_temAud OUT); 
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, 15, 1, 143, 1, 'R038HRE_SI', 'FR038HRE'); 
    BEGIN
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp));
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TipCol));
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NumCad));
	  SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
    EXCEPTION
  	  WHEN OTHERS THEN RAISERROR 103 'R038HRE_SI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;
   
   BEGIN 
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODREC', CONVERT(NUMBER_TO_CHAR, :NEW.CodRec));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPIRF', :NEW.TipIrf);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERALI', CONVERT(NUMBER_TO_CHAR, :NEW.PerAli));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPREN', CONVERT(NUMBER_TO_CHAR, :NEW.TipRen));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FORTRI', CONVERT(NUMBER_TO_CHAR, :NEW.ForTri));
     SP_DATSTR(:NEW.DATMOL, 'DD/MM/YYYY', l_datTemp OUT);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATMOL', l_datTemp);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RELPAG', CONVERT(NUMBER_TO_CHAR, :NEW.RelPag));    
    END;
  END IF;    
END␀Õ␀␀		SENIOR;0c␀␀

TRIGGER R038HRE_SU AFTER UPDATE ON R038HRE FOR EACH ROW
DECLARE
  l_codrpa NUMBER(15);
  l_temAud BOOLEAN;
  l_datTemp VARCHAR(10);
BEGIN
  IF ((:OLD.NumEmp <> :NEW.NumEmp)
OR (:OLD.TipCol <> :NEW.TipCol)
OR (:OLD.NumCad <> :NEW.NumCad)
OR (:OLD.DatAlt <> :NEW.DatAlt)
OR (:OLD.CodRec <> :NEW.CodRec)
OR (:OLD.TipIrf <> :NEW.TipIrf)
OR (:OLD.PerAli <> :NEW.PerAli)
OR (:OLD.TipRen <> :NEW.TipRen)
OR (:OLD.ForTri <> :NEW.ForTri)
OR (:OLD.DatMol <> :NEW.DatMol)
OR (:OLD.RelPag <> :NEW.RelPag)) THEN
    SP_EXISTE_LOG(15, 144, 1, l_temAud OUT);    
  
    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, 1, 15, 1, 144, 1, 'R038HRE_SU', 'FR038HRE');
     
      BEGIN
	    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp));
	    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TipCol));
	    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NumCad));
	    SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
	    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
  	    WHEN OTHERS THEN RAISERROR 103 'R038HRE_SU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
    
      BEGIN 
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODREC', CONVERT(NUMBER_TO_CHAR, :NEW.CodRec));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPIRF', :NEW.TipIrf);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERALI', CONVERT(NUMBER_TO_CHAR, :NEW.PerAli));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPREN', CONVERT(NUMBER_TO_CHAR, :NEW.TipRen));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFORTRI', CONVERT(NUMBER_TO_CHAR, :NEW.ForTri));
        SP_DATSTR(:NEW.DATMOL, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATMOL', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWRELPAG', CONVERT(NUMBER_TO_CHAR, :NEW.RelPag));
     
	    INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODREC', CONVERT(NUMBER_TO_CHAR, :OLD.CodRec));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPIRF', :OLD.TipIrf);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERALI', CONVERT(NUMBER_TO_CHAR, :OLD.PerAli));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPREN', CONVERT(NUMBER_TO_CHAR, :OLD.TipRen));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFORTRI', CONVERT(NUMBER_TO_CHAR, :OLD.ForTri));
        SP_DATSTR(:OLD.DATMOL, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATMOL', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDRELPAG', CONVERT(NUMBER_TO_CHAR, :OLD.RelPag));        
      END;
	END IF;
  END IF;  
END␀Õ␀␀		SENIOR;06␀␀

TRIGGER R038HRE_SD AFTER DELETE ON R038HRE FOR EACH ROW

DECLARE
  l_codrpa NUMBER(15);
  l_temAud BOOLEAN;
  l_datTemp VARCHAR(10);
BEGIN
  SP_EXISTE_LOG(15, 143, 1, l_temAud OUT);  
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, 15, 1, 143, 1, 'R038HRE_SD', 'FR038HRE');
   
    BEGIN
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NumEmp));
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TipCol));
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NumCad));
	  SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
    EXCEPTION
  	  WHEN OTHERS THEN RAISERROR 103 'R038HRE_SD: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;
   
   BEGIN 
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODREC', CONVERT(NUMBER_TO_CHAR, :OLD.CodRec));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPIRF', :OLD.TipIrf);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERALI', CONVERT(NUMBER_TO_CHAR, :OLD.PerAli));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPREN', CONVERT(NUMBER_TO_CHAR, :OLD.TipRen));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FORTRI', CONVERT(NUMBER_TO_CHAR, :OLD.ForTri));
     SP_DATSTR(:OLD.DATMOL, 'DD/MM/YYYY', l_datTemp OUT);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATMOL', l_datTemp);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RELPAG', CONVERT(NUMBER_TO_CHAR, :OLD.RelPag));    
    END;
  END IF;    
END␀␀␀Ÿv␀␀␀␀␀␀␀␀␀␀␀␀ Õ␀␀…¬␀␀´␀	Ôÿ1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ1␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ1␀␀␀␀␀.%0.0.w␀Æÿ␀␀…Ó␀␀␀EÑ␀	Ôÿ1␀␀␀␀␀¢G¢G¢GqC␀êÿ␀␀ÿ␀§½␀␀mÔÿ1␀␀␀␀␀;¾␀␀y;¾␀␀p␀Æÿ␀␀ÿ␀Ü¼␀␀±␀Ôÿ1␀␀␀␀␀¾␀␀␀¾␀␀9)␀␀Æÿ␀␀ÿ␀®_±␀Ôÿ1␀␀␀␀␀*\*\*\q␀Æÿ␀␀ÿ␀åDÑ␀Ôÿ1␀␀␀␀␀ÔFÔFÔFqC␀êÿ␀␀ÿ␀™UÔÿ1␀␀␀␀␀qY	VWW␀␀␀ÿ␀␀ÿ␀)+‘␀Ôÿ1␀␀␀␀␀M&M&M&h)␀␀␀Æÿ␀␀ÿ␀++‘␀Ôÿ1␀␀␀␀␀U&U&U&h)␀␀␀Æÿ␀␀ÿ␀,+Ì␀Ôÿ1␀␀␀␀␀W&W&W&{␀␀Æÿ␀␀ÿ␀-+±␀Ôÿ1␀␀␀␀␀Y&Y&Y&q␀␀Æÿ␀␀ÿ␀.+Ñ␀Ôÿ1␀␀␀␀␀[&[&[&qC␀␀êÿ␀␀ÿ␀/+Ñ␀Ôÿ1␀␀␀␀␀\&\&\&qC␀␀êÿ␀␀ÿ␀0+␀Ôÿ1␀␀␀␀␀]&]&]&c␀␀␀␀ÿ␀␀ÿ␀1+FÔÿ1␀␀␀␀␀^&^&^&=␀␀␀ÿ␀␀ÿ␀2+Ôÿ1␀␀␀␀␀_&_&_&␀␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3"Õ␀␀		SENIOR;0å␀␀TRIGGER R038HRJ_EI AFTER INSERT ON R038HRJ FOR EACH ROW
DECLARE
	l_layoutAlteracaoContrato VARCHAR2(6);
    l_DataZero DATE;
BEGIN
	/* eSocial */
	RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);
	IF (l_layoutAlteracaoContrato = 'S-2206') THEN    
		SP_TAB_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATINI, :NEW.DATFIM, 'R038HRJ', 'I', '', '', 0, 'R038HRJ_EI');
		l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
		IF (l_DataZero <> :NEW.DATFIM) THEN
			SP_HIST_DT_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATFIM, 'R038HRJ', 'DATINI', 'I', '', '', ' ', 0, 'R038HRJ_EI');
		END IF;   
	END IF;	
	/* eSocial */
END␀#Õ␀␀		SENIOR;0š␀␀

TRIGGER R038HRJ_EU AFTER UPDATE ON R038HRJ FOR EACH ROW
DECLARE
	l_Alterou BOOLEAN;
	l_AlterouSomenteDataFim BOOLEAN;
	l_Valido BOOLEAN;
	l_layoutAlteracaoContrato VARCHAR2(6);
	l_JsonCamposAlterados VARCHAR2(2000);
BEGIN
	/* eSocial */
		l_Alterou := FALSE;
		l_AlterouSomenteDataFim := FALSE;
		l_JsonCamposAlterados := '';

		SP_VALUPDATE_NUM(:OLD.PERRED, :NEW.PERRED, L_VALIDO OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('PERRED', :NEW.PERRED, :OLD.PERRED, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_NUM(:OLD.CMPAU1, :NEW.CMPAU1, L_VALIDO OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('CMPAU1', :NEW.CMPAU1, :OLD.CMPAU1, l_JsonCamposAlterados OUT);
		END IF;
	
		SP_VALUPDATE_NUM(:OLD.DURMES, :NEW.DURMES, L_VALIDO OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('DURMES', :NEW.DURMES, :OLD.DURMES, l_JsonCamposAlterados OUT);
		END IF;
		
		SP_VALUPDATE_DES(:OLD.DESTPJ, :NEW.DESTPJ, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('DESTPJ', :NEW.DESTPJ, :OLD.DESTPJ, l_JsonCamposAlterados OUT);
		END IF;	
		
		SP_VALUPDATE_DAT(:OLD.DATFIM, :NEW.DATFIM, l_Valido OUT);		
		IF (l_Valido = TRUE) THEN
			IF (l_Alterou = FALSE) THEN
				l_AlterouSomenteDataFim := TRUE;
			END IF;
			l_Alterou := TRUE;
			SP_CONCAT_DAT_JSON('DATFIM', :NEW.DatFim, :OLD.DatFim, l_JsonCamposAlterados OUT);
		END IF;
		
		IF (l_Alterou = TRUE) THEN 
			RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);
			IF (l_layoutAlteracaoContrato = 'S-2206') THEN			
				SP_ALT_TAB_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATINI, :NEW.DATFIM, :OLD.DATFIM, 'R038HRJ', '', l_JsonCamposAlterados, l_AlterouSomenteDataFim, 'DATINI', '', 0, 'R038HRJ_EU');
			END IF;
		END IF;
	/* eSocial */
END␀!Õ␀␀		SENIOR;0Ô␀␀

TRIGGER R038HRJ_ED AFTER DELETE ON R038HRJ FOR EACH ROW
DECLARE
	l_layoutAlteracaoContrato VARCHAR2(6);      
BEGIN
	/* eSocial */
	RH_LAY_CONTR_COLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layoutAlteracaoContrato OUT);
	IF (l_layoutAlteracaoContrato = 'S-2206') THEN
		SP_TAB_ESOCIAL(l_layoutAlteracaoContrato, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATINI, :OLD.DATFIM, 'R038HRJ', 'E', '', '', 0, 'R038HRJ_ED');
	END IF;	  			
	/* eSocial */
END␀␀␀ v␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀$Õ␀␀…¬␀␀´␀	Ğï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ğï!␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ğï!␀␀␀␀␀‚%€$0.w␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ğï!␀␀␀␀␀:I¼¼qC␀êÿ␀␀ÿ␀…ü␀␀­␀	Ğï!␀␀␀␀␀Öÿ␀␀ü␀␀xş␀␀p␀Æÿ␀␀ÿ␀-±␀Ğï!␀␀␀␀␀!£␀␀Î¢␀␀Î¢␀␀q␀Æÿ␀␀*Û␀␀␀},´␀Ğï!␀␀␀␀␀õ<µfµfr␀Æÿ␀␀%Û␀␀␀+␀›␀Ğï!␀␀␀␀␀éù␀␀áù␀␀ş!␀j)␀␀Æÿ␀␀ÿ␀8›␀Ğï!␀␀␀␀␀2␀Ç07␀j)␀␀Æÿ␀␀ÿ␀0␀ªĞï!␀␀␀␀␀ä␀␀=␀n␀Æÿ␀␀ÿ␀m␀¸Ğï!␀␀␀␀␀½␀µfI␀n␀Æÿ␀␀ÿ␀¦*bĞï!␀␀␀␀␀¸*­*¸*g␀␀ÿ␀␀ÿ␀ã¦␀␀bĞï!␀␀␀␀␀Ü®␀␀±®␀␀Ü®␀␀g␀␀ÿ␀␀ÿ␀½␀␀¹␀Ğï!␀␀␀␀␀¾␀␀á␀á␀Q)␀␀Æÿ␀␀ÿ␀¥½␀␀Ê␀Ğï!␀␀␀␀␀¨qqY␀Æÿ␀␀ÿ␀*␀áĞï!␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀¿,±␀Ğï!␀␀␀␀␀>äBäBq␀Æÿ␀␀nÑ␀␀␀‚ù␀␀›␀Ğï!␀␀␀␀␀6ú␀␀úù␀␀!ú␀␀j)␀␀Æÿ␀␀ÿ␀8›␀Ğï!␀␀␀␀␀4␀Ë0Î0j)␀␀Æÿ␀␀ÿ␀·DÑ␀Ğï!␀␀␀␀␀¼F¼FqC␀êÿ␀␀ÿ␀␀␀%Õ␀␀␀&Õ␀␀␀␀	0;1;2;3;4,Õ␀␀	SENIOR;0#␀␀

/* Inclusao */
TRIGGER R038HSA_SI AFTER INSERT ON R038HSA

DECLARE
l_datalt       DATE;
  l_seqalt       NUMBER(2);
  l_valsal       NUMBER(13,4);
  l_cplsal       NUMBER(13,4);
  l_codmot       NUMBER(3);
  l_tipsal       NUMBER(2);
  l_codest       NUMBER(4);
  l_clasal       VARCHAR2(5);
  l_nivsal       VARCHAR2(5);
  l_perdes       NUMBER(5,2);
  l_perrea       NUMBER(8,5);
  l_data_zero    DATE;
  l_comando_nulo BOOLEAN;

/* CURSOR c/ os registros gravados no R038HSA_AUX */
  CURSOR c_r038hsa_del IS SELECT NUMEMP,TIPCOL,NUMCAD,DATALT,SEQALT FROM R038HSA_AUX;
  TYPE t_r038HSA_aux IS RECORD(
    NUMEMP   R038HSA_AUX.NUMEMP%TYPE,
    TIPCOL   R038HSA_AUX.TIPCOL%TYPE,
    NUMCAD   R038HSA_AUX.NUMCAD%TYPE,
    DATALT   R038HSA_AUX.DATALT%TYPE,
    SEQALT   R038HSA_AUX.SEQALT%TYPE);
  l_r038HSA_aux t_r038HSA_aux;

BEGIN
  l_data_zero  := DATETIME(31, 12, 1900, 0, 0, 0);
  l_comando_nulo:=FALSE;

  /* Le Registro do CURSOR */
  FOREACH c_r038hsa_del INTO  l_r038HSA_aux.NUMEMP,
                              l_r038HSA_aux.TIPCOL,
                              l_r038HSA_aux.NUMCAD,
                              l_r038HSA_aux.DATALT,
                              l_r038HSA_aux.SEQALT
  LOOP
   /* Pega o historico anterior */
    BEGIN
      SELECT A.DATALT,A.SEQALT,A.VALSAL,A.CPLSAL,A.CODMOT,A.TIPSAL,A.CODEST,
             A.CLASAL,A.NIVSAL,A.PERDES,A.PERREA
        INTO l_datalt,l_seqalt,l_valsal,l_cplsal,l_codmot,l_tipsal,l_codest,
             l_clasal,l_nivsal,l_perdes,l_perrea
        FROM R038HSA A
       WHERE A.NUMEMP = l_r038hsa_aux.NUMEMP
         AND A.TIPCOL = l_r038hsa_aux.TIPCOL
         AND A.NUMCAD = l_r038hsa_aux.NUMCAD
         AND A.STAHIS = 1
         AND DATALT IN (SELECT MAX(DATALT)
                          FROM R038HSA
                         WHERE NUMEMP = l_r038hsa_aux.NUMEMP
                           AND TIPCOL = l_r038hsa_aux.TIPCOL
                           AND NUMCAD = l_r038hsa_aux.NUMCAD
                           AND STAHIS = 1 )
         AND SEQALT IN (SELECT MAX(SEQALT)
                          FROM R038HSA
                         WHERE NUMEMP = l_r038hsa_aux.NUMEMP
                           AND TIPCOL = l_r038hsa_aux.TIPCOL
                           AND NUMCAD = l_r038hsa_aux.NUMCAD
                           AND DATALT = A.DATALT
                           AND STAHIS = 1);
    EXCEPTION
      WHEN TOO_MANY_ROWS THEN
        RAISERROR 103 'Erro em R038HSA - TOO MANY ROWS';
      WHEN NO_DATA_FOUND THEN
        l_datalt:=l_data_zero;
        l_valsal:=0;
        l_cplsal:=0;
        l_codmot:=0;
        l_tipsal:=0;
        l_codest:=0;
        l_clasal:='';
        l_nivsal:='';
        l_perdes:=0;
        l_perrea:=0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT R038HSA';
    END;

   /* Atualiza tabela de colaboradores */
    IF (l_datalt <> l_data_zero) OR (l_seqalt > l_r038HSA_aux.SEQALT  AND l_datalt = l_r038hsa_aux.DATALT) THEN
       BEGIN
         UPDATE R034FUN
            SET DATSAL = l_datalt,
                VALSAL = l_valsal,
                CPLSAL = l_cplsal,
                CODMOT = l_codmot,
                TIPSAL = l_tipsal,
                CODEST = l_codest,
                CLASAL = l_clasal,
                NIVSAL = l_nivsal,
                PERDES = l_perdes,
                PERREA = l_perrea
          WHERE R034FUN.TIPCOL = l_r038hsa_aux.TIPCOL AND
                R034FUN.NUMEMP = l_r038hsa_aux.NUMEMP AND
                R034FUN.NUMCAD = l_r038hsa_aux.NUMCAD;
       EXCEPTION WHEN OTHERS THEN
         RAISERROR 103 'Erro Na Atualização do R034FUN';
       END;
    END IF;

  END LOOP;

  /* Apaga Registro OLD em R038HSA_AUX */
   BEGIN
     DELETE FROM R038HSA_AUX;
   EXCEPTION WHEN OTHERS THEN
     NULL;
   END;
END␀)Õ␀␀		SENIOR;0Ü␀␀

TRIGGER R038HSA_EI AFTER INSERT ON R038HSA FOR EACH ROW
DECLARE
	l_Valor VARCHAR2(2000);
	l_layoutAlteracaoContrato VARCHAR2(6);
	l_codrpa NUMBER(15);
	l_temAud BOOLEAN;
	l_datTemp VARCHAR(10);
	l_CODHSA VARCHAR(1);
BEGIN
	IF :NEW.STAHIS = 1 THEN
		BEGIN
			/* Insere Registro New */
			INSERT INTO R038HSA_AUX (NUMEMP,TIPCOL,NUMCAD,DATALT,SEQALT)
      		VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATALT,:NEW.SEQALT);
		EXCEPTION WHEN OTHERS THEN
			RAISERROR 103 'Erro no INSERT em R038HSA_AUX.';
		END;
	END IF;

	/* eSocial */  
	RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);
	IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
		l_Valor :=  '';
		SP_CONCATENAR_NUM('SEQALT', :NEW.SEQALT, l_Valor OUT);
		
		IF ((:NEW.DATDIS IS NOT NULL) AND (:NEW.DATDIS <>  DATETIME(31, 12, 1900, 0, 0, 0))) THEN
			SP_CONCATENAR_DAT('DATDIS', :NEW.DATDIS, l_Valor OUT);
			SP_CONCATENAR_DAT('DATALT', :NEW.DATALT, l_Valor OUT);
		END IF;
		
		IF (:NEW.CPLSAL > 0) THEN
			RH_DEF_ESOC_CONHSA(:NEW.NUMEMP, l_CODHSA OUT);

			SP_CONCATENAR_DES('CPLSAL', l_CODHSA, l_Valor OUT);
			SP_CONCATENAR_NUM('TIPSAL', :NEW.TIPSAL, l_Valor OUT);
			SP_CONCATENAR_FLO('VALSAL', :NEW.VALSAL, 2, l_Valor OUT);
			SP_CONCATENAR_DES('CONHSA', l_CODHSA, l_Valor OUT);

		END IF;
		
		SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038HSA', 'DATALT', 'I', l_Valor, '', 0, 'R038HSA_EI');
	END IF;  
  	/* eSocial */
  	
  SP_EXISTE_LOG(21, 156, 1, l_temAud OUT); 
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, 21, 1, 156, 1, 'R038HSA_SI', 'FR038HSA'); 
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
      SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQALT', CONVERT(NUMBER_TO_CHAR, :NEW.SEQALT));      
    EXCEPTION
  	  WHEN OTHERS THEN RAISERROR 103 'R038HSA_SI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;
   
   BEGIN
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODMOT', CONVERT(NUMBER_TO_CHAR, :NEW.CODMOT));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEST', CONVERT(NUMBER_TO_CHAR, :NEW.CODEST));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALSAL', CONVERT(NUMBER_TO_CHAR, :NEW.VALSAL));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CPLSAL', CONVERT(NUMBER_TO_CHAR, :NEW.CPLSAL));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPSAL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPSAL));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPEST', CONVERT(NUMBER_TO_CHAR, :NEW.TIPEST));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CLASAL', :NEW.CLASAL);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NIVSAL', :NEW.NIVSAL);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERDES', CONVERT(NUMBER_TO_CHAR, :NEW.PERDES));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERREA', CONVERT(NUMBER_TO_CHAR, :NEW.PERREA));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODIDM', CONVERT(NUMBER_TO_CHAR, :NEW.CODIDM));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SALEST', CONVERT(NUMBER_TO_CHAR, :NEW.SALEST));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CPLEST', CONVERT(NUMBER_TO_CHAR, :NEW.CPLEST));
	 SP_DATSTR(:NEW.DatDis, 'DD/MM/YYYY', l_datTemp OUT);     
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATDIS', l_datTemp);
    END;
  END IF;  
END␀-Õ␀␀	SENIOR;0#␀␀

/* Alteracao */
TRIGGER R038HSA_SU AFTER UPDATE ON R038HSA

DECLARE
l_datalt       DATE;
  l_seqalt       NUMBER(2);
  l_valsal       NUMBER(13,4);
  l_cplsal       NUMBER(13,4);
  l_codmot       NUMBER(3);
  l_tipsal       NUMBER(2);
  l_codest       NUMBER(4);
  l_clasal       VARCHAR2(5);
  l_nivsal       VARCHAR2(5);
  l_perdes       NUMBER(5,2);
  l_perrea       NUMBER(8,5);
  l_data_zero    DATE;
  l_comando_nulo BOOLEAN;

/* CURSOR c/ os registros gravados no R038HSA_AUX */
  CURSOR c_r038hsa_del IS SELECT NUMEMP,TIPCOL,NUMCAD,DATALT,SEQALT FROM R038HSA_AUX;
  TYPE t_r038HSA_aux IS RECORD(
    NUMEMP   R038HSA_AUX.NUMEMP%TYPE,
    TIPCOL   R038HSA_AUX.TIPCOL%TYPE,
    NUMCAD   R038HSA_AUX.NUMCAD%TYPE,
    DATALT   R038HSA_AUX.DATALT%TYPE,
    SEQALT   R038HSA_AUX.SEQALT%TYPE);
  l_r038HSA_aux t_r038HSA_aux;

BEGIN
  l_data_zero  := DATETIME(31, 12, 1900, 0, 0, 0);
  l_comando_nulo:=FALSE;

  /* Le Registro do CURSOR */
  FOREACH c_r038hsa_del INTO  l_r038HSA_aux.NUMEMP,
                              l_r038HSA_aux.TIPCOL,
                              l_r038HSA_aux.NUMCAD,
                              l_r038HSA_aux.DATALT,
                              l_r038HSA_aux.SEQALT
  LOOP
   /* Pega o historico anterior */
    BEGIN
      SELECT A.DATALT,A.SEQALT,A.VALSAL,A.CPLSAL,A.CODMOT,A.TIPSAL,A.CODEST,
             A.CLASAL,A.NIVSAL,A.PERDES,A.PERREA
        INTO l_datalt,l_seqalt,l_valsal,l_cplsal,l_codmot,l_tipsal,l_codest,
             l_clasal,l_nivsal,l_perdes,l_perrea
        FROM R038HSA A
       WHERE A.NUMEMP = l_r038hsa_aux.NUMEMP
         AND A.TIPCOL = l_r038hsa_aux.TIPCOL
         AND A.NUMCAD = l_r038hsa_aux.NUMCAD
         AND A.STAHIS = 1
         AND DATALT IN (SELECT MAX(DATALT)
                          FROM R038HSA
                         WHERE NUMEMP = l_r038hsa_aux.NUMEMP
                           AND TIPCOL = l_r038hsa_aux.TIPCOL
                           AND NUMCAD = l_r038hsa_aux.NUMCAD
                           AND STAHIS = 1 )
         AND SEQALT IN (SELECT MAX(SEQALT)
                          FROM R038HSA
                         WHERE NUMEMP = l_r038hsa_aux.NUMEMP
                           AND TIPCOL = l_r038hsa_aux.TIPCOL
                           AND NUMCAD = l_r038hsa_aux.NUMCAD
                           AND DATALT = A.DATALT
                           AND STAHIS = 1);
    EXCEPTION
      WHEN TOO_MANY_ROWS THEN
        RAISERROR 103 'Erro em R038HSA - TOO MANY ROWS';
      WHEN NO_DATA_FOUND THEN
        l_datalt:=l_data_zero;
        l_valsal:=0;
        l_cplsal:=0;
        l_codmot:=0;
        l_tipsal:=0;
        l_codest:=0;
        l_clasal:='';
        l_nivsal:='';
        l_perdes:=0;
        l_perrea:=0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT R038HSA';
    END;

   /* Atualiza tabela de colaboradores */
    IF (l_datalt <> l_data_zero) OR (l_seqalt > l_r038HSA_aux.SEQALT AND l_datalt = l_r038hsa_aux.DATALT) THEN
       BEGIN
         UPDATE R034FUN
            SET DATSAL = l_datalt,
                VALSAL = l_valsal,
                CPLSAL = l_cplsal,
                CODMOT = l_codmot,
                TIPSAL = l_tipsal,
                CODEST = l_codest,
                CLASAL = l_clasal,
                NIVSAL = l_nivsal,
                PERDES = l_perdes,
                PERREA = l_perrea
          WHERE R034FUN.TIPCOL = l_r038hsa_aux.TIPCOL AND
                R034FUN.NUMEMP = l_r038hsa_aux.NUMEMP AND
                R034FUN.NUMCAD = l_r038hsa_aux.NUMCAD;
       EXCEPTION WHEN OTHERS THEN
         RAISERROR 103 'Erro Na Atualização do R034FUN';
       END;
    END IF;

  END LOOP;

  /* Apaga Registro OLD em R038HSA_AUX */
   BEGIN
     DELETE FROM R038HSA_AUX;
   EXCEPTION WHEN OTHERS THEN
     NULL;
   END;
END␀*Õ␀␀		SENIOR;0b&␀␀

TRIGGER R038HSA_EU AFTER UPDATE ON R038HSA FOR EACH ROW
DECLARE
	l_Alterou BOOLEAN;
	l_AlterouDissidio BOOLEAN;
	l_Valido BOOLEAN;
	l_Valor VARCHAR2(2000);
	l_ValorExc VARCHAR2(2000);
	l_JsonCamposAlterados VARCHAR2(2000);
	l_layoutAlteracaoContrato VARCHAR2(6);
	l_codrpa NUMBER(15);
	l_temAud BOOLEAN;
	l_datTemp VARCHAR(10);	  
	l_EmpresaStr VARCHAR(11);
    l_TipColaboradorStr VARCHAR(11);
    l_ColaboradorStr VARCHAR(11);
    l_Where VARCHAR(2000);
    l_ProximaData DATE;
    l_ValorVARCHAR1 VARCHAR2(1000);
    l_ValorVARCHAR2 VARCHAR2(1000);
    l_CODHSA VARCHAR(1);
    l_AlterouComplemento BOOLEAN;
    
BEGIN
	IF :NEW.STAHIS = 1 THEN
		BEGIN
			INSERT INTO R038HSA_AUX (NUMEMP,TIPCOL,NUMCAD,DATALT,SEQALT)
			VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATALT,:NEW.SEQALT);
		EXCEPTION WHEN OTHERS THEN
			RAISERROR 103 'Erro no INSERT em R038HSA_AUX.';
		END;
	END IF;

	/* eSocial */
	l_Alterou := FALSE;
	l_AlterouDissidio := FALSE;
    l_JsonCamposAlterados := '';
	l_CODHSA := '';
	l_AlterouComplemento := FALSE;
	
	SP_VALUPDATE_NUM(:OLD.TIPSAL, :NEW.TIPSAL, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
        SP_CONCAT_NUM_JSON('TIPSAL', :NEW.TIPSAL, :OLD.TIPSAL, l_JsonCamposAlterados OUT);		
	END IF;

	SP_VALUPDATE_NUM(:OLD.VALSAL, :NEW.VALSAL, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
        SP_CONCAT_FLO_JSON('VALSAL', :NEW.VALSAL, :OLD.VALSAL, 4, l_JsonCamposAlterados OUT);
	END IF;
	
	SP_VALUPDATE_NUM(:OLD.CPLSAL, :NEW.CPLSAL, l_Valido OUT);
	IF (l_Valido = TRUE) THEN

		RH_DEF_ESOC_CONHSA(:NEW.NUMEMP, l_CODHSA OUT);
		
		IF(l_CODHSA <> 'N') THEN
			l_Alterou := TRUE;
			
			IF(l_CODHSA = 'S') THEN
				l_AlterouComplemento := TRUE;			
			END IF;
		END IF;
	END IF;
	
	SP_VALUPDATE_DAT(:OLD.DatDis, :NEW.DatDis, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
        l_AlterouDissidio := TRUE;
		SP_CONCAT_DAT_JSON('DATDIS', :NEW.DatDis, :OLD.DatDis, l_JsonCamposAlterados OUT);
	END IF;
  
	IF (l_Alterou = TRUE) THEN   
		RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);	
		IF (l_layoutAlteracaoContrato IS NOT NULL) THEN      
        	l_Valor :=  '';
			SP_CONCATENAR_NUM('SEQALT', :NEW.SEQALT, l_Valor OUT);    	 
			
			IF(l_AlterouComplemento = TRUE) THEN
				SP_CONCATENAR_DES('CPLSAL', 'S', l_Valor OUT);			
			END IF;
			
			IF (l_AlterouDissidio = TRUE) THEN
				IF ((:NEW.DATDIS IS NOT NULL) AND (:NEW.DATDIS <>  DATETIME(31, 12, 1900, 0, 0, 0))) THEN
					SP_CONCATENAR_DAT('DATDIS', :NEW.DATDIS, l_Valor OUT);
					SP_CONCATENAR_DAT('DATALT', :NEW.DATALT, l_Valor OUT);
				ELSE
					SP_CONCATENAR_DAT('EXCDIS', :OLD.DATDIS, l_Valor OUT);
					
					l_ValorExc :=  '';
					l_ProximaData :=  DATETIME(31, 12, 1900, 0, 0, 0);
					l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP);
					l_TipColaboradorStr := CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL);
					l_ColaboradorStr := CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD);
					
					l_Where := 'NUMEMP = ' || l_EmpresaStr || ' AND TIPCOL = ' || l_TipColaboradorStr || ' AND NUMCAD = ' || l_ColaboradorStr;
					SP_PROXHIST_NPER('DATALT', 'R038HSA', l_Where, :OLD.DATALT, l_ProximaData OUT);
					
					 /* Cria pendência para leiaute de exclusão */
					SP_CONCATENAR_NUM('SEQALT', :OLD.SEQALT, l_ValorExc OUT);
					SP_CONCATENAR_DAT('DATDIS', :OLD.DATDIS, l_ValorExc OUT);
					SP_CONCATENAR_DAT('DATALT', :OLD.DATALT, l_ValorExc OUT);
                    SP_CONCATENAR_DES('LAYOUT', l_layoutAlteracaoContrato, l_ValorExc OUT);
				    SP_E_SOCIAL('S-3000', 'R038HSA', 'N', 'E', :OLD.DATALT, l_ProximaData, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_ValorExc, '', 0, NULL, :OLD.DATALT, 0, 'R038HSA_EU');
				END IF;
			END IF;
			
			IF ((l_AlterouDissidio = FALSE) AND (:NEW.DATDIS IS NOT NULL) AND (:NEW.DATDIS <>  DATETIME(31, 12, 1900, 0, 0, 0))) THEN
				SP_CONCATENAR_DAT('DATDIS', :NEW.DATDIS, l_Valor OUT);
				SP_CONCATENAR_DAT('DATALT', :NEW.DATALT, l_Valor OUT);		
			END IF;
			
			SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038HSA', 'DATALT', 'A', l_Valor, l_JsonCamposAlterados, 0, 'R038HSA_EU');
		END IF;
	END IF;	  	
	/* eSocial */
	
  IF ((:OLD.NumEmp <> :NEW.NumEmp)
  OR (:OLD.TipCol <> :NEW.TipCol)
  OR (:OLD.NumCad <> :NEW.NumCad)
  OR (:OLD.DatAlt <> :NEW.DatAlt)
  OR (:OLD.SeqAlt <> :NEW.SeqAlt)
  OR (:OLD.CodMot <> :NEW.CodMot)
  OR (:OLD.CodEst <> :NEW.CodEst)
  OR (:OLD.ValSal <> :NEW.ValSal)
  OR (:OLD.CplSal <> :NEW.CplSal)
  OR (:OLD.TipSal <> :NEW.TipSal)
  OR (:OLD.TipEst <> :NEW.TipEst)
  OR (:OLD.ClaSal <> :NEW.ClaSal)
  OR (:OLD.NivSal <> :NEW.NivSal)
  OR (:OLD.PerDes <> :NEW.PerDes)
  OR (:OLD.PerRea <> :NEW.PerRea)
  OR (:OLD.StaHis <> :NEW.StaHis)
  OR (:OLD.CodIdm <> :NEW.CodIdm)
  OR (:OLD.SalEst <> :NEW.SalEst)
  OR (:OLD.CplEst <> :NEW.CplEst)
  OR (:OLD.DatDis <> :NEW.DatDis)) THEN
  
    SP_EXISTE_LOG(21, 155, 1, l_temAud OUT);    
  
    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, 1, 21, 1, 155, 1, 'R038HSA_SU', 'FR038HSA');
     
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', CONVERT(DATE_TO_CHAR, :OLD.DATALT));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQALT', CONVERT(NUMBER_TO_CHAR, :OLD.SEQALT));
      EXCEPTION
  	    WHEN OTHERS THEN RAISERROR 103 'R038HSA_SU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
    
      BEGIN 
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODMOT', CONVERT(NUMBER_TO_CHAR, :OLD.CODMOT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODMOT', CONVERT(NUMBER_TO_CHAR, :NEW.CODMOT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODEST', CONVERT(NUMBER_TO_CHAR, :OLD.CODEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODEST', CONVERT(NUMBER_TO_CHAR, :NEW.CODEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVALSAL', CONVERT(NUMBER_TO_CHAR, :OLD.VALSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWVALSAL', CONVERT(NUMBER_TO_CHAR, :NEW.VALSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCPLSAL', CONVERT(NUMBER_TO_CHAR, :OLD.CPLSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCPLSAL', CONVERT(NUMBER_TO_CHAR, :NEW.CPLSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPSAL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPSAL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPEST', CONVERT(NUMBER_TO_CHAR, :OLD.TIPEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPEST', CONVERT(NUMBER_TO_CHAR, :NEW.TIPEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCLASAL', :OLD.CLASAL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCLASAL', :NEW.CLASAL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNIVSAL', :OLD.NIVSAL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNIVSAL', :NEW.NIVSAL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERDES', CONVERT(NUMBER_TO_CHAR, :OLD.PERDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERDES', CONVERT(NUMBER_TO_CHAR, :NEW.PERDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERREA', CONVERT(NUMBER_TO_CHAR, :OLD.PERREA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERREA', CONVERT(NUMBER_TO_CHAR, :NEW.PERREA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSTAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSTAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODIDM', CONVERT(NUMBER_TO_CHAR, :OLD.CODIDM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODIDM', CONVERT(NUMBER_TO_CHAR, :NEW.CODIDM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSALEST', CONVERT(NUMBER_TO_CHAR, :OLD.SALEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSALEST', CONVERT(NUMBER_TO_CHAR, :NEW.SALEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCPLEST', CONVERT(NUMBER_TO_CHAR, :OLD.CPLEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCPLEST', CONVERT(NUMBER_TO_CHAR, :NEW.CPLEST));
        SP_DATSTR(:NEW.DatDis, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATDIS', l_datTemp);
        SP_DATSTR(:OLD.DatDis, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATDIS', l_datTemp);        
      END;
	END IF;
  END IF;	
END␀+Õ␀␀	SENIOR;0+␀␀TRIGGER R038HSA_SD AFTER DELETE ON R038HSA
DECLARE
l_datalt       DATE;
  l_valsal       NUMBER(13,4);
  l_cplsal       NUMBER(13,4);
  l_codmot       NUMBER(3);
  l_tipsal       NUMBER(2);
  l_codest       NUMBER(4);
  l_clasal       VARCHAR2(5);
  l_nivsal       VARCHAR2(5);
  l_perdes       NUMBER(5,2);
  l_perrea       NUMBER(8,5);
  l_data_zero    DATE;
  l_comando_nulo BOOLEAN;

/* CURSOR c/ os registros gravados no R038HSA_AUX */
  CURSOR c_r038hsa_del IS SELECT NUMEMP,TIPCOL,NUMCAD,DATALT FROM R038HSA_AUX;
  TYPE t_r038HSA_aux IS RECORD(
    NUMEMP   R038HSA_AUX.NUMEMP%TYPE,
    TIPCOL   R038HSA_AUX.TIPCOL%TYPE,
    NUMCAD   R038HSA_AUX.NUMCAD%TYPE,
    DATALT   R038HSA_AUX.DATALT%TYPE);
  l_r038HSA_aux t_r038HSA_aux;

BEGIN
  l_data_zero  := DATETIME(31, 12, 1900, 0, 0, 0);
  l_comando_nulo:=FALSE;

  /* Le Registro do CURSOR */
  FOREACH c_r038hsa_del INTO  l_r038HSA_aux.NUMEMP,
                              l_r038HSA_aux.TIPCOL,
                              l_r038HSA_aux.NUMCAD,
                              l_r038HSA_aux.DATALT
  LOOP
   /* Pega o historico anterior */
    BEGIN
      SELECT A.DATALT,A.VALSAL,A.CPLSAL,A.CODMOT,A.TIPSAL,A.CODEST,
             A.CLASAL,A.NIVSAL,A.PERDES,A.PERREA
        INTO l_datalt,l_valsal,l_cplsal,l_codmot,l_tipsal,l_codest,
             l_clasal,l_nivsal,l_perdes,l_perrea
        FROM R038HSA A
       WHERE A.NUMEMP = l_r038hsa_aux.NUMEMP
         AND A.TIPCOL = l_r038hsa_aux.TIPCOL
         AND A.NUMCAD = l_r038hsa_aux.NUMCAD
         AND A.STAHIS = 1
         AND DATALT IN (SELECT MAX(DATALT)
                          FROM R038HSA
                         WHERE NUMEMP = l_r038hsa_aux.NUMEMP
                           AND TIPCOL = l_r038hsa_aux.TIPCOL
                           AND NUMCAD = l_r038hsa_aux.NUMCAD
                           AND STAHIS = 1 )
         AND SEQALT IN (SELECT MAX(SEQALT)
                          FROM R038HSA
                         WHERE NUMEMP = l_r038hsa_aux.NUMEMP
                           AND TIPCOL = l_r038hsa_aux.TIPCOL
                           AND NUMCAD = l_r038hsa_aux.NUMCAD
                           AND DATALT = A.DATALT
                           AND STAHIS = 1);
    EXCEPTION
      WHEN TOO_MANY_ROWS THEN
        RAISERROR 103 'Erro em R038HSA - TOO MANY ROWS';
      WHEN NO_DATA_FOUND THEN
        l_datalt:=l_data_zero;
        l_valsal:=0;
        l_cplsal:=0;
        l_codmot:=0;
        l_tipsal:=0;
        l_codest:=0;
        l_clasal:='';
        l_nivsal:='';
        l_perdes:=0;
        l_perrea:=0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT R038HSA';
    END;
   /* Atualiza tabela de colaboradores */
    IF l_datalt <> l_data_zero THEN
       BEGIN
         UPDATE R034FUN
            SET DATSAL = l_DatAlt,
                VALSAL = l_valsal,
                CPLSAL = l_cplsal,
                CODMOT = l_codmot,
                TIPSAL = l_tipsal,
                CODEST = l_codest,
                CLASAL = l_clasal,
                NIVSAL = l_nivsal,
                PERDES = l_perdes,
                PERREA = l_perrea
          WHERE R034FUN.TIPCOL = l_r038hsa_aux.TIPCOL AND
                R034FUN.NUMEMP = l_r038hsa_aux.NUMEMP AND
                R034FUN.NUMCAD = l_r038hsa_aux.NUMCAD;
       EXCEPTION WHEN OTHERS THEN
         RAISERROR 103 'Erro Na Atualização do R034FUN';
       END;
    END IF;
  END LOOP;

  /* Apaga Registro OLD em R038HSA_AUX */
   BEGIN
     DELETE FROM R038HSA_AUX;
   EXCEPTION WHEN OTHERS THEN
     NULL;
   END;
END␀(Õ␀␀		SENIOR;0â␀␀

TRIGGER R038HSA_ED AFTER DELETE ON R038HSA FOR EACH ROW
DECLARE
	l_datsal DATE;
	l_valsal NUMBER(13,4);
	l_cplsal NUMBER(13,4);
	l_codmot NUMBER(3);
	l_tipsal NUMBER(2);
	l_codest NUMBER(4);
	l_clasal VARCHAR2(5);
	l_nivsal VARCHAR2(5);
	l_perdes NUMBER(5,2);
	l_perrea NUMBER(8,5);
	l_comando_nulo BOOLEAN;
	l_Valor VARCHAR2(2000);
	l_ValorExc VARCHAR2(2000);
	l_layoutAlteracaoContrato VARCHAR2(6);
  	l_codrpa NUMBER(15);
  	l_temAud BOOLEAN;
  	l_datTemp VARCHAR(10);
    l_EmpresaStr VARCHAR(11);
    l_TipColaboradorStr VARCHAR(11);
    l_ColaboradorStr VARCHAR(11);
    l_Where VARCHAR(2000);
    l_ProximaData DATE;	
  	l_CODHSA VARCHAR(1);
BEGIN
	IF :OLD.STAHIS = 1 THEN
		l_comando_nulo:=FALSE;
		BEGIN
			SELECT R034FUN.DATSAL, R034FUN.VALSAL, R034FUN.CPLSAL, R034FUN.CODMOT,
				R034FUN.TIPSAL, R034FUN.CODEST, R034FUN.CLASAL, R034FUN.NIVSAL,
				R034FUN.PERDES, R034FUN.PERREA
			INTO l_datsal,l_valsal,l_cplsal,l_codmot,l_tipsal,l_codest,
				l_clasal,l_nivsal,l_perdes,l_perrea
			FROM R034FUN
			WHERE R034FUN.TIPCOL = :OLD.TIPCOL AND
				R034FUN.NUMEMP = :OLD.NUMEMP AND
				R034FUN.NUMCAD = :OLD.NUMCAD;
		EXCEPTION WHEN OTHERS THEN
			l_comando_nulo:=TRUE;
		END;

		IF (l_comando_nulo = FALSE) THEN
			IF  ((:OLD.DATALT=l_datsal) OR ((:OLD.DATALT IS NULL) AND (l_datsal IS NULL)))
			AND ((:OLD.VALSAL=l_valsal) OR ((:OLD.VALSAL IS NULL) AND (l_valsal IS NULL)))
			AND ((:OLD.CPLSAL=l_cplsal) OR ((:OLD.CPLSAL IS NULL) AND (l_cplsal IS NULL)))
			AND ((:OLD.CODMOT=l_codmot) OR ((:OLD.CODMOT IS NULL) AND (l_codmot IS NULL)))
			AND ((:OLD.TIPSAL=l_tipsal) OR ((:OLD.TIPSAL IS NULL) AND (l_tipsal IS NULL)))
			AND ((:OLD.CODEST=l_codest) OR ((:OLD.CODEST IS NULL) AND (l_codest IS NULL)))
			AND ((:OLD.CLASAL=l_clasal) OR ((:OLD.CLASAL IS NULL) AND (l_clasal IS NULL)))
			AND ((:OLD.NIVSAL=l_nivsal) OR ((:OLD.NIVSAL IS NULL) AND (l_nivsal IS NULL)))
			AND ((:OLD.PERDES=l_perdes) OR ((:OLD.PERDES IS NULL) AND (l_perdes IS NULL)))
			AND ((:OLD.PERREA=l_perrea) OR ((:OLD.PERREA IS NULL) AND (l_perrea IS NULL))) THEN
				BEGIN
					/* Insere Registro Old */
					INSERT INTO R038HSA_AUX (NUMEMP,TIPCOL,NUMCAD,DATALT)
					VALUES (:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.DATALT);
				EXCEPTION WHEN OTHERS THEN
					RAISERROR 103 'Erro no INSERT em R038HSA_AUX.';
				END;
			END IF;
		END IF;
	END IF;
	
	/* eSocial */
	RH_LAY_CONTR_COLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layoutAlteracaoContrato OUT);    
	IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
		l_Valor :=  '';
		SP_CONCATENAR_NUM('SEQALT', :OLD.SEQALT, l_Valor OUT);
		
		IF ((:OLD.DATDIS IS NOT NULL) AND (:OLD.DATDIS <>  DATETIME(31, 12, 1900, 0, 0, 0)) AND (:OLD.DATDIS <> :OLD.DATALT)) THEN
			l_ValorExc :=  '';
			l_ProximaData :=  DATETIME(31, 12, 1900, 0, 0, 0);
			l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP);
			l_TipColaboradorStr := CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL);
			l_ColaboradorStr := CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD);
			
			l_Where := 'NUMEMP = ' || l_EmpresaStr || ' AND TIPCOL = ' || l_TipColaboradorStr || ' AND NUMCAD = ' || l_ColaboradorStr;
			SP_PROXHIST_NPER('DATALT', 'R038HSA', l_Where, :OLD.DATALT, l_ProximaData OUT);
			
		    /* Cria pendência para leiaute de exclusão */
			SP_CONCATENAR_NUM('SEQALT', :OLD.SEQALT, l_ValorExc OUT);
		    SP_CONCATENAR_DAT('DATDIS', :OLD.DATDIS, l_ValorExc OUT);
		    SP_CONCATENAR_DAT('DATALT', :OLD.DATALT, l_ValorExc OUT);
            SP_CONCATENAR_DES('LAYOUT', l_layoutAlteracaoContrato, l_ValorExc OUT);		    
	        SP_E_SOCIAL('S-3000', 'R038HSA', 'N', 'E', :OLD.DATALT, l_ProximaData, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_ValorExc, '', 0, NULL, :OLD.DATALT, 0, 'R038HSA_SD');
		ELSE
		
			IF (:OLD.CPLSAL > 0) THEN
			
			    RH_DEF_ESOC_CONHSA(:OLD.NUMEMP, l_CODHSA OUT);
			
				SP_CONCATENAR_DES('CPLSAL', l_CODHSA , l_Valor OUT);
		  		SP_CONCATENAR_NUM('TIPSAL', :OLD.TIPSAL, l_Valor OUT);
		  		SP_CONCATENAR_FLO('VALSAL', :OLD.VALSAL, 2, l_Valor OUT);
		  		SP_CONCATENAR_DES('CONHSA', l_CODHSA, l_Valor OUT);
			END IF;
		
		  SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, 'R038HSA', 'DATALT', 'E', l_Valor, '', 0, 'R038HSA_ED');
		END IF;  
	END IF;  
  /* eSocial */
  
  SP_EXISTE_LOG(21, 156, 1, l_temAud OUT);  
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, 21, 1, 156, 1, 'R038HSA_SD', 'FR038HSA');
   
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQALT', CONVERT(NUMBER_TO_CHAR, :OLD.SEQALT));
    EXCEPTION
  	  WHEN OTHERS THEN RAISERROR 103 'R038HSA_SD: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;
   
    BEGIN 
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODMOT', CONVERT(NUMBER_TO_CHAR, :OLD.CODMOT));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEST', CONVERT(NUMBER_TO_CHAR, :OLD.CODEST));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALSAL', CONVERT(NUMBER_TO_CHAR, :OLD.VALSAL));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CPLSAL', CONVERT(NUMBER_TO_CHAR, :OLD.CPLSAL));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPSAL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPSAL));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPEST', CONVERT(NUMBER_TO_CHAR, :OLD.TIPEST));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CLASAL', :OLD.CLASAL);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NIVSAL', :OLD.NIVSAL);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERDES', CONVERT(NUMBER_TO_CHAR, :OLD.PERDES));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERREA', CONVERT(NUMBER_TO_CHAR, :OLD.PERREA));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODIDM', CONVERT(NUMBER_TO_CHAR, :OLD.CODIDM));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SALEST', CONVERT(NUMBER_TO_CHAR, :OLD.SALEST));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CPLEST', CONVERT(NUMBER_TO_CHAR, :OLD.CPLEST));    
	  SP_DATSTR(:OLD.DatDis, 'DD/MM/YYYY', l_datTemp OUT);     
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATDIS', l_datTemp);
    END;
  END IF;   
END␀␀␀£v␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀'Õ␀␀…¬␀␀´␀Ğï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀tĞï!␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀Ğï!␀␀␀␀␀‚%€$0.w␀Æÿ␀␀ÿ␀mDÑ␀Ğï!␀␀␀␀␀:IÙE¼qC␀êÿ␀␀ÿ␀…ü␀␀­␀Ğï!␀␀␀␀␀Öÿ␀␀ü␀␀xş␀␀p␀Æÿ␀␀ÿ␀-±␀Ğï!␀␀␀␀␀!£␀␀y¢␀␀Î¢␀␀q␀Æÿ␀␀ÿ␀},´␀Ğï!␀␀␀␀␀õ< fµfq␀Æÿ␀␀%Û␀␀␀+␀›␀Ğï!␀␀␀␀␀éù␀␀áù␀␀ş!␀j)␀␀Æÿ␀␀ÿ␀8›␀Ğï!␀␀␀␀␀2␀Ç07␀j)␀␀Æÿ␀␀ÿ␀0␀ªĞï!␀␀␀␀␀ä␀¬␀=␀n␀Æÿ␀␀ÿ␀m␀Š␀Ğï!␀␀␀␀␀K␀I␀K␀n␀Æÿ␀␀ÿ␀¦*bĞï!␀␀␀␀␀¸*­*¸*g␀␀ÿ␀␀ÿ␀ã¦␀␀bĞï!␀␀␀␀␀Ü®␀␀±®␀␀Ü®␀␀g␀␀ÿ␀␀ÿ␀½␀␀¹␀Ğï!␀␀␀␀␀¾␀␀İ␀á␀Q)␀␀Æÿ␀␀ÿ␀¥½␀␀Ê␀Ğï!␀␀␀␀␀¨qqY␀Æÿ␀␀ÿ␀*␀áĞï!␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀¿,±␀Ğï!␀␀␀␀␀>­-äBq␀Æÿ␀␀nÑ␀␀␀‚ù␀␀›␀Ğï!␀␀␀␀␀6ú␀␀úù␀␀!ú␀␀j)␀␀Æÿ␀␀ÿ␀8›␀Ğï!␀␀␀␀␀4␀Ë0Î0j)␀␀Æÿ␀␀ÿ␀·DÑ␀Ğï!␀␀␀␀␀wFwFqC␀êÿ␀␀ÿ␀␀␀␀␀␀␀¤v␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀.Õ␀␀…¬␀␀´␀	Ôï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôï!␀␀␀␀␀Ü␀t␀Ü␀nˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôï!␀␀␀␀␀.%0.0.wˆ␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ôï!␀␀␀␀␀JIşEşEqCˆ␀êÿ␀␀ÿ␀“-´␀Ôï!␀␀␀␀␀UA‚␀‚␀rÖ‡␀Æÿ␀␀+Ğ␀␀␀␀=Ôï!␀␀␀␀␀ü␀␀␀c␀␀␀ÿ␀␀ÿ␀*␀áÔï!␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀AÄ␀␀=Ôï!␀␀␀␀␀uÄ␀␀tÄ␀␀uÄ␀␀c␀␀␀␀ÿ␀␀ÿ␀]␀K	Ôï!␀␀␀␀␀G␀F␀G␀n␀Æÿ␀␀ÿ␀,·␀Ôÿ1␀␀␀␀␀ß?ÈÈW)␀␀Æÿ␀␀½Ï␀␀␀r␀*	␀␀␀␀␀␀␀C␀;␀C␀n␀Æÿ␀␀ÿ␀,·␀␀␀␀␀␀␀␀ÌÌW)␀␀Æÿ␀␀½Ï␀␀␀␀␀/Õ␀␀␀␀0;1;2;35Õ␀␀	SENIOR;0Á␀␀

/* Trigger Insert - Statement */
TRIGGER R038HSI_SI AFTER INSERT ON R038HSI

DECLARE
/* CURSOR c/ os registros gravados no R038HSI_AUX */
  CURSOR c_r038hsi_ins IS
    SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, CODSIN, SOCSIN FROM R038HSI_AUX;

  TYPE t_r038HSI_aux IS RECORD(
    NUMEMP   R038HSI_AUX.NUMEMP%TYPE,
    TIPCOL   R038HSI_AUX.TIPCOL%TYPE,
    NUMCAD   R038HSI_AUX.NUMCAD%TYPE,
    DATALT   R038HSI_AUX.DATALT%TYPE,
    CODSIN   R038HSI_AUX.CODSIN%TYPE,
    SOCSIN   R038HSI_AUX.SOCSIN%TYPE);

  l_r038HSI_aux t_r038HSI_aux;
BEGIN

  /* Apaga Registro OLD em R038HSI_AUX */
  BEGIN
    DELETE FROM R038HSI_AUX;
  EXCEPTION
    WHEN OTHERS THEN
      NULL;
  END;
END␀2Õ␀␀		SENIOR;0¡␀␀

TRIGGER R038HSI_EI AFTER INSERT ON R038HSI FOR EACH ROW

DECLARE
l_datsin DATE;
  l_comando_nulo BOOLEAN;
  l_Valor VARCHAR2(2000);
  l_HorasNoturnas VARCHAR2(1);
  l_layoutAltContratual VARCHAR2(6);
  l_temAud BOOLEAN;
  l_codrpa NUMBER(15);
  l_datTemp VARCHAR(10);
BEGIN
  IF  :NEW.STAHIS = 1 THEN
    BEGIN
      SELECT R034FUN.DATSIN INTO l_datsin
        FROM R034FUN
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      l_comando_nulo:=TRUE;
    END;

    IF   (:NEW.DATALT >= l_datsin)
    OR   (l_datsin IS NULL) THEN
         UPDATE R034FUN
            SET SOCSIN = :NEW.SOCSIN,
                DATSIN = :NEW.DATALT
          WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                R034FUN.NUMEMP = :NEW.NUMEMP AND
                R034FUN.NUMCAD = :NEW.NUMCAD;
    END IF;
  END IF;

  BEGIN
    /* Insere Registro Old */
    INSERT INTO R038HSI_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, CODSIN, SOCSIN, STAHIS)
                     VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, :NEW.CODSIN, :NEW.SOCSIN, :NEW.STAHIS);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R038HSI_AUX.';
  END;

  /*e-Social*/
  RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAltContratual OUT);
  IF (l_layoutAltContratual = 'S-2206') THEN
    l_HorasNoturnas := 'N';
    BEGIN
      SELECT R030EMP.HORNOT 
      INTO l_HorasNoturnas
      FROM R030EMP
      WHERE R030EMP.NUMEMP = :NEW.NUMEMP;
    EXCEPTION 
      WHEN OTHERS THEN
        NULL;
    END;

    IF (l_HorasNoturnas = 'S') THEN
      l_Valor := '';
      SP_CONCATENAR_NUM('TIPCOL', :NEW.TIPCOL, l_Valor OUT);
      SP_CONCATENAR_NUM('NUMCAD', :NEW.NUMCAD, l_Valor OUT);
      SP_CONCATENAR_DAT('DATALT', :NEW.DATALT, l_Valor OUT);

      SP_ESOCIAL_1050(:NEW.NUMEMP, 'R038HSI', 'I', l_Valor, '', 0, 'R038HSI_EI');
    END IF;

    SP_HIST_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038HSI', 'DATALT', 'I', '', '', 0, 'R038HSI_EI');
  END IF;
  /*e-Social*/
  
  /* Log - Rastreamento */
  SP_EXISTE_LOG(24, 161, 1, l_temAud OUT); 
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, 24, 1, 161, 1, 'R038HSI_EI', 'FR038HSI'); 
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
      SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);      
    EXCEPTION
  	  WHEN OTHERS THEN RAISERROR 103 'R038HSI_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;
   
   BEGIN
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSIN', CONVERT(NUMBER_TO_CHAR, :NEW.CODSIN));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SOCSIN', :NEW.SOCSIN);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
    END;
  END IF;    
  /* Log - Rastreamento */
END␀6Õ␀␀	SENIOR;0J␀␀

/* Trigger Update - Statement */
TRIGGER R038HSI_SU AFTER UPDATE ON R038HSI

DECLARE
/* CURSOR c/ os registros gravados no R038HSI_AUX */
  CURSOR c_r038HSI_upd IS
    SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, CODSIN, SOCSIN, EMPOLD, TIPOLD, CADOLD, DATOLD, SINOLD, SOCOLD
      FROM R038HSI_AUX WHERE (CODSIN <> SINOLD OR SOCSIN <> SOCOLD);

  TYPE t_r038HSI_aux IS RECORD(
    NUMEMP   R038HSI_AUX.NUMEMP%TYPE,
    TIPCOL   R038HSI_AUX.TIPCOL%TYPE,
    NUMCAD   R038HSI_AUX.NUMCAD%TYPE,
    DATALT   R038HSI_AUX.DATALT%TYPE,
    CODSIN   R038HSI_AUX.CODSIN%TYPE,
    SOCSIN   R038HSI_AUX.SOCSIN%TYPE,
    EMPOLD   R038HSI_AUX.EMPOLD%TYPE,
    TIPOLD   R038HSI_AUX.TIPOLD%TYPE,
    CADOLD   R038HSI_AUX.CADOLD%TYPE,
    DATOLD   R038HSI_AUX.DATOLD%TYPE,
    SINOLD   R038HSI_AUX.SINOLD%TYPE,
    SOCOLD   R038HSI_AUX.SOCOLD%TYPE
    );

  xR038HSI_aux t_r038HSI_aux;
BEGIN

  /* Apaga registros da R038HSI_AUX */
  BEGIN
    DELETE FROM R038HSI_AUX;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na exclusão dos registros da R038HSI_AUX';
  END;
END␀3Õ␀␀		SENIOR;0\␀␀

TRIGGER R038HSI_EU AFTER UPDATE ON R038HSI FOR EACH ROW

DECLARE
l_datsin DATE;
  l_comando_nulo BOOLEAN;
  l_Valor VARCHAR2(2000);
  l_Valor2 VARCHAR2(2000);
  l_Valido BOOLEAN;
  l_Alterou BOOLEAN;
  l_AlterouCODSIN BOOLEAN;
  l_JsonCamposAlterados VARCHAR2(2000);
  l_HorasNoturnas VARCHAR2(1);
  l_layoutAltContratual VARCHAR2(6);
  l_temAud BOOLEAN;
  l_codrpa NUMBER(15);
  l_datTemp VARCHAR(10);
  l_InfoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
    
BEGIN
  IF  :NEW.STAHIS = 1 THEN
    BEGIN
      SELECT R034FUN.DATSIN INTO l_datsin
        FROM R034FUN
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      l_comando_nulo:=TRUE;
    END;
    IF   (:NEW.datalt >= l_datsin)
    OR   (l_datsin IS NULL) THEN
         UPDATE R034FUN
            SET SOCSIN = :NEW.SOCSIN,
                DATSIN = :NEW.DATALT
          WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                R034FUN.NUMEMP = :NEW.NUMEMP AND
                R034FUN.NUMCAD = :NEW.NUMCAD;
    END IF;
  END IF;
  
  /*e-Social*/
  l_Alterou := FALSE;
  l_AlterouCODSIN := FALSE;
  l_JsonCamposAlterados := '';
  l_InfoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;
  
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  
  SP_VALUPDATE_NUM(:OLD.CODSIN, :NEW.CODSIN, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    l_AlterouCODSIN := TRUE;
    SP_CONCAT_NUM_JSON('CODSIN', :NEW.CodSin, :OLD.CodSin, l_JsonCamposAlterados OUT);
  END IF;

  /* Só monitora o campo se o cliente opta por enviar as informações facultativas*/
  IF (l_InfoFacult = TRUE AND l_SimplificaoESocial = FALSE) THEN
      SP_VALUPDATE_DES(:OLD.SOCSIN, :NEW.SOCSIN, l_Valido OUT);
      /* Campo deprecado na versão 1.0*/
      IF (l_Valido = TRUE) THEN
         l_Alterou := TRUE;
         SP_CONCAT_DES_JSON('SOCSIN', :NEW.SocSin, :OLD.SocSin, l_JsonCamposAlterados OUT);
      END IF;
  END IF;

  IF (l_Alterou = TRUE) THEN
    RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAltContratual OUT);
    IF (l_layoutAltContratual = 'S-2206') THEN
      IF (l_AlterouCODSIN = TRUE) THEN
        l_HorasNoturnas := 'N';
        BEGIN
          SELECT R030EMP.HORNOT 
          INTO l_HorasNoturnas
          FROM R030EMP
          WHERE R030EMP.NUMEMP = :NEW.NUMEMP;
        EXCEPTION 
          WHEN OTHERS THEN
            NULL;
        END;

        IF (l_HorasNoturnas = 'S') THEN
          l_Valor := '';
          SP_CONCATENAR_NUM('TIPCOL', :NEW.TIPCOL, l_Valor OUT);
          SP_CONCATENAR_NUM('NUMCAD', :NEW.NUMCAD, l_Valor OUT);
          SP_CONCATENAR_DAT('DATALT', :NEW.DATALT, l_Valor OUT);
          
          l_Valor2 := '';
          SP_CONCATENAR_NUM('TIPCOL', :OLD.TIPCOL, l_Valor2 OUT);
          SP_CONCATENAR_NUM('NUMCAD', :OLD.NUMCAD, l_Valor2 OUT);
          SP_CONCATENAR_DAT('DATALT', :OLD.DATALT, l_Valor2 OUT);

          SP_ESOCIAL_1050(:NEW.NUMEMP, 'R038HSI', 'A', l_Valor, l_Valor2, 0, 'R038HSI_EU');
        END IF;
      END IF;

      SP_HIST_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038HSI', 'DATALT', 'A', '', l_JsonCamposAlterados, 0, 'R038HSI_EU');
    END IF;
  END IF;
  /*e-Social*/
  
  /* Log - Rastreamento */
  IF ((:OLD.NumEmp <> :NEW.NumEmp)
  OR (:OLD.TipCol <> :NEW.TipCol)
  OR (:OLD.NumCad <> :NEW.NumCad)
  OR (:OLD.DatAlt <> :NEW.DatAlt)
  OR (:OLD.CodSin <> :NEW.CodSin)
  OR (:OLD.SocSin <> :NEW.SocSin)
  OR (:OLD.StaHis <> :NEW.StaHis)) THEN
    
    SP_EXISTE_LOG(24, 162, 1, l_temAud OUT);    
  
    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, 1, 24, 1, 162, 1, 'R038HSI_EU', 'FR038HSI');
     
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', CONVERT(DATE_TO_CHAR, :OLD.DATALT));
      EXCEPTION
  	    WHEN OTHERS THEN RAISERROR 103 'R038HSI_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
    
      BEGIN 
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODSIN', CONVERT(NUMBER_TO_CHAR, :OLD.CODSIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODSIN', CONVERT(NUMBER_TO_CHAR, :NEW.CODSIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSOCSIN', :OLD.SOCSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSOCSIN', :NEW.SOCSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSTAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSTAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
      END;
	END IF;
  END IF;  
  /* Log - Rastreamento */
END␀4Õ␀␀	SENIOR;0S␀␀TRIGGER R038HSI_SD AFTER DELETE ON R038HSI

DECLARE
l_socsin       VARCHAR2(1);
  l_datsin       DATE;

  /* CURSOR c/ os registros gravados no R038HSI_AUX */
  CURSOR c_r038HSI_del IS SELECT NUMEMP,TIPCOL,NUMCAD,DATALT,CODSIN,SOCSIN,STAHIS FROM R038HSI_AUX;

  TYPE t_r038HSI_aux IS RECORD(
    NUMEMP   R038HSI_AUX.NUMEMP%TYPE,
    TIPCOL   R038HSI_AUX.TIPCOL%TYPE,
    NUMCAD   R038HSI_AUX.NUMCAD%TYPE,
    DATALT   R038HSI_AUX.DATALT%TYPE,
    CODSIN   R038HSI_AUX.CODSIN%TYPE,
    SOCSIN   R038HSI_AUX.SOCSIN%TYPE,
    STAHIS   R038HSI_AUX.STAHIS%TYPE);

  l_r038HSI_aux t_r038HSI_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r038HSI_del INTO  l_r038HSI_aux.NUMEMP,
                              l_r038HSI_aux.TIPCOL,
                              l_r038HSI_aux.NUMCAD,
                              l_r038HSI_aux.DATALT,
                              l_r038HSI_aux.CODSIN,
                              l_r038HSI_aux.SOCSIN,
                              l_r038HSI_aux.STAHIS
  LOOP
    IF l_r038HSI_aux.STAHIS = 1 THEN
      SELECT SOCSIN, DATSIN INTO l_socsin, l_datsin FROM R034FUN
       WHERE NUMEMP = l_r038HSI_aux.NUMEMP AND TIPCOL = l_r038HSI_aux.TIPCOL AND NUMCAD = l_r038HSI_aux.NUMCAD;

      IF (l_r038HSI_aux.SOCSIN = l_socsin) AND (l_r038HSI_aux.DATALT = l_datsin) THEN
        /* Pega o historico anterior */
        BEGIN
          SELECT A.SOCSIN,A.DATALT
          INTO l_socsin,l_datsin
          FROM R038HSI A
          WHERE A.NUMEMP = l_r038HSI_aux.NUMEMP
          AND   A.TIPCOL = l_r038HSI_aux.TIPCOL
          AND   A.NUMCAD = l_r038HSI_aux.NUMCAD
          AND   A.STAHIS = 1
          AND DATALT IN (SELECT MAX(DATALT) FROM R038HSI
                         WHERE NUMEMP = l_r038HSI_aux.NUMEMP
                         AND   TIPCOL = l_r038HSI_aux.TIPCOL
                         AND   NUMCAD = l_r038HSI_aux.NUMCAD
                         AND   STAHIS = 1);
        EXCEPTION
          WHEN TOO_MANY_ROWS THEN
            RAISERROR 103 'Erro em R038HSI - TOO MANY ROWS';
          WHEN NO_DATA_FOUND THEN
            l_socsin:='N';
            l_datsin:='31/12/1900,00:00:00';
          WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT R038HSI';
        END;

        /* Atualiza tabela de colaboradores */
        BEGIN
          UPDATE R034FUN
             SET SOCSIN = l_socsin,
                 DATSIN = l_datsin
           WHERE R034FUN.TIPCOL = l_r038HSI_aux.TIPCOL AND
                 R034FUN.NUMEMP = l_r038HSI_aux.NUMEMP AND
                 R034FUN.NUMCAD = l_r038HSI_aux.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro Na Atualização do R034FUN';
        END;
      END IF;
    END IF;

  END LOOP;

  /* Apaga Registro OLD em R038HSI_AUX */
  BEGIN
    DELETE FROM R038HSI_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀1Õ␀␀		SENIOR;0ğ
␀␀

TRIGGER R038HSI_ED AFTER DELETE ON R038HSI FOR EACH ROW

DECLARE
  l_layoutAltContratual VARCHAR2(6);
  l_temAud BOOLEAN;
  l_codrpa NUMBER(15);
  l_datTemp VARCHAR(10); 
  l_HorasNoturnas VARCHAR2(1);  
  l_Valor VARCHAR2(2000); 
BEGIN
  BEGIN
    /* Insere Registro Old */
    INSERT INTO R038HSI_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, CODSIN, SOCSIN, STAHIS)
                     VALUES (:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, :OLD.CODSIN, :OLD.SOCSIN, :OLD.STAHIS);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R038HSI_AUX.';
  END;

  /*e-Social*/
  RH_LAY_CONTR_COLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layoutAltContratual OUT);
  IF (l_layoutAltContratual = 'S-2206') THEN
    l_HorasNoturnas := 'N';
    BEGIN
      SELECT R030EMP.HORNOT 
      INTO l_HorasNoturnas
      FROM R030EMP
      WHERE R030EMP.NUMEMP = :OLD.NUMEMP;
    EXCEPTION 
      WHEN OTHERS THEN
        NULL;
    END;

    IF (l_HorasNoturnas = 'S') THEN
      l_Valor := '';
      SP_CONCATENAR_NUM('TIPCOL', :OLD.TIPCOL, l_Valor OUT);
      SP_CONCATENAR_NUM('NUMCAD', :OLD.NUMCAD, l_Valor OUT);
      SP_CONCATENAR_DAT('DATALT', :OLD.DATALT, l_Valor OUT);

      SP_ESOCIAL_1050(:OLD.NUMEMP, 'R038HSI', 'E', l_Valor, '', 0, 'R038HSI_ED');
    END IF;

    SP_HIST_ESOCIAL(l_layoutAltContratual, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, 'R038HSI', 'DATALT', 'E', '', '', 0, 'R038HSI_ED');
  END IF;
  /*e-Social*/
  
  /* Log - Rastreamento */
  SP_EXISTE_LOG(24, 161, 1, l_temAud OUT);  
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, 24, 1, 161, 1, 'R038HSI_ED', 'FR038HSI');
   
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
    EXCEPTION
  	  WHEN OTHERS THEN RAISERROR 103 'R038HSI_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;
   
    BEGIN 
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSIN', CONVERT(NUMBER_TO_CHAR, :OLD.CODSIN));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SOCSIN', :OLD.SOCSIN);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
    END;
    
  END IF;    
  /* Log - Rastreamento */
END␀␀␀¦v␀␀␀␀␀␀␀␀␀␀␀␀0Õ␀␀…¬␀␀´␀Ôï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀tÔï!␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀Ôï!␀␀␀␀␀.%0.0.w␀Æÿ␀␀ÿ␀mDÑ␀Ôï!␀␀␀␀␀JIşEşEqC␀êÿ␀␀ÿ␀“-´␀Ôï!␀␀␀␀␀UA‚␀‚␀r␀Æÿ␀␀ÿ␀␀=Ôï!␀␀␀␀␀ü␀␀␀c␀␀␀ÿ␀␀ÿ␀␀b´␀Ôï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀Û␀tÔï!␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ÿ␀Z$Ì␀Ôï!␀␀␀␀␀.%0.0.w␀Æÿ␀␀ÿ␀MEÑ␀Ôï!␀␀␀␀␀JIşEşEqC␀êÿ␀␀ÿ␀Q␀´␀Ôï!␀␀␀␀␀UA‚␀‚␀r␀Æÿ␀␀ÿ␀␀=Ôï!␀␀␀␀␀ü␀␀␀c␀␀␀ÿ␀␀ÿ␀*␀áÔï!␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀␀␀␀§v␀␀␀␀␀␀␀␀␀␀␀␀␀␀7Õ␀␀…¬␀␀´␀	Ôÿ!␀␀␀␀␀‘<XbXbr‡␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ!␀␀␀␀␀Ü␀t␀Ü␀n¼‡␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ!␀␀␀␀␀.%0.0.wˆ␀Æÿ␀␀…Ó␀␀␀-Ç␀	Ôÿ!␀␀␀␀␀e=¹·␀␀¹·␀␀z␀Æÿ␀␀ÖÒ␀␀␀EÑ␀	Ôÿ!␀␀␀␀␀?K¢G¢GqC␀êÿ␀␀8Õ␀␀␀9,Ì␀␀␀␀␀␀␀␀@)){␀Æÿ␀␀UÑ␀␀␀åDÑ␀␀␀␀␀␀␀␀GÔFÔFqC␀êÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀ºv␀␀␀␀␀␀␀␀9Õ␀␀…¬␀␀´␀	€Ã␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	€Ã␀␀␀␀␀Ü␀t␀Ü␀nˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	€Ã␀␀␀␀␀.%0.0.wı‡␀Æÿ␀␀…Ó␀␀␀EÑ␀	€Ã␀␀␀␀␀¤I¢G¢GqCş‡␀êÿ␀␀ÿ␀¾-	€Ã␀␀␀␀␀iA®␀®␀w␀␀␀ÿ␀␀fÛ␀␀␀µEÑ␀€Ã␀␀␀␀␀PMÉHÉHqC␀êÿ␀␀ÿ␀Ï␀=€Ã␀␀␀␀␀¤␀␀¤␀␀¤␀␀c␀␀␀ÿ␀␀ÿ␀ê␀8€Ã␀␀␀␀␀)␀*£␀c␀␀␀ÿ␀␀ÿ␀L,␀€Ã␀␀␀␀␀"2!2!2+␀␀ÿ␀␀ÿ␀›␀Â␀€Ã␀␀␀␀␀ß␀Ş␀Ş␀‰)␀␀Æÿ␀␀ÿ␀ª␀=€Ã␀␀␀␀␀°␀)°␀c␀␀␀ÿ␀␀ÿ␀“DÑ␀€Ã␀␀␀␀␀aIDFDFqC␀êÿ␀␀ÿ␀␀t€Ã␀␀␀␀␀I␀Ê␀Ê␀n␀Æÿ␀␀ˆÓ␀␀␀?$Ì␀€Ã␀␀␀␀␀(%))w␀␀Æÿ␀␀…Ó␀␀␀ñª␀␀¹␀€Ã␀␀␀␀␀=«␀␀6«␀␀7«␀␀Q)␀␀Æÿ␀␀ÿ␀½␀␀¹␀€Ã␀␀␀␀␀„␀3„␀Q)␀␀Æÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀­v␀␀␀␀␀␀␀␀