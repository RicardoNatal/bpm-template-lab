AND R011LAN.TIPCOL = R011ASS.TIPCOL
AND R011LAN.NUMCAD = R011ASS.NUMCAD 
AND R011LAN.CODBHR = R011ASS.CODBHR 
AND ((R011LAN.CODSIT = R011ASS.SITCRE AND R011LAN.DATLAN = R011ASS.DATCRE AND R011LAN.ORILAN = R011ASS.ORICRE AND R011ASS.ORIDEB = 'G') OR 
    (R011LAN.CODSIT = R011ASS.SITDEB AND R011LAN.DATLAN = R011ASS.DATDEB AND R011LAN.ORILAN = R011ASS.ORIDEB AND R011ASS.ORICRE = 'G'))␀␀ÿu␀ó¥␀␀´␀	␀␀␀␀␀␀␀␀g>XbXbr␀Æÿ␀␀ÿ␀W␀Š␀	␀␀␀␀␀␀␀␀›␀t␀Ü␀n␀Æÿ␀␀ÿ␀ê¥␀␀Ì␀	␀␀␀␀␀␀␀␀‚%€$€$w␀Æÿ␀␀ÿ␀Q␀␀␀␀␀␀␀␀␀␀’␀t␀’␀c␀␀␀ÿ␀␀ÿ␀␀‰ SELECT NUMEMP, TIPCOL, NUMCAD, TIPANU FROM R034ANU 
WHERE NUMEMP = 55 AND TIPANU IN ('V', 'S')
GROUP BY NUMEMP, TIPCOL, NUMCAD, TIPANU␀␀ÿt␀ó¥␀␀´␀	␀␀␀␀␀␀␀␀g>XbXbr␀Æÿ␀␀ÿ␀W␀Š␀	␀␀␀␀␀␀␀␀›␀t␀Ü␀n␀Æÿ␀␀ÿ␀ê¥␀␀Ì␀	␀␀␀␀␀␀␀␀‚%€$€$w␀Æÿ␀␀ÿ␀Q␀␀␀␀␀␀␀␀␀␀’␀t␀’␀c␀␀␀ÿ␀␀ÿ␀␀‰ SELECT NUMEMP, TIPCOL, NUMCAD, TIPANU FROM R034ANU 
WHERE NUMEMP = 55 AND TIPANU IN ('P', 'F')
GROUP BY NUMEMP, TIPCOL, NUMCAD, TIPANU␀␀ÿs␀ó¥␀␀´␀	␀␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀W␀Š␀	␀␀␀␀␀␀␀␀Ù␀t␀Ü␀n¼‡␀Æÿ␀␀ÿ␀ê¥␀␀Ì␀	␀␀␀␀␀␀␀␀.%€$0.w¼‡␀Æÿ␀␀ÿ␀␀A␀␀ SELECT FUN.NUMEMP, FUN.TIPCOL, FUN.NUMCAD FROM R034FUN FUN
WHERE 
EXISTS (SELECT 1 FROM VFP_ANUPER PER WHERE FUN.NUMEMP = PER.NUMEMP AND FUN.TIPCOL = PER.TIPCOL AND FUN.NUMCAD = PER.NUMCAD) AND
EXISTS (SELECT 1 FROM VFP_ANUVAL VAL WHERE FUN.NUMEMP = VAL.NUMEMP AND FUN.TIPCOL = VAL.TIPCOL AND FUN.NUMCAD = VAL.NUMCAD)VFP_ANUPER
