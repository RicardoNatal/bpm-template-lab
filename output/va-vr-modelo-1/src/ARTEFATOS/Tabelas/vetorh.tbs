END␀␀␀âó␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀üŞ␀␀…¬␀␀´␀	€␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀–,Ì␀	€␀␀␀␀␀␀d;§m¹m”)␀␀Æÿ␀␀>ß␀␀␀|DÑ␀	€␀␀␀␀␀␀îLı¢NqC␀êÿ␀␀„ß␀␀␀\w·␀	€␀␀␀␀␀␀Éyıwıwì*␀␀Æÿ␀␀…ß␀␀␀“ü␀␀±␀	€␀␀␀␀␀␀´ÿ␀␀xş␀␀xş␀␀q␀Æÿ␀␀ÿ␀+§␀␀9€␀␀␀␀␀␀ñ©␀␀‡¨␀␀‡¨␀␀:␀␀ÿ␀␀ÿ␀To€␀␀␀␀␀␀ŠY°V°Vi␀␀ÿ␀␀ÿ␀ÒÒ␀€␀␀␀␀␀␀¡¡¡ÿ␀ÿÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀÷ï␀␀␀␀␀␀␀␀␀␀␀ıŞ␀␀…¬␀␀´␀	€␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀–,Ì␀	€␀␀␀␀␀␀d;§m¹m”)␀␀Æÿ␀␀>ß␀␀␀|DÑ␀	€␀␀␀␀␀␀îLı¢NqC␀êÿ␀␀„ß␀␀␀\w·␀	€␀␀␀␀␀␀Éyıwıwì*␀␀Æÿ␀␀…ß␀␀␀A␀␀Ÿ€␀␀␀␀␀␀­␀␀öŒ␀␀­␀␀n␀␀Æÿ␀␀ÿ␀ûS€␀␀␀␀␀␀‘XœV¬XB␀␀ÿ␀␀ÿ␀ıª␀␀=€␀␀␀␀␀␀i␀␀„«␀␀™«␀␀c␀␀␀␀ÿ␀␀ÿ␀ÉDÑ␀€␀␀␀␀␀␀ÕM"_
MqC␀␀êÿ␀␀ÿ␀␀␀␀0;1;2;3ÿŞ␀␀		SENIOR;0Ü␀␀TRIGGER R108RNC_AI
AFTER INSERT ON R108RNC
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  l_codSistema:= 1;
  l_codcpa := 146; 
  l_codtpa := 423; /*INCLUIR EXCLUIR */

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R108RNC_AI', '');

    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:NEW.CODFIC));
      SP_DATSTR(:NEW.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR,:NEW.HORATE));      
     
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R108RNC_AI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDAGR', CONVERT(NUMBER_TO_CHAR,:NEW.INDAGR));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESAGR',:NEW.DESAGR);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOTENV',:NEW.NOTENV);
      SP_DATSTR(:NEW.DATENV, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATENV', l_datTemp);
    END;
  END IF;
END␀␀ß␀␀		SENIOR;0z
␀␀

TRIGGER R108RNC_AU
AFTER UPDATE ON R108RNC
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  IF (
  :OLD.INDAGR <>:NEW.INDAGR OR
  :OLD.DESAGR <>:NEW.DESAGR OR
  :OLD.NOTENV <>:NEW.NOTENV OR
  :OLD.DATENV <>:NEW.DATENV
  ) THEN
    l_codSistema:= 1;
    l_codcpa:= 146;  /* Código da categoria de auditoria - Registro de Notificação Compulsória - Acidentes;*/
    l_codtpa:= 424;  /* Código do tipo de auditoria - Alteração*/

    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R108RNC_AU', '');

      /* Insere os campos chave na tabela de auditoria R995PRC*/
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
      	INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:OLD.CODFIC));
      	SP_DATSTR(:OLD.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
      	INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
      	INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR,:OLD.HORATE)); 
      
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R108RNC_AU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      /* Insere os valores dos campos na tabela de auditoria R995PRT*/
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINDAGR',CONVERT(NUMBER_TO_CHAR,:OLD.INDAGR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINDAGR',CONVERT(NUMBER_TO_CHAR,:NEW.INDAGR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDESAGR',:OLD.DESAGR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDESAGR',:NEW.DESAGR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOTENV',:OLD.NOTENV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNOTENV',:NEW.NOTENV);
        SP_DATSTR(:OLD.DATENV, 'DD/MM/YYYY', l_datTemp OUT);
	    INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATENV', l_datTemp);
	    SP_DATSTR(:NEW.DATENV, 'DD/MM/YYYY', l_datTemp OUT);
	    INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATENV', l_datTemp);
        
      END;
    END IF;
  END IF;
END␀şŞ␀␀		SENIOR;0ì␀␀

TRIGGER R108RNC_AD
AFTER DELETE ON R108RNC
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  l_codSistema:= 1;
  l_codcpa := 146;
  l_codtpa := 423;/*INCLUIR/EXCLUIR R108RNC*/

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R108RNC_AD', '');

    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:OLD.CODFIC));
      SP_DATSTR(:OLD.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR,:OLD.HORATE));
      
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R108RNC_AD: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINDAGR',CONVERT(NUMBER_TO_CHAR,:OLD.INDAGR));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDESAGR',:OLD.DESAGR);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOTENV',:OLD.NOTENV);
      SP_DATSTR(:OLD.DATENV, 'DD/MM/YYYY', l_datTemp OUT);
	  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATENV', l_datTemp);      
    END;
