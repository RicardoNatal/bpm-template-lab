                              l_CONINT, l_TEMPAC, l_MATCOD, l_MATGRP, l_DAMSEG, l_DAMEIP, l_DAMFNC, l_DAMVEI,
                              l_DAMONO, l_DAMPES, l_DAMVLR, l_DAMKIL, l_DAMQTD, l_DAMBLU, l_DAMCOD, l_UTIREP,
                              l_DATHOR, l_BLOCON, l_CONCPF, l_UTIAUT, l_REP671);
      ELSE
          UPDATE R070TSI
          SET TEMGRP = l_TEMGRP, ANTDPL = l_ANTDPL, BLOFAL = l_BLOFAL, TMPALM = l_TMPALM, VERHOR = l_VERHOR,
              VERLOC = l_VERLOC, VERVAL = l_VERVAL, VERAFA = l_VERAFA, VERCRE = l_VERCRE, VISESP = l_VISESP,
              VERDIG = l_VERDIG, TEMTIT = l_TEMTIT, NUMSER = l_NUMSER, TEMCRC = l_TEMCRC, PLANTA = l_PLANTA,
              TEMFXH = l_TEMFXH, PNDGRP = l_PNDGRP, MAPBIO = l_MAPBIO, CNTDIG = l_CNTDIG, DIGVER = l_DIGVER,
              DIGOMO = l_DIGOMO, DIGSAG = l_DIGSAG, CNTFNC = l_CNTFNC, CONVEI = l_CONVEI, LBENEF = l_LBENEF,
              TRMBNF = l_TRMBNF, BLQSAD = l_BLQSAD, BLQTIP = l_BLQTIP, EXCSAD = l_EXCSAD, EXCTIP = l_EXCTIP,
              CNTPLT = l_CNTPLT, ATUALI = l_ATUALI, CONINT = l_CONINT, TEMPAC = l_TEMPAC, MATCOD = l_MATCOD,
              MATGRP = l_MATGRP, DAMSEG = l_DAMSEG, DAMEIP = l_DAMEIP, DAMFNC = l_DAMFNC, DAMVEI = l_DAMVEI,
              DAMONO = l_DAMONO, DAMPES = l_DAMPES, DAMVLR = l_DAMVLR, DAMKIL = l_DAMKIL, DAMQTD = l_DAMQTD,
              DAMBLU = l_DAMBLU, DAMCOD = l_DAMCOD, UTIREP = l_UTIREP, DATHOR = l_DATHOR, BLOCON = l_BLOCON, 
              CONCPF = l_CONCPF, UTIAUT = l_UTIAUT, REP671 = l_REP671;
      END IF;
  EXCEPTION
    WHEN OTHERS THEN
          RAISERROR 103 'SP_PRPTSI: ERRO NA ATUALIZAÇÃO DA R070TSI';
  END;
END		SENIOR;20
R:␀␀PROCEDURE SP_PrpTsi
 IS

l_campo               VARCHAR2(100);
  l_tabela              VARCHAR2(100);
  l_count               NUMBER(1);
  /*Controle de Campos Telemática (Tabela R070TSI)*/
  l_temgrp              CHAR(1);
  l_antdpl              CHAR(1);
  l_blofal              CHAR(1);
  l_tmpalm              CHAR(1);
  l_verhor              CHAR(1);
  l_verloc              CHAR(1);
  l_verval              CHAR(1);
  l_verafa              CHAR(1);
  l_vercre              CHAR(1);
  l_visesp              CHAR(1);
  l_verdig              CHAR(1);
  l_temfxh              CHAR(1);
  l_planta              CHAR(1);
  l_numser              CHAR(1);
  l_temtit              CHAR(1);
  l_temcrc              CHAR(1);
  l_utirep              CHAR(1);
  l_pndgrp              CHAR(1);
  l_mapbio              CHAR(1);
  l_cntdig              CHAR(1);
  l_digver              CHAR(1);
  l_digomo              CHAR(1);
  l_digsag              CHAR(1);
  l_cntfnc              CHAR(1);
  l_convei              CHAR(1);
  l_lbenef              CHAR(1);
  l_trmbnf              CHAR(1);
  l_blqsad              CHAR(1);
  l_blqtip              CHAR(1);
  l_excsad              CHAR(1);
  l_exctip              CHAR(1);
  l_atuali              CHAR(1);
  l_matcod              CHAR(1);
  l_matgrp              CHAR(1);
  l_tempo_ret           CHAR(1);
  l_toler_ret           CHAR(1);
  l_ver_ret             CHAR(1);
  l_tempo_jornada       CHAR(1);
  l_ver_saidamax        CHAR(1);
  l_flg_tempo_min       CHAR(1);
  l_tempo_minimo        CHAR(1);
  l_tol_entrada         CHAR(1);
  l_interDat07          CHAR(1);
  l_conInt              CHAR(1);
  l_tempac              CHAR(1);
  l_bloq                CHAR(1);
  /*Variáveis dam00 (coletor de marcações)*/
  l_damseg              CHAR(1);
  l_dameip              CHAR(1);
  l_damfnc              CHAR(1);
  l_damvei              CHAR(1);
  l_damono              CHAR(1);
  l_dampes              CHAR(1);
  l_damvlr              CHAR(1);
  l_damkil              CHAR(1);
  l_damqtd              CHAR(1);
  l_damblu              CHAR(1);
  l_damcod              CHAR(1);
  l_dathor              CHAR(1);
  l_usutel              VARCHAR2(31);
  l_utiaut              CHAR(1);
  l_dat08rep            CHAR(1);
  l_repgrpf             CHAR(1);
  l_rep671              CHAR(1);

  /*CURSOR que Obtem as colunas da controle*/
  CURSOR c_Controle IS
      SELECT COLUMN_NAME
        FROM ALL_TAB_COLUMNS
       WHERE TABLE_NAME = 'CONTROLE'
         AND COLUMN_NAME IN ('GRUPO_SAB','CRED_FX5','ANTI_DUPLA','BLOQ_FALTA','TEMPO_ALM','VER_HORA',
                             'VER_LOCAL','VER_VALID','VER_AFAST','VER_CRED','VIS_ESP',
                             'NUMSERIAL','TITULAR','VER_DIGIT','FX_DOM','PLANTA','TEMPO_RET',
                             'TOLER_RET','VER_RET','TEMPO_JORNADA','VER_SAIDAMAX','FLG_TEMPO_MIN',
                             'TEMPO_MINIMO','TOL_ENTRADA')
         AND UPPER(OWNER) = l_usutel;

  TYPE t_Controle IS RECORD(
    COLUMN_NAME VARCHAR2(100));
  l_Controle t_Controle;

  /*CURSOR que Obtem as colunas da controle*/
  CURSOR c_Dat07 IS
      SELECT COLUMN_NAME
        FROM ALL_TAB_COLUMNS
       WHERE TABLE_NAME = 'DAT07'
         AND COLUMN_NAME IN ('BLOQ')
         AND UPPER(OWNER) = l_usutel;

  TYPE t_Dat07 IS RECORD(
    COLUMN_NAME VARCHAR2(100));
  l_Dat07 t_Dat07;

  /*CURSOR que Obtem as demais tabelas da telemática*/
  CURSOR c_tabelasTSI IS
      SELECT DISTINCT TABLE_NAME
        FROM ALL_TAB_COLUMNS
       WHERE (TABLE_NAME IN ('PEND_GRUPO','MAPABIO','CONTDIG','CONTDIG_VERI','CONTDIG_OMOK','CONTDIG_SAGEM',
                           'CONTFUNC','CONTVEI','LBENEF01','TERMBENEF','BLOQSAD','BLOQTIPO','EXCESAD',
                           'EXCETIPO','ATUALI','MATCODIN','MATGRUPO','REPEMPR001','DATAHORA','DAT08REP','REPGRPF')
                       OR (TABLE_NAME = 'DAT07' AND COLUMN_NAME IN ('VALID_RET', 'VALID_SAIDAMAX')))
         AND UPPER(OWNER) = l_usutel;

  TYPE t_tabelasTSI IS RECORD(
    TABLE_NAME VARCHAR2(100));
  l_tabelasTSI t_tabelasTSI;

  /*CURSOR que obtem os campos da tabela DAM00*/
  CURSOR c_Dam00 IS
      SELECT COLUMN_NAME
        FROM ALL_TAB_COLUMNS
       WHERE TABLE_NAME = 'DAM00' AND
             COLUMN_NAME IN ('SEGUNDO','END_IP','CODFNC','VEICULO','ONOFF','PESO','VALOR',
                             'VALKILO', 'QTDE', 'BLUEB', 'CODTT')
         AND UPPER(OWNER) = l_usutel;
  TYPE t_Dam00 IS RECORD(
    COLUMN_DAM00 VARCHAR2(100));
  l_Dam00 t_Dam00;

  /*CURSOR que obtem as colunas da tabela REPEMPR002*/
  CURSOR c_RepEmpr002 IS
      SELECT COLUMN_NAME
        FROM ALL_TAB_COLUMNS
       WHERE TABLE_NAME = 'REPEMPR002'
         AND COLUMN_NAME IN ('CPF')
         AND UPPER(OWNER) = l_usutel;

  TYPE t_RepEmpr002 IS RECORD(
    COLUMN_NAME VARCHAR2(100));
  l_RepEmpr002 t_RepEmpr002;

BEGIN
  /*Inicialização das Variáveis*/
  l_temgrp := 'N';
  l_antdpl := 'N';
  l_blofal := 'N';
  l_tmpalm := 'N';
  l_verhor := 'N';
  l_verloc := 'N';
  l_verval := 'N';
  l_verafa := 'N';
  l_vercre := 'N';
  l_visesp := 'N';
  l_verdig := 'N';
  l_temfxh := 'S'; /*Inicialização diferenciada para Fxhoraria*/
  l_planta := 'N';
  l_numser := 'N';
  l_temtit := 'N';
  l_temcrc := 'N';
  l_utirep := 'N';
  /*Inicialização Controle Tabelas TSI*/
  l_pndgrp := 'N';
  l_mapbio := 'N';
  l_cntdig := 'N';
  l_digver := 'N';
  l_digomo := 'N';
  l_digsag := 'N';
  l_cntfnc := 'N';
  l_convei := 'N';
  l_lbenef := 'N';
  l_trmbnf := 'N';
  l_blqsad := 'N';
  l_blqtip := 'N';
  l_excsad := 'N';
  l_exctip := 'N';
  l_atuali := 'N';
  l_matcod := 'N';
  l_matgrp := 'N';
  l_tempo_ret := 'N';
  l_toler_ret := 'N';
  l_ver_ret   := 'N';
  l_tempo_jornada  := 'N';
  l_ver_saidamax   := 'N';
  l_flg_tempo_min := 'N';
  l_tempo_minimo := 'N';
  l_tol_entrada := 'N';
  l_interDat07     := 'N';
  l_conInt := 'N';
  l_tempac := 'N';
  l_damseg := 'N';
  l_dameip := 'N';
  l_damfnc := 'N';
  l_damvei := 'N';
  l_damono := 'N';
  l_dampes := 'N';
  l_damvlr := 'N';
  l_damkil := 'N';
  l_damqtd := 'N';
  l_damblu := 'N';
  l_damcod := 'N';
  l_dathor := 'N';
  l_bloq   := 'N';
  l_utiaut := 'N';
  l_dat08rep := 'N';
  l_repgrpf := 'N';
  l_rep671 := 'N';

  /* verifica o usuário tsi*/
  l_usutel := '';
  BEGIN
      SELECT UPPER(LTRIM(RTRIM(USUTEL))) INTO l_usutel FROM R070DAC;
  EXCEPTION WHEN OTHERS THEN
      l_usutel := '';
  END;

  IF (l_usutel = '') OR (l_usutel IS NULL) THEN
    l_usutel := 'TELEMAT';
  END IF;


  /* verifica no banco se existe os campos */
  FOREACH c_Controle INTO l_Controle.COLUMN_NAME
  LOOP
      l_campo  := l_Controle.COLUMN_NAME;
      IF (l_campo = 'GRUPO_SAB') THEN
          l_temgrp := 'S';
      ELSIF (l_campo = 'CRED_FX5') THEN
          l_temcrc := 'S';
      ELSIF (l_campo = 'PLANTA') THEN
          l_planta := 'S';
      ELSIF (l_campo = 'ANTI_DUPLA') THEN
          l_antdpl := 'S';
      ELSIF (l_campo = 'BLOQ_FALTA') THEN
          l_blofal := 'S';
      ELSIF (l_campo = 'TEMPO_ALM') THEN
          l_tmpalm := 'S';
      ELSIF (l_campo = 'VER_HORA') THEN
          l_verhor := 'S';
      ELSIF (l_campo = 'VER_LOCAL') THEN
          l_verloc := 'S';
      ELSIF (l_campo = 'VER_VALID') THEN
          l_verval := 'S';
      ELSIF (l_campo = 'VER_AFAST') THEN
          l_verafa := 'S';
      ELSIF (l_campo = 'VER_CRED') THEN
          l_vercre := 'S';
      ELSIF (l_campo = 'VIS_ESP') THEN
          l_visesp := 'S';
      ELSIF (l_campo = 'VER_DIGIT') THEN
          l_verdig := 'S';
      ELSIF (l_campo = 'NUMSERIAL') THEN
          l_numser := 'S';
      ELSIF (l_campo = 'FX_DOM') THEN
          l_temfxh := 'N';
      ELSIF (l_campo = 'TITULAR') THEN
          l_temtit := 'S';
      ELSIF (l_campo = 'TEMPO_RET') THEN
          l_tempo_ret := 'S';
      ELSIF (l_campo = 'TOLER_RET') THEN
          l_toler_ret := 'S';
      ELSIF (l_campo = 'VER_RET') THEN
          l_ver_ret := 'S';
      ELSIF (l_campo = 'TEMPO_JORNADA') THEN
          l_tempo_jornada := 'S';
      ELSIF (l_campo = 'VER_SAIDAMAX') THEN
          l_ver_saidamax := 'S';
      /*Controle Permanência de Acesso*/
      ELSIF (l_campo = 'FLG_TEMPO_MIN') THEN
          l_flg_tempo_min := 'S';
      ELSIF (l_campo = 'TEMPO_MINIMO') THEN
          l_tempo_minimo := 'S';
      ELSIF (l_campo = 'TOL_ENTRADA') THEN
          l_tol_entrada := 'S';
      END IF;
  END LOOP;

  FOREACH c_Dam00 INTO l_Dam00.Column_Dam00
  LOOP
      l_campo  := l_Dam00.Column_Dam00;
      IF (l_campo = 'SEGUNDO') THEN
          l_damseg := 'S';
      ELSIF (l_campo = 'END_IP') THEN
          l_dameip := 'S';
      ELSIF (l_campo = 'CODFNC') THEN
          l_damFnc := 'S';
      ELSIF (l_campo = 'VEICULO') THEN
          l_damVei := 'S';
      ELSIF (l_campo = 'ONOFF') THEN
          l_damono := 'S';
      ELSIF (l_campo = 'PESO') THEN
          l_dampes := 'S';
      ELSIF (l_campo = 'VALOR') THEN
          l_damvlr := 'S';
      ELSIF (l_campo = 'VALKILO') THEN
          l_damkil := 'S';
      ELSIF (l_campo = 'QTDE') THEN
          l_damqtd := 'S';
      ELSIF (l_campo = 'BLUEB') THEN
          l_damblu := 'S';
      ELSIF (l_campo = 'CODTT') THEN
          l_damcod := 'S';
      END IF;
  END LOOP;

  FOREACH c_tabelasTSI INTO l_tabelasTSI.Table_Name
  LOOP
      l_tabela := l_tabelasTSI.Table_Name;
      IF (l_tabela = 'PEND_GRUPO') THEN
          l_pndgrp := 'S';
      ELSIF (l_tabela = 'MAPABIO') THEN
          l_mapbio := 'S';
      ELSIF (l_tabela = 'CONTDIG') THEN
          l_cntdig := 'S';
      ELSIF (l_tabela = 'CONTDIG_VERI') THEN
          l_digver := 'S';
      ELSIF (l_tabela = 'CONTDIG_OMOK') THEN
          l_digomo := 'S';
      ELSIF (l_tabela = 'CONTDIG_SAGEM') THEN
          l_digsag := 'S';
      ELSIF (l_tabela = 'CONTFUNC') THEN
          l_cntfnc := 'S';
      ELSIF (l_tabela = 'CONTVEI') THEN
          l_convei := 'S';
      ELSIF (l_tabela = 'LBENEF01') THEN
          l_lbenef := 'S';
      ELSIF (l_tabela = 'TERMBENEF') THEN
          l_trmbnf := 'S';
      ELSIF (l_tabela = 'BLOQSAD') THEN
          l_blqsad := 'S';
      ELSIF (l_tabela = 'BLOQTIPO') THEN
          l_blqtip := 'S';
      ELSIF (l_tabela = 'EXCESAD') THEN
          l_excsad := 'S';
      ELSIF (l_tabela = 'EXCETIPO') THEN
          l_exctip := 'S';
      ELSIF (l_tabela = 'ATUALI') THEN
          l_atuali := 'S';
      ELSIF (l_tabela = 'MATCODIN') THEN
          l_matcod := 'S';
      ELSIF (l_tabela = 'MATGRUPO') THEN
          l_matgrp := 'S';
      ELSIF (l_tabela = 'DAT07') THEN
          l_interDat07 := 'S';
      ELSIF (l_tabela = 'REPEMPR001') THEN
          l_utirep := 'S';
      ELSIF (l_tabela = 'DATAHORA') THEN
          l_dathor := 'S';
      ELSIF (l_tabela = 'DAT08REP') THEN
          l_dat08rep := 'S';
      ELSIF (l_tabela = 'REPGRPF') THEN
          l_repgrpf := 'S';
      END IF;
  END LOOP;

  FOREACH c_Dat07 INTO l_Dat07.COLUMN_NAME
  LOOP
      IF (l_Dat07.COLUMN_NAME = 'BLOQ') THEN
        l_bloq := 'S';
      END IF;
  END LOOP;

  /*Controle de Interjornadas*/
  IF (l_tempo_ret = 'S' AND l_toler_ret = 'S' AND l_ver_ret = 'S' AND l_tempo_jornada = 'S' AND
      l_ver_saidamax = 'S' AND l_interDat07 = 'S') THEN
      l_conInt := 'S';
  ELSE
      l_conInt := 'N';
  END IF;

  /*Controle Permanência de Acesso*/
  IF (l_flg_tempo_min = 'S' AND l_tempo_minimo = 'S' AND l_tol_entrada = 'S') THEN
    l_tempac := 'S';
  ELSE
    l_tempac := 'N';
  END IF;
  
  /* Carga de inclusao/exclusao automatica no REP Telematica */
  IF (l_dat08rep = 'S' AND l_repgrpf = 'S') THEN
    l_utiaut := 'S';
  ELSE
  	l_utiaut := 'N';
  END IF;

  /*REP Portaria 671*/
  FOREACH c_RepEmpr002 INTO l_RepEmpr002.COLUMN_NAME
  LOOP
      IF (l_RepEmpr002.COLUMN_NAME = 'CPF') THEN
        l_rep671 := 'S';
      END IF;
  END LOOP;

  BEGIN
      SELECT COUNT(*) QNTREG INTO l_count FROM R070TSI;
  EXCEPTION
      WHEN OTHERS THEN
          RAISERROR 103 'SP_PRPTSI: ERRO NO SELECT R070TSI';
  END;
  BEGIN
      IF (l_count = 0) THEN
          INSERT INTO R070TSI (TEMGRP, ANTDPL, BLOFAL, TMPALM, VERHOR, VERLOC, VERVAL, VERAFA, VERCRE, VISESP,
                               VERDIG, TEMTIT, NUMSER, TEMCRC, PLANTA, TEMFXH, PNDGRP, MAPBIO, CNTDIG, DIGVER,
                               DIGOMO, DIGSAG, CNTFNC, CONVEI, LBENEF, TRMBNF, BLQSAD, BLQTIP, EXCSAD, EXCTIP,
                               ATUALI, CONINT, TEMPAC, MATCOD, MATGRP, DAMSEG, DAMEIP, DAMFNC, DAMVEI,
                               DAMONO, DAMPES, DAMVLR, DAMKIL, DAMQTD, DAMBLU, DAMCOD, UTIREP, DATHOR, BLOCON,
                               UTIAUT, REP671)
                      VALUES (l_TEMGRP, l_ANTDPL, l_BLOFAL, l_TMPALM, l_VERHOR, l_VERLOC, l_VERVAL, l_VERAFA,
                              l_VERCRE, l_VISESP, l_VERDIG, l_TEMTIT, l_NUMSER, l_TEMCRC, l_PLANTA, l_TEMFXH,
                              l_PNDGRP, l_MAPBIO, l_CNTDIG, l_DIGVER, l_DIGOMO, l_DIGSAG, l_CNTFNC, l_CONVEI,
                              l_LBENEF, l_TRMBNF, l_BLQSAD, l_BLQTIP, l_EXCSAD, l_EXCTIP, l_ATUALI,
                              l_CONINT, l_TEMPAC, l_MATCOD, l_MATGRP, l_DAMSEG, l_DAMEIP, l_DAMFNC, l_DAMVEI,
                              l_DAMONO, l_DAMPES, l_DAMVLR, l_DAMKIL, l_DAMQTD, l_DAMBLU, l_DAMCOD, l_UTIREP,
                              l_DATHOR, l_BLOQ, l_UTIAUT, l_REP671);
      ELSE
          UPDATE R070TSI
          SET TEMGRP = l_TEMGRP, ANTDPL = l_ANTDPL, BLOFAL = l_BLOFAL, TMPALM = l_TMPALM, VERHOR = l_VERHOR,
              VERLOC = l_VERLOC, VERVAL = l_VERVAL, VERAFA = l_VERAFA, VERCRE = l_VERCRE, VISESP = l_VISESP,
              VERDIG = l_VERDIG, TEMTIT = l_TEMTIT, NUMSER = l_NUMSER, TEMCRC = l_TEMCRC, PLANTA = l_PLANTA,
              TEMFXH = l_TEMFXH, PNDGRP = l_PNDGRP, MAPBIO = l_MAPBIO, CNTDIG = l_CNTDIG, DIGVER = l_DIGVER,
              DIGOMO = l_DIGOMO, DIGSAG = l_DIGSAG, CNTFNC = l_CNTFNC, CONVEI = l_CONVEI, LBENEF = l_LBENEF,
              TRMBNF = l_TRMBNF, BLQSAD = l_BLQSAD, BLQTIP = l_BLQTIP, EXCSAD = l_EXCSAD, EXCTIP = l_EXCTIP,
              ATUALI = l_ATUALI, CONINT = l_CONINT, TEMPAC = l_TEMPAC, MATCOD = l_MATCOD, MATGRP = l_MATGRP,
              DAMSEG = l_DAMSEG, DAMEIP = l_DAMEIP, DAMFNC = l_DAMFNC, DAMVEI = l_DAMVEI, DAMONO = l_DAMONO,
              DAMPES = l_DAMPES, DAMVLR = l_DAMVLR, DAMKIL = l_DAMKIL, DAMQTD = l_DAMQTD, DAMBLU = l_DAMBLU,
              DAMCOD = l_DAMCOD, UTIREP = l_UTIREP, DATHOR = l_DATHOR, BLOCON = l_BLOQ,   REP671 = l_REP671;
      END IF;
  EXCEPTION
    WHEN OTHERS THEN
          RAISERROR 103 'SP_PRPTSI: ERRO NA ATUALIZAÇÃO DA R070TSI';
  END;
END	MSSQL;23
6A␀␀CREATE  PROCEDURE sp_prptsi AS
BEGIN
DECLARE @l_campo VARCHAR(100)
DECLARE @l_tabela VARCHAR(100)
DECLARE @l_count SMALLINT
DECLARE @l_temgrp CHAR(1)
DECLARE @l_antdpl CHAR(1)
DECLARE @l_blofal CHAR(1)
DECLARE @l_tmpalm CHAR(1)
DECLARE @l_verhor CHAR(1)
DECLARE @l_verloc CHAR(1)
DECLARE @l_verval CHAR(1)
DECLARE @l_verafa CHAR(1)
DECLARE @l_vercre CHAR(1)
DECLARE @l_visesp CHAR(1)
DECLARE @l_verdig CHAR(1)
DECLARE @l_temfxh CHAR(1)
DECLARE @l_planta CHAR(1)
DECLARE @l_numser CHAR(1)
DECLARE @l_temtit CHAR(1)
DECLARE @l_temcrc CHAR(1)
DECLARE @l_utirep CHAR(1)
DECLARE @l_pndgrp CHAR(1)
DECLARE @l_mapbio CHAR(1)
DECLARE @l_cntdig CHAR(1)
DECLARE @l_digver CHAR(1)
DECLARE @l_digomo CHAR(1)
DECLARE @l_digsag CHAR(1)
DECLARE @l_cntfnc CHAR(1)
DECLARE @l_convei CHAR(1)
DECLARE @l_lbenef CHAR(1)
DECLARE @l_trmbnf CHAR(1)
DECLARE @l_blqsad CHAR(1)
DECLARE @l_blqtip CHAR(1)
DECLARE @l_excsad CHAR(1)
DECLARE @l_exctip CHAR(1)
DECLARE @l_atuali CHAR(1)
DECLARE @l_matcod CHAR(1)
DECLARE @l_matgrp CHAR(1)
DECLARE @l_tempo_ret CHAR(1)
DECLARE @l_toler_ret CHAR(1)
DECLARE @l_ver_ret CHAR(1)
DECLARE @l_tempo_jornada CHAR(1)
DECLARE @l_ver_saidamax CHAR(1)
DECLARE @l_flg_tempo_min CHAR(1)
DECLARE @l_tempo_minimo CHAR(1)
DECLARE @l_tol_entrada CHAR(1)
DECLARE @l_interdat07 CHAR(1)
DECLARE @l_conint CHAR(1)
DECLARE @l_tempac CHAR(1)
DECLARE @l_bloq CHAR(1)
DECLARE @l_damseg CHAR(1)
DECLARE @l_dameip CHAR(1)
DECLARE @l_damfnc CHAR(1)
DECLARE @l_damvei CHAR(1)
DECLARE @l_damono CHAR(1)
DECLARE @l_dampes CHAR(1)
DECLARE @l_damvlr CHAR(1)
DECLARE @l_damkil CHAR(1)
DECLARE @l_damqtd CHAR(1)
DECLARE @l_damblu CHAR(1)
DECLARE @l_damcod CHAR(1)
DECLARE @l_dathor CHAR(1)
DECLARE @l_utiaut CHAR(1)
DECLARE @l_dat08rep CHAR(1)
DECLARE @l_repgrpf CHAR(1)
DECLARE @l_rep671 CHAR(1)
DECLARE @l_usutel VARCHAR(31)
DECLARE @l_controle_column_name VARCHAR(100)
DECLARE @l_dat07_column_name VARCHAR(100)
DECLARE @l_repempr002_column_name VARCHAR(100)
DECLARE @l_tabelastsi_table_name VARCHAR(100)
DECLARE @l_dam00_column_dam00 VARCHAR(100)
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @SE_EXC7 INTEGER
  DECLARE @SE_EXC8 INTEGER
  SELECT @ChkError = 0
  SELECT @l_temgrp = 'N'
  SELECT @l_antdpl = 'N'
  SELECT @l_blofal = 'N'
  SELECT @l_tmpalm = 'N'
  SELECT @l_verhor = 'N'
  SELECT @l_verloc = 'N'
  SELECT @l_verval = 'N'
  SELECT @l_verafa = 'N'
  SELECT @l_vercre = 'N'
  SELECT @l_visesp = 'N'
  SELECT @l_verdig = 'N'
  SELECT @l_temfxh = 'S'
  SELECT @l_planta = 'N'
  SELECT @l_numser = 'N'
  SELECT @l_temtit = 'N'
  SELECT @l_temcrc = 'N'
  SELECT @l_utirep = 'N'
  SELECT @l_pndgrp = 'N'
  SELECT @l_mapbio = 'N'
  SELECT @l_cntdig = 'N'
  SELECT @l_digver = 'N'
  SELECT @l_digomo = 'N'
  SELECT @l_digsag = 'N'
  SELECT @l_cntfnc = 'N'
  SELECT @l_convei = 'N'
  SELECT @l_lbenef = 'N'
  SELECT @l_trmbnf = 'N'
  SELECT @l_blqsad = 'N'
  SELECT @l_blqtip = 'N'
  SELECT @l_excsad = 'N'
  SELECT @l_exctip = 'N'
  SELECT @l_atuali = 'N'
  SELECT @l_matcod = 'N'
  SELECT @l_matgrp = 'N'
  SELECT @l_tempo_ret = 'N'
  SELECT @l_toler_ret = 'N'
  SELECT @l_ver_ret = 'N'
  SELECT @l_tempo_jornada = 'N'
  SELECT @l_ver_saidamax = 'N'
  SELECT @l_flg_tempo_min = 'N'
  SELECT @l_tempo_minimo = 'N'
  SELECT @l_tol_entrada = 'N'
  SELECT @l_interDat07 = 'N'
  SELECT @l_conInt = 'N'
  SELECT @l_tempac = 'N'
  SELECT @l_damseg = 'N'
  SELECT @l_dameip = 'N'
  SELECT @l_damfnc = 'N'
  SELECT @l_damvei = 'N'
  SELECT @l_damono = 'N'
  SELECT @l_dampes = 'N'
  SELECT @l_damvlr = 'N'
  SELECT @l_damkil = 'N'
  SELECT @l_damqtd = 'N'
  SELECT @l_damblu = 'N'
  SELECT @l_damcod = 'N'
  SELECT @l_dathor = 'N'
  SELECT @l_bloq = 'N'
  SELECT @l_utiaut = 'N'
  SELECT @l_dat08rep = 'N'
  SELECT @l_repgrpf = 'N'
  SELECT @l_rep671 = 'N'
  SELECT @l_usutel = ''
  /* TRY */
    SELECT 
      @l_usutel=UPPER(LTRIM(RTRIM(r070dac.usutel))) 
       FROM r070dac r070dac
    SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
    IF @ChkError <> 0
    BEGIN
      GOTO EXC1
    END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC1:
    SELECT @SE_EXC1 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        SELECT @l_usutel = ''
      END
    END
  /* END EXCEPTION HANDLER */
  IF (@l_usutel='') 
      or (@l_usutel is null)
  BEGIN
    SELECT @l_usutel = 'TELESSVR'
  END
  DECLARE c_Controle CURSOR FOR 
          SELECT COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'CONTROLE' AND
             COLUMN_NAME IN ('GRUPO_SAB','CRED_FX5','ANTI_DUPLA','BLOQ_FALTA','TEMPO_ALM','VER_HORA',
	    'VER_LOCAL','VER_VALID','VER_AFAST','VER_CRED','VIS_ESP','NUMSERIAL','TITULAR','VER_DIGIT',
			    'FX_DOM','PLANTA','TEMPO_RET','TOLER_RET','VER_RET','TEMPO_JORNADA','VER_SAIDAMAX',
			    'FLG_TEMPO_MIN','TEMPO_MINIMO','TOL_ENTRADA') AND UPPER(TABLE_SCHEMA) =@l_usutel


  OPEN c_Controle
  FETCH NEXT FROM c_Controle INTO @l_Controle_Column_Name
  WHILE  (@@FETCH_STATUS = 0)
  BEGIN
    SELECT @l_campo = @l_Controle_Column_Name
    IF (@l_campo='GRUPO_SAB')
    BEGIN
      SELECT @l_temgrp = 'S'
    END
    ELSE IF (@l_campo='CRED_FX5')
    BEGIN
      SELECT @l_temcrc = 'S'
    END
    ELSE IF (@l_campo='PLANTA')
    BEGIN
      SELECT @l_planta = 'S'
    END
    ELSE IF (@l_campo='ANTI_DUPLA')
    BEGIN
      SELECT @l_antdpl = 'S'
    END
    ELSE IF (@l_campo='BLOQ_FALTA')
    BEGIN
      SELECT @l_blofal = 'S'
    END
    ELSE IF (@l_campo='TEMPO_ALM')
    BEGIN
      SELECT @l_tmpalm = 'S'
    END
    ELSE IF (@l_campo='VER_HORA')
    BEGIN
      SELECT @l_verhor = 'S'
    END
    ELSE IF (@l_campo='VER_LOCAL')
    BEGIN
      SELECT @l_verloc = 'S'
    END
    ELSE IF (@l_campo='VER_VALID')
    BEGIN
      SELECT @l_verval = 'S'
    END
    ELSE IF (@l_campo='VER_AFAST')
    BEGIN
      SELECT @l_verafa = 'S'
    END
    ELSE IF (@l_campo='VER_CRED')
    BEGIN
      SELECT @l_vercre = 'S'
    END
    ELSE IF (@l_campo='VIS_ESP')
    BEGIN
      SELECT @l_visesp = 'S'
    END
    ELSE IF (@l_campo='VER_DIGIT')
    BEGIN
      SELECT @l_verdig = 'S'
    END
    ELSE IF (@l_campo='NUMSERIAL')
    BEGIN
      SELECT @l_numser = 'S'
    END
    ELSE IF (@l_campo='FX_DOM')
    BEGIN
      SELECT @l_temfxh = 'N'
    END
