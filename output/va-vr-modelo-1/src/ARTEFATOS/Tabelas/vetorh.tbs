  IF  (p_tipcol = 6) THEN
      SP_FaiAlu(p_nummat,
                l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                l_fairef OUT);
  ELSE
      SP_APUCOL(p_numemp, p_tipcol, p_numcad, l_apupfs OUT);
      /*Se o controle for por atividades do professor*/
      IF (l_apupfs = 'A') THEN
          SP_FaiPro(p_numemp,p_tipcol,p_numcad,
                    l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                    l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                    l_fairef OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);

      ELSE
          SP_FaiHor(p_numemp,p_tipcol,p_numcad,
                    l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                    l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                    l_fairef OUT, l_prmsabequal OUT, l_prmdomequal OUT, l_prmsegequal OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);
      END IF;
  END IF;
  LOOP
      /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
      SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
      IF (l_crapri = 0) THEN
          l_crapri := l_cracha;
      END IF;

      /* atualiza a tabela R070CON */
      BEGIN
          UPDATE R070CON SET
                 FAIAC1=l_faidom_a,FAIAC2=l_faiseg_a,FAIAC3=l_faiter_a,FAIAC4=l_faiqua_a,
                 FAIAC5=l_faiqui_a,FAIAC6=l_faisex_a,FAIAC7=l_faisab_a,
                 FAIPT1=l_faidom_p,FAIPT2=l_faiseg_p,FAIPT3=l_faiter_p,FAIPT4=l_faiqua_p,
                 FAIPT5=l_faiqui_p,FAIPT6=l_faisex_p,FAIPT7=l_faisab_p,
                 FAIREF=l_fairef
          WHERE NUMFIS = l_crapri;
      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;
      IF (l_crapro = l_cracha) OR (l_crapro = 0) THEN
        EXIT;
      ELSE
        l_cracha := l_crapro;
      END IF;
  END LOOP;
END		SENIOR;24ISP_RETCRA_IDTPES
SP_FAIALU
SP_APUCOL
SP_FAIPRO
SP_FAIHOR
SP_MAPFIS
M␀␀PROCEDURE SP_ATUHOR(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_NUMMAT VARCHAR2(15))
 IS

l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_craaux       NUMBER(12);  
  l_faidom_a     CHAR(56);
  l_faiseg_a     CHAR(56);
  l_faiter_a     CHAR(56);
  l_faiqua_a     CHAR(56);
  l_faiqui_a     CHAR(56);
  l_faisex_a     CHAR(56);
  l_faisab_a     CHAR(56);
  l_faidom_p     CHAR(56);
  l_faiseg_p     CHAR(56);
  l_faiter_p     CHAR(56);
  l_faiqua_p     CHAR(56);
  l_faiqui_p     CHAR(56);
  l_faisex_p     CHAR(56);
  l_faisab_p     CHAR(56);
  l_fairef       CHAR(56);
  l_crastr       CHAR(12);
  /*Controle de permissão para 3º turno*/
  l_prmsabequal  NUMBER;
  l_prmdomequal  NUMBER;
  l_prmsegequal  NUMBER;
  /* afastamento */
  l_datini       CHAR(6);
  l_datfim       CHAR(6);
  l_horini       CHAR(4);
  l_horfim       CHAR(4);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_apupfs       CHAR(1);

BEGIN
  l_apupfs := 'E';
  /*Obtem o Crachá Titular, se não existir obtem o Provísório */
  SP_RETCRA_IDTPES (1,p_numemp, p_tipcol, p_numcad, 0,p_nummat,0,'',l_cracha OUT);
  IF l_cracha = 0 THEN
      /*Se não encontrou o crachá titular, obtem o provisório*/
      SP_RETCRA_IDTPES (2,p_numemp, p_tipcol, p_numcad, 0,p_nummat,0,'',l_cracha OUT);
      l_crapro := l_cracha;
  ELSE
      /*Obtem o Crachá Provisório*/
      SP_RETCRA_IDTPES (2,p_numemp, p_tipcol, p_numcad, 0,p_nummat,0,'',l_crapro OUT);
  END IF;
  IF  (p_tipcol = 6) THEN
      SP_FaiAlu(p_nummat,
                l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                l_fairef OUT);
  ELSE
      SP_APUCOL(p_numemp, p_tipcol, p_numcad, l_apupfs OUT);
      /*Se o controle for por atividades do professor*/
      IF (l_apupfs = 'A') THEN
          SP_FaiPro(p_numemp,p_tipcol,p_numcad,
                    l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                    l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                    l_fairef OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);

      ELSE
          SP_FaiHor(p_numemp,p_tipcol,p_numcad,
                    l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                    l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                    l_fairef OUT, l_prmsabequal OUT, l_prmdomequal OUT, l_prmsegequal OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);
      END IF;
  END IF;
  LOOP
      /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
      SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
      IF (l_crapri = 0) THEN
          l_crapri := l_cracha;
      END IF;

      /* atualiza a tabela R070CON */
      BEGIN
          UPDATE R070CON SET
                 FAIAC1=l_faidom_a,FAIAC2=l_faiseg_a,FAIAC3=l_faiter_a,FAIAC4=l_faiqua_a,
                 FAIAC5=l_faiqui_a,FAIAC6=l_faisex_a,FAIAC7=l_faisab_a,
                 FAIPT1=l_faidom_p,FAIPT2=l_faiseg_p,FAIPT3=l_faiter_p,FAIPT4=l_faiqua_p,
                 FAIPT5=l_faiqui_p,FAIPT6=l_faisex_p,FAIPT7=l_faisab_p,
                 FAIREF=l_fairef
          WHERE NUMFIS = l_crapri;
      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;
      IF (l_crapro = l_cracha) OR (l_crapro = 0) THEN
        EXIT;
      ELSE
        l_cracha := l_crapro;
      END IF;
  END LOOP;
END␀í÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
{␀␀PROCEDURE SP_ATULNG(P_NUMCRA NUMBER(12),P_ORIINC NUMBER(1))
 IS

l_data_atual      DATE;
  l_existe          BOOLEAN;
  l_numcra          NUMBER(12);
BEGIN
  l_data_atual := CURDATE();
  l_existe := TRUE;
  BEGIN
    SELECT NUMCRA INTO l_numcra FROM R058LNG WHERE NUMCRA = p_numcra;
  EXCEPTION
     WHEN NO_DATA_FOUND THEN l_existe := FALSE;
     WHEN OTHERS THEN RAISERROR 103 'SP_AtuLng: Erro No SELECT R058LNG.';
  END;

  /* incluir na lista negra o titular */
  IF  (l_existe = FALSE) THEN
      INSERT INTO R058LNG (NUMCRA,ORIINC,DATINC,CODUSU)
      VALUES (p_numcra,p_oriinc,l_data_atual,0);
  END IF;
END␀î÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
