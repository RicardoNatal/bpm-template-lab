  NULL;
END		SENIOR;20c␀␀TRIGGER R090OAE_EI BEFORE INSERT ON R090OAE FOR EACH ROW
DECLARE
l_envNot       VARCHAR(1);
    l_data_atual   DATE;
    l_datatuADD    DATE;
    l_DatHorAtu    NUMBER(14,6);
    l_DataLimite   NUMBER(14,6);
    l_codnot       NUMBER(8);
    l_codusu       NUMBER(10);
    l_emaRes       VARCHAR2(50);
    l_desocp       VARCHAR2(99);
    l_nummat       VARCHAR2(15);
    l_tipocp       NUMBER(3);
    l_emaSGU       VARCHAR2(50);
    l_codplt       CHAR(5);
	l_datocp       CHAR(8);
	l_horocp       CHAR(4);
	l_seqocp       CHAR(2);
	l_seqenv       CHAR(2);
	l_idtpes       CHAR(23);
	l_valstr       VARCHAR2(45);    
    
    /* CURSOR para buscar os responsáveis */  
    CURSOR c_R073RES IS
      SELECT A.TIPDOC, A.NUMDOC, A.EMARES  
      FROM R073RES A, R073ARE B
      WHERE B.NUMMAT = l_nummat AND A.TIPDOC = B.TIPDOC AND A.NUMDOC = B.NUMDOC;
    TYPE t_r073Res IS RECORD(
      TIPDOC   R073RES.TIPDOC%TYPE,
      NUMDOC   R073RES.NUMDOC%TYPE,
      EMARES   R073RES.EMARES%TYPE);
    l_r073res t_r073res;  
    
BEGIN

    /* Inicializa variáveis */
	SP_DATETIME(l_DatHorAtu);
    l_data_atual := CURDATE();
    l_datAtuADD  := DATETIMEADD(DD,1,l_data_atual);
    SP_DATETONUMBER(l_datAtuADD,l_DataLimite);
    l_emares := '';
	l_nummat := :NEW.NUMMAT;
	
    /* Carrega dados da ocorrência*/
	l_tipocp := 0;
    l_desocp := '';
	l_envNot := 'N'; 	/* Verifica se tipo de ocorrência deve gerar notificação */    
	BEGIN    
	    SELECT  A.TIPOCP, B.DESOCP, B.ENVNOT INTO l_tipocp, l_desocp, l_envnot
			  FROM  R090OCP A, R090TOP B 
			  WHERE A.TIPOCP = B.TIPOCP AND
			        A.CODPLT = :NEW.CODPLT AND 
			        A.DATOCP = :NEW.DATOCP AND
			        A.HOROCP = :NEW.HOROCP AND
			        A.SEQOCP = :NEW.SEQOCP;			
	EXCEPTION
	    WHEN OTHERS THEN l_envNot := 'N';
	END;
    
    /* Envia notificação via PUSH */
    IF (l_envNot = 'S') THEN
    
        /* Pesquisa dados do responsável e se tem usuário no SGU */
        FOREACH c_r073RES INTO 
            l_r073res.TIPDOC,
            l_r073res.NUMDOC,
            l_r073res.emares
        LOOP 
            l_emares:= l_r073res.emares;
    
	        IF (l_emares IS NOT NULL) THEN
	        
	            l_codusu := 0;
		        BEGIN
		            SELECT CODUSU INTO l_codusu FROM R073USU WHERE TIPDOC = l_r073res.TIPDOC AND NUMDOC = l_r073res.NUMDOC;
		        EXCEPTION
			        WHEN OTHERS THEN l_codusu := 0;
			    END;
		      
		        IF (l_codusu > 0) THEN
		        
		            BEGIN
		                /* verifica se email do SGU esta igual ao email do cadastro do responsavel*/
		                SELECT EMAIL INTO l_emaSGU FROM R900CPL WHERE PERID = l_codusu;
		                
		                IF (l_emaSGU <> l_emares) THEN
		                    UPDATE R073RES SET EMARES = l_emaSGU WHERE EMARES = l_emares;
		                    l_emares := l_emaSGU; 
		                END IF;
			        EXCEPTION
				        WHEN OTHERS THEN RAISERROR 103 'R090OAE_EI: Erro ao obter email .';
		            END;
		        
					/* Envia notificação via PUSH */
			        BEGIN
				        /*ORACLE*/
			            l_codnot := SEQ_R115NOT.nextval;
			        EXCEPTION
				        WHEN OTHERS THEN RAISERROR 103 'R090OAE_EI: Erro ao gerar sequencial da notificação.';
				    END;
				    
			        BEGIN
				        INSERT INTO R115NOT (CODNOT, TIPNOT, STANOT, DTHNOT, DTHLIM, DTHENV, QTDENV, MSGERR, CODORI) 
				                     VALUES (l_codnot, 9, 0, l_DatHorAtu, l_Datalimite, 0, 0, '',0); 
				    EXCEPTION
				        WHEN OTHERS THEN RAISERROR 103 'R090OAE_EI: Erro ao gerar notificação R115NOT.';
				    END;
			    
			        BEGIN
				        INSERT INTO R115CNO (CodNot,CodSeq,NomCam,ValStr) VALUES  (l_codnot,SEQ_R115CNO.nextval,'EMARES',l_emares);
				        INSERT INTO R115CNO (CodNot,CodSeq,NomCam,ValStr) VALUES  (l_codnot,SEQ_R115CNO.nextval,'NUMMAT',l_nummat);				        
				        INSERT INTO R115CNO (CodNot,CodSeq,NomCam,ValStr) VALUES  (l_codnot,SEQ_R115CNO.nextval,'DESOCP',l_desOcp);			        
				        INSERT INTO R115CNO (CodNot,CodSeq,NomCam,ValStr) VALUES  (l_codnot,SEQ_R115CNO.nextval,'CODUSU',l_codusu);				        
				    EXCEPTION
				        WHEN OTHERS THEN RAISERROR 103 'R090OAE_EI: Erro ao gerar notificação R115CNO.';
				    END;
				END IF;
			END IF;
			
        END LOOP;
    END IF; /* l_envnot = 'S'*/
    
    /*Pendência para o SAMSenior */
    SP_INTSTR(:NEW.CODPLT, '99999', l_codplt OUT);
	SP_DATSTR(:NEW.DATOCP, 'DDMMYYYY', l_datocp OUT);
	SP_INTSTR(:NEW.HOROCP, '9999', l_horocp OUT);
	SP_INTSTR(:NEW.SEQOCP, '99', l_seqocp OUT);
	SP_INTSTR(:NEW.SEQENV, '99', l_seqenv OUT);
	SP_RETIDTPES(0, 6, 0, 0, '', :NEW.NUMMAT, '', l_idtpes OUT);
	    
	l_valstr := 'A' || l_codplt || l_datocp || l_horocp || l_seqocp || l_seqenv || l_idtpes;
	   
	SP_SAM_PENDENCIES(5, 1, l_valstr);
END		SENIOR;22c␀␀TRIGGER R090OAE_EI BEFORE INSERT ON R090OAE FOR EACH ROW
DECLARE
l_envNot       VARCHAR(1);
    l_data_atual   DATE;
    l_datatuADD    DATE;
    l_DatHorAtu    NUMBER(14,6);
    l_DataLimite   NUMBER(14,6);
    l_codnot       NUMBER(8);
    l_codusu       NUMBER(10);
    l_emaRes       VARCHAR2(50);
    l_desocp       VARCHAR2(99);
    l_nummat       VARCHAR2(15);
    l_tipocp       NUMBER(3);
    l_emaSGU       VARCHAR2(50);
    l_codplt       CHAR(5);
	l_datocp       CHAR(8);
	l_horocp       CHAR(4);
	l_seqocp       CHAR(2);
	l_seqenv       CHAR(2);
	l_idtpes       CHAR(23);
	l_valstr       VARCHAR2(45);    
    
    /* CURSOR para buscar os responsáveis */  
    CURSOR c_R073RES IS
      SELECT A.TIPDOC, A.NUMDOC, A.EMARES  
      FROM R073RES A, R073ARE B
      WHERE B.NUMMAT = l_nummat AND A.TIPDOC = B.TIPDOC AND A.NUMDOC = B.NUMDOC;
    TYPE t_r073Res IS RECORD(
      TIPDOC   R073RES.TIPDOC%TYPE,
      NUMDOC   R073RES.NUMDOC%TYPE,
      EMARES   R073RES.EMARES%TYPE);
    l_r073res t_r073res;  
    
BEGIN

    /* Inicializa variáveis */
	SP_DATETIME(l_DatHorAtu);
    l_data_atual := CURDATE();
    l_datAtuADD  := DATETIMEADD(DD,1,l_data_atual);
    SP_DATETONUMBER(l_datAtuADD,l_DataLimite);
    l_emares := '';
	l_nummat := :NEW.NUMMAT;
	
    /* Carrega dados da ocorrência*/
	l_tipocp := 0;
    l_desocp := '';
	l_envNot := 'N'; 	/* Verifica se tipo de ocorrência deve gerar notificação */    
	BEGIN    
	    SELECT  A.TIPOCP, B.DESOCP, B.ENVNOT INTO l_tipocp, l_desocp, l_envnot
			  FROM  R090OCP A, R090TOP B 
			  WHERE A.TIPOCP = B.TIPOCP AND
			        A.CODPLT = :NEW.CODPLT AND 
			        A.DATOCP = :NEW.DATOCP AND
			        A.HOROCP = :NEW.HOROCP AND
			        A.SEQOCP = :NEW.SEQOCP;			
	EXCEPTION
	    WHEN OTHERS THEN l_envNot := 'N';
	END;
    
    /* Envia notificação via PUSH */
    IF (l_envNot = 'S') THEN
    
        /* Pesquisa dados do responsável e se tem usuário no SGU */
        FOREACH c_r073RES INTO 
            l_r073res.TIPDOC,
            l_r073res.NUMDOC,
            l_r073res.emares
        LOOP 
            l_emares:= l_r073res.emares;
    
	        IF (l_emares IS NOT NULL) THEN
	        
	            l_codusu := 0;
		        BEGIN
		            SELECT CODUSU INTO l_codusu FROM R073USU WHERE TIPDOC = l_r073res.TIPDOC AND NUMDOC = l_r073res.NUMDOC;
		        EXCEPTION
			        WHEN OTHERS THEN l_codusu := 0;
			    END;
		      
		        IF (l_codusu > 0) THEN
		        
		            BEGIN
		                /* verifica se email do SGU esta igual ao email do cadastro do responsavel*/
		                SELECT EMAIL INTO l_emaSGU FROM R900CPL WHERE PERID = l_codusu;
		                
		                IF (l_emaSGU <> l_emares) THEN
		                    UPDATE R073RES SET EMARES = l_emaSGU WHERE EMARES = l_emares;
		                    l_emares := l_emaSGU; 
		                END IF;
			        EXCEPTION
				        WHEN OTHERS THEN RAISERROR 103 'R090OAE_EI: Erro ao obter email .';
		            END;
		        
					/* Envia notificação via PUSH */
			        BEGIN
				        /*ORACLE*/
			            l_codnot := SEQ_R115NOT.nextval;
			        EXCEPTION
				        WHEN OTHERS THEN RAISERROR 103 'R090OAE_EI: Erro ao gerar sequencial da notificação.';
				    END;
				    
			        BEGIN
				        INSERT INTO R115NOT (CODNOT, TIPNOT, STANOT, DTHNOT, DTHLIM, DTHENV, QTDENV, MSGERR, CODORI) 
				                     VALUES (l_codnot, 9, 0, l_DatHorAtu, l_Datalimite, 0, 0, '',0); 
				    EXCEPTION
				        WHEN OTHERS THEN RAISERROR 103 'R090OAE_EI: Erro ao gerar notificação R115NOT.';
				    END;
			    
			        BEGIN
				        INSERT INTO R115CNO (CodNot,CodSeq,NomCam,ValStr) VALUES  (l_codnot,SEQ_R115CNO.nextval,'EMARES',l_emares);
				        INSERT INTO R115CNO (CodNot,CodSeq,NomCam,ValStr) VALUES  (l_codnot,SEQ_R115CNO.nextval,'NUMMAT',l_nummat);				        
				        INSERT INTO R115CNO (CodNot,CodSeq,NomCam,ValStr) VALUES  (l_codnot,SEQ_R115CNO.nextval,'DESOCP',l_desOcp);			        
				        INSERT INTO R115CNO (CodNot,CodSeq,NomCam,ValStr) VALUES  (l_codnot,SEQ_R115CNO.nextval,'CODUSU',l_codusu);				        
				    EXCEPTION
				        WHEN OTHERS THEN RAISERROR 103 'R090OAE_EI: Erro ao gerar notificação R115CNO.';
				    END;
				END IF;
			END IF;
			
        END LOOP;
    END IF; /* l_envnot = 'S'*/
    
    /*Pendência para o SAMSenior */
    SP_INTSTR(:NEW.CODPLT, '99999', l_codplt OUT);
	SP_DATSTR(:NEW.DATOCP, 'DDMMYYYY', l_datocp OUT);
	SP_INTSTR(:NEW.HOROCP, '9999', l_horocp OUT);
	SP_INTSTR(:NEW.SEQOCP, '99', l_seqocp OUT);
	SP_INTSTR(:NEW.SEQENV, '99', l_seqenv OUT);
	SP_RETIDTPES(0, 6, 0, 0, '', :NEW.NUMMAT, '', l_idtpes OUT);
	    
	l_valstr := 'A' || l_codplt || l_datocp || l_horocp || l_seqocp || l_seqenv || l_idtpes;
	   
	SP_SAM_PENDENCIES(5, 1, l_valstr);
END		SENIOR;21Ç␀␀TRIGGER R090OAE_EI BEFORE INSERT ON R090OAE FOR EACH ROW
