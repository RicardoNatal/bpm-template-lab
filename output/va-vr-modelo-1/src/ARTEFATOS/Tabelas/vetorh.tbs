GGER R000RES_EI BEFORE INSERT ON R000RES FOR EACH ROW	

DECLARE
l_Valor      VARCHAR2(2000);
l_InfoFacult BOOLEAN;
l_SimplificaoESocial BOOLEAN;
l_VersaoESocial NUMBER;
BEGIN
  l_Valor := '';
  l_InfoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;
  
  /*e-Social -> S-1000 */
  IF (:NEW.DOCLEG = 10 AND :NEW.NUMEMP = 0) THEN
  	SP_CONCATENAR_NUM('DOCLEG', :NEW.DOCLEG, l_Valor OUT);
	SP_RESP_ESOCIAL('I', l_Valor);
  END IF;
	  
  /*e-Social -> S-1000 */
  IF(:NEW.DOCLEG = 10 AND :NEW.NUMEMP > 0) THEN
  	SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  	
  	/* Só monitora a tabela se o cliente opta por enviar as informações facultativas e Não está em um momento de simplificação eSocial*/
  	IF (l_InfoFacult = TRUE AND l_SimplificaoESocial = FALSE) THEN	
	  SP_CONCATENAR_NUM('DOCLEG', :NEW.DOCLEG, l_Valor OUT);
	  SP_E_SOCIAL('S-1000', 'R000RES', 'T', 'I', NULL, NULL, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R000RES_EI');
	END IF;
  END IF;
  /*e-Social -> S-1000 */
END␀&Î␀␀		SENIOR;0­␀␀

TRIGGER R000RES_EU BEFORE UPDATE ON R000RES FOR EACH ROW

DECLARE
l_Valor      VARCHAR2(2000);
l_InfoFacult BOOLEAN;
l_SimplificaoESocial BOOLEAN;
l_VersaoESocial NUMBER;
BEGIN
  l_Valor := '';
  l_InfoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;   
     
  /*e-Social -> S-1000 */
  IF (:NEW.DOCLEG = 10 AND :NEW.NUMEMP = 0) THEN
	/* Quando a Empresa é zero, deve criar pendência para todas as empresas que não tem responsável legal específico */
	SP_CONCATENAR_NUM('DOCLEG', :NEW.DOCLEG, l_Valor OUT);
	SP_RESP_ESOCIAL('A', l_Valor);
  END IF;
    
  IF(:NEW.DOCLEG = 10 AND :NEW.NUMEMP > 0) THEN
  	SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  	
  	/* Só monitora a tabela se o cliente opta por enviar as informações facultativas e Não está em um momento de simplificação eSocial*/
  	IF (l_InfoFacult = TRUE AND l_SimplificaoESocial = FALSE) THEN	
	  SP_CONCATENAR_NUM('DOCLEG', :NEW.DOCLEG, l_Valor OUT);
	  SP_E_SOCIAL('S-1000', 'R000RES', 'T', 'A', NULL, NULL, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R000RES_EU');
	END IF;
  END IF;  
  /*e-Social -> S-1000 */
END␀$Î␀␀		SENIOR;0¿␀␀

TRIGGER R000RES_ED BEFORE DELETE ON R000RES FOR EACH ROW

DECLARE
l_Valor      VARCHAR2(2000);
l_InfoFacult BOOLEAN;
l_SimplificaoESocial BOOLEAN;
l_VersaoESocial NUMBER;
BEGIN
  l_Valor := '';
  l_InfoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;
  
  /*e-Social -> S-1000 */
  IF (:OLD.DOCLEG = 10 AND :OLD.NUMEMP = 0) THEN
  	/* Quando a Empresa é zero, deve criar pendência para todas as empresas que não tem responsável legal específico */
	SP_CONCATENAR_NUM('DOCLEG', :OLD.DOCLEG, l_Valor OUT);
	SP_RESP_ESOCIAL('E', l_Valor);
  END IF;
  
  /*e-Social -> S-1000 */
  IF(:OLD.DOCLEG = 10 AND :OLD.NUMEMP > 0) THEN
	SP_ESOCIAL_INFO(:OLD.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  	
  	/* Só monitora a tabela se o cliente opta por enviar as informações facultativas e Não está em um momento de simplificação eSocial*/
  	IF (l_InfoFacult = TRUE AND l_SimplificaoESocial = FALSE) THEN	
	  SP_CONCATENAR_NUM('DOCLEG', :OLD.DOCLEG, l_Valor OUT);
	  SP_E_SOCIAL('S-1000', 'R000RES', 'T', 'E', NULL, NULL, :OLD.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R000RES_ED');
	END IF;
