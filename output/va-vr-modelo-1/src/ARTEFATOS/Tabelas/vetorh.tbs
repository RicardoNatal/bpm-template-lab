PROCEDURE SP_PEND87(P_TIPOPE NUMBER(1),P_CODPOR NUMBER(3),P_DESPOR CHAR(20),P_PERAGV CHAR(1),P_SELPOR CHAR(1),P_VISLMA CHAR(1),P_QTDVIS NUMBER(2),P_HORVIS NUMBER(4),P_UTIWAV CHAR(1),P_UTIVEI CHAR(1),P_OBRFMV CHAR(1),P_MODBIO CHAR(1),P_LEIDOC CHAR(1),P_LEIAUT CHAR(1),P_FOTPES CHAR(1),P_PERBCR CHAR(1),P_AGEAUT CHAR(1), P_PERSAC CHAR(1), P_TIPPNG NUMBER(3), P_DOCOBR CHAR(1), P_VERPLF NUMBER(3), P_CODPLF NUMBER(7))
 IS
BEGIN
  NULL;
END		SENIOR;200SP_DATSTR
SP_INTSTR
SP_SIMNAO_INT
SP_PORCOM
Â␀␀

PROCEDURE SP_PEND87(P_TIPOPE NUMBER(1),P_CODPOR NUMBER(3),P_DESPOR CHAR(20),P_PERAGV CHAR(1),P_SELPOR CHAR(1),P_VISLMA CHAR(1),P_QTDVIS NUMBER(2),P_HORVIS NUMBER(4),P_UTIWAV CHAR(1),P_UTIVEI CHAR(1),P_OBRFMV CHAR(1),P_MODBIO CHAR(1),P_LEIDOC CHAR(1),P_LEIAUT CHAR(1),P_FOTPES CHAR(1),P_PERBCR CHAR(1),P_AGEAUT CHAR(1), P_PERSAC CHAR(1), P_TIPPNG NUMBER(3), P_DOCOBR CHAR(1), P_VERPLF NUMBER(3), P_CODPLF NUMBER(7))
 IS

  l_valstr     VARCHAR2(2047);
  l_tipOpe     CHAR(1);
  l_datatu     DATE;
  l_horatu     NUMBER(4);
  l_seqenv     NUMBER(2);
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datenv     CHAR(16);
  l_seqstr     CHAR(2);  
  l_codporStr  CHAR(3);
  l_tamDesPor  NUMBER(3);
  l_desPor     VARCHAR(20);
  l_TamDesPorStr CHAR(2);
  l_QtdVisStr  CHAR(2);
  l_horvisStr  CHAR(4);
  l_TipPNGStr  CHAR(3);  
  l_PerAgv     CHAR(1);
  l_SelPor     CHAR(1);
  l_VisLma     CHAR(1);  
  l_UtiWav     CHAR(1);
  l_LeiAut     CHAR(1);
  l_FotPes     CHAR(1);
  l_PerBcr     CHAR(1);
  l_UtiCid     CHAR(1);
  l_UtilOE     CHAR(1);
  l_UtiCPF     CHAR(1);
  l_UtiCNH     CHAR(1);
  l_UtiPas     CHAR(1);
  l_UtiOut     CHAR(1);
  l_UtiSDO     CHAR(1);
  l_AgeAut     CHAR(1);
  l_PerSAc     CHAR(1);
  l_UtiREs     CHAR(1);
  l_docobr	   CHAR(1);
  l_TipVis     NUMBER(3);
  l_TipVisStr  VARCHAR(3);
  l_CodPrm     NUMBER(5);
  l_CodPrmStr  CHAR(5);
  l_qtd        NUMBER(5);
  l_qtdStr     VARCHAR(5);
  l_aux        VARCHAR(120);
  l_verplf     VARCHAR(3);
  l_codplf     VARCHAR(7);

  /* CURSOR c/ os registros da tabela R090ATV */
  CURSOR c_r090atv IS SELECT TipVis FROM R090ATV WHERE CODPOR = p_CodPor;
  
  /* CURSOR c/ os registros da tabela R090ACP */
  CURSOR c_r090acp IS SELECT CodPrm FROM R090ACP WHERE CODPOR = p_CodPor;
  
BEGIN
  /* Calcula  data/hora de envio da pendência.*/
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

  SP_INTSTR(p_tipOpe, '9', l_tipOpe OUT);
  SP_INTSTR(p_CodPor, '999', l_codporStr OUT);
  
  IF p_TipPNG IS NULL THEN
    SP_INTSTR(0, '999', l_tipPNGStr OUT);
  ELSE
    SP_INTSTR(p_TipPNG, '999', l_tipPNGStr OUT);
  END IF;

  l_desPor := RTrim(LTrim(p_DesPor));
  l_TamDesPor := LENGTH(l_desPor);
  SP_INTSTR(l_TamDesPor, '99', l_TamDesPorStr OUT);

  SP_INTSTR(p_QtdVis, '99', l_QtdVisStr OUT);
  SP_INTSTR(p_horvis,'9999',l_horvisStr OUT);
  
  l_UtiCid := 'S';
  l_UtilOE := 'S';
  l_UtiCPF := 'S';
  l_UtiCNH := 'S';
  l_UtiPas := 'S';
  l_UtiOut := 'S';
  l_UtiSDO := 'S';
  l_PerSAc := 'S';
  l_UtiREs := 'S';
  BEGIN
      SELECT UtiCid, UtilOE, UtiCPF, UtiCNH, UtiPas, UtiOut, UtiSDO, UtiREs
      INTO l_UtiCid, l_UtilOE, l_UtiCPF, l_UtiCNH, l_UtiPas, l_UtiOut, l_UtiSDO, l_UtiREs
      FROM R090DPE WHERE CODPOR = p_CodPor;
  EXCEPTION
      WHEN OTHERS THEN
		  l_UtiCid := 'S';
		  l_UtilOE := 'S';
		  l_UtiCPF := 'S';
		  l_UtiCNH := 'S';
		  l_UtiPas := 'S';
		  l_UtiOut := 'S';
		  l_UtiSDO := 'S';
		  l_UtiREs := 'S';
  END;

  l_PerAgv := p_PerAgv;
  l_SelPor := p_SelPor;
  l_VisLma := p_VisLma;  
  l_UtiWav := p_UtiWav;
  l_LeiAut := p_LeiAut;
  l_FotPes := p_FotPes;
  l_PerBcr := p_PerBcr;
  l_AgeAut := p_AgeAut;
  l_PerSAc := P_PerSAc;

  SP_SIMNAO_INT(l_PerAgv IN OUT);
  SP_SIMNAO_INT(l_SelPor IN OUT);
  SP_SIMNAO_INT(l_VisLma IN OUT);
  SP_SIMNAO_INT(l_UtiCid IN OUT);
  SP_SIMNAO_INT(l_UtilOE IN OUT);
  SP_SIMNAO_INT(l_UtiCPF IN OUT);
  SP_SIMNAO_INT(l_UtiCNH IN OUT);
  SP_SIMNAO_INT(l_UtiPas IN OUT);
  SP_SIMNAO_INT(l_UtiOut IN OUT);
  SP_SIMNAO_INT(l_UtiSDO IN OUT);
  SP_SIMNAO_INT(l_UtiWav IN OUT);
  SP_SIMNAO_INT(l_LeiAut IN OUT);
  SP_SIMNAO_INT(l_FotPes IN OUT);
  SP_SIMNAO_INT(l_PerBcr IN OUT);
  SP_SIMNAO_INT(l_AgeAut IN OUT);
  SP_SIMNAO_INT(l_PerSAc IN OUT);
  SP_SIMNAO_INT(l_UtiREs IN OUT);
  
  l_valstr := '87' || l_datenv || l_tipOpe || l_codporStr || l_TamDesPorStr || l_desPor || l_PerAgv || l_SelPor ||
                      l_VisLma || l_QtdVisStr || l_horvisStr || l_UtiWav || p_UtiVei || p_ObrFmv || p_ModBio || p_LeiDoc ||l_AgeAut;
  l_valstr := l_valstr || l_UtiCid || l_UtilOE || l_UtiCPF || l_UtiCNH || l_UtiPas || l_UtiOut || l_UtiSDO || l_UtiREs;

  /* montando a lista de tipos de visita */
  l_qtd := 0;
  l_aux := '';
  FOREACH c_r090atv INTO l_TipVis
  LOOP
    SP_INTSTR(l_TipVis, '999', l_TipVisStr OUT);
    l_aux := l_aux || l_TipVisStr;  
    l_qtd := l_qtd + 1;
  END LOOP;
  SP_INTSTR(l_qtd, '999', l_qtdStr OUT);
  l_valstr := l_valstr || l_qtdStr || l_aux;

  /* montando a lista de permissões */
  l_qtd := 0;
  l_aux := '';
  FOREACH c_r090acp INTO l_CodPrm
  LOOP
    SP_INTSTR(l_CodPrm, '99999', l_CodPrmStr OUT);
    l_aux := l_aux || l_CodPrmStr;  
    l_qtd := l_qtd + 1;
  END LOOP;
  SP_INTSTR(l_qtd, '99999', l_qtdStr OUT);
  l_valstr := l_valstr || l_qtdStr || l_aux;

  /* Realiza Leitura Automática */
  l_valstr := l_valstr || l_LeiAut;
  
  /* Apresentar foto da pessoa em campos de busca */
  l_valstr := l_valstr || l_FotPes;

  /* Permite Baixar Crachá na Entrada da Visita */
  l_valstr := l_valstr || l_PerBcr;

  /* Permite Saída Acompanhante sem Visitante */
  l_valstr := l_valstr || l_PerSAc;
  
  /* Tipo de incidente para Pessoas Não Gratas */
  l_valstr := l_valstr || l_tipPNGStr;
  
  /* Tipo de documento Obrigatório */
  IF p_docobr IS NULL THEN
    SP_INTSTR(0, '9', l_docobr OUT);
  ELSE
    SP_INTSTR(p_docobr, '9', l_docobr OUT);
  END IF;  
  l_valstr := l_valstr || l_docobr;
  
  /* Versão do plano de localização física */
  IF (P_VERPLF IS NULL) THEN
    l_verplf := '000';
  ELSE
    SP_INTSTR(P_VERPLF, '999', l_verplf OUT);
  END IF;  
  l_valstr := l_valstr || l_verplf;
  
  /* Código do local físico */
  IF (P_CODPLF IS NULL) THEN
    l_codplf := '0000000';
  ELSE
    SP_INTSTR(P_CODPLF, '9999999', l_codplf OUT);
  END IF;
  l_valstr := l_valstr || l_codplf;

  BEGIN
    SP_PORCOM(l_valstr, '0');
  EXCEPTION
    WHEN OTHERS THEN RAISERROR 103 'SP_PEND87: Erro ao gerar pendência 87.';
  END;
END		SENIOR;210SP_DATSTR
SP_INTSTR
SP_SIMNAO_INT
SP_PORCOM
Â␀␀

PROCEDURE SP_PEND87(P_TIPOPE NUMBER(1),P_CODPOR NUMBER(3),P_DESPOR CHAR(20),P_PERAGV CHAR(1),P_SELPOR CHAR(1),P_VISLMA CHAR(1),P_QTDVIS NUMBER(2),P_HORVIS NUMBER(4),P_UTIWAV CHAR(1),P_UTIVEI CHAR(1),P_OBRFMV CHAR(1),P_MODBIO CHAR(1),P_LEIDOC CHAR(1),P_LEIAUT CHAR(1),P_FOTPES CHAR(1),P_PERBCR CHAR(1),P_AGEAUT CHAR(1), P_PERSAC CHAR(1), P_TIPPNG NUMBER(3), P_DOCOBR CHAR(1), P_VERPLF NUMBER(3), P_CODPLF NUMBER(7))
 IS

  l_valstr     VARCHAR2(2047);
  l_tipOpe     CHAR(1);
  l_datatu     DATE;
  l_horatu     NUMBER(4);
  l_seqenv     NUMBER(2);
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datenv     CHAR(16);
  l_seqstr     CHAR(2);  
  l_codporStr  CHAR(3);
  l_tamDesPor  NUMBER(3);
  l_desPor     VARCHAR(20);
  l_TamDesPorStr CHAR(2);
  l_QtdVisStr  CHAR(2);
  l_horvisStr  CHAR(4);
  l_TipPNGStr  CHAR(3);  
  l_PerAgv     CHAR(1);
  l_SelPor     CHAR(1);
  l_VisLma     CHAR(1);  
  l_UtiWav     CHAR(1);
  l_LeiAut     CHAR(1);
  l_FotPes     CHAR(1);
  l_PerBcr     CHAR(1);
  l_UtiCid     CHAR(1);
  l_UtilOE     CHAR(1);
  l_UtiCPF     CHAR(1);
  l_UtiCNH     CHAR(1);
  l_UtiPas     CHAR(1);
  l_UtiOut     CHAR(1);
  l_UtiSDO     CHAR(1);
  l_AgeAut     CHAR(1);
  l_PerSAc     CHAR(1);
  l_UtiREs     CHAR(1);
  l_docobr	   CHAR(1);
  l_TipVis     NUMBER(3);
  l_TipVisStr  VARCHAR(3);
  l_CodPrm     NUMBER(5);
  l_CodPrmStr  CHAR(5);
  l_qtd        NUMBER(5);
  l_qtdStr     VARCHAR(5);
  l_aux        VARCHAR(120);
  l_verplf     VARCHAR(3);
  l_codplf     VARCHAR(7);

  /* CURSOR c/ os registros da tabela R090ATV */
  CURSOR c_r090atv IS SELECT TipVis FROM R090ATV WHERE CODPOR = p_CodPor;
  
  /* CURSOR c/ os registros da tabela R090ACP */
  CURSOR c_r090acp IS SELECT CodPrm FROM R090ACP WHERE CODPOR = p_CodPor;
  
BEGIN
  /* Calcula  data/hora de envio da pendência.*/
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

  SP_INTSTR(p_tipOpe, '9', l_tipOpe OUT);
  SP_INTSTR(p_CodPor, '999', l_codporStr OUT);
  
  IF p_TipPNG IS NULL THEN
    SP_INTSTR(0, '999', l_tipPNGStr OUT);
  ELSE
    SP_INTSTR(p_TipPNG, '999', l_tipPNGStr OUT);
  END IF;

  l_desPor := RTrim(LTrim(p_DesPor));
  l_TamDesPor := LENGTH(l_desPor);
  SP_INTSTR(l_TamDesPor, '99', l_TamDesPorStr OUT);

  SP_INTSTR(p_QtdVis, '99', l_QtdVisStr OUT);
  SP_INTSTR(p_horvis,'9999',l_horvisStr OUT);
  
  l_UtiCid := 'S';
  l_UtilOE := 'S';
  l_UtiCPF := 'S';
  l_UtiCNH := 'S';
  l_UtiPas := 'S';
  l_UtiOut := 'S';
  l_UtiSDO := 'S';
  l_PerSAc := 'S';
  l_UtiREs := 'S';
  BEGIN
      SELECT UtiCid, UtilOE, UtiCPF, UtiCNH, UtiPas, UtiOut, UtiSDO, UtiREs
      INTO l_UtiCid, l_UtilOE, l_UtiCPF, l_UtiCNH, l_UtiPas, l_UtiOut, l_UtiSDO, l_UtiREs
      FROM R090DPE WHERE CODPOR = p_CodPor;
  EXCEPTION
      WHEN OTHERS THEN
		  l_UtiCid := 'S';
		  l_UtilOE := 'S';
		  l_UtiCPF := 'S';
		  l_UtiCNH := 'S';
		  l_UtiPas := 'S';
		  l_UtiOut := 'S';
		  l_UtiSDO := 'S';
		  l_UtiREs := 'S';
  END;

  l_PerAgv := p_PerAgv;
  l_SelPor := p_SelPor;
  l_VisLma := p_VisLma;  
  l_UtiWav := p_UtiWav;
  l_LeiAut := p_LeiAut;
  l_FotPes := p_FotPes;
  l_PerBcr := p_PerBcr;
  l_AgeAut := p_AgeAut;
  l_PerSAc := P_PerSAc;

  SP_SIMNAO_INT(l_PerAgv IN OUT);
  SP_SIMNAO_INT(l_SelPor IN OUT);
  SP_SIMNAO_INT(l_VisLma IN OUT);
  SP_SIMNAO_INT(l_UtiCid IN OUT);
  SP_SIMNAO_INT(l_UtilOE IN OUT);
  SP_SIMNAO_INT(l_UtiCPF IN OUT);
  SP_SIMNAO_INT(l_UtiCNH IN OUT);
  SP_SIMNAO_INT(l_UtiPas IN OUT);
  SP_SIMNAO_INT(l_UtiOut IN OUT);
  SP_SIMNAO_INT(l_UtiSDO IN OUT);
  SP_SIMNAO_INT(l_UtiWav IN OUT);
  SP_SIMNAO_INT(l_LeiAut IN OUT);
  SP_SIMNAO_INT(l_FotPes IN OUT);
  SP_SIMNAO_INT(l_PerBcr IN OUT);
  SP_SIMNAO_INT(l_AgeAut IN OUT);
  SP_SIMNAO_INT(l_PerSAc IN OUT);
  SP_SIMNAO_INT(l_UtiREs IN OUT);
  
  l_valstr := '87' || l_datenv || l_tipOpe || l_codporStr || l_TamDesPorStr || l_desPor || l_PerAgv || l_SelPor ||
                      l_VisLma || l_QtdVisStr || l_horvisStr || l_UtiWav || p_UtiVei || p_ObrFmv || p_ModBio || p_LeiDoc ||l_AgeAut;
  l_valstr := l_valstr || l_UtiCid || l_UtilOE || l_UtiCPF || l_UtiCNH || l_UtiPas || l_UtiOut || l_UtiSDO || l_UtiREs;

  /* montando a lista de tipos de visita */
  l_qtd := 0;
  l_aux := '';
  FOREACH c_r090atv INTO l_TipVis
  LOOP
    SP_INTSTR(l_TipVis, '999', l_TipVisStr OUT);
    l_aux := l_aux || l_TipVisStr;  
    l_qtd := l_qtd + 1;
  END LOOP;
  SP_INTSTR(l_qtd, '999', l_qtdStr OUT);
  l_valstr := l_valstr || l_qtdStr || l_aux;

  /* montando a lista de permissões */
  l_qtd := 0;
  l_aux := '';
  FOREACH c_r090acp INTO l_CodPrm
  LOOP
    SP_INTSTR(l_CodPrm, '99999', l_CodPrmStr OUT);
    l_aux := l_aux || l_CodPrmStr;  
    l_qtd := l_qtd + 1;
  END LOOP;
  SP_INTSTR(l_qtd, '99999', l_qtdStr OUT);
  l_valstr := l_valstr || l_qtdStr || l_aux;

  /* Realiza Leitura Automática */
  l_valstr := l_valstr || l_LeiAut;
  
  /* Apresentar foto da pessoa em campos de busca */
  l_valstr := l_valstr || l_FotPes;

  /* Permite Baixar Crachá na Entrada da Visita */
  l_valstr := l_valstr || l_PerBcr;

  /* Permite Saída Acompanhante sem Visitante */
  l_valstr := l_valstr || l_PerSAc;
  
  /* Tipo de incidente para Pessoas Não Gratas */
  l_valstr := l_valstr || l_tipPNGStr;
  
  /* Tipo de documento Obrigatório */
  IF p_docobr IS NULL THEN
    SP_INTSTR(0, '9', l_docobr OUT);
  ELSE
    SP_INTSTR(p_docobr, '9', l_docobr OUT);
  END IF;  
  l_valstr := l_valstr || l_docobr;
  
  /* Versão do plano de localização física */
  IF (P_VERPLF IS NULL) THEN
    l_verplf := '000';
  ELSE
    SP_INTSTR(P_VERPLF, '999', l_verplf OUT);
  END IF;  
  l_valstr := l_valstr || l_verplf;
  
  /* Código do local físico */
  IF (P_CODPLF IS NULL) THEN
    l_codplf := '0000000';
  ELSE
    SP_INTSTR(P_CODPLF, '9999999', l_codplf OUT);
  END IF;
  l_valstr := l_valstr || l_codplf;

  BEGIN
    SP_PORCOM(l_valstr, '0');
  EXCEPTION
    WHEN OTHERS THEN RAISERROR 103 'SP_PEND87: Erro ao gerar pendência 87.';
  END;
END		SENIOR;220SP_DATSTR
SP_INTSTR
SP_SIMNAO_INT
SP_PORCOM
