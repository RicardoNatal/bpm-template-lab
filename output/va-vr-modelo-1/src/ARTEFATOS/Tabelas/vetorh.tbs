TRIGGER R108RES_AU AFTER UPDATE ON R108RES FOR EACH ROW
DECLARE
	l_TipAtn NUMBER(1);
	l_AtnFic NUMBER(1);
	l_TipCol NUMBER(1);
	l_NumCad NUMBER(9);
	l_CodDep NUMBER(2);
	l_NumCan NUMBER(7);
	l_Valido BOOLEAN;
	l_Alterou BOOLEAN;
	l_JsonCamposAlterados VARCHAR2(2000);
	l_ExameVinculado BOOLEAN;
	l_DatAte DATE;
	l_Valor VARCHAR2(2000);
	l_DataASO DATE;
	l_EnvEso VARCHAR2(1);
	l_temAud BOOLEAN;
    l_codRPA NUMBER(15);
    l_codSistema NUMBER(2);
    l_codcpa NUMBER(4);
    l_codtpa NUMBER(4);
    l_datTemp VARCHAR(10);
BEGIN
	/* eSocial S-2220 - Início */
	l_Alterou := FALSE;
	l_ExameVinculado := FALSE;
	
	RH_RETENVESO(:NEW.NumEmp, :NEW.AteAso, :NEW.NumAte, l_EnvEso OUT);
	IF (l_EnvEso = 'S') THEN
		/* Verifica se o exame está ou estava vinculado em algum ASO */
		IF ((:OLD.AteAso > 0 AND :OLD.NumAte > 0) OR (:NEW.AteAso > 0 AND :NEW.NumAte > 0)) THEN
			RH_RETATNFICMED(:NEW.NumEmp, :NEW.CodFic, :NEW.DatSol, l_TipAtn OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
			RH_RETFICMED(:NEW.NumEmp, :NEW.CodFic, l_AtnFic OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
			IF (l_TipAtn = 1) OR (l_AtnFic = 1) THEN /* 1 - Colaborador */
	    		l_Valor := '';
	    		l_JsonCamposAlterados := '';
	    	
	    		SP_VALUPDATE_DES(:OLD.SitExa, :NEW.SitExa, l_Valido OUT);
	    		IF (l_Valido = TRUE) THEN
	    			l_Alterou := TRUE;
	    			SP_CONCAT_DES_JSON('SITEXA', :NEW.SitExa, :OLD.SitExa, l_JsonCamposAlterados OUT);
	    		END IF;
	        
	    		IF (:NEW.SitExa = 'R') THEN /* 'R' = Realizado */
        			SP_VALUPDATE_DAT(:OLD.DatRes, :NEW.DatRes, l_Valido OUT);
        			IF (l_Valido = TRUE) THEN
     					l_Alterou := TRUE;
     					SP_CONCAT_DAT_JSON('DATRES', :NEW.DatRes, :OLD.DatRes, l_JsonCamposAlterados OUT);
        			END IF;
        		
        			SP_VALUPDATE_DES(:OLD.TipExa, :NEW.TipExa, l_Valido OUT);
        			IF (l_Valido = TRUE) THEN
	        			l_Alterou := TRUE;
    	    			SP_CONCAT_DES_JSON('TIPEXA', :NEW.TipExa, :OLD.TipExa, l_JsonCamposAlterados OUT);
    				END IF;  
        
        			SP_VALUPDATE_DES(:OLD.NorAlt, :NEW.NorAlt, l_Valido OUT);
        			IF (l_Valido = TRUE) THEN
	        			l_Alterou := TRUE;
    	    			SP_CONCAT_DES_JSON('NORALT', :NEW.NorAlt, :OLD.NorAlt, l_JsonCamposAlterados OUT);
        			END IF;
        
        			SP_VALUPDATE_DES(:OLD.EvoRes, :NEW.EvoRes, l_Valido OUT);
        			IF (l_Valido = TRUE) THEN
          				l_Alterou := TRUE;
          				SP_CONCAT_DES_JSON('EVORES', :NEW.EvoRes, :OLD.EvoRes, l_JsonCamposAlterados OUT);
        			END IF;
        
	        		SP_VALUPDATE_NUM(:OLD.AteAso, :NEW.AteAso, l_Valido OUT);
    	    		IF (l_Valido = TRUE) THEN
        	  			l_Alterou := TRUE;
          				SP_CONCAT_NUM_JSON('ATEASO', :NEW.AteAso, :OLD.AteAso, l_JsonCamposAlterados OUT);
	        		END IF;
        
    	    		SP_VALUPDATE_NUM(:OLD.NumAte, :NEW.NumAte, l_Valido OUT);
        			IF (l_Valido = TRUE) THEN
          				l_Alterou := TRUE;
          				SP_CONCAT_NUM_JSON('NUMATE', :NEW.NumAte, :OLD.NumAte, l_JsonCamposAlterados OUT);
        			END IF;
	    		END IF;
	    	
	    		IF (l_Alterou = TRUE) THEN
		    		/* Busca a data do ASO no qual o exame está ou estava vinculado */
		    		IF ((:NEW.AteAso > 0) AND (:NEW.NumAte > 0)) THEN
	    				RH_RETDATATE(:NEW.NumEmp, :NEW.AteAso, :NEW.NumAte, l_DataASO OUT);
	    				SP_CONCATENAR_NUM('CODATE', :NEW.AteAso, l_Valor OUT);
	    				SP_CONCATENAR_NUM('NUMATE', :NEW.NumAte, l_Valor OUT);
	    			ELSE
						/* Exame foi desvinculado do ASO, então considera as informações antigas dos campos AteAso e NumAte */
						RH_RETDATATE(:NEW.NumEmp, :OLD.AteAso, :OLD.NumAte, l_DataASO OUT);
						SP_CONCATENAR_NUM('CODATE', :OLD.AteAso, l_Valor OUT);
						SP_CONCATENAR_NUM('NUMATE', :OLD.NumAte, l_Valor OUT);
	        		END IF;
        		
    	    		SP_CONCATENAR_DAT('DATASO', l_DataASO, l_Valor OUT);
        		
        			SP_E_SOCIAL_SM('S-2220', 'R108RES', 'N', 'A', NULL, NULL, :NEW.NumEmp, l_TipCol, l_NumCad, l_Valor, l_JsonCamposAlterados, 0, NULL, l_DataASO, 0, 'R108RES_AU');
	  			END IF;
	  		END IF;
	  	END IF;
	END IF;  
  	/* eSocial S-2220 - Fim */
  	
