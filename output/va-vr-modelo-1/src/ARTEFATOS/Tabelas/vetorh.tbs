DECLARE
l_EmpresaStr VARCHAR(11);
  l_HorarioEsocialStr VARCHAR(19);
  l_Where VARCHAR(2000);
  l_ProximaData DATE;
  l_Valor VARCHAR2(2000);
BEGIN
  l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP);
  l_HorarioEsocialStr := CONVERT(NUMBER_TO_CHAR, :NEW.IDEINT);

  l_Where := 'NUMEMP = ' ||  l_EmpresaStr || ' AND IDEINT = ' || l_HorarioEsocialStr || '';
  SP_PROXIMOHIST('CMPHOR', 'R004ESO', l_Where, :NEW.CMPHOR, l_ProximaData OUT);
  SP_CONCATENAR_NUM('IDEINT', :NEW.IDEINT, l_Valor OUT);
  SP_E_SOCIAL('S-1050', 'R004ESO', 'T', 'I', :NEW.CMPHOR, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R004ESO_EI');
END␀ZÎ␀␀		SENIOR;0Ë␀␀

