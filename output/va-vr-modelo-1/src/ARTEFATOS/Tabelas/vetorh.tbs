PROCEDURE SP_PEND96(P_IdtPes VARCHAR2(23))
 IS

  l_valstr     VARCHAR2(2047);
  l_datatu     DATE;
  l_horatu     NUMBER(4);
  l_seqenv     NUMBER(2);
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datenv     CHAR(16);
  l_seqstr     CHAR(2);
BEGIN
  	
  /* Calcula  data/hora de envio da pendência.*/
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

  l_valstr := '96' || l_datenv || P_IdtPes;
  
  BEGIN
      SP_PORCOM(l_valstr, '0');
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'SP_PEND96: Erro ao gerar pendência 96 (RemoveFriskRegistry).';
