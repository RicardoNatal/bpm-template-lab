PROCEDURE SP_PEND19(P_NUMCRA NUMBER,P_IDTPES CHAR(23))
 IS

l_Comando             VARCHAR2(2047);
  l_data_atual          DATE;
  l_hora_atual          NUMBER(4);
  l_datatu_str   		CHAR(16);
  l_seqenv              NUMBER(2);
  l_datstr              CHAR(6);
  l_horstr              CHAR(4);
  l_seqstr              CHAR(2);
  l_datenv              CHAR(16);
  l_QtdCr1_str          CHAR(2);
  l_QtdCr2_str          CHAR(2);
  l_QtdCr3_str          CHAR(2);
  l_QtdCr4_str          CHAR(2);
  l_QtdCr5_str          CHAR(2);
  l_QtdCr6_str          CHAR(2);
  l_BloFal_str          CHAR(1);
  l_ConAdp_str          CHAR(1);
  l_VerPrm_str          CHAR(1);
  l_TemAlm_str          CHAR(3);
  l_ConCre_str          CHAR(1);
  l_ConFai_str          CHAR(1);
  l_VerAfa_str          CHAR(1);
  l_Prmrt1_str          CHAR(5);
  l_Prmrt2_str          CHAR(5);
  l_Prmrt3_str          CHAR(5);
  l_QtdMsg_str          CHAR(2);
  l_ConIal_str          CHAR(1);
  l_BloAut_str          CHAR(1);
  l_CodPrm_str          CHAR(5);
  l_PrmSab_str          CHAR(5);
  l_PrmDom_str          CHAR(5);
  l_PrmFer_str          CHAR(5);
  l_UsaBio_str          CHAR(1);
  l_GraCon_str          CHAR(3);
  l_ConRea_str          CHAR(1);
  l_ConInt_str          CHAR(1);
  l_TolInt_str          CHAR(3);
  l_ValAut_str          CHAR(1);
  l_caublo              CHAR(20);
  l_prmaut              CHAR(5);
  l_CmdDoc              VARCHAR2(23);
  l_TamDoc              NUMBER(2);
  l_TamDoc_str          CHAR(2);
  l_TipDoc_str          CHAR(1);
  l_QtdPrv_int          NUMBER(2);
  l_ConRee              CHAR(1);
  l_UsaRfa_str          CHAR(1);

  /*VariÃ¡veis SELECT R070CON*/
  l_Iniafa              VARCHAR2(16);
  l_DatAfa              VARCHAR2(16);
  l_SenCol              VARCHAR2(6);
  l_Dinpr1              VARCHAR2(16);
  l_Dfnpr1              VARCHAR2(16);
  l_Dinpr2              VARCHAR2(16);
  l_Dfnpr2              VARCHAR2(16);
  l_Dinpr3              VARCHAR2(16);
  l_Dfnpr3              VARCHAR2(16);
  l_DatMsg              VARCHAR2(16);
  l_MsgAcc              VARCHAR2(32);
  l_FaiAc1              VARCHAR2(56);
  l_FaiAc2              VARCHAR2(56);
  l_FaiAc3              VARCHAR2(56);
  l_FaiAc4              VARCHAR2(56);
  l_FaiAc5              VARCHAR2(56);
  l_FaiAc6              VARCHAR2(56);
  l_FaiAc7              VARCHAR2(56);
  l_FaiPt1              VARCHAR2(56);
  l_FaiPt2              VARCHAR2(56);
  l_FaiPt3              VARCHAR2(56);
  l_FaiPt4              VARCHAR2(56);
  l_FaiPt5              VARCHAR2(56);
  l_FaiPt6              VARCHAR2(56);
  l_FaiPt7              VARCHAR2(56);
  l_FaiRef              VARCHAR2(56);
  l_CreFx1              VARCHAR2(8);
  l_CreFx2              VARCHAR2(8);
  l_CreFx3              VARCHAR2(8);
  l_CreFx4              VARCHAR2(8);
  l_CreFx5              VARCHAR2(8);
  l_CreFx6              VARCHAR2(8);
  l_VerVal              CHAR(1);
  l_QtdCr1              CHAR(2);
  l_QtdCr2              NUMBER(2);
  l_QtdCr3              NUMBER(2);
  l_QtdCr4              NUMBER(2);
  l_QtdCr5              NUMBER(2);
  l_QtdCr6              NUMBER(2);
  l_BloFal              NUMBER(1);
  l_ConAdp              NUMBER(1);
  l_VerPrm              NUMBER(1);
  l_TemAlm              NUMBER(3);
  l_ConCre              NUMBER(1);
  l_ConFai              NUMBER(1);
  l_VerAfa              NUMBER(1);
  l_Prmrt1              NUMBER(5);
  l_Prmrt2              NUMBER(5);
  l_Prmrt3              NUMBER(5);
  l_QtdMsg              NUMBER(2);
  l_ConIal              NUMBER(1);
  l_BloAut              NUMBER(1);
  l_CodPrm              NUMBER(5);
  l_PrmSab              NUMBER(5);
  l_PrmDom              NUMBER(5);
  l_PrmFer              NUMBER(5);
  l_UsaBio              NUMBER(1);
  l_GraCon              NUMBER(3);
  l_conInt              NUMBER(1);
  l_tolInt              NUMBER(3);
  l_ValAut              NUMBER(1);
  l_ConRea              NUMBER(1);
  l_TipDoc              NUMBER(1);
  l_NumDoc              VARCHAR2(20);
  l_qtdprv              CHAR(2);
  l_AndVis              NUMBER(3);
  l_AndVis_str          CHAR(3);
  l_UsaRfa              NUMBER(1);

  /*VariÃ¡veis Dos CrachÃ¡s*/
  l_NumCra              CHAR(12);
  l_NumFis              CHAR(12);
  l_TipCra              CHAR(2);
  l_IniVal              CHAR(16);
  l_DatVal              CHAR(16);
  l_SitCra              CHAR(2);
  l_TecCra              CHAR(2);
  l_QntCra              NUMBER(9);
  l_QntCra_str          CHAR(9);
  l_CmdCra              VARCHAR2(1023);
  /*VariÃ¡veis SP_MAPFIS*/
  l_CraPri              NUMBER(12);
  l_TecPri              NUMBER(1);
  l_NumBar              NUMBER(12);
  l_NumPro              NUMBER(12);
  l_NumSma              NUMBER(12);
  l_nomfun              VARCHAR2(40);
  l_numpis              NUMBER(11);
  l_numpis_str          VARCHAR2(11);
  l_tamnom              NUMBER(3);
  l_tamnom_str          VARCHAR2(3);
  l_nompes              VARCHAR2(40);
  l_RecVis              NUMBER(1);
  l_RecVis_str          CHAR(1);

  /*Cursos que obtem os crachÃ¡s da Pessoa*/
  CURSOR c_r070con IS
  SELECT NUMCRA, NUMFIS, TIPCRA, INIVAL, DATVAL, SITCRA, TECCRA
  FROM R070CON WHERE IDTPES = p_IdtPes AND ( SUBSTRING(DATVAL,5,2)||SUBSTRING(DATVAL,3,2)||
                     SUBSTRING(DATVAL,1,2)||SUBSTRING(DATVAL,7,10) ) > l_datatu_str;
  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NUMCRA%TYPE,
    NUMFIS   R070CON.NUMFIS%TYPE,
    TIPCRA   R070CON.TIPCRA%TYPE,
    INIVAL   R070CON.INIVAL%TYPE,
    DATVAL   R070CON.DATVAL%TYPE,
    SITCRA   R070CON.SITCRA%TYPE,
    TECCRA   R070CON.TECCRA%TYPE);
  l_r070con t_r070con;

  /* CURSOR c/ os registros da tabela R070BIO */
  CURSOR c_r070bio IS SELECT CODTBI FROM R070BIO WHERE IDTPES = p_idtpes GROUP BY CODTBI;
  TYPE t_r070bio IS RECORD(
    CODTBI   R070BIO.CodTbi%TYPE);
  l_r070bio t_r070bio;

BEGIN
  /*InicializaÃ§Ãµes*/
  l_CauBlo := '                    ';
  l_VerVal := '1';
  /*Obtem a data/hora de envio da pendÃªncia.*/
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
  /*Obtem o Segundo*/
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';
  l_prmaut := '00000'; /*Se nÃ£o for cracha de autorizaÃ§Ã£o de entrada permissao de autorizaÃ§Ã£o Ã© zero.*/
  
  l_datatu_str := SUBSTRING(l_datstr, 5,2) || SUBSTRING(l_datstr, 3,2)
               || SUBSTRING(l_datstr, 1,2) || l_horstr || '000000';

  /*Obtem o CrachÃ¡ Principal*/
  SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
  IF (l_crapri = 0) THEN
      l_crapri := p_numcra;
  END IF;
  /*Obtem as informaÃ§Ãµes da pessoa*/
  BEGIN
      SELECT Iniafa, DatAfa, BloFal, ConAdp, VerPrm, SenCol, TemAlm, ConCre,
             ConFai, VerAfa, Prmrt1, Dinpr1, Dfnpr1, Prmrt2, Dinpr2, Dfnpr2,
             Prmrt3, Dinpr3, Dfnpr3, DatMsg, QtdMsg, MsgAcc, FaiAc1, FaiAc2,
             FaiAc3, FaiAc4, FaiAc5, FaiAc6, FaiAc7, FaiPt1, FaiPt2, FaiPt3,
             FaiPt4, FaiPt5, FaiPt6, FaiPt7, QtdCr1, QtdCr2, QtdCr3, QtdCr4,
             QtdCr5, QtdCr6, CreFx1, CreFx2, CreFx3, CreFx4, CreFx5, CreFx6,
             FaiRef, ConIal, BloAut, CodPrm, PrmSab, PrmDom, PrmFer, UsaBio,
             GraCon, ConInt, TolInt, ValAut, NomFun, NumPis, ConRea, TipDoc,
             NumDoc, NomPes, RecVis, AndVis, UsaRfa
      INTO
             l_Iniafa, l_DatAfa, l_BloFal, l_ConAdp, l_VerPrm, l_SenCol, l_TemAlm, l_ConCre,
             l_ConFai, l_VerAfa, l_Prmrt1, l_Dinpr1, l_Dfnpr1, l_Prmrt2, l_Dinpr2, l_Dfnpr2,
             l_Prmrt3, l_Dinpr3, l_Dfnpr3, l_DatMsg, l_QtdMsg, l_MsgAcc, l_FaiAc1, l_FaiAc2,
             l_FaiAc3, l_FaiAc4, l_FaiAc5, l_FaiAc6, l_FaiAc7, l_FaiPt1, l_FaiPt2, l_FaiPt3,
             l_FaiPt4, l_FaiPt5, l_FaiPt6, l_FaiPt7, l_QtdCr1, l_QtdCr2, l_QtdCr3, l_QtdCr4,
             l_QtdCr5, l_QtdCr6, l_CreFx1, l_CreFx2, l_CreFx3, l_CreFx4, l_CreFx5, l_CreFx6,
             l_FaiRef, l_ConIal, l_BloAut, l_CodPrm, l_PrmSab, l_PrmDom, l_PrmFer, l_UsaBio,
             l_GraCon, l_ConInt, l_TolInt, l_ValAut, l_NomFun, l_NumPis, l_ConRea, l_TipDoc,
             l_NumDoc, l_NomPes, l_RecVis, l_AndVis, l_UsaRfa
      FROM R070CON WHERE NUMFIS = l_crapri;
  EXCEPTION
      WHEN OTHERS THEN NULL;
  END;

  /*Formata o retorno na ordem que estÃ¡ o datagrama*/
  IF ((l_IniAfa = '                ') OR (l_IniAfa = '') OR (l_IniAfa IS NULL)) THEN
      l_IniAfa := '0000000000000000';
  ELSE

      l_IniAfa := lTrim(l_IniAfa);
      l_IniAfa := rTrim(l_IniAfa);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_IniAfa) > 15 ) THEN
              EXIT;
          END IF;
          l_IniAfa := l_IniAfa||'0';
      END LOOP;
  END IF;

  IF ((l_DatAfa = '                ') OR (l_DatAfa = '') OR (l_DatAfa IS NULL)) THEN
      l_DatAfa := '0000000000000000';
  ELSE
      l_DatAfa := lTrim(l_DatAfa);
      l_DatAfa := rTrim(l_DatAfa);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_DatAfa) > 15 ) THEN
              EXIT;
          END IF;
          l_DatAfa := l_DatAfa||'0';
      END LOOP;
  END IF;
  
  IF (l_BloFal IS NULL) THEN
  	l_BloFal_str := '0';
  ELSE
  	SP_INTSTR(l_BloFal,'9',l_BloFal_str OUT);
  END IF;
  
  IF (l_ConAdp IS NULL) THEN
  	l_ConAdp_str := '0';
  ELSE
  	SP_INTSTR(l_ConAdp,'9',l_ConAdp_str OUT);
  END IF;
  
  IF (l_VerPrm IS NULL) THEN
  	l_VerPrm_str := '0';
  ELSE
  	SP_INTSTR(l_VerPrm,'9',l_VerPrm_str OUT);
  END IF;
  
  IF (l_ConRea IS NULL) THEN
  	l_ConRea_str := '0';
  ELSE
  	SP_INTSTR(l_ConRea,'9',l_ConRea_str OUT);
  END IF;

  IF (l_SenCol IS NULL) THEN
      l_SenCol := '      ';
  END IF;
  LOOP
      /*Controle do Loop.*/
      IF (Length(l_SenCol) > 5 ) THEN
          EXIT;
      END IF;
      l_SenCol := ' '||l_SenCol;
  END LOOP;
  
  IF (l_TemAlm IS NULL) THEN
  	l_TemAlm_str := '000';
  ELSE
  	SP_INTSTR(l_TemAlm,'999',l_TemAlm_str OUT);
  END IF;
  
  IF (l_ConCre IS NULL) THEN
  	l_ConCre_str := '0';
  ELSE
  	SP_INTSTR(l_ConCre,'9',l_ConCre_str OUT);
  END IF;
  
  IF (l_ConFai IS NULL) THEN
  	l_ConFai_str := '0';
  ELSE
  	SP_INTSTR(l_ConFai,'9',l_ConFai_str OUT);
  END IF;
  
  IF (l_VerAfa IS NULL) THEN
  	l_VerAfa_str := '0';
  ELSE
  	SP_INTSTR(l_VerAfa,'9',l_VerAfa_str OUT);
  END IF;
  
  IF (l_Prmrt1 IS NULL) THEN
