/* STORED PROCEDURE RESPONSÁVEL POR RESETAR/REINICIAR TODOS OS CRÉDITOS DE ACESSO DE UMA PESSOA*/
PROCEDURE SP_RESETCRED(P_TIPPES INTEGER,P_NUMEMP NUMBER,P_TIPCOL INTEGER,P_NUMCAD NUMBER,P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMMAT VARCHAR2(15),P_PROPAC VARCHAR2(20))
 IS

l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_idtpes       VARCHAR2(23);
  l_verplf       NUMBER(3);
  l_tipdoc       CHAR(1);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
BEGIN
  /*Busca versão do plano ativa*/
  BEGIN
      SELECT VERPLF INTO l_verplf
        FROM R058VPL
       WHERE DATCRI <= l_data_atual
         AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
  EXCEPTION
      WHEN OTHERS THEN
          l_verplf := 1;
  END;
  /*Inicializações*/
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  
  /*EFETUA A OPERAÇÃO DE ACORDO COM A PESSOA*/

  /*COLABORADOR*/
  IF (p_tippes < 4) THEN
      SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;

      UPDATE R070CRC SET SALATU = CREDIA, QTDCON = 0, DATCON = l_data_zero
       WHERE R070CRC.NUMEMP = p_numemp
         AND R070CRC.TIPCOL = p_tipcol
         AND R070CRC.NUMCAD = p_numcad
         AND R070CRC.DATINI <= l_data_atual
         AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR
              (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual));

      /*Atualiza os créditos sem local físico*/
      SP_CRECON(p_tippes, p_numemp, p_tipcol, p_numcad, 0, '0', '0', '0', l_verplf, 0);
      
  /*VISITANTE*/
  ELSIF (p_tippes = 4) THEN
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := '04'||l_tipdoc||p_numdoc;

      UPDATE R070CRV SET SALATU = CREDIA, QTDCON = 0, DATCON = l_data_zero
       WHERE R070CRV.TIPDOC = p_tipdoc
         AND R070CRV.NUMDOC = p_numdoc
         AND R070CRV.DATINI <= l_data_atual
         AND (R070CRV.DATFIM = l_data_zero OR R070CRV.DATFIM > l_data_atual OR
              (R070CRV.DATFIM = l_data_atual AND R070CRV.FIMFAI >= l_hora_atual) );

      /*Atualiza os créditos sem local físico*/
      SP_CRECON(p_tippes, 0, 0, 0, p_tipdoc, p_numdoc, '0', '0', l_verplf, 0);
      
  /*Outras Unidades*/
  ELSIF (p_tippes = 5) THEN
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= '05'||l_numemp||l_numcad;

      UPDATE R070CRO SET SALATU = CREDIA, QTDCON = 0, DATCON = l_data_zero
       WHERE R070CRO.NUMEMP = p_numemp
         AND R070CRO.NUMCAD = p_numcad
         AND R070CRO.DATINI <= l_data_atual
         AND (R070CRO.DATFIM = l_data_zero OR R070CRO.DATFIM > l_data_atual OR
              (R070CRO.DATFIM = l_data_atual AND R070CRO.FIMFAI >= l_hora_atual));

      /*Atualiza os créditos sem local físico*/
      SP_CRECON(p_tippes, p_numemp, 0, p_numcad, 0, '0', '0', '0', l_verplf, 0);

  /*ALUNO*/
  ELSIF (p_tippes = 6) THEN
      l_idtpes:= '10'||p_nummat;

      UPDATE R070CRA SET SALATU = CREDIA, QTDCON = 0, DATCON = l_data_zero
       WHERE R070CRA.NUMMAT = p_nummat
         AND R070CRA.DATINI <= l_data_atual
         AND ( R070CRA.DATFIM = l_data_zero OR R070CRA.DATFIM > l_data_atual OR
              (R070CRA.DATFIM = l_data_atual AND R070CRA.FIMFAI >= l_hora_atual) );

      /*Atualiza os créditos sem local físico*/
      SP_CRECON(p_tippes, 0, 0, 0, 0, '0', p_nummat, '0', l_verplf, 0);

  /*Responsavel do Aluno */
  ELSIF (p_tippes = 7) THEN
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := '07'||l_tipdoc||p_numdoc;

      UPDATE R070CRR SET SALATU = CREDIA, QTDCON = 0, DATCON = l_data_zero
       WHERE R070CRR.TIPDOC = p_tipdoc
         AND R070CRR.NUMDOC = p_numdoc
         AND R070CRR.DATINI <= l_data_atual
         AND (R070CRR.DATFIM = l_data_zero OR R070CRR.DATFIM > l_data_atual OR
              (R070CRR.DATFIM = l_data_atual AND R070CRR.FIMFAI >= l_hora_atual));

      /*Atualiza os créditos sem local físico*/
      SP_CRECON(p_tippes, 0, 0, 0, p_tipdoc, p_numdoc, '0', '0', l_verplf, 0);

  /*PACIENTES*/
  ELSIF (p_tippes = 9) THEN
      l_idtpes := '09'||p_propac;

      UPDATE R070CRP SET SALATU = CREDIA, QTDCON = 0, DATCON = l_data_zero
       WHERE R070CRP.PROPAC = p_propac
         AND R070CRP.DATINI <= l_data_atual
         AND (R070CRP.DATFIM = l_data_zero OR R070CRP.DATFIM > l_data_atual OR
              (R070CRP.DATFIM = l_data_atual AND R070CRP.FIMFAI >= l_hora_atual));
      
  ELSIF (p_tippes = 11) THEN
  	  l_idtpes := '11'||l_tipdoc||p_numdoc;
  	  
  	  UPDATE R070CAP SET SALATU = CREDIA, QTDCON = 0, DATCON = l_data_zero
       WHERE R070CAP.TIPDOC = p_tipdoc
         AND R070CAP.NUMDOC = p_numdoc
         AND R070CAP.DATINI <= l_data_atual
         AND (R070CAP.DATFIM = l_data_zero OR R070CAP.DATFIM > l_data_atual OR
              (R070CAP.DATFIM = l_data_atual AND R070CAP.FIMFAI >= l_hora_atual));
  ELSE
      RAISERROR 103 'SP_RESETCRED: Tipo de pessoa inválida para operação.';    
  END IF;

  /*Preenche o campo com espaços para completar 23 posições*/
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
     /*Controle do Loop.*/
     IF (Length(l_idtpes) > 22) THEN
         EXIT;
     END IF;
     l_idtpes := ' '||l_idtpes;
  END LOOP;

  BEGIN
      /*ATUALIZA TODOS OS CRÉDITOS POR LOCAL FÍSICO DA PESSOA*/
      SP_ATUCRELOC(l_idtpes);
  EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'SP_RESETCRED: Erro ao atualizar os créditos por local físico.';
  END;
END␀¬ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_E_SOCIAL
e␀␀PROCEDURE SP_RESP_ESOCIAL(P_OPERACAO VARCHAR2(255),P_VALOR VARCHAR2(2000))
 IS

  L_LAYOUT VARCHAR2(6);
  L_TABELA VARCHAR2(7);
  L_EVENTO CHAR;
  L_INIVAL DATE;
  L_FIMVAL DATE;
  l_Empresa NUMBER(4);
  L_TIPCOL NUMBER(1);
  L_NUMCAD NUMBER(9);
  L_VALOR2 VARCHAR2(2000);
  L_USUARIO NUMBER(10);
  L_DATAENC DATE;
  L_DATAREF DATE; 
  L_PENEXT NUMBER(1); 
  L_ORIGEM VARCHAR2(60);

  CURSOR c_r000res IS
      SELECT NUMEMP
        FROM R030EMP E
       WHERE NOT EXISTS (SELECT 1 FROM R000RES S 
                          WHERE S.NUMEMP = E.NUMEMP
                            AND DOCLEG = 10)
         AND EXISTS (SELECT 1 FROM R030DES
                      WHERE NUMEMP = E.NUMEMP);
BEGIN
  L_LAYOUT := 'S-1000';  
  L_TABELA := 'R000RES'; 
  L_EVENTO := 'T'; 
  L_INIVAL := NULL; 
  L_FIMVAL := NULL; 
  L_TIPCOL := 0; 
  L_NUMCAD := 0; 
  L_VALOR2 := ''; 
  L_USUARIO := 0; 
  L_DATAENC := NULL; 
  L_DATAREF := NULL; 
  L_PENEXT := 0; 
  L_ORIGEM := 'SP_RESP_ESOCIAL';

  /* Quando a Empresa é zero, deve criar pendência para todas as empresas que não tem responsável legal específico */
  FOREACH c_r000res INTO l_Empresa
  LOOP
    SP_E_SOCIAL(L_LAYOUT, L_TABELA, L_EVENTO, P_OPERACAO, L_INIVAL, L_FIMVAL, l_Empresa, L_TIPCOL, L_NUMCAD, P_VALOR, L_VALOR2, L_USUARIO,  L_DATAENC, L_DATAREF,  L_PENEXT, L_ORIGEM);
  END LOOP;
END	ORACLE;0
ø␀␀create or replace PROCEDURE SP_RESP_ESOCIAL(P_OPERACAO IN VARCHAR2,P_VALOR IN VARCHAR2) IS
  PRAGMA AUTONOMOUS_TRANSACTION;      
  l_Empresa NUMBER;
  l_DataAtual DATE;
  l_DataZerada DATE;
  l_DataFimConvivencia DATE;
  cursor c_r000res is 
    SELECT 
      E.NUMEMP NUMEMP
       FROM R030EMP E
       WHERE  
      NOT EXISTS (SELECT 
      1 EXPR1117768829
       FROM R000RES S
       WHERE S.NUMEMP=E.NUMEMP 
      AND DOCLEG=10 ) 
      AND NOT EXISTS (SELECT 
      1 EXPR1836809820
       FROM R030DES R030DES
       WHERE NUMEMP=E.NUMEMP
       AND ((INFFAC <> 2)
	   AND ((simfol > l_DataZerada AND l_DataAtual >= simfol) OR l_dataatual>=l_DataFimConvivencia)));
  c_r000res_cnt integer;
begin
  l_DataAtual := TO_DATE(TO_CHAR(GETDBDATETIME,'DD/MM/YYYY'),'DD/MM/YYYY');
  l_DataZerada := TO_DATE(TO_CHAR(31)||'/'||TO_CHAR(12)||'/'||TO_CHAR(1900)||' '||TO_CHAR(0)||':'||TO_CHAR(0)||':'||TO_CHAR(0),'DD/MM/YYYY HH24:MI:SS'); 
  l_DataFimConvivencia := TO_DATE(TO_CHAR(9)||'/'||TO_CHAR(11)||'/'||TO_CHAR(2021)||' '||TO_CHAR(0)||':'||TO_CHAR(0)||':'||TO_CHAR(0),'DD/MM/YYYY HH24:MI:SS');
  open c_r000res;
  begin
    fetch c_r000res into l_Empresa;
    while (c_r000res%FOUND)
    loop      
      SP_E_SOCIAL('S-1000','R000RES','T',P_OPERACAO,NULL,NULL,l_Empresa,0,0,P_VALOR,'',0,NULL,NULL,0,'SP_RESP_ESOCIAL');      
      fetch c_r000res into l_Empresa;
    end loop;
  exception when others then
    null;
  end;  
  commit;
  close c_r000res;      
end SP_RESP_ESOCIAL;

	MSSQL;0
9␀␀CREATE  PROCEDURE SP_RESP_ESOCIAL(@P_OPERACAO VARCHAR(255), @P_VALOR VARCHAR(2000)) AS
BEGIN
  DECLARE @l_empresa FLOAT
  DECLARE @ChkError INTEGER
  DECLARE @l_dataatual DATETIME
  DECLARE @l_datazerada DATETIME
  DECLARE @l_datafimconvivencia DATETIME
  SELECT @ChkError = 0
  SELECT @l_dataatual = CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(MM, GETDATE()))))+ '/' + LTRIM(RTRIM(STR(DATEPART(DD,  GETDATE()))))+ '/' + LTRIM(RTRIM(STR(DATEPART(YY,  GETDATE())))))
  SELECT @l_datazerada = CONVERT(DATETIME,CONVERT(VARCHAR,12)+'/'+CONVERT(VARCHAR,31)+'/'+CONVERT(VARCHAR,1900)+' '+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)) 
  SELECT @l_datafimconvivencia = CONVERT(DATETIME,CONVERT(VARCHAR,11)+'/'+CONVERT(VARCHAR,9)+'/'+CONVERT(VARCHAR,2021)+' '+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0))
  
  DECLARE c_r000res CURSOR FOR SELECT 
      e.numemp NUMEMP
       FROM r030emp e
       WHERE  
      not exists (select 
      1 expr1202580318
       from r000res s
       where s.numemp=e.numemp 
      and docleg=10 ) 
      and not exists (select 
      1 expr960632393
       from r030des r030des
       where numemp=e.numemp
       and ((inffac <> 2)
	   AND ((simfol > @l_Datazerada AND @l_dataatual >= simfol) OR @l_dataatual>=@l_datafimconvivencia)))
  OPEN c_r000res
  FETCH NEXT FROM c_r000res INTO @l_Empresa
  WHILE  (@@FETCH_STATUS = 0)
  BEGIN
    EXECUTE  @ChkError = SP_E_SOCIAL 'S-1000','R000RES','T',@P_OPERACAO,NULL,NULL,@l_Empresa,0,0,@P_VALOR,'',0,NULL,NULL,0,'SP_RESP_ESOCIAL'
    IF @ChkError <> 0
    BEGIN
      GOTO FNc_r000res1
    END
    FETCH NEXT FROM c_r000res INTO @l_Empresa
  END
  FNc_r000res1: /* FINALLY OPEN CURSOR */
  CLOSE c_r000res
  DEALLOCATE c_r000res
  IF @ChkError <> 0
    GOTO FIM
FIM:
  RETURN @ChkError
END

␀­ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_DATSTR
G␀␀/* Retorna Afastamento */
PROCEDURE SP_RETAFA(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATATU DATE,P_HORATU NUMBER,P_AFASTO OUT NUMBER)
 IS

l_data_zero       DATE;
  l_dataux          DATE;
  l_datafa  VARCHAR2(10);
  alfmen   VARCHAR2(255);
BEGIN
  /* Inicializa */
  l_data_zero  := '31/12/1900,00:00:00';
  p_afasto := 1;
  /* Verifica se Existe Afastamento no Periodo c/ Situacao de Bloqueio = 'S' */
  BEGIN
    SELECT R038AFA.DATAFA
      INTO l_dataux
      FROM R038AFA
     WHERE R038AFA.NUMEMP = p_numemp AND
           R038AFA.TIPCOL = p_tipcol AND
           R038AFA.NUMCAD = p_numcad AND
          (R038AFA.DATAFA < p_datatu OR
           (R038AFA.DATAFA = p_datatu AND R038AFA.HORAFA <= p_horatu)) AND
          (R038AFA.DATTER = l_data_zero OR
           R038AFA.DATTER > p_datatu OR
           (R038AFA.DATTER = p_datatu AND R038AFA.HORTER >= p_horatu)) AND
           IFNULL(R038AFA.ORIAFA,0) <> 1;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
       p_afasto := 0;
    WHEN TOO_MANY_ROWS THEN
      SP_DATSTR(p_datatu,'DDMMYY',l_datafa);
          ALFMEN := 'Mais de Um Afastamento em ' ||l_datafa|| ', Hora '||CONVERT(NUMBER_TO_CHAR,p_horatu);
          RAISERROR 103 ALFMEN;
    WHEN OTHERS THEN
      ALFMEN := 'Erro no SELECT em R038AFA.';
      RAISERROR 103 alfmen;
  END;
END␀®ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ö␀␀PROCEDURE SP_RETAUT(P_IDTPES VARCHAR2(23), P_VALAUT OUT NUMBER(1))
	IS

    l_valaut NUMBER(4);
    l_data_zero  DATE; 
    l_data_atual DATE;
	l_hora_atual NUMBER(4);
BEGIN
	/* Verifico se o IDTPES passado como parametro possui autorizador cadastrado. */
	/* Se sim, retorno 1. Caso contrário, 0. */
	l_valaut := 0;
	l_data_zero  := '31/12/1900,00:00:00';
	l_data_atual := CURDATE();
	l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

	BEGIN
   		SELECT COUNT(*) QTDE INTO l_valaut FROM R090VAU
   			WHERE (IDTPES = P_IDTPES) AND (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
			  (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_valaut := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao selecionar autorizador na tabela R090VAU.';
	END;
  	
    IF (l_valaut > 1) THEN
    	p_valaut := 1;
    ELSE
    	p_valaut := l_valaut;  
    END IF;
END␀¯ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀/* Retorna Periodo Afastamento */
PROCEDURE SP_RETBLO(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_NUMMAT VARCHAR2(15),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER(12),P_DATATU DATE,P_HORATU NUMBER,P_SITBLO OUT VARCHAR2(1))
 IS
BEGIN
  p_sitblo := '1';
END		SENIOR;24
v␀␀

PROCEDURE SP_RETBLO(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_NUMMAT VARCHAR2(15),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER(12),P_DATATU DATE,P_HORATU NUMBER,P_SITBLO OUT VARCHAR2(1))
 IS

l_data_zero   DATE;
  l_codmot      NUMBER(2);
  l_count       NUMBER(2);  
  l_codsta      NUMBER(2);
  l_bloace      CHAR(1);
  l_strerr      VARCHAR2(255);
  l_blofal      NUMBER(2);

BEGIN
  /* Inicializa */
  l_data_zero  := '31/12/1900,00:00:00';

  /* bloqueio por falta tem tratamento diferente no sistema, bloqueando pelo campo bloq_falta */
  BEGIN
      SELECT MOTBLO INTO l_blofal FROM R070DAC;
  EXCEPTION
      WHEN OTHERS THEN l_blofal := 0;
  END;

  /* Aluno */
  IF (p_tipcol = 6) THEN
      /* verifica qual a situação no histórico do aluno */
      l_codsta := 0;
      l_bloace := 'S';
      BEGIN
          SELECT CODSTA INTO l_codsta FROM R073HSA WHERE NUMMAT = p_nummat AND
                 ((DATINI < p_datatu) OR (DATINI = p_datatu AND HORINI <= p_horatu)) AND
                 ((DATFIM > p_datatu) OR (DATFIM = p_datatu AND HORFIM > p_horatu) OR (DATFIM = l_data_zero));
      EXCEPTION
          WHEN TOO_MANY_ROWS THEN l_strerr := 'SP_RETBLO: Erro em R073HSA - TOO MANY ROWS. Nummat = '||p_nummat;
                                  RAISERROR 103 l_strerr;
          WHEN NO_DATA_FOUND THEN l_codsta := 0;
          WHEN OTHERS THEN l_strerr := 'SP_RETBLO: Erro no SELECT em R073HSA. Nummat = '||p_nummat;
                           RAISERROR 103 l_strerr;
      END;

      /* verifica se a situação do aluno é de bloqueio */
      BEGIN
          SELECT BLOACE INTO l_bloace FROM R073STA WHERE CODSTA = l_codsta;
      EXCEPTION
          WHEN TOO_MANY_ROWS THEN l_strerr := 'SP_RETBLO: Erro em R073STA - TOO MANY ROWS. CodSta = '|| CONVERT(NUMBER_TO_CHAR, l_codsta);
                                  RAISERROR 103 l_strerr;
          WHEN NO_DATA_FOUND THEN l_bloace := 'S';
          WHEN OTHERS THEN l_strerr := 'SP_RETBLO: Erro no SELECT em R073STA. CodSta = '||CONVERT(NUMBER_TO_CHAR, l_codsta);
                           RAISERROR 103 l_strerr;
      END;

      IF  (l_bloace = 'S') THEN
          l_codmot := 1;
      ELSE
          l_codmot := 0;
      END IF;
  ELSE
    IF (p_tipcol = 7) THEN
      l_count := 0;
      BEGIN
        SELECT COUNT(*) INTO l_count FROM R073ARE WHERE EXISTS ( SELECT 1 FROM R073HSA,R073STA WHERE
		R073ARE.NUMMAT = R073HSA.NUMMAT AND R073HSA.CODSTA = R073STA.CODSTA
		AND (DATINI < p_datatu OR (DATINI = p_datatu AND HORINI <= p_horatu)) AND
		(DATFIM > p_datatu OR ((DATFIM = p_datatu AND HORFIM > p_horatu) OR
		(DATFIM = l_data_zero))) AND BLOACE='N')
		AND TIPDOC = p_tipdoc AND NUMDOC = p_numdoc;
      EXCEPTION
          WHEN NO_DATA_FOUND THEN l_count := 0;
          WHEN OTHERS THEN l_strerr := 'SP_RETBLO: Erro no SELECT em R073ARE. TipDoc = '||
                           Convert(NUMBER_to_CHAR,p_tipdoc) || ' Numdoc = '|| p_numdoc;
                           RAISERROR 103 l_strerr;
      END;
      /* se encontrar um aluno que não bloqueia, liberar também o responsável */
      IF  l_count > 0 THEN
          l_codMot := 0;
      ELSE
          l_codMot := 1;
      END IF;
    ELSE
      /* Verifica se o colaborador esta bloqueado pelo cadastro. */
      BEGIN
          SELECT CODMOT INTO l_codmot FROM R070BLO WHERE
                 NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                (DATBLO < p_datatu OR (DATBLO = p_datatu AND HORBLO <= p_horatu)) AND
                (DATLIB = l_data_zero OR DATLIB > p_datatu OR (DATLIB = p_datatu AND HORLIB > p_horatu));
      EXCEPTION
          WHEN TOO_MANY_ROWS THEN l_strerr := 'SP_RETBLO: Erro em R070BLO - TOO MANY ROWS.'||
                                              ' numemp = '||Convert(NUMBER_to_CHAR,p_numemp)||
                                              ' tipcol = '||Convert(NUMBER_to_CHAR,p_tipcol)||
                                              ' numcad = '||Convert(NUMBER_to_CHAR,p_numcad);

                                  RAISERROR 103 l_strerr;
          WHEN NO_DATA_FOUND THEN l_codmot := 0;
          WHEN OTHERS THEN l_strerr := 'SP_RETBLO: Erro no SELECT em R070BLO.'||
                                       ' numemp = '||Convert(NUMBER_to_CHAR,p_numemp)||
                                       ' tipcol = '||Convert(NUMBER_to_CHAR,p_tipcol)||
                                       ' numcad = '||Convert(NUMBER_to_CHAR,p_numcad);
                           RAISERROR 103 l_strerr;
      END;

      /* Verifica se o colaborador esta bloqueado pelo cracha. */
      IF  (l_codmot = 0) AND (p_numcra <> 0) THEN
          BEGIN
              SELECT CODMOT INTO l_codmot FROM R070BLC WHERE
                     NUMCRA = p_numcra AND (DATBLO < p_datatu OR (DATBLO = p_datatu AND HORBLO <= p_horatu)) AND
                    (DATLIB = l_data_zero OR DATLIB > p_datatu OR (DATLIB = p_datatu AND HORLIB > p_horatu));
          EXCEPTION
              WHEN TOO_MANY_ROWS THEN l_strerr := 'SP_RETBLO: Erro em R070BLC - TOO MANY ROWS.'||
                                                  ' numemp = '||Convert(NUMBER_to_CHAR,p_numemp)||
                                                  ' tipcol = '||Convert(NUMBER_to_CHAR,p_tipcol)||
                                                  ' numcad = '||Convert(NUMBER_to_CHAR,p_numcad);
                                      RAISERROR 103 l_strerr;
              WHEN NO_DATA_FOUND THEN l_codmot := 0;
              WHEN OTHERS THEN l_strerr := 'SP_RETBLO: Erro no SELECT em R070BLC.'||
                                           ' numemp = '||Convert(NUMBER_to_CHAR,p_numemp)||
                                           ' tipcol = '||Convert(NUMBER_to_CHAR,p_tipcol)||
                                           ' numcad = '||Convert(NUMBER_to_CHAR,p_numcad);
                               RAISERROR 103 l_strerr;
          END;
      END IF;
    END IF;
  END IF;

  IF  l_codmot <> 0 THEN
      IF  (l_codmot=l_blofal) AND (p_tipcol < 4) THEN
          p_sitblo := 'F';
      ELSE
          p_sitblo := '1';
      END IF;
  ELSE
      p_sitblo := '0';
  END IF;
END		SENIOR;20
