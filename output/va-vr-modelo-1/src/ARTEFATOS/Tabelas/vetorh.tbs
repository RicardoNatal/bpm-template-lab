f+␀

/* Historico de Cracha - Colaborador */
PROCEDURE SP_ColCon(P_TIPOPE CHAR,P_TIPCRA NUMBER(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NUMMAT VARCHAR2(15),P_DATINI DATE,P_HORINI NUMBER(5),P_NUMCRA NUMBER(12),P_DATFIM DATE,P_HORFIM NUMBER(5),P_CRAOLD NUMBER(12),P_STATUS NUMBER(1),P_SUBNV NUMBER(1),P_CREACC NUMBER(1))
 IS

  l_tipope       CHAR;
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_cratit       NUMBER(12);
  l_crapro       NUMBER(12);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numpro_ret   BOOLEAN;
  l_numsma       NUMBER(12);
  l_numsma_ret   BOOLEAN;
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_teccra       NUMBER(1);
  l_codprm       NUMBER(5);
  l_prmprg       NUMBER(5);
  l_sabprg       NUMBER(5);
  l_domprg       NUMBER(5);
  l_ferprg       NUMBER(5);
  l_prmsab       NUMBER(5);
  l_prmdom       NUMBER(5);
  l_prmfer       NUMBER(5);
  l_codprm_tpe   NUMBER(5);
  l_prmsab_tpe   NUMBER(5);
  l_prmdom_tpe   NUMBER(5);
  l_prmfer_tpe   NUMBER(5);
  l_r064tpe      NUMBER(1);
  l_grupo        CHAR(5);
  l_grupo_sab    CHAR(5);
  l_grupo_dom    CHAR(5);
  l_grupo_fer    CHAR(5);
  l_tippes       NUMBER(2);
  l_codig        CHAR(6);
  l_situa        CHAR(1);
  l_subnv        CHAR(5);
  l_idtpes       VARCHAR2(23);
  l_tipdoc       CHAR(1);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_qtdIdtPes    NUMBER(2);
  l_count        NUMBER(4);
  l_iPerson      BOOLEAN;
  l_DatAno       NUMBER(4);
  l_tipdoccol    NUMBER(1);
  l_numdoccol    VARCHAR2(20);
  l_numcpf       NUMBER(11);
  l_numpsp       VARCHAR2(20);
  l_qtdpra       NUMBER(5);
  l_staseg       NUMBER(1);
  l_craext       NUMBER(12);

  /* Controle de Faixas Horarias */
  l_faixa        CHAR(56);
  l_fx_dom_a     CHAR(56);
  l_fx_seg_a     CHAR(56);
  l_fx_ter_a     CHAR(56);
  l_fx_qua_a     CHAR(56);
  l_fx_qui_a     CHAR(56);
  l_fx_sex_a     CHAR(56);
  l_fx_sab_a     CHAR(56);
  l_fx_dom_p     CHAR(56);
  l_fx_seg_p     CHAR(56);
  l_fx_ter_p     CHAR(56);
  l_fx_qua_p     CHAR(56);
  l_fx_qui_p     CHAR(56);
  l_fx_sex_p     CHAR(56);
  l_fx_sab_p     CHAR(56);
  l_fx_ref       CHAR(56);

  /* Controle de Mensagens */
  l_desmsg       VARCHAR2(32);
  l_datmsg       CHAR(16);
  l_qtdmsg       CHAR(2);

  /* Controle de Creditos de Acesso */
  l_crefx1       CHAR(2);
  l_fx1          CHAR(8);
  l_crefx2       CHAR(2);
  l_fx2          CHAR(8);
  l_crefx3       CHAR(2);
  l_fx3          CHAR(8);
  l_crefx4       CHAR(2);
  l_fx4          CHAR(8);
  l_crefx5       CHAR(2);
  l_fx5          CHAR(8);
  l_crefx6       CHAR(2);
  l_fx6          CHAR(8);
  l_ultpas_ref   CHAR(10);

  /* Controle de Areas Restritas */
  l_grupo1       CHAR(5);
  l_inigr1       CHAR(10);
  l_fimgr1       CHAR(10);
  l_grupo2       CHAR(5);
  l_inigr2       CHAR(10);
  l_fimgr2       CHAR(10);
  l_grupo3       CHAR(5);
  l_inigr3       CHAR(10);
  l_fimgr3       CHAR(10);
  l_iniAR1       CHAR(10);
  l_fimAR1       CHAR(10);
  l_iniAR2       CHAR(10);
  l_fimAR2       CHAR(10);
  l_iniAR3       CHAR(10);
  l_fimAR3       CHAR(10);

  /* Definições de acesso por colaborador R034DAC */
  l_anti_dupla   CHAR(1); /* Controla Anti-Dupla */
  l_fx_flg       CHAR(1); /* Controla Intervalo de Almoço */
  l_tempo_alm    CHAR(3); /* Tempo Mínimo de Almoço (Minutos) */
  l_blofal       NUMBER(1); /* Bloqueia Acesso por Falta */
  l_ver_hora     CHAR(1); /* Controla Faixa Horária de Acesso */
  l_ver_local    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_valid    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_afast    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_cred     CHAR(1); /* Controla Creditos de acesso Refeitorio */
  l_ConInt_str   CHAR(1);
  l_ConInt_int   NUMBER(1);
  l_TolInt       NUMBER(3);
  l_ValAut       NUMBER(1);
  l_conrea_str   CHAR(1);
  l_datini       CHAR(6);
  l_datfim       CHAR(6);
  l_horini       CHAR(4);
  l_horfim       CHAR(4);
  l_numcra       NUMBER(12);
  l_numcra_str   CHAR(12);
  l_craaux       NUMBER(12);
  l_atua_titular BOOLEAN;
  L_NODATAFOUND  BOOLEAN;
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_dathorvalatu CHAR(16);
  l_aceocr       NUMBER(1);
  l_codesc         R006ESC.CodEsc%TYPE;
  l_codtma       NUMBER(1);
  l_turint       NUMBER(9);
  l_coderr       NUMBER(2);
  l_conadp       CHAR(1);
  l_conial       CHAR(1);
  l_recvis_Str   CHAR(1);
  l_recvis       NUMBER(1);
  l_temalm       NUMBER(3);
  l_confai       NUMBER(1);
  l_verprm       CHAR(1);
  l_conrea       NUMBER(1);
  l_concre       NUMBER(1);
  l_updref       VARCHAR2(255);
  l_verafa       CHAR(1);
  l_horval       NUMBER;
  l_horent       NUMBER;
  l_datval       DATE;
  l_datent       DATE;
  l_datahora     VARCHAR2(10);
  l_inival       CHAR(16);
  /*Controle de permissão para 3º turno*/
  l_prmsabequal  NUMBER;
  l_prmdomequal  NUMBER;
  l_prmsegequal  NUMBER;
  l_auxval       CHAR(16);
  l_valven       CHAR(16);
  l_iniafa       CHAR(16);
  l_datafa       CHAR(16);
  l_straux       VARCHAR2(2047);
  l_auxmsg       CHAR(32);
  l_usaBio       NUMBER(1);
  l_gracon       NUMBER(3);
  l_creacc_bol   BOOLEAN;
  l_subnv_bol    BOOLEAN;
  l_apupfs       CHAR(1);
  l_conpac       NUMBER(1);
  l_conpac_str   CHAR(1);
  l_tempac       NUMBER(3);
  l_tolacp       NUMBER(2);
  l_tolacp_time  NUMBER;
  l_segu_atual   NUMBER(2);
  l_temp1        NUMBER(4);
  l_temp2        NUMBER(3);
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_datmes       DATE;
  l_hormes       NUMBER(5);
  /*Variáveis de inserção do crachá titular (quando o mesmo ainda não existir)*/
  l_numcratit    NUMBER(12);
  l_datinitit    DATE;
  l_horinitit    NUMBER(5);
  l_datfimtit    DATE;
  l_horfimtit    NUMBER(5);
  l_staacctit    NUMBER(1);
  l_datatu       CHAR(16);
  l_seqatu       NUMBER(2);
  l_seqstr       CHAR(2);
  l_uticcr       CHAR(1);
  l_atucreloc    BOOLEAN;
  l_verplf       NUMBER(3);
  l_nompes       VARCHAR2(40);
  l_ddifon       NUMBER(3);
  l_dddfon       NUMBER(3);
  l_numfon       VARCHAR2(20);
  l_qtdprv       NUMBER(2);
  l_pesblo       NUMBER(1);
  l_desblo       VARCHAR2(30);
  l_conree       NUMBER(1);
  l_conree_str   CHAR(1);
  l_nivatu       CHAR(5);
  l_exit         BOOLEAN;
  l_sitafa_tertur       NUMBER(3);
  l_datafa_tertur       DATE;
  l_horafa_tertur       NUMBER(4);
  l_datter_tertur       DATE;
  l_horter_tertur       NUMBER(4);
  l_usarfa_str   CHAR(1);
  l_usarfa       NUMBER(1);
BEGIN
  /*********** Iniciar montar o IDTPES *****************************/
  IF  p_tipcol < 4 THEN
      SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
  END IF;
  IF  p_tipcol = 5 THEN
      SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes_str||l_numemp||l_numcad;
  END IF;
  IF  p_tipcol = 6 THEN  /* Aluno */
      l_idtpes:= '10'||p_nummat;
  END IF;
  IF   p_tipcol = 7 THEN  /*Responsáveis de alunos*/
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes:= '07'||l_tipdoc||p_numdoc;
  END IF;

  /*Preenche o campo com espaços para completar 23 posições*/
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
      /*Controle do Loop.*/
      IF (Length(l_idtpes) > 22) THEN
          EXIT;
      END IF;
      l_idtpes := ' '||l_idtpes;
  END LOOP;
  /*********** termina de montar o IDTPES *****************************/

  l_qtdpra := 0;
  BEGIN
    SELECT COUNT(B.enable) INTO l_qtdpra FROM R300PRO A, R999AGE B WHERE A.PROAON IN (1,22) AND A.CODAGE = B.CODPRO AND B.ENABLE = 'T';
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'SPCOLCON: Erro no select da tabela R300PRO.';
  END;


  SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

  /* Busca parametro que indica se utiliza compra. */
  BEGIN
     SELECT UTICCR INTO l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_uticcr := 'N';
  END;
  /* Inicializa */
  l_atucreloc := FALSE;
  l_apupfs := 'E';
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  l_segu_atual := SECOND(CURTIME());
  l_idtpes := '';
  l_codig := '      ';
  l_iPerson := FALSE;
  /* data atual no formato string (r070con) */
  SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
  l_seqatu := SECOND(CURTIME());
  SP_INTSTR(l_seqatu, '99', l_seqstr OUT);
  l_datatu := l_datstr||l_horstr||l_seqstr||'0000';
  /* YYMMDDHHMMSEQ0000 */
  l_datatu := SUBSTRING(l_datatu,5,2)||SUBSTRING(l_datatu,3,2)||SUBSTRING(l_datatu,1,2)||SUBSTRING(l_datatu,7,10);
  /* utiliza a variavel de atualização como um update */
  /* isso foi feito para diferenciar o processo autmático 23*/
  l_tipope := p_tipope;

  /*Busca versão do plano ativa*/
  BEGIN
      SELECT VERPLF INTO l_verplf
        FROM R058VPL
       WHERE DATCRI <= l_data_atual
         AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
  EXCEPTION
      WHEN OTHERS THEN
          l_verplf := 1;
  END;

  IF  l_tipope = 'A' THEN
      l_tipope := 'U';
  END IF;
  IF  (p_tipcra = 2) THEN
      l_tippes := 6;
  ELSE
      IF  (p_tipcol = 6) THEN
         l_tippes := 10;
      ELSE
          l_tippes := p_tipcol;
      END IF;
  END IF;
  /* Inicializa Areas Restritas */
  l_grupo1 := '00000';
  l_inigr1 := '          ';
  l_fimgr1 := '          ';
  l_grupo2 := '00000';
  l_inigr2 := '          ';
  l_fimgr2 := '          ';
  l_grupo3 := '00000';
  l_inigr3 := '          ';
  l_fimgr3 := '          ';
  l_iniAR1 := '          ';
  l_fimAR1 := '          ';
  l_iniAR2 := '          ';
  l_fimAR2 := '          ';
  l_iniAR3 := '          ';
  l_fimAR3 := '          ';
  /* Inicializa Controle de Creditos */
  l_fx_ref := '24002400240024002400240024002400240024002400240024002400';
  l_crefx1 := '00';
  l_crefx2 := '00';
  l_crefx3 := '00';
  l_crefx4 := '00';
  l_crefx5 := '00';
  l_crefx6 := '00';
  l_fx1    := '24002400';
  l_fx2    := '24002400';
  l_fx3    := '24002400';
  l_fx4    := '24002400';
  l_fx5    := '24002400';
  l_fx6    := '24002400';
  /* Inicializa Mensagens */
  l_desmsg := ' ';
  l_auxmsg := '                                ';
  l_qtdmsg := ' ';
  l_datmsg := '                ';
  l_conadp     := 'S';
  l_conial     := 'N';
  l_recvis_str := 'N';
  l_recvis     := 0;
  l_ConInt_str := 'N';
  l_conInt_Int := 0;
  l_TolInt     := 0;
  l_temalm     := 0;
  l_confai     := 1;
  l_verprm     := 'S';
  l_conrea_str := 'S';
  l_conrea     := 1;
  l_concre     := 0;
  l_verafa     := 'S';
  l_usabio     := 1;
  l_gracon     := 50;
  l_conpac     := 0;
  l_tempac     := 0;
  l_tolacp     := 0;
  l_anti_dupla := '1';
  l_fx_flg     := '0';
  l_tempo_alm  := '000';
  l_blofal     := 0;
  l_ver_hora   := '1';
  l_ver_local  := '1';
  l_ver_valid  := '1';
  l_ver_afast  := '1';
  l_ver_cred   := '0';
  l_datini     := '      ';
  l_datfim     := '      ';
  l_datahora   := '3112502359';
  l_nomfun := '';
  l_numpis := 0;
  l_qtdprv := 0;
  l_usarfa_str := 'N';
  l_usarfa := 0;

  /*Inicializa Faixas de Acesso*/
  l_faixa := '00002359240024002400240024002400240024002400240024002400';
  /* SE FOR BAIXA DE CRACHÁ, MANDA TIPO DE OPERAÇÃO = 'D' */
  IF ( ( (p_datfim < l_data_atual)
  OR ( (p_datfim = l_data_atual) AND (p_horfim <= l_hora_atual) ) )
  AND (p_datfim <> l_data_zero) ) THEN
    /* verifica validade do crachá */
    SP_DATVAL('D',p_numcra,p_numemp,p_tipcol,p_numcad,p_datfim,p_horfim,l_datahora OUT);
  ELSE
    /* verifica validade do crachá */
    SP_DATVAL(l_tipope,p_numcra,p_numemp,p_tipcol,p_numcad,p_datfim,p_horfim,l_datahora OUT);
  END IF;
  /*obtem a data inicial do crachá*/
  /*Se a data inicial for menor do que 1980, então considera como 01/01/1980*/
  l_datano := Year(p_datini);
  IF (l_datano < 1980) THEN
      l_inival := '0101802359000000';
  ELSE
      SP_DATSTR(p_datini,'DDMMYY',l_datstr OUT);
      SP_INTSTR(p_horini,'HHMM',l_horstr OUT);
      l_inival := l_datstr||l_horstr||'000000';
  END IF;
  /* INSERT em R038HCH */
  IF  (l_tipope = 'I') OR ((l_tipope = 'U') AND (p_status = 1)) THEN
      l_situa      := '0';
      l_cratit     := 0;
      l_codprm     := 0;
      l_prmsab     := 0;
      l_prmdom     := 0;
      l_prmfer     := 0;
      l_codprm_tpe := 0;
      l_prmsab_tpe := 0;
      l_prmdom_tpe := 0;
      l_prmfer_tpe := 0;
      l_crapro     := 0;
      l_subnv      := '99000';
      /* p_tipcol: 4 = Visitantes, 5 = Outras Unidades, 6 = Alunos */
      IF   p_tipcol < 4 THEN /* Colaboradore, Terceiros e Parceiros */
           SP_RETMSC (p_numemp, p_tipcol, p_numcad, l_desmsg OUT, l_datmsg OUT, l_qtdmsg OUT);
           SP_RETCRC (p_numemp, p_tipcol, p_numcad, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
           SP_RETPEC (p_numemp, p_tipcol, p_numcad, p_numcra, l_grupo1 OUT, l_inigr1 OUT, l_fimgr1 OUT, l_grupo2 OUT, l_inigr2 OUT, l_fimgr2 OUT, l_grupo3 OUT, l_inigr3 OUT, l_fimgr3 OUT);
           SP_RETSEN (p_numemp, p_tipcol, p_numcad, l_codig OUT);
      ELSE
           IF   p_tipcol = 5 THEN /* OUTRAS UNIDADES */
                SP_RETMSO (p_numemp, p_numcad, l_desmsg OUT, l_datmsg OUT, l_qtdmsg OUT);
                SP_RETCRO (p_numemp, p_numcad, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
                SP_RETPEO (p_numemp, p_numcad, p_numcra, l_grupo1 OUT, l_inigr1 OUT, l_fimgr1 OUT, l_grupo2 OUT, l_inigr2 OUT, l_fimgr2 OUT, l_grupo3 OUT, l_inigr3 OUT, l_fimgr3 OUT);
           ELSE
                IF   p_tipcol = 6 THEN /* Alunos */
                     SP_RETMSA (p_nummat, l_desmsg OUT, l_datmsg OUT, l_qtdmsg OUT);
                     SP_RETCAA (p_nummat, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
                     SP_RETPEA (p_nummat, p_numcra, l_grupo1 OUT, l_inigr1 OUT, l_fimgr1 OUT, l_grupo2 OUT, l_inigr2 OUT, l_fimgr2 OUT, l_grupo3 OUT, l_inigr3 OUT, l_fimgr3 OUT);
                ELSE
                     IF p_tipcol = 7 THEN /* responsavel de aluno*/
                         SP_RETMSR (p_tipdoc, p_numdoc, l_desmsg OUT, l_datmsg OUT, l_qtdmsg OUT);
                         SP_RETCRR (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
                     END IF;
                END IF;
           END IF;
      END IF;
      l_auxmsg := l_desmsg;
      /* Verifica Cracha Normal ou Provisorio */
      IF  (p_tipcra = 2) THEN
          SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0, p_nummat, p_tipdoc, p_numdoc, l_cratit OUT);
          IF  (l_cratit > 0) THEN
              /* Verifica qual é o crachá Principal e obtem os números físicos */
              SP_MAPFIS(l_cratit, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
              IF (l_crapri = 0) THEN
                  l_crapri := l_cratit;
              END IF;
              /* Copia Dados do Cracha Principal */
              LOOP
                  BEGIN
                      SELECT      CODPRM,PRMSAB,PRMDOM,PRMFER,SENCOL,INIAFA,DATAFA,
                                  MSGACC,DATMSG,QTDMSG,MSGATU,CONINT,TOLINT,
                                  CONIAL,TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,
                                  CREAC1,CREFX1,QTDCR1,
                                  CREAC2,CREFX2,QTDCR2,
                                  CREAC3,CREFX3,QTDCR3,
                                  CREAC4,CREFX4,QTDCR4,
                                  CREAC5,CREFX5,QTDCR5,
                                  CREAC6,CREFX6,QTDCR6,
                                  PRMRT1,DINPR1,DFNPR1,
                                  PRMRT2,DINPR2,DFNPR2,
                                  PRMRT3,DINPR3,DFNPR3,
                                  FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,FAIAC7,
                                  FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,
                                  FAIREF,IDTPES,GRACON,CONPAC,TEMPAC,TOLACP,NOMFUN,
                                  NUMPIS,CONREA,NOMPES,DDIFON,DDDFON,NUMFON,QTDPRV,PESBLO,DESBLO,RECVIS,CONREE,USARFA
                      INTO
                                  l_codprm,l_prmsab,l_prmdom,l_prmfer,
                                  l_codig ,l_iniafa,l_datafa,
                                  l_auxmsg,l_datmsg,l_qtdmsg,l_qtdmsg,l_ConInt_int,l_tolint,
                                  l_fx_flg,l_temalm,l_ver_afast,l_usabio,l_ver_local,l_confai,l_anti_dupla,l_concre,
                                  l_crefx1,l_fx1,l_crefx1,l_crefx2,l_fx2,l_crefx2,
                                  l_crefx3,l_fx3,l_crefx3,l_crefx4,l_fx4,l_crefx4,
                                  l_crefx5,l_fx5,l_crefx5,l_crefx6,l_fx6,l_crefx6,
                                  l_grupo1,l_iniAR1,l_fimAR1,
                                  l_grupo2,l_iniAR2,l_fimAR2,
                                  l_grupo3,l_iniAR3,l_fimAR3,
                                  l_fx_dom_a, l_fx_seg_a, l_fx_ter_a, l_fx_qua_a, l_fx_qui_a, l_fx_sex_a, l_fx_sab_a,
                                  l_fx_dom_p, l_fx_seg_p, l_fx_ter_p, l_fx_qua_p, l_fx_qui_p, l_fx_sex_p, l_fx_sab_p,
                                  l_fx_ref,l_idtpes,l_gracon,l_conpac,l_tempac,l_tolacp,
                                  l_nomfun, l_numpis, l_conrea, l_nompes, l_ddifon, l_dddfon, l_numfon, l_qtdprv, l_pesblo, l_desblo, l_recvis, l_conree, l_usarfa
                      FROM R070CON WHERE NUMFIS = l_crapri;

                      /*Se encontrou o titular, sai do LOOP*/
                      EXIT;
                  EXCEPTION
                      WHEN TOO_MANY_ROWS THEN
                          RAISERROR 103 'SPCOLCON: Erro em R070CON - TOO MANY ROWS';
                          EXIT;
                      WHEN NO_DATA_FOUND THEN
                          EXIT;
                      WHEN OTHERS THEN
                          RAISERROR 103 'SPCOLCON: Erro No SELECT R070CON 1.';
                          EXIT;
                  END;
              END LOOP;
              /* atualiza a tabela r070con */
              SP_RETCRA (2,p_numemp, p_tipcol, p_numcad, 0, p_nummat, p_tipdoc, p_numdoc, l_crapro OUT);
              IF   (l_crapro > 0) THEN
                  l_situa := '1';
              ELSE
                  l_situa := '0';
              END IF;
              /*UPDATE na R070CON.SITCRA*/
              SP_UPDFIS(l_cratit,l_situa,' ');
          END IF;
      ELSE
          /* Verifica se Já Possui um Provisório Ativo */
          SP_RETCRA (2,p_numemp, p_tipcol, p_numcad, 0, p_nummat, p_tipdoc, p_numdoc, l_crapro OUT);
          IF   (l_crapro > 0) THEN
               l_situa := '1';
          END IF;
      END IF;
      /* verifica registros de bloqueio. */
      IF  (p_tipcol < 4) OR (p_tipcol = 6) OR (p_tipcol = 7) THEN /* Colaboradores, Terceiros, Parceiros, Alunos e Responsáveis de alunos*/
           SP_RETBLO (p_numemp, p_tipcol, p_numcad, p_nummat, p_tipdoc, p_numdoc, p_numcra, l_data_atual, l_hora_atual, l_situa OUT);
           IF  (l_situa = 'F') THEN
               l_situa := '0';
               l_blofal := 1;
           ELSE
               l_blofal := 0;
           END IF;
      END IF;
      /* se for titular com provisório sempre bloquear pelo situa */
      IF   (p_tipcra = 1) AND (l_crapro > 0) THEN
           l_situa := '1';
      END IF;
      /* Se incluindo crachá titular */
      IF  p_tipcol < 4 THEN
          /* Carrega Dados */
          l_r064tpe := 1;
          BEGIN
              SELECT CODPRM,PRMSAB,PRMDOM,PRMFER
              INTO l_codprm_tpe,l_prmsab_tpe,l_prmdom_tpe,l_prmfer_tpe
              FROM R064TPE
              WHERE NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND
              ((DATINI < l_data_atual) OR ((DATINI = l_data_atual) AND (HORINI <= l_hora_atual))) AND
              ((DATFIM > l_data_atual) OR (DATFIM = l_data_zero) OR ((DATFIM = l_data_atual) AND (HORFIM >= l_hora_atual)));
          EXCEPTION
              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'Erro em R064TPE - TOO MANY ROWS';
              WHEN NO_DATA_FOUND THEN l_r064tpe := 0;
              WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro no SELECT em R064TPE.';
          END;
          BEGIN
              SELECT CODPRM,PRMSAB,PRMDOM,PRMFER INTO l_codprm, l_prmsab, l_prmdom, l_prmfer
              FROM R034DAC WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
          EXCEPTION
              WHEN TOO_MANY_ROWS THEN
                  l_straux :=  'SPCOLCON : Erro em R034DAC - TOO MANY ROWS. '||
                               ' Num.Emp.: '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                               ' Tip.Col.: '||CONVERT(NUMBER_TO_CHAR,p_tipcol)||
                               ' Num.Cad.: '||CONVERT(NUMBER_TO_CHAR,p_numcad);
                  RAISERROR 103 l_straux;
               WHEN NO_DATA_FOUND THEN
                  l_straux :=  'SPCOLCON : Erro em R034DAC - Colaborador não Cadastrado. '||
                               ' Num.Emp.: '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                               ' Tip.Col.: '||CONVERT(NUMBER_TO_CHAR,p_tipcol)||
                               ' Num.Cad.: '||CONVERT(NUMBER_TO_CHAR,p_numcad);
                  RAISERROR 103 l_straux;
              WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro no SELECT em R034DAC.';
          END;
          /* Se tem programação de troca de permissão, esta sobrepõem as permissões da definição, mesmo que na troca seja por permissão zero */
          IF  (l_r064tpe = 1) THEN
              l_codprm := l_codprm_tpe;
              l_prmsab := l_prmsab_tpe;
              l_prmdom := l_prmdom_tpe;
              l_prmfer := l_prmfer_tpe;
          END IF;
          IF  (l_r064tpe = 0) AND (l_codprm = 0) THEN
              /* retorna o código da escala do colaborador */
              RH_RETESC(p_numemp, p_tipcol, p_numcad, l_data_atual,l_codesc OUT, l_codtma OUT, l_turint OUT, l_coderr OUT, l_temp1 OUT, l_temp2 OUT);
              IF  l_codesc > 0 THEN
                  BEGIN
                      SELECT CODPRM,PRMSAB,PRMDOM,PRMFER INTO l_codprm, l_prmsab, l_prmdom, l_prmfer
                      FROM R006ESC WHERE CODESC = l_codesc;
                  EXCEPTION
                      WHEN NO_DATA_FOUND THEN RAISERROR 103 'Erro em R006ESC - Escala não Cadastrada';
                      WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro no SELECT em R006ESC.';
                  END;
              END IF;
          END IF;
          /* Busca definições do colaborador e de acesso. */
          L_NODATAFOUND:=FALSE;
          /* Busca Nome e PIS a ser preenchido na R070CON */
          /* Para SP e SPV faz consistências diferentes nessa busca */
          /* Para SP retorna para tipcol = 1 ou 2 */
          /* Para SPV, se utilizar Ronda Ponto, consiste CodVin e ConRho */
          SP_REPFUN(p_numemp, p_tipcol, p_numcad, l_nomfun OUT, l_numpis OUT);
          IF (l_nomfun IS NULL) THEN
              l_nomfun := '';
          END IF;
          IF (l_numpis IS NULL) THEN
              l_numpis := 0;
          END IF;
          BEGIN
              SELECT CONADP, CONIAL, TEMALM, CONFAI, VERPRM, CONCRE, VERAFA, USABIO, GRACON,
                     CONINT, TOLINT, CONPAC, TEMPAC, TOLACP, CONREA, RECVIS, CONREE, USARFA
              INTO l_conadp, l_conial, l_temalm, l_confai, l_verprm, l_concre, l_verafa,
                   l_usabio, l_gracon, l_ConInt_str, l_tolint, l_conpac_str, l_tempac, l_tolacp_time,
                   l_conrea_str, l_recvis_str, l_conree_str, l_usarfa_str
              FROM R034DAC WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
          EXCEPTION
              WHEN NO_DATA_FOUND THEN
                               l_conadp := 'S';
                               l_conial := 'N';
                               l_temalm := 0;
                               l_confai := 1;
                               l_verprm := 'S';
                               l_concre := 0;
                               l_verafa := 'S';
                               l_usabio := 1;
                               l_gracon := 50;
                               l_ConInt_str := 'N';
                               l_tolint := 0;
                               l_conpac_str := 'N';
                               l_tempac := 0;
                               l_tolacp_time := 0;
                               l_conrea_str := 'S';
                               l_conrea := 1;
                               l_recvis_str := 'N';
                               l_recvis := 0;
                               l_conree_str := 'N';
                               l_usarfa_str := 'N';
                               L_NODATAFOUND:=TRUE;
              WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro no SELECT em R034DAC.';
          END;
          IF  L_NODATAFOUND = FALSE THEN
              IF  l_conadp = 'S' THEN
                  l_anti_dupla := '1';
              ELSE
                  l_anti_dupla := '0';
              END IF;

              IF  l_conial = 'S' THEN
                  l_fx_flg := '1';
              ELSE
                  l_fx_flg := '0';
              END IF;

              IF  l_conrea_str = 'S' THEN
                  l_conrea := 1;
              ELSE
                  l_conrea := 0;
              END IF;

              IF  l_recvis_str = 'S' THEN
                  l_recvis := 1;
              ELSE
                  l_recvis := 0;
              END IF;

              /*Controle de Inrterjornada*/
              IF l_ConInt_str = 'S' THEN
                  l_ConInt_int := 1;
              ELSE
                  l_ConInt_int := 0;
                  l_TolInt := 0;
              END IF;
              SP_INTSTR(l_temalm,'999',l_tempo_alm OUT);
              SP_INTSTR(l_confai,'9',l_ver_hora OUT);
              IF  l_verprm = 'S' THEN
                  l_ver_local := '1';
              ELSE
                  l_ver_local := '0';
              END IF;

              IF  l_verafa = 'S' THEN
                  l_ver_afast := '1';
              ELSE
                  l_ver_afast := '0';
              END IF;

              IF  l_conpac_str = 'S' THEN
                  l_conpac := 1;
                  IF  l_tolacp_time > 99 THEN
                      l_tolacp := 99;
                  ELSE
                      l_tolacp := l_tolacp_time;
                  END IF;
              ELSE
                  l_conpac := 0;
                  l_tempac := 0;
                  l_tolacp := 0;
              END IF;

              IF  l_conree_str = 'S' THEN
                  l_conree := 1;
              ELSE
                  l_conree := 0;
              END IF;
              
              IF  l_usarfa_str = 'S' THEN
                  l_usarfa := 1;
              ELSE
                  l_usarfa := 0;
              END IF;

              SP_INTSTR(l_concre,'9',l_ver_cred OUT);
          END IF;
          SP_APUCOL(p_numemp, p_tipcol, p_numcad, l_apupfs OUT);
          /*Se o controle for por atividades do professor*/
          IF (l_apupfs = 'A') THEN
              SP_FaiPro (p_numemp, p_tipcol, p_numcad,
                         l_fx_dom_a OUT, l_fx_seg_a OUT, l_fx_ter_a OUT, l_fx_qua_a OUT, l_fx_qui_a OUT, l_fx_sex_a OUT, l_fx_sab_a OUT,
                         l_fx_dom_p OUT, l_fx_seg_p OUT, l_fx_ter_p OUT, l_fx_qua_p OUT, l_fx_qui_p OUT, l_fx_sex_p OUT, l_fx_sab_p OUT,
                         l_fx_ref OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);

          ELSE
              SP_FaiHor (p_numemp, p_tipcol, p_numcad,
                         l_fx_dom_a OUT, l_fx_seg_a OUT, l_fx_ter_a OUT, l_fx_qua_a OUT, l_fx_qui_a OUT, l_fx_sex_a OUT, l_fx_sab_a OUT,
                         l_fx_dom_p OUT, l_fx_seg_p OUT, l_fx_ter_p OUT, l_fx_qua_p OUT, l_fx_qui_p OUT, l_fx_sex_p OUT, l_fx_sab_p OUT,
                         l_fx_ref OUT, l_prmsabequal OUT, l_prmdomequal OUT, l_prmsegequal OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);

              /* sábado */
              IF  l_prmsabequal = 0 THEN  /* Permissão de sabado igual à permissão de dias normais */
                  l_prmsab := l_codprm;
              ELSE
                  IF  l_prmsabequal = 3 THEN  /*  Permissão de sabado igual à permissão de feriado */
                      l_prmsab := l_prmfer;
                  END IF;
              END IF;
              /* domingo */
              IF  l_prmdomequal = 1 THEN  /*  Permissão de domingo igual à permissão de sábado */
                  l_prmdom := l_prmsab;
              ELSE
                  IF  l_prmdomequal = 3 THEN  /*  Permissão de domingo igual à permissão de feriado */
                      l_prmdom := l_prmfer;
                  END IF;
              END IF;
              /* segunda */
              IF  l_prmsegequal = 2 THEN  /*  Permissão de segunda igual à permissão de domingo */
                  l_codprm := l_prmdom;
              ELSE
                  IF  l_prmsegequal = 3 THEN /*  Permissão de segunda igual à permissão de feriado */
                      l_codprm := l_prmfer;
                  END IF;
              END IF;
          END IF;
          /*Obtem o Tipo de Pessoa*/
          SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
          SP_INTSTR(p_numemp,'9999',l_numemp OUT);
          SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
          SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
          l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
      ELSE
          IF  p_tipcol = 5 THEN
              /* Carrega Dados */
              l_codesc := 0;
              l_codtma := 0;
              BEGIN
                  SELECT CODESC,CODTMA,CODPRM,ACEOCR,PRMSAB,PRMDOM,PRMFER,CONFAI,NOMCRA,USARFA INTO
                         l_codesc,l_codtma,l_codprm,l_aceocr,l_prmsab,l_prmdom,l_prmfer,l_confai,l_nompes,l_usarfa_str
                  FROM R070OCR WHERE NUMEMP=p_numemp AND NUMCAD=p_numcad;
              EXCEPTION
                   WHEN NO_DATA_FOUND THEN
                       l_straux :=  'SPCOLCON : Não achou cadastro em Outras Unidades. '||
                                    ' Num.Emp.: '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                                    ' Num.Cad.: '||CONVERT(NUMBER_TO_CHAR,p_numcad);
                       RAISERROR 103 l_straux;
                   WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no SELECT em R070OCR.';
              END;
              /* Verifica se existe uma troca de permissão para o colaborador outra unidade */
              l_prmprg:=0;
              l_sabprg:=0;
              l_domprg:=0;
              l_ferprg:=0;
              l_recvis := 0;
              L_NODATAFOUND:=FALSE;
              BEGIN
                  SELECT CODPRM,PRMSAB,PRMDOM,PRMFER INTO l_prmprg,l_prmsab,l_prmdom,l_prmfer FROM R070TPE
                  WHERE NUMEMP=p_numemp AND NUMCAD=p_numcad AND
                  ((DATINI < l_data_atual) OR ((DATINI = l_data_atual) AND (HORINI <= l_hora_atual))) AND
                  ((DATFIM > l_data_atual) OR (DATFIM = l_data_zero) OR ((DATFIM = l_data_atual) AND (HORFIM >= l_hora_atual)));
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'Erro em R070TPE - TOO MANY ROWS';
                  WHEN NO_DATA_FOUND THEN L_NODATAFOUND:=TRUE;
                                          l_prmprg:=0;
                                          l_sabprg:=0;
                                          l_domprg:=0;
                                          l_ferprg:=0;
                  WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no SELECT em R070TPE.';
              END;

              IF  l_prmprg <> 0 THEN
                  l_codprm := l_prmprg;
              END IF;
              IF  l_sabprg <> 0 THEN
                  l_prmsab := l_sabprg;
              END IF;
              IF  l_domprg <> 0 THEN
                  l_prmdom := l_domprg;
              END IF;
              IF  l_ferprg <> 0 THEN
                  l_prmfer := l_ferprg;
              END IF;
              /* Se não tem provisório verifica se esta c/ acesso bloqueado  */
              l_situa := '0';
              IF  l_aceocr = 2 THEN
                  l_situa := '1';
              END IF;
              /* Busca definições de créditos de acesso para colaborador de outra unidade. */
              BEGIN
                  SELECT CREOCR INTO l_concre FROM R070DAC;
              EXCEPTION
                  WHEN OTHERS THEN l_concre := 0;
              END;
              SP_INTSTR(l_concre,'9',l_ver_cred OUT);

              SP_FaiOcr (p_numemp, p_numcad, l_codesc, l_codtma,
                         l_fx_dom_a OUT, l_fx_seg_a OUT, l_fx_ter_a OUT, l_fx_qua_a OUT, l_fx_qui_a OUT, l_fx_sex_a OUT, l_fx_sab_a OUT,
                         l_fx_dom_p OUT, l_fx_seg_p OUT, l_fx_ter_p OUT, l_fx_qua_p OUT, l_fx_qui_p OUT, l_fx_sex_p OUT, l_fx_sab_p OUT,
                         l_fx_ref OUT);

              /* Assinala na tabela Controle que o Colab. de Outra Unidade utiliza reconhecimento facial */
              IF l_usarfa_str = 'S' THEN
                  l_usarfa := 1;
              ELSE
                  l_usarfa := 0;
              END IF;

              /*Obtem o Tipo de Pessoa*/
              SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
              SP_INTSTR(p_numemp,'9999',l_numemp OUT);
              SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
              l_idtpes:= l_tippes_str||l_numemp||l_numcad;
          ELSE
              IF  p_tipcol = 6 THEN
                  /* Definições de créditos de acesso para alunos. */
                  l_anti_dupla := '1';
                  l_fx_flg     := '0';
                  l_tempo_alm  := '000';
                  l_blofal     := 0;
                  l_confai   := '2'; /* controle de faixa para alunos default */
                  l_ver_local  := '1';
                  l_ver_valid  := '1';
                  l_ver_afast  := '1';
                  l_conrea := 0;
                  l_recvis_str := 'N';
                  l_recvis := 0;
                  /* Busca definições de créditos de acesso para colaborador de outra unidade. */
                  BEGIN
                      SELECT CREALU INTO l_concre FROM R070DAC;
                  EXCEPTION
                      WHEN OTHERS THEN l_concre := 0;
                  END;
                  SP_INTSTR(l_concre,'9',l_ver_cred OUT);

                  l_codprm := 0;
                  l_prmsab := 0;
                  l_prmdom := 0;
                  l_prmfer := 0;
                  BEGIN
                      SELECT CODPRM, PRMSAB, PRMDOM, PRMFER, USABIO, GRACON, CONTPM, CONADP, CONREE, USARFA
                      INTO l_codprm, l_prmsab, l_prmdom, l_prmfer, l_usabio, l_gracon, l_conpac_str, l_conadp, l_conree_str, l_usarfa_str
                      FROM R073ALU WHERE NUMMAT = p_nummat;
                  EXCEPTION
                      WHEN OTHERS THEN NULL;
                  END;

                  SP_FaiAlu (p_nummat,
                             l_fx_dom_a OUT, l_fx_seg_a OUT, l_fx_ter_a OUT, l_fx_qua_a OUT, l_fx_qui_a OUT, l_fx_sex_a OUT, l_fx_sab_a OUT,
                             l_fx_dom_p OUT, l_fx_seg_p OUT, l_fx_ter_p OUT, l_fx_qua_p OUT, l_fx_qui_p OUT, l_fx_sex_p OUT, l_fx_sab_p OUT,
                             l_fx_ref OUT);

                  IF (l_fx_dom_a = '') OR (l_fx_dom_a IS NULL) THEN
                    l_fx_dom_a := l_faixa;
                  END IF;
                  IF (l_fx_seg_a = '') OR (l_fx_seg_a IS NULL) THEN
                    l_fx_seg_a := l_faixa;
                  END IF;
                  IF (l_fx_ter_a = '') OR (l_fx_ter_a IS NULL) THEN
                    l_fx_ter_a := l_faixa;
                  END IF;
                  IF (l_fx_qua_a = '') OR (l_fx_qua_a IS NULL) THEN
                    l_fx_qua_a := l_faixa;
                  END IF;
                  IF (l_fx_qui_a = '') OR (l_fx_qui_a IS NULL) THEN
                    l_fx_qui_a := l_faixa;
                  END IF;
                  IF (l_fx_sex_a = '') OR (l_fx_sex_a IS NULL) THEN
                    l_fx_sex_a := l_faixa;
                  END IF;
                  IF (l_fx_sab_a = '') OR (l_fx_sab_a IS NULL) THEN
                    l_fx_sab_a := l_faixa;
                  END IF;
                  IF (l_fx_dom_p = '') OR (l_fx_dom_p IS NULL) THEN
                    l_fx_dom_p := l_faixa;
                  END IF;
                  IF (l_fx_seg_p = '') OR (l_fx_seg_p IS NULL) THEN
                    l_fx_seg_p := l_faixa;
                  END IF;
                  IF (l_fx_ter_p = '') OR (l_fx_ter_p IS NULL) THEN
                    l_fx_ter_p := l_faixa;
                  END IF;
                  IF (l_fx_qua_p = '') OR (l_fx_qua_p IS NULL) THEN
                    l_fx_qua_p := l_faixa;
                  END IF;
                  IF (l_fx_qui_p = '') OR (l_fx_qui_p IS NULL) THEN
                    l_fx_qui_p := l_faixa;
                  END IF;
                  IF (l_fx_sex_p = '') OR (l_fx_sex_p IS NULL) THEN
                    l_fx_sex_p := l_faixa;
                  END IF;
                  IF (l_fx_sab_p = '') OR (l_fx_sab_p IS NULL) THEN
                    l_fx_sab_p := l_faixa;
                  END IF;
                  IF (l_fx_ref = '') OR (l_fx_ref IS NULL) THEN
                    l_fx_ref   := l_faixa;
                  END IF;
                  IF (l_conpac_str = 'S') THEN
                    l_conpac := 1;
                    /* Busca definições do tempo de permanência de aluno na R070DAC. */
                    BEGIN
                        SELECT TEMPRA INTO l_tempac FROM R070DAC;
                    EXCEPTION
                        WHEN OTHERS THEN l_tempac := 0;
                    END;
                  ELSE
                    l_conpac := 0;
                    l_tempac := 0;
                  END IF;

                  IF  l_conadp = 'S' THEN
                      l_anti_dupla := '1';
                  ELSE
                      l_anti_dupla := '0';
                  END IF;

                  IF (l_conree_str = 'S') THEN
                    l_conree := 1;
                  ELSE
                    l_conree := 0;
                  END IF;

                  /* Assinala na tabela Controle que o Aluno utiliza reconhecimento facial */
                  IF l_usarfa_str = 'S' THEN
                      l_usarfa := 1;
                  ELSE
                      l_usarfa := 0;
                  END IF;

                  l_idtpes:= '10'||p_nummat;
              ELSE
                  IF  p_tipcol = 7 THEN  /*Responsáveis de alunos*/
                       /* Definições de créditos de acesso para alunos. */
                       l_anti_dupla := '1';
                       l_fx_flg     := '0';
                       l_tempo_alm  := '000';
                       l_blofal     := 0;
                       l_confai     := '2'; /* controle de faixa para alunos default */
                       l_ver_local  := '1';
                       l_ver_valid  := '1';
                       l_ver_afast  := '1';
                       l_recvis_str := 'N';
                       /* Busca definições de créditos de acesso para colaborador de outra unidade. */
                       BEGIN
                           SELECT CRERES INTO l_concre FROM R070DAC;
                       EXCEPTION
                           WHEN OTHERS THEN l_concre := 0;
                       END;
                       SP_INTSTR(l_concre,'9',l_ver_cred OUT);
                       l_codprm := 0;
                       l_prmsab := 0;
                       l_prmdom := 0;
                       l_prmfer := 0;
                       BEGIN
                           SELECT CODPRM, PRMSAB, PRMDOM, PRMFER, USABIO, GRACON, CONTPM, CONADP, CONREE, USARFA
                           INTO l_codprm, l_prmsab, l_prmdom, l_prmfer, l_usabio, l_gracon, l_conpac_str, l_conadp, l_conree_str, l_usarfa_str
                           FROM R073RES WHERE TIPDOC = p_tipdoc AND NUMDOC = p_numdoc;
                       EXCEPTION
                           WHEN OTHERS THEN NULL;
                       END;
                       SP_FaiRes (p_tipdoc, p_numdoc,
                                  l_fx_dom_a OUT, l_fx_seg_a OUT, l_fx_ter_a OUT, l_fx_qua_a OUT, l_fx_qui_a OUT, l_fx_sex_a OUT, l_fx_sab_a OUT,
                                  l_fx_dom_p OUT, l_fx_seg_p OUT, l_fx_ter_p OUT, l_fx_qua_p OUT, l_fx_qui_p OUT, l_fx_sex_p OUT, l_fx_sab_p OUT,
                                  l_fx_ref OUT);

                       SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
                       l_idtpes:= '07'||l_tipdoc||p_numdoc;

                       IF (l_conpac_str = 'S') THEN
                         l_conpac := 1;
                         /* Busca definições do tempo de permanência de aluno na R070DAC. */
                         BEGIN
                             SELECT TEMPRR INTO l_tempac FROM R070DAC;
                         EXCEPTION
                             WHEN OTHERS THEN l_tempac := 0;
                         END;
                       ELSE
                         l_conpac := 0;
                         l_tempac := 0;
                       END IF;

                       IF (l_conree_str = 'S') THEN
                         l_conree := 1;
                       ELSE
                         l_conree := 0;
                       END IF;

                       IF  l_conadp = 'S' THEN
                           l_anti_dupla := '1';
                       ELSE
                           l_anti_dupla := '0';
                       END IF;

                       /* Assinala na tabela Controle que o Resp. de Aluno utiliza reconhecimento facial */
                       IF l_usarfa_str = 'S' THEN
                           l_usarfa := 1;
                       ELSE
                           l_usarfa := 0;
                       END IF;
                  END IF;
              END IF;
          END IF;
      END IF;
      /* Carrega Dados */
      BEGIN
          SP_INTSTR(l_codprm,'99999',l_grupo OUT);
          SP_INTSTR(l_prmsab,'99999',l_grupo_sab OUT);
          SP_INTSTR(l_prmdom,'99999',l_grupo_dom OUT);
          SP_INTSTR(l_prmfer,'99999',l_grupo_fer OUT);
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SPCOLCON : Permissao deve ter valor de 0 a 999';
      END;
      /*Inicializações*/
      IF  (l_grupo1 = '     ') THEN
          l_grupo1 := '00000';
      END IF;
      l_iniAR1 := l_inigr1;
      IF  (l_inigr1 = '          ') THEN
          l_iniAR1 := '0000000000';
      END IF;
      l_fimAR1 := l_fimgr1;
      IF  (l_fimgr1 = '          ') THEN
          l_fimAR1 := '0000000000';
      END IF;
      IF  (l_grupo2 = '     ') THEN
          l_grupo2 := '00000';
      END IF;
      l_iniAR2 := l_inigr2;
      IF  (l_inigr2 = '          ') THEN
          l_iniAR2 := '0000000000';
      END IF;
      l_fimAR2 := l_fimgr2;
      IF  (l_fimgr2 = '          ') THEN
          l_fimAR2 := '0000000000';
      END IF;
      IF  (l_grupo3 = '     ') THEN
          l_grupo3 := '00000';
      END IF;
      l_iniAR3 := l_inigr3;
      IF  (l_inigr3 = '          ') THEN
          l_iniAR3 := '0000000000';
      END IF;
      l_fimAR3 := l_fimgr3;
      IF  (l_fimgr3 = '          ') THEN
          l_fimAR3 := '0000000000';
      END IF;
      IF (l_datmsg  = '                ') THEN
         l_datmsg  := '0000000000000000';
      END IF;
      IF (l_datfim = '      ') THEN
          l_iniafa := '0000000000000000';
          l_datafa := '0000000000000000';
      ELSE
          l_iniafa := l_datini||l_horini||'000000';
          l_datafa := l_datfim||l_horfim||'000000';
      END IF;
      l_auxval := l_datahora||'000000';
      /* variável para comparar se a validade esta vencida no formato YYMMDDHHMMSEQ0000 */
      l_valven := SUBSTRING(l_auxval,5,2)||SUBSTRING(l_auxval,3,2)||SUBSTRING(l_auxval,1,2)||SUBSTRING(l_auxval,7,10);

      /*Preenche o campo com espaços para completar 23 posições*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_idtpes) > 22) THEN
              EXIT;
          END IF;
          l_idtpes := ' '||l_idtpes;
      END LOOP;
      /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
      SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
      IF (l_crapri = 0) THEN
          l_crapri := p_numcra;
          /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
          l_teccra := 1;
      ELSE
          l_teccra := l_tecpri;
      END IF;
      /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
      BEGIN
          SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON
           WHERE IDTPES = l_idtpes AND SITCRA = 0 AND ( SUBSTRING(DATVAL,5,2)
                                                      ||SUBSTRING(DATVAL,3,2)
                                                      ||SUBSTRING(DATVAL,1,2)
                                                      ||SUBSTRING(DATVAL,7,10) > l_datatu
                                                    OR DATVAL = '3112502359000000');
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No SELECT R070CON (IdtPes).';
      END;
      IF (l_qtdIdtPes > 0) THEN
          l_iPerson := FALSE;
      ELSE
          l_iPerson := TRUE;
      END IF;
      /*Atualização da R070CON*/
      L_NODATAFOUND:=FALSE;
      BEGIN
          SELECT NUMFIS INTO l_craaux FROM R070CON WHERE NUMFIS = l_crapri;
      EXCEPTION
          WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SPCOLCON: Erro em Controle - TOO MANY ROWS';
          WHEN NO_DATA_FOUND THEN L_NODATAFOUND:=TRUE;
          WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No SELECT R070CON 2.';
      END;
      /* verifica se possui registros na tabela R090VAU.. Se possuir, ValAut = 1 */
      l_count := 0;
      BEGIN
          SELECT COUNT(*) INTO l_count FROM R090VAU WHERE IDTPES = l_idtpes AND
                 (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                 (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No SELECT R090VAU (IdtPes).';
      END;
      /* necessita de validação por autorizador */
      l_ValAut := 0;
      IF  (l_count > 0) THEN
          l_ValAut := 1;
      END IF;
      /*Inicializa o tipo e o documento*/
      l_numdoccol := '0';
      l_tipdoccol := 0;
      l_numcpf := 0;
      l_numpsp := '0';
      /*Só entra se for empregado, terceiro e parceiro*/
      IF (p_tipcol < 4) THEN
          /*Busca o CPF e o Passaporte do colaborador*/
          BEGIN
              SELECT NUMCPF, NUMPSP INTO l_numcpf, l_numpsp FROM R034FUN WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
          EXCEPTION
              WHEN OTHERS THEN
                  l_numcpf := 0;
                  l_numpsp := ' ';
          END;

          IF (l_numcpf <> 0) THEN
              l_tipdoccol := 2;
              l_numdoccol := CONVERT(NUMBER_TO_CHAR,l_numcpf);
          ELSE
              IF (l_numpsp <> ' ') AND (l_numpsp <> '0') THEN
                  l_tipdoccol := 4;
                  l_numdoccol := l_numpsp;
              END IF;
          END IF;
          IF (p_tipcra = 1) THEN
		      l_staseg := 2;
              BEGIN
                  SELECT STAATU INTO l_staseg FROM R038HCH WHERE R038HCH.TIPCRA = 2 AND R038HCH.NUMEMP = p_numemp AND R038HCH.TIPCOL = p_tipcol AND R038HCH.NUMCAD = p_numcad AND STAATU = 1;
              EXCEPTION
                  WHEN OTHERS THEN l_staseg := 2;
              END;
              IF (l_qtdpra = 0) AND (l_staseg = 1) THEN
                  l_situa := '1';
		      END IF;
		  END IF;
      END IF;

      /* Para aluno, verifica também o documento */
      IF (p_tipcol = 6)  THEN
          BEGIN
              SELECT NUMCPF, NUMDOC INTO l_numcpf, l_numdoccol  FROM R073ALU WHERE NUMMAT = p_nummat;
          EXCEPTION
              WHEN OTHERS THEN
                  l_numcpf := 0;
                  l_numdoccol := ' ';
          END;
          IF (l_numcpf <> 0) THEN
              l_tipdoccol := 2;
              l_numdoccol := CONVERT(NUMBER_TO_CHAR,l_numcpf);
          ELSE
              IF (l_numdoccol <> ' ') AND (l_numdoccol <> '0') THEN
                  l_tipdoccol := 1;
              END IF;
          END IF;
		  IF (p_tipcra = 1) THEN
		      l_staseg := 2;
              BEGIN
                  SELECT STAATU INTO l_staseg FROM R073HCH WHERE R073HCH.TIPCRA = 2 AND R073HCH.NUMMAT = p_nummat AND STAATU = 1;
              EXCEPTION
		          WHEN OTHERS THEN l_staseg := 2;
              END;
              IF (l_qtdpra = 0) AND (l_staseg = 1) THEN
                  l_situa := '1';
		      END IF;
		  END IF;
      END IF;

	  IF (p_tipcol = 5) THEN
	      IF (p_tipcra = 1) THEN
		      l_staseg := 2;
              BEGIN
                  SELECT STAATU INTO l_staseg FROM R070HCH WHERE R070HCH.TIPCRA = 2 AND R070HCH.NUMEMP = p_numemp AND R070HCH.NUMCAD = p_numcad AND STAATU = 1;
              EXCEPTION
                  WHEN OTHERS THEN l_staseg := 2;
              END;
              IF (l_qtdpra = 0) AND (l_staseg = 1) THEN
                  l_situa := '1';
	          END IF;
		  END IF;
      END IF;

      SP_VERBLO(l_IdtPes, l_pesblo OUT, l_desblo OUT);
      SP_QTDPRV(l_IdtPes, l_QtdPrv OUT);

      /*Verifica crachá extraviado */
	  BEGIN
	       SELECT NUMCRA INTO l_craext FROM R090CEX WHERE NUMCRA = p_numcra;
	  EXCEPTION
	       WHEN OTHERS THEN l_craext := 0;
	  END;

	  IF (p_numcra = l_craext) THEN
	      l_situa := '1';
	  END IF;

	  /*Se encontrou o crachá vai verificar se achou a pessoa */
	  IF (L_NODATAFOUND = FALSE) THEN
	      l_qtdIdtPes := 0;
	      BEGIN
	          SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON WHERE IDTPES = l_idtpes;
	      EXCEPTION
	          WHEN OTHERS THEN l_qtdIdtPes := 0;
	      END;

		  /*Se não achou a pessoa, deleta o crachá e seta que não encontrou o crachá */
		  IF (l_qtdIdtPes = 0) THEN
		      l_iPerson := TRUE;
		      L_NODATAFOUND := TRUE;
		      BEGIN
		          DELETE FROM R070CON WHERE NUMFIS = l_crapri;
   	          EXCEPTION
	              WHEN OTHERS THEN l_iPerson     := FALSE;      /* não conseguiu deletar mas mantém a atualização*/
                                   L_NODATAFOUND := FALSE;
	          END;
		  END IF;
	  END IF;

      l_exit := FALSE;
      IF  (L_NODATAFOUND = TRUE) THEN
          /* Só insere crachá se não estiver com validade vencida */
          /* a validade vencida vai ser atualizada se o registro existir, mas se não existir ainda não precisa ser inserido na R070CON */
          /* senão isso só ia gerar pendências desnecessárias */
          IF ((l_valven > l_datatu) AND (l_valven <> '3112502359000000')) OR
              (l_valven = '3112502359000000') THEN
              l_exit := FALSE;
          ELSE
              GOTO continue_LOOP;
          END IF;
      ELSE
          l_exit := FALSE;
      END IF;

      IF  (L_NODATAFOUND = TRUE) THEN
          BEGIN
              INSERT INTO R070CON(
                          NUMCRA,NUMFIS,TIPCRA,SITCRA,NIVATU,DATNIV,HORNIV,SEQNIV,
                          INIVAL,DATVAL,CODPRM,PRMSAB,PRMDOM,PRMFER,SENCOL,
                          INIAFA,DATAFA,MSGACC,DATMSG,QTDMSG,MSGATU,
                          CONIAL,TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,
                          CONCRE,CONPAC,TEMPAC,TOLACP,BLOAUT,BLOFAL,
                          CREAC1,CREFX1,QTDCR1,
                          CREAC2,CREFX2,QTDCR2,
                          CREAC3,CREFX3,QTDCR3,
                          CREAC4,CREFX4,QTDCR4,
                          CREAC5,CREFX5,QTDCR5,
                          CREAC6,CREFX6,QTDCR6,
                          PRMRT1,DINPR1,DFNPR1,
                          PRMRT2,DINPR2,DFNPR2,
                          PRMRT3,DINPR3,DFNPR3,
                          FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,FAIAC7,
                          FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,
                          FAIREF,TECCRA,CHCPRI,IDTPES,GRACON,CONINT,TOLINT,VALAUT,
                          NOMFUN,NUMPIS,CONREA,TIPDOC,NUMDOC,NOMPES,DDIFON,DDDFON,NUMFON,QTDPRV,
                          PESBLO,DESBLO,RECVIS,CONREE,NUMEMP,TIPCOL,NUMCAD,NUMMAT,PROPAC,NUMCAN,
                          PROPRE,USARFA)
              VALUES(
                          p_numcra,l_crapri,l_tippes,l_situa,l_subnv,l_data_atual,
                          l_hora_atual,l_segu_atual,l_inival,l_auxval,
                          l_codprm,l_prmsab,l_prmdom,l_prmfer,
                          l_codig ,l_iniafa,l_datafa,
                          l_auxmsg,l_datmsg,l_qtdmsg,l_qtdmsg,
                          l_fx_flg,l_temalm,l_ver_afast,l_usabio,l_ver_local,l_confai,l_anti_dupla,
                          l_concre,l_conpac,l_tempac,l_tolacp,0,l_blofal,
                          l_crefx1,l_fx1,l_crefx1,l_crefx2,l_fx2,l_crefx2,
                          l_crefx3,l_fx3,l_crefx3,l_crefx4,l_fx4,l_crefx4,
                          l_crefx5,l_fx5,l_crefx5,l_crefx6,l_fx6,l_crefx6,
                          l_grupo1,l_iniAR1,l_fimAR1,
                          l_grupo2,l_iniAR2,l_fimAR2,
                          l_grupo3,l_iniAR3,l_fimAR3,
                          l_fx_dom_a, l_fx_seg_a, l_fx_ter_a, l_fx_qua_a, l_fx_qui_a, l_fx_sex_a, l_fx_sab_a,
                          l_fx_dom_p, l_fx_seg_p, l_fx_ter_p, l_fx_qua_p, l_fx_qui_p, l_fx_sex_p, l_fx_sab_p,
                          l_fx_ref,l_teccra,0,l_idtpes,l_gracon,l_conInt_Int,l_tolInt,l_ValAut,
                          l_nomfun, l_numpis, l_conrea, l_tipdoccol, l_numdoccol, l_nompes, l_ddifon, l_dddfon, l_numfon, l_qtdprv,
                          l_pesblo, l_desblo, l_recvis, l_conree, p_numemp, p_tipcol, p_numcad, p_nummat, '0', 0,
                          0, l_usarfa);
          EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'SPCOLCON: Erro no INSERT Tabela R070CON.';
          END;
      ELSE
          BEGIN
              UPDATE R070CON SET
                     NUMCRA=p_numcra, TIPCRA=l_tippes, SENCOL= l_codig,
                     CODPRM=l_codprm, PRMSAB=l_prmsab, PRMDOM=l_prmdom, PRMFER=l_prmfer,
                     SITCRA=l_situa, INIVAL=l_inival,DATVAL=l_auxval, INIAFA=l_iniafa, DATAFA= l_datafa,
                     MSGACC=l_desmsg, DATMSG=l_datmsg, QTDMSG=l_qtdmsg,
                     CONIAL=l_fx_flg, TEMALM=l_temalm, VERAFA=l_ver_afast,
                     USABIO=l_usabio, GRACON=l_gracon, VERPRM=l_ver_local, CONFAI=l_confai,
                     CONADP=l_anti_dupla, CONCRE=l_concre,
                     PRMRT1=l_grupo1, DINPR1=l_iniAR1, DFNPR1=l_fimAR1,
                     PRMRT2=l_grupo2, DINPR2=l_iniAR2, DFNPR2=l_fimAR2,
                     PRMRT3=l_grupo3, DINPR3=l_iniAR3, DFNPR3=l_fimAR3,
                     FAIAC1=l_fx_dom_a,FAIAC2=l_fx_seg_a,FAIAC3=l_fx_ter_a,FAIAC4=l_fx_qua_a,
                     FAIAC5=l_fx_qui_a,FAIAC6=l_fx_sex_a,FAIAC7=l_fx_sab_a,
                     FAIPT1=l_fx_dom_p,FAIPT2=l_fx_seg_p,FAIPT3=l_fx_ter_p,FAIPT4=l_fx_qua_p,
                     FAIPT5=l_fx_qui_p,FAIPT6=l_fx_sex_p,FAIPT7=l_fx_sab_p,
                     FAIREF=l_fx_ref,TECCRA=l_teccra,CHCPRI=0,IDTPES=l_idtpes,
                     CONINT=l_conInt_Int,TOLINT=l_tolint,CONPAC=l_conpac,TEMPAC=l_tempac,
                     TOLACP=l_tolacp,BLOFAL=l_blofal,VALAUT=l_ValAut,
                     NOMFUN=l_nomfun,NUMPIS=l_numpis,CONREA=l_conrea,TIPDOC=l_tipdoccol,NUMDOC=l_numdoccol,
                     NOMPES=IFNULL(l_nompes,NOMPES),DDIFON=IFNULL(l_ddifon,DDIFON),
                     DDDFON=IFNULL(l_dddfon,DDDFON),NUMFON=IFNULL(l_numfon,NUMFON),QTDPRV=l_qtdprv,
                     RECVIS=l_recvis,CONREE=l_conree,NUMEMP=p_numemp,TIPCOL=p_tipcol,NUMCAD=p_numcad,
                     NUMMAT=p_nummat,PROPAC='0',NUMCAN=0,PESBLO=l_pesblo,BLOAUT=0,USARFA=l_usarfa
              WHERE NUMFIS = l_crapri;
          EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'SPCOLCON: Erro Na Atualização de R070CON 1.';
          END;
          IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
              IF (p_tipcol < 4) OR (p_tipcol = 5) OR (p_tipcol = 6) OR (p_tipcol = 7) THEN
                  l_atucreloc := TRUE; /* marca como atualizado os créditos da pessoa */
                  /*reseta os créditos da pessoa*/
                  SP_RESETCRED(p_tipcol, p_numemp, p_tipcol, p_numcad, p_tipdoc, p_numdoc, p_nummat, '0');
              END IF;
          END IF;
          IF (p_subnv = 1) THEN
              BEGIN
                  SELECT NIVATU INTO l_nivAtu FROM R070CON WHERE IDTPES = l_idtpes AND NUMFIS = l_crapri;
              EXCEPTION
                  WHEN OTHERS THEN l_nivAtu := '00000';
              END;

              /* Gera pendência de atualização de nível só se houve alteração de valor */
              IF (l_nivAtu <> '99000') THEN
                  BEGIN
                      UPDATE R070CON SET
                           NIVATU = '99000', DATNIV = l_data_atual, HORNIV = l_hora_atual, SEQNIV = l_segu_atual
                      WHERE IDTPES = l_idtpes;

                      SP_PEND26(l_idtpes, '99000', l_data_atual, l_hora_atual, l_segu_atual);
                  EXCEPTION
                      WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro Na Atualização de R070CON.NIVATU.';
                  END;
              END IF;
          END IF;
          /* Se nào for Colaborador de Outra Unidade, entào atualiza a tabela de funçoes restritas do acesso. */
          IF  p_tipcol < 4 THEN
              SP_AtuContFunc(l_tipope,p_numemp, p_tipcol, p_numcad, p_numcra);
          END IF;
      END IF;
      IF (L_INIAFA <> '0000000000000000') THEN
        BEGIN
          SELECT A.SITAFA, A.DATAFA, A.HORAFA, A.DATTER, A.HORTER INTO
                 L_SITAFA_TERTUR, L_DATAFA_TERTUR, L_HORAFA_TERTUR, L_DATTER_TERTUR, L_HORTER_TERTUR
          FROM R038AFA A, R010SIT B
          WHERE A.NUMEMP = P_NUMEMP AND A.TIPCOL = P_TIPCOL AND A.NUMCAD = P_NUMCAD AND
                (A.DATTER >= L_DATA_ATUAL OR A.DATTER = L_DATA_ZERO) AND
                A.DATAFA <= L_DATA_ATUAL AND A.SITAFA = B.CODSIT AND B.TIPSIT <> 7;
          IF (L_SITAFA_TERTUR > 0) THEN
              SP_HISAFA('U', P_NUMEMP ,P_TIPCOL ,P_NUMCAD ,L_DATAFA_TERTUR, L_HORAFA_TERTUR, L_DATTER_TERTUR, L_HORTER_TERTUR, L_SITAFA_TERTUR, L_DATTER_TERTUR, L_HORTER_TERTUR, L_SITAFA_TERTUR);
          END IF;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;
      END IF;
      /*Atualiza Pend_Grupo*/
      IF (l_numsma > 0) THEN
          /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
          IF (l_tecpri = 3) THEN
              SP_ATUPRM(p_numcra, l_numsma, l_codprm, l_grupo1, l_grupo2, l_grupo3, l_prmsab, l_prmdom, l_prmfer);
          ELSE
              SP_ATUPRM(l_crapri, l_numsma, l_codprm, l_grupo1, l_grupo2, l_grupo3, l_prmsab, l_prmdom, l_prmfer);
          END IF;
      END IF;
      /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
      IF ((L_NODATAFOUND = TRUE) AND (l_iPerson = FALSE)) THEN
          SP_PEND21(l_crapri);
      END IF;
      /*Atualiza os demais Crachás*/
      /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
      IF (l_tecpri = 1) THEN
          /*Atualiza o crachá de proximidade*/
          IF (l_numpro <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numpro, l_numpro_ret OUT);
              /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tippes,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_prmsab,l_prmdom,l_prmfer,l_grupo1,l_grupo2,l_grupo3,l_blofal,
                        l_numpis, l_nomfun, l_ver_local);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numpro);
              END IF;
          END IF;
          /*Atualiza o crachá Smart*/
          IF (l_numsma <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numsma, l_numsma_ret OUT);
              /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tippes,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_prmsab,l_prmdom,l_prmfer,l_grupo1,l_grupo2,l_grupo3,l_blofal,
                        l_numpis, l_nomfun, l_ver_local);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numsma);
              END IF;
          END IF;
      /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
      ELSIF (l_tecpri = 2) THEN
          /*Atualiza o crachá Smart*/
          IF (l_numsma <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numsma, l_numsma_ret OUT);
              /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tippes,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_prmsab,l_prmdom,l_prmfer,l_grupo1,l_grupo2,l_grupo3,l_blofal,
                        l_numpis, l_nomfun, l_ver_local);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numsma);
              END IF;
          END IF;
      END IF;
      /*Verifica se Gera o Comando IncludePerson*/
      IF (l_iPerson = TRUE) THEN
          /*Gera o Include Person*/
          SP_PEND19(p_numcra, l_idtpes);
          /*Atualiza os créditos somente se o mesmo já não foi atualizado*/
          IF (l_atucreloc = FALSE) THEN
              /*Atualiza os créditos sem local físico*/
              SP_PEND06(1, l_idtpes, l_verplf, 0);
              /*Atualiza os créditos por local físico da pessoa*/
              SP_ATUCRELOC(l_idtpes);
          END IF;
      END IF;
      /* verifica se tem outros crachás (mestre e autorização de entrada) */
      IF  p_tipcol < 4 THEN /* Colaboradore, Terceiros e Parceiros */
          /* autorização de entrada */
          l_numcra := 0;
          BEGIN
              SELECT NUMCRA, CODPRM, DATENT, HORENT, DATVAL, HORVAL
              INTO l_numcra, l_grupo, l_datent, l_horent, l_datval, l_horval FROM R071AEN WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                     ((DATENT < l_data_atual) OR ((DATENT = l_data_atual) AND (HORENT <= l_hora_atual))) AND
                     (
                     ((DATSAI > l_data_atual) OR (DATSAI = l_data_zero) OR ((DATSAI = l_data_atual) AND (HORSAI > l_hora_atual)))
                     AND
                     ((DATVAL > l_data_atual) OR (DATVAL = l_data_zero) OR ((DATVAL = l_data_atual) AND (HORVAL > l_hora_atual)))
                     ); /*Ambas as datas tem que estar em aberto*/

          EXCEPTION
              WHEN NO_DATA_FOUND THEN l_numcra := 0;
              WHEN OTHERS THEN  l_numcra := 0;
          END;
          IF  (l_numcra > 0) THEN
              AtuSitCra('1',p_numcra);
          END IF;
          /* crachá mestre */
          l_numcra := 0;
          BEGIN
              SELECT NUMCRA, DATFIM, HORFIM INTO l_numcra, l_datmes, l_hormes FROM R070MES WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                     ((DATINI < l_data_atual) OR ((DATINI = l_data_atual) AND (HORINI <= l_hora_atual))) AND
                     ((DATFIM > l_data_atual) OR (DATFIM = l_data_zero) OR ((DATFIM = l_data_atual) AND (HORFIM >= l_hora_atual)));
          EXCEPTION
              WHEN NO_DATA_FOUND THEN l_numcra := 0;
              WHEN OTHERS THEN  l_numcra := 0;
          END;
          IF  (l_numcra > 0) THEN
              R070MES_ATUCON(l_tipope,l_numcra,l_datmes,l_hormes,p_numemp,p_tipcol,p_numcad);
          END IF;
      END IF;
      /*Atualiza VERPRM para os Crachás Secundários*/
      IF (l_tecpri <> 0) THEN
        /*Atualiza o Crachá de Barras se exisir*/
        IF (l_numbar <> 0) THEN
            BEGIN
                UPDATE R070CON SET VERPRM = l_ver_local WHERE NUMFIS = l_numbar;
            EXCEPTION
                WHEN OTHERS THEN NULL;
            END;
        END IF;
        /*Atualiza o Crachá de Proximidade se exisir*/
        IF (l_numpro <> 0) THEN
            BEGIN
                UPDATE R070CON SET VERPRM = l_ver_local WHERE NUMFIS = l_numpro;
            EXCEPTION
                WHEN OTHERS THEN NULL;
            END;
        END IF;
        /*Atualiza o Crachá Smart se exisir*/
        IF (l_numsma <> 0) THEN
            BEGIN
                UPDATE R070CON SET VERPRM = l_ver_local WHERE NUMFIS = l_numsma;
            EXCEPTION
                WHEN OTHERS THEN NULL;
            END;
        END IF;
      END IF;

  /* DELETE/UPDATE R038HCH */
  ELSE
      IF  p_tipcol < 4 THEN
          SP_AtuContFunc(l_tipope,p_numemp, p_tipcol, p_numcad, p_numcra);
      END IF;
      /* Verifica Cracha Titular se for Provisório */
      IF  p_tipcra = 2 THEN
          l_atua_titular := TRUE;
          /* Verifica se Provisorio ainda é valido ? */
          IF  l_tipope = 'U' THEN
              IF  (p_datini < l_data_atual OR (p_datini = l_data_atual AND p_horini <= l_hora_atual)) AND
                  (p_datfim = l_data_zero OR p_datfim > l_data_atual OR (p_datfim = l_data_atual AND p_horfim > l_hora_atual)) THEN
                  l_atua_titular := FALSE;
              END IF;
          END IF;
          /* se foi chamado pelo processo automático 23 não atualiza o crachá titular */
          IF (p_tipope = 'A') THEN
              l_atua_titular := FALSE;
          END IF;

          IF  l_atua_titular = TRUE THEN
              SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0, p_nummat, p_tipdoc, p_numdoc, l_cratit OUT);
              IF  l_cratit > 0 THEN
                  l_situa := '0';
                  /* verifica registros de bloqueio. */
                  IF  (p_tipcol < 4) OR (p_tipcol = 6) THEN /* Colaboradore, Terceiros, Parceiros e Alunos */

                      SP_RETBLO (p_numemp, p_tipcol, p_numcad, p_nummat, p_tipdoc, p_numdoc, l_cratit, l_data_atual, l_hora_atual, l_situa OUT);
                      IF  (l_situa = 'F') THEN
                          l_situa := '0';
                          l_blofal := 1;
                      ELSE
                          l_blofal := 0;
                      END IF;
                      /*Se possui crachá de autorização de entrada, bloqueia o titular...*/
                      BEGIN
                          SELECT NUMCRA, CODPRM, DATENT, HORENT, DATVAL, HORVAL
                          INTO l_numcra, l_grupo, l_datent, l_horent, l_datval, l_horval FROM R071AEN WHERE
                                 NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                                 ((DATENT < l_data_atual) OR ((DATENT = l_data_atual) AND (HORENT <= l_hora_atual))) AND
                                 (
                                 ((DATSAI > l_data_atual) OR (DATSAI = l_data_zero) OR ((DATSAI = l_data_atual) AND (HORSAI > l_hora_atual)))
                                 AND
                                 ((DATVAL > l_data_atual) OR (DATVAL = l_data_zero) OR ((DATVAL = l_data_atual) AND (HORVAL > l_hora_atual)))
                                 ); /*Ambas as datas tem que estar em aberto*/
                      EXCEPTION
                          WHEN NO_DATA_FOUND THEN l_numcra := 0;
                          WHEN OTHERS THEN  l_numcra := 0;
                      END;
                      IF  (l_numcra > 0) THEN
                          l_situa := '1';
                      END IF;
                  ELSE
                      IF  p_tipcol = 5 THEN
                          BEGIN
                              SELECT ACEOCR INTO l_aceocr FROM R070OCR
                              WHERE NUMEMP=p_numemp  AND NUMCAD=p_numcad;
                          EXCEPTION
                              WHEN NO_DATA_FOUND THEN
                                  l_straux :=  'SPCOLCON : Não achou cadastro em Outras Unidades. '||
                                               ' Num.Emp.: '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                                               ' Num.Cad.: '||CONVERT(NUMBER_TO_CHAR,p_numcad);

                                  RAISERROR 103 l_straux;
                              WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro no SELECT em R070OCR.';
                          END;
                          /* Verifica se esta c/ acesso bloqueado */
                          IF  l_aceocr = 2 THEN
                              l_situa := '1';
                          END IF;
                      END IF;
                  END IF;
                  /*Atualiza o(s) Crachá(s) do Titular na R070CON.*/
                  SP_UPDFIS(l_cratit,l_situa,' ');
              END IF;
          END IF;
      END IF;
      BEGIN
          /* Exclui */
          IF  l_tipope = 'D' THEN
              /*Atualiza o(s) crachá(s) na R070CON*/
              SP_UPDFIS(p_numcra,'1',' ');

              /*Converte a data e hora atual para uma string concatenando os dois*/
              SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
              SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
              l_dathorvalatu := l_datstr || l_horstr || '000000';

              /*Atualiza a data de validade do crachá na R070CON para data e hora atual*/
              BEGIN
                  UPDATE R070CON SET
                      DATVAL = l_dathorvalatu
                      WHERE NUMCRA = p_numcra;

              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'SPCOLCON: Erro Na Atualização de R070CON 4.';
              END;
          /* UPDATE CONTROLE numero do cracha e data e hora fim*/
          ELSE
              IF  l_tipope = 'U' THEN
                  l_auxval := l_datahora||'000000';
                  /*Atualiza o(s) crachá(s) na R070CON*/
                  SP_UPDFIS(p_numcra,' ',l_auxval);
              END IF;
          END IF;
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro Na Atualização de CONTROLE 4.';
      END;
      /*Obtem o Crachá Principal da Pessoa*/
      SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
      IF (l_crapri = 0) THEN
          l_crapri := p_numcra;
      END IF;
      /*Obtem o Identificador da Pessoa*/
      IF  p_tipcol < 4 THEN
          /*Obtem o Tipo de Pessoa*/
          SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
          SP_INTSTR(p_numemp,'9999',l_numemp OUT);
          SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
          SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
          l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
      ELSIF p_tipcol = 5 THEN
          /*Obtem o Tipo de Pessoa*/
          SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
          SP_INTSTR(p_numemp,'9999',l_numemp OUT);
          SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
          l_idtpes:= l_tippes_str||l_numemp||l_numcad;
      ELSIF p_tipcol = 6 THEN
          l_idtpes:= '10'||p_nummat;
      ELSIF p_tipcol = 7 THEN
          SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
          l_idtpes:= '07'||l_tipdoc||p_numdoc;
      END IF;
      /*Preenche o campo com espaços para completar 23 posições*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_idtpes) > 22) THEN
              EXIT;
          END IF;
          l_idtpes := ' '||l_idtpes;
      END LOOP;
  END IF;
  IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
    l_creacc_bol := TRUE;
  ELSE
    l_creacc_bol := FALSE;
  END IF;
  IF (p_subnv = 1) THEN
    l_subnv_bol := TRUE;
  ELSE
    l_subnv_bol := FALSE;
  END IF;

  /* Atualiza quantidade de provisórios para todos os crachás da pessoa */
  IF  (l_tipope = 'I') THEN
      BEGIN
          UPDATE R070CON SET QTDPRV = l_qtdprv
           WHERE IDTPES = l_idtpes AND ( SUBSTRING(DATVAL,5,2)
                                       ||SUBSTRING(DATVAL,3,2)
                                       ||SUBSTRING(DATVAL,1,2)
                                       ||SUBSTRING(DATVAL,7,10) > l_datatu
                                       OR DATVAL = '3112502359000000');
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No update da R070CON (QTDPRV).';
      END;
  END IF;

  /*Atualiza a Controle*/
  SP_ATUTSI(l_idtpes, l_crapri, l_creacc_bol, TRUE, l_subnv_bol, TRUE);
  /*Atualiza tabela MatGrupo*/
  SP_MATGRP(p_numcra, p_tipcol, p_numemp, p_tipcol, p_numcad, p_tipdoc, p_numdoc, p_nummat);
  /*Atualiza crachá relacionado*/
  SP_CRAREL(l_tipope, p_numemp, p_tipcol, p_numcad, p_numcra, p_tipcra, p_datfim, p_horfim);

  l_count := 0;
  BEGIN
      SELECT COUNT(*) INTO l_count FROM R034PLA WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND (PEN063 <> 1 OR PEN063 IS NULL);
  EXCEPTION
      WHEN OTHERS THEN
          l_count := 0;
  END;

  IF (l_count > 0) THEN
  	  SP_PEND63(p_numemp, p_tipcol, p_numcad);

  	  BEGIN
  	  	  UPDATE R034PLA SET PEN063 = 1 WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
  	  EXCEPTION
  	  	  WHEN OTHERS THEN
  	  	  	  NULL;
  	  END;
  END IF;

  <<continue_LOOP>>
    NULL;

END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
-PROCEDURE SP_ColDam
 IS
BEGIN
  NULL;
END		ORACLE;20SP_USUTEL
SP_CMDTSI
Ğ%␀␀CREATE OR REPLACE PROCEDURE SP_COLDAM IS

  sql_stmt VARCHAR2(2000);
  curid    NUMBER; /*ID do cursor */
  colcnt   NUMBER; /* No de colunas */
  desctab  DBMS_SQL.DESC_TAB; /* Desc do cursor */

  l_rowid   ROWID;
  l_icard CHAR(12);
  l_diam CHAR(2);
  l_mesm CHAR(2);
  l_anom CHAR(2);
  l_horam CHAR(4);
  l_segundo CHAR(2);
  l_codac CHAR(2);
  l_posic CHAR(1);
  l_blueb CHAR(2);
  l_codtt CHAR(2);
  l_end_ip CHAR(15);
  l_codfnc CHAR(2);
  l_veiculo CHAR(15);
  l_onoff CHAR(1);
  l_peso NUMBER(5,3);
  l_valkilo NUMBER(6,2);
  l_valor NUMBER(6,2);
  l_qtde NUMBER(2);
  l_damseg CHAR(1);
  l_dameip CHAR(1);
  l_damfnc CHAR(1);
  l_damvei CHAR(1);
  l_damono CHAR(1);
  l_dampes CHAR(1);
  l_damvlr CHAR(1);
  l_damkil CHAR(1);
  l_damqtd CHAR(1);
  l_damblu CHAR(1);
  l_damcod CHAR(1);
  l_diracc CHAR(1);
  l_coddsp NUMBER(9);
  l_craaut CHAR(12);
  l_fabmar NUMBER(2);
  ignore integer;
  /*posição das colunas*/
  l_rowid_poscol NUMBER(2);
  l_icard_poscol NUMBER(2);
  l_diam_poscol NUMBER(2);
  l_mesm_poscol NUMBER(2);
  l_anom_poscol NUMBER(2);
  l_horam_poscol NUMBER(2);
  l_segundo_poscol NUMBER(2);
  l_codac_poscol NUMBER(2);
  l_posic_poscol NUMBER(2);
  l_blueb_poscol NUMBER(2);
  l_codtt_poscol NUMBER(2);
  l_end_ip_poscol NUMBER(2);
  l_codfnc_poscol NUMBER(2);
  l_veiculo_poscol NUMBER(2);
  l_onoff_poscol NUMBER(2);
  l_peso_poscol NUMBER(2);
  l_valkilo_poscol NUMBER(2);
  l_valor_poscol NUMBER(2);
  l_qtde_poscol NUMBER(2);
  /*TELEMÁTICA*/
  l_usutel VARCHAR2(31);
  l_comando VARCHAR2(2000);
BEGIN
  /* TSI */
  SP_USUTEL(l_usutel);    

  /*Inicializações*/
  sql_stmt := 'SELECT ROWID, DAM00.* FROM DAM00 WHERE POSIC in (''0'',''1'') FOR UPDATE';
  l_coddsp := 0;
  l_craaut := ' ';
  l_fabmar := 1;
  curid := dbms_sql.open_cursor;
  DBMS_SQL.PARSE(curid, sql_stmt,DBMS_SQL.NATIVE);
  DBMS_SQL.DESCRIBE_COLUMNS(curid, colcnt, desctab);
  l_rowid_poscol := 99;
  l_icard_poscol := 99;
  l_diam_poscol := 99;
  l_mesm_poscol := 99;
  l_anom_poscol := 99;
  l_horam_poscol := 99;
  l_segundo_poscol := 99;
  l_codac_poscol := 99;
  l_posic_poscol := 99;
  l_blueb_poscol := 99;
  l_codtt_poscol := 99;
  l_end_ip_poscol := 99;
  l_codfnc_poscol := 99;
  l_veiculo_poscol := 99;
  l_onoff_poscol := 99;
  l_peso_poscol := 99;
  l_valkilo_poscol := 99;
  l_valor_poscol := 99;
  l_qtde_poscol := 99;

  /*Inicializa as variáveis.*/ 
  FOR i IN 1 .. colcnt LOOP        
    IF desctab(i).col_name = 'ROWID' THEN
      DBMS_SQL.DEFINE_COLUMN_ROWID(curid, i, l_rowid);
      l_rowid_poscol := i;
    /*Define_columns com variação de parâmetros varchar/char deve passar o tamanho do campo*/
    ELSIF desctab(i).col_name = 'ICARD' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_icard,12);
      l_icard_poscol := i;
    ELSIF desctab(i).col_name = 'DIAM' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_diam,2);
      l_diam_poscol := i;
    ELSIF desctab(i).col_name = 'MESM' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_mesm,2);
      l_mesm_poscol := i;
    ELSIF desctab(i).col_name = 'ANOM' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_anom,2);
      l_anom_poscol := i;
    ELSIF desctab(i).col_name = 'HORAM' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_horam,4);
      l_horam_poscol := i;
    ELSIF desctab(i).col_name = 'SEGUNDO' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_segundo,2);
      l_segundo_poscol := i;
    ELSIF desctab(i).col_name = 'CODAC' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_codac,2);
      l_codac_poscol := i;
    ELSIF desctab(i).col_name = 'POSIC' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_posic,1);
      l_posic_poscol := i;
    ELSIF desctab(i).col_name = 'BLUEB' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_blueb,2);
      l_blueb_poscol := i;
    ELSIF desctab(i).col_name = 'CODTT' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_codtt,2);
      l_codtt_poscol := i;
    ELSIF desctab(i).col_name = 'END_IP' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_end_ip,15);
      l_end_ip_poscol := i;
    ELSIF desctab(i).col_name = 'CODFNC' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_codfnc,2);
      l_codfnc_poscol := i;
    ELSIF desctab(i).col_name = 'VEICULO' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_veiculo,15);
      l_veiculo_poscol := i;
    ELSIF desctab(i).col_name = 'ONOFF' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_onoff,1);
      l_onoff_poscol := i;
    ELSIF desctab(i).col_name = 'PESO' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_peso);
      l_peso_poscol := i;
    ELSIF desctab(i).col_name = 'VALKILO' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_valkilo);
      l_valkilo_poscol := i;
    ELSIF desctab(i).col_name = 'VALOR' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_valor);  
      l_valor_poscol := i;
    ELSIF desctab(i).col_name = 'QTDE' THEN
      DBMS_SQL.DEFINE_COLUMN(curid, i, l_qtde);   
      l_qtde_poscol := i;
    END IF;
  END LOOP;

  ignore := DBMS_SQL.EXECUTE(curid);
  
  WHILE DBMS_SQL.FETCH_ROWS(curid) > 0 LOOP
    
    /*Obtem o valor das variáveis*/
    DBMS_SQL.COLUMN_VALUE(curid, l_rowid_poscol, l_rowid);
    IF (l_icard_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_icard_poscol, l_icard);        
    END IF;
    
    IF (l_diam_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_diam_poscol, l_diam);        
    END IF;
    
    IF (l_mesm_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_mesm_poscol, l_mesm);        
    END IF;
    
    IF (l_anom_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_anom_poscol, l_anom);        
    END IF;
    
    IF (l_horam_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_horam_poscol, l_horam);        
    END IF;
    
    IF (l_segundo_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_segundo_poscol, l_segundo);        
    END IF;
    
    IF (l_codac_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_codac_poscol, l_codac);
    END IF;
    
    IF (l_posic_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_posic_poscol, l_posic);
    END IF;
    
    IF (l_blueb_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_blueb_poscol, l_blueb);
    END IF;
    
    IF (l_codtt_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_codtt_poscol, l_codtt);
    END IF;
    
    IF (l_end_ip_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_end_ip_poscol, l_end_ip);
    END IF;
    
    IF (l_codfnc_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_codfnc_poscol, l_codfnc);
    END IF;
    
    IF (l_veiculo_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_veiculo_poscol, l_veiculo);
    END IF;
    
    IF (l_onoff_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_onoff_poscol, l_onoff);
    END IF;
    
    IF (l_peso_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_peso_poscol, l_peso);
    END IF;
    
    IF (l_valkilo_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_valkilo_poscol, l_valkilo);
    END IF;
    
    IF (l_valor_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_valor_poscol, l_valor);  
    END IF;
    
    IF (l_qtde_poscol <> 99) THEN
       DBMS_SQL.COLUMN_VALUE(curid, l_qtde_poscol, l_qtde);   
    END IF;
    
    /*Verifica os valores antes inserir na r070cma*/
    IF (l_segundo = '' or l_segundo is null) THEN
       l_segundo := '00';
    END IF;
    
    IF (l_blueb = '' or l_blueb is null) THEN
       l_blueb := '00';
    END IF;
    
    IF (l_codtt = '' or l_codtt is null) THEN
       l_codtt := '00';
    END IF;
    
    IF (l_end_ip = '' or l_end_ip is null) THEN
       l_end_ip := '000.000.000.000';
    END IF;
    
    IF (l_codfnc = '' or l_codfnc is null) THEN
       l_codfnc := '00';
    END IF;
    
    IF (l_veiculo = '' or l_veiculo is null) THEN
       l_veiculo := ' ';
    END IF;
    
    IF (l_onoff = '' or l_onoff is null) THEN
       l_onoff := '0';
    END IF;    
    
    IF (l_peso IS NULL) THEN
      l_peso := 0;
    END IF;

    IF (l_valor IS NULL) THEN
        l_valor := 0;
    END IF;

    IF (l_valkilo IS NULL) THEN
        l_valkilo := 0;
    END IF;

    IF (l_qtde IS NULL) THEN
        l_qtde := 0;
    END IF;

    IF (l_posic = '0') THEN
        l_diracc := 'E';
    ELSE
        l_diracc := 'S';
    END IF;    

    BEGIN
        /*Insere a marcação na R070CMA*/

        INSERT INTO R070CMA (NUMCRA,DIAACC,MESACC,ANOACC,HORACC,SEGACC,TIPACC,DIRACC,CODCEN,
                             CODRLG,NUMEIP,CODFNC,CRAVEI,STARLG,PESACC,VALACC,VALKIL,QTDACC,
                             CODDSP,INFADI,CRAAUT,FABMAR,NUMNSR,NUMREP,NUMPIS,INFORM,PLAVEI,IMGLPR)
                             VALUES
                            (l_icard, l_diam, l_mesm, l_anom, l_horam, l_segundo, l_codac,
                             l_posic, l_blueb, l_codtt, l_end_ip, l_codfnc, l_veiculo,
                             l_onoff, l_peso, l_valor, l_valkilo, l_qtde,
                             l_coddsp, 0, l_craaut, l_fabmar, 0,'',0,'','',null);

         /*UPDATE DAM00 set POSIC = l_diracc WHERE ROWID = l_rowid;*/
         l_comando := 'UPDATE '||l_usutel||'DAM00 set POSIC = ''' || l_diracc || ''' WHERE ROWID = '''|| l_rowid ||''' ';
         SP_CMDTSI(l_comando);
    EXCEPTION
        WHEN OTHERS THEN
         raise_application_error(-20000 + -(103),'SP_COLDAM: Problemas ao coletar a marcação.' || SQLERRM);
    END;
  END LOOP;

  DBMS_SQL.CLOSE_CURSOR(curid);
END;

	MSSQL;23SP_USUTEL
SP_CMDTSI
s␀␀CREATE PROCEDURE SP_COLDAM AS
BEGIN
DECLARE @l_cursor 	VARCHAR(8000)
DECLARE @l_icard    CHAR(12)
DECLARE @l_diam		CHAR(2)
DECLARE @l_mesm		CHAR(2)
DECLARE @l_anom		CHAR(2)
DECLARE @l_horam	CHAR(4)  
DECLARE @l_segundo	CHAR(2)
DECLARE @l_codac	CHAR(2)
DECLARE @l_posic	CHAR(1)
DECLARE @l_blueb	CHAR(2)
DECLARE @l_codtt	CHAR(2)
DECLARE @l_end_ip	CHAR(15)
DECLARE @l_codfnc	CHAR(2)
DECLARE @l_veiculo	CHAR(15)
DECLARE @l_onoff	CHAR(1)
DECLARE @l_peso		NUMERIC(5,3)
DECLARE @l_valkilo	NUMERIC(6,2)
DECLARE @l_valor	NUMERIC(6,2)
DECLARE @l_qtde		NUMERIC(2)
DECLARE @l_damseg	CHAR(1)
DECLARE @l_dameip	CHAR(1)
DECLARE @l_damfnc	CHAR(1)
DECLARE @l_damvei	CHAR(1)
DECLARE @l_damono	CHAR(1)
DECLARE @l_dampes	CHAR(1)
DECLARE @l_damvlr	CHAR(1)
DECLARE @l_damkil	CHAR(1)
DECLARE @l_damqtd	CHAR(1)
DECLARE @l_damblu    CHAR(1)
DECLARE @l_damcod    CHAR(1)
DECLARE @l_diracc	CHAR(1)
DECLARE @l_coddsp	CHAR(1)
DECLARE @l_craaut CHAR(12)
DECLARE @l_fabmar NUMERIC(2)
DECLARE @l_nodatafound	NUMERIC(1)
DECLARE @l_usutel VARCHAR(31)
DECLARE @l_comando VARCHAR(2048)
DECLARE @ChkError INTEGER

  SELECT @l_nodatafound = 0
  SELECT @l_coddsp = 0
  SELECT @l_craaut = ' '
  SELECT @l_fabmar = 1
  SELECT @ChkError = 0
	
  EXECUTE @ChkError = SP_USUTEL @l_usutel OUT
  IF @ChkError > 0
    RAISERROR('SP_COLDAM: Erro ao obter o usuário telemática.',11,1) WITH SETERROR
		

	/*Obtem as definições da tabela R070TSI*/
	DECLARE cR070TSI CURSOR FOR 
		SELECT DAMSEG, DAMEIP, DAMFNC, DAMVEI, DAMONO, DAMPES, DAMKIL, DAMVLR, DAMQTD, DAMBLU, DAMCOD
		FROM R070TSI;

	OPEN cR070TSI
	FETCH NEXT FROM cR070TSI INTO @l_damseg, @l_dameip, @l_damfnc, @l_damvei, @l_damono,
								  @l_dampes, @l_damkil, @l_damvlr, @l_damqtd, @l_damblu, @l_damcod;

	IF @@ROWCOUNT = 0
		SELECT @l_nodatafound = 1

	CLOSE cR070TSI
	DEALLOCATE cR070TSI

	IF @l_nodatafound = 0
	BEGIN

	
		SET @l_cursor = N'DECLARE cDAM00 CURSOR FOR SELECT ICARD, DIAM, MESM, ANOM, HORAM, CODAC, POSIC'

    IF @l_damblu = 'S'
			SET @l_cursor = @l_cursor+N', BLUEB'
		ELSE
			SET @l_cursor = @l_cursor+N', '+CHAR(39)+CHAR(39)

    IF @l_damcod = 'S'
			SET @l_cursor = @l_cursor+N', CODTT'
		ELSE
			SET @l_cursor = @l_cursor+N', '+CHAR(39)+CHAR(39)

		IF @l_damseg = 'S'
			SET @l_cursor = @l_cursor+N', SEGUNDO'
		ELSE
			SET @l_cursor = @l_cursor+N', '+CHAR(39)+CHAR(39)

		IF @l_dameip = 'S'
			SET @l_cursor = @l_cursor+N', END_IP'		
		ELSE
			SET @l_cursor = @l_cursor+N', '+CHAR(39)+CHAR(39)
		
		IF @l_damfnc = 'S'
			SET @l_cursor = @l_cursor+N', CODFNC'		
		ELSE
			SET @l_cursor = @l_cursor+N', '+CHAR(39)+CHAR(39)

		IF @l_damvei = 'S'
			SET @l_cursor = @l_cursor+N', VEICULO'		
		ELSE
			SET @l_cursor = @l_cursor+N', '+CHAR(39)+CHAR(39)

		IF @l_damono = 'S'
			SET @l_cursor = @l_cursor+N', ONOFF'		
		ELSE
			SET @l_cursor = @l_cursor+N', '+CHAR(39)+CHAR(39)

		IF @l_dampes = 'S'
			SET @l_cursor = @l_cursor+N', PESO'		
		ELSE
			SET @l_cursor = @l_cursor+N', convert(numeric,''0'')'

		IF @l_damkil = 'S'
			SET @l_cursor = @l_cursor+N', VALKILO'		
		ELSE
			SET @l_cursor = @l_cursor+N', convert(numeric,''0'')'
	
		IF @l_damvlr = 'S'
			SET @l_cursor = @l_cursor+N', VALOR'		
		ELSE
			SET @l_cursor = @l_cursor+N', convert(numeric,''0'')'

		IF @l_damqtd = 'S'
			SET @l_cursor = @l_cursor+N', QTDE'
		ELSE
			SET @l_cursor = @l_cursor+N', convert(numeric,''0'')'

		SET @l_cursor = @l_cursor+' FROM '+@l_usutel+'DAM00 WHERE (POSIC = ''0'' OR POSIC = ''1'') FOR UPDATE'

		EXEC (@l_cursor)

		OPEN cDam00
	
		FETCH NEXT FROM cDam00 INTO @l_icard, @l_diam, @l_mesm, @l_anom, @l_horam, @l_codac,
									@l_posic, @l_blueb, @l_codtt, @l_segundo, @l_end_ip,
									@l_codfnc, @l_veiculo, @l_onoff, @l_peso, @l_valkilo,
									@l_valor, @l_qtde;

		WHILE @@FETCH_STATUS = 0
		BEGIN
			
			/*Tratamento dos campos*/
      IF @l_blueb = ''
        SELECT @l_blueb = '00';

      IF @l_codtt = ''
        SELECT @l_codtt = '00';

			IF @l_segundo = ''
				SELECT @l_segundo = '00'
			
			IF @l_end_ip = ''
				SELECT @l_end_ip = '000.000.000.000'

			IF @l_codfnc = ''
				SELECT @l_codfnc = '00'
	
			IF @l_veiculo = ''
				SELECT @l_veiculo = ' '

			IF @l_onoff = ''
				SELECT @l_onoff = '0'			

			IF @l_posic = '0'
				SELECT @l_diracc = 'E'
			ELSE
				SELECT @l_diracc = 'S'
			
			IF @l_peso is null
				SELECT @l_peso = 0

			IF @l_valor is null
				SELECT @l_valor = 0

			IF @l_valkilo is null
				SELECT @l_valkilo = 0

			IF @l_qtde is null
				SELECT @l_qtde = 0			

          /*Insere a marcação na R070CMA*/

      	  INSERT INTO R070CMA (NUMCRA,DIAACC,MESACC,ANOACC,HORACC,SEGACC,TIPACC,DIRACC,CODCEN,
      	                       CODRLG,NUMEIP,CODFNC,CRAVEI,STARLG,PESACC,VALACC,VALKIL,QTDACC,
                               CODDSP,INFADI,CRAAUT,FABMAR,NUMNSR,NUMREP,NUMPIS,INFORM,PLAVEI,IMGLPR)
       	             VALUES
       	                     (@l_icard, @l_diam, @l_mesm, @l_anom, @l_horam, @l_segundo, @l_codac,
       	                      @l_posic, @l_blueb, @l_codtt, @l_end_ip, @l_codfnc, @l_veiculo,
        	                    @l_onoff, @l_peso, @l_valor, @l_valkilo, @l_qtde,
                              @l_coddsp, 0, @l_craaut, @l_fabmar,0,'',0,'','',null);
					
          SELECT @l_comando = 'UPDATE '+@l_usutel+'DAM00 set POSIC = '''+@l_diracc+''' WHERE CURRENT OF cDam00';
          EXECUTE  @ChkError = SP_CMDTSI @l_comando 
          if @ChkError <> 0
          BEGIN
            RAISERROR('SP_COLDAM: Erro Na Atualização de CONTROLE 1.',11,1) WITH SETERROR
          END
		


          FETCH NEXT FROM cDam00 INTO @l_icard, @l_diam, @l_mesm, @l_anom, @l_horam, @l_codac, 
			     					  @l_posic, @l_blueb, @l_codtt, @l_segundo, @l_end_ip, 
									  @l_codfnc, @l_veiculo, @l_onoff, @l_peso, @l_valkilo,
									  @l_valor, @l_qtde;
		END
		CLOSE cDam00
		DEALLOCATE cDam00
	END 
END

␀	ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_DATSTR
SP_CONCATENAR_DES
␀␀PROCEDURE SP_CONCATENAR_DAT(P_CAMPO VARCHAR2(6),P_VALOR DATE,P_RETORNO IN OUT VARCHAR2(2000))
 IS

l_ValorVARCHAR VARCHAR2(2000);
BEGIN
  SP_DATSTR(p_Valor, 'DDMMYYYY', l_ValorVARCHAR OUT);
  l_ValorVARCHAR := SUBSTRING(l_ValorVARCHAR, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 5, 4);
  SP_CONCATENAR_DES(p_Campo, l_ValorVARCHAR, p_Retorno OUT);
  
  RETURN;
END␀
ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ô␀␀PROCEDURE SP_CONCATENAR_DES(P_CAMPO VARCHAR2(6),P_VALOR VARCHAR2(5000),P_RETORNO IN OUT VARCHAR2(5000)) 
 IS

  l_Valor             VARCHAR2(5000);
BEGIN  
 
  IF (P_VALOR IS NULL) THEN
    l_Valor := '';
  ELSE
    l_Valor := REPLACE(P_VALOR, '"', '\"');
  END IF;
 
  IF (p_Retorno IS NULL) OR (p_Retorno = '') THEN
    /* {"campo1":"valor","campo2":"valor"} */
    p_Retorno := '{"' || p_Campo || '":"' || l_Valor || '"}';
  ELSE
    /* {"campo3":"valor","campo4":"valor" */
    p_Retorno := SUBSTRING(p_Retorno, 1, (LENGTH(p_Retorno) -1));
    /* {"campo1":"valor","campo2":"valor","campo3":"valor","campo4":"valor"} ... */
    p_Retorno := p_Retorno || ',"' || p_Campo || '":"' || l_Valor || '"}';    
  END IF;
  
  RETURN;
END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_CONCATENAR_NUM
ÆPROCEDURE SP_CONCATENAR_FLO(P_CAMPO VARCHAR2(6),P_VALOR NUMBER,P_DECIM INTEGER,P_RETORNO IN OUT VARCHAR2(2000))
 IS
BEGIN
  SP_CONCATENAR_NUM(p_Campo, p_Valor, p_Retorno OUT);
  
  RETURN;
END	ORACLE;0
y␀␀CREATE OR REPLACE
PROCEDURE SP_CONCATENAR_FLO(
    p_Campo IN VARCHAR2,
    p_Valor IN NUMBER,
    p_Decim INTEGER,
    p_Retorno IN OUT VARCHAR2)
IS
    l_Valor1 VARCHAR2(2000);
    l_Valor VARCHAR2(2000);
BEGIN
  
  SELECT REPLACE(TO_CHAR(p_Valor), ',', '.')
  INTO l_Valor
  FROM DUAL;
    
  SP_CONCATENAR_DES(p_Campo,l_Valor,p_Retorno);
  RETURN;
END;

	MSSQL;0
T␀␀CREATE PROCEDURE SP_CONCATENAR_FLO
(
	@p_Campo VARCHAR(6),
	@p_Valor FLOAT,
	@p_Decim INTEGER,
	@p_Retorno VARCHAR(2000) OUTPUT
) AS
BEGIN
DECLARE @l_valorvarchar VARCHAR(2000)
DECLARE @ChkError INTEGER
SELECT @ChkError = 0  
  IF (@p_Decim IS NULL)
  BEGIN
	SET @p_Decim = 0;
  END  
  SELECT @l_ValorVARCHAR = REPLACE(LTRIM(STR(@p_Valor, 500, @p_Decim)), ',', '.')
  EXECUTE  @ChkError = SP_CONCATENAR_DES @p_Campo, @l_ValorVARCHAR, @p_Retorno OUTPUT    
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  BEGIN
    RETURN @ChkError
  END
FIM:
  RETURN @ChkError
END

	POSTGRESQL;0
’␀␀CREATE OR REPLACE PROCEDURE SP_CONCATENAR_FLO(p_Campo VARCHAR, p_Valor numeric, p_Decim INTEGER, p_Retorno IN OUT VARCHAR)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
    l_Valor1 VARCHAR(2000);
    l_Valor VARCHAR(2000);
BEGIN
  
  SELECT REPLACE(TRIM(TO_CHAR(p_Valor, '999999999D9999')), ',', '.')
  INTO l_Valor;
    
  CALL SP_CONCATENAR_DES(p_Campo,l_Valor,p_Retorno);
  RETURN;
END;
$BODY$␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_CONCATENAR_DES
␀␀PROCEDURE SP_CONCATENAR_NUM(P_CAMPO VARCHAR2(6),P_VALOR NUMBER,P_RETORNO IN OUT VARCHAR2(2000))
 IS

l_ValorVARCHAR VARCHAR2(2000);
BEGIN
  l_ValorVARCHAR := CONVERT(NUMBER_TO_CHAR, p_Valor);
  SP_CONCATENAR_DES(p_Campo, l_ValorVARCHAR, p_Retorno OUT);
  
  RETURN;
END	MSSQL;0
æ␀␀CREATE PROCEDURE SP_CONCATENAR_NUM
(
	@p_Campo VARCHAR(6), 
	@p_Valor NUMERIC, 
	@p_Retorno VARCHAR(2000) OUTPUT
) AS
BEGIN
DECLARE @l_valorvarchar VARCHAR(2000)
  DECLARE @ChkError INTEGER
  SELECT @ChkError = 0
  SELECT @l_ValorVARCHAR = CONVERT(VARCHAR,@p_Valor)
  EXECUTE  @ChkError = SP_CONCATENAR_DES @p_Campo,@l_ValorVARCHAR,@p_Retorno OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  BEGIN
    RETURN @ChkError
  END
FIM:
  RETURN @ChkError
END

