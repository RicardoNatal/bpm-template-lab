DECLARE
	v_NUMEMP   R034FUN.NUMEMP%TYPE;
    v_TIPCOL   R034FUN.TIPCOL%TYPE;
    v_NUMCAD   R034FUN.NUMCAD%TYPE;
    CURSOR C_R034FUN IS SELECT NUMEMP, TIPCOL, NUMCAD FROM R034FUN WHERE CODPES = :OLD.CODPES;
BEGIN
	FOREACH C_R034FUN INTO v_NUMEMP, v_TIPCOL, v_NUMCAD
	LOOP
		BEGIN
			DELETE FROM R240TRE WHERE NUMEMP = v_NUMEMP AND TIPCOL = v_TIPCOL AND NUMCAD = v_NUMCAD AND CODEVN  = :OLD.CODEVN;
		EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro no Delete da Tabela R240TRE. ';
