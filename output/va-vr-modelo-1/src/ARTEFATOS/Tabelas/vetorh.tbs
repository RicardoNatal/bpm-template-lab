BEGIN
RH_250ALT(18);
END␀UÏ␀␀		SENIOR;0Ø␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R008VIN_EU AFTER UPDATE ON R008VIN FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Eventos - Vínculos Inválidos (Tabela: R008VIN)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 105;     /* Eventos - Vínculos Inválidos (Tabela: R008VIN)*/
  l_codtpa := 356;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.CodTab <> :NEW.CodTab)
   OR (:OLD.CodEve <> :NEW.CodEve)
   OR (:OLD.CodVin <> :NEW.CodVin)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008VIN_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAB', CONVERT(NUMBER_TO_CHAR, :OLD.CODTAB));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :OLD.CODEVE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODVIN', CONVERT(NUMBER_TO_CHAR, :OLD.CODVIN));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R008VIN_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
    END IF; 
  END IF; 
END␀VÏ␀␀	SENIOR;0L

