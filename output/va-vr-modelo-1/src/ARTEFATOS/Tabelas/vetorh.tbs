		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTMACUA', CONVERT(NUMBER_TO_CHAR, :OLD.TMACUA));
		  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTMACUA', CONVERT(NUMBER_TO_CHAR, :NEW.TMACUA));		  
		  SP_DATSTR(:OLD.DATPAR, 'DD/MM/YYYY', l_datTemp OUT);
