                    AND SUBSTR(VALSTR,27,3)=SUBSTR(l_straux,27,3) 
                    AND SUBSTR(VALSTR,30,7)=SUBSTR(l_straux,30,7)  ;
                  else
                    if (l_codcmd=78) then
                      UPDATE R070ADM  SET  STACMD = 7  
                      WHERE SUBSTR(VALSTR,4,3)=SUBSTR(l_straux,4,3) 
                      AND SUBSTR(VALSTR,7,7)=SUBSTR(l_straux,7,7) 
                      AND STACMD IN (0,1,5,8,9) 
                      AND CODCMD = l_CodTraduzido 
                      AND DIRSVR=l_dirsvr  ;
                    else
                      UPDATE R070ADM  SET  STACMD = 7  
                      WHERE IDTPES=l_idtpes 
                      AND NUMFIS=l_numfis 
                      AND NUMCRA=l_numcra 
                      AND STACMD IN (0,1,5,8,9) 
                      AND CODCMD = l_CodTraduzido 
                      AND DIRSVR=l_dirsvr  ;
                    end if;
                  end if;
