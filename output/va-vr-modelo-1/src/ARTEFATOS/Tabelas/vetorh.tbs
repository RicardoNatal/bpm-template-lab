`␀␀PROCEDURE SP_ATUCONTPLANTA(P_TIPOPE CHAR(1),P_NUMCRA NUMBER(12),P_CODPLT NUMBER,P_DATASO DATE,P_DATTSE DATE,P_DATMIN CHAR(6),P_HORMIN CHAR(4))
 IS

l_datstr      CHAR(10);
  l_auxstr      CHAR(6);
  l_horstr      CHAR(4);
  l_pltstr      CHAR(5);
  l_dataso      DATE;
  l_dattse      DATE;
  l_datval      DATE;
  l_datmin      DATE;
  l_datahora    VARCHAR2(10);
  l_dataux      VARCHAR2(6);
  l_icard       CHAR(12);
  l_numbarstr   CHAR(12);
  l_numprostr   CHAR(12);
  l_numbar      NUMBER(12);
  l_numpro      NUMBER(12);
  l_numsma      NUMBER(12);
  l_crapri      NUMBER(12);
  l_tecpri      NUMBER(1);

  /* CURSOR que retorna todas as plantas cadastradas */
  CURSOR c_r058plt IS
  SELECT CODPLT FROM R058PLT ORDER BY 1;
  TYPE t_r058plt IS RECORD(
    CODPLT   R058PLT.CODPLT%TYPE);
  l_r058plt t_r058plt;
BEGIN
  NULL;
END		SENIOR;20eSP_USUTEL
SP_MAPFIS
SP_INTSTR
SP_SELTSI
SP_STRTODATE
SP_DATSTR
SP_EXECCONTPLANTA
SP_RETICARD
J+␀␀/*
 * Procedure SP_ATUCONTPLANTA: Efetua as validações para inserir o crachá na CONTPLANTA
 * Autor: Marcus Vinícius Pitz
 */
PROCEDURE SP_ATUCONTPLANTA(P_TIPOPE CHAR(1),P_NUMCRA NUMBER(12),P_CODPLT NUMBER,P_DATASO DATE,P_DATTSE DATE,P_DATMIN CHAR(6),P_HORMIN CHAR(4))
 IS

l_datstr      CHAR(10);
  l_auxstr      CHAR(6);
  l_horstr      CHAR(4);
  l_pltstr      CHAR(5);
  l_pltOld      CHAR(3);
  l_dataso      DATE;
  l_dattse      DATE;
  l_datval      DATE;
  l_datmin      DATE;
  l_datahora    VARCHAR2(10);
  l_dataux      VARCHAR2(6);
  l_icard       CHAR(12);
  l_numbarstr   CHAR(12);
  l_numprostr   CHAR(12);
  l_numsmastr   CHAR(12);
  l_numbar      NUMBER(12);
  l_numpro      NUMBER(12);
  l_numsma      NUMBER(12);
  l_crapri      NUMBER(12);
  l_tecpri      NUMBER(1);
  l_comando     VARCHAR(1024);
  l_usutel      VARCHAR(31);
  l_retnumberaux NUMBER;
  l_reterr       NUMBER(1);
  l_dat_conv     VARCHAR(25); /*Variável auxiliar para conversão de data*/
  l_conaso       CHAR(1);
  l_icardA       CHAR(12);
  l_icardR       CHAR(12);
  l_numser       VARCHAR(12);
  l_chcAce       CHAR(1);

  /* CURSOR que retorna todas as plantas cadastradas */
  CURSOR c_r058plt IS
  SELECT CODPLT FROM R058PLT WHERE CONASO = 'S' ORDER BY 1; /*TODOS SITES QUE CONTROLAM ASO/TSE*/
  TYPE t_r058plt IS RECORD(
    CODPLT   R058PLT.CODPLT%TYPE);
  l_r058plt t_r058plt;
BEGIN
    /*Usuário da telemática*/
    SP_USUTEL(l_usutel OUT);

    l_datval := '31/12/1900,00:00:00';
    l_pltstr := '00000';

    /* verifica a numeração do crachá */
    l_crapri := 0;
    SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
    SP_INTSTR(l_numbar,'999999999999',l_numbarstr OUT);
    SP_INTSTR(l_numpro,'999999999999',l_numprostr OUT);
    SP_INTSTR(l_numsma,'999999999999',l_numsmastr OUT);
    
    BEGIN
        SELECT CHCACE INTO l_chcAce FROM R070TSI;
    EXCEPTION
        WHEN OTHERS THEN l_chcAce := 0;
    END;

    IF (l_crapri > 0) AND (l_tecpri < 3) AND (l_chcAce <> 3) THEN
        SP_INTSTR(l_crapri,'999999999999',l_icard OUT);
        l_chcAce := 0;
    ELSE
        BEGIN
            SELECT CHCACE INTO l_chcAce FROM R070TSI;
        EXCEPTION
            WHEN OTHERS THEN l_chcAce := 0;
        END;
        IF (l_chcAce = 0) THEN
            SP_INTSTR(p_numcra,'999999999999',l_icard OUT);
        ELSE
            SP_RETICARD(NULL,p_numcra, l_icardA OUT, l_icardR OUT, l_numser OUT);
            SP_INTSTR(l_icardA,'999999999999',l_icard OUT);
        END IF;
    END IF;

    IF  (l_icard <> '000000000000') THEN
        /* verifica a data do crachá na tabela controle */
        IF  (p_datmin = '000000') THEN
            BEGIN
                l_comando := 'SELECT CONTROLE.DATAHORA FROM '||l_usutel||'CONTROLE CONTROLE WHERE ICARD='''||l_icard||'''';
                SP_SELTSI(1, 'l_datahora', l_comando, l_retnumberaux OUT, l_datahora OUT, l_reterr OUT);
                IF (l_reterr = 1) OR (l_reterr = 2) THEN
                    /*EXCEÇÃO: NO DATA FOUND*/
                    l_datahora := '3112502359';
                END IF;
            EXCEPTION
                WHEN OTHERS THEN l_datahora := '3112502359';
            END;

            /* CONVERTE AS DATAS */
            l_dataux := SUBSTRING(l_datahora,1,6);
            l_horstr := SUBSTRING(l_datahora,7,4);
        ELSE
            l_dataux := SUBSTRING(p_datmin,1,6);
            l_horstr := p_hormin;
        END IF;

        /*CONVERTE CARACTERE EM DATA*/
        l_dat_conv := SUBSTRING(l_dataux,1,2)||'/'||SUBSTRING(l_dataux,3,2)||'/'||SUBSTRING(l_dataux,5,2);
        SP_STRTODATE(l_dat_conv, 'DD/MM/AA', l_datmin OUT);

        /* se a data vier da zerada ou vier da controle com o valor 311250 */
        IF  (l_datmin = DATETIME(31,12,1900,0,0,0)) OR
            (l_datmin = DATETIME(31,12,1950,0,0,0)) THEN
            l_datmin := '31/12/2050,00:00:00';
        END IF;

        IF  (p_dataso = DATETIME(31,12,1900,0,0,0)) THEN
            l_dataso := '31/12/2050,00:00:00';
        ELSE
            l_dataso := p_dataso;
        END IF;
        IF  (p_dattse = DATETIME(31,12,1900,0,0,0)) THEN
            l_dattse := '31/12/2050,00:00:00';
        ELSE
            l_dattse := p_dattse;
        END IF;

        IF  (l_dataso > l_dattse) THEN
            l_datval :=  l_dattse;
        ELSE
            l_datval :=  l_dataso;
        END IF;

        IF  (l_datval > l_datmin) THEN
            l_datval := l_datmin;
        END IF;
        /* converte para str */
        SP_DATSTR(l_datval,'DDMMYY',l_auxstr OUT);
        l_datstr := l_auxstr ||l_horstr;

        SP_INTSTR(p_codplt,'99999',l_pltstr OUT);

        /* para planta zero, grava para todas as plantas*/
        IF  (p_codplt = 0) THEN
            /* busca todas as plantas do sistema */
            FOREACH c_r058plt INTO  l_r058plt.CODPLT
            LOOP
                SP_INTSTR(l_r058plt.CODPLT,'99999',l_pltstr OUT);
                /* exclui o registro para recriar novamente */
                BEGIN
                    IF (l_chcAce = 3) THEN
                        IF (l_numbar > 0) THEN
                            SP_EXECCONTPLANTA('D', l_numbarstr, l_pltstr, l_datstr);
                        END IF;
                        IF (l_numsma > 0) THEN
                            SP_EXECCONTPLANTA('D', l_numsmastr, l_pltstr, l_datstr);
                        END IF;
                    ELSE
                        IF (l_crapri>0) AND (l_tecpri<3) THEN
                            /*Crachá tenologia Proximidade ou Barras*/
                            IF (l_numbar<>0) THEN
                                SP_EXECCONTPLANTA('D', l_numbarstr, l_pltstr, l_datstr);
                            END IF;
                            IF (l_numpro<>0) THEN
                                SP_EXECCONTPLANTA('D', l_numprostr, l_pltstr, l_datstr);
                            END IF;
                        ELSE
                            /* Crachá principal */
                            SP_EXECCONTPLANTA('D', l_icard, l_pltstr, l_datstr);
                        END IF;
                    END IF;

                EXCEPTION
                    WHEN OTHERS THEN RAISERROR 103 'SP_ATUCONTPLANTA: Erro ao executar delete na tabela CONTPLANTA.';
                END;
                IF  (p_tipope <> 'D') THEN
                    BEGIN
                        IF (l_chcAce = 3) THEN
                            IF (l_numbar > 0) THEN
                                SP_EXECCONTPLANTA('I', l_numbarstr, l_pltstr, l_datstr);
                            END IF;
                            IF (l_numsma > 0) THEN
                                SP_EXECCONTPLANTA('I', l_numsmastr, l_pltstr, l_datstr);
                            END IF;
                        ELSE
                            IF (l_crapri>0) AND (l_tecpri<3) THEN
                                /*Crachá tenologia Proximidade ou Barras*/
                                IF (l_numbar<>0) THEN
                                    SP_EXECCONTPLANTA('I', l_numbarstr, l_pltstr, l_datstr);
                                END IF;
                                IF (l_numpro<>0) THEN
                                    SP_EXECCONTPLANTA('I', l_numprostr, l_pltstr, l_datstr);
                                END IF;
                            ELSE
                                SP_EXECCONTPLANTA('I', l_icard, l_pltstr, l_datstr);
                            END IF;
                        END IF;
                    EXCEPTION
                        WHEN OTHERS THEN RAISERROR 103 'SP_ATUCONTPLANTA: Erro ao executar INSERT na Tabela CONTPLANTA.';
                    END;
                END IF;
            END LOOP;
        ELSE
            /*Valida se o site controla ASO/Treinamento*/
            BEGIN
                SELECT CONASO INTO l_conaso FROM R058PLT WHERE CODPLT = p_codplt;
            EXCEPTION
                WHEN OTHERS THEN
                    l_conaso := 'S';
            END;

            IF (l_conaso = 'S') THEN
                /* exclui o registro para recriar novamente */
                BEGIN
                    IF (l_chcAce = 3) THEN
                        IF (l_numbar > 0) THEN
                            SP_EXECCONTPLANTA('D', l_numbarstr, l_pltstr, l_datstr);
                        END IF;
                        IF (l_numsma > 0) THEN
                            SP_EXECCONTPLANTA('D', l_numsmastr, l_pltstr, l_datstr);
                        END IF;
                    ELSE
                        IF (l_crapri>0) AND (l_tecpri<3) THEN
                            /*Crachá tenologia Proximidade ou Barras*/
                            IF (l_numbar<>0) THEN
                                SP_EXECCONTPLANTA('D', l_numbarstr, l_pltstr, l_datstr);
                            END IF;
                            IF (l_numpro<>0) THEN
                                SP_EXECCONTPLANTA('D', l_numprostr, l_pltstr, l_datstr);
                            END IF;
                        ELSE
                           /*  Crachá principal */
                           SP_EXECCONTPLANTA('D', l_icard, l_pltstr, l_datstr);
                        END IF;
                    END IF;
                EXCEPTION
                    WHEN OTHERS THEN RAISERROR 103 'SP_ATUCONTPLANTA: Erro ao executar delete na tabela CONTPLANTA.';
                END;

                IF  (p_tipope <> 'D') THEN
                    BEGIN
                        IF (l_chcAce = 3) THEN
                            IF (l_numbar > 0) THEN
                                SP_EXECCONTPLANTA('I', l_numbarstr, l_pltstr, l_datstr);
                            END IF;
                            IF (l_numsma > 0) THEN
                                SP_EXECCONTPLANTA('I', l_numsmastr, l_pltstr, l_datstr);
                            END IF;
                        ELSE
                            IF (l_crapri>0) AND (l_tecpri<3) THEN
                                /*Crachá tenologia Proximidade ou Barras*/
                                IF (l_numbar<>0) THEN
                                    SP_EXECCONTPLANTA('I', l_numbarstr, l_pltstr, l_datstr);
                                END IF;
                                IF (l_numpro<>0) THEN
                                    SP_EXECCONTPLANTA('I', l_numprostr, l_pltstr, l_datstr);
                                END IF;
                            ELSE    
                                SP_EXECCONTPLANTA('I', l_icard, l_pltstr, l_datstr);
                            END IF;
                        END IF;
                    EXCEPTION
                        WHEN OTHERS THEN RAISERROR 103 'SP_ATUCONTPLANTA: Erro ao executar INSERT na tabela CONTPLANTA.';
                    END;
                END IF;
            END IF;
        END IF;
    END IF;
END		SENIOR;23eSP_USUTEL
