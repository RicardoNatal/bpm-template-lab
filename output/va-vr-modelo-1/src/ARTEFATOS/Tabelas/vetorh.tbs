        SP_DATSTR(:NEW.DATSIN, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATSIN', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPES', CONVERT(NUMBER_TO_CHAR, :NEW.CODPES));
        SP_DATSTR(:NEW.DATEVT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATEVT', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TEMHCT', CONVERT(NUMBER_TO_CHAR, :NEW.TEMHCT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHCT', CONVERT(NUMBER_TO_CHAR, :NEW.STAHCT));
        SP_DATSTR(:NEW.DATHCT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATHCT', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMPSP', :NEW.NUMPSP);
        SP_DATSTR(:NEW.DATCHE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATCHE', l_datTemp);
        SP_DATSTR(:NEW.DATSEF, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATSEF', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', CONVERT(NUMBER_TO_CHAR, :NEW.SEQREG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'GESPON', :NEW.GESPON);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRO', CONVERT(NUMBER_TO_CHAR, :NEW.CODPRO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CATESO', CONVERT(NUMBER_TO_CHAR, :NEW.CATESO));
        SP_DATSTR(:NEW.DATCES, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATCES', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'COTDEF', CONVERT(NUMBER_TO_CHAR, :NEW.COTDEF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FORPRO', :NEW.FORPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCBO', :NEW.CODCBO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TPCPIX', CONVERT(NUMBER_TO_CHAR, :NEW.TPCPIX));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CHVPIX', :NEW.CHVPIX);
      END;
  END IF;
END␀‡Ó␀␀	SENIOR;0µH␀␀

TRIGGER R034FUN_SU AFTER UPDATE ON R034FUN

DECLARE
L_DEMITIDOS BOOLEAN;
  l_data_zero DATE;
  l_DatAtu    DATE;
  l_HisCon      R030EMP.HISCON%TYPE;
  l_Existe    BOOLEAN;
  L_ULTSEQCON   R033CON.SEQCON%TYPE;
  L_SEQCON      R033CON.SEQCON%TYPE;
  L_DATALT      R033CON.DATALT%TYPE;
  L_CODBAN      R033CON.CODBAN%TYPE;
  L_CODAGE      R033CON.CODAGE%TYPE;
  L_TIPBAN      R033CON.TIPBAN%TYPE;
  L_CONBAN      R033CON.CONBAN%TYPE;
  L_DIGBAN      R033CON.DIGBAN%TYPE;

  l_DatAltHFI   R033PES.DATAUX%TYPE;
  l_ColAti      R033PES.COLATI%TYPE;
  l_AlterouPessoa BOOLEAN;
  L_TPCPIX      R033PIX.TPCPIX%TYPE;
  L_CHVPIX      R033PIX.CHVPIX%TYPE;

  /* CURSOR para buscar os campos comuns entre colaborador e pessoa */
  CURSOR C_R034FUN_AUXu IS
  SELECT IFNULL(NUMEMP, 0), IFNULL(TIPCOL, 0), IFNULL(NUMCAD, 0),
	       IFNULL(CODPES, 0), IFNULL(NOMFUN, ' '), IFNULL(APEFUN, ' '),
         IFNULL(TIPSEX, ' '), IFNULL(ESTCIV, 0), IFNULL(NUMCPF, 0),
         IFNULL(DATNAS, DATETIME(31, 12, 1900, 0, 0, 0)), IFNULL(CODNAC, 0), IFNULL(GRAINS, 0),
         IFNULL(DEFFIS, ' '), IFNULL(CODDEF, 0), IFNULL(BENREA, ' '),
         IFNULL(RACCOR, 0), IFNULL(NUMPIS, 0), IFNULL(DCDPIS, DATETIME(31, 12, 1900, 0, 0, 0)),
         IFNULL(NUMCTP, 0), IFNULL(SERCTP, ' '), IFNULL(DIGCAR, ' '),
         IFNULL(DEXCTP, DATETIME(31, 12, 1900, 0, 0, 0)), IFNULL(ESTCTP, ' '), IFNULL(SITAFA, 0),
         IFNULL(CODBAN, 0), IFNULL(CODAGE, 0), IFNULL(CONBAN, 0), IFNULL(DIGBAN, ' '), IFNULL(TPCTBA, 0),
         IFNULL(TPCPIX, 0), IFNULL(CHVPIX, ' ')
	FROM R034FUN_AUX;
	TYPE T_R034FUN_AUX IS RECORD(
	  NUMEMP   R034FUN_AUX.NUMEMP%TYPE,
	  TIPCOL   R034FUN_AUX.TIPCOL%TYPE,
	  NUMCAD   R034FUN_AUX.NUMCAD%TYPE,
	  CODPES   R034FUN_AUX.CODPES%TYPE,
	  NOMFUN   R034FUN_AUX.NOMFUN%TYPE,
	  APEFUN   R034FUN_AUX.APEFUN%TYPE,
    TIPSEX   R034FUN_AUX.TIPSEX%TYPE,
    ESTCIV   R034FUN_AUX.ESTCIV%TYPE,
    NUMCPF   R034FUN_AUX.NUMCPF%TYPE,
    DATNAS   R034FUN_AUX.DATNAS%TYPE,
    CODNAC   R034FUN_AUX.CODNAC%TYPE,
    GRAINS   R034FUN_AUX.GRAINS%TYPE,
    DEFFIS   R034FUN_AUX.DEFFIS%TYPE,
    CODDEF   R034FUN_AUX.CODDEF%TYPE,
    BENREA   R034FUN_AUX.BENREA%TYPE,
    RACCOR   R034FUN_AUX.RACCOR%TYPE,
    NUMPIS   R034FUN_AUX.NUMPIS%TYPE,
    DCDPIS   R034FUN_AUX.DCDPIS%TYPE,
    NUMCTP   R034FUN_AUX.NUMCTP%TYPE,
    SERCTP   R034FUN_AUX.SERCTP%TYPE,
    DIGCAR   R034FUN_AUX.DIGCAR%TYPE,
    DEXCTP   R034FUN_AUX.DEXCTP%TYPE,
    ESTCTP   R034FUN_AUX.ESTCTP%TYPE,
    SITAFA   R034FUN_AUX.SITAFA%TYPE,
    CODBAN   R034FUN_AUX.CODBAN%TYPE,
    CODAGE   R034FUN_AUX.CODAGE%TYPE,
    CONBAN   R034FUN_AUX.CONBAN%TYPE,
    DIGBAN   R034FUN_AUX.DIGBAN%TYPE,
    TPCTBA   R034FUN_AUX.TPCTBA%TYPE,
    TPCPIX   R034FUN_AUX.TPCPIX%TYPE,
    CHVPIX   R034FUN_AUX.CHVPIX%TYPE);
	L_R034FUN_AUX T_R034FUN_AUX;


BEGIN
  R034FUN_ATUFGT();

  l_data_zero  := DATETIME(31, 12, 1900, 0, 0, 0); /*'31/12/1900,00:00:00';*/
  l_DatAtu := CURDATE();

  FOREACH C_R034FUN_AUXu INTO L_R034FUN_AUX.NUMEMP,
				L_R034FUN_AUX.TIPCOL,
				L_R034FUN_AUX.NUMCAD,
				L_R034FUN_AUX.CODPES,
				L_R034FUN_AUX.NOMFUN,
				L_R034FUN_AUX.APEFUN,
				L_R034FUN_AUX.TIPSEX,
				L_R034FUN_AUX.ESTCIV,
				L_R034FUN_AUX.NUMCPF,
				L_R034FUN_AUX.DATNAS,
				L_R034FUN_AUX.CODNAC,
				L_R034FUN_AUX.GRAINS,
				L_R034FUN_AUX.DEFFIS,
				L_R034FUN_AUX.CODDEF,
				L_R034FUN_AUX.BENREA,
				L_R034FUN_AUX.RACCOR,
				L_R034FUN_AUX.NUMPIS,
				L_R034FUN_AUX.DCDPIS,
				L_R034FUN_AUX.NUMCTP,
				L_R034FUN_AUX.SERCTP,
				L_R034FUN_AUX.DIGCAR,
				L_R034FUN_AUX.DEXCTP,
				L_R034FUN_AUX.ESTCTP,
				L_R034FUN_AUX.SITAFA,
        L_R034FUN_AUX.CODBAN,
        L_R034FUN_AUX.CODAGE,
        L_R034FUN_AUX.CONBAN,
        L_R034FUN_AUX.DIGBAN,
        L_R034FUN_AUX.TPCTBA,
        L_R034FUN_AUX.TPCPIX,
        L_R034FUN_AUX.CHVPIX
  LOOP

    RH_VERCOLDEM(L_R034FUN_AUX.NUMEMP, L_R034FUN_AUX.TIPCOL, L_R034FUN_AUX.NUMCAD, L_R034FUN_AUX.CODPES, L_R034FUN_AUX.SITAFA, 'R034FUN', L_DEMITIDOS OUT);
    IF (L_DEMITIDOS = TRUE) THEN
      l_AlterouPessoa := FALSE;

      /* Atualiza a R033PES para os campos alterados */
      IF (L_R034FUN_AUX.NOMFUN <> ' ') THEN
        BEGIN
          UPDATE R033PES SET NOMPES = L_R034FUN_AUX.NOMFUN WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar R033PES campo NOMPES';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.APEFUN <> ' ') THEN
        BEGIN
          UPDATE R033PES SET APEPES = L_R034FUN_AUX.APEFUN WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo APEPES';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.TIPSEX <> ' ') THEN
        BEGIN
          UPDATE R033PES SET TIPSEX = L_R034FUN_AUX.TIPSEX WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo TIPSEX';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.ESTCIV <> 0) THEN
        BEGIN
          UPDATE R033PES SET ESTCIV = L_R034FUN_AUX.ESTCIV WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo ESTCIV';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.NUMCPF <> 0) THEN
        BEGIN
          UPDATE R033PES SET NUMCPF = L_R034FUN_AUX.NUMCPF WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NUMCPF';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.DATNAS <> l_data_zero) THEN
        BEGIN
          UPDATE R033PES SET DATNAS = L_R034FUN_AUX.DATNAS WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DATNAS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.CODNAC <> 0) THEN
        BEGIN
          UPDATE R033PES SET CODNAC = L_R034FUN_AUX.CODNAC WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo CODNAC';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.GRAINS <> 0) THEN
        BEGIN
          UPDATE R033PES SET GRAINS = L_R034FUN_AUX.GRAINS WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo GRAINS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.DEFFIS <> ' ') THEN
        BEGIN
          UPDATE R033PES SET DEFFIS = L_R034FUN_AUX.DEFFIS WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DEFFIS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.CODDEF <> 0 OR L_R034FUN_AUX.DEFFIS = 'N') THEN
        BEGIN
          UPDATE R033PES SET CODDEF = L_R034FUN_AUX.CODDEF WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo CODDEF';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.BENREA <> ' ') THEN
        BEGIN
          UPDATE R033PES SET BENREA = L_R034FUN_AUX.BENREA WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo BENREA';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.RACCOR <> 0) THEN
        BEGIN
          UPDATE R033PES SET RACCOR = L_R034FUN_AUX.RACCOR WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo RACCOR';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.NUMPIS <> 0) THEN
        BEGIN
          UPDATE R033PES SET NUMPIS = L_R034FUN_AUX.NUMPIS WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NUMPIS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.DCDPIS <> l_data_zero) THEN
        BEGIN
          UPDATE R033PES SET DCDPIS = L_R034FUN_AUX.DCDPIS WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DCDPIS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.NUMCTP <> 0) THEN
        BEGIN
          UPDATE R033PES SET NUMCTP = L_R034FUN_AUX.NUMCTP WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NUMCTP';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.SERCTP <> ' ') THEN
        BEGIN
          UPDATE R033PES SET SERCTP = L_R034FUN_AUX.SERCTP WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo SERCTP';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.DIGCAR <> ' ') THEN
        BEGIN
          UPDATE R033PES SET DIGCAR = L_R034FUN_AUX.DIGCAR WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DIGCAR';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.DEXCTP <> l_data_zero) THEN
        BEGIN
          UPDATE R033PES SET DEXCTP = L_R034FUN_AUX.DEXCTP WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DEXCTP';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (L_R034FUN_AUX.ESTCTP <> ' ') THEN
        BEGIN
          UPDATE R033PES SET ESTCTP = L_R034FUN_AUX.ESTCTP WHERE CODPES = L_R034FUN_AUX.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo ESTCTP';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

	  IF (l_AlterouPessoa = TRUE) THEN
       	/* Retornar a data do primeiro hist. filial do colaborador */
        R038HFI_MINDATALT(L_R034FUN_AUX.NUMEMP, L_R034FUN_AUX.TIPCOL, L_R034FUN_AUX.NUMCAD, l_DatAltHFI OUT);

        /* Retornar se o colaborador está ativo */
        R038AFA_COLATI(L_R034FUN_AUX.NUMEMP, L_R034FUN_AUX.TIPCOL, L_R034FUN_AUX.NUMCAD, l_ColAti OUT);

	    BEGIN
          UPDATE R033PES SET EMPAUX = L_R034FUN_AUX.NUMEMP, TIPAUX = L_R034FUN_AUX.TIPCOL, CADAUX = L_R034FUN_AUX.NUMCAD,
                             DEPAUX = 0, COLATI = l_ColAti, CANAUX = 0, DATAUX = l_DatAltHFI WHERE CODPES = L_R034FUN_AUX.CODPES;
        EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'Erro ao atualizar campos auxiliares da R033PES';
        END;
	  END IF;

      /* Verifica se usa assinalamento de Hístórico de Contas bancárias */
      BEGIN
        SELECT HISCON INTO l_HisCon FROM R030EMP
        WHERE NUMEMP = L_R034FUN_AUX.NUMEMP;
        EXCEPTION WHEN NO_DATA_FOUND THEN
          l_HisCon := ' ';
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler R030EMP';
      END;

      /* Se não usa histórico de conta bancária */
      IF (l_HisCon = 'N') THEN
        BEGIN
          l_Existe := TRUE;

          /* Verifica se conta já não existe */
          SELECT
		  R033CON.SEQCON SEQCON,
		  R033CON.DATALT DATALT,
		  R033CON.CODBAN CODBAN,
		  R033CON.CODAGE CODAGE,
		  R033CON.CONBAN CONBAN,
		  R033CON.TIPBAN TIPBAN,
		  R033CON.DIGBAN DIGBAN 
		  INTO L_SEQCON, L_DATALT, L_CODBAN, L_CODAGE, L_CONBAN, L_TIPBAN, L_DIGBAN
            FROM R033CON R033CON
           WHERE CODBAN = L_R034FUN_AUX.CODBAN
             AND CODAGE = L_R034FUN_AUX.CODAGE
             AND CONBAN = L_R034FUN_AUX.CONBAN
             AND CODPES = L_R034FUN_AUX.CODPES
             AND DATALT = (SELECT MAX(DATALT) COL_02 FROM R033CON CON2 
		     			   WHERE CON2.CODPES = L_R034FUN_AUX.CODPES
			 			     AND CON2.DATALT <= l_DatAtu
			 				 AND CON2.CODBAN = L_R034FUN_AUX.CODBAN
			 				 AND CON2.CODAGE = L_R034FUN_AUX.CODAGE)
			 AND SEQCON = (SELECT MAX(SEQCON) COL_0 FROM R033CON TAB2
						   WHERE TAB2.CODPES = L_R034FUN_AUX.CODPES
			 				 AND TAB2.DATALT = (SELECT MAX(DATALT) COL_0 FROM R033CON CON
						   WHERE CON.CODPES = L_R034FUN_AUX.CODPES
						     AND CON.DATALT <= l_DatAtu
						     AND CON.CODBAN = L_R034FUN_AUX.CODBAN
						     AND CON.CODAGE = L_R034FUN_AUX.CODAGE)
						     AND TAB2.CODBAN = L_R034FUN_AUX.CODBAN
						     AND TAB2.CODAGE = L_R034FUN_AUX.CODAGE
						     AND TAB2.CONBAN = L_R034FUN_AUX.CONBAN);
          EXCEPTION WHEN NO_DATA_FOUND THEN
            L_SEQCON := 0;
            L_DATALT := l_DatAtu;
            L_CODBAN := L_R034FUN_AUX.CODBAN;
            L_CODAGE := L_R034FUN_AUX.CODAGE;
            L_CONBAN := L_R034FUN_AUX.CONBAN;
            L_DIGBAN := L_R034FUN_AUX.DIGBAN;
            L_TIPBAN := L_R034FUN_AUX.TPCTBA;
            l_Existe := FALSE;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler R033CON';
        END;

        IF (l_Existe = TRUE) THEN
          BEGIN
            /* Se já existe zera data do encerramento */
            UPDATE R033CON SET TIPBAN = L_R034FUN_AUX.TPCTBA, DIGBAN = L_R034FUN_AUX.DIGBAN, DATABE = L_DATATU, DATENC = l_data_zero,
                               EMPAUX = L_R034FUN_AUX.NUMEMP, TIPAUX = L_R034FUN_AUX.TIPCOL, CADAUX = L_R034FUN_AUX.NUMCAD,
                               DEPAUX = 0, COLATI = 0, CANAUX = 0, DATAUX = l_data_zero
            WHERE CODPES = L_R034FUN_AUX.CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a R033CON';
          END;
        ELSE
          IF (L_CODBAN <> 0) AND (L_CODAGE <> 0) AND (L_TIPBAN <> 0) AND (L_CONBAN <> 0) AND (L_TIPBAN <> 0) THEN
            BEGIN
              SELECT IFNULL(MAX(SEQCON), 0) INTO L_ULTSEQCON FROM R033CON
              WHERE CODPES = L_R034FUN_AUX.CODPES
              AND DATALT = L_DATALT;
              EXCEPTION WHEN NO_DATA_FOUND THEN
                L_ULTSEQCON := 0;
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao ler R033CON';
            END;

            /* Gera próxima sequência */
            L_SEQCON := L_ULTSEQCON + 1;

            BEGIN
              /* Se não existe insere nova conta */
              INSERT INTO R033CON (CODPES, DATALT, SEQCON, CODBAN, CODAGE, TIPBAN, CONBAN, DIGBAN, DATABE, DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX)
              VALUES (L_R034FUN_AUX.CODPES, L_DATALT, L_SEQCON, L_CODBAN, L_CODAGE, L_TIPBAN, L_CONBAN, L_DIGBAN, l_DatAtu, l_data_zero, L_R034FUN_AUX.NUMEMP, L_R034FUN_AUX.TIPCOL, L_R034FUN_AUX.NUMCAD, 0, 0, 0, l_data_zero);
              EXCEPTION WHEN OTHERS THEN
                RAISERROR 103 'Erro ao inserir na R033CON';
            END;
          END IF;
        END IF;

      END IF;
      
      /* chave pix */
      IF (l_HisCon = 'N') THEN
        BEGIN
          l_Existe := TRUE;

          /* Verifica se chave já não existe */
          SELECT SEQCON,   DATALT, TPCPIX, CHVPIX
            INTO L_SEQCON, L_DATALT, L_TPCPIX, L_CHVPIX
            FROM R033PIX
           WHERE TPCPIX = L_R034FUN_AUX.TPCPIX
             AND CHVPIX = L_R034FUN_AUX.CHVPIX
             AND CODPES = L_R034FUN_AUX.CODPES
             AND DATALT = (SELECT MAX(DATALT)
                                               FROM R033PIX TAB2
                                               WHERE TAB2.TPCPIX = L_R034FUN_AUX.TPCPIX
                                                 AND TAB2.CHVPIX = L_R034FUN_AUX.CHVPIX
                                                 AND TAB2.CODPES = L_R034FUN_AUX.CODPES
                                                 AND TAB2.DATALT <= l_DatAtu);
          EXCEPTION WHEN NO_DATA_FOUND THEN
            L_SEQCON := 0;
            L_DATALT := l_DatAtu;
            L_TPCPIX := L_R034FUN_AUX.TPCPIX;
            L_CHVPIX := L_R034FUN_AUX.CHVPIX;
            l_Existe := FALSE;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler R033PIX';
        END;

        IF (l_Existe = TRUE) THEN
          BEGIN
            /* Se já existe zera data do encerramento */
            UPDATE R033PIX SET DATABE = L_DATATU, DATENC = l_data_zero,
                               EMPAUX = L_R034FUN_AUX.NUMEMP, TIPAUX = L_R034FUN_AUX.TIPCOL, CADAUX = L_R034FUN_AUX.NUMCAD,
                               DEPAUX = 0, COLATI = 0, CANAUX = 0, DATAUX = l_data_zero
            WHERE CODPES = L_R034FUN_AUX.CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a R033PIX';
          END;
        ELSE
          IF (L_TPCPIX <> 0)  THEN
            BEGIN
              SELECT IFNULL(MAX(SEQCON), 0) INTO L_ULTSEQCON FROM R033PIX
              WHERE CODPES = L_R034FUN_AUX.CODPES;
              EXCEPTION WHEN NO_DATA_FOUND THEN
                L_ULTSEQCON := 0;
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao ler R033PIX';
            END;

            /* Gera próxima sequência */
            L_SEQCON := L_ULTSEQCON + 1;

            BEGIN
              /* Se não existe insere nova chave */
              INSERT INTO R033PIX (CODPES, DATALT, SEQCON, DATABE, DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX, TPCPIX, CHVPIX)
              VALUES (L_R034FUN_AUX.CODPES, L_DATALT, L_SEQCON, l_DatAtu, l_data_zero, L_R034FUN_AUX.NUMEMP, L_R034FUN_AUX.TIPCOL, L_R034FUN_AUX.NUMCAD, 0, 0, 0, l_data_zero, L_TPCPIX, L_CHVPIX);
              EXCEPTION WHEN OTHERS THEN
                RAISERROR 103 'Erro ao inserir na R033CON';
            END;
          END IF;
        END IF;

      END IF;
    END IF;

  END LOOP;

  BEGIN
    /* Limpar tabela auxiliar */
    DELETE FROM R034FUN_AUX;
    DROP_TEMP_TABLE R034FUN_AUX;
    EXCEPTION WHEN OTHERS THEN
	    RAISERROR 103 'Erro ao excluir registros da tabela R034FUN_AUX';
  END;
END␀ƒÓ␀␀		SENIOR;0ıy␀TRIGGER R034FUN_EU AFTER UPDATE ON R034FUN FOR EACH ROW

DECLARE
  l_altcplfun    BOOLEAN;
  l_usaRubi      BOOLEAN;
  l_QtdOriOpe    NUMBER;
  l_CodFic       NUMBER;
  l_QtdDef       NUMBER;
  l_online       BOOLEAN;
  l_reponl       CHAR(1);
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_verrpo       BOOLEAN;
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_codtpa2      NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_InfoFacult   BOOLEAN;
  l_SimplificacaoESocial BOOLEAN;

  /* CURSOR para buscar as fichas médicas do colaborador */
  CURSOR c_r110fic IS
  SELECT CODFIC FROM R110FIC
   WHERE NUMEMP = :NEW.NUMEMP
     AND TIPCOL = :NEW.TIPCOL
     AND NUMCAD = :NEW.NUMCAD
     AND TIPATN = 1;

  CREATE_TEMP_TABLE R034FUN_AUX; 

  /*VARIAVEIS PARA O CONTROLE DE AUDITORIA DE REGISTROS*/
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);

  l_Valido BOOLEAN;
  l_AlterouInfoVinculo BOOLEAN;
  l_AlterouInfoCadastral BOOLEAN;
  l_AlterouInfoContratual BOOLEAN;
  l_AlterouInfoNascimento BOOLEAN;
  l_AlterouInfoFGTS BOOLEAN;
  l_JsonFlags VARCHAR2(2000);
  l_JsonFlagsCadastral VARCHAR2(2000);
  l_JsonFlagsVinculo VARCHAR2(2000);
  l_JsonFlagsContratual VARCHAR2(2000);
  l_JsonInfoVinculo VARCHAR2(2000);
  l_JsonInfoCadastral VARCHAR2(2000);
  l_JsonInfoContratual VARCHAR2(2000);
  l_DataAlteracao DATE;
  l_EtniaESocialAlterada BOOLEAN;

  l_layout VARCHAR2(6); /* layout do colaborador no esocial */
  l_layoutAlteracaoCadastral VARCHAR2(6);

  l_VersaoESocial NUMBER;
  
  /* Para store procedures de histórico */
  l_seqhis       NUMBER(15);
  l_tipalt       VARCHAR2(1);
  
BEGIN
  RH_VerRubi(l_usaRubi OUT);

  /* Verifica se foi alterado algum dos campos abaixo */
  l_altcplfun := FALSE;
  IF  (l_usaRubi = TRUE)
    AND ((:NEW.NOMFUN <> :OLD.NOMFUN)
    OR  (:NEW.NUMCTP <> :OLD.NUMCTP)
    OR  (:NEW.SERCTP <> :OLD.SERCTP)
    OR  (:NEW.ESTCTP <> :OLD.ESTCTP)
    OR  (:NEW.NUMPIS <> :OLD.NUMPIS)
    OR  (:NEW.DATADM <> :OLD.DATADM)
    OR  (:NEW.DATNAS <> :OLD.DATNAS)
    OR  (:NEW.NUMCPF <> :OLD.NUMCPF)) THEN
      l_altcplfun := TRUE;
  END IF;

  IF   (l_altcplfun = TRUE) THEN
       R034FUN_FGTAUX(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,
                       :OLD.NOMFUN,:OLD.NUMCTP,:OLD.SERCTP,:OLD.ESTCTP,
                       :OLD.NUMPIS,:OLD.DATADM,:OLD.DATNAS,:OLD.DATOPC,:OLD.NUMCPF);
  END IF;

    /* Verifica se os campos relacionados a deficiência foram alterados */
    IF ((:NEW.CODDEF <> :OLD.CODDEF) OR
    	(IFNULL(:NEW.DEFFIS, ' ') <> IFNULL(:OLD.DEFFIS, ' ')) OR
        (IFNULL(:NEW.BENREA, ' ') <> IFNULL(:OLD.BENREA, ' ')) OR
        (IFNULL(:NEW.COTDEF, ' ') <> IFNULL(:OLD.COTDEF, ' '))) THEN

      /* Verifica se campo R110TRI.OriOpe possui registros */
      BEGIN
        SELECT COUNT(*) INTO l_QtdOriOpe FROM R110TRI;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_QtdOriOpe := 0;
      END;

    ELSE
      /* Seta valor padrão na qual indica que não houve alterações
         em relação a deficiência, não sendo necessário atualizar ficha
         médica e histórico */
      l_QtdOriOpe := 1;
    END IF;

    /* Se não existe registro na tabela R110TRI para o colaborador */
    IF (l_QtdOriOpe = 0) THEN
      /* Inclui registro na tabela R110TRI no campo ORIOPE valor 'C' */
      RH_SETORIOPE('C');

      /* Verifica se colaborador possui Ficha Médica */
      FOREACH c_r110fic INTO l_CodFic
      LOOP

        IF (:NEW.CODDEF <> 0) AND (:NEW.CODDEF <> :OLD.CODDEF) THEN
          /* Verifica se a deficiência "nova" já existe no Histórico de Deficiências. */
          BEGIN
            SELECT COUNT(*) INTO l_QtdDef FROM R110HDF
             WHERE NUMEMP = :NEW.NUMEMP
               AND CODFIC = l_CodFic
               AND CODDEF = :NEW.CODDEF;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT da tabela R110HDF.';
          END;

          /* Deleta a deficiência antiga do Histórico */
          BEGIN
            DELETE FROM R110HDF
             WHERE NUMEMP = :NEW.NUMEMP
               AND CODFIC = l_CodFic
               AND CODDEF = :OLD.CODDEF;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro no DELETE da tabela R110HDF.';
          END;

          /* Retira assinalamento de deficiência principal das outras deficiências já existentes */
          BEGIN
            UPDATE R110HDF SET PRIDEF = 'N'
                     WHERE NUMEMP = :NEW.NUMEMP
                       AND CODFIC = l_CodFic
                       AND PRIDEF = 'S';
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao Retirar assinalamento de Deficiência principal.';
          END;

          /* Se não existe ainda então insere a deficiência no histórico */
          IF (l_QtdDef = 0) THEN
            /* Insere a deficiência "nova" no Histórico, como sendo a deficiência principal */
            BEGIN
              INSERT INTO R110HDF (NUMEMP,CODFIC,CODDEF,DATDEF,PRIDEF)
                   VALUES (:NEW.NUMEMP,l_CodFic,:NEW.CODDEF,:NEW.DATNAS,'S');
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao Inserir Deficiência na tabela R110HDF.';
            END;
          ELSE
            /* Se a deficiência já existe então seta ela como principal */
            BEGIN
              UPDATE R110HDF SET PRIDEF = 'S'
                           WHERE NUMEMP = :NEW.NUMEMP
                             AND CODFIC = l_CodFic
                             AND CODDEF = :NEW.CODDEF;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao setar Deficiência como principal.';
            END;
          END IF;

          /* Atualiza a ficha médica com a deficiência principal */
          BEGIN
            UPDATE R110FIC SET DEFFIS = :NEW.DEFFIS, CODDEF = :NEW.CODDEF, BENREA = :NEW.BENREA, COTDEF = :NEW.COTDEF
                     WHERE NUMEMP = :NEW.NUMEMP
                       AND TIPCOL = :NEW.TIPCOL
                       AND NUMCAD = :NEW.NUMCAD
                       AND CODFIC = l_CodFic
                       AND TIPATN = 1;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao Atualizar Deficiência na Ficha Médica.';
          END;
        ELSE
          IF (:NEW.CODDEF = 0) AND (:OLD.CODDEF <> 0) THEN

            /* Deleta a deficiência antiga do Histórico */
            BEGIN
              DELETE FROM R110HDF
               WHERE NUMEMP = :NEW.NUMEMP
                 AND CODFIC = l_CodFic
                 AND CODDEF = :OLD.CODDEF;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro no DELETE da tabela R110HDF.';
            END;

            /* Atualiza a ficha médica */
            BEGIN
              UPDATE R110FIC SET DEFFIS = :NEW.DEFFIS, CODDEF = :NEW.CODDEF, BENREA = :NEW.BENREA, COTDEF = :NEW.COTDEF
                       WHERE NUMEMP = :NEW.NUMEMP
                         AND TIPCOL = :NEW.TIPCOL
                         AND NUMCAD = :NEW.NUMCAD
                         AND CODFIC = l_CodFic
                         AND TIPATN = 1;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao Atualizar Deficiência na Ficha Médica.';
            END;
          ELSE
			IF (:NEW.CODDEF = :OLD.CODDEF) AND
				((IFNULL(:NEW.DEFFIS, ' ') <> IFNULL(:OLD.DEFFIS, ' ')) OR
			 	 (IFNULL(:NEW.BENREA, ' ') <> IFNULL(:OLD.BENREA, ' ')) OR
			 	 (IFNULL(:NEW.COTDEF, ' ') <> IFNULL(:OLD.COTDEF, ' '))) THEN

              /* Atualiza a ficha médica */
              BEGIN
                UPDATE R110FIC SET DEFFIS = :NEW.DEFFIS, BENREA = :NEW.BENREA, COTDEF = :NEW.COTDEF
                         WHERE NUMEMP = :NEW.NUMEMP
                           AND TIPCOL = :NEW.TIPCOL
                           AND NUMCAD = :NEW.NUMCAD
                           AND CODFIC = l_CodFic
                           AND TIPATN = 1;
              EXCEPTION WHEN OTHERS THEN
                RAISERROR 103 'Erro ao Atualizar Deficiência na Ficha Médica.';
              END;

            END IF;

          END IF;
        END IF;
      END LOOP;

      /* Exclui valor do campo R110TRI.OriOpe */
      RH_DELORIOPE('C');
    END IF;

  /*==========================================================================*/
  /* Sincronização de Colaboradores e Pessoas */

  /* Se existir pessoa vinculada, verificar quais campos foram alterados e atualizar somente estes no cadastro de pessoas */
  IF (:NEW.CODPES > 0) THEN
    /* Insere registro na tabela R134FUN_AUX */
    BEGIN
      INSERT INTO R034FUN_AUX (NUMEMP,TIPCOL,NUMCAD,CODPES,SITAFA)
           VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODPES,:NEW.SITAFA);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao inserir na tabela R034FUN_AUX.';
    END;

    /* Verificar se os campos da R034FUN compativeis com R033PES, foram alterados, se foram atualizar na R033PES */
    IF (:NEW.NOMFUN <> :OLD.NOMFUN) THEN
      BEGIN
        UPDATE R034FUN_AUX SET NOMFUN = :NEW.NOMFUN WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo NOMFUN';
      END;
    END IF;

    IF (:NEW.APEFUN <> :OLD.APEFUN) THEN
      BEGIN
        UPDATE R034FUN_AUX SET APEFUN = :NEW.APEFUN WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo APEFUN';
      END;
    END IF;

    IF (:NEW.TIPSEX <> :OLD.TIPSEX) THEN
      BEGIN
        UPDATE R034FUN_AUX SET TIPSEX = :NEW.TIPSEX WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo TIPSEX';
      END;
    END IF;

    IF (:NEW.ESTCIV <> :OLD.ESTCIV) THEN
      BEGIN
        UPDATE R034FUN_AUX SET ESTCIV = :NEW.ESTCIV WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo ESTCIV';
      END;
    END IF;

    IF (:NEW.NUMCPF <> :OLD.NUMCPF) THEN
      BEGIN
        UPDATE R034FUN_AUX SET NUMCPF = :NEW.NUMCPF WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo NUMCPF';
      END;
    END IF;

    IF (:NEW.DATNAS <> :OLD.DATNAS) THEN
      BEGIN
        UPDATE R034FUN_AUX SET DATNAS = :NEW.DATNAS WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo DATNAS';
      END;
    END IF;

    IF (:NEW.CODNAC <> :OLD.CODNAC) THEN
      BEGIN
        UPDATE R034FUN_AUX SET CODNAC = :NEW.CODNAC WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo CODNAC';
      END;
    END IF;

    IF (:NEW.GRAINS <> :OLD.GRAINS) THEN
      BEGIN
        UPDATE R034FUN_AUX SET GRAINS = :NEW.GRAINS WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo GRAINS';
      END;
    END IF;

    IF (:NEW.DEFFIS <> :OLD.DEFFIS) THEN
      BEGIN
        UPDATE R034FUN_AUX SET DEFFIS = :NEW.DEFFIS WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo DEFFIS';
      END;
    END IF;

    IF (:NEW.CODDEF <> :OLD.CODDEF) THEN
      BEGIN
        UPDATE R034FUN_AUX SET CODDEF = :NEW.CODDEF WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo CODDEF';
      END;
    END IF;

    IF (:NEW.BENREA <> :OLD.BENREA) THEN
      BEGIN
        UPDATE R034FUN_AUX SET BENREA = :NEW.BENREA WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo BENREA';
      END;
    END IF;

    IF (:NEW.RACCOR <> :OLD.RACCOR) THEN
      BEGIN
        UPDATE R034FUN_AUX SET RACCOR = :NEW.RACCOR WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo RACCOR';
      END;
    END IF;

    IF (:NEW.NUMPIS <> :OLD.NUMPIS) THEN
      BEGIN
        UPDATE R034FUN_AUX SET NUMPIS = :NEW.NUMPIS WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo NUMPIS';
      END;
    END IF;

    IF (:NEW.DCDPIS <> :OLD.DCDPIS) THEN
      BEGIN
        UPDATE R034FUN_AUX SET DCDPIS = :NEW.DCDPIS WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo DCDPIS';
      END;
    END IF;

    IF (:NEW.NUMCTP <> :OLD.NUMCTP) THEN
      BEGIN
        UPDATE R034FUN_AUX SET NUMCTP = :NEW.NUMCTP WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo NUMCTP';
      END;
    END IF;

    IF (:NEW.SERCTP <> :OLD.SERCTP) THEN
      BEGIN
        UPDATE R034FUN_AUX SET SERCTP = :NEW.SERCTP WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo SERCTP';
      END;
    END IF;

    IF (:NEW.DIGCAR <> :OLD.DIGCAR) THEN
      BEGIN
        UPDATE R034FUN_AUX SET DIGCAR = :NEW.DIGCAR WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo DIGCAR';
      END;
    END IF;

    IF (:NEW.DEXCTP <> :OLD.DEXCTP) THEN
      BEGIN
        UPDATE R034FUN_AUX SET DEXCTP = :NEW.DEXCTP WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo DEXCTP';
      END;
    END IF;

    IF (:NEW.ESTCTP <> :OLD.ESTCTP) THEN
      BEGIN
        UPDATE R034FUN_AUX SET ESTCTP = :NEW.ESTCTP WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo ESTCTP';
      END;
    END IF;

    /* Se não alterou a pessoa vinculada */
    IF (:OLD.CODPES = :NEW.CODPES) THEN
      /* Atualiza na R034FUN_AUX os campos que foram alterados */

      BEGIN
        UPDATE R034FUN_AUX SET CODBAN = :NEW.CODBAN WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo CODBAN';
      END;

      BEGIN
        UPDATE R034FUN_AUX SET CODAGE = :NEW.CODAGE WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo CODAGE';
      END;

      BEGIN
        UPDATE R034FUN_AUX SET CONBAN = :NEW.CONBAN WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo CONBAN';
      END;

      BEGIN
        UPDATE R034FUN_AUX SET DIGBAN = :NEW.DIGBAN WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo DIGBAN';
      END;

      BEGIN
        UPDATE R034FUN_AUX SET TPCTBA = :NEW.TPCTBA WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo TPCTBA';
      END;
      
      BEGIN
        UPDATE R034FUN_AUX SET TPCPIX = :NEW.TPCPIX WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo TPCTBA';
      END;
      
      BEGIN
        UPDATE R034FUN_AUX SET CHVPIX = :NEW.CHVPIX WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN_AUX campo TPCTBA';
      END;
      
    END IF;
  END IF;
  /*Fim Sicronização*/

  /*INÍCIO VALIDAÇÕES ACESSO*/
  /*ATUALIZAÇÃO DA CONTROLE - R070CON*/
   SP_VerOnLine(l_online OUT);
  /* só atualiza a r070con se atender as condições abaixo.           */
  /* feito desta forma porque não é possível fazer SELECT na r034fun */
  /* durante a execução da procedure que atualiza a repempr002.      */
   IF   (l_online = TRUE) THEN
      IF (:NEW.STAALF = :OLD.STAALF) THEN
         BEGIN
         SELECT  REPONL
         INTO    l_reponl
         FROM    R034DAC
         WHERE   NUMEMP = :NEW.NUMEMP
         AND     TIPCOL = :NEW.TIPCOL
         AND     NUMCAD = :NEW.NUMCAD;
         EXCEPTION
             WHEN NO_DATA_FOUND THEN
                  l_reponl := 'N';
               WHEN OTHERS THEN RAISERROR 103 'R034FUN_EU: Erro no SELECT em R034DAC.';
         END;
      ELSE
         l_reponl := 'X';
      END IF;

      IF (l_reponl <> 'X') THEN
         /* NOME OU PIS OU CPF OU PASSAPORTE DIFERENTES */
         IF ((:NEW.NOMFUN <> :OLD.NOMFUN) OR (:NEW.NUMPIS <> :OLD.NUMPIS) OR (:OLD.NUMCPF <> :NEW.NUMCPF) OR (:OLD.NUMPSP <> :NEW.NUMPSP)) THEN
            R034FUN_ATUCON(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.NOMFUN, :NEW.NUMPIS,:NEW.NUMCPF,:NEW.NUMPSP, l_reponl);
         END IF;

         /* ATUALIZAÇÃO DO NOME NA TABELA R158PES */
         IF (:NEW.NOMFUN <> :OLD.NOMFUN) THEN
            SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
            SP_ATUNOMPES(l_idtpes, :NEW.NOMFUN);
         END IF;

         /*Atualiza a situação da pessoa na memória da CSM Concentradora */
         IF (:NEW.SITAFA <> :OLD.SITAFA) THEN
             SP_PEND95(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.SITAFA);
         END IF;
      END IF;
   END IF;

  /*FIM ATUALIZAÇÃO DA CONTROLE - R070CON*/
  /*FIM VALIDAÇÕES ACESSO*/

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116*/
  IF (:NEW.NOMFUN <> :OLD.NOMFUN) OR (:NEW.DATNAS <> :OLD.DATNAS) OR (:NEW.TIPSEX <> :OLD.TIPSEX) OR
     (:NEW.ESTCIV <> :OLD.ESTCIV) OR (:NEW.RACCOR <> :OLD.RACCOR) OR (:NEW.NUMCPF <> :OLD.NUMCPF) OR
     (:NEW.NUMCTP <> :OLD.NUMCTP) OR (:NEW.SERCTP <> :OLD.SERCTP) OR (:NEW.DIGCAR <> :OLD.DIGCAR) OR
     (:NEW.DEXCTP <> :OLD.DEXCTP) OR (:NEW.NUMPIS <> :OLD.NUMPIS) OR (:NEW.DCDPIS <> :OLD.DCDPIS) OR
     (:NEW.CODDEF <> :OLD.CODDEF) OR (:NEW.GRAINS <> :OLD.GRAINS) OR (:NEW.CODPES <> :OLD.CODPES) THEN
    RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R034FUN');

  IF (l_auditoria = 'S') THEN

       l_camposAlterados := 'Campo(s) alterado(s): ';
       l_alterou := FALSE;

      IF (:NEW.NUMEMP <> :OLD.NUMEMP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMEMP ';
      END IF;

      IF (:NEW.TIPCOL <> :OLD.TIPCOL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPCOL ';
      END IF;

      IF (:NEW.NUMCAD <> :OLD.NUMCAD) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCAD ';
      END IF;

      IF (:NEW.NOMFUN <> :OLD.NOMFUN) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NOMFUN ';
      END IF;

      IF (:NEW.APEFUN <> :OLD.APEFUN) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'APEFUN ';
      END IF;

      IF (:NEW.DATADM <> :OLD.DATADM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATADM ';
      END IF;

      IF (:NEW.SITAFA <> :OLD.SITAFA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SITAFA ';
      END IF;

      IF (:NEW.TIPCON <> :OLD.TIPCON) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPCON ';
      END IF;

      IF (:NEW.TIPSEX <> :OLD.TIPSEX) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPSEX ';
      END IF;

      IF (:NEW.ESTCIV <> :OLD.ESTCIV) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'ESTCIV ';
      END IF;

      IF (:NEW.DATNAS <> :OLD.DATNAS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATNAS ';
      END IF;

      IF (:NEW.CODNAC <> :OLD.CODNAC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODNAC ';
      END IF;

      IF (:NEW.ANOCHE <> :OLD.ANOCHE) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'ANOCHE ';
      END IF;

      IF (:NEW.VISEST <> :OLD.VISEST) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'VISEST ';
      END IF;

      IF (:NEW.REGEST <> :OLD.REGEST) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'REGEST ';
      END IF;

      IF (:NEW.DVLEST <> :OLD.DVLEST) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DVLEST ';
      END IF;

      IF (:NEW.DVLCTP <> :OLD.DVLCTP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DVLCTP ';
      END IF;

      IF (:NEW.NUMCTP <> :OLD.NUMCTP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCTP ';
      END IF;

      IF (:NEW.NUMCPF <> :OLD.NUMCPF) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCPF ';
      END IF;

      IF (:NEW.NUMPIS <> :OLD.NUMPIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMPIS ';
      END IF;

      IF (:NEW.DCDPIS <> :OLD.DCDPIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DCDPIS ';
      END IF;

      IF (:NEW.DATAFA <> :OLD.DATAFA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATAFA ';
      END IF;

      IF (:NEW.HORAFA <> :OLD.HORAFA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORAFA ';
      END IF;

      IF (:NEW.EMPRES <> :OLD.EMPRES) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'EMPRES ';
      END IF;

      IF (:NEW.TIPRES <> :OLD.TIPRES) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPRES ';
      END IF;

      IF (:NEW.CADRES <> :OLD.CADRES) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CADRES ';
      END IF;

      IF (:NEW.TIPTER <> :OLD.TIPTER) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPTER ';
      END IF;

      IF (:NEW.APUPFS <> :OLD.APUPFS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'APUPFS ';
      END IF;

      IF (:NEW.NUMPSP <> :OLD.NUMPSP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMPSP ';
      END IF;

      IF ((:NEW.ESTCAR <> :OLD.ESTCAR) OR (:OLD.ESTCAR IS NULL AND :NEW.ESTCAR IS NOT NULL) OR (:NEW.ESTCAR IS NULL AND :OLD.ESTCAR IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'ESTCAR ';
      END IF;

      IF ((:NEW.CODCAR <> :OLD.CODCAR) OR (:OLD.CODCAR IS NULL AND :NEW.CODCAR IS NOT NULL) OR (:NEW.CODCAR IS NULL AND :OLD.CODCAR IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODCAR ';
      END IF;

      IF ((:NEW.STAALF <> :OLD.STAALF) OR (:OLD.STAALF IS NULL AND :NEW.STAALF IS NOT NULL) OR (:NEW.STAALF IS NULL AND :OLD.STAALF IS NOT NULL)) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'STAALF ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R034FUN_AUD
                   WHERE NUMEMP = :OLD.NUMEMP AND
                         TIPCOL = :OLD.TIPCOL AND
                         NUMCAD = :OLD.NUMCAD;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R034FUN_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,NOMFUN,APEFUN,DATADM,SITAFA,TIPCON,
                                       TIPSEX,ESTCIV,DATNAS,CODNAC,ANOCHE,VISEST,REGEST,DVLEST,DVLCTP,NUMCTP,
                                       NUMCPF,NUMPIS,DCDPIS,DATAFA,HORAFA,EMPRES,TIPRES,CADRES,TIPTER,APUPFS,
                                       NUMPSP,ESTCAR,CODCAR,STAALF)
                               VALUES (l_seqreg,l_verseq,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.NOMFUN,
                                      :NEW.APEFUN,:NEW.DATADM,:NEW.SITAFA,:NEW.TIPCON,:NEW.TIPSEX,:NEW.ESTCIV,
                                      :NEW.DATNAS,:NEW.CODNAC,:NEW.ANOCHE,:NEW.VISEST,:NEW.REGEST,:NEW.DVLEST,
                                      :NEW.DVLCTP,:NEW.NUMCTP,:NEW.NUMCPF,:NEW.NUMPIS,:NEW.DCDPIS,:NEW.DATAFA,
                                      :NEW.HORAFA,:NEW.EMPRES,:NEW.TIPRES,:NEW.CADRES,:NEW.TIPTER,:NEW.APUPFS,
                                      :NEW.NUMPSP,:NEW.ESTCAR,:NEW.CODCAR,:NEW.STAALF);

              SP_AUDGENREG(l_seqreg,l_verseq,'R034FUN',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  l_AlterouInfoVinculo := FALSE;
  l_AlterouInfoCadastral := FALSE;
  l_AlterouInfoContratual := FALSE;
  l_AlterouInfoNascimento := FALSE;
  l_AlterouInfoFGTS := FALSE;

  l_JsonFlags := '';
  l_JsonFlagsCadastral := '';
  l_JsonFlagsVinculo := '';
  l_JsonFlagsContratual := '';
  l_JsonInfoVinculo := '';
  l_JsonInfoCadastral := '';
  l_JsonInfoContratual := '';
  l_layoutAlteracaoCadastral := '';
  l_layout := '';

  l_InfoFacult := TRUE;
  l_SimplificacaoESocial := FALSE;
  l_VersaoESocial := 0;
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificacaoESocial OUT, l_VersaoESocial OUT);
  
  /* Inicia l_layout  */
  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
    
  /* Campos monitorados para alteração Cadastral */
  SP_VALUPDATE_DES(:OLD.NOMFUN, :NEW.NOMFUN, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
	l_AlterouInfoCadastral := TRUE;
	SP_CONCAT_DES_JSON('NOMFUN', :NEW.NomFun, :OLD.NomFun, l_JsonInfoCadastral OUT);
  END IF;

  SP_VALUPDATE_DES(:OLD.TIPSEX, :NEW.TIPSEX, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
	l_AlterouInfoCadastral := TRUE;
	SP_CONCAT_DES_JSON('TIPSEX', :NEW.TipSex, :OLD.TipSex, l_JsonInfoCadastral OUT);
  END IF;

  SP_VALUPDATE_NUM(:OLD.RACCOR, :NEW.RACCOR, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    SP_ALT_ETNIA_ESOC(:OLD.RACCOR, :NEW.RACCOR, l_EtniaEsocialAlterada OUT);
    IF (l_EtniaESocialAlterada = TRUE) THEN 
	  l_AlterouInfoCadastral := TRUE;
	  SP_CONCAT_NUM_JSON('RACCOR', :NEW.RacCor, :OLD.RacCor, l_JsonInfoCadastral OUT);
    END IF;	  
  END IF;

  SP_VALUPDATE_NUM(:OLD.ESTCIV, :NEW.ESTCIV, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
	l_AlterouInfoCadastral := TRUE;
	SP_CONCAT_NUM_JSON('ESTCIV', :NEW.EstCiv, :OLD.EstCiv, l_JsonInfoCadastral OUT);
  END IF;
  
  IF (l_layout <> 'S-2400') THEN  

    SP_VALUPDATE_NUM(:OLD.GRAINS, :NEW.GRAINS, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
  	  l_AlterouInfoCadastral := TRUE;
  	  SP_CONCAT_NUM_JSON('GRAINS', :NEW.GraIns, :OLD.GraIns, l_JsonInfoCadastral OUT);
    END IF;
    
    IF ((l_InfoFacult = TRUE) AND (l_SimplificacaoESocial = FALSE)) THEN
      SP_VALUPDATE_NUM(:OLD.NUMCTP, :NEW.NUMCTP, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
    	  l_AlterouInfoCadastral := TRUE;
   	  SP_CONCAT_NUM_JSON('NUMCTP', :NEW.NumCtp, :OLD.NumCtp, l_JsonInfoCadastral OUT);
      END IF;
    
      SP_VALUPDATE_DES(:OLD.SERCTP, :NEW.SERCTP, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
  	    l_AlterouInfoCadastral := TRUE;
  	    SP_CONCAT_DES_JSON('SERCTP', :NEW.SerCtp, :OLD.SerCtp, l_JsonInfoCadastral OUT);
      END IF;
    
      SP_VALUPDATE_DES(:OLD.ESTCTP, :NEW.ESTCTP, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
  	    l_AlterouInfoCadastral := TRUE;
  	    SP_CONCAT_DES_JSON('ESTCTP', :NEW.EstCtp, :OLD.EstCtp, l_JsonInfoCadastral OUT);
      END IF;
    END IF;
    
    /*Somente irá verificar estes campos se o colaborador não tiver ficha médica.
      Pois a R110HDF já irá gerar as pendências conforme necessário */
    IF ((l_CodFic = 0) OR (l_CodFic IS NULL)) THEN
      SP_VALUPDATE_NUM(:OLD.CODDEF, :NEW.CODDEF, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
    	  l_AlterouInfoCadastral := TRUE;
    	  SP_CONCAT_NUM_JSON('CODDEF', :NEW.CodDef, :OLD.CodDef, l_JsonInfoCadastral OUT);
      END IF;
    
  	  SP_VALUPDATE_DES(:OLD.DEFFIS, :NEW.DEFFIS, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        IF (((:OLD.DefFis <> 'S') AND (:NEW.DefFIs = 'S') AND (:NEW.CODDEF > 0)) OR
    	      ((:OLD.DefFis = 'S' ) AND (:OLD.CODDEF > 0) AND (:NEW.DefFis <> 'S'))) THEN
  	      l_AlterouInfoCadastral := TRUE;
  	      SP_CONCAT_DES_JSON('DEFFIS', :NEW.DefFis, :OLD.DefFis, l_JsonInfoCadastral OUT);
  	    END IF;
      END IF;
    END IF;
    
    SP_VALUPDATE_DES(:OLD.BENREA, :NEW.BENREA, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouInfoCadastral := TRUE;
      SP_CONCAT_DES_JSON('BENREA', :NEW.BenRea, :OLD.BenRea, l_JsonInfoCadastral OUT);
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.CODPRO, :NEW.CODPRO, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
      IF(l_SimplificacaoESocial = TRUE AND l_layout = 'S-2300') THEN
        l_AlterouInfoVinculo := TRUE;
  	  ELSE 
        l_AlterouInfoContratual := TRUE;
  	  END IF;
  	  SP_CONCAT_NUM_JSON('CODPRO', :NEW.CodPro, :OLD.CodPro, l_JsonInfoContratual OUT);
    END IF;
    
    SP_VALUPDATE_DES(:OLD.TIPOPC, :NEW.TIPOPC, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
    	SP_CONCAT_DES_JSON('TIPOPC', :NEW.TipOpc, :OLD.TipOpc, l_JsonInfoVinculo OUT);
    	l_AlterouInfoFGTS := TRUE;
    END IF;
    
    SP_VALUPDATE_DAT(:OLD.DATOPC, :NEW.DATOPC, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
  	  SP_CONCAT_DAT_JSON('DATOPC', :NEW.DatOpc, :OLD.DatOpc, l_JsonInfoVinculo OUT);
  	  l_AlterouInfoFGTS := TRUE;
    END IF;
    
    SP_VALUPDATE_DES(:OLD.COTDEF, :NEW.COTDEF, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
      IF (l_layout <> 'S-2300') THEN  
        SP_CONCAT_DES_JSON('COTDEF', :NEW.CotDef, :OLD.CotDef, l_JsonInfoCadastral OUT);
        l_AlterouInfoCadastral := TRUE;
      END IF;
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.CODNAC, :NEW.CODNAC, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      SP_CONCATENAR_NUM('CODNAC', :NEW.CODNAC, l_JsonFlags OUT);
      SP_CONCAT_NUM_JSON('CODNAC', :NEW.CodNac, :OLD.CodNac, l_JsonInfoCadastral OUT);
      SP_CONCAT_NUM_JSON('CODNAC', :NEW.CodNac, :OLD.CodNac, l_JsonInfoVinculo OUT);
      
      IF (l_SimplificacaoESocial = FALSE) THEN
        l_AlterouInfoNascimento := TRUE;
      END IF;
      
      /* Se está na simplificação deve retificar ambos os leiautes S-2X00 e S2205 para nacionalidade
       * sem usar a flag de nascimento */
      IF (l_SimplificacaoESocial = TRUE) THEN
        l_AlterouInfoCadastral := TRUE;
        l_AlterouInfoVinculo := TRUE;
      END IF;
    END IF;
  END IF;

  SP_VALUPDATE_DAT(:OLD.DATNAS, :NEW.DATNAS, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    IF (l_SimplificacaoESocial = FALSE) THEN
      SP_CONCAT_DAT_JSON('DATNAS', :NEW.DatNas, :OLD.DatNas, l_JsonInfoCadastral OUT);
      SP_CONCAT_DAT_JSON('DATNAS', :NEW.DatNas, :OLD.DatNas, l_JsonInfoVinculo OUT);
      l_AlterouInfoNascimento := TRUE;
    END IF;
    
    /* Se está na simplificação retifica apenas S-2200/S-2300 */
    IF (l_SimplificacaoESocial = TRUE) THEN
      SP_CONCAT_DAT_JSON('DATNAS', :NEW.DatNas, :OLD.DatNas, l_JsonInfoVinculo OUT);
      l_AlterouInfoVinculo := TRUE;
    END IF;
  END IF;


  l_JsonFlagsCadastral := l_JsonFlags;
  l_JsonFlagsVinculo := l_JsonFlags;
  l_JsonFlagsContratual := l_JsonFlags;

  SP_VALUPDATE_DAT(:OLD.DATADM, :NEW.DATADM, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    SP_CONCAT_DAT_JSON('DATADM', :NEW.DatAdm, :OLD.DatAdm, l_JsonInfoVinculo OUT);
    SP_CONCATENAR_DAT('DATADM', :NEW.DatAdm, l_JsonFlagsVinculo OUT);
    l_AlterouInfoVinculo := TRUE;
  END IF;

  /* Flag para sinalizar que alterou exclusivamente informações de nascimento */
  IF (l_AlterouInfoNascimento = TRUE) THEN
    IF ((l_AlterouInfoVinculo = FALSE) AND (l_AlterouInfoFGTS = FALSE)) THEN
      SP_CONCATENAR_DES('INFNAS', '0', l_JsonFlagsVinculo OUT);
    END IF;
    IF (l_AlterouInfoCadastral = FALSE) THEN
      SP_CONCATENAR_DES('INFNAS', '0', l_JsonFlagsCadastral OUT);
    END IF;
  END IF;

  /* Flag para sinalizar que alterou exclusivamente informações de FGTS */
  IF ((l_AlterouInfoFGTS = TRUE) AND (l_AlterouInfoVinculo = FALSE) AND (l_AlterouInfoNascimento = FALSE)) THEN
    SP_CONCATENAR_DES('INFFGT', '0', l_JsonFlagsVinculo OUT);
  END IF;

  IF (l_AlterouInfoNascimento = TRUE) THEN
    l_AlterouInfoCadastral := TRUE;
    l_AlterouInfoVinculo := TRUE;
  END IF;
 
  IF (l_layout <> 'S-2400') THEN
    IF (l_AlterouInfoFGTS = TRUE) THEN
      l_AlterouInfoVinculo := TRUE;
    END IF;
  END IF;
  
  /*  S-2205                                  S-2206                             S-2200, S-2300           */
  IF ((l_AlterouInfoCadastral = TRUE) OR (l_AlterouInfoContratual = TRUE) OR (l_AlterouInfoVinculo = TRUE)) THEN
    RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);

    IF (l_layout IS NOT NULL) THEN
      l_DataAlteracao := CURDATE();

   	  IF (l_AlterouInfoContratual = TRUE) THEN
        IF (l_layout <> 'S-2300') THEN
  	      SP_E_SOCIAL('S-2206', 'R034FUN', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_JsonFlagsContratual, l_JsonInfoContratual, 0, NULL, l_DataAlteracao, 0, 'R034FUN_EU');
  	    END IF;
  	  END IF;

      IF (l_AlterouInfoCadastral = TRUE) THEN
	    SP_CONCATENAR_NUM('CATESO', :NEW.CATESO, l_JsonFlagsCadastral OUT);
        RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
		
	    SP_E_SOCIAL(l_layoutAlteracaoCadastral, 'R034FUN', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_JsonFlagsCadastral, l_JsonInfoCadastral, 0, NULL, l_DataAlteracao, 0, 'R034FUN_EU');
      END IF;

	  IF (l_AlterouInfoVinculo = TRUE) THEN
   	    SP_CONCATENAR_DAT('DATALT', l_DataAlteracao, l_JsonFlagsVinculo OUT);
	    SP_CONCATENAR_NUM('CATESO', :NEW.CATESO, l_JsonFlagsVinculo OUT);

		SP_E_SOCIAL(l_layout, 'R034FUN', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_JsonFlagsVinculo, l_JsonInfoVinculo, 0, NULL, l_DataAlteracao, 0, 'R034FUN_EU');
	  END IF;
    END IF;
  END IF;


  /* Geração de histórico da ficha básica */
  IF ((:OLD.nomfun<>:NEW.nomfun)
  OR (:OLD.apefun<>:NEW.apefun)
  OR (:OLD.tipsex<>:NEW.tipsex)
  OR (:OLD.raccor<>:NEW.raccor)
  OR (:OLD.estciv<>:NEW.estciv)
  OR (:OLD.grains<>:NEW.grains)
  OR (:OLD.datnas<>:NEW.datnas)
  OR (:OLD.codnac<>:NEW.codnac)
  OR (:OLD.numctp<>:NEW.numctp)
  OR (:OLD.serctp<>:NEW.serctp)
  OR (:OLD.digcar<>:NEW.digcar)
  OR (:OLD.estctp<>:NEW.estctp)
  OR (:OLD.dexctp<>:NEW.dexctp)
  OR (:OLD.numcpf<>:NEW.numcpf)
  OR (:OLD.numpis<>:NEW.numpis)
  OR (:OLD.dcdpis<>:NEW.dcdpis)
  OR (:OLD.movsef<>:NEW.movsef)
  OR (:OLD.irrise<>:NEW.irrise)
  OR (:OLD.apoida<>:NEW.apoida)
  OR (:OLD.emtcar<>:NEW.emtcar)
  OR (:OLD.numins<>:NEW.numins)
  OR (:OLD.coddef<>:NEW.coddef)
  OR (:OLD.deffis<>:NEW.deffis)
  OR (:OLD.benrea<>:NEW.benrea)
  OR (:OLD.nmfun1<>:NEW.nmfun1)
  OR (:OLD.nmfun2<>:NEW.nmfun2)
  OR (:OLD.nmfun3<>:NEW.nmfun3)
  OR (:OLD.nmfun4<>:NEW.nmfun4)
  OR (:OLD.codpro<>:NEW.codpro)
  OR (:OLD.anoche<>:NEW.anoche)
  OR (:OLD.visest<>:NEW.visest)
  OR (:OLD.dvlest<>:NEW.dvlest)
  OR (:OLD.regest<>:NEW.regest)
  OR (:OLD.dvlctp<>:NEW.dvlctp)
  OR (:OLD.docest<>:NEW.docest)
  OR (:OLD.datche<>:NEW.datche)
  OR (:OLD.numpsp<>:NEW.numpsp)
  OR (:OLD.datadm<>:NEW.datadm)
  OR (:OLD.tipadm<>:NEW.tipadm)
  OR (:OLD.tipcon<>:NEW.tipcon)
  OR (:OLD.tipopc<>:NEW.tipopc)
  OR (:OLD.datopc<>:NEW.datopc)
  OR (:OLD.confgt<>:NEW.confgt)
  OR (:OLD.modpag<>:NEW.modpag)
  OR (:OLD.codban<>:NEW.codban)
  OR (:OLD.codage<>:NEW.codage)
  OR (:OLD.conban<>:NEW.conban)
  OR (:OLD.digban<>:NEW.digban)
  OR (:OLD.perpag<>:NEW.perpag)
  OR (:OLD.recadi<>:NEW.recadi)
