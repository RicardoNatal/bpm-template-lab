			l_Alterou := TRUE;
			SP_CONCAT_FLO_JSON('VLRR65', :NEW.VLRR65, :OLD.VLRR65, 2, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_NUM(:OLD.VLRJUR, :NEW.VLRJUR, l_Valido OUT);
