END␀␀␀Ÿ␀␀␀␀␀␀␀␀ÈØ␀␀…¬␀␀´␀„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t„␀␀␀␀␀␀Ü␀t␀Ü␀n;‰␀Æÿ␀␀ÿ␀c¬␀␀Ì␀„␀␀␀␀␀␀$0.0.w8‰␀Æÿ␀␀ÿ␀EÑ␀„␀␀␀␀␀␀ñIîIîIqC9‰␀êÿ␀␀ÿ␀¸,´␀„␀␀␀␀␀␀AìzÚ«␀␀r:‰␀Æÿ␀␀ÿ␀È,Ì␀„␀␀␀␀␀␀¿@”␀␀”␀␀)␀␀Æÿ␀␀ÛÎ␀␀␀␀Ã„␀␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀␀␀␀	 ␀␀␀␀␀␀␀␀␀ĞØ␀␀…¬␀␀´␀	„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	„␀␀␀␀␀␀Ü␀t␀Ü␀n5‰␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	„␀␀␀␀␀␀$0.0.w1‰␀Æÿ␀␀…Ó␀␀␀EÑ␀	„␀␀␀␀␀␀G]G]GqC3‰␀êÿ␀␀ÿ␀¤w·␀	„␀␀␀␀␀␀wxdxdxì*␀␀Æÿ␀␀ÿ␀åDÑ␀„␀␀␀␀␀␀GÔFÔFqC2‰␀êÿ␀␀ÿ␀w·␀„␀␀␀␀␀␀Nx<x<xì*␀␀Æÿ␀␀ÿ␀C-·␀„␀␀␀␀␀␀À¿␀␀£¿␀␀£¿␀␀t4‰␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀„␀␀␀␀␀␀Â¿␀␀¨¿␀␀©¿␀␀t␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀„␀␀␀␀␀␀Ã¿␀␀±¿␀␀²¿␀␀t␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀„␀␀␀␀␀␀Á¿␀␀¥¿␀␀¦¿␀␀t␀Æÿ␀␀ı×␀␀␀Ìa´␀„␀␀␀␀␀␀¯<•awbr␀Æÿ␀␀Ò␀␀␀=␀t„␀␀␀␀␀␀m␀§␀§␀n␀Æÿ␀␀ˆÓ␀␀␀:$Ì␀„␀␀␀␀␀␀ %$†$w␀Æÿ␀␀…Ó␀␀␀␀Ã„␀␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀×-‹␀„␀␀␀␀␀␀¦Am␀m␀—)␀␀Æÿ␀␀ÿ␀ş␀␀¢␀␀␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀␀␀␀	0;1;2;3;4×Ø␀␀	SENIOR;0S␀␀TRIGGER R064TPE_SI AFTER INSERT ON R064TPE

DECLARE
l_count        NUMBER(5);
  l_data_zero    DATE;
  l_comando_nulo BOOLEAN;
  l_strerr       VARCHAR2(255);

/* CURSOR c/ os registros gravados no R064tpe_AUX */
  CURSOR c_r064tpe_ins IS SELECT NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,DATFIM,HORFIM,CODPRM,STAACC FROM R064TPE_AUX;
  TYPE t_r064TPE_aux IS RECORD(
    NUMEMP   R064TPE_AUX.NUMEMP%TYPE,
    TIPCOL   R064TPE_AUX.TIPCOL%TYPE,
    NUMCAD   R064TPE_AUX.NUMCAD%TYPE,
    DATINI   R064TPE_AUX.DATINI%TYPE,
    HORINI   R064TPE_AUX.HORINI%TYPE,
    DATFIM   R064TPE_AUX.DATFIM%TYPE,
    HORFIM   R064TPE_AUX.HORFIM%TYPE,
    CODPRM   R064TPE_AUX.CODPRM%TYPE,
    STAACC   R064TPE_AUX.STAACC%TYPE);
  l_r064TPE_aux t_r064TPE_aux;

BEGIN
  l_comando_nulo:=FALSE;
  l_data_zero  := '31/12/1900,00:00:00';

  /* Le Registro do CURSOR */
  FOREACH c_r064tpe_ins INTO  l_r064TPE_aux.NUMEMP,
                              l_r064TPE_aux.TIPCOL,
                              l_r064TPE_aux.NUMCAD,
                              l_r064TPE_aux.DATINI,
                              l_r064TPE_aux.HORINI,
                              l_r064TPE_aux.DATFIM,
                              l_r064TPE_aux.HORFIM,
                              l_r064TPE_aux.CODPRM,
                              l_r064TPE_aux.STAACC
  LOOP
    l_count := 0;
    BEGIN
      SELECT COUNT(*) INTO l_count
       FROM R064TPE A
      WHERE  A.NUMEMP = l_r064tpe_aux.NUMEMP
        AND  A.TIPCOL = l_r064tpe_aux.TIPCOL
        AND  A.NUMCAD = l_r064tpe_aux.NUMCAD
        AND (A.DATINI <> l_r064tpe_aux.DATINI OR (A.DATINI = l_r064tpe_aux.DATINI AND A.HORINI <> l_r064tpe_aux.HORINI))
        AND ( ( (A.DATINI > l_r064tpe_aux.DATINI OR (A.DATINI = l_r064tpe_aux.DATINI AND A.HORINI >= l_r064tpe_aux.HORINI)) AND
                (A.DATINI < l_r064tpe_aux.DATFIM OR l_r064tpe_aux.DATFIM = l_data_zero OR (A.DATINI = l_r064tpe_aux.DATFIM AND (A.HORINI <= l_r064tpe_aux.HORFIM OR l_r064tpe_aux.HORFIM = 0))) )
         OR   ( (A.DATFIM > l_r064tpe_aux.DATINI OR A.DATFIM = l_data_zero OR (A.DATFIM = l_r064tpe_aux.DATINI AND (A.HORFIM >= l_r064tpe_aux.HORINI OR A.HORFIM = 0))) AND
                ((A.DATFIM < l_r064tpe_aux.DATFIM AND A.DATFIM <> l_data_zero) OR l_r064tpe_aux.DATFIM = l_data_zero OR (A.DATFIM = l_r064tpe_aux.DATFIM AND (A.HORFIM <= l_r064tpe_aux.HORFIM OR l_r064tpe_aux.HORFIM = 0)))
         OR   ( (l_r064tpe_aux.DATINI > A.DATINI OR (l_r064tpe_aux.DATINI = A.DATINI AND l_r064tpe_aux.HORINI >= A.HORINI)) AND
                ((l_r064tpe_aux.DATFIM < A.DATFIM AND l_r064tpe_aux.DATFIM <> l_data_zero) OR A.DATFIM = l_data_zero OR (l_r064tpe_aux.DATFIM = A.DATFIM AND l_r064tpe_aux.HORFIM <= A.HORFIM)) ) ) );
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_count:=0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro no SELECT R038TPE - em R064TPE_AI';
    END;
    IF  l_count > 0 THEN
        l_strerr := 'Erro de Sobreposição de Permissoes para Empresa = '||
                    CONVERT(NUMBER_TO_CHAR,l_r064tpe_aux.NUMEMP)||' Colaborador = '||
                    CONVERT(NUMBER_TO_CHAR,l_r064tpe_aux.NUMCAD);
        RAISERROR 103 l_strerr;
    END IF;

  END LOOP;

  /* Apaga Registro OLD/NEW em R064TPE_AUX */
  BEGIN
    DELETE FROM R064TPE_AUX;
    DROP_TEMP_TABLE R064TPE_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ÕØ␀␀		SENIOR;0–
␀␀

TRIGGER R064TPE_EI BEFORE INSERT ON R064TPE FOR EACH ROW

DECLARE
  l_codprm      NUMBER(5);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_online      BOOLEAN;
  l_verseq      NUMBER(10);
  l_seqreg      NUMBER(15);
  l_auditoria   CHAR(1);
  l_ade_gerpen  BOOLEAN;
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R064TPE_AUX;
  
BEGIN
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       IF   (:NEW.DATINI < l_data_atual OR
            (:NEW.DATINI = l_data_atual AND :NEW.HORINI <= l_hora_atual)) AND
            (:NEW.DATFIM = l_data_zero OR :NEW.DATFIM > l_data_atual OR
            (:NEW.DATFIM = l_data_atual AND :NEW.HORFIM > l_hora_atual)) THEN
            R064TPE_ATUCON(:NEW.TIPCOL,:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATINI,:NEW.DATFIM,:NEW.CODPRM,:NEW.PRMSAB,:NEW.PRMDOM,:NEW.PRMFER);
       END IF;
  END IF;

  BEGIN
  /* Insere Registro NEW */
    INSERT INTO R064TPE_AUX (NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,DATFIM,HORFIM,CODPRM,STAACC)
    VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI,:NEW.DATFIM,:NEW.HORFIM,:NEW.CODPRM,:NEW.STAACC);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R064TPE_AUX.';
  END;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R064TPE');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R064TPE_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,DATFIM,HORFIM,
                                   CODPRM,PRMFER,PRMSAB,PRMDOM,EMPAUT,TCLAUT,CADAUT,CODUSU,STAACC)
                           VALUES (l_seqreg,l_verseq,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI,
                                   :NEW.DATFIM,:NEW.HORFIM,:NEW.CODPRM,:NEW.PRMFER,:NEW.PRMSAB,:NEW.PRMDOM,
                                   :NEW.EMPAUT,:NEW.TCLAUT,:NEW.CADAUT,:NEW.CODUSU,:NEW.STAACC);

          SP_AUDGENREG(l_seqreg,l_verseq,'R064TPE','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  IF (:NEW.STAACC = 1) THEN
      SP_RECALF_GERPEN_1(:NEW.TIPCOL, l_ade_gerpen OUT);
      IF (l_ade_gerpen = TRUE) THEN
        SP_RECALF_PRMCOL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODPRM, :NEW.PRMSAB, :NEW.PRMDOM, :NEW.PRMFER, NULL, NULL, NULL, NULL, NULL, NULL);
      END IF;
  END IF;
END␀ØØ␀␀	SENIOR;0T␀␀

TRIGGER R064TPE_SU AFTER UPDATE ON R064TPE

DECLARE
l_count        NUMBER(5);
  l_data_zero    DATE;
  l_comando_nulo BOOLEAN;
  l_strerr       VARCHAR2(255);

/* CURSOR c/ os registros gravados no R064tpe_AUX */
