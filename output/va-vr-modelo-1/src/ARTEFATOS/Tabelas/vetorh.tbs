		END IF;
		IF (:OLD.APRSOL <> :NEW.APRSOL AND l_r034EDP.APRSOL <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) OR (l_oridef = 2 AND :NEW.APRSOL = 'S') THEN /* COLABORADOR PODE SER APROVADOR DE SOLICITACAO DE VEICULOS WEB = 'S' EH MAIS ABRANGENTE */
				l_r034DAC.APRSOL := :NEW.APRSOL;
