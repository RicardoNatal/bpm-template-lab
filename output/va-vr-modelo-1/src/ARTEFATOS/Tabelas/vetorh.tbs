	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
BEGIN
	l_Alterou := FALSE;

	SP_VALUPDATE_NUM(:OLD.HORTRB, :NEW.HORTRB, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
	END IF;

	SP_VALUPDATE_DES(:OLD.REGPOL, :NEW.REGPOL, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
	END IF;

	SP_VALUPDATE_NUM(:OLD.TIPLOC, :NEW.TIPLOC, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
	END IF;

