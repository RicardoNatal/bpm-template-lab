␀␀create or replace PROCEDURE SP_GETSESSIONID(pNumSec OUT NUMBER,pProgram OUT VARCHAR2,pMachine OUT VARCHAR2) is
begin
  begin
    SELECT 
      SYS_CONTEXT('USERENV','SESSIONID') EXPR1321648264,SYS_CONTEXT('USERENV','MODULE') EXPR1366320812,SUBSTR(SYS_CONTEXT('USERENV','HOST') ,0 ,20) EXPR764376931
       INTO pNumSec,pProgram,pMachine 
       FROM DUAL DUAL;
  exception
    when OTHERS then
      raise_application_error(-20000 + -(103),'Erro ao obter o ID da sessão da conexão. '||SQLERRM);
  end;
end SP_GETSESSIONID;

	MSSQL;0
u␀␀CREATE  PROCEDURE sp_getsessionid(@pNumSec BIGINT OUTPUT, @pProgram VARCHAR(40) OUTPUT, @pMachine VARCHAR(100) OUTPUT) AS
BEGIN
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  SELECT @ChkError = 0
    SELECT 
      @pProgram=sys.sysprocesses.program_name ,@pMachine=sys.sysprocesses.hostname ,@pNumSec=sys.sysprocesses.spid 
       FROM sys.sysprocesses WHERE SPID = (SELECT @@SPID) 
    SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
    IF @ChkError <> 0
    BEGIN
      GOTO EXC1
    END
    EXC1:
    SELECT @SE_EXC1 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        BEGIN
          RAISERROR('Erro ao obter o ID da sessão da conexão. ',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
FIM:
  RETURN @ChkError
END

	POSTGRESQL;0
ç␀␀CREATE OR REPLACE PROCEDURE SP_GETSESSIONID (pnumsec IN OUT bigint, pprogram IN OUT varchar, pmachine IN OUT varchar)
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN
  BEGIN
    select substring(application_name from 1 for 40), pid, substring(client_hostname from 1 for 20) INTO STRICT pprogram, pnumsec, pmachine from pg_stat_activity where pid = PG_BACKEND_PID();
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      pnumsec := 0;
    WHEN OTHERS THEN
      pnumsec := 0;
  END;

END
$BODY$;␀Iø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
