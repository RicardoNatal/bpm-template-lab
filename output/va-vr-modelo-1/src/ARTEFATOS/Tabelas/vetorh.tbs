	BEGIN
			SELECT COUNT(*) INTO l_temAud_Ins FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 110;
	EXCEPTION
			WHEN OTHERS THEN RAISERROR 103 'TR017PEP_ED: Erro ao realizar o SELECT na tabela R995CTE.';
	END;
	
	l_codRPA := 0;
	
  FOREACH c_r038HPO INTO l_r038HPO.NUMEMP,
                                                    l_r038HPO.TIPCOL,
                                                    l_r038HPO.NUMCAD,
                                                    l_r038HPO.INIATU,
                                                    l_r038HPO.TERATU
  LOOP
	l_numempSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMEMP);
	l_numempSTR := LTRIM(l_numempSTR);
	l_numempSTR := RTRIM(l_numempSTR);

	l_tipcolSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.TIPCOL);
	l_tipcolSTR := LTRIM(l_tipcolSTR);
	l_tipcolSTR := RTRIM(l_tipcolSTR);

	l_numcadSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMCAD);
	l_numcadSTR := LTRIM(l_numcadSTR);
	l_numcadSTR := RTRIM(l_numcadSTR);
   BEGIN
			IF (l_temAud_Ins > 0) THEN
					SP_RET_REG_AUD(l_codRPA OUT);
					INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
													VALUES (l_codRPA, 3, 6, 1, 110, 1, l_data_atual, l_hora_atual, 'FRGERPRM', :OLD.codusu);
					INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
					INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
					INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);
					
					SP_DATSTR(l_r038HPO.INIATU, 'DD/MM/YYYY', l_datSTR OUT);
					SP_INTSTR(0,'HH:MM', l_horSTR OUT);
					l_prmSTR := CONVERT(NUMBER_TO_CHAR, :OLD.CODPRM);
					l_prmSTR := LTRIM(l_prmSTR);
					l_prmSTR := RTRIM(l_prmSTR);					
					INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datSTR);
					INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORINI', l_horSTR);
					INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRM', l_prmSTR);					
					SP_DATSTR(l_r038HPO.TERATU, 'DD/MM/YYYY', l_datSTR OUT);
					SP_INTSTR(1439,'HH:MM', l_horSTR OUT);					
					INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATFIM', l_datSTR);
					INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORFIM', l_horSTR);
					INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR,:OLD.CODUSU));
					INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSPRM', :OLD.OBSPRM);
					INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'EXCLUSÃO');
			END IF;
		  DELETE FROM R070PEC WHERE NUMEMP =  l_r038HPO.NUMEMP AND TIPCOL = l_r038HPO.TIPCOL AND NUMCAD = l_r038HPO.NUMCAD AND DATINI = l_r038HPO.INIATU AND DATFIM = l_r038HPO.TERATU AND CODPRM = :OLD.CODPRM;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'R017PEP_ED: Erro ao fechar os registros da tabela R070PEC';
    END;
  END LOOP;
END␀␀␀¿␀␀␀␀␀␀␀␀›Ğ␀␀š½␀␀­␀	Ôÿ?␀␀␀␀␀uB¿␀␀¿␀␀p␀Æÿ␀␀œĞ␀␀␀UcÔÿ?␀␀␀␀␀áY°V°V`␀␀ÿ␀␀ÿ␀␀␀wÔÿ!␀␀␀␀␀7Rt␀t␀n␀Æÿ␀␀ÿ␀şayÔÿ!␀␀␀␀␀QXbt'n␀Æÿ␀␀ÿ␀émyÔÿ!␀␀␀␀␀Qnw'n␀Æÿ␀␀ÿ␀kš␀␀yÔÿ!␀␀␀␀␀Q€š␀␀y'n␀Æÿ␀␀ÿ␀Ñ(yÔÿ!␀␀␀␀␀QØ!r'n␀Æÿ␀␀ÿ␀_'yÔÿ!␀␀␀␀␀Qµ's'n␀Æÿ␀␀ÿ␀P␀yÔÿ!␀␀␀␀␀Q‚␀~'n␀Æÿ␀␀ÿ25vyÔÿ!␀␀␀␀␀Q:vx'n␀Æÿ␀␀ÿ2Æ␀yÔÿ!␀␀␀␀␀Q␀„'n␀Æÿ␀␀ÿ␀[␀yÔÿ!␀␀␀␀␀QÜ␀q'n␀Æÿ␀␀ÿ␀ê&␀yÔÿ!␀␀␀␀␀Qš(␀…'n␀Æÿ␀␀ÿ␀m␀yÔÿ!␀␀␀␀␀Qx␀€'n␀Æÿ␀␀ÿ␀+	␀yÔÿ!␀␀␀␀␀Qı␀'n␀Æÿ␀␀ÿ␀a'yÔÿ!␀␀␀␀␀
