          /*Controle do Loop.*/
          IF (Length(l_IniVal) > 15 ) THEN
              EXIT;
          END IF;
          l_IniVal := l_IniVal||'0';
      END LOOP;
      /*Data Final*/
      l_DatVal := lTrim(l_r070con.DatVal);
      l_DatVal := rTrim(l_r070con.DatVal);
      IF (l_DatVal IS NULL) THEN
          l_DatVal:= '0000000000000000';
      END IF;
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_DatVal) > 15 ) THEN
              EXIT;
          END IF;
          l_DatVal := l_DatVal||'0';
      END LOOP;

      /* calcula a qtde de provissÃ³rio */
      SP_QTDPRV(p_IdtPes, l_QtdPrv_int  OUT);

      SP_INTSTR(l_QtdPrv_int,'99',l_qtdprv OUT);
			
      /*SitaÃ§Ã£o do CrachÃ¡*/
      SP_INTSTR(l_r070con.SitCra,'99',l_SitCra OUT);
      IF (l_SitCra = '00') THEN
          l_SitCra := '10';
          /*Envia um comando de LockCard para liberar o crachÃ¡ caso o mesmo tenha sido excluÃ­do pela controle*/
          l_Comando := '05'||l_datenv||l_numfis||'0'||l_qtdprv;
          SP_PorCom(l_Comando,'0');
      END IF;

      /*Tecnologia do CrachÃ¡*/
      SP_INTSTR(l_r070con.TecCra,'99',l_TecCra OUT);

      /*Monta o comando dos crachÃ¡s*/
      l_CmdCra := l_CmdCra||l_NumFis||l_TipCra||l_IniVal||l_DatVal||l_SitCra||l_TecCra||l_NumCra ||l_prmaut;
      l_QntCra := l_QntCra + 1;
  END LOOP;
  SP_INTSTR(l_QntCra,'999999999',l_QntCra_str OUT);

  /*Portaria 1510*/

  IF (l_nomfun IS NULL) THEN
    l_tamnom:= 0;
    l_nomfun:= '';
  ELSE
    l_nomfun := lTrim(l_nomfun);
    l_nomfun := rTrim(l_nomfun);
    l_tamnom := Length(l_nomfun);
  END IF;

  /*Se nÃ£o participa do REP manda o nome */
  IF (l_nompes IS NULL) THEN
      l_nompes := ''; /* nÃ£o faz nada */
  ELSE
    l_nomfun := lTrim(l_nompes);
    l_nomfun := rTrim(l_nomfun);
    l_tamnom := Length(l_nomfun);
  END IF;

  /*Monta o Comando do Documento*/
  IF (l_TipDoc IS NULL) OR (l_NumDoc IS NULL) THEN
      l_TipDoc := 0;
      l_NumDoc := '0';
  END IF;

  SP_INTSTR(l_TipDoc,'9',l_TipDoc_str OUT);

  SP_INTSTR(l_RecVis,'9',l_RecVis_str OUT);
  
  l_TamDoc := Length(l_NumDoc);
  SP_INTSTR(l_TamDoc,'99',l_TamDoc_str OUT);

  IF (l_AndVis IS NULL) THEN
  	l_AndVis_str := '000';
  ELSE
  	SP_INTSTR(l_AndVis,'999',l_AndVis_str OUT);
  END IF;

  l_CmdDoc := l_TipDoc_str||l_TamDoc_str||l_NumDoc;
  /*Fim da montagem do comando do documento*/

  IF (l_ConRee IS NULL) THEN
      l_ConRee := '0';
  END IF;

  IF (l_ConRea_str IS NULL) THEN
      l_ConRea_str := '1';
  END IF;
  
  SP_INTSTR(l_tamnom,'999',l_tamnom_str OUT);
  SP_INTSTR(l_numpis,'99999999999',l_numpis_str OUT);
  
  l_Comando := '19'||l_DatEnv||p_IdtPes||l_tamnom_str||l_nomfun||l_numpis_str||l_IniAfa||l_DatAfa||l_VerVal||
              l_BloFal_str||l_ConAdp_str||l_VerPrm_str||
              l_SenCol||l_TemAlm_str||l_ConCre_str||l_ConFai_str||l_VerAfa_str||l_ConInt_str||l_TolInt_str||'03'||
              l_Prmrt1_str||l_Dinpr1||l_Dfnpr1||l_Prmrt2_str||l_Dinpr2||l_Dfnpr2||l_Prmrt3_str||l_Dinpr3||
              l_Dfnpr3||l_DatMsg||l_QtdMsg_str||l_MsgAcc||l_CauBlo||l_FaiAc1||l_FaiAc2||l_FaiAc3||l_FaiAc4||
              l_FaiAc5||l_FaiAc6||l_FaiAc7||l_FaiPt1||l_FaiPt2||l_FaiPt3||l_FaiPt4||l_FaiPt5||l_FaiPt6||l_FaiPt7||
              l_QtdCr1_str||l_QtdCr2_str||l_QtdCr3_str||l_QtdCr4_str||l_QtdCr5_str||l_QtdCr6_str||l_CreFx1||
              l_CreFx2||l_CreFx3||l_CreFx4||l_CreFx5||l_CreFx6||l_FaiRef||l_ConIal_str||l_BloAut_str||l_CodPrm_str||
              l_PrmSab_str||l_PrmDom_str||l_PrmFer_str||l_UsaBio_str||l_graCon_str||l_ValAut_str||l_ConRea_str||
              l_ConRee||
              l_CmdDoc||l_QntCra_str||l_CmdCra||l_RecVis_str||l_AndVis_str||l_UsaRfa_str;
              
  /*Envia a PendÃªncia com parÃ¢metro zero = envia para todas as CSM*/
  SP_PorCom(l_Comando,'0');

  /*Envia a biometria da pessoa (se possuir)*/
  FOREACH c_r070bio INTO l_r070bio.CodTbi
  LOOP
      l_Comando := '24'||l_datenv||p_idtpes||CONVERT(NUMBER_TO_CHAR,l_r070bio.CodTbi);
      SP_PorCom(l_Comando, '0');
  END LOOP;
END		SENIOR;237SP_DATSTR
