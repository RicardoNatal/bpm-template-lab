    END IF;
    l_contfai := 0;
    LOOP
        IF  (l_contfai >= l_lengfai) THEN
            EXIT;
        END IF;
        l_faiqui_ace := l_faiqui_ace || '24002400';
        l_contfai := l_contfai + 1;
    END LOOP;

    l_faisex_ace := IFNULL(l_faisex_ace,'');
    IF  (l_faisex_ace IS NULL) OR (l_faisex_ace = '') THEN
        l_lengfai := 7;
        l_faisex_ace := '';
    ELSE
        l_lengfai := (56 - LENGTH(l_faisex_ace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
        IF  (l_contfai >= l_lengfai) THEN
            EXIT;
        END IF;
        l_faisex_ace := l_faisex_ace || '24002400';
        l_contfai := l_contfai + 1;
    END LOOP;

    l_faisab_ace := IFNULL(l_faisab_ace,'');
    IF  (l_faisab_ace IS NULL) OR (l_faisab_ace = '') THEN
        l_lengfai := 7;
        l_faisab_ace := '';
    ELSE
        l_lengfai := (56 - LENGTH(l_faisab_ace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
        IF  (l_contfai >= l_lengfai) THEN
            EXIT;
        END IF;
        l_faisab_ace := l_faisab_ace || '24002400';
        l_contfai := l_contfai + 1;
    END LOOP;

    l_faidom_ace  := SUBSTRING(l_faidom_ace,1,56);
    l_faiseg_ace  := SUBSTRING(l_faiseg_ace,1,56);
    l_faiter_ace  := SUBSTRING(l_faiter_ace,1,56);
    l_faiqua_ace  := SUBSTRING(l_faiqua_ace,1,56);
    l_faiqui_ace  := SUBSTRING(l_faiqui_ace,1,56);
    l_faisex_ace  := SUBSTRING(l_faisex_ace,1,56);
    l_faisab_ace  := SUBSTRING(l_faisab_ace,1,56);
  END IF;  /*If atualiza*/

  p_faidom_ace  := l_faidom_ace;
  p_faiseg_ace  := l_faiseg_ace;
  p_faiter_ace  := l_faiter_ace;
  p_faiqua_ace  := l_faiqua_ace;
  p_faiqui_ace  := l_faiqui_ace;
  p_faisex_ace  := l_faisex_ace;
  p_faisab_ace  := l_faisab_ace;
END		SENIOR;24SP_INTSTR
