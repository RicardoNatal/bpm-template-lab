       R038HEB.INIETB-1 FIMETB,
       0 CODETB
  FROM R038HEB, R034FUN
 WHERE R034FUN.NUMEMP = R038HEB.NUMEMP
   AND R034FUN.TIPCOL = R038HEB.TIPCOL
   AND R034FUN.NUMCAD = R038HEB.NUMCAD
   AND R038HEB.INIETB = (SELECT MIN(B.INIETB) FROM R038HEB B 
                          WHERE R034FUN.NUMEMP = B.NUMEMP
                            AND R034FUN.TIPCOL = B.TIPCOL
                            AND R034FUN.NUMCAD = B.NUMCAD)
                            AND R034FUN.DATADM < R038HEB.INIETB

UNION

SELECT A.NUMEMP,
       A.TIPCOL,
       A.NUMCAD,
       A.DATADM INIETB,
       DAY(2059,12,31) FIMETB,
       0 CODETB
  FROM R034FUN A
 WHERE NOT EXISTS (SELECT 1 
                     FROM R038HEB B
                    WHERE A.NUMEMP=B.NUMEMP
                      AND A.TIPCOL=B.TIPCOL
                      AND A.NUMCAD=B.NUMCAD)
                      
UNION

SELECT A.NUMEMP, 
       A.TIPCOL, 
       A.NUMCAD, 
       A.FIMETB+1 
       INIETB,
       B.INIETB-1 FIMETB,
       0 CODETB
  FROM R038HEB A, R038HEB B
 WHERE A.FIMETB+1 < TODAY
   AND A.NUMEMP = B.NUMEMP
   AND A.TIPCOL = B.TIPCOL
   AND A.NUMCAD = B.NUMCAD
   AND B.INIETB>A.FIMETB+1
   AND B.INIETB = ( SELECT MIN(INIETB) 
                      FROM R038HEB D
                     WHERE D.NUMEMP = A.NUMEMP
                       AND D.TIPCOL = A.TIPCOL
                       AND D.NUMCAD = A.NUMCAD
                       AND D.INIETB > A.FIMETB )
   AND NOT EXISTS (SELECT 1 
                     FROM R038HEB C
                    WHERE A.NUMEMP=C.NUMEMP
                      AND A.NUMCAD=C.NUMCAD
                      AND A.TIPCOL=C.TIPCOL
                      AND (A.FIMETB=C.INIETB OR A.FIMETB=C.INIETB + 1)
                      AND A.INIETB<>C.INIETB)
   AND A.FIMETB <> DAY(1900,12,31)
   
UNION

SELECT A.NUMEMP,
       A.TIPCOL,
       A.NUMCAD,
       A.FIMETB+1 INIETB,
       DAY(2059,12,31) FIMETB,
       0 CODETB
  FROM R038HEB A
 WHERE A.FIMETB = (SELECT MAX(B.FIMETB) 
                     FROM R038HEB B 
                    WHERE A.NUMEMP=B.NUMEMP
                      AND A.TIPCOL=B.TIPCOL
                      AND A.NUMCAD=B.NUMCAD)
   AND A.FIMETB < TODAY
   AND A.FIMETB > A.INIETB
AND (SELECT COUNT(1) FROM R038HEB C
                    WHERE A.NUMEMP=C.NUMEMP
                      AND A.TIPCOL=C.TIPCOL
                      AND A.NUMCAD=C.NUMCAD AND C.FIMETB = DAY(1900,12,31)) = 0␀␀ÿ©␀}²␀␀D␀␀␀␀␀␀␀␀Ä␀␀‘¶␀␀•¶␀␀m␀␀␀␀ÿ␀␀ÿ␀ó¥␀␀´␀␀␀␀␀␀␀␀␀F°␀␀XbXbr␀Æÿ␀␀ÿ␀W␀Š␀␀␀␀␀␀␀␀␀É␀t␀Ü␀n¼‡␀Æÿ␀␀ÿ␀ê¥␀␀Ì␀␀␀␀␀␀␀␀␀‚%0.0.w¼‡␀Æÿ␀␀ÿ␀¹¥␀␀U␀␀␀␀␀␀␀␀ª␀␀¨␀␀ç§␀␀Vë‡␀␀ÿ␀␀ÿ␀#´␀␀␀␀␀␀␀␀␀4Bt"t"r␀Æÿ␀␀ÿ␀³¥␀␀␀␀␀␀␀␀␀␀$X²V²V␀␀ÿ␀␀ÿ␀F‰␀␀±␀	␀␀␀␀␀␀␀␀3B¦•␀␀¦•␀␀O)␀␀Æÿ␀␀ÿ␀º¥␀␀U␀␀␀␀␀␀␀␀±Y³V³VV␀␀ÿ␀␀ÿ␀$␀Ÿ␀␀␀␀␀␀␀␀␀$$␀Ì!␀c!␀l)␀␀Æÿ␀␀ÿ␀'␀Ÿ␀␀␀␀␀␀␀␀␀#$␀–!␀–!␀Z␀Æÿ␀␀ÿ␀Y#E␀␀␀␀␀␀␀␀ 555G␀␀ÿ␀␀ÿ␀†¸␀␀Ñ␀␀␀␀␀␀␀␀␀&0Ó/Ó/œ␀␀␀êÿ␀␀ÿ␀+"␀␀␀␀␀␀␀␀)Ô!
)b␀␀␀ÿ␀␀ÿ␀␀0␀␀ SELECT 'CTB' ORILAN, R048CTB.NUMEMP, R048CTB.TIPCOL, R048CTB.NUMCAD, R034FUN.NOMFUN, R048CTB.CODCLC, R048CLC.NOMCON,
