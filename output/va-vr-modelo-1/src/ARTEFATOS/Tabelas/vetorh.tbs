óÅ␀␀CREATE  PROCEDURE sp_matgrp(@p_numcra BIGINT, @p_tippes INTEGER, @p_numemp FLOAT, @p_tipcol INTEGER, @p_numcad FLOAT, @p_tipdoc INTEGER, @p_numdoc VARCHAR(20), @p_nummat VARCHAR(15)) AS
BEGIN
  DECLARE @l_icard CHAR(12)
  DECLARE @l_data_zero DATETIME
  DECLARE @l_data_atual DATETIME
  DECLARE @l_hora_atual SMALLINT
  DECLARE @l_grupo CHAR(3)
  DECLARE @l_grupo_5 CHAR(5)
  DECLARE @l_datini CHAR(8)
  DECLARE @l_datfim CHAR(8)
  DECLARE @l_horini CHAR(4)
  DECLARE @l_horfim CHAR(4)
  DECLARE @l_inigrp DATETIME
  DECLARE @l_fimgrp DATETIME
  DECLARE @l_matgrp CHAR(1)
DECLARE @l_numbar BIGINT
DECLARE @l_numpro BIGINT
DECLARE @l_numsma BIGINT
DECLARE @l_crapri BIGINT
DECLARE @l_tecpri SMALLINT
DECLARE @l_chcpri BIGINT
DECLARE @l_ediprm CHAR(5)
DECLARE @l_newprm NUMERIC(1,0)
DECLARE @l_compila CHAR(1)
DECLARE @l_dat_conv VARCHAR(25)
DECLARE @l_usutel VARCHAR(21)
DECLARE @l_comando NVARCHAR(2048)
DECLARE @l_numbarprov BIGINT
DECLARE @l_numproprov BIGINT
DECLARE @l_numsmaprov BIGINT
DECLARE @l_crapriprov BIGINT
DECLARE @l_tecpriprov SMALLINT
DECLARE @l_r070PEC_CODPRM INTEGER
DECLARE @l_r070PEC_DATINI DATETIME
DECLARE @l_r070PEC_HORINI INTEGER
DECLARE @l_r070PEC_DATFIM DATETIME
DECLARE @l_r070PEC_HORFIM INTEGER
DECLARE @l_r070PEV_CODPRM INTEGER
DECLARE @l_r070PEV_DATINI DATETIME
DECLARE @l_r070PEV_HORINI INTEGER
DECLARE @l_r070PEV_DATFIM DATETIME
DECLARE @l_r070PEV_HORFIM INTEGER
DECLARE @l_r070PEO_CODPRM INTEGER
DECLARE @l_r070PEO_DATINI DATETIME
DECLARE @l_r070PEO_HORINI INTEGER
DECLARE @l_r070PEO_DATFIM DATETIME
DECLARE @l_r070PEO_HORFIM INTEGER
DECLARE @l_r070PEA_CODPRM INTEGER
DECLARE @l_r070PEA_DATINI DATETIME
DECLARE @l_r070PEA_HORINI INTEGER
DECLARE @l_r070PEA_DATFIM DATETIME
DECLARE @l_r070PEA_HORFIM INTEGER
  DECLARE @l_craprov BIGINT
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @SE_EXC2 INTEGER
  DECLARE @SE_EXC4 INTEGER
  DECLARE @SE_EXC5 INTEGER
  DECLARE @SE_EXC6 INTEGER
  DECLARE @SE_EXC8 INTEGER
  DECLARE @SE_EXC10 INTEGER
  DECLARE @SE_EXC11 INTEGER
  DECLARE @SE_EXC12 INTEGER
  DECLARE @l_idtpes VARCHAR(23)
  DECLARE @l_icardA CHAR(12)
  DECLARE @l_icardR CHAR(12)
  DECLARE @l_numser VARCHAR(12)

  SELECT @ChkError = 0
  EXECUTE SP_USUTEL @l_usutel OUT
  SELECT @l_data_atual = CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(MM, GETDATE())))) + '/' + LTRIM(RTRIM(STR(DATEPART(DD, GETDATE())))) + '/' + LTRIM(RTRIM(STR(DATEPART(YY, GETDATE())))))
  SELECT @l_hora_atual = DATEPART(HOUR,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))*60+DATEPART(MINUTE,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))
  SELECT @l_data_zero =  CONVERT(DATETIME,'12/31/1900 00:00:00', 101)
  EXECUTE SP_RETIDTPES @p_numemp, @p_tipcol, @p_numcad, NULL, NULL, NULL, NULL, @l_idtpes OUTPUT

  /* TRY */
    SELECT
      @l_matgrp=r070tsi.matgrp
       FROM r070tsi r070tsi
    SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
    IF @ChkError <> 0
    BEGIN
      GOTO EXC1
    END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC1:
    SELECT @SE_EXC1 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        SELECT @l_matgrp = 'N'
      END
    END
  /* END EXCEPTION HANDLER */
  /* TRY */
    SELECT
      @l_ediprm=r000ass.ediprm
       FROM r000ass r000ass
    SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
    IF @ChkError <> 0
    BEGIN
      GOTO EXC2
    END
    IF (@l_ediprm='99999')
    BEGIN
      SELECT @l_newprm = 1
    END
    ELSE
    BEGIN
      SELECT @l_newprm = 0
    END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC2:
    SELECT @SE_EXC2 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        BEGIN
          RAISERROR('SP_MATGRP: NÃ£o conseguiu obter a mÃ¡scara da permissÃ£o R000ASS.EDIPRM.',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
  IF (@l_matgrp='S')
  BEGIN
    /*Busca os nÃºmeros fÃ­sicos do crachÃ¡ titular*/
    EXECUTE  @ChkError = SP_MAPFIS @p_numcra, @l_numbar OUTPUT ,@l_numpro OUTPUT ,@l_numsma OUTPUT ,@l_tecpri OUTPUT ,@l_crapri OUTPUT

    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END

    IF ((@l_crapri=0) OR (@l_tecpri=3))
    BEGIN
      EXECUTE  @ChkError = SP_RETICARD @l_idtpes, @p_numcra, @l_icardA OUTPUT, @l_icardR OUTPUT, @l_numser OUTPUT
      IF @ChkError <> 0
      BEGIN
        GOTO FIM
      END
		SELECT @l_comando = N'DELETE FROM '+@l_usutel+'MATGRUPO WHERE ICARD = @l_icard'
	  EXEC sp_executesql @l_comando,
                         N'@l_icard CHAR(12)', @l_icardA
    END
    ELSE
    BEGIN
      IF (@l_numpro<>0)
      BEGIN
        EXECUTE  @ChkError = SP_INTSTR @l_numpro,'999999999999',@l_icard OUTPUT
        IF @ChkError <> 0
        BEGIN
          GOTO FIM
        END
		SELECT @l_comando = N'DELETE FROM '+@l_usutel+'MATGRUPO WHERE ICARD = @l_icard'
		EXEC sp_executesql @l_comando,
                           N'@l_icard CHAR(12)', @l_icard
      END
      IF (@l_numbar<>0)
      BEGIN
        EXECUTE  @ChkError = SP_INTSTR @l_numbar,'999999999999',@l_icard OUTPUT
        IF @ChkError <> 0
        BEGIN
          GOTO FIM
        END
		SELECT @l_comando = N'DELETE FROM '+@l_usutel+'MATGRUPO WHERE ICARD = @l_icard'
		EXEC sp_executesql @l_comando,
                           N'@l_icard CHAR(12)', @l_icard
      END
    END

    /*Busca o crachÃ¡ provisÃ³rio*/
    EXECUTE @ChkError = SP_RETCRA 2, @p_numemp, @p_tipcol, @p_numcad, 0, 0, 0, '', @l_craprov OUTPUT;

    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END

    /*Se tiver crachÃ¡ provisÃ³rio*/
    IF (@l_craprov <> 0)
    BEGIN

      /*Busca os nÃºmeros fÃ­sicos do crachÃ¡ provisÃ³rio*/
      EXECUTE @ChkError = SP_MAPFIS @l_craprov, @l_numbarprov OUTPUT, @l_numproprov OUTPUT, @l_numsmaprov OUTPUT, @l_tecpriprov OUTPUT, @l_crapriprov OUTPUT

      IF @ChkError <> 0
      BEGIN
        GOTO FIM
      END

      IF ((@l_crapriprov=0) OR (@l_tecpriprov=3))
      BEGIN
        EXECUTE  @ChkError = SP_RETICARD @l_idtpes, @l_craprov, @l_icardA OUTPUT, @l_icardR OUTPUT, @l_numser OUTPUT
        IF @ChkError <> 0
        BEGIN
          GOTO FIM
        END
        SELECT @l_comando = N'DELETE FROM '+@l_usutel+'MATGRUPO WHERE ICARD = @l_icard'
        EXEC sp_executesql @l_comando,
                           N'@l_icard CHAR(12)', @l_icardA
      END
      ELSE
      BEGIN
        IF (@l_numproprov<>0)
        BEGIN
          EXECUTE  @ChkError = SP_INTSTR @l_numproprov,'999999999999',@l_icard OUTPUT
          IF @ChkError <> 0
          BEGIN
            GOTO FIM
          END
          SELECT @l_comando = N'DELETE FROM '+@l_usutel+'MATGRUPO WHERE ICARD = @l_icard'
          EXEC sp_executesql @l_comando,
                             N'@l_icard CHAR(12)', @l_icard
        END
        IF (@l_numbarprov<>0)
        BEGIN
          EXECUTE  @ChkError = SP_INTSTR @l_numbarprov,'999999999999',@l_icard OUTPUT
          IF @ChkError <> 0
          BEGIN
            GOTO FIM
          END
          SELECT @l_comando = N'DELETE FROM '+@l_usutel+'MATGRUPO WHERE ICARD = @l_icard'
          EXEC sp_executesql @l_comando,
                             N'@l_icard CHAR(12)', @l_icard
        END
      END
    END

    IF (@p_tippes<4)
    BEGIN
      DECLARE c_r070pec CURSOR FOR SELECT
      r070pec.codprm CODPRM,r070pec.datini DATINI,r070pec.horini HORINI,r070pec.datfim DATFIM,r070pec.horfim HORFIM
       FROM r070pec r070pec
       WHERE r070pec.numemp=@p_numemp
      and r070pec.tipcol=@p_tipcol
      and r070pec.numcad=@p_numcad
      and (r070pec.datfim=@l_data_zero
      or r070pec.datfim>@l_data_atual
      or (r070pec.datfim=@l_data_atual
      and r070pec.horfim>@l_hora_atual))
      and (r070pec.datini<@l_data_atual
      or (r070pec.datini=@l_data_atual
      and r070pec.horini<@l_hora_atual))
       ORDER BY 2,3
      OPEN c_r070PEC
      FETCH NEXT FROM c_r070PEC INTO @l_r070pec_CODPRM, @l_r070pec_DATINI, @l_r070pec_HORINI, @l_r070pec_DATFIM, @l_r070pec_HORFIM
      WHILE  (@@FETCH_STATUS = 0)
      BEGIN
        EXECUTE  @ChkError = SP_DATSTR @l_r070PEC_DATINI,'DDMMYYYY',@l_datini OUTPUT
        IF @ChkError <> 0
        BEGIN
          GOTO FNc_r070PEC3
        END
        IF @l_r070PEC_DATFIM<>@l_data_zero
        BEGIN
          EXECUTE  @ChkError = SP_DATSTR @l_r070PEC_DATFIM,'DDMMYYYY',@l_datfim OUTPUT
          IF @ChkError <> 0
          BEGIN
            GOTO FNc_r070PEC3
          END
        END
        ELSE
        BEGIN
          SELECT @l_datfim = '31122050'
        END
        EXECUTE  @ChkError = SP_INTSTR @l_r070PEC_HORINI,'HHMM',@l_horini OUTPUT
        IF @ChkError <> 0
        BEGIN
          GOTO FNc_r070PEC3
        END
        EXECUTE  @ChkError = SP_INTSTR @l_r070PEC_HORFIM,'HHMM',@l_horfim OUTPUT
        IF @ChkError <> 0
        BEGIN
          GOTO FNc_r070PEC3
        END
        IF (@l_newprm=1)
        BEGIN
          EXECUTE  @ChkError = SP_INTSTR @l_r070PEC_CODPRM,'99999',@l_grupo_5 OUTPUT
          IF @ChkError <> 0
          BEGIN
            GOTO FNc_r070PEC3
          END
        END
        ELSE
        BEGIN
          EXECUTE  @ChkError = SP_INTSTR @l_r070PEC_CODPRM,'999',@l_grupo OUTPUT
          IF @ChkError <> 0
          BEGIN
            GOTO FNc_r070PEC3
          END
        END
        SELECT @l_dat_conv = SUBSTRING(@l_datini,1,2)+'/'+SUBSTRING(@l_datini,3,2)+'/'+SUBSTRING(@l_datini,5,4)+','+SUBSTRING(@l_horini,1,2)+':'+SUBSTRING(@l_horini,3,2)
        EXECUTE  @ChkError = SP_STRTODATE @l_dat_conv,'DD/MM/AAAA,HH:MI',@l_inigrp OUTPUT
        IF @ChkError <> 0
        BEGIN
          GOTO FNc_r070PEC3
        END
        SELECT @l_dat_conv = SUBSTRING(@l_datfim,1,2)+'/'+SUBSTRING(@l_datfim,3,2)+'/'+SUBSTRING(@l_datfim,5,4)+','+SUBSTRING(@l_horfim,1,2)+':'+SUBSTRING(@l_horfim,3,2)
        EXECUTE  @ChkError = SP_STRTODATE @l_dat_conv,'DD/MM/AAAA,HH:MI',@l_fimgrp OUTPUT
        IF @ChkError <> 0
        BEGIN
          GOTO FNc_r070PEC3
        END
        /* TRY */

        /*Inicio da rotina de INSERT do crachÃ¡ titular*/
          IF ((@l_crapri=0) OR (@l_tecpri=3))
          BEGIN
			EXECUTE  @ChkError = SP_RETICARD @l_idtpes, @p_numcra, @l_icardA OUTPUT, @l_icardR OUTPUT, @l_numser OUTPUT
            IF @ChkError <> 0
            BEGIN
              GOTO EXC4
            END
            IF (@l_newprm=1)
            BEGIN
              SELECT @l_compila = 'A'
				SELECT @l_comando = N'INSERT INTO '+@l_usutel+'MATGRUPO (ICARD, GRUPO, DATINI, DATFIM) VALUES (@l_icard,@l_grupo_5,@l_inigrp,@l_fimgrp)'
			  EXEC sp_executesql @l_comando,
                                 N'@l_icard CHAR(12), @l_grupo_5 CHAR(5), @l_inigrp DATETIME, @l_fimgrp DATETIME',
                                   @l_icardA, @l_grupo_5, @l_inigrp, @l_fimgrp
            END
            ELSE
            BEGIN
              SELECT @l_compila = 'A'
				SELECT @l_comando = N'INSERT INTO '+@l_usutel+'MATGRUPO (ICARD, GRUPO, DATINI, DATFIM) VALUES (@l_icard,@l_grupo,@l_inigrp,@l_fimgrp)'
			  EXEC sp_executesql @l_comando,
                                 N'@l_icard CHAR(12), @l_grupo CHAR(3), @l_inigrp DATETIME, @l_fimgrp DATETIME',
                                   @l_icardA, @l_grupo, @l_inigrp, @l_fimgrp
            END
          END
          ELSE
          BEGIN
            IF (@l_numpro<>0)
            BEGIN
              EXECUTE  @ChkError = SP_INTSTR @l_numpro,'999999999999',@l_icard OUTPUT
              IF @ChkError <> 0
              BEGIN
                GOTO EXC4
              END
              IF (@l_newprm=1)
              BEGIN
                SELECT @l_compila = 'A'
				SELECT @l_comando = N'INSERT INTO '+@l_usutel+'MATGRUPO VALUES (@l_icard,@l_grupo_5,@l_inigrp,@l_fimgrp)'
				EXEC sp_executesql @l_comando,
                                   N'@l_icard CHAR(12), @l_grupo_5 CHAR(5), @l_inigrp DATETIME, @l_fimgrp DATETIME',
                                     @l_icard, @l_grupo_5, @l_inigrp, @l_fimgrp
              END
              ELSE
              BEGIN
                SELECT @l_compila = 'A'
				SELECT @l_comando = N'INSERT INTO '+@l_usutel+'MATGRUPO VALUES (@l_icard,@l_grupo,@l_inigrp,@l_fimgrp)'
				EXEC sp_executesql @l_comando,
                                   N'@l_icard CHAR(12), @l_grupo CHAR(3), @l_inigrp DATETIME, @l_fimgrp DATETIME',
                                     @l_icard, @l_grupo, @l_inigrp, @l_fimgrp
              END
            END
            IF (@l_numbar<>0)
            BEGIN
              EXECUTE  @ChkError = SP_INTSTR @l_numbar,'999999999999',@l_icard OUTPUT
              IF @ChkError <> 0
              BEGIN
                GOTO EXC4
              END
              IF (@l_newprm=1)
              BEGIN
                SELECT @l_compila = 'A'
				SELECT @l_comando = N'INSERT INTO '+@l_usutel+'MATGRUPO VALUES (@l_icard,@l_grupo_5,@l_inigrp,@l_fimgrp)'
				EXEC sp_executesql @l_comando,
                                   N'@l_icard CHAR(12), @l_grupo_5 CHAR(5), @l_inigrp DATETIME, @l_fimgrp DATETIME',
                                     @l_icard, @l_grupo_5, @l_inigrp, @l_fimgrp
              END
              ELSE
              BEGIN
                SELECT @l_compila = 'A'
				SELECT @l_comando = N'INSERT INTO '+@l_usutel+'MATGRUPO VALUES (@l_icard,@l_grupo,@l_inigrp,@l_fimgrp)'
				EXEC sp_executesql @l_comando,
