TRIGGER R069FIS_SI AFTER INSERT ON R069FIS

DECLARE
  l_usocra     NUMBER(2);
  l_numcra_str CHAR(12);
  l_usocra_str CHAR(2);
  l_teccra_str CHAR(1);
  l_numfis_str CHAR(12);
  l_datfim_str CHAR(8);
  l_horfim_str CHAR(4);
  l_idregister CHAR(39);

/* CURSOR c/ os registros gravados no R069FIS_AUXl */
  CURSOR c_r069FIS_INS IS SELECT NUMCRA,DATALT,HORINI,NUMFIS,TECCRA,DATFIM,HORFIM
                            FROM R069FIS_AUX
                           WHERE TIPOPE = 'I';
  TYPE t_r069FIS_aux IS RECORD(
    NUMCRA   R069FIS_AUX.NUMCRA%TYPE,
    DATALT   R069FIS_AUX.DATALT%TYPE,
    HORINI   R069FIS_AUX.HORINI%TYPE,
    NUMFIS   R069FIS_AUX.NUMFIS%TYPE,
    TECCRA   R069FIS_AUX.TECCRA%TYPE,
    DATFIM   R069FIS_AUX.DATFIM%TYPE,
    HORFIM   R069FIS_AUX.HORFIM%TYPE);
  l_r069FIS_aux t_r069FIS_aux;

BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r069FIS_INS INTO  l_r069FIS_aux.NUMCRA,
                              l_r069FIS_aux.DATALT,
                              l_r069FIS_aux.HORINI,
                              l_r069FIS_aux.NUMFIS,
                              l_r069FIS_aux.TECCRA,
                              l_r069FIS_aux.DATFIM,
                              l_r069FIS_aux.HORFIM
  LOOP
     IF  (l_r069FIS_aux.Numcra = 0) THEN
         RAISERROR 103 'Erro R069FIS_SI: Não é possível inserir registro de crachá com valor zero.';
     ELSE
         R069FIS_ATUCON ('I',l_r069FIS_aux.NUMCRA,l_r069FIS_aux.DATALT,l_r069FIS_aux.HORINI,
                         l_r069FIS_aux.NUMFIS,0,l_r069FIS_aux.TECCRA,l_r069FIS_aux.DATFIM,l_r069FIS_aux.HORFIM);
                         
         BEGIN
             SELECT USOCRA INTO l_usocra FROM R069CRA WHERE NUMCRA = l_r069FIS_aux.NUMCRA;
         EXCEPTION
	     WHEN OTHERS THEN
	         l_usocra := 0;
	     END;
         
         IF (l_usocra > 0) THEN
             SP_INTSTR(l_usocra, '99', l_usocra_str OUT);
             SP_INTSTR(l_r069FIS_aux.NUMCRA, '999999999999', l_numcra_str OUT);
             SP_INTSTR(l_r069FIS_aux.TECCRA, '9', l_teccra_str OUT);
             SP_INTSTR(l_r069FIS_aux.NUMFIS, '999999999999', l_numfis_str OUT);
             SP_DATSTR(l_r069FIS_aux.DATFIM, 'DDMMYYYY', l_datfim_str OUT);
             SP_INTSTR(l_r069FIS_aux.HORFIM, '9999', l_horfim_str OUT);
             l_idregister := l_usocra_str||l_numcra_str||l_teccra_str||l_numfis_str||l_datfim_str||l_horfim_str;
             SP_SAM_PENDENCIES(38, 1, l_idregister);
         END IF;
     END IF;
  END LOOP;
 /* Apaga Registro OLD em R069FIS_AUX */
  BEGIN
    DELETE FROM R069FIS_AUX  WHERE TIPOPE = 'I';
    DROP_TEMP_TABLE R069FIS_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀3Ù␀␀		SENIOR;0Q␀␀

TRIGGER R069FIS_EI AFTER INSERT ON R069FIS FOR EACH ROW
DECLARE
  /* Tabela temporária */
  CREATE_TEMP_TABLE R069FIS_AUX;
BEGIN
  INSERT INTO R069FIS_AUX (TIPOPE,NUMCRA,DATALT,HORINI,NUMFIS,TECCRA,DATFIM,HORFIM)
            VALUES ('I',:NEW.NUMCRA,:NEW.DATALT,:NEW.HORINI,:NEW.NUMFIS,:NEW.TECCRA,:NEW.DATFIM,:NEW.HORFIM);
END␀7Ù␀␀	SENIOR;0á␀␀

TRIGGER R069FIS_SU AFTER UPDATE ON R069FIS
DECLARE
  l_usocra     NUMBER(2);
  l_numcra_str CHAR(12);
  l_usocra_str CHAR(2);
  l_teccra_str CHAR(1);
  l_numfis_str CHAR(12);
  l_datfim_str CHAR(8);
  l_horfim_str CHAR(4);
  l_idregister CHAR(39);
  
/* CURSOR c/ os registros gravados no R069FIS_AUXl */
  CURSOR c_r069FIS_upd IS SELECT NUMCRA,DATALT,HORINI,NUMFIS,TECCRA,DATFIM,HORFIM
                            FROM R069FIS_AUX
                           WHERE TIPOPE = 'U';
  TYPE t_r069FIS_aux IS RECORD(
    NUMCRA   R069FIS_AUX.NUMCRA%TYPE,
    DATALT   R069FIS_AUX.DATALT%TYPE,
    HORINI   R069FIS_AUX.HORINI%TYPE,
    NUMFIS   R069FIS_AUX.NUMFIS%TYPE,
    TECCRA   R069FIS_AUX.TECCRA%TYPE,
    DATFIM   R069FIS_AUX.DATFIM%TYPE,
    HORFIM   R069FIS_AUX.HORFIM%TYPE);
  l_r069FIS_aux t_r069FIS_aux;

BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r069FIS_upd INTO  l_r069FIS_aux.NUMCRA,
                              l_r069FIS_aux.DATALT,
                              l_r069FIS_aux.HORINI,
                              l_r069FIS_aux.NUMFIS,
                              l_r069FIS_aux.TECCRA,
                              l_r069FIS_aux.DATFIM,
                              l_r069FIS_aux.HORFIM
  LOOP                      
     BEGIN
         SELECT USOCRA INTO l_usocra FROM R069CRA WHERE NUMCRA = l_r069FIS_aux.NUMCRA;
     EXCEPTION
	 WHEN OTHERS THEN
	     l_usocra := 0;
	 END;
         
     IF (l_usocra > 0) THEN
         SP_INTSTR(l_usocra, '99', l_usocra_str OUT);
         SP_INTSTR(l_r069FIS_aux.NUMCRA, '999999999999', l_numcra_str OUT);
         SP_INTSTR(l_r069FIS_aux.TECCRA, '9', l_teccra_str OUT);
         SP_INTSTR(l_r069FIS_aux.NUMFIS, '999999999999', l_numfis_str OUT);
         SP_DATSTR(l_r069FIS_aux.DATFIM, 'DDMMYYYY', l_datfim_str OUT);
         SP_INTSTR(l_r069FIS_aux.HORFIM, '9999', l_horfim_str OUT);
         l_idregister := l_usocra_str||l_numcra_str||l_teccra_str||l_numfis_str||l_datfim_str||l_horfim_str;
         SP_SAM_PENDENCIES(38, 2, l_idregister);
     END IF;
  END LOOP;
 /* Apaga Registro OLD em R069FIS_AUX */
  BEGIN
    DELETE FROM R069FIS_AUX WHERE TIPOPE = 'U';
    DROP_TEMP_TABLE R069FIS_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀4Ù␀␀		SENIOR;0Q␀␀

