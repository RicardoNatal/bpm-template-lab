	IF (P_PIDSTA IS NOT NULL AND P_PIDSTA <> '') THEN
		BEGIN
			SELECT STAENV INTO P_STAENV FROM R304STA WHERE PIDSTA = P_PIDSTA;
		EXCEPTION WHEN OTHERS THEN
			P_STAENV := '';
		END;
