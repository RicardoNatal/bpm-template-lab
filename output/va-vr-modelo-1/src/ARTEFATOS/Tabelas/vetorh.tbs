  l_numser     VARCHAR2(12);
BEGIN

  /* verifica se existe as tabelas da Telemática para controle do SAD*/
  l_utitsi := 'N';
  BEGIN
      SELECT EXCTIP INTO l_utiTsi FROM R070TSI;
  EXCEPTION
      WHEN OTHERS THEN l_utiTsi := 'N';
  END;

  IF (l_utiTsi = 'S') THEN
      /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
      SP_RETICARD(NULL, p_numcra, l_icardA OUT, l_icardR OUT, l_numser OUT);

      /* Apaga os registros antes de inserir */
      BEGIN
          ExecSql('DELETE FROM EXCETIPO WHERE ICARD = '||l_icardA);
      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;

      IF   p_tipope = 'I' THEN
           /* Tenta inserir. se ja existir ignorar. */
           BEGIN
               ExecSql('INSERT INTO EXCETIPO (ICARD) VALUES ('''||l_icardA||''')');
           EXCEPTION
               WHEN DUPVALONINDEX THEN NULL;
           END;
      END IF;
  END IF;

  /* Envia pendência para Digicon */
  SP_GERSEN(l_gersen OUT);
  IF  (l_gersen = TRUE) THEN
      /* Monta data/hora de envio da pendência.*/
      l_data_atual := CURDATE();
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
      SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
      l_seqenv := SECOND(CURTIME());
      SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
