      DEALLOCATE CUR_r090vis_UPD_OLD
      CLOSE CUR_r090vis_UPD_NEW
      DEALLOCATE CUR_r090vis_UPD_NEW
      GOTO FIM
    END
    IF (@l_auditoria='S')
    BEGIN
      SELECT @l_camposAlterados = 'Campo(s) alterado(s): '
      SELECT @l_alterou = 0
      IF (@NEW_TIPDOC<>@OLD_TIPDOC)
      BEGIN
        SELECT @l_alterou = 1
        SELECT @l_camposAlterados = @l_camposAlterados+'TIPDOC '
