        BEGIN
          RAISERROR('A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FNCUR_R900LCN1
        END
      END
      UPDATE r900log SET 
      evtnbr=@VEVTNBR,evtidt=@PEVTIDT,evttim=@PEVTTIM,evtusr=@PEVTUSR,evtda1=@PEVTDA1,evtda2=@PEVTDA2 
       WHERE evtpos=@vevtpos
