DECLARE @l_place3str VARCHAR(255)
DECLARE @l_numlaustr VARCHAR(255)
DECLARE @l_regrodstr VARCHAR(255)
DECLARE @l_codoemstr VARCHAR(255)
DECLARE @l_pcodoemstr VARCHAR(255)
