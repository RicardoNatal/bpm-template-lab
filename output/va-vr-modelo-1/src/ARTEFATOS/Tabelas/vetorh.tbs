AFTER INSERT ON R110MPR
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  l_codSistema:= 1;
  l_codcpa:= 138;
  l_codtpa:= 407;

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110MPR_AI', '');

    /* Insere os campos chave na tabela de auditoria R995PRC*/
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:NEW.CODFIC));
      SP_DATSTR(:NEW.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR,:NEW.HORATE));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODAMB', CONVERT(NUMBER_TO_CHAR,:NEW.CODAMB));
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110MPR_AI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    /* Insere os valores dos campos na tabela de auditoria R995PRT*/
    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR,:NEW.CODATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ATEPOS', CONVERT(NUMBER_TO_CHAR,:NEW.ATEPOS));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDREA',:NEW.INDREA);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSPRO',:NEW.OBSPRO);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSREA',:NEW.OBSREA);
    END;
  END IF;
END␀–ß␀␀		SENIOR;0Í␀␀

TRIGGER R110MPR_AU
AFTER UPDATE ON R110MPR
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  IF (
  :OLD.CODATE <>:NEW.CODATE OR
  :OLD.ATEPOS <>:NEW.ATEPOS OR
  :OLD.INDREA <>:NEW.INDREA OR
  :OLD.OBSPRO <>:NEW.OBSPRO OR
  :OLD.OBSREA <>:NEW.OBSREA OR
  :OLD.CODAMB <>:NEW.CODAMB
  ) THEN
    l_codSistema:= 1;
    l_codcpa:= 138;  /* Código da categoria de auditoria - Atendimentos - Procedimentos AMB*/
    l_codtpa:= 408;  /* Código do tipo de auditoria - Alteração*/

    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110MPR_AU', '');

      /* Insere os campos chave na tabela de auditoria R995PRC*/
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:OLD.CODFIC));
        SP_DATSTR(:OLD.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR,:OLD.HORATE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODAMB', CONVERT(NUMBER_TO_CHAR,:OLD.CODAMB));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110MPR_AU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      /* Insere os valores dos campos na tabela de auditoria R995PRT*/
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
        /* Valores Antigos*/
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODATE', CONVERT(NUMBER_TO_CHAR,:OLD.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDATEPOS', CONVERT(NUMBER_TO_CHAR,:OLD.ATEPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINDREA',:OLD.INDREA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSPRO',:OLD.OBSPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSREA',:OLD.OBSREA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODAMB', CONVERT(NUMBER_TO_CHAR,:OLD.CODAMB));
        /* Valores Novos*/
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODATE', CONVERT(NUMBER_TO_CHAR,:NEW.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWATEPOS', CONVERT(NUMBER_TO_CHAR,:NEW.ATEPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINDREA',:NEW.INDREA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSPRO',:NEW.OBSPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSREA',:NEW.OBSREA);      
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODAMB', CONVERT(NUMBER_TO_CHAR,:NEW.CODAMB));
      END;
    END IF;
  END IF;
END␀”ß␀␀		SENIOR;0ï␀␀

TRIGGER R110MPR_AD
AFTER DELETE ON R110MPR
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  l_codSistema:= 1;
  l_codcpa:= 138;
  l_codtpa:= 407;

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110MPR_AD', '');

    /* Insere os campos chave na tabela de auditoria R995PRC*/
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:OLD.CODFIC));
      SP_DATSTR(:OLD.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR,:OLD.HORATE));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODAMB', CONVERT(NUMBER_TO_CHAR,:OLD.CODAMB));
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110MPR_AD: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    /* Insere os valores dos campos na tabela de auditoria R995PRT*/
    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR,:OLD.CODATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ATEPOS', CONVERT(NUMBER_TO_CHAR,:OLD.ATEPOS));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDREA',:OLD.INDREA);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSPRO',:OLD.OBSPRO);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSREA',:OLD.OBSREA);
    END;
  END IF;
END␀␀␀␀␀␀␀␀␀␀␀␀␀␀—ß␀␀…¬␀␀´␀	€␀␀␀␀␀␀°␀␀XbXbr␀Æÿ␀␀Ò␀␀␀,¼␀	€␀␀␀␀␀␀Ğ?ääv␀Æÿ␀␀ß␀␀␀Ğ¬␀␀¼␀	€␀␀␀␀␀␀5°␀␀î␀␀î␀␀Š)␀␀Æÿ␀␀›ß␀␀␀–,Ì␀€␀␀␀␀␀␀=§m¹m”)␀␀Æÿ␀␀>ß␀␀␀7EÑ␀€␀␀␀␀␀␀xHÙExHqC␀êÿ␀␀ÿ␀#U*€␀␀␀␀␀␀QÅ␀␀PÅ␀␀PÅ␀␀8␀␀ÿ␀␀ÿ␀ğT*€␀␀␀␀␀␀Ø´␀␀ñ³␀␀ñ³␀␀8␀␀ÿ␀␀ÿ␀␀¾€␀␀␀␀␀␀?␀]␀]␀n␀Æÿ␀␀ÿ␀r=␀␀␀␀␀␀␀␀Ë¦¦c␀␀␀ÿ␀␀ÿ␀␀␀␀0;1;2™ß␀␀		SENIOR;0²␀␀TRIGGER R110MRC_EI AFTER INSERT ON R110MRC FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

	l_codSistema := 1;
	l_codcpa := 131;
	l_codtpa := 393;

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);		
  	
  IF (l_temAud = TRUE) THEN 
	  SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110MRC_EI', '');
      
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));        
