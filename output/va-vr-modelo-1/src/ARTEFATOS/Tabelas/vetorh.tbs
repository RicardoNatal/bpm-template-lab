␀␀TRIGGER R030GRT_EI AFTER INSERT ON R030GRT FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Filiais da Empresa - Liminar Terceiro (Tabela: R030GRT)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 118;     /* Filiais da Empresa - Liminar Terceiro (Tabela: R030GRT)*/
  l_codtpa := 367;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030GRT_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPGRP', CONVERT(NUMBER_TO_CHAR, :NEW.TIPGRP));
        SP_DATSTR(:NEW.DATGRP, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATGRP', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TERFPA', CONVERT(NUMBER_TO_CHAR, :NEW.TERFPA));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030GRT_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRO', CONVERT(NUMBER_TO_CHAR, :NEW.CODPRO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSUS', CONVERT(NUMBER_TO_CHAR, :NEW.CODSUS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TABEVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ABREVE', :NEW.ABREVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ABR13S', :NEW.ABR13S);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPAU1', CONVERT(NUMBER_TO_CHAR, :NEW.CMPAU1));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPAU2', CONVERT(NUMBER_TO_CHAR, :NEW.CMPAU2));
        SP_DATSTR(:NEW.CMPAU3, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPAU3', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPAU4', :NEW.CMPAU4);
      END;
  END IF; 
END␀OÒ␀␀		SENIOR;0|␀␀ 


TRIGGER R030GRT_EU AFTER UPDATE ON R030GRT FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Filiais da Empresa - Liminar Terceiro (Tabela: R030GRT)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 118;     /* Filiais da Empresa - Liminar Terceiro (Tabela: R030GRT)*/
  l_codtpa := 368;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFil <> :NEW.CodFil)
   OR (:OLD.TipGrp <> :NEW.TipGrp)
   OR (:OLD.DatGrp <> :NEW.DatGrp)
   OR (:OLD.TerFpa <> :NEW.TerFpa)
   OR (:OLD.CodPro <> :NEW.CodPro)
   OR (:OLD.CodSus <> :NEW.CodSus)
   OR (:OLD.TabEve <> :NEW.TabEve)
   OR (:OLD.AbrEve <> :NEW.AbrEve)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030GRT_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPGRP', CONVERT(NUMBER_TO_CHAR, :OLD.TIPGRP));
        SP_DATSTR(:OLD.DATGRP, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATGRP', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TERFPA', CONVERT(NUMBER_TO_CHAR, :OLD.TERFPA));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030GRT_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPRO', CONVERT(NUMBER_TO_CHAR, :OLD.CODPRO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPRO', CONVERT(NUMBER_TO_CHAR, :NEW.CODPRO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODSUS', CONVERT(NUMBER_TO_CHAR, :OLD.CODSUS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODSUS', CONVERT(NUMBER_TO_CHAR, :NEW.CODSUS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTABEVE', CONVERT(NUMBER_TO_CHAR, :OLD.TABEVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTABEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TABEVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDABREVE', :OLD.ABREVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWABREVE', :NEW.ABREVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDABR13S', :OLD.ABR13S);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWABR13S', :NEW.ABR13S);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCMPAU1', CONVERT(NUMBER_TO_CHAR, :OLD.CMPAU1));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCMPAU1', CONVERT(NUMBER_TO_CHAR, :NEW.CMPAU1));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCMPAU2', CONVERT(NUMBER_TO_CHAR, :OLD.CMPAU2));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCMPAU2', CONVERT(NUMBER_TO_CHAR, :NEW.CMPAU2));
        SP_DATSTR(:OLD.CMPAU3, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCMPAU3', CONVERT(NUMBER_TO_CHAR, :OLD.CMPAU3));
        SP_DATSTR(:NEW.CMPAU3, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCMPAU3', CONVERT(NUMBER_TO_CHAR, :NEW.CMPAU3));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCMPAU4',  :OLD.CMPAU4);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCMPAU4',  :NEW.CMPAU4);
      END;
    END IF; 
  END IF; 
END␀MÒ␀␀		SENIOR;0Ü
␀␀ 


TRIGGER R030GRT_ED AFTER DELETE ON R030GRT FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Filiais da Empresa - Liminar Terceiro (Tabela: R030GRT)*/ 
