DECLARE
  l_Valor VARCHAR2(2000); 
BEGIN
  l_Valor := '';
  IF (:NEW.CODACA = 0 OR :NEW.ORIINF <> 2) THEN 
    SP_CONCATENAR_NUM('CODPRO', :NEW.CODPRO, l_Valor OUT);
  
    SP_E_SOCIAL('S-2500', 'R346CPT', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, NULL, 0, 'R346CPT_EI');
  END IF;
END␀5æ␀␀		SENIOR;0õ<␀␀

TRIGGER R346CPT_EU BEFORE UPDATE ON R346CPT FOR EACH ROW
DECLARE
  l_Valor VARCHAR2(2000);
  l_Alterou BOOLEAN;
  l_Valido BOOLEAN;
  l_JsonCamposAlterados VARCHAR2(2000);
  l_VersaoESocial NUMBER;
  l_DatRef DATE; 
BEGIN 
  l_Valor := '';
  l_JsonCamposAlterados := '';
  l_VersaoESocial := 0;
  l_DatRef := DATETIME(31, 12, 1900, 0, 0, 0);
  
  IF (:NEW.CODACA = 0 OR :NEW.ORIINF <> 2) THEN
    IF (:NEW.OriPro = 1) THEN
    	l_DatRef := :NEW.DatSen;
    ELSIF (:NEW.OriPro = 2) THEN
    	l_DatRef := :NEW.DatCon;
    END IF;
    
    SP_ESOCIAL_S250X(:NEW.NumEmp, l_DatRef, l_VersaoESocial OUT);
    
    SP_VALUPDATE_NUM(:OLD.TIPRES, :NEW.TIPRES, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_NUM_JSON('TIPRES', :NEW.TIPRES, :OLD.TIPRES, l_JsonCamposAlterados OUT);
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.INSRES, :NEW.INSRES, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_FLO_JSON('INSRES', :NEW.INSRES, :OLD.INSRES, 0, l_JsonCamposAlterados OUT);
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.ORIPRO, :NEW.ORIPRO, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_NUM_JSON('ORIPRO', :NEW.ORIPRO, :OLD.ORIPRO, l_JsonCamposAlterados OUT);
    END IF;
    
    SP_VALUPDATE_DES(:OLD.OBSPRO, :NEW.OBSPRO, l_Valido OUT);
