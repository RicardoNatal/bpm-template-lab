C␀␀PROCEDURE RS_INSCURCOMP(P_NUMCAN NUMBER(7),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9))
 IS

/* DATEtime que irá conter a data e hora atual */
  l_DthCan             NUMBER(14,6);
  l_SeqCco             NUMBER;
  l_Inserir            BOOLEAN;
BEGIN
  /* Retorna Data e hora atual (DateTime) */
  SP_DATETIME(l_DthCan OUT);

  l_Inserir := TRUE;
  WHILE (l_Inserir = TRUE) LOOP
    BEGIN
      SELECT (IFNULL(MAX(SEQCCO),0) + 1) INTO l_SeqCco FROM R122CCO;
      INSERT INTO R122CCO (SEQCCO,NUMCAN,NUMEMP,TIPCOL,NUMCAD,ULTATU,DTHCAN,CURCPL,CURRES)
                   VALUES (l_SeqCco, p_NumCan, p_NumEmp, p_TipCol, p_NumCad, 0, l_DthCan, ' ', ' ');
      l_Inserir := FALSE;
    EXCEPTION
      WHEN DUPVALONINDEX THEN
        l_Inserir := TRUE; /* Se der erro de chave duplicada seta a flag para tentar inserir novamente com outro código */
      WHEN OTHERS THEN
        l_Inserir := FALSE; /* Para garantir que saia do LOOP quando der outro tipo de exceção */
        RAISERROR 103 'Erro ao Inserir R122CCO. (RS_INSCURCOMP)';
    END;
  END LOOP;
END	MSSQL;0
ú␀␀CREATE PROCEDURE RS_INSCURCOMP(@P_NUMCAN INTEGER, @P_NUMEMP SMALLINT, @P_TIPCOL SMALLINT, @P_NUMCAD INTEGER) AS
BEGIN
  DECLARE @l_dthcan FLOAT
  DECLARE @l_seqcco FLOAT
  DECLARE @l_inserir NUMERIC(1,0)
  DECLARE @ChkError INTEGER
  
  SELECT @ChkError = 0
  EXECUTE  @ChkError = SP_DATETIME @l_DthCan OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  
  SELECT @l_Inserir = 1
  WHILE (@l_Inserir=1)
  BEGIN
    BEGIN TRY
      SELECT @l_SeqCco=(ISNULL(MAX(seqcco),0)+1) FROM r122cco r122cco
      INSERT INTO r122cco(seqcco,numcan,numemp,tipcol,numcad,ultatu,dthcan,curcpl,curres) 
	               VALUES(@l_SeqCco,@p_NumCan,@p_NumEmp,@p_TipCol,@p_NumCad,0,@l_DthCan,' ',' ')
      
      SELECT @l_Inserir = 0
    END TRY
    BEGIN CATCH
      SELECT @ChkError = ERROR_NUMBER()
      IF @ChkError = 2601 OR @ChkError = 2626 OR @ChkError = 2627
      BEGIN
        SELECT @ChkError = 0
        SELECT @l_Inserir = 1
        PRINT 'Aviso: Chave duplicada (RS_INSCURCOMP).'
      END
      ELSE
      BEGIN
        SELECT @ChkError = -30
        SELECT @l_Inserir = 0
        RAISERROR('Erro ao Inserir R122CCO. (RS_INSCURCOMP)',11,1) WITH SETERROR
        GOTO FIM
      END
    END CATCH
  END
FIM:
  RETURN @ChkError
END␀Õì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RS_CRTABR
RS_BUSARG
d␀␀/* Monta a cláusula where de uma instrução SQL */
PROCEDURE RS_MTASQL(P_NOMCAM VARCHAR2(255),P_CAMORI VARCHAR2(255),P_STRSQL OUT VARCHAR2(255))
 IS

l_TipSinal    CHAR(1);
 l_FirstAbr    VARCHAR2(25);
 l_SecondAbr   VARCHAR2(25);
 l_IdxAbr      NUMBER;
 l_PosAbr      NUMBER(5);
 l_FimAbr      BOOLEAN;
 l_CamOri      VARCHAR2(50);
 l_StrSql      VARCHAR2(250);
 l_CtrVez      BOOLEAN;
 l_ret         BOOLEAN;
BEGIN
p_StrSql := '';
l_StrSql := '';
l_CamOri := p_CamOri;
RS_CRTABR(l_CamOri, l_ret OUT);
IF   (l_ret = FALSE) THEN
     RETURN;
END IF;

l_PosAbr    := 1;
l_FimAbr    := FALSE;
l_FirstAbr  := '';
l_SecondAbr := '';
l_CtrVez    := FALSE;

l_IdxAbr    := l_PosAbr;
RS_BUSARG(l_CamOri, l_IdxAbr, l_PosAbr OUT, l_FimAbr OUT, l_TipSinal OUT, l_FirstAbr OUT, l_SecondAbr OUT);

WHILE TRUE = TRUE LOOP
     IF   (l_TipSinal = ',') THEN
          IF   (l_CtrVez = FALSE) THEN
               l_CtrVez := TRUE;
               l_StrSql := '('||p_NomCam||' = '||l_FirstAbr||')' ;
          ELSE
               l_StrSql := l_StrSql||' OR ('||p_NomCam||' = '||l_FirstAbr||')' ;
          END IF;
     ELSE
          IF   (l_CtrVez = FALSE) THEN
               l_CtrVez := TRUE;
               l_StrSql := '('||p_NomCam||' >= '||l_FirstAbr||' AND '||p_NomCam||' <= '||l_SecondAbr||')';
          ELSE
               l_StrSql := l_StrSql||' OR ('||p_NomCam||' >= '||l_FirstAbr||' AND '||p_NomCam||' <= '||l_SecondAbr||')';
          END IF;
     END IF;

     IF   (l_FimAbr = TRUE) THEN
          l_StrSql := ' ('||l_StrSql||') ';
          p_StrSql := l_StrSql;
          EXIT;
     END IF;

     l_PosAbr    := l_PosAbr + 1;
     l_FirstAbr  := '';
     l_SecondAbr := '';

     l_IdxAbr    := l_PosAbr;
     RS_BUSARG(l_CamOri, l_IdxAbr, l_PosAbr OUT, l_FimAbr OUT, l_TipSinal OUT, l_FirstAbr OUT, l_SecondAbr OUT);
END LOOP;
END␀Öì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_DATETIME
␀␀PROCEDURE RS_UPDCURCOMP(P_NUMCAN NUMBER(7),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9))
 IS

/* DATEtime que irá conter a data e hora atual */
  l_DthCan NUMBER(14,6); 
  l_SeqCco NUMBER(10);         
CURSOR C_R122CCO IS
  SELECT SEQCCO FROM R122CCO WHERE NUMEMP = P_NUMEMP AND TIPCOL = P_TIPCOL AND NUMCAD = P_NUMCAD AND NUMCAN = P_NUMCAN;
BEGIN
  /* Retorna Data e hora atual (DateTime) */
  SP_DATETIME(l_DthCan OUT);                     
  
  FOREACH C_R122CCO INTO l_SeqCco
  LOOP
    BEGIN
      /* Ajusta data e hora da ultima atualização na R122CCO */
      UPDATE R122CCO SET DTHCAN = l_DthCan WHERE SEQCCO = l_SeqCco;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar R122CCO. (RS_UPDCURCOMP)';
    END;
  END LOOP;      
END␀×ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_DATETIME
␀␀PROCEDURE RS_UPDCURCOMPCUA(P_CODCUA NUMBER(9))
 IS

/* DATEtime que irá conter a data e hora atual */
  l_DthCan NUMBER(14,6);
BEGIN
  /* Retorna Data e hora atual (DateTime) */
  SP_DATETIME(l_DthCan OUT);
  BEGIN
    /* Ajusta data e hora da ultima atualização na R122CCO para Candidatos Externos */
    UPDATE R122CCO
       SET DTHCAN = l_DthCan
     WHERE EXISTS (SELECT 1 FROM R122CCR
                    WHERE R122CCR.CODCUA = p_CodCua
	                    AND R122CCO.NUMCAN = R122CCR.NUMCAN
	                    AND R122CCO.NUMEMP = 0
										  AND R122CCO.TIPCOL = 0
										  AND R122CCO.NUMCAD = 0);
										   
    /* Ajusta data e hora da ultima atualização na R122CCO para Candidatos Internos */
    UPDATE R122CCO
       SET DTHCAN = l_DthCan
     WHERE EXISTS (SELECT 1 FROM R124HCR
                    WHERE R124HCR.CODCUA = p_CodCua
										  AND R122CCO.NUMEMP = R124HCR.NUMEMP
										  AND R122CCO.TIPCOL = R124HCR.TIPCOL
										  AND R122CCO.NUMCAD = R124HCR.NUMCAD
										  AND R122CCO.NUMCAN = 0);
	 	 
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao atualizar R122CCO. (RS_UPDCURCOMPCUA)';
  END;
END␀Øì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_DATETIME
˜␀␀/* Datetime que irá conter a data e hora atual */
PROCEDURE RS_UPDCURCOMPCUF(P_CODCUF NUMBER(4))
 IS

l_DthCan NUMBER(14,6);
BEGIN
  /* Retorna Data e hora atual (DateTime) */
  SP_DATETIME(l_DthCan OUT);
  BEGIN
    /* Ajusta data e hora da ultima atualização na R122CCO para Candidatos Externos */
    UPDATE R122CCO
       SET DTHCAN = l_DthCan
     WHERE EXISTS (SELECT 1 FROM R122CCF
                    WHERE R122CCF.CODCUF = p_CodCuf
	                    AND R122CCO.NUMCAN = R122CCF.NUMCAN
	                    AND R122CCO.NUMEMP = 0
										  AND R122CCO.TIPCOL = 0
										  AND R122CCO.NUMCAD = 0);

    /* Ajusta data e hora da ultima atualização na R122CCO para Candidatos Internos */
    UPDATE R122CCO
       SET DTHCAN = l_DthCan
     WHERE EXISTS (SELECT 1 FROM R124HCF
                    WHERE R124HCF.CODCUF = p_CodCuf
										  AND R122CCO.NUMEMP = R124HCF.NUMEMP
										  AND R122CCO.TIPCOL = R124HCF.TIPCOL
										  AND R122CCO.NUMCAD = R124HCF.NUMCAD
	                    AND R122CCO.NUMCAN = 0);
	 	 
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao atualizar R122CCO. (RS_UPDCURCOMPCUF)';
  END;
END␀Ì÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
æ␀␀PROCEDURE SM_ALTDATINIPER(pDatIniOld DATE, pDatIniNew DATE, pDatIniOut1 OUT DATE, pDatTerOut1 OUT DATE, pDatIniOut2 OUT DATE, pDatTerOut2 OUT DATE)
IS
BEGIN
	IF (pDatIniNew < pDatIniOld) THEN
		/* Criar uma pendência para o dia da nova data de início até um um dia antes da data de início antiga */
		pDatIniOut1 := pDatIniNew;
		pDatTerOut1 := DATETIMEADD(DD, -1, pDatIniOld);
	ELSE
		IF (pDatIniNew > pDatIniOld) THEN
			/* Criar uma pendência para a data de início antiga até um dia antes da nova data de início */
			pDatIniOut1 := pDatIniOld;
			pDatTerOut1 := DATETIMEADD(DD, -1, pDatIniNew);
			
			/* Criar uma pendência para a nova data de início  */
			pDatIniOut2 := pDatIniNew;
			pDatTerOut2 := pDatIniNew;
		END IF;
	END IF;
END␀Í÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
â␀␀PROCEDURE SM_ALTDATTERPER(pDatTerOld DATE, pDatTerNew DATE, pDatIniOut1 OUT DATE, pDatTerOut1 OUT DATE, pDatIniOut2 OUT DATE, pDatTerOut2 OUT DATE)
IS

	l_DataZero DATE;
	l_DataMax DATE;
	l_DataTerminoOld DATE;
	l_DataTerminoNew DATE;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DataMax := DATETIME(04, 06, 2080, 0, 0, 0);
	
	IF (pDatTerOld = l_DataZero) THEN
		l_DataTerminoOld := l_DataMax;
	ELSE
		l_DataTerminoOld := pDatTerOld;
	END IF;
	
	IF (pDatTerNew = l_DataZero) THEN
		l_DataTerminoNew := l_DataMax;
	ELSE
		l_DataTerminoNew := pDatTerNew;
	END IF;

	IF (l_DataTerminoNew > l_DataTerminoOld) THEN
		/* Criar uma pendência para um dia após a nova data de término */
		pDatIniOut1 := DATETIMEADD(DD, 1, l_DataTerminoNew);
		pDatTerOut1 := DATETIMEADD(DD, 1, l_DataTerminoNew);
		
		/* Criar uma pendência para um dia após a data de término antiga até a data de término nova */
		pDatIniOut2 := DATETIMEADD(DD, 1, l_DataTerminoOld);
		pDatTerOut2 := pDatTerNew;
	ELSE
		IF (l_DataTerminoNew < l_DataTerminoOld) THEN
			/* Cria uma pendência para um dia após a nova data de término até a data de término antiga  */
			pDatIniOut1 := DATETIMEADD(DD, 1, l_DataTerminoNew);
			pDatTerOut1 := l_DataTerminoOld;
		END IF;
	END IF;
END␀Î÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
¸␀␀PROCEDURE SM_CONPAR_SST(P_NUMEMP NUMBER(4), P_RETORNO OUT BOOLEAN)
IS

	l_ConsideraParceiro VARCHAR2(1);
BEGIN
	l_ConsideraParceiro := 'N';
	
	BEGIN
		SELECT CONPAR INTO l_ConsideraParceiro
		  FROM R030DES
         WHERE NUMEMP = P_NUMEMP;
		
	EXCEPTION 
	  WHEN NO_DATA_FOUND THEN
	    l_ConsideraParceiro := 'N';	  
	END;  
	  
	
	
	IF (l_ConsideraParceiro = 'N') THEN
	  P_RETORNO := FALSE;
	ELSE  
		P_RETORNO := TRUE;
	END IF;
	
	
END␀Ï÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
