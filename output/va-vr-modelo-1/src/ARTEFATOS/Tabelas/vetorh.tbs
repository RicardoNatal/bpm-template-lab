PROCEDURE SP_RETPEO(P_NUMEMP NUMBER,P_NUMCAD NUMBER,P_NUMCRA NUMBER,P_GRUPO1 OUT VARCHAR2(255),P_INIGR1 OUT VARCHAR2(255),P_FIMGR1 OUT VARCHAR2(255),P_GRUPO2 OUT VARCHAR2(255),P_INIGR2 OUT VARCHAR2(255),P_FIMGR2 OUT VARCHAR2(255),P_GRUPO3 OUT VARCHAR2(255),P_INIGR3 OUT VARCHAR2(255),P_FIMGR3 OUT VARCHAR2(255))
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_codprm      CHAR(5);
  l_datini      CHAR(6);
  l_datfim      CHAR(6);
  l_horini      CHAR(4);
  l_horfim      CHAR(4);
  l_grupo1      CHAR(5);
  l_inigr1      CHAR(10);
  l_fimgr1      CHAR(10);
  l_grupo2      CHAR(5);
  l_inigr2      CHAR(10);
  l_fimgr2      CHAR(10);
  l_grupo3      CHAR(5);
  l_inigr3      CHAR(10);
  l_fimgr3      CHAR(10);
  l_grupox1     CHAR(5);
  l_inigrx1     CHAR(10);
  l_fimgrx1     CHAR(10);
  l_grupox2     CHAR(5);
  l_inigrx2     CHAR(10);
  l_fimgrx2     CHAR(10);
  l_grupox3     CHAR(5);
  l_inigrx3     CHAR(10);
  l_fimgrx3     CHAR(10);
  l_grupo1_con  CHAR(5);
  l_inigr1_con  CHAR(10);
  l_fimgr1_con  CHAR(10);
  l_grupo2_con  CHAR(5);
  l_inigr2_con  CHAR(10);
  l_fimgr2_con  CHAR(10);
  l_grupo3_con  CHAR(5);
  l_inigr3_con  CHAR(10);
  l_fimgr3_con  CHAR(10);
  l_prmrt1      NUMBER(5);
  l_prmrt1_str  CHAR(5);
  l_prmrt2      NUMBER(5);
  l_prmrt2_str  CHAR(5);
  l_prmrt3      NUMBER(5);
  l_prmrt3_str  CHAR(5);
  l_count       NUMBER(2);
  l_usou1_con   BOOLEAN;
  l_usou2_con   BOOLEAN;
  l_usou3_con   BOOLEAN;
  l_usou1_prm   BOOLEAN;
  l_usou2_prm   BOOLEAN;
  l_usou3_prm   BOOLEAN;
  l_numbar      NUMBER(12);
  l_numpro      NUMBER(12);
  l_numsma      NUMBER(12);
  l_crapri      NUMBER(12);
  l_tecpri      NUMBER(1);
  l_geroupendencia BOOLEAN;
  l_idtpes      VARCHAR2(23);
  l_numemp      CHAR(4);
  l_cadocr      CHAR(9);

  CURSOR c_r070PEO IS
       SELECT CODPRM,DATINI,HORINI,DATFIM,HORFIM
         FROM R070PEO
        WHERE R070PEO.NUMEMP = p_numemp AND
              R070PEO.NUMCAD = p_numcad AND
              R070PEO.STAACC = 1 AND
             (R070PEO.DATFIM = l_data_zero OR R070PEO.DATFIM > l_data_atual OR
             (R070PEO.DATFIM = l_data_atual AND R070PEO.HORFIM > l_hora_atual))
        ORDER BY DATINI,HORINI;

  TYPE t_r070PEO IS RECORD(
    CODPRM   R070PEO.CODPRM%TYPE,
    DATINI   R070PEO.DATINI%TYPE,
    HORINI   R070PEO.HORINI%TYPE,
    DATFIM   R070PEO.DATFIM%TYPE,
    HORFIM   R070PEO.HORFIM%TYPE);
  l_r070PEO t_r070PEO;


BEGIN
  /* Inicializa */
  l_usou1_con := FALSE;
  l_usou2_con := FALSE;
  l_usou3_con := FALSE;
  l_usou1_prm := FALSE;
  l_usou2_prm := FALSE;
  l_usou3_prm := FALSE;
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';

  l_grupo1 := '00000';
  l_inigr1 := '0000000000';
  l_fimgr1 := '0000000000';
  l_grupo2 := '00000';
  l_inigr2 := '0000000000';
  l_fimgr2 := '0000000000';
  l_grupo3 := '00000';
  l_inigr3 := '0000000000';
  l_fimgr3 := '0000000000';
  l_geroupendencia:= FALSE;

  FOREACH c_r070PEO INTO l_r070peo.CODPRM,
                         l_r070peo.DATINI,
                         l_r070peo.HORINI,
                         l_r070peo.DATFIM,
                         l_r070peo.HORFIM
  LOOP
     SP_DATSTR(l_r070PEO.DATINI,'DDMMYY',l_datini OUT);

     IF   l_r070PEO.DATFIM <> l_data_zero THEN
          SP_DATSTR(l_r070PEO.DATFIM,'DDMMYY',l_datfim OUT);
     ELSE l_datfim := '311250';
     END IF;

     SP_INTSTR(l_r070PEO.HORINI,'HHMM',l_horini OUT);
     SP_INTSTR(l_r070PEO.HORFIM,'HHMM',l_horfim OUT);
     SP_INTSTR(l_r070PEO.CODPRM,'99999',l_codprm OUT);

     IF    l_grupo1 = '00000' THEN
           l_grupo1 := l_codprm;
           l_inigr1 := l_datini||l_horini;
           l_fimgr1 := l_datfim||l_horfim;
     ELSIF l_grupo2 = '00000' THEN
           l_grupo2 := l_codprm;
           l_inigr2 := l_datini||l_horini;
           l_fimgr2 := l_datfim||l_horfim;
     ELSIF l_grupo3 = '00000' THEN
           l_grupo3 := l_codprm;
           l_inigr3 := l_datini||l_horini;
           l_fimgr3 := l_datfim||l_horfim;
     ELSIF (l_geroupendencia = FALSE) THEN
           l_geroupendencia:= TRUE;
           SP_INTSTR(p_numemp,'9999',l_numemp OUT);
           SP_INTSTR(p_numcad,'999999999',l_cadocr OUT);
           l_idtpes:= '05'||l_numemp||l_cadocr;
           l_idtpes := lTrim(l_idtpes);
           l_idtpes := rTrim(l_idtpes);
           LOOP
               /*Controle do Loop.*/
               IF (Length(l_idtpes) > 22) THEN
                   EXIT;
               END IF;
               l_idtpes := ' '||l_idtpes;
           END LOOP;
           /*Gera pendência de permissão extra*/
           SP_PEND23(l_idtpes);
     END IF;

  END LOOP;

  /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
  SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
  IF (l_crapri = 0) THEN
      l_crapri := p_numcra;
  END IF;
  /*Tratamento para que ao alterar/excluir uma permissão, as permissões não alteradas permaneçam*/
  /*nos mesmos campos PRMRTX, para não atualizar a Pend_Grupo indevidamente*/

  l_prmrt1 := 0;
  l_prmrt2 := 0;
  l_prmrt3 := 0;
  
  BEGIN
      SELECT PRMRT1, PRMRT2, PRMRT3
      INTO l_prmrt1, l_prmrt2, l_prmrt3
      FROM R070CON
      WHERE NUMFIS = l_crapri;
  EXCEPTION
    WHEN OTHERS THEN
      l_prmrt1 := 0;
      l_prmrt2 := 0;
      l_prmrt3 := 0;
  END;

  SP_INTSTR(l_prmrt1,'99999',l_prmrt1_str OUT);
  SP_INTSTR(l_prmrt2,'99999',l_prmrt2_str OUT);
  SP_INTSTR(l_prmrt3,'99999',l_prmrt3_str OUT);
  l_count := 0;
  LOOP
    /*While*/
    l_count := l_count + 1;
    IF (l_count > 3) THEN
        EXIT;
    END IF;
    IF (l_count = 1) THEN
        l_grupox1 := l_grupo1;
        l_inigrx1 := l_inigr1;
        l_fimgrx1 := l_fimgr1;
    ELSIF (l_count = 2) THEN
        l_grupox2 := l_grupo2;
        l_inigrx2 := l_inigr2;
        l_fimgrx2 := l_fimgr2;
    ELSIF (l_count = 3) THEN
        l_grupox3 := l_grupo3;
        l_inigrx3 := l_inigr3;
        l_fimgrx3 := l_fimgr3;
    END IF;
    /*Verificar em qual grupo está a permissão e mantém*/
    IF (l_prmrt1_str = l_grupox1) AND (l_usou1_con = FALSE) THEN
        l_grupo1_con := l_grupox1;
        l_inigr1_con := l_inigrx1;
        l_fimgr1_con := l_fimgrx1;
        l_usou1_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    ELSIF (l_prmrt2_str = l_grupox2) AND (l_usou2_con = FALSE) THEN
        l_grupo2_con := l_grupox2;
        l_inigr2_con := l_inigrx2;
        l_fimgr2_con := l_fimgrx2;
        l_usou2_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    ELSIF (l_prmrt3_str = l_grupox3) AND (l_usou3_con = FALSE) THEN
        l_grupo3_con := l_grupox3;
        l_inigr3_con := l_inigrx3;
        l_fimgr3_con := l_fimgrx3;
        l_usou3_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    END IF;
  END LOOP;

  /*Preeche as permissões que não estavam na R070CON*/
  IF (l_usou1_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo1_con := l_grupo1;
          l_inigr1_con := l_inigr1;
          l_fimgr1_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo1_con := l_grupo2;
          l_inigr1_con := l_inigr2;
          l_fimgr1_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo1_con := l_grupo3;
          l_inigr1_con := l_inigr3;
          l_fimgr1_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF;
  IF (l_usou2_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo2_con := l_grupo1;
          l_inigr2_con := l_inigr1;
          l_fimgr2_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo2_con := l_grupo2;
          l_inigr2_con := l_inigr2;
          l_fimgr2_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo2_con := l_grupo3;
          l_inigr2_con := l_inigr3;
          l_fimgr2_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF;
  IF (l_usou3_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo3_con := l_grupo1;
          l_inigr3_con := l_inigr1;
          l_fimgr3_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo3_con := l_grupo2;
          l_inigr3_con := l_inigr2;
          l_fimgr3_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo3_con := l_grupo3;
          l_inigr3_con := l_inigr3;
          l_fimgr3_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF; 

  SP_INTSTR(l_grupo1_con,'99999',p_grupo1 OUT);
  p_inigr1 := l_inigr1_con;
  p_fimgr1 := l_fimgr1_con;
  SP_INTSTR(l_grupo2_con,'99999',p_grupo2 OUT);
  p_inigr2 := l_inigr2_con;
  p_fimgr2 := l_fimgr2_con;
  SP_INTSTR(l_grupo3_con,'99999',p_grupo3 OUT);
  p_inigr3 := l_inigr3_con;
  p_fimgr3 := l_fimgr3_con;
END		SENIOR;21,SP_DATSTR
SP_INTSTR
SP_PEND23
SP_MAPFIS
Â&␀␀


PROCEDURE SP_RETPEO(P_NUMEMP NUMBER,P_NUMCAD NUMBER,P_NUMCRA NUMBER,P_GRUPO1 OUT VARCHAR2(255),P_INIGR1 OUT VARCHAR2(255),P_FIMGR1 OUT VARCHAR2(255),P_GRUPO2 OUT VARCHAR2(255),P_INIGR2 OUT VARCHAR2(255),P_FIMGR2 OUT VARCHAR2(255),P_GRUPO3 OUT VARCHAR2(255),P_INIGR3 OUT VARCHAR2(255),P_FIMGR3 OUT VARCHAR2(255))
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_codprm      CHAR(5);
  l_datini      CHAR(6);
  l_datfim      CHAR(6);
  l_horini      CHAR(4);
  l_horfim      CHAR(4);
  l_grupo1      CHAR(5);
  l_inigr1      CHAR(10);
  l_fimgr1      CHAR(10);
  l_grupo2      CHAR(5);
  l_inigr2      CHAR(10);
  l_fimgr2      CHAR(10);
  l_grupo3      CHAR(5);
  l_inigr3      CHAR(10);
  l_fimgr3      CHAR(10);
  l_grupox1     CHAR(5);
  l_inigrx1     CHAR(10);
  l_fimgrx1     CHAR(10);
  l_grupox2     CHAR(5);
  l_inigrx2     CHAR(10);
  l_fimgrx2     CHAR(10);
  l_grupox3     CHAR(5);
  l_inigrx3     CHAR(10);
  l_fimgrx3     CHAR(10);
  l_grupo1_con  CHAR(5);
  l_inigr1_con  CHAR(10);
  l_fimgr1_con  CHAR(10);
  l_grupo2_con  CHAR(5);
  l_inigr2_con  CHAR(10);
  l_fimgr2_con  CHAR(10);
  l_grupo3_con  CHAR(5);
  l_inigr3_con  CHAR(10);
  l_fimgr3_con  CHAR(10);
  l_prmrt1      NUMBER(5);
  l_prmrt1_str  CHAR(5);
  l_prmrt2      NUMBER(5);
  l_prmrt2_str  CHAR(5);
  l_prmrt3      NUMBER(5);
  l_prmrt3_str  CHAR(5);
  l_count       NUMBER(2);
  l_usou1_con   BOOLEAN;
  l_usou2_con   BOOLEAN;
  l_usou3_con   BOOLEAN;
  l_usou1_prm   BOOLEAN;
  l_usou2_prm   BOOLEAN;
  l_usou3_prm   BOOLEAN;
  l_numbar      NUMBER(12);
  l_numpro      NUMBER(12);
  l_numsma      NUMBER(12);
  l_crapri      NUMBER(12);
  l_tecpri      NUMBER(1);
  l_geroupendencia BOOLEAN;
  l_idtpes      VARCHAR2(23);
  l_numemp      CHAR(4);
  l_cadocr      CHAR(9);

  CURSOR c_r070PEO IS
       SELECT CODPRM,DATINI,HORINI,DATFIM,HORFIM
         FROM R070PEO
        WHERE R070PEO.NUMEMP = p_numemp AND
              R070PEO.NUMCAD = p_numcad AND
              R070PEO.STAACC = 1 AND
             (R070PEO.DATFIM = l_data_zero OR R070PEO.DATFIM > l_data_atual OR
             (R070PEO.DATFIM = l_data_atual AND R070PEO.HORFIM > l_hora_atual))
        ORDER BY DATINI,HORINI;

  TYPE t_r070PEO IS RECORD(
    CODPRM   R070PEO.CODPRM%TYPE,
    DATINI   R070PEO.DATINI%TYPE,
    HORINI   R070PEO.HORINI%TYPE,
    DATFIM   R070PEO.DATFIM%TYPE,
    HORFIM   R070PEO.HORFIM%TYPE);
  l_r070PEO t_r070PEO;


BEGIN
  /* Inicializa */
  l_usou1_con := FALSE;
  l_usou2_con := FALSE;
  l_usou3_con := FALSE;
  l_usou1_prm := FALSE;
  l_usou2_prm := FALSE;
  l_usou3_prm := FALSE;
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';

  l_grupo1 := '00000';
  l_inigr1 := '0000000000';
  l_fimgr1 := '0000000000';
  l_grupo2 := '00000';
  l_inigr2 := '0000000000';
  l_fimgr2 := '0000000000';
  l_grupo3 := '00000';
  l_inigr3 := '0000000000';
  l_fimgr3 := '0000000000';
  l_geroupendencia:= FALSE;

  FOREACH c_r070PEO INTO l_r070peo.CODPRM,
                         l_r070peo.DATINI,
                         l_r070peo.HORINI,
                         l_r070peo.DATFIM,
                         l_r070peo.HORFIM
  LOOP
     SP_DATSTR(l_r070PEO.DATINI,'DDMMYY',l_datini OUT);

     IF   l_r070PEO.DATFIM <> l_data_zero THEN
          SP_DATSTR(l_r070PEO.DATFIM,'DDMMYY',l_datfim OUT);
     ELSE l_datfim := '311250';
     END IF;

     SP_INTSTR(l_r070PEO.HORINI,'HHMM',l_horini OUT);
     SP_INTSTR(l_r070PEO.HORFIM,'HHMM',l_horfim OUT);
     SP_INTSTR(l_r070PEO.CODPRM,'99999',l_codprm OUT);

     IF    l_grupo1 = '00000' THEN
           l_grupo1 := l_codprm;
           l_inigr1 := l_datini||l_horini;
           l_fimgr1 := l_datfim||l_horfim;
     ELSIF l_grupo2 = '00000' THEN
           l_grupo2 := l_codprm;
           l_inigr2 := l_datini||l_horini;
           l_fimgr2 := l_datfim||l_horfim;
     ELSIF l_grupo3 = '00000' THEN
           l_grupo3 := l_codprm;
           l_inigr3 := l_datini||l_horini;
           l_fimgr3 := l_datfim||l_horfim;
     ELSIF (l_geroupendencia = FALSE) THEN
           l_geroupendencia:= TRUE;
           SP_INTSTR(p_numemp,'9999',l_numemp OUT);
           SP_INTSTR(p_numcad,'999999999',l_cadocr OUT);
           l_idtpes:= '05'||l_numemp||l_cadocr;
           l_idtpes := lTrim(l_idtpes);
           l_idtpes := rTrim(l_idtpes);
           LOOP
               /*Controle do Loop.*/
               IF (Length(l_idtpes) > 22) THEN
                   EXIT;
               END IF;
               l_idtpes := ' '||l_idtpes;
           END LOOP;
           /*Gera pendência de permissão extra*/
           SP_PEND23(l_idtpes);
     END IF;

  END LOOP;

  /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
  SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
  IF (l_crapri = 0) THEN
      l_crapri := p_numcra;
  END IF;
  /*Tratamento para que ao alterar/excluir uma permissão, as permissões não alteradas permaneçam*/
  /*nos mesmos campos PRMRTX, para não atualizar a Pend_Grupo indevidamente*/

  l_prmrt1 := 0;
  l_prmrt2 := 0;
  l_prmrt3 := 0;
  
  BEGIN
      SELECT PRMRT1, PRMRT2, PRMRT3
      INTO l_prmrt1, l_prmrt2, l_prmrt3
      FROM R070CON
      WHERE NUMFIS = l_crapri;
  EXCEPTION
    WHEN OTHERS THEN
      l_prmrt1 := 0;
      l_prmrt2 := 0;
      l_prmrt3 := 0;
  END;

  SP_INTSTR(l_prmrt1,'99999',l_prmrt1_str OUT);
  SP_INTSTR(l_prmrt2,'99999',l_prmrt2_str OUT);
  SP_INTSTR(l_prmrt3,'99999',l_prmrt3_str OUT);
  l_count := 0;
  LOOP
    /*While*/
    l_count := l_count + 1;
    IF (l_count > 3) THEN
        EXIT;
    END IF;
    IF (l_count = 1) THEN
        l_grupox1 := l_grupo1;
        l_inigrx1 := l_inigr1;
        l_fimgrx1 := l_fimgr1;
    ELSIF (l_count = 2) THEN
        l_grupox2 := l_grupo2;
        l_inigrx2 := l_inigr2;
        l_fimgrx2 := l_fimgr2;
    ELSIF (l_count = 3) THEN
        l_grupox3 := l_grupo3;
        l_inigrx3 := l_inigr3;
        l_fimgrx3 := l_fimgr3;
    END IF;
    /*Verificar em qual grupo está a permissão e mantém*/
    IF (l_prmrt1_str = l_grupox1) AND (l_usou1_con = FALSE) THEN
        l_grupo1_con := l_grupox1;
        l_inigr1_con := l_inigrx1;
        l_fimgr1_con := l_fimgrx1;
        l_usou1_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    ELSIF (l_prmrt2_str = l_grupox2) AND (l_usou2_con = FALSE) THEN
        l_grupo2_con := l_grupox2;
        l_inigr2_con := l_inigrx2;
        l_fimgr2_con := l_fimgrx2;
        l_usou2_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    ELSIF (l_prmrt3_str = l_grupox3) AND (l_usou3_con = FALSE) THEN
        l_grupo3_con := l_grupox3;
        l_inigr3_con := l_inigrx3;
        l_fimgr3_con := l_fimgrx3;
        l_usou3_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    END IF;
  END LOOP;

  /*Preeche as permissões que não estavam na R070CON*/
  IF (l_usou1_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo1_con := l_grupo1;
          l_inigr1_con := l_inigr1;
          l_fimgr1_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo1_con := l_grupo2;
          l_inigr1_con := l_inigr2;
          l_fimgr1_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo1_con := l_grupo3;
          l_inigr1_con := l_inigr3;
          l_fimgr1_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF;
  IF (l_usou2_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo2_con := l_grupo1;
          l_inigr2_con := l_inigr1;
          l_fimgr2_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo2_con := l_grupo2;
          l_inigr2_con := l_inigr2;
          l_fimgr2_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo2_con := l_grupo3;
          l_inigr2_con := l_inigr3;
          l_fimgr2_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF;
  IF (l_usou3_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo3_con := l_grupo1;
          l_inigr3_con := l_inigr1;
          l_fimgr3_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo3_con := l_grupo2;
          l_inigr3_con := l_inigr2;
          l_fimgr3_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo3_con := l_grupo3;
          l_inigr3_con := l_inigr3;
          l_fimgr3_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF; 

  SP_INTSTR(l_grupo1_con,'99999',p_grupo1 OUT);
  p_inigr1 := l_inigr1_con;
  p_fimgr1 := l_fimgr1_con;
  SP_INTSTR(l_grupo2_con,'99999',p_grupo2 OUT);
  p_inigr2 := l_inigr2_con;
  p_fimgr2 := l_fimgr2_con;
  SP_INTSTR(l_grupo3_con,'99999',p_grupo3 OUT);
  p_inigr3 := l_inigr3_con;
  p_fimgr3 := l_fimgr3_con;
END		SENIOR;22,SP_DATSTR
SP_INTSTR
SP_PEND23
SP_MAPFIS
Â&␀␀


PROCEDURE SP_RETPEO(P_NUMEMP NUMBER,P_NUMCAD NUMBER,P_NUMCRA NUMBER,P_GRUPO1 OUT VARCHAR2(255),P_INIGR1 OUT VARCHAR2(255),P_FIMGR1 OUT VARCHAR2(255),P_GRUPO2 OUT VARCHAR2(255),P_INIGR2 OUT VARCHAR2(255),P_FIMGR2 OUT VARCHAR2(255),P_GRUPO3 OUT VARCHAR2(255),P_INIGR3 OUT VARCHAR2(255),P_FIMGR3 OUT VARCHAR2(255))
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_codprm      CHAR(5);
  l_datini      CHAR(6);
  l_datfim      CHAR(6);
  l_horini      CHAR(4);
  l_horfim      CHAR(4);
  l_grupo1      CHAR(5);
  l_inigr1      CHAR(10);
  l_fimgr1      CHAR(10);
  l_grupo2      CHAR(5);
  l_inigr2      CHAR(10);
  l_fimgr2      CHAR(10);
  l_grupo3      CHAR(5);
  l_inigr3      CHAR(10);
  l_fimgr3      CHAR(10);
  l_grupox1     CHAR(5);
  l_inigrx1     CHAR(10);
  l_fimgrx1     CHAR(10);
  l_grupox2     CHAR(5);
  l_inigrx2     CHAR(10);
  l_fimgrx2     CHAR(10);
  l_grupox3     CHAR(5);
  l_inigrx3     CHAR(10);
  l_fimgrx3     CHAR(10);
  l_grupo1_con  CHAR(5);
  l_inigr1_con  CHAR(10);
  l_fimgr1_con  CHAR(10);
  l_grupo2_con  CHAR(5);
  l_inigr2_con  CHAR(10);
  l_fimgr2_con  CHAR(10);
  l_grupo3_con  CHAR(5);
  l_inigr3_con  CHAR(10);
  l_fimgr3_con  CHAR(10);
  l_prmrt1      NUMBER(5);
  l_prmrt1_str  CHAR(5);
  l_prmrt2      NUMBER(5);
  l_prmrt2_str  CHAR(5);
  l_prmrt3      NUMBER(5);
  l_prmrt3_str  CHAR(5);
  l_count       NUMBER(2);
  l_usou1_con   BOOLEAN;
  l_usou2_con   BOOLEAN;
  l_usou3_con   BOOLEAN;
  l_usou1_prm   BOOLEAN;
  l_usou2_prm   BOOLEAN;
  l_usou3_prm   BOOLEAN;
  l_numbar      NUMBER(12);
  l_numpro      NUMBER(12);
  l_numsma      NUMBER(12);
  l_crapri      NUMBER(12);
  l_tecpri      NUMBER(1);
  l_geroupendencia BOOLEAN;
  l_idtpes      VARCHAR2(23);
  l_numemp      CHAR(4);
  l_cadocr      CHAR(9);

  CURSOR c_r070PEO IS
       SELECT CODPRM,DATINI,HORINI,DATFIM,HORFIM
         FROM R070PEO
        WHERE R070PEO.NUMEMP = p_numemp AND
              R070PEO.NUMCAD = p_numcad AND
              R070PEO.STAACC = 1 AND
             (R070PEO.DATFIM = l_data_zero OR R070PEO.DATFIM > l_data_atual OR
             (R070PEO.DATFIM = l_data_atual AND R070PEO.HORFIM > l_hora_atual))
        ORDER BY DATINI,HORINI;

  TYPE t_r070PEO IS RECORD(
    CODPRM   R070PEO.CODPRM%TYPE,
    DATINI   R070PEO.DATINI%TYPE,
    HORINI   R070PEO.HORINI%TYPE,
    DATFIM   R070PEO.DATFIM%TYPE,
    HORFIM   R070PEO.HORFIM%TYPE);
  l_r070PEO t_r070PEO;


BEGIN
  /* Inicializa */
  l_usou1_con := FALSE;
  l_usou2_con := FALSE;
  l_usou3_con := FALSE;
  l_usou1_prm := FALSE;
  l_usou2_prm := FALSE;
  l_usou3_prm := FALSE;
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';

  l_grupo1 := '00000';
  l_inigr1 := '0000000000';
  l_fimgr1 := '0000000000';
  l_grupo2 := '00000';
  l_inigr2 := '0000000000';
  l_fimgr2 := '0000000000';
  l_grupo3 := '00000';
  l_inigr3 := '0000000000';
  l_fimgr3 := '0000000000';
  l_geroupendencia:= FALSE;

  FOREACH c_r070PEO INTO l_r070peo.CODPRM,
                         l_r070peo.DATINI,
                         l_r070peo.HORINI,
                         l_r070peo.DATFIM,
                         l_r070peo.HORFIM
  LOOP
     SP_DATSTR(l_r070PEO.DATINI,'DDMMYY',l_datini OUT);

     IF   l_r070PEO.DATFIM <> l_data_zero THEN
          SP_DATSTR(l_r070PEO.DATFIM,'DDMMYY',l_datfim OUT);
     ELSE l_datfim := '311250';
     END IF;

     SP_INTSTR(l_r070PEO.HORINI,'HHMM',l_horini OUT);
     SP_INTSTR(l_r070PEO.HORFIM,'HHMM',l_horfim OUT);
     SP_INTSTR(l_r070PEO.CODPRM,'99999',l_codprm OUT);

     IF    l_grupo1 = '00000' THEN
           l_grupo1 := l_codprm;
           l_inigr1 := l_datini||l_horini;
           l_fimgr1 := l_datfim||l_horfim;
     ELSIF l_grupo2 = '00000' THEN
           l_grupo2 := l_codprm;
           l_inigr2 := l_datini||l_horini;
           l_fimgr2 := l_datfim||l_horfim;
     ELSIF l_grupo3 = '00000' THEN
           l_grupo3 := l_codprm;
           l_inigr3 := l_datini||l_horini;
           l_fimgr3 := l_datfim||l_horfim;
     ELSIF (l_geroupendencia = FALSE) THEN
           l_geroupendencia:= TRUE;
           SP_INTSTR(p_numemp,'9999',l_numemp OUT);
           SP_INTSTR(p_numcad,'999999999',l_cadocr OUT);
           l_idtpes:= '05'||l_numemp||l_cadocr;
           l_idtpes := lTrim(l_idtpes);
           l_idtpes := rTrim(l_idtpes);
           LOOP
               /*Controle do Loop.*/
               IF (Length(l_idtpes) > 22) THEN
                   EXIT;
               END IF;
               l_idtpes := ' '||l_idtpes;
           END LOOP;
           /*Gera pendência de permissão extra*/
           SP_PEND23(l_idtpes);
     END IF;

  END LOOP;

  /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
  SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
  IF (l_crapri = 0) THEN
      l_crapri := p_numcra;
  END IF;
  /*Tratamento para que ao alterar/excluir uma permissão, as permissões não alteradas permaneçam*/
  /*nos mesmos campos PRMRTX, para não atualizar a Pend_Grupo indevidamente*/

  l_prmrt1 := 0;
  l_prmrt2 := 0;
  l_prmrt3 := 0;
  
  BEGIN
      SELECT PRMRT1, PRMRT2, PRMRT3
      INTO l_prmrt1, l_prmrt2, l_prmrt3
      FROM R070CON
      WHERE NUMFIS = l_crapri;
  EXCEPTION
    WHEN OTHERS THEN
      l_prmrt1 := 0;
      l_prmrt2 := 0;
      l_prmrt3 := 0;
  END;

  SP_INTSTR(l_prmrt1,'99999',l_prmrt1_str OUT);
  SP_INTSTR(l_prmrt2,'99999',l_prmrt2_str OUT);
  SP_INTSTR(l_prmrt3,'99999',l_prmrt3_str OUT);
  l_count := 0;
  LOOP
    /*While*/
    l_count := l_count + 1;
    IF (l_count > 3) THEN
        EXIT;
    END IF;
    IF (l_count = 1) THEN
        l_grupox1 := l_grupo1;
        l_inigrx1 := l_inigr1;
        l_fimgrx1 := l_fimgr1;
    ELSIF (l_count = 2) THEN
        l_grupox2 := l_grupo2;
        l_inigrx2 := l_inigr2;
        l_fimgrx2 := l_fimgr2;
    ELSIF (l_count = 3) THEN
        l_grupox3 := l_grupo3;
        l_inigrx3 := l_inigr3;
        l_fimgrx3 := l_fimgr3;
    END IF;
    /*Verificar em qual grupo está a permissão e mantém*/
    IF (l_prmrt1_str = l_grupox1) AND (l_usou1_con = FALSE) THEN
        l_grupo1_con := l_grupox1;
        l_inigr1_con := l_inigrx1;
        l_fimgr1_con := l_fimgrx1;
        l_usou1_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    ELSIF (l_prmrt2_str = l_grupox2) AND (l_usou2_con = FALSE) THEN
        l_grupo2_con := l_grupox2;
        l_inigr2_con := l_inigrx2;
        l_fimgr2_con := l_fimgrx2;
        l_usou2_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    ELSIF (l_prmrt3_str = l_grupox3) AND (l_usou3_con = FALSE) THEN
        l_grupo3_con := l_grupox3;
        l_inigr3_con := l_inigrx3;
        l_fimgr3_con := l_fimgrx3;
        l_usou3_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    END IF;
  END LOOP;

  /*Preeche as permissões que não estavam na R070CON*/
  IF (l_usou1_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo1_con := l_grupo1;
          l_inigr1_con := l_inigr1;
          l_fimgr1_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo1_con := l_grupo2;
          l_inigr1_con := l_inigr2;
          l_fimgr1_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo1_con := l_grupo3;
          l_inigr1_con := l_inigr3;
          l_fimgr1_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF;
  IF (l_usou2_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo2_con := l_grupo1;
          l_inigr2_con := l_inigr1;
          l_fimgr2_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo2_con := l_grupo2;
          l_inigr2_con := l_inigr2;
          l_fimgr2_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo2_con := l_grupo3;
          l_inigr2_con := l_inigr3;
          l_fimgr2_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF;
  IF (l_usou3_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo3_con := l_grupo1;
          l_inigr3_con := l_inigr1;
          l_fimgr3_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo3_con := l_grupo2;
          l_inigr3_con := l_inigr2;
          l_fimgr3_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo3_con := l_grupo3;
          l_inigr3_con := l_inigr3;
          l_fimgr3_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF; 

  SP_INTSTR(l_grupo1_con,'99999',p_grupo1 OUT);
  p_inigr1 := l_inigr1_con;
  p_fimgr1 := l_fimgr1_con;
  SP_INTSTR(l_grupo2_con,'99999',p_grupo2 OUT);
  p_inigr2 := l_inigr2_con;
  p_fimgr2 := l_fimgr2_con;
  SP_INTSTR(l_grupo3_con,'99999',p_grupo3 OUT);
  p_inigr3 := l_inigr3_con;
  p_fimgr3 := l_fimgr3_con;
END		SENIOR;23,SP_DATSTR
SP_INTSTR
SP_PEND23
SP_MAPFIS
Â&␀␀


PROCEDURE SP_RETPEO(P_NUMEMP NUMBER,P_NUMCAD NUMBER,P_NUMCRA NUMBER,P_GRUPO1 OUT VARCHAR2(255),P_INIGR1 OUT VARCHAR2(255),P_FIMGR1 OUT VARCHAR2(255),P_GRUPO2 OUT VARCHAR2(255),P_INIGR2 OUT VARCHAR2(255),P_FIMGR2 OUT VARCHAR2(255),P_GRUPO3 OUT VARCHAR2(255),P_INIGR3 OUT VARCHAR2(255),P_FIMGR3 OUT VARCHAR2(255))
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_codprm      CHAR(5);
  l_datini      CHAR(6);
  l_datfim      CHAR(6);
  l_horini      CHAR(4);
  l_horfim      CHAR(4);
  l_grupo1      CHAR(5);
  l_inigr1      CHAR(10);
  l_fimgr1      CHAR(10);
  l_grupo2      CHAR(5);
  l_inigr2      CHAR(10);
  l_fimgr2      CHAR(10);
  l_grupo3      CHAR(5);
  l_inigr3      CHAR(10);
  l_fimgr3      CHAR(10);
  l_grupox1     CHAR(5);
  l_inigrx1     CHAR(10);
  l_fimgrx1     CHAR(10);
  l_grupox2     CHAR(5);
  l_inigrx2     CHAR(10);
  l_fimgrx2     CHAR(10);
  l_grupox3     CHAR(5);
  l_inigrx3     CHAR(10);
  l_fimgrx3     CHAR(10);
  l_grupo1_con  CHAR(5);
  l_inigr1_con  CHAR(10);
  l_fimgr1_con  CHAR(10);
  l_grupo2_con  CHAR(5);
  l_inigr2_con  CHAR(10);
  l_fimgr2_con  CHAR(10);
  l_grupo3_con  CHAR(5);
  l_inigr3_con  CHAR(10);
  l_fimgr3_con  CHAR(10);
  l_prmrt1      NUMBER(5);
  l_prmrt1_str  CHAR(5);
  l_prmrt2      NUMBER(5);
  l_prmrt2_str  CHAR(5);
  l_prmrt3      NUMBER(5);
  l_prmrt3_str  CHAR(5);
  l_count       NUMBER(2);
  l_usou1_con   BOOLEAN;
  l_usou2_con   BOOLEAN;
  l_usou3_con   BOOLEAN;
  l_usou1_prm   BOOLEAN;
  l_usou2_prm   BOOLEAN;
  l_usou3_prm   BOOLEAN;
  l_numbar      NUMBER(12);
  l_numpro      NUMBER(12);
  l_numsma      NUMBER(12);
  l_crapri      NUMBER(12);
  l_tecpri      NUMBER(1);
  l_geroupendencia BOOLEAN;
  l_idtpes      VARCHAR2(23);
  l_numemp      CHAR(4);
  l_cadocr      CHAR(9);

  CURSOR c_r070PEO IS
       SELECT CODPRM,DATINI,HORINI,DATFIM,HORFIM
         FROM R070PEO
        WHERE R070PEO.NUMEMP = p_numemp AND
              R070PEO.NUMCAD = p_numcad AND
              R070PEO.STAACC = 1 AND
             (R070PEO.DATFIM = l_data_zero OR R070PEO.DATFIM > l_data_atual OR
             (R070PEO.DATFIM = l_data_atual AND R070PEO.HORFIM > l_hora_atual))
        ORDER BY DATINI,HORINI;

  TYPE t_r070PEO IS RECORD(
    CODPRM   R070PEO.CODPRM%TYPE,
    DATINI   R070PEO.DATINI%TYPE,
    HORINI   R070PEO.HORINI%TYPE,
    DATFIM   R070PEO.DATFIM%TYPE,
    HORFIM   R070PEO.HORFIM%TYPE);
  l_r070PEO t_r070PEO;


BEGIN
  /* Inicializa */
  l_usou1_con := FALSE;
  l_usou2_con := FALSE;
  l_usou3_con := FALSE;
  l_usou1_prm := FALSE;
  l_usou2_prm := FALSE;
  l_usou3_prm := FALSE;
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';

  l_grupo1 := '00000';
  l_inigr1 := '0000000000';
  l_fimgr1 := '0000000000';
  l_grupo2 := '00000';
  l_inigr2 := '0000000000';
  l_fimgr2 := '0000000000';
  l_grupo3 := '00000';
  l_inigr3 := '0000000000';
  l_fimgr3 := '0000000000';
  l_geroupendencia:= FALSE;

  FOREACH c_r070PEO INTO l_r070peo.CODPRM,
                         l_r070peo.DATINI,
                         l_r070peo.HORINI,
                         l_r070peo.DATFIM,
                         l_r070peo.HORFIM
  LOOP
     SP_DATSTR(l_r070PEO.DATINI,'DDMMYY',l_datini OUT);

     IF   l_r070PEO.DATFIM <> l_data_zero THEN
          SP_DATSTR(l_r070PEO.DATFIM,'DDMMYY',l_datfim OUT);
     ELSE l_datfim := '311250';
     END IF;

     SP_INTSTR(l_r070PEO.HORINI,'HHMM',l_horini OUT);
     SP_INTSTR(l_r070PEO.HORFIM,'HHMM',l_horfim OUT);
     SP_INTSTR(l_r070PEO.CODPRM,'99999',l_codprm OUT);

     IF    l_grupo1 = '00000' THEN
           l_grupo1 := l_codprm;
           l_inigr1 := l_datini||l_horini;
           l_fimgr1 := l_datfim||l_horfim;
     ELSIF l_grupo2 = '00000' THEN
           l_grupo2 := l_codprm;
           l_inigr2 := l_datini||l_horini;
           l_fimgr2 := l_datfim||l_horfim;
     ELSIF l_grupo3 = '00000' THEN
           l_grupo3 := l_codprm;
           l_inigr3 := l_datini||l_horini;
           l_fimgr3 := l_datfim||l_horfim;
     ELSIF (l_geroupendencia = FALSE) THEN
           l_geroupendencia:= TRUE;
           SP_INTSTR(p_numemp,'9999',l_numemp OUT);
           SP_INTSTR(p_numcad,'999999999',l_cadocr OUT);
           l_idtpes:= '05'||l_numemp||l_cadocr;
           l_idtpes := lTrim(l_idtpes);
           l_idtpes := rTrim(l_idtpes);
           LOOP
               /*Controle do Loop.*/
               IF (Length(l_idtpes) > 22) THEN
                   EXIT;
               END IF;
               l_idtpes := ' '||l_idtpes;
           END LOOP;
           /*Gera pendência de permissão extra*/
           SP_PEND23(l_idtpes);
     END IF;

  END LOOP;

  /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
  SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
  IF (l_crapri = 0) THEN
      l_crapri := p_numcra;
  END IF;
  /*Tratamento para que ao alterar/excluir uma permissão, as permissões não alteradas permaneçam*/
  /*nos mesmos campos PRMRTX, para não atualizar a Pend_Grupo indevidamente*/

  l_prmrt1 := 0;
  l_prmrt2 := 0;
  l_prmrt3 := 0;
  
  BEGIN
      SELECT PRMRT1, PRMRT2, PRMRT3
      INTO l_prmrt1, l_prmrt2, l_prmrt3
      FROM R070CON
      WHERE NUMFIS = l_crapri;
  EXCEPTION
    WHEN OTHERS THEN
      l_prmrt1 := 0;
      l_prmrt2 := 0;
      l_prmrt3 := 0;
  END;

  SP_INTSTR(l_prmrt1,'99999',l_prmrt1_str OUT);
  SP_INTSTR(l_prmrt2,'99999',l_prmrt2_str OUT);
  SP_INTSTR(l_prmrt3,'99999',l_prmrt3_str OUT);
  l_count := 0;
  LOOP
    /*While*/
    l_count := l_count + 1;
    IF (l_count > 3) THEN
        EXIT;
    END IF;
    IF (l_count = 1) THEN
        l_grupox1 := l_grupo1;
        l_inigrx1 := l_inigr1;
        l_fimgrx1 := l_fimgr1;
    ELSIF (l_count = 2) THEN
        l_grupox2 := l_grupo2;
        l_inigrx2 := l_inigr2;
        l_fimgrx2 := l_fimgr2;
    ELSIF (l_count = 3) THEN
        l_grupox3 := l_grupo3;
        l_inigrx3 := l_inigr3;
        l_fimgrx3 := l_fimgr3;
    END IF;
    /*Verificar em qual grupo está a permissão e mantém*/
    IF (l_prmrt1_str = l_grupox1) AND (l_usou1_con = FALSE) THEN
        l_grupo1_con := l_grupox1;
        l_inigr1_con := l_inigrx1;
        l_fimgr1_con := l_fimgrx1;
        l_usou1_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    ELSIF (l_prmrt2_str = l_grupox2) AND (l_usou2_con = FALSE) THEN
        l_grupo2_con := l_grupox2;
        l_inigr2_con := l_inigrx2;
        l_fimgr2_con := l_fimgrx2;
        l_usou2_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    ELSIF (l_prmrt3_str = l_grupox3) AND (l_usou3_con = FALSE) THEN
        l_grupo3_con := l_grupox3;
        l_inigr3_con := l_inigrx3;
        l_fimgr3_con := l_fimgrx3;
        l_usou3_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    END IF;
  END LOOP;

  /*Preeche as permissões que não estavam na R070CON*/
  IF (l_usou1_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo1_con := l_grupo1;
          l_inigr1_con := l_inigr1;
          l_fimgr1_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo1_con := l_grupo2;
          l_inigr1_con := l_inigr2;
          l_fimgr1_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo1_con := l_grupo3;
          l_inigr1_con := l_inigr3;
          l_fimgr1_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF;
  IF (l_usou2_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo2_con := l_grupo1;
          l_inigr2_con := l_inigr1;
          l_fimgr2_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo2_con := l_grupo2;
          l_inigr2_con := l_inigr2;
          l_fimgr2_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo2_con := l_grupo3;
          l_inigr2_con := l_inigr3;
          l_fimgr2_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF;
  IF (l_usou3_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo3_con := l_grupo1;
          l_inigr3_con := l_inigr1;
          l_fimgr3_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo3_con := l_grupo2;
          l_inigr3_con := l_inigr2;
          l_fimgr3_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo3_con := l_grupo3;
          l_inigr3_con := l_inigr3;
          l_fimgr3_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF; 

  SP_INTSTR(l_grupo1_con,'99999',p_grupo1 OUT);
  p_inigr1 := l_inigr1_con;
  p_fimgr1 := l_fimgr1_con;
  SP_INTSTR(l_grupo2_con,'99999',p_grupo2 OUT);
  p_inigr2 := l_inigr2_con;
  p_fimgr2 := l_fimgr2_con;
  SP_INTSTR(l_grupo3_con,'99999',p_grupo3 OUT);
  p_inigr3 := l_inigr3_con;
  p_fimgr3 := l_fimgr3_con;
END		SENIOR;24,SP_DATSTR
SP_INTSTR
SP_PEND23
SP_MAPFIS
Â&␀␀


PROCEDURE SP_RETPEO(P_NUMEMP NUMBER,P_NUMCAD NUMBER,P_NUMCRA NUMBER,P_GRUPO1 OUT VARCHAR2(255),P_INIGR1 OUT VARCHAR2(255),P_FIMGR1 OUT VARCHAR2(255),P_GRUPO2 OUT VARCHAR2(255),P_INIGR2 OUT VARCHAR2(255),P_FIMGR2 OUT VARCHAR2(255),P_GRUPO3 OUT VARCHAR2(255),P_INIGR3 OUT VARCHAR2(255),P_FIMGR3 OUT VARCHAR2(255))
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_codprm      CHAR(5);
  l_datini      CHAR(6);
  l_datfim      CHAR(6);
  l_horini      CHAR(4);
  l_horfim      CHAR(4);
  l_grupo1      CHAR(5);
  l_inigr1      CHAR(10);
  l_fimgr1      CHAR(10);
  l_grupo2      CHAR(5);
  l_inigr2      CHAR(10);
  l_fimgr2      CHAR(10);
  l_grupo3      CHAR(5);
  l_inigr3      CHAR(10);
  l_fimgr3      CHAR(10);
  l_grupox1     CHAR(5);
  l_inigrx1     CHAR(10);
  l_fimgrx1     CHAR(10);
  l_grupox2     CHAR(5);
  l_inigrx2     CHAR(10);
  l_fimgrx2     CHAR(10);
  l_grupox3     CHAR(5);
  l_inigrx3     CHAR(10);
  l_fimgrx3     CHAR(10);
  l_grupo1_con  CHAR(5);
  l_inigr1_con  CHAR(10);
  l_fimgr1_con  CHAR(10);
  l_grupo2_con  CHAR(5);
  l_inigr2_con  CHAR(10);
  l_fimgr2_con  CHAR(10);
  l_grupo3_con  CHAR(5);
  l_inigr3_con  CHAR(10);
  l_fimgr3_con  CHAR(10);
  l_prmrt1      NUMBER(5);
  l_prmrt1_str  CHAR(5);
  l_prmrt2      NUMBER(5);
  l_prmrt2_str  CHAR(5);
  l_prmrt3      NUMBER(5);
  l_prmrt3_str  CHAR(5);
  l_count       NUMBER(2);
  l_usou1_con   BOOLEAN;
  l_usou2_con   BOOLEAN;
  l_usou3_con   BOOLEAN;
  l_usou1_prm   BOOLEAN;
  l_usou2_prm   BOOLEAN;
  l_usou3_prm   BOOLEAN;
  l_numbar      NUMBER(12);
  l_numpro      NUMBER(12);
  l_numsma      NUMBER(12);
  l_crapri      NUMBER(12);
  l_tecpri      NUMBER(1);
  l_geroupendencia BOOLEAN;
  l_idtpes      VARCHAR2(23);
  l_numemp      CHAR(4);
  l_cadocr      CHAR(9);

  CURSOR c_r070PEO IS
       SELECT CODPRM,DATINI,HORINI,DATFIM,HORFIM
         FROM R070PEO
        WHERE R070PEO.NUMEMP = p_numemp AND
              R070PEO.NUMCAD = p_numcad AND
              R070PEO.STAACC = 1 AND
             (R070PEO.DATFIM = l_data_zero OR R070PEO.DATFIM > l_data_atual OR
             (R070PEO.DATFIM = l_data_atual AND R070PEO.HORFIM > l_hora_atual))
        ORDER BY DATINI,HORINI;

  TYPE t_r070PEO IS RECORD(
    CODPRM   R070PEO.CODPRM%TYPE,
    DATINI   R070PEO.DATINI%TYPE,
    HORINI   R070PEO.HORINI%TYPE,
    DATFIM   R070PEO.DATFIM%TYPE,
    HORFIM   R070PEO.HORFIM%TYPE);
  l_r070PEO t_r070PEO;


BEGIN
  /* Inicializa */
  l_usou1_con := FALSE;
  l_usou2_con := FALSE;
  l_usou3_con := FALSE;
  l_usou1_prm := FALSE;
  l_usou2_prm := FALSE;
  l_usou3_prm := FALSE;
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';

  l_grupo1 := '00000';
  l_inigr1 := '0000000000';
  l_fimgr1 := '0000000000';
  l_grupo2 := '00000';
  l_inigr2 := '0000000000';
  l_fimgr2 := '0000000000';
  l_grupo3 := '00000';
  l_inigr3 := '0000000000';
  l_fimgr3 := '0000000000';
  l_geroupendencia:= FALSE;

  FOREACH c_r070PEO INTO l_r070peo.CODPRM,
                         l_r070peo.DATINI,
                         l_r070peo.HORINI,
                         l_r070peo.DATFIM,
                         l_r070peo.HORFIM
  LOOP
     SP_DATSTR(l_r070PEO.DATINI,'DDMMYY',l_datini OUT);

     IF   l_r070PEO.DATFIM <> l_data_zero THEN
          SP_DATSTR(l_r070PEO.DATFIM,'DDMMYY',l_datfim OUT);
     ELSE l_datfim := '311250';
     END IF;

     SP_INTSTR(l_r070PEO.HORINI,'HHMM',l_horini OUT);
     SP_INTSTR(l_r070PEO.HORFIM,'HHMM',l_horfim OUT);
     SP_INTSTR(l_r070PEO.CODPRM,'99999',l_codprm OUT);

     IF    l_grupo1 = '00000' THEN
           l_grupo1 := l_codprm;
           l_inigr1 := l_datini||l_horini;
           l_fimgr1 := l_datfim||l_horfim;
     ELSIF l_grupo2 = '00000' THEN
           l_grupo2 := l_codprm;
           l_inigr2 := l_datini||l_horini;
           l_fimgr2 := l_datfim||l_horfim;
     ELSIF l_grupo3 = '00000' THEN
           l_grupo3 := l_codprm;
           l_inigr3 := l_datini||l_horini;
           l_fimgr3 := l_datfim||l_horfim;
     ELSIF (l_geroupendencia = FALSE) THEN
           l_geroupendencia:= TRUE;
           SP_INTSTR(p_numemp,'9999',l_numemp OUT);
           SP_INTSTR(p_numcad,'999999999',l_cadocr OUT);
           l_idtpes:= '05'||l_numemp||l_cadocr;
           l_idtpes := lTrim(l_idtpes);
           l_idtpes := rTrim(l_idtpes);
           LOOP
               /*Controle do Loop.*/
               IF (Length(l_idtpes) > 22) THEN
                   EXIT;
               END IF;
               l_idtpes := ' '||l_idtpes;
           END LOOP;
           /*Gera pendência de permissão extra*/
           SP_PEND23(l_idtpes);
     END IF;

  END LOOP;

  /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
  SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
  IF (l_crapri = 0) THEN
      l_crapri := p_numcra;
  END IF;
  /*Tratamento para que ao alterar/excluir uma permissão, as permissões não alteradas permaneçam*/
  /*nos mesmos campos PRMRTX, para não atualizar a Pend_Grupo indevidamente*/

  l_prmrt1 := 0;
  l_prmrt2 := 0;
  l_prmrt3 := 0;
  
  BEGIN
      SELECT PRMRT1, PRMRT2, PRMRT3
      INTO l_prmrt1, l_prmrt2, l_prmrt3
      FROM R070CON
      WHERE NUMFIS = l_crapri;
  EXCEPTION
    WHEN OTHERS THEN
      l_prmrt1 := 0;
      l_prmrt2 := 0;
      l_prmrt3 := 0;
  END;

  SP_INTSTR(l_prmrt1,'99999',l_prmrt1_str OUT);
  SP_INTSTR(l_prmrt2,'99999',l_prmrt2_str OUT);
  SP_INTSTR(l_prmrt3,'99999',l_prmrt3_str OUT);
  l_count := 0;
  LOOP
    /*While*/
    l_count := l_count + 1;
    IF (l_count > 3) THEN
        EXIT;
    END IF;
    IF (l_count = 1) THEN
        l_grupox1 := l_grupo1;
        l_inigrx1 := l_inigr1;
        l_fimgrx1 := l_fimgr1;
    ELSIF (l_count = 2) THEN
        l_grupox2 := l_grupo2;
        l_inigrx2 := l_inigr2;
        l_fimgrx2 := l_fimgr2;
    ELSIF (l_count = 3) THEN
        l_grupox3 := l_grupo3;
        l_inigrx3 := l_inigr3;
        l_fimgrx3 := l_fimgr3;
    END IF;
    /*Verificar em qual grupo está a permissão e mantém*/
    IF (l_prmrt1_str = l_grupox1) AND (l_usou1_con = FALSE) THEN
        l_grupo1_con := l_grupox1;
        l_inigr1_con := l_inigrx1;
        l_fimgr1_con := l_fimgrx1;
        l_usou1_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    ELSIF (l_prmrt2_str = l_grupox2) AND (l_usou2_con = FALSE) THEN
        l_grupo2_con := l_grupox2;
        l_inigr2_con := l_inigrx2;
        l_fimgr2_con := l_fimgrx2;
        l_usou2_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    ELSIF (l_prmrt3_str = l_grupox3) AND (l_usou3_con = FALSE) THEN
        l_grupo3_con := l_grupox3;
        l_inigr3_con := l_inigrx3;
        l_fimgr3_con := l_fimgrx3;
        l_usou3_con := TRUE;
        /*Verifica qual permissão foi utilizada*/
        IF (l_count = 1) THEN
            l_usou1_prm := TRUE;
        ELSIF (l_count = 2) THEN
            l_usou2_prm := TRUE;
        ELSIF (l_count = 3) THEN
            l_usou3_prm := TRUE;
        END IF;
    END IF;
  END LOOP;

  /*Preeche as permissões que não estavam na R070CON*/
  IF (l_usou1_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo1_con := l_grupo1;
          l_inigr1_con := l_inigr1;
          l_fimgr1_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo1_con := l_grupo2;
          l_inigr1_con := l_inigr2;
          l_fimgr1_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo1_con := l_grupo3;
          l_inigr1_con := l_inigr3;
          l_fimgr1_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF;
  IF (l_usou2_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo2_con := l_grupo1;
          l_inigr2_con := l_inigr1;
          l_fimgr2_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo2_con := l_grupo2;
          l_inigr2_con := l_inigr2;
          l_fimgr2_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo2_con := l_grupo3;
          l_inigr2_con := l_inigr3;
          l_fimgr2_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF;
  IF (l_usou3_con = FALSE) THEN
      IF (l_usou1_prm = FALSE) THEN
          l_grupo3_con := l_grupo1;
          l_inigr3_con := l_inigr1;
          l_fimgr3_con := l_fimgr1;
          l_usou1_prm := TRUE;
      ELSIF (l_usou2_prm = FALSE) THEN
          l_grupo3_con := l_grupo2;
          l_inigr3_con := l_inigr2;
          l_fimgr3_con := l_fimgr2;
          l_usou2_prm := TRUE;
      ELSIF (l_usou3_prm = FALSE) THEN
          l_grupo3_con := l_grupo3;
          l_inigr3_con := l_inigr3;
          l_fimgr3_con := l_fimgr3;
          l_usou3_prm := TRUE;
      END IF;
  END IF; 

  SP_INTSTR(l_grupo1_con,'99999',p_grupo1 OUT);
  p_inigr1 := l_inigr1_con;
  p_fimgr1 := l_fimgr1_con;
  SP_INTSTR(l_grupo2_con,'99999',p_grupo2 OUT);
  p_inigr2 := l_inigr2_con;
  p_fimgr2 := l_fimgr2_con;
  SP_INTSTR(l_grupo3_con,'99999',p_grupo3 OUT);
  p_inigr3 := l_inigr3_con;
  p_fimgr3 := l_fimgr3_con;
END␀Ïø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
œ␀␀/* Retornas as permissões para areas restritas para o visitante */
