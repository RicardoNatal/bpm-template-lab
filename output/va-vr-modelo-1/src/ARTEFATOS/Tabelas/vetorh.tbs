t␀␀PROCEDURE SP_RETICARD(P_IDTPES VARCHAR2(23),P_NUMCRA NUMBER(12), P_ICARDA OUT VARCHAR2(12), P_ICARDR OUT VARCHAR2(12), P_NUMSER OUT VARCHAR2(12))
 IS

  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_teccra       NUMBER(1);
  l_chcpri       NUMBER(12);
  l_numcra       NUMBER(12);
  l_numfis       NUMBER(12);
  l_chcAce       VARCHAR(1); 
  l_chcRep       VARCHAR(1);
BEGIN
  SP_INTSTR(p_NumCra, '999999999999', p_icardR OUT);      
  SP_INTSTR(p_NumCra, '999999999999', p_icardA OUT);
  p_numser := '          ';
  l_teccra := 1; 
  
  /* Verifica o crachá da pessoa */
  IF (p_idtPes IS NULL OR LTRIM(p_idtPes) = '' OR LTRIM(p_idtPes) IS NULL) THEN
      SP_MAPFIS(P_NUMCRA, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_teccra OUT, l_chcPri OUT);      
  ELSE 
      /* Se tem IDTPES, pesquisa na R070CON*/
      BEGIN
          SELECT NUMCRA, NUMFIS, CHCPRI, TECCRA INTO l_numcra, l_numfis, l_chcpri, l_teccra
          FROM R070CON WHERE IDTPES = p_idtpes AND NumCra = p_NumCra AND CHCPRI = 0;
      EXCEPTION
          WHEN OTHERS THEN l_teccra := 0; /* sai da rotina*/
      END;
      
      IF (l_teccra = 1) THEN
           l_numbar:= l_numfis;
           l_numpro:= 0;
           l_numsma:= 0;
      END IF;
      IF (l_teccra = 2) THEN
           l_numbar:= l_numcra;
           l_numpro:= l_numfis;
           l_numsma:= 0;      
      END IF; 
      IF (l_teccra = 3) THEN
           l_numbar:= l_numcra;
           l_numpro:= 0;
           l_numsma:= l_numfis;      
      END IF; 
	  
      IF (l_teccra < 3) THEN
	    BEGIN
	      SELECT NUMFIS INTO l_numsma FROM R070CON WHERE IDTPES = p_idtpes AND NUMCRA = p_NumCra AND CHCPRI = l_numfis AND TECCRA = 3;
	    EXCEPTION
          WHEN OTHERS THEN l_numsma := 0;
        END;
	  END IF;
  END IF;
  
  /* Barras */
  IF (l_teccra = 1) THEN
      SP_INTSTR(l_numbar, '999999999999', p_icardA OUT);
      SP_INTSTR(l_numbar, '999999999999', p_icardR OUT);
	  SP_INTSTR(l_numsma, '999999999999', p_numser OUT);
  END IF;
  
  /* proximidade */
  IF (l_teccra = 2) THEN
      SP_INTSTR(l_numpro, '999999999999', p_icardA OUT);
      SP_INTSTR(l_numpro, '999999999999', p_icardR OUT);      
      SP_INTSTR(l_numsma, '999999999999', p_numser OUT);
  END IF;
  
  /* smart */
  IF (l_teccra = 3) THEN
      /* Verifica definições Telemática */
      BEGIN
          SELECT CHCACE, CHCREP INTO l_chcAce, l_chcRep FROM R070TSI;
      EXCEPTION
          WHEN OTHERS THEN  
              l_chcAce := 0;
              l_chcRep := 0;
      END;
      
      IF (l_chcAce = 0) THEN
          IF (l_numbar <> 0) THEN
              SP_INTSTR(l_numbar, '999999999999', p_icardA OUT);
          END IF;
          p_numser := l_numsma;            
      ELSE
        IF (l_chcAce = 3) THEN
          IF (l_numbar <> 0) THEN
              SP_INTSTR(l_numbar, '999999999999', p_icardA OUT);
          END IF;
          p_numser := l_numsma;
        ELSE
          SP_INTSTR(l_numsma, '999999999999', p_icardA OUT);
          p_numser := '          ';
        END IF;
      END IF;    
      
      IF (l_chcRep = 0) THEN
          IF (l_numbar <> 0) THEN
              SP_INTSTR(l_numbar, '999999999999', p_icardR OUT);
          END IF;
      ELSE
          SP_INTSTR(l_numsma, '999999999999', p_icardR OUT);      
      END IF;      
  END IF;
END		SENIOR;23ESP_INTSTR
SP_DATSTR
SP_STRTODATE
SP_CMDTSI
SP_SELTSI
SP_MAPFIS
