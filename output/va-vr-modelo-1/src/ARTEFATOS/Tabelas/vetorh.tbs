      END;
  END IF; 
END␀␀␀š™␀␀␀␀␀␀␀␀␀␀␀␀␀␀%Ï␀␀…¬␀␀´␀	Ôÿ3␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀-Ì␀	Ôÿ3␀␀␀␀␀ë=sõ␀␀ë={␀Æÿ␀␀<#␀İ‰␀␀‰	Ôÿ3␀␀␀␀␀‹␀␀e‰␀␀e‰␀␀n␀Æÿ␀␀ÿ␀éı␀␀­␀	Ôÿ3␀␀␀␀␀Ùş␀␀Aü␀␀Ùş␀␀p␀Æÿ␀␀ÿ␀D-Ì␀	Ôÿ3␀␀␀␀␀•:q:-Al␀Æÿ␀␀1#␀¤-␀ ␀␀␀␀␀␀<<<)␀␀	Æÿ␀␀ˆÒ␀␀␀Ÿj ␀␀␀␀␀␀jšj›jn␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3␀␀Æ␀␀␀␀␀␀␀␀␀␀&Ï␀␀…¬␀␀´␀	Ôÿ3␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀-Ì␀	Ôÿ3␀␀␀␀␀ë=sõ␀␀ë={␀Æÿ␀␀<#␀İ‰␀␀‰	Ôÿ3␀␀␀␀␀‹␀␀e‰␀␀e‰␀␀n␀Æÿ␀␀ÿ␀éı␀␀­␀	Ôÿ3␀␀␀␀␀Ùş␀␀Aü␀␀Ùş␀␀p␀Æÿ␀␀ÿ␀D-Ì␀	Ôÿ3␀␀␀␀␀•:q:-Al␀Æÿ␀␀1#␀¤-␀ ␀␀␀␀␀␀<<<)␀␀	Æÿ␀␀ˆÒ␀␀␀Ÿj ␀␀␀␀␀␀jšj›jn␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3␀␀Æ␀␀␀␀␀␀␀␀␀␀'Ï␀␀­-±␀	Ôÿ3␀␀␀␀␀	>´␀û␀q␀Æÿ␀␀Ï␀␀␀…,´␀	Ôÿ3␀␀␀␀␀_@NgNgr␀Æÿ␀␀#␀$+Ñ␀	Ôÿ3␀␀␀␀␀Ó/Ó/Ó/œ␀␀␀êÿ␀␀ÿ␀'få	Ôÿ3␀␀␀␀␀LfLfLfh␀␀␀ÿ␀␀ÿ␀l÷␀␀tÔÿ3␀␀␀␀␀i¦␀␀L¦␀␀h¦␀␀p␀Æÿ␀␀ÿ␀k÷␀␀¥Ôÿ3␀␀␀␀␀í␀␀á␀␀ë␀␀c␀␀␀ÿ␀␀ÿ␀2-¼␀Ôÿ?ü␀␀␀␀y<=␀>␀]␀Æÿ␀␀ æ␀␀␀DÂ␀␀BÔÿ3␀␀␀␀␀'1GÂ␀␀'1c␀␀␀ÿ␀␀ÿ␀î.BÔÿ3␀␀␀␀␀&1&1&1c␀␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3)Ï␀␀		SENIOR;0R␀␀/* INSERT (NEW) */
TRIGGER R008PUB_EI AFTER INSERT ON R008PUB FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Eventos - Órgão Público (Tabela: R008PUB)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 104;     /* Eventos - Órgão Público (Tabela: R008PUB)*/
  l_codtpa := 353;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008PUB_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAB', CONVERT(NUMBER_TO_CHAR, :NEW.CODTAB));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CODEVE));
        SP_DATSTR(:NEW.CMPALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPALT', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTORG', :NEW.ESTORG);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R008PUB_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SCNACO', CONVERT(NUMBER_TO_CHAR, :NEW.SCNACO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SCIDCO', :NEW.SCIDCO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLC', CONVERT(NUMBER_TO_CHAR, :NEW.CODPLC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PISMAG', :NEW.PISMAG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'COMEMP', :NEW.COMEMP);
      END;
  END IF; 
END␀*Ï␀␀		SENIOR;0␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R008PUB_EU AFTER UPDATE ON R008PUB FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Eventos - Órgão Público (Tabela: R008PUB)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 104;     /* Eventos - Órgão Público (Tabela: R008PUB)*/
  l_codtpa := 354;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.CodTab <> :NEW.CodTab)
   OR (:OLD.CodEve <> :NEW.CodEve)
   OR (:OLD.CmpAlt <> :NEW.CmpAlt)
   OR (:OLD.EstOrg <> :NEW.EstOrg)
   OR (:OLD.SCNaCo <> :NEW.SCNaCo)
   OR (:OLD.SCIdCo <> :NEW.SCIdCo)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008PUB_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAB', CONVERT(NUMBER_TO_CHAR, :OLD.CODTAB));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :OLD.CODEVE));
        SP_DATSTR(:OLD.CMPALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPALT', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTORG', :OLD.ESTORG);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R008PUB_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSCNACO', CONVERT(NUMBER_TO_CHAR, :OLD.SCNACO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSCNACO', CONVERT(NUMBER_TO_CHAR, :NEW.SCNACO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSCIDCO', :OLD.SCIDCO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSCIDCO', :NEW.SCIDCO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPLC', CONVERT(NUMBER_TO_CHAR, :OLD.CODPLC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPLC', CONVERT(NUMBER_TO_CHAR, :NEW.CODPLC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPISMAG', :OLD.PISMAG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPISMAG', :NEW.PISMAG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCOMEMP', :OLD.COMEMP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCOMEMP', :NEW.COMEMP);
      END;
    END IF; 
  END IF; 
END␀(Ï␀␀		SENIOR;0W␀␀ 

