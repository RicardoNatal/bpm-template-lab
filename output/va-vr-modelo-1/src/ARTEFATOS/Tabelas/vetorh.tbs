D␀␀

/*PROCEDURE QUE RETORNA NO PARÂMETRO P_USUTEL O USUÁRIO QUE POSSÚI A ESTRUTURA DE BANCO DE DADOS DA TELEMÁTICA*/
PROCEDURE SP_USUTEL(P_USUTEL OUT VARCHAR(31))
 IS
BEGIN
  BEGIN
    SELECT USUTEL INTO p_usutel FROM R070DAC;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      p_usutel := '';
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao executar procedure SP_USUTEL.';
  END;
  p_usutel := lTrim(p_usutel);
  p_usutel := rTrim(p_usutel);
  IF (p_usutel = '') OR (p_usutel IS NULL) THEN
    p_usutel := '';
  ELSE
    p_usutel := p_usutel || '.';
  END IF;
END		SENIOR;23
D␀␀

