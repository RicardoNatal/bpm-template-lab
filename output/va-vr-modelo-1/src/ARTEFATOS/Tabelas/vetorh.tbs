	ELSIF l_TipoLogradouro =  'ROD' THEN 
	  p_DescTipoLogradouro := 'Rod.';
	ELSIF l_TipoLogradouro =  'FAV' THEN 
	  p_DescTipoLogradouro := 'Fav.';
	ELSIF l_TipoLogradouro =  'A' THEN 
	  p_DescTipoLogradouro := 'Área';
	ELSIF l_TipoLogradouro =  'LG' THEN 
