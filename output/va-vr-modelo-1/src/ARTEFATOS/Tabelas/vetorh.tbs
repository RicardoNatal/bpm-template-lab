TRIGGER R040FEM_EI AFTER INSERT ON R040FEM FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Recibo de Férias - Mestre*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 44;     /* Recibo de Férias - Mestre*/
  l_codtpa := 199;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R040FEM_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.INIPER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIPER', l_datTemp);
        SP_DATSTR(:NEW.INIFER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIFER', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R040FEM_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPFER', :NEW.TIPFER);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OPC13S', :NEW.OPC13S);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PAGMUL', :NEW.PAGMUL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'GERADT', :NEW.GERADT);
        SP_DATSTR(:NEW.DATPAG, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPAG', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAFER', CONVERT(NUMBER_TO_CHAR, :NEW.DIAFER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAABO', CONVERT(NUMBER_TO_CHAR, :NEW.DIAABO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRVDES', CONVERT(NUMBER_TO_CHAR, :NEW.PRVDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REASAL', CONVERT(NUMBER_TO_CHAR, :NEW.REASAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PCTADT', CONVERT(NUMBER_TO_CHAR, :NEW.PCTADT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIALIC', CONVERT(NUMBER_TO_CHAR, :NEW.DIALIC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MINFED', CONVERT(NUMBER_TO_CHAR, :NEW.MINFED));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MINFEN', CONVERT(NUMBER_TO_CHAR, :NEW.MINFEN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MINABO', CONVERT(NUMBER_TO_CHAR, :NEW.MINABO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MINABN', CONVERT(NUMBER_TO_CHAR, :NEW.MINABN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INTFER', CONVERT(NUMBER_TO_CHAR, :NEW.INTFER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INT13S', CONVERT(NUMBER_TO_CHAR, :NEW.INT13S));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDPAR', CONVERT(NUMBER_TO_CHAR, :NEW.QTDPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TODINT', :NEW.TODINT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAABN', CONVERT(NUMBER_TO_CHAR, :NEW.DIAABN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCAU', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCAU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CALHFE', :NEW.CALHFE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CALADF', :NEW.CALADF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CALTFE', :NEW.CALTFE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CALABO', :NEW.CALABO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CALAAB', :NEW.CALAAB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CALTAB', :NEW.CALTAB);
        SP_DATSTR(:NEW.FIMFER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMFER', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SALBAS', CONVERT(NUMBER_TO_CHAR, :NEW.SALBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LICREM', CONVERT(NUMBER_TO_CHAR, :NEW.LICREM));
        SP_DATSTR(:NEW.INILIC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INILIC', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INTABO', CONVERT(NUMBER_TO_CHAR, :NEW.INTABO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDDEP', CONVERT(NUMBER_TO_CHAR, :NEW.QTDDEP));
      END;
  END IF; 
END␀‚Õ␀␀		SENIOR;0Ã-␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R040FEM_EU AFTER UPDATE ON R040FEM FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_temreg       NUMBER;    
  l_oriavi       NUMBER;    
  l_alterou      BOOLEAN;   
BEGIN
  l_alterou :=  FALSE;

  /* Geração de logs Recibo de Férias - Mestre*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 44;     /* Recibo de Férias - Mestre*/
  l_codtpa := 200;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);    

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.IniPer <> :NEW.IniPer)
   OR (:OLD.IniFer <> :NEW.IniFer)
   OR (:OLD.TipFer <> :NEW.TipFer)
   OR (:OLD.Opc13s <> :NEW.Opc13s)
   OR (:OLD.PagMul <> :NEW.PagMul)
   OR (:OLD.GerAdt <> :NEW.GerAdt)
   OR (:OLD.DatPag <> :NEW.DatPag)
   OR (:OLD.DiaFer <> :NEW.DiaFer)
   OR (:OLD.DiaAbo <> :NEW.DiaAbo)
   OR (:OLD.PrvDes <> :NEW.PrvDes)
   OR (:OLD.ReaSal <> :NEW.ReaSal)
   OR (:OLD.PctAdt <> :NEW.PctAdt)
   OR (:OLD.DiaLic <> :NEW.DiaLic)
   OR (:OLD.MinFed <> :NEW.MinFed)
   OR (:OLD.MinFen <> :NEW.MinFen)
   OR (:OLD.MinAbo <> :NEW.MinAbo)
   OR (:OLD.MinAbn <> :NEW.MinAbn)
   OR (:OLD.IntFer <> :NEW.IntFer)
   OR (:OLD.Int13s <> :NEW.Int13s)
   OR (:OLD.QtdPar <> :NEW.QtdPar)
   OR (:OLD.TodInt <> :NEW.TodInt)
   OR (:OLD.DiaAbn <> :NEW.DiaAbn)
   OR (:OLD.TipCau <> :NEW.TipCau)
   OR (:OLD.CalHfe <> :NEW.CalHfe)
   OR (:OLD.CalAdf <> :NEW.CalAdf)
   OR (:OLD.CalTfe <> :NEW.CalTfe)
   OR (:OLD.CalAbo <> :NEW.CalAbo)
   OR (:OLD.CalAAb <> :NEW.CalAAb)
   OR (:OLD.CalTAb <> :NEW.CalTAb)
   OR (:OLD.FimFer <> :NEW.FimFer)
   OR (:OLD.SalBas <> :NEW.SalBas)
   OR (:OLD.LicRem <> :NEW.LicRem)
   OR (:OLD.IniLic <> :NEW.IniLic)
   OR (:OLD.IntAbo <> :NEW.IntAbo)
   OR (:OLD.QtdDep <> :NEW.QtdDep)) THEN
    l_alterou := TRUE;

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R040FEM_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.INIPER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIPER', l_datTemp);
        SP_DATSTR(:OLD.INIFER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIFER', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R040FEM_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPFER', :OLD.TIPFER);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPFER', :NEW.TIPFER);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOPC13S', :OLD.OPC13S);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOPC13S', :NEW.OPC13S);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPAGMUL', :OLD.PAGMUL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPAGMUL', :NEW.PAGMUL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDGERADT', :OLD.GERADT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWGERADT', :NEW.GERADT);
        SP_DATSTR(:OLD.DATPAG, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATPAG', l_datTemp);
        SP_DATSTR(:NEW.DATPAG, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATPAG', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDIAFER', CONVERT(NUMBER_TO_CHAR, :OLD.DIAFER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDIAFER', CONVERT(NUMBER_TO_CHAR, :NEW.DIAFER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDIAABO', CONVERT(NUMBER_TO_CHAR, :OLD.DIAABO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDIAABO', CONVERT(NUMBER_TO_CHAR, :NEW.DIAABO));
