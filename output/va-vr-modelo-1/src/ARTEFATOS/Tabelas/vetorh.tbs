␀␀/*Inicia a migração das pendencias para a nova tabela*/
PROCEDURE SP_RTC_MIG_CONSOL
IS 

    L_TABLENAME   RTC_REPLICATIONDEF.TABLENAME%TYPE;      
    
    /* Buscar todas as tabelas monitoradas pelas integrações que utilizam a RTC_PEND_CONTROLE_CONSOLIDADO */
    CURSOR C_TABELAS_INTEGRACAO IS
   		SELECT DISTINCT tablename 
        FROM rtc_replicationdef tabelas_integracao, rtc_replicatordef int_def 
        WHERE tabelas_integracao.idreplicator = int_def.replicator AND int_def.statustable = 'RTC_PEND_CONTROLE_CONSOLIDADO';
        
BEGIN
	
	DELETE FROM RTC_PEND_CONTROLE WHERE RTC_PEND_CONTROLE.id NOT IN (SELECT rp.id FROM RTC_PENDENCIES rp );

    FOREACH C_TABELAS_INTEGRACAO INTO L_TABLENAME
    LOOP    
    	BEGIN
		    /* Inserir IDs na tabela RTC_PEND_CONTROLE_CONSOLIDADO*/
		    INSERT INTO RTC_PEND_CONTROLE_CONSOLIDADO (ID) 
		    SELECT pc.id FROM RTC_PEND_CONTROLE pc, RTC_PENDENCIES rp WHERE pc.id = rp.id AND rp.TABLENAME = L_TABLENAME	   			
		    	   	GROUP BY pc.id HAVING COUNT(pc.name) = (SELECT COUNT(rd.IDREPLICATOR) FROM RTC_REPLICATIONDEF rd, rtc_replicatordef rctrl WHERE TABLENAME =L_TABLENAME AND rctrl.replicator = rd.idreplicator AND rctrl.statustable='RTC_PEND_CONTROLE_CONSOLIDADO');
		EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'SP_RTC_MIG_COM: Erro ao inserir na RTC_PEND_CONTROLE_CONSOLIDADO.';
        END;
        BEGIN
		   	 /* Excluir IDs da tabela RTC_PEND_CONTROLE	*/
			DELETE FROM RTC_PEND_CONTROLE WHERE ID IN(SELECT pc.id FROM RTC_PEND_CONTROLE pc, RTC_PENDENCIES rp WHERE pc.id = rp.id AND rp.TABLENAME = L_TABLENAME	   			
		    	   	GROUP BY pc.id 
		    	   	HAVING COUNT(pc.name) = (SELECT COUNT(rd.IDREPLICATOR) FROM RTC_REPLICATIONDEF rd, rtc_replicatordef rctrl WHERE TABLENAME =L_TABLENAME AND rctrl.replicator = rd.idreplicator AND rctrl.statustable='RTC_PEND_CONTROLE_CONSOLIDADO'));
		EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'SP_RTC_MIG_COM: Erro ao realizar delete na RTC_PEND_CONTROLE.';
        END;	   				                                                	                                                  
    END LOOP;

END␀Øø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
