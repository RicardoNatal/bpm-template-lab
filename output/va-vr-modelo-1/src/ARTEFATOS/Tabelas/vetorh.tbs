␀␀PROCEDURE R071AEO_ATUCON(P_NUMEMP NUMBER,P_NUMCAD NUMBER)
 IS

l_cracha       NUMBER(12);
  l_crastr       CHAR(12);
  l_codesc         R006ESC.CodEsc%TYPE;
  l_codtma       NUMBER(1);
  /* Controle de Faixas Horarias */
  l_fx_dom_a     CHAR(56);
  l_fx_seg_a     CHAR(56);
  l_fx_ter_a     CHAR(56);
  l_fx_qua_a     CHAR(56);
  l_fx_qui_a     CHAR(56);
  l_fx_sex_a     CHAR(56);
  l_fx_sab_a     CHAR(56);
  l_fx_dom_p     CHAR(56);
  l_fx_seg_p     CHAR(56);
  l_fx_ter_p     CHAR(56);
  l_fx_qua_p     CHAR(56);
  l_fx_qui_p     CHAR(56);
  l_fx_sex_p     CHAR(56);
  l_fx_sab_p     CHAR(56);
  l_fairef       CHAR(56);
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_numemp       CHAR(4);
  l_numcad       CHAR(10);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
BEGIN
  SP_RetCra (1,p_numemp, 5, p_numcad, 0,'',0,'',l_cracha OUT);
  IF   l_cracha = 0 THEN
       SP_RetCra (2,p_numemp, 5, p_numcad, 0,'',0,'',l_cracha OUT);
  END IF;
  /* Verifica se Colaborador possui Cracha */
  IF   l_cracha <> 0 THEN
       l_codesc := 0;
       l_codtma := 0;
       /*Obtem o crachá principal da pessoa*/
       SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
       IF (l_crapri = 0) THEN
           l_crapri := l_cracha;
       END IF;
       BEGIN
         SELECT CODESC,CODTMA INTO l_codesc,l_codtma FROM R070OCR
         WHERE NUMEMP=p_numemp  AND NUMCAD=p_numcad;
       EXCEPTION
         WHEN OTHERS THEN
           RAISERROR 103 'R071AEO_ATUCON: Erro no SELECT em R070OCR.';
       END;

       SP_INTSTR(l_cracha,'999999999999',l_crastr OUT);
       /* Verifica faixa horária */
       SP_FaiOcr (p_numemp, p_numcad, l_codesc, l_codtma,
                      l_fx_dom_a OUT, l_fx_seg_a OUT, l_fx_ter_a OUT, l_fx_qua_a OUT, l_fx_qui_a OUT, l_fx_sex_a OUT, l_fx_sab_a OUT,
                      l_fx_dom_p OUT, l_fx_seg_p OUT, l_fx_ter_p OUT, l_fx_qua_p OUT, l_fx_qui_p OUT, l_fx_sex_p OUT, l_fx_sab_p OUT,
                      l_fairef OUT);
       BEGIN
         UPDATE R070CON
         SET FAIAC1=l_fx_dom_a,FAIAC2=l_fx_seg_a,FAIAC3=l_fx_ter_a,FAIAC4=l_fx_qua_a,
             FAIAC5=l_fx_qui_a,FAIAC6=l_fx_sex_a,FAIAC7=l_fx_sab_a,FAIPT1=l_fx_dom_p,
             FAIPT2=l_fx_seg_p,FAIPT3=l_fx_ter_p,FAIPT4=l_fx_qua_p,FAIPT5=l_fx_qui_p,
             FAIPT6=l_fx_sex_p,FAIPT7=l_fx_sab_p,FAIREF=l_fairef
         WHERE NUMFIS = l_crapri;
       EXCEPTION WHEN OTHERS THEN
         RAISERROR 103 'R071AEO_ATUCON: Erro Na Atualização da R070CON.';
       END;
        /*Atualização da Controle*/
       /*Monta o Identificador da Pessoa*/
       l_tippes := '05';
       SP_INTSTR(p_numemp,'9999',l_numemp OUT);
       SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
       l_idtpes:= l_tippes||l_numemp||l_numcad;
       /*Preenche o campo com espaços para completar 23 posições*/
       l_idtpes := lTrim(l_idtpes);
       l_idtpes := rTrim(l_idtpes);
       LOOP
           /*Controle do Loop.*/
           IF (Length(l_idtpes) > 22) THEN
               EXIT;
           END IF;
           l_idtpes := ' '||l_idtpes;
       END LOOP;
       SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);
  END IF;
END		SENIOR;237SP_RETCRA
