  R034FUN.NUMEMP, 
  R034FUN.TIPCOL, 
  R034FUN.NUMCAD, 
  VFP_DEPENDENTES.QTDCON CONJUGE,
  VFP_DEPENDENTES.QTDFIL FILHOS,
  R022VIN.CONSIJ CONDICAO,
  R024CAR.CODCBO ATIVIDADE,
  R074BAI.CEPBAI ZONA,
  VFP_APORTE_ADIC_SS.VALEVE ADICIONAL_SS,
  R022VIN.MODCTR MOD_CONTRAT,
  R014SIN.CODOBR OBRA_SOCIAL,
  VFP_DEPENDENTES.QTDPAR PARENTES,
  VFP_REM_TOTAL.VALEVE REMTOT,
  VFP_FAMILIA.VALEVE ASIG_FAMIL,
  VFP_IMP_APORTE_VOL.VALEVE IMP_APO_VOL,
  VFP_IMP_ADIC_OS.VALEVE IMP_ADIC_OS,
  VFP_EXCEDENTE_SS.VALEVE IMP_EXCE_SS,
  VFP_EXCEDENTE_OS.VALEVE IMP_EXCE_OS,
  R030EMP.ALIRED REDUCCION,
  R030EMP.TIPSIJ TIPO_EMP,
  VFP_APORTE_ADIC_SS.VALEVE APO_ADIC_OS,
  R032OEM.EMPPUB REGIMEN,
  VFP_SUELDO_ANUAL.VALEVE SAC,
  VFP_HORA_EXTRA.VALEVE HORA_EXTRA,
  VFP_DESFAVORAVEL.VALEVE DESFAVORAVEL,
  VFP_FERIAS.VALEVE VACACIONES
FROM
  (((((((((((R034FUN LEFT OUTER JOIN VFP_FAMILIA ON VFP_FAMILIA.NUMEMP = R034FUN.NUMEMP AND
                                          VFP_FAMILIA.TIPCOL = R034FUN.TIPCOL AND
                                          VFP_FAMILIA.NUMCAD = R034FUN.NUMCAD)
             LEFT OUTER JOIN VFP_IMP_APORTE_VOL ON VFP_IMP_APORTE_VOL.NUMEMP = R034FUN.NUMEMP AND
                                                   VFP_IMP_APORTE_VOL.TIPCOL = R034FUN.TIPCOL AND
                                                   VFP_IMP_APORTE_VOL.NUMCAD = R034FUN.NUMCAD)
             LEFT OUTER JOIN VFP_IMP_ADIC_OS ON VFP_IMP_ADIC_OS.NUMEMP = R034FUN.NUMEMP AND
                                                VFP_IMP_ADIC_OS.TIPCOL = R034FUN.TIPCOL AND
                                                VFP_IMP_ADIC_OS.NUMCAD = R034FUN.NUMCAD)
             LEFT OUTER JOIN VFP_EXCEDENTE_SS ON VFP_EXCEDENTE_SS.NUMEMP = R034FUN.NUMEMP AND
                                                 VFP_EXCEDENTE_SS.TIPCOL = R034FUN.TIPCOL AND
                                                 VFP_EXCEDENTE_SS.NUMCAD = R034FUN.NUMCAD)
             LEFT OUTER JOIN VFP_EXCEDENTE_OS ON VFP_EXCEDENTE_OS.NUMEMP = R034FUN.NUMEMP AND
                                                 VFP_EXCEDENTE_OS.TIPCOL = R034FUN.TIPCOL AND
                                                 VFP_EXCEDENTE_OS.NUMCAD = R034FUN.NUMCAD)
             LEFT OUTER JOIN VFP_APORTE_ADIC_SS ON VFP_APORTE_ADIC_SS.NUMEMP = R034FUN.NUMEMP AND
                                                   VFP_APORTE_ADIC_SS.TIPCOL = R034FUN.TIPCOL AND
                                                   VFP_APORTE_ADIC_SS.NUMCAD = R034FUN.NUMCAD)
             LEFT OUTER JOIN VFP_SUELDO_ANUAL ON VFP_SUELDO_ANUAL.NUMEMP = R034FUN.NUMEMP AND
                                                 VFP_SUELDO_ANUAL.TIPCOL = R034FUN.TIPCOL AND
                                                 VFP_SUELDO_ANUAL.NUMCAD = R034FUN.NUMCAD)
             LEFT OUTER JOIN VFP_HORA_EXTRA ON VFP_HORA_EXTRA.NUMEMP = R034FUN.NUMEMP AND
                                               VFP_HORA_EXTRA.TIPCOL = R034FUN.TIPCOL AND
                                               VFP_HORA_EXTRA.NUMCAD = R034FUN.NUMCAD)
             LEFT OUTER JOIN VFP_FERIAS ON VFP_FERIAS.NUMEMP = R034FUN.NUMEMP AND
                                           VFP_FERIAS.TIPCOL = R034FUN.TIPCOL AND
                                           VFP_FERIAS.NUMCAD = R034FUN.NUMCAD)
             LEFT OUTER JOIN VFP_DESFAVORAVEL ON VFP_DESFAVORAVEL.NUMEMP = R034FUN.NUMEMP AND
                                                 VFP_DESFAVORAVEL.TIPCOL = R034FUN.TIPCOL AND
                                                 VFP_DESFAVORAVEL.NUMCAD = R034FUN.NUMCAD)
             LEFT OUTER JOIN VFP_REM_TOTAL ON VFP_REM_TOTAL.NUMEMP = R034FUN.NUMEMP AND
                                              VFP_REM_TOTAL.TIPCOL = R034FUN.TIPCOL AND
                                              VFP_REM_TOTAL.NUMCAD = R034FUN.NUMCAD),
  VFP_DEPENDENTES,
  R022VIN,
  R038HVI,
  R024CAR,
  R038HCA,
  R030EMP,
  R030FIL,
  R038HFI,
  R014SIN,
  R038HSI,
  R032OEM,
  R038HSS,
  R074BAI,
  R250TAB
WHERE
  R034FUN.NUMEMP = VFP_DEPENDENTES.NUMEMP AND
  R034FUN.TIPCOL = VFP_DEPENDENTES.TIPCOL AND
  R034FUN.NUMCAD = VFP_DEPENDENTES.NUMCAD AND

  R030EMP.NUMEMP = R034FUN.NUMEMP AND

  R034FUN.NUMEMP = R038HVI.NUMEMP AND
  R034FUN.TIPCOL = R038HVI.TIPCOL AND
  R034FUN.NUMCAD = R038HVI.NUMCAD AND
  R022VIN.CODVIN = R038HVI.CODVIN AND
  R038HVI.DATALT = (SELECT MAX(TAB2.DATALT) FROM R038HVI TAB2 WHERE
                           TAB2.NUMEMP = R038HVI.NUMEMP AND
                           TAB2.TIPCOL = R038HVI.TIPCOL AND
                           TAB2.NUMCAD = R038HVI.NUMCAD AND
                           TAB2.DATALT <= R250TAB.FIMPER) AND

  R034FUN.NUMEMP = R038HCA.NUMEMP AND
  R034FUN.TIPCOL = R038HCA.TIPCOL AND
  R034FUN.NUMCAD = R038HCA.NUMCAD AND
  R024CAR.CODCAR = R038HCA.CODCAR AND
  R038HCA.DATALT = (SELECT MAX(TAB2.DATALT) FROM R038HCA TAB2 WHERE
                           TAB2.NUMEMP = R038HCA.NUMEMP AND
                           TAB2.TIPCOL = R038HCA.TIPCOL AND
                           TAB2.NUMCAD = R038HCA.NUMCAD AND
                           TAB2.DATALT <= R250TAB.FIMPER) AND

  R034FUN.NUMEMP = R038HFI.NUMEMP AND
  R034FUN.TIPCOL = R038HFI.TIPCOL AND
  R034FUN.NUMCAD = R038HFI.NUMCAD AND
  R030FIL.NUMEMP = R038HFI.NUMEMP AND
  R030FIL.CODFIL = R038HFI.CODFIL AND
  R038HFI.DATALT = (SELECT MAX (DATALT) FROM R038HFI TAB2 WHERE
                    TAB2.NUMEMP = R038HFI.NUMEMP AND
                    TAB2.TIPCOL = R038HFI.TIPCOL AND
                    TAB2.NUMCAD = R038HFI.NUMCAD AND
                    TAB2.NUMEMP = TAB2.EMPATU AND
                    TAB2.NUMCAD = TAB2.CADATU AND
                    TAB2.DATALT <= R250TAB.FIMPER) AND

  R074BAI.CODCID = R030FIL.CODCID AND
  R074BAI.CODBAI = R030FIL.CODBAI AND

  R034FUN.NUMEMP = R038HSI.NUMEMP AND
  R034FUN.TIPCOL = R038HSI.TIPCOL AND
  R034FUN.NUMCAD = R038HSI.NUMCAD AND
  R014SIN.CODSIN = R038HSI.CODSIN AND
  R038HSI.DATALT = (SELECT MAX(TAB2.DATALT) FROM R038HSI TAB2 WHERE
                           TAB2.NUMEMP = R038HSI.NUMEMP AND
                           TAB2.TIPCOL = R038HSI.TIPCOL AND
                           TAB2.NUMCAD = R038HSI.NUMCAD AND
                           TAB2.DATALT <= R250TAB.FIMPER) AND

  R034FUN.NUMEMP = R038HSS.NUMEMP AND
  R034FUN.TIPCOL = R038HSS.TIPCOL AND
  R034FUN.NUMCAD = R038HSS.NUMCAD AND
  R032OEM.CODOEM = R038HSS.CODOEM AND
  R038HSS.DATINI = (SELECT MAX(TAB2.DATINI) FROM R038HSS TAB2 WHERE
                           TAB2.NUMEMP = R038HSS.NUMEMP AND
                           TAB2.TIPCOL = R038HSS.TIPCOL AND
                           TAB2.NUMCAD = R038HSS.NUMCAD AND
                           TAB2.CODOEM = R038HSS.CODOEM AND
                           TAB2.DATINI <= R250TAB.FIMPER) AND
  (R038HSS.DATFIM = DAY(1900,12,31) OR R038HSS.DATFIM >= R250TAB.FIMPER)ÊVFP_DEPENDENTES
VFP_APORTE_ADIC_SS
VFP_REM_TOTAL
VFP_FAMILIA
VFP_IMP_APORTE_VOL
VFP_IMP_ADIC_OS
VFP_EXCEDENTE_SS
VFP_EXCEDENTE_OS
VFP_SUELDO_ANUAL
VFP_HORA_EXTRA
VFP_DESFAVORAVEL
VFP_FERIAS
␀ÿ‰␀ù¥␀␀Ì␀␀␀␀␀␀␀␀␀İ«␀␀Û«␀␀Û«␀␀m$ˆ␀Æÿ␀␀ÿ␀BCÑ␀	␀␀␀␀␀␀␀␀HIşEşEqC#ˆ␀êÿ␀␀ÿ␀(␀´␀␀␀␀␀␀␀␀␀>½␀␀r␀Æÿ␀␀ÿ␀ó¥␀␀´␀	␀␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀W␀Š␀	␀␀␀␀␀␀␀␀Ü␀Ü␀Ü␀n␀Æÿ␀␀ÿ␀ê¥␀␀Ì␀	␀␀␀␀␀␀␀␀‚%€$0.w␀Æÿ␀␀ÿ␀ğ›␀␀Ñ␀	␀␀␀␀␀␀␀␀0Í/Ó/œ␀␀␀êÿ␀␀ÿ␀|²␀␀Š␀␀␀␀␀␀␀␀␀ÿÿÿÿ␀␀Æÿ␀␀ÿ␀␀µ␀␀ SELECT HLO.NUMLOC, HLO.DATALT, HLO.TABORG, PRV.NUMEMP, PRV.TIPCOL, PRV.NUMCAD, PRV.MESANO, 1 ORIGEM
FROM R046PRV PRV, R250TAB TAB, R038HLO HLO
WHERE PRV.MESANO = TAB.INIPER AND HLO.NUMEMP = PRV.NUMEMP AND HLO.TIPCOL = PRV.TIPCOL AND
HLO.NUMCAD = PRV.NUMCAD AND 
HLO.DATALT = (SELECT MAX(HLO2.DATALT) FROM R038HLO HLO2 
              WHERE HLO2.NUMEMP = PRV.NUMEMP AND HLO2.TIPCOL = PRV.TIPCOL AND 
              HLO2.NUMCAD = PRV.NUMCAD AND HLO2.DATALT <= TAB.FIMPER)

UNION

SELECT HLO.NUMLOC, HLO.DATALT, HLO.TABORG, PRV.NUMEMP, PRV.TIPCOL, PRV.NUMCAD, PRV.MESANO, 2 ORIGEM
FROM R046PRV PRV, R250TAB TAB, R038HLO HLO
WHERE 
PRV.MESANO = TAB.INIPER AND HLO.NUMEMP = PRV.NUMEMP AND HLO.TIPCOL = PRV.TIPCOL AND
HLO.NUMCAD = PRV.NUMCAD AND 
HLO.DATALT = (SELECT MAX(HLO2.DATALT) FROM R038HLO HLO2 
              WHERE HLO2.NUMEMP = PRV.NUMEMP AND HLO2.TIPCOL = PRV.TIPCOL AND 
              HLO2.NUMCAD = PRV.NUMCAD AND HLO2.DATALT <= AddDay(TAB.INIPER, -1)) AND
EXISTS (SELECT 1 FROM R046SLD SLD 
       WHERE SLD.NUMEMP = PRV.NUMEMP AND SLD.TIPCOL = PRV.TIPCOL AND 
       SLD.NUMCAD = PRV.NUMCAD AND SLD.MESANO = PRV.MESANO AND (SLD.NUMLOC <> HLO.NUMLOC OR 
       SLD.TABORG <> HLO.TABORG) AND EXISTS (SELECT 1 FROM R046SLD SLD 
         WHERE SLD.NUMEMP = PRV.NUMEMP AND SLD.TIPCOL = PRV.TIPCOL AND 
         SLD.NUMCAD = PRV.NUMCAD AND SLD.MESANO = PRV.MESANO AND (SLD.NUMLOC = HLO.NUMLOC OR 
         SLD.TABORG = HLO.TABORG)) AND
NOT EXISTS (SELECT 1 FROM R038HFI HFI WHERE HFI.EMPATU = PRV.NUMEMP AND HFI.TIPCOL = PRV.TIPCOL AND HFI.CADATU = PRV.NUMCAD AND
            (HFI.NUMCAD <> HFI.CADATU OR HFI.NUMEMP <> HFI.EMPATU) AND HFI.DATALT >= TAB.INIPER AND HFI.DATALT <= TAB.FIMPER))␀␀ÿŒ␀s␀Š␀␀␀␀␀␀␀␀␀§␀␀y␀y␀ÿ␀␀Æÿ␀␀ÿ␀/#A␀␀␀␀␀␀␀␀ã•␀␀ã•␀␀ã•␀␀C␀␀ÿ␀␀ÿ␀ó¥␀␀´␀	␀␀␀␀␀␀␀␀‘<Xb‘<r␀Æÿ␀␀ÿ␀W␀Š␀	␀␀␀␀␀␀␀␀›␀Ü␀Ü␀n␀Æÿ␀␀ÿ␀ê¥␀␀Ì␀	␀␀␀␀␀␀␀␀õ?€$P%w␀Æÿ␀␀ÿ␀$␀Š␀␀␀␀␀␀␀␀␀ÿÿÿÿ␀␀Æÿ␀␀ÿ␀K#·␀	␀␀␀␀␀␀␀␀I=½™␀␀I=s␀Æÿ␀␀ÿ␀eCÑ␀	␀␀␀␀␀␀␀␀“MÙE“MqC␀êÿ␀␀ÿ␀#É␀␀¯␀␀␀␀␀␀␀␀␀Ë␀␀>Ë␀␀Ë␀␀)␀␀Æÿ␀␀ÿ␀£␀¯␀␀␀␀␀␀␀␀␀Q$␀¦␀Q$␀_)␀␀Æÿ␀␀ÿ␀¤␀È␀␀␀␀␀␀␀␀␀Q$␀¦␀Q$␀_)␀␀Æÿ␀␀ÿ␀ø¥␀␀␀␀␀␀␀␀␀␀j±␀␀œ¬␀␀j±␀␀#␀␀ÿ␀␀ÿ␀ë¥␀␀8␀␀␀␀␀␀␀␀³±␀␀²±␀␀²±␀␀?␀␀ÿ␀␀ÿ␀␀Ù␀␀ SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PVT.NUMEMP, PVT.TIPCOL, PVT.NUMCAD, 0 TABEVE, PVT.CODLIN CODVAL, 
            PVT.DATVTR DATVAL, PVT.QTDPAS QTDVAL, PVT.VALPAS VLRVAL, PVT.VALPAS VLRVL2, LVT.NUMITN NUMITN, EVN.NUMCAR NUMCAR
FROM
  R028PVT PVT, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVN EVN, R038EVT EVT
WHERE
  PVT.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PVT.CODLIN = LVT.CODLIN
  AND PVT.STAPVT = 'E'
  AND PVT.DATVTR >= PER.INIVTR
  AND PVT.DATVTR <= PER.FIMVTR
  AND PER.NUMEMP = PVT.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
  AND PVT.NUMEMP = EVT.NUMEMP
  AND PVT.TIPCOL = EVT.TIPCOL
  AND PVT.NUMCAD = EVT.NUMCAD
  AND PVT.DATVTR >= EVT.INIEVT
  AND ((PVT.DATVTR <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND EVN.NUMEMP = EVT.NUMEMP
  AND EVN.TIPCOL = EVT.TIPCOL
  AND EVN.NUMCAD = EVT.NUMCAD
  AND EVN.INIEVT = EVT.INIEVT
  AND EVN.CODLIN = PVT.CODLIN	

UNION

SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PVT.NUMEMP, PVT.TIPCOL, PVT.NUMCAD, 0 TABEVE, PVT.CODLIN CODVAL, 
            PVT.DATVTR DATVAL, PVT.QTDPAS QTDVAL, PVT.VALPAS VLRVAL, PVT.VALPAS VLRVL2, LVT.NUMITN NUMITN, '' NUMCAR
FROM
  R028PVT PVT, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVT EVT
WHERE
  PVT.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PVT.CODLIN = LVT.CODLIN
  AND PVT.STAPVT = 'E'
  AND PVT.DATVTR >= PER.INIVTR
  AND PVT.DATVTR <= PER.FIMVTR
  AND PER.NUMEMP = PVT.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
  AND PVT.NUMEMP = EVT.NUMEMP
  AND PVT.TIPCOL = EVT.TIPCOL
  AND PVT.NUMCAD = EVT.NUMCAD
  AND PVT.DATVTR >= EVT.INIEVT
  AND ((PVT.DATVTR <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND NOT EXISTS (SELECT 1 FROM R038EVN EVN 	
                   WHERE EVN.NUMEMP = EVT.NUMEMP
                     AND EVN.TIPCOL = EVT.TIPCOL
                     AND EVN.NUMCAD = EVT.NUMCAD
                     AND EVN.INIEVT = EVT.INIEVT
                     AND EVN.CODLIN = PVT.CODLIN)		
										 
UNION

SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, 0 TABEVE, PDI.CODLIN CODVAL, 
            PER.INIVTR DATVAL, SUM(PDI.QTDPAS * -1) QTDVAL, PDI.VALPAS * -1 VLRVAL, PDI.VALPAS VLRVL2, LVT.NUMITN NUMITN, EVN.NUMCAR NUMCAR
FROM 
  R028PDI PDI, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVN EVN, R038EVT EVT
WHERE 
  PDI.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PER.INIFVT <> DAY(1900,12,31)
  AND PER.FIMFVT <> DAY(1900,12,31)
  AND PDI.CODLIN = LVT.CODLIN
  AND PDI.DATFAL >= PER.INIFVT
  AND PDI.DATFAL <= PER.FIMFVT
  AND PER.NUMEMP = PDI.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
  AND PDI.NUMEMP = EVT.NUMEMP
  AND PDI.TIPCOL = EVT.TIPCOL 
  AND PDI.NUMCAD = EVT.NUMCAD	
  AND PDI.DATFAL >= EVT.INIEVT
  AND ((PDI.DATFAL <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND EVN.NUMEMP = EVT.NUMEMP
  AND EVN.TIPCOL = EVT.TIPCOL
  AND EVN.NUMCAD = EVT.NUMCAD
  AND EVN.INIEVT = EVT.INIEVT
  AND EVN.CODLIN = PDI.CODLIN			
  GROUP BY LVT.CODITN, LVT.NUMITN, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, PDI.CODLIN, PER.INIVTR, PDI.VALPAS, EVN.NUMCAR
	
UNION

SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, 0 TABEVE, PDI.CODLIN CODVAL, 
            PER.INIVTR DATVAL, SUM(PDI.QTDPAS * -1) QTDVAL, PDI.VALPAS * -1 VLRVAL, PDI.VALPAS VLRVL2, LVT.NUMITN NUMITN, '' NUMCAR
FROM 
  R028PDI PDI, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVT EVT
WHERE 
  PDI.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PER.INIFVT <> DAY(1900,12,31)
  AND PER.FIMFVT <> DAY(1900,12,31)
  AND PDI.CODLIN = LVT.CODLIN
  AND PDI.DATFAL >= PER.INIFVT
  AND PDI.DATFAL <= PER.FIMFVT
  AND PER.NUMEMP = PDI.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
  AND PDI.NUMEMP = EVT.NUMEMP
  AND PDI.TIPCOL = EVT.TIPCOL 
  AND PDI.NUMCAD = EVT.NUMCAD	
  AND PDI.DATFAL >= EVT.INIEVT
  AND ((PDI.DATFAL <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND NOT EXISTS (SELECT 1 FROM R038EVN EVN 	
	           WHERE EVN.NUMEMP = EVT.NUMEMP
                     AND EVN.TIPCOL = EVT.TIPCOL
                     AND EVN.NUMCAD = EVT.NUMCAD
                     AND EVN.INIEVT = EVT.INIEVT
                     AND EVN.CODLIN = PDI.CODLIN)		
  GROUP BY LVT.CODITN, LVT.NUMITN, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, PDI.CODLIN, PER.INIVTR, PDI.VALPASVBS_PERVTR
