t␀␀PROCEDURE RH_RETATNFICMED(P_NUMEMP NUMBER(4),P_CODFIC NUMBER(9),P_DATREF DATE,P_TIPATN OUT NUMBER(1),P_TIPCOL OUT NUMBER(1),P_NUMCAD OUT NUMBER(9),P_CODDEP OUT NUMBER(2),P_NUMCAN OUT NUMBER(7))
 IS

	l_TipAtn NUMBER(1);
	l_TipCol NUMBER(1);
	l_NumCad NUMBER(9);
	l_CodDep NUMBER(2);
	l_NumCan NUMBER(7);
BEGIN
	l_TipAtn := 0;
	l_TipCol := 0;
	l_NumCad := 0;
	l_CodDep := 0;
	l_NumCan := 0;
	
	BEGIN
    	SELECT TIPATN, TIPCOL, NUMCAD, CODDEP, NUMCAN
          INTO l_TipAtn, l_TipCol, l_NumCad, l_CodDep, l_NumCan
          FROM R110HFM
         WHERE NUMEMP = P_NUMEMP
           AND CODFIC = P_CODFIC 
		   AND DATTER = (SELECT MIN(HFM2.DATTER) FROM R110HFM HFM2
		   	              WHERE HFM2.NUMEMP = R110HFM.NUMEMP
		   	                AND HFM2.CODFIC = R110HFM.CODFIC
		   	                AND HFM2.DATTER >= P_DATREF);
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_TipAtn := 0;
			l_TipCol := 0;
			l_NumCad := 0;
			l_CodDep := 0;
			l_NumCan := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao ler R110HFM';
	END;
	
	P_TIPATN := l_TipAtn;
	P_TIPCOL := l_TipCol;
	P_NUMCAD := l_NumCad;
	P_CODDEP := l_CodDep;
	P_NUMCAN := l_NumCan;	
END␀ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
È␀␀PROCEDURE RH_RETCDRFGTFIL(P_NUMEMP NUMBER(4), P_CODFIL NUMBER(6), P_DATREF DATE, P_CDRFGT OUT NUMBER(3)) IS
BEGIN
	BEGIN	               
    	SELECT CDRFGT INTO P_CDRFGT
      	  FROM R030FFG
     	 WHERE NUMEMP = P_NUMEMP 
     	   AND CODFIL = P_CODFIL
       	   AND CMPFGT = (SELECT MAX(CMPFGT) 
       	   	               FROM R030FFG FFG2
                      	  WHERE FFG2.NUMEMP = R030FFG.NUMEMP
                        	AND FFG2.CODFIL = R030FFG.CODFIL
                        	AND FFG2.CMPFGT <= P_DATREF);
	EXCEPTION
    	WHEN NO_DATA_FOUND THEN
        	P_CDRFGT := 0;
        WHEN OTHERS THEN
        	RAISERROR 103 'Erro ao buscar informação do campo Código do Recolhimento de FGTS.';
  	END; 
END␀ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
…␀␀PROCEDURE RH_RETCODCATCOL(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATALT DATE,P_CODCAT OUT NUMBER(4))
 IS
BEGIN
     BEGIN
         SELECT (CODCAT) INTO p_codcat
         FROM R038CAT
         WHERE NUMEMP = p_numemp AND
               TIPCOL = p_tipcol AND
               NUMCAD = p_numcad AND
			   DATALT = (SELECT MAX(A.DATALT) 
			   			 FROM R038CAT A 
			   			 WHERE A.NUMEMP = p_numemp AND
			   			 	   A.TIPCOL = p_tipcol AND
			   			 	   A.NUMCAD = p_numcad AND 
			   			 	   A.DATALT < p_datalt);
     EXCEPTION
          WHEN NO_DATA_FOUND THEN
               p_codcat := 9999;
     END;
END␀ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE RH_RETDATATE(P_NUMEMP NUMBER(4),P_CODATE NUMBER(9),P_NUMATE NUMBER(9),P_DATATE OUT DATE)
 IS

	l_DatAte DATE;
BEGIN
	l_DatAte := DATETIME(31, 12, 1900, 0, 0, 0);
	
	BEGIN
    	SELECT DATATE
          INTO l_DatAte
          FROM R110MAM
         WHERE NUMEMP = P_NUMEMP
           AND CODATE = P_CODATE
		   AND NUMATE = P_NUMATE;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_DatAte := DATETIME(31, 12, 1900, 0, 0, 0);
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao ler R110MAM';
	END;
	
	P_DATATE := l_DatAte;	
END␀‘ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Ü␀␀PROCEDURE RH_RETENVESO(P_NUMEMP NUMBER(4),P_CODATE NUMBER(9),P_NUMATE NUMBER(9),P_ENVESO OUT CHAR(1))
 IS

	l_EnvEso VARCHAR2(1);
BEGIN		
	BEGIN
    	SELECT ENVESO
          INTO l_EnvEso
          FROM R110MAM
         WHERE NUMEMP = P_NUMEMP
           AND CODATE = P_CODATE
		   AND NUMATE = P_NUMATE;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_EnvEso := 'N';
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao ler R110MAM';
	END;
	
	P_ENVESO := l_EnvEso;	
END␀’ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
:␀␀PROCEDURE RH_RETESC(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATESC DATE,P_CODESC OUT NUMBER(9),P_TURESC OUT NUMBER(1),P_TURINT OUT NUMBER(9),P_CODERR OUT NUMBER(2),P_CODEQP OUT NUMBER(4),P_CODCAT OUT NUMBER(3))
 IS

/* Auxiliares */
     l_data_zero DATE;
     l_codesc   R006ESC.CodEsc%TYPE;
     l_codtma NUMBER;
     l_turint   R006TIN.TurInt%TYPE;
     l_coderr INTEGER;
     l_datadm DATE;
     l_codeqp INTEGER;
     l_codcat INTEGER;

BEGIN
/* Inicializa Variáveis. */
l_data_zero  := '31/12/1900,00:00:00';
l_datadm := l_data_zero;
l_codesc := 0;
l_codtma := 0;
l_turint := 0;
l_coderr := 0;
l_codeqp := 0;
l_codcat := 0;
p_codesc := 0;
p_turesc := 0;
p_turint := 0;
p_coderr := 0;
p_codeqp := 0;
p_codcat := 0;

/* Verifica Se Existe Alguma Programação de Troca de Escala no Dia. */
BEGIN
     SELECT CODESC,CODTMA,IFNULL(TURINT,0),IFNULL(CODEQP,0),IFNULL(CODCAT,0)
       INTO l_codesc,l_codtma,l_turint,l_codeqp,l_codcat
       FROM R064TES
      WHERE NUMEMP=p_numemp AND TIPCOL=p_tipcol AND
            NUMCAD=p_numcad AND ((DATINI <= p_datesc AND DATFIM >= p_datesc) OR
            (DATINI <= p_datesc AND DATFIM=l_data_zero));
EXCEPTION
     WHEN NO_DATA_FOUND THEN
          l_codesc := 0;
          l_codtma := 0;
          l_turint := 0;
          l_codeqp := 0;
          l_codcat := 0;
     WHEN OTHERS THEN
          l_coderr := 10;
END;

/* Verifica Histórico de Escala até data passada como parâmetro. */
IF   (l_coderr = 0) AND (l_codesc = 0) THEN
     BEGIN
          SELECT CODESC,CODTMA,IFNULL(TURINT,0),IFNULL(CODEQP,0),IFNULL(CODCAT,0)
            INTO l_codesc,l_codtma,l_turint,l_codeqp,l_codcat FROM R038HES WHERE DATALT =
            (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND DATALT <= p_datesc
            ) AND NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad;
     EXCEPTION
          WHEN NO_DATA_FOUND THEN
               l_coderr := 4;
          WHEN OTHERS THEN
               l_coderr := 10;
     END;

     IF   (l_coderr = 4) THEN
          /* Verifica Informações do Cadastro do Colaborador. */
          BEGIN
               SELECT IFNULL (DATADM,l_data_zero),CODESC,CODTMA,IFNULL(TURINT,0) INTO l_datadm,l_codesc,l_codtma,l_turint
                    FROM R034FUN WHERE NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_coderr := 1;
               WHEN OTHERS THEN
                    l_coderr := 10;
          END;

          IF   (l_coderr = 4) THEN
               /* Verifica Se a data pedida é anterior a data de admissão. */
               IF   (p_datesc < l_datadm) THEN
                    l_coderr := 2;
               END IF;
          END IF;
     END IF;
END IF;

p_coderr := l_coderr;

/* Seta Parâmetros com valores encontrados Quando não houve erro. */
IF   (l_coderr = 0) THEN
     p_codesc := l_codesc;
     p_turesc := l_codtma;
     IF  (l_turint IS NULL) THEN
          p_turint := 0;
     ELSE p_turint := l_turint;
     END IF;
     IF  (l_codeqp IS NULL) THEN
          p_codeqp := 0;
     ELSE p_codeqp := l_codeqp;
     END IF;
     IF  (l_codcat IS NULL) THEN
          p_codcat := 0;
     ELSE p_codcat := l_codcat;
     END IF;
END IF;
END␀“ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ª␀␀PROCEDURE RH_RETFICMED(P_NUMEMP NUMBER(4),P_CODFIC NUMBER(9), P_TIPATN OUT NUMBER(1),P_TIPCOL OUT NUMBER(1),P_NUMCAD OUT NUMBER(9),P_CODDEP OUT NUMBER(2),P_NUMCAN OUT NUMBER(7))
 IS

	l_TipAtn NUMBER(1);
	l_TipCol NUMBER(1);
	l_NumCad NUMBER(9);
	l_CodDep NUMBER(2);
	l_NumCan NUMBER(7);
BEGIN
	l_TipAtn := 0;
	l_TipCol := 0;
	l_NumCad := 0;
	l_CodDep := 0;
	l_NumCan := 0;
	
	BEGIN
    	SELECT TIPATN, TIPCOL, NUMCAD, CODDEP, NUMCAN
          INTO l_TipAtn, l_TipCol, l_NumCad, l_CodDep, l_NumCan
          FROM R110FIC
         WHERE NUMEMP = P_NUMEMP
           AND CODFIC = P_CODFIC;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_TipAtn := 0;
			l_TipCol := 0;
			l_NumCad := 0;
			l_CodDep := 0;
			l_NumCan := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao ler R110FIC';
	END;
	
	P_TIPATN := l_TipAtn;
	P_TIPCOL := l_TipCol;
	P_NUMCAD := l_NumCad;
	P_CODDEP := l_CodDep;
	P_NUMCAN := l_NumCan;	
END␀”ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀/* 
 * Retorna informações do histórico de filial do colaborador conforme parâmetros:
 * p_NumEmp - Empresa do colaborador
 * p_TipCol - Tipo do colaborador
 * p_NumCad - Cadastro do colaborador
 * p_DatRef - Data de referência
 * p_CodFil - Retorna código da filial do colaborador
 */
PROCEDURE RH_RETFILCOL(p_NumEmp NUMBER(4), p_TipCol NUMBER(1), p_NumCad NUMBER(9), p_DatRef DATE, p_CodFil OUT NUMBER(6)) IS
BEGIN
	BEGIN
    	SELECT HFI.CodFil INTO p_CodFil
      	  FROM R038HFI HFI
	 	 WHERE HFI.NumEmp = p_NumEmp
	 	   AND HFI.TipCol = p_TipCol
	   	   AND HFI.NumCad = p_NumCad
	   	   AND HFI.DatAlt = (SELECT MAX(HFI2.DATALT) 
	   		   				   FROM R038HFI HFI2
	   		   				  WHERE HFI2.NumEmp = HFI.NumEmp
	   		   				    AND HFI2.TipCol = HFI.TipCol
	   		   				    AND HFI2.NumCad = HFI.NumCad
	   		   				    AND HFI2.DatAlt <= p_DatRef);
  	EXCEPTION
    	WHEN NO_DATA_FOUND THEN
  	  		p_CodFil := 0;
    	WHEN OTHERS THEN
      		RAISERROR 103 'Erro ao buscar histórico de filial do colaborador.';
	END;
END␀•ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0,RH_RETESC
RH_HORSRV
RH_DATFER
RH_HORESC
x2␀␀PROCEDURE RH_RETHOR(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATHOR DATE,P_VERPON INTEGER,P_CODHOR OUT NUMBER(4),P_HORBU1 OUT NUMBER(4),P_HORBU2 OUT NUMBER(4),P_HORBU3 OUT NUMBER(4),P_HORBU4 OUT NUMBER(4),P_HORBU5 OUT NUMBER(4),P_CODESC OUT NUMBER(9),P_CODTMA OUT NUMBER(1),P_TURINT OUT NUMBER(9),P_CODINT OUT NUMBER(9),P_DIAFER OUT NUMBER(1),P_TIPCNV OUT NUMBER(1),P_CODERR OUT NUMBER(2),P_SEQHBA OUT NUMBER(3))
 IS

/* Auxiliares */
   l_data_zero DATE;
   l_datmin DATE;
   l_datbus   DATE;
   l_datbusaux  DATE;
   l_feriado  BOOLEAN;
   l_coderr   NUMBER(2);
   l_diafer   NUMBER(1);
   l_tempon   NUMBER;
   l_fersrv   NUMBER(1);

   /* Tabela R006ESC */
   l_tipfer        r006esc.tipfer%TYPE;
   l_tabfer        r006esc.tabfer%TYPE;
   l_tipesc        r006esc.tipesc%TYPE;
   l_turesc        r006esc.turesc%TYPE;
   l_tipferaux     r006esc.tipfer%TYPE;
   l_tabferaux     r006esc.tabfer%TYPE;
   l_tipescaux     r006esc.tipesc%TYPE;
   l_turescaux     r006esc.turesc%TYPE;
   /* Tabela R034FUN*/
   l_codfil        r034fun.codfil%TYPE;
   l_bushor        r034fun.bushor%TYPE;
   /* Tabela R038HES */
   l_codesc        r038hes.codesc%TYPE;
   l_codtma        r038hes.codtma%TYPE;
   l_turint        r038hes.turint%TYPE;
   l_codeqp        r038hes.codeqp%TYPE;
   l_codcat        r038hes.codcat%TYPE;
   l_codescaux     r038hes.codesc%TYPE;
   l_codtmaaux     r038hes.codtma%TYPE;
   l_turintaux     r038hes.turint%TYPE;
   l_codeqpaux     r038hes.codeqp%TYPE;
   l_codcataux     r038hes.codcat%TYPE;

   /* Tabela R060DAP */
   l_prgfer     r060dap.prgfer%TYPE;
   l_ponsob     r060dap.ponsob%TYPE;
   /* Tabela R064PON */
   l_diaho1     r064pon.diaho1%TYPE;
   l_diaho2     r064pon.diaho2%TYPE;
   /* Tabela R064THR */
   l_codint     r064thr.codint%TYPE;
   /* Tabela R064CNV */
   l_tipcnv     r064cnv.tipcnv%TYPE;
   l_horcnv     r064cnv.horcnv%TYPE;
   /* Tabela R006HOR */
   l_horesc     r006hor.codhor%TYPE;
   l_codhor     r006hor.codhor%TYPE;
   l_horbu1     r006hba.codhop%TYPE;
   l_horbu2     r006hba.codhop%TYPE;
   l_horbu3     r006hba.codhop%TYPE;
   l_horbu4     r006hba.codhop%TYPE;
   l_horbu5     r006hba.codhop%TYPE;
   l_seqhba     r006hba.seqreg%TYPE;

   /* Tabela R034ESR. */
   l_diafol     r034esr.diafol%TYPE;
   l_codsrv     r034esr.codsrv%TYPE;
   l_codtse     r034esr.codtse%TYPE;
   l_tipfol     r034esr.tipfol%TYPE;

   /* Tabela R064SSR. */
   l_codoce   r064ssr.codoce%TYPE;
BEGIN
/* Variáveis auxiliares. */
l_data_zero  := DATETIME(31,12,1900,0,0,0);
l_diaho1 := l_data_zero;
l_diaho2 := l_data_zero;
l_datbus := l_data_zero;
l_datbusaux := l_data_zero;
l_tipferaux :=  '';
l_tabfer := 0;
l_codhor := 0;
l_tipesc := '';
l_horbu1 := 0;
l_horbu2 := 0;
l_horbu3 := 0;
l_horbu4 := 0;
l_horbu5 := 0;
l_seqhba := 0;
l_codesc := 0;
l_codtma := 0;
l_turint := 0;
l_turesc := 0;
l_codeqp := 0;
l_codcat := 0;
l_codint := 0;
l_coderr := 0;
l_diafer := 0;
l_tempon := 0;
l_tipcnv := 0;

l_tipferaux := '';
l_tabferaux := 0;
l_tipescaux := '';
l_turescaux := 0;
l_codescaux := 0;
l_codtmaaux := 0;
l_turintaux := 0;
l_codeqpaux := 0;
l_codcataux := 0;

/* Carga das Definições de Apuração. */
BEGIN
     SELECT PRGFER,PONSOB INTO l_prgfer,l_ponsob FROM R060DAP,R030EMP WHERE R030EMP.NUMEMP = p_numemp AND R060DAP.CODDAP = R030EMP.CODDAP;
EXCEPTION
WHEN NO_DATA_FOUND THEN
     l_prgfer := 'S';
     l_ponsob := 'S';
WHEN OTHERS THEN
     l_coderr := 10;
END;

/* Carga de Informações do Cadastro do Colaborador. */
BEGIN
     SELECT CODFIL,IFNULL (BUSHOR,1) INTO l_codfil,l_bushor FROM R034FUN WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
EXCEPTION
WHEN OTHERS THEN
     l_codfil := 0;
     l_bushor := 0;
END;

/* Verifica qual a escala na data. */
RH_RETESC(p_numemp,p_tipcol,p_numcad, p_dathor, l_codesc OUT,l_codtma OUT,l_turint OUT,l_coderr OUT,l_codeqp OUT,l_codcat OUT);
IF   (l_turint IS NULL) THEN
     l_turint := 0;
END IF;

/* Utiliza rotina de transporte. */
IF   (l_bushor = 2) THEN
     RH_HORSRV(p_numemp,p_tipcol,p_numcad,p_dathor,l_diafol OUT,l_codsrv OUT, l_codtse OUT, l_codoce OUT, l_tipfol OUT, l_codhor OUT,l_fersrv OUT);
     IF (l_fersrv = 1) AND (l_codsrv = 0) AND (l_codhor <> 0 ) THEN 
     	l_codhor := 9997;
     END IF;

     IF   (l_codhor = 0) THEN
          /* Pega a definição de escala de serviço para aquela data. */
          BEGIN
          SELECT IFNULL(MIN(DATALT), DATETIME(04,06,2080,0,0,0)) INTO l_datmin
           FROM R034ESR
          WHERE NUMEMP=p_numemp AND
                TIPCOL=p_tipcol AND
                NUMCAD=p_numcad;
          EXCEPTION
          WHEN OTHERS THEN
               l_datmin := DATETIME(04,06,2080,0,0,0);
          END;
          
          IF   (p_dathor<l_datmin) THEN
              l_bushor := 1;
          END IF;
     END IF;
END IF;

/* Quando encontrou horário em transporte colevito não realiza o resto. */
IF   (l_bushor <> 2) THEN
     /* Busca Informações da Escala. */
     BEGIN
          SELECT TIPFER,TABFER,TIPESC,TURESC INTO l_tipfer,l_tabfer,l_tipesc,l_turesc FROM R006ESC WHERE CODESC=l_codesc;
     EXCEPTION
     WHEN NO_DATA_FOUND THEN
          l_coderr := 5;
     WHEN OTHERS THEN
          l_coderr := 10;
     END;

     /* Verifica Se a data é Feriado */
     Rh_DatFer(p_numemp,p_tipcol,p_numcad,l_codfil,l_tipfer,l_tabfer,l_turesc,p_dathor,l_tipesc,l_feriado OUT);
     IF    (l_feriado = TRUE) THEN
           l_diafer := 1;
     ELSE
           l_diafer := 0;
     END IF;

     /* Verifica se Existe Convocação. */
     BEGIN
     SELECT TIPCNV,HORCNV INTO l_tipcnv,l_horcnv
      FROM R064CNV
     WHERE NUMEMP=p_numemp AND
           TIPCOL=p_tipcol AND
           NUMCAD=p_numcad AND
           DATCNV=p_dathor;
     EXCEPTION
     WHEN NO_DATA_FOUND THEN
          l_tipcnv := 0;
          l_horcnv := 0;
     WHEN OTHERS THEN
          l_coderr := 10;
     END;

     /* Deve verificar Pontes? ISto é utilizado no cálculo de apuração. */
     IF   (p_verpon = 1) AND (l_coderr = 0) THEN
          /* Verifica se Existe Ponte. */
          BEGIN
          SELECT DIAHO1,DIAHO2 INTO l_diaho1,l_diaho2
            FROM R064PON
           WHERE NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND
                 (DIAHO1=p_dathor OR DIAHO2=p_dathor);
          EXCEPTION
          WHEN NO_DATA_FOUND THEN
               l_datbus := p_dathor;
               l_diaho1 := l_data_zero;
               l_diaho2 := l_data_zero;
          WHEN OTHERS THEN
               l_coderr := 10;
          END;

          IF  (l_diaho1 <> l_data_zero) THEN
              l_tempon := 1;
          END IF;

          IF   (l_coderr = 0) AND (l_datbus = l_data_zero) THEN
               /* Se Programação Não Sobrepõe o Feriado Devo Primeiro   */
               /* Verificar se uma das datas da Ponte Está num Feriado. */
               IF   (l_diaho1 = p_dathor) THEN
                    l_datbus := l_diaho2;
               ELSE
                    l_datbus := l_diaho1;
               END IF;

               l_feriado := FALSE;

               /* Função que retorna a escala,turma,turma intervalo da data. */
               RH_RETESC(p_numemp,p_tipcol,p_numcad, l_datbus,l_codescaux OUT,l_codtmaaux OUT,l_turintaux OUT,l_coderr OUT,l_codeqpaux OUT,l_codcataux OUT);

               IF   (l_coderr = 0) THEN
                    /* Busca Informações da Escala. */
                    BEGIN
                         SELECT TIPFER,TABFER,TIPESC,TURESC INTO l_tipferaux,l_tabferaux,l_tipescaux,l_turescaux FROM R006ESC WHERE CODESC=l_codescaux;
                    EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                         l_coderr := 5;
                    WHEN OTHERS THEN
                         l_coderr := 10;
                    END;

                    /* Ponte Não Vale Para Escalas Definidas. */
                    IF   (l_tipescaux = 'D') OR (l_tipescaux = 'I') THEN
                         l_codescaux := l_codesc;
                         l_codtmaaux := l_codtma;
                         l_tipferaux := l_tipfer;
                         l_tabferaux := l_tabfer;
                         l_tipescaux := l_tipesc;
                         l_turescaux := l_turesc;
                         l_codeqpaux := l_codeqp;
                         l_codcataux := l_codcat;
                         l_datbus := p_dathor;
                    END IF;

                    IF   (l_coderr = 0) THEN
                         /* Verifica Se a data é Feriado */
                         Rh_DatFer(p_numemp,p_tipcol,p_numcad,l_codfil,l_tipferaux,l_tabferaux,l_turescaux,l_datbus,l_tipescaux,l_feriado OUT);

                         /* Se Programação Sobrepõe Feriado Pega a data da Ponte. */
                         IF   (l_prgfer = 'S') THEN
                              IF   (l_feriado = TRUE) THEN
                                   l_diafer := 1;
                              ELSE
                                   l_diafer := 0;
                              END IF;
                         END IF;
                    END IF;
               END IF;
          END IF;
     ELSE
          l_datbus := p_dathor;
     END IF;

     /* Se Ponte sobrepõe troca de horário = N, então verifica troca de horário */
     /* na data atual, sem considerar a ponte.                                  */
     IF  (l_tempon = 1) AND (l_ponsob = 'N')  THEN
         l_datbusaux := l_datbus;
         l_datbus := p_dathor;
     END IF;

     IF   (l_coderr = 0) THEN
          /* Verifica Troca de Horario na data procurada. */
          BEGIN
               SELECT CODHOR,CODINT INTO l_codhor,l_codint FROM R064THR WHERE NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND DATINI=l_datbus;
          EXCEPTION
          WHEN NO_DATA_FOUND THEN
               l_codhor := 0;
               NULL;
          WHEN OTHERS THEN
               l_coderr := 10;
          END;

          IF  l_codhor <> 0 THEN
              l_horbu1 := 0;
              l_horbu2 := 0;
              l_horbu3 := 0;
              l_horbu4 := 0;
              l_horbu5 := 0;
              l_seqhba := 0;

              IF  (l_prgfer = 'S') THEN
                  l_diafer := 0;
              END IF;

              IF  (l_codhor=9997) THEN
                 l_diafer := 1;
                 l_codhor := 0;
              END IF;

          END IF;
     END IF;

     IF   (l_coderr = 0) AND (l_codhor = 0) THEN
          /* Se não tem troca de horário na data e Ponte sobrepõe troca de horário = N, */
          /* então restaura a data da ponte e busca horário cfe. data da ponte.         */
          IF  (l_tempon = 1) AND (l_ponsob = 'N')  THEN
              l_datbus := l_datbusaux;
          END IF;

          /* Retorna informação do horário. */
          IF   (l_tempon = 0) THEN
               RH_HORESC(p_numemp,p_tipcol,p_numcad,l_datbus,l_codfil,l_codesc,l_codtma,l_tipesc,l_tipfer,l_tabfer,l_turesc,l_codeqp,l_codcat,l_horesc OUT,l_codhor OUT,l_horbu1 OUT,l_horbu2 OUT,l_horbu3 OUT,l_horbu4 OUT,l_horbu5 OUT, l_coderr OUT, l_seqhba OUT);
          ELSE
               RH_HORESC(p_numemp,p_tipcol,p_numcad,l_datbus,l_codfil,l_codescaux,l_codtmaaux,l_tipescaux,l_tipferaux,l_tabferaux,l_turescaux,l_codeqpaux,l_codcataux,l_horesc OUT,l_codhor OUT,l_horbu1 OUT,l_horbu2 OUT,l_horbu3 OUT,l_horbu4 OUT,l_horbu5 OUT, l_coderr OUT, l_seqhba OUT);
          END IF;
     END IF;

     /* Busca código do Intervalo no dia. */
     IF   ((l_codint = 0) AND (l_turint <> 0)) THEN
          BEGIN
               SELECT CODINT INTO l_codint FROM R006TIH WHERE R006TIH.CODESC=l_codesc AND R006TIH.TURINT=l_turint AND R006TIH.CODHOR=l_codhor;
          EXCEPTION
          WHEN NO_DATA_FOUND THEN
               l_codint := 0;
          WHEN OTHERS THEN
               l_coderr := 10;
          END;
     END IF;
END IF;

p_codesc := l_codesc;
p_codtma := l_codtma;
p_tipcnv := l_tipcnv;
/* Verifica a programação de convocação para a data. */
IF   (l_tipcnv = 3) AND ((l_codhor >= 9996) OR ((l_diafer = 1) AND (l_prgfer = 'S'))) THEN
     p_codhor := l_horcnv;
     p_horbu1 := 0;
     p_horbu2 := 0;
     p_horbu3 := 0;
     p_horbu4 := 0;
     p_horbu5 := 0;
     p_seqhba := 0;
     p_coderr := 0;
     p_diafer := 0;
ELSE
     p_codhor := l_codhor;
     p_horbu1 := l_horbu1;
     p_horbu2 := l_horbu2;
     p_horbu3 := l_horbu3;
     p_horbu4 := l_horbu4;
     p_horbu5 := l_horbu5;
     p_seqhba := l_seqhba;
     p_coderr := l_coderr;
     p_diafer := l_diafer;
END IF;

p_turint := l_turint;
IF  (l_codint IS NULL) THEN
     p_codint := 0;
ELSE p_codint := l_codint;
END IF;
END␀–ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ª␀␀PROCEDURE RH_RETHORAPU(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATAPU DATE,P_CODHOR OUT NUMBER(4),P_CODERR OUT NUMBER(2))
 IS

/* Auxiliares */
   l_hordat   NUMBER;
   l_coderr   NUMBER;
BEGIN
   l_hordat := 0;
   l_coderr := 0;

   /* Carga das Definições de Apuração. */
   BEGIN
      SELECT HORDAT INTO l_hordat FROM R066APU WHERE
            NUMEMP = p_numemp AND
            TIPCOL = p_tipcol AND
            NUMCAD = p_numcad AND
            DATAPU = p_datapu;
   EXCEPTION
     WHEN NO_DATA_FOUND THEN
      l_coderr := 1;
     WHEN OTHERS THEN
      l_coderr := 2;
   END;

   p_codhor := l_hordat;
   p_coderr := l_coderr;
END␀—ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
2␀␀PROCEDURE RH_RETHOROPC(P_CODESC NUMBER,P_SEQHBA NUMBER,P_HORBU1 OUT NUMBER(4),P_HORBU2 OUT NUMBER(4),P_HORBU3 OUT NUMBER(4),P_HORBU4 OUT NUMBER(4),P_HORBU5 OUT NUMBER(4),P_HORBU6 OUT NUMBER(4),P_HORBU7 OUT NUMBER(4),P_HORBU8 OUT NUMBER(4),P_HORBU9 OUT NUMBER(4),P_HORBU10 OUT NUMBER(4),P_HORBU11 OUT NUMBER(4),P_HORBU12 OUT NUMBER(4),P_HORBU13 OUT NUMBER(4),P_HORBU14 OUT NUMBER(4),P_HORBU15 OUT NUMBER(4),P_HORBU16 OUT NUMBER(4),P_HORBU17 OUT NUMBER(4),P_HORBU18 OUT NUMBER(4),P_HORBU19 OUT NUMBER(4),P_HORBU20 OUT NUMBER(4),P_HORBU21 OUT NUMBER(4),P_HORBU22 OUT NUMBER(4),P_HORBU23 OUT NUMBER(4),P_HORBU24 OUT NUMBER(4),P_HORBU25 OUT NUMBER(4),P_HORBU26 OUT NUMBER(4),P_HORBU27 OUT NUMBER(4),P_HORBU28 OUT NUMBER(4),P_HORBU29 OUT NUMBER(4),P_HORBU30 OUT NUMBER(4))
 IS

l_seqhop    r006hba.seqhop%TYPE;
    l_horopc    r006hba.codhop%TYPE;
	l_quant   INTEGER;
	
	CURSOR C_HORARIOS IS
		SELECT R006HBA.SEQHOP, R006HBA.CODHOP
		FROM   R006HBA
		WHERE  R006HBA.CODESC = p_codesc 
		AND    R006HBA.SEQREG = p_seqhba
		ORDER BY R006HBA.SEQHOP;
BEGIN
	p_horbu1  := 0;
	p_horbu2  := 0;
	p_horbu3  := 0;
	p_horbu4  := 0;
	p_horbu5  := 0;
	p_horbu6  := 0;
	p_horbu7  := 0;
	p_horbu8  := 0;
	p_horbu9  := 0;
	p_horbu10 := 0;
	p_horbu11 := 0;
	p_horbu12 := 0;
	p_horbu13 := 0;
	p_horbu14 := 0;
	p_horbu15 := 0;
	p_horbu16 := 0;
	p_horbu17 := 0;
	p_horbu18 := 0;
	p_horbu19 := 0;
	p_horbu20 := 0;
	p_horbu21 := 0;
	p_horbu22 := 0;
	p_horbu23 := 0;
	p_horbu24 := 0;
	p_horbu25 := 0;
	p_horbu26 := 0;
	p_horbu27 := 0;
	p_horbu28 := 0;
	p_horbu29 := 0;
	p_horbu30 := 0;

	l_quant := 0;
	FOREACH C_HORARIOS INTO l_seqhop, l_horopc
	LOOP
		l_quant := l_quant + 1;
		IF (l_quant <= 30) THEN
			IF (l_quant = 1) THEN
			   p_horbu1 := l_horopc;
			END IF;

			IF (l_quant = 2) THEN
			   p_horbu2 := l_horopc;
			END IF;

			IF (l_quant = 3) THEN
			   p_horbu3 := l_horopc;
			END IF;

			IF (l_quant = 4) THEN
			   p_horbu4 := l_horopc;
			END IF;

			IF (l_quant = 5) THEN
			   p_horbu5 := l_horopc;
			END IF;

			IF (l_quant = 6) THEN
			   p_horbu6 := l_horopc;
			END IF;

			IF (l_quant = 7) THEN
			   p_horbu7 := l_horopc;
			END IF;

			IF (l_quant = 8) THEN
			   p_horbu8 := l_horopc;
			END IF;

			IF (l_quant = 9) THEN
			   p_horbu9 := l_horopc;
			END IF;

			IF (l_quant = 10) THEN
			   p_horbu10 := l_horopc;
			END IF;

			IF (l_quant = 11) THEN
			   p_horbu11 := l_horopc;
			END IF;

			IF (l_quant = 12) THEN
			   p_horbu12 := l_horopc;
			END IF;

			IF (l_quant = 13) THEN
			   p_horbu13 := l_horopc;
			END IF;

			IF (l_quant = 14) THEN
			   p_horbu14 := l_horopc;
			END IF;

			IF (l_quant = 15) THEN
			   p_horbu15 := l_horopc;
			END IF;

			IF (l_quant = 16) THEN
			   p_horbu16 := l_horopc;
			END IF;

			IF (l_quant = 17) THEN
			   p_horbu17 := l_horopc;
			END IF;

			IF (l_quant = 18) THEN
			   p_horbu18 := l_horopc;
			END IF;

			IF (l_quant = 19) THEN
			   p_horbu19 := l_horopc;
			END IF;

			IF (l_quant = 20) THEN
			   p_horbu20 := l_horopc;
			END IF;

			IF (l_quant = 21) THEN
			   p_horbu21 := l_horopc;
			END IF;

			IF (l_quant = 22) THEN
			   p_horbu22 := l_horopc;
			END IF;

			IF (l_quant = 23) THEN
			   p_horbu23 := l_horopc;
			END IF;

			IF (l_quant = 24) THEN
			   p_horbu24 := l_horopc;
			END IF;

			IF (l_quant = 25) THEN
			   p_horbu25 := l_horopc;
			END IF;

			IF (l_quant = 26) THEN
			   p_horbu26 := l_horopc;
			END IF;

			IF (l_quant = 27) THEN
			   p_horbu27 := l_horopc;
			END IF;

			IF (l_quant = 28) THEN
			   p_horbu28 := l_horopc;
			END IF;

			IF (l_quant = 29) THEN
			   p_horbu29 := l_horopc;
			END IF;

			IF (l_quant = 30) THEN
			   p_horbu30 := l_horopc;
			END IF;
		ELSE
			EXIT;
		END IF;	          
	END LOOP;
END␀˜ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Õ␀␀/* Retorna o primeiro código de Origem de Exame com o Tipo Especificado
   p_TipOri - Tipo de Origem passado para procurar a Origem a ser retornada
   p_OriExa - Origem de Exame encontrada */
PROCEDURE RH_RETORIEXA(P_TIPORI NUMBER(3),P_ORIEXA OUT NUMBER(3))
 IS

l_VetMed       CHAR; 
  l_CountReg     NUMBER;
BEGIN
     /* Verifica quantos registros existem na tabela da Proprietária. */
     SELECT COUNT(*) INTO l_CountReg FROM R000PRP;

     /* a tabela da proprietária não pode ter mais de 1 registro */
     IF (l_CountReg > 1) THEN
       RAISERROR 103 'Erro ao buscar dados da tabela da Proprietária (R000PRP): A tabela possui mais de um registro';
     END IF;

     /* Verifica se está integrado com o Módulo Medicina */
     BEGIN
          SELECT VETMED INTO l_VetMed FROM R000PRP;
     EXCEPTION
          WHEN NO_DATA_FOUND THEN
               l_VetMed := 'N';
     END;
     IF   (l_VetMed = 'S') THEN
	     
         /* Busca a Origem do Exame com o Tipo especificado */
	     BEGIN
		    SELECT MIN(ORIEXA) INTO p_OriExa FROM R108ORI WHERE TIPORI = p_TipOri;
		 EXCEPTION
		    WHEN NO_DATA_FOUND THEN
		      p_OriExa := 0;
	     END;
     ELSE
       p_OriExa := 0;
     END IF;
END␀™ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_MODINT
␀␀PROCEDURE RH_RETSRV(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATSRV DATE,P_DIAFOL OUT VARCHAR2(1),P_CODSRV OUT NUMBER(4),P_CODTSE OUT NUMBER(2),P_TIPFOL OUT NUMBER(2))
 IS

/* Auxiliares */
   l_data_zero DATE;
   l_datini DATE;
   l_diasemdatalt INTEGER;
   l_qtddif INTEGER;
   l_difdat INTEGER;
   l_codseq NUMBER;
   l_qtdseq INTEGER;

   /* Tabela R034ESR. */
   l_datalt   r034esr.datalt%TYPE;
   l_diafol   r034esr.diafol%TYPE;
   l_codsrv   r034esr.codsrv%TYPE;
   l_codtse   r034esr.codtse%TYPE;
   l_tipfol   r034esr.tipfol%TYPE;
   l_semini   r034esr.codsrv%TYPE;
BEGIN
/* Variáveis auxiliares. */
l_data_zero := DATETIME(31,12,1900,0,0,0);
l_diafol := 'N';
l_codsrv := 0;
l_codtse := 0;
l_tipfol := 0;


/* Pega a definição de escala de serviço para aquela data. */
BEGIN
SELECT MAX(DATALT) INTO l_datalt
 FROM R034ESR
WHERE NUMEMP=p_numemp AND
      TIPCOL=p_tipcol AND
      NUMCAD=p_numcad AND
      DATALT<=p_datsrv;
EXCEPTION
WHEN OTHERS THEN
     l_datalt := DATETIME(31,12,1900,0,0,0);
END;

IF   (l_datalt <> DATETIME(31,12,1900,0,0,0)) THEN

     /* Procura a quantidade de registros daquela definição. */
     BEGIN
     SELECT COUNT(*) INTO l_qtdseq
       FROM R034ESR
      WHERE NUMEMP=p_numemp AND
            TIPCOL=p_tipcol AND
            NUMCAD=p_numcad AND
            DATALT=l_datalt;
     EXCEPTION
     WHEN OTHERS THEN
          l_qtdseq := 0;
     END;

     /* Alteração pode ser em qualquer dia da semana, mas escala é cadastrada desde segunda-feira. */
     /* Pega o dia da semana da data de alteração. */
     l_diasemdatalt := dayofweek(l_datalt);
     IF (l_diasemdatalt = 1) THEN/* Domingo. */
       l_qtddif := -6;
     ELSE
       /* -1 no final porque 1 é segunda. */
       l_qtddif := -(l_diasemdatalt - 2);
     END IF;
     l_datini := DATETIMEADD(DD, l_qtddif, l_datalt);

     /* Ajusta de acordo com semana inicial. */
     /* Pega a semana inicial da escala de serviço para aquela data. */
     BEGIN
     SELECT IFNULL(SEMINI,1)  INTO l_semini
       FROM R034ESR
      WHERE NUMEMP=p_numemp AND
            TIPCOL=p_tipcol AND
            NUMCAD=p_numcad AND
            DATALT=l_datalt AND
            CODSEQ=0;
     EXCEPTION
     WHEN OTHERS THEN
          l_semini := 1;
     END;
     l_semini := l_semini-1;
     l_semini := (l_semini * -7);
     l_datini := DATETIMEADD(DD, l_semini, l_datini);

     /* Calcula a Lê da sequencia correta. */
     l_difdat := DATETIMEDIF(DD, p_datsrv, l_datini);
     RH_MODINT(l_difdat, l_qtdseq, l_codseq OUT);

     /* Lê o registro correspondente a data. */
     BEGIN
     SELECT DIAFOL, CODSRV, CODTSE, TIPFOL INTO l_diafol, l_codsrv, l_codtse, l_tipfol
       FROM R034ESR
      WHERE NUMEMP=p_numemp AND
            TIPCOL=p_tipcol AND
            NUMCAD=p_numcad AND
            DATALT=l_datalt AND
            CODSEQ=l_codseq;
     EXCEPTION
     WHEN OTHERS THEN
          l_diafol := 'N';
          l_codsrv := 0;
          l_codtse := 0;
          l_tipfol := 0;
     END;
END IF;

p_diafol := l_diafol;
p_codsrv := l_codsrv;
p_codtse := l_codtse;
p_tipfol := l_tipfol;
END␀šì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
H␀␀PROCEDURE RH_RETTIPFIL(P_NUMEMP NUMBER(4),P_CODFIL NUMBER(6),P_TIPFIL OUT VARCHAR2(1))
 IS
BEGIN
  BEGIN	               
    SELECT TIPFIL
    INTO P_TIPFIL
    FROM R030FIL
    WHERE NUMEMP = p_numemp AND
          CODFIL = p_codfil;
     	
  EXCEPTION WHEN NO_DATA_FOUND THEN
    P_TIPFIL := NULL;
  END;
   
END␀›ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
