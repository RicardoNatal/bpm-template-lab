TRIGGER R058LEC_EU AFTER UPDATE ON R058LEC FOR EACH ROW

DECLARE
	l_coddsp VARCHAR2(9);
BEGIN
 	RH_250ALT(23);

	IF (:NEW.ALMPOR <> :OLD.ALMPOR) OR
		(:NEW.AMBSEN <> :OLD.AMBSEN) OR
		(:NEW.DIRACC <> :OLD.DIRACC) OR
		(:NEW.MODLEI <> :OLD.MODLEI) OR
		(:NEW.GRACON <> :OLD.GRACON) OR
		(:NEW.TEMSUR <> :OLD.TEMSUR) OR
		(:NEW.LEICRA <> :OLD.LEICRA) OR
		(:NEW.CODTBI <> :OLD.CODTBI) OR
		(:NEW.TIPBIO <> :OLD.TIPBIO) OR
		(:NEW.ACIPOR <> :OLD.ACIPOR) OR
		(:NEW.USAPAR <> :OLD.USAPAR) OR
		(:NEW.CONVEI <> :OLD.CONVEI) OR
		(:NEW.ALMPOR <> :OLD.ALMPOR)
	THEN
		SP_INTSTR(:NEW.CODDSP, '999999999', l_coddsp OUT);
		SP_SAM_PENDENCIES(23, 2, l_coddsp);
	END IF;

END␀Ã×␀␀		SENIOR;0X

