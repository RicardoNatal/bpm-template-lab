BEGIN
R044MOV_ATUSAL ('U',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODCAL,:NEW.CODEVE,:NEW.TABEVE,:NEW.REFEVE,:OLD.REFEVE);
END␀Ö␀␀		SENIOR;0>␀␀

/* Trigger de Atualizacao dos Saldos de Eventos apos Exclusão   */
/* Gerar Diferenças de Evento do Movimento (r044mov x r044rec). */
TRIGGER R044FEC_ED AFTER DELETE ON R044FEC FOR EACH ROW

BEGIN
R044MOV_ATUSAL ('D',:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.CODCAL,:OLD.CODEVE,:OLD.TABEVE,0,:OLD.REFEVE);
END␀␀␀°£␀␀␀␀␀␀␀␀␀␀␀␀␀Ö␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀Ü␀Ü␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀.%0.0.w␀Æÿ␀␀…Ó␀␀␀Ó␀±␀	␀␀␀␀␀␀␀>´␀û␀q␀Æÿ␀␀Ï␀␀␀…,´␀	␀␀␀␀␀␀␀W;NgNgr␀Æÿ␀␀#␀X-Ì␀	␀␀␀␀␀␀␀9A0í␀␀0í␀␀{␀Æÿ␀␀ØĞ␀␀␀EÑ␀	␀␀␀␀␀␀␀(Ké”␀␀ê”␀␀qC␀êÿ␀␀ÿ␀ƒ1Á␀	␀␀␀␀␀␀␀555)␀␀Æÿ␀␀ÿ␀Ä␀‘␀␀␀␀␀␀␀␀°#␀¦␀¦␀h)␀␀Æÿ␀␀ÿ␀îa‘␀␀␀␀␀␀␀␀¬#␀KcKch)␀␀Æÿ␀␀ÿ␀␀␀Ö␀␀␀␀0;1;2;3;4;5;6;7Ö␀␀		SENIOR;0	␀␀TRIGGER R044FIF_EI AFTER INSERT ON R044FIF FOR EACH ROW

DECLARE
l_temAud       BOOLEAN;
l_codRPA       NUMBER(15);
l_codcpa       NUMBER(4);
l_codtpa       NUMBER(4);
l_datTemp      VARCHAR(10);
 
BEGIN
  /* Geração de log de inserção de eventos fixos - contas financeiras */
  l_codcpa := 13;        /*l_codcpa representa a categoria e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java  */
  l_codtpa := 139;       /*l_codtpa representa a o tipo Inserir/Excluir e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java*/
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, 1, l_temAud OUT);
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT); 
    SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R044FIF_EI', 'FRFIXVAR');
     
     /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
    BEGIN
	    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TipCol));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NumCad));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TabEve));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CodEve));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRAT', CONVERT(NUMBER_TO_CHAR, :NEW.CodRat));
		SP_DATSTR(:NEW.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONFIN', CONVERT(NUMBER_TO_CHAR, :NEW.ConFin));		
	EXCEPTION
	    WHEN OTHERS THEN RAISERROR 103 'R044FIF_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	END;
	 
	BEGIN
	    /* insere os campos que não são chave na Tabela R995PRT (Tipo de auditoria) */
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALFIN', CONVERT(NUMBER_TO_CHAR, :NEW.ValFin));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EMPFIN', CONVERT(NUMBER_TO_CHAR, :NEW.EmpFin));	 
	END;	
  END IF;  
END␀Ö␀␀		SENIOR;0€␀␀

TRIGGER R044FIF_EU AFTER UPDATE ON R044FIF FOR EACH ROW

DECLARE
l_temAud       BOOLEAN;
l_codRPA       NUMBER(15);
l_codcpa       NUMBER(4);
l_codtpa       NUMBER(4);
l_datTemp      VARCHAR(10);

BEGIN
  /* Geração de log de alteração de eventos fixos */
  l_codcpa := 13;        /*l_codcpa representa a categoria e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java  */
  l_codtpa := 140;       /*l_codtpa representa a o tipo Alteração e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java*/
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, 1, l_temAud OUT);
  
  IF ((:OLD.NumEmp <> :NEW.NumEmp)
	OR (:OLD.TipCol <> :NEW.TipCol)
	OR (:OLD.NumCad <> :NEW.NumCad)
	OR (:OLD.TabEve <> :NEW.TabEve)
	OR (:OLD.CodEve <> :NEW.CodEve)
	OR (:OLD.CodRat <> :NEW.CodRat)
	OR (:OLD.DatIni <> :NEW.DatIni)
	OR (:OLD.ConFin <> :NEW.ConFin)
	OR (:OLD.ValFin <> :NEW.ValFin)
	OR (:OLD.EmpFin <> :NEW.EmpFin)) THEN
  BEGIN   
	  IF (l_temAud = TRUE) THEN
        SP_RET_REG_AUD(l_codrpa OUT); 
	    SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R044FIF_EU', 'FRFIXVAR');
	     
	     /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
	    BEGIN
		    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TipCol));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NumCad));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TabEve));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CodEve));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRAT', CONVERT(NUMBER_TO_CHAR, :NEW.CodRat));
			SP_DATSTR(:NEW.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONFIN', CONVERT(NUMBER_TO_CHAR, :NEW.ConFin));
		EXCEPTION
		    WHEN OTHERS THEN RAISERROR 103 'R044FIF_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
		END;
		 
		BEGIN
		    /* insere os campos que não são chave na Tabela R995PRT (Tipo de auditoria) */		
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVALFIN', CONVERT(NUMBER_TO_CHAR, :OLD.ValFin));
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWVALFIN', CONVERT(NUMBER_TO_CHAR, :NEW.ValFin));
			
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDEMPFIN', CONVERT(NUMBER_TO_CHAR, :OLD.EmpFin));
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWEMPFIN', CONVERT(NUMBER_TO_CHAR, :NEW.EmpFin));	 
		END;	
	  END IF;  
	END;
  END IF;
END␀Ö␀␀		SENIOR;0	␀␀

