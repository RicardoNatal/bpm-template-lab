TPROCEDURE SP_RET_REG_AUD(P_CODIGO_REGISTRO_RET OUT NUMBER(15))
 IS
BEGIN
  NULL;
END	ORACLE;0
„CREATE  OR REPLACE PROCEDURE SP_RET_REG_AUD (retorno OUT NUMBER)
IS
BEGIN
   retorno := SEQ_R995RPA.nextval;
END SP_RET_REG_AUD;	MSSQL;0
·␀␀/* SQL2008 OR SQL2008R2 */
DECLARE @isSql2008 BIT = CASE WHEN CAST(SERVERPROPERTY('ProductVersion') AS VARCHAR) like '10.%' THEN 1 ELSE 0 END;
IF (@isSql2008 = 1)
	EXECUTE ('
	CREATE PROCEDURE sp_ret_reg_aud (@P_CODIGO_REGISTRO_RET BIGINT OUTPUT) AS
	BEGIN
		DECLARE @l_cod_registro VARCHAR(15)
		DECLARE @ChkError INTEGER
		SELECT @ChkError = 0
		EXECUTE  @ChkError = GetNextValueInt64 ''REGAUD'',1,NULL,@l_Cod_Registro OUTPUT  
		IF @ChkError <> 0
		BEGIN
			GOTO FIM
		END
		SELECT @P_CODIGO_REGISTRO_RET = CONVERT(NUMERIC,@l_Cod_Registro)

		FIM:
			RETURN @ChkError
	END;');
ELSE
BEGIN
    /* SQL2012+ */
	DECLARE @starValue BIGINT;
	SELECT @starValue = COALESCE(MAX(CODRPA), 1) FROM R995RPA
	
	/* Garante que a SEQUENCE será criada caso não existir, visto que o cliente pode migrar do SQLSERVER 2008 para 2012+ sem rodar o atualizador de base */
	EXECUTE('
	IF NOT EXISTS(SELECT * FROM sys.sequences WHERE object_id = object_id(''SEQ_R995RPA''))
	BEGIN
		CREATE SEQUENCE SEQ_R995RPA 
		AS BIGINT 
		START WITH ' + @starValue + '
		INCREMENT BY 1
		MINVALUE 1  
		MAXVALUE 999999999999999  
		CYCLE
		NO CACHE;
	END;');

	EXECUTE ('
	CREATE PROCEDURE sp_ret_reg_aud (@P_CODIGO_REGISTRO_RET BIGINT OUTPUT) AS
	BEGIN
		EXEC sp_executesql N''SELECT @P_CODIGO_REGISTRO_RET=NEXT VALUE FOR SEQ_R995RPA'', 
                           N''@P_CODIGO_REGISTRO_RET BIGINT OUTPUT'', @P_CODIGO_REGISTRO_RET output;
	END;');
END	POSTGRESQL;0
E␀␀CREATE OR REPLACE PROCEDURE SP_RET_REG_AUD (retorno INOUT bigint)
LANGUAGE 'plpgsql'
AS $BODY$
declare
NOME_SEQUENCE VARCHAR(255);
MAXIMO BIGINT;
begin
	
	SELECT SEQUENCE_NAME INTO NOME_SEQUENCE, MAXIMO FROM INFORMATION_SCHEMA.SEQUENCES WHERE SEQUENCE_NAME = 'seq_r995rpa';
		
	IF NOME_SEQUENCE IS NULL THEN
		CREATE SEQUENCE seq_r995rpa START 1;
		SELECT MAX(CODRPA) INTO MAXIMO FROM R995RPA;
		IF MAXIMO IS NOT NULL THEN
			PERFORM SETVAL('seq_r995rpa', MAXIMO);
		END IF;
	END IF;	
	
	SELECT NEXTVAL('seq_r995rpa') EXPR1956031458 INTO retorno;
	
END
$BODY$;␀Öø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
cPROCEDURE SP_RET_RESPLEG(P_IDTPES VARCHAR2(23), P_CPF OUT NUMBER(11))
IS
BEGIN
  P_CPF := NULL;
END		SENIOR;20SP_PESFROMIDTPES
!␀␀

PROCEDURE SP_RET_RESPLEG(P_IDTPES VARCHAR2(23), P_CPF OUT NUMBER(11))
IS

  l_TIPOPESSOA NUMBER(2);
  l_NUMEMP NUMBER(4);
  l_TIPCOL NUMBER(1);
  l_NUMCAD NUMBER(9);
  l_TIPDOC NUMBER(1);
  l_NUMDOC VARCHAR2(20);
  l_NUMMAT VARCHAR2(15);
  l_PROPAC VARCHAR2(20);
  l_CPFPES   R000RES.CPFPES%TYPE;
  l_EMPPES   R000RES.EMPPES%TYPE;
  l_TIPPES   R000RES.TIPPES%TYPE;
  l_CADPES   R000RES.CADPES%TYPE;
  l_OPCPES   R000RES.OPCPES%TYPE;
BEGIN
  SP_PESFROMIDTPES(P_IDTPES, l_TIPOPESSOA OUT, l_NUMEMP OUT, l_TIPCOL OUT, l_NUMCAD OUT, l_TIPDOC OUT, l_NUMDOC OUT, l_NUMMAT OUT, l_PROPAC OUT);
  
  /* COLABORADOR ou TERCEIRO */
  IF (l_TIPOPESSOA = 1) OR (l_TIPOPESSOA = 2) THEN
    BEGIN
      /* Se for INFORMADO irá retornar o CPF informado, senão retorna EMP/TIP/CAD para achar a pessoa */
      SELECT CPFPES, OPCPES, EMPPES, TIPPES, CADPES
      INTO l_CPFPES, l_OPCPES, l_EMPPES, l_TIPPES, l_CADPES
      FROM R000RES
      WHERE R000RES.DOCLEG=11 /*11=REP*/ AND R000RES.NUMEMP = l_NUMEMP;
      
      /* COLABORADOR ou TERCEIRO */
      IF (l_OPCPES = 1) OR (l_OPCPES = 2) THEN
        SELECT NUMCPF INTO l_CPFPES
        FROM R034FUN
        WHERE R034FUN.NUMEMP = l_EMPPES AND R034FUN.TIPCOL = l_TIPPES AND R034FUN.NUMCAD = l_CADPES;
      END IF;
      
      P_CPF := l_CPFPES;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
      BEGIN
        BEGIN
          /* Tenta localizar um INFORMADO da aba GERAL */
          SELECT CPFPES, OPCPES, EMPPES, TIPPES, CADPES
          INTO l_CPFPES, l_OPCPES, l_EMPPES, l_TIPPES, l_CADPES
          FROM R000RES WHERE R000RES.DOCLEG=11 AND R000RES.NUMEMP = 0;

          /* COLABORADOR ou TERCEIRO */
          IF (l_OPCPES = 1) OR (l_OPCPES = 2) THEN
            SELECT NUMCPF INTO l_CPFPES
            FROM R034FUN
            WHERE R034FUN.NUMEMP = l_EMPPES AND R034FUN.TIPCOL = l_TIPPES AND R034FUN.NUMCAD = l_CADPES;
          END IF;
        EXCEPTION
          WHEN OTHERS THEN 
            l_CPFPES := NULL;
        END;

        P_CPF := l_CPFPES;
      END;

      WHEN OTHERS THEN
        P_CPF := NULL;
    END;
  END IF;
END		SENIOR;21SP_PESFROMIDTPES
!␀␀

PROCEDURE SP_RET_RESPLEG(P_IDTPES VARCHAR2(23), P_CPF OUT NUMBER(11))
IS

  l_TIPOPESSOA NUMBER(2);
  l_NUMEMP NUMBER(4);
  l_TIPCOL NUMBER(1);
  l_NUMCAD NUMBER(9);
  l_TIPDOC NUMBER(1);
  l_NUMDOC VARCHAR2(20);
  l_NUMMAT VARCHAR2(15);
  l_PROPAC VARCHAR2(20);
  l_CPFPES   R000RES.CPFPES%TYPE;
  l_EMPPES   R000RES.EMPPES%TYPE;
  l_TIPPES   R000RES.TIPPES%TYPE;
  l_CADPES   R000RES.CADPES%TYPE;
  l_OPCPES   R000RES.OPCPES%TYPE;
BEGIN
  SP_PESFROMIDTPES(P_IDTPES, l_TIPOPESSOA OUT, l_NUMEMP OUT, l_TIPCOL OUT, l_NUMCAD OUT, l_TIPDOC OUT, l_NUMDOC OUT, l_NUMMAT OUT, l_PROPAC OUT);
  
  /* COLABORADOR ou TERCEIRO */
  IF (l_TIPOPESSOA = 1) OR (l_TIPOPESSOA = 2) THEN
    BEGIN
      /* Se for INFORMADO irá retornar o CPF informado, senão retorna EMP/TIP/CAD para achar a pessoa */
      SELECT CPFPES, OPCPES, EMPPES, TIPPES, CADPES
      INTO l_CPFPES, l_OPCPES, l_EMPPES, l_TIPPES, l_CADPES
      FROM R000RES
      WHERE R000RES.DOCLEG=11 /*11=REP*/ AND R000RES.NUMEMP = l_NUMEMP;
      
      /* COLABORADOR ou TERCEIRO */
      IF (l_OPCPES = 1) OR (l_OPCPES = 2) THEN
        SELECT NUMCPF INTO l_CPFPES
        FROM R034FUN
        WHERE R034FUN.NUMEMP = l_EMPPES AND R034FUN.TIPCOL = l_TIPPES AND R034FUN.NUMCAD = l_CADPES;
      END IF;
      
      P_CPF := l_CPFPES;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
      BEGIN
        BEGIN
          /* Tenta localizar um INFORMADO da aba GERAL */
          SELECT CPFPES, OPCPES, EMPPES, TIPPES, CADPES
          INTO l_CPFPES, l_OPCPES, l_EMPPES, l_TIPPES, l_CADPES
          FROM R000RES WHERE R000RES.DOCLEG=11 AND R000RES.NUMEMP = 0;

          /* COLABORADOR ou TERCEIRO */
          IF (l_OPCPES = 1) OR (l_OPCPES = 2) THEN
            SELECT NUMCPF INTO l_CPFPES
            FROM R034FUN
            WHERE R034FUN.NUMEMP = l_EMPPES AND R034FUN.TIPCOL = l_TIPPES AND R034FUN.NUMCAD = l_CADPES;
          END IF;
        EXCEPTION
          WHEN OTHERS THEN 
            l_CPFPES := NULL;
        END;

        P_CPF := l_CPFPES;
      END;

      WHEN OTHERS THEN
        P_CPF := NULL;
    END;
  END IF;
END		SENIOR;22SP_PESFROMIDTPES
!␀␀

PROCEDURE SP_RET_RESPLEG(P_IDTPES VARCHAR2(23), P_CPF OUT NUMBER(11))
IS

  l_TIPOPESSOA NUMBER(2);
  l_NUMEMP NUMBER(4);
  l_TIPCOL NUMBER(1);
  l_NUMCAD NUMBER(9);
  l_TIPDOC NUMBER(1);
  l_NUMDOC VARCHAR2(20);
  l_NUMMAT VARCHAR2(15);
  l_PROPAC VARCHAR2(20);
  l_CPFPES   R000RES.CPFPES%TYPE;
  l_EMPPES   R000RES.EMPPES%TYPE;
  l_TIPPES   R000RES.TIPPES%TYPE;
  l_CADPES   R000RES.CADPES%TYPE;
  l_OPCPES   R000RES.OPCPES%TYPE;
BEGIN
  SP_PESFROMIDTPES(P_IDTPES, l_TIPOPESSOA OUT, l_NUMEMP OUT, l_TIPCOL OUT, l_NUMCAD OUT, l_TIPDOC OUT, l_NUMDOC OUT, l_NUMMAT OUT, l_PROPAC OUT);
  
  /* COLABORADOR ou TERCEIRO */
  IF (l_TIPOPESSOA = 1) OR (l_TIPOPESSOA = 2) THEN
    BEGIN
      /* Se for INFORMADO irá retornar o CPF informado, senão retorna EMP/TIP/CAD para achar a pessoa */
      SELECT CPFPES, OPCPES, EMPPES, TIPPES, CADPES
      INTO l_CPFPES, l_OPCPES, l_EMPPES, l_TIPPES, l_CADPES
      FROM R000RES
      WHERE R000RES.DOCLEG=11 /*11=REP*/ AND R000RES.NUMEMP = l_NUMEMP;
      
      /* COLABORADOR ou TERCEIRO */
      IF (l_OPCPES = 1) OR (l_OPCPES = 2) THEN
        SELECT NUMCPF INTO l_CPFPES
        FROM R034FUN
        WHERE R034FUN.NUMEMP = l_EMPPES AND R034FUN.TIPCOL = l_TIPPES AND R034FUN.NUMCAD = l_CADPES;
      END IF;
      
      P_CPF := l_CPFPES;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
      BEGIN
        BEGIN
          /* Tenta localizar um INFORMADO da aba GERAL */
          SELECT CPFPES, OPCPES, EMPPES, TIPPES, CADPES
          INTO l_CPFPES, l_OPCPES, l_EMPPES, l_TIPPES, l_CADPES
          FROM R000RES WHERE R000RES.DOCLEG=11 AND R000RES.NUMEMP = 0;

          /* COLABORADOR ou TERCEIRO */
          IF (l_OPCPES = 1) OR (l_OPCPES = 2) THEN
            SELECT NUMCPF INTO l_CPFPES
            FROM R034FUN
            WHERE R034FUN.NUMEMP = l_EMPPES AND R034FUN.TIPCOL = l_TIPPES AND R034FUN.NUMCAD = l_CADPES;
          END IF;
        EXCEPTION
          WHEN OTHERS THEN 
            l_CPFPES := NULL;
        END;

        P_CPF := l_CPFPES;
      END;

      WHEN OTHERS THEN
        P_CPF := NULL;
    END;
  END IF;
END		SENIOR;23SP_PESFROMIDTPES
