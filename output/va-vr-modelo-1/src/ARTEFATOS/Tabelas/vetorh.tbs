        SELECT @ChkError = 0
        BEGIN
          RAISERROR('SP_STRTODATE: Erro ao converter data.',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
DATA_VAZIA:
  
FIM:
  RETURN @ChkError
END

