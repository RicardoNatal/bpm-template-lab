ğ␀␀Óï␀␀	ğ␀␀1␀␀ÿ␀␀ÿ␀v␀ª␀␀␀␀␀␀u␀Ÿ␀Ÿ␀n␀Æÿ␀␀ÿ␀A‹␀␀=␀␀␀␀␀␀9RH‹␀␀H‹␀␀c␀␀␀ÿ␀␀ÿ␀[␀␀=␀␀␀␀␀␀î33c␀␀␀ÿ␀␀ÿ␀s¬␀␀␀␀␀␀␀␀␀±␀␀‰#‰#Q␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3␀␀¹␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Ô␀␀…¬␀␀´␀	Ôÿ!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ!␀␀␀␀␀}␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ!␀␀␀␀␀P%€$0.w␀Æÿ␀␀…Ó␀␀␀c,­␀	Ôÿ!␀␀␀␀␀H@}S}Sp␀Æÿ␀␀Ô␀␀␀mDÑ␀	Ôÿ!␀␀␀␀␀‡JşEşEqC␀êÿ␀␀ÿ␀Öü␀␀­␀	Ôÿ!␀␀␀␀␀xş␀␀xş␀␀xş␀␀3)␀␀Æÿ␀␀ÿ␀,´␀	Ôÿ!␀␀␀␀␀Ş?ÅÅr␀Æÿ␀␀ìÏ␀␀␀ø+·␀	Ôÿ!␀␀␀␀␀N<s␀Æÿ␀␀êÏ␀␀␀	␀ôÔÿ!␀␀␀␀␀‡␀␀␀n␀Æÿ␀␀ÿ␀R1–␀	Ôÿ!␀␀␀␀␀555c␀Æÿ␀␀ÿ␀]D␀␀␀␀␀␀␀è_ç_ç_R␀␀ÿ␀␀ÿ␀½␀␀¹␀␀␀␀␀␀␀␀¾␀␀¾␀␀¾␀␀Q)␀␀Æÿ␀␀ÿ␀␀␀Ô␀␀␀␀0;1;2;3;4;5;6;7;9Ô␀␀		SENIOR;07␀␀TRIGGER R036CPJ_EI AFTER INSERT ON R036CPJ FOR EACH ROW

DECLARE
L_CODPES      R033PES.CODPES%TYPE;
  l_DatAtu    DATE;
  l_Data_zero DATE;
  l_existe    BOOLEAN;
  L_DATALT      R033CON.DATALT%TYPE;
  L_ULTSEQCON   R033CON.SEQCON%TYPE;
  L_SEQCON      R033CON.SEQCON%TYPE;
  L_CODBAN      R033CON.CODBAN%TYPE;
  L_CODAGE      R033CON.CODAGE%TYPE;
  L_TIPBAN      R033CON.TIPBAN%TYPE;
  L_CONBAN      R033CON.CONBAN%TYPE;
  L_DIGBAN      R033CON.DIGBAN%TYPE;
BEGIN
  /*Data atual*/
  l_DatAtu := CURDATE();
  /*Data zerada*/
  l_data_zero  := '31/12/1900,00:00:00';

  BEGIN
    /*Verifca se colaborador tem vínculo com pessoa*/
    SELECT CODPES INTO L_CODPES FROM R036DEP
    WHERE NUMEMP = :NEW.NUMEMP
      AND TIPCOL = :NEW.TIPCOL
      AND NUMCAD = :NEW.NUMCAD
      AND CODDEP = :NEW.CODDEP;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_CODPES := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R036DEP.CODPES';
  END;

  /*Se existe o vínculo com pessoa*/
  IF (L_CODPES > 0) THEN
    l_existe := TRUE;
    BEGIN
      /*Verificar se conta já existe na base*/
      SELECT DATALT,  SEQCON,  CODBAN,  CODAGE,  CONBAN
        INTO L_DATALT,L_SEQCON,L_CODBAN,L_CODAGE,L_CONBAN
      FROM R033CON
      WHERE CODPES = L_CODPES
        AND DATALT = :NEW.DATALT
        AND CODBAN = :NEW.CODBAN
        AND CODAGE = :NEW.CODAGE
        AND CONBAN = :NEW.CONBAN;
      EXCEPTION WHEN NO_DATA_FOUND THEN
        L_SEQCON := 0;
        L_DATALT := :NEW.DATALT;
        L_CODBAN := :NEW.CODBAN;
        L_CODAGE := :NEW.CODAGE;
        L_TIPBAN := :NEW.TIPBAN;
        L_CONBAN := :NEW.CONBAN;
        L_DIGBAN := :NEW.DIGBAN;
        l_existe := FALSE;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler R033CON';
    END;
    
    IF (l_Existe = TRUE) THEN
      BEGIN
        /*Se conta já existir, atualiza os campos e zera a data de encerramento*/
        UPDATE R033CON SET TIPBAN = :NEW.TIPBAN, DIGBAN = :NEW.DIGBAN, DATENC = l_data_zero,
                           EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                           DEPAUX = :NEW.CODDEP, COLATI = 0, CANAUX = 0, DATAUX = l_Data_zero
         WHERE CODPES = L_CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON AND CODBAN = L_CODBAN AND CODAGE = L_CODAGE
           AND CONBAN = L_CONBAN;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar a R033CON';
      END;
    ELSE
      BEGIN
        SELECT IFNULL(MAX(SEQCON),0) INTO L_ULTSEQCON FROM R033CON
        WHERE CODPES = L_CODPES;
        EXCEPTION WHEN NO_DATA_FOUND THEN
          L_ULTSEQCON := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler R033CON';
      END;
      /*Gera próxima sequencia*/
      L_SEQCON := L_ULTSEQCON + 1;
      BEGIN
        /*Insere nova conta em R033CON*/
        INSERT INTO R033CON (CODPES,  DATALT,  SEQCON,  CODBAN,  CODAGE,  TIPBAN,  CONBAN,  DIGBAN,  DATABE,  DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX)
                     VALUES (L_CODPES,L_DATALT,L_SEQCON,L_CODBAN,L_CODAGE,L_TIPBAN,L_CONBAN,L_DIGBAN,l_DatAtu,l_data_zero,:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODDEP, 0, 0, l_Data_zero);
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao inserir na R033CON';
      END;
    END IF;
  END IF;
END␀Ô␀␀		SENIOR;0Ì␀␀

TRIGGER R036CPJ_EU AFTER UPDATE ON R036CPJ FOR EACH ROW

DECLARE
L_CODPES      R033PES.CODPES%TYPE;
  L_SITAFA      R034FUN.SITAFA%TYPE;
  L_DEMITIDOS BOOLEAN;
  l_DatAtu    DATE;
  l_Data_zero DATE;
  l_existe    BOOLEAN;
  L_DATALT      R033CON.DATALT%TYPE;
  L_ULTSEQCON   R033CON.SEQCON%TYPE;
  L_SEQCON      R033CON.SEQCON%TYPE;
  L_CODBAN      R033CON.CODBAN%TYPE;
  L_CODAGE      R033CON.CODAGE%TYPE;
  L_TIPBAN      R033CON.TIPBAN%TYPE;
  L_CONBAN      R033CON.CONBAN%TYPE;
  L_DIGBAN      R033CON.DIGBAN%TYPE;
BEGIN
  /*Data atual*/
  l_DatAtu := CURDATE();
  /*Data zerada*/
  l_data_zero  := '31/12/1900,00:00:00';
  
  BEGIN
    /*Verifica se colaborador tem vínculo com pessoa*/
    SELECT CODPES INTO L_CODPES FROM R036DEP
    WHERE NUMEMP = :NEW.NUMEMP
      AND TIPCOL = :NEW.TIPCOL
      AND NUMCAD = :NEW.NUMCAD
      AND CODDEP = :NEW.CODDEP;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_CODPES := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R036DEP.CODPES';
  END;

  BEGIN
    /*Verificar situação de afastamento para verificar se colaborador do dependente não foi demitido*/
    SELECT SITAFA INTO L_SITAFA FROM R034FUN
    WHERE NUMEMP = :NEW.NUMEMP
      AND TIPCOL = :NEW.TIPCOL
      AND NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_SITAFA := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R034FUN.SITAFA';
  END;

  /*Se existe o vínculo com pessoa*/
  IF (L_CODPES > 0) THEN
    RH_VERCOLDEM(:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,L_CODPES,L_SITAFA, 'R036CPJ', L_DEMITIDOS OUT);
    IF (L_DEMITIDOS = TRUE) THEN
      l_existe := TRUE;
      BEGIN
        /*Verificar se conta já não existe na base de pessoas*/
        SELECT DATALT,  SEQCON,  CODBAN,  CODAGE,  TIPBAN,  CONBAN,  DIGBAN
          INTO L_DATALT,L_SEQCON,L_CODBAN,L_CODAGE,L_TIPBAN,L_CONBAN,L_DIGBAN
        FROM R033CON
        WHERE CODPES = L_CODPES
          AND DATALT = :OLD.DATALT
          AND CODBAN = :OLD.CODBAN
          AND CODAGE = :OLD.CODAGE
          AND CONBAN = :OLD.CONBAN;
        EXCEPTION WHEN NO_DATA_FOUND THEN
          L_SEQCON := 0;
          L_DATALT := :NEW.DATALT;
          L_CODBAN := :NEW.CODBAN;
          L_CODAGE := :NEW.CODAGE;
          L_TIPBAN := :NEW.TIPBAN;
          L_CONBAN := :NEW.CONBAN;
          L_DIGBAN := :NEW.DIGBAN;
          l_existe := FALSE;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler R033CON';
      END;

      IF (l_Existe = TRUE) THEN
        BEGIN
          /*Se conta já existir, atualiza os campos e zera a data de encerramento*/
          UPDATE R033CON SET CODBAN = :NEW.CODBAN, CODAGE = :NEW.CODAGE, TIPBAN = :NEW.TIPBAN, CONBAN = :NEW.CONBAN, 
                             DIGBAN = :NEW.DIGBAN, DATENC = l_data_zero,
                             EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                             DEPAUX = :NEW.CODDEP, COLATI = 0, CANAUX = 0, DATAUX = l_Data_zero
           WHERE CODPES = L_CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON AND CODBAN = L_CODBAN AND CODAGE = L_CODAGE
             AND CONBAN = L_CONBAN;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar a R033CON';
        END;
      ELSE
        BEGIN
          /*Gerar próxima sequência*/
          SELECT IFNULL(MAX(SEQCON),0) INTO L_ULTSEQCON FROM R033CON
          WHERE CODPES = L_CODPES;
          EXCEPTION WHEN NO_DATA_FOUND THEN
            L_ULTSEQCON := 0;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler R033CON';
        END;
        L_SEQCON := L_ULTSEQCON + 1;
        BEGIN
          /*Se conta não existir inserir nova conta para a pessoa vinculada */
          INSERT INTO R033CON (CODPES,  DATALT,  SEQCON,  CODBAN,  CODAGE,  TIPBAN,  CONBAN,  DIGBAN,  DATABE, DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX)
                       VALUES (L_CODPES,L_DATALT,L_SEQCON,L_CODBAN,L_CODAGE,L_TIPBAN,L_CONBAN,L_DIGBAN,l_DatAtu,l_data_zero, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODDEP, 0, 0, l_Data_zero);
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao inserir na R033CON';
        END;
        
      END IF;
    END IF;
  END IF;
END␀␀␀C5␀␀␀␀␀␀␀␀␀␀␀␀␀Ô␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ?␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ?␀␀␀␀␀P%€$0.w␀Æÿ␀␀…Ó␀␀␀c,­␀	Ôÿ?␀␀␀␀␀B¤:}Sp␀Æÿ␀␀Ô␀␀␀j§␀␀UÔÿ!␀␀␀␀␀y©␀␀ç§␀␀ç§␀␀V␀␀ÿ␀␀ÿ␀™§␀␀v”!␀␀␀␀␀µ¨␀␀K¨␀␀µ¨␀␀n␀␀ÿ␀␀ÿ␀tk”!␀␀␀␀␀tt|º␀␀_tp␀Æÿ␀␀ÿ␀G␀•”!␀␀␀␀␀¢␀#␀¢␀p␀Æÿ␀␀ÿ␀8␀²”!␀␀␀␀␀s␀Ÿ␀␀Ÿ␀␀c␀␀␀ÿ␀␀ÿ␀fã”!␀␀␀␀␀Qf&`Qfn␀Æÿ␀␀ÿ␀	t­␀”!␀␀␀␀␀otûqQt3)␀␀Æÿ␀␀òĞ␀␀␀ù˜␀␀­␀”!␀␀␀␀␀%™␀␀p‰␀␀‘‰␀␀p␀Æÿ␀␀ÿ␀™␀␀­␀”!␀␀␀␀␀&™␀␀r‰␀␀’‰␀␀p␀Æÿ␀␀ÿ␀|=”!␀␀␀␀␀€ƒc␀␀␀ÿ␀␀ÿ␀<EÑ␀”!␀␀␀␀␀"H*¦␀␀HqC␀êÿ␀␀ÿ␀EÑ␀”!␀␀␀␀␀ïLF”␀␀ GqC␀êÿ␀␀ÿ␀ËEÑ␀”!␀␀␀␀␀OFÍ␀ñHqC␀êÿ␀␀ÿ␀<dÑ␀”!␀␀␀␀␀—F5d•FqC␀êÿ␀␀ÿ␀Hº␀␀´␀”!␀␀␀␀␀AÔ»␀␀Ó»␀␀r␀Æÿ␀␀Û␀␀␀#fT”!␀␀␀␀␀LfLfLfp␀␀␀ÿ␀␀Û␀␀␀iš␀␀Á␀”!␀␀␀␀␀Ìš␀␀¨š␀␀§š␀␀/␀Æÿ␀␀Û␀␀␀W§␀␀U”!␀␀␀␀␀k©␀␀.(¨␀␀V␀␀ÿ␀␀ÿ␀¦¬␀␀”!␀␀␀␀␀m±␀␀=š␀␀§¯␀␀␀␀ÿ␀␀ÿ␀Ò¬␀␀”!␀␀␀␀␀“±␀␀Ëï␀␀Ù¯␀␀␀␀ÿ␀␀ÿ␀¬␀␀”!␀␀␀␀␀°␀␀Üoˆ¯␀␀␀␀ÿ␀␀ÿ␀iS=”!␀␀␀␀␀S)!:!c␀␀␀ÿ␀␀ÿ␀ï^=”!␀␀␀␀␀nZ°CrZc␀␀␀ÿ␀␀ÿ␀s¬␀␀␀”!␀␀␀␀␀±␀␀‰#±␀␀Q␀Æÿ␀␀ÿ␀ª¬␀␀¢␀”!␀␀␀␀␀ °␀␀-␀␀…␀␀g␀Æÿ␀␀ÿ␀EÑ␀”!␀␀␀␀␀TG@‰␀␀SGqC␀êÿ␀␀ÿ␀ÕDÑ␀”!␀␀␀␀␀¦Fg`¤FqC␀êÿ␀␀ÿ␀Ş=”!␀␀␀␀␀øÖğc␀␀␀ÿ␀␀ÿ␀ö¦␀␀±␀”!␀␀␀␀␀Y¥␀␀ø␀␀ù␀␀q␀Æÿ␀␀ÿ␀-Ç␀”!␀␀␀␀␀ğ<¯e¯ez␀Æÿ␀␀ÖÒ␀␀␀)␀␀”!␀␀␀␀␀>Ø␀Ø␀p␀Æÿ␀␀ÿ␀‘␀␀Ñ␀”!␀␀␀␀␀•␀␀à”␀␀•␀␀qC␀êÿ␀␀ÿ␀¿EÑ␀”!␀␀␀␀␀GIoMoqC␀êÿ␀␀ÿ␀-¼␀␀=”!␀␀␀␀␀|¼␀␀|¼␀␀|¼␀␀c␀␀␀ÿ␀␀ÿ␀ë¦␀␀8”!␀␀␀␀␀ãÅ␀␀áÅ␀␀âÅ␀␀?␀␀ÿ␀␀ÿ␀ì¦␀␀8”!␀␀␀␀