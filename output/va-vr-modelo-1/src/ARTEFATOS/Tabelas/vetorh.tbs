	END IF;
	/* eSocial */
END␀␀␀v␀␀␀␀␀␀␀␀␀ÔÔ␀␀…¬␀␀´␀	Ôÿ1␀␀␀␀␀°␀␀XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ1␀␀␀␀␀O␀t␀O␀nˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ1␀␀␀␀␀/%0.0.wˆ␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ôÿ1␀␀␀␀␀<IşEşEqCˆ␀êÿ␀␀ÿ␀y,Ì␀Ôÿ1␀␀␀␀␀]=À«␀␀À«␀␀)␀ˆ␀Æÿ␀␀ÀÎ␀␀␀Â-Š␀Ôÿ1␀␀␀␀␀_=Î«␀␀Î«␀␀nˆ␀Æÿ␀␀éÎ␀␀␀Å␀Ì␀Ôÿ1␀␀␀␀␀*>Ï␀Ï␀)␀␀Æÿ␀␀çÎ␀␀␀aw´␀Ôÿ1␀␀␀␀␀÷zõzõzr␀Æÿ␀␀fÎ␀␀␀Şw´␀Ôÿ1␀␀␀␀␀{{{r␀Æÿ␀␀fÎ␀␀␀ãw‹␀Ôÿ1␀␀␀␀␀ÇzÇzÇzz␀Æÿ␀␀ÿ␀w‹␀Ôÿ1␀␀␀␀␀×zjzjzz␀Æÿ␀␀ÿ␀␀ÃÔÿ1␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀*␀áÔÿ1␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀w,´␀Ôÿ1␀␀␀␀␀ì<LeLer␀Æÿ␀␀®Ò␀␀␀3,±␀Ôÿ1␀␀␀␀␀c<e(e(q␀Æÿ␀␀«Ò␀␀␀_Uˆ␀Ôÿ1␀␀␀␀␀:XêSW|␀␀ÿ␀␀ÿ␀␀␀ÕÔ␀␀␀ÖÔ␀␀␀␀0;1;2;3ÜÔ␀␀	SENIOR;0‰␀␀TRIGGER R038HES_SI AFTER INSERT ON R038HES

DECLARE
l_data_limite  DATE;
  l_data_atual   DATE;
  l_online       BOOLEAN;
  l_codfil       NUMBER;

  /* CURSOR c/ os registros gravados no R038HES_AUX */
  CURSOR c_r038hes_ins IS
    SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, CODESC, TIPOPE, STAHIS  FROM R038HES_AUX;

  TYPE t_r038HES_aux IS RECORD(
    NUMEMP   R038HES_AUX.NUMEMP%TYPE,
    TIPCOL   R038HES_AUX.TIPCOL%TYPE,
    NUMCAD   R038HES_AUX.NUMCAD%TYPE,
    DATALT   R038HES_AUX.DATALT%TYPE,
    CODESC   R038HES_AUX.CODESC%TYPE,
    TIPOPE   R038HES_AUX.TIPOPE%TYPE,
    STAHIS   R038HES_AUX.STAHIS%TYPE);
  
  l_r038HES_aux t_r038HES_aux;
BEGIN
  l_data_atual := CURDATE();
  l_data_limite := DATETimeAdd(DD,6,l_data_atual);

  /* Le Registro do CURSOR */
  FOREACH c_r038hes_ins INTO l_r038HES_aux.NUMEMP,
                             l_r038HES_aux.TIPCOL,
                             l_r038HES_aux.NUMCAD,
                             l_r038HES_aux.DATALT,
                             l_r038HES_aux.CODESC,
                             l_r038HES_aux.TIPOPE,
                             l_r038HES_aux.STAHIS
  LOOP
    /* Valida Datas */
    SP_VerOnLine(l_online OUT);
    IF (l_online = TRUE) AND (l_r038HES_aux.DATALT <= l_data_limite) THEN
        SP_AtuHor (l_r038hes_aux.NUMEMP, l_r038hes_aux.TIPCOL, l_r038hes_aux.NUMCAD,'');
    END IF;

    /* Verifica a filial do colaborador */
    BEGIN
       SELECT CODFIL INTO l_codfil FROM R038HFI WHERE
              NUMEMP = l_r038hes_aux.numemp AND TIPCOL = l_r038hes_aux.tipcol AND NUMCAD = l_r038hes_aux.numcad AND
              EMPATU = NUMEMP AND  CADATU = NUMCAD AND STAHIS = 1 AND
              DATALT = (SELECT MAX(DATALT) FROM R038HFI WHERE NUMEMP = l_r038hes_aux.numemp AND
                        TIPCOL = l_r038hes_aux.tipcol AND NUMCAD = l_r038hes_aux.numcad AND
                        EMPATU = NUMEMP AND CADATU = NUMCAD AND STAHIS = 1);
    EXCEPTION
        WHEN OTHERS THEN l_codfil := 0;
    END;

    /* Procedure que atualiza os creditos de acesso.*/
    IF (l_r038HES_aux.STAHIS = 1) THEN
        SP_GerCrc('I',2,l_r038HES_aux.NUMEMP,
                        l_r038HES_aux.TIPCOL,
                        l_r038HES_aux.NUMCAD,
                        l_r038HES_aux.DATALT,
                        l_r038HES_aux.NUMEMP,
                        l_r038HES_aux.NUMCAD,
                        l_codfil,
                        l_r038HES_aux.CODESC,
                        l_r038HES_aux.STAHIS);
    END IF;
    /* Atualiza o Quadro Efetivo - QL */
    QL_INCESCALA(l_r038HES_aux.NumEmp, l_r038HES_aux.TipCol, l_r038HES_aux.NumCad, l_r038HES_aux.DatAlt, l_r038HES_aux.CodEsc, l_r038HES_aux.DatAlt, l_r038HES_aux.CodEsc);
  END LOOP;

  /* Apaga Registro OLD em R038HES_AUX */
  BEGIN
    DELETE FROM R038HES_AUX;
    DROP_TEMP_TABLE R038HES_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ÙÔ␀␀		SENIOR;0¿4␀␀

TRIGGER R038HES_EI AFTER INSERT ON R038HES FOR EACH ROW

DECLARE
  l_datesc       DATE;
  l_comando_nulo BOOLEAN;
  l_data_limite  DATE;
  xCodEsc   R038HES.CODESC%TYPE;

  l_DatAdm         R034FUN.DATADM%TYPE;
  l_TemPenFut    BOOLEAN;
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_AltEmp         R038PEN.ALTEMP%TYPE;
  l_AltFil         R038PEN.ALTFIL%TYPE;
  l_AltLoc         R038PEN.ALTLOC%TYPE;
  l_AltCcu         R038PEN.ALTCCU%TYPE;
  l_AltCar         R038PEN.ALTCAR%TYPE;
  l_AltEsc         R038PEN.ALTESC%TYPE;
  l_AltDes         R038PEN.ALTDES%TYPE;
  l_SitChe         R038PEN.SITCHE%TYPE;
  l_SitUsu         R038PEN.SITUSU%TYPE;
  l_NesRev         R038PEN.NESREV%TYPE;
  l_EmpAtu         R038PEN.EMPATU%TYPE;
  l_CadAtu         R038PEN.CADATU%TYPE;
  l_ColChe       BOOLEAN;
  l_ColUsu       BOOLEAN;
  l_auxSitChe      R038PEN.SITCHE%TYPE;
  l_auxSitUsu      R038PEN.SITUSU%TYPE;
  l_AssTrfEsc      R000ASS.TRFESC%TYPE;
  l_UsaEscHor      R030EMP.ESCHOR%TYPE;
  l_Valor        VARCHAR2(2000);
  l_EncontrouMatricula BOOLEAN;
  l_EncontrouMatriculaSST BOOLEAN;
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_idtpes       CHAR(23);
  l_DataFechamentoTreinamento DATE;
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HES_AUX;
  
BEGIN
  BEGIN
    SELECT ESCHOR INTO l_UsaEscHor
      FROM R030EMP
     WHERE NUMEMP = :NEW.NUMEMP;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_UsaEscHor := 'N';
  END;

  BEGIN
    SELECT TRFESC INTO l_AssTrfEsc
      FROM R000ASS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_AssTrfEsc := 0;
  END;

  IF (l_AssTrfEsc = 2) AND (l_UsaEscHor = 'S') THEN
    /* Verifica se o colaborador está associado ao cadastro de chefia ou
       se o colaborador está associado com algum usuário */
    R038PEN_COLCHEFE(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_ColChe OUT, l_ColUsu OUT);

    /* Busca data de admissão do colaborador */
    BEGIN
      SELECT R034FUN.DATADM INTO l_DatAdm
        FROM R034FUN
       WHERE R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_DatAdm := DATETIME(31, 12, 1900, 0, 0, 0);
    END;

    /* Se o colaborador é chefe ou está associado a um usuário, e a data admissão for diferente da data
       do histórico gera pendência */
    IF ((l_ColChe = TRUE OR l_ColUsu = TRUE) AND (:NEW.DATALT <> l_DatAdm)) THEN
      /* Verifica se existe pendência numa data futura */
      R038PEN_TEMPENFUT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_TemPenFut OUT);

      /* se não existe pendência com data futura, verifica se existe pendência com data passada e situação não atendida */
      IF (l_TemPenFut = FALSE) THEN
        BEGIN
             SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU
               INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu
               FROM R038PEN
              WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                    R038PEN.TIPCOL = :NEW.TIPCOL AND
                    R038PEN.NUMCAD = :NEW.NUMCAD AND
                    R038PEN.DATTRF < :NEW.DATALT AND
                    ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
                     (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));
        EXCEPTION
             WHEN NO_DATA_FOUND THEN
                  l_NumEmp := 0;
                  l_TipCol := 0;
                  l_NumCad := 0;
                  l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
        END;

        /* Considera que sempre altera Turno na inclusão do histórico de Turno para criação da pendência */
        l_AltEsc := 'S';

        /* Verifica se deve gerar pendencia de chefia */
        IF (l_ColChe = TRUE) THEN
          l_SitChe := 1; /* Não Atendida */
        ELSE
          l_SitChe := 3; /* Sem necessidade de Alteração */
        END IF;

        /* Verifica se deve gerar pendencia de usuário */
        IF (l_ColUsu = TRUE) THEN
          l_SitUsu := 1; /* Não Atendida */
        ELSE
          l_SitUsu := 4; /* Sem necessidade de Alteração */
        END IF;

        /* Se existir uma pendência com data passada e situação 1 (Não atendida), esta
           será excluída e regerada com a nova data */
        IF (l_NumCad <> 0) THEN

          /* Insere nova pendência com base nos valores da pendência da data passada */
          BEGIN
            INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu);
          EXCEPTION
            WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
          END;

          /* Deleta pendência da data passada */
          R038PEN_DELPENPAS(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATALT);

        ELSE
          /* Verifica se existe pendência na mesma data de alteração */
          BEGIN
               SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, SITCHE, SITUSU INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_auxSitChe, l_auxSitUsu
                 FROM R038PEN
                WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                      R038PEN.TIPCOL = :NEW.TIPCOL AND
                      R038PEN.NUMCAD = :NEW.NUMCAD AND
                      R038PEN.DATTRF = :NEW.DATALT;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_NumEmp := 0;
                    l_TipCol := 0;
                    l_NumCad := 0;
                    l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
                    l_auxSitChe := 0;
                    l_auxSitUsu := 0;
          END;

          /* Se existir pendência na mesma data, atualiza a pendência */
          IF (l_NumCad <> 0) THEN

            IF ((l_auxSitChe = 1 OR l_auxSitChe = 3) AND
                (l_auxSitUsu = 1 OR l_auxSitUsu = 4)) THEN

              /* Atualiza pendência */
              BEGIN
                UPDATE R038PEN
                   SET ALTESC = l_AltEsc, SITCHE = l_SitChe, SITUSU = l_SitUsu
                 WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                       R038PEN.TIPCOL = :NEW.TIPCOL AND
                       R038PEN.NUMCAD = :NEW.NUMCAD AND
                       R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;

            ELSE
              /* Se a Situação for diferente de "Não atendida" ou "Sem necessidade de alteração", então
                 indica na pendência que necessita Revisão */
              BEGIN
                UPDATE R038PEN SET ALTESC = l_AltEsc, NESREV = 'S'
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            END IF;

          ELSE

            /* Insere nova pendência */
            BEGIN
              INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'N', 'N', 'N', 'N', 'N', l_AltEsc, 'N', l_SitChe, l_SitUsu, 'N', 0, 0);
            EXCEPTION
              WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
            END;

          END IF;
        END IF;
      END IF;

    END IF;
  END IF;

  IF  :NEW.STAHIS = 1 THEN
    BEGIN
      SELECT R034FUN.DATESC INTO l_datesc
        FROM R034FUN
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      l_comando_nulo:=TRUE;
    END;

    IF   (:NEW.DATALT >= l_datesc)
    OR   (l_datesc IS NULL) THEN
         UPDATE R034FUN
            SET CODESC = :NEW.CODESC,
                CODTMA = :NEW.CODTMA,
                TURINT = :NEW.TURINT,
                DATESC = :NEW.DATALT,
                HORBAS = :NEW.HORBAS,
                HORSAB = :NEW.HORSAB,
                HORSEM = :NEW.HORSEM,
                HORDSR = :NEW.HORDSR
          WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                R034FUN.NUMEMP = :NEW.NUMEMP AND
                R034FUN.NUMCAD = :NEW.NUMCAD;
    END IF;
  END IF;

  /* Se tiver Escala, inclui a Escala para a segunda Tabela. Senão inclui o Horário (Quando Empresa não usa Escala). */
  IF (:NEW.CODESC > 0) THEN
    xCodEsc := :NEW.CODESC;
  ELSE
    xCodEsc := :NEW.HORBAS;
  END IF;

  BEGIN
    INSERT INTO R038HES_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, CODESC, TIPOPE,STAHIS)
                     VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, xCodEsc, 1,:NEW.STAHIS);
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro no INSERT em R064HES_AUX.';
  END;

  BEGIN
    UPDATE R066APU SET DIAALT = 9
           WHERE NUMEMP = :NEW.NUMEMP AND
                 TIPCOL = :NEW.TIPCOL AND
                 NUMCAD = :NEW.NUMCAD AND
                 DATAPU >= :NEW.DATALT;
    EXCEPTION WHEN OTHERS THEN
      NULL;
  END;
  
  /*e-Social*/
  l_DataFechamentoTreinamento := DATETIME(31, 12, 1900, 0, 0, 0);
  l_EncontrouMatricula := TRUE;
  RH_NUMMAT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_EncontrouMatricula OUT, l_EncontrouMatriculaSST OUT, l_DataFechamentoTreinamento OUT);

  IF (l_EncontrouMatricula = TRUE) THEN
    l_Valor := '';
    SP_CONCATENAR_NUM('TIPCOL', :NEW.TIPCOL, l_Valor OUT);
    SP_CONCATENAR_NUM('NUMCAD', :NEW.NUMCAD, l_Valor OUT);
    SP_CONCATENAR_DAT('DATALT', :NEW.DATALT, l_Valor OUT);

    SP_ESOCIAL_1050(:NEW.NUMEMP, 'R038HES', 'I', l_Valor, '', 0, 'R038HES_EI');
  END IF;  
  /*e-Social*/
  
  /* Inicio - Geração de logs HistoricoEscala*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 75;     /* HistoricoEscala*/
  l_codtpa := 261;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HES_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HES_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODESC', CONVERT(NUMBER_TO_CHAR, :NEW.CODESC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTMA', CONVERT(NUMBER_TO_CHAR, :NEW.CODTMA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TURINT', CONVERT(NUMBER_TO_CHAR, :NEW.TURINT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORBAS', CONVERT(NUMBER_TO_CHAR, :NEW.HORBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORSAB', CONVERT(NUMBER_TO_CHAR, :NEW.HORSAB));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORSEM', CONVERT(NUMBER_TO_CHAR, :NEW.HORSEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORDSR', CONVERT(NUMBER_TO_CHAR, :NEW.HORDSR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAACC', CONVERT(NUMBER_TO_CHAR, :NEW.STAACC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEQP', CONVERT(NUMBER_TO_CHAR, :NEW.CODEQP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAT', CONVERT(NUMBER_TO_CHAR, :NEW.CODCAT));
      END;
  END IF; 
  /* Fim - Geração de logs HistoricoEscala*/

  SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
  SP_SAM_PENDENCIES(42, 2, l_idtpes);
END␀İÔ␀␀	SENIOR;0r␀␀

TRIGGER R038HES_SU AFTER UPDATE ON R038HES

DECLARE
l_data_limite  DATE;
  l_data_atual   DATE;
  l_online       BOOLEAN;
  l_codfil       NUMBER;

  /* CURSOR c/ os registros gravados no R038HES_AUX */
  CURSOR c_r038hes_upd IS
    SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, CODESC, TIPOPE, EMPOLD, TIPOLD, CADOLD, DATOLD, ESCOLD, STAHIS FROM R038HES_AUX;

  TYPE t_r038HES_aux IS RECORD(
    NUMEMP   R038HES_AUX.NUMEMP%TYPE,
    TIPCOL   R038HES_AUX.TIPCOL%TYPE,
    NUMCAD   R038HES_AUX.NUMCAD%TYPE,
    DATALT   R038HES_AUX.DATALT%TYPE,
    CODESC   R038HES_AUX.CODESC%TYPE,
    TIPOPE   R038HES_AUX.TIPOPE%TYPE,
    EMPOLD   R038HES_AUX.EMPOLD%TYPE,
    TIPOLD   R038HES_AUX.TIPOLD%TYPE,
    CADOLD   R038HES_AUX.CADOLD%TYPE,
    DATOLD   R038HES_AUX.DATOLD%TYPE,
    ESCOLD   R038HES_AUX.ESCOLD%TYPE,
    STAHIS   R038HES_AUX.STAHIS%TYPE);

  l_r038HES_aux t_r038HES_aux;
BEGIN
  l_data_atual := CURDATE();
  l_data_limite := DATETimeAdd(DD,6,l_data_atual);

  /* Le Registro do CURSOR */
  FOREACH c_r038hes_upd INTO l_r038HES_aux.NUMEMP,
                             l_r038HES_aux.TIPCOL,
                             l_r038HES_aux.NUMCAD,
                             l_r038HES_aux.DATALT,
                             l_r038HES_aux.CODESC,
                             l_r038HES_aux.TIPOPE,
                             l_r038HES_aux.EMPOLD,
                             l_r038HES_aux.TIPOLD,
                             l_r038HES_aux.CADOLD,
                             l_r038HES_aux.DATOLD,
                             l_r038HES_aux.ESCOLD,
                             l_r038HES_aux.STAHIS
  LOOP
     /* Valida Datas */
    SP_VerOnLine(l_online OUT);
    IF (l_online = TRUE) AND (l_r038HES_aux.DATALT <= l_data_limite) THEN
      SP_AtuHor (l_r038hes_aux.NUMEMP, l_r038hes_aux.TIPCOL, l_r038hes_aux.NUMCAD,'');
    END IF;

    /* Verifica a filial do colaborador */
    BEGIN
       SELECT CODFIL INTO l_codfil FROM R038HFI WHERE
              NUMEMP = l_r038hes_aux.numemp AND TIPCOL = l_r038hes_aux.tipcol AND NUMCAD = l_r038hes_aux.numcad AND
              EMPATU = NUMEMP AND  CADATU = NUMCAD AND STAHIS = 1 AND
              DATALT = (SELECT MAX(DATALT) FROM R038HFI WHERE NUMEMP = l_r038hes_aux.numemp AND
                        TIPCOL = l_r038hes_aux.tipcol AND NUMCAD = l_r038hes_aux.numcad AND
                        EMPATU = NUMEMP AND CADATU = NUMCAD AND STAHIS = 1);
    EXCEPTION
        WHEN OTHERS THEN l_codfil := 0;
    END;
    /* Procedure que atualiza os creditos de acesso.*/
    IF (l_r038HES_aux.STAHIS = 1) THEN
        SP_GerCrc('U',2,l_r038hes_aux.NUMEMP,
                        l_r038hes_aux.TIPCOL,
                        l_r038hes_aux.NUMCAD,
                        l_r038hes_aux.DATALT,
                        l_r038hes_aux.NUMEMP,
                        l_r038hes_aux.NUMCAD,
                        l_codfil,
                        l_r038hes_aux.CODESC,
                        l_r038hes_aux.STAHIS);
    END IF;
    /* Atualiza o Quadro Efetivo - QL */
    IF (l_r038hes_aux.CodEsc <> l_r038hes_aux.EscOld) THEN
      QL_EXCESCALA(l_r038hes_aux.EmpOld, l_r038hes_aux.TipOld, l_r038hes_aux.CadOld, l_r038hes_aux.DatOld, l_r038hes_aux.EscOld, l_r038hes_aux.DatAlt, l_r038hes_aux.CodEsc);

      QL_INCESCALA(l_r038hes_aux.NumEmp, l_r038hes_aux.TipCol, l_r038hes_aux.NumCad, l_r038hes_aux.DatAlt, l_r038hes_aux.CodEsc, l_r038hes_aux.DatAlt, l_r038hes_aux.CodEsc);
    END IF;
  END LOOP;

  /* Apaga Registro OLD em R038HES_AUX */
  BEGIN
    DELETE FROM R038HES_AUX;
    DROP_TEMP_TABLE R038HES_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ÚÔ␀␀		SENIOR;0ÁA␀␀

TRIGGER R038HES_EU AFTER UPDATE ON R038HES FOR EACH ROW

DECLARE
  l_datesc       DATE;
  l_comando_nulo BOOLEAN;
  l_data_limite  DATE;
  xOldCodEsc   R038HES.CODESC%TYPE;
  xNewCodEsc   R038HES.CODESC%TYPE;

  l_TemPenFut    BOOLEAN;
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_AltEmp         R038PEN.ALTEMP%TYPE;
  l_AltFil         R038PEN.ALTFIL%TYPE;
  l_AltLoc         R038PEN.ALTLOC%TYPE;
  l_AltCcu         R038PEN.ALTCCU%TYPE;
  l_AltCar         R038PEN.ALTCAR%TYPE;
  l_AltEsc         R038PEN.ALTESC%TYPE;
  l_AltDes         R038PEN.ALTDES%TYPE;
  l_SitChe         R038PEN.SITCHE%TYPE;
  l_SitUsu         R038PEN.SITUSU%TYPE;
  l_NesRev         R038PEN.NESREV%TYPE;
  l_EmpAtu         R038PEN.EMPATU%TYPE;
  l_CadAtu         R038PEN.CADATU%TYPE;
  l_ColChe       BOOLEAN;
  l_ColUsu       BOOLEAN;
  l_auxSitChe      R038PEN.SITCHE%TYPE;
  l_auxSitUsu      R038PEN.SITUSU%TYPE;
  l_AssTrfEsc      R000ASS.TRFESC%TYPE;
  l_UsaEscHor      R030EMP.ESCHOR%TYPE;
  l_Valor        VARCHAR2(2000);
  l_Valor2       VARCHAR2(2000);
  l_Valido       BOOLEAN;
  l_ValidoHorBas BOOLEAN;
  l_ValidoHorSab BOOLEAN;
  l_EncontrouMatricula BOOLEAN;
  l_EncontrouMatriculaSST BOOLEAN;
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_idtpes       CHAR(23);
  l_DesEso         R000ASS.DesEso%TYPE;
  l_DataFechamentoTreinamento DATE;
  l_AlterouEscala BOOLEAN;
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HES_AUX;
  
BEGIN
  l_Valor := '';
  BEGIN
    SELECT ESCHOR INTO l_UsaEscHor
      FROM R030EMP
     WHERE NUMEMP = :NEW.NUMEMP;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_UsaEscHor := 'N';
  END;

  BEGIN
    SELECT TRFESC, DesEso INTO l_AssTrfEsc, l_DesEso 
      FROM R000ASS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_AssTrfEsc := 0;
      l_DesEso    := 'N'; 
  END;

  IF (l_AssTrfEsc = 2) AND (l_UsaEscHor = 'S') THEN
    /* Verifica se o colaborador está associado ao cadastro de chefia ou
       se o colaborador está associado com algum usuário */
    R038PEN_COLCHEFE(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_ColChe OUT, l_ColUsu OUT);

    /* Se o colaborador é chefe ou está associado a um usuário gera pendência */
    IF (l_ColChe = TRUE OR l_ColUsu = TRUE) THEN
      /* Verifica se existe pendência numa data futura */
      R038PEN_TEMPENFUT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_TemPenFut OUT);

      /* se não existe pendência com data futura, verifica se existe pendência com data passada e situação não atendida */
      IF (l_TemPenFut = FALSE) THEN
        BEGIN
             SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU
               INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu
               FROM R038PEN
              WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                    R038PEN.TIPCOL = :NEW.TIPCOL AND
                    R038PEN.NUMCAD = :NEW.NUMCAD AND
                    R038PEN.DATTRF < :NEW.DATALT AND
                    ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
                     (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));
        EXCEPTION
             WHEN NO_DATA_FOUND THEN
                  l_NumEmp := 0;
                  l_TipCol := 0;
                  l_NumCad := 0;
                  l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
        END;

        /* Considera que sempre altera Turno na inclusão do histórico de Turno para criação da pendência */
        l_AltEsc := 'S';

        /* Verifica se deve gerar pendencia de chefia */
        IF (l_ColChe = TRUE) THEN
          l_SitChe := 1; /* Não Atendida */
        ELSE
          l_SitChe := 3; /* Sem necessidade de Alteração */
        END IF;

        /* Verifica se deve gerar pendencia de usuário */
        IF (l_ColUsu = TRUE) THEN
          l_SitUsu := 1; /* Não Atendida */
        ELSE
          l_SitUsu := 4; /* Sem necessidade de Alteração */
        END IF;

        /* Se existir uma pendência com data passada e situação 1 (Não atendida), esta
           será excluída e regerada com a nova data */
        IF (l_NumCad <> 0) THEN
          /* Insere nova pendência com base nos valores da pendência da data passada */
          BEGIN
            INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu);
          EXCEPTION
            WHEN OTHERS THEN
               RAISERROR 103 'Erro ao inserir registro na R038PEN.';
          END;

          /* Deleta pendência da data passada */
          R038PEN_DELPENPAS(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATALT);

        ELSE
          /* Verifica se existe pendência na mesma data de alteração */
          BEGIN
               SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, SITCHE, SITUSU INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_auxSitChe, l_auxSitUsu
                 FROM R038PEN
                WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                      R038PEN.TIPCOL = :NEW.TIPCOL AND
                      R038PEN.NUMCAD = :NEW.NUMCAD AND
                      R038PEN.DATTRF = :NEW.DATALT;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_NumEmp := 0;
                    l_TipCol := 0;
                    l_NumCad := 0;
                    l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
                    l_auxSitChe := 0;
                    l_auxSitUsu := 0;
          END;

          /* Se existir pendência na mesma data, atualiza a pendência */
          IF (l_NumCad <> 0) THEN

            IF ((l_auxSitChe = 1 OR l_auxSitChe = 3) AND
                (l_auxSitUsu = 1 OR l_auxSitUsu = 4)) THEN
              /* Atualiza pendência */
              BEGIN
                UPDATE R038PEN SET ALTESC = l_AltEsc, SITCHE = l_SitChe, SITUSU = l_SitUsu
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            ELSE
              /* Se a Situação for diferente de "Não atendida" ou "Sem necessidade de alteração", então
                 indica na pendência que necessita Revisão */
              BEGIN
                UPDATE R038PEN SET ALTESC = l_AltEsc, NESREV = 'S'
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            END IF;

          ELSE

            /* Insere nova pendência */
            BEGIN
              INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'N', 'N', 'N', 'N', 'N', l_AltEsc, 'N', l_SitChe, l_SitUsu, 'N', 0, 0);
            EXCEPTION
              WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
            END;

          END IF;
        END IF;
      END IF;

    END IF;
  END IF;


  IF  :NEW.STAHIS = 1 THEN
    BEGIN
      SELECT R034FUN.DATESC INTO l_datesc
        FROM R034FUN
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      l_comando_nulo:=TRUE;
    END;
    IF   (:NEW.datalt >= l_datesc)
    OR   (l_datesc IS NULL) THEN
         UPDATE R034FUN
            SET CODESC = :NEW.CODESC,
                CODTMA = :NEW.CODTMA,
                TURINT = :NEW.TURINT,
                DATESC = :NEW.DATALT,
                HORBAS = :NEW.HORBAS,
                HORSAB = :NEW.HORSAB,
                HORSEM = :NEW.HORSEM,
                HORDSR = :NEW.HORDSR
          WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                R034FUN.NUMEMP = :NEW.NUMEMP AND
                R034FUN.NUMCAD = :NEW.NUMCAD;
    END IF;
  END IF;

  /* Se tiver Escala, inclui a Escala para a segunda Tabela. Senão inclui o Horário (Quando Empresa não usa Escala). */
  IF (:OLD.CODESC > 0) THEN
    xOldCodEsc := :OLD.CODESC;
  ELSE
    xOldCodEsc := :OLD.HORBAS;
  END IF;

  IF (:NEW.CODESC > 0) THEN
    xNewCodEsc := :NEW.CODESC;
  ELSE
    xNewCodEsc := :NEW.HORBAS;
  END IF;

  /* Valida Datas */
  BEGIN
    INSERT INTO R038HES_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, CODESC, TIPOPE, EMPOLD, TIPOLD, CADOLD, DATOLD, ESCOLD, STAHIS)
                     VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, xNewCodEsc, 1, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, xOldCodEsc, :NEW.STAHIS);
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro no INSERT em R064HES_AUX.';
  END;

  /* Verifica se foi alterado algum campo que infuencia na apuração. Campo status nao influencia. */
  IF  (:NEW.CODESC <> :OLD.CODESC) OR (:NEW.CODTMA <> :OLD.CODTMA) OR (:NEW.TURINT <> :OLD.TURINT) THEN
    BEGIN
    UPDATE R066APU SET DIAALT = 9
      WHERE NUMEMP = :NEW.NUMEMP AND
            TIPCOL = :NEW.TIPCOL AND
            NUMCAD = :NEW.NUMCAD AND
            DATAPU >= :NEW.DATALT;
    EXCEPTION WHEN OTHERS THEN
      NULL;
    END;
  END IF;
  
  /*e-Social*/
  l_AlterouEscala := FALSE;
  l_DataFechamentoTreinamento := DATETIME(31, 12, 1900, 0, 0, 0);
  /*Se Faz o uso de Historico por Escala*/
  IF(l_UsaEscHor = 'S') THEN
  	SP_VALUPDATE_NUM(:OLD.CODESC, :NEW.CODESC, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
        l_AlterouEscala := TRUE;
    END IF;
  	SP_VALUPDATE_NUM(:OLD.CODTMA, :NEW.CODTMA, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
        l_AlterouEscala := TRUE;
    END IF;
  ELSE 
  /* Se Faz o uso de Historico por Horario */
  	SP_VALUPDATE_NUM(:OLD.HORBAS, :NEW.HORBAS, l_ValidoHorBas OUT);
  	SP_VALUPDATE_NUM(:OLD.HORSAB, :NEW.HORSAB, l_ValidoHorSab OUT);
  END IF;
  
  IF (l_DesEso = 'S') THEN
  	SP_VALUPDATE_DES(:OLD.DesSim, :NEW.DesSim, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
        l_AlterouEscala := TRUE;
    END IF;
  END IF;
  
  IF ((l_AlterouEscala = TRUE) OR (l_ValidoHorBas = TRUE) OR (l_ValidoHorSab = TRUE)) THEN    
    
    l_EncontrouMatricula := TRUE;
    RH_NUMMAT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_EncontrouMatricula OUT, l_EncontrouMatriculaSST OUT, l_DataFechamentoTreinamento OUT);

    IF (l_EncontrouMatricula = TRUE) THEN
      l_Valor := '';
      SP_CONCATENAR_NUM('TIPCOL', :NEW.TIPCOL, l_Valor OUT);
      SP_CONCATENAR_NUM('NUMCAD', :NEW.NUMCAD, l_Valor OUT);
      SP_CONCATENAR_DAT('DATALT', :NEW.DATALT, l_Valor OUT);
      
      l_Valor2 := '';
      SP_CONCATENAR_NUM('TIPCOL', :OLD.TIPCOL, l_Valor2 OUT);
      SP_CONCATENAR_NUM('NUMCAD', :OLD.NUMCAD, l_Valor2 OUT);
      SP_CONCATENAR_DAT('DATALT', :OLD.DATALT, l_Valor2 OUT);

      SP_ESOCIAL_1050(:NEW.NUMEMP, 'R038HES', 'A', l_Valor, l_Valor2, 0, 'R038HES_EU');
    END IF;

  END IF;  
  /*e-Social*/
  
  /* Inicio - Geração de logs HistoricoEscala*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 75;     /* HistoricoEscala*/
  l_codtpa := 262;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.CodEsc <> :NEW.CodEsc)
   OR (:OLD.CodTma <> :NEW.CodTma)
   OR (:OLD.TurInt <> :NEW.TurInt)
   OR (:OLD.HorBas <> :NEW.HorBas)
   OR (:OLD.HorSab <> :NEW.HorSab)
   OR (:OLD.HorSem <> :NEW.HorSem)
   OR (:OLD.HorDsr <> :NEW.HorDsr)
   OR (:OLD.StaAcc <> :NEW.StaAcc)
   OR (:OLD.StaHis <> :NEW.StaHis)
   OR (:OLD.CodEqp <> :NEW.CodEqp)
   OR (:OLD.CodCat <> :NEW.CodCat)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HES_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HES_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODESC', CONVERT(NUMBER_TO_CHAR, :OLD.CODESC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODESC', CONVERT(NUMBER_TO_CHAR, :NEW.CODESC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODTMA', CONVERT(NUMBER_TO_CHAR, :OLD.CODTMA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODTMA', CONVERT(NUMBER_TO_CHAR, :NEW.CODTMA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTURINT', CONVERT(NUMBER_TO_CHAR, :OLD.TURINT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTURINT', CONVERT(NUMBER_TO_CHAR, :NEW.TURINT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORBAS', CONVERT(NUMBER_TO_CHAR, :OLD.HORBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORBAS', CONVERT(NUMBER_TO_CHAR, :NEW.HORBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORSAB', CONVERT(NUMBER_TO_CHAR, :OLD.HORSAB));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORSAB', CONVERT(NUMBER_TO_CHAR, :NEW.HORSAB));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORSEM', CONVERT(NUMBER_TO_CHAR, :OLD.HORSEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORSEM', CONVERT(NUMBER_TO_CHAR, :NEW.HORSEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORDSR', CONVERT(NUMBER_TO_CHAR, :OLD.HORDSR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORDSR', CONVERT(NUMBER_TO_CHAR, :NEW.HORDSR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSTAACC', CONVERT(NUMBER_TO_CHAR, :OLD.STAACC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSTAACC', CONVERT(NUMBER_TO_CHAR, :NEW.STAACC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSTAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSTAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODEQP', CONVERT(NUMBER_TO_CHAR, :OLD.CODEQP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODEQP', CONVERT(NUMBER_TO_CHAR, :NEW.CODEQP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCAT', CONVERT(NUMBER_TO_CHAR, :OLD.CODCAT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCAT', CONVERT(NUMBER_TO_CHAR, :NEW.CODCAT));
      END;
    END IF; 
  END IF;  
   /* Fim - Geração de logs HistoricoEscala*/ 

  SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
  SP_SAM_PENDENCIES(42, 2, l_idtpes);
END␀ÛÔ␀␀	SENIOR;0Ì␀␀

TRIGGER R038HES_SD AFTER DELETE ON R038HES

DECLARE
l_codesc       	   R006ESC.CodEsc%TYPE;
  l_codtma       NUMBER(1);
  l_turint       NUMBER(9);
  l_datalt       DATE;
  l_horbas       NUMBER(4);
  l_horsab       NUMBER(4);
  l_horsem       NUMBER(10);
  l_hordsr       NUMBER(10);
  l_comando_nulo BOOLEAN;
  l_data_atual   DATE;
  l_data_limite  DATE;
  l_online       BOOLEAN;
  l_codfil       NUMBER;

  /* CURSOR c/ os registros gravados no R038HES_AUX */
  CURSOR c_r038hes_del IS
    SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, CODESC, TIPOPE, STAHIS FROM R038HES_AUX;

  TYPE t_r038HES_aux IS RECORD(
    NUMEMP   R038HES_AUX.NUMEMP%TYPE,
    TIPCOL   R038HES_AUX.TIPCOL%TYPE,
    NUMCAD   R038HES_AUX.NUMCAD%TYPE,
    DATALT   R038HES_AUX.DATALT%TYPE,
    CODESC   R038HES_AUX.CODESC%TYPE,
    TIPOPE   R038HES_AUX.TIPOPE%TYPE,
    STAHIS   R038HES_AUX.STAHIS%TYPE);

  l_r038HES_aux t_r038HES_aux;
BEGIN
  l_comando_nulo:=FALSE;
  l_data_atual := CURDATE();
  l_data_limite := DATETimeAdd(DD,6,l_data_atual);

  /* Le Registro do CURSOR */
  FOREACH c_r038hes_del INTO  l_r038HES_aux.NUMEMP,
                              l_r038HES_aux.TIPCOL,
                              l_r038HES_aux.NUMCAD,
                              l_r038HES_aux.DATALT,
                              l_r038HES_aux.CODESC,
                              l_r038HES_aux.TIPOPE,
                              l_r038HES_aux.STAHIS
  LOOP
    IF   l_r038hes_aux.STAHIS = 1 THEN
        /* Pega o historico anterior */
         BEGIN
           SELECT A.CODESC,A.CODTMA,A.TURINT,A.DATALT,A.HORBAS,A.HORSAB,A.HORSEM,A.HORDSR
           INTO l_codesc,l_codtma,l_turint,l_datalt,l_horbas,l_horsab,l_horsem,l_hordsr
           FROM R038HES A
           WHERE A.NUMEMP = l_r038hes_aux.NUMEMP
           AND   A.TIPCOL = l_r038hes_aux.TIPCOL
           AND   A.NUMCAD = l_r038hes_aux.NUMCAD
           AND   A.STAHIS = 1
           AND DATALT IN (SELECT MAX(DATALT) FROM R038HES
                          WHERE NUMEMP = l_r038hes_aux.NUMEMP
                          AND   TIPCOL = l_r038hes_aux.TIPCOL
                          AND   NUMCAD = l_r038hes_aux.NUMCAD
                          AND   STAHIS = 1);
         EXCEPTION
           WHEN TOO_MANY_ROWS THEN
             RAISERROR 103 'Erro em R038HES - TOO MANY ROWS';
           WHEN NO_DATA_FOUND THEN
             l_codesc:=0;
             l_codtma:=0;
             l_turint:=0;
             l_datalt:=DATETIME(31, 12, 1900, 0, 0, 0);
             l_horbas:=0;
             l_horsab:=0;
             l_horsem:=0;
             l_hordsr:=0;
           WHEN OTHERS THEN
             RAISERROR 103 'Erro no SELECT R038HES';
         END;

        /* Atualiza tabela de colaboradores */
         IF  l_codesc <> 0 THEN
             BEGIN
               UPDATE R034FUN
                  SET CODESC = l_codesc,
                      CODTMA = l_codtma,
                      TURINT = l_turint,
                      DATESC = l_datalt,
                      HORBAS = l_horbas,
                      HORSAB = l_horsab,
                      HORSEM = l_horsem,
                      HORDSR = l_hordsr
                WHERE R034FUN.TIPCOL = l_r038hes_aux.TIPCOL AND
                      R034FUN.NUMEMP = l_r038hes_aux.NUMEMP AND
                      R034FUN.NUMCAD = l_r038hes_aux.NUMCAD;
             EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro Na Atualização do R034FUN';
             END;
         /* Se l_CodEsc = 0, ou seja se estiver deletando o último histórico atualiza somente o DatEsc */
         /* ISto é usado quando se altera a data de admissão do colaborador */
         ELSE
         BEGIN
           UPDATE R034FUN
              SET DATESC = DATETIME(31,12,1900,0,0,0)
            WHERE R034FUN.TIPCOL = l_r038hes_aux.TIPCOL AND
                  R034FUN.NUMEMP = l_r038hes_aux.NUMEMP AND
                  R034FUN.NUMCAD = l_r038hes_aux.NUMCAD;
           EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro Na Atualização do R034FUN';
         END;
         END IF;          
    ELSE
      l_datalt:=l_r038hes_aux.DATALT;
    END IF;

    SP_VerOnLine(l_online OUT);
    IF (l_online = TRUE) AND (l_r038hes_aux.TIPOPE = 1) THEN
      /* Valida Datas */
      IF (l_datalt <= l_data_limite) THEN
        SP_AtuHor (l_r038hes_aux.NUMEMP, l_r038hes_aux.TIPCOL, l_r038hes_aux.NUMCAD,'');
      END IF;
    END IF;

    /* Verifica a filial do colaborador */
    BEGIN
      SELECT CODFIL INTO l_codfil FROM R038HFI WHERE
              NUMEMP = l_r038hes_aux.numemp AND TIPCOL = l_r038hes_aux.tipcol AND NUMCAD = l_r038hes_aux.numcad AND
              EMPATU = NUMEMP AND  CADATU = NUMCAD AND STAHIS = 1 AND
              DATALT = (SELECT MAX(DATALT) FROM R038HFI WHERE NUMEMP = l_r038hes_aux.numemp AND
                        TIPCOL = l_r038hes_aux.tipcol AND NUMCAD = l_r038hes_aux.numcad AND
                        EMPATU = NUMEMP AND CADATU = NUMCAD AND STAHIS = 1);
    EXCEPTION
        WHEN OTHERS THEN l_codfil := 0;
    END;

    /* Procedure que atualiza os creditos de acesso.*/
    IF (l_r038HES_aux.STAHIS = 1) THEN
        SP_GerCrc('D',2,l_r038hes_aux.NUMEMP,
                        l_r038hes_aux.TIPCOL,
                        l_r038hes_aux.NUMCAD,
                        l_r038hes_aux.DATALT,
                        l_r038hes_aux.NUMEMP,
                        l_r038hes_aux.NUMCAD,
                        l_codfil,
                        l_r038hes_aux.CODESC,
                        l_r038hes_aux.STAHIS);
    END IF;
    IF l_r038hes_aux.TIPOPE = 1 THEN
      /* Atualiza o Quadro Efetivo - QL */
      QL_EXCESCALA(l_r038HES_aux.NumEmp, l_r038HES_aux.TipCol, l_r038HES_aux.NumCad, l_r038HES_aux.DatAlt, l_r038HES_aux.CodEsc, l_r038HES_aux.DatAlt, 0);
    END IF;
  END LOOP;

  /* Apaga Registro OLD em R038HES_AUX */
  BEGIN
    DELETE FROM R038HES_AUX;
    DROP_TEMP_TABLE R038HES_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ØÔ␀␀		SENIOR;0@!␀␀

TRIGGER R038HES_ED AFTER DELETE ON R038HES FOR EACH ROW

DECLARE
  l_codesc         R006ESC.CODESC%TYPE;
  l_codtma       NUMBER(1);
  l_turint       NUMBER(9);
  l_datesc       DATE;
  l_horbas       NUMBER(4);
  l_horsab       NUMBER(4);
  l_horsem       NUMBER(10);
  l_hordsr       NUMBER(10);
  l_comando_nulo BOOLEAN;
  xCodEsc 		   R038HES.CODESC%TYPE;

  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);  
  l_EncontrouMatricula BOOLEAN;
  l_EncontrouMatriculaSST BOOLEAN;
  l_Valor        VARCHAR2(2000);
  l_idtpes       CHAR(23);
  l_DataFechamentoTreinamento DATE;
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HES_AUX;
  
BEGIN
  /* Verifica se existe pendência gerada exclusivamente pelo histórico de Turno para o
     cadastro de origem que está sendo excluído */
  BEGIN
       SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf
         FROM R038PEN
        WHERE R038PEN.NUMEMP = :OLD.NUMEMP AND
              R038PEN.TIPCOL = :OLD.TIPCOL AND
              R038PEN.NUMCAD = :OLD.NUMCAD AND
              R038PEN.DATTRF = :OLD.DATALT AND
              R038PEN.ALTEMP = 'N' AND
              R038PEN.ALTFIL = 'N' AND
              R038PEN.ALTLOC = 'N' AND
              R038PEN.ALTCCU = 'N' AND
              R038PEN.ALTCAR = 'N' AND
              R038PEN.ALTESC = 'S' AND
              R038PEN.ALTDES = 'N';
  EXCEPTION
       WHEN NO_DATA_FOUND THEN
            l_NumEmp := 0;
            l_TipCol := 0;
            l_NumCad := 0;
            l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
  END;

  /* Se existe pendência exclusiva do histórico de Turno para o cadastro de origem
     verifica se já foi atendida para então excluir */
  IF (l_NumCad <> 0) THEN
    R038PEN_DELPEN(l_NumEmp, l_TipCol, l_NumCad, l_DatTrf);
  ELSE
    /* Atualiza pendência do Turno com 'N' */
    BEGIN
      UPDATE R038PEN SET ALTESC = 'N'
               WHERE R038PEN.NUMEMP = :OLD.NUMEMP AND
                     R038PEN.TIPCOL = :OLD.TIPCOL AND
                     R038PEN.NUMCAD = :OLD.NUMCAD AND
                     R038PEN.DATTRF = :OLD.DATALT;
    EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no update da Tabela R038PEN.';
    END;
  END IF;

  IF :OLD.STAHIS = 1 THEN

     l_comando_nulo:=FALSE;
      BEGIN
        SELECT R034FUN.CODESC, R034FUN.CODTMA, R034FUN.TURINT,
               R034FUN.DATESC, R034FUN.HORBAS, R034FUN.HORSAB,
               R034FUN.HORSEM, R034FUN.HORDSR
          INTO l_codesc,l_codtma,l_turint,l_datesc,l_horbas,l_horsab,l_horsem,l_hordsr
          FROM R034FUN
         WHERE R034FUN.TIPCOL = :OLD.TIPCOL AND
               R034FUN.NUMEMP = :OLD.NUMEMP AND
               R034FUN.NUMCAD = :OLD.NUMCAD;
      EXCEPTION WHEN OTHERS THEN
          l_comando_nulo:=TRUE;
      END;
      IF   (l_comando_nulo = FALSE) THEN
           IF   ((:OLD.CODESC = l_codesc) OR ((:OLD.CODESC IS NULL) AND (l_codesc IS NULL)))
           AND  ((:OLD.CODTMA = l_codtma) OR ((:OLD.CODTMA IS NULL) AND (l_codtma IS NULL)))
           AND  ((:OLD.TURINT = l_turint) OR ((:OLD.TURINT IS NULL) AND (l_turint IS NULL)))
           AND  ((:OLD.DATALT = l_datesc) OR ((:OLD.DATALT IS NULL) AND (l_datesc IS NULL)))
           AND  ((:OLD.HORBAS = l_horbas) OR ((:OLD.HORBAS IS NULL) AND (l_horbas IS NULL)))
           AND  ((:OLD.HORSAB = l_horsab) OR ((:OLD.HORSAB IS NULL) AND (l_horsab IS NULL)))
           AND  ((:OLD.HORSEM = l_horsem) OR ((:OLD.HORSEM IS NULL) AND (l_horsem IS NULL)))
           AND  ((:OLD.HORDSR = l_hordsr) OR ((:OLD.HORDSR IS NULL) AND (l_hordsr IS NULL))) THEN
                BEGIN
                  /* Insere Registro Old */
                  INSERT INTO R038HES_AUX (TIPOPE,NUMEMP,TIPCOL,NUMCAD,DATALT)
                  VALUES (2,:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.DATALT);
                EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no INSERT em R038HES_AUX.';
                END;
           END IF;
      END IF;
  END IF;

    /* Se tiver Escala, inclui a Escala para a segunda Tabela. Senão inclui o Horário (Quando Empresa não usa Escala). */
    IF (:OLD.CODESC > 0) THEN
      xCodEsc := :OLD.CODESC;
    ELSE
      xCodEsc := :OLD.HORBAS;
    END IF;

    BEGIN
      INSERT INTO R038HES_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, CODESC, TIPOPE, STAHIS)
                       VALUES (:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, xCodEsc, 1, :OLD.STAHIS);
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no INSERT em R038HES_AUX.';
    END;

  BEGIN
    UPDATE R066APU SET DIAALT = 9
           WHERE NUMEMP = :OLD.NUMEMP AND
                 TIPCOL = :OLD.TIPCOL AND
                 NUMCAD = :OLD.NUMCAD AND
                 DATAPU >= :OLD.DATALT;
    EXCEPTION WHEN OTHERS THEN
      NULL;
  END;
  
  /*e-Social*/
  l_DataFechamentoTreinamento := DATETIME(31, 12, 1900, 0, 0, 0);
  l_EncontrouMatricula := TRUE;
  RH_NUMMAT(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_EncontrouMatricula OUT, l_EncontrouMatriculaSST OUT, l_DataFechamentoTreinamento OUT);

  IF (l_EncontrouMatricula = TRUE) THEN
    l_Valor := '';
    SP_CONCATENAR_NUM('TIPCOL', :OLD.TIPCOL, l_Valor OUT);
    SP_CONCATENAR_NUM('NUMCAD', :OLD.NUMCAD, l_Valor OUT);
    SP_CONCATENAR_DAT('DATALT', :OLD.DATALT, l_Valor OUT);

    SP_ESOCIAL_1050(:OLD.NUMEMP, 'R038HES', 'E', l_Valor, '', 0, 'R038HES_ED');
  END IF;  
  /*e-Social*/
  
  /* Inicio - Geração de logs HistoricoEscala*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 75;     /* HistoricoEscala*/
  l_codtpa := 261;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HES_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HES_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODESC', CONVERT(NUMBER_TO_CHAR, :OLD.CODESC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTMA', CONVERT(NUMBER_TO_CHAR, :OLD.CODTMA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TURINT', CONVERT(NUMBER_TO_CHAR, :OLD.TURINT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORBAS', CONVERT(NUMBER_TO_CHAR, :OLD.HORBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORSAB', CONVERT(NUMBER_TO_CHAR, :OLD.HORSAB));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORSEM', CONVERT(NUMBER_TO_CHAR, :OLD.HORSEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORDSR', CONVERT(NUMBER_TO_CHAR, :OLD.HORDSR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAACC', CONVERT(NUMBER_TO_CHAR, :OLD.STAACC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEQP', CONVERT(NUMBER_TO_CHAR, :OLD.CODEQP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAT', CONVERT(NUMBER_TO_CHAR, :OLD.CODCAT));
      END;
  END IF;   
  /* Fim - Geração de logs HistoricoEscala*/

  SP_RETIDTPES(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, 0, '', '', '', l_idtpes OUT);
  SP_SAM_PENDENCIES(42, 2, l_idtpes);
END␀␀␀„v␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀×Ô␀␀…¬␀␀´␀Ôÿ1␀␀␀␀␀°␀␀XbXbr␀Æÿ␀␀ÿ␀.␀tÔÿ1␀␀␀␀␀O␀t␀O␀nˆ␀Æÿ␀␀ÿ␀c¬␀␀Ì␀Ôÿ1␀␀␀␀␀/%0.0.wˆ␀Æÿ␀␀ÿ␀mDÑ␀Ôÿ1␀␀␀␀␀<IşEşEqCˆ␀êÿ␀␀ÿ␀y,Ì␀Ôÿ1␀␀␀␀␀]=À«␀␀À«␀␀)␀ˆ␀Æÿ␀␀ÀÎ␀␀␀Â-Š␀Ôÿ1␀␀␀␀␀_=Î«␀␀Î«␀␀nˆ␀Æÿ␀␀ÿ␀Å␀Ì␀Ôÿ1␀␀␀␀␀*>Ï␀Ï␀)␀␀Æÿ␀␀çÎ␀␀␀aw´␀Ôÿ1␀␀␀␀␀÷zõzõzr␀Æÿ␀␀ÿ␀Şw´␀Ôÿ1␀␀␀␀␀{{{r␀Æÿ␀␀ÿ␀ãw‹␀Ôÿ1␀␀␀␀␀ÇzÇzÇzz␀Æÿ␀␀ÿ␀w‹␀Ôÿ1␀␀␀␀␀×zjzjzz␀Æÿ␀␀ÿ␀␀ÃÔÿ1␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀*␀áÔÿ1␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀à␀Š␀Ôÿ1␀␀␀␀␀²␀ÿÿn␀Æÿ␀␀ÿ␀␀b´␀Ôÿ1␀␀␀␀␀°␀␀XbXbr␀Æÿ␀␀ÿ␀Û␀tÔÿ1␀␀␀␀␀O␀t␀O␀nˆ␀Æÿ␀␀ÿ␀Z$Ì␀Ôÿ1␀␀␀␀␀/%0.0.wˆ␀Æÿ␀␀ÿ␀MEÑ␀Ôÿ1␀␀␀␀␀<IşEşEqCˆ␀êÿ␀␀ÿ␀–eÌ␀Ôÿ1␀␀␀␀␀]=À«␀␀À«␀␀)␀ˆ␀Æÿ␀␀ÀÎ␀␀␀w,´␀Ôÿ1␀␀␀␀␀ì<LeLer␀Æÿ␀␀ÿ␀3,´␀Ôÿ1␀␀␀␀␀c<e(e(<)␀␀Æÿ␀␀ÿ␀␀␀␀␀␀	␀…v␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ŞÔ␀␀…¬␀␀´␀	Ôÿ1␀␀␀␀␀‘<XbXbrˆ␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ1␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ1␀␀␀␀␀.%€$0.w	ˆ␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ôÿ1␀␀␀␀␀FJ·H·HqCˆ␀êÿ␀␀ÿ␀×DÑ␀Ôÿ1␀␀␀␀␀=JsHsHqC␀êÿ␀␀ÿ␀Š¬␀␀Ôÿ␀␀␀␀␀Bo@o@a␀␀␀ÿ␀␀ÿ␀Õ,Ç␀Ôÿ?␀␀␀␀␀ƒ—␀␀‚—␀␀‚—␀␀z␀␀Æÿ␀␀ÖÒ␀␀␀j¬␀␀¢␀Ôÿ1␀␀␀␀␀ê"É"É";)␀¯‡␀Æÿ␀␀ÿ␀Ø)Ôÿ1␀␀␀␀␀ê"É"É"£␀␀ÿ␀␀O"␀,¼␀Ôÿ1␀␀␀␀␀Ğ?ääv␀Æÿ␀␀ß␀␀000000sï␀␀(Ôÿ1␀␀␀␀␀
ğ␀␀Òï␀␀Ôï␀␀1␀␀ÿ␀␀ÿ␀fTÔÿ1␀␀␀␀␀Ï␀Â␀Ã␀p␀␀␀ÿ␀␀ÿ␀Ùí␀␀=€␀␀␀␀␀␀‚.†î␀␀†î␀␀c␀␀␀ÿ␀␀ÿ␀x␀Ä€␀␀␀␀␀␀.␀Ã␀Ã␀n␀Æÿ␀␀ÿ␀›§␀␀vÔÿ1␀␀␀␀␀³©␀␀³©␀␀³©␀␀n␀␀ÿ␀␀ÿ␀Ğ[±␀€␀␀␀␀␀␀¢Ì␀␀^␀b␀O)␀␀␀Æÿ␀␀ÿ␀¸d=€␀␀␀␀␀␀;␀␀eec␀␀␀ÿ␀␀ÿ␀{,Ôÿ␀␀␀␀␀ BíBíBW␀␀␀ÿ␀␀ÿ␀·ò␀␀~Ôÿ␀␀␀␀␀Ğó␀␀´ó␀␀¸ó␀␀c␀␀␀ÿ␀␀ÿ␀␀ñ€␀␀␀␀␀␀İó␀␀àó␀␀àó␀␀n␀Æÿ␀␀ÿ␀¬EÑ␀€␀␀␀␀␀␀GM½HEMqC␀êÿ␀␀ÿ␀␀␀␀0;1;2;3àÔ␀␀		SENIOR;0Û␀␀TRIGGER R038HEX_EI AFTER INSERT ON R038HEX FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataInicioS2221 DATE;
	l_Valor VARCHAR2(2000);
	l_temAud BOOLEAN;
    l_codRPA NUMBER(15);
    l_codSistema NUMBER(2);
    l_codcpa NUMBER(4);
    l_codtpa NUMBER(4);
    l_datTemp VARCHAR(10);
BEGIN
	IF (:NEW.EnvEso = 'S') THEN
		l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
		
		SP_DATINI_S2221(:NEW.NumEmp, l_DataInicioS2221 OUT);
		IF (l_DataInicioS2221 > l_DataZero) THEN
			IF (:NEW.DatExm >= l_DataInicioS2221) THEN
				l_Valor := '';
				SP_CONCATENAR_DAT('DATALT', :NEW.DatAlt, l_Valor OUT);
				SP_CONCATENAR_DAT('DATREA', :NEW.DatExm, l_Valor OUT);
				SP_E_SOCIAL_SM('S-2221', 'R038HEX', 'N', 'I', NULL, NULL, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_Valor, '', 0, NULL, :NEW.DatExm, 0, 'R038HEX_EI');
			END IF;
		END IF;
	END IF;

  l_codSistema:= 1;
  l_codcpa := 147; 
  l_codtpa := 425;

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HEX_AI', '');

    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR,:NEW.TIPCOL));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR,:NEW.NUMCAD));
      SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R038HEX_AI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
      SP_DATSTR(:NEW.DATEXM, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATEXM', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEXA', :NEW.NUMEXA);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODLAB', CONVERT(NUMBER_TO_CHAR,:NEW.CODLAB));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCGC', CONVERT(NUMBER_TO_CHAR,:NEW.NUMCGC));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR,:NEW.CODATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REGCON', :NEW.REGCON);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCON', :NEW.ESTCON);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RECEXA', :NEW.RECEXA);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPEXM', CONVERT(NUMBER_TO_CHAR,:NEW.TIPEXM));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMMED', :NEW.NOMMED);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAVAL', CONVERT(NUMBER_TO_CHAR,:NEW.DIAVAL));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENVESO', :NEW.ENVESO);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODESO', :NEW.CODESO);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RESEXA', :NEW.RESEXA);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SORTEA', CONVERT(NUMBER_TO_CHAR,:NEW.SORTEA));
      SP_DATSTR(:NEW.DATSOR, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATSOR', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CFJINS', :NEW.CFJINS);
    END;
  END IF;
END␀áÔ␀␀		SENIOR;0¾!␀␀

TRIGGER R038HEX_EU AFTER UPDATE ON R038HEX FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataInicioS2221 DATE;
	l_AlterouCampo BOOLEAN;
	l_AlterouRegistro BOOLEAN;
	l_AlterouEnvEsoParaNao BOOLEAN;
	l_Valor VARCHAR2(2000);
	l_temAud BOOLEAN;
    l_codRPA NUMBER(15);
    l_codSistema NUMBER(2);
    l_codcpa NUMBER(4);
    l_codtpa NUMBER(4);
    l_datTemp VARCHAR(10);
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	
	IF ((:OLD.EnvEso = 'S') OR (:NEW.EnvEso = 'S')) THEN
		SP_DATINI_S2221(:NEW.NumEmp, l_DataInicioS2221 OUT);
		IF (l_DataInicioS2221 > l_DataZero) THEN
			IF (:NEW.DatExm >= l_DataInicioS2221) THEN
				l_AlterouEnvEsoParaNao := FALSE;
				IF (:OLD.EnvEso = 'S') AND (:NEW.EnvEso <> 'S') THEN
					l_AlterouEnvEsoParaNao := TRUE;
				END IF;
	    		
				IF (l_AlterouEnvEsoParaNao = TRUE) THEN
					l_Valor := '';
					SP_CONCATENAR_DES('LAYOUT', 'S-2221', l_Valor OUT);
					SP_CONCATENAR_DAT('DATALT', :NEW.DatAlt, l_Valor OUT);
					SP_CONCATENAR_DAT('DATREA', :NEW.DatExm, l_Valor OUT);
					SP_E_SOCIAL_SM('S-3000', 'R038HEX', 'N', 'E', NULL, NULL, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_Valor, '', 0, NULL, :NEW.DatExm, 0, 'R038HEX_EU');
				ELSE
					l_AlterouRegistro := FALSE;
				
					IF (:NEW.EnvEso = 'S') THEN
						SP_VALUPDATE_NUM(:OLD.NumCgc, :NEW.NumCgc, l_AlterouCampo OUT);
						IF (l_AlterouCampo = TRUE) THEN
							l_AlterouRegistro := TRUE;
						END IF;
						
						SP_VALUPDATE_DES(:OLD.CodEso, :NEW.CodEso, l_AlterouCampo OUT);
						IF (l_AlterouCampo = TRUE) THEN
							l_AlterouRegistro := TRUE;
						END IF;
						
						SP_VALUPDATE_DES(:OLD.NomMed, :NEW.NomMed, l_AlterouCampo OUT);
						IF (l_AlterouCampo = TRUE) THEN
							l_AlterouRegistro := TRUE;
						END IF;
						
						SP_VALUPDATE_DES(:OLD.RegCon, :NEW.RegCon, l_AlterouCampo OUT);
						IF (l_AlterouCampo = TRUE) THEN
							l_AlterouRegistro := TRUE;
						END IF;
						
						SP_VALUPDATE_DES(:OLD.EstCon, :NEW.EstCon, l_AlterouCampo OUT);
						IF (l_AlterouCampo = TRUE) THEN
							l_AlterouRegistro := TRUE;
						END IF;
						
						SP_VALUPDATE_DAT(:OLD.DatExm, :NEW.DatExm, l_AlterouCampo OUT);
						IF (l_AlterouCampo = TRUE)THEN
							l_AlterouRegistro := TRUE;
						END IF;

						IF (:OLD.EnvEso <> 'S' AND :NEW.EnvEso = 'S') THEN
							l_AlterouRegistro := TRUE;
						END IF;
						
						IF (l_AlterouRegistro = TRUE) THEN
							l_Valor := '';
							SP_CONCATENAR_DAT('DATALT', :NEW.DatAlt, l_Valor OUT);
							SP_CONCATENAR_DAT('DATREA', :NEW.DatExm, l_Valor OUT);
							SP_E_SOCIAL_SM('S-2221', 'R038HEX', 'N', 'A', NULL, NULL, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_Valor, '', 0, NULL, :NEW.DatExm, 0, 'R038HEX_EU');
						END IF;
					END IF;
				END IF;
			END IF;
		END IF;
	END IF;
	IF (
  	:OLD.DATEXM <>:NEW.DATEXM OR
  	:OLD.NUMEXA <>:NEW.NUMEXA OR
  	:OLD.CODLAB <>:NEW.CODLAB OR
  	:OLD.NUMCGC <>:NEW.NUMCGC OR
  	:OLD.CODATE <>:NEW.CODATE OR
  	:OLD.REGCON <>:NEW.REGCON OR
  	:OLD.ESTCON <>:NEW.ESTCON OR
  	:OLD.RECEXA <>:NEW.RECEXA OR
  	:OLD.TIPEXM <>:NEW.TIPEXM OR
  	:OLD.NOMMED <>:NEW.NOMMED OR
  	:OLD.DIAVAL <>:NEW.DIAVAL OR
  	:OLD.ENVESO <>:NEW.ENVESO OR
  	:OLD.CODESO <>:NEW.CODESO OR
  	:OLD.RESEXA <>:NEW.RESEXA OR
  	:OLD.SORTEA <>:NEW.SORTEA OR
  	:OLD.DATSOR <>:NEW.DATSOR OR
  	:OLD.CFJINS <>:NEW.CFJINS
  ) THEN
    l_codSistema:= 1;
    l_codcpa:= 147;  /* Código da categoria de auditoria - EXAMES TOXICOLÓGICOS*/
    l_codtpa:= 426;  /* Código do tipo de auditoria - Alteração*/

    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HEX_EU', '');

      /* Insere os campos chave na tabela de auditoria R995PRC*/
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR,:OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR,:OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HEX_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      /* Insere os valores dos campos na tabela de auditoria R995PRT*/
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
        SP_DATSTR(:OLD.DATEXM, 'DD/MM/YYYY', l_datTemp OUT);
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATEXM', l_datTemp);
      	SP_DATSTR(:NEW.DATEXM, 'DD/MM/YYYY', l_datTemp OUT);
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATEXM', l_datTemp);
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMEXA', :OLD.NUMEXA);
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMEXA', :NEW.NUMEXA);
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODLAB', CONVERT(NUMBER_TO_CHAR,:OLD.CODLAB));
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODLAB', CONVERT(NUMBER_TO_CHAR,:NEW.CODLAB));
