GROUP BY
  NUMEMP,
  TIPCOL,
  NUMCAD,
  SISCES␀␀ÿf␀#´␀	␀␀␀␀␀␀␀␀ô<},µfq␀Æÿ␀␀%Û␀␀␀^␀¸	␀␀␀␀␀␀␀␀´␀m␀t␀n␀Æÿ␀␀ÿ␀TCÑ␀	␀␀␀␀␀␀␀␀=I1FÙEqC␀êÿ␀␀ÿ␀`CÑ␀␀␀␀␀␀␀␀␀ÉHµEÉHqC␀␀êÿ␀␀ÿ␀s"b␀␀␀␀␀␀␀␀¸*­*­*g␀␀ÿ␀␀ÿ␀›÷␀␀´␀	␀␀␀␀␀␀␀␀úş␀␀ü␀␀xş␀␀r␀Æÿ␀␀ÿ␀­¥␀␀b␀␀␀␀␀␀␀␀Ü®␀␀±®␀␀±®␀␀g␀␀ÿ␀␀ÿ␀÷␀␀´␀	␀␀␀␀␀␀␀␀šÿ␀␀hü␀␀Ìş␀␀r␀Æÿ␀␀ÿ␀+␀›␀␀␀␀␀␀␀␀␀aú␀␀áù␀␀áù␀␀j)␀␀Æÿ␀␀ÿ␀Õ#›␀␀␀␀␀␀␀␀␀Ï0Ç0Ç0j)␀␀Æÿ␀␀ÿ␀␀␀␀ SELECT A.CODEST CODEST, A.TIPEST TIPEST, A.DATALT DATINI, DATETIMEADD(DD, -1, B.DATALT) DATTER, 
       C.CLASAL CLASAL, C.SEQCLA SEQCLA, D.NIVSAL NIVSAL, D.SEQNIV SEQNIV, D.VALSAL VALSAL, D.CPLSAL CPLSAL
  FROM R076EST A, R076EST B, R076CLA C, R076NIV D
 WHERE B.CODEST = A.CODEST AND B.TIPEST = A.TIPEST AND
       B.DATALT = (SELECT MIN(DATALT) FROM R076EST WHERE DATALT > A.DATALT AND 
                   R076EST.CODEST = A.CODEST AND R076EST.TIPEST = A.TIPEST) AND 
       A.CODEST = C.CODEST AND
       A.DATALT = C.DATALT AND
       A.TIPEST = C.TIPEST AND
       C.CODEST = D.CODEST AND
       C.TIPEST = D.TIPEST AND
       C.DATALT = D.DATALT AND
       C.SEQCLA = D.SEQCLA
UNION 
(
SELECT A.CODEST CODEST, A.TIPEST TIPEST, A.DATALT DATINI,
DATETIME(04,06,2080,00,00,00) AS DATTER,
  C.CLASAL CLASAL, C.SEQCLA SEQCLA, D.NIVSAL NIVSAL, D.SEQNIV SEQNIV, D.VALSAL VALSAL, D.CPLSAL CPLSAL
  FROM R076EST A, R076CLA C, R076NIV D
 WHERE A.DATALT = (SELECT MAX(DATALT) FROM R076EST E
      WHERE E.CODEST=A.CODEST 
      AND E.TIPEST=A.TIPEST) AND 
       A.CODEST = C.CODEST AND
       A.DATALT = C.DATALT AND
