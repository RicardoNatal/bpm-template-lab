DECLARE
l_online  BOOLEAN;
    l_numcra  NUMBER(12);
    l_cravei  NUMBER(12);
    l_datzer  DATE;
    l_datAtu  DATE;
    l_horAtu  NUMBER;
    l_datfim  DATE;    
    l_horfim  NUMBER;   
BEGIN
	l_datAtu := CURDATE();
	l_horAtu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
	l_datzer := '31/12/1900,00:00:00';
	l_numcra := 0;
	
	l_datfim := '31/12/1900,00:00:00';
	l_horfim := 0;
	
	SP_VERONLINE(l_online OUT);
	IF (l_online = TRUE) THEN
	    /* Verifica se possui histórico de crachás */
	    BEGIN
		    SELECT NUMCRA, DATFIM, HORFIM INTO l_numcra, l_datfim, l_horfim FROM R070HCH
		        WHERE NUMEMP = :NEW.NUMEMP AND NUMCAD = :NEW.NUMCAD AND
                    ((DATINI < l_datAtu) OR (DATINI = l_datAtu AND HORINI <= l_horAtu)) AND
                     (DATFIM > l_datAtu OR DATFIM = l_datZer OR (DATFIM = l_datAtu AND HORFIM > l_horAtu));		    
		EXCEPTION
            WHEN OTHERS THEN l_numcra := 0;
		END;
		
		/* busca crachá do veículo */
	    BEGIN
		    SELECT NUMCRA INTO l_cravei FROM R088HCH
		        WHERE PLAVEI = :NEW.PLAVEI AND
                    ((DATINI < l_datAtu) OR (DATINI = l_datAtu AND HORINI <= l_horAtu)) AND
                     (DATFIM > l_datAtu OR DATFIM = l_datZer OR (DATFIM = l_datAtu AND HORFIM > l_horAtu));		    
		EXCEPTION
            WHEN OTHERS THEN l_cravei := 0;
		END;				
		
		/* Se tiver crachá válido, atualiza a tabela R088CON */
		IF (l_numcra > 0) THEN
		    SP_VEIPESCON('I', l_cravei, l_numcra, 0, :NEW.PLAVEI, l_datfim, l_horfim, 5, :NEW.NUMEMP, 5, :NEW.NUMCAD, 0, '');		
		END IF;
	
	END IF;
END␀ùÜ␀␀		SENIOR;0␀␀

TRIGGER R088VEO_EU AFTER UPDATE ON R088VEO FOR EACH ROW

DECLARE
l_online  BOOLEAN;
    l_numcra  NUMBER(12);
    l_cravei  NUMBER(12);
    l_datzer  DATE;
    l_datAtu  DATE;
    l_horAtu  NUMBER;
    l_datfim  DATE;    
    l_horfim  NUMBER;   
BEGIN
	l_datAtu := CURDATE();
	l_horAtu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
