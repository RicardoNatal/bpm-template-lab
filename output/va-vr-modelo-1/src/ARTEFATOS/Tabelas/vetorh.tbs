BEGIN
  SET NOCOUNT ON;
  SET XACT_ABORT OFF;
  SAVE TRANSACTION TR_r070ocr_eu;
  BEGIN TRY
    DECLARE @OLD_NumEmp SMALLINT;
    DECLARE @OLD_NumCad INTEGER;
    DECLARE @OLD_NomCra VARCHAR(40);
    DECLARE @OLD_TabOrg SMALLINT;
    DECLARE @OLD_NumLoc INTEGER;
    DECLARE @OLD_CodPrm INTEGER;
    DECLARE @OLD_PrmFer INTEGER;
    DECLARE @OLD_PrmSab INTEGER;
    DECLARE @OLD_PrmDom INTEGER;
    DECLARE @OLD_AceOcr SMALLINT;
    DECLARE @OLD_EmpOri SMALLINT;
    DECLARE @OLD_FilOri INTEGER;
    DECLARE @OLD_CodEsc INTEGER;
    DECLARE @OLD_CodTma SMALLINT;
    DECLARE @OLD_ConFai SMALLINT;
    DECLARE @OLD_UtiChv VARCHAR(1);
    DECLARE @OLD_DatFot DATETIME;
    DECLARE @OLD_HorFot INTEGER;
    DECLARE @OLD_UsaRFa VARCHAR(1);
    DECLARE @NEW_NumEmp SMALLINT;
    DECLARE @NEW_NumCad INTEGER;
    DECLARE @NEW_NomCra VARCHAR(40);
    DECLARE @NEW_TabOrg SMALLINT;
    DECLARE @NEW_NumLoc INTEGER;
    DECLARE @NEW_CodPrm INTEGER;
    DECLARE @NEW_PrmFer INTEGER;
    DECLARE @NEW_PrmSab INTEGER;
    DECLARE @NEW_PrmDom INTEGER;
    DECLARE @NEW_AceOcr SMALLINT;
    DECLARE @NEW_EmpOri SMALLINT;
    DECLARE @NEW_FilOri INTEGER;
    DECLARE @NEW_CodEsc INTEGER;
    DECLARE @NEW_CodTma SMALLINT;
    DECLARE @NEW_ConFai SMALLINT;
    DECLARE @NEW_UtiChv VARCHAR(1);
    DECLARE @NEW_DatFot DATETIME;
    DECLARE @NEW_HorFot INTEGER;
    DECLARE @NEW_UsaRFa VARCHAR(1);
    DECLARE @l_fotocr VARBINARY(max);
    DECLARE @l_datazerada DATETIME;
    DECLARE CUR_r070ocr_UPD_OLD CURSOR LOCAL FOR SELECT 
      old.numemp O_NumEmp,old.numcad O_NumCad,old.nomcra O_NomCra,old.taborg O_TabOrg,old.numloc O_NumLoc,old.codprm O_CodPrm,old.prmfer O_PrmFer,old.prmsab O_PrmSab,old.prmdom O_PrmDom,old.aceocr O_AceOcr,
      old.empori O_EmpOri,old.filori O_FilOri,old.codesc O_CodEsc,old.codtma O_CodTma,old.confai O_ConFai,old.utichv O_UtiChv,old.datfot O_DatFot,old.horfot O_HorFot,old.usarfa O_UsaRFa
       FROM deleted old;
    DECLARE CUR_r070ocr_UPD_NEW CURSOR LOCAL FOR SELECT 
      new.numemp N_NumEmp,new.numcad N_NumCad,new.nomcra N_NomCra,new.taborg N_TabOrg,new.numloc N_NumLoc,new.codprm N_CodPrm,new.prmfer N_PrmFer,new.prmsab N_PrmSab,new.prmdom N_PrmDom,new.aceocr N_AceOcr,
      new.empori N_EmpOri,new.filori N_FilOri,new.codesc N_CodEsc,new.codtma N_CodTma,new.confai N_ConFai,new.utichv N_UtiChv,new.datfot N_DatFot,new.horfot N_HorFot,new.usarfa N_UsaRFa
       FROM inserted new;
    BEGIN TRY
      DECLARE @l_online NUMERIC(1,0);
      DECLARE @l_idtpes VARCHAR(23);
      BEGIN
        SELECT @l_datazerada = CONVERT(DATETIME,'12/31/1900 00:00:00', 101);
        OPEN CUR_r070ocr_UPD_OLD;
        EXECUTE SP$CHECKERROR @@Error;
        OPEN CUR_r070ocr_UPD_NEW;
        EXECUTE SP$CHECKERROR @@Error;
        BEGIN TRY
          FETCH NEXT FROM CUR_r070ocr_UPD_OLD INTO @OLD_NumEmp, @OLD_NumCad, @OLD_NomCra, @OLD_TabOrg, @OLD_NumLoc, @OLD_CodPrm, @OLD_PrmFer, @OLD_PrmSab, @OLD_PrmDom, @OLD_AceOcr, 
            @OLD_EmpOri, @OLD_FilOri, @OLD_CodEsc, @OLD_CodTma, @OLD_ConFai, @OLD_UtiChv, @OLD_DatFot, @OLD_HorFot, @OLD_UsaRFa;
          FETCH NEXT FROM CUR_r070ocr_UPD_NEW INTO @NEW_NumEmp, @NEW_NumCad, @NEW_NomCra, @NEW_TabOrg, @NEW_NumLoc, @NEW_CodPrm, @NEW_PrmFer, @NEW_PrmSab, @NEW_PrmDom, @NEW_AceOcr, 
            @NEW_EmpOri, @NEW_FilOri, @NEW_CodEsc, @NEW_CodTma, @NEW_ConFai, @NEW_UtiChv, @NEW_DatFot, @NEW_HorFot, @NEW_UsaRFa;
          WHILE (@@FETCH_STATUS = 0)
          BEGIN
            EXECUTE SP_VerOnLine @l_online OUTPUT;
            EXECUTE SP$CHECKERROR @@Error;
            IF (@l_online=1)
            BEGIN
	          SELECT @l_fotocr = FOTOCR FROM R070OCR WHERE NUMEMP = @NEW_NumEmp AND NUMCAD = @NEW_NumCad;

              IF (@NEW_CODESC<>@OLD_CODESC) 
      OR (@NEW_CODTMA<>@OLD_CODTMA)
              BEGIN
                EXECUTE R070OCR_ATUCON @NEW_NUMEMP, @NEW_NUMCAD, @NEW_CODPRM, @NEW_PRMFER, @NEW_PRMSAB, @NEW_PRMDOM, @NEW_ACEOCR, @NEW_CODESC, @NEW_CODTMA, @NEW_CONFAI, @NEW_NOMCRA, @NEW_USARFA;
                EXECUTE SP$CHECKERROR @@Error;
              END
              ELSE IF (@NEW_CODPRM<>@OLD_CODPRM) 
      OR (@NEW_PRMFER<>@OLD_PRMFER) 
      OR (@NEW_PRMSAB<>@OLD_PRMSAB) 
      OR (@NEW_PRMDOM<>@OLD_PRMDOM) 
      OR (@NEW_ACEOCR<>@OLD_ACEOCR) 
      OR (@NEW_CONFAI<>@OLD_CONFAI) 
      OR (@NEW_NOMCRA<>@OLD_NOMCRA)
      OR (@NEW_USARFA<>@OLD_USARFA)
              BEGIN
                EXECUTE R070OCR_ATUCON @NEW_NUMEMP, @NEW_NUMCAD, @NEW_CODPRM, @NEW_PRMFER, @NEW_PRMSAB, @NEW_PRMDOM, @NEW_ACEOCR, 0, 0, @NEW_CONFAI, @NEW_NOMCRA, @NEW_USARFA;
                EXECUTE SP$CHECKERROR @@Error;
              END
            END;
            EXECUTE SP_RETIDTPES @NEW_NUMEMP, 5, @NEW_NUMCAD, NULL, NULL, NULL, NULL, @l_IDTPES OUTPUT;
            EXECUTE SP$CHECKERROR @@Error;
            IF (@NEW_NOMCRA<>@OLD_NOMCRA)
            BEGIN
              EXECUTE SP_ATUNOMPES @l_IDTPES, @NEW_NOMCRA;
              EXECUTE SP$CHECKERROR @@Error;
            END;

            IF (@l_fotocr IS NULL AND @OLD_DatFot IS NOT NULL AND @OLD_DatFot <> @l_datazerada AND (@NEW_DatFot IS NULL OR @NEW_DatFot = @l_datazerada))
            BEGIN
              EXECUTE SP_PEND82 @l_IDTPES, 3;
              EXECUTE SP$CHECKERROR @@Error;
            END;

            FETCH NEXT FROM CUR_r070ocr_UPD_OLD INTO @OLD_NumEmp, @OLD_NumCad, @OLD_NomCra, @OLD_TabOrg, @OLD_NumLoc, @OLD_CodPrm, @OLD_PrmFer, @OLD_PrmSab, @OLD_PrmDom, @OLD_AceOcr, 
              @OLD_EmpOri, @OLD_FilOri, @OLD_CodEsc, @OLD_CodTma, @OLD_ConFai, @OLD_UtiChv, @OLD_DatFot, @OLD_HorFot, @OLD_UsaRFa;
            FETCH NEXT FROM CUR_r070ocr_UPD_NEW INTO @NEW_NumEmp, @NEW_NumCad, @NEW_NomCra, @NEW_TabOrg, @NEW_NumLoc, @NEW_CodPrm, @NEW_PrmFer, @NEW_PrmSab, @NEW_PrmDom, @NEW_AceOcr, 
              @NEW_EmpOri, @NEW_FilOri, @NEW_CodEsc, @NEW_CodTma, @NEW_ConFai, @NEW_UtiChv, @NEW_DatFot, @NEW_HorFot, @NEW_UsaRFa;
          END;
        END TRY
        BEGIN CATCH
          CLOSE CUR_r070ocr_UPD_OLD;
          CLOSE CUR_r070ocr_UPD_NEW;
          THROW;
        END CATCH;
        CLOSE CUR_r070ocr_UPD_OLD;
        CLOSE CUR_r070ocr_UPD_NEW;
      END;
    END TRY
    BEGIN CATCH
      DEALLOCATE CUR_r070ocr_UPD_OLD;
      DEALLOCATE CUR_r070ocr_UPD_NEW;
      THROW;
    END CATCH;
    DEALLOCATE CUR_r070ocr_UPD_OLD;
    DEALLOCATE CUR_r070ocr_UPD_NEW;
  END TRY
  BEGIN CATCH
    ROLLBACK TRANSACTION TR_r070ocr_eu;
    THROW;
  END CATCH;
END;	MSSQL;23±␀␀CREATE TRIGGER r070ocr_eu ON r070ocr FOR update AS 
