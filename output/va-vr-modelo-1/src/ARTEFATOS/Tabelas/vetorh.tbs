TRIGGER R346ADV_EU BEFORE UPDATE ON R346ADV FOR EACH ROW
DECLARE
	l_Valor VARCHAR2(2000);
	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_JsonCamposAlterados VARCHAR2(2000);
	l_VersaoESocial NUMBER;
	l_isGerarPendencia BOOLEAN;
BEGIN
  l_Valor := '';
  l_VersaoESocial := 0;
  l_JsonCamposAlterados := '';

  SP_GERAR_PEN_S2501(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODPRO, :NEW.CMPPAG, l_isGerarPendencia OUT);
  
  IF (l_isGerarPendencia = TRUE) THEN
	SP_ESOCIAL_S250X(:NEW.NUMEMP, :NEW.CMPPAG, l_VersaoESocial OUT);

	IF (l_VersaoESocial >= 6) THEN
		SP_VALUPDATE_NUM(:OLD.TIPINS, :NEW.TIPINS, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('TIPINS', :NEW.TIPINS, :OLD.TIPINS, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_NUM(:OLD.NUMINS, :NEW.NUMINS, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('NUMINS', :NEW.NUMINS, :OLD.NUMINS, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_NUM(:OLD.VLRADV, :NEW.VLRADV, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_FLO_JSON('VLRADV', :NEW.VLRADV, :OLD.VLRADV, 2, l_JsonCamposAlterados OUT);
		END IF;
	END IF;

	IF (l_Alterou = TRUE) THEN
		SP_CONCATENAR_NUM('CODPRO', :NEW.CODPRO, l_Valor OUT);
		SP_CONCATENAR_DAT('CMPPAG', :NEW.CMPPAG, l_Valor OUT);

		SP_E_SOCIAL('S-2501', 'R346ADV', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, l_JsonCamposAlterados, 0, NULL, :NEW.CMPPAG, 0, 'R346ADV_EU');
	END IF;
  END IF;
END␀.æ␀␀		SENIOR;0ò␀␀

