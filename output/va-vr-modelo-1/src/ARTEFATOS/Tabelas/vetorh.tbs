TRIGGER R577REV_SI AFTER INSERT ON R577REV

DECLARE
/* CURSOR c/ os registros gravados na tabela R577REV_AUX */
  CURSOR c_R577REV_AuxI IS SELECT DISTINCT R577REV_AUX.CODCPT FROM R577REV_AUX;

  TYPE t_R577REV_AuxI IS RECORD(
    CODCPT   R577REV_AUX.CODCPT%TYPE);

  l_R577REV_AuxI t_R577REV_AuxI;
BEGIN
  /* Seta flag de controle para 1, evitando que a trigger seja
     processada em mais de uma instancia, controle necessário para evitar a Recursividade */
  BEGIN
    UPDATE R577REV_AUX SET FLGCON = 1;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro flag de controle da tabela R577REV_AUX.';
  END;

  /* Calcula data final para todos os registros da Competência informada */
  FOREACH c_R577REV_AuxI INTO l_R577REV_AuxI.CODCPT
  LOOP
    BEGIN
      UPDATE R577REV
         SET DATTER = (SELECT IFNULL((DATETIMEADD(DD, -1, MIN(REV.DATINI))), DATETIME(31, 12, 1900, 0, 0, 0)) FROM R577REV REV
                        WHERE REV.CODCPT = R577REV.CODCPT
                          AND REV.DATINI > R577REV.DATINI)
       WHERE CODCPT = l_R577REV_AuxI.CODCPT;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar data de término da revisão.';
    END;
  END LOOP;

  /* Apaga Registros em R577REV_AUX */
  BEGIN
    DELETE FROM R577REV_AUX;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao excluir registros da tabela R577REV_AUX.';
  END;
END␀	ê␀␀		SENIOR;0␀␀TRIGGER R577REV_EI AFTER INSERT ON R577REV FOR EACH ROW

BEGIN
BEGIN
    /* Insere Registro New */
    INSERT INTO R577REV_AUX (CODCPT, FLGCON) VALUES (:NEW.CODCPT, 0);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao inserir registro na tabela R577REV_AUX.';
  END;
END␀ê␀␀	SENIOR;0␀␀

TRIGGER R577REV_SU AFTER UPDATE ON R577REV

DECLARE
/* CURSOR c/ os registros gravados na tabela R577REV_AUX */
  CURSOR c_R577REV_AuxU IS SELECT DISTINCT R577REV_AUX.CODCPT FROM R577REV_AUX;

  TYPE t_R577REV_AuxU IS RECORD(
    CODCPT   R577REV_AUX.CODCPT%TYPE);

  l_R577REV_AuxU t_R577REV_AuxU;
  l_Count        NUMBER;
BEGIN
  /* Garante que está sendo processado a trigger uma unica vez, evitando assim LOOP */
  BEGIN
    SELECT COUNT(*) INTO l_Count FROM R577REV_AUX
     WHERE FLGCON = 1;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao retornar flag de controle da tabela R577REV_AUX.';
  END;

  /* Se não existe registro com Flag = 1 significa estar passando pela primeira vez na trigger */
  IF (l_Count  = 0) THEN
    /* Seta flag de controle para 1, evitando que a trigger seja
       processada em mais de uma instancia, controle necessário para evitar a Recursividade */
    BEGIN
      UPDATE R577REV_AUX SET FLGCON = 1;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro flag de controle da tabela R577REV_AUX.';
    END;

    /* Calcula data final para todos os registros da Competência informada */
    FOREACH c_R577REV_AuxU INTO l_R577REV_AuxU.CODCPT
    LOOP
      BEGIN
        UPDATE R577REV
           SET DATTER = (SELECT IFNULL((DATETIMEADD(DD, -1, MIN(REV.DATINI))), DATETIME(31, 12, 1900, 0, 0, 0)) FROM R577REV REV
                          WHERE REV.CODCPT = R577REV.CODCPT
                            AND REV.DATINI > R577REV.DATINI)
         WHERE CODCPT = l_R577REV_AuxU.CODCPT;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao atualizar data de término da revisão.';
      END;
    END LOOP;

    /* Apaga Registros em R577REV_AUX */
    BEGIN
      DELETE FROM R577REV_AUX;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao excluir registros da tabela R577REV_AUX.';
    END;
  END IF;
END␀
ê␀␀		SENIOR;0‚␀␀

TRIGGER R577REV_EU AFTER UPDATE ON R577REV FOR EACH ROW

DECLARE
l_New_DatIni   R577REV.DATINI%TYPE;
  l_Old_DatIni   R577REV.DATINI%TYPE;
BEGIN
  BEGIN
    l_New_DatIni := IFNULL(:NEW.DATINI, DATETIME(31, 12, 1900, 0, 0, 0));
    l_Old_DatIni := IFNULL(:OLD.DATINI, DATETIME(31, 12, 1900, 0, 0, 0));
    /* Somente processa se alterou a data inicial */
    IF (l_New_DatIni <> l_Old_DatIni) THEN
      /* Insere Registro New */
      INSERT INTO R577REV_AUX (CODCPT, FLGCON) VALUES (:NEW.CODCPT, 0);
    END IF;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao inserir registro na tabela R577REV_AUX.';
  END;
END␀ê␀␀	SENIOR;0ˆ␀␀

TRIGGER R577REV_SD AFTER DELETE ON R577REV

DECLARE
/* CURSOR c/ os registros gravados na tabela R577REV_AUX */
  CURSOR c_R577REV_AuxD IS SELECT DISTINCT R577REV_AUX.CODCPT FROM R577REV_AUX;

  TYPE t_R577REV_AuxD IS RECORD(
    CODCPT   R577REV_AUX.CODCPT%TYPE);

  l_R577REV_AuxD t_R577REV_AuxD;
BEGIN
  /* Seta flag de controle para 1, evitando que a trigger seja
     processada em mais de uma instancia, controle necessário para evitar a Recursividade */
  BEGIN
    UPDATE R577REV_AUX SET FLGCON = 1;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro flag de controle da tabela R577REV_AUX.';
  END;

  /* Calcula data final para todos os registros da Competência informada */
  FOREACH c_R577REV_AuxD INTO l_R577REV_AuxD.CODCPT
  LOOP
    BEGIN
      UPDATE R577REV
         SET DATTER = (SELECT IFNULL((DATETIMEADD(DD, -1, MIN(REV.DATINI))), DATETIME(31, 12, 1900, 0, 0, 0)) FROM R577REV REV
                        WHERE REV.CODCPT = R577REV.CODCPT
                          AND REV.DATINI > R577REV.DATINI)
       WHERE CODCPT = l_R577REV_AuxD.CODCPT;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar data de término da revisão.';
    END;
  END LOOP;

  /* Apaga Registros em R577REV_AUX */
  BEGIN
    DELETE FROM R577REV_AUX;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao excluir registros da tabela R577REV_AUX.';
  END;
END␀ê␀␀		SENIOR;0"␀␀

TRIGGER R577REV_ED AFTER DELETE ON R577REV FOR EACH ROW

BEGIN
BEGIN
    /* Insere Registro Old */
    INSERT INTO R577REV_AUX (CODCPT, FLGCON) VALUES (:OLD.CODCPT, 0);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao inserir registro na tabela R577REV_AUX.';
  END;
