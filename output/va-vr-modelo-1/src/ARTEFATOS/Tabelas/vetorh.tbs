ö␀␀CREATE OR REPLACE PROCEDURE SP_STRTODATE(p_value IN VARCHAR,p_mask IN VARCHAR,p_return IN OUT TIMESTAMP)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  l_day VARCHAR(2);
  l_month VARCHAR(2);
  l_year VARCHAR(4);
  l_hour VARCHAR(2);
  l_minute VARCHAR(2);
  l_second VARCHAR(2);
  l_mask VARCHAR(30);
  l_pos SMALLINT;
  l_count SMALLINT;
  l_validate SMALLINT;
BEGIN
  IF (p_value = '') OR (p_value IS NULL) THEN        
    p_return := TO_DATE('31/12/1900', 'DD/MM/YYYY');
    return;
  END IF;

  if ( LENGTH(p_value) <> LENGTH(p_mask) ) then
    RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_STRTODATE: Tamanho da máscara incompatível com literal informado.';
  end if;
  l_pos := 0;
  l_count := 0;
  l_hour := '00';
  l_minute := '00';
  l_second := '00';
  l_mask := UPPER(p_mask);
  
  /*YEAR*/
  l_count := 4;
   /*AAAA*/
  l_pos   := POSITION('AAAA' IN l_mask);
  if (l_pos=0) then
    /*AA*/
    l_count := 2;
	l_pos   := POSITION('AA' IN l_mask);
    if (l_pos=0) then
      RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_STRTODATE: Ano deve ser informado na máscara para conversão.';
    else
      begin
        l_validate := (SUBSTR(p_value,l_pos,l_count))::smallint;
      exception
        when OTHERS then
          RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_STRTODATE: Erro ao converter Ano - AA';
      end;	  
      if (l_validate>=0) 
      AND (l_validate<=50) then
        l_year := '20'||SUBSTR(p_value,l_pos,l_count);
      else
        l_year := '19'||SUBSTR(p_value,l_pos,l_count);
      end if;
    end if;
  else
    l_year := SUBSTR(p_value,l_pos,l_count);
  end if;
  /*END YEAR*/
  
  /*DAY*/
  l_count := 2;
  l_pos   := POSITION('DD' IN l_mask);
  if (l_pos=0) then
   RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_STRTODATE: Dia deve ser informado na máscara para conversão.';
  else
    l_day := SUBSTR(p_value,l_pos,l_count);
  end if;
  /*END DAY*/
  
  /*MONTH*/
  l_count := 2;
  l_pos   := POSITION('MM' IN l_mask);
  if (l_pos=0) then
    RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_STRTODATE: Mês deve ser informado na máscara para conversão.';
  else
    l_validate := (SUBSTR(p_value,l_pos,l_count))::smallint;
    if (l_validate>=1) 
      AND (l_validate<=12) then
      l_month := SUBSTR(p_value,l_pos,l_count);
    else
      RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_STRTODATE: Mês deve estar entre 01 e 12.';
    end if;
  end if;
  /*END MONTH*/
  
  /*HOUR*/
  l_count := 2;
  l_pos   := POSITION('HH' IN l_mask);
  if (l_pos<>0) then
    l_validate := (SUBSTR(p_value,l_pos,l_count))::smallint;
    if (l_validate>=0) 
      AND (l_validate<=23) then
      l_hour := SUBSTR(p_value,l_pos,l_count);
    else
      RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_STRTODATE: Hora deve estar entre 0 e 23.';
    end if;
  end if;
  /*END HOUR*/
  
  /*MINUTES*/
  l_count := 2;
  l_pos   := POSITION('MI' IN l_mask);
  if (l_pos<>0) then
    l_validate := (SUBSTR(p_value,l_pos,l_count))::smallint;
    if (l_validate>=0) 
      AND (l_validate<=59) then
      l_minute := SUBSTR(p_value,l_pos,l_count);
    else
      RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_STRTODATE: Minuto deve estar entre 0 e 59.';
    end if;
  end if;
  /*END MINUTES*/
  
  /*SECOND*/
  l_count := 2;
  l_pos   := POSITION('SS' IN l_mask);
  if (l_pos<>0) then
    l_validate := (SUBSTR(p_value,l_pos,l_count))::smallint;
    if (l_validate>=0) 
      AND (l_validate<=59) then
      l_second := SUBSTR(p_value,l_pos,l_count);
    else
      RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_STRTODATE: Segundo deve estar entre 0 e 59.';
    end if;
  end if;
  /*END SECOND*/
  BEGIN
    p_return := TO_DATE(l_day||'/'||l_month||'/'||l_year||' '||l_hour||':'||l_minute||':'||l_second, 'DD/MM/YYYY HH24:MI:SS');
  EXCEPTION
    when OTHERS then
      RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_STRTODATE: Erro ao converter data: ';
  END;

END;
$BODY$;␀îø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
