éCREATE OR REPLACE PROCEDURE SP_ISNUMERIC(  p_value IN VARCHAR2, p_retorno OUT BOOLEAN) IS
BEGIN
    if REGEXP_LIKE(p_value, '^-?[0-9]+$') THEN
        p_retorno := TRUE;
    ELSE 
        p_retorno := FALSE;
    end if;
END;
	MSSQL;0
åCREATE PROCEDURE SP_ISNUMERIC @p_value VARCHAR(255), @p_retorno BIT OUTPUT AS
BEGIN
	IF (@p_value IS NULL) OR (LEN(@p_value) = 0) OR (PATINDEX('%[^0-9]%', @p_value) > 0)
		SET @p_retorno = 0;
	ELSE
		SET @p_retorno = 1;
END	POSTGRESQL;0
ğCREATE OR REPLACE PROCEDURE SP_ISNUMERIC(p_value CHARACTER VARYING, p_retorno IN OUT BOOLEAN)
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN

	SELECT CASE WHEN p_value SIMILAR TO '[0-9]+' THEN TRUE ELSE FALSE END INTO p_retorno;

END;
$BODY$;
