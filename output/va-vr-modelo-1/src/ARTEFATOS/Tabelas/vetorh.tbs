    SP_INTSTR(0, '999', l_tipPNGStr OUT);
  ELSE
    SP_INTSTR(p_TipPNG, '999', l_tipPNGStr OUT);
  END IF;

  l_desPor := RTrim(LTrim(p_DesPor));
  l_TamDesPor := LENGTH(l_desPor);
  SP_INTSTR(l_TamDesPor, '99', l_TamDesPorStr OUT);

  SP_INTSTR(p_QtdVis, '99', l_QtdVisStr OUT);
  SP_INTSTR(p_horvis,'9999',l_horvisStr OUT);
  
