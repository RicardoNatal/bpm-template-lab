                  GOTO FIM
                END
              END
            END
          /* END EXCEPTION HANDLER */
        END
        EXECUTE  @ChkError = SP_AUDGETVERSEQ @l_seqreg,@l_seqreg OUTPUT ,@l_verseq OUTPUT  
        IF @ChkError <> 0
        BEGIN
          CLOSE CUR_r090vis_UPD_OLD
          DEALLOCATE CUR_r090vis_UPD_OLD
          CLOSE CUR_r090vis_UPD_NEW
          DEALLOCATE CUR_r090vis_UPD_NEW
          GOTO FIM
        END
        /* TRY */
          INSERT INTO r090vis_aud
       
(seqreg,verseq,tipdoc,numdoc,nomvis,codoem,nomoem,codprm,dditel,dddtel,telcon,segtdo,segdoc,numcnh,catcnh,datcnh,vencnh,obsvis,datvid,datfot,flafot,datrgv,emicid,estcid,dexcid,contpm,codnac,utichv,datnas,tipsex,funvis,quavis,dvadoc,paidoc,staalf) 
      VALUES 
      
(@l_seqreg,@l_verseq,@NEW_TIPDOC,@NEW_NUMDOC,@NEW_NOMVIS,@NEW_CODOEM,@NEW_NOMOEM,@NEW_CODPRM,@NEW_DDITEL,@NEW_DDDTEL,@NEW_TELCON,@NEW_SEGTDO,@NEW_SEGDOC,@NEW_NUMCNH,@NEW_CATCNH,@NEW_DATCNH,@NEW_VENCNH,@NEW_OBSVIS,@NEW_DATVID,@NEW_DATFOT,@NEW_FLAFOT,
@NEW_DATRGV,@NEW_EMICID,@NEW_ESTCID,@NEW_DEXCID,@NEW_CONTPM,@NEW_CODNAC,@NEW_UTICHV,@NEW_DATNAS,@NEW_TIPSEX,@NEW_FUNVIS,@NEW_QUAVIS,@NEW_DVADOC,@NEW_PAIDOC,@NEW_STAALF)
          SELECT @ChkError = @@Error
          IF @ChkError <> 0
          BEGIN
            GOTO EXC4
          END
          EXECUTE  @ChkError = SP_AUDGENREG @l_seqreg,@l_verseq,'R090VIS',@l_camposAlterados 
          IF @ChkError <> 0
          BEGIN
            GOTO EXC4
          END
        /* END TRY */
        /* BEGIN EXCEPTION HANDLER */
          EXC4:
          SELECT @SE_EXC4 = @ChkError
          IF @ChkError <> 0
          BEGIN
            BEGIN
              SELECT @ChkError = 0
              BEGIN
                RAISERROR('Erro gerar registro para auditoria. ',11,1) WITH SETERROR
                CLOSE CUR_r090vis_UPD_OLD
                DEALLOCATE CUR_r090vis_UPD_OLD
                CLOSE CUR_r090vis_UPD_NEW
                DEALLOCATE CUR_r090vis_UPD_NEW
                SELECT @ChkError = -30
                GOTO FIM
              END
            END
          END
        /* END EXCEPTION HANDLER */
      END
    END
    EXECUTE  @ChkError = SP_RETIDTPES NULL,4,NULL,@NEW_TIPDOC,@NEW_NUMDOC,NULL,NULL,@l_IDTPES OUTPUT  
    IF @ChkError <> 0
    BEGIN
      CLOSE CUR_r090vis_UPD_OLD
      DEALLOCATE CUR_r090vis_UPD_OLD
      CLOSE CUR_r090vis_UPD_NEW
      DEALLOCATE CUR_r090vis_UPD_NEW
      GOTO FIM
    END
    EXECUTE  @ChkError = SP_SAM_PENDENCIES 7,2,@l_IDTPES 
    IF @ChkError <> 0
    BEGIN
      CLOSE CUR_r090vis_UPD_OLD
      DEALLOCATE CUR_r090vis_UPD_OLD
      CLOSE CUR_r090vis_UPD_NEW
      DEALLOCATE CUR_r090vis_UPD_NEW
      GOTO FIM
    END
    IF ((@NEW_DATFOT<>@OLD_DATFOT) 
      OR (@OLD_DATFOT IS NULL 
      AND @NEW_DATFOT IS  
      NOT NULL) 
      OR (@NEW_DATFOT IS NULL 
      AND @OLD_DATFOT IS  
      NOT NULL))
    BEGIN
      EXECUTE  @ChkError = SP_SAM_PENDENCIES 30,2,@l_IDTPES 
      IF @ChkError <> 0
      BEGIN
        CLOSE CUR_r090vis_UPD_OLD
        DEALLOCATE CUR_r090vis_UPD_OLD
        CLOSE CUR_r090vis_UPD_NEW
        DEALLOCATE CUR_r090vis_UPD_NEW
        GOTO FIM
      END
    END
    IF (@NEW_NOMVIS<>@OLD_NOMVIS)
    BEGIN
      EXECUTE  @ChkError = SP_ATUNOMPES @l_IDTPES,@NEW_NOMVIS 
      IF @ChkError <> 0
      BEGIN
        CLOSE CUR_r090vis_UPD_OLD
        DEALLOCATE CUR_r090vis_UPD_OLD
        CLOSE CUR_r090vis_UPD_NEW
        DEALLOCATE CUR_r090vis_UPD_NEW
        GOTO FIM
      END
    END
    IF (@l_fotvis IS NULL AND @l_tipoarmazenamentofoto = 2 AND @OLD_DatFot IS NOT NULL AND @OLD_DatFot <> @l_datazerada AND (@NEW_DatFot IS NULL OR @NEW_DatFot = @l_datazerada))
    BEGIN
      EXECUTE  @ChkError = SP_PEND82 @l_IDTPES,3 
      IF @ChkError <> 0
      BEGIN
        CLOSE CUR_r090vis_UPD_OLD
        DEALLOCATE CUR_r090vis_UPD_OLD
        CLOSE CUR_r090vis_UPD_NEW
        DEALLOCATE CUR_r090vis_UPD_NEW
        GOTO FIM
      END
    END
    FETCH NEXT FROM CUR_r090vis_UPD_OLD INTO 
@OLD_TipDoc, @OLD_NumDoc, @OLD_NomVis, @OLD_CodOem, @OLD_NomOem, @OLD_CodPrm, @OLD_DdiTel, @OLD_DddTel, @OLD_TelCon, @OLD_SegTDo, 
@OLD_SegDoc, @OLD_NumCnh, @OLD_CatCnh, @OLD_DatCnh, @OLD_VenCnh, @OLD_ObsVis, @OLD_DatVid, @OLD_DatFot, @OLD_FlaFot, @OLD_DatRgv, 
@OLD_EmiCid, @OLD_EstCid, @OLD_DexCid, @OLD_ConTpm, @OLD_CodNac, @OLD_UtiChv, @OLD_SeqReg, @OLD_EmaVis, @OLD_DatIdx, @OLD_NomDoc, 
@OLD_DatNas, @OLD_FunVis, @OLD_QuaVis, @OLD_StaAlf, @OLD_DvaDoc, @OLD_PaiDoc, @OLD_TipSex
    FETCH NEXT FROM CUR_r090vis_UPD_NEW INTO 
@NEW_TipDoc, @NEW_NumDoc, @NEW_NomVis, @NEW_CodOem, @NEW_NomOem, @NEW_CodPrm, @NEW_DdiTel, @NEW_DddTel, @NEW_TelCon, @NEW_SegTDo, 
@NEW_SegDoc, @NEW_NumCnh, @NEW_CatCnh, @NEW_DatCnh, @NEW_VenCnh, @NEW_ObsVis, @NEW_DatVid, @NEW_DatFot, @NEW_FlaFot, @NEW_DatRgv, 
@NEW_EmiCid, @NEW_EstCid, @NEW_DexCid, @NEW_ConTpm, @NEW_CodNac, @NEW_UtiChv, @NEW_SeqReg, @NEW_EmaVis, @NEW_DatIdx, @NEW_NomDoc, 
@NEW_DatNas, @NEW_FunVis, @NEW_QuaVis, @NEW_StaAlf, @NEW_DvaDoc, @NEW_PaiDoc, @NEW_TipSex
  END
  CLOSE CUR_r090vis_UPD_OLD
  DEALLOCATE CUR_r090vis_UPD_OLD
  CLOSE CUR_r090vis_UPD_NEW
  DEALLOCATE CUR_r090vis_UPD_NEW
  FIM:
  IF @ChkError <> 0
    ROLLBACK TRANSACTION TR_r090vis_eu
END␀xİ␀␀		SENIOR;0	␀␀

TRIGGER R090VIS_ED AFTER DELETE ON R090VIS FOR EACH ROW
DECLARE
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_IDTPES       VARCHAR(23);
BEGIN
  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090VIS');

  IF (l_auditoria = 'S') THEN
      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg
                FROM R090VIS_AUD
               WHERE TIPDOC = :OLD.TIPDOC AND
                     NUMDOC = :OLD.NUMDOC;
           EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
           INSERT INTO R090VIS_AUD (SEQREG,VERSEQ,TIPDOC,NUMDOC,NOMVIS,CODOEM,NOMOEM,CODPRM,DDITEL,DDDTEL,
                                    TELCON,SEGTDO,SEGDOC,NUMCNH,CATCNH,DATCNH,VENCNH,OBSVIS,DATVID,
                                    DATFOT,FLAFOT,DATRGV,EMICID,ESTCID,DEXCID,CONTPM,CODNAC,UTICHV,
                                    DATNAS,TIPSEX,FUNVIS,QUAVIS,DVADOC,PAIDOC,STAALF)
                            VALUES (l_seqreg,l_verseq,:OLD.TIPDOC,:OLD.NUMDOC,:OLD.NOMVIS,:OLD.CODOEM,:OLD.NOMOEM,
                                   :OLD.CODPRM,:OLD.DDITEL,:OLD.DDDTEL,:OLD.TELCON,:OLD.SEGTDO,:OLD.SEGDOC,
                                   :OLD.NUMCNH,:OLD.CATCNH,:OLD.DATCNH,:OLD.VENCNH,:OLD.OBSVIS,
                                   :OLD.DATVID,:OLD.DATFOT,:OLD.FLAFOT,:OLD.DATRGV,:OLD.EMICID,:OLD.ESTCID,
                                   :OLD.DEXCID,:OLD.CONTPM,:OLD.CODNAC,:OLD.UTICHV,:OLD.DATNAS,:OLD.TIPSEX,
                                   :OLD.FUNVIS,:OLD.QUAVIS,:OLD.DVADOC,:OLD.PAIDOC,:OLD.STAALF);

          SP_AUDGENREG(l_seqreg,l_verseq,'R090VIS','DELETE');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
  
  SP_RETIDTPES(NULL, 4, NULL, :OLD.TIPDOC, :OLD.NUMDOC, NULL, NULL, l_IDTPES OUT);
  SP_SAM_PENDENCIES(7, 3, l_IDTPES);
  SP_SAM_PENDENCIES(30, 3, l_IDTPES);
END␀␀␀"'␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀wİ␀␀ş␀␀¢␀	Ôÿ?␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀­%␀‹␀	Ôÿ?␀␀␀␀␀(&␀|%␀&␀a␀Æÿ␀␀ÿ␀N␀	Ôÿ?␀␀␀␀␀£␀␀0␀n␀Æÿ␀␀ÿ␀~¬␀␀(	Ôÿ?␀␀␀␀␀V±␀␀†^¯␀␀d␀␀␀ÿ␀␀ÿ␀å§␀␀U„␀␀␀␀␀æ©␀␀ç§␀␀ç§␀␀V␀␀ÿ␀␀ÿ␀-Ç␀␀␀␀␀␀␀e=¹·␀␀¹·␀␀z␀Æÿ␀␀ÿ␀¤§␀␀o␀␀␀␀␀␀cXbßbi␀␀ÿ␀␀ÿ␀C-·␀␀␀␀␀␀␀Ó;¿␀␀¿␀␀t␀Æÿ␀␀ÿ␀]O±␀Ôû?␀␀␀␀␀/;;;q␀Æÿ␀␀ÿ␀EO±␀Ôû?␀␀␀␀␀;␀;␀;q␀Æÿ␀␀ÿ␀T	␀(␀␀␀␀␀␀£±␀␀€	␀‡	␀1␀␀ÿ␀␀ÿ␀Àú␀␀␀␀␀␀␀␀Üú␀␀µú␀␀Ôú␀␀n␀Æÿ␀␀ÿ␀»ú␀␀(␀␀␀␀␀␀Úú␀␀´ú␀␀Ôú␀␀d␀␀␀ÿ␀␀ÿ␀o¬␀␀(␀␀␀␀␀␀ô¯␀␀(!(d␀␀␀ÿ␀␀ÿ␀R(T␀␀␀␀␀␀x(F(l(p␀␀␀ÿ␀␀ÿ␀DÑ␀␀␀␀␀␀␀ÃI·Å␀␀9GqC␀êÿ␀␀ÿ␀U%␀Ñ␀␀␀␀␀␀␀³K_%␀	IqC␀êÿ␀␀ÿ␀ç³␀␀␀␀␀␀␀␀i´␀␀ñ³␀␀ñ³␀␀"␀␀ÿ␀␀ÿ␀¢pÒ␀␀␀␀␀␀␀½p£p£pÿ␀ÿÿ␀␀ÿ␀ÒEÑ␀␀␀␀␀␀␀äMIIqC␀êÿ␀␀ÿ␀ëDÑ␀␀␀␀␀␀␀“I,G“IqCş‡␀êÿ␀␀ÿ␀soŠ␀␀␀␀␀␀␀|o|o|on␀Æÿ␀␀ÿ␀“EÑ␀␀␀␀␀␀␀ğM5G5GqC␀êÿ␀␀ÿ␀Ua(␀␀␀␀␀␀¶␀␀
