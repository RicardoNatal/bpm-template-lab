ˆ␀Æÿ␀␀ÿ␀5-·␀␀␀␀␀␀␀\A“␀“␀s␀Æÿ␀␀ÿ␀x-·␀␀␀␀␀␀␀(@¥.¥.u␀Æÿ␀␀ÿ␀[DÑ␀␀␀␀␀␀␀âLŞEŞEqC␀êÿ␀␀ÿ␀Fw·␀␀␀␀␀␀␀Àyxxì*␀␀Æÿ␀␀ÿ␀␀␀␀0;1␀␀¢␀␀␀␀␀␀␀QÙ␀␀ş␀␀©␀	␀␀␀␀␀␀Cxş␀␀xş␀␀k␀	Æÿ␀␀ÿ␀5-·␀	␀␀␀␀␀␀\A“␀“␀s␀Æÿ␀␀ÿ000u¬␀␀–␀␀␀␀␀␀␀␀>±␀␀)8)8n␀Æÿ␀␀ÿ␀[DÑ␀␀␀␀␀␀␀âLŞEŞEqC␀êÿ␀␀ÿ␀Fw·␀␀␀␀␀␀␀Àyxxì*␀␀Æÿ␀␀ÿ␀sü␀␀­␀␀␀␀␀␀␀£ÿ␀␀xş␀␀xş␀␀p␀Æÿ␀␀ÿ␀R]®␀␀␀␀␀␀«]Ÿ]Ÿ]c␀␀␀ÿ␀␀ÿ␀m,Ì␀␀␀␀␀␀␀N@¤:¤:{␀Æÿ␀␀ÿ␀7‹␀␀3␀␀␀␀␀␀bŠ␀␀	Š␀␀YŠ␀␀4␀␀ÿ␀␀ÿ␀®§␀␀U␀␀␀␀␀␀ç§␀␀ç§␀␀ç§␀␀Vë‡␀␀ÿ␀␀ÿ␀N␀␀␀␀␀␀␀$␀␀U␀n␀Æÿ␀␀ÿ␀~¬␀␀(␀␀␀␀␀␀¾±␀␀†^²␀␀d␀␀␀ÿ␀␀ÿ␀ZÂ␀␀␀␀␀␀␀␀}Â␀␀\Â␀␀\Â␀␀\␀Èˆ␀␀ÿ␀␀ÿ␀Ó¬␀␀␀␀␀␀␀␀õ;ô;ô;]␀␀␀ÿ␀␀ÿ␀(8–␀␀␀␀␀␀␀»±␀␀)8)8nXˆ␀Æÿ␀␀ÿ␀¿␀␀␀␀␀␀␀␀¿␀Æ␀Æ␀c␀␀␀ÿ␀␀ÿ␀x-·␀␀␀␀␀␀␀@¥.¥.u␀Æÿ␀␀ÿ␀¯‰␀␀è␀␀␀␀␀␀␀õŠ␀␀ß␀h␀␀␀ÿ␀␀ÿ␀Ë#(␀␀␀␀␀␀¹#’#”#d␀␀␀ÿ␀␀ÿ␀␀␀␀0;1RÙ␀␀		SENIOR;0.␀␀TRIGGER R070ARA_EI AFTER INSERT ON R070ARA FOR EACH ROW
DECLARE
  l_verplf     NUMBER(3);
  l_codplf     NUMBER(7);
  l_codrec     NUMBER(15);
  l_codpen     NUMBER(18);
  l_idtpes     VARCHAR2(23);
  l_tippes     NUMBER(1);
  l_ade_gerpen BOOLEAN;
BEGIN
  /* Insere uma pendência do evento 2 - Controle de Acesso de Pessoa, para envio pelo eDocs */
  BEGIN
    SELECT PLF.VERPLF, PLF.CODPLF, PLF.CODREC INTO l_verplf, l_codplf, l_codrec
      FROM R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
     WHERE DSP.CODDSP = :NEW.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF AND PLF.CATPLF = 9
       AND PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3;
  EXCEPTION WHEN OTHERS THEN
    l_verplf := 0;
    l_codplf := 0;
    l_codrec := 0;
  END;

  IF (l_codplf > 0) THEN
    l_idtpes := LTRIM(RTRIM(:NEW.IDTPES));
    l_tippes := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,1,2));

    SP_RECALF_GERPEN_2(l_tippes, l_ade_gerpen OUT); /* Acesso-pessoas */
    IF (l_ade_gerpen = TRUE) THEN

      SP_PENDADE02(2, 'I', l_verplf, l_codplf, l_codrec, l_codpen OUT);

      BEGIN
        INSERT INTO R152ACC (CODPEN, SEQREG, CODPLT)
             VALUES (l_codpen, :NEW.SEQREG, :NEW.CODPLT);
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'R070ARA_EI: Erro ao inserir pendência de Controle de Acesso de Pessoa';
      END;
    END IF;

    /* IF (:NEW.PLAVEI IS NOT NULL AND LENGTH(LTRIM(RTRIM(:NEW.PLAVEI))) IS NOT NULL AND LENGTH(LTRIM(RTRIM(:NEW.PLAVEI))) > 0) THEN */
      /* Insere uma pendência do evento 4 - Controle de Acesso de Veículo, para envio pelo eDocs */
      /* SP_PENDADE02(4, 'I', l_verplf, l_codplf, l_codrec, l_codpen OUT); */

      /* BEGIN
        INSERT INTO R152ACV (CODPEN, SEQREG, CODPLT)
          VALUES (l_codpen, :NEW.SEQREG, :NEW.CODPLT);
      EXCEPTION
          WHEN OTHERS THEN
            RAISERROR 103 'R070ARA_EI: Erro ao inserir pendência de Controle de Acesso de Veículos';
      END; */
    /* END; */
  END IF;
END␀␀␀÷œ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀SÙ␀␀…¬␀␀´␀	„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀—,¼␀	„␀␀␀␀␀␀=nnX)␀ˆ␀Æÿ␀␀!#␀␀␀␀0;1UÙ␀␀		SENIOR;0cTRIGGER R070BFC_EI AFTER INSERT ON R070BFC FOR EACH ROW

BEGIN
