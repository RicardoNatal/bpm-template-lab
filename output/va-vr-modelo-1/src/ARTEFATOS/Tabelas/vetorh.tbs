>␀␀PROCEDURE RH_SETORIOPE(P_ORIOPE VARCHAR2(1))
 IS
BEGIN
  /* Insere na tabela R110FIC, no campo ORIOPE, o valor passado por parâmetro */
  BEGIN
    INSERT INTO R110TRI (ORIOPE)
         VALUES (p_oriope);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao inserir operação na Tabela R110TRI';
  END;
END␀¤ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_RETSRV
a␀␀PROCEDURE RH_SRVDAT(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATSRV DATE,P_DIAFOL OUT VARCHAR2(1),P_CODSRV OUT NUMBER(4),P_CODTSE OUT NUMBER(2),P_CODOCE OUT NUMBER(3),P_TIPFOL OUT NUMBER(2))
 IS

/* Auxiliares */
   l_data_zero DATE;
   l_temsub INTEGER;
   l_codhor INTEGER;

   /* Tabela R005FFU. */
   l_numemp   r005ffu.numemp%TYPE;
   l_tipcol   r005ffu.tipcol%TYPE;
   l_numcad   r005ffu.numcad%TYPE;
   l_numempaux   r005ffu.numemp%TYPE;
   l_tipcolaux   r005ffu.tipcol%TYPE;
   l_numcadaux   r005ffu.numcad%TYPE;
   l_codoce   r005ffu.codoce%TYPE;

   /* Tabela R034ESR. */
   l_diafol   r034esr.diafol%TYPE;
   l_tipfol   r034esr.tipfol%TYPE;

   /* Tabela R005TUR. */
   l_codsrv   r005tur.codsrv%TYPE;
   l_codtse   r005tur.codtse%TYPE;
BEGIN
/* Variáveis auxiliares. */
l_data_zero := '31/12/1900,00:00:00';
l_diafol := 'N';
l_codsrv := 0;
l_codtse := 0;
l_codoce := 0;
l_tipfol := 0;
l_numemp := p_numemp;
l_tipcol := p_tipcol;
l_numcad := p_numcad;
l_codhor := 0;

/* Verificar se tem alteração pela ficha funcional. */
IF   (l_codsrv=0) THEN

     /* Procura Ocorrências na Ficha Funcional. */
     /* Se for substituído pega ocorrência e para. */
     BEGIN
     SELECT IFNULL(CODOCE,0) INTO l_codoce
     FROM R005FFU
     WHERE (NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad) AND
           INIOCO<=p_datsrv AND (FIMOCO>=p_datsrv OR FIMOCO=l_data_zero);
     EXCEPTION
     WHEN OTHERS THEN
          l_codoce := 0;
     END;

     IF   (l_codoce <> 0) THEN
          BEGIN
          SELECT IFNULL(CODHOR,0) INTO l_codhor
            FROM R005OCE
           WHERE CODOCE=l_codoce;
          EXCEPTION
          WHEN OTHERS THEN
              l_codhor := 0;
          END;
     END IF;

     /* Procura Ocorrências na troca de folga. */
     /* Se for substituído pega ocorrência e para. */
     BEGIN
     SELECT IFNULL(TIPFOL,0) INTO l_tipfol
     FROM R064FOL
     WHERE (NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad) AND
           DATINI<=p_datsrv AND (DATFIM>=p_datsrv OR DATFIM=l_data_zero);
     EXCEPTION
     WHEN OTHERS THEN
          l_tipfol := 0;
     END;

     IF   (l_tipfol <> 0) THEN
          BEGIN
          SELECT IFNULL(CODHOR,0) INTO l_codhor
            FROM R005FOL
           WHERE TIPFOL=l_tipfol;
          EXCEPTION
          WHEN OTHERS THEN
              l_codhor := 0;
          END;
     END IF;


     /* Se já achou horário por ser substituído para. */
     IF   (l_codhor = 0) THEN
          LOOP
               /* Se for substituto vai procurando se o substituído estava substituindo alguém. */
               BEGIN
               SELECT IFNULL(R005FFU.NUMEMP,0),R005FFU.TIPCOL,R005FFU.NUMCAD INTO l_numempaux,l_tipcolaux,l_numcadaux
               FROM R005FFU,R005SFF
               WHERE (R005SFF.NUMEMP=R005FFU.NUMEMP AND R005SFF.TIPCOL=R005FFU.TIPCOL AND R005SFF.NUMCAD=R005FFU.NUMCAD AND 
                     R005SFF.INIOCO=R005FFU.INIOCO AND R005SFF.EMPSUB=l_numemp AND R005SFF.TCLSUB=l_tipcol AND 
                     R005SFF.CADSUB=l_numcad) AND R005SFF.INISUB<=p_datsrv AND 
                     (R005SFF.FIMSUB>=p_datsrv OR R005SFF.FIMSUB=l_data_zero);
                    l_numemp := l_numempaux;
                    l_tipcol := l_tipcolaux;
                    l_numcad := l_numcadaux;
               EXCEPTION
               WHEN OTHERS THEN
                    l_numempaux := 0;
               END;
               
               BEGIN 
               SELECT IFNULL(NUMEMP,0),TIPCOL,NUMCAD INTO l_numempaux,l_tipcolaux,l_numcadaux
               FROM R064FOL
               WHERE (EMPSUB=l_numemp AND TCLSUB=l_tipcol AND CADSUB=l_numcad) AND
                     DATINI<=p_datsrv AND (DATFIM>=p_datsrv OR DATFIM=l_data_zero);
                    l_numemp := l_numempaux;
                    l_tipcol := l_tipcolaux;
                    l_numcad := l_numcadaux;
               EXCEPTION
               WHEN OTHERS THEN
                    l_numempaux := 0;
               END;

               IF   (l_numempaux=0) THEN
                   EXIT;
               END IF;
          END LOOP;

     END IF;

END IF;

/* Verifica se tem programação de Troca de Serviço */
BEGIN
SELECT IFNULL(CODSRV,0), IFNULL(CODTSE,0) INTO l_codsrv, l_codtse
 FROM R064TSR
WHERE NUMEMP = l_numemp AND
      TIPCOL = l_tipcol AND
      NUMCAD = l_numcad AND
      DATINI <= p_datsrv AND
      (DATFIM >= p_datsrv OR DATFIM=l_data_zero);
EXCEPTION
WHEN OTHERS THEN
     l_codsrv := 0;
     l_codtse := 0;
END;

/* Verifica qual é o serviço segundo escala base do colaborador. */
IF   (l_codsrv=0) THEN
     IF   (l_codhor = 0) THEN
          IF   (l_numemp <> 0) THEN
               RH_RETSRV(l_numemp,l_tipcol,l_numcad,p_datsrv,l_diafol OUT, l_codsrv OUT, l_codtse OUT, l_tipfol OUT);
          ELSE
               RH_RETSRV(p_numemp,p_tipcol,p_numcad,p_datsrv,l_diafol OUT, l_codsrv OUT, l_codtse OUT, l_tipfol OUT);
          END IF;
     END IF;
END IF;

p_diafol := l_diafol;
p_codsrv := l_codsrv;
p_codtse := l_codtse;
p_codoce := l_codoce;
p_tipfol := l_tipfol;
END␀¥ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Î␀␀PROCEDURE RH_TEMEXAVALDEM(P_NUMEMP NUMBER(4), P_CODFIC NUMBER(9), P_CODEXA NUMBER(4), P_DATREF DATE, P_TEMEXAVAL OUT BOOLEAN)
 IS

	l_QtdExa NUMBER;  
BEGIN
	BEGIN
		SELECT COUNT(1) INTO l_QtdExa FROM R108RES
		WHERE NUMEMP = P_NUMEMP AND CODFIC = P_CODFIC AND CODEXA = P_CODEXA AND DATRES >= P_DATREF;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			P_TEMEXAVAL := FALSE;
	END;
	
	IF (l_QtdExa > 0) THEN
		P_TEMEXAVAL := TRUE;
	ELSE
		P_TEMEXAVAL := FALSE;
	END IF;
END␀¦ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
@␀␀PROCEDURE RH_TRCINT(P_NUMINT NUMBER(12,5), P_NUMTRC OUT NUMBER)
 IS

  l_PosPto    INTEGER;
  l_NumIntCnv VARCHAR2(17);
BEGIN
     p_NumTrc := 0;
     l_NumIntCnv := CONVERT(NUMBER_TO_CHAR, p_NumInt);
     /*Identifica a posição do ponto decimal, considerando que o ponto decimal é um ponto*/
     l_PosPto := LOCATE('.', l_NumIntCnv);
     IF l_PosPto = 0 THEN
          /*Identifica a posição do ponto decimal, considerando que o ponto decimal é uma vírgula*/
          l_PosPto := LOCATE(',', l_NumIntCnv);
     END IF;
     IF l_PosPto = 0 THEN
          /*Significa que o número não tem parte decimal*/
          p_NumTrc := p_NumInt;
          RETURN;
     END IF;
     IF l_PosPto = 0 THEN
          /*Significa que o número é só parte decimal, não tem parte inteira.Retorna zero*/
          RETURN;
     END IF;
     /*Separa somente a parte inteira do número*/
     l_NumIntCnv := SUBSTRING(l_NumIntCnv, 1, (l_PosPto - 1));
     p_NumTrc := CONVERT(CHAR_TO_NUMBER, l_NumIntCnv);
     IF  P_NUMTRC IS NULL THEN
         P_NUMTRC := 0;
     END IF;
END␀§ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
?␀␀/* Verifica se o colaborador esta demitido */
PROCEDURE RH_VERCOLDEM(IN_NUMEMP NUMBER(9),IN_TIPCOL NUMBER(1),IN_NUMCAD NUMBER(9),IN_CODPES NUMBER(9),IN_SITAFA NUMBER(9),IN_TABEXC VARCHAR2(10),OUT_RESULT OUT BOOLEAN)
 IS

l_strerr VARCHAR2(255);
    l_TipSit   R010SIT.TIPSIT%TYPE;
    l_TotReg NUMBER(2);

BEGIN
  OUT_RESULT := TRUE;
  BEGIN
    /* Busca a situação do colaborador */
    SELECT TIPSIT INTO l_TipSit FROM R010SIT WHERE CODSIT = IN_SITAFA;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      l_TipSit := 0;
    WHEN OTHERS THEN
      l_strerr := 'Erro ao ler R010SIT'; RAISERROR 103 l_strerr;
  END;
  /* Verifica se o tipo da situação é demitido */
  IF (l_TipSit = 7) THEN
  BEGIN
    /* Verifica se existe outro colaborador associado à mesma pessoa */
    SELECT COUNT(*) INTO l_TotReg FROM R034FUN, R010SIT
    WHERE R034FUN.SITAFA = R010SIT.CODSIT AND TIPSIT <> l_TipSit AND CODPES = IN_CODPES;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      l_TotReg := 0;
    WHEN OTHERS THEN
      l_strerr := 'Erro ao ler R034FUN'; RAISERROR 103 l_strerr;
    END;
    IF (l_TotReg>0) THEN
      OUT_RESULT := FALSE;
    END IF;

    l_TotReg := 0;
    BEGIN
    /* Verifica se existe outro dependente associado à mesma pessoa */
      IF (IN_TABEXC <> 'R036DEP') THEN
      BEGIN
        SELECT COUNT(*) INTO l_TotReg FROM R036DEP
        WHERE CODPES = IN_CODPES;
        EXCEPTION WHEN NO_DATA_FOUND THEN
          l_TotReg := 0;
        WHEN OTHERS THEN
          l_strerr := 'Erro ao ler R036DEP'; RAISERROR 103 l_strerr;
        END;
      END IF;
    END;
    IF (l_TotReg>0) THEN
      OUT_RESULT := FALSE;
    END IF;

    l_TotReg := 0;
    BEGIN
      /* Verifica se existe outro candidato associado à mesma pessoa */
      SELECT COUNT(*) INTO l_TotReg FROM R122CEX
      WHERE CODPES = IN_CODPES;
      EXCEPTION WHEN NO_DATA_FOUND THEN
        l_TotReg := 0;
      WHEN OTHERS THEN
        l_strerr := 'Erro ao ler R122CEX'; RAISERROR 103 l_strerr;
    END; 
    IF (l_TotReg>0) THEN
      OUT_RESULT := FALSE;
    END IF;
  END IF;
END␀©ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
\␀␀PROCEDURE RH_VerRubi(P_USARUBI OUT BOOLEAN)
 IS

l_count      NUMBER;
BEGIN
  l_count := 0;
  p_usarubi := FALSE;
  BEGIN
    SELECT COUNT(*) INTO l_count
      FROM R000PRP
     WHERE R000PRP.VETRUB = 'S';
  EXCEPTION WHEN NO_DATA_FOUND THEN
    l_count := 0;
  END;
  IF  (l_count > 0) THEN
      p_usarubi := TRUE;
  END IF;
END␀¨ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0

␀␀PROCEDURE RH_VER_MODULO_PRP(P_CODMOD NUMBER(2),P_TEMMOD OUT VARCHAR2(1))
 IS
BEGIN
  p_TemMod := 'N';

  /* Verifica se está integrado com o Módulo Medicina */
  IF (p_codmod = 1) THEN     /* TRATAMENTO PARA O MÓDULO BENEFÍCIOS */
    BEGIN
      SELECT VETBEN INTO p_TemMod FROM R000PRP;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
           p_TemMod := 'N';
    END;
  ELSIF (p_codmod = 2) THEN  /* TRATAMENTO PARA O MÓDULO CARGOS E SALÁRIOS */
    BEGIN
      SELECT VETCSA INTO p_TemMod FROM R000PRP;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
           p_TemMod := 'N';
    END;
  ELSIF (p_codmod = 3) THEN  /* TRATAMENTO PARA O MÓDULO JURÍDICO */
    BEGIN
      SELECT VETJUR INTO p_TemMod FROM R000PRP;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
           p_TemMod := 'N';
    END;
  ELSIF (p_codmod = 4) THEN  /* TRATAMENTO PARA O MÓDULO MEDICINA */
    BEGIN
      SELECT VETMED INTO p_TemMod FROM R000PRP;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
           p_TemMod := 'N';
    END;
  ELSIF (p_codmod = 5) THEN  /* TRATAMENTO PARA O MÓDULO PESQUISA */
    BEGIN
      SELECT VETPES INTO p_TemMod FROM R000PRP;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
           p_TemMod := 'N';
    END;
  ELSIF (p_codmod = 6) THEN  /* TRATAMENTO PARA O MÓDULO PLR */
    BEGIN
      SELECT VETPLR INTO p_TemMod FROM R000PRP;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
           p_TemMod := 'N';
    END;
  ELSIF (p_codmod = 8) THEN  /* TRATAMENTO PARA O MÓDULO RECRUTAMENTO E SELEÇÃO */
    BEGIN
      SELECT VETRSE INTO p_TemMod FROM R000PRP;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
           p_TemMod := 'N';
    END;
  ELSIF (p_codmod = 9) THEN  /* TRATAMENTO PARA O MÓDULO RUBI */
    BEGIN
      SELECT VETRUB INTO p_TemMod FROM R000PRP;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
           p_TemMod := 'N';
    END;
  ELSIF (p_codmod = 10) THEN /* TRATAMENTO PARA O MÓDULO SEGURANÇA */
    BEGIN
      SELECT VETSEG INTO p_TemMod FROM R000PRP;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
           p_TemMod := 'N';
    END;
  ELSIF (p_codmod = 11) THEN /* TRATAMENTO PARA O MÓDULO TREINAMENTO */
    BEGIN
      SELECT VETTRE INTO p_TemMod FROM R000PRP;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
           p_TemMod := 'N';
    END;
  ELSIF (p_codmod = 13) THEN /* TRATAMENTO PARA O MÓDULO TAREFEIROS */
    BEGIN
      SELECT VETTAR INTO p_TemMod FROM R000PRP;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
           p_TemMod := 'N';
    END;
  END IF;
END␀Êì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RS_CRTABR
RS_BUSARG
S␀␀/* Distrincha o campo de abrangência de Turno gravando a tabela normalizada R124HTR */
PROCEDURE RS_ABTUR124CSL(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATSOL DATE,P_CODSOL NUMBER(3),P_CAMORI VARCHAR2(255))
 IS

l_TipSinal    CHAR(1);
 l_FirstAbr    VARCHAR2(25);
 l_SecondAbr   VARCHAR2(25);
 l_IdxAbr      NUMBER;
 l_PosAbr      NUMBER(5);
 l_FimAbr      BOOLEAN;
 l_NumEmp      NUMBER;
 l_TipCol      NUMBER;
 l_NumCad      NUMBER;
 l_DatSol      DATE;
 l_Codsol      NUMBER;
 l_CamOri      VARCHAR2(50);
 l_x           NUMBER;
 l_y           NUMBER;
 l_ret         BOOLEAN;
 l_aux         VARCHAR2(90);
 l_QtdReg      NUMBER;
BEGIN
l_CamOri := p_CamOri;
RS_CRTABR(l_CamOri,l_ret OUT);
IF   (l_ret = FALSE) THEN
     RETURN;
END IF;

IF   (LENGTH(RTRIM(l_CamOri)) > 0) THEN
     l_NumEmp    := p_NumEmp;
     l_TipCol    := p_TipCol;
     l_NumCad    := p_NumCad;
     l_DatSol    := p_DatSol;
     l_CodSol    := p_CodSol;
     l_PosAbr    := 1;
     l_FimAbr    := FALSE;
     l_FirstAbr  := '';
     l_SecondAbr := '';

     l_IdxAbr    := l_PosAbr;
     RS_BUSARG(l_CamOri, l_IdxAbr, l_PosAbr OUT, l_FimAbr OUT, l_TipSinal OUT, l_FirstAbr OUT, l_SecondAbr OUT);
     WHILE TRUE = TRUE LOOP
          IF   (l_TipSinal = ',') THEN
               IF   (CONVERT(CHAR_TO_NUMBER, l_FirstAbr) <> 0) THEN
                    IF   (LENGTH(RTRIM(l_FirstAbr)) > 1) THEN
                         l_FirstAbr := '9';
                    END IF;

                    BEGIN
                         SELECT COUNT(*) INTO l_QtdReg FROM R124HTR
                          WHERE NUMEMP = l_NumEmp AND TIPCOL = l_TipCol AND NUMCAD = l_NumCad AND DATSOL = l_DatSol
                            AND CODSOL = l_CodSol AND CODTUR = CONVERT(CHAR_TO_NUMBER,l_FirstAbr);
                    EXCEPTION
                         WHEN NO_DATA_FOUND THEN
                              l_QtdReg := 0;
                    END;

                    IF   (l_QtdReg = 0) THEN
                         BEGIN
                              INSERT INTO R124HTR (NUMEMP, TIPCOL, NUMCAD, DATSOL, CODSOL, CODTUR)
                                   VALUES (l_NumEmp, l_TipCol, l_NumCad, l_DatSol, l_CodSol, CONVERT(CHAR_TO_NUMBER,l_FirstAbr));
                         EXCEPTION
                              WHEN OTHERS THEN
                                   l_aux := 'Erro na Inclusão do Colaborador/1-Abrangência Turno'||l_FirstAbr;
                                   RAISERROR 103 l_aux;
                         END;
                    END IF;

               END IF;
          ELSE
               IF   (LENGTH(RTRIM(l_FirstAbr)) > 1) THEN
                    l_FirstAbr := '9';
               END IF;
               IF   (LENGTH(RTRIM(l_SecondAbr)) > 1) THEN
                    l_SecondAbr := '9';
               END IF;

               l_x := CONVERT(CHAR_TO_NUMBER,l_FirstAbr);
               l_y := CONVERT(CHAR_TO_NUMBER,l_SecondAbr);
               WHILE (l_x <= l_y) LOOP
                    IF   (l_x <> 0) THEN

                         BEGIN
                              SELECT COUNT(*) INTO l_QtdReg FROM R124HTR
                               WHERE NUMEMP = l_NumEmp AND TIPCOL = l_TipCol AND NUMCAD = l_NumCad AND DATSOL = l_DatSol
                                 AND CODSOL = l_CodSol AND CODTUR = l_x;
                         EXCEPTION
                              WHEN NO_DATA_FOUND THEN
                                   l_QtdReg := 0;
                         END;

                         IF   (l_QtdReg = 0) THEN
                              BEGIN
                                   INSERT INTO R124HTR (NUMEMP, TIPCOL, NUMCAD, DATSOL, CODSOL, CODTUR)
                                        VALUES (l_NumEmp, l_TipCol, l_NumCad, l_DatSol, l_CodSol, l_x);
                              EXCEPTION
                                   WHEN OTHERS THEN
                                        l_aux := 'Erro na Inclusão do Colaborador/2-Abrangência Turno'||l_FirstAbr;
                                        RAISERROR 103 l_aux;
                              END;
                         END IF;
                    END IF;
                    l_x := l_x + 1;
               END LOOP;
          END IF;
          IF   (l_FimAbr = TRUE) THEN
               EXIT;
          END IF;

          l_PosAbr := l_PosAbr + 1;
          l_FirstAbr := '';
          l_SecondAbr := '';
          
          l_IdxAbr    := l_PosAbr;
          RS_BUSARG(l_CamOri, l_IdxAbr, l_PosAbr OUT, l_FimAbr OUT, l_TipSinal OUT, l_FirstAbr OUT, l_SecondAbr OUT);
     END LOOP;
END IF;
END␀Ëì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0*RS_GRVABRTUR
RS_GRVABRHOR
RS_GRVABREMP
ı	␀␀/* ALTERA OS REGISTROS RELACIONADOS AO CANDIDATO QUE ESTÁ SENDO ALTERADO NAS*/
PROCEDURE RS_ALTABR(P_NUMCAN NUMBER(7),P_ABRTUROLD VARCHAR2(255),P_ABRTURNEW VARCHAR2(255),P_ABRHOROLD VARCHAR2(255),P_ABRHORNEW VARCHAR2(255),P_ABREMPOLD VARCHAR2(255),P_ABREMPNEW VARCHAR2(255))
 IS

l_NumCan      NUMBER;
 l_AbrTurOld   VARCHAR2(50);
 l_AbrTurNew   VARCHAR2(50);
 l_AbrHorOld   VARCHAR2(50);
 l_AbrHorNew   VARCHAR2(50);
 l_AbrEmpOld   VARCHAR2(50);
 l_AbrEmpNew   VARCHAR2(50);
BEGIN
     l_NumCan    := p_NumCan;
     l_AbrTurOld := IFNULL(p_AbrTurOld,' ');
     l_AbrTurNew := IFNULL(p_AbrTurNew,' ');
     l_AbrHorOld := IFNULL(p_AbrHorOld,' ');
     l_AbrHorNew := IFNULL(p_AbrHorNew,' ');
     l_AbrEmpOld := IFNULL(p_AbrEmpOld,' ');
     l_AbrEmpNew := IFNULL(p_AbrEmpNew,' ');
/*Abrangência de Turno*/
     IF   l_AbrTurNew <> l_AbrTurOld  THEN
          BEGIN
               DELETE FROM R122CTR WHERE NUMCAN = l_NumCan;
          EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro na exclusão da tabela de abrangência do Candidato - Turno.';
          END;
     END IF;

     IF   l_AbrTurNew <> l_AbrTurOld  THEN
          BEGIN
               RS_GRVABRTUR(l_NumCan, l_AbrTurNew);
          EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro na Inclusão do Candidato-Abrangência Turno.';
          END;
     END IF;

/*Abrangência de Horário*/
     IF   l_AbrHorNew <> l_AbrHorOld  THEN
          BEGIN
               DELETE FROM R122CHR WHERE NUMCAN = l_NumCan;
          EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro na exclusão da tabela de abrangência do Candidato - Horário.';
          END;
     END IF;

     IF   l_AbrHorNew <> l_AbrHorOld  THEN
          BEGIN
               RS_GRVABRHOR(l_NumCan, l_AbrHorNew);
          EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro na Inclusão do Candidato-Abrangência Horário.';
          END;
     END IF;

/*Abrangência de Empresa*/
     IF   l_AbrEmpNew <> l_AbrEmpOld  THEN
          BEGIN
               DELETE FROM R122EMP WHERE NUMCAN = l_NumCan;
          EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro na exclusão da tabela de abrangência do Candidato - Empresa.';
          END;
     END IF;

     IF   l_AbrEmpNew <> l_AbrEmpOld  THEN
          BEGIN
               RS_GRVABREMP(l_NumCan, l_AbrEmpNew);
          EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro na Inclusão do Candidato-Abrangência Empresa.';
          END;
     END IF;
END␀Ìì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RS_BUSSEGARG
Ô␀␀/* Identifica os argumentos de uma abrangência */
PROCEDURE RS_BUSARG(P_CAMORI VARCHAR2(255),P_IDXABR NUMBER(5),P_POSABR OUT NUMBER(5),P_FIMABR OUT BOOLEAN,P_TIPSINAL OUT CHAR,P_FIRSTABR OUT VARCHAR2(255),P_SECONDABR OUT VARCHAR2(255))
 IS

l_ChrAbr      CHAR(1);
 l_limite      NUMBER(4);
 l_x           INTEGER;
 l_FirstAbr    VARCHAR2(25);
 l_PosAbr      NUMBER(5);
BEGIN
l_FirstAbr := '';
p_FirstAbr := '';
p_SecondAbr := '';
p_TipSinal := '';
p_PosAbr := p_IdxAbr;
p_FimAbr := FALSE;
l_limite   := IFNULL(LENGTH(RTRIM(p_CamOri)), 0);
IF   (l_limite = 0) THEN
     RETURN;
END IF;

FOR l_x  IN p_IdxAbr..l_limite LOOP
     p_PosAbr := l_x;
     l_ChrAbr := SUBSTRING(p_CamOri, l_x, 1);
     IF  (l_ChrAbr = ',') THEN
          p_TipSinal := l_ChrAbr;
          RETURN;
     ELSIF (l_ChrAbr = '-') THEN
          p_TipSinal := l_ChrAbr;
          p_PosAbr   := (p_PosAbr + 1);
          l_PosAbr   := p_PosAbr;
          RS_BUSSEGARG(p_CamOri, l_PosAbr, p_PosAbr OUT, p_FimAbr OUT, p_SecondAbr OUT);
          RETURN;
     ELSE
          l_FirstAbr := LTRIM(RTRIM(l_FirstAbr || l_ChrAbr));
          p_FirstAbr := l_FirstAbr;
     END IF;
END LOOP;

p_TipSinal := ',';
p_FimAbr   := TRUE;
END␀Íì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
U␀␀/* Identifica o segundo argumento de uma seqüência,de...até, de uma abrangência */
PROCEDURE RS_BUSSEGARG(P_CAMORI VARCHAR2(255),P_IDXABR NUMBER(5),P_POSABR OUT NUMBER(5),P_FIMABR OUT BOOLEAN,P_SECONDABR OUT VARCHAR2(255))
 IS

l_ChrAbr      CHAR(1);
 l_limite      NUMBER(4);
 l_x           INTEGER;
 l_SecondAbr   VARCHAR2(25);
BEGIN
l_SecondAbr := '';
p_SecondAbr := '';
p_PosAbr := p_IdxAbr;
p_FimAbr := FALSE;
l_limite    := IFNULL(LENGTH(RTRIM(p_CamOri)), 0);
IF   (l_limite = 0) THEN
     RETURN;
END IF;

FOR l_x  IN p_IdxAbr..l_limite LOOP
     p_PosAbr := l_x;
     l_ChrAbr := SUBSTRING(p_CamOri, l_x, 1);
     IF  (l_ChrAbr = ',') THEN
          RETURN;
     ELSE
          l_SecondAbr := LTRIM(RTRIM(l_SecondAbr || l_ChrAbr));
          p_SecondAbr := l_SecondAbr;
     END IF;
END LOOP;

p_FimAbr := TRUE;
END␀Îì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀/* Consiste um campo de abrangência             */
PROCEDURE RS_CRTABR(P_CAMORI VARCHAR2(255),P_RET OUT BOOLEAN)
 IS

l_CamOri      VARCHAR2(50);
 l_ChrAbr      CHAR(1);
 l_limite      INTEGER;
 l_x           INTEGER;
BEGIN
p_ret    := FALSE;
l_CamOri := LTRIM(RTRIM(p_CamOri));
l_limite := IFNULL(LENGTH(l_CamOri), 0);
IF   (l_limite = 0) THEN
     RETURN;
END IF;

l_x := 1;
FOR l_x  IN 1..l_limite LOOP
     l_ChrAbr := SUBSTRING(l_CamOri, l_x, 1);
     IF  (l_ChrAbr <> ',')
     AND (l_ChrAbr <> '-')
     AND (l_ChrAbr <> '0')
     AND (l_ChrAbr <> '1')
     AND (l_ChrAbr <> '2')
     AND (l_ChrAbr <> '3')
     AND (l_ChrAbr <> '4')
     AND (l_ChrAbr <> '5')
     AND (l_ChrAbr <> '6')
     AND (l_ChrAbr <> '7')
     AND (l_ChrAbr <> '8')
     AND (l_ChrAbr <> '9') THEN
          RETURN;
     END IF;
END LOOP;

IF LOCATE(l_CamOri, '--', 1) <> 0 THEN
     RETURN;
END IF;

IF LOCATE(l_CamOri, ',,', 1) <> 0 THEN
     RETURN;
END IF;

IF LOCATE(l_CamOri, '-,', 1) <> 0 THEN
     RETURN;
END IF;

IF LOCATE(l_CamOri, ',-', 1) <> 0 THEN
     RETURN;
END IF;

IF SUBSTRING(l_CamOri, l_limite, 1) = '-' THEN
     RETURN;
END IF;

IF SUBSTRING(l_CamOri, l_limite, 1) = ',' THEN
     RETURN;
END IF;

p_ret := TRUE;
END␀Ïì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀/* DELETA OS REGISTROS RELACIONADOS AO CANDIDATO QUE ESTÁ SENDO DELETADO DAS*/
PROCEDURE RS_DELABR(P_NUMCAN NUMBER(7))
 IS

l_NumCan      NUMBER;
BEGIN
     l_NumCan    := p_NumCan;
     BEGIN
          DELETE FROM R122CTR WHERE NUMCAN = l_NumCan;
     EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro na exclusão da tabela de abrangência de Turno.';
     END;
     BEGIN
          DELETE FROM R122CHR WHERE NUMCAN = l_NumCan;
     EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro na exclusão da tabela de abrangência de Horário.';
     END;
     BEGIN
          DELETE FROM R122EMP WHERE NUMCAN = l_NumCan;
     EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro na exclusão da tabela de abrangência de Empresa.';
     END;
END␀Ğì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Í␀␀/* Store Procedure Delete Curriculo Compilado */
PROCEDURE RS_DELCURCOMP(P_NUMCAN NUMBER(7),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9))
 IS
BEGIN
  BEGIN
    /* DELETE registro da R122CCO */
    DELETE FROM R122CCO
     WHERE NUMCAN = p_NumCan
       AND NUMEMP = p_NumEmp
       AND TIPCOL = p_TipCol
       AND NUMCAD = p_NumCad;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao excluir R122CCO. (RS_DELCURCOMP)';
  END;
END␀Ñì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RS_CRTABR
RS_BUSARG
¼␀␀/* Distrincha o campo de abrangência de Horário gravando a tabela normalizada R124HCA */
PROCEDURE RS_GRVABREMP(P_NUMCAN NUMBER(7),P_CAMORI VARCHAR2(255))
 IS

l_TipSinal    CHAR(1);
 l_FirstAbr    VARCHAR2(25);
 l_SecondAbr   VARCHAR2(25);
 l_IdxAbr      NUMBER;
 l_PosAbr      NUMBER(5);
 l_FimAbr      BOOLEAN;
 l_NumCan      NUMBER;
 l_CamOri      VARCHAR2(50);
 l_x           NUMBER;
 l_y           NUMBER;
 l_ret         BOOLEAN;
 l_QtdReg      NUMBER;
BEGIN
l_CamOri := p_CamOri;
RS_CRTABR(l_CamOri, l_ret OUT);
IF   (l_ret = FALSE) THEN
     RETURN;
END IF;

IF   (LENGTH(RTRIM(l_CamOri)) > 0) THEN
     l_NumCan    := p_NumCan;
     l_PosAbr    := 1;
     l_FimAbr    := FALSE;
     l_FirstAbr  := '';
     l_SecondAbr := '';

     l_IdxAbr    := l_PosAbr;
     RS_BUSARG(l_CamOri, l_IdxAbr, l_PosAbr OUT, l_FimAbr OUT, l_TipSinal OUT, l_FirstAbr OUT, l_SecondAbr OUT);

     WHILE (TRUE = TRUE) LOOP
          IF   (l_TipSinal = ',') THEN
               IF   (CONVERT(CHAR_TO_NUMBER, l_FirstAbr) <> 0) THEN
                    IF   (LENGTH(RTRIM(l_FirstAbr)) > 4) THEN
                         l_FirstAbr := '9999';
                    END IF;

                    BEGIN
                         SELECT COUNT(*) INTO l_QtdReg FROM R122EMP WHERE NUMCAN = l_NumCan AND NUMEMP = CONVERT(CHAR_TO_NUMBER, l_FirstAbr);
                    EXCEPTION
                         WHEN NO_DATA_FOUND THEN
                              l_QtdReg := 0;
                    END;

                    IF   (l_QtdReg = 0) THEN
                         BEGIN
                              INSERT INTO R122EMP (NUMCAN,NUMEMP) VALUES (l_NumCan, CONVERT(CHAR_TO_NUMBER, l_FirstAbr));
                         EXCEPTION
                              WHEN OTHERS THEN
                                   RAISERROR 103 'Erro na Inclusão do Candidato-Abrangência Empresa.';
                         END;
                    END IF;
               END IF;
          ELSE
               IF   (LENGTH(RTRIM(l_FirstAbr)) > 4) THEN
                    l_FirstAbr := '9999';
               END IF;
               IF   (LENGTH(RTRIM(l_SecondAbr)) > 4) THEN
                    l_SecondAbr := '9999';
               END IF;

               l_x := CONVERT(CHAR_TO_NUMBER, l_FirstAbr);
               l_y := CONVERT(CHAR_TO_NUMBER, l_SecondAbr);
               WHILE (l_x <= l_y) LOOP
                    IF   (l_x <> 0) THEN

                         BEGIN
                              SELECT COUNT(*) INTO l_QtdReg FROM R122EMP WHERE NUMCAN = l_NumCan AND NUMEMP = CONVERT(CHAR_TO_NUMBER, l_x);
                         EXCEPTION
                              WHEN NO_DATA_FOUND THEN
                                   l_QtdReg := 0;
                         END;

                         IF   (l_QtdReg = 0) THEN
                              BEGIN
                                   INSERT INTO R122EMP (NUMCAN,NUMEMP) VALUES (l_NumCan, CONVERT(CHAR_TO_NUMBER, l_x));
                              EXCEPTION
                                   WHEN OTHERS THEN
                                        RAISERROR 103 'Erro na Inclusão do Candidato-Abrangência Empresa.';
                              END;
                         END IF;
                    END IF;
                    l_x := l_x + 1;
               END LOOP;
          END IF;
          IF   (l_FimAbr = TRUE) THEN
               EXIT;
          END IF;

          l_PosAbr := l_PosAbr + 1;
          l_FirstAbr := '';
          l_SecondAbr := '';

          l_IdxAbr    := l_PosAbr;
          RS_BUSARG(l_CamOri, l_IdxAbr, l_PosAbr OUT, l_FimAbr OUT, l_TipSinal OUT, l_FirstAbr OUT, l_SecondAbr OUT);
     END LOOP;
END IF;
END␀Òì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RS_CRTABR
RS_BUSARG
