¶␀␀PROCEDURE SP_R058LTP(P_IFUNC CHAR(12))
 IS

l_IFunc  CHAR(12);
  l_TipLtp NUMBER(1);
  l_CodPlt NUMBER(3);
  l_CodRlg NUMBER(5);
  l_UsuAti NUMBER(1);
  l_DatAtu DATE;
  CURSOR c_BuscaDspRep IS 
    SELECT 
      R058RLG.CODPLT R058RLG_CODPLT,R058RLG.CODRLG R058RLG_CODRLG
       FROM R058RLG R058RLG,R058MOD R058MOD
       WHERE (R058MOD.MODRLG=R058RLG.MODRLG) 
      AND (R058MOD.TIPMOD IN (16)) 
      AND (R058RLG.COMRLG=2);
  TYPE t_BuscaDspRep IS RECORD (
    CODPLT   R058RLG.CODPLT%TYPE,
    CODRLG   R058RLG.CODRLG%TYPE
  );
  l_BuscaDspRep t_BuscaDspRep;
BEGIN
  l_IFunc := p_IFunc;
  l_TipLtp := 3;
  l_UsuAti := 1;
  l_DatAtu := CURDATE();
  FOREACH c_BuscaDspRep INTO l_BuscaDspRep.CODPLT,
                             l_BuscaDspRep.CODRLG
  LOOP
      l_CodPlt := 0;
      BEGIN
        SELECT R058LTP.CODPLT CODPLT INTO l_CodPlt 
          FROM R058LTP R058LTP
         WHERE TIPLTP=l_TipLtp 
           AND CODPLT=l_BuscaDspRep.CODPLT 
           AND CODRLG=l_BuscaDspRep.CODRLG 
           AND NUMCRA=l_IFunc;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_CodPlt := -1;
        WHEN OTHERS THEN
		      RAISERROR 103 'SP_R058LTP: Erro no SELECT da tabela R058LTP.';          
      END;
      IF (l_CodPlt=-1) THEN
        l_CodPlt := l_BuscaDspRep.CODPLT;
        l_CodRlg := l_BuscaDspRep.CODRLG;
        BEGIN
          INSERT INTO R058LTP (TIPLTP, CODPLT, CODRLG, NUMCRA, DATINC, CODUSU) VALUES (l_TipLtp, l_CodPlt, l_CodRlg, l_IFunc, l_DatAtu, l_UsuAti);        
        EXCEPTION
          WHEN OTHERS THEN
            RAISERROR 103 'SP_R058LTP: Erro ao inserir na tabela R058LTP.';
        END;
      END IF;	 
  END LOOP;
END		SENIOR;23
