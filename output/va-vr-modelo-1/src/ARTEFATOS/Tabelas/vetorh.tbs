#␀␀PROCEDURE SP_BLOCOLVIS(P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_DATINI DATE,P_HORINI NUMBER,P_DATFIM DATE,P_HORFIM NUMBER,P_CODUSU NUMBER,P_MBLVIS NUMBER)
IS

    l_datatu      DATE;
    l_horatu      NUMBER;
    l_datzer      DATE;
    l_numcpf      NUMBER(11);

    CURSOR c_R034FUN_PSP IS SELECT A.NUMEMP, A.TIPCOL, A.NUMCAD
                            FROM R034FUN  A, R010SIT B
                            WHERE (NUMPSP = p_numdoc) AND A.SITAFA = B.CODSIT AND
                                  B.BLOACE = 'N' AND B.TIPSIT <> 7;

    CURSOR c_R034FUN_CPF IS SELECT A.NUMEMP, A.TIPCOL, A.NUMCAD
                            FROM R034FUN  A, R010SIT B
                            WHERE (A.NUMCPF = l_numcpf) AND A.SITAFA = B.CODSIT AND
                                  B.BLOACE = 'N' AND B.TIPSIT <> 7;
    TYPE t_R034FUN IS RECORD(
        NUMEMP   R034FUN.NUMEMP%TYPE,
        TIPCOL   R034FUN.TIPCOL%TYPE,
        NUMCAD   R034FUN.NUMCAD%TYPE);
    l_R034FUN t_R034FUN;
BEGIN
    IF (P_TIPDOC = 2) THEN
        l_numcpf := CONVERT(NUMBER_TO_CHAR, P_NUMDOC);
        FOREACH c_R034FUN_CPF INTO l_R034FUN.numemp,
                                   l_R034FUN.tipcol,
                                   l_R034FUN.numcad
        LOOP
            SP_BLOCOLVIS_UPD(l_R034FUN.numemp, l_R034FUN.tipcol, l_R034FUN.numcad, P_DATINI ,P_HORINI ,P_DATFIM ,P_HORFIM ,P_CODUSU ,P_MBLVIS);
        END LOOP;
    END IF;

    IF (P_TIPDOC = 4) THEN
        FOREACH c_R034FUN_PSP INTO l_R034FUN.numemp,
                                   l_R034FUN.tipcol,
                                   l_R034FUN.numcad
        LOOP
            SP_BLOCOLVIS_UPD(l_R034FUN.numemp, l_R034FUN.tipcol, l_R034FUN.numcad, P_DATINI ,P_HORINI ,P_DATFIM ,P_HORFIM ,P_CODUSU ,P_MBLVIS);
        END LOOP;
    END IF;
END␀û÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0

␀␀PROCEDURE SP_BLOCOLVIS_UPD(P_EMPBLO NUMBER(4),P_TIPBLO NUMBER(1),P_CADBLO NUMBER(9), P_DATINI DATE,P_HORINI NUMBER,P_DATFIM DATE,P_HORFIM NUMBER,P_CODUSU NUMBER,P_MBLVIS NUMBER) IS

    l_datatu      DATE;
    l_horatu      NUMBER;
    l_datzer      DATE;
    l_staacc      NUMBER(1);
    l_count       NUMBER(1);
BEGIN
    l_datatu := CURDATE();
    l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_datzer := '31/12/1900,00:00:00';

    l_staAcc := 0;
    IF (p_DatIni > l_datatu) OR ((p_DatIni = l_datatu) AND (p_HorIni > l_horatu)) THEN
        l_staAcc := 0;
    ELSE
        IF (p_DatFim <> l_datzer) AND
           ((p_DatFim < l_datatu) OR
           ((p_DatFim = l_datatu) AND ((p_HorFim <= l_horatu) AND (p_HorFim <> 0)))) THEN
            l_StaAcc := 2;
        ELSE
            l_StaAcc := 1;
        END IF;
    END IF;  

    /* Se existe colaborador */
    IF (p_empblo > 0) THEN
        IF (p_mblvis = 0) THEN
            /* Se o motivo passado for zero, significa que foi excluído a r090MVI, então exclui tb a R070BLO */
            BEGIN
                DELETE FROM R070BLO WHERE NUMEMP = p_empblo AND TIPCOL = p_tipblo AND NUMCAD = p_cadblo AND DATBLO = p_datini AND HORBLO = p_horini;
            EXCEPTION
                WHEN OTHERS THEN NULL;
            END;
        ELSE
            l_count := 0;
            BEGIN
                SELECT COUNT(*) INTO l_count FROM R070BLO
                WHERE NUMEMP = p_empblo AND TIPCOL = p_tipblo AND NUMCAD = p_cadblo AND DATBLO = p_datini AND HORBLO = p_horini;
            EXCEPTION
                WHEN OTHERS THEN l_count := 0;
            END;
            IF (l_count = 0) THEN /* Entrada de visitante */
                BEGIN
                    INSERT INTO R070BLO (NUMEMP, TIPCOL, NUMCAD, DATBLO, HORBLO, CODMOT, EMPAUT, TCLAUT, CADAUT, CODUSU, NUMCRA, DATLIB, HORLIB, OBSBLO, USULIB, STAACC)
                    VALUES (p_empblo, p_tipblo, p_cadblo, p_datini, p_horini, p_mblvis, 0, 0, 0, p_codusu, 0, p_datfim, p_horfim, '', 0, l_staacc);
                EXCEPTION 
                    WHEN OTHERS THEN NULL;
                END;
            ELSE /* Baixa de visitante */
                BEGIN
                    UPDATE R070BLO SET DATLIB = p_datfim, HORLIB = p_horfim, USULIB = p_codusu, STAACC = 2 
                        WHERE NUMEMP = p_empblo AND TIPCOL = p_tipblo AND NUMCAD = p_cadblo AND DATBLO = p_datini AND HORBLO = p_horini;
                EXCEPTION 
                    WHEN OTHERS THEN NULL;
                END;
            END IF;
        END IF;
    END IF;
END␀ü÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
