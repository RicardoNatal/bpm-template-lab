                DEALLOCATE CUR_r090vis_UPD_OLD
                CLOSE CUR_r090vis_UPD_NEW
                DEALLOCATE CUR_r090vis_UPD_NEW
                SELECT @ChkError = -30
                GOTO FIM
              END
            END
          END
        /* END EXCEPTION HANDLER */
      END
