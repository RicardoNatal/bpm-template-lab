  R044CAL.NUMEMP,
  R044CAL.CODCAL,
  R044CAL.INICMP,
  R044CAL.FIMCMP,
  R044TVL.CODVAL,
  R044CAL.INIVAL INIAPU,
  R044CAL.FIMVAL FIMAPU,
  R044CAL.INIFVL INIFAL,
  R044CAL.FIMFVL FIMFAL
FROM
  R044TVL,
  R044CAL,
  R250TAB
WHERE
  R044CAL.CODCAL = R250TAB.CODCAL AND
  R044CAL.INIVAL <> DAY(1900,12,31) AND
  R044TVL.BASTVL = 'G' AND
  NOT EXISTS(
             SELECT 
               1 
             FROM 
               R044ATV 
             WHERE 
               R044ATV.TABEVE = R044TVL.TABEVE AND              
               R044ATV.CODVAL = R044TVL.CODVAL AND 
               R044ATV.NUMEMP = R044CAL.NUMEMP AND
               R044ATV.CODCAL = R250TAB.CODCAL
            )

UNION

SELECT
  R044CAL.NUMEMP,
  R044CAL.CODCAL,
  R044CAL.INICMP,
  R044CAL.FIMCMP,
  R044TVL.CODVAL,
  R044CAL.INICMP INIAPU,
  R044CAL.FIMCMP FIMAPU,
  R044CAL.INIFVL INIFAL,
  R044CAL.FIMFVL FIMFAL
FROM
  R044TVL,
  R044CAL,
  R250TAB
WHERE
  R044CAL.CODCAL = R250TAB.CODCAL AND
  R044CAL.INIVAL = DAY(1900,12,31) AND
  R044TVL.BASTVL = 'G' AND
  NOT EXISTS(
             SELECT 
               1 
             FROM 
               R044ATV 
             WHERE 
               R044ATV.TABEVE = R044TVL.TABEVE AND              
               R044ATV.CODVAL = R044TVL.CODVAL AND 
               R044ATV.NUMEMP = R044CAL.NUMEMP AND
               R044ATV.CODCAL = R250TAB.CODCAL
            )

UNION

SELECT 
  R044ATV.NUMEMP, 
  R044ATV.CODCAL,
  R044CAL.INICMP,
  R044CAL.FIMCMP,
  R044ATV.CODVAL, 
  R044ATV.INIAPU,
  R044ATV.FIMAPU,
  R044ATV.INIFAL,
  R044ATV.FIMFAL
FROM 
  R044CAL,
  R044ATV, 
  R250TAB
WHERE
  R044CAL.NUMEMP = R044ATV.NUMEMP AND
  R044CAL.CODCAL = R044ATV.CODCAL AND
  R044CAL.CODCAL = R250TAB.CODCAL␀␀ÿb␀s␀Š␀␀␀␀␀␀␀␀␀ay␀␀n␀␀Æÿ␀␀ÿ␀/#A␀␀␀␀␀␀␀␀ã•␀␀¢Æ␀␀¢Æ␀␀C␀␀ÿ␀␀ÿ␀ó¥␀␀´␀	␀␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀W␀Š␀	␀␀␀␀␀␀␀␀›␀t␀Ü␀n␀Æÿ␀␀ÿ␀ê¥␀␀Ì␀	␀␀␀␀␀␀␀␀õ?0.0.w␀Æÿ␀␀ÿ␀$␀±␀	␀␀␀␀␀␀␀␀>´␀,␀q␀Æÿ␀␀ÿ␀K#·␀	␀␀␀␀␀␀␀␀I=K␀ÅAs␀Æÿ␀␀ÿ␀NCÑ␀␀␀␀␀␀␀␀␀ÿä”␀␀jqC␀␀êÿ␀␀ÿ␀#É␀␀¯␀␀␀␀␀␀␀␀␀ÿ>Ë␀␀°Ë␀␀)␀␀	␀Æÿ␀␀ÿ␀£␀¯␀␀␀␀␀␀␀␀␀Q$␀¦␀W$␀_)␀␀Æÿ␀␀ÿ␀¤␀‘␀␀␀␀␀␀␀␀␀Q$␀ª␀X$␀_)␀␀Æÿ␀␀ÿ␀ø¥␀␀␀␀␀␀␀␀␀␀j±␀␀j±␀␀j±␀␀#␀␀ÿ␀␀ÿ␀ë¥␀␀8␀␀␀␀␀␀␀␀³±␀␀²±␀␀²±␀␀?␀␀ÿ␀␀ÿ␀␀ğ␀␀ SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PVT.NUMEMP, PVT.TIPCOL, PVT.NUMCAD, 0 TABEVE, PVT.CODLIN CODVAL, 
            PER.INIVTR DATENT, SUM(PVT.QTDPAS) QTDVAL, PVT.VALPAS VLRVAL, PVT.VALPAS VLRVL2, LVT.NUMITN NUMITN, EVN.NUMCAR NUMCAR
FROM
  R028PVT PVT, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVN EVN, R038EVT EVT
WHERE
  PVT.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PVT.CODLIN = LVT.CODLIN
  AND PVT.STAPVT = 'E'
  AND PVT.DATVTR >= PER.INIVTR
  AND PVT.DATVTR <= PER.FIMVTR
  AND PER.NUMEMP = PVT.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
  AND PVT.NUMEMP = EVT.NUMEMP
  AND PVT.TIPCOL = EVT.TIPCOL
  AND PVT.NUMCAD = EVT.NUMCAD
  AND PVT.DATVTR >= EVT.INIEVT
  AND ((PVT.DATVTR <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND EVN.NUMEMP = EVT.NUMEMP
  AND EVN.TIPCOL = EVT.TIPCOL
  AND EVN.NUMCAD = EVT.NUMCAD
  AND EVN.INIEVT = EVT.INIEVT
  AND EVN.CODLIN = PVT.CODLIN	
GROUP BY
  LVT.CODITN, PVT.NUMEMP, PVT.TIPCOL, PVT.NUMCAD, PVT.CODLIN, PER.INIVTR, PVT.VALPAS, LVT.NUMITN, EVN.NUMCAR
	
UNION

SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PVT.NUMEMP, PVT.TIPCOL, PVT.NUMCAD, 0 TABEVE, PVT.CODLIN CODVAL, 
            PER.INIVTR DATENT, SUM(PVT.QTDPAS) QTDVAL, PVT.VALPAS VLRVAL, PVT.VALPAS VLRVL2, LVT.NUMITN NUMITN, '' NUMCAR
FROM
  R028PVT PVT, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVT EVT
WHERE
  PVT.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PVT.CODLIN = LVT.CODLIN
  AND PVT.STAPVT = 'E'
  AND PVT.DATVTR >= PER.INIVTR
  AND PVT.DATVTR <= PER.FIMVTR
  AND PER.NUMEMP = PVT.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)	
  AND PVT.NUMEMP = EVT.NUMEMP
  AND PVT.TIPCOL = EVT.TIPCOL
  AND PVT.NUMCAD = EVT.NUMCAD
  AND PVT.DATVTR >= EVT.INIEVT
  AND ((PVT.DATVTR <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND NOT EXISTS (SELECT 1 FROM R038EVN EVN 	
                   WHERE EVN.NUMEMP = EVT.NUMEMP
                     AND EVN.TIPCOL = EVT.TIPCOL
                     AND EVN.NUMCAD = EVT.NUMCAD
                     AND EVN.INIEVT = EVT.INIEVT
                     AND EVN.CODLIN = PVT.CODLIN)	
GROUP BY
  LVT.CODITN, PVT.NUMEMP, PVT.TIPCOL, PVT.NUMCAD, PVT.CODLIN, PER.INIVTR, PVT.VALPAS, LVT.NUMITN
	
UNION

SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, 0 TABEVE, PDI.CODLIN CODVAL, 
            PER.INIFVT DATENT, SUM(PDI.QTDPAS * -1) QTDVAL, PDI.VALPAS * -1 VLRVAL, PDI.VALPAS VLRVL2, LVT.NUMITN NUMITN, EVN.NUMCAR 
NUMCAR
FROM 
  R028PDI PDI, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVN EVN, R038EVT EVT
WHERE 
  PDI.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PER.INIFVT <> DAY(1900,12,31)
  AND PER.FIMFVT <> DAY(1900,12,31)
  AND PDI.CODLIN = LVT.CODLIN
  AND PDI.DATFAL >= PER.INIFVT
  AND PDI.DATFAL <= PER.FIMFVT
  AND PER.NUMEMP = PDI.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)	
  AND PDI.NUMEMP = EVT.NUMEMP
  AND PDI.TIPCOL = EVT.TIPCOL 
  AND PDI.NUMCAD = EVT.NUMCAD	
  AND PDI.DATFAL >= EVT.INIEVT
  AND ((PDI.DATFAL <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND EVN.NUMEMP = EVT.NUMEMP
  AND EVN.TIPCOL = EVT.TIPCOL
  AND EVN.NUMCAD = EVT.NUMCAD
  AND EVN.INIEVT = EVT.INIEVT
  AND EVN.CODLIN = PDI.CODLIN			
GROUP BY
  LVT.CODITN, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, PDI.CODLIN, PER.INIFVT, PDI.VALPAS, LVT.NUMITN, EVN.NUMCAR

UNION

SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, 0 TABEVE, PDI.CODLIN CODVAL, 
            PER.INIFVT DATENT, SUM(PDI.QTDPAS * -1) QTDVAL, PDI.VALPAS * -1 VLRVAL, PDI.VALPAS VLRVL2, LVT.NUMITN NUMITN, '' NUMCAR
FROM 
  R028PDI PDI, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVT EVT
WHERE 
  PDI.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PER.INIFVT <> DAY(1900,12,31)
  AND PER.FIMFVT <> DAY(1900,12,31)
  AND PDI.CODLIN = LVT.CODLIN
  AND PDI.DATFAL >= PER.INIFVT
  AND PDI.DATFAL <= PER.FIMFVT
  AND PER.NUMEMP = PDI.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)	
  AND PDI.NUMEMP = EVT.NUMEMP
  AND PDI.TIPCOL = EVT.TIPCOL
  AND PDI.NUMCAD = EVT.NUMCAD
  AND PDI.DATFAL >= EVT.INIEVT
  AND ((PDI.DATFAL <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND NOT EXISTS (SELECT 1 FROM R038EVN EVN 	
                   WHERE EVN.NUMEMP = EVT.NUMEMP
                     AND EVN.TIPCOL = EVT.TIPCOL
                     AND EVN.NUMCAD = EVT.NUMCAD
                     AND EVN.INIEVT = EVT.INIEVT
                     AND EVN.CODLIN = PDI.CODLIN)		
GROUP BY
  LVT.CODITN, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, PDI.CODLIN, PER.INIFVT, PDI.VALPAS, LVT.NUMITN

UNION

SELECT 
  2 TIPVAL, TVL.CODPRD, GER.NUMEMP, GER.TIPCOL, GER.NUMCAD, TVL.TABEVE, TVL.CODVAL, 
            PER.INIAPU DATENT, SUM(GER.QTDVAL), GER.VLRVAL, GER.VLRVAL VLRVL2, '0' NUMITN, '' NUMCAR
FROM 
  R162GER GER, R044TVL TVL, VBS_PERVAL PER, R030EMP EMP, R250TAB TAB
WHERE 
  TVL.CODVAL = GER.CODVAL 
  AND GER.QTDVAL > 0
  AND GER.STAVAL IN ('E', 'F')
  AND GER.DATVAL >= PER.INIAPU
  AND GER.DATVAL <= PER.FIMAPU
  AND PER.NUMEMP = GER.NUMEMP
  AND PER.CODVAL = TVL.CODVAL
  AND PER.NUMEMP = EMP.NUMEMP
  AND TVL.TABEVE = EMP.TABEVE
  AND GER.NUMEMP = EMP.NUMEMP
  AND NOT TVL.CODPRD IS NULL
  AND (TVL.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
GROUP BY
  TVL.CODPRD, GER.NUMEMP, GER.TIPCOL, GER.NUMCAD, TVL.TABEVE, TVL.CODVAL, PER.INIAPU, GER.VLRVAL

UNION

SELECT 
  2 TIPVAL, TVL.CODPRD, GER.NUMEMP, GER.TIPCOL, GER.NUMCAD, TVL.TABEVE, TVL.CODVAL, 
            PER.INIFAL DATENT, SUM(GER.QTDVAL * -1), GER.VLRVAL * -1, GER.VLRVAL VLRVL2, '0' NUMITN, '' NUMCAR
FROM 
  R162GER GER, R044TVL TVL, VBS_PERVAL PER, R030EMP EMP, R250TAB TAB
WHERE 
  TVL.CODVAL = GER.CODVAL 
  AND GER.QTDVAL > 0
  AND GER.STAVAL = 'F'
  AND GER.DATVAL >= PER.INIFAL
  AND GER.DATVAL <= PER.FIMFAL
  AND PER.NUMEMP = GER.NUMEMP
  AND PER.CODVAL = TVL.CODVAL
  AND PER.NUMEMP = EMP.NUMEMP
  AND TVL.TABEVE = EMP.TABEVE
  AND GER.NUMEMP = EMP.NUMEMP
  AND NOT TVL.CODPRD IS NULL
  AND (TVL.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
GROUP BY
  TVL.CODPRD, GER.NUMEMP, GER.TIPCOL, GER.NUMCAD, TVL.TABEVE, TVL.CODVAL, PER.INIFAL, GER.VLRVALVBS_PERVTR
VBS_PERVAL
