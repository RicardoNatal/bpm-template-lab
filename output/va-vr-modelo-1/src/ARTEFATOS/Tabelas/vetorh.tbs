DECLARE
  l_codrpa NUMBER(15);
  l_temAud BOOLEAN;
  l_datTemp VARCHAR(10);
BEGIN
  SP_EXISTE_LOG(19, 151, 1, l_temAud OUT);  

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, 19, 1, 151, 1, 'R026VLR_SI', 'FR026VLR'); 
    BEGIN
      SP_DATSTR(:NEW.COMVLR, 'MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'COMVLR', l_datTemp);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODVLR', CONVERT(NUMBER_TO_CHAR, :NEW.CODVLR));
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R026VLR_SI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

   BEGIN
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESVLR', :NEW.DESVLR);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALVLR', CONVERT(NUMBER_TO_CHAR, :NEW.VALVLR));
   END;
  END IF;
END␀»Ñ␀␀		SENIOR;0†␀␀

TRIGGER R026VLR_SU AFTER UPDATE ON R026VLR FOR EACH ROW
DECLARE
  l_codrpa NUMBER(15);
  l_temAud BOOLEAN;
  l_datTemp VARCHAR(10);
BEGIN
IF ((:OLD.ComVlr <> :NEW.ComVlr)
OR (:OLD.CodVlr <> :NEW.CodVlr)
OR (:OLD.DesVlr <> :NEW.DesVlr)
OR (:OLD.ValVlr <> :NEW.ValVlr)) THEN
    SP_EXISTE_LOG(19, 152, 1, l_temAud OUT);    
  
    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, 1, 19, 1, 152, 1, 'R026VLR_SU', 'FR026VLR');
     
      BEGIN
        SP_DATSTR(:OLD.COMVLR, 'MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'COMVLR', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODVLR', CONVERT(NUMBER_TO_CHAR, :OLD.CODVLR));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R026VLR_SU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN 
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDESVLR', :OLD.DESVLR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDESVLR', :NEW.DESVLR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVALVLR', CONVERT(NUMBER_TO_CHAR, :OLD.VALVLR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWVALVLR', CONVERT(NUMBER_TO_CHAR, :NEW.VALVLR));        
      END;
    END IF;
  END IF;
END␀¹Ñ␀␀		SENIOR;0İ␀␀

