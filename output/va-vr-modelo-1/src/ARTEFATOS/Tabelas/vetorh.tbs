¦
␀␀PROCEDURE R064TPE_ATUCON(P_TIPCOL NUMBER,P_NUMEMP NUMBER,P_NUMCAD NUMBER,P_DATINI DATE,P_DATFIM DATE,P_CODPRM NUMBER,P_PRMSAB NUMBER,P_PRMDOM NUMBER,P_PRMFER NUMBER)
 IS

l_cracha      NUMBER(12);
  l_crastr      CHAR(12);
  l_craaux      NUMBER(12);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
BEGIN
  l_cracha := 0;

  SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
  IF   l_cracha = 0 THEN
       SP_RETCRA_IDTPES (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
  END IF;

  /* Verifica se Colaborador possui Cracha */
  IF   (l_cracha <> 0) THEN
       /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
       SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
       IF (l_crapri = 0) THEN
           l_crapri := l_cracha;
       END IF;
       /* atualiza r070con */
       BEGIN
           UPDATE R070CON SET CODPRM=p_codprm, PRMSAB=p_prmsab, PRMDOM=p_prmdom, PRMFER=p_prmfer
           WHERE NUMFIS = l_crapri;
           /*Atualiza a permissão dos crachás secundários*/
           SP_UPDPRM(l_cracha,p_codprm,p_prmsab,p_prmdom,p_prmfer,' ',' ',' ');
       EXCEPTION
           WHEN OTHERS THEN NULL;
       END;
       /*Atualiza a Pend_grupo se possuir smart*/
       IF (l_numsma > 0) THEN
           /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
           IF (l_tecpri = 3) THEN
               SP_ATUPRM(l_cracha, l_numsma, p_codprm, 0, 0, 0, p_prmsab, p_prmdom, p_prmfer);
           ELSE
               SP_ATUPRM(l_crapri, l_numsma, p_codprm, 0, 0, 0, p_prmsab, p_prmdom, p_prmfer);
           END IF;
       END IF;


       /*Atualiza a Controle*/
       /*Obtem o Tipo de Pessoa*/
       SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
       SP_INTSTR(p_numemp,'9999',l_numemp OUT);
       SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
       SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
       l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
       /*Preenche o campo com espaços para completar 23 posições*/
       l_idtpes := lTrim(l_idtpes);
       l_idtpes := rTrim(l_idtpes);
       LOOP
           /*Controle do Loop.*/
           IF (Length(l_idtpes) > 22) THEN
               EXIT;
           END IF;
           l_idtpes := ' '||l_idtpes;
       END LOOP;
       /*Procedure que atualiza a controle*/
       SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
  END IF;
END		SENIOR;23ISP_RETCRA_IDTPES
SP_MAPFIS
SP_UPDPRM
SP_ATUPRM
SP_INTSTR
SP_ATUTSI
