␀␀/* Retornar o período de uma determinada revisão de GHE */
PROCEDURE SM_RETINFREVGHE(p_CodPRA NUMBER, p_CodGHE NUMBER, p_RevGHE VARCHAR(10), p_DatIniOut OUT DATE, p_DatTerOut OUT DATE, p_SitEsoOut OUT NUMBER(1))
IS

	l_DatIni   R583REV.DatIni%TYPE;
	l_DatTer   R583REV.DatTer%TYPE;
	l_SitEso   R583REV.SitEso%TYPE;
BEGIN
    BEGIN
    	SELECT DatIni, DatTer, SitEso INTO l_DatIni, l_DatTer, l_SitEso FROM R583REV WHERE CodPRA = p_CodPRA AND CodGHE = p_CodGHE AND RevGHE = p_RevGHE;
    EXCEPTION
    	WHEN NO_DATA_FOUND THEN
    		RAISERROR 103 'Não foi encontrado a revisão de GHE.';
        WHEN OTHERS THEN
        	RAISERROR 103 'Erro ao buscar informações da revisão de GHE.';
    END;
    
    p_DatIniOut := l_DatIni;
    p_DatTerOut := l_DatTer;
    p_SitEsoOut := l_SitEso;
END␀ß÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
,␀␀PROCEDURE SP_ADDLOG(PEVTIDT NUMBER,PEVTTIM NUMBER,PEVTUSR NUMBER,PEVTDA1 VARCHAR2(255),PEVTDA2 VARCHAR2(255),PEVTDA3 VARCHAR2(255),PEVTDA4 VARCHAR2(255),PEVTDA5 VARCHAR2(255),PEVTDA6 VARCHAR2(255),PEVTDA7 VARCHAR2(255),PEVTDA8 VARCHAR2(255),PEVTDA9 VARCHAR2(255),PEVTDA10 VARCHAR2(255),PEVTDA11 VARCHAR2(255),PEVTDA12 VARCHAR2(255),PEVTDA13 VARCHAR2(255),PEVTDA14 VARCHAR2(255),PEVTDA15 VARCHAR2(255),PEVTDA16 VARCHAR2(255),PEVTDA17 VARCHAR2(255),PEVTDA18 VARCHAR2(255),PEVTDA19 VARCHAR2(255),PEVTDA20 VARCHAR2(255),PEVTDA21 VARCHAR2(255),PEVTDA22 VARCHAR2(255),PEVTDA23 VARCHAR2(255),PEVTDA24 VARCHAR2(255),PEVTDA25 VARCHAR2(255),PEVTDA26 VARCHAR2(255),PEVTDA27 VARCHAR2(255),PEVTDA28 VARCHAR2(255),PEVTDA29 VARCHAR2(255),PEVTDA30 VARCHAR2(255),PEVTDA31 VARCHAR2(255),PEVTDA32 VARCHAR2(255)) IS
