DECLARE
/* CURSOR c/ os registros gravados no R171apf_AUX */
  CURSOR c_r171apf_ins IS
  SELECT NUMEMP,TIPCOL,NUMCAD FROM R171APF_AUX;
  TYPE t_r171apf_aux IS RECORD(
    NUMEMP   R171apf_AUX.NUMEMP%TYPE,
    TIPCOL   R171apf_AUX.TIPCOL%TYPE,
    NUMCAD   R171apf_AUX.NUMCAD%TYPE);
  l_r171apf_aux t_r171apf_aux;


BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r171apf_ins INTO  l_r171apf_aux.NUMEMP,
                              l_r171apf_aux.TIPCOL,
                              l_r171apf_aux.NUMCAD
  LOOP
    SP_ATUHOR(l_r171apf_aux.NUMEMP, l_r171apf_aux.TIPCOL, l_r171apf_aux.NUMCAD,'');
  END LOOP;
  /* Apaga Registro OLD/NEW em R171apf_AUX */
  BEGIN
    DELETE FROM R171apf_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀}ã␀␀		SENIOR;0»␀␀

TRIGGER R171APF_EI AFTER INSERT ON R171APF FOR EACH ROW

DECLARE
  l_online BOOLEAN;
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       BEGIN
       /* Insere Registro NEW */
         INSERT INTO R171APF_AUX (NUMEMP,TIPCOL,NUMCAD)
         VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD);
       EXCEPTION WHEN OTHERS THEN
         RAISERROR 103 'Erro no INSERT em R171APF_AUX.';
       END;
  END IF;
END␀ã␀␀	SENIOR;0.␀␀

