2 AS HISPRG,
NUMEMP,
TIPCOL,
NUMCAD,
DATINI,
HORINI,
DATFIM,
HORFIM,
R016HIE.TABORG TABORG, 
R016HIE.NUMLOC NUMLOC,
R016HIE.CODLOC CODLOC,
R016HIE.POSLOC POSLOC,
'N' AS CONTOV,
'N' AS CONTOS
FROM R064LOC,R016HIE
WHERE
R016HIE.TABORG = R064LOC.TABORG  AND
R016HIE.NUMLOC = R064LOC.NUMLOC  AND 
R016HIE.DATINI <= R064LOC.DATINI AND
R016HIE.DATFIM >= R064LOC.DATINI
UNION ALL
(SELECT
1 AS HISPRG,
A.NUMEMP NUMEMP,
A.TIPCOL TIPCOL,
A.NUMCAD NUMCAD,
A.DATALT DATINI,
0 HORINI,
DATETIMEADD(DD, -1, B.DATALT) DATFIM,
0 HORFIM,
R016HIE.TABORG TABORG,
R016HIE.NUMLOC NUMLOC,
R016HIE.CODLOC CODLOC,
R016HIE.POSLOC POSLOC,
A.CONTOV CONTOV,
A.CONTOS CONTOS
FROM R038HLO A, R038HLO B, R016HIE
WHERE
A.NUMEMP = B.NUMEMP AND 
A.TIPCOL = B.TIPCOL AND
A.NUMCAD = B.NUMCAD AND
B.DATALT = (SELECT MIN(DATALT) FROM R038HLO WHERE
	A.NUMEMP = R038HLO.NUMEMP AND
	A.TIPCOL = R038HLO.TIPCOL AND
	A.NUMCAD = R038HLO.NUMCAD AND
	R038HLO.DATALT > A.DATALT) AND 
R016HIE.TABORG = A.TABORG  AND
R016HIE.NUMLOC = A.NUMLOC  AND 
R016HIE.DATINI <= A.DATALT AND
R016HIE.DATFIM >= A.DATALT
UNION ALL
(
SELECT
1 AS HISPRG,
NUMEMP,
TIPCOL,
NUMCAD,
