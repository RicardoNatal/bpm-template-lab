/* DELETE (OLD) */
TRIGGER R016HIE_ED AFTER DELETE ON R016HIE FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs HierarquiaLocaisOrganograma*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 70;     /* HierarquiaLocaisOrganograma*/
  l_codtpa := 251;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R016HIE_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :OLD.TABORG));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', CONVERT(NUMBER_TO_CHAR, :OLD.NUMLOC));
        SP_DATSTR(:OLD.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R016HIE_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:OLD.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATFIM', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSLOC', :OLD.POSLOC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODLOC', :OLD.CODLOC);
      END;
  END IF; 
END␀␀␀Ev␀␀␀␀␀␀SĞ␀␀Ş␀´␀Ôÿ!␀␀␀␀␀>¶␀␀¶␀␀r␀Æÿ␀␀YĞ␀␀␀mDÑ␀Ôÿ!␀␀␀␀␀ĞIÙEÙEqC␀êÿ␀␀ÿ␀q␀¢Ôÿ!␀␀␀␀␀r␀ç␀ç␀n␀Æÿ␀␀ÿ␀mš␀␀Ôÿ!␀␀␀␀␀Íš␀␀«š␀␀«š␀␀"␀␀ÿ␀␀ÿ␀	UoÔÿ!␀␀␀␀␀Y°V°Vi␀␀ÿ␀␀ÿ␀[š␀␀Ôÿ!␀␀␀␀␀Àš␀␀š␀␀š␀␀"␀␀ÿ␀␀ÿ␀]ToÔÿ!␀␀␀␀␀Y°V°Vi␀␀ÿ␀␀ÿ␀␀␀␀␀␀␀¡v␀␀␀␀␀␀␀␀TĞ␀␀Ş␀´␀Ôÿ!␀␀␀␀␀>¶␀␀¶␀␀r␀Æÿ␀␀YĞ␀␀␀mDÑ␀Ôÿ!␀␀␀␀␀ĞIÙEÙEqC␀êÿ␀␀ÿ␀mš␀␀Ôÿ!␀␀␀␀␀Íš␀␀«š␀␀«š␀␀"␀␀ÿ␀␀ÿ␀7␀Ôÿ!␀␀␀␀␀N␀L␀L␀"␀␀ÿ␀␀ÿ␀	UoÔÿ!␀␀␀␀␀ZY°V°Vi␀␀ÿ␀␀ÿ␀2␀Ôÿ!␀␀␀␀␀M␀K␀K␀"␀␀ÿ␀␀ÿ␀]ToÔÿ!␀␀␀␀␀YY°V°Vi␀␀ÿ␀␀ÿ␀␀␀␀␀␀␀¢v␀␀␀␀␀␀␀␀UĞ␀␀Ş␀´␀	€€␀␀␀␀␀␀>½␀␀r␀Æÿ␀␀YĞ␀␀␀•␀␀­␀	€€␀␀␀␀␀␀Æ@B:¤:p␀Æÿ␀␀VĞ␀␀␀‘§␀␀c€€␀␀␀␀␀␀Š©␀␀ç§␀␀ç§␀␀`␀␀ÿ␀␀ÿ␀␀␀␀0;1␀␀Î•␀␀␀␀␀␀WĞ␀␀Ş␀´␀	€€␀␀␀␀␀␀>½␀␀r␀Æÿ␀␀YĞ␀␀␀§¬␀␀Ì␀	€€␀␀␀␀␀␀Ôš␀␀€š␀␀€š␀␀m␀Æÿ␀␀aĞ␀␀␀•␀␀­␀	€€␀␀␀␀␀␀Á@—•␀␀•␀␀p␀Æÿ␀␀VĞ␀␀␀p␀€€␀␀␀␀␀␀’␀°V°V$␀␀ÿ␀␀ÿ␀␀␀␀0;1;2␀␀Y␀␀␀␀␀XĞ␀␀Ş␀´␀	Ôÿ?␀␀␀␀␀>¶␀␀¶␀␀r‡␀Æÿ␀␀YĞ␀␀␀¦§␀␀EÔÿ?␀␀␀␀␀(Y°V°VG‡␀␀ÿ␀␀ÿ␀…␀=Ôÿ1␀␀␀␀␀␀␀␀c␀␀␀ÿ␀␀ÿ␀Â¦␀␀­␀Ôÿ1␀␀␀␀␀¯␀␀¹®␀␀¹®␀␀p␀Æÿ␀␀ÿ␀á¦␀␀­␀Ôÿ1␀␀␀␀␀¯␀␀¯␀␀¯␀␀p␀Æÿ␀␀ÿ␀ä␀␀Ñ␀Ôÿ1␀␀␀␀␀K”␀␀”␀␀qC␀êÿ␀␀ÿ␀¤w·␀Ôÿ1␀␀␀␀␀ƒyˆxˆxì*␀␀Æÿ␀␀ÿ␀oÑ␀Ôÿ1␀␀␀␀␀KG␀G␀qC␀êÿ␀␀ÿ␀w·␀Ôÿ1␀␀␀␀␀›yßxßxì*␀␀Æÿ␀␀ÿ␀mDÑ␀Ôÿ1␀␀␀␀␀JşEşEqC␀êÿ␀␀ÿ␀¯«␀␀´␀Ôÿ1␀␀␀␀␀Ş«␀␀Ş«␀␀Ş«␀␀r␀Æÿ␀␀YĞ␀␀␀Ì¦␀␀­␀Ôÿ1␀␀␀␀␀¯␀␀Ä®␀␀Ä®␀␀p␀Æÿ␀␀ÿ␀Û¦␀␀­␀Ôÿ1␀␀␀␀␀¯␀␀Ö®␀␀Ö®␀␀p␀Æÿ␀␀ÿ␀Ü¦␀␀­␀Ôÿ1␀␀␀␀␀¯␀␀×®␀␀×®␀␀p␀Æÿ␀␀ÿ␀␀␀␀0␀␀áf␀␀␀␀␀␀␀␀␀␀␀␀␀␀ZĞ␀␀