	␀␀PROCEDURE SP_RETMSV(P_TIPDOC NUMBER,P_NUMDOC VARCHAR2(20),P_DESMSG OUT VARCHAR2(32),P_DATMSG OUT VARCHAR2(16),P_QTDMSG OUT VARCHAR2(2))
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_datfim      DATE;
  l_hora_atual  NUMBER(4);
  l_qtdmsg      INTEGER;
  l_desmsg      VARCHAR2(32);
  l_datmsg      VARCHAR2(6);
  l_errstr      VARCHAR2(255);
  l_nodatafound BOOLEAN;

BEGIN
  /* Inicializa */
  l_data_atual := CURDATE();
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_desmsg := '';
  l_qtdmsg := 0;
  l_datfim := l_data_zero;
  l_nodatafound := FALSE;

  /* Verifica se Existe Cracha Provisorio */
  BEGIN
    SELECT MSGACC,QTDMSG,DATFIM INTO l_desmsg,l_qtdmsg,l_datfim
      FROM R070MSV
     WHERE R070MSV.TIPDOC = p_tipdoc AND
           R070MSV.NUMDOC = p_numdoc AND
           (R070MSV.DATINI < l_data_atual OR
            (R070MSV.DATINI = l_data_atual AND R070MSV.HORINI <= l_hora_atual)) AND
           (R070MSV.DATFIM = l_data_zero OR
            R070MSV.DATFIM > l_data_atual OR
            (R070MSV.DATFIM = l_data_atual AND R070MSV.HORFIM >= l_hora_atual));
  EXCEPTION
    WHEN TOO_MANY_ROWS THEN
      l_errstr := 'Erro em R070MSV - TOO MANY ROWS. '||
                  'Tip.Doc.: '||CONVERT(NUMBER_TO_CHAR,p_tipdoc)||
                  'Num.Doc.: '||p_numdoc;
      RAISERROR 103 l_errstr;
    WHEN NO_DATA_FOUND THEN
      l_desmsg := '';
      l_qtdmsg := 0;
      l_datfim := l_data_zero;
      l_nodatafound := TRUE;
    WHEN OTHERS THEN
      l_errstr := 'Erro em R070MSV - TOO MANY ROWS. '||
                  'Tip.Doc.: '||CONVERT(NUMBER_TO_CHAR,p_tipdoc)||
                  'Num.Doc.: '||p_numdoc;
      RAISERROR 103 l_errstr;
  END;

  SP_INTSTR(l_qtdmsg,'99',p_qtdmsg OUT);
  IF   (NOT(l_desmsg IS NULL))  AND (l_desmsg <> ' ') THEN
       IF   (l_qtdmsg = 0) THEN
            l_datmsg := '999999';
       ELSE
            IF   l_datfim = l_data_atual THEN
                 SP_DATSTR(l_data_atual,'DDMMYY',l_datmsg OUT);
            ELSE
                 IF  (l_nodatafound = TRUE) THEN
                      l_datmsg := '      ';
                 ELSE
                      l_datmsg := '999999';
                 END IF;
            END IF;
       END IF;
  ELSE
       l_datmsg := '      ';
  END IF;
  p_desmsg := l_desmsg;
  p_datmsg := l_datmsg || '0000000000';
END		SENIOR;20#SP_INTSTR
SP_DATSTR
SP_STRTOSTR
