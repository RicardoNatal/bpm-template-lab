  l_TipCra              CHAR(2);
  l_IniVal              CHAR(16);
  l_DatVal              CHAR(16);
  l_SitCra              CHAR(2);
  l_TecCra              CHAR(2);
  l_QntCra              NUMBER(9);
  l_QntCra_str          CHAR(9);
