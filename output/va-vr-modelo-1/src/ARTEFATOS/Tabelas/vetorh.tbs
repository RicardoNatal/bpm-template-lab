	l_DataAlteracao DATE;
	l_Layout VARCHAR2(6); /* Layout de alteração contratual do colaborador no eSocial - S-2206 ou S-2306 */
	l_temAud       BOOLEAN;
    l_codRPA       NUMBER(15);
    l_codSistema   NUMBER(2);
    l_codcpa       NUMBER(4);
    l_codtpa       NUMBER(4);
    l_datTemp      VARCHAR(10);
    l_gerarPendencia BOOLEAN;      
BEGIN
    l_gerarPendencia := TRUE;
	RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
	IF ((l_layout IS NOT NULL) AND LENGTH(LTRIM(RTRIM(l_layout))) > 0)  THEN
	  N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
      IF (l_gerarPendencia = TRUE) THEN  
    	l_DataAlteracao := CURDATE();	
    	SP_E_SOCIAL(l_Layout, 'R034IEA', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, '', '', 0, NULL, l_DataAlteracao, 0, 'R034IEA_EI');
      END IF;
    END IF;
	
	/* Geração de logs Informações Empregador Contratante de Aprendiz (Tabela: R034IEA)*/ 
    l_codSistema := 1;  /* Código do sistema vetorh. */
    l_codcpa := 115;     /* Informações Empregador Contratante de Aprendiz (Tabela: R034IEA)*/
    l_codtpa := 341;
    
    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034IEA_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034IEA_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOEM', CONVERT(NUMBER_TO_CHAR, :NEW.CODOEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPINS', CONVERT(NUMBER_TO_CHAR, :NEW.TIPINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMINS', CONVERT(NUMBER_TO_CHAR, :NEW.NUMINS));
        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDCTR', CONVERT(NUMBER_TO_CHAR, :NEW.INDCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OEMQUA', CONVERT(NUMBER_TO_CHAR, :NEW.OEMQUA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMQUA', CONVERT(NUMBER_TO_CHAR, :NEW.NUMQUA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OEMPRA', CONVERT(NUMBER_TO_CHAR, :NEW.OEMPRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMPRA', CONVERT(NUMBER_TO_CHAR, :NEW.NUMPRA));
      END;
  END IF;
END␀Ó␀␀		SENIOR;0†␀␀

TRIGGER R034IEA_EU AFTER UPDATE ON R034IEA FOR EACH ROW DECLARE
    l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_DataAlteracao DATE;
	l_Layout VARCHAR2(6); /* Layout de alteração contratual do colaborador no eSocial - S-2206 ou S-2306 */
	l_JsonCamposAlterados VARCHAR2(2000);
	l_temAud       BOOLEAN;
    l_codRPA       NUMBER(15);
    l_codSistema   NUMBER(2);
    l_codcpa       NUMBER(4);
    l_codtpa       NUMBER(4);
    l_datTemp      VARCHAR(10);
    l_gerarPendencia BOOLEAN;
    l_VersaoESocial NUMBER;
    l_SimplificaoESocial BOOLEAN;
    l_inffac BOOLEAN;      
BEGIN
    l_Alterou := FALSE;
    l_JsonCamposAlterados := '';
    l_gerarPendencia := TRUE;

	SP_VALUPDATE_NUM(:OLD.TIPINS, :NEW.TIPINS, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_NUM_JSON('TIPINS', :NEW.TipIns, :OLD.TipIns, l_JsonCamposAlterados OUT);
	END IF;
	
	SP_VALUPDATE_NUM(:OLD.NUMINS, :NEW.NUMINS, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_FLO_JSON('NUMINS', :NEW.NumIns, :OLD.NumIns, 0, l_JsonCamposAlterados OUT);
	END IF;
	
	SP_ESOCIAL_INFO(:NEW.NUMEMP, l_inffac OUT, l_SimplificaoESocial OUT, l_versaoEsocial OUT);
  
  	IF (l_versaoEsocial >= 6) THEN
  		SP_VALUPDATE_NUM(:OLD.INDCTR, :NEW.INDCTR, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('INDCTR', :NEW.INDCTR, :OLD.INDCTR, l_JsonCamposAlterados OUT);
		END IF;
		
		SP_VALUPDATE_NUM(:OLD.NUMQUA, :NEW.NUMQUA, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_FLO_JSON('NUMQUA', :NEW.NUMQUA, :OLD.NUMQUA, 0, l_JsonCamposAlterados OUT);
		END IF;
		
		SP_VALUPDATE_NUM(:OLD.NUMPRA, :NEW.NUMPRA, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_FLO_JSON('NUMPRA', :NEW.NUMPRA, :OLD.NUMPRA, 0, l_JsonCamposAlterados OUT);
		END IF;
  	END IF;
	
	IF (l_Alterou = TRUE) THEN 
		RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Layout OUT);
		IF ((l_layout IS NOT NULL) AND LENGTH(LTRIM(RTRIM(l_layout))) > 0)  THEN
		    N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
            IF (l_gerarPendencia = TRUE) THEN  
			  l_DataAlteracao := CURDATE();
			  SP_E_SOCIAL(l_Layout, 'R034IEA', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, '', l_JsonCamposAlterados, 0, NULL, l_DataAlteracao, 0, 'R034IEA_EU');
			END IF;
		END IF;
	END IF;
	
	/* Geração de logs Informações Empregador Contratante de Aprendiz (Tabela: R034IEA)*/ 
    l_codSistema := 1;  /* Código do sistema vetorh. */
    l_codcpa := 115;     /* Informações Empregador Contratante de Aprendiz (Tabela: R034IEA)*/
    l_codtpa := 342;
    
    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.CodOem <> :NEW.CodOem)
   OR (:OLD.TipIns <> :NEW.TipIns)
   OR (:OLD.NumIns <> :NEW.NumIns)
   
   OR (:OLD.IndCtr <> :NEW.IndCtr)
   OR (:OLD.OemQua <> :NEW.OemQua)
   OR (:OLD.NumQua <> :NEW.NumQua)
   OR (:OLD.OemPra <> :NEW.OemPra)
   OR (:OLD.NumPra <> :NEW.NumPra)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034IEA_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034IEA_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODOEM', CONVERT(NUMBER_TO_CHAR, :OLD.CODOEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODOEM', CONVERT(NUMBER_TO_CHAR, :NEW.CODOEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPINS', CONVERT(NUMBER_TO_CHAR, :OLD.TIPINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPINS', CONVERT(NUMBER_TO_CHAR, :NEW.TIPINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMINS', CONVERT(NUMBER_TO_CHAR, :OLD.NUMINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMINS', CONVERT(NUMBER_TO_CHAR, :NEW.NUMINS));
        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINDCTR', CONVERT(NUMBER_TO_CHAR, :OLD.INDCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINDCTR', CONVERT(NUMBER_TO_CHAR, :NEW.INDCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOEMQUA', CONVERT(NUMBER_TO_CHAR, :OLD.OEMQUA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOEMQUA', CONVERT(NUMBER_TO_CHAR, :NEW.OEMQUA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMQUA', CONVERT(NUMBER_TO_CHAR, :OLD.NUMQUA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMQUA', CONVERT(NUMBER_TO_CHAR, :NEW.NUMQUA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOEMPRA', CONVERT(NUMBER_TO_CHAR, :OLD.OEMPRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOEMPRA', CONVERT(NUMBER_TO_CHAR, :NEW.OEMPRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMPRA', CONVERT(NUMBER_TO_CHAR, :OLD.NUMPRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMPRA', CONVERT(NUMBER_TO_CHAR, :NEW.NUMPRA));
        
      END;
    END IF; 
  END IF;
END␀‹Ó␀␀		SENIOR;0L␀␀

TRIGGER R034IEA_ED AFTER DELETE ON R034IEA FOR EACH ROW DECLARE
	l_DataAlteracao DATE;
	l_Layout VARCHAR2(6); /* Layout de alteração contratual do colaborador no eSocial - S-2206 ou S-2306 */
	l_temAud       BOOLEAN;
    l_codRPA       NUMBER(15);
    l_codSistema   NUMBER(2);
    l_codcpa       NUMBER(4);
    l_codtpa       NUMBER(4);
    l_datTemp      VARCHAR(10);
    l_gerarPendencia BOOLEAN;      
BEGIN
    l_gerarPendencia := TRUE;
	RH_LAY_CONTR_COLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Layout OUT);    
	IF ((l_layout IS NOT NULL) AND LENGTH(LTRIM(RTRIM(l_layout))) > 0)  THEN
	    N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    	IF (l_gerarPendencia = TRUE) THEN  
			l_DataAlteracao := CURDATE();
			SP_E_SOCIAL(l_Layout, 'R034IEA', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, '', '', 0, NULL, l_DataAlteracao, 0, 'R034IEA_ED');
		END IF;
	END IF;
	
	/* Geração de logs Informações Empregador Contratante de Aprendiz (Tabela: R034IEA)*/ 
    l_codSistema := 1;  /* Código do sistema vetorh. */
    l_codcpa := 115;     /* Informações Empregador Contratante de Aprendiz (Tabela: R034IEA)*/
    l_codtpa := 341;
    
    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034IEA_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034IEA_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOEM', CONVERT(NUMBER_TO_CHAR, :OLD.CODOEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPINS', CONVERT(NUMBER_TO_CHAR, :OLD.TIPINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMINS', CONVERT(NUMBER_TO_CHAR, :OLD.NUMINS));
        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDCTR', CONVERT(NUMBER_TO_CHAR, :OLD.INDCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OEMQUA', CONVERT(NUMBER_TO_CHAR, :OLD.OEMQUA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMQUA', CONVERT(NUMBER_TO_CHAR, :OLD.NUMQUA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OEMPRA', CONVERT(NUMBER_TO_CHAR, :OLD.OEMPRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMPRA', CONVERT(NUMBER_TO_CHAR, :OLD.NUMPRA));
      END;
  END IF;
END␀␀␀m␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Ó␀␀…¬␀␀´␀	Ôÿ?ü␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ?ü␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ?ü␀␀␀␀.%€$0.w␀Æÿ␀␀…Ó␀␀␀P,¢␀	Ôÿ?ü␀␀␀␀…<ò:ò:i␀Æÿ␀␀Ó␀␀␀£DÑ␀Ôÿ?ü␀␀␀␀nI\F\FqC␀êÿ␀␀ÿ␀vw·␀Ôÿ?ü␀␀␀␀
