É␀␀PROCEDURE R034MDL_VERUSORUBI(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9))
 IS

l_qtde   NUMBER;
  l_TemMod VARCHAR2(1);
  l_codcli   R250TAB.CODCLI%TYPE;
  l_perref   R250TAB.PERREF%TYPE;
BEGIN
  RH_VER_MODULO_PRP(9, l_TemMod OUT);
  IF (l_TemMod = 'S') THEN
    BEGIN
      SELECT COUNT(*) INTO l_qtde FROM R032TPG
        WHERE NUMEMP = p_numemp
          AND TIPCOL = p_tipcol
          AND NUMCAD = p_numcad
          AND (TIPCOL = 2);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT da tabela R032TPG.';
    END;
    IF (l_qtde > 0) THEN
      RAISERROR 103 '[msg-R032TPG-RUBI]Colaborador está sendo usado na tabela R032TPG (módulo RUBI).';
    END IF;

    BEGIN
      BEGIN
        SELECT CODCLI, PERREF INTO l_codcli,l_perref FROM R250TAB;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT da tabela R250TAB.';
      END;

      IF (l_CodCli = 14538) THEN
        SELECT COUNT(*) INTO l_qtde FROM R046VER A, R044CAL B
          WHERE A.NUMEMP = p_numemp
            AND A.TIPCOL = p_tipcol
            AND A.NUMCAD = p_numcad
            AND (A.TIPCOL = 1)
            AND A.CODCAL = B.CODCAL
            AND A.NUMEMP = B.NUMEMP
            AND B.PERREF >= l_perref;
      ELSE
        SELECT COUNT(*) INTO l_qtde FROM R046VER
          WHERE NUMEMP = p_numemp
            AND TIPCOL = p_tipcol
            AND NUMCAD = p_numcad
            AND (TIPCOL = 1);
      END IF;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT da tabela R046VER.';
    END;
    IF (l_qtde > 0) THEN
      RAISERROR 103 '[msg-R046VER-RUBI]Colaborador está sendo usado na tabela R046VER (módulo RUBI).';
    END IF;
  END IF;
END␀®Ó␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_VER_MODULO_PRP
