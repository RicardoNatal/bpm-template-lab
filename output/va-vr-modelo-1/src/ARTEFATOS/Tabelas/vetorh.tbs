TRIGGER R088VCD_EU AFTER UPDATE ON R088VCD FOR EACH ROW

DECLARE
l_OnLine          BOOLEAN;
    l_NumCra          NUMBER(12);
    l_DatIni          DATE;
    l_HorIni          NUMBER(5);
    l_BloAut          VARCHAR2(1);
    l_TipPev          NUMBER(1);
    l_TipVis          NUMBER(3);
    l_NumEmp          NUMBER(4);
    l_TipCol          NUMBER(1);
    l_NumCad          NUMBER(9);
    l_Subnv           NUMBER(1);
    l_CreAcc          NUMBER(1);
    l_Data_Zero       DATE;
    l_Hora_Atual      NUMBER(4);
    l_Data_Atual      DATE;
    l_SeqEnt          NUMBER(2);

    CURSOR c_R088AJD_ins IS
    SELECT TIPDOC, NUMDOC, NUMCRA
    FROM R088AJD
    WHERE PLAVEI = :NEW.PLAVEI
    AND DATCHG   = :NEW.DATCHG
    AND HORCHG   = :NEW.HORCHG;

    TYPE t_R088AJD IS RECORD(
        TIPDOC   R088AJD.TIPDOC%TYPE,
        NUMDOC   R088AJD.NUMDOC%TYPE,
        NUMCRA   R088AJD.NUMCRA%TYPE);
    l_R088AJD t_R088AJD;
BEGIN
    SP_VerOnLine(l_OnLine OUT);
    IF (l_OnLine = TRUE) THEN
        l_Data_Zero  := '31/12/1900,00:00:00';
        l_Hora_Atual := HOUR(CURTIME()) * 60 + MINUTE(CURTIME());
        l_Data_Atual := CURDATE();

        /* Bloqueia Crachá de Motorista */
        BEGIN
            SELECT NUMCRA
            INTO l_NumCra
            FROM R088VCE A
            WHERE A.PLAVEI = :NEW.PLAVEI
            AND A.DATCHG = :NEW.DATCHG
            AND A.HORCHG = :NEW.HORCHG;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN NULL; /* Se não existe entrada não realiza nenhum processamento*/
            WHEN OTHERS THEN RAISERROR 103 'R088VCD_EU: Erro No SELECT R088VCE.';
        END;

        BEGIN
            SELECT DATINI, MAX(HORINI), MAX(SEQENT)
            INTO l_DatIni, l_HorIni, l_SeqEnt
                FROM R090HCH A
                WHERE A.TIPDOC = :NEW.TIPDOC
                AND A.NUMDOC = :NEW.NUMDOC
               AND A.NUMCRA=l_NumCra AND
           (A.DATINI < l_data_atual OR
            (A.DATINI = l_data_atual AND A.HORINI <= l_hora_atual)) AND
           (A.DATFIM = l_data_zero OR
            A.DATFIM > l_data_atual OR
            (A.DATFIM = l_data_atual AND A.HORFIM >= l_hora_atual)) GROUP BY DATINI;
           EXCEPTION
                WHEN NO_DATA_FOUND THEN l_NumCra := 0;
                WHEN OTHERS THEN RAISERROR 103 'R088VCD_EU: Erro No SELECT R090HCH.';
            END;

            IF (l_NumCra > 0) THEN
                l_BloAut := '0';
                l_TipPev := 1;  /* Visitante */
                l_TipVis := 0;
                l_NumEmp := 0;
                l_TipCol := 0;
                l_NumCad := 0;
                l_Subnv  := 1;  /* Sempre inicializa a controle toda */
                l_CreAcc := 1;

                SP_VISCON(:NEW.TIPDOC, :NEW.NUMDOC, l_NumCra, :NEW.CODPRM, l_DatIni, l_HorIni, :NEW.DATVAL, :NEW.HORVAL,
                          l_BloAut, l_TipPev, l_TipVis, l_NumEmp, l_TipCol, l_NumCad, l_Subnv, l_CreAcc, NULL);


                /* Bloqueia Crachás de Ajudantes */
                FOREACH c_R088AJD_ins INTO  l_R088AJD.TIPDOC,
                                            l_R088AJD.NUMDOC,
                                            l_R088AJD.NUMCRA
                LOOP
                    SP_VISCON(l_R088AJD.TIPDOC, l_R088AJD.NUMDOC, l_R088AJD.NUMCRA, :NEW.CODPRM, l_DatIni, l_HorIni, :NEW.DATVAL, :NEW.HORVAL,
                              l_BloAut, l_TipPev, l_TipVis, l_NumEmp, l_TipCol, l_NumCad, l_Subnv, l_CreAcc, NULL);
                END LOOP;
            END IF;
    END IF;
END␀åÜ␀␀		SENIOR;0á␀␀TRIGGER R088VCD_ED AFTER DELETE ON R088VCD FOR EACH ROW

DECLARE
l_NumCra          NUMBER(12);
    l_TipDoc          NUMBER(1);
    l_NumDoc          VARCHAR2(20);
    l_DatSai          DATE;
    l_HorSai          NUMBER(5);

    CURSOR c_R088AJD_ins IS
    SELECT TIPDOC, NUMDOC, NUMCRA
    FROM R088AJD
    WHERE PLAVEI = :OLD.PLAVEI
    AND DATCHG   = :OLD.DATCHG
    AND HORCHG   = :OLD.HORCHG;

    TYPE t_R088AJD IS RECORD(
        TIPDOC   R088AJD.TIPDOC%TYPE,
        NUMDOC   R088AJD.NUMDOC%TYPE,
        NUMCRA   R088AJD.NUMCRA%TYPE);
    l_R088AJD t_R088AJD;
BEGIN
     /* Bloqueia Crachá de Motorista */
    BEGIN
        SELECT NUMCRA
        INTO l_NumCra
        FROM R088VCE A
        WHERE A.PLAVEI = :OLD.PLAVEI
        AND A.DATCHG = :OLD.DATCHG
        AND A.HORCHG = :OLD.HORCHG;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN NULL; /* Se não existe entrada não realiza nenhum processamento*/
        WHEN OTHERS THEN RAISERROR 103 'R088VCD_ED: Erro No SELECT R088VCE.';
    END;

        BEGIN
            SELECT DATSAI, HORSAI
            INTO l_DatSai, l_HorSai
            FROM R088VCS A
            WHERE A.PLAVEI = :OLD.PLAVEI
            AND A.DATCHG = :OLD.DATCHG
            AND A.HORCHG = :OLD.HORCHG;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN     /*Se não encontrou DATSAI, passa DATVAL */
                l_DatSai := :OLD.DATVAL;
                l_HorSai := :OLD.HORVAL;
            WHEN OTHERS THEN RAISERROR 103 'R088VCD_ED: Erro No SELECT R088VCS.';
        END;

        SP_VEICON('D', :OLD.TIPDOC, :OLD.NUMDOC, l_NumCra, :OLD.CODPRM, l_DatSai, l_HorSai);

        /* Bloqueia Crachás de Ajudantes */
        FOREACH c_R088AJD_ins INTO  l_R088AJD.TIPDOC,
                                    l_R088AJD.NUMDOC,
                                    l_R088AJD.NUMCRA
        LOOP
            SP_VEICON('D', l_R088AJD.TIPDOC, l_R088AJD.NUMDOC, l_R088AJD.NUMCRA, :OLD.CODPRM, l_DatSai, l_HorSai);
        END LOOP;
END␀␀␀Ù6␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀èÜ␀␀ZÂ␀␀	„␀␀␀␀␀}Â␀␀\Â␀␀\Â␀␀\␀Èˆ␀␀ÿ␀␀õÜ␀␀␀—DÑ␀	„␀␀␀␀␀©JÙEÙEqCvˆ␀êÿ␀␀äÜ␀␀␀pw·␀	„␀␀␀␀␀jyıwıwì*␀yˆ␀Æÿ␀␀çÜ␀␀␀ÈDÑ␀„␀␀␀␀␀ÎJÙEÙEqCvˆ␀êÿ␀␀ÿ␀…w·␀„␀␀␀␀␀myıwıwì*␀yˆ␀Æÿ␀␀ÿ␀¥Ã␀␀±␀„␀␀␀␀␀”=àÃ␀␀àÃ␀␀q␀Æÿ␀␀ğ×␀␀␀VÁ␀␀Î␀„␀␀␀␀␀Á␀␀~Á␀␀~Á␀␀`)␀␀Æÿ␀␀ÿ␀«␀␀c„␀␀␀␀␀z«␀␀y«␀␀y«␀␀`␀␀ÿ␀␀ÿ␀ça´␀„␀␀␀␀␀¶<’aYbr␀Æÿ␀␀Ò␀␀␀c␀t„␀␀␀␀␀o␀t␀t␀n␀Æÿ␀␀ˆÓ␀␀␀J$Ì␀„␀␀␀␀␀E%$€$w␀␀Æÿ␀␀…Ó␀␀␀b´␀„␀␀␀␀␀È<©aÉbr␀Æÿ␀␀Ò␀␀␀#␀t„␀␀␀␀␀]␀-␀1␀n␀Æÿ␀␀ˆÓ␀␀␀b$Ì␀„␀␀␀␀␀a% $²$w␀␀Æÿ␀␀…Ó␀␀␀x³␀␀€␀„␀␀␀␀␀G´␀␀$³␀␀ñ³␀␀!|ˆ␀␀ÿ␀␀ÿ␀İ¬␀␀Ì␀„␀␀␀␀␀9°␀␀û␀␀û␀␀{Èˆ␀Æÿ␀␀ÿ␀u¬␀␀–␀„␀␀␀␀␀7@<8<8nWˆ␀Æÿ␀␀ÿ␀b´␀„␀␀␀␀␀Æ<©aÉbr␀Æÿ␀␀Ò␀␀␀%␀t„␀␀␀␀␀^␀-␀1␀n␀Æÿ␀␀ÿ␀c$Ì␀„␀␀␀␀␀G% $²$w␀␀Æÿ␀␀…Ó␀␀␀–EÑ␀„␀␀␀␀␀aK?H?HqCvˆ␀êÿ␀␀ÿ␀Ùw·␀„␀␀␀␀␀áy­x­xì*␀yˆ␀Æÿ␀␀ÿ␀(8–␀␀␀␀␀␀␀C8C8C8nWˆ␀Æÿ␀␀ÿ␀TÁ␀␀Î␀„␀␀␀␀␀‚Á␀␀Á␀␀Á␀␀`)␀␀Æÿ␀␀ÿ␀UÁ␀␀Î␀„␀␀␀␀␀ƒÁ␀␀€Á␀␀€Á␀␀`)␀␀Æÿ␀␀ÿ␀␀␀␀0;1;2êÜ␀␀		SENIOR;0M␀␀TRIGGER R088VCE_EI AFTER INSERT ON R088VCE FOR EACH ROW

DECLARE
l_TipDoc          NUMBER(1);
    l_NumDoc          VARCHAR2(20);
    l_CodPrm          NUMBER(5);
    l_DatVal          DATE;
    l_HorVal          NUMBER(5);
    l_DatSai          DATE;
    l_HorSai          NUMBER(5);
BEGIN
    BEGIN
        SELECT TIPDOC, NUMDOC, CODPRM, DATVAL, HORVAL
        INTO l_TipDoc, l_NumDoc, l_CodPrm, l_DatVal, l_HorVal
        FROM R088VCD A
        WHERE A.PLAVEI = :NEW.PLAVEI
        AND A.DATCHG = :NEW.DATCHG
        AND A.HORCHG = :NEW.HORCHG;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN RAISERROR 103 'R088VCE_EI: Não encontrou registro na tabela R088VCD.';
        WHEN OTHERS THEN RAISERROR 103 'R088VCE_EI: Erro No SELECT R088VCD.';
    END;

    BEGIN
        SELECT DATSAI, HORSAI
        INTO l_DatSai, l_HorSai
        FROM R088VCS A
        WHERE A.PLAVEI = :NEW.PLAVEI
        AND A.DATCHG = :NEW.DATCHG
        AND A.HORCHG = :NEW.HORCHG;

        SP_VEICON('I', l_TipDoc, l_NumDoc, :NEW.NUMCRA, l_CodPrm, l_DatSai, l_HorSai);
    EXCEPTION
        WHEN NO_DATA_FOUND THEN     /*Se não encontrou DATSAI, passa DATVAL */
            SP_VEICON('I', l_TipDoc, l_NumDoc, :NEW.NUMCRA, l_CodPrm, l_DatVal, l_HorVal);

        WHEN OTHERS THEN RAISERROR 103 'R088VCE_EI: Erro No SELECT R088VCS.';
    END;
END␀ëÜ␀␀		SENIOR;0Q␀␀

