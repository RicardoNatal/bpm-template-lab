TRIGGER R030DES_ED AFTER DELETE ON R030DES FOR EACH ROW
DECLARE
	l_Valor	VARCHAR(1000);
	xTipAmb   R030DES.TIPAMB%TYPE;
	xNumEmp   R030DES.NUMEMP%TYPE;
BEGIN
	xTipAmb := :OLD.TIPAMB;
	xNumEmp := :OLD.NUMEMP;
  	l_Valor := 'Excluído o Tipo Ambiente ' || CONVERT(NUMBER_TO_CHAR, xTipAmb) || ' das Definições do eSocial da Empresa ' || CONVERT(NUMBER_TO_CHAR, xNumEmp) || '.';
	SP_GRAVALPR(185, l_Valor);
