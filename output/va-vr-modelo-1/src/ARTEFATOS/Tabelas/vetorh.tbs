*p␀␀CREATE  PROCEDURE sp_sinaudmvi(@p_tipope SMALLINT, @p_codpor SMALLINT, @p_datent DATETIME, @p_horent SMALLINT, @p_seqent SMALLINT, @p_tipdoc SMALLINT, @p_numdoc VARCHAR(20), @p_numemp SMALLINT, @p_tipcol SMALLINT, @p_numcad INTEGER, @p_numcra BIGINT, @p_codnac SMALLINT, @p_nomvis VARCHAR(40), @p_codoem INTEGER, @p_nomoem VARCHAR(16), @p_dditel SMALLINT, @p_dddtel SMALLINT, @p_telcon VARCHAR(20), @p_tipvis SMALLINT, @p_codprm INTEGER, @p_datval DATETIME, @p_horval SMALLINT, @p_obsvis VARCHAR(160), @p_plavee VARCHAR(10), @p_placae VARCHAR(10), @p_place2 VARCHAR(10), @p_place3 VARCHAR(10), @p_numlau VARCHAR(12), @p_regrod INTEGER, @p_assvid VARCHAR(1), @p_pcodoem INTEGER, @p_numcon VARCHAR(15), @p_pnumemp SMALLINT, @p_ptipcol SMALLINT, @p_pnumcad INTEGER, @p_codusu BIGINT, @p_datsai DATETIME, @p_horsai SMALLINT, @p_emavis VARCHAR(50), @p_verplf SMALLINT, @p_codplf INTEGER, @p_RetSin SMALLINT OUTPUT) AS
BEGIN
DECLARE @l_temaud SMALLINT
DECLARE @l_coderr SMALLINT
DECLARE @l_codrpa BIGINT
DECLARE @l_datatu DATETIME
DECLARE @l_horatu INTEGER
DECLARE @l_tipdocstr VARCHAR(255)
