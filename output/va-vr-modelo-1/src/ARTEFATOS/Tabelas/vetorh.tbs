  DECLARE CUR_r090mvi CURSOR FOR SELECT 
      new.datent N_DatEnt,new.horent N_HorEnt,new.seqent N_SeqEnt,new.numcra N_NumCra,new.numemp N_NumEmp,new.tipcol N_TipCol,new.numcad N_NumCad,new.taborg N_TabOrg,new.numloc N_NumLoc,new.codpor N_CodPor,
      new.tipdoc N_TipDoc,new.numdoc N_NumDoc,new.segtdo N_SegTDo,new.segdoc N_SegDoc,new.plavee N_PlaVee,new.codprm N_CodPrm,new.dditel N_DdiTel,new.dddtel N_DddTel,new.telcon N_TelCon,new.datval N_DatVal,
      new.horval N_HorVal,new.tipvis N_TipVis,new.obsvis N_ObsVis,new.codusu N_CodUsu,new.datsai N_DatSai,new.horsai N_HorSai,new.datslo N_DatSLo,new.horslo N_HorSLo,new.plaves N_PlaVes,new.placae N_PlaCae,
      new.placas N_PlaCas,new.assvid N_AssVid,new.codoem N_CodOem,new.numcon N_NumCon,new.empccu N_EmpCCu,new.codccu N_CodCCu,new.nomoem N_NomOem,new.codlib N_CodLib,new.codnac N_CodNac,new.codmot N_CodMot,
      new.cravei N_CraVei,new.seqreg N_SeqReg,new.place2 N_PlaCE2,new.place3 N_PlaCE3,new.placs2 N_PlaCS2,new.placs3 N_PlaCS3,new.emavis N_EmaVis,new.locagv N_LocAgv,new.verplf N_VerPlf,new.codplf N_CodPlf,
      new.andvis N_AndVis,new.cpfres N_CPFRes,new.repres N_Repres,new.reptdo N_RepTDo,new.repdoc N_RepDoc
       FROM inserted new

  DECLARE @NEW_DatEnt DATETIME
  DECLARE @NEW_HorEnt INTEGER
  DECLARE @NEW_SeqEnt SMALLINT
  DECLARE @NEW_NumCra BIGINT
  DECLARE @NEW_NumEmp SMALLINT
  DECLARE @NEW_TipCol SMALLINT
  DECLARE @NEW_NumCad INTEGER
  DECLARE @NEW_TabOrg SMALLINT
  DECLARE @NEW_NumLoc INTEGER
  DECLARE @NEW_CodPor SMALLINT
  DECLARE @NEW_TipDoc SMALLINT
  DECLARE @NEW_NumDoc VARCHAR(20)
  DECLARE @NEW_SegTDo SMALLINT
  DECLARE @NEW_SegDoc VARCHAR(20)
  DECLARE @NEW_PlaVee VARCHAR(10)
  DECLARE @NEW_CodPrm INTEGER
  DECLARE @NEW_DdiTel SMALLINT
  DECLARE @NEW_DddTel SMALLINT
  DECLARE @NEW_TelCon VARCHAR(20)
  DECLARE @NEW_DatVal DATETIME
  DECLARE @NEW_HorVal INTEGER
  DECLARE @NEW_TipVis SMALLINT
  DECLARE @NEW_ObsVis VARCHAR(160)
  DECLARE @NEW_CodUsu BIGINT
  DECLARE @NEW_DatSai DATETIME
  DECLARE @NEW_HorSai INTEGER
  DECLARE @NEW_DatSLo DATETIME
  DECLARE @NEW_HorSLo INTEGER
  DECLARE @NEW_PlaVes VARCHAR(10)
  DECLARE @NEW_PlaCae VARCHAR(10)
  DECLARE @NEW_PlaCas VARCHAR(10)
  DECLARE @NEW_AssVid VARCHAR(1)
  DECLARE @NEW_CodOem INTEGER
  DECLARE @NEW_NumCon VARCHAR(15)
  DECLARE @NEW_EmpCCu SMALLINT
  DECLARE @NEW_CodCCu VARCHAR(18)
  DECLARE @NEW_NomOem VARCHAR(60)
  DECLARE @NEW_CodLib SMALLINT
  DECLARE @NEW_CodNac SMALLINT
  DECLARE @NEW_CodMot SMALLINT
  DECLARE @NEW_CraVei BIGINT
  DECLARE @NEW_SeqReg BIGINT
  DECLARE @NEW_PlaCE2 VARCHAR(10)
  DECLARE @NEW_PlaCE3 VARCHAR(10)
  DECLARE @NEW_PlaCS2 VARCHAR(10)
  DECLARE @NEW_PlaCS3 VARCHAR(10)
  DECLARE @NEW_EmaVis VARCHAR(100)
  DECLARE @NEW_LocAgv INTEGER
  DECLARE @NEW_VerPlf SMALLINT
  DECLARE @NEW_CodPlf INTEGER
  DECLARE @NEW_AndVis INTEGER
  DECLARE @NEW_CPFRes BIGINT
  DECLARE @NEW_Repres VARCHAR(1)
  DECLARE @NEW_RepTDo SMALLINT
  DECLARE @NEW_RepDoc VARCHAR(20)
  DECLARE @ChkError INTEGER
  DECLARE @l_locagv INTEGER

  OPEN CUR_r090mvi
  SELECT @ChkError = @@Error
  IF @ChkError <> 0
  BEGIN
    CLOSE CUR_r090mvi
    DEALLOCATE CUR_r090mvi
    GOTO FIM
  END
  FETCH NEXT FROM CUR_r090mvi 
  INTO 
    @NEW_DatEnt, @NEW_HorEnt, @NEW_SeqEnt, @NEW_NumCra, @NEW_NumEmp, @NEW_TipCol, @NEW_NumCad, @NEW_TabOrg, @NEW_NumLoc, @NEW_CodPor, 
    @NEW_TipDoc, @NEW_NumDoc, @NEW_SegTDo, @NEW_SegDoc, @NEW_PlaVee, @NEW_CodPrm, @NEW_DdiTel, @NEW_DddTel, @NEW_TelCon, @NEW_DatVal, 
    @NEW_HorVal, @NEW_TipVis, @NEW_ObsVis, @NEW_CodUsu, @NEW_DatSai, @NEW_HorSai, @NEW_DatSLo, @NEW_HorSLo, @NEW_PlaVes, @NEW_PlaCae, 
    @NEW_PlaCas, @NEW_AssVid, @NEW_CodOem, @NEW_NumCon, @NEW_EmpCCu, @NEW_CodCCu, @NEW_NomOem, @NEW_CodLib, @NEW_CodNac, @NEW_CodMot, 
    @NEW_CraVei, @NEW_SeqReg, @NEW_PlaCE2, @NEW_PlaCE3, @NEW_PlaCS2, @NEW_PlaCS3, @NEW_EmaVis, @NEW_LocAgv, @NEW_VerPlf, @NEW_CodPlf,
    @NEW_AndVis, @NEW_CPFRes, @NEW_Repres, @NEW_RepTDo, @NEW_RepDoc

  WHILE (@@FETCH_STATUS = 0)
  BEGIN
    IF @NEW_LocAgv IS NULL OR @NEW_LocAgv = 0
    BEGIN
        SELECT @l_LocAGV = NULL
        EXECUTE  @ChkError = GETNEXTVALUE 'SEQNOT',1,NULL,@l_LocAGV OUTPUT  
        IF @ChkError <> 0
        BEGIN
          GOTO FIM
        END
		SELECT @NEW_LocAgv = @l_LocAGV
    END

    INSERT INTO R090MVI
       (datent,horent,seqent,numcra,numemp,tipcol,numcad,taborg,numloc,codpor,tipdoc,numdoc,segtdo,segdoc,plavee,codprm,dditel,dddtel,datval,horval,tipvis,obsvis,codusu,datsai,horsai,datslo,horslo,plaves,telcon,placae,placas,assvid,codoem,numcon,empccu,codccu,nomoem,codlib,codnac,codmot,cravei,place2,place3,placs2,placs3,LocAgv,AndVis,CPFRes,Repres,reptdo,repdoc)
    VALUES 
      (@NEW_DATENT,@NEW_HORENT,@NEW_SEQENT,@NEW_NUMCRA,@NEW_NUMEMP,@NEW_TIPCOL,@NEW_NUMCAD,@NEW_TABORG,@NEW_NUMLOC,@NEW_CODPOR,@NEW_TIPDOC,@NEW_NUMDOC,@NEW_SEGTDO,@NEW_SEGDOC,@NEW_PLAVEE,@NEW_CODPRM,@NEW_DDITEL,@NEW_DDDTEL,@NEW_DATVAL,@NEW_HORVAL,@NEW_TIPVIS,@NEW_OBSVIS,@NEW_CODUSU,@NEW_DATSAI,@NEW_HORSAI,@NEW_DATSLO,@NEW_HORSLO,@NEW_PLAVES,@NEW_TELCON,@NEW_PLACAE,@NEW_PLACAS,@NEW_ASSVID,@NEW_CODOEM,@NEW_NUMCON,@NEW_EMPCCU,@NEW_CODCCU,@NEW_NOMOEM,@NEW_CODLIB,@NEW_CODNAC,@NEW_CODMOT,@NEW_CRAVEI,@NEW_PLACE2,@NEW_PLACE3,@NEW_PLACS2,@NEW_PLACS3,@NEW_LocAgv,@NEW_AndVis,@NEW_CPFRes,@NEW_Repres,@NEW_RepTDo,@NEW_RepDoc)

    FETCH NEXT FROM CUR_r090mvi INTO 
      @NEW_DatEnt, @NEW_HorEnt, @NEW_SeqEnt, @NEW_NumCra, @NEW_NumEmp, @NEW_TipCol, @NEW_NumCad, @NEW_TabOrg, @NEW_NumLoc, @NEW_CodPor, 
      @NEW_TipDoc, @NEW_NumDoc, @NEW_SegTDo, @NEW_SegDoc, @NEW_PlaVee, @NEW_CodPrm, @NEW_DdiTel, @NEW_DddTel, @NEW_TelCon, @NEW_DatVal, 
      @NEW_HorVal, @NEW_TipVis, @NEW_ObsVis, @NEW_CodUsu, @NEW_DatSai, @NEW_HorSai, @NEW_DatSLo, @NEW_HorSLo, @NEW_PlaVes, @NEW_PlaCae, 
      @NEW_PlaCas, @NEW_AssVid, @NEW_CodOem, @NEW_NumCon, @NEW_EmpCCu, @NEW_CodCCu, @NEW_NomOem, @NEW_CodLib, @NEW_CodNac, @NEW_CodMot, 
      @NEW_CraVei, @NEW_SeqReg, @NEW_PlaCE2, @NEW_PlaCE3, @NEW_PlaCS2, @NEW_PlaCS3, @NEW_EmaVis, @NEW_LocAgv, @NEW_VerPlf, @NEW_CodPlf,
      @NEW_AndVis, @NEW_CPFRes, @NEW_Repres, @NEW_RepTDo, @NEW_RepDoc
  END

  FIM:
    CLOSE CUR_r090mvi
    DEALLOCATE CUR_r090mvi
END	MSSQL;23¦␀␀CREATE TRIGGER R090MVI_IOI ON R090MVI INSTEAD OF INSERT
