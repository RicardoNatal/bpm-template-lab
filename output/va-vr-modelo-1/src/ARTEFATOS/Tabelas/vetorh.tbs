PROCEDURE SP_PEND75(P_TIPOPE CHAR,P_IDTPES VARCHAR2(23),P_TECCRA NUMBER(1),P_NUMFIS NUMBER(12),P_PLAVEI VARCHAR2(10),P_CRAVEI NUMBER(12),P_DATVAL VARCHAR2(16),P_SITCRA NUMBER(2),P_CONLPR CHAR,P_VEIFRO CHAR)
 IS

l_valstr     VARCHAR2(1024);
  l_datenv     VARCHAR2(16);  
  l_data_atual DATE;
  l_hora_atual NUMBER(4);
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datAux     CHAR(10);
  l_seqenv     NUMBER(2);
  l_seqstr     CHAR(2);
  /*CAMPOS DA PENDÊNCIA 75*/
  l_operacao   CHAR(1);
  l_teccra     CHAR(1);
  l_sitcra     CHAR(1);
  l_numfis     VARCHAR2(12);
  l_qtdplaca   NUMBER(2);
  l_qtdplaca_str CHAR(2);
  l_cravei     VARCHAR2(12);
  l_datval     VARCHAR2(16);
  l_conlpr     CHAR(1);
  l_veifro     CHAR(1);
  l_idtpes     VARCHAR2(23);
BEGIN
    l_conlpr := p_conlpr;
    l_veifro := p_veifro;
	
	IF (p_tipope = 'I') OR (p_tipope = 'U') THEN
		l_operacao := '2';
	ELSE
		l_operacao := '3';
	END IF;
	
	SP_INTSTR(p_teccra, '9', l_teccra OUT);
	SP_INTSTR(p_numfis, '999999999999', l_numfis OUT);
	l_qtdplaca := Length(p_plavei);
	SP_INTSTR(l_qtdplaca, '99', l_qtdplaca_str OUT);
	SP_INTSTR(p_cravei, '999999999999', l_cravei OUT);
	SP_INTSTR(p_sitcra, '9', l_sitcra OUT);
	/*DDMMYYHHMM000000*/
	l_datval := p_datval;
	
	/*MONTA A DATA DE ENVIO DO COMANDO/EVENTO*/
	l_data_atual := CURDATE();
	l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
	SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
	SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
	/*Obtem o Segundo*/
	l_seqenv := SECOND(CURTIME());
	SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
	l_datenv := l_datstr||l_horstr||l_seqstr||'0000';
	

    /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
    l_idtpes := lTrim(p_idtpes);
    l_idtpes := rTrim(l_idtpes);
    LOOP
        /*Controle do Loop.*/
        IF (Length(l_idtpes) > 22) THEN
            EXIT;
        END IF;
        l_idtpes := ' '||l_idtpes;
    END LOOP;
	
	
	/*Operação padrão*/
	l_valstr := '75' || l_datenv || l_operacao || l_idtpes || l_teccra || l_numfis || l_qtdplaca_str || p_plavei;
	
	/*Caso INSERT ou update passa mais informações*/
	IF (l_operacao = '2') THEN
		l_valstr := l_valstr || l_cravei || l_datval ||l_sitcra || l_conlpr || l_veifro;
	END IF;
	
	BEGIN
		/*Comando para todas as concentradoras*/
		SP_PorCom(l_valstr, 0);	
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'SP_PEND75: Erro ao gera pendência 75 - UPDATEVehicleWithPerson.';
	END;
END		SENIOR;21!SP_INTSTR
SP_DATSTR
SP_PORCOM
