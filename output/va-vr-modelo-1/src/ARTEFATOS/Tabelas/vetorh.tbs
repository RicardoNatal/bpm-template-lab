          IF  (l_r004fhr.codhor = l_r073ata.horsab) THEN
              /* sábado */
              IF  ((LENGTH(l_faisab_ace)) < 49) OR ((LENGTH(l_faisab_ace) IS NULL)) THEN
                  l_faisab_ace := l_faisab_ace || l_striac || l_strfac;
