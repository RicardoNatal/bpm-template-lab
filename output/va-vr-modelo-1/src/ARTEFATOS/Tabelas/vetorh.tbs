*␀␀PROCEDURE R032EMC_ATUCON(P_CODOEM NUMBER,P_NUMCON VARCHAR2(16),P_DATFIM DATE)
 IS

l_cracha       NUMBER(12);
  l_crapro       NUMBER(12);
  l_craaux       NUMBER(12);
  l_sqlstr       VARCHAR2(255);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_datahora     CHAR(10);
  l_datstr       CHAR(6);
  l_dataso       DATE;
  l_datpre       DATE;
  l_dattse       DATE;
  l_nodatafound  BOOLEAN;
  l_sequencia    NUMBER;
  l_datmin       DATE;
  l_fimemc       DATE;
  l_fimcon       DATE;
  l_dathch       DATE;
  l_horstr       CHAR(4);
  l_auxval       CHAR(16);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);

  CURSOR c_r038hct IS
  SELECT NUMEMP, TIPCOL, NUMCAD, DATFIM FROM R038HCT WHERE
         (TIPCOL > 1) AND
         (CODOEM = p_codoem) AND
         (NUMCON = p_numcon) AND
         (DATFIM >= l_data_atual OR DATFIM = l_data_zero);
  TYPE t_r038HCT IS RECORD(
    NUMEMP   R038HCT.NUMEMP%TYPE,
    TIPCOL   R038HCT.TIPCOL%TYPE,
    NUMCAD   R038HCT.NUMCAD%TYPE,
    DATFIM   R038HCT.DATFIM%TYPE);
  l_r038hct t_r038hct;


BEGIN
  l_data_zero   := '31/12/1900,00:00:00';
  l_data_atual  := CURDATE();
  l_datahora    := '';
  l_nodatafound := FALSE;
  
  IF  (p_datfim = l_data_zero) THEN
      l_fimemc := '31/12/2050,00:00:00';
  ELSE
      l_fimemc := p_datfim;
  END IF;

  FOREACH c_r038hct INTO  l_r038hct.numemp,
                          l_r038hct.tipcol,
                          l_r038hct.numcad,
                          l_r038hct.DATFIM
  LOOP
      /*Obtem o Crachá Titular, se não existir obtem o Provísório */
      SP_RetCra (1,l_r038hct.numemp, l_r038hct.tipcol, l_r038hct.numcad, 0,'',0,'',l_cracha OUT);
      IF l_cracha = 0 THEN
          /*Se não encontrou o crachá titular, obtem o provisório*/
          SP_RetCra (2,l_r038hct.numemp, l_r038hct.tipcol, l_r038hct.numcad, 0,'',0,'',l_cracha OUT);
          l_crapro := l_cracha;
      ELSE
          /*Obtem o Crachá Provisório*/
          SP_RetCra (2,l_r038hct.numemp, l_r038hct.tipcol, l_r038hct.numcad, 0,'',0,'',l_crapro OUT);
      END IF;

      /* Verifica se Colaborador possui Cracha */
      IF   l_cracha <> 0  THEN
          LOOP
               l_datmin := '31/12/2050,00:00:00';

               l_fimcon := l_r038hct.DATFIM;
               IF  (l_fimcon = l_data_zero) THEN
                   l_fimcon := '31/12/2050,00:00:00';
               END IF;
               IF (l_fimcon < l_datmin) THEN
                   l_datmin := l_fimcon;
               END IF;

               IF (l_fimemc < l_datmin) THEN
                   l_datmin := l_fimemc;
               END IF;
               /*Obtem a Data de Validade do Crachá*/
               BEGIN
                   SELECT DATFIM INTO l_dathch
                   FROM R038HCH A
                   WHERE NUMCRA = l_cracha AND
                   DATINI = (SELECT MAX(DATINI) FROM R038HCH WHERE NUMCRA = l_cracha) AND
                   HORINI = (SELECT MAX(HORINI) FROM R038HCH WHERE NUMCRA = l_cracha AND DATINI = A.DATINI);
               EXCEPTION
                   WHEN OTHERS THEN NULL;
               END;

               BEGIN
                   SELECT DATASO, DATTSE INTO l_dataso, l_dattse FROM R034DAC
                   WHERE NUMEMP = l_r038hct.numemp AND TIPCOL = l_r038hct.tipcol AND NUMCAD = l_r038hct.numcad;
               EXCEPTION
                   WHEN NO_DATA_FOUND THEN l_dataso := '31/12/2050,00:00:00';
                                           l_dattse := '31/12/2050,00:00:00';
                   WHEN OTHERS THEN RAISERROR 103 'R032EMC_ATUCON: Erro No SELECT R034DAC.';
               END;

                   /*Consistência das datas Obtidas*/
               IF  (l_dataso = l_data_zero) THEN
                   l_dataso := '31/12/2050,00:00:00';
               END IF;
               IF  (l_dattse = l_data_zero) THEN
                   l_dattse := '31/12/2050,00:00:00';
               END IF;
               IF (l_dathch = l_data_zero) THEN
                   l_dathch := '31/12/2050,00:00:00';
               END IF;

               IF  (l_dataso < l_dattse) THEN
                   IF  (l_dataso < l_datmin) THEN
                       l_datmin := l_dataso;
                   ELSE
                       IF  (l_dattse < l_datmin) THEN
                           l_datmin := l_dattse;
                       END IF;
                   END IF;
               ELSE
                   IF  (l_dattse < l_datmin)  THEN
                       l_datmin := l_dattse;
                   END IF;
               END IF;
               /*Compara se a data do crachá é a menor entre as datas*/
               IF l_dathch < l_datmin THEN
                   l_datmin := l_dathch;
               END IF;

               SP_DATSTR(l_datmin,'DDMMYY',l_datstr OUT);
               SP_INTSTR(1439,'HHMM',l_horstr OUT);

               l_datahora := l_datstr || l_horstr;

               IF  (l_datahora IS NULL) OR (l_datahora = '') OR (l_datahora = '          ') THEN
                   IF  l_datmin <> l_data_zero THEN
                       SP_DATSTR(l_datmin,'DDMMYY',l_datstr OUT);
                       SP_INTSTR(1439,'HHMM',l_horstr OUT);
                       l_datahora := l_datstr || l_horstr;
                   ELSE
                       l_datahora := '3112502359';
                   END IF;
               END IF;

               /* atualiza r070con */
               l_AuxVal := l_datahora||'000000';
               /*Atualiza o(s) crachá(s) na R070CON*/
               SP_UPDFIS(l_cracha,' ',l_auxval);
               /*Controle do Looping, onde o Processo é efetuado novamente caso exista crachá titular e provisório*/
               IF (l_crapro = l_cracha) OR (l_crapro = 0) THEN
                  EXIT;
               ELSE
                  l_cracha := l_crapro;
               END IF;
          END LOOP;

          /*Atualiza a Controle*/
          /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
          SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
          IF (l_crapri = 0) THEN
              l_crapri := l_cracha;
          END IF;
          BEGIN
              SELECT IDTPES INTO l_idtpes FROM R070CON WHERE NUMCRA = l_cracha AND NUMFIS = l_crapri;
          EXCEPTION
            WHEN OTHERS THEN
              NULL;
          END;
          SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
      END IF;

  END LOOP;
END		SENIOR;23BSP_RETCRA
SP_DATSTR
SP_INTSTR
SP_UPDFIS
SP_MAPFIS
SP_ATUTSI
*␀␀PROCEDURE R032EMC_ATUCON(P_CODOEM NUMBER,P_NUMCON VARCHAR2(16),P_DATFIM DATE)
 IS

l_cracha       NUMBER(12);
  l_crapro       NUMBER(12);
  l_craaux       NUMBER(12);
  l_sqlstr       VARCHAR2(255);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_datahora     CHAR(10);
  l_datstr       CHAR(6);
  l_dataso       DATE;
  l_datpre       DATE;
  l_dattse       DATE;
  l_nodatafound  BOOLEAN;
  l_sequencia    NUMBER;
  l_datmin       DATE;
  l_fimemc       DATE;
  l_fimcon       DATE;
  l_dathch       DATE;
  l_horstr       CHAR(4);
  l_auxval       CHAR(16);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);

  CURSOR c_r038hct IS
  SELECT NUMEMP, TIPCOL, NUMCAD, DATFIM FROM R038HCT WHERE
         (TIPCOL > 1) AND
         (CODOEM = p_codoem) AND
         (NUMCON = p_numcon) AND
         (DATFIM >= l_data_atual OR DATFIM = l_data_zero);
  TYPE t_r038HCT IS RECORD(
    NUMEMP   R038HCT.NUMEMP%TYPE,
    TIPCOL   R038HCT.TIPCOL%TYPE,
    NUMCAD   R038HCT.NUMCAD%TYPE,
    DATFIM   R038HCT.DATFIM%TYPE);
  l_r038hct t_r038hct;


BEGIN
  l_data_zero   := '31/12/1900,00:00:00';
  l_data_atual  := CURDATE();
  l_datahora    := '';
  l_nodatafound := FALSE;
  
  IF  (p_datfim = l_data_zero) THEN
      l_fimemc := '31/12/2050,00:00:00';
  ELSE
      l_fimemc := p_datfim;
  END IF;

  FOREACH c_r038hct INTO  l_r038hct.numemp,
                          l_r038hct.tipcol,
                          l_r038hct.numcad,
                          l_r038hct.DATFIM
  LOOP
      /*Obtem o Crachá Titular, se não existir obtem o Provísório */
      SP_RetCra (1,l_r038hct.numemp, l_r038hct.tipcol, l_r038hct.numcad, 0,'',0,'',l_cracha OUT);
      IF l_cracha = 0 THEN
          /*Se não encontrou o crachá titular, obtem o provisório*/
          SP_RetCra (2,l_r038hct.numemp, l_r038hct.tipcol, l_r038hct.numcad, 0,'',0,'',l_cracha OUT);
          l_crapro := l_cracha;
      ELSE
          /*Obtem o Crachá Provisório*/
          SP_RetCra (2,l_r038hct.numemp, l_r038hct.tipcol, l_r038hct.numcad, 0,'',0,'',l_crapro OUT);
      END IF;

      /* Verifica se Colaborador possui Cracha */
      IF   l_cracha <> 0  THEN
          LOOP
               l_datmin := '31/12/2050,00:00:00';

               l_fimcon := l_r038hct.DATFIM;
               IF  (l_fimcon = l_data_zero) THEN
                   l_fimcon := '31/12/2050,00:00:00';
               END IF;
               IF (l_fimcon < l_datmin) THEN
                   l_datmin := l_fimcon;
               END IF;

               IF (l_fimemc < l_datmin) THEN
                   l_datmin := l_fimemc;
               END IF;
               /*Obtem a Data de Validade do Crachá*/
               BEGIN
                   SELECT DATFIM INTO l_dathch
                   FROM R038HCH A
                   WHERE NUMCRA = l_cracha AND
                   DATINI = (SELECT MAX(DATINI) FROM R038HCH WHERE NUMCRA = l_cracha) AND
                   HORINI = (SELECT MAX(HORINI) FROM R038HCH WHERE NUMCRA = l_cracha AND DATINI = A.DATINI);
               EXCEPTION
                   WHEN OTHERS THEN NULL;
               END;

               BEGIN
                   SELECT DATASO, DATTSE INTO l_dataso, l_dattse FROM R034DAC
                   WHERE NUMEMP = l_r038hct.numemp AND TIPCOL = l_r038hct.tipcol AND NUMCAD = l_r038hct.numcad;
               EXCEPTION
                   WHEN NO_DATA_FOUND THEN l_dataso := '31/12/2050,00:00:00';
                                           l_dattse := '31/12/2050,00:00:00';
                   WHEN OTHERS THEN RAISERROR 103 'R032EMC_ATUCON: Erro No SELECT R034DAC.';
               END;

                   /*Consistência das datas Obtidas*/
               IF  (l_dataso = l_data_zero) THEN
                   l_dataso := '31/12/2050,00:00:00';
               END IF;
               IF  (l_dattse = l_data_zero) THEN
                   l_dattse := '31/12/2050,00:00:00';
               END IF;
               IF (l_dathch = l_data_zero) THEN
                   l_dathch := '31/12/2050,00:00:00';
               END IF;

               IF  (l_dataso < l_dattse) THEN
                   IF  (l_dataso < l_datmin) THEN
                       l_datmin := l_dataso;
                   ELSE
                       IF  (l_dattse < l_datmin) THEN
                           l_datmin := l_dattse;
                       END IF;
                   END IF;
               ELSE
                   IF  (l_dattse < l_datmin)  THEN
                       l_datmin := l_dattse;
                   END IF;
               END IF;
               /*Compara se a data do crachá é a menor entre as datas*/
               IF l_dathch < l_datmin THEN
                   l_datmin := l_dathch;
               END IF;

               SP_DATSTR(l_datmin,'DDMMYY',l_datstr OUT);
               SP_INTSTR(1439,'HHMM',l_horstr OUT);

               l_datahora := l_datstr || l_horstr;

               IF  (l_datahora IS NULL) OR (l_datahora = '') OR (l_datahora = '          ') THEN
                   IF  l_datmin <> l_data_zero THEN
                       SP_DATSTR(l_datmin,'DDMMYY',l_datstr OUT);
                       SP_INTSTR(1439,'HHMM',l_horstr OUT);
                       l_datahora := l_datstr || l_horstr;
                   ELSE
                       l_datahora := '3112502359';
                   END IF;
               END IF;

               /* atualiza r070con */
               l_AuxVal := l_datahora||'000000';
               /*Atualiza o(s) crachá(s) na R070CON*/
               SP_UPDFIS(l_cracha,' ',l_auxval);
               /*Controle do Looping, onde o Processo é efetuado novamente caso exista crachá titular e provisório*/
               IF (l_crapro = l_cracha) OR (l_crapro = 0) THEN
                  EXIT;
               ELSE
                  l_cracha := l_crapro;
               END IF;
          END LOOP;

          /*Atualiza a Controle*/
          /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
          SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
          IF (l_crapri = 0) THEN
              l_crapri := l_cracha;
          END IF;
          BEGIN
              SELECT IDTPES INTO l_idtpes FROM R070CON WHERE NUMCRA = l_cracha AND NUMFIS = l_crapri;
          EXCEPTION
            WHEN OTHERS THEN
              NULL;
          END;
          SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
      END IF;

  END LOOP;
END		SENIOR;21,SP_RETCRA
SP_DATSTR
SP_INTSTR
SP_UPDFIS
