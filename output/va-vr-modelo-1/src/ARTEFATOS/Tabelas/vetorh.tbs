        SP_DATSTR(:OLD.MESANO, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MESANO', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPPRV', CONVERT(NUMBER_TO_CHAR, :OLD.TIPPRV));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQPRV', CONVERT(NUMBER_TO_CHAR, :OLD.SEQPRV));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R146PRM_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORIPRV', :OLD.ORIPRV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCCU', :OLD.CODCCU);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :OLD.TABORG));
        RH_RET_CODLOC(:OLD.TABORG,:OLD.NUMLOC,:OLD.MESANO, xCodLoc OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', xCodLoc);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EMPANT', CONVERT(NUMBER_TO_CHAR, :OLD.EMPANT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CADANT', CONVERT(NUMBER_TO_CHAR, :OLD.CADANT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPTRF', CONVERT(NUMBER_TO_CHAR, :OLD.TIPTRF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MATMES', CONVERT(NUMBER_TO_CHAR, :OLD.MATMES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MATANO', CONVERT(NUMBER_TO_CHAR, :OLD.MATANO));
      END;
  END IF; 
