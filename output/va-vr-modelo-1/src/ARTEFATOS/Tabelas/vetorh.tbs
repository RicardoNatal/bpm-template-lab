/* Procedure que gera os creditos de acesso de acordo com a definição.*/
PROCEDURE SP_GerCrc(P_TIPOPE CHAR(1),P_TIPHIS NUMBER(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATALT DATE,P_EMPATU NUMBER(5),P_CADATU NUMBER(9),P_CODFIL NUMBER(6),P_CODESC NUMBER(9),P_STAHIS NUMBER(1))
 IS

  l_gercrc       CHAR(1);
  l_uticcr       CHAR(1);
  l_codesc         R006ESC.CodEsc%TYPE;
  l_count        NUMBER(5);
  l_fimTes       DATE;
  l_dathes       DATE;  
  l_datalt       DATE;
  l_datult       DATE;
  l_datant       DATE;
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_datcon       DATE;
  l_qtdcon       NUMBER(3);
  l_hora_atual   NUMBER(4);
  l_verplf       NUMBER(3);
  l_alterar      BOOLEAN;
  l_concre       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp_str   CHAR(4);
  l_tipcol_str   CHAR(1);
  l_numcad_str   CHAR(9);
  l_alt_cred     BOOLEAN;
  l_cracha       NUMBER(12);
  l_staacc       NUMBER(1);

  /* CURSOR que busca os créditos de acesso para o visitante com escala. */
  CURSOR c_R070DCA IS
         SELECT INIFAI,FIMFAI,CREDIA,LIMCON,VERPLF,CODPLF FROM R070DCA
         WHERE NUMEMP = p_numemp AND CODFIL = p_codfil AND CODESC = l_codesc AND TIPPES = p_tipcol;
  TYPE t_R070DCA IS RECORD(
    INIFAI   R070DCA.INIFAI%TYPE,
    FIMFAI   R070DCA.FIMFAI%TYPE,
    CREDIA   R070DCA.CREDIA%TYPE,
    LIMCON   R070DCA.LIMCON%TYPE,
    VERPLF   R070DCA.VERPLF%TYPE,
    CODPLF   R070DCA.CODPLF%TYPE);
  l_r070DCA t_R070DCA;

  /*CURSOR PARA BUSCAR OS LOCAIS FÍSICOS QUE A PESSOA POSSÚI CRÉDITOS ATIVOS, ONDE O LOCAL SEJA MAIOR QUE ZERO*/
  CURSOR c_CREDCOL IS
         SELECT DISTINCT VERPLF
                        ,CODPLF
           FROM R070CRC
          WHERE R070CRC.NUMEMP = p_numemp
            AND R070CRC.TIPCOL = p_tipcol
            AND R070CRC.NUMCAD = p_numcad
            AND R070CRC.CODPLF > 0
            AND R070CRC.DATINI <= l_data_atual
            AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR
                 (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual));
  TYPE t_CREDCOL IS RECORD(
    VERPLF   R070CRC.INIFAI%TYPE,
    CODPLF   R070CRC.FIMFAI%TYPE);
  l_CREDCOL t_CREDCOL;

BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_alt_cred   := FALSE;
  l_datcon     := l_data_zero;
  l_qtdcon     := 0;
  l_cracha     := 0;

  /*Busca versão do plano ativa*/
  BEGIN
      SELECT VERPLF INTO l_verplf
        FROM R058VPL
       WHERE DATCRI <= l_data_atual
         AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
  EXCEPTION
      WHEN OTHERS THEN
          l_verplf := 1;
  END;

  /*Monta o idtpes da pessoa*/
  SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
  SP_INTSTR(p_numemp,'9999',l_numemp_str OUT);
  SP_INTSTR(p_tipcol,'9',l_tipcol_str OUT);
  SP_INTSTR(p_numcad,'999999999',l_numcad_str OUT);
  l_idtpes:= l_tippes_str||l_numemp_str||l_tipcol_str||l_numcad_str;
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
      /*Controle do Loop.*/
      IF (Length(l_idtpes) > 22) THEN
          EXIT;
      END IF;
      l_idtpes := ' '||l_idtpes;
  END LOOP;

  /* Busca parametro que indica se eh para gerar créditos de acesso automaticamente. */
  BEGIN
     SELECT GERCRC, UTICCR INTO l_gercrc, l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_gercrc := 'N';
      l_uticcr := 'N';
  END;

  /* Busca parametro que indica */
  BEGIN
     SELECT CONCRE INTO l_concre FROM R034DAC WHERE
            NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
  EXCEPTION
    WHEN OTHERS THEN
      l_concre := 0;
  END;

  /*Se utilizar a rotina de compra de créditos, não deve prosseguir com a geração automática de créditos*/
  IF (l_uticcr = 'N') OR (l_uticcr IS NULL) OR
     ((l_uticcr = 'S') AND (l_concre = 0 OR l_concre = 3)) THEN

      /* se estiver inserindo um histórico de filial e deixar a escala zerado */
      /* significa que ele deve usar a última escala do colaborador.          */
      l_codesc := 0;
      IF  (p_tiphis = 1) AND (p_codesc = 0) THEN
          BEGIN
             SELECT CODESC INTO l_codesc FROM R038HES WHERE
                    NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                    DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND
                    TIPCOL = p_tipcol AND NUMCAD = p_numcad);
          EXCEPTION
              WHEN OTHERS THEN l_codesc := 0;
          END;
      ELSE
          l_codesc := p_codesc;
      END IF;

      /* Verifica se existe faixas para a definição informada de filial e escala */
      l_count := 0;
      BEGIN
         SELECT COUNT(*) INTO l_count FROM R070DCA WHERE
                NUMEMP = p_numemp AND CODFIL = p_codfil AND CODESC = l_codesc AND TIPPES = p_tipcol;
      EXCEPTION
          WHEN OTHERS THEN l_count := 0;
      END;
      /* se não encontrar nada de acordo com a definição, então buscar o registro com a escala zero.*/
      IF  (l_count = 0) THEN
          l_codesc := 0;
      END IF;

      /* Se estiver alterando o histórico de escala e não existir faixa com a escala informada */
      /* é preciso verificar se já existem créditos em aberto. Se existirem não deve fazer nada. */
      IF  (p_tiphis = 2) AND (l_codesc = 0) THEN
          BEGIN
             SELECT COUNT(*) INTO l_count FROM R070CRC 
                 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad 
                     AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR 
                         (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual)
                     );
          EXCEPTION
              WHEN OTHERS THEN l_alterar := FALSE;
          END;
          IF (l_count > 0) THEN
              l_alterar := FALSE;
          ELSE
              l_alterar := TRUE;
          END IF;
      ELSE
          l_alterar := TRUE;
      END IF;

      /* somente gravar créditos se o historico for somente de troca de filial. */
      IF  (l_gercrc = 'S') AND (p_stahis = 1) AND (p_empatu = p_numemp) AND
          (p_cadatu = p_numcad) AND (l_alterar = TRUE) THEN
          l_datult:='31/12/1900,00:00:00';
          /* busca as informações do histórico de filial. (p_tiphis = 1) */
          IF  (p_tiphis = 1) THEN
              /* Pega o historico anterior cuja empresa destino for igual a atual */
              BEGIN
                  SELECT MAX(DATALT) INTO l_datalt FROM R038HFI WHERE
                         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND EMPATU = NUMEMP AND
                         CADATU = NUMCAD AND DATALT < p_datalt AND STAHIS = 1;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datalt:='31/12/1900,00:00:00';
              END;

              /* Pega o ultimo historico do colaborador */
              BEGIN
                  SELECT MAX(DATALT) INTO l_datult FROM R038HFI WHERE
                         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND EMPATU = NUMEMP AND
                         CADATU = NUMCAD AND DATALT <> p_datalt AND STAHIS = 1;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datult:='31/12/1900,00:00:00';
              END;

          ELSE
              /* busca as informações do histórico de escala. (p_tiphis = 2) */
              BEGIN
                  SELECT DATALT INTO l_datalt FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT < p_datalt AND STAHIS = 1 AND
                         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT < p_datalt AND STAHIS = 1);
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datalt:='31/12/1900,00:00:00';
                  WHEN OTHERS THEN l_datalt:='31/12/1900,00:00:00';
              END;
              BEGIN
                  SELECT DATALT INTO l_datult FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT <> p_datalt AND STAHIS = 1 AND
                         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND
                                  NUMCAD = p_numcad AND DATALT <> p_datalt AND STAHIS = 1 );
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datult:='31/12/1900,00:00:00';
                  WHEN OTHERS THEN l_datult:='31/12/1900,00:00:00';
              END;
          END IF;

          IF  (p_tipope = 'I') OR (p_tipope = 'U') THEN

              /* fecha todos os históricos em aberto para este colaborador */
              l_datant := DATETimeAdd(DD,-1,p_datalt);
              UPDATE R070CRC SET DATFIM = l_datant, STAACC = 2 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                     DATINI < p_datalt AND 
                     ((DATFIM >= p_datalt) OR (DATFIM = l_data_zero));
              l_alt_cred := TRUE;

              /* Se tiver incluindo o ultimo historico */
              IF  (p_datalt > l_datult) OR (l_datult = l_data_zero) OR (l_datult IS NULL) THEN
                  /* busca os créditos de acesso para o colaborador com a escala. */
                  FOREACH c_r070dca INTO  l_r070dca.IniFai,
                                          l_r070dca.FimFai,
                                          l_r070dca.CreDia,
                                          l_r070dca.LimCon,
                                          l_r070dca.VerPlf,
                                          l_r070dca.CodPlf
                  LOOP
                      l_count:=0;
                      BEGIN
                          /* verifica se já existe o registro. */
                          SELECT COUNT(*) INTO l_count
                            FROM R070CRC
                           WHERE NUMEMP = p_numemp
                             AND TIPCOL = p_tipcol
                             AND NUMCAD = p_numcad
                             AND DATINI = p_datalt
                             AND INIFAI = l_r070dca.IniFai
                             AND VERPLF = l_r070dca.VerPlf
                             AND CODPLF = l_r070dca.CodPlf;
                      EXCEPTION
                          WHEN NO_DATA_FOUND THEN l_count:=0;
                      END;

                      IF  l_count = 0 THEN
                          /* inclui os creditos de acesso do colaborador. */
                          INSERT INTO R070CRC (NUMEMP,TIPCOL,NUMCAD,DATINI,DATFIM,INIFAI,FIMFAI,
                                               CREDIA,SALATU,STAACC,LIMCON,DATCON,QTDCON,VERPLF,CODPLF)
                                 VALUES (p_numemp,p_tipcol,p_numcad,p_datalt,l_data_zero,
                                         l_r070dca.IniFai,l_r070dca.FimFai,l_r070dca.CreDia,
                                         l_r070dca.CreDia,1,l_r070dca.LimCon,l_datcon,l_qtdcon,l_r070dca.VerPlf,l_r070dca.CodPlf);
                          l_alt_cred := TRUE;
                      ELSE
		                  UPDATE R070CRC SET DATFIM = l_data_zero WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt AND INIFAI = l_r070dca.IniFai AND 
		                  VERPLF = l_r070dca.VerPlf AND CODPLF = l_r070dca.CodPlf;
		                  l_alt_cred := TRUE;
                      END IF;
                  END LOOP;
              END IF;
          ELSIF p_tipope = 'D' THEN
              /* exclui historico de créditos de acesso. */
              DELETE FROM R070CRC WHERE NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND DATINI=p_datalt;
              /* abre o historico anterior.  */
              UPDATE R070CRC SET DATFIM = l_data_zero, STAACC = 1, DATCON = l_datcon, QTDCON = l_qtdcon
               WHERE NUMEMP = p_numemp
                 AND TIPCOL = p_tipcol
                 AND NUMCAD = p_numcad
                 AND DATINI = l_datult;
              l_alt_cred := TRUE;
          END IF;
      ELSE
          /* fecha todos os históricos em aberto para este colaborador */
          IF  (p_tipope = 'I') AND (NOT ((p_tiphis=2) AND (l_codesc=0))) THEN
              l_datant := DATETimeAdd(DD,-1,p_datalt);
              UPDATE R070CRC SET DATFIM = l_datant, STAACC = 2 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                     DATINI < p_datalt AND
                     ((DATFIM >= p_datalt) OR (DATFIM = l_data_zero));
              l_alt_cred := TRUE;
          END IF;
      END IF;
      
      /* Para retorno da troca de escala */
      IF  (p_tipOpe = 'U') AND (p_tiphis = 2) AND (l_codesc = 0) THEN
          l_count := 0;
          BEGIN
              SELECT 1, DATFIM INTO l_count, l_fimTES FROM R064TES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt;
          EXCEPTION
              WHEN NO_DATA_FOUND THEN l_count:=0;
          END;
          
          IF (l_count > 0) THEN
              IF (l_fimtes < l_data_atual) THEN
                  l_staacc := 2;
              ELSE
                  l_staacc := 1;              
              END IF;
              BEGIN
                  UPDATE R070CRC SET DATFIM = l_fimtes, STAACC = l_staacc WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN NULL;
              END;                  
          END IF; 
          
          /* Busca a escala original para atualizar */
          l_codesc := 0;
          BEGIN
              SELECT DATALT, CODESC INTO l_dathes, l_codesc FROM R038HES WHERE
			         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND STAHIS = 1 AND
			         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND STAHIS = 1);
          EXCEPTION
              WHEN OTHERS THEN l_codesc := 0;
		  END;
          
		  /* Procedure que atualiza os creditos de acesso.*/
          IF (l_codesc > 0) THEN
              SP_GerCrc('I', 2, p_NUMEMP, p_TIPCOL, p_NUMCAD, l_dathes, p_NUMEMP, p_NUMCAD, p_codfil, l_CODESC, 1);
		  END IF;          
            
      END IF;

      /* SE HOUVE ALTERAÇÕES NOS CRÉDITOS DE ACESSO DA PESSOA */
      IF ( l_alt_cred = TRUE ) THEN

        /*Remove os créditos globais e créditos por local físico da pessoa na Concentradora, somente se houver crachá*/
        SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
        IF   (l_cracha = 0)  THEN
            SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
        END IF;

        IF (l_cracha <> 0) THEN
          SP_PEND06(4,l_idtpes,0,0);
        END IF;

        /*Chama a SP_CRECON passando o local físico 0(zero), afim de atualizar os registros da r070con*/
        SP_CRECON(p_tipcol, p_numemp, p_tipcol, p_numcad,0,'0','0','0', l_verplf, 0);

        /*INSERE OS CRÉDITOS ATIVOS*/
        FOREACH c_CREDCOL INTO  l_CREDCOL.VerPlf,
                                l_CREDCOL.CodPlf
        LOOP
          /*Atualiza os créditos*/
          SP_CRECON(p_tipcol, p_numemp, p_tipcol, p_numcad,0,'0','0','0', l_CREDCOL.VerPlf, l_CREDCOL.CodPlf);
        END LOOP;
      END IF;

  END IF;
END		SENIOR;22,SP_INTSTR
SP_RETCRA
SP_PEND06
SP_CRECON
¿=␀␀


/* Procedure que gera os creditos de acesso de acordo com a definição.*/
PROCEDURE SP_GerCrc(P_TIPOPE CHAR(1),P_TIPHIS NUMBER(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATALT DATE,P_EMPATU NUMBER(5),P_CADATU NUMBER(9),P_CODFIL NUMBER(6),P_CODESC NUMBER(9),P_STAHIS NUMBER(1))
 IS

  l_gercrc       CHAR(1);
  l_uticcr       CHAR(1);
  l_codesc         R006ESC.CodEsc%TYPE;
  l_count        NUMBER(5);
  l_fimTes       DATE;
  l_dathes       DATE;  
  l_datalt       DATE;
  l_datult       DATE;
  l_datant       DATE;
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_datcon       DATE;
  l_qtdcon       NUMBER(3);
  l_hora_atual   NUMBER(4);
  l_verplf       NUMBER(3);
  l_alterar      BOOLEAN;
  l_concre       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp_str   CHAR(4);
  l_tipcol_str   CHAR(1);
  l_numcad_str   CHAR(9);
  l_alt_cred     BOOLEAN;
  l_cracha       NUMBER(12);
  l_staacc       NUMBER(1);

  /* CURSOR que busca os créditos de acesso para o visitante com escala. */
  CURSOR c_R070DCA IS
         SELECT INIFAI,FIMFAI,CREDIA,LIMCON,VERPLF,CODPLF FROM R070DCA
         WHERE NUMEMP = p_numemp AND CODFIL = p_codfil AND CODESC = l_codesc AND TIPPES = p_tipcol;
  TYPE t_R070DCA IS RECORD(
    INIFAI   R070DCA.INIFAI%TYPE,
    FIMFAI   R070DCA.FIMFAI%TYPE,
    CREDIA   R070DCA.CREDIA%TYPE,
    LIMCON   R070DCA.LIMCON%TYPE,
    VERPLF   R070DCA.VERPLF%TYPE,
    CODPLF   R070DCA.CODPLF%TYPE);
  l_r070DCA t_R070DCA;

  /*CURSOR PARA BUSCAR OS LOCAIS FÍSICOS QUE A PESSOA POSSÚI CRÉDITOS ATIVOS, ONDE O LOCAL SEJA MAIOR QUE ZERO*/
  CURSOR c_CREDCOL IS
         SELECT DISTINCT VERPLF
                        ,CODPLF
           FROM R070CRC
          WHERE R070CRC.NUMEMP = p_numemp
            AND R070CRC.TIPCOL = p_tipcol
            AND R070CRC.NUMCAD = p_numcad
            AND R070CRC.CODPLF > 0
            AND R070CRC.DATINI <= l_data_atual
            AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR
                 (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual));
  TYPE t_CREDCOL IS RECORD(
    VERPLF   R070CRC.INIFAI%TYPE,
    CODPLF   R070CRC.FIMFAI%TYPE);
  l_CREDCOL t_CREDCOL;

BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_alt_cred   := FALSE;
  l_datcon     := l_data_zero;
  l_qtdcon     := 0;
  l_cracha     := 0;

  /*Busca versão do plano ativa*/
  BEGIN
      SELECT VERPLF INTO l_verplf
        FROM R058VPL
       WHERE DATCRI <= l_data_atual
         AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
  EXCEPTION
      WHEN OTHERS THEN
          l_verplf := 1;
  END;

  /*Monta o idtpes da pessoa*/
  SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
  SP_INTSTR(p_numemp,'9999',l_numemp_str OUT);
  SP_INTSTR(p_tipcol,'9',l_tipcol_str OUT);
  SP_INTSTR(p_numcad,'999999999',l_numcad_str OUT);
  l_idtpes:= l_tippes_str||l_numemp_str||l_tipcol_str||l_numcad_str;
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
      /*Controle do Loop.*/
      IF (Length(l_idtpes) > 22) THEN
          EXIT;
      END IF;
      l_idtpes := ' '||l_idtpes;
  END LOOP;

  /* Busca parametro que indica se eh para gerar créditos de acesso automaticamente. */
  BEGIN
     SELECT GERCRC, UTICCR INTO l_gercrc, l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_gercrc := 'N';
      l_uticcr := 'N';
  END;

  /* Busca parametro que indica */
  BEGIN
     SELECT CONCRE INTO l_concre FROM R034DAC WHERE
            NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
  EXCEPTION
    WHEN OTHERS THEN
      l_concre := 0;
  END;

  /*Se utilizar a rotina de compra de créditos, não deve prosseguir com a geração automática de créditos*/
  IF (l_uticcr = 'N') OR (l_uticcr IS NULL) OR
     ((l_uticcr = 'S') AND (l_concre = 0 OR l_concre = 3)) THEN

      /* se estiver inserindo um histórico de filial e deixar a escala zerado */
      /* significa que ele deve usar a última escala do colaborador.          */
      l_codesc := 0;
      IF  (p_tiphis = 1) AND (p_codesc = 0) THEN
          BEGIN
             SELECT CODESC INTO l_codesc FROM R038HES WHERE
                    NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                    DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND
                    TIPCOL = p_tipcol AND NUMCAD = p_numcad);
          EXCEPTION
              WHEN OTHERS THEN l_codesc := 0;
          END;
      ELSE
          l_codesc := p_codesc;
      END IF;

      /* Verifica se existe faixas para a definição informada de filial e escala */
      l_count := 0;
      BEGIN
         SELECT COUNT(*) INTO l_count FROM R070DCA WHERE
                NUMEMP = p_numemp AND CODFIL = p_codfil AND CODESC = l_codesc AND TIPPES = p_tipcol;
      EXCEPTION
          WHEN OTHERS THEN l_count := 0;
      END;
      /* se não encontrar nada de acordo com a definição, então buscar o registro com a escala zero.*/
      IF  (l_count = 0) THEN
          l_codesc := 0;
      END IF;

      /* Se estiver alterando o histórico de escala e não existir faixa com a escala informada */
      /* é preciso verificar se já existem créditos em aberto. Se existirem não deve fazer nada. */
      IF  (p_tiphis = 2) AND (l_codesc = 0) THEN
          BEGIN
             SELECT COUNT(*) INTO l_count FROM R070CRC 
                 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad 
                     AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR 
                         (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual)
                     );
          EXCEPTION
              WHEN OTHERS THEN l_alterar := FALSE;
          END;
          IF (l_count > 0) THEN
              l_alterar := FALSE;
          ELSE
              l_alterar := TRUE;
          END IF;
      ELSE
          l_alterar := TRUE;
      END IF;

      /* somente gravar créditos se o historico for somente de troca de filial. */
      IF  (l_gercrc = 'S') AND (p_stahis = 1) AND (p_empatu = p_numemp) AND
          (p_cadatu = p_numcad) AND (l_alterar = TRUE) THEN
          l_datult:='31/12/1900,00:00:00';
          /* busca as informações do histórico de filial. (p_tiphis = 1) */
          IF  (p_tiphis = 1) THEN
              /* Pega o historico anterior cuja empresa destino for igual a atual */
              BEGIN
                  SELECT MAX(DATALT) INTO l_datalt FROM R038HFI WHERE
                         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND EMPATU = NUMEMP AND
                         CADATU = NUMCAD AND DATALT < p_datalt AND STAHIS = 1;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datalt:='31/12/1900,00:00:00';
              END;

              /* Pega o ultimo historico do colaborador */
              BEGIN
                  SELECT MAX(DATALT) INTO l_datult FROM R038HFI WHERE
                         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND EMPATU = NUMEMP AND
                         CADATU = NUMCAD AND DATALT <> p_datalt AND STAHIS = 1;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datult:='31/12/1900,00:00:00';
              END;

          ELSE
              /* busca as informações do histórico de escala. (p_tiphis = 2) */
              BEGIN
                  SELECT DATALT INTO l_datalt FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT < p_datalt AND STAHIS = 1 AND
                         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT < p_datalt AND STAHIS = 1);
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datalt:='31/12/1900,00:00:00';
                  WHEN OTHERS THEN l_datalt:='31/12/1900,00:00:00';
              END;
              BEGIN
                  SELECT DATALT INTO l_datult FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT <> p_datalt AND STAHIS = 1 AND
                         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND
                                  NUMCAD = p_numcad AND DATALT <> p_datalt AND STAHIS = 1 );
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datult:='31/12/1900,00:00:00';
                  WHEN OTHERS THEN l_datult:='31/12/1900,00:00:00';
              END;
          END IF;

          IF  (p_tipope = 'I') OR (p_tipope = 'U') THEN

              /* fecha todos os históricos em aberto para este colaborador */
              l_datant := DATETimeAdd(DD,-1,p_datalt);
              UPDATE R070CRC SET DATFIM = l_datant, STAACC = 2 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                     DATINI < p_datalt AND 
                     ((DATFIM >= p_datalt) OR (DATFIM = l_data_zero));
              l_alt_cred := TRUE;

              /* Se tiver incluindo o ultimo historico */
              IF  (p_datalt > l_datult) OR (l_datult = l_data_zero) OR (l_datult IS NULL) THEN
                  /* busca os créditos de acesso para o colaborador com a escala. */
                  FOREACH c_r070dca INTO  l_r070dca.IniFai,
                                          l_r070dca.FimFai,
                                          l_r070dca.CreDia,
                                          l_r070dca.LimCon,
                                          l_r070dca.VerPlf,
                                          l_r070dca.CodPlf
                  LOOP
                      l_count:=0;
                      BEGIN
                          /* verifica se já existe o registro. */
                          SELECT COUNT(*) INTO l_count
                            FROM R070CRC
                           WHERE NUMEMP = p_numemp
                             AND TIPCOL = p_tipcol
                             AND NUMCAD = p_numcad
                             AND DATINI = p_datalt
                             AND INIFAI = l_r070dca.IniFai
                             AND VERPLF = l_r070dca.VerPlf
                             AND CODPLF = l_r070dca.CodPlf;
                      EXCEPTION
                          WHEN NO_DATA_FOUND THEN l_count:=0;
                      END;

                      IF  l_count = 0 THEN
                          /* inclui os creditos de acesso do colaborador. */
                          INSERT INTO R070CRC (NUMEMP,TIPCOL,NUMCAD,DATINI,DATFIM,INIFAI,FIMFAI,
                                               CREDIA,SALATU,STAACC,LIMCON,DATCON,QTDCON,VERPLF,CODPLF)
                                 VALUES (p_numemp,p_tipcol,p_numcad,p_datalt,l_data_zero,
                                         l_r070dca.IniFai,l_r070dca.FimFai,l_r070dca.CreDia,
                                         l_r070dca.CreDia,1,l_r070dca.LimCon,l_datcon,l_qtdcon,l_r070dca.VerPlf,l_r070dca.CodPlf);
                          l_alt_cred := TRUE;
                      ELSE
		                  UPDATE R070CRC SET DATFIM = l_data_zero WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt AND INIFAI = l_r070dca.IniFai AND 
		                  VERPLF = l_r070dca.VerPlf AND CODPLF = l_r070dca.CodPlf;
		                  l_alt_cred := TRUE;
                      END IF;
                  END LOOP;
              END IF;
          ELSIF p_tipope = 'D' THEN
              /* exclui historico de créditos de acesso. */
              DELETE FROM R070CRC WHERE NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND DATINI=p_datalt;
              /* abre o historico anterior.  */
              UPDATE R070CRC SET DATFIM = l_data_zero, STAACC = 1, DATCON = l_datcon, QTDCON = l_qtdcon
               WHERE NUMEMP = p_numemp
                 AND TIPCOL = p_tipcol
                 AND NUMCAD = p_numcad
                 AND DATINI = l_datult;
              l_alt_cred := TRUE;
          END IF;
      ELSE
          /* fecha todos os históricos em aberto para este colaborador */
          IF  (p_tipope = 'I') AND (NOT ((p_tiphis=2) AND (l_codesc=0))) THEN
              l_datant := DATETimeAdd(DD,-1,p_datalt);
              UPDATE R070CRC SET DATFIM = l_datant, STAACC = 2 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                     DATINI < p_datalt AND
                     ((DATFIM >= p_datalt) OR (DATFIM = l_data_zero));
              l_alt_cred := TRUE;
          END IF;
      END IF;
      
      /* Para retorno da troca de escala */
      IF  (p_tipOpe = 'U') AND (p_tiphis = 2) AND (l_codesc = 0) THEN
          l_count := 0;
          BEGIN
              SELECT 1, DATFIM INTO l_count, l_fimTES FROM R064TES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt;
          EXCEPTION
              WHEN NO_DATA_FOUND THEN l_count:=0;
          END;
          
          IF (l_count > 0) THEN
              IF (l_fimtes < l_data_atual) THEN
                  l_staacc := 2;
              ELSE
                  l_staacc := 1;              
              END IF;
              BEGIN
                  UPDATE R070CRC SET DATFIM = l_fimtes, STAACC = l_staacc WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN NULL;
              END;                  
          END IF; 
          
          /* Busca a escala original para atualizar */
          l_codesc := 0;
          BEGIN
              SELECT DATALT, CODESC INTO l_dathes, l_codesc FROM R038HES WHERE
			         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND STAHIS = 1 AND
			         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND STAHIS = 1);
          EXCEPTION
              WHEN OTHERS THEN l_codesc := 0;
		  END;
          
		  /* Procedure que atualiza os creditos de acesso.*/
          IF (l_codesc > 0) THEN
              SP_GerCrc('I', 2, p_NUMEMP, p_TIPCOL, p_NUMCAD, l_dathes, p_NUMEMP, p_NUMCAD, p_codfil, l_CODESC, 1);
		  END IF;          
            
      END IF;

      /* SE HOUVE ALTERAÇÕES NOS CRÉDITOS DE ACESSO DA PESSOA */
      IF ( l_alt_cred = TRUE ) THEN

        /*Remove os créditos globais e créditos por local físico da pessoa na Concentradora, somente se houver crachá*/
        SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
        IF   (l_cracha = 0)  THEN
            SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
        END IF;

        IF (l_cracha <> 0) THEN
          SP_PEND06(4,l_idtpes,0,0);
        END IF;

        /*Chama a SP_CRECON passando o local físico 0(zero), afim de atualizar os registros da r070con*/
        SP_CRECON(p_tipcol, p_numemp, p_tipcol, p_numcad,0,'0','0','0', l_verplf, 0);

        /*INSERE OS CRÉDITOS ATIVOS*/
        FOREACH c_CREDCOL INTO  l_CREDCOL.VerPlf,
                                l_CREDCOL.CodPlf
        LOOP
          /*Atualiza os créditos*/
          SP_CRECON(p_tipcol, p_numemp, p_tipcol, p_numcad,0,'0','0','0', l_CREDCOL.VerPlf, l_CREDCOL.CodPlf);
        END LOOP;
      END IF;

  END IF;
END		SENIOR;23,SP_INTSTR
SP_RETCRA
SP_PEND06
SP_CRECON
¿=␀␀


/* Procedure que gera os creditos de acesso de acordo com a definição.*/
PROCEDURE SP_GerCrc(P_TIPOPE CHAR(1),P_TIPHIS NUMBER(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATALT DATE,P_EMPATU NUMBER(5),P_CADATU NUMBER(9),P_CODFIL NUMBER(6),P_CODESC NUMBER(9),P_STAHIS NUMBER(1))
 IS

  l_gercrc       CHAR(1);
  l_uticcr       CHAR(1);
  l_codesc         R006ESC.CodEsc%TYPE;
  l_count        NUMBER(5);
  l_fimTes       DATE;
  l_dathes       DATE;  
  l_datalt       DATE;
  l_datult       DATE;
  l_datant       DATE;
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_datcon       DATE;
  l_qtdcon       NUMBER(3);
  l_hora_atual   NUMBER(4);
  l_verplf       NUMBER(3);
  l_alterar      BOOLEAN;
  l_concre       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp_str   CHAR(4);
  l_tipcol_str   CHAR(1);
  l_numcad_str   CHAR(9);
  l_alt_cred     BOOLEAN;
  l_cracha       NUMBER(12);
  l_staacc       NUMBER(1);

  /* CURSOR que busca os créditos de acesso para o visitante com escala. */
  CURSOR c_R070DCA IS
         SELECT INIFAI,FIMFAI,CREDIA,LIMCON,VERPLF,CODPLF FROM R070DCA
         WHERE NUMEMP = p_numemp AND CODFIL = p_codfil AND CODESC = l_codesc AND TIPPES = p_tipcol;
  TYPE t_R070DCA IS RECORD(
    INIFAI   R070DCA.INIFAI%TYPE,
    FIMFAI   R070DCA.FIMFAI%TYPE,
    CREDIA   R070DCA.CREDIA%TYPE,
    LIMCON   R070DCA.LIMCON%TYPE,
    VERPLF   R070DCA.VERPLF%TYPE,
    CODPLF   R070DCA.CODPLF%TYPE);
  l_r070DCA t_R070DCA;

  /*CURSOR PARA BUSCAR OS LOCAIS FÍSICOS QUE A PESSOA POSSÚI CRÉDITOS ATIVOS, ONDE O LOCAL SEJA MAIOR QUE ZERO*/
  CURSOR c_CREDCOL IS
         SELECT DISTINCT VERPLF
                        ,CODPLF
           FROM R070CRC
          WHERE R070CRC.NUMEMP = p_numemp
            AND R070CRC.TIPCOL = p_tipcol
            AND R070CRC.NUMCAD = p_numcad
            AND R070CRC.CODPLF > 0
            AND R070CRC.DATINI <= l_data_atual
            AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR
                 (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual));
  TYPE t_CREDCOL IS RECORD(
    VERPLF   R070CRC.INIFAI%TYPE,
    CODPLF   R070CRC.FIMFAI%TYPE);
  l_CREDCOL t_CREDCOL;

BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_alt_cred   := FALSE;
  l_datcon     := l_data_zero;
  l_qtdcon     := 0;
  l_cracha     := 0;

  /*Busca versão do plano ativa*/
  BEGIN
      SELECT VERPLF INTO l_verplf
        FROM R058VPL
       WHERE DATCRI <= l_data_atual
         AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
  EXCEPTION
      WHEN OTHERS THEN
          l_verplf := 1;
  END;

  /*Monta o idtpes da pessoa*/
  SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
  SP_INTSTR(p_numemp,'9999',l_numemp_str OUT);
  SP_INTSTR(p_tipcol,'9',l_tipcol_str OUT);
  SP_INTSTR(p_numcad,'999999999',l_numcad_str OUT);
  l_idtpes:= l_tippes_str||l_numemp_str||l_tipcol_str||l_numcad_str;
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
      /*Controle do Loop.*/
      IF (Length(l_idtpes) > 22) THEN
          EXIT;
      END IF;
      l_idtpes := ' '||l_idtpes;
  END LOOP;

  /* Busca parametro que indica se eh para gerar créditos de acesso automaticamente. */
  BEGIN
     SELECT GERCRC, UTICCR INTO l_gercrc, l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_gercrc := 'N';
      l_uticcr := 'N';
  END;

  /* Busca parametro que indica */
  BEGIN
     SELECT CONCRE INTO l_concre FROM R034DAC WHERE
            NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
  EXCEPTION
    WHEN OTHERS THEN
      l_concre := 0;
  END;

  /*Se utilizar a rotina de compra de créditos, não deve prosseguir com a geração automática de créditos*/
  IF (l_uticcr = 'N') OR (l_uticcr IS NULL) OR
     ((l_uticcr = 'S') AND (l_concre = 0 OR l_concre = 3)) THEN

      /* se estiver inserindo um histórico de filial e deixar a escala zerado */
      /* significa que ele deve usar a última escala do colaborador.          */
      l_codesc := 0;
      IF  (p_tiphis = 1) AND (p_codesc = 0) THEN
          BEGIN
             SELECT CODESC INTO l_codesc FROM R038HES WHERE
                    NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                    DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND
                    TIPCOL = p_tipcol AND NUMCAD = p_numcad);
          EXCEPTION
              WHEN OTHERS THEN l_codesc := 0;
          END;
      ELSE
          l_codesc := p_codesc;
      END IF;

      /* Verifica se existe faixas para a definição informada de filial e escala */
      l_count := 0;
      BEGIN
         SELECT COUNT(*) INTO l_count FROM R070DCA WHERE
                NUMEMP = p_numemp AND CODFIL = p_codfil AND CODESC = l_codesc AND TIPPES = p_tipcol;
      EXCEPTION
          WHEN OTHERS THEN l_count := 0;
      END;
      /* se não encontrar nada de acordo com a definição, então buscar o registro com a escala zero.*/
      IF  (l_count = 0) THEN
          l_codesc := 0;
      END IF;

      /* Se estiver alterando o histórico de escala e não existir faixa com a escala informada */
      /* é preciso verificar se já existem créditos em aberto. Se existirem não deve fazer nada. */
      IF  (p_tiphis = 2) AND (l_codesc = 0) THEN
          BEGIN
             SELECT COUNT(*) INTO l_count FROM R070CRC 
                 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad 
                     AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR 
                         (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual)
                     );
          EXCEPTION
              WHEN OTHERS THEN l_alterar := FALSE;
          END;
          IF (l_count > 0) THEN
              l_alterar := FALSE;
          ELSE
              l_alterar := TRUE;
          END IF;
      ELSE
          l_alterar := TRUE;
      END IF;

      /* somente gravar créditos se o historico for somente de troca de filial. */
      IF  (l_gercrc = 'S') AND (p_stahis = 1) AND (p_empatu = p_numemp) AND
          (p_cadatu = p_numcad) AND (l_alterar = TRUE) THEN
          l_datult:='31/12/1900,00:00:00';
          /* busca as informações do histórico de filial. (p_tiphis = 1) */
          IF  (p_tiphis = 1) THEN
              /* Pega o historico anterior cuja empresa destino for igual a atual */
              BEGIN
                  SELECT MAX(DATALT) INTO l_datalt FROM R038HFI WHERE
                         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND EMPATU = NUMEMP AND
                         CADATU = NUMCAD AND DATALT < p_datalt AND STAHIS = 1;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datalt:='31/12/1900,00:00:00';
              END;

              /* Pega o ultimo historico do colaborador */
              BEGIN
                  SELECT MAX(DATALT) INTO l_datult FROM R038HFI WHERE
                         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND EMPATU = NUMEMP AND
                         CADATU = NUMCAD AND DATALT <> p_datalt AND STAHIS = 1;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datult:='31/12/1900,00:00:00';
              END;

          ELSE
              /* busca as informações do histórico de escala. (p_tiphis = 2) */
              BEGIN
                  SELECT DATALT INTO l_datalt FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT < p_datalt AND STAHIS = 1 AND
                         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT < p_datalt AND STAHIS = 1);
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datalt:='31/12/1900,00:00:00';
                  WHEN OTHERS THEN l_datalt:='31/12/1900,00:00:00';
              END;
              BEGIN
                  SELECT DATALT INTO l_datult FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT <> p_datalt AND STAHIS = 1 AND
                         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND
                                  NUMCAD = p_numcad AND DATALT <> p_datalt AND STAHIS = 1 );
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datult:='31/12/1900,00:00:00';
                  WHEN OTHERS THEN l_datult:='31/12/1900,00:00:00';
              END;
          END IF;

          IF  (p_tipope = 'I') OR (p_tipope = 'U') THEN

              /* fecha todos os históricos em aberto para este colaborador */
              l_datant := DATETimeAdd(DD,-1,p_datalt);
              UPDATE R070CRC SET DATFIM = l_datant, STAACC = 2 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                     DATINI < p_datalt AND 
                     ((DATFIM >= p_datalt) OR (DATFIM = l_data_zero));
              l_alt_cred := TRUE;

              /* Se tiver incluindo o ultimo historico */
              IF  (p_datalt > l_datult) OR (l_datult = l_data_zero) OR (l_datult IS NULL) THEN
                  /* busca os créditos de acesso para o colaborador com a escala. */
                  FOREACH c_r070dca INTO  l_r070dca.IniFai,
                                          l_r070dca.FimFai,
                                          l_r070dca.CreDia,
                                          l_r070dca.LimCon,
                                          l_r070dca.VerPlf,
                                          l_r070dca.CodPlf
                  LOOP
                      l_count:=0;
                      BEGIN
                          /* verifica se já existe o registro. */
                          SELECT COUNT(*) INTO l_count
                            FROM R070CRC
                           WHERE NUMEMP = p_numemp
                             AND TIPCOL = p_tipcol
                             AND NUMCAD = p_numcad
                             AND DATINI = p_datalt
                             AND INIFAI = l_r070dca.IniFai
                             AND VERPLF = l_r070dca.VerPlf
                             AND CODPLF = l_r070dca.CodPlf;
                      EXCEPTION
                          WHEN NO_DATA_FOUND THEN l_count:=0;
                      END;

                      IF  l_count = 0 THEN
                          /* inclui os creditos de acesso do colaborador. */
                          INSERT INTO R070CRC (NUMEMP,TIPCOL,NUMCAD,DATINI,DATFIM,INIFAI,FIMFAI,
                                               CREDIA,SALATU,STAACC,LIMCON,DATCON,QTDCON,VERPLF,CODPLF)
                                 VALUES (p_numemp,p_tipcol,p_numcad,p_datalt,l_data_zero,
                                         l_r070dca.IniFai,l_r070dca.FimFai,l_r070dca.CreDia,
                                         l_r070dca.CreDia,1,l_r070dca.LimCon,l_datcon,l_qtdcon,l_r070dca.VerPlf,l_r070dca.CodPlf);
                          l_alt_cred := TRUE;
                      ELSE
		                  UPDATE R070CRC SET DATFIM = l_data_zero WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt AND INIFAI = l_r070dca.IniFai AND 
		                  VERPLF = l_r070dca.VerPlf AND CODPLF = l_r070dca.CodPlf;
		                  l_alt_cred := TRUE;
                      END IF;
                  END LOOP;
              END IF;
          ELSIF p_tipope = 'D' THEN
              /* exclui historico de créditos de acesso. */
              DELETE FROM R070CRC WHERE NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND DATINI=p_datalt;
              /* abre o historico anterior.  */
              UPDATE R070CRC SET DATFIM = l_data_zero, STAACC = 1, DATCON = l_datcon, QTDCON = l_qtdcon
               WHERE NUMEMP = p_numemp
                 AND TIPCOL = p_tipcol
                 AND NUMCAD = p_numcad
                 AND DATINI = l_datult;
              l_alt_cred := TRUE;
          END IF;
      ELSE
          /* fecha todos os históricos em aberto para este colaborador */
          IF  (p_tipope = 'I') AND (NOT ((p_tiphis=2) AND (l_codesc=0))) THEN
              l_datant := DATETimeAdd(DD,-1,p_datalt);
              UPDATE R070CRC SET DATFIM = l_datant, STAACC = 2 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                     DATINI < p_datalt AND
                     ((DATFIM >= p_datalt) OR (DATFIM = l_data_zero));
              l_alt_cred := TRUE;
          END IF;
      END IF;
      
      /* Para retorno da troca de escala */
      IF  (p_tipOpe = 'U') AND (p_tiphis = 2) AND (l_codesc = 0) THEN
          l_count := 0;
          BEGIN
              SELECT 1, DATFIM INTO l_count, l_fimTES FROM R064TES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt;
          EXCEPTION
              WHEN NO_DATA_FOUND THEN l_count:=0;
          END;
          
          IF (l_count > 0) THEN
              IF (l_fimtes < l_data_atual) THEN
                  l_staacc := 2;
              ELSE
                  l_staacc := 1;              
              END IF;
              BEGIN
                  UPDATE R070CRC SET DATFIM = l_fimtes, STAACC = l_staacc WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN NULL;
              END;                  
          END IF; 
          
          /* Busca a escala original para atualizar */
          l_codesc := 0;
          BEGIN
              SELECT DATALT, CODESC INTO l_dathes, l_codesc FROM R038HES WHERE
			         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND STAHIS = 1 AND
			         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND STAHIS = 1);
          EXCEPTION
              WHEN OTHERS THEN l_codesc := 0;
		  END;
          
		  /* Procedure que atualiza os creditos de acesso.*/
          IF (l_codesc > 0) THEN
              SP_GerCrc('I', 2, p_NUMEMP, p_TIPCOL, p_NUMCAD, l_dathes, p_NUMEMP, p_NUMCAD, p_codfil, l_CODESC, 1);
		  END IF;          
            
      END IF;

      /* SE HOUVE ALTERAÇÕES NOS CRÉDITOS DE ACESSO DA PESSOA */
      IF ( l_alt_cred = TRUE ) THEN

        /*Remove os créditos globais e créditos por local físico da pessoa na Concentradora, somente se houver crachá*/
        SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
        IF   (l_cracha = 0)  THEN
            SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
        END IF;

        IF (l_cracha <> 0) THEN
          SP_PEND06(4,l_idtpes,0,0);
        END IF;

        /*Chama a SP_CRECON passando o local físico 0(zero), afim de atualizar os registros da r070con*/
        SP_CRECON(p_tipcol, p_numemp, p_tipcol, p_numcad,0,'0','0','0', l_verplf, 0);

        /*INSERE OS CRÉDITOS ATIVOS*/
        FOREACH c_CREDCOL INTO  l_CREDCOL.VerPlf,
                                l_CREDCOL.CodPlf
        LOOP
          /*Atualiza os créditos*/
          SP_CRECON(p_tipcol, p_numemp, p_tipcol, p_numcad,0,'0','0','0', l_CREDCOL.VerPlf, l_CREDCOL.CodPlf);
        END LOOP;
      END IF;

  END IF;
END		SENIOR;24,SP_INTSTR
SP_RETCRA
SP_PEND06
SP_CRECON
¿=␀␀


/* Procedure que gera os creditos de acesso de acordo com a definição.*/
PROCEDURE SP_GerCrc(P_TIPOPE CHAR(1),P_TIPHIS NUMBER(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATALT DATE,P_EMPATU NUMBER(5),P_CADATU NUMBER(9),P_CODFIL NUMBER(6),P_CODESC NUMBER(9),P_STAHIS NUMBER(1))
 IS

  l_gercrc       CHAR(1);
  l_uticcr       CHAR(1);
  l_codesc         R006ESC.CodEsc%TYPE;
  l_count        NUMBER(5);
  l_fimTes       DATE;
  l_dathes       DATE;  
  l_datalt       DATE;
  l_datult       DATE;
  l_datant       DATE;
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_datcon       DATE;
  l_qtdcon       NUMBER(3);
  l_hora_atual   NUMBER(4);
  l_verplf       NUMBER(3);
  l_alterar      BOOLEAN;
  l_concre       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp_str   CHAR(4);
  l_tipcol_str   CHAR(1);
  l_numcad_str   CHAR(9);
  l_alt_cred     BOOLEAN;
  l_cracha       NUMBER(12);
  l_staacc       NUMBER(1);

  /* CURSOR que busca os créditos de acesso para o visitante com escala. */
  CURSOR c_R070DCA IS
         SELECT INIFAI,FIMFAI,CREDIA,LIMCON,VERPLF,CODPLF FROM R070DCA
         WHERE NUMEMP = p_numemp AND CODFIL = p_codfil AND CODESC = l_codesc AND TIPPES = p_tipcol;
  TYPE t_R070DCA IS RECORD(
    INIFAI   R070DCA.INIFAI%TYPE,
    FIMFAI   R070DCA.FIMFAI%TYPE,
    CREDIA   R070DCA.CREDIA%TYPE,
    LIMCON   R070DCA.LIMCON%TYPE,
    VERPLF   R070DCA.VERPLF%TYPE,
    CODPLF   R070DCA.CODPLF%TYPE);
  l_r070DCA t_R070DCA;

  /*CURSOR PARA BUSCAR OS LOCAIS FÍSICOS QUE A PESSOA POSSÚI CRÉDITOS ATIVOS, ONDE O LOCAL SEJA MAIOR QUE ZERO*/
  CURSOR c_CREDCOL IS
         SELECT DISTINCT VERPLF
                        ,CODPLF
           FROM R070CRC
          WHERE R070CRC.NUMEMP = p_numemp
            AND R070CRC.TIPCOL = p_tipcol
            AND R070CRC.NUMCAD = p_numcad
            AND R070CRC.CODPLF > 0
            AND R070CRC.DATINI <= l_data_atual
            AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR
                 (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual));
  TYPE t_CREDCOL IS RECORD(
    VERPLF   R070CRC.INIFAI%TYPE,
    CODPLF   R070CRC.FIMFAI%TYPE);
  l_CREDCOL t_CREDCOL;

BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_alt_cred   := FALSE;
  l_datcon     := l_data_zero;
  l_qtdcon     := 0;
  l_cracha     := 0;

  /*Busca versão do plano ativa*/
  BEGIN
      SELECT VERPLF INTO l_verplf
        FROM R058VPL
       WHERE DATCRI <= l_data_atual
         AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
  EXCEPTION
      WHEN OTHERS THEN
          l_verplf := 1;
  END;

  /*Monta o idtpes da pessoa*/
  SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
  SP_INTSTR(p_numemp,'9999',l_numemp_str OUT);
  SP_INTSTR(p_tipcol,'9',l_tipcol_str OUT);
  SP_INTSTR(p_numcad,'999999999',l_numcad_str OUT);
  l_idtpes:= l_tippes_str||l_numemp_str||l_tipcol_str||l_numcad_str;
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
      /*Controle do Loop.*/
      IF (Length(l_idtpes) > 22) THEN
          EXIT;
      END IF;
      l_idtpes := ' '||l_idtpes;
  END LOOP;

  /* Busca parametro que indica se eh para gerar créditos de acesso automaticamente. */
  BEGIN
     SELECT GERCRC, UTICCR INTO l_gercrc, l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_gercrc := 'N';
      l_uticcr := 'N';
  END;

  /* Busca parametro que indica */
  BEGIN
     SELECT CONCRE INTO l_concre FROM R034DAC WHERE
            NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
  EXCEPTION
    WHEN OTHERS THEN
      l_concre := 0;
  END;

  /*Se utilizar a rotina de compra de créditos, não deve prosseguir com a geração automática de créditos*/
  IF (l_uticcr = 'N') OR (l_uticcr IS NULL) OR
     ((l_uticcr = 'S') AND (l_concre = 0 OR l_concre = 3)) THEN

      /* se estiver inserindo um histórico de filial e deixar a escala zerado */
      /* significa que ele deve usar a última escala do colaborador.          */
      l_codesc := 0;
      IF  (p_tiphis = 1) AND (p_codesc = 0) THEN
          BEGIN
             SELECT CODESC INTO l_codesc FROM R038HES WHERE
                    NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                    DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND
                    TIPCOL = p_tipcol AND NUMCAD = p_numcad);
          EXCEPTION
              WHEN OTHERS THEN l_codesc := 0;
          END;
      ELSE
          l_codesc := p_codesc;
      END IF;

      /* Verifica se existe faixas para a definição informada de filial e escala */
      l_count := 0;
      BEGIN
         SELECT COUNT(*) INTO l_count FROM R070DCA WHERE
                NUMEMP = p_numemp AND CODFIL = p_codfil AND CODESC = l_codesc AND TIPPES = p_tipcol;
      EXCEPTION
          WHEN OTHERS THEN l_count := 0;
      END;
      /* se não encontrar nada de acordo com a definição, então buscar o registro com a escala zero.*/
      IF  (l_count = 0) THEN
          l_codesc := 0;
      END IF;

      /* Se estiver alterando o histórico de escala e não existir faixa com a escala informada */
      /* é preciso verificar se já existem créditos em aberto. Se existirem não deve fazer nada. */
      IF  (p_tiphis = 2) AND (l_codesc = 0) THEN
          BEGIN
             SELECT COUNT(*) INTO l_count FROM R070CRC 
                 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad 
                     AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR 
                         (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual)
                     );
          EXCEPTION
              WHEN OTHERS THEN l_alterar := FALSE;
          END;
          IF (l_count > 0) THEN
              l_alterar := FALSE;
          ELSE
              l_alterar := TRUE;
          END IF;
      ELSE
          l_alterar := TRUE;
      END IF;

      /* somente gravar créditos se o historico for somente de troca de filial. */
      IF  (l_gercrc = 'S') AND (p_stahis = 1) AND (p_empatu = p_numemp) AND
          (p_cadatu = p_numcad) AND (l_alterar = TRUE) THEN
          l_datult:='31/12/1900,00:00:00';
          /* busca as informações do histórico de filial. (p_tiphis = 1) */
          IF  (p_tiphis = 1) THEN
              /* Pega o historico anterior cuja empresa destino for igual a atual */
              BEGIN
                  SELECT MAX(DATALT) INTO l_datalt FROM R038HFI WHERE
                         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND EMPATU = NUMEMP AND
                         CADATU = NUMCAD AND DATALT < p_datalt AND STAHIS = 1;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datalt:='31/12/1900,00:00:00';
              END;

              /* Pega o ultimo historico do colaborador */
              BEGIN
                  SELECT MAX(DATALT) INTO l_datult FROM R038HFI WHERE
                         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND EMPATU = NUMEMP AND
                         CADATU = NUMCAD AND DATALT <> p_datalt AND STAHIS = 1;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datult:='31/12/1900,00:00:00';
              END;

          ELSE
              /* busca as informações do histórico de escala. (p_tiphis = 2) */
              BEGIN
                  SELECT DATALT INTO l_datalt FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT < p_datalt AND STAHIS = 1 AND
                         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT < p_datalt AND STAHIS = 1);
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datalt:='31/12/1900,00:00:00';
                  WHEN OTHERS THEN l_datalt:='31/12/1900,00:00:00';
              END;
              BEGIN
                  SELECT DATALT INTO l_datult FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT <> p_datalt AND STAHIS = 1 AND
                         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND
                                  NUMCAD = p_numcad AND DATALT <> p_datalt AND STAHIS = 1 );
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datult:='31/12/1900,00:00:00';
                  WHEN OTHERS THEN l_datult:='31/12/1900,00:00:00';
              END;
          END IF;

          IF  (p_tipope = 'I') OR (p_tipope = 'U') THEN

              /* fecha todos os históricos em aberto para este colaborador */
              l_datant := DATETimeAdd(DD,-1,p_datalt);
              UPDATE R070CRC SET DATFIM = l_datant, STAACC = 2 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                     DATINI < p_datalt AND 
                     ((DATFIM >= p_datalt) OR (DATFIM = l_data_zero));
              l_alt_cred := TRUE;

              /* Se tiver incluindo o ultimo historico */
              IF  (p_datalt > l_datult) OR (l_datult = l_data_zero) OR (l_datult IS NULL) THEN
                  /* busca os créditos de acesso para o colaborador com a escala. */
                  FOREACH c_r070dca INTO  l_r070dca.IniFai,
                                          l_r070dca.FimFai,
                                          l_r070dca.CreDia,
                                          l_r070dca.LimCon,
                                          l_r070dca.VerPlf,
                                          l_r070dca.CodPlf
                  LOOP
                      l_count:=0;
                      BEGIN
                          /* verifica se já existe o registro. */
                          SELECT COUNT(*) INTO l_count
                            FROM R070CRC
                           WHERE NUMEMP = p_numemp
                             AND TIPCOL = p_tipcol
                             AND NUMCAD = p_numcad
                             AND DATINI = p_datalt
                             AND INIFAI = l_r070dca.IniFai
                             AND VERPLF = l_r070dca.VerPlf
                             AND CODPLF = l_r070dca.CodPlf;
                      EXCEPTION
                          WHEN NO_DATA_FOUND THEN l_count:=0;
                      END;

                      IF  l_count = 0 THEN
                          /* inclui os creditos de acesso do colaborador. */
                          INSERT INTO R070CRC (NUMEMP,TIPCOL,NUMCAD,DATINI,DATFIM,INIFAI,FIMFAI,
                                               CREDIA,SALATU,STAACC,LIMCON,DATCON,QTDCON,VERPLF,CODPLF)
                                 VALUES (p_numemp,p_tipcol,p_numcad,p_datalt,l_data_zero,
                                         l_r070dca.IniFai,l_r070dca.FimFai,l_r070dca.CreDia,
                                         l_r070dca.CreDia,1,l_r070dca.LimCon,l_datcon,l_qtdcon,l_r070dca.VerPlf,l_r070dca.CodPlf);
                          l_alt_cred := TRUE;
                      ELSE
		                  UPDATE R070CRC SET DATFIM = l_data_zero WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt AND INIFAI = l_r070dca.IniFai AND 
		                  VERPLF = l_r070dca.VerPlf AND CODPLF = l_r070dca.CodPlf;
		                  l_alt_cred := TRUE;
                      END IF;
                  END LOOP;
              END IF;
          ELSIF p_tipope = 'D' THEN
              /* exclui historico de créditos de acesso. */
              DELETE FROM R070CRC WHERE NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND DATINI=p_datalt;
              /* abre o historico anterior.  */
              UPDATE R070CRC SET DATFIM = l_data_zero, STAACC = 1, DATCON = l_datcon, QTDCON = l_qtdcon
               WHERE NUMEMP = p_numemp
                 AND TIPCOL = p_tipcol
                 AND NUMCAD = p_numcad
                 AND DATINI = l_datult;
              l_alt_cred := TRUE;
          END IF;
      ELSE
          /* fecha todos os históricos em aberto para este colaborador */
          IF  (p_tipope = 'I') AND (NOT ((p_tiphis=2) AND (l_codesc=0))) THEN
              l_datant := DATETimeAdd(DD,-1,p_datalt);
              UPDATE R070CRC SET DATFIM = l_datant, STAACC = 2 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                     DATINI < p_datalt AND
                     ((DATFIM >= p_datalt) OR (DATFIM = l_data_zero));
              l_alt_cred := TRUE;
          END IF;
      END IF;
      
      /* Para retorno da troca de escala */
      IF  (p_tipOpe = 'U') AND (p_tiphis = 2) AND (l_codesc = 0) THEN
          l_count := 0;
          BEGIN
              SELECT 1, DATFIM INTO l_count, l_fimTES FROM R064TES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt;
          EXCEPTION
              WHEN NO_DATA_FOUND THEN l_count:=0;
          END;
          
          IF (l_count > 0) THEN
              IF (l_fimtes < l_data_atual) THEN
                  l_staacc := 2;
              ELSE
                  l_staacc := 1;              
              END IF;
              BEGIN
                  UPDATE R070CRC SET DATFIM = l_fimtes, STAACC = l_staacc WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN NULL;
              END;                  
          END IF; 
          
          /* Busca a escala original para atualizar */
          l_codesc := 0;
          BEGIN
              SELECT DATALT, CODESC INTO l_dathes, l_codesc FROM R038HES WHERE
			         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND STAHIS = 1 AND
			         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND STAHIS = 1);
          EXCEPTION
              WHEN OTHERS THEN l_codesc := 0;
		  END;
          
		  /* Procedure que atualiza os creditos de acesso.*/
          IF (l_codesc > 0) THEN
              SP_GerCrc('I', 2, p_NUMEMP, p_TIPCOL, p_NUMCAD, l_dathes, p_NUMEMP, p_NUMCAD, p_codfil, l_CODESC, 1);
		  END IF;          
            
      END IF;

      /* SE HOUVE ALTERAÇÕES NOS CRÉDITOS DE ACESSO DA PESSOA */
      IF ( l_alt_cred = TRUE ) THEN

        /*Remove os créditos globais e créditos por local físico da pessoa na Concentradora, somente se houver crachá*/
        SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
        IF   (l_cracha = 0)  THEN
            SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
        END IF;

        IF (l_cracha <> 0) THEN
          SP_PEND06(4,l_idtpes,0,0);
        END IF;

        /*Chama a SP_CRECON passando o local físico 0(zero), afim de atualizar os registros da r070con*/
        SP_CRECON(p_tipcol, p_numemp, p_tipcol, p_numcad,0,'0','0','0', l_verplf, 0);

        /*INSERE OS CRÉDITOS ATIVOS*/
        FOREACH c_CREDCOL INTO  l_CREDCOL.VerPlf,
                                l_CREDCOL.CodPlf
        LOOP
          /*Atualiza os créditos*/
          SP_CRECON(p_tipcol, p_numemp, p_tipcol, p_numcad,0,'0','0','0', l_CREDCOL.VerPlf, l_CREDCOL.CodPlf);
        END LOOP;
      END IF;

  END IF;
END␀?ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
~PROCEDURE SP_GERLOGPER(P_TIPOPE CHAR(1),P_ESTPOS NUMBER(3),P_POSTRA VARCHAR2(25),P_CODDSP NUMBER(9))
 IS
BEGIN
  NULL;
END		SENIOR;20)SP_RETIDTPES
SP_INTSTR
SP_RET_REG_AUD
¯H␀␀


PROCEDURE SP_GERLOGPER(P_TIPOPE CHAR(1),P_ESTPOS NUMBER(3),P_POSTRA VARCHAR2(25),P_CODDSP NUMBER(9))
 IS

l_datatu DATE;
  l_idtcol    CHAR(23);
  l_count     NUMBER(5);
  l_oridef    NUMBER(1);
  l_codRPA    NUMBER(15);
  l_temAud34PRM NUMBER(2);
  l_temAud34FAP NUMBER(2);  
  l_numempSTR VARCHAR2(255);
  l_tipcolSTR VARCHAR2(255);
  l_numcadSTR VARCHAR2(255);
  l_ConCreSTR VARCHAR(1);
  l_ConFaiSTR VARCHAR(1);
  l_TemAlmSTR VARCHAR(3);
  l_TemPacSTR VARCHAR(3);
  l_GraConSTR VARCHAR(3);
  l_TolIntSTR VARCHAR(3);
  l_prmSTR    VARCHAR(5);
  l_UsaBioSTR VARCHAR(1);
  l_TolAcpSTR VARCHAR2(255);
  l_horatu    NUMBER(5);
  l_CodPltSTR VARCHAR2(5);
  l_CodPlt    NUMBER(5);
  l_CodRlgSTR VARCHAR(5);
  l_CodRlg    NUMBER(5);
  l_VerPlfSTR VARCHAR(3);
  l_VerPlf    NUMBER(3);
  l_CodPlfSTR VARCHAR(7);
  l_CodPlf    NUMBER(7);
  l_CodDspSTR VARCHAR(9);
  l_DiaSemSTR VARCHAR(1);
  l_IniFaiSTR VARCHAR(5);
  l_FimFaiSTR VARCHAR(5);
  l_codusu    NUMBER(9);
  l_EstPosSTR VARCHAR(3); 

  CURSOR c_r038HPO IS
    SELECT R038HPO.NUMEMP, R038HPO.TIPCOL, R038HPO.NUMCAD, R017TAP.HISPRI, R038HPO.INIATU, R038HPO.TERATU FROM R038HPO, R017TAP
      WHERE R038HPO.CODTAP = R017TAP.CODTAP AND ESTPOS = p_estpos AND POSTRA = p_postra
        AND R038HPO.INIATU <= l_datatu AND R038HPO.TERATU >= l_datatu;
  TYPE t_r038HPO IS RECORD(
    NUMEMP   R038HPO.NUMEMP%TYPE,
    TIPCOL   R038HPO.TIPCOL%TYPE,
    NUMCAD   R038HPO.NUMCAD%TYPE,
    HISPRI   R017TAP.HISPRI%TYPE,
    INIATU   R038HPO.INIATU%TYPE,
    TERATU   R038HPO.TERATU%TYPE);
  l_r038HPO t_r038HPO;

  /* CURSOR QUE OBTEM AS FAIXAS DE ACESSO DA PERMISSAO POR POSTO DE TRABALHO */
  CURSOR c_r017FAP IS
    SELECT CODPLT, CODRLG, CODDSP, VERPLF, CODPLF, INIFAI, FIMFAI, DIASEM
    FROM R017FAP WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;
    TYPE t_r017FAP IS RECORD(
    CODPLT   R017FAP.CODPLT%TYPE,
    CODRLG   R017FAP.CODRLG%TYPE,
    CODDSP   R017FAP.CODDSP%TYPE,
    VERPLF   R017FAP.VERPLF%TYPE,
    CODPLF   R017FAP.CODPLF%TYPE,
    INIFAI   R017FAP.INIFAI%TYPE,
    FIMFAI   R017FAP.FIMFAI%TYPE,
    DIASEM   R017FAP.DIASEM%TYPE);
  l_r017FAP t_r017FAP;
BEGIN
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  l_temAud34PRM := 0;
  BEGIN
      SELECT COUNT(*) INTO l_temAud34PRM FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 101;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao realizar o SELECT na tabela R995CTE.';
  END;

  l_temAud34FAP := 0;
  BEGIN
      SELECT COUNT(*) INTO l_temAud34FAP FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 102;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao realizar o SELECT na tabela R995CTE.';
  END;

  l_codRPA := 0;

  l_numempSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMEMP);
  l_numempSTR := LTRIM(l_numempSTR);
  l_numempSTR := RTRIM(l_numempSTR);

  l_tipcolSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.TIPCOL);
  l_tipcolSTR := LTRIM(l_tipcolSTR);
  l_tipcolSTR := RTRIM(l_tipcolSTR);

  l_numcadSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMCAD);
  l_numcadSTR := LTRIM(l_numcadSTR);
  l_numcadSTR := RTRIM(l_numcadSTR);

  l_EstPosSTR := CONVERT(NUMBER_TO_CHAR,p_estpos);
  l_EstPosSTR := LTRIM(l_EstPosSTR);
  l_EstPosSTR := RTRIM(l_EstPosSTR);

  /* BUSCO TODOS OS COLABORADORES QUE POSSUEM ESTE POSTO DE TRABALHO VIGENTE NA DATA ATUAL */
  FOREACH c_r038HPO INTO l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_r038HPO.HISPRI, l_r038HPO.INIATU, l_r038HPO.TERATU
  LOOP    
    IF (l_r038HPO.HISPRI = 'S') THEN
      l_oridef := 1; /* HISTORICO PRINCIPAL */
    ELSE
      l_oridef := 2; /* HISTORICO ADICIONAL */
    END IF;

    SELECT CODUSU INTO l_codusu FROM R038HPO WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND NUMEMP = l_r038HPO.NUMEMP AND TIPCOL = l_r038HPO.TIPCOL AND NUMCAD = l_r038HPO.NUMCAD AND INIATU = l_r038HPO.INIATU AND TERATU = l_r038HPO.TERATU;

    SP_RETIDTPES(l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, NULL, NULL, NULL, NULL, l_idtcol OUT);

    /* -- ATRIBUICAO DE PERMISSOES POR LOCAL FISICO/DISPOSITIVO POR POSTO -- */
    /* VERIFICO SE ESTE DISPOSITIVO JA ESTA ASSOCIADO AO COLABORADOR */

    IF (p_tipope = 'I') THEN
      BEGIN
        SELECT COUNT(1) INTO l_count FROM R034PRM WHERE IDTPES = l_idtcol AND CODDSP = p_coddsp;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_count := 0;
          WHEN OTHERS THEN
            RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034PRM.';
      END;

      /* INSERE REGISTRO NA TABELA R034PRM. */
      IF (l_count = 0) THEN
        BEGIN
          IF (l_temAud34PRM > 0) THEN
			SP_RET_REG_AUD(l_codRPA OUT);

            INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                              VALUES (l_codRPA, 3, 6, 1, 101, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

            /*Campos chave da alteração*/
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

            SELECT CODPLT, CODRLG, VERPLF, CODPLF INTO l_codplt, l_codrlg, l_verplf, l_codplf FROM R017PRM WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;

            /*Campos detalhe da alteração*/
            l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_codplt);
            l_CodPltSTR := LTRIM(l_CodPltSTR);
            l_CodPltSTR := RTRIM(l_CodPltSTR);

            l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_codrlg);
            l_CodRlgSTR := LTRIM(l_CodRlgSTR);
            l_CodRlgSTR := RTRIM(l_CodRlgSTR);

            l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_verplf);
            l_VerPlfSTR := LTRIM(l_VerPlfSTR);
            l_VerPlfSTR := RTRIM(l_VerPlfSTR);

            l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_codplf);
            l_CodPlfSTR := LTRIM(l_CodPlfSTR);
            l_CodPlfSTR := RTRIM(l_CodPlfSTR);

            l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, p_coddsp);
            l_CodDspSTR := LTRIM(l_CodDspSTR);
            l_CodDspSTR := RTRIM(l_CodDspSTR);

            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'INCLUSÃO');
          END IF;  
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de inclusão. (R034PRM).';
        END;
      END IF;
    ELSE
        BEGIN
          IF (l_temAud34PRM > 0) THEN
                SP_RET_REG_AUD(l_codRPA OUT);

                INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                                  VALUES (l_codRPA, 3, 6, 1, 101, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

                /*Campos chave da alteração*/
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

                SELECT CODPLT, CODRLG, VERPLF, CODPLF INTO l_codplt, l_codrlg, l_verplf, l_codplf FROM R017PRM WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;

                /*Campos detalhe da alteração*/
                l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_codplt);
                l_CodPltSTR := LTRIM(l_CodPltSTR);
                l_CodPltSTR := RTRIM(l_CodPltSTR);

                l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_codrlg);
                l_CodRlgSTR := LTRIM(l_CodRlgSTR);
                l_CodRlgSTR := RTRIM(l_CodRlgSTR);

                l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_verplf);
                l_VerPlfSTR := LTRIM(l_VerPlfSTR);
                l_VerPlfSTR := RTRIM(l_VerPlfSTR);

                l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_codplf);
                l_CodPlfSTR := LTRIM(l_CodPlfSTR);
                l_CodPlfSTR := RTRIM(l_CodPlfSTR);

                l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, p_coddsp);
                l_CodDspSTR := LTRIM(l_CodDspSTR);
                l_CodDspSTR := RTRIM(l_CodDspSTR);

                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'EXCLUSÃO');
            END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de exclusão. (R034PRM).';
        END;
    END IF;

    /* BUSCO POR FAIXA */
    FOREACH c_r017FAP INTO l_r017FAP.CODPLT, l_r017FAP.CODRLG, l_r017FAP.CODDSP, l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.INIFAI, l_r017FAP.FIMFAI, l_r017FAP.DIASEM
    LOOP
      /* VERIFICO SE ESTA FAIXA JA ESTA ASSOCIADA AO COLABORADOR */
      IF (p_tipope = 'I') THEN
        BEGIN
          SELECT COUNT(1) INTO l_count FROM R034FAP WHERE IDTPES = l_idtcol AND CODPLT = l_r017FAP.CODPLT AND CODRLG = l_r017FAP.CODRLG AND VERPLF = l_r017FAP.VERPLF
            AND CODPLF = l_r017FAP.CODPLF AND INIFAI = l_r017FAP.INIFAI AND DIASEM = l_r017FAP.DIASEM AND CODDSP = l_r017FAP.CODDSP;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              l_count := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034FAP.';
        END;

        /* INSERE REGISTRO NA TABELA R034FAP. */
        IF (l_count = 0) THEN
          BEGIN
            IF (l_temAud34FAP > 0) THEN


			SP_RET_REG_AUD(l_codRPA OUT);
            /*Registro mestre do log*/
            INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                              VALUES (l_codRPA, 3, 6, 1, 102, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

            /*Campos chave da alteração*/
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

            /*Campos detalhe da alteração*/
            l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLT);
            l_CodPltSTR := LTRIM(l_CodPltSTR);
            l_CodPltSTR := RTRIM(l_CodPltSTR);

            l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODRLG);
            l_CodRlgSTR := LTRIM(l_CodRlgSTR);
            l_CodRlgSTR := RTRIM(l_CodRlgSTR);

            l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.VERPLF);
            l_VerPlfSTR := LTRIM(l_VerPlfSTR);
            l_VerPlfSTR := RTRIM(l_VerPlfSTR);

            l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLF);
            l_CodPlfSTR := LTRIM(l_CodPlfSTR);
            l_CodPlfSTR := RTRIM(l_CodPlfSTR);

            l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODDSP);
            l_CodDspSTR := LTRIM(l_CodDspSTR);
            l_CodDspSTR := RTRIM(l_CodDspSTR);

            l_DiaSemSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.DIASEM);
            l_DiaSemSTR := LTRIM(l_DiaSemSTR);
            l_DiaSemSTR := RTRIM(l_DiaSemSTR);

            SP_INTSTR(l_r017FAP.INIFAI,'HH:MM', l_IniFaiSTR OUT);

            SP_INTSTR(l_r017FAP.FIMFAI,'HH:MM', l_FimFaiSTR OUT);

            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIASEM', l_DiaSemSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIFAI', l_IniFaiSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMFAI', l_FimFaiSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'INCLUSÃO');
          END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de inclusão. (R034FAP).';
          END;
        END IF;
      ELSE
        BEGIN
          IF (l_temAud34FAP > 0) THEN
				SP_RET_REG_AUD(l_codRPA OUT);
                /*Registro mestre do log*/
                INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                                  VALUES (l_codRPA, 3, 6, 1, 102, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

                /*Campos chave da alteração*/
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

                /*Campos detalhe da alteração*/
                l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLT);
                l_CodPltSTR := LTRIM(l_CodPltSTR);
                l_CodPltSTR := RTRIM(l_CodPltSTR);

                l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODRLG);
                l_CodRlgSTR := LTRIM(l_CodRlgSTR);
                l_CodRlgSTR := RTRIM(l_CodRlgSTR);

                l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.VERPLF);
                l_VerPlfSTR := LTRIM(l_VerPlfSTR);
                l_VerPlfSTR := RTRIM(l_VerPlfSTR);

                l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLF);
                l_CodPlfSTR := LTRIM(l_CodPlfSTR);
                l_CodPlfSTR := RTRIM(l_CodPlfSTR);

                l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODDSP);
                l_CodDspSTR := LTRIM(l_CodDspSTR);
                l_CodDspSTR := RTRIM(l_CodDspSTR);

                l_DiaSemSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.DIASEM);
                l_DiaSemSTR := LTRIM(l_DiaSemSTR);
                l_DiaSemSTR := RTRIM(l_DiaSemSTR);

                SP_INTSTR(l_r017FAP.INIFAI,'HH:MM', l_IniFaiSTR OUT);

                SP_INTSTR(l_r017FAP.FIMFAI,'HH:MM', l_FimFaiSTR OUT);

                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIASEM', l_DiaSemSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIFAI', l_IniFaiSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMFAI', l_FimFaiSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'EXCLUSÃO');
            END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de exclusão. (R034FAP).';
        END;
      END IF;
    END LOOP;
  END LOOP; /* FOREACH c_r038HPO */
END		SENIOR;21)SP_RETIDTPES
SP_INTSTR
SP_RET_REG_AUD
¯H␀␀


PROCEDURE SP_GERLOGPER(P_TIPOPE CHAR(1),P_ESTPOS NUMBER(3),P_POSTRA VARCHAR2(25),P_CODDSP NUMBER(9))
 IS

l_datatu DATE;
  l_idtcol    CHAR(23);
  l_count     NUMBER(5);
  l_oridef    NUMBER(1);
  l_codRPA    NUMBER(15);
  l_temAud34PRM NUMBER(2);
  l_temAud34FAP NUMBER(2);  
  l_numempSTR VARCHAR2(255);
  l_tipcolSTR VARCHAR2(255);
  l_numcadSTR VARCHAR2(255);
  l_ConCreSTR VARCHAR(1);
  l_ConFaiSTR VARCHAR(1);
  l_TemAlmSTR VARCHAR(3);
  l_TemPacSTR VARCHAR(3);
  l_GraConSTR VARCHAR(3);
  l_TolIntSTR VARCHAR(3);
  l_prmSTR    VARCHAR(5);
  l_UsaBioSTR VARCHAR(1);
  l_TolAcpSTR VARCHAR2(255);
  l_horatu    NUMBER(5);
  l_CodPltSTR VARCHAR2(5);
  l_CodPlt    NUMBER(5);
  l_CodRlgSTR VARCHAR(5);
  l_CodRlg    NUMBER(5);
  l_VerPlfSTR VARCHAR(3);
  l_VerPlf    NUMBER(3);
  l_CodPlfSTR VARCHAR(7);
  l_CodPlf    NUMBER(7);
  l_CodDspSTR VARCHAR(9);
  l_DiaSemSTR VARCHAR(1);
  l_IniFaiSTR VARCHAR(5);
  l_FimFaiSTR VARCHAR(5);
  l_codusu    NUMBER(9);
  l_EstPosSTR VARCHAR(3); 

  CURSOR c_r038HPO IS
    SELECT R038HPO.NUMEMP, R038HPO.TIPCOL, R038HPO.NUMCAD, R017TAP.HISPRI, R038HPO.INIATU, R038HPO.TERATU FROM R038HPO, R017TAP
      WHERE R038HPO.CODTAP = R017TAP.CODTAP AND ESTPOS = p_estpos AND POSTRA = p_postra
        AND R038HPO.INIATU <= l_datatu AND R038HPO.TERATU >= l_datatu;
  TYPE t_r038HPO IS RECORD(
    NUMEMP   R038HPO.NUMEMP%TYPE,
    TIPCOL   R038HPO.TIPCOL%TYPE,
    NUMCAD   R038HPO.NUMCAD%TYPE,
    HISPRI   R017TAP.HISPRI%TYPE,
    INIATU   R038HPO.INIATU%TYPE,
    TERATU   R038HPO.TERATU%TYPE);
  l_r038HPO t_r038HPO;

  /* CURSOR QUE OBTEM AS FAIXAS DE ACESSO DA PERMISSAO POR POSTO DE TRABALHO */
  CURSOR c_r017FAP IS
    SELECT CODPLT, CODRLG, CODDSP, VERPLF, CODPLF, INIFAI, FIMFAI, DIASEM
    FROM R017FAP WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;
    TYPE t_r017FAP IS RECORD(
    CODPLT   R017FAP.CODPLT%TYPE,
    CODRLG   R017FAP.CODRLG%TYPE,
    CODDSP   R017FAP.CODDSP%TYPE,
    VERPLF   R017FAP.VERPLF%TYPE,
    CODPLF   R017FAP.CODPLF%TYPE,
    INIFAI   R017FAP.INIFAI%TYPE,
    FIMFAI   R017FAP.FIMFAI%TYPE,
    DIASEM   R017FAP.DIASEM%TYPE);
  l_r017FAP t_r017FAP;
BEGIN
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  l_temAud34PRM := 0;
  BEGIN
      SELECT COUNT(*) INTO l_temAud34PRM FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 101;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao realizar o SELECT na tabela R995CTE.';
  END;

  l_temAud34FAP := 0;
  BEGIN
      SELECT COUNT(*) INTO l_temAud34FAP FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 102;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao realizar o SELECT na tabela R995CTE.';
  END;

  l_codRPA := 0;

  l_numempSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMEMP);
  l_numempSTR := LTRIM(l_numempSTR);
  l_numempSTR := RTRIM(l_numempSTR);

  l_tipcolSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.TIPCOL);
  l_tipcolSTR := LTRIM(l_tipcolSTR);
  l_tipcolSTR := RTRIM(l_tipcolSTR);

  l_numcadSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMCAD);
  l_numcadSTR := LTRIM(l_numcadSTR);
  l_numcadSTR := RTRIM(l_numcadSTR);

  l_EstPosSTR := CONVERT(NUMBER_TO_CHAR,p_estpos);
  l_EstPosSTR := LTRIM(l_EstPosSTR);
  l_EstPosSTR := RTRIM(l_EstPosSTR);

  /* BUSCO TODOS OS COLABORADORES QUE POSSUEM ESTE POSTO DE TRABALHO VIGENTE NA DATA ATUAL */
  FOREACH c_r038HPO INTO l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_r038HPO.HISPRI, l_r038HPO.INIATU, l_r038HPO.TERATU
  LOOP    
    IF (l_r038HPO.HISPRI = 'S') THEN
      l_oridef := 1; /* HISTORICO PRINCIPAL */
    ELSE
      l_oridef := 2; /* HISTORICO ADICIONAL */
    END IF;

    SELECT CODUSU INTO l_codusu FROM R038HPO WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND NUMEMP = l_r038HPO.NUMEMP AND TIPCOL = l_r038HPO.TIPCOL AND NUMCAD = l_r038HPO.NUMCAD AND INIATU = l_r038HPO.INIATU AND TERATU = l_r038HPO.TERATU;

    SP_RETIDTPES(l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, NULL, NULL, NULL, NULL, l_idtcol OUT);

    /* -- ATRIBUICAO DE PERMISSOES POR LOCAL FISICO/DISPOSITIVO POR POSTO -- */
    /* VERIFICO SE ESTE DISPOSITIVO JA ESTA ASSOCIADO AO COLABORADOR */

    IF (p_tipope = 'I') THEN
      BEGIN
        SELECT COUNT(1) INTO l_count FROM R034PRM WHERE IDTPES = l_idtcol AND CODDSP = p_coddsp;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_count := 0;
          WHEN OTHERS THEN
            RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034PRM.';
      END;

      /* INSERE REGISTRO NA TABELA R034PRM. */
      IF (l_count = 0) THEN
        BEGIN
          IF (l_temAud34PRM > 0) THEN
			SP_RET_REG_AUD(l_codRPA OUT);

            INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                              VALUES (l_codRPA, 3, 6, 1, 101, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

            /*Campos chave da alteração*/
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

            SELECT CODPLT, CODRLG, VERPLF, CODPLF INTO l_codplt, l_codrlg, l_verplf, l_codplf FROM R017PRM WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;

            /*Campos detalhe da alteração*/
            l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_codplt);
            l_CodPltSTR := LTRIM(l_CodPltSTR);
            l_CodPltSTR := RTRIM(l_CodPltSTR);

            l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_codrlg);
            l_CodRlgSTR := LTRIM(l_CodRlgSTR);
            l_CodRlgSTR := RTRIM(l_CodRlgSTR);

            l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_verplf);
            l_VerPlfSTR := LTRIM(l_VerPlfSTR);
            l_VerPlfSTR := RTRIM(l_VerPlfSTR);

            l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_codplf);
            l_CodPlfSTR := LTRIM(l_CodPlfSTR);
            l_CodPlfSTR := RTRIM(l_CodPlfSTR);

            l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, p_coddsp);
            l_CodDspSTR := LTRIM(l_CodDspSTR);
            l_CodDspSTR := RTRIM(l_CodDspSTR);

            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'INCLUSÃO');
          END IF;  
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de inclusão. (R034PRM).';
        END;
      END IF;
    ELSE
        BEGIN
          IF (l_temAud34PRM > 0) THEN
                SP_RET_REG_AUD(l_codRPA OUT);

                INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                                  VALUES (l_codRPA, 3, 6, 1, 101, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

                /*Campos chave da alteração*/
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

                SELECT CODPLT, CODRLG, VERPLF, CODPLF INTO l_codplt, l_codrlg, l_verplf, l_codplf FROM R017PRM WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;

                /*Campos detalhe da alteração*/
                l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_codplt);
                l_CodPltSTR := LTRIM(l_CodPltSTR);
                l_CodPltSTR := RTRIM(l_CodPltSTR);

                l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_codrlg);
                l_CodRlgSTR := LTRIM(l_CodRlgSTR);
                l_CodRlgSTR := RTRIM(l_CodRlgSTR);

                l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_verplf);
                l_VerPlfSTR := LTRIM(l_VerPlfSTR);
                l_VerPlfSTR := RTRIM(l_VerPlfSTR);

                l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_codplf);
                l_CodPlfSTR := LTRIM(l_CodPlfSTR);
                l_CodPlfSTR := RTRIM(l_CodPlfSTR);

                l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, p_coddsp);
                l_CodDspSTR := LTRIM(l_CodDspSTR);
                l_CodDspSTR := RTRIM(l_CodDspSTR);

                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'EXCLUSÃO');
            END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de exclusão. (R034PRM).';
        END;
    END IF;

    /* BUSCO POR FAIXA */
    FOREACH c_r017FAP INTO l_r017FAP.CODPLT, l_r017FAP.CODRLG, l_r017FAP.CODDSP, l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.INIFAI, l_r017FAP.FIMFAI, l_r017FAP.DIASEM
    LOOP
      /* VERIFICO SE ESTA FAIXA JA ESTA ASSOCIADA AO COLABORADOR */
      IF (p_tipope = 'I') THEN
        BEGIN
          SELECT COUNT(1) INTO l_count FROM R034FAP WHERE IDTPES = l_idtcol AND CODPLT = l_r017FAP.CODPLT AND CODRLG = l_r017FAP.CODRLG AND VERPLF = l_r017FAP.VERPLF
            AND CODPLF = l_r017FAP.CODPLF AND INIFAI = l_r017FAP.INIFAI AND DIASEM = l_r017FAP.DIASEM AND CODDSP = l_r017FAP.CODDSP;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              l_count := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034FAP.';
        END;

        /* INSERE REGISTRO NA TABELA R034FAP. */
        IF (l_count = 0) THEN
          BEGIN
            IF (l_temAud34FAP > 0) THEN


			SP_RET_REG_AUD(l_codRPA OUT);
            /*Registro mestre do log*/
            INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                              VALUES (l_codRPA, 3, 6, 1, 102, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

            /*Campos chave da alteração*/
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

            /*Campos detalhe da alteração*/
            l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLT);
            l_CodPltSTR := LTRIM(l_CodPltSTR);
            l_CodPltSTR := RTRIM(l_CodPltSTR);

            l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODRLG);
            l_CodRlgSTR := LTRIM(l_CodRlgSTR);
            l_CodRlgSTR := RTRIM(l_CodRlgSTR);

            l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.VERPLF);
            l_VerPlfSTR := LTRIM(l_VerPlfSTR);
            l_VerPlfSTR := RTRIM(l_VerPlfSTR);

            l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLF);
            l_CodPlfSTR := LTRIM(l_CodPlfSTR);
            l_CodPlfSTR := RTRIM(l_CodPlfSTR);

            l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODDSP);
            l_CodDspSTR := LTRIM(l_CodDspSTR);
            l_CodDspSTR := RTRIM(l_CodDspSTR);

            l_DiaSemSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.DIASEM);
            l_DiaSemSTR := LTRIM(l_DiaSemSTR);
            l_DiaSemSTR := RTRIM(l_DiaSemSTR);

            SP_INTSTR(l_r017FAP.INIFAI,'HH:MM', l_IniFaiSTR OUT);

            SP_INTSTR(l_r017FAP.FIMFAI,'HH:MM', l_FimFaiSTR OUT);

            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIASEM', l_DiaSemSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIFAI', l_IniFaiSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMFAI', l_FimFaiSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'INCLUSÃO');
          END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de inclusão. (R034FAP).';
          END;
        END IF;
      ELSE
        BEGIN
          IF (l_temAud34FAP > 0) THEN
				SP_RET_REG_AUD(l_codRPA OUT);
                /*Registro mestre do log*/
                INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                                  VALUES (l_codRPA, 3, 6, 1, 102, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

                /*Campos chave da alteração*/
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

                /*Campos detalhe da alteração*/
                l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLT);
                l_CodPltSTR := LTRIM(l_CodPltSTR);
                l_CodPltSTR := RTRIM(l_CodPltSTR);

                l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODRLG);
                l_CodRlgSTR := LTRIM(l_CodRlgSTR);
                l_CodRlgSTR := RTRIM(l_CodRlgSTR);

                l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.VERPLF);
                l_VerPlfSTR := LTRIM(l_VerPlfSTR);
                l_VerPlfSTR := RTRIM(l_VerPlfSTR);

                l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLF);
                l_CodPlfSTR := LTRIM(l_CodPlfSTR);
                l_CodPlfSTR := RTRIM(l_CodPlfSTR);

                l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODDSP);
                l_CodDspSTR := LTRIM(l_CodDspSTR);
                l_CodDspSTR := RTRIM(l_CodDspSTR);

                l_DiaSemSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.DIASEM);
                l_DiaSemSTR := LTRIM(l_DiaSemSTR);
                l_DiaSemSTR := RTRIM(l_DiaSemSTR);

                SP_INTSTR(l_r017FAP.INIFAI,'HH:MM', l_IniFaiSTR OUT);

                SP_INTSTR(l_r017FAP.FIMFAI,'HH:MM', l_FimFaiSTR OUT);

                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIASEM', l_DiaSemSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIFAI', l_IniFaiSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMFAI', l_FimFaiSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'EXCLUSÃO');
            END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de exclusão. (R034FAP).';
        END;
      END IF;
    END LOOP;
  END LOOP; /* FOREACH c_r038HPO */
END		SENIOR;22)SP_RETIDTPES
SP_INTSTR
SP_RET_REG_AUD
¯H␀␀


PROCEDURE SP_GERLOGPER(P_TIPOPE CHAR(1),P_ESTPOS NUMBER(3),P_POSTRA VARCHAR2(25),P_CODDSP NUMBER(9))
 IS

l_datatu DATE;
  l_idtcol    CHAR(23);
  l_count     NUMBER(5);
  l_oridef    NUMBER(1);
  l_codRPA    NUMBER(15);
  l_temAud34PRM NUMBER(2);
  l_temAud34FAP NUMBER(2);  
  l_numempSTR VARCHAR2(255);
  l_tipcolSTR VARCHAR2(255);
  l_numcadSTR VARCHAR2(255);
  l_ConCreSTR VARCHAR(1);
  l_ConFaiSTR VARCHAR(1);
  l_TemAlmSTR VARCHAR(3);
  l_TemPacSTR VARCHAR(3);
  l_GraConSTR VARCHAR(3);
  l_TolIntSTR VARCHAR(3);
  l_prmSTR    VARCHAR(5);
  l_UsaBioSTR VARCHAR(1);
  l_TolAcpSTR VARCHAR2(255);
  l_horatu    NUMBER(5);
  l_CodPltSTR VARCHAR2(5);
  l_CodPlt    NUMBER(5);
  l_CodRlgSTR VARCHAR(5);
  l_CodRlg    NUMBER(5);
  l_VerPlfSTR VARCHAR(3);
  l_VerPlf    NUMBER(3);
  l_CodPlfSTR VARCHAR(7);
  l_CodPlf    NUMBER(7);
  l_CodDspSTR VARCHAR(9);
  l_DiaSemSTR VARCHAR(1);
  l_IniFaiSTR VARCHAR(5);
  l_FimFaiSTR VARCHAR(5);
  l_codusu    NUMBER(9);
  l_EstPosSTR VARCHAR(3); 

  CURSOR c_r038HPO IS
    SELECT R038HPO.NUMEMP, R038HPO.TIPCOL, R038HPO.NUMCAD, R017TAP.HISPRI, R038HPO.INIATU, R038HPO.TERATU FROM R038HPO, R017TAP
      WHERE R038HPO.CODTAP = R017TAP.CODTAP AND ESTPOS = p_estpos AND POSTRA = p_postra
        AND R038HPO.INIATU <= l_datatu AND R038HPO.TERATU >= l_datatu;
  TYPE t_r038HPO IS RECORD(
    NUMEMP   R038HPO.NUMEMP%TYPE,
    TIPCOL   R038HPO.TIPCOL%TYPE,
    NUMCAD   R038HPO.NUMCAD%TYPE,
    HISPRI   R017TAP.HISPRI%TYPE,
    INIATU   R038HPO.INIATU%TYPE,
    TERATU   R038HPO.TERATU%TYPE);
  l_r038HPO t_r038HPO;

  /* CURSOR QUE OBTEM AS FAIXAS DE ACESSO DA PERMISSAO POR POSTO DE TRABALHO */
  CURSOR c_r017FAP IS
    SELECT CODPLT, CODRLG, CODDSP, VERPLF, CODPLF, INIFAI, FIMFAI, DIASEM
    FROM R017FAP WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;
    TYPE t_r017FAP IS RECORD(
    CODPLT   R017FAP.CODPLT%TYPE,
    CODRLG   R017FAP.CODRLG%TYPE,
    CODDSP   R017FAP.CODDSP%TYPE,
    VERPLF   R017FAP.VERPLF%TYPE,
    CODPLF   R017FAP.CODPLF%TYPE,
    INIFAI   R017FAP.INIFAI%TYPE,
    FIMFAI   R017FAP.FIMFAI%TYPE,
    DIASEM   R017FAP.DIASEM%TYPE);
  l_r017FAP t_r017FAP;
BEGIN
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  l_temAud34PRM := 0;
  BEGIN
      SELECT COUNT(*) INTO l_temAud34PRM FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 101;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao realizar o SELECT na tabela R995CTE.';
  END;

  l_temAud34FAP := 0;
  BEGIN
      SELECT COUNT(*) INTO l_temAud34FAP FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 102;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao realizar o SELECT na tabela R995CTE.';
  END;

  l_codRPA := 0;

  l_numempSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMEMP);
  l_numempSTR := LTRIM(l_numempSTR);
  l_numempSTR := RTRIM(l_numempSTR);

  l_tipcolSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.TIPCOL);
  l_tipcolSTR := LTRIM(l_tipcolSTR);
  l_tipcolSTR := RTRIM(l_tipcolSTR);

  l_numcadSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMCAD);
  l_numcadSTR := LTRIM(l_numcadSTR);
  l_numcadSTR := RTRIM(l_numcadSTR);

  l_EstPosSTR := CONVERT(NUMBER_TO_CHAR,p_estpos);
  l_EstPosSTR := LTRIM(l_EstPosSTR);
  l_EstPosSTR := RTRIM(l_EstPosSTR);

  /* BUSCO TODOS OS COLABORADORES QUE POSSUEM ESTE POSTO DE TRABALHO VIGENTE NA DATA ATUAL */
  FOREACH c_r038HPO INTO l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_r038HPO.HISPRI, l_r038HPO.INIATU, l_r038HPO.TERATU
  LOOP    
    IF (l_r038HPO.HISPRI = 'S') THEN
      l_oridef := 1; /* HISTORICO PRINCIPAL */
    ELSE
      l_oridef := 2; /* HISTORICO ADICIONAL */
    END IF;

    SELECT CODUSU INTO l_codusu FROM R038HPO WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND NUMEMP = l_r038HPO.NUMEMP AND TIPCOL = l_r038HPO.TIPCOL AND NUMCAD = l_r038HPO.NUMCAD AND INIATU = l_r038HPO.INIATU AND TERATU = l_r038HPO.TERATU;

    SP_RETIDTPES(l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, NULL, NULL, NULL, NULL, l_idtcol OUT);

    /* -- ATRIBUICAO DE PERMISSOES POR LOCAL FISICO/DISPOSITIVO POR POSTO -- */
    /* VERIFICO SE ESTE DISPOSITIVO JA ESTA ASSOCIADO AO COLABORADOR */

    IF (p_tipope = 'I') THEN
      BEGIN
        SELECT COUNT(1) INTO l_count FROM R034PRM WHERE IDTPES = l_idtcol AND CODDSP = p_coddsp;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_count := 0;
          WHEN OTHERS THEN
            RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034PRM.';
      END;

      /* INSERE REGISTRO NA TABELA R034PRM. */
      IF (l_count = 0) THEN
        BEGIN
          IF (l_temAud34PRM > 0) THEN
			SP_RET_REG_AUD(l_codRPA OUT);

            INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                              VALUES (l_codRPA, 3, 6, 1, 101, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

            /*Campos chave da alteração*/
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

            SELECT CODPLT, CODRLG, VERPLF, CODPLF INTO l_codplt, l_codrlg, l_verplf, l_codplf FROM R017PRM WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;

            /*Campos detalhe da alteração*/
            l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_codplt);
            l_CodPltSTR := LTRIM(l_CodPltSTR);
            l_CodPltSTR := RTRIM(l_CodPltSTR);

            l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_codrlg);
            l_CodRlgSTR := LTRIM(l_CodRlgSTR);
            l_CodRlgSTR := RTRIM(l_CodRlgSTR);

            l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_verplf);
            l_VerPlfSTR := LTRIM(l_VerPlfSTR);
            l_VerPlfSTR := RTRIM(l_VerPlfSTR);

            l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_codplf);
            l_CodPlfSTR := LTRIM(l_CodPlfSTR);
            l_CodPlfSTR := RTRIM(l_CodPlfSTR);

            l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, p_coddsp);
            l_CodDspSTR := LTRIM(l_CodDspSTR);
            l_CodDspSTR := RTRIM(l_CodDspSTR);

            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'INCLUSÃO');
          END IF;  
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de inclusão. (R034PRM).';
        END;
      END IF;
    ELSE
        BEGIN
          IF (l_temAud34PRM > 0) THEN
                SP_RET_REG_AUD(l_codRPA OUT);

                INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                                  VALUES (l_codRPA, 3, 6, 1, 101, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

                /*Campos chave da alteração*/
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

                SELECT CODPLT, CODRLG, VERPLF, CODPLF INTO l_codplt, l_codrlg, l_verplf, l_codplf FROM R017PRM WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;

                /*Campos detalhe da alteração*/
                l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_codplt);
                l_CodPltSTR := LTRIM(l_CodPltSTR);
                l_CodPltSTR := RTRIM(l_CodPltSTR);

                l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_codrlg);
                l_CodRlgSTR := LTRIM(l_CodRlgSTR);
                l_CodRlgSTR := RTRIM(l_CodRlgSTR);

                l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_verplf);
                l_VerPlfSTR := LTRIM(l_VerPlfSTR);
                l_VerPlfSTR := RTRIM(l_VerPlfSTR);

                l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_codplf);
                l_CodPlfSTR := LTRIM(l_CodPlfSTR);
                l_CodPlfSTR := RTRIM(l_CodPlfSTR);

                l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, p_coddsp);
                l_CodDspSTR := LTRIM(l_CodDspSTR);
                l_CodDspSTR := RTRIM(l_CodDspSTR);

                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'EXCLUSÃO');
            END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de exclusão. (R034PRM).';
        END;
    END IF;

    /* BUSCO POR FAIXA */
    FOREACH c_r017FAP INTO l_r017FAP.CODPLT, l_r017FAP.CODRLG, l_r017FAP.CODDSP, l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.INIFAI, l_r017FAP.FIMFAI, l_r017FAP.DIASEM
    LOOP
      /* VERIFICO SE ESTA FAIXA JA ESTA ASSOCIADA AO COLABORADOR */
      IF (p_tipope = 'I') THEN
        BEGIN
          SELECT COUNT(1) INTO l_count FROM R034FAP WHERE IDTPES = l_idtcol AND CODPLT = l_r017FAP.CODPLT AND CODRLG = l_r017FAP.CODRLG AND VERPLF = l_r017FAP.VERPLF
            AND CODPLF = l_r017FAP.CODPLF AND INIFAI = l_r017FAP.INIFAI AND DIASEM = l_r017FAP.DIASEM AND CODDSP = l_r017FAP.CODDSP;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              l_count := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034FAP.';
        END;

        /* INSERE REGISTRO NA TABELA R034FAP. */
        IF (l_count = 0) THEN
          BEGIN
            IF (l_temAud34FAP > 0) THEN


			SP_RET_REG_AUD(l_codRPA OUT);
            /*Registro mestre do log*/
            INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                              VALUES (l_codRPA, 3, 6, 1, 102, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

            /*Campos chave da alteração*/
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

            /*Campos detalhe da alteração*/
            l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLT);
            l_CodPltSTR := LTRIM(l_CodPltSTR);
            l_CodPltSTR := RTRIM(l_CodPltSTR);

            l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODRLG);
            l_CodRlgSTR := LTRIM(l_CodRlgSTR);
            l_CodRlgSTR := RTRIM(l_CodRlgSTR);

            l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.VERPLF);
            l_VerPlfSTR := LTRIM(l_VerPlfSTR);
            l_VerPlfSTR := RTRIM(l_VerPlfSTR);

            l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLF);
            l_CodPlfSTR := LTRIM(l_CodPlfSTR);
            l_CodPlfSTR := RTRIM(l_CodPlfSTR);

            l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODDSP);
            l_CodDspSTR := LTRIM(l_CodDspSTR);
            l_CodDspSTR := RTRIM(l_CodDspSTR);

            l_DiaSemSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.DIASEM);
            l_DiaSemSTR := LTRIM(l_DiaSemSTR);
            l_DiaSemSTR := RTRIM(l_DiaSemSTR);

            SP_INTSTR(l_r017FAP.INIFAI,'HH:MM', l_IniFaiSTR OUT);

            SP_INTSTR(l_r017FAP.FIMFAI,'HH:MM', l_FimFaiSTR OUT);

            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIASEM', l_DiaSemSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIFAI', l_IniFaiSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMFAI', l_FimFaiSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'INCLUSÃO');
          END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de inclusão. (R034FAP).';
          END;
        END IF;
      ELSE
        BEGIN
          IF (l_temAud34FAP > 0) THEN
				SP_RET_REG_AUD(l_codRPA OUT);
                /*Registro mestre do log*/
                INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                                  VALUES (l_codRPA, 3, 6, 1, 102, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

                /*Campos chave da alteração*/
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

                /*Campos detalhe da alteração*/
                l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLT);
                l_CodPltSTR := LTRIM(l_CodPltSTR);
                l_CodPltSTR := RTRIM(l_CodPltSTR);

                l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODRLG);
                l_CodRlgSTR := LTRIM(l_CodRlgSTR);
                l_CodRlgSTR := RTRIM(l_CodRlgSTR);

                l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.VERPLF);
                l_VerPlfSTR := LTRIM(l_VerPlfSTR);
                l_VerPlfSTR := RTRIM(l_VerPlfSTR);

                l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLF);
                l_CodPlfSTR := LTRIM(l_CodPlfSTR);
                l_CodPlfSTR := RTRIM(l_CodPlfSTR);

                l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODDSP);
                l_CodDspSTR := LTRIM(l_CodDspSTR);
                l_CodDspSTR := RTRIM(l_CodDspSTR);

                l_DiaSemSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.DIASEM);
                l_DiaSemSTR := LTRIM(l_DiaSemSTR);
                l_DiaSemSTR := RTRIM(l_DiaSemSTR);

                SP_INTSTR(l_r017FAP.INIFAI,'HH:MM', l_IniFaiSTR OUT);

                SP_INTSTR(l_r017FAP.FIMFAI,'HH:MM', l_FimFaiSTR OUT);

                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIASEM', l_DiaSemSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIFAI', l_IniFaiSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMFAI', l_FimFaiSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'EXCLUSÃO');
            END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de exclusão. (R034FAP).';
        END;
      END IF;
    END LOOP;
  END LOOP; /* FOREACH c_r038HPO */
END		SENIOR;23)SP_RETIDTPES
SP_INTSTR
SP_RET_REG_AUD
¯H␀␀


PROCEDURE SP_GERLOGPER(P_TIPOPE CHAR(1),P_ESTPOS NUMBER(3),P_POSTRA VARCHAR2(25),P_CODDSP NUMBER(9))
 IS

l_datatu DATE;
  l_idtcol    CHAR(23);
  l_count     NUMBER(5);
  l_oridef    NUMBER(1);
  l_codRPA    NUMBER(15);
  l_temAud34PRM NUMBER(2);
  l_temAud34FAP NUMBER(2);  
  l_numempSTR VARCHAR2(255);
  l_tipcolSTR VARCHAR2(255);
  l_numcadSTR VARCHAR2(255);
  l_ConCreSTR VARCHAR(1);
  l_ConFaiSTR VARCHAR(1);
  l_TemAlmSTR VARCHAR(3);
  l_TemPacSTR VARCHAR(3);
  l_GraConSTR VARCHAR(3);
  l_TolIntSTR VARCHAR(3);
  l_prmSTR    VARCHAR(5);
  l_UsaBioSTR VARCHAR(1);
  l_TolAcpSTR VARCHAR2(255);
  l_horatu    NUMBER(5);
  l_CodPltSTR VARCHAR2(5);
  l_CodPlt    NUMBER(5);
  l_CodRlgSTR VARCHAR(5);
  l_CodRlg    NUMBER(5);
  l_VerPlfSTR VARCHAR(3);
  l_VerPlf    NUMBER(3);
  l_CodPlfSTR VARCHAR(7);
  l_CodPlf    NUMBER(7);
  l_CodDspSTR VARCHAR(9);
  l_DiaSemSTR VARCHAR(1);
  l_IniFaiSTR VARCHAR(5);
  l_FimFaiSTR VARCHAR(5);
  l_codusu    NUMBER(9);
  l_EstPosSTR VARCHAR(3); 

  CURSOR c_r038HPO IS
    SELECT R038HPO.NUMEMP, R038HPO.TIPCOL, R038HPO.NUMCAD, R017TAP.HISPRI, R038HPO.INIATU, R038HPO.TERATU FROM R038HPO, R017TAP
      WHERE R038HPO.CODTAP = R017TAP.CODTAP AND ESTPOS = p_estpos AND POSTRA = p_postra
        AND R038HPO.INIATU <= l_datatu AND R038HPO.TERATU >= l_datatu;
  TYPE t_r038HPO IS RECORD(
    NUMEMP   R038HPO.NUMEMP%TYPE,
    TIPCOL   R038HPO.TIPCOL%TYPE,
    NUMCAD   R038HPO.NUMCAD%TYPE,
    HISPRI   R017TAP.HISPRI%TYPE,
    INIATU   R038HPO.INIATU%TYPE,
    TERATU   R038HPO.TERATU%TYPE);
  l_r038HPO t_r038HPO;

  /* CURSOR QUE OBTEM AS FAIXAS DE ACESSO DA PERMISSAO POR POSTO DE TRABALHO */
  CURSOR c_r017FAP IS
    SELECT CODPLT, CODRLG, CODDSP, VERPLF, CODPLF, INIFAI, FIMFAI, DIASEM
    FROM R017FAP WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;
    TYPE t_r017FAP IS RECORD(
    CODPLT   R017FAP.CODPLT%TYPE,
    CODRLG   R017FAP.CODRLG%TYPE,
    CODDSP   R017FAP.CODDSP%TYPE,
    VERPLF   R017FAP.VERPLF%TYPE,
    CODPLF   R017FAP.CODPLF%TYPE,
    INIFAI   R017FAP.INIFAI%TYPE,
    FIMFAI   R017FAP.FIMFAI%TYPE,
    DIASEM   R017FAP.DIASEM%TYPE);
  l_r017FAP t_r017FAP;
BEGIN
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  l_temAud34PRM := 0;
  BEGIN
      SELECT COUNT(*) INTO l_temAud34PRM FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 101;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao realizar o SELECT na tabela R995CTE.';
  END;

  l_temAud34FAP := 0;
  BEGIN
      SELECT COUNT(*) INTO l_temAud34FAP FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 102;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao realizar o SELECT na tabela R995CTE.';
  END;

  l_codRPA := 0;

  l_numempSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMEMP);
  l_numempSTR := LTRIM(l_numempSTR);
  l_numempSTR := RTRIM(l_numempSTR);

  l_tipcolSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.TIPCOL);
  l_tipcolSTR := LTRIM(l_tipcolSTR);
  l_tipcolSTR := RTRIM(l_tipcolSTR);

  l_numcadSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMCAD);
  l_numcadSTR := LTRIM(l_numcadSTR);
  l_numcadSTR := RTRIM(l_numcadSTR);

  l_EstPosSTR := CONVERT(NUMBER_TO_CHAR,p_estpos);
  l_EstPosSTR := LTRIM(l_EstPosSTR);
  l_EstPosSTR := RTRIM(l_EstPosSTR);

  /* BUSCO TODOS OS COLABORADORES QUE POSSUEM ESTE POSTO DE TRABALHO VIGENTE NA DATA ATUAL */
  FOREACH c_r038HPO INTO l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_r038HPO.HISPRI, l_r038HPO.INIATU, l_r038HPO.TERATU
  LOOP    
    IF (l_r038HPO.HISPRI = 'S') THEN
      l_oridef := 1; /* HISTORICO PRINCIPAL */
    ELSE
      l_oridef := 2; /* HISTORICO ADICIONAL */
    END IF;

    SELECT CODUSU INTO l_codusu FROM R038HPO WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND NUMEMP = l_r038HPO.NUMEMP AND TIPCOL = l_r038HPO.TIPCOL AND NUMCAD = l_r038HPO.NUMCAD AND INIATU = l_r038HPO.INIATU AND TERATU = l_r038HPO.TERATU;

    SP_RETIDTPES(l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, NULL, NULL, NULL, NULL, l_idtcol OUT);

    /* -- ATRIBUICAO DE PERMISSOES POR LOCAL FISICO/DISPOSITIVO POR POSTO -- */
    /* VERIFICO SE ESTE DISPOSITIVO JA ESTA ASSOCIADO AO COLABORADOR */

    IF (p_tipope = 'I') THEN
      BEGIN
        SELECT COUNT(1) INTO l_count FROM R034PRM WHERE IDTPES = l_idtcol AND CODDSP = p_coddsp;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_count := 0;
          WHEN OTHERS THEN
            RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034PRM.';
      END;

      /* INSERE REGISTRO NA TABELA R034PRM. */
      IF (l_count = 0) THEN
        BEGIN
          IF (l_temAud34PRM > 0) THEN
			SP_RET_REG_AUD(l_codRPA OUT);

            INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                              VALUES (l_codRPA, 3, 6, 1, 101, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

            /*Campos chave da alteração*/
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

            SELECT CODPLT, CODRLG, VERPLF, CODPLF INTO l_codplt, l_codrlg, l_verplf, l_codplf FROM R017PRM WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;

            /*Campos detalhe da alteração*/
            l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_codplt);
            l_CodPltSTR := LTRIM(l_CodPltSTR);
            l_CodPltSTR := RTRIM(l_CodPltSTR);

            l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_codrlg);
            l_CodRlgSTR := LTRIM(l_CodRlgSTR);
            l_CodRlgSTR := RTRIM(l_CodRlgSTR);

            l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_verplf);
            l_VerPlfSTR := LTRIM(l_VerPlfSTR);
            l_VerPlfSTR := RTRIM(l_VerPlfSTR);

            l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_codplf);
            l_CodPlfSTR := LTRIM(l_CodPlfSTR);
            l_CodPlfSTR := RTRIM(l_CodPlfSTR);

            l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, p_coddsp);
            l_CodDspSTR := LTRIM(l_CodDspSTR);
            l_CodDspSTR := RTRIM(l_CodDspSTR);

            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'INCLUSÃO');
          END IF;  
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de inclusão. (R034PRM).';
        END;
      END IF;
    ELSE
        BEGIN
          IF (l_temAud34PRM > 0) THEN
                SP_RET_REG_AUD(l_codRPA OUT);

                INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                                  VALUES (l_codRPA, 3, 6, 1, 101, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

                /*Campos chave da alteração*/
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

                SELECT CODPLT, CODRLG, VERPLF, CODPLF INTO l_codplt, l_codrlg, l_verplf, l_codplf FROM R017PRM WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;

                /*Campos detalhe da alteração*/
                l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_codplt);
                l_CodPltSTR := LTRIM(l_CodPltSTR);
                l_CodPltSTR := RTRIM(l_CodPltSTR);

                l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_codrlg);
                l_CodRlgSTR := LTRIM(l_CodRlgSTR);
                l_CodRlgSTR := RTRIM(l_CodRlgSTR);

                l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_verplf);
                l_VerPlfSTR := LTRIM(l_VerPlfSTR);
                l_VerPlfSTR := RTRIM(l_VerPlfSTR);

                l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_codplf);
                l_CodPlfSTR := LTRIM(l_CodPlfSTR);
                l_CodPlfSTR := RTRIM(l_CodPlfSTR);

                l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, p_coddsp);
                l_CodDspSTR := LTRIM(l_CodDspSTR);
                l_CodDspSTR := RTRIM(l_CodDspSTR);

                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'EXCLUSÃO');
            END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de exclusão. (R034PRM).';
        END;
    END IF;

    /* BUSCO POR FAIXA */
    FOREACH c_r017FAP INTO l_r017FAP.CODPLT, l_r017FAP.CODRLG, l_r017FAP.CODDSP, l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.INIFAI, l_r017FAP.FIMFAI, l_r017FAP.DIASEM
    LOOP
      /* VERIFICO SE ESTA FAIXA JA ESTA ASSOCIADA AO COLABORADOR */
      IF (p_tipope = 'I') THEN
        BEGIN
          SELECT COUNT(1) INTO l_count FROM R034FAP WHERE IDTPES = l_idtcol AND CODPLT = l_r017FAP.CODPLT AND CODRLG = l_r017FAP.CODRLG AND VERPLF = l_r017FAP.VERPLF
            AND CODPLF = l_r017FAP.CODPLF AND INIFAI = l_r017FAP.INIFAI AND DIASEM = l_r017FAP.DIASEM AND CODDSP = l_r017FAP.CODDSP;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              l_count := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034FAP.';
        END;

        /* INSERE REGISTRO NA TABELA R034FAP. */
        IF (l_count = 0) THEN
          BEGIN
            IF (l_temAud34FAP > 0) THEN


			SP_RET_REG_AUD(l_codRPA OUT);
            /*Registro mestre do log*/
            INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                              VALUES (l_codRPA, 3, 6, 1, 102, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

            /*Campos chave da alteração*/
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

            /*Campos detalhe da alteração*/
            l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLT);
            l_CodPltSTR := LTRIM(l_CodPltSTR);
            l_CodPltSTR := RTRIM(l_CodPltSTR);

            l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODRLG);
            l_CodRlgSTR := LTRIM(l_CodRlgSTR);
            l_CodRlgSTR := RTRIM(l_CodRlgSTR);

            l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.VERPLF);
            l_VerPlfSTR := LTRIM(l_VerPlfSTR);
            l_VerPlfSTR := RTRIM(l_VerPlfSTR);

            l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLF);
            l_CodPlfSTR := LTRIM(l_CodPlfSTR);
            l_CodPlfSTR := RTRIM(l_CodPlfSTR);

            l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODDSP);
            l_CodDspSTR := LTRIM(l_CodDspSTR);
            l_CodDspSTR := RTRIM(l_CodDspSTR);

            l_DiaSemSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.DIASEM);
            l_DiaSemSTR := LTRIM(l_DiaSemSTR);
            l_DiaSemSTR := RTRIM(l_DiaSemSTR);

            SP_INTSTR(l_r017FAP.INIFAI,'HH:MM', l_IniFaiSTR OUT);

            SP_INTSTR(l_r017FAP.FIMFAI,'HH:MM', l_FimFaiSTR OUT);

            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIASEM', l_DiaSemSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIFAI', l_IniFaiSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMFAI', l_FimFaiSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'INCLUSÃO');
          END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de inclusão. (R034FAP).';
          END;
        END IF;
      ELSE
        BEGIN
          IF (l_temAud34FAP > 0) THEN
				SP_RET_REG_AUD(l_codRPA OUT);
                /*Registro mestre do log*/
                INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                                  VALUES (l_codRPA, 3, 6, 1, 102, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

                /*Campos chave da alteração*/
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

                /*Campos detalhe da alteração*/
                l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLT);
                l_CodPltSTR := LTRIM(l_CodPltSTR);
                l_CodPltSTR := RTRIM(l_CodPltSTR);

                l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODRLG);
                l_CodRlgSTR := LTRIM(l_CodRlgSTR);
                l_CodRlgSTR := RTRIM(l_CodRlgSTR);

                l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.VERPLF);
                l_VerPlfSTR := LTRIM(l_VerPlfSTR);
                l_VerPlfSTR := RTRIM(l_VerPlfSTR);

                l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLF);
                l_CodPlfSTR := LTRIM(l_CodPlfSTR);
                l_CodPlfSTR := RTRIM(l_CodPlfSTR);

                l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODDSP);
                l_CodDspSTR := LTRIM(l_CodDspSTR);
                l_CodDspSTR := RTRIM(l_CodDspSTR);

                l_DiaSemSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.DIASEM);
                l_DiaSemSTR := LTRIM(l_DiaSemSTR);
                l_DiaSemSTR := RTRIM(l_DiaSemSTR);

                SP_INTSTR(l_r017FAP.INIFAI,'HH:MM', l_IniFaiSTR OUT);

                SP_INTSTR(l_r017FAP.FIMFAI,'HH:MM', l_FimFaiSTR OUT);

                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIASEM', l_DiaSemSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIFAI', l_IniFaiSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMFAI', l_FimFaiSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'EXCLUSÃO');
            END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de exclusão. (R034FAP).';
        END;
      END IF;
    END LOOP;
  END LOOP; /* FOREACH c_r038HPO */
END		SENIOR;24)SP_RETIDTPES
SP_INTSTR
SP_RET_REG_AUD
¯H␀␀


PROCEDURE SP_GERLOGPER(P_TIPOPE CHAR(1),P_ESTPOS NUMBER(3),P_POSTRA VARCHAR2(25),P_CODDSP NUMBER(9))
 IS

l_datatu DATE;
  l_idtcol    CHAR(23);
  l_count     NUMBER(5);
  l_oridef    NUMBER(1);
  l_codRPA    NUMBER(15);
  l_temAud34PRM NUMBER(2);
  l_temAud34FAP NUMBER(2);  
  l_numempSTR VARCHAR2(255);
  l_tipcolSTR VARCHAR2(255);
  l_numcadSTR VARCHAR2(255);
  l_ConCreSTR VARCHAR(1);
  l_ConFaiSTR VARCHAR(1);
  l_TemAlmSTR VARCHAR(3);
  l_TemPacSTR VARCHAR(3);
  l_GraConSTR VARCHAR(3);
  l_TolIntSTR VARCHAR(3);
  l_prmSTR    VARCHAR(5);
  l_UsaBioSTR VARCHAR(1);
  l_TolAcpSTR VARCHAR2(255);
  l_horatu    NUMBER(5);
  l_CodPltSTR VARCHAR2(5);
  l_CodPlt    NUMBER(5);
  l_CodRlgSTR VARCHAR(5);
  l_CodRlg    NUMBER(5);
  l_VerPlfSTR VARCHAR(3);
  l_VerPlf    NUMBER(3);
  l_CodPlfSTR VARCHAR(7);
  l_CodPlf    NUMBER(7);
  l_CodDspSTR VARCHAR(9);
  l_DiaSemSTR VARCHAR(1);
  l_IniFaiSTR VARCHAR(5);
  l_FimFaiSTR VARCHAR(5);
  l_codusu    NUMBER(9);
  l_EstPosSTR VARCHAR(3); 

  CURSOR c_r038HPO IS
    SELECT R038HPO.NUMEMP, R038HPO.TIPCOL, R038HPO.NUMCAD, R017TAP.HISPRI, R038HPO.INIATU, R038HPO.TERATU FROM R038HPO, R017TAP
      WHERE R038HPO.CODTAP = R017TAP.CODTAP AND ESTPOS = p_estpos AND POSTRA = p_postra
        AND R038HPO.INIATU <= l_datatu AND R038HPO.TERATU >= l_datatu;
  TYPE t_r038HPO IS RECORD(
    NUMEMP   R038HPO.NUMEMP%TYPE,
    TIPCOL   R038HPO.TIPCOL%TYPE,
    NUMCAD   R038HPO.NUMCAD%TYPE,
    HISPRI   R017TAP.HISPRI%TYPE,
    INIATU   R038HPO.INIATU%TYPE,
    TERATU   R038HPO.TERATU%TYPE);
  l_r038HPO t_r038HPO;

  /* CURSOR QUE OBTEM AS FAIXAS DE ACESSO DA PERMISSAO POR POSTO DE TRABALHO */
  CURSOR c_r017FAP IS
    SELECT CODPLT, CODRLG, CODDSP, VERPLF, CODPLF, INIFAI, FIMFAI, DIASEM
    FROM R017FAP WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;
    TYPE t_r017FAP IS RECORD(
    CODPLT   R017FAP.CODPLT%TYPE,
    CODRLG   R017FAP.CODRLG%TYPE,
    CODDSP   R017FAP.CODDSP%TYPE,
    VERPLF   R017FAP.VERPLF%TYPE,
    CODPLF   R017FAP.CODPLF%TYPE,
    INIFAI   R017FAP.INIFAI%TYPE,
    FIMFAI   R017FAP.FIMFAI%TYPE,
    DIASEM   R017FAP.DIASEM%TYPE);
  l_r017FAP t_r017FAP;
BEGIN
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  l_temAud34PRM := 0;
  BEGIN
      SELECT COUNT(*) INTO l_temAud34PRM FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 101;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao realizar o SELECT na tabela R995CTE.';
  END;

  l_temAud34FAP := 0;
  BEGIN
      SELECT COUNT(*) INTO l_temAud34FAP FROM R995CTE WHERE CODCPA = 6 AND CODTPA = 102;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro ao realizar o SELECT na tabela R995CTE.';
  END;

  l_codRPA := 0;

  l_numempSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMEMP);
  l_numempSTR := LTRIM(l_numempSTR);
  l_numempSTR := RTRIM(l_numempSTR);

  l_tipcolSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.TIPCOL);
  l_tipcolSTR := LTRIM(l_tipcolSTR);
  l_tipcolSTR := RTRIM(l_tipcolSTR);

  l_numcadSTR := CONVERT(NUMBER_TO_CHAR,l_r038HPO.NUMCAD);
  l_numcadSTR := LTRIM(l_numcadSTR);
  l_numcadSTR := RTRIM(l_numcadSTR);

  l_EstPosSTR := CONVERT(NUMBER_TO_CHAR,p_estpos);
  l_EstPosSTR := LTRIM(l_EstPosSTR);
  l_EstPosSTR := RTRIM(l_EstPosSTR);

  /* BUSCO TODOS OS COLABORADORES QUE POSSUEM ESTE POSTO DE TRABALHO VIGENTE NA DATA ATUAL */
  FOREACH c_r038HPO INTO l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_r038HPO.HISPRI, l_r038HPO.INIATU, l_r038HPO.TERATU
  LOOP    
    IF (l_r038HPO.HISPRI = 'S') THEN
      l_oridef := 1; /* HISTORICO PRINCIPAL */
    ELSE
      l_oridef := 2; /* HISTORICO ADICIONAL */
    END IF;

    SELECT CODUSU INTO l_codusu FROM R038HPO WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND NUMEMP = l_r038HPO.NUMEMP AND TIPCOL = l_r038HPO.TIPCOL AND NUMCAD = l_r038HPO.NUMCAD AND INIATU = l_r038HPO.INIATU AND TERATU = l_r038HPO.TERATU;

    SP_RETIDTPES(l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, NULL, NULL, NULL, NULL, l_idtcol OUT);

    /* -- ATRIBUICAO DE PERMISSOES POR LOCAL FISICO/DISPOSITIVO POR POSTO -- */
    /* VERIFICO SE ESTE DISPOSITIVO JA ESTA ASSOCIADO AO COLABORADOR */

    IF (p_tipope = 'I') THEN
      BEGIN
        SELECT COUNT(1) INTO l_count FROM R034PRM WHERE IDTPES = l_idtcol AND CODDSP = p_coddsp;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_count := 0;
          WHEN OTHERS THEN
            RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034PRM.';
      END;

      /* INSERE REGISTRO NA TABELA R034PRM. */
      IF (l_count = 0) THEN
        BEGIN
          IF (l_temAud34PRM > 0) THEN
			SP_RET_REG_AUD(l_codRPA OUT);

            INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                              VALUES (l_codRPA, 3, 6, 1, 101, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

            /*Campos chave da alteração*/
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

            SELECT CODPLT, CODRLG, VERPLF, CODPLF INTO l_codplt, l_codrlg, l_verplf, l_codplf FROM R017PRM WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;

            /*Campos detalhe da alteração*/
            l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_codplt);
            l_CodPltSTR := LTRIM(l_CodPltSTR);
            l_CodPltSTR := RTRIM(l_CodPltSTR);

            l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_codrlg);
            l_CodRlgSTR := LTRIM(l_CodRlgSTR);
            l_CodRlgSTR := RTRIM(l_CodRlgSTR);

            l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_verplf);
            l_VerPlfSTR := LTRIM(l_VerPlfSTR);
            l_VerPlfSTR := RTRIM(l_VerPlfSTR);

            l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_codplf);
            l_CodPlfSTR := LTRIM(l_CodPlfSTR);
            l_CodPlfSTR := RTRIM(l_CodPlfSTR);

            l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, p_coddsp);
            l_CodDspSTR := LTRIM(l_CodDspSTR);
            l_CodDspSTR := RTRIM(l_CodDspSTR);

            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'INCLUSÃO');
          END IF;  
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de inclusão. (R034PRM).';
        END;
      END IF;
    ELSE
        BEGIN
          IF (l_temAud34PRM > 0) THEN
                SP_RET_REG_AUD(l_codRPA OUT);

                INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                                  VALUES (l_codRPA, 3, 6, 1, 101, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

                /*Campos chave da alteração*/
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

                SELECT CODPLT, CODRLG, VERPLF, CODPLF INTO l_codplt, l_codrlg, l_verplf, l_codplf FROM R017PRM WHERE ESTPOS = p_estpos AND POSTRA = p_postra AND CODDSP = p_coddsp;

                /*Campos detalhe da alteração*/
                l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_codplt);
                l_CodPltSTR := LTRIM(l_CodPltSTR);
                l_CodPltSTR := RTRIM(l_CodPltSTR);

                l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_codrlg);
                l_CodRlgSTR := LTRIM(l_CodRlgSTR);
                l_CodRlgSTR := RTRIM(l_CodRlgSTR);

                l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_verplf);
                l_VerPlfSTR := LTRIM(l_VerPlfSTR);
                l_VerPlfSTR := RTRIM(l_VerPlfSTR);

                l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_codplf);
                l_CodPlfSTR := LTRIM(l_CodPlfSTR);
                l_CodPlfSTR := RTRIM(l_CodPlfSTR);

                l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, p_coddsp);
                l_CodDspSTR := LTRIM(l_CodDspSTR);
                l_CodDspSTR := RTRIM(l_CodDspSTR);

                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'EXCLUSÃO');
            END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de exclusão. (R034PRM).';
        END;
    END IF;

    /* BUSCO POR FAIXA */
    FOREACH c_r017FAP INTO l_r017FAP.CODPLT, l_r017FAP.CODRLG, l_r017FAP.CODDSP, l_r017FAP.VERPLF, l_r017FAP.CODPLF, l_r017FAP.INIFAI, l_r017FAP.FIMFAI, l_r017FAP.DIASEM
    LOOP
      /* VERIFICO SE ESTA FAIXA JA ESTA ASSOCIADA AO COLABORADOR */
      IF (p_tipope = 'I') THEN
        BEGIN
          SELECT COUNT(1) INTO l_count FROM R034FAP WHERE IDTPES = l_idtcol AND CODPLT = l_r017FAP.CODPLT AND CODRLG = l_r017FAP.CODRLG AND VERPLF = l_r017FAP.VERPLF
            AND CODPLF = l_r017FAP.CODPLF AND INIFAI = l_r017FAP.INIFAI AND DIASEM = l_r017FAP.DIASEM AND CODDSP = l_r017FAP.CODDSP;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              l_count := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'R017PRM_EI: Erro no SELECT da R034FAP.';
        END;

        /* INSERE REGISTRO NA TABELA R034FAP. */
        IF (l_count = 0) THEN
          BEGIN
            IF (l_temAud34FAP > 0) THEN


			SP_RET_REG_AUD(l_codRPA OUT);
            /*Registro mestre do log*/
            INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                              VALUES (l_codRPA, 3, 6, 1, 102, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

            /*Campos chave da alteração*/
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
            INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

            /*Campos detalhe da alteração*/
            l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLT);
            l_CodPltSTR := LTRIM(l_CodPltSTR);
            l_CodPltSTR := RTRIM(l_CodPltSTR);

            l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODRLG);
            l_CodRlgSTR := LTRIM(l_CodRlgSTR);
            l_CodRlgSTR := RTRIM(l_CodRlgSTR);

            l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.VERPLF);
            l_VerPlfSTR := LTRIM(l_VerPlfSTR);
            l_VerPlfSTR := RTRIM(l_VerPlfSTR);

            l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLF);
            l_CodPlfSTR := LTRIM(l_CodPlfSTR);
            l_CodPlfSTR := RTRIM(l_CodPlfSTR);

            l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODDSP);
            l_CodDspSTR := LTRIM(l_CodDspSTR);
            l_CodDspSTR := RTRIM(l_CodDspSTR);

            l_DiaSemSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.DIASEM);
            l_DiaSemSTR := LTRIM(l_DiaSemSTR);
            l_DiaSemSTR := RTRIM(l_DiaSemSTR);

            SP_INTSTR(l_r017FAP.INIFAI,'HH:MM', l_IniFaiSTR OUT);

            SP_INTSTR(l_r017FAP.FIMFAI,'HH:MM', l_FimFaiSTR OUT);

            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIASEM', l_DiaSemSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIFAI', l_IniFaiSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMFAI', l_FimFaiSTR);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'INCLUSÃO');
          END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de inclusão. (R034FAP).';
          END;
        END IF;
      ELSE
        BEGIN
          IF (l_temAud34FAP > 0) THEN
				SP_RET_REG_AUD(l_codRPA OUT);
                /*Registro mestre do log*/
                INSERT INTO R995RPA (CODRPA, CODSYS, CODCPA, VERCPA, CODTPA, VERTPA, DATRPA, HORRPA, SCRACT, CODUSU)
                                  VALUES (l_codRPA, 3, 6, 1, 102, 1, l_datatu, l_horatu, 'FRGERPRM', l_codusu);

                /*Campos chave da alteração*/
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMEMP' ,l_numempSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'TIPCOL' ,l_tipcolSTR);
                INSERT INTO R995PRC (CODRPA, NAMPPA,CONPPA) VALUES (l_codrpa, 'NUMCAD' ,l_numcadSTR);

                /*Campos detalhe da alteração*/
                l_CodPltSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLT);
                l_CodPltSTR := LTRIM(l_CodPltSTR);
                l_CodPltSTR := RTRIM(l_CodPltSTR);

                l_CodRlgSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODRLG);
                l_CodRlgSTR := LTRIM(l_CodRlgSTR);
                l_CodRlgSTR := RTRIM(l_CodRlgSTR);

                l_VerPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.VERPLF);
                l_VerPlfSTR := LTRIM(l_VerPlfSTR);
                l_VerPlfSTR := RTRIM(l_VerPlfSTR);

                l_CodPlfSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODPLF);
                l_CodPlfSTR := LTRIM(l_CodPlfSTR);
                l_CodPlfSTR := RTRIM(l_CodPlfSTR);

                l_CodDspSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.CODDSP);
                l_CodDspSTR := LTRIM(l_CodDspSTR);
                l_CodDspSTR := RTRIM(l_CodDspSTR);

                l_DiaSemSTR := CONVERT(NUMBER_TO_CHAR, l_r017FAP.DIASEM);
                l_DiaSemSTR := LTRIM(l_DiaSemSTR);
                l_DiaSemSTR := RTRIM(l_DiaSemSTR);

                SP_INTSTR(l_r017FAP.INIFAI,'HH:MM', l_IniFaiSTR OUT);

                SP_INTSTR(l_r017FAP.FIMFAI,'HH:MM', l_FimFaiSTR OUT);

                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDTPES', l_idtcol);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLT', l_CodPltSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRLG', l_CodRlgSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VERPLF', l_VerPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPLF', l_CodPlfSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDSP', l_CodDspSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMAMB', '0');
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', l_EstPosSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIASEM', l_DiaSemSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIFAI', l_IniFaiSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMFAI', l_FimFaiSTR);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', p_postra);
                INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'EXCLUSÃO');
            END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SP_ATU34: Erro ao gerar log de exclusão. (R034FAP).';
        END;
      END IF;
    END LOOP;
  END LOOP; /* FOREACH c_r038HPO */
END␀@ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
‚PROCEDURE SP_GERPEN_EVTSST(P_NUMEMP NUMBER(4), P_EVENTO VARCHAR2(6), P_GEREVT OUT BOOLEAN)
IS

	l_GerEvt INTEGER;
BEGIN
	NULL;
END␀Aø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
x␀␀PROCEDURE SP_GERPIDSTA(P_NUMEMP NUMBER(4), P_LAYOUT NUMBER(2), P_PIDSTA OUT VARCHAR2(30)) IS

	l_NumEmpStr VARCHAR2(4);
	l_LayoutStr VARCHAR2(4);
	l_DataAtual DATE;
	l_DataStr VARCHAR2(8);
	l_HoraStr VARCHAR2(2);
	l_MinutoStr VARCHAR2(2);
	l_SegundoStr VARCHAR2(2);
	l_Milisegundo NUMBER;
	l_MilisegundoStr VARCHAR2(2);  
	l_Contador NUMBER(2);
	l_ContadorStr VARCHAR2(4);
	l_ChaveExiste VARCHAR2(1);
	l_PidSta VARCHAR2(30);
BEGIN
    l_NumEmpStr := CONVERT(NUMBER_TO_CHAR, P_NUMEMP);
    WHILE (LENGTH(l_NumEmpStr) < 4) LOOP
    	l_NumEmpStr := '0' || l_NumEmpStr;
    END LOOP;
    
    l_LayoutStr := CONVERT(NUMBER_TO_CHAR, P_LAYOUT * 100);       
    
    l_DataAtual := DATETIME(DAYOFMONTH(CURDATE()), MONTH(CURDATE()), YEAR(CURDATE()), 0, 0, 0);
    SP_DATSTR(l_DataAtual, 'YYYYMMDD', l_DataStr OUT);    
    l_HoraStr := CONVERT(NUMBER_TO_CHAR, HOUR(CURTIME()));
    l_MinutoStr := CONVERT(NUMBER_TO_CHAR, MINUTE(CURTIME()));
    
    l_Contador := 1;
    
    IF (LENGTH(l_HoraStr)) = 1 THEN
      l_HoraStr := '0' || l_HoraStr;
    END IF;
    
    IF (LENGTH(l_MinutoStr)) = 1 THEN
      l_MinutoStr := '0' || l_MinutoStr;
    END IF;
    
    WHILE ((l_ChaveExiste = 'S') OR (l_ChaveExiste IS NULL)) LOOP
    	l_SegundoStr := CONVERT(NUMBER_TO_CHAR, SECOND(CURTIME()));
		IF (LENGTH(l_SegundoStr)) = 1 THEN
        	l_SegundoStr := '0' || l_SegundoStr;
        END IF;
        
        SP_MILLISECOND(l_Milisegundo OUT, 2);
        l_MilisegundoStr := CONVERT(NUMBER_TO_CHAR, l_Milisegundo);
        IF (LENGTH(l_MilisegundoStr)) = 1 THEN
        	l_MilisegundoStr := '0' || l_MilisegundoStr;
        END IF;
      
		l_ContadorStr := CONVERT(NUMBER_TO_CHAR, l_Contador);
		WHILE (LENGTH(l_ContadorStr) < 4) LOOP
			l_ContadorStr := '0' || l_ContadorStr;
		END LOOP;
      
		l_PidSta := l_NumEmpStr || l_LayoutStr || l_DataStr || l_HoraStr || l_MinutoStr || l_SegundoStr || l_MilisegundoStr || l_ContadorStr;
		
		/* Verifica se o PID montado já existe */
		BEGIN
			SELECT 'S' INTO l_ChaveExiste FROM R304STA WHERE PIDSTA = l_PidSta;
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_ChaveExiste := 'N';
		END;
    END LOOP;
    
    P_PIDSTA := l_PidSta;
END␀Bø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE SP_GERSEN(P_GERSEN OUT BOOLEAN)
 IS

l_count     NUMBER;
BEGIN
  l_count  := 0;
  p_gersen := FALSE;

  BEGIN
      SELECT COUNT(*) INTO l_count FROM R058CEN WHERE GERSEN = 'S' AND TIPGER = 2;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN l_count := 0;
      WHEN OTHERS THEN  l_count := 0;
  END;
  IF  (l_count > 0) THEN
      p_gersen := TRUE;
  END IF;
END		SENIOR;20
