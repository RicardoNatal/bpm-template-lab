DECLARE
  l_Valor VARCHAR2(2000); 
  l_VersaoESocial NUMBER;
  l_TipCon NUMBER;
  l_IndUni VARCHAR2(1);
  l_DatRef DATE;
  l_isGerarPendencia BOOLEAN;
BEGIN
  l_Valor := ''; 
  l_VersaoESocial := 0;
  l_TipCon := 1;
  l_IndUni := '';
  
  SP_GERAR_PEN_S2500(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODPRO, l_isGerarPendencia OUT);
  
  IF (l_isGerarPendencia = TRUE) THEN
    SP_RETDATREF_S2500(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, :NEW.CodPro, l_DatRef OUT);
    SP_ESOCIAL_S250X(:NEW.NumEmp, l_DatRef, l_VersaoESocial OUT);
    
     BEGIN
      SELECT TIPCON, INDUNI INTO l_TipCon, l_IndUni FROM R346CPT 
  	 WHERE NUMEMP = :NEW.NUMEMP
    	   AND TIPCOL = :NEW.TIPCOL
    	   AND NUMCAD = :NEW.NUMCAD
    	   AND CODPRO = :NEW.CODPRO;
          EXCEPTION	
           WHEN NO_DATA_FOUND THEN
            l_TipCon := 1;
            l_IndUni := '';
             WHEN OTHERS THEN RAISERROR 103 'R346VCI_EI: Erro no SELECT em R346CPT.';
     END;
           
    IF ((l_VersaoESocial = 5 AND l_IndUni = 'S') OR (l_VersaoESocial >= 6 AND l_TipCon = 9)) THEN
      SP_CONCATENAR_NUM('CODPRO', :NEW.CODPRO, l_Valor OUT);
      SP_E_SOCIAL('S-2500', 'R346VCI', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, NULL, 0, 'R346VCI_EI');
    END IF;
  END IF;
END␀æ␀␀		SENIOR;0	␀␀

TRIGGER R346VCI_EU BEFORE UPDATE ON R346VCI FOR EACH ROW
DECLARE
  l_Valor VARCHAR2(2000);
  l_Alterou BOOLEAN;
  l_Valido BOOLEAN;
  l_JsonCamposAlterados VARCHAR2(2000);
  l_VersaoESocial NUMBER;
  l_TipCon NUMBER;
  l_IndUni VARCHAR2(1);
  l_DatRef DATE;
  l_isGerarPendencia BOOLEAN;
BEGIN 
  l_Valor := '';
  l_VersaoESocial := 0; 
  l_TipCon := 1;
  l_IndUni := '';
  l_JsonCamposAlterados := '';
  
  SP_GERAR_PEN_S2500(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODPRO, l_isGerarPendencia OUT);
  
  IF (l_isGerarPendencia = TRUE) THEN
    SP_RETDATREF_S2500(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, :NEW.CodPro, l_DatRef OUT);
    SP_ESOCIAL_S250X(:NEW.NumEmp, l_DatRef, l_VersaoESocial OUT);
    
     BEGIN
      SELECT TIPCON,INDUNI INTO l_TipCon, l_IndUni FROM R346CPT 
  	 WHERE NUMEMP = :NEW.NUMEMP
    	   AND TIPCOL = :NEW.TIPCOL
    	   AND NUMCAD = :NEW.NUMCAD
    	   AND CODPRO = :NEW.CODPRO;
          EXCEPTION
           WHEN NO_DATA_FOUND THEN
            l_TipCon := 1;
            l_IndUni := '';
             WHEN OTHERS THEN RAISERROR 103 'R346VCI_EU: Erro no SELECT em R346CPT.';
     END;
           
    IF ((l_VersaoESocial = 5 AND l_IndUni = 'S') OR (l_VersaoESocial >= 6 AND l_TipCon = 9)) THEN
    
    	SP_VALUPDATE_DES(:OLD.MATUNI, :NEW.MATUNI, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_Alterou := TRUE;
        SP_CONCAT_DES_JSON('MATUNI', :NEW.MATUNI, :OLD.MATUNI, l_JsonCamposAlterados OUT);
      END IF;
    
      SP_VALUPDATE_NUM(:OLD.CODCAT, :NEW.CODCAT, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_Alterou := TRUE;
        SP_CONCAT_NUM_JSON('CODCAT', :NEW.CODCAT, :OLD.CODCAT, l_JsonCamposAlterados OUT);
      END IF;
    
      SP_VALUPDATE_DAT(:OLD.DatIni, :NEW.DatIni, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_Alterou := TRUE;
        SP_CONCAT_DAT_JSON('DATINI', :NEW.DatIni, :OLD.DatIni, l_JsonCamposAlterados OUT);
      END IF;
    
      IF (l_Alterou = TRUE) THEN     
        SP_CONCATENAR_NUM('CODPRO', :NEW.CODPRO, l_Valor OUT);
        SP_E_SOCIAL('S-2500', 'R346VCI', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, l_JsonCamposAlterados, 0, NULL, NULL, 0, 'R346VCI_EU');
      END IF;
    END IF;
  END IF;
END␀æ␀␀		SENIOR;0n␀␀

