  l_concpf := 'N';
  l_utiaut := 'N';
  l_rep671 := 'N';
  
  BEGIN
      SELECT COUNT(*) QNTREG INTO l_count FROM R070TSI;
  EXCEPTION
      WHEN OTHERS THEN
          RAISERROR 103 'SP_PRPTSI: ERRO NO SELECT R070TSI';
