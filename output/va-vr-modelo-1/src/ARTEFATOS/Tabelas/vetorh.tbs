	l_gerarPendencia BOOLEAN;
	l_layout VARCHAR2(6);
	l_VersaoESocial NUMBER;	
BEGIN
	l_layout := '';
	l_InfoFacult := TRUE;
	l_SimplificaoESocial := FALSE;
	l_gerarPendencia := TRUE;
	l_VersaoESocial := 0;
    l_Valor := '';
	
	SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);

	IF (l_SimplificaoESocial = TRUE) THEN
		RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
		GR_PEN_PARA_BENEF(l_layout, l_gerarPendencia OUT);
		
		IF (l_gerarPendencia = TRUE)THEN
		  SP_CONCATENAR_DES('NROBEN', :NEW.NroBen, l_Valor OUT);
		  SP_CONCATENAR_NUM('TPREBN', :NEW.TpReBn, l_Valor OUT);
		
		  IF ((:NEW.TpReBn = 1) OR (:NEW.TpReBn = 2)) THEN

		    l_layout := 'S-2410';
		    IF (:NEW.TpReBn = 2) THEN
		      l_layout := 'S-2416';
		    END IF;
		    
		  ELSIF (:NEW.TpReBn = 3) THEN
		    l_layout := 'S-2420';
		  
		  ELSIF ((:NEW.TpReBn = 4) OR (:NEW.TpReBn = 5)) THEN
		    l_layout := 'S-2418';
		  END IF;
		  
		  SP_E_SOCIAL(l_layout, 'R034BEN', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DatRef, 0, 'R034BEN_EI');
		END IF;
	END IF;
END␀'Ó␀␀		SENIOR;0­␀␀

TRIGGER R034BEN_EU AFTER UPDATE ON R034BEN FOR EACH ROW DECLARE
	l_Valor VARCHAR2(2000);
	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_Incluir BOOLEAN;
	l_Excluir BOOLEAN;
	l_InfoFacult BOOLEAN;
	l_SimplificaoESocial BOOLEAN;
	l_gerarPendencia BOOLEAN;
	l_layout VARCHAR2(6);
	l_VersaoESocial NUMBER;
BEGIN
	l_layout := '';
	l_Valor := '';
	l_Valido := FALSE;
	l_Alterou := FALSE;
	l_Incluir := FALSE;
    l_Excluir := FALSE;	
	l_InfoFacult := TRUE;
	l_SimplificaoESocial := FALSE;
	l_gerarPendencia := TRUE;
	l_VersaoESocial := 0;

	SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);

	IF (l_SimplificaoESocial = TRUE) THEN
		RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
		GR_PEN_PARA_BENEF(l_layout, l_gerarPendencia OUT);
		
		IF (l_gerarPendencia = TRUE)THEN
	
		  SP_VALUPDATE_DAT(:OLD.DatRef, :NEW.DatRef, l_Valido OUT);
		  IF (l_Valido = TRUE) THEN
			  l_Alterou := TRUE;
		  END IF;	
			
		  IF (:NEW.TpReBn = 1) THEN
		    l_layout := 'S-2410';
		  
			SP_VALUPDATE_DAT(:OLD.DatPub, :NEW.DatPub, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;

            SP_VALUPDATE_NUM(:OLD.TipBen, :NEW.TipBen, l_Valido OUT);
            IF (l_Valido = TRUE) THEN
                l_Alterou := TRUE;
            END IF;    
			
			SP_VALUPDATE_NUM(:OLD.PanSeg, :NEW.PanSeg, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;
			
			SP_VALUPDATE_DES(:OLD.DscBen, :NEW.DscBen, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;	
			
			SP_VALUPDATE_NUM(:OLD.PenMor, :NEW.PenMor, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;
			
			SP_VALUPDATE_DES(:OLD.DetJud, :NEW.DetJud, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;	
			
			SP_VALUPDATE_NUM(:OLD.SitBen, :NEW.SitBen, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;
			
			SP_VALUPDATE_DES(:OLD.MatEso, :NEW.MatEso, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;
			
			SP_VALUPDATE_NUM(:OLD.CNPJOr, :NEW.CNPJOr, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;	
			
			SP_VALUPDATE_NUM(:OLD.CpfIns, :NEW.CpfIns, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;
			
			SP_VALUPDATE_DAT(:OLD.DatIns, :NEW.DatIns, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;
			
			SP_VALUPDATE_NUM(:OLD.CNPJAn, :NEW.CNPJAn, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;
			
			SP_VALUPDATE_DES(:OLD.BenAnt, :NEW.BenAnt, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;
			
			SP_VALUPDATE_DAT(:OLD.DatSuc, :NEW.DatSuc, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;
			
			SP_VALUPDATE_DES(:OLD.DscSuc, :NEW.DscSuc, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;
			
			SP_VALUPDATE_DAT(:OLD.DatTer, :NEW.DatTer, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;

			SP_VALUPDATE_NUM(:OLD.MtvTer, :NEW.MtvTer, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;

			SP_VALUPDATE_NUM(:OLD.SitHom, :NEW.SitHom, l_Valido OUT);
            IF (l_Valido = TRUE) THEN
                l_Alterou := TRUE;
            END IF; 
            
			SP_VALUPDATE_DAT(:OLD.DatHom, :NEW.DatHom, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;          
            
            SP_VALUPDATE_NUM(:OLD.TipDep, :NEW.TipDep, l_Valido OUT);
            IF (l_Valido = TRUE) THEN
                l_Alterou := TRUE;
            END IF; 
            
            SP_VALUPDATE_DES(:OLD.DesDep, :NEW.DesDep, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;           
		ELSIF (:NEW.TpReBn = 2) THEN
            l_layout := 'S-2416';

            SP_VALUPDATE_NUM(:OLD.TipBen, :NEW.TipBen, l_Valido OUT);
            IF (l_Valido = TRUE) THEN
                l_Alterou := TRUE;
            END IF;    
            
            SP_VALUPDATE_NUM(:OLD.PanSeg, :NEW.PanSeg, l_Valido OUT);
            IF (l_Valido = TRUE) THEN
                l_Alterou := TRUE;
            END IF;
            
            SP_VALUPDATE_DES(:OLD.DscBen, :NEW.DscBen, l_Valido OUT);
            IF (l_Valido = TRUE) THEN
                l_Alterou := TRUE;
            END IF;    
            
            SP_VALUPDATE_NUM(:OLD.PenMor, :NEW.PenMor, l_Valido OUT);
            IF (l_Valido = TRUE) THEN
                l_Alterou := TRUE;
            END IF;

            SP_VALUPDATE_DES(:OLD.IndSus, :NEW.IndSus, l_Valido OUT);
            IF (l_Valido = TRUE) THEN
                l_Alterou := TRUE;
            END IF;
            
            SP_VALUPDATE_NUM(:OLD.MtvSus, :NEW.MtvSus, l_Valido OUT);
            IF (l_Valido = TRUE) THEN
                l_Alterou := TRUE;
            END IF;
            
            SP_VALUPDATE_DES(:OLD.DscSus, :NEW.DscSus, l_Valido OUT);
            IF (l_Valido = TRUE) THEN
                l_Alterou := TRUE;
            END IF;
            
            SP_VALUPDATE_NUM(:OLD.TipDep, :NEW.TipDep, l_Valido OUT);
            IF (l_Valido = TRUE) THEN
                l_Alterou := TRUE;
            END IF; 
            
            SP_VALUPDATE_DES(:OLD.DesDep, :NEW.DesDep, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF; 
		ELSIF (:NEW.TpReBn = 3) THEN
		  	l_layout := 'S-2420';
		  		

			SP_VALUPDATE_NUM(:OLD.MtvTer, :NEW.MtvTer, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;

			SP_VALUPDATE_NUM(:OLD.CNPJDs, :NEW.CNPJDs, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;
		ELSIF ((:NEW.TpReBn = 4) OR (:NEW.TpReBn = 5)) THEN
			l_layout := 'S-2418';
			
			SP_VALUPDATE_DAT(:OLD.DatEfe, :NEW.DatEfe, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_Alterou := TRUE;
			END IF;
		END IF;
		
		IF (l_Alterou = TRUE) THEN
		    SP_CONCATENAR_DES('NROBEN', :NEW.NroBen, l_Valor OUT);
			SP_CONCATENAR_NUM('TPREBN', :NEW.TpReBn, l_Valor OUT);
		
			SP_E_SOCIAL(l_layout, 'R034BEN', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DatRef, 0, 'R034BEN_EU');
		END IF;
	  END IF;	
	END IF;
END␀%Ó␀␀		SENIOR;0K␀␀

TRIGGER R034BEN_ED AFTER DELETE ON R034BEN FOR EACH ROW DECLARE
	l_Valor VARCHAR2(2000);
	l_InfoFacult BOOLEAN;
	l_SimplificaoESocial BOOLEAN;
	l_gerarPendencia BOOLEAN;
	l_layout VARCHAR2(6);
	l_VersaoESocial NUMBER;
BEGIN
    l_Valor := '';
	l_layout := '';
    l_gerarPendencia := TRUE;
	l_VersaoESocial := 0;
	SP_ESOCIAL_INFO(:OLD.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);

	IF (l_SimplificaoESocial = TRUE) THEN
		RH_LAYOUTCOLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layout OUT);
		GR_PEN_PARA_BENEF(l_layout, l_gerarPendencia OUT);
		
		IF (l_gerarPendencia = TRUE)THEN
			
		  IF (:OLD.TpReBn = 1) THEN
		    l_layout := 'S-2410';
		  ELSIF (:OLD.TpReBn = 2) THEN
			l_layout := 'S-2416';		     
		  ELSIF (:OLD.TpReBn = 3) THEN
		    l_layout := 'S-2420';
		  ELSIF ((:OLD.TpReBn = 4) OR (:OLD.TpReBn = 5)) THEN
		    l_layout := 'S-2418';
		  END IF;
		
		  SP_CONCATENAR_DES('LAYOUT', l_layout, l_Valor OUT);
		  SP_CONCATENAR_DES('NROBEN', :OLD.NroBen, l_Valor OUT);
		  SP_CONCATENAR_NUM('TPREBN', :OLD.TpReBn, l_Valor OUT);
		  SP_CONCATENAR_NUM('SITBEN', :OLD.SitBen, l_Valor OUT);
		
	      SP_E_SOCIAL('S-3000', 'R034BEN', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0, NULL, :OLD.DatRef, 0, 'R034BEN_ED');
	  END IF;
	END IF;  
END␀␀␀¥œ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀(Ó␀␀…¬␀␀´␀	Ôÿ!␀␀␀␀␀cXbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ!␀␀␀␀␀␀␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ!␀␀␀␀␀‚%€$€$w␀Æÿ␀␀…Ó␀␀␀¬kÓ␀	Ôÿ!␀␀␀␀␀·k²k·kn␀Æÿ␀␀ÿ␀P␀À	Ôÿ!␀␀␀␀␀L␀^␀^␀n␀Æÿ␀␀ÿ␀aTÒ␀Ôÿ!␀␀␀␀␀)])])]ÿ␀ÿÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀(]␀␀␀␀␀␀␀)Ó␀␀…¬␀␀´␀	␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀$0.0.w␀Æÿ␀␀…Ó␀␀␀ ,­␀	␀␀␀␀␀␀å?Ç:á?p␀Æÿ␀␀H×␀␀␀÷ó␀␀=␀␀␀␀␀␀n.òó␀␀¨c␀␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3␀␀ä4␀␀␀␀␀*Ó␀␀…¬␀␀´␀	␀␀␀␀␀␀␀g>XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀›␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀‚%€$€$w␀Æÿ␀␀…Ó␀␀␀ğDÑ␀␀␀␀␀␀␀␀/G/G/GqC␀êÿ␀␀ÿ␀␀␀␀0;1;2␀␀à6␀␀␀␀␀+Ó␀␀…¬␀␀´␀	Ôÿ#␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ#␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ#␀␀␀␀␀œ$€$€$w␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ôÿ#␀␀␀␀␀‡JşEşEqC␀êÿ␀␀ÿ␀Öü␀␀­␀	Ôÿ#␀␀␀␀␀xş␀␀xş␀␀xş␀␀3)␀␀Æÿ␀␀ÿ␀,´␀	Ôÿ#␀␀␀␀␀Ş?ÄÅr␀Æÿ␀␀ìÏ␀␀␀ø+·␀	Ôÿ#␀␀␀␀␀N<s␀Æÿ␀␀êÏ␀␀␀	␀ôÔÿ!␀␀␀␀␀‡␀␀␀n␀Æÿ␀␀ÿ␀R1–␀	Ôÿ#␀␀␀␀␀555c␀Æÿ␀␀ÿ␀]DÔÿ!␀␀␀␀␀ì_ç_é_R␀␀ÿ␀␀ÿ␀½␀␀¹␀Ôÿ!␀␀␀␀␀R¾␀␀¾␀␀¾␀␀Q)␀␀Æÿ␀␀ÿ␀-´␀Ôÿ!␀␀␀␀␀j?i:»;r␀␀Æÿ␀␀ÿ␀␀␀,Ó␀␀␀␀0;1;2;3;4;5;6;8.Ó␀␀		SENIOR;0‡␀␀TRIGGER R034CON_EI AFTER INSERT ON R034CON FOR EACH ROW

DECLARE
  L_CODPES         R033PES.CODPES%TYPE;
  L_COUNT        NUMBER;
  l_DatAtu       DATE;
  l_Data_zero    DATE;
  l_existe       BOOLEAN;
  L_DATALT         R033CON.DATALT%TYPE;
  L_ULTSEQCON      R033CON.SEQCON%TYPE;
  L_SEQCON         R033CON.SEQCON%TYPE;
  L_CODBAN         R033CON.CODBAN%TYPE;
  L_CODAGE         R033CON.CODAGE%TYPE;
  L_TIPBAN         R033CON.TIPBAN%TYPE;
  L_CONBAN         R033CON.CONBAN%TYPE;
  L_DIGBAN         R033CON.DIGBAN%TYPE;
  l_DatAltHFI      R033CON.DATAUX%TYPE;
  l_ColAti         R033CON.COLATI%TYPE;
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);

BEGIN
  /*Data atual*/
  l_DatAtu := CURDATE();
  /*Data zerada*/
  l_data_zero  := '31/12/1900,00:00:00';

  /*Verifica se existe código da pessoa vinculado ao colaborador*/
  BEGIN
    SELECT CODPES INTO L_CODPES FROM R034FUN
     WHERE NUMEMP = :NEW.NUMEMP
       AND TIPCOL = :NEW.TIPCOL
       AND NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_CODPES := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R034FUN.CODPES';
  END;

  IF (L_CODPES > 0) THEN
    /*Verifica se pessoa existe na base*/
    BEGIN
      SELECT COUNT(*) INTO L_COUNT FROM R033PES
       WHERE CODPES = L_CODPES;
      EXCEPTION WHEN NO_DATA_FOUND THEN
        L_COUNT := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler R033PES.CODPES 1';
    END;

    IF (L_COUNT > 0) THEN
      l_existe := TRUE;
      BEGIN
        /*Verifica se conta já existe*/
        SELECT SEQCON,  DATALT,  CODBAN,  CODAGE,  CONBAN
          INTO L_SEQCON,L_DATALT,L_CODBAN,L_CODAGE,L_CONBAN
          FROM R033CON
         WHERE CODPES = L_CODPES
           AND DATALT = :NEW.DATALT
           AND CODBAN = :NEW.CODBAN
           AND CODAGE = :NEW.CODAGE
           AND CONBAN = :NEW.CONBAN
           AND SEQCON = (SELECT MAX(SEQCON)
                         	FROM R033CON TAB2
                        	WHERE TAB2.CODPES = L_CODPES
                        	AND TAB2.DATALT = :NEW.DATALT
                        	AND TAB2.CODBAN = :NEW.CODBAN
           					AND TAB2.CODAGE = :NEW.CODAGE
           					AND TAB2.CONBAN = :NEW.CONBAN);
        EXCEPTION WHEN NO_DATA_FOUND THEN
          L_SEQCON := 0;
          L_DATALT := :NEW.DATALT;
          L_CODBAN := :NEW.CODBAN;
          L_CODAGE := :NEW.CODAGE;
          L_CONBAN := :NEW.CONBAN;
          L_DIGBAN := :NEW.DIGBAN;
          L_TIPBAN := :NEW.TIPBAN;
          l_Existe := FALSE;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler R033CON';
      END;

      /* Retornar a data do primeiro hist. filial do colaborador */
      R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);
        
      /* Retornar se o colaborador está ativo */
      R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);

      IF (l_Existe = TRUE) THEN
        BEGIN
          /*Se já existe zera a data encerramento */
          UPDATE R033CON SET TIPBAN = :NEW.TIPBAN, DIGBAN = :NEW.DIGBAN, DATENC = l_data_zero,
                             EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                             DEPAUX = 0, COLATI = l_ColAti, CANAUX = 0, DATAUX = l_DatAltHFI
           WHERE CODPES = L_CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON AND CODBAN = L_CODBAN AND CODAGE = L_CODAGE
             AND CONBAN = L_CONBAN;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar a R033CON';
        END;
      ELSE
        BEGIN
            /*Gera próxima sequência*/
            SELECT IFNULL(MAX(SEQCON),0) INTO L_ULTSEQCON FROM R033CON
             WHERE CODPES = L_CODPES;
            EXCEPTION WHEN NO_DATA_FOUND THEN
              L_ULTSEQCON := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao ler R033CON.SEQCON';
        END;
        L_SEQCON := L_ULTSEQCON + 1;
        BEGIN
          /*Se a conta não existe insere na base */
          INSERT INTO R033CON (CODPES, DATALT, SEQCON, CODBAN, CODAGE, TIPBAN, CONBAN, DIGBAN, DATABE, DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX)
          VALUES (L_CODPES, L_DATALT, L_SEQCON, L_CODBAN, L_CODAGE, L_TIPBAN, L_CONBAN, L_DIGBAN, l_DatAtu, l_data_zero, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, l_ColAti, 0, l_DatAltHFI);
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao inserir na R033CON';
        END;
      END IF;
    END IF;
  END IF;
  /* Geração de logs Contas Bancárias (Tabela: R034CON)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 84;     /* Contas Bancárias (Tabela: R034CON)*/
  l_codtpa := 279;
 
   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
	  SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034CON_EI', '');

	  /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
	  BEGIN
	    INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
		SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQCON', CONVERT(NUMBER_TO_CHAR, :NEW.SEQCON));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODBAN', CONVERT(NUMBER_TO_CHAR, :NEW.CODBAN));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODAGE', CONVERT(NUMBER_TO_CHAR, :NEW.CODAGE));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONBAN', CONVERT(NUMBER_TO_CHAR, :NEW.CONBAN));
	  EXCEPTION
		WHEN OTHERS THEN RAISERROR 103 'R034CON_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	  END;

	  BEGIN
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPBAN', CONVERT(NUMBER_TO_CHAR, :NEW.TIPBAN));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIGBAN', :NEW.DIGBAN);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERCON', CONVERT(NUMBER_TO_CHAR, :NEW.PERCON));
	  END;
  END IF;   
END␀/Ó␀␀		SENIOR;0%␀␀

TRIGGER R034CON_EU AFTER UPDATE ON R034CON FOR EACH ROW

DECLARE
  L_CODPES    	   R033PES.CODPES%TYPE;
  L_COUNT     	 NUMBER;
  L_SITAFA    	   R034FUN.SITAFA%TYPE;
  L_DEMITIDOS 	 BOOLEAN;
  l_DatAtu    	 DATE;
  l_Data_zero 	 DATE;
  l_existe    	 BOOLEAN;
  L_DATALT    	   R033CON.DATALT%TYPE;
  L_ULTSEQCON 	   R033CON.SEQCON%TYPE;
  L_SEQCON    	   R033CON.SEQCON%TYPE;
  L_CODBAN    	   R033CON.CODBAN%TYPE;
  L_CODAGE    	   R033CON.CODAGE%TYPE;
  L_TIPBAN    	   R033CON.TIPBAN%TYPE;
  L_CONBAN    	   R033CON.CONBAN%TYPE;
  L_DIGBAN    	   R033CON.DIGBAN%TYPE;
  l_DatAltHFI 	   R033CON.DATAUX%TYPE;
  l_ColAti    	   R033CON.COLATI%TYPE;
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN
  /*Data atual*/
  l_DatAtu := CURDATE();
  /*Data zerada*/
  l_data_zero  := '31/12/1900,00:00:00';

  /*Verifica se existe código da pessoa vinculado ao colaborador*/
  BEGIN
    SELECT CODPES,SITAFA INTO L_CODPES,L_SITAFA FROM R034FUN
     WHERE NUMEMP = :NEW.NUMEMP
       AND TIPCOL = :NEW.TIPCOL
       AND NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_CODPES := 0;
      L_SITAFA := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R034FUN.CODPES';
  END;

  IF (L_CODPES > 0) THEN
    /*Verifica se pessoa existe na base*/
    BEGIN
      SELECT COUNT(*) INTO L_COUNT FROM R033PES
       WHERE CODPES = L_CODPES;
      EXCEPTION WHEN NO_DATA_FOUND THEN
        L_COUNT := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler R033PES.CODPES 1';
    END;

    IF (L_COUNT > 0) THEN
      RH_VERCOLDEM(:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,L_CODPES,L_SITAFA,'R034CON',L_DEMITIDOS OUT);
      IF (L_DEMITIDOS = TRUE) THEN
        l_existe := TRUE;
        BEGIN
          /*Verifica se conta já existe*/
          SELECT DATALT,   SEQCON,   CODBAN,   CODAGE,   TIPBAN,   CONBAN,   DIGBAN
            INTO L_DATALT, L_SEQCON, L_CODBAN, L_CODAGE, L_TIPBAN, L_CONBAN, L_DIGBAN
            FROM R033CON
           WHERE CODPES = L_CODPES
             AND DATALT = :OLD.DATALT
             AND CODBAN = :OLD.CODBAN
             AND CODAGE = :OLD.CODAGE
             AND CONBAN = :OLD.CONBAN;
          EXCEPTION WHEN NO_DATA_FOUND THEN
            L_SEQCON := 0;
            L_DATALT := :NEW.DATALT;
            L_CODBAN := :NEW.CODBAN;
            L_CODAGE := :NEW.CODAGE;
            L_TIPBAN := :NEW.TIPBAN;
            L_CONBAN := :NEW.CONBAN;
            L_DIGBAN := :NEW.DIGBAN;
            l_existe := FALSE;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler R033CON';
        END;

        /* Retornar a data do primeiro hist. filial do colaborador */
        R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);
        
        /* Retornar se o colaborador está ativo */
        R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);

        IF (l_Existe = TRUE) THEN
          BEGIN
            /*Se já existe atualiza com data encerramento zerada*/
            UPDATE R033CON SET CODBAN = :NEW.CODBAN, CODAGE = :NEW.CODAGE, CONBAN = :NEW.CONBAN, TIPBAN = :NEW.TIPBAN, 
                               DIGBAN = :NEW.DIGBAN, DATENC = l_data_zero,
                               EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                               DEPAUX = 0, COLATI = l_ColAti, CANAUX = 0, DATAUX = l_DatAltHFI
             WHERE CODPES = L_CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON AND CODBAN = L_CODBAN AND CODAGE = L_CODAGE
               AND CONBAN = L_CONBAN;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a R033CON';
          END;
        ELSE
          BEGIN
            /*Gera próxima sequência*/
            SELECT IFNULL(MAX(SEQCON),0) INTO L_ULTSEQCON FROM R033CON
             WHERE CODPES = L_CODPES;
            EXCEPTION WHEN NO_DATA_FOUND THEN
              L_ULTSEQCON := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao ler R033CON';
          END;
          L_SEQCON := L_ULTSEQCON + 1;
          BEGIN
            /*Se a conta não existe insere na base*/
            INSERT INTO R033CON (CODPES, DATALT, SEQCON, CODBAN, CODAGE, TIPBAN, CONBAN, DIGBAN, DATABE, DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX)
            VALUES (L_CODPES, L_DATALT, L_SEQCON, L_CODBAN, L_CODAGE, L_TIPBAN, L_CONBAN, L_DIGBAN, l_DatAtu, l_data_zero, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, l_ColAti, 0, l_DatAltHFI);
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao inserir na R033CON';
          END;
        END IF;
      END IF;
    END IF;
  END IF;

  /* Geração de logs Contas Bancárias (Tabela: R034CON)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 84;     /* Contas Bancárias (Tabela: R034CON)*/
  l_codtpa := 280;
 
  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.SeqCon <> :NEW.SeqCon)
   OR (:OLD.CodBan <> :NEW.CodBan)
   OR (:OLD.CodAge <> :NEW.CodAge)
   OR (:OLD.TipBan <> :NEW.TipBan)
   OR (:OLD.ConBan <> :NEW.ConBan)
   OR (:OLD.DigBan <> :NEW.DigBan)
   OR (:OLD.PerCon <> :NEW.PerCon)) THEN

   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034CON_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQCON', CONVERT(NUMBER_TO_CHAR, :OLD.SEQCON));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODBAN', CONVERT(NUMBER_TO_CHAR, :OLD.CODBAN));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODAGE', CONVERT(NUMBER_TO_CHAR, :OLD.CODAGE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONBAN', CONVERT(NUMBER_TO_CHAR, :OLD.CONBAN));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034CON_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPBAN', CONVERT(NUMBER_TO_CHAR, :OLD.TIPBAN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPBAN', CONVERT(NUMBER_TO_CHAR, :NEW.TIPBAN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDIGBAN', :OLD.DIGBAN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDIGBAN', :NEW.DIGBAN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERCON', CONVERT(NUMBER_TO_CHAR, :OLD.PERCON));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERCON', CONVERT(NUMBER_TO_CHAR, :NEW.PERCON));
      END;
    END IF; 
  END IF;   
END␀-Ó␀␀		SENIOR;0ˆ	␀␀

TRIGGER R034CON_ED AFTER DELETE ON R034CON FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Contas Bancárias (Tabela: R034CON)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 84;     /* Contas Bancárias (Tabela: R034CON)*/
  l_codtpa := 279;
 
   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034CON_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQCON', CONVERT(NUMBER_TO_CHAR, :OLD.SEQCON));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODBAN', CONVERT(NUMBER_TO_CHAR, :OLD.CODBAN));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODAGE', CONVERT(NUMBER_TO_CHAR, :OLD.CODAGE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONBAN', CONVERT(NUMBER_TO_CHAR, :OLD.CONBAN));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034CON_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPBAN', CONVERT(NUMBER_TO_CHAR, :OLD.TIPBAN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIGBAN', :OLD.DIGBAN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERCON', CONVERT(NUMBER_TO_CHAR, :OLD.PERCON));
      END;
  END IF; 
END␀␀␀B5␀␀␀␀␀␀␀␀␀␀␀␀0Ó␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ?␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀9Ó␀␀␀c¬␀␀Ì␀	Ôÿ?␀␀␀␀␀œ$€$€$w␀Æÿ␀␀…Ó␀␀␀¥mÌ␀Ôÿ!␀␀␀␀␀
