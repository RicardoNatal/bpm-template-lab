DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

	l_codSistema := 1;
	l_codcpa := 128;
	l_codtpa := 387;
	
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);
	
  IF (l_temAud = TRUE) THEN 
	  SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110MED_EI', '');
      
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));        
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIC));        
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', CONVERT(DATE_TO_CHAR,   :NEW.DATATE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR, :NEW.HORATE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODREM', CONVERT(NUMBER_TO_CHAR, :NEW.CODREM));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110MED_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATADM', CONVERT(DATE_TO_CHAR,   :NEW.DATADM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORADM', CONVERT(NUMBER_TO_CHAR, :NEW.HORADM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR, :NEW.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMREC', CONVERT(NUMBER_TO_CHAR, :NEW.NUMREC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOCO', CONVERT(NUMBER_TO_CHAR, :NEW.CODOCO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDOE', :NEW.CODDOE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCID', :NEW.CODCID);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSADM', :NEW.OBSADM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ANOADM', :NEW.ANOADM);         
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ATEADM', CONVERT(NUMBER_TO_CHAR, :NEW.ATEADM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDAPL', CONVERT(NUMBER_TO_CHAR, :NEW.QTDAPL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDDOA', CONVERT(NUMBER_TO_CHAR, :NEW.QTDDOA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODAPR', CONVERT(NUMBER_TO_CHAR, :NEW.CODAPR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODAPD', CONVERT(NUMBER_TO_CHAR, :NEW.CODAPD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDSOL', :NEW.INDSOL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPOS', CONVERT(NUMBER_TO_CHAR, :NEW.CODPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSUB', :NEW.CODSUB);        
      END; 
   END IF;
END␀‹ß␀␀		SENIOR;0(␀␀

TRIGGER R110MED_EU AFTER UPDATE ON R110MED FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

	l_codSistema := 1;
	l_codcpa := 128;
	l_codtpa := 388;
	
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);
 
  IF   ((:OLD.NUMEMP <> :NEW.NUMEMP) 
	 OR (:OLD.CODFIC <> :NEW.CODFIC) 
	 OR (:OLD.DATATE <> :NEW.DATATE)	 
	 OR (:OLD.HORATE <> :NEW.HORATE)
	 OR (:OLD.CODREM <> :NEW.CODREM)
	 OR (:OLD.DATADM <> :NEW.DATADM)
	 OR (:OLD.HORADM <> :NEW.HORADM)
	 OR (:OLD.CODATE <> :NEW.CODATE)
	 OR (:OLD.NUMREC <> :NEW.NUMREC)
	 OR (:OLD.CODOCO <> :NEW.CODOCO)
	 OR (:OLD.CODDOE <> :NEW.CODDOE)
	 OR (:OLD.CODCID <> :NEW.CODCID)
	 OR (:OLD.OBSADM <> :NEW.OBSADM)
	 OR (:OLD.ANOADM <> :NEW.ANOADM)
	 OR (:OLD.ATEADM <> :NEW.ATEADM)
	 OR (:OLD.QTDAPL <> :NEW.QTDAPL)
	 OR (:OLD.QTDDOA <> :NEW.QTDDOA)
	 OR (:OLD.CODAPR <> :NEW.CODAPR)
	 OR (:OLD.CODAPD <> :NEW.CODAPD)
	 OR (:OLD.INDSOL <> :NEW.INDSOL)
	 OR (:OLD.CODPOS <> :NEW.CODPOS)
	 OR (:OLD.CODSUB <> :NEW.CODSUB)) THEN		 	 
	  IF (l_temAud = TRUE) THEN
	    SP_RET_REG_AUD(l_codrpa OUT); 
        SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110MED_EU', '');
      
        BEGIN          
          INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));        
          INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIC));
          INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', CONVERT(DATE_TO_CHAR,   :OLD.DATATE));
          INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR, :OLD.HORATE));
          INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODREM', CONVERT(NUMBER_TO_CHAR, :OLD.CODREM));
        EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'R110MED_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
        END;
        
        BEGIN
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');           
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATADM', CONVERT(DATE_TO_CHAR, :OLD.DATADM));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATADM', CONVERT(DATE_TO_CHAR, :NEW.DATADM));                   
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORADM', CONVERT(NUMBER_TO_CHAR, :OLD.HORADM));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORADM', CONVERT(NUMBER_TO_CHAR, :NEW.HORADM));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODATE', CONVERT(NUMBER_TO_CHAR, :OLD.CODATE));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODATE', CONVERT(NUMBER_TO_CHAR, :NEW.CODATE));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMREC', CONVERT(NUMBER_TO_CHAR, :OLD.NUMREC));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMREC', CONVERT(NUMBER_TO_CHAR, :NEW.NUMREC));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODOCO', CONVERT(NUMBER_TO_CHAR, :OLD.CODOCO));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODOCO', CONVERT(NUMBER_TO_CHAR, :NEW.CODOCO));          
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODDOE', :OLD.CODDOE);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODDOE', :NEW.CODDOE);          
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCID', :OLD.CODCID);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCID', :NEW.CODCID);          
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSADM', :OLD.OBSADM);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSADM', :NEW.OBSADM);  
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDANOADM', :OLD.ANOADM);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWANOADM', :NEW.ANOADM);                                          
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDATEADM', CONVERT(NUMBER_TO_CHAR, :OLD.ATEADM));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWATEADM', CONVERT(NUMBER_TO_CHAR, :NEW.ATEADM));                           
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQTDAPL', CONVERT(NUMBER_TO_CHAR, :OLD.QTDAPL));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQTDAPL', CONVERT(NUMBER_TO_CHAR, :NEW.QTDAPL));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQTDDOA', CONVERT(NUMBER_TO_CHAR, :OLD.QTDDOA));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQTDDOA', CONVERT(NUMBER_TO_CHAR, :NEW.QTDDOA));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODAPR', CONVERT(NUMBER_TO_CHAR, :OLD.CODAPR));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODAPR', CONVERT(NUMBER_TO_CHAR, :NEW.CODAPR));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODAPD', CONVERT(NUMBER_TO_CHAR, :OLD.CODAPD));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODAPD', CONVERT(NUMBER_TO_CHAR, :NEW.CODAPD));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINDSOL', :OLD.INDSOL);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINDSOL', :NEW.INDSOL);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPOS', CONVERT(NUMBER_TO_CHAR, :OLD.CODPOS));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPOS', CONVERT(NUMBER_TO_CHAR, :NEW.CODPOS));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODSUB', :OLD.CODSUB);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODSUB', :NEW.CODSUB);            
        END;
	  END IF;
	END IF; 
END␀‰ß␀␀		SENIOR;0…␀␀	
	
	
