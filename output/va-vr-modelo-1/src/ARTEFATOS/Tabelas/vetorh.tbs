DECLARE
	l_DataZero DATE;
	l_DatIniHis DATE;
	l_DatTerHis DATE;
	l_DataInicioSST DATE;
	l_EstCarStr VARCHAR(4);
	l_CodCarStr   R024HDI.CODCAR%TYPE;
	l_Where VARCHAR(200);
	l_NumEmp   R030DES.NumEmp%TYPE;
	l_Json VARCHAR(2000);
	
	CURSOR C_R030DES IS SELECT NumEmp, IniSST 
	FROM R030DES 
	WHERE IniSST > l_DataZero AND (l_DatTerHis > IniSST OR l_DatTerHis = l_DataZero) 
	ORDER BY NumEmp;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DatIniHis := :NEW.DatHis;
	
	l_EstCarStr := CONVERT(NUMBER_TO_CHAR, :NEW.EstCar);
	l_CodCarStr := :NEW.CodCar;
	l_Where := 'ESTCAR = ' || l_EstCarStr || ' AND CODCAR = ''' || l_CodCarStr || '''';
  	SP_PROXHIST_NPER('DATHIS', 'R024HDE', l_Where, l_DatIniHis, l_DatTerHis OUT);
  	
  	SP_CONCATENAR_NUM('ESTCAR', :NEW.EstCar, l_Json OUT);
  	SP_CONCATENAR_DES('CODCAR', :NEW.CodCar, l_Json OUT);
  	SP_CONCATENAR_DAT('DATHIS', :NEW.DatHis, l_Json OUT);
  	SP_CONCATENAR_NUM('SEQIDC', :NEW.SeqIdc, l_Json OUT);
	
  	FOREACH C_R030DES INTO l_NumEmp, l_DataInicioSST
  	LOOP
		IF (l_DatIniHis < l_DataInicioSST) THEN
			l_DatIniHis := l_DataInicioSST;
		END IF;

		SP_E_SOCIAL_SM('S-2240', 'R024HDI', 'N', 'I', l_DatIniHis, l_DatTerHis, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DatIniHis, 0, 'R024HDI_EI');
  	END LOOP;
END␀/Ñ␀␀		SENIOR;0x␀␀

TRIGGER R024HDI_EU AFTER UPDATE ON R024HDI FOR EACH ROW
DECLARE
	l_Alterou BOOLEAN;
	l_DataZero DATE;
	l_DatIniHis DATE;
	l_DatTerHis DATE;
	l_DataInicioSST DATE;
	l_EstCarStr VARCHAR(4);
	l_CodCarStr   R024HDI.CODCAR%TYPE;
	l_Where VARCHAR(200);
	l_NumEmp   R030DES.NumEmp%TYPE;
	l_Json VARCHAR(2000);
	l_JsonAlteracao VARCHAR2(2000);
	
	CURSOR C_R030DES IS SELECT NumEmp, IniSST 
	FROM R030DES 
	WHERE IniSST > l_DataZero AND (l_DatTerHis > IniSST OR l_DatTerHis = l_DataZero) 
	ORDER BY NumEmp;
BEGIN
	SP_VALUPDATE_DES(:OLD.TexIte, :NEW.TexIte, l_Alterou OUT);
	IF (l_Alterou = TRUE) THEN
		l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
		l_DatIniHis := :NEW.DatHis;
		l_JsonAlteracao := '{"TEXITE":{"NEW":"Descrição detalhada do item do Cargo alterada.","OLD":"Descrição detalhada do item do Cargo alterada."}}';
		
		l_EstCarStr := CONVERT(NUMBER_TO_CHAR, :NEW.EstCar);
		l_CodCarStr := :NEW.CodCar;
		l_Where := 'ESTCAR = ' || l_EstCarStr || ' AND CODCAR = ''' || l_CodCarStr || '''';
	  	SP_PROXHIST_NPER('DATHIS', 'R024HDE', l_Where, l_DatIniHis, l_DatTerHis OUT);
	  	
	  	SP_CONCATENAR_NUM('ESTCAR', :NEW.EstCar, l_Json OUT);
	  	SP_CONCATENAR_DES('CODCAR', :NEW.CodCar, l_Json OUT);
	  	SP_CONCATENAR_DAT('DATHIS', :NEW.DatHis, l_Json OUT);
	  	SP_CONCATENAR_NUM('SEQIDC', :NEW.SeqIdc, l_Json OUT);
	  	
	  	FOREACH C_R030DES INTO l_NumEmp, l_DataInicioSST
	  	LOOP
			IF (l_DatIniHis < l_DataInicioSST) THEN
				l_DatIniHis := l_DataInicioSST;
			END IF;
	
			SP_E_SOCIAL_SM('S-2240', 'R024HDI', 'N', 'A', l_DatIniHis, l_DatTerHis, l_NumEmp, 0, 0, l_Json, l_JsonAlteracao, 0, NULL, l_DatIniHis, 0, 'R024HDI_EU');
	  	END LOOP;
  	END IF;
END␀-Ñ␀␀		SENIOR;0)␀␀

TRIGGER R024HDI_ED AFTER DELETE ON R024HDI FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DatIniHis DATE;
	l_DatTerHis DATE;
	l_DataInicioSST DATE;
	l_EstCarStr VARCHAR(4);
	l_CodCarStr   R024HDI.CODCAR%TYPE;
	l_Where VARCHAR(200);
	l_NumEmp   R030DES.NumEmp%TYPE;
	l_Json VARCHAR(2000);
	
	CURSOR C_R030DES IS SELECT NumEmp, IniSST 
	FROM R030DES 
	WHERE IniSST > l_DataZero AND (l_DatTerHis > IniSST OR l_DatTerHis = l_DataZero) 
	ORDER BY NumEmp;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DatIniHis := :OLD.DatHis;
	
	l_EstCarStr := CONVERT(NUMBER_TO_CHAR, :OLD.EstCar);
	l_CodCarStr := :OLD.CodCar;
	l_Where := 'ESTCAR = ' || l_EstCarStr || ' AND CODCAR = ''' || l_CodCarStr || '''';
  	SP_PROXHIST_NPER('DATHIS', 'R024HDE', l_Where, l_DatIniHis, l_DatTerHis OUT);
  	
  	SP_CONCATENAR_NUM('ESTCAR', :OLD.EstCar, l_Json OUT);
  	SP_CONCATENAR_DES('CODCAR', :OLD.CodCar, l_Json OUT);
  	SP_CONCATENAR_DAT('DATHIS', :OLD.DatHis, l_Json OUT);
  	SP_CONCATENAR_NUM('SEQIDC', :OLD.SeqIdc, l_Json OUT);
	
  	FOREACH C_R030DES INTO l_NumEmp, l_DataInicioSST
  	LOOP
		IF (l_DatIniHis < l_DataInicioSST) THEN
			l_DatIniHis := l_DataInicioSST;
		END IF;

		SP_E_SOCIAL_SM('S-2240', 'R024HDI', 'N', 'E', l_DatIniHis, l_DatTerHis, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DatIniHis, 0, 'R024HDI_ED');
  	END LOOP;
END␀␀␀ï'␀␀␀␀␀␀0Ñ␀␀µ,±␀	Ôÿ3␀␀␀␀␀7=:v:vq␀Æÿ␀␀1Ñ␀␀␀«T(Ôÿ3␀␀␀␀␀¸W°V°V1␀␀ÿ␀␀ÿ␀3v±␀Àì␀␀␀␀␀±><v<vq␀Æÿ␀␀ÿ␀␀␀␀0␀␀Mv␀␀␀␀2Ñ␀␀f´␀	Ôÿ!␀␀␀␀␀÷<ïe»fr␀Æÿ␀␀)Ñ␀␀␀0,4	Ôÿ!␀␀␀␀␀ÿ?µ'µ'}␀␀ÿ␀␀Ñ␀␀␀EÑ␀	Ôÿ!␀␀␀␀␀>K¢G¢GqC␀êÿ␀␀ÿ␀1f´␀Ôÿ!␀␀␀␀␀äfşeÍfr␀Æÿ␀␀%Û␀␀␀*bÔÿ!␀␀␀␀␀Í*•*Ì*g␀␀ÿ␀␀ÿ␀Ğ¦␀␀bÔÿ!␀␀␀␀␀#¯␀␀­␀␀Ê®␀␀g␀␀ÿ␀␀ÿ␀œ*bÔÿ!␀␀␀␀␀Ê*”*É*g␀␀ÿ␀␀ÿ␀Í¦␀␀bÔÿ!␀␀␀␀␀!¯␀␀­␀␀Å®␀␀g␀␀ÿ␀␀ÿ␀*bÔÿ!␀␀␀␀␀È*–*Ï*g␀␀ÿ␀␀ÿ␀Ñ¦␀␀bÔÿ!␀␀␀␀␀Í®␀␀­␀␀Í®␀␀g␀␀ÿ␀␀ÿ␀0␀ªÔÿ!␀␀␀␀␀k␀=␀k␀n␀Æÿ␀␀ÿ␀	t­␀Ôÿ!␀␀␀␀␀otl’␀␀Qt3)␀␀Æÿ␀␀òĞ␀␀␀y␀ÅÔÿ!␀␀␀␀␀X␀?␀W␀c␀␀␀ÿ␀␀ÿ␀kj­␀Ôÿ!␀␀␀␀␀vjajvjp␀Æÿ␀␀ÿ␀JÊ␀␀´␀Ôÿ!␀␀␀␀␀YÌ␀␀²É␀␀õË␀␀r␀Æÿ␀␀ÿ␀␀␀␀0;1;2␀␀óv␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀3Ñ␀␀¼,±␀	Ôÿ1␀␀␀␀␀8=:v:vq␀Æÿ␀␀4Ñ␀␀␀°T(Ôÿ1␀␀␀␀␀¹W°V°V1␀␀ÿ␀␀ÿ␀␀␀␀0␀␀Nv␀␀␀5Ñ␀␀f´␀	€␀␀␀␀␀␀÷<ïe»fr␀Æÿ␀␀)Ñ␀␀␀mı␀␀·␀	€␀␀␀␀␀␀Æÿ␀␀ü␀␀xş␀␀s␀Æÿ␀␀6Ñ␀␀␀´Tc€␀␀␀␀␀␀¬Y°V°V`␀␀ÿ␀␀ÿ␀4T=€€␀␀␀␀␀␀¶␀␀jW†Xc␀␀␀ÿ␀␀ÿS=€␀␀␀␀␀␀·␀␀abc␀␀␀ÿ␀␀ÿ␀␀␀␀0;1␀␀ßf␀␀␀␀␀␀7Ñ␀␀f´␀	€€␀␀␀␀␀␀÷<ïe»fr␀Æÿ␀␀)Ñ␀␀␀0,4	€€␀␀␀␀␀␀ÿ?µ'µ'}␀␀ÿ␀␀Ñ␀␀␀mı␀␀·␀	€€␀␀␀␀␀␀Á@—•␀␀•␀␀s␀Æÿ␀␀6Ñ␀␀␀p␀e€€␀␀␀␀␀␀’␀°V°V␀␀ÿ␀␀ÿ␀␀␀␀0;1;2␀␀ÆX␀␀␀␀␀8Ñ␀␀f´␀	Ôï1␀␀␀␀␀÷<ïe»fr␀Æÿ␀␀)Ñ␀␀␀¿¦␀␀­␀	Ôï1␀␀␀␀␀¯␀␀±®␀␀±®␀␀p␀Æÿ␀␀ÿ␀ùTÔï1␀␀␀␀␀%Y°V°V␀␀ÿ␀␀ÿ␀Ã¬␀␀­␀Ôï1␀␀␀␀␀#Ë␀␀ÓÊ␀␀"Ë␀␀p␀Æÿ␀␀ÿ␀␀␀␀0;1␀␀àf␀␀␀␀9Ñ␀␀f´␀	€ƒ␀␀␀␀␀=ïe»fr␀Æÿ␀␀)Ñ␀␀␀0,4	€ƒ␀␀␀␀␀ÿ?µ'µ'}␀␀ÿ␀␀Ñ␀␀␀˜EÑ␀	€ƒ␀␀␀␀␀?M“H”HqCş‡␀êÿ␀␀ÿ␀€È␀␀­