PROCEDURE SP_APUCOL(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_RETORNO OUT CHAR(1))
 IS

l_apupfs       CHAR(1);
BEGIN
  BEGIN
    SELECT APUPFS INTO l_apupfs
    FROM R034FUN
    WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
  EXCEPTION
    WHEN OTHERS THEN
      l_apupfs := 'E';
  END;

  IF (l_apupfs IS NULL) THEN
      l_apupfs := 'E';
  END IF;

  p_retorno := l_apupfs;
END		SENIOR;21
