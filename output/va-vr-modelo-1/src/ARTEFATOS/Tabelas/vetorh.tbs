TRIGGER R097INT_ED AFTER DELETE ON R097INT FOR EACH ROW
DECLARE
  l_online          BOOLEAN;
  l_crafis          NUMBER(12);
  l_hora_atual      NUMBER(4);
  l_data_zero       DATE;
  l_data_atual      DATE;
  l_IDTPES          VARCHAR(23);
  l_data            CHAR(8);
  l_hora            CHAR(4);
  l_chave           VARCHAR2(35);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN

    l_data_zero  := '31/12/1900,00:00:00';
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_data_atual := CURDATE();

    /*Se for um histórico válido*/
    IF ((:OLD.DATFIM > l_data_atual) OR
        ((:OLD.DATFIM = l_data_atual) AND (:OLD.HORFIM >= l_hora_atual)) OR
        (:OLD.DATFIM = l_data_zero)) THEN

        IF   :OLD.NUMCRA > 0 THEN
            /*Bloqueia o crachá do paciente*/
            AtuSitCra('1', :OLD.NUMCRA);
        END IF;
    END IF;
  END IF;

  SP_RETIDTPES(NULL, 9, NULL, NULL, NULL, NULL, :OLD.PROPAC, l_IDTPES OUT);
  SP_DATSTR(:OLD.DATINI,'DDMMYYYY',l_data OUT);
  SP_INTSTR(:OLD.HORINI,'9999',l_hora OUT);
