/* INSERT (NEW) */
TRIGGER R008EVC_EI AFTER INSERT ON R008EVC FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Eventos (Tabela: R008EVC)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 100;     /* Eventos (Tabela: R008EVC)*/
  l_codtpa := 347;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008EVC_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAB', CONVERT(NUMBER_TO_CHAR, :NEW.CODTAB));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CODEVE));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R008EVC_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESEVE', :NEW.DESEVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CRTEVE', :NEW.CRTEVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCRT', CONVERT(NUMBER_TO_CHAR, :NEW.CODCRT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORUTI', :NEW.HORUTI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RGREVE', CONVERT(NUMBER_TO_CHAR, :NEW.RGREVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RGRESP', CONVERT(NUMBER_TO_CHAR, :NEW.RGRESP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TIPEVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NATEVE', CONVERT(NUMBER_TO_CHAR, :NEW.NATEVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SINSEL', :NEW.SINSEL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSEL', CONVERT(NUMBER_TO_CHAR, :NEW.CODSEL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALCAL', CONVERT(NUMBER_TO_CHAR, :NEW.VALCAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALTET', CONVERT(NUMBER_TO_CHAR, :NEW.VALTET));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCLC', CONVERT(NUMBER_TO_CHAR, :NEW.CODCLC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ALFAEV', :NEW.ALFAEV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPINF', :NEW.TIPINF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIMNOR', :NEW.DIMNOR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'GEREVE', CONVERT(NUMBER_TO_CHAR, :NEW.GEREVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRJEVE', :NEW.PRJEVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PEREVE', :NEW.PEREVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSIN', CONVERT(NUMBER_TO_CHAR, :NEW.CODSIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RATEVE', :NEW.RATEVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPRAT', CONVERT(NUMBER_TO_CHAR, :NEW.TIPRAT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REMCAG', :NEW.REMCAG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EVEDPO', CONVERT(NUMBER_TO_CHAR, :NEW.EVEDPO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EVEDNE', CONVERT(NUMBER_TO_CHAR, :NEW.EVEDNE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ARRVAL', CONVERT(NUMBER_TO_CHAR, :NEW.ARRVAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ARRPRE', CONVERT(NUMBER_TO_CHAR, :NEW.ARRPRE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ARRESP', CONVERT(NUMBER_TO_CHAR, :NEW.ARRESP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REMPAT', :NEW.REMPAT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RUBHOM', CONVERT(NUMBER_TO_CHAR, :NEW.RUBHOM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSEVE', :NEW.OBSEVE);
        SP_DATSTR(:NEW.INIVAL, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIVAL', l_datTemp);
        SP_DATSTR(:NEW.FIMVAL, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMVAL', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESCOM', :NEW.DESCOM);
      END;
  END IF; 
END␀Ï␀␀	SENIOR;0L

TRIGGER R008EVC_SU AFTER UPDATE ON R008EVC

BEGIN
RH_250ALT(18);
END␀Ï␀␀		SENIOR;0a+␀␀


TRIGGER R008EVC_EU AFTER UPDATE ON R008EVC FOR EACH ROW 
DECLARE
  l_Alterou BOOLEAN;
  l_Valido BOOLEAN;
  l_Valor VARCHAR2(2000);
  l_NumEmp NUMBER;
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
	CURSOR c_r030emp IS SELECT NUMEMP FROM R030EMP;
BEGIN
  /* eSocial */
  l_Alterou := FALSE;
  l_Valor := '';

  SP_VALUPDATE_DAT(:OLD.FIMVAL, :NEW.FIMVAL, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;

  IF (l_Alterou = TRUE) THEN
    SP_CONCATENAR_NUM('CODTAB', :NEW.CODTAB, l_Valor OUT);
    SP_CONCATENAR_NUM('CODEVE', :NEW.CODEVE, l_Valor OUT);
  
    FOREACH c_r030emp INTO l_NumEmp
    LOOP
      SP_E_SOCIAL('S-1010', 'R008EVC', 'T', 'A', NULL, NULL, l_NumEmp, 0, 0, l_Valor, '', 0, :NEW.FIMVAL, NULL, 0, 'R008EVC_SI');
    END LOOP;	
  END IF;
  /* eSocial */
  
    /* Geração de logs Eventos (Tabela: R008EVC)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 100;     /* Eventos (Tabela: R008EVC)*/
  l_codtpa := 348;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.CodTab <> :NEW.CodTab)
   OR (:OLD.CodEve <> :NEW.CodEve)
   OR (:OLD.DesEve <> :NEW.DesEve)
   OR (:OLD.CrtEve <> :NEW.CrtEve)
   OR (:OLD.CodCrt <> :NEW.CodCrt)
   OR (:OLD.HorUti <> :NEW.HorUti)
   OR (:OLD.RgrEve <> :NEW.RgrEve)
   OR (:OLD.RgrEsp <> :NEW.RgrEsp)
   OR (:OLD.TipEve <> :NEW.TipEve)
   OR (:OLD.NatEve <> :NEW.NatEve)
   OR (:OLD.SinSel <> :NEW.SinSel)
   OR (:OLD.CodSel <> :NEW.CodSel)
   OR (:OLD.ValCal <> :NEW.ValCal)
   OR (:OLD.ValTet <> :NEW.ValTet)
   OR (:OLD.CodClc <> :NEW.CodClc)
   OR (:OLD.AlfaEv <> :NEW.AlfaEv)
   OR (:OLD.TipInf <> :NEW.TipInf)
   OR (:OLD.DimNor <> :NEW.DimNor)
   OR (:OLD.GerEve <> :NEW.GerEve)
   OR (:OLD.PrjEve <> :NEW.PrjEve)
   OR (:OLD.PerEve <> :NEW.PerEve)
   OR (:OLD.CodSin <> :NEW.CodSin)
   OR (:OLD.RatEve <> :NEW.RatEve)
   OR (:OLD.TipRat <> :NEW.TipRat)
   OR (:OLD.RemCag <> :NEW.RemCag)
   OR (:OLD.EveDpo <> :NEW.EveDpo)
   OR (:OLD.EveDne <> :NEW.EveDne)
   OR (:OLD.ArrVal <> :NEW.ArrVal)
   OR (:OLD.ArrPre <> :NEW.ArrPre)
   OR (:OLD.ArrEsp <> :NEW.ArrEsp)
   OR (:OLD.RemPat <> :NEW.RemPat)
   OR (:OLD.RubHom <> :NEW.RubHom)
   OR (:OLD.ObsEve <> :NEW.ObsEve)
   OR (:OLD.IniVal <> :NEW.IniVal)
   OR (:OLD.FimVal <> :NEW.FimVal)
   OR (:OLD.DesCom <> :NEW.DesCom)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008EVC_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAB', CONVERT(NUMBER_TO_CHAR, :OLD.CODTAB));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :OLD.CODEVE));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R008EVC_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDESEVE', :OLD.DESEVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDESEVE', :NEW.DESEVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCRTEVE', :OLD.CRTEVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCRTEVE', :NEW.CRTEVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCRT', CONVERT(NUMBER_TO_CHAR, :OLD.CODCRT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCRT', CONVERT(NUMBER_TO_CHAR, :NEW.CODCRT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORUTI', :OLD.HORUTI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORUTI', :NEW.HORUTI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDRGREVE', CONVERT(NUMBER_TO_CHAR, :OLD.RGREVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWRGREVE', CONVERT(NUMBER_TO_CHAR, :NEW.RGREVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDRGRESP', CONVERT(NUMBER_TO_CHAR, :OLD.RGRESP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWRGRESP', CONVERT(NUMBER_TO_CHAR, :NEW.RGRESP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPEVE', CONVERT(NUMBER_TO_CHAR, :OLD.TIPEVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TIPEVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNATEVE', CONVERT(NUMBER_TO_CHAR, :OLD.NATEVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNATEVE', CONVERT(NUMBER_TO_CHAR, :NEW.NATEVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSINSEL', :OLD.SINSEL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSINSEL', :NEW.SINSEL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODSEL', CONVERT(NUMBER_TO_CHAR, :OLD.CODSEL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODSEL', CONVERT(NUMBER_TO_CHAR, :NEW.CODSEL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVALCAL', CONVERT(NUMBER_TO_CHAR, :OLD.VALCAL));
