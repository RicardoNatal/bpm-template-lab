/* INSERT (NEW) */
TRIGGER R016ORN_EI AFTER INSERT ON R016ORN FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  xCodLoc 		   R016HIE.CODLOC%TYPE;
BEGIN

  /* Geração de logs LocaisOrganograma*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 71;     /* LocaisOrganograma*/
  l_codtpa := 253;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R016ORN_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :NEW.TABORG));
        RH_RET_CODLOC(:NEW.TABORG,:NEW.NUMLOC, :NEW.DATCRI, xCodLoc OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', xCodLoc);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R016ORN_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMLOC', :NEW.NOMLOC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRAT', CONVERT(NUMBER_TO_CHAR, :NEW.CODRAT));
        SP_DATSTR(:NEW.DATCRI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATCRI', l_datTemp);
        SP_DATSTR(:NEW.DATEXT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATEXT', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONPPP', :NEW.CONPPP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABFED', CONVERT(NUMBER_TO_CHAR, :NEW.TABFED));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABFEN', CONVERT(NUMBER_TO_CHAR, :NEW.TABFEN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FEROFD', CONVERT(NUMBER_TO_CHAR, :NEW.FEROFD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FEROFN', CONVERT(NUMBER_TO_CHAR, :NEW.FEROFN));
      END;
  END IF; 
END␀dĞ␀␀	SENIOR;0\

TRIGGER R016ORN_SU AFTER UPDATE ON R016ORN

BEGIN
RH_250ALT(26);
RH_250ALT(41);
END␀`Ğ␀␀		SENIOR;0+␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R016ORN_EU AFTER UPDATE ON R016ORN FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  xCodLoc 		   R016HIE.CODLOC%TYPE;
  l_taborg_str   VARCHAR2(4);
  l_numloc_str   VARCHAR2(9);
  l_valstr       VARCHAR2(75);
BEGIN

  /* Geração de logs LocaisOrganograma*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 71;     /* LocaisOrganograma*/
  l_codtpa := 254;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);  

  IF ((:OLD.TabOrg <> :NEW.TabOrg)
   OR (:OLD.NumLoc <> :NEW.NumLoc)
   OR (:OLD.NomLoc <> :NEW.NomLoc)
   OR (:OLD.CodRat <> :NEW.CodRat)
   OR (:OLD.DatCri <> :NEW.DatCri)
   OR (:OLD.DatExt <> :NEW.DatExt)
   OR (:OLD.ConPPP <> :NEW.ConPPP)
   OR (:OLD.TabFeD <> :NEW.TabFeD)
   OR (:OLD.TabFeN <> :NEW.TabFeN)
   OR (:OLD.FerOfD <> :NEW.FerOfD)
   OR (:OLD.FerOfN <> :NEW.FerOfN)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R016ORN_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :OLD.TABORG));
        RH_RET_CODLOC(:OLD.TABORG,:OLD.NUMLOC, :OLD.DATCRI, xCodLoc OUT);        
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', xCodLoc);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R016ORN_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOMLOC', :OLD.NOMLOC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNOMLOC', :NEW.NOMLOC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODRAT', CONVERT(NUMBER_TO_CHAR, :OLD.CODRAT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODRAT', CONVERT(NUMBER_TO_CHAR, :NEW.CODRAT));
        SP_DATSTR(:OLD.DATCRI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATCRI', l_datTemp);
        SP_DATSTR(:NEW.DATCRI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATCRI', l_datTemp);
        SP_DATSTR(:OLD.DATEXT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATEXT', l_datTemp);
        SP_DATSTR(:NEW.DATEXT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATEXT', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONPPP', :OLD.CONPPP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONPPP', :NEW.CONPPP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTABFED', CONVERT(NUMBER_TO_CHAR, :OLD.TABFED));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTABFED', CONVERT(NUMBER_TO_CHAR, :NEW.TABFED));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTABFEN', CONVERT(NUMBER_TO_CHAR, :OLD.TABFEN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTABFEN', CONVERT(NUMBER_TO_CHAR, :NEW.TABFEN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFEROFD', CONVERT(NUMBER_TO_CHAR, :OLD.FEROFD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFEROFD', CONVERT(NUMBER_TO_CHAR, :NEW.FEROFD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFEROFN', CONVERT(NUMBER_TO_CHAR, :OLD.FEROFN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFEROFN', CONVERT(NUMBER_TO_CHAR, :NEW.FEROFN));
      END;
    END IF; 
  END IF;

  /* Pendência SAMSenior */
  IF (:NEW.NOMLOC <> :OLD.NOMLOC) THEN
    SP_INTSTR(:NEW.TABORG, '9999', l_taborg_str OUT);
    SP_INTSTR(:NEW.NUMLOC, '999999999', l_numloc_str OUT);
    l_valstr := '2E' || l_taborg_str || l_numloc_str || :OLD.NOMLOC;
    SP_SAM_PENDENCIES(35, 2, l_valstr);
  END IF;
END␀bĞ␀␀	SENIOR;0\

TRIGGER R016ORN_SD AFTER DELETE ON R016ORN

BEGIN
RH_250ALT(26);
RH_250ALT(41);
END␀^Ğ␀␀		SENIOR;0a	␀␀

/* DELETE (OLD) */
TRIGGER R016ORN_ED AFTER DELETE ON R016ORN FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  xCodLoc 		   R016HIE.CODLOC%TYPE;
BEGIN

  /* Geração de logs LocaisOrganograma*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 71;     /* LocaisOrganograma*/
  l_codtpa := 253;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R016ORN_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :OLD.TABORG));
        RH_RET_CODLOC(:OLD.TABORG,:OLD.NUMLOC, :OLD.DATCRI, xCodLoc OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', xCodLoc);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R016ORN_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMLOC', :OLD.NOMLOC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRAT', CONVERT(NUMBER_TO_CHAR, :OLD.CODRAT));
        SP_DATSTR(:OLD.DATCRI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATCRI', l_datTemp);
        SP_DATSTR(:OLD.DATEXT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATEXT', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONPPP', :OLD.CONPPP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABFED', CONVERT(NUMBER_TO_CHAR, :OLD.TABFED));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABFEN', CONVERT(NUMBER_TO_CHAR, :OLD.TABFEN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FEROFD', CONVERT(NUMBER_TO_CHAR, :OLD.FEROFD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FEROFN', CONVERT(NUMBER_TO_CHAR, :OLD.FEROFN));
      END;
  END IF; 
