        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDARECPL', CONVERT(NUMBER_TO_CHAR,:OLD.ARECPL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWARECPL', CONVERT(NUMBER_TO_CHAR,:NEW.ARECPL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDRECCPL', CONVERT(NUMBER_TO_CHAR,:OLD.RECCPL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWRECCPL', CONVERT(NUMBER_TO_CHAR,:NEW.RECCPL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNATCPL', CONVERT(NUMBER_TO_CHAR,:OLD.NATCPL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNATCPL', CONVERT(NUMBER_TO_CHAR,:NEW.NATCPL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSCPL', :OLD.OBSCPL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSCPL', :NEW.OBSCPL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDATEPRE', CONVERT(NUMBER_TO_CHAR,:OLD.ATEPRE));
