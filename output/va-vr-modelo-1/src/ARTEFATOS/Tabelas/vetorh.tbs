    END IF;
    
    IF (l_Alterou = TRUE) THEN
      SP_CONCATENAR_NUM('CODPRO', :NEW.CODPRO, l_Valor OUT);
      SP_CONCATENAR_DAT('CMPPAG', :NEW.CMPPAG, l_Valor OUT);
      
      SP_E_SOCIAL('S-2501', 'R346PBC', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, l_JsonCamposAlterados, 0, NULL, :NEW.CMPPAG, 0, 'R346PBC_EU');
