␀␀0ôâ␀␀		SENIOR;0a␀␀TRIGGER R152CRE_EI AFTER INSERT ON R152CRE FOR EACH ROW
BEGIN
  /* Após vinculado o registro de origem à pendência, sinalizo para ser tratada */
  /* Se é uma pendência de retificação ou exclusão e não tem o protocolo de origem, não deve ser sinalizada para tratamento */
  IF :NEW.PROORI IS NULL THEN
    BEGIN
      UPDATE R152PEN SET STAPEN = 1 WHERE CODPEN = :NEW.CODPEN AND TIPOPE <> 'R';
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;
  ELSE
    BEGIN
      UPDATE R152PEN SET STAPEN = 1 WHERE CODPEN = :NEW.CODPEN;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;
  END IF;
END␀␀␀T␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀õâ␀␀--«␀	␀␀␀␀␀␀BJ@K@l␀	Æÿ␀␀ÿ␀ZÂ␀␀	␀␀␀␀␀␀}Â␀␀\Â␀␀\Â␀␀\␀␀␀ÿ␀␀õÜ␀␀␀EÑ␀	␀␀␀␀␀␀bL¢G¢GqC␀êÿ␀␀ÿ␀¤w·␀	␀␀␀␀␀␀²yˆxˆxì*␀␀Æÿ␀␀ÿ␀L–␀␀W␀␀␀␀␀␀R–␀␀L–␀␀L–␀␀S␀␀ÿ␀␀ÿ␀@Æ␀␀N␀␀␀␀␀␀ŠÇ␀␀yÇ␀␀†Ç␀␀M␀␀ÿ␀␀ÿ␀␀␀␀0öâ␀␀		SENIOR;0␀␀TRIGGER R152CRV_EI AFTER INSERT ON R152CRV FOR EACH ROW
