ş␀␀PROCEDURE SP_ATUALI(P_NUMSMA NUMBER(12),P_NUMCRA NUMBER(12),P_NUMCPO CHAR(2),P_INFORM CHAR(56))
 IS

  l_numserial         CHAR(10);
  l_icard             CHAR(12);
  l_numcpo            CHAR(2);
  l_inform            VARCHAR(56);
  l_ideaux            CHAR(12);
  l_atuiden           CHAR(14);
  l_identif           CHAR(14);
  l_datatu            DATE;
  l_horaux            NUMBER(2);
  l_minaux            NUMBER(2);
  l_segaux            NUMBER(2);
  l_horstr            CHAR(2);
  l_minstr            CHAR(2);
  l_segstr            CHAR(2);
  l_milseg            NUMBER(3);
  l_milstr            CHAR(2);
  l_dataux            CHAR(6);
  l_data_atual        DATE;
  l_dta_msg_Date      DATE;
  l_comando           VARCHAR(1024);
  l_usutel            VARCHAR(31);
  l_numten            NUMBER(2); /* NÚMERO DE TENTATIVAS AO OCORRER ERRO */
  l_generate          BOOLEAN; /* INSERIU A PENDÊNCIA */
  l_numser            VARCHAR(12);
  l_icardR            VARCHAR(12);
BEGIN
    l_numten   := 10; /* 10 tentativas de inserção da pendência, caso contrário será lançado uma exceção */
    l_generate := FALSE;

    SP_USUTEL(l_usutel OUT);
    /*Formata Campos*/
    SP_INTSTR(p_numsma,'9999999999',l_numserial OUT);
    SP_RETICARD(NULL, p_numcra, l_icard OUT , l_icardR OUT, l_numser OUT);
    l_numcpo := p_numcpo;


    /* ESTE LOOP IRÁ TENTAR INCLUIR A PENDÊNCIA, CASO ELA DEE ERRO, SERÁ TENTADO NOVAMENTE ATÉ ESGOTAR OS Nº DE TENTATIVAS */
    LOOP

        IF (l_generate = TRUE) THEN
            EXIT;
        END IF;

        IF (l_numten = 0) THEN
            RAISERROR 103 'SP_Atuali: Erro ao gerar pendência. Excedeu o número de tentativas.';
        ELSE
            l_numten := l_numten - 1;
        END IF;

        l_generate := TRUE;

        l_inform := p_inform;

        l_datatu := CURDATE();

        SP_DATSTR(l_datatu,'DDMMYY',l_dataux OUT);
        l_dataux := SUBSTRING(l_dataux,5,2)||SUBSTRING(l_dataux,3,2)||SUBSTRING(l_dataux,1,2);

        l_horaux := HOUR(CURTIME());
        SP_INTSTR(l_horaux,'99',l_horstr OUT);

        l_minaux := MINUTE(CURTIME());
        SP_INTSTR(l_minaux,'99',l_minstr OUT);

        l_segaux := SECOND(CURTIME());
        SP_INTSTR(l_segaux,'99',l_segstr OUT);


        l_ideaux := l_dataux||l_horstr||l_minstr||l_segstr;
        /*Obtem o Máximo Identificador que foi inserido no mesmo segundo*/
        SELECT MAX(IDENTI) MAXIMO INTO l_atuiden FROM R600PEN WHERE IDENTI LIKE l_ideaux||'%';
        /*Obtém o milésimo atual*/
        IF ((l_atuiden IS NULL) OR (l_atuiden = ' ')) THEN
            l_milseg:= 0;
        ELSE
            l_milseg:= CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_atuiden,13,2)));
        END IF;

        /*Loop para controle de Violação de chave.*/
        LOOP
           /*Como são 9 pendências que serão geradas, se o milésimo atual for maior que 90,*/
           /*espera o próximo segundo*/
           IF l_milseg <= 90 THEN
              EXIT;
           END IF;

           l_datatu := CURDATE();

           SP_DATSTR(l_datatu,'DDMMYY',l_dataux OUT);
           l_dataux := SUBSTRING(l_dataux,5,2)||SUBSTRING(l_dataux,3,2)||SUBSTRING(l_dataux,1,2);

           l_horaux := HOUR(CURTIME());
           SP_INTSTR(l_horaux,'99',l_horstr OUT);

           l_minaux := MINUTE(CURTIME());
           SP_INTSTR(l_minaux,'99',l_minstr OUT);

           l_segaux := SECOND(CURTIME());
           SP_INTSTR(l_segaux,'99',l_segstr OUT);

           l_ideaux := l_dataux||l_horstr||l_minstr||l_segstr;
           /*Obtem novamente o milésimo*/
           SELECT MAX(IDENTI) MAXIMO INTO l_atuiden FROM R600PEN WHERE IDENTI LIKE l_ideaux||'%';

           IF ((l_atuiden IS NULL) OR (l_atuiden = ' ')) THEN
               l_milseg:= 0;
           ELSE
               l_milseg:= CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_atuiden,13,2)));
           END IF;
        END LOOP;
        /*Monta o Identificador*/
        l_milseg:= l_milseg + 1;
        SP_INTSTR(l_milseg,'99',l_milstr OUT);
        l_identif := l_ideaux||l_milstr;

        /*Tratamento especial para a pendência de mensagem*/
        IF (p_numcpo = 20) THEN
            /*Data diferente de zerada, verifica se é maior do que a data atual*/
            IF (l_inform <> '      ') THEN
                BEGIN
                  l_data_atual := CURDATE();
                  /*CONVERTE CARACTERE EM DATA*/
                  l_comando := SUBSTRING(l_inform,1,2) || '/' || SUBSTRING(l_inform,3,2) ||'/'||SUBSTRING(l_inform,5,2);
                  SP_STRTODATE(l_comando, 'DD/MM/AA', l_dta_msg_date OUT);
                  l_comando := '';
                  IF ( (l_data_atual<l_dta_msg_date) OR (l_inform = '311250') ) THEN
                    l_inform := '999999';
                  END IF;
                EXCEPTION
                  WHEN OTHERS THEN
                    NULL;
                END;
            END IF;                                                                       
        END IF;

        /*Tabela de Log Senior das pendências geradas para a telemática*/
        BEGIN
            INSERT INTO R600PEN (IdeNti, NumFis, NumCra, NumCpo, InfOrm, StaPen) VALUES
                                (l_identif, l_numserial, l_icard, l_numcpo, l_inform, '1');
        EXCEPTION
          WHEN OTHERS THEN
            l_generate := FALSE;
        END;
        
        IF (l_generate = TRUE) THEN
            /* INSERE PENDÊNCIA NA ATUALI, ATRAVÉS DE COMANDO DINÂMICO */
            l_comando := 'INSERT INTO '||l_usutel||'ATUALI (IDENTIF,NUMSERIAL,ICARD,NUMCPO,INFORM) ';
            l_comando := l_comando||' VALUES ('''||l_identif||''','''||l_numserial||''','''||l_icard||''','''||l_numcpo||''','''||l_inform||''')';
            SP_CMDTSI(l_comando);
        END IF;

    END LOOP;
END		SENIOR;23:SP_USUTEL
SP_INTSTR
SP_DATSTR
SP_STRTODATE
SP_CMDTSI
␀␀PROCEDURE SP_ATUALI(P_NUMSMA NUMBER(12),P_NUMCRA NUMBER(12),P_NUMCPO CHAR(2),P_INFORM CHAR(56))
 IS

l_numserial         CHAR(10);
