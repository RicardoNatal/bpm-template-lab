/*
 * Retorna as faixas de créditos para local físico zero(funcionamento global de créditos) para Alunos
 */
PROCEDURE SP_RETCAA(P_NUMMAT VARCHAR2(15),P_CREFX1 OUT CHAR(2),P_FX1 OUT CHAR(8),P_CREFX2 OUT CHAR(2),P_FX2 OUT CHAR(8),P_CREFX3 OUT CHAR(2),P_FX3 OUT CHAR(8),P_CREFX4 OUT CHAR(2),P_FX4 OUT CHAR(8),P_CREFX5 OUT CHAR(2),P_FX5 OUT CHAR(8),P_CREFX6 OUT CHAR(2),P_FX6 OUT CHAR(8))
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_verplf      NUMBER(3);
  l_codplf      NUMBER(7);
  l_inifai      CHAR(4);
  l_fimfai      CHAR(4);
  l_faixa       CHAR(8);
  l_salatu      CHAR(2);
  l_crefx1      CHAR(2);
  l_fx1         CHAR(8);
  l_crefx2      CHAR(2);
  l_fx2         CHAR(8);
  l_crefx3      CHAR(2);
  l_fx3         CHAR(8);
  l_crefx4      CHAR(2);
  l_fx4         CHAR(8);
  l_crefx5      CHAR(2);
