				IF (l_r034EDP.VERAFA = 2) THEN /* VALOR VEM DO POSTO ADICIONAL. RESTAURO O VALOR DO POSTO PRINCIPAL. */
					l_r034DAC.VERAFA := l_r017DAC.VERAFA;
