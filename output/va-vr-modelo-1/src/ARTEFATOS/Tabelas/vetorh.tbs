  ELSE
  BEGIN
    SELECT @l_day = SUBSTRING(@p_value,@l_pos,@l_count)
  END
  /*END DAY*/
  
  /*MONTH*/
  SELECT @l_count = 2
  SELECT @l_pos = CHARINDEX('MM', @l_mask)
  IF (@l_pos=0)
  BEGIN
    BEGIN
      RAISERROR('SP_STRTODATE: Mês deve ser informado na máscara para conversão.',11,1) WITH SETERROR
      SELECT @ChkError = -30
      GOTO FIM
    END
  END
  ELSE
  BEGIN
	SELECT @l_validate = CONVERT(NUMERIC,SUBSTRING(@p_value,@l_pos,@l_count))
	IF (@l_validate>=1) 
     AND (@l_validate<=12)
	BEGIN
		SELECT @l_month = SUBSTRING(@p_value,@l_pos,@l_count)
	END
