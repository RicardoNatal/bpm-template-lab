»6␀␀CREATE OR REPLACE PROCEDURE SP_SinAudMVI(p_tipope IN smallint,p_codpor IN smallint,p_datent IN TIMESTAMP(0),p_horent IN smallint,p_seqent IN smallint,p_tipdoc IN smallint,p_numdoc IN VARCHAR(4000),p_numemp IN smallint,p_tipcol IN smallint,p_numcad IN INT,p_numcra IN bigint,p_codnac IN smallint,p_nomvis IN VARCHAR(4000),p_codoem IN INT,p_nomoem IN VARCHAR(4000),p_dditel IN smallint,p_dddtel IN smallint,p_telcon IN VARCHAR(4000),p_tipvis IN smallint,p_codprm IN INT,p_datval IN TIMESTAMP(0),p_horval IN smallint,p_obsvis IN VARCHAR(4000),p_plavee IN VARCHAR(4000),p_placae IN VARCHAR(4000),p_place2 IN VARCHAR(4000),p_place3 IN VARCHAR(4000),p_numlau IN VARCHAR(4000),p_regrod IN INT,p_assvid IN VARCHAR(4000),p_pcodoem IN INT,p_numcon IN VARCHAR(4000),p_pnumemp IN INT,p_ptipcol IN INT,p_pnumcad IN INT,p_codusu IN bigint,p_datsai IN TIMESTAMP(0),p_horsai IN smallint,p_emavis IN VARCHAR(4000),p_verplf IN INT,p_codplf IN INT,p_RetSin IN OUT smallint)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  l_temAud SMALLINT;
  l_coderr SMALLINT;
  l_codRPA BIGINT;
  l_datatu TIMESTAMP(0);
  l_horatu INT;
  l_tipdocSTR VARCHAR(255);
  l_numdocSTR VARCHAR(255);
  l_codporSTR VARCHAR(255);
  l_datentSTR VARCHAR(255);
  l_horentSTR VARCHAR(255);
  l_seqentSTR VARCHAR(255);
  l_numempSTR VARCHAR(255);
  l_tipcolSTR VARCHAR(255);
  l_numcadSTR VARCHAR(255);
  l_numcraSTR VARCHAR(255);
  l_taborgSTR VARCHAR(255);
  l_numlocSTR VARCHAR(255);
  l_segtdoSTR VARCHAR(255);
  l_segdocSTR VARCHAR(255);
  l_emicidSTR VARCHAR(255);
  l_estcidSTR VARCHAR(255);
  l_dexcidSTR VARCHAR(255);
  l_codnacSTR VARCHAR(255);
  l_nomvisSTR VARCHAR(255);
  l_codormSTR VARCHAR(255);
  l_nomoemSTR VARCHAR(255);
  l_dditelSTR VARCHAR(255);
  l_dddtelSTR VARCHAR(255);
  l_telconSTR VARCHAR(255);
  l_tipvisSTR VARCHAR(255);
  l_codprmSTR VARCHAR(255);
  l_codmotSTR VARCHAR(255);
  l_datvalSTR VARCHAR(255);
  l_horvalSTR VARCHAR(255);
  l_obsvisSTR VARCHAR(255);
  l_plaveeSTR VARCHAR(255);
  l_placaeSTR VARCHAR(255);
  l_place2STR VARCHAR(255);
  l_place3STR VARCHAR(255);
  l_numlauSTR VARCHAR(255);
  l_regrodSTR VARCHAR(255);
  l_codoemSTR VARCHAR(255);
  l_pcodoemSTR VARCHAR(255);
  l_numconSTR VARCHAR(255);
  l_pnumempSTR VARCHAR(255);
  l_ptipcolSTR VARCHAR(255);
  l_pnumcadSTR VARCHAR(255);
  l_emavisSTR VARCHAR(255);
  l_verplfSTR VARCHAR(255);
  l_codplfSTR VARCHAR(255);
  l_datsaiSTR VARCHAR(255);
  l_horsaiSTR VARCHAR(255);
  l_tamstr SMALLINT;
  l_auxtam SMALLINT;
  l_mascara VARCHAR(255);
BEGIN
  p_RetSin := 0;
  l_coderr := 0;
  l_datatu := TO_DATE(TO_CHAR(CURRENT_TIMESTAMP,'DD/MM/YYYY'),'DD/MM/YYYY');
  
  SELECT TO_CHAR(CURRENT_TIMESTAMP, 'SSSSS') INTO l_horatu;
  CALL SP_INTSTR(p_tipdoc,'9',l_tipdocSTR);
  l_numdocSTR := p_numdoc;
  CALL SP_TAMSTR(p_codpor,l_mascara);
  CALL SP_INTSTR(p_codpor,l_mascara,l_codporSTR);
  CALL SP_DATSTR(p_datent,'DDMMYY',l_datentSTR);
  l_datentSTR := SUBSTR(l_datentSTR,1,2)||'/'||SUBSTR(l_datentSTR,3,2)||'/20'||SUBSTR(l_datentSTR,5,2);
  CALL SP_INTSTR(p_horent,'HHMM',l_horentSTR);
  l_horentSTR := SUBSTR(l_horentSTR,1,2)||':'||SUBSTR(l_horentSTR,3,2);
  CALL SP_TAMSTR(p_seqent,l_mascara);
  CALL SP_INTSTR(p_seqent,l_mascara,l_seqentSTR);
  CALL SP_TAMSTR(p_numemp,l_mascara);
  CALL SP_INTSTR(p_numemp,l_mascara,l_numempSTR);
  CALL SP_INTSTR(p_tipcol,'9',l_tipcolSTR);
  CALL SP_TAMSTR(p_numcad,l_mascara);
  CALL SP_INTSTR(p_numcad,l_mascara,l_numcadSTR);
  CALL SP_INTSTR(p_numcra,'999999999999',l_numcraSTR);
  CALL SP_TAMSTR(p_codnac,l_mascara);
  CALL SP_INTSTR(p_codnac,l_mascara,l_codnacSTR);
  l_nomvisSTR := p_nomvis;
  CALL SP_TAMSTR(p_codoem,l_mascara);
  CALL SP_INTSTR(p_codoem,l_mascara,l_codoemSTR);
  l_nomoemSTR := p_nomoem;
  CALL SP_TAMSTR(p_dditel,l_mascara);
  CALL SP_INTSTR(p_dditel,l_mascara,l_dditelSTR);
  CALL SP_TAMSTR(p_dddtel,l_mascara);
  CALL SP_INTSTR(p_dddtel,l_mascara,l_dddtelSTR);
  l_telconSTR := p_telcon;
  CALL SP_TAMSTR(p_tipvis,l_mascara);
  CALL SP_INTSTR(p_tipvis,l_mascara,l_tipvisSTR);
  CALL SP_TAMSTR(p_codprm,l_mascara);
  CALL SP_INTSTR(p_codprm,l_mascara,l_codprmSTR);
  CALL SP_DATSTR(p_datval,'DDMMYY',l_datvalSTR);
  l_datvalSTR := SUBSTR(l_datvalSTR,1,2)||'/'||SUBSTR(l_datvalSTR,3,2)||'/20'||SUBSTR(l_datvalSTR,5,2);
  CALL SP_INTSTR(p_horval,'HHMM',l_horvalSTR);
  l_horvalSTR := SUBSTR(l_horvalSTR,1,2)||':'||SUBSTR(l_horvalSTR,3,2);
  l_obsvisSTR := p_obsVis;
  l_plaveeSTR := p_plavee;
  l_placaeSTR := p_placae;
  l_place2STR := p_place2;
  l_place3STR := p_place3;
  l_numlauSTR := p_numlau;
  CALL SP_TAMSTR(p_regrod,l_mascara);
  CALL SP_INTSTR(p_regrod,l_mascara,l_regrodSTR);
  l_numconSTR := p_numcon;
  CALL SP_TAMSTR(p_pnumemp,l_mascara);
  CALL SP_INTSTR(p_pnumemp,l_mascara,l_pnumempSTR);
  CALL SP_INTSTR(p_ptipcol,'9',l_ptipcolSTR);
  CALL SP_TAMSTR(p_pnumcad,l_mascara);
  CALL SP_INTSTR(p_pnumcad,l_mascara,l_pnumcadSTR);
  l_emavisSTR := p_emavis;
  CALL SP_TAMSTR(p_verplf,l_mascara);
  CALL SP_INTSTR(p_verplf,l_mascara,l_verplfSTR);
  CALL SP_TAMSTR(p_codplf,l_mascara);
  CALL SP_INTSTR(p_codplf,l_mascara,l_codplfSTR);
  CALL SP_DATSTR(p_datsai,'DDMMYY',l_datsaiSTR);
  l_datsaiSTR := SUBSTR(l_datsaiSTR,1,2)||'/'||SUBSTR(l_datsaiSTR,3,2)||'/20'||SUBSTR(l_datsaiSTR,5,2);
  CALL SP_INTSTR(p_horsai,'HHMM',l_horsaiSTR);
  l_horsaiSTR := SUBSTR(l_horsaiSTR,1,2)||':'||SUBSTR(l_horsaiSTR,3,2);
  l_codRPA := 0;
  CALL SP_RET_REG_AUD(l_codRPA);
  if (p_tipope=0) then
    l_temAud := 0;
    begin
      
      SELECT 
      COUNT(*) EXPR1759134873
       INTO l_temAud 
       FROM R995CTE R995CTE
       WHERE CODCPA=7 
      AND CODTPA=112;
    exception
      when OTHERS then
        l_coderr := 21;
    end;
    if (l_coderr=0) then
      if (l_temAud>0) then
        begin
          
          INSERT INTO R995RPA (CODRPA,CODSYS,CODCPA,VERCPA,CODTPA,VERTPA,DATRPA,HORRPA,SCRACT,CODUSU) VALUES  (l_codRPA,3,7,1,120,1,l_datatu,l_horatu,'PORTARIA AVANCADA',p_codusu);
        exception
          when OTHERS then
            l_coderr := 22;
        end;
        begin
          
          INSERT INTO R995PRC (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TIPDOC',l_tipdocSTR);
          
          INSERT INTO R995PRC (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMDOC',l_numdocSTR);
        exception
          when OTHERS then
            l_coderr := 23;
        end;
        begin
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CODPOR',l_codporSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DATENT',l_datentSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'HORENT',l_horentSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'SEQENT',l_seqentSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMEMP',l_numempSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TIPCOL',l_tipcolSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMCAD',l_numcadSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMCRA',l_numcraSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TABORG','');
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMLOC','');
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'SEGTDO','');
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'SEGDOC','');
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'EMICID','');
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'ESTCID','');
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DEXCID','');
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CODNAC',l_codnacSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NOMVIS',l_nomvisSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CODOEM',l_codoemSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NOMOEM',l_nomoemSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DDITEL',l_dditelSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DDDTEL',l_dddtelSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TELCON',l_telconSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TIPVIS',l_tipvisSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CODPRM',l_codprmSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CODMOT','');
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DATVAL',l_datvalSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'HORVAL',l_horvalSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'OBSVIS',l_obsvisSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PLACAE',l_placaeSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PLACE2',l_place2STR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PLACE3',l_place3STR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMLAU',l_numlauSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'REGROD',l_regrodSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMCHN','');
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CATCNH','');
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'VENCNH','');
          if (p_assVid='1') then
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DATVID',l_datentSTR);
          end if;
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PCODOEM',l_codoemSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMCON',l_numconSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'VISVAU','');
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CODLOT','');
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PNUMEMP',l_pnumempSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PTIPCOL',l_ptipcolSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PNUMCAD',l_pnumcadSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'EMAVIS',l_emavisSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'VERPLF',l_verplfSTR);
          
          INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'CODPLF',l_codplfSTR);
        exception
          when OTHERS then
            l_coderr := 24;
        end;
      end if;
    end if;
  end if;
  if (p_tipope=1) then
    l_temAud := 0;
    begin
      
      SELECT 
      COUNT(*) EXPR208846594
       INTO l_temAud 
       FROM R995CTE R995CTE
       WHERE CODCPA=7 
      AND CODTPA=120;
    exception
      when OTHERS then
        l_coderr := 21;
    end;
    if (l_coderr=0) then
      if (l_temAud>0) then
        if (l_coderr=0) then
          begin
            
            INSERT INTO R995RPA (CODRPA,CODSYS,CODCPA,VERCPA,CODTPA,VERTPA,DATRPA,HORRPA,SCRACT,CODUSU) VALUES  (l_codRPA,3,7,1,120,1,l_datatu,l_horatu,'PORTARIA AVANCADA',p_codusu);
          exception
            when OTHERS then
              l_coderr := 22;
          end;
          begin
            
            INSERT INTO R995PRC (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'TIPDOC',l_tipdocSTR);
            
            INSERT INTO R995PRC (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMDOC',l_numdocSTR);
          exception
            when OTHERS then
              l_coderr := 23;
          end;
          begin
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DATENT',l_datentSTR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'HORENT',l_horentSTR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'SEQENT',l_seqentSTR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DATSAI',l_datsaiSTR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'HORSAI',l_horsaiSTR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMCRA',l_numcraSTR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMLAU',l_numlauSTR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PLAVES',l_plaveeSTR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PLACAS',l_placaeSTR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PLACS2',l_place2STR);
            
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'PLACS3',l_place3STR);
          exception
            when OTHERS then
              l_coderr := 24;
          end;
        end if;
      end if;
    end if;
  end if;
  p_RetSin := l_coderr;
END;
$BODY$;␀áø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
¯/* Processa demanda de sicronismo - 05 = Entrada de visitantes (R090MVI)   */
PROCEDURE SP_SINENTVIS(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS
BEGIN
  NULL;
END		SENIOR;24FSP_STRTODATE
SP_PESFROMIDTPES
SP_DECFON
SP_SinAudMVI
SP_STRTOINT
‡z␀␀

PROCEDURE SP_SINENTVIS(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

  l_datstr    VARCHAR2(16);  
  l_usocra    NUMBER(2);
  l_numcra    NUMBER(12);
  l_idtvis    VARCHAR2(23);
  l_idtCol    VARCHAR2(23);
  l_tam       NUMBER(3);
  l_pos       NUMBER(3);
  l_codpor    NUMBER(3);
  l_nomvis    VARCHAR2(40);
  l_codprm    NUMBER(5);
  l_tel       VARCHAR2(100);
  l_datvalStr VARCHAR2(16);
  l_datval    DATE;
  l_horval    NUMBER(4);
  l_tipvis    VARCHAR2(3);
  l_obsvis    VARCHAR2(160);
  l_codoem    NUMBER(8);
  l_numcon    VARCHAR2(15);
  l_codnac    NUMBER(3);
  l_cravei    NUMBER(12);
  l_CraVeiOld NUMBER(12);
  l_plavee    VARCHAR2(10);
  l_place1    VARCHAR2(10);
  l_place2    VARCHAR2(10);
  l_place3    VARCHAR2(10);
  l_datalt    DATE;
  l_assvid    VARCHAR2(1);
  l_nomoem    VARCHAR2(60);
  l_numlau    VARCHAR2(12);
  l_regrod    NUMBER(9);
  l_codusu    NUMBER(10);
  l_coderr    NUMBER(2);

  /*VariÃ¡veis auxiliares para conversÃ£o de data*/
  l_datcon VARCHAR2(25);
  l_horAlt NUMBER(4);
  l_seqent NUMBER(2);

  l_datins    DATE;
  l_tippes    NUMBER(2);
  l_numemp    NUMBER(4);
  l_tipcol    NUMBER(1);
  l_numcad    NUMBER(9);
  l_tipdoc    NUMBER(1);
  l_numdoc    VARCHAR2(20);
  l_nummat    VARCHAR2(15);
  l_propac    VARCHAR2(20);
  l_DDI       NUMBER(3);
  l_DDD       NUMBER(3);
  l_Fone      VARCHAR2(20);
  l_count     NUMBER(1);
  l_numempVis NUMBER(4);
  l_tipcolVis NUMBER(1);
  l_numcadVis NUMBER(9);
  l_tipdocVis NUMBER(1);
  l_numdocVis VARCHAR2(20);
  l_idtaut    VARCHAR2(23);
  l_VisVau    CHAR(1);
  l_data_zero DATE;
  l_empaut    NUMBER(4);
  l_tipaut    NUMBER(1);
  l_cadaut    NUMBER(9);
  l_tipdocAut NUMBER(1);
  l_numdocAut VARCHAR2(20);

  l_emavis    VARCHAR2(50);
  l_verplf    NUMBER(3);
  l_codplf    NUMBER(7);
  l_numcnh    VARCHAR2(20);
  l_catcnh    VARCHAR2(4);
  l_vencnhStr VARCHAR2(16);
  l_vencnh    DATE;
  l_andvis    NUMBER;
  l_VIDPLA    VARCHAR2(1);
  l_codplt    NUMBER(7);
  
  /*acompanhantes*/
  l_qtdaco    NUMBER(2);
  l_nomaco    VARCHAR2(99);
  l_idtpesaco VARCHAR2(23);
  l_numcraaco NUMBER(12);
  l_numempAco NUMBER(4);
  l_tipcolAco NUMBER(1);
  l_numcadAco NUMBER(9);
  l_tipdocAco NUMBER(1);
  l_numdocAco VARCHAR2(20);
  l_contLoop  NUMBER(2);
  
  l_datprvStr VARCHAR2(16);
  l_datprv    DATE;
  l_horprv    NUMBER(4);
  l_seqprv    NUMBER(2);
BEGIN
  /* inicializa variÃ¡veis */
  l_coderr    := 0;
  p_RetErr    := 0;
  l_datins    := CURDATE();
  l_codusu    := 0;
  l_horAlt    := 0;
  l_data_zero := '31/12/1900,00:00:00';
  l_nomvis    := '';
  l_tel       := '';
  l_obsvis    := '';
  l_nomoem    := '';
  l_numlau    := '';
  l_regrod    := 0;
  l_emavis    := '';
  l_vencnh    := l_data_zero;

  /* separa os valores da string do p_valStr em cada variÃ¡vel */
  BEGIN
    l_pos    := 3;
    l_datstr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos    := l_pos + 16;
    l_numcra := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
    l_pos    := l_pos + 12;
    l_idtCol := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_codpor := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_idtVis := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_tam    := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos    := l_pos + 2;
    IF (l_tam > 0) THEN
      l_nomvis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
    l_codprm := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 5));
    l_pos    := l_pos + 5;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_tel := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos := l_pos + l_tam;
    END IF;
  
    l_datvalStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos       := l_pos + 16;
    l_tipvis    := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos       := l_pos + 3;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos := l_pos + 3;
    IF (l_tam > 0) THEN
      l_obsvis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_codusu := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 10));
    l_pos    := l_pos + 10;
    l_assvid := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 1));
    l_pos    := l_pos + 1;
    l_codoem := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 8));
    l_pos    := l_pos + 8;
    l_numcon := SUBSTRING(p_ValStr, l_pos, 15);
    l_pos    := l_pos + 15;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_nomoem := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_codnac := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_cravei := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
    l_pos    := l_pos + 12;
    l_plavee := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place1 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place2 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place3 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_numlau := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, l_tam)));
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_regrod := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, l_tam));
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_emavis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_idtaut := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_verplf := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_codplf := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 7));
    l_pos    := l_pos + 7;
  
    l_numcnh    := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, 20)));
    l_pos       := l_pos + 20;
    l_catcnh    := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, 4)));
    l_pos       := l_pos + 4;
    l_vencnhStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos       := l_pos + 16;

    SP_STRTOINT(SUBSTRING(p_ValStr, l_pos, 3) , l_andvis OUT);

    l_pos    := l_pos + 3;
  
    /* converte data/hora inicial */
    l_datcon := SUBSTRING(l_datstr, 1, 2) || '/' ||
                SUBSTRING(l_datstr, 3, 2) || '/' ||
                SUBSTRING(l_datstr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datAlt OUT);
    l_horAlt := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 9, 2)));
    l_seqent := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 11, 2)));
  
    /* converte data validade */
    l_datcon := SUBSTRING(l_datvalStr, 1, 2) || '/' ||
                SUBSTRING(l_datvalStr, 3, 2) || '/' ||
                SUBSTRING(l_datvalStr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datval OUT);
    l_horval := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datvalStr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datvalStr, 9, 2)));
  
    /* desmontar IDTPES do colab. (visitado) */
    SP_PESFROMIDTPES(l_idtCol,
                     l_tippes OUT,
                     l_numemp OUT,
                     l_tipcol OUT,
                     l_numcad OUT,
                     l_tipdoc OUT,
                     l_numdoc OUT,
                     l_nummat OUT,
                     l_propac OUT);
  
    /* decodificar string de telefone */
    SP_DECFON(l_tel, l_DDI OUT, l_DDD OUT, l_Fone OUT);
  
    /* desmontar IDTPES do visitante */
    SP_PESFROMIDTPES(l_idtVis,
                     l_tippes OUT,
                     l_numempVis OUT,
                     l_tipcolVis OUT,
                     l_numcadVis OUT,
                     l_tipdocVis OUT,
                     l_numdocVis OUT,
                     l_nummat OUT,
                     l_propac OUT);
  
    /* converte data Venc. CNH */
    IF (l_vencnhStr IS NOT NULL AND l_vencnhStr <> '0000000000000000') THEN
      l_datcon := SUBSTRING(l_vencnhStr, 1, 2) || '/' ||
                  SUBSTRING(l_vencnhStr, 3, 2) || '/' ||
                  SUBSTRING(l_vencnhStr, 5, 2);
      SP_STRTODATE(l_datcon, 'DD/MM/AA', l_vencnh OUT);
    END IF;
  
    /* padronizar as placas tirando espaÃ§os e traÃ§os */
    l_plavee := LTRIM(RTRIM(REPLACE(REPLACE(l_plavee, '-', ''), ' ', '')));
    l_place1 := LTRIM(RTRIM(REPLACE(REPLACE(l_place1, '-', ''), ' ', '')));
    l_place2 := LTRIM(RTRIM(REPLACE(REPLACE(l_place2, '-', ''), ' ', '')));
    l_place3 := LTRIM(RTRIM(REPLACE(REPLACE(l_place3, '-', ''), ' ', '')));
  
    /* por causa do ORACLE que considera '' como NULL e no SQL-SERVER nÃ£o */
    IF  (l_plavee = '') THEN
      l_plavee := NULL;
    END IF;
        
    IF  (l_place1 = '') THEN
      l_place1 := NULL;
    END IF;
       
    IF  (l_place2 = '') THEN
      l_place2 := NULL;
    END IF;

    IF  (l_place3 = '') THEN
      l_place3 := NULL;
    END IF;
    
    IF  (l_numlau = '') THEN
      l_numlau := NULL;
    END IF;
    
    IF  (l_numcnh = '') THEN
      l_numcnh := NULL;
    END IF;
    
    IF  (l_catcnh = '') THEN
      l_catcnh := NULL;
    END IF;
  
  EXCEPTION
    WHEN OTHERS THEN
      l_coderr := 30; /* erro de conversÃ£o na string */
  END;

  /* Fechar histÃ³rico R090HCH se tiver algum em aberto */
  IF (l_codErr = 0) THEN
    /* Verificar R090HCH com data/hora final em aberto */
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R090HCH
       WHERE TIPDOC = l_tipdocVis
         AND NUMDOC = l_numdocVis
         AND ((DATFIM = l_data_zero) OR
             ((R090HCH.DATFIM > l_datAlt) OR
             ((R090HCH.DATFIM = l_datAlt) AND (R090HCH.HORFIM > l_horAlt))));
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  
    /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
    BEGIN
      IF (l_count > 0) THEN
        UPDATE R090HCH
           SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1, SEQREG = l_seqent
         WHERE TIPDOC = l_tipdocVis
           AND NUMDOC = l_numdocVis
           AND ((DATFIM = l_data_zero) OR ((R090HCH.DATFIM > l_datAlt) OR
               ((R090HCH.DATFIM = l_datAlt) AND
               (R090HCH.HORFIM > l_horAlt))));
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  END IF;

  IF (l_codErr = 0) THEN
    /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
    BEGIN
      UPDATE R090MVI
         SET DATSLO = l_datAlt,
             HORSLO = l_horAlt - 1,
             DATSAI = l_datAlt,
             HORSAI = l_horAlt - 1
       WHERE R090MVI.TIPDOC = l_tipdocVis
         AND R090MVI.NUMDOC = l_numdocVis
         AND R090MVI.DATSAI = l_data_zero;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  END IF;

  /* Inserir ou atualizar VISITANTE */
  IF (l_codErr = 0) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R090VIS
       WHERE TIPDOC = l_tipdocVis
         AND NUMDOC = l_numdocVis;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 33;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R090VIS
          (TIPDOC,
           NUMDOC,
           NOMVIS,
           CODOEM,
           NOMOEM,
           CODPRM,
           DDITEL,
           DDDTEL,
           TELCON,
           OBSVIS,
           CODNAC,
           EMAVIS,
           NUMCNH,
           CATCNH,
           VENCNH)
        VALUES
          (l_tipdocVis,
           l_numdocVis,
           l_nomvis,
           l_codoem,
           l_nomoem,
           l_codprm,
           l_DDI,
           l_DDD,
           l_Fone,
           l_obsvis,
           l_codnac,
           l_emavis,
           l_numcnh,
           l_catcnh,
           l_vencnh);
      ELSE
        UPDATE R090VIS
           SET NOMVIS = l_nomvis,
               CODOEM = l_codoem,
               NOMOEM = l_nomoem,
               CODPRM = l_codprm,
               DDITEL = l_DDI,
               DDDTEL = l_DDD,
               TELCON = l_Fone,
               OBSVIS = l_obsvis,
               CODNAC = l_codnac,
               EMAVIS = l_emavis
         WHERE TIPDOC = l_tipdocVis
           AND NUMDOC = l_numdocVis;
      
        IF (l_numcnh IS NOT NULL) THEN
          UPDATE R090VIS
             SET NUMCNH = l_numcnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      
        IF (l_catcnh IS NOT NULL) THEN
          UPDATE R090VIS
             SET CATCNH = l_catcnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      
        IF (l_vencnh <> l_data_zero) THEN
          UPDATE R090VIS
             SET VENCNH = l_vencnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 33;
    END;
  END IF;

  IF (l_codErr = 0 AND l_plavee IS NOT NULL) THEN
    /* Verifica se tem um histÃ³rico de crachÃ¡ em aberto para esta placa de veÃ­culo */
    BEGIN
      SELECT NUMCRA
        INTO l_CraVeiOld
        FROM R088HCH
       WHERE PLAVEI = l_plavee
         AND ((DATINI < l_datAlt OR
             (DATINI = l_datAlt AND HORINI <= l_horAlt)) AND
             (DATFIM > l_datAlt OR
             (DATFIM = l_datAlt AND HORFIM >= l_horAlt)) OR
             DATFIM = l_data_zero);
    
      /* Finaliza o histÃ³rico de crachÃ¡ atual */
      IF (l_CraVeiOld > 0) THEN
        UPDATE R088HCH
           SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1
         WHERE NUMCRA = l_CraVeiOld
           AND ((DATINI < l_datAlt OR
               (DATINI = l_datAlt AND HORINI <= l_horAlt)) AND
               (DATFIM > l_datAlt OR
               (DATFIM = l_datAlt AND HORFIM >= l_horAlt)) OR
               DATFIM = l_data_zero);
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        NULL;
    END;
  
    /* Inclui Placa VeÃ­culo se nÃ£o existir */
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_plavee;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 34;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_plavee, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    /* Verificar se tem PLACA E CRAVEI  */
    IF (l_cravei > 0) THEN
      BEGIN
        /* Insere um novo histÃ³rico de crachÃ¡ */
        INSERT INTO R088HCH (plavei, datini, horini, numcra, datfim, horfim, staacc)
        VALUES
          (l_plavee, l_datAlt, l_horAlt, l_cravei, l_datval, l_horval, 0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 34;
      END;
    END IF;
  END IF;

  IF (l_codErr = 0 AND l_place1 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place1;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place1, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0 AND l_place2 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place2;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place2, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0 AND l_place3 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place3;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place3, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0) THEN
    BEGIN
      INSERT INTO R090MVI
        (datent,
         horent,
         seqent,
         numcra,
         numemp,
         tipcol,
         numcad,
         codprm,
         tipvis,
         obsvis,
         codusu,
         assvid,
         codoem,
         numcon,
         nomoem,
         codnac,
         cravei,
         codpor,
         datval,
         horval,
         plavee,
         PlaCae,
         place2,
         place3,
         dditel,
         dddtel,
         telcon,
         tipdoc,
         numdoc,
         emavis,
         verplf,
         codplf,
         datsai,
         horsai,
         datslo,
         horslo,
         andvis)
      VALUES
        (l_datAlt,
         l_horAlt,
         l_seqent,
         l_numcra,
         l_numemp,
         l_tipcol,
         l_numcad,
         l_codprm,
         CONVERT(CHAR_TO_NUMBER, l_tipvis),
         l_obsvis,
         l_codusu,
         l_assvid,
         l_codoem,
         l_numcon,
         l_nomoem,
         l_codnac,
         l_cravei,
         l_codpor,
         l_datval,
         l_horval,
         l_plavee,
         l_place1,
         l_place2,
         l_place3,
         l_DDI,
         l_DDD,
         l_Fone,
         l_tipdocVis,
         l_numdocVis,
         l_emavis,
         l_verplf,
         l_codplf,
         l_data_zero,
         0,
         l_data_zero,
         0, 
         l_andvis);
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 31;
    END;
  END IF;

  IF (l_codErr = 0) THEN
    BEGIN
      INSERT INTO R090HCH
        (TIPDOC, NUMDOC, DATINI, HORINI, SEQENT, NUMCRA, DATFIM, HORFIM)
      VALUES
        (l_tipdocVis,
         l_numdocVis,
         l_datAlt,
         l_horAlt,
         l_seqent,
         l_numcra,
         l_data_zero,
         0);
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  
    IF (l_codErr = 0) THEN
      BEGIN
        IF ((l_numlau IS NOT NULL) OR (l_regrod > 0)) THEN
          INSERT INTO R090LAU
            (datent, horent, seqent, numlau, regrod, datins)
          VALUES
            (l_datAlt, l_horAlt, l_seqent, l_numlau, l_regrod, l_datins);
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 34;
      END;
    
      /* Incluir registro na R090VAU, se necessÃ¡rio */
      BEGIN
        SELECT VISVAU
          INTO l_VisVau
          FROM R090PRO
         WHERE TIPVIS = CONVERT(CHAR_TO_NUMBER, l_tipvis)
           AND PROVIS = 7
           AND CONPRO = 2;
        l_count := 1;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_count := 0;
        WHEN TOO_MANY_ROWS THEN
          l_codErr := 36;
          l_count  := 0;
        WHEN OTHERS THEN
          l_codErr := 36;
          l_count  := 0;
      END;
    
      BEGIN
        IF (l_count = 1) THEN
          IF (l_VisVau = 'S') THEN
            /* ValidaÃ§Ã£o por Autorizador */
            INSERT INTO R090VAU
              (datent, horent, seqent, idtpes, idtaut, datfim, horfim)
            VALUES
              (l_datAlt,
               l_horAlt,
               l_seqent,
               l_idtVis,
               l_idtVis,
               l_datval,
               l_horval);
          ELSE
            /*So insere se tiver autorizador*/
            IF (LTRIM(RTRIM(l_idtAut)) <> '') THEN
              /* Validacao por Autorizador */
              INSERT INTO R090VAU
                (datent, horent, seqent, idtpes, idtaut, datfim, horfim)
              VALUES
                (l_datAlt,
                 l_horAlt,
                 l_seqent,
                 l_idtVis,
                 l_idtAut,
                 l_datval,
                 l_horval);
            END IF;
          END IF;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 36;
      END;
    END IF;
  END IF;

  /* R090VID */
  IF (l_codErr = 0 AND l_assvid = '1') THEN
  
    BEGIN
      SELECT CODPLT INTO l_codplt FROM r058por WHERE CODPOR = l_codpor;
    EXCEPTION
      WHEN OTHERS THEN l_codplt := 0;
    END;

    BEGIN
      SELECT VIDPLA INTO l_VIDPLA FROM R090TVI WHERE TIPVIS = CONVERT(CHAR_TO_NUMBER, l_tipvis);
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_VIDPLA := 'N';
      WHEN OTHERS THEN NULL;
    END;
    
    IF (l_VIDPLA = 'S') THEN
      BEGIN
        SELECT COUNT(*) INTO l_count FROM R090VID WHERE CODPLT=l_codplt AND TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
      EXCEPTION
        WHEN OTHERS THEN l_count := 0;
      END;

      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VID (CODPLT, TIPDOC, NUMDOC, DATVID) VALUES (l_codplt, l_tipdocVis, l_numdocVis, l_datAlt);
        ELSE
          UPDATE R090VID SET DATVID = l_datAlt WHERE CODPLT=l_codplt AND TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 38;
      END;
    ELSE
      BEGIN
        SELECT COUNT(*) INTO l_count FROM R090VID WHERE TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
      EXCEPTION
        WHEN OTHERS THEN l_count := 0;
      END;

      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VID (CODPLT, TIPDOC, NUMDOC, DATVID) VALUES (l_codplt, l_tipdocVis, l_numdocVis, l_datAlt);
        ELSE
          UPDATE R090VID SET DATVID = l_datAlt WHERE TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
        END IF;      
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 38;
      END;
    END IF;
  END IF;
  
  /* Executa a auditoria de registros */
  IF (l_codErr = 0) THEN
  
    IF (LTRIM(RTRIM(l_idtAut)) <> '') THEN
      /* desmontar IDTPES do autorizador */
      SP_PESFROMIDTPES(l_idtAut,
                       l_tippes OUT,
                       l_empAut OUT,
                       l_tipaut OUT,
                       l_cadaut OUT,
                       l_tipdocAut OUT,
                       l_numdocAut OUT,
                       l_nummat OUT,
                       l_propac OUT);
                     
      IF (l_tippes > 3) THEN
        l_empaut := 0;
        l_tipaut := 0;
        l_cadaut := 0;
      END IF;               
    ELSE
      l_empaut := 0;
      l_tipaut := 0;
      l_cadaut := 0;
    END IF;
  
    SP_SinAudMVI(0,
                 l_codpor,
                 l_datALT,
                 l_horalt,
                 l_seqent,
                 l_tipdocVis,
                 l_numdocVis,
                 l_numemp,
                 l_tipcol,
                 l_numcad,
                 l_numcra,
                 l_codnac,
                 l_nomvis,
                 l_codoem,
                 l_nomoem,
                 l_DDI,
                 l_DDD,
                 l_Fone,
                 l_tipvis,
                 l_codprm,
                 l_datval,
                 l_horval,
                 l_obsvis,
                 l_plavee,
                 l_place1,
                 l_place2,
                 l_place3,
                 l_numlau,
                 l_regrod,
                 /*p_numcnh   IN NUMBER(4), p_catcnh   IN VARCHAR2(20), p_vencnh   IN DATE,*/
                 l_assvid,
                 l_codoem,
                 l_numcon,
                 l_empaut,
                 l_tipaut,
                 l_cadaut,
                 l_codusu,
                 l_datALT,
                 l_horalt,
                 l_emavis,
                 l_verplf,
                 l_codplf,
                 l_codErr OUT);
  END IF;


  IF (l_codErr = 0) THEN
  
    /* se não tem acompanhante na string, não consegue converter */
    IF (Length(p_ValStr) > l_pos) THEN
        l_qtdaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
        l_pos := l_pos + 2;
    ELSE
        l_qtdaco := 0;
    END IF;

    l_contLoop := 1;

    /* LOOP Acompanhantes */
    WHILE (l_contLoop <= l_qtdaco) LOOP
      l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
      l_pos := l_pos + 2;
      IF (l_tam > 0) THEN
        l_nomaco := SUBSTRING(p_ValStr, l_pos, l_tam);
        l_pos := l_pos + l_tam;
      END IF;

      l_idtpesaco := SUBSTRING(p_ValStr, l_pos, 23);
      l_pos := l_pos + 23;

      l_codoem := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 8));
      l_pos := l_pos + 8;

      l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
      l_pos    := l_pos + 2;
      IF (l_tam > 0) THEN
        l_nomoem := SUBSTRING(p_ValStr, l_pos, l_tam);
        l_pos := l_pos + l_tam;
      END IF;

      l_codnac := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
      l_pos := l_pos + 3;

      l_numcraaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
      l_pos := l_pos + 12;

      /* desmontar IDTPES do visitante */
      SP_PESFROMIDTPES(l_idtpesaco,
                       l_tippes OUT,
                       l_numempAco OUT,
                       l_tipcolAco OUT,
                       l_numcadAco OUT,
                       l_tipdocAco OUT,
                       l_numdocAco OUT,
                       l_nummat OUT,
                       l_propac OUT);

      /* Fechar historico R090HCH se tiver algum em aberto */
      IF (l_codErr = 0) THEN
        /* Verificar R090HCH com data/hora final em aberto */
        BEGIN
          SELECT COUNT(*) QNTREG
            INTO l_count
            FROM R090HCH
           WHERE TIPDOC = l_tipdocAco
             AND NUMDOC = l_numdocAco
             AND ((DATFIM = l_data_zero) OR
                 ((R090HCH.DATFIM > l_datAlt) OR
                 ((R090HCH.DATFIM = l_datAlt) AND (R090HCH.HORFIM > l_horAlt))));
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
  
        /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
        BEGIN
          IF (l_count > 0) THEN
            UPDATE R090HCH
               SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1, SEQREG = l_seqent
             WHERE TIPDOC = l_tipdocAco
               AND NUMDOC = l_numdocAco
               AND ((DATFIM = l_data_zero) OR ((R090HCH.DATFIM > l_datAlt) OR
                   ((R090HCH.DATFIM = l_datAlt) AND
                   (R090HCH.HORFIM > l_horAlt))));
          END IF;
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
      END IF;

      IF (l_codErr = 0) THEN
        /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
        BEGIN
          UPDATE R090MVI
             SET DATSLO = l_datAlt,
                 HORSLO = l_horAlt - 1,
                 DATSAI = l_datAlt,
                 HORSAI = l_horAlt - 1
           WHERE R090MVI.TIPDOC = l_tipdocAco
             AND R090MVI.NUMDOC = l_numdocAco
             AND R090MVI.DATSAI = l_data_zero;
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
      END IF;

      /* Inserir ou atualizar VISITANTE */
      BEGIN
        SELECT COUNT(*) QNTREG
          INTO l_count
          FROM R090VIS
         WHERE TIPDOC = l_tipdocAco
           AND NUMDOC = l_numdocAco;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 33;
      END;
      
      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VIS
            (TIPDOC,
             NUMDOC,
             NOMVIS,
             CODOEM,
             NOMOEM,
             CODPRM,
             CODNAC)
          VALUES
            (l_tipdocAco,
             l_numdocAco,
             l_nomaco,
             l_codoem,
             l_nomoem,
             l_codprm,
             l_codnac);
        ELSE
          UPDATE R090VIS
             SET NOMVIS = l_nomaco,
                 CODOEM = l_codoem,
                 NOMOEM = l_nomoem,
                 CODPRM = l_codprm,
                 CODNAC = l_codnac
           WHERE TIPDOC = l_tipdocAco
             AND NUMDOC = l_numdocAco;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 33;
      END;

      /*ACOMPANHANTE*/
      BEGIN
        INSERT INTO R090ACO (DatEnt, HorEnt, SeqEnt, TipDoc, NumDoc, NumCra, CodNac, AssVid, DatSlo, HorSlo, DatSai, HorSai)
        VALUES (l_datAlt,
                l_horAlt,
                l_seqent,
                l_tipdocAco,
                l_numdocAco,
                l_numcraAco,
                l_codnac,
                l_assvid,
                l_data_zero,
        		0,
        		l_data_zero,
        		0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 53;
      END;
      
      /* Grava histórico de Crachá para o acompanhante */
      BEGIN
      	INSERT INTO R090HCH(TIPDOC, NUMDOC, DATINI, HORINI, SEQENT, NUMCRA, DATFIM, HORFIM)
      	VALUES (l_tipdocAco,
               	l_numdocAco,
        		l_datAlt,
        		l_horAlt,
        		l_seqent,
        		l_numcraAco,
        		l_data_zero,
        		0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 32;
   	  END;
 
      l_contLoop := l_contLoop + 1;
    END LOOP;
    /* FIM - LOOP Acompanhantes */
    
    l_datprvStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_datcon := SUBSTRING(l_datprvStr, 1, 2) || '/' ||
                SUBSTRING(l_datprvStr, 3, 2) || '/' ||
                SUBSTRING(l_datprvStr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datprv OUT);
    l_horprv := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 9, 2)));
    l_seqprv := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 11, 2)));
    
  END IF;
    	
  BEGIN
      UPDATE R090AGV SET 
        VISEFE = 'S' 
    	WHERE 
    		R090AGV.DATPRV = l_datprv AND 
    		R090AGV.HORPRV = l_horprv AND 
    		R090AGV.SEQAGV = l_seqprv AND
    		R090AGV.NUMEMP = l_numemp AND
    		R090AGV.TIPCOL = l_tipcol AND
    		R090AGV.NUMCAD = l_numcad;
    	EXCEPTION
    		WHEN OTHERS THEN
    		l_codErr := 32;
    END;

  /* retorna Codigo do erro */
  p_retErr := l_codErr;
END		SENIOR;209SP_STRTODATE
SP_PESFROMIDTPES
SP_DECFON
SP_SinAudMVI
K|␀␀

/* Processa demanda de sicronismo - 05 = Entrada de visitantes (R090MVI)   */
PROCEDURE SP_SINENTVIS(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

  l_datstr    VARCHAR2(16);  
  l_usocra    NUMBER(2);
  l_numcra    NUMBER(12);
  l_idtvis    VARCHAR2(23);
  l_idtCol    VARCHAR2(23);
  l_tam       NUMBER(3);
  l_pos       NUMBER(3);
  l_codpor    NUMBER(3);
  l_nomvis    VARCHAR2(40);
  l_codprm    NUMBER(5);
  l_tel       VARCHAR2(100);
  l_datvalStr VARCHAR2(16);
  l_datval    DATE;
  l_horval    NUMBER(4);
  l_tipvis    VARCHAR2(3);
  l_obsvis    VARCHAR2(160);
  l_codoem    NUMBER(8);
  l_numcon    VARCHAR2(15);
  l_codnac    NUMBER(3);
  l_cravei    NUMBER(12);
  l_CraVeiOld NUMBER(12);
  l_plavee    VARCHAR2(10);
  l_place1    VARCHAR2(10);
  l_place2    VARCHAR2(10);
  l_place3    VARCHAR2(10);
  l_datalt    DATE;
  l_assvid    VARCHAR2(1);
  l_nomoem    VARCHAR2(60);
  l_numlau    VARCHAR2(12);
  l_regrod    NUMBER(9);
  l_codusu    NUMBER(10);
  l_coderr    NUMBER(2);

  /*VariÃ¡veis auxiliares para conversÃ£o de data*/
  l_datcon VARCHAR2(25);
  l_horAlt NUMBER(4);
  l_seqent NUMBER(2);

  l_datins    DATE;
  l_tippes    NUMBER(2);
  l_numemp    NUMBER(4);
  l_tipcol    NUMBER(1);
  l_numcad    NUMBER(9);
  l_tipdoc    NUMBER(1);
  l_numdoc    VARCHAR2(20);
  l_nummat    VARCHAR2(15);
  l_propac    VARCHAR2(20);
  l_DDI       NUMBER(3);
  l_DDD       NUMBER(3);
  l_Fone      VARCHAR2(20);
  l_count     NUMBER(1);
  l_numempVis NUMBER(4);
  l_tipcolVis NUMBER(1);
  l_numcadVis NUMBER(9);
  l_tipdocVis NUMBER(1);
  l_numdocVis VARCHAR2(20);
  l_idtaut    VARCHAR2(23);
  l_VisVau    CHAR(1);
  l_data_zero DATE;
  l_empaut    NUMBER(4);
  l_tipaut    NUMBER(1);
  l_cadaut    NUMBER(9);
  l_tipdocAut NUMBER(1);
  l_numdocAut VARCHAR2(20);

  l_emavis    VARCHAR2(50);
  l_verplf    NUMBER(3);
  l_codplf    NUMBER(7);
  l_numcnh    VARCHAR2(20);
  l_catcnh    VARCHAR2(4);
  l_vencnhStr VARCHAR2(16);
  l_vencnh    DATE;
  l_andvis    NUMBER(3);
  l_VIDPLA    VARCHAR2(1);
  l_codplt    NUMBER(7);
  
  /*acompanhantes*/
  l_qtdaco    NUMBER(2);
  l_nomaco    VARCHAR2(99);
  l_idtpesaco VARCHAR2(23);
  l_numcraaco NUMBER(12);
  l_numempAco NUMBER(4);
  l_tipcolAco NUMBER(1);
  l_numcadAco NUMBER(9);
  l_tipdocAco NUMBER(1);
  l_numdocAco VARCHAR2(20);
  l_contLoop  NUMBER(2);
  
  l_datprvStr VARCHAR2(16);
  l_datprv    DATE;
  l_horprv    NUMBER(4);
  l_seqprv    NUMBER(2);
  
  l_Inseriu_R090MVI VARCHAR2(1);
BEGIN
  /* inicializa variÃ¡veis */
  l_coderr    := 0;
  p_RetErr    := 0;
  l_datins    := CURDATE();
  l_codusu    := 0;
  l_horAlt    := 0;
  l_data_zero := '31/12/1900,00:00:00';
  l_nomvis    := '';
  l_tel       := '';
  l_obsvis    := '';
  l_nomoem    := '';
  l_numlau    := '';
  l_regrod    := 0;
  l_emavis    := '';
  l_vencnh    := l_data_zero;
  l_Inseriu_R090MVI := 'N';

  /* separa os valores da string do p_valStr em cada variÃ¡vel */
  BEGIN
    l_pos    := 3;
    l_datstr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos    := l_pos + 16;
    l_numcra := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
    l_pos    := l_pos + 12;
    l_idtCol := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_codpor := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_idtVis := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_tam    := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos    := l_pos + 2;
    IF (l_tam > 0) THEN
      l_nomvis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
    l_codprm := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 5));
    l_pos    := l_pos + 5;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_tel := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos := l_pos + l_tam;
    END IF;
  
    l_datvalStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos       := l_pos + 16;
    l_tipvis    := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos       := l_pos + 3;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos := l_pos + 3;
    IF (l_tam > 0) THEN
      l_obsvis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_codusu := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 10));
    l_pos    := l_pos + 10;
    l_assvid := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 1));
    l_pos    := l_pos + 1;
    l_codoem := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 8));
    l_pos    := l_pos + 8;
    l_numcon := SUBSTRING(p_ValStr, l_pos, 15);
    l_pos    := l_pos + 15;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_nomoem := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_codnac := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_cravei := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
    l_pos    := l_pos + 12;
    l_plavee := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place1 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place2 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place3 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_numlau := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, l_tam)));
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_regrod := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, l_tam));
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_emavis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_idtaut := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_verplf := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_codplf := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 7));
    l_pos    := l_pos + 7;
  
    l_numcnh    := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, 20)));
    l_pos       := l_pos + 20;
    l_catcnh    := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, 4)));
    l_pos       := l_pos + 4;
    l_vencnhStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos       := l_pos + 16;
    
    l_andvis := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
  
    /* converte data/hora inicial */
    l_datcon := SUBSTRING(l_datstr, 1, 2) || '/' ||
                SUBSTRING(l_datstr, 3, 2) || '/' ||
                SUBSTRING(l_datstr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datAlt OUT);
    l_horAlt := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 9, 2)));
    l_seqent := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 11, 2)));
  
    /* converte data validade */
    l_datcon := SUBSTRING(l_datvalStr, 1, 2) || '/' ||
                SUBSTRING(l_datvalStr, 3, 2) || '/' ||
                SUBSTRING(l_datvalStr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datval OUT);
    l_horval := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datvalStr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datvalStr, 9, 2)));
  
    /* desmontar IDTPES do colab. (visitado) */
    SP_PESFROMIDTPES(l_idtCol,
                     l_tippes OUT,
                     l_numemp OUT,
                     l_tipcol OUT,
                     l_numcad OUT,
                     l_tipdoc OUT,
                     l_numdoc OUT,
                     l_nummat OUT,
                     l_propac OUT);
  
    /* decodificar string de telefone */
    SP_DECFON(l_tel, l_DDI OUT, l_DDD OUT, l_Fone OUT);
  
    /* desmontar IDTPES do visitante */
    SP_PESFROMIDTPES(l_idtVis,
                     l_tippes OUT,
                     l_numempVis OUT,
                     l_tipcolVis OUT,
                     l_numcadVis OUT,
                     l_tipdocVis OUT,
                     l_numdocVis OUT,
                     l_nummat OUT,
                     l_propac OUT);
  
    /* converte data Venc. CNH */
    IF (l_vencnhStr IS NOT NULL AND l_vencnhStr <> '0000000000000000') THEN
      l_datcon := SUBSTRING(l_vencnhStr, 1, 2) || '/' ||
                  SUBSTRING(l_vencnhStr, 3, 2) || '/' ||
                  SUBSTRING(l_vencnhStr, 5, 2);
      SP_STRTODATE(l_datcon, 'DD/MM/AA', l_vencnh OUT);
    END IF;
  
    /* padronizar as placas tirando espaÃ§os e traÃ§os */
    l_plavee := LTRIM(RTRIM(REPLACE(REPLACE(l_plavee, '-', ''), ' ', '')));
    l_place1 := LTRIM(RTRIM(REPLACE(REPLACE(l_place1, '-', ''), ' ', '')));
    l_place2 := LTRIM(RTRIM(REPLACE(REPLACE(l_place2, '-', ''), ' ', '')));
    l_place3 := LTRIM(RTRIM(REPLACE(REPLACE(l_place3, '-', ''), ' ', '')));
  
    /* por causa do ORACLE que considera '' como NULL e no SQL-SERVER nÃ£o */
    IF  (l_plavee = '') THEN
      l_plavee := NULL;
    END IF;
        
    IF  (l_place1 = '') THEN
      l_place1 := NULL;
    END IF;
       
    IF  (l_place2 = '') THEN
      l_place2 := NULL;
    END IF;

    IF  (l_place3 = '') THEN
      l_place3 := NULL;
    END IF;
    
    IF  (l_numlau = '') THEN
      l_numlau := NULL;
    END IF;
    
    IF  (l_numcnh = '') THEN
      l_numcnh := NULL;
    END IF;
    
    IF  (l_catcnh = '') THEN
      l_catcnh := NULL;
    END IF;
  
  EXCEPTION
    WHEN OTHERS THEN
      l_coderr := 30; /* erro de conversÃ£o na string */
  END;

  /* Fechar histÃ³rico R090HCH se tiver algum em aberto */
  IF (l_codErr = 0) THEN
    /* Verificar R090HCH com data/hora final em aberto */
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R090HCH
       WHERE TIPDOC = l_tipdocVis
         AND NUMDOC = l_numdocVis
         AND ((DATFIM = l_data_zero) OR
             ((R090HCH.DATFIM > l_datAlt) OR
             ((R090HCH.DATFIM = l_datAlt) AND (R090HCH.HORFIM > l_horAlt))));
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  
    /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
    BEGIN
      IF (l_count > 0) THEN
        UPDATE R090HCH
           SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1, SEQREG = l_seqent
         WHERE TIPDOC = l_tipdocVis
           AND NUMDOC = l_numdocVis
           AND ((DATFIM = l_data_zero) OR ((R090HCH.DATFIM > l_datAlt) OR
               ((R090HCH.DATFIM = l_datAlt) AND
               (R090HCH.HORFIM > l_horAlt))));
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  END IF;

  IF (l_codErr = 0) THEN
    /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
    BEGIN
      UPDATE R090MVI
         SET DATSLO = l_datAlt,
             HORSLO = l_horAlt - 1,
             DATSAI = l_datAlt,
             HORSAI = l_horAlt - 1
       WHERE R090MVI.TIPDOC = l_tipdocVis
         AND R090MVI.NUMDOC = l_numdocVis
         AND R090MVI.DATSAI = l_data_zero;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  END IF;

  /* Inserir ou atualizar VISITANTE */
  IF (l_codErr = 0) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R090VIS
       WHERE TIPDOC = l_tipdocVis
         AND NUMDOC = l_numdocVis;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 33;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R090VIS
          (TIPDOC,
           NUMDOC,
           NOMVIS,
           CODOEM,
           NOMOEM,
           CODPRM,
           DDITEL,
           DDDTEL,
           TELCON,
           OBSVIS,
           CODNAC,
           EMAVIS,
           NUMCNH,
           CATCNH,
           VENCNH)
        VALUES
          (l_tipdocVis,
           l_numdocVis,
           l_nomvis,
           l_codoem,
           l_nomoem,
           l_codprm,
           l_DDI,
           l_DDD,
           l_Fone,
           l_obsvis,
           l_codnac,
           l_emavis,
           l_numcnh,
           l_catcnh,
           l_vencnh);
      ELSE
        UPDATE R090VIS
           SET NOMVIS = l_nomvis,
               CODOEM = l_codoem,
               NOMOEM = l_nomoem,
               CODPRM = l_codprm,
               DDITEL = l_DDI,
               DDDTEL = l_DDD,
               TELCON = l_Fone,
               OBSVIS = l_obsvis,
               CODNAC = l_codnac,
               EMAVIS = l_emavis
         WHERE TIPDOC = l_tipdocVis
           AND NUMDOC = l_numdocVis;
      
        IF (l_numcnh IS NOT NULL) THEN
          UPDATE R090VIS
             SET NUMCNH = l_numcnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      
        IF (l_catcnh IS NOT NULL) THEN
          UPDATE R090VIS
             SET CATCNH = l_catcnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      
        IF (l_vencnh <> l_data_zero) THEN
          UPDATE R090VIS
             SET VENCNH = l_vencnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 33;
    END;
  END IF;

  IF (l_codErr = 0 AND l_plavee IS NOT NULL) THEN
    /* Verifica se tem um histÃ³rico de crachÃ¡ em aberto para esta placa de veÃ­culo */
    BEGIN
      SELECT NUMCRA
        INTO l_CraVeiOld
        FROM R088HCH
       WHERE PLAVEI = l_plavee
         AND ((DATINI < l_datAlt OR
             (DATINI = l_datAlt AND HORINI <= l_horAlt)) AND
             (DATFIM > l_datAlt OR
             (DATFIM = l_datAlt AND HORFIM >= l_horAlt)) OR
             DATFIM = l_data_zero);
    
      /* Finaliza o histÃ³rico de crachÃ¡ atual */
      IF (l_CraVeiOld > 0) THEN
        UPDATE R088HCH
           SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1
         WHERE NUMCRA = l_CraVeiOld
           AND ((DATINI < l_datAlt OR
               (DATINI = l_datAlt AND HORINI <= l_horAlt)) AND
               (DATFIM > l_datAlt OR
               (DATFIM = l_datAlt AND HORFIM >= l_horAlt)) OR
               DATFIM = l_data_zero);
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        NULL;
    END;
  
    /* Inclui Placa VeÃ­culo se nÃ£o existir */
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_plavee;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 34;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_plavee, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    /* Verificar se tem PLACA E CRAVEI  */
    IF (l_cravei > 0) THEN
      BEGIN
        /* Insere um novo histÃ³rico de crachÃ¡ */
        INSERT INTO R088HCH
        VALUES
          (l_plavee, l_datAlt, l_horAlt, l_cravei, l_datval, l_horval, 0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 34;
      END;
    END IF;
  END IF;

  IF (l_codErr = 0 AND l_place1 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place1;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place1, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0 AND l_place2 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place2;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place2, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0 AND l_place3 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place3;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place3, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0) THEN
    WHILE (l_Inseriu_R090MVI = 'N') LOOP
      BEGIN
        INSERT INTO R090MVI
          (datent,
           horent,
           seqent,
           numcra,
           numemp,
           tipcol,
           numcad,
           codprm,
           tipvis,
           obsvis,
           codusu,
           assvid,
           codoem,
           numcon,
           nomoem,
           codnac,
           cravei,
           codpor,
           datval,
           horval,
           plavee,
           PlaCae,
           place2,
           place3,
           dditel,
           dddtel,
           telcon,
           tipdoc,
           numdoc,
           emavis,
           verplf,
           codplf,
           datsai,
           horsai,
           datslo,
           horslo,
           andvis)
        VALUES
          (l_datAlt,
           l_horAlt,
           l_seqent,
           l_numcra,
           l_numemp,
           l_tipcol,
           l_numcad,
           l_codprm,
           l_tipvis,
           l_obsvis,
           l_codusu,
           l_assvid,
           l_codoem,
           l_numcon,
           l_nomoem,
           l_codnac,
           l_cravei,
           l_codpor,
           l_datval,
           l_horval,
           l_plavee,
           l_place1,
           l_place2,
           l_place3,
           l_DDI,
           l_DDD,
           l_Fone,
           l_tipdocVis,
           l_numdocVis,
           l_emavis,
           l_verplf,
           l_codplf,
           l_data_zero,
           0,
           l_data_zero,
           0, l_andvis);
        
        l_Inseriu_R090MVI := 'S';
      EXCEPTION
        WHEN OTHERS THEN
          IF (l_seqent = 59) THEN
            l_seqent := 0;
            l_horAlt := l_horAlt + 1;
          ELSE
            l_seqent := l_seqent + 1;
          END IF;          
      END;
    END LOOP; /* Fim loop*/
  END IF;

  IF (l_codErr = 0) THEN
    BEGIN
      INSERT INTO R090HCH
        (TIPDOC, NUMDOC, DATINI, HORINI, SEQENT, NUMCRA, DATFIM, HORFIM)
      VALUES
        (l_tipdocVis,
         l_numdocVis,
         l_datAlt,
         l_horAlt,
         l_seqent,
         l_numcra,
         l_data_zero,
         0);
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  
    IF (l_codErr = 0) THEN
      BEGIN
        IF ((l_numlau IS NOT NULL) OR (l_regrod > 0)) THEN
          INSERT INTO R090LAU
            (datent, horent, seqent, numlau, regrod, datins)
          VALUES
            (l_datAlt, l_horAlt, l_seqent, l_numlau, l_regrod, l_datins);
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 34;
      END;
    
      /* Incluir registro na R090VAU, se necessÃ¡rio */
      BEGIN
        SELECT VISVAU
          INTO l_VisVau
          FROM R090PRO
         WHERE TIPVIS = l_tipvis
           AND PROVIS = 7
           AND CONPRO = 2;
        l_count := 1;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_count := 0;
        WHEN TOO_MANY_ROWS THEN
          l_codErr := 36;
          l_count  := 0;
        WHEN OTHERS THEN
          l_codErr := 36;
          l_count  := 0;
      END;
    
      BEGIN
        IF (l_count = 1) THEN
          IF (l_VisVau = 'S') THEN
            /* ValidaÃ§Ã£o por Autorizador */
            INSERT INTO R090VAU
              (datent, horent, seqent, idtpes, idtaut, datfim, horfim)
            VALUES
              (l_datAlt,
               l_horAlt,
               l_seqent,
               l_idtVis,
               l_idtVis,
               l_datval,
               l_horval);
          ELSE
            /*So insere se tiver autorizador*/
            IF (LTRIM(RTRIM(l_idtAut)) <> '') THEN
              /* Validacao por Autorizador */
              INSERT INTO R090VAU
                (datent, horent, seqent, idtpes, idtaut, datfim, horfim)
              VALUES
                (l_datAlt,
                 l_horAlt,
                 l_seqent,
                 l_idtVis,
                 l_idtAut,
                 l_datval,
                 l_horval);
            END IF;
          END IF;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 36;
      END;
    END IF;
  END IF;

  /* R090VID */
  IF (l_codErr = 0 AND l_assvid = '1') THEN
  
    BEGIN
      SELECT CODPLT INTO l_codplt FROM r058por WHERE CODPOR = l_codpor;
    EXCEPTION
      WHEN OTHERS THEN l_codplt := 0;
    END;

    BEGIN
      SELECT VIDPLA INTO l_VIDPLA FROM R090TVI WHERE TIPVIS = l_tipvis;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_VIDPLA := 'N';
      WHEN OTHERS THEN NULL;
    END;
    
    IF (l_VIDPLA = 'S') THEN
      BEGIN
        SELECT COUNT(*) INTO l_count FROM R090VID WHERE CODPLT=l_codplt AND TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
      EXCEPTION
        WHEN OTHERS THEN l_count := 0;
      END;

      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VID (CODPLT, TIPDOC, NUMDOC, DATVID) VALUES (l_codplt, l_tipdocVis, l_numdocVis, l_datAlt);
        ELSE
          UPDATE R090VID SET DATVID = l_datAlt WHERE CODPLT=l_codplt AND TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 38;
      END;
    ELSE
      BEGIN
        SELECT COUNT(*) INTO l_count FROM R090VID WHERE TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
      EXCEPTION
        WHEN OTHERS THEN l_count := 0;
      END;

      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VID (CODPLT, TIPDOC, NUMDOC, DATVID) VALUES (l_codplt, l_tipdocVis, l_numdocVis, l_datAlt);
        ELSE
          UPDATE R090VID SET DATVID = l_datAlt WHERE TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
        END IF;      
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 38;
      END;
    END IF;
  END IF;
  
  /* Executa a auditoria de registros */
  IF (l_codErr = 0) THEN
  
    IF (LTRIM(RTRIM(l_idtAut)) <> '') THEN
      /* desmontar IDTPES do autorizador */
      SP_PESFROMIDTPES(l_idtAut,
                       l_tippes OUT,
                       l_empAut OUT,
                       l_tipaut OUT,
                       l_cadaut OUT,
                       l_tipdocAut OUT,
                       l_numdocAut OUT,
                       l_nummat OUT,
                       l_propac OUT);
                     
      IF (l_tippes > 3) THEN
        l_empaut := 0;
        l_tipaut := 0;
        l_cadaut := 0;
      END IF;               
    ELSE
      l_empaut := 0;
      l_tipaut := 0;
      l_cadaut := 0;
    END IF;
  
    SP_SinAudMVI(0,
                 l_codpor,
                 l_datALT,
                 l_horalt,
                 l_seqent,
                 l_tipdocVis,
                 l_numdocVis,
                 l_numemp,
                 l_tipcol,
                 l_numcad,
                 l_numcra,
                 l_codnac,
                 l_nomvis,
                 l_codoem,
                 l_nomoem,
                 l_DDI,
                 l_DDD,
                 l_Fone,
                 l_tipvis,
                 l_codprm,
                 l_datval,
                 l_horval,
                 l_obsvis,
                 l_plavee,
                 l_place1,
                 l_place2,
                 l_place3,
                 l_numlau,
                 l_regrod,
                 /*p_numcnh   IN NUMBER(4), p_catcnh   IN VARCHAR2(20), p_vencnh   IN DATE,*/
                 l_assvid,
                 l_codoem,
                 l_numcon,
                 l_empaut,
                 l_tipaut,
                 l_cadaut,
                 l_codusu,
                 l_datALT,
                 l_horalt,
                 l_emavis,
                 l_verplf,
                 l_codplf,
                 l_codErr OUT);
  END IF;


  IF (l_codErr = 0) THEN
  
    /* se não tem acompanhante na string, não consegue converter */
    IF (Length(p_ValStr) > l_pos) THEN
        l_qtdaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
        l_pos := l_pos + 2;
    ELSE
        l_qtdaco := 0;
    END IF;

    l_contLoop := 1;

    /* LOOP Acompanhantes */
    WHILE (l_contLoop <= l_qtdaco) LOOP
      l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
      l_pos := l_pos + 2;
      IF (l_tam > 0) THEN
        l_nomaco := SUBSTRING(p_ValStr, l_pos, l_tam);
        l_pos := l_pos + l_tam;
      END IF;

      l_idtpesaco := SUBSTRING(p_ValStr, l_pos, 23);
      l_pos := l_pos + 23;

      l_codoem := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 8));
      l_pos := l_pos + 8;

      l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
      l_pos    := l_pos + 2;
      IF (l_tam > 0) THEN
        l_nomoem := SUBSTRING(p_ValStr, l_pos, l_tam);
        l_pos := l_pos + l_tam;
      END IF;

      l_codnac := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
      l_pos := l_pos + 3;

      l_numcraaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
      l_pos := l_pos + 12;

      /* desmontar IDTPES do visitante */
      SP_PESFROMIDTPES(l_idtpesaco,
                       l_tippes OUT,
                       l_numempAco OUT,
                       l_tipcolAco OUT,
                       l_numcadAco OUT,
                       l_tipdocAco OUT,
                       l_numdocAco OUT,
                       l_nummat OUT,
                       l_propac OUT);

      /* Fechar historico R090HCH se tiver algum em aberto */
      IF (l_codErr = 0) THEN
        /* Verificar R090HCH com data/hora final em aberto */
        BEGIN
          SELECT COUNT(*) QNTREG
            INTO l_count
            FROM R090HCH
           WHERE TIPDOC = l_tipdocAco
             AND NUMDOC = l_numdocAco
             AND ((DATFIM = l_data_zero) OR
                 ((R090HCH.DATFIM > l_datAlt) OR
                 ((R090HCH.DATFIM = l_datAlt) AND (R090HCH.HORFIM > l_horAlt))));
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
  
        /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
        BEGIN
          IF (l_count > 0) THEN
            UPDATE R090HCH
               SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1, SEQREG = l_seqent
             WHERE TIPDOC = l_tipdocAco
               AND NUMDOC = l_numdocAco
               AND ((DATFIM = l_data_zero) OR ((R090HCH.DATFIM > l_datAlt) OR
                   ((R090HCH.DATFIM = l_datAlt) AND
                   (R090HCH.HORFIM > l_horAlt))));
          END IF;
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
      END IF;

      IF (l_codErr = 0) THEN
        /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
        BEGIN
          UPDATE R090MVI
             SET DATSLO = l_datAlt,
                 HORSLO = l_horAlt - 1,
                 DATSAI = l_datAlt,
                 HORSAI = l_horAlt - 1
           WHERE R090MVI.TIPDOC = l_tipdocAco
             AND R090MVI.NUMDOC = l_numdocAco
             AND R090MVI.DATSAI = l_data_zero;
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
      END IF;

      /* Inserir ou atualizar VISITANTE */
      BEGIN
        SELECT COUNT(*) QNTREG
          INTO l_count
          FROM R090VIS
         WHERE TIPDOC = l_tipdocAco
           AND NUMDOC = l_numdocAco;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 33;
      END;
      
      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VIS
            (TIPDOC,
             NUMDOC,
             NOMVIS,
             CODOEM,
             NOMOEM,
             CODPRM,
             CODNAC)
          VALUES
            (l_tipdocAco,
             l_numdocAco,
             l_nomaco,
             l_codoem,
             l_nomoem,
             l_codprm,
             l_codnac);
        ELSE
          UPDATE R090VIS
             SET NOMVIS = l_nomaco,
                 CODOEM = l_codoem,
                 NOMOEM = l_nomoem,
                 CODPRM = l_codprm,
                 CODNAC = l_codnac
           WHERE TIPDOC = l_tipdocAco
             AND NUMDOC = l_numdocAco;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 33;
      END;

      /*ACOMPANHANTE*/
      BEGIN
        INSERT INTO R090ACO (DatEnt, HorEnt, SeqEnt, TipDoc, NumDoc, NumCra, CodNac, AssVid, DatSlo, HorSlo, DatSai, HorSai)
        VALUES (l_datAlt,
                l_horAlt,
                l_seqent,
                l_tipdocAco,
                l_numdocAco,
                l_numcraAco,
                l_codnac,
                l_assvid,
                l_data_zero,
        		0,
        		l_data_zero,
        		0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 53;
      END;
      
      /* Grava histórico de Crachá para o acompanhante */
      BEGIN
      	INSERT INTO R090HCH(TIPDOC, NUMDOC, DATINI, HORINI, SEQENT, NUMCRA, DATFIM, HORFIM)
      	VALUES (l_tipdocAco,
               	l_numdocAco,
        		l_datAlt,
        		l_horAlt,
        		l_seqent,
        		l_numcraAco,
        		l_data_zero,
        		0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 32;
   	  END;
 
      l_contLoop := l_contLoop + 1;
    END LOOP;
    /* FIM - LOOP Acompanhantes */
    
    l_datprvStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_datcon := SUBSTRING(l_datprvStr, 1, 2) || '/' ||
                SUBSTRING(l_datprvStr, 3, 2) || '/' ||
                SUBSTRING(l_datprvStr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datprv OUT);
    l_horprv := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 9, 2)));
    l_seqprv := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 11, 2)));
    
  END IF;
    	
  BEGIN
      UPDATE R090AGV SET 
        VISEFE = 'S' 
    	WHERE 
    		R090AGV.DATPRV = l_datprv AND 
    		R090AGV.HORPRV = l_horprv AND 
    		R090AGV.SEQAGV = l_seqprv AND
    		R090AGV.NUMEMP = l_numemp AND
    		R090AGV.TIPCOL = l_tipcol AND
    		R090AGV.NUMCAD = l_numcad;
    	EXCEPTION
    		WHEN OTHERS THEN
    		l_codErr := 32;
    END;

  /* retorna Codigo do erro */
  p_retErr := l_codErr;
END		SENIOR;219SP_STRTODATE
SP_PESFROMIDTPES
SP_DECFON
SP_SinAudMVI
K|␀␀

/* Processa demanda de sicronismo - 05 = Entrada de visitantes (R090MVI)   */
PROCEDURE SP_SINENTVIS(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

  l_datstr    VARCHAR2(16);  
  l_usocra    NUMBER(2);
  l_numcra    NUMBER(12);
  l_idtvis    VARCHAR2(23);
  l_idtCol    VARCHAR2(23);
  l_tam       NUMBER(3);
  l_pos       NUMBER(3);
  l_codpor    NUMBER(3);
  l_nomvis    VARCHAR2(40);
  l_codprm    NUMBER(5);
  l_tel       VARCHAR2(100);
  l_datvalStr VARCHAR2(16);
  l_datval    DATE;
  l_horval    NUMBER(4);
  l_tipvis    VARCHAR2(3);
  l_obsvis    VARCHAR2(160);
  l_codoem    NUMBER(8);
  l_numcon    VARCHAR2(15);
  l_codnac    NUMBER(3);
  l_cravei    NUMBER(12);
  l_CraVeiOld NUMBER(12);
  l_plavee    VARCHAR2(10);
  l_place1    VARCHAR2(10);
  l_place2    VARCHAR2(10);
  l_place3    VARCHAR2(10);
  l_datalt    DATE;
  l_assvid    VARCHAR2(1);
  l_nomoem    VARCHAR2(60);
  l_numlau    VARCHAR2(12);
  l_regrod    NUMBER(9);
  l_codusu    NUMBER(10);
  l_coderr    NUMBER(2);

  /*VariÃ¡veis auxiliares para conversÃ£o de data*/
  l_datcon VARCHAR2(25);
  l_horAlt NUMBER(4);
  l_seqent NUMBER(2);

  l_datins    DATE;
  l_tippes    NUMBER(2);
  l_numemp    NUMBER(4);
  l_tipcol    NUMBER(1);
  l_numcad    NUMBER(9);
  l_tipdoc    NUMBER(1);
  l_numdoc    VARCHAR2(20);
  l_nummat    VARCHAR2(15);
  l_propac    VARCHAR2(20);
  l_DDI       NUMBER(3);
  l_DDD       NUMBER(3);
  l_Fone      VARCHAR2(20);
  l_count     NUMBER(1);
  l_numempVis NUMBER(4);
  l_tipcolVis NUMBER(1);
  l_numcadVis NUMBER(9);
  l_tipdocVis NUMBER(1);
  l_numdocVis VARCHAR2(20);
  l_idtaut    VARCHAR2(23);
  l_VisVau    CHAR(1);
  l_data_zero DATE;
  l_empaut    NUMBER(4);
  l_tipaut    NUMBER(1);
  l_cadaut    NUMBER(9);
  l_tipdocAut NUMBER(1);
  l_numdocAut VARCHAR2(20);

  l_emavis    VARCHAR2(50);
  l_verplf    NUMBER(3);
  l_codplf    NUMBER(7);
  l_numcnh    VARCHAR2(20);
  l_catcnh    VARCHAR2(4);
  l_vencnhStr VARCHAR2(16);
  l_vencnh    DATE;
  l_andvis    NUMBER(3);
  l_VIDPLA    VARCHAR2(1);
  l_codplt    NUMBER(7);
  
  /*acompanhantes*/
  l_qtdaco    NUMBER(2);
  l_nomaco    VARCHAR2(99);
  l_idtpesaco VARCHAR2(23);
  l_numcraaco NUMBER(12);
  l_numempAco NUMBER(4);
  l_tipcolAco NUMBER(1);
  l_numcadAco NUMBER(9);
  l_tipdocAco NUMBER(1);
  l_numdocAco VARCHAR2(20);
  l_contLoop  NUMBER(2);
  
  l_datprvStr VARCHAR2(16);
  l_datprv    DATE;
  l_horprv    NUMBER(4);
  l_seqprv    NUMBER(2);
  
  l_Inseriu_R090MVI VARCHAR2(1);
BEGIN
  /* inicializa variÃ¡veis */
  l_coderr    := 0;
  p_RetErr    := 0;
  l_datins    := CURDATE();
  l_codusu    := 0;
  l_horAlt    := 0;
  l_data_zero := '31/12/1900,00:00:00';
  l_nomvis    := '';
  l_tel       := '';
  l_obsvis    := '';
  l_nomoem    := '';
  l_numlau    := '';
  l_regrod    := 0;
  l_emavis    := '';
  l_vencnh    := l_data_zero;
  l_Inseriu_R090MVI := 'N';

  /* separa os valores da string do p_valStr em cada variÃ¡vel */
  BEGIN
    l_pos    := 3;
    l_datstr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos    := l_pos + 16;
    l_numcra := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
    l_pos    := l_pos + 12;
    l_idtCol := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_codpor := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_idtVis := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_tam    := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos    := l_pos + 2;
    IF (l_tam > 0) THEN
      l_nomvis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
    l_codprm := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 5));
    l_pos    := l_pos + 5;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_tel := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos := l_pos + l_tam;
    END IF;
  
    l_datvalStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos       := l_pos + 16;
    l_tipvis    := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos       := l_pos + 3;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos := l_pos + 3;
    IF (l_tam > 0) THEN
      l_obsvis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_codusu := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 10));
    l_pos    := l_pos + 10;
    l_assvid := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 1));
    l_pos    := l_pos + 1;
    l_codoem := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 8));
    l_pos    := l_pos + 8;
    l_numcon := SUBSTRING(p_ValStr, l_pos, 15);
    l_pos    := l_pos + 15;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_nomoem := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_codnac := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_cravei := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
    l_pos    := l_pos + 12;
    l_plavee := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place1 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place2 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place3 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_numlau := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, l_tam)));
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_regrod := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, l_tam));
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_emavis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_idtaut := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_verplf := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_codplf := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 7));
    l_pos    := l_pos + 7;
  
    l_numcnh    := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, 20)));
    l_pos       := l_pos + 20;
    l_catcnh    := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, 4)));
    l_pos       := l_pos + 4;
    l_vencnhStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos       := l_pos + 16;
    
    l_andvis := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
  
    /* converte data/hora inicial */
    l_datcon := SUBSTRING(l_datstr, 1, 2) || '/' ||
                SUBSTRING(l_datstr, 3, 2) || '/' ||
                SUBSTRING(l_datstr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datAlt OUT);
    l_horAlt := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 9, 2)));
    l_seqent := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 11, 2)));
  
    /* converte data validade */
    l_datcon := SUBSTRING(l_datvalStr, 1, 2) || '/' ||
                SUBSTRING(l_datvalStr, 3, 2) || '/' ||
                SUBSTRING(l_datvalStr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datval OUT);
    l_horval := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datvalStr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datvalStr, 9, 2)));
  
    /* desmontar IDTPES do colab. (visitado) */
    SP_PESFROMIDTPES(l_idtCol,
                     l_tippes OUT,
                     l_numemp OUT,
                     l_tipcol OUT,
                     l_numcad OUT,
                     l_tipdoc OUT,
                     l_numdoc OUT,
                     l_nummat OUT,
                     l_propac OUT);
  
    /* decodificar string de telefone */
    SP_DECFON(l_tel, l_DDI OUT, l_DDD OUT, l_Fone OUT);
  
    /* desmontar IDTPES do visitante */
    SP_PESFROMIDTPES(l_idtVis,
                     l_tippes OUT,
                     l_numempVis OUT,
                     l_tipcolVis OUT,
                     l_numcadVis OUT,
                     l_tipdocVis OUT,
                     l_numdocVis OUT,
                     l_nummat OUT,
                     l_propac OUT);
  
    /* converte data Venc. CNH */
    IF (l_vencnhStr IS NOT NULL AND l_vencnhStr <> '0000000000000000') THEN
      l_datcon := SUBSTRING(l_vencnhStr, 1, 2) || '/' ||
                  SUBSTRING(l_vencnhStr, 3, 2) || '/' ||
                  SUBSTRING(l_vencnhStr, 5, 2);
      SP_STRTODATE(l_datcon, 'DD/MM/AA', l_vencnh OUT);
    END IF;
  
    /* padronizar as placas tirando espaÃ§os e traÃ§os */
    l_plavee := LTRIM(RTRIM(REPLACE(REPLACE(l_plavee, '-', ''), ' ', '')));
    l_place1 := LTRIM(RTRIM(REPLACE(REPLACE(l_place1, '-', ''), ' ', '')));
    l_place2 := LTRIM(RTRIM(REPLACE(REPLACE(l_place2, '-', ''), ' ', '')));
    l_place3 := LTRIM(RTRIM(REPLACE(REPLACE(l_place3, '-', ''), ' ', '')));
  
    /* por causa do ORACLE que considera '' como NULL e no SQL-SERVER nÃ£o */
    IF  (l_plavee = '') THEN
      l_plavee := NULL;
    END IF;
        
    IF  (l_place1 = '') THEN
      l_place1 := NULL;
    END IF;
       
    IF  (l_place2 = '') THEN
      l_place2 := NULL;
    END IF;

    IF  (l_place3 = '') THEN
      l_place3 := NULL;
    END IF;
    
    IF  (l_numlau = '') THEN
      l_numlau := NULL;
    END IF;
    
    IF  (l_numcnh = '') THEN
      l_numcnh := NULL;
    END IF;
    
    IF  (l_catcnh = '') THEN
      l_catcnh := NULL;
    END IF;
  
  EXCEPTION
    WHEN OTHERS THEN
      l_coderr := 30; /* erro de conversÃ£o na string */
  END;

  /* Fechar histÃ³rico R090HCH se tiver algum em aberto */
  IF (l_codErr = 0) THEN
    /* Verificar R090HCH com data/hora final em aberto */
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R090HCH
       WHERE TIPDOC = l_tipdocVis
         AND NUMDOC = l_numdocVis
         AND ((DATFIM = l_data_zero) OR
             ((R090HCH.DATFIM > l_datAlt) OR
             ((R090HCH.DATFIM = l_datAlt) AND (R090HCH.HORFIM > l_horAlt))));
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  
    /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
    BEGIN
      IF (l_count > 0) THEN
        UPDATE R090HCH
           SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1, SEQREG = l_seqent
         WHERE TIPDOC = l_tipdocVis
           AND NUMDOC = l_numdocVis
           AND ((DATFIM = l_data_zero) OR ((R090HCH.DATFIM > l_datAlt) OR
               ((R090HCH.DATFIM = l_datAlt) AND
               (R090HCH.HORFIM > l_horAlt))));
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  END IF;

  IF (l_codErr = 0) THEN
    /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
    BEGIN
      UPDATE R090MVI
         SET DATSLO = l_datAlt,
             HORSLO = l_horAlt - 1,
             DATSAI = l_datAlt,
             HORSAI = l_horAlt - 1
       WHERE R090MVI.TIPDOC = l_tipdocVis
         AND R090MVI.NUMDOC = l_numdocVis
         AND R090MVI.DATSAI = l_data_zero;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  END IF;

  /* Inserir ou atualizar VISITANTE */
  IF (l_codErr = 0) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R090VIS
       WHERE TIPDOC = l_tipdocVis
         AND NUMDOC = l_numdocVis;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 33;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R090VIS
          (TIPDOC,
           NUMDOC,
           NOMVIS,
           CODOEM,
           NOMOEM,
           CODPRM,
           DDITEL,
           DDDTEL,
           TELCON,
           OBSVIS,
           CODNAC,
           EMAVIS,
           NUMCNH,
           CATCNH,
           VENCNH)
        VALUES
          (l_tipdocVis,
           l_numdocVis,
           l_nomvis,
           l_codoem,
           l_nomoem,
           l_codprm,
           l_DDI,
           l_DDD,
           l_Fone,
           l_obsvis,
           l_codnac,
           l_emavis,
           l_numcnh,
           l_catcnh,
           l_vencnh);
      ELSE
        UPDATE R090VIS
           SET NOMVIS = l_nomvis,
               CODOEM = l_codoem,
               NOMOEM = l_nomoem,
               CODPRM = l_codprm,
               DDITEL = l_DDI,
               DDDTEL = l_DDD,
               TELCON = l_Fone,
               OBSVIS = l_obsvis,
               CODNAC = l_codnac,
               EMAVIS = l_emavis
         WHERE TIPDOC = l_tipdocVis
           AND NUMDOC = l_numdocVis;
      
        IF (l_numcnh IS NOT NULL) THEN
          UPDATE R090VIS
             SET NUMCNH = l_numcnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      
        IF (l_catcnh IS NOT NULL) THEN
          UPDATE R090VIS
             SET CATCNH = l_catcnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      
        IF (l_vencnh <> l_data_zero) THEN
          UPDATE R090VIS
             SET VENCNH = l_vencnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 33;
    END;
  END IF;

  IF (l_codErr = 0 AND l_plavee IS NOT NULL) THEN
    /* Verifica se tem um histÃ³rico de crachÃ¡ em aberto para esta placa de veÃ­culo */
    BEGIN
      SELECT NUMCRA
        INTO l_CraVeiOld
        FROM R088HCH
       WHERE PLAVEI = l_plavee
         AND ((DATINI < l_datAlt OR
             (DATINI = l_datAlt AND HORINI <= l_horAlt)) AND
             (DATFIM > l_datAlt OR
             (DATFIM = l_datAlt AND HORFIM >= l_horAlt)) OR
             DATFIM = l_data_zero);
    
      /* Finaliza o histÃ³rico de crachÃ¡ atual */
      IF (l_CraVeiOld > 0) THEN
        UPDATE R088HCH
           SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1
         WHERE NUMCRA = l_CraVeiOld
           AND ((DATINI < l_datAlt OR
               (DATINI = l_datAlt AND HORINI <= l_horAlt)) AND
               (DATFIM > l_datAlt OR
               (DATFIM = l_datAlt AND HORFIM >= l_horAlt)) OR
               DATFIM = l_data_zero);
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        NULL;
    END;
  
    /* Inclui Placa VeÃ­culo se nÃ£o existir */
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_plavee;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 34;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_plavee, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    /* Verificar se tem PLACA E CRAVEI  */
    IF (l_cravei > 0) THEN
      BEGIN
        /* Insere um novo histÃ³rico de crachÃ¡ */
        INSERT INTO R088HCH
        VALUES
          (l_plavee, l_datAlt, l_horAlt, l_cravei, l_datval, l_horval, 0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 34;
      END;
    END IF;
  END IF;

  IF (l_codErr = 0 AND l_place1 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place1;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place1, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0 AND l_place2 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place2;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place2, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0 AND l_place3 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place3;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place3, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0) THEN
    WHILE (l_Inseriu_R090MVI = 'N') LOOP
      BEGIN
        INSERT INTO R090MVI
          (datent,
           horent,
           seqent,
           numcra,
           numemp,
           tipcol,
           numcad,
           codprm,
           tipvis,
           obsvis,
           codusu,
           assvid,
           codoem,
           numcon,
           nomoem,
           codnac,
           cravei,
           codpor,
           datval,
           horval,
           plavee,
           PlaCae,
           place2,
           place3,
           dditel,
           dddtel,
           telcon,
           tipdoc,
           numdoc,
           emavis,
           verplf,
           codplf,
           datsai,
           horsai,
           datslo,
           horslo,
           andvis)
        VALUES
          (l_datAlt,
           l_horAlt,
           l_seqent,
           l_numcra,
           l_numemp,
           l_tipcol,
           l_numcad,
           l_codprm,
           l_tipvis,
           l_obsvis,
           l_codusu,
           l_assvid,
           l_codoem,
           l_numcon,
           l_nomoem,
           l_codnac,
           l_cravei,
           l_codpor,
           l_datval,
           l_horval,
           l_plavee,
           l_place1,
           l_place2,
           l_place3,
           l_DDI,
           l_DDD,
           l_Fone,
           l_tipdocVis,
           l_numdocVis,
           l_emavis,
           l_verplf,
           l_codplf,
           l_data_zero,
           0,
           l_data_zero,
           0, l_andvis);
        
        l_Inseriu_R090MVI := 'S';
      EXCEPTION
        WHEN OTHERS THEN
          IF (l_seqent = 59) THEN
            l_seqent := 0;
            l_horAlt := l_horAlt + 1;
          ELSE
            l_seqent := l_seqent + 1;
          END IF;          
      END;
    END LOOP; /* Fim loop*/
  END IF;

  IF (l_codErr = 0) THEN
    BEGIN
      INSERT INTO R090HCH
        (TIPDOC, NUMDOC, DATINI, HORINI, SEQENT, NUMCRA, DATFIM, HORFIM)
      VALUES
        (l_tipdocVis,
         l_numdocVis,
         l_datAlt,
         l_horAlt,
         l_seqent,
         l_numcra,
         l_data_zero,
         0);
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  
    IF (l_codErr = 0) THEN
      BEGIN
        IF ((l_numlau IS NOT NULL) OR (l_regrod > 0)) THEN
          INSERT INTO R090LAU
            (datent, horent, seqent, numlau, regrod, datins)
          VALUES
            (l_datAlt, l_horAlt, l_seqent, l_numlau, l_regrod, l_datins);
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 34;
      END;
    
      /* Incluir registro na R090VAU, se necessÃ¡rio */
      BEGIN
        SELECT VISVAU
          INTO l_VisVau
          FROM R090PRO
         WHERE TIPVIS = l_tipvis
           AND PROVIS = 7
           AND CONPRO = 2;
        l_count := 1;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_count := 0;
        WHEN TOO_MANY_ROWS THEN
          l_codErr := 36;
          l_count  := 0;
        WHEN OTHERS THEN
          l_codErr := 36;
          l_count  := 0;
      END;
    
      BEGIN
        IF (l_count = 1) THEN
          IF (l_VisVau = 'S') THEN
            /* ValidaÃ§Ã£o por Autorizador */
            INSERT INTO R090VAU
              (datent, horent, seqent, idtpes, idtaut, datfim, horfim)
            VALUES
              (l_datAlt,
               l_horAlt,
               l_seqent,
               l_idtVis,
               l_idtVis,
               l_datval,
               l_horval);
          ELSE
            /*So insere se tiver autorizador*/
            IF (LTRIM(RTRIM(l_idtAut)) <> '') THEN
              /* Validacao por Autorizador */
              INSERT INTO R090VAU
                (datent, horent, seqent, idtpes, idtaut, datfim, horfim)
              VALUES
                (l_datAlt,
                 l_horAlt,
                 l_seqent,
                 l_idtVis,
                 l_idtAut,
                 l_datval,
                 l_horval);
            END IF;
          END IF;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 36;
      END;
    END IF;
  END IF;

  /* R090VID */
  IF (l_codErr = 0 AND l_assvid = '1') THEN
  
    BEGIN
      SELECT CODPLT INTO l_codplt FROM r058por WHERE CODPOR = l_codpor;
    EXCEPTION
      WHEN OTHERS THEN l_codplt := 0;
    END;

    BEGIN
      SELECT VIDPLA INTO l_VIDPLA FROM R090TVI WHERE TIPVIS = l_tipvis;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_VIDPLA := 'N';
      WHEN OTHERS THEN NULL;
    END;
    
    IF (l_VIDPLA = 'S') THEN
      BEGIN
        SELECT COUNT(*) INTO l_count FROM R090VID WHERE CODPLT=l_codplt AND TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
      EXCEPTION
        WHEN OTHERS THEN l_count := 0;
      END;

      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VID (CODPLT, TIPDOC, NUMDOC, DATVID) VALUES (l_codplt, l_tipdocVis, l_numdocVis, l_datAlt);
        ELSE
          UPDATE R090VID SET DATVID = l_datAlt WHERE CODPLT=l_codplt AND TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 38;
      END;
    ELSE
      BEGIN
        SELECT COUNT(*) INTO l_count FROM R090VID WHERE TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
      EXCEPTION
        WHEN OTHERS THEN l_count := 0;
      END;

      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VID (CODPLT, TIPDOC, NUMDOC, DATVID) VALUES (l_codplt, l_tipdocVis, l_numdocVis, l_datAlt);
        ELSE
          UPDATE R090VID SET DATVID = l_datAlt WHERE TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
        END IF;      
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 38;
      END;
    END IF;
  END IF;
  
  /* Executa a auditoria de registros */
  IF (l_codErr = 0) THEN
  
    IF (LTRIM(RTRIM(l_idtAut)) <> '') THEN
      /* desmontar IDTPES do autorizador */
      SP_PESFROMIDTPES(l_idtAut,
                       l_tippes OUT,
                       l_empAut OUT,
                       l_tipaut OUT,
                       l_cadaut OUT,
                       l_tipdocAut OUT,
                       l_numdocAut OUT,
                       l_nummat OUT,
                       l_propac OUT);
                     
      IF (l_tippes > 3) THEN
        l_empaut := 0;
        l_tipaut := 0;
        l_cadaut := 0;
      END IF;               
    ELSE
      l_empaut := 0;
      l_tipaut := 0;
      l_cadaut := 0;
    END IF;
  
    SP_SinAudMVI(0,
                 l_codpor,
                 l_datALT,
                 l_horalt,
                 l_seqent,
                 l_tipdocVis,
                 l_numdocVis,
                 l_numemp,
                 l_tipcol,
                 l_numcad,
                 l_numcra,
                 l_codnac,
                 l_nomvis,
                 l_codoem,
                 l_nomoem,
                 l_DDI,
                 l_DDD,
                 l_Fone,
                 l_tipvis,
                 l_codprm,
                 l_datval,
                 l_horval,
                 l_obsvis,
                 l_plavee,
                 l_place1,
                 l_place2,
                 l_place3,
                 l_numlau,
                 l_regrod,
                 /*p_numcnh   IN NUMBER(4), p_catcnh   IN VARCHAR2(20), p_vencnh   IN DATE,*/
                 l_assvid,
                 l_codoem,
                 l_numcon,
                 l_empaut,
                 l_tipaut,
                 l_cadaut,
                 l_codusu,
                 l_datALT,
                 l_horalt,
                 l_emavis,
                 l_verplf,
                 l_codplf,
                 l_codErr OUT);
  END IF;


  IF (l_codErr = 0) THEN
  
    /* se não tem acompanhante na string, não consegue converter */
    IF (Length(p_ValStr) > l_pos) THEN
        l_qtdaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
        l_pos := l_pos + 2;
    ELSE
        l_qtdaco := 0;
    END IF;

    l_contLoop := 1;

    /* LOOP Acompanhantes */
    WHILE (l_contLoop <= l_qtdaco) LOOP
      l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
      l_pos := l_pos + 2;
      IF (l_tam > 0) THEN
        l_nomaco := SUBSTRING(p_ValStr, l_pos, l_tam);
        l_pos := l_pos + l_tam;
      END IF;

      l_idtpesaco := SUBSTRING(p_ValStr, l_pos, 23);
      l_pos := l_pos + 23;

      l_codoem := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 8));
      l_pos := l_pos + 8;

      l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
      l_pos    := l_pos + 2;
      IF (l_tam > 0) THEN
        l_nomoem := SUBSTRING(p_ValStr, l_pos, l_tam);
        l_pos := l_pos + l_tam;
      END IF;

      l_codnac := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
      l_pos := l_pos + 3;

      l_numcraaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
      l_pos := l_pos + 12;

      /* desmontar IDTPES do visitante */
      SP_PESFROMIDTPES(l_idtpesaco,
                       l_tippes OUT,
                       l_numempAco OUT,
                       l_tipcolAco OUT,
                       l_numcadAco OUT,
                       l_tipdocAco OUT,
                       l_numdocAco OUT,
                       l_nummat OUT,
                       l_propac OUT);

      /* Fechar historico R090HCH se tiver algum em aberto */
      IF (l_codErr = 0) THEN
        /* Verificar R090HCH com data/hora final em aberto */
        BEGIN
          SELECT COUNT(*) QNTREG
            INTO l_count
            FROM R090HCH
           WHERE TIPDOC = l_tipdocAco
             AND NUMDOC = l_numdocAco
             AND ((DATFIM = l_data_zero) OR
                 ((R090HCH.DATFIM > l_datAlt) OR
                 ((R090HCH.DATFIM = l_datAlt) AND (R090HCH.HORFIM > l_horAlt))));
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
  
        /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
        BEGIN
          IF (l_count > 0) THEN
            UPDATE R090HCH
               SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1, SEQREG = l_seqent
             WHERE TIPDOC = l_tipdocAco
               AND NUMDOC = l_numdocAco
               AND ((DATFIM = l_data_zero) OR ((R090HCH.DATFIM > l_datAlt) OR
                   ((R090HCH.DATFIM = l_datAlt) AND
                   (R090HCH.HORFIM > l_horAlt))));
          END IF;
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
      END IF;

      IF (l_codErr = 0) THEN
        /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
        BEGIN
          UPDATE R090MVI
             SET DATSLO = l_datAlt,
                 HORSLO = l_horAlt - 1,
                 DATSAI = l_datAlt,
                 HORSAI = l_horAlt - 1
           WHERE R090MVI.TIPDOC = l_tipdocAco
             AND R090MVI.NUMDOC = l_numdocAco
             AND R090MVI.DATSAI = l_data_zero;
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
      END IF;

      /* Inserir ou atualizar VISITANTE */
      BEGIN
        SELECT COUNT(*) QNTREG
          INTO l_count
          FROM R090VIS
         WHERE TIPDOC = l_tipdocAco
           AND NUMDOC = l_numdocAco;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 33;
      END;
      
      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VIS
            (TIPDOC,
             NUMDOC,
             NOMVIS,
             CODOEM,
             NOMOEM,
             CODPRM,
             CODNAC)
          VALUES
            (l_tipdocAco,
             l_numdocAco,
             l_nomaco,
             l_codoem,
             l_nomoem,
             l_codprm,
             l_codnac);
        ELSE
          UPDATE R090VIS
             SET NOMVIS = l_nomaco,
                 CODOEM = l_codoem,
                 NOMOEM = l_nomoem,
                 CODPRM = l_codprm,
                 CODNAC = l_codnac
           WHERE TIPDOC = l_tipdocAco
             AND NUMDOC = l_numdocAco;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 33;
      END;

      /*ACOMPANHANTE*/
      BEGIN
        INSERT INTO R090ACO (DatEnt, HorEnt, SeqEnt, TipDoc, NumDoc, NumCra, CodNac, AssVid, DatSlo, HorSlo, DatSai, HorSai)
        VALUES (l_datAlt,
                l_horAlt,
                l_seqent,
                l_tipdocAco,
                l_numdocAco,
                l_numcraAco,
                l_codnac,
                l_assvid,
                l_data_zero,
        		0,
        		l_data_zero,
        		0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 53;
      END;
      
      /* Grava histórico de Crachá para o acompanhante */
      BEGIN
      	INSERT INTO R090HCH(TIPDOC, NUMDOC, DATINI, HORINI, SEQENT, NUMCRA, DATFIM, HORFIM)
      	VALUES (l_tipdocAco,
               	l_numdocAco,
        		l_datAlt,
        		l_horAlt,
        		l_seqent,
        		l_numcraAco,
        		l_data_zero,
        		0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 32;
   	  END;
 
      l_contLoop := l_contLoop + 1;
    END LOOP;
    /* FIM - LOOP Acompanhantes */
    
    l_datprvStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_datcon := SUBSTRING(l_datprvStr, 1, 2) || '/' ||
                SUBSTRING(l_datprvStr, 3, 2) || '/' ||
                SUBSTRING(l_datprvStr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datprv OUT);
    l_horprv := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 9, 2)));
    l_seqprv := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 11, 2)));
    
  END IF;
    	
  BEGIN
      UPDATE R090AGV SET 
        VISEFE = 'S' 
    	WHERE 
    		R090AGV.DATPRV = l_datprv AND 
    		R090AGV.HORPRV = l_horprv AND 
    		R090AGV.SEQAGV = l_seqprv AND
    		R090AGV.NUMEMP = l_numemp AND
    		R090AGV.TIPCOL = l_tipcol AND
    		R090AGV.NUMCAD = l_numcad;
    	EXCEPTION
    		WHEN OTHERS THEN
    		l_codErr := 32;
    END;

  /* retorna Codigo do erro */
  p_retErr := l_codErr;
END		SENIOR;229SP_STRTODATE
SP_PESFROMIDTPES
SP_DECFON
SP_SinAudMVI
K|␀␀

/* Processa demanda de sicronismo - 05 = Entrada de visitantes (R090MVI)   */
PROCEDURE SP_SINENTVIS(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

  l_datstr    VARCHAR2(16);  
  l_usocra    NUMBER(2);
  l_numcra    NUMBER(12);
  l_idtvis    VARCHAR2(23);
  l_idtCol    VARCHAR2(23);
  l_tam       NUMBER(3);
  l_pos       NUMBER(3);
  l_codpor    NUMBER(3);
  l_nomvis    VARCHAR2(40);
  l_codprm    NUMBER(5);
  l_tel       VARCHAR2(100);
  l_datvalStr VARCHAR2(16);
  l_datval    DATE;
  l_horval    NUMBER(4);
  l_tipvis    VARCHAR2(3);
  l_obsvis    VARCHAR2(160);
  l_codoem    NUMBER(8);
  l_numcon    VARCHAR2(15);
  l_codnac    NUMBER(3);
  l_cravei    NUMBER(12);
  l_CraVeiOld NUMBER(12);
  l_plavee    VARCHAR2(10);
  l_place1    VARCHAR2(10);
  l_place2    VARCHAR2(10);
  l_place3    VARCHAR2(10);
  l_datalt    DATE;
  l_assvid    VARCHAR2(1);
  l_nomoem    VARCHAR2(60);
  l_numlau    VARCHAR2(12);
  l_regrod    NUMBER(9);
  l_codusu    NUMBER(10);
  l_coderr    NUMBER(2);

  /*VariÃ¡veis auxiliares para conversÃ£o de data*/
  l_datcon VARCHAR2(25);
  l_horAlt NUMBER(4);
  l_seqent NUMBER(2);

  l_datins    DATE;
  l_tippes    NUMBER(2);
  l_numemp    NUMBER(4);
  l_tipcol    NUMBER(1);
  l_numcad    NUMBER(9);
  l_tipdoc    NUMBER(1);
  l_numdoc    VARCHAR2(20);
  l_nummat    VARCHAR2(15);
  l_propac    VARCHAR2(20);
  l_DDI       NUMBER(3);
  l_DDD       NUMBER(3);
  l_Fone      VARCHAR2(20);
  l_count     NUMBER(1);
  l_numempVis NUMBER(4);
  l_tipcolVis NUMBER(1);
  l_numcadVis NUMBER(9);
  l_tipdocVis NUMBER(1);
  l_numdocVis VARCHAR2(20);
  l_idtaut    VARCHAR2(23);
  l_VisVau    CHAR(1);
  l_data_zero DATE;
  l_empaut    NUMBER(4);
  l_tipaut    NUMBER(1);
  l_cadaut    NUMBER(9);
  l_tipdocAut NUMBER(1);
  l_numdocAut VARCHAR2(20);

  l_emavis    VARCHAR2(50);
  l_verplf    NUMBER(3);
  l_codplf    NUMBER(7);
  l_numcnh    VARCHAR2(20);
  l_catcnh    VARCHAR2(4);
  l_vencnhStr VARCHAR2(16);
  l_vencnh    DATE;
  l_andvis    NUMBER(3);
  l_VIDPLA    VARCHAR2(1);
  l_codplt    NUMBER(7);
  
  /*acompanhantes*/
  l_qtdaco    NUMBER(2);
  l_nomaco    VARCHAR2(99);
  l_idtpesaco VARCHAR2(23);
  l_numcraaco NUMBER(12);
  l_numempAco NUMBER(4);
  l_tipcolAco NUMBER(1);
  l_numcadAco NUMBER(9);
  l_tipdocAco NUMBER(1);
  l_numdocAco VARCHAR2(20);
  l_contLoop  NUMBER(2);
  
  l_datprvStr VARCHAR2(16);
  l_datprv    DATE;
  l_horprv    NUMBER(4);
  l_seqprv    NUMBER(2);
  
  l_Inseriu_R090MVI VARCHAR2(1);
BEGIN
  /* inicializa variÃ¡veis */
  l_coderr    := 0;
  p_RetErr    := 0;
  l_datins    := CURDATE();
  l_codusu    := 0;
  l_horAlt    := 0;
  l_data_zero := '31/12/1900,00:00:00';
  l_nomvis    := '';
  l_tel       := '';
  l_obsvis    := '';
  l_nomoem    := '';
  l_numlau    := '';
  l_regrod    := 0;
  l_emavis    := '';
  l_vencnh    := l_data_zero;
  l_Inseriu_R090MVI := 'N';

  /* separa os valores da string do p_valStr em cada variÃ¡vel */
  BEGIN
    l_pos    := 3;
    l_datstr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos    := l_pos + 16;
    l_numcra := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
    l_pos    := l_pos + 12;
    l_idtCol := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_codpor := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_idtVis := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_tam    := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos    := l_pos + 2;
    IF (l_tam > 0) THEN
      l_nomvis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
    l_codprm := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 5));
    l_pos    := l_pos + 5;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_tel := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos := l_pos + l_tam;
    END IF;
  
    l_datvalStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos       := l_pos + 16;
    l_tipvis    := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos       := l_pos + 3;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos := l_pos + 3;
    IF (l_tam > 0) THEN
      l_obsvis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_codusu := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 10));
    l_pos    := l_pos + 10;
    l_assvid := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 1));
    l_pos    := l_pos + 1;
    l_codoem := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 8));
    l_pos    := l_pos + 8;
    l_numcon := SUBSTRING(p_ValStr, l_pos, 15);
    l_pos    := l_pos + 15;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_nomoem := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_codnac := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_cravei := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
    l_pos    := l_pos + 12;
    l_plavee := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place1 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place2 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place3 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_numlau := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, l_tam)));
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_regrod := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, l_tam));
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_emavis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_idtaut := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_verplf := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_codplf := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 7));
    l_pos    := l_pos + 7;
  
    l_numcnh    := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, 20)));
    l_pos       := l_pos + 20;
    l_catcnh    := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, 4)));
    l_pos       := l_pos + 4;
    l_vencnhStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos       := l_pos + 16;
    
    l_andvis := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
  
    /* converte data/hora inicial */
    l_datcon := SUBSTRING(l_datstr, 1, 2) || '/' ||
                SUBSTRING(l_datstr, 3, 2) || '/' ||
                SUBSTRING(l_datstr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datAlt OUT);
    l_horAlt := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 9, 2)));
    l_seqent := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 11, 2)));
  
    /* converte data validade */
    l_datcon := SUBSTRING(l_datvalStr, 1, 2) || '/' ||
                SUBSTRING(l_datvalStr, 3, 2) || '/' ||
                SUBSTRING(l_datvalStr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datval OUT);
    l_horval := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datvalStr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datvalStr, 9, 2)));
  
    /* desmontar IDTPES do colab. (visitado) */
    SP_PESFROMIDTPES(l_idtCol,
                     l_tippes OUT,
                     l_numemp OUT,
                     l_tipcol OUT,
                     l_numcad OUT,
                     l_tipdoc OUT,
                     l_numdoc OUT,
                     l_nummat OUT,
                     l_propac OUT);
  
    /* decodificar string de telefone */
    SP_DECFON(l_tel, l_DDI OUT, l_DDD OUT, l_Fone OUT);
  
    /* desmontar IDTPES do visitante */
    SP_PESFROMIDTPES(l_idtVis,
                     l_tippes OUT,
                     l_numempVis OUT,
                     l_tipcolVis OUT,
                     l_numcadVis OUT,
                     l_tipdocVis OUT,
                     l_numdocVis OUT,
                     l_nummat OUT,
                     l_propac OUT);
  
    /* converte data Venc. CNH */
    IF (l_vencnhStr IS NOT NULL AND l_vencnhStr <> '0000000000000000') THEN
      l_datcon := SUBSTRING(l_vencnhStr, 1, 2) || '/' ||
                  SUBSTRING(l_vencnhStr, 3, 2) || '/' ||
                  SUBSTRING(l_vencnhStr, 5, 2);
      SP_STRTODATE(l_datcon, 'DD/MM/AA', l_vencnh OUT);
    END IF;
  
    /* padronizar as placas tirando espaÃ§os e traÃ§os */
    l_plavee := LTRIM(RTRIM(REPLACE(REPLACE(l_plavee, '-', ''), ' ', '')));
    l_place1 := LTRIM(RTRIM(REPLACE(REPLACE(l_place1, '-', ''), ' ', '')));
    l_place2 := LTRIM(RTRIM(REPLACE(REPLACE(l_place2, '-', ''), ' ', '')));
    l_place3 := LTRIM(RTRIM(REPLACE(REPLACE(l_place3, '-', ''), ' ', '')));
  
    /* por causa do ORACLE que considera '' como NULL e no SQL-SERVER nÃ£o */
    IF  (l_plavee = '') THEN
      l_plavee := NULL;
    END IF;
        
    IF  (l_place1 = '') THEN
      l_place1 := NULL;
    END IF;
       
    IF  (l_place2 = '') THEN
      l_place2 := NULL;
    END IF;

    IF  (l_place3 = '') THEN
      l_place3 := NULL;
    END IF;
    
    IF  (l_numlau = '') THEN
      l_numlau := NULL;
    END IF;
    
    IF  (l_numcnh = '') THEN
      l_numcnh := NULL;
    END IF;
    
    IF  (l_catcnh = '') THEN
      l_catcnh := NULL;
    END IF;
  
  EXCEPTION
    WHEN OTHERS THEN
      l_coderr := 30; /* erro de conversÃ£o na string */
  END;

  /* Fechar histÃ³rico R090HCH se tiver algum em aberto */
  IF (l_codErr = 0) THEN
    /* Verificar R090HCH com data/hora final em aberto */
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R090HCH
       WHERE TIPDOC = l_tipdocVis
         AND NUMDOC = l_numdocVis
         AND ((DATFIM = l_data_zero) OR
             ((R090HCH.DATFIM > l_datAlt) OR
             ((R090HCH.DATFIM = l_datAlt) AND (R090HCH.HORFIM > l_horAlt))));
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  
    /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
    BEGIN
      IF (l_count > 0) THEN
        UPDATE R090HCH
           SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1, SEQREG = l_seqent
         WHERE TIPDOC = l_tipdocVis
           AND NUMDOC = l_numdocVis
           AND ((DATFIM = l_data_zero) OR ((R090HCH.DATFIM > l_datAlt) OR
               ((R090HCH.DATFIM = l_datAlt) AND
               (R090HCH.HORFIM > l_horAlt))));
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  END IF;

  IF (l_codErr = 0) THEN
    /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
    BEGIN
      UPDATE R090MVI
         SET DATSLO = l_datAlt,
             HORSLO = l_horAlt - 1,
             DATSAI = l_datAlt,
             HORSAI = l_horAlt - 1
       WHERE R090MVI.TIPDOC = l_tipdocVis
         AND R090MVI.NUMDOC = l_numdocVis
         AND R090MVI.DATSAI = l_data_zero;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  END IF;

  /* Inserir ou atualizar VISITANTE */
  IF (l_codErr = 0) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R090VIS
       WHERE TIPDOC = l_tipdocVis
         AND NUMDOC = l_numdocVis;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 33;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R090VIS
          (TIPDOC,
           NUMDOC,
           NOMVIS,
           CODOEM,
           NOMOEM,
           CODPRM,
           DDITEL,
           DDDTEL,
           TELCON,
           OBSVIS,
           CODNAC,
           EMAVIS,
           NUMCNH,
           CATCNH,
           VENCNH)
        VALUES
          (l_tipdocVis,
           l_numdocVis,
           l_nomvis,
           l_codoem,
           l_nomoem,
           l_codprm,
           l_DDI,
           l_DDD,
           l_Fone,
           l_obsvis,
           l_codnac,
           l_emavis,
           l_numcnh,
           l_catcnh,
           l_vencnh);
      ELSE
        UPDATE R090VIS
           SET NOMVIS = l_nomvis,
               CODOEM = l_codoem,
               NOMOEM = l_nomoem,
               CODPRM = l_codprm,
               DDITEL = l_DDI,
               DDDTEL = l_DDD,
               TELCON = l_Fone,
               OBSVIS = l_obsvis,
               CODNAC = l_codnac,
               EMAVIS = l_emavis
         WHERE TIPDOC = l_tipdocVis
           AND NUMDOC = l_numdocVis;
      
        IF (l_numcnh IS NOT NULL) THEN
          UPDATE R090VIS
             SET NUMCNH = l_numcnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      
        IF (l_catcnh IS NOT NULL) THEN
          UPDATE R090VIS
             SET CATCNH = l_catcnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      
        IF (l_vencnh <> l_data_zero) THEN
          UPDATE R090VIS
             SET VENCNH = l_vencnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 33;
    END;
  END IF;

  IF (l_codErr = 0 AND l_plavee IS NOT NULL) THEN
    /* Verifica se tem um histÃ³rico de crachÃ¡ em aberto para esta placa de veÃ­culo */
    BEGIN
      SELECT NUMCRA
        INTO l_CraVeiOld
        FROM R088HCH
       WHERE PLAVEI = l_plavee
         AND ((DATINI < l_datAlt OR
             (DATINI = l_datAlt AND HORINI <= l_horAlt)) AND
             (DATFIM > l_datAlt OR
             (DATFIM = l_datAlt AND HORFIM >= l_horAlt)) OR
             DATFIM = l_data_zero);
    
      /* Finaliza o histÃ³rico de crachÃ¡ atual */
      IF (l_CraVeiOld > 0) THEN
        UPDATE R088HCH
           SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1
         WHERE NUMCRA = l_CraVeiOld
           AND ((DATINI < l_datAlt OR
               (DATINI = l_datAlt AND HORINI <= l_horAlt)) AND
               (DATFIM > l_datAlt OR
               (DATFIM = l_datAlt AND HORFIM >= l_horAlt)) OR
               DATFIM = l_data_zero);
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        NULL;
    END;
  
    /* Inclui Placa VeÃ­culo se nÃ£o existir */
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_plavee;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 34;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_plavee, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    /* Verificar se tem PLACA E CRAVEI  */
    IF (l_cravei > 0) THEN
      BEGIN
        /* Insere um novo histÃ³rico de crachÃ¡ */
        INSERT INTO R088HCH
        VALUES
          (l_plavee, l_datAlt, l_horAlt, l_cravei, l_datval, l_horval, 0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 34;
      END;
    END IF;
  END IF;

  IF (l_codErr = 0 AND l_place1 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place1;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place1, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0 AND l_place2 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place2;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place2, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0 AND l_place3 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place3;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place3, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0) THEN
    WHILE (l_Inseriu_R090MVI = 'N') LOOP
      BEGIN
        INSERT INTO R090MVI
          (datent,
           horent,
           seqent,
           numcra,
           numemp,
           tipcol,
           numcad,
           codprm,
           tipvis,
           obsvis,
           codusu,
           assvid,
           codoem,
           numcon,
           nomoem,
           codnac,
           cravei,
           codpor,
           datval,
           horval,
           plavee,
           PlaCae,
           place2,
           place3,
           dditel,
           dddtel,
           telcon,
           tipdoc,
           numdoc,
           emavis,
           verplf,
           codplf,
           datsai,
           horsai,
           datslo,
           horslo,
           andvis)
        VALUES
          (l_datAlt,
           l_horAlt,
           l_seqent,
           l_numcra,
           l_numemp,
           l_tipcol,
           l_numcad,
           l_codprm,
           l_tipvis,
           l_obsvis,
           l_codusu,
           l_assvid,
           l_codoem,
           l_numcon,
           l_nomoem,
           l_codnac,
           l_cravei,
           l_codpor,
           l_datval,
           l_horval,
           l_plavee,
           l_place1,
           l_place2,
           l_place3,
           l_DDI,
           l_DDD,
           l_Fone,
           l_tipdocVis,
           l_numdocVis,
           l_emavis,
           l_verplf,
           l_codplf,
           l_data_zero,
           0,
           l_data_zero,
           0, l_andvis);
        
        l_Inseriu_R090MVI := 'S';
      EXCEPTION
        WHEN OTHERS THEN
          IF (l_seqent = 59) THEN
            l_seqent := 0;
            l_horAlt := l_horAlt + 1;
          ELSE
            l_seqent := l_seqent + 1;
          END IF;          
      END;
    END LOOP; /* Fim loop*/
  END IF;

  IF (l_codErr = 0) THEN
    BEGIN
      INSERT INTO R090HCH
        (TIPDOC, NUMDOC, DATINI, HORINI, SEQENT, NUMCRA, DATFIM, HORFIM)
      VALUES
        (l_tipdocVis,
         l_numdocVis,
         l_datAlt,
         l_horAlt,
         l_seqent,
         l_numcra,
         l_data_zero,
         0);
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  
    IF (l_codErr = 0) THEN
      BEGIN
        IF ((l_numlau IS NOT NULL) OR (l_regrod > 0)) THEN
          INSERT INTO R090LAU
            (datent, horent, seqent, numlau, regrod, datins)
          VALUES
            (l_datAlt, l_horAlt, l_seqent, l_numlau, l_regrod, l_datins);
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 34;
      END;
    
      /* Incluir registro na R090VAU, se necessÃ¡rio */
      BEGIN
        SELECT VISVAU
          INTO l_VisVau
          FROM R090PRO
         WHERE TIPVIS = l_tipvis
           AND PROVIS = 7
           AND CONPRO = 2;
        l_count := 1;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_count := 0;
        WHEN TOO_MANY_ROWS THEN
          l_codErr := 36;
          l_count  := 0;
        WHEN OTHERS THEN
          l_codErr := 36;
          l_count  := 0;
      END;
    
      BEGIN
        IF (l_count = 1) THEN
          IF (l_VisVau = 'S') THEN
            /* ValidaÃ§Ã£o por Autorizador */
            INSERT INTO R090VAU
              (datent, horent, seqent, idtpes, idtaut, datfim, horfim)
            VALUES
              (l_datAlt,
               l_horAlt,
               l_seqent,
               l_idtVis,
               l_idtVis,
               l_datval,
               l_horval);
          ELSE
            /*So insere se tiver autorizador*/
            IF (LTRIM(RTRIM(l_idtAut)) <> '') THEN
              /* Validacao por Autorizador */
              INSERT INTO R090VAU
                (datent, horent, seqent, idtpes, idtaut, datfim, horfim)
              VALUES
                (l_datAlt,
                 l_horAlt,
                 l_seqent,
                 l_idtVis,
                 l_idtAut,
                 l_datval,
                 l_horval);
            END IF;
          END IF;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 36;
      END;
    END IF;
  END IF;

  /* R090VID */
  IF (l_codErr = 0 AND l_assvid = '1') THEN
  
    BEGIN
      SELECT CODPLT INTO l_codplt FROM r058por WHERE CODPOR = l_codpor;
    EXCEPTION
      WHEN OTHERS THEN l_codplt := 0;
    END;

    BEGIN
      SELECT VIDPLA INTO l_VIDPLA FROM R090TVI WHERE TIPVIS = l_tipvis;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_VIDPLA := 'N';
      WHEN OTHERS THEN NULL;
    END;
    
    IF (l_VIDPLA = 'S') THEN
      BEGIN
        SELECT COUNT(*) INTO l_count FROM R090VID WHERE CODPLT=l_codplt AND TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
      EXCEPTION
        WHEN OTHERS THEN l_count := 0;
      END;

      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VID (CODPLT, TIPDOC, NUMDOC, DATVID) VALUES (l_codplt, l_tipdocVis, l_numdocVis, l_datAlt);
        ELSE
          UPDATE R090VID SET DATVID = l_datAlt WHERE CODPLT=l_codplt AND TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 38;
      END;
    ELSE
      BEGIN
        SELECT COUNT(*) INTO l_count FROM R090VID WHERE TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
      EXCEPTION
        WHEN OTHERS THEN l_count := 0;
      END;

      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VID (CODPLT, TIPDOC, NUMDOC, DATVID) VALUES (l_codplt, l_tipdocVis, l_numdocVis, l_datAlt);
        ELSE
          UPDATE R090VID SET DATVID = l_datAlt WHERE TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
        END IF;      
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 38;
      END;
    END IF;
  END IF;
  
  /* Executa a auditoria de registros */
  IF (l_codErr = 0) THEN
  
    IF (LTRIM(RTRIM(l_idtAut)) <> '') THEN
      /* desmontar IDTPES do autorizador */
      SP_PESFROMIDTPES(l_idtAut,
                       l_tippes OUT,
                       l_empAut OUT,
                       l_tipaut OUT,
                       l_cadaut OUT,
                       l_tipdocAut OUT,
                       l_numdocAut OUT,
                       l_nummat OUT,
                       l_propac OUT);
                     
      IF (l_tippes > 3) THEN
        l_empaut := 0;
        l_tipaut := 0;
        l_cadaut := 0;
      END IF;               
    ELSE
      l_empaut := 0;
      l_tipaut := 0;
      l_cadaut := 0;
    END IF;
  
    SP_SinAudMVI(0,
                 l_codpor,
                 l_datALT,
                 l_horalt,
                 l_seqent,
                 l_tipdocVis,
                 l_numdocVis,
                 l_numemp,
                 l_tipcol,
                 l_numcad,
                 l_numcra,
                 l_codnac,
                 l_nomvis,
                 l_codoem,
                 l_nomoem,
                 l_DDI,
                 l_DDD,
                 l_Fone,
                 l_tipvis,
                 l_codprm,
                 l_datval,
                 l_horval,
                 l_obsvis,
                 l_plavee,
                 l_place1,
                 l_place2,
                 l_place3,
                 l_numlau,
                 l_regrod,
                 /*p_numcnh   IN NUMBER(4), p_catcnh   IN VARCHAR2(20), p_vencnh   IN DATE,*/
                 l_assvid,
                 l_codoem,
                 l_numcon,
                 l_empaut,
                 l_tipaut,
                 l_cadaut,
                 l_codusu,
                 l_datALT,
                 l_horalt,
                 l_emavis,
                 l_verplf,
                 l_codplf,
                 l_codErr OUT);
  END IF;


  IF (l_codErr = 0) THEN
  
    /* se não tem acompanhante na string, não consegue converter */
    IF (Length(p_ValStr) > l_pos) THEN
        l_qtdaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
        l_pos := l_pos + 2;
    ELSE
        l_qtdaco := 0;
    END IF;

    l_contLoop := 1;

    /* LOOP Acompanhantes */
    WHILE (l_contLoop <= l_qtdaco) LOOP
      l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
      l_pos := l_pos + 2;
      IF (l_tam > 0) THEN
        l_nomaco := SUBSTRING(p_ValStr, l_pos, l_tam);
        l_pos := l_pos + l_tam;
      END IF;

      l_idtpesaco := SUBSTRING(p_ValStr, l_pos, 23);
      l_pos := l_pos + 23;

      l_codoem := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 8));
      l_pos := l_pos + 8;

      l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
      l_pos    := l_pos + 2;
      IF (l_tam > 0) THEN
        l_nomoem := SUBSTRING(p_ValStr, l_pos, l_tam);
        l_pos := l_pos + l_tam;
      END IF;

      l_codnac := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
      l_pos := l_pos + 3;

      l_numcraaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
      l_pos := l_pos + 12;

      /* desmontar IDTPES do visitante */
      SP_PESFROMIDTPES(l_idtpesaco,
                       l_tippes OUT,
                       l_numempAco OUT,
                       l_tipcolAco OUT,
                       l_numcadAco OUT,
                       l_tipdocAco OUT,
                       l_numdocAco OUT,
                       l_nummat OUT,
                       l_propac OUT);

      /* Fechar historico R090HCH se tiver algum em aberto */
      IF (l_codErr = 0) THEN
        /* Verificar R090HCH com data/hora final em aberto */
        BEGIN
          SELECT COUNT(*) QNTREG
            INTO l_count
            FROM R090HCH
           WHERE TIPDOC = l_tipdocAco
             AND NUMDOC = l_numdocAco
             AND ((DATFIM = l_data_zero) OR
                 ((R090HCH.DATFIM > l_datAlt) OR
                 ((R090HCH.DATFIM = l_datAlt) AND (R090HCH.HORFIM > l_horAlt))));
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
  
        /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
        BEGIN
          IF (l_count > 0) THEN
            UPDATE R090HCH
               SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1, SEQREG = l_seqent
             WHERE TIPDOC = l_tipdocAco
               AND NUMDOC = l_numdocAco
               AND ((DATFIM = l_data_zero) OR ((R090HCH.DATFIM > l_datAlt) OR
                   ((R090HCH.DATFIM = l_datAlt) AND
                   (R090HCH.HORFIM > l_horAlt))));
          END IF;
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
      END IF;

      IF (l_codErr = 0) THEN
        /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
        BEGIN
          UPDATE R090MVI
             SET DATSLO = l_datAlt,
                 HORSLO = l_horAlt - 1,
                 DATSAI = l_datAlt,
                 HORSAI = l_horAlt - 1
           WHERE R090MVI.TIPDOC = l_tipdocAco
             AND R090MVI.NUMDOC = l_numdocAco
             AND R090MVI.DATSAI = l_data_zero;
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
      END IF;

      /* Inserir ou atualizar VISITANTE */
      BEGIN
        SELECT COUNT(*) QNTREG
          INTO l_count
          FROM R090VIS
         WHERE TIPDOC = l_tipdocAco
           AND NUMDOC = l_numdocAco;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 33;
      END;
      
      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VIS
            (TIPDOC,
             NUMDOC,
             NOMVIS,
             CODOEM,
             NOMOEM,
             CODPRM,
             CODNAC)
          VALUES
            (l_tipdocAco,
             l_numdocAco,
             l_nomaco,
             l_codoem,
             l_nomoem,
             l_codprm,
             l_codnac);
        ELSE
          UPDATE R090VIS
             SET NOMVIS = l_nomaco,
                 CODOEM = l_codoem,
                 NOMOEM = l_nomoem,
                 CODPRM = l_codprm,
                 CODNAC = l_codnac
           WHERE TIPDOC = l_tipdocAco
             AND NUMDOC = l_numdocAco;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 33;
      END;

      /*ACOMPANHANTE*/
      BEGIN
        INSERT INTO R090ACO (DatEnt, HorEnt, SeqEnt, TipDoc, NumDoc, NumCra, CodNac, AssVid, DatSlo, HorSlo, DatSai, HorSai)
        VALUES (l_datAlt,
                l_horAlt,
                l_seqent,
                l_tipdocAco,
                l_numdocAco,
                l_numcraAco,
                l_codnac,
                l_assvid,
                l_data_zero,
        		0,
        		l_data_zero,
        		0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 53;
      END;
      
      /* Grava histórico de Crachá para o acompanhante */
      BEGIN
      	INSERT INTO R090HCH(TIPDOC, NUMDOC, DATINI, HORINI, SEQENT, NUMCRA, DATFIM, HORFIM)
      	VALUES (l_tipdocAco,
               	l_numdocAco,
        		l_datAlt,
        		l_horAlt,
        		l_seqent,
        		l_numcraAco,
        		l_data_zero,
        		0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 32;
   	  END;
 
      l_contLoop := l_contLoop + 1;
    END LOOP;
    /* FIM - LOOP Acompanhantes */
    
    l_datprvStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_datcon := SUBSTRING(l_datprvStr, 1, 2) || '/' ||
                SUBSTRING(l_datprvStr, 3, 2) || '/' ||
                SUBSTRING(l_datprvStr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datprv OUT);
    l_horprv := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 9, 2)));
    l_seqprv := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 11, 2)));
    
  END IF;
    	
  BEGIN
      UPDATE R090AGV SET 
        VISEFE = 'S' 
    	WHERE 
    		R090AGV.DATPRV = l_datprv AND 
    		R090AGV.HORPRV = l_horprv AND 
    		R090AGV.SEQAGV = l_seqprv AND
    		R090AGV.NUMEMP = l_numemp AND
    		R090AGV.TIPCOL = l_tipcol AND
    		R090AGV.NUMCAD = l_numcad;
    	EXCEPTION
    		WHEN OTHERS THEN
    		l_codErr := 32;
    END;

  /* retorna Codigo do erro */
  p_retErr := l_codErr;
END		SENIOR;239SP_STRTODATE
SP_PESFROMIDTPES
SP_DECFON
SP_SinAudMVI
K|␀␀

/* Processa demanda de sicronismo - 05 = Entrada de visitantes (R090MVI)   */
PROCEDURE SP_SINENTVIS(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

  l_datstr    VARCHAR2(16);  
  l_usocra    NUMBER(2);
  l_numcra    NUMBER(12);
  l_idtvis    VARCHAR2(23);
  l_idtCol    VARCHAR2(23);
  l_tam       NUMBER(3);
  l_pos       NUMBER(3);
  l_codpor    NUMBER(3);
  l_nomvis    VARCHAR2(40);
  l_codprm    NUMBER(5);
  l_tel       VARCHAR2(100);
  l_datvalStr VARCHAR2(16);
  l_datval    DATE;
  l_horval    NUMBER(4);
  l_tipvis    VARCHAR2(3);
  l_obsvis    VARCHAR2(160);
  l_codoem    NUMBER(8);
  l_numcon    VARCHAR2(15);
  l_codnac    NUMBER(3);
  l_cravei    NUMBER(12);
  l_CraVeiOld NUMBER(12);
  l_plavee    VARCHAR2(10);
  l_place1    VARCHAR2(10);
  l_place2    VARCHAR2(10);
  l_place3    VARCHAR2(10);
  l_datalt    DATE;
  l_assvid    VARCHAR2(1);
  l_nomoem    VARCHAR2(60);
  l_numlau    VARCHAR2(12);
  l_regrod    NUMBER(9);
  l_codusu    NUMBER(10);
  l_coderr    NUMBER(2);

  /*VariÃ¡veis auxiliares para conversÃ£o de data*/
  l_datcon VARCHAR2(25);
  l_horAlt NUMBER(4);
  l_seqent NUMBER(2);

  l_datins    DATE;
  l_tippes    NUMBER(2);
  l_numemp    NUMBER(4);
  l_tipcol    NUMBER(1);
  l_numcad    NUMBER(9);
  l_tipdoc    NUMBER(1);
  l_numdoc    VARCHAR2(20);
  l_nummat    VARCHAR2(15);
  l_propac    VARCHAR2(20);
  l_DDI       NUMBER(3);
  l_DDD       NUMBER(3);
  l_Fone      VARCHAR2(20);
  l_count     NUMBER(1);
  l_numempVis NUMBER(4);
  l_tipcolVis NUMBER(1);
  l_numcadVis NUMBER(9);
  l_tipdocVis NUMBER(1);
  l_numdocVis VARCHAR2(20);
  l_idtaut    VARCHAR2(23);
  l_VisVau    CHAR(1);
  l_data_zero DATE;
  l_empaut    NUMBER(4);
  l_tipaut    NUMBER(1);
  l_cadaut    NUMBER(9);
  l_tipdocAut NUMBER(1);
  l_numdocAut VARCHAR2(20);

  l_emavis    VARCHAR2(50);
  l_verplf    NUMBER(3);
  l_codplf    NUMBER(7);
  l_numcnh    VARCHAR2(20);
  l_catcnh    VARCHAR2(4);
  l_vencnhStr VARCHAR2(16);
  l_vencnh    DATE;
  l_andvis    NUMBER(3);
  l_VIDPLA    VARCHAR2(1);
  l_codplt    NUMBER(7);
  
  /*acompanhantes*/
  l_qtdaco    NUMBER(2);
  l_nomaco    VARCHAR2(99);
  l_idtpesaco VARCHAR2(23);
  l_numcraaco NUMBER(12);
  l_numempAco NUMBER(4);
  l_tipcolAco NUMBER(1);
  l_numcadAco NUMBER(9);
  l_tipdocAco NUMBER(1);
  l_numdocAco VARCHAR2(20);
  l_contLoop  NUMBER(2);
  
  l_datprvStr VARCHAR2(16);
  l_datprv    DATE;
  l_horprv    NUMBER(4);
  l_seqprv    NUMBER(2);
  
  l_Inseriu_R090MVI VARCHAR2(1);
BEGIN
  /* inicializa variÃ¡veis */
  l_coderr    := 0;
  p_RetErr    := 0;
  l_datins    := CURDATE();
  l_codusu    := 0;
  l_horAlt    := 0;
  l_data_zero := '31/12/1900,00:00:00';
  l_nomvis    := '';
  l_tel       := '';
  l_obsvis    := '';
  l_nomoem    := '';
  l_numlau    := '';
  l_regrod    := 0;
  l_emavis    := '';
  l_vencnh    := l_data_zero;
  l_Inseriu_R090MVI := 'N';

  /* separa os valores da string do p_valStr em cada variÃ¡vel */
  BEGIN
    l_pos    := 3;
    l_datstr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos    := l_pos + 16;
    l_numcra := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
    l_pos    := l_pos + 12;
    l_idtCol := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_codpor := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_idtVis := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_tam    := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos    := l_pos + 2;
    IF (l_tam > 0) THEN
      l_nomvis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
    l_codprm := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 5));
    l_pos    := l_pos + 5;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_tel := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos := l_pos + l_tam;
    END IF;
  
    l_datvalStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos       := l_pos + 16;
    l_tipvis    := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos       := l_pos + 3;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos := l_pos + 3;
    IF (l_tam > 0) THEN
      l_obsvis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_codusu := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 10));
    l_pos    := l_pos + 10;
    l_assvid := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 1));
    l_pos    := l_pos + 1;
    l_codoem := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 8));
    l_pos    := l_pos + 8;
    l_numcon := SUBSTRING(p_ValStr, l_pos, 15);
    l_pos    := l_pos + 15;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_nomoem := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_codnac := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_cravei := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
    l_pos    := l_pos + 12;
    l_plavee := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place1 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place2 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
    l_place3 := SUBSTRING(p_ValStr, l_pos, 10);
    l_pos    := l_pos + 10;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_numlau := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, l_tam)));
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_regrod := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, l_tam));
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
    l_pos := l_pos + 2;
    IF (l_tam > 0) THEN
      l_emavis := SUBSTRING(p_ValStr, l_pos, l_tam);
      l_pos    := l_pos + l_tam;
    END IF;
  
    l_idtaut := SUBSTRING(p_ValStr, l_pos, 23);
    l_pos    := l_pos + 23;
    l_verplf := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
    l_codplf := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 7));
    l_pos    := l_pos + 7;
  
    l_numcnh    := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, 20)));
    l_pos       := l_pos + 20;
    l_catcnh    := LTRIM(RTRIM(SUBSTRING(p_ValStr, l_pos, 4)));
    l_pos       := l_pos + 4;
    l_vencnhStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_pos       := l_pos + 16;
    
    l_andvis := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
    l_pos    := l_pos + 3;
  
    /* converte data/hora inicial */
    l_datcon := SUBSTRING(l_datstr, 1, 2) || '/' ||
                SUBSTRING(l_datstr, 3, 2) || '/' ||
                SUBSTRING(l_datstr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datAlt OUT);
    l_horAlt := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 9, 2)));
    l_seqent := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datstr, 11, 2)));
  
    /* converte data validade */
    l_datcon := SUBSTRING(l_datvalStr, 1, 2) || '/' ||
                SUBSTRING(l_datvalStr, 3, 2) || '/' ||
                SUBSTRING(l_datvalStr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datval OUT);
    l_horval := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datvalStr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datvalStr, 9, 2)));
  
    /* desmontar IDTPES do colab. (visitado) */
    SP_PESFROMIDTPES(l_idtCol,
                     l_tippes OUT,
                     l_numemp OUT,
                     l_tipcol OUT,
                     l_numcad OUT,
                     l_tipdoc OUT,
                     l_numdoc OUT,
                     l_nummat OUT,
                     l_propac OUT);
  
    /* decodificar string de telefone */
    SP_DECFON(l_tel, l_DDI OUT, l_DDD OUT, l_Fone OUT);
  
    /* desmontar IDTPES do visitante */
    SP_PESFROMIDTPES(l_idtVis,
                     l_tippes OUT,
                     l_numempVis OUT,
                     l_tipcolVis OUT,
                     l_numcadVis OUT,
                     l_tipdocVis OUT,
                     l_numdocVis OUT,
                     l_nummat OUT,
                     l_propac OUT);
  
    /* converte data Venc. CNH */
    IF (l_vencnhStr IS NOT NULL AND l_vencnhStr <> '0000000000000000') THEN
      l_datcon := SUBSTRING(l_vencnhStr, 1, 2) || '/' ||
                  SUBSTRING(l_vencnhStr, 3, 2) || '/' ||
                  SUBSTRING(l_vencnhStr, 5, 2);
      SP_STRTODATE(l_datcon, 'DD/MM/AA', l_vencnh OUT);
    END IF;
  
    /* padronizar as placas tirando espaÃ§os e traÃ§os */
    l_plavee := LTRIM(RTRIM(REPLACE(REPLACE(l_plavee, '-', ''), ' ', '')));
    l_place1 := LTRIM(RTRIM(REPLACE(REPLACE(l_place1, '-', ''), ' ', '')));
    l_place2 := LTRIM(RTRIM(REPLACE(REPLACE(l_place2, '-', ''), ' ', '')));
    l_place3 := LTRIM(RTRIM(REPLACE(REPLACE(l_place3, '-', ''), ' ', '')));
  
    /* por causa do ORACLE que considera '' como NULL e no SQL-SERVER nÃ£o */
    IF  (l_plavee = '') THEN
      l_plavee := NULL;
    END IF;
        
    IF  (l_place1 = '') THEN
      l_place1 := NULL;
    END IF;
       
    IF  (l_place2 = '') THEN
      l_place2 := NULL;
    END IF;

    IF  (l_place3 = '') THEN
      l_place3 := NULL;
    END IF;
    
    IF  (l_numlau = '') THEN
      l_numlau := NULL;
    END IF;
    
    IF  (l_numcnh = '') THEN
      l_numcnh := NULL;
    END IF;
    
    IF  (l_catcnh = '') THEN
      l_catcnh := NULL;
    END IF;
  
  EXCEPTION
    WHEN OTHERS THEN
      l_coderr := 30; /* erro de conversÃ£o na string */
  END;

  /* Fechar histÃ³rico R090HCH se tiver algum em aberto */
  IF (l_codErr = 0) THEN
    /* Verificar R090HCH com data/hora final em aberto */
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R090HCH
       WHERE TIPDOC = l_tipdocVis
         AND NUMDOC = l_numdocVis
         AND ((DATFIM = l_data_zero) OR
             ((R090HCH.DATFIM > l_datAlt) OR
             ((R090HCH.DATFIM = l_datAlt) AND (R090HCH.HORFIM > l_horAlt))));
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  
    /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
    BEGIN
      IF (l_count > 0) THEN
        UPDATE R090HCH
           SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1, SEQREG = l_seqent
         WHERE TIPDOC = l_tipdocVis
           AND NUMDOC = l_numdocVis
           AND ((DATFIM = l_data_zero) OR ((R090HCH.DATFIM > l_datAlt) OR
               ((R090HCH.DATFIM = l_datAlt) AND
               (R090HCH.HORFIM > l_horAlt))));
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  END IF;

  IF (l_codErr = 0) THEN
    /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
    BEGIN
      UPDATE R090MVI
         SET DATSLO = l_datAlt,
             HORSLO = l_horAlt - 1,
             DATSAI = l_datAlt,
             HORSAI = l_horAlt - 1
       WHERE R090MVI.TIPDOC = l_tipdocVis
         AND R090MVI.NUMDOC = l_numdocVis
         AND R090MVI.DATSAI = l_data_zero;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  END IF;

  /* Inserir ou atualizar VISITANTE */
  IF (l_codErr = 0) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R090VIS
       WHERE TIPDOC = l_tipdocVis
         AND NUMDOC = l_numdocVis;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 33;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R090VIS
          (TIPDOC,
           NUMDOC,
           NOMVIS,
           CODOEM,
           NOMOEM,
           CODPRM,
           DDITEL,
           DDDTEL,
           TELCON,
           OBSVIS,
           CODNAC,
           EMAVIS,
           NUMCNH,
           CATCNH,
           VENCNH)
        VALUES
          (l_tipdocVis,
           l_numdocVis,
           l_nomvis,
           l_codoem,
           l_nomoem,
           l_codprm,
           l_DDI,
           l_DDD,
           l_Fone,
           l_obsvis,
           l_codnac,
           l_emavis,
           l_numcnh,
           l_catcnh,
           l_vencnh);
      ELSE
        UPDATE R090VIS
           SET NOMVIS = l_nomvis,
               CODOEM = l_codoem,
               NOMOEM = l_nomoem,
               CODPRM = l_codprm,
               DDITEL = l_DDI,
               DDDTEL = l_DDD,
               TELCON = l_Fone,
               OBSVIS = l_obsvis,
               CODNAC = l_codnac,
               EMAVIS = l_emavis
         WHERE TIPDOC = l_tipdocVis
           AND NUMDOC = l_numdocVis;
      
        IF (l_numcnh IS NOT NULL) THEN
          UPDATE R090VIS
             SET NUMCNH = l_numcnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      
        IF (l_catcnh IS NOT NULL) THEN
          UPDATE R090VIS
             SET CATCNH = l_catcnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      
        IF (l_vencnh <> l_data_zero) THEN
          UPDATE R090VIS
             SET VENCNH = l_vencnh
           WHERE TIPDOC = l_tipdocVis
             AND NUMDOC = l_numdocVis;
        END IF;
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 33;
    END;
  END IF;

  IF (l_codErr = 0 AND l_plavee IS NOT NULL) THEN
    /* Verifica se tem um histÃ³rico de crachÃ¡ em aberto para esta placa de veÃ­culo */
    BEGIN
      SELECT NUMCRA
        INTO l_CraVeiOld
        FROM R088HCH
       WHERE PLAVEI = l_plavee
         AND ((DATINI < l_datAlt OR
             (DATINI = l_datAlt AND HORINI <= l_horAlt)) AND
             (DATFIM > l_datAlt OR
             (DATFIM = l_datAlt AND HORFIM >= l_horAlt)) OR
             DATFIM = l_data_zero);
    
      /* Finaliza o histÃ³rico de crachÃ¡ atual */
      IF (l_CraVeiOld > 0) THEN
        UPDATE R088HCH
           SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1
         WHERE NUMCRA = l_CraVeiOld
           AND ((DATINI < l_datAlt OR
               (DATINI = l_datAlt AND HORINI <= l_horAlt)) AND
               (DATFIM > l_datAlt OR
               (DATFIM = l_datAlt AND HORFIM >= l_horAlt)) OR
               DATFIM = l_data_zero);
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        NULL;
    END;
  
    /* Inclui Placa VeÃ­culo se nÃ£o existir */
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_plavee;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 34;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_plavee, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    /* Verificar se tem PLACA E CRAVEI  */
    IF (l_cravei > 0) THEN
      BEGIN
        /* Insere um novo histÃ³rico de crachÃ¡ */
        INSERT INTO R088HCH
        VALUES
          (l_plavee, l_datAlt, l_horAlt, l_cravei, l_datval, l_horval, 0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 34;
      END;
    END IF;
  END IF;

  IF (l_codErr = 0 AND l_place1 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place1;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place1, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0 AND l_place2 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place2;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place2, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0 AND l_place3 IS NOT NULL) THEN
    BEGIN
      SELECT COUNT(*) QNTREG
        INTO l_count
        FROM R088VEI
       WHERE PLAVEI = l_place3;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  
    BEGIN
      IF (l_count = 0) THEN
        INSERT INTO R088VEI (plavei, conlpr) VALUES (l_place3, 'N');
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 35;
    END;
  END IF;

  IF (l_codErr = 0) THEN
    WHILE (l_Inseriu_R090MVI = 'N') LOOP
      BEGIN
        INSERT INTO R090MVI
          (datent,
           horent,
           seqent,
           numcra,
           numemp,
           tipcol,
           numcad,
           codprm,
           tipvis,
           obsvis,
           codusu,
           assvid,
           codoem,
           numcon,
           nomoem,
           codnac,
           cravei,
           codpor,
           datval,
           horval,
           plavee,
           PlaCae,
           place2,
           place3,
           dditel,
           dddtel,
           telcon,
           tipdoc,
           numdoc,
           emavis,
           verplf,
           codplf,
           datsai,
           horsai,
           datslo,
           horslo,
           andvis)
        VALUES
          (l_datAlt,
           l_horAlt,
           l_seqent,
           l_numcra,
           l_numemp,
           l_tipcol,
           l_numcad,
           l_codprm,
           l_tipvis,
           l_obsvis,
           l_codusu,
           l_assvid,
           l_codoem,
           l_numcon,
           l_nomoem,
           l_codnac,
           l_cravei,
           l_codpor,
           l_datval,
           l_horval,
           l_plavee,
           l_place1,
           l_place2,
           l_place3,
           l_DDI,
           l_DDD,
           l_Fone,
           l_tipdocVis,
           l_numdocVis,
           l_emavis,
           l_verplf,
           l_codplf,
           l_data_zero,
           0,
           l_data_zero,
           0, l_andvis);
        
        l_Inseriu_R090MVI := 'S';
      EXCEPTION
        WHEN OTHERS THEN
          IF (l_seqent = 59) THEN
            l_seqent := 0;
            l_horAlt := l_horAlt + 1;
          ELSE
            l_seqent := l_seqent + 1;
          END IF;          
      END;
    END LOOP; /* Fim loop*/
  END IF;

  IF (l_codErr = 0) THEN
    BEGIN
      INSERT INTO R090HCH
        (TIPDOC, NUMDOC, DATINI, HORINI, SEQENT, NUMCRA, DATFIM, HORFIM)
      VALUES
        (l_tipdocVis,
         l_numdocVis,
         l_datAlt,
         l_horAlt,
         l_seqent,
         l_numcra,
         l_data_zero,
         0);
    EXCEPTION
      WHEN OTHERS THEN
        l_codErr := 32;
    END;
  
    IF (l_codErr = 0) THEN
      BEGIN
        IF ((l_numlau IS NOT NULL) OR (l_regrod > 0)) THEN
          INSERT INTO R090LAU
            (datent, horent, seqent, numlau, regrod, datins)
          VALUES
            (l_datAlt, l_horAlt, l_seqent, l_numlau, l_regrod, l_datins);
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 34;
      END;
    
      /* Incluir registro na R090VAU, se necessÃ¡rio */
      BEGIN
        SELECT VISVAU
          INTO l_VisVau
          FROM R090PRO
         WHERE TIPVIS = l_tipvis
           AND PROVIS = 7
           AND CONPRO = 2;
        l_count := 1;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_count := 0;
        WHEN TOO_MANY_ROWS THEN
          l_codErr := 36;
          l_count  := 0;
        WHEN OTHERS THEN
          l_codErr := 36;
          l_count  := 0;
      END;
    
      BEGIN
        IF (l_count = 1) THEN
          IF (l_VisVau = 'S') THEN
            /* ValidaÃ§Ã£o por Autorizador */
            INSERT INTO R090VAU
              (datent, horent, seqent, idtpes, idtaut, datfim, horfim)
            VALUES
              (l_datAlt,
               l_horAlt,
               l_seqent,
               l_idtVis,
               l_idtVis,
               l_datval,
               l_horval);
          ELSE
            /*So insere se tiver autorizador*/
            IF (LTRIM(RTRIM(l_idtAut)) <> '') THEN
              /* Validacao por Autorizador */
              INSERT INTO R090VAU
                (datent, horent, seqent, idtpes, idtaut, datfim, horfim)
              VALUES
                (l_datAlt,
                 l_horAlt,
                 l_seqent,
                 l_idtVis,
                 l_idtAut,
                 l_datval,
                 l_horval);
            END IF;
          END IF;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 36;
      END;
    END IF;
  END IF;

  /* R090VID */
  IF (l_codErr = 0 AND l_assvid = '1') THEN
  
    BEGIN
      SELECT CODPLT INTO l_codplt FROM r058por WHERE CODPOR = l_codpor;
    EXCEPTION
      WHEN OTHERS THEN l_codplt := 0;
    END;

    BEGIN
      SELECT VIDPLA INTO l_VIDPLA FROM R090TVI WHERE TIPVIS = l_tipvis;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_VIDPLA := 'N';
      WHEN OTHERS THEN NULL;
    END;
    
    IF (l_VIDPLA = 'S') THEN
      BEGIN
        SELECT COUNT(*) INTO l_count FROM R090VID WHERE CODPLT=l_codplt AND TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
      EXCEPTION
        WHEN OTHERS THEN l_count := 0;
      END;

      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VID (CODPLT, TIPDOC, NUMDOC, DATVID) VALUES (l_codplt, l_tipdocVis, l_numdocVis, l_datAlt);
        ELSE
          UPDATE R090VID SET DATVID = l_datAlt WHERE CODPLT=l_codplt AND TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 38;
      END;
    ELSE
      BEGIN
        SELECT COUNT(*) INTO l_count FROM R090VID WHERE TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
      EXCEPTION
        WHEN OTHERS THEN l_count := 0;
      END;

      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VID (CODPLT, TIPDOC, NUMDOC, DATVID) VALUES (l_codplt, l_tipdocVis, l_numdocVis, l_datAlt);
        ELSE
          UPDATE R090VID SET DATVID = l_datAlt WHERE TIPDOC=l_tipdocVis AND NUMDOC=l_numdocVis;
        END IF;      
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 38;
      END;
    END IF;
  END IF;
  
  /* Executa a auditoria de registros */
  IF (l_codErr = 0) THEN
  
    IF (LTRIM(RTRIM(l_idtAut)) <> '') THEN
      /* desmontar IDTPES do autorizador */
      SP_PESFROMIDTPES(l_idtAut,
                       l_tippes OUT,
                       l_empAut OUT,
                       l_tipaut OUT,
                       l_cadaut OUT,
                       l_tipdocAut OUT,
                       l_numdocAut OUT,
                       l_nummat OUT,
                       l_propac OUT);
                     
      IF (l_tippes > 3) THEN
        l_empaut := 0;
        l_tipaut := 0;
        l_cadaut := 0;
      END IF;               
    ELSE
      l_empaut := 0;
      l_tipaut := 0;
      l_cadaut := 0;
    END IF;
  
    SP_SinAudMVI(0,
                 l_codpor,
                 l_datALT,
                 l_horalt,
                 l_seqent,
                 l_tipdocVis,
                 l_numdocVis,
                 l_numemp,
                 l_tipcol,
                 l_numcad,
                 l_numcra,
                 l_codnac,
                 l_nomvis,
                 l_codoem,
                 l_nomoem,
                 l_DDI,
                 l_DDD,
                 l_Fone,
                 l_tipvis,
                 l_codprm,
                 l_datval,
                 l_horval,
                 l_obsvis,
                 l_plavee,
                 l_place1,
                 l_place2,
                 l_place3,
                 l_numlau,
                 l_regrod,
                 /*p_numcnh   IN NUMBER(4), p_catcnh   IN VARCHAR2(20), p_vencnh   IN DATE,*/
                 l_assvid,
                 l_codoem,
                 l_numcon,
                 l_empaut,
                 l_tipaut,
                 l_cadaut,
                 l_codusu,
                 l_datALT,
                 l_horalt,
                 l_emavis,
                 l_verplf,
                 l_codplf,
                 l_codErr OUT);
  END IF;


  IF (l_codErr = 0) THEN
  
    /* se não tem acompanhante na string, não consegue converter */
    IF (Length(p_ValStr) > l_pos) THEN
        l_qtdaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
        l_pos := l_pos + 2;
    ELSE
        l_qtdaco := 0;
    END IF;

    l_contLoop := 1;

    /* LOOP Acompanhantes */
    WHILE (l_contLoop <= l_qtdaco) LOOP
      l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
      l_pos := l_pos + 2;
      IF (l_tam > 0) THEN
        l_nomaco := SUBSTRING(p_ValStr, l_pos, l_tam);
        l_pos := l_pos + l_tam;
      END IF;

      l_idtpesaco := SUBSTRING(p_ValStr, l_pos, 23);
      l_pos := l_pos + 23;

      l_codoem := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 8));
      l_pos := l_pos + 8;

      l_tam := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));
      l_pos    := l_pos + 2;
      IF (l_tam > 0) THEN
        l_nomoem := SUBSTRING(p_ValStr, l_pos, l_tam);
        l_pos := l_pos + l_tam;
      END IF;

      l_codnac := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3));
      l_pos := l_pos + 3;

      l_numcraaco := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 12));
      l_pos := l_pos + 12;

      /* desmontar IDTPES do visitante */
      SP_PESFROMIDTPES(l_idtpesaco,
                       l_tippes OUT,
                       l_numempAco OUT,
                       l_tipcolAco OUT,
                       l_numcadAco OUT,
                       l_tipdocAco OUT,
                       l_numdocAco OUT,
                       l_nummat OUT,
                       l_propac OUT);

      /* Fechar historico R090HCH se tiver algum em aberto */
      IF (l_codErr = 0) THEN
        /* Verificar R090HCH com data/hora final em aberto */
        BEGIN
          SELECT COUNT(*) QNTREG
            INTO l_count
            FROM R090HCH
           WHERE TIPDOC = l_tipdocAco
             AND NUMDOC = l_numdocAco
             AND ((DATFIM = l_data_zero) OR
                 ((R090HCH.DATFIM > l_datAlt) OR
                 ((R090HCH.DATFIM = l_datAlt) AND (R090HCH.HORFIM > l_horAlt))));
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
  
        /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
        BEGIN
          IF (l_count > 0) THEN
            UPDATE R090HCH
               SET DATFIM = l_datAlt, HORFIM = l_horAlt - 1, SEQREG = l_seqent
             WHERE TIPDOC = l_tipdocAco
               AND NUMDOC = l_numdocAco
               AND ((DATFIM = l_data_zero) OR ((R090HCH.DATFIM > l_datAlt) OR
                   ((R090HCH.DATFIM = l_datAlt) AND
                   (R090HCH.HORFIM > l_horAlt))));
          END IF;
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
      END IF;

      IF (l_codErr = 0) THEN
        /* fechar com 1 min a menos da hora da entrada que esta sendo inserida */
        BEGIN
          UPDATE R090MVI
             SET DATSLO = l_datAlt,
                 HORSLO = l_horAlt - 1,
                 DATSAI = l_datAlt,
                 HORSAI = l_horAlt - 1
           WHERE R090MVI.TIPDOC = l_tipdocAco
             AND R090MVI.NUMDOC = l_numdocAco
             AND R090MVI.DATSAI = l_data_zero;
        EXCEPTION
          WHEN OTHERS THEN
            l_codErr := 32;
        END;
      END IF;

      /* Inserir ou atualizar VISITANTE */
      BEGIN
        SELECT COUNT(*) QNTREG
          INTO l_count
          FROM R090VIS
         WHERE TIPDOC = l_tipdocAco
           AND NUMDOC = l_numdocAco;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 33;
      END;
      
      BEGIN
        IF (l_count = 0) THEN
          INSERT INTO R090VIS
            (TIPDOC,
             NUMDOC,
             NOMVIS,
             CODOEM,
             NOMOEM,
             CODPRM,
             CODNAC)
          VALUES
            (l_tipdocAco,
             l_numdocAco,
             l_nomaco,
             l_codoem,
             l_nomoem,
             l_codprm,
             l_codnac);
        ELSE
          UPDATE R090VIS
             SET NOMVIS = l_nomaco,
                 CODOEM = l_codoem,
                 NOMOEM = l_nomoem,
                 CODPRM = l_codprm,
                 CODNAC = l_codnac
           WHERE TIPDOC = l_tipdocAco
             AND NUMDOC = l_numdocAco;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 33;
      END;

      /*ACOMPANHANTE*/
      BEGIN
        INSERT INTO R090ACO (DatEnt, HorEnt, SeqEnt, TipDoc, NumDoc, NumCra, CodNac, AssVid, DatSlo, HorSlo, DatSai, HorSai)
        VALUES (l_datAlt,
                l_horAlt,
                l_seqent,
                l_tipdocAco,
                l_numdocAco,
                l_numcraAco,
                l_codnac,
                l_assvid,
                l_data_zero,
        		0,
        		l_data_zero,
        		0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 53;
      END;
      
      /* Grava histórico de Crachá para o acompanhante */
      BEGIN
      	INSERT INTO R090HCH(TIPDOC, NUMDOC, DATINI, HORINI, SEQENT, NUMCRA, DATFIM, HORFIM)
      	VALUES (l_tipdocAco,
               	l_numdocAco,
        		l_datAlt,
        		l_horAlt,
        		l_seqent,
        		l_numcraAco,
        		l_data_zero,
        		0);
      EXCEPTION
        WHEN OTHERS THEN
          l_codErr := 32;
   	  END;
 
      l_contLoop := l_contLoop + 1;
    END LOOP;
    /* FIM - LOOP Acompanhantes */
    
    l_datprvStr := SUBSTRING(p_ValStr, l_pos, 16);
    l_datcon := SUBSTRING(l_datprvStr, 1, 2) || '/' ||
                SUBSTRING(l_datprvStr, 3, 2) || '/' ||
                SUBSTRING(l_datprvStr, 5, 2);
    SP_STRTODATE(l_datcon, 'DD/MM/AA', l_datprv OUT);
    l_horprv := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 7, 2))) * 60 +
                CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 9, 2)));
    l_seqprv := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datprvStr, 11, 2)));
    
  END IF;
    	
  BEGIN
      UPDATE R090AGV SET 
        VISEFE = 'S' 
    	WHERE 
    		R090AGV.DATPRV = l_datprv AND 
    		R090AGV.HORPRV = l_horprv AND 
    		R090AGV.SEQAGV = l_seqprv AND
    		R090AGV.NUMEMP = l_numemp AND
    		R090AGV.TIPCOL = l_tipcol AND
    		R090AGV.NUMCAD = l_numcad;
    	EXCEPTION
    		WHEN OTHERS THEN
    		l_codErr := 32;
    END;

  /* retorna Codigo do erro */
  p_retErr := l_codErr;
END␀âø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_STRTODATE
SP_INTSTR
(␀␀PROCEDURE SP_SINFIS(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

l_usocra     NUMBER(2);
    l_numcra     NUMBER(12);
    l_numccr     NUMBER(12);
    l_codusu     NUMBER(10);
    l_datalt     DATE;
    l_datfim     DATE;
    l_horAlt     NUMBER(4);
    l_horfim     NUMBER(4);
    l_teccra     NUMBER(1);
    l_numfis     NUMBER(12);

    l_coderr     NUMBER(2);
    l_datatu     DATE;
    l_count      NUMBER(2);
    l_auxcra     NUMBER(12);
    l_auxFis     NUMBER(12);
    l_datzer     DATE;
    l_naoCad     NUMBER(1);
    l_reccra     VARCHAR2(1);
    l_mascra     VARCHAR2(12);
    l_CraStr     CHAR(12);
    l_posRRR     NUMBER(2);    /* posição do valor R ou C na máscara do crachá */
    l_posFim     NUMBER(2);    /* posição final do valor R ou C na máscara do crachá */

    /*Variáveis auxiliares para conversão de data*/
    l_datstr     CHAR(16);
    l_datcon     VARCHAR2(25);
	
	l_podeIgnorar NUMBER(1);
	l_horatu      NUMBER(4);

BEGIN
    /* inicializa variáveis */
    l_coderr := 0;
    p_RetErr := 0;
    l_datalt := CURDATE();
    l_datatu := CURDATE();
    l_datzer := '31/12/1900,00:00:00';
    l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_usocra := 6;
    l_numcra := 0;
    l_numccr := 0;
    l_codusu := 0;
    l_horAlt := 0;
    l_naoCad := 0;
    l_posRRR := 0;
    l_posFim := 0;

    /* separa os valores da string do p_valStr em cada variável */
    BEGIN
        l_numcra := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, 3,12));
        l_codusu := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, 15,10));

        /* converte data/hora inicial */
        l_datstr := SUBSTRING(p_ValStr, 25,16);
        l_datcon := SUBSTRING(l_datstr,1,2) || '/' || SUBSTRING(l_datstr,3,2) ||'/'||SUBSTRING(l_datstr,5,2);
        SP_STRTODATE(l_datcon,'DD/MM/AA', l_datAlt OUT);
        l_horAlt := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datstr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datstr,9,2)));

        l_teccra := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, 41,1));
        l_numfis := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, 42,12));
        
        l_usocra := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_ValStr, 55,2));        
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 1; /* erro de conversão na string */
    END;

    /* busca pré cadastro do crachá */
    l_naoCad :=0;
    BEGIN
        SELECT NUMCCR INTO l_numccr FROM R069CRA WHERE NUMCRA = l_numcra;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN l_naoCad := 1;
        WHEN OTHERS THEN l_coderr := 2;        
    END;

    /* calcula a data/hora final para fechar números físicos, se precisar */
    IF (l_horalt = 0) THEN
        l_datfim := DATETIMEADD(DD,-1,l_datalt);
        l_horfim := 1439;
    ELSE
        l_datfim := l_datalt;
        l_horfim := (l_horalt - 1);
    END IF;

	SELECT COUNT(1) INTO l_podeIgnorar FROM R069FIS WHERE NUMCRA = l_numcra AND NUMFIS = l_numfis AND DATFIM = l_datzer;
	
	IF (l_podeIgnorar = 0) THEN
        IF  (l_coderr = 0) THEN
        
            /* se esta cadastrado */
            IF  (l_naoCad = 0) THEN
                BEGIN
				  
				  /* Garante que movimentações de visitantes antigas estejam fechadas para não ocasionar TOO MANY ROWS nos objetos após o insert na R069FIS abaixo. */
				  BEGIN
		    		UPDATE R090MVI SET DATSAI = DATVAL WHERE DATSAI = l_datzer AND ((DATVAL < l_datalt) OR (DATVAL = l_datalt AND HORVAL < l_horatu)) AND NUMCRA = l_numcra;
		  		  EXCEPTION
		  		  	WHEN OTHERS THEN l_coderr := 3;
		  		  END;				  
				  
				  BEGIN
					  DELETE FROM R069FIS WHERE
								  NUMCRA = l_numcra AND
								  TECCRA = l_teccra AND
								  DATALT = l_datalt AND
								  HORINI = l_horalt;
                  EXCEPTION
				      WHEN OTHERS THEN l_coderr := 8;
                  END;
				  
                  l_auxcra := 0;
				  BEGIN
					  INSERT INTO R069FIS (NUMCRA, TECCRA, DATALT, HORINI, DATFIM, HORFIM, NUMFIS, CODUSU)
								  VALUES (l_numcra, l_teccra, l_datalt, l_horalt, l_datzer, 0, l_numfis, l_codusu);         
				  EXCEPTION
				      WHEN OTHERS THEN l_coderr := 9;
				  END;
	    		END;
	    	END IF;
        
			IF (l_coderr = 0) THEN
				/* se não esta cadastrado, fecha o número físico do anterior e insere o atual */
				IF  (l_naoCad = 1) THEN
			
					/* calcula NUMCCR */
					BEGIN
						SELECT RECCRA, MASCRA INTO l_reccra, l_mascra FROM R058DCR;
					EXCEPTION
						WHEN OTHERS THEN l_reccra := 'F';
					END;
			
					IF  (l_reccra = 'F') THEN
						l_numccr := l_numcra;
					ELSE
						l_posRRR := LOCATE('R',l_MasCra,1);
						IF  (l_posRRR = 0) THEN
							l_posRRR := LOCATE('C',l_MasCra,1);
						END IF;
			
						l_posfim := 12 - l_posRRR;
			
						SP_INTSTR(l_numcra,'999999999999',l_CraStr OUT);
						l_numccr := SUBSTRING(l_CraStr, l_posRRR, l_posFim);
					END IF;
					
					/* insere registro */
					BEGIN
						INSERT INTO R069CRA (USOCRA, NUMCRA, NUMCCR, CODUSU, DATALT,
											 PRMSAB, PRMDOM, PRMFER, CODPRM, INIACE,
											 FIMACE, INIPTO, FIMPTO, MOTCRA, DATCFC, NUMALF)
									 VALUES (l_usocra, l_numcra, l_numccr, l_codusu, l_datalt,
											 0, 0, 0, 0, 0,
											 0, 0, 0, 0, l_datzer, '0');
					EXCEPTION
						WHEN OTHERS THEN l_coderr := 6;
					END;
			
					BEGIN
						INSERT INTO R069FIS (NUMCRA, TECCRA, DATALT, HORINI, DATFIM,
											 HORFIM, NUMFIS, CODUSU)
									 VALUES (l_numcra, l_teccra, l_datalt, l_horalt, l_datzer,
											 0, l_numfis, l_codusu);
					EXCEPTION
						WHEN OTHERS THEN l_coderr := 7;
					END;
				END IF;
			END IF;
        END IF;
        
	    BEGIN
	    	UPDATE R069FIS SET DATFIM = l_datfim, HORFIM = l_horfim 
	    	WHERE (((DATALT = l_datAlt AND HORINI < l_horAlt) OR (DATALT < l_datAlt)) AND (DATFIM = l_datzer AND HORFIM = 0)) AND 
	              TECCRA = l_teccra AND ((NUMFIS = l_numfis AND NUMCRA <> l_numcra) OR (NUMFIS <> l_numfis AND NUMCRA = l_numcra));
	    EXCEPTION
	    	WHEN OTHERS THEN NULL;
	    END;
	END IF;
	
    /* retorna Código do erro */
    p_retErr := l_codErr;
END␀ãø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SSP_PESFROMIDTPES
SP_STRTODATE
R038HCH_VSOB
SP_SINAUD
R073hch_VSOB
SP_SINHCH2
 ␀␀PROCEDURE SP_SINHCH(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

    l_idtpes    VARCHAR2(23);
    l_tipope    NUMBER(1);
    l_numemp    NUMBER(4);
    l_tipcol    NUMBER(1);
    l_numcad    NUMBER(9);
    l_tipdoc    NUMBER(1);
    l_numdoc    VARCHAR2(20);
    l_nummat    VARCHAR2(15);
    l_propac    VARCHAR2(20);
    l_numcra    NUMBER(12);
    l_datIni    DATE;
    l_horIni    NUMBER(4);
    l_datFim    DATE;
    l_horFim    NUMBER(4);
    l_tippes    NUMBER(2);
    l_codusu    NUMBER(10);
    l_craent    CHAR(1);
    l_codMso    NUMBER(2);

    l_coderr    NUMBER(2);

    /*Variáveis auxiliares para conversão de data*/
    l_datstr    CHAR(16);
    l_datcon    VARCHAR(25);

  CURSOR c_r038HCH IS
       SELECT NUMEMP, TIPCOL, NUMCAD
         FROM R038HCH
        WHERE TIPCRA = 2 AND NUMCRA = l_numcra AND (CRAENT IS NULL OR CRAENT = 'N');

  CURSOR c_r073HCH IS
       SELECT NumMat
         FROM R073HCH
        WHERE TIPCRA = 2 AND NUMCRA = l_numcra AND (CRAENT IS NULL OR CRAENT = 'N');

BEGIN
    /* inicializa variáveis */
    l_coderr := 0;
    p_RetErr := 0;
    l_idtpes := '';
    l_tipope := 0;
    l_numemp := 0;
    l_tipcol := 0;
    l_numcad := 0;
    l_tipdoc := 0;
    l_numdoc := '';
    l_nummat := '';
    l_propac := '';
    l_datini := CURDATE();
    l_datFim := '31/12/1900,00:00:00';
    l_codMso := 0;

    /* separa os valores da string do p_valStr em cada variável */
    BEGIN
        l_tipope := SUBSTRING(p_ValStr, 3,1);
        l_idtpes := SUBSTRING(p_ValStr, 4,23);
        l_numcra := SUBSTRING(p_ValStr, 43,12);

        /* converte data/hora inicial */
        l_datstr := SUBSTRING(p_ValStr, 27,16);
        l_datcon := SUBSTRING(l_datstr,1,2) || '/' || SUBSTRING(l_datstr,3,2) ||'/'||SUBSTRING(l_datstr,5,2);
        SP_STRTODATE(l_datcon,'DD/MM/AA', l_datIni OUT);
        l_horini := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datstr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datstr,9,2)));

        /* converte data/hora final */
        l_datstr := SUBSTRING(p_ValStr, 55,16);
        l_datcon := SUBSTRING(l_datstr,1,2) || '/' || SUBSTRING(l_datstr,3,2) ||'/'||SUBSTRING(l_datstr,5,2);
        SP_STRTODATE(l_datcon,'DD/MM/AA', l_datFim OUT);
        l_horFim := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datstr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datstr,9,2)));

        l_codusu := SUBSTRING(p_ValStr, 71, 10);
        l_craent := SUBSTRING(p_ValStr, 81, 1);
        l_codMso := SUBSTRING(p_ValStr, 82, 2);
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 1; /* erro de conversão na string */
    END;

    /*Verifica se foi enviado IDTPES para decompô-lo*/        
    IF (LTRIM(RTRIM(l_idtpes)) IS NULL) OR (LENGTH(LTRIM(RTRIM(l_idtpes))) = 0) THEN
    
        FOREACH c_r038HCH INTO l_numemp, l_tipcol, l_numcad
        LOOP
            SP_SINHCH2(l_tipope,
                       l_numemp,
                       l_tipcol,
                       l_numcad,
                       l_nummat,	
                       l_numcra,
                       l_datIni,
                       l_horIni,
                       l_datFim,
                       l_horFim,
                       l_codusu,
                       l_craent,
                       l_codMso,
                       l_codErr OUT);
        END LOOP;

        FOREACH c_r073HCH INTO l_nummat
        LOOP
            SP_SINHCH2(l_tipope,
                       l_numemp,
                       l_tipcol,
                       l_numcad,
                       l_nummat,	
                       l_numcra,
                       l_datIni,
                       l_horIni,
                       l_datFim,
                       l_horFim,
                       l_codusu,
                       l_craent,
                       l_codMso,
                       l_codErr OUT);
        END LOOP;
    ELSE
        SP_PESFROMIDTPES(l_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT,
                         l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);

        SP_SINHCH2(l_tipope,
                   l_numemp,
                   l_tipcol,
                   l_numcad,
                   l_nummat,	
                   l_numcra,
                   l_datIni,
                   l_horIni,
                   l_datFim,
                   l_horFim,
                   l_codusu,
                   l_craent,
                   l_codMso,
                   l_codErr OUT);
    END IF;

    /* retorna Código do erro */
    p_retErr := l_codErr;
END	MSSQL;21SR038HCH_VSOB
R073hch_VSOB
SP_PESFROMIDTPES
SP_SINAUD
SP_STRTODATE
SP_SINHCH2
¤␀␀CREATE  PROCEDURE sp_sinhch(@p_ValStr VARCHAR(2047), @p_RetErr SMALLINT OUTPUT) AS
BEGIN
  DECLARE @l_idtpes VARCHAR(23)
  DECLARE @l_tipope SMALLINT
  DECLARE @l_numemp SMALLINT
  DECLARE @l_tipcol SMALLINT
  DECLARE @l_numcad INTEGER
  DECLARE @l_tipdoc SMALLINT
  DECLARE @l_numdoc VARCHAR(20)
  DECLARE @l_nummat VARCHAR(15)
  DECLARE @l_propac VARCHAR(20)
  DECLARE @l_numcra BIGINT
  DECLARE @l_datini DATETIME
  DECLARE @l_horini SMALLINT
  DECLARE @l_datfim DATETIME
  DECLARE @l_horfim SMALLINT
  DECLARE @l_tippes SMALLINT
  DECLARE @l_codusu BIGINT
  DECLARE @l_craent CHAR(1)
  DECLARE @l_coderr SMALLINT
  DECLARE @l_datstr CHAR(16)
  DECLARE @l_datcon VARCHAR(25)
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @l_codMso INTEGER
  SELECT @ChkError = 0
  SELECT @l_coderr = 0
  SELECT @p_RetErr = 0
  SELECT @l_idtpes = ''
  SELECT @l_tipope = 0
  SELECT @l_numemp = 0
  SELECT @l_tipcol = 0
  SELECT @l_numcad = 0
  SELECT @l_tipdoc = 0
  SELECT @l_numdoc = ''
  SELECT @l_nummat = ''
  SELECT @l_propac = ''
  SELECT @l_craent = ''
  SELECT @l_codMso = 0;
  SELECT @l_datini = CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(MM, GETDATE()))))+ '/' + LTRIM(RTRIM(STR(DATEPART(DD, GETDATE()))))+ '/' + LTRIM(RTRIM(STR(DATEPART(YY, GETDATE())))))
  SELECT @l_datFim =  CONVERT(DATETIME,'12/31/1900 00:00:00', 101)
  SELECT @l_tipope = SUBSTRING(@p_ValStr,3,1)
  SELECT @l_idtpes = SUBSTRING(@p_ValStr,4,23)
  SELECT @l_numcra = SUBSTRING(@p_ValStr,43,12)
  SELECT @l_datstr = SUBSTRING(@p_ValStr,27,16)
  SELECT @l_datcon = SUBSTRING(@l_datstr,1,2)+'/'+SUBSTRING(@l_datstr,3,2)+'/'+SUBSTRING(@l_datstr,5,2)
  SELECT @l_numcra = SUBSTRING(@p_ValStr,43,12)
  SELECT @l_codusu = SUBSTRING(@p_ValStr,71,10)
  SELECT @l_craent = SUBSTRING(@p_ValStr,81,1)
  SELECT @l_codMso = SUBSTRING(@p_ValStr,82,2)
    
  EXECUTE  @ChkError = SP_STRTODATE @l_datcon,'DD/MM/AA',@l_datIni OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO EXC1
  END
  SELECT @l_horini = CONVERT(NUMERIC,(SUBSTRING(@l_datstr,7,2)))*60+CONVERT(NUMERIC,(SUBSTRING(@l_datstr,9,2)))
  SELECT @l_datstr = SUBSTRING(@p_ValStr,55,16)
  SELECT @l_datcon = SUBSTRING(@l_datstr,1,2)+'/'+SUBSTRING(@l_datstr,3,2)+'/'+SUBSTRING(@l_datstr,5,2)
  EXECUTE  @ChkError = SP_STRTODATE @l_datcon,'DD/MM/AA',@l_datFim OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO EXC1
  END
  SELECT @l_horFim = CONVERT(NUMERIC,(SUBSTRING(@l_datstr,7,2)))*60+CONVERT(NUMERIC,(SUBSTRING(@l_datstr,9,2)))
  /* BEGIN EXCEPTION HANDLER */
  EXC1:
  SELECT @SE_EXC1 = @ChkError
  IF @ChkError <> 0
  BEGIN
    BEGIN
      SELECT @ChkError = 0
      SELECT @l_coderr = 1
    END
  END
  /* END EXCEPTION HANDLER */
  IF (LTRIM(RTRIM(@l_idtpes)) IS NULL) 
      OR (DATALENGTH(LTRIM(RTRIM(@l_idtpes)))=0)
  BEGIN
    DECLARE c_r038hch CURSOR FOR SELECT 
      r038hch.numemp NUMEMP,r038hch.tipcol TIPCOL,r038hch.numcad NUMCAD
       FROM r038hch r038hch
       WHERE tipcra=2  and numcra=@l_numcra 
      and (craent is null or craent='N')

    OPEN c_r038HCH
    FETCH NEXT FROM c_r038HCH INTO @l_numemp, @l_tipcol, @l_numcad
    WHILE  (@@FETCH_STATUS = 0)
    BEGIN
      EXECUTE  @ChkError = SP_SINHCH2 @l_tipope,@l_numemp,@l_tipcol,@l_numcad,@l_nummat,@l_numcra,@l_datIni,@l_horIni,@l_datFim,@l_horFim,@l_codusu,@l_craent,@l_codMso,@l_codErr OUTPUT  
      IF @ChkError <> 0
      BEGIN
        GOTO FNc_r038HCH2
      END
      FETCH NEXT FROM c_r038HCH INTO @l_numemp, @l_tipcol, @l_numcad
    END
    FNc_r038HCH2: /* FINALLY OPEN CURSOR */
    CLOSE c_r038HCH
    DEALLOCATE c_r038HCH

    IF @ChkError <> 0
      GOTO FIM
      
    DECLARE c_r073hch CURSOR FOR SELECT 
      r073hch.nummat NumMat
       FROM r073hch r073hch
       WHERE tipcra=2 and numcra=@l_numcra 
      and (craent is null  or craent='N')
    OPEN c_r073HCH
    FETCH NEXT FROM c_r073HCH INTO @l_nummat
    WHILE  (@@FETCH_STATUS = 0)
    BEGIN
      EXECUTE  @ChkError = SP_SINHCH2 @l_tipope,@l_numemp,@l_tipcol,@l_numcad,@l_nummat,@l_numcra,@l_datIni,@l_horIni,@l_datFim,@l_horFim,@l_codusu,@l_craent,@l_codMso,@l_codErr OUTPUT  
      IF @ChkError <> 0
      BEGIN
        GOTO FNc_r073HCH3
      END
      FETCH NEXT FROM c_r073HCH INTO @l_nummat
    END
    FNc_r073HCH3: /* FINALLY OPEN CURSOR */
    CLOSE c_r073HCH
    DEALLOCATE c_r073HCH

    IF @ChkError <> 0
      GOTO FIM
  END
  ELSE
  BEGIN
    EXECUTE  @ChkError = SP_PESFROMIDTPES @l_idtpes,@l_tippes OUTPUT ,@l_numemp OUTPUT ,@l_tipcol OUTPUT ,@l_numcad OUTPUT ,@l_tipdoc OUTPUT ,@l_numdoc OUTPUT ,@l_nummat OUTPUT ,@l_propac OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    EXECUTE  @ChkError = SP_SINHCH2 @l_tipope,@l_numemp,@l_tipcol,@l_numcad,@l_nummat,@l_numcra,@l_datIni,@l_horIni,@l_datFim,@l_horFim,@l_codusu,@l_craent,@l_codMso,@l_codErr OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  SELECT @p_retErr = @l_codErr
FIM:
  RETURN @ChkError
END	MSSQL;23SR038HCH_VSOB
R073hch_VSOB
SP_PESFROMIDTPES
SP_SINAUD
SP_STRTODATE
SP_SINHCH2
¤␀␀CREATE  PROCEDURE sp_sinhch(@p_ValStr VARCHAR(2047), @p_RetErr SMALLINT OUTPUT) AS
BEGIN
  DECLARE @l_idtpes VARCHAR(23)
  DECLARE @l_tipope SMALLINT
  DECLARE @l_numemp SMALLINT
  DECLARE @l_tipcol SMALLINT
  DECLARE @l_numcad INTEGER
  DECLARE @l_tipdoc SMALLINT
  DECLARE @l_numdoc VARCHAR(20)
  DECLARE @l_nummat VARCHAR(15)
  DECLARE @l_propac VARCHAR(20)
  DECLARE @l_numcra BIGINT
  DECLARE @l_datini DATETIME
  DECLARE @l_horini SMALLINT
  DECLARE @l_datfim DATETIME
  DECLARE @l_horfim SMALLINT
  DECLARE @l_tippes SMALLINT
  DECLARE @l_codusu BIGINT
  DECLARE @l_craent CHAR(1)
  DECLARE @l_coderr SMALLINT
  DECLARE @l_datstr CHAR(16)
  DECLARE @l_datcon VARCHAR(25)
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @l_codMso INTEGER
  SELECT @ChkError = 0
  SELECT @l_coderr = 0
  SELECT @p_RetErr = 0
  SELECT @l_idtpes = ''
  SELECT @l_tipope = 0
  SELECT @l_numemp = 0
  SELECT @l_tipcol = 0
  SELECT @l_numcad = 0
  SELECT @l_tipdoc = 0
  SELECT @l_numdoc = ''
  SELECT @l_nummat = ''
  SELECT @l_propac = ''
  SELECT @l_craent = ''
  SELECT @l_codMso = 0;
  SELECT @l_datini = CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(MM, GETDATE()))))+ '/' + LTRIM(RTRIM(STR(DATEPART(DD, GETDATE()))))+ '/' + LTRIM(RTRIM(STR(DATEPART(YY, GETDATE())))))
  SELECT @l_datFim =  CONVERT(DATETIME,'12/31/1900 00:00:00', 101)
  SELECT @l_tipope = SUBSTRING(@p_ValStr,3,1)
  SELECT @l_idtpes = SUBSTRING(@p_ValStr,4,23)
  SELECT @l_numcra = SUBSTRING(@p_ValStr,43,12)
  SELECT @l_datstr = SUBSTRING(@p_ValStr,27,16)
  SELECT @l_datcon = SUBSTRING(@l_datstr,1,2)+'/'+SUBSTRING(@l_datstr,3,2)+'/'+SUBSTRING(@l_datstr,5,2)
  SELECT @l_numcra = SUBSTRING(@p_ValStr,43,12)
  SELECT @l_codusu = SUBSTRING(@p_ValStr,71,10)
  SELECT @l_craent = SUBSTRING(@p_ValStr,81,1)
  SELECT @l_codMso = SUBSTRING(@p_ValStr,82,2)
    
  EXECUTE  @ChkError = SP_STRTODATE @l_datcon,'DD/MM/AA',@l_datIni OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO EXC1
  END
  SELECT @l_horini = CONVERT(NUMERIC,(SUBSTRING(@l_datstr,7,2)))*60+CONVERT(NUMERIC,(SUBSTRING(@l_datstr,9,2)))
  SELECT @l_datstr = SUBSTRING(@p_ValStr,55,16)
  SELECT @l_datcon = SUBSTRING(@l_datstr,1,2)+'/'+SUBSTRING(@l_datstr,3,2)+'/'+SUBSTRING(@l_datstr,5,2)
  EXECUTE  @ChkError = SP_STRTODATE @l_datcon,'DD/MM/AA',@l_datFim OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO EXC1
  END
  SELECT @l_horFim = CONVERT(NUMERIC,(SUBSTRING(@l_datstr,7,2)))*60+CONVERT(NUMERIC,(SUBSTRING(@l_datstr,9,2)))
  /* BEGIN EXCEPTION HANDLER */
  EXC1:
  SELECT @SE_EXC1 = @ChkError
  IF @ChkError <> 0
  BEGIN
    BEGIN
      SELECT @ChkError = 0
      SELECT @l_coderr = 1
    END
  END
  /* END EXCEPTION HANDLER */
  IF (LTRIM(RTRIM(@l_idtpes)) IS NULL) 
      OR (DATALENGTH(LTRIM(RTRIM(@l_idtpes)))=0)
  BEGIN
    DECLARE c_r038hch CURSOR FOR SELECT 
      r038hch.numemp NUMEMP,r038hch.tipcol TIPCOL,r038hch.numcad NUMCAD
       FROM r038hch r038hch
       WHERE tipcra=2  and numcra=@l_numcra 
      and (craent is null or craent='N')

    OPEN c_r038HCH
    FETCH NEXT FROM c_r038HCH INTO @l_numemp, @l_tipcol, @l_numcad
    WHILE  (@@FETCH_STATUS = 0)
    BEGIN
      EXECUTE  @ChkError = SP_SINHCH2 @l_tipope,@l_numemp,@l_tipcol,@l_numcad,@l_nummat,@l_numcra,@l_datIni,@l_horIni,@l_datFim,@l_horFim,@l_codusu,@l_craent,@l_codMso,@l_codErr OUTPUT  
      IF @ChkError <> 0
      BEGIN
        GOTO FNc_r038HCH2
      END
      FETCH NEXT FROM c_r038HCH INTO @l_numemp, @l_tipcol, @l_numcad
    END
    FNc_r038HCH2: /* FINALLY OPEN CURSOR */
    CLOSE c_r038HCH
    DEALLOCATE c_r038HCH

    IF @ChkError <> 0
      GOTO FIM
      
    DECLARE c_r073hch CURSOR FOR SELECT 
      r073hch.nummat NumMat
       FROM r073hch r073hch
       WHERE tipcra=2 and numcra=@l_numcra 
      and (craent is null  or craent='N')
    OPEN c_r073HCH
    FETCH NEXT FROM c_r073HCH INTO @l_nummat
    WHILE  (@@FETCH_STATUS = 0)
    BEGIN
      EXECUTE  @ChkError = SP_SINHCH2 @l_tipope,@l_numemp,@l_tipcol,@l_numcad,@l_nummat,@l_numcra,@l_datIni,@l_horIni,@l_datFim,@l_horFim,@l_codusu,@l_craent,@l_codMso,@l_codErr OUTPUT  
      IF @ChkError <> 0
      BEGIN
        GOTO FNc_r073HCH3
      END
      FETCH NEXT FROM c_r073HCH INTO @l_nummat
    END
    FNc_r073HCH3: /* FINALLY OPEN CURSOR */
    CLOSE c_r073HCH
    DEALLOCATE c_r073HCH

    IF @ChkError <> 0
      GOTO FIM
  END
  ELSE
  BEGIN
    EXECUTE  @ChkError = SP_PESFROMIDTPES @l_idtpes,@l_tippes OUTPUT ,@l_numemp OUTPUT ,@l_tipcol OUTPUT ,@l_numcad OUTPUT ,@l_tipdoc OUTPUT ,@l_numdoc OUTPUT ,@l_nummat OUTPUT ,@l_propac OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    EXECUTE  @ChkError = SP_SINHCH2 @l_tipope,@l_numemp,@l_tipcol,@l_numcad,@l_nummat,@l_numcra,@l_datIni,@l_horIni,@l_datFim,@l_horFim,@l_codusu,@l_craent,@l_codMso,@l_codErr OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  SELECT @p_retErr = @l_codErr
FIM:
  RETURN @ChkError
END␀äø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0^R038HCH_VSOB
R073hch_VSOB
SP_SINAUD
