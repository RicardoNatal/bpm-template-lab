  /*HOUR*/
  SELECT @l_count = 2
  SELECT @l_pos = CHARINDEX('HH', @l_mask)
  IF (@l_pos<>0)
  BEGIN
    SELECT @l_validate = CONVERT(NUMERIC,SUBSTRING(@p_value,@l_pos,@l_count))
    IF (@l_validate>=0) 
      AND (@l_validate<=23)
