TRIGGER R070OCR_ED AFTER DELETE ON R070OCR FOR EACH ROW
DECLARE
    l_idtpes VARCHAR2(23);
BEGIN
  SP_RETIDTPES(:OLD.NUMEMP, 5, :OLD.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);

  /* Gera pendência para remover a foto da concentradora. Isto devido a exclusão da foto via LGPD. */
  SP_PEND82(l_idtpes, 3);
END␀␀␀.␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀EÚ␀␀I,æ	␀␀␀␀␀␀-@ê:-@q␀Æÿ␀␀ÿ␀5-·␀	␀␀␀␀␀␀\A“␀“␀s␀Æÿ␀␀ë×␀␀␀x-·␀	␀␀␀␀␀␀@¥.¥.u␀Æÿ␀␀Ø␀␀␀–DÑ␀	␀␀␀␀␀␀¨JFFFFqC␀êÿ␀␀ÿ␀ow·␀	␀␀␀␀␀␀iyxxì*␀␀Æÿ␀␀ÿ␀Éü␀␀­␀	␀␀␀␀␀␀ùş␀␀xş␀␀xş␀␀p␀Æÿ␀␀ÿ␀"␀Ú␀␀␀␀␀␀Ù␀R␀R␀n␀Æÿ␀␀ÿ␀¾Å␀␀­␀␀␀␀␀␀␀øÅ␀␀óÅ␀␀óÅ␀␀p␀Æÿ␀␀ÿ␀ÖDÑ␀␀␀␀␀␀␀I©F©FqC␀êÿ␀␀ÿ␀‰w·␀␀␀␀␀␀␀y2x2xì*␀␀Æÿ␀␀ÿ␀üó␀␀.␀␀␀␀␀␀Cô␀␀Bô␀␀Bô␀␀/␀␀ÿ␀␀ÿ␀×-‹␀␀␀␀␀␀␀™Am␀m␀—)␀␀Æÿ␀␀ÿ␀‚º␀␀>␀␀␀␀␀␀o»␀␀n»␀␀n»␀␀=␀␀ÿ␀␀ÿ␀'␀p␀␀␀␀␀␀{␀{␀{␀n␀Æÿ␀␀ÿ␀)¶␀␀Õ␀␀␀␀␀␀)·␀␀)·␀␀)·␀␀n␀Æÿ␀␀ÿ␀"Å␀␀æ␀␀␀␀␀␀.@%/%/q␀Æÿ␀␀ÿ␀9‹␀␀␀␀␀␀␀␀¦Š␀␀¤Š␀␀¤Š␀␀ ␀␀ÿ␀␀ÿ␀«%␀␀␀␀␀␀␀E&␀&␀&␀#␀␀ÿ␀␀ÿ␀m,Ì␀␀␀␀␀␀␀N@¤:¤:{␀Æÿ␀␀…×␀␀␀ó+Ì␀	␀␀␀␀␀␀X<X<X<{␀Æÿ␀␀LÙ␀␀␀␀␀FÚ␀␀	␀GÚ␀␀␀HÚ␀␀␀␀IÚ␀␀␀JÚ␀␀␀␀19;0;1;2;3;4;5␀␀5/␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀KÚ␀␀7‹␀␀3	„␀␀␀␀␀␀bŠ␀␀bŠ␀␀YŠ␀␀4␀␀ÿ␀␀ÿ␀C-·␀	„␀␀␀␀␀␀…=¿␀␀¿␀␀t␀Æÿ␀␀ı×␀␀␀EÑ␀	„␀␀␀␀␀␀tG]G]GqC␀êÿ␀␀ÿ␀¤w·␀	„␀␀␀␀␀␀pxdxdxì*␀␀Æÿ␀␀ÿ␀åDÑ␀„␀␀␀␀␀␀ûFÔFÔFqC␀êÿ␀␀ÿ␀w·␀„␀␀␀␀␀␀Hx<x<xì*␀␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3␀␀Æ¿␀␀␀␀␀␀␀␀␀LÚ␀␀(-Ì␀	␀␀␀␀␀␀v=v=v={␀Æÿ	11NÚ␀␀␀m,Ì␀␀␀␀␀␀␀N@¤:¤:{␀Æÿ␀␀…×␀␀␀à␀␀␀␀␀␀␀␀ß␀Ş␀Ş␀c␀␀␀ÿ␀␀ÿ␀¬␀␀–␀␀␀␀␀␀␀¯␀␀6868c␀Æÿ␀␀ÿ␀4	␀␀␀␀␀␀␀B	␀;	␀=	␀n␀Æÿ␀␀ÿ␀7‹␀␀3	␀␀␀␀␀␀bŠ␀␀YŠ␀␀YŠ␀␀4␀␀ÿ␀␀ÿ␀R␀î␀␀␀␀␀␀R␀R␀R␀c␀␀␀ÿ␀␀ÿ␀␀␀MÚ␀␀␀␀0␀␀`¼␀␀␀␀␀␀␀␀␀␀OÚ␀␀ª¬␀␀	␀␀␀␀␀␀’␀␀v␀␀v␀␀#␀