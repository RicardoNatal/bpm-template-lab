/* DELETE (OLD) */
TRIGGER R146PRR_ED AFTER DELETE ON R146PRR FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs ProvisaoRateios*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 65;     /* ProvisaoRateios*/
  l_codtpa := 241;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R146PRR_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.MESANO, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MESANO', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPPRV', CONVERT(NUMBER_TO_CHAR, :OLD.TIPPRV));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQPRV', CONVERT(NUMBER_TO_CHAR, :OLD.SEQPRV));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPVAL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPVAL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRAT', CONVERT(NUMBER_TO_CHAR, :OLD.CODRAT));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R146PRR_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BASPRV', CONVERT(NUMBER_TO_CHAR, :OLD.BASPRV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERVAL', CONVERT(NUMBER_TO_CHAR, :OLD.PERVAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SALANT', CONVERT(NUMBER_TO_CHAR, :OLD.SALANT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SALTRF', CONVERT(NUMBER_TO_CHAR, :OLD.SALTRF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AJUPRV', CONVERT(NUMBER_TO_CHAR, :OLD.AJUPRV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRVMES', CONVERT(NUMBER_TO_CHAR, :OLD.PRVMES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALPAG', CONVERT(NUMBER_TO_CHAR, :OLD.VALPAG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALADT', CONVERT(NUMBER_TO_CHAR, :OLD.VALADT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALIND', CONVERT(NUMBER_TO_CHAR, :OLD.VALIND));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PAGMAI', CONVERT(NUMBER_TO_CHAR, :OLD.PAGMAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AJUMAI', CONVERT(NUMBER_TO_CHAR, :OLD.AJUMAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SLDATU', CONVERT(NUMBER_TO_CHAR, :OLD.SLDATU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ANB13S', CONVERT(NUMBER_TO_CHAR, :OLD.ANB13S));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALPAR', CONVERT(NUMBER_TO_CHAR, :OLD.VALPAR));
      END;
  END IF; 
END␀␀␀¼Ç␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀¾â␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr‡␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀Ü␀Ü␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀‚%€$0.w␀Æÿ␀␀…Ó␀␀␀Ñ␀␀Ñ␀	␀␀␀␀␀␀␀0Í/Ó/œ␀␀␀êÿ␀␀¸â␀␀␀␀´␀	␀␀␀␀␀␀␀S␀S␀S␀r␀Æÿ␀␀¯â␀␀␀ëı␀␀Š␀	␀␀␀␀␀␀␀Ïş␀␀xş␀␀xş␀␀n␀Æÿ␀␀¹â␀␀␀h␀­␀	␀␀␀␀␀␀␀‘␀‘␀‘␀p␀Æÿ␀␀±â␀␀␀‘␀␀␀␀␀␀␀␀l lZ␀Æÿ␀␀ÿ␀Î½␀␀›␀␀␀␀␀␀␀␀Ó¾␀␀í½␀␀Ó¾␀␀[␀Æÿ␀␀ÿ␀wù␀␀‘␀␀␀␀␀␀␀␀§ù␀␀§ù␀␀§ù␀␀Z␀Æÿ␀␀ÿ␀ù␀␀‘␀␀␀␀␀␀␀␀Áù␀␀Ü␀Áù␀␀Z␀Æÿ␀␀ÿ␀;‘␀␀␀␀␀␀␀␀t`tZ␀Æÿ␀␀ÿ␀&È␀␀‘␀␀␀␀␀␀␀␀©"␀ßÇ␀␀©"␀Z␀Æÿ␀␀ÿ␀␀‘␀␀␀␀␀␀␀␀¥!␀$º␀␀¥!␀Z␀Æÿ␀␀ÿ␀x␀‘␀␀␀␀␀␀␀␀Ö␀eÕ␀Z␀Æÿ␀␀ÿ␀Ò␀‘␀␀␀␀␀␀␀␀C!␀Â␀␀B!␀Z␀Æÿ␀␀ÿ␀®¹␀␀‘␀␀␀␀␀␀␀␀¤!␀%º␀␀¤!␀Z␀Æÿ␀␀ÿ␀8‘␀␀␀␀␀␀␀␀‚q‚Z␀Æÿ␀␀ÿ␀Ì␀‘␀␀␀␀␀␀␀␀¯ù␀␀¯ù␀␀¯ù␀␀Z␀Æÿ␀␀ÿ␀’‘␀␀␀␀␀␀␀␀Z␀Æÿ␀␀ÿ␀	␀‘␀␀␀␀␀␀␀␀¬!␀ôº␀␀¬!␀Z␀Æÿ␀␀ÿ␀)+‘␀␀␀␀␀␀␀␀d&M&M&h)␀␀Æÿ␀␀ÿ␀++‘␀␀␀␀␀␀␀␀e&U&U&h)␀␀Æÿ␀␀ÿ␀,+‘␀␀␀␀␀␀␀␀f&W&W&h)␀␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3;4;5;6Àâ␀␀		SENIOR;0›␀␀/* INSERT (NEW) */
TRIGGER R146PRV_EI AFTER INSERT ON R146PRV FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs ProvisaoValores*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 64;     /* ProvisaoValores*/
  l_codtpa := 239;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R146PRV_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.MESANO, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MESANO', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPPRV', CONVERT(NUMBER_TO_CHAR, :NEW.TIPPRV));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQPRV', CONVERT(NUMBER_TO_CHAR, :NEW.SEQPRV));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPVAL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPVAL));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R146PRV_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BASPRV', CONVERT(NUMBER_TO_CHAR, :NEW.BASPRV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERVAL', CONVERT(NUMBER_TO_CHAR, :NEW.PERVAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SALANT', CONVERT(NUMBER_TO_CHAR, :NEW.SALANT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SALTRF', CONVERT(NUMBER_TO_CHAR, :NEW.SALTRF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AJUPRV', CONVERT(NUMBER_TO_CHAR, :NEW.AJUPRV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRVMES', CONVERT(NUMBER_TO_CHAR, :NEW.PRVMES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALPAG', CONVERT(NUMBER_TO_CHAR, :NEW.VALPAG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALADT', CONVERT(NUMBER_TO_CHAR, :NEW.VALADT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALIND', CONVERT(NUMBER_TO_CHAR, :NEW.VALIND));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PAGMAI', CONVERT(NUMBER_TO_CHAR, :NEW.PAGMAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AJUMAI', CONVERT(NUMBER_TO_CHAR, :NEW.AJUMAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SLDATU', CONVERT(NUMBER_TO_CHAR, :NEW.SLDATU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ANB13S', CONVERT(NUMBER_TO_CHAR, :NEW.ANB13S));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALPAR', CONVERT(NUMBER_TO_CHAR, :NEW.VALPAR));
      END;
  END IF; 
END␀Áâ␀␀		SENIOR;0y␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R146PRV_EU AFTER UPDATE ON R146PRV FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs ProvisaoValores*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 64;     /* ProvisaoValores*/
  l_codtpa := 240;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.MesAno <> :NEW.MesAno)
   OR (:OLD.TipPrv <> :NEW.TipPrv)
   OR (:OLD.SeqPrv <> :NEW.SeqPrv)
   OR (:OLD.TipVal <> :NEW.TipVal)
   OR (:OLD.BasPrv <> :NEW.BasPrv)
   OR (:OLD.PerVal <> :NEW.PerVal)
   OR (:OLD.SalAnt <> :NEW.SalAnt)
   OR (:OLD.SalTrf <> :NEW.SalTrf)
   OR (:OLD.AjuPrv <> :NEW.AjuPrv)
   OR (:OLD.PrvMes <> :NEW.PrvMes)
   OR (:OLD.ValPag <> :NEW.ValPag)
   OR (:OLD.ValAdt <> :NEW.ValAdt)
   OR (:OLD.ValInd <> :NEW.ValInd)
   OR (:OLD.PagMai <> :NEW.PagMai)
   OR (:OLD.AjuMai <> :NEW.AjuMai)
   OR (:OLD.SldAtu <> :NEW.SldAtu)
   OR (:OLD.Anb13s <> :NEW.Anb13s)
   OR (:OLD.ValPar <> :NEW.ValPar)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R146PRV_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.MESANO, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MESANO', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPPRV', CONVERT(NUMBER_TO_CHAR, :OLD.TIPPRV));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQPRV', CONVERT(NUMBER_TO_CHAR, :OLD.SEQPRV));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPVAL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPVAL));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R146PRV_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDBASPRV', CONVERT(NUMBER_TO_CHAR, :OLD.BASPRV));
