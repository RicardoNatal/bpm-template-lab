DECLARE
  l_Valor VARCHAR2(2000);
  l_ProximaData DATE;
  l_EmpresaStr VARCHAR2(11);
  l_FilialStr VARCHAR2(11);
  l_Where VARCHAR2(50);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN 
  /*e-Social -> S-1000 */ 
  l_Valor := '';
  l_ProximaData := '31/12/1900,00:00:00';
  
  l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP);
  l_FilialStr := CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL);

  l_Where := 'NUMEMP = ' || l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr;
  SP_PROXIMOHIST('DATALT', 'R030ESO', l_Where, :NEW.DATALT, l_ProximaData OUT);    

  SP_CONCATENAR_NUM('CODFIL', :NEW.CODFIL, l_Valor OUT);
  SP_E_SOCIAL('S-1000', 'R030ESO', 'T', 'I', :NEW.DATALT, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030ESO_EI');
  /*e-Social -> S-1000 */
  
  
  /* Geração de logs - Filiais - eSocial */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 51;     /* Filiais - eSocial */
  l_codtpa := 213;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030ESO_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
        SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030ESO_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CLATRI', CONVERT(NUMBER_TO_CHAR, :NEW.CLATRI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDCOO', CONVERT(NUMBER_TO_CHAR, :NEW.INDCOO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDOBR', CONVERT(NUMBER_TO_CHAR, :NEW.INDOBR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ACOINT', CONVERT(NUMBER_TO_CHAR, :NEW.ACOINT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SOCOST', :NEW.SOCOST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITEST', CONVERT(NUMBER_TO_CHAR, :NEW.SITEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITPFI', CONVERT(NUMBER_TO_CHAR, :NEW.SITPFI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REGELE', CONVERT(NUMBER_TO_CHAR, :NEW.REGELE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NATEST', CONVERT(NUMBER_TO_CHAR, :NEW.NATEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REPSOC', :NEW.REPSOC);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FINLUC', :NEW.FINLUC);        
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TRATEM', :NEW.TRATEM);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REGTEM', :NEW.REGTEM);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERIRR', :NEW.PERIRR);
      END;
  END IF; 
END␀%Ò␀␀		SENIOR;0ñ!␀␀

TRIGGER R030ESO_EU BEFORE UPDATE ON R030ESO FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);  
  l_Valido BOOLEAN;
  l_ProximaData DATE;
  l_AlterouRegistro BOOLEAN;
  l_EmpresaStr VARCHAR2(11);
  l_FilialStr VARCHAR2(11);
  l_Where VARCHAR2(50);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_InfoFacult   BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  /*e-Social -> S-1000 */ 
  l_Valor := '';
  l_ProximaData := '31/12/1900,00:00:00';
  l_AlterouRegistro := FALSE;
  l_InfoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;
  
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  
  /* Só monitora o campo se o cliente opta por enviar as informações facultativas*/
  IF (l_InfoFacult = TRUE AND l_SimplificaoESocial = FALSE) THEN
      SP_VALUPDATE_DES(:OLD.FINLUC, :NEW.FINLUC, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_AlterouRegistro := TRUE;
      END IF;
      
      SP_VALUPDATE_NUM(:OLD.SITEST, :NEW.SITEST, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_AlterouRegistro := TRUE;
      END IF;
      
      SP_VALUPDATE_NUM(:OLD.SITPFI, :NEW.SITPFI, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_AlterouRegistro := TRUE;
      END IF;
      
      SP_VALUPDATE_DES(:OLD.TRATEM, :NEW.TRATEM, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_AlterouRegistro := TRUE;
      END IF;
      
      SP_VALUPDATE_DES(:OLD.REGTEM, :NEW.REGTEM, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_AlterouRegistro := TRUE;
      END IF;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.CLATRI, :NEW.CLATRI, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
	  l_AlterouRegistro := TRUE;
  END IF;
  
  
  SP_VALUPDATE_NUM(:OLD.INDOBR, :NEW.INDOBR, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro := TRUE;
  END IF;  
  
  SP_VALUPDATE_NUM(:OLD.INDCOO, :NEW.INDCOO, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.REGELE, :NEW.REGELE, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro := TRUE;
  END IF;
    
  SP_VALUPDATE_NUM(:OLD.ACOINT, :NEW.ACOINT, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro := TRUE;
  END IF;
  
  IF (l_SimplificaoESocial = FALSE) THEN
    SP_VALUPDATE_NUM(:OLD.NATEST, :NEW.NATEST, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouRegistro := TRUE;
    END IF;
  END IF;   
  
  SP_VALUPDATE_NUM(:OLD.OPCPRU, :NEW.OPCPRU, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro := TRUE;
  END IF; 
  
  IF (l_SimplificaoESocial = TRUE) THEN
    SP_VALUPDATE_DES(:OLD.TRASOC, :NEW.TRASOC, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouRegistro := TRUE;
    END IF;
  END IF;
  
  IF (l_VersaoESocial >= 7) THEN
    SP_VALUPDATE_DES(:OLD.PERIRR, :NEW.PERIRR, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouRegistro := TRUE;
    END IF;  
  END IF;  
  
  IF (l_AlterouRegistro = TRUE) THEN
    l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP);
    l_FilialStr := CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL);

    l_Where := 'NUMEMP = ' ||  l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr;    
    SP_PROXIMOHIST('DATALT', 'R030ESO', l_Where, :NEW.DATALT, l_ProximaData OUT);      

    SP_CONCATENAR_NUM('CODFIL', :NEW.CODFIL, l_Valor OUT);
    SP_E_SOCIAL('S-1000', 'R030ESO', 'T', 'A', :NEW.DATALT, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030ESO_EU');
  END IF;
  /*e-Social -> S-1000 */
  
  
  /* Geração de logs - Filiais - eSocial */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 51;     /* Filiais - eSocial */
  l_codtpa := 214;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFil <> :NEW.CodFil)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.ClaTri <> :NEW.ClaTri)
   OR (:OLD.IndCoo <> :NEW.IndCoo)
   OR (:OLD.IndObr <> :NEW.IndObr)
   OR (:OLD.AcoInt <> :NEW.AcoInt)
   OR (:OLD.SocOst <> :NEW.SocOst)
   OR (:OLD.SitEst <> :NEW.SitEst)
   OR (:OLD.SitPFi <> :NEW.SitPFi)
   OR (:OLD.RegEle <> :NEW.RegEle)
   OR (:OLD.NatEst <> :NEW.NatEst)
   OR (:OLD.RepSoc <> :NEW.RepSoc)
   OR (:OLD.FinLuc <> :NEW.FinLuc)
   OR (:OLD.TraTem <> :NEW.TraTem)
   OR (:OLD.RegTem <> :NEW.RegTem)
   OR (:OLD.PerIrr <> :NEW.PerIrr)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030ESO_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030ESO_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCLATRI', CONVERT(NUMBER_TO_CHAR, :OLD.CLATRI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCLATRI', CONVERT(NUMBER_TO_CHAR, :NEW.CLATRI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINDCOO', CONVERT(NUMBER_TO_CHAR, :OLD.INDCOO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINDCOO', CONVERT(NUMBER_TO_CHAR, :NEW.INDCOO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINDOBR', CONVERT(NUMBER_TO_CHAR, :OLD.INDOBR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINDOBR', CONVERT(NUMBER_TO_CHAR, :NEW.INDOBR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDACOINT', CONVERT(NUMBER_TO_CHAR, :OLD.ACOINT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWACOINT', CONVERT(NUMBER_TO_CHAR, :NEW.ACOINT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSOCOST', :OLD.SOCOST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSOCOST', :NEW.SOCOST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSITEST', CONVERT(NUMBER_TO_CHAR, :OLD.SITEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSITEST', CONVERT(NUMBER_TO_CHAR, :NEW.SITEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSITPFI', CONVERT(NUMBER_TO_CHAR, :OLD.SITPFI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSITPFI', CONVERT(NUMBER_TO_CHAR, :NEW.SITPFI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDREGELE', CONVERT(NUMBER_TO_CHAR, :OLD.REGELE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWREGELE', CONVERT(NUMBER_TO_CHAR, :NEW.REGELE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNATEST', CONVERT(NUMBER_TO_CHAR, :OLD.NATEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNATEST', CONVERT(NUMBER_TO_CHAR, :NEW.NATEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDREPSOC', :OLD.REPSOC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWREPSOC', :NEW.REPSOC);        
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFINLUC', :OLD.FINLUC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFINLUC', :NEW.FINLUC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTRATEM', :OLD.TRATEM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTRATEM', :NEW.TRATEM);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDREGTEM', :OLD.REGTEM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWREGTEM', :NEW.REGTEM);        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERIRR', :OLD.PERIRR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERIRR', :NEW.PERIRR);
      END;
    END IF; 
  END IF;   
END␀#Ò␀␀		SENIOR;0+␀␀

TRIGGER R030ESO_ED BEFORE DELETE ON R030ESO FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);
  l_ProximaData DATE;
  l_EmpresaStr VARCHAR2(11);
  l_FilialStr VARCHAR2(11);
  l_Where VARCHAR2(50);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);  
BEGIN 
  /*e-Social -> S-1000 */ 
  l_Valor := '';
  l_ProximaData := '31/12/1900,00:00:00';  

  l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP);
  l_FilialStr := CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL);

  l_Where := 'NUMEMP = ' ||  l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr;    
  SP_PROXIMOHIST('DATALT', 'R030ESO', l_Where, :OLD.DATALT, l_ProximaData OUT);

  SP_CONCATENAR_NUM('CODFIL', :OLD.CODFIL, l_Valor OUT);
  SP_E_SOCIAL('S-1000', 'R030ESO', 'T', 'E', :OLD.DATALT, l_ProximaData, :OLD.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030ESO_ED');
  /*e-Social -> S-1000 */
  
  
  /* Geração de logs - Filiais - eSocial */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 51;     /* Filiais - eSocial */
  l_codtpa := 213;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030ESO_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030ESO_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CLATRI', CONVERT(NUMBER_TO_CHAR, :OLD.CLATRI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDCOO', CONVERT(NUMBER_TO_CHAR, :OLD.INDCOO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDOBR', CONVERT(NUMBER_TO_CHAR, :OLD.INDOBR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ACOINT', CONVERT(NUMBER_TO_CHAR, :OLD.ACOINT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SOCOST', :OLD.SOCOST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITEST', CONVERT(NUMBER_TO_CHAR, :OLD.SITEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITPFI', CONVERT(NUMBER_TO_CHAR, :OLD.SITPFI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REGELE', CONVERT(NUMBER_TO_CHAR, :OLD.REGELE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NATEST', CONVERT(NUMBER_TO_CHAR, :OLD.NATEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REPSOC', :OLD.REPSOC);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FINLUC', :OLD.FINLUC);        
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TRATEM', :OLD.TRATEM);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REGTEM', :OLD.REGTEM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERIRR', :OLD.PERIRR);
      END;
  END IF; 
END␀␀␀n␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀'Ò␀␀…¬␀␀´␀	Ôÿ1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀␀ò	Ôÿ1␀␀␀␀␀“␀“␀“␀n␀Æÿ␀␀ÿ␀š¬␀␀¢␀	Ôÿ1␀␀␀␀␀|°␀␀|°␀␀|°␀␀i␀Æÿ␀␀ÿ␀Ø)Ôÿ1␀␀␀␀␀|°␀␀|°␀␀|°␀␀£␀␀ÿ␀␀O"␀mDÑ␀	Ôÿ1␀␀␀␀␀‡J‡J‡Jœ␀␀␀êÿ␀␀ÿ␀—,¼␀Ôÿ1␀␀␀␀␀^=nÄ«␀␀X)␀ˆ␀Æÿ␀␀!#␀␀␀␀0;1;2;4(Ò␀␀		SENIOR;0’␀␀TRIGGER R030EST_EI AFTER INSERT ON R030EST FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
  l_ProximaData DATE;
  l_infoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  /* e-Social -> S-1005 e S-1080 */
  l_Valor := '';
  l_ProximaData := '31/12/1900,00:00:00';
  l_infoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;

  /* Só monitora o campo se o cliente opta por enviar as informações facultativas	*/
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  
  /* Somente deve enviar a pendência se o estabelecimento tiver uma filial informada */  
  IF (:NEW.CODFIL > 0) THEN  	
	BEGIN
	  SELECT MIN(DATALT) INTO l_ProximaData FROM R030EST  
	   WHERE NUMEMP = :NEW.NUMEMP AND TIPINS = :NEW.TIPINS AND NUMINS = :NEW.NUMINS AND DATALT > :NEW.DATALT;
	EXCEPTION
	  WHEN NO_DATA_FOUND THEN
		l_ProximaData := '31/12/1900,00:00:00';	
	  WHEN OTHERS THEN
		NULL;		
	END;
	  
	SP_CONCATENAR_NUM('TIPINS', :NEW.TIPINS, l_Valor OUT);
	SP_CONCATENAR_FLO('NUMINS', :NEW.NUMINS, 0, l_Valor OUT);  
	SP_CONCATENAR_NUM('CODFIL', :NEW.CODFIL, l_Valor OUT);

	/* Tipo de Inscrição 5 = Operador Portuário */
	IF (:NEW.TIPINS <> 5) THEN
	  SP_E_SOCIAL('S-1005', 'R030EST', 'T', 'I', :NEW.DATALT, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030EST_EI');  	
	END IF;  
	IF (:NEW.TIPINS = 5 AND l_SimplificaoESocial = FALSE) THEN
	  SP_E_SOCIAL('S-1080', 'R030EST', 'T', 'I', :NEW.DATALT, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030EST_EI');
	END IF;
	
  END IF;  
  /* e-Social -> S-1005 e S-1080 */
END␀)Ò␀␀		SENIOR;0␀␀

TRIGGER R030EST_EU BEFORE UPDATE ON R030EST FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
  l_Alterou BOOLEAN;
  l_Valido BOOLEAN;
  l_ProximaData DATE;
  l_Empresa VARCHAR(5);
  l_TipoInscricao VARCHAR(1);
  l_NumeroInscricao VARCHAR(15);  
  l_Where VARCHAR(100);
  l_infoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  /* e-Social -> S-1005 e S-1080 */
  l_Valor := '';
  l_Alterou := FALSE;
  l_ProximaData := '31/12/1900,00:00:00';
  l_Empresa := '';
  l_TipoInscricao := '';
  l_NumeroInscricao := '';
  l_Where := '';
  l_infoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;

  /* Só monitora o campo se o cliente opta por enviar as informações facultativas	*/
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  
  SP_VALUPDATE_NUM(:OLD.CODFIL, :NEW.CODFIL, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    SP_CONCATENAR_NUM('CODFIL', :NEW.CODFIL, l_Valor OUT);
    l_Alterou := TRUE;
  END IF;  
  
  IF (l_Alterou = TRUE) THEN	
    l_Empresa := CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP);
    l_TipoInscricao := :NEW.TIPINS;
	l_NumeroInscricao := CONVERT(NUMBER_TO_CHAR, :NEW.NUMINS);
	
	l_Where := 'NUMEMP = ' || l_Empresa || ' AND TIPINS = '|| l_TipoInscricao ||' AND NUMINS = '|| l_NumeroInscricao;
	SP_PROXIMOHIST('DATALT', 'R030EST', l_Where, :NEW.DATALT, l_ProximaData OUT);
	
	SP_CONCATENAR_NUM('TIPINS', :NEW.TIPINS, l_Valor OUT);
  	SP_CONCATENAR_FLO('NUMINS', :NEW.NUMINS, 0, l_Valor OUT);
	
	/* Tipo de Inscrição 5 = Operador Portuário */
	IF (:NEW.TIPINS <> 5) THEN
	  SP_E_SOCIAL('S-1005', 'R030EST', 'T', 'A', :NEW.DATALT, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030EST_EU');  	
	END IF;
    IF (:NEW.TIPINS = 5 AND l_SimplificaoESocial = FALSE) THEN	
      SP_E_SOCIAL('S-1080', 'R030EST', 'T', 'A', :NEW.DATALT, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030EST_EU');	  
    END IF;
	
  END IF;
  /* e-Social -> S-1005 e S-1080 */
END␀␀␀?f␀␀␀␀␀␀␀*Ò␀␀…¬␀␀´␀	Ôÿ1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀—,¼␀	Ôÿ1␀␀␀␀␀=nnX)␀␀Æÿ␀␀!#␀P+Ñ␀	Ôÿ1␀␀␀␀␀r0Ó/Ó/œ␀␀␀êÿ␀␀ÿ␀Üí␀␀ºÔï!␀␀␀␀␀Tî␀␀»í␀␀Qî␀␀n␀Æÿ␀␀ÿ␀ğ(¼␀Ôï!␀␀␀␀␀)ó()X)␀␀Æÿ␀␀!#␀W(¶Ôï!␀␀␀␀␀k(E(e(p␀Æÿ␀␀ÿ␀À´␀Ôï!␀␀␀␀␀ÍÄÄr␀Æÿ␀␀ìÏ␀␀␀w·␀Ôï!␀␀␀␀␀s␀Æÿ␀␀êÏ␀␀␀ìa™␀Ôï!␀␀␀␀␀&cXbXbe␀Æÿ␀␀ÿ␀Ø(ÁÔï!␀␀␀␀␀„?ç+í;q␀Æÿ␀␀ÿ␀şŸ␀␀AÔï!␀␀␀␀␀˜ ␀␀” ␀␀” ␀␀n␀Æÿ␀␀ÿ␀q(Ôï!␀␀␀␀␀Î±␀␀KqKq1␀␀ÿ␀␀ÿ␀␀=Ôÿ1␀␀␀␀␀é␀␀Š␀c␀␀␀ÿ␀␀ÿ␀jO=Ôÿ1␀␀␀␀␀á_à_à_c␀␀␀ÿ␀␀ÿ␀X=Ôÿ1␀␀␀␀␀ZYZc␀␀␀ÿ␀␀ÿ␀}=Ôÿ1␀␀␀␀␀’“c␀␀␀ÿ␀␀ÿ␀␀␀␀0;1;2,Ò␀␀		SENIOR;0æ
␀␀TRIGGER R030FFG_AI AFTER INSERT ON R030FFG FOR EACH ROW

DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN   
  /* Geração de logs - Filiais - FGTS */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 52;     /* Filiais - FGTS */
  l_codtpa := 215;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030FFG_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
        SP_DATSTR(:NEW.CMPFGT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPFGT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030FFG_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RECFGT', CONVERT(NUMBER_TO_CHAR, :NEW.RECFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CENFGT', CONVERT(NUMBER_TO_CHAR, :NEW.CENFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CATFGT', CONVERT(NUMBER_TO_CHAR, :NEW.CATFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BANFGT', CONVERT(NUMBER_TO_CHAR, :NEW.BANFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AGEFGT', CONVERT(NUMBER_TO_CHAR, :NEW.AGEFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EMPFGT', CONVERT(NUMBER_TO_CHAR, :NEW.EMPFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CDRFGT', CONVERT(NUMBER_TO_CHAR, :NEW.CDRFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MODARQ', CONVERT(NUMBER_TO_CHAR, :NEW.MODARQ));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FUNPRO', :NEW.FUNPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'UTIFIN', :NEW.UTIFIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DEBAUT', :NEW.DEBAUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ADESMS', :NEW.ADESMS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AGEREC', :NEW.AGEREC);
      END;
  END IF; 
END␀-Ò␀␀		SENIOR;06␀␀

TRIGGER R030FFG_AU AFTER UPDATE ON R030FFG FOR EACH ROW

DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);  
BEGIN 
  /* Geração de logs - Filiais - FGTS */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 52;     /* Filiais - FGTS */
  l_codtpa := 216;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFil <> :NEW.CodFil)
   OR (:OLD.CmpFgt <> :NEW.CmpFgt)
   OR (:OLD.RecFgt <> :NEW.RecFgt)
   OR (:OLD.CenFgt <> :NEW.CenFgt)
   OR (:OLD.CatFgt <> :NEW.CatFgt)
   OR (:OLD.BanFgt <> :NEW.BanFgt)
   OR (:OLD.AgeFgt <> :NEW.AgeFgt)
   OR (:OLD.EmpFgt <> :NEW.EmpFgt)
   OR (:OLD.CdrFgt <> :NEW.CdrFgt)
   OR (:OLD.ModArq <> :NEW.ModArq)
   OR (:OLD.FunPro <> :NEW.FunPro)
   OR (:OLD.UtiFin <> :NEW.UtiFin)
   OR (:OLD.DebAut <> :NEW.DebAut)
   OR (:OLD.AdeSMS <> :NEW.AdeSMS)
   OR (:OLD.AgeRec <> :NEW.AgeRec)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030FFG_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        SP_DATSTR(:OLD.CMPFGT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPFGT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030FFG_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDRECFGT', CONVERT(NUMBER_TO_CHAR, :OLD.RECFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWRECFGT', CONVERT(NUMBER_TO_CHAR, :NEW.RECFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCENFGT', CONVERT(NUMBER_TO_CHAR, :OLD.CENFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCENFGT', CONVERT(NUMBER_TO_CHAR, :NEW.CENFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCATFGT', CONVERT(NUMBER_TO_CHAR, :OLD.CATFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCATFGT', CONVERT(NUMBER_TO_CHAR, :NEW.CATFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDBANFGT', CONVERT(NUMBER_TO_CHAR, :OLD.BANFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWBANFGT', CONVERT(NUMBER_TO_CHAR, :NEW.BANFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAGEFGT', CONVERT(NUMBER_TO_CHAR, :OLD.AGEFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAGEFGT', CONVERT(NUMBER_TO_CHAR, :NEW.AGEFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDEMPFGT', CONVERT(NUMBER_TO_CHAR, :OLD.EMPFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWEMPFGT', CONVERT(NUMBER_TO_CHAR, :NEW.EMPFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCDRFGT', CONVERT(NUMBER_TO_CHAR, :OLD.CDRFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCDRFGT', CONVERT(NUMBER_TO_CHAR, :NEW.CDRFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDMODARQ', CONVERT(NUMBER_TO_CHAR, :OLD.MODARQ));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWMODARQ', CONVERT(NUMBER_TO_CHAR, :NEW.MODARQ));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFUNPRO', :OLD.FUNPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFUNPRO', :NEW.FUNPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDUTIFIN', :OLD.UTIFIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWUTIFIN', :NEW.UTIFIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDEBAUT', :OLD.DEBAUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDEBAUT', :NEW.DEBAUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDADESMS', :OLD.ADESMS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWADESMS', :NEW.ADESMS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAGEREC', :OLD.AGEREC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAGEREC', :NEW.AGEREC);
      END;
    END IF; 
  END IF; 
END␀+Ò␀␀		SENIOR;0è
