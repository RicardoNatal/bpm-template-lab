TRIGGER R038HAD_EI AFTER INSERT ON R038HAD FOR EACH ROW

DECLARE
  l_datAdi       DATE;
  l_datatu       DATE; 
  l_data_zero    DATE;
  l_comando_nulo BOOLEAN;
BEGIN
  l_datatu    := CURDATE();
  l_data_zero := '31/12/1900,00:00:00';

  IF :NEW.STAHIS = 1 THEN
    BEGIN
      SELECT R034FUN.DATADI INTO l_datadi
        FROM R034FUN
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      l_comando_nulo:=TRUE;
    END;
    IF (((:NEW.DATALT >= l_datadi) OR (l_datadi IS NULL)) AND 
	    ((:NEW.CMPTER >= l_datatu) OR (:NEW.CMPTER = l_data_zero))) THEN
      UPDATE R034FUN
         SET DATADI = :NEW.DATALT,
             PERINS = :NEW.PERINS,
             PERPER = :NEW.PERPER,
             APOESP = :NEW.APOESP,
             FATTPO = :NEW.FATTPO
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    END IF;
  END IF;
END␀ƒÔ␀␀		SENIOR;0}␀␀

TRIGGER R038HAD_EU AFTER UPDATE ON R038HAD FOR EACH ROW

DECLARE
  l_datAdi       DATE;
  l_datatu       DATE;
  l_data_zero    DATE;
  l_comando_nulo BOOLEAN;
BEGIN
  l_datatu := CURDATE();
  l_data_zero    := '31/12/1900,00:00:00';
  
  IF :NEW.STAHIS = 1 THEN
    BEGIN
      SELECT R034FUN.DATADI INTO l_datadi
        FROM R034FUN
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      l_comando_nulo:=TRUE;
    END;
    
	IF (((:NEW.DATALT >= l_datadi) OR (l_datadi IS NULL)) AND
        ((:NEW.CMPTER >= l_datatu) OR (:NEW.CMPTER = l_data_zero))) THEN
      UPDATE R034FUN
         SET DATADI = :NEW.DATALT,
             PERINS = :NEW.PERINS,
             PERPER = :NEW.PERPER,
             APOESP = :NEW.APOESP,
             FATTPO = :NEW.FATTPO
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
	ELSIF (:NEW.CMPTER < l_datatu) THEN
      UPDATE R034FUN
         SET DATADI = l_data_zero,
             PERINS = 0,
             PERPER = 0,
             APOESP = 0,
             FATTPO = 0
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
	END IF;	
  END IF;
END␀„Ô␀␀	SENIOR;0)
␀␀TRIGGER R038HAD_SD AFTER DELETE ON R038HAD

DECLARE
l_datalt       DATE;
  l_perins       NUMBER(5,2);
  l_perper       NUMBER(5,2);
  l_apoesp       NUMBER(2);
  l_fattpo       NUMBER(4,2);
  l_data_zero    DATE;
  l_datatu       DATE; 
  l_comando_nulo BOOLEAN;

  /* CURSOR c/ os registros gravados no R038HAD_AUX */
  CURSOR c_r038had_del IS SELECT NUMEMP,TIPCOL,NUMCAD FROM R038HAD_AUX;
  TYPE t_r038HAD_aux IS RECORD(
    NUMEMP   R038HAD_AUX.NUMEMP%TYPE,
    TIPCOL   R038HAD_AUX.TIPCOL%TYPE,
    NUMCAD   R038HAD_AUX.NUMCAD%TYPE);
  l_r038HAD_aux t_r038HAD_aux;

BEGIN
  l_data_zero    := '31/12/1900,00:00:00';
  l_datatu       := CURDATE();
  l_comando_nulo := FALSE;

  /* Le Registro do CURSOR */
  FOREACH c_r038had_del INTO  l_r038HAD_aux.NUMEMP,
                              l_r038HAD_aux.TIPCOL,
                              l_r038HAD_aux.NUMCAD
  LOOP
   /* Pega o historico anterior */
    BEGIN
      SELECT A.DATALT, A.PERINS, A.PERPER, A.APOESP, A.FATTPO
        INTO l_datalt, l_perins, l_perper, l_apoesp, l_fattpo
        FROM R038HAD A
       WHERE A.NUMEMP = l_r038had_aux.NUMEMP
         AND A.TIPCOL = l_r038had_aux.TIPCOL
         AND A.NUMCAD = l_r038had_aux.NUMCAD
         AND A.STAHIS = 1
         AND (A.CMPTER >= l_datatu OR A.CMPTER = l_data_zero)
         AND DATALT IN (SELECT MAX(DATALT) FROM R038HAD
                         WHERE NUMEMP = l_r038had_aux.NUMEMP
                           AND TIPCOL = l_r038had_aux.TIPCOL
                           AND NUMCAD = l_r038had_aux.NUMCAD
                           AND STAHIS = 1);
    EXCEPTION
      WHEN TOO_MANY_ROWS THEN
        RAISERROR 103 'Erro em R038HAD - TOO MANY ROWS';
      WHEN NO_DATA_FOUND THEN
        l_datalt:=l_data_zero;
        l_perins:=0;
        l_perper:=0;
        l_apoesp:=0;
        l_fattpo:=0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT R038HAD';
    END;
    
	/* Atualiza tabela de colaboradores */
    BEGIN
      UPDATE R034FUN
        SET DATADI = l_datalt,
            PERINS = l_perins,
            PERPER = l_perper,
            APOESP = l_apoesp,
            FATTPO = l_fattpo
      WHERE R034FUN.TIPCOL = l_r038had_aux.TIPCOL AND
            R034FUN.NUMEMP = l_r038had_aux.NUMEMP AND
            R034FUN.NUMCAD = l_r038had_aux.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro Na Atualização do R034FUN';
    END;

  END LOOP;

  /* Apaga Registro OLD em R038HAD_AUX */
  BEGIN
    DELETE FROM R038HAD_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀Ô␀␀		SENIOR;0␀␀

TRIGGER R038HAD_ED AFTER DELETE ON R038HAD FOR EACH ROW

DECLARE
  l_datadi       DATE;
  l_perins       NUMBER(5,2);
  l_perper       NUMBER(5,2);
  l_apoesp       NUMBER(2);
  l_fattpo       NUMBER(4,2);
  l_comando_nulo BOOLEAN;
BEGIN 
  IF :OLD.STAHIS = 1 THEN
    l_comando_nulo:=FALSE;
    BEGIN
      SELECT R034FUN.DATADI, R034FUN.PERINS, R034FUN.PERPER, R034FUN.APOESP, R034FUN.FATTPO
        INTO l_datadi, l_perins, l_perper, l_apoesp, l_fattpo
        FROM R034FUN
       WHERE R034FUN.TIPCOL = :OLD.TIPCOL AND
             R034FUN.NUMEMP = :OLD.NUMEMP AND
             R034FUN.NUMCAD = :OLD.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      l_comando_nulo:=TRUE;
    END;
    
    IF (l_comando_nulo = FALSE) THEN
      IF ((:OLD.DATALT = l_datadi) OR ((:OLD.DATALT IS NULL) AND (l_datadi IS NULL))) AND
         ((:OLD.PERINS = l_perins) OR ((:OLD.PERINS IS NULL) AND (l_perins IS NULL))) AND
         ((:OLD.PERPER = l_perper) OR ((:OLD.PERPER IS NULL) AND (l_perper IS NULL))) AND
         ((:OLD.APOESP = l_apoesp) OR ((:OLD.APOESP IS NULL) AND (l_apoesp IS NULL))) AND
         ((:OLD.FATTPO = l_fattpo) OR ((:OLD.FATTPO IS NULL) AND (l_fattpo IS NULL))) THEN
        BEGIN
        
        /* Insere Registro Old */
          INSERT INTO R038HAD_AUX (NUMEMP,TIPCOL,NUMCAD)
                           VALUES (:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD);
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro no INSERT em R038HAD_AUX.';
          END;
      END IF;
    END IF;
  END IF;
END␀␀␀rv␀␀␀␀␀␀␀␀␀␀␀€Ô␀␀…¬␀␀´␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀␀␀␀␀␀␀P%€$0.w␀Æÿ␀␀ÿ␀mDÑ␀␀␀␀␀␀␀:IÙE¼qC␀êÿ␀␀ÿ␀µEÑ␀␀␀␀␀␀␀ÚHÉHÉHqC␀êÿ␀␀ÿ␀a½␀␀¹␀␀␀␀␀␀␀('(Q)␀␀Æÿ␀␀ÿ␀“½␀␀¹␀␀␀␀␀␀␀YPYQ)␀␀Æÿ␀␀ÿ␀Òl¶␀␀␀␀␀␀␀élÓlél4)␀␀Æÿ␀␀ÿ␀é␀␀␀␀␀␀^°␀␀õp␀Æÿ␀␀ÿ␀*␀É␀␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀…+Ñ␀␀␀␀␀␀␀000œ␀␀␀êÿ␀␀ÿ␀␀␀␀␀␀␀sv␀␀␀␀␀␀␀␀␀␀␀␀…Ô␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ?␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ?␀␀␀␀␀.%€$0.w␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ôÿ?␀␀␀␀␀NL¢G¢GqC␀êÿ␀␀ÿ␀µEÑ␀Ôÿ?␀␀␀␀␀ºLÉHÉHqC␀␀êÿ␀␀ÿ␀Pš␀␀	Ôÿ?␀␀␀␀␀›␀␀úš␀␀úš␀␀n␀Æÿ␀␀ÿ␀V¬␀␀Á␀Ôÿ?␀␀␀␀␀È?aay␀Æÿ␀␀ê␀␀␀␀␀␀0;1;2;3‡Ô␀␀		SENIOR;0h␀␀TRIGGER R038HAT_EI AFTER INSERT ON R038HAT FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataInicio DATE;
	l_DataTermino DATE;
	l_DataInicioSST DATE;
	l_NumEmpStr VARCHAR(11);
	l_TipColStr VARCHAR(11);
	l_NumCadStr VARCHAR(11);
	l_Where VARCHAR(2000);
	l_DatAltProxHist DATE;	
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);	
	
	RH_RET_DATINISST(:NEW.NumEmp, l_DataInicioSST OUT);
	IF (l_DataInicioSST > l_DataZero) THEN
		l_NumEmpStr := CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp);
		l_TipColStr := CONVERT(NUMBER_TO_CHAR, :NEW.TipCol);
		l_NumCadStr := CONVERT(NUMBER_TO_CHAR, :NEW.NumCad);
		l_Where := 'NUMEMP = ' || l_NumEmpStr || ' AND TIPCOL = ' || l_TipColStr || ' AND NUMCAD = ' || l_NumCadStr;
		SP_PROXHIST_NPER('DATALT', 'R038HAT', l_Where, :NEW.DatAlt, l_DatAltProxHist OUT);
		
		l_DataInicio := :NEW.DatAlt;
		
		IF (l_DatAltProxHist > l_DataZero) THEN
  	    	l_DataTermino := DATETIMEADD(DD, -1, l_DatAltProxHist);
  	  	ELSE
  	    	l_DataTermino := l_DataZero;
  	    END IF;
  	  
		IF (l_DataTermino > l_DataInicioSST OR l_DataTermino = l_DataZero) THEN
  	    	IF (l_DataInicio < l_DataInicioSST) THEN
  	    		l_DataInicio := l_DataInicioSST;
  	   		END IF;
  	   		
  	   		SP_E_SOCIAL_SM('S-2240', 'R038HAT', 'N', 'I', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HAT_EI');
  	   	END IF;
	END IF;
END␀ˆÔ␀␀		SENIOR;0ö␀␀

TRIGGER R038HAT_EU AFTER UPDATE ON R038HAT FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataInicio DATE;
	l_DataTermino DATE;
	l_DataInicioSST DATE;
	l_NumEmpStr VARCHAR(11);
	l_TipColStr VARCHAR(11);
	l_NumCadStr VARCHAR(11);
	l_Where VARCHAR(2000);
	l_DatAltProxHist DATE;
	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_JsonCamposAlterados VARCHAR2(2000);
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	
    l_Alterou := FALSE;
    l_JsonCamposAlterados := '';

    SP_VALUPDATE_NUM(:OLD.LocAmb, :NEW.LocAmb, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
    	l_Alterou := TRUE;
    	SP_CONCAT_NUM_JSON('LOCAMB', :NEW.LocAmb, :OLD.LocAmb, l_JsonCamposAlterados OUT);
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.NumAmb, :NEW.NumAmb, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
    	l_Alterou := TRUE;
    	SP_CONCAT_NUM_JSON('NUMAMB', :NEW.NumAmb, :OLD.NumAmb, l_JsonCamposAlterados OUT);
    END IF;

	IF (l_Alterou = TRUE) THEN
		RH_RET_DATINISST(:NEW.NumEmp, l_DataInicioSST OUT);
		IF (l_DataInicioSST > l_DataZero) THEN
			l_NumEmpStr := CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp);
			l_TipColStr := CONVERT(NUMBER_TO_CHAR, :NEW.TipCol);
			l_NumCadStr := CONVERT(NUMBER_TO_CHAR, :NEW.NumCad);
			l_Where := 'NUMEMP = ' || l_NumEmpStr || ' AND TIPCOL = ' || l_TipColStr || ' AND NUMCAD = ' || l_NumCadStr;
			SP_PROXHIST_NPER('DATALT', 'R038HAT', l_Where, :OLD.DatAlt, l_DatAltProxHist OUT);
			
			l_DataInicio := :NEW.DatAlt;
			
			IF (l_DatAltProxHist > l_DataZero) THEN
	  	    	l_DataTermino := DATETIMEADD(DD, -1, l_DatAltProxHist);
	  	  	ELSE
	  	    	l_DataTermino := l_DataZero;
	  	    END IF;
	  	  
			IF (l_DataTermino > l_DataInicioSST OR l_DataTermino = l_DataZero) THEN
	  	    	IF (l_DataInicio < l_DataInicioSST) THEN
	  	    		l_DataInicio := l_DataInicioSST;
	  	   		END IF;
	  	   		
	  	   		SP_E_SOCIAL_SM('S-2240', 'R038HAT', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonCamposAlterados, 0, NULL, l_DataInicio, 0, 'R038HAT_EU');
	  	   	END IF;
		END IF;
	END IF;
END␀†Ô␀␀		SENIOR;0h␀␀

TRIGGER R038HAT_ED AFTER DELETE ON R038HAT FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataInicio DATE;
	l_DataTermino DATE;
	l_DataInicioSST DATE;
	l_NumEmpStr VARCHAR(11);
	l_TipColStr VARCHAR(11);
	l_NumCadStr VARCHAR(11);
	l_Where VARCHAR(2000);
	l_DatAltProxHist DATE;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	
	RH_RET_DATINISST(:OLD.NumEmp, l_DataInicioSST OUT);
	IF (l_DataInicioSST > l_DataZero) THEN
		l_NumEmpStr := CONVERT(NUMBER_TO_CHAR, :OLD.NumEmp);
		l_TipColStr := CONVERT(NUMBER_TO_CHAR, :OLD.TipCol);
		l_NumCadStr := CONVERT(NUMBER_TO_CHAR, :OLD.NumCad);
		l_Where := 'NUMEMP = ' || l_NumEmpStr || ' AND TIPCOL = ' || l_TipColStr || ' AND NUMCAD = ' || l_NumCadStr;
		SP_PROXHIST_NPER('DATALT', 'R038HAT', l_Where, :OLD.DatAlt, l_DatAltProxHist OUT);
		
		l_DataInicio := :OLD.DatAlt;
		
		IF (l_DatAltProxHist > l_DataZero) THEN
  	    	l_DataTermino := DATETIMEADD(DD, -1, l_DatAltProxHist);
  	  	ELSE
  	    	l_DataTermino := l_DataZero;
  	    END IF;
  	  
		IF (l_DataTermino > l_DataInicioSST OR l_DataTermino = l_DataZero) THEN
  	    	IF (l_DataInicio < l_DataInicioSST) THEN
  	    		l_DataInicio := l_DataInicioSST;
  	   		END IF;
  	   		
  	   		SP_E_SOCIAL_SM('S-2240', 'R038HAT', 'N', 'E', l_DataInicio, l_DataTermino, :OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HAT_ED');
  	   	END IF;
	END IF;
END␀␀␀Áv␀␀␀␀␀␀␀␀‰Ô␀␀…¬␀␀´␀	Ôÿ1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ1␀␀␀␀␀Ü␀t␀Ü␀nˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ1␀␀␀␀␀.%0.0.wı‡␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ôÿ1␀␀␀␀␀FIùEşEqCş‡␀êÿ␀␀ÿ␀f´␀Ôï1␀␀␀␀␀÷<ïe»fr␀Æÿ␀␀)Ñ␀␀␀0,4Ôï1␀␀␀␀␀Aµ'×«␀␀}␀ˆ␀␀ÿ␀␀Ñ␀␀␀-±␀Ôï1␀␀␀␀␀%£␀␀Î¢␀␀Ù¢␀␀qÿ‡␀Æÿ␀␀*Û␀␀␀*␀áÔï1␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀i'4Ôï1␀␀␀␀␀QBØ«␀␀Ø«␀␀}␀ˆ␀␀ÿ␀␀Ñ␀␀␀S,±␀Ôï1␀␀␀␀␀b<((q␀Æÿ␀␀Û␀␀␀q=Ôÿ1␀␀␀␀␀}q}q}qc␀␀␀ÿ␀␀ÿN␀␀ŠÔ␀␀␀‹Ô␀␀␀ŒÔ␀␀␀␀0;1;2;3’Ô␀␀	SENIOR;0_␀␀

/* Inclusão */
TRIGGER R038HCA_SI AFTER INSERT ON R038HCA

DECLARE
/* CURSOR c/ os registros gravados no R038HCA_AUX */
  CURSOR c_r038hca_ins IS
    SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, ESTCAR, CODCAR, CARVAG FROM R038HCA_AUX WHERE TIPOPE = 'I';

  TYPE t_r038HCA_aux IS RECORD(
    NUMEMP   R038HCA_AUX.NUMEMP%TYPE,
    TIPCOL   R038HCA_AUX.TIPCOL%TYPE,
    NUMCAD   R038HCA_AUX.NUMCAD%TYPE,
    DATALT   R038HCA_AUX.DATALT%TYPE,
    ESTCAR   R038HCA_AUX.ESTCAR%TYPE,
    CODCAR   R038HCA_AUX.CODCAR%TYPE,
    CARVAG   R038HCA_AUX.CARVAG%TYPE);

  l_r038HCA_aux t_r038HCA_aux;
  xIndCar   R000ASS.INDCAR%TYPE;
BEGIN
  QL_VERASS(xIndCar OUT);

  /* Le Registro do CURSOR */
  FOREACH c_r038hca_ins INTO  l_r038HCA_aux.NUMEMP,
                              l_r038HCA_aux.TIPCOL,
                              l_r038HCA_aux.NUMCAD,
                              l_r038HCA_aux.DATALT,
                              l_r038HCA_aux.ESTCAR,
                              l_r038HCA_aux.CODCAR,
                              l_r038HCA_aux.CARVAG
  LOOP
    IF (xIndCar <> 'S') THEN
      /* Atualiza o Quadro Efetivo - QL */
      QL_INCCARGO(l_r038HCA_aux.NumEmp, l_r038HCA_aux.TipCol, l_r038HCA_aux.NumCad, l_r038HCA_aux.DatAlt, l_r038HCA_aux.EstCar, l_r038HCA_aux.CodCar, l_r038HCA_aux.DatAlt, l_r038HCA_aux.EstCar, l_r038HCA_aux.CodCar);
    ELSE
      /* Atualiza o Quadro Efetivo - QL */
      QL_INCCARGO(l_r038HCA_aux.NumEmp, l_r038HCA_aux.TipCol, l_r038HCA_aux.NumCad, l_r038HCA_aux.DatAlt, l_r038HCA_aux.EstCar, l_r038HCA_aux.CarVag, l_r038HCA_aux.DatAlt, l_r038HCA_aux.EstCar, l_r038HCA_aux.CarVag);
    END IF;  
  END LOOP;

  /* Apaga Registro OLD em R038HCA_AUX */
  BEGIN
    DELETE FROM R038HCA_AUX;
    DROP_TEMP_TABLE R038HCA_AUX;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro na Exclusão do R038HCA_AUX';
  END;
END␀Ô␀␀		SENIOR;0û6␀␀

TRIGGER R038HCA_EI AFTER INSERT ON R038HCA FOR EACH ROW

DECLARE
l_datcar       DATE;
  l_datadm       DATE;
  l_comando_nulo BOOLEAN;

  l_TemPenFut    BOOLEAN;
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_AltEmp         R038PEN.ALTEMP%TYPE;
  l_AltFil         R038PEN.ALTFIL%TYPE;
  l_AltLoc         R038PEN.ALTLOC%TYPE;
  l_AltCcu         R038PEN.ALTCCU%TYPE;
  l_AltCar         R038PEN.ALTCAR%TYPE;
  l_AltEsc         R038PEN.ALTESC%TYPE;
  l_AltDes         R038PEN.ALTDES%TYPE;
  l_SitChe         R038PEN.SITCHE%TYPE;
  l_SitUsu         R038PEN.SITUSU%TYPE;
  l_NesRev         R038PEN.NESREV%TYPE;
  l_EmpAtu         R038PEN.EMPATU%TYPE;
  l_CadAtu         R038PEN.CADATU%TYPE;
  l_ColChe       BOOLEAN;
  l_ColUsu       BOOLEAN;
  l_auxSitChe      R038PEN.SITCHE%TYPE;
  l_auxSitUsu      R038PEN.SITUSU%TYPE;
  l_AssTrfCar      R000ASS.TRFCAR%TYPE;
  l_layoutAlteracaoContrato VARCHAR2(6);

  l_idtpes VARCHAR2(23);
  l_valstr VARCHAR2(53);
  l_estcar_str VARCHAR2(4);
  l_codcar_str VARCHAR2(24);
  
  /* VARIAVEIS DO LOG */
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  
  l_NumEmpStr VARCHAR(11);
  l_TipColStr VARCHAR(11);
  l_NumCadStr VARCHAR(11);
  l_Where VARCHAR(2000);
  l_DataZero DATE;
  l_DatIniSST DATE;
  l_IniHis DATE;
  l_FimHis DATE;
  l_DatAltProxHist DATE;

  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HCA_AUX;    

BEGIN
  BEGIN
    SELECT TRFCAR INTO l_AssTrfCar
      FROM R000ASS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_AssTrfCar := 0;
  END;

  IF (l_AssTrfCar = 2) THEN
    /* Verifica se o colaborador está associado ao cadastro de chefia ou
       se o colaborador está associado com algum usuário */
    R038PEN_COLCHEFE(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_ColChe OUT, l_ColUsu OUT);

    /* Busca data de admissão do colaborador */
    BEGIN
      SELECT R034FUN.DATADM INTO l_DatAdm
        FROM R034FUN
       WHERE R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_DatAdm := '31/12/1900,00:00:00';
    END;

    /* Se o colaborador é chefe ou está associado a um usuário, e a data admissão for diferente da data
       do histórico gera pendência */
    IF ((l_ColChe = TRUE OR l_ColUsu = TRUE) AND (:NEW.DATALT <> l_DatAdm)) THEN
      /* Verifica se existe pendência numa data futura */
      R038PEN_TEMPENFUT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_TemPenFut OUT);

      /* se não existe pendência com data futura, verifica se existe pendência com data passada e situação não atendida */
      IF (l_TemPenFut = FALSE) THEN
        BEGIN
             SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU
               INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu
               FROM R038PEN
              WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                    R038PEN.TIPCOL = :NEW.TIPCOL AND
                    R038PEN.NUMCAD = :NEW.NUMCAD AND
                    R038PEN.DATTRF < :NEW.DATALT AND
                    ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
                     (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));
        EXCEPTION
             WHEN NO_DATA_FOUND THEN
                  l_NumEmp := 0;
                  l_TipCol := 0;
                  l_NumCad := 0;
                  l_DatTrf := '31/12/1900,00:00:00';
        END;

        /* Considera que sempre altera Cargo na inclusão do histórico de Cargo para criação da pendência */
        l_AltCar := 'S';

        /* Verifica se deve gerar pendencia de chefia */
        IF (l_ColChe = TRUE) THEN
          l_SitChe := 1; /* Não Atendida */
        ELSE
          l_SitChe := 3; /* Sem necessidade de Alteração */
        END IF;

        /* Verifica se deve gerar pendencia de usuário */
        IF (l_ColUsu = TRUE) THEN
          l_SitUsu := 1; /* Não Atendida */
        ELSE
          l_SitUsu := 4; /* Sem necessidade de Alteração */
        END IF;

        /* Se existir uma pendência com data passada e situação 1 (Não atendida), esta
           será excluída e regerada com a nova data */
        IF (l_NumCad <> 0) THEN

          /* Insere nova pendência com base nos valores da pendência da data passada */
          BEGIN
            INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu);
          EXCEPTION
            WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
          END;

          /* Deleta pendência da data passada */
          R038PEN_DELPENPAS(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATALT);

        ELSE
          /* Verifica se existe pendência na mesma data de alteração */
          BEGIN
               SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, SITCHE, SITUSU INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_auxSitChe, l_auxSitUsu
                 FROM R038PEN
                WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                      R038PEN.TIPCOL = :NEW.TIPCOL AND
                      R038PEN.NUMCAD = :NEW.NUMCAD AND
                      R038PEN.DATTRF = :NEW.DATALT;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_NumEmp := 0;
                    l_TipCol := 0;
                    l_NumCad := 0;
                    l_DatTrf := '31/12/1900,00:00:00';
                    l_auxSitChe := 0;
                    l_auxSitUsu := 0;
          END;

          /* Se existir pendência na mesma data, atualiza a pendência */
          IF (l_NumCad <> 0) THEN

            IF ((l_auxSitChe = 1 OR l_auxSitChe = 3) AND
                (l_auxSitUsu = 1 OR l_auxSitUsu = 4)) THEN

              /* Atualiza pendência */
              BEGIN
                UPDATE R038PEN
                   SET ALTCAR = l_AltCar, SITCHE = l_SitChe, SITUSU = l_SitUsu
                 WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                       R038PEN.TIPCOL = :NEW.TIPCOL AND
                       R038PEN.NUMCAD = :NEW.NUMCAD AND
                       R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;

            ELSE
              /* Se a Situação for diferente de "Não atendida" ou "Sem necessidade de alteração", então
                 indica na pendência que necessita Revisão */
              BEGIN
                UPDATE R038PEN SET ALTCAR = l_AltCar, NESREV = 'S'
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            END IF;

          ELSE

            /* Insere nova pendência */
            BEGIN
              INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'N', 'N', 'N', 'N', l_AltCar, 'N', 'N', l_SitChe, l_SitUsu, 'N', 0, 0);
            EXCEPTION
              WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
            END;
          END IF;
        END IF;
      END IF;   
    END IF;
  END IF;


  SELECT R034FUN.DATCAR,R034FUN.DATADM INTO l_datcar,l_datadm
    FROM R034FUN
   WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
         R034FUN.NUMEMP = :NEW.NUMEMP AND
         R034FUN.NUMCAD = :NEW.NUMCAD;

  IF   (:NEW.STAHIS = 1)
  AND ((:NEW.DATALT >= l_datcar) OR (l_datcar IS NULL)) THEN
        IF (l_datadm IS NULL) THEN
           UPDATE R034FUN
              SET CODCAR = :NEW.CODCAR,
                  MOTCAR = :NEW.CODMOT,
                  ESTCAR = :NEW.ESTCAR,
                  DATCAR = :NEW.DATALT,
                  DATADM = :NEW.DATALT
            WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                  R034FUN.NUMEMP = :NEW.NUMEMP AND
                  R034FUN.NUMCAD = :NEW.NUMCAD;
        ELSE
           UPDATE R034FUN
              SET CODCAR = :NEW.CODCAR,
                  MOTCAR = :NEW.CODMOT,
                  ESTCAR = :NEW.ESTCAR,
                  DATCAR = :NEW.DATALT
            WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                  R034FUN.NUMEMP = :NEW.NUMEMP AND
                  R034FUN.NUMCAD = :NEW.NUMCAD;
        END IF;
  END IF;

  /* Insere registro na AUX para processar rotina do QL */
  BEGIN
    INSERT INTO R038HCA_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, ESTCAR, CODCAR, CARVAG, TIPOPE)
           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, :NEW.ESTCAR, :NEW.CODCAR, :NEW.CARVAG, 'I');
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro no INSERT em R038HCA_AUX.';
  END;

  /* Inclui as Solicitações de Exames Periódicos cadastrados para a Transferência de Cargo */
  RH_EXA_CARGO(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, :NEW.ESTCAR, :NEW.CODCAR);

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
  
  /* eSocial */
  RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);    
  IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
    SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038HCA', 'DATALT', 'I', '', '', 0, 'R038HCA_EI');
  END IF;  
  /* eSocial */
  
  /* eSocial - S-2240 - Início */
  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  
  RH_RET_DATINISST(:NEW.NumEmp, l_DatIniSST OUT);
  
  IF (l_DatIniSST > l_DataZero) THEN
  	l_NumEmpStr := CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp);
  	l_TipColStr := CONVERT(NUMBER_TO_CHAR, :NEW.TipCol);
  	l_NumCadStr := CONVERT(NUMBER_TO_CHAR, :NEW.NumCad);
  	l_Where := 'NUMEMP = ' || l_NumEmpStr || ' AND TIPCOL = ' || l_TipColStr || ' AND NUMCAD = ' || l_NumCadStr;
  	SP_PROXHIST_NPER('DATALT', 'R038HCA', l_Where, :NEW.DatAlt, l_DatAltProxHist OUT);
  
  	l_IniHis := :NEW.DatAlt;
  	
  	IF (l_DatAltProxHist > l_DataZero) THEN
  	  l_FimHis := DATETIMEADD(DD, -1, l_DatAltProxHist);
  	ELSE
  	  l_FimHis := l_DataZero;
  	END IF;
  	
  	IF (l_FimHis > l_DatIniSST OR l_FimHis = l_DataZero) THEN
  	  IF (l_IniHis < l_DatIniSST) THEN
  		l_IniHis := l_DatIniSST;
  	  END IF;
  
      SP_E_SOCIAL_SM('S-2240', 'R038HCA', 'N', 'I', l_IniHis, l_FimHis, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_IniHis, 0, 'R038HCA_EI');
    END IF;
  END IF;
  /* eSocial - S-2240 - Fim */
  
  /* Geração de logs Histórico Cargo*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 58;     /* Histórico Cargo*/
  l_codtpa := 227;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HCA_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HCA_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCAR', CONVERT(NUMBER_TO_CHAR, :NEW.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAR', :NEW.CODCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODMOT', CONVERT(NUMBER_TO_CHAR, :NEW.CODMOT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CARVAG', :NEW.CARVAG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCRR', CONVERT(NUMBER_TO_CHAR, :NEW.CODCRR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FUNESO', :NEW.FUNESO);
      END;
  END IF;
  
  /* Pendência SAMSenior */
  IF (:NEW.STAHIS = 1) THEN
    SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_INTSTR(:NEW.ESTCAR, '9999', l_estcar_str OUT);
    SP_ESPSTR(:NEW.CODCAR, 24, l_codcar_str OUT);
    l_valstr := '2H' || l_idtpes || l_estcar_str || l_codcar_str;
    SP_SAM_PENDENCIES(33, 1, l_valstr);
  END IF;

END␀“Ô␀␀	SENIOR;0␀␀

/* Trigger Update - Statement */
TRIGGER R038HCA_SU AFTER UPDATE ON R038HCA

DECLARE
/* CURSOR c/ os registros gravados no R038HCA_AUX */
  CURSOR c_r038hca_upd IS
    SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, ESTCAR, CODCAR, CARVAG, EMPOLD, TIPOLD, CADOLD, DATOLD, ESTOLD, CAROLD, CVGOLD, TIPOPE
      FROM R038HCA_AUX WHERE TIPOPE = 'U' AND (ESTCAR <> ESTOLD OR CODCAR <> CAROLD);

  CURSOR c_r038hca_vag IS
    SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, ESTCAR, CODCAR, CARVAG, EMPOLD, TIPOLD, CADOLD, DATOLD, ESTOLD, CAROLD, CVGOLD, TIPOPE
      FROM R038HCA_AUX WHERE TIPOPE = 'U' AND (ESTCAR <> ESTOLD OR CARVAG <> CVGOLD);

  TYPE t_r038HCA_aux IS RECORD(
    NUMEMP   R038HCA_AUX.NUMEMP%TYPE,
    TIPCOL   R038HCA_AUX.TIPCOL%TYPE,
    NUMCAD   R038HCA_AUX.NUMCAD%TYPE,
    DATALT   R038HCA_AUX.DATALT%TYPE,
    ESTCAR   R038HCA_AUX.ESTCAR%TYPE,
    CODCAR   R038HCA_AUX.CODCAR%TYPE,
    CARVAG   R038HCA_AUX.CARVAG%TYPE,
    EMPOLD   R038HCA_AUX.EMPOLD%TYPE,
    TIPOLD   R038HCA_AUX.TIPOLD%TYPE,
    CADOLD   R038HCA_AUX.CADOLD%TYPE,
    DATOLD   R038HCA_AUX.DATOLD%TYPE,
    ESTOLD   R038HCA_AUX.ESTOLD%TYPE,
    CAROLD   R038HCA_AUX.CAROLD%TYPE,
    CVGOLD   R038HCA_AUX.CVGOLD%TYPE,
    TIPOPE   R038HCA_AUX.TIPOPE%TYPE
    );

  xR038HCA_aux t_r038HCA_aux;
  xIndCar   R000ASS.INDCAR%TYPE;
BEGIN
  QL_VERASS(xIndCar OUT);

  IF (xIndCar <> 'S') THEN
    /* Le Registro do CURSOR */
    FOREACH c_r038hca_upd INTO  xR038HCA_aux.NUMEMP,
                                xR038HCA_aux.TIPCOL,
                                xR038HCA_aux.NUMCAD,
                                xR038HCA_aux.DATALT,
                                xR038HCA_aux.ESTCAR,
                                xR038HCA_aux.CODCAR,
                                xR038HCA_aux.CARVAG,
                                xR038HCA_aux.EMPOLD,
                                xR038HCA_aux.TIPOLD,
                                xR038HCA_aux.CADOLD,
                                xR038HCA_aux.DATOLD,
                                xR038HCA_aux.ESTOLD,
                                xR038HCA_aux.CAROLD,
                                xR038HCA_aux.CVGOLD,
                                xR038HCA_aux.TIPOPE
    LOOP
      /* Atualiza o Quadro Efetivo - QL */
      QL_EXCCARGO(xR038HCA_aux.EmpOld, xR038HCA_aux.TipOld, xR038HCA_aux.CadOld, xR038HCA_aux.DatOld, xR038HCA_aux.EstOld, xR038HCA_aux.CarOld, xR038HCA_aux.DatAlt, xR038HCA_aux.EstCar, xR038HCA_aux.CodCar);

      QL_INCCARGO(xR038HCA_aux.NumEmp, xR038HCA_aux.TipCol, xR038HCA_aux.NumCad, xR038HCA_aux.DatAlt, xR038HCA_aux.EstCar, xR038HCA_aux.CodCar, xR038HCA_aux.DatAlt, xR038HCA_aux.EstCar, xR038HCA_aux.CodCar);
    END LOOP;
  ELSE
    /* Le Registro do CURSOR */
    FOREACH c_r038hca_vag INTO  xR038HCA_aux.NUMEMP,
                                    xR038HCA_aux.TIPCOL,
                                    xR038HCA_aux.NUMCAD,
                                    xR038HCA_aux.DATALT,
                                    xR038HCA_aux.ESTCAR,
                                    xR038HCA_aux.CODCAR,
                                    xR038HCA_aux.CARVAG,
                                    xR038HCA_aux.EMPOLD,
                                    xR038HCA_aux.TIPOLD,
                                    xR038HCA_aux.CADOLD,
                                    xR038HCA_aux.DATOLD,
                                    xR038HCA_aux.ESTOLD,
                                    xR038HCA_aux.CAROLD,
                                    xR038HCA_aux.CVGOLD,
                                    xR038HCA_aux.TIPOPE
    LOOP
      /* Atualiza o Quadro Efetivo - QL */
      QL_EXCCARGO(xR038HCA_aux.EmpOld, xR038HCA_aux.TipOld, xR038HCA_aux.CadOld, xR038HCA_aux.DatOld, xR038HCA_aux.EstOld, xR038HCA_aux.CVgOld, xR038HCA_aux.DatAlt, xR038HCA_aux.EstCar, xR038HCA_aux.CarVag);

      QL_INCCARGO(xR038HCA_aux.NumEmp, xR038HCA_aux.TipCol, xR038HCA_aux.NumCad, xR038HCA_aux.DatAlt, xR038HCA_aux.EstCar, xR038HCA_aux.CarVag, xR038HCA_aux.DatAlt, xR038HCA_aux.EstCar, xR038HCA_aux.CarVag);
    END LOOP;
  END IF;

  /* Apaga registros da R038HCA_AUX */
  BEGIN
    DELETE FROM R038HCA_AUX;
    DROP_TEMP_TABLE R038HCA_AUX;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na exclusão dos registros da R038HCA_AUX';
  END;
END␀Ô␀␀		SENIOR;0TA␀␀

TRIGGER R038HCA_EU AFTER UPDATE ON R038HCA FOR EACH ROW

DECLARE
  l_datcar       DATE;
  l_datadm       DATE;
  l_OriExa       NUMBER(3);

  l_TemPenFut    BOOLEAN;
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_AltEmp         R038PEN.ALTEMP%TYPE;
  l_AltFil         R038PEN.ALTFIL%TYPE;
  l_AltLoc         R038PEN.ALTLOC%TYPE;
  l_AltCcu         R038PEN.ALTCCU%TYPE;
  l_AltCar         R038PEN.ALTCAR%TYPE;
  l_AltEsc         R038PEN.ALTESC%TYPE;
  l_AltDes         R038PEN.ALTDES%TYPE;
  l_SitChe         R038PEN.SITCHE%TYPE;
  l_SitUsu         R038PEN.SITUSU%TYPE;
  l_NesRev         R038PEN.NESREV%TYPE;
  l_EmpAtu         R038PEN.EMPATU%TYPE;
  l_CadAtu         R038PEN.CADATU%TYPE;
  l_ColChe       BOOLEAN;
  l_ColUsu       BOOLEAN;
  l_auxSitChe      R038PEN.SITCHE%TYPE;
  l_auxSitUsu      R038PEN.SITUSU%TYPE;
  l_AssTrfCar      R000ASS.TRFCAR%TYPE;
  l_Alterou BOOLEAN;
  l_AlterouCargo BOOLEAN;
  l_Valido  BOOLEAN;
  l_layoutAlteracaoContrato VARCHAR2(6);
  l_idtpes       VARCHAR2(23);
  l_valstr       VARCHAR2(53);
  l_estcar_str   VARCHAR2(4);
  l_codcar_str   VARCHAR2(24);

  l_NumEmpStr VARCHAR(11);
  l_TipColStr VARCHAR(11);
  l_NumCadStr VARCHAR(11);
  l_Where VARCHAR(2000);
  l_DataZero DATE;
  l_DatIniSST DATE;
  l_IniHis DATE;
  l_FimHis DATE;
  l_DatAltProxHist DATE;
  
  /* VARIÁVEIS DE CONTROLE DO LOG */
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_JsonCamposAlterados VARCHAR2(2000);
  l_JsonCamposAlterados2240 VARCHAR2(2000);

  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HCA_AUX;
  
BEGIN
  BEGIN
    SELECT TRFCAR INTO l_AssTrfCar
      FROM R000ASS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_AssTrfCar := 0;
  END;

  l_JsonCamposAlterados := '';
  l_JsonCamposAlterados2240 := '';

  IF (l_AssTrfCar = 2) THEN
    /* Verifica se o colaborador está associado ao cadastro de chefia ou
       se o colaborador está associado com algum usuário */
    R038PEN_COLCHEFE(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_ColChe OUT, l_ColUsu OUT);

    /* Se o colaborador é chefe ou está associado a um usuário gera pendência */
    IF (l_ColChe = TRUE OR l_ColUsu = TRUE) THEN
      /* Verifica se existe pendência numa data futura */
      R038PEN_TEMPENFUT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_TemPenFut OUT);

      /* se não existe pendência com data futura, verifica se existe pendência com data passada e situação não atendida */
      IF (l_TemPenFut = FALSE) THEN
        BEGIN
             SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU
               INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu
               FROM R038PEN
              WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                    R038PEN.TIPCOL = :NEW.TIPCOL AND
                    R038PEN.NUMCAD = :NEW.NUMCAD AND
                    R038PEN.DATTRF < :NEW.DATALT AND
                    ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
                     (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));
        EXCEPTION
             WHEN NO_DATA_FOUND THEN
                  l_NumEmp := 0;
                  l_TipCol := 0;
                  l_NumCad := 0;
                  l_DatTrf := '31/12/1900,00:00:00';
        END;

        /* Considera que sempre altera Cargo na inclusão do histórico de Cargo para criação da pendência */
        l_AltCar := 'S';

        /* Verifica se deve gerar pendencia de chefia */
        IF (l_ColChe = TRUE) THEN
          l_SitChe := 1; /* Não Atendida */
        ELSE
          l_SitChe := 3; /* Sem necessidade de Alteração */
        END IF;

        /* Verifica se deve gerar pendencia de usuário */
        IF (l_ColUsu = TRUE) THEN
          l_SitUsu := 1; /* Não Atendida */
        ELSE
          l_SitUsu := 4; /* Sem necessidade de Alteração */
        END IF;

        /* Se existir uma pendência com data passada e situação 1 (Não atendida), esta
           será excluída e regerada com a nova data */
        IF (l_NumCad <> 0) THEN
          /* Insere nova pendência com base nos valores da pendência da data passada */
          BEGIN
            INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu);
          EXCEPTION
            WHEN OTHERS THEN
               RAISERROR 103 'Erro ao inserir registro na R038PEN.';
          END;

          /* Deleta pendência da data passada */
          R038PEN_DELPENPAS(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATALT);

        ELSE
          /* Verifica se existe pendência na mesma data de alteração */
          BEGIN
               SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, SITCHE, SITUSU INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_auxSitChe, l_auxSitUsu
                 FROM R038PEN
                WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                      R038PEN.TIPCOL = :NEW.TIPCOL AND
                      R038PEN.NUMCAD = :NEW.NUMCAD AND
                      R038PEN.DATTRF = :NEW.DATALT;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_NumEmp := 0;
                    l_TipCol := 0;
                    l_NumCad := 0;
                    l_DatTrf := '31/12/1900,00:00:00';
                    l_auxSitChe := 0;
                    l_auxSitUsu := 0;
          END;

          /* Se existir pendência na mesma data, atualiza a pendência */
          IF (l_NumCad <> 0) THEN

            IF ((l_auxSitChe = 1 OR l_auxSitChe = 3) AND
                (l_auxSitUsu = 1 OR l_auxSitUsu = 4)) THEN
              /* Atualiza pendência */
              BEGIN
                UPDATE R038PEN SET ALTCAR = l_AltCar, SITCHE = l_SitChe, SITUSU = l_SitUsu
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            ELSE
              /* Se a Situação for diferente de "Não atendida" ou "Sem necessidade de alteração", então
                 indica na pendência que necessita Revisão */
              BEGIN
                UPDATE R038PEN SET ALTCAR = l_AltCar, NESREV = 'S'
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            END IF;

          ELSE

            /* Insere nova pendência */
            BEGIN
              INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'N', 'N', 'N', 'N', l_AltCar, 'N', 'N', l_SitChe, l_SitUsu, 'N', 0, 0);
            EXCEPTION
              WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
            END;

          END IF;
        END IF;
      END IF;

    END IF;
  END IF;

  SELECT R034FUN.DATCAR,R034FUN.DATADM INTO l_datcar,l_datadm
    FROM R034FUN
   WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
         R034FUN.NUMEMP = :NEW.NUMEMP AND
         R034FUN.NUMCAD = :NEW.NUMCAD;

  IF   (:NEW.STAHIS = 1)
  AND ((:NEW.DATALT >= l_datcar) OR (l_datcar IS NULL)) THEN
         IF (l_datadm IS NULL) THEN
            UPDATE R034FUN
               SET CODCAR = :NEW.CODCAR,
                   MOTCAR = :NEW.CODMOT,
                   ESTCAR = :NEW.ESTCAR,
                   DATCAR = :NEW.DATALT,
                   DATADM = :NEW.DATALT
             WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                   R034FUN.NUMEMP = :NEW.NUMEMP AND
                   R034FUN.NUMCAD = :NEW.NUMCAD;
         ELSE
            UPDATE R034FUN
               SET CODCAR = :NEW.CODCAR,
                   MOTCAR = :NEW.CODMOT,
                   ESTCAR = :NEW.ESTCAR,
                   DATCAR = :NEW.DATALT
             WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                   R034FUN.NUMEMP = :NEW.NUMEMP AND
                   R034FUN.NUMCAD = :NEW.NUMCAD;
         END IF;
  END IF;

  /* Insere registro na AUX para processar rotina do QL */
  BEGIN
    INSERT INTO R038HCA_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, ESTCAR, CODCAR, CARVAG, EMPOLD, TIPOLD, CADOLD, DATOLD, ESTOLD, CAROLD, CVGOLD, TIPOPE)
           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, :NEW.ESTCAR, :NEW.CODCAR, :NEW.CARVAG, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, :OLD.ESTCAR, :OLD.CODCAR, :OLD.CARVAG, 'U');
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro no INSERT do Registro NEW na R038HCA_AUX.';
  END;

  /* Busca a Origem do Exame com o Tipo especificado */
  l_OriExa := 0;
  RH_RETORIEXA(9, l_OriExa OUT);

  IF   (l_OriExa > 0) THEN
       /* Inclui as Solicitações de Exames Periódicos cadastrados para a Transferência de Cargo e
          Exclui as Solicitações cadastradas anteriormente */
       RH_EXC_SOLIC('C', :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, l_OriExa);
       RH_EXA_CARGO(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, :NEW.ESTCAR, :NEW.CODCAR);
  END IF;

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
  
  /* eSocial */
  SP_VALUPDATE_NUM(:OLD.ESTCAR, :NEW.ESTCAR, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouCargo := TRUE;
    SP_CONCAT_NUM_JSON('ESTCAR', :NEW.ESTCAR, :OLD.ESTCAR, l_JsonCamposAlterados OUT);
    SP_CONCAT_NUM_JSON('ESTCAR', :NEW.ESTCAR, :OLD.ESTCAR, l_JsonCamposAlterados2240 OUT);
  END IF;
  
  SP_VALUPDATE_DES(:OLD.CODCAR, :NEW.CODCAR, l_Valido OUT);  
  IF (l_Valido = TRUE) THEN
    l_AlterouCargo := TRUE;
    SP_CONCAT_DES_JSON('CODCAR', :NEW.CODCAR, :OLD.CODCAR, l_JsonCamposAlterados OUT);
    SP_CONCAT_DES_JSON('CODCAR', :NEW.CODCAR, :OLD.CODCAR, l_JsonCamposAlterados2240 OUT);
  END IF;  

  SP_VALUPDATE_DES(:OLD.FUNESO, :NEW.FUNESO, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_DES_JSON('FUNESO', :NEW.FUNESO, :OLD.FUNESO, l_JsonCamposAlterados OUT);    
  END IF;
  
  IF ((l_AlterouCargo = TRUE) OR (l_Alterou = TRUE)) THEN
    RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);    
    IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
      SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038HCA', 'DATALT', 'A', '', l_JsonCamposAlterados, 0, 'R038HCA_EU');
    END IF;	  
  END IF;
  /* eSocial */
  
  /* eSocial - S-2240 - Início */
  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  
  RH_RET_DATINISST(:NEW.NumEmp, l_DatIniSST OUT);
  
  IF (l_DatIniSST > l_DataZero) THEN
    IF (l_AlterouCargo = TRUE) THEN
      l_NumEmpStr := CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp);
      l_TipColStr := CONVERT(NUMBER_TO_CHAR, :NEW.TipCol);
      l_NumCadStr := CONVERT(NUMBER_TO_CHAR, :NEW.NumCad);
      l_Where := 'NUMEMP = ' || l_NumEmpStr || ' AND TIPCOL = ' || l_TipColStr || ' AND NUMCAD = ' || l_NumCadStr;
      SP_PROXHIST_NPER('DATALT', 'R038HCA', l_Where, :NEW.DatAlt, l_DatAltProxHist OUT);
	  
	  l_IniHis := :NEW.DatAlt;
	  
	  IF (l_DatAltProxHist > l_DataZero) THEN
	    l_FimHis := DATETIMEADD(DD, -1, l_DatAltProxHist);
	  ELSE
	    l_FimHis := l_DataZero;
	  END IF;
	  
  	  IF (l_FimHis > l_DatIniSST OR l_FimHis = l_DataZero) THEN
  	    IF (l_IniHis < l_DatIniSST) THEN
  		  l_IniHis := l_DatIniSST;
  	    END IF;
	
	    SP_E_SOCIAL_SM('S-2240', 'R038HCA', 'N', 'A', l_IniHis, l_FimHis, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonCamposAlterados2240, 0, NULL, l_IniHis, 0, 'R038HCA_EU');
	  END IF;
	END IF;
  END IF;
  /* eSocial - S-2240 - Fim */
  
  /* Geração de logs Histórico Cargo*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 58;     /* Histórico Cargo*/
  l_codtpa := 228;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.EstCar <> :NEW.EstCar)
   OR (:OLD.CodCar <> :NEW.CodCar)
   OR (:OLD.CodMot <> :NEW.CodMot)
   OR (:OLD.StaHis <> :NEW.StaHis)
   OR (:OLD.CarVag <> :NEW.CarVag)
   OR (:OLD.CodCrr <> :NEW.CodCrr)
   OR (:OLD.FunEso <> :NEW.FunEso)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HCA_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HCA_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDESTCAR', CONVERT(NUMBER_TO_CHAR, :OLD.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWESTCAR', CONVERT(NUMBER_TO_CHAR, :NEW.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCAR', :OLD.CODCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCAR', :NEW.CODCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODMOT', CONVERT(NUMBER_TO_CHAR, :OLD.CODMOT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODMOT', CONVERT(NUMBER_TO_CHAR, :NEW.CODMOT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSTAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSTAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCARVAG', :OLD.CARVAG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCARVAG', :NEW.CARVAG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCRR', CONVERT(NUMBER_TO_CHAR, :OLD.CODCRR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCRR', CONVERT(NUMBER_TO_CHAR, :NEW.CODCRR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFUNESO', :OLD.FUNESO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFUNESO', :NEW.FUNESO);
      END;
    END IF; 
  END IF;
  
  /* Pendência SAMSenior */
  IF (:NEW.STAHIS = 1) AND ((:OLD.STAHIS = 0) OR (:NEW.ESTCAR <> :OLD.ESTCAR) OR (:NEW.CODCAR <> :OLD.CODCAR)) THEN
    SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_INTSTR(:NEW.ESTCAR, '9999', l_estcar_str OUT);
    SP_ESPSTR(:NEW.CODCAR, 24, l_codcar_str OUT);
    l_valstr := '2H' || l_idtpes || l_estcar_str || l_codcar_str;
    SP_SAM_PENDENCIES(33, 1, l_valstr);
  END IF;
END␀‘Ô␀␀	SENIOR;0%␀␀/* Exclusao */
TRIGGER R038HCA_SD AFTER DELETE ON R038HCA

DECLARE
l_codcar       VARCHAR2(24);
  l_codmot       NUMBER(3);
  l_estcar       NUMBER(4);
  l_datalt       DATE;
  l_comando_nulo BOOLEAN;
  xDatTmp DATE;
  xIndCar   R000ASS.INDCAR%TYPE;

  l_idtpes VARCHAR2(23);
  l_valstr VARCHAR2(53);
  l_estcar_str VARCHAR2(4);
  l_codcar_str VARCHAR2(24);

  /* CURSOR c/ os registros gravados no R038HCA_AUX */
  CURSOR c_r038hca_del IS
    SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, ESTCAR, CODCAR, CARVAG, STAHIS FROM R038HCA_AUX WHERE TIPOPE = 'E';

  TYPE t_r038HCA_aux IS RECORD(
    NUMEMP   R038HCA_AUX.NUMEMP%TYPE,
    TIPCOL   R038HCA_AUX.TIPCOL%TYPE,
    NUMCAD   R038HCA_AUX.NUMCAD%TYPE,
    DATALT   R038HCA_AUX.DATALT%TYPE,
    ESTCAR   R038HCA_AUX.ESTCAR%TYPE,
    CODCAR   R038HCA_AUX.CODCAR%TYPE,
    CARVAG   R038HCA_AUX.CARVAG%TYPE,
    STAHIS   R038HCA_AUX.STAHIS%TYPE);

  l_r038HCA_aux t_r038HCA_aux;
BEGIN
  l_comando_nulo:=FALSE;

  xDatTmp := '31/12/1900,00:00:00';

  QL_VERASS(xIndCar OUT);

  /* Le Registro do CURSOR */
  FOREACH c_r038hca_del INTO l_r038HCA_aux.NUMEMP,
                             l_r038HCA_aux.TIPCOL,
                             l_r038HCA_aux.NUMCAD,
                             l_r038HCA_aux.DATALT,
                             l_r038HCA_aux.ESTCAR,
                             l_r038HCA_aux.CODCAR,
                             l_r038HCA_aux.CARVAG,
                             l_r038HCA_aux.STAHIS
  LOOP
    /* Verirfica se o histórico de Cargo era o que estava atualmente registrado nos Campos da R034FUN.
       Se for, atualiza a R034FUN com o mais atual histórico de Cargo */
    IF l_r038HCA_aux.STAHIS = 1 THEN
      SELECT R034FUN.DATCAR, R034FUN.CODCAR INTO l_datalt, l_codcar
        FROM R034FUN
       WHERE R034FUN.TIPCOL = l_r038HCA_aux.TIPCOL AND
             R034FUN.NUMEMP = l_r038HCA_aux.NUMEMP AND
             R034FUN.NUMCAD = l_r038HCA_aux.NUMCAD;

      IF  ((l_r038HCA_aux.DATALT = l_datalt) OR (l_r038HCA_aux.CODCAR = l_codcar)) THEN
        /* Pega o historico anterior */
        BEGIN
          SELECT A.CODCAR,A.CODMOT,A.ESTCAR,A.DATALT INTO l_codcar,l_codmot,l_estcar,l_datalt
          FROM R038HCA A
          WHERE A.NUMEMP = l_r038hca_aux.NUMEMP
          AND   A.TIPCOL = l_r038hca_aux.TIPCOL
          AND   A.NUMCAD = l_r038hca_aux.NUMCAD
          AND   A.STAHIS = 1
          AND DATALT IN (SELECT MAX(DATALT) FROM R038HCA
                         WHERE NUMEMP = l_r038hca_aux.NUMEMP
                         AND   TIPCOL = l_r038hca_aux.TIPCOL
                         AND   NUMCAD = l_r038hca_aux.NUMCAD
                         AND   STAHIS = 1);
        EXCEPTION
          WHEN TOO_MANY_ROWS THEN
            RAISERROR 103 'Erro em R038HCA - TOO MANY ROWS';
          WHEN NO_DATA_FOUND THEN
            l_codcar:='';
            l_codmot:=0;
            l_estcar:=0;
            l_datalt:='31/12/1900,00:00:00';
          WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT R038HCA';
        END;
       /* Atualiza tabela de colaboradores */

        BEGIN
          UPDATE R034FUN
             SET CODCAR = l_codcar,
                 MOTCAR = l_codmot,
                 ESTCAR = l_estcar,
                 DATCAR = l_datalt
           WHERE R034FUN.TIPCOL = l_r038hca_aux.TIPCOL AND
                 R034FUN.NUMEMP = l_r038hca_aux.NUMEMP AND
                 R034FUN.NUMCAD = l_r038hca_aux.NUMCAD;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
           l_comando_nulo:=TRUE;
          WHEN OTHERS THEN
           RAISERROR 103 'Erro Na Atualização do R034FUN';
        END;

        /* Pendência SAMSenior */
        IF (l_estcar > 0) THEN
          SP_RETIDTPES(l_r038hca_aux.NUMEMP, l_r038hca_aux.TIPCOL, l_r038hca_aux.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
          SP_INTSTR(l_estcar, '9999', l_estcar_str OUT);
          SP_ESPSTR(l_codcar, 24, l_codcar_str OUT);
          l_valstr := '2H' || l_idtpes || l_estcar_str || l_codcar_str;
          SP_SAM_PENDENCIES(33, 1, l_valstr);
        END IF;
      END IF;
    END IF;

    IF (xIndCar <> 'S') THEN
      /* Atualiza o Quadro Efetivo - QL */
      QL_EXCCARGO(l_r038HCA_aux.NumEmp, l_r038HCA_aux.TipCol, l_r038HCA_aux.NumCad, l_r038HCA_aux.DatAlt, l_r038HCA_aux.EstCar, l_r038HCA_aux.CodCar, l_r038HCA_aux.DatAlt, 0, ' ');
    ELSE
      /* Atualiza o Quadro Efetivo - QL */
      QL_EXCCARGO(l_r038HCA_aux.NumEmp, l_r038HCA_aux.TipCol, l_r038HCA_aux.NumCad, l_r038HCA_aux.DatAlt, l_r038HCA_aux.EstCar, l_r038HCA_aux.CarVag, l_r038HCA_aux.DatAlt, 0, ' ');
    END IF;  
  END LOOP;

  /* Apaga Registro OLD em R038HCA_AUX */
  BEGIN
    DELETE FROM R038HCA_AUX;
    DROP_TEMP_TABLE R038HCA_AUX;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro Na Exclusão do R038HCA_AUX';
  END;
END␀Ô␀␀		SENIOR;01␀␀

TRIGGER R038HCA_ED AFTER DELETE ON R038HCA FOR EACH ROW
DECLARE
  l_OriExa       NUMBER(3);
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_layoutAlteracaoContrato  VARCHAR2(6);
  l_idtpes   VARCHAR2(23);
  l_valstr VARCHAR2(53);
  l_estcar_str VARCHAR2(4);
  l_codcar_str VARCHAR2(24);

  l_NumEmpStr VARCHAR(11);
  l_TipColStr VARCHAR(11);
  l_NumCadStr VARCHAR(11);
  l_Where VARCHAR(2000);
  l_DataZero DATE;
  l_DatIniSST DATE;
  l_IniHis DATE;
  l_FimHis DATE;
  l_DatAltProxHist DATE;
  
  /* VARIÁVEIS DO LOG */
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HCA_AUX;
  
BEGIN
  /* Verifica se existe pendência gerada exclusivamente pelo histórico de Cargo para o
     cadastro de origem que está sendo excluído */
  BEGIN
       SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf
         FROM R038PEN
        WHERE R038PEN.NUMEMP = :OLD.NUMEMP AND
              R038PEN.TIPCOL = :OLD.TIPCOL AND
              R038PEN.NUMCAD = :OLD.NUMCAD AND
              R038PEN.DATTRF = :OLD.DATALT AND
              R038PEN.ALTEMP = 'N' AND
              R038PEN.ALTFIL = 'N' AND
              R038PEN.ALTLOC = 'N' AND
              R038PEN.ALTCCU = 'N' AND
              R038PEN.ALTCAR = 'S' AND
              R038PEN.ALTESC = 'N' AND
              R038PEN.ALTDES = 'N';
  EXCEPTION
       WHEN NO_DATA_FOUND THEN
            l_NumEmp := 0;
            l_TipCol := 0;
            l_NumCad := 0;
            l_DatTrf := '31/12/1900,00:00:00';
  END;

  /* Se existe pendência exclusiva do histórico de Cargo para o cadastro de origem
     verifica se já foi atendida para então excluir */
  IF (l_NumCad <> 0) THEN
    R038PEN_DELPEN(l_NumEmp, l_TipCol, l_NumCad, l_DatTrf);
  ELSE
    /* Atualiza pendência do Cargo com 'N' */
    BEGIN
      UPDATE R038PEN SET ALTCAR = 'N'
               WHERE R038PEN.NUMEMP = :OLD.NUMEMP AND
                     R038PEN.TIPCOL = :OLD.TIPCOL AND
                     R038PEN.NUMCAD = :OLD.NUMCAD AND
                     R038PEN.DATTRF = :OLD.DATALT;
    EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no update da Tabela R038PEN.';
    END;
  END IF;

  BEGIN
    INSERT INTO R038HCA_AUX (TIPOPE, NUMEMP, TIPCOL, NUMCAD, DATALT, ESTCAR, CODCAR, CARVAG, CODMOT, STAHIS)
                     VALUES ('E', :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, :OLD.ESTCAR, :OLD.CODCAR, :OLD.CARVAG, :OLD.CODMOT, :OLD.STAHIS);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R038HCA_AUX.';
  END;

  /* Busca a Origem do Exame com o Tipo especificado */
  l_OriExa := 0;
  RH_RETORIEXA(9, l_OriExa OUT);

  IF   (l_OriExa > 0) THEN
       /* Exclui as Solicitações cadastradas anteriormente */
       RH_EXC_SOLIC('C', :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, l_OriExa);
  END IF;

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD);

  /* eSocial - Início */
  RH_LAY_CONTR_COLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layoutAlteracaoContrato OUT);    
  IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
	SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, 'R038HCA', 'DATALT', 'E', '', '', 0, 'R038HCA_ED');
  END IF;
  /* eSocial - Fim */
  
  /* eSocial - S-2240 - Início */
  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  
  RH_RET_DATINISST(:OLD.NumEmp, l_DatIniSST OUT);
  
  IF (l_DatIniSST > l_DataZero) THEN
    l_NumEmpStr := CONVERT(NUMBER_TO_CHAR, :OLD.NumEmp);
  	l_TipColStr := CONVERT(NUMBER_TO_CHAR, :OLD.TipCol);
  	l_NumCadStr := CONVERT(NUMBER_TO_CHAR, :OLD.NumCad);
  	l_Where := 'NUMEMP = ' || l_NumEmpStr || ' AND TIPCOL = ' || l_TipColStr || ' AND NUMCAD = ' || l_NumCadStr;
  	SP_PROXHIST_NPER('DATALT', 'R038HCA', l_Where, :OLD.DatAlt, l_DatAltProxHist OUT);
  	
  	l_IniHis := :OLD.DatAlt;
  	
  	IF (l_DatAltProxHist > l_DataZero) THEN
  	  l_FimHis := DATETIMEADD(DD, -1, l_DatAltProxHist);
  	ELSE
  	  l_FimHis := l_DataZero;
  	END IF;
  	
  	IF (l_FimHis > l_DatIniSST OR l_FimHis = l_DataZero) THEN
  	  IF (l_IniHis < l_DatIniSST) THEN
  		l_IniHis := l_DatIniSST;
  	  END IF;
  
  	  SP_E_SOCIAL_SM('S-2240', 'R038HCA', 'N', 'E', l_IniHis, l_FimHis, :OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, '', '', 0, NULL, l_IniHis, 0, 'R038HCA_ED');
  	END IF;
  END IF;
  /* eSocial - S-2240 - Fim */
	
  /* Geração de logs Histórico Cargo*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 58;     /* Histórico Cargo*/
  l_codtpa := 227;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);    

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HCA_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HCA_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCAR', CONVERT(NUMBER_TO_CHAR, :OLD.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAR', :OLD.CODCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODMOT', CONVERT(NUMBER_TO_CHAR, :OLD.CODMOT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CARVAG', :OLD.CARVAG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCRR', CONVERT(NUMBER_TO_CHAR, :OLD.CODCRR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FUNESO', :OLD.FUNESO);
      END;
  END IF;
  
  /* Pendência SAMSenior */
  IF (:OLD.STAHIS = 1) THEN
    SP_RETIDTPES(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_INTSTR(:OLD.ESTCAR, '9999', l_estcar_str OUT);
    SP_ESPSTR(:OLD.CODCAR, 24, l_codcar_str OUT);
    l_valstr := '2H' || l_idtpes || l_estcar_str || l_codcar_str;
    SP_SAM_PENDENCIES(33, 3, l_valstr);
  END IF;

END␀␀␀yv␀␀␀␀␀␀␀␀␀␀␀Ô␀␀…¬␀␀´␀Ôï1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀tÔï1␀␀␀␀␀Ü␀t␀Ü␀nˆ␀Æÿ␀␀ÿ␀c¬␀␀Ì␀Ôï1␀␀␀␀␀.%0.0.wı‡␀Æÿ␀␀ÿ␀mDÑ␀Ôï1␀␀␀␀␀FIùEşEqCş‡␀êÿ␀␀ÿ␀f´␀Ôï1␀␀␀␀␀÷<ïe»fr␀Æÿ␀␀)Ñ␀␀␀0,4Ôï1␀␀␀␀␀A×«␀␀×«␀␀}␀ˆ␀␀ÿ␀␀ÿ␀i'4Ôï1␀␀␀␀␀QBØ«␀␀Ø«␀␀}␀ˆ␀␀ÿ␀␀ÿ␀-±␀Ôï1␀␀␀␀␀%£␀␀Î¢␀␀Ù¢␀␀qÿ‡␀Æÿ␀␀ÿ␀à␀␀Ôï1␀␀␀␀␀!␀ ␀ ␀+␀␀ÿ␀␀ÿ␀*␀áÔï1␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀␀b´␀Ôï1␀␀␀␀␀‘<-c-cr␀Æÿ␀␀ÿ␀Û␀tÔï1␀␀␀␀␀Ü␀t␀ö␀nˆ␀Æÿ␀␀ÿ␀Z$Ì␀Ôï1␀␀␀␀␀.%†.†.wı‡␀Æÿ␀␀ÿ␀MEÑ␀Ôï1␀␀␀␀␀FIüEFqCş‡␀êÿ␀␀ÿ␀%f´␀Ôï1␀␀␀␀␀÷<ïe½fr␀Æÿ␀␀ÿ␀`'4Ôï1␀␀␀␀␀Aµ'å'}␀ˆ␀␀ÿ␀␀ÿ␀$4Ôï1␀␀␀␀␀QBÎ'Î'}␀ˆ␀␀ÿ␀␀ÿ␀␀␀␀␀␀	␀zv␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀”Ô␀␀…¬␀␀´␀	Ôï1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôï1␀␀␀␀␀Ü␀t␀Ü␀nˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôï1␀␀␀␀␀.%0.0.wˆ␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ôï1␀␀␀␀␀EIşEşEqCˆ␀êÿ␀␀ÿ␀:,Ôï1␀␀␀␀␀AÓ«␀␀Ù«␀␀b␀ˆ␀␀ÿ␀␀)`␀*␀áÔï1␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀ƒ1Á␀Ôï1␀␀␀␀␀555)␀␀Æÿ␀␀ÿ␀␀␀•Ô␀␀␀–Ô␀␀␀␀␀0;1;2;3Ô␀␀	SENIOR;0İ␀␀

/* Inclusão */
TRIGGER R038HCC_SI AFTER INSERT ON R038HCC

DECLARE
/* CURSOR c/ os registros gravados no R038HCC_AUX */
  CURSOR c_r038hcc_ins IS
    SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, CODCCU FROM R038HCC_AUX;

  TYPE t_r038HCC_aux IS RECORD(
    NUMEMP   R038HCC_AUX.NUMEMP%TYPE,
    TIPCOL   R038HCC_AUX.TIPCOL%TYPE,
    NUMCAD   R038HCC_AUX.NUMCAD%TYPE,
    DATALT   R038HCC_AUX.DATALT%TYPE,
    CODCCU   R038HCC_AUX.CODCCU%TYPE);
    
  l_r038HCC_aux t_r038HCC_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r038hcc_ins INTO  l_r038HCC_aux.NUMEMP,
                              l_r038HCC_aux.TIPCOL,
                              l_r038HCC_aux.NUMCAD,
                              l_r038HCC_aux.DATALT,
                              l_r038HCC_aux.CODCCU
  LOOP
    /* Atualiza o Quadro Efetivo - QL */
    QL_INCCCUSTO(l_r038HCC_aux.NumEmp, l_r038HCC_aux.TipCol, l_r038HCC_aux.NumCad, l_r038HCC_aux.DatAlt, l_r038HCC_aux.CodCcu, l_r038HCC_aux.DatAlt, l_r038HCC_aux.CodCcu);
  END LOOP;

  /* Apaga Registro OLD em R038HCC_AUX */
  BEGIN
    DELETE FROM R038HCC_AUX;
    DROP_TEMP_TABLE R038HCC_AUX;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro na Exclusão do R038HCC_AUX';
  END;
END␀™Ô␀␀		SENIOR;0,2␀␀

/* Inclusao */
TRIGGER R038HCC_EI AFTER INSERT ON R038HCC FOR EACH ROW

DECLARE
  l_DatAdm         R034FUN.DATADM%TYPE;

  l_TemPenFut    BOOLEAN;
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_AltEmp         R038PEN.ALTEMP%TYPE;
  l_AltFil         R038PEN.ALTFIL%TYPE;
  l_AltLoc         R038PEN.ALTLOC%TYPE;
  l_AltCcu         R038PEN.ALTCCU%TYPE;
  l_AltCar         R038PEN.ALTCAR%TYPE;
  l_AltEsc         R038PEN.ALTESC%TYPE;
  l_AltDes         R038PEN.ALTDES%TYPE;
  l_SitChe         R038PEN.SITCHE%TYPE;
  l_SitUsu         R038PEN.SITUSU%TYPE;
  l_NesRev         R038PEN.NESREV%TYPE;
  l_EmpAtu         R038PEN.EMPATU%TYPE;
  l_CadAtu         R038PEN.CADATU%TYPE;
  l_ColChe       BOOLEAN;
  l_ColUsu       BOOLEAN;
  l_auxSitChe      R038PEN.SITCHE%TYPE;
  l_auxSitUsu      R038PEN.SITUSU%TYPE;
  l_AssTrfCcu      R000ASS.TRFCCU%TYPE;  
  
  /* VARIAVEIS DO LOG */
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  
  /* eSocial */
  l_layoutAlteracaoContrato VARCHAR2(6);
  l_UsaRat         R030EMP.UsaRat%TYPE;
  l_RotTom         R030EMP.RotTom%TYPE;
  l_IniTom         R030EMP.IniTom%TYPE;
  l_CodFil         R030FIL.CodFil%TYPE;
  l_TipFil         R030FIL.TipFil%TYPE;
  l_CdrFgt         R030FFG.CdrFgt%TYPE;
  l_DatTab         R030DES.DatTab%TYPE;
  l_DatUes         R030DES.DatUes%TYPE;
  l_IniNpe         R030DES.IniNpe%TYPE;
  l_IniPer         R030DES.IniPer%TYPE;
  l_IniSST         R030DES.IniSST%TYPE;
  l_IniMig         R030DES.DatMig%TYPE;

  /* SAMSenior */
  l_idtpes       VARCHAR2(23);
  l_numemp_str   VARCHAR2(4);
  l_codccu_str   VARCHAR2(18);
  l_valstr       VARCHAR2(46);
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HCC_AUX;
  
BEGIN
  BEGIN
    SELECT TRFCCU INTO l_AssTrfCcu
      FROM R000ASS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_AssTrfCcu := 0;
  END;

  IF (l_AssTrfCcu = 2) THEN
    /* Verifica se o colaborador está associado ao cadastro de chefia ou
       se o colaborador está associado com algum usuário */
    R038PEN_COLCHEFE(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_ColChe OUT, l_ColUsu OUT);

    /* Busca data de admissão do colaborador */
    BEGIN
      SELECT R034FUN.DATADM INTO l_DatAdm
        FROM R034FUN
       WHERE R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_DatAdm := '31/12/1900,00:00:00';
    END;

    /* Se o colaborador é chefe ou está associado a um usuário, e a data admissão for diferente da data
       do histórico gera pendência */
    IF ((l_ColChe = TRUE OR l_ColUsu = TRUE) AND (:NEW.DATALT <> l_DatAdm)) THEN
      /* Verifica se existe pendência numa data futura */
      R038PEN_TEMPENFUT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_TemPenFut OUT);

      /* se não existe pendência com data futura, verifica se existe pendência com data passada e situação não atendida */
      IF (l_TemPenFut = FALSE) THEN
        BEGIN
             SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU
               INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu
               FROM R038PEN
              WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                    R038PEN.TIPCOL = :NEW.TIPCOL AND
                    R038PEN.NUMCAD = :NEW.NUMCAD AND
                    R038PEN.DATTRF < :NEW.DATALT AND
                    ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
                     (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));
        EXCEPTION
             WHEN NO_DATA_FOUND THEN
                  l_NumEmp := 0;
                  l_TipCol := 0;
                  l_NumCad := 0;
                  l_DatTrf := '31/12/1900,00:00:00';
        END;

        /* Considera que sempre altera Centro de Custo na inclusão do histórico para criação da pendência */
        l_AltCcu := 'S';

        /* Verifica se deve gerar pendencia de chefia */
        IF (l_ColChe = TRUE) THEN
          l_SitChe := 1; /* Não Atendida */
        ELSE
          l_SitChe := 3; /* Sem necessidade de Alteração */
        END IF;

        /* Verifica se deve gerar pendencia de usuário */
        IF (l_ColUsu = TRUE) THEN
          l_SitUsu := 1; /* Não Atendida */
        ELSE
          l_SitUsu := 4; /* Sem necessidade de Alteração */
        END IF;

        /* Se existir uma pendência com data passada e situação 1 (Não atendida), esta
           será excluída e regerada com a nova data */
        IF (l_NumCad <> 0) THEN

          /* Insere nova pendência com base nos valores da pendência da data passada */
          BEGIN
            INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu);
          EXCEPTION
            WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
          END;

          /* Deleta pendência da data passada */
          R038PEN_DELPENPAS(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATALT);

        ELSE
          /* Verifica se existe pendência na mesma data de alteração */
          BEGIN
               SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, SITCHE, SITUSU INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_auxSitChe, l_auxSitUsu
                 FROM R038PEN
                WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                      R038PEN.TIPCOL = :NEW.TIPCOL AND
                      R038PEN.NUMCAD = :NEW.NUMCAD AND
                      R038PEN.DATTRF = :NEW.DATALT;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_NumEmp := 0;
                    l_TipCol := 0;
                    l_NumCad := 0;
                    l_DatTrf := '31/12/1900,00:00:00';
                    l_auxSitChe := 0;
                    l_auxSitUsu := 0;
          END;

          /* Se existir pendência na mesma data, atualiza a pendência */
          IF (l_NumCad <> 0) THEN

            IF ((l_auxSitChe = 1 OR l_auxSitChe = 3) AND
                (l_auxSitUsu = 1 OR l_auxSitUsu = 4)) THEN

              /* Atualiza pendência */
              BEGIN
                UPDATE R038PEN
                   SET ALTCCU = l_AltCcu, SITCHE = l_SitChe, SITUSU = l_SitUsu
                 WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                       R038PEN.TIPCOL = :NEW.TIPCOL AND
                       R038PEN.NUMCAD = :NEW.NUMCAD AND
                       R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;

            ELSE
              /* Se a Situação for diferente de "Não atendida" ou "Sem necessidade de alteração", então
                 indica na pendência que necessita Revisão */
              BEGIN
                UPDATE R038PEN SET ALTCCU = l_AltCcu, NESREV = 'S'
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            END IF;

          ELSE

            /* Insere nova pendência */
            BEGIN
              INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'N', 'N', 'N', l_AltCcu, 'N', 'N', 'N', l_SitChe, l_SitUsu, 'N', 0, 0);
            EXCEPTION
              WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
            END;

          END IF;
        END IF;
      END IF;

    END IF;
  END IF;

  IF  :NEW.STAHIS = 1 THEN
      R038HCC_HFI(:NEW.TIPCOL,:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATALT,:NEW.CODCCU);
  END IF;

  /* Insere registro na AUX para processar rotina do QL */
  BEGIN
    INSERT INTO R038HCC_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, CODCCU)
           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, :NEW.CODCCU);
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro no INSERT em R038HCC_AUX.';
  END;
   
  /* Geração de logs Histórico Centro Custo*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 60;     /* Histórico Centro Custo*/
  l_codtpa := 231;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HCC_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HCC_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCCU', :NEW.CODCCU);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONFIN', CONVERT(NUMBER_TO_CHAR, :NEW.CONFIN));
      END;
  END IF;
  
  /* eSocial */
  RH_LAY_CONTR_COLAB(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_layoutAlteracaoContrato OUT);
  IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
    /* Busca o valor dos campos Rateio MO Cálculo e Usa Rotina Tomadores do cadastro da empresa */
    BEGIN
  	  SELECT UsaRat, RotTom, IniTom INTO l_UsaRat, l_RotTom, l_IniTom FROM R030EMP WHERE NUMEMP = :NEW.NumEmp;
    EXCEPTION
  	  WHEN OTHERS THEN
	    RAISERROR 103 'Erro no buscar informações da empresa.';
    END;

    /* Verifica se utiliza rateio de mão de obra por centro de custo */
    IF (l_UsaRat = 'C') THEN
      /* Verifica se utiliza rotina de tomadores por rateio */
      IF (l_RotTom = 'R' AND l_IniTom < :NEW.DatAlt) THEN
        /* Se a Data de Alteração é maior que o Inicio dos Não Periódicos */
        RH_DEF_ESOCIAL(:NEW.NumEmp, l_DatTab OUT, l_DatUes OUT, l_IniNpe OUT, l_IniPer OUT, l_IniSST OUT, l_IniMig OUT);
      	IF (:NEW.DATALT > l_IniNpe) THEN
      	  l_IniNpe := :NEW.DATALT;
      	END IF;
      
        /* Busca filial do colaborador */
        RH_RETFILCOL(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_IniNpe, l_CodFil OUT);
    
        /* Busca o tipo da filial */
        RH_RETTIPFIL(:NEW.NumEmp, l_CodFil, l_TipFil OUT);
    
        IF ((l_TipFil IS NOT NULL) AND (l_TipFil = 'O')) THEN /* O = Obra */
          /* Busca codigo do recolhimento de FGTS */
          RH_RETCDRFGTFIL(:NEW.NumEmp, l_CodFil, :NEW.DatAlt, l_CdrFgt OUT);
      
          IF (l_CdrFgt = 155) THEN /* 155 = Obra de Construção Civil */
		    SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, :NEW.DatAlt, 'R038HCC', 'DATALT', 'I', '', '', 0, 'R038HCC_EI');
		  END IF;
		END IF;       
      END IF;
    END IF;
  END IF;

  /* Pendência SAMSenior */
  IF (:NEW.STAHIS = 1) THEN
    SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_INTSTR(:NEW.NUMEMP, '9999', l_numemp_str OUT);
    SP_ESPSTR(:NEW.CODCCU, 18, l_codccu_str OUT);
    l_valstr := 'H' || l_idtpes || l_numemp_str || l_codccu_str;
    SP_SAM_PENDENCIES(34, 1, l_valstr);
  END IF;

END␀Ô␀␀	SENIOR;0©␀␀

/* Trigger Update - Statement */
TRIGGER R038HCC_SU AFTER UPDATE ON R038HCC

DECLARE
/* CURSOR c/ os registros gravados no R038HCC_AUX */
  CURSOR c_r038hcc_upd IS
    SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, CODCCU, EMPOLD, TIPOLD, CADOLD, DATOLD, CCUOLD
      FROM R038HCC_AUX WHERE CODCCU <> CCUOLD;

  TYPE t_r038HCC_aux IS RECORD(
    NUMEMP   R038HCC_AUX.NUMEMP%TYPE,
    TIPCOL   R038HCC_AUX.TIPCOL%TYPE,
    NUMCAD   R038HCC_AUX.NUMCAD%TYPE,
    DATALT   R038HCC_AUX.DATALT%TYPE,
    CODCCU   R038HCC_AUX.CODCCU%TYPE,
    EMPOLD   R038HCC_AUX.EMPOLD%TYPE,
    TIPOLD   R038HCC_AUX.TIPOLD%TYPE,
    CADOLD   R038HCC_AUX.CADOLD%TYPE,
    DATOLD   R038HCC_AUX.DATOLD%TYPE,
    CCUOLD   R038HCC_AUX.CCUOLD%TYPE);

  xR038HCC_aux t_r038HCC_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r038hcc_upd INTO  xR038HCC_aux.NUMEMP,
                              xR038HCC_aux.TIPCOL,
                              xR038HCC_aux.NUMCAD,
                              xR038HCC_aux.DATALT,
                              xR038HCC_aux.CODCCU,
                              xR038HCC_aux.EMPOLD,
                              xR038HCC_aux.TIPOLD,
                              xR038HCC_aux.CADOLD,
                              xR038HCC_aux.DATOLD,
                              xR038HCC_aux.CCUOLD
  LOOP
    /* Atualiza o Quadro Efetivo - QL */
    QL_EXCCCUSTO(xR038HCC_aux.EmpOld, xR038HCC_aux.TipOld, xR038HCC_aux.CadOld, xR038HCC_aux.DatOld, xR038HCC_aux.CcuOld, xR038HCC_aux.DatAlt, xR038HCC_aux.CodCcu);

    QL_INCCCUSTO(xR038HCC_aux.NumEmp, xR038HCC_aux.TipCol, xR038HCC_aux.NumCad, xR038HCC_aux.DatAlt, xR038HCC_aux.CodCcu, xR038HCC_aux.DatAlt, xR038HCC_aux.CodCcu);
  END LOOP;

  /* Apaga registros da R038HCC_AUX */
  BEGIN
    DELETE FROM R038HCC_AUX;
    DROP_TEMP_TABLE R038HCC_AUX;    
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na exclusão dos registros da R038HCC_AUX';
  END;
END␀šÔ␀␀		SENIOR;0³5␀␀

/* Alteracao */
TRIGGER R038HCC_EU AFTER UPDATE ON R038HCC FOR EACH ROW

DECLARE
  l_TemPenFut    BOOLEAN;
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_AltEmp         R038PEN.ALTEMP%TYPE;
  l_AltFil         R038PEN.ALTFIL%TYPE;
  l_AltLoc         R038PEN.ALTLOC%TYPE;
  l_AltCcu         R038PEN.ALTCCU%TYPE;
  l_AltCar         R038PEN.ALTCAR%TYPE;
  l_AltEsc         R038PEN.ALTESC%TYPE;
  l_AltDes         R038PEN.ALTDES%TYPE;
  l_SitChe         R038PEN.SITCHE%TYPE;
  l_SitUsu         R038PEN.SITUSU%TYPE;
  l_NesRev         R038PEN.NESREV%TYPE;
  l_EmpAtu         R038PEN.EMPATU%TYPE;
  l_CadAtu         R038PEN.CADATU%TYPE;
  l_ColChe       BOOLEAN;
  l_ColUsu       BOOLEAN;
  l_auxSitChe      R038PEN.SITCHE%TYPE;
  l_auxSitUsu      R038PEN.SITUSU%TYPE;  
  l_AssTrfCcu      R000ASS.TRFCCU%TYPE;
  l_Valido       BOOLEAN;
  l_Alterou      BOOLEAN;
  
  /* VARIÁVEIS DE CONTROLE DO LOG */
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);

  /* eSocial */
  l_AlterouESocial BOOLEAN;
  l_ValidoEsocial BOOLEAN;
  l_Valor VARCHAR2(2000);
  l_JsonCamposAlterados VARCHAR2(2000);
  l_layoutAlteracaoContrato VARCHAR2(6);
  l_UsaRat         R030EMP.USARAT%TYPE;
  l_RotTom         R030EMP.ROTTOM%TYPE;
  l_IniTom         R030EMP.INITOM%TYPE;
  l_CodFil         R030FIL.CODFIL%TYPE;
  l_TipFil         R030FIL.TIPFIL%TYPE;
  l_CdrFgt         R030FFG.CDRFGT%TYPE;
  l_DatTab         R030DES.DatTab%TYPE;
  l_DatUes         R030DES.DatUes%TYPE;
  l_IniNpe         R030DES.IniNpe%TYPE;
  l_IniPer         R030DES.IniPer%TYPE;
  l_IniSST         R030DES.IniSST%TYPE;
  l_IniMig         R030DES.DatMig%TYPE;
  
  /* SAMSenior */
  l_idtpes       VARCHAR2(23);
  l_numemp_str   VARCHAR2(4);
  l_codccu_str   VARCHAR2(18);
  l_valstr       VARCHAR2(46);
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HCC_AUX;
  
BEGIN

  BEGIN
    SELECT TRFCCU INTO l_AssTrfCcu
      FROM R000ASS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_AssTrfCcu := 0;
  END;

  l_JsonCamposAlterados := '';

  IF (l_AssTrfCcu = 2) THEN
    /* Verifica se o colaborador está associado ao cadastro de chefia ou
       se o colaborador está associado com algum usuário */
    R038PEN_COLCHEFE(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_ColChe OUT, l_ColUsu OUT);

    /* Se o colaborador é chefe ou está associado a um usuário gera pendência */
    IF (l_ColChe = TRUE OR l_ColUsu = TRUE) THEN
      /* Verifica se existe pendência numa data futura */
      R038PEN_TEMPENFUT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_TemPenFut OUT);

      /* se não existe pendência com data futura, verifica se existe pendência com data passada e situação não atendida */
      IF (l_TemPenFut = FALSE) THEN
        BEGIN
             SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU
               INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu
               FROM R038PEN
              WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                    R038PEN.TIPCOL = :NEW.TIPCOL AND
                    R038PEN.NUMCAD = :NEW.NUMCAD AND
                    R038PEN.DATTRF < :NEW.DATALT AND
                    ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
                     (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));
        EXCEPTION
             WHEN NO_DATA_FOUND THEN
                  l_NumEmp := 0;
                  l_TipCol := 0;
                  l_NumCad := 0;
                  l_DatTrf := '31/12/1900,00:00:00';
        END;

        /* Considera que sempre altera Centro de Custo na inclusão do histórico para criação da pendência */
        l_AltCcu := 'S';

        /* Verifica se deve gerar pendencia de chefia */
        IF (l_ColChe = TRUE) THEN
          l_SitChe := 1; /* Não Atendida */
        ELSE
          l_SitChe := 3; /* Sem necessidade de Alteração */
        END IF;

        /* Verifica se deve gerar pendencia de usuário */
        IF (l_ColUsu = TRUE) THEN
          l_SitUsu := 1; /* Não Atendida */
        ELSE
          l_SitUsu := 4; /* Sem necessidade de Alteração */
        END IF;

        /* Se existir uma pendência com data passada e situação 1 (Não atendida), esta
           será excluída e regerada com a nova data */
        IF (l_NumCad <> 0) THEN
          /* Insere nova pendência com base nos valores da pendência da data passada */
          BEGIN
            INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu);
          EXCEPTION
            WHEN OTHERS THEN
               RAISERROR 103 'Erro ao inserir registro na R038PEN.';
          END;

          /* Deleta pendência da data passada */
          R038PEN_DELPENPAS(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATALT);

        ELSE
          /* Verifica se existe pendência na mesma data de alteração */
          BEGIN
               SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, SITCHE, SITUSU INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_auxSitChe, l_auxSitUsu
                 FROM R038PEN
                WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                      R038PEN.TIPCOL = :NEW.TIPCOL AND
                      R038PEN.NUMCAD = :NEW.NUMCAD AND
                      R038PEN.DATTRF = :NEW.DATALT;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_NumEmp := 0;
                    l_TipCol := 0;
                    l_NumCad := 0;
                    l_DatTrf := '31/12/1900,00:00:00';
                    l_auxSitChe := 0;
                    l_auxSitUsu := 0;
          END;

          /* Se existir pendência na mesma data, atualiza a pendência */
          IF (l_NumCad <> 0) THEN

            IF ((l_auxSitChe = 1 OR l_auxSitChe = 3) AND
                (l_auxSitUsu = 1 OR l_auxSitUsu = 4)) THEN
              /* Atualiza pendência */
              BEGIN
                UPDATE R038PEN SET ALTCCU = l_AltCcu, SITCHE = l_SitChe, SITUSU = l_SitUsu
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            ELSE
              /* Se a Situação for diferente de "Não atendida" ou "Sem necessidade de alteração", então
                 indica na pendência que necessita Revisão */
              BEGIN
                UPDATE R038PEN SET ALTCCU = l_AltCcu, NESREV = 'S'
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            END IF;

          ELSE

            /* Insere nova pendência */
            BEGIN
              INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'N', 'N', 'N', l_AltCcu, 'N', 'N', 'N', l_SitChe, l_SitUsu, 'N', 0, 0);
            EXCEPTION
              WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
            END;

          END IF;
        END IF;
      END IF;

    END IF;
  END IF;

  IF  :NEW.STAHIS = 1 THEN
    R038HCC_HFI(:NEW.TIPCOL,:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATALT,:NEW.CODCCU);
  END IF;

  /* Insere registro na AUX para processar rotina do QL */
  BEGIN
    INSERT INTO R038HCC_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, CODCCU, EMPOLD, TIPOLD, CADOLD, DATOLD, CCUOLD)
           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, :NEW.CODCCU, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, :OLD.CODCCU);
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro no INSERT do Registro NEW na R038HCC_AUX.';
  END;
    
  /* Geração de logs Histórico Centro Custo*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 60;     /* Histórico Centro Custo*/
  l_codtpa := 232;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.CodCcu <> :NEW.CodCcu)
   OR (:OLD.StaHis <> :NEW.StaHis)
   OR (:OLD.ConFin <> :NEW.ConFin)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HCC_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HCC_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCCU', :OLD.CODCCU);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCCU', :NEW.CODCCU);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSTAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSTAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONFIN', CONVERT(NUMBER_TO_CHAR, :OLD.CONFIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONFIN', CONVERT(NUMBER_TO_CHAR, :NEW.CONFIN));
      END;
    END IF; 
  END IF;
  
  /* eSocial */
  SP_VALUPDATE_DES(:OLD.CodCcu, :NEW.CodCcu, l_ValidoEsocial OUT);
  IF (l_ValidoEsocial = TRUE) THEN
	l_AlterouESocial := TRUE;
    SP_CONCAT_DES_JSON('CODCCU', :NEW.CodCcu, :OLD.CodCcu, l_JsonCamposAlterados OUT);		
  END IF;
  
  IF (l_AlterouESocial = TRUE) THEN
    RH_LAY_CONTR_COLAB(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_layoutAlteracaoContrato OUT);
    IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
      /* Busca o valor dos campos Rateio MO Cálculo e Usa Rotina Tomadores do cadastro da empresa */
      BEGIN
  	    SELECT UsaRat, RotTom, IniTom INTO l_UsaRat, l_RotTom, l_IniTom FROM R030EMP WHERE NUMEMP = :NEW.NumEmp;
      EXCEPTION
  	    WHEN OTHERS THEN
	      RAISERROR 103 'Erro no buscar informações da empresa.';
      END;

      /* Verifica se utiliza rateio de mão de obra por centro de custo */
      IF (l_UsaRat = 'C') THEN
        /* Verifica se utiliza rotina de tomadores por rateio */
        IF (l_RotTom = 'R' AND l_IniTom < :NEW.DatAlt) THEN
          /* Se a Data de Alteração é maior que o Inicio dos Não Periódicos */
          RH_DEF_ESOCIAL(:NEW.NumEmp, l_DatTab OUT, l_DatUes OUT, l_IniNpe OUT, l_IniPer OUT, l_IniSST OUT, l_IniMig OUT);
      	  IF (:NEW.DATALT > l_IniNpe) THEN
      	    l_IniNpe := :NEW.DATALT;
      	  END IF;
          
          /* Busca filial do colaborador */
          RH_RETFILCOL(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_IniNpe, l_CodFil OUT);
    
          /* Busca o tipo da filial */
          RH_RETTIPFIL(:NEW.NumEmp, l_CodFil, l_TipFil OUT);
    
          IF (l_TipFil = 'O') THEN /* O = Obra */
            /* Busca codigo do recolhimento de FGTS */
            RH_RETCDRFGTFIL(:NEW.NumEmp, l_CodFil, :NEW.DatAlt, l_CdrFgt OUT);
      
            IF (l_CdrFgt = 155) THEN /* 155 = Obra de Construção Civil */
		      SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, :NEW.DatAlt, 'R038HCC', 'DATALT', 'A', '', l_JsonCamposAlterados, 0, 'R038HCC_EU');
		    END IF;
		  END IF;
		END IF;       
      END IF;
    END IF;
  END IF;

  /* Pendência SAMSenior */
  IF (:NEW.STAHIS = 1) AND ((:OLD.STAHIS = 0) OR (:NEW.NUMEMP <> :OLD.NUMEMP) OR (:NEW.CODCCU <> :OLD.CODCCU)) THEN
    SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_INTSTR(:NEW.NUMEMP, '9999', l_numemp_str OUT);
    SP_ESPSTR(:NEW.CODCCU, 18, l_codccu_str OUT);
    l_valstr := 'H' || l_idtpes || l_numemp_str || l_codccu_str;
    SP_SAM_PENDENCIES(34, 1, l_valstr);
  END IF;
END␀œÔ␀␀	SENIOR;0X␀␀TRIGGER R038HCC_SD AFTER DELETE ON R038HCC

DECLARE
l_codccu       VARCHAR2(18);
  l_datalt       DATE;
  l_comando_nulo BOOLEAN;
  l_datccu       DATE;

  l_idtpes       VARCHAR2(23);
  l_numemp_str   VARCHAR2(4);
  l_codccu_str   VARCHAR2(18);
  l_valstr       VARCHAR2(46);

  /* CURSOR c/ os registros gravados no R038HCC_AUX */
  CURSOR c_r038hcc_del IS SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, CODCCU, STAHIS FROM R038HCC_AUX;
  
  TYPE t_r038HCC_aux IS RECORD(
    NUMEMP   R038HCC_AUX.NUMEMP%TYPE,
    TIPCOL   R038HCC_AUX.TIPCOL%TYPE,
    NUMCAD   R038HCC_AUX.NUMCAD%TYPE,
    DATALT   R038HCC_AUX.DATALT%TYPE,
    CODCCU   R038HCC_AUX.CODCCU%TYPE,
    STAHIS   R038HCC_AUX.STAHIS%TYPE);
    
  l_r038HCC_aux t_r038HCC_aux;
BEGIN
  l_comando_nulo:=FALSE;

  /* Le Registro do CURSOR */
  FOREACH c_r038hcc_del INTO  l_r038HCC_aux.NUMEMP,
                              l_r038HCC_aux.TIPCOL,
                              l_r038HCC_aux.NUMCAD,
                              l_r038HCC_aux.DATALT,
                              l_r038HCC_aux.CODCCU,
                              l_r038HCC_aux.STAHIS
  LOOP
    /* Pega o historico anterior */
    IF l_r038HCC_aux.STAHIS = 1 THEN
      l_comando_nulo:=FALSE;
      BEGIN
        SELECT R034FUN.CODCCU, R034FUN.DATCCU
          INTO l_codccu,l_datccu
          FROM R034FUN
         WHERE R034FUN.TIPCOL = l_r038HCC_aux.TIPCOL AND
               R034FUN.NUMEMP = l_r038HCC_aux.NUMEMP AND
               R034FUN.NUMCAD = l_r038HCC_aux.NUMCAD;
      EXCEPTION WHEN OTHERS THEN
          l_comando_nulo:=TRUE;
      END;

      IF (l_comando_nulo = FALSE) THEN
        IF (l_r038HCC_aux.CODCCU = l_codccu) AND (l_r038HCC_aux.DATALT = l_datccu) THEN
          BEGIN
            SELECT A.CODCCU,A.DATALT
            INTO l_codccu,l_datalt
            FROM R038HCC A
            WHERE A.NUMEMP = l_r038hcc_aux.NUMEMP
            AND   A.TIPCOL = l_r038hcc_aux.TIPCOL
            AND   A.NUMCAD = l_r038hcc_aux.NUMCAD
            AND  A.STAHIS = 1
            AND DATALT IN (SELECT MAX(DATALT) FROM R038HCC
                           WHERE NUMEMP = l_r038hcc_aux.NUMEMP
                           AND   TIPCOL = l_r038hcc_aux.TIPCOL
                           AND   NUMCAD = l_r038hcc_aux.NUMCAD
                           AND   STAHIS = 1);
          EXCEPTION
            WHEN TOO_MANY_ROWS THEN
              RAISERROR 103 'Erro em R038HCC - TOO MANY ROWS';
            WHEN NO_DATA_FOUND THEN
              l_codccu:='';
              l_datalt:='31/12/1900,00:00:00';
            WHEN OTHERS THEN
              RAISERROR 103 'Erro no SELECT R038HCC';
          END;

         /* Atualiza tabela de colaboradores */
      /*    IF  l_codccu <> 0 THEN */
              BEGIN
                UPDATE R034FUN
                   SET CODCCU = l_codccu,
                       DATCCU = l_datalt
                 WHERE R034FUN.TIPCOL = l_r038hcc_aux.TIPCOL AND
                       R034FUN.NUMEMP = l_r038hcc_aux.NUMEMP AND
                       R034FUN.NUMCAD = l_r038hcc_aux.NUMCAD;
              EXCEPTION WHEN OTHERS THEN
                RAISERROR 103 'Erro Na Atualização do R034FUN';
              END;
      /*    END; */

          /* Atualiza o historico de filiais */
          BEGIN
             UPDATE R038HFI
                SET CODCCU = l_codccu
              WHERE R038HFI.TIPCOL = l_r038hcc_aux.TIPCOL AND
                    R038HFI.NUMEMP = l_r038hcc_aux.NUMEMP AND
                    R038HFI.NUMCAD = l_r038hcc_aux.NUMCAD AND
                    R038HFI.DATALT = l_r038HCC_aux.DATALT;
          EXCEPTION WHEN OTHERS THEN
            l_comando_nulo:=TRUE;
          END;

          /* Pendência SAMSenior */
          IF (LENGTH(LTRIM(l_codccu)) IS NOT NULL) AND (LENGTH(LTRIM(l_codccu)) > 0) THEN
            SP_RETIDTPES(l_r038hcc_aux.NUMEMP, l_r038hcc_aux.TIPCOL, l_r038hcc_aux.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
            SP_INTSTR(l_r038hcc_aux.NUMEMP, '9999', l_numemp_str OUT);
            SP_ESPSTR(l_codccu, 18, l_codccu_str OUT);
            l_valstr := 'H' || l_idtpes || l_numemp_str || l_codccu_str;
            SP_SAM_PENDENCIES(34, 1, l_valstr);
          END IF;
        END IF;

      END IF;
    END IF;

    /* Atualiza o Quadro Efetivo - QL */
    QL_EXCCCUSTO(l_r038HCC_aux.NumEmp, l_r038HCC_aux.TipCol, l_r038HCC_aux.NumCad, l_r038HCC_aux.DatAlt, l_r038HCC_aux.CodCcu, l_r038HCC_aux.DatAlt, ' ');
  END LOOP;

  /* Apaga Registro OLD em R038HCC_AUX */
  BEGIN
    DELETE FROM R038HCC_AUX;
    DROP_TEMP_TABLE R038HCC_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀˜Ô␀␀		SENIOR;0Ç␀␀

TRIGGER R038HCC_ED AFTER DELETE ON R038HCC FOR EACH ROW

DECLARE
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  
  /* VARIÁVEIS DO LOG */
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);

  /* eSocial */
  l_layoutAlteracaoContrato VARCHAR2(6);
  l_UsaRat         R030EMP.UsaRat%TYPE;
  l_RotTom         R030EMP.RotTom%TYPE;
  l_IniTom         R030EMP.IniTom%TYPE;
  l_CodFil         R030FIL.CodFil%TYPE;
  l_TipFil         R030FIL.TipFil%TYPE;
  l_CdrFgt         R030FFG.CdrFgt%TYPE;
  l_DatTab         R030DES.DatTab%TYPE;
  l_DatUes         R030DES.DatUes%TYPE;
  l_IniNpe         R030DES.IniNpe%TYPE;
  l_IniPer         R030DES.IniPer%TYPE;
  l_IniSST         R030DES.IniSST%TYPE;
  l_IniMig         R030DES.DatMig%TYPE;

  /* SAMSenior */
  l_idtpes       VARCHAR2(23);
  l_numemp_str   VARCHAR2(4);
  l_codccu_str   VARCHAR2(18);
  l_valstr       VARCHAR2(46);
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HCC_AUX;
  
BEGIN
  /* Verifica se existe pendência gerada exclusivamente pelo histórico de Centro de Custo para o
     cadastro de origem que está sendo excluído */
  BEGIN
       SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf
         FROM R038PEN
        WHERE R038PEN.NUMEMP = :OLD.NUMEMP AND
              R038PEN.TIPCOL = :OLD.TIPCOL AND
              R038PEN.NUMCAD = :OLD.NUMCAD AND
              R038PEN.DATTRF = :OLD.DATALT AND
              R038PEN.ALTEMP = 'N' AND
              R038PEN.ALTFIL = 'N' AND
              R038PEN.ALTLOC = 'N' AND
              R038PEN.ALTCCU = 'S' AND
              R038PEN.ALTCAR = 'N' AND
              R038PEN.ALTESC = 'N' AND
              R038PEN.ALTDES = 'N';
  EXCEPTION
       WHEN NO_DATA_FOUND THEN
            l_NumEmp := 0;
            l_TipCol := 0;
            l_NumCad := 0;
            l_DatTrf := '31/12/1900,00:00:00';
  END;

  /* Se existe pendência exclusiva do histórico de Centro de Custo para o cadastro de origem
     verifica se já foi atendida para então excluir */
  IF (l_NumCad <> 0) THEN
    R038PEN_DELPEN(l_NumEmp, l_TipCol, l_NumCad, l_DatTrf);
  ELSE
    /* Atualiza pendência do Centro de Custo com 'N' */
    BEGIN
      UPDATE R038PEN SET ALTCCU = 'N'
               WHERE R038PEN.NUMEMP = :OLD.NUMEMP AND
                     R038PEN.TIPCOL = :OLD.TIPCOL AND
                     R038PEN.NUMCAD = :OLD.NUMCAD AND
                     R038PEN.DATTRF = :OLD.DATALT;
    EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no update da Tabela R038PEN.';
    END;
  END IF;

  BEGIN
    /* Insere Registro Old */
    INSERT INTO R038HCC_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, CODCCU, STAHIS)
                     VALUES (:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, :OLD.CODCCU, :OLD.STAHIS);
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro no INSERT em R038HCC_AUX.';
  END;
   
  /* Geração de logs Histórico Centro Custo*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 60;     /* Histórico Centro Custo*/
  l_codtpa := 231;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HCC_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HCC_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCCU', :OLD.CODCCU);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONFIN', CONVERT(NUMBER_TO_CHAR, :OLD.CONFIN));
      END;
  END IF;

  /* eSocial */
  RH_LAY_CONTR_COLAB(:OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, l_layoutAlteracaoContrato OUT);
  IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
    /* Busca o valor dos campos Rateio MO Cálculo e Usa Rotina Tomadores do cadastro da empresa */
    BEGIN
  	  SELECT UsaRat, RotTom, IniTom INTO l_UsaRat, l_RotTom, l_IniTom FROM R030EMP WHERE NUMEMP = :OLD.NumEmp;
    EXCEPTION
  	  WHEN OTHERS THEN
	    RAISERROR 103 'Erro no buscar informações da empresa.';
    END;

    /* Verifica se utiliza rateio de mão de obra por centro de custo */
    IF (l_UsaRat = 'C') THEN
      /* Verifica se utiliza rotina de tomadores por rateio */
      IF (l_RotTom = 'R' AND l_IniTom < :OLD.DatAlt) THEN
        /* Se a Data de Alteração é maior que o Inicio dos Não Periódicos */
        RH_DEF_ESOCIAL(:OLD.NumEmp, l_DatTab OUT, l_DatUes OUT, l_IniNpe OUT, l_IniPer OUT, l_IniSST OUT, l_IniMig OUT);
      	IF (:OLD.DATALT > l_IniNpe) THEN
      	  l_IniNpe := :OLD.DATALT;
      	END IF;
      
        /* Busca filial do colaborador */
        RH_RETFILCOL(:OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, l_IniNpe, l_CodFil OUT);
   
        /* Busca o tipo da filial */
        RH_RETTIPFIL(:OLD.NumEmp, l_CodFil, l_TipFil OUT);
    
        IF (l_TipFil = 'O') THEN /* O = Obra */
          /* Busca codigo do recolhimento de FGTS */
          RH_RETCDRFGTFIL(:OLD.NumEmp, l_CodFil, :OLD.DatAlt, l_CdrFgt OUT);
             
          IF (l_CdrFgt = 155) THEN /* 155 = Obra de Construção Civil */ 
		    SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, :OLD.DatAlt, 'R038HCC', 'DATALT', 'E', '', '', 0, 'R038HCC_ED');
		  END IF;
		END IF;
      END IF;       
    END IF;
  END IF;

  /* Pendência SAMSenior */
  IF (:OLD.STAHIS = 1) THEN
    SP_RETIDTPES(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_INTSTR(:OLD.NUMEMP, '9999', l_numemp_str OUT);
    SP_ESPSTR(:OLD.CODCCU, 18, l_codccu_str OUT);
    l_valstr := 'H' || l_idtpes || l_numemp_str || l_codccu_str;
    SP_SAM_PENDENCIES(34, 3, l_valstr);
  END IF;
END␀␀␀v␀␀␀␀␀␀␀—Ô␀␀…¬␀␀´␀Ôï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀tÔï!␀␀␀␀␀Ü␀t␀Ü␀nˆ␀Æÿ␀␀ÿ␀c¬␀␀Ì␀Ôï!␀␀␀␀␀.%0.0.wˆ␀Æÿ␀␀ÿ␀mDÑ␀Ôï!␀␀␀␀␀EIşEşEqCˆ␀êÿ␀␀ÿ␀:,Ôï!␀␀␀␀␀AÓ«␀␀Ù«␀␀b␀ˆ␀␀ÿ␀␀)`␀*␀áÔï!␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀␀b´␀Ôï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀Û␀tÔï!␀␀␀␀␀Ü␀t␀Ü␀nˆ␀Æÿ␀␀ÿ␀Z$Ì␀Ôï!␀␀␀␀␀.%0.0.wˆ␀Æÿ␀␀ÿ␀MEÑ␀Ôï!␀␀␀␀␀EIşEşEqCˆ␀êÿ␀␀ÿ␀Ò(Ôï!␀␀␀␀␀AÓ«␀␀Ù«␀␀b␀ˆ␀␀ÿ␀␀)`␀␀␀␀␀␀	␀€v␀	␀␀␀␀␀␀␀␀␀␀␀ŸÔ␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀g>XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ?␀␀␀␀␀␀t␀Ü␀n ˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ?␀␀␀␀␀‚%0.0.wˆ␀Æÿ␀␀…Ó␀␀␀EÑ␀	Ôÿ?␀␀␀␀␀L¢G¢GqCˆ␀êÿ␀␀ÿ␀␀ÇÔÿ1␀␀␀␀␀4␀␀Ë␀Ë␀n␀Æÿ␀␀ÿ␀Ëa´␀Ôÿ1␀␀␀␀␀‡>¾«␀␀¾«␀␀rˆ␀Æÿ␀␀Ò␀␀␀9$Ì␀Ôÿ1␀␀␀␀␀PBÕ«␀␀Õ«␀␀wˆ␀Æÿ␀␀ÿ␀¥mÌ␀Ôÿ1␀␀␀␀␀J°␀␀ÄmÄm{␀Æÿ␀␀ÿ␀␀ÛÔÿ1␀␀␀␀␀é␀é␀é␀n␀Æÿ␀␀ÿ␀î)¢␀Ôÿ1␀␀␀␀␀°␀␀°␀␀°␀␀;)␀␀Æÿ␀␀ÿ␀Ø)Ôÿ1␀␀␀␀␀°␀␀°␀␀°␀␀£␀␀ÿ␀␀O"␀Ş␀”Ôÿ1␀␀␀␀␀¶+␀¶+␀¶+␀n␀Æÿ␀␀ÿ␀␀±␀Ôÿ1␀␀␀␀␀?Á␀¤␀q␀Æÿ␀␀¨Ï␀␀␀µEÑ␀Ôÿ1␀␀␀␀␀LÉHÉHqC␀êÿ␀␀ÿ␀Š³␀␀dÔÿ1␀␀␀␀␀ñ³␀␀ñ³␀␀ñ³␀␀?␀␀ÿ␀␀ÿ␀¯-±␀Ôï1␀␀␀␀␀«B£␀á«␀␀q‡␀Æÿ␀␀½Ğ␀␀␀+f±␀Ôï1␀␀␀␀␀™>÷eÊfq‡␀Æÿ␀␀€Ğ␀␀␀Ä␀␀4Ôï1␀␀␀␀␀„B‘Ä␀␀ß«␀␀f␀␀␀ÿ␀␀ş¸␀␀␀¼¢␀␀±␀Ôï1␀␀␀␀␀U£␀␀Î¢␀␀İ¢␀␀q␀Æÿ␀␀*Û␀␀␀—,¼␀Ôÿ1␀␀␀␀␀¨>Ä«␀␀Ä«␀␀X)␀ˆ␀Æÿ␀␀!#␀Ş␀´␀Ôÿ1␀␀␀␀␀%?¶␀␀¶␀␀r␀Æÿ␀␀YĞ␀␀␀§¬␀␀Ì␀Ôÿ1␀␀␀␀␀äš␀␀€š␀␀Û«␀␀m␀Æÿ␀␀aĞ␀␀␀:,Ôÿ1␀␀␀␀␀şAØ!Ó«␀␀b␀ˆ␀␀ÿ␀␀)`␀9¦␀␀±␀Ôÿ1␀␀␀␀␀Á>.¦␀␀É«␀␀qˆ␀Æÿ␀␀ĞÖ␀␀␀f´␀Ôÿ1␀␀␀␀␀˜>ïe»fr␀Æÿ␀␀)Ñ␀␀␀0,4Ôÿ1␀␀␀␀␀øA×«␀␀×«␀␀}␀ˆ␀␀ÿ␀␀Ñ␀␀␀