␀␀PROCEDURE SP_UPDFIS(P_NUMCRA NUMBER,P_SITCRA CHAR(1),P_DATVAL CHAR(16))
 IS

 l_cratit       NUMBER(12);
 l_crapro       NUMBER(12);
 l_numbar       NUMBER(12);
 l_numpro       NUMBER(12);
 l_numsma       NUMBER(12);
 l_crapri       NUMBER(12);
 l_tecpri       NUMBER(1);
 l_sitcra       NUMBER(2);
 l_numcra       CHAR(12);
 l_strerr       VARCHAR2(255);
BEGIN
  /*Para pontos do sistema que passam SITCRA como um ' ', atribuo 0 (zero), como fazem implicitamente os bancos Oracle e SQL Server */
  IF (p_sitcra = ' ' OR p_sitcra = '') THEN
    l_sitcra := 0;
  ELSE
    l_sitcra := CONVERT(CHAR_TO_NUMBER, p_sitcra);
  END IF;

  /*Obtem o(s) número(s) físico(s)*/
  SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
  /*Se a data de validade vier zerada atualiza o campo SITCRA*/
  IF p_datval = ' ' THEN
      /*Se não possuir número físico atualiza apenas o número lógico*/
      IF (l_tecpri = 0) THEN
          BEGIN
              UPDATE R070CON SET SITCRA = l_sitcra WHERE NUMFIS = p_numcra;
          EXCEPTION
                  WHEN OTHERS THEN
                      SP_INTSTR(p_numcra, '999999999999', l_numcra OUT); 
                      l_strerr := 'SP_UPDFIS: Erro ao atribuir a situação '
                                               ||p_sitcra 
                                               ||' para o crachá de número lógico '
                                               ||l_numcra
                                               ||'.';
                      RAISERROR 103 l_strerr;
          END;
      ELSE
          /*Atualiza o Crachá de Barras se exisir*/
          IF l_numbar <> 0 THEN
              BEGIN
                  UPDATE R070CON SET SITCRA = l_sitcra WHERE NUMFIS = l_numbar;
              EXCEPTION
                  WHEN OTHERS THEN
                      SP_INTSTR(l_numbar, '999999999999', l_numcra OUT);
                      l_strerr := 'SP_UPDFIS: Erro ao atribuir a situação '
                                               ||p_sitcra 
                                               ||' para o crachá de tecnologia 1 - Barras e número físico '
                                               ||l_numcra
                                               ||'.';
                      RAISERROR 103 l_strerr;
              END;
          END IF;
          /*Atualiza o Crachá de Proximidade se exisir*/
          IF l_numpro <> 0 THEN
              BEGIN
                  UPDATE R070CON SET SITCRA = l_sitcra WHERE NUMFIS = l_numpro;
              EXCEPTION
                  WHEN OTHERS THEN
                      SP_INTSTR(l_numpro, '999999999999', l_numcra OUT);
                      l_strerr := 'SP_UPDFIS: Erro ao atribuir a situação '
                                               ||p_sitcra 
                                               ||' para o crachá de tecnologia 2 - Proximidade e número físico '
                                               ||l_numcra
                                               ||'.';
                      RAISERROR 103 l_strerr;
              END;
          END IF;
          /*Atualiza o Crachá Smart se exisir*/
          IF l_numsma <> 0 THEN
              BEGIN
                  UPDATE R070CON SET SITCRA = l_sitcra WHERE NUMFIS = l_numsma;
              EXCEPTION
                  WHEN OTHERS THEN
                      SP_INTSTR(l_numsma, '999999999999', l_numcra OUT);
                      l_strerr := 'SP_UPDFIS: Erro ao atribuir a situação '
                                               ||p_sitcra 
                                               ||' para o crachá de tecnologia 3 - Smartcard e número físico '
                                               ||l_numcra
                                               ||'.';
                      RAISERROR 103 l_strerr;
              END;
          END IF;
      END IF;
  /*Atualiza o Campo DatVal*/
  ELSE
      IF (l_tecpri = 0) THEN
              BEGIN
                  UPDATE R070CON SET DATVAL = p_datval WHERE NUMFIS = p_numcra;
              EXCEPTION
                  WHEN OTHERS THEN
                      SP_INTSTR(p_numcra, '999999999999', l_numcra OUT);
                      l_strerr := 'SP_UPDFIS: Erro ao atribuir a data de validade '
                                               ||p_datval 
                                               ||' para o crachá de número lógico '
                                               ||l_numcra
                                               ||'.';
                      RAISERROR 103 l_strerr;
              END;
      ELSE
          /*Atualiza o Crachá de Barras se exisir*/
          IF l_numbar <> 0 THEN
              BEGIN
                  UPDATE R070CON SET DATVAL = p_datval WHERE NUMFIS = l_numbar;
              EXCEPTION
                  WHEN OTHERS THEN
                      SP_INTSTR(l_numbar, '999999999999', l_numcra OUT);
                      l_strerr := 'SP_UPDFIS: Erro ao atribuir a data de validade '
                                               ||p_datval 
                                               ||' para o crachá de tecnologia 1 - Barras e número físico '
                                               ||l_numcra
                                               ||'.';
                      RAISERROR 103 l_strerr;
              END;
          END IF;
          /*Atualiza o Crachá de Proximidade se exisir*/
          IF l_numpro <> 0 THEN
              BEGIN
                  UPDATE R070CON SET DATVAL = p_datval WHERE NUMFIS = l_numpro;
              EXCEPTION
                  WHEN OTHERS THEN
                      SP_INTSTR(l_numpro, '999999999999', l_numcra OUT);
                      l_strerr := 'SP_UPDFIS: Erro ao atribuir a data de validade '
                                               ||p_datval 
                                               ||' para o crachá de tecnologia 2 - Proximidade e número físico '
                                               ||l_numcra
                                               ||'.';
                      RAISERROR 103 l_strerr;
              END;
          END IF;
          /*Atualiza o Crachá Smart se exisir*/
          IF l_numsma <> 0 THEN
              BEGIN
                  UPDATE R070CON SET DATVAL = p_datval WHERE NUMFIS = l_numsma;
              EXCEPTION
                  WHEN OTHERS THEN
                      SP_INTSTR(l_numsma, '999999999999', l_numcra OUT);
                      l_strerr := 'SP_UPDFIS: Erro ao atribuir a data de validade '
                                               ||p_datval 
                                               ||' para o crachá de tecnologia 3 - Smartcard e número físico '
                                               ||l_numcra
                                               ||'.';
                      RAISERROR 103 l_strerr;
              END;
          END IF;
      END IF;
  END IF;
END␀üø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
