/* Trigger Insert - Statement */
TRIGGER R006HOR_SI AFTER INSERT ON R006HOR
DECLARE
  /* CURSOR c/ os registros gravados na r006hor_aux */
  CURSOR c_r006hor_aux_ins IS SELECT CODESC, SEQREG, HORBU1, HORBU2, HORBU3, HORBU4, HORBU5 FROM R006HOR_AUX;
  
  TYPE t_r006hor_aux IS RECORD(
    CODESC   R006HOR_AUX.CODESC%TYPE,
    SEQREG   R006HOR_AUX.SEQREG%TYPE,
    HORBU1   R006HOR_AUX.HORBU1%TYPE,
    HORBU2   R006HOR_AUX.HORBU2%TYPE,
    HORBU3   R006HOR_AUX.HORBU3%TYPE,
    HORBU4   R006HOR_AUX.HORBU4%TYPE,
    HORBU5   R006HOR_AUX.HORBU5%TYPE);
  l_r006hor_aux t_r006hor_aux;
  l_horario   R006HOR.HorBu1%TYPE;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r006hor_aux_ins INTO l_r006hor_aux.CODESC,
    							 l_r006hor_aux.SEQREG,
    							 l_r006hor_aux.HORBU1,
    							 l_r006hor_aux.HORBU2,
    							 l_r006hor_aux.HORBU3,
    							 l_r006hor_aux.HORBU4,
    							 l_r006hor_aux.HORBU5
  LOOP
	l_horario := IFNULL(l_r006hor_aux.HORBU1, 0);
	IF (l_horario > 0) THEN
		RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 1, l_horario);
	END IF;
	l_horario := IFNULL(l_r006hor_aux.HORBU2, 0);
	IF (l_horario > 0) THEN
		RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 2, l_horario);
	END IF;
	l_horario := IFNULL(l_r006hor_aux.HORBU3, 0);
	IF (l_horario > 0) THEN
		RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 3, l_horario);
	END IF;
	l_horario := IFNULL(l_r006hor_aux.HORBU4, 0);
	IF (l_horario > 0) THEN
		RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 4, l_horario);
	END IF;
	l_horario := IFNULL(l_r006hor_aux.HORBU5, 0);
	IF (l_horario > 0) THEN
		RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 5, l_horario);
	END IF;
  END LOOP;
	
  /* Apaga Registro OLD/NEW em R006HOR_AUX */
  BEGIN
    DELETE FROM R006HOR_AUX;
    DROP_TEMP_TABLE R006HOR_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ĞÎ␀␀		SENIOR;0Ó␀␀TRIGGER R006HOR_EI AFTER INSERT ON R006HOR FOR EACH ROW
DECLARE
  l_DataReferencia DATE;
  
  l_tipesc   R006ESC.TIPESC%TYPE;
 
  /* Declaracao para criar tabela temporária em SQL Server - Erros de DeadLock */
  CREATE_TEMP_TABLE R006HOR_AUX;
BEGIN
  RH_250ALT(33);
   
  /*e-Social*/
  l_DataReferencia := CURDATE();      
  SP_ESOCIAL_ESCALA(:NEW.CODESC, l_DataReferencia, 'R006HOR', 'I');
  /*e-Social*/
  
  SP_SAM_PEND_HOR(:NEW.CODESC);
  
  BEGIN
	SELECT TipEsc INTO l_tipesc FROM R006ESC WHERE CODESC = :NEW.CODESC;
  EXCEPTION
	WHEN NO_DATA_FOUND THEN
		l_tipesc := 'P';
  END;
	
  IF (l_tipesc = 'B') THEN
	BEGIN
	  /* Insere Registro NEW */
    	INSERT INTO R006HOR_AUX (CODESC, SEQREG, HORBU1, HORBU2, HORBU3, HORBU4, HORBU5)
    	VALUES (:NEW.CODESC,:NEW.SEQREG, :NEW.HORBU1, :NEW.HORBU2, :NEW.HORBU3, :NEW.HORBU4, :NEW.HORBU5);
  	EXCEPTION WHEN OTHERS THEN
    	RAISERROR 103 'Erro no INSERT em R006HOR_AUX.';
  	END;
  END IF;
END␀ÕÎ␀␀	SENIOR;00␀␀


TRIGGER R006HOR_SU AFTER UPDATE ON R006HOR
DECLARE
  /* CURSOR c/ os registros gravados na r006hor_aux */
  CURSOR c_r006hor_aux_upd IS SELECT CODESC, SEQREG, BU1ANT, BU2ANT, BU3ANT, BU4ANT, BU5ANT, HORBU1, HORBU2, HORBU3, HORBU4, HORBU5 FROM R006HOR_AUX;
  TYPE t_r006hor_aux IS RECORD(
    CODESC   R006HOR_AUX.CODESC%TYPE,
    SEQREG   R006HOR_AUX.SEQREG%TYPE,
    BU1ANT   R006HOR_AUX.BU1ANT%TYPE,
    BU2ANT   R006HOR_AUX.BU2ANT%TYPE,
    BU3ANT   R006HOR_AUX.BU3ANT%TYPE,
    BU4ANT   R006HOR_AUX.BU4ANT%TYPE,
    BU5ANT   R006HOR_AUX.BU5ANT%TYPE,
    HORBU1   R006HOR_AUX.HORBU1%TYPE,
    HORBU2   R006HOR_AUX.HORBU2%TYPE,
    HORBU3   R006HOR_AUX.HORBU3%TYPE,
    HORBU4   R006HOR_AUX.HORBU4%TYPE,
    HORBU5   R006HOR_AUX.HORBU5%TYPE);
  l_r006hor_aux t_r006hor_aux;
  l_horario_anterior   R006HOR.HorBu1%TYPE;
  l_horario_atual   R006HOR.HorBu1%TYPE;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r006hor_aux_upd INTO l_r006hor_aux.CODESC,
    							 l_r006hor_aux.SEQREG,
    							 l_r006hor_aux.BU1ANT,
    							 l_r006hor_aux.BU2ANT,
    							 l_r006hor_aux.BU3ANT,
    							 l_r006hor_aux.BU4ANT,
    							 l_r006hor_aux.BU5ANT,
    							 l_r006hor_aux.HORBU1,
    							 l_r006hor_aux.HORBU2,
    							 l_r006hor_aux.HORBU3,
    							 l_r006hor_aux.HORBU4,
    							 l_r006hor_aux.HORBU5
  LOOP
	l_horario_anterior := IFNULL(l_r006hor_aux.BU1ANT, 0);
	l_horario_atual := IFNULL(l_r006hor_aux.HORBU1, 0);
	IF (l_horario_anterior <> l_horario_atual) THEN
  		RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 1, l_horario_atual);
  	END IF;
	l_horario_anterior := IFNULL(l_r006hor_aux.BU2ANT, 0);
	l_horario_atual := IFNULL(l_r006hor_aux.HORBU2, 0);
	IF (l_horario_anterior <> l_horario_atual) THEN
		RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 2, l_horario_atual);
  	END IF;
	l_horario_anterior := IFNULL(l_r006hor_aux.BU3ANT, 0);
	l_horario_atual := IFNULL(l_r006hor_aux.HORBU3, 0);
	IF (l_horario_anterior <> l_horario_atual) THEN
		RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 3, l_horario_atual);
  	END IF;
	l_horario_anterior := IFNULL(l_r006hor_aux.BU4ANT, 0);
	l_horario_atual := IFNULL(l_r006hor_aux.HORBU4, 0);
	IF (l_horario_anterior <> l_horario_atual) THEN
		RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 4, l_horario_atual);
  	END IF;
	l_horario_anterior := IFNULL(l_r006hor_aux.BU5ANT, 0);
	l_horario_atual := IFNULL(l_r006hor_aux.HORBU5, 0);
	IF (l_horario_anterior <> l_horario_atual) THEN
		RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 5, l_horario_atual);
  	END IF;
  END LOOP;
  
  /* Apaga Registro OLD/NEW em R006HOR_AUX */
  BEGIN
    DELETE FROM R006HOR_AUX;
    DROP_TEMP_TABLE R006HOR_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ÑÎ␀␀		SENIOR;0␀␀


TRIGGER R006HOR_EU AFTER UPDATE ON R006HOR FOR EACH ROW
DECLARE
  l_Valido BOOLEAN;
  l_DataReferencia DATE;
  l_count_horario NUMBER(2);
  l_erro BOOLEAN;
  l_tipesc   R006ESC.TIPESC%TYPE;
  
  /* Declaracao para criar tabela temporária em SQL Server - Erros de DeadLock */
  CREATE_TEMP_TABLE R006HOR_AUX;
  
BEGIN
  RH_250ALT(33);
   
  /*e-Social*/
  SP_VALUPDATE_NUM(:OLD.CODHOR, :NEW.CODHOR, l_Valido OUT);
  IF (l_Valido = TRUE) THEN	
    l_DataReferencia := CURDATE();
    SP_ESOCIAL_ESCALA(:NEW.CODESC, l_DataReferencia, 'R006HOR', 'A');
  END IF;   
  /*e-Social*/
  
  SP_SAM_PEND_HOR(:NEW.CODESC);
  
	BEGIN
		SELECT TipEsc INTO l_tipesc FROM R006ESC WHERE CODESC = :NEW.CODESC;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_tipesc := 'P';
	END;
	
	IF (l_tipesc = 'B') THEN
      BEGIN
	    /* Insere Registro NEW */
    	/* Preciso guardar os valores old por causa de delete de várias linhas da R006hba.  Num delete multiplo, a r006bha primeiro tem todos seus registros 
    	 * excluídos, somente depois a trigger r006hba_su atualiza por update a r006hor, e faz isto em um update para cada registro deletado. Se eu tivesse 
    	 * o old, não saberia tratar só o campo alterado no update, e os outro campos da r006hor ainda teriam valor e identificariam que a r006hba já está 
    	 * vazia e fariam insert na r006hba indevidamente. */
    	INSERT INTO R006HOR_AUX (CODESC, SEQREG, BU1ANT, BU2ANT, BU3ANT, BU4ANT, BU5ANT, HORBU1, HORBU2, HORBU3, HORBU4, HORBU5)
    	VALUES (:NEW.CODESC,:NEW.SEQREG, :OLD.HORBU1, :OLD.HORBU2, :OLD.HORBU3, :OLD.HORBU4, :OLD.HORBU5, :NEW.HORBU1, :NEW.HORBU2, :NEW.HORBU3, :NEW.HORBU4, :NEW.HORBU5);
  	  EXCEPTION WHEN OTHERS THEN
    	RAISERROR 103 'Erro no INSERT em R006HOR_AUX.';
  	  END;
	END IF;
END␀ÒÎ␀␀	SENIOR;0È␀␀


TRIGGER R006HOR_SD AFTER DELETE ON R006HOR
DECLARE
  /* CURSOR c/ os registros gravados na r006hor_aux */
  CURSOR c_r006hor_aux_del IS SELECT CODESC, SEQREG, HORBU1, HORBU2, HORBU3, HORBU4, HORBU5 FROM R006HOR_AUX;
  
  TYPE t_r006hor_aux IS RECORD(
    CODESC   R006HOR_AUX.CODESC%TYPE,
    SEQREG   R006HOR_AUX.SEQREG%TYPE,
    HORBU1   R006HOR_AUX.HORBU1%TYPE,
    HORBU2   R006HOR_AUX.HORBU2%TYPE,
    HORBU3   R006HOR_AUX.HORBU3%TYPE,
    HORBU4   R006HOR_AUX.HORBU4%TYPE,
    HORBU5   R006HOR_AUX.HORBU5%TYPE);
  l_r006hor_aux t_r006hor_aux;
  l_horario   R006HOR.HorBu1%TYPE;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r006hor_aux_del INTO l_r006hor_aux.CODESC,
    							 l_r006hor_aux.SEQREG,
    							 l_r006hor_aux.HORBU1,
    							 l_r006hor_aux.HORBU2,
    							 l_r006hor_aux.HORBU3,
    							 l_r006hor_aux.HORBU4,
    							 l_r006hor_aux.HORBU5
  LOOP
    RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 1, 0);
    RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 2, 0);
    RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 3, 0);
    RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 4, 0);
    RH_ATUALIZAR006HBA(l_r006hor_aux.CODESC, l_r006hor_aux.SEQREG, 5, 0);
  END LOOP;
  
  /* Apaga Registro OLD/NEW em R006HOR_AUX */
  BEGIN
    DELETE FROM R006HOR_AUX;
    DROP_TEMP_TABLE R006HOR_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ÏÎ␀␀		SENIOR;0A␀␀


