‘␀␀Ñ␀␀␀␀␀␀␀␀Kz”␀␀z”␀␀qC␀êÿ␀␀ÿ␀"oÑ␀␀␀␀␀␀␀␀çJwnwnqC␀êÿ␀␀ÿ␀Î¼␀␀¹␀␀␀␀␀␀␀␀ˆ␀JJQ)␀␀Æÿ␀␀ÿ␀E½␀␀¹␀␀␀␀␀␀␀␀Š␀OOQ)␀␀Æÿ␀␀ÿ␀˜½␀␀¹␀␀␀␀␀␀␀␀‹␀NMQ)␀␀Æÿ␀␀ÿ␀I␀ô␀␀␀␀␀␀␀␀␀␀n␀Æÿ␀␀ÿ␀^␀¬␀␀␀␀␀␀␀³␀La:␀n␀Æÿ␀␀ÿ␀5¼␀␀O␀␀␀␀␀␀␀ÑZ¡¼␀␀¡¼␀␀n␀Æÿ␀␀ÿ␀A␀‘␀␀␀␀␀␀␀␀y$␀b␀c␀h)␀␀Æÿ␀␀ÿ␀EO±␀Ôû/␀␀␀␀␀;␀;␀;q␀Æÿ␀␀ÿ␀]O±␀Ôû/␀␀␀␀␀/;|C€	␀q␀Æÿ␀␀ÿ␀G½␀␀¹␀␀␀␀␀␀␀␀KKKQ)␀␀Æÿ␀␀ÿ␀(␀‘␀␀␀␀␀␀␀␀$␀€!␀€!␀h)␀␀Æÿ␀␀ÿ␀‘␀␀␀␀␀␀␀␀¾ nh)␀␀Æÿ␀␀ÿ␀␀‘␀␀␀␀␀␀␀␀P"␀¦␀¢"␀h)␀␀Æÿ␀␀ÿ␀\␀jÔû/␀␀␀␀␀K␀Í␀J␀p␀Æÿ␀␀Ó␀␀␀H*Ôû/␀␀␀␀␀***␀␀ÿ␀␀Ó␀␀␀␀␀␀0;1;2;39Ô␀␀		SENIOR;0€#␀␀TRIGGER R036PJU_EI AFTER INSERT ON R036PJU FOR EACH ROW

DECLARE
l_DatAtu    DATE;
  l_data_zero DATE;
  L_CODPES      R034FUN.CODPES%TYPE;
  l_EndRua      R033END.ENDRUA%TYPE;
  l_CodCid      R033END.CODCID%TYPE;
  l_CodBai      R033END.CODBAI%TYPE;
  l_EndCep      R033END.ENDCEP%TYPE;
  l_DatAlt      R033END.DATALT%TYPE;
  l_HisCon      R030EMP.HISCON%TYPE;
  l_existe    BOOLEAN;
  L_ULTSEQCON   R033CON.SEQCON%TYPE;
  L_SEQCON      R033CON.SEQCON%TYPE;
  L_CODBAN      R033CON.CODBAN%TYPE;
  L_CODAGE      R033CON.CODAGE%TYPE;
  L_TIPBAN      R033CON.TIPBAN%TYPE;
  L_CONBAN      R033CON.CONBAN%TYPE;
  L_DIGBAN      R033CON.DIGBAN%TYPE;
  L_DATABE      R033CON.DATABE%TYPE;
  L_DATENC      R033CON.DATENC%TYPE;  
  L_TPCPIX      R033PIX.TPCPIX%TYPE;
  L_CHVPIX      R033PIX.CHVPIX%TYPE; 
BEGIN
  BEGIN
    /*Verifca se colaborador tem vínculo com pessoa*/
    SELECT CODPES INTO L_CODPES FROM R036DEP
    WHERE NUMEMP = :NEW.NUMEMP
      AND TIPCOL = :NEW.TIPCOL
      AND NUMCAD = :NEW.NUMCAD
      AND CODDEP = :NEW.CODDEP;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_CODPES := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R036DEP.CODPES';
  END;

  /*Data atual*/
  l_DatAtu := CURDATE();
  /*Data zerada*/
  l_data_zero  := '31/12/1900,00:00:00';

  /*Se existir pessoa vinculada ao dependente atualizar os dados do contato para a pessoa vinculada*/
  IF (L_CODPES > 0) THEN
    BEGIN
      UPDATE R033PES SET
        DDITEL=:NEW.DDITEL,
        DDDTEL=:NEW.DDDTEL,
        NUMTEL=:NEW.NUMTEL
      WHERE CODPES = L_CODPES;
      EXCEPTION WHEN OTHERS THEN
       RAISERROR 103 'Erro ao atualizar R033PES';
    END;

    /**VERIFICA ENDEREÇO*/
    BEGIN
      /*Verifica se endereço já existe na base de endereço da pessoa*/
      SELECT DATALT,ENDRUA,CODCID,CODBAI,ENDCEP
      INTO l_DatAlt,l_EndRua,l_CodCid,l_CodBai,l_EndCep
      FROM R033END
      WHERE CODPES = L_CODPES AND TIPEND = 2 AND DATALT =
      (SELECT MAX(B.DATALT) FROM R033END B WHERE B.CODPES = R033END.CODPES AND B.DATALT <= l_DatAtu);
      EXCEPTION WHEN NO_DATA_FOUND THEN
        l_EndRua := :NEW.RUADEP;
        l_CodCid := :NEW.CODCID;
        l_CodBai := :NEW.CODBAI;
        l_EndCep := :NEW.CODCEP;
        l_DatAlt := l_data_zero;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler R033END';
    END;

    IF (l_DatAtu <> l_DatAlt) THEN
      BEGIN
        /*Se não existir inserir novo endereço para pessoa*/
        INSERT INTO R033END (CODPES,TIPEND,DATALT,ENDRUA,ENDNUM,ENDCPL,CODCID,CODBAI,ENDCEP,EMPAUX,TIPAUX,CADAUX,DEPAUX,COLATI,CANAUX,DATAUX)
                     VALUES (L_CODPES,2,l_DatAtu,l_EndRua,'','',l_CodCid,l_CodBai,l_EndCep,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODDEP,0,0,l_data_zero);
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao inserir na R033END';
      END;
    ELSE
      BEGIN
        /*Se endereço já existir, atualizar*/
        UPDATE R033END SET ENDRUA=l_EndRua,CODCID=l_CodCid,CODBAI=l_CodBai,ENDCEP=l_EndCep
        WHERE (CODPES=L_CODPES) AND (TIPEND=2) AND (DATALT=l_DatAlt);
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar a R033END';
      END;
    END IF;

    BEGIN
      /*Verificar assinalamento de Histórico de contas*/
      SELECT HISCON INTO l_HisCon FROM R030EMP
      WHERE NUMEMP = :NEW.NUMEMP;
      EXCEPTION WHEN NO_DATA_FOUND THEN
        l_HisCon := ' ';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler R030EMP';
    END;

    IF (l_HisCon = 'N') THEN
      /*Se não possúi histórico de contas insere dados da conta na R036PJU*/
      IF (:NEW.CODBAN <> 0) AND (:NEW.CODAGE <> 0) AND (:NEW.CONBAN <> 0) AND (:NEW.TPCTBA <> 0) THEN
        BEGIN
          l_Existe := TRUE;
          /*Verifica se conta já existe para essa pessoa*/
          SELECT SEQCON,  DATALT,  CODBAN,  CODAGE,  CONBAN,  TIPBAN,  DIGBAN
            INTO L_SEQCON,L_DATALT,L_CODBAN,L_CODAGE,L_CONBAN,L_TIPBAN,L_DIGBAN 
            FROM R033CON
           WHERE CODPES = L_CODPES
             AND CODBAN = :NEW.CODBAN
             AND CODAGE = :NEW.CODAGE
             AND DATALT = (SELECT MAX(DATALT) FROM R033CON CON WHERE CON.CODPES = L_CODPES AND CON.DATALT <= l_DatAtu AND CON.CODBAN = :NEW.CODBAN AND CON.CODAGE = :NEW.CODAGE)
			 AND CONBAN = :NEW.CONBAN;
          EXCEPTION WHEN NO_DATA_FOUND THEN
            L_SEQCON := 0;
            L_DATALT := l_DatAtu;
            L_CODBAN := :NEW.CODBAN;
            L_CODAGE := :NEW.CODAGE;
            L_CONBAN := :NEW.CONBAN;
            L_DIGBAN := :NEW.DIGBAN;
            L_TIPBAN := :NEW.TPCTBA;
            l_Existe := FALSE;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler R033CON';
        END;

        IF (l_Existe = TRUE) THEN
          BEGIN
            /*Se conta não existir atualizar data atual e zera a data do encerramento*/
            UPDATE R033CON SET TIPBAN = :NEW.TPCTBA, DIGBAN = :NEW.DIGBAN, DATABE = L_DATATU, DATENC = l_data_zero,
                               EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                               DEPAUX = :NEW.CODDEP, COLATI = 0, CANAUX = 0, DATAUX = l_Data_zero
            WHERE CODPES = L_CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a R033CON';
          END;
        ELSE
          BEGIN
            /*Gera próxima sequência*/
            SELECT IFNULL(MAX(SEQCON),0) INTO L_ULTSEQCON FROM R033CON
            WHERE CODPES = L_CODPES;
            EXCEPTION WHEN NO_DATA_FOUND THEN
              L_ULTSEQCON := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao ler R033CON';
          END;
          L_SEQCON := L_ULTSEQCON + 1;

          BEGIN
            /*Se conta não existir na base, inserir nova conta para a pessoa*/
            INSERT INTO R033CON (CODPES, DATALT, SEQCON, CODBAN, CODAGE, TIPBAN, CONBAN, DIGBAN, DATABE, DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX)
            VALUES (L_CODPES, L_DATALT, L_SEQCON, L_CODBAN, L_CODAGE, L_TIPBAN, L_CONBAN, L_DIGBAN, l_DatAtu, l_data_zero, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODDEP, 0, 0, l_Data_zero);
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao inserir na R033CON';
          END;
        END IF;
      END IF;
    END IF;
    
    /*Chave Pix */
    IF (l_HisCon = 'N') THEN
      /*Se não possúi histórico de contas insere dados da chave pix na R036PJU*/
      IF (:NEW.TPCPIX <> 0) THEN
        BEGIN
          l_Existe := TRUE;
          /*Verifica se conta já existe para essa pessoa*/
          SELECT SEQCON,  DATALT,  TPCPIX,  CHVPIX
            INTO L_SEQCON,L_DATALT,L_TPCPIX,L_CHVPIX 
            FROM R033PIX
           WHERE CODPES = L_CODPES
             AND TPCPIX = :NEW.TPCPIX
             AND CHVPIX = :NEW.CHVPIX
             AND DATALT = (SELECT MAX(DATALT) FROM R033PIX PIX WHERE PIX.CODPES = L_CODPES AND PIX.DATALT <= l_DatAtu AND PIX.TPCPIX = :NEW.TPCPIX AND PIX.CHVPIX = :NEW.CHVPIX);
          EXCEPTION WHEN NO_DATA_FOUND THEN
            L_SEQCON := 0;
            L_DATALT := l_DatAtu;
            L_TPCPIX := :NEW.TPCPIX;
            L_CHVPIX := :NEW.CHVPIX;
            l_Existe := FALSE;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler R033PIX';
        END;

        IF (l_Existe = TRUE) THEN
          BEGIN
            /*Se chave não existir atualizar data atual e zera a data do encerramento*/
            UPDATE R033PIX SET DATABE = L_DATATU, DATENC = l_data_zero,
                               EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                               DEPAUX = :NEW.CODDEP, COLATI = 0, CANAUX = 0, DATAUX = l_Data_zero
            WHERE CODPES = L_CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a R033PIX';
          END;
        ELSE
          BEGIN
            /*Gera próxima sequência*/
            SELECT IFNULL(MAX(SEQCON),0) INTO L_ULTSEQCON FROM R033PIX
            WHERE CODPES = L_CODPES;
            EXCEPTION WHEN NO_DATA_FOUND THEN
              L_ULTSEQCON := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao ler R033PIX';
          END;
          L_SEQCON := L_ULTSEQCON + 1;

          BEGIN
            /*Se chave não existir na base, inserir nova conta para a pessoa*/
            INSERT INTO R033PIX (CODPES, DATALT, SEQCON, DATABE, DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX, TPCPIX, CHVPIX)
            VALUES (L_CODPES, L_DATALT, L_SEQCON, l_DatAtu, l_data_zero, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODDEP, 0, 0, l_Data_zero, L_TPCPIX, l_CHVPIX);
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao inserir na R033PIX';
          END;
        END IF;
      END IF;
    END IF;
  END IF;
END␀:Ô␀␀		SENIOR;0-␀␀

TRIGGER R036PJU_EU AFTER UPDATE ON R036PJU FOR EACH ROW

DECLARE
L_CODPES      R033PES.CODPES%TYPE;
  L_SITAFA      R034FUN.SITAFA%TYPE;
  l_HisCon      R030EMP.HISCON%TYPE;
  L_DEMITIDOS BOOLEAN;

  l_data_zero DATE;
  l_DatAtu    DATE;

  l_EndRua   R033END.ENDRUA%TYPE;
  l_CodCid   R033END.CODCID%TYPE;
  l_CodBai   R033END.CODBAI%TYPE;
  l_EndCep   R033END.ENDCEP%TYPE;
  l_DatAlt   R033END.DATALT%TYPE;
  l_existe    BOOLEAN;
  L_ULTSEQCON   R033CON.SEQCON%TYPE;
  L_SEQCON      R033CON.SEQCON%TYPE;
  L_CODBAN      R033CON.CODBAN%TYPE;
  L_CODAGE      R033CON.CODAGE%TYPE;
  L_TIPBAN      R033CON.TIPBAN%TYPE;
  L_CONBAN      R033CON.CONBAN%TYPE;
  L_DIGBAN      R033CON.DIGBAN%TYPE;
  L_DATABE      R033CON.DATABE%TYPE;
  L_DATENC      R033CON.DATENC%TYPE;
  l_AlterouPessoa BOOLEAN;
  L_TPCPIX      R033PIX.TPCPIX%TYPE;
  L_CHVPIX      R033PIX.CHVPIX%TYPE;
BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_DatAtu := CURDATE();
  BEGIN
    SELECT CODPES INTO L_CODPES FROM R036DEP
    WHERE NUMEMP = :NEW.NUMEMP
      AND TIPCOL = :NEW.TIPCOL
      AND NUMCAD = :NEW.NUMCAD
      AND CODDEP = :NEW.CODDEP;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_CODPES := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R036DEP.CODPES';
  END;

  BEGIN
    SELECT SITAFA INTO L_SITAFA FROM R034FUN
    WHERE NUMEMP = :NEW.NUMEMP
      AND TIPCOL = :NEW.TIPCOL
      AND NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_SITAFA := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R034FUN.SITAFA';
  END;

  IF (L_CODPES>0) THEN

    RH_VERCOLDEM(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,L_CODPES,L_SITAFA,'R036PJU',L_DEMITIDOS OUT);
    IF (L_DEMITIDOS=TRUE) THEN
      l_AlterouPessoa := FALSE;
      IF (:NEW.NUMTEL <> :OLD.NUMTEL) THEN
        BEGIN
          UPDATE R033PES SET NUMTEL = :NEW.NUMTEL WHERE CODPES = L_CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NUMTEL';
        END;
        l_AlterouPessoa := TRUE;
      END IF;
      IF (:NEW.DDITEL <> :OLD.DDITEL) THEN
        BEGIN
          UPDATE R033PES SET DDITEL = :NEW.DDITEL WHERE CODPES = L_CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DDITEL';
        END;
        l_AlterouPessoa := TRUE;
      END IF;
      IF (:NEW.DDDTEL <> :OLD.DDDTEL) THEN
        BEGIN
          UPDATE R033PES SET DDDTEL = :NEW.DDDTEL WHERE CODPES = L_CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DDDTEL';
        END;
        l_AlterouPessoa := TRUE;
      END IF;
      
      IF (l_AlterouPessoa = TRUE) THEN    
	    BEGIN
          UPDATE R033PES SET EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                             DEPAUX = :NEW.CODDEP, COLATI = 0, CANAUX = 0, DATAUX = l_data_zero WHERE CODPES = L_CODPES;
        EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'Erro ao atualizar campos auxiliares da R033PES';
        END;	
	  END IF;
	  
      /**VERIFICA ENDEREÇO**/
      BEGIN
        SELECT DATALT,ENDRUA,CODCID,CODBAI,ENDCEP
        INTO l_DatAlt,l_EndRua,l_CodCid,l_CodBai,l_EndCep
        FROM R033END
        WHERE CODPES = L_CODPES AND TIPEND = 2 AND DATALT =
         (SELECT MAX(B.DATALT) FROM R033END B WHERE B.CODPES = R033END.CODPES AND B.DATALT <= l_DatAtu);
        EXCEPTION WHEN NO_DATA_FOUND THEN
          l_EndRua := ' ';
          l_CodCid := 0;
          l_CodBai := 0;
          l_EndCep := 0;
          l_DatAlt := l_data_zero;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler R033END';
      END;

      IF(:NEW.RUADEP<>:OLD.RUADEP)THEN
        l_EndRua := :NEW.RUADEP;
      END IF;
      IF(:NEW.CODCID<>:OLD.CODCID)THEN
        l_CodCid := :NEW.CODCID;
      END IF;
      IF(:NEW.CODBAI<>:OLD.CODBAI)THEN
        l_CodBai := :NEW.CODBAI;
      END IF;
      IF(:NEW.CODCEP<>:OLD.CODCEP)THEN
        l_EndCep := :NEW.CODCEP;
      END IF;
      IF (l_DatAtu <> l_DatAlt) THEN
        BEGIN
          INSERT INTO R033END (CODPES,TIPEND,DATALT,ENDRUA,ENDNUM,ENDCPL,CODCID,CODBAI,ENDCEP,EMPAUX,TIPAUX,CADAUX,DEPAUX,COLATI,CANAUX,DATAUX)
                       VALUES (L_CODPES,2,l_DatAtu,l_EndRua,'','',l_CodCid,l_CodBai,l_EndCep,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODDEP,0,0,l_data_zero);
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao inserir na R033END';
        END;
      ELSE
        BEGIN
          UPDATE R033END SET ENDRUA=l_EndRua,CODCID=l_CodCid,CODBAI=l_CodBai,ENDCEP=l_EndCep,
                             EMPAUX=:NEW.NUMEMP, TIPAUX=:NEW.TIPCOL, CADAUX=:NEW.NUMCAD, DEPAUX=:NEW.CODDEP, COLATI=0, CANAUX=0, DATAUX=l_data_zero
          WHERE (CODPES=L_CODPES) AND (TIPEND=2) AND (DATALT=l_DatAlt);
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar a R033END';
        END;
      END IF;

      BEGIN
        SELECT HISCON INTO l_HisCon FROM R030EMP
        WHERE NUMEMP = :NEW.NUMEMP;
        EXCEPTION WHEN NO_DATA_FOUND THEN
          l_HisCon := ' ';
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler R030EMP';
      END;

      IF (l_HisCon = 'N') THEN
        BEGIN
          l_Existe := TRUE;
          SELECT
		  R033CON.SEQCON SEQCON,
		  R033CON.DATALT DATALT,
		  R033CON.CODBAN CODBAN,
		  R033CON.CODAGE CODAGE,
		  R033CON.CONBAN CONBAN,
		  R033CON.TIPBAN TIPBAN,
		  R033CON.DIGBAN DIGBAN 
		  INTO L_SEQCON, L_DATALT, L_CODBAN, L_CODAGE, L_CONBAN, L_TIPBAN, L_DIGBAN
            FROM R033CON R033CON
           WHERE CODPES = L_CODPES 
             AND CODBAN = :NEW.CODBAN
             AND CODAGE = :NEW.CODAGE
			 AND CONBAN = :NEW.CONBAN
             AND DATALT = (SELECT MAX(DATALT) COL_02 FROM R033CON CON2 
		     			   WHERE CON2.CODPES = L_CODPES
			 			     AND CON2.DATALT <= l_DatAtu
			 				 AND CON2.CODBAN = :NEW.CODBAN
			 				 AND CON2.CODAGE = :NEW.CODAGE)
			 AND SEQCON = (SELECT MAX(SEQCON) COL_0 FROM R033CON TAB2
						   WHERE TAB2.CODPES = L_CODPES
			 				 AND TAB2.DATALT = (SELECT MAX(DATALT) COL_0 FROM R033CON CON
						   WHERE CON.CODPES = L_CODPES
						     AND CON.DATALT <= l_DatAtu
						     AND CON.CODBAN = :NEW.CODBAN
						     AND CON.CODAGE = :NEW.CODAGE)
						     AND TAB2.CODBAN = :NEW.CODBAN
						     AND TAB2.CODAGE = :NEW.CODAGE
						     AND TAB2.CONBAN = :NEW.CONBAN);
          EXCEPTION WHEN NO_DATA_FOUND THEN
            L_SEQCON := 0;
            L_DATALT := l_DatAtu;
            L_CODBAN := :NEW.CODBAN;
            L_CODAGE := :NEW.CODAGE;
            L_CONBAN := :NEW.CONBAN;
            L_DIGBAN := :NEW.DIGBAN;
            L_TIPBAN := :NEW.TPCTBA;
            l_Existe := FALSE;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler R033CON';
        END;

        IF (l_Existe = TRUE) THEN
          BEGIN
            UPDATE R033CON SET CODBAN = :NEW.CODBAN, CODAGE = :NEW.CODAGE, TIPBAN = :NEW.TPCTBA, CONBAN = :NEW.CONBAN, 
                               DIGBAN = :NEW.DIGBAN, DATABE = L_DATATU, DATENC = l_data_zero,
                               EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                               DEPAUX = :NEW.CODDEP, COLATI = 0, CANAUX = 0, DATAUX = l_Data_zero
            WHERE CODPES = L_CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a R033CON';
          END;
        ELSE
          IF (L_CODBAN <> 0) AND (L_CODAGE <> 0) AND (L_CONBAN <> 0) AND (L_TIPBAN <> 0) THEN
            BEGIN
              SELECT IFNULL(MAX(SEQCON),0) INTO L_ULTSEQCON FROM R033CON
              WHERE CODPES = L_CODPES;
              EXCEPTION WHEN NO_DATA_FOUND THEN
                L_ULTSEQCON := 0;
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao ler R033CON';
            END;
            L_SEQCON := L_ULTSEQCON + 1;

            BEGIN
              INSERT INTO R033CON (CODPES, DATALT, SEQCON, CODBAN, CODAGE, TIPBAN, CONBAN, DIGBAN, DATABE, DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX)
              VALUES (L_CODPES, L_DATALT, L_SEQCON, L_CODBAN, L_CODAGE, L_TIPBAN, L_CONBAN, L_DIGBAN, l_DatAtu, l_data_zero, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODDEP, 0, 0, l_Data_zero);
              EXCEPTION WHEN OTHERS THEN
                RAISERROR 103 'Erro ao inserir na R033CON';
            END;
          END IF;
        END IF;
      END IF;
      
      /*chave pix */
      IF (l_HisCon = 'N') THEN
        BEGIN
          l_Existe := TRUE;
          SELECT
		  R033PIX.SEQCON SEQCON,
		  R033PIX.DATALT DATALT,
		  R033PIX.TPCPIX TPCPIX,
		  R033PIX.CHVPIX CHVPIX
		  INTO L_SEQCON,L_DATALT,L_TPCPIX,L_CHVPIX 
            FROM R033PIX R033PIX
           WHERE CODPES = L_CODPES 
             AND TPCPIX = :NEW.TPCPIX
             AND CHVPIX = :NEW.CHVPIX
             AND DATALT = (SELECT MAX(DATALT) COL_02 FROM R033PIX PIX2 
		     			   WHERE PIX2.CODPES = L_CODPES
			 			     AND PIX2.DATALT <= l_DatAtu
			 				 AND PIX2.TPCPIX = :NEW.TPCPIX
			 				 AND PIX2.CHVPIX = :NEW.CHVPIX)
			 AND SEQCON = (SELECT MAX(SEQCON) COL_0 FROM R033PIX TAB2
						   WHERE TAB2.CODPES = L_CODPES
			 				 AND TAB2.DATALT = (SELECT MAX(DATALT) COL_0 FROM R033PIX PIX
						   WHERE PIX.CODPES = L_CODPES
						     AND PIX.DATALT <= l_DatAtu
						     AND PIX.TPCPIX = :NEW.TPCPIX
						     AND PIX.CHVPIX = :NEW.CHVPIX)
						     AND TAB2.TPCPIX = :NEW.TPCPIX
						     AND TAB2.CHVPIX = :NEW.CHVPIX);
          EXCEPTION WHEN NO_DATA_FOUND THEN
            L_SEQCON := 0;
            L_DATALT := l_DatAtu;
            L_TPCPIX := :NEW.TPCPIX;
            L_CHVPIX := :NEW.CHVPIX;
            l_Existe := FALSE;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler R033PIX';
        END;

        IF (l_Existe = TRUE) THEN
          BEGIN
            UPDATE R033PIX SET DATABE = L_DATATU, DATENC = l_data_zero,
                               EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                               DEPAUX = :NEW.CODDEP, COLATI = 0, CANAUX = 0, DATAUX = l_Data_zero
            WHERE CODPES = L_CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a R033PIX';
          END;
        ELSE
          IF (L_TPCPIX <> 0)  THEN
            BEGIN
              SELECT IFNULL(MAX(SEQCON),0) INTO L_ULTSEQCON FROM R033PIX
              WHERE CODPES = L_CODPES;
              EXCEPTION WHEN NO_DATA_FOUND THEN
                L_ULTSEQCON := 0;
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao ler R033PIX';
            END;
            L_SEQCON := L_ULTSEQCON + 1;

            BEGIN
              INSERT INTO R033PIX (CODPES, DATALT, SEQCON, DATABE, DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX, TPCPIX, CHVPIX)
              VALUES (L_CODPES, L_DATALT, L_SEQCON, l_DatAtu, l_data_zero, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODDEP, 0, 0, l_Data_zero, L_TPCPIX, L_CHVPIX);
              EXCEPTION WHEN OTHERS THEN
                RAISERROR 103 'Erro ao inserir na R033PIX';
            END;
          END IF;
        END IF;
      END IF;
    END IF;
  END IF;
END␀␀␀|¼␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀8Ô␀␀…¬␀␀´␀␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t␀␀␀␀␀␀␀}␀t␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀␀␀␀␀␀␀␀P%€$0.w␀Æÿ␀␀ÿ␀c,­␀␀␀␀␀␀␀␀H@NS}Sp␀Æÿ␀␀ÿ␀­␀
