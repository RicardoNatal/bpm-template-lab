SP_CONCATENAR_DES
SP_ESOCIAL_INFO
SP_TREINA_ESOCIAL
W␀␀PROCEDURE RH_PEN_ANOTACAO (P_LAYOUT VARCHAR2(6), P_TIPOESOCIAL NUMBER, P_EMPRESA NUMBER, P_TIPCOLABORADOR NUMBER,
	P_COLABORADOR NUMBER, P_DATAANOTACAO DATE, P_SEQUENCIAANOTACAO NUMBER, P_EVENTO VARCHAR2(2),
	P_JSONCAMPOSALT VARCHAR2(2000), P_ORIGEM VARCHAR2(60)) IS

	l_Where VARCHAR(2000);
	l_layoutAlteracaoContrato VARCHAR2(6);
	l_TipoEsocialStr VARCHAR(11);
	l_ProximaData DATE;
	l_EmpresaStr VARCHAR(11);
	l_TipColaboradorStr VARCHAR(11);
	l_ColaboradorStr VARCHAR(11);
	l_Valor VARCHAR2(2000);
	l_DataInicioTabelas DATE;
	l_DataInicioEsocial DATE;
	l_DataInicioNaoPeriodicos DATE;
	l_DataInicioPeriodicos DATE;
	l_DataInicioSST DATE;
	l_infoFacult BOOLEAN;
    l_SimplificaoESocial BOOLEAN;
    l_VersaoESocial NUMBER;
BEGIN
/*Somente anotações com o tipo 7, 8 e 10 são validas
	7 -> Somente válida para S-2306 
	7 - 10 -> Somente válida para S-2206
	8 -> Somente válida para S-2205	  
	*/
	l_infoFacult := TRUE;
    l_SimplificaoESocial := FALSE;
    l_VersaoESocial := 0;
    
    SP_ESOCIAL_INFO(p_Empresa, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
    
	IF ((p_TipoEsocial = 7) OR (p_TipoEsocial = 8) OR (p_TipoEsocial = 10)) THEN
		l_ProximaData := '31/12/1900,00:00:00';
		l_TipoEsocialStr := CONVERT(NUMBER_TO_CHAR, p_TipoEsocial);
		l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, p_Empresa);
		l_TipColaboradorStr := CONVERT(NUMBER_TO_CHAR, p_TipColaborador);
		l_ColaboradorStr := CONVERT(NUMBER_TO_CHAR, p_Colaborador);

		/*  Se o tipo eSocial da anotação for igual a 8 gera alteração para o leiaute S-2205*/
		IF (p_TipoEsocial = 8) THEN
			l_layoutAlteracaoContrato := 'S-2205';
		ELSE
		/*  Se o tipo eSocial da anotação for igual a 7 e o Colaborador
     	    foi enviado com o leiaute S-2300 gera alteração para o leiaute S-2306 */
			IF (p_layout = 'S-2300') THEN
				IF (p_TipoEsocial = 7) THEN
					RH_LAYOUT_ALT_CONT(p_layout, l_layoutAlteracaoContrato OUT);
				END IF;
			END IF;

			/*  Se o tipo eSocial da anotação for igual a 7 ou 10 e o Colaborador
     	    foi enviado com o leiaute S-2200 gera alteração para o leiaute S-2206*/
			IF (p_layout = 'S-2200') THEN
				IF ((p_TipoEsocial = 10) OR (p_TipoEsocial = 7)) THEN
					RH_LAYOUT_ALT_CONT(p_layout, l_layoutAlteracaoContrato OUT);
				END IF;
			END IF;
		END IF;

		IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
			l_Where := ' R022NOT.CODNOT = R038NOT.TIPNOT AND R022NOT.TPESOC = ' || l_TipoEsocialStr || ' AND R038NOT.NUMEMP = ' || l_EmpresaStr || ' AND R038NOT.TIPCOL = ' || l_TipColaboradorStr || ' AND R038NOT.NUMCAD = ' || l_ColaboradorStr;
			/*Busca período do mesmo TPESOC da R022NOT */
			SP_PROXHIST_NPER('R038NOT.DATNOT', ' R038NOT, R022NOT ', l_Where, p_DataAnotacao, l_ProximaData OUT);
			SP_CONCATENAR_NUM('TPESOC', p_TipoEsocial, l_Valor OUT);
			SP_CONCATENAR_NUM('SEQNOT', p_SequenciaAnotacao, l_Valor OUT);

			SP_TAB_ESOCIAL(l_layoutAlteracaoContrato, p_Empresa, p_TipColaborador, p_Colaborador, p_DataAnotacao, l_ProximaData, 'R038NOT', p_Evento, l_Valor, P_JSONCAMPOSALT, 0, P_ORIGEM);

			IF (p_TipoEsocial = 10) THEN
				l_Valor := '';
				SP_CONCATENAR_NUM('TIPCOL', P_TIPCOLABORADOR, l_Valor OUT);
				SP_CONCATENAR_NUM('NUMCAD', P_COLABORADOR, l_Valor OUT);
				SP_CONCATENAR_DAT('DATALT', P_DATAANOTACAO, l_Valor OUT);

				SP_ESOCIAL_1050(P_EMPRESA, 'R038NOT', 'A', l_Valor, P_JSONCAMPOSALT, 0, P_ORIGEM);
			END IF;

		END IF;
	ELSE
		IF (p_TipoEsocial = 11) THEN
			/* Para anotações do tipo 11, o tratamento é diferenciado, pois vai para o eSocial todas anotações e não apenas a última */
			IF (p_layout = 'S-2200') THEN
				SP_CONCATENAR_NUM('TPESOC', p_TipoEsocial, l_Valor OUT);
				SP_CONCATENAR_NUM('SEQNOT', p_SequenciaAnotacao, l_Valor OUT);
				RH_LAYOUT_ALT_CONT(p_layout, l_layoutAlteracaoContrato OUT);

				SP_TAB_ESOCIAL(l_layoutAlteracaoContrato, p_Empresa, p_TipColaborador, p_Colaborador, p_DataAnotacao, NULL, 'R038NOT', p_Evento, l_Valor, P_JSONCAMPOSALT, 0, P_ORIGEM);
			END IF;
		ELSE
			IF ((p_TipoEsocial = 12) OR (p_TipoEsocial = 13)) THEN				
				 IF (l_SimplificaoESocial = TRUE AND p_layout = 'S-2200') THEN  
					 SP_CONCATENAR_NUM('TPESOC', p_TipoEsocial, l_Valor OUT); 
					 SP_CONCATENAR_NUM('SEQNOT', p_SequenciaAnotacao, l_Valor OUT); 
					 SP_CONCATENAR_DAT('DATNOT', p_DataAnotacao, l_Valor OUT); 

					 RH_LAYOUT_ALT_CONT(p_layout, l_layoutAlteracaoContrato OUT);
					 SP_TREINA_ESOCIAL(l_layoutAlteracaoContrato, p_Empresa, p_TipColaborador, p_Colaborador, p_DataAnotacao, p_DataAnotacao, 'R038NOT', p_Evento, l_Valor, P_JSONCAMPOSALT, 0, P_ORIGEM);
	            END IF; 
			END IF;
		END IF;
	END IF; 
END␀‡ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Y␀␀PROCEDURE RH_QTDHISCCF(P_NUMCAN NUMBER(7),P_CODCUF NUMBER(4),P_PERINI DATE,P_SEQCCF NUMBER(2),P_NROHIS OUT NUMBER(3))
 IS

l_CufDef         R000ASS.CUFDEF%TYPE;
BEGIN
  BEGIN
    SELECT IFNULL(CUFDEF, 0) INTO l_CufDef FROM R000ASS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_CufDef := 0;
  END;

  BEGIN
    SELECT IFNULL(COUNT(*),0) INTO p_NroHis FROM R122CCF, R000ASS
     WHERE NUMCAN = p_NumCan AND CODCUF = p_CodCuf
       AND PERINI = p_PerIni AND SEQCCF <> p_SeqCcf
       AND CODCUF <> l_CufDef;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      p_NroHis := 0;
  END;
END␀ˆì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
(␀␀/* Verifica se existe algum Histórico de Curso duplicado e retorna quantidade */
