	l_DatAux DATE;
	
	CURSOR C_EMPRESAS IS 
	SELECT DISTINCT NumEmp 
	FROM R583FIL 
	WHERE CodPRA = :NEW.CodPRA
	ORDER BY NumEmp;
BEGIN 
	SM_ESOCIAL_ATIVO(l_EsocialAtivo OUT);
	IF (l_EsocialAtivo = TRUE) THEN
		/* Deve gerar pendência apenas se a situação da revisão de GHE for 1 - Ativa */
		IF (:NEW.SitEso = 1) THEN
			l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
			
			l_DataInicio := :NEW.DatIni;
			l_DataTermino := :NEW.DatTer;
			
			SP_CONCATENAR_NUM('CODPRA', :NEW.CodPRA, l_Json OUT);
			SP_CONCATENAR_NUM('CODGHE', :NEW.CodGHE, l_Json OUT);
			SP_CONCATENAR_DES('REVGHE', :NEW.RevGHE, l_Json OUT);
			
			FOREACH C_EMPRESAS INTO l_NumEmp
			LOOP
				RH_RET_DATINISST(l_NumEmp, l_DatIniSST OUT);
				IF (l_DatIniSST > l_DataZero) THEN
					IF (l_DataTermino > l_DatIniSST OR l_DataTermino = l_DataZero) THEN
						IF (l_DataInicio < l_DatIniSST) THEN
							l_DataInicio := l_DatIniSST;
						END IF;
		  							
						SP_E_SOCIAL_SM('S-2240', 'R583REV', 'N', 'I', l_DataInicio, l_DataTermino, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DataInicio, 0, 'R583REV_EI');
					END IF;
				END IF;
			END LOOP;
		END IF;
	END IF;
END␀Fê␀␀		SENIOR;0¼␀␀

TRIGGER R583REV_EU AFTER UPDATE ON R583REV FOR EACH ROW
DECLARE
	l_EsocialAtivo BOOLEAN;
	l_AlterouCampo BOOLEAN;
	l_AlterouInfoRevisao BOOLEAN;
	l_AlterouInicio BOOLEAN;
	l_DataZero DATE;
	l_DatIniSST DATE;
	l_DataInicio DATE;
	l_DataTermino DATE;
	l_DataAux DATE;
	l_Json VARCHAR2(2000);
	l_NumEmp   R583FIL.NumEmp%TYPE;
	l_LigAmb   R000SEG.LigAmb%TYPE;
	l_JsonAlteracao VARCHAR2(2000);
	
	CURSOR C_EMPRESAS IS
	SELECT DISTINCT NumEmp
	FROM R583FIL
	WHERE CodPRA = :NEW.CodPRA
	ORDER BY NUMEMP;
BEGIN
	/* Busca definição se ligação do ambiente de trabalho é por GHE ou direto no colaborador */
	BEGIN
		SELECT LIGAMB INTO l_LigAmb FROM R000SEG;
	EXCEPTION
		WHEN OTHERS THEN
			l_LigAmb := 0;
	END;
	
	l_JsonAlteracao := '';

	SM_ESOCIAL_ATIVO(l_EsocialAtivo OUT);
	IF (l_EsocialAtivo = TRUE) THEN
		l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
		
		l_AlterouInfoRevisao := FALSE;
		l_AlterouInicio := FALSE;
		
		SP_VALUPDATE_NUM(:OLD.SitEso, :NEW.SitEso, l_AlterouCampo OUT);
		IF (l_AlterouCampo = TRUE) THEN
			l_AlterouInfoRevisao := TRUE;
			SP_CONCAT_NUM_JSON('SITESO', :NEW.SitEso, :OLD.SitEso, l_JsonAlteracao OUT);
		END IF;
		
		/* Verifica se alterou alguma informação apenas se a situação da revisão de GHE for 1 - Ativa */
		IF (:NEW.SitEso = 1) THEN
		  	SP_VALUPDATE_DAT(:OLD.DatIni, :NEW.DatIni, l_AlterouCampo OUT);
			IF (l_AlterouCampo = TRUE) THEN
				l_AlterouInicio := TRUE;
				SP_CONCAT_DAT_JSON('DATINI', :NEW.DatIni, :OLD.DatIni, l_JsonAlteracao OUT);
			END IF;
		  	
			/* Verifica se alterou ambiente apenas quando a ligação do ambiente com colaborador for através do(s) GHE(s) */
			IF (l_LigAmb = 1) THEN
				SP_VALUPDATE_NUM(:OLD.NumAmb, :NEW.NumAmb, l_AlterouCampo OUT);
				IF (l_AlterouCampo = TRUE) THEN
					l_AlterouInfoRevisao := TRUE;
					SP_CONCAT_NUM_JSON('NUMAMB', :NEW.NumAmb, :OLD.NumAmb, l_JsonAlteracao OUT);
				END IF;
			END IF;
			
			SP_VALUPDATE_DES(:OLD.AtiRis, :NEW.AtiRis, l_AlterouCampo OUT);
			IF (l_AlterouCampo = TRUE) THEN
				l_AlterouInfoRevisao := TRUE;
				SP_CONCAT_DES_JSON('ATIRIS', 'O texto do campo Atividades de Risco foi alterado.', 'O texto do campo Atividades de Risco foi alterado.', l_JsonAlteracao OUT);
			END IF;
		END IF;
		
		IF (l_AlterouInfoRevisao = TRUE OR l_AlterouInicio = TRUE ) THEN
			SP_CONCATENAR_NUM('CODPRA', :NEW.CodPRA, l_Json OUT);
			SP_CONCATENAR_NUM('CODGHE', :NEW.CodGHE, l_Json OUT);
			SP_CONCATENAR_DES('REVGHE', :NEW.RevGHE, l_Json OUT);
		
			FOREACH C_EMPRESAS INTO l_NumEmp
			LOOP
				RH_RET_DATINISST(l_NumEmp, l_DatIniSST OUT);
				IF (l_DatIniSST > l_DataZero) THEN
					IF (:NEW.DatTer > l_DatIniSST OR :OLD.DatTer > l_DatIniSST OR :NEW.DatTer = l_DataZero OR :OLD.DatTer = l_DataZero) THEN
						IF (l_AlterouInfoRevisao = TRUE) THEN
							l_DataInicio := :NEW.DatIni;
							IF (:NEW.DatIni < l_DatIniSST) THEN
								l_DataInicio := l_DatIniSST;
							END IF;
							
					  		IF (:OLD.DatTer < :NEW.DatTer) THEN
					  			l_DataTermino := :OLD.DatTer;
					  		ELSE
					  			l_DataTermino := :NEW.DatTer;
					  		END IF;
					  		
					  		SP_E_SOCIAL_SM('S-2240', 'R583REV', 'N', 'A', l_DataInicio, l_DataTermino, l_NumEmp, 0, 0, l_Json, l_JsonAlteracao, 0, NULL, l_DataInicio, 0, 'R583REV_EU');
						END IF;
						
						IF (l_AlterouInicio = TRUE) THEN
							IF (:NEW.DatIni > :OLD.DatIni) THEN
								/* Se aumentou a data de início, cria uma pendência da data de início antiga até a data de início nova */
								l_DataInicio := :OLD.DatIni;
								l_DataTermino := DATETIMEADD(DD, -1, :NEW.DatIni);
								SP_E_SOCIAL_SM('S-2240', 'R583REV', 'N', 'A', l_DataInicio, l_DataTermino, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DataInicio, 0, 'R583REV_EU');
								
								/* Cria também uma pendência para a nova data de início informada */
								l_DataAux := :NEW.DatIni;
								SP_E_SOCIAL_SM('S-2240', 'R583REV', 'N', 'A', l_DataAux, l_DataAux, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DataAux, 0, 'R583REV_EU');
							ELSE
								/* Se diminiu a data de início, cria uma pendência da nova data início até a data de início antiga */
								l_DataInicio := :NEW.DatIni;
								l_DataTermino := DATETIMEADD(DD, -1, :OLD.DatIni);
								SP_E_SOCIAL_SM('S-2240', 'R583REV', 'N', 'A', l_DataInicio, l_DataTermino, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DataInicio, 0, 'R583REV_EU');								
							END IF;
						END IF;
					END IF;
				END IF;
			END LOOP;
		END IF;
	END IF;
END␀Dê␀␀		SENIOR;0i␀␀

