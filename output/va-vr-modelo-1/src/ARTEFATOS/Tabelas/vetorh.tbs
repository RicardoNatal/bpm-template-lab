  l_datenv        CHAR(16);
  l_coddsp        CHAR(9);
  l_tipope        CHAR(1);
BEGIN
  /*Envia para todas as centralizadoras*/
  l_CenPen := '0';

    /*verifica se existe alguma centralizadora gerenciada pela Senior*/
    SP_GERSEN(l_gersen OUT);

    IF  (l_gersen = TRUE) THEN
         /*Obtem a data/hora de envio da pendência.*/
        l_data_atual := CURDATE();
        l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
        SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
        SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
        /*Obtem o Segundo*/
        l_seqenv := SECOND(CURTIME());
        SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
        l_datenv := l_datstr||l_horstr||l_seqstr||'0000';
        /*Código do Dispositivo*/
        SP_INTSTR(:OLD.CODDSP,'999999999',l_coddsp OUT);
        /*Tipo Operação - 2=Incluir/Alterar - 3=Excluir*/
        l_tipope := '3';

        l_StrAux := '71'||l_datenv||l_tipope||l_coddsp;
        SP_PorCom(l_StrAux, l_CenPen);
    END IF;
END␀␀␀8:␀␀␀␀␀␀␀„ê␀␀	␀­␀	␀␀␀␀␀␀L␀␀;␀␀A␀␀p␀Æÿ␀␀‡ê␀␀␀'&·␀	␀␀␀␀␀␀6:5:6:s␀Æÿ␀␀€ê␀␀␀m,Ì␀	␀␀␀␀␀␀N@N@N@{␀Æÿ␀␀…×␀␀␀5-·␀␀␀␀␀␀␀\A“␀“␀s␀Æÿ␀␀ë×␀␀␀x-·␀␀␀␀␀␀␀@¥.¥.u␀Æÿ␀␀Ø␀␀␀'=	␀␀␀␀␀:':';'c␀␀␀ÿ␀␀ÿN␀␀␀0;1;2␀␀::␀␀␀␀␀␀␀…ê␀␀	␀­␀	␀␀␀␀␀␀L␀␀;␀␀A␀␀p␀Æÿ␀␀‡ê␀␀␀'&·␀	␀␀␀␀␀␀6:5:6:s␀Æÿ␀␀€ê␀␀␀m,Ì␀	␀␀␀␀␀␀N@N@N@{␀Æÿ␀␀…×␀␀␀›c±␀␀␀␀␀␀␀ŞcÃcİcq␀Æÿ␀␀ÿ␀5-·␀␀␀␀␀␀␀\A“␀“␀s␀Æÿ␀␀ë×␀␀␀x-·␀␀␀␀␀␀␀@¥.¥.u␀Æÿ␀␀Ø␀␀␀␀␀␀0;1;2␀␀9:␀␀␀␀␀␀␀†ê␀␀	␀­␀	␀␀␀␀␀␀L␀␀;␀␀A␀␀p␀Æÿ␀␀‡ê␀␀␀.`␀␀␀␀␀␀“¯␀␀ŠcÅc#␀␀ÿ␀␀ÿ␀Í§␀␀4␀␀␀␀␀␀Ñ©␀␀n¨␀␀o¨␀␀8␀␀ÿ␀␀ÿ␀¢Ã␀␀·␀␀␀␀␀␀␀¿Ã␀␀¿Ã␀␀¿Ã␀␀s␀Æÿ␀␀ÿ␀M␀!␀␀␀␀␀␀â©␀␀m␀¨␀␀*␀␀ÿ␀␀ÿ␀sû␀␀!␀␀␀␀␀␀ºû␀␀û␀␀«û␀␀*␀␀ÿ␀␀ÿ␀°k␀␀␀␀␀␀»k±k±kp␀Æÿ␀␀ÿ␀³’␀␀=␀␀␀␀␀␀“␀␀õ’␀␀“␀␀c␀␀␀ÿ␀␀ÿN¬␀·␀␀␀␀␀␀␀³␀²␀´␀s␀Æÿ␀␀ÿ00250ªÃ␀␀·␀␀␀␀␀␀␀ÁÃ␀␀ÁÃ␀␀ÁÃ␀␀s␀Æÿ␀␀ÿ00000­ò␀␀␀␀␀␀␀␀Mó␀␀Ló␀␀Ló␀␀#␀␀ÿ␀␀ÿ␀YË␀␀␀␀␀␀␀␀Ë␀␀ŒË␀␀ŒË␀␀␀␀ÿ␀␀ÿ␀5—␀␀±␀␀␀␀␀␀␀÷—␀␀í—␀␀í—␀␀q␀Æÿ␀␀ÿ000␀␀␀0␀␀[␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ˆê␀␀]½␀␀‹␀	␀␀␀␀␀␀␀¢Š␀␀HŠ␀␀^Š␀␀—)␀␀Æÿ␀␀ÿ␀	␀­␀	␀␀␀␀␀␀␀L␀␀;␀␀A␀␀p␀Æÿ␀␀ÿ␀M␀!␀␀␀␀␀␀␀â©␀␀m␀¨␀␀*␀␀ÿ␀␀ÿ␀sû␀␀!␀␀␀␀␀␀␀ºû␀␀û␀␀«û␀␀*␀␀ÿ␀␀ÿ␀␀␀␀0;1␀␀ø␀␀␀␀␀␀‰ê␀␀”-D	Ôÿ?␀␀␀␀␀ÿ@±;±;R␀␀ÿ␀␀ÿ␀ê+±␀	Ôÿ?␀␀␀␀␀#>T«:q␀Æÿ␀␀ÿ␀¥E·␀	Ôÿ?␀␀␀␀␀ÿ␀␀xş␀␀xş␀␀s␀Æÿ␀␀ÿ␀NE=Ôÿ?␀␀␀␀␀ÿCüCüC<␀␀ÿ␀␀ÿ␀ÀE=Ôÿ?␀␀␀␀␀ıCüCüC<␀␀ÿ␀␀ÿ␀␀␀␀0;1;2␀␀!␀␀␀␀␀Šê␀␀’␀=Ôû?␀␀␀␀␀E␀E␀E␀c␀␀