/* Trigger Insert - Statement */
TRIGGER R038HVI_SI AFTER INSERT ON R038HVI

DECLARE
/* CURSOR c/ os registros gravados no R038HVI_AUX */
  CURSOR c_r038hvi_ins IS
    SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, CODVIN FROM R038HVI_AUX;

  TYPE t_r038HVI_aux IS RECORD(
    NUMEMP   R038HVI_AUX.NUMEMP%TYPE,
    TIPCOL   R038HVI_AUX.TIPCOL%TYPE,
    NUMCAD   R038HVI_AUX.NUMCAD%TYPE,
    DATALT   R038HVI_AUX.DATALT%TYPE,
    CODVIN   R038HVI_AUX.CODVIN%TYPE);

  l_r038HVI_aux t_r038HVI_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r038hvi_ins INTO  l_r038HVI_aux.NUMEMP,
                              l_r038HVI_aux.TIPCOL,
                              l_r038HVI_aux.NUMCAD,
                              l_r038HVI_aux.DATALT,
                              l_r038HVI_aux.CODVIN
  LOOP
    /* Atualiza o Quadro Efetivo - QL */
    QL_INCVINCULO(l_r038HVI_aux.NumEmp, l_r038HVI_aux.TipCol, l_r038HVI_aux.NumCad, l_r038HVI_aux.DatAlt, l_r038HVI_aux.CodVin, l_r038HVI_aux.DatAlt, l_r038HVI_aux.CodVin);
  END LOOP;

  /* Apaga Registro OLD em R038HVI_AUX */
  BEGIN
    DELETE FROM R038HVI_AUX;
  EXCEPTION
    WHEN OTHERS THEN
      NULL;
  END;
END␀@Õ␀␀		SENIOR;0¸␀␀

TRIGGER R038HVI_EI AFTER INSERT ON R038HVI FOR EACH ROW
DECLARE
    l_datvin DATE;
    l_comando_nulo BOOLEAN;
    l_layoutAlteracaoContrato VARCHAR2(6);
    l_temAud       BOOLEAN;
    l_codRPA       NUMBER(15);
    l_codSistema   NUMBER(2);
    l_codcpa       NUMBER(4);
    l_codtpa       NUMBER(4);
    l_datTemp      VARCHAR(10);	
	l_TelTra VARCHAR2(1);
	l_CodVin NUMBER(2);
	l_DatTerVinAnt DATE;
	l_DatTerHist DATE;
	l_DatAltHistAnt DATE;
	l_DatAltProxHist DATE;
	l_DataZero DATE;
BEGIN
	IF :NEW.STAHIS = 1 THEN
		BEGIN
			SELECT R034FUN.DATVIN INTO l_datvin
			FROM R034FUN
			WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
				R034FUN.NUMEMP = :NEW.NUMEMP AND
				R034FUN.NUMCAD = :NEW.NUMCAD;
		EXCEPTION WHEN OTHERS THEN
			l_comando_nulo:=TRUE;
		END;

		IF (:NEW.DATALT >= l_datvin) OR (l_datvin IS NULL) THEN
			UPDATE R034FUN
			SET CODVIN = :NEW.CODVIN,
				DATVIN = :NEW.DATALT
			WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
				R034FUN.NUMEMP = :NEW.NUMEMP AND
				R034FUN.NUMCAD = :NEW.NUMCAD;
		END IF;
	END IF;

	BEGIN
		/* Insere Registro Old */
		INSERT INTO R038HVI_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, CODVIN, STAHIS)
		VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, :NEW.CODVIN, :NEW.STAHIS);
	EXCEPTION WHEN OTHERS THEN
		RAISERROR 103 'Erro no INSERT em R038HVI_AUX.';
	END;

	/* eSocial */ 
	RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT); 
	IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
		SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038HVI', 'DATALT', 'I', '', '', 0, 'R038HVI_EI');
	END IF;
	/* eSocial */
	
  /* Inicio - Geração de logs HistoricoVinculo*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 79;     /* HistoricoVinculo*/
  l_codtpa := 269;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HVI_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HVI_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODVIN', CONVERT(NUMBER_TO_CHAR, :NEW.CODVIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
      END;
  END IF; 	
  /* Fim - Geração de logs HistoricoVinculo*/
  	
  /* Tratamento para criação de histórico de anotação referente ao teletrabalho (home office) - INÍCIO */
  
  l_DataZero := '31/12/1900,00:00:00';
  
  /* Busca o código do vínculo anterior do colaborador */
  l_DatTerVinAnt := DATETIMEADD(DD, -1, :NEW.DatAlt);
  RH_RETVINCOL(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_DatTerVinAnt, 'A', l_DatAltHistAnt OUT, l_CodVin OUT);
	
  /* Verifica necessidade de criar um histórico de anotação informando fim de teletrabalho referente ao último vínculo */
  IF (l_CodVin > 0) THEN
  	RH_INSNOTTELTRA(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_DatTerVinAnt, l_CodVin, 6);
  END IF;
  
  /* Verifica necessidade de criar um histórico de anotação informando início de teletrabalho referente ao novo vínculo */
  RH_INSNOTTELTRA(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, :NEW.DatAlt, :NEW.CodVin, 5);
  
  /* Busca a data de início do próximo histórico de vínculo após o histórico que está sendo incluído */
  RH_RETVINCOL(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, :NEW.DatAlt, 'P', l_DatAltProxHist OUT, l_CodVin OUT);
  
  /* Verifica se já tem um histórico iniciando após este que está incluído para criar uma anotação referente ao término */
  IF (l_DatAltProxHist > l_DataZero) THEN
  	/* Inclui o histórico de anotação referente ao término de teletrabalho */
  	l_DatTerHist := DATETIMEADD(DD, -1, l_DatAltProxHist);
  	RH_INSNOTTELTRA(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_DatTerHist, :NEW.CodVin, 6);
  END IF;
	
  /* Tratamento para criação de histórico de anotação referente ao teletrabalho (home office) - FIM */
END␀DÕ␀␀	SENIOR;0␀␀

/* Trigger Update - Statement */
TRIGGER R038HVI_SU AFTER UPDATE ON R038HVI

DECLARE
/* CURSOR c/ os registros gravados no R038HVI_AUX */
  CURSOR c_r038HVI_upd IS
    SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, CODVIN, EMPOLD, TIPOLD, CADOLD, DATOLD, VINOLD
      FROM R038HVI_AUX WHERE (CODVIN <> VINOLD);

  TYPE t_r038HVI_aux IS RECORD(
    NUMEMP   R038HVI_AUX.NUMEMP%TYPE,
    TIPCOL   R038HVI_AUX.TIPCOL%TYPE,
    NUMCAD   R038HVI_AUX.NUMCAD%TYPE,
    DATALT   R038HVI_AUX.DATALT%TYPE,
    CODVIN   R038HVI_AUX.CODVIN%TYPE,
    EMPOLD   R038HVI_AUX.EMPOLD%TYPE,
    TIPOLD   R038HVI_AUX.TIPOLD%TYPE,
    CADOLD   R038HVI_AUX.CADOLD%TYPE,
    DATOLD   R038HVI_AUX.DATOLD%TYPE,
    VINOLD   R038HVI_AUX.VINOLD%TYPE
    );

  xR038HVI_aux t_r038HVI_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r038HVI_upd INTO  xR038HVI_aux.NUMEMP,
                              xR038HVI_aux.TIPCOL,
                              xR038HVI_aux.NUMCAD,
                              xR038HVI_aux.DATALT,
                              xR038HVI_aux.CODVIN,
                              xR038HVI_aux.EMPOLD,
                              xR038HVI_aux.TIPOLD,
                              xR038HVI_aux.CADOLD,
                              xR038HVI_aux.DATOLD,
                              xR038HVI_aux.VINOLD
  LOOP
    /* Atualiza o Quadro Efetivo - QL */
    QL_EXCVINCULO(xR038HVI_aux.EmpOld, xR038HVI_aux.TipOld, xR038HVI_aux.CadOld, xR038HVI_aux.DatOld, xR038HVI_aux.VinOld, xR038HVI_aux.DatAlt, xR038HVI_aux.CodVin);

    QL_INCVINCULO(xR038HVI_aux.NumEmp, xR038HVI_aux.TipCol, xR038HVI_aux.NumCad, xR038HVI_aux.DatAlt, xR038HVI_aux.CodVin, xR038HVI_aux.DatAlt, xR038HVI_aux.CodVin);
  END LOOP;

  /* Apaga registros da R038HVI_AUX */
  BEGIN
    DELETE FROM R038HVI_AUX;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na exclusão dos registros da R038HVI_AUX';
  END;
END␀AÕ␀␀		SENIOR;0-␀␀

TRIGGER R038HVI_EU AFTER UPDATE ON R038HVI FOR EACH ROW
DECLARE
	l_datvin DATE;
	l_comando_nulo BOOLEAN;
	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_layoutAlteracaoContrato VARCHAR2(6);
    l_temAud       BOOLEAN;
    l_codRPA       NUMBER(15);
    l_codSistema   NUMBER(2);
    l_codcpa       NUMBER(4);
    l_codtpa       NUMBER(4);
    l_datTemp      VARCHAR(10);
    l_TelTraOld VARCHAR(1);
    l_TelTraNew VARCHAR(1);
    l_DatTerHist DATE;
	l_DatAltProxHist DATE;
	l_DataZero DATE;
	l_CodVin NUMBER(2);
	l_JsonCamposAlterados VARCHAR2(2000);
BEGIN
	IF :NEW.STAHIS = 1 THEN
		BEGIN
			SELECT R034FUN.DATVIN INTO l_datvin
			FROM R034FUN
			WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
				R034FUN.NUMEMP = :NEW.NUMEMP AND
				R034FUN.NUMCAD = :NEW.NUMCAD;
		EXCEPTION WHEN OTHERS THEN
			l_comando_nulo:=TRUE;
		END;

		IF (:NEW.datalt >= l_datvin) OR (l_datvin IS NULL) THEN
			UPDATE R034FUN
			SET CODVIN = :NEW.CODVIN,
			DATVIN = :NEW.DATALT
			WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
				R034FUN.NUMEMP = :NEW.NUMEMP AND
				R034FUN.NUMCAD = :NEW.NUMCAD;
		END IF;
	END IF;

	/* Insere registro na AUX para processar rotina do QL */
	BEGIN
		INSERT INTO R038HVI_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, CODVIN, EMPOLD, TIPOLD, CADOLD, DATOLD, VINOLD, STAHIS)
		VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, :NEW.CODVIN, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, :OLD.CODVIN, :NEW.STAHIS);
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro no INSERT do Registro NEW na R038HVI_AUX.';
	END;

	/* eSocial */
	l_Alterou := FALSE;
	l_JsonCamposAlterados := '';

	SP_VALUPDATE_NUM(:OLD.CODVIN, :NEW.CODVIN, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_NUM_JSON('CODVIN', :NEW.CodVin, :OLD.CODVIN, l_JsonCamposAlterados OUT);
	END IF;

	IF (l_Alterou = TRUE) THEN 
		RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT); 
		IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
			SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038HVI', 'DATALT', 'A', '', '', 0, 'R038HVI_EU');
		END IF; 	
	END IF;
	/* eSocial */
	
  /* Inicio - Geração de logs HistoricoVinculo*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 79;     /* HistoricoVinculo*/
  l_codtpa := 270;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.CodVin <> :NEW.CodVin)
   OR (:OLD.StaHis <> :NEW.StaHis)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HVI_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HVI_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODVIN', CONVERT(NUMBER_TO_CHAR, :OLD.CODVIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODVIN', CONVERT(NUMBER_TO_CHAR, :NEW.CODVIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSTAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSTAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
      END;
    END IF; 
  END IF; 
  /* Fim - Geração de logs HistoricoVinculo*/

  /* Tratamento para exclusão de histórico de anotação referente ao teletrabalho (home office) - INÍCIO */
  
  l_DataZero := '31/12/1900,00:00:00';
  
  IF (:OLD.CodVin <> :NEW.CodVin) THEN
  
   	/* Busca a informação do campo Teletrabalho (Home Office) do vínculo que estava informado anteriormente */
    BEGIN		
	  SELECT TelTra INTO l_TelTraOld
	    FROM R022VIN
	   WHERE R022VIN.CodVin = :OLD.CodVin;
    EXCEPTION
	  WHEN OTHERS THEN
	    l_TelTraOld := 'N';
    END;
  	
    /* Busca a informação do campo Teletrabalho (Home Office) do novo vínculo informado */
    BEGIN		
	  SELECT TelTra INTO l_TelTraNew
	    FROM R022VIN
	   WHERE R022VIN.CodVin = :NEW.CodVin;
    EXCEPTION
	  WHEN OTHERS THEN
	    l_TelTraNew := 'N';
    END;
    
    /* Se o vínculo anterior se refere a teletrabalho e o novo não se refere a teletrabalho, exclui os históricos de anotação referente ao início e término de teletrabalho */  
    IF ((l_TelTraOld = 'S') AND ((l_TelTraNew <> 'S') OR (l_TelTraNew IS NULL))) THEN
      
      /* Exclui o histórico de anotação referente ao início de teletrabalho */
      RH_DELNOTTELTRA(:OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, :OLD.DatAlt, 5);
      
      /* Busca a data de início do próximo histórico de vínculo após o histórico que está sendo alterado */
      RH_RETVINCOL(:OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, :OLD.DatAlt, 'P', l_DatAltProxHist OUT, l_CodVin OUT);
      
      IF (l_DatAltProxHist > l_DataZero) THEN
      	/* Exclui o histórico de anotação referente ao término de teletrabalho */
      	l_DatTerHist := DATETIMEADD(DD, -1, l_DatAltProxHist);
      	RH_DELNOTTELTRA(:OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, l_DatTerHist, 6);
      END IF;
      
    END IF;
    
    /* Se o novo vínculo se refere a teletrabalho e o anterior não se refere a teletrabalho, cria os históricos de anotação referente ao início e término de teletrabalho */
    IF ((l_TelTraNew = 'S') AND ((l_TelTraOld <> 'S') OR (l_TelTraOld IS NULL))) THEN
  	
  	  /* Cria o histórico de anotação referente ao início do teletrabalho */
  	  RH_INSNOTTELTRA(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, :NEW.DatAlt, :NEW.CodVin, 5);
  		
  	  /* Busca a data de início do próximo histórico de vínculo após o histórico que está sendo alterado */
  	  RH_RETVINCOL(:OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, :OLD.DatAlt, 'P', l_DatAltProxHist OUT, l_CodVin OUT);
  
  	  /* Verifica se já tem um histórico iniciando após este que está incluído para criar uma anotação referente ao término */
  	  IF (l_DatAltProxHist > l_DataZero) THEN
  	  	/* Exclui o histórico de anotação referente ao término de teletrabalho */
  	  	l_DatTerHist := DATETIMEADD(DD, -1, l_DatAltProxHist);
  	  	RH_INSNOTTELTRA(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_DatTerHist, :NEW.CodVin, 6);
  	  END IF;
  		
    END IF;
    
  END IF;
  
  /* Tratamento para exclusão de histórico de anotação referente ao teletrabalho (home office) - FIM */
END␀BÕ␀␀	SENIOR;0±␀␀TRIGGER R038HVI_SD AFTER DELETE ON R038HVI

DECLARE
l_codvin       NUMBER(2);
  l_datvin       DATE;

  /* CURSOR c/ os registros gravados no R038HVI_AUX */
  CURSOR c_r038HVI_del IS SELECT NUMEMP,TIPCOL,NUMCAD,DATALT,CODVIN,STAHIS FROM R038HVI_AUX;

  TYPE t_r038HVI_aux IS RECORD(
    NUMEMP   R038HVI_AUX.NUMEMP%TYPE,
    TIPCOL   R038HVI_AUX.TIPCOL%TYPE,
    NUMCAD   R038HVI_AUX.NUMCAD%TYPE,
    DATALT   R038HVI_AUX.DATALT%TYPE,
    CODVIN   R038HVI_AUX.CODVIN%TYPE,
    STAHIS   R038HVI_AUX.STAHIS%TYPE);

  l_r038HVI_aux t_r038HVI_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r038HVI_del INTO  l_r038HVI_aux.NUMEMP,
                              l_r038HVI_aux.TIPCOL,
                              l_r038HVI_aux.NUMCAD,
                              l_r038HVI_aux.DATALT,
                              l_r038HVI_aux.CODVIN,
                              l_r038HVI_aux.STAHIS
  LOOP
    IF l_r038HVI_aux.STAHIS = 1 THEN
      SELECT CODVIN, DATVIN INTO l_codvin, l_datvin FROM R034FUN
       WHERE NUMEMP = l_r038HVI_aux.NUMEMP AND TIPCOL = l_r038HVI_aux.TIPCOL AND NUMCAD = l_r038HVI_aux.NUMCAD;

      IF (l_r038HVI_aux.CODVIN = l_codvin) AND (l_r038HVI_aux.DATALT = l_datvin) THEN
        /* Pega o historico anterior */
        BEGIN
          SELECT A.CODVIN,A.DATALT
          INTO l_codvin,l_datvin
          FROM R038HVI A
          WHERE A.NUMEMP = l_r038HVI_aux.NUMEMP
          AND   A.TIPCOL = l_r038HVI_aux.TIPCOL
          AND   A.NUMCAD = l_r038HVI_aux.NUMCAD
          AND   A.STAHIS = 1
          AND DATALT IN (SELECT MAX(DATALT) FROM R038HVI
                         WHERE NUMEMP = l_r038HVI_aux.NUMEMP
                         AND   TIPCOL = l_r038HVI_aux.TIPCOL
                         AND   NUMCAD = l_r038HVI_aux.NUMCAD
                         AND   STAHIS = 1);
        EXCEPTION
          WHEN TOO_MANY_ROWS THEN
            RAISERROR 103 'Erro em R038HVI - TOO MANY ROWS';
          WHEN NO_DATA_FOUND THEN
            l_codvin:=0;
            l_datvin:='31/12/1900,00:00:00';
          WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT R038HLO';
        END;

        /* Atualiza tabela de colaboradores */
        BEGIN
          UPDATE R034FUN
             SET CODVIN = l_codvin,
                 DATVIN = l_datvin
           WHERE R034FUN.TIPCOL = l_r038HVI_aux.TIPCOL AND
                 R034FUN.NUMEMP = l_r038HVI_aux.NUMEMP AND
                 R034FUN.NUMCAD = l_r038HVI_aux.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro Na Atualização do R034FUN';
        END;
      END IF;
    END IF;

    /* Atualiza o Quadro Efetivo - QL */
    QL_EXCVINCULO(l_r038HVI_aux.NumEmp, l_r038HVI_aux.TipCol, l_r038HVI_aux.NumCad, l_r038HVI_aux.DatAlt, l_r038HVI_aux.CodVin, l_r038HVI_aux.DatAlt, 0);
  END LOOP;

  /* Apaga Registro OLD em R038HVI_AUX */
  BEGIN
    DELETE FROM R038HVI_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀?Õ␀␀		SENIOR;0€␀␀

TRIGGER R038HVI_ED AFTER DELETE ON R038HVI FOR EACH ROW
DECLARE
	l_layoutAlteracaoContrato VARCHAR2(6);
	l_temAud       BOOLEAN;
    l_codRPA       NUMBER(15);
    l_codSistema   NUMBER(2);
    l_codcpa       NUMBER(4);
    l_codtpa       NUMBER(4);
    l_datTemp      VARCHAR(10);
    l_TelTra VARCHAR(1);
    l_DatAltProxHist DATE;
    l_DatTerHist DATE;
    l_DatTerHistAnt DATE;
    l_DataZero DATE;
    l_CodVin NUMBER(2);
BEGIN
	BEGIN
		/* Insere Registro Old */
		INSERT INTO R038HVI_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, CODVIN, STAHIS)
		VALUES (:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, :OLD.CODVIN, :OLD.STAHIS);
	EXCEPTION WHEN OTHERS THEN
		RAISERROR 103 'Erro no INSERT em R038HVI_AUX.';
	END;

	/* eSocial */ 
	RH_LAY_CONTR_COLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layoutAlteracaoContrato OUT);    
	IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
		SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, 'R038HVI', 'DATALT', 'E', '', '', 0, 'R038HVI_ED');
	END IF;
	/* eSocial */
	
  /* Inicio - Geração de logs HistoricoVinculo*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 79;     /* HistoricoVinculo*/
  l_codtpa := 269;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HVI_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HVI_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODVIN', CONVERT(NUMBER_TO_CHAR, :OLD.CODVIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
      END;
  END IF; 
  /* Fim - Geração de logs HistoricoVinculo*/
  
  /* Tratamento para exclusão de histórico de anotação referente ao teletrabalho (home office) - INÍCIO */
  
  l_DataZero := '31/12/1900,00:00:00';
  
  /* Exclui o histórico de anotação referente ao término do teletrabalho, caso tenha */
  l_DatTerHistAnt := DATETIMEADD(DD, -1, :OLD.DatAlt);
  RH_DELNOTTELTRA(:OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, l_DatTerHistAnt, 6);
  
  /* Busca a informação do campo Teletrabalho (Home Office) do cadastro do vínculo informado */
  BEGIN		
	SELECT TelTra INTO l_TelTra
	  FROM R022VIN
	 WHERE R022VIN.CodVin = :OLD.CodVin;
  EXCEPTION
	WHEN OTHERS THEN
	  l_TelTra := 'N';
  END;
  
  /* Se o vínculo do histórico excluído estava definido como Teletrabalho = Sim, exclui os históricos de anotação do colaborador referentes ao assunto */
  IF (l_TelTra = 'S') THEN
  
    /* Exclui o histórico de anotação referente ao início de teletrabalho */
    RH_DELNOTTELTRA(:OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, :OLD.DatAlt, 5);
  
    /* Busca a data de início do próximo histórico de vínculo após o histórico que está sendo excluído */
    RH_RETVINCOL(:OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, :OLD.DatAlt, 'P', l_DatAltProxHist OUT, l_CodVin OUT);
  
  	IF (l_DatAltProxHist > l_DataZero) THEN
      /* Exclui o histórico de anotação referente ao término de teletrabalho */
      l_DatTerHist := DATETIMEADD(DD, -1, l_DatAltProxHist);
      RH_DELNOTTELTRA(:OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, l_DatTerHist, 6);
    END IF;
    
  END IF;
  
  /* Tratamento para exclusão de histórico de anotação referente ao teletrabalho (home office) - FIM */
    
END␀␀␀°v␀␀␀␀␀␀>Õ␀␀…¬␀␀´␀Ôï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀tÔï!␀␀␀␀␀Ü␀t␀Ü␀nˆ␀Æÿ␀␀ÿ␀c¬␀␀Ì␀Ôï!␀␀␀␀␀.%0.0.wˆ␀Æÿ␀␀ÿ␀mDÑ␀Ôï!␀␀␀␀␀LIşEşEqCˆ␀êÿ␀␀ÿ␀İ-­␀Ôï!␀␀␀␀␀␀š(␀š(␀pİ‡␀Æÿ␀␀ÿ␀␀b´␀Ôï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀Û␀tÔï!␀␀␀␀␀Ü␀t␀Ü␀nˆ␀Æÿ␀␀ÿ␀Z$Ì␀Ôï!␀␀␀␀␀.%0.0.wˆ␀Æÿ␀␀ÿ␀MEÑ␀Ôï!␀␀␀␀␀LIşEşEqCˆ␀êÿ␀␀ÿ␀ì&␀­␀Ôï!␀␀␀␀␀␀š(␀š(␀pİ‡␀Æÿ␀␀ÿ␀*␀áÔÿ/␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀␀␀␀±v␀␀␀␀␀␀␀␀␀␀␀␀EÕ␀␀…¬␀␀´␀	Ôÿ1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ1␀␀␀␀␀Ü␀t␀Ü␀nû‡␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ1␀␀␀␀␀$0.0.wñ‡␀Æÿ␀␀…Ó␀␀␀dDÑ␀	Ôÿ1␀␀␀␀␀æLZ”␀␀óEqCò‡␀êÿ␀␀NÔ␀␀␀Mw·␀	Ôÿ1␀␀␀␀␀Âyxxì*␀ö‡␀Æÿ␀␀RÔ␀␀␀xı␀␀´␀	Ôÿ1␀␀␀␀␀‚ÿ␀␀xş␀␀xş␀␀r␀Æÿ␀␀ÿ␀yDÑ␀Ôÿ1␀␀␀␀␀MÙEÙEqC␀êÿ␀␀ÿ
31/12/1900V‹␀␀Ò␀Ôÿ1␀␀␀␀␀ìììÿ␀ÿÿ␀␀ÿ␀¸ToÔÿ1␀␀␀␀␀İX°V°Vi␀␀ÿ␀␀ÿ␀+§␀␀9Ôÿ1␀␀␀␀␀¨␀␀¨␀␀¨␀␀:␀␀ÿ␀␀ÿ␀×-‹␀”ú1␀␀␀␀␀œAm␀‘A—)␀␀Æÿ␀␀nC␀␀␀␀0;1;2;3;4;5GÕ␀␀		SENIOR;0␀␀/* INSERT (NEW) */
TRIGGER R038IMA_EI AFTER INSERT ON R038IMA FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs HistoricoAfastamentosDocumentos*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 72;     /* HistoricoAfastamentosDocumentos*/
  l_codtpa := 255;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038IMA_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAFA', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORAFA', CONVERT(NUMBER_TO_CHAR, :NEW.HORAFA));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQIMG', CONVERT(NUMBER_TO_CHAR, :NEW.SEQIMG));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038IMA_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:NEW.DATARQ, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATARQ', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESIMG', :NEW.DESIMG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMARQ', :NEW.NOMARQ);
      END;
  END IF; 
END␀HÕ␀␀		SENIOR;0Ì
␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R038IMA_EU AFTER UPDATE ON R038IMA FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs HistoricoAfastamentosDocumentos*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 72;     /* HistoricoAfastamentosDocumentos*/
  l_codtpa := 256;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatAfa <> :NEW.DatAfa)
   OR (:OLD.HorAfa <> :NEW.HorAfa)
   OR (:OLD.SeqImg <> :NEW.SeqImg)
   OR (:OLD.DatArq <> :NEW.DatArq)
   OR (:OLD.DesImg <> :NEW.DesImg)
   OR (:OLD.NomArq <> :NEW.NomArq)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038IMA_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAFA', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORAFA', CONVERT(NUMBER_TO_CHAR, :OLD.HORAFA));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQIMG', CONVERT(NUMBER_TO_CHAR, :OLD.SEQIMG));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038IMA_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:OLD.DATARQ, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATARQ', l_datTemp);
        SP_DATSTR(:NEW.DATARQ, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATARQ', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDESIMG', :OLD.DESIMG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDESIMG', :NEW.DESIMG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOMARQ', :OLD.NOMARQ);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNOMARQ', :NEW.NOMARQ);
      END;
    END IF; 
  END IF; 
END␀FÕ␀␀		SENIOR;0␀␀ 

