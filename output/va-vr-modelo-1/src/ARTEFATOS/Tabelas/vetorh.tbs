DECLARE
l_crafis    NUMBER(12);
    l_desMot    VARCHAR2(30);
BEGIN
    /* busca número de crachá fisico caso exista. */
    SP_RETFIS(:NEW.NUMCRA,0, l_crafis OUT);
    AtuSitCra('1',l_crafis);

    /* Envia pendência para informar sobre crachá extraviado */
    IF  (:NEW.MotCex = '') THEN
        l_desMot := '';
    ELSE
        l_desMot := SUBSTRING(:NEW.MotCex,1,30);
    END IF;
    SP_PEND83(:NEW.NUMCRA, 2, 1, l_desMot);
END␀İ␀␀		SENIOR;0X␀␀

TRIGGER R090CEX_ED AFTER DELETE ON R090CEX FOR EACH ROW

DECLARE
l_crafis    NUMBER(12);
BEGIN
    /* busca número de crachá fisico caso exista. */
    SP_RETFIS(:OLD.NUMCRA,0, l_crafis OUT);

    AtuSitCra('0',l_crafis);

    /* Envia pendência para informar sobre crachá extraviado */
    SP_PEND83(:OLD.NUMCRA, 3, 1, '');
