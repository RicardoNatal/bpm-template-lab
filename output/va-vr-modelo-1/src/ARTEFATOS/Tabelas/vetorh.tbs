          END;
      END IF;
    END IF;
  END IF;

  IF  l_codmot <> 0 THEN
      IF  (l_codmot=l_blofal) AND (p_tipcol < 4) THEN
          p_sitblo := 'F';
      ELSE
          p_sitblo := '1';
      END IF;
  ELSE
      p_sitblo := '0';
  END IF;
END		SENIOR;21
