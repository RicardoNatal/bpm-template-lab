		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWUSARFA', l_r034DAC.USARFA);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWUSARFA)';
				END;
		END IF;
		
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONREE', l_r034DAC.CONREE);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDCONREE)';
				END;
		END IF;
		IF (:OLD.CONREE <> :NEW.CONREE AND l_r034EDP.CONREE <> 3) THEN /* NAO EXISTE EXCECAO. LOGO, SUBSTITUO PELO VALOR VINDO DO POSTO. */
			IF (l_oridef = 1) THEN /* CONTROLA REENTRADA VEM SOMENTE DO POSTO PRINICPAL */
				l_r034DAC.CONREE := :NEW.CONREE;
				l_r034EDP.CONREE := l_oridef;
			END IF;
		END IF;
		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONREE', l_r034DAC.CONREE);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWCONREE)';
				END;
		END IF;		

		IF (l_temAud > 0) THEN
				BEGIN
						l_prmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.CODPRM);
						l_prmSTR := LTRIM(l_prmSTR);
						l_prmSTR := RTRIM(l_prmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPRM', l_prmSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDCODPRM)';
				END;
				
				BEGIN
						l_prmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.PRMFER);
						l_prmSTR := LTRIM(l_prmSTR);
						l_prmSTR := RTRIM(l_prmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRMFER', l_prmSTR);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDPRMFER)';
				END;
				
				BEGIN
						l_prmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.PRMSAB);
						l_prmSTR := LTRIM(l_prmSTR);
						l_prmSTR := RTRIM(l_prmSTR);
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRMSAB', l_prmSTR);
