  l_seqstr             CHAR(2);
  l_datenv             CHAR(16);
  l_tipcol             CHAR(1);
  l_idtpesAux          CHAR(23);
  l_idtPes_trim        VARCHAR2(23);
  l_icard              CHAR(12);
  l_crapro             NUMBER(12);
  l_numemp             NUMBER(4);
  l_tipcol_int         NUMBER(1);
  l_numcad             NUMBER(10);
  /*Consistência do campo nome*/
  l_NomFunOriginal     VARCHAR2(40);
