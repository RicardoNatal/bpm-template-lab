PROCEDURE SP_PEND82(P_IDTPES CHAR(23),P_TIPOPE CHAR(1))
 IS

  l_data_atual         DATE;
  l_hora_atual         NUMBER(4);
  l_seqenv             NUMBER(2);
  l_datstr             CHAR(6);
  l_horstr             CHAR(4);
  l_seqstr             CHAR(2);
  l_datenv             CHAR(16);
  l_tipope             CHAR(1);
  l_Straux             VARCHAR2(2047);
BEGIN
    /*Inicializações*/
    /*Obtem a data/hora de envio da pendência.*/
    l_data_atual := CURDATE();
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
    SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
    /*Obtem o Segundo*/
    l_seqenv := SECOND(CURTIME());
    SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
    l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

	SP_INTSTR(p_tipope, '9', l_tipope OUT);	
	
    l_StrAux := '82'||l_datenv||p_idtpes||l_tipope;
   
    /*Pendência R070ADM*/
    SP_PorCom(l_straux,'0');
END		SENIOR;21!SP_DATSTR
SP_INTSTR
SP_PORCOM
