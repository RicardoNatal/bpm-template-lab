TRIGGER R110HIP_EI AFTER INSERT ON R110HIP FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRpa       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

	l_codSistema := 1;
	l_codcpa := 144;
	l_codtpa := 419;
	/* INSERT (NEW) */ 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110HIP_EI', '');

      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIC));
        SP_DATSTR(:NEW.DATIMP, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATIMP', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORIMP', CONVERT(NUMBER_TO_CHAR, :NEW.HORIMP));        
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110HIP_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      
      BEGIN
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR, :NEW.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMSOL', :NEW.NOMSOL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'JUSIMP', :NEW.JUSIMP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCPF', :NEW.NUMCPF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPES', CONVERT(NUMBER_TO_CHAR, :NEW.CODPES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPOS', CONVERT(NUMBER_TO_CHAR, :NEW.CODPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSLOC', CONVERT(NUMBER_TO_CHAR, :NEW.POSLOC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PROENT', :NEW.PROENT);
      END;
  END IF; 
END␀]ß␀␀		SENIOR;0␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R110HIP_EU AFTER UPDATE ON R110HIP FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  l_codSistema := 1;  
  l_codcpa := 144;    
  l_codtpa := 420;    
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFic <> :NEW.CodFic)
   OR (:OLD.DatImp <> :NEW.DatImp)
   OR (:OLD.HorImp <> :NEW.HorImp)
   OR (:OLD.CodAte <> :NEW.CodAte)
   OR (:OLD.NomSol <> :NEW.NomSol)
   OR (:OLD.JusImp <> :NEW.JusImp)
   OR (:OLD.NumCpf <> :NEW.NumCpf)
   OR (:OLD.CodPes <> :NEW.CodPes)
   OR (:OLD.CodPos <> :NEW.CodPos)
   OR (:OLD.PosLoc <> :NEW.PosLoc)
   OR (:OLD.ProEnt <> :NEW.ProEnt)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110HIP_EU', '');

      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIC));
        SP_DATSTR(:OLD.DATIMP, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATIMP', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORIMP', CONVERT(NUMBER_TO_CHAR, :OLD.HORIMP));      
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110HIP_EU: Erro ao alterar registros chave para a tabela de log de auditoria R995PRC.';
      END;
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODATE', CONVERT(NUMBER_TO_CHAR, :OLD.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODATE', CONVERT(NUMBER_TO_CHAR, :NEW.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOMSOL', :OLD.NOMSOL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNOMSOL', :NEW.NOMSOL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDJUSIMP', :OLD.JUSIMP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWJUSIMP', :NEW.JUSIMP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMCPF', :OLD.NUMCPF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMCPF', :NEW.NUMCPF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPES', CONVERT(NUMBER_TO_CHAR, :OLD.CODPES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPES', CONVERT(NUMBER_TO_CHAR, :NEW.CODPES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPOS', CONVERT(NUMBER_TO_CHAR, :OLD.CODPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPOS', CONVERT(NUMBER_TO_CHAR, :NEW.CODPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPOSLOC', CONVERT(NUMBER_TO_CHAR, :OLD.POSLOC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPOSLOC', CONVERT(NUMBER_TO_CHAR, :NEW.POSLOC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPROENT', :OLD.PROENT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPROENT', :NEW.PROENT);
      END;
    END IF; 
  END IF; 
END␀[ß␀␀		SENIOR;0À␀␀

