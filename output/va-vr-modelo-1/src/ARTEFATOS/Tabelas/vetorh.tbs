V␀␀PROCEDURE SP_AUDITORIA_34CPL(P_CODRPA NUMBER(15), P_OLDDES VARCHAR2(255), P_OLDVALOR VARCHAR2(255), P_NEWDES VARCHAR2(255), P_NEWVALOR VARCHAR2(255))
 IS
BEGIN
	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (P_CODRPA, P_OLDDES, P_OLDVALOR);
	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (P_CODRPA, P_NEWDES, P_NEWVALOR);
END␀÷÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
‚␀␀PROCEDURE SP_AUDI_34CPL_NUMB(P_CODRPA NUMBER(15), P_OLDDES VARCHAR2(255), P_OLDVALOR NUMBER(15), P_NEWDES VARCHAR2(255), P_NEWVALOR NUMBER(15))
 IS
BEGIN
	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (P_CODRPA, P_OLDDES, CONVERT(NUMBER_TO_CHAR, P_OLDVALOR));
	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (P_CODRPA, P_NEWDES, CONVERT(NUMBER_TO_CHAR, P_NEWVALOR));
END␀ø÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
