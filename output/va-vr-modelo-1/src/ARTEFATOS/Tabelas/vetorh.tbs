            BEGIN
              UPDATE R070CON SET PRMRT1 = CONVERT(CHAR_TO_NUMBER, l_grupo1), DINPR1 = l_inigr1, DFNPR1 = l_fimgr1,
                                 PRMRT2 = CONVERT(CHAR_TO_NUMBER, l_grupo2), DINPR2 = l_inigr2, DFNPR2 = l_fimgr2,
                                 PRMRT3 = CONVERT(CHAR_TO_NUMBER, l_grupo3), DINPR3 = l_inigr3, DFNPR3 = l_fimgr3
                                 WHERE NUMFIS = l_crapri;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'R070PEC_ATUCON: Erro Na Atualização da tabela R070CON.';
            END;
            /*Atualiza os crachás secundários da R070CON*/
            SP_UPDPRM(l_cracha,0,0,0,0,l_grupo1,l_grupo2,l_grupo3);

            BEGIN
                SELECT IDTPES INTO l_idtpes FROM R070CON WHERE NUMCRA = l_cracha AND NUMFIS = l_crapri;
            EXCEPTION
              WHEN OTHERS THEN
                NULL;
            END;
       END IF;     
       BEGIN
         DELETE FROM R070PEC_AUX
         WHERE NUMEMP = l_r070pec_aux.NUMEMP AND
               TIPCOL = l_r070pec_aux.TIPCOL AND
               NUMCAD = l_r070pec_aux.NUMCAD AND
               DATINI = l_r070pec_aux.DATINI AND
               HORINI = l_r070pec_aux.HORINI;
       EXCEPTION
         WHEN OTHERS THEN
           NULL;
       END;

  END LOOP;
END␀`Ú␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_RECALF_PRMCOL
œ␀␀PROCEDURE R070PEC_RECALF
 IS


  /* CURSOR c/ os registros gravados no R070PEC_API */
  CURSOR c_r070pec_ins IS SELECT NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI FROM R070PEC_API;
  TYPE t_r070pec_api IS RECORD(
    NUMEMP   R070PEC_API.NUMEMP%TYPE,
    TIPCOL   R070PEC_API.TIPCOL%TYPE,
    NUMCAD   R070PEC_API.NUMCAD%TYPE,
    DATINI   R070PEC_API.DATINI%TYPE,
    HORINI   R070PEC_API.HORINI%TYPE);

  l_r070pec_api t_r070pec_api;

BEGIN

    /* Le Registro do CURSOR */
    FOREACH c_R070PEC_ins INTO  l_r070pec_api.NUMEMP,
                                l_r070pec_api.TIPCOL,
                                l_r070pec_api.NUMCAD,
                                l_r070pec_api.DATINI,
                                l_r070pec_api.HORINI
    LOOP

        /* Verifica se tem que incluir ou excluir o credenciamento da pessoa na ADE02. */
        SP_RECALF_PRMCOL(l_r070pec_api.NUMEMP, l_r070pec_api.TIPCOL, l_r070pec_api.NUMCAD, 0, 0, 0, 0, NULL, NULL, NULL, NULL, NULL, NULL);

        BEGIN
            DELETE FROM R070PEC_API
                  WHERE NUMEMP = l_r070pec_api.NUMEMP AND
                        TIPCOL = l_r070pec_api.TIPCOL AND
                        NUMCAD = l_r070pec_api.NUMCAD AND
                        DATINI = l_r070pec_api.DATINI AND
                        HORINI = l_r070pec_api.HORINI;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;
    END LOOP;
END␀eÚ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
°PROCEDURE R070PEO_ATUCON
 IS
BEGIN
  /* Apaga Registro OLD/NEW em R070PEO_AUX */
  BEGIN
    DELETE FROM R070PEO_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END		SENIOR;20XSP_RETCRA
