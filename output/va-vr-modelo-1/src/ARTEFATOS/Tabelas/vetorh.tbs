DECLARE
l_DataZero   DATE;
  l_data_fim   DATE;
BEGIN
l_DataZero := '31/12/1900,00:00:00';
l_data_fim := :NEW.DATFIM;
IF   (l_data_fim = l_DataZero) THEN
     l_data_fim := '04/06/2080,00:00:00';
END IF;

BEGIN
UPDATE R066APU SET DIAALT = 7
       WHERE NUMEMP = :NEW.NUMEMP AND
             TIPCOL = :NEW.TIPCOL AND
             NUMCAD = :NEW.NUMCAD AND
             DATAPU >= :NEW.DATINI AND
             DATAPU <= l_data_fim AND
             HORDAT > 9995;
EXCEPTION WHEN OTHERS THEN
  NULL;
END;
END␀©Ø␀␀		SENIOR;0A␀␀

TRIGGER R064PFO_EU AFTER UPDATE ON R064PFO FOR EACH ROW 

DECLARE
l_DataZero    DATE;
  l_data_fim    DATE;
BEGIN
/* Na Alteração do Registro seta todo o periodo como alterado */
/* Também verifica a Data Final                               */
l_DataZero := '31/12/1900,00:00:00';
IF   ((:OLD.DATFIM = l_DataZero) OR (:NEW.DATFIM = l_DataZero)) THEN
     l_data_fim := '04/06/2080,00:00:00';
ELSIF (:NEW.DATFIM > :OLD.DATFIM) THEN
     l_data_fim := :NEW.DATFIM;
ELSE l_data_fim := :OLD.DATFIM;
END IF;

BEGIN
UPDATE R066APU SET DIAALT = 7
       WHERE NUMEMP = :NEW.NUMEMP AND
             TIPCOL = :NEW.TIPCOL AND
             NUMCAD = :NEW.NUMCAD AND
             DATAPU >= :NEW.DATINI AND
             DATAPU <= l_data_fim AND
             HORDAT > 9995;
EXCEPTION WHEN OTHERS THEN
  NULL;
END;
END␀§Ø␀␀		SENIOR;0K␀␀

TRIGGER R064PFO_ED AFTER DELETE ON R064PFO FOR EACH ROW

DECLARE
l_DataZero   DATE;
  l_data_fim   DATE;
BEGIN
l_DataZero := '31/12/1900,00:00:00';
l_data_fim := :OLD.DATFIM;
IF   (l_data_fim = l_DataZero) THEN
     l_data_fim := '04/06/2080,00:00:00';
END IF;

BEGIN
UPDATE R066APU SET DIAALT = 7
       WHERE NUMEMP = :OLD.NUMEMP AND
             TIPCOL = :OLD.TIPCOL AND
             NUMCAD = :OLD.NUMCAD AND
             DATAPU >= :OLD.DATINI AND
             DATAPU <= l_data_fim AND
             HORDAT > 9995;
EXCEPTION WHEN OTHERS THEN
  NULL;
END;
END␀␀␀Ç␀␀␀␀␀␀␀␀␀ªØ␀␀…¬␀␀´␀	„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	„␀␀␀␀␀␀Ü␀t␀Ü␀n@‰␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	„␀␀␀␀␀␀$0.0.w=‰␀Æÿ␀␀…Ó␀␀␀¬[Ñ␀	„␀␀␀␀␀␀M*_MqC>‰␀êÿ␀␀ÿ␀­[Ñ␀„␀␀␀␀␀␀M+_MqC?‰␀êÿ␀␀ÿ␀␀Ã„␀␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3°Ø␀␀	SENIOR;0²␀␀

TRIGGER R064PON_SI AFTER INSERT ON R064PON

DECLARE
l_online       BOOLEAN;
/* CURSOR c/ os registros gravados no R064PON_AUX */
  CURSOR c_r064pon_ins IS SELECT NUMEMP, TIPCOL, NUMCAD, DiaHo1, DiaHo2, STAACC FROM R064PON_AUX;
  TYPE t_r064PON_aux IS RECORD(
    NUMEMP   R064PON_AUX.NumEmp%TYPE,
    TIPCOL   R064PON_AUX.TipCol%TYPE,
    NUMCAD   R064PON_AUX.NumCad%TYPE,
    DiaHo1   R064PON_AUX.DiaHo1%TYPE,
    DiaHo2   R064PON_AUX.DiaHo2%TYPE,
    STAACC   R064PON_AUX.StaAcc%TYPE);
  l_r064pon_aux t_r064pon_aux;
BEGIN

  FOREACH c_r064Pon_ins INTO  l_r064pon_aux.NumEmp,
                              l_r064pon_aux.TipCol,
                              l_r064pon_aux.NumCad,
                              l_r064pon_aux.DiaHo1,
                              l_r064pon_aux.DiaHo2,
                              l_r064pon_aux.StaAcc
  LOOP
     R064PON_VerPon (l_r064pon_aux.NumEmp,l_r064pon_aux.TipCol,l_r064pon_aux.NumCad,
                     l_r064pon_aux.DiaHo1,l_r064pon_aux.DiaHo2);

  END LOOP;

  /* Apaga Registro da AUX */
  BEGIN
      DELETE FROM R064PON_AUX;
      DROP_TEMP_TABLE R064PON_AUX;
  EXCEPTION WHEN OTHERS THEN
      NULL;
  END;
END␀­Ø␀␀		SENIOR;0q␀␀TRIGGER R064PON_EI AFTER INSERT ON R064PON FOR EACH ROW

DECLARE
  l_online     BOOLEAN;
  l_idtpes     CHAR(23);
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R064PON_AUX;
  
BEGIN
  SP_VerOnLine(l_online OUT);
  BEGIN
  UPDATE R066APU SET DIAALT = 3
         WHERE NUMEMP = :NEW.NUMEMP AND
               TIPCOL = :NEW.TIPCOL AND
               NUMCAD = :NEW.NUMCAD AND
               DATAPU = :NEW.DIAHO1;

  UPDATE R066APU SET DIAALT = 3
         WHERE NUMEMP = :NEW.NUMEMP AND
               TIPCOL = :NEW.TIPCOL AND
               NUMCAD = :NEW.NUMCAD AND
               DATAPU = :NEW.DIAHO2;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
  
  IF (l_online = TRUE) THEN
    BEGIN
         INSERT INTO R064PON_AUX (NUMEMP,TIPCOL,NUMCAD,DIAHO1,DIAHO2,STAACC)
         VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DIAHO1,:NEW.DIAHO2,:NEW.STAACC);
    EXCEPTION
         WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no INSERT em R064PON_AUX.';
    END;
  END IF;

  SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
  SP_SAM_PENDENCIES(42, 2, l_idtpes);
END␀±Ø␀␀	SENIOR;0°␀␀

TRIGGER R064PON_SU AFTER UPDATE ON R064PON

DECLARE
l_online       BOOLEAN;
/* CURSOR c/ os registros gravados no R064PON_AUX */
  CURSOR c_r064pon_ins IS SELECT NUMEMP, TIPCOL, NUMCAD, DiaHo1, DiaHo2, STAACC FROM R064PON_AUX;
  TYPE t_r064PON_aux IS RECORD(
    NUMEMP   R064PON_AUX.NumEmp%TYPE,
    TIPCOL   R064PON_AUX.TipCol%TYPE,
    NUMCAD   R064PON_AUX.NumCad%TYPE,
    DiaHo1   R064PON_AUX.DiaHo1%TYPE,
    DiaHo2   R064PON_AUX.DiaHo2%TYPE,
    STAACC   R064PON_AUX.StaAcc%TYPE);
  l_r064pon_aux t_r064pon_aux;
BEGIN

  FOREACH c_r064Pon_ins INTO  l_r064pon_aux.NumEmp,
                              l_r064pon_aux.TipCol,
                              l_r064pon_aux.NumCad,
                              l_r064pon_aux.DiaHo1,
                              l_r064pon_aux.DiaHo2,
                              l_r064pon_aux.StaAcc
  LOOP
     R064PON_VerPon (l_r064pon_aux.NumEmp,l_r064pon_aux.TipCol,l_r064pon_aux.NumCad,
                     l_r064pon_aux.DiaHo1,l_r064pon_aux.DiaHo2);

  END LOOP;
  /* Apaga Registro da AUX */
  BEGIN
      DELETE FROM R064PON_AUX;
      DROP_TEMP_TABLE R064PON_AUX;
  EXCEPTION WHEN OTHERS THEN
      NULL;
  END;
END␀®Ø␀␀		SENIOR;0␀␀

TRIGGER R064PON_EU AFTER UPDATE ON R064PON FOR EACH ROW

DECLARE
  l_online     BOOLEAN;
  l_idtpes     CHAR(23);

  /* Tabela temporária */
  CREATE_TEMP_TABLE R064PON_AUX;
  
BEGIN
  SP_VerOnLine(l_online OUT);

  /* Verifica se foi alterado alguma campo que infuencia. Campo status nao influencia. */
  IF  (:NEW.DIAHO2 <> :OLD.DIAHO2) THEN
      BEGIN
      UPDATE R066APU SET DIAALT = 3
        WHERE NUMEMP = :NEW.NUMEMP AND
              TIPCOL = :NEW.TIPCOL AND
              NUMCAD = :NEW.NUMCAD AND
              DATAPU = :NEW.DIAHO2;

      UPDATE R066APU SET DIAALT = 3
        WHERE NUMEMP = :OLD.NUMEMP AND
              TIPCOL = :OLD.TIPCOL AND
              NUMCAD = :OLD.NUMCAD AND
              DATAPU = :OLD.DIAHO2;
      EXCEPTION WHEN OTHERS THEN
        NULL;
      END;
  END IF;

  IF (l_online = TRUE) THEN
    BEGIN
         INSERT INTO R064PON_AUX (NUMEMP,TIPCOL,NUMCAD,DIAHO1,DIAHO2,STAACC)
         VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DIAHO1,:NEW.DIAHO2,:NEW.STAACC);
    EXCEPTION
         WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no UPDATE em R064PON_AUX.';
    END;
  END IF;

  SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
  SP_SAM_PENDENCIES(42, 2, l_idtpes);
END␀¯Ø␀␀	SENIOR;0²␀␀

TRIGGER R064PON_SD AFTER DELETE ON R064PON

DECLARE
l_online       BOOLEAN;
/* CURSOR c/ os registros gravados no R064PON_AUX */
  CURSOR c_r064pon_ins IS SELECT NUMEMP, TIPCOL, NUMCAD, DiaHo1, DiaHo2, STAACC FROM R064PON_AUX;
  TYPE t_r064PON_aux IS RECORD(
    NUMEMP   R064PON_AUX.NumEmp%TYPE,
    TIPCOL   R064PON_AUX.TipCol%TYPE,
    NUMCAD   R064PON_AUX.NumCad%TYPE,
    DiaHo1   R064PON_AUX.DiaHo1%TYPE,
    DiaHo2   R064PON_AUX.DiaHo2%TYPE,
    STAACC   R064PON_AUX.StaAcc%TYPE);
  l_r064pon_aux t_r064pon_aux;
BEGIN

  FOREACH c_r064Pon_ins INTO  l_r064pon_aux.NumEmp,
                              l_r064pon_aux.TipCol,
                              l_r064pon_aux.NumCad,
                              l_r064pon_aux.DiaHo1,
                              l_r064pon_aux.DiaHo2,
                              l_r064pon_aux.StaAcc
  LOOP
     R064PON_VerPon (l_r064pon_aux.NumEmp,l_r064pon_aux.TipCol,l_r064pon_aux.NumCad,
                     l_r064pon_aux.DiaHo1,l_r064pon_aux.DiaHo2);

  END LOOP;

  /* Apaga Registro da AUX */
  BEGIN
      DELETE FROM R064PON_AUX;
      DROP_TEMP_TABLE R064PON_AUX;
  EXCEPTION WHEN OTHERS THEN
      NULL;
  END;
END␀¬Ø␀␀		SENIOR;0o␀␀

TRIGGER R064PON_ED AFTER DELETE ON R064PON FOR EACH ROW
DECLARE
  l_online     BOOLEAN;
  l_idtpes     CHAR(23);

  /* Tabela temporária */
  CREATE_TEMP_TABLE R064PON_AUX;

BEGIN
  SP_VerOnLine(l_online OUT);
  BEGIN
  UPDATE R066APU SET DIAALT = 3
         WHERE NUMEMP = :OLD.NUMEMP AND
               TIPCOL = :OLD.TIPCOL AND
               NUMCAD = :OLD.NUMCAD AND
               DATAPU = :OLD.DIAHO1;

  UPDATE R066APU SET DIAALT = 3
         WHERE NUMEMP = :OLD.NUMEMP AND
               TIPCOL = :OLD.TIPCOL AND
               NUMCAD = :OLD.NUMCAD AND
               DATAPU = :OLD.DIAHO2;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
  
  IF (l_online = TRUE) THEN
    BEGIN
         INSERT INTO R064PON_AUX (NUMEMP,TIPCOL,NUMCAD,DIAHO1,DIAHO2,STAACC)
         VALUES (:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.DIAHO1,:OLD.DIAHO2,:OLD.STAACC);
    EXCEPTION
         WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no UPDATE em R064PON_AUX.';
    END;
  END IF;

  SP_RETIDTPES(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, 0, '', '', '', l_idtpes OUT);
  SP_SAM_PENDENCIES(42, 2, l_idtpes);
END␀␀␀ùÂ␀␀␀␀␀␀␀␀«Ø␀␀…¬␀␀´␀„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t„␀␀␀␀␀␀Ü␀t␀Ü␀n@‰␀Æÿ␀␀ÿ␀c¬␀␀Ì␀„␀␀␀␀␀␀$0.0.w=‰␀Æÿ␀␀ÿ␀¬[Ñ␀„␀␀␀␀␀␀M*_MqC>‰␀êÿ␀␀ÿ␀­[Ñ␀„␀␀␀␀␀␀M+_MqC?‰␀êÿ␀␀ÿ␀␀Ã„␀␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀␀␀	␀úÂ␀␀␀	␀␀␀␀␀␀³Ø␀␀…¬␀␀´␀	„␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	„␀␀␀␀␀␀␀Ü␀t␀Ü␀n-‰␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	„␀␀␀␀␀␀␀.%0.0.w$‰␀Æÿ␀␀…Ó␀␀␀EÑ␀	„␀␀␀␀␀␀␀€G]G]GqC&‰␀êÿ␀␀ÿ␀¤w·␀	„␀␀␀␀␀␀␀qxdxdxì*␀␀Æÿ␀␀ÿ␀åDÑ␀„␀␀␀␀␀␀␀	GÔFÔFqC%‰␀êÿ␀␀ÿ␀w·␀„␀␀␀␀␀␀␀Ix<x<xì*␀␀Æÿ␀␀ÿ␀X-Ì␀„␀␀␀␀␀␀␀<A0í␀␀0í␀␀{(‰␀Æÿ␀␀ØĞ␀␀␀␀␀␀	0;1;2;3;4µØ␀␀		SENIOR;0)␀␀TRIGGER R064RAT_EI AFTER INSERT ON R064RAT FOR EACH ROW 

DECLARE
l_DataZero   DATE;
  l_data_fim   DATE;
BEGIN
l_DataZero := '31/12/1900,00:00:00';
l_data_fim := :NEW.DATFIM;
IF   (l_data_fim = l_DataZero) THEN
     l_data_fim := '04/06/2080,00:00:00';
END IF;

BEGIN
UPDATE R066APU SET DIAALT = 11
       WHERE NUMEMP = :NEW.NUMEMP AND
             TIPCOL = :NEW.TIPCOL AND
             NUMCAD = :NEW.NUMCAD AND
             DATAPU >= :NEW.DATINI AND
             DATAPU <= l_data_fim;
EXCEPTION WHEN OTHERS THEN
  NULL;
END;
END␀¶Ø␀␀		SENIOR;0␀␀

TRIGGER R064RAT_EU AFTER UPDATE ON R064RAT FOR EACH ROW 

DECLARE
l_DataZero    DATE;
  l_data_fim    DATE;
BEGIN
/* Na Alteração do Registro seta todo o periodo como alterado */
/* Também verifica a Data Final                               */
l_DataZero := '31/12/1900,00:00:00';
IF   ((:OLD.DATFIM = l_DataZero) OR (:NEW.DATFIM = l_DataZero)) THEN
     l_data_fim := '04/06/2080,00:00:00';
ELSIF (:NEW.DATFIM > :OLD.DATFIM) THEN
     l_data_fim := :NEW.DATFIM;
ELSE l_data_fim := :OLD.DATFIM;
END IF;

/* Verifica se foi alterado algum campo que infuencia na apuração. Campo status nao influencia. */
IF  (:NEW.HORFIM <> :OLD.HORFIM) OR (:NEW.DATFIM <> :OLD.DATFIM) OR (:NEW.CODRAT <> :OLD.CODRAT) THEN
    BEGIN
    UPDATE R066APU SET DIAALT = 11
      WHERE NUMEMP = :NEW.NUMEMP AND
            TIPCOL = :NEW.TIPCOL AND
            NUMCAD = :NEW.NUMCAD AND
            DATAPU >= :NEW.DATINI AND
            DATAPU <= l_data_fim;
    EXCEPTION WHEN OTHERS THEN
      NULL;
    END;
END IF;
END␀´Ø␀␀		SENIOR;0,␀␀

