		/* ATUALIZO A TABELA R034DAC, ALTERANDO AS DEFINICOES DE ACESSO QUE VEM DE POSTO */
		BEGIN
			UPDATE R034DAC SET
				VERPRM = l_r034DAC.VERPRM, CONFAI = l_r034DAC.CONFAI, CONADP = l_r034DAC.CONADP, CONCRE = l_r034DAC.CONCRE, CONIAL = l_r034DAC.CONIAL,
				TEMALM = l_r034DAC.TEMALM, BLOFAL = l_r034DAC.BLOFAL, RECVIS = l_r034DAC.RECVIS, AUTAGV = l_r034DAC.AUTAGV, AUTASA = l_r034DAC.AUTASA,
				AUTEXT = l_r034DAC.AUTEXT, USAFRO = l_r034DAC.USAFRO, GRACON = l_r034DAC.GRACON, CONPAC = l_r034DAC.CONPAC, TEMPAC = l_r034DAC.TEMPAC,
				TOLACP = l_r034DAC.TOLACP, USABIO = l_r034DAC.USABIO, AUTDBL = l_r034DAC.AUTDBL, VERAFA = l_r034DAC.VERAFA, APRSOL = l_r034DAC.APRSOL,
				CONINT = l_r034DAC.CONINT, TOLINT = l_r034DAC.TOLINT, CONREA = l_r034DAC.CONREA, UTICHV = l_r034DAC.UTICHV, REPONL = l_r034DAC.REPONL,
				USARFA = l_r034DAC.USARFA, CONREE = l_r034DAC.CONREE, CODPRM = l_r034DAC.CODPRM, PRMFER = l_r034DAC.PRMFER, PRMSAB = l_r034DAC.PRMSAB, 
				PRMDOM = l_r034DAC.PRMDOM, PRMVIS = l_r034DAC.PRMVIS
			WHERE NUMEMP = l_r038HPO.NUMEMP AND TIPCOL = l_r038HPO.TIPCOL AND NUMCAD = l_r038HPO.NUMCAD;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'R017DAC_EU: Erro ao atualizar as definicoes de acesso do colaborador.';
		END;

		/* ATUALIZO A TABELA R034EDP, COM AS ORIGENS DE CADA DEFINICAO DE ACESSSO.
			 SE O COLABORADOR NAO POSSUIR REGISTRO NA TABELA R034EDP, GRAVO-O. */
		IF (l_graedp = TRUE) THEN
			BEGIN
				INSERT INTO R034EDP (NUMEMP, TIPCOL, NUMCAD, VERPRM, CONFAI, CONADP, CONCRE, CONIAL, TEMALM, BLOFAL, RECVIS, AUTAGV, AUTASA,
					AUTEXT, USAFRO, GRACON, CONPAC, TEMPAC, TOLACP, USABIO, AUTDBL, VERAFA, APRSOL, CONINT, TOLINT, CONREA, UTICHV, REPONL, USARFA, CONREE)
				VALUES (l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_r034EDP.VERPRM, l_r034EDP.CONFAI, l_r034EDP.CONADP, l_r034EDP.CONCRE, l_r034EDP.CONIAL, 
					l_r034EDP.TEMALM, l_r034EDP.BLOFAL, l_r034EDP.RECVIS, l_r034EDP.AUTAGV, l_r034EDP.AUTASA, l_r034EDP.AUTEXT, l_r034EDP.USAFRO,
					l_r034EDP.GRACON, l_r034EDP.CONPAC, l_r034EDP.TEMPAC, l_r034EDP.TOLACP, l_r034EDP.USABIO, l_r034EDP.AUTDBL, l_r034EDP.VERAFA,
					l_r034EDP.APRSOL, l_r034EDP.CONINT, l_r034EDP.TOLINT, l_r034EDP.CONREA, l_r034EDP.UTICHV, l_r034EDP.REPONL, l_r034EDP.USARFA, l_r034EDP.CONREE);
			EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'R017DAC_EU: Erro ao incluir as excecoes de definicoes de acesso do colaborador.';
			END;
		ELSE
			BEGIN
				UPDATE R034EDP SET
					VERPRM = l_r034EDP.VERPRM, CONFAI = l_r034EDP.CONFAI, CONADP = l_r034EDP.CONADP, CONCRE = l_r034EDP.CONCRE, CONIAL = l_r034EDP.CONIAL,
					TEMALM = l_r034EDP.TEMALM, BLOFAL = l_r034EDP.BLOFAL, RECVIS = l_r034EDP.RECVIS, AUTAGV = l_r034EDP.AUTAGV, AUTASA = l_r034EDP.AUTASA,
					AUTEXT = l_r034EDP.AUTEXT, USAFRO = l_r034EDP.USAFRO, GRACON = l_r034EDP.GRACON, CONPAC = l_r034EDP.CONPAC, TEMPAC = l_r034EDP.TEMPAC,
					TOLACP = l_r034EDP.TOLACP, USABIO = l_r034EDP.USABIO, AUTDBL = l_r034EDP.AUTDBL, VERAFA = l_r034EDP.VERAFA, APRSOL = l_r034EDP.APRSOL,
					CONINT = l_r034EDP.CONINT, TOLINT = l_r034EDP.TOLINT, CONREA = l_r034EDP.CONREA, UTICHV = l_r034EDP.UTICHV, REPONL = l_r034EDP.REPONL,
					USARFA = l_r034EDP.USARFA, CONREE = l_r034EDP.CONREE
				WHERE NUMEMP = l_r038HPO.NUMEMP AND TIPCOL = l_r038HPO.TIPCOL AND NUMCAD = l_r038HPO.NUMCAD;
			EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'R017DAC_EU: Erro ao atualizar as excecoes de definicoes de acesso do colaborador.';
			END;
		END IF;
	END LOOP;
END␀␀␀øR␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀}Ğ␀␀+f±␀	Ôÿ!␀␀␀␀␀›>Y:S;q‡␀Æÿ␀␀€Ğ␀␀␀mDÑ␀	Ôÿ!␀␀␀␀␀?IşEşEqC␀êÿ␀␀ÿ␀f´␀Ôï!␀␀␀␀␀÷<ïe»fr␀Æÿ␀␀)Ñ␀␀␀␀␀␀0;1␀␀×f␀␀␀␀~Ğ␀␀+f±␀	Ôÿ!␀␀␀␀␀›>Y:S;q‡␀Æÿ␀␀€Ğ␀␀␀mDÑ␀	Ôÿ!␀␀␀␀␀?IşEşEqC␀êÿ␀␀ÿ␀Ş␀´␀Ôï!␀␀␀␀␀>½␀␀r␀Æÿ␀␀YĞ␀␀␀␀␀␀0;1␀␀Øf␀␀␀␀Ğ␀␀+f±␀	Ôÿ?␀␀␀␀␀›>Y:S;q‡␀Æÿ␀␀€Ğ␀␀␀yTUÔÿ?␀␀␀␀␀ W°V°VV‡␀␀ÿ␀␀ÿ␀␀±␀Ôÿ1␀␀␀␀␀ÃPFvÛ␀q‡␀Æÿ␀␀¿Ğ␀␀000␀␀␀0␀␀Öf␀␀␀␀Ğ␀␀+f±␀	Ôÿ1␀␀␀␀␀=øeËfq␀Æÿ␀␀d`␀Ä␀␀4	Ôÿ1␀␀␀␀␀(Ap:Û;f␀␀␀ÿ␀␀ş¸␀␀␀5-·␀	Ôÿ1␀␀␀␀␀\A“␀“␀s␀Æÿ␀␀ë×␀␀␀x-·␀	Ôÿ1␀␀␀␀␀@¥.¥.u␀Æÿ␀␀Ø␀␀␀¥%␀±␀	Ôÿ1␀␀␀␀␀?&␀<&␀<&␀q␀Æÿ␀␀6Ø␀␀␀3-Á␀	Ôÿ1␀␀␀␀␀Ï@˜š␀␀˜š␀␀y␀Æÿ␀␀å×␀␀␀ï␀␀·␀	Ôÿ1␀␀␀␀␀•␀␀•”␀␀•␀␀ì*␀␀Æÿ␀␀ÿ␀Æ[¡	Ôÿ1␀␀␀␀␀Z[Z[Z[n␀Æÿ␀␀ÿ␀m,Ì␀	Ôÿ1␀␀␀␀␀N@¤:¤:{␀Æÿ␀␀ÿ␀o·␀Ôÿ1␀␀␀␀␀Én€nÀnì*␀␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3;4;5;6;7;8␀␀1l␀␀␀␀␀␀␀␀␀␀␀‚Ğ␀␀+f±␀	Ôÿ/␀␀␀␀␀=øeËfq␀Æÿ␀␀d`␀Ä␀␀4	Ôÿ/␀␀␀␀␀*A‘Ä␀␀¶Ä␀␀f␀␀␀ÿ␀␀ş¸␀␀␀EÑ␀	Ôÿ/␀␀␀␀␀LQZ”␀␀C•␀␀qC␀êÿ␀␀ÿ␀^ı␀␀­␀	Ôÿ/␀␀␀␀␀ÿ␀␀xş␀␀xş␀␀p␀Æÿ␀␀ÿ␀$-Ì␀Ôÿ/␀␀␀␀␀ö?•¸␀␀Â;{␀Æÿ␀␀.#␀ ,Ì␀Ôÿ/␀␀␀␀␀x@áqáq{␀Æÿ␀␀##␀è*Ôÿ/␀␀␀␀␀LÀ␀␀,␀␀ÿ␀␀ÿ␀åDÑ␀Ôÿ/␀␀␀␀␀zQ6␀m␀qC␀êÿ␀␀ÿ␀␀␀␀0;1;2;3„Ğ␀␀		SENIOR;03␀␀TRIGGER R017GHE_EI AFTER INSERT ON R017GHE FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataInicio DATE;
	l_DataTermino DATE;
	l_NumEmp   R583FIL.NumEmp%TYPE;
	l_Json VARCHAR(2000);
	l_DataAux DATE;
	l_DatIniSST DATE;
	l_LigacaoGHE NUMBER(1);
	
	CURSOR C_EMPRESAS IS
	SELECT DISTINCT NUMEMP
	FROM R583FIL
    WHERE CODPRA = :NEW.CodPRA
  	ORDER BY NUMEMP;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DataInicio := :NEW.DatIni;
	l_DataTermino := :NEW.DatFim;

	SP_CONCATENAR_NUM('ESTPOS', :NEW.EstPos, l_Json OUT);
	SP_CONCATENAR_DES('POSTRA', :NEW.PosTra, l_Json OUT);
	
	FOREACH C_EMPRESAS INTO l_NumEmp
	LOOP	
		SM_LIGACAOGHE(l_NumEmp, l_LigacaoGHE OUT);
		RH_RET_DATINISST(l_NumEmp, l_DatIniSST OUT);
		IF (l_DatIniSST > l_DataZero) AND (l_LigacaoGHE = 2) THEN /* Ligação GHE: 2 - Posto Trabalho */
			IF (l_DataTermino > l_DatIniSST OR l_DataTermino = l_DataZero) THEN
				IF (l_DataInicio < l_DatIniSST) THEN
					l_DataInicio := l_DatIniSST;
				END IF;
		
			  	SP_E_SOCIAL_SM('S-2240', 'R017GHE', 'N', 'I', l_DataInicio, l_DataTermino, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DataInicio, 0, 'R017GHE_EI');
			  	
			  	/* Se o histórico que está sendo incluído tiver data de término, já cria uma pendência para o dia seguinte à data informada */
				IF (l_DataTermino > l_DataZero) THEN
					l_DataAux := DATETIMEADD(DD, 1, l_DataTermino);
					SP_E_SOCIAL_SM('S-2240', 'R017GHE', 'N', 'I', l_DataAux, l_DataAux, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DataAux, 0, 'R017GHE_EI');
				END IF;
			END IF;
		END IF;
	END LOOP;
END␀…Ğ␀␀		SENIOR;0™␀␀

TRIGGER R017GHE_EU AFTER UPDATE ON R017GHE FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_AlterouCampo BOOLEAN;
	l_AlterouRegistro BOOLEAN;
	l_AlterouGHE BOOLEAN;
	l_AlterouDataTermino BOOLEAN;
	l_DataInicio DATE;
	l_DataTermino DATE;
	l_DataAux DATE;
	l_NumEmp   R583FIL.NumEmp%TYPE;
	l_Json VARCHAR(2000);
	l_DatIniSST DATE;
	l_LigacaoGHE NUMBER(1);
	l_JsonAlteracao VARCHAR2(2000);

	CURSOR C_EMPRESAS IS
	SELECT DISTINCT NUMEMP
	FROM R583FIL
    WHERE CODPRA = :NEW.CodPRA
  	ORDER BY NUMEMP;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	
	l_AlterouRegistro := FALSE;
  	l_AlterouGHE := FALSE;
  	l_AlterouDataTermino := FALSE;
  
  	SP_VALUPDATE_NUM(:OLD.CodPRA, :NEW.CodPRA, l_AlterouCampo OUT);
  	IF (l_AlterouCampo = TRUE) THEN
  		l_AlterouRegistro := TRUE;
		l_AlterouGHE := TRUE;
		SP_CONCAT_NUM_JSON('CODPRA', :NEW.CodPRA, :OLD.CodPRA, l_JsonAlteracao OUT);
  	END IF;
  
  	SP_VALUPDATE_NUM(:OLD.CodGHE, :NEW.CodGHE, l_AlterouCampo OUT);
  	IF (l_AlterouCampo = TRUE) THEN
  		l_AlterouRegistro := TRUE;
		l_AlterouGHE := TRUE;
		SP_CONCAT_NUM_JSON('CODGHE', :NEW.CodGHE, :OLD.CodGHE, l_JsonAlteracao OUT);
  	END IF;
  	
  	SP_VALUPDATE_DAT(:OLD.DatFim, :NEW.DatFim, l_AlterouCampo OUT);
  	IF (l_AlterouCampo = TRUE) THEN
  		l_AlterouRegistro := TRUE;
		l_AlterouDataTermino := TRUE;
		SP_CONCAT_DAT_JSON('DATFIM', :NEW.DatFim, :OLD.DatFim, l_JsonAlteracao OUT);
  	END IF;	  
	
	SP_CONCATENAR_NUM('ESTPOS', :NEW.EstPos, l_Json OUT);
	SP_CONCATENAR_DES('POSTRA', :NEW.PosTra, l_Json OUT);
	
	IF (l_AlterouRegistro = TRUE) THEN
		FOREACH C_EMPRESAS INTO l_NumEmp
		LOOP
		    SM_LIGACAOGHE(l_NumEmp, l_LigacaoGHE OUT);
			RH_RET_DATINISST(l_NumEmp, l_DatIniSST OUT);
			IF (l_DatIniSST > l_DataZero) AND (l_LigacaoGHE = 2) THEN /* Ligação GHE: 2 - Posto Trabalho */
				IF (:NEW.DatFim > l_DatIniSST OR :OLD.DatFim > l_DatIniSST OR :NEW.DatFim = l_DataZero OR :OLD.DatFim = l_DataZero) THEN
					IF (l_AlterouGHE = TRUE) THEN
						l_DataInicio := :NEW.DatIni;
						IF (:NEW.DatIni < l_DatIniSST) THEN
							l_DataInicio := l_DatIniSST;
						END IF;
						
				  		IF (:OLD.DatFim < :NEW.DatFim) THEN
				  			l_DataTermino := :OLD.DatFim;
				  		ELSE
				  			l_DataTermino := :NEW.DatFim;
				  		END IF;
				  		
				  		SP_E_SOCIAL_SM('S-2240', 'R017GHE', 'N', 'A', l_DataInicio, l_DataTermino, l_NumEmp, 0, 0, l_Json, l_JsonAlteracao, 0, NULL, l_DataInicio, 0, 'R017GHE_EU');
				  	END IF;
				  	
					IF (l_AlterouDataTermino = TRUE) THEN
						/* Se as datas de término nova e antiga forem maiores que zero */
						IF (:OLD.DatFim > l_DataZero AND :NEW.DatFim > l_DataZero) THEN
							IF (:NEW.DatFim > :OLD.DatFim) THEN
								/* Aumentou a data de término, então cria pendência da data de término antiga até a data de término nova */
								l_DataInicio := DATETIMEADD(DD, 1, :OLD.DatFim);
								l_DataTermino := :NEW.DatFim;
								SP_E_SOCIAL_SM('S-2240', 'R017GHE', 'N', 'A', l_DataInicio, l_DataTermino, l_NumEmp, 0, 0, l_Json, l_JsonAlteracao, 0, NULL, l_DataInicio, 0, 'R017GHE_EU');
								
								/* Cria uma pendência também para o dia posterior ao novo término informado */
								l_DataAux := DATETIMEADD(DD, 1, :NEW.DatFim);
								SP_E_SOCIAL_SM('S-2240', 'R017GHE', 'N', 'A', l_DataAux, l_DataAux, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DataAux, 0, 'R017GHE_EU');
							ELSE
								/* Diminuiu a data de término, então cria pendência da data de término nova até a data de término antiga */
								l_DataInicio := DATETIMEADD(DD, 1, :NEW.DatFim);
								l_DataTermino := :OLD.DatFim;
								SP_E_SOCIAL_SM('S-2240', 'R017GHE', 'N', 'A', l_DataInicio, l_DataTermino, l_NumEmp, 0, 0, l_Json, l_JsonAlteracao, 0, NULL, l_DataInicio, 0, 'R017GHE_EU');
							END IF;
						ELSE
							/* Se alterou de 00/00/0000 para uma data válida */
							IF (:OLD.DatFim = l_DataZero AND :NEW.DatFim > l_DataZero) THEN
								l_DataInicio := DATETIMEADD(DD, 1, :NEW.DatFim);
								l_DataTermino := :OLD.DatFim;
								SP_E_SOCIAL_SM('S-2240', 'R017GHE', 'N', 'A', l_DataInicio, l_DataTermino, l_NumEmp, 0, 0, l_Json, l_JsonAlteracao, 0, NULL, l_DataInicio, 0, 'R017GHE_EU');
							ELSE
								/* Se alterou de uma data válida para 00/00/0000 */
								IF (:NEW.DatFim = l_DataZero AND :OLD.DatFim > l_DataZero) THEN
									l_DataInicio := DATETIMEADD(DD, 1, :OLD.DatFim);
									l_DataTermino := :NEW.DatFim;
									SP_E_SOCIAL_SM('S-2240', 'R017GHE', 'N', 'A', l_DataInicio, l_DataTermino, l_NumEmp, 0, 0, l_Json, l_JsonAlteracao, 0, NULL, l_DataInicio, 0, 'R017GHE_EU');
								END IF;
							END IF;
			  			END IF;
		  			END IF;
				END IF;
			END IF;
		END LOOP;
	END IF;
END␀ƒĞ␀␀		SENIOR;0¯␀␀

TRIGGER R017GHE_ED AFTER DELETE ON R017GHE FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataInicio DATE;
	l_DataTermino DATE;
	l_NumEmp   R583FIL.NumEmp%TYPE;
	l_Json VARCHAR(2000);
	l_DatIniSST DATE;
	l_LigacaoGHE NUMBER(1);
	
	CURSOR C_EMPRESAS IS
	SELECT DISTINCT NUMEMP
	FROM R583FIL
    WHERE CODPRA = :OLD.CodPRA
  	ORDER BY NUMEMP;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DataInicio := :OLD.DatIni;
  	l_DataTermino := :OLD.DatFim;
  	
	SP_CONCATENAR_NUM('ESTPOS', :OLD.EstPos, l_Json OUT);
	SP_CONCATENAR_DES('POSTRA', :OLD.PosTra, l_Json OUT);
  	
	FOREACH C_EMPRESAS INTO l_NumEmp
	LOOP
	    SM_LIGACAOGHE(l_NumEmp, l_LigacaoGHE OUT);
		RH_RET_DATINISST(l_NumEmp, l_DatIniSST OUT);
		IF (l_DatIniSST > l_DataZero) AND (l_LigacaoGHE = 2) THEN /* Ligação GHE: 2 - Posto Trabalho */
			IF (l_DataTermino > l_DatIniSST OR l_DataTermino = l_DataZero) THEN		
				IF (l_DataInicio < l_DatIniSST) THEN
					l_DataInicio := l_DatIniSST;
				END IF;		
		
		  		SP_E_SOCIAL_SM('S-2240', 'R017GHE', 'N', 'E', l_DataInicio, l_DataTermino, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DataInicio, 0, 'R017GHE_ED');
	  		END IF;
	  	END IF;
	END LOOP;
END␀␀␀ĞÄ␀␀␀␀␀␀␀␀␀␀␀†Ğ␀␀+f±␀	Ôÿ1␀␀␀␀␀›>÷eËfq‡␀Æÿ␀␀€Ğ␀␀␀Ä␀␀4	Ôÿ1␀␀␀␀␀(Ap:Û;f␀␀␀ÿ␀␀ş¸␀␀␀¥E·␀	Ôÿ1␀␀␀␀␀xş␀␀xş␀␀xş␀␀s␀Æÿ␀␀ÿ␀NE=Ôÿ1␀␀␀␀␀ÿCüCüC<␀␀ÿ␀␀ÿ␀ÀE=Ôÿ1␀␀␀␀␀ıCüCüC<␀␀ÿ␀␀ÿ␀␀␀␀0;1;2␀␀ØÄ␀␀␀␀␀␀␀␀‡Ğ␀␀+f±␀	€@␀␀␀␀␀␀=øeËfq␀Æÿ␀␀d`␀Ä␀␀4	€@␀␀␀␀␀␀*A‘Ä␀␀¶Ä␀␀f␀␀␀ÿ␀␀ş¸␀␀␀mDÑ␀	€@␀␀␀␀␀␀¯P¼&IqC␀êÿ␀␀ÿ␀<␀‡€@␀␀␀␀␀␀	Q77n␀Æÿ␀␀ÿ␀␀Ä␀␀4€@␀␀␀␀␀␀B©Ä␀␀©Ä␀␀f␀␀␀ÿ␀␀ş¸␀␀␀␀␀␀0;1;2␀␀ÏÄ␀␀␀␀␀␀␀␀ˆĞ␀␀+f±␀	€␀␀␀␀␀␀›>÷eËfq␀Æÿ␀␀€Ğ␀␀␀Ä␀␀4	€␀␀␀␀␀␀(A‘Ä␀␀Û;f␀␀␀ÿ␀␀ş¸␀␀␀úDÑ␀	€␀␀␀␀␀␀BJÙENqCş‡␀êÿ␀␀‰Ğ␀␀␀␀␀␀0;1;2␀␀ÒÄ␀␀␀␀␀␀ŠĞ␀␀+f±␀	€␀␀␀␀␀␀›>÷eËfq␀Æÿ␀␀€Ğ␀␀␀Ä␀␀4	€␀␀␀␀␀␀(A‘Ä␀␀Û;f␀␀␀ÿ␀␀ş¸␀␀␀úDÑ␀	€␀␀␀␀␀␀BJÙENqCş‡␀êÿ␀␀‰Ğ␀␀␀oı␀␀·␀	€␀␀␀␀␀␀º•␀␀—•␀␀É•␀␀s␀Æÿ␀␀“Ğ␀␀␀p␀e€␀␀␀␀␀␀œX°V°V7␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3ŒĞ␀␀		SENIOR;0V␀␀TRIGGER R017HDI_EI AFTER INSERT ON R017HDI FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DatIniHis DATE;
	l_DatTerHis DATE;
	l_DataInicioSST DATE;
	l_EstPosStr VARCHAR(3);
	l_PosTraStr   R017HDI.PosTra%TYPE;
	l_Where VARCHAR(200);
	l_NumEmp   R030DES.NumEmp%TYPE;
	l_Json VARCHAR(2000);
	
	CURSOR C_R030DES IS SELECT NumEmp, IniSST 
	FROM R030DES 
	WHERE IniSST > l_DataZero AND (l_DatTerHis > IniSST OR l_DatTerHis = l_DataZero) 
	ORDER BY NumEmp;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DatIniHis := :NEW.DatHis;
	
	l_EstPosStr := CONVERT(NUMBER_TO_CHAR, :NEW.EstPos);
	l_PosTraStr := :NEW.PosTra;
	l_Where := 'ESTPOS = ' || l_EstPosStr || ' AND POSTRA = ''' || l_PosTraStr || '''';
  	SP_PROXHIST_NPER('DATHIS', 'R017HDE', l_Where, l_DatIniHis, l_DatTerHis OUT);
  	
  	SP_CONCATENAR_NUM('ESTPOS', :NEW.EstPos, l_Json OUT);
  	SP_CONCATENAR_DES('POSTRA', :NEW.PosTra, l_Json OUT);
  	SP_CONCATENAR_DAT('DATHIS', :NEW.DatHis, l_Json OUT);
  	SP_CONCATENAR_NUM('SEQIDP', :NEW.SeqIdp, l_Json OUT);
	
  	FOREACH C_R030DES INTO l_NumEmp, l_DataInicioSST
  	LOOP		
  		IF (l_DatIniHis < l_DataInicioSST) THEN
  			l_DatIniHis := l_DataInicioSST;
  		END IF;
	
		SP_E_SOCIAL_SM('S-2240', 'R017HDI', 'N', 'I', l_DatIniHis, l_DatTerHis, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DatIniHis, 0, 'R017HDI_EI');
  	END LOOP;
END␀Ğ␀␀		SENIOR;0­␀␀

TRIGGER R017HDI_EU AFTER UPDATE ON R017HDI FOR EACH ROW
DECLARE
	l_Alterou BOOLEAN;
	l_DataZero DATE;
	l_DatIniHis DATE;
	l_DatTerHis DATE;
	l_DataInicioSST DATE;
	l_EstPosStr VARCHAR(3);
	l_PosTraStr   R017HDI.PosTra%TYPE;
	l_Where VARCHAR(200);
	l_NumEmp   R030DES.NumEmp%TYPE;
	l_Json VARCHAR(2000);
	l_JsonAlteracao VARCHAR2(2000);
	
	CURSOR C_R030DES IS SELECT NumEmp, IniSST 
	FROM R030DES 
	WHERE IniSST > l_DataZero AND (l_DatTerHis > IniSST OR l_DatTerHis = l_DataZero) 
	ORDER BY NumEmp;
BEGIN
	SP_VALUPDATE_DES(:OLD.TEXITE, :NEW.TEXITE, l_Alterou OUT);
	IF (l_Alterou = TRUE) THEN
		l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
		l_DatIniHis := :NEW.DatHis;
		l_JsonAlteracao := '{"TEXITE":{"NEW":"Descrição detalhada do item do Posto alterada.","OLD":"Descrição detalhada do item do Posto alterada."}}';
		
		l_EstPosStr := CONVERT(NUMBER_TO_CHAR, :NEW.EstPos);
		l_PosTraStr := :NEW.PosTra;
		l_Where := 'ESTPOS = ' || l_EstPosStr || ' AND POSTRA = ''' || l_PosTraStr || '''';
	  	SP_PROXHIST_NPER('DATHIS', 'R017HDE', l_Where, l_DatIniHis, l_DatTerHis OUT);
	  	
	  	SP_CONCATENAR_NUM('ESTPOS', :NEW.EstPos, l_Json OUT);
	  	SP_CONCATENAR_DES('POSTRA', :NEW.PosTra, l_Json OUT);
	  	SP_CONCATENAR_DAT('DATHIS', :NEW.DatHis, l_Json OUT);
	  	SP_CONCATENAR_NUM('SEQIDP', :NEW.SeqIdp, l_Json OUT);
		
	  	FOREACH C_R030DES INTO l_NumEmp, l_DataInicioSST
	  	LOOP
  			IF (l_DatIniHis < l_DataInicioSST) THEN
				l_DatIniHis := l_DataInicioSST;
  			END IF;
  		
  			SP_E_SOCIAL_SM('S-2240', 'R017HDI', 'N', 'A', l_DatIniHis, l_DatTerHis, l_NumEmp, 0, 0, l_Json, l_JsonAlteracao, 0, NULL, l_DatIniHis, 0, 'R017HDI_EU');
	  	END LOOP;
  	END IF;
END␀‹Ğ␀␀		SENIOR;0W␀␀

TRIGGER R017HDI_ED AFTER DELETE ON R017HDI FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DatIniHis DATE;
	l_DatTerHis DATE;
	l_DataInicioSST DATE;
	l_EstPosStr VARCHAR(3);
	l_PosTraStr   R017HDI.PosTra%TYPE;
	l_Where VARCHAR(200);
	l_NumEmp   R030DES.NumEmp%TYPE;
	l_Json VARCHAR(2000);
	
	CURSOR C_R030DES IS SELECT NumEmp, IniSST 
	FROM R030DES 
	WHERE IniSST > l_DataZero AND (l_DatTerHis > IniSST OR l_DatTerHis = l_DataZero) 
	ORDER BY NumEmp;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DatIniHis := :OLD.DatHis;
	
	l_EstPosStr := CONVERT(NUMBER_TO_CHAR, :OLD.EstPos);
	l_PosTraStr := :OLD.PosTra;
	l_Where := 'ESTPOS = ' || l_EstPosStr || ' AND POSTRA = ''' || l_PosTraStr || '''';
  	SP_PROXHIST_NPER('DATHIS', 'R017HDE', l_Where, l_DatIniHis, l_DatTerHis OUT);
  	
  	SP_CONCATENAR_NUM('ESTPOS', :OLD.EstPos, l_Json OUT);
  	SP_CONCATENAR_DES('POSTRA', :OLD.PosTra, l_Json OUT);
  	SP_CONCATENAR_DAT('DATHIS', :OLD.DatHis, l_Json OUT);
  	SP_CONCATENAR_NUM('SEQIDP', :OLD.SeqIdp, l_Json OUT);
	
  	FOREACH C_R030DES INTO l_NumEmp, l_DataInicioSST
  	LOOP
  		IF (l_DatIniHis < l_DataInicioSST) THEN
  			l_DatIniHis := l_DataInicioSST;
  		END IF;

		SP_E_SOCIAL_SM('S-2240', 'R017HDI', 'N', 'E', l_DatIniHis, l_DatTerHis, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DatIniHis, 0, 'R017HDI_ED');
  	END LOOP;
END␀␀␀ÕÄ␀␀␀␀␀␀␀␀Ğ␀␀+f±␀	Ôÿ?␀␀␀␀␀=øeËfq␀Æÿ␀␀€Ğ␀␀␀½-±␀	Ôÿ?␀␀␀␀␀‚A:vÕ␀q‡␀Æÿ␀␀¿Ğ␀␀␀€ô␀␀±␀	Ôÿ?␀␀␀␀␀?ô␀␀ ô␀␀9)␀␀Æÿ␀␀³Ğ␀␀␀Ä␀␀4	Ôÿ?␀␀␀␀␀*A‘Ä␀␀¶Ä␀␀f␀␀␀ÿ␀␀ş¸␀␀␀Ä␀␀…␀”ù0␀␀␀␀␀7Ä␀␀5Ä␀␀6Ä␀␀‡␀␀ÿ␀␀ÿ␀Ü‰␀␀Á␀Ôÿ1␀␀␀␀␀ÈŠ␀␀ü‰␀␀ÈŠ␀␀y␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3Ğ␀␀		SENIOR;0STRIGGER R017HIE_EI AFTER INSERT ON R017HIE FOR EACH ROW
