PROCEDURE SP_PEND26(P_IDTPES VARCHAR2(23),P_NIVATU CHAR(5),P_DATNIV DATE,P_HORNIV NUMBER(4),P_SEQNIV NUMBER(6))
 IS

l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_segu_atual   NUMBER(2);
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_seqstr       CHAR(2);
  l_datnivstr    CHAR(6);
  l_hornivstr    CHAR(4);
  l_seqnivstr    CHAR(6);
  l_datenv       CHAR(16);
  l_Straux       VARCHAR2(2047);
  l_CenPen       VARCHAR2(1);
  l_mulcon       CHAR(1);

BEGIN
    BEGIN
        SELECT MULCON
        INTO l_mulcon
        FROM R070DAC;
    EXCEPTION
      WHEN OTHERS THEN
        l_mulcon := 'N';
    END;

    /* Neste caso, somente gera pendência se não possuir multi-concentradora, */
    /* pois existindo multi-concentradora a trigger da R070CON_EU gera esta pendência */
    IF (l_mulcon = 'N') THEN
        /*Inicializações*/
        l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
        l_data_atual := CURDATE();
        l_segu_atual := SECOND(CURTIME());
        /*Obtem a data/hora de envio da pendência.*/
        SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
        SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
        SP_INTSTR(l_segu_atual, '99', l_seqstr OUT);
        l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

        /*Conversão campos da pendência*/
        SP_DATSTR(p_datniv,'DDMMYY',l_datnivstr OUT);
        SP_INTSTR(p_horniv,'HHMM',l_hornivstr OUT);
        SP_INTSTR(p_seqniv, '999999', l_seqnivstr OUT);
        /*manda para todas as centralizadoras*/
        l_cenpen := '0';
        /*Monta a pendência*/
        l_straux := '26'||l_datenv||p_idtpes||p_nivatu||l_datnivstr||l_hornivstr||l_seqnivstr;    
        /*Envia a pendência*/
