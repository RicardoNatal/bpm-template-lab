W␀␀PROCEDURE SP_PENDENC_S2210(P_TABELA VARCHAR2(7),P_OPERACAO CHAR,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATACT DATE,P_HORACT NUMBER(5))
 IS

l_DatCat    R086CAT.DATCAT%TYPE;
  l_TipCat    R086CAT.TIPCAT%TYPE;
  l_Valor   VARCHAR2(2000);

  CURSOR C_R086CAT IS SELECT R086CAT.DATCAT, R086CAT.TIPCAT
                        FROM R086CAT
                       WHERE R086CAT.NUMEMP = p_NumEmp
                         AND R086CAT.TIPCOL = p_TipCol
                         AND R086CAT.NUMCAD = p_NumCad
                         AND R086CAT.DATACT = p_DatAct
                         AND R086CAT.HORACT = p_HorAct;

BEGIN
  FOREACH C_R086CAT INTO l_DatCat, l_TipCat
  LOOP
	l_Valor := '';

	SP_CONCATENAR_DAT('DATACT', p_DatAct, l_Valor OUT);
	SP_CONCATENAR_NUM('HORACT', p_HorAct, l_Valor OUT);
	SP_CONCATENAR_DAT('DATCAT', l_DatCat, l_Valor OUT);
	SP_CONCATENAR_DES('TIPCAT', l_TipCat, l_Valor OUT);

	SP_E_SOCIAL_SM('S-2210', p_Tabela, 'N', p_Operacao, NULL, NULL, p_NumEmp, p_TipCol, p_NumCad, l_Valor, '', 0, NULL, p_DatAct, 0, 'SP_PENDENC_S2210');
  END LOOP;
END␀‰ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
