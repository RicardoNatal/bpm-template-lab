TRIGGER R304DBA_SI AFTER INSERT ON R304DBA
DECLARE
	CURSOR c_R304DBA IS
	SELECT NUMEMP, TIPCOL, NUMCAD, NUMCPF, NUMMAT, ANOMES, SEQFOP, SEQREG
	FROM R304DBA
	WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304DBA IS RECORD (
		NUMEMP   R304DBA.NumEmp%TYPE,
		TIPCOL   R304DBA.TipCol%TYPE,
		NUMCAD   R304DBA.NumCad%TYPE,		
		NUMCPF   R304DBA.NumCpf%TYPE,
		NUMMAT   R304DBA.NumMat%TYPE,		
		ANOMES   R304DBA.AnoMes%TYPE,
		SEQFOP   R304DBA.SeqFop%TYPE,		
		SEQREG   R304DBA.SeqReg%TYPE
	);
	   
    l_R304DBA t_R304DBA;
    
    l_NumEmpAux   R304DBA.NumEmp%TYPE;
    l_AnoMesAux   R304DBA.AnoMes%TYPE;
    l_SeqFopAux   R304DBA.SeqFop%TYPE;
    
	l_PidSta VARCHAR2(30);
	l_AnoMesStr VARCHAR(7);
	l_SeqFopStr VARCHAR2(2);
	l_DesRes VARCHAR(250);
BEGIN
	l_NumEmpAux := 0;
	l_AnoMesAux := DATETIME(31, 12, 1900, 0, 0, 0);
	l_SeqFopAux := 0;
	l_PidSta := NULL;

	FOREACH c_R304DBA INTO l_R304DBA.NumEmp, l_R304DBA.TipCol, l_R304DBA.NumCad, l_R304DBA.NumCpf, l_R304DBA.NumMat, l_R304DBA.AnoMes, l_R304DBA.SeqFop, l_R304DBA.SeqReg
	LOOP
		/* Se último registro se tratava do mesmo Ano/Mês e Número Sequencial Folha utiliza o PID encontrando anteriormente */
		IF ((l_R304DBA.NumEmp <> l_NumEmpAux) OR (l_R304DBA.AnoMes <> l_AnoMesAux) OR (l_R304DBA.SeqFop <> l_SeqFopAux)) THEN
			l_PidSta := NULL;
		END IF;
		
		/* Verifica se já tem algum outro registro na mesma folha que esteja pendente (P - Pendente Envio ou R - Erro Envio) */
		IF (l_PidSta IS NULL) THEN
			BEGIN
				SELECT DISTINCT R304DBA.PIDSTA INTO l_PidSta
				  FROM R304DBA, R304STA
				 WHERE R304DBA.PIDSTA = R304STA.PIDSTA
				   AND R304DBA.NUMEMP = l_R304DBA.NumEmp
				   AND R304DBA.ANOMES = l_R304DBA.AnoMes
				   AND R304DBA.SEQFOP = l_R304DBA.SeqFop
				   AND (R304STA.STAENV = 'P' OR R304STA.STAENV = 'R');
			EXCEPTION
				WHEN NO_DATA_FOUND THEN
					l_PidSta := NULL;
				WHEN TOO_MANY_ROWS THEN
					RAISERROR 103 'Foi encontrado mais de um registro de status Pendente Envio e/ou Erro Envio para a mesma competência de folha de pagamento.';	
				WHEN OTHERS THEN
					RAISERROR 103 'Erro ao buscar PID já existente para a mesma competência de folha de pagamento.';
			END;
		END IF;
		
		/* Se não encontrou PID referente a mesma folha gera um novo */
		IF (l_PidSta IS NULL) THEN
			/* Gera um novo PID */
			SP_GERPIDSTA(l_R304DBA.NumEmp, 14, l_PidSta OUT);
			
			SP_DATSTR(l_R304DBA.AnoMes, 'MM/YYYY', l_AnoMesStr OUT);
			l_SeqFopStr := CONVERT(NUMBER_TO_CHAR, l_R304DBA.SeqFop);
			l_DesRes := 'Mês/Ano: ' || l_AnoMesStr || ', Número Sequencial Folha: ' || l_SeqFopStr;
	
			/* Inclui registro de status na tabela R304STA */
			SP_GERSTA_ESFINGE(14, l_PidSta, l_R304DBA.AnoMes, l_DesRes, l_R304DBA.NumEmp, l_R304DBA.TipCol, l_R304DBA.NumCad);
		END IF;
		
		BEGIN
			UPDATE R304DBA
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304DBA.NumEmp
			   AND TIPCOL = l_R304DBA.TipCol
			   AND NUMCAD = l_R304DBA.NumCad 
			   AND NUMCPF = l_R304DBA.NumCpf
			   AND NUMMAT = l_R304DBA.NumMat 
			   AND ANOMES = l_R304DBA.AnoMes
			   AND SEQFOP = l_R304DBA.SeqFop	   
			   AND SEQREG = l_R304DBA.SeqReg;
		EXCEPTION WHEN OTHERS THEN
			RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304DBA.';
		END;	
	END LOOP;
END␀å␀␀		SENIOR;0í␀␀TRIGGER R304DBA_EI BEFORE INSERT ON R304DBA FOR EACH ROW
DECLARE
	l_SeqReg NUMBER(9);
	l_StaEnv CHAR;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Busca última sequência cadastrada */
	BEGIN
		SELECT DBA.SEQREG, STA.STAENV INTO l_SeqReg, l_StaEnv 
		  FROM R304DBA DBA, R304STA STA
		 WHERE DBA.PIDSTA = STA.PIDSTA
		   AND DBA.NUMEMP = :NEW.NumEmp
		   AND DBA.TIPCOL = :NEW.TipCol
		   AND DBA.NUMCAD = :NEW.NumCad
		   AND DBA.NUMCPF = :NEW.NumCpf
		   AND DBA.NUMMAT = :NEW.NumMat
		   AND DBA.ANOMES = :NEW.AnoMes
		   AND DBA.SEQFOP = :NEW.SeqFop
		   AND DBA.SEQREG = (SELECT MAX(DBA2.SEQREG) FROM R304DBA DBA2
		   					  WHERE DBA2.NUMEMP = DBA.NUMEMP
					 		    AND DBA2.TIPCOL = DBA.TipCol
		    					AND DBA2.NUMCAD = DBA.NumCad
		    					AND DBA2.NUMCPF = DBA.NumCpf
		   						AND DBA2.NUMMAT = DBA.NumMat
		   						AND DBA2.ANOMES = DBA.AnoMes
		   						AND DBA2.SEQFOP = DBA.SeqFop
		   					    AND DBA2.SEQREG < DBA.SeqReg);
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
			l_StaEnv := '';
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304DBA.';
	END;
	
	/* Verifica se encontrou última sequência */
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
		
		/* Verifica se a última sequência está com status Cancelado. Se não estiver, não permite o cadastro de um novo registro para a mesma folha de pagamento. */
		IF (l_StaEnv <> 'N') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);			
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que o registro de sequência ' || l_SeqRegStr || ' esteja com status Cancelado.';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀å␀␀		SENIOR;01␀␀

TRIGGER R304DBA_EU BEFORE UPDATE ON R304DBA FOR EACH ROW
DECLARE
	l_StaEnv CHAR;
BEGIN
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio e Erro Envio podem ser alterados.';
	END IF;
END␀‘å␀␀	SENIOR;0/␀␀

TRIGGER R304DBA_SD AFTER DELETE ON R304DBA
BEGIN
	BEGIN
		DELETE FROM R304STA
		 WHERE LAYOUT = 14
		   AND NOT EXISTS (SELECT 1 FROM R304DBA WHERE R304DBA.PIDSTA = R304STA.PIDSTA);
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao excluir registros não utilizados na tabela R304STA';
	END;	
END␀å␀␀		SENIOR;0J

TRIGGER R304DBA_AD AFTER DELETE ON R304DBA FOR EACH ROW
BEGIN
	NULL;
END␀␀␀*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀“å␀␀…¬␀␀´␀	Ôÿ?ü␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀‚¬␀␀	Ôÿ?ü␀␀␀␀Ä±␀␀<¯␀␀\±␀␀%␀␀ÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀X␀§Ôÿ?ü␀␀␀␀ó␀²␀²␀p␀Æÿ␀␀ÿ␀ÌEÑ␀Ôÿ␀␀␀␀␀NJöHóIqC␀␀êÿ␀␀ÿ␀{EÑ␀Ôÿ␀␀␀␀␀<JnHËIqC␀êÿ␀␀ÿ␀q¬␀␀Ôÿ␀␀␀␀␀¸±␀␀;¯␀␀:±␀␀%␀␀␀ÿ␀␀ÿ␀½␀5Ôÿ␀␀␀␀␀å␀Ä␀Ô␀n␀␀Æÿ␀␀ÿ␀èÄ␀␀­␀Ôÿ␀␀␀␀␀‰
␀üÄ␀␀ıÄ␀␀p␀␀Æÿ␀␀ÿ␀5Â␀␀EÔÿ␀␀␀␀␀,Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀␀␀”å␀␀	␀␀0;1;2›å␀␀	SENIOR;0÷␀␀

TRIGGER R304ECO_SI AFTER INSERT ON R304ECO
DECLARE
    CURSOR c_R304ECO IS
    SELECT NUMEMP, NUMEDI, SEQREG, DATPUB
      FROM R304ECO
     WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');

    TYPE t_R304ECO IS RECORD (
        NUMEMP   R304ECO.NumEmp%TYPE,
        NUMEDI   R304ECO.NumEdi%TYPE,
        SEQREG   R304ECO.SeqReg%TYPE,
        DATPUB   R304ECO.DatPub%TYPE
    );

    l_R304ECO t_R304ECO;
    l_PidSta VARCHAR2(30);
    l_DesRes VARCHAR2(250);
BEGIN
    FOREACH c_R304ECO INTO l_R304ECO.NumEmp, l_R304ECO.NumEdi, l_R304ECO.SeqReg, l_R304ECO.DatPub
    LOOP
        /* Gera um novo PID */
        SP_GERPIDSTA(l_R304ECO.NumEmp, 20, l_PidSta OUT);

        /* Inclui registro de status na tabela R304STA */
        l_DesRes := 'Número do Edital: ' || l_R304ECO.NumEdi;
        SP_GERSTA_ESFINGE(20, l_PidSta, l_R304ECO.DatPub, l_DesRes, l_R304ECO.NumEmp, 0, 0);
        
        BEGIN
            UPDATE R304ECO 
               SET PIDSTA = l_PidSta
             WHERE NUMEMP = l_R304ECO.NumEmp
               AND NUMEDI = l_R304ECO.NumEdi
               AND SEQREG = l_R304ECO.SeqReg;
        EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304ECO.';
        END;
    END LOOP;
END␀˜å␀␀		SENIOR;0.␀␀TRIGGER R304ECO_EI BEFORE INSERT ON R304ECO FOR EACH ROW
DECLARE
    l_SeqReg   R304AEC.SeqReg%TYPE;
    l_SeqRegStr VARCHAR2(9);
    l_StaEnv   R304STA.StaEnv%TYPE;
    l_MsgErr VARCHAR2(255);
BEGIN
    /* Busca a última sequência cadastrada para a mesma Empresa/Edital */
    BEGIN
        SELECT MAX(SEQREG) INTO l_SeqReg
          FROM R304ECO
         WHERE NUMEMP = :NEW.NumEmp
           AND NUMEDI = :NEW.NumEdi
           AND SEQREG <> :NEW.SeqReg;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            l_SeqReg := 0;
        WHEN OTHERS THEN
            RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304ECO.';
    END;

    IF (l_SeqReg > 0) THEN
        /* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
        IF (:NEW.SeqReg < l_SeqReg) THEN
            l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
            l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
            RAISERROR 103 l_MsgErr;
        END IF;

        /* Busca o status da última sequência */
        BEGIN
            SELECT STA.STAENV INTO l_StaEnv
              FROM R304ECO ECO, R304STA STA
             WHERE ECO.NUMEMP = :NEW.NumEmp
               AND ECO.NUMEDI = :NEW.NumEdi
               AND ECO.SEQREG = l_SeqReg
               AND ECO.PIDSTA = STA.PIDSTA;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                RAISERROR 103 'Não encontrou status do último registro.';
            WHEN OTHERS THEN
                RAISERROR 103 'Erro ao buscar status do registro com última sequência na tabela R304ECO.';
        END;

        /* Verifica se a última sequência está com status Cancelado */
        IF (l_StaEnv <> 'N') THEN
            l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
            l_MsgErr := 'Não é possível incluir uma nova sequência sem que o registro de sequência ' || l_SeqRegStr || ' esteja com status Cancelado.';
            RAISERROR 103 l_MsgErr;
        END IF;
    END IF;
END␀–å␀␀		SENIOR;0ë␀␀

TRIGGER R304ECO_AU AFTER UPDATE ON R304ECO FOR EACH ROW
DECLARE
    CURSOR c_R304STA IS
	SELECT LAYOUT
	  FROM R304STA 
	 WHERE PIDSTA = :NEW.PIDSTA;
	
	TYPE t_R304STA IS RECORD (
		LAYOUT   R304STA.layout%TYPE
	);
	
	l_R304STA t_R304STA;
BEGIN
	IF (:OLD.DatPub <> :NEW.DatPub) THEN
		BEGIN
			UPDATE R304STA SET DATREF = :NEW.DatPub WHERE PIDSTA = :NEW.PidSta;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar data de referência na tabela R304STA';
		END;
	END IF;
END␀™å␀␀		SENIOR;0¼␀␀

TRIGGER R304ECO_EU BEFORE UPDATE ON R304ECO FOR EACH ROW
DECLARE
    l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
    /* Não deixa alterar registro caso status seja diferente de P - Pendente Envio e R - Erro Envio */
    SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
    IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
        RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados.';
    END IF;
END␀šå␀␀	SENIOR;0Y␀␀

TRIGGER R304ECO_SD AFTER DELETE ON R304ECO
BEGIN
    BEGIN
        DELETE FROM R304STA
         WHERE LAYOUT = 20
           AND NOT EXISTS (SELECT 1 FROM R304ECO WHERE R304ECO.PIDSTA = R304STA.PIDSTA);
    EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro ao excluir registros não utilizados na tabela R304STA.';
    END;
END␀•å␀␀		SENIOR;0

TRIGGER R304ECO_AD AFTER DELETE ON R304ECO FOR EACH ROW
BEGIN
    /* Exclui registro de status na tabela R304STA */
    SP_EXCSTA_ESFINGE(:OLD.PidSta);
END␀—å␀␀		SENIOR;0E␀␀

TRIGGER R304ECO_ED BEFORE DELETE ON R304ECO FOR EACH ROW
DECLARE
    l_QtdReg NUMBER;
BEGIN
    /* Verifica se tem registros na tabela filha R304AEC */
    l_QtdReg := 0;
    BEGIN
        SELECT COUNT(1) INTO l_QtdReg FROM R304AEC WHERE PIDSTA = :OLD.PidSta;
    EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro ao buscar quantidade de registros na tabela R304AEC.';
    END;
    IF (l_QtdReg > 0) THEN
        RAISERROR 103 'Não é possível efetuar a exclusão do Concurso/Processo Seletivo, pois existem documento(s) cadastrados para o mesmo.';
    END IF;
END␀␀␀+*␀␀␀␀␀␀␀␀␀␀␀␀œå␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ?␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ?␀␀␀␀␀P%€$0.w␀Æÿ␀␀…Ó␀␀␀[¬␀␀	Ôÿ?␀␀␀␀␀±␀␀3¯␀␀±␀␀%␀␀ÿ␀␀ÿ␀ª¬␀␀	Ôÿ?␀␀␀␀␀!°␀␀H¯␀␀°␀␀%␀␀ÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀Ø&␀Ñ␀	Ôÿ␀␀␀␀␀àMë”␀␀î”␀␀qC␀êÿ␀␀ÿ␀␀oÑ␀Ôÿ␀␀␀␀␀òMÅFMqC␀␀êÿ␀␀ÿ␀—È␀␀Ñ␀	Ôÿ␀␀␀␀␀hKnHgKqC␀êÿ␀␀ÿ␀Ü^>Ôÿ?␀␀␀␀␀èXÑ^èX=␀␀␀ÿ␀␀ÿ␀␀¤	Ôÿ␀␀␀␀␀U␀U␀U␀p␀Æÿ␀␀ÿ␀U'	Ôÿ?␀␀␀␀␀ıAµ'ÿ?%␀␀ÿ␀␀ÿ␀Ù&␀Ñ␀	Ôÿ␀␀␀␀␀+Kì”␀␀ï”␀␀qC␀êÿ␀␀ÿ␀ÙTÔÿ?␀␀␀␀␀ªš␀␀WÇW␀␀␀ÿ␀␀ÿ␀y¬␀␀Ôÿ?␀␀␀␀␀÷¯␀␀8¯␀␀r¯␀␀%␀␀␀ÿ␀␀ÿ␀%␀␀nÔÿ?␀␀␀␀␀Ÿ°␀␀Û␀İ␀l␀␀␀ÿ␀␀ÿ␀‚¬␀␀Ôÿ?␀␀␀␀␀^±␀␀<¯␀␀\±␀␀%␀␀␀ÿ␀␀ÿ␀š¬␀␀Ôÿ␀␀␀␀␀Š°␀␀>¯␀␀‚°␀␀%␀␀␀ÿ␀␀ÿ␀F␀Ÿ␀Ôÿ␀␀␀␀␀$␀?"␀$␀l)␀␀␀Æÿ␀␀ÿ␀ÿ␀H	Ôÿ␀␀␀␀␀&␀Ÿ␀&␀p␀Æÿ␀␀ÿ␀}DÑ␀	Ôÿ␀␀␀␀␀ñL!FğLqC␀êÿ␀␀ÿ␀İ^	Ôÿ?␀␀␀␀␀3Xv´W␀␀ÿ␀␀ÿ␀i␀û	Ôÿ␀␀␀␀␀°e°e°ep␀Æÿ␀␀ÿ␀&EÑ␀Ôÿ␀␀␀␀␀*MõG(MqC␀␀êÿ␀␀ÿ␀D␀␀=	Ôÿ?␀␀␀␀␀ ␀␀øŒ␀␀[␀␀c␀␀␀ÿ␀␀ÿ␀<␀␀=	Ôÿ?␀␀␀␀␀␀␀óŒ␀␀X␀␀c␀␀␀ÿ␀␀ÿ␀W§␀␀Ôÿ?␀␀␀␀␀ÇX¨␀␀i©␀␀␀␀␀ÿ␀␀ÿ␀z,¶Ôÿ␀␀␀␀␀ñ<·e¹ep␀␀Æÿ␀␀ÿ␀␀iÔÿ?␀␀␀␀␀İ␀Å␀­␀p␀␀Æÿ␀␀ÿ␀ÏÉ␀␀Á␀Ôÿ␀␀␀␀␀>Í␀␀nÉ␀␀Ì␀␀y␀␀Æÿ␀␀ÿ␀c␀␀=	Ôÿ?␀␀␀␀␀¡␀␀õÍ␀␀s␀␀c␀␀␀ÿ␀␀ÿ␀†DÑ␀Ôÿ␀␀␀␀␀vIiFuIqC␀␀êÿ␀␀ÿ␀␀␀=	Ôÿ?␀␀␀␀␀q␀␀␀␀p␀␀c␀␀␀ÿ␀␀ÿ␀|¬␀␀@Ôÿ?␀␀␀␀␀°␀␀C¬␀␀°␀␀@␀␀␀ÿ␀␀ÿ␀°DÑ␀Ôÿ␀␀␀␀␀qIEDqIqC␀␀êÿ␀␀ÿ␀f´␀Ôÿ?␀␀␀␀␀÷<ïe»fr␀␀Æÿ␀␀)Ñ␀␀␀0,4Ôÿ?␀␀␀␀␀ÿ?µ'µ'}␀␀␀ÿ␀␀Ñ␀␀␀5Â␀␀EÔÿ␀␀␀␀␀,Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀)+Ñ␀Ôÿ␀␀␀␀␀M&M&M&qC␀␀êÿ␀␀ÿ␀++Ñ␀Ôÿ␀␀␀␀␀U&U&U&qC␀