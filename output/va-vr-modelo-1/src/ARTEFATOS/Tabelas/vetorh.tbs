DECLARE
	l_layoutAlteracaoContrato VARCHAR2(6);
    l_DataZero DATE;
BEGIN
	/* Inclui as Solicitações de Exames Periódicos cadastrados para a Transferência de Função */
	RH_EXA_FUNCAO(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATINI, :NEW.DATFIM, :NEW.ESTCAR, :NEW.CODCAR);

	/* eSocial */
	IF (:NEW.FUNESO = 'S') THEN
		RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);
		IF (l_layoutAlteracaoContrato IS NOT NULL) THEN    
		  SP_TAB_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIESO, :NEW.DATFIM, 'R038HFU', 'I', '', '', 0, 'R038HFU_EI');
		  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
		  IF (l_DataZero <> :NEW.DATFIM) THEN
            SP_HIST_DT_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATFIM, 'R038HFU', 'INIESO', 'I', '', '', ' AND FUNESO = ''S''', 0, 'R038HFU_EI');
          END IF;   
		END IF;
  	END IF;
	/* eSocial */
END␀õÔ␀␀		SENIOR;0	␀␀

TRIGGER R038HFU_EU AFTER UPDATE ON R038HFU FOR EACH ROW
DECLARE
	l_OriExa NUMBER(3);	
	l_Alterou BOOLEAN;
	l_AlterouSomenteDataFim BOOLEAN;
	l_Valido BOOLEAN;
	l_layoutAlteracaoContrato VARCHAR2(6);
	l_JsonCamposAlterados VARCHAR2(2000);
BEGIN
	/* Busca a Origem do Exame com o Tipo especificado */
	l_OriExa := 0;
	RH_RETORIEXA(11, l_OriExa OUT);

	IF (l_OriExa > 0) THEN
		/* Inclui as Solicitações de Exames Periódicos cadastrados para a Transferência de Função e
		Exclui as Solicitações cadastradas anteriormente */
		RH_EXC_SOLIC('F', :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATINI, l_OriExa);
		RH_EXA_FUNCAO(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATINI, :NEW.DATFIM, :NEW.ESTCAR, :NEW.CODCAR);
	END IF;
 
	/* eSocial */	
	IF ((:NEW.FUNESO = 'S') OR (:OLD.FUNESO = 'S')) THEN	
		l_Alterou := FALSE;
		l_AlterouSomenteDataFim := FALSE;
		l_JsonCamposAlterados := '';

		SP_VALUPDATE_NUM(:OLD.ESTCAR, :NEW.ESTCAR, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('ESTCAR', :NEW.EstCar, :OLD.EstCar, l_JsonCamposAlterados OUT);
		END IF;
	
		SP_VALUPDATE_DES(:OLD.CODCAR, :NEW.CODCAR, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('CODCAR', :NEW.CodCar, :OLD.CodCar, l_JsonCamposAlterados OUT);
		END IF;
		
		SP_VALUPDATE_DES(:OLD.FUNESO, :NEW.FUNESO, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('FUNESO', :NEW.FunEso, :OLD.FunEso, l_JsonCamposAlterados OUT);
		END IF;	

		SP_VALUPDATE_DAT(:OLD.DATFIM, :NEW.DATFIM, l_Valido OUT);		
		IF (l_Valido = TRUE) THEN
			IF (l_Alterou = FALSE) THEN
				l_AlterouSomenteDataFim := TRUE;
			END IF;
			l_Alterou := TRUE;
			SP_CONCAT_DAT_JSON('DATFIM', :NEW.DatFim, :OLD.DatFim, l_JsonCamposAlterados OUT);
		END IF;	
		
		IF (l_Alterou = TRUE) THEN 
			RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);
			IF (l_layoutAlteracaoContrato IS NOT NULL) THEN			
				SP_ALT_TAB_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIESO, :NEW.DATFIM, :OLD.DATFIM, 'R038HFU', '', l_JsonCamposAlterados, l_AlterouSomenteDataFim, 'INIESO', ' AND FUNESO = ''S''', 0, 'R038HFU_EU');
			END IF;
		END IF;
	END IF;
	/* eSocial */
END␀óÔ␀␀		SENIOR;06␀␀

TRIGGER R038HFU_ED AFTER DELETE ON R038HFU FOR EACH ROW
DECLARE
	l_OriExa NUMBER(3);
	l_layoutAlteracaoContrato VARCHAR2(6);      
BEGIN
	/* Busca a Origem do Exame com o Tipo especificado */
	l_OriExa := 0;
	RH_RETORIEXA(11, l_OriExa OUT);

	IF (l_OriExa > 0) THEN
		/* Exclui as Solicitações cadastradas anteriormente */
		RH_EXC_SOLIC('F', :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATINI, l_OriExa);
	END IF;

	/* eSocial */
	IF (:OLD.FUNESO = 'S') THEN
		RH_LAY_CONTR_COLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layoutAlteracaoContrato OUT);
		IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
			SP_TAB_ESOCIAL(l_layoutAlteracaoContrato, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.INIESO, :OLD.DATFIM, 'R038HFU', 'E', '', '', 0, 'R038HFU_ED');
		END IF;	  
	END IF;  
	/* eSocial */
END␀␀␀Œv␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀öÔ␀␀…¬␀␀´␀	Ôï!␀␀␀␀␀‘<XbXbr‡␀Æÿ␀␀Ò␀␀␀.␀t	Ôï!␀␀␀␀␀Ü␀t␀Ü␀n¼‡␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôï!␀␀␀␀␀.%0.0.wˆ␀Æÿ␀␀…Ó␀␀␀-Ç␀	Ôï!␀␀␀␀␀e=¹·␀␀¹·␀␀z␀Æÿ␀␀ÖÒ␀␀␀‰-´␀	Ôï!␀␀␀␀␀ˆ?ˆ?ˆ?r␀Æÿ␀␀®Ñ␀␀␀EÑ␀	Ôï!␀␀␀␀␀?K¢G¢GqC␀êÿ␀␀8Õ␀␀␀¼½␀␀Ä␀Ôï!␀␀␀␀␀†††S)␀␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3;5;4␀␀üv␀␀␀␀␀␀␀␀÷Ô␀␀…¬␀␀´␀	Ôï1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôï1␀␀␀␀␀Ü␀t␀Ü␀n%ˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôï1␀␀␀␀␀.%0.0.w"ˆ␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ôï1␀␀␀␀␀HIşEşEqC#ˆ␀êÿ␀␀ÿ␀Ş␀´␀Ôï1␀␀␀␀␀>½␀␀r␀Æÿ␀␀YĞ␀␀␀§¬␀␀Ì␀Ôï1␀␀␀␀␀İ«␀␀Û«␀␀Û«␀␀m$ˆ␀Æÿ␀␀aĞ␀␀␀2=Ôï1␀␀␀␀␀d4‡␀ÿ␀c␀␀␀ÿ␀␀ÿ␀2=Ôï1␀␀␀␀␀e4ˆ␀␀␀c␀␀␀ÿ␀␀ÿ␀*␀áÔï1␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀xš␀␀Á␀Ôï1␀␀␀␀␀¤␀␀Ñš␀␀Ñš␀␀/␀Æÿ␀␀Û␀␀␀‘¢␀␀±␀Ôï1␀␀␀␀␀&£␀␀ß¢␀␀ß¢␀␀q␀Æÿ␀␀*Û␀␀␀␀␀øÔ␀␀␀ùÔ␀␀␀␀0;1;2;3␀Õ␀␀	SENIOR;0Q␀␀

/* Trigger Insert - Statement */
TRIGGER R038HLO_SI AFTER INSERT ON R038HLO

DECLARE
/* CURSOR c/ os registros gravados no R038HLO_AUX */
  CURSOR c_r038hlo_ins IS SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, TABORG, NUMLOC FROM R038HLO_AUX;

  TYPE t_r038HLO_aux IS RECORD(
    NUMEMP   R038HLO_AUX.NUMEMP%TYPE,
    TIPCOL   R038HLO_AUX.TIPCOL%TYPE,
    NUMCAD   R038HLO_AUX.NUMCAD%TYPE,
    DATALT   R038HLO_AUX.DATALT%TYPE,
    TABORG   R038HLO_AUX.TABORG%TYPE,
    NUMLOC   R038HLO_AUX.NUMLOC%TYPE);

  l_r038HLO_aux t_r038HLO_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r038hlo_ins INTO  l_r038HLO_aux.NUMEMP,
                              l_r038HLO_aux.TIPCOL,
                              l_r038HLO_aux.NUMCAD,
                              l_r038HLO_aux.DATALT,
                              l_r038HLO_aux.TABORG,
                              l_r038HLO_aux.NUMLOC
  LOOP
    /* Atualiza o Quadro Efetivo - QL */
    QL_INCLOCAL(l_r038HLO_aux.NumEmp, l_r038HLO_aux.TipCol, l_r038HLO_aux.NumCad, l_r038HLO_aux.DatAlt, l_r038HLO_aux.TabOrg, l_r038HLO_aux.NumLoc, l_r038HLO_aux.DatAlt, l_r038HLO_aux.TabOrg, l_r038HLO_aux.NumLoc);
  END LOOP;

  /* Apaga Registro OLD em R038HLO_AUX */
  BEGIN
    DELETE FROM R038HLO_AUX;
    DROP_TEMP_TABLE R038HLO_AUX;
  EXCEPTION
    WHEN OTHERS THEN
      NULL;
  END;
END␀üÔ␀␀		SENIOR;0Ó6␀␀

TRIGGER R038HLO_EI AFTER INSERT ON R038HLO FOR EACH ROW

DECLARE
  l_DatAdm         R034FUN.DATADM%TYPE;
  l_TemPenFut    BOOLEAN;
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_AltEmp         R038PEN.ALTEMP%TYPE;
  l_AltFil         R038PEN.ALTFIL%TYPE;
  l_AltLoc         R038PEN.ALTLOC%TYPE;
  l_AltCcu         R038PEN.ALTCCU%TYPE;
  l_AltCar         R038PEN.ALTCAR%TYPE;
  l_AltEsc         R038PEN.ALTESC%TYPE;
  l_AltDes         R038PEN.ALTDES%TYPE;
  l_SitChe         R038PEN.SITCHE%TYPE;
  l_SitUsu         R038PEN.SITUSU%TYPE;
  l_NesRev         R038PEN.NESREV%TYPE;
  l_EmpAtu         R038PEN.EMPATU%TYPE;
  l_CadAtu         R038PEN.CADATU%TYPE;
  l_ColChe       BOOLEAN;
  l_ColUsu       BOOLEAN;
  l_auxSitChe      R038PEN.SITCHE%TYPE;
  l_auxSitUsu      R038PEN.SITUSU%TYPE;
  l_AssTrfLoc      R000ASS.TRFLOC%TYPE; 
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  xCodLoc 		   R016HIE.CODLOC%TYPE;
  
  /* eSocial */
  l_layoutAlteracaoContrato VARCHAR2(6);
  l_UsaRat         R030EMP.UsaRat%TYPE;
  l_RotTom         R030EMP.RotTom%TYPE;
  l_IniTom         R030EMP.IniTom%TYPE;
  l_CodFil         R030FIL.CodFil%TYPE;
  l_TipFil         R030FIL.TipFil%TYPE;
  l_CdrFgt         R030FFG.CdrFgt%TYPE;
  l_DatTab         R030DES.DatTab%TYPE;
  l_DatUes         R030DES.DatUes%TYPE;
  l_IniNpe         R030DES.IniNpe%TYPE;
  l_IniPer         R030DES.IniPer%TYPE;
  l_IniSST         R030DES.IniSST%TYPE;
  l_IniMig         R030DES.DatMig%TYPE;

  /* SAMSenior */
  l_idtpes       VARCHAR2(23);
  l_taborg_str   VARCHAR2(4);
  l_numloc_str   VARCHAR2(9);
  l_valstr       VARCHAR2(38);
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HLO_AUX;
  
BEGIN
  BEGIN
    SELECT TRFLOC INTO l_AssTrfLoc
      FROM R000ASS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_AssTrfLoc := 0;
  END;

  IF (l_AssTrfLoc = 2) THEN
    /* Verifica se o colaborador está associado ao cadastro de chefia ou
       se o colaborador está associado com algum usuário */
    R038PEN_COLCHEFE(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_ColChe OUT, l_ColUsu OUT);

    /* Busca data de admissão do colaborador */
    BEGIN
      SELECT R034FUN.DATADM INTO l_DatAdm
        FROM R034FUN
       WHERE R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_DatAdm := '31/12/1900,00:00:00';
    END;

    /* Se o colaborador é chefe ou está associado a um usuário, e a data admissão for diferente da data
       do histórico gera pendência */
    IF ((l_ColChe = TRUE OR l_ColUsu = TRUE) AND (:NEW.DATALT <> l_DatAdm)) THEN
      /* Verifica se existe pendência numa data futura */
      R038PEN_TEMPENFUT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_TemPenFut OUT);

      /* se não existe pendência com data futura, verifica se existe pendência com data passada e situação não atendida */
      IF (l_TemPenFut = FALSE) THEN
        BEGIN
             SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU
               INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu
               FROM R038PEN
              WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                    R038PEN.TIPCOL = :NEW.TIPCOL AND
                    R038PEN.NUMCAD = :NEW.NUMCAD AND
                    R038PEN.DATTRF < :NEW.DATALT AND
                    ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
                     (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));
        EXCEPTION
             WHEN NO_DATA_FOUND THEN
                  l_NumEmp := 0;
                  l_TipCol := 0;
                  l_NumCad := 0;
                  l_DatTrf := '31/12/1900,00:00:00';
        END;

        /* Considera que sempre altera Local na inclusão do histórico de Local para criação da pendência */
        l_AltLoc := 'S';

        /* Verifica se deve gerar pendencia de chefia */
        IF (l_ColChe = TRUE) THEN
          l_SitChe := 1; /* Não Atendida */
        ELSE
          l_SitChe := 3; /* Sem necessidade de Alteração */
        END IF;

        /* Verifica se deve gerar pendencia de usuário */
        IF (l_ColUsu = TRUE) THEN
          l_SitUsu := 1; /* Não Atendida */
        ELSE
          l_SitUsu := 4; /* Sem necessidade de Alteração */
        END IF;

        /* Se existir uma pendência com data passada e situação 1 (Não atendida), esta
           será excluída e regerada com a nova data */
        IF (l_NumCad <> 0) THEN

          /* Insere nova pendência com base nos valores da pendência da data passada */
          BEGIN
            INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu);
          EXCEPTION
            WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
          END;

          /* Deleta pendência da data passada */
          R038PEN_DELPENPAS(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATALT);

        ELSE
          /* Verifica se existe pendência na mesma data de alteração */
          BEGIN
               SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, SITCHE, SITUSU INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_auxSitChe, l_auxSitUsu
                 FROM R038PEN
                WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                      R038PEN.TIPCOL = :NEW.TIPCOL AND
                      R038PEN.NUMCAD = :NEW.NUMCAD AND
                      R038PEN.DATTRF = :NEW.DATALT;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_NumEmp := 0;
                    l_TipCol := 0;
                    l_NumCad := 0;
                    l_DatTrf := '31/12/1900,00:00:00';
                    l_auxSitChe := 0;
                    l_auxSitUsu := 0;
          END;

          /* Se existir pendência na mesma data, atualiza a pendência */
          IF (l_NumCad <> 0) THEN

            IF ((l_auxSitChe = 1 OR l_auxSitChe = 3) AND
                (l_auxSitUsu = 1 OR l_auxSitUsu = 4)) THEN

              /* Atualiza pendência */
              BEGIN
                UPDATE R038PEN
                   SET ALTLOC = l_AltLoc, SITCHE = l_SitChe, SITUSU = l_SitUsu
                 WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                       R038PEN.TIPCOL = :NEW.TIPCOL AND
                       R038PEN.NUMCAD = :NEW.NUMCAD AND
                       R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;

            ELSE
              /* Se a Situação for diferente de "Não atendida" ou "Sem necessidade de alteração", então
                 indica na pendência que necessita Revisão */
              BEGIN
                UPDATE R038PEN SET ALTLOC = l_AltLoc, NESREV = 'S'
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            END IF;

          ELSE

            /* Insere nova pendência */
            BEGIN
              INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'N', 'N', l_AltLoc, 'N', 'N', 'N', 'N', l_SitChe, l_SitUsu, 'N', 0, 0);
            EXCEPTION
              WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
            END;

          END IF;
        END IF;
      END IF;

    END IF;
  END IF;

  IF (:NEW.STAHIS = 1) THEN
    R038HLO_HFI(:NEW.TIPCOL,:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATALT,:NEW.TABORG,:NEW.NUMLOC);
  END IF;

  BEGIN
    /* Insere Registro Old */
    INSERT INTO R038HLO_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, TABORG, NUMLOC)
                     VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, :NEW.TABORG, :NEW.NUMLOC);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R038HLO_AUX.';
  END;

  /* Inclui as Solicitações de Exames Periódicos cadastrados para a Transferência de Local */
  RH_EXA_LOCAL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, :NEW.TABORG, :NEW.NUMLOC);

  /* Inclui Posto Padrao */
  /* Está sendo Tratado aqui, pois há uma limitação do banco informix onde não é possivel fazer */
  /* o tratamento direto pela trigger da R034FUN_SI. (Erro (-747) do informix)                  */
  SP_GERAPOSTO(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);  
  
  /* Inicio - Geração de logs HistoricoLocal*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 77;     /* HistoricoLocal*/
  l_codtpa := 265;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HLO_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HLO_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :NEW.TABORG));
        RH_RET_CODLOC(:NEW.TABORG,:NEW.NUMLOC,:NEW.DATALT, xCodLoc OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', xCodLoc);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONTOV', :NEW.CONTOV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONTOS', :NEW.CONTOS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LOCTRA', CONVERT(NUMBER_TO_CHAR, :NEW.LOCTRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MOTALT', CONVERT(NUMBER_TO_CHAR, :NEW.MOTALT));
      END;
  END IF; 
  /* Fim - Geração de logs HistoricoLocal*/
  
  /* eSocial */
  RH_LAY_CONTR_COLAB(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_layoutAlteracaoContrato OUT);
  IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
    /* Busca o valor dos campos Rateio MO Cálculo e Usa Rotina Tomadores do cadastro da empresa */
    BEGIN
  	  SELECT UsaRat, RotTom, IniTom INTO l_UsaRat, l_RotTom, l_IniTom FROM R030EMP WHERE NUMEMP = :NEW.NumEmp;
    EXCEPTION
  	  WHEN OTHERS THEN
	    RAISERROR 103 'Erro no buscar informações da empresa.';
    END;

    /* Verifica se utiliza rateio de mão de obra por local */
    IF (l_UsaRat = 'L') THEN
      /* Verifica se utiliza rotina de tomadores por rateio */
      IF (l_RotTom = 'R' AND l_IniTom < :NEW.DatAlt) THEN
        /* Se a Data de Alteração é maior que o Inicio dos Não Periódicos */
        RH_DEF_ESOCIAL(:NEW.NumEmp, l_DatTab OUT, l_DatUes OUT, l_IniNpe OUT, l_IniPer OUT, l_IniSST OUT, l_IniMig OUT);
      	IF (:NEW.DATALT > l_IniNpe) THEN
      	  l_IniNpe := :NEW.DATALT;
      	END IF;
      
        /* Busca filial do colaborador */
        RH_RETFILCOL(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_IniNpe, l_CodFil OUT);
    
        /* Busca o tipo da filial */
        RH_RETTIPFIL(:NEW.NumEmp, l_CodFil, l_TipFil OUT);
    
        IF (l_TipFil = 'O') THEN /* O = Obra */
          /* Busca codigo do recolhimento de FGTS */
          RH_RETCDRFGTFIL(:NEW.NumEmp, l_CodFil, :NEW.DatAlt, l_CdrFgt OUT);

          IF (l_CdrFgt = 155) THEN /* 155 = Obra de Construção Civil */
		    SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, :NEW.DatAlt, 'R038HLO', 'DATALT', 'I', '', '', 0, 'R038HLO_EI');
		  END IF;
		END IF;       
      END IF;
    END IF;
  END IF;

  /* Pendência SAMSenior */
  IF (:NEW.STAHIS = 1) THEN
    SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_INTSTR(:NEW.TABORG, '9999', l_taborg_str OUT);
    SP_INTSTR(:NEW.NUMLOC, '999999999', l_numloc_str OUT);
    l_valstr := '2H' || l_idtpes || l_taborg_str || l_numloc_str;
    SP_SAM_PENDENCIES(35, 1, l_valstr);
  END IF;

END␀Õ␀␀	SENIOR;0Ù␀␀

/* Trigger Update - Statement */
TRIGGER R038HLO_SU AFTER UPDATE ON R038HLO

DECLARE
/* CURSOR c/ os registros gravados no R038HLO_AUX */
  CURSOR c_r038HLO_upd IS
    SELECT NUMEMP, TIPCOL, NUMCAD, DATALT, TABORG, NUMLOC, EMPOLD, TIPOLD, CADOLD, DATOLD, ORGOLD, LOCOLD
      FROM R038HLO_AUX WHERE (TABORG <> ORGOLD OR NUMLOC <> LOCOLD);

  TYPE t_r038HLO_aux IS RECORD(
    NUMEMP   R038HLO_AUX.NUMEMP%TYPE,
    TIPCOL   R038HLO_AUX.TIPCOL%TYPE,
    NUMCAD   R038HLO_AUX.NUMCAD%TYPE,
    DATALT   R038HLO_AUX.DATALT%TYPE,
    TABORG   R038HLO_AUX.TABORG%TYPE,
    NUMLOC   R038HLO_AUX.NUMLOC%TYPE,
    EMPOLD   R038HLO_AUX.EMPOLD%TYPE,
    TIPOLD   R038HLO_AUX.TIPOLD%TYPE,
    CADOLD   R038HLO_AUX.CADOLD%TYPE,
    DATOLD   R038HLO_AUX.DATOLD%TYPE,
    ORGOLD   R038HLO_AUX.ORGOLD%TYPE,
    LOCOLD   R038HLO_AUX.LOCOLD%TYPE
    );

  xR038HLO_aux t_r038HLO_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r038HLO_upd INTO  xR038HLO_aux.NUMEMP,
                              xR038HLO_aux.TIPCOL,
                              xR038HLO_aux.NUMCAD,
                              xR038HLO_aux.DATALT,
                              xR038HLO_aux.TABORG,
                              xR038HLO_aux.NUMLOC,
                              xR038HLO_aux.EMPOLD,
                              xR038HLO_aux.TIPOLD,
                              xR038HLO_aux.CADOLD,
                              xR038HLO_aux.DATOLD,
                              xR038HLO_aux.ORGOLD,
                              xR038HLO_aux.LOCOLD
  LOOP
    /* Atualiza o Quadro Efetivo - QL */
    QL_EXCLOCAL(xR038HLO_aux.EmpOld, xR038HLO_aux.TipOld, xR038HLO_aux.CadOld, xR038HLO_aux.DatOld, xR038HLO_aux.ORGOLD, xR038HLO_aux.LocOld, xR038HLO_aux.DatAlt, xR038HLO_aux.TabOrg, xR038HLO_aux.NumLoc);

    QL_INCLOCAL(xR038HLO_aux.NumEmp, xR038HLO_aux.TipCol, xR038HLO_aux.NumCad, xR038HLO_aux.DatAlt, xR038HLO_aux.TabOrg, xR038HLO_aux.NumLoc, xR038HLO_aux.DatAlt, xR038HLO_aux.TabOrg, xR038HLO_aux.NumLoc);
  END LOOP;

  /* Apaga registros da R038HLO_AUX */
  BEGIN
    DELETE FROM R038HLO_AUX;
    DROP_TEMP_TABLE R038HLO_AUX;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na exclusão dos registros da R038HLO_AUX';
  END;
END␀ıÔ␀␀		SENIOR;0ğ<␀␀

TRIGGER R038HLO_EU AFTER UPDATE ON R038HLO FOR EACH ROW

DECLARE
  l_OriExa       NUMBER(3);
  l_TemPenFut    BOOLEAN;
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_AltEmp         R038PEN.ALTEMP%TYPE;
  l_AltFil         R038PEN.ALTFIL%TYPE;
  l_AltLoc         R038PEN.ALTLOC%TYPE;
  l_AltCcu         R038PEN.ALTCCU%TYPE;
  l_AltCar         R038PEN.ALTCAR%TYPE;
  l_AltEsc         R038PEN.ALTESC%TYPE;
  l_AltDes         R038PEN.ALTDES%TYPE;
  l_SitChe         R038PEN.SITCHE%TYPE;
  l_SitUsu         R038PEN.SITUSU%TYPE;
  l_NesRev         R038PEN.NESREV%TYPE;
  l_EmpAtu         R038PEN.EMPATU%TYPE;
  l_CadAtu         R038PEN.CADATU%TYPE;
  l_ColChe       BOOLEAN;
  l_ColUsu       BOOLEAN;
  l_auxSitChe      R038PEN.SITCHE%TYPE;
  l_auxSitUsu      R038PEN.SITUSU%TYPE;  
  l_AssTrfLoc      R000ASS.TRFLOC%TYPE;  
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  xCodLoc 		   R016HIE.CODLOC%TYPE;
  
  /* eSocial */
  l_Alterou BOOLEAN;
  l_Valido BOOLEAN;
  l_Valor VARCHAR2(2000);
  l_JsonCamposAlterados VARCHAR2(2000);
  l_layoutAlteracaoContrato VARCHAR2(6);
  l_UsaRat         R030EMP.UsaRat%TYPE;
  l_RotTom         R030EMP.RotTom%TYPE;
  l_IniTom         R030EMP.IniTom%TYPE;
  l_CodFil         R030FIL.CodFil%TYPE;
  l_TipFil         R030FIL.TipFil%TYPE;
  l_CdrFgt         R030FFG.CdrFgt%TYPE;
  l_DatTab         R030DES.DatTab%TYPE;
  l_DatUes         R030DES.DatUes%TYPE;
  l_IniNpe         R030DES.IniNpe%TYPE;
  l_IniPer         R030DES.IniPer%TYPE;
  l_IniSST         R030DES.IniSST%TYPE;
  l_IniMig         R030DES.DatMig%TYPE;

  /* SAMSenior */
  l_idtpes       VARCHAR2(23);
  l_taborg_str   VARCHAR2(4);
  l_numloc_str   VARCHAR2(9);
  l_valstr       VARCHAR2(38);
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HLO_AUX;
  
BEGIN
  BEGIN
    SELECT TRFLOC INTO l_AssTrfLoc
      FROM R000ASS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_AssTrfLoc := 0;
  END;

  IF (l_AssTrfLoc = 2) THEN
    /* Verifica se o colaborador está associado ao cadastro de chefia ou
       se o colaborador está associado com algum usuário */
    R038PEN_COLCHEFE(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_ColChe OUT, l_ColUsu OUT);

    /* Se o colaborador é chefe ou está associado a um usuário gera pendência */
    IF (l_ColChe = TRUE OR l_ColUsu = TRUE) THEN
      /* Verifica se existe pendência numa data futura */
      R038PEN_TEMPENFUT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_TemPenFut OUT);

      /* se não existe pendência com data futura, verifica se existe pendência com data passada e situação não atendida */
      IF (l_TemPenFut = FALSE) THEN
        BEGIN
             SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU
               INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu
               FROM R038PEN
              WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                    R038PEN.TIPCOL = :NEW.TIPCOL AND
                    R038PEN.NUMCAD = :NEW.NUMCAD AND
                    R038PEN.DATTRF < :NEW.DATALT AND
                    ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
                     (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));
        EXCEPTION
             WHEN NO_DATA_FOUND THEN
                  l_NumEmp := 0;
                  l_TipCol := 0;
                  l_NumCad := 0;
                  l_DatTrf := '31/12/1900,00:00:00';
        END;

        /* Considera que sempre altera Local na inclusão do histórico de Local para criação da pendência */
        l_AltLoc := 'S';

        /* Verifica se deve gerar pendencia de chefia */
        IF (l_ColChe = TRUE) THEN
          l_SitChe := 1; /* Não Atendida */
        ELSE
          l_SitChe := 3; /* Sem necessidade de Alteração */
        END IF;

        /* Verifica se deve gerar pendencia de usuário */
        IF (l_ColUsu = TRUE) THEN
          l_SitUsu := 1; /* Não Atendida */
        ELSE
          l_SitUsu := 4; /* Sem necessidade de Alteração */
        END IF;

        /* Se existir uma pendência com data passada e situação 1 (Não atendida), esta
           será excluída e regerada com a nova data */
        IF (l_NumCad <> 0) THEN
          /* Insere nova pendência com base nos valores da pendência da data passada */
          BEGIN
            INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu);
          EXCEPTION
            WHEN OTHERS THEN
               RAISERROR 103 'Erro ao inserir registro na R038PEN.';
          END;

          /* Deleta pendência da data passada */
          R038PEN_DELPENPAS(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATALT);

        ELSE
          /* Verifica se existe pendência na mesma data de alteração */
          BEGIN
               SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, SITCHE, SITUSU INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_auxSitChe, l_auxSitUsu
                 FROM R038PEN
                WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                      R038PEN.TIPCOL = :NEW.TIPCOL AND
                      R038PEN.NUMCAD = :NEW.NUMCAD AND
                      R038PEN.DATTRF = :NEW.DATALT;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_NumEmp := 0;
                    l_TipCol := 0;
                    l_NumCad := 0;
                    l_DatTrf := '31/12/1900,00:00:00';
                    l_auxSitChe := 0;
                    l_auxSitUsu := 0;
          END;

          /* Se existir pendência na mesma data, atualiza a pendência */
          IF (l_NumCad <> 0) THEN

            IF ((l_auxSitChe = 1 OR l_auxSitChe = 3) AND
                (l_auxSitUsu = 1 OR l_auxSitUsu = 4)) THEN
              /* Atualiza pendência */
              BEGIN
                UPDATE R038PEN SET ALTLOC = l_AltLoc, SITCHE = l_SitChe, SITUSU = l_SitUsu
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            ELSE
              /* Se a Situação for diferente de "Não atendida" ou "Sem necessidade de alteração", então
                 indica na pendência que necessita Revisão */
              BEGIN
                UPDATE R038PEN SET ALTLOC = l_AltLoc, NESREV = 'S'
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            END IF;

          ELSE

            /* Insere nova pendência */
            BEGIN
              INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'N', 'N', l_AltLoc, 'N', 'N', 'N', 'N', l_SitChe, l_SitUsu, 'N', 0, 0);
            EXCEPTION
              WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
            END;

          END IF;
        END IF;
      END IF;

    END IF;
  END IF;
  
  IF :NEW.STAHIS = 1 THEN
    R038HLO_HFI(:NEW.TIPCOL,:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATALT,:NEW.TABORG,:NEW.NUMLOC);
  END IF;

  /* Insere registro na AUX para processar rotina do QL */
  BEGIN
    INSERT INTO R038HLO_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, TABORG, NUMLOC, EMPOLD, TIPOLD, CADOLD, DATOLD, ORGOLD, LOCOLD)
           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, :NEW.TABORG, :NEW.NUMLOC, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, :OLD.TABORG, :OLD.NUMLOC);
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro no INSERT do Registro NEW na R038HLO_AUX.';
  END;

  /* Busca a Origem do Exame com o Tipo especificado */
  l_OriExa := 0;
  RH_RETORIEXA(10, l_OriExa OUT);

  IF   (l_OriExa > 0) THEN
    /* Inclui as Solicitações de Exames Periódicos cadastrados para a Transferência de Local e
       Exclui as Solicitações cadastradas anteriormente */
    RH_EXC_SOLIC('L', :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, l_OriExa);
    RH_EXA_LOCAL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, :NEW.TABORG, :NEW.NUMLOC);
  END IF;

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
    
  /* Inicio - Geração de logs HistoricoLocal*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 77;     /* HistoricoLocal*/
  l_codtpa := 266;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.TabOrg <> :NEW.TabOrg)
   OR (:OLD.NumLoc <> :NEW.NumLoc)
   OR (:OLD.ConTov <> :NEW.ConTov)
   OR (:OLD.ConTos <> :NEW.ConTos)
   OR (:OLD.StaHis <> :NEW.StaHis)
   OR (:OLD.LocTra <> :NEW.LocTra)
   OR (:OLD.MotAlt <> :NEW.MotAlt)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HLO_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HLO_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTABORG', CONVERT(NUMBER_TO_CHAR, :OLD.TABORG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTABORG', CONVERT(NUMBER_TO_CHAR, :NEW.TABORG));
        RH_RET_CODLOC(:OLD.TABORG,:OLD.NUMLOC,:OLD.DATALT, xCodLoc OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMLOC', xCodLoc);
        RH_RET_CODLOC(:NEW.TABORG,:NEW.NUMLOC,:NEW.DATALT, xCodLoc OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMLOC', xCodLoc);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONTOV', :OLD.CONTOV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONTOV', :NEW.CONTOV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONTOS', :OLD.CONTOS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONTOS', :NEW.CONTOS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSTAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSTAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDLOCTRA', CONVERT(NUMBER_TO_CHAR, :OLD.LOCTRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWLOCTRA', CONVERT(NUMBER_TO_CHAR, :NEW.LOCTRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDMOTALT', CONVERT(NUMBER_TO_CHAR, :OLD.MOTALT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWMOTALT', CONVERT(NUMBER_TO_CHAR, :NEW.MOTALT));
      END;
    END IF; 
  END IF; 
  /* Fim - Geração de logs HistoricoLocal*/
  
  /* eSocial */
  SP_VALUPDATE_NUM(:OLD.NumLoc, :NEW.NumLoc, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
	l_Alterou := TRUE;
    SP_CONCAT_NUM_JSON('NUMLOC', :NEW.NumLoc, :OLD.NumLoc, l_JsonCamposAlterados OUT);		
  END IF;
  
  IF (l_Alterou = TRUE) THEN
    RH_LAY_CONTR_COLAB(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_layoutAlteracaoContrato OUT);
    IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
      /* Busca o valor dos campos Rateio MO Cálculo e Usa Rotina Tomadores do cadastro da empresa */
      BEGIN
  	    SELECT UsaRat, RotTom, IniTom INTO l_UsaRat, l_RotTom, l_IniTom FROM R030EMP WHERE NUMEMP = :NEW.NumEmp;
      EXCEPTION
  	    WHEN OTHERS THEN
	      RAISERROR 103 'Erro no buscar informações da empresa.';
      END;

      /* Verifica se utiliza rateio de mão de obra por local */
      IF (l_UsaRat = 'L') THEN
        /* Verifica se utiliza rotina de tomadores por rateio */
        IF (l_RotTom = 'R' AND l_IniTom < :NEW.DatAlt) THEN
          /* Se a Data de Alteração é maior que o Inicio dos Não Periódicos */
          RH_DEF_ESOCIAL(:NEW.NumEmp, l_DatTab OUT, l_DatUes OUT, l_IniNpe OUT, l_IniPer OUT, l_IniSST OUT, l_IniMig OUT);
      	  IF (:NEW.DATALT > l_IniNpe) THEN
      	    l_IniNpe := :NEW.DATALT;
      	  END IF;
        
          /* Busca filial do colaborador */
          RH_RETFILCOL(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_IniNpe, l_CodFil OUT);
    
          /* Busca o tipo da filial */
          RH_RETTIPFIL(:NEW.NumEmp, l_CodFil, l_TipFil OUT);
    
          IF (l_TipFil = 'O') THEN /* O = Obra */
            /* Busca codigo do recolhimento de FGTS */
            RH_RETCDRFGTFIL(:NEW.NumEmp, l_CodFil, :NEW.DatAlt, l_CdrFgt OUT);
            
            IF (l_CdrFgt = 155) THEN /* 155 = Obra de Construção Civil */ 
		      SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, :NEW.DatAlt, 'R038HLO', 'DATALT', 'A', '', l_JsonCamposAlterados, 0, 'R038HLO_EU');
		    END IF;
		  END IF;
		END IF;       
      END IF;
    END IF;
  END IF;

  /* Pendência SAMSenior */
  IF (:NEW.STAHIS = 1) AND ((:OLD.STAHIS = 0) OR (:NEW.TABORG <> :OLD.TABORG) OR (:NEW.NUMLOC <> :OLD.NUMLOC)) THEN
    SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_INTSTR(:NEW.TABORG, '9999', l_taborg_str OUT);
    SP_INTSTR(:NEW.NUMLOC, '999999999', l_numloc_str OUT);
    l_valstr := '2H' || l_idtpes || l_taborg_str || l_numloc_str;
    SP_SAM_PENDENCIES(35, 1, l_valstr);
  END IF;
END␀ÿÔ␀␀	SENIOR;0B␀␀TRIGGER R038HLO_SD AFTER DELETE ON R038HLO

DECLARE
l_numloc       NUMBER(9);
  l_datloc       DATE;
  l_taborg       NUMBER(4);
  l_datalt       DATE;
  l_comando_nulo BOOLEAN;

  l_idtpes       VARCHAR2(23);
  l_taborg_str   VARCHAR2(4);
  l_numloc_str   VARCHAR2(9);
  l_valstr       VARCHAR2(38);

  /* CURSOR c/ os registros gravados no R038HLO_AUX */
  CURSOR c_r038hlo_del IS SELECT NUMEMP,TIPCOL,NUMCAD,DATALT,TABORG,NUMLOC,STAHIS FROM R038HLO_AUX;

  TYPE t_r038HLO_aux IS RECORD(
    NUMEMP   R038HLO_AUX.NUMEMP%TYPE,
    TIPCOL   R038HLO_AUX.TIPCOL%TYPE,
    NUMCAD   R038HLO_AUX.NUMCAD%TYPE,
    DATALT   R038HLO_AUX.DATALT%TYPE,
    TABORG   R038HLO_AUX.TABORG%TYPE,
    NUMLOC   R038HLO_AUX.NUMLOC%TYPE,
    STAHIS   R038HLO_AUX.STAHIS%TYPE);

  l_r038HLO_aux t_r038HLO_aux;
BEGIN
  l_comando_nulo:=FALSE;

  /* Le Registro do CURSOR */
  FOREACH c_r038hlo_del INTO  l_r038HLO_aux.NUMEMP,
                              l_r038HLO_aux.TIPCOL,
                              l_r038HLO_aux.NUMCAD,
                              l_r038HLO_aux.DATALT,
                              l_r038HLO_aux.TABORG,
                              l_r038HLO_aux.NUMLOC,
                              l_r038HLO_aux.STAHIS
  LOOP
    IF l_r038HLO_aux.STAHIS = 1 THEN
      SELECT NUMLOC, DATLOC INTO l_numloc, l_datloc FROM R034FUN
       WHERE TIPCOL = l_r038HLO_aux.TIPCOL AND NUMEMP = l_r038HLO_aux.NUMEMP AND NUMCAD = l_r038HLO_aux.NUMCAD;

      IF (l_r038HLO_aux.NUMLOC = l_numloc) AND (l_r038HLO_aux.DATALT = l_datloc) THEN
        /* Pega o historico anterior */
        BEGIN
          SELECT A.NUMLOC,A.TABORG,A.DATALT
          INTO l_numLoc,l_taborg,l_datalt
          FROM R038HLO A
          WHERE A.NUMEMP = l_r038hlo_aux.NUMEMP
          AND   A.TIPCOL = l_r038hlo_aux.TIPCOL
          AND   A.NUMCAD = l_r038hlo_aux.NUMCAD
          AND   A.STAHIS = 1
          AND DATALT IN (SELECT MAX(DATALT) FROM R038HLO
                         WHERE NUMEMP = l_r038hlo_aux.NUMEMP
                         AND   TIPCOL = l_r038hlo_aux.TIPCOL
                         AND   NUMCAD = l_r038hlo_aux.NUMCAD
                         AND   STAHIS = 1);
        EXCEPTION
          WHEN TOO_MANY_ROWS THEN
            RAISERROR 103 'Erro em R038HLO - TOO MANY ROWS';
          WHEN NO_DATA_FOUND THEN
            l_numloc:=0;
            l_datalt:='31/12/1900,00:00:00';
          WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT R038HLO';
        END;

        /* Atualiza tabela de colaboradores */
        BEGIN
          UPDATE R034FUN
             SET NUMLOC = l_numloc,
                 TABORG = l_taborg,
                 DATLOC = l_datalt
           WHERE R034FUN.TIPCOL = l_r038hlo_aux.TIPCOL AND
                 R034FUN.NUMEMP = l_r038hlo_aux.NUMEMP AND
                 R034FUN.NUMCAD = l_r038hlo_aux.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro Na Atualização do R034FUN';
        END;

        /* Atualiza o historico de filiais */
        BEGIN
           UPDATE R038HFI
              SET NUMLOC = l_numloc
            WHERE R038HFI.TIPCOL = l_r038hlo_aux.TIPCOL AND
                  R038HFI.NUMEMP = l_r038hlo_aux.NUMEMP AND
                  R038HFI.NUMCAD = l_r038hlo_aux.NUMCAD AND
                  R038HFI.TABORG = l_r038hlo_aux.TABORG AND
                  R038HFI.DATALT = l_r038hlo_aux.DATALT;
        EXCEPTION WHEN OTHERS THEN
          l_comando_nulo:=TRUE;
        END;

        /* Pendência SAMSenior */
        IF (l_numloc <> 0) THEN
          SP_RETIDTPES(l_r038hlo_aux.NUMEMP, l_r038hlo_aux.TIPCOL, l_r038hlo_aux.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
          SP_INTSTR(l_taborg, '9999', l_taborg_str OUT);
          SP_INTSTR(l_numloc, '999999999', l_numloc_str OUT);
          l_valstr := '2H' || l_idtpes || l_taborg_str || l_numloc_str;
          SP_SAM_PENDENCIES(35, 1, l_valstr);        
        END IF;
      END IF;
    END IF;

    /* Atualiza o Quadro Efetivo - QL */
    QL_EXCLOCAL(l_r038HLO_aux.NumEmp, l_r038HLO_aux.TipCol, l_r038HLO_aux.NumCad, l_r038HLO_aux.DatAlt, l_r038HLO_aux.TabOrg, l_r038HLO_aux.NumLoc, l_r038HLO_aux.DatAlt, 0, 0);
  END LOOP;

  /* Apaga Registro OLD em R038HLO_AUX */
  BEGIN
    DELETE FROM R038HLO_AUX;
    DROP_TEMP_TABLE R038HLO_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ûÔ␀␀		SENIOR;0ş␀␀

TRIGGER R038HLO_ED AFTER DELETE ON R038HLO FOR EACH ROW

DECLARE
  l_OriExa       NUMBER(3);
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);  
  xCodLoc 		   R016HIE.CODLOC%TYPE;
  
  /* eSocial */
  l_layoutAlteracaoContrato VARCHAR2(6);
  l_UsaRat         R030EMP.UsaRat%TYPE;
  l_RotTom         R030EMP.RotTom%TYPE;
  l_IniTom         R030EMP.IniTom%TYPE;
  l_CodFil         R030FIL.CodFil%TYPE;
  l_TipFil         R030FIL.TipFil%TYPE;
  l_CdrFgt         R030FFG.CdrFgt%TYPE;
  l_DatTab         R030DES.DatTab%TYPE;
  l_DatUes         R030DES.DatUes%TYPE;
  l_IniNpe         R030DES.IniNpe%TYPE;
  l_IniPer         R030DES.IniPer%TYPE;
  l_IniSST         R030DES.IniSST%TYPE;
  l_IniMig         R030DES.DatMig%TYPE;

  /* SAMSenior */
  l_idtpes       VARCHAR2(23);
  l_taborg_str   VARCHAR2(4);
  l_numloc_str   VARCHAR2(9);
  l_valstr       VARCHAR2(38);
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HLO_AUX;
    
BEGIN
  /* Verifica se existe pendência gerada exclusivamente pelo histórico de Local para o
     cadastro de origem que está sendo excluído */
  BEGIN
       SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf
         FROM R038PEN
        WHERE R038PEN.NUMEMP = :OLD.NUMEMP AND
              R038PEN.TIPCOL = :OLD.TIPCOL AND
              R038PEN.NUMCAD = :OLD.NUMCAD AND
              R038PEN.DATTRF = :OLD.DATALT AND
              R038PEN.ALTEMP = 'N' AND
              R038PEN.ALTFIL = 'N' AND
              R038PEN.ALTLOC = 'S' AND
              R038PEN.ALTCCU = 'N' AND
              R038PEN.ALTCAR = 'N' AND
              R038PEN.ALTESC = 'N' AND
              R038PEN.ALTDES = 'N';
  EXCEPTION
       WHEN NO_DATA_FOUND THEN
            l_NumEmp := 0;
            l_TipCol := 0;
            l_NumCad := 0;
            l_DatTrf := '31/12/1900,00:00:00';
  END;

  /* Se existe pendência exclusiva do histórico de Local para o cadastro de origem
     verifica se já foi atendida para então excluir */
  IF (l_NumCad <> 0) THEN
    R038PEN_DELPEN(l_NumEmp, l_TipCol, l_NumCad, l_DatTrf);
  ELSE
    /* Atualiza pendência do Local com 'N' */
    BEGIN
      UPDATE R038PEN SET ALTLOC = 'N'
               WHERE R038PEN.NUMEMP = :OLD.NUMEMP AND
                     R038PEN.TIPCOL = :OLD.TIPCOL AND
                     R038PEN.NUMCAD = :OLD.NUMCAD AND
                     R038PEN.DATTRF = :OLD.DATALT;
    EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no update da Tabela R038PEN.';
    END;
  END IF;

  BEGIN
    /* Insere Registro Old */
    INSERT INTO R038HLO_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, TABORG, NUMLOC, STAHIS)
                     VALUES (:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, :OLD.TABORG, :OLD.NUMLOC, :OLD.STAHIS);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R038HLO_AUX.';
  END;

  /* Busca a Origem do Exame com o Tipo especificado */
  l_OriExa := 0;
  RH_RETORIEXA(10, l_OriExa OUT);

  IF   (l_OriExa > 0) THEN
       /* Exclui as Solicitações cadastradas anteriormente */
       RH_EXC_SOLIC('L', :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, l_OriExa);
  END IF;

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116*/
  RS_UPDCURCOMP(0, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD);
   
  /* Inicio - Geração de logs HistoricoLocal*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 77;     /* HistoricoLocal*/
  l_codtpa := 265;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HLO_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HLO_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :OLD.TABORG));
		RH_RET_CODLOC(:OLD.TABORG,:OLD.NUMLOC,:OLD.DATALT, xCodLoc OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', xCodLoc);        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONTOV', :OLD.CONTOV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONTOS', :OLD.CONTOS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LOCTRA', CONVERT(NUMBER_TO_CHAR, :OLD.LOCTRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MOTALT', CONVERT(NUMBER_TO_CHAR, :OLD.MOTALT));
      END;
  END IF; 
  /* Fim - Geração de logs HistoricoLocal*/
  
  /* eSocial */
  RH_LAY_CONTR_COLAB(:OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, l_layoutAlteracaoContrato OUT);
  IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
    /* Busca o valor dos campos Rateio MO Cálculo e Usa Rotina Tomadores do cadastro da empresa */
    BEGIN
  	  SELECT UsaRat, RotTom, IniTom INTO l_UsaRat, l_RotTom, l_IniTom FROM R030EMP WHERE NUMEMP = :OLD.NumEmp;
    EXCEPTION
  	  WHEN OTHERS THEN
	    RAISERROR 103 'Erro no buscar informações da empresa.';
    END;

    /* Verifica se utiliza rateio de mão de obra por local */
    IF (l_UsaRat = 'L') THEN
      /* Verifica se utiliza rotina de tomadores por rateio */
      IF (l_RotTom = 'R' AND l_IniTom < :OLD.DatAlt) THEN
        /* Se a Data de Alteração é maior que o Inicio dos Não Periódicos */
        RH_DEF_ESOCIAL(:OLD.NumEmp, l_DatTab OUT, l_DatUes OUT, l_IniNpe OUT, l_IniPer OUT, l_IniSST OUT, l_IniMig OUT);
      	IF (:OLD.DATALT > l_IniNpe) THEN
      	  l_IniNpe := :OLD.DATALT;
      	END IF;
      
        /* Busca filial do colaborador */
        RH_RETFILCOL(:OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, l_IniNpe, l_CodFil OUT);
   
        /* Busca o tipo da filial */
        RH_RETTIPFIL(:OLD.NumEmp, l_CodFil, l_TipFil OUT);
    
        IF (l_TipFil = 'O') THEN /* O = Obra */
          /* Busca codigo do recolhimento de FGTS */
          RH_RETCDRFGTFIL(:OLD.NumEmp, l_CodFil, :OLD.DatAlt, l_CdrFgt OUT);
      
          IF (l_CdrFgt = 155) THEN /* 155 = Obra de Construção Civil */
		    SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, :OLD.DatAlt, 'R038HLO', 'DATALT', 'E', '', '', 0, 'R038HLO_ED');
		  END IF;
		END IF;
      END IF;       
    END IF;
  END IF;

  /* Pendência SAMSenior */
  IF (:OLD.STAHIS = 1) THEN
    SP_RETIDTPES(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_INTSTR(:OLD.TABORG, '9999', l_taborg_str OUT);
    SP_INTSTR(:OLD.NUMLOC, '999999999', l_numloc_str OUT);
    l_valstr := '2H' || l_idtpes || l_taborg_str || l_numloc_str;
    SP_SAM_PENDENCIES(35, 3, l_valstr);
  END IF;
END␀␀␀‘v␀␀␀␀␀␀␀␀␀␀␀úÔ␀␀…¬␀␀´␀Ôï1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀tÔï1␀␀␀␀␀Ü␀t␀Ü␀n%ˆ␀Æÿ␀␀ÿ␀c¬␀␀Ì␀Ôï1␀␀␀␀␀.%0.0.w"ˆ␀Æÿ␀␀ÿ␀mDÑ␀Ôï1␀␀␀␀␀HIşEşEqC#ˆ␀êÿ␀␀ÿ␀Ş␀´␀Ôï1␀␀␀␀␀>½␀␀r␀Æÿ␀␀YĞ␀␀␀§¬␀␀Ì␀Ôï1␀␀␀␀␀İ«␀␀Û«␀␀Û«␀␀m␀Æÿ␀␀ÿ␀2=Ôï1␀␀␀␀␀c4‡␀ÿ␀c␀␀␀ÿ␀␀ÿ␀2=Ôï1␀␀␀␀␀e4ˆ␀␀␀c␀␀␀ÿ␀␀ÿ␀*␀áÔï1␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀␀b´␀Ôï1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀Û␀tÔï1␀␀␀␀␀Ü␀t␀Ü␀n%ˆ␀Æÿ␀␀ÿ␀Z$Ì␀Ôï1␀␀␀␀␀.%0.0.w"ˆ␀Æÿ␀␀ÿ␀MEÑ␀Ôï1␀␀␀␀␀HIşEşEqC#ˆ␀êÿ␀␀ÿ␀öµ␀␀´␀Ôï1␀␀␀␀␀>½␀␀q␀Æÿ␀␀ÿ␀lš␀␀Ì␀Ôï1␀␀␀␀␀İ«␀␀Û«␀␀Û«␀␀m␀Æÿ␀␀ÿ␀␀␀␀␀␀	␀’v␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Õ␀␀…¬␀␀´␀	Ôï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôï!␀␀␀␀␀Ü␀t␀Ü␀nˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôï!␀␀␀␀␀.%0.0.wˆ␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ôï!␀␀␀␀␀EIşEşEqCˆ␀êÿ␀␀ÿ␀9¦␀␀±␀Ôï!␀␀␀␀␀W¦␀␀.¦␀␀M¦␀␀qˆ␀Æÿ␀␀ĞÖ␀␀␀%¶␀␀ĞÔï!␀␀␀␀␀2·␀␀‘¶␀␀’¶␀␀c␀␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3Õ␀␀		SENIOR;0␀␀/* INSERT (NEW) */
TRIGGER R038HNA_EI AFTER INSERT ON R038HNA FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs HistoricoNaturezaDespesas*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 78;     /* HistoricoNaturezaDespesas*/
  l_codtpa := 267;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HNA_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HNA_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NATDES', CONVERT(NUMBER_TO_CHAR, :NEW.NATDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORICCU', :NEW.ORICCU);
      END;
  END IF; 
END␀Õ␀␀		SENIOR;0_␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R038HNA_EU AFTER UPDATE ON R038HNA FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs HistoricoNaturezaDespesas*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 78;     /* HistoricoNaturezaDespesas*/
  l_codtpa := 268;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.NatDes <> :NEW.NatDes)
   OR (:OLD.OriCcu <> :NEW.OriCcu)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HNA_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HNA_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNATDES', CONVERT(NUMBER_TO_CHAR, :OLD.NATDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNATDES', CONVERT(NUMBER_TO_CHAR, :NEW.NATDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDORICCU', :OLD.ORICCU);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWORICCU', :NEW.ORICCU);
      END;
    END IF; 
  END IF; 
END␀Õ␀␀		SENIOR;0’␀␀ 

/* DELETE (OLD) */
TRIGGER R038HNA_ED AFTER DELETE ON R038HNA FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs HistoricoNaturezaDespesas*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 78;     /* HistoricoNaturezaDespesas*/
  l_codtpa := 267;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HNA_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HNA_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NATDES', CONVERT(NUMBER_TO_CHAR, :OLD.NATDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORICCU', :OLD.ORICCU);
      END;
  END IF; 
END␀␀␀•v␀␀␀␀␀␀Õ␀␀…¬␀␀´␀	Ôÿ!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ!␀␀␀␀␀Ü␀t␀Ü␀nû‡␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ!␀␀␀␀␀$0.0.wñ‡␀Æÿ␀␀…Ó␀␀␀EÑ␀	Ôÿ!␀␀␀␀␀:N¢G¢GqCò‡␀êÿ␀␀ÿ␀µEÑ␀Ôï!␀␀␀␀␀„NÈHÉHqCó‡␀êÿ␀␀ÿ␀¥·␀␀'Ôÿ!␀␀␀␀␀ë·␀␀è·␀␀è·␀␀c␀␀␀ÿ␀␀ÿ␀³·␀␀=Ôÿ!␀␀␀␀␀V␀[|U␀c␀␀␀ÿ␀␀ÿ␀¨·␀␀´␀Ôÿ!␀␀␀␀␀Ú<«b¯br␀Æÿ␀␀Ò␀␀␀´·␀␀tÔÿ!␀␀␀␀␀‹␀Ú␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀¢·␀␀Ì␀Ôÿ!␀␀␀␀␀ù?¨$­$w␀Æÿ␀␀…Ó␀␀␀␀␀␀0;1;2;3␀␀w␀␀␀␀␀␀␀␀␀␀␀Õ␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ?␀␀␀␀␀Ü␀t␀Ü␀n%ˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ?␀␀␀␀␀.%0.0.w"ˆ␀Æÿ␀␀…Ó␀␀␀Ó␀␀Ñ␀	Ôÿ?␀␀␀␀␀•␀␀Z”␀␀m”␀␀qC#ˆ␀êÿ␀␀Õ␀␀␀^ı␀␀­␀	Ôÿ?␀␀␀␀␀Šÿ␀␀ü␀␀xş␀␀p␀Æÿ␀␀Õ␀␀␀¯-±␀Ôï1␀␀␀␀␀“Q*–␀q‡␀Æÿ␀␀½Ğ␀␀␀‘¢␀␀±␀Ôï1␀␀␀␀␀T£␀␀„¢␀␀£␀␀q␀Æÿ␀␀*Û␀␀␀+f±␀Ôï1␀␀␀␀␀›>íeÊfq‡␀Æÿ␀␀€Ğ␀␀␀Ä␀␀4Ôï1␀␀␀␀␀)A‘Ä␀␀ÁÄ␀␀f␀␀␀ÿ␀␀ş¸␀␀␀½
␀Ñ␀Ôï1␀␀␀␀␀_␀6␀@␀qC#ˆ␀êÿ␀␀ÿ␀Œ³␀␀wÔï1␀␀␀␀␀m´␀␀ñ³␀␀ñ³␀␀?␀␀ÿ␀␀ÿ␀*␀ÉÔï1␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀1␀tÔÿ?␀␀␀␀␀z␀z␀z␀n␀Æÿ␀␀ˆÓ␀␀␀j$Ì␀Ôÿ?␀␀␀␀␀%)$%w␀Æÿ␀␀…Ó␀␀␀Ş¼␀␀Ï␀Ôÿ?␀␀␀␀␀i¾␀␀Ÿi¾␀␀u)␀␀Æÿ␀␀ÿ␀q=Ôÿ1␀␀␀␀␀}q}q}qc␀␀␀ÿ␀␀ÿN×-‹␀Ôï1␀␀␀␀␀¥Am␀m␀—)␀␀Æÿ␀␀ÿ␀␀␀␀	0;1;2;3;4Õ␀␀	SENIOR;0§␀␀


TRIGGER R038HPO_SI AFTER INSERT ON R038HPO

DECLARE
/* CURSOR c/ os registros gravados na tabela R038HPO_AUX */
  CURSOR c_r038hpo_ins IS SELECT R038HPO_AUX.NUMEMP, R038HPO_AUX.TIPCOL, R038HPO_AUX.NUMCAD, R038HPO_AUX.INIATU, R038HPO_AUX.SEQHIS, R038HPO_AUX.CODTAP,
                                 R038HPO_AUX.ESTPOS, R038HPO_AUX.POSTRA, R038HPO_AUX.TERATU, R017TAP.HISPRI  
						    FROM R038HPO_AUX, R017TAP
						   WHERE R038HPO_AUX.CODTAP = R017TAP.CODTAP;					   

  TYPE t_r038hpo_aux IS RECORD(
    NUMEMP   R038HPO_AUX.NUMEMP%TYPE,
    TIPCOL   R038HPO_AUX.TIPCOL%TYPE,
    NUMCAD   R038HPO_AUX.NUMCAD%TYPE,
    INIATU   R038HPO_AUX.INIATU%TYPE,
    SEQHIS   R038HPO_AUX.SEQHIS%TYPE,
    CODTAP   R038HPO_AUX.CODTAP%TYPE,
    ESTPOS   R038HPO_AUX.ESTPOS%TYPE,
    POSTRA   R038HPO_AUX.POSTRA%TYPE,
    TERATU   R038HPO_AUX.TERATU%TYPE,
	  HISPRI   R017TAP.HISPRI%TYPE);

  l_r038hpo_aux t_r038hpo_aux;
  l_datAux DATE;
  l_datTer DATE;
  l_seqHis   R038HPO_AUX.SEQHIS%TYPE;
  l_datTerAnt DATE;
  l_isInformix BOOLEAN;
  l_xUtiPos CHAR;
  l_xEstPos NUMBER(3);
  l_xCodPlv NUMBER(4);
  l_xDatPrimFil DATE;
BEGIN
  RH_ISINFORMIX(l_isInformix OUT);
  /* No informix, a trigger não pode atualizar o próprio registro */
  IF (l_isInformix = FALSE) THEN
    /* Le Registro do CURSOR */
    FOREACH c_r038hpo_ins INTO l_r038hpo_aux.NUMEMP,
                               l_r038hpo_aux.TIPCOL,
                               l_r038hpo_aux.NUMCAD,
                               l_r038hpo_aux.INIATU,
                               l_r038hpo_aux.SEQHIS,
                               l_r038hpo_aux.CODTAP,
                               l_r038hpo_aux.ESTPOS,
                               l_r038hpo_aux.POSTRA,
                               l_r038hpo_aux.TERATU,
                               l_r038hpo_aux.HISPRI

    LOOP
      /* Titular */
      IF (l_r038hpo_aux.HISPRI = 'S') THEN
        /* Atualiza data de témino de atuação */
        BEGIN
          SELECT MIN(R038HPO.INIATU)
            INTO l_datTer
            FROM R038HPO, R017TAP
           WHERE R038HPO.CODTAP = R017TAP.CODTAP
             AND R017TAP.HISPRI = 'S'
             AND R038HPO.NUMEMP = l_r038hpo_aux.NUMEMP
             AND R038HPO.TIPCOL = l_r038hpo_aux.TIPCOL
             AND R038HPO.NUMCAD = l_r038hpo_aux.NUMCAD
             AND R038HPO.INIATU > l_r038hpo_aux.INIATU;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_datTer := NULL;  
          WHEN OTHERS THEN
            NULL;
        END;

        /* Se não achou data posterior, então atualiza com a data 04/06/2080 */
        IF (l_datTer IS NULL) THEN
          l_datTer :=DATETIME(04, 06, 2080, 0, 0, 0);
        ELSE
          l_datTer := DATETIMEADD(DD, -1, l_datTer);
        END IF;

        BEGIN
          UPDATE R038HPO
             SET TERATU = l_datTer
           WHERE NUMEMP = l_r038hpo_aux.NUMEMP
             AND TIPCOL = l_r038hpo_aux.TIPCOL
             AND NUMCAD = l_r038hpo_aux.NUMCAD
             AND INIATU = l_r038hpo_aux.INIATU
             AND SEQHIS = l_r038hpo_aux.SEQHIS;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar data de término do histórico de posto.';
        END;

        /* Atualiza data de término de atuação do histórico anterior */
        BEGIN
          SELECT R038HPO.INIATU, R038HPO.SEQHIS
            INTO l_datAux, l_seqHis
            FROM R038HPO, R017TAP
           WHERE R017TAP.CODTAP = R038HPO.CODTAP
             AND R017TAP.HISPRI = 'S'
             AND R038HPO.NUMEMP = l_r038hpo_aux.NUMEMP
             AND R038HPO.TIPCOL = l_r038hpo_aux.TIPCOL
             AND R038HPO.NUMCAD = l_r038hpo_aux.NUMCAD
             AND R038HPO.INIATU < l_r038hpo_aux.INIATU
             AND R038HPO.TERATU >= l_r038hpo_aux.INIATU;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_datAux := NULL;  
          WHEN OTHERS THEN
            NULL;
        END;

        IF (l_datAux IS NOT NULL) THEN
          l_datTerAnt := DATETIMEADD(DD, -1, l_r038hpo_aux.INIATU);

          BEGIN
            UPDATE R038HPO
               SET TERATU = l_datTerAnt
             WHERE NUMEMP = l_r038hpo_aux.NUMEMP
               AND TIPCOL = l_r038hpo_aux.TIPCOL
               AND NUMCAD = l_r038hpo_aux.NUMCAD
               AND INIATU = l_datAux
               AND SEQHIS = l_SeqHis;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro no update da tabela R038HPO (atualiza histórico titular anterior).';
          END;
        END IF;
      ELSE
      /* Não titular */
        l_datTer :=DATETIME(04, 06, 2080, 0, 0, 0);

        IF ((l_r038hpo_aux.TERATU = DATETIME(31,12,1900,0,0,0)) OR (l_r038hpo_aux.TERATU IS NULL)) THEN
          BEGIN
            UPDATE R038HPO
               SET TERATU = l_datTer
             WHERE NUMEMP = l_r038hpo_aux.NUMEMP
               AND TIPCOL = l_r038hpo_aux.TIPCOL
               AND NUMCAD = l_r038hpo_aux.NUMCAD
               AND INIATU = l_r038hpo_aux.INIATU
               AND SEQHIS = l_r038hpo_aux.SEQHIS;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 ' Erro ao atualizar data de término do histórico de posto não titular.';
          END;
        END IF;
      END IF;

      /* Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
      QL_UTIPOSTRA(l_r038hpo_aux.NUMEMP, l_r038hpo_aux.INIATU, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
      
      SELECT MIN(DATALT)
	  INTO	 l_xDatPrimFil
	  FROM	 R038HFI
	  WHERE	 NUMEMP = l_r038hpo_aux.NUMEMP
	  AND	 TIPCOL = l_r038hpo_aux.TIPCOL
	  AND	 NUMCAD = l_r038hpo_aux.NUMCAD;
	  
      IF ((l_xUtiPos = 'S') AND ((l_r038hpo_aux.INIATU >= l_xDatPrimFil) OR (l_xDatPrimFil IS NULL))) THEN
        QL_PROCEHPO('I', l_r038hpo_aux.NUMEMP, l_r038hpo_aux.TIPCOL, l_r038hpo_aux.NUMCAD, l_xEstPos, l_xCodPlv, l_r038hpo_aux.POSTRA, l_r038hpo_aux.INIATU, l_r038hpo_aux.TERATU, l_r038hpo_aux.HISPRI, l_r038hpo_aux.CODTAP);
      END IF;
    END LOOP;

    /* Apaga Registro OLD em R038HPO_AUX */
    BEGIN
      DELETE FROM R038HPO_AUX;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao excluir registros da tabela R038HPO_AUX.';
    END;
  END IF;
END␀
Õ␀␀		SENIOR;0e
␀␀TRIGGER R038HPO_EI AFTER INSERT ON R038HPO FOR EACH ROW
DECLARE
	l_isInformix BOOLEAN;
	l_layoutAlteracaoContrato VARCHAR2(6); 
	l_DataZero DATE;
	l_DataFimHistorico DATE;
	l_DatIniSST DATE;
	l_IniHis DATE;
	l_TerHis DATE;
	l_DatAux DATE;
	l_DataMax DATE;
BEGIN
    /*Inicializações*/  
    l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
    
    RH_ISINFORMIX(l_isInformix OUT);
    /* No informix, a trigger não pode atualizar o próprio registro */
    IF (l_isInformix = FALSE) THEN
        BEGIN
        /* Insere Registro New */
            INSERT INTO R038HPO_AUX (NUMEMP, TIPCOL, NUMCAD, INIATU, SEQHIS, CODTAP, MOTALT, ESTPOS, POSTRA, TERATU)
                       VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.SEQHIS, :NEW.CODTAP,
                               :NEW.MOTALT, :NEW.ESTPOS, :NEW.POSTRA, :NEW.TERATU);
        EXCEPTION 
            WHEN OTHERS THEN RAISERROR 103 'Erro ao inserir registro na tabela R038HPO_AUX.';
        END;
    END IF;
  

  /* Início eSocial */
  IF (:NEW.FUNESO = 'S') THEN
    RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT); 
    IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
	  SP_TAB_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, 'R038HPO', 'I', '', '', 0, 'R038HPO_EI');
	  l_DataFimHistorico := :NEW.TERATU;
	  SP_INITEMPTY_DAT(l_DataFimHistorico IN OUT);
	  IF (l_DataZero <> l_DataFimHistorico) THEN
	    SP_HIST_DT_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DataFimHistorico, 'R038HPO', 'INIATU', 'I', '', '', ' AND FUNESO = ''S''', 0, 'R038HPO_EI');	    
	  END IF;	
    END IF;
  END IF;
  /* Fim eSocial */
  
  /* Início S-2240 */
  l_DataMax := DATETIME(04, 06, 2080, 0, 0, 0);
  
  l_IniHis := :NEW.IniAtu;
  l_TerHis := :NEW.TerAtu;
  
  RH_RET_DATINISST(:NEW.NumEmp, l_DatIniSST OUT);
  IF (l_DatIniSST > l_DataZero) THEN
  	IF (l_TerHis > l_DatIniSST OR l_TerHis = l_DataZero) THEN
  	  IF (l_IniHis < l_DatIniSST) THEN
  	    l_IniHis := l_DatIniSST;
  	  END IF;
  	
      SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'I', l_IniHis, l_TerHis, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_IniHis, 0, 'R038HPO_EI');
 
      IF (l_TerHis > l_DataZero) AND (l_TerHis < l_DataMax) THEN
        l_DatAux := DATETIMEADD(DD, 1, l_TerHis);
        SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'I', l_DatAux, l_DatAux, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DatAux, 0, 'R038HPO_EI');
      END IF;
    END IF;
  END IF;
  /* Fim S-2240 */
  
  RH_ALTHIEPOS();  
END		SENIOR;20Ú␀␀TRIGGER R038HPO_EI AFTER INSERT ON R038HPO FOR EACH ROW
DECLARE
	l_isInformix BOOLEAN;
	l_layoutAlteracaoContrato VARCHAR2(6); 
	l_DataZero DATE;
	l_DataFimHistorico DATE;
	l_DatIniSST DATE;
	l_IniHis DATE;
	l_TerHis DATE;
	l_DatAux DATE;
	l_DataMax DATE;
	
	/* ACESSO */
	l_Valor VARCHAR2(2000);
	l_TemPermissaoPorPosto BOOLEAN;
	l_estPos   R038HPO.EstPos%TYPE;
	l_posTra   R038HPO.PosTra%TYPE;
	l_data_zero   DATE;
	l_data_atual  DATE;
	l_hora_atual  NUMBER(4);
	l_oriDef NUMBER(1);
	l_hisPri VARCHAR2(1);
	l_codprm NUMBER(5); 
	l_codprmAux NUMBER(5);
	
	CURSOR c_r017PEP IS
       SELECT CODPRM, CODUSU, OBSPRM
         FROM R017PEP
        WHERE R017PEP.ESTPOS = l_estPos AND
              R017PEP.POSTRA = l_posTra;

    TYPE t_r017PEP IS RECORD(
       CODPRM   R017PEP.CODPRM%TYPE,
       CODUSU   R017PEP.CODUSU%TYPE,
       OBSPRM   R017PEP.OBSPRM%TYPE);
    l_r017PEP t_r017PEP;
    
BEGIN
    /*Inicializações*/  
    l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);

    l_estPos := :NEW.ESTPOS;
	l_posTra := :NEW.POSTRA;
	l_data_atual := CURDATE();
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
	l_data_zero  := '31/12/1900,00:00:00';
	l_oriDef := 2;

    RH_ISINFORMIX(l_isInformix OUT);
    /* No informix, a trigger não pode atualizar o próprio registro */
    IF (l_isInformix = FALSE) THEN
        BEGIN
        /* Insere Registro New */
            INSERT INTO R038HPO_AUX (NUMEMP, TIPCOL, NUMCAD, INIATU, SEQHIS, CODTAP, MOTALT, ESTPOS, POSTRA, TERATU)
                       VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.SEQHIS, :NEW.CODTAP,
                               :NEW.MOTALT, :NEW.ESTPOS, :NEW.POSTRA, :NEW.TERATU);
        EXCEPTION 
            WHEN OTHERS THEN RAISERROR 103 'Erro ao inserir registro na tabela R038HPO_AUX.';
        END;
    END IF;
	
	/* ACESSO */
	BEGIN
        SELECT HISPRI INTO l_hisPri FROM R017TAP WHERE R017TAP.CODTAP = :NEW.CODTAP;
	EXCEPTION 
	    WHEN OTHERS THEN RAISERROR 103 'R038HPO_EI: Erro ao fazer a seleção na tabela R017TAP.';
    END;
	
	IF (l_hisPri = 'S') THEN
	    l_oriDef := 1;
	END IF;
	
	FOREACH c_r017PEP INTO l_r017PEP.CODPRM,
                           l_r017PEP.CODUSU,
                           l_r017PEP.OBSPRM
    LOOP
	    BEGIN
	        SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_r017PEP.CODPRM, l_oriDef);
            INSERT INTO R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM, ORIDEF)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, 0,  l_r017PEP.CODPRM, :NEW.TERATU, 1439,  :NEW.CODUSU, l_r017PEP.OBSPRM,  l_oriDef);
        EXCEPTION 
            WHEN OTHERS THEN RAISERROR 103 'R038HPO_EI: Erro ao inserir na tabela R070PEC.';
        END;
    END LOOP;
	
	/* se for posto de trabalho adicional */
	IF (l_oriDef = 2) THEN
	    BEGIN
	        SELECT CODPRM INTO l_codprm FROM R017DAC WHERE ESTPOS = :NEW.ESTPOS AND POSTRA = :NEW.POSTRA;
		EXCEPTION 
		    WHEN NO_DATA_FOUND THEN l_codprm := 0;
		END;
		
		IF (l_codprm <> 0) THEN
	   	    BEGIN
		        SELECT CODPRM INTO l_codprmAux FROM R070PEC WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD AND CODPRM = l_codprm AND DATINI < l_data_atual AND (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual)) AND ORIDEF = 2;
		    EXCEPTION 
    		    WHEN NO_DATA_FOUND THEN l_codprmAux := 0;
	    	END;
		    IF (l_codprmAux = 0) THEN
		        SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_codprm, l_oriDef);
