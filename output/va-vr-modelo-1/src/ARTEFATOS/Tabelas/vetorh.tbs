        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSALMIN', CONVERT(NUMBER_TO_CHAR, :NEW.SALMIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSALCON', CONVERT(NUMBER_TO_CHAR, :OLD.SALCON));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSALCON', CONVERT(NUMBER_TO_CHAR, :NEW.SALCON));
