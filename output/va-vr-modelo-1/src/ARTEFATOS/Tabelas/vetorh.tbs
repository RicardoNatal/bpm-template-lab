Ôÿ␀␀␀␀␀ª␀␀X5X5n␀␀ÿ␀␀ÿ␀␀␀␀0;1;2œÒ␀␀		SENIOR;0B␀␀TRIGGER R030SOF_AI AFTER INSERT ON R030SOF FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
  l_ProximaData DATE;
  l_Where VARCHAR(2000);
  l_EmpresaStr VARCHAR(11);
  l_OutraEmpresaStr VARCHAR(11);
  l_InfoFacult   BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  /* eSocial */
  l_InfoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;
  
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  
  /* Só monitora o campo se o cliente opta por enviar as informações facultativas e não está em um momento de simplificação eSocial*/
  IF (l_InfoFacult = TRUE AND l_SimplificaoESocial = FALSE) THEN
	l_Valor := '';
	l_ProximaData := '31/12/1900,00:00:00';
	  
	l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP);
	l_OutraEmpresaStr := CONVERT(NUMBER_TO_CHAR, :NEW.CODOEM);  
	l_Where := 'NUMEMP = ' || l_EmpresaStr || ' AND CODOEM = ' || l_OutraEmpresaStr;
	  
	SP_PROXIMOHIST('DATINI', 'R030SOF', l_Where, :NEW.DATINI, l_ProximaData OUT); 
	SP_CONCATENAR_DES('NOMCON', :NEW.NOMCON, l_Valor OUT);
	SP_CONCATENAR_NUM('CODOEM', :NEW.CODOEM, l_Valor OUT);
	 
	SP_E_SOCIAL('S-1000', 'R030SOF', 'T', 'I', :NEW.DATINI, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030SOF_AI');
  END IF;
  /* eSocial */
END␀Ò␀␀		SENIOR;0?␀␀

TRIGGER R030SOF_AU AFTER UPDATE ON R030SOF FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
  l_Alterou BOOLEAN;
  l_Valido  BOOLEAN;
  l_ProximaData DATE;
  l_Where VARCHAR(2000);
  l_EmpresaStr VARCHAR(11);
  l_OutraEmpresaStr VARCHAR(11);
  l_InfoFacult   BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  /* eSocial */
  l_InfoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;
  
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  
  /* Só monitora o campo se o cliente opta por enviar as informações facultativas e não está em um momento de simplificação eSocial*/
  IF (l_InfoFacult = TRUE AND l_SimplificaoESocial = FALSE) THEN
	l_Valor := '';
	l_Alterou := FALSE;
	l_ProximaData := '31/12/1900,00:00:00';
	  
	SP_VALUPDATE_DES(:OLD.NomCon, :NEW.NomCon, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
	  SP_CONCATENAR_DES('NomCon', :NEW.NomCon, l_Valor OUT);
	  l_Alterou := TRUE;
	END IF;
	
	IF (l_Alterou = TRUE) THEN
	  
	  l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP);
	  l_OutraEmpresaStr := CONVERT(NUMBER_TO_CHAR, :OLD.CODOEM);  
	  l_Where := 'NUMEMP = ' || l_EmpresaStr || ' AND CODOEM = ' || l_OutraEmpresaStr;
	 
	  SP_PROXIMOHIST('DATINI', 'R030SOF', l_Where, :NEW.DATINI, l_ProximaData OUT);
	    
	  SP_CONCATENAR_NUM('CodOem', :NEW.CodOem, l_Valor OUT);
	  SP_E_SOCIAL('S-1000', 'R030SOF', 'T', 'A', :NEW.DATINI, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030SOF_AU');
	END IF;
  END IF;
  /* eSocial */
END␀›Ò␀␀		SENIOR;0␀␀

TRIGGER R030SOF_AD AFTER DELETE ON R030SOF FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
  l_ProximaData DATE;
  l_Where VARCHAR(2000);
  l_EmpresaStr VARCHAR(11);
  l_OutraEmpresaStr VARCHAR(11);
  l_InfoFacult   BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  /* eSocial */
  l_InfoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;
  
  SP_ESOCIAL_INFO(:OLD.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  
  /* Só monitora o campo se o cliente opta por enviar as informações facultativas e não está em um momento de simplificação eSocial*/
  IF (l_InfoFacult = TRUE AND l_SimplificaoESocial = FALSE) THEN
	l_Valor := '';
	l_ProximaData := '31/12/1900,00:00:00';
	  
	l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP);
	l_OutraEmpresaStr := CONVERT(NUMBER_TO_CHAR, :OLD.CODOEM);  
	l_Where := 'NUMEMP = ' || l_EmpresaStr || ' AND CODOEM = ' || l_OutraEmpresaStr;
	  
	SP_PROXIMOHIST('DATINI', 'R030SOF', l_Where, :OLD.DATINI, l_ProximaData OUT);
	
	SP_CONCATENAR_NUM('CODOEM', :OLD.CODOEM, l_Valor OUT);
	SP_E_SOCIAL('S-1000', 'R030SOF', 'T', 'E', :OLD.DATINI, l_ProximaData, :OLD.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030SOF_AD');
