        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWVALCUS', CONVERT(NUMBER_TO_CHAR,:NEW.VALCUS));
        SP_DATSTR(:OLD.DATRET, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATRET', l_datTemp);
        SP_DATSTR(:NEW.DATRET, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATRET', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORENT', CONVERT(NUMBER_TO_CHAR,:OLD.HORENT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORENT', CONVERT(NUMBER_TO_CHAR,:NEW.HORENT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORSAI', CONVERT(NUMBER_TO_CHAR,:OLD.HORSAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORSAI', CONVERT(NUMBER_TO_CHAR,:NEW.HORSAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSATE', :OLD.OBSATE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSATE', :NEW.OBSATE);
        SP_DATSTR(:OLD.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATAFA', l_datTemp);
        SP_DATSTR(:NEW.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATAFA', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORAFA', CONVERT(NUMBER_TO_CHAR,:OLD.HORAFA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORAFA', CONVERT(NUMBER_TO_CHAR,:NEW.HORAFA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSITATE', CONVERT(NUMBER_TO_CHAR,:OLD.SITATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSITATE', CONVERT(NUMBER_TO_CHAR,:NEW.SITATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDIAATE', CONVERT(NUMBER_TO_CHAR,:OLD.DIAATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDIAATE', CONVERT(NUMBER_TO_CHAR,:NEW.DIAATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSITAFA', CONVERT(NUMBER_TO_CHAR,:OLD.SITAFA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSITAFA', CONVERT(NUMBER_TO_CHAR,:NEW.SITAFA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDIAAFA', CONVERT(NUMBER_TO_CHAR,:OLD.DIAAFA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDIAAFA', CONVERT(NUMBER_TO_CHAR,:NEW.DIAAFA));
        SP_DATSTR(:OLD.FIMAFA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFIMAFA', l_datTemp);
        SP_DATSTR(:NEW.FIMAFA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFIMAFA', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORTER', CONVERT(NUMBER_TO_CHAR,:OLD.HORTER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORTER', CONVERT(NUMBER_TO_CHAR,:NEW.HORTER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDEXMRET', :OLD.EXMRET);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWEXMRET', :NEW.EXMRET);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMREC', CONVERT(NUMBER_TO_CHAR,:OLD.NUMREC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMREC', CONVERT(NUMBER_TO_CHAR,:NEW.NUMREC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMATE', CONVERT(NUMBER_TO_CHAR,:OLD.NUMATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMATE', CONVERT(NUMBER_TO_CHAR,:NEW.NUMATE));
        SP_DATSTR(:OLD.DATACT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATACT', l_datTemp);
        SP_DATSTR(:NEW.DATACT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATACT', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORACT', CONVERT(NUMBER_TO_CHAR,:OLD.HORACT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORACT', CONVERT(NUMBER_TO_CHAR,:NEW.HORACT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODUSU', CONVERT(NUMBER_TO_CHAR,:OLD.CODUSU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODUSU', CONVERT(NUMBER_TO_CHAR,:NEW.CODUSU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDATECPL', CONVERT(NUMBER_TO_CHAR,:OLD.ATECPL));
