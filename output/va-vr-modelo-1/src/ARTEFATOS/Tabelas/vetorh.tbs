␀␀ SELECT 
 R030EMP.NUMEMP,
 R030EMP.APEEMP,
 R038HFI.DATALT,
 R030FIL.CODFIL,
 R030FIL.NOMFIL,
 R034FUN.NUMCAD,
 R034FUN.NOMFUN,
 R034FUN.DATADM, 
 R038HCA.DATALT ALTCAR,
 R024CAR.TITRED,
 R038HLO.DATALT ALTLOC,
 NIVLOC.NOMNV1,
 NIVLOC.NOMNV2,
 NIVLOC.NOMNV3,
 NIVLOC.NOMNV4, 
 NIVLOC.NOMNV5,
 NIVLOC.NOMNV6,
 NIVLOC.NOMNV7,
 NIVLOC.NOMNV8,
 NIVLOC.NOMNV9,
 NIVLOC.NOMNVA,
 NIVLOC.NOMNVB,
 NIVLOC.NOMNVC, 
 NIVLOC.NOMNVD,
 NIVLOC.NOMNVE, 
 NIVLOC.NOMNVF, 
 NIVLOC.NOMNVG, 
 NIVLOC.NOMNVH, 
 NIVLOC.NOMNVI, 
 NIVLOC.NOMNVJ, 
 NIVLOC.NOMNVK, 
 NIVLOC.NOMNVL, 
 NIVLOC.NOMNVM, 
 NIVLOC.NOMNVN, 
 NIVLOC.NOMNVO,   
 R038HES.DATALT ALTESC,
 R006ESC.NOMESC,
 R128CUA.NOMCUA,
 R128ASS.DESASS,
 R032OEM.APEOEM,
 R124HCR.CODCUA, 
 CASE R128CUA.TIPREA 
   WHEN 1 THEN 'INTERNO' 
   WHEN 2 THEN 'EXTERNO ABERTO' 
   WHEN 3 THEN 'EXTERNO FECHADO' 
   WHEN 4 THEN 'EFEITO MULTIPLICADOR EXTERNO FECHADO' 
   WHEN 5 THEN 'EFEITO MULTIPLICADOR EXTERNO ABERTO' 
   WHEN 6 THEN 'NO EXTERIOR - ABERTO' 
   WHEN 7 THEN 'NO EXTERIOR - FECHADO' 
   WHEN 8 THEN 'E-LEARNING SINCRONO' 
   WHEN 9 THEN 'E-LEARNING ASSINCRONO' 
   ELSE 'INDEFINIDO' 
 END TIPREA, 
 CASE R124HCR.SITCUA 
   WHEN 1 THEN 'INCOMPLETO' 
   WHEN 2 THEN 'COMPLETO' 
 ELSE 'INDEFINIDO' 
 END SITCUA, 
 CASE R124HCR.TIPCER 
   WHEN 'A' THEN 'APROVEITAMENTO' 
   WHEN 'P' THEN 'PARTICIPAÇÃO' 
    ELSE 'INDEFINIDO' 
 END TIPCER, 
 R124HCR.MEDCUA,
 R124HCR.FRECUA,
 R124HCR.CARHOR 
FROM 
 R034FUN,
 R030EMP,
 R038HCA,
 R024CAR,
 R038HFI,
 R030FIL,
 R038HLO,
 R038HES,
 R006ESC,
 R124HCR,
 R128CUA,
 R128ASS,
 R032OEM,
 VBI_LOCTODNVL NIVLOC 
WHERE 
 R034FUN.NUMEMP = R038HCA.NUMEMP 
 AND R034FUN.TIPCOL = R038HCA.TIPCOL 
 AND R034FUN.NUMCAD = R038HCA.NUMCAD 
 AND R024CAR.ESTCAR = R038HCA.ESTCAR 
 AND R024CAR.CODCAR = R038HCA.CODCAR 
 AND R034FUN.NUMEMP = R038HFI.NUMEMP 
 AND R034FUN.TIPCOL = R038HFI.TIPCOL 
 AND R034FUN.NUMCAD = R038HFI.NUMCAD 
 AND R030FIL.NUMEMP = R038HFI.EMPATU 
 AND R030FIL.CODFIL = R038HFI.CODFIL 
 AND R030FIL.NUMEMP = R030EMP.NUMEMP 
 AND R034FUN.NUMEMP = R038HLO.NUMEMP 
 AND R034FUN.TIPCOL = R038HLO.TIPCOL 
 AND R034FUN.NUMCAD = R038HLO.NUMCAD 
 AND R038HLO.TABORG = NIVLOC.TABORG 
 AND R038HLO.NUMLOC = NIVLOC.NUMLOC 
 AND R034FUN.NUMEMP = R038HES.NUMEMP 
 AND R034FUN.TIPCOL = R038HES.TIPCOL 
 AND R034FUN.NUMCAD = R038HES.NUMCAD 
 AND R006ESC.CODESC = R038HES.CODESC 
 AND R128CUA.CODASS = R128ASS.CODASS (+) 
 AND R128CUA.CODCUA (+) = R124HCR.CODCUA 
 AND R032OEM.CODOEM (+) = R124HCR.CODOEM 
 AND R034FUN.NUMEMP = R124HCR.NUMEMP (+) 
 AND R034FUN.TIPCOL = R124HCR.TIPCOL (+) 
 AND R034FUN.NUMCAD = R124HCR.NUMCAD (+)VBI_LOCTODNVL
␀ÿ␀s␀Š␀␀␀␀␀␀␀␀␀§␀␀y␀y␀ÿ␀␀Æÿ␀␀ÿ␀/#A␀␀␀␀␀␀␀␀ã•␀␀ã•␀␀ã•␀␀C␀␀ÿ␀␀ÿ␀ó¥␀␀´␀	␀␀␀␀␀␀␀␀‘<Xb‘<r␀Æÿ␀␀ÿ␀W␀Š␀	␀␀␀␀␀␀␀␀›␀Ü␀Ü␀n␀Æÿ␀␀ÿ␀ê¥␀␀Ì␀	␀␀␀␀␀␀␀␀õ?€$P%w␀Æÿ␀␀ÿ␀$␀Š␀␀␀␀␀␀␀␀␀ÿÿÿÿ␀␀Æÿ␀␀ÿ␀K#·␀	␀␀␀␀␀␀␀␀I=½™␀␀I=s␀Æÿ␀␀ÿ␀#É␀␀¯␀␀␀␀␀␀␀␀␀ÿ>Ë␀␀Ë␀␀)␀␀	␀Æÿ␀␀ÿ␀£␀¯␀␀␀␀␀␀␀␀␀Q$␀¦␀Q$␀_)␀␀Æÿ␀␀ÿ␀¤␀È␀␀␀␀␀␀␀␀␀Q$␀¦␀Q$␀_)␀␀Æÿ␀␀ÿ␀ø¥␀␀␀␀␀␀␀␀␀␀j±␀␀œ¬␀␀j±␀␀#␀␀ÿ␀␀ÿ␀ë¥␀␀8␀␀␀␀␀␀␀␀³±␀␀²±␀␀²±␀␀?␀␀ÿ␀␀ÿ␀␀J␀␀ SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PVT.NUMEMP, PVT.TIPCOL, PVT.NUMCAD, 0 TABEVE, PVT.CODLIN CODVAL, 
            SUM(PVT.QTDPAS) QTDVAL, PVT.VALPAS VLRVAL, PVT.VALPAS VLRVL2, LVT.NUMITN NUMITN, EVN.NUMCAR NUMCAR
FROM
  R028PVT PVT, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVN EVN, R038EVT EVT
WHERE
  PVT.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PVT.CODLIN = LVT.CODLIN
  AND PVT.STAPVT = 'E'
  AND PVT.DATVTR >= PER.INIVTR
  AND PVT.DATVTR <= PER.FIMVTR
  AND PER.NUMEMP = PVT.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
  AND PVT.NUMEMP = EVT.NUMEMP
  AND PVT.TIPCOL = EVT.TIPCOL
  AND PVT.NUMCAD = EVT.NUMCAD
  AND PVT.DATVTR >= EVT.INIEVT
  AND ((PVT.DATVTR <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND EVN.NUMEMP = EVT.NUMEMP
  AND EVN.TIPCOL = EVT.TIPCOL
  AND EVN.NUMCAD = EVT.NUMCAD
  AND EVN.INIEVT = EVT.INIEVT
  AND EVN.CODLIN = PVT.CODLIN		
GROUP BY
  LVT.CODITN, PVT.NUMEMP, PVT.TIPCOL, PVT.NUMCAD, PVT.CODLIN, PVT.VALPAS, LVT.NUMITN, EVN.NUMCAR

UNION

SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PVT.NUMEMP, PVT.TIPCOL, PVT.NUMCAD, 0 TABEVE, PVT.CODLIN CODVAL, 
            SUM(PVT.QTDPAS) QTDVAL, PVT.VALPAS VLRVAL, PVT.VALPAS VLRVL2, LVT.NUMITN NUMITN, '' NUMCAR
FROM
  R028PVT PVT, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVT EVT
WHERE
  PVT.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PVT.CODLIN = LVT.CODLIN
  AND PVT.STAPVT = 'E'
  AND PVT.DATVTR >= PER.INIVTR
  AND PVT.DATVTR <= PER.FIMVTR
  AND PER.NUMEMP = PVT.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
  AND PVT.NUMEMP = EVT.NUMEMP
  AND PVT.TIPCOL = EVT.TIPCOL
  AND PVT.NUMCAD = EVT.NUMCAD
  AND PVT.DATVTR >= EVT.INIEVT
  AND ((PVT.DATVTR <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND NOT EXISTS (SELECT 1 FROM R038EVN EVN 	
                   WHERE EVN.NUMEMP = EVT.NUMEMP
                     AND EVN.TIPCOL = EVT.TIPCOL
                     AND EVN.NUMCAD = EVT.NUMCAD
                     AND EVN.INIEVT = EVT.INIEVT
                     AND EVN.CODLIN = PVT.CODLIN)		
GROUP BY
  LVT.CODITN, PVT.NUMEMP, PVT.TIPCOL, PVT.NUMCAD, PVT.CODLIN, PVT.VALPAS, LVT.NUMITN

UNION

SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, 0 TABEVE, PDI.CODLIN CODVAL, 
            SUM(PDI.QTDPAS * -1) QTDVAL, PDI.VALPAS * -1 VLRVAL, PDI.VALPAS VLRVL2, LVT.NUMITN NUMITN, EVN.NUMCAR NUMCAR
FROM 
  R028PDI PDI, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVN EVN, R038EVT EVT
WHERE 
  PDI.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PER.INIFVT <> DAY(1900,12,31)
  AND PER.FIMFVT <> DAY(1900,12,31)
  AND PDI.CODLIN = LVT.CODLIN
  AND PDI.DATFAL >= PER.INIFVT
  AND PDI.DATFAL <= PER.FIMFVT
  AND PER.NUMEMP = PDI.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
  AND PDI.NUMEMP = EVT.NUMEMP
  AND PDI.TIPCOL = EVT.TIPCOL 
  AND PDI.NUMCAD = EVT.NUMCAD	
  AND PDI.DATFAL >= EVT.INIEVT
  AND ((PDI.DATFAL <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))
  AND EVN.NUMEMP = EVT.NUMEMP
  AND EVN.TIPCOL = EVT.TIPCOL
  AND EVN.NUMCAD = EVT.NUMCAD
  AND EVN.INIEVT = EVT.INIEVT
  AND EVN.CODLIN = PDI.CODLIN				
GROUP BY
  LVT.CODITN, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, PDI.CODLIN, PDI.VALPAS, LVT.NUMITN, EVN.NUMCAR
	
UNION

SELECT
  1 TIPVAL, LVT.CODITN CODPRD, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, 0 TABEVE, PDI.CODLIN CODVAL, 
            SUM(PDI.QTDPAS * -1) QTDVAL, PDI.VALPAS * -1 VLRVAL, PDI.VALPAS VLRVL2, LVT.NUMITN NUMITN, '' NUMCAR
FROM 
  R028PDI PDI, R028LVT LVT, VBS_PERVTR PER, R250TAB TAB, R038EVT EVT
WHERE 
  PDI.QTDPAS >= 0
  AND (LVT.DESVTR <> 'N' OR TAB.DESVTR = 'S')
  AND PER.INIFVT <> DAY(1900,12,31)
  AND PER.FIMFVT <> DAY(1900,12,31)
  AND PDI.CODLIN = LVT.CODLIN
  AND PDI.DATFAL >= PER.INIFVT
  AND PDI.DATFAL <= PER.FIMFVT
  AND PER.NUMEMP = PDI.NUMEMP
  AND NOT LVT.CODITN IS NULL
  AND (LVT.FORVAL = TAB.FORVAL OR TAB.FORVAL IS NULL)
  AND PDI.NUMEMP = EVT.NUMEMP
  AND PDI.TIPCOL = EVT.TIPCOL
  AND PDI.NUMCAD = EVT.NUMCAD
  AND PDI.DATFAL >= EVT.INIEVT
  AND ((PDI.DATFAL <= EVT.FIMEVT) OR (EVT.FIMEVT = DAY(1900,12,31)))  
  AND NOT EXISTS (SELECT 1 FROM R038EVN EVN 	
                   WHERE EVN.NUMEMP = EVT.NUMEMP
                     AND EVN.TIPCOL = EVT.TIPCOL
                     AND EVN.NUMCAD = EVT.NUMCAD
                     AND EVN.INIEVT = EVT.INIEVT
                     AND EVN.CODLIN = PDI.CODLIN)	
GROUP BY
  LVT.CODITN, PDI.NUMEMP, PDI.TIPCOL, PDI.NUMCAD, PDI.CODLIN, PDI.VALPAS, LVT.NUMITNVBS_PERVTR
