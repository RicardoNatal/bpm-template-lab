  FNc_RepEmpr0026: /* FINALLY OPEN CURSOR */
  CLOSE c_RepEmpr002
  DEALLOCATE c_RepEmpr002
  IF @ChkError <> 0
    GOTO FIM

  IF (@l_tempo_ret='S' 
      AND @l_toler_ret='S' 
