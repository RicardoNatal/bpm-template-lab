¡␀␀PROCEDURE SP_NUMBERTODATE(P_DATAHORA NUMBER(14,6),P_RESULT OUT DATE)
 IS

QTD_DIAS NUMBER(6);
  QTD_MIN NUMBER(6, 4);
  DT DATE;
  DT_ZERO DATE;
BEGIN
  qtd_DIAS := TRUNC(p_DATAHORA, 0);
  qtd_Min := (p_DATAHORA - qtd_DIAS); 
  DT_ZERO := DATETIME(30, 12, 1899, 0, 0, 0);

  DT := DATETIMEADD(DD, qtd_DIAS, DT_ZERO);
  DT := DATETIMEADD(MI, qtd_Min * 1440, DT);
  
  p_result := DT;
  
  RETURN;
END	MSSQL;0
Æ␀␀CREATE PROCEDURE sp_numbertodate(@p_DATAHORA FLOAT, @p_result DATETIME OUTPUT) AS
BEGIN
DECLARE @qtd_dias INTEGER
DECLARE @qtd_min FLOAT
DECLARE @dt DATETIME
DECLARE @dt_zero DATETIME
  DECLARE @ChkError INTEGER
  SELECT @ChkError = 0
  SELECT @qtd_DIAS = ROUND(@p_DATAHORA, 0, 1)
  SELECT @qtd_Min = (@p_DATAHORA-@qtd_DIAS)
  SELECT @DT_ZERO = CONVERT(DATETIME,CONVERT(VARCHAR,12)+'/'+CONVERT(VARCHAR,30)+'/'+CONVERT(VARCHAR,1899)+' '+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0)+':'+CONVERT(VARCHAR,0))
  SELECT @DT = DATEADD(DAY,@qtd_DIAS,@DT_ZERO)
  SELECT @DT = DATEADD(MINUTE,@qtd_Min*1440,@DT)
  SELECT @p_result = @DT
  BEGIN
    RETURN @ChkError
  END
FIM:
  RETURN @ChkError
END


␀iø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE SP_PACCON(P_TIPPES NUMBER(2),P_PROPAC VARCHAR2(20),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER,P_VERPLF NUMBER(3),P_CODPLF NUMBER(5),P_DATINI DATE,P_HORINI NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_SUBNV NUMBER(1),P_CREACC NUMBER(1))
 IS
BEGIN
  NULL;
END		SENIOR;24ÎSP_DATSTR
