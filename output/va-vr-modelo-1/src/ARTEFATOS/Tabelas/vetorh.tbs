END␀␀␀‡␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Ú␀␀ƒEÑ␀	␀␀␀␀␀␀€L€L€LqC␀êÿ␀␀ÿ␀Òw·␀	␀␀␀␀␀␀µyµyµyì*␀␀Æÿ␀␀ÿ␀ş␀␀Ì␀	␀␀␀␀␀␀nÿ␀␀nÿ␀␀nÿ␀␀{␀Æÿ	11ÿ␀(␀Ò␀␀␀␀␀␀␀¬$␀¬$␀¬$␀ÿ␀ÿÿ␀␀ÿ␀C␀=␀␀␀␀␀␀␀␀␀␀␀␀c␀␀␀ÿ␀␀ÿ␀vEÑ␀␀␀␀␀␀␀xMxMxMqC␀êÿ␀␀ÿ␀Ìw·␀␀␀␀␀␀␀zzzì*␀␀Æÿ␀␀ÿ␀éı␀␀­␀␀␀␀␀␀␀Õÿ␀␀Õÿ␀␀Õÿ␀␀p␀Æÿ␀␀ÿ␀p␀¾␀␀␀␀␀␀+␀+␀+␀n␀Æÿ␀␀ÿ␀%␀Ç␀␀␀␀␀␀␀J&␀
&␀
&␀z␀Æÿ␀␀ÿ␀␀␀␀0;1;2␀␀ıg␀␀␀␀␀␀␀␀␀␀␀Ú␀␀…¬␀␀´␀	␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀B%0.0.w1‰␀Æÿ␀␀DÚ␀␀␀EÑ␀	␀␀␀␀␀␀G]G]GqC3‰␀êÿ␀␀ÿ␀¤w·␀	␀␀␀␀␀␀wxdxdxì*␀␀Æÿ␀␀ÿ␀åDÑ␀␀␀␀␀␀␀GÔFÔFqC2‰␀êÿ␀␀ÿ␀w·␀␀␀␀␀␀␀Nx<x<xì*␀␀Æÿ␀␀ÿ␀C-·␀␀␀␀␀␀␀~=¿␀␀¿␀␀t4‰␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀␀␀␀␀␀␀Â¿␀␀¨¿␀␀©¿␀␀t␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀␀␀␀␀␀␀Ã¿␀␀±¿␀␀²¿␀␀t␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀␀␀␀␀␀␀Á¿␀␀¥¿␀␀¦¿␀␀t␀Æÿ␀␀ı×␀␀␀Ìa´␀␀␀␀␀␀␀¯<•awbr␀Æÿ␀␀Ò␀␀␀=␀t␀␀␀␀␀␀m␀§␀§␀n␀Æÿ␀␀ˆÓ␀␀␀:$Ì␀␀␀␀␀␀␀ %$†$w␀Æÿ␀␀…Ó␀␀␀␀Ã␀␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3”Ú␀␀	SENIOR;0ë␀␀TRIGGER R070TPE_SI AFTER INSERT ON R070TPE

DECLARE
l_count        NUMBER(5);
  l_data_zero    DATE;
  l_comando_nulo BOOLEAN;
  l_strerr       VARCHAR2(255);

/* CURSOR c/ os registros gravados no R070tpe_AUX */
  CURSOR c_r070tpe_ins IS SELECT NUMEMP,NUMCAD,DATINI,HORINI,DATFIM,HORFIM,CODPRM,PRMFER,PRMSAB,PRMDOM,STAACC FROM R070TPE_AUX;
  TYPE t_r070TPE_aux IS RECORD(
    NUMEMP   R070TPE_AUX.NUMEMP%TYPE,
    NUMCAD   R070TPE_AUX.NUMCAD%TYPE,
    DATINI   R070TPE_AUX.DATINI%TYPE,
    HORINI   R070TPE_AUX.HORINI%TYPE,
    DATFIM   R070TPE_AUX.DATFIM%TYPE,
    HORFIM   R070TPE_AUX.HORFIM%TYPE,
    CODPRM   R070TPE_AUX.CODPRM%TYPE,
    PRMFER   R070TPE_AUX.PRMFER%TYPE,
    PRMSAB   R070TPE_AUX.PRMSAB%TYPE,
    PRMDOM   R070TPE_AUX.PRMDOM%TYPE,
    STAACC   R070TPE_AUX.STAACC%TYPE);
  l_r070TPE_aux t_r070TPE_aux;

BEGIN
  l_comando_nulo:=FALSE;
  l_data_zero  := '31/12/1900,00:00:00';

  /* Le Registro do CURSOR */
  FOREACH c_r070tpe_ins INTO  l_r070TPE_aux.NUMEMP,
                              l_r070TPE_aux.NUMCAD,
                              l_r070TPE_aux.DATINI,
                              l_r070TPE_aux.HORINI,
                              l_r070TPE_aux.DATFIM,
                              l_r070TPE_aux.HORFIM,
                              l_r070TPE_aux.CODPRM,
                              l_r070TPE_aux.PRMFER,
                              l_r070TPE_aux.PRMSAB,
                              l_r070TPE_aux.PRMDOM,
                              l_r070TPE_aux.STAACC
  LOOP
    l_count := 0;
    BEGIN
      SELECT COUNT(*) INTO l_count
       FROM R070TPE A
      WHERE  A.NUMEMP = l_r070tpe_aux.NUMEMP
        AND  A.NUMCAD = l_r070tpe_aux.NUMCAD
        AND (A.DATINI <> l_r070tpe_aux.DATINI OR (A.DATINI = l_r070tpe_aux.DATINI AND A.HORINI <> l_r070tpe_aux.HORINI))
        AND ( ( (A.DATINI > l_r070tpe_aux.DATINI OR (A.DATINI = l_r070tpe_aux.DATINI AND A.HORINI >= l_r070tpe_aux.HORINI)) AND
                (A.DATINI < l_r070tpe_aux.DATFIM OR l_r070tpe_aux.DATFIM = l_data_zero OR (A.DATINI = l_r070tpe_aux.DATFIM AND (A.HORINI <= l_r070tpe_aux.HORFIM OR l_r070tpe_aux.HORFIM = 0))) )
         OR   ( (A.DATFIM > l_r070tpe_aux.DATINI OR A.DATFIM = l_data_zero OR (A.DATFIM = l_r070tpe_aux.DATINI AND (A.HORFIM >= l_r070tpe_aux.HORINI OR A.HORFIM = 0))) AND
                ((A.DATFIM < l_r070tpe_aux.DATFIM AND A.DATFIM <> l_data_zero) OR l_r070tpe_aux.DATFIM = l_data_zero OR (A.DATFIM = l_r070tpe_aux.DATFIM AND (A.HORFIM <= l_r070tpe_aux.HORFIM OR l_r070tpe_aux.HORFIM = 0)))
         OR   ( (l_r070tpe_aux.DATINI > A.DATINI OR (l_r070tpe_aux.DATINI = A.DATINI AND l_r070tpe_aux.HORINI >= A.HORINI)) AND
                ((l_r070tpe_aux.DATFIM < A.DATFIM AND l_r070tpe_aux.DATFIM <> l_data_zero) OR A.DATFIM = l_data_zero OR (l_r070tpe_aux.DATFIM = A.DATFIM AND l_r070tpe_aux.HORFIM <= A.HORFIM)) ) ) );
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_count:=0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro no SELECT R038TPE - em R070TPE_AI';
    END;
    IF  l_count > 0 THEN
        l_strerr := 'Erro de Sobreposição de Permissoes para Empresa = '||
                    CONVERT(NUMBER_TO_CHAR,l_r070tpe_aux.NUMEMP)||' Colaborador = '||
                    CONVERT(NUMBER_TO_CHAR,l_r070tpe_aux.NUMCAD);
        RAISERROR 103 l_strerr;
    END IF;

  END LOOP;

  /* Apaga Registro OLD/NEW em R070TPE_AUX */
  BEGIN
    DELETE FROM R070TPE_AUX;
    DROP_TEMP_TABLE R070TPE_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀’Ú␀␀		SENIOR;0ö␀␀

TRIGGER R070TPE_EI AFTER INSERT ON R070TPE FOR EACH ROW

DECLARE
l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_online      BOOLEAN;
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R070TPE_AUX;  

BEGIN
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       IF   (:NEW.DATINI < l_data_atual OR
            (:NEW.DATINI = l_data_atual AND :NEW.HORINI <= l_hora_atual)) AND
            (:NEW.DATFIM = l_data_zero OR :NEW.DATFIM > l_data_atual OR
            (:NEW.DATFIM = l_data_atual AND :NEW.HORFIM > l_hora_atual)) THEN
            R070TPE_ATUCON(:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATINI,:NEW.DATFIM,:NEW.CODPRM,:NEW.PRMFER,:NEW.PRMSAB,:NEW.PRMDOM);
       END IF;
  END IF;

  BEGIN
  /* Insere Registro NEW */
    INSERT INTO R070TPE_AUX (NUMEMP,NUMCAD,DATINI,HORINI,DATFIM,HORFIM,CODPRM,PRMFER,PRMSAB,PRMDOM,STAACC)
    VALUES (:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI,:NEW.DATFIM,:NEW.HORFIM,:NEW.CODPRM,:NEW.PRMFER,:NEW.PRMSAB,:NEW.PRMDOM,:NEW.STAACC);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R070TPE_AUX.';
  END;
END␀•Ú␀␀	SENIOR;0í␀␀

TRIGGER R070TPE_SU AFTER UPDATE ON R070TPE

DECLARE
l_count        NUMBER(5);
  l_data_zero    DATE;
  l_comando_nulo BOOLEAN;
  l_strerr       VARCHAR2(255);

/* CURSOR c/ os registros gravados no R070tpe_AUX */
  CURSOR c_r070tpe_upd IS SELECT NUMEMP,NUMCAD,DATINI,HORINI,DATFIM,HORFIM,CODPRM,PRMFER,PRMSAB,PRMDOM,STAACC FROM R070TPE_AUX;
  TYPE t_r070TPE_aux IS RECORD(
    NUMEMP   R070TPE_AUX.NUMEMP%TYPE,
    NUMCAD   R070TPE_AUX.NUMCAD%TYPE,
    DATINI   R070TPE_AUX.DATINI%TYPE,
    HORINI   R070TPE_AUX.HORINI%TYPE,
    DATFIM   R070TPE_AUX.DATFIM%TYPE,
    HORFIM   R070TPE_AUX.HORFIM%TYPE,
    CODPRM   R070TPE_AUX.CODPRM%TYPE,
    PRMFER   R070TPE_AUX.PRMFER%TYPE,
    PRMSAB   R070TPE_AUX.PRMSAB%TYPE,
    PRMDOM   R070TPE_AUX.PRMDOM%TYPE,
    STAACC   R070TPE_AUX.STAACC%TYPE);
  l_r070TPE_aux t_r070TPE_aux;

BEGIN
  l_comando_nulo:=FALSE;
  l_data_zero  := '31/12/1900,00:00:00';

  /* Le Registro do CURSOR */
  FOREACH c_r070tpe_upd INTO  l_r070TPE_aux.NUMEMP,
                              l_r070TPE_aux.NUMCAD,
                              l_r070TPE_aux.DATINI,
                              l_r070TPE_aux.HORINI,
                              l_r070TPE_aux.DATFIM,
                              l_r070TPE_aux.HORFIM,
                              l_r070TPE_aux.CODPRM,
                              l_r070TPE_aux.PRMFER,
                              l_r070TPE_aux.PRMSAB,
                              l_r070TPE_aux.PRMDOM,
                              l_r070TPE_aux.STAACC
  LOOP
    l_count := 0;
    BEGIN
      SELECT COUNT(*) INTO l_count
       FROM R070TPE A
      WHERE A.NUMEMP = l_r070tpe_aux.NUMEMP
        AND A.NUMCAD = l_r070tpe_aux.NUMCAD
        AND (A.DATINI <> l_r070tpe_aux.DATINI OR (A.DATINI = l_r070tpe_aux.DATINI AND A.HORINI <> l_r070tpe_aux.HORINI))
        AND ( ( (A.DATINI > l_r070tpe_aux.DATINI OR (A.DATINI = l_r070tpe_aux.DATINI AND A.HORINI >= l_r070tpe_aux.HORINI)) AND
                (A.DATINI < l_r070tpe_aux.DATFIM OR l_r070tpe_aux.DATFIM = l_data_zero OR (A.DATINI = l_r070tpe_aux.DATFIM AND (A.HORINI <= l_r070tpe_aux.HORFIM OR l_r070tpe_aux.HORFIM = 0))) )
         OR   ( (A.DATFIM > l_r070tpe_aux.DATINI OR A.DATFIM = l_data_zero OR (A.DATFIM = l_r070tpe_aux.DATINI AND (A.HORFIM >= l_r070tpe_aux.HORINI OR A.HORFIM = 0))) AND
               ((A.DATFIM < l_r070tpe_aux.DATFIM AND A.DATFIM <> l_data_zero) OR l_r070tpe_aux.DATFIM = l_data_zero OR (A.DATFIM = l_r070tpe_aux.DATFIM AND (A.HORFIM <= l_r070tpe_aux.HORFIM OR l_r070tpe_aux.HORFIM = 0)))
         OR   ( (l_r070tpe_aux.DATINI > A.DATINI OR (l_r070tpe_aux.DATINI = A.DATINI AND l_r070tpe_aux.HORINI >= A.HORINI)) AND
               ((l_r070tpe_aux.DATFIM < A.DATFIM AND l_r070tpe_aux.DATFIM <> l_data_zero) OR A.DATFIM = l_data_zero OR (l_r070tpe_aux.DATFIM = A.DATFIM AND l_r070tpe_aux.HORFIM <= A.HORFIM)) ) ) );
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_count:=0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro no SELECT R038TPE - em R070TPE_AU';
    END;
    IF  l_count > 0 THEN
        l_strerr := 'Erro de Sobreposição de Permissoes para Empresa = '||
                     CONVERT(NUMBER_TO_CHAR,l_r070tpe_aux.NUMEMP)||' Colaborador = '||
                     CONVERT(NUMBER_TO_CHAR,l_r070tpe_aux.NUMCAD);
        RAISERROR 103 l_strerr;
    END IF;

  END LOOP;

  /* Apaga Registro OLD/NEW em R070TPE_AUX */
  BEGIN
    DELETE FROM R070TPE_AUX;
    DROP_TEMP_TABLE R070TPE_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀“Ú␀␀		SENIOR;0e␀␀

TRIGGER R070TPE_EU AFTER UPDATE ON R070TPE FOR EACH ROW

DECLARE
l_codprm      NUMBER(5);
  l_prmfer      NUMBER(5);
  l_prmsab      NUMBER(5);
  l_prmdom      NUMBER(5);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_online      BOOLEAN;

  /* Tabela temporária */
  CREATE_TEMP_TABLE R070TPE_AUX;

BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN

       l_codprm := 0;
       l_prmfer := 0;
       l_prmsab := 0;
       l_prmdom := 0;
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       IF   (:NEW.DATINI < l_data_atual OR
            (:NEW.DATINI = l_data_atual AND :NEW.HORINI <= l_hora_atual)) AND
            (:NEW.DATFIM = l_data_zero OR :NEW.DATFIM > l_data_atual OR
            (:NEW.DATFIM = l_data_atual AND :NEW.HORFIM > l_hora_atual)) THEN
            l_codprm:=:NEW.CODPRM;
            l_prmfer:=:NEW.PRMFER;
            l_prmsab:=:NEW.PRMSAB;
            l_prmdom:=:NEW.PRMDOM;
       ELSE
            IF  (:OLD.STAACC <> :NEW.STAACC) THEN
                 BEGIN
                   SELECT CODPRM, PRMFER, PRMSAB, PRMDOM INTO l_codprm, l_prmfer, l_prmsab, l_prmdom
                   FROM R070OCR WHERE NUMEMP = :OLD.NUMEMP AND NUMCAD = :OLD.NUMCAD;
                 EXCEPTION WHEN OTHERS THEN
                   RAISERROR 103 'ON-Line: Erro no SELECT do R070OCR.';
                 END;
            END IF;
       END IF;
       IF  (l_codprm <> 0) OR (l_prmfer <> 0) OR (l_prmsab <> 0) OR (l_prmdom <> 0) THEN
           R070TPE_ATUCON(:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATINI,:NEW.DATFIM, l_codprm,l_prmfer, l_prmsab, l_prmdom);
       END IF;
  END IF;
  BEGIN
  /* Insere Registro NEW */
    INSERT INTO R070TPE_AUX (NUMEMP,NUMCAD,DATINI,HORINI,DATFIM,HORFIM,CODPRM,PRMFER,PRMSAB,PRMDOM,STAACC)
    VALUES (:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI,:NEW.DATFIM,:NEW.HORFIM,:NEW.CODPRM,:NEW.PRMFER,:NEW.PRMSAB,:NEW.PRMDOM,:NEW.STAACC);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R070TPE_AUX.';
  END;
END␀‘Ú␀␀		SENIOR;0¡␀␀

TRIGGER R070TPE_ED AFTER DELETE ON R070TPE FOR EACH ROW

DECLARE
l_codprm      NUMBER(5);
  l_prmfer      NUMBER(5);
  l_prmsab      NUMBER(5);
  l_prmdom      NUMBER(5);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_online      BOOLEAN;
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN

       l_codprm := 0;
       l_prmfer := 0;
       l_prmsab := 0;
       l_prmdom := 0;
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       IF   (:OLD.DATINI < l_data_atual OR
            (:OLD.DATINI = l_data_atual AND :OLD.HORINI <= l_hora_atual)) AND
            (:OLD.DATFIM = l_data_zero OR :OLD.DATFIM > l_data_atual OR
            (:OLD.DATFIM = l_data_atual AND :OLD.HORFIM > l_hora_atual)) THEN
            BEGIN
              SELECT CODPRM, PRMFER, PRMSAB, PRMDOM INTO l_codprm, l_prmfer, l_prmsab, l_prmdom
              FROM R070OCR WHERE NUMEMP = :OLD.NUMEMP AND NUMCAD = :OLD.NUMCAD;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'ON-Line: Erro no SELECT do R070OCR.';
            END;
       END IF;
       IF  (l_codprm <> 0) OR (l_prmfer <> 0) OR (l_prmsab <> 0) OR (l_prmdom <> 0) THEN
           R070TPE_ATUCON(:OLD.NUMEMP,:OLD.NUMCAD,:OLD.DATINI,:OLD.DATFIM, l_codprm,l_prmfer, l_prmsab, l_prmdom);
       END IF;
