TRIGGER R122CEX_SI AFTER INSERT ON R122CEX

DECLARE
/* SINCRONIZAÇÃO DO BAIRRO COM O CADASTRO DE CANDIDATO */
  /* CURSOR para buscar os registros que foram inseridos na tabela R122CEX_AUX na trigger EI */
  /* CURSOR na tabela r122cex_aux, o nome do CURSOR foi abreviado devido limitação no informix */
  /* de 18 caracteres para nome de identificadores, foi colocado 14 caracteres no máximo pois a */
  /* svcl adiciona mais 3 caracteres ao final */  
  CURSOR C_122CEX_I_AX IS
  SELECT NUMCAN, NOMBAI, TIPOPE
    FROM R122CEX_AUX
   WHERE TIPOPE = 'I';

  /* SINCRONIZAÇÃO DO NOME DO BAIRRO COM O CADASTRO DO CANDIDATO */
  /* RECORD com os campos da tabela R122CEX_AUX */
  TYPE t_r122CEX_aux IS RECORD(
    NUMCAN   R122CEX_AUX.NUMCAN%TYPE,    
    NOMBAI   R122CEX_AUX.NOMBAI%TYPE,
    TIPOPE   R122CEX_AUX.TIPOPE%TYPE);

  /* SINCRONIZAÇÃO DO NOME DO BAIRRO COM O CADASTRO DO CANDIDATO */
  l_r122CEX_aux t_r122CEX_aux;
BEGIN
  /* SINCRONIZAÇÃO DO NOME DO BAIRRO COM O CADASTRO DO CANDIDATO */
  /* Busca os registros inserido na AUX */
  FOREACH C_122CEX_I_AX INTO l_r122CEX_aux.NUMCAN,
                             l_r122CEX_aux.NOMBAI,
                             l_r122CEX_aux.TIPOPE
  LOOP
    /* Se o nome não estiver nulo deve ser ajustado na tabela R122CEX */
    /* Este estará nulo quando nenhum ajuste precisa ser feito (Tratado no INSERT da EI na tabela AUX)*/
    IF (l_r122CEX_aux.NOMBAI IS NOT NULL) THEN
      BEGIN
        /* Sincroniza o nome do bairro no cadastro do candidato com o nome */
        /* cadastrado no cadastro de bairros (R074BAI)*/
        UPDATE R122CEX
           SET NOMBAI = L_R122CEX_AUX.NOMBAI
         WHERE NUMCAN = L_R122CEX_AUX.NUMCAN;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao atualizar o nome do bairro na tabela R122CEX. (R122CEX_SI)';
      END;
    END IF;
  END LOOP;
   /* Apaga os registro da tabela R122CEX_AUX onde o seu tipo de operação for de inclusão */
  BEGIN
    DELETE FROM R122CEX_AUX WHERE TIPOPE = 'I';
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro Exclusão da tabela R122CEX_AUX onde o tipo de operação (TIPOPE) for de inclusão.';
  END;
END␀_à␀␀		SENIOR;0¯␀␀TRIGGER R122CEX_EI AFTER INSERT ON R122CEX FOR EACH ROW

DECLARE
/* SINCRONIZAÇÃO DO NOME DO BAIRRO COM O CADASTRO DO CANDIDATO */
  l_NomBaiOrig     R074BAI.NOMBAI%TYPE; /* Nome do bairro da tabela R074BAI, nome original do bairro */
  /* Variável para controle do que deve ser sincronizado, se esta variáveis */
  /* estiverem com o valor nulo não será executado update na tabela R122CEX, ou seja, a sincronização não será feita pois o registro já deve está correto */
  l_NomBai         R122CEX.NOMBAI%TYPE;
  l_isInformix   BOOLEAN;
  l_CamOri      VARCHAR2(50);
  l_NumCan      NUMBER;
  l_DthCan      NUMBER(14,6);  
  l_cnxusu       NUMBER(14);
  l_numsec		 NUMBER(14);
  l_program      VARCHAR2(40);
  l_machine      VARCHAR2(100);
  l_codusu		 NUMBER(10);  
  l_nomusu      VARCHAR2(100);
  l_mensagem    VARCHAR2(155);
  CURSOR C_R122LOC IS SELECT NUMCAN, CNXUSU, CODUSU FROM R122LOC WHERE NUMCAN = :NEW.NUMCAN;
BEGIN
	FOREACH C_R122LOC INTO l_numcan,
						   l_cnxusu,
						   l_codusu
	LOOP
		SP_GETSESSIONID(l_numsec OUT, l_program OUT, l_machine OUT);
		IF (l_cnxusu <> l_numsec) THEN
			BEGIN
				SELECT NOMUSU INTO l_nomusu FROM R999USU WHERE CODUSU = l_codusu;
				l_mensagem := 'Não é possível inserir o candidato '
				                ||CONVERT(NUMBER_TO_CHAR, l_NumCan)
				                ||' com o código informado, pois o mesmo está sendo utilizado pelo usuário: '
								||CONVERT(NUMBER_TO_CHAR, l_codusu) ||' - '
								||l_nomusu
								||' Na seção: '||CONVERT(NUMBER_TO_CHAR, l_cnxusu);
				RAISERROR 103 l_mensagem;
			END;
		END IF;
	END LOOP;
  l_NumCan := :NEW.NUMCAN;
  l_CamOri := IFNULL(:NEW.ABRTUR,' ');
  BEGIN
    RS_GRVABRTUR(l_NumCan, l_CamOri);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro na Inclusão do Candidato-Abrangência Turno.';
  END;

  l_NumCan := :NEW.NUMCAN;
  l_CamOri := IFNULL(:NEW.ABRHOR,' ');
  BEGIN
    RS_GRVABRHOR(l_NumCan, l_CamOri);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro na Inclusão do Candidato-Abrangência Horário.';
  END;

  l_NumCan := :NEW.NUMCAN;
  l_CamOri := IFNULL(:NEW.ABREMP,' ');
  BEGIN
    RS_GRVABREMP(l_NumCan, l_CamOri);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro na Inclusão do Candidato-Abrangência Empresa.';
  END;


  /* Variáveis utilizadas na sincronização do bairro no cadastro do candidato  */
  /* esta sincronização será feita quando o nome do bairro cadastrado no cadastro de candidato estiver diferente do cadastrado no cadastro de bairros (R074BAI)*/
  l_NomBai := NULL; 

  /* Se for informix não pode executar rotina de atualização do nome do bairro */
  /* Existe a limitação do banco e é gerado o erro -747 no informix                             */
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN

    /* Somente se o código do bairro for maior que zero deve prosseguir com a sincronização do nome do bairro */
    /* Se não entrar nesta condição a variável l_NomBai continua com o valor nulo */
    IF (IFNULL(:NEW.CODBAI, 0) > 0) THEN
      BEGIN
        /* Bunca o nome do bairro original, cadastrado no cadastro de bairros */
        SELECT NOMBAI INTO l_NomBaiOrig
          FROM R074BAI
         WHERE CODCID = :NEW.CODCID 
		   AND CODBAI = :NEW.CODBAI;
      EXCEPTION 
      WHEN NO_DATA_FOUND THEN
      	NULL;      
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler a tabela de cadastro de bairro (R074BAI) - (R122CEX_EI)';
      END;
      /* Se o nome informado para o bairro for diferente do original. continua com a sincronização */
      IF (IFNULL(:NEW.NOMBAI, ' ') <> l_NomBaiOrig) THEN
        /* Atribui o nome original do bairro para a variável, pois na SI será substituído o que o usuário */
        /* informou pelo nome original do bairro. */
        l_NomBai := l_NomBaiOrig;
      END IF;
    END IF;

    /* Se a variável l_NomBai não estiver nula, então insere na tabela R122CEX_AUX */
    /* para que na SI seja tratado se deve ser atualizado ou não, se por exemplo a variável l_NomBai */
    /* estiver com o valor nulo, não será sincronizado o nome do bairro quando chegar na SI */
    IF (l_NomBai IS NOT NULL) THEN
      BEGIN
        INSERT INTO R122CEX_AUX (NUMCAN, NOMBAI, TIPOPE)
                          VALUES (:NEW.NUMCAN, l_NomBai, 'I');
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao inserir na R122CEX_AUX (R122CEX_EI)';
      END;
    END IF;
  END IF;
  
  /* Insere registro CURRICULO COMPILADO */
  /* Garante que todo Candidato tenha registro na tabela R122CCO - Tarefa: 235534 */
  RS_INSCURCOMP(:NEW.NUMCAN, 0, 0, 0);  

  R122CEX_ATUCON(:NEW.NUMCAN, :NEW.NOMCAN, :NEW.DDICO1, :NEW.DDDCO1, :NEW.TELCO1, :NEW.CPFCAN, :NEW.USARFA);
END␀cà␀␀	SENIOR;0E␀␀

TRIGGER R122CEX_SU AFTER UPDATE ON R122CEX

DECLARE
/* SINCRONIZAÇÃO DO NOME DO BAIRRO DO CANDIDATO */
  /* CURSOR para buscar os registros que foram inseridos na tabela R122CEX_AUX na trigger EI */
  /* CURSOR na tabela r122cex_aux, o nome do CURSOR foi abreviado devido limitação no informix */
  /* de 18 caracteres para nome de identificadores, foi colocado 14 caracteres no máximo pois a */
  /* svcl adiciona mais 3 caracteres ao final */  
  CURSOR C_122CEX_U_AX IS
  SELECT NUMCAN, NOMBAI, TIPOPE
    FROM R122CEX_AUX
   WHERE TIPOPE = 'U';

  /* SINCRONIZAÇÃO DO NOME DO BAIRRO PARA O CADASTRO DO CANDIDATO */
  /* RECORD com os campos da tabela R122CEX_AUX */
  TYPE t_R122CEX_aux IS RECORD(
    NUMCAN   R122CEX_AUX.NUMCAN%TYPE,
    NOMBAI   R122CEX_AUX.NOMBAI%TYPE,
    TIPOPE   R122CEX_AUX.TIPOPE%TYPE);

  /* SINCRONIZAÇÃO DO NOME DO BAIRRO NO CADASTRO DO CANDIDATO */
  l_r122CEX_aux t_R122CEX_aux;

  l_Count       NUMBER;
BEGIN
  /* Garante que está sendo processado a trigger de _SU uma unica vez
     evitando assim LOOP, pois via trigger de SU é feito um update para o mesmo registro. */
  BEGIN
    SELECT COUNT(*) INTO l_Count FROM R122CEX_AUX
     WHERE TIPOPE = 'U' AND FLGCON = 1;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao retornar Flag de Controle da tabela R122CEX_AUX.';
  END;

  /* Se não existe registro com Flag = 1 significa estar passando pela primeira vez na trigger de _SU */
  IF (l_Count = 0) THEN
    /* Seta flag de controle para 1, evitando que a trigger de _SU seja
       processada em mais de uma instancia, controle necessário para evitar a Recursividade */
    BEGIN
      UPDATE R122CEX_AUX SET FLGCON = 1
       WHERE TIPOPE = 'U';
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro Flag de Controle da tabela R122CEX_AUX.';
    END;

    /* SINCRONIZAÇÃO DO NOME DO BAIRRO NO CADASTRO DE CANDIDATO */
    /* Busca os registros inserido na AUX */
    FOREACH C_122CEX_U_AX INTO l_R122CEX_aux.NUMCAN,
                               l_R122CEX_aux.NOMBAI,
                               l_R122CEX_aux.TIPOPE
    LOOP
      /* Se o nome não estiver nulo deve ser ajustado na tabela R122CEX */
      /* Este estará nulo quando nenhum ajuste precisa ser feito (Tratado no INSERT da EI na tabela AUX )*/
      IF (l_R122CEX_aux.NOMBAI IS NOT NULL) THEN
        BEGIN
          /* Sincroniza o nome do bairro do candidato */
          /* com o nome cadastrado no cadastro de bairros (R074BAI) */
          UPDATE R122CEX
             SET NOMBAI = L_R122CEX_AUX.NOMBAI
           WHERE NUMCAN = L_R122CEX_AUX.NUMCAN;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar o nome do bairro na tabela R122CEX. (R122CEX_SU)';
        END;
      END IF;
    END LOOP;

    /* Apaga os registro da tabela R122CEX_AUX onde o seu tipo de operação for de inclusão */
    BEGIN
      DELETE FROM R122CEX_AUX WHERE TIPOPE = 'U';
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro Exclusão da tabela R122CEX_AUX onde o tipo de operação (TIPOPE) for de alteração.';
    END;
  END IF;
END␀`à␀␀		SENIOR;0*␀␀

TRIGGER R122CEX_EU AFTER UPDATE ON R122CEX FOR EACH ROW

DECLARE
/* SINCRONIZAÇÃO DO BAIRRO DO CADASTRO DO CANDIDATO COM O BAIRRO CADASTRADO NA TABELA R074BAI */
  l_NomBaiOrig     R074BAI.NOMBAI%TYPE; /* Nome do bairro cadastrado na tebala R074BAI, nome original do bairro */
  /* Variável para controle do que deve ser sincronizado, se esta variáveis */
  /* estiverem com o valor nulo não será executado update na tabela R122CEX, ou seja, a sincronização não será feita pois o registro já deve está correto */
  l_NomBai         R122CEX.NOMBAI%TYPE;
  l_Count        NUMBER;
  l_isInformix   BOOLEAN;
  
  l_NumCan      NUMBER;
  l_AbrTurOld   VARCHAR2(50);
  l_AbrTurNew   VARCHAR2(50);
  l_AbrHorOld   VARCHAR2(50);
  l_AbrHorNew   VARCHAR2(50);
  l_AbrEmpOld   VARCHAR2(50);
  l_AbrEmpNew   VARCHAR2(50);
  l_QtdOriOpe    NUMBER;
  l_NumEmp       NUMBER;
  l_CodFic       NUMBER;
  l_QtdDef       NUMBER;
  l_TemMod       VARCHAR2(1);
  l_DthCan      NUMBER(14,6);

/* CURSOR para buscar as fichas médicas do colaborador/candidato. */
  CURSOR c_r110fic IS
  SELECT NUMEMP,CODFIC
    FROM R110FIC
   WHERE NUMCAN = :NEW.NUMCAN
     AND TIPATN = 4;
  
BEGIN
 l_NumCan    := :OLD.NUMCAN;
  l_AbrTurOld := :OLD.ABRTUR;
  l_AbrTurNew := :NEW.ABRTUR;
  l_AbrHorOld := :OLD.ABRHOR;
  l_AbrHorNew := :NEW.ABRHOR;
  l_AbrEmpOld := :OLD.ABREMP;
  l_AbrEmpNew := :NEW.ABREMP;
  RS_ALTABR(l_NumCan,l_AbrTurOld,l_AbrTurNew,l_AbrHorOld,l_AbrHorNew,l_AbrEmpOld,l_AbrEmpNew);

  /* Verifica se está integrado com o Medicina */
  RH_VER_MODULO_PRP(4,l_TemMod OUT);
  IF (l_TemMod = 'S') THEN

    /* Verifica se os campos relacionados a deficiência foram alterados */
    IF ((:NEW.CODDEF <> :OLD.CODDEF) OR
        (:NEW.DEFFIS <> :OLD.DEFFIS) OR
        (:NEW.BENREA <> :OLD.BENREA)) THEN

      /* Verifica se campo R110TRI.OriOpe possui registros */
      BEGIN
        SELECT COUNT(*) INTO l_QtdOriOpe FROM R110TRI;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_QtdOriOpe := 0;
      END;
    ELSE
      /* Seta valor padrão na qual indica que não houve alterações
         em relação a deficiência, não sendo necessário atualizar ficha
         médica e histórico */
      l_QtdOriOpe := 1;
    END IF;

    /* Se não existe registro na tabela R110TRI para o colaborador */
    IF (l_QtdOriOpe = 0) THEN
      /* Inclui registro na tabela R110TRI no campo ORIOPE valor 'C' */
      RH_SETORIOPE('C');

      /* Verifica o candidato possui Ficha Médica */
      FOREACH c_r110fic INTO l_NumEmp,l_CodFic
      LOOP
        IF (:NEW.CODDEF <> 0) AND (:NEW.CODDEF <> :OLD.CODDEF) THEN
          /* Verifica se a deficiência "nova" já existe no Histórico de Deficiências.
             Se não existe então insere a deficiência no histórico */
          BEGIN
            SELECT COUNT(*) INTO l_QtdDef FROM R110HDF
             WHERE NUMEMP = l_NumEmp
               AND CODFIC = l_CodFic
               AND CODDEF = :NEW.CODDEF;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT da tabela R110HDF.';
          END;

          /* Deleta a deficiência antiga do Histórico */
          BEGIN
            DELETE FROM R110HDF
             WHERE NUMEMP = l_NumEmp
               AND CODFIC = l_CodFic
               AND CODDEF = :OLD.CODDEF;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro no DELETE da tabela R110HDF.';
          END;

          /* Retira assinalamento de deficiência principal das outras deficiências já existentes */
          BEGIN
            UPDATE R110HDF SET PRIDEF = 'N'
                     WHERE NUMEMP = l_NumEmp
                       AND CODFIC = l_CodFic
                       AND PRIDEF = 'S';
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao Retirar assinalamento de Deficiência principal.';
          END;

          IF (l_QtdDef = 0) THEN
            /* Insere a deficiência "nova" no Histórico, como sendo a deficiência principal */
            BEGIN
              INSERT INTO R110HDF (NUMEMP,CODFIC,CODDEF,DATDEF,PRIDEF)
                   VALUES (l_NumEmp,l_CodFic,:NEW.CODDEF,:NEW.DATNAS,'S');
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao Inserir Deficiência na tabela R110HDF.';
            END;
          ELSE
            /* Se a deficiência já existe então seta ela como principal */
            BEGIN
              UPDATE R110HDF SET PRIDEF = 'S'
                           WHERE NUMEMP = l_NumEmp
                             AND CODFIC = l_CodFic
                             AND CODDEF = :NEW.CODDEF;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao setar Deficiência como principal.';
            END;
          END IF;

          /* Atualiza a ficha médica com a deficiência principal */
          BEGIN
            UPDATE R110FIC SET DEFFIS = :NEW.DEFFIS, CODDEF = :NEW.CODDEF, BENREA = :NEW.BENREA
                     WHERE NUMEMP = l_NumEmp
                       AND NUMCAN = :NEW.NUMCAN
                       AND CODFIC = l_CodFic
                       AND TIPATN = 4;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao Atualizar Deficiência na Ficha Médica.';
          END;
        ELSE
          IF (:NEW.CODDEF = 0) AND (:OLD.CODDEF <> 0) THEN
            /* Deleta a deficiência antiga do Histórico */
            BEGIN
              DELETE FROM R110HDF
               WHERE NUMEMP = l_NumEmp
                 AND CODFIC = l_CodFic
                 AND CODDEF = :OLD.CODDEF;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro no DELETE da tabela R110HDF.';
            END;

            /* Atualiza a ficha médica */
            BEGIN
              UPDATE R110FIC SET DEFFIS = :NEW.DEFFIS, CODDEF = :NEW.CODDEF, BENREA = :NEW.BENREA
                       WHERE NUMEMP = l_NumEmp
                         AND NUMCAN = :NEW.NUMCAN
                         AND CODFIC = l_CodFic
                         AND TIPATN = 4;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao Atualizar Deficiência na Ficha Médica.';
            END;

          ELSE
            IF (:NEW.CODDEF = :OLD.CODDEF) AND ((:NEW.DEFFIS <> :OLD.DEFFIS) OR (:NEW.BENREA <> :OLD.BENREA)) THEN

              /* Atualiza a ficha médica */
              BEGIN
                UPDATE R110FIC SET DEFFIS = :NEW.DEFFIS, BENREA = :NEW.BENREA
                       WHERE NUMEMP = l_NumEmp
                         AND NUMCAN = :NEW.NUMCAN
                         AND CODFIC = l_CodFic
                         AND TIPATN = 4;
              EXCEPTION WHEN OTHERS THEN
                RAISERROR 103 'Erro ao Atualizar Deficiência na Ficha Médica.';
              END;

            END IF;

          END IF;
        END IF;
      END LOOP;

      /* Exclui valor do campo R110TRI.OriOpe */
      RH_DELORIOPE('C');
    END IF;
  END IF;


  /* Inicio operações relacionadas a alteração do nome do bairro */
  l_NomBai := NULL;

  /* Se for informix não pode executar rotina de atualização do bairro */
  /* Existe a limitação do banco e é gerado o erro -747 no informix                             */
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN
    /* Sincroniza nome do bairro no cadastro do candidato */

    /* Somente se o código do bairro for maior que zero atualiza o nome do bairro do candidato com o mesmo valor cadastrado no cadastro do bairro */
    /* Se não entrar nesta condição a variável l_NomBai continua com o valor nulo */
    IF (IFNULL(:NEW.CODBAI, 0) > 0) THEN
        BEGIN
          /* Verifica se existe na _AUX, indica que o processo foi startado via UPDATE NA R074BAI,
             e sendo assim, não se deve executar a rotina abaixo, visto que os valores já estão
             corretos, e caso efetuar SELECT na tabela que disparou a trigger ocorrerá um erro.                                           */
          SELECT COUNT(*) INTO l_Count
            FROM R074BAI_AUX
           WHERE CODCID = :NEW.CODCID
		     AND CODBAI = :NEW.CODBAI;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler o cadastro de bairros (R074BAI_AUX) - (R122CEX_EU)';
        END;

        /* Se não existe registro na _aux */
        IF (l_Count = 0) THEN
          BEGIN
            /* Busca o nome do bairro original cadastrado na tabela R074BAI */
            SELECT NOMBAI INTO l_NomBaiOrig
              FROM R074BAI
             WHERE CODCID = :NEW.CODCID
			   AND CODBAI = :NEW.CODBAI;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              l_NomBaiOrig := ' ';
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao ler o cadastro de bairros (R074BAI) - (R122CEX_EU)';
          END;

          /* Se o nome informado para o bairro do candidato for diferente do nome original cadastrado na tabela R074BAI. continua com a sincronização */
          IF (IFNULL(:NEW.NOMBAI, ' ') <> l_NomBaiOrig) THEN
            /* Atribui o nome original do bairro para a variável, com isso na SU será substituído o que o usuário */
            /* informou pelo nome do bairro. */
            l_NomBai := l_NomBaiOrig;
          END IF;
        END IF;      
    END IF;

    /* Se l_NomBai não estiver nula, então insere na tabela R122CEX_AUX */
    /* para que na SI seja tratado se deve ser atualizado ou não, se por exemplo a variável l_NomBai */
    /* estiver com o valor nulo, não será sincronizado o nome do bairro quando chegar na SU */
    IF (l_NomBai IS NOT NULL) THEN
      BEGIN
        INSERT INTO R122CEX_AUX (NUMCAN, NOMBAI, TIPOPE, FLGCON)
                         VALUES (:NEW.NUMCAN, l_NomBai, 'U', 0);
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao inserir na R122CEX_AUX (R122CEX_EU)';
      END;	  
    END IF;
  END IF;  

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo Candidato está com registro atualizado na tabela R122CCO - Tarefa: 235534 */
  RS_UPDCURCOMP(:NEW.NUMCAN, 0, 0, 0);

  IF ((:NEW.NOMCAN <> :OLD.NOMCAN) OR
      (:NEW.DDICO1 <> :OLD.DDICO1) OR
      (:NEW.DDDCO1 <> :OLD.DDDCO1) OR
      (:NEW.TELCO1 <> :OLD.TELCO1) OR
      (:NEW.CPFCAN <> :OLD.CPFCAN) OR
      (:NEW.USARFA <> :OLD.USARFA)) THEN        
    R122CEX_ATUCON(:NEW.NUMCAN, :NEW.NOMCAN, :NEW.DDICO1, :NEW.DDDCO1, :NEW.TELCO1, :NEW.CPFCAN, :NEW.USARFA);
  END IF;

  IF ((:NEW.NOMCAN <> :OLD.NOMCAN) OR
      (:NEW.PESCAN <> :OLD.PESCAN) OR
      (:NEW.ALTCAN <> :OLD.ALTCAN)) THEN
    R122CEX_ATUFIC(:NEW.NUMCAN, :NEW.NOMCAN, :NEW.PESCAN, :NEW.ALTCAN);
  END IF;
END␀^à␀␀		SENIOR;0H␀␀

TRIGGER R122CEX_ED AFTER DELETE ON R122CEX FOR EACH ROW

DECLARE
l_NumCan      NUMBER;
BEGIN
  l_NumCan    := :OLD.NUMCAN;
  RS_DELABR(l_NumCan);

  /* Deleta registro CURRICULO COMPILADO */
  /* Garante que o registro na tabela R122CCO seja excluido - Tarefa: 235534 */
  RS_DELCURCOMP(:OLD.NUMCAN, 0, 0, 0);
