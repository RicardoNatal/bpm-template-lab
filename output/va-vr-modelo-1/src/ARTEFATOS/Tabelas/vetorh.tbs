TRIGGER R090MVI_EU AFTER UPDATE ON R090MVI FOR EACH ROW
DECLARE
l_online           BOOLEAN;
  l_gercrv           CHAR(1);
  l_bloaut           CHAR(1);
  l_tippev           NUMBER(1);
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_EnvChe           NUMBER(1);
  l_DesPor           VARCHAR(20);
  l_NomEmp           VARCHAR(40);
  l_NomVis           VARCHAR(80);
  l_Email            VARCHAR(100);
  l_NomFun           VARCHAR(40);
  l_DatPrv           DATE;
  l_HorPrv           NUMBER(4);
  l_verdoc           NUMBER(1);
  l_mblvis           NUMBER(1);
  l_DDITelFun        NUMBER(3);
  l_DDDTelFun        NUMBER(3);
  l_TelConFun        VARCHAR2(20);
  l_DDITelVis        NUMBER(3);
  l_DDDTelVis        NUMBER(3);
  l_TelConVis        VARCHAR2(20);
  l_data_zero        DATE;
  l_TemNot           NUMBER(1);
  l_ade_gerpen       BOOLEAN;
  l_podeIgnorar      BOOLEAN;
  l_datatu           DATE;

  CURSOR c_r090hch IS SELECT TIPDOC, NUMDOC, NUMCRA, DATINI, HORINI, DATFIM, HORFIM, SEQENT
                           FROM R090HCH
                           WHERE DATINI = :NEW.DATENT
                           AND HORINI = :NEW.HORENT
                           AND SEQENT = :NEW.SEQENT;
       TYPE t_r090hch IS RECORD(
                TIPDOC   R090HCH.TipDoc%TYPE,
                NUMDOC   R090HCH.NumDoc%TYPE,
                NUMCRA   R090HCH.NumCra%TYPE,
                DATINI   R090HCH.DatIni%TYPE,
                HORINI   R090HCH.HorIni%TYPE,
                DATFIM   R090HCH.DatFim%TYPE,
                HORFIM   R090HCH.HorFim%TYPE,
                SEQENT   R090HCH.SeqEnt%TYPE);
       l_r090hch t_r090hch;

BEGIN

  l_datatu    := CURDATE();
  l_data_zero := '31/12/1900,00:00:00';
  /* Ignoramos o update efetuado pela SP_SINFIS, para não disparar pendências com dados defasados. */
  l_podeIgnorar := FALSE;	
  
  IF (:NEW.DATSAI <> :OLD.DATSAI) AND (:OLD.DATSAI = l_data_zero) AND (:NEW.DATSAI = :NEW.DATVAL) AND (:NEW.DATSAI < l_datatu) AND (:NEW.HORSAI = 0) THEN
  	l_podeIgnorar := TRUE;
  END IF;
	
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) AND (l_podeIgnorar = FALSE) THEN

      IF (:NEW.TIPVIS <> :OLD.TIPVIS) THEN
          BEGIN
              SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
           EXCEPTION WHEN OTHERS THEN
              l_bloaut := 'N';
              l_tippev := 1;
           END;

           IF   l_bloaut =  'S' THEN
                l_bloaut := '1';
           ELSE l_bloaut := '0';
           END IF;
           /* atualiza os valores da alteração */
           SP_VISCON (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,:NEW.CODPRM,:NEW.DATENT,:NEW.HORENT,:NEW.DATVAL,:NEW.HORVAL,l_bloaut,l_tippev,:NEW.TIPVIS,0,0,0,1,1, :NEW.ANDVIS);
      END IF;

	  /* Verifica definições de acesso */
	  l_verdoc := 0;
	  l_mblvis := 0;
	  BEGIN
	      SELECT VERDOC, MBLVIS INTO l_verdoc, l_mblvis FROM R070DAC;
	  EXCEPTION
	      WHEN OTHERS THEN l_verdoc := 0;
	  END;

	  /* Bloqueia se houver colaborador associado */
	  IF (l_verdoc > 2) AND                            /* se bloqueia colaborador */
	     (l_mblvis > 0) AND                            /* se tem motivo para bloqueio cadastrado*/
	     ((:NEW.TIPDOC = 2) OR (:NEW.TIPDOC = 4)) THEN /* só considera CPF ou passaporte */
	     SP_BloColVIS(:NEW.TIPDOC, :NEW.NUMDOC, :NEW.DATENT, :NEW.HORENT, :NEW.DATSAI, :NEW.HORSAI, :NEW.CODUSU, l_mblvis);
	  END IF;

      /* Procedure que atualiza os creditos de acesso.*/
      IF (:NEW.NUMEMP <> :OLD.NUMEMP)
      OR (:NEW.TIPCOL <> :OLD.TIPCOL)
      OR (:NEW.NUMCAD <> :OLD.NUMCAD)
      OR (:NEW.DATVAL <> :OLD.DATVAL)
      OR (:NEW.TIPVIS <> :OLD.TIPVIS) THEN
          R090MVI_ATUCRV('U',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATENT,:NEW.DATVAL,:NEW.TIPVIS);
      END IF;

      SP_ATUCON (:NEW.NUMCRA,:NEW.CODPRM,:OLD.CODPRM,:NEW.DATVAL,
                 :NEW.HORVAL,:OLD.DATVAL,:OLD.HORVAL,:NEW.DATSAI,
                 :NEW.HORSAI,:NEW.ANDVIS);
  END IF;  

  /* GERACAO DE REGISTRO PARA O NOTIFICADOR */
  IF (:NEW.TipVis IS NOT NULL) AND (l_podeIgnorar = FALSE) THEN
    BEGIN
      SELECT EnvChe INTO l_EnvChe FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_EnvChe := 0;
      WHEN OTHERS THEN NULL;
    END;

	/* SE JA EXISTE NOTIFICACAO GERADA PARA ESTA MOVIMENTACAO DE VISITA, NAO GERO NOVAMENTE */
	BEGIN
      SELECT COUNT(CODORI) INTO l_TemNot FROM R115NOT WHERE :NEW.LOCAGV <> 0 AND CODORI = :NEW.LOCAGV;
    EXCEPTION
	  WHEN NO_DATA_FOUND THEN l_TemNot := 0;
      WHEN OTHERS THEN l_TemNot := 0;
    END;

    IF l_EnvChe <> 0 AND l_TemNot = 0 THEN
      IF (:NEW.DATSAI IS NULL OR :NEW.DATSAI = l_data_zero) THEN
        BEGIN
          SELECT R030EMP.NomEmp, R034FUN.NomFun INTO l_NomEmp, l_NomFun FROM R030EMP, R034FUN
          WHERE
            R030EMP.NUMEMP = :NEW.NUMEMP AND
            R034FUN.NUMEMP = :NEW.NUMEMP AND R034FUN.TIPCOL = :NEW.TIPCOL AND R034FUN.NUMCAD = :NEW.NUMCAD;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R090VIS.NomVis, R090VIS.DdiTel, R090VIS.DddTel, R090VIS.TelCon INTO l_NomVis, l_DDITelVis, l_DDDTelVis, l_TelConVis FROM R090VIS
          WHERE R090VIS.TIPDOC = :NEW.TIPDOC AND R090VIS.NUMDOC = :NEW.NUMDOC;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        /* EMail ou AMBOS*/
        IF (l_EnvChe = 1) OR (l_EnvChe = 9) THEN
          BEGIN
            SELECT R034CPL.EmaCom
            INTO l_Email
            FROM R034CPL
            WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
          EXCEPTION
            WHEN OTHERS THEN NULL;
          END;

          R115NOT_ATUNOT(3,
                         :NEW.LOCAGV, /* no update, nao consigo alterar um registro ja gravado */
                         l_NomVis,
                         '',
                         l_data_zero,  /* l_DatPrv */
                         0,  /* l_HorPrv */
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         l_DDITelVis,
                         l_DDDTelVis,
                         l_TelConVis,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,
                         0,
                         0,
                         '',
                         NULL, /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         l_Email, /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );
        END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - EMAIL*/

        /* SMS ou AMBOS */
        IF (l_EnvChe = 2) OR (l_EnvChe = 9) THEN
          BEGIN
            SELECT R034CPL.NmDdi2, R034CPL.NmDdd2, R034CPL.NmTel2
            INTO l_DDITelFun, l_DDDTelFun, l_TelConFun
            FROM R034CPL
            WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
          EXCEPTION
            WHEN OTHERS THEN NULL;
          END;

          R115NOT_ATUNOT(4,
                         :NEW.LOCAGV, /* no update, nao consigo alterar um registro ja gravado */
                         l_NomVis,
                         '',
                         l_data_zero,  /* l_DatPrv */
                         0,  /* l_HorPrv */
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         l_DDITelVis,
                         l_DDDTelVis,
                         l_TelConVis,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,
                         l_DDITelFun,
                         l_DDDTelFun,
                         l_TelConFun,
                         NULL, /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         '', /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );
        END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - SMS*/
      END IF; /* IF(:NEW.DATSAI IS NULL OR :NEW.DATSAI = l_data_zero)*/
	END IF; /* IF l_EnvChe <> 0 */
  END IF; /* FIM DA GERACAO DE REGISTRO PARA O NOTIFICADOR */

  /* Atualiza o campo Status Alfandegado no visitante/acompanhante (ADE-02) */
  IF (:NEW.CODPRM <> :OLD.CODPRM) AND (:NEW.CODPRM > 0) AND (l_podeIgnorar = FALSE) THEN
      SP_RECALF_GERPEN_1(4, l_ade_gerpen OUT);
      IF (l_ade_gerpen = TRUE) THEN
          /* Todos os crachás provenientes desta movimentação de visita (visitante e acompanhantes) */
          FOREACH c_r090hch INTO l_r090hch.TipDoc,
                                 l_r090hch.NumDoc,
                                 l_r090hch.NumCra,
                                 l_r090hch.DatIni,
                                 l_r090hch.HorIni,
                                 l_r090hch.DatFim,
                                 l_r090hch.HorFim,
                                 l_r090hch.SeqEnt
          LOOP
              SP_RECALF_PRMVIS(l_r090hch.TipDoc, l_r090hch.NumDoc, :NEW.CODPRM, l_r090hch.NumCra, l_r090hch.DatIni, l_r090hch.HorIni, l_r090hch.DatFim, l_r090hch.HorFim, l_r090hch.SeqEnt);
          END LOOP;
      END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090MVI');

  IF (l_auditoria = 'S') AND (l_podeIgnorar = FALSE) THEN

      l_camposAlterados := 'Campo(s) alterado(s): ';
      l_alterou := FALSE;

      IF (:NEW.DATENT <> :OLD.DATENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATENT ';
      END IF;

      IF (:NEW.HORENT <> :OLD.HORENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORENT ';
      END IF;

      IF (:NEW.SEQENT <> :OLD.SEQENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEQENT ';
      END IF;

      IF (:NEW.NUMCRA <> :OLD.NUMCRA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCRA ';
      END IF;

      IF (:NEW.NUMEMP <> :OLD.NUMEMP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMEMP ';
      END IF;

      IF (:NEW.TIPCOL <> :OLD.TIPCOL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPCOL ';
      END IF;

      IF (:NEW.NUMCAD <> :OLD.NUMCAD) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCAD ';
      END IF;

      IF (:NEW.TABORG <> :OLD.TABORG) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TABORG ';
      END IF;

      IF (:NEW.NUMLOC <> :OLD.NUMLOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMLOC ';
      END IF;

      IF (:NEW.CODPOR <> :OLD.CODPOR) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPOR ';
      END IF;

      IF (:NEW.TIPDOC <> :OLD.TIPDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPDOC ';
      END IF;

      IF (:NEW.NUMDOC <> :OLD.NUMDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMDOC ';
      END IF;

      IF (:NEW.SEGTDO <> :OLD.SEGTDO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEGTDO ';
      END IF;

      IF (:NEW.SEGDOC <> :OLD.SEGDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEGDOC ';
      END IF;

      IF (:NEW.PLAVEE <> :OLD.PLAVEE) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLAVEE ';
      END IF;

      IF (:NEW.CODPRM <> :OLD.CODPRM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPRM ';
      END IF;

      IF (:NEW.DDITEL <> :OLD.DDITEL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DDITEL ';
      END IF;

      IF (:NEW.DDDTEL <> :OLD.DDDTEL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DDDTEL ';
      END IF;

      IF (:NEW.TELCON <> :OLD.TELCON) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TELCON ';
      END IF;

      IF (:NEW.DATVAL <> :OLD.DATVAL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATVAL ';
      END IF;

      IF (:NEW.HORVAL <> :OLD.HORVAL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORVAL ';
      END IF;

      IF (:NEW.TIPVIS <> :OLD.TIPVIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPVIS ';
      END IF;

      IF (:NEW.OBSVIS <> :OLD.OBSVIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'OBSVIS ';
      END IF;

      IF (:NEW.CODUSU <> :OLD.CODUSU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODUSU ';
      END IF;

      IF (:NEW.DATSAI <> :OLD.DATSAI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATSAI ';
      END IF;

      IF (:NEW.HORSAI <> :OLD.HORSAI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORSAI ';
      END IF;

      IF (:NEW.DATSLO <> :OLD.DATSLO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATSLO ';
      END IF;

      IF (:NEW.HORSLO <> :OLD.HORSLO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORSLO ';
      END IF;

      IF (:NEW.PLAVES <> :NEW.PLAVES) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLAVES ';
      END IF;

      IF (:NEW.PLACAE <> :OLD.PLACAE) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACAE ';
      END IF;

      IF (:NEW.PLACAS <> :OLD.PLACAS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACAS ';
      END IF;

      IF (:NEW.ASSVID <> :OLD.ASSVID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'ASSVID ';
      END IF;

      IF (:NEW.CODOEM <> :OLD.CODOEM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODOEM ';
      END IF;

      IF (:NEW.NUMCON <> :OLD.NUMCON) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCON ';
      END IF;

      IF (:NEW.EMPCCU <> :OLD.EMPCCU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'EMPCCU ';
      END IF;

      IF (:NEW.CODCCU <> :OLD.CODCCU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODCCU ';
      END IF;

      IF (:NEW.NOMOEM <> :OLD.NOMOEM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NOMOEM ';
      END IF;

      IF (:NEW.CODLIB <> :OLD.CODLIB) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODLIB ';
      END IF;

      IF (:NEW.CODNAC <> :OLD.CODNAC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODNAC ';
      END IF;

      IF (:NEW.CODMOT <> :OLD.CODMOT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODMOT ';
      END IF;

      IF (:NEW.CRAVEI <> :OLD.CRAVEI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CRAVEI ';
      END IF;

      IF (:NEW.PLACE2 <> :OLD.PLACE2) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACE2 ';
      END IF;

      IF (:NEW.PLACE3 <> :OLD.PLACE3) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACE3 ';
      END IF;

      IF (:NEW.PLACS2 <> :OLD.PLACS2) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACS2 ';
      END IF;

      IF (:NEW.PLACS3 <> :OLD.PLACS3) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACS3 ';
      END IF;

      IF (:NEW.CPFRES <> :OLD.CPFRES) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CPFRES ';
      END IF;

      IF (:NEW.REPRES <> :OLD.REPRES) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'REPRES ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R090MVI_AUD
                   WHERE DATENT = :OLD.DATENT AND
                         HORENT = :OLD.HORENT AND
                         SEQENT = :OLD.SEQENT;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R090MVI_AUD (SEQREG,VERSEQ,DATENT,HORENT,SEQENT,NUMCRA,NUMEMP,TIPCOL,NUMCAD,TABORG,
                                   NUMLOC,CODPOR,TIPDOC,NUMDOC,SEGTDO,SEGDOC,PLAVEE,CODPRM,DDITEL,DDDTEL,
                                   DATVAL,HORVAL,TIPVIS,OBSVIS,CODUSU,DATSAI,HORSAI,DATSLO,HORSLO,PLAVES,
                                   TELCON,PLACAE,PLACAS,ASSVID,CODOEM,NUMCON,EMPCCU,CODCCU,NOMOEM,CODLIB,
                                   CODNAC,CODMOT,CRAVEI,PLACE2,PLACE3,PLACS2,PLACS3,EmaVis,LocAgv,
                                   VerPlf,CodPlf,ANDVIS,CPFRES,REPRES,REPTDO,REPDOC)
                           VALUES (l_seqreg,l_verseq,:NEW.DATENT,:NEW.HORENT,:NEW.SEQENT,:NEW.NUMCRA,:NEW.NUMEMP,
                                  :NEW.TIPCOL,:NEW.NUMCAD,:NEW.TABORG,:NEW.NUMLOC,:NEW.CODPOR,:NEW.TIPDOC,
                                  :NEW.NUMDOC,:NEW.SEGTDO,:NEW.SEGDOC,:NEW.PLAVEE,:NEW.CODPRM,:NEW.DDITEL,
                                  :NEW.DDDTEL,:NEW.DATVAL,:NEW.HORVAL,:NEW.TIPVIS,:NEW.OBSVIS,:NEW.CODUSU,
                                  :NEW.DATSAI,:NEW.HORSAI,:NEW.DATSLO,:NEW.HORSLO,:NEW.PLAVES,:NEW.TELCON,
                                  :NEW.PLACAE,:NEW.PLACAS,:NEW.ASSVID,:NEW.CODOEM,:NEW.NUMCON,:NEW.EMPCCU,
                                  :NEW.CODCCU,:NEW.NOMOEM,:NEW.CODLIB,:NEW.CODNAC,:NEW.CODMOT,:NEW.CRAVEI,
                                  :NEW.PLACE2,:NEW.PLACE3,:NEW.PLACS2,:NEW.PLACS3,:NEW.EmaVis,:NEW.LocAgv,
                                  :NEW.VerPlf,:NEW.CodPlf,:NEW.ANDVIS,:NEW.CPFRES,:NEW.REPRES,:NEW.REPTDO,
                                  :NEW.REPDOC);

              SP_AUDGENREG(l_seqreg,l_verseq,'R090MVI',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END		SENIOR;22†S␀␀

TRIGGER R090MVI_EU AFTER UPDATE ON R090MVI FOR EACH ROW
DECLARE
l_online           BOOLEAN;
  l_gercrv           CHAR(1);
  l_bloaut           CHAR(1);
  l_tippev           NUMBER(1);
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_EnvChe           NUMBER(1);
  l_DesPor           VARCHAR(20);
  l_NomEmp           VARCHAR(40);
  l_NomVis           VARCHAR(80);
  l_Email            VARCHAR(100);
  l_NomFun           VARCHAR(40);
  l_DatPrv           DATE;
  l_HorPrv           NUMBER(4);
  l_verdoc           NUMBER(1);
  l_mblvis           NUMBER(1);
  l_DDITelFun        NUMBER(3);
  l_DDDTelFun        NUMBER(3);
  l_TelConFun        VARCHAR2(20);
  l_DDITelVis        NUMBER(3);
  l_DDDTelVis        NUMBER(3);
  l_TelConVis        VARCHAR2(20);
  l_data_zero        DATE;
  l_TemNot           NUMBER(1);
  l_ade_gerpen       BOOLEAN;
  l_podeIgnorar      BOOLEAN;
  l_datatu           DATE;

  CURSOR c_r090hch IS SELECT TIPDOC, NUMDOC, NUMCRA, DATINI, HORINI, DATFIM, HORFIM, SEQENT
                           FROM R090HCH
                           WHERE DATINI = :NEW.DATENT
                           AND HORINI = :NEW.HORENT
                           AND SEQENT = :NEW.SEQENT;
       TYPE t_r090hch IS RECORD(
                TIPDOC   R090HCH.TipDoc%TYPE,
                NUMDOC   R090HCH.NumDoc%TYPE,
                NUMCRA   R090HCH.NumCra%TYPE,
                DATINI   R090HCH.DatIni%TYPE,
                HORINI   R090HCH.HorIni%TYPE,
                DATFIM   R090HCH.DatFim%TYPE,
                HORFIM   R090HCH.HorFim%TYPE,
                SEQENT   R090HCH.SeqEnt%TYPE);
       l_r090hch t_r090hch;

BEGIN

  l_datatu    := CURDATE();
  l_data_zero := '31/12/1900,00:00:00';
  /* Ignoramos o update efetuado pela SP_SINFIS, para não disparar pendências com dados defasados. */
  l_podeIgnorar := FALSE;	
  
  IF (:NEW.DATSAI <> :OLD.DATSAI) AND (:OLD.DATSAI = l_data_zero) AND (:NEW.DATSAI = :NEW.DATVAL) AND (:NEW.DATSAI < l_datatu) AND (:NEW.HORSAI = 0) THEN
  	l_podeIgnorar := TRUE;
  END IF;
	
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) AND (l_podeIgnorar = FALSE) THEN

      IF (:NEW.TIPVIS <> :OLD.TIPVIS) THEN
          BEGIN
              SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
           EXCEPTION WHEN OTHERS THEN
              l_bloaut := 'N';
              l_tippev := 1;
           END;

           IF   l_bloaut =  'S' THEN
                l_bloaut := '1';
           ELSE l_bloaut := '0';
           END IF;
           /* atualiza os valores da alteração */
           SP_VISCON (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,:NEW.CODPRM,:NEW.DATENT,:NEW.HORENT,:NEW.DATVAL,:NEW.HORVAL,l_bloaut,l_tippev,:NEW.TIPVIS,0,0,0,1,1, :NEW.ANDVIS);
      END IF;

	  /* Verifica definições de acesso */
	  l_verdoc := 0;
	  l_mblvis := 0;
	  BEGIN
	      SELECT VERDOC, MBLVIS INTO l_verdoc, l_mblvis FROM R070DAC;
	  EXCEPTION
	      WHEN OTHERS THEN l_verdoc := 0;
	  END;

	  /* Bloqueia se houver colaborador associado */
	  IF (l_verdoc > 2) AND                            /* se bloqueia colaborador */
	     (l_mblvis > 0) AND                            /* se tem motivo para bloqueio cadastrado*/
	     ((:NEW.TIPDOC = 2) OR (:NEW.TIPDOC = 4)) THEN /* só considera CPF ou passaporte */
	     SP_BloColVIS(:NEW.TIPDOC, :NEW.NUMDOC, :NEW.DATENT, :NEW.HORENT, :NEW.DATSAI, :NEW.HORSAI, :NEW.CODUSU, l_mblvis);
	  END IF;

      /* Procedure que atualiza os creditos de acesso.*/
      IF (:NEW.NUMEMP <> :OLD.NUMEMP)
      OR (:NEW.TIPCOL <> :OLD.TIPCOL)
      OR (:NEW.NUMCAD <> :OLD.NUMCAD)
      OR (:NEW.DATVAL <> :OLD.DATVAL)
      OR (:NEW.TIPVIS <> :OLD.TIPVIS) THEN
          R090MVI_ATUCRV('U',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATENT,:NEW.DATVAL,:NEW.TIPVIS);
      END IF;

      SP_ATUCON (:NEW.NUMCRA,:NEW.CODPRM,:OLD.CODPRM,:NEW.DATVAL,
                 :NEW.HORVAL,:OLD.DATVAL,:OLD.HORVAL,:NEW.DATSAI,
                 :NEW.HORSAI,:NEW.ANDVIS);
  END IF;  

  /* GERACAO DE REGISTRO PARA O NOTIFICADOR */
  IF (:NEW.TipVis IS NOT NULL) AND (l_podeIgnorar = FALSE) THEN
    BEGIN
      SELECT EnvChe INTO l_EnvChe FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_EnvChe := 0;
      WHEN OTHERS THEN NULL;
    END;

	/* SE JA EXISTE NOTIFICACAO GERADA PARA ESTA MOVIMENTACAO DE VISITA, NAO GERO NOVAMENTE */
	BEGIN
      SELECT COUNT(CODORI) INTO l_TemNot FROM R115NOT WHERE :NEW.LOCAGV <> 0 AND CODORI = :NEW.LOCAGV;
    EXCEPTION
	  WHEN NO_DATA_FOUND THEN l_TemNot := 0;
      WHEN OTHERS THEN l_TemNot := 0;
    END;

    IF l_EnvChe <> 0 AND l_TemNot = 0 THEN
      IF (:NEW.DATSAI IS NULL OR :NEW.DATSAI = l_data_zero) THEN
        BEGIN
          SELECT R030EMP.NomEmp, R034FUN.NomFun INTO l_NomEmp, l_NomFun FROM R030EMP, R034FUN
          WHERE
            R030EMP.NUMEMP = :NEW.NUMEMP AND
            R034FUN.NUMEMP = :NEW.NUMEMP AND R034FUN.TIPCOL = :NEW.TIPCOL AND R034FUN.NUMCAD = :NEW.NUMCAD;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R090VIS.NomVis, R090VIS.DdiTel, R090VIS.DddTel, R090VIS.TelCon INTO l_NomVis, l_DDITelVis, l_DDDTelVis, l_TelConVis FROM R090VIS
          WHERE R090VIS.TIPDOC = :NEW.TIPDOC AND R090VIS.NUMDOC = :NEW.NUMDOC;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        /* EMail ou AMBOS*/
        IF (l_EnvChe = 1) OR (l_EnvChe = 9) THEN
          BEGIN
            SELECT R034CPL.EmaCom
            INTO l_Email
            FROM R034CPL
            WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
          EXCEPTION
            WHEN OTHERS THEN NULL;
          END;

          R115NOT_ATUNOT(3,
                         :NEW.LOCAGV, /* no update, nao consigo alterar um registro ja gravado */
                         l_NomVis,
                         '',
                         l_data_zero,  /* l_DatPrv */
                         0,  /* l_HorPrv */
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         l_DDITelVis,
                         l_DDDTelVis,
                         l_TelConVis,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,
                         0,
                         0,
                         '',
                         NULL, /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         l_Email, /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );
        END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - EMAIL*/

        /* SMS ou AMBOS */
        IF (l_EnvChe = 2) OR (l_EnvChe = 9) THEN
          BEGIN
            SELECT R034CPL.NmDdi2, R034CPL.NmDdd2, R034CPL.NmTel2
            INTO l_DDITelFun, l_DDDTelFun, l_TelConFun
            FROM R034CPL
            WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
          EXCEPTION
            WHEN OTHERS THEN NULL;
          END;

          R115NOT_ATUNOT(4,
                         :NEW.LOCAGV, /* no update, nao consigo alterar um registro ja gravado */
                         l_NomVis,
                         '',
                         l_data_zero,  /* l_DatPrv */
                         0,  /* l_HorPrv */
                         :NEW.DATVAL,
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         l_DDITelVis,
                         l_DDDTelVis,
                         l_TelConVis,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,
                         l_DDITelFun,
                         l_DDDTelFun,
                         l_TelConFun,
                         NULL, /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         '', /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );
        END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - SMS*/
      END IF; /* IF(:NEW.DATSAI IS NULL OR :NEW.DATSAI = l_data_zero)*/
	END IF; /* IF l_EnvChe <> 0 */
  END IF; /* FIM DA GERACAO DE REGISTRO PARA O NOTIFICADOR */

  /* Atualiza o campo Status Alfandegado no visitante/acompanhante (ADE-02) */
  IF (:NEW.CODPRM <> :OLD.CODPRM) AND (:NEW.CODPRM > 0) AND (l_podeIgnorar = FALSE) THEN
      SP_RECALF_GERPEN_1(4, l_ade_gerpen OUT);
      IF (l_ade_gerpen = TRUE) THEN
          /* Todos os crachás provenientes desta movimentação de visita (visitante e acompanhantes) */
          FOREACH c_r090hch INTO l_r090hch.TipDoc,
                                 l_r090hch.NumDoc,
                                 l_r090hch.NumCra,
                                 l_r090hch.DatIni,
                                 l_r090hch.HorIni,
                                 l_r090hch.DatFim,
                                 l_r090hch.HorFim,
                                 l_r090hch.SeqEnt
          LOOP
              SP_RECALF_PRMVIS(l_r090hch.TipDoc, l_r090hch.NumDoc, :NEW.CODPRM, l_r090hch.NumCra, l_r090hch.DatIni, l_r090hch.HorIni, l_r090hch.DatFim, l_r090hch.HorFim, l_r090hch.SeqEnt);
          END LOOP;
      END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090MVI');

  IF (l_auditoria = 'S') AND (l_podeIgnorar = FALSE) THEN

      l_camposAlterados := 'Campo(s) alterado(s): ';
      l_alterou := FALSE;

      IF (:NEW.DATENT <> :OLD.DATENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATENT ';
      END IF;

      IF (:NEW.HORENT <> :OLD.HORENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORENT ';
      END IF;

      IF (:NEW.SEQENT <> :OLD.SEQENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEQENT ';
      END IF;

      IF (:NEW.NUMCRA <> :OLD.NUMCRA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCRA ';
      END IF;

      IF (:NEW.NUMEMP <> :OLD.NUMEMP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMEMP ';
      END IF;

      IF (:NEW.TIPCOL <> :OLD.TIPCOL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPCOL ';
      END IF;

      IF (:NEW.NUMCAD <> :OLD.NUMCAD) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCAD ';
      END IF;

      IF (:NEW.TABORG <> :OLD.TABORG) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TABORG ';
      END IF;

      IF (:NEW.NUMLOC <> :OLD.NUMLOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMLOC ';
      END IF;

      IF (:NEW.CODPOR <> :OLD.CODPOR) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPOR ';
      END IF;

      IF (:NEW.TIPDOC <> :OLD.TIPDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPDOC ';
      END IF;

      IF (:NEW.NUMDOC <> :OLD.NUMDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMDOC ';
      END IF;

      IF (:NEW.SEGTDO <> :OLD.SEGTDO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEGTDO ';
      END IF;

      IF (:NEW.SEGDOC <> :OLD.SEGDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEGDOC ';
      END IF;

      IF (:NEW.PLAVEE <> :OLD.PLAVEE) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLAVEE ';
      END IF;

      IF (:NEW.CODPRM <> :OLD.CODPRM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPRM ';
      END IF;

      IF (:NEW.DDITEL <> :OLD.DDITEL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DDITEL ';
      END IF;

      IF (:NEW.DDDTEL <> :OLD.DDDTEL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DDDTEL ';
      END IF;

      IF (:NEW.TELCON <> :OLD.TELCON) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TELCON ';
      END IF;

      IF (:NEW.DATVAL <> :OLD.DATVAL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATVAL ';
      END IF;

      IF (:NEW.HORVAL <> :OLD.HORVAL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORVAL ';
      END IF;

      IF (:NEW.TIPVIS <> :OLD.TIPVIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPVIS ';
      END IF;

      IF (:NEW.OBSVIS <> :OLD.OBSVIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'OBSVIS ';
      END IF;

      IF (:NEW.CODUSU <> :OLD.CODUSU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODUSU ';
      END IF;

      IF (:NEW.DATSAI <> :OLD.DATSAI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATSAI ';
      END IF;

      IF (:NEW.HORSAI <> :OLD.HORSAI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORSAI ';
      END IF;

      IF (:NEW.DATSLO <> :OLD.DATSLO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATSLO ';
      END IF;

      IF (:NEW.HORSLO <> :OLD.HORSLO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORSLO ';
      END IF;

      IF (:NEW.PLAVES <> :NEW.PLAVES) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLAVES ';
      END IF;

      IF (:NEW.PLACAE <> :OLD.PLACAE) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACAE ';
      END IF;

      IF (:NEW.PLACAS <> :OLD.PLACAS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACAS ';
      END IF;

      IF (:NEW.ASSVID <> :OLD.ASSVID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'ASSVID ';
      END IF;

      IF (:NEW.CODOEM <> :OLD.CODOEM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODOEM ';
      END IF;

      IF (:NEW.NUMCON <> :OLD.NUMCON) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCON ';
      END IF;

      IF (:NEW.EMPCCU <> :OLD.EMPCCU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'EMPCCU ';
      END IF;

      IF (:NEW.CODCCU <> :OLD.CODCCU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODCCU ';
      END IF;

      IF (:NEW.NOMOEM <> :OLD.NOMOEM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NOMOEM ';
      END IF;

      IF (:NEW.CODLIB <> :OLD.CODLIB) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODLIB ';
      END IF;

      IF (:NEW.CODNAC <> :OLD.CODNAC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODNAC ';
      END IF;

      IF (:NEW.CODMOT <> :OLD.CODMOT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODMOT ';
      END IF;

      IF (:NEW.CRAVEI <> :OLD.CRAVEI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CRAVEI ';
      END IF;

      IF (:NEW.PLACE2 <> :OLD.PLACE2) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACE2 ';
      END IF;

      IF (:NEW.PLACE3 <> :OLD.PLACE3) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACE3 ';
      END IF;

      IF (:NEW.PLACS2 <> :OLD.PLACS2) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACS2 ';
      END IF;

      IF (:NEW.PLACS3 <> :OLD.PLACS3) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACS3 ';
      END IF;

      IF (:NEW.CPFRES <> :OLD.CPFRES) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CPFRES ';
      END IF;

      IF (:NEW.REPRES <> :OLD.REPRES) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'REPRES ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R090MVI_AUD
                   WHERE DATENT = :OLD.DATENT AND
                         HORENT = :OLD.HORENT AND
                         SEQENT = :OLD.SEQENT;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R090MVI_AUD (SEQREG,VERSEQ,DATENT,HORENT,SEQENT,NUMCRA,NUMEMP,TIPCOL,NUMCAD,TABORG,
                                   NUMLOC,CODPOR,TIPDOC,NUMDOC,SEGTDO,SEGDOC,PLAVEE,CODPRM,DDITEL,DDDTEL,
                                   DATVAL,HORVAL,TIPVIS,OBSVIS,CODUSU,DATSAI,HORSAI,DATSLO,HORSLO,PLAVES,
                                   TELCON,PLACAE,PLACAS,ASSVID,CODOEM,NUMCON,EMPCCU,CODCCU,NOMOEM,CODLIB,
                                   CODNAC,CODMOT,CRAVEI,PLACE2,PLACE3,PLACS2,PLACS3,EmaVis,LocAgv,
                                   VerPlf,CodPlf,ANDVIS,CPFRES,REPRES,REPTDO,REPDOC)
                           VALUES (l_seqreg,l_verseq,:NEW.DATENT,:NEW.HORENT,:NEW.SEQENT,:NEW.NUMCRA,:NEW.NUMEMP,
                                  :NEW.TIPCOL,:NEW.NUMCAD,:NEW.TABORG,:NEW.NUMLOC,:NEW.CODPOR,:NEW.TIPDOC,
                                  :NEW.NUMDOC,:NEW.SEGTDO,:NEW.SEGDOC,:NEW.PLAVEE,:NEW.CODPRM,:NEW.DDITEL,
                                  :NEW.DDDTEL,:NEW.DATVAL,:NEW.HORVAL,:NEW.TIPVIS,:NEW.OBSVIS,:NEW.CODUSU,
                                  :NEW.DATSAI,:NEW.HORSAI,:NEW.DATSLO,:NEW.HORSLO,:NEW.PLAVES,:NEW.TELCON,
                                  :NEW.PLACAE,:NEW.PLACAS,:NEW.ASSVID,:NEW.CODOEM,:NEW.NUMCON,:NEW.EMPCCU,
                                  :NEW.CODCCU,:NEW.NOMOEM,:NEW.CODLIB,:NEW.CODNAC,:NEW.CODMOT,:NEW.CRAVEI,
                                  :NEW.PLACE2,:NEW.PLACE3,:NEW.PLACS2,:NEW.PLACS3,:NEW.EmaVis,:NEW.LocAgv,
                                  :NEW.VerPlf,:NEW.CodPlf,:NEW.ANDVIS,:NEW.CPFRES,:NEW.REPRES,:NEW.REPTDO,
                                  :NEW.REPDOC);

              SP_AUDGENREG(l_seqreg,l_verseq,'R090MVI',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END		SENIOR;21ÃS␀␀

TRIGGER R090MVI_EU AFTER UPDATE ON R090MVI FOR EACH ROW
DECLARE
  l_online           BOOLEAN;
  l_gercrv           CHAR(1);
  l_bloaut           CHAR(1);
  l_tippev           NUMBER(1);
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_EnvChe           NUMBER(1);
  l_DesPor           VARCHAR(20);
  l_NomEmp           VARCHAR(40);
  l_NomVis           VARCHAR(80);
  l_Email            VARCHAR(100);
  l_NomFun           VARCHAR(40);
  l_DatPrv           DATE; 
  l_HorPrv           NUMBER(4);
  l_verdoc           NUMBER(1);
  l_mblvis           NUMBER(1);  
  l_DDITelFun        NUMBER(3);
  l_DDDTelFun        NUMBER(3);
  l_TelConFun        VARCHAR2(20);
  l_DDITelVis        NUMBER(3);
  l_DDDTelVis        NUMBER(3);
  l_TelConVis        VARCHAR2(20);
  l_data_zero        DATE;
  l_TemNot           NUMBER(1);
  l_ade_gerpen       BOOLEAN;
  l_podeIgnorar      BOOLEAN;
  l_datatu           DATE;
  
  CURSOR c_r090hch IS SELECT TIPDOC, NUMDOC, NUMCRA, DATINI, HORINI, DATFIM, HORFIM, SEQENT
                           FROM R090HCH
                           WHERE DATINI = :NEW.DATENT
                           AND HORINI = :NEW.HORENT
                           AND SEQENT = :NEW.SEQENT;
       TYPE t_r090hch IS RECORD(
                TIPDOC   R090HCH.TipDoc%TYPE,
                NUMDOC   R090HCH.NumDoc%TYPE,
                NUMCRA   R090HCH.NumCra%TYPE,
                DATINI   R090HCH.DatIni%TYPE,
                HORINI   R090HCH.HorIni%TYPE,
                DATFIM   R090HCH.DatFim%TYPE,
                HORFIM   R090HCH.HorFim%TYPE,
                SEQENT   R090HCH.SeqEnt%TYPE);
       l_r090hch t_r090hch;

BEGIN

  l_datatu    := CURDATE();
  l_data_zero := '31/12/1900,00:00:00';
  /* Ignoramos o update efetuado pela SP_SINFIS, para não disparar pendências com dados defasados. */
  l_podeIgnorar := FALSE;
  IF (:NEW.DATSAI <> :OLD.DATSAI) AND (:OLD.DATSAI = l_data_zero) AND (:NEW.DATSAI = :NEW.DATVAL) AND (:NEW.DATSAI < l_datatu) AND (:NEW.HORSAI = 0) THEN
  	l_podeIgnorar := TRUE;
  END IF;
  
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) AND (l_podeIgnorar = FALSE) THEN

      IF (:NEW.TIPVIS <> :OLD.TIPVIS) THEN
          BEGIN
              SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
           EXCEPTION WHEN OTHERS THEN
              l_bloaut := 'N';
              l_tippev := 1;
           END;

           IF   l_bloaut =  'S' THEN
                l_bloaut := '1';
           ELSE l_bloaut := '0';
           END IF;
           /* atualiza os valores da alteração */
           SP_VISCON (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,:NEW.CODPRM,:NEW.DATENT,:NEW.HORENT,:NEW.DATVAL,:NEW.HORVAL,l_bloaut,l_tippev,:NEW.TIPVIS,0,0,0,1,1,:NEW.ANDVIS);
      END IF;

	  /* Verifica definições de acesso */
	  l_verdoc := 0;
	  l_mblvis := 0;
	  BEGIN
	      SELECT VERDOC, MBLVIS INTO l_verdoc, l_mblvis FROM R070DAC;
	  EXCEPTION 
	      WHEN OTHERS THEN l_verdoc := 0;
	  END;
	  
	  /* Bloqueia se houver colaborador associado */
	  IF (l_verdoc > 2) AND                            /* se bloqueia colaborador */
	     (l_mblvis > 0) AND                            /* se tem motivo para bloqueio cadastrado*/ 
	     ((:NEW.TIPDOC = 2) OR (:NEW.TIPDOC = 4)) THEN /* só considera CPF ou passaporte */
	     SP_BloColVIS(:NEW.TIPDOC, :NEW.NUMDOC, :NEW.DATENT, :NEW.HORENT, :NEW.DATSAI, :NEW.HORSAI, :NEW.CODUSU, l_mblvis);
	  END IF;
      
      /* Procedure que atualiza os creditos de acesso.*/
      IF (:NEW.NUMEMP <> :OLD.NUMEMP)
      OR (:NEW.TIPCOL <> :OLD.TIPCOL)
      OR (:NEW.NUMCAD <> :OLD.NUMCAD)
      OR (:NEW.DATVAL <> :OLD.DATVAL)
      OR (:NEW.TIPVIS <> :OLD.TIPVIS) THEN
          R090MVI_ATUCRV('U',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATENT,:NEW.DATVAL,:NEW.TIPVIS);
      END IF;

      SP_ATUCON (:NEW.NUMCRA,:NEW.CODPRM,:OLD.CODPRM,:NEW.DATVAL,
                 :NEW.HORVAL,:OLD.DATVAL,:OLD.HORVAL,:NEW.DATSAI,
                 :NEW.HORSAI,:NEW.ANDVIS);
  END IF;

  /* GERACAO DE REGISTRO PARA O NOTIFICADOR */
  IF (:NEW.TipVis IS NOT NULL) AND (l_podeIgnorar = FALSE) THEN
    BEGIN
      SELECT EnvChe INTO l_EnvChe FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_EnvChe := 0;
      WHEN OTHERS THEN NULL;
    END;
	
	/* SE JA EXISTE NOTIFICACAO GERADA PARA ESTA MOVIMENTACAO DE VISITA, NAO GERO NOVAMENTE */
	BEGIN
      SELECT COUNT(CODORI) INTO l_TemNot FROM R115NOT WHERE :NEW.LOCAGV <> 0 AND CODORI = :NEW.LOCAGV;
    EXCEPTION
	  WHEN NO_DATA_FOUND THEN l_TemNot := 0;
      WHEN OTHERS THEN l_TemNot := 0;
    END;

    IF l_EnvChe <> 0 AND l_TemNot = 0 THEN
      IF (:NEW.DATSAI IS NULL OR :NEW.DATSAI = l_data_zero) THEN
        BEGIN
          SELECT R030EMP.NomEmp, R034FUN.NomFun INTO l_NomEmp, l_NomFun FROM R030EMP, R034FUN
          WHERE 
            R030EMP.NUMEMP = :NEW.NUMEMP AND
            R034FUN.NUMEMP = :NEW.NUMEMP AND R034FUN.TIPCOL = :NEW.TIPCOL AND R034FUN.NUMCAD = :NEW.NUMCAD;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R090VIS.NomVis, R090VIS.DdiTel, R090VIS.DddTel, R090VIS.TelCon INTO l_NomVis, l_DDITelVis, l_DDDTelVis, l_TelConVis FROM R090VIS
          WHERE R090VIS.TIPDOC = :NEW.TIPDOC AND R090VIS.NUMDOC = :NEW.NUMDOC;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        /* EMail ou AMBOS*/
        IF (l_EnvChe = 1) OR (l_EnvChe = 9) THEN
          BEGIN
            SELECT R034CPL.EmaCom
            INTO l_Email
            FROM R034CPL
            WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
          EXCEPTION
            WHEN OTHERS THEN NULL;
          END;

          R115NOT_ATUNOT(3,
                         :NEW.LOCAGV, /* no update, nao consigo alterar um registro ja gravado */
                         l_NomVis,
                         '',
                         l_data_zero,  /* l_DatPrv */
                         0,  /* l_HorPrv */
                         :NEW.DATVAL, 
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         l_DDITelVis,
                         l_DDDTelVis,
                         l_TelConVis,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,
                         0,
                         0,
                         '',
                         NULL, /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         l_Email, /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );                       
        END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - EMAIL*/

        /* SMS ou AMBOS */
        IF (l_EnvChe = 2) OR (l_EnvChe = 9) THEN
          BEGIN
            SELECT R034CPL.NmDdi2, R034CPL.NmDdd2, R034CPL.NmTel2
            INTO l_DDITelFun, l_DDDTelFun, l_TelConFun
            FROM R034CPL
            WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
          EXCEPTION
            WHEN OTHERS THEN NULL;
          END;

          R115NOT_ATUNOT(4,
                         :NEW.LOCAGV, /* no update, nao consigo alterar um registro ja gravado */
                         l_NomVis,
                         '',
                         l_data_zero,  /* l_DatPrv */
                         0,  /* l_HorPrv */
                         :NEW.DATVAL, 
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         l_DDITelVis,
                         l_DDDTelVis,
                         l_TelConVis,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,
                         l_DDITelFun,
                         l_DDDTelFun,
                         l_TelConFun,
                         NULL, /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         '', /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );                       
        END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - SMS*/
      END IF; /* IF(:NEW.DATSAI IS NULL OR :NEW.DATSAI = l_data_zero)*/
	END IF; /* IF l_EnvChe <> 0 */
  END IF; /* FIM DA GERACAO DE REGISTRO PARA O NOTIFICADOR */

  /* Atualiza o campo Status Alfandegado no visitante/acompanhante (ADE-02) */
  IF (:NEW.CODPRM <> :OLD.CODPRM) AND (:NEW.CODPRM > 0) AND (l_podeIgnorar = FALSE) THEN
      SP_RECALF_GERPEN_1(4, l_ade_gerpen OUT);
      IF (l_ade_gerpen = TRUE) THEN
          /* Todos os crachás provenientes desta movimentação de visita (visitante e acompanhantes) */
          FOREACH c_r090hch INTO l_r090hch.TipDoc,
                                 l_r090hch.NumDoc,
                                 l_r090hch.NumCra,
                                 l_r090hch.DatIni,
                                 l_r090hch.HorIni,
                                 l_r090hch.DatFim,
                                 l_r090hch.HorFim,
                                 l_r090hch.SeqEnt
          LOOP
              SP_RECALF_PRMVIS(l_r090hch.TipDoc, l_r090hch.NumDoc, :NEW.CODPRM, l_r090hch.NumCra, l_r090hch.DatIni, l_r090hch.HorIni, l_r090hch.DatFim, l_r090hch.HorFim, l_r090hch.SeqEnt);
          END LOOP;
      END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090MVI');

  IF (l_auditoria = 'S') AND (l_podeIgnorar = FALSE) THEN

      l_camposAlterados := 'Campo(s) alterado(s): ';
      l_alterou := FALSE;

      IF (:NEW.DATENT <> :OLD.DATENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATENT ';
      END IF;

      IF (:NEW.HORENT <> :OLD.HORENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORENT ';
      END IF;

      IF (:NEW.SEQENT <> :OLD.SEQENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEQENT ';
      END IF;

      IF (:NEW.NUMCRA <> :OLD.NUMCRA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCRA ';
      END IF;

      IF (:NEW.NUMEMP <> :OLD.NUMEMP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMEMP ';
      END IF;

      IF (:NEW.TIPCOL <> :OLD.TIPCOL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPCOL ';
      END IF;

      IF (:NEW.NUMCAD <> :OLD.NUMCAD) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCAD ';
      END IF;

      IF (:NEW.TABORG <> :OLD.TABORG) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TABORG ';
      END IF;

      IF (:NEW.NUMLOC <> :OLD.NUMLOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMLOC ';
      END IF;

      IF (:NEW.CODPOR <> :OLD.CODPOR) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPOR ';
      END IF;

      IF (:NEW.TIPDOC <> :OLD.TIPDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPDOC ';
      END IF;

      IF (:NEW.NUMDOC <> :OLD.NUMDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMDOC ';
      END IF;

      IF (:NEW.SEGTDO <> :OLD.SEGTDO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEGTDO ';
      END IF;

      IF (:NEW.SEGDOC <> :OLD.SEGDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEGDOC ';
      END IF;

      IF (:NEW.PLAVEE <> :OLD.PLAVEE) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLAVEE ';
      END IF;

      IF (:NEW.CODPRM <> :OLD.CODPRM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPRM ';
      END IF;

      IF (:NEW.DDITEL <> :OLD.DDITEL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DDITEL ';
      END IF;

      IF (:NEW.DDDTEL <> :OLD.DDDTEL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DDDTEL ';
      END IF;

      IF (:NEW.TELCON <> :OLD.TELCON) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TELCON ';
      END IF;

      IF (:NEW.DATVAL <> :OLD.DATVAL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATVAL ';
      END IF;

      IF (:NEW.HORVAL <> :OLD.HORVAL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORVAL ';
      END IF;

      IF (:NEW.TIPVIS <> :OLD.TIPVIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPVIS ';
      END IF;

      IF (:NEW.OBSVIS <> :OLD.OBSVIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'OBSVIS ';
      END IF;

      IF (:NEW.CODUSU <> :OLD.CODUSU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODUSU ';
      END IF;

      IF (:NEW.DATSAI <> :OLD.DATSAI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATSAI ';
      END IF;

      IF (:NEW.HORSAI <> :OLD.HORSAI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORSAI ';
      END IF;

      IF (:NEW.DATSLO <> :OLD.DATSLO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATSLO ';
      END IF;

      IF (:NEW.HORSLO <> :OLD.HORSLO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORSLO ';
      END IF;

      IF (:NEW.PLAVES <> :NEW.PLAVES) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLAVES ';
      END IF;

      IF (:NEW.PLACAE <> :OLD.PLACAE) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACAE ';
      END IF;

      IF (:NEW.PLACAS <> :OLD.PLACAS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACAS ';
      END IF;

      IF (:NEW.ASSVID <> :OLD.ASSVID) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'ASSVID ';
      END IF;

      IF (:NEW.CODOEM <> :OLD.CODOEM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODOEM ';
      END IF;

      IF (:NEW.NUMCON <> :OLD.NUMCON) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCON ';
      END IF;

      IF (:NEW.EMPCCU <> :OLD.EMPCCU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'EMPCCU ';
      END IF;

      IF (:NEW.CODCCU <> :OLD.CODCCU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODCCU ';
      END IF;

      IF (:NEW.NOMOEM <> :OLD.NOMOEM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NOMOEM ';
      END IF;

      IF (:NEW.CODLIB <> :OLD.CODLIB) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODLIB ';
      END IF;

      IF (:NEW.CODNAC <> :OLD.CODNAC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODNAC ';
      END IF;

      IF (:NEW.CODMOT <> :OLD.CODMOT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODMOT ';
      END IF;

      IF (:NEW.CRAVEI <> :OLD.CRAVEI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CRAVEI ';
      END IF;

      IF (:NEW.PLACE2 <> :OLD.PLACE2) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACE2 ';
      END IF;

      IF (:NEW.PLACE3 <> :OLD.PLACE3) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACE3 ';
      END IF;

      IF (:NEW.PLACS2 <> :OLD.PLACS2) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACS2 ';
      END IF;

      IF (:NEW.PLACS3 <> :OLD.PLACS3) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PLACS3 ';
      END IF;

      IF (:NEW.CPFRES <> :OLD.CPFRES) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CPFRES ';
      END IF;

      IF (:NEW.REPRES <> :OLD.REPRES) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'REPRES ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R090MVI_AUD
                   WHERE DATENT = :OLD.DATENT AND
                         HORENT = :OLD.HORENT AND
                         SEQENT = :OLD.SEQENT;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R090MVI_AUD (SEQREG,VERSEQ,DATENT,HORENT,SEQENT,NUMCRA,NUMEMP,TIPCOL,NUMCAD,TABORG,
                                   NUMLOC,CODPOR,TIPDOC,NUMDOC,SEGTDO,SEGDOC,PLAVEE,CODPRM,DDITEL,DDDTEL,
                                   DATVAL,HORVAL,TIPVIS,OBSVIS,CODUSU,DATSAI,HORSAI,DATSLO,HORSLO,PLAVES,
                                   TELCON,PLACAE,PLACAS,ASSVID,CODOEM,NUMCON,EMPCCU,CODCCU,NOMOEM,CODLIB,
                                   CODNAC,CODMOT,CRAVEI,PLACE2,PLACE3,PLACS2,PLACS3,EmaVis,LocAgv,
                                   VerPlf,CodPlf,ANDVIS,CPFRES,REPRES,REPTDO,REPDOC)
                           VALUES (l_seqreg,l_verseq,:NEW.DATENT,:NEW.HORENT,:NEW.SEQENT,:NEW.NUMCRA,:NEW.NUMEMP,
                                  :NEW.TIPCOL,:NEW.NUMCAD,:NEW.TABORG,:NEW.NUMLOC,:NEW.CODPOR,:NEW.TIPDOC,
                                  :NEW.NUMDOC,:NEW.SEGTDO,:NEW.SEGDOC,:NEW.PLAVEE,:NEW.CODPRM,:NEW.DDITEL,
                                  :NEW.DDDTEL,:NEW.DATVAL,:NEW.HORVAL,:NEW.TIPVIS,:NEW.OBSVIS,:NEW.CODUSU,
                                  :NEW.DATSAI,:NEW.HORSAI,:NEW.DATSLO,:NEW.HORSLO,:NEW.PLAVES,:NEW.TELCON,
                                  :NEW.PLACAE,:NEW.PLACAS,:NEW.ASSVID,:NEW.CODOEM,:NEW.NUMCON,:NEW.EMPCCU,
                                  :NEW.CODCCU,:NEW.NOMOEM,:NEW.CODLIB,:NEW.CODNAC,:NEW.CODMOT,:NEW.CRAVEI,
                                  :NEW.PLACE2,:NEW.PLACE3,:NEW.PLACS2,:NEW.PLACS3,:NEW.EmaVis,:NEW.LocAgv,
                                  :NEW.VerPlf,:NEW.CodPlf,:NEW.ANDVIS,:NEW.CPFRES,:NEW.REPRES,:NEW.REPTDO,
                                  :NEW.REPDOC);

              SP_AUDGENREG(l_seqreg,l_verseq,'R090MVI',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END		SENIOR;23ÃS␀␀

TRIGGER R090MVI_EU AFTER UPDATE ON R090MVI FOR EACH ROW
DECLARE
  l_online           BOOLEAN;
  l_gercrv           CHAR(1);
  l_bloaut           CHAR(1);
  l_tippev           NUMBER(1);
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_EnvChe           NUMBER(1);
  l_DesPor           VARCHAR(20);
  l_NomEmp           VARCHAR(40);
  l_NomVis           VARCHAR(80);
  l_Email            VARCHAR(100);
  l_NomFun           VARCHAR(40);
  l_DatPrv           DATE; 
  l_HorPrv           NUMBER(4);
  l_verdoc           NUMBER(1);
  l_mblvis           NUMBER(1);  
  l_DDITelFun        NUMBER(3);
  l_DDDTelFun        NUMBER(3);
  l_TelConFun        VARCHAR2(20);
  l_DDITelVis        NUMBER(3);
  l_DDDTelVis        NUMBER(3);
  l_TelConVis        VARCHAR2(20);
  l_data_zero        DATE;
  l_TemNot           NUMBER(1);
  l_ade_gerpen       BOOLEAN;
  l_podeIgnorar      BOOLEAN;
  l_datatu           DATE;
  
  CURSOR c_r090hch IS SELECT TIPDOC, NUMDOC, NUMCRA, DATINI, HORINI, DATFIM, HORFIM, SEQENT
                           FROM R090HCH
                           WHERE DATINI = :NEW.DATENT
                           AND HORINI = :NEW.HORENT
                           AND SEQENT = :NEW.SEQENT;
       TYPE t_r090hch IS RECORD(
                TIPDOC   R090HCH.TipDoc%TYPE,
                NUMDOC   R090HCH.NumDoc%TYPE,
                NUMCRA   R090HCH.NumCra%TYPE,
                DATINI   R090HCH.DatIni%TYPE,
                HORINI   R090HCH.HorIni%TYPE,
                DATFIM   R090HCH.DatFim%TYPE,
                HORFIM   R090HCH.HorFim%TYPE,
                SEQENT   R090HCH.SeqEnt%TYPE);
       l_r090hch t_r090hch;

BEGIN

  l_datatu    := CURDATE();
  l_data_zero := '31/12/1900,00:00:00';
  /* Ignoramos o update efetuado pela SP_SINFIS, para não disparar pendências com dados defasados. */
  l_podeIgnorar := FALSE;
  IF (:NEW.DATSAI <> :OLD.DATSAI) AND (:OLD.DATSAI = l_data_zero) AND (:NEW.DATSAI = :NEW.DATVAL) AND (:NEW.DATSAI < l_datatu) AND (:NEW.HORSAI = 0) THEN
  	l_podeIgnorar := TRUE;
  END IF;
  
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) AND (l_podeIgnorar = FALSE) THEN

      IF (:NEW.TIPVIS <> :OLD.TIPVIS) THEN
          BEGIN
              SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
           EXCEPTION WHEN OTHERS THEN
              l_bloaut := 'N';
              l_tippev := 1;
           END;

           IF   l_bloaut =  'S' THEN
                l_bloaut := '1';
           ELSE l_bloaut := '0';
           END IF;
           /* atualiza os valores da alteração */
           SP_VISCON (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,:NEW.CODPRM,:NEW.DATENT,:NEW.HORENT,:NEW.DATVAL,:NEW.HORVAL,l_bloaut,l_tippev,:NEW.TIPVIS,0,0,0,1,1,:NEW.ANDVIS);
      END IF;

	  /* Verifica definições de acesso */
	  l_verdoc := 0;
	  l_mblvis := 0;
	  BEGIN
	      SELECT VERDOC, MBLVIS INTO l_verdoc, l_mblvis FROM R070DAC;
	  EXCEPTION 
	      WHEN OTHERS THEN l_verdoc := 0;
	  END;
	  
	  /* Bloqueia se houver colaborador associado */
	  IF (l_verdoc > 2) AND                            /* se bloqueia colaborador */
	     (l_mblvis > 0) AND                            /* se tem motivo para bloqueio cadastrado*/ 
	     ((:NEW.TIPDOC = 2) OR (:NEW.TIPDOC = 4)) THEN /* só considera CPF ou passaporte */
	     SP_BloColVIS(:NEW.TIPDOC, :NEW.NUMDOC, :NEW.DATENT, :NEW.HORENT, :NEW.DATSAI, :NEW.HORSAI, :NEW.CODUSU, l_mblvis);
	  END IF;
      
      /* Procedure que atualiza os creditos de acesso.*/
      IF (:NEW.NUMEMP <> :OLD.NUMEMP)
      OR (:NEW.TIPCOL <> :OLD.TIPCOL)
      OR (:NEW.NUMCAD <> :OLD.NUMCAD)
      OR (:NEW.DATVAL <> :OLD.DATVAL)
      OR (:NEW.TIPVIS <> :OLD.TIPVIS) THEN
          R090MVI_ATUCRV('U',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATENT,:NEW.DATVAL,:NEW.TIPVIS);
      END IF;

      SP_ATUCON (:NEW.NUMCRA,:NEW.CODPRM,:OLD.CODPRM,:NEW.DATVAL,
                 :NEW.HORVAL,:OLD.DATVAL,:OLD.HORVAL,:NEW.DATSAI,
                 :NEW.HORSAI,:NEW.ANDVIS);
  END IF;

  /* GERACAO DE REGISTRO PARA O NOTIFICADOR */
  IF (:NEW.TipVis IS NOT NULL) AND (l_podeIgnorar = FALSE) THEN
    BEGIN
      SELECT EnvChe INTO l_EnvChe FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_EnvChe := 0;
      WHEN OTHERS THEN NULL;
    END;
	
	/* SE JA EXISTE NOTIFICACAO GERADA PARA ESTA MOVIMENTACAO DE VISITA, NAO GERO NOVAMENTE */
	BEGIN
      SELECT COUNT(CODORI) INTO l_TemNot FROM R115NOT WHERE :NEW.LOCAGV <> 0 AND CODORI = :NEW.LOCAGV;
    EXCEPTION
	  WHEN NO_DATA_FOUND THEN l_TemNot := 0;
      WHEN OTHERS THEN l_TemNot := 0;
    END;

    IF l_EnvChe <> 0 AND l_TemNot = 0 THEN
      IF (:NEW.DATSAI IS NULL OR :NEW.DATSAI = l_data_zero) THEN
        BEGIN
          SELECT R030EMP.NomEmp, R034FUN.NomFun INTO l_NomEmp, l_NomFun FROM R030EMP, R034FUN
          WHERE 
            R030EMP.NUMEMP = :NEW.NUMEMP AND
            R034FUN.NUMEMP = :NEW.NUMEMP AND R034FUN.TIPCOL = :NEW.TIPCOL AND R034FUN.NUMCAD = :NEW.NUMCAD;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R090VIS.NomVis, R090VIS.DdiTel, R090VIS.DddTel, R090VIS.TelCon INTO l_NomVis, l_DDITelVis, l_DDDTelVis, l_TelConVis FROM R090VIS
          WHERE R090VIS.TIPDOC = :NEW.TIPDOC AND R090VIS.NUMDOC = :NEW.NUMDOC;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        BEGIN
          SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
        EXCEPTION
          WHEN OTHERS THEN NULL;
        END;

        /* EMail ou AMBOS*/
        IF (l_EnvChe = 1) OR (l_EnvChe = 9) THEN
          BEGIN
            SELECT R034CPL.EmaCom
            INTO l_Email
            FROM R034CPL
            WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
          EXCEPTION
            WHEN OTHERS THEN NULL;
          END;

          R115NOT_ATUNOT(3,
                         :NEW.LOCAGV, /* no update, nao consigo alterar um registro ja gravado */
                         l_NomVis,
                         '',
                         l_data_zero,  /* l_DatPrv */
                         0,  /* l_HorPrv */
                         :NEW.DATVAL, 
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         l_DDITelVis,
                         l_DDDTelVis,
                         l_TelConVis,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,
                         0,
                         0,
                         '',
                         NULL, /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         l_Email, /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );                       
        END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - EMAIL*/

        /* SMS ou AMBOS */
        IF (l_EnvChe = 2) OR (l_EnvChe = 9) THEN
          BEGIN
            SELECT R034CPL.NmDdi2, R034CPL.NmDdd2, R034CPL.NmTel2
            INTO l_DDITelFun, l_DDDTelFun, l_TelConFun
            FROM R034CPL
            WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
          EXCEPTION
            WHEN OTHERS THEN NULL;
          END;

          R115NOT_ATUNOT(4,
                         :NEW.LOCAGV, /* no update, nao consigo alterar um registro ja gravado */
                         l_NomVis,
                         '',
                         l_data_zero,  /* l_DatPrv */
                         0,  /* l_HorPrv */
                         :NEW.DATVAL, 
                         :NEW.HORVAL,
                         :NEW.NOMOEM,
                         l_DDITelVis,
                         l_DDDTelVis,
                         l_TelConVis,
                         l_DesPor,
                         l_NomEmp,
                         l_NomFun,
                         l_DDITelFun,
                         l_DDDTelFun,
                         l_TelConFun,
                         NULL, /* SituacaoWAV */
                         NULL, /* TIPDOC */
                         '', /* Desc. TipDoc*/
                         '', /* NUMDOC */
                         NULL, /* TIPVIS */
                         '', /* NomTIPVIS */
                         NULL, /* CODPOR */
                         NULL, /* CODPRM */
                         '', /* DESPRM */
                         '', /* PLAVEI*/
                         '', /* NomAut */
                         '', /* OBSVIS */
                         '', /* NomSol */
                         '', /* EmaSol */
                         NULL, /* DATSAG */
                         NULL, /* HORSAG */
                         '', /* NOMUSU */
                         NULL, /* DATPSA */
                         NULL, /* HORPSA */
                         '' /* OBSREP */
                         );                       
        END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - SMS*/
      END IF; /* IF(:NEW.DATSAI IS NULL OR :NEW.DATSAI = l_data_zero)*/
	END IF; /* IF l_EnvChe <> 0 */
  END IF; /* FIM DA GERACAO DE REGISTRO PARA O NOTIFICADOR */

  /* Atualiza o campo Status Alfandegado no visitante/acompanhante (ADE-02) */
  IF (:NEW.CODPRM <> :OLD.CODPRM) AND (:NEW.CODPRM > 0) AND (l_podeIgnorar = FALSE) THEN
      SP_RECALF_GERPEN_1(4, l_ade_gerpen OUT);
      IF (l_ade_gerpen = TRUE) THEN
          /* Todos os crachás provenientes desta movimentação de visita (visitante e acompanhantes) */
          FOREACH c_r090hch INTO l_r090hch.TipDoc,
                                 l_r090hch.NumDoc,
                                 l_r090hch.NumCra,
                                 l_r090hch.DatIni,
                                 l_r090hch.HorIni,
                                 l_r090hch.DatFim,
                                 l_r090hch.HorFim,
                                 l_r090hch.SeqEnt
          LOOP
              SP_RECALF_PRMVIS(l_r090hch.TipDoc, l_r090hch.NumDoc, :NEW.CODPRM, l_r090hch.NumCra, l_r090hch.DatIni, l_r090hch.HorIni, l_r090hch.DatFim, l_r090hch.HorFim, l_r090hch.SeqEnt);
          END LOOP;
      END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090MVI');

  IF (l_auditoria = 'S') AND (l_podeIgnorar = FALSE) THEN

      l_camposAlterados := 'Campo(s) alterado(s): ';
      l_alterou := FALSE;

      IF (:NEW.DATENT <> :OLD.DATENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATENT ';
      END IF;

      IF (:NEW.HORENT <> :OLD.HORENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORENT ';
      END IF;

      IF (:NEW.SEQENT <> :OLD.SEQENT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'SEQENT ';
