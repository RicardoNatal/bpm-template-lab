␀␀␀␀	0;1;2;3;4?Ñ␀␀		SENIOR;0î␀␀TRIGGER R024RIS_EI AFTER INSERT ON R024RIS FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DatIniHis DATE;
	l_DatTerHis DATE;
	l_DataInicioSST DATE;
  	l_EstCarStr VARCHAR(4);
  	l_CodCarStr VARCHAR(24);
  	l_Where VARCHAR(2000);
	l_NumEmp   R030DES.NumEmp%TYPE;
	l_Json VARCHAR(2000);
	
	CURSOR C_R030DES IS SELECT NumEmp, IniSST 
	FROM R030DES 
	WHERE IniSST > l_DataZero AND (l_DatTerHis > IniSST OR l_DatTerHis = l_DataZero) 
	ORDER BY NumEmp;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DatIniHis := :NEW.DatHis;
	
	l_EstCarStr := CONVERT(NUMBER_TO_CHAR, :NEW.EstCar);
	l_CodCarStr := :NEW.CodCar;
	l_Where := 'ESTCAR = ' || l_EstCarStr || ' AND CODCAR = ''' || l_CodCarStr || '''';
  	SP_PROXHIST_NPER('DATHIS', 'R024HDE', l_Where, l_DatIniHis, l_DatTerHis OUT);
  	
  	SP_CONCATENAR_NUM('ESTCAR', :NEW.EstCar, l_Json OUT);
  	SP_CONCATENAR_DES('CODCAR', :NEW.CodCar, l_Json OUT);
  	SP_CONCATENAR_DAT('DATHIS', :NEW.DatHis, l_Json OUT);
  	
  	FOREACH C_R030DES INTO l_NumEmp, l_DataInicioSST
  	LOOP
		IF (l_DatIniHis < l_DataInicioSST) THEN
			l_DatIniHis := l_DataInicioSST;
		END IF;
	
		SP_E_SOCIAL_SM('S-2240', 'R024RIS', 'N', 'I', l_DatIniHis, l_DatTerHis, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DatIniHis, 0, 'R024RIS_EI');
  	END LOOP;
END␀@Ñ␀␀		SENIOR;0ù␀␀

TRIGGER R024RIS_EU AFTER UPDATE ON R024RIS FOR EACH ROW
DECLARE
	l_Alterou BOOLEAN;
	l_DataZero DATE;
	l_DatIniHis DATE;
	l_DatTerHis DATE;
	l_DataInicioSST DATE;
  	l_EstCarStr VARCHAR(4);
  	l_CodCarStr VARCHAR(24);
  	l_Where VARCHAR(200);
	l_NumEmp   R030DES.NumEmp%TYPE;
	l_Json VARCHAR(2000);
	l_JsonAlteracao VARCHAR2(2000);
	
	CURSOR C_R030DES IS SELECT NumEmp, IniSST 
	FROM R030DES 
	WHERE IniSST > l_DataZero AND (l_DatTerHis > IniSST OR l_DatTerHis = l_DataZero) 
	ORDER BY NumEmp;
BEGIN
	SP_VALUPDATE_NUM(:OLD.CodAtv, :NEW.CodAtv, l_Alterou OUT);
	IF (l_Alterou = TRUE) THEN
		l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
		l_DatIniHis := :NEW.DatHis;		
		SP_CONCAT_NUM_JSON('CODATV', :NEW.CodAtv, :OLD.CodAtv, l_JsonAlteracao OUT); 
		
		l_EstCarStr := CONVERT(NUMBER_TO_CHAR, :NEW.EstCar);
		l_CodCarStr := :NEW.CodCar;
		l_Where := 'ESTCAR = ' || l_EstCarStr || ' AND CODCAR = ''' || l_CodCarStr || '''';
	  	SP_PROXHIST_NPER('DATHIS', 'R024HDE', l_Where, :NEW.DatHis, l_DatTerHis OUT);
	  	
		SP_CONCATENAR_NUM('ESTCAR', :NEW.EstCar, l_Json OUT);
		SP_CONCATENAR_DES('CODCAR', :NEW.CodCar, l_Json OUT);
		SP_CONCATENAR_DAT('DATHIS', :NEW.DatHis, l_Json OUT);
	  	
	   	FOREACH C_R030DES INTO l_NumEmp, l_DataInicioSST
	  	LOOP
			IF (l_DatIniHis < l_DataInicioSST) THEN
				l_DatIniHis := l_DataInicioSST;
			END IF;
  		
  			SP_E_SOCIAL_SM('S-2240', 'R024RIS', 'N', 'A', l_DatIniHis, l_DatTerHis, l_NumEmp, 0, 0, l_Json, l_JsonAlteracao, 0, NULL, l_DatIniHis, 0, 'R024RIS_EU');
	  	END LOOP;
  	END IF;
END␀>Ñ␀␀		SENIOR;0ğ␀␀

TRIGGER R024RIS_ED AFTER DELETE ON R024RIS FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DatIniHis DATE;
	l_DatTerHis DATE;
	l_DataInicioSST DATE;
  	l_EstCarStr VARCHAR(4);
  	l_CodCarStr VARCHAR(24);
  	l_Where VARCHAR(200);
	l_NumEmp   R030DES.NumEmp%TYPE;
	l_Json VARCHAR(2000);
	
	CURSOR C_R030DES IS SELECT NumEmp, IniSST 
	FROM R030DES 
	WHERE IniSST > l_DataZero AND (l_DatTerHis > IniSST OR l_DatTerHis = l_DataZero) 
	ORDER BY NumEmp;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DatIniHis := :OLD.DatHis;
	
	l_EstCarStr := CONVERT(NUMBER_TO_CHAR, :OLD.EstCar);
	l_CodCarStr := :OLD.CodCar;
	l_Where := 'ESTCAR = ' || l_EstCarStr || ' AND CODCAR = ''' || l_CodCarStr || '''';
  	SP_PROXHIST_NPER('DATHIS', 'R024HDE', l_Where, l_DatIniHis, l_DatTerHis OUT);
  	
  	SP_CONCATENAR_NUM('ESTCAR', :OLD.EstCar, l_Json OUT);
  	SP_CONCATENAR_DES('CODCAR', :OLD.CodCar, l_Json OUT);
  	SP_CONCATENAR_DAT('DATHIS', :OLD.DatHis, l_Json OUT);
  	
   	FOREACH C_R030DES INTO l_NumEmp, l_DataInicioSST
   	LOOP
		IF (l_DatIniHis < l_DataInicioSST) THEN
			l_DatIniHis := l_DataInicioSST;
		END IF;

		SP_E_SOCIAL_SM('S-2240', 'R024RIS', 'N', 'E', l_DatIniHis, l_DatTerHis, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DatIniHis, 0, 'R024RIS_ED');
  	END LOOP;
END␀␀␀î'␀␀␀␀␀␀AÑ␀␀f´␀	␀␀␀␀␀␀␀÷<ïe»fr␀Æÿ␀␀)Ñ␀␀␀0,4	␀␀␀␀␀␀␀ÿ?µ'µ'}␀␀ÿ␀␀Ñ␀␀␀˜EÑ␀	␀␀␀␀␀␀␀?M“H”HqCş‡␀êÿ␀␀ÿ␀@UF␀␀␀␀␀␀␀ïYeò␀␀eò␀␀=␀␀ÿ␀␀ÿ␀␀␀␀0;1;2␀␀	¹␀␀␀␀␀␀␀BÑ␀␀f´␀	€ƒ␀␀␀␀␀=ïe»fr␀Æÿ␀␀)Ñ␀␀␀0,4	€ƒ␀␀␀␀␀ÿ?µ'µ'}␀␀ÿ␀␀Ñ␀␀␀˜EÑ␀	€ƒ␀␀␀␀␀?M“H”HqCş‡␀êÿ␀␀ÿ␀aÁ␀␀¿␀€ƒ␀␀␀␀␀šÁ␀␀aÁ␀␀šÁ␀␀R)␀␀Æÿ␀␀ÿ␀`Á␀␀¿␀€ƒ␀␀␀␀␀—Á␀␀`Á␀␀—Á␀␀R)␀␀Æÿ␀␀ÿ␀ì±␀€ƒ␀␀␀␀␀<ì<O)␀␀Æÿ␀␀ÿ␀ë±␀€ƒ␀␀␀␀␀9ë9O)␀␀Æÿ␀␀ÿ␀ƒ‰␀␀±␀€ƒ␀␀␀␀␀Ÿ‰␀␀ƒ‰␀␀Ÿ‰␀␀O)␀␀Æÿ␀␀ÿ␀‚‰␀␀±␀€ƒ␀␀␀␀␀™‰␀␀‚‰␀␀™‰␀␀O)␀␀Æÿ␀␀ÿ␀8␀#€ƒ␀␀␀␀␀¡␀␀Dù␀␀Ÿ␀␀c␀␀␀ÿ␀␀ÿ␀™,±␀€ƒ␀␀␀␀␀¶=ğ␀␀ğ␀␀q␀Æÿ␀␀ÿ␀8€ƒ␀␀␀␀␀½QfRf?␀␀ÿ␀␀ÿ␀"8€ƒ␀␀␀␀␀¦␀␀¦␀␀?␀␀ÿ␀␀ÿ␀8€ƒ␀␀␀␀␀QtRt?␀␀ÿ␀␀ÿ␀.8€ƒ␀␀␀␀␀ŸË␀␀Ë␀␀?␀␀ÿ␀␀ÿ␀*8€ƒ␀␀␀␀␀²X3Y3?␀␀ÿ␀␀ÿ␀8€ƒ␀␀␀␀␀º\dVd?␀␀ÿ␀␀ÿ␀8€ƒ␀␀␀␀␀¹PdTd?␀␀ÿ␀␀ÿ␀K8€ƒ␀␀␀␀␀␀␀?␀␀ÿ␀␀ÿ␀8€ƒ␀␀␀␀␀ìzíz?␀␀ÿ␀␀ÿ␀H8€ƒ␀␀␀␀␀ß
