    END IF;

    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'telefone', l_fonVisitado);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'dataChegada', l_DatAtuStr);
