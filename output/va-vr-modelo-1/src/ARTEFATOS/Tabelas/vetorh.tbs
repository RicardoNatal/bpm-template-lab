DECLARE
/* CURSOR c/ os registros gravados no R064ASA_AUX */
  CURSOR c_r064asa_ins IS
  SELECT NUMEMP,TIPCOL,NUMCAD,DATASA FROM R064ASA_AUX;
  TYPE t_r064asa_aux IS RECORD(
    NUMEMP   R064ASA_AUX.NUMEMP%TYPE,
    TIPCOL   R064ASA_AUX.TIPCOL%TYPE,
    NUMCAD   R064ASA_AUX.NUMCAD%TYPE,
    DATASA   R064ASA_AUX.DATASA%TYPE);
  l_r064asa_aux t_r064asa_aux;


BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r064asa_ins INTO  l_r064asa_aux.NUMEMP,
                              l_r064asa_aux.TIPCOL,
                              l_r064asa_aux.NUMCAD,
                              l_r064asa_aux.DATASA
  LOOP
    SP_HisAsa (l_r064asa_aux.NUMEMP, l_r064asa_aux.TIPCOL, l_r064asa_aux.NUMCAD,'', l_r064asa_aux.DATASA);
  END LOOP;
  /* Apaga Registro OLD/NEW em R064ASA_AUX */
  BEGIN
    DELETE FROM R064ASA_AUX;
    DROP_TEMP_TABLE R064ASA_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ŠØ␀␀		SENIOR;0Û␀␀

TRIGGER R064ASA_EI AFTER INSERT ON R064ASA FOR EACH ROW

DECLARE
  l_online       BOOLEAN;
  l_datfim       DATE;

  /* Tabela temporária */
  CREATE_TEMP_TABLE R064ASA_AUX;
  
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       BEGIN
       /* Insere Registro NEW */
         INSERT INTO R064ASA_AUX (NUMEMP,TIPCOL,NUMCAD,DATASA)
         VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATASA);
       EXCEPTION WHEN OTHERS THEN
         RAISERROR 103 'Erro no INSERT em R064ASA_AUX.';
       END;
  END IF;

  l_datfim := :NEW.DATASA;
  IF   (:NEW.HORTER < :NEW.HORASA) THEN
       l_datfim := DATETIMEADD (DD, +1, l_datfim);
  END IF;

  BEGIN
  UPDATE R066APU SET DIAALT = 6
         WHERE NUMEMP = :NEW.NUMEMP AND
               TIPCOL = :NEW.TIPCOL AND
               NUMCAD = :NEW.NUMCAD AND
               DATAPU >= :NEW.DATASA AND
               DATAPU <= l_datfim;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀Ø␀␀	SENIOR;0Ê␀␀

TRIGGER R064ASA_SU AFTER UPDATE ON R064ASA

DECLARE
/* CURSOR c/ os registros gravados no R064ASA_AUX */
  CURSOR c_r064asa_upd IS
  SELECT NUMEMP,TIPCOL,NUMCAD,DATASA FROM R064ASA_AUX;
  TYPE t_r064asa_aux IS RECORD(
    NUMEMP   R064ASA_AUX.NUMEMP%TYPE,
    TIPCOL   R064ASA_AUX.TIPCOL%TYPE,
    NUMCAD   R064ASA_AUX.NUMCAD%TYPE,
    DATASA   R064ASA_AUX.DATASA%TYPE);
  l_r064asa_aux t_r064asa_aux;

BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r064asa_upd INTO  l_r064asa_aux.NUMEMP,
                              l_r064asa_aux.TIPCOL,
                              l_r064asa_aux.NUMCAD,
                              l_r064asa_aux.DATASA
  LOOP
    SP_HisAsa (l_r064asa_aux.NUMEMP, l_r064asa_aux.TIPCOL, l_r064asa_aux.NUMCAD,'', l_r064asa_aux.DATASA);
  END LOOP;
  /* Apaga Registro OLD/NEW em R064ASA_AUX */
  BEGIN
    DELETE FROM R064ASA_AUX;
    DROP_TEMP_TABLE R064ASA_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀‹Ø␀␀		SENIOR;0"␀␀

TRIGGER R064ASA_EU AFTER UPDATE ON R064ASA FOR EACH ROW

DECLARE
  l_online       BOOLEAN;
  l_datfim       DATE;
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R064ASA_AUX;
  
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       BEGIN
       /* Insere Registro NEW */
         INSERT INTO R064ASA_AUX (NUMEMP,TIPCOL,NUMCAD,DATASA)
         VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATASA);
       EXCEPTION WHEN OTHERS THEN
         RAISERROR 103 'Erro no INSERT em R064ASA_AUX.';
       END;
  END IF;

  l_datfim := :NEW.DATASA;
  IF   (:NEW.HORTER < :NEW.HORASA) THEN
       l_datfim := DATETIMEADD (DD, +1, l_datfim);
  END IF;

  /* Verifica se foi alterado alguma campo que infuencia. Campo status nao influencia. */
  IF  (:NEW.HORTER <> :OLD.HORTER) OR (:NEW.CODSIT <> :OLD.CODSIT) OR (:NEW.EMPAUT <> :OLD.EMPAUT) OR
      (:NEW.TCLAUT <> :OLD.TCLAUT) OR (:NEW.CADAUT <> :OLD.CADAUT) OR (:NEW.CODUSU <> :OLD.CODUSU) THEN
      BEGIN
      UPDATE R066APU SET DIAALT = 6
        WHERE NUMEMP = :NEW.NUMEMP AND
              TIPCOL = :NEW.TIPCOL AND
              NUMCAD = :NEW.NUMCAD AND
              DATAPU >= :NEW.DATASA AND
              DATAPU <= l_datfim;
      EXCEPTION WHEN OTHERS THEN
        NULL;
      END;
  END IF;
END␀ŒØ␀␀	SENIOR;0Ã␀␀

TRIGGER R064ASA_SD AFTER DELETE ON R064ASA

DECLARE
/* CURSOR c/ os registros gravados no R064ASA_AUXl */
  CURSOR c_r064asa_del IS SELECT NUMEMP,TIPCOL,NUMCAD,DATASA FROM R064ASA_AUX;
  TYPE t_r064asa_aux IS RECORD(
    NUMEMP   R064ASA_AUX.NUMEMP%TYPE,
    TIPCOL   R064ASA_AUX.TIPCOL%TYPE,
    NUMCAD   R064ASA_AUX.NUMCAD%TYPE,
    DATASA   R064ASA_AUX.DATASA%TYPE);
  l_r064asa_aux t_r064asa_aux;

BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r064asa_del INTO  l_r064asa_aux.NUMEMP,
                              l_r064asa_aux.TIPCOL,
                              l_r064asa_aux.NUMCAD,
                              l_r064asa_aux.DATASA
  LOOP
    SP_HisAsa (l_r064asa_aux.NUMEMP, l_r064asa_aux.TIPCOL, l_r064asa_aux.NUMCAD, '',l_r064asa_aux.DATASA);
  END LOOP;
 /* Apaga Registro OLD em R064ASA_AUX */
  BEGIN
    DELETE FROM R064ASA_AUX;
    DROP_TEMP_TABLE R064ASA_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀‰Ø␀␀		SENIOR;0µ␀␀

TRIGGER R064ASA_ED AFTER DELETE ON R064ASA FOR EACH ROW

DECLARE
  l_online       BOOLEAN;
  l_datfim       DATE;

  /* Tabela temporária */
  CREATE_TEMP_TABLE R064ASA_AUX;
  
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
      BEGIN
         INSERT INTO R064ASA_AUX (NUMEMP,TIPCOL,NUMCAD,DATASA)
         VALUES (:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.DATASA);
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no INSERT em R064ASA_AUX.';
      END;
  END IF;

  l_datfim := :OLD.DATASA;
  IF   (:OLD.HORTER < :OLD.HORASA) THEN
       l_datfim := DATETIMEADD (DD, +1, l_datfim);
  END IF;

  BEGIN
  UPDATE R066APU SET DIAALT = 6
         WHERE NUMEMP = :OLD.NUMEMP AND
               TIPCOL = :OLD.TIPCOL AND
               NUMCAD = :OLD.NUMCAD AND
               DATAPU >= :OLD.DATASA AND
               DATAPU <= l_datfim;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀␀␀Ç␀␀␀␀␀␀␀␀␀␀␀␀␀ˆØ␀␀…¬␀␀´␀„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t„␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀„␀␀␀␀␀␀$0.0.w␀Æÿ␀␀ÿ␀zDÑ␀„␀␀␀␀␀␀YI)F*FqC␀êÿ␀␀ÿ␀[w·␀„␀␀␀␀␀␀yxxì*␀␀Æÿ␀␀ÿ␀ïw·␀„␀␀␀␀␀␀ïyßxßxì*␀␀Æÿ␀␀ÿ␀•-±␀„␀␀␀␀␀␀ü␀Ÿ␀Ÿ␀q␀Æÿ␀␀ÿ␀Ìa´␀„␀␀␀␀␀␀­<•awbr␀Æÿ␀␀ÿ␀=␀t„␀␀␀␀␀␀l␀§␀§␀n␀Æÿ␀␀ÿ␀:$Ì␀„␀␀␀␀␀␀%$†$w␀Æÿ␀␀ÿ␀␀Ã„␀␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀␀␀	␀È␀	␀␀␀␀␀␀␀␀␀␀␀Ø␀␀…¬␀␀´␀	„␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	„␀␀␀␀␀␀␀Ü␀t␀Ü␀nˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	„␀␀␀␀␀␀␀.%0.0.wˆ␀Æÿ␀␀…Ó␀␀␀EÑ␀	„␀␀␀␀␀␀␀|G]G]GqCˆ␀êÿ␀␀ÿ␀¤w·␀„␀␀␀␀␀␀␀uxdxdxì*␀␀Æÿ␀␀ÿ␀åDÑ␀„␀␀␀␀␀␀␀GÔFÔFqC␀êÿ␀␀ÿ␀w·␀„␀␀␀␀␀␀␀Lx<x<xì*␀␀Æÿ␀␀ÿ␀:,„␀␀␀␀␀␀␀AÓ«␀␀Ù«␀␀b␀ˆ␀␀ÿ␀␀)`␀␀␀␀0;1;2;3␀␀š␀␀␀␀␀␀␀␀␀Ø␀␀…¬␀␀´␀	„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	„␀␀␀␀␀␀Ü␀t␀Ü␀n-‰␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	„␀␀␀␀␀␀.%0.0.w$‰␀Æÿ␀␀…Ó␀␀␀EÑ␀	„␀␀␀␀␀␀iG]G]GqC&‰␀êÿ␀␀ÿ␀(␀q	„␀␀␀␀␀␀¯␀t␀t␀n.‰␀Æÿ␀␀ÿ␀½␀␀U	„␀␀␀␀␀␀Á␀␀áÀ␀␀áÀ␀␀n*‰␀Æÿ␀␀ÿ␀åDÑ␀„␀␀␀␀␀␀ÛFÔFÔFqC%‰␀êÿ␀␀ÿ␀ş␀␀·␀„␀␀␀␀␀␀®”␀␀­”␀␀®”␀␀ì*␀)‰␀Æÿ␀␀ÿ␀o·␀„␀␀␀␀␀␀—n–n—nì*␀'‰␀Æÿ␀␀ÿ␀Ê␀␀·␀„␀␀␀␀␀␀Ë␀␀GË␀␀Ë␀␀ì*␀+‰␀Æÿ␀␀ÿ␀•-±␀„␀␀␀␀␀␀û=Ÿ␀Ÿ␀q,‰␀Æÿ␀␀¨Ï␀␀␀Ä¢␀␀±␀„␀␀␀␀␀␀7£␀␀Î¢␀␀7£␀␀q␀Æÿ␀␀˜Ï␀␀␀¸,´␀„␀␀␀␀␀␀Ÿ@ìzìzr(‰␀Æÿ␀␀fÎ␀␀␀␀Ã„␀␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3;4;5–Ø␀␀	SENIOR;0U␀␀

TRIGGER R064CMP_SI AFTER INSERT ON R064CMP

DECLARE
/* CURSOR c/ os registros gravados no R064CMP_AUX */
  CURSOR c_r064cmp_ins IS SELECT NUMEMP,TIPCOL,NUMCAD FROM R064CMP_AUX;
  TYPE t_r064cmp_aux IS RECORD(
    NUMEMP   R064CMP_AUX.NUMEMP%TYPE,
    TIPCOL   R064CMP_AUX.TIPCOL%TYPE,
    NUMCAD   R064CMP_AUX.NUMCAD%TYPE);
  l_r064cmp_aux t_r064cmp_aux;

BEGIN
   /* Le Registro do CURSOR */
   FOREACH c_r064cmp_ins INTO  l_r064cmp_aux.NUMEMP,
                               l_r064cmp_aux.TIPCOL,
                               l_r064cmp_aux.NUMCAD
   LOOP
     R064EXT_FH(l_r064cmp_aux.NUMEMP, l_r064cmp_aux.TIPCOL, l_r064cmp_aux.NUMCAD);
   END LOOP;
   /* Apaga Registro OLD em R064CMP_AUX */
   BEGIN
     DELETE FROM R064CMP_AUX;
     DROP_TEMP_TABLE R064CMP_AUX;
   EXCEPTION WHEN OTHERS THEN
     NULL;
   END;
END␀“Ø␀␀		SENIOR;0Z␀␀TRIGGER R064CMP_EI AFTER INSERT ON R064CMP FOR EACH ROW

DECLARE
   l_strerr     VARCHAR2(255);
   l_DataZero   DATE;
   l_data_fim   DATE;
   l_online     BOOLEAN;
   l_datatu     DATE;
   
   /* Tabela temporária */
   CREATE_TEMP_TABLE R064CMP_AUX;
   
BEGIN
   l_datatu := CURDATE();
   IF :NEW.TIPCMP = 1 THEN
      IF (:NEW.PERCMP <> 1) AND (:NEW.PERCMP <> 2) AND
         (:NEW.PERCMP <> 3) AND (:NEW.PERCMP <> 4) AND
         (:NEW.PERCMP <> 5) AND (:NEW.PERCMP <> 6) AND
         (:NEW.PERCMP <> 7) THEN
         l_strerr := 'Perído da Compensação não permitido para o Tipo: ' ||
                     CONVERT(NUMBER_TO_CHAR,:NEW.TIPCMP) || ' Período: ' ||
                     CONVERT(NUMBER_TO_CHAR,:NEW.PERCMP) || ' Período: ' ||
                     ' tipcol = '||CONVERT(NUMBER_TO_CHAR,:NEW.TIPCOL) ||
                     ' numemp = '||CONVERT(NUMBER_TO_CHAR,:NEW.NUMEMP) ||
                     ' numcad = '||CONVERT(NUMBER_TO_CHAR,:NEW.NUMCAD);
         RAISERROR 103 l_strerr;
      END IF;
   END IF;

   IF :NEW.TIPCMP = 2 THEN
      IF (:NEW.PERCMP <> 1) AND (:NEW.PERCMP <> 2) AND
         (:NEW.PERCMP <> 3) AND (:NEW.PERCMP <> 4) AND
         (:NEW.PERCMP <> 5) THEN
         l_strerr := 'Perído da Compensação não permitido para o Tipo: ' ||
                     CONVERT(NUMBER_TO_CHAR,:NEW.TIPCMP) || ' Período: ' ||
                     CONVERT(NUMBER_TO_CHAR,:NEW.PERCMP) || ' Período: ' ||
                     ' tipcol = '||CONVERT(NUMBER_TO_CHAR,:NEW.TIPCOL) ||
                     ' numemp = '||CONVERT(NUMBER_TO_CHAR,:NEW.NUMEMP) ||
                     ' numcad = '||CONVERT(NUMBER_TO_CHAR,:NEW.NUMCAD);
         RAISERROR 103 l_strerr;
      END IF;
   END IF;

   IF :NEW.TIPCMP = 4 THEN
      IF (:NEW.PERCMP <> 8) AND (:NEW.PERCMP <> 9) THEN
         l_strerr := 'Perído da Compensação não permitido para o Tipo: ' ||
                     CONVERT(NUMBER_TO_CHAR,:NEW.TIPCMP) || ' Período: ' ||
                     CONVERT(NUMBER_TO_CHAR,:NEW.PERCMP) || ' Período: ' ||
                     ' tipcol = '||CONVERT(NUMBER_TO_CHAR,:NEW.TIPCOL) ||
                     ' numemp = '||CONVERT(NUMBER_TO_CHAR,:NEW.NUMEMP) ||
                     ' numcad = '||CONVERT(NUMBER_TO_CHAR,:NEW.NUMCAD);
         RAISERROR 103 l_strerr;
      END IF;
   END IF;

   l_DataZero := '31/12/1900,00:00:00';
   l_data_fim := :NEW.DATFIM;
   IF   (l_data_fim = l_DataZero) THEN
        l_data_fim := '04/06/2080,00:00:00';
   END IF;

   /* ACESSO atualiza as faixas de acesso e ponto */
   IF  (DATETIMEADD(DD,-6,:NEW.DATINI) <= l_datatu)
   AND (:NEW.DATFIM >= l_datatu) THEN
        SP_VerOnLine(l_online OUT);
        IF   (l_online = TRUE) THEN
             BEGIN
             /* salva Registro  */
             INSERT INTO R064CMP_AUX (NUMEMP,TIPCOL,NUMCAD,DATINI)
                           VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI);
             EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro no INSERT em R064CMP_AUX.';
             END;
        END IF;
   END IF;

   BEGIN
     UPDATE R066APU SET DIAALT = 4
            WHERE NUMEMP = :NEW.NUMEMP AND
                  TIPCOL = :NEW.TIPCOL AND
                  NUMCAD = :NEW.NUMCAD AND
                  DATAPU >= :NEW.DATINI AND
                  DATAPU <= l_data_fim;
   EXCEPTION WHEN OTHERS THEN
     NULL;
   END;
END␀—Ø␀␀	SENIOR;0U␀␀

TRIGGER R064CMP_SU AFTER UPDATE ON R064CMP

DECLARE
/* CURSOR c/ os registros gravados no R064CMP_AUX */
  CURSOR c_r064cmp_upd IS SELECT NUMEMP,TIPCOL,NUMCAD FROM R064CMP_AUX;
  TYPE t_r064cmp_aux IS RECORD(
