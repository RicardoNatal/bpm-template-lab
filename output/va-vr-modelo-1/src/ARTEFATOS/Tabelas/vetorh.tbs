!␀␀CREATE PROCEDURE SP_CONCAT_FLO_JSON
(
	@p_Campo VARCHAR(6),
	@p_Valor_New FLOAT,
	@p_Valor_Old FLOAT,
	@p_Decim INTEGER,
	@p_Retorno VARCHAR(2000) OUTPUT
) AS
BEGIN
DECLARE @l_ValorVarchar_New VARCHAR(2000)
DECLARE @l_ValorVarchar_Old VARCHAR(2000)
DECLARE @ChkError INTEGER
SELECT @ChkError = 0  
  IF (@p_Decim IS NULL)
  BEGIN
	SET @p_Decim = 0;
  END
    
  SELECT @l_ValorVarchar_New = REPLACE(LTRIM(STR(@p_Valor_New, 500, @p_Decim)), '.', ',')
  SELECT @l_ValorVarchar_Old = REPLACE(LTRIM(STR(@p_Valor_Old, 500, @p_Decim)), '.', ',')

  EXECUTE  @ChkError = SP_CONCAT_DES_JSON @p_Campo, @l_ValorVarchar_New, @l_ValorVarchar_Old, @p_Retorno OUTPUT    
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  BEGIN
    RETURN @ChkError
  END
FIM:
  RETURN @ChkError
END

	POSTGRESQL;0
␀␀␀CREATE OR REPLACE PROCEDURE SP_CONCAT_FLO_JSON(p_Campo VARCHAR, p_Valor_New numeric, p_Valor_Old numeric, p_Decim INTEGER, p_Retorno IN OUT VARCHAR)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
    l_Valor_New VARCHAR(2000);
    l_Valor_Old VARCHAR(2000);
    l_Mascara_new VARCHAR(30);
	l_Mascara_old VARCHAR(30);    
    l_Valor_new_numeric numeric;
    l_Valor_old_numeric numeric;
    l_Tamanho_new integer;		 
	l_Tamanho_old integer;
BEGIN
  -- Tratamento do novo valor
  l_Valor_new_numeric := TRUNC(p_Valor_New, p_Decim);
  -- Monta máscara do novo valor
  select (l_valor_new_numeric::numeric)::text into l_Valor_new;
  select LENGTH(l_Valor_new) into l_Tamanho_new;
  l_Tamanho_new := l_Tamanho_new + p_Decim;
  
  select LPAD('9', l_Tamanho_new, '9') into l_Mascara_new;
  --Aplica Máscara
  select SUBSTRING(l_Mascara_new, 1, l_Tamanho_new - p_decim) || 'D' || SUBSTRING(l_Mascara_new, l_Tamanho_new - (p_decim - 1)  , p_decim) into l_Mascara_new;
  SELECT REPLACE(TRIM(TO_CHAR(l_Valor_New_numeric, l_Mascara_new)), '.', ',') INTO l_Valor_New;
  IF (l_Valor_New <> '0') AND (TRUNC(l_Valor_New_numeric,0) = 0) THEN
    l_Valor_New := '0' || l_Valor_New;
  END IF;
  
  -- Tratamento do valor anterior
  l_Valor_old_numeric := TRUNC(p_Valor_Old, p_Decim);
  -- Monta máscara do valor anterior
  select (l_valor_old_numeric::numeric)::text into l_Valor_old;
  select LENGTH(l_Valor_old) into l_Tamanho_old;  
  l_Tamanho_old := l_Tamanho_old + p_Decim;
  select LPAD('9', l_Tamanho_old, '9') into l_Mascara_old;
  --Aplica Máscara
  select SUBSTRING(l_Mascara_old, 1, l_Tamanho_old - p_decim) || 'D' ||  SUBSTRING(l_Mascara_old, l_Tamanho_old - (p_decim - 1), p_decim) into l_Mascara_old;
  SELECT REPLACE(TRIM(TO_CHAR(l_Valor_Old_numeric, l_Mascara_old)), '.', ',')
  INTO l_Valor_Old;
  IF (l_Valor_Old <> '0') AND (TRUNC(l_Valor_Old_numeric,0) = 0) THEN
    l_Valor_Old := '0' || l_Valor_Old;
  END IF;
    
  call SP_CONCAT_DES_JSON(p_Campo,l_Valor_New,l_Valor_Old,p_Retorno);
  RETURN;
END;
$BODY$␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_CONCAT_DES_JSON
®␀␀PROCEDURE SP_CONCAT_NUM_JSON(P_CAMPO VARCHAR2(6),P_VALOR_NEW NUMBER, P_VALOR_OLD NUMBER, P_RETORNO IN OUT VARCHAR2(2000))
 IS

  l_ValorVARCHAR_NEW VARCHAR2(2000);
  l_ValorVARCHAR_OLD VARCHAR2(2000);
BEGIN
  l_ValorVARCHAR_NEW := CONVERT(NUMBER_TO_CHAR, P_VALOR_NEW);
  l_ValorVARCHAR_OLD := CONVERT(NUMBER_TO_CHAR, P_VALOR_OLD);
  SP_CONCAT_DES_JSON(p_Campo, l_ValorVARCHAR_NEW, l_ValorVARCHAR_OLD, p_Retorno OUT);
  RETURN;
END	MSSQL;0
›␀␀CREATE PROCEDURE SP_CONCAT_NUM_JSON
(
	@p_Campo VARCHAR(6), 
	@p_Valor_New NUMERIC,
	@p_Valor_Old NUMERIC, 
	@p_Retorno VARCHAR(2000) OUTPUT
) AS
BEGIN
  DECLARE @l_valorVarchar_New VARCHAR(2000)
  DECLARE @l_valorVarchar_Old VARCHAR(2000)
  DECLARE @ChkError INTEGER 
  
  SELECT @l_valorVarchar_New = CONVERT(VARCHAR,@p_Valor_New)
  SELECT @l_valorVarchar_Old = CONVERT(VARCHAR,@p_Valor_Old)
  SELECT @ChkError = 0
  EXECUTE  @ChkError = SP_CONCAT_DES_JSON @p_Campo, @l_valorVarchar_New, @l_valorVarchar_Old, @p_Retorno OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  BEGIN
    RETURN @ChkError
  END
FIM:
  RETURN @ChkError
END
