TRIGGER R304COE_SI AFTER INSERT ON R304COE
DECLARE
	CURSOR c_R304COE IS
	SELECT NUMEMP, NUMEDI, NUMESP, TIPQUA, CARFUN, DATINI, SEQREG
	  FROM R304COE
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304COE IS RECORD (
		NUMEMP   R304COE.NumEmp%TYPE,
		NUMEDI   R304COE.NumEdi%TYPE,
		NUMESP   R304COE.NumEsp%TYPE,
		TIPQUA   R304COE.TipQua%TYPE,
		CARFUN   R304COE.CarFun%TYPE,
		DATINI   R304COE.DatIni%TYPE,
		SEQREG   R304COE.SeqReg%TYPE
	);
    
    l_R304COE t_R304COE;
    l_PidSta VARCHAR2(30);
    l_MsgErr VARCHAR2(255);
BEGIN
	FOREACH c_R304COE INTO l_R304COE.NumEmp, l_R304COE.NumEdi, l_R304COE.NumEsp, l_R304COE.TipQua, l_R304COE.CarFun, l_R304COE.DatIni, l_R304COE.SeqReg
	LOOP
		/* Busca PID gravado no registro do Concurso/Processo Seletivo */
		BEGIN
			SELECT CON.PIDSTA INTO l_PidSta
			  FROM R304CON CON, R304STA STA
			 WHERE CON.PIDSTA = STA.PIDSTA
			   AND CON.NUMEMP = l_R304COE.NumEmp
			   AND CON.NUMEDI = l_R304COE.NumEdi
			   AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_MsgErr := 'Não existe registro de Concursos/Processos Seletivos pendente com as seguintes chaves: ' ||
					'Empresa: ' || CONVERT(NUMBER_TO_CHAR, l_R304COE.NumEmp) || ', Edital: ' || l_R304COE.NumEdi || '.';
				RAISERROR 103 l_MsgErr;
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304CON.';
		END;
		
		BEGIN
			UPDATE R304COE
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304COE.NumEmp
			   AND NUMEDI = l_R304COE.NumEdi
			   AND NUMESP = l_R304COE.NumEsp
			   AND TIPQUA = l_R304COE.TipQua
			   AND CARFUN = l_R304COE.CarFun
			   AND DATINI = l_R304COE.DatIni
			   AND SEQREG = l_R304COE.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304COE.';
		END;
	END LOOP;
END␀kå␀␀		SENIOR;0é␀␀TRIGGER R304COE_EI BEFORE INSERT ON R304COE FOR EACH ROW
DECLARE
	l_SeqReg   R304COE.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Verifica se está tentando incluir um registro com sequência maior do que a última já cadastrada */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304COE
		 WHERE NUMEMP = :NEW.NumEmp
		   AND NUMEDI = :NEW.NumEdi
		   AND NUMESP = :NEW.NumEsp
		   AND TIPQUA = :NEW.TipQua
		   AND CARFUN = :NEW.CarFun
		   AND DATINI = :NEW.DatIni
		   AND SEQREG <> :NEW.SeqReg;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304COE.';
	END;
	
	IF (l_SeqReg > 0) THEN
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀lå␀␀		SENIOR;0ª␀␀

