 PROCEDURE SP_AUDVER(P_VERAUD OUT VARCHAR2(1),P_NOMTAB VARCHAR2(7))
 IS

l_veraud       CHAR(1);
BEGIN
  l_veraud := 'N';
   
  BEGIN
      SELECT MARCAR INTO l_veraud FROM R151AUD WHERE TABELA = p_nomtab;
  EXCEPTION
      WHEN OTHERS THEN l_veraud := 'N';
  END;
  p_veraud := l_veraud;
END		SENIOR;21
