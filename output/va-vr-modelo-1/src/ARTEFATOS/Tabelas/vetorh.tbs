TRIGGER R347BEI_EU AFTER UPDATE ON R347BEI FOR EACH ROW DECLARE
	l_Valor VARCHAR2(2000);
	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_AlterouChave BOOLEAN;
	l_Incluir BOOLEAN;
	l_Excluir BOOLEAN;
	l_InfoFacult BOOLEAN;
	l_SimplificaoESocial BOOLEAN;
	l_VersaoESocial NUMBER;
BEGIN
	l_Valor := '';
	l_Valido := FALSE;
	l_Alterou := FALSE;
	l_AlterouChave := FALSE;
	l_Incluir := FALSE;
    l_Excluir := FALSE;	
	l_InfoFacult := TRUE;
	l_SimplificaoESocial := FALSE;
	
	SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);

	IF (l_SimplificaoESocial = TRUE) THEN
	
		SP_VALUPDATE_DAT(:OLD.DatIni, :NEW.DatIni, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;	
		  
		SP_VALUPDATE_NUM(:OLD.SitBen, :NEW.SitBen, l_Valido OUT);
