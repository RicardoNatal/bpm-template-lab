PROCEDURE SP_CRACOL(P_NUMPIS NUMBER(12),P_DATACC DATE,P_HORACC NUMBER(4),P_CRACHA OUT NUMBER(12))
 IS

l_datzer  DATE;
  l_NumCra  NUMBER(12);
  l_CraFis  NUMBER(12);
  l_tipfer  VARCHAR2(5);

  CURSOR c_BuscaCracha IS
  SELECT A.NUMCRA
  FROM R038HCH A, R034FUN B
  WHERE B.NUMPIS = p_numpis
  AND A.TIPCOL = 1
  AND A.NUMEMP = B.NUMEMP AND A.TIPCOL = B.TIPCOL AND A.NUMCAD = B.NUMCAD
  AND(A.DATINI < p_datacc OR (A.DATINI = p_datacc AND A.HORINI <= p_horacc))
  AND(A.DATFIM = l_datzer OR A.DATFIM > p_datacc OR (A.DATFIM = p_datacc AND A.HORFIM >= p_horacc))
  AND(A.TIPCRA = (SELECT MAX(D.TIPCRA) FROM R038HCH D WHERE A.NUMEMP = D.NUMEMP AND A.TIPCOL = D.TIPCOL AND A.NUMCAD = D.NUMCAD
  AND(D.DATINI < p_datacc OR (D.DATINI = p_datacc AND D.HORINI <= p_horacc))
  AND(D.DATFIM = l_datzer OR D.DATFIM > p_datacc OR (D.DATFIM = p_datacc AND D.HORFIM >= p_horacc)) ));

  TYPE t_BuscaCracha IS RECORD(
      NUMCRA   R038HCH.NUMCRA%TYPE);

  l_BuscaCracha      t_BuscaCracha;
BEGIN
    /* Inicializa */
    l_datzer := '31/12/1900,00:00:00';
    l_NumCra := 0;

    FOREACH c_BuscaCracha INTO l_BuscaCracha.NUMCRA
    LOOP
        l_NumCra := l_BuscaCracha.NUMCRA;
        IF (l_NumCra <> 0) THEN
            EXIT;
        END IF;
    END LOOP;

    /* Busca Número Fisico do Crachá se Existir */
    p_cracha := l_NumCra;
    BEGIN
        IF l_NumCra <> 0 THEN
            SP_RETFIS(l_NumCra , 0, l_CraFis OUT);
            p_cracha := l_CraFis;
        END IF;
    EXCEPTION
        WHEN OTHERS THEN p_cracha := 0;
    END;
END		SENIOR;23SP_RETFIS
2␀␀


PROCEDURE SP_CRACOL(P_NUMPIS NUMBER(12),P_DATACC DATE,P_HORACC NUMBER(4),P_CRACHA OUT NUMBER(12))
 IS

l_datzer  DATE;
  l_NumCra  NUMBER(12);
  l_CraFis  NUMBER(12);
  l_tipfer  VARCHAR2(5);

  CURSOR c_BuscaCracha IS
  SELECT A.NUMCRA
  FROM R038HCH A, R034FUN B
  WHERE B.NUMPIS = p_numpis
  AND A.TIPCOL = 1
  AND A.NUMEMP = B.NUMEMP AND A.TIPCOL = B.TIPCOL AND A.NUMCAD = B.NUMCAD
  AND(A.DATINI < p_datacc OR (A.DATINI = p_datacc AND A.HORINI <= p_horacc))
  AND(A.DATFIM = l_datzer OR A.DATFIM > p_datacc OR (A.DATFIM = p_datacc AND A.HORFIM >= p_horacc))
  AND(A.TIPCRA = (SELECT MAX(D.TIPCRA) FROM R038HCH D WHERE A.NUMEMP = D.NUMEMP AND A.TIPCOL = D.TIPCOL AND A.NUMCAD = D.NUMCAD
  AND(D.DATINI < p_datacc OR (D.DATINI = p_datacc AND D.HORINI <= p_horacc))
  AND(D.DATFIM = l_datzer OR D.DATFIM > p_datacc OR (D.DATFIM = p_datacc AND D.HORFIM >= p_horacc)) ));

  TYPE t_BuscaCracha IS RECORD(
      NUMCRA   R038HCH.NUMCRA%TYPE);

  l_BuscaCracha      t_BuscaCracha;
BEGIN
    /* Inicializa */
    l_datzer := '31/12/1900,00:00:00';
    l_NumCra := 0;

    FOREACH c_BuscaCracha INTO l_BuscaCracha.NUMCRA
    LOOP
        l_NumCra := l_BuscaCracha.NUMCRA;
        IF (l_NumCra <> 0) THEN
            EXIT;
        END IF;
    END LOOP;

    /* Busca Número Fisico do Crachá se Existir */
    p_cracha := l_NumCra;
    BEGIN
        IF l_NumCra <> 0 THEN
            SP_RETFIS(l_NumCra , 0, l_CraFis OUT);
            p_cracha := l_CraFis;
        END IF;
    EXCEPTION
        WHEN OTHERS THEN p_cracha := 0;
    END;
END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
