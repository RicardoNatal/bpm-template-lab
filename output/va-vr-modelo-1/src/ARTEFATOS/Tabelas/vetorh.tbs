        SP_DATSTR(:OLD.FIMQUA, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFIMQUA', l_datTemp);
		SP_DATSTR(:NEW.FIMQUA, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFIMQUA', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODRMD', CONVERT(NUMBER_TO_CHAR, :OLD.CODRMD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODRMD', CONVERT(NUMBER_TO_CHAR, :NEW.CODRMD));
        SP_DATSTR(:OLD.DATAVI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATAVI', l_datTemp);
        SP_DATSTR(:NEW.DATAVI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATAVI', l_datTemp);
        SP_DATSTR(:OLD.FINAVI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFINAVI', l_datTemp);
        SP_DATSTR(:NEW.FINAVI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFINAVI', l_datTemp);
        SP_DATSTR(:OLD.DATPAG, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATPAG', l_datTemp);
        SP_DATSTR(:NEW.DATPAG, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATPAG', l_datTemp);
        SP_DATSTR(:OLD.FIMCTT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFIMCTT', l_datTemp);
        SP_DATSTR(:NEW.FIMCTT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFIMCTT', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQTDIND', CONVERT(NUMBER_TO_CHAR, :OLD.QTDIND));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQTDIND', CONVERT(NUMBER_TO_CHAR, :NEW.QTDIND));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQTDREA', CONVERT(NUMBER_TO_CHAR, :OLD.QTDREA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQTDREA', CONVERT(NUMBER_TO_CHAR, :NEW.QTDREA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQTDSSL', CONVERT(NUMBER_TO_CHAR, :OLD.QTDSSL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQTDSSL', CONVERT(NUMBER_TO_CHAR, :NEW.QTDSSL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQTDGRA', CONVERT(NUMBER_TO_CHAR, :OLD.QTDGRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQTDGRA', CONVERT(NUMBER_TO_CHAR, :NEW.QTDGRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQTDEST', CONVERT(NUMBER_TO_CHAR, :OLD.QTDEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQTDEST', CONVERT(NUMBER_TO_CHAR, :NEW.QTDEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERIND', CONVERT(NUMBER_TO_CHAR, :OLD.PERIND));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERIND', CONVERT(NUMBER_TO_CHAR, :NEW.PERIND));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQTDFCA', CONVERT(NUMBER_TO_CHAR, :OLD.QTDFCA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQTDFCA', CONVERT(NUMBER_TO_CHAR, :NEW.QTDFCA));
        SP_DATSTR(:OLD.DATCTB, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATCTB', l_datTemp);
        SP_DATSTR(:NEW.DATCTB, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATCTB', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSALFAV', CONVERT(NUMBER_TO_CHAR, :OLD.SALFAV));
