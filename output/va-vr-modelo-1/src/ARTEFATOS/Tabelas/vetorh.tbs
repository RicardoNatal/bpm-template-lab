																				 (l_r038HPO.NUMEMP, l_r038HPO.TIPCOL, l_r038HPO.NUMCAD, l_r038HPO.INIATU, 0, :NEW.CODPRM, l_r038HPO.TERATU, 1439, :NEW.CODUSU, :NEW.OBSPRM);
