  l_numcad       CHAR(10);

BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  /* retira caracteres especiais da mensagem */
  SP_STRTOSTR(p_msgacc, l_msgacc OUT);

  /* Para TBS tipo 15 e 18, o crachá atualizado sempre deve ser o crachá titular */
  /* Mesmo que ele tenha um provisório, este estará associado a um titular.      */
  /* Se houver somente o provisório e não o titular, então atualiza o provisório.*/
  SP_RetCra (1,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
  IF   l_cracha = 0 THEN
       SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
  END IF;
  SP_RetCra (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_crapro OUT);

  /* Verifica se Colaborador possui Cracha */
  IF   (l_cracha <> 0) THEN
       /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
       SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
       IF (l_crapri = 0) THEN
           l_crapri := l_cracha;
       END IF;
       l_comando_nulo := FALSE;
       BEGIN
          SELECT NUMFIS INTO l_craaux FROM R070CON WHERE NUMFIS = l_crapri;
       EXCEPTION
          WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUFIS: Erro em R070CON - TOO MANY ROWS.=';
          WHEN NO_DATA_FOUND THEN l_comando_nulo:= TRUE;
          WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro No SELECT R070CON';
       END;

       IF  (l_comando_nulo = FALSE) THEN

           IF   p_tipope = 'D' THEN
                l_datmsg := '      ';
                l_datstr := '0000000000000000';
                l_msgacc := '                                ';
                l_qtdmsg := '00';
                l_qtde   := 0;
           ELSE
                /* se for updade verificar se esta fechando o historico */
                IF  (p_tipope = 'U') AND
                    (p_datfim <> l_data_zero) AND
                    ((p_datfim < l_data_atual) OR
                    ((p_datfim = l_data_atual) AND (p_horfim < l_hora_atual))) THEN
                     l_datmsg := '      ';
                     l_datstr := '0000000000000000';
                     l_qtdmsg := '00';
                     l_qtde   := 0;
                ELSE
                     l_qtde := p_qtdmsg;
                     IF   (NOT(p_msgacc IS NULL)) THEN
                         IF (p_datfim = l_data_zero) THEN
                             l_dataux := '311250';
                             l_horstr := '2359';
                         ELSE
                             SP_DATSTR(p_datfim,'DDMMYY',l_dataux OUT);
                             SP_INTSTR(p_horfim,'HHMM',l_horstr OUT);
                         END IF;
                             l_datstr := l_dataux||l_horstr||'000000';
                     ELSE
                         l_datstr := '0000000000000000';
                         l_qtde   := 0;
                     END IF;
                END IF;
           END IF;
           /*LOOPing para incluir a msg para crachá provisório se existir.*/
           LOOP
               /* atualiza r070con */
               BEGIN
                    UPDATE R070CON SET MSGACC = l_msgacc, DATMSG = l_datstr, QTDMSG = l_qtde, MSGATU = l_qtde WHERE NUMFIS = l_crapri;
               EXCEPTION
                    WHEN OTHERS THEN NULL;
               END;
               /*Controle do Looping que atuliza se existir crachá provisório para Colaboradores.*/
               IF (l_crapro = l_cracha) OR (l_crapro = 0) THEN
                   EXIT;
               ELSE
                   l_cracha := l_crapro;
                   /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
                   SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                   IF (l_crapri = 0) THEN
                       l_crapri := l_cracha;
                   END IF;
               END IF;
           END LOOP;
           /*Obtem o Tipo de Pessoa*/
           SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
           SP_INTSTR(p_numemp,'9999',l_numemp OUT);
           SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
           SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
           l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
           /*Preenche o campo com espaços para completar 23 posições*/
           l_idtpes := lTrim(l_idtpes);
           l_idtpes := rTrim(l_idtpes);
           LOOP
               /*Controle do Loop.*/
               IF (Length(l_idtpes) > 22) THEN
                   EXIT;
               END IF;
               l_idtpes := ' '||l_idtpes;
           END LOOP;
           /*Atualiza a Controle/FxHoraria*/
           SP_ATUTSI(l_idtpes, l_crapri, FALSE, TRUE, FALSE, FALSE);
       END IF;
  END IF;
END		SENIOR;21DSP_STRTOSTR
