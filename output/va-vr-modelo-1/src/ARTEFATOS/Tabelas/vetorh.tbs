BEGIN
  IF (
  :OLD.TIPATN <>:NEW.TIPATN OR
  :OLD.TIPCOL <>:NEW.TIPCOL OR
  :OLD.NUMCAD <>:NEW.NUMCAD OR
  :OLD.NUMCAN <>:NEW.NUMCAN OR
  :OLD.CODDEP <>:NEW.CODDEP
  ) THEN
    l_codSistema:= 1;
    l_codcpa:= 136;  /* Código da categoria de auditoria - Histórico da Ficha Médica*/
    l_codtpa:= 404;  /* Código do tipo de auditoria - Alteração*/

    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

