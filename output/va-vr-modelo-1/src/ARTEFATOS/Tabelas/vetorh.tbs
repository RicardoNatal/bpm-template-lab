TRIGGER R124HCR_SI AFTER INSERT ON R124HCR

DECLARE
/* SINCRONIZAÇÃO DO NOME DO CURSO E DA ENTIDADE DE ENSINO COM O CADASTRO DO CURSO E DA ENTIDADE */
  /* CURSOR para buscar os registros que foram inseridos na tabela R124HCR_AUX3 na trigger EI */
  /* CURSOR na tabela R124HCR_AUX3, o nome do CURSOR foi abreviado devido limitação no informix */
  /* de 18 caracteres para nome de identificadores, foi colocado 14 caracteres no máximo pois a svcl adiciona mais 3 caracteres ao final */
  CURSOR C_124HCR_I_AX3 IS
  SELECT NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, NOMOEM, NOMCUA, TIPOPE, SEQCAP
    FROM R124HCR_AUX3
   WHERE TIPOPE = 'I';

  /* SINCRONIZAÇÃO DO NOME DO CURSO E DA ENTIDADE DE ENSINO COM O CADASTRO DO CURSO E DA ENTIDADE */
  /* RECORD com os campos da tabela R124HCR_AUX3 */
  TYPE t_R124HCR_aux3 IS RECORD(
    NUMEMP   R124HCR_AUX3.NUMEMP%TYPE,
    TIPCOL   R124HCR_AUX3.TIPCOL%TYPE,
    NUMCAD   R124HCR_AUX3.NUMCAD%TYPE,
    CODCUA   R124HCR_AUX3.CODCUA%TYPE,
    SEQHCR   R124HCR_AUX3.SEQHCR%TYPE,
    NOMOEM   R124HCR_AUX3.NOMOEM%TYPE,
    NOMCUA   R124HCR_AUX3.NOMCUA%TYPE,
    TIPOPE   R124HCR_AUX3.TIPOPE%TYPE,
    SEQCAP   R124HCR_AUX3.SEQCAP%TYPE);

  /* SINCRONIZAÇÃO DO NOME DO CURSO E DA ENTIDADE DE ENSINO COM O CADASTRO DO CURSO E DA ENTIDADE */
  l_R124HCR_aux3 t_R124HCR_aux3;

  CURSOR C_R124HCR_INS IS SELECT NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, PERINI, INDVCT, SITCUA
                            FROM R124HCR_AUX WHERE TIPOPE = 'I';

  TYPE t_r124HCR_aux IS RECORD(
      NUMEMP   R124HCR_AUX.NUMEMP%TYPE,
      TIPCOL   R124HCR_AUX.TIPCOL%TYPE,
      NUMCAD   R124HCR_AUX.NUMCAD%TYPE,
      CODCUA   R124HCR_AUX.CODCUA%TYPE,
      SEQHCR   R124HCR_AUX.SEQHCR%TYPE,
      PERINI   R124HCR_AUX.PERINI%TYPE,
      INDVCT   R124HCR_AUX.INDVCT%TYPE,
      SITCUA   R124HCR_AUX.SITCUA%TYPE);

  l_r124HCR_aux t_r124HCR_aux;

  l_isInformix  BOOLEAN;
BEGIN
  FOREACH C_R124HCR_INS INTO l_r124HCR_aux.NUMEMP,
                             l_r124HCR_aux.TIPCOL,
                             l_r124HCR_aux.NUMCAD,
                             l_r124HCR_aux.CODCUA,
                             l_r124HCR_aux.SEQHCR,
                             l_r124HCR_aux.PERINI,
                             l_r124HCR_aux.INDVCT,
                             l_r124HCR_aux.SITCUA
  LOOP
    /* Atualiza Turmas Modulares - Referencia os históricos ao Curso Modular. */
    IF (l_r124HCR_aux.INDVCT <> 'S') AND ((l_r124HCR_aux.SITCUA = 1) OR (l_r124HCR_aux.SITCUA = 2)) THEN
      TR_ATUTURMOD(l_r124HCR_aux.CODCUA, l_r124HCR_aux.NUMEMP, l_r124HCR_aux.TIPCOL, l_r124HCR_aux.NUMCAD, l_r124HCR_aux.SEQHCR, 'I');
    END IF;
  END LOOP;

  BEGIN
    DELETE FROM R124HCR_AUX WHERE TIPOPE = 'I';
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro Exclusão da R124HCR_AUX.';
  END;

  /* Se for informix não pode executar rotina de atualização do nome de curso e outras empresas */
  /* Existe a limitação do banco e é gerado o erro -747 no informix                             */
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN
    /* SINCRONIZAÇÃO DO NOME DO CURSO E DA ENTIDADE DE ENSINO COM O CADASTRO DO CURSO E DA ENTIDADE */
    /* Busca os registros inserido na AUX2 */
    FOREACH C_124HCR_I_AX3 INTO l_R124HCR_aux3.NUMEMP,
                                l_R124HCR_aux3.TIPCOL,
                                l_R124HCR_aux3.NUMCAD,
                                l_R124HCR_aux3.CODCUA,
                                l_R124HCR_aux3.SEQHCR,
                                l_R124HCR_aux3.NOMOEM,
                                l_R124HCR_aux3.NOMCUA,
                                l_R124HCR_aux3.TIPOPE,
                                l_R124HCR_aux3.SEQCAP
    LOOP
      /* Se o nome não estiver nulo deve ser ajustado na tabela R124HCR */
      /* Este estará nulo quando nenhum ajuste precisa ser feito (Tratado no INSERT da EI na tabela AUX2 )*/

      IF (l_R124HCR_aux3.NOMOEM IS NOT NULL) THEN
        BEGIN
          /* Sincroniza o nome da entidade de ensino do histórico do curso de aperfeiçoamento */
          /* com o nome cadastrado no cadastro de outras empresas (R032OEM) */
          UPDATE R124HCR
             SET NOMOEM = l_R124HCR_AUX3.NOMOEM
           WHERE NUMEMP = L_R124HCR_AUX3.NUMEMP
             AND TIPCOL = L_R124HCR_AUX3.TIPCOL
             AND NUMCAD = L_R124HCR_AUX3.NUMCAD
             AND CODCUA = L_R124HCR_AUX3.CODCUA
             AND SEQHCR = L_R124HCR_AUX3.SEQHCR;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar o nome da entidade de ensino na tabela R124HCR. (R1224HCR_SI)';
        END;
      END IF;

      /* Se o nome não estiver nulo deve ser ajustado na tabela R124HCR */
      /* Esle estará nulo quando nenhum ajuste precisa ser feito (Tratado no INSERT da EI na tabela AUX2 )*/
      IF (l_R124HCR_aux3.NOMCUA IS NOT NULL) THEN
        BEGIN
          /* Sincroniza o nome do curso do histórico do curso de aperfeiçoamento */
          /* com o cadastro do curso de aperfeiçoamento (R128CUA) */
          UPDATE R124HCR
             SET NOMCUA = l_R124HCR_AUX3.NOMCUA
           WHERE NUMEMP = L_R124HCR_AUX3.NUMEMP
             AND TIPCOL = L_R124HCR_AUX3.TIPCOL
             AND NUMCAD = L_R124HCR_AUX3.NUMCAD
             AND CODCUA = L_R124HCR_AUX3.CODCUA
             AND SEQHCR = L_R124HCR_AUX3.SEQHCR;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar o nome do curso na tabela R124HCR. (R124HCR_SI)';
        END;
      END IF;
       /* Verica se foi lincado com o curso da pessoa */
      IF (l_R124HCR_aux3.SEQCAP IS NOT NULL) THEN
        BEGIN
           UPDATE R124HCR
              SET SEQCAP = l_R124HCR_AUX3.SEQCAP
            WHERE NUMEMP = L_R124HCR_AUX3.NUMEMP
              AND TIPCOL = L_R124HCR_AUX3.TIPCOL
              AND NUMCAD = L_R124HCR_AUX3.NUMCAD
              AND CODCUA = L_R124HCR_AUX3.CODCUA
              AND SEQHCR = L_R124HCR_AUX3.SEQHCR
              /* Só atualiza se realmente precisar */
              AND (SEQCAP IS NULL OR SEQCAP <> l_R124HCR_AUX3.SEQCAP);
         EXCEPTION
           WHEN OTHERS THEN
             RAISERROR 103 'Erro ao atualizar a sequência do curso de formação na tabela R124HCR. (R124HCR_SI)';
         END;
         BEGIN
           sp_r124hcr(L_R124HCR_AUX3.NUMEMP
                     ,L_R124HCR_AUX3.TIPCOL
                     ,L_R124HCR_AUX3.NUMCAD
                     ,L_R124HCR_AUX3.SEQHCR
                     ,L_R124HCR_AUX3.CODCUA
                     ,l_R124HCR_AUX3.SEQCAP);
         EXCEPTION
           WHEN OTHERS THEN
             RAISERROR 103 'Erro ao atualizar a o certificado do curso de aperfeiçoamento na tabela R033HAP. (R124HCR_SI)';              
         END;                             
      END IF;  
    END LOOP;
    
    BEGIN
      /* Limpar tabela auxiliar */
      DELETE FROM R124HCR_AUX;
      DROP_TEMP_TABLE R124HCR_AUX;
      EXCEPTION WHEN OTHERS THEN
	      RAISERROR 103 'Erro ao excluir registros da tabela R124HCR_AUX';
  	END;
  	BEGIN
      /* Limpar tabela auxiliar */
      DELETE FROM R124HCR_AUX2;
      DROP_TEMP_TABLE R124HCR_AUX2;
      EXCEPTION WHEN OTHERS THEN
	      RAISERROR 103 'Erro ao excluir registros da tabela R124HCR_AUX2';
  	END;
  	BEGIN
      /* Limpar tabela auxiliar */
      DELETE FROM R124HCR_AUX3;
      DROP_TEMP_TABLE R124HCR_AUX3;
      EXCEPTION WHEN OTHERS THEN
	      RAISERROR 103 'Erro ao excluir registros da tabela R124HCR_AUX3';
  	END;    
  END IF;
END␀Ãà␀␀		SENIOR;05␀␀TRIGGER R124HCR_EI AFTER INSERT ON R124HCR FOR EACH ROW

DECLARE
/* SINCRONIZAÇÃO DO NOME DO CURSO E DA ENTIDADE DE ENSINO COM O CADASTRO DO CURSO E DA ENTIDADE */
  l_CurApePadrao   R000ASS.CUADEF%TYPE; /* Nome do curso de aperfeiçoamento padrão informado na tela de assinalamentos diversos */
  l_EntPadrao      R000ASS.ENTDEF%TYPE; /* Nome da entidade de ensino padrão informado na tela de assinalamentos diversos */
  l_NomCuaOrig     R124HCR.NOMCUA%TYPE; /* Nome do curso cadastrado na tabela R128CUA, nome original do curso */
  l_NomOemOrig     R124HCR.NOMOEM%TYPE; /* Nome da entidade de ensino cadastrado na tabela R032OEM, nome original da outra empresa*/
  /* Variável para controle do que deve ser sincronizado, se esta variáveis */
  /* estiverem com o valor nulo não será executado update na tabela R124HCR, ou seja, a sincronização não será feita pois o registro já deve está correto */
  l_NomCua         R124HCR.NOMCUA%TYPE;
  l_NomOem         R124HCR.NOMOEM%TYPE;
  l_isInformix   BOOLEAN;

  /* Sincronizar cursos --- */
  l_habpes             r000ass.habpes%TYPE;
  l_seqcap             r124hcr.seqcap%TYPE;
  l_idicua             r124hcr.idicua%TYPE;
  l_tem              BOOLEAN;
  l_DatAltHFI          R033HAP.DATAUX%TYPE;
  l_ColAti             R033HAP.COLATI%TYPE;
  
  /* Busca o código da pessoa */
  CURSOR c_r034fun IS
    SELECT codpes
      FROM r034fun
     WHERE numemp = :NEW.numemp
       AND tipcol = :NEW.tipcol
       AND numcad = :NEW.numcad
       AND codpes IS NOT NULL
       AND codpes > 0;
  l_codpes   r034fun.codpes%TYPE;
  /* Verifica que já tem um registro correspondente com a chave */
  CURSOR c_r033hap_chave IS
    SELECT 1 chave
      FROM r033hap
     WHERE seqcap = l_seqcap
       AND codpes = l_codpes;
  l_chave NUMBER;
  /* Verifica que já tem um registro correspondente com as características do curso */
  CURSOR c_r033hap_correspondente IS
    SELECT seqcap
      FROM r033hap
     WHERE perini = :NEW.perini
       AND codcua = :NEW.codcua
       AND codpes = l_codpes;
  /* --------------- */
  CREATE_TEMP_TABLE R124HCR_AUX;
  CREATE_TEMP_TABLE R124HCR_AUX2;
  CREATE_TEMP_TABLE R124HCR_AUX3;
  
  /* eSocial */
  l_Valor VARCHAR2(2000);
  l_EnviarCursoseSocial BOOLEAN;
  l_DataZero DATE;
  l_DataRef DATE;
  l_layout VARCHAR2(6);
  l_layoutAlteracaoContrato VARCHAR2(6);
  l_infoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
  /* --------------- */
BEGIN
  l_tem := FALSE;
  /* Variáveis utilizadas na sincronização do histórico de curso de aperfeiçoamento onde o nome do curso e */ 
  /* o nome da entidade de ensino esteja diferentes dos seus respectivos cadastros só não será      */
  /* sincronizado quando a entidade e o curso está definido como padrão nos assinalamentos          */
  l_NomCua := NULL;
  l_NomOem := NULL;
  l_infoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;
  
  IF (:NEW.ORIHCR <> 'X') AND (:NEW.ORIHCR <> 'Y') AND (:NEW.ORIHCR <> 'Z') THEN
    BEGIN
      INSERT INTO R124HCR_AUX (NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, PERINI, INDVCT, SITCUA, TIPOPE)
                       VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODCUA, :NEW.SEQHCR, :NEW.PERINI, :NEW.INDVCT, :NEW.SITCUA, 'I');
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro na Inclusão do Colaborador na tabela Auxiliar do Histórico de Curso de Aperfeiçoamento.';
    END;
  END IF;

  /* Se for informix não pode executar rotina de atualização do nome de curso e outras empresas */
  /* Existe a limitação do banco e é gerado o erro -747 no informix                             */
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN
    /* SINCRONIZAÇÃO DO NOME DO CURSO E DA ENTIDADE DE ENSINO COM O CADASTRO DO CURSO E DA ENTIDADE */
    BEGIN
      /* Busca a Entidade de ensino e o curso de aperfeiçoamento padrão definido nos assinalamentos diversos - R000ASS */
      SELECT IFNULL(CUADEF, 0),IFNULL(ENTDEF, 0) INTO l_CurApePadrao, l_EntPadrao
        FROM R000ASS;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler nos assinalamentos diversos o curso de aperfeiçoamento padrão e a entidade de ensino padrão (R000ASS) - (R124HCR_EI)';
    END;

    /* Somente se o curso de aperfeiçoamento informado for diferente do padrão deve prosseguir com o processo de sincronização do nome */
    /* Se não entrar nesta condição a variável l_NomCua continua com o valor nulo */
    IF (:NEW.CODCUA <> l_CurApePadrao) THEN
      BEGIN
        /* Busca o nome do curso original, cadastrado no cadastro do curso */
        SELECT NOMCUA INTO l_NomCuaOrig FROM R128CUA
         WHERE CODCUA = :NEW.CODCUA;
      EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler a tabela de cadastro do curso de aperfeiçoamento (R128CUA) - (R124HCR_EI)';
      END;
      /* Se o nome informado para o curso for diferente do padrão. continua com a sincronização */
      IF (IFNULL(:NEW.NOMCUA, ' ') <> l_NomCuaOrig) THEN
        /* Atribui o nome original do curso para a variável, pois na SI será substituído o que o usuário */
        /* informou pelo nome original do curso. */
        l_NomCua := l_NomCuaOrig;
      END IF;
    END IF;

    /* Somente se a entidade de ensino informado for diferente do padrão deve prosseguir com o processo de sincronização do nome */
    /* Se não entrar nesta condição a variável l_NomOem continua com o valor nulo */
    IF ((:NEW.CODOEM <> l_EntPadrao) AND (:NEW.CODOEM <> 0)) THEN
      BEGIN
        /* Bunca o nome da entidade de ensino original, cadastrado no cadastro de outras empresas */
        SELECT NOMOEM INTO l_NomOemOrig FROM R032OEM
         WHERE CODOEM = :NEW.CODOEM;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler o cadastro de outras empresas (R032OEM) - (R124HCR_EI)';
      END;
      /* Se o nome informado para o curso for diferente do padrão. continua com a sincronização */
      IF (IFNULL(:NEW.NOMOEM, ' ') <> l_NomOemOrig) THEN
        /* Atribui o nome original da entidade de ensino para a variável, com isso na SI será substituído o que o usuário */
        /* informou pelo nome original da entidade. */
        l_NomOem := l_NomOemOrig;
      END IF;
    END IF;

    /* Se uma das variáveis l_NomCua ou l_NomOem não estiver nula, então insere na tabela R124HCR_AUX3 */
    /* para que na SI seja tratado se deve ser atualizado ou não, se por exemplo a variável l_NomOem */
    /* estiver com o valor nulo, não será sincronizado o nome da entidade quando chegar na SI */
    IF ((l_NomCua IS NOT NULL) OR (l_NomOem IS NOT NULL)) THEN
      BEGIN
        INSERT INTO R124HCR_AUX3 (NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, NOMOEM, NOMCUA, TIPOPE, FLGCON)
                          VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODCUA, :NEW.SEQHCR, l_NomOem, l_NomCua, 'I', 0);
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao inserir na R124HCR_AUX3 (R124HCR_EI)';
      END;
    END IF;
  END IF;

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
  
  /* Verifica se deve ser sincronizado o histórico de curso do colaborador para a pessoa */
  SELECT habpes INTO l_habpes FROM r000ass;
  IF (l_habpes = 'S') THEN
    /* Busca o código da pessoa */
    FOREACH c_r034fun INTO l_codpes LOOP
      l_seqcap := :NEW.seqcap;
      IF l_seqcap IS NOT NULL AND l_seqcap > 0 THEN
        /* Verifica que já tem um registro correspondente com a chave */
        FOREACH c_r033hap_chave INTO l_chave LOOP      
          l_tem := TRUE;
        END LOOP;
      END IF;
      IF l_tem = FALSE THEN
        /* Verifica que já tem um registro correspondente com as características do curso */
        FOREACH c_r033hap_correspondente INTO l_seqcap LOOP
          l_tem := TRUE;
        END LOOP;
      END IF;
      
      IF :NEW.idicua IS NULL THEN
        l_idicua := 'C';
      ELSE
        l_idicua := :NEW.idicua;
      END IF;
    
      /* Retornar a data do primeiro hist. filial do colaborador */
      R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);
        
      /* Retornar se o colaborador está ativo */
      R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);
        
      IF l_tem = FALSE THEN
        IF l_seqcap IS NULL OR l_seqcap = 0 THEN
          /* Obtém uma nova sequência */
          SELECT MAX(seqcap) + 1 INTO l_seqcap FROM r033hap WHERE codpes = l_codpes;
          IF l_seqcap IS NULL OR l_seqcap = 0 THEN
            l_seqcap := 1;  
          END IF;
        END IF;
                
        /* Gera um novo */
        INSERT INTO r033hap
          (codpes
          ,seqcap
          ,codcua
          ,perini
          ,perfim
          ,codoem
          ,nomoem
          ,sitcua
          ,tipcer
          ,medcua
          ,frecua
          ,carhor
          ,fascua
          ,comcua
          ,indvct
          ,idilei
          ,idiesc
          ,idicon
          ,orihcr
          ,idicua
          ,tmacua
          ,codevn
          ,codmin
          ,nomcua
          ,nomarq
          ,empaux
          ,tipaux
          ,cadaux
          ,depaux
          ,colati
          ,canaux
          ,dataux
          ,tiptre)
        VALUES
          (l_codpes
          ,l_seqcap
          ,:NEW.codcua
          ,:NEW.perini
          ,:NEW.perfim
          ,:NEW.codoem
          ,:NEW.nomoem
          ,:NEW.sitcua
          ,:NEW.tipcer
          ,:NEW.medcua
          ,:NEW.frecua
          ,:NEW.carhor
          ,:NEW.fascua
          ,:NEW.comcua
          ,:NEW.indvct
          ,:NEW.idilei
          ,:NEW.idiesc
          ,:NEW.idicon
          ,:NEW.orihcr
          ,l_idicua
          ,:NEW.tmacua
          ,NULL
          ,:NEW.codmin
          ,:NEW.NOMCUA
          ,:NEW.nomarq
          ,:NEW.numemp
          ,:NEW.tipcol
          ,:NEW.numcad
          ,0
          ,l_ColAti
          ,0
          ,l_DatAltHFI
          ,:NEW.TipTre);
      ELSE
        /* Atualiza o existente */
        UPDATE r033hap
           SET codcua = :NEW.codcua
              ,perini = :NEW.perini
              ,perfim = :NEW.perfim
              ,codoem = :NEW.codoem
              ,nomoem = :NEW.nomoem
              ,sitcua = :NEW.sitcua
              ,tipcer = :NEW.tipcer
              ,medcua = :NEW.medcua
              ,frecua = :NEW.frecua
              ,carhor = :NEW.carhor
              ,fascua = :NEW.fascua
              ,comcua = :NEW.comcua
              ,indvct = :NEW.indvct
              ,idilei = :NEW.idilei
              ,idiesc = :NEW.idiesc
              ,idicon = :NEW.idicon
              ,orihcr = :NEW.orihcr
              ,idicua = :NEW.idicua
              ,tmacua = :NEW.tmacua
              ,codmin = :NEW.codmin
              ,nomcua = :NEW.NOMCUA
              ,nomarq = :NEW.nomarq
              ,empaux = :NEW.numemp
              ,tipaux = :NEW.tipcol
              ,cadaux = :NEW.numcad
              ,depaux = 0
              ,colati = l_ColAti
              ,canaux = 0
              ,dataux = l_DatAltHFI
              ,tiptre = :NEW.TipTre
         WHERE seqcap = l_seqcap
           AND codpes = l_codpes;
      END IF;
      /* Faz o link com o curso gerado (SEQCAP), o bom seria se desse para fazer update direto,
         mas se fizer update vai caracterizar como uma trigger mutante, então tem que 
         jogar na tabela auxiliar para depois atualizar novamente a tabela.
         
         Este INSERT serve também para atualizar o anexo da R033HAP, não é possível utilizar o
         :NEW.cercur no INSERT nem no UPDATE, devido bug na tradução para SQLSERVER.         
      */
	  IF ((l_isInformix = FALSE) AND ((l_NomCua IS NOT NULL) OR (l_NomOem IS NOT NULL)))  THEN
	    UPDATE R124HCR_aux3
          SET SEQCAP = l_seqcap
	      WHERE NUMEMP = :NEW.Numemp
          AND TIPCOL = :NEW.tipcol
          AND NUMCAD = :NEW.numcad
          AND CODCUA = :NEW.codcua
          AND SEQHCR = :NEW.seqHCr;
	  ELSE
	    INSERT INTO r124hcr_aux3
          (numemp, tipcol, numcad, codcua, seqhcr, tipope, seqcap)
        VALUES
          (:NEW.numemp, :NEW.tipcol, :NEW.numcad, :NEW.codcua, :NEW.seqhcr, 'I', l_seqcap);
	  END IF;
	  
    END LOOP;
  END IF;
  
  /* eSocial - Início */
  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  l_EnviarCursoseSocial := FALSE;
  RH_CURSOESOCIAL(:NEW.CodCua, l_EnviarCursoseSocial OUT);
  
  IF (l_EnviarCursoseSocial = TRUE) THEN
    SP_ESOCIAL_INFO(:NEW.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
	IF (l_SimplificaoESocial = TRUE AND :NEW.SITCUA = 2) THEN
	  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
      IF (l_layout IS NOT NULL AND l_layout = 'S-2200') THEN  
        RH_LAYOUT_ALT_CONT(l_layout, l_layoutAlteracaoContrato OUT);
        l_Valor := '';
        SP_CONCATENAR_NUM('CODCUA', :NEW.CODCUA, l_Valor OUT);
        SP_CONCATENAR_NUM('SEQHCR', :NEW.SEQHCR, l_Valor OUT);
        SP_TREINA_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TipCol, :NEW.NumCad, :NEW.PERFIM, :NEW.PERFIM, 'R124HCR', 'I', l_Valor, '', 0, 'R124HCR_EI');
      END IF;
	END IF;	
  END IF;
  /* eSocial - Fim */
END␀Èà␀␀	SENIOR;0N5␀␀

TRIGGER R124HCR_SU AFTER UPDATE ON R124HCR
DECLARE
/* SINCRONIZAÇÃO DO NOME DO CURSO E DA ENTIDADE DE ENSINO COM O CADASTRO DO CURSO E DA ENTIDADE */
  CURSOR C_124HCR_U_AX3 IS
  SELECT NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, NOMOEM, NOMCUA, TIPOPE, SEQCAP
    FROM R124HCR_AUX3
   WHERE TIPOPE = 'U';

  /* SINCRONIZAÇÃO DO NOME DO CURSO E DA ENTIDADE DE ENSINO COM O CADASTRO DO CURSO E DA ENTIDADE */
  /* RECORD com os campos da tabela R124HCR_AUX3 */
  TYPE t_R124HCR_aux3 IS RECORD(
    NUMEMP   R124HCR_AUX3.NUMEMP%TYPE,
    TIPCOL   R124HCR_AUX3.TIPCOL%TYPE,
    NUMCAD   R124HCR_AUX3.NUMCAD%TYPE,
    CODCUA   R124HCR_AUX3.CODCUA%TYPE,
    SEQHCR   R124HCR_AUX3.SEQHCR%TYPE,
    NOMOEM   R124HCR_AUX3.NOMOEM%TYPE,
    NOMCUA   R124HCR_AUX3.NOMCUA%TYPE,
    TIPOPE   R124HCR_AUX3.TIPOPE%TYPE,
    SEQCAP   R124HCR_AUX3.SEQCAP%TYPE);

  /* SINCRONIZAÇÃO DO NOME DO CURSO E DA ENTIDADE DE ENSINO COM O CADASTRO DO CURSO E DA ENTIDADE */
  l_R124HCR_aux3 t_R124HCR_aux3;

  CURSOR C_R124HCR_UP1 IS SELECT NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, PERINI, SITCUA, INIOLD, SITOLD, TIPOPE
                            FROM R124HCR_AUX2 WHERE SEQREG = 1 AND TIPOPE = 'U';

  TYPE t_r124HCR_aux IS RECORD(
    NUMEMP   R124HCR_AUX.NUMEMP%TYPE,
    TIPCOL   R124HCR_AUX.TIPCOL%TYPE,
    NUMCAD   R124HCR_AUX.NUMCAD%TYPE,
    CODCUA   R124HCR_AUX.CODCUA%TYPE,
    SEQHCR   R124HCR_AUX.SEQHCR%TYPE,
    PERINI   R124HCR_AUX.PERINI%TYPE,
    SITCUA   R124HCR_AUX.SITCUA%TYPE,
    INIOLD   R124HCR_AUX.INIOLD%TYPE,
    SITOLD   R124HCR_AUX.SITOLD%TYPE,
    TIPOPE   R124HCR_AUX.TIPOPE%TYPE);

  l_r124HCR_aux t_r124HCR_aux;

  CURSOR C_R134CUR_sel IS SELECT CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD FROM R134CUR
                           WHERE NUMEMP = l_r124HCR_aux.NUMEMP AND TIPCOL = l_r124HCR_aux.TIPCOL
                             AND NUMCAD = l_r124HCR_aux.NUMCAD AND CODCUR = l_r124HCR_aux.CODCUA
                             AND SEQHCR = l_r124HCR_aux.SEQHCR;
                             
  CURSOR C_R124HCR_AUX IS SELECT NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, PERINI, SITCUA, INIOLD, SITOLD, TIPOPE
                          FROM R124HCR_AUX WHERE TIPOPE = 'U';

  TYPE t_r134CUR_sel IS RECORD(
    CODCUA   R134CUR_AUX.CODCUA%TYPE,
    TMACUA   R134CUR_AUX.TMACUA%TYPE,
    NUMEMP   R134CUR_AUX.NUMEMP%TYPE,
    TIPCOL   R134CUR_AUX.TIPCOL%TYPE,
    NUMCAD   R134CUR_AUX.NUMCAD%TYPE);

  l_r134CUR_sel t_r134CUR_sel;

  xSeqReg       NUMBER(3);
  xTemAux       NUMBER;
  l_Count       NUMBER;
  l_isInformix  BOOLEAN;
BEGIN
  /* Verifica se existe alguma coisa na tabela R124HCR_AUX2 */
  BEGIN
    SELECT COUNT(*) INTO xTemAux FROM R124HCR_AUX2;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      xTemAux := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na Busca da R124HCR_AUX2';
  END;

  IF (xTemAux > 0) THEN
    /* Nesta Trigger os dados da AUX estão sendo inseridos na AUX2 porque os processamentos desta trigger disparam
       Triggers de outras tabelas que podem efetuar um UPDATE (segundo update) nesta mesma Tabela. Se isto acontecesse ]
       e tivesse algum registro na AUX, as triggers entrariam em LOOP porque a Trigger de statement daquele
       segundo update pegaria os registros processados pelo primeiro UPDATE.
       Jogando os valores para a AUX2 com uma sequencia, isto não mais acontecerá. */

    /* Busca a maior sequencia da AUX */
    BEGIN
      SELECT IFNULL(MAX(SEQREG), 0) INTO xSeqReg FROM R124HCR_AUX2;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        xSeqReg := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na Busca da sequencia da R124HCR_AUX';
    END;

    /* Incrementa a sequencia para incluir registros com a mesma. */
    xSeqReg := xSeqReg + 1;
    
    /* Le Registro da AUX para inserir na AUX2 com a sequencia */
    FOREACH C_R124HCR_AUX INTO l_r124hcr_aux.NUMEMP,
                               l_r124hcr_aux.TIPCOL,
                               l_r124hcr_aux.NUMCAD,
                               l_r124hcr_aux.CODCUA,
                               l_r124hcr_aux.SEQHCR,
                               l_r124hcr_aux.PERINI,
                               l_r124hcr_aux.SITCUA,
                               l_r124hcr_aux.INIOLD,
                               l_r124hcr_aux.SITOLD,
                               l_r124hcr_aux.TIPOPE
      LOOP
      BEGIN
        INSERT INTO R124HCR_AUX2 (SEQREG, NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, PERINI, SITCUA, INIOLD, SITOLD, TIPOPE)
           VALUES (xSeqReg,  l_r124hcr_aux.NUMEMP, l_r124hcr_aux.TIPCOL, l_r124hcr_aux.NUMCAD, l_r124hcr_aux.CODCUA, l_r124hcr_aux.SEQHCR, l_r124hcr_aux.PERINI, l_r124hcr_aux.SITCUA, l_r124hcr_aux.INIOLD, l_r124hcr_aux.SITOLD, l_r124hcr_aux.TIPOPE);
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'Erro no INSERT na R124HCR_AUX2.';
      END;
    END LOOP;   

    /* Apaga Registro OLD em R124HCR_AUX */
    BEGIN
      DELETE FROM R124HCR_AUX WHERE TIPOPE = 'U';
    EXCEPTION WHEN OTHERS THEN
      NULL;
    END;

    IF (xSeqReg = 1) THEN
      FOREACH C_R124HCR_UP1 INTO l_r124HCR_aux.NUMEMP,
                                 l_r124HCR_aux.TIPCOL,
                                 l_r124HCR_aux.NUMCAD,
                                 l_r124HCR_aux.CODCUA,
                                 l_r124HCR_aux.SEQHCR,
                                 l_r124HCR_aux.PERINI,
                                 l_r124HCR_aux.SITCUA,
                                 l_r124HCR_aux.INIOLD,
                                 l_r124HCR_aux.SITOLD,
                                 l_r124HCR_aux.TIPOPE
      LOOP
        /* IMPORTANTE - IMPORTANTE - IMPORTANTE - IMPORTANTE */
        /* Somente zera a Turma modular e vincula quando for uma Disciplina que estiver sendo alterada (xSeqReg = 1). */
        /* Se a Situação do histórico passou de Completa ou Reprovada para outra, reinicia o participante na Turma Modular. */
        IF ((l_r124HCR_aux.SITOLD = 2) OR (l_r124HCR_aux.SITOLD = 5) OR (l_r124HCR_aux.SITOLD = 6)) AND
           ((l_r124HCR_aux.SITCUA = 1) OR (l_r124HCR_aux.SITCUA = 3) OR (l_r124HCR_aux.SITCUA = 4) OR (l_r124HCR_aux.SITCUA = 8)) THEN
          /* Le Turmas Modulares do Histórico */
          FOREACH C_R134CUR_sel INTO  l_r134CUR_sel.CODCUA,
                                      l_r134CUR_sel.TMACUA,
                                      l_r134CUR_sel.NUMEMP,
                                      l_r134CUR_sel.TIPCOL,
                                      l_r134CUR_sel.NUMCAD
          LOOP
            TR_ZERTURMOD(l_r134CUR_sel.CODCUA, l_r134CUR_sel.TMACUA, l_r134CUR_sel.NUMEMP, l_r134CUR_sel.TIPCOL, l_r134CUR_sel.NUMCAD);
          END LOOP;
        END IF;

        /* Se a Situação do histórico mudou de desistente/suspensa/reprovada/transferida para em Andamento ou Completa, vincula. */
        IF ((l_r124HCR_aux.SITOLD = 3) OR (l_r124HCR_aux.SITOLD = 4) OR (l_r124HCR_aux.SITOLD = 5) OR (l_r124HCR_aux.SITOLD = 6) OR (l_r124HCR_aux.SITOLD = 8)) AND
           ((l_r124HCR_aux.SITCUA = 1) OR (l_r124HCR_aux.SITCUA = 2)) THEN
          TR_ATUTURMOD(l_r124HCR_aux.CODCUA, l_r124HCR_aux.NUMEMP, l_r124HCR_aux.TIPCOL, l_r124HCR_aux.NUMCAD, l_r124HCR_aux.SEQHCR, 'I');
        END IF;
      END LOOP;
    END IF;
  ELSE
    /* Apaga Registro OLD em R124HCR_AUX */
    BEGIN
      DELETE FROM R124HCR_AUX WHERE TIPOPE = 'U';
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro Exclusão da R124HCR_AUX.';
    END;
  END IF;

  BEGIN
    DELETE FROM R124HCR_AUX2 WHERE SEQREG = xSeqReg AND TIPOPE = 'U';
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro Exclusão da R124HCR_AUX2.';
  END;

  /* Se for informix não pode executar rotina de atualização do nome de curso e outras empresas */
  /* Existe a limitação do banco e é gerado o erro -747 no informix                             */
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN
    /* Garante que está sendo processado a trigger de _SU uma unica vez
       evitando assim LOOP, pois via trigger de SU é feito um update para o mesmo registro. */
    BEGIN
      SELECT COUNT(*) INTO l_Count FROM R124HCR_AUX3
       WHERE TIPOPE = 'U' AND FLGCON = 1;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao retornar Flag de Controle da tabela R124HCR_AUX3.';
    END;

    /* Se não existe registro com Flag = 1 significa estar passando pela primeira vez na trigger de _SU */
    IF (l_Count  = 0) THEN
      /* Seta flag de controle para 1, evitando que a trigger de _SU seja
         processada em mais de uma instancia, controle necessário para evitar a Recursividade */
      BEGIN
        UPDATE R124HCR_AUX3 SET FLGCON = 1
         WHERE TIPOPE = 'U';
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro Flag de Controle da tabela R124HCR_AUX3.';
      END;

      /* SINCRONIZAÇÃO DO NOME DO CURSO E DA ENTIDADE DE ENSINO COM O CADASTRO DO CURSO E DA ENTIDADE */
      /* Busca os registros inserido na AUX2 */
      FOREACH C_124HCR_U_AX3 INTO l_R124HCR_aux3.NUMEMP,
                                  l_R124HCR_aux3.TIPCOL,
                                  l_R124HCR_aux3.NUMCAD,
                                  l_R124HCR_aux3.CODCUA,
                                  l_R124HCR_aux3.SEQHCR,
                                  l_R124HCR_aux3.NOMOEM,
                                  l_R124HCR_aux3.NOMCUA,
                                  l_R124HCR_aux3.TIPOPE,
                                  l_R124HCR_aux3.SEQCAP
      LOOP
        /* Se o nome não estiver nulo deve ser ajustado na tabela R124HCR */
        /* Esle estará nulo quando nenhum ajuste precisa ser feito (Tratado no INSERT da EI na tabela AUX2 )*/
        IF (l_R124HCR_aux3.NOMCUA IS NOT NULL) THEN
          BEGIN
            /* Sincroniza o nome do curso do histórico do curso de aperfeiçoamento */
            /* com o cadastro do curso de aperfeiçoamento (R128CUA) */
            UPDATE R124HCR
               SET NOMCUA = l_R124HCR_AUX3.NOMCUA
             WHERE NUMEMP = L_R124HCR_AUX3.NUMEMP
               AND TIPCOL = L_R124HCR_AUX3.TIPCOL
               AND NUMCAD = L_R124HCR_AUX3.NUMCAD
               AND CODCUA = L_R124HCR_AUX3.CODCUA
               AND SEQHCR = L_R124HCR_AUX3.SEQHCR;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar o nome do curso na tabela R124HCR. (R124HCR_SU)';
          END;
        END IF;

        /* Se o nome não estiver nulo deve ser ajustado na tabela R124HCR */
        /* Este estará nulo quando nenhum ajuste precisa ser feito (Tratado no INSERT da EI na tabela AUX2 )*/
        IF (l_R124HCR_aux3.NOMOEM IS NOT NULL) THEN
          BEGIN
            /* Sincroniza o nome da entidade de ensino do histórico do curso de aperfeiçoamento */
            /* com o nome cadastrado no cadastro de outras empresas (R032OEM) */
            UPDATE R124HCR
               SET NOMOEM = l_R124HCR_aux3.NOMOEM
             WHERE NUMEMP = L_R124HCR_AUX3.NUMEMP
               AND TIPCOL = L_R124HCR_AUX3.TIPCOL
               AND NUMCAD = L_R124HCR_AUX3.NUMCAD
               AND CODCUA = L_R124HCR_AUX3.CODCUA
               AND SEQHCR = L_R124HCR_AUX3.SEQHCR;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar o nome da Entidade de ensino na tabela R124HCR. (R124HCR_SU)';
          END;
        END IF;
        /* Verica se foi lincado com o curso da pessoa */
        IF (l_R124HCR_aux3.SEQCAP IS NOT NULL) THEN
         BEGIN
            UPDATE R124HCR
               SET SEQCAP = l_R124HCR_AUX3.SEQCAP
             WHERE NUMEMP = L_R124HCR_AUX3.NUMEMP
               AND TIPCOL = L_R124HCR_AUX3.TIPCOL
               AND NUMCAD = L_R124HCR_AUX3.NUMCAD
               AND CODCUA = L_R124HCR_AUX3.CODCUA
               AND SEQHCR = L_R124HCR_AUX3.SEQHCR
               /* Só atualiza se realmente precisar */
               AND (SEQCAP IS NULL OR SEQCAP <> l_R124HCR_AUX3.SEQCAP);
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a sequência do curso de formação na tabela R124HCR. (R124HCR_SU)';
          END;
          BEGIN
            sp_r124hcr(L_R124HCR_AUX3.NUMEMP
                      ,L_R124HCR_AUX3.TIPCOL
                      ,L_R124HCR_AUX3.NUMCAD
                      ,L_R124HCR_AUX3.SEQHCR
                      ,L_R124HCR_AUX3.CODCUA
                      ,l_R124HCR_AUX3.SEQCAP);
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a o certificado do curso de aperfeiçoamento na tabela R033HAP. (R124HCR_SU)';                     
          END; 
        END IF;              
      END LOOP;

      BEGIN
        /* Limpar tabela auxiliar */
        DELETE FROM R124HCR_AUX;
        DROP_TEMP_TABLE R124HCR_AUX;
        EXCEPTION WHEN OTHERS THEN
	        RAISERROR 103 'Erro ao excluir registros da tabela R124HCR_AUX';
  	  END;
  	  BEGIN
        /* Limpar tabela auxiliar */
        DELETE FROM R124HCR_AUX2;
        DROP_TEMP_TABLE R124HCR_AUX2;
        EXCEPTION WHEN OTHERS THEN
  	      RAISERROR 103 'Erro ao excluir registros da tabela R124HCR_AUX2';
  	  END;
    	BEGIN
        /* Limpar tabela auxiliar */
        DELETE FROM R124HCR_AUX3;
        DROP_TEMP_TABLE R124HCR_AUX3;
        EXCEPTION WHEN OTHERS THEN
	        RAISERROR 103 'Erro ao excluir registros da tabela R124HCR_AUX3';
  	  END;  
    END IF;
  END IF;
END␀Äà␀␀		SENIOR;0öJ␀␀

TRIGGER R124HCR_EU AFTER UPDATE ON R124HCR FOR EACH ROW
DECLARE
/* SINCRONIZAÇÃO DO NOME DO CURSO E DA ENTIDADE DE ENSINO COM O CADASTRO DO CURSO E DA ENTIDADE */
  l_CurApePadrao   R000ASS.CUADEF%TYPE; /* Nome do curso de aperfeiçoamento padrão informado na tela de assinalamentos diversos */
  l_EntPadrao   R000ASS.ENTDEF%TYPE;    /* Nome da entidade de ensino padrão informado na tela de assinalamentos diversos */
  l_NomCuaOrig   R124HCR.NOMCUA%TYPE;   /* Nome do curso cadastrado na tabela R128CUA, nome original do curso */
  l_NomOemOrig   R124HCR.NOMOEM%TYPE;   /* Nome da entidade de ensino cadastrado na tabela R032OEM, nome original da outra empresa*/
  /* Variável para controle do que deve ser sincronizado, se esta variáveis */
  /* estiverem com o valor nulo não será executado update na tabela R124HCR, ou seja, */
  /* a sincronização não será feita pois o registro já deve está correto */
  l_NomCua   R124HCR.NOMCUA%TYPE;
  l_NomOem   R124HCR.NOMOEM%TYPE;
  l_Count       NUMBER;
  l_isInformix  BOOLEAN;
  /* Sincronizar cursos --- */
  l_habpes             r000ass.habpes%TYPE;
  l_seqcap             r124hcr.seqcap%TYPE;
  l_idicua             r124hcr.idicua%TYPE;
  l_tem              BOOLEAN;
  l_DatAltHFI          R033HAP.DATAUX%TYPE;
  l_ColAti             R033HAP.COLATI%TYPE;
  /* Busca o código da pessoa */
  CURSOR c_r034fun IS
    SELECT codpes
      FROM r034fun
     WHERE numemp = :NEW.numemp
       AND tipcol = :NEW.tipcol
       AND numcad = :NEW.numcad
       AND codpes IS NOT NULL
       AND codpes > 0;
  l_codpes   r034fun.codpes%TYPE;
  /* Verifica que já tem um registro correspondente com a chave */
  CURSOR c_r033hap_chave IS
    SELECT 1 chave
      FROM r033hap
     WHERE seqcap = l_seqcap
       AND codpes = l_codpes;
  l_chave NUMBER;
  /* Verifica que já tem um registro correspondente com as características do curso */
  CURSOR c_r033hap_correspondente IS
    SELECT seqcap
      FROM r033hap
     WHERE perini = :NEW.perini
       AND codcua = :NEW.codcua
       AND codpes = l_codpes;
  /* --------------- */
  CREATE_TEMP_TABLE R124HCR_AUX;
  CREATE_TEMP_TABLE R124HCR_AUX2;
  CREATE_TEMP_TABLE R124HCR_AUX3;
 
  /* eSocial */
  l_EnviarCursoseSocial BOOLEAN;
  l_Valido BOOLEAN;
  l_JsonCamposAlterados VARCHAR2(2000);
  l_Alterou BOOLEAN;
  l_DataZero DATE;
  l_PerIniOld DATE;
  l_PerFimOld DATE;
  l_PerIniNew DATE;
  l_PerFimNew DATE; 
  l_Valor VARCHAR2(2000);
  l_JsonInfoCadastral VARCHAR2(2000);
  l_CursoeSocial BOOLEAN;
  l_DataRef DATE;
  l_layout VARCHAR2(6);
  l_layoutAlteracaoContrato VARCHAR2(6);
  l_infoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
  /* --------------- */
BEGIN
  l_NomCua := NULL;
  l_NomOem := NULL;
  l_tem := FALSE;
  l_infoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;

  IF ((:OLD.ORIHCR <> 'X') AND (:OLD.ORIHCR <> 'Y') AND (:OLD.ORIHCR <> 'Z') AND
     (:NEW.ORIHCR <> 'X') AND (:NEW.ORIHCR <> 'Y') AND (:NEW.ORIHCR <> 'Z')) AND
     ((:NEW.NUMEMP = :OLD.NUMEMP) AND
      (:NEW.TIPCOL = :OLD.TIPCOL) AND
      (:NEW.NUMCAD = :OLD.NUMCAD)) THEN
    BEGIN
      INSERT INTO R124HCR_AUX (NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, PERINI, SITCUA, INIOLD, SITOLD, TIPOPE)
                  VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODCUA, :NEW.SEQHCR, :NEW.PERINI, :NEW.SITCUA, :OLD.PERINI, :OLD.SITCUA, 'U');
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro na Inclusão do Colaborador na tabela Auxiliar do Histórico de Curso de Aperfeiçoamento.';
    END;
  END IF;
  
  /* Se for informix não pode executar rotina de atualização do nome de curso e outras empresas */
  /* Existe a limitação do banco e é gerado o erro -747 no informix                             */
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN
    /* Sincroniza nome do curso e nome da Entidade de ensino */
    BEGIN
      /* Busca a Entidade de Ensino e o curso de aperfeiçoamento padrão definido nos assinalamentos diversos - R000ASS */
      SELECT IFNULL(CUADEF, 0),IFNULL(ENTDEF, 0) INTO l_CurApePadrao, l_EntPadrao
        FROM R000ASS;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler nos assinalamentos diversos, o curso de aperfeiçoamento padrão e a entidade de ensino padrão (R000ASS) - (R124HCR_SU)';
    END;

    /* Somente se o curso de aperfeiçoamento informado for diferente do padrão deve prosseguir com o processo de sincronização do nome */
    /* Se não entrar nesta condição a variável l_NomCua continua com o valor nulo */
    IF ((:NEW.CODCUA <> :OLD.CODCUA) OR (IFNULL(:NEW.NOMCUA, ' ') <> IFNULL(:OLD.NOMCUA, ' '))) THEN
      IF (:NEW.CODCUA <> l_CurApePadrao) THEN
        BEGIN
          /* Verifica se existe na _AUX, indica que o processo foi startado via UPDATE NA R128CUA,
             e sendo assim, não se deve executar a rotina abaixo, visto que os valores já estão
             corretos e o SELECT na R128CUA daria erro.                                           */
          SELECT COUNT(*) INTO l_Count
            FROM R128CUA_AUX
           WHERE CODCUA = :NEW.CODCUA;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler o cadastro do curso de aperfeiçoamento (R128CUA_AUX) - (R124HCR_EU)';
        END;

        /* Se não existe registro na _aux */
        IF (l_Count = 0) THEN
          BEGIN
            /* Bunca o nome do curso original, cadastrado no cadastro do curso */
            SELECT NOMCUA INTO l_NomCuaOrig
              FROM R128CUA
             WHERE CODCUA = :NEW.CODCUA;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler o cadastro do curso de aperfeiçoamento (R128CUA) - (R124HCR_EU)';
          END;

          /* Se o nome informado para o curso for diferente do padrão. continua com a sincronização */
          IF (IFNULL(:NEW.NOMCUA, ' ') <> l_NomCuaOrig) THEN
            /* Atribui o nome original do curso para a variável, pois na SI será substituído o que o usuário */
            /* informou pelo nome original do curso. */
            l_NomCua := l_NomCuaOrig;
          END IF;
        END IF;
      END IF;
    END IF;

    /* Somente se a entidade de ensino informado for diferente do padrão deve prosseguir com o processo de sincronização do nome */
    /* Se não entrar nesta condição a variável l_NomOem continua com o valor nulo */
    IF ((IFNULL(:NEW.CODOEM, 0) <> IFNULL(:OLD.CODOEM, 0)) OR (IFNULL(:NEW.NOMOEM, ' ') <> IFNULL(:OLD.NOMOEM, ' '))) THEN
      IF ((IFNULL(:NEW.CODOEM, 0) <> l_EntPadrao) OR (IFNULL(:NEW.CODOEM, 0) = 0)) THEN
        BEGIN
          /* Verifica se existe na _AUX, indica que o processo foi startado via UPDATE NA R032OEM,
             e sendo assim, não se deve executar a rotina abaixo, visto que os valores já estão
             corretos e o SELECT na R032OEM daria erro.                                           */
          SELECT COUNT(*) INTO l_Count
            FROM R032OEM_AUX
           WHERE CODOEM = :NEW.CODOEM;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler o cadastro de outras empresas (R032OEM_AUX) - (R124HCR_EU)';
        END;

        /* Se não existe registro na _aux */
        IF (l_Count = 0) THEN
          BEGIN
            /* Busca o nome da entidade de ensino original, cadastrado no cadastro de outras empresas */
            SELECT NOMOEM INTO l_NomOemOrig
              FROM R032OEM
             WHERE CODOEM = :NEW.CODOEM;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              l_NomOemOrig := ' ';
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao ler o cadastro de outras empresas (R032OEM) - (R124HCR_EU)';
          END;

          /* Se o nome informado para o curso for diferente do padrão. continua com a sincronização */
          IF (IFNULL(:NEW.NOMOEM, ' ') <> l_NomOemOrig) THEN
            /* Atribui o nome original da entidade de ensino para a variável, com isso na SU será substituído o que o usuário */
            /* informou pelo nome original da entidade. */
            l_NomOem := l_NomOemOrig;
          END IF;
        END IF;
      END IF;
    END IF;


    /* Se uma das variáveis l_NomCua ou l_NomOem não estiver nula, então insere na tabela R124HCR_AUX3 */
    /* para que na SI seja tratado se deve ser atualizado ou não, se por exemplo a variável l_NomOem */
    /* estiver com o valor nulo, não será sincronizado o nome da entidade quando chegar na SU */
    IF ((l_NomCua IS NOT NULL) OR (l_NomOem IS NOT NULL)) THEN
      BEGIN
        INSERT INTO R124HCR_AUX3 (NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, NOMOEM, NOMCUA, TIPOPE, FLGCON)
                          VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODCUA, :NEW.SEQHCR, l_NomOem, l_NomCua, 'U', 0);
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao inserir na R124HCR_AUX3 (R124HCR_EU)';
      END;
    END IF;
  END IF;

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  /* Retirado a procedure RS_UPDCURCOMP pois estava gerando lentidão, agora os updates da R122CCO são feitos na trigger da R128CUA */
  
  /* Alterou */
  IF :OLD.codcua <> :NEW.codcua OR
     :OLD.perini <> :NEW.perini OR
     :OLD.perfim <> :NEW.perfim OR
     :OLD.codoem <> :NEW.codoem OR
     :OLD.nomoem <> :NEW.nomoem OR
     :OLD.sitcua <> :NEW.sitcua OR
     :OLD.tipcer <> :NEW.tipcer OR
     :OLD.medcua <> :NEW.medcua OR
     :OLD.frecua <> :NEW.frecua OR
     :OLD.carhor <> :NEW.carhor OR
     :OLD.fascua <> :NEW.fascua OR
     :OLD.comcua <> :NEW.comcua OR
     :OLD.indvct <> :NEW.indvct OR
     :OLD.idilei <> :NEW.idilei OR
     :OLD.idiesc <> :NEW.idiesc OR
     :OLD.idicon <> :NEW.idicon OR
     :OLD.orihcr <> :NEW.orihcr OR
     :OLD.idicua <> :NEW.idicua OR
     :OLD.tmacua <> :NEW.tmacua OR
     :OLD.codmin <> :NEW.codmin OR
     :OLD.nomarq <> :NEW.nomarq OR
     :OLD.tiptre <> :NEW.tiptre THEN
    /* Verifica se deve ser sincronizado o histórico de curso do colaborador para a pessoa */
    SELECT habpes INTO l_habpes FROM r000ass;
    IF (l_habpes = 'S') THEN
      /* Busca o código da pessoa */
      FOREACH c_r034fun INTO l_codpes LOOP
        l_seqcap := :NEW.seqcap;
        IF l_seqcap IS NOT NULL AND l_seqcap > 0 THEN
          /* Verifica que já tem um registro correspondente com a chave */
          FOREACH c_r033hap_chave INTO l_chave LOOP      
            l_tem          := TRUE;
          END LOOP;
        END IF;
        IF l_tem = FALSE THEN
          /* Verifica que já tem um registro correspondente com as características do curso */
          FOREACH c_r033hap_correspondente INTO l_seqcap LOOP
            l_tem              := TRUE;
          END LOOP;
        END IF;
        
        IF :NEW.idicua IS NULL THEN
          l_idicua := 'C';
        ELSE
          l_idicua := :NEW.idicua;
        END IF;
      
        /* Retornar a data do primeiro hist. filial do colaborador */
        R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);
        
        /* Retornar se o colaborador está ativo */
        R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);
        
        IF l_tem = TRUE THEN
          /* Atualiza o existente */
          UPDATE r033hap
             SET codcua = :NEW.codcua
                ,perini = :NEW.perini
                ,perfim = :NEW.perfim
                ,codoem = :NEW.codoem
                ,nomoem = :NEW.nomoem
                ,sitcua = :NEW.sitcua
                ,tipcer = :NEW.tipcer
                ,medcua = :NEW.medcua
                ,frecua = :NEW.frecua
                ,carhor = :NEW.carhor
                ,fascua = :NEW.fascua
                ,comcua = :NEW.comcua
                ,indvct = :NEW.indvct
                ,idilei = :NEW.idilei
                ,idiesc = :NEW.idiesc
                ,idicon = :NEW.idicon
                ,orihcr = :NEW.orihcr
                ,idicua = :NEW.idicua
                ,tmacua = :NEW.tmacua
                ,codmin = :NEW.codmin
                ,nomcua = :NEW.nomcua
                ,nomarq = :NEW.nomarq
                ,empaux = :NEW.numemp
                ,tipaux = :NEW.tipcol
                ,cadaux = :NEW.numcad
                ,depaux = 0
                ,colati = l_ColAti
                ,canaux = 0
                ,dataux = l_DatAltHFI
                ,tiptre = :NEW.TipTre
           WHERE seqcap = l_seqcap
             AND codpes = l_codpes;
        ELSE
         IF l_seqcap IS NULL OR l_seqcap = 0 THEN
            /* Obtém uma nova sequência */
            SELECT MAX(seqcap) + 1 INTO l_seqcap FROM r033hap WHERE codpes = l_codpes;
            IF l_seqcap IS NULL OR l_seqcap = 0 THEN
              l_seqcap := 1;  
            END IF;
          END IF;
          /* Gera um novo */
          INSERT INTO r033hap
            (codpes
            ,seqcap
            ,codcua
            ,perini
            ,perfim
            ,codoem
            ,nomoem
            ,sitcua
            ,tipcer
            ,medcua
            ,frecua
            ,carhor
            ,fascua
            ,comcua
            ,indvct
            ,idilei
            ,idiesc
            ,idicon
            ,orihcr
            ,idicua
            ,tmacua
            ,codevn
            ,codmin
            ,nomcua
            ,nomarq
            ,empaux
            ,tipaux
            ,cadaux
            ,depaux
            ,colati
            ,canaux
            ,dataux
            ,tiptre)
          VALUES
            (l_codpes
            ,l_seqcap
            ,:NEW.codcua
            ,:NEW.perini
            ,:NEW.perfim
            ,:NEW.codoem
            ,:NEW.nomoem
            ,:NEW.sitcua
            ,:NEW.tipcer
            ,:NEW.medcua
            ,:NEW.frecua
            ,:NEW.carhor
            ,:NEW.fascua
            ,:NEW.comcua
            ,:NEW.indvct
            ,:NEW.idilei
            ,:NEW.idiesc
            ,:NEW.idicon
            ,:NEW.orihcr
            ,l_idicua
            ,:NEW.tmacua
            ,NULL
            ,:NEW.codmin
            ,:NEW.nomcua
            ,:NEW.nomarq
            ,:NEW.numemp
            ,:NEW.tipcol
            ,:NEW.numcad
            ,0
            ,l_ColAti
            ,0
            ,l_DatAltHFI
            ,:NEW.TipTre);
        END IF;
        /* Faz o link com o curso gerado (SEQCAP), o bom seria se desse para fazer update direto,
           mas se fizer update vai caracterizar como uma trigger mutante, então tem que 
           jogar na tabela auxiliar para depois atualizar novamente a tabela.
         
           Este INSERT serve também para atualizar o anexo da R033HAP, não é possível utilizar o
           :NEW.cercur no INSERT nem no UPDATE, devido bug na tradução para SQLSERVER.         
        */
        INSERT INTO r124hcr_aux3
          (numemp, tipcol, numcad, codcua, seqhcr, tipope, seqcap)
        VALUES
          (:NEW.numemp, :NEW.tipcol, :NEW.numcad, :NEW.codcua, :NEW.seqhcr, 'U', l_seqcap);    
      END LOOP;
    END IF;
  END IF;

  /* eSocial - Início */
  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  l_EnviarCursoseSocial := FALSE;
  RH_CURSOESOCIAL(:NEW.CodCua, l_EnviarCursoseSocial OUT);
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  
  IF ((l_EnviarCursoseSocial = TRUE) AND (l_SimplificaoESocial = TRUE)) THEN
	l_Alterou := FALSE;
  	
	l_PerIniOld := :OLD.PerIni;
	l_PerFimOld := :OLD.PerFim;
	l_PerIniNew := :NEW.PerIni;
	l_PerFimNew := :NEW.PerFim;
	  
	l_JsonCamposAlterados := '';
	
	SP_VALUPDATE_DAT(l_PerFimOld, l_PerFimNew, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
	  l_Alterou := TRUE;
	  SP_CONCAT_DAT_JSON('PERFIM', :NEW.PerFim, :OLD.PerFim, l_JsonCamposAlterados OUT);
	END IF;
	
	SP_VALUPDATE_NUM(:OLD.SitCua, :NEW.SitCua, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
	  l_Alterou := TRUE;
	END IF;
	
	IF (l_Alterou = TRUE) THEN
		RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
		IF (l_layout IS NOT NULL AND l_layout = 'S-2200') THEN
		    RH_LAYOUT_ALT_CONT(l_layout, l_layoutAlteracaoContrato OUT);
	      	l_Valor := '';
		  	SP_CONCATENAR_NUM('CODCUA', :NEW.CODCUA, l_Valor OUT);
	      	SP_CONCATENAR_NUM('SEQHCR', :NEW.SEQHCR, l_Valor OUT);
	      	
	        /* monitoramento atualizacao - atualiza vlrpe2 */	
	        l_JsonInfoCadastral := '';
		    SP_CONCAT_NUM_JSON('CODCUA', :NEW.CODCUA, :OLD.CODCUA, l_JsonInfoCadastral OUT); 
    	    SP_CONCAT_NUM_JSON('SEQHCR', :NEW.SEQHCR, :OLD.SEQHCR, l_JsonInfoCadastral OUT);   
		    SP_CONCAT_NUM_JSON('SITCUA', :NEW.SitCua, :OLD.SitCua, l_JsonInfoCadastral OUT); 
		    SP_CONCAT_DAT_JSON('PERFIM', :NEW.PerFim, :OLD.PerFim, l_JsonInfoCadastral OUT); 
	      	
	      	/* Quando a situação atual for 2 - Completo e houver PERFIM definido */
	      	IF (:NEW.SITCUA = 2 AND :NEW.PERFIM <> l_DataZero) THEN
	      	  /* se não existia PERFIM e está sendo definido */
	      	  IF (:OLD.PERFIM = l_DataZero OR :OLD.PERFIM = :NEW.PERFIM) THEN
	      	    SP_TREINA_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TipCol, :NEW.NumCad, :NEW.PERFIM, :NEW.PERFIM, 'R124HCR', 'A', l_Valor, l_JsonInfoCadastral, 0, 'R124HCR_EU');
	      	  /* se existia PERFIM e está sendo alterado para data posterior */
	      	  ELSIF (:OLD.PERFIM < :NEW.PERFIM) THEN
	      	    SP_TREINA_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TipCol, :NEW.NumCad, :OLD.PERFIM, :OLD.PERFIM, 'R124HCR', 'A', l_Valor, l_JsonInfoCadastral, 0, 'R124HCR_EU');
	      	    SP_TREINA_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TipCol, :NEW.NumCad, :NEW.PERFIM, :NEW.PERFIM, 'R124HCR', 'A', l_Valor, l_JsonInfoCadastral, 0, 'R124HCR_EU');
	      	  /* se existia PERFIM e está sendo alterado para data anterior */
	      	  ELSIF (:OLD.PERFIM > :NEW.PERFIM) THEN
	      	    SP_TREINA_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TipCol, :NEW.NumCad, :NEW.PERFIM, :NEW.PERFIM, 'R124HCR', 'A', l_Valor, l_JsonInfoCadastral, 0, 'R124HCR_EU');
	      	    SP_TREINA_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TipCol, :NEW.NumCad, :OLD.PERFIM, :OLD.PERFIM, 'R124HCR', 'A', l_Valor, l_JsonInfoCadastral, 0, 'R124HCR_EU');
	      	  END IF;
	      	/* Se a nova situação for 2 - Completo, mas a antiga não OU se OLD.PERFIM for uma data e NEW.PERFIM não tiver data, equivale a exclusão do histórico */
	      	ELSIF ((:NEW.SITCUA <> 2 AND :OLD.SITCUA = 2) OR (:OLD.PERFIM <> l_DataZero AND :NEW.PERFIM = l_DataZero)) THEN
	      	  SP_TREINA_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TipCol, :NEW.NumCad, :OLD.PERFIM, :OLD.PERFIM, 'R124HCR', 'A', l_Valor, l_JsonInfoCadastral, 0, 'R124HCR_EU');
	      	END IF;
      	END IF;
	END IF;
  END IF;
  /* eSocial - Fim */
END␀Åà␀␀	SENIOR;0ï␀␀

TRIGGER R124HCR_SD AFTER DELETE ON R124HCR

DECLARE
CURSOR C_R124HCR_del IS SELECT NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, PERINI FROM R124HCR_AUX WHERE TIPOPE = 'E';

  TYPE t_r124HCR_aux IS RECORD(
      NUMEMP   R124HCR_AUX.NUMEMP%TYPE,
      TIPCOL   R124HCR_AUX.TIPCOL%TYPE,
      NUMCAD   R124HCR_AUX.NUMCAD%TYPE,
      CODCUA   R124HCR_AUX.CODCUA%TYPE,
      SEQHCR   R124HCR_AUX.SEQHCR%TYPE,
      PERINI   R124HCR_AUX.PERINI%TYPE);

  l_r124HCR_aux t_r124HCR_aux;
BEGIN
  FOREACH C_R124HCR_del INTO l_r124HCR_aux.NUMEMP,
                             l_r124HCR_aux.TIPCOL,
                             l_r124HCR_aux.NUMCAD,
                             l_r124HCR_aux.CODCUA,
                             l_r124HCR_aux.SEQHCR,
                             l_r124HCR_aux.PERINI
  LOOP
    /* Exclui as referências da R134CUR que apontam para este histórico */
    TR_ATUTURMOD(l_r124HCR_aux.CODCUA, l_r124HCR_aux.NUMEMP, l_r124HCR_aux.TIPCOL, l_r124HCR_aux.NUMCAD, l_r124HCR_aux.SEQHCR, 'E');
  END LOOP;

  BEGIN
    /* Limpar tabela auxiliar */
    DELETE FROM R124HCR_AUX;
    DROP_TEMP_TABLE R124HCR_AUX;
    EXCEPTION WHEN OTHERS THEN
	    RAISERROR 103 'Erro ao excluir registros da tabela R124HCR_AUX';
  END;
END␀Âà␀␀		SENIOR;0²␀␀

TRIGGER R124HCR_ED AFTER DELETE ON R124HCR FOR EACH ROW

DECLARE
  /* Sincronizar cursos --- */
  l_habpes   r000ass.habpes%TYPE;
  /* Busca o código da pessoa */
  CURSOR c_r034fun IS
    SELECT codpes
      FROM r034fun
     WHERE numemp = :OLD.numemp
       AND tipcol = :OLD.tipcol
       AND numcad = :OLD.numcad
       AND codpes IS NOT NULL
       AND codpes > 0;
  l_codpes   r034fun.codpes%TYPE;
  /* --------------- */  
  CREATE_TEMP_TABLE R124HCR_AUX;
  
  /* eSocial */
  l_Valor VARCHAR2(2000);
  l_EnviarCursoseSocial BOOLEAN;
  l_DataZero DATE;
  l_DataRef DATE;
  l_layout VARCHAR2(6);
  l_layoutAlteracaoContrato VARCHAR2(6);
  l_infoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
  /* --------------- */  
BEGIN
  IF ((:OLD.ORIHCR <> 'X') AND (:OLD.ORIHCR <> 'Y') AND (:OLD.ORIHCR <> 'Z')) THEN
    BEGIN
      INSERT INTO R124HCR_AUX (NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, PERINI, INDVCT, TIPOPE)
                       VALUES (:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.CODCUA, :OLD.SEQHCR, :OLD.PERINI, :OLD.INDVCT,  'E');
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'Erro na Inclusão do Colaborador na tabela Auxiliar do Histórico de Curso de Aperfeiçoamento.';
    END;
  END IF;

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116*/
  RS_UPDCURCOMP(0, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD);

  /* Verifica se deve ser sincronizado o histórico de curso do colaborador para a pessoa */
  SELECT habpes INTO l_habpes FROM r000ass;
  IF (l_habpes = 'S') THEN
    /* Busca o código da pessoa */
    FOREACH c_r034fun INTO l_codpes LOOP
      IF :OLD.seqcap IS NOT NULL THEN
        /* Exclui pela chave */
        DELETE FROM r033hap
         WHERE seqcap = :OLD.seqcap
           AND codpes = l_codpes;
      ELSE
        /* Exclui pelas características do curso */
        DELETE FROM r033hap
         WHERE codcua = :OLD.codcua
           AND perini = :OLD.perini
           AND codpes = l_codpes;
      END IF;
    END LOOP;
  END IF;
 
  /* eSocial - Início */
  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  l_EnviarCursoseSocial := FALSE;
  RH_CURSOESOCIAL(:OLD.CodCua, l_EnviarCursoseSocial OUT);
    
  l_VersaoESocial := 0;  
  IF (l_EnviarCursoseSocial = TRUE) THEN
    SP_ESOCIAL_INFO(:OLD.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
	IF (l_SimplificaoESocial = TRUE AND :OLD.SITCUA = 2) THEN
	  RH_LAYOUTCOLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layout OUT);
      IF (l_layout IS NOT NULL AND l_layout = 'S-2200') THEN
        RH_LAYOUT_ALT_CONT(l_layout, l_layoutAlteracaoContrato OUT);
        l_Valor := '';
        SP_CONCATENAR_NUM('CODCUA', :OLD.CODCUA, l_Valor OUT);
        SP_CONCATENAR_NUM('SEQHCR', :OLD.SEQHCR, l_Valor OUT);
	    SP_CONCATENAR_DES('LAYOUT', l_layoutAlteracaoContrato, l_Valor OUT);
	    SP_TREINA_ESOCIAL(l_layoutAlteracaoContrato, :OLD.NUMEMP, :OLD.TipCol, :OLD.NumCad, :OLD.PERFIM, :OLD.PERFIM, 'R124HCR', 'E', l_Valor, '', 0, 'R124HCR_EI');
	  END IF;
	END IF;	
  END IF;
  /* eSocial - Fim */
  
  BEGIN
		DELETE FROM R240TRE
		WHERE
			NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD 
			AND CODCUA = :OLD.CODCUA AND SEQHCR = :OLD.SEQHCR;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro no Delete da Tabela R240TRE. ';
	END;
END␀␀␀9.␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀¿à␀␀…¬␀␀´␀„“␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t„“␀␀␀␀␀Q␀Ü␀u␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀„“␀␀␀␀␀à$€$€$w␀Æÿ␀␀ÿ␀Y,Ì␀„“␀␀␀␀␀8@V9V9{␀Æÿ␀␀ÿ␀\ı␀␀´␀„“␀␀␀␀␀~ÿ␀␀xş␀␀xş␀␀r␀Æÿ␀␀ÿ␀`½␀␀Ñ␀„“␀␀␀␀␀]G]GáÀ␀␀qC␀êÿ␀␀ÿ␀I½␀␀Ñ␀„“␀␀␀␀␀ÔFÔFÿqC␀êÿ␀␀ÿ␀*␀p„“␀␀␀␀␀e␀Ÿ␀Ÿ␀p␀Æÿ␀␀ÿ␀¹␀␀=„“␀␀␀␀␀ğ␀␀9␀␀9␀␀+␀␀ÿ␀␀ÿ␀à␀␀„“␀␀␀␀␀!␀ ␀ ␀+␀␀ÿ␀␀ÿ␀‘␀␀Ñ␀„“␀␀␀␀␀^G^GâÀ␀␀qC␀êÿ␀␀ÿ␀!oÑ␀„“␀␀␀␀␀ÕFÕFqC␀êÿ␀␀ÿ␀b␀p„“␀␀␀␀␀f␀¡␀¡␀p␀Æÿ␀␀ÿ␀-±␀„“␀␀␀␀␀FBû¢␀␀û¢␀␀q␀Æÿ␀␀—á␀␀␀¦Ÿ␀␀±␀„“␀␀␀␀␀GBü¢␀␀ü¢␀␀q␀Æÿ␀␀—á␀␀␀␀␀␀␀␀	␀;.␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Àà␀␀ş␀␀±␀„“␀␀␀␀␀–&£ÿ␀␀£ÿ␀␀q␀Æÿ␀␀ÿ␀…¬␀␀´␀„“␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t„“␀␀␀␀␀Q␀Ü␀u␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀„“␀␀␀␀␀à$€$€$w␀Æÿ␀␀ÿ␀Y,Ì␀„“␀␀␀␀␀8@V9V9{␀Æÿ␀␀ÿ␀\ı␀␀´␀„“␀␀␀␀␀~ÿ␀␀xş␀␀xş␀␀r␀Æÿ␀␀ÿ␀`½␀␀Ñ␀„“␀␀␀␀␀]G]GáÀ␀␀qC␀êÿ␀␀ÿ␀I½␀␀Ñ␀„“␀␀␀␀␀ÔFÔFÿqC␀êÿ␀␀ÿ␀*␀p„“␀␀␀␀␀e␀Ÿ␀Ÿ␀p␀Æÿ␀␀ÿ␀¹␀␀=„“␀␀␀␀␀ğ␀␀9␀␀9␀␀+␀␀ÿ␀␀ÿ␀à␀␀„“␀␀␀␀␀!␀ ␀ ␀+␀␀ÿ␀␀ÿ␀‘␀␀Ñ␀„“␀␀␀␀␀^G^GâÀ␀␀qC␀êÿ␀␀ÿ␀!oÑ␀„“␀␀␀␀␀ÕFÕFqC␀êÿ␀␀ÿ␀b␀p„“␀␀␀␀␀f␀¡␀¡␀p␀Æÿ␀␀ÿ␀-±␀„“␀␀␀␀␀FBû¢␀␀û¢␀␀q␀Æÿ␀␀—á␀␀␀¦Ÿ␀␀±␀„“␀␀␀␀␀FBü¢␀␀ü¢␀␀q␀Æÿ␀␀—á␀␀␀␀␀␀␀␀	␀;.␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Áà␀␀…¬␀␀´␀„“␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t„“␀␀␀␀␀Q␀Ü␀u␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀„“␀␀␀␀␀à$€$€$w␀Æÿ␀␀ÿ␀Y,Ì␀„“␀␀␀␀␀8@V9V9{␀Æÿ␀␀ÿ␀\ı␀␀´␀„“␀␀␀␀␀~ÿ␀␀xş␀␀xş␀␀r␀Æÿ␀␀ÿ␀¤§␀␀o„“␀␀␀␀␀