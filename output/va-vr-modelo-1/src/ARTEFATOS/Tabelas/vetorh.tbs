		R011LAN.NUMEMP, 
		R011LAN.TIPCOL, 
		R011LAN.NUMCAD, 
		R011LAN.CODBHR,
                R011LAN.DATCMP,
                R011LAN.SINLAN,
		(R011LAN.QTDHOR - R011LAN.QTDPAG) AS QTDVEN 
FROM R011LAN 
WHERE R011LAN.ORILAN <> 'G' AND (R011LAN.QTDHOR - R011LAN.QTDPAG) <> 0 
UNION ALL
SELECT 	R011LAN.DATCMP AS DATVEN, 
		R011LAN.NUMEMP, 
		R011LAN.TIPCOL, 
		R011LAN.NUMCAD, 
		R011LAN.CODBHR, 
                R011LAN.DATCMP,
                R011LAN.SINLAN,
		R011ASS.QTDASS AS QTDVEN 
