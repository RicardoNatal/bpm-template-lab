g␀␀PROCEDURE SP_VALUPDATE_DAT(P_OLDDAT DATE,P_NEWDAT DATE,P_VALIDO IN OUT BOOLEAN)
 IS
BEGIN
  P_VALIDO := FALSE;
  IF (
  	(P_OLDDAT IS NULL AND P_NEWDAT IS NOT NULL AND (IFNULL(P_NEWDAT, DATETIME(31,12,1900,0,0,0)) <> DATETIME(31,12,1900,0,0,0)))
  	OR 
  	(p_olddat <> p_newdat AND P_OLDDAT IS NOT NULL)
  ) THEN
    P_VALIDO := TRUE;
  END IF;
END␀
ù␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
#␀␀PROCEDURE SP_VALUPDATE_DES(P_OLDDES VARCHAR2(8000),P_NEWDES VARCHAR2(8000),P_VALIDO IN OUT BOOLEAN)
 IS

	l_OLDDES_Normalizada	VARCHAR2(8000); 
	l_NEWDES_Normalizada	VARCHAR2(8000); 
BEGIN
	SP_NORMALIZA_DES(P_OLDDES, l_OLDDES_Normalizada OUT);
	SP_NORMALIZA_DES(P_NEWDES, l_NEWDES_Normalizada OUT);
  P_VALIDO := FALSE;
  IF ((P_OLDDES IS NULL AND P_NEWDES IS NOT NULL AND LENGTH(RTRIM(LTRIM(P_NEWDES))) <> 0) OR 
  	  ((l_OLDDES_Normalizada <> l_NEWDES_Normalizada) AND P_OLDDES IS NOT NULL)) THEN
    P_VALIDO := TRUE;
  END IF;
END␀ù␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE SP_VALUPDATE_NUM(P_OLDNUM NUMBER,P_NEWNUM NUMBER,P_VALIDO IN OUT BOOLEAN)
 IS
BEGIN
  P_VALIDO := FALSE;
  IF ((P_OLDNUM IS NULL AND P_NEWNUM IS NOT NULL AND P_NEWNUM <> 0) OR (P_OLDNUM <> P_NEWNUM AND P_OLDNUM IS NOT NULL)) THEN
    P_VALIDO := TRUE;
  END IF;
END␀ù␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
²PROCEDURE SP_VEICON(P_TIPOPE CHAR(1),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER(12),P_CODPRM NUMBER(5),P_DATVAL DATE,P_HORVAL NUMBER(5))
 IS
BEGIN
    NULL;
END		SENIOR;20$sp_VerOnLine
SP_VISCON
AtuSitCra
3␀␀

PROCEDURE SP_VEICON(P_TIPOPE CHAR(1),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER(12),P_CODPRM NUMBER(5),P_DATVAL DATE,P_HORVAL NUMBER(5))
 IS

l_OnLine          BOOLEAN;
    l_numcra          NUMBER(12);
    l_DatIni          DATE;
    l_HorIni          NUMBER(5);
    l_BloAut          VARCHAR2(1);
    l_TipPev          NUMBER(1);
    l_TipVis          NUMBER(3);
    l_NumEmp          NUMBER(4);
    l_TipCol          NUMBER(1);
    l_NumCad          NUMBER(9);
    l_Subnv           NUMBER(1);
    l_CreAcc          NUMBER(1);
    l_Data_Zero       DATE;
    l_Hora_Atual      NUMBER(4);
    l_Data_Atual      DATE;
    l_SeqEnt          NUMBER(2);
BEGIN
    SP_VerOnLine(l_OnLine OUT);
    IF (l_OnLine = TRUE) THEN
        l_Data_Zero  := '31/12/1900,00:00:00';
        l_Hora_Atual := HOUR(CURTIME()) * 60 + MINUTE(CURTIME());
        l_Data_Atual := CURDATE();

        /* Se for um histórico válido */
        IF ((p_DatVal > l_Data_Atual) OR ((p_DatVal = l_Data_Atual) AND (p_HorVal >= l_Hora_Atual)) OR
            (p_DatVal = l_Data_Zero)) THEN

            l_NumCra := p_NumCra;

            IF ((p_TipOpe = 'I') OR (p_TipOpe = 'U')) THEN

                BEGIN
                    SELECT DATINI, MAX(HORINI), MAX(SEQENT)
                    INTO l_DatIni, l_HorIni, l_SeqEnt
                    FROM R090HCH A
                    WHERE A.TIPDOC = p_TipDoc
                    AND A.NUMDOC = p_NumDoc
                    AND A.NUMCRA=l_NumCra AND
                    (A.DATINI < l_data_atual OR
                    (A.DATINI = l_data_atual AND A.HORINI <= l_hora_atual)) AND
                    (A.DATFIM = l_data_zero OR
                     A.DATFIM > l_data_atual OR
                   (A.DATFIM = l_data_atual AND A.HORFIM >= l_hora_atual)) GROUP BY DATINI;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN l_NumCra := 0;
                    WHEN OTHERS THEN RAISERROR 103 'SPVEICON: Erro No SELECT R090HCH.';
                END;

                IF (l_NumCra > 0) THEN
                    l_BloAut := '0';
                    l_TipPev := 1;  /* Visitante */
                    l_TipVis := 0;
                    l_NumEmp := 0;
                    l_TipCol := 0;
                    l_NumCad := 0;
                    l_Subnv  := 1;  /* Sempre inicializa a controle toda */
                    l_CreAcc := 1;

                    SP_VISCON(p_TipDoc, p_NumDoc, l_NumCra, p_CodPrm, l_DatIni, l_HorIni, p_DatVal, p_HorVal,
                              l_BloAut, l_TipPev, l_TipVis, l_NumEmp, l_TipCol, l_NumCad, l_Subnv, l_CreAcc, NULL);
                END IF;
            ELSE
                IF (p_TipOpe = 'D') THEN
                    AtuSitCra('1', l_NumCra);
                END IF;
            END IF;
        END IF;
    END IF;
END		SENIOR;21$sp_VerOnLine
SP_VISCON
AtuSitCra
3␀␀

PROCEDURE SP_VEICON(P_TIPOPE CHAR(1),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER(12),P_CODPRM NUMBER(5),P_DATVAL DATE,P_HORVAL NUMBER(5))
 IS

l_OnLine          BOOLEAN;
    l_numcra          NUMBER(12);
    l_DatIni          DATE;
    l_HorIni          NUMBER(5);
    l_BloAut          VARCHAR2(1);
    l_TipPev          NUMBER(1);
    l_TipVis          NUMBER(3);
    l_NumEmp          NUMBER(4);
    l_TipCol          NUMBER(1);
    l_NumCad          NUMBER(9);
    l_Subnv           NUMBER(1);
    l_CreAcc          NUMBER(1);
    l_Data_Zero       DATE;
    l_Hora_Atual      NUMBER(4);
    l_Data_Atual      DATE;
    l_SeqEnt          NUMBER(2);
BEGIN
    SP_VerOnLine(l_OnLine OUT);
    IF (l_OnLine = TRUE) THEN
        l_Data_Zero  := '31/12/1900,00:00:00';
        l_Hora_Atual := HOUR(CURTIME()) * 60 + MINUTE(CURTIME());
        l_Data_Atual := CURDATE();

        /* Se for um histórico válido */
        IF ((p_DatVal > l_Data_Atual) OR ((p_DatVal = l_Data_Atual) AND (p_HorVal >= l_Hora_Atual)) OR
            (p_DatVal = l_Data_Zero)) THEN

            l_NumCra := p_NumCra;

            IF ((p_TipOpe = 'I') OR (p_TipOpe = 'U')) THEN

                BEGIN
                    SELECT DATINI, MAX(HORINI), MAX(SEQENT)
                    INTO l_DatIni, l_HorIni, l_SeqEnt
                    FROM R090HCH A
                    WHERE A.TIPDOC = p_TipDoc
                    AND A.NUMDOC = p_NumDoc
                    AND A.NUMCRA=l_NumCra AND
                    (A.DATINI < l_data_atual OR
                    (A.DATINI = l_data_atual AND A.HORINI <= l_hora_atual)) AND
                    (A.DATFIM = l_data_zero OR
                     A.DATFIM > l_data_atual OR
                   (A.DATFIM = l_data_atual AND A.HORFIM >= l_hora_atual)) GROUP BY DATINI;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN l_NumCra := 0;
                    WHEN OTHERS THEN RAISERROR 103 'SPVEICON: Erro No SELECT R090HCH.';
                END;

                IF (l_NumCra > 0) THEN
                    l_BloAut := '0';
                    l_TipPev := 1;  /* Visitante */
                    l_TipVis := 0;
                    l_NumEmp := 0;
                    l_TipCol := 0;
                    l_NumCad := 0;
                    l_Subnv  := 1;  /* Sempre inicializa a controle toda */
                    l_CreAcc := 1;

                    SP_VISCON(p_TipDoc, p_NumDoc, l_NumCra, p_CodPrm, l_DatIni, l_HorIni, p_DatVal, p_HorVal,
                              l_BloAut, l_TipPev, l_TipVis, l_NumEmp, l_TipCol, l_NumCad, l_Subnv, l_CreAcc, NULL);
                END IF;
            ELSE
                IF (p_TipOpe = 'D') THEN
                    AtuSitCra('1', l_NumCra);
                END IF;
            END IF;
        END IF;
    END IF;
END		SENIOR;22$sp_VerOnLine
SP_VISCON
AtuSitCra
