DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  l_codSistema := 1;
  l_codcpa := 135;  /* Código da categoria de auditoria - Histórico de Remanejamento - Acompanhamento*/
  l_codtpa := 401;  /* Código do tipo de auditoria - Inclusão*/

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110HRA_AI', '');

    /* Insere os campos chave na tabela de auditoria R995PRC*/
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIC));
      SP_DATSTR(:NEW.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      SP_DATSTR(:NEW.DATACO, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATACO', l_datTemp);      
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110HRA_AI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    /* Insere os valores dos campos na tabela de auditoria R995PRT*/
    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
      SP_DATSTR(:NEW.DATPER, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPER', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPAR', CONVERT(NUMBER_TO_CHAR, :NEW.CODPAR));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSACO', :NEW.OBSACO);
    END;
  END IF;
END␀aß␀␀		SENIOR;0·	␀␀

TRIGGER R110HRA_AU
AFTER UPDATE ON R110HRA
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  IF (
  :OLD.DATPER <>:NEW.DATPER OR 
  :OLD.CODPAR <>:NEW.CODPAR OR 
  :OLD.OBSACO <>:NEW.OBSACO
  ) THEN
    l_codSistema:= 1;
    l_codcpa:= 135;  /* Código da categoria de auditoria - Histórico de Remanejamento - Acompanhamento*/
    l_codtpa:= 402;  /* Código do tipo de auditoria - Alteração*/

    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110HRA_AU', '');

      /* Insere os campos chave na tabela de auditoria R995PRC*/
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:OLD.CODFIC));
        SP_DATSTR(:OLD.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
        SP_DATSTR(:OLD.DATACO, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATACO', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110HRA_AU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      /* Insere os valores dos campos na tabela de auditoria R995PRT*/
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
        SP_DATSTR(:OLD.DATPER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATPER', l_datTemp);
        SP_DATSTR(:NEW.DATPER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATPER', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPAR', CONVERT(NUMBER_TO_CHAR,:OLD.CODPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPAR', CONVERT(NUMBER_TO_CHAR,:NEW.CODPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSACO',:OLD.OBSACO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSACO',:NEW.OBSACO);
      END;
    END IF;
  END IF;
END␀_ß␀␀		SENIOR;0␀␀

