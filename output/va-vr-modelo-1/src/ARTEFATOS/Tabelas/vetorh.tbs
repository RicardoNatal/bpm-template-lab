              SP_RETLOGPEN(l_logpen);
              INSERT INTO R070ADM (CODADM,DATENV,HORENV,DIRSVR,VALSTR,RETPEN,QTDTEN,CICATU,NUMFIS,CODCMD,STACMD,SEQENV,NUMCRA,IDTPES,VERRON,LOGPEN) VALUES  (SEQ_R070ADM.nextval,l_datenv,l_horenv,l_dirsvr,l_straux,l_retpen,0,0,l_numfis, l_CodTraduzido, l_stacmd,l_seqenv,l_numcra,l_idtpes,NULL,l_logpen);
            exception
              when OTHERS then
                NULL;
                raise_application_error(-20000 + -(103),'SP_PORCOM: Erro na inserção da pendência na R070ADM Insert 1.');
            end;
          end if;
        exception
          when OTHERS then
            NULL;
        end;
      end if;
      if (l_cenpen='FIM') then
        exit;
      end if;
    end loop;
  end if;
end SP_PORCOM;
