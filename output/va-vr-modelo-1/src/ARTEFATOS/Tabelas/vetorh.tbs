    l_contfai := 0;
    LOOP
        IF  (l_contfai >= l_lengfai) THEN
            EXIT;
        END IF;
        l_faidom_ace := l_faidom_ace || '24002400';
        l_contfai := l_contfai + 1;
    END LOOP;

    l_faiseg_ace := IFNULL(l_faiseg_ace,'');
