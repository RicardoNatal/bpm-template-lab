BEGIN
BEGIN
    IF (:NEW.DESREI <> :OLD.DESREI) THEN
      UPDATE R235REC SET NOMREI = :NEW.DESREI
       WHERE R235REC.TIPREC = 3 /* LTpoRec = 3 -> Recurso Instrucional */
         AND R235REC.CODREI = :NEW.CODREI;
    END IF;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao atualizar a tabela R235REC com o nome do recurso instrucional.';
  END;
