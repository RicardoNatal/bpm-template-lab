/* UPDATE (OLD/NEW) */
TRIGGER R042RCM_EU AFTER UPDATE ON R042RCM FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs R042RCM - Rescisão Mestre*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 34;     /* R042RCM - Rescisão Mestre*/
  l_codtpa := 180;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatDem <> :NEW.DatDem)
   OR (:OLD.CauDem <> :NEW.CauDem)
   OR (:OLD.IndRem <> :NEW.IndRem)
   OR (:OLD.FimQua <> :NEW.FimQua)
   OR (:OLD.CodRmd <> :NEW.CodRmd)
   OR (:OLD.DatAvi <> :NEW.DatAvi)
   OR (:OLD.FinAvi <> :NEW.FinAvi)
   OR (:OLD.DatPag <> :NEW.DatPag)
   OR (:OLD.FimCtt <> :NEW.FimCtt)
   OR (:OLD.QtdInd <> :NEW.QtdInd)
   OR (:OLD.QtdRea <> :NEW.QtdRea)
   OR (:OLD.QtdSsl <> :NEW.QtdSsl)
   OR (:OLD.QtdGra <> :NEW.QtdGra)
   OR (:OLD.QtdEst <> :NEW.QtdEst)
   OR (:OLD.PerInd <> :NEW.PerInd)
   OR (:OLD.QtdFca <> :NEW.QtdFca)
   OR (:OLD.DatCtb <> :NEW.DatCtb)
   OR (:OLD.SalFav <> :NEW.SalFav)
   OR (:OLD.SldFgt <> :NEW.SldFgt)
   OR (:OLD.FgtAnt <> :NEW.FgtAnt)
   OR (:OLD.CodSaq <> :NEW.CodSaq)
   OR (:OLD.ComRes <> :NEW.ComRes)
   OR (:OLD.BinSld <> :NEW.BinSld)
   OR (:OLD.Bin13s <> :NEW.Bin13s)
   OR (:OLD.BirSld <> :NEW.BirSld)
   OR (:OLD.AirSld <> :NEW.AirSld)
   OR (:OLD.Bir13s <> :NEW.Bir13s)
   OR (:OLD.Air13s <> :NEW.Air13s)
   OR (:OLD.BirFer <> :NEW.BirFer)
   OR (:OLD.AirFer <> :NEW.AirFer)
   OR (:OLD.BirPar <> :NEW.BirPar)
   OR (:OLD.BasFgt <> :NEW.BasFgt)
   OR (:OLD.AbaFgt <> :NEW.AbaFgt)
   OR (:OLD.BasFgd <> :NEW.BasFgd)
   OR (:OLD.AbaFgd <> :NEW.AbaFgd)
   OR (:OLD.BaApFg <> :NEW.BaApFg)
   OR (:OLD.AfgInd <> :NEW.AfgInd)
   OR (:OLD.BaApFd <> :NEW.BaApFd)
   OR (:OLD.AfgI13 <> :NEW.AfgI13)
   OR (:OLD.TotPro <> :NEW.TotPro)
   OR (:OLD.TotDes <> :NEW.TotDes)
   OR (:OLD.IntRcs <> :NEW.IntRcs)
   OR (:OLD.QtdDsr <> :NEW.QtdDsr)
   OR (:OLD.TotVan <> :NEW.TotVan)
   OR (:OLD.MaiRem <> :NEW.MaiRem)
   OR (:OLD.RepVag <> :NEW.RepVag)
   OR (:OLD.PenFGT <> :NEW.PenFGT)
   OR (:OLD.SalBas <> :NEW.SalBas)
   OR (:OLD.AviPre <> :NEW.AviPre)
   OR (:OLD.BinTot <> :NEW.BinTot)
   OR (:OLD.Bin13t <> :NEW.Bin13t)
   OR (:OLD.StaPrg <> :NEW.StaPrg)
   OR (:OLD.BipSld <> :NEW.BipSld)
   OR (:OLD.Bip13s <> :NEW.Bip13s)
   OR (:OLD.JorSem <> :NEW.JorSem)
   OR (:OLD.SabCom <> :NEW.SabCom)
   OR (:OLD.BipTot <> :NEW.BipTot)
   OR (:OLD.Bip13t <> :NEW.Bip13t)
   OR (:OLD.QtdIAc <> :NEW.QtdIAc)
   OR (:OLD.QtdRAc <> :NEW.QtdRAc)
   OR (:OLD.VlrERA <> :NEW.VlrERA)
   OR (:OLD.TerQui <> :NEW.TerQui)
   OR (:OLD.AteObi <> :NEW.AteObi)
   OR (:OLD.ProTra <> :NEW.ProTra)
   OR (:OLD.BFgtAn <> :NEW.BFgtAn)
   OR (:OLD.BFgDAn <> :NEW.BFgDAn)
   OR (:OLD.BaIFgt <> :NEW.BaIFgt)
   OR (:OLD.BaIFgd <> :NEW.BaIFgd)
   OR (:OLD.ValIns <> :NEW.ValIns)
   OR (:OLD.ApoEsp <> :NEW.ApoEsp)
   OR (:OLD.PagCLT <> :NEW.PagCLT)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R042RCM_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R042RCM_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:OLD.DATDEM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATDEM', l_datTemp);
        SP_DATSTR(:NEW.DATDEM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATDEM', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCAUDEM', CONVERT(NUMBER_TO_CHAR, :OLD.CAUDEM));
