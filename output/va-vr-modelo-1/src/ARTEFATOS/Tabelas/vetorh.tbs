      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERDCO', CONVERT(NUMBER_TO_CHAR, :OLD.PERDCO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERREM', CONVERT(NUMBER_TO_CHAR, :OLD.PERREM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TEMLIM', :OLD.TEMLIM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRO', CONVERT(NUMBER_TO_CHAR, :OLD.CODPRO));
      END;
  END IF; 
END␀␀␀n␀␀␀␀␀␀␀␀␀␀␀BÒ␀␀°,±␀	Ôï!␀␀␀␀␀„@Çtìtq␀Æÿ␀␀QÒ␀␀␀…¬␀␀´␀	Ôï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀␀␀␀0;1␀␀ît␀␀␀CÒ␀␀…¬␀␀´␀	Ôÿ1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀—,¼␀	Ôÿ1␀␀␀␀␀=nnX)␀␀Æÿ␀␀!#␀Œ␀à	Ôÿ1␀␀␀␀␀¹␀j␀j␀n␀Æÿ␀␀JÒ␀␀␀ôDÑ␀	Ôÿ1␀␀␀␀␀™JĞşEqC␀êÿ␀␀FÒ␀␀␀Şm¼␀␀␀␀␀␀␀/n£aKbX)␀␀Æÿ␀␀!#␀,±␀␀␀␀␀␀␀k;Ëpq@q␀Æÿ␀␀[Ñ␀␀␀«Á␀␀␀␀␀␀␀¯:«¯:y␀Æÿ␀␀ÿ␀¹½␀␀¹␀␀␀␀␀␀␀3¾␀␀hlQ)␀␀Æÿ␀␀ÿ␀#í␀␀¹␀␀␀␀␀␀␀ì␀␀ì␀␀ì␀␀Q)␀␀Æÿ␀␀ÿ␀Á½␀␀¹␀␀␀␀␀␀␀4¾␀␀kkQ)␀␀Æÿ␀␀ÿ␀½␀␀Ä␀␀␀␀␀␀␀G½␀␀FS)␀␀Æÿ␀␀ÿ␀g½␀␀¹␀␀␀␀␀␀␀***Q)␀␀Æÿ␀␀ÿ␀ì)Å␀␀␀␀␀␀$$$c␀␀␀ÿ␀␀ÿ␀ƒ²␀␀o␀␀␀␀␀␀{´␀␀H&H&i␀␀ÿ␀␀ÿ␀„²␀␀o␀␀␀␀␀␀I&I&I&i␀␀ÿ␀␀ÿ␀…²␀␀o␀␀␀␀␀␀J&J&J&i␀␀ÿ␀␀ÿ␀†²␀␀o␀␀␀␀␀␀K&K&K&i␀␀ÿ␀␀ÿ␀ÅlÄ␀␀␀␀␀␀␀ÖlÖlÖlS)␀␀Æÿ␀␀ÿ␀É<␀␀␀␀␀␀ÒÒÒc␀␀␀ÿ␀␀ÿ␀§½␀␀¹␀␀␀␀␀␀␀xxxQ)␀␀Æÿ␀␀ÿ␀T‘␀␀␀␀␀␀bZ_Z_Zn␀Æÿ␀␀ÿ1½␀␀¹␀␀␀␀␀␀␀wwwQ)␀␀Æÿ␀␀ÿ␀IÆ␀␀Ì␀Ôÿ1␀␀␀␀␀á±␀␀Ğ¯␀␀Ğ¯␀␀l␀Æÿ␀␀1#␀,Æ␀␀Ì␀Ôÿ1␀␀␀␀␀à±␀␀Í¯␀␀Í¯␀␀l␀Æÿ␀␀1#␀»-´␀Ôÿ1␀␀␀␀␀’?"<#<r␀Æÿ␀␀ÿ0000Ğ
␀´␀Ôÿ1␀␀␀␀␀‘?|:}:r␀Æÿ␀␀ÿ0000³␀␀Ôÿ1␀␀␀␀␀<<<)␀␀	Æÿ␀␀ˆÒ␀␀␀°␀␀Ôÿ1␀␀␀␀␀<<<)␀␀	Æÿ␀␀ˆÒ␀␀␀␀␀DÒ␀␀␀␀EÒ␀␀␀␀0;1;2;3HÒ␀␀		SENIOR;0Î␀␀TRIGGER R030GRP_EI BEFORE INSERT ON R030GRP FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);
  l_ProximaData DATE;
  l_Where VARCHAR(2000);
  l_EmpresaStr VARCHAR(11);
  l_FilialStr VARCHAR(11);
  l_TipoGpsStr VARCHAR(11);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);  
  l_infoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN 
  /*e-Social -> S-1000, S-1005, S-1080 e S-1020*/
  l_Valor := '';
  l_ProximaData := DATETIME(30, 12, 1900, 0, 0, 0);
  l_infoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;

  /* Só monitora o campo se o cliente opta por enviar as informações facultativas	*/
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);

  IF (:NEW.TIPGRP = 1) THEN 	   
    l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP);
    l_FilialStr := CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL);
    l_TipoGpsStr := CONVERT(NUMBER_TO_CHAR, :NEW.TIPGRP);

    l_Where := 'NUMEMP = ' ||  l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr || ' AND TIPGRP = ' || l_TipoGpsStr;    
    SP_PROXIMOHIST('DATGRP', 'R030GRP', l_Where, :NEW.DATGRP, l_ProximaData OUT);
    SP_CONCATENAR_NUM('CODFIL', :NEW.CODFIL, l_Valor OUT);
    SP_CONCATENAR_NUM('TIPGRP', :NEW.TIPGRP, l_Valor OUT);    
	
    SP_E_SOCIAL('S-1000', 'R030GRP', 'T', 'I', :NEW.DATGRP, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030GRP_EI');
    SP_E_SOCIAL('S-1005', 'R030GRP', 'T', 'I', :NEW.DATGRP, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030GRP_EI');
    IF (l_SimplificaoESocial = false) THEN	
    	SP_E_SOCIAL('S-1080', 'R030GRP', 'T', 'I', :NEW.DATGRP, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030GRP_EI');
    END IF;
    SP_E_SOCIAL('S-1020', 'R030GRP', 'T', 'I', :NEW.DATGRP, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030GRP_EI');
  END IF;
  /*e-Social -> S-1000, S-1005, S-1080 e S-1020*/
  
  
  /* Geração de logs - Filiais da Empresa - GRPS */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 50;     /* Filiais da Empresa - GRPS */
  l_codtpa := 211;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030GRP_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPGRP', CONVERT(NUMBER_TO_CHAR, :NEW.TIPGRP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATGRP', CONVERT(DATE_TO_CHAR, :NEW.DATGRP));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030GRP_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FILEMP', CONVERT(NUMBER_TO_CHAR, :NEW.FILEMP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFPA', CONVERT(NUMBER_TO_CHAR, :NEW.CODFPA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ACITRA', CONVERT(NUMBER_TO_CHAR, :NEW.ACITRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERSAT', CONVERT(NUMBER_TO_CHAR, :NEW.PERSAT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RATNAE', CONVERT(NUMBER_TO_CHAR, :NEW.RATNAE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERSLI', CONVERT(NUMBER_TO_CHAR, :NEW.PERSLI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERCON', CONVERT(NUMBER_TO_CHAR, :NEW.PERCON));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERISE', CONVERT(NUMBER_TO_CHAR, :NEW.PERISE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CGCCAB', :NEW.CGCCAB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OB1GRP', :NEW.OB1GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OB2GRP', :NEW.OB2GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OB3GRP', :NEW.OB3GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OB4GRP', :NEW.OB4GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FATFAP', CONVERT(NUMBER_TO_CHAR, :NEW.FATFAP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'APLFAP', :NEW.APLFAP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERRED', CONVERT(NUMBER_TO_CHAR, :NEW.PERRED));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESFOL', CONVERT(NUMBER_TO_CHAR, :NEW.DESFOL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERDES', CONVERT(NUMBER_TO_CHAR, :NEW.PERDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRORAT', CONVERT(NUMBER_TO_CHAR, :NEW.PRORAT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PROFAP', CONVERT(NUMBER_TO_CHAR, :NEW.PROFAP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTER', CONVERT(NUMBER_TO_CHAR, :NEW.CODTER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TERSUS', CONVERT(NUMBER_TO_CHAR, :NEW.TERSUS));
      END;
  END IF; 
END␀IÒ␀␀		SENIOR;0 3␀␀

TRIGGER R030GRP_EU BEFORE UPDATE ON R030GRP FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);  
  l_Valido BOOLEAN;
  l_ProximaData DATE;
  l_AlterouRegistro_S1000 BOOLEAN;
  l_AlterouRegistro_S1005 BOOLEAN;  
  l_AlterouRegistro_S1080 BOOLEAN;
  l_AlterouRegistro_S1020 BOOLEAN;
  l_Where VARCHAR(2000);
  l_EmpresaStr VARCHAR(11);
  l_FilialStr VARCHAR(11);
  l_TipoGpsStr VARCHAR(5);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_tipFil       VARCHAR(1);
  l_infoFacult         BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN 
  /*e-Social -> S-1000, S-1005, S-1080 e S-1020*/ 
  l_Valor := '';
  l_ProximaData := DATETIME(30, 12, 1900, 0, 0, 0);
  l_AlterouRegistro_S1000 := FALSE;
  l_AlterouRegistro_S1005 := FALSE;
  l_AlterouRegistro_S1080 := FALSE;
  l_AlterouRegistro_S1020 := FALSE;
  l_VersaoESocial := 0;
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
    
  SP_VALUPDATE_NUM(:OLD.DESFOL, :NEW.DESFOL, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    RH_RETTIPFIL(:NEW.NUMEMP, :NEW.CODFIL, l_tipFil OUT);
    IF (l_tipFil = 'M') OR (l_tipFil = 'E') THEN
      l_AlterouRegistro_S1000 := TRUE;
    END IF;
    IF (l_tipFil = 'O') THEN  
      l_AlterouRegistro_S1005 := TRUE;
    END IF;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.PRORAT, :NEW.PRORAT, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1005 := TRUE;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.PROFAP, :NEW.PROFAP, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1005 := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.FATFAP, :NEW.FATFAP, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1005 := TRUE;
    IF (l_SimplificaoESocial = FALSE) THEN
      l_AlterouRegistro_S1080 := TRUE;
    ELSE
      l_AlterouRegistro_S1020 := TRUE;
    END IF;
  END IF;

  SP_VALUPDATE_NUM(:OLD.RATNAE, :NEW.RATNAE, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
	IF (l_SimplificaoESocial = FALSE OR	(:NEW.PRORAT IS NOT NULL AND LENGTH(RTRIM(LTRIM(CONVERT(NUMBER_TO_CHAR, :NEW.PRORAT)))) <> 0)) THEN
      l_AlterouRegistro_S1005 := TRUE;
  	END IF;
    IF (l_SimplificaoESocial = FALSE) THEN
      l_AlterouRegistro_S1080 := TRUE;
    ELSE
      l_AlterouRegistro_S1020 := TRUE;
    END IF;
  END IF;

  SP_VALUPDATE_NUM(:OLD.PERSLI, :NEW.PERSLI, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
	l_AlterouRegistro_S1005 := TRUE;
  END IF;
	  
  IF (l_SimplificaoESocial = FALSE) THEN
    SP_VALUPDATE_DES(:OLD.APLFAP, :NEW.APLFAP, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S1080 := TRUE;
    END IF;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.CODFPA, :NEW.CODFPA, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1020 := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.CODTER, :NEW.CODTER, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1020 := TRUE;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.TERSUS, :NEW.TERSUS, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1020 := TRUE;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.SUSRAT, :NEW.SUSRAT, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1005 := TRUE;
  END IF;  
  
  SP_VALUPDATE_NUM(:OLD.SUSFAP, :NEW.SUSFAP, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1005 := TRUE;
  END IF;  
    
  IF (l_AlterouRegistro_S1000 = TRUE) OR (l_AlterouRegistro_S1005 = TRUE) OR (l_AlterouRegistro_S1080 = TRUE) OR (l_AlterouRegistro_S1020 = TRUE) THEN	

    IF (:NEW.TIPGRP = 1) THEN
      l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP);
      l_FilialStr := CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL);
      l_TipoGpsStr := CONVERT(NUMBER_TO_CHAR, :OLD.TIPGRP);

      l_Where := 'NUMEMP = ' || l_EmpresaStr  || ' AND CODFIL = ' || l_FilialStr || ' AND TIPGRP = ' || l_TipoGpsStr;
      SP_PROXIMOHIST('DATGRP', 'R030GRP', l_Where, :NEW.DATGRP, l_ProximaData OUT);
      SP_CONCATENAR_NUM('CODFIL', :NEW.CODFIL, l_Valor OUT);
      SP_CONCATENAR_NUM('TIPGRP', :NEW.TIPGRP, l_Valor OUT);      
	  
      /* Envia Leiaute S-1000 */
      IF (l_AlterouRegistro_S1000 = TRUE) THEN
        SP_E_SOCIAL('S-1000', 'R030GRP', 'T', 'A', :NEW.DATGRP, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030GRP_EU');
      END IF;
	
      /* Envia Leiaute S-1005 */		
      IF (l_AlterouRegistro_S1005 = TRUE) THEN	
        SP_E_SOCIAL('S-1005', 'R030GRP', 'T', 'A', :NEW.DATGRP, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030GRP_EU');
      END IF;
	
      /* Envia Leiaute S-1080 */		
      IF (l_AlterouRegistro_S1080 = TRUE) THEN
        SP_E_SOCIAL('S-1080', 'R030GRP', 'T', 'A', :NEW.DATGRP, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030GRP_EU');
      END IF;

      /* Envia Leiaute S-1020 */		
      IF (l_AlterouRegistro_S1020 = TRUE) THEN
        SP_E_SOCIAL('S-1020', 'R030GRP', 'T', 'A', :NEW.DATGRP, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030GRP_EU');
      END IF;
    END IF;
  END IF;
  /*e-Social -> S-1000, S-1005, S-1080 e S-1020*/
  
  
  
  /* Geração de logs - Filiais da Empresa - GRPS */
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 50;     /* Filiais da Empresa - GRPS */
  l_codtpa := 212;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFil <> :NEW.CodFil)
   OR (:OLD.TipGrp <> :NEW.TipGrp)
   OR (:OLD.DatGrp <> :NEW.DatGrp)
   OR (:OLD.FilEmp <> :NEW.FilEmp)
   OR (:OLD.CodFpa <> :NEW.CodFpa)
   OR (:OLD.AciTra <> :NEW.AciTra)
   OR (:OLD.PerSat <> :NEW.PerSat)
   OR (:OLD.RATNAE <> :NEW.RATNAE)
   OR (:OLD.PerSli <> :NEW.PerSli)
   OR (:OLD.PerCon <> :NEW.PerCon)
   OR (:OLD.PerIse <> :NEW.PerIse)
   OR (:OLD.CgcCab <> :NEW.CgcCab)
   OR (:OLD.Ob1Grp <> :NEW.Ob1Grp)
   OR (:OLD.Ob2Grp <> :NEW.Ob2Grp)
   OR (:OLD.Ob3Grp <> :NEW.Ob3Grp)
   OR (:OLD.Ob4Grp <> :NEW.Ob4Grp)
   OR (:OLD.FatFap <> :NEW.FatFap)
   OR (:OLD.AplFap <> :NEW.AplFap)
   OR (:OLD.PerRed <> :NEW.PerRed)
   OR (:OLD.DesFol <> :NEW.DesFol)
   OR (:OLD.PerDes <> :NEW.PerDes)
   OR (:OLD.ProRAT <> :NEW.ProRAT)
   OR (:OLD.ProRAT <> :NEW.SUSRAT)
   OR (:OLD.ProFAP <> :NEW.ProFAP)
   OR (:OLD.ProRAT <> :NEW.SUSFAP)
   OR (:OLD.CodTer <> :NEW.CodTer)
   OR (:OLD.TerSus <> :NEW.TerSus)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030GRP_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPGRP', CONVERT(NUMBER_TO_CHAR, :OLD.TIPGRP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATGRP', CONVERT(DATE_TO_CHAR, :OLD.DATGRP));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030GRP_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFILEMP', CONVERT(NUMBER_TO_CHAR, :OLD.FILEMP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFILEMP', CONVERT(NUMBER_TO_CHAR, :NEW.FILEMP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODFPA', CONVERT(NUMBER_TO_CHAR, :OLD.CODFPA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODFPA', CONVERT(NUMBER_TO_CHAR, :NEW.CODFPA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDACITRA', CONVERT(NUMBER_TO_CHAR, :OLD.ACITRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWACITRA', CONVERT(NUMBER_TO_CHAR, :NEW.ACITRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERSAT', CONVERT(NUMBER_TO_CHAR, :OLD.PERSAT));        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERSAT', CONVERT(NUMBER_TO_CHAR, :NEW.PERSAT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDRATNAE', CONVERT(NUMBER_TO_CHAR, :OLD.RATNAE));        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWRATNAE', CONVERT(NUMBER_TO_CHAR, :NEW.RATNAE));        
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERSLI', CONVERT(NUMBER_TO_CHAR, :OLD.PERSLI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERSLI', CONVERT(NUMBER_TO_CHAR, :NEW.PERSLI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERCON', CONVERT(NUMBER_TO_CHAR, :OLD.PERCON));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERCON', CONVERT(NUMBER_TO_CHAR, :NEW.PERCON));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERISE', CONVERT(NUMBER_TO_CHAR, :OLD.PERISE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERISE', CONVERT(NUMBER_TO_CHAR, :NEW.PERISE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCGCCAB', :OLD.CGCCAB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCGCCAB', :NEW.CGCCAB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOB1GRP', :OLD.OB1GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOB1GRP', :NEW.OB1GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOB2GRP', :OLD.OB2GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOB2GRP', :NEW.OB2GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOB3GRP', :OLD.OB3GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOB3GRP', :NEW.OB3GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOB4GRP', :OLD.OB4GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOB4GRP', :NEW.OB4GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFATFAP', CONVERT(NUMBER_TO_CHAR, :OLD.FATFAP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFATFAP', CONVERT(NUMBER_TO_CHAR, :NEW.FATFAP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAPLFAP', :OLD.APLFAP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAPLFAP', :NEW.APLFAP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERRED', CONVERT(NUMBER_TO_CHAR, :OLD.PERRED));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERRED', CONVERT(NUMBER_TO_CHAR, :NEW.PERRED));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDESFOL', CONVERT(NUMBER_TO_CHAR, :OLD.DESFOL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDESFOL', CONVERT(NUMBER_TO_CHAR, :NEW.DESFOL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERDES', CONVERT(NUMBER_TO_CHAR, :OLD.PERDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERDES', CONVERT(NUMBER_TO_CHAR, :NEW.PERDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRORAT', CONVERT(NUMBER_TO_CHAR, :OLD.PRORAT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRORAT', CONVERT(NUMBER_TO_CHAR, :NEW.PRORAT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSUSRAT', CONVERT(NUMBER_TO_CHAR, :OLD.SUSRAT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSUSRAT', CONVERT(NUMBER_TO_CHAR, :NEW.SUSRAT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPROFAP', CONVERT(NUMBER_TO_CHAR, :OLD.PROFAP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPROFAP', CONVERT(NUMBER_TO_CHAR, :NEW.PROFAP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSUSFAP', CONVERT(NUMBER_TO_CHAR, :OLD.SUSFAP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSUSFAP', CONVERT(NUMBER_TO_CHAR, :NEW.SUSFAP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODTER', CONVERT(NUMBER_TO_CHAR, :OLD.CODTER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODTER', CONVERT(NUMBER_TO_CHAR, :NEW.CODTER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTERSUS', CONVERT(NUMBER_TO_CHAR, :OLD.TERSUS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTERSUS', CONVERT(NUMBER_TO_CHAR, :NEW.TERSUS));
      END;
    END IF; 
  END IF; 
END␀GÒ␀␀		SENIOR;0Ê␀␀

TRIGGER R030GRP_ED BEFORE DELETE ON R030GRP FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);
  l_ProximaData DATE;
  l_Where VARCHAR(2000);
  l_EmpresaStr VARCHAR(11);
  l_FilialStr VARCHAR(11);
  l_TipoGpsStr VARCHAR(11);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_infoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN 
  /*e-Social -> S-1000, S-1005, S-1080 e S-1020*/ 
  l_Valor := '';
  l_ProximaData := DATETIME(30, 12, 1900, 0, 0, 0);
  l_infoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;

  /* Só monitora o campo se o cliente opta por enviar as informações facultativas	*/
  SP_ESOCIAL_INFO(:OLD.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  
  IF (:OLD.TIPGRP = 1) THEN 
    l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP);
    l_FilialStr := CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL);
    l_TipoGpsStr := CONVERT(NUMBER_TO_CHAR, :OLD.TIPGRP);

    l_Where := 'NUMEMP = ' ||  l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr || ' AND TIPGRP = ' || l_TipoGpsStr;
    SP_PROXIMOHIST('DATGRP', 'R030GRP', l_Where, :OLD.DATGRP, l_ProximaData OUT);
    SP_CONCATENAR_NUM('CODFIL', :OLD.CODFIL, l_Valor OUT);
    SP_CONCATENAR_NUM('TIPGRP', :OLD.TIPGRP, l_Valor OUT);
	
    SP_E_SOCIAL('S-1000', 'R030GRP', 'T', 'E', :OLD.DATGRP, l_ProximaData, :OLD.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030GRP_ED');
    SP_E_SOCIAL('S-1005', 'R030GRP', 'T', 'E', :OLD.DATGRP, l_ProximaData, :OLD.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030GRP_ED');
    IF (l_SimplificaoESocial = FALSE) THEN
    	SP_E_SOCIAL('S-1080', 'R030GRP', 'T', 'E', :OLD.DATGRP, l_ProximaData, :OLD.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030GRP_ED');
    END IF;
    SP_E_SOCIAL('S-1020', 'R030GRP', 'T', 'E', :OLD.DATGRP, l_ProximaData, :OLD.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030GRP_ED');
  END IF;
  /*e-Social -> S-1000, S-1005, S-1080 e S-1020*/
  
  
  
  /* Geração de logs - Filiais da Empresa - GRPS */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 50;     /* Filiais da Empresa - GRPS */
  l_codtpa := 211;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030GRP_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPGRP', CONVERT(NUMBER_TO_CHAR, :OLD.TIPGRP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATGRP', CONVERT(DATE_TO_CHAR, :OLD.DATGRP));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030GRP_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FILEMP', CONVERT(NUMBER_TO_CHAR, :OLD.FILEMP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFPA', CONVERT(NUMBER_TO_CHAR, :OLD.CODFPA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ACITRA', CONVERT(NUMBER_TO_CHAR, :OLD.ACITRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERSAT', CONVERT(NUMBER_TO_CHAR, :OLD.PERSAT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RATNAE', CONVERT(NUMBER_TO_CHAR, :OLD.RATNAE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERSLI', CONVERT(NUMBER_TO_CHAR, :OLD.PERSLI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERCON', CONVERT(NUMBER_TO_CHAR, :OLD.PERCON));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERISE', CONVERT(NUMBER_TO_CHAR, :OLD.PERISE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CGCCAB', :OLD.CGCCAB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OB1GRP', :OLD.OB1GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OB2GRP', :OLD.OB2GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OB3GRP', :OLD.OB3GRP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OB4GRP', :OLD.OB4GRP);
