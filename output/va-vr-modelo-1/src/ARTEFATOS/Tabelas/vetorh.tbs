b␀␀

PROCEDURE SP_VISPAC(P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER,P_PROPAC VARCHAR2(20),P_CODPRM NUMBER,P_DATINI DATE,P_HORINI NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_BLOAUT VARCHAR2(1),P_TIPPEV NUMBER(1),P_TIPVIS NUMBER,P_SUBNV NUMBER(1),P_CREACC NUMBER(1))
 IS

l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numpro_ret   BOOLEAN;
  l_numsma       NUMBER(12);
  l_numsma_ret   BOOLEAN;
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_teccra       NUMBER(1);
  l_inival       CHAR(16);
  l_grupo        CHAR(5);
  l_grupo_sab    CHAR(5);
  l_grupo_dom    CHAR(5);
  l_grupo_fer    CHAR(5);
  l_tipcra       NUMBER(2);
  l_codig        CHAR(6);
  l_situa        CHAR(1);
  l_situaAnt     CHAR(1);
  l_sitcra       NUMBER;
  l_subnv        CHAR(5);
  l_faixa        CHAR(56);
  l_fx_dom       CHAR(56);
  l_fx_seg       CHAR(56);
  l_fx_ter       CHAR(56);
  l_fx_qua       CHAR(56);
  l_fx_qui       CHAR(56);
  l_fx_sex       CHAR(56);
  l_fx_sab       CHAR(56);
  l_fairef       CHAR(56);
  l_datahora     CHAR(10);
  l_desmsg       VARCHAR2(32);
  l_datmsg       CHAR(16);
  l_qtdmsg       CHAR(2);
  l_qtdmsg_nmb   NUMBER;
  l_crefx1       CHAR(2);
  l_fx1          CHAR(8);
  l_crefx2       CHAR(2);
  l_fx2          CHAR(8);
  l_crefx3       CHAR(2);
  l_fx3          CHAR(8);
  l_crefx4       CHAR(2);
  l_fx4          CHAR(8);
  l_crefx5       CHAR(2);
  l_fx5          CHAR(8);
  l_crefx6       CHAR(2);
  l_fx6          CHAR(8);
  l_sequencia    NUMBER;
  l_auxmsg       CHAR(32);
  l_datmsgaux    CHAR(16);
  l_qtdIdtPes    NUMBER(2);
  l_count        NUMBER(4);
  l_iPerson      BOOLEAN;
  L_NODATAFOUND  BOOLEAN;
  l_datano       NUMBER(4);
  l_numcracex    NUMBER(12);

  /* Controle de Areas Restritas */
  l_grupo1       CHAR(5);
  l_inigr1       CHAR(10);
  l_fimgr1       CHAR(10);
  l_grupo2       CHAR(5);
  l_inigr2       CHAR(10);
  l_fimgr2       CHAR(10);
  l_grupo3       CHAR(5);
  l_inigr3       CHAR(10);
  l_fimgr3       CHAR(10);

  l_iniAR1       CHAR(10);
  l_fimAR1       CHAR(10);
  l_iniAR2       CHAR(10);
  l_fimAR2       CHAR(10);
  l_iniAR3       CHAR(10);
  l_fimAR3       CHAR(10);

  /* Definições de acesso por visitante */
  l_anti_dupla   CHAR(1); /* Controla Anti-Dupla */
  l_anti_dupla_nmb NUMBER; /* Controla Anti-Dupla */
  l_fx_flg       CHAR(1); /* Controla Intervalo de Almoço */
  l_tempo_alm    CHAR(3); /* Tempo Mínimo de Almoço (Minutos) */
  l_bloq_falta   CHAR(1); /* Bloqueia Acesso por Falta */
  l_ver_hora     CHAR(1); /* Controla Faixa Horária de Acesso */
  l_ver_local    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_valid    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_afast    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_cred     CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_vis_esp      CHAR(1); /* se for visitante especial bloqueia automaticamente na saida. */
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_tipdoc       CHAR(1);
  l_datini       CHAR(6);
  l_datfim       CHAR(6);
  l_numcra       CHAR(12);
  l_comando_nulo BOOLEAN;
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_datstr_ini   CHAR(6);
  l_horstr_ini   CHAR(4);
  l_conadp       CHAR(1);
  l_concre       NUMBER(1);
  l_conrea       NUMBER(1);
  l_usaMulti     BOOLEAN;  /*Utiliza multitecnologia (2 números físicos no mesmo crachá) */
  l_gercrv       CHAR(1);
  l_usabio       NUMBER(1);
  l_VerPrm       NUMBER(1);
  l_gracon       NUMBER(3);
  l_auxval       CHAR(16);
  l_tippes_str   CHAR(2);
  l_conrea_str   CHAR(1);
  l_creacc_bol   BOOLEAN;
  l_subnv_bol    BOOLEAN;
  l_ValAut       NUMBER(1);
  /*Interjornadas*/
  l_ConInt_int   NUMBER(1);
  l_TolInt       NUMBER(3);
  l_conpac       NUMBER(1);
  l_tempac       NUMBER(3);
  l_tolacp       NUMBER(2);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_segu_atual   NUMBER(2);
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_uticcr       CHAR(1);
  l_atucreloc    BOOLEAN;
  l_verplf       NUMBER(3);
  l_confai       NUMBER(1);
BEGIN
  l_atucreloc := FALSE;
  /* Busca parametro que indica se utiliza compra. */
  BEGIN
     SELECT UTICCR INTO l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_uticcr := 'N';
  END;

  /* Valida Cracha/Datas */
  IF   p_numcra > 0 THEN
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_segu_atual := SECOND(CURTIME());

       l_iPerson := FALSE;
       l_crefx1 := '00';
       l_crefx2 := '00';
       l_crefx3 := '00';
       l_crefx4 := '00';
       l_crefx5 := '00';
       l_crefx6 := '00';
       l_fx1 := '24002400';
       l_fx2 := '24002400';
       l_fx3 := '24002400';
       l_fx4 := '24002400';
       l_fx5 := '24002400';
       l_fx6 := '24002400';

      /* Inicializa Areas Restritas */
       l_grupo1 := '00000';
       l_inigr1 := '          ';
       l_fimgr1 := '          ';
       l_grupo2 := '00000';
       l_inigr2 := '          ';
       l_fimgr2 := '          ';
       l_grupo3 := '00000';
       l_inigr3 := '          ';
       l_fimgr3 := '          ';

       l_fx_flg      := '0';
       l_tempo_alm   := '000';
       l_bloq_falta  := '0';
       l_ver_hora    := '0';
       l_ver_local   := '1';
       l_ver_valid   := '1';
       l_ver_afast   := '1';
       l_vis_esp     := p_bloaut;
       l_usaMulti    := FALSE;
       l_subnv       := '99000';
       l_gercrv      := 'N';
       l_concre      := 0;
       l_conrea      := 1;
       l_iniAR1      := '          ';
       l_fimAR1      := '          ';
       l_iniAR2      := '          ';
       l_fimAR2      := '          ';
       l_iniAR3      := '          ';
       l_fimAR3      := '          ';
       /*Biometria*/
       l_usabio      := 1;
       l_VerPrm      := 1;
       l_gracon      := 50;
       /*Interjornadas*/
       l_ConInt_int := 0;
       l_TolInt := 0;
       l_conpac := 0;
       l_tempac := 0;
       l_tolacp := 0;
       l_nomfun := '';
       l_numpis := 0;
       l_confai := 0;
       /*Busca versão do plano ativa*/
       BEGIN
           SELECT VERPLF INTO l_verplf
             FROM R058VPL
            WHERE DATCRI <= l_data_atual
              AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
       EXCEPTION
           WHEN OTHERS THEN
               l_verplf := 1;
       END;
       /*Se a data inicial for menor do que 1980, então considera como 01/01/1980*/
       l_datano := Year(p_datini);
       IF (l_datano < 1980) THEN
           l_inival := '0101802359000000';
       ELSE
           /*obtem a data inicial do crachá*/
           SP_DATSTR(p_datini,'DDMMYY',l_datstr_ini OUT);
           SP_INTSTR(p_horini,'HHMM',l_horstr_ini OUT);
           l_inival := l_datstr_ini||l_horstr_ini||'000000';
       END IF;

       /* créditos de acesso do tipo de visita */
       BEGIN
           SELECT GERCRV, CONCRE, CONADP, USABIO, GRACON, CONREA, CONFAI INTO l_gercrv, l_concre, l_conadp, l_usabio, l_gracon, l_conrea_str, l_confai
           FROM R090TVI WHERE TIPVIS = p_tipvis;
       EXCEPTION
           WHEN OTHERS THEN l_gercrv :='N';
                            l_concre := 0;
                            l_conadp := 'S';
                            l_usabio := 1;
                            l_gracon := 50;
                            l_conrea_str := 'S';
                            l_confai := 0;
       END;
       IF (l_concre IS NULL) THEN
         l_concre:= 0 ;
       END IF;
       SP_INTSTR(l_concre,'9',l_ver_cred OUT);

       IF  l_conadp = 'S' THEN
           l_anti_dupla  := '1';
       ELSE
           l_anti_dupla  := '0';
       END IF;

        IF  l_conrea_str = 'S' THEN
           l_conrea := 1;
       ELSE
           l_conrea := 0;
       END IF;

       l_desmsg := ' ';
       l_auxmsg := '                                ';
       l_qtdmsg := '00';
       l_datmsg := '                ';

       BEGIN
            SP_INTSTR(p_codprm,'99999',l_grupo OUT);
       EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'SP_VISPAC : Permissao deve ter valor de 0 a 99';
       END;

       l_grupo_sab := l_grupo;
       l_grupo_dom := l_grupo;
       l_grupo_fer := l_grupo;

       l_codig := '';
       l_idtpes := '';

       /* Para tipo de visita com tipo de pessoa terceiro (tippev = 2). */
       /* A telemática somente solicita o crachá no cofre se for tpfis = 4 (visitante) (tippev = 1). */
       IF   p_tippev = 1 THEN
            l_tipcra := 4;
       ELSE l_tipcra := 2;
       END IF;
       
       /* retorna os creditos de acesso  */
       SP_RETCRV (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
       SP_RETMSV (p_tipdoc, p_numdoc, l_desmsg OUT, l_datmsg OUT, l_qtdmsg OUT);
       SP_RETPEV (p_tipdoc, p_numdoc, p_numcra, l_grupo1 OUT, l_inigr1 OUT, l_fimgr1 OUT, l_grupo2 OUT, l_inigr2 OUT, l_fimgr2 OUT, l_grupo3 OUT, l_inigr3 OUT, l_fimgr3 OUT);
       /*Obtem o Tipo de Pessoa*/
       l_tippes:= '04';
       SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
       /*Monta o Identificador da Pessoa*/
       l_idtpes := l_tippes||l_tipdoc||p_numdoc;


       /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_idtpes) > 22) THEN
              EXIT;
          END IF;
          l_idtpes := ' '||l_idtpes;
      END LOOP;

       l_auxmsg := l_desmsg;
       IF (l_datmsg = '                ') THEN
          l_datmsgaux  := '0000000000000000';
       ELSE
          l_datmsgaux  := l_datmsg;
       END IF;

       l_situa  := '0';
       l_situaAnt:= '1';
       l_faixa  := '00002359240024002400240024002400240024002400240024002400';
       l_fairef := '24002400240024002400240024002400240024002400240024002400';

       SP_FaiVisPac(p_propac, l_fx_dom OUT, l_fx_seg OUT, l_fx_ter OUT, l_fx_qua OUT,
                    l_fx_qui OUT, l_fx_sex OUT, l_fx_sab OUT);

        l_iniAR1 := l_inigr1;
        IF  (l_inigr1 = '          ') THEN
            l_iniAR1 := '0000000000';
        END IF;

        l_fimAR1 := l_fimgr1;
        IF  (l_fimgr1 = '          ') THEN
            l_fimAR1 := '0000000000';
        END IF;

        IF  (l_grupo2 = '     ') THEN
            l_grupo2 := '00000';
        END IF;

        l_iniAR2 := l_inigr2;
        IF  (l_inigr2 = '          ') THEN
            l_iniAR2 := '0000000000';
        END IF;

        l_fimAR2 := l_fimgr2;
        IF  (l_fimgr2 = '          ') THEN
            l_fimAR2 := '0000000000';
        END IF;

        IF  (l_grupo3 = '     ') THEN
            l_grupo3 := '00000';
        END IF;

        l_iniAR3 := l_inigr3;
        IF  (l_inigr3 = '          ') THEN
            l_iniAR3 := '0000000000';
        END IF;

        l_fimAR3 := l_fimgr3;
        IF  (l_fimgr3 = '          ') THEN
            l_fimAR3 := '0000000000';
        END IF;

       SP_DATSTR(p_datval,'DDMMYY',l_datstr OUT);
       SP_INTSTR(p_horval,'HHMM',l_horstr OUT);
       /* corrige a data se vier com valor zero */
       IF  (l_datstr = '311200') THEN
           l_datstr :=  '311250';
       END IF;
       IF  (l_horstr = '0000') THEN
           l_horstr :=  '2359';
       END IF;
       l_datahora := l_datstr || l_horstr;
       l_auxval := l_datahora||'000000';
       l_datini := '      ';
       l_datfim := '      ';

       /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
       SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

       IF (l_crapri = 0) THEN
           l_crapri := p_numcra;
           /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
           l_teccra := 1;
       ELSE
           l_teccra := l_tecpri;
       END IF;

        /* Atualiza R070CON */
        l_comando_nulo:=FALSE;
        BEGIN
            SELECT NUMFIS,SITCRA INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_VISPAC: Erro em R070CON - TOO MANY ROWS';
            WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro no SELECT R070CON 5.';
        END;

        /* verifica se o crachá é de uma nova entrada */
        IF  (l_situaAnt = '1') THEN
            l_subnv := '99000';
        END IF;
        
        /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
        BEGIN
            SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON WHERE IDTPES = l_idtpes;
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro No SELECT R070CON (IdtPes).';
        END;

        IF (l_qtdIdtPes > 0) THEN
            l_iPerson := FALSE;
        ELSE
            l_iPerson := TRUE;
        END IF;

        /* verifica se possui registros na tabela R090VAU.. Se possuir, ValAut = 1 */
        l_count := 0;
        BEGIN
            SELECT COUNT(*) INTO l_count FROM R090VAU WHERE IDTPES = l_idtpes AND
                   (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                   (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro No SELECT R090VAU (IdtPes).';
        END;

        /* necessita de validação por autorizador */
        l_ValAut := 0;
        IF  (l_count > 0) THEN
            l_ValAut := 1;
        END IF;

		l_numcracex := 0;
        BEGIN
            SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
        EXCEPTION
        	WHEN OTHERS THEN NULL;
        END;
        
        IF (l_numcracex = p_numcra) THEN
          l_situa := '1';
        END IF;
        
        SP_STRTOINT(l_situa , l_sitcra OUT);
        SP_STRTOINT(l_qtdmsg , l_qtdmsg_nmb OUT);
        SP_STRTOINT(l_anti_dupla , l_anti_dupla_nmb OUT);

        IF (l_comando_nulo = FALSE) THEN
            /* atualiza a tabela R070CON */
            BEGIN
                UPDATE R070CON SET
                       NUMCRA=p_numcra, TIPCRA=l_tipcra, SENCOL= l_codig,INIAFA= '0000000000000000',
                       DATAFA='0000000000000000',
                       CODPRM=p_codprm, PRMSAB=p_codprm, PRMDOM=p_codprm, PRMFER=p_codprm,
                       SITCRA=l_sitcra, INIVAL = l_inival, DATVAL=l_auxval,
                       MSGACC=l_desmsg, DATMSG=l_datmsgaux, QTDMSG=l_qtdmsg_nmb,
                       CONADP=l_anti_dupla_nmb, CONCRE=CONVERT(NUMBER_TO_CHAR, l_ver_cred),
                       PRMRT1=CONVERT(CHAR_TO_NUMBER, l_grupo1), DINPR1=l_iniAr1, DFNPR1=l_fimAr1,
                       PRMRT2=CONVERT(CHAR_TO_NUMBER, l_grupo2), DINPR2=l_iniAr2, DFNPR2=l_fimAr2,
                       PRMRT3=CONVERT(CHAR_TO_NUMBER, l_grupo3), DINPR3=l_iniAr3, DFNPR3=l_fimAr3,
                       TECCRA=l_teccra, CHCPRI=0, IDTPES=l_idtpes, USABIO=l_usabio, GRACON=l_gracon,
                       CONINT=l_conInt_Int, TOLINT=l_tolInt, CONPAC=l_conpac, TEMPAC=l_tempac,
                       TOLACP=l_tolacp, VALAUT=l_ValAut, NOMFUN=l_nomfun, NUMPIS=l_numpis,
                       VERAFA=0, CONFAI=l_confai,
                       FAIAC1=l_fx_dom, FAIAC2=l_fx_seg, FAIAC3=l_fx_ter, FAIAC4=l_fx_qua,
                       FAIAC5=l_fx_qui, FAIAC6=l_fx_sex, FAIAC7=l_fx_sab, CONREA=l_conrea,
                       RECVIS=0, NUMEMP=0, TIPCOL=0, NUMCAD=0, TIPDOC=p_tipdoc, NUMDOC=p_numdoc, NUMMAT='0', 
                       PROPAC=p_propac, NUMCAN=0, BLOAUT= CONVERT(CHAR_TO_NUMBER, l_vis_esp)
                WHERE NUMFIS = l_crapri;

                /* Verifica se atualiza SubNv*/
                IF (p_subnv = 1) THEN
                  BEGIN
                      UPDATE R070CON SET
                           NIVATU = '99000', DATNIV = l_data_atual, HORNIV = l_hora_atual, SEQNIV = l_segu_atual
                      WHERE IDTPES = l_idtpes;
                      /*Gera pendência de atualização de nível*/
                      SP_PEND26(l_idtpes, '99000', l_data_atual, l_hora_atual, l_segu_atual);
                  EXCEPTION WHEN OTHERS THEN
                      RAISERROR 103 'SP_VISPAC: Erro Na Atualização de SPVISCON 2.';
                  END;
                END IF;

                /* Verifica se atualiza Créditos de Acesso*/
                IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
                    /*RESETA OS CRÉDITOS DO VISITANTE*/
                    l_atucreloc := TRUE; /* marca como atualizado os créditos da pessoa */
                    /*reseta os créditos da pessoa*/
                    SP_RESETCRED(4, 0, 0, 0, p_tipdoc, p_numdoc, '0', '0');
                END IF;

            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro Na Atualização de R070CON';
            END;
        ELSE
           /* insere na tabela R070CON */
           SP_STRTOINT(l_vis_esp , l_anti_dupla_nmb OUT);
           BEGIN
               INSERT INTO R070CON(
                           NUMCRA,NUMFIS,TIPCRA,SITCRA,NIVATU,DATNIV,HORNIV,SEQNIV,
                           INIVAL,DATVAL,INIAFA, DATAFA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                           SENCOL,MSGACC,DATMSG,QTDMSG,MSGATU,
                           CONIAL,TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,
                           CONPAC,TEMPAC,TOLACP,BLOAUT,BLOFAL,
                           CREAC1,CREFX1,QTDCR1,CREAC2,CREFX2,QTDCR2,
                           CREAC3,CREFX3,QTDCR3,CREAC4,CREFX4,QTDCR4,
                           CREAC5,CREFX5,QTDCR5,CREAC6,CREFX6,QTDCR6,
                           PRMRT1,DINPR1,DFNPR1,PRMRT2,DINPR2,DFNPR2,PRMRT3,DINPR3,DFNPR3,
                           FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,FAIAC7,
                           FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,FAIREF,
                           TECCRA,CHCPRI,IDTPES,GRACON,CONINT,TOLINT,VALAUT,
                           NOMFUN,NUMPIS,CONREA,RECVIS,NUMEMP,TIPCOL,NUMCAD,
                           TIPDOC,NUMDOC,NUMMAT,PROPAC,NUMCAN, PROPRE)
               VALUES(
                           p_numcra,l_crapri,l_tipcra,l_sitcra,l_subnv,l_data_atual,
                           l_hora_atual,l_segu_atual,l_inival,l_auxval,
                           '0000000000000000','0000000000000000',p_codprm,p_codprm,
                           p_codprm,p_codprm,l_codig,l_desmsg,l_datmsgaux,l_qtdmsg_nmb,l_qtdmsg_nmb,
                           0,0,0,l_usabio,l_VerPrm,l_confai,l_anti_dupla_nmb,l_concre,l_conpac,l_tempac,l_tolacp,l_anti_dupla_nmb,0,
                           CONVERT(CHAR_TO_NUMBER, l_crefx1),l_fx1,CONVERT(CHAR_TO_NUMBER, l_crefx1),CONVERT(CHAR_TO_NUMBER, l_crefx2),l_fx2,CONVERT(CHAR_TO_NUMBER, l_crefx2),
                           CONVERT(CHAR_TO_NUMBER, l_crefx3),l_fx3,CONVERT(CHAR_TO_NUMBER, l_crefx3),CONVERT(CHAR_TO_NUMBER, l_crefx4),l_fx4,CONVERT(CHAR_TO_NUMBER, l_crefx4),
                           CONVERT(CHAR_TO_NUMBER, l_crefx5),l_fx5,CONVERT(CHAR_TO_NUMBER, l_crefx5),CONVERT(CHAR_TO_NUMBER, l_crefx6),l_fx6,CONVERT(CHAR_TO_NUMBER, l_crefx6),
                           CONVERT(CHAR_TO_NUMBER, l_grupo1),l_iniAr1,l_fimAr1,CONVERT(CHAR_TO_NUMBER, l_grupo2),l_iniAr2,l_fimAr2,
                           CONVERT(CHAR_TO_NUMBER, l_grupo3),l_iniAr3,l_fimAr3,
                           l_fx_dom,l_fx_seg,l_fx_ter,l_fx_qua,l_fx_qui,l_fx_sex,l_fx_sab,
                           l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                           l_fairef,l_teccra,0,l_idtpes,l_gracon,l_conInt_Int,l_tolInt,l_ValAut,
                           l_nomfun,l_numpis,l_conrea,0,0,0,0,
                           p_tipdoc,p_numdoc,'0',p_propac,0,0);
           EXCEPTION
               WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro no INSERT Tabela R070CON.';
           END;

        END IF;
        /*Atualiza Pend_Grupo*/
        IF (l_numsma > 0) THEN
            /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
            IF (l_tecpri = 3) THEN
                SP_ATUPRM(p_numcra, l_numsma, p_codprm, l_grupo1, l_grupo2, l_grupo3, p_codprm, p_codprm, p_codprm);
            ELSE
                SP_ATUPRM(l_crapri, l_numsma, p_codprm, l_grupo1, l_grupo2, l_grupo3, p_codprm, p_codprm, p_codprm);
            END IF;
        END IF;


        /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
        IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
            SP_PEND21(l_crapri);
        END IF;

        /*Atualiza os demais Crachás*/
        /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
        IF (l_tecpri = 1) THEN
            /*Atualiza o crachá de proximidade*/
            IF (l_numpro <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numpro, l_numpro_ret OUT);
                  /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numpro);
                END IF;
            END IF;
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
        ELSIF (l_tecpri = 2) THEN
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        END IF;
        /*Verifica se Gera o Comando IncludePerson*/
        IF (l_iPerson = TRUE) THEN
            /*Gera o Include Person*/
            SP_PEND19(p_numcra, l_idtpes);
            /*Atualiza os créditos somente se o mesmo já não foi atualizado*/
            IF (l_atucreloc = FALSE) THEN
                /*Atualiza os créditos sem local físico*/
                SP_PEND06(1, l_idtpes, l_verplf, 0);
                /*Atualiza os créditos por local físico da pessoa*/
                SP_ATUCRELOC(l_idtpes);
            END IF;
        END IF;
  END IF;
  IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
    l_creacc_bol := TRUE;
  ELSE
    l_creacc_bol := FALSE;
  END IF;
  IF (p_subnv = 1) THEN
    l_subnv_bol := TRUE;
  ELSE
    l_subnv_bol := FALSE;
  END IF;

  /*Atualiza a Controle*/
  SP_ATUTSI(l_idtpes, l_crapri, l_creacc_bol, TRUE, l_subnv_bol, TRUE);
  /*Atualiza tabela MatGrupo*/
  SP_MATGRP(p_numcra, 4, 0, 0, 0, p_tipdoc, p_numdoc, '');
END		SENIOR;20ÏSP_DATSTR
SP_INTSTR
SP_RETCRV
SP_RETMSV
SP_RETPEV
SP_FAIVISPAC
SP_MAPFIS
SP_PEND26
SP_RESETCRED
SP_ATUPRM
SP_PEND21
SP_VERCON
SP_ATUFIS
SP_PEND19
SP_PEND06
SP_ATUCRELOC
SP_ATUTSI
SP_MATGRP
h_␀␀


/* Historico de Cracha - Visitante de Paciente*/
PROCEDURE SP_VISPAC(P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER,P_PROPAC VARCHAR2(20),P_CODPRM NUMBER,P_DATINI DATE,P_HORINI NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_BLOAUT VARCHAR2(1),P_TIPPEV NUMBER(1),P_TIPVIS NUMBER,P_SUBNV NUMBER(1),P_CREACC NUMBER(1))
 IS

l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numpro_ret   BOOLEAN;
  l_numsma       NUMBER(12);
  l_numsma_ret   BOOLEAN;
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_teccra       NUMBER(1);
  l_inival       CHAR(16);
  l_grupo        CHAR(5);
  l_grupo_sab    CHAR(5);
  l_grupo_dom    CHAR(5);
  l_grupo_fer    CHAR(5);
  l_tipcra       NUMBER(2);
  l_codig        CHAR(6);
  l_situa        CHAR(1);
  l_situaAnt     CHAR(1);
  l_subnv        CHAR(5);
  l_faixa        CHAR(56);
  l_fx_dom       CHAR(56);
  l_fx_seg       CHAR(56);
  l_fx_ter       CHAR(56);
  l_fx_qua       CHAR(56);
  l_fx_qui       CHAR(56);
  l_fx_sex       CHAR(56);
  l_fx_sab       CHAR(56);
  l_fairef       CHAR(56);
  l_datahora     CHAR(10);
  l_desmsg       VARCHAR2(32);
  l_datmsg       CHAR(16);
  l_qtdmsg       CHAR(2);
  l_crefx1       CHAR(2);
  l_fx1          CHAR(8);
  l_crefx2       CHAR(2);
  l_fx2          CHAR(8);
  l_crefx3       CHAR(2);
  l_fx3          CHAR(8);
  l_crefx4       CHAR(2);
  l_fx4          CHAR(8);
  l_crefx5       CHAR(2);
  l_fx5          CHAR(8);
  l_crefx6       CHAR(2);
  l_fx6          CHAR(8);
  l_sequencia    NUMBER;
  l_auxmsg       CHAR(32);
  l_datmsgaux    CHAR(16);
  l_qtdIdtPes    NUMBER(2);
  l_count        NUMBER(4);
  l_iPerson      BOOLEAN;
  L_NODATAFOUND  BOOLEAN;
  l_datano       NUMBER(4);
  l_numcracex    NUMBER(12);

  /* Controle de Areas Restritas */
  l_grupo1       CHAR(5);
  l_inigr1       CHAR(10);
  l_fimgr1       CHAR(10);
  l_grupo2       CHAR(5);
  l_inigr2       CHAR(10);
  l_fimgr2       CHAR(10);
  l_grupo3       CHAR(5);
  l_inigr3       CHAR(10);
  l_fimgr3       CHAR(10);

  l_iniAR1       CHAR(10);
  l_fimAR1       CHAR(10);
  l_iniAR2       CHAR(10);
  l_fimAR2       CHAR(10);
  l_iniAR3       CHAR(10);
  l_fimAR3       CHAR(10);

  /* Definições de acesso por visitante */
  l_anti_dupla   CHAR(1); /* Controla Anti-Dupla */
  l_fx_flg       CHAR(1); /* Controla Intervalo de Almoço */
  l_tempo_alm    CHAR(3); /* Tempo Mínimo de Almoço (Minutos) */
  l_bloq_falta   CHAR(1); /* Bloqueia Acesso por Falta */
  l_ver_hora     CHAR(1); /* Controla Faixa Horária de Acesso */
  l_ver_local    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_valid    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_afast    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_cred     CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_vis_esp      CHAR(1); /* se for visitante especial bloqueia automaticamente na saida. */
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_tipdoc       CHAR(1);
  l_datini       CHAR(6);
  l_datfim       CHAR(6);
  l_numcra       CHAR(12);
  l_comando_nulo BOOLEAN;
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_datstr_ini   CHAR(6);
  l_horstr_ini   CHAR(4);
  l_conadp       CHAR(1);
  l_concre       NUMBER(1);
  l_conrea       NUMBER(1);
  l_usaMulti     BOOLEAN;  /*Utiliza multitecnologia (2 números físicos no mesmo crachá) */
  l_gercrv       CHAR(1);
  l_usabio       NUMBER(1);
  l_VerPrm       NUMBER(1);
  l_gracon       NUMBER(3);
  l_auxval       CHAR(16);
  l_tippes_str   CHAR(2);
  l_conrea_str   CHAR(1);
  l_creacc_bol   BOOLEAN;
  l_subnv_bol    BOOLEAN;
  l_ValAut       NUMBER(1);
  /*Interjornadas*/
  l_ConInt_int   NUMBER(1);
  l_TolInt       NUMBER(3);
  l_conpac       NUMBER(1);
  l_tempac       NUMBER(3);
  l_tolacp       NUMBER(2);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_segu_atual   NUMBER(2);
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_uticcr       CHAR(1);
  l_atucreloc    BOOLEAN;
  l_verplf       NUMBER(3);
  l_confai       NUMBER(1);
BEGIN
  l_atucreloc := FALSE;
  /* Busca parametro que indica se utiliza compra. */
  BEGIN
     SELECT UTICCR INTO l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_uticcr := 'N';
  END;

  /* Valida Cracha/Datas */
  IF   p_numcra > 0 THEN
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_segu_atual := SECOND(CURTIME());

       l_iPerson := FALSE;
       l_crefx1 := '00';
       l_crefx2 := '00';
       l_crefx3 := '00';
       l_crefx4 := '00';
       l_crefx5 := '00';
       l_crefx6 := '00';
       l_fx1 := '24002400';
       l_fx2 := '24002400';
       l_fx3 := '24002400';
       l_fx4 := '24002400';
       l_fx5 := '24002400';
       l_fx6 := '24002400';

      /* Inicializa Areas Restritas */
       l_grupo1 := '00000';
       l_inigr1 := '          ';
       l_fimgr1 := '          ';
       l_grupo2 := '00000';
       l_inigr2 := '          ';
       l_fimgr2 := '          ';
       l_grupo3 := '00000';
       l_inigr3 := '          ';
       l_fimgr3 := '          ';

       l_fx_flg      := '0';
       l_tempo_alm   := '000';
       l_bloq_falta  := '0';
       l_ver_hora    := '0';
       l_ver_local   := '1';
       l_ver_valid   := '1';
       l_ver_afast   := '1';
       l_vis_esp     := p_bloaut;
       l_usaMulti    := FALSE;
       l_subnv       := '99000';
       l_gercrv      := 'N';
       l_concre      := 0;
       l_conrea      := 1;
       l_iniAR1      := '          ';
       l_fimAR1      := '          ';
       l_iniAR2      := '          ';
       l_fimAR2      := '          ';
       l_iniAR3      := '          ';
       l_fimAR3      := '          ';
       /*Biometria*/
       l_usabio      := 1;
       l_VerPrm      := 1;
       l_gracon      := 50;
       /*Interjornadas*/
       l_ConInt_int := 0;
       l_TolInt := 0;
       l_conpac := 0;
       l_tempac := 0;
       l_tolacp := 0;
       l_nomfun := '';
       l_numpis := 0;
       l_confai := 0;
       /*Busca versão do plano ativa*/
       BEGIN
           SELECT VERPLF INTO l_verplf
             FROM R058VPL
            WHERE DATCRI <= l_data_atual
              AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
       EXCEPTION
           WHEN OTHERS THEN
               l_verplf := 1;
       END;
       /*Se a data inicial for menor do que 1980, então considera como 01/01/1980*/
       l_datano := Year(p_datini);
       IF (l_datano < 1980) THEN
           l_inival := '0101802359000000';
       ELSE
           /*obtem a data inicial do crachá*/
           SP_DATSTR(p_datini,'DDMMYY',l_datstr_ini OUT);
           SP_INTSTR(p_horini,'HHMM',l_horstr_ini OUT);
           l_inival := l_datstr_ini||l_horstr_ini||'000000';
       END IF;

       /* créditos de acesso do tipo de visita */
       BEGIN
           SELECT GERCRV, CONCRE, CONADP, USABIO, GRACON, CONREA, CONFAI INTO l_gercrv, l_concre, l_conadp, l_usabio, l_gracon, l_conrea_str, l_confai
           FROM R090TVI WHERE TIPVIS = p_tipvis;
       EXCEPTION
           WHEN OTHERS THEN l_gercrv :='N';
                            l_concre := 0;
                            l_conadp := 'S';
                            l_usabio := 1;
                            l_gracon := 50;
                            l_conrea_str := 'S';
                            l_confai := 0;
       END;
       IF (l_concre IS NULL) THEN
         l_concre:= 0 ;
       END IF;
       SP_INTSTR(l_concre,'9',l_ver_cred OUT);

       IF  l_conadp = 'S' THEN
           l_anti_dupla  := '1';
       ELSE
           l_anti_dupla  := '0';
       END IF;

        IF  l_conrea_str = 'S' THEN
           l_conrea := 1;
       ELSE
           l_conrea := 0;
       END IF;

       l_desmsg := ' ';
       l_auxmsg := '                                ';
       l_qtdmsg := '00';
       l_datmsg := '                ';

       BEGIN
            SP_INTSTR(p_codprm,'99999',l_grupo OUT);
       EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'SP_VISPAC : Permissao deve ter valor de 0 a 99';
       END;

       l_grupo_sab := l_grupo;
       l_grupo_dom := l_grupo;
       l_grupo_fer := l_grupo;

       l_codig := '';
       l_idtpes := '';

       /* Para tipo de visita com tipo de pessoa terceiro (tippev = 2). */
       /* A telemática somente solicita o crachá no cofre se for tpfis = 4 (visitante) (tippev = 1). */
       IF   p_tippev = 1 THEN
            l_tipcra := 4;
       ELSE l_tipcra := 2;
       END IF;
       
       /* retorna os creditos de acesso  */
       SP_RETCRV (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
       SP_RETMSV (p_tipdoc, p_numdoc, l_desmsg OUT, l_datmsg OUT, l_qtdmsg OUT);
       SP_RETPEV (p_tipdoc, p_numdoc, p_numcra, l_grupo1 OUT, l_inigr1 OUT, l_fimgr1 OUT, l_grupo2 OUT, l_inigr2 OUT, l_fimgr2 OUT, l_grupo3 OUT, l_inigr3 OUT, l_fimgr3 OUT);
       /*Obtem o Tipo de Pessoa*/
       l_tippes:= '04';
       SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
       /*Monta o Identificador da Pessoa*/
       l_idtpes := l_tippes||l_tipdoc||p_numdoc;


       /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_idtpes) > 22) THEN
              EXIT;
          END IF;
          l_idtpes := ' '||l_idtpes;
      END LOOP;

       l_auxmsg := l_desmsg;
       IF (l_datmsg = '                ') THEN
          l_datmsgaux  := '0000000000000000';
       ELSE
          l_datmsgaux  := l_datmsg;
       END IF;

       l_situa  := '0';
       l_situaAnt:= '1';
       l_faixa  := '00002359240024002400240024002400240024002400240024002400';
       l_fairef := '24002400240024002400240024002400240024002400240024002400';

       SP_FaiVisPac(p_propac, l_fx_dom OUT, l_fx_seg OUT, l_fx_ter OUT, l_fx_qua OUT,
                    l_fx_qui OUT, l_fx_sex OUT, l_fx_sab OUT);

        l_iniAR1 := l_inigr1;
        IF  (l_inigr1 = '          ') THEN
            l_iniAR1 := '0000000000';
        END IF;

        l_fimAR1 := l_fimgr1;
        IF  (l_fimgr1 = '          ') THEN
            l_fimAR1 := '0000000000';
        END IF;

        IF  (l_grupo2 = '     ') THEN
            l_grupo2 := '00000';
        END IF;

        l_iniAR2 := l_inigr2;
        IF  (l_inigr2 = '          ') THEN
            l_iniAR2 := '0000000000';
        END IF;

        l_fimAR2 := l_fimgr2;
        IF  (l_fimgr2 = '          ') THEN
            l_fimAR2 := '0000000000';
        END IF;

        IF  (l_grupo3 = '     ') THEN
            l_grupo3 := '00000';
        END IF;

        l_iniAR3 := l_inigr3;
        IF  (l_inigr3 = '          ') THEN
            l_iniAR3 := '0000000000';
        END IF;

        l_fimAR3 := l_fimgr3;
        IF  (l_fimgr3 = '          ') THEN
            l_fimAR3 := '0000000000';
        END IF;

       SP_DATSTR(p_datval,'DDMMYY',l_datstr OUT);
       SP_INTSTR(p_horval,'HHMM',l_horstr OUT);
       /* corrige a data se vier com valor zero */
       IF  (l_datstr = '311200') THEN
           l_datstr :=  '311250';
       END IF;
       IF  (l_horstr = '0000') THEN
           l_horstr :=  '2359';
       END IF;
       l_datahora := l_datstr || l_horstr;
       l_auxval := l_datahora||'000000';
       l_datini := '      ';
       l_datfim := '      ';

       /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
       SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

       IF (l_crapri = 0) THEN
           l_crapri := p_numcra;
           /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
           l_teccra := 1;
       ELSE
           l_teccra := l_tecpri;
       END IF;

        /* Atualiza R070CON */
        l_comando_nulo:=FALSE;
        BEGIN
            SELECT NUMFIS,SITCRA INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_VISPAC: Erro em R070CON - TOO MANY ROWS';
            WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro no SELECT R070CON 5.';
        END;

        /* verifica se o crachá é de uma nova entrada */
        IF  (l_situaAnt = '1') THEN
            l_subnv := '99000';
        END IF;
        
        /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
        BEGIN
            SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON WHERE IDTPES = l_idtpes;
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro No SELECT R070CON (IdtPes).';
        END;

        IF (l_qtdIdtPes > 0) THEN
            l_iPerson := FALSE;
        ELSE
            l_iPerson := TRUE;
        END IF;

        /* verifica se possui registros na tabela R090VAU.. Se possuir, ValAut = 1 */
        l_count := 0;
        BEGIN
            SELECT COUNT(*) INTO l_count FROM R090VAU WHERE IDTPES = l_idtpes AND
                   (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                   (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro No SELECT R090VAU (IdtPes).';
        END;

        /* necessita de validação por autorizador */
        l_ValAut := 0;
        IF  (l_count > 0) THEN
            l_ValAut := 1;
        END IF;

		l_numcracex := 0;
        BEGIN
            SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
        EXCEPTION
        	WHEN OTHERS THEN NULL;
        END;
        
        IF (l_numcracex = p_numcra) THEN
          l_situa := '1';
        END IF;

        IF (l_comando_nulo = FALSE) THEN
            /* atualiza a tabela R070CON */
            BEGIN
                UPDATE R070CON SET
                       NUMCRA=p_numcra, TIPCRA=l_tipcra, SENCOL= l_codig,INIAFA= '0000000000000000',
                       DATAFA='0000000000000000',
                       CODPRM=p_codprm, PRMSAB=p_codprm, PRMDOM=p_codprm, PRMFER=p_codprm,
                       SITCRA=l_situa, INIVAL = l_inival, DATVAL=l_auxval,
                       MSGACC=l_desmsg, DATMSG=l_datmsgaux, QTDMSG=l_qtdmsg,
                       CONADP=l_anti_dupla, CONCRE=l_ver_cred,
                       PRMRT1=l_grupo1, DINPR1=l_iniAr1, DFNPR1=l_fimAr1,
                       PRMRT2=l_grupo2, DINPR2=l_iniAr2, DFNPR2=l_fimAr2,
                       PRMRT3=l_grupo3, DINPR3=l_iniAr3, DFNPR3=l_fimAr3,
                       TECCRA=l_teccra, CHCPRI=0, IDTPES=l_idtpes, USABIO=l_usabio, GRACON=l_gracon,
                       CONINT=l_conInt_Int, TOLINT=l_tolInt, CONPAC=l_conpac, TEMPAC=l_tempac,
                       TOLACP=l_tolacp, VALAUT=l_ValAut, NOMFUN=l_nomfun, NUMPIS=l_numpis,
                       VERAFA=0, CONFAI=l_confai,
                       FAIAC1=l_fx_dom, FAIAC2=l_fx_seg, FAIAC3=l_fx_ter, FAIAC4=l_fx_qua,
                       FAIAC5=l_fx_qui, FAIAC6=l_fx_sex, FAIAC7=l_fx_sab, CONREA=l_conrea,
                       RECVIS=0, NUMEMP=0, TIPCOL=0, NUMCAD=0, TIPDOC=p_tipdoc, NUMDOC=p_numdoc, NUMMAT='0', 
                       PROPAC=p_propac, NUMCAN=0, BLOAUT= l_vis_esp
                WHERE NUMFIS = l_crapri;

                /* Verifica se atualiza SubNv*/
                IF (p_subnv = 1) THEN
                  BEGIN
                      UPDATE R070CON SET
                           NIVATU = '99000', DATNIV = l_data_atual, HORNIV = l_hora_atual, SEQNIV = l_segu_atual
                      WHERE IDTPES = l_idtpes;
                      /*Gera pendência de atualização de nível*/
                      SP_PEND26(l_idtpes, '99000', l_data_atual, l_hora_atual, l_segu_atual);
                  EXCEPTION WHEN OTHERS THEN
                      RAISERROR 103 'SP_VISPAC: Erro Na Atualização de SPVISCON 2.';
                  END;
                END IF;

                /* Verifica se atualiza Créditos de Acesso*/
                IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
                    /*RESETA OS CRÉDITOS DO VISITANTE*/
                    l_atucreloc := TRUE; /* marca como atualizado os créditos da pessoa */
                    /*reseta os créditos da pessoa*/
                    SP_RESETCRED(4, 0, 0, 0, p_tipdoc, p_numdoc, '0', '0');
                END IF;

            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro Na Atualização de R070CON';
            END;
        ELSE
           /* insere na tabela R070CON */
           BEGIN
               INSERT INTO R070CON(
                           NUMCRA,NUMFIS,TIPCRA,SITCRA,NIVATU,DATNIV,HORNIV,SEQNIV,
                           INIVAL,DATVAL,INIAFA, DATAFA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                           SENCOL,MSGACC,DATMSG,QTDMSG,MSGATU,
                           CONIAL,TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,
                           CONPAC,TEMPAC,TOLACP,BLOAUT,BLOFAL,
                           CREAC1,CREFX1,QTDCR1,CREAC2,CREFX2,QTDCR2,
                           CREAC3,CREFX3,QTDCR3,CREAC4,CREFX4,QTDCR4,
                           CREAC5,CREFX5,QTDCR5,CREAC6,CREFX6,QTDCR6,
                           PRMRT1,DINPR1,DFNPR1,PRMRT2,DINPR2,DFNPR2,PRMRT3,DINPR3,DFNPR3,
                           FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,FAIAC7,
                           FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,FAIREF,
                           TECCRA,CHCPRI,IDTPES,GRACON,CONINT,TOLINT,VALAUT,
                           NOMFUN,NUMPIS,CONREA,RECVIS,NUMEMP,TIPCOL,NUMCAD,
                           TIPDOC,NUMDOC,NUMMAT,PROPAC,NUMCAN, PROPRE)
               VALUES(
                           p_numcra,l_crapri,l_tipcra,l_situa,l_subnv,l_data_atual,
                           l_hora_atual,l_segu_atual,l_inival,l_auxval,
                           '0000000000000000','0000000000000000',p_codprm,p_codprm,
                           p_codprm,p_codprm,l_codig,l_desmsg,l_datmsgaux,l_qtdmsg,l_qtdmsg,
                           0,0,0,l_usabio,l_VerPrm,l_confai,l_anti_dupla,l_concre,l_conpac,l_tempac,l_tolacp,l_vis_esp,0,
                           l_crefx1,l_fx1,l_crefx1,l_crefx2,l_fx2,l_crefx2,
                           l_crefx3,l_fx3,l_crefx3,l_crefx4,l_fx4,l_crefx4,
                           l_crefx5,l_fx5,l_crefx5,l_crefx6,l_fx6,l_crefx6,
                           l_grupo1,l_iniAr1,l_fimAr1,l_grupo2,l_iniAr2,l_fimAr2,
                           l_grupo3,l_iniAr3,l_fimAr3,
                           l_fx_dom,l_fx_seg,l_fx_ter,l_fx_qua,l_fx_qui,l_fx_sex,l_fx_sab,
                           l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                           l_fairef,l_teccra,0,l_idtpes,l_gracon,l_conInt_Int,l_tolInt,l_ValAut,
                           l_nomfun,l_numpis,l_conrea,0,0,0,0,
                           p_tipdoc,p_numdoc,'0',p_propac,0,0);
           EXCEPTION
               WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro no INSERT Tabela R070CON.';
           END;

        END IF;
        /*Atualiza Pend_Grupo*/
        IF (l_numsma > 0) THEN
            /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
            IF (l_tecpri = 3) THEN
                SP_ATUPRM(p_numcra, l_numsma, p_codprm, l_grupo1, l_grupo2, l_grupo3, p_codprm, p_codprm, p_codprm);
            ELSE
                SP_ATUPRM(l_crapri, l_numsma, p_codprm, l_grupo1, l_grupo2, l_grupo3, p_codprm, p_codprm, p_codprm);
            END IF;
        END IF;


        /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
        IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
            SP_PEND21(l_crapri);
        END IF;

        /*Atualiza os demais Crachás*/
        /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
        IF (l_tecpri = 1) THEN
            /*Atualiza o crachá de proximidade*/
            IF (l_numpro <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numpro, l_numpro_ret OUT);
                  /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numpro);
                END IF;
            END IF;
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
        ELSIF (l_tecpri = 2) THEN
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        END IF;
        /*Verifica se Gera o Comando IncludePerson*/
        IF (l_iPerson = TRUE) THEN
            /*Gera o Include Person*/
            SP_PEND19(p_numcra, l_idtpes);
            /*Atualiza os créditos somente se o mesmo já não foi atualizado*/
            IF (l_atucreloc = FALSE) THEN
                /*Atualiza os créditos sem local físico*/
                SP_PEND06(1, l_idtpes, l_verplf, 0);
                /*Atualiza os créditos por local físico da pessoa*/
                SP_ATUCRELOC(l_idtpes);
            END IF;
        END IF;
  END IF;
  IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
    l_creacc_bol := TRUE;
  ELSE
    l_creacc_bol := FALSE;
  END IF;
  IF (p_subnv = 1) THEN
    l_subnv_bol := TRUE;
  ELSE
    l_subnv_bol := FALSE;
  END IF;

  /*Atualiza a Controle*/
  SP_ATUTSI(l_idtpes, l_crapri, l_creacc_bol, TRUE, l_subnv_bol, TRUE);
  /*Atualiza tabela MatGrupo*/
  SP_MATGRP(p_numcra, 4, 0, 0, 0, p_tipdoc, p_numdoc, '');
END		SENIOR;21ÏSP_DATSTR
SP_INTSTR
SP_RETCRV
SP_RETMSV
SP_RETPEV
SP_FAIVISPAC
SP_MAPFIS
SP_PEND26
SP_RESETCRED
SP_ATUPRM
SP_PEND21
SP_VERCON
SP_ATUFIS
SP_PEND19
SP_PEND06
SP_ATUCRELOC
SP_ATUTSI
SP_MATGRP
h_␀␀


/* Historico de Cracha - Visitante de Paciente*/
PROCEDURE SP_VISPAC(P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER,P_PROPAC VARCHAR2(20),P_CODPRM NUMBER,P_DATINI DATE,P_HORINI NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_BLOAUT VARCHAR2(1),P_TIPPEV NUMBER(1),P_TIPVIS NUMBER,P_SUBNV NUMBER(1),P_CREACC NUMBER(1))
 IS

l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numpro_ret   BOOLEAN;
  l_numsma       NUMBER(12);
  l_numsma_ret   BOOLEAN;
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_teccra       NUMBER(1);
  l_inival       CHAR(16);
  l_grupo        CHAR(5);
  l_grupo_sab    CHAR(5);
  l_grupo_dom    CHAR(5);
  l_grupo_fer    CHAR(5);
  l_tipcra       NUMBER(2);
  l_codig        CHAR(6);
  l_situa        CHAR(1);
  l_situaAnt     CHAR(1);
  l_subnv        CHAR(5);
  l_faixa        CHAR(56);
  l_fx_dom       CHAR(56);
  l_fx_seg       CHAR(56);
  l_fx_ter       CHAR(56);
  l_fx_qua       CHAR(56);
  l_fx_qui       CHAR(56);
  l_fx_sex       CHAR(56);
  l_fx_sab       CHAR(56);
  l_fairef       CHAR(56);
  l_datahora     CHAR(10);
  l_desmsg       VARCHAR2(32);
  l_datmsg       CHAR(16);
  l_qtdmsg       CHAR(2);
  l_crefx1       CHAR(2);
  l_fx1          CHAR(8);
  l_crefx2       CHAR(2);
  l_fx2          CHAR(8);
  l_crefx3       CHAR(2);
  l_fx3          CHAR(8);
  l_crefx4       CHAR(2);
  l_fx4          CHAR(8);
  l_crefx5       CHAR(2);
  l_fx5          CHAR(8);
  l_crefx6       CHAR(2);
  l_fx6          CHAR(8);
  l_sequencia    NUMBER;
  l_auxmsg       CHAR(32);
  l_datmsgaux    CHAR(16);
  l_qtdIdtPes    NUMBER(2);
  l_count        NUMBER(4);
  l_iPerson      BOOLEAN;
  L_NODATAFOUND  BOOLEAN;
  l_datano       NUMBER(4);
  l_numcracex    NUMBER(12);

  /* Controle de Areas Restritas */
  l_grupo1       CHAR(5);
  l_inigr1       CHAR(10);
  l_fimgr1       CHAR(10);
  l_grupo2       CHAR(5);
  l_inigr2       CHAR(10);
  l_fimgr2       CHAR(10);
  l_grupo3       CHAR(5);
  l_inigr3       CHAR(10);
  l_fimgr3       CHAR(10);

  l_iniAR1       CHAR(10);
  l_fimAR1       CHAR(10);
  l_iniAR2       CHAR(10);
  l_fimAR2       CHAR(10);
  l_iniAR3       CHAR(10);
  l_fimAR3       CHAR(10);

  /* Definições de acesso por visitante */
  l_anti_dupla   CHAR(1); /* Controla Anti-Dupla */
  l_fx_flg       CHAR(1); /* Controla Intervalo de Almoço */
  l_tempo_alm    CHAR(3); /* Tempo Mínimo de Almoço (Minutos) */
  l_bloq_falta   CHAR(1); /* Bloqueia Acesso por Falta */
  l_ver_hora     CHAR(1); /* Controla Faixa Horária de Acesso */
  l_ver_local    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_valid    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_afast    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_cred     CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_vis_esp      CHAR(1); /* se for visitante especial bloqueia automaticamente na saida. */
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_tipdoc       CHAR(1);
  l_datini       CHAR(6);
  l_datfim       CHAR(6);
  l_numcra       CHAR(12);
  l_comando_nulo BOOLEAN;
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_datstr_ini   CHAR(6);
  l_horstr_ini   CHAR(4);
  l_conadp       CHAR(1);
  l_concre       NUMBER(1);
  l_conrea       NUMBER(1);
  l_usaMulti     BOOLEAN;  /*Utiliza multitecnologia (2 números físicos no mesmo crachá) */
  l_gercrv       CHAR(1);
  l_usabio       NUMBER(1);
  l_VerPrm       NUMBER(1);
  l_gracon       NUMBER(3);
  l_auxval       CHAR(16);
  l_tippes_str   CHAR(2);
  l_conrea_str   CHAR(1);
  l_creacc_bol   BOOLEAN;
  l_subnv_bol    BOOLEAN;
  l_ValAut       NUMBER(1);
  /*Interjornadas*/
  l_ConInt_int   NUMBER(1);
  l_TolInt       NUMBER(3);
  l_conpac       NUMBER(1);
  l_tempac       NUMBER(3);
  l_tolacp       NUMBER(2);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_segu_atual   NUMBER(2);
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_uticcr       CHAR(1);
  l_atucreloc    BOOLEAN;
  l_verplf       NUMBER(3);
  l_confai       NUMBER(1);
BEGIN
  l_atucreloc := FALSE;
  /* Busca parametro que indica se utiliza compra. */
  BEGIN
     SELECT UTICCR INTO l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_uticcr := 'N';
  END;

  /* Valida Cracha/Datas */
  IF   p_numcra > 0 THEN
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_segu_atual := SECOND(CURTIME());

       l_iPerson := FALSE;
       l_crefx1 := '00';
       l_crefx2 := '00';
       l_crefx3 := '00';
       l_crefx4 := '00';
       l_crefx5 := '00';
       l_crefx6 := '00';
       l_fx1 := '24002400';
       l_fx2 := '24002400';
       l_fx3 := '24002400';
       l_fx4 := '24002400';
       l_fx5 := '24002400';
       l_fx6 := '24002400';

      /* Inicializa Areas Restritas */
       l_grupo1 := '00000';
       l_inigr1 := '          ';
       l_fimgr1 := '          ';
       l_grupo2 := '00000';
       l_inigr2 := '          ';
       l_fimgr2 := '          ';
       l_grupo3 := '00000';
       l_inigr3 := '          ';
       l_fimgr3 := '          ';

       l_fx_flg      := '0';
       l_tempo_alm   := '000';
       l_bloq_falta  := '0';
       l_ver_hora    := '0';
       l_ver_local   := '1';
       l_ver_valid   := '1';
       l_ver_afast   := '1';
       l_vis_esp     := p_bloaut;
       l_usaMulti    := FALSE;
       l_subnv       := '99000';
       l_gercrv      := 'N';
       l_concre      := 0;
       l_conrea      := 1;
       l_iniAR1      := '          ';
       l_fimAR1      := '          ';
       l_iniAR2      := '          ';
       l_fimAR2      := '          ';
       l_iniAR3      := '          ';
       l_fimAR3      := '          ';
       /*Biometria*/
       l_usabio      := 1;
       l_VerPrm      := 1;
       l_gracon      := 50;
       /*Interjornadas*/
       l_ConInt_int := 0;
       l_TolInt := 0;
       l_conpac := 0;
       l_tempac := 0;
       l_tolacp := 0;
       l_nomfun := '';
       l_numpis := 0;
       l_confai := 0;
       /*Busca versão do plano ativa*/
       BEGIN
           SELECT VERPLF INTO l_verplf
             FROM R058VPL
            WHERE DATCRI <= l_data_atual
              AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
       EXCEPTION
           WHEN OTHERS THEN
               l_verplf := 1;
       END;
       /*Se a data inicial for menor do que 1980, então considera como 01/01/1980*/
       l_datano := Year(p_datini);
       IF (l_datano < 1980) THEN
           l_inival := '0101802359000000';
       ELSE
           /*obtem a data inicial do crachá*/
           SP_DATSTR(p_datini,'DDMMYY',l_datstr_ini OUT);
           SP_INTSTR(p_horini,'HHMM',l_horstr_ini OUT);
           l_inival := l_datstr_ini||l_horstr_ini||'000000';
       END IF;

       /* créditos de acesso do tipo de visita */
       BEGIN
           SELECT GERCRV, CONCRE, CONADP, USABIO, GRACON, CONREA, CONFAI INTO l_gercrv, l_concre, l_conadp, l_usabio, l_gracon, l_conrea_str, l_confai
           FROM R090TVI WHERE TIPVIS = p_tipvis;
       EXCEPTION
           WHEN OTHERS THEN l_gercrv :='N';
                            l_concre := 0;
                            l_conadp := 'S';
                            l_usabio := 1;
                            l_gracon := 50;
                            l_conrea_str := 'S';
                            l_confai := 0;
       END;
       IF (l_concre IS NULL) THEN
         l_concre:= 0 ;
       END IF;
       SP_INTSTR(l_concre,'9',l_ver_cred OUT);

       IF  l_conadp = 'S' THEN
           l_anti_dupla  := '1';
       ELSE
           l_anti_dupla  := '0';
       END IF;

        IF  l_conrea_str = 'S' THEN
           l_conrea := 1;
       ELSE
           l_conrea := 0;
       END IF;

       l_desmsg := ' ';
       l_auxmsg := '                                ';
       l_qtdmsg := '00';
       l_datmsg := '                ';

       BEGIN
            SP_INTSTR(p_codprm,'99999',l_grupo OUT);
       EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'SP_VISPAC : Permissao deve ter valor de 0 a 99';
       END;

       l_grupo_sab := l_grupo;
       l_grupo_dom := l_grupo;
       l_grupo_fer := l_grupo;

       l_codig := '';
       l_idtpes := '';

       /* Para tipo de visita com tipo de pessoa terceiro (tippev = 2). */
       /* A telemática somente solicita o crachá no cofre se for tpfis = 4 (visitante) (tippev = 1). */
       IF   p_tippev = 1 THEN
            l_tipcra := 4;
       ELSE l_tipcra := 2;
       END IF;
       
       /* retorna os creditos de acesso  */
       SP_RETCRV (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
       SP_RETMSV (p_tipdoc, p_numdoc, l_desmsg OUT, l_datmsg OUT, l_qtdmsg OUT);
       SP_RETPEV (p_tipdoc, p_numdoc, p_numcra, l_grupo1 OUT, l_inigr1 OUT, l_fimgr1 OUT, l_grupo2 OUT, l_inigr2 OUT, l_fimgr2 OUT, l_grupo3 OUT, l_inigr3 OUT, l_fimgr3 OUT);
       /*Obtem o Tipo de Pessoa*/
       l_tippes:= '04';
       SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
       /*Monta o Identificador da Pessoa*/
       l_idtpes := l_tippes||l_tipdoc||p_numdoc;


       /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_idtpes) > 22) THEN
              EXIT;
          END IF;
          l_idtpes := ' '||l_idtpes;
      END LOOP;

       l_auxmsg := l_desmsg;
       IF (l_datmsg = '                ') THEN
          l_datmsgaux  := '0000000000000000';
       ELSE
          l_datmsgaux  := l_datmsg;
       END IF;

       l_situa  := '0';
       l_situaAnt:= '1';
       l_faixa  := '00002359240024002400240024002400240024002400240024002400';
       l_fairef := '24002400240024002400240024002400240024002400240024002400';

       SP_FaiVisPac(p_propac, l_fx_dom OUT, l_fx_seg OUT, l_fx_ter OUT, l_fx_qua OUT,
                    l_fx_qui OUT, l_fx_sex OUT, l_fx_sab OUT);

        l_iniAR1 := l_inigr1;
        IF  (l_inigr1 = '          ') THEN
            l_iniAR1 := '0000000000';
        END IF;

        l_fimAR1 := l_fimgr1;
        IF  (l_fimgr1 = '          ') THEN
            l_fimAR1 := '0000000000';
        END IF;

        IF  (l_grupo2 = '     ') THEN
            l_grupo2 := '00000';
        END IF;

        l_iniAR2 := l_inigr2;
        IF  (l_inigr2 = '          ') THEN
            l_iniAR2 := '0000000000';
        END IF;

        l_fimAR2 := l_fimgr2;
        IF  (l_fimgr2 = '          ') THEN
            l_fimAR2 := '0000000000';
        END IF;

        IF  (l_grupo3 = '     ') THEN
            l_grupo3 := '00000';
        END IF;

        l_iniAR3 := l_inigr3;
        IF  (l_inigr3 = '          ') THEN
            l_iniAR3 := '0000000000';
        END IF;

        l_fimAR3 := l_fimgr3;
        IF  (l_fimgr3 = '          ') THEN
            l_fimAR3 := '0000000000';
        END IF;

       SP_DATSTR(p_datval,'DDMMYY',l_datstr OUT);
       SP_INTSTR(p_horval,'HHMM',l_horstr OUT);
       /* corrige a data se vier com valor zero */
       IF  (l_datstr = '311200') THEN
           l_datstr :=  '311250';
       END IF;
       IF  (l_horstr = '0000') THEN
           l_horstr :=  '2359';
       END IF;
       l_datahora := l_datstr || l_horstr;
       l_auxval := l_datahora||'000000';
       l_datini := '      ';
       l_datfim := '      ';

       /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
       SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

       IF (l_crapri = 0) THEN
           l_crapri := p_numcra;
           /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
           l_teccra := 1;
       ELSE
           l_teccra := l_tecpri;
       END IF;

        /* Atualiza R070CON */
        l_comando_nulo:=FALSE;
        BEGIN
            SELECT NUMFIS,SITCRA INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_VISPAC: Erro em R070CON - TOO MANY ROWS';
            WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro no SELECT R070CON 5.';
        END;

        /* verifica se o crachá é de uma nova entrada */
        IF  (l_situaAnt = '1') THEN
            l_subnv := '99000';
        END IF;
        
        /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
        BEGIN
            SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON WHERE IDTPES = l_idtpes;
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro No SELECT R070CON (IdtPes).';
        END;

        IF (l_qtdIdtPes > 0) THEN
            l_iPerson := FALSE;
        ELSE
            l_iPerson := TRUE;
        END IF;

        /* verifica se possui registros na tabela R090VAU.. Se possuir, ValAut = 1 */
        l_count := 0;
        BEGIN
            SELECT COUNT(*) INTO l_count FROM R090VAU WHERE IDTPES = l_idtpes AND
                   (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                   (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro No SELECT R090VAU (IdtPes).';
        END;

        /* necessita de validação por autorizador */
        l_ValAut := 0;
        IF  (l_count > 0) THEN
            l_ValAut := 1;
        END IF;

		l_numcracex := 0;
        BEGIN
            SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
        EXCEPTION
        	WHEN OTHERS THEN NULL;
        END;
        
        IF (l_numcracex = p_numcra) THEN
          l_situa := '1';
        END IF;

        IF (l_comando_nulo = FALSE) THEN
            /* atualiza a tabela R070CON */
            BEGIN
                UPDATE R070CON SET
                       NUMCRA=p_numcra, TIPCRA=l_tipcra, SENCOL= l_codig,INIAFA= '0000000000000000',
                       DATAFA='0000000000000000',
                       CODPRM=p_codprm, PRMSAB=p_codprm, PRMDOM=p_codprm, PRMFER=p_codprm,
                       SITCRA=l_situa, INIVAL = l_inival, DATVAL=l_auxval,
                       MSGACC=l_desmsg, DATMSG=l_datmsgaux, QTDMSG=l_qtdmsg,
                       CONADP=l_anti_dupla, CONCRE=l_ver_cred,
                       PRMRT1=l_grupo1, DINPR1=l_iniAr1, DFNPR1=l_fimAr1,
                       PRMRT2=l_grupo2, DINPR2=l_iniAr2, DFNPR2=l_fimAr2,
                       PRMRT3=l_grupo3, DINPR3=l_iniAr3, DFNPR3=l_fimAr3,
                       TECCRA=l_teccra, CHCPRI=0, IDTPES=l_idtpes, USABIO=l_usabio, GRACON=l_gracon,
                       CONINT=l_conInt_Int, TOLINT=l_tolInt, CONPAC=l_conpac, TEMPAC=l_tempac,
                       TOLACP=l_tolacp, VALAUT=l_ValAut, NOMFUN=l_nomfun, NUMPIS=l_numpis,
                       VERAFA=0, CONFAI=l_confai,
                       FAIAC1=l_fx_dom, FAIAC2=l_fx_seg, FAIAC3=l_fx_ter, FAIAC4=l_fx_qua,
                       FAIAC5=l_fx_qui, FAIAC6=l_fx_sex, FAIAC7=l_fx_sab, CONREA=l_conrea,
                       RECVIS=0, NUMEMP=0, TIPCOL=0, NUMCAD=0, TIPDOC=p_tipdoc, NUMDOC=p_numdoc, NUMMAT='0', 
                       PROPAC=p_propac, NUMCAN=0, BLOAUT= l_vis_esp
                WHERE NUMFIS = l_crapri;

                /* Verifica se atualiza SubNv*/
                IF (p_subnv = 1) THEN
                  BEGIN
                      UPDATE R070CON SET
                           NIVATU = '99000', DATNIV = l_data_atual, HORNIV = l_hora_atual, SEQNIV = l_segu_atual
                      WHERE IDTPES = l_idtpes;
                      /*Gera pendência de atualização de nível*/
                      SP_PEND26(l_idtpes, '99000', l_data_atual, l_hora_atual, l_segu_atual);
                  EXCEPTION WHEN OTHERS THEN
                      RAISERROR 103 'SP_VISPAC: Erro Na Atualização de SPVISCON 2.';
                  END;
                END IF;

                /* Verifica se atualiza Créditos de Acesso*/
                IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
                    /*RESETA OS CRÉDITOS DO VISITANTE*/
                    l_atucreloc := TRUE; /* marca como atualizado os créditos da pessoa */
                    /*reseta os créditos da pessoa*/
                    SP_RESETCRED(4, 0, 0, 0, p_tipdoc, p_numdoc, '0', '0');
                END IF;

            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro Na Atualização de R070CON';
            END;
        ELSE
           /* insere na tabela R070CON */
           BEGIN
               INSERT INTO R070CON(
                           NUMCRA,NUMFIS,TIPCRA,SITCRA,NIVATU,DATNIV,HORNIV,SEQNIV,
                           INIVAL,DATVAL,INIAFA, DATAFA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                           SENCOL,MSGACC,DATMSG,QTDMSG,MSGATU,
                           CONIAL,TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,
                           CONPAC,TEMPAC,TOLACP,BLOAUT,BLOFAL,
                           CREAC1,CREFX1,QTDCR1,CREAC2,CREFX2,QTDCR2,
                           CREAC3,CREFX3,QTDCR3,CREAC4,CREFX4,QTDCR4,
                           CREAC5,CREFX5,QTDCR5,CREAC6,CREFX6,QTDCR6,
                           PRMRT1,DINPR1,DFNPR1,PRMRT2,DINPR2,DFNPR2,PRMRT3,DINPR3,DFNPR3,
                           FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,FAIAC7,
                           FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,FAIREF,
                           TECCRA,CHCPRI,IDTPES,GRACON,CONINT,TOLINT,VALAUT,
                           NOMFUN,NUMPIS,CONREA,RECVIS,NUMEMP,TIPCOL,NUMCAD,
                           TIPDOC,NUMDOC,NUMMAT,PROPAC,NUMCAN, PROPRE)
               VALUES(
                           p_numcra,l_crapri,l_tipcra,l_situa,l_subnv,l_data_atual,
                           l_hora_atual,l_segu_atual,l_inival,l_auxval,
                           '0000000000000000','0000000000000000',p_codprm,p_codprm,
                           p_codprm,p_codprm,l_codig,l_desmsg,l_datmsgaux,l_qtdmsg,l_qtdmsg,
                           0,0,0,l_usabio,l_VerPrm,l_confai,l_anti_dupla,l_concre,l_conpac,l_tempac,l_tolacp,l_vis_esp,0,
                           l_crefx1,l_fx1,l_crefx1,l_crefx2,l_fx2,l_crefx2,
                           l_crefx3,l_fx3,l_crefx3,l_crefx4,l_fx4,l_crefx4,
                           l_crefx5,l_fx5,l_crefx5,l_crefx6,l_fx6,l_crefx6,
                           l_grupo1,l_iniAr1,l_fimAr1,l_grupo2,l_iniAr2,l_fimAr2,
                           l_grupo3,l_iniAr3,l_fimAr3,
                           l_fx_dom,l_fx_seg,l_fx_ter,l_fx_qua,l_fx_qui,l_fx_sex,l_fx_sab,
                           l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                           l_fairef,l_teccra,0,l_idtpes,l_gracon,l_conInt_Int,l_tolInt,l_ValAut,
                           l_nomfun,l_numpis,l_conrea,0,0,0,0,
                           p_tipdoc,p_numdoc,'0',p_propac,0,0);
           EXCEPTION
               WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro no INSERT Tabela R070CON.';
           END;

        END IF;
        /*Atualiza Pend_Grupo*/
        IF (l_numsma > 0) THEN
            /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
            IF (l_tecpri = 3) THEN
                SP_ATUPRM(p_numcra, l_numsma, p_codprm, l_grupo1, l_grupo2, l_grupo3, p_codprm, p_codprm, p_codprm);
            ELSE
                SP_ATUPRM(l_crapri, l_numsma, p_codprm, l_grupo1, l_grupo2, l_grupo3, p_codprm, p_codprm, p_codprm);
            END IF;
        END IF;


        /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
        IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
            SP_PEND21(l_crapri);
        END IF;

        /*Atualiza os demais Crachás*/
        /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
        IF (l_tecpri = 1) THEN
            /*Atualiza o crachá de proximidade*/
            IF (l_numpro <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numpro, l_numpro_ret OUT);
                  /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numpro);
                END IF;
            END IF;
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
        ELSIF (l_tecpri = 2) THEN
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        END IF;
        /*Verifica se Gera o Comando IncludePerson*/
        IF (l_iPerson = TRUE) THEN
            /*Gera o Include Person*/
            SP_PEND19(p_numcra, l_idtpes);
            /*Atualiza os créditos somente se o mesmo já não foi atualizado*/
            IF (l_atucreloc = FALSE) THEN
                /*Atualiza os créditos sem local físico*/
                SP_PEND06(1, l_idtpes, l_verplf, 0);
                /*Atualiza os créditos por local físico da pessoa*/
                SP_ATUCRELOC(l_idtpes);
            END IF;
        END IF;
  END IF;
  IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
    l_creacc_bol := TRUE;
  ELSE
    l_creacc_bol := FALSE;
  END IF;
  IF (p_subnv = 1) THEN
    l_subnv_bol := TRUE;
  ELSE
    l_subnv_bol := FALSE;
  END IF;

  /*Atualiza a Controle*/
  SP_ATUTSI(l_idtpes, l_crapri, l_creacc_bol, TRUE, l_subnv_bol, TRUE);
  /*Atualiza tabela MatGrupo*/
  SP_MATGRP(p_numcra, 4, 0, 0, 0, p_tipdoc, p_numdoc, '');
END		SENIOR;22ÏSP_DATSTR
SP_INTSTR
SP_RETCRV
SP_RETMSV
SP_RETPEV
SP_FAIVISPAC
SP_MAPFIS
SP_PEND26
SP_RESETCRED
SP_ATUPRM
SP_PEND21
SP_VERCON
SP_ATUFIS
SP_PEND19
SP_PEND06
SP_ATUCRELOC
SP_ATUTSI
SP_MATGRP
h_␀␀


/* Historico de Cracha - Visitante de Paciente*/
PROCEDURE SP_VISPAC(P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER,P_PROPAC VARCHAR2(20),P_CODPRM NUMBER,P_DATINI DATE,P_HORINI NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_BLOAUT VARCHAR2(1),P_TIPPEV NUMBER(1),P_TIPVIS NUMBER,P_SUBNV NUMBER(1),P_CREACC NUMBER(1))
 IS

l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numpro_ret   BOOLEAN;
  l_numsma       NUMBER(12);
  l_numsma_ret   BOOLEAN;
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_teccra       NUMBER(1);
  l_inival       CHAR(16);
  l_grupo        CHAR(5);
  l_grupo_sab    CHAR(5);
  l_grupo_dom    CHAR(5);
  l_grupo_fer    CHAR(5);
  l_tipcra       NUMBER(2);
  l_codig        CHAR(6);
  l_situa        CHAR(1);
  l_situaAnt     CHAR(1);
  l_subnv        CHAR(5);
  l_faixa        CHAR(56);
  l_fx_dom       CHAR(56);
  l_fx_seg       CHAR(56);
  l_fx_ter       CHAR(56);
  l_fx_qua       CHAR(56);
  l_fx_qui       CHAR(56);
  l_fx_sex       CHAR(56);
  l_fx_sab       CHAR(56);
  l_fairef       CHAR(56);
  l_datahora     CHAR(10);
  l_desmsg       VARCHAR2(32);
  l_datmsg       CHAR(16);
  l_qtdmsg       CHAR(2);
  l_crefx1       CHAR(2);
  l_fx1          CHAR(8);
  l_crefx2       CHAR(2);
  l_fx2          CHAR(8);
  l_crefx3       CHAR(2);
  l_fx3          CHAR(8);
  l_crefx4       CHAR(2);
  l_fx4          CHAR(8);
  l_crefx5       CHAR(2);
  l_fx5          CHAR(8);
  l_crefx6       CHAR(2);
  l_fx6          CHAR(8);
  l_sequencia    NUMBER;
  l_auxmsg       CHAR(32);
  l_datmsgaux    CHAR(16);
  l_qtdIdtPes    NUMBER(2);
  l_count        NUMBER(4);
  l_iPerson      BOOLEAN;
  L_NODATAFOUND  BOOLEAN;
  l_datano       NUMBER(4);
  l_numcracex    NUMBER(12);

  /* Controle de Areas Restritas */
  l_grupo1       CHAR(5);
  l_inigr1       CHAR(10);
  l_fimgr1       CHAR(10);
  l_grupo2       CHAR(5);
  l_inigr2       CHAR(10);
  l_fimgr2       CHAR(10);
  l_grupo3       CHAR(5);
  l_inigr3       CHAR(10);
  l_fimgr3       CHAR(10);

  l_iniAR1       CHAR(10);
  l_fimAR1       CHAR(10);
  l_iniAR2       CHAR(10);
  l_fimAR2       CHAR(10);
  l_iniAR3       CHAR(10);
  l_fimAR3       CHAR(10);

  /* Definições de acesso por visitante */
  l_anti_dupla   CHAR(1); /* Controla Anti-Dupla */
  l_fx_flg       CHAR(1); /* Controla Intervalo de Almoço */
  l_tempo_alm    CHAR(3); /* Tempo Mínimo de Almoço (Minutos) */
  l_bloq_falta   CHAR(1); /* Bloqueia Acesso por Falta */
  l_ver_hora     CHAR(1); /* Controla Faixa Horária de Acesso */
  l_ver_local    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_valid    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_afast    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_cred     CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_vis_esp      CHAR(1); /* se for visitante especial bloqueia automaticamente na saida. */
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_tipdoc       CHAR(1);
  l_datini       CHAR(6);
  l_datfim       CHAR(6);
  l_numcra       CHAR(12);
  l_comando_nulo BOOLEAN;
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_datstr_ini   CHAR(6);
  l_horstr_ini   CHAR(4);
  l_conadp       CHAR(1);
  l_concre       NUMBER(1);
  l_conrea       NUMBER(1);
  l_usaMulti     BOOLEAN;  /*Utiliza multitecnologia (2 números físicos no mesmo crachá) */
  l_gercrv       CHAR(1);
  l_usabio       NUMBER(1);
  l_VerPrm       NUMBER(1);
  l_gracon       NUMBER(3);
  l_auxval       CHAR(16);
  l_tippes_str   CHAR(2);
  l_conrea_str   CHAR(1);
  l_creacc_bol   BOOLEAN;
  l_subnv_bol    BOOLEAN;
  l_ValAut       NUMBER(1);
  /*Interjornadas*/
  l_ConInt_int   NUMBER(1);
  l_TolInt       NUMBER(3);
  l_conpac       NUMBER(1);
  l_tempac       NUMBER(3);
  l_tolacp       NUMBER(2);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_segu_atual   NUMBER(2);
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_uticcr       CHAR(1);
  l_atucreloc    BOOLEAN;
  l_verplf       NUMBER(3);
  l_confai       NUMBER(1);
BEGIN
  l_atucreloc := FALSE;
  /* Busca parametro que indica se utiliza compra. */
  BEGIN
     SELECT UTICCR INTO l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_uticcr := 'N';
  END;

  /* Valida Cracha/Datas */
  IF   p_numcra > 0 THEN
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_segu_atual := SECOND(CURTIME());

       l_iPerson := FALSE;
       l_crefx1 := '00';
       l_crefx2 := '00';
       l_crefx3 := '00';
       l_crefx4 := '00';
       l_crefx5 := '00';
       l_crefx6 := '00';
       l_fx1 := '24002400';
       l_fx2 := '24002400';
       l_fx3 := '24002400';
       l_fx4 := '24002400';
       l_fx5 := '24002400';
       l_fx6 := '24002400';

      /* Inicializa Areas Restritas */
       l_grupo1 := '00000';
       l_inigr1 := '          ';
       l_fimgr1 := '          ';
       l_grupo2 := '00000';
       l_inigr2 := '          ';
       l_fimgr2 := '          ';
       l_grupo3 := '00000';
       l_inigr3 := '          ';
       l_fimgr3 := '          ';

       l_fx_flg      := '0';
       l_tempo_alm   := '000';
       l_bloq_falta  := '0';
       l_ver_hora    := '0';
       l_ver_local   := '1';
       l_ver_valid   := '1';
       l_ver_afast   := '1';
       l_vis_esp     := p_bloaut;
       l_usaMulti    := FALSE;
       l_subnv       := '99000';
       l_gercrv      := 'N';
       l_concre      := 0;
       l_conrea      := 1;
       l_iniAR1      := '          ';
       l_fimAR1      := '          ';
       l_iniAR2      := '          ';
       l_fimAR2      := '          ';
       l_iniAR3      := '          ';
       l_fimAR3      := '          ';
       /*Biometria*/
       l_usabio      := 1;
       l_VerPrm      := 1;
       l_gracon      := 50;
       /*Interjornadas*/
       l_ConInt_int := 0;
       l_TolInt := 0;
       l_conpac := 0;
       l_tempac := 0;
       l_tolacp := 0;
       l_nomfun := '';
       l_numpis := 0;
       l_confai := 0;
       /*Busca versão do plano ativa*/
       BEGIN
           SELECT VERPLF INTO l_verplf
             FROM R058VPL
            WHERE DATCRI <= l_data_atual
              AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
       EXCEPTION
           WHEN OTHERS THEN
               l_verplf := 1;
       END;
       /*Se a data inicial for menor do que 1980, então considera como 01/01/1980*/
       l_datano := Year(p_datini);
       IF (l_datano < 1980) THEN
           l_inival := '0101802359000000';
       ELSE
           /*obtem a data inicial do crachá*/
           SP_DATSTR(p_datini,'DDMMYY',l_datstr_ini OUT);
           SP_INTSTR(p_horini,'HHMM',l_horstr_ini OUT);
           l_inival := l_datstr_ini||l_horstr_ini||'000000';
       END IF;

       /* créditos de acesso do tipo de visita */
       BEGIN
           SELECT GERCRV, CONCRE, CONADP, USABIO, GRACON, CONREA, CONFAI INTO l_gercrv, l_concre, l_conadp, l_usabio, l_gracon, l_conrea_str, l_confai
           FROM R090TVI WHERE TIPVIS = p_tipvis;
       EXCEPTION
           WHEN OTHERS THEN l_gercrv :='N';
                            l_concre := 0;
                            l_conadp := 'S';
                            l_usabio := 1;
                            l_gracon := 50;
                            l_conrea_str := 'S';
                            l_confai := 0;
       END;
       IF (l_concre IS NULL) THEN
         l_concre:= 0 ;
       END IF;
       SP_INTSTR(l_concre,'9',l_ver_cred OUT);

       IF  l_conadp = 'S' THEN
           l_anti_dupla  := '1';
       ELSE
           l_anti_dupla  := '0';
       END IF;

        IF  l_conrea_str = 'S' THEN
           l_conrea := 1;
       ELSE
           l_conrea := 0;
       END IF;

       l_desmsg := ' ';
       l_auxmsg := '                                ';
       l_qtdmsg := '00';
       l_datmsg := '                ';

       BEGIN
            SP_INTSTR(p_codprm,'99999',l_grupo OUT);
       EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'SP_VISPAC : Permissao deve ter valor de 0 a 99';
       END;

       l_grupo_sab := l_grupo;
       l_grupo_dom := l_grupo;
       l_grupo_fer := l_grupo;

       l_codig := '';
       l_idtpes := '';

       /* Para tipo de visita com tipo de pessoa terceiro (tippev = 2). */
       /* A telemática somente solicita o crachá no cofre se for tpfis = 4 (visitante) (tippev = 1). */
       IF   p_tippev = 1 THEN
            l_tipcra := 4;
       ELSE l_tipcra := 2;
       END IF;
       
       /* retorna os creditos de acesso  */
       SP_RETCRV (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
       SP_RETMSV (p_tipdoc, p_numdoc, l_desmsg OUT, l_datmsg OUT, l_qtdmsg OUT);
       SP_RETPEV (p_tipdoc, p_numdoc, p_numcra, l_grupo1 OUT, l_inigr1 OUT, l_fimgr1 OUT, l_grupo2 OUT, l_inigr2 OUT, l_fimgr2 OUT, l_grupo3 OUT, l_inigr3 OUT, l_fimgr3 OUT);
       /*Obtem o Tipo de Pessoa*/
       l_tippes:= '04';
       SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
       /*Monta o Identificador da Pessoa*/
       l_idtpes := l_tippes||l_tipdoc||p_numdoc;


       /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_idtpes) > 22) THEN
              EXIT;
          END IF;
          l_idtpes := ' '||l_idtpes;
      END LOOP;

       l_auxmsg := l_desmsg;
       IF (l_datmsg = '                ') THEN
          l_datmsgaux  := '0000000000000000';
       ELSE
          l_datmsgaux  := l_datmsg;
       END IF;

       l_situa  := '0';
       l_situaAnt:= '1';
       l_faixa  := '00002359240024002400240024002400240024002400240024002400';
       l_fairef := '24002400240024002400240024002400240024002400240024002400';

       SP_FaiVisPac(p_propac, l_fx_dom OUT, l_fx_seg OUT, l_fx_ter OUT, l_fx_qua OUT,
                    l_fx_qui OUT, l_fx_sex OUT, l_fx_sab OUT);

        l_iniAR1 := l_inigr1;
        IF  (l_inigr1 = '          ') THEN
            l_iniAR1 := '0000000000';
        END IF;

        l_fimAR1 := l_fimgr1;
        IF  (l_fimgr1 = '          ') THEN
            l_fimAR1 := '0000000000';
        END IF;

        IF  (l_grupo2 = '     ') THEN
            l_grupo2 := '00000';
        END IF;

        l_iniAR2 := l_inigr2;
        IF  (l_inigr2 = '          ') THEN
            l_iniAR2 := '0000000000';
        END IF;

        l_fimAR2 := l_fimgr2;
        IF  (l_fimgr2 = '          ') THEN
            l_fimAR2 := '0000000000';
        END IF;

        IF  (l_grupo3 = '     ') THEN
            l_grupo3 := '00000';
        END IF;

        l_iniAR3 := l_inigr3;
        IF  (l_inigr3 = '          ') THEN
            l_iniAR3 := '0000000000';
        END IF;

        l_fimAR3 := l_fimgr3;
        IF  (l_fimgr3 = '          ') THEN
            l_fimAR3 := '0000000000';
        END IF;

       SP_DATSTR(p_datval,'DDMMYY',l_datstr OUT);
       SP_INTSTR(p_horval,'HHMM',l_horstr OUT);
       /* corrige a data se vier com valor zero */
       IF  (l_datstr = '311200') THEN
           l_datstr :=  '311250';
       END IF;
       IF  (l_horstr = '0000') THEN
           l_horstr :=  '2359';
       END IF;
       l_datahora := l_datstr || l_horstr;
       l_auxval := l_datahora||'000000';
       l_datini := '      ';
       l_datfim := '      ';

       /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
       SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

       IF (l_crapri = 0) THEN
           l_crapri := p_numcra;
           /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
           l_teccra := 1;
       ELSE
           l_teccra := l_tecpri;
       END IF;

        /* Atualiza R070CON */
        l_comando_nulo:=FALSE;
        BEGIN
            SELECT NUMFIS,SITCRA INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_VISPAC: Erro em R070CON - TOO MANY ROWS';
            WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro no SELECT R070CON 5.';
        END;

        /* verifica se o crachá é de uma nova entrada */
        IF  (l_situaAnt = '1') THEN
            l_subnv := '99000';
        END IF;
        
        /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
        BEGIN
            SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON WHERE IDTPES = l_idtpes;
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro No SELECT R070CON (IdtPes).';
        END;

        IF (l_qtdIdtPes > 0) THEN
            l_iPerson := FALSE;
        ELSE
            l_iPerson := TRUE;
        END IF;

        /* verifica se possui registros na tabela R090VAU.. Se possuir, ValAut = 1 */
        l_count := 0;
        BEGIN
            SELECT COUNT(*) INTO l_count FROM R090VAU WHERE IDTPES = l_idtpes AND
                   (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                   (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro No SELECT R090VAU (IdtPes).';
        END;

        /* necessita de validação por autorizador */
        l_ValAut := 0;
        IF  (l_count > 0) THEN
            l_ValAut := 1;
        END IF;

		l_numcracex := 0;
        BEGIN
            SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
        EXCEPTION
        	WHEN OTHERS THEN NULL;
        END;
        
        IF (l_numcracex = p_numcra) THEN
          l_situa := '1';
        END IF;

        IF (l_comando_nulo = FALSE) THEN
            /* atualiza a tabela R070CON */
            BEGIN
                UPDATE R070CON SET
                       NUMCRA=p_numcra, TIPCRA=l_tipcra, SENCOL= l_codig,INIAFA= '0000000000000000',
                       DATAFA='0000000000000000',
                       CODPRM=p_codprm, PRMSAB=p_codprm, PRMDOM=p_codprm, PRMFER=p_codprm,
                       SITCRA=l_situa, INIVAL = l_inival, DATVAL=l_auxval,
                       MSGACC=l_desmsg, DATMSG=l_datmsgaux, QTDMSG=l_qtdmsg,
                       CONADP=l_anti_dupla, CONCRE=l_ver_cred,
                       PRMRT1=l_grupo1, DINPR1=l_iniAr1, DFNPR1=l_fimAr1,
                       PRMRT2=l_grupo2, DINPR2=l_iniAr2, DFNPR2=l_fimAr2,
                       PRMRT3=l_grupo3, DINPR3=l_iniAr3, DFNPR3=l_fimAr3,
                       TECCRA=l_teccra, CHCPRI=0, IDTPES=l_idtpes, USABIO=l_usabio, GRACON=l_gracon,
                       CONINT=l_conInt_Int, TOLINT=l_tolInt, CONPAC=l_conpac, TEMPAC=l_tempac,
                       TOLACP=l_tolacp, VALAUT=l_ValAut, NOMFUN=l_nomfun, NUMPIS=l_numpis,
                       VERAFA=0, CONFAI=l_confai,
                       FAIAC1=l_fx_dom, FAIAC2=l_fx_seg, FAIAC3=l_fx_ter, FAIAC4=l_fx_qua,
                       FAIAC5=l_fx_qui, FAIAC6=l_fx_sex, FAIAC7=l_fx_sab, CONREA=l_conrea,
                       RECVIS=0, NUMEMP=0, TIPCOL=0, NUMCAD=0, TIPDOC=p_tipdoc, NUMDOC=p_numdoc, NUMMAT='0', 
                       PROPAC=p_propac, NUMCAN=0, BLOAUT= l_vis_esp
                WHERE NUMFIS = l_crapri;

                /* Verifica se atualiza SubNv*/
                IF (p_subnv = 1) THEN
                  BEGIN
                      UPDATE R070CON SET
                           NIVATU = '99000', DATNIV = l_data_atual, HORNIV = l_hora_atual, SEQNIV = l_segu_atual
                      WHERE IDTPES = l_idtpes;
                      /*Gera pendência de atualização de nível*/
                      SP_PEND26(l_idtpes, '99000', l_data_atual, l_hora_atual, l_segu_atual);
                  EXCEPTION WHEN OTHERS THEN
                      RAISERROR 103 'SP_VISPAC: Erro Na Atualização de SPVISCON 2.';
                  END;
                END IF;

                /* Verifica se atualiza Créditos de Acesso*/
                IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
                    /*RESETA OS CRÉDITOS DO VISITANTE*/
                    l_atucreloc := TRUE; /* marca como atualizado os créditos da pessoa */
                    /*reseta os créditos da pessoa*/
                    SP_RESETCRED(4, 0, 0, 0, p_tipdoc, p_numdoc, '0', '0');
                END IF;

            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro Na Atualização de R070CON';
            END;
        ELSE
           /* insere na tabela R070CON */
           BEGIN
               INSERT INTO R070CON(
                           NUMCRA,NUMFIS,TIPCRA,SITCRA,NIVATU,DATNIV,HORNIV,SEQNIV,
                           INIVAL,DATVAL,INIAFA, DATAFA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                           SENCOL,MSGACC,DATMSG,QTDMSG,MSGATU,
                           CONIAL,TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,
                           CONPAC,TEMPAC,TOLACP,BLOAUT,BLOFAL,
                           CREAC1,CREFX1,QTDCR1,CREAC2,CREFX2,QTDCR2,
                           CREAC3,CREFX3,QTDCR3,CREAC4,CREFX4,QTDCR4,
                           CREAC5,CREFX5,QTDCR5,CREAC6,CREFX6,QTDCR6,
                           PRMRT1,DINPR1,DFNPR1,PRMRT2,DINPR2,DFNPR2,PRMRT3,DINPR3,DFNPR3,
                           FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,FAIAC7,
                           FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,FAIREF,
                           TECCRA,CHCPRI,IDTPES,GRACON,CONINT,TOLINT,VALAUT,
                           NOMFUN,NUMPIS,CONREA,RECVIS,NUMEMP,TIPCOL,NUMCAD,
                           TIPDOC,NUMDOC,NUMMAT,PROPAC,NUMCAN, PROPRE)
               VALUES(
                           p_numcra,l_crapri,l_tipcra,l_situa,l_subnv,l_data_atual,
                           l_hora_atual,l_segu_atual,l_inival,l_auxval,
                           '0000000000000000','0000000000000000',p_codprm,p_codprm,
                           p_codprm,p_codprm,l_codig,l_desmsg,l_datmsgaux,l_qtdmsg,l_qtdmsg,
                           0,0,0,l_usabio,l_VerPrm,l_confai,l_anti_dupla,l_concre,l_conpac,l_tempac,l_tolacp,l_vis_esp,0,
                           l_crefx1,l_fx1,l_crefx1,l_crefx2,l_fx2,l_crefx2,
                           l_crefx3,l_fx3,l_crefx3,l_crefx4,l_fx4,l_crefx4,
                           l_crefx5,l_fx5,l_crefx5,l_crefx6,l_fx6,l_crefx6,
                           l_grupo1,l_iniAr1,l_fimAr1,l_grupo2,l_iniAr2,l_fimAr2,
                           l_grupo3,l_iniAr3,l_fimAr3,
                           l_fx_dom,l_fx_seg,l_fx_ter,l_fx_qua,l_fx_qui,l_fx_sex,l_fx_sab,
                           l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                           l_fairef,l_teccra,0,l_idtpes,l_gracon,l_conInt_Int,l_tolInt,l_ValAut,
                           l_nomfun,l_numpis,l_conrea,0,0,0,0,
                           p_tipdoc,p_numdoc,'0',p_propac,0,0);
           EXCEPTION
               WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro no INSERT Tabela R070CON.';
           END;

        END IF;
        /*Atualiza Pend_Grupo*/
        IF (l_numsma > 0) THEN
            /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
            IF (l_tecpri = 3) THEN
                SP_ATUPRM(p_numcra, l_numsma, p_codprm, l_grupo1, l_grupo2, l_grupo3, p_codprm, p_codprm, p_codprm);
            ELSE
                SP_ATUPRM(l_crapri, l_numsma, p_codprm, l_grupo1, l_grupo2, l_grupo3, p_codprm, p_codprm, p_codprm);
            END IF;
        END IF;


        /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
        IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
            SP_PEND21(l_crapri);
        END IF;

        /*Atualiza os demais Crachás*/
        /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
        IF (l_tecpri = 1) THEN
            /*Atualiza o crachá de proximidade*/
            IF (l_numpro <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numpro, l_numpro_ret OUT);
                  /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numpro);
                END IF;
            END IF;
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
        ELSIF (l_tecpri = 2) THEN
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        END IF;
        /*Verifica se Gera o Comando IncludePerson*/
        IF (l_iPerson = TRUE) THEN
            /*Gera o Include Person*/
            SP_PEND19(p_numcra, l_idtpes);
            /*Atualiza os créditos somente se o mesmo já não foi atualizado*/
            IF (l_atucreloc = FALSE) THEN
                /*Atualiza os créditos sem local físico*/
                SP_PEND06(1, l_idtpes, l_verplf, 0);
                /*Atualiza os créditos por local físico da pessoa*/
                SP_ATUCRELOC(l_idtpes);
            END IF;
        END IF;
  END IF;
  IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
    l_creacc_bol := TRUE;
  ELSE
    l_creacc_bol := FALSE;
  END IF;
  IF (p_subnv = 1) THEN
    l_subnv_bol := TRUE;
  ELSE
    l_subnv_bol := FALSE;
  END IF;

  /*Atualiza a Controle*/
  SP_ATUTSI(l_idtpes, l_crapri, l_creacc_bol, TRUE, l_subnv_bol, TRUE);
  /*Atualiza tabela MatGrupo*/
  SP_MATGRP(p_numcra, 4, 0, 0, 0, p_tipdoc, p_numdoc, '');
END		SENIOR;23ÏSP_DATSTR
SP_INTSTR
SP_RETCRV
SP_RETMSV
SP_RETPEV
SP_FAIVISPAC
SP_MAPFIS
SP_PEND26
SP_RESETCRED
SP_ATUPRM
SP_PEND21
SP_VERCON
SP_ATUFIS
SP_PEND19
SP_PEND06
SP_ATUCRELOC
SP_ATUTSI
SP_MATGRP
h_␀␀


/* Historico de Cracha - Visitante de Paciente*/
PROCEDURE SP_VISPAC(P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER,P_PROPAC VARCHAR2(20),P_CODPRM NUMBER,P_DATINI DATE,P_HORINI NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_BLOAUT VARCHAR2(1),P_TIPPEV NUMBER(1),P_TIPVIS NUMBER,P_SUBNV NUMBER(1),P_CREACC NUMBER(1))
 IS

l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numpro_ret   BOOLEAN;
  l_numsma       NUMBER(12);
  l_numsma_ret   BOOLEAN;
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_teccra       NUMBER(1);
  l_inival       CHAR(16);
  l_grupo        CHAR(5);
  l_grupo_sab    CHAR(5);
  l_grupo_dom    CHAR(5);
  l_grupo_fer    CHAR(5);
  l_tipcra       NUMBER(2);
  l_codig        CHAR(6);
  l_situa        CHAR(1);
  l_situaAnt     CHAR(1);
  l_subnv        CHAR(5);
  l_faixa        CHAR(56);
  l_fx_dom       CHAR(56);
  l_fx_seg       CHAR(56);
  l_fx_ter       CHAR(56);
  l_fx_qua       CHAR(56);
  l_fx_qui       CHAR(56);
  l_fx_sex       CHAR(56);
  l_fx_sab       CHAR(56);
  l_fairef       CHAR(56);
  l_datahora     CHAR(10);
  l_desmsg       VARCHAR2(32);
  l_datmsg       CHAR(16);
  l_qtdmsg       CHAR(2);
  l_crefx1       CHAR(2);
  l_fx1          CHAR(8);
  l_crefx2       CHAR(2);
  l_fx2          CHAR(8);
  l_crefx3       CHAR(2);
  l_fx3          CHAR(8);
  l_crefx4       CHAR(2);
  l_fx4          CHAR(8);
  l_crefx5       CHAR(2);
  l_fx5          CHAR(8);
  l_crefx6       CHAR(2);
  l_fx6          CHAR(8);
  l_sequencia    NUMBER;
  l_auxmsg       CHAR(32);
  l_datmsgaux    CHAR(16);
  l_qtdIdtPes    NUMBER(2);
  l_count        NUMBER(4);
  l_iPerson      BOOLEAN;
  L_NODATAFOUND  BOOLEAN;
  l_datano       NUMBER(4);
  l_numcracex    NUMBER(12);

  /* Controle de Areas Restritas */
  l_grupo1       CHAR(5);
  l_inigr1       CHAR(10);
  l_fimgr1       CHAR(10);
  l_grupo2       CHAR(5);
  l_inigr2       CHAR(10);
  l_fimgr2       CHAR(10);
  l_grupo3       CHAR(5);
  l_inigr3       CHAR(10);
  l_fimgr3       CHAR(10);

  l_iniAR1       CHAR(10);
  l_fimAR1       CHAR(10);
  l_iniAR2       CHAR(10);
  l_fimAR2       CHAR(10);
  l_iniAR3       CHAR(10);
  l_fimAR3       CHAR(10);

  /* Definições de acesso por visitante */
  l_anti_dupla   CHAR(1); /* Controla Anti-Dupla */
  l_fx_flg       CHAR(1); /* Controla Intervalo de Almoço */
  l_tempo_alm    CHAR(3); /* Tempo Mínimo de Almoço (Minutos) */
  l_bloq_falta   CHAR(1); /* Bloqueia Acesso por Falta */
  l_ver_hora     CHAR(1); /* Controla Faixa Horária de Acesso */
  l_ver_local    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_valid    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_afast    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_cred     CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_vis_esp      CHAR(1); /* se for visitante especial bloqueia automaticamente na saida. */
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_tipdoc       CHAR(1);
  l_datini       CHAR(6);
  l_datfim       CHAR(6);
  l_numcra       CHAR(12);
  l_comando_nulo BOOLEAN;
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_datstr_ini   CHAR(6);
  l_horstr_ini   CHAR(4);
  l_conadp       CHAR(1);
  l_concre       NUMBER(1);
  l_conrea       NUMBER(1);
  l_usaMulti     BOOLEAN;  /*Utiliza multitecnologia (2 números físicos no mesmo crachá) */
  l_gercrv       CHAR(1);
  l_usabio       NUMBER(1);
  l_VerPrm       NUMBER(1);
  l_gracon       NUMBER(3);
  l_auxval       CHAR(16);
  l_tippes_str   CHAR(2);
  l_conrea_str   CHAR(1);
  l_creacc_bol   BOOLEAN;
  l_subnv_bol    BOOLEAN;
  l_ValAut       NUMBER(1);
  /*Interjornadas*/
  l_ConInt_int   NUMBER(1);
  l_TolInt       NUMBER(3);
  l_conpac       NUMBER(1);
  l_tempac       NUMBER(3);
  l_tolacp       NUMBER(2);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_segu_atual   NUMBER(2);
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_uticcr       CHAR(1);
  l_atucreloc    BOOLEAN;
  l_verplf       NUMBER(3);
  l_confai       NUMBER(1);
BEGIN
  l_atucreloc := FALSE;
  /* Busca parametro que indica se utiliza compra. */
  BEGIN
     SELECT UTICCR INTO l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_uticcr := 'N';
  END;

  /* Valida Cracha/Datas */
  IF   p_numcra > 0 THEN
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_segu_atual := SECOND(CURTIME());

       l_iPerson := FALSE;
       l_crefx1 := '00';
       l_crefx2 := '00';
       l_crefx3 := '00';
       l_crefx4 := '00';
       l_crefx5 := '00';
       l_crefx6 := '00';
       l_fx1 := '24002400';
       l_fx2 := '24002400';
       l_fx3 := '24002400';
       l_fx4 := '24002400';
       l_fx5 := '24002400';
       l_fx6 := '24002400';

      /* Inicializa Areas Restritas */
       l_grupo1 := '00000';
       l_inigr1 := '          ';
       l_fimgr1 := '          ';
       l_grupo2 := '00000';
       l_inigr2 := '          ';
       l_fimgr2 := '          ';
       l_grupo3 := '00000';
       l_inigr3 := '          ';
       l_fimgr3 := '          ';

       l_fx_flg      := '0';
       l_tempo_alm   := '000';
       l_bloq_falta  := '0';
       l_ver_hora    := '0';
       l_ver_local   := '1';
       l_ver_valid   := '1';
       l_ver_afast   := '1';
       l_vis_esp     := p_bloaut;
       l_usaMulti    := FALSE;
       l_subnv       := '99000';
       l_gercrv      := 'N';
       l_concre      := 0;
       l_conrea      := 1;
       l_iniAR1      := '          ';
       l_fimAR1      := '          ';
       l_iniAR2      := '          ';
       l_fimAR2      := '          ';
       l_iniAR3      := '          ';
       l_fimAR3      := '          ';
       /*Biometria*/
       l_usabio      := 1;
       l_VerPrm      := 1;
       l_gracon      := 50;
       /*Interjornadas*/
       l_ConInt_int := 0;
       l_TolInt := 0;
       l_conpac := 0;
       l_tempac := 0;
       l_tolacp := 0;
       l_nomfun := '';
       l_numpis := 0;
       l_confai := 0;
       /*Busca versão do plano ativa*/
       BEGIN
           SELECT VERPLF INTO l_verplf
             FROM R058VPL
            WHERE DATCRI <= l_data_atual
              AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
       EXCEPTION
           WHEN OTHERS THEN
               l_verplf := 1;
       END;
       /*Se a data inicial for menor do que 1980, então considera como 01/01/1980*/
       l_datano := Year(p_datini);
       IF (l_datano < 1980) THEN
           l_inival := '0101802359000000';
       ELSE
           /*obtem a data inicial do crachá*/
           SP_DATSTR(p_datini,'DDMMYY',l_datstr_ini OUT);
           SP_INTSTR(p_horini,'HHMM',l_horstr_ini OUT);
           l_inival := l_datstr_ini||l_horstr_ini||'000000';
       END IF;

       /* créditos de acesso do tipo de visita */
       BEGIN
           SELECT GERCRV, CONCRE, CONADP, USABIO, GRACON, CONREA, CONFAI INTO l_gercrv, l_concre, l_conadp, l_usabio, l_gracon, l_conrea_str, l_confai
           FROM R090TVI WHERE TIPVIS = p_tipvis;
       EXCEPTION
           WHEN OTHERS THEN l_gercrv :='N';
                            l_concre := 0;
                            l_conadp := 'S';
                            l_usabio := 1;
                            l_gracon := 50;
                            l_conrea_str := 'S';
                            l_confai := 0;
       END;
       IF (l_concre IS NULL) THEN
         l_concre:= 0 ;
       END IF;
       SP_INTSTR(l_concre,'9',l_ver_cred OUT);

       IF  l_conadp = 'S' THEN
           l_anti_dupla  := '1';
       ELSE
           l_anti_dupla  := '0';
       END IF;

        IF  l_conrea_str = 'S' THEN
           l_conrea := 1;
       ELSE
           l_conrea := 0;
       END IF;

       l_desmsg := ' ';
       l_auxmsg := '                                ';
       l_qtdmsg := '00';
       l_datmsg := '                ';

       BEGIN
            SP_INTSTR(p_codprm,'99999',l_grupo OUT);
       EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'SP_VISPAC : Permissao deve ter valor de 0 a 99';
       END;

       l_grupo_sab := l_grupo;
       l_grupo_dom := l_grupo;
       l_grupo_fer := l_grupo;

       l_codig := '';
       l_idtpes := '';

       /* Para tipo de visita com tipo de pessoa terceiro (tippev = 2). */
       /* A telemática somente solicita o crachá no cofre se for tpfis = 4 (visitante) (tippev = 1). */
       IF   p_tippev = 1 THEN
            l_tipcra := 4;
       ELSE l_tipcra := 2;
       END IF;
       
       /* retorna os creditos de acesso  */
       SP_RETCRV (p_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);
       SP_RETMSV (p_tipdoc, p_numdoc, l_desmsg OUT, l_datmsg OUT, l_qtdmsg OUT);
       SP_RETPEV (p_tipdoc, p_numdoc, p_numcra, l_grupo1 OUT, l_inigr1 OUT, l_fimgr1 OUT, l_grupo2 OUT, l_inigr2 OUT, l_fimgr2 OUT, l_grupo3 OUT, l_inigr3 OUT, l_fimgr3 OUT);
       /*Obtem o Tipo de Pessoa*/
       l_tippes:= '04';
       SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
       /*Monta o Identificador da Pessoa*/
       l_idtpes := l_tippes||l_tipdoc||p_numdoc;


       /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_idtpes) > 22) THEN
              EXIT;
          END IF;
          l_idtpes := ' '||l_idtpes;
      END LOOP;

       l_auxmsg := l_desmsg;
       IF (l_datmsg = '                ') THEN
          l_datmsgaux  := '0000000000000000';
       ELSE
          l_datmsgaux  := l_datmsg;
       END IF;

       l_situa  := '0';
       l_situaAnt:= '1';
       l_faixa  := '00002359240024002400240024002400240024002400240024002400';
       l_fairef := '24002400240024002400240024002400240024002400240024002400';

       SP_FaiVisPac(p_propac, l_fx_dom OUT, l_fx_seg OUT, l_fx_ter OUT, l_fx_qua OUT,
                    l_fx_qui OUT, l_fx_sex OUT, l_fx_sab OUT);

        l_iniAR1 := l_inigr1;
        IF  (l_inigr1 = '          ') THEN
            l_iniAR1 := '0000000000';
        END IF;

        l_fimAR1 := l_fimgr1;
        IF  (l_fimgr1 = '          ') THEN
            l_fimAR1 := '0000000000';
        END IF;

        IF  (l_grupo2 = '     ') THEN
            l_grupo2 := '00000';
        END IF;

        l_iniAR2 := l_inigr2;
        IF  (l_inigr2 = '          ') THEN
            l_iniAR2 := '0000000000';
        END IF;

        l_fimAR2 := l_fimgr2;
        IF  (l_fimgr2 = '          ') THEN
            l_fimAR2 := '0000000000';
        END IF;

        IF  (l_grupo3 = '     ') THEN
            l_grupo3 := '00000';
        END IF;

        l_iniAR3 := l_inigr3;
        IF  (l_inigr3 = '          ') THEN
            l_iniAR3 := '0000000000';
        END IF;

        l_fimAR3 := l_fimgr3;
        IF  (l_fimgr3 = '          ') THEN
            l_fimAR3 := '0000000000';
        END IF;

       SP_DATSTR(p_datval,'DDMMYY',l_datstr OUT);
       SP_INTSTR(p_horval,'HHMM',l_horstr OUT);
       /* corrige a data se vier com valor zero */
       IF  (l_datstr = '311200') THEN
           l_datstr :=  '311250';
       END IF;
       IF  (l_horstr = '0000') THEN
           l_horstr :=  '2359';
       END IF;
       l_datahora := l_datstr || l_horstr;
       l_auxval := l_datahora||'000000';
       l_datini := '      ';
       l_datfim := '      ';

       /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
       SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

       IF (l_crapri = 0) THEN
           l_crapri := p_numcra;
           /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
           l_teccra := 1;
       ELSE
           l_teccra := l_tecpri;
       END IF;

        /* Atualiza R070CON */
        l_comando_nulo:=FALSE;
        BEGIN
            SELECT NUMFIS,SITCRA INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_VISPAC: Erro em R070CON - TOO MANY ROWS';
            WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro no SELECT R070CON 5.';
        END;

        /* verifica se o crachá é de uma nova entrada */
        IF  (l_situaAnt = '1') THEN
            l_subnv := '99000';
        END IF;
        
        /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
        BEGIN
            SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON WHERE IDTPES = l_idtpes;
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro No SELECT R070CON (IdtPes).';
        END;

        IF (l_qtdIdtPes > 0) THEN
            l_iPerson := FALSE;
        ELSE
            l_iPerson := TRUE;
        END IF;

        /* verifica se possui registros na tabela R090VAU.. Se possuir, ValAut = 1 */
        l_count := 0;
        BEGIN
            SELECT COUNT(*) INTO l_count FROM R090VAU WHERE IDTPES = l_idtpes AND
                   (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                   (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro No SELECT R090VAU (IdtPes).';
        END;

        /* necessita de validação por autorizador */
        l_ValAut := 0;
        IF  (l_count > 0) THEN
            l_ValAut := 1;
        END IF;

		l_numcracex := 0;
        BEGIN
            SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
        EXCEPTION
        	WHEN OTHERS THEN NULL;
        END;
        
        IF (l_numcracex = p_numcra) THEN
          l_situa := '1';
        END IF;

        IF (l_comando_nulo = FALSE) THEN
            /* atualiza a tabela R070CON */
            BEGIN
                UPDATE R070CON SET
                       NUMCRA=p_numcra, TIPCRA=l_tipcra, SENCOL= l_codig,INIAFA= '0000000000000000',
                       DATAFA='0000000000000000',
                       CODPRM=p_codprm, PRMSAB=p_codprm, PRMDOM=p_codprm, PRMFER=p_codprm,
                       SITCRA=l_situa, INIVAL = l_inival, DATVAL=l_auxval,
                       MSGACC=l_desmsg, DATMSG=l_datmsgaux, QTDMSG=l_qtdmsg,
                       CONADP=l_anti_dupla, CONCRE=l_ver_cred,
                       PRMRT1=l_grupo1, DINPR1=l_iniAr1, DFNPR1=l_fimAr1,
                       PRMRT2=l_grupo2, DINPR2=l_iniAr2, DFNPR2=l_fimAr2,
                       PRMRT3=l_grupo3, DINPR3=l_iniAr3, DFNPR3=l_fimAr3,
                       TECCRA=l_teccra, CHCPRI=0, IDTPES=l_idtpes, USABIO=l_usabio, GRACON=l_gracon,
                       CONINT=l_conInt_Int, TOLINT=l_tolInt, CONPAC=l_conpac, TEMPAC=l_tempac,
                       TOLACP=l_tolacp, VALAUT=l_ValAut, NOMFUN=l_nomfun, NUMPIS=l_numpis,
                       VERAFA=0, CONFAI=l_confai,
                       FAIAC1=l_fx_dom, FAIAC2=l_fx_seg, FAIAC3=l_fx_ter, FAIAC4=l_fx_qua,
                       FAIAC5=l_fx_qui, FAIAC6=l_fx_sex, FAIAC7=l_fx_sab, CONREA=l_conrea,
                       RECVIS=0, NUMEMP=0, TIPCOL=0, NUMCAD=0, TIPDOC=p_tipdoc, NUMDOC=p_numdoc, NUMMAT='0', 
                       PROPAC=p_propac, NUMCAN=0, BLOAUT= l_vis_esp
                WHERE NUMFIS = l_crapri;

                /* Verifica se atualiza SubNv*/
                IF (p_subnv = 1) THEN
                  BEGIN
                      UPDATE R070CON SET
                           NIVATU = '99000', DATNIV = l_data_atual, HORNIV = l_hora_atual, SEQNIV = l_segu_atual
                      WHERE IDTPES = l_idtpes;
                      /*Gera pendência de atualização de nível*/
                      SP_PEND26(l_idtpes, '99000', l_data_atual, l_hora_atual, l_segu_atual);
                  EXCEPTION WHEN OTHERS THEN
                      RAISERROR 103 'SP_VISPAC: Erro Na Atualização de SPVISCON 2.';
                  END;
                END IF;

                /* Verifica se atualiza Créditos de Acesso*/
                IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
                    /*RESETA OS CRÉDITOS DO VISITANTE*/
                    l_atucreloc := TRUE; /* marca como atualizado os créditos da pessoa */
                    /*reseta os créditos da pessoa*/
                    SP_RESETCRED(4, 0, 0, 0, p_tipdoc, p_numdoc, '0', '0');
                END IF;

            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro Na Atualização de R070CON';
            END;
        ELSE
           /* insere na tabela R070CON */
           BEGIN
               INSERT INTO R070CON(
                           NUMCRA,NUMFIS,TIPCRA,SITCRA,NIVATU,DATNIV,HORNIV,SEQNIV,
                           INIVAL,DATVAL,INIAFA, DATAFA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                           SENCOL,MSGACC,DATMSG,QTDMSG,MSGATU,
                           CONIAL,TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,
                           CONPAC,TEMPAC,TOLACP,BLOAUT,BLOFAL,
                           CREAC1,CREFX1,QTDCR1,CREAC2,CREFX2,QTDCR2,
                           CREAC3,CREFX3,QTDCR3,CREAC4,CREFX4,QTDCR4,
                           CREAC5,CREFX5,QTDCR5,CREAC6,CREFX6,QTDCR6,
                           PRMRT1,DINPR1,DFNPR1,PRMRT2,DINPR2,DFNPR2,PRMRT3,DINPR3,DFNPR3,
                           FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,FAIAC7,
                           FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,FAIREF,
                           TECCRA,CHCPRI,IDTPES,GRACON,CONINT,TOLINT,VALAUT,
                           NOMFUN,NUMPIS,CONREA,RECVIS,NUMEMP,TIPCOL,NUMCAD,
                           TIPDOC,NUMDOC,NUMMAT,PROPAC,NUMCAN, PROPRE)
               VALUES(
                           p_numcra,l_crapri,l_tipcra,l_situa,l_subnv,l_data_atual,
                           l_hora_atual,l_segu_atual,l_inival,l_auxval,
                           '0000000000000000','0000000000000000',p_codprm,p_codprm,
                           p_codprm,p_codprm,l_codig,l_desmsg,l_datmsgaux,l_qtdmsg,l_qtdmsg,
                           0,0,0,l_usabio,l_VerPrm,l_confai,l_anti_dupla,l_concre,l_conpac,l_tempac,l_tolacp,l_vis_esp,0,
                           l_crefx1,l_fx1,l_crefx1,l_crefx2,l_fx2,l_crefx2,
                           l_crefx3,l_fx3,l_crefx3,l_crefx4,l_fx4,l_crefx4,
                           l_crefx5,l_fx5,l_crefx5,l_crefx6,l_fx6,l_crefx6,
                           l_grupo1,l_iniAr1,l_fimAr1,l_grupo2,l_iniAr2,l_fimAr2,
                           l_grupo3,l_iniAr3,l_fimAr3,
                           l_fx_dom,l_fx_seg,l_fx_ter,l_fx_qua,l_fx_qui,l_fx_sex,l_fx_sab,
                           l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                           l_fairef,l_teccra,0,l_idtpes,l_gracon,l_conInt_Int,l_tolInt,l_ValAut,
                           l_nomfun,l_numpis,l_conrea,0,0,0,0,
                           p_tipdoc,p_numdoc,'0',p_propac,0,0);
           EXCEPTION
               WHEN OTHERS THEN RAISERROR 103 'SP_VISPAC: Erro no INSERT Tabela R070CON.';
           END;

        END IF;
        /*Atualiza Pend_Grupo*/
        IF (l_numsma > 0) THEN
            /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
            IF (l_tecpri = 3) THEN
                SP_ATUPRM(p_numcra, l_numsma, p_codprm, l_grupo1, l_grupo2, l_grupo3, p_codprm, p_codprm, p_codprm);
            ELSE
                SP_ATUPRM(l_crapri, l_numsma, p_codprm, l_grupo1, l_grupo2, l_grupo3, p_codprm, p_codprm, p_codprm);
            END IF;
        END IF;


        /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
        IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
            SP_PEND21(l_crapri);
        END IF;

        /*Atualiza os demais Crachás*/
        /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
        IF (l_tecpri = 1) THEN
            /*Atualiza o crachá de proximidade*/
            IF (l_numpro <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numpro, l_numpro_ret OUT);
                  /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numpro);
                END IF;
            END IF;
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
        ELSIF (l_tecpri = 2) THEN
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        END IF;
        /*Verifica se Gera o Comando IncludePerson*/
        IF (l_iPerson = TRUE) THEN
            /*Gera o Include Person*/
            SP_PEND19(p_numcra, l_idtpes);
            /*Atualiza os créditos somente se o mesmo já não foi atualizado*/
            IF (l_atucreloc = FALSE) THEN
                /*Atualiza os créditos sem local físico*/
                SP_PEND06(1, l_idtpes, l_verplf, 0);
                /*Atualiza os créditos por local físico da pessoa*/
                SP_ATUCRELOC(l_idtpes);
            END IF;
        END IF;
  END IF;
  IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
    l_creacc_bol := TRUE;
  ELSE
    l_creacc_bol := FALSE;
  END IF;
  IF (p_subnv = 1) THEN
    l_subnv_bol := TRUE;
  ELSE
    l_subnv_bol := FALSE;
  END IF;

  /*Atualiza a Controle*/
  SP_ATUTSI(l_idtpes, l_crapri, l_creacc_bol, TRUE, l_subnv_bol, TRUE);
  /*Atualiza tabela MatGrupo*/
  SP_MATGRP(p_numcra, 4, 0, 0, 0, p_tipdoc, p_numdoc, '');
END␀¡␀ÿÿÿÿÿÿÿÿ	SENIOR;0TR_CALCMEDIA
	␀␀/* Stored Procedure que atualiza a Média do Participante no seu Histórico de Curso */
PROCEDURE TR_ATUMED(P_CODCUA NUMBER(9),P_TMACUA NUMBER(6))
 IS

l_TipCnf         R134DTU.TIPCNF%TYPE;
     l_MedCua         R124HCR.MEDCUA%TYPE;
     l_TipCua         R128CUA.TIPCUA%TYPE;

     CURSOR C_R140NPC_ATU IS SELECT NUMEMP, TIPCOL, NUMCAD FROM R140NPC
                              WHERE R140NPC.CODCUA = p_CodCua AND R140NPC.TMACUA = p_TmaCua
                                AND SITCUA <> 1;

     TYPE t_r140npc_aux IS RECORD(
          NUMEMP   R140NPC.NUMEMP%TYPE,
          TIPCOL   R140NPC.TIPCOL%TYPE,
          NUMCAD   R140NPC.NUMCAD%TYPE);

     l_r140npc_aux t_r140npc_aux;

BEGIN
  /* Busca se a Turma é do tipo Modular */
  SELECT IFNULL(TIPCUA,' ') INTO l_TipCua FROM R128CUA WHERE R128CUA.CODCUA = p_CodCua;

  /* Se for uma Turma modular, não altera R140NPC e R124HCR. */
  IF (l_TipCua <> 'S') THEN
     /* Busca a Data Inicial da Turma */
     BEGIN
          SELECT TIPCNF INTO l_TipCnf FROM R134DTU WHERE CODCUA = p_CodCua AND TMACUA = P_TmaCua;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro ao Identificar a Data Inicial da Turma.';
     END;

     /* Se a turma for de um tipo maior que 2, não altera histórico */
     IF   (l_TipCnf < 3) THEN
          FOREACH C_R140NPC_ATU INTO l_r140npc_aux.NUMEMP,
                                     l_r140npc_aux.TIPCOL,
                                     l_r140npc_aux.NUMCAD
          LOOP
               /* Calcula a média do Participante */
               TR_CALCMEDIA(p_CodCua, P_TmaCua, l_r140npc_aux.NUMEMP, l_r140npc_aux.TIPCOL,
                            l_r140npc_aux.NUMCAD, l_MedCua OUT);

               /* Atualiza a média no histórico */
               BEGIN
                    UPDATE R124HCR SET MEDCUA = l_MedCua
                     WHERE CODCUA = p_CodCua AND TMACUA = P_TmaCua AND NUMEMP = l_r140npc_aux.NUMEMP
                       AND TIPCOL = l_r140npc_aux.TIPCOL AND NUMCAD = l_r140npc_aux.NUMCAD;
               EXCEPTION
                    WHEN OTHERS THEN
                         RAISERROR 103 'Erro na Atualização da Média dos Históricos de Curso dos Participantes da Turma.';
               END;
          END LOOP;
     END IF;
  END IF;
END␀¢␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀/* Stored Procedure que atualiza os cursos Modulares em aberto */
PROCEDURE TR_ATUTURMOD(A_CODCUA NUMBER(9),A_NUMEMP NUMBER(4),A_TIPCOL NUMBER(1),A_NUMCAD NUMBER(9),A_SEQHCR NUMBER(4),A_TIPOPE VARCHAR2(1))
 IS

xTipCua   R128CUA.TIPCUA%TYPE;
  xSeqHcr   R124HCR.SEQHCR%TYPE;

  CURSOR C_R134DRE_MOD IS
    SELECT DRE.CODCUA, DRE.TMACUA FROM R128COM COM, R134DRE DRE, R140NPC NPC
     WHERE DRE.NUMEMP = a_NumEmp AND DRE.TIPCOL = a_TipCol AND DRE.NUMCAD = a_NumCad
       AND NPC.NUMEMP = a_NumEmp   AND NPC.TIPCOL = a_TipCol AND NPC.NUMCAD = a_NumCad
       AND NPC.CODCUA = DRE.CODCUA AND NPC.TMACUA = DRE.TMACUA AND NPC.SITCUA = 1
       AND COM.CODCUA = DRE.CODCUA AND COM.CODCUR = a_CodCua
       AND ((NOT EXISTS(SELECT CUR.SEQHCR FROM R134CUR CUR
                         WHERE CUR.CODCUA = DRE.CODCUA AND CUR.TMACUA = DRE.TMACUA AND CUR.CODCUR = a_CodCua
                           AND CUR.NUMEMP = a_NumEmp   AND CUR.TIPCOL = a_TipCol AND CUR.NUMCAD = a_NumCad))
            OR
            (EXISTS(SELECT CUR.SEQHCR FROM R134CUR CUR, R124HCR HCR
                     WHERE CUR.CODCUA = DRE.CODCUA AND CUR.TMACUA = DRE.TMACUA AND CUR.CODCUR = a_CodCua
                       AND CUR.NUMEMP = a_NumEmp   AND CUR.TIPCOL = a_TipCol AND CUR.NUMCAD = a_NumCad
                       AND HCR.NUMEMP = a_NumEmp   AND HCR.TIPCOL = a_TipCol AND HCR.NUMCAD = a_NumCad
                       AND HCR.CODCUA = a_CodCua   AND HCR.SEQHCR = CUR.SEQHCR AND HCR.SITCUA <> 1 AND HCR.SITCUA <> 2)));

  TYPE t_r134dre_aux IS RECORD(
      CODCUA   R134DRE.CODCUA%TYPE,
      TMACUA   R134DRE.TMACUA%TYPE);

  xr134dre_aux t_r134dre_aux;

BEGIN
  /* Busca se a Turma é do tipo Modular */
  SELECT IFNULL(TIPCUA,' ') INTO xTipCua FROM R128CUA WHERE CODCUA = a_CodCua;

  /* Se não for uma Curso Modular, verifica se este Curso não é uma composição de
     uma Curso modular e que tenha este participante. */
  IF (xTipCua <> 'S') THEN
    /* Se for uma operação de Inclusão */
    IF (a_TipOpe = 'I') THEN
      FOREACH C_R134DRE_MOD INTO xr134dre_aux.CODCUA,
                                 xr134dre_aux.TMACUA
      LOOP
        /* Verifica se existe registro na R134CUR */
        BEGIN
          SELECT SEQHCR INTO xSeqHcr FROM R134CUR
           WHERE CODCUA = xr134dre_aux.CODCUA AND TMACUA = xr134dre_aux.TMACUA AND CODCUR = a_CodCua
             AND NUMEMP = a_NumEmp AND TIPCOL = a_TipCol AND NUMCAD = a_NumCad;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            xSeqHcr := 0;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao verificar se existe algum vínculo para o Participante.';
        END;

        IF (xSeqHcr <> 0) THEN
          /* Atualiza o vínculo com o histórico passado como parâmetro */
          BEGIN
            UPDATE R134CUR SET SEQHCR = a_SeqHcr
             WHERE CODCUA = xr134dre_aux.CODCUA AND TMACUA = xr134dre_aux.TMACUA AND CODCUR = a_CodCua
               AND NUMEMP = a_NumEmp AND TIPCOL = a_TipCol AND NUMCAD = a_NumCad;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro na Atualização do Vínculo.';
          END;
        ELSE
          /* Se achar o participante em alguma Turma Modular, referencia o histórico na R134CUR */
          BEGIN
            INSERT R134CUR (CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, CODCUR, SEQHCR)
                    VALUES (xr134dre_aux.CODCUA, xr134dre_aux.TMACUA, a_NumEmp, a_TipCol, a_NumCad, a_CodCua, a_SeqHcr);
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro na Inclusão do Histórico de Curso.';
          END;
        END IF;
      END LOOP;
    ELSE
      /* Exclui as referências da R134CUR que apontam para este histórico */
      BEGIN
        DELETE FROM R134CUR
              WHERE NUMEMP = a_NumEmp AND TIPCOL = a_TipCol AND NUMCAD = a_NumCad
                AND CODCUR = a_CodCua AND SEQHCR = a_SeqHcr;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao Excluir na Inclusão do Histórico de Curso.';
      END;
    END IF;
  END IF;
END␀£␀ÿÿÿÿÿÿÿÿ	SENIOR;0
]␀␀/* Stored Procedure que calcula e retorna a Média do Participante de uma Turma */
PROCEDURE TR_CALCMEDIA(P_CODCUA NUMBER(9),P_TMACUA NUMBER(6),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_MEDCUA OUT NUMBER(5,2))
 IS

xNotascomPeso  NUMBER(9,2);
  xNotassemPeso  NUMBER(9,2);
  xQtdNotas      NUMBER(4);
  xQtdPeso       NUMBER(4);

  CURSOR C_NOTAS_PAR IS
    SELECT IFNULL(NPA.NOTPAR, 0), IFNULL(DTN.PESNOT, 0) FROM R140NPA NPA, R134DTN DTN, R140NTR NTR
     WHERE DTN.CODCUA = p_CodCua AND DTN.TMACUA = p_TmaCua AND DTN.CODTNT = NPA.CODTNT
       AND NTR.CODTNT = NPA.CODTNT AND NPA.CODCUA = p_CodCua AND NPA.TMACUA = p_TmaCua
       AND NPA.NUMEMP = p_NumEmp AND NPA.TIPCOL = p_TipCol AND NPA.NUMCAD = p_NumCad
       AND NTR.USATNT = 'S';

  TYPE t_notas_aux IS RECORD(
      NOTPAR   R140NPA.NOTPAR%TYPE,
      PESNOT   R134DTN.PESNOT%TYPE);

  xnotas_aux t_notas_aux;
BEGIN
  /* Calcula a média do Participante */
  xNotascomPeso := 0;
  xNotassemPeso := 0;
  xQtdNotas := 0;
  xQtdPeso := 0;
  FOREACH C_NOTAS_PAR INTO xnotas_aux.NOTPAR,
                           xnotas_aux.PESNOT
  LOOP
    xNotascomPeso := xNotascomPeso + (xnotas_aux.NOTPAR * xnotas_aux.PESNOT);
    xNotassemPeso := xNotassemPeso + (xnotas_aux.NOTPAR);
    xQtdNotas := xQtdNotas + 1;
    xQtdPeso := xQtdPeso + xnotas_aux.PESNOT;
  END LOOP;

  /* Se algum dos itens de nota possuem Peso, calcula a média ponderada */
  IF (xQtdPeso > 0) THEN
    p_MedCua := xNotascomPeso / xQtdPeso;
  ELSE
    IF (xQtdNotas > 0) THEN
      p_MedCua := xNotassemPeso / xQtdNotas;
    END IF;
  END IF;
END␀¤␀ÿÿÿÿÿÿÿÿ	SENIOR;0
G	␀␀/* Stored Procedure que reinicia o participante de uma Turma Modular */
PROCEDURE TR_ZERTURMOD(A_CODCUA NUMBER(9),A_TMACUA NUMBER(6),A_NUMEMP NUMBER(4),A_TIPCOL NUMBER(1),A_NUMCAD NUMBER(9))
 IS

xSitCua   R140NPC.SITCUA%TYPE;
  xDatZer   R134DRE.DATTER%TYPE;

BEGIN
  xDatZer := '31/12/1900,00:00:00';

  /* Não pode zerar dados se o participante estiver com situação igual a desistente, nenhum, etc. */
  BEGIN
    SELECT SITCUA INTO xSitCua FROM R140NPC
     WHERE CODCUA = a_CodCua AND TMACUA = a_TmaCua
       AND NUMEMP = a_NumEmp AND TIPCOL = a_TipCol AND NUMCAD = a_NumCad;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      xSitCua := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler a Situação do Participante do Curso Modular';
  END;

  IF ((xSitCua <> 3) AND (xSitCua <> 4) AND (xSitCua <> 7) AND (xSitCua <> 8)) THEN
    /* Zera data de Término do Participante */
    BEGIN
      UPDATE R134DRE SET DATTER = xDatZer
       WHERE CODCUA = a_CodCua AND TMACUA = a_TmaCua
         AND NUMEMP = a_NumEmp AND TIPCOL = a_TipCol AND NUMCAD = a_NumCad;
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao zerar Data de Término do Participante na Turma Modular.';
    END;

    /* Coloca Participante da turma Modular com situação em Andamento */
    BEGIN
      UPDATE R140NPC SET SITCUA = 1, CODMIN = 0
       WHERE CODCUA = a_CodCua AND TMACUA = a_TmaCua
         AND NUMEMP = a_NumEmp AND TIPCOL = a_TipCol AND NUMCAD = a_NumCad;
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao colocar o participante da Turma Modular em Andamento.';
    END;

    /* Coloca Turma Modular com situação em Andamento */
    BEGIN
      UPDATE R134DTU SET SITCUA = 1
       WHERE CODCUA = a_CodCua AND TMACUA = a_TmaCua;
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao colocar a Turma Modular em Andamento.';
    END;

    /* Zera as informações de Frequencia, Média e Situação do Hist. de Curso */
    BEGIN
      UPDATE R124HCR SET FRECUA = 0, MEDCUA = 0, SITCUA = 1,  CODMIN = 0, ORIHCR = 'T'
       WHERE NUMEMP = a_NumEmp AND TIPCOL = a_TipCol AND NUMCAD = a_NumCad
         AND CODCUA = a_CodCua AND TMACUA = a_TmaCua;
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao Inicializar Situação, Freq. e Média da R124HCR.';
    END;
  END IF;
END␀Œ"ÿÿÿÿÿÿÿÿ	SENIOR;0␀2PROCEDURE CLEARREPLICATION
IS
BEGIN
	NULL;
END	ORACLE;0␀…␀␀CREATE OR REPLACE PROCEDURE CLEARREPLICATION
AS
BEGIN
  DECLARE
    TYPE IdList IS TABLE OF RTC_PENDENCIES.ID%TYPE
      INDEX BY PLS_INTEGER;
    IdTab IdList;
    xBlockSize INT := 1000;
    xCount INT := xBlockSize;
  BEGIN
    WHILE xCount = xBlockSize LOOP
      IdTab.DELETE;

      SELECT pen.ID BULK COLLECT INTO IdTab FROM RTC_PENDENCIES pen LEFT OUTER JOIN HCM_PENDENCIES t0 ON pen.ID = t0.ID
      WHERE
        ROWNUM <= xBlockSize AND
        CASE WHEN t0.ID IS NOT NULL THEN 1 WHEN NOT EXISTS(SELECT 1 FROM RTC_REPLICATIONDEF def WHERE def.IDREPLICATOR = 'HCM' AND def.TABLENAME = pen.TABLENAME) THEN 1 END = 1;

      xCount := IdTab.COUNT;
      FORALL IDX IN 1..xCount
        DELETE FROM RTC_PENDENCIES WHERE ID = IdTab(IDX);

      FORALL IDX IN 1..xCount
        DELETE FROM HCM_PENDENCIES WHERE ID = IdTab(IDX);

      COMMIT;
    END LOOP;
  END;
END;␀␀’␀ğ¥␀␀–␀␀␀␀␀␀␀␀␀7@)8)8nWˆ␀Æÿ␀␀ÿ␀Z␀␀␀␀␀␀␀␀␀£␀␀0␀n␀Æÿ␀␀ÿ␀ñ¥␀␀(␀␀␀␀␀␀␀␀V±␀␀†^¯␀␀d␀␀␀ÿ␀␀ÿ␀Ù¥␀␀U␀␀␀␀␀␀␀␀æ©␀␀ç§␀␀ç§␀␀V␀␀ÿ␀␀ÿ␀Ä¸␀␀␀␀␀␀␀␀␀␀~Â␀␀{Â␀␀{Â␀␀\␀~ˆ␀␀ÿ␀␀ÿ␀h²␀␀␀␀␀␀␀␀␀␀i´␀␀ñ³␀␀ñ³␀␀!|ˆ␀␀ÿ␀␀ÿ␀-#±␀␀␀␀␀␀␀␀␀—=àÃ␀␀îÃ␀␀qi‡␀Æÿ␀␀ÿ␀NCÑ␀	␀␀␀␀␀␀␀␀ËJL_“FqCvˆ␀êÿ␀␀ÿ␀Ãu·␀	␀␀␀␀␀␀␀␀ly…{+xì*␀yˆ␀Æÿ␀␀ÿ␀␀•␀␀ SELECT
