ß␀␀

PROCEDURE SP_MAPFIS(P_NUMCRA NUMBER(12),P_NUMBAR OUT NUMBER(12),P_NUMPRO OUT NUMBER(12),P_NUMSMA OUT NUMBER(12),P_TECPRI OUT NUMBER(1),P_CRAPRI OUT NUMBER(12))
 IS

l_data_atual   DATE;
l_data_zero    DATE;

BEGIN
    l_data_atual := CURDATE();
    l_data_zero  := '31/12/1900,00:00:00';
    p_tecpri := 0;
    BEGIN
    /* Verifica se a Pessoa possui Smart. */
        SELECT NUMFIS, TECCRA INTO p_numsma, p_tecpri
        FROM R069FIS A
        WHERE NUMCRA = p_numcra
        AND TECCRA = 3
        AND HORINI = (SELECT MAX(HORINI)
                      FROM R069FIS
                      WHERE NUMCRA = A.NUMCRA AND
                      DATALT = (SELECT MAX(DATALT)
                                FROM R069FIS
                                WHERE NUMCRA = A.NUMCRA AND
                                TECCRA = 3 AND DATALT <= l_data_atual
                                )
                      AND TECCRA = 3)
        AND DATALT = (SELECT MAX(DATALT)
                      FROM R069FIS
                      WHERE NUMCRA = A.NUMCRA AND
                      TECCRA = 3 AND DATALT <= l_data_atual
                      )
        AND DATFIM = l_data_zero;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        p_numsma := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'SP_MAPFIS 3: Verifique pré cadastro de crachá (R069FIS).';
    END;

    BEGIN
        SELECT NUMFIS, TECCRA INTO p_numpro, p_tecpri
        FROM R069FIS A
        WHERE NUMCRA = p_numcra
        AND TECCRA = 2
        AND HORINI = (SELECT MAX(HORINI)
                      FROM R069FIS
                      WHERE NUMCRA = A.NUMCRA AND
                      DATALT = (SELECT MAX(DATALT)
                                FROM R069FIS
                                WHERE NUMCRA = A.NUMCRA AND
                                TECCRA = 2 AND DATALT <= l_data_atual
                                )
                      AND TECCRA = 2)
        AND DATALT = (SELECT MAX(DATALT)
                      FROM R069FIS
                      WHERE NUMCRA = A.NUMCRA AND
                      TECCRA = 2 AND DATALT <= l_data_atual
                      )
        AND DATFIM = l_data_zero;

    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        p_numpro := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'SP_MAPFIS 2: Verifique pré cadastro de crachá (R069FIS).';
    END;

    BEGIN
    /* Verifica se a Pessoa possui Barras. */
        SELECT NUMFIS, TECCRA INTO p_numbar, p_tecpri
        FROM R069FIS A
        WHERE NUMCRA = p_numcra
        AND TECCRA = 1
        AND HORINI = (SELECT MAX(HORINI)
                      FROM R069FIS
                      WHERE NUMCRA = A.NUMCRA AND
                      DATALT = (SELECT MAX(DATALT)
                                FROM R069FIS
                                WHERE NUMCRA = A.NUMCRA AND
                                TECCRA = 1 AND DATALT <= l_data_atual
                                )
                      AND TECCRA = 1)
        AND DATALT = (SELECT MAX(DATALT)
                      FROM R069FIS
                      WHERE NUMCRA = A.NUMCRA AND
                      TECCRA = 1 AND DATALT <= l_data_atual
                      )
        AND DATFIM = l_data_zero;

    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        p_numbar := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'SP_MAPFIS 1: Verifique pré cadastro de crachá (R069FIS).';
    END;

    /*Obtem o Crachá Principal*/
    IF    (p_tecpri = 1) THEN
        p_crapri := p_numbar;
    ELSIF (p_tecpri = 2) THEN
        p_crapri := p_numpro;
    ELSIF (p_tecpri = 3) THEN
        p_crapri := p_numsma;
    ELSE
        p_tecpri := 1;
        p_numbar := P_NUMCRA;
        p_crapri := P_NUMCRA;
    END IF;
END		SENIOR;21
ß␀␀

