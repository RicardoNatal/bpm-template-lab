TRIGGER R014SIN_EU AFTER UPDATE ON R014SIN FOR EACH ROW

DECLARE
  l_Valor VARCHAR(2000);
  l_Valor2 VARCHAR2(2000);
  l_Valido       BOOLEAN;
  l_Alterou      BOOLEAN;
  l_Empresa NUMBER;
  CURSOR c_Empresa IS
    SELECT NUMEMP
    FROM R030EMP
    WHERE HORNOT = 'S'
    ORDER BY NUMEMP;
  l_DataReferencia DATE;
BEGIN
  RH_250ALT(36);

  /*e-Social*/  
  
  l_Valido := FALSE;
  l_Alterou := FALSE;
  SP_VALUPDATE_NUM(:OLD.ININOT, :NEW.ININOT, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.FIMNOT, :NEW.FIMNOT, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;

  IF (l_Alterou = TRUE) THEN
    FOREACH c_Empresa INTO l_Empresa
    LOOP
      l_Valor := '';
      SP_CONCATENAR_NUM('CODSIN', :NEW.CODSIN, l_Valor OUT);
      l_DataReferencia := CURDATE();
      SP_CONCATENAR_DAT('DATALT', l_DataReferencia, l_Valor OUT);
      
      l_Valor2 := '';
      SP_CONCATENAR_NUM('CODSIN', :OLD.CODSIN, l_Valor2 OUT);

      SP_ESOCIAL_1050(l_Empresa, 'R014SIN', 'A', l_Valor, l_Valor2, 0 , 'R014SIN_EU');

    END LOOP;
  END IF;
  
  /*e-Social*/
END␀,Ğ␀␀		SENIOR;0Y

