ôH␀␀CREATE OR REPLACE PROCEDURE SP_ADDLOG(PEVTIDT NUMBER,PEVTTIM NUMBER,PEVTUSR NUMBER,PEVTDA1 VARCHAR2,PEVTDA2 VARCHAR2,PEVTDA3 VARCHAR2,PEVTDA4 VARCHAR2,PEVTDA5 VARCHAR2,PEVTDA6 VARCHAR2,PEVTDA7 VARCHAR2,PEVTDA8 VARCHAR2,PEVTDA9 VARCHAR2,PEVTDA10 VARCHAR2,PEVTDA11 VARCHAR2,PEVTDA12 VARCHAR2,PEVTDA13 VARCHAR2,PEVTDA14 VARCHAR2,PEVTDA15 VARCHAR2,PEVTDA16 VARCHAR2,PEVTDA17 VARCHAR2,PEVTDA18 VARCHAR2,PEVTDA19 VARCHAR2,PEVTDA20 VARCHAR2,PEVTDA21 VARCHAR2,PEVTDA22 VARCHAR2,PEVTDA23 VARCHAR2,PEVTDA24 VARCHAR2,PEVTDA25 VARCHAR2,PEVTDA26 VARCHAR2,PEVTDA27 VARCHAR2,PEVTDA28 VARCHAR2,PEVTDA29 VARCHAR2,PEVTDA30 VARCHAR2,PEVTDA31 VARCHAR2,PEVTDA32 VARCHAR2) IS
  VEVTPOS NUMBER(10);
  VMAXPOS NUMBER(10);
  VEVTNBR NUMBER(10);
  VEVTPOSCNT NUMBER(10);
  VISCIRCULAR BOOLEAN;
  cursor CUR_R900LCN is 
    SELECT R900LCN.EVTPOS EVTPOS,R900LCN.MAXPOS MAXPOS FROM R900LCN R900LCN FOR UPDATE;
begin
  VISCIRCULAR := TRUE;
  open CUR_R900LCN;
  begin
    fetch CUR_R900LCN into VEVTPOS,VMAXPOS;
    while (CUR_R900LCN%FOUND)
    loop
      if (VMAXPOS=-1727) then
        VISCIRCULAR := FALSE;
      end if;
      VEVTNBR := VEVTPOS;
      SELECT 
      COUNT(*) COL_0
       INTO VEVTPOSCNT 
       FROM R900LOG R900LOG
       WHERE EVTPOS=VEVTPOS;
      if (VISCIRCULAR=TRUE) then
        if (VEVTPOSCNT<>1) then
          raise_application_error(-20000 + -(103),'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log');
        end if;
        UPDATE R900LOG SET EVTNBR = VEVTNBR, EVTIDT = PEVTIDT, EVTTIM = PEVTTIM, EVTUSR = PEVTUSR, EVTDA1 = PEVTDA1, EVTDA2 = PEVTDA2 WHERE EVTPOS=VEVTPOS;
      else
        INSERT INTO R900LOG (EVTPOS,EVTNBR,EVTIDT,EVTTIM,EVTUSR,EVTDA1,EVTDA2) VALUES  (VEVTPOS,VEVTNBR,PEVTIDT,PEVTTIM,PEVTUSR,PEVTDA1,PEVTDA2);
      end if;
      if (VEVTPOS<VMAXPOS) OR (VISCIRCULAR=FALSE) then
        VEVTPOS := VEVTPOS+1;
      else
        VEVTPOS := 1;
      end if;
      if (NVL(LENGTH(PEVTDA3),0)<>0) then
        SELECT COUNT(*) COL_0 INTO VEVTPOSCNT FROM R900LOG R900LOG WHERE EVTPOS=VEVTPOS;
        if (VISCIRCULAR=TRUE) then
          if (VEVTPOSCNT<>1) then
            raise_application_error(-20000 + -(103),'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log');
          end if;
          UPDATE R900LOG SET EVTNBR = VEVTNBR, EVTIDT = PEVTIDT, EVTTIM = PEVTTIM, EVTUSR = PEVTUSR, EVTDA1 = PEVTDA3, EVTDA2 = PEVTDA4 WHERE EVTPOS=VEVTPOS;
        else
          INSERT INTO R900LOG (EVTPOS,EVTNBR,EVTIDT,EVTTIM,EVTUSR,EVTDA1,EVTDA2) VALUES  (VEVTPOS,VEVTNBR,PEVTIDT,PEVTTIM,PEVTUSR,PEVTDA3,PEVTDA4);
        end if;
        if (VEVTPOS<VMAXPOS) OR (VISCIRCULAR=FALSE) then
          VEVTPOS := VEVTPOS+1;
        else
          VEVTPOS := 1;
        end if;
        if (NVL(LENGTH(PEVTDA5),0)<>0) then
          SELECT COUNT(*) COL_0 INTO VEVTPOSCNT FROM R900LOG R900LOG WHERE EVTPOS=VEVTPOS;
          if (VISCIRCULAR=TRUE) then
            if (VEVTPOSCNT<>1) then
              raise_application_error(-20000 + -(103),'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log');
            end if;
            UPDATE R900LOG  SET  EVTNBR = VEVTNBR, EVTIDT = PEVTIDT, EVTTIM = PEVTTIM, EVTUSR = PEVTUSR, EVTDA1 = PEVTDA5, EVTDA2 = PEVTDA6  WHERE EVTPOS=VEVTPOS;
          else
            INSERT INTO R900LOG (EVTPOS,EVTNBR,EVTIDT,EVTTIM,EVTUSR,EVTDA1,EVTDA2) VALUES  (VEVTPOS,VEVTNBR,PEVTIDT,PEVTTIM,PEVTUSR,PEVTDA5,PEVTDA6);
          end if;
          if (VEVTPOS<VMAXPOS) OR (VISCIRCULAR=FALSE) then
            VEVTPOS := VEVTPOS+1;
          else
            VEVTPOS := 1;
          end if;
          if (NVL(LENGTH(PEVTDA7),0)<>0) then
            SELECT COUNT(*) COL_0 INTO VEVTPOSCNT FROM R900LOG R900LOG WHERE EVTPOS=VEVTPOS;
            if (VISCIRCULAR=TRUE) then
              if (VEVTPOSCNT<>1) then
                raise_application_error(-20000 + -(103),'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log');
              end if;
              UPDATE R900LOG  SET  EVTNBR = VEVTNBR, EVTIDT = PEVTIDT, EVTTIM = PEVTTIM, EVTUSR = PEVTUSR, EVTDA1 = PEVTDA7, EVTDA2 = PEVTDA8  WHERE EVTPOS=VEVTPOS;
            else
              INSERT INTO R900LOG (EVTPOS,EVTNBR,EVTIDT,EVTTIM,EVTUSR,EVTDA1,EVTDA2) VALUES  (VEVTPOS,VEVTNBR,PEVTIDT,PEVTTIM,PEVTUSR,PEVTDA7,PEVTDA8);
            end if;
            if (VEVTPOS<VMAXPOS) OR (VISCIRCULAR=FALSE) then
              VEVTPOS := VEVTPOS+1;
            else
              VEVTPOS := 1;
            end if;
            if (NVL(LENGTH(PEVTDA9),0)<>0) then
              SELECT COUNT(*) COL_0 INTO VEVTPOSCNT FROM R900LOG R900LOG WHERE EVTPOS=VEVTPOS;
              if (VISCIRCULAR=TRUE) then
                if (VEVTPOSCNT<>1) then
                  raise_application_error(-20000 + -(103),'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log');
                end if;
                UPDATE R900LOG  SET  EVTNBR = VEVTNBR, EVTIDT = PEVTIDT, EVTTIM = PEVTTIM, EVTUSR = PEVTUSR, EVTDA1 = PEVTDA9, EVTDA2 = PEVTDA10  WHERE EVTPOS=VEVTPOS;
              else
                INSERT INTO R900LOG (EVTPOS,EVTNBR,EVTIDT,EVTTIM,EVTUSR,EVTDA1,EVTDA2) VALUES  (VEVTPOS,VEVTNBR,PEVTIDT,PEVTTIM,PEVTUSR,PEVTDA9,PEVTDA10);
              end if;
              if (VEVTPOS<VMAXPOS) OR (VISCIRCULAR=FALSE) then
                VEVTPOS := VEVTPOS+1;
              else
                VEVTPOS := 1;
              end if;
              if (NVL(LENGTH(PEVTDA11),0)<>0) then
                SELECT COUNT(*) COL_0 INTO VEVTPOSCNT FROM R900LOG R900LOG WHERE EVTPOS=VEVTPOS;
                if (VISCIRCULAR=TRUE) then
                  if (VEVTPOSCNT<>1) then
                    raise_application_error(-20000 + -(103),'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log');
                  end if;
                  UPDATE R900LOG  SET  EVTNBR = VEVTNBR, EVTIDT = PEVTIDT, EVTTIM = PEVTTIM, EVTUSR = PEVTUSR, EVTDA1 = PEVTDA11, EVTDA2 = PEVTDA12  WHERE EVTPOS=VEVTPOS;
                else
                  INSERT INTO R900LOG (EVTPOS,EVTNBR,EVTIDT,EVTTIM,EVTUSR,EVTDA1,EVTDA2) VALUES  (VEVTPOS,VEVTNBR,PEVTIDT,PEVTTIM,PEVTUSR,PEVTDA11,PEVTDA12);
                end if;
                if (VEVTPOS<VMAXPOS) OR (VISCIRCULAR=FALSE) then
                  VEVTPOS := VEVTPOS+1;
                else
                  VEVTPOS := 1;
                end if;
                if (NVL(LENGTH(PEVTDA13),0)<>0) then
                  SELECT COUNT(*) COL_0 INTO VEVTPOSCNT FROM R900LOG R900LOG WHERE EVTPOS=VEVTPOS;
                  if (VISCIRCULAR=TRUE) then
                    if (VEVTPOSCNT<>1) then
                      raise_application_error(-20000 + -(103),'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log');
                    end if;
                    UPDATE R900LOG  SET  EVTNBR = VEVTNBR, EVTIDT = PEVTIDT, EVTTIM = PEVTTIM, EVTUSR = PEVTUSR, EVTDA1 = PEVTDA13, EVTDA2 = PEVTDA14  WHERE EVTPOS=VEVTPOS;
                  else
                    INSERT INTO R900LOG (EVTPOS,EVTNBR,EVTIDT,EVTTIM,EVTUSR,EVTDA1,EVTDA2) VALUES  (VEVTPOS,VEVTNBR,PEVTIDT,PEVTTIM,PEVTUSR,PEVTDA13,PEVTDA14);
                  end if;
                  if (VEVTPOS<VMAXPOS) OR (VISCIRCULAR=FALSE) then
                    VEVTPOS := VEVTPOS+1;
                  else
                    VEVTPOS := 1;
                  end if;
                  if (NVL(LENGTH(PEVTDA15),0)<>0) then
                    SELECT COUNT(*) COL_0 INTO VEVTPOSCNT FROM R900LOG R900LOG WHERE EVTPOS=VEVTPOS;
                    if (VISCIRCULAR=TRUE) then
                      if (VEVTPOSCNT<>1) then
                        raise_application_error(-20000 + -(103),'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log');
                      end if;
                      UPDATE R900LOG  SET  EVTNBR = VEVTNBR, EVTIDT = PEVTIDT, EVTTIM = PEVTTIM, EVTUSR = PEVTUSR, EVTDA1 = PEVTDA15, EVTDA2 = PEVTDA16  WHERE EVTPOS=VEVTPOS;
                    else
                      INSERT INTO R900LOG (EVTPOS,EVTNBR,EVTIDT,EVTTIM,EVTUSR,EVTDA1,EVTDA2) VALUES  (VEVTPOS,VEVTNBR,PEVTIDT,PEVTTIM,PEVTUSR,PEVTDA15,PEVTDA16);
                    end if;
                    if (VEVTPOS<VMAXPOS) OR (VISCIRCULAR=FALSE) then
                      VEVTPOS := VEVTPOS+1;
                    else
                      VEVTPOS := 1;
                    end if;
                    if (NVL(LENGTH(PEVTDA17),0)<>0) then
                      SELECT COUNT(*) COL_0 INTO VEVTPOSCNT FROM R900LOG R900LOG WHERE EVTPOS=VEVTPOS;
