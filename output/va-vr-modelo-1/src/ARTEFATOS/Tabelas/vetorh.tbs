PROCEDURE SP_MATCODIN(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_TIPOPE CHAR(1),P_ICARD CHAR(12))
 IS

  l_idtpes       VARCHAR2(23);
  l_usutel       VARCHAR2(31);  
  l_rlgalf       CHAR(6);
  l_codcen       NUMBER(2);
  l_codplf_aux   NUMBER(7);
  l_comando      VARCHAR2(1024);
  l_horaini      NUMBER(2);
  l_minini       NUMBER(2);
  l_horafim      NUMBER(2);
  l_minfim       NUMBER(2);
  l_faixa        VARCHAR2(100);
  l_horaini_str  CHAR(2);
  l_minini_str   CHAR(2);
  l_horafim_str  CHAR(2);
  l_minfim_str   CHAR(2);
  l_diasem_str   CHAR(1);
  l_diasem       NUMBER(1);
  l_icard_num    NUMBER(12);
  l_matcod       CHAR(1);
  l_rlgalf_str   CHAR(2);
  l_codcen_str   CHAR(2);
  l_icardA       VARCHAR(12);
  l_icardR       VARCHAR(12);
  l_numser       VARCHAR(12);
  
  CURSOR c_r034prm IS
    SELECT R058RLG.NUMEIP, R058RLG.RLGALF, R058RLG.CODCEN, R034PRM.CODPLT, R034PRM.CODRLG, R034PRM.VERPLF, R034PRM.CODPLF 
    FROM R058RLG, R034PRM WHERE 
    R058RLG.CODPLT = R034PRM.CODPLT AND 
    R058RLG.VERPLF = R034PRM.VERPLF AND 
    R058RLG.CODPLF = R034PRM.CODPLF AND 
    R058RLG.CODRLG = R034PRM.CODRLG AND 
    R058RLG.COMRLG = 2 AND
    R034PRM.IDTPES = l_idtpes;
  TYPE t_r034prm IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE, 
	  RLGALF   R058RLG.RLGALF%TYPE,
	  CODCEN   R058RLG.CODCEN%TYPE,
	  CODPLT   R034PRM.CODPLT%TYPE,
	  CODRLG   R034PRM.CODRLG%TYPE,
	  VERPLF   R034PRM.VERPLF%TYPE,
	  CODPLF   R034PRM.CODPLF%TYPE);
  l_r034prm t_r034prm;

  CURSOR c_r034fap IS
    SELECT INIFAI,FIMFAI FROM R034FAP
	  WHERE IDTPES = l_idtpes AND CODPLT = l_r034prm.CODPLT AND
	  CODRLG = l_r034prm.CODRLG AND VERPLF = l_r034prm.verplf AND
	  CODPLF = l_r034prm.codplf AND DIASEM = l_diasem ORDER BY INIFAI;
  TYPE t_r034fap IS RECORD(
    INIFAI   R034FAP.INIFAI%TYPE,
	  FIMFAI   R034FAP.FIMFAI%TYPE);
  l_r034fap t_r034fap;
  
  CURSOR c_r034fap2 IS
    SELECT INIFAI,FIMFAI FROM R034FAP 
	  WHERE IDTPES = l_idtpes AND VERPLF = l_r034prm.verplf AND
	  CODRLG = 0 AND CODPLF = l_codplf_aux AND
	  DIASEM = l_diasem ORDER BY INIFAI;
  TYPE t_r034fap2 IS RECORD(
    INIFAI   R034FAP.INIFAI%TYPE, 
	  FIMFAI   R034FAP.FIMFAI%TYPE);
  l_r034fap2 t_r034fap2;
  
BEGIN
  /*Rotina baseada no fonte uc034prm*/   
  /*Inicialização*/
  l_diasem := 1;
  l_icard_num := 0;
  SELECT matcod INTO l_matcod FROM R070TSI;
  
  IF (l_matcod = 'S') THEN
      /*Pega o usuário da telemática, caso for SqlServer*/
	  SP_USUTEL(l_usutel OUT);
	  
	  SP_RETIDTPES(p_numemp, p_tipcol, p_numcad, 0, '', '', '', l_idtpes OUT);
	  
	  /*Se estiver excluindo um histórico de crachá ou finalizando, deleta o registro correspondente na MatCodin*/
	  IF (p_tipope = 'D') THEN
		  /*Coloca 12 posições para o icard*/
		  l_icard_num := CONVERT(CHAR_TO_NUMBER,p_icard);
		  SP_RETICARD(l_idtpes, l_icard_num, l_icardA OUT, l_icardR OUT, l_numser OUT);

		  l_comando := 'DELETE FROM '|| l_usutel ||'MATCODIN WHERE ICARD = '||''''||l_icardA||'''';
		  SP_CMDTSI(l_comando);
	  ELSE
		  LOOP
			  IF (l_diasem <= 4) THEN
				  /*Dias da semana: 0 = Dias Úteis, 7 = Sábado, 1 = Domingo, 8 = Feriado*/
				  IF l_diasem = 1 THEN
					  l_diasem_str := '0';
				  END IF;
				  IF l_diasem = 2 THEN
					  l_diasem_str := '7';
				  END IF;
				  IF l_diasem = 3 THEN
					  l_diasem_str := '1';
				  END IF;
				  IF l_diasem = 4 THEN
					  l_diasem_str := '8';
				  END IF;

				  /*Se não tiver crachá provisório pega o titular*/
				  SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0, 0, 0, 0, l_icard_num OUT);
				  IF l_icard_num = 0 THEN
					  SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0, 0, 0, 0, l_icard_num OUT);
				  END IF;

				  IF l_icard_num <> 0 THEN

					  /*Coloca 12 posições para o icard*/
					  SP_RETICARD(l_idtpes, l_icard_num, l_icardA OUT, l_icardR OUT, l_numser OUT);
					  
					  /*Deleta o regisro se já existir na MatCodin*/
					  l_comando := 'DELETE FROM '|| l_usutel ||'MATCODIN WHERE ICARD = '||''''||l_icardA||''''||' AND DIASEM = '||''''||l_diasem_str||'''';
					  SP_CMDTSI(l_comando);

					  FOREACH c_r034prm INTO l_r034prm.numeip,
											 l_r034prm.rlgalf,
											 l_r034prm.codcen,
											 l_r034prm.CODPLT,
											 l_r034prm.CODRLG,
											 l_r034prm.verplf,
											 l_r034prm.codplf
					  LOOP
						  /*Inicializa a faixa como vazio sempre antes de fazer um novo INSERT*/
						  l_faixa := ' ';
						  
						  FOREACH c_r034fap INTO l_r034fap.inifai,
												 l_r034fap.fimfai
						  LOOP
							  IF (l_r034fap.inifai = 0) AND (l_r034fap.fimfai = 0) THEN
								  l_r034fap.inifai := 0;
								  l_r034fap.fimfai := 1439;
							  END IF;

							  /*Separa a hora e os minutos para os dois terem 2 casas decimais cada*/
							  /*Precisa do FLOOR para arrendondar para baixo*/
							  l_horaini := FLOOR(l_r034fap.inifai / 60);
							  l_minini := MOD(l_r034fap.inifai, 60);
							  l_horafim := FLOOR(l_r034fap.fimfai / 60);
							  l_minfim := MOD(l_r034fap.fimfai, 60);

							  SP_INTSTR(l_horaini, '99', l_horaini_str OUT);
							  SP_INTSTR(l_minini, '99', l_minini_str OUT);
							  SP_INTSTR(l_horafim, '99', l_horafim_str OUT);
							  SP_INTSTR(l_minfim, '99', l_minfim_str OUT);

							  l_faixa := l_faixa || l_horaini_str || l_minini_str || l_horafim_str || l_minfim_str;

						  END LOOP;

						  IF (l_faixa = ' ') THEN
							  l_codplf_aux := l_r034prm.codplf;

							  LOOP
								  IF (l_codplf_aux <> -1) THEN
									  FOREACH c_r034fap2 INTO l_r034fap2.INIFAI,
															  l_r034fap2.FIMFAI
									  LOOP
										  IF (l_r034fap.inifai = 0) AND (l_r034fap.fimfai = 0) THEN
											  l_r034fap.inifai := 0;
											  l_r034fap.fimfai := 1439;
										  END IF;

										  /*Separa a hora e os minutos para os dois terem 2 casas decimais cada*/
										  /*Precisa do FLOOR para arrendondar para baixo*/
										  l_horaini := FLOOR(l_r034fap2.inifai / 60);
										  l_minini := MOD(l_r034fap2.inifai, 60);
										  l_horafim := FLOOR(l_r034fap2.fimfai / 60);
										  l_minfim := MOD(l_r034fap2.fimfai, 60);

										  SP_INTSTR(l_horaini, '99', l_horaini_str OUT);
										  SP_INTSTR(l_minini, '99', l_minini_str OUT);
										  SP_INTSTR(l_horafim, '99', l_horafim_str OUT);
										  SP_INTSTR(l_minfim, '99', l_minfim_str OUT);

										  l_faixa := l_faixa || l_horaini_str || l_minini_str || l_horafim_str || l_minfim_str;
									  END LOOP;

									  IF (l_faixa = ' ') AND (l_codplf_aux <> 0) THEN
										  /*Procura o codplf pai*/
										  BEGIN
											  SELECT PAIPLF INTO l_codplf_aux FROM R058PLF WHERE VERPLF = l_r034prm.verplf AND CODPLF = l_codplf_aux;
										  EXCEPTION
											  WHEN NO_DATA_FOUND THEN
												  l_codplf_aux := -1;
										  END;
									  ELSE
										  l_codplf_aux := -1;
									  END IF;
								  ELSE
									  /*Sai do LOOP*/
									  EXIT;
								  END IF;
							  END LOOP;
						  END IF;

						  IF (l_faixa = ' ') THEN
							  l_faixa := '00002359240024002400240024002400240024002400240024002400';
						  END IF;

						  l_faixa := lTrim(l_faixa);

						  LOOP
							  IF (Length(l_faixa) <= 48) THEN
								  l_faixa := l_faixa || '24002400';
							  ELSE
								  EXIT;
							  END IF;
						  END LOOP;

						  IF (Length(l_faixa) > 48) THEN
							  l_faixa := SUBSTRING(l_faixa,1,56);
						  END IF;

						  /* Corrige os campos de acordo com o tipo do coletor */
						  IF (l_r034prm.numeip = '000.000.000.000') THEN
							  SP_INTSTR(l_r034prm.codcen, '99', l_codcen_str OUT);
							  SP_INTSTR(l_r034prm.rlgalf, '99', l_rlgalf_str OUT);

						  ELSE
							  l_codcen_str := '00';
							  l_rlgalf_str := '00';
						  END IF;

						  /*Insere na tabela da Telemática*/
						  l_comando := 'INSERT INTO ' || l_usutel || 'MATCODIN (ICARD,END_IP,BLUEB,CODIN,DIASEM,FXPERM) ' ||
									   'VALUES ('||''''||l_icardA||''''||','||''''||l_r034prm.numeip||''''||','||''''||l_codcen_str||''''||','||''''||l_rlgalf_str||''''||','||''''||l_diasem_str||''''||','||''''||l_faixa||''''||')';
						  SP_CMDTSI(l_comando);
					  END LOOP;
				  END IF;
				  l_diasem := l_diasem + 1;
			  ELSE
				  /*Sai so LOOP dos dias da semana*/
				  EXIT;
			  END IF;
		  END LOOP;
	  END IF;
  END IF;
END␀cø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ÁPROCEDURE SP_MATGRP(P_NUMCRA NUMBER(12),P_TIPPES INTEGER,P_NUMEMP NUMBER,P_TIPCOL INTEGER,P_NUMCAD NUMBER,P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMMAT VARCHAR2(15))
 IS
