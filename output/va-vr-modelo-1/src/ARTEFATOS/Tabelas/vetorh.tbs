PROCEDURE R030FIL_ATUCON(P_TIPOPE NUMBER(1),P_NUMEMP NUMBER(4),P_CODFIL NUMBER(6),P_TIPINS NUMBER(1),P_NUMCGC NUMBER(14),P_INSCEI NUMBER(12),P_RAZSOC VARCHAR2(40),P_OLD_TIPINS NUMBER(1),P_OLD_NUMCGC NUMBER(14),P_NOMEMP VARCHAR2(40))
 IS

l_Comando             VARCHAR2(2047);
  l_data_atual          DATE;
  l_hora_atual          NUMBER(4);
  l_seqenv              NUMBER(2);
  l_datstr              CHAR(6);
  l_horstr              CHAR(4);
  l_seqstr              CHAR(2);
  l_datenv              CHAR(16);
  l_tipope_str          VARCHAR2(1);
  l_numemp_str          VARCHAR2(4);
  l_codfil_str          VARCHAR2(6);
  l_tipins              NUMBER(1);
  l_old_tipins          NUMBER(1);
  l_tipins_str          VARCHAR2(1);
  l_numcgc              NUMBER(14);
  l_old_numcgc          NUMBER(14);
  l_numcgc_str          VARCHAR2(14);
  l_inscei              NUMBER(12);
  l_inscei_str          VARCHAR2(12);
  l_tamraz              NUMBER(3);
  l_tamraz_str          VARCHAR2(3);
  l_razsoc              VARCHAR2(40);
  l_numemp              NUMBER(4);
  l_codfil              NUMBER(6);
  l_temdsp              NUMBER(1);
  l_tamraz_emp          NUMBER(3);
  l_tamraz_emp_str      VARCHAR2(3);
  l_razsoc_emp          VARCHAR2(40);

  /* CURSOR QUE RETORNA AS FAIXAS HORARIAS DE ALMOCO. USO = REFEICAO OBRIGATORIA. */
  CURSOR c_dsprep IS
  SELECT R058RLG.VERPLF, R058RLG.CODPLF FROM R058MOD, R058RLG
    WHERE  R058MOD.MODRLG = R058RLG.MODRLG AND R058RLG.COMRLG = 2
    AND R058MOD.CLAMOD IN (13) AND R058MOD.TIPMOD IN (16,17);
  TYPE t_dsprep IS RECORD(
    verplf   R058RLG.VERPLF%TYPE,
    codplf   R058RLG.CODPLF%TYPE);
  l_dsprep t_dsprep;
BEGIN

  /*Obtem a data/hora/segundo de envio da pendência.*/
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_seqenv     := SECOND(CURTIME());

  SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);

  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';


  /* Apenas gera atualização para tipo de incrição 1 = CNPJ ou 3 = CPF */
  IF (p_tipins = 1) OR (p_tipins = 3) THEN
      IF (p_tipins = 3) THEN
          l_tipins := 2;  /* Para CPF é valor 2 que envia à TSI e G6 */
      ELSE
          l_tipins := p_tipins;
      END IF;

      IF (p_numcgc IS NULL) THEN
          l_numcgc := 0;
      ELSE
          l_numcgc := p_numcgc;
      END IF;
  ELSE
      l_tipins := 0;
      l_numcgc := 0;
  END IF;

  /* a variável l_tipIns não tem o mesmo valor do campo r030fil.tipins, pois para TSI e G6 quando for CPF deve ser enviado valor 2*/
  IF ((l_tipins = 1) OR (l_tipins = 2) OR (p_tipins = 2)) THEN

      IF (p_inscei IS NULL) THEN
          l_inscei := 0;
      ELSE
          l_inscei := p_inscei;
      END IF;

      IF (p_razsoc IS NULL) THEN
          l_razsoc := 'SEM NOME';
      ELSE
          l_razsoc := lTrim(p_razsoc);
          l_razsoc := rTrim(l_razsoc);
      END IF;

      l_tamraz := Length(l_razsoc);

      IF (p_nomemp IS NULL) OR (p_nomemp = '') THEN
        l_razsoc_emp := 'SEM NOME';
      ELSE
        l_razsoc_emp := p_nomemp;
      END IF;

      IF (l_razsoc_emp IS NULL) THEN
          l_razsoc_emp := '';
      ELSE
          l_razsoc_emp := lTrim(l_razsoc_emp);
          l_razsoc_emp := rTrim(l_razsoc_emp);
      END IF;

      l_tamraz_emp := Length(l_razsoc_emp);

      /*Conversão para string*/
      SP_INTSTR(p_tipope,'9',l_tipope_str OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp_str OUT);
      SP_INTSTR(p_codfil,'999999',l_codfil_str OUT);
      SP_INTSTR(l_tipins,'9',l_tipins_str OUT);

      l_numcgc_str := l_numcgc;
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_numcgc_str) > 13) THEN
              EXIT;
          END IF;
          l_numcgc_str := '0'||l_numcgc_str;
      END LOOP;

      SP_INTSTR(l_inscei,'999999999999',l_inscei_str OUT);
      SP_INTSTR(l_tamraz,'999',l_tamraz_str OUT);
      SP_INTSTR(l_tamraz_emp,'999',l_tamraz_emp_str OUT);

      l_Comando := '59'||l_DatEnv||l_tipope_str||l_numemp_str||l_codfil_str
                       ||l_tipins_str||l_numcgc_str||l_inscei_str||l_tamraz_emp_str
                       ||l_razsoc_emp||l_tamraz_str||l_razsoc;

      /*Envia a Pendência com parâmetro zero = envia para todas as CSM*/
      SP_PorCom(l_Comando,'0');

      /*Tratamento campos old*/
      /*Tratamento para envio da pendência*/
      IF ((p_old_tipins = 1) OR (p_old_tipins = 3)) THEN
          IF (p_old_tipins = 3) THEN
              l_old_tipins := 2;
          ELSE
              l_old_tipins := p_old_tipins;
          END IF;

          IF (p_old_numcgc IS NULL) THEN
              l_old_numcgc := 0;
          ELSE
              l_old_numcgc := p_old_numcgc;
          END IF;
      ELSE
          l_old_tipins := 0;
          l_old_numcgc := 0;
      END IF;

      l_temdsp := 0;
      BEGIN
          FOREACH c_dsprep INTO l_dsprep.verplf, l_dsprep.codplf
          LOOP
              SP_RetFilial(l_dsprep.verplf, l_dsprep.codplf, l_numemp OUT, l_codfil OUT);
              IF (l_numemp = p_numemp) AND (l_codfil = p_codfil) THEN
                  l_temdsp := 1;
                  EXIT;
              END IF;
          END LOOP;
      EXCEPTION
          WHEN OTHERS THEN l_temdsp := 0;
      END;

      /*Atualiza tabela REPEMPR001 se existir*/
      IF (l_temdsp = 1) THEN
        SP_REPEMPR001(p_tipope, l_tipins, l_numcgc, l_inscei, l_razsoc, l_old_tipins, l_old_numcgc);
      END IF;
  END IF;
END		SENIOR;24>SP_DATSTR
SP_INTSTR
SP_PORCOM
SP_RETFILIAL
SP_REPEMPR001
)␀␀

PROCEDURE R030FIL_ATUCON(P_TIPOPE NUMBER(1),P_NUMEMP NUMBER(4),P_CODFIL NUMBER(6),P_TIPINS NUMBER(1),P_NUMCGC NUMBER(14),P_INSCEI NUMBER(12),P_RAZSOC VARCHAR2(40),P_OLD_TIPINS NUMBER(1),P_OLD_NUMCGC NUMBER(14),P_NOMEMP VARCHAR2(40))
 IS

l_Comando             VARCHAR2(2047);
  l_data_atual          DATE;
  l_hora_atual          NUMBER(4);
  l_seqenv              NUMBER(2);
  l_datstr              CHAR(6);
  l_horstr              CHAR(4);
  l_seqstr              CHAR(2);
  l_datenv              CHAR(16);
  l_tipope_str          VARCHAR2(1);
  l_numemp_str          VARCHAR2(4);
  l_codfil_str          VARCHAR2(6);
  l_tipins              NUMBER(1);
  l_old_tipins          NUMBER(1);
  l_tipins_str          VARCHAR2(1);
  l_numcgc              NUMBER(14);
  l_old_numcgc          NUMBER(14);
  l_numcgc_str          VARCHAR2(14);
  l_inscei              NUMBER(12);
  l_inscei_str          VARCHAR2(12);
  l_tamraz              NUMBER(3);
  l_tamraz_str          VARCHAR2(3);
  l_razsoc              VARCHAR2(40);
  l_numemp              NUMBER(4);
  l_codfil              NUMBER(6);
  l_temdsp              NUMBER(1);
  l_tamraz_emp          NUMBER(3);
  l_tamraz_emp_str      VARCHAR2(3);
  l_razsoc_emp          VARCHAR2(40);

  /* CURSOR QUE RETORNA AS FAIXAS HORARIAS DE ALMOCO. USO = REFEICAO OBRIGATORIA. */
  CURSOR c_dsprep IS
  SELECT R058RLG.VERPLF, R058RLG.CODPLF FROM R058MOD, R058RLG
    WHERE  R058MOD.MODRLG = R058RLG.MODRLG AND R058RLG.COMRLG = 2
    AND R058MOD.CLAMOD IN (13) AND R058MOD.TIPMOD IN (16,17);
  TYPE t_dsprep IS RECORD(
    verplf   R058RLG.VERPLF%TYPE,
    codplf   R058RLG.CODPLF%TYPE);
  l_dsprep t_dsprep;
BEGIN

  /*Obtem a data/hora/segundo de envio da pendência.*/
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_seqenv     := SECOND(CURTIME());

  SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);

  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';


  /* Apenas gera atualização para tipo de incrição 1 = CNPJ ou 3 = CPF */
  IF (p_tipins = 1) OR (p_tipins = 3) THEN
      IF (p_tipins = 3) THEN
          l_tipins := 2;  /* Para CPF é valor 2 que envia à TSI e G6 */
      ELSE
          l_tipins := p_tipins;
      END IF;

      IF (p_numcgc IS NULL) THEN
          l_numcgc := 0;
      ELSE
          l_numcgc := p_numcgc;
      END IF;
  ELSE
      l_tipins := 0;
      l_numcgc := 0;
  END IF;

  /* a variável l_tipIns não tem o mesmo valor do campo r030fil.tipins, pois para TSI e G6 quando for CPF deve ser enviado valor 2*/
  IF ((l_tipins = 1) OR (l_tipins = 2) OR (p_tipins = 2)) THEN

      IF (p_inscei IS NULL) THEN
          l_inscei := 0;
      ELSE
          l_inscei := p_inscei;
      END IF;

      IF (p_razsoc IS NULL) THEN
          l_razsoc := 'SEM NOME';
      ELSE
          l_razsoc := lTrim(p_razsoc);
          l_razsoc := rTrim(l_razsoc);
      END IF;

      l_tamraz := Length(l_razsoc);

      IF (p_nomemp IS NULL) OR (p_nomemp = '') THEN
        l_razsoc_emp := 'SEM NOME';
      ELSE
        l_razsoc_emp := p_nomemp;
      END IF;

      IF (l_razsoc_emp IS NULL) THEN
          l_razsoc_emp := '';
      ELSE
          l_razsoc_emp := lTrim(l_razsoc_emp);
          l_razsoc_emp := rTrim(l_razsoc_emp);
      END IF;

      l_tamraz_emp := Length(l_razsoc_emp);

      /*Conversão para string*/
      SP_INTSTR(p_tipope,'9',l_tipope_str OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp_str OUT);
      SP_INTSTR(p_codfil,'999999',l_codfil_str OUT);
      SP_INTSTR(l_tipins,'9',l_tipins_str OUT);

      l_numcgc_str := l_numcgc;
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_numcgc_str) > 13) THEN
              EXIT;
          END IF;
          l_numcgc_str := '0'||l_numcgc_str;
      END LOOP;

      SP_INTSTR(l_inscei,'999999999999',l_inscei_str OUT);
      SP_INTSTR(l_tamraz,'999',l_tamraz_str OUT);
      SP_INTSTR(l_tamraz_emp,'999',l_tamraz_emp_str OUT);

      l_Comando := '59'||l_DatEnv||l_tipope_str||l_numemp_str||l_codfil_str
                       ||l_tipins_str||l_numcgc_str||l_inscei_str||l_tamraz_emp_str
                       ||l_razsoc_emp||l_tamraz_str||l_razsoc;

      /*Envia a Pendência com parâmetro zero = envia para todas as CSM*/
      SP_PorCom(l_Comando,'0');

      /*Tratamento campos old*/
      /*Tratamento para envio da pendência*/
      IF ((p_old_tipins = 1) OR (p_old_tipins = 3)) THEN
          IF (p_old_tipins = 3) THEN
              l_old_tipins := 2;
          ELSE
              l_old_tipins := p_old_tipins;
          END IF;

          IF (p_old_numcgc IS NULL) THEN
              l_old_numcgc := 0;
          ELSE
              l_old_numcgc := p_old_numcgc;
          END IF;
      ELSE
          l_old_tipins := 0;
          l_old_numcgc := 0;
      END IF;

      l_temdsp := 0;
      BEGIN
          FOREACH c_dsprep INTO l_dsprep.verplf, l_dsprep.codplf
          LOOP
              SP_RetFilial(l_dsprep.verplf, l_dsprep.codplf, l_numemp OUT, l_codfil OUT);
              IF (l_numemp = p_numemp) AND (l_codfil = p_codfil) THEN
                  l_temdsp := 1;
                  EXIT;
              END IF;
          END LOOP;
      EXCEPTION
          WHEN OTHERS THEN l_temdsp := 0;
      END;

      /*Atualiza tabela REPEMPR001 se existir*/
      IF (l_temdsp = 1) THEN
        SP_REPEMPR001(p_tipope, l_tipins, l_numcgc, l_inscei, l_razsoc, l_old_tipins, l_old_numcgc);
      END IF;
  END IF;
END␀ÆÒ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
