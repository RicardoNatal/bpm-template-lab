      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REFEVE', CONVERT(NUMBER_TO_CHAR, :OLD.REFEVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALEVE', CONVERT(NUMBER_TO_CHAR, :OLD.VALEVE));
      END;
  END IF; 
END␀␀␀Ôò␀␀␀␀␀␀␀␀␀␀␀␀ËÕ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀}␀×␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀œ$€$0.w␀Æÿ␀␀…Ó␀␀␀²DÑ␀␀␀␀␀␀␀␀xI;SlFqC␀êÿ␀␀ÿ␀¦(­␀␀␀␀␀␀␀␀»(¬(°(p␀Æÿ␀␀®Õ␀␀␀z-±␀␀␀␀␀␀␀␀î@ë¢␀␀ë¢␀␀q␀Æÿ␀␀âß␀␀␀ƒDÑ␀␀␀␀␀␀␀␀õL-FqC␀êÿ␀␀ÿ␀7oÑ␀␀␀␀␀␀␀␀GÔFGqC␀êÿ␀␀ÿ␀dEÑ␀␀␀␀␀␀␀␀8H'º␀␀4HqC␀êÿ␀␀ÿ␀oÑ␀␀␀␀␀␀␀␀ÆFoÅFqC␀êÿ␀␀ÿ␀␀␀¿␀␀␀␀␀␀␀␀␀J␀␀K␀␀n␀Æÿ␀␀ÿ0(oÑ␀␀␀␀␀␀␀␀NOñ␀␀‘HqC␀êÿ␀␀ÿ␀ Ê␀␀¹␀␀␀␀␀␀␀␀\í\N␀Æÿ␀␀ÿ␀^Ê␀␀¹␀␀␀␀␀␀␀␀\ò\N␀Æÿ␀␀ÿ␀rÊ␀␀±␀␀␀␀␀␀␀␀Œ\Ó␀a\q␀Æÿ␀␀ÿ␀Ê␀␀±␀␀␀␀␀␀␀␀…\t;\q␀Æÿ␀␀ÿ␀Ê␀␀´␀␀␀␀␀␀␀␀~\3f,\r␀Æÿ␀␀ÿ␀0[±␀␀␀␀␀␀␀␀N\C[N\q␀Æÿ␀␀ÿ␀_½␀␀¹␀␀␀␀␀␀␀␀}¾␀␀%&Q)␀␀Æÿ␀␀ÿ␀Ê␀␀´␀␀␀␀␀␀␀␀1\dn1\r␀Æÿ␀␀ÿ␀©DÑ␀␀␀␀␀␀␀␀WFVFWFqC␀êÿ␀␀ÿ␀„ù␀␀›␀␀␀␀␀␀␀␀Dú␀␀iù␀␀ú␀␀j)␀␀Æÿ␀␀ÿ␀Ğ␀‘␀␀␀␀␀␀␀␀®ù␀␀Ê␀³ù␀␀h)␀␀Æÿ␀␀ÿ␀{m␀␀␀␀␀␀␀™m™m™mn␀Æÿ␀␀ÿ␀ˆ-ö␀␀␀␀␀␀␀IAˆ-<m␀␀␀ÿ␀␀ÿ␀/c␀␀␀␀␀␀␀T/>/>/`␀␀ÿ␀␀ÿ␀u ‘␀␀␀␀␀␀␀␀¦„„h)␀␀Æÿ␀␀ÿ␀r ‘␀␀␀␀␀␀␀␀ŒŒŒh)␀␀Æÿ␀␀ÿ␀ ‘␀␀␀␀␀␀␀␀àººh)␀␀Æÿ␀␀ÿ␀‘␀␀␀␀␀␀␀␀ ™h)␀␀Æÿ␀␀ÿ␀Œ ‘␀␀␀␀␀␀␀␀ÁÁÁh)␀␀Æÿ␀␀ÿ␀‘␀␀␀␀␀␀␀␀ˆ–h)␀␀Æÿ␀␀ÿ␀ ‘␀␀␀␀␀␀␀␀ÉÉÉh)␀␀Æÿ␀␀ÿ␀‘␀␀␀␀␀␀␀␀Ÿ’—h)␀␀Æÿ␀␀ÿ␀ ‘␀␀␀␀␀␀␀␀ÕÔh)␀␀Æÿ␀␀ÿ␀ú‘␀␀␀␀␀␀␀␀ÛRRh)␀␀Æÿ␀␀ÿ␀‚‘␀␀␀␀␀␀␀␀¡Š“h)␀␀Æÿ␀␀ÿ␀ù‘␀␀␀␀␀␀␀␀XVXh)␀␀Æÿ␀␀ÿ␀‘␀␀␀␀␀␀␀␀›Œ”h)␀␀Æÿ␀␀ÿ␀œ␀‘␀␀␀␀␀␀␀␀ã␀Á␀Â␀h)␀␀Æÿ␀␀ÿ␀␀‘␀␀␀␀␀␀␀␀×␀²␀³␀h)␀␀