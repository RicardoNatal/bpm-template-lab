TRIGGER R032TPO_ED AFTER DELETE ON R032TPO FOR EACH ROW DECLARE
	l_CmpDatPag DATE;
	l_PossuiEnvio NUMBER(1);
BEGIN
	BEGIN
	/* Busca se existe envio de S-1200 para o colaborador */
    SELECT 1 INTO l_PossuiEnvio
      FROM R350RPA
      WHERE NUMEMP = :OLD.NUMEMP 
		AND INDAPU = 1 
		AND PERAPU = :OLD.CMPPTE
		AND TIPCOL = :OLD.TIPCOL 
		AND NUMCAD = :OLD.NUMCAD
		AND SEQRE0 = (SELECT MAX(SEQRE0)
		 FROM R350RPA RPA
        WHERE RPA.NUMEMP = NUMEMP
          AND RPA.TIPCOL = TIPCOL
          AND RPA.NUMCAD = NUMCAD
          AND RPA.PERAPU = PERAPU
          AND RPA.INDAPU = INDAPU); 
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_PossuiEnvio := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao ler R350RPA';
	END;
	
	IF (l_PossuiEnvio = 1) THEN
		l_CmpDatPag := DATETIME(1, MONTH(:OLD.CMPPTE), YEAR(:OLD.CMPPTE), 0, 0, 0);
		BEGIN
			SP_R350PEM(:OLD.NUMEMP,:OLD.CODFIL,:OLD.TIPCOL,:OLD.NUMCAD,l_CmpDatPag,1,5,1,'S-1200');
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro gerar registro de pendência mensal para envio do layout S-1200.';
		END;
	END IF;
END␀␀␀9º␀␀␀␀␀␀␀␀␀␀␀úÒ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀—,¼␀	␀␀␀␀␀␀␀=nnX)␀␀Æÿ␀␀!#␀w+Ñ␀	␀␀␀␀␀␀␀Q0Í/Ó/œ␀␀␀êÿ␀␀ğÒ␀␀␀.␀t	␀␀␀␀␀␀␀O␀Ü␀Ü␀n␀Æÿ␀␀õÒ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀t%Ó
