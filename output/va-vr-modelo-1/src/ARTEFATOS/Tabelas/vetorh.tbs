(
␀␀

PROCEDURE SP_PESFROMIDTPES(P_IDTPES VARCHAR2(23),P_TIPPES OUT NUMBER(2),P_NUMEMP OUT NUMBER(4),P_TIPCOL OUT NUMBER(1),P_NUMCAD OUT NUMBER(9),P_TIPDOC OUT NUMBER(1),P_NUMDOC OUT VARCHAR2(20),P_NUMMAT OUT VARCHAR2(15),P_PROPAC OUT VARCHAR2(20))
 IS

l_tippes NUMBER(2);
  l_idtpes VARCHAR2(23);
  l_numemp NUMBER(4);
  l_tipcol NUMBER(1);
  l_numcad NUMBER(9);
  l_tipdoc NUMBER(1);
  l_numdoc VARCHAR2(20);
  l_nummat VARCHAR2(15);
  l_propac VARCHAR2(20);
BEGIN
  /*Inicializa os valores*/
  l_numemp := 0;
  l_tipcol := 0;
  l_numcad := 0;
  l_tipdoc := 0;
  l_numdoc := '0';
  l_nummat := '0';
  l_propac := '0';

  l_idtpes := LTRIM(RTRIM(p_idtpes));
  l_tippes := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,1,2));
  /*Colaborador*/
  IF (l_tippes < 4) THEN
    l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
    l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
    l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
  ELSE
    /*Visitante*/
    IF (l_tippes = 4) THEN
      l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
      l_numdoc := SUBSTRING(l_idtpes,4,20);
    ELSE
      /*Outras unidades*/
      IF (l_tippes = 5) THEN
        l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
        l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,9));
      ELSE
          /* Aluno */
        IF (l_tippes = 10) THEN
          l_nummat := SUBSTRING(l_idtpes,3,15);
        ELSE
          /* Responsável Aluno */
          IF (l_tippes = 7) THEN
            l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
            l_numdoc := SUBSTRING(l_idtpes,4,20);
          ELSE
            /* Paciente */
            IF (l_tippes = 9) THEN
              l_propac := SUBSTRING(l_idtpes,3,20);
            ELSE
              IF (l_tippes = 11) THEN
                l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                l_numdoc := SUBSTRING(l_idtpes,4,20);
              ELSE
                /* Candidato */
                IF (l_tippes = 13) THEN
                  l_numcad := SUBSTRING(l_idtpes,4,20);
                ELSE
                  l_tippes := 0;
                END IF;
              END IF;
            END IF;
          END IF;
        END IF;
      END IF;
    END IF;
  END IF;
  /*Retorna os valores*/
  p_tippes := l_tippes;
  p_numemp := l_numemp;
  p_tipcol := l_tipcol;
  p_numcad := l_numcad;
  p_tipdoc := l_tipdoc;
  p_numdoc := l_numdoc;
  p_nummat := l_nummat;
  p_propac := l_propac;
END		SENIOR;21
