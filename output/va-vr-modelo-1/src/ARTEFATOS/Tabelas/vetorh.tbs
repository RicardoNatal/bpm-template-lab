␀	␀␀CREATE OR REPLACE PROCEDURE SP_RETLOGPEN(p_logpen IN OUT varchar(4000))
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  l_logpen       varchar(2047);
  l_os_user      varchar(20);
  l_app_user     varchar(30);
  l_app_name     varchar(30);
  l_session_user varchar(20);
  l_host         varchar(60);
  l_call_stack   varchar(2000);
  l_data_atual   varchar(20);
  l_gerlpe       CHAR(1);
  l_session_id   BIGINT;
BEGIN
  l_logpen := ' ';
  BEGIN
    SELECT GERLPE INTO l_gerlpe FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_gerlpe := 'N';
  END;

  IF (l_gerlpe = 'S') THEN
    l_data_atual := to_char(current_timestamp, 'dd/mm/yyyy hh24:mi:ss');
    BEGIN
      l_session_user := CURRENT_USER;
      if ( (l_session_user = '') or (l_session_user is null) ) then
        l_session_user := ' ';
      end if;
    EXCEPTION
      WHEN OTHERS THEN
        l_session_user := ' ';
    END;

    BEGIN
      select client_hostname into l_host
      from pg_stat_activity 
      where pid = pg_backend_pid();
      if ( (l_host = '') or (l_host is null) ) then
        l_host := ' ';
      end if;
    EXCEPTION
      WHEN OTHERS THEN
        l_host := ' ';
    END;

    BEGIN
      select application_name into l_app_name
      from pg_stat_activity 
      where pid = pg_backend_pid();
      if ( (l_app_name = '') or (l_app_name is null) ) then
        l_app_name := ' ';
      end if;
    EXCEPTION
      WHEN OTHERS THEN
        l_app_name := ' ';
    END;

    BEGIN
      SELECT APPUSR INTO l_app_user
        FROM R911SEC
       WHERE NUMSEC = CURRENT_USER;
    EXCEPTION
      WHEN OTHERS THEN
        l_app_user := ' ';
    END;
    /*Valida o campo*/
    if ( (l_app_user = '') or (l_app_user is null) ) then
      l_app_user := ' ';
    end if;


    l_logpen := 'UsuÃ¡rio do banco de dados:' || l_session_user || chr(13) || chr(10);
    l_logpen := l_logpen || 'UsuÃ¡rio da aplicaÃ§Ã£o:' || l_app_user || chr(13) || chr(10);
    l_logpen := l_logpen || 'Nome da aplicaÃ§Ã£o ativa:' || l_app_name || chr(13) || chr(10);
    l_logpen := l_logpen || 'Host:' || l_host||chr(13)||chr(10);
    l_logpen := l_logpen || 'Data e hora:' || l_data_atual || chr(13) || chr(10);
  END IF;

  p_logpen := l_logpen;
END;
$BODY$;
