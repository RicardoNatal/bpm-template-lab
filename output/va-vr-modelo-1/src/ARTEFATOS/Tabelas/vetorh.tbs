TRIGGER R304RCC_SI AFTER INSERT ON R304RCC
DECLARE
	CURSOR c_R304RCC IS
	SELECT NUMEMP, NUMEDI, NUMESP, TIPQUA, CARFUN, DATINI, SEQREG, DATHOM
	  FROM R304RCC
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');

	TYPE t_R304RCC IS RECORD (
		NUMEMP   R304RCC.NumEmp%TYPE,
		NUMEDI   R304RCC.NumEdi%TYPE,
		NUMESP   R304RCC.NUMESP%TYPE,
		TIPQUA   R304RCC.TIPQUA%TYPE,
		CARFUN   R304RCC.CARFUN%TYPE,
		DATINI   R304RCC.DATINI%TYPE,
		SEQREG   R304RCC.SEQREG%TYPE,
		DATHOM   R304RCC.DATHOM%TYPE
	);
    
    l_NumEmpAux   R304RCC.NumEmp%TYPE;
	l_NumEdiAux   R304RCC.NumEdi%TYPE;
	
    l_R304RCC t_R304RCC;    
	l_PidSta VARCHAR2(30);
	l_DesRes VARCHAR2(250);
BEGIN
	l_NumEmpAux := 0;
	l_NumEdiAux := '';
	l_PidSta    := NULL;
	FOREACH c_R304RCC INTO l_R304RCC.NumEmp, l_R304RCC.NumEdi, l_R304RCC.NUMESP, l_R304RCC.TIPQUA, l_R304RCC.CARFUN, l_R304RCC.DATINI, l_R304RCC.SEQREG, l_R304RCC.DATHOM
	LOOP		
		/* Se último registro se tratava do mesmo Numero do Edital, utiliza o PID encontrando anteriormente */
		IF ((l_R304RCC.NumEmp <> l_NumEmpAux)  OR 
			(l_R304RCC.NumEdi <> l_NumEdiAux)) THEN
			l_PidSta := NULL;
		END IF;
		
		/* Verifica se já tem algum outro registro do mesmo texto jurídico que esteja pendente (P - Pendente Envio ou R - Erro Envio) */
		IF (l_PidSta IS NULL) THEN
			BEGIN
				SELECT DISTINCT RCC.PIDSTA INTO l_PidSta 
				  FROM R304RCC RCC, R304STA STA 
				 WHERE RCC.PIDSTA = STA.PIDSTA 
				   AND RCC.NUMEMP = l_R304RCC.NUMEMP 
				   AND RCC.NUMEDI = l_R304RCC.NUMEDI
				   AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
			EXCEPTION
				WHEN NO_DATA_FOUND THEN
					l_PidSta := NULL; 
				WHEN TOO_MANY_ROWS THEN
					RAISERROR 103 'Foi encontrado mais de um registro de status com situação Pendente Envio para o Número do Edital.';				
				WHEN OTHERS THEN
					RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304RCC.';
			END;
		END IF;
		
		IF (l_PidSta IS NULL) THEN
			SP_GERPIDSTA(l_R304RCC.NumEmp, 16, l_PidSta OUT);
			l_DesRes := 'Número do Edital: ' || l_R304RCC.NumEdi;
			SP_GERSTA_ESFINGE(16, l_PidSta, l_R304RCC.DATHOM, l_DesRes, l_R304RCC.NumEmp, 0, 0);
		END IF;
		
		BEGIN
			UPDATE R304RCC 
			   SET PIDSTA = l_PidSta 
			 WHERE NUMEMP = l_R304RCC.NumEmp 
			   AND NUMESP = l_R304RCC.NUMESP
			   AND TIPQUA = l_R304RCC.TIPQUA
			   AND CARFUN = l_R304RCC.CARFUN
			   AND DATINI = l_R304RCC.DATINI
			   AND NumEdi = l_R304RCC.NumEdi
			   AND SEQREG = l_R304RCC.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304RCC.';
		END;
		
		l_NumEmpAux := l_R304RCC.NumEmp;
		l_NumEdiAux := l_R304RCC.NumEdi;
	END LOOP;
END␀Ôå␀␀		SENIOR;0‚␀␀TRIGGER R304RCC_EI BEFORE INSERT ON R304RCC FOR EACH ROW
DECLARE
	l_SeqReg   R304RCC.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_StaEnv   R304STA.StaEnv%TYPE;
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Busca a última sequência cadastrada para a mesma Empresa/Edital */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304RCC
		 WHERE NUMEMP = :NEW.NumEmp
		   AND NUMEDI = :NEW.NumEdi
		   AND NUMESP = :NEW.NUMESP
		   AND TIPQUA = :NEW.TIPQUA
	       AND CARFUN = :NEW.CARFUN
		   AND DATINI = :NEW.DATINI
		   AND SEQREG <> :NEW.SeqReg;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304RCC.';
	END;
	
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
		
		/* Busca o status da última sequência */
		BEGIN
			SELECT STA.STAENV INTO l_StaEnv
			  FROM R304RCC RCC, R304STA STA
			 WHERE RCC.NUMEMP = :NEW.NumEmp
			   AND RCC.NUMEDI = :NEW.NumEdi
			   AND RCC.SEQREG = l_SeqReg
			   AND RCC.PIDSTA = STA.PIDSTA;
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				RAISERROR 103 'Não encontrou status do último registro.';
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar status do registro com última sequência na tabela R304RCC.';
		END;
		
		/* Verifica se a última sequência está com status Cancelado */
		IF (l_StaEnv <> 'N') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que o registro de sequência ' || l_SeqRegStr || ' esteja com status Cancelado.';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀Òå␀␀		SENIOR;04␀␀

TRIGGER R304RCC_AU AFTER UPDATE ON R304RCC FOR EACH ROW
BEGIN
	IF (:OLD.DatHom <> :NEW.DatHom) THEN
		BEGIN
			UPDATE R304STA SET DATREF = :NEW.DatHom WHERE PIDSTA = :NEW.PidSta;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar data de referência na tabela R304STA';
		END;
	END IF;
END␀Õå␀␀		SENIOR;0±␀␀

TRIGGER R304RCC_EU BEFORE UPDATE ON R304RCC FOR EACH ROW
DECLARE
	l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
	/* Não deixa alterar registro caso status seja diferente de P - Pendente Envio e R - Erro Envio */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados/excluídos.';
	END IF;
END␀Öå␀␀	SENIOR;0/␀␀

