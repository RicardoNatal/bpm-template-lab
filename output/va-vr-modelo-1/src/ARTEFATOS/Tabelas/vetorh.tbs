␀…Ó␀␀␀œDÑ␀	␀␀␀␀␀␀Ó/Ó/Ó/œ␀␀␀êÿ␀␀ÿ␀!,±␀	␀␀␀␀␀␀é?¤:é?q␀␀Æÿ␀␀ÿ␀¦␀␀c	␀␀␀␀␀␀ÿ©␀␀ÿ©␀␀ÿ©␀␀`␀␀␀ÿ␀␀ÿ␀Ñ'␀Ÿ␀␀␀␀␀␀␀#␀␀#␀l)␀␀␀Æÿ␀␀ÿ␀␀␀␀	0;1;2;3;4øÕ␀␀		SENIOR;0İ␀␀/* Trigger de inclusão/atualizacao dos valores totais dos bolsos wiipo após inclusão. Movimentação R044BWV -> R044BWC*/
TRIGGER R044BWV_EI AFTER INSERT ON R044BWV FOR EACH ROW

BEGIN

	BEGIN
		UPDATE R044BWC SET VLRTOT = (VLRTOT + :NEW.VLRBOL) WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD AND DATCMP = :NEW.DATCMP; 
	EXCEPTION
    	WHEN OTHERS THEN RAISERROR 103 'R044BWV_EI: Erro ao atualizar o registro totalizador do Bolso Wiipo.';
	END;

END␀ùÕ␀␀		SENIOR;0␀␀

/* Trigger de atualizacao dos valores totais dos bolsos wiipo após update. Movimentação R044BWV -> R044BWC*/
TRIGGER R044BWV_EU AFTER UPDATE ON R044BWV FOR EACH ROW

BEGIN

	IF ( :NEW.VLRBOL <> :OLD.VLRBOL ) THEN

		BEGIN
			UPDATE R044BWC SET VLRTOT = (VLRTOT - :OLD.VLRBOL + :NEW.VLRBOL) WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATCMP = :OLD.DATCMP; 
		EXCEPTION
	    	WHEN OTHERS THEN RAISERROR 103 'R044BWV_EU: Erro ao atualizar o registro totalizador do Bolso Wiipo.';
		END;
		
	END IF;

END␀÷Õ␀␀		SENIOR;0ş␀␀

/* Trigger de atualizacao dos valores totais dos bolsos wiipo após delete. Movimentação R044BWV -> R044BWC*/
TRIGGER R044BWV_ED AFTER DELETE ON R044BWV FOR EACH ROW

BEGIN

	BEGIN
		/* não preciso do cpf do funcionário */
		UPDATE R044BWC SET VLRTOT = (VLRTOT - :OLD.VLRBOL) WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATCMP = :OLD.DATCMP; 
	EXCEPTION
    	WHEN OTHERS THEN RAISERROR 103 'R044BWV_ED: Erro ao atualizar o registro totalizador do Bolso Wiipo.';
	END;

