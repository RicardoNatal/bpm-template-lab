DECLARE
	l_coddsp VARCHAR2(9);

BEGIN  

	IF (:NEW.ENDENT <> :OLD.ENDENT OR :NEW.ESTDEF <> :OLD.ESTDEF OR :NEW.DLYATV <> :OLD.DLYATV) THEN
		SP_INTSTR(:NEW.CODDSP, '999999999', l_coddsp OUT);
		SP_SAM_PENDENCIES(23, 2, l_coddsp);
