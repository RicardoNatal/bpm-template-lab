      l_numpis := 0;
      IF (:OLD.NUMPIS > 0) THEN
        l_TipOpeRep := 'E';
      END IF;
  END IF;

  IF (l_creac1 IS NULL) THEN
      l_creac1 := '00';
      l_qtdcr1 := '00';
      l_fxcre1 := '00000000';
  END IF;

