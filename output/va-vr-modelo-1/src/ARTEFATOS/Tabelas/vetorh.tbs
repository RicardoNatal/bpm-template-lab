TRIGGER R064CMP_ED AFTER DELETE ON R064CMP FOR EACH ROW

DECLARE
  l_DataZero   DATE;
  l_data_fim   DATE;
  l_online     BOOLEAN;
  l_datatu     DATE;
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R064CMP_AUX;
  
BEGIN
   l_datatu := CURDATE();
   l_DataZero := '31/12/1900,00:00:00';
   l_data_fim := :OLD.DATFIM;
   IF   (l_data_fim = l_DataZero) THEN
        l_data_fim := '04/06/2080,00:00:00';
   END IF;

   /* ACESSO atualiza as faixas de acesso e ponto */
   IF  (DATETIMEADD(DD,-6,:OLD.DATINI) <= l_datatu)
   AND (:OLD.DATFIM >= l_datatu) THEN
        SP_VerOnLine(l_online OUT);
        IF   (l_online = TRUE) THEN
            BEGIN
            /* Salva Registro  */
              INSERT INTO R064CMP_AUX (NUMEMP,TIPCOL,NUMCAD,DATINI)
                          VALUES (:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.DATINI);
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro no INSERT em R064CMP_AUX.';
            END;
        END IF;
   END IF;

   BEGIN
   UPDATE R066APU SET DIAALT = 4
          WHERE NUMEMP = :OLD.NUMEMP AND
                TIPCOL = :OLD.TIPCOL AND
                NUMCAD = :OLD.NUMCAD AND
                DATAPU >= :OLD.DATINI AND
                DATAPU <= l_data_fim;
   EXCEPTION WHEN OTHERS THEN
     NULL;
   END;
END␀␀␀È/␀␀␀␀␀␀␀␀␀␀␀␀␀␀‘Ø␀␀…¬␀␀´␀„␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t„␀␀␀␀␀␀␀Ü␀t␀Ü␀n-‰␀Æÿ␀␀ÿ␀c¬␀␀Ì␀„␀␀␀␀␀␀␀.%0.0.w$‰␀Æÿ␀␀ÿ␀EÑ␀„␀␀␀␀␀␀␀iG]G]GqC&‰␀êÿ␀␀ÿ␀(␀q„␀␀␀␀␀␀␀¯␀t␀t␀n.‰␀Æÿ␀␀ÿ␀½␀␀U„␀␀␀␀␀␀␀Á␀␀áÀ␀␀áÀ␀␀n*‰␀Æÿ␀␀ÿ␀åDÑ␀„␀␀␀␀␀␀␀ÛFÔFÔFqC%‰␀êÿ␀␀ÿ␀ş␀␀·␀„␀␀␀␀␀␀␀®”␀␀­”␀␀®”␀␀ì*␀)‰␀Æÿ␀␀ÿ␀o·␀„␀␀␀␀␀␀␀—n–n—nì*␀'‰␀Æÿ␀␀ÿ␀Ê␀␀·␀„␀␀␀␀␀␀␀Ë␀␀GË␀␀Ë␀␀ì*␀+‰␀Æÿ␀␀ÿ␀•-±␀„␀␀␀␀␀␀␀û=Ÿ␀Ÿ␀q,‰␀Æÿ␀␀ÿ␀Ä¢␀␀±␀„␀␀␀␀␀␀␀7£␀␀Î¢␀␀7£␀␀q␀Æÿ␀␀ÿ␀¸,´␀„␀␀␀␀␀␀␀Ÿ@ìzìzr(‰␀Æÿ␀␀ÿ␀␀Ã„␀␀␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀␀␀	␀É/␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀˜Ø␀␀…¬␀␀´␀	„␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	„␀␀␀␀␀␀␀Ü␀t␀Ü␀n-‰␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	„␀␀␀␀␀␀␀.%0.0.w$‰␀Æÿ␀␀…Ó␀␀␀ŸDÑ␀	„␀␀␀␀␀␀␀oInInIqC␀êÿ␀␀ÿ␀+␀s„␀␀␀␀␀␀␀±␀t␀t␀n.‰␀Æÿ␀␀ÿ␀sw´␀„␀␀␀␀␀␀␀ @ìzìzr(‰␀Æÿ␀␀fÎ␀␀␀ï␀␀·␀„␀␀␀␀␀␀␀˜”␀␀•”␀␀•”␀␀ì*␀)‰␀Æÿ␀␀ÿ␀o·␀„␀␀␀␀␀␀␀„n€n€nì*␀'‰␀Æÿ␀␀ÿ␀Ê␀␀·␀„␀␀␀␀␀␀␀Ë␀␀GË␀␀Ë␀␀ì*␀+‰␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3␀␀e7␀␀␀␀␀␀␀␀␀™Ø␀␀…¬␀␀´␀	␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀$0.0.w␀Æÿ␀␀…Ó␀␀␀EÑ␀	␀␀␀␀␀␀oG]G]GqC␀êÿ␀␀ÿ␀¤w·␀	␀␀␀␀␀␀kxdxdxì*␀␀Æÿ␀␀ÿ␀w·␀␀␀␀␀␀␀Cx<x<xì*␀␀Æÿ␀␀ÿ␀åDÑ␀␀␀␀␀␀␀öFÔFÔFqC␀êÿ␀␀ÿ␀Ìa´␀␀␀␀␀␀␀ª<•awbr␀Æÿ␀␀Ò␀␀␀=␀t␀␀␀␀␀␀i␀§␀§␀n␀Æÿ␀␀ˆÓ␀␀␀:$Ì␀␀␀␀␀␀␀%$†$w␀Æÿ␀␀…Ó␀␀␀×-‹␀␀␀␀␀␀␀¡Am␀m␀—)␀␀Æÿ␀␀ÿ␀␀Ã␀␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀3␀·␀␀␀␀␀␀␀W␀␀G␀ì*␀␀Æÿ␀␀ÿ␀;␀·␀␀␀␀␀␀␀Y␀␀I␀ì*␀␀Æÿ␀␀ÿ␀4␀·␀␀␀␀␀␀␀X␀␀H␀ì*␀␀Æÿ␀␀ÿ␀5␀·␀␀␀␀␀␀␀Z␀ ␀J␀ì*␀␀Æÿ␀␀ÿ␀³␀␀)␀␀␀␀␀␀H´␀␀ñ³␀␀ñ³␀␀␀␀ÿ␀␀ÿ␀␀␀␀	0;1;2;3;4 Ø␀␀	SENIOR;0Q␀␀TRIGGER R064EXT_SI AFTER INSERT ON R064EXT

DECLARE
/* CURSOR c/ os registros gravados no R064EXT_AUX */
  CURSOR c_r064ext_ins IS SELECT NUMEMP,TIPCOL,NUMCAD FROM R064EXT_AUX;
  TYPE t_r064ext_aux IS RECORD(
    NUMEMP   R064EXT_AUX.NUMEMP%TYPE,
    TIPCOL   R064EXT_AUX.TIPCOL%TYPE,
    NUMCAD   R064EXT_AUX.NUMCAD%TYPE);
  l_r064ext_aux t_r064ext_aux;

BEGIN
   /* Le Registro do CURSOR */
   FOREACH c_r064ext_ins INTO  l_r064ext_aux.NUMEMP,
                               l_r064ext_aux.TIPCOL,
                               l_r064ext_aux.NUMCAD
   LOOP
     R064EXT_FH(l_r064ext_aux.NUMEMP, l_r064ext_aux.TIPCOL, l_r064ext_aux.NUMCAD);
   END LOOP;
   /* Apaga Registro OLD em R064EXT_AUX */
   BEGIN
     DELETE FROM R064EXT_AUX;
     DROP_TEMP_TABLE R064EXT_AUX;
   EXCEPTION WHEN OTHERS THEN
     NULL;
   END;
END␀œØ␀␀		SENIOR;0Y␀␀

TRIGGER R064EXT_EI AFTER INSERT ON R064EXT FOR EACH ROW

DECLARE
  l_online     BOOLEAN;
  l_datatu     DATE;
  l_DataZero   DATE;
  l_data_fim   DATE;
  l_datant     DATE;
  l_idtpes     CHAR(23);
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R064EXT_AUX;
  
BEGIN
  l_datatu := CURDATE();
  l_datant := DATETimeAdd(DD,-1,l_datatu);
  
  /* consiste se periodo da extra esta na semana. */
  IF  ((DATETIMEADD(DD,-6,:NEW.DATINI) <= l_datatu) AND (:NEW.DATFIM >= l_datatu)) 
       OR 
       ((:NEW.DATINI = l_datant) AND (:NEW.DATFIM = l_datant) AND (:NEW.HORINI > :NEW.HORFIM)) THEN
     SP_VerOnLine(l_online OUT);
     IF   (l_online = TRUE) THEN
          BEGIN
          /* salva Registro  */
            INSERT INTO R064EXT_AUX (NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI)
                        VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI);
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro no INSERT em R064EXT_AUX.';
          END;
     END IF;
  END IF;

  l_DataZero := '31/12/1900,00:00:00';
  l_data_fim := :NEW.DATFIM;
  
  IF (l_data_fim = l_DataZero) THEN
     l_data_fim := '04/06/2080,00:00:00';
  END IF;

  BEGIN
      UPDATE R066APU SET DIAALT = 5
      WHERE NUMEMP = :NEW.NUMEMP AND
            TIPCOL = :NEW.TIPCOL AND
            NUMCAD = :NEW.NUMCAD AND
            DATAPU >= :NEW.DATINI AND
            DATAPU <= l_data_fim;
  EXCEPTION WHEN OTHERS THEN
      NULL;
  END;
  
  SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
  SP_SAM_PENDENCIES(42, 2, l_idtpes);
END␀¡Ø␀␀	SENIOR;0U␀␀

TRIGGER R064EXT_SU AFTER UPDATE ON R064EXT

DECLARE
/* CURSOR c/ os registros gravados no R064EXT_AUX */
  CURSOR c_r064ext_upd IS SELECT NUMEMP,TIPCOL,NUMCAD FROM R064EXT_AUX;
  TYPE t_r064ext_aux IS RECORD(
    NUMEMP   R064EXT_AUX.NUMEMP%TYPE,
    TIPCOL   R064EXT_AUX.TIPCOL%TYPE,
    NUMCAD   R064EXT_AUX.NUMCAD%TYPE);
  l_r064ext_aux t_r064ext_aux;

BEGIN
   /* Le Registro do CURSOR */
   FOREACH c_r064ext_upd INTO  l_r064ext_aux.NUMEMP,
                               l_r064ext_aux.TIPCOL,
                               l_r064ext_aux.NUMCAD
   LOOP
     R064EXT_FH(l_r064ext_aux.NUMEMP, l_r064ext_aux.TIPCOL, l_r064ext_aux.NUMCAD);
   END LOOP;
   /* Apaga Registro OLD em R064EXT_AUX */
   BEGIN
     DELETE FROM R064EXT_AUX;
     DROP_TEMP_TABLE R064EXT_AUX;
   EXCEPTION WHEN OTHERS THEN
     NULL;
   END;
END␀Ø␀␀		SENIOR;0Ö␀␀

TRIGGER R064EXT_EU AFTER UPDATE ON R064EXT FOR EACH ROW

DECLARE
  l_online     BOOLEAN;
  l_datatu     DATE;
  l_DataZero   DATE;
  l_data_fim   DATE;
  l_idtpes     CHAR(23);
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R064EXT_AUX;
  
BEGIN
  l_datatu := CURDATE();

  /* consiste se periodo da extra esta na semana. */
  IF (DATETIMEADD(DD,-6,:NEW.DATINI) <= l_datatu) AND (:NEW.DATFIM >= l_datatu) THEN
     SP_VerOnLine(l_online OUT);
     IF   (l_online = TRUE) THEN
         BEGIN
         /* salva Registro  */
           INSERT INTO R064EXT_AUX (NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI)
                       VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI);
         EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'Erro no INSERT em R064EXT_AUX.';
         END;
     END IF;
  END IF;

  /* Na Alteração do Registro seta todo o periodo como alterado */
  /* Também verifica a Data Final                               */
  l_DataZero := '31/12/1900,00:00:00';
  IF ((:OLD.DATFIM = l_DataZero) OR (:NEW.DATFIM = l_DataZero)) THEN
     l_data_fim := '04/06/2080,00:00:00';
  ELSIF (:NEW.DATFIM > :OLD.DATFIM) THEN
     l_data_fim := :NEW.DATFIM;
  ELSE l_data_fim := :OLD.DATFIM;
  END IF;

  /* Verifica se foi alterado algum campo que infuencia na apuração. Campo status nao influencia. */
  IF (:NEW.HORFIM <> :OLD.HORFIM) OR (:NEW.DATFIM <> :OLD.DATFIM) OR (:NEW.EMPAUT <> :OLD.EMPAUT) OR
     (:NEW.TCLAUT <> :OLD.TCLAUT) OR (:NEW.CADAUT <> :OLD.CADAUT) OR (:NEW.CODUSU <> :OLD.CODUSU) THEN
    BEGIN
    UPDATE R066APU SET DIAALT = 5
      WHERE NUMEMP = :NEW.NUMEMP AND
            TIPCOL = :NEW.TIPCOL AND
            NUMCAD = :NEW.NUMCAD AND
            DATAPU >= :NEW.DATINI AND
            DATAPU <= l_data_fim;
    EXCEPTION WHEN OTHERS THEN
      NULL;
    END;
  END IF;
  
  SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
  SP_SAM_PENDENCIES(42, 2, l_idtpes);
END␀ŸØ␀␀	SENIOR;0U␀␀

TRIGGER R064EXT_SD AFTER DELETE ON R064EXT

