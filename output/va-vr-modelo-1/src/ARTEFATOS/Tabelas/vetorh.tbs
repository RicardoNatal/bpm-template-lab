$␀␀PROCEDURE R038HFI_CON(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATALT DATE)
 IS

l_data_limite DATE;
BEGIN
  /* Valida Datas */
  RH_DATFIM (l_data_limite OUT);
  IF   p_datalt <= l_data_limite THEN
       SP_AtuHor (p_numemp, p_tipcol, p_numcad,'');
  END IF;
END␀îÔ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
À␀␀PROCEDURE R038HFI_MINDATALT(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATALT OUT DATE)
IS

	l_DataInicioHFI DATE;
BEGIN
	BEGIN
		SELECT
			MIN(DATALT)
		INTO
			l_DataInicioHFI
		FROM
			R038HFI
		WHERE
			R038HFI.NUMEMP = P_NUMEMP AND R038HFI.TIPCOL = P_TIPCOL AND R038HFI.NUMCAD = P_NUMCAD;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao retornar MIN(DATALT) da tabela R038HFI.';
	END;

	P_DATALT := l_DataInicioHFI;
END␀şÔ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
]␀␀/*-------------------------------- R038HLO ----------------------------*/
PROCEDURE R038HLO_HFI(P_TIPCOL NUMBER(1),P_NUMEMP NUMBER(4),P_NUMCAD NUMBER(9),P_DATALT DATE,P_TABORG NUMBER(4),P_NUMLOC NUMBER(9))
 IS

l_datloc       DATE;
  l_comando_nulo BOOLEAN;
BEGIN
  BEGIN
    SELECT R034FUN.DATLOC INTO l_datloc
     FROM R034FUN
     WHERE R034FUN.TIPCOL = p_tipcol AND
           R034FUN.NUMEMP = p_numemp AND
           R034FUN.NUMCAD = p_numcad;
  EXCEPTION WHEN OTHERS THEN
    l_comando_nulo:=TRUE;
  END;
  IF   (p_datalt >= l_datloc)
  OR   (l_datloc IS NULL) THEN
       UPDATE R034FUN
          SET NUMLOC = p_numloc,
              TABORG = p_taborg,
              DATLOC = p_datalt
        WHERE R034FUN.TIPCOL = p_tipcol AND
              R034FUN.NUMEMP = p_numemp AND
              R034FUN.NUMCAD = p_numcad;
  END IF;
END␀\Õ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE R038PEN_COLCHEFE(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATTRF DATE,P_COLCHE OUT BOOLEAN,P_COLUSU OUT BOOLEAN)
 IS

l_ConChe   NUMBER;
  l_ConUsu   NUMBER;
  l_DataZero DATE;
BEGIN
  l_DataZero := '31/12/1900,00:00:00';
  
  /* Verifica se o colaborador está associado ao cadastro de chefia */
  BEGIN
    SELECT COUNT(*) INTO l_ConChe
      FROM R080SUB
     WHERE (R080SUB.EMPCHE = p_NumEmp
       AND  R080SUB.TIPCHE = p_TipCol
       AND  R080SUB.CADCHE = p_NumCad)
       OR  (R080SUB.EMPSCH = p_NumEmp
       AND  R080SUB.TIPSCH = p_TipCol
       AND  R080SUB.CADSCH = p_NumCad)
       OR  (R080SUB.EMPSUB = p_NumEmp
       AND  R080SUB.TIPSUB = p_TipCol
       AND  R080SUB.CADSUB = p_NumCad)
       AND  R080SUB.DATALT <= p_DatTrf
       AND  (R080SUB.DATFIM >= p_DatTrf OR R080SUB.DATFIM = l_DataZero);
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_ConChe := 0;
  END;

  p_ColChe := FALSE;
  IF (l_ConChe > 0) THEN
    p_ColChe := TRUE;
  END IF;

  /* Verifica se o colaborador está associado com algum usuário */
  BEGIN
    SELECT COUNT(*) INTO l_ConUsu
      FROM R034USU
     WHERE R034USU.NUMEMP = p_NumEmp AND
           R034USU.TIPCOL = p_TipCol AND
           R034USU.NUMCAD = p_NumCad;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_ConUsu := 0;
  END;

  p_ColUsu := FALSE;
  IF (l_ConUsu > 0) THEN
    p_ColUsu := TRUE;
  END IF;
END␀^Õ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
)
␀␀PROCEDURE R038PEN_DELPEN(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATTRF DATE)
 IS

l_ContNaoAtend NUMBER;
  l_ContPenFut   NUMBER;
BEGIN
  BEGIN
       SELECT COUNT(*) INTO l_ContNaoAtend
         FROM R038PEN
        WHERE R038PEN.NUMEMP = p_NumEmp AND
              R038PEN.TIPCOL = p_TipCol AND
              R038PEN.NUMCAD = p_NumCad AND
              R038PEN.DATTRF = p_DatTrf AND
              ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
               (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));
  EXCEPTION
       WHEN NO_DATA_FOUND THEN
            l_ContNaoAtend := 0;
  END;

  /* Se não foi atendida então exclui */
  IF (l_ContNaoAtend <> 0) THEN
    BEGIN
      DELETE FROM R038USU
        WHERE R038USU.NUMEMP = p_NumEmp AND
              R038USU.TIPCOL = p_TipCol AND
              R038USU.NUMCAD = p_NumCad AND
              R038USU.DATTRF = p_DatTrf;

      DELETE FROM R038ABR
        WHERE R038ABR.NUMEMP = p_NumEmp AND
              R038ABR.TIPCOL = p_TipCol AND
              R038ABR.NUMCAD = p_NumCad AND
              R038ABR.DATTRF = p_DatTrf;

      DELETE FROM R038GRP
        WHERE R038GRP.NUMEMP = p_NumEmp AND
              R038GRP.TIPCOL = p_TipCol AND
              R038GRP.NUMCAD = p_NumCad AND
              R038GRP.DATTRF = p_DatTrf;

      DELETE FROM R038PEN
        WHERE R038PEN.NUMEMP = p_NumEmp AND
              R038PEN.TIPCOL = p_TipCol AND
              R038PEN.NUMCAD = p_NumCad AND
              R038PEN.DATTRF = p_DatTrf;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao deletar pendência da Tabela R038PEN.';
    END;

  ELSE
    /* Verifica se tem pendência futura */
    BEGIN
         SELECT COUNT(*) INTO l_ContPenFut
           FROM R038PEN
          WHERE R038PEN.NUMEMP = p_NumEmp AND
                R038PEN.TIPCOL = p_TipCol AND
                R038PEN.NUMCAD = p_NumCad AND
                R038PEN.DATTRF > p_DatTrf;
    EXCEPTION
         WHEN NO_DATA_FOUND THEN
              l_ContNaoAtend := 0;
    END;

    /* Caso tenha sido atendida e não tem pendência futura, seta como "Necessidade de Revisão" */
    IF (l_ContNaoAtend = 0) THEN
      BEGIN
        UPDATE R038PEN SET NESREV = 'S'
                 WHERE R038PEN.NUMEMP = p_NumEmp AND
                       R038PEN.TIPCOL = p_TipCol AND
                       R038PEN.NUMCAD = p_NumCad AND
                       R038PEN.DATTRF = p_DatTrf;
      EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro no update da Tabela R038PEN.';
      END;
    END IF;
  END IF;
END␀_Õ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
3␀␀PROCEDURE R038PEN_DELPENPAS(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATTRF DATE)
 IS

l_ContNaoAtend NUMBER;
  l_ContPenFut   NUMBER;

  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;

  CURSOR c_r038pen_del IS SELECT NUMEMP,TIPCOL,NUMCAD,DATTRF
                            FROM R038PEN
                           WHERE R038PEN.NUMEMP = p_NumEmp
                             AND R038PEN.TIPCOL = p_TipCol
                             AND R038PEN.NUMCAD = p_NumCad
                             AND R038PEN.DATTRF < p_DatTrf
                             AND ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
                                  (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));

BEGIN
  FOREACH c_r038pen_del INTO l_NumEmp,l_TipCol,l_NumCad,l_DatTrf
  LOOP
    BEGIN
      DELETE FROM R038USU
        WHERE R038USU.NUMEMP = l_NumEmp AND
              R038USU.TIPCOL = l_TipCol AND
              R038USU.NUMCAD = l_NumCad AND
              R038USU.DATTRF = l_DatTrf;

      DELETE FROM R038ABR
        WHERE R038ABR.NUMEMP = l_NumEmp AND
              R038ABR.TIPCOL = l_TipCol AND
              R038ABR.NUMCAD = l_NumCad AND
              R038ABR.DATTRF = l_DatTrf;

      DELETE FROM R038GRP
        WHERE R038GRP.NUMEMP = l_NumEmp AND
              R038GRP.TIPCOL = l_TipCol AND
              R038GRP.NUMCAD = l_NumCad AND
              R038GRP.DATTRF = l_DatTrf;

    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao deletar pendência das Tabelas filhas da R038PEN.';
    END;
  END LOOP;

  BEGIN
    DELETE FROM R038PEN
      WHERE R038PEN.NUMEMP = p_NumEmp
        AND R038PEN.TIPCOL = p_TipCol
        AND R038PEN.NUMCAD = p_NumCad
        AND R038PEN.DATTRF < p_DatTrf
        AND ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
            (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao deletar pendência da Tabela R038PEN.';
  END;
END␀`Õ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
D␀␀PROCEDURE R038PEN_TEMPENFUT(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATTRF DATE,P_TEMPENFUT OUT BOOLEAN)
 IS

l_TemPenFut NUMBER;
BEGIN
  BEGIN
      SELECT COUNT(*) INTO l_TemPenFut
        FROM R038PEN
       WHERE R038PEN.NUMEMP = p_NumEmp AND
             R038PEN.TIPCOL = p_TipCol AND
             R038PEN.NUMCAD = p_NumCad AND
             R038PEN.DATTRF > p_DatTrf;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_TemPenFut := 0;
  END;

  p_TemPenFut := FALSE;
  IF (l_TemPenFut <> 0) THEN
    p_TemPenFut := TRUE;
  END IF;
END␀gÕ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
