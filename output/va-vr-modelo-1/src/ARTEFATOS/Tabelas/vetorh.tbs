          END IF;
      END IF;
  END IF;
END␀øø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_GRA004TMP
k␀␀PROCEDURE SP_UNEFAI(P_DATINI DATE,P_DATFIM DATE,P_TIPFAI CHAR,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10), P_ALTERADO OUT BOOLEAN)
 IS

l_data          DATE;
  l_data_limite   DATE;
  l_faiIni        NUMBER(4);
  l_faiFim        NUMBER(4);
  l_faiAnt        NUMBER(4);
  l_TurTrb        NUMBER;
  l_tipFai        CHAR;
  l_straux        VARCHAR2(255);
  l_count         NUMBER;
  l_total         NUMBER;

  /* CURSOR DA TABELA TEMPORARIA */
  CURSOR c_r004TMP IS
  SELECT FAIINI,FAIFIM,TURTRB FROM R004TMP WHERE DATHOR = l_data AND TIPFAI = l_TipFai AND NUMEMP = p_numemp AND
         TIPCOL = p_tipcol AND NUMCAD = p_numcad ORDER BY 1,2;
  TYPE t_r004TMP IS RECORD(
    FAIINI   R004TMP.FAIINI%TYPE,
    FAIFIM   R004TMP.FAIFIM%TYPE,
    TURTRB   R004TMP.TURTRB%TYPE);
  l_r004TMP t_r004TMP;

  CURSOR c_r004TMP_1 IS
  SELECT FAIINI,FAIFIM,TURTRB FROM R004TMP WHERE DATHOR = l_data AND TIPFAI = l_TipFai AND
         FAIINI > l_faiini AND FAIINI <= l_faifim AND NUMEMP = p_numemp AND TIPCOL = p_tipcol AND
         NUMCAD = p_numcad ORDER BY 1,2;
  TYPE t_r004TMP_1 IS RECORD(
    FAIINI   R004TMP.FAIINI%TYPE,
    FAIFIM   R004TMP.FAIFIM%TYPE,
    TURTRB   R004TMP.TURTRB%TYPE);
  l_r004TMP_1 t_r004TMP_1;

BEGIN
    l_data        := p_datIni;
    l_data_limite := p_datfim;
    l_tipFai      := p_tipFai;
    l_faiIni      := 0;
    l_faiFim      := 0;
    l_TurTrb      := 0;
    p_alterado    := FALSE;

    LOOP
        FOREACH c_r004TMP INTO l_r004TMP.FaiIni,
                               l_r004TMP.FaiFim,
                               l_r004TMP.TurTrb

        LOOP
            l_faiIni := l_r004TMP.FaiIni;
            l_faiFim := l_r004TMP.FaiFim;
            l_TurTrb := l_r004TMP.TurTrb;

            FOREACH c_r004TMP_1 INTO l_r004TMP_1.FaiIni,
                                     l_r004TMP_1.FaiFim,
                                     l_r004TMP_1.TurTrb
            LOOP
                /* compara se há sobreposição de faixas */
                IF  (l_r004TMP_1.FaiIni <= l_FaiFim) THEN

                    /* o terceiro turno prevalece sobre o turno*/
                    IF  (l_r004TMP_1.TurTrb = 3) THEN
                        l_TurTrb := l_r004TMP_1.TurTrb;
                    END IF;

                    /* verifica qual a maior faixa final */
                    IF  (l_faifim < l_r004TMP_1.faifim) THEN
                        l_faifim := l_r004TMP_1.faifim;
                    END IF;

                    /* atualiza o campo informando qual registro não será considerado para montar a faixa */
                    UPDATE R004TMP SET TURTRB = 2 WHERE DATHOR = l_data AND TIPFAI = l_tipFai AND
                           NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND 
                           ((FAIINI = l_FaiIni AND FAIFIM < l_faifim) OR
                           (FAIINI >= l_FaiIni AND ((FAIFIM < l_faifim) OR (FAIFIM = l_faifim))));

                    /* cria a nova faixa */
                    SP_GRA004TMP(l_data, l_tipFai, l_faiini, l_faifim,l_turtrb,p_numemp,p_tipcol,p_numcad);
                    
                    p_alterado := TRUE;
                END IF;
            END LOOP;
        END LOOP;

        /* para sair do LOOP */
        IF  (l_data > l_data_limite) THEN
            EXIT;
        END IF;
        l_data := DATETimeAdd(DD,1,l_data);

    END LOOP;

    /* exclui as linhas que não vão ser geradas */
    BEGIN
        DELETE FROM R004TMP WHERE TURTRB = 2 AND NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
    EXCEPTION
        WHEN OTHERS THEN NULL;        
    END;
END␀ùø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
’PROCEDURE SP_UNEPRO(P_DATINI DATE,P_DATFIM DATE,P_TIPFAI CHAR,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10))
 IS
BEGIN
  NULL;
END		SENIOR;20SP_GRA004TMP
¦␀␀


PROCEDURE SP_UNEPRO(P_DATINI DATE,P_DATFIM DATE,P_TIPFAI CHAR,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10))
 IS

l_data          DATE;
  l_data_limite   DATE;
  l_faiIni        NUMBER(4);
  l_faiFim        NUMBER(4);
  l_faiAnt        NUMBER(4);
  l_TurTrb        NUMBER;
  l_tipFai        CHAR;
  l_straux        VARCHAR2(255);
  l_count         NUMBER(2);
  l_iteracao      NUMBER(2);
  l_total         NUMBER;

  /* CURSOR DA TABELA TEMPORARIA */
  CURSOR c_r004TMP IS
  SELECT FAIINI,FAIFIM,TURTRB FROM R004TMP WHERE DATHOR = l_data AND TIPFAI = l_TipFai AND NUMEMP = p_numemp AND
         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND TURTRB <> 2 ORDER BY 1,2;
  TYPE t_r004TMP IS RECORD(
    FAIINI   R004TMP.FAIINI%TYPE,
    FAIFIM   R004TMP.FAIFIM%TYPE,
    TURTRB   R004TMP.TURTRB%TYPE);
  l_r004TMP t_r004TMP;

  CURSOR c_r004TMP_1 IS
  SELECT FAIINI,FAIFIM,TURTRB FROM R004TMP WHERE DATHOR = l_data AND TIPFAI = l_TipFai AND
         FAIINI >= l_faiini AND FAIINI <= l_faifim AND NUMEMP = p_numemp AND TIPCOL = p_tipcol AND
         NUMCAD = p_numcad AND TURTRB <> 2 ORDER BY 1,2;
  TYPE t_r004TMP_1 IS RECORD(
    FAIINI   R004TMP.FAIINI%TYPE,
    FAIFIM   R004TMP.FAIFIM%TYPE,
    TURTRB   R004TMP.TURTRB%TYPE);
  l_r004TMP_1 t_r004TMP_1;

BEGIN
    l_data        := p_datIni;
    l_data_limite := p_datfim;
    l_tipFai      := p_tipFai;
    l_faiIni      := 0;
    l_faiFim      := 0;
    l_TurTrb      := 0;
    LOOP
        /*Obtem a quantidade de Interações par unificar as faixas*/
        SELECT COUNT(*) QTD INTO l_iteracao
        FROM R004TMP
        WHERE DATHOR = l_data AND TIPFAI = l_TipFai AND NUMEMP = p_numemp AND
              TIPCOL = p_tipcol AND NUMCAD = p_numcad;

        /*Inicializações*/
        l_count := 1;
        IF (l_iteracao > 1) THEN
            /*Diminui 1 registro da iteração. Por exemplo se possuir 2 registros, apenas será necessário uma
            Unificação na pior da hipóteses, e assim sucessivamente*/
            l_iteracao := l_iteracao -1;
            LOOP
                FOREACH c_r004TMP INTO l_r004TMP.FaiIni, l_r004TMP.FaiFim, l_r004TMP.TurTrb LOOP
                    l_faiIni := l_r004TMP.FaiIni;
                    l_faiFim := l_r004TMP.FaiFim;
                    l_TurTrb := l_r004TMP.TurTrb;

                    FOREACH c_r004TMP_1 INTO l_r004TMP_1.FaiIni, l_r004TMP_1.FaiFim, l_r004TMP_1.TurTrb LOOP
                        /* compara se há sobreposição de faixas */
                        IF  (l_r004TMP_1.FaiIni <= l_FaiFim) THEN

                            /* o terceiro turno prevalece sobre o turno*/
                            IF  (l_r004TMP_1.TurTrb = 3) THEN
                                l_TurTrb := l_r004TMP_1.TurTrb;
                            END IF;

                            /* verifica qual a maior faixa final */
                            IF  (l_faifim < l_r004TMP_1.faifim) THEN
                                l_faifim := l_r004TMP_1.faifim;
                            END IF;

                            /* atualiza o campo informando qual registro não será considerado para montar a faixa */
                            UPDATE R004TMP SET TURTRB = 2 WHERE DATHOR = l_data AND TIPFAI = l_tipFai AND
                                   NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                                   (FAIINI >= l_FaiIni AND FAIFIM <= l_faifim);

                            /* cria a nova faixa */
                            SP_GRA004TMP(l_data, l_tipFai, l_faiini, l_faifim,l_turtrb,p_numemp,p_tipcol,p_numcad);
                        END IF;
                    END LOOP;
                END LOOP;

                /* exclui as linhas que não vão ser geradas */
                BEGIN
                    DELETE FROM R004TMP WHERE TURTRB = 2 AND NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
                EXCEPTION
                    WHEN OTHERS THEN NULL;
                END;

                /*Verifica se atingiu a quantidade de iteração, caso afirmativo, unifica o próximo dia*/
                IF (l_count >= l_iteracao) THEN
                    EXIT;
                ELSE
                    l_count := l_count + 1;
                END IF;   
            END LOOP;
        END IF;

        l_data := DATETimeAdd(DD,1,l_data);
        IF  (l_data > l_data_limite) THEN
            EXIT;
        END IF;
    END LOOP;
END		SENIOR;21SP_GRA004TMP
¦␀␀


PROCEDURE SP_UNEPRO(P_DATINI DATE,P_DATFIM DATE,P_TIPFAI CHAR,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10))
