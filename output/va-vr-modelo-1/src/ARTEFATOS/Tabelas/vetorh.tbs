BEGIN
RH_250ALT(18);
END␀4Ï␀␀		SENIOR;0Ì␀␀

/* INSERT (NEW) */
TRIGGER R008SIT_EI AFTER INSERT ON R008SIT FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Eventos - Situações Inválidas (Tabela: R008SIT)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 108;     /* Eventos - Situações Inválidas (Tabela: R008SIT)*/
  l_codtpa := 363;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008SIT_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAB', CONVERT(NUMBER_TO_CHAR, :NEW.CODTAB));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CODEVE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSIT', CONVERT(NUMBER_TO_CHAR, :NEW.CODSIT));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R008SIT_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      
      BEGIN
	  	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
	  END;
  END IF; 
END␀8Ï␀␀	SENIOR;0L

TRIGGER R008SIT_SU AFTER UPDATE ON R008SIT

BEGIN
RH_250ALT(18);
END␀5Ï␀␀		SENIOR;0Ú␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R008SIT_EU AFTER UPDATE ON R008SIT FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Eventos - Situações Inválidas (Tabela: R008SIT)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 108;     /* Eventos - Situações Inválidas (Tabela: R008SIT)*/
  l_codtpa := 364;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.CodTab <> :NEW.CodTab)
   OR (:OLD.CodEve <> :NEW.CodEve)
   OR (:OLD.CodSit <> :NEW.CodSit)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008SIT_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAB', CONVERT(NUMBER_TO_CHAR, :OLD.CODTAB));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :OLD.CODEVE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSIT', CONVERT(NUMBER_TO_CHAR, :OLD.CODSIT));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R008SIT_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
    END IF; 
  END IF; 
END␀6Ï␀␀	SENIOR;0L

TRIGGER R008SIT_SD AFTER DELETE ON R008SIT

BEGIN
RH_250ALT(18);
END␀3Ï␀␀		SENIOR;0Í␀␀ 

