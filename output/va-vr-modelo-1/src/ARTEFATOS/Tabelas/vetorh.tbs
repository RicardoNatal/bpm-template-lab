cK␀␀CREATE  PROCEDURE sp_porcom(@p_Straux VARCHAR(2047), @p_CenPen VARCHAR(255)) AS
BEGIN
DECLARE @l_retpen CHAR(3)
DECLARE @l_datenv DATETIME
DECLARE @l_datenv_str CHAR(16)
DECLARE @l_horenv SMALLINT
DECLARE @l_numfis BIGINT
DECLARE @l_codcmd SMALLINT
DECLARE @l_CodTraduzido SMALLINT
DECLARE @l_stacmd SMALLINT
DECLARE @l_seqenv SMALLINT
DECLARE @l_numcra BIGINT
DECLARE @l_idtpes VARCHAR(23)
DECLARE @l_cenpen VARCHAR(255)
DECLARE @l_codcen SMALLINT
DECLARE @l_dirsvr VARCHAR(250)
DECLARE @l_gersen CHAR(1)
DECLARE @l_cenati CHAR(1)
DECLARE @l_stacsm SMALLINT
DECLARE @l_porcom VARCHAR(16)
DECLARE @l_aux SMALLINT
DECLARE @l_coddsp INTEGER
DECLARE @l_tipope SMALLINT
DECLARE @l_dat_conv VARCHAR(25)
DECLARE @l_logpen VARCHAR(2047)
DECLARE @l_straux VARCHAR(2047)
DECLARE @l_r058cen_DIRSVR VARCHAR(250)
DECLARE @l_r058cen_GERSEN VARCHAR(1)
DECLARE @l_r058cen_CENATI VARCHAR(1)
DECLARE @l_r058cen_STACSM SMALLINT
DECLARE @l_r058cen_CODCEN SMALLINT
DECLARE @l_codcmd_str CHAR(3)
DECLARE @l_SubCmd INTEGER
DECLARE @temrlg INTEGER

  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @SE_EXC2 INTEGER
  DECLARE @SE_EXC4 INTEGER
  DECLARE @NULL_VAR INTEGER
  DECLARE @SE_EXC3 INTEGER
  DECLARE @SE_EXC6 INTEGER
  DECLARE @SE_EXC7 INTEGER
  DECLARE @SE_EXC9 INTEGER
  DECLARE @SE_EXC8 INTEGER
  SELECT @ChkError = 0
  SELECT @l_datenv = CONVERT(DATETIME,CONVERT(DATE,GETDATE()))
  SELECT @l_horenv = DATEPART(HOUR,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))*60+DATEPART(MINUTE,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))
  SELECT @l_seqenv = DATEPART(ss,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))
  SELECT @l_idtpes = '                       '
  SELECT @l_numcra = 0
  SELECT @l_numfis = 0
  SELECT @l_stacmd = 1
  SELECT @l_retpen = '001'
  SELECT @l_tipope = 0
  /* BEGIN EXCEPTION HANDLER */
    EXC1:
    SELECT @SE_EXC1 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        BEGIN
          RAISERROR('SP_PORCOM: 1. Problemas ao obter a versão do sistema',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
    
  /* BEGIN EXCEPTION HANDLER */
    EXC2:
    SELECT @SE_EXC2 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        BEGIN
          RAISERROR('SP_PORCOM: 2. Problemas ao obter a versão do sistema',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
  /* TRY */
    SELECT @l_codcmd = SUBSTRING(@p_Straux,1,2)
    
    IF (@l_codcmd=62)
    BEGIN
      EXECUTE @ChkError = SP_PORCOMDSP @p_Straux, @p_CenPen   
      GOTO FIM
    END
    
    IF (@l_codcmd=99)
    BEGIN
      SELECT @l_SubCmd = SUBSTRING(@p_Straux,3,5)
    END

    EXECUTE @ChkError = SP_TRADUZIRCODCMD @l_CodCmd, @l_SubCmd, @l_CodTraduzido OUTPUT
    
    IF ((@l_codcmd=2) 
      OR (@l_codcmd=5) 
      OR (@l_codcmd=9) 
      OR (@l_codcmd=13) 
      OR (@l_codcmd=21) 
      OR (@l_codcmd=38) 
      OR (@l_codcmd=83))
    BEGIN
      SELECT @l_numfis = SUBSTRING(@p_Straux,19,12)
      IF (@l_codcmd=21)
      BEGIN
        SELECT @l_numcra = SUBSTRING(@p_Straux,69,12)
      END
      IF (@l_codcmd=38)
      BEGIN
        SELECT @l_numfis = SUBSTRING(@p_Straux,22,12)
      END
      IF (@l_codcmd=83)
      BEGIN
        SELECT @l_numcra = SUBSTRING(@p_Straux,19,12)
        SELECT @l_numfis = 0
      END
    END
    ELSE
    BEGIN
      IF ((@l_codcmd=1) 
      OR (@l_codcmd=3) 
      OR (@l_codcmd=4) 
      OR (@l_codcmd=8) 
      OR (@l_codcmd=19) 
      OR (@l_codcmd=22) 
      OR (@l_codcmd=23) 
      OR (@l_codcmd=24) 
      OR (@l_codcmd=25) 
      OR (@l_codcmd=26) 
      OR (@l_codcmd=27) 
      OR (@l_codcmd=60) 
      OR (@l_codcmd=63) 
      OR (@l_codcmd=82)
      OR (@l_codcmd=93)      
      OR (@l_codcmd=95)
      OR (@l_codcmd=96))
      BEGIN
        SELECT @l_idtpes = SUBSTRING(@p_Straux,19,23)
      END
      ELSE
      BEGIN
        IF (@l_codcmd=12)
        BEGIN
          SELECT @l_idtpes = SUBSTRING(@p_Straux,20,23)
        END
        ELSE
        BEGIN
          IF (@l_codcmd=62)
          BEGIN
            SELECT @l_idtpes = SUBSTRING(@p_Straux,42,23)
            SELECT @l_numfis = SUBSTRING(@p_Straux,29,12)
            SELECT @l_tipope = SUBSTRING(@p_Straux,28,1)
            SELECT @l_datenv_str = SUBSTRING(@p_Straux,3,16)
            SELECT @l_dat_conv = SUBSTRING(@l_datenv_str,1,2)+'/'+SUBSTRING(@l_datenv_str,3,2)+'/'+SUBSTRING(@l_datenv_str,5,2)
            EXECUTE  @ChkError = SP_STRTODATE @l_dat_conv,'DD/MM/AA',@l_datenv OUTPUT  
            IF @ChkError <> 0
            BEGIN
              GOTO EXC3
            END
            SELECT @l_horenv = CONVERT(NUMERIC,(SUBSTRING(@l_datenv_str,7,2)))*60+CONVERT(NUMERIC,(SUBSTRING(@l_datenv_str,9,2)))
          END
          ELSE
          BEGIN
            IF (@l_codcmd=75)
            BEGIN
              SELECT @l_idtpes = SUBSTRING(@p_Straux,20,23)
              SELECT @l_numfis = SUBSTRING(@p_Straux,44,12)
            END
            ELSE
            BEGIN
              IF (@l_codcmd=6)
              BEGIN
                SELECT @l_idtpes = SUBSTRING(@p_Straux,3,23)
                SELECT @l_tipope = SUBSTRING(@p_Straux,26,1)
              END
              ELSE
              BEGIN
                IF (@l_codcmd=79)
                BEGIN
                  SELECT @l_idtpes = SUBSTRING(@p_Straux,3,23)
                END
	            ELSE
	            BEGIN
	              IF (@l_codcmd=86)
	              BEGIN
	                SELECT @l_idtpes = SUBSTRING(@p_Straux,59,23)
	              END
	            END                
              END
            END
          END
        END
      END
    END
    IF (@l_codcmd=62)
    BEGIN
      /* TRY */
        UPDATE r070adm SET 
      stacmd=7 
       WHERE idtpes<>@l_idtpes 
      and numfis=@l_numfis 
      and numcra=@l_numcra 
      and stacmd in (0,1,5,8,9) 
      and codcmd = @l_CodTraduzido
        SELECT @ChkError = @@Error
        IF @ChkError <> 0
        BEGIN
          GOTO EXC4
        END
      /* END TRY */
      /* BEGIN EXCEPTION HANDLER */
        EXC4:
        SELECT @SE_EXC4 = @ChkError
        IF @ChkError <> 0
        BEGIN
          BEGIN
            SELECT @ChkError = 0
            SELECT @NULL_VAR = 1
          END
        END
      /* END EXCEPTION HANDLER */
    END
    IF (@l_codcmd=19)
      OR (@l_codcmd=93) 
      OR (@l_codcmd=1) 
      OR (@l_codcmd=3) 
      OR ((@l_codcmd=62) 
      AND (@l_tipope=1)) 
      OR ((@l_codcmd=6) 
      AND (@l_tipope>1))
    BEGIN
      IF (@l_seqenv>1)
      BEGIN
        SELECT @l_seqenv = @l_seqenv-2
      END
      ELSE
      BEGIN
        IF (@l_horenv>0)
        BEGIN
          SELECT @l_horenv = @l_horenv-1
          SELECT @l_seqenv = 59
        END
        ELSE
        BEGIN
          SELECT @l_datenv = DATEADD(DAY,-1,@l_datenv)
          SELECT @l_horenv = 1439
          SELECT @l_seqenv = 59
        END
      END
    END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC3:
    SELECT @SE_EXC3 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        BEGIN
          RAISERROR('SP_PorCom: Problemas ao Formatar a Pendência.',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
  SELECT @l_CenPen = @p_CenPen
  SELECT @l_CenPen = LTRIM(@l_CenPen)
  SELECT @l_CenPen = RTRIM(@l_CenPen)
  SELECT @l_straux = @p_Straux
  IF (@l_CenPen='0')
  BEGIN
    DECLARE c_r058cen CURSOR FOR SELECT 
      r058cen.dirsvr DIRSVR,r058cen.gersen GERSEN,r058cen.cenati CENATI, r058cen.stacsm STACSM, r058cen.codcen CODCEN
       FROM r058cen r058cen
       WHERE gersen='S' 
      and tipger=2
    OPEN c_r058cen
    FETCH NEXT FROM c_r058cen INTO @l_r058cen_dirsvr, @l_r058cen_gersen, @l_r058cen_cenati, @l_r058cen_stacsm, @l_r058cen_codcen
    WHILE  (@@FETCH_STATUS = 0)
    BEGIN
      SELECT @temrlg=COUNT(*) FROM r058rlg WHERE CODCEN  = @l_r058cen_codcen
      IF (@l_r058cen_gersen='S') and (@l_r058cen_cenati='S') and (@l_r058cen_stacsm=1) and (@temrlg > 0)
      BEGIN
        /* TRY */
          IF @l_codcmd 
      NOT  IN (11,12,30,31,32,76,91)
          BEGIN
            IF (@l_codcmd=62)
            BEGIN
              IF (@l_tipope<>3)
              BEGIN
                SELECT @l_CodDsp = SUBSTRING(@l_straux,19,9)
                UPDATE r070adm SET 
      stacmd=7 
       WHERE idtpes=@l_idtpes 
      and numfis=@l_numfis 
      and numcra=@l_numcra 
      and stacmd in (0,1,5,8,9) 
      and codcmd = @l_CodTraduzido 
      and dirsvr=@l_r058cen_dirsvr 
      and codadm in (select 
      r070onl.codadm codadm
       from r070onl r070onl
       where coddsp=@l_coddsp )
                SELECT @ChkError = @@Error
                IF @ChkError <> 0
                BEGIN
                  GOTO EXC6
                END
              END
              ELSE
              BEGIN
                SELECT @l_straux = SUBSTRING(@p_Straux,1,27)+'0'+SUBSTRING(@p_Straux,29,DATALENGTH(@p_Straux)-28)
              END
            END
            ELSE
            BEGIN
              IF (@l_codcmd=6)
              BEGIN
                UPDATE R070ADM SET STACMD=7 
                WHERE CODADM IN ( SELECT CODADM FROM R070ADM WITH (NOLOCK) WHERE
                                  IDTPES=@l_idtpes AND STACMD IN (0,1,5,8,9) AND 
                                  CODCMD = @l_CodTraduzido AND DIRSVR=@l_r058cen_dirsvr AND 
                                  SUBSTRING(VALSTR,27,3)=SUBSTRING(@l_straux,27,3) anD 
                                  SUBSTRING(VALSTR,30,7)=SUBSTRING(@l_straux,30,7)
                                )
                
                SELECT @ChkError = @@Error
                IF @ChkError <> 0
                BEGIN
                  GOTO EXC6
                END
              END
              ELSE
              BEGIN
                IF (@l_codcmd=78)
                BEGIN
                  UPDATE r070adm SET 
      stacmd=7 
       WHERE substring(valstr,4,3)=substring(@l_straux,4,3) 
      and substring(valstr,7,7)=substring(@l_straux,7,7) 
      and stacmd in (0,1,5,8,9) 
      and codcmd = @l_CodTraduzido 
      and dirsvr=@l_r058cen_dirsvr
                  SELECT @ChkError = @@Error
                  IF @ChkError <> 0
                  BEGIN
                    GOTO EXC6
                  END
                END
                ELSE
                BEGIN
                  UPDATE r070adm SET 
      stacmd=7 
       WHERE idtpes=@l_idtpes 
      and numfis=@l_numfis 
      and numcra=@l_numcra 
      and stacmd in (0,1,5,8,9) 
      and codcmd = @l_CodTraduzido 
      and dirsvr=@l_r058cen_dirsvr
                  SELECT @ChkError = @@Error
                  IF @ChkError <> 0
                  BEGIN
                    GOTO EXC6
                  END
                END
              END
            END
          END
          EXECUTE  @ChkError = SP_RETLOGPEN @l_logpen OUTPUT  
          IF @ChkError <> 0
          BEGIN
            GOTO EXC6
          END
          
          INSERT INTO r070adm
            (datenv,horenv,dirsvr,valstr,retpen,qtdten,cicatu,numfis,codcmd,stacmd,seqenv,numcra,idtpes,verron,logpen) 
          VALUES 
            (@l_datenv,@l_horenv,@l_r058cen_dirsvr,@l_straux,@l_retpen,0,0,@l_numfis,@l_CodTraduzido,@l_stacmd,@l_seqenv,@l_numcra,@l_idtpes,NULL,@l_logpen)
          SELECT @ChkError = @@Error
          IF @ChkError <> 0
          BEGIN
            GOTO EXC6
          END
        /* END TRY */
        /* BEGIN EXCEPTION HANDLER */
          EXC6:
          SELECT @SE_EXC6 = @ChkError
          IF @ChkError <> 0
          BEGIN
            BEGIN
              SELECT @ChkError = 0
              SELECT @NULL_VAR = 1
              BEGIN
                RAISERROR('SP_PorCom: Erro na inserção da pendência na R070ADM Insert 1.',11,1) WITH SETERROR
                SELECT @ChkError = -30
                GOTO FNc_r058cen5
              END
            END
          END
        /* END EXCEPTION HANDLER */
      END
      FETCH NEXT FROM c_r058cen INTO @l_r058cen_dirsvr, @l_r058cen_gersen, @l_r058cen_cenati, @l_r058cen_stacsm, @l_r058cen_codcen
    END
    FNc_r058cen5: /* FINALLY OPEN CURSOR */
    CLOSE c_r058cen
    DEALLOCATE c_r058cen
    IF @ChkError <> 0
      GOTO FIM
  END
  ELSE
  BEGIN
    WHILE 1=1
    BEGIN
      /* TRY */
        SELECT @l_aux = CHARINDEX(SUBSTRING(',',1,255),@l_cenpen)
        IF (@l_aux=0)
        BEGIN
          SELECT @l_codcen = @l_cenpen
          SELECT @l_cenpen = 'FIM'
        END
        ELSE
        BEGIN
          SELECT @l_codcen = SUBSTRING(@l_cenpen,1,1)
          SELECT @l_cenpen = SUBSTRING(@l_cenpen,(@l_aux+1),(DATALENGTH(@l_cenpen)))
        END
      /* END TRY */
      /* BEGIN EXCEPTION HANDLER */
        EXC7:
        SELECT @SE_EXC7 = @ChkError
        IF @ChkError <> 0
        BEGIN
          BEGIN
            SELECT @ChkError = 0
            BEGIN
              RAISERROR('SP_PORCOM: Problemas ao Obter a Concentradora.',11,1) WITH SETERROR
              SELECT @ChkError = -30
              GOTO FIM
            END
          END
        END
      /* END EXCEPTION HANDLER */
      /* TRY */
        SELECT @temrlg=COUNT(*) FROM r058rlg WHERE CODCEN = @l_codcen
        IF @temrlg > 0
        BEGIN
          SELECT 
        @l_dirsvr=r058cen.dirsvr, @l_gersen=r058cen.gersen, @l_cenati=r058cen.cenati
         FROM r058cen r058cen
         WHERE codcen=@l_codcen
          SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
          IF @ChkError <> 0
          BEGIN
            GOTO EXC8
          END
          IF (@l_gersen='S') and (@l_cenati='S')
          BEGIN
            /* TRY */
              IF @l_codcmd 
        NOT  IN (11,12,30,31,32,76,91)
              BEGIN
                IF (@l_codcmd=62)
                BEGIN
                  IF (@l_tipope<>3)
                  BEGIN
                    SELECT @l_CodDsp = SUBSTRING(@l_straux,19,9)
                    UPDATE r070adm SET 
        stacmd=7 
         WHERE idtpes=@l_idtpes 
        and numfis=@l_numfis 
        and numcra=@l_numcra 
        and stacmd in (0,1,5,8,9) 
        and codcmd = @l_CodTraduzido 
        and dirsvr=@l_dirsvr 
        and codadm in (select 
        r070onl.codadm codadm
         from r070onl r070onl
         where coddsp=@l_coddsp )
                    SELECT @ChkError = @@Error
                    IF @ChkError <> 0
                    BEGIN
                      GOTO EXC9
                    END
                  END
                  ELSE
                  BEGIN
                    SELECT @l_straux = SUBSTRING(@p_Straux,1,27)+'0'+SUBSTRING(@p_Straux,29,DATALENGTH(@p_Straux)-28)
                  END
                END
                ELSE
                BEGIN
                  IF (@l_codcmd=6)
                  BEGIN
                    UPDATE r070adm SET 
        stacmd=7 
         WHERE idtpes=@l_idtpes 
        and stacmd in (0,1,5,8,9) 
        and codcmd = @l_CodTraduzido 
        and dirsvr=@l_dirsvr 
        and substring(valstr,27,3)=substring(@l_straux,27,3) 
        and substring(valstr,30,7)=substring(@l_straux,30,7)
                    SELECT @ChkError = @@Error
                    IF @ChkError <> 0
                    BEGIN
                      GOTO EXC9
                    END
                  END
                  ELSE
                  BEGIN
                    IF (@l_codcmd=78)
                    BEGIN
                      UPDATE r070adm SET 
        stacmd=7 
         WHERE substring(valstr,4,3)=substring(@l_straux,4,3) 
        and substring(valstr,7,7)=substring(@l_straux,7,7) 
        and stacmd in (0,1,5,8,9) 
        and codcmd = @l_CodTraduzido 
        and dirsvr=@l_dirsvr
                      SELECT @ChkError = @@Error
                      IF @ChkError <> 0
                      BEGIN
                        GOTO EXC9
                      END
                    END
                    ELSE
                    BEGIN
                      UPDATE r070adm SET 
        stacmd=7 
         WHERE idtpes=@l_idtpes 
        and numfis=@l_numfis 
        and numcra=@l_numcra 
        and stacmd in (0,1,5,8,9) 
        and codcmd = @l_CodTraduzido 
        and dirsvr=@l_dirsvr
                      SELECT @ChkError = @@Error
                      IF @ChkError <> 0
                      BEGIN
                        GOTO EXC9
                      END
                    END
                  END
                END
              END
              EXECUTE  @ChkError = SP_RETLOGPEN @l_logpen OUTPUT  
              IF @ChkError <> 0
              BEGIN
                GOTO EXC9
              END
              
              INSERT INTO r070adm
                (datenv,horenv,dirsvr,valstr,retpen,qtdten,cicatu,numfis,codcmd,stacmd,seqenv,numcra,idtpes,verron,logpen) 
              VALUES 
                (@l_datenv,@l_horenv,@l_dirsvr,@l_straux,@l_retpen,0,0,@l_numfis, @l_CodTraduzido, @l_stacmd,@l_seqenv,@l_numcra,@l_idtpes,NULL,@l_logpen)
              SELECT @ChkError = @@Error
              IF @ChkError <> 0
              BEGIN
                GOTO EXC9
              END
            /* END TRY */
            /* BEGIN EXCEPTION HANDLER */
              EXC9:
              SELECT @SE_EXC9 = @ChkError
              IF @ChkError <> 0
              BEGIN
                BEGIN
                  SELECT @ChkError = 0
                  SELECT @NULL_VAR = 1
                  BEGIN
                    RAISERROR('SP_PorCom: Erro na inserção da pendência na R070ADM Insert 1.',11,1) WITH SETERROR
                    SELECT @ChkError = -30
                    GOTO EXC8
                  END
                END
              END
            /* END EXCEPTION HANDLER */
          END
        /* END TRY */
        /* BEGIN EXCEPTION HANDLER */
          EXC8:
          SELECT @SE_EXC8 = @ChkError
          IF @ChkError <> 0
          BEGIN
            BEGIN
              SELECT @ChkError = 0
              SELECT @NULL_VAR = 1
            END
          END
      /* END EXCEPTION HANDLER */
        END
      IF (@l_cenpen='FIM')
      BEGIN
        BREAK
      END
    END
  END
FIM:
  RETURN @ChkError
END


	MSSQL;235SP_INTSTR
SP_RETLOGPEN
SP_STRTODATE
SP_PORCOMDSP
cK␀␀CREATE  PROCEDURE sp_porcom(@p_Straux VARCHAR(2047), @p_CenPen VARCHAR(255)) AS
BEGIN
DECLARE @l_retpen CHAR(3)
DECLARE @l_datenv DATETIME
DECLARE @l_datenv_str CHAR(16)
DECLARE @l_horenv SMALLINT
DECLARE @l_numfis BIGINT
DECLARE @l_codcmd SMALLINT
DECLARE @l_CodTraduzido SMALLINT
DECLARE @l_stacmd SMALLINT
DECLARE @l_seqenv SMALLINT
DECLARE @l_numcra BIGINT
DECLARE @l_idtpes VARCHAR(23)
DECLARE @l_cenpen VARCHAR(255)
DECLARE @l_codcen SMALLINT
DECLARE @l_dirsvr VARCHAR(250)
DECLARE @l_gersen CHAR(1)
DECLARE @l_cenati CHAR(1)
DECLARE @l_stacsm SMALLINT
DECLARE @l_porcom VARCHAR(16)
DECLARE @l_aux SMALLINT
DECLARE @l_coddsp INTEGER
DECLARE @l_tipope SMALLINT
DECLARE @l_dat_conv VARCHAR(25)
DECLARE @l_logpen VARCHAR(2047)
DECLARE @l_straux VARCHAR(2047)
DECLARE @l_r058cen_DIRSVR VARCHAR(250)
DECLARE @l_r058cen_GERSEN VARCHAR(1)
DECLARE @l_r058cen_CENATI VARCHAR(1)
DECLARE @l_r058cen_STACSM SMALLINT
DECLARE @l_r058cen_CODCEN SMALLINT
DECLARE @l_codcmd_str CHAR(3)
DECLARE @l_SubCmd INTEGER
DECLARE @temrlg INTEGER

  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @SE_EXC2 INTEGER
  DECLARE @SE_EXC4 INTEGER
  DECLARE @NULL_VAR INTEGER
  DECLARE @SE_EXC3 INTEGER
  DECLARE @SE_EXC6 INTEGER
  DECLARE @SE_EXC7 INTEGER
  DECLARE @SE_EXC9 INTEGER
  DECLARE @SE_EXC8 INTEGER
  SELECT @ChkError = 0
  SELECT @l_datenv = CONVERT(DATETIME,CONVERT(DATE,GETDATE()))
  SELECT @l_horenv = DATEPART(HOUR,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))*60+DATEPART(MINUTE,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))
  SELECT @l_seqenv = DATEPART(ss,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE()))))+ ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))
  SELECT @l_idtpes = '                       '
  SELECT @l_numcra = 0
  SELECT @l_numfis = 0
  SELECT @l_stacmd = 1
  SELECT @l_retpen = '001'
  SELECT @l_tipope = 0
  /* BEGIN EXCEPTION HANDLER */
    EXC1:
    SELECT @SE_EXC1 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        BEGIN
          RAISERROR('SP_PORCOM: 1. Problemas ao obter a versão do sistema',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
    
  /* BEGIN EXCEPTION HANDLER */
    EXC2:
    SELECT @SE_EXC2 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        BEGIN
          RAISERROR('SP_PORCOM: 2. Problemas ao obter a versão do sistema',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
  /* TRY */
    SELECT @l_codcmd = SUBSTRING(@p_Straux,1,2)
    
    IF (@l_codcmd=62)
    BEGIN
      EXECUTE @ChkError = SP_PORCOMDSP @p_Straux, @p_CenPen   
      GOTO FIM
    END
    
    IF (@l_codcmd=99)
    BEGIN
      SELECT @l_SubCmd = SUBSTRING(@p_Straux,3,5)
    END

    EXECUTE @ChkError = SP_TRADUZIRCODCMD @l_CodCmd, @l_SubCmd, @l_CodTraduzido OUTPUT
    
    IF ((@l_codcmd=2) 
      OR (@l_codcmd=5) 
      OR (@l_codcmd=9) 
      OR (@l_codcmd=13) 
      OR (@l_codcmd=21) 
      OR (@l_codcmd=38) 
      OR (@l_codcmd=83))
    BEGIN
      SELECT @l_numfis = SUBSTRING(@p_Straux,19,12)
      IF (@l_codcmd=21)
      BEGIN
        SELECT @l_numcra = SUBSTRING(@p_Straux,69,12)
      END
      IF (@l_codcmd=38)
      BEGIN
        SELECT @l_numfis = SUBSTRING(@p_Straux,22,12)
      END
      IF (@l_codcmd=83)
      BEGIN
        SELECT @l_numcra = SUBSTRING(@p_Straux,19,12)
        SELECT @l_numfis = 0
      END
    END
    ELSE
    BEGIN
      IF ((@l_codcmd=1) 
      OR (@l_codcmd=3) 
      OR (@l_codcmd=4) 
      OR (@l_codcmd=8) 
      OR (@l_codcmd=19) 
      OR (@l_codcmd=22) 
      OR (@l_codcmd=23) 
      OR (@l_codcmd=24) 
      OR (@l_codcmd=25) 
      OR (@l_codcmd=26) 
      OR (@l_codcmd=27) 
      OR (@l_codcmd=60) 
      OR (@l_codcmd=63) 
      OR (@l_codcmd=82)
      OR (@l_codcmd=93)      
      OR (@l_codcmd=95)
      OR (@l_codcmd=96))
      BEGIN
        SELECT @l_idtpes = SUBSTRING(@p_Straux,19,23)
      END
      ELSE
      BEGIN
        IF (@l_codcmd=12)
        BEGIN
          SELECT @l_idtpes = SUBSTRING(@p_Straux,20,23)
        END
        ELSE
        BEGIN
          IF (@l_codcmd=62)
          BEGIN
            SELECT @l_idtpes = SUBSTRING(@p_Straux,42,23)
            SELECT @l_numfis = SUBSTRING(@p_Straux,29,12)
            SELECT @l_tipope = SUBSTRING(@p_Straux,28,1)
            SELECT @l_datenv_str = SUBSTRING(@p_Straux,3,16)
            SELECT @l_dat_conv = SUBSTRING(@l_datenv_str,1,2)+'/'+SUBSTRING(@l_datenv_str,3,2)+'/'+SUBSTRING(@l_datenv_str,5,2)
            EXECUTE  @ChkError = SP_STRTODATE @l_dat_conv,'DD/MM/AA',@l_datenv OUTPUT  
            IF @ChkError <> 0
            BEGIN
              GOTO EXC3
            END
            SELECT @l_horenv = CONVERT(NUMERIC,(SUBSTRING(@l_datenv_str,7,2)))*60+CONVERT(NUMERIC,(SUBSTRING(@l_datenv_str,9,2)))
          END
          ELSE
          BEGIN
            IF (@l_codcmd=75)
            BEGIN
              SELECT @l_idtpes = SUBSTRING(@p_Straux,20,23)
              SELECT @l_numfis = SUBSTRING(@p_Straux,44,12)
            END
            ELSE
            BEGIN
              IF (@l_codcmd=6)
              BEGIN
                SELECT @l_idtpes = SUBSTRING(@p_Straux,3,23)
                SELECT @l_tipope = SUBSTRING(@p_Straux,26,1)
              END
              ELSE
              BEGIN
                IF (@l_codcmd=79)
                BEGIN
                  SELECT @l_idtpes = SUBSTRING(@p_Straux,3,23)
                END
	            ELSE
	            BEGIN
	              IF (@l_codcmd=86)
	              BEGIN
	                SELECT @l_idtpes = SUBSTRING(@p_Straux,59,23)
	              END
	            END                
              END
            END
          END
        END
      END
    END
    IF (@l_codcmd=62)
    BEGIN
      /* TRY */
        UPDATE r070adm SET 
      stacmd=7 
       WHERE idtpes<>@l_idtpes 
      and numfis=@l_numfis 
      and numcra=@l_numcra 
      and stacmd in (0,1,5,8,9) 
      and codcmd = @l_CodTraduzido
        SELECT @ChkError = @@Error
        IF @ChkError <> 0
        BEGIN
          GOTO EXC4
        END
      /* END TRY */
      /* BEGIN EXCEPTION HANDLER */
        EXC4:
        SELECT @SE_EXC4 = @ChkError
        IF @ChkError <> 0
        BEGIN
          BEGIN
            SELECT @ChkError = 0
            SELECT @NULL_VAR = 1
          END
        END
      /* END EXCEPTION HANDLER */
    END
    IF (@l_codcmd=19)
      OR (@l_codcmd=93) 
      OR (@l_codcmd=1) 
      OR (@l_codcmd=3) 
      OR ((@l_codcmd=62) 
      AND (@l_tipope=1)) 
      OR ((@l_codcmd=6) 
      AND (@l_tipope>1))
    BEGIN
      IF (@l_seqenv>1)
      BEGIN
        SELECT @l_seqenv = @l_seqenv-2
      END
      ELSE
      BEGIN
        IF (@l_horenv>0)
        BEGIN
          SELECT @l_horenv = @l_horenv-1
          SELECT @l_seqenv = 59
        END
        ELSE
        BEGIN
          SELECT @l_datenv = DATEADD(DAY,-1,@l_datenv)
          SELECT @l_horenv = 1439
          SELECT @l_seqenv = 59
        END
      END
    END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC3:
    SELECT @SE_EXC3 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        BEGIN
          RAISERROR('SP_PorCom: Problemas ao Formatar a Pendência.',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
  SELECT @l_CenPen = @p_CenPen
  SELECT @l_CenPen = LTRIM(@l_CenPen)
  SELECT @l_CenPen = RTRIM(@l_CenPen)
  SELECT @l_straux = @p_Straux
  IF (@l_CenPen='0')
  BEGIN
    DECLARE c_r058cen CURSOR FOR SELECT 
      r058cen.dirsvr DIRSVR,r058cen.gersen GERSEN,r058cen.cenati CENATI, r058cen.stacsm STACSM, r058cen.codcen CODCEN
       FROM r058cen r058cen
       WHERE gersen='S' 
      and tipger=2
    OPEN c_r058cen
    FETCH NEXT FROM c_r058cen INTO @l_r058cen_dirsvr, @l_r058cen_gersen, @l_r058cen_cenati, @l_r058cen_stacsm, @l_r058cen_codcen
    WHILE  (@@FETCH_STATUS = 0)
    BEGIN
      SELECT @temrlg=COUNT(*) FROM r058rlg WHERE CODCEN  = @l_r058cen_codcen
      IF (@l_r058cen_gersen='S') and (@l_r058cen_cenati='S') and (@l_r058cen_stacsm=1) and (@temrlg > 0)
      BEGIN
        /* TRY */
          IF @l_codcmd 
      NOT  IN (11,12,30,31,32,76,91)
          BEGIN
            IF (@l_codcmd=62)
            BEGIN
              IF (@l_tipope<>3)
              BEGIN
                SELECT @l_CodDsp = SUBSTRING(@l_straux,19,9)
                UPDATE r070adm SET 
      stacmd=7 
       WHERE idtpes=@l_idtpes 
      and numfis=@l_numfis 
      and numcra=@l_numcra 
      and stacmd in (0,1,5,8,9) 
      and codcmd = @l_CodTraduzido 
      and dirsvr=@l_r058cen_dirsvr 
      and codadm in (select 
      r070onl.codadm codadm
       from r070onl r070onl
       where coddsp=@l_coddsp )
                SELECT @ChkError = @@Error
                IF @ChkError <> 0
                BEGIN
                  GOTO EXC6
                END
              END
              ELSE
              BEGIN
                SELECT @l_straux = SUBSTRING(@p_Straux,1,27)+'0'+SUBSTRING(@p_Straux,29,DATALENGTH(@p_Straux)-28)
              END
            END
            ELSE
            BEGIN
              IF (@l_codcmd=6)
              BEGIN
                UPDATE R070ADM SET STACMD=7 
                WHERE CODADM IN ( SELECT CODADM FROM R070ADM WITH (NOLOCK) WHERE
                                  IDTPES=@l_idtpes AND STACMD IN (0,1,5,8,9) AND 
                                  CODCMD = @l_CodTraduzido AND DIRSVR=@l_r058cen_dirsvr AND 
                                  SUBSTRING(VALSTR,27,3)=SUBSTRING(@l_straux,27,3) anD 
                                  SUBSTRING(VALSTR,30,7)=SUBSTRING(@l_straux,30,7)
                                )
                
                SELECT @ChkError = @@Error
                IF @ChkError <> 0
                BEGIN
                  GOTO EXC6
                END
              END
              ELSE
              BEGIN
                IF (@l_codcmd=78)
                BEGIN
                  UPDATE r070adm SET 
      stacmd=7 
       WHERE substring(valstr,4,3)=substring(@l_straux,4,3) 
      and substring(valstr,7,7)=substring(@l_straux,7,7) 
      and stacmd in (0,1,5,8,9) 
      and codcmd = @l_CodTraduzido 
      and dirsvr=@l_r058cen_dirsvr
                  SELECT @ChkError = @@Error
                  IF @ChkError <> 0
                  BEGIN
                    GOTO EXC6
                  END
                END
                ELSE
                BEGIN
                  UPDATE r070adm SET 
      stacmd=7 
       WHERE idtpes=@l_idtpes 
      and numfis=@l_numfis 
      and numcra=@l_numcra 
      and stacmd in (0,1,5,8,9) 
      and codcmd = @l_CodTraduzido 
      and dirsvr=@l_r058cen_dirsvr
                  SELECT @ChkError = @@Error
                  IF @ChkError <> 0
                  BEGIN
                    GOTO EXC6
                  END
                END
              END
            END
          END
          EXECUTE  @ChkError = SP_RETLOGPEN @l_logpen OUTPUT  
          IF @ChkError <> 0
          BEGIN
            GOTO EXC6
          END
          
          INSERT INTO r070adm
            (datenv,horenv,dirsvr,valstr,retpen,qtdten,cicatu,numfis,codcmd,stacmd,seqenv,numcra,idtpes,verron,logpen) 
          VALUES 
            (@l_datenv,@l_horenv,@l_r058cen_dirsvr,@l_straux,@l_retpen,0,0,@l_numfis,@l_CodTraduzido,@l_stacmd,@l_seqenv,@l_numcra,@l_idtpes,NULL,@l_logpen)
          SELECT @ChkError = @@Error
          IF @ChkError <> 0
          BEGIN
            GOTO EXC6
          END
        /* END TRY */
        /* BEGIN EXCEPTION HANDLER */
          EXC6:
          SELECT @SE_EXC6 = @ChkError
          IF @ChkError <> 0
          BEGIN
            BEGIN
              SELECT @ChkError = 0
              SELECT @NULL_VAR = 1
              BEGIN
                RAISERROR('SP_PorCom: Erro na inserção da pendência na R070ADM Insert 1.',11,1) WITH SETERROR
                SELECT @ChkError = -30
                GOTO FNc_r058cen5
              END
            END
          END
        /* END EXCEPTION HANDLER */
      END
      FETCH NEXT FROM c_r058cen INTO @l_r058cen_dirsvr, @l_r058cen_gersen, @l_r058cen_cenati, @l_r058cen_stacsm, @l_r058cen_codcen
    END
    FNc_r058cen5: /* FINALLY OPEN CURSOR */
    CLOSE c_r058cen
    DEALLOCATE c_r058cen
    IF @ChkError <> 0
      GOTO FIM
  END
  ELSE
  BEGIN
    WHILE 1=1
    BEGIN
      /* TRY */
        SELECT @l_aux = CHARINDEX(SUBSTRING(',',1,255),@l_cenpen)
        IF (@l_aux=0)
        BEGIN
          SELECT @l_codcen = @l_cenpen
          SELECT @l_cenpen = 'FIM'
        END
        ELSE
        BEGIN
          SELECT @l_codcen = SUBSTRING(@l_cenpen,1,1)
          SELECT @l_cenpen = SUBSTRING(@l_cenpen,(@l_aux+1),(DATALENGTH(@l_cenpen)))
        END
      /* END TRY */
      /* BEGIN EXCEPTION HANDLER */
        EXC7:
        SELECT @SE_EXC7 = @ChkError
        IF @ChkError <> 0
        BEGIN
          BEGIN
            SELECT @ChkError = 0
            BEGIN
              RAISERROR('SP_PORCOM: Problemas ao Obter a Concentradora.',11,1) WITH SETERROR
              SELECT @ChkError = -30
              GOTO FIM
            END
          END
        END
      /* END EXCEPTION HANDLER */
      /* TRY */
        SELECT @temrlg=COUNT(*) FROM r058rlg WHERE CODCEN = @l_codcen
        IF @temrlg > 0
        BEGIN
          SELECT 
        @l_dirsvr=r058cen.dirsvr, @l_gersen=r058cen.gersen, @l_cenati=r058cen.cenati
         FROM r058cen r058cen
         WHERE codcen=@l_codcen
          SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
          IF @ChkError <> 0
          BEGIN
            GOTO EXC8
          END
          IF (@l_gersen='S') and (@l_cenati='S')
          BEGIN
            /* TRY */
              IF @l_codcmd 
        NOT  IN (11,12,30,31,32,76,91)
              BEGIN
                IF (@l_codcmd=62)
                BEGIN
                  IF (@l_tipope<>3)
                  BEGIN
                    SELECT @l_CodDsp = SUBSTRING(@l_straux,19,9)
                    UPDATE r070adm SET 
        stacmd=7 
         WHERE idtpes=@l_idtpes 
        and numfis=@l_numfis 
        and numcra=@l_numcra 
        and stacmd in (0,1,5,8,9) 
        and codcmd = @l_CodTraduzido 
        and dirsvr=@l_dirsvr 
        and codadm in (select 
        r070onl.codadm codadm
         from r070onl r070onl
         where coddsp=@l_coddsp )
                    SELECT @ChkError = @@Error
                    IF @ChkError <> 0
                    BEGIN
                      GOTO EXC9
                    END
                  END
                  ELSE
                  BEGIN
                    SELECT @l_straux = SUBSTRING(@p_Straux,1,27)+'0'+SUBSTRING(@p_Straux,29,DATALENGTH(@p_Straux)-28)
                  END
                END
                ELSE
                BEGIN
                  IF (@l_codcmd=6)
                  BEGIN
                    UPDATE r070adm SET 
        stacmd=7 
         WHERE idtpes=@l_idtpes 
        and stacmd in (0,1,5,8,9) 
        and codcmd = @l_CodTraduzido 
        and dirsvr=@l_dirsvr 
        and substring(valstr,27,3)=substring(@l_straux,27,3) 
        and substring(valstr,30,7)=substring(@l_straux,30,7)
                    SELECT @ChkError = @@Error
                    IF @ChkError <> 0
                    BEGIN
                      GOTO EXC9
                    END
                  END
                  ELSE
                  BEGIN
                    IF (@l_codcmd=78)
                    BEGIN
                      UPDATE r070adm SET 
        stacmd=7 
         WHERE substring(valstr,4,3)=substring(@l_straux,4,3) 
        and substring(valstr,7,7)=substring(@l_straux,7,7) 
        and stacmd in (0,1,5,8,9) 
        and codcmd = @l_CodTraduzido 
        and dirsvr=@l_dirsvr
                      SELECT @ChkError = @@Error
                      IF @ChkError <> 0
                      BEGIN
                        GOTO EXC9
                      END
                    END
                    ELSE
                    BEGIN
                      UPDATE r070adm SET 
        stacmd=7 
         WHERE idtpes=@l_idtpes 
        and numfis=@l_numfis 
        and numcra=@l_numcra 
        and stacmd in (0,1,5,8,9) 
        and codcmd = @l_CodTraduzido 
        and dirsvr=@l_dirsvr
                      SELECT @ChkError = @@Error
                      IF @ChkError <> 0
                      BEGIN
                        GOTO EXC9
                      END
                    END
                  END
                END
              END
              EXECUTE  @ChkError = SP_RETLOGPEN @l_logpen OUTPUT  
              IF @ChkError <> 0
              BEGIN
                GOTO EXC9
              END
              
              INSERT INTO r070adm
                (datenv,horenv,dirsvr,valstr,retpen,qtdten,cicatu,numfis,codcmd,stacmd,seqenv,numcra,idtpes,verron,logpen) 
              VALUES 
                (@l_datenv,@l_horenv,@l_dirsvr,@l_straux,@l_retpen,0,0,@l_numfis, @l_CodTraduzido, @l_stacmd,@l_seqenv,@l_numcra,@l_idtpes,NULL,@l_logpen)
              SELECT @ChkError = @@Error
              IF @ChkError <> 0
              BEGIN
                GOTO EXC9
              END
            /* END TRY */
            /* BEGIN EXCEPTION HANDLER */
              EXC9:
              SELECT @SE_EXC9 = @ChkError
              IF @ChkError <> 0
              BEGIN
                BEGIN
                  SELECT @ChkError = 0
                  SELECT @NULL_VAR = 1
                  BEGIN
                    RAISERROR('SP_PorCom: Erro na inserção da pendência na R070ADM Insert 1.',11,1) WITH SETERROR
                    SELECT @ChkError = -30
                    GOTO EXC8
                  END
                END
              END
            /* END EXCEPTION HANDLER */
          END
        /* END TRY */
        /* BEGIN EXCEPTION HANDLER */
          EXC8:
          SELECT @SE_EXC8 = @ChkError
          IF @ChkError <> 0
          BEGIN
            BEGIN
              SELECT @ChkError = 0
              SELECT @NULL_VAR = 1
            END
          END
      /* END EXCEPTION HANDLER */
        END
      IF (@l_cenpen='FIM')
      BEGIN
        BREAK
      END
    END
  END
FIM:
  RETURN @ChkError
END


	POSTGRESQL;245SP_INTSTR
SP_RETLOGPEN
SP_STRTODATE
SP_PORCOMDSP
Ï/␀␀CREATE OR REPLACE PROCEDURE SP_PORCOM(p_Straux IN VARCHAR(4000),p_CenPen IN VARCHAR(4000))
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  l_retpen CHAR(3);
  l_datenv TIMESTAMP(0);
  l_datenv_str CHAR(16);
  l_horenv SMALLINT;
  l_numfis BIGINT;
  l_codcmd SMALLINT;
  l_CodCmd_Str CHAR(3);
  l_stacmd SMALLINT;
  l_seqenv SMALLINT;
  l_numcra BIGINT;
  l_idtpes VARCHAR(23);
  l_CenPen VARCHAR(255);
  l_codcen SMALLINT;
  l_dirsvr VARCHAR(250);
  l_gersen CHAR(1);
  l_cenati CHAR(1);
  l_stacsm SMALLINT;
  l_porcom VARCHAR(16);
  l_aux SMALLINT;
  l_coddsp BIGINT;
  l_tipope SMALLINT;
  l_dat_conv VARCHAR(25);
  l_logpen VARCHAR(2047);
  l_straux VARCHAR(2047);
  l_CodTraduzido SMALLINT;
  l_SubCmd INT;
  temrlg INT;
  l_r058cen$dirsvr VARCHAR(250);
  l_r058cen$gersen VARCHAR(1);
  l_r058cen$cenati VARCHAR(1);
  l_r058cen$stacsm SMALLINT; 
  l_r058cen$codcen SMALLINT;
  stacktrace text;

BEGIN
  l_datenv := TO_DATE(TO_CHAR(CURRENT_TIMESTAMP,'DD/MM/YYYY'),'DD/MM/YYYY');
  l_horenv := (TO_CHAR(TO_DATE(TO_CHAR(CURRENT_TIMESTAMP,'HH24:MI:SS'),'HH24:MI:SS'),'HH24'))::smallint*60+(TO_CHAR(TO_DATE(TO_CHAR(CURRENT_TIMESTAMP,'HH24:MI:SS'),'HH24:MI:SS'),'MI'))::smallint;
  l_seqenv := (TO_CHAR(TO_DATE(TO_CHAR(CURRENT_TIMESTAMP,'HH24:MI:SS'),'HH24:MI:SS'),'SS'))::smallint;
  l_idtpes := '                       ';
  l_numcra := 0;
  l_numfis := 0;
  l_stacmd := 1;
  l_retpen := '001';
  l_tipope := 0;
  begin
    l_codcmd := SUBSTR(p_Straux,1,2);
    
    if (l_codcmd=62) then
      CALL SP_PORCOMDSP(p_Straux, p_CenPen);   
      return;
    end if;
    
    if (l_codcmd = 99) then
      l_SubCmd := SUBSTR(p_Straux,3,5);
    else
      l_SubCmd := 0;
    end if;
  
    CALL SP_TRADUZIRCODCMD(l_CodCmd, l_SubCmd, l_CodTraduzido);
    
    if ((l_codcmd=2) 
      OR (l_codcmd=5) 
      OR (l_codcmd=9) 
      OR (l_codcmd=13) 
      OR (l_codcmd=21) 
      OR (l_codcmd=38) 
      OR (l_codcmd=83)) then
      l_numfis := SUBSTR(p_Straux,19,12);
      if (l_codcmd=21) then
        l_numcra := SUBSTR(p_Straux,69,12);
      end if;
      if (l_codcmd=38) then
        l_numfis := SUBSTR(p_Straux,22,12);
      end if;
      if (l_codcmd=83) then
        l_numcra := SUBSTR(p_Straux,19,12);
        l_numfis := 0;
      end if;
    else
      if ((l_codcmd=1) 
      OR (l_codcmd=3) 
      OR (l_codcmd=4) 
      OR (l_codcmd=8) 
      OR (l_codcmd=19) 
      OR (l_codcmd=22) 
      OR (l_codcmd=23) 
      OR (l_codcmd=24) 
      OR (l_codcmd=25) 
      OR (l_codcmd=26) 
      OR (l_codcmd=27) 
      OR (l_codcmd=60) 
      OR (l_codcmd=63) 
      OR (l_codcmd=82)
      OR (l_codcmd=93) 
      OR (l_codcmd=95)
      OR (l_codcmd=96)) then
        l_idtpes := SUBSTR(p_Straux,19,23);
      else
        if (l_codcmd=12) then
          l_idtpes := SUBSTR(p_Straux,20,23);
        else
          if (l_codcmd=62) then
            l_idtpes := SUBSTR(p_Straux,42,23);
            l_numfis := SUBSTR(p_Straux,29,12);
            l_tipope := SUBSTR(p_Straux,28,1);
            l_datenv_str := SUBSTR(p_Straux,3,16);
            l_dat_conv := SUBSTR(l_datenv_str,1,2)||'/'||SUBSTR(l_datenv_str,3,2)||'/'||SUBSTR(l_datenv_str,5,2);
            CALL SP_STRTODATE(l_dat_conv,'DD/MM/AA',l_datenv);
            l_horenv := ((SUBSTR(l_datenv_str,7,2)))::smallint*60+((SUBSTR(l_datenv_str,9,2)))::smallint;
          else
            if (l_codcmd=75) then
              l_idtpes := SUBSTR(p_Straux,20,23);
              l_numfis := SUBSTR(p_Straux,44,12);
            else
              if (l_codcmd=6) then
                l_idtpes := SUBSTR(p_Straux,3,23);
                l_tipope := SUBSTR(p_Straux,26,1);
              else
                if (l_codcmd=79) then
                  l_idtpes := SUBSTR(p_Straux,3,23);
                else
                  if (l_codcmd=86) then
                    l_idtpes := SUBSTR(p_Straux,59,23);
                  end if;                    
                end if;
              end if;
            end if;
          end if;
        end if;
      end if;
    end if;
    if (l_codcmd=62) then
      begin
        UPDATE R070ADM  SET  STACMD = 7  WHERE IDTPES<>l_idtpes 
      AND NUMFIS=l_numfis 
      AND NUMCRA=l_numcra 
      AND STACMD IN (0,1,5,8,9) 
      AND CODCMD = l_CodTraduzido;
      exception
        when OTHERS then
          NULL;
      end;
    end if;
    if (l_codcmd=19)
      OR (l_codcmd=93)
      OR (l_codcmd=1) 
      OR (l_codcmd=3)	  
      OR ((l_codcmd=62) 
      AND (l_tipope=1)) 
      OR ((l_codcmd=6) 
      AND (l_tipope>1)) then
      if (l_seqenv>1) then
        l_seqenv := l_seqenv-2;
      else
        if (l_horenv>0) then
          l_horenv := l_horenv-1;
          l_seqenv := 59;
        else
          l_datenv := (l_datenv::DATE -1)::TIMESTAMP;
          l_horenv := 1439;
          l_seqenv := 59;
        end if;
      end if;
    end if;
  exception
    when OTHERS then
      GET STACKED DIAGNOSTICS 
                      stacktrace = pg_exception_context;
      RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE ='SP_PORCOM: Problemas ao Formatar a Pendência. Stack: ' || stacktrace;
  end;
  
  l_CenPen := p_CenPen;
  l_CenPen := LTRIM(l_CenPen);
  l_CenPen := RTRIM(l_CenPen);
  l_straux := p_Straux;
  if (l_CenPen='0') then
    begin
     FOR l_r058cen$dirsvr,l_r058cen$gersen,l_r058cen$cenati,l_r058cen$stacsm, l_r058cen$codcen IN
	 SELECT DIRSVR, GERSEN, CENATI, STACSM, CODCEN FROM R058CEN WHERE GERSEN='S' AND TIPGER=2
    LOOP
        SELECT COUNT(*) 
         INTO temrlg 
         FROM R058RLG R058RLG 
         WHERE CODCEN=l_r058cen$codcen;
        if (l_r058cen$gersen='S') and (l_r058cen$cenati='S') and (l_r058cen$stacsm=1) and (temrlg > 0) then
          begin
            if l_codcmd 
      NOT  IN (11,12,30,31,32,76,91) then
              if (l_codcmd=62) then
                if (l_tipope<>3) then
                  l_CodDsp := SUBSTR(l_straux,19,9);
                  UPDATE R070ADM  SET  STACMD = 7  WHERE IDTPES=l_idtpes 
      AND NUMFIS=l_numfis 
      AND NUMCRA=l_numcra 
      AND STACMD IN (0,1,5,8,9) 
      AND CODCMD = l_CodTraduzido 
      AND DIRSVR=l_r058cen$dirsvr 
      AND CODADM IN (SELECT 
      R070ONL.CODADM CODADM
       FROM R070ONL R070ONL
       WHERE CODDSP=l_CodDsp )  ;
                else
                  l_straux := SUBSTR(p_Straux,1,27)||'0'||SUBSTR(p_Straux,29,LENGTH(p_Straux)-28);
                end if;
              else
                if (l_codcmd=6) then
                  UPDATE R070ADM  SET  STACMD = 7
                  WHERE CODADM IN ( SELECT CODADM FROM R070ADM WHERE
                                    IDTPES=l_idtpes AND STACMD IN (0,1,5,8,9) AND 
                                    CODCMD = l_CodTraduzido AND DIRSVR=l_r058cen$dirsvr AND 
                                    SUBSTR(VALSTR,27,3)=SUBSTR(l_straux,27,3) AND 
                                    SUBSTR(VALSTR,30,7)=SUBSTR(l_straux,30,7)
                                  );
                else
                  if (l_codcmd=78) then
                    UPDATE R070ADM  SET  STACMD = 7  WHERE SUBSTR(VALSTR,4,3)=SUBSTR(l_straux,4,3) 
      AND SUBSTR(VALSTR,7,7)=SUBSTR(l_straux,7,7) 
      AND STACMD IN (0,1,5,8,9) 
      AND CODCMD = l_CodTraduzido 
      AND DIRSVR=l_r058cen$dirsvr  ;
                  else
                    UPDATE R070ADM  SET  STACMD = 7  WHERE IDTPES=l_idtpes 
      AND NUMFIS=l_numfis 
      AND NUMCRA=l_numcra 
      AND STACMD IN (0,1,5,8,9) 
      AND CODCMD = l_CodTraduzido 
      AND DIRSVR=l_r058cen$dirsvr  ;
                  end if;
                end if;
              end if;
            end if;

            CALL SP_RETLOGPEN(l_logpen);
            INSERT INTO R070ADM (DATENV,HORENV,DIRSVR,VALSTR,RETPEN,QTDTEN,CICATU,NUMFIS,CODCMD,STACMD,SEQENV,NUMCRA,IDTPES,VERRON,LOGPEN) VALUES (l_datenv,l_horenv,l_r058cen$dirsvr,l_straux,l_retpen,0,0,l_numfis, l_CodTraduzido, l_stacmd,l_seqenv,l_numcra,l_idtpes,NULL,l_logpen);
          exception
            when OTHERS then
              NULL;
              RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE ='SP_PORCOM: Erro na inserção da pendência na R070ADM Insert 1.';
          end;
        end if;
      end loop;
    end;
  else
    loop
      begin
        l_aux := POSITION(',' IN l_cenpen);
        if (l_aux=0) then
          l_codcen := l_cenpen;
          l_cenpen := 'FIM';
        else
          l_codcen := SUBSTR(l_cenpen,1,1);
          l_cenpen := SUBSTR(l_cenpen,(l_aux+1),(LENGTH(l_cenpen)));
        end if;
      exception
        when OTHERS then
          RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE ='SP_PORCOM: Problemas ao Obter a Concentradora.';
      end;
      SELECT COUNT(*)
       INTO temrlg
       FROM R058RLG R058RLG WHERE CODCEN=l_codcen;
      if (temrlg>0) then
        begin
          SELECT 
        R058CEN.DIRSVR DIRSVR, R058CEN.GERSEN GERSEN, R058CEN.CENATI CENATI
         INTO l_dirsvr,l_gersen,l_cenati
         FROM R058CEN R058CEN
         WHERE CODCEN=l_codcen;
          if (l_gersen='S') and (l_cenati='S') then
            begin
              if l_codcmd 
        NOT  IN (11,12,30,31,32,76,91) then
                if (l_codcmd=62) then
                  if (l_tipope<>3) then
                    l_CodDsp := SUBSTR(l_straux,19,9);
                    UPDATE R070ADM  SET  STACMD = 7  
                    WHERE IDTPES=l_idtpes 
                    AND NUMFIS=l_numfis 
                    AND NUMCRA=l_numcra 
                    AND STACMD IN (0,1,5,8,9) 
                    AND CODCMD = l_CodTraduzido 
                    AND DIRSVR=l_dirsvr 
                    AND CODADM IN (SELECT 
                    R070ONL.CODADM CODADM
                    FROM R070ONL R070ONL
                    WHERE CODDSP=l_CodDsp )  ;
                  else
                    l_straux := SUBSTR(p_Straux,1,27)||'0'||SUBSTR(p_Straux,29,LENGTH(p_Straux)-28);
                  end if;
                else
                  if (l_codcmd=6) then
                    UPDATE R070ADM  SET  STACMD = 7  
                    WHERE IDTPES=l_idtpes 
                    AND STACMD IN (0,1,5,8,9) 
                    AND CODCMD = l_CodTraduzido 
                    AND DIRSVR=l_dirsvr 
                    AND SUBSTR(VALSTR,27,3)=SUBSTR(l_straux,27,3) 
                    AND SUBSTR(VALSTR,30,7)=SUBSTR(l_straux,30,7)  ;
                  else
                    if (l_codcmd=78) then
                      UPDATE R070ADM  SET  STACMD = 7  
                      WHERE SUBSTR(VALSTR,4,3)=SUBSTR(l_straux,4,3) 
                      AND SUBSTR(VALSTR,7,7)=SUBSTR(l_straux,7,7) 
                      AND STACMD IN (0,1,5,8,9) 
                      AND CODCMD = l_CodTraduzido 
                      AND DIRSVR=l_dirsvr  ;
                    else
                      UPDATE R070ADM  SET  STACMD = 7  
                      WHERE IDTPES=l_idtpes 
                      AND NUMFIS=l_numfis 
                      AND NUMCRA=l_numcra 
                      AND STACMD IN (0,1,5,8,9) 
                      AND CODCMD = l_CodTraduzido 
                      AND DIRSVR=l_dirsvr  ;
                    end if;
                  end if;
                end if;
              end if;
              
              CALL SP_RETLOGPEN(l_logpen);
              INSERT INTO R070ADM (DATENV,HORENV,DIRSVR,VALSTR,RETPEN,QTDTEN,CICATU,NUMFIS,CODCMD,STACMD,SEQENV,NUMCRA,IDTPES,VERRON,LOGPEN) VALUES  (l_datenv,l_horenv,l_dirsvr,l_straux,l_retpen,0,0,l_numfis, l_CodTraduzido, l_stacmd,l_seqenv,l_numcra,l_idtpes,NULL,l_logpen);
            exception
              when OTHERS then
                NULL;
                RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE ='SP_PORCOM: Erro na inserção da pendência na R070ADM Insert 2.';
            end;
          end if;
        exception
          when OTHERS then
            NULL;
        end;
      end if;
      if (l_cenpen='FIM') then
        exit;
      end if;
    end loop;
  end if;
END;
