TRIGGER R110FIC_AD
AFTER DELETE ON R110FIC
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
  OLD_OBSFIC VARCHAR(8001);
  NEW_OBSFIC VARCHAR(8001);
BEGIN

  /* Geração de logs Ficha Médica (Tabela: R110FIC)*/
  l_codSistema := 1;  /* Código do sistema vetorh*/
  l_codcpa := 127;     /* Ficha Médica (Tabela: R110FIC) -- Ajustar o código da categoria se necessário*/
  l_codtpa := 385;     /* Ajustar o código do tipo de auditoria se necessário*/

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110FIC_AD', '');

    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIC));
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110FIC_AD: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');

      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPATN', CONVERT(NUMBER_TO_CHAR, :OLD.TIPATN));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDEP', CONVERT(NUMBER_TO_CHAR, :OLD.CODDEP));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAN', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAN));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'GRUSAN', :OLD.GRUSAN);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PESATN', CONVERT(NUMBER_TO_CHAR, :OLD.PESATN));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ALTATN', CONVERT(NUMBER_TO_CHAR, :OLD.ALTATN));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPFIS', :OLD.TIPFIS);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'COLDOA', :OLD.COLDOA);
      SP_DATSTR(:OLD.ULTDOA, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ULTDOA', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ANTPES', :OLD.ANTPES);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ANTFAM', :OLD.ANTFAM);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ANTPRO', :OLD.ANTPRO);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSFIC', :OLD.OBSFIC);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR, :OLD.CODUSU));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DEFFIS', :OLD.DEFFIS);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDEF', CONVERT(NUMBER_TO_CHAR, :OLD.CODDEF));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BENREA', :OLD.BENREA);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TEMSUB', :OLD.TEMSUB);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'COTDEF', :OLD.COTDEF);
    END;
  END IF;
END␀␀␀¹m␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀=ß␀␀…¬␀␀´␀„␀␀␀␀␀␀°␀␀aXbr␀Æÿ␀␀ÿ␀–,Ì␀„␀␀␀␀␀␀d;§m¹m”)␀␀Æÿ␀␀ÿ␀d¬␀␀Á␀„␀␀␀␀␀␀%%Õ&Õ&y␀Æÿ␀␀ÿ␀␀␀␀␀␀␀Ãm␀␀␀␀Cß␀␀…¬␀␀´␀	€␀␀␀␀␀␀°␀␀aXbr␀Æÿ␀␀Ò␀␀␀–,Ì␀	€␀␀␀␀␀␀d;§m¹m”)␀␀Æÿ␀␀>ß␀␀␀‰,´␀	€␀␀␀␀␀␀];Fh];r␀Æÿ␀␀ÜŞ␀␀␀U␀=€␀␀␀␀␀␀%sêêc␀␀␀ÿ␀␀ÿ␀Ÿ␀=€␀␀␀␀␀␀(sôó␀␀5ô␀␀c␀␀␀ÿ␀␀ÿ␀¬␀=€␀␀␀␀␀␀,s×␀ì␀c␀␀␀ÿ␀␀ÿ␀©␀=€␀␀␀␀␀␀*sÔ␀ã␀c␀␀␀ÿ␀␀ÿ␀ª␀=€␀␀␀␀␀␀+sÕ␀é␀c␀␀␀ÿ␀␀ÿ␀m␀=€␀␀␀␀␀␀&s:S:Sc␀␀␀ÿ␀␀ÿ␀T␀=€␀␀␀␀␀␀$sêïc␀␀␀ÿ␀␀ÿ␀Š␀=€␀␀␀␀␀␀'s}¿␀␀}¿␀␀c␀␀␀ÿ␀␀ÿ␀`-±␀€␀␀␀␀␀␀Ö=ğ␀␀\ğ␀␀q␀Æÿ␀␀ÿ␀␀␀␀0;1;2␀␀¼m␀␀␀␀␀␀␀␀␀␀␀␀␀Dß␀␀…¬␀␀´␀	€␀␀␀␀␀␀°␀␀XbXbr␀Æÿ␀␀Ò␀␀␀,±␀	€␀␀␀␀␀␀Ô?QQq␀Æÿ␀␀!ß␀␀␀eDÑ␀	€␀␀␀␀␀␀8ImõEqC␀êÿ␀␀ÿ␀␀␀␀0;1;2␀␀½v␀␀␀␀Eß␀␀…¬␀␀´␀	€␀␀␀␀␀␀°␀␀XbXbr␀Æÿ␀␀Ò␀␀␀Ã,±␀	€␀␀␀␀␀␀º@‹␀␀‹␀␀q␀Æÿ␀␀uß␀␀␀eDÑ␀	€␀␀␀␀␀␀9ImõEqC␀êÿ␀␀ÿ␀␀␀␀0;1;2␀␀¾v␀␀␀␀Fß␀␀…¬␀␀´␀	€␀␀␀␀␀␀G;XbXbr␀Æÿ␀␀Ò␀␀␀–,Ì␀	€␀␀␀␀␀␀=§m¹m”)␀␀Æÿ␀␀>ß␀␀␀EÑ␀	€␀␀␀␀␀␀9NZ”␀␀£GqC␀êÿ␀␀Kß␀␀␀£-¼␀	€␀␀␀␀␀␀?Q␀Q␀vM‡␀Æÿ␀␀¬ß␀␀␀^DÑ␀	€␀␀␀␀␀␀ŒMø+␀ù+␀qC␀êÿ␀␀Jß␀␀␀Ù³␀␀d€␀␀␀␀␀␀˜´␀␀ñ³␀␀ñ³␀␀C␀␀ÿ␀␀ÿ␀)-±␀€␀␀␀␀␀␀Aùº␀␀ùº␀␀q␀Æÿ␀␀ºŞ␀␀␀P,­␀€␀␀␀␀␀␀?´6´6pM‡␀Æÿ␀␀1ß␀␀␀¼¦␀␀­␀€␀␀␀␀␀␀SB±®␀␀±®␀␀p␀Æÿ␀␀¡ß␀␀␀␀␀␀	0;1;2;3;4Hß␀␀		SENIOR;0H␀␀TRIGGER R110HAS_AI
AFTER INSERT ON R110HAS
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  l_codSistema:= 1;
  l_codcpa := 137; 
  l_codtpa := 405;

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110HAS_AI', '');

    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:NEW.CODFIC));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSUN', CONVERT(NUMBER_TO_CHAR,:NEW.CODSUN));
      SP_DATSTR(:NEW.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      SP_DATSTR(:NEW.DATACO, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATACO', l_datTemp);
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110HAS_AI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSSUN',:NEW.OBSSUN);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPAR', CONVERT(NUMBER_TO_CHAR,:NEW.CODPAR));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCON', CONVERT(NUMBER_TO_CHAR,:NEW.CODCON));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NIVATE', CONVERT(NUMBER_TO_CHAR,:NEW.NIVATE));
    END;
  END IF;
END␀Iß␀␀		SENIOR;0ı
␀␀

TRIGGER R110HAS_AU
AFTER UPDATE ON R110HAS
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  IF (
  :OLD.OBSSUN <>:NEW.OBSSUN OR
  :OLD.CODPAR <>:NEW.CODPAR OR
  :OLD.CODCON <>:NEW.CODCON OR
  :OLD.NIVATE <>:NEW.NIVATE
  ) THEN
    l_codSistema:= 1;
    l_codcpa:= 137;  /* Código da categoria de auditoria - Ficha Médica - Subnormalidades - Acompanhamento*/
    l_codtpa:= 406;  /* Código do tipo de auditoria - Alteração*/

    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110HAS_AU', '');

      /* Insere os campos chave na tabela de auditoria R995PRC*/
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:OLD.CODFIC));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSUN', CONVERT(NUMBER_TO_CHAR,:OLD.CODSUN));
        SP_DATSTR(:OLD.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
        SP_DATSTR(:OLD.DATACO, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATACO', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110HAS_AU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      /* Insere os valores dos campos na tabela de auditoria R995PRT*/
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSSUN',:OLD.OBSSUN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSSUN',:NEW.OBSSUN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPAR', CONVERT(NUMBER_TO_CHAR,:OLD.CODPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPAR', CONVERT(NUMBER_TO_CHAR,:NEW.CODPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCON', CONVERT(NUMBER_TO_CHAR,:OLD.CODCON));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCON', CONVERT(NUMBER_TO_CHAR,:NEW.CODCON));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNIVATE', CONVERT(NUMBER_TO_CHAR,:OLD.NIVATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNIVATE', CONVERT(NUMBER_TO_CHAR,:NEW.NIVATE));
      END;
    END IF;
  END IF;
END␀Gß␀␀		SENIOR;0I␀␀

TRIGGER R110HAS_AD
AFTER DELETE ON R110HAS
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  l_codSistema:= 1;
  l_codcpa := 137;
  l_codtpa := 405;

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110HAS_AD', '');

    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:OLD.CODFIC));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSUN', CONVERT(NUMBER_TO_CHAR,:OLD.CODSUN));
      SP_DATSTR(:OLD.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      SP_DATSTR(:OLD.DATACO, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATACO', l_datTemp);
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110HAS_AD: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSSUN',:OLD.OBSSUN);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPAR', CONVERT(NUMBER_TO_CHAR,:OLD.CODPAR));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCON', CONVERT(NUMBER_TO_CHAR,:OLD.CODCON));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NIVATE', CONVERT(NUMBER_TO_CHAR,:OLD.NIVATE));
    END;
  END IF;
END␀␀␀Ám␀␀␀␀␀␀␀␀␀␀Lß␀␀…¬␀␀´␀	€␀␀␀␀␀␀°␀␀XbXbr␀Æÿ␀␀Ò␀␀␀,±␀	€␀␀␀␀␀␀Ô?QQq␀Æÿ␀␀!ß␀␀␀DÑ␀	€␀␀␀␀␀␀]I&ûCqC␀êÿ␀␀ÿ␀␀␀␀0;1;2␀␀Åv␀␀␀␀Mß␀␀…¬␀␀´␀	€␀␀␀␀␀␀°␀␀XbXbr␀Æÿ␀␀Ò␀␀␀Ã,±␀	€␀␀␀␀␀␀º@‹␀␀‹␀␀q␀Æÿ␀␀uß␀␀␀DÑ␀	€␀␀␀␀␀␀^I&:FqC␀êÿ␀␀ÿ␀␀␀␀0;1;2␀␀Æv␀␀␀␀Nß␀␀…¬␀␀´␀	„␀␀␀␀␀␀G;XbXbr␀Æÿ␀␀Ò␀␀␀–,Ì␀	„␀␀␀␀␀␀=§m¹m”)␀␀Æÿ␀␀>ß␀␀␀b,­␀	„␀␀␀␀␀␀ˆ<ˆPˆPpM‡␀Æÿ␀␀êĞ␀␀␀±DÑ␀„␀␀␀␀␀␀8NÙE£GqC␀êÿ␀␀ÿ␀m³␀␀d„␀␀␀␀␀␀ˆ´␀␀ñ³␀␀ñ³␀␀C␀␀ÿ␀␀ÿ␀ÀÅ␀␀=„␀␀␀␀␀␀ç␀␀îÅ␀␀îÅ␀␀c␀␀␀ÿ␀␀ÿ␀␀␀␀0;1;2Pß␀␀		SENIOR;0à␀␀TRIGGER R110HDF_EI BEFORE INSERT ON R110HDF FOR EACH ROW DECLARE
    l_temAud       BOOLEAN;
    l_codRPA       NUMBER(15);
    l_codSistema   NUMBER(2);
    l_codcpa       NUMBER(4);
    l_codtpa       NUMBER(4);
    l_datTemp      VARCHAR(10);
  
	l_QtdOriOpe NUMBER;
	l_TipCol NUMBER(1);
	l_NumCad NUMBER(9);
	l_CodDep NUMBER(2);
	l_NumCan NUMBER(7);
	l_TipAtn NUMBER(1);
	l_DataAlteracao DATE;
	l_layout VARCHAR2(6);
	l_isEmpty BOOLEAN;
    l_layoutAlteracaoCadastral VARCHAR2(6);
BEGIN
  /* Geração de logs Ficha Médica - Deficiências (Tabela: R110HDF)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 97;     /* Ficha Médica - Deficiências (Tabela: R110HDF)*/
  l_codtpa := 308;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110HDF_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIC));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDEF', CONVERT(NUMBER_TO_CHAR, :NEW.CODDEF));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110HDF_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:NEW.DATDEF, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATDEF', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSDEF', :NEW.OBSDEF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRIDEF', :NEW.PRIDEF);
      END;
  END IF;

	RH_RETATNFICMED(:NEW.NumEmp, :NEW.CodFic, :NEW.DatDef, l_TipAtn OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);

	/* Verifica se o campo R110TRI.OriOpe possui registro */
	BEGIN
		SELECT
			COUNT(*)
		INTO
			l_QtdOriOpe
		FROM
			R110TRI;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_QtdOriOpe := 0;
	END;

	/* Se não existe registro na tabela R110TRI então inclui */
	IF (l_QtdOriOpe = 0) THEN
		/* Insere registro na tabela R110TRI */
		RH_SETORIOPE('H');

		/* Verifica se está incluindo uma Deficiência como principal, então atualiza ficha
       do colaborador\\\\candidato e ficha médica. */
		IF (:NEW.PRIDEF = 'S') THEN

			/* Atualiza código da deficiência na Ficha Médica */
			BEGIN
				UPDATE R110FIC SET
					DEFFIS = 'S',
					CODDEF = :NEW.CODDEF
				WHERE
					NUMEMP = :NEW.NUMEMP AND CODFIC = :NEW.CODFIC;
			EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'Erro ao Atualizar Deficiência na Ficha Médica.';
			END;

			/* Caso o tipo atendido na ficha médica seja 1, atualiza cadastro do colaborador */
			IF (l_TipAtn = 1) THEN
				BEGIN
					UPDATE R034FUN SET
						DEFFIS = 'S',
						CODDEF = :NEW.CODDEF
					WHERE
						NUMEMP = :NEW.NUMEMP AND TIPCOL = l_TipCol AND NUMCAD = l_NumCad;
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'Erro ao Atualizar Deficiência no cadastro do Colaborador.';
				END;
			ELSIF (l_TipAtn = 4) THEN /* Caso o tipo atendido na ficha médica seja 4, atualiza cadastro do candidato */
				BEGIN
					UPDATE R122CEX SET
						DEFFIS = 'S',
						CODDEF = :NEW.CODDEF
					WHERE
						NUMCAN = l_NumCan;
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'Erro ao Atualizar Deficiência no cadastro do Candidato.';
				END;
			END IF;
		END IF;

		/* Deleta registro da tabela R110TRI */
		RH_DELORIOPE('H');
	END IF;
	
	/* eSocial */
	IF (l_TipAtn = 1) THEN
		RH_LAYOUTCOLAB(:NEW.NUMEMP, l_TipCol, l_NumCad, l_layout OUT);
		/* Somente irá gerar pendência se o colaborador tiver a admissão fechada */
		IF (l_layout IS NOT NULL) THEN				
			RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
			SP_ISEMPTY_DAT(:NEW.DATDEF, l_isEmpty OUT);
			IF (l_isEmpty = TRUE) THEN
				l_DataAlteracao := CURDATE();
			ELSE
				l_DataAlteracao := :NEW.DATDEF;
			END IF;
			SP_TAB_ESOCIAL(l_layoutAlteracaoCadastral, :NEW.NUMEMP, l_TipCol, l_NumCad, l_DataAlteracao, NULL, 'R110HDF', 'I', '', '', 0, 'R110HDF_EI');				
		END IF;
	END IF;
	/* eSocial */
END␀Qß␀␀		SENIOR;0à␀␀

TRIGGER R110HDF_EU BEFORE UPDATE ON R110HDF FOR EACH ROW DECLARE
	l_temAud       BOOLEAN;
    l_codRPA       NUMBER(15);
    l_codSistema   NUMBER(2);
    l_codcpa       NUMBER(4);
    l_codtpa       NUMBER(4);
    l_datTemp      VARCHAR(10);
  
	l_QtdOriOpe NUMBER;
	l_TipCol NUMBER(1);
	l_NumCad NUMBER(9);
	l_CodDep NUMBER(2);
	l_NumCan NUMBER(7);
	l_TipAtn NUMBER(1);
	l_DataAlteracao DATE;
	l_Alterou BOOLEAN;
	l_AlterouData BOOLEAN;
	l_Valido BOOLEAN;
	l_layout VARCHAR2(6);
	l_layoutAlteracaoCadastral VARCHAR2(6);	
	l_JsonCamposAlterados VARCHAR2(2000);
	l_isEmpty BOOLEAN;
BEGIN
  /* Geração de logs Ficha Médica - Deficiências (Tabela: R110HDF)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 97;     /* Ficha Médica - Deficiências (Tabela: R110HDF)*/
  l_codtpa := 309;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFic <> :NEW.CodFic)
   OR (:OLD.CodDef <> :NEW.CodDef)
   OR (:OLD.DatDef <> :NEW.DatDef)
   OR (:OLD.ObsDef <> :NEW.ObsDef)
   OR (:OLD.PriDef <> :NEW.PriDef)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110HDF_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIC));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDEF', CONVERT(NUMBER_TO_CHAR, :OLD.CODDEF));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110HDF_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:OLD.DATDEF, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATDEF', l_datTemp);
        SP_DATSTR(:NEW.DATDEF, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATDEF', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSDEF', :OLD.OBSDEF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSDEF', :NEW.OBSDEF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRIDEF', :OLD.PRIDEF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRIDEF', :NEW.PRIDEF);
      END;
    END IF; 
  END IF;
	
	RH_RETATNFICMED(:NEW.NumEmp, :NEW.CodFic, :NEW.DatDef, l_TipAtn OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT); 

	/* Verifica se os campos relacionados a deficiência foram alterados */
	IF ((:NEW.PRIDEF <> :OLD.PRIDEF) OR (:NEW.CODDEF <> :OLD.CODDEF)) THEN
		/* Verifica se campo R110TRI.OriOpe possui registro */
		BEGIN
			SELECT
				COUNT(*)
			INTO
				l_QtdOriOpe
			FROM
				R110TRI;
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_QtdOriOpe := 0;
		END;
	ELSE
	/* Seta valor padrão na qual indica que não houve alterações
       em relação a deficiência, não sendo necessário atualizar ficha
       médica e histórico */
		l_QtdOriOpe := 1;
	END IF;

	IF (l_QtdOriOpe = 0) THEN
		/* Insere  Registro na tabela R110TRI */
		RH_SETORIOPE('H');

		/* Se estiver alterando a Deficiência para principal, deve atualizar Ficha Médica
       e cadastro do colaborador\\\\candidato */
		IF (:NEW.PRIDEF = 'S') THEN
			/* Atualiza Ficha Médica */
			BEGIN
				UPDATE R110FIC SET
					DEFFIS = 'S',
					CODDEF = :NEW.CODDEF
				WHERE
					NUMEMP = :NEW.NUMEMP AND CODFIC = :NEW.CODFIC;
			EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'Erro ao Atualizar Deficiência na Ficha Médica.';
			END;

			/* Se o tipo atendido for 1, atualiza cadastro do colaborador */
			IF (l_TipAtn = 1) THEN
				BEGIN
					UPDATE R034FUN SET
						DEFFIS = 'S',
						CODDEF = :NEW.CODDEF
					WHERE
						NUMEMP = :NEW.NUMEMP AND TIPCOL = l_TipCol AND NUMCAD = l_NumCad;
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'Erro ao Atualizar Deficiência no cadastro do Colaborador.';
				END;
			ELSIF (l_TipAtn = 4) THEN /* Se o tipo atendido for 4, atualiza cadastro do candidato */
				BEGIN
					UPDATE R122CEX SET
						DEFFIS = 'S',
						CODDEF = :NEW.CODDEF
					WHERE
						NUMCAN = l_NumCan;
				EXCEPTION
					WHEN OTHERS THEN
						RAISERROR 103 'Erro ao Atualizar Deficiência no cadastro do Candidato.';
				END;
			END IF;
		END IF;

		/* Deleta registro na tabela R110TRI */
		RH_DELORIOPE('H');
	END IF;
	
	/* eSocial */
	IF (l_TipAtn = 1) THEN
		l_Alterou := FALSE;
		l_AlterouData := FALSE;
		l_JsonCamposAlterados := '';

		SP_VALUPDATE_NUM(:OLD.CodDef, :NEW.CodDef, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('CODDEF', :NEW.CodDef, :OLD.CodDef, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DAT(:OLD.DatDef, :NEW.DatDef, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			l_AlterouData := TRUE;
			SP_CONCAT_DAT_JSON('DATDEF', :NEW.DatDef, :OLD.DatDef, l_JsonCamposAlterados OUT);
		END IF;
	
		SP_VALUPDATE_DES(:OLD.ObsDef, :NEW.ObsDef, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('OBSDEF', 'Observação da deficiência alterada', 'Observação da deficiência alterada', l_JsonCamposAlterados OUT);
		END IF;

		IF (l_Alterou = TRUE) THEN			
			RH_LAYOUTCOLAB(:NEW.NUMEMP, l_TipCol, l_NumCad, l_layout OUT);
			/* Somente irá gerar pendência se o colaborador tiver a admissão fechada */
			IF (l_layout IS NOT NULL) THEN
			    RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
			
				SP_ISEMPTY_DAT(:NEW.DATDEF, l_isEmpty OUT);
				IF (l_isEmpty = TRUE) THEN
					l_DataAlteracao := CURDATE();
				ELSE
					l_DataAlteracao := :NEW.DATDEF;
				END IF;					
				SP_TAB_ESOCIAL(l_layoutAlteracaoCadastral, :NEW.NUMEMP, l_TipCol, l_NumCad, l_DataAlteracao, NULL, 'R110HDF', 'A', '', l_JsonCamposAlterados, 0, 'R110HDF_EU');
					
				IF ((l_AlterouData = TRUE) AND (:OLD.DATDEF < :NEW.DATDEF)) THEN
					l_DataAlteracao := DATETIMEADD(DD, - 1, :NEW.DATDEF);
					SP_TAB_ESOCIAL(l_layoutAlteracaoCadastral, :NEW.NUMEMP, l_TipCol, l_NumCad, :OLD.DATDEF, l_DataAlteracao, 'R110HDF', 'A', '', l_JsonCamposAlterados, 0, 'R110HDF_EU');
				END IF;
			END IF;
		END IF;
	END IF;
	/* eSocial */
END␀Oß␀␀		SENIOR;0Ó␀␀

TRIGGER R110HDF_ED BEFORE DELETE ON R110HDF FOR EACH ROW DECLARE
    l_temAud       BOOLEAN;
    l_codRPA       NUMBER(15);
    l_codSistema   NUMBER(2);
    l_codcpa       NUMBER(4);
    l_codtpa       NUMBER(4);
    l_datTemp      VARCHAR(10);
  
	l_QtdOriOpe NUMBER;
	l_TipCol NUMBER(1);
	l_NumCad NUMBER(9);
	l_CodDep NUMBER(2);
	l_NumCan NUMBER(7);
	l_TipAtn NUMBER(1);
	l_DataAlteracao DATE;
	l_layout VARCHAR2(6);
	l_layoutAlteracaoCadastral VARCHAR2(6);	
	l_isEmpty BOOLEAN;
BEGIN
  /* Geração de logs Ficha Médica - Deficiências (Tabela: R110HDF)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 97;     /* Ficha Médica - Deficiências (Tabela: R110HDF)*/
  l_codtpa := 308;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110HDF_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIC));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDEF', CONVERT(NUMBER_TO_CHAR, :OLD.CODDEF));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110HDF_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        SP_DATSTR(:OLD.DATDEF, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATDEF', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSDEF', :OLD.OBSDEF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRIDEF', :OLD.PRIDEF);
      END;
  END IF;
  
	RH_RETATNFICMED(:OLD.NumEmp, :OLD.CodFic, :OLD.DatDef, l_TipAtn OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);

	/* Verifica se o campo R110TRI.OriOpe possui registro */
	BEGIN
		SELECT
			COUNT(*)
		INTO
			l_QtdOriOpe
		FROM
			R110TRI;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_QtdOriOpe := 0;
	END;

	/* Se não existe registro na tabela R110TRI então inclui */
	IF (l_QtdOriOpe = 0) THEN
		/* Insere registro na tabela R110TRI */
		RH_SETORIOPE('H');
		
		/* Deleta registro da tabela R110TRI */
		RH_DELORIOPE('H');
	END IF;
	
	/* eSocial */
	IF (l_TipAtn = 1) THEN
		RH_LAYOUTCOLAB(:OLD.NUMEMP, l_TipCol, l_NumCad, l_layout OUT);
		/* Somente irá gerar pendência se o colaborador tiver a admissão fechada */
		IF (l_layout IS NOT NULL) THEN
		    RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
			SP_ISEMPTY_DAT(:OLD.DATDEF, l_isEmpty OUT);
			IF (l_isEmpty = TRUE) THEN
				l_DataAlteracao := CURDATE();
			ELSE
				l_DataAlteracao := :OLD.DATDEF;
			END IF;
			SP_TAB_ESOCIAL(l_layoutAlteracaoCadastral, :OLD.NUMEMP, l_TipCol, l_NumCad, l_DataAlteracao, NULL, 'R110HDF', 'E', '', '', 0, 'R110HDF_ED');
		END IF;
	END IF;
	/* eSocial */
END␀␀␀ºm␀␀␀␀␀␀␀Rß␀␀…¬␀␀´␀	€␀␀␀␀␀␀G;XbXbr␀Æÿ␀␀Ò␀␀␀–,Ì␀	€␀␀␀␀␀␀=§m¹m”)␀␀Æÿ␀␀>ß␀␀␀¹DÑ␀	€␀␀␀␀␀␀xFÙExFqC␀êÿ␀␀ÿ␀␀␀␀0;1;2Uß␀␀		SENIOR;0ú␀␀TRIGGER R110HDO_EI AFTER INSERT ON R110HDO FOR EACH ROW
