	END IF;

	IF (:NEW.FTOPIS <> :OLD.FTOPIS) THEN 
		l_alterou := TRUE;
		l_camposAlterados := l_camposAlterados||'FTOPIS ';
	END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R030EMP_AUD
                   WHERE NUMEMP = :OLD.NUMEMP;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ(l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R030EMP_AUD (SEQREG,VERSEQ,NUMEMP,NOMEMP,APEEMP,SIGEMP,CODPAI,NUMTEL,NUMFAX,CADBOM,TOTCTB,TABEVE,PERADI,
									   MED13S,CPL13S,FECDIG,DSRMEN,GERAFA,ESCHOR,USAVTR,USADEP,USAVLI,FECSAL,USARAT,RATPRV,HORNOT,
									   PAGESC,GRPSOC,PAGANU,FECCOM,DIAHOR,USAPIS,CALSAL,TIPULT,HORFER,ULTPRO,ULTMEN,ULTADT,ULTSEM,
									   ULTQUI,ULT13S,ULTPAR,ENCPRV,BENPRV,SLDPRV,PISPRV,BAIRAT,CTBFER,CTBEFE,TOTPIS,NROCON,ULTRPA,
									   USARAH,POREMP,CMPSIM,SALPRP,USATIM,HOMPAG,HORCTT,CTLDFI,HISFNC,PAGFNC,PROFIX,USAPRF,VACFRE,
