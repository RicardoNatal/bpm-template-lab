        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDIALIC', CONVERT(NUMBER_TO_CHAR, :NEW.DIALIC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDMINFED', CONVERT(NUMBER_TO_CHAR, :OLD.MINFED));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWMINFED', CONVERT(NUMBER_TO_CHAR, :NEW.MINFED));
