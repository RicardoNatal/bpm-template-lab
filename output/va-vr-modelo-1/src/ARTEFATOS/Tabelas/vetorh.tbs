TRIGGER R124HEC_SI AFTER INSERT ON R124HEC

DECLARE
/* CURSOR para buscar os registros que foram inseridos na tabela R124HEC_AUX na trigger EI    */
  /* CURSOR na tabela r124HEC_aux, o nome do CURSOR foi abreviado devido limitação no informix  */
  /* de 18 caracteres para nome de identificadores, foi colocado 14 caracteres no máximo pois a */
  /* svcl adiciona mais 3 caracteres ao final */
  CURSOR C_124HEC_I_AX IS
  SELECT NUMEMP,TIPCOL,NUMCAD,SEQADM,DATCAR,TITCAR,TIPOPE
    FROM R124HEC_AUX
   WHERE TIPOPE = 'I';

  /* RECORD com os campos da tabela R124HEC_AUX */
  TYPE t_r124HEC_aux IS RECORD(
    NUMEMP   R124HEC_AUX.NUMEMP%TYPE,
    TIPCOL   R124HEC_AUX.TIPCOL%TYPE,
    NUMCAD   R124HEC_AUX.NUMCAD%TYPE,
    SEQADM   R124HEC_AUX.SEQADM%TYPE,
    DATCAR   R124HEC_AUX.DATCAR%TYPE,
    TITCAR   R124HEC_AUX.TITCAR%TYPE,
    TIPOPE   R124HEC_AUX.TIPOPE%TYPE);

  l_R124HEC_aux t_R124HEC_aux;

  l_isInformix  BOOLEAN;
BEGIN
  /* Se for informix não pode executar rotina de atualização         */
  /* Existe a limitação do banco e é gerado o erro -747 no informix  */
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN
    /* Busca os registros inserido na AUX */
    FOREACH C_124HEC_I_AX INTO l_r124HEC_aux.NUMEMP,
                               l_r124HEC_aux.TIPCOL,
                               l_r124HEC_aux.NUMCAD,
                               l_r124HEC_aux.SEQADM,
                               l_r124HEC_aux.DATCAR,
                               l_r124HEC_aux.TITCAR,
                               l_r124HEC_aux.TIPOPE
    LOOP
      /* Se o nome não estiver nulo deve ser ajustado na tabela R124HEC */
      /* Este estará nulo quando nenhum ajuste precisa ser feito (Tratado no INSERT da EI na tabela AUX)*/
      IF (l_r124HEC_aux.TITCAR IS NOT NULL) THEN
        BEGIN
          /* Sincroniza o titulo de cargo da tabela R124HEC          */
          /* com o titulo cadastrado no cadastro de Cargos (R024CAR) */
          UPDATE R124HEC
             SET TITCAR = L_R124HEC_AUX.TITCAR
           WHERE NUMEMP = L_R124HEC_AUX.NUMEMP
             AND TIPCOL = L_R124HEC_AUX.TIPCOL
             AND NUMCAD = L_R124HEC_AUX.NUMCAD
             AND SEQADM = L_R124HEC_AUX.SEQADM
             AND DATCAR = L_R124HEC_AUX.DATCAR;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar titulo do Cargo da tabela R124HEC. (R124HEC_SI)';
        END;
      END IF;
    END LOOP;

    /* Apaga os registro da tabela R124HEC_AUX onde o seu tipo de operação for de inclusão */
    BEGIN
      DELETE FROM R124HEC_AUX WHERE TIPOPE = 'I';
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro Exclusão da tabela R124HEC_AUX onde o tipo de operação (TIPOPE) for de inclusão.';
    END;
  END IF;
END␀Ôà␀␀		SENIOR;0ø␀␀TRIGGER R124HEC_EI AFTER INSERT ON R124HEC FOR EACH ROW

DECLARE
l_EstCarPadrao   R126DEF.ESTCAR%TYPE; /* Estrutura Cargo padrão informado na tela de Definições */
  l_CargoPadrao    R126DEF.CODCAR%TYPE; /* Cargo padrão informado na tela de Definições */
  l_TitCarOrig     R124HEC.TITCAR%TYPE; /* Titulo do cargo cadastrado na tabela R024CAR, nome original do Cargo */
  /* Variável para controle do que deve ser sincronizado, se esta variáveis */
  /* estiverem com o valor nulo não será executado update na tabela R124HEC, ou seja, a sincronização não será feita pois o registro já deve está correto */
  l_TitCar         R124HEC.TITCAR%TYPE;
  l_isInformix   BOOLEAN;
BEGIN
  l_TitCar := NULL;

  /* Se for informix não pode executar rotina de atualização         */
  /* Existe a limitação do banco e é gerado o erro -747 no informix  */
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN
    /* SINCRONIZAÇÃO DO TITULO DO CARGO COM O CADASTRO DO CARGO */
    BEGIN
      /* Busca o cargo padrão definido na R126DEF */
      SELECT IFNULL(ESTCAR, 0), IFNULL(CODCAR, '') INTO l_EstCarPadrao,l_CargoPadrao
        FROM R126DEF;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_EstCarPadrao := 0;
        l_CargoPadrao := '';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler o cargo padrão das definições (R126DEF) - (R124HEC_EI)';
    END;

    /* Somente se o cargo informado for diferente do padrão deve prosseguir com o processo de sincronização */
    /* Se não entrar nesta condição a variável l_TitCar continua com o valor nulo */
    IF ((:NEW.ESTCAR <> l_EstCarPadrao) OR (:NEW.CODCAR <> l_CargoPadrao)) THEN
      BEGIN
        /* Busca o titulo do cargo original */
        SELECT TITCAR INTO l_TitCarOrig
          FROM R024CAR
         WHERE ESTCAR = :NEW.ESTCAR
           AND CODCAR = :NEW.CODCAR;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler o cadastro de Cargos (R024CAR) - (R124HEC_EI)';
      END;
      /* Se o titulo de cargo informado para o histórico for diferente do padrão. continua com a sincronização */
      IF (IFNULL(:NEW.TITCAR, ' ') <> l_TitCarOrig) THEN
        /* Atribui o titulo original do cargo para a variável, com isso na SI será substituído o que o usuário */
        /* informou pelo titulo original do cargo. */
        l_TitCar := l_TitCarOrig;
      END IF;
    END IF;

    /* Se l_TitCar não estiver nula, então insere na tabela R124HEC_AUX */
    /* para que na SI seja tratado se deve ser atualizado ou não, se por exemplo a variável l_TitCar */
    /* estiver com o valor nulo, não será sincronizado o titulo do cargo quando chegar na SI */
    IF (l_TitCar IS NOT NULL) THEN
      BEGIN
        INSERT INTO R124HEC_AUX (NUMEMP, TIPCOL, NUMCAD, SEQADM, DATCAR, TITCAR, TIPOPE, FLGCON)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.SEQADM, :NEW.DATCAR, l_TitCar, 'I', 0);
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao inserir na R124HEC_AUX (R124HEC_EI)';
      END;
    END IF;
  END IF;

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
END␀×à␀␀	SENIOR;0␀␀

TRIGGER R124HEC_SU AFTER UPDATE ON R124HEC

DECLARE
/* CURSOR para buscar os registros que foram inseridos na tabela R124HEC_AUX na trigger EU    */
  /* CURSOR na tabela r124HEC_aux, o nome do CURSOR foi abreviado devido limitação no informix  */
  /* de 18 caracteres para nome de identificadores, foi colocado 14 caracteres no máximo pois a */
  /* svcl adiciona mais 3 caracteres ao final */
  CURSOR C_124HEC_U_AX IS
  SELECT NUMEMP,TIPCOL,NUMCAD,SEQADM,DATCAR,TITCAR,TIPOPE
    FROM R124HEC_AUX
   WHERE TIPOPE = 'U';

  /* RECORD com os campos da tabela R124HEC_AUX */
  TYPE t_r124HEC_aux IS RECORD(
    NUMEMP   R124HEC_AUX.NUMEMP%TYPE,
    TIPCOL   R124HEC_AUX.TIPCOL%TYPE,
    NUMCAD   R124HEC_AUX.NUMCAD%TYPE,
    SEQADM   R124HEC_AUX.SEQADM%TYPE,
    DATCAR   R124HEC_AUX.DATCAR%TYPE,
    TITCAR   R124HEC_AUX.TITCAR%TYPE,
    TIPOPE   R124HEC_AUX.TIPOPE%TYPE);

  l_R124HEC_aux t_R124HEC_aux;

  l_Count       NUMBER;
  l_isInformix  BOOLEAN;
BEGIN
  /* Se for informix não pode executar rotina de atualização          */
  /* Existe a limitação do banco e é gerado o erro -747 no informix   */
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN
    /* Garante que está sendo processado a trigger de _SU uma unica vez
       evitando assim LOOP, pois via trigger de SU é feito um update para o mesmo registro. */
    BEGIN
      SELECT COUNT(*) INTO l_Count FROM R124HEC_AUX
       WHERE TIPOPE = 'U' AND FLGCON = 1;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao retornar Flag de Controle da tabela R124HEC_AUX.';
    END;

    /* Se não existe registro com Flag = 1 significa estar passando pela primeira vez na trigger de _SU */
    IF (l_Count  = 0) THEN
      /* Seta flag de controle para 1, evitando que a trigger de _SU seja
         processada em mais de uma instancia, controle necessário para evitar a Recursividade */
      BEGIN
        UPDATE R124HEC_AUX SET FLGCON = 1
         WHERE TIPOPE = 'U';
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro Flag de Controle da tabela R124HEC_AUX.';
      END;

      /* Busca os registros inserido na AUX */
      FOREACH C_124HEC_U_AX INTO l_r124HEC_aux.NUMEMP,
                                 l_r124HEC_aux.TIPCOL,
                                 l_r124HEC_aux.NUMCAD,
                                 l_r124HEC_aux.SEQADM,
                                 l_r124HEC_aux.DATCAR,
                                 l_r124HEC_aux.TITCAR,
                                 l_r124HEC_aux.TIPOPE
      LOOP
        /* Se o titulo não estiver nulo deve ser ajustado na tabela R124HEC */
        /* Este estará nulo quando nenhum ajuste precisa ser feito (Tratado no INSERT da EI na tabela AUX )*/
        IF (l_R124HEC_aux.TITCAR IS NOT NULL) THEN
          BEGIN
            /* Sincroniza o titulo de cargo da tabela R124HEC          */
            /* com o titulo cadastrado no cadastro de Cargos (R024CAR) */
            UPDATE R124HEC
               SET TITCAR = L_R124HEC_AUX.TITCAR
             WHERE NUMEMP = L_R124HEC_AUX.NUMEMP
               AND TIPCOL = L_R124HEC_AUX.TIPCOL
               AND NUMCAD = L_R124HEC_AUX.NUMCAD
               AND SEQADM = L_R124HEC_AUX.SEQADM
               AND DATCAR = L_R124HEC_AUX.DATCAR;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar titulo do cargo na tabela R124HEC. (R124HEC_SU)';
          END;
        END IF;
      END LOOP;

      /* Apaga os registro da tabela R124HEC_AUX onde o seu tipo de operação for de Alteração */
      BEGIN
        DELETE FROM R124HEC_AUX WHERE TIPOPE = 'U';
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro Exclusão da tabela R124HEC_AUX onde o tipo de operação (TIPOPE) for de alteração.';
      END;
    END IF;
  END IF;
END␀Õà␀␀		SENIOR;0!␀␀

TRIGGER R124HEC_EU AFTER UPDATE ON R124HEC FOR EACH ROW

DECLARE
l_EstCarPadrao   R126DEF.ESTCAR%TYPE; /* Estrutura Cargo padrão informado na tela de Definições */
  l_CargoPadrao    R126DEF.CODCAR%TYPE; /* Cargo padrão informado na tela de Definições */
  l_TitCarOrig     R124HEC.TITCAR%TYPE; /* Titulo do cargo cadastrado na tabela R024CAR, nome original do Cargo */
  /* Variável para controle do que deve ser sincronizado, se esta variáveis */
  /* estiverem com o valor nulo não será executado update na tabela R124HEC, ou seja, a sincronização não será feita pois o registro já deve está correto */
  l_TitCar         R124HEC.TITCAR%TYPE;
  l_Count        NUMBER; 
  l_isInformix   BOOLEAN;
BEGIN
  l_TitCar := NULL;

  /* Se for informix não pode executar rotina de atualização do nome outras empresas */
  /* Existe a limitação do banco e é gerado o erro -747 no informix                  */
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN
    /* SINCRONIZAÇÃO DO TITULO DO CARGO COM O CADASTRO DO CARGO */
    BEGIN
      /* Busca o cargo padrão definido na R126DEF */
      SELECT IFNULL(ESTCAR, 0), IFNULL(CODCAR, '') INTO l_EstCarPadrao,l_CargoPadrao
        FROM R126DEF;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_EstCarPadrao := 0;
        l_CargoPadrao := '';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler o cargo padrão das definições (R126DEF) - (R124HEC_EI)';
    END;

    /* Somente se o cargo informado for diferente do padrão deve prosseguir com o processo de sincronização */
    /* Se não entrar nesta condição a variável l_TitCar continua com o valor nulo */
    IF ((IFNULL(:NEW.ESTCAR, 0) <> IFNULL(:OLD.ESTCAR, 0)) OR (IFNULL(:NEW.CODCAR, ' ') <> IFNULL(:OLD.CODCAR, ' ')) OR (IFNULL(:NEW.TITCAR, ' ') <> IFNULL(:OLD.TITCAR, ' '))) THEN
      IF ((IFNULL(:NEW.ESTCAR, 0) <> l_EstCarPadrao) OR (IFNULL(:NEW.CODCAR, ' ') <> l_CargoPadrao)) THEN
        BEGIN
          /* Verifica se existe na _AUX, indica que o processo foi startado via UPDATE NA R024CAR,
             e sendo assim, não se deve executar a rotina abaixo, visto que os valores já estão
             corretos e o SELECT na R024CAR daria erro.                                           */
          SELECT COUNT(*) INTO l_Count
            FROM R024CAR_AUX
           WHERE ESTCAR = :NEW.ESTCAR
             AND CODCAR = :NEW.CODCAR;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler o cadastro de outras empresas (R024CAR_AUX) - (R124HEC_EU)';
        END;

        /* Se não existe registro na _aux */
        IF (l_Count = 0) THEN
          BEGIN
            /* Busca o titulo do cargo original */
            SELECT TITCAR INTO l_TitCarOrig
              FROM R024CAR
             WHERE ESTCAR = :NEW.ESTCAR
               AND CODCAR = :NEW.CODCAR;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler o cadastro de outras empresas (R024CAR) - (R124HEC_EU)';
          END;

          /* Se o titulo do cargo informado para o histórico for diferente do padrão. continua com a sincronização */
          IF (IFNULL(:NEW.TITCAR, ' ') <> l_TitCarOrig) THEN
            /* Atribui o titulo do cargo original para a variável, com isso na SU será substituído o que o usuário */
            /* informou pelo titulo do cargo original. */
            l_TitCar := l_TitCarOrig;
          END IF;
        END IF;
      END IF;
    END IF;

    /* Se l_TITCAR não estiver nula, então insere na tabela R124HEC_AUX */
    /* para que na SU seja tratado se deve ser atualizado ou não, se por exemplo a variável l_TITCAR */
    /* estiver com o valor nulo, não será sincronizado o titulo do cargo quando chegar na SU */
    IF (l_TitCar IS NOT NULL) THEN
      BEGIN
        INSERT INTO R124HEC_AUX (NUMEMP, TIPCOL, NUMCAD, SEQADM, DATCAR, TITCAR, TIPOPE, FLGCON)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.SEQADM, :NEW.DATCAR, l_TitCar, 'U', 0);
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao inserir na R124HEC_AUX (R124HEC_EU)';
      END;
    END IF;
  END IF;

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
END␀Óà␀␀		SENIOR;0␀␀

TRIGGER R124HEC_ED AFTER DELETE ON R124HEC FOR EACH ROW

BEGIN
/* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD);
