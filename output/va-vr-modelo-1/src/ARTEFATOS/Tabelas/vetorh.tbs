+
␀␀CREATE OR REPLACE PROCEDURE R088AGF_ATUCON(P_CRAVEI NUMBER,
                                           P_CRACON NUMBER,
                                           P_DATVAL DATE,
                                           P_HORVAL NUMBER,
                                           P_SITUA  CHAR) IS
  l_icard        CHAR(12);
  l_icardv       CHAR(12);
  l_datahora     CHAR(10);
  l_count        INTEGER;
  l_comando_nulo BOOLEAN;
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_data_zero    DATE;
  /*TELEMÁTICA*/
  l_usutel       VARCHAR2(31);
  l_comando      VARCHAR2(1024);
  l_retnumber    NUMBER(1);
  l_retstr       VARCHAR(1);
  l_reterr       NUMBER(1);
  l_numser       VARCHAR(12);
  l_icardR    	 VARCHAR(12);
begin
  /* TSI */
  SP_USUTEL(l_usutel);    

  l_data_zero := TO_DATE('31/12/1900,00:00:00', 'DD/MM/YYYY,HH24:MI:SS');
  
  /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
  SP_RETICARD(NULL, p_cravei, l_icardv, l_icardR, l_numser);
  SP_RETICARD(NULL, p_cracon, l_icard, l_icardR, l_numser);
  
  SP_DATSTR(p_datval, 'DDMMYY', l_datstr);
  SP_INTSTR(p_horval, 'HHMM', l_horstr);
  if (l_datstr = '311200') then
    l_datstr := '311250';
  end if;
  if (l_horstr = '0000') then
    l_horstr := '2359';
  end if;
  l_datahora     := l_datstr || l_horstr;
  l_comando_nulo := FALSE;

  l_comando := 'SELECT ICARDV FROM '||l_usutel||'CONTVEI WHERE ICARD ='''|| l_icard ||''' AND ICARDV ='''|| l_icardv ||''' ';
  SP_SELTSI(1, 'ICARDV', l_comando, l_retnumber, l_icardv, l_reterr);
    
  IF (l_reterr = 1) THEN
    l_comando_nulo:=TRUE;
  ELSIF (l_reterr = 2) THEN
    l_count := 0;
    raise_application_error(-20000 + - (103),'Erro no CONTVEI - TOO MANY ROWS.');
  ELSIF (l_reterr = 3) THEN
    raise_application_error(-20000 + - (103), 'ON-Line: Erro no SELECT CONTVEI.');
  END IF;
  
  l_comando := 'UPDATE '||l_usutel||'CONTVEI SET SITUA=''1'' WHERE ICARDV = '''|| l_icardv ||''' ';
  SP_CMDTSI(l_comando);
  
  if (p_situa <> '1') then
    if (l_comando_nulo = FALSE) then
      l_comando := 'UPDATE '||l_usutel||'CONTVEI SET DATAHORA='''|| l_datahora ||''', SITUA=''0'' WHERE ICARD = '''|| l_icard ||''' AND ICARDV = '''|| l_icardv ||''' ';
      SP_CMDTSI(l_comando);
    else
      l_comando := 'INSERT INTO '||l_usutel||'CONTVEI (ICARD, ICARDV, DATAHORA, SITUA)';
      l_comando := l_comando||' VALUES ('''|| l_icard ||''','''|| l_icardv ||''','''|| l_datahora ||''',''0'')';
      SP_CMDTSI(l_comando);
    end if;
  end if;
end;	MSSQL;23.SP_DATSTR
SP_INTSTR
SP_USUTEL
SP_RETICARD
Ä␀␀CREATE  PROCEDURE R088AGF_ATUCON(@p_cravei FLOAT, @p_cracon FLOAT, @p_datval DATETIME, @p_horval FLOAT, @p_situa CHAR) AS
BEGIN
DECLARE @l_icard CHAR(12)
DECLARE @l_icardv CHAR(12)
DECLARE @l_datahora CHAR(10)
DECLARE @l_count INTEGER
DECLARE @l_comando_nulo NUMERIC(1,0)
DECLARE @l_datstr CHAR(6)
DECLARE @l_horstr CHAR(4)
DECLARE @l_data_zero DATETIME
DECLARE @l_usutel VARCHAR(31)
DECLARE @l_comando VARCHAR(1024)
DECLARE @l_retnumber SMALLINT
DECLARE @l_retstr VARCHAR(1)
DECLARE @l_reterr SMALLINT
DECLARE @l_numser VARCHAR(12);
DECLARE @l_icardR VARCHAR(12);

DECLARE @ChkError INTEGER

  SELECT @ChkError = 0
  EXECUTE  @ChkError = SP_USUTEL @l_usutel OUTPUT
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  SELECT @l_data_zero =  CONVERT(DATETIME,'12/31/1900 00:00:00', 101)
  EXECUTE  @ChkError = SP_RETICARD NULL,@p_cravei,@l_icardv OUTPUT,@l_icardR OUTPUT,@l_numser OUTPUT
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  EXECUTE  @ChkError = SP_RETICARD NULL,@p_cracon,@l_icard OUTPUT,@l_icardR OUTPUT,@l_numser OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  EXECUTE  @ChkError = SP_DATSTR @p_datval,'DDMMYY',@l_datstr OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  EXECUTE  @ChkError = SP_INTSTR @p_horval,'HHMM',@l_horstr OUTPUT  
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  IF (@l_datstr='311200')
  BEGIN
    SELECT @l_datstr = '311250'
  END
  IF (@l_horstr='0000')
  BEGIN
    SELECT @l_horstr = '2359'
  END
  SELECT @l_datahora = @l_datstr+@l_horstr
  SELECT @l_comando_nulo = 0
  SELECT @l_comando = 'SELECT ICARDV FROM '+@l_usutel+'CONTVEI WHERE ICARD ='''+@l_icard+''' AND ICARDV ='''+@l_icardv+''' '
  EXECUTE  @ChkError = SP_SELTSI 1,'ICARDV',@l_comando,@l_retnumber OUTPUT ,@l_icardv OUTPUT ,@l_reterr OUTPUT  
    IF @ChkError <> 0
    BEGIN
    GOTO FIM
    END
    
  IF (@l_reterr=1)
  BEGIN
    SELECT @ChkError = 0
    SELECT @l_comando_nulo = 1
  END
  ELSE IF (@l_reterr=2)
  BEGIN
    SELECT @l_count = 0
    RAISERROR('Erro no CONTVEI - TOO MANY ROWS.',11,1) WITH SETERROR
    SELECT @ChkError = -30
    GOTO FIM
  END
  ELSE IF (@l_reterr=3)
  BEGIN
    RAISERROR('ON-Line: Erro no Select CONTVEI.',11,1) WITH SETERROR
    SELECT @ChkError = -30
    GOTO FIM
  END
    
  SELECT @l_comando = 'UPDATE '+@l_usutel+'CONTVEI SET SITUA=''1'' WHERE ICARDV = '''+@l_icardv+''' '
  EXECUTE  @ChkError = SP_CMDTSI @l_comando 
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  IF (@p_situa<>'1')
  BEGIN
    IF (@l_comando_nulo=0)
    BEGIN
      SELECT @l_comando = 'UPDATE '+@l_usutel+'CONTVEI SET DATAHORA='''+@l_datahora+''', SITUA=''0'' WHERE ICARD = '''+@l_icard+''' AND ICARDV = '''+@l_icardv+''' '
      EXECUTE  @ChkError = SP_CMDTSI @l_comando 
      IF @ChkError <> 0
      BEGIN
        GOTO FIM
      END
    END
    ELSE
    BEGIN
      SELECT @l_comando = 'INSERT INTO '+@l_usutel+'CONTVEI (ICARD, ICARDV, DATAHORA, SITUA)'
      SELECT @l_comando = @l_comando+' VALUES ('''+@l_icard+''','''+@l_icardv+''','''+@l_datahora+''',''0'')'
      EXECUTE  @ChkError = SP_CMDTSI @l_comando 
      IF @ChkError <> 0
      BEGIN
        GOTO FIM
      END
    END
  END
FIM:
  RETURN @ChkError
END␀KÜ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
