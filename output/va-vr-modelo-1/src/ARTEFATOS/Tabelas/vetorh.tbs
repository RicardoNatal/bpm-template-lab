TRIGGER R134CNF_EI AFTER INSERT ON R134CNF FOR EACH ROW

DECLARE
l_QtdReg   NUMBER;
 xDatZer    DATE;
BEGIN
  xDatZer := DATETIME(31,12,1900,0,0,0);

  SELECT COUNT(*) INTO l_QtdReg FROM R134DRE
   WHERE CODCUA = :NEW.CODCUA AND TMACUA = :NEW.TMACUA AND NUMEMP = :NEW.EMPPAR
     AND TIPCOL = :NEW.TIPPAR AND NUMCAD = :NEW.CADPAR;

  IF (l_QtdReg = 0) THEN
    BEGIN
      INSERT INTO R134DRE (CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, CONEMI, CEREMI, FREEMI, TABORG, NUMLOC, DATINS, DATTER)
           VALUES (:NEW.CODCUA, :NEW.TMACUA, :NEW.EMPPAR, :NEW.TIPPAR, :NEW.CADPAR, 'N', 'N', 'N', :NEW.TABORG, :NEW.NUMLOC, xDatZer, xDatZer);
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na Inclusão do Participante da Turma de Treinamento.';
    END;
  END IF;
END␀ğá␀␀		SENIOR;0z␀␀

TRIGGER R134CNF_ED AFTER DELETE ON R134CNF FOR EACH ROW

BEGIN
BEGIN
    DELETE FROM R134DRE WHERE CODCUA = :OLD.CODCUA AND TMACUA = :OLD.TMACUA AND NUMEMP = :OLD.EMPPAR
                          AND TIPCOL = :OLD.TIPPAR AND NUMCAD = :OLD.CADPAR;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro na Exclusão do Participante da Turma de Treinamento.';
  END;
