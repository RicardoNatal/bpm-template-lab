        END
        SELECT @l_idtpes = @l_tippes+@l_tipdoc+@l_numdoc
        SELECT @l_idtpes = LTRIM(@l_idtpes)
        SELECT @l_idtpes = RTRIM(@l_idtpes)
        WHILE 1=1
        BEGIN
          IF (DATALENGTH(@l_idtpes)>22)
          BEGIN
            BREAK
          END
          SELECT @l_idtpes = ' '+@l_idtpes
        END
        EXECUTE  @ChkError = SP_RETFON @l_idtpes,@l_nompes OUTPUT ,@l_ddifon OUTPUT ,@l_dddfon OUTPUT ,@l_numfon OUTPUT  
        IF @ChkError <> 0
        BEGIN
          CLOSE CUR_r090vis_UPD_OLD
          DEALLOCATE CUR_r090vis_UPD_OLD
          CLOSE CUR_r090vis_UPD_NEW
          DEALLOCATE CUR_r090vis_UPD_NEW
          GOTO FIM
        END
        UPDATE r070con SET 
      nompes=@l_nompes,ddifon=@l_ddifon,dddfon=@l_dddfon,numfon=@l_numfon 
       WHERE idtpes=@l_idtpes
        SELECT @ChkError = @@Error
        IF @ChkError <> 0
        BEGIN
          CLOSE CUR_r090vis_UPD_OLD
          DEALLOCATE CUR_r090vis_UPD_OLD
          CLOSE CUR_r090vis_UPD_NEW
          DEALLOCATE CUR_r090vis_UPD_NEW
          GOTO FIM
        END
      END
    END
    SELECT @l_auditoria = 'N'
    EXECUTE  @ChkError = SP_AUDVER @l_auditoria OUTPUT ,'R090VIS' 
    IF @ChkError <> 0
