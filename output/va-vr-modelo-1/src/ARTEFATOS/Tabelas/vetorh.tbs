			l_datfim := DATETIME(31, 12, 2050, 0, 0, 0);		
		END IF;
		
		IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
			l_datval := DATETIME(31, 12, 2050, 0, 0, 0);		
			l_horval := 1439;
		END IF;
		
		/*VALIDA A MENOR DAS DUAS DATAS - HISTÓRICO - AUTORIZAÇÃO*/
		IF (l_datval > l_datfim) THEN
			l_datval := l_datfim;
			l_horval := 1439;	
		END IF;

		IF (l_cracha <> 0) AND (l_cravei <> 0) THEN
			SP_VEIPESCON('U', l_cravei, l_cracha, l_situa, :NEW.PLAVEI, 
						 l_datval, l_horval, :NEW.TCLCON, :NEW.EMPCON, :NEW.TCLCON, :NEW.CADCON, 0, '');
		END IF;
	END IF;
END␀LÜ␀␀		SENIOR;0R␀␀

TRIGGER R088AUT_ED AFTER DELETE ON R088AUT FOR EACH ROW

DECLARE
l_online       BOOLEAN;
  l_cravei       NUMBER(12);
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_froonl       BOOLEAN;
  l_hora_atual   NUMBER(4);
  l_data_atual   DATE;
  l_situa        NUMBER(1);
  l_data_zero    DATE;
  l_libvei       NUMBER(1);
BEGIN
	l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
	l_data_atual := CURDATE();
	SP_VerOnLine(l_online OUT);
	SP_UsaFronline(l_froonl OUT, l_libvei OUT);
	IF   (l_online = TRUE) AND (l_froonl = TRUE) AND (l_libvei = 1) THEN
		l_data_zero :=  DATETIME(31, 12, 1900, 0, 0, 0);
		BEGIN
			SELECT NUMCRA INTO l_cravei
				FROM R088HCH
				WHERE PLAVEI = :OLD.PLAVEI
					  AND ((DATINI <= :OLD.DATINI) AND (DATFIM >= :OLD.DATINI
					 OR DATFIM = l_data_zero)) AND STAACC = 1;
		EXCEPTION
			WHEN TOO_MANY_ROWS THEN
			  RAISERROR 103 'Erro no R088HCH - TOO MANY ROWS.';
			WHEN NO_DATA_FOUND THEN
			  l_cravei := 0;
			WHEN OTHERS THEN
			  RAISERROR 103 'Erro no SELECT em R088HCH.';
		END;
		/* Se tiver crachá provísório vale ele. senão pegar o titular */
		SP_RETCRA (2, :OLD.EMPCON, :OLD.TCLCON, :OLD.CADCON,0,'',0,'', l_crapro OUT);
		l_situa := 1;
		IF   (l_crapro = 0)  THEN
			SP_RETCRA (1, :OLD.EMPCON, :OLD.TCLCON, :OLD.CADCON,0,'',0,'', l_cracha OUT);
		ELSE  
			l_cracha := l_crapro;
		END IF;

		IF (l_cracha <> 0) AND (l_cravei <> 0) THEN
			SP_VEIPESCON('D', l_cravei, l_cracha, l_situa, :OLD.PLAVEI, 
						 l_data_atual, 0, :OLD.TCLCON, :OLD.EMPCON, :OLD.TCLCON, :OLD.CADCON, 0, '');
		END IF;
	END IF;
END␀␀␀Î␀␀␀␀␀␀␀␀␀␀OÜ␀␀ZÂ␀␀	␀␀␀␀␀␀}Â␀␀\Â␀␀\Â␀␀\␀Èˆ␀␀ÿ␀␀õÜ␀␀␀EÑ␀	␀␀␀␀␀␀CK¢G£GqCˆ␀êÿ␀␀ÿ␀¤w·␀	␀␀␀␀␀␀yˆxˆxì*␀ˆ␀Æÿ␀␀ÿ␀…¬␀␀´␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀:,␀␀␀␀␀␀æ:))b␀”‡␀␀ÿ␀␀)`␀åDÑ␀␀␀␀␀␀␀$GÔFÔFqCˆ␀êÿ␀␀ÿ␀w·␀␀␀␀␀␀␀Xx<x<xì*␀ˆ␀Æÿ␀␀ÿ␀␀␀␀0;1;2␀␀Èv␀␀␀␀␀␀␀PÜ␀␀Ëœ␀␀	␀␀␀␀␀␀Ôœ␀␀Ñœ␀␀Ñœ␀␀_␀Æˆ␀␀ÿ␀␀Ü␀␀␀Œ ␀␀	␀␀␀␀␀␀Z¡␀␀Ÿ ␀␀Ÿ ␀␀_␀␀␀ÿ␀␀™Ü␀␀␀,-¼␀	␀␀␀␀␀␀’=Ÿ:Õ;v␀Æÿ␀␀°Ü␀␀␀c½␀␀Á␀␀␀␀␀␀␀Á␀␀Á␀␀Á␀␀y␀Æÿ␀␀ÿ␀Ÿ½␀␀Á␀␀␀␀␀␀␀ÅÍ␀␀—␀␀ÅÍ␀␀y␀Æÿ␀␀ÿ␀]³␀␀€␀␀␀␀␀␀␀,´␀␀ñ³␀␀ñ³␀␀!|ˆ␀␀ÿ␀␀ÿ␀␀␀␀0;1;2␀␀·œ␀␀␀␀␀␀␀␀QÜ␀␀,␀­␀	␀␀␀␀␀␀M␀M␀M␀p␀Æÿ␀␀RÜ␀␀␀FTU␀␀␀␀␀␀ŒW°VÎVV␀␀ÿ␀␀ÿ␀␀␀␀0␀␀‹␀␀␀SÜ␀␀Öa´␀	”␀␀␀␀␀␀q>šaˆbr␀Æÿ␀␀Ò␀␀␀>␀t	”␀␀␀␀␀␀R␀ÿ␀ÿ␀n␀Æÿ␀␀ˆÓ␀␀␀C$Ì␀	”␀␀␀␀␀␀M%$™$w␀Æÿ␀␀…Ó␀␀␀N␀´␀”␀␀␀␀␀␀˜␀˜␀˜␀r␀Æÿ␀␀íĞ␀␀␀o¬␀␀(”␀␀␀␀␀␀¾±␀␀¯␀␀¯␀␀d␀␀␀ÿ␀␀ÿ␀R(T”␀␀␀␀␀␀y(e(e(p␀␀␀ÿ␀␀ÿ␀DÑ␀”␀␀␀␀␀␀J!_MqC␀êÿ␀␀ÿ␀U%␀Ñ␀”␀␀␀␀␀␀‚M^%␀c%␀qC␀êÿ␀␀ÿ␀ı␀␀­␀”␀␀␀␀␀␀‚ÿ␀␀‚ÿ␀␀‚ÿ␀␀p␀Æÿ␀␀ÿ␀␀␀␀0;1;2␀␀‘2␀␀␀␀␀␀␀␀␀TÜ␀␀7‹␀␀3	␀␀␀␀␀␀bŠ␀␀YŠ␀␀bŠ␀␀4␀␀ÿ␀␀ÿ␀¬␀␀–␀	␀␀␀␀␀␀¯␀␀68¯␀␀c␀Æÿ␀␀ÿ␀4	␀	␀␀␀␀␀␀B	␀;	␀B	␀n␀Æÿ␀␀ÿ␀ZÂ␀␀	␀␀␀␀␀␀}Â␀␀zÂ␀␀}Â␀␀\␀␀␀ÿ␀␀ÿ␀(8–␀␀␀␀␀␀␀I8C8I8c␀Æÿ␀␀ÿ0ÌE␀␀␀␀␀␀ªKöHªK%␀␀ÿ␀␀ÿ␀(␀­␀␀␀␀␀␀␀b␀b␀b␀p␀Æÿ␀␀ÿ␀´1=␀␀␀␀␀␀T»␀␀O»␀␀T»␀␀+␀␀ÿ␀␀ÿNH%␀=␀␀␀␀␀␀&␀&␀&␀+␀␀ÿ␀␀ÿN␀␀UÜ␀␀␀VÜ␀␀␀WÜ␀␀␀␀XÜ␀␀␀␀0;1;2;3ZÜ␀␀		SENIOR;0ô␀␀

TRIGGER R088CON_EI AFTER INSERT ON R088CON FOR EACH ROW

DECLARE
l_online BOOLEAN;
BEGIN
	SP_VERONLINE(l_online OUT);
	/*SOMENTE VERSÃO ONLINE*/
	IF (l_online = TRUE) THEN
		BEGIN
			/*Gera pendência para SDK - UPDATEVehicleWithPerson*/
			SP_PEND75('I', :NEW.IDTPES, :NEW.TECCRA, :NEW.NUMFIS, :NEW.PLAVEI, :NEW.CRAVEI, :NEW.DATVAL, :NEW.SITCRA, :NEW.CONLPR, :NEW.VEIFRO);
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'R088CON: Erro ao inserir controle.';
		END;
	END IF;
END␀[Ü␀␀		SENIOR;0ù␀␀

