	␀␀/* 
 * Retorna informações do histórico de vínculo do colaborador conforme parâmetros:
 * p_NumEmp - Empresa do colaborador
 * p_TipCol - Tipo do colaborador
 * p_NumCad - Cadastro do colaborador
 * p_DatRef - Data de referência
 * p_OpcHis - "A" = Anterior ou "P" = Próximo
 * p_DatAlt - Retorna a data do histórico encontrado
 * p_CodVin - Retorna código do vínculo encontrado
 */
PROCEDURE RH_RETVINCOL(p_NumEmp NUMBER(4), p_TipCol NUMBER(1), p_NumCad NUMBER(9), p_DatRef DATE, p_OpcHis VARCHAR2(1), p_DatAlt OUT DATE, p_CodVin OUT NUMBER(2)) IS

	l_DatZer DATE;
	l_DatAlt DATE;
	l_CodVin NUMBER;
BEGIN
	l_DatZer := '31/12/1900,00:00:00';

	/* Retorna informações do último histórico de vínculo antes da data de referência */
	IF (p_OpcHis = 'A') THEN
  		BEGIN
    		SELECT HVI.DatAlt, HVI.CodVin INTO l_DatAlt, l_CodVin
      		  FROM R038HVI HVI
	 		 WHERE HVI.NumEmp = p_NumEmp
	   		   AND HVI.TipCol = p_TipCol
	   		   AND HVI.NumCad = p_NumCad
	   		   AND HVI.DatAlt = (SELECT MAX(HVI2.DATALT) 
	   		   				       FROM R038HVI HVI2
	   		   				      WHERE HVI2.NumEmp = HVI.NumEmp
	   		   				        AND HVI2.TipCol = HVI.TipCol
	   		   				        AND HVI2.NumCad = HVI.NumCad
	   		   				        AND HVI2.DatAlt <= p_DatRef);
  		EXCEPTION
    		WHEN NO_DATA_FOUND THEN
  	  			l_DatAlt := l_DatZer;
  	  			l_CodVin := 0;
    		WHEN OTHERS THEN
      			RAISERROR 103 'Erro ao buscar histórico de vínculo anterior.';
  		END;
	END IF;
	
	/* Retorna informações do próximo histórico de vínculo depois da data de referência */
	IF (p_OpcHis = 'P') THEN
  		BEGIN
    		SELECT HVI.DatAlt, HVI.CodVin INTO l_DatAlt, l_CodVin
      		  FROM R038HVI HVI
	 		 WHERE HVI.NumEmp = p_NumEmp
	   		   AND HVI.TipCol = p_TipCol
	   		   AND HVI.NumCad = p_NumCad
	   		   AND HVI.DatAlt = (SELECT MIN(HVI2.DATALT) 
	   		   				       FROM R038HVI HVI2
	   		   				      WHERE HVI2.NumEmp = HVI.NumEmp
	   		   				        AND HVI2.TipCol = HVI.TipCol
	   		   				        AND HVI2.NumCad = HVI.NumCad
	   		   				        AND HVI2.DatAlt > p_DatRef);
  		EXCEPTION
    		WHEN NO_DATA_FOUND THEN
  	  			l_DatAlt := l_DatZer;
  	  			l_CodVin := 0;
    		WHEN OTHERS THEN
      			RAISERROR 103 'Erro ao buscar próximo histórico de vínculo.';
  		END;
	END IF;
	
	p_DatAlt := l_DatAlt;
	p_CodVin := l_CodVin;
END	ORACLE;0
\␀␀create or replace PROCEDURE RH_RETVINCOL(p_NumEmp NUMBER,p_TipCol NUMBER,p_NumCad NUMBER,p_DatRef DATE,p_OpcHis VARCHAR2,p_DatAlt OUT DATE,p_CodVin OUT NUMBER) IS
  PRAGMA AUTONOMOUS_TRANSACTION;
  l_DatZer DATE;
  l_DatAlt DATE;
  l_CodVin NUMBER;
begin
  l_DatZer :=  TO_DATE('31/12/1900,00:00:00','DD/MM/YYYY,HH24:MI:SS');
  if (p_OpcHis='A') then
    begin
      SELECT 
      HVI.DatAlt HVI_DatAlt,HVI.CodVin HVI_CodVin
       INTO l_DatAlt,l_CodVin 
       FROM R038HVI HVI
       WHERE HVI.NumEmp=p_NumEmp 
      AND HVI.TipCol=p_TipCol 
      AND HVI.NumCad=p_NumCad 
      AND HVI.DatAlt=(SELECT 
      MAX(HVI2.DATALT) EXPR98022303
       FROM R038HVI HVI2
       WHERE HVI2.NumEmp=HVI.NumEmp 
      AND HVI2.TipCol=HVI.TipCol 
      AND HVI2.NumCad=HVI.NumCad 
      AND HVI2.DatAlt<=p_DatRef );
    exception
      when NO_DATA_FOUND then
        l_DatAlt := l_DatZer;
        l_CodVin := 0;
      when OTHERS then
        raise_application_error(-20000 + -(103),'Erro ao buscar histórico de vínculo anterior.');
    end;
  end if;
  if (p_OpcHis='P') then
    begin
      SELECT 
      HVI.DatAlt HVI_DatAlt,HVI.CodVin HVI_CodVin
       INTO l_DatAlt,l_CodVin 
       FROM R038HVI HVI
       WHERE HVI.NumEmp=p_NumEmp 
      AND HVI.TipCol=p_TipCol 
      AND HVI.NumCad=p_NumCad 
      AND HVI.DatAlt=(SELECT 
      MIN(HVI2.DATALT) EXPR1041447062
       FROM R038HVI HVI2
       WHERE HVI2.NumEmp=HVI.NumEmp 
      AND HVI2.TipCol=HVI.TipCol 
      AND HVI2.NumCad=HVI.NumCad 
      AND HVI2.DatAlt>p_DatRef );
    exception
      when NO_DATA_FOUND then
        l_DatAlt := l_DatZer;
        l_CodVin := 0;
      when OTHERS then
        raise_application_error(-20000 + -(103),'Erro ao buscar próximo histórico de vínculo.');
    end;
  end if;
  p_DatAlt := l_DatAlt;
  p_CodVin := l_CodVin;
end RH_RETVINCOL;␀ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
X␀␀PROCEDURE RH_RET_CODLOC(P_TABORG NUMBER(4), P_NUMLOC NUMBER(9), P_DATALT DATE, P_CODLOC OUT VARCHAR2(150))
 IS

    xCodLoc   R016HIE.CODLOC%TYPE;
    l_datzer   DATE;    
BEGIN    
    l_datzer  := '31/12/1900,00:00:00';
    BEGIN
      SELECT CODLOC INTO xCodLoc 
        FROM R016HIE 
       WHERE TABORG = P_TABORG AND NUMLOC = P_NUMLOC AND (DATINI <= P_DATALT AND (DATFIM >= P_DATALT OR DATFIM = l_datzer));
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        xCodLoc := ' ';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao buscar o Código do Local.';
    END;
    P_CODLOC := xCodLoc;
END␀ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_INITEMPTY_DAT
␀␀PROCEDURE RH_RET_DATADM(P_NUMEMP NUMBER(4), P_TIPCOL NUMBER(1), P_NUMCAD NUMBER(9), P_DATADM OUT DATE)
IS

	l_DatAdm DATE;
BEGIN
