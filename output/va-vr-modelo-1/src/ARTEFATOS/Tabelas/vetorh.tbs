i␀␀CREATE  PROCEDURE sp_qtdprv(@p_IdtPes CHAR(23), @p_QtdPrv SMALLINT OUTPUT) AS
BEGIN
DECLARE @l_qtdprv SMALLINT
DECLARE @l_datzer DATETIME
DECLARE @l_fimmes DATETIME
DECLARE @l_inimes DATETIME
DECLARE @l_numemp SMALLINT
DECLARE @l_tipcol SMALLINT
DECLARE @l_numcad INTEGER
DECLARE @l_tipdoc SMALLINT
DECLARE @l_numdoc VARCHAR(20)
DECLARE @l_nummat VARCHAR(15)
DECLARE @l_propac VARCHAR(20)
DECLARE @l_tippes SMALLINT
DECLARE @l_conprc CHAR(1)
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @SE_EXC2 INTEGER
  DECLARE @SE_EXC3 INTEGER
  SELECT @ChkError = 0
  SELECT @l_QtdPrv = 0
  SELECT @p_QtdPrv = 0
  SELECT @l_datzer =  CONVERT(DATETIME,'12/31/1900 00:00:00', 101)
  SELECT @l_conprc = 'N'
  /* TRY */
    SELECT 
      @l_conprc=r058dcr.conprc 
       FROM r058dcr r058dcr
    SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
    IF @ChkError <> 0
    BEGIN
      GOTO EXC1
    END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC1:
    SELECT @SE_EXC1 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        SELECT @l_conprc = 'N'
      END
    END
  /* END EXCEPTION HANDLER */
  IF (@l_conprc='S')
  BEGIN
    /* TRY */

      SELECT @l_inimes = DATEADD(mm, DATEDIFF(mm, 0, GETDATE()), 0)

      SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
      IF @ChkError <> 0
      BEGIN
        GOTO EXC2
      END

      SELECT @l_fimmes = DATEADD(MONTH, DATEDIFF(MONTH, 0, getdate()) + 1, 0) - 1
      
      SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
      IF @ChkError <> 0
      BEGIN
        GOTO EXC2
      END
    /* END TRY */
    /* BEGIN EXCEPTION HANDLER */
      EXC2:
      SELECT @SE_EXC2 = @ChkError
      IF @ChkError <> 0
      BEGIN
        BEGIN
          SELECT @ChkError = 0
          BEGIN
            RAISERROR('Procedure SP_QTDPRV. Erro na conversão de datas.',11,1) WITH SETERROR
            SELECT @ChkError = -30
            GOTO FIM
          END
        END
      END
    /* END EXCEPTION HANDLER */
    EXECUTE  @ChkError = SP_PESFROMIDTPES @p_idtpes,@l_tippes OUTPUT ,@l_numemp OUTPUT ,@l_tipcol OUTPUT ,@l_numcad OUTPUT ,@l_tipdoc OUTPUT ,@l_numdoc OUTPUT ,@l_nummat OUTPUT ,@l_propac OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    IF (@l_tippes<4)
    BEGIN
      /* TRY */
        SELECT 
      @l_qtdPrv=COUNT(*) 
       FROM r038hch r038hch
       WHERE numemp=@l_numemp 
      and tipcol=@l_tipcol 
      and numcad=@l_numcad 
      and tipcra=2 
      and datini>=@l_inimes 
      and datini<=@l_fimmes 
      and (datfim<=@l_fimmes 
      or datfim=@l_datzer)
        SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
        IF @ChkError <> 0
        BEGIN
          GOTO EXC3
        END
      /* END TRY */
      /* BEGIN EXCEPTION HANDLER */
        EXC3:
        SELECT @SE_EXC3 = @ChkError
        IF @ChkError <> 0
        BEGIN
          BEGIN
            SELECT @ChkError = 0
            SELECT @l_qtdPrv = 0
          END
        END
      /* END EXCEPTION HANDLER */
    END
    ELSE
    BEGIN
      SELECT @l_qtdPrv = 0
    END
  END
  ELSE
  BEGIN
    SELECT @l_qtdPrv = 0
  END
  SELECT @p_QtdPrv = @l_qtdPrv
FIM:
  RETURN @ChkError
END



	MSSQL;23SP_PESFROMIDTPES
i␀␀CREATE  PROCEDURE sp_qtdprv(@p_IdtPes CHAR(23), @p_QtdPrv SMALLINT OUTPUT) AS
BEGIN
DECLARE @l_qtdprv SMALLINT
DECLARE @l_datzer DATETIME
DECLARE @l_fimmes DATETIME
DECLARE @l_inimes DATETIME
DECLARE @l_numemp SMALLINT
DECLARE @l_tipcol SMALLINT
DECLARE @l_numcad INTEGER
DECLARE @l_tipdoc SMALLINT
DECLARE @l_numdoc VARCHAR(20)
DECLARE @l_nummat VARCHAR(15)
DECLARE @l_propac VARCHAR(20)
DECLARE @l_tippes SMALLINT
DECLARE @l_conprc CHAR(1)
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @SE_EXC2 INTEGER
  DECLARE @SE_EXC3 INTEGER
  SELECT @ChkError = 0
  SELECT @l_QtdPrv = 0
  SELECT @p_QtdPrv = 0
  SELECT @l_datzer =  CONVERT(DATETIME,'12/31/1900 00:00:00', 101)
  SELECT @l_conprc = 'N'
  /* TRY */
    SELECT 
      @l_conprc=r058dcr.conprc 
       FROM r058dcr r058dcr
    SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
    IF @ChkError <> 0
    BEGIN
      GOTO EXC1
    END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC1:
    SELECT @SE_EXC1 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        SELECT @l_conprc = 'N'
      END
    END
  /* END EXCEPTION HANDLER */
  IF (@l_conprc='S')
  BEGIN
    /* TRY */

      SELECT @l_inimes = DATEADD(mm, DATEDIFF(mm, 0, GETDATE()), 0)

      SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
      IF @ChkError <> 0
      BEGIN
        GOTO EXC2
      END

      SELECT @l_fimmes = DATEADD(MONTH, DATEDIFF(MONTH, 0, getdate()) + 1, 0) - 1
      
      SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
      IF @ChkError <> 0
      BEGIN
        GOTO EXC2
      END
    /* END TRY */
    /* BEGIN EXCEPTION HANDLER */
      EXC2:
      SELECT @SE_EXC2 = @ChkError
      IF @ChkError <> 0
      BEGIN
        BEGIN
          SELECT @ChkError = 0
          BEGIN
            RAISERROR('Procedure SP_QTDPRV. Erro na conversão de datas.',11,1) WITH SETERROR
            SELECT @ChkError = -30
            GOTO FIM
          END
        END
      END
    /* END EXCEPTION HANDLER */
    EXECUTE  @ChkError = SP_PESFROMIDTPES @p_idtpes,@l_tippes OUTPUT ,@l_numemp OUTPUT ,@l_tipcol OUTPUT ,@l_numcad OUTPUT ,@l_tipdoc OUTPUT ,@l_numdoc OUTPUT ,@l_nummat OUTPUT ,@l_propac OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    IF (@l_tippes<4)
    BEGIN
      /* TRY */
        SELECT 
      @l_qtdPrv=COUNT(*) 
       FROM r038hch r038hch
       WHERE numemp=@l_numemp 
      and tipcol=@l_tipcol 
      and numcad=@l_numcad 
      and tipcra=2 
      and datini>=@l_inimes 
      and datini<=@l_fimmes 
      and (datfim<=@l_fimmes 
      or datfim=@l_datzer)
        SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
        IF @ChkError <> 0
        BEGIN
          GOTO EXC3
        END
      /* END TRY */
      /* BEGIN EXCEPTION HANDLER */
        EXC3:
        SELECT @SE_EXC3 = @ChkError
        IF @ChkError <> 0
        BEGIN
          BEGIN
            SELECT @ChkError = 0
            SELECT @l_qtdPrv = 0
          END
        END
      /* END EXCEPTION HANDLER */
    END
    ELSE
    BEGIN
      SELECT @l_qtdPrv = 0
    END
  END
  ELSE
  BEGIN
    SELECT @l_qtdPrv = 0
  END
  SELECT @p_QtdPrv = @l_qtdPrv
FIM:
  RETURN @ChkError
END



	POSTGRESQL;24SP_PESFROMIDTPES
×␀␀CREATE OR REPLACE PROCEDURE SP_QTDPRV(p_IdtPes IN CHAR,p_QtdPrv IN OUT SMALLINT)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  l_QtdPrv SMALLINT;
  l_datzer TIMESTAMP;
  l_fimmes TIMESTAMP;
  l_inimes TIMESTAMP;
  l_numemp SMALLINT;
  l_tipcol SMALLINT;
  l_numcad INTEGER;
  l_tipdoc SMALLINT;
  l_numdoc VARCHAR(20);
  l_nummat VARCHAR(15);
  l_propac VARCHAR(20);
  l_tippes SMALLINT;
  l_conprc CHAR(1);

BEGIN
  l_QtdPrv := 0;
  p_QtdPrv := 0;
  l_datzer :=  TO_DATE('31/12/1900,00:00:00','DD/MM/YYYY,HH24:MI:SS');
  l_conprc := 'N';
  begin
    SELECT 
      R058DCR.CONPRC CONPRC
       INTO l_conprc 
       FROM R058DCR R058DCR;
  exception
    when OTHERS then
      l_conprc := 'N';
  end;
  if (l_conprc='S') then
    begin
      select (date_trunc('month', now()))::date into l_inimes;
	  select (date_trunc('month', now()) + interval '1 month - 1 day')::date into l_fimmes;
    exception
      when OTHERS then
       RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'Procedure SP_QTDPRV. Erro na conversão de datas.';
    end;
    CALL SP_PESFROMIDTPES(p_idtpes,l_tippes,l_numemp,l_tipcol,l_numcad,l_tipdoc,l_numdoc,l_nummat,l_propac);
    if (l_tippes<4) then
      begin
        SELECT 
      COUNT(*) EXPR1288330502
       INTO l_qtdPrv 
       FROM R038HCH R038HCH
       WHERE NUMEMP=l_numemp 
      AND TIPCOL=l_tipcol 
      AND NUMCAD=l_numcad 
      AND TIPCRA=2 
      AND DATINI>=l_inimes 
      AND DATINI<=l_fimmes 
      AND (DATFIM<=l_fimmes 
      OR DATFIM=l_datzer);
      exception
        when OTHERS then
          l_qtdPrv := 0;
      end;
    else
      l_qtdPrv := 0;
    end if;
  else
    l_qtdPrv := 0;
  end if;
  p_QtdPrv := l_qtdPrv;
END;
$BODY$;␀–ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
cPROCEDURE SP_R022NOT(P_CODNOT NUMBER(3), P_USOTRF CHAR(1), P_BASLEG NUMBER(1))
IS
BEGIN
  NULL;
END	ORACLE;0
¼␀␀CREATE OR REPLACE PROCEDURE SP_R022NOT(P_CODNOT NUMBER,P_USOTRF CHAR,P_BASLEG NUMBER) IS
  PRAGMA AUTONOMOUS_TRANSACTION;
  l_RegistroExistente NUMBER;
begin
  if (P_USOTRF='S') then
    SELECT 
      COUNT(*) EXPR1956031457
       INTO l_RegistroExistente 
       FROM R022NOT R022NOT
       WHERE  
      NOT CODNOT=P_CODNOT 
      AND USOTRF='S';
    if (l_RegistroExistente>0) then
      raise_application_error(-20000 + -(103),'Já existe um registro configurado para Uso na Transferência');
    end if;
  end if;
  if ((P_BASLEG=5) or (P_BASLEG=6)) then
    SELECT 
      COUNT(*) EXPR1956031457
       INTO l_RegistroExistente 
       FROM R022NOT R022NOT
       WHERE  
      NOT CODNOT=P_CODNOT 
      AND BASLEG=P_BASLEG;
    if (l_RegistroExistente>0) then
      raise_application_error(-20000 + -(103),'Já existe um tipo de anotação cadastrado com o mesmo Regime de Jornada.');
    end if;
  end if;
end SP_R022NOT;
	MSSQL;0
k␀␀CREATE PROCEDURE SP_R022NOT(@P_CODNOT SMALLINT, @P_USOTRF CHAR(1), @P_BASLEG SMALLINT) AS
BEGIN
DECLARE @l_registroexistente FLOAT
  DECLARE @ChkError INTEGER
  SELECT @ChkError = 0
  IF (@P_USOTRF='S')
  BEGIN
    SELECT 
      @l_RegistroExistente=COUNT(*) 
       FROM r022not r022not
       WHERE  
      not codnot=@p_codnot 
      and usotrf='S'
    SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    IF (@l_RegistroExistente>0)
    BEGIN
      BEGIN
        RAISERROR('Já existe um registro configurado para Uso na Transferência',11,1) WITH SETERROR
        SELECT @ChkError = -30
        GOTO FIM
      END
    END
  END
  SELECT @ChkError = 0
  IF ((@P_BASLEG=5) OR (@P_BASLEG=6))
  BEGIN
    SELECT 
      @l_RegistroExistente=COUNT(*) 
       FROM r022not r022not
       WHERE  
      not codnot=@p_codnot 
      and basleg=@p_basleg
    SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    IF (@l_RegistroExistente>0)
    BEGIN
      BEGIN
        RAISERROR('Já existe um tipo de anotação cadastrado com o mesmo Regime de Jornada.',11,1) WITH SETERROR
        SELECT @ChkError = -30
        GOTO FIM
      END
    END
  END
FIM:
  RETURN @ChkError
END
	POSTGRESQL;0
Ë␀␀CREATE OR REPLACE PROCEDURE SP_R022NOT (p_codnot smallint, p_usotrf varchar, p_basleg smallint)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  l_RegistroExistente INT;
begin
  if (P_USOTRF='S') then
    SELECT 
      COUNT(*) EXPR1956031457
       INTO l_RegistroExistente 
       FROM R022NOT R022NOT
       WHERE  
      NOT CODNOT=P_CODNOT 
      AND USOTRF='S';
    if (l_RegistroExistente>0) then
	  RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'Já existe um registro configurado para Uso na Transferência';
    end if;
  end if;
  if ((P_BASLEG=5) or (P_BASLEG=6)) then
    SELECT 
      COUNT(*) EXPR1956031457
       INTO l_RegistroExistente 
       FROM R022NOT R022NOT
       WHERE  
      NOT CODNOT=P_CODNOT 
      AND BASLEG=P_BASLEG;
    if (l_RegistroExistente>0) then
	  RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'Já existe um tipo de anotação cadastrado com o mesmo Regime de Jornada.';
    end if;
  end if;
END
$BODY$;␀—ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
