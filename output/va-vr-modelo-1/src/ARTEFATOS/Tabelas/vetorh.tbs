PROCEDURE R097MOP_ATUCON(P_TIPOPE VARCHAR2(1),P_PROPAC VARCHAR2(20))
 IS

l_tippes          NUMBER;
  l_verplf          NUMBER(3);
  l_codplf          NUMBER(5);
  l_hora_atual      NUMBER(4);
  l_data_zero       DATE;
  l_data_atual      DATE;

  CURSOR c_r097ain IS
  SELECT TIPDOC, NUMDOC, NUMCRA, DATIAC, HORIAC, DATFAC, HORFAC
  FROM R097AIN
  WHERE PROPAC = p_propac
  AND ((DATFAC > l_data_atual) OR
       ((DATFAC = l_data_atual) AND (HORFAC >= l_hora_atual)) OR
       (DATFAC = l_data_zero)) AND STAATU > 0;

  TYPE t_r097ain IS RECORD(
    TIPDOC   R097AIN.TIPDOC%TYPE,
    NUMDOC   R097AIN.NUMDOC%TYPE,
    NUMCRA   R097AIN.NUMCRA%TYPE,
    DATIAC   R097AIN.DATIAC%TYPE,
    HORIAC   R097AIN.HORIAC%TYPE,
    DATFAC   R097AIN.DATFAC%TYPE,
    HORFAC   R097AIN.HORFAC%TYPE);
  l_r097ain t_r097ain;

  CURSOR c_r097int IS
  SELECT A.NUMCRA, A.DATINI, A.HORINI, A.DATFIM, A.HORFIM, B.TIPDOC, B.NUMDOC
  FROM R097INT A, R097PAC B
  WHERE A.PROPAC = p_propac AND
        A.PROPAC = B.PROPAC AND
        ((A.DATFIM > l_data_atual) OR
       ((A.DATFIM = l_data_atual) AND (A.HORFIM >= l_hora_atual)) OR
       (A.DATFIM = l_data_zero)) AND A.STAATU > 0;

  TYPE t_r097int IS RECORD(
    NUMCRA   R097INT.NUMCRA%TYPE,
    DATINI   R097INT.DATINI%TYPE,
    HORINI   R097INT.HORINI%TYPE,
    DATFIM   R097INT.DATFIM%TYPE,
    HORFIM   R097INT.HORFIM%TYPE,
    TIPDOC   R097PAC.TIPDOC%TYPE,
    NUMDOC   R097PAC.NUMDOC%TYPE);
  l_r097int t_r097int;

BEGIN
  /*Inicializações*/
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  /*Obtem a última movimentação*/
  BEGIN
      SELECT VERPLF, CODPLF INTO l_verplf, l_codplf
          FROM R097MOP A
          WHERE A.PROPAC = p_propac AND
                A.DATINI = (SELECT MAX(DATINI) FROM R097MOP
                                WHERE PROPAC = p_propac)
                AND
                A.HORINI = (SELECT MAX(HORINI) FROM R097MOP
                                WHERE DATINI = A.DATINI AND PROPAC = p_propac)
                AND
                A.SEQMOV = (SELECT MAX(SEQMOV) FROM R097MOP
                                WHERE DATINI = A.DATINI AND HORINI = A.HORINI AND PROPAC = p_propac);

  EXCEPTION
      WHEN NO_DATA_FOUND THEN
          l_verplf := 0;
          l_codplf := 0;
  END;

  /*Atualiza os acompanhantes*/
  FOREACH c_r097ain INTO  l_r097ain.TipDoc, l_r097ain.NumDoc, l_r097ain.NumCra, l_r097ain.DATIAC,
                          l_r097ain.HORIAC, l_r097ain.DatFac, l_r097ain.HorFac
  LOOP
      /* Verifica se Acompanhante de Paciente possui Cracha */
      IF  l_r097ain.NUMCRA <> 0  THEN
          /*Atualiza os acompanhantes de paciente.*/
          l_tippes := 11;
          /*Atualiza o acompanhante de paciente na r070con/controle*/
          SP_PACCON(l_tippes,p_propac,l_r097ain.TIPDOC,l_r097ain.NUMDOC,l_r097ain.NUMCRA,l_verplf,l_codplf,
                    l_r097ain.datiac,l_r097ain.horiac,l_r097ain.DATFAC,l_r097ain.HORFAC,0,0);
      END IF;
  END LOOP;

  /*Atualiza o paciente*/
  FOREACH c_r097int INTO  l_r097int.NumCra, l_r097int.DatIni, l_r097int.HorIni,
                          l_r097int.DatFim, l_r097int.HorFim, l_r097int.TIPDOC,
                          l_r097int.NUMDOC
  LOOP
      /* Verifica o Paciente possui Cracha */
      IF  l_r097int.NUMCRA <> 0  THEN
          /*Atualiza o paciente.*/
          l_tippes := 9;
          /*Atualiza o acompanhante de paciente na r070con/controle*/
          SP_PACCON(l_tippes,p_propac,l_r097int.TIPDOC,l_r097int.NUMDOC,l_r097int.NUMCRA,l_verplf,l_codplf,
                    l_r097int.DATINI,l_r097int.HORINI,l_r097int.DATFIM,l_r097int.HORFIM,0,0);
      END IF;
  END LOOP;
END		SENIOR;24SP_PACCON
