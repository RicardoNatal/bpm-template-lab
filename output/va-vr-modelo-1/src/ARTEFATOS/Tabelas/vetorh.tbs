DECLARE
  l_codrpa NUMBER(15);
  l_temAud BOOLEAN;
  l_datTemp VARCHAR(10);
BEGIN
  SP_EXISTE_LOG(22, 157, 1, l_temAud OUT);


  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, 22, 1, 157, 1, 'R040PRG_SI', 'FR040PRG'); 
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
      SP_DATSTR(:NEW.INIPER, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIPER', l_datTemp);
      SP_DATSTR(:NEW.PRGDAT, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRGDAT', l_datTemp);
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R040PRG_SI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

   BEGIN
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRGDFE', CONVERT(NUMBER_TO_CHAR, :NEW.PRGDFE));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRGDAB', CONVERT(NUMBER_TO_CHAR, :NEW.PRGDAB));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRG13S', :NEW.PRG13S);
     SP_DATSTR(:NEW.PRGDPG, 'DD/MM/YYYY', l_datTemp OUT);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRGDPG', l_datTemp);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRGPCL', CONVERT(NUMBER_TO_CHAR, :NEW.PRGPCL));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'GERADT', :NEW.GERADT);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAPRG', :NEW.STAPRG);
   END;
  END IF;
END␀Õ␀␀		SENIOR;0y␀␀

TRIGGER R040PRG_SU AFTER UPDATE ON R040PRG FOR EACH ROW
DECLARE
  l_codrpa  NUMBER(15);
  l_temAud  BOOLEAN;
  l_datTemp VARCHAR(10);
  l_temreg  NUMBER;    
  l_oriavi  NUMBER;    
  l_alterou  BOOLEAN;   
BEGIN

l_alterou :=  FALSE;
IF ((:OLD.NumEmp <> :NEW.NumEmp)
OR (:OLD.TipCol <> :NEW.TipCol)
OR (:OLD.NumCad <> :NEW.NumCad)
OR (:OLD.IniPer <> :NEW.IniPer)
OR (:OLD.PrgDat <> :NEW.PrgDat)
OR (:OLD.PrgDfe <> :NEW.PrgDfe)
OR (:OLD.PrgDab <> :NEW.PrgDab)
OR (:OLD.Prg13s <> :NEW.Prg13s)
OR (:OLD.PrgDpg <> :NEW.PrgDpg)
OR (:OLD.PrgPcl <> :NEW.PrgPcl)
OR (:OLD.GerAdt <> :NEW.GerAdt)
OR (:OLD.StaPrg <> :NEW.StaPrg)) THEN
    l_alterou := TRUE;
    SP_EXISTE_LOG(22, 158, 1, l_temAud OUT);
  
  
    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, 1, 22, 1, 158, 1, 'R040PRG_SU', 'FR040PRG');
     
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.INIPER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIPER', l_datTemp);
        SP_DATSTR(:OLD.PRGDAT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRGDAT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R040PRG_SU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN 
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRGDFE', CONVERT(NUMBER_TO_CHAR, :OLD.PRGDFE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRGDFE', CONVERT(NUMBER_TO_CHAR, :NEW.PRGDFE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRGDAB', CONVERT(NUMBER_TO_CHAR, :OLD.PRGDAB));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRGDAB', CONVERT(NUMBER_TO_CHAR, :NEW.PRGDAB));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRG13S', :OLD.PRG13S);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRG13S', :NEW.PRG13S);
        SP_DATSTR(:OLD.PRGDPG, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRGDPG', l_datTemp);
        SP_DATSTR(:NEW.PRGDPG, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRGDPG', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRGPCL', CONVERT(NUMBER_TO_CHAR, :OLD.PRGPCL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRGPCL', CONVERT(NUMBER_TO_CHAR, :NEW.PRGPCL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDGERADT', :OLD.GERADT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWGERADT', :NEW.GERADT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSTAPRG', :OLD.STAPRG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSTAPRG', :NEW.STAPRG);
      END;
    END IF;
  END IF;
  
  /* Atualiza registros da publicação do aviso de férias para G7 */
  l_temreg := 0;
  l_oriavi := 1;
  /* 0=Cálculo Recibo de Férias, 1=Programação Individual, 2=Programação Coletiva */
  BEGIN 
      SELECT COUNT(*) INTO l_temreg FROM R040PAF WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND INIPER = :OLD.INIPER AND INIFER = :OLD.PRGDAT AND ORIAVI = l_oriavi;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN l_temreg := 0;
      WHEN OTHERS THEN l_temreg := 0;       
  END;
    
  IF ((l_alterou = TRUE) AND (l_temreg > 0)) THEN
      BEGIN
         DELETE FROM R040PAF WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND INIPER = :OLD.INIPER AND INIFER = :OLD.PRGDAT AND ORIAVI = l_oriavi;           
      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;  
  END IF;  
  
END␀œÕ␀␀		SENIOR;0õ
␀␀

TRIGGER R040PRG_SD AFTER DELETE ON R040PRG FOR EACH ROW

DECLARE
  l_codrpa  NUMBER(15);
  l_temAud  BOOLEAN;
  l_datTemp VARCHAR(10);
  l_temreg  NUMBER;    
  l_oriavi  NUMBER;  
BEGIN
  SP_EXISTE_LOG(22, 157, 1, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, 22, 1, 157, 1, 'R040PRG_SD', 'FR040PRG');

    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      SP_DATSTR(:OLD.INIPER, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIPER', l_datTemp);
      SP_DATSTR(:OLD.PRGDAT, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRGDAT', l_datTemp);
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R040PRG_SD: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

   BEGIN 
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRGDFE', CONVERT(NUMBER_TO_CHAR, :OLD.PRGDFE));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRGDAB', CONVERT(NUMBER_TO_CHAR, :OLD.PRGDAB));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRG13S', :OLD.PRG13S);
     SP_DATSTR(:OLD.PRGDPG, 'DD/MM/YYYY', l_datTemp OUT);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRGDPG', l_datTemp);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRGPCL', CONVERT(NUMBER_TO_CHAR, :OLD.PRGPCL));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'GERADT', :OLD.GERADT);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAPRG', :OLD.STAPRG);
   END;
  END IF;
  
  /* Exclui registros da publicação do aviso de férias para G7 */
  l_temreg := 0;
  l_oriavi := 1;
  /* 0=Cálculo Recibo de Férias, 1=Programação Individual, 2=Programação Coletiva */
  BEGIN 
      SELECT COUNT(*) INTO l_temreg FROM R040PAF WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND INIPER = :OLD.INIPER AND INIFER = :OLD.PRGDAT AND ORIAVI = l_oriavi;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN l_temreg := 0;
      WHEN OTHERS THEN l_temreg := 0;       
  END;
    
  IF (l_temreg > 0) THEN
      BEGIN
          DELETE FROM R040PAF WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND INIPER = :OLD.INIPER AND INIFER = :OLD.PRGDAT AND ORIAVI = l_oriavi;           
      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;  
  END IF; 
  
END␀␀␀:Á␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ŸÕ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀g>XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀›␀Ü␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀‚%€$€$w␀Æÿ␀␀…Ó␀␀␀‘␀␀Ñ␀	␀␀␀␀␀␀␀>•␀␀áÀ␀␀¹”␀␀qC␀êÿ␀␀‘Õ␀␀␀ñ␀␀Ñ␀	␀␀␀␀␀␀␀$•␀␀ ”␀␀#•␀␀qC␀êÿ␀␀ƒÕ␀␀␀EÑ␀	␀␀␀␀␀␀␀nN?[?[qC␀êÿ␀␀ÿ␀␀␀␀0;1;2;3;4;5␀␀È␀␀␀␀␀␀␀␀␀ Õ␀␀Ó␀±␀	␀␀␀␀␀␀␀>´␀û␀q␀Æÿ␀␀Ï␀␀␀È-´␀	␀␀␀␀␀␀␀µBû␀û␀r␀Æÿ␀␀¢Õ␀␀␀?ş␀␀±␀	␀␀␀␀␀␀␀xş␀␀ü␀␀xş␀␀q␀Æÿ␀␀ÿ␀:␀F␀␀␀␀␀␀␀Z␀Z␀Z␀c␀␀␀ÿ␀␀ÿ␀@␀%	␀␀␀␀␀␀␀x␀p␀P␀n␀Æÿ␀␀ÿ␀…,´␀␀␀␀␀␀␀␀_@NgNgr␀Æÿ␀␀#␀‡␀´␀␀␀␀␀␀␀␀†Aû␀û␀r␀Æÿ␀␀¢Õ␀␀␀Ñ8b␀␀␀␀␀␀␀p'p'p'm␀␀␀ÿ␀␀ÿ␀␀␀␀0;1;2␀␀ö␀␀␀␀␀␀␀␀␀¡Õ␀␀Ó␀±␀	␀␀␀␀␀␀␀>´␀û␀q␀Æÿ␀␀Ï␀␀␀È-´␀	␀␀␀␀␀␀␀û␀û␀û␀r␀Æÿ␀␀¢Õ␀␀␀•U8␀␀␀␀␀␀␀wY°V°V?␀␀ÿ␀␀ÿ␀␀␀␀0;1␀␀
