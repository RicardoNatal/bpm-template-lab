“␀␀PROCEDURE R057DIB_CRABEN(P_TIPOPE CHAR,P_NUMEMP NUMBER(4),P_TIPCOL INTEGER,P_NUMCAD NUMBER(9),P_CODBNF INTEGER,P_QTDENB INTEGER)
 IS

l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_online       BOOLEAN;
  l_retbnf       CHAR(1);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       l_retbnf := 'N';
       BEGIN
       SELECT RETBNF INTO l_retbnf
              FROM R034BNF
              WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol
              AND NUMCAD = p_numcad AND CODBNF = p_codbnf;
       EXCEPTION
           WHEN OTHERS THEN l_retbnf := 'N';
       END;
       IF l_retbnf = 'S' THEN
          /* Se tiver crachá provísório vale ele. senão pegar o titular */
          SP_RETCRA(2,p_numemp,p_tipcol,p_numcad,0,'',0,'',l_crapro OUT);
          IF   (l_crapro = 0)  THEN
		SP_RETCRA(1,p_numemp,p_tipcol,p_numcad,0,'',0,'',l_cracha OUT);
          ELSE  l_cracha := l_crapro;
          END IF;
          IF   l_cracha <> 0  THEN
               /* Atualiza Tabela de Beneficios */
               R057DIB_ATUBEN(p_tipope,l_cracha,0,p_codbnf,p_qtdenb);
          END IF;
       END IF;
  END IF;
END␀W×␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
