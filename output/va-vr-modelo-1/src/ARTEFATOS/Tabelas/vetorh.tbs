PROCEDURE SP_CANCON(P_DATENT DATE,P_HORENT NUMBER,P_NUMCAN NUMBER,P_NUMCRA NUMBER,P_CODPRM NUMBER,P_DATVAL DATE,P_HORVAL NUMBER)
 IS

/* Campos da tabela R070CON */
    l_IdtPes  VARCHAR2(23);
    l_NumCra  NUMBER(12);
    l_TecCra  NUMBER(1);
    l_ChcPri  NUMBER(12);
    l_NumFis  NUMBER(12);
    l_TipCra  NUMBER(2);
    l_CodPrm  NUMBER(5);
    l_PrmSab  NUMBER(5);
    l_PrmDom  NUMBER(5);
    l_PrmFer  NUMBER(5);
    l_SenCol  VARCHAR2(6);
    l_SitCra  NUMBER(2);
    l_IniVal  VARCHAR2(16);
    l_DatVal  VARCHAR2(16);
    l_IniAfa  VARCHAR2(16);
    l_DatAfa  VARCHAR2(16);
    l_MsgAcc  VARCHAR2(32);
    l_DatMsg  VARCHAR2(16);
    l_QtdMsg  NUMBER(2);
    l_MsgAtu  NUMBER(2);
    l_ConIal  NUMBER(1);
    l_TemAlm  NUMBER(3);
    l_VerAfa  NUMBER(1);
    l_UsaBio  NUMBER(1);
    l_VerPrm  NUMBER(1);
    l_ConFai  NUMBER(1);
    l_ConAdp  NUMBER(1);
    l_ConCre  NUMBER(1);
    l_ConPac  NUMBER(1);
    l_TemPac  NUMBER(3);
    l_ConRea  NUMBER(1);
    l_BloAut  NUMBER(1);
    l_BloFal  NUMBER(1);
    l_NivAtu  VARCHAR2(5);
    l_DatNiv  DATE;
    l_HorNiv  NUMBER(5);
    l_SeqNiv  NUMBER(6);
    l_FaiAc1  VARCHAR2(56);
    l_FaiAc2  VARCHAR2(56);
    l_FaiAc3  VARCHAR2(56);
    l_FaiAc4  VARCHAR2(56);
    l_FaiAc5  VARCHAR2(56);
    l_FaiAc6  VARCHAR2(56);
    l_FaiAc7  VARCHAR2(56);
    l_FaiPt1  VARCHAR2(56);
    l_FaiPt2  VARCHAR2(56);
    l_FaiPt3  VARCHAR2(56);
    l_FaiPt4  VARCHAR2(56);
    l_FaiPt5  VARCHAR2(56);
    l_FaiPt6  VARCHAR2(56);
    l_FaiPt7  VARCHAR2(56);
    l_FaiRef  VARCHAR2(56);
    l_CreAc1  NUMBER(2);
    l_CreFx1  VARCHAR2(8);
    l_QtdCr1  NUMBER(2);
    l_CreAc2  NUMBER(2);
    l_CreFx2  VARCHAR2(8);
    l_QtdCr2  NUMBER(2);
    l_CreAc3  NUMBER(2);
    l_CreFx3  VARCHAR2(8);
    l_QtdCr3  NUMBER(2);
    l_CreAc4  NUMBER(2);
    l_CreFx4  VARCHAR2(8);
    l_QtdCr4  NUMBER(2);
    l_CreAc5  NUMBER(2);
    l_CreFx5  VARCHAR2(8);
    l_QtdCr5  NUMBER(2);
    l_CreAc6  NUMBER(2);
    l_CreFx6  VARCHAR2(8);
    l_QtdCr6  NUMBER(2);
    l_PrmRt1  NUMBER(5);
    l_DinPr1  VARCHAR2(10);
    l_DfnPr1  VARCHAR2(10);
    l_PrmRt2  NUMBER(5);
    l_DinPr2  VARCHAR2(10);
    l_DfnPr2  VARCHAR2(10);
    l_PrmRt3  NUMBER(5);
    l_situa   CHAR(1);
    l_situa_nmb NUMBER;
    l_situaAnt CHAR(1);
    l_qtdIdtPes NUMBER(2);
    l_iPerson BOOLEAN;
    l_numpro_ret BOOLEAN;
    l_numsma_ret BOOLEAN;
    l_datahora CHAR(10);
    l_DinPr3  VARCHAR2(10);
    l_DfnPr3  VARCHAR2(10);
    l_GraCon  NUMBER(3);
    l_ConInt  NUMBER(1);
    l_TolInt  NUMBER(3);
    l_TolAcp  NUMBER(2);
    l_comando_nulo BOOLEAN;
    l_DatSai       DATE;
    l_HorSai       NUMBER(5);
    l_SeqSai       NUMBER(6);
    l_ValAut       NUMBER(1);
    l_CodArc       NUMBER(5);
    l_DatArc       DATE;
    l_HorArc       NUMBER(5);
    l_SeqArc       NUMBER(6);
    l_numcracex    NUMBER(12);

    /* Atributos Auxiliares. */
    l_auxval       CHAR(16);
    l_TipPes       CHAR(2);
    l_NumBar       NUMBER(12);
    l_NumPro       NUMBER(12);
    l_NumSma       NUMBER(12);
    l_CraPri       NUMBER(12);
    l_TecPri       NUMBER(1);
    l_DatStr       CHAR(6);
    l_HorStr       CHAR(4);
    l_NumCan       CHAR(7);
    l_datatu       CHAR(16);
    l_data_atual   DATE;
    l_hora_atual   NUMBER(4);
    l_segu_atual   NUMBER(2);
    l_DatAtuStr    CHAR(6);
    l_HorAtuStr    CHAR(4);
    l_seqatu       NUMBER(2);
    l_seqstr       CHAR(2);
    l_nompes       VARCHAR2(40);
    l_ddifon       NUMBER(3);
    l_dddfon       NUMBER(3);
    l_numfon       VARCHAR2(20);
    l_usarfastr    CHAR(1);
    l_usarfa       NUMBER(1);

BEGIN
    IF (p_NumCra > 0) THEN
        /* Monta IDTPES*/
        SP_INTSTR(13, '99', l_TipPes OUT);
        SP_INTSTR(p_NumCan, '9999999', l_NumCan OUT);

        l_IdtPes := l_TipPes||l_NumCan;

        /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
        l_idtpes := lTrim(l_idtpes);
        l_idtpes := rTrim(l_idtpes);

        LOOP
            /*Controle do Loop.*/
            IF (Length(l_idtpes) > 22) THEN
                EXIT;
            END IF;
            l_idtpes := ' '||l_idtpes;
        END LOOP;

        l_NumCra := p_NumCra;
        l_TecCra := l_TecPri;
        l_ChcPri := 0;
        l_NumFis := l_NumCra;
        l_TipCra := 13;
        l_CodPrm := p_CodPrm;
        l_PrmSab := 0;
        l_PrmDom := 0;
        l_PrmFer := 0;
        l_SenCol := ' ';
        l_SitCra := 0;

        SP_DATSTR(p_DatEnt, 'DDMMYY', l_DatStr OUT);
        SP_INTSTR(p_HorEnt, 'HHMM', l_HorStr OUT);
        l_IniVal := l_DatStr||l_HorStr||'000000';

        SP_DATSTR(p_DatVal, 'DDMMYY', l_DatStr OUT);
        SP_INTSTR(p_HorVal, 'HHMM', l_HorStr OUT);
        l_DatVal := l_DatStr||l_HorStr||'000000';

        /* converte a data atual para verificar se existe crachá válido na r070con */
        l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
        l_data_atual := CURDATE();
        l_segu_atual := SECOND(CURTIME());

        /* data atual no formato string (r070con) */
        SP_DATSTR(l_data_atual,'DDMMYY',l_datatustr OUT);
        SP_INTSTR(l_hora_atual,'HHMM',l_horatustr OUT);
        l_seqatu := SECOND(CURTIME());
        SP_INTSTR(l_seqatu, '99', l_seqstr OUT);
        l_datatu := l_datAtuStr||l_horAtuStr||l_seqstr||'0000';

        /* YYMMDDHHMMSEQ0000 */
        l_datatu := SUBSTRING(l_datatu,5,2)||SUBSTRING(l_datatu,3,2)||SUBSTRING(l_datatu,1,2)||SUBSTRING(l_datatu,7,10);

        l_IniAfa := '0000000000000000';
        l_DatAfa := '0000000000000000';
        l_MsgAcc := ' ';
        l_DatMsg := '0000000000000000';
        l_QtdMsg := 0;
        l_MsgAtu := 0;
        l_ConIal := 0;
        l_TemAlm := 0;
        l_VerAfa := 0;
        l_UsaBio := 1; /* Não utiliza biometria. */
        l_VerPrm := 1; /* Sempre verifica permissão */
        l_ConFai := 0;
        l_ConAdp := 0;
        l_ConCre := 0;
        l_ConPac := 0;
        l_TemPac := 0;
        l_ConRea := 1;
        l_BloAut := 0;
        l_BloFal := 0;
        l_NivAtu := '99000';
        l_DatNiv := CURDATE(); /* Data atual. */
        l_HorNiv := 0; /* Hora atual. */
        l_SeqNiv := SECOND(CURTIME()); /* Segundo atual. */

        l_FaiAc1 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc2 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc3 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc4 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc5 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc6 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc7 := '00002359240024002400240024002400240024002400240024002400';

        l_FaiPt1 := l_FaiAc1;
        l_FaiPt2 := l_FaiAc2;
        l_FaiPt3 := l_FaiAc3;
        l_FaiPt4 := l_FaiAc4;
        l_FaiPt5 := l_FaiAc5;
        l_FaiPt6 := l_FaiAc6;
        l_FaiPt7 := l_FaiAc7;

        l_FaiRef := '24002400240024002400240024002400240024002400240024002400';

        l_CreAc1 := 0;
        l_CreFx1 := '24002400';
        l_QtdCr1 := l_CreAc1;
        l_CreAc2 := 0;
        l_CreFx2 := '24002400';
        l_QtdCr2 := l_CreAc2;
        l_CreAc3 := 0;
        l_CreFx3 := '24002400';
        l_QtdCr3 := l_CreAc3;
        l_CreAc4 := 0;
        l_CreFx4 := '24002400';
        l_QtdCr4 := l_CreAc4;
        l_CreAc5 := 0;
        l_CreFx5 := '24002400';
        l_QtdCr5 := l_CreAc5;
        l_CreAc6 := 0;
        l_CreFx6 := '24002400';
        l_QtdCr6 := l_CreAc6;
        l_situa  := '0';
        l_situaAnt:= '1';

        l_PrmRt1 := 0;
        l_DinPr1 := '0000000000';
        l_DfnPr1 := '0000000000';
        l_PrmRt2 := 0;
        l_DinPr2 := '0000000000';
        l_DfnPr2 := '0000000000';
        l_PrmRt3 := 0;
        l_DinPr3 := '0000000000';
        l_DfnPr3 := '0000000000';

        l_GraCon := 50;
        l_ConInt := 0;
        l_TolInt := 0;
        l_TolAcp := 0;
        l_DatSai := '31/12/1900,00:00:00';
        l_HorSai := 0;
        l_SeqSai := 0;
        l_ValAut := 0;
        l_CodArc := 0;
        l_DatArc := '31/12/1900,00:00:00';
        l_HorArc := 0;
        l_SeqArc := 0;

        l_datahora := l_datstr || l_horstr;
        l_auxval := l_datahora||'000000';

        /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
        SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

        IF (l_crapri = 0) THEN
            l_crapri := p_numcra;
            /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
            l_teccra := 1;
        ELSE
            l_teccra := l_tecpri;
        END IF;
        /* Atualiza o número físico */
        l_numfis := l_crapri;

        /* Atualiza R070CON */
        l_comando_nulo:=FALSE;
        BEGIN
            SELECT NUMCRA, CONVERT(NUMBER_TO_CHAR, SITCRA) INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SPVISCON: Erro em R070CON - TOO MANY ROWS';
            WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
            WHEN OTHERS THEN RAISERROR 103 'SPVISCON: Erro no SELECT R070CON 5.';
        END;

        /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
        BEGIN
            SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON
             WHERE IDTPES = l_idtpes AND SITCRA = 0 AND ( SUBSTRING(DATVAL,5,2)
                                                        ||SUBSTRING(DATVAL,3,2)
                                                        ||SUBSTRING(DATVAL,1,2)
                                                        ||SUBSTRING(DATVAL,7,10) > l_datatu
                                                        OR DATVAL = '3112502359000000');
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No SELECT R070CON (IdtPes).';
        END;

        IF (l_qtdIdtPes > 0) THEN
            l_iPerson := FALSE;
        ELSE
            l_iPerson := TRUE;
        END IF;

        SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

        l_numcracex := 0;
        BEGIN
            SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        IF (l_numcracex = p_numcra) THEN
          l_situa := '1';
        END IF;

        SP_STRTOINT(l_Situa , l_Situa_nmb OUT);

        /* Assinala na tabela Controle que o Candidato utiliza reconhecimento facial */
        BEGIN
            SELECT USARFA INTO l_usarfastr FROM R122CEX WHERE NUMCAN = p_NumCan;
        EXCEPTION
            WHEN OTHERS THEN
                l_usarfastr := 'N';
        END;
        IF  l_usarfastr = 'S' THEN
            l_usarfa := 1;
        ELSE
            l_usarfa := 0;
        END IF;

        IF (l_comando_nulo = FALSE) THEN
            BEGIN
                UPDATE R070CON SET IDTPES = l_IdtPes, NUMCRA = l_NumCra, TECCRA = l_TecCra, CHCPRI = l_ChcPri, NUMFIS = l_NumFis,
                                   TIPCRA = l_TipCra, CODPRM = p_CodPrm, PRMSAB = l_PrmSab, PRMDOM = l_PrmDom, PRMFER = l_PrmFer,
                                   SENCOL = l_SenCol, SITCRA = l_Situa_nmb, INIVAL = l_IniVal, DATVAL = l_DatVal, INIAFA = l_IniAfa,
                                   DATAFA = l_DatAfa, MSGACC = l_MsgAcc, DATMSG = l_DatMsg, QTDMSG = l_QtdMsg, MSGATU = l_MsgAtu,
                                   CONIAL = l_ConIal, TEMALM = l_TemAlm, VERAFA = l_VerAfa, USABIO = l_UsaBio, VERPRM = l_VerPrm,
                                   CONFAI = l_ConFai, CONADP = l_ConAdp, CONCRE = l_ConCre, CONPAC = l_ConPac, TEMPAC = l_TemPac,
                                   BLOAUT = l_BloAut, BLOFAL = l_BloFal, NIVATU = l_NivAtu, DATNIV = l_DatNiv, HORNIV = l_HorNiv,
                                   SEQNIV = l_SeqNiv, FAIAC1 = l_FaiAc1, FAIAC2 = l_FaiAc2, FAIAC3 = l_FaiAc3, FAIAC4 = l_FaiAc4,
                                   FAIAC5 = l_FaiAc5, FAIAC6 = l_FaiAc6, FAIAC7 = l_FaiAc7, FAIPT1 = l_FaiPt1, FAIPT2 = l_FaiPt2,
                                   FAIPT3 = l_FaiPt3, FAIPT4 = l_FaiPt4, FAIPT5 = l_FaiPt5, FAIPT6 = l_FaiPt6, FAIPT7 = l_FaiPt7,
                                   FAIREF = l_FaiRef, CREAC1 = l_CreAc1, CREFX1 = l_CreFx1, QTDCR1 = l_QtdCr1, CREAC2 = l_CreAc2,
                                   CREFX2 = l_CreFx2, QTDCR2 = l_QtdCr2, CREAC3 = l_CreAc3, CREFX3 = l_CreFx3, QTDCR3 = l_QtdCr3,
                                   CREAC4 = l_CreAc4, CREFX4 = l_CreFx4, QTDCR4 = l_QtdCr4, CREAC5 = l_CreAc5, CREFX5 = l_CreFx5,
                                   QTDCR5 = l_QtdCr5, CREAC6 = l_CreAc6, CREFX6 = l_CreFx6, QTDCR6 = l_QtdCr6, PRMRT1 = l_PrmRt1,
                                   DINPR1 = l_DinPr1, DFNPR1 = l_DfnPr1, PRMRT2 = l_PrmRt2, DINPR2 = l_DinPr2, DFNPR2 = l_DfnPr2,
                                   PRMRT3 = l_PrmRt3, DINPR3 = l_DinPr3, DFNPR3 = l_DfnPr3, GRACON = l_GraCon, CONINT = l_ConInt,
                                   TOLINT = l_TolInt, TOLACP = l_TolAcp, DATSAI = l_DatSai, HORSAI = l_HorSai, SEQSAI = l_SeqSai,
                                   VALAUT = l_ValAut, CODARC = l_CodArc, DATARC = l_DatArc, HORARC = l_HorArc, SEQARC = l_SeqArc,
                                   NOMFUN = '', NUMPIS = 0, CONREA = l_ConRea, RECVIS = 0, 
                                   NOMPES = l_nompes, DDIFON = l_ddifon, DDDFON = l_dddfon, NUMFON = l_numfon, NUMEMP = 0,
                                   TIPCOL = 0, NUMCAD = 0, TIPDOC = 0, NUMDOC = '0', NUMMAT = '0', PROPAC = '0', NUMCAN = p_NumCan,
                                   USARFA = l_usarfa
                WHERE NUMFIS = l_CraPri;
            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_CANCON: Erro no UPDATE na tabela R070CON.';
            END;
        ELSE
            BEGIN
                INSERT INTO R070CON (IDTPES,   NUMCRA,   TECCRA,   CHCPRI,   NUMFIS,   TIPCRA,   CODPRM,   PRMSAB,   PRMDOM,   PRMFER,
                                     SENCOL,   SITCRA,   INIVAL,   DATVAL,   INIAFA,   DATAFA,   MSGACC,   DATMSG,   QTDMSG,   MSGATU,
                                     CONIAL,   TEMALM,   VERAFA,   USABIO,   VERPRM,   CONFAI,   CONADP,   CONCRE,   CONPAC,   TEMPAC,
                                     BLOAUT,   BLOFAL,   NIVATU,   DATNIV,   HORNIV,   SEQNIV,   FAIAC1,   FAIAC2,   FAIAC3,   FAIAC4,
                                     FAIAC5,   FAIAC6,   FAIAC7,   FAIPT1,   FAIPT2,   FAIPT3,   FAIPT4,   FAIPT5,   FAIPT6,   FAIPT7,
                                     FAIREF,   CREAC1,   CREFX1,   QTDCR1,   CREAC2,   CREFX2,   QTDCR2,   CREAC3,   CREFX3,   QTDCR3,
                                     CREAC4,   CREFX4,   QTDCR4,   CREAC5,   CREFX5,   QTDCR5,   CREAC6,   CREFX6,   QTDCR6,   PRMRT1,
                                     DINPR1,   DFNPR1,   PRMRT2,   DINPR2,   DFNPR2,   PRMRT3,   DINPR3,   DFNPR3,   GRACON,   CONINT,
                                     TOLINT,   TOLACP,   DATSAI,   HORSAI,   SEQSAI,   VALAUT,   CODARC,   DATARC,   HORARC,   SEQARC,
                                     NOMFUN,   NUMPIS,   CONREA,   NOMPES,   DDIFON,   DDDFON,   NUMFON,   RECVIS,   NUMEMP,   TIPCOL,
                                     NUMCAD,   TIPDOC,   NUMDOC,   NUMMAT,   PROPAC,   NUMCAN,   PROPRE,   USARFA)
                             VALUES (l_IdtPes, l_NumCra, l_TecCra, l_ChcPri, l_NumFis, l_TipCra, p_CodPrm, l_PrmSab, l_PrmDom, l_PrmFer,
                                     l_SenCol, l_Situa_nmb , l_IniVal, l_auxval, l_IniAfa, l_DatAfa, l_MsgAcc, l_DatMsg, l_QtdMsg, l_MsgAtu,
                                     l_ConIal, l_TemAlm, l_VerAfa, l_UsaBio, l_VerPrm, l_ConFai, l_ConAdp, l_ConCre, l_ConPac, l_TemPac,
                                     l_BloAut, l_BloFal, l_NivAtu, l_DatNiv, l_HorNiv, l_SeqNiv, l_FaiAc1, l_FaiAc2, l_FaiAc3, l_FaiAc4,
                                     l_FaiAc5, l_FaiAc6, l_FaiAc7, l_FaiPt1, l_FaiPt2, l_FaiPt3, l_FaiPt4, l_FaiPt5, l_FaiPt6, l_FaiPt7,
                                     l_FaiRef, l_CreAc1, l_CreFx1, l_QtdCr1, l_CreAc2, l_CreFx2, l_QtdCr2, l_CreAc3, l_CreFx3, l_QtdCr3,
                                     l_CreAc4, l_CreFx4, l_QtdCr4, l_CreAc5, l_CreFx5, l_QtdCr5, l_CreAc6, l_CreFx6, l_QtdCr6, l_PrmRt1,
                                     l_DinPr1, l_DfnPr1, l_PrmRt2, l_DinPr2, l_DfnPr2, l_PrmRt3, l_DinPr3, l_DfnPr3, l_GraCon, l_ConInt,
                                     l_TolInt, l_TolAcp, l_DatSai, l_HorSai, l_SeqSai, l_ValAut, l_CodArc, l_DatArc, l_HorArc, l_SeqArc,
                                     '', 0, l_ConRea,    l_nompes, l_ddifon, l_dddfon, l_numfon, 0, 0, 0, 0, 0, '0', '0', '0', p_NumCan,
                                     0, l_usarfa);
            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_CANCON: Erro no INSERT na tabela R070CON.';
            END;
        END IF;

        /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
        IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
            SP_PEND21(l_crapri);
        END IF;

        /*Atualiza os demais Crachás*/
        /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
        IF (l_tecpri = 1) THEN
            /*Atualiza o crachá de proximidade*/
            IF (l_numpro <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numpro, l_numpro_ret OUT);
                  /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numpro);
                END IF;
            END IF;
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;

        /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
        ELSIF (l_tecpri = 2) THEN
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        END IF;

        /*Verifica se Gera o Comando IncludePerson*/
        IF (l_iPerson = TRUE) THEN 
            /*Gera o Include Person*/
            SP_PEND19(p_numcra, l_idtpes);
        END IF;

        /*Atualiza a Controle*/
       SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);
    END IF;
END		SENIOR;20cSP_INTSTR
SP_DATSTR
SP_MAPFIS
SP_RETFON
SP_PEND21
SP_VERCON
SP_ATUFIS
SP_PEND19
SP_ATUTSI
ùP␀␀

/* Historico de Cracha - Candidatos */
PROCEDURE SP_CANCON(P_DATENT DATE,P_HORENT NUMBER,P_NUMCAN NUMBER,P_NUMCRA NUMBER,P_CODPRM NUMBER,P_DATVAL DATE,P_HORVAL NUMBER)
 IS

/* Campos da tabela R070CON */
    l_IdtPes  VARCHAR2(23);
    l_NumCra  NUMBER(12);
    l_TecCra  NUMBER(1);
    l_ChcPri  NUMBER(12);
    l_NumFis  NUMBER(12);
    l_TipCra  NUMBER(2);
    l_CodPrm  NUMBER(5);
    l_PrmSab  NUMBER(5);
    l_PrmDom  NUMBER(5);
    l_PrmFer  NUMBER(5);
    l_SenCol  VARCHAR2(6);
    l_SitCra  NUMBER(2);
    l_IniVal  VARCHAR2(16);
    l_DatVal  VARCHAR2(16);
    l_IniAfa  VARCHAR2(16);
    l_DatAfa  VARCHAR2(16);
    l_MsgAcc  VARCHAR2(32);
    l_DatMsg  VARCHAR2(16);
    l_QtdMsg  NUMBER(2);
    l_MsgAtu  NUMBER(2);
    l_ConIal  NUMBER(1);
    l_TemAlm  NUMBER(3);
    l_VerAfa  NUMBER(1);
    l_UsaBio  NUMBER(1);
    l_VerPrm  NUMBER(1);
    l_ConFai  NUMBER(1);
    l_ConAdp  NUMBER(1);
    l_ConCre  NUMBER(1);
    l_ConPac  NUMBER(1);
    l_TemPac  NUMBER(3);
    l_ConRea  NUMBER(1);
    l_BloAut  NUMBER(1);
    l_BloFal  NUMBER(1);
    l_NivAtu  VARCHAR2(5);
    l_DatNiv  DATE;
    l_HorNiv  NUMBER(5);
    l_SeqNiv  NUMBER(6);
    l_FaiAc1  VARCHAR2(56);
    l_FaiAc2  VARCHAR2(56);
    l_FaiAc3  VARCHAR2(56);
    l_FaiAc4  VARCHAR2(56);
    l_FaiAc5  VARCHAR2(56);
    l_FaiAc6  VARCHAR2(56);
    l_FaiAc7  VARCHAR2(56);
    l_FaiPt1  VARCHAR2(56);
    l_FaiPt2  VARCHAR2(56);
    l_FaiPt3  VARCHAR2(56);
    l_FaiPt4  VARCHAR2(56);
    l_FaiPt5  VARCHAR2(56);
    l_FaiPt6  VARCHAR2(56);
    l_FaiPt7  VARCHAR2(56);
    l_FaiRef  VARCHAR2(56);
    l_CreAc1  NUMBER(2);
    l_CreFx1  VARCHAR2(8);
    l_QtdCr1  NUMBER(2);
    l_CreAc2  NUMBER(2);
    l_CreFx2  VARCHAR2(8);
    l_QtdCr2  NUMBER(2);
    l_CreAc3  NUMBER(2);
    l_CreFx3  VARCHAR2(8);
    l_QtdCr3  NUMBER(2);
    l_CreAc4  NUMBER(2);
    l_CreFx4  VARCHAR2(8);
    l_QtdCr4  NUMBER(2);
    l_CreAc5  NUMBER(2);
    l_CreFx5  VARCHAR2(8);
    l_QtdCr5  NUMBER(2);
    l_CreAc6  NUMBER(2);
    l_CreFx6  VARCHAR2(8);
    l_QtdCr6  NUMBER(2);
    l_PrmRt1  NUMBER(5);
    l_DinPr1  VARCHAR2(10);
    l_DfnPr1  VARCHAR2(10);
    l_PrmRt2  NUMBER(5);
    l_DinPr2  VARCHAR2(10);
    l_DfnPr2  VARCHAR2(10);
    l_PrmRt3  NUMBER(5);
    l_situa   CHAR(1);
    l_situaAnt CHAR(1);
    l_qtdIdtPes NUMBER(2);
    l_iPerson BOOLEAN;
    l_numpro_ret BOOLEAN;
    l_numsma_ret BOOLEAN;
    l_datahora CHAR(10);
    l_DinPr3  VARCHAR2(10);
    l_DfnPr3  VARCHAR2(10);
    l_GraCon  NUMBER(3);
    l_ConInt  NUMBER(1);
    l_TolInt  NUMBER(3);
    l_TolAcp  NUMBER(2);
    l_comando_nulo BOOLEAN;
    l_DatSai       DATE;
    l_HorSai       NUMBER(5);
    l_SeqSai       NUMBER(6);
    l_ValAut       NUMBER(1);
    l_CodArc       NUMBER(5);
    l_DatArc       DATE;
    l_HorArc       NUMBER(5);
    l_SeqArc       NUMBER(6);
    l_numcracex    NUMBER(12);

    /* Atributos Auxiliares. */
    l_auxval       CHAR(16);
    l_TipPes       CHAR(2);
    l_NumBar       NUMBER(12);
    l_NumPro       NUMBER(12);
    l_NumSma       NUMBER(12);
    l_CraPri       NUMBER(12);
    l_TecPri       CHAR(1);
    l_DatStr       CHAR(6);
    l_HorStr       CHAR(4);
    l_NumCan       CHAR(7);
    l_datatu       CHAR(16);
    l_data_atual   DATE;
    l_hora_atual   NUMBER(4);
    l_segu_atual   NUMBER(2);
    l_DatAtuStr    CHAR(6);
    l_HorAtuStr    CHAR(4);
    l_seqatu       NUMBER(2);
    l_seqstr       CHAR(2);
    l_nompes       VARCHAR2(40);
    l_ddifon       NUMBER(3);
    l_dddfon       NUMBER(3);
    l_numfon       VARCHAR2(20);
    l_usarfastr    CHAR(1);
    l_usarfa       NUMBER(1);

BEGIN
    IF (p_NumCra > 0) THEN
        /* Monta IDTPES*/
        SP_INTSTR(13, '99', l_TipPes OUT);
        SP_INTSTR(p_NumCan, '9999999', l_NumCan OUT);

        l_IdtPes := l_TipPes||l_NumCan;

        /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
        l_idtpes := lTrim(l_idtpes);
        l_idtpes := rTrim(l_idtpes);

        LOOP
            /*Controle do Loop.*/
            IF (Length(l_idtpes) > 22) THEN
                EXIT;
            END IF;
            l_idtpes := ' '||l_idtpes;
        END LOOP;

        l_NumCra := p_NumCra;
        l_TecCra := l_TecPri;
        l_ChcPri := 0;
        l_NumFis := l_NumCra;
        l_TipCra := 13;
        l_CodPrm := p_CodPrm;
        l_PrmSab := 0;
        l_PrmDom := 0;
        l_PrmFer := 0;
        l_SenCol := ' ';
        l_SitCra := 0;

        SP_DATSTR(p_DatEnt, 'DDMMYY', l_DatStr OUT);
        SP_INTSTR(p_HorEnt, 'HHMM', l_HorStr OUT);
        l_IniVal := l_DatStr||l_HorStr||'000000';

        SP_DATSTR(p_DatVal, 'DDMMYY', l_DatStr OUT);
        SP_INTSTR(p_HorVal, 'HHMM', l_HorStr OUT);
        l_DatVal := l_DatStr||l_HorStr||'000000';

        /* converte a data atual para verificar se existe crachá válido na r070con */
        l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
        l_data_atual := CURDATE();
        l_segu_atual := SECOND(CURTIME());

        /* data atual no formato string (r070con) */
        SP_DATSTR(l_data_atual,'DDMMYY',l_datatustr OUT);
        SP_INTSTR(l_hora_atual,'HHMM',l_horatustr OUT);
        l_seqatu := SECOND(CURTIME());
        SP_INTSTR(l_seqatu, '99', l_seqstr OUT);
        l_datatu := l_datAtuStr||l_horAtuStr||l_seqstr||'0000';

        /* YYMMDDHHMMSEQ0000 */
        l_datatu := SUBSTRING(l_datatu,5,2)||SUBSTRING(l_datatu,3,2)||SUBSTRING(l_datatu,1,2)||SUBSTRING(l_datatu,7,10);

        l_IniAfa := '0000000000000000';
        l_DatAfa := '0000000000000000';
        l_MsgAcc := ' ';
        l_DatMsg := '0000000000000000';
        l_QtdMsg := 0;
        l_MsgAtu := 0;
        l_ConIal := 0;
        l_TemAlm := 0;
        l_VerAfa := 0;
        l_UsaBio := 1; /* Não utiliza biometria. */
        l_VerPrm := 1; /* Sempre verifica permissão */
        l_ConFai := 0;
        l_ConAdp := 0;
        l_ConCre := 0;
        l_ConPac := 0;
        l_TemPac := 0;
        l_ConRea := 1;
        l_BloAut := 0;
        l_BloFal := 0;
        l_NivAtu := '99000';
        l_DatNiv := CURDATE(); /* Data atual. */
        l_HorNiv := 0; /* Hora atual. */
        l_SeqNiv := SECOND(CURTIME()); /* Segundo atual. */

        l_FaiAc1 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc2 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc3 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc4 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc5 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc6 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc7 := '00002359240024002400240024002400240024002400240024002400';

        l_FaiPt1 := l_FaiAc1;
        l_FaiPt2 := l_FaiAc2;
        l_FaiPt3 := l_FaiAc3;
        l_FaiPt4 := l_FaiAc4;
        l_FaiPt5 := l_FaiAc5;
        l_FaiPt6 := l_FaiAc6;
        l_FaiPt7 := l_FaiAc7;

        l_FaiRef := '24002400240024002400240024002400240024002400240024002400';

        l_CreAc1 := 0;
        l_CreFx1 := '24002400';
        l_QtdCr1 := l_CreAc1;
        l_CreAc2 := 0;
        l_CreFx2 := '24002400';
        l_QtdCr2 := l_CreAc2;
        l_CreAc3 := 0;
        l_CreFx3 := '24002400';
        l_QtdCr3 := l_CreAc3;
        l_CreAc4 := 0;
        l_CreFx4 := '24002400';
        l_QtdCr4 := l_CreAc4;
        l_CreAc5 := 0;
        l_CreFx5 := '24002400';
        l_QtdCr5 := l_CreAc5;
        l_CreAc6 := 0;
        l_CreFx6 := '24002400';
        l_QtdCr6 := l_CreAc6;
        l_situa  := '0';
        l_situaAnt:= '1';

        l_PrmRt1 := 0;
        l_DinPr1 := '0000000000';
        l_DfnPr1 := '0000000000';
        l_PrmRt2 := 0;
        l_DinPr2 := '0000000000';
        l_DfnPr2 := '0000000000';
        l_PrmRt3 := 0;
        l_DinPr3 := '0000000000';
        l_DfnPr3 := '0000000000';

        l_GraCon := 50;
        l_ConInt := 0;
        l_TolInt := 0;
        l_TolAcp := 0;
        l_DatSai := '31/12/1900,00:00:00';
        l_HorSai := 0;
        l_SeqSai := 0;
        l_ValAut := 0;
        l_CodArc := 0;
        l_DatArc := '31/12/1900,00:00:00';
        l_HorArc := 0;
        l_SeqArc := 0;

        l_datahora := l_datstr || l_horstr;
        l_auxval := l_datahora||'000000';

        /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
        SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

        IF (l_crapri = 0) THEN
            l_crapri := p_numcra;
            /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
            l_teccra := 1;
        ELSE
            l_teccra := l_tecpri;
        END IF;
        /* Atualiza o número físico */
        l_numfis := l_crapri;

        /* Atualiza R070CON */
        l_comando_nulo:=FALSE;
        BEGIN
            SELECT NUMCRA, SITCRA INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SPVISCON: Erro em R070CON - TOO MANY ROWS';
            WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
            WHEN OTHERS THEN RAISERROR 103 'SPVISCON: Erro no SELECT R070CON 5.';
        END;

        /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
        BEGIN
            SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON
             WHERE IDTPES = l_idtpes AND SITCRA = 0 AND ( SUBSTRING(DATVAL,5,2)
                                                        ||SUBSTRING(DATVAL,3,2)
                                                        ||SUBSTRING(DATVAL,1,2)
                                                        ||SUBSTRING(DATVAL,7,10) > l_datatu
                                                        OR DATVAL = '3112502359000000');
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No SELECT R070CON (IdtPes).';
        END;

        IF (l_qtdIdtPes > 0) THEN
            l_iPerson := FALSE;
        ELSE
            l_iPerson := TRUE;
        END IF;

        SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

        l_numcracex := 0;
        BEGIN
            SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        IF (l_numcracex = p_numcra) THEN
          l_situa := '1';
        END IF;

        /* Assinala na tabela Controle que o Candidato utiliza reconhecimento facial */
        BEGIN
            SELECT USARFA INTO l_usarfastr FROM R122CEX WHERE NUMCAN = p_NumCan;
        EXCEPTION
            WHEN OTHERS THEN
                l_usarfastr := 'N';
        END;
        IF  l_usarfastr = 'S' THEN
            l_usarfa := 1;
        ELSE
            l_usarfa := 0;
        END IF;

        IF (l_comando_nulo = FALSE) THEN
            BEGIN
                UPDATE R070CON SET IDTPES = l_IdtPes, NUMCRA = l_NumCra, TECCRA = l_TecCra, CHCPRI = l_ChcPri, NUMFIS = l_NumFis,
                                   TIPCRA = l_TipCra, CODPRM = p_CodPrm, PRMSAB = l_PrmSab, PRMDOM = l_PrmDom, PRMFER = l_PrmFer,
                                   SENCOL = l_SenCol, SITCRA = l_Situa , INIVAL = l_IniVal, DATVAL = l_DatVal, INIAFA = l_IniAfa,
                                   DATAFA = l_DatAfa, MSGACC = l_MsgAcc, DATMSG = l_DatMsg, QTDMSG = l_QtdMsg, MSGATU = l_MsgAtu,
                                   CONIAL = l_ConIal, TEMALM = l_TemAlm, VERAFA = l_VerAfa, USABIO = l_UsaBio, VERPRM = l_VerPrm,
                                   CONFAI = l_ConFai, CONADP = l_ConAdp, CONCRE = l_ConCre, CONPAC = l_ConPac, TEMPAC = l_TemPac,
                                   BLOAUT = l_BloAut, BLOFAL = l_BloFal, NIVATU = l_NivAtu, DATNIV = l_DatNiv, HORNIV = l_HorNiv,
                                   SEQNIV = l_SeqNiv, FAIAC1 = l_FaiAc1, FAIAC2 = l_FaiAc2, FAIAC3 = l_FaiAc3, FAIAC4 = l_FaiAc4,
                                   FAIAC5 = l_FaiAc5, FAIAC6 = l_FaiAc6, FAIAC7 = l_FaiAc7, FAIPT1 = l_FaiPt1, FAIPT2 = l_FaiPt2,
                                   FAIPT3 = l_FaiPt3, FAIPT4 = l_FaiPt4, FAIPT5 = l_FaiPt5, FAIPT6 = l_FaiPt6, FAIPT7 = l_FaiPt7,
                                   FAIREF = l_FaiRef, CREAC1 = l_CreAc1, CREFX1 = l_CreFx1, QTDCR1 = l_QtdCr1, CREAC2 = l_CreAc2,
                                   CREFX2 = l_CreFx2, QTDCR2 = l_QtdCr2, CREAC3 = l_CreAc3, CREFX3 = l_CreFx3, QTDCR3 = l_QtdCr3,
                                   CREAC4 = l_CreAc4, CREFX4 = l_CreFx4, QTDCR4 = l_QtdCr4, CREAC5 = l_CreAc5, CREFX5 = l_CreFx5,
                                   QTDCR5 = l_QtdCr5, CREAC6 = l_CreAc6, CREFX6 = l_CreFx6, QTDCR6 = l_QtdCr6, PRMRT1 = l_PrmRt1,
                                   DINPR1 = l_DinPr1, DFNPR1 = l_DfnPr1, PRMRT2 = l_PrmRt2, DINPR2 = l_DinPr2, DFNPR2 = l_DfnPr2,
                                   PRMRT3 = l_PrmRt3, DINPR3 = l_DinPr3, DFNPR3 = l_DfnPr3, GRACON = l_GraCon, CONINT = l_ConInt,
                                   TOLINT = l_TolInt, TOLACP = l_TolAcp, DATSAI = l_DatSai, HORSAI = l_HorSai, SEQSAI = l_SeqSai,
                                   VALAUT = l_ValAut, CODARC = l_CodArc, DATARC = l_DatArc, HORARC = l_HorArc, SEQARC = l_SeqArc,
                                   NOMFUN = '', NUMPIS = 0, CONREA = l_ConRea, RECVIS = 0,
                                   NOMPES = l_nompes, DDIFON = l_ddifon, DDDFON = l_dddfon, NUMFON = l_numfon, NUMEMP = 0,
                                   TIPCOL = 0, NUMCAD = 0, TIPDOC = 0, NUMDOC = '0', NUMMAT = '0', PROPAC = '0', NUMCAN = p_NumCan,
                                   USARFA = l_usarfa
                WHERE NUMFIS = l_CraPri;
            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_CANCON: Erro no UPDATE na tabela R070CON.';
            END;
        ELSE
            BEGIN
                INSERT INTO R070CON (IDTPES,   NUMCRA,   TECCRA,   CHCPRI,   NUMFIS,   TIPCRA,   CODPRM,   PRMSAB,   PRMDOM,   PRMFER,
                                     SENCOL,   SITCRA,   INIVAL,   DATVAL,   INIAFA,   DATAFA,   MSGACC,   DATMSG,   QTDMSG,   MSGATU,
                                     CONIAL,   TEMALM,   VERAFA,   USABIO,   VERPRM,   CONFAI,   CONADP,   CONCRE,   CONPAC,   TEMPAC,
                                     BLOAUT,   BLOFAL,   NIVATU,   DATNIV,   HORNIV,   SEQNIV,   FAIAC1,   FAIAC2,   FAIAC3,   FAIAC4,
                                     FAIAC5,   FAIAC6,   FAIAC7,   FAIPT1,   FAIPT2,   FAIPT3,   FAIPT4,   FAIPT5,   FAIPT6,   FAIPT7,
                                     FAIREF,   CREAC1,   CREFX1,   QTDCR1,   CREAC2,   CREFX2,   QTDCR2,   CREAC3,   CREFX3,   QTDCR3,
                                     CREAC4,   CREFX4,   QTDCR4,   CREAC5,   CREFX5,   QTDCR5,   CREAC6,   CREFX6,   QTDCR6,   PRMRT1,
                                     DINPR1,   DFNPR1,   PRMRT2,   DINPR2,   DFNPR2,   PRMRT3,   DINPR3,   DFNPR3,   GRACON,   CONINT,
                                     TOLINT,   TOLACP,   DATSAI,   HORSAI,   SEQSAI,   VALAUT,   CODARC,   DATARC,   HORARC,   SEQARC,
                                     NOMFUN,   NUMPIS,   CONREA,   NOMPES,   DDIFON,   DDDFON,   NUMFON,   RECVIS,   NUMEMP,   TIPCOL,
                                     NUMCAD,   TIPDOC,   NUMDOC,   NUMMAT,   PROPAC,   NUMCAN,   PROPRE,   USARFA)
                             VALUES (l_IdtPes, l_NumCra, l_TecCra, l_ChcPri, l_NumFis, l_TipCra, p_CodPrm, l_PrmSab, l_PrmDom, l_PrmFer,
                                     l_SenCol, l_Situa , l_IniVal, l_auxval, l_IniAfa, l_DatAfa, l_MsgAcc, l_DatMsg, l_QtdMsg, l_MsgAtu,
                                     l_ConIal, l_TemAlm, l_VerAfa, l_UsaBio, l_VerPrm, l_ConFai, l_ConAdp, l_ConCre, l_ConPac, l_TemPac,
                                     l_BloAut, l_BloFal, l_NivAtu, l_DatNiv, l_HorNiv, l_SeqNiv, l_FaiAc1, l_FaiAc2, l_FaiAc3, l_FaiAc4,
                                     l_FaiAc5, l_FaiAc6, l_FaiAc7, l_FaiPt1, l_FaiPt2, l_FaiPt3, l_FaiPt4, l_FaiPt5, l_FaiPt6, l_FaiPt7,
                                     l_FaiRef, l_CreAc1, l_CreFx1, l_QtdCr1, l_CreAc2, l_CreFx2, l_QtdCr2, l_CreAc3, l_CreFx3, l_QtdCr3,
                                     l_CreAc4, l_CreFx4, l_QtdCr4, l_CreAc5, l_CreFx5, l_QtdCr5, l_CreAc6, l_CreFx6, l_QtdCr6, l_PrmRt1,
                                     l_DinPr1, l_DfnPr1, l_PrmRt2, l_DinPr2, l_DfnPr2, l_PrmRt3, l_DinPr3, l_DfnPr3, l_GraCon, l_ConInt,
                                     l_TolInt, l_TolAcp, l_DatSai, l_HorSai, l_SeqSai, l_ValAut, l_CodArc, l_DatArc, l_HorArc, l_SeqArc,
                                     '', 0, l_ConRea,    l_nompes, l_ddifon, l_dddfon, l_numfon, 0, 0, 0, 0, 0, '0', '0', '0', p_NumCan,
                                     0, l_usarfa);
            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_CANCON: Erro no INSERT na tabela R070CON.';
            END;
        END IF;

        /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
        IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
            SP_PEND21(l_crapri);
        END IF;

        /*Atualiza os demais Crachás*/
        /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
        IF (l_tecpri = 1) THEN
            /*Atualiza o crachá de proximidade*/
            IF (l_numpro <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numpro, l_numpro_ret OUT);
                  /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numpro);
                END IF;
            END IF;
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;

        /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
        ELSIF (l_tecpri = 2) THEN
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        END IF;

        /*Verifica se Gera o Comando IncludePerson*/
        IF (l_iPerson = TRUE) THEN 
            /*Gera o Include Person*/
            SP_PEND19(p_numcra, l_idtpes);
        END IF;

        /*Atualiza a Controle*/
       SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);
    END IF;
END		SENIOR;21cSP_INTSTR
SP_DATSTR
SP_MAPFIS
SP_RETFON
SP_PEND21
SP_VERCON
SP_ATUFIS
SP_PEND19
SP_ATUTSI
ùP␀␀

/* Historico de Cracha - Candidatos */
PROCEDURE SP_CANCON(P_DATENT DATE,P_HORENT NUMBER,P_NUMCAN NUMBER,P_NUMCRA NUMBER,P_CODPRM NUMBER,P_DATVAL DATE,P_HORVAL NUMBER)
 IS

/* Campos da tabela R070CON */
    l_IdtPes  VARCHAR2(23);
    l_NumCra  NUMBER(12);
    l_TecCra  NUMBER(1);
    l_ChcPri  NUMBER(12);
    l_NumFis  NUMBER(12);
    l_TipCra  NUMBER(2);
    l_CodPrm  NUMBER(5);
    l_PrmSab  NUMBER(5);
    l_PrmDom  NUMBER(5);
    l_PrmFer  NUMBER(5);
    l_SenCol  VARCHAR2(6);
    l_SitCra  NUMBER(2);
    l_IniVal  VARCHAR2(16);
    l_DatVal  VARCHAR2(16);
    l_IniAfa  VARCHAR2(16);
    l_DatAfa  VARCHAR2(16);
    l_MsgAcc  VARCHAR2(32);
    l_DatMsg  VARCHAR2(16);
    l_QtdMsg  NUMBER(2);
    l_MsgAtu  NUMBER(2);
    l_ConIal  NUMBER(1);
    l_TemAlm  NUMBER(3);
    l_VerAfa  NUMBER(1);
    l_UsaBio  NUMBER(1);
    l_VerPrm  NUMBER(1);
    l_ConFai  NUMBER(1);
    l_ConAdp  NUMBER(1);
    l_ConCre  NUMBER(1);
    l_ConPac  NUMBER(1);
    l_TemPac  NUMBER(3);
    l_ConRea  NUMBER(1);
    l_BloAut  NUMBER(1);
    l_BloFal  NUMBER(1);
    l_NivAtu  VARCHAR2(5);
    l_DatNiv  DATE;
    l_HorNiv  NUMBER(5);
    l_SeqNiv  NUMBER(6);
    l_FaiAc1  VARCHAR2(56);
    l_FaiAc2  VARCHAR2(56);
    l_FaiAc3  VARCHAR2(56);
    l_FaiAc4  VARCHAR2(56);
    l_FaiAc5  VARCHAR2(56);
    l_FaiAc6  VARCHAR2(56);
    l_FaiAc7  VARCHAR2(56);
    l_FaiPt1  VARCHAR2(56);
    l_FaiPt2  VARCHAR2(56);
    l_FaiPt3  VARCHAR2(56);
    l_FaiPt4  VARCHAR2(56);
    l_FaiPt5  VARCHAR2(56);
    l_FaiPt6  VARCHAR2(56);
    l_FaiPt7  VARCHAR2(56);
    l_FaiRef  VARCHAR2(56);
    l_CreAc1  NUMBER(2);
    l_CreFx1  VARCHAR2(8);
    l_QtdCr1  NUMBER(2);
    l_CreAc2  NUMBER(2);
    l_CreFx2  VARCHAR2(8);
    l_QtdCr2  NUMBER(2);
    l_CreAc3  NUMBER(2);
    l_CreFx3  VARCHAR2(8);
    l_QtdCr3  NUMBER(2);
    l_CreAc4  NUMBER(2);
    l_CreFx4  VARCHAR2(8);
    l_QtdCr4  NUMBER(2);
    l_CreAc5  NUMBER(2);
    l_CreFx5  VARCHAR2(8);
    l_QtdCr5  NUMBER(2);
    l_CreAc6  NUMBER(2);
    l_CreFx6  VARCHAR2(8);
    l_QtdCr6  NUMBER(2);
    l_PrmRt1  NUMBER(5);
    l_DinPr1  VARCHAR2(10);
    l_DfnPr1  VARCHAR2(10);
    l_PrmRt2  NUMBER(5);
    l_DinPr2  VARCHAR2(10);
    l_DfnPr2  VARCHAR2(10);
    l_PrmRt3  NUMBER(5);
    l_situa   CHAR(1);
    l_situaAnt CHAR(1);
    l_qtdIdtPes NUMBER(2);
    l_iPerson BOOLEAN;
    l_numpro_ret BOOLEAN;
    l_numsma_ret BOOLEAN;
    l_datahora CHAR(10);
    l_DinPr3  VARCHAR2(10);
    l_DfnPr3  VARCHAR2(10);
    l_GraCon  NUMBER(3);
    l_ConInt  NUMBER(1);
    l_TolInt  NUMBER(3);
    l_TolAcp  NUMBER(2);
    l_comando_nulo BOOLEAN;
    l_DatSai       DATE;
    l_HorSai       NUMBER(5);
    l_SeqSai       NUMBER(6);
    l_ValAut       NUMBER(1);
    l_CodArc       NUMBER(5);
    l_DatArc       DATE;
    l_HorArc       NUMBER(5);
    l_SeqArc       NUMBER(6);
    l_numcracex    NUMBER(12);

    /* Atributos Auxiliares. */
    l_auxval       CHAR(16);
    l_TipPes       CHAR(2);
    l_NumBar       NUMBER(12);
    l_NumPro       NUMBER(12);
    l_NumSma       NUMBER(12);
    l_CraPri       NUMBER(12);
    l_TecPri       CHAR(1);
    l_DatStr       CHAR(6);
    l_HorStr       CHAR(4);
    l_NumCan       CHAR(7);
    l_datatu       CHAR(16);
    l_data_atual   DATE;
    l_hora_atual   NUMBER(4);
    l_segu_atual   NUMBER(2);
    l_DatAtuStr    CHAR(6);
    l_HorAtuStr    CHAR(4);
    l_seqatu       NUMBER(2);
    l_seqstr       CHAR(2);
    l_nompes       VARCHAR2(40);
    l_ddifon       NUMBER(3);
    l_dddfon       NUMBER(3);
    l_numfon       VARCHAR2(20);
    l_usarfastr    CHAR(1);
    l_usarfa       NUMBER(1);

BEGIN
    IF (p_NumCra > 0) THEN
        /* Monta IDTPES*/
        SP_INTSTR(13, '99', l_TipPes OUT);
        SP_INTSTR(p_NumCan, '9999999', l_NumCan OUT);

        l_IdtPes := l_TipPes||l_NumCan;

        /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
        l_idtpes := lTrim(l_idtpes);
        l_idtpes := rTrim(l_idtpes);

        LOOP
            /*Controle do Loop.*/
            IF (Length(l_idtpes) > 22) THEN
                EXIT;
            END IF;
            l_idtpes := ' '||l_idtpes;
        END LOOP;

        l_NumCra := p_NumCra;
        l_TecCra := l_TecPri;
        l_ChcPri := 0;
        l_NumFis := l_NumCra;
        l_TipCra := 13;
        l_CodPrm := p_CodPrm;
        l_PrmSab := 0;
        l_PrmDom := 0;
        l_PrmFer := 0;
        l_SenCol := ' ';
        l_SitCra := 0;

        SP_DATSTR(p_DatEnt, 'DDMMYY', l_DatStr OUT);
        SP_INTSTR(p_HorEnt, 'HHMM', l_HorStr OUT);
        l_IniVal := l_DatStr||l_HorStr||'000000';

        SP_DATSTR(p_DatVal, 'DDMMYY', l_DatStr OUT);
        SP_INTSTR(p_HorVal, 'HHMM', l_HorStr OUT);
        l_DatVal := l_DatStr||l_HorStr||'000000';

        /* converte a data atual para verificar se existe crachá válido na r070con */
        l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
        l_data_atual := CURDATE();
        l_segu_atual := SECOND(CURTIME());

        /* data atual no formato string (r070con) */
        SP_DATSTR(l_data_atual,'DDMMYY',l_datatustr OUT);
        SP_INTSTR(l_hora_atual,'HHMM',l_horatustr OUT);
        l_seqatu := SECOND(CURTIME());
        SP_INTSTR(l_seqatu, '99', l_seqstr OUT);
        l_datatu := l_datAtuStr||l_horAtuStr||l_seqstr||'0000';

        /* YYMMDDHHMMSEQ0000 */
        l_datatu := SUBSTRING(l_datatu,5,2)||SUBSTRING(l_datatu,3,2)||SUBSTRING(l_datatu,1,2)||SUBSTRING(l_datatu,7,10);

        l_IniAfa := '0000000000000000';
        l_DatAfa := '0000000000000000';
        l_MsgAcc := ' ';
        l_DatMsg := '0000000000000000';
        l_QtdMsg := 0;
        l_MsgAtu := 0;
        l_ConIal := 0;
        l_TemAlm := 0;
        l_VerAfa := 0;
        l_UsaBio := 1; /* Não utiliza biometria. */
        l_VerPrm := 1; /* Sempre verifica permissão */
        l_ConFai := 0;
        l_ConAdp := 0;
        l_ConCre := 0;
        l_ConPac := 0;
        l_TemPac := 0;
        l_ConRea := 1;
        l_BloAut := 0;
        l_BloFal := 0;
        l_NivAtu := '99000';
        l_DatNiv := CURDATE(); /* Data atual. */
        l_HorNiv := 0; /* Hora atual. */
        l_SeqNiv := SECOND(CURTIME()); /* Segundo atual. */

        l_FaiAc1 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc2 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc3 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc4 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc5 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc6 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc7 := '00002359240024002400240024002400240024002400240024002400';

        l_FaiPt1 := l_FaiAc1;
        l_FaiPt2 := l_FaiAc2;
        l_FaiPt3 := l_FaiAc3;
        l_FaiPt4 := l_FaiAc4;
        l_FaiPt5 := l_FaiAc5;
        l_FaiPt6 := l_FaiAc6;
        l_FaiPt7 := l_FaiAc7;

        l_FaiRef := '24002400240024002400240024002400240024002400240024002400';

        l_CreAc1 := 0;
        l_CreFx1 := '24002400';
        l_QtdCr1 := l_CreAc1;
        l_CreAc2 := 0;
        l_CreFx2 := '24002400';
        l_QtdCr2 := l_CreAc2;
        l_CreAc3 := 0;
        l_CreFx3 := '24002400';
        l_QtdCr3 := l_CreAc3;
        l_CreAc4 := 0;
        l_CreFx4 := '24002400';
        l_QtdCr4 := l_CreAc4;
        l_CreAc5 := 0;
        l_CreFx5 := '24002400';
        l_QtdCr5 := l_CreAc5;
        l_CreAc6 := 0;
        l_CreFx6 := '24002400';
        l_QtdCr6 := l_CreAc6;
        l_situa  := '0';
        l_situaAnt:= '1';

        l_PrmRt1 := 0;
        l_DinPr1 := '0000000000';
        l_DfnPr1 := '0000000000';
        l_PrmRt2 := 0;
        l_DinPr2 := '0000000000';
        l_DfnPr2 := '0000000000';
        l_PrmRt3 := 0;
        l_DinPr3 := '0000000000';
        l_DfnPr3 := '0000000000';

        l_GraCon := 50;
        l_ConInt := 0;
        l_TolInt := 0;
        l_TolAcp := 0;
        l_DatSai := '31/12/1900,00:00:00';
        l_HorSai := 0;
        l_SeqSai := 0;
        l_ValAut := 0;
        l_CodArc := 0;
        l_DatArc := '31/12/1900,00:00:00';
        l_HorArc := 0;
        l_SeqArc := 0;

        l_datahora := l_datstr || l_horstr;
        l_auxval := l_datahora||'000000';

        /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
        SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

        IF (l_crapri = 0) THEN
            l_crapri := p_numcra;
            /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
            l_teccra := 1;
        ELSE
            l_teccra := l_tecpri;
        END IF;
        /* Atualiza o número físico */
        l_numfis := l_crapri;

        /* Atualiza R070CON */
        l_comando_nulo:=FALSE;
        BEGIN
            SELECT NUMCRA, SITCRA INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SPVISCON: Erro em R070CON - TOO MANY ROWS';
            WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
            WHEN OTHERS THEN RAISERROR 103 'SPVISCON: Erro no SELECT R070CON 5.';
        END;

        /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
        BEGIN
            SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON
             WHERE IDTPES = l_idtpes AND SITCRA = 0 AND ( SUBSTRING(DATVAL,5,2)
                                                        ||SUBSTRING(DATVAL,3,2)
                                                        ||SUBSTRING(DATVAL,1,2)
                                                        ||SUBSTRING(DATVAL,7,10) > l_datatu
                                                        OR DATVAL = '3112502359000000');
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No SELECT R070CON (IdtPes).';
        END;

        IF (l_qtdIdtPes > 0) THEN
            l_iPerson := FALSE;
        ELSE
            l_iPerson := TRUE;
        END IF;

        SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

        l_numcracex := 0;
        BEGIN
            SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        IF (l_numcracex = p_numcra) THEN
          l_situa := '1';
        END IF;

        /* Assinala na tabela Controle que o Candidato utiliza reconhecimento facial */
        BEGIN
            SELECT USARFA INTO l_usarfastr FROM R122CEX WHERE NUMCAN = p_NumCan;
        EXCEPTION
            WHEN OTHERS THEN
                l_usarfastr := 'N';
        END;
        IF  l_usarfastr = 'S' THEN
            l_usarfa := 1;
        ELSE
            l_usarfa := 0;
        END IF;

        IF (l_comando_nulo = FALSE) THEN
            BEGIN
                UPDATE R070CON SET IDTPES = l_IdtPes, NUMCRA = l_NumCra, TECCRA = l_TecCra, CHCPRI = l_ChcPri, NUMFIS = l_NumFis,
                                   TIPCRA = l_TipCra, CODPRM = p_CodPrm, PRMSAB = l_PrmSab, PRMDOM = l_PrmDom, PRMFER = l_PrmFer,
                                   SENCOL = l_SenCol, SITCRA = l_Situa , INIVAL = l_IniVal, DATVAL = l_DatVal, INIAFA = l_IniAfa,
                                   DATAFA = l_DatAfa, MSGACC = l_MsgAcc, DATMSG = l_DatMsg, QTDMSG = l_QtdMsg, MSGATU = l_MsgAtu,
                                   CONIAL = l_ConIal, TEMALM = l_TemAlm, VERAFA = l_VerAfa, USABIO = l_UsaBio, VERPRM = l_VerPrm,
                                   CONFAI = l_ConFai, CONADP = l_ConAdp, CONCRE = l_ConCre, CONPAC = l_ConPac, TEMPAC = l_TemPac,
                                   BLOAUT = l_BloAut, BLOFAL = l_BloFal, NIVATU = l_NivAtu, DATNIV = l_DatNiv, HORNIV = l_HorNiv,
                                   SEQNIV = l_SeqNiv, FAIAC1 = l_FaiAc1, FAIAC2 = l_FaiAc2, FAIAC3 = l_FaiAc3, FAIAC4 = l_FaiAc4,
                                   FAIAC5 = l_FaiAc5, FAIAC6 = l_FaiAc6, FAIAC7 = l_FaiAc7, FAIPT1 = l_FaiPt1, FAIPT2 = l_FaiPt2,
                                   FAIPT3 = l_FaiPt3, FAIPT4 = l_FaiPt4, FAIPT5 = l_FaiPt5, FAIPT6 = l_FaiPt6, FAIPT7 = l_FaiPt7,
                                   FAIREF = l_FaiRef, CREAC1 = l_CreAc1, CREFX1 = l_CreFx1, QTDCR1 = l_QtdCr1, CREAC2 = l_CreAc2,
                                   CREFX2 = l_CreFx2, QTDCR2 = l_QtdCr2, CREAC3 = l_CreAc3, CREFX3 = l_CreFx3, QTDCR3 = l_QtdCr3,
                                   CREAC4 = l_CreAc4, CREFX4 = l_CreFx4, QTDCR4 = l_QtdCr4, CREAC5 = l_CreAc5, CREFX5 = l_CreFx5,
                                   QTDCR5 = l_QtdCr5, CREAC6 = l_CreAc6, CREFX6 = l_CreFx6, QTDCR6 = l_QtdCr6, PRMRT1 = l_PrmRt1,
                                   DINPR1 = l_DinPr1, DFNPR1 = l_DfnPr1, PRMRT2 = l_PrmRt2, DINPR2 = l_DinPr2, DFNPR2 = l_DfnPr2,
                                   PRMRT3 = l_PrmRt3, DINPR3 = l_DinPr3, DFNPR3 = l_DfnPr3, GRACON = l_GraCon, CONINT = l_ConInt,
                                   TOLINT = l_TolInt, TOLACP = l_TolAcp, DATSAI = l_DatSai, HORSAI = l_HorSai, SEQSAI = l_SeqSai,
                                   VALAUT = l_ValAut, CODARC = l_CodArc, DATARC = l_DatArc, HORARC = l_HorArc, SEQARC = l_SeqArc,
                                   NOMFUN = '', NUMPIS = 0, CONREA = l_ConRea, RECVIS = 0,
                                   NOMPES = l_nompes, DDIFON = l_ddifon, DDDFON = l_dddfon, NUMFON = l_numfon, NUMEMP = 0,
                                   TIPCOL = 0, NUMCAD = 0, TIPDOC = 0, NUMDOC = '0', NUMMAT = '0', PROPAC = '0', NUMCAN = p_NumCan,
                                   USARFA = l_usarfa
                WHERE NUMFIS = l_CraPri;
            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_CANCON: Erro no UPDATE na tabela R070CON.';
            END;
        ELSE
            BEGIN
                INSERT INTO R070CON (IDTPES,   NUMCRA,   TECCRA,   CHCPRI,   NUMFIS,   TIPCRA,   CODPRM,   PRMSAB,   PRMDOM,   PRMFER,
                                     SENCOL,   SITCRA,   INIVAL,   DATVAL,   INIAFA,   DATAFA,   MSGACC,   DATMSG,   QTDMSG,   MSGATU,
                                     CONIAL,   TEMALM,   VERAFA,   USABIO,   VERPRM,   CONFAI,   CONADP,   CONCRE,   CONPAC,   TEMPAC,
                                     BLOAUT,   BLOFAL,   NIVATU,   DATNIV,   HORNIV,   SEQNIV,   FAIAC1,   FAIAC2,   FAIAC3,   FAIAC4,
                                     FAIAC5,   FAIAC6,   FAIAC7,   FAIPT1,   FAIPT2,   FAIPT3,   FAIPT4,   FAIPT5,   FAIPT6,   FAIPT7,
                                     FAIREF,   CREAC1,   CREFX1,   QTDCR1,   CREAC2,   CREFX2,   QTDCR2,   CREAC3,   CREFX3,   QTDCR3,
                                     CREAC4,   CREFX4,   QTDCR4,   CREAC5,   CREFX5,   QTDCR5,   CREAC6,   CREFX6,   QTDCR6,   PRMRT1,
                                     DINPR1,   DFNPR1,   PRMRT2,   DINPR2,   DFNPR2,   PRMRT3,   DINPR3,   DFNPR3,   GRACON,   CONINT,
                                     TOLINT,   TOLACP,   DATSAI,   HORSAI,   SEQSAI,   VALAUT,   CODARC,   DATARC,   HORARC,   SEQARC,
                                     NOMFUN,   NUMPIS,   CONREA,   NOMPES,   DDIFON,   DDDFON,   NUMFON,   RECVIS,   NUMEMP,   TIPCOL,
                                     NUMCAD,   TIPDOC,   NUMDOC,   NUMMAT,   PROPAC,   NUMCAN,   PROPRE,   USARFA)
                             VALUES (l_IdtPes, l_NumCra, l_TecCra, l_ChcPri, l_NumFis, l_TipCra, p_CodPrm, l_PrmSab, l_PrmDom, l_PrmFer,
                                     l_SenCol, l_Situa , l_IniVal, l_auxval, l_IniAfa, l_DatAfa, l_MsgAcc, l_DatMsg, l_QtdMsg, l_MsgAtu,
                                     l_ConIal, l_TemAlm, l_VerAfa, l_UsaBio, l_VerPrm, l_ConFai, l_ConAdp, l_ConCre, l_ConPac, l_TemPac,
                                     l_BloAut, l_BloFal, l_NivAtu, l_DatNiv, l_HorNiv, l_SeqNiv, l_FaiAc1, l_FaiAc2, l_FaiAc3, l_FaiAc4,
                                     l_FaiAc5, l_FaiAc6, l_FaiAc7, l_FaiPt1, l_FaiPt2, l_FaiPt3, l_FaiPt4, l_FaiPt5, l_FaiPt6, l_FaiPt7,
                                     l_FaiRef, l_CreAc1, l_CreFx1, l_QtdCr1, l_CreAc2, l_CreFx2, l_QtdCr2, l_CreAc3, l_CreFx3, l_QtdCr3,
                                     l_CreAc4, l_CreFx4, l_QtdCr4, l_CreAc5, l_CreFx5, l_QtdCr5, l_CreAc6, l_CreFx6, l_QtdCr6, l_PrmRt1,
                                     l_DinPr1, l_DfnPr1, l_PrmRt2, l_DinPr2, l_DfnPr2, l_PrmRt3, l_DinPr3, l_DfnPr3, l_GraCon, l_ConInt,
                                     l_TolInt, l_TolAcp, l_DatSai, l_HorSai, l_SeqSai, l_ValAut, l_CodArc, l_DatArc, l_HorArc, l_SeqArc,
                                     '', 0, l_ConRea,    l_nompes, l_ddifon, l_dddfon, l_numfon, 0, 0, 0, 0, 0, '0', '0', '0', p_NumCan,
                                     0, l_usarfa);
            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_CANCON: Erro no INSERT na tabela R070CON.';
            END;
        END IF;

        /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
        IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
            SP_PEND21(l_crapri);
        END IF;

        /*Atualiza os demais Crachás*/
        /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
        IF (l_tecpri = 1) THEN
            /*Atualiza o crachá de proximidade*/
            IF (l_numpro <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numpro, l_numpro_ret OUT);
                  /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numpro);
                END IF;
            END IF;
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;

        /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
        ELSIF (l_tecpri = 2) THEN
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        END IF;

        /*Verifica se Gera o Comando IncludePerson*/
        IF (l_iPerson = TRUE) THEN 
            /*Gera o Include Person*/
            SP_PEND19(p_numcra, l_idtpes);
        END IF;

        /*Atualiza a Controle*/
       SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);
    END IF;
END		SENIOR;22cSP_INTSTR
SP_DATSTR
SP_MAPFIS
SP_RETFON
SP_PEND21
SP_VERCON
SP_ATUFIS
SP_PEND19
SP_ATUTSI
ùP␀␀

/* Historico de Cracha - Candidatos */
PROCEDURE SP_CANCON(P_DATENT DATE,P_HORENT NUMBER,P_NUMCAN NUMBER,P_NUMCRA NUMBER,P_CODPRM NUMBER,P_DATVAL DATE,P_HORVAL NUMBER)
 IS

/* Campos da tabela R070CON */
    l_IdtPes  VARCHAR2(23);
    l_NumCra  NUMBER(12);
    l_TecCra  NUMBER(1);
    l_ChcPri  NUMBER(12);
    l_NumFis  NUMBER(12);
    l_TipCra  NUMBER(2);
    l_CodPrm  NUMBER(5);
    l_PrmSab  NUMBER(5);
    l_PrmDom  NUMBER(5);
    l_PrmFer  NUMBER(5);
    l_SenCol  VARCHAR2(6);
    l_SitCra  NUMBER(2);
    l_IniVal  VARCHAR2(16);
    l_DatVal  VARCHAR2(16);
    l_IniAfa  VARCHAR2(16);
    l_DatAfa  VARCHAR2(16);
    l_MsgAcc  VARCHAR2(32);
    l_DatMsg  VARCHAR2(16);
    l_QtdMsg  NUMBER(2);
    l_MsgAtu  NUMBER(2);
    l_ConIal  NUMBER(1);
    l_TemAlm  NUMBER(3);
    l_VerAfa  NUMBER(1);
    l_UsaBio  NUMBER(1);
    l_VerPrm  NUMBER(1);
    l_ConFai  NUMBER(1);
    l_ConAdp  NUMBER(1);
    l_ConCre  NUMBER(1);
    l_ConPac  NUMBER(1);
    l_TemPac  NUMBER(3);
    l_ConRea  NUMBER(1);
    l_BloAut  NUMBER(1);
    l_BloFal  NUMBER(1);
    l_NivAtu  VARCHAR2(5);
    l_DatNiv  DATE;
    l_HorNiv  NUMBER(5);
    l_SeqNiv  NUMBER(6);
    l_FaiAc1  VARCHAR2(56);
    l_FaiAc2  VARCHAR2(56);
    l_FaiAc3  VARCHAR2(56);
    l_FaiAc4  VARCHAR2(56);
    l_FaiAc5  VARCHAR2(56);
    l_FaiAc6  VARCHAR2(56);
    l_FaiAc7  VARCHAR2(56);
    l_FaiPt1  VARCHAR2(56);
    l_FaiPt2  VARCHAR2(56);
    l_FaiPt3  VARCHAR2(56);
    l_FaiPt4  VARCHAR2(56);
    l_FaiPt5  VARCHAR2(56);
    l_FaiPt6  VARCHAR2(56);
    l_FaiPt7  VARCHAR2(56);
    l_FaiRef  VARCHAR2(56);
    l_CreAc1  NUMBER(2);
    l_CreFx1  VARCHAR2(8);
    l_QtdCr1  NUMBER(2);
    l_CreAc2  NUMBER(2);
    l_CreFx2  VARCHAR2(8);
    l_QtdCr2  NUMBER(2);
    l_CreAc3  NUMBER(2);
    l_CreFx3  VARCHAR2(8);
    l_QtdCr3  NUMBER(2);
    l_CreAc4  NUMBER(2);
    l_CreFx4  VARCHAR2(8);
    l_QtdCr4  NUMBER(2);
    l_CreAc5  NUMBER(2);
    l_CreFx5  VARCHAR2(8);
    l_QtdCr5  NUMBER(2);
    l_CreAc6  NUMBER(2);
    l_CreFx6  VARCHAR2(8);
    l_QtdCr6  NUMBER(2);
    l_PrmRt1  NUMBER(5);
    l_DinPr1  VARCHAR2(10);
    l_DfnPr1  VARCHAR2(10);
    l_PrmRt2  NUMBER(5);
    l_DinPr2  VARCHAR2(10);
    l_DfnPr2  VARCHAR2(10);
    l_PrmRt3  NUMBER(5);
    l_situa   CHAR(1);
    l_situaAnt CHAR(1);
    l_qtdIdtPes NUMBER(2);
    l_iPerson BOOLEAN;
    l_numpro_ret BOOLEAN;
    l_numsma_ret BOOLEAN;
    l_datahora CHAR(10);
    l_DinPr3  VARCHAR2(10);
    l_DfnPr3  VARCHAR2(10);
    l_GraCon  NUMBER(3);
    l_ConInt  NUMBER(1);
    l_TolInt  NUMBER(3);
    l_TolAcp  NUMBER(2);
    l_comando_nulo BOOLEAN;
    l_DatSai       DATE;
    l_HorSai       NUMBER(5);
    l_SeqSai       NUMBER(6);
    l_ValAut       NUMBER(1);
    l_CodArc       NUMBER(5);
    l_DatArc       DATE;
    l_HorArc       NUMBER(5);
    l_SeqArc       NUMBER(6);
    l_numcracex    NUMBER(12);

    /* Atributos Auxiliares. */
    l_auxval       CHAR(16);
    l_TipPes       CHAR(2);
    l_NumBar       NUMBER(12);
    l_NumPro       NUMBER(12);
    l_NumSma       NUMBER(12);
    l_CraPri       NUMBER(12);
    l_TecPri       CHAR(1);
    l_DatStr       CHAR(6);
    l_HorStr       CHAR(4);
    l_NumCan       CHAR(7);
    l_datatu       CHAR(16);
    l_data_atual   DATE;
    l_hora_atual   NUMBER(4);
    l_segu_atual   NUMBER(2);
    l_DatAtuStr    CHAR(6);
    l_HorAtuStr    CHAR(4);
    l_seqatu       NUMBER(2);
    l_seqstr       CHAR(2);
    l_nompes       VARCHAR2(40);
    l_ddifon       NUMBER(3);
    l_dddfon       NUMBER(3);
    l_numfon       VARCHAR2(20);
    l_usarfastr    CHAR(1);
    l_usarfa       NUMBER(1);

BEGIN
    IF (p_NumCra > 0) THEN
        /* Monta IDTPES*/
        SP_INTSTR(13, '99', l_TipPes OUT);
        SP_INTSTR(p_NumCan, '9999999', l_NumCan OUT);

        l_IdtPes := l_TipPes||l_NumCan;

        /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
        l_idtpes := lTrim(l_idtpes);
        l_idtpes := rTrim(l_idtpes);

        LOOP
            /*Controle do Loop.*/
            IF (Length(l_idtpes) > 22) THEN
                EXIT;
            END IF;
            l_idtpes := ' '||l_idtpes;
        END LOOP;

        l_NumCra := p_NumCra;
        l_TecCra := l_TecPri;
        l_ChcPri := 0;
        l_NumFis := l_NumCra;
        l_TipCra := 13;
        l_CodPrm := p_CodPrm;
        l_PrmSab := 0;
        l_PrmDom := 0;
        l_PrmFer := 0;
        l_SenCol := ' ';
        l_SitCra := 0;

        SP_DATSTR(p_DatEnt, 'DDMMYY', l_DatStr OUT);
        SP_INTSTR(p_HorEnt, 'HHMM', l_HorStr OUT);
        l_IniVal := l_DatStr||l_HorStr||'000000';

        SP_DATSTR(p_DatVal, 'DDMMYY', l_DatStr OUT);
        SP_INTSTR(p_HorVal, 'HHMM', l_HorStr OUT);
        l_DatVal := l_DatStr||l_HorStr||'000000';

        /* converte a data atual para verificar se existe crachá válido na r070con */
        l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
        l_data_atual := CURDATE();
        l_segu_atual := SECOND(CURTIME());

        /* data atual no formato string (r070con) */
        SP_DATSTR(l_data_atual,'DDMMYY',l_datatustr OUT);
        SP_INTSTR(l_hora_atual,'HHMM',l_horatustr OUT);
        l_seqatu := SECOND(CURTIME());
        SP_INTSTR(l_seqatu, '99', l_seqstr OUT);
        l_datatu := l_datAtuStr||l_horAtuStr||l_seqstr||'0000';

        /* YYMMDDHHMMSEQ0000 */
        l_datatu := SUBSTRING(l_datatu,5,2)||SUBSTRING(l_datatu,3,2)||SUBSTRING(l_datatu,1,2)||SUBSTRING(l_datatu,7,10);

        l_IniAfa := '0000000000000000';
        l_DatAfa := '0000000000000000';
        l_MsgAcc := ' ';
        l_DatMsg := '0000000000000000';
        l_QtdMsg := 0;
        l_MsgAtu := 0;
        l_ConIal := 0;
        l_TemAlm := 0;
        l_VerAfa := 0;
        l_UsaBio := 1; /* Não utiliza biometria. */
        l_VerPrm := 1; /* Sempre verifica permissão */
        l_ConFai := 0;
        l_ConAdp := 0;
        l_ConCre := 0;
        l_ConPac := 0;
        l_TemPac := 0;
        l_ConRea := 1;
        l_BloAut := 0;
        l_BloFal := 0;
        l_NivAtu := '99000';
        l_DatNiv := CURDATE(); /* Data atual. */
        l_HorNiv := 0; /* Hora atual. */
        l_SeqNiv := SECOND(CURTIME()); /* Segundo atual. */

        l_FaiAc1 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc2 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc3 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc4 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc5 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc6 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc7 := '00002359240024002400240024002400240024002400240024002400';

        l_FaiPt1 := l_FaiAc1;
        l_FaiPt2 := l_FaiAc2;
        l_FaiPt3 := l_FaiAc3;
        l_FaiPt4 := l_FaiAc4;
        l_FaiPt5 := l_FaiAc5;
        l_FaiPt6 := l_FaiAc6;
        l_FaiPt7 := l_FaiAc7;

        l_FaiRef := '24002400240024002400240024002400240024002400240024002400';

        l_CreAc1 := 0;
        l_CreFx1 := '24002400';
        l_QtdCr1 := l_CreAc1;
        l_CreAc2 := 0;
        l_CreFx2 := '24002400';
        l_QtdCr2 := l_CreAc2;
        l_CreAc3 := 0;
        l_CreFx3 := '24002400';
        l_QtdCr3 := l_CreAc3;
        l_CreAc4 := 0;
        l_CreFx4 := '24002400';
        l_QtdCr4 := l_CreAc4;
        l_CreAc5 := 0;
        l_CreFx5 := '24002400';
        l_QtdCr5 := l_CreAc5;
        l_CreAc6 := 0;
        l_CreFx6 := '24002400';
        l_QtdCr6 := l_CreAc6;
        l_situa  := '0';
        l_situaAnt:= '1';

        l_PrmRt1 := 0;
        l_DinPr1 := '0000000000';
        l_DfnPr1 := '0000000000';
        l_PrmRt2 := 0;
        l_DinPr2 := '0000000000';
        l_DfnPr2 := '0000000000';
        l_PrmRt3 := 0;
        l_DinPr3 := '0000000000';
        l_DfnPr3 := '0000000000';

        l_GraCon := 50;
        l_ConInt := 0;
        l_TolInt := 0;
        l_TolAcp := 0;
        l_DatSai := '31/12/1900,00:00:00';
        l_HorSai := 0;
        l_SeqSai := 0;
        l_ValAut := 0;
        l_CodArc := 0;
        l_DatArc := '31/12/1900,00:00:00';
        l_HorArc := 0;
        l_SeqArc := 0;

        l_datahora := l_datstr || l_horstr;
        l_auxval := l_datahora||'000000';

        /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
        SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

        IF (l_crapri = 0) THEN
            l_crapri := p_numcra;
            /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
            l_teccra := 1;
        ELSE
            l_teccra := l_tecpri;
        END IF;
        /* Atualiza o número físico */
        l_numfis := l_crapri;

        /* Atualiza R070CON */
        l_comando_nulo:=FALSE;
        BEGIN
            SELECT NUMCRA, SITCRA INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SPVISCON: Erro em R070CON - TOO MANY ROWS';
            WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
            WHEN OTHERS THEN RAISERROR 103 'SPVISCON: Erro no SELECT R070CON 5.';
        END;

        /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
        BEGIN
            SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON
             WHERE IDTPES = l_idtpes AND SITCRA = 0 AND ( SUBSTRING(DATVAL,5,2)
                                                        ||SUBSTRING(DATVAL,3,2)
                                                        ||SUBSTRING(DATVAL,1,2)
                                                        ||SUBSTRING(DATVAL,7,10) > l_datatu
                                                        OR DATVAL = '3112502359000000');
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No SELECT R070CON (IdtPes).';
        END;

        IF (l_qtdIdtPes > 0) THEN
            l_iPerson := FALSE;
        ELSE
            l_iPerson := TRUE;
        END IF;

        SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

        l_numcracex := 0;
        BEGIN
            SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        IF (l_numcracex = p_numcra) THEN
          l_situa := '1';
        END IF;

        /* Assinala na tabela Controle que o Candidato utiliza reconhecimento facial */
        BEGIN
            SELECT USARFA INTO l_usarfastr FROM R122CEX WHERE NUMCAN = p_NumCan;
        EXCEPTION
            WHEN OTHERS THEN
                l_usarfastr := 'N';
        END;
        IF  l_usarfastr = 'S' THEN
            l_usarfa := 1;
        ELSE
            l_usarfa := 0;
        END IF;

        IF (l_comando_nulo = FALSE) THEN
            BEGIN
                UPDATE R070CON SET IDTPES = l_IdtPes, NUMCRA = l_NumCra, TECCRA = l_TecCra, CHCPRI = l_ChcPri, NUMFIS = l_NumFis,
                                   TIPCRA = l_TipCra, CODPRM = p_CodPrm, PRMSAB = l_PrmSab, PRMDOM = l_PrmDom, PRMFER = l_PrmFer,
                                   SENCOL = l_SenCol, SITCRA = l_Situa , INIVAL = l_IniVal, DATVAL = l_DatVal, INIAFA = l_IniAfa,
                                   DATAFA = l_DatAfa, MSGACC = l_MsgAcc, DATMSG = l_DatMsg, QTDMSG = l_QtdMsg, MSGATU = l_MsgAtu,
                                   CONIAL = l_ConIal, TEMALM = l_TemAlm, VERAFA = l_VerAfa, USABIO = l_UsaBio, VERPRM = l_VerPrm,
                                   CONFAI = l_ConFai, CONADP = l_ConAdp, CONCRE = l_ConCre, CONPAC = l_ConPac, TEMPAC = l_TemPac,
                                   BLOAUT = l_BloAut, BLOFAL = l_BloFal, NIVATU = l_NivAtu, DATNIV = l_DatNiv, HORNIV = l_HorNiv,
                                   SEQNIV = l_SeqNiv, FAIAC1 = l_FaiAc1, FAIAC2 = l_FaiAc2, FAIAC3 = l_FaiAc3, FAIAC4 = l_FaiAc4,
                                   FAIAC5 = l_FaiAc5, FAIAC6 = l_FaiAc6, FAIAC7 = l_FaiAc7, FAIPT1 = l_FaiPt1, FAIPT2 = l_FaiPt2,
                                   FAIPT3 = l_FaiPt3, FAIPT4 = l_FaiPt4, FAIPT5 = l_FaiPt5, FAIPT6 = l_FaiPt6, FAIPT7 = l_FaiPt7,
                                   FAIREF = l_FaiRef, CREAC1 = l_CreAc1, CREFX1 = l_CreFx1, QTDCR1 = l_QtdCr1, CREAC2 = l_CreAc2,
                                   CREFX2 = l_CreFx2, QTDCR2 = l_QtdCr2, CREAC3 = l_CreAc3, CREFX3 = l_CreFx3, QTDCR3 = l_QtdCr3,
                                   CREAC4 = l_CreAc4, CREFX4 = l_CreFx4, QTDCR4 = l_QtdCr4, CREAC5 = l_CreAc5, CREFX5 = l_CreFx5,
                                   QTDCR5 = l_QtdCr5, CREAC6 = l_CreAc6, CREFX6 = l_CreFx6, QTDCR6 = l_QtdCr6, PRMRT1 = l_PrmRt1,
                                   DINPR1 = l_DinPr1, DFNPR1 = l_DfnPr1, PRMRT2 = l_PrmRt2, DINPR2 = l_DinPr2, DFNPR2 = l_DfnPr2,
                                   PRMRT3 = l_PrmRt3, DINPR3 = l_DinPr3, DFNPR3 = l_DfnPr3, GRACON = l_GraCon, CONINT = l_ConInt,
                                   TOLINT = l_TolInt, TOLACP = l_TolAcp, DATSAI = l_DatSai, HORSAI = l_HorSai, SEQSAI = l_SeqSai,
                                   VALAUT = l_ValAut, CODARC = l_CodArc, DATARC = l_DatArc, HORARC = l_HorArc, SEQARC = l_SeqArc,
                                   NOMFUN = '', NUMPIS = 0, CONREA = l_ConRea, RECVIS = 0,
                                   NOMPES = l_nompes, DDIFON = l_ddifon, DDDFON = l_dddfon, NUMFON = l_numfon, NUMEMP = 0,
                                   TIPCOL = 0, NUMCAD = 0, TIPDOC = 0, NUMDOC = '0', NUMMAT = '0', PROPAC = '0', NUMCAN = p_NumCan,
                                   USARFA = l_usarfa
                WHERE NUMFIS = l_CraPri;
            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_CANCON: Erro no UPDATE na tabela R070CON.';
            END;
        ELSE
            BEGIN
                INSERT INTO R070CON (IDTPES,   NUMCRA,   TECCRA,   CHCPRI,   NUMFIS,   TIPCRA,   CODPRM,   PRMSAB,   PRMDOM,   PRMFER,
                                     SENCOL,   SITCRA,   INIVAL,   DATVAL,   INIAFA,   DATAFA,   MSGACC,   DATMSG,   QTDMSG,   MSGATU,
                                     CONIAL,   TEMALM,   VERAFA,   USABIO,   VERPRM,   CONFAI,   CONADP,   CONCRE,   CONPAC,   TEMPAC,
                                     BLOAUT,   BLOFAL,   NIVATU,   DATNIV,   HORNIV,   SEQNIV,   FAIAC1,   FAIAC2,   FAIAC3,   FAIAC4,
                                     FAIAC5,   FAIAC6,   FAIAC7,   FAIPT1,   FAIPT2,   FAIPT3,   FAIPT4,   FAIPT5,   FAIPT6,   FAIPT7,
                                     FAIREF,   CREAC1,   CREFX1,   QTDCR1,   CREAC2,   CREFX2,   QTDCR2,   CREAC3,   CREFX3,   QTDCR3,
                                     CREAC4,   CREFX4,   QTDCR4,   CREAC5,   CREFX5,   QTDCR5,   CREAC6,   CREFX6,   QTDCR6,   PRMRT1,
                                     DINPR1,   DFNPR1,   PRMRT2,   DINPR2,   DFNPR2,   PRMRT3,   DINPR3,   DFNPR3,   GRACON,   CONINT,
                                     TOLINT,   TOLACP,   DATSAI,   HORSAI,   SEQSAI,   VALAUT,   CODARC,   DATARC,   HORARC,   SEQARC,
                                     NOMFUN,   NUMPIS,   CONREA,   NOMPES,   DDIFON,   DDDFON,   NUMFON,   RECVIS,   NUMEMP,   TIPCOL,
                                     NUMCAD,   TIPDOC,   NUMDOC,   NUMMAT,   PROPAC,   NUMCAN,   PROPRE,   USARFA)
                             VALUES (l_IdtPes, l_NumCra, l_TecCra, l_ChcPri, l_NumFis, l_TipCra, p_CodPrm, l_PrmSab, l_PrmDom, l_PrmFer,
                                     l_SenCol, l_Situa , l_IniVal, l_auxval, l_IniAfa, l_DatAfa, l_MsgAcc, l_DatMsg, l_QtdMsg, l_MsgAtu,
                                     l_ConIal, l_TemAlm, l_VerAfa, l_UsaBio, l_VerPrm, l_ConFai, l_ConAdp, l_ConCre, l_ConPac, l_TemPac,
                                     l_BloAut, l_BloFal, l_NivAtu, l_DatNiv, l_HorNiv, l_SeqNiv, l_FaiAc1, l_FaiAc2, l_FaiAc3, l_FaiAc4,
                                     l_FaiAc5, l_FaiAc6, l_FaiAc7, l_FaiPt1, l_FaiPt2, l_FaiPt3, l_FaiPt4, l_FaiPt5, l_FaiPt6, l_FaiPt7,
                                     l_FaiRef, l_CreAc1, l_CreFx1, l_QtdCr1, l_CreAc2, l_CreFx2, l_QtdCr2, l_CreAc3, l_CreFx3, l_QtdCr3,
                                     l_CreAc4, l_CreFx4, l_QtdCr4, l_CreAc5, l_CreFx5, l_QtdCr5, l_CreAc6, l_CreFx6, l_QtdCr6, l_PrmRt1,
                                     l_DinPr1, l_DfnPr1, l_PrmRt2, l_DinPr2, l_DfnPr2, l_PrmRt3, l_DinPr3, l_DfnPr3, l_GraCon, l_ConInt,
                                     l_TolInt, l_TolAcp, l_DatSai, l_HorSai, l_SeqSai, l_ValAut, l_CodArc, l_DatArc, l_HorArc, l_SeqArc,
                                     '', 0, l_ConRea,    l_nompes, l_ddifon, l_dddfon, l_numfon, 0, 0, 0, 0, 0, '0', '0', '0', p_NumCan,
                                     0, l_usarfa);
            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_CANCON: Erro no INSERT na tabela R070CON.';
            END;
        END IF;

        /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
        IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
            SP_PEND21(l_crapri);
        END IF;

        /*Atualiza os demais Crachás*/
        /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
        IF (l_tecpri = 1) THEN
            /*Atualiza o crachá de proximidade*/
            IF (l_numpro <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numpro, l_numpro_ret OUT);
                  /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numpro);
                END IF;
            END IF;
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;

        /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
        ELSIF (l_tecpri = 2) THEN
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        END IF;

        /*Verifica se Gera o Comando IncludePerson*/
        IF (l_iPerson = TRUE) THEN 
            /*Gera o Include Person*/
            SP_PEND19(p_numcra, l_idtpes);
        END IF;

        /*Atualiza a Controle*/
       SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);
    END IF;
END		SENIOR;23cSP_INTSTR
SP_DATSTR
SP_MAPFIS
SP_RETFON
SP_PEND21
SP_VERCON
SP_ATUFIS
SP_PEND19
SP_ATUTSI
ùP␀␀

/* Historico de Cracha - Candidatos */
PROCEDURE SP_CANCON(P_DATENT DATE,P_HORENT NUMBER,P_NUMCAN NUMBER,P_NUMCRA NUMBER,P_CODPRM NUMBER,P_DATVAL DATE,P_HORVAL NUMBER)
 IS

/* Campos da tabela R070CON */
    l_IdtPes  VARCHAR2(23);
    l_NumCra  NUMBER(12);
    l_TecCra  NUMBER(1);
    l_ChcPri  NUMBER(12);
    l_NumFis  NUMBER(12);
    l_TipCra  NUMBER(2);
    l_CodPrm  NUMBER(5);
    l_PrmSab  NUMBER(5);
    l_PrmDom  NUMBER(5);
    l_PrmFer  NUMBER(5);
    l_SenCol  VARCHAR2(6);
    l_SitCra  NUMBER(2);
    l_IniVal  VARCHAR2(16);
    l_DatVal  VARCHAR2(16);
    l_IniAfa  VARCHAR2(16);
    l_DatAfa  VARCHAR2(16);
    l_MsgAcc  VARCHAR2(32);
    l_DatMsg  VARCHAR2(16);
    l_QtdMsg  NUMBER(2);
    l_MsgAtu  NUMBER(2);
    l_ConIal  NUMBER(1);
    l_TemAlm  NUMBER(3);
    l_VerAfa  NUMBER(1);
    l_UsaBio  NUMBER(1);
    l_VerPrm  NUMBER(1);
    l_ConFai  NUMBER(1);
    l_ConAdp  NUMBER(1);
    l_ConCre  NUMBER(1);
    l_ConPac  NUMBER(1);
    l_TemPac  NUMBER(3);
    l_ConRea  NUMBER(1);
    l_BloAut  NUMBER(1);
    l_BloFal  NUMBER(1);
    l_NivAtu  VARCHAR2(5);
    l_DatNiv  DATE;
    l_HorNiv  NUMBER(5);
    l_SeqNiv  NUMBER(6);
    l_FaiAc1  VARCHAR2(56);
    l_FaiAc2  VARCHAR2(56);
    l_FaiAc3  VARCHAR2(56);
    l_FaiAc4  VARCHAR2(56);
    l_FaiAc5  VARCHAR2(56);
    l_FaiAc6  VARCHAR2(56);
    l_FaiAc7  VARCHAR2(56);
    l_FaiPt1  VARCHAR2(56);
    l_FaiPt2  VARCHAR2(56);
    l_FaiPt3  VARCHAR2(56);
    l_FaiPt4  VARCHAR2(56);
    l_FaiPt5  VARCHAR2(56);
    l_FaiPt6  VARCHAR2(56);
    l_FaiPt7  VARCHAR2(56);
    l_FaiRef  VARCHAR2(56);
    l_CreAc1  NUMBER(2);
    l_CreFx1  VARCHAR2(8);
    l_QtdCr1  NUMBER(2);
    l_CreAc2  NUMBER(2);
    l_CreFx2  VARCHAR2(8);
    l_QtdCr2  NUMBER(2);
    l_CreAc3  NUMBER(2);
    l_CreFx3  VARCHAR2(8);
    l_QtdCr3  NUMBER(2);
    l_CreAc4  NUMBER(2);
    l_CreFx4  VARCHAR2(8);
    l_QtdCr4  NUMBER(2);
    l_CreAc5  NUMBER(2);
    l_CreFx5  VARCHAR2(8);
    l_QtdCr5  NUMBER(2);
    l_CreAc6  NUMBER(2);
    l_CreFx6  VARCHAR2(8);
    l_QtdCr6  NUMBER(2);
    l_PrmRt1  NUMBER(5);
    l_DinPr1  VARCHAR2(10);
    l_DfnPr1  VARCHAR2(10);
    l_PrmRt2  NUMBER(5);
    l_DinPr2  VARCHAR2(10);
    l_DfnPr2  VARCHAR2(10);
    l_PrmRt3  NUMBER(5);
    l_situa   CHAR(1);
    l_situaAnt CHAR(1);
    l_qtdIdtPes NUMBER(2);
    l_iPerson BOOLEAN;
    l_numpro_ret BOOLEAN;
    l_numsma_ret BOOLEAN;
    l_datahora CHAR(10);
    l_DinPr3  VARCHAR2(10);
    l_DfnPr3  VARCHAR2(10);
    l_GraCon  NUMBER(3);
    l_ConInt  NUMBER(1);
    l_TolInt  NUMBER(3);
    l_TolAcp  NUMBER(2);
    l_comando_nulo BOOLEAN;
    l_DatSai       DATE;
    l_HorSai       NUMBER(5);
    l_SeqSai       NUMBER(6);
    l_ValAut       NUMBER(1);
    l_CodArc       NUMBER(5);
    l_DatArc       DATE;
    l_HorArc       NUMBER(5);
    l_SeqArc       NUMBER(6);
    l_numcracex    NUMBER(12);

    /* Atributos Auxiliares. */
    l_auxval       CHAR(16);
    l_TipPes       CHAR(2);
    l_NumBar       NUMBER(12);
    l_NumPro       NUMBER(12);
    l_NumSma       NUMBER(12);
    l_CraPri       NUMBER(12);
    l_TecPri       CHAR(1);
    l_DatStr       CHAR(6);
    l_HorStr       CHAR(4);
    l_NumCan       CHAR(7);
    l_datatu       CHAR(16);
    l_data_atual   DATE;
    l_hora_atual   NUMBER(4);
    l_segu_atual   NUMBER(2);
    l_DatAtuStr    CHAR(6);
    l_HorAtuStr    CHAR(4);
    l_seqatu       NUMBER(2);
    l_seqstr       CHAR(2);
    l_nompes       VARCHAR2(40);
    l_ddifon       NUMBER(3);
    l_dddfon       NUMBER(3);
    l_numfon       VARCHAR2(20);
    l_usarfastr    CHAR(1);
    l_usarfa       NUMBER(1);

BEGIN
    IF (p_NumCra > 0) THEN
        /* Monta IDTPES*/
        SP_INTSTR(13, '99', l_TipPes OUT);
        SP_INTSTR(p_NumCan, '9999999', l_NumCan OUT);

        l_IdtPes := l_TipPes||l_NumCan;

        /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
        l_idtpes := lTrim(l_idtpes);
        l_idtpes := rTrim(l_idtpes);

        LOOP
            /*Controle do Loop.*/
            IF (Length(l_idtpes) > 22) THEN
                EXIT;
            END IF;
            l_idtpes := ' '||l_idtpes;
        END LOOP;

        l_NumCra := p_NumCra;
        l_TecCra := l_TecPri;
        l_ChcPri := 0;
        l_NumFis := l_NumCra;
        l_TipCra := 13;
        l_CodPrm := p_CodPrm;
        l_PrmSab := 0;
        l_PrmDom := 0;
        l_PrmFer := 0;
        l_SenCol := ' ';
        l_SitCra := 0;

        SP_DATSTR(p_DatEnt, 'DDMMYY', l_DatStr OUT);
        SP_INTSTR(p_HorEnt, 'HHMM', l_HorStr OUT);
        l_IniVal := l_DatStr||l_HorStr||'000000';

        SP_DATSTR(p_DatVal, 'DDMMYY', l_DatStr OUT);
        SP_INTSTR(p_HorVal, 'HHMM', l_HorStr OUT);
        l_DatVal := l_DatStr||l_HorStr||'000000';

        /* converte a data atual para verificar se existe crachá válido na r070con */
        l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
        l_data_atual := CURDATE();
        l_segu_atual := SECOND(CURTIME());

        /* data atual no formato string (r070con) */
        SP_DATSTR(l_data_atual,'DDMMYY',l_datatustr OUT);
        SP_INTSTR(l_hora_atual,'HHMM',l_horatustr OUT);
        l_seqatu := SECOND(CURTIME());
        SP_INTSTR(l_seqatu, '99', l_seqstr OUT);
        l_datatu := l_datAtuStr||l_horAtuStr||l_seqstr||'0000';

        /* YYMMDDHHMMSEQ0000 */
        l_datatu := SUBSTRING(l_datatu,5,2)||SUBSTRING(l_datatu,3,2)||SUBSTRING(l_datatu,1,2)||SUBSTRING(l_datatu,7,10);

        l_IniAfa := '0000000000000000';
        l_DatAfa := '0000000000000000';
        l_MsgAcc := ' ';
        l_DatMsg := '0000000000000000';
        l_QtdMsg := 0;
        l_MsgAtu := 0;
        l_ConIal := 0;
        l_TemAlm := 0;
        l_VerAfa := 0;
        l_UsaBio := 1; /* Não utiliza biometria. */
        l_VerPrm := 1; /* Sempre verifica permissão */
        l_ConFai := 0;
        l_ConAdp := 0;
        l_ConCre := 0;
        l_ConPac := 0;
        l_TemPac := 0;
        l_ConRea := 1;
        l_BloAut := 0;
        l_BloFal := 0;
        l_NivAtu := '99000';
        l_DatNiv := CURDATE(); /* Data atual. */
        l_HorNiv := 0; /* Hora atual. */
        l_SeqNiv := SECOND(CURTIME()); /* Segundo atual. */

        l_FaiAc1 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc2 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc3 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc4 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc5 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc6 := '00002359240024002400240024002400240024002400240024002400';
        l_FaiAc7 := '00002359240024002400240024002400240024002400240024002400';

        l_FaiPt1 := l_FaiAc1;
        l_FaiPt2 := l_FaiAc2;
        l_FaiPt3 := l_FaiAc3;
        l_FaiPt4 := l_FaiAc4;
        l_FaiPt5 := l_FaiAc5;
        l_FaiPt6 := l_FaiAc6;
        l_FaiPt7 := l_FaiAc7;

        l_FaiRef := '24002400240024002400240024002400240024002400240024002400';

        l_CreAc1 := 0;
        l_CreFx1 := '24002400';
        l_QtdCr1 := l_CreAc1;
        l_CreAc2 := 0;
        l_CreFx2 := '24002400';
        l_QtdCr2 := l_CreAc2;
        l_CreAc3 := 0;
        l_CreFx3 := '24002400';
        l_QtdCr3 := l_CreAc3;
        l_CreAc4 := 0;
        l_CreFx4 := '24002400';
        l_QtdCr4 := l_CreAc4;
        l_CreAc5 := 0;
        l_CreFx5 := '24002400';
        l_QtdCr5 := l_CreAc5;
        l_CreAc6 := 0;
        l_CreFx6 := '24002400';
        l_QtdCr6 := l_CreAc6;
        l_situa  := '0';
        l_situaAnt:= '1';

        l_PrmRt1 := 0;
        l_DinPr1 := '0000000000';
        l_DfnPr1 := '0000000000';
        l_PrmRt2 := 0;
        l_DinPr2 := '0000000000';
        l_DfnPr2 := '0000000000';
        l_PrmRt3 := 0;
        l_DinPr3 := '0000000000';
        l_DfnPr3 := '0000000000';

        l_GraCon := 50;
        l_ConInt := 0;
        l_TolInt := 0;
        l_TolAcp := 0;
        l_DatSai := '31/12/1900,00:00:00';
        l_HorSai := 0;
        l_SeqSai := 0;
        l_ValAut := 0;
        l_CodArc := 0;
        l_DatArc := '31/12/1900,00:00:00';
        l_HorArc := 0;
        l_SeqArc := 0;

        l_datahora := l_datstr || l_horstr;
        l_auxval := l_datahora||'000000';

        /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
        SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

        IF (l_crapri = 0) THEN
            l_crapri := p_numcra;
            /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
            l_teccra := 1;
        ELSE
            l_teccra := l_tecpri;
        END IF;
        /* Atualiza o número físico */
        l_numfis := l_crapri;

        /* Atualiza R070CON */
        l_comando_nulo:=FALSE;
        BEGIN
            SELECT NUMCRA, SITCRA INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SPVISCON: Erro em R070CON - TOO MANY ROWS';
            WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
            WHEN OTHERS THEN RAISERROR 103 'SPVISCON: Erro no SELECT R070CON 5.';
        END;

        /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
        BEGIN
            SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON
             WHERE IDTPES = l_idtpes AND SITCRA = 0 AND ( SUBSTRING(DATVAL,5,2)
                                                        ||SUBSTRING(DATVAL,3,2)
                                                        ||SUBSTRING(DATVAL,1,2)
                                                        ||SUBSTRING(DATVAL,7,10) > l_datatu
                                                        OR DATVAL = '3112502359000000');
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SPCOLCON: Erro No SELECT R070CON (IdtPes).';
        END;

        IF (l_qtdIdtPes > 0) THEN
            l_iPerson := FALSE;
        ELSE
            l_iPerson := TRUE;
        END IF;

        SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

        l_numcracex := 0;
        BEGIN
            SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;

        IF (l_numcracex = p_numcra) THEN
          l_situa := '1';
        END IF;

        /* Assinala na tabela Controle que o Candidato utiliza reconhecimento facial */
        BEGIN
            SELECT USARFA INTO l_usarfastr FROM R122CEX WHERE NUMCAN = p_NumCan;
        EXCEPTION
            WHEN OTHERS THEN
                l_usarfastr := 'N';
        END;
        IF  l_usarfastr = 'S' THEN
            l_usarfa := 1;
        ELSE
            l_usarfa := 0;
        END IF;

        IF (l_comando_nulo = FALSE) THEN
            BEGIN
                UPDATE R070CON SET IDTPES = l_IdtPes, NUMCRA = l_NumCra, TECCRA = l_TecCra, CHCPRI = l_ChcPri, NUMFIS = l_NumFis,
                                   TIPCRA = l_TipCra, CODPRM = p_CodPrm, PRMSAB = l_PrmSab, PRMDOM = l_PrmDom, PRMFER = l_PrmFer,
                                   SENCOL = l_SenCol, SITCRA = l_Situa , INIVAL = l_IniVal, DATVAL = l_DatVal, INIAFA = l_IniAfa,
                                   DATAFA = l_DatAfa, MSGACC = l_MsgAcc, DATMSG = l_DatMsg, QTDMSG = l_QtdMsg, MSGATU = l_MsgAtu,
                                   CONIAL = l_ConIal, TEMALM = l_TemAlm, VERAFA = l_VerAfa, USABIO = l_UsaBio, VERPRM = l_VerPrm,
                                   CONFAI = l_ConFai, CONADP = l_ConAdp, CONCRE = l_ConCre, CONPAC = l_ConPac, TEMPAC = l_TemPac,
                                   BLOAUT = l_BloAut, BLOFAL = l_BloFal, NIVATU = l_NivAtu, DATNIV = l_DatNiv, HORNIV = l_HorNiv,
                                   SEQNIV = l_SeqNiv, FAIAC1 = l_FaiAc1, FAIAC2 = l_FaiAc2, FAIAC3 = l_FaiAc3, FAIAC4 = l_FaiAc4,
                                   FAIAC5 = l_FaiAc5, FAIAC6 = l_FaiAc6, FAIAC7 = l_FaiAc7, FAIPT1 = l_FaiPt1, FAIPT2 = l_FaiPt2,
                                   FAIPT3 = l_FaiPt3, FAIPT4 = l_FaiPt4, FAIPT5 = l_FaiPt5, FAIPT6 = l_FaiPt6, FAIPT7 = l_FaiPt7,
                                   FAIREF = l_FaiRef, CREAC1 = l_CreAc1, CREFX1 = l_CreFx1, QTDCR1 = l_QtdCr1, CREAC2 = l_CreAc2,
                                   CREFX2 = l_CreFx2, QTDCR2 = l_QtdCr2, CREAC3 = l_CreAc3, CREFX3 = l_CreFx3, QTDCR3 = l_QtdCr3,
                                   CREAC4 = l_CreAc4, CREFX4 = l_CreFx4, QTDCR4 = l_QtdCr4, CREAC5 = l_CreAc5, CREFX5 = l_CreFx5,
                                   QTDCR5 = l_QtdCr5, CREAC6 = l_CreAc6, CREFX6 = l_CreFx6, QTDCR6 = l_QtdCr6, PRMRT1 = l_PrmRt1,
                                   DINPR1 = l_DinPr1, DFNPR1 = l_DfnPr1, PRMRT2 = l_PrmRt2, DINPR2 = l_DinPr2, DFNPR2 = l_DfnPr2,
                                   PRMRT3 = l_PrmRt3, DINPR3 = l_DinPr3, DFNPR3 = l_DfnPr3, GRACON = l_GraCon, CONINT = l_ConInt,
                                   TOLINT = l_TolInt, TOLACP = l_TolAcp, DATSAI = l_DatSai, HORSAI = l_HorSai, SEQSAI = l_SeqSai,
                                   VALAUT = l_ValAut, CODARC = l_CodArc, DATARC = l_DatArc, HORARC = l_HorArc, SEQARC = l_SeqArc,
                                   NOMFUN = '', NUMPIS = 0, CONREA = l_ConRea, RECVIS = 0,
                                   NOMPES = l_nompes, DDIFON = l_ddifon, DDDFON = l_dddfon, NUMFON = l_numfon, NUMEMP = 0,
                                   TIPCOL = 0, NUMCAD = 0, TIPDOC = 0, NUMDOC = '0', NUMMAT = '0', PROPAC = '0', NUMCAN = p_NumCan,
                                   USARFA = l_usarfa
                WHERE NUMFIS = l_CraPri;
            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_CANCON: Erro no UPDATE na tabela R070CON.';
            END;
        ELSE
            BEGIN
                INSERT INTO R070CON (IDTPES,   NUMCRA,   TECCRA,   CHCPRI,   NUMFIS,   TIPCRA,   CODPRM,   PRMSAB,   PRMDOM,   PRMFER,
                                     SENCOL,   SITCRA,   INIVAL,   DATVAL,   INIAFA,   DATAFA,   MSGACC,   DATMSG,   QTDMSG,   MSGATU,
                                     CONIAL,   TEMALM,   VERAFA,   USABIO,   VERPRM,   CONFAI,   CONADP,   CONCRE,   CONPAC,   TEMPAC,
                                     BLOAUT,   BLOFAL,   NIVATU,   DATNIV,   HORNIV,   SEQNIV,   FAIAC1,   FAIAC2,   FAIAC3,   FAIAC4,
                                     FAIAC5,   FAIAC6,   FAIAC7,   FAIPT1,   FAIPT2,   FAIPT3,   FAIPT4,   FAIPT5,   FAIPT6,   FAIPT7,
                                     FAIREF,   CREAC1,   CREFX1,   QTDCR1,   CREAC2,   CREFX2,   QTDCR2,   CREAC3,   CREFX3,   QTDCR3,
                                     CREAC4,   CREFX4,   QTDCR4,   CREAC5,   CREFX5,   QTDCR5,   CREAC6,   CREFX6,   QTDCR6,   PRMRT1,
                                     DINPR1,   DFNPR1,   PRMRT2,   DINPR2,   DFNPR2,   PRMRT3,   DINPR3,   DFNPR3,   GRACON,   CONINT,
                                     TOLINT,   TOLACP,   DATSAI,   HORSAI,   SEQSAI,   VALAUT,   CODARC,   DATARC,   HORARC,   SEQARC,
                                     NOMFUN,   NUMPIS,   CONREA,   NOMPES,   DDIFON,   DDDFON,   NUMFON,   RECVIS,   NUMEMP,   TIPCOL,
                                     NUMCAD,   TIPDOC,   NUMDOC,   NUMMAT,   PROPAC,   NUMCAN,   PROPRE,   USARFA)
                             VALUES (l_IdtPes, l_NumCra, l_TecCra, l_ChcPri, l_NumFis, l_TipCra, p_CodPrm, l_PrmSab, l_PrmDom, l_PrmFer,
                                     l_SenCol, l_Situa , l_IniVal, l_auxval, l_IniAfa, l_DatAfa, l_MsgAcc, l_DatMsg, l_QtdMsg, l_MsgAtu,
                                     l_ConIal, l_TemAlm, l_VerAfa, l_UsaBio, l_VerPrm, l_ConFai, l_ConAdp, l_ConCre, l_ConPac, l_TemPac,
                                     l_BloAut, l_BloFal, l_NivAtu, l_DatNiv, l_HorNiv, l_SeqNiv, l_FaiAc1, l_FaiAc2, l_FaiAc3, l_FaiAc4,
                                     l_FaiAc5, l_FaiAc6, l_FaiAc7, l_FaiPt1, l_FaiPt2, l_FaiPt3, l_FaiPt4, l_FaiPt5, l_FaiPt6, l_FaiPt7,
                                     l_FaiRef, l_CreAc1, l_CreFx1, l_QtdCr1, l_CreAc2, l_CreFx2, l_QtdCr2, l_CreAc3, l_CreFx3, l_QtdCr3,
                                     l_CreAc4, l_CreFx4, l_QtdCr4, l_CreAc5, l_CreFx5, l_QtdCr5, l_CreAc6, l_CreFx6, l_QtdCr6, l_PrmRt1,
                                     l_DinPr1, l_DfnPr1, l_PrmRt2, l_DinPr2, l_DfnPr2, l_PrmRt3, l_DinPr3, l_DfnPr3, l_GraCon, l_ConInt,
                                     l_TolInt, l_TolAcp, l_DatSai, l_HorSai, l_SeqSai, l_ValAut, l_CodArc, l_DatArc, l_HorArc, l_SeqArc,
                                     '', 0, l_ConRea,    l_nompes, l_ddifon, l_dddfon, l_numfon, 0, 0, 0, 0, 0, '0', '0', '0', p_NumCan,
                                     0, l_usarfa);
            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SP_CANCON: Erro no INSERT na tabela R070CON.';
            END;
        END IF;

        /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
        IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
            SP_PEND21(l_crapri);
        END IF;

        /*Atualiza os demais Crachás*/
        /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
        IF (l_tecpri = 1) THEN
            /*Atualiza o crachá de proximidade*/
            IF (l_numpro <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numpro, l_numpro_ret OUT);
                  /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numpro);
                END IF;
            END IF;
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;

        /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
        ELSIF (l_tecpri = 2) THEN
            /*Atualiza o crachá Smart*/
            IF (l_numsma <> 0) THEN
                /*Verifica se o Crachá já está na R070CON*/
                SP_VERCON(l_numsma, l_numsma_ret OUT);
                /*Atualiza o crachá na R070CON*/
                SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                          p_codprm,p_codprm,p_codprm,p_codprm,l_PrmRt1,l_PrmRt2,l_PrmRt3,0,0,' ',l_VerPrm);
                /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
                /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
                IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                    /*Gera Pendência 21*/
                    SP_PEND21(l_numsma);
                END IF;
            END IF;
        END IF;

        /*Verifica se Gera o Comando IncludePerson*/
        IF (l_iPerson = TRUE) THEN 
            /*Gera o Include Person*/
            SP_PEND19(p_numcra, l_idtpes);
        END IF;

        /*Atualiza a Controle*/
       SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);
    END IF;
END␀␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_E_SOCIAL
SP_ESOCIAL_INFO
Y␀␀PROCEDURE SP_CARGOESOCIAL(P_TABELA VARCHAR2(7),P_ESTCAR NUMBER(4),P_CODCAR VARCHAR2(24),P_VALOR VARCHAR2(2000),P_DATAALTERACAO DATE,P_PROXIMADATA DATE, P_DATENC DATE)
 IS

CURSOR C_EMPRESA IS SELECT DISTINCT NUMEMP FROM R350CAR WHERE ESTCAR = P_ESTCAR AND CODCAR = P_CODCAR AND ENVVAL = 'S' ORDER BY NUMEMP;
	TYPE T_EMPRESA IS RECORD (NUMEMP   R350CAR.NUMEMP%TYPE);
	EMPRESA_CARGO T_EMPRESA;
CURSOR C_EMPRESA_HISTORICO_CARGO IS SELECT R030DES.NUMEMP FROM R030DES WHERE EXISTS (SELECT 1 FROM R034MAT, R038HCA WHERE R034MAT.NUMEMP = R030DES.NUMEMP AND R034MAT.NUMEMP = R038HCA.NUMEMP AND R034MAT.TIPCOL = R038HCA.TIPCOL AND R034MAT.NUMCAD = R038HCA.NUMCAD AND R038HCA.ESTCAR = P_ESTCAR AND R038HCA.CODCAR = P_CODCAR AND R038HCA.FUNESO = 'N' AND NOT EXISTS (SELECT 1 FROM R038AFA AFA1, R010SIT SIT WHERE AFA1.NUMEMP = R034MAT.NUMEMP AND AFA1.TIPCOL = R034MAT.TIPCOL AND AFA1.NUMCAD = R034MAT.NUMCAD AND AFA1.DATAFA <= CURDATE() AND SIT.CODSIT = AFA1.SITAFA AND SIT.TIPSIT = 7)) AND ((R030DES.SIMFOL > DATETIME(31, 12, 1900, 0, 0, 0) AND CURDATE() >= R030DES.SIMFOL) OR (CURDATE() > (SELECT FIMSIM FROM R030DAT WHERE GRUESO = 0))) ORDER BY NUMEMP;
	TYPE T_EMPRESA_HISTORICO_CARGO IS RECORD (NUMEMP   R038HCA.NUMEMP%TYPE);
	EMPRESA_HISTORICO_CARGO T_EMPRESA_HISTORICO_CARGO;
  l_InfoFacult   BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
	FOREACH C_EMPRESA_HISTORICO_CARGO INTO EMPRESA_HISTORICO_CARGO.NUMEMP
	LOOP
		SP_E_SOCIAL('S-1030', P_TABELA, 'T', 'A', P_DATAALTERACAO, P_PROXIMADATA, EMPRESA_HISTORICO_CARGO.NUMEMP, 0, 0, P_VALOR, '', 0, P_DATENC, NULL, 0, 'SP_CARGOESOCIAL');	
	END LOOP;
	
	FOREACH C_EMPRESA INTO EMPRESA_CARGO.NUMEMP
	LOOP
        l_InfoFacult := TRUE;
        l_SimplificaoESocial := FALSE;
        l_VersaoESocial := 0;
        SP_ESOCIAL_INFO(EMPRESA_CARGO.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
		IF (l_SimplificaoESocial = FALSE) THEN
		  SP_E_SOCIAL('S-1030', P_TABELA, 'T', 'A', P_DATAALTERACAO, P_PROXIMADATA, EMPRESA_CARGO.NUMEMP, 0, 0, P_VALOR, '', 0, P_DATENC, NULL, 0, 'SP_CARGOESOCIAL');
		END IF;	
	END LOOP;
END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ç/*Tipo de operação: 1/3 - altera apenas o número físico/serial, 2 - altera o icard*/
PROCEDURE SP_CHCTSI(P_TIPOPE NUMBER(1),P_NUMCRA NUMBER(12),P_OLDCRA NUMBER(12),P_NUMSER NUMBER(12),P_OLDSER NUMBER(12))
 IS
BEGIN
  NULL;
END		SENIOR;20;SP_USUTEL
SP_INTSTR
SP_CMDTSI
SP_R058LTP
SP_EXITELTAB
l'␀␀/*Tipo de operação: 1/3 - Altera apenas o número físico/serial (do crachá principal),
                      2 - Altera o icard (do crachá principal),
                      4 - Alteração dos Icards na controle que não são principais
                      5 - Deleta o Icard
                      6 - Atualizar ICARD se utilizado SmartCard
                      7 - Atualizar CONTPLANTA quando alterado o código de barras*/
PROCEDURE SP_CHCTSI(P_TIPOPE NUMBER(1),P_NUMCRA NUMBER(12),P_OLDCRA NUMBER(12),P_NUMSER NUMBER(12),P_OLDSER NUMBER(12))
 IS

l_numcra          CHAR(12);
  l_oldcra          CHAR(12);
  l_numser          CHAR(10);
  l_oldser          CHAR(10);
  l_comando         CHAR(2048);
  l_pndgrp          CHAR(1);
  l_matgrp          CHAR(1);
  l_matcod          CHAR(1);
  l_sertsi          CHAR(1);
  l_digsag          CHAR(1);
  l_utirep          CHAR(1);
  l_numserial       CHAR(10);
  l_usutel          VARCHAR(31);
  l_cntdigtsi       BOOLEAN;
  l_chcass			CHAR(1);
  l_chcace          NUMBER(1);
  l_cntPlt          CHAR(1);

BEGIN
  SP_USUTEL(l_usutel OUT);
  /*Verifica se possui a tabela Pend_Grupo*/
  BEGIN
      SELECT PNDGRP, MATGRP, NUMSER, DIGSAG, UTIREP, MATCOD, CNTPLT INTO l_pndgrp, l_matgrp, l_sertsi, l_digsag, l_utirep, l_matcod, l_cntPlt FROM R070TSI;
  EXCEPTION
    WHEN OTHERS THEN
      l_pndgrp := 'N';
      l_matgrp := 'N';
      l_sertsi := 'N';
      l_digsag := 'N';
      l_utirep := 'N';
  END;

  /*Inicialização de Variáveis*/
  SP_INTSTR(p_numcra,'999999999999',l_numcra OUT);
  SP_INTSTR(p_oldcra,'999999999999',l_oldcra OUT);
  SP_INTSTR(p_numser,'9999999999',l_numser OUT);
  SP_INTSTR(p_oldser,'9999999999',l_oldser OUT);

	BEGIN
  		SELECT CHCASS INTO l_chcass FROM R070DAC;
 	EXCEPTION
    	WHEN OTHERS THEN
      	  l_chcass := 'N';
  	END;

    BEGIN
        SELECT CHCACE INTO l_chcACe FROM R070TSI;
    EXCEPTION
        WHEN OTHERS THEN
            l_chcAce := 0;
    END;
  /*Atualização tabela pend_grupo*/
  IF (l_pndgrp = 'S') THEN
      BEGIN
          /*Se o tipo de operação for igual a 1, atualiza apenas o número serial*/
          IF (p_tipope = 1) THEN
              l_comando := 'DELETE '||l_usutel||'PEND_GRUPO WHERE NUMSERIAL = '''||l_numser||'''';
              SP_CMDTSI(l_comando);
              l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET NUMSERIAL = '''||l_numser||''' WHERE NUMSERIAL = '''||l_oldser||'''';
              SP_CMDTSI(l_comando);
          ELSIF (p_tipope = 2 OR p_tipope = 6) THEN
          	  IF(l_chcass <> 'D' OR l_chcAce = 3) THEN
	                /*atualiza o icard*/
              	    l_comando := 'DELETE '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              	    SP_CMDTSI(l_comando);
              		l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET ICARD = '''||l_numcra||''' WHERE ICARD = '''||l_oldcra||'''';
              		SP_CMDTSI(l_comando);
              END IF;
          ELSIF (p_tipope = 3) THEN
              /*Deleta o NUMSERIAL antes de realizar o update*/
              l_comando := 'DELETE '||l_usutel||'PEND_GRUPO WHERE NUMSERIAL = '''||l_numser||'''';
              SP_CMDTSI(l_comando);
              /*Atualiza o Numserial a partir do icard*/
              l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET NUMSERIAL = '''||l_numser||''' WHERE ICARD = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
          END IF;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SPCHCTSI: Erro no update da pend_grupo. ';
      END;
  END IF;

  /*Atualização tabela MATGRUPO*/
  IF (l_matgrp = 'S') THEN
      BEGIN
          IF (p_tipope = 4) OR ((p_tipope = 2 OR p_tipope = 6) AND ((l_chcass <> 'D') OR (l_chcAce = 3))) THEN
	              /*atualiza o icard*/
	              l_comando := 'DELETE FROM '||l_usutel||'MATGRUPO WHERE ICARD = '''||l_numcra||'''';
	              SP_CMDTSI(l_comando);
	              l_comando := 'UPDATE '||l_usutel||'MATGRUPO SET ICARD = '''||l_numcra||''' WHERE ICARD = '''||l_oldcra||'''';
	              SP_CMDTSI(l_comando);
          ELSIF (p_tipope = 5) THEN
              /*atualiza o icard*/
              l_comando := 'DELETE FROM '||l_usutel||'MATGRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
          END IF;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SPCHCTSI: Erro no update da matgrupo. ';
      END;
  END IF;

  /*Atualização tabela MATCODIN*/
  IF (l_matcod = 'S') THEN
      BEGIN
         IF (p_tipope = 4) OR ((p_tipope = 2 OR p_tipope = 6) AND ((l_chcass <> 'D') OR (l_chcAce = 3))) THEN
	              /*atualiza o icard*/
	              l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD = '''||l_numcra||'''';
	              SP_CMDTSI(l_comando);
	              l_comando := 'UPDATE '||l_usutel||'MATCODIN SET ICARD = '''||l_numcra||''' WHERE ICARD = '''||l_oldcra||'''';
	              SP_CMDTSI(l_comando);
          ELSIF (p_tipope = 5) THEN
              /*atualiza o icard*/
              l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
          END IF;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SPCHCTSI: Erro no update da matcodin. ';
      END;
  END IF;

  /*Atualização tabela CONTDIG_SAGEM*/
  IF (l_digsag = 'S') THEN
      BEGIN
         IF (p_tipope = 4) OR ((p_tipope = 2 OR (p_tipope = 6)) AND ((l_chcass <> 'D') OR (l_chcAce = 3))) THEN
	              /*atualiza o icard*/
	              l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_SAGEM WHERE ICARD = '''||l_numcra||'''';
	              SP_CMDTSI(l_comando);
	              l_comando := 'UPDATE '||l_usutel||'CONTDIG_SAGEM SET ICARD = '''||l_numcra||''' WHERE ICARD = '''||l_oldcra||'''';
	              SP_CMDTSI(l_comando);
          ELSIF (p_tipope = 5) THEN
              /*atualiza o icard*/
              l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_SAGEM WHERE ICARD = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
          END IF;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SPCHCTSI: Erro no update da CONTDIG_SAGEM. ';
      END;
  END IF;

  SP_EXITELTAB('CONTDIG_TSI1', l_cntdigtsi OUT);

  /*Atualização tabela CONTDIG_TSI1*/
  IF (l_cntdigtsi = TRUE) THEN
      BEGIN
         IF ((p_tipope = 4) OR ((p_tipope = 2 OR p_tipope = 6 AND ((l_chcass <> 'D') OR (l_chcAce = 3))))) THEN
	              /*atualiza o icard*/
	              l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_TSI1 WHERE ICARD = '''||l_numcra||'''';
	              SP_CMDTSI(l_comando);
	              l_comando := 'UPDATE '||l_usutel||'CONTDIG_TSI1 SET ICARD = '''||l_numcra||''' WHERE ICARD = '''||l_oldcra||'''';
	              SP_CMDTSI(l_comando);
          ELSIF (p_tipope = 5) THEN
              /*atualiza o icard*/
              l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_TSI1 WHERE ICARD = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
          END IF;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SPCHCTSI: Erro no update da CONTDIG_TSI1. ';
      END;
  END IF;

  /*Atualização tabela REPEMPR002*/
  IF (l_utirep = 'S') THEN
      BEGIN
          IF ((p_tipope = 2) OR (p_tipope = 4)) THEN
              /*atualiza o icard*/
              l_comando := 'DELETE FROM '||l_usutel||'REPEMPR002 WHERE IFUNC = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
              l_comando := 'UPDATE '||l_usutel||'REPEMPR002 SET IFUNC = '''||l_numcra||''' WHERE IFUNC = '''||l_oldcra||'''';
              SP_CMDTSI(l_comando);

              /*Salva na tabela R058LTP*/
              SP_R058LTP(l_numcra);
          ELSIF ((p_tipope = 5) OR (p_tipope = 6)) THEN
              /*atualiza o icard*/
              l_comando := 'DELETE FROM '||l_usutel||'REPEMPR002 WHERE IFUNC = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
          END IF;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SPCHCTSI: Erro no update da REPEMPR002. ';
      END;
  END IF;

  /*Atualização do campo NUMSERIAL da CONTROLE*/
  IF (l_sertsi = 'S') THEN
      BEGIN
          IF ((p_tipope = 1) OR (p_tipope = 3)) THEN
              /*atualiza o icard*/
              IF (l_chcAce =3) THEN
                l_numserial := '0000000000';
                l_comando := 'UPDATE '||l_usutel||'CONTROLE SET NUMSERIAL = '''||l_numserial||''' WHERE NUMSERIAL = '''||l_numser||'''';
                SP_CMDTSI(l_comando);
                l_comando := 'UPDATE '||l_usutel||'CONTROLE SET NUMSERIAL = '''||l_numser||''' WHERE NUMSERIAL = '''||l_oldser||'''';
                SP_CMDTSI(l_comando);
              ELSE
                l_numserial := '0000000000';
                l_comando := 'UPDATE '||l_usutel||'CONTROLE SET NUMSERIAL = '''||l_numserial||''' WHERE NUMSERIAL = '''||l_numser||'''';
                SP_CMDTSI(l_comando);
                l_comando := 'UPDATE '||l_usutel||'CONTROLE SET NUMSERIAL = '''||l_numser||''' WHERE ICARD = '''||l_numcra||''' AND NUMSERIAL = '''||l_oldser||'''';
                SP_CMDTSI(l_comando);
              END IF;
          ELSIF (p_tipope = 6) THEN
              l_comando := 'DELETE FROM '||l_usutel||'CONTROLE WHERE ICARD = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
              l_comando := 'UPDATE '||l_usutel||'CONTROLE SET ICARD = '''||l_numcra||''' WHERE ICARD = '''||l_oldcra||'''';
              SP_CMDTSI(l_comando);
          END IF;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SPCHCTSI: Erro no update do NUMSERIAL controle. ';
      END;
  END IF;

  IF (l_cntPlt = 'S') THEN
    l_comando := 'DELETE FROM '||l_usutel||'CONTPLANTA WHERE ICARD = '''||l_numcra||'''';
    SP_CMDTSI(l_comando);
    l_comando := 'UPDATE '||l_usutel||'CONTPLANTA SET ICARD = '''||l_numcra||''' WHERE ICARD = '''||l_oldcra||'''';
    SP_CMDTSI(l_comando);
  END IF;
END		SENIOR;23;SP_USUTEL
