	l_DataMax := DATETIME(04, 06, 2080, 0, 0, 0);
	
	SM_ESOCIAL_ATIVO(l_EsocialAtivo OUT);
	IF (l_EsocialAtivo = TRUE) THEN
		l_DatIni := :OLD.DatIni;
		l_DatTer := :OLD.DatTer;
		
