à␀␀PROCEDURE R088HCH_ATUCON(P_CRAVEI NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_SITUA CHAR)
 IS

  l_icardv       CHAR(12);
  l_datahora     CHAR(10);
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_data_zero    DATE;
  l_numser       VARCHAR(12);
  l_icardR    	 VARCHAR(12);
  /*TELEMÁTICA*/
  l_usutel     VARCHAR2(31);
  l_comando    VARCHAR2(1024);
BEGIN
  SP_USUTEL(l_usutel OUT);
  l_data_zero :=  '31/12/1900,00:00:00';

  /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
  SP_RETICARD(NULL, p_cravei, l_icardv OUT , l_icardR OUT, l_numser OUT);

  /* Atualiza CONTVEI */
  IF  p_datval = l_data_zero THEN
      l_datahora := '3112502359';
  ELSE
      SP_DATSTR(p_datval,'DDMMYY',l_datstr OUT);
      SP_INTSTR(p_horval,'HHMM',l_horstr OUT);
      l_datahora := l_datstr||l_horstr;
  END IF;

  IF  (p_situa = '1') THEN
      l_comando := 'UPDATE '||l_usutel||'CONTVEI SET SITUA=''' || p_situa || ''' WHERE ICARDV = ''' || l_icardv || ''';';
      SP_CMDTSI(l_comando);
  ELSE
      l_comando := 'UPDATE '||l_usutel||'CONTVEI SET DATAHORA=''' || l_datahora || ''', SITUA=''' || p_situa || ''' WHERE ICARDV = ''' || l_icardv || ''';';
      SP_CMDTSI(l_comando);
  END IF;
END		SENIOR;239SP_INTSTR
