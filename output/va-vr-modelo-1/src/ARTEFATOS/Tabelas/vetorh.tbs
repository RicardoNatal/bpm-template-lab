PROCEDURE SP_DECFON
(
    p_Fone    IN  VARCHAR2(30),
    p_DDIFon  OUT NUMBER(3),
    p_DDDFon  OUT NUMBER(3),
    p_numFon  OUT VARCHAR2(20)
)
 IS

l_pos         NUMBER(2);
    l_Fone        VARCHAR(30);
    l_DDIFon      NUMBER(3);
    l_DDDFon      NUMBER(3);
BEGIN
    /* Inicializa */
    l_Fone   := LTRIM(RTRIM(REPLACE(REPLACE(p_Fone, '+', ''), '-', '')));
    l_DDIFon := 0;
    l_DDDFon := 0;
    
    l_pos := LOCATE('(', l_Fone, 1);
    IF (l_pos > 0) THEN
      IF (l_pos > 1) THEN
        l_DDIFon := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_Fone, 1, l_pos-1)));
      END IF;
      
      l_Fone := SUBSTRING(l_Fone, l_pos+1, LENGTH(l_Fone));
    END IF;

    l_pos := LOCATE(')', l_Fone, 1);
    IF (l_pos > 0) THEN
      IF (l_pos > 1) THEN
        l_DDDFon := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_Fone, 1, l_pos-1)));
      END IF;
      
      l_Fone := SUBSTRING(l_Fone, l_pos+1, LENGTH(l_Fone));
    END IF;

    p_DDIFon := l_DDIFon;
    p_DDDFon := l_DDDFon;
    p_numFon := LTRIM(RTRIM(l_Fone));
END		SENIOR;21
)␀␀


