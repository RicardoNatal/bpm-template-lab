PROCEDURE SP_PEND60(P_IDTPES CHAR(23),P_NOMPES VARCHAR2(40),P_NUMPIS NUMBER(11),P_DDIFON NUMBER(3),P_DDDFON NUMBER(3),P_NUMFON VARCHAR2(20),P_PESBLO NUMBER(1),P_DESBLO VARCHAR2(30))
 IS

l_PisStr      VARCHAR2(11);
  l_tamNum      NUMBER(3);    /* variável auxiliar para determinar o tamanho das strings */
  l_tamNom      VARCHAR2(3);  /* tamanho do nome da pessoa */
  l_tamFon      VARCHAR2(2);  /* tamanho do telefone */
  l_tamMot      VARCHAR2(2);  /* tamanho do motivo de bloqueio */

  l_NomOri      VARCHAR2(40); /* Nome original */
  l_NomCon      VARCHAR2(40); /* Nome convertido */

  l_DDIStr      VARCHAR2(5);
  l_DDDStr      VARCHAR2(7);
  l_FonStr      VARCHAR2(50);
  l_BloStr      CHAR(1);

  l_valstr     VARCHAR2(2047);

  l_datatu     DATE;
  l_horatu     NUMBER(4);
  l_seqenv     NUMBER(2);
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datenv     CHAR(16);
  l_seqstr     CHAR(2);
  l_desblo     CHAR(30);
BEGIN

  /* Calcula  data/hora de envio da pendência.*/
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

  /* retira os acentos e caracteres especiais do nome */
  IF (p_NomPes IS NULL) THEN
    l_NomOri := '';
  ELSE
    l_NomOri := UPPER(p_NomPes);
  END IF;
  
  SP_STRTOSTR(l_NomOri, l_NomCon OUT);

  SP_INTSTR(p_numpis,'99999999999',l_PisStr OUT);
  
  IF (l_PisStr IS NULL) THEN
	l_PisStr := '';
  END IF;
  
  IF (P_PESBLO IS NULL) THEN
    l_BloStr := '0';
  ELSE
    SP_INTSTR(p_pesBlo,'9',l_BloStr OUT);
  END IF;

  /* Concatena o telefone */
  IF (p_DDIFon > 0) THEN
      SP_INTSTR(p_DDIFon,'999',l_DDIStr OUT);
      l_DDIStr := lTrim(l_DDIStr);
      l_DDIStr := rTrim(l_DDIStr);
      l_DDIStr := '+' || l_DDIStr;
  ELSE
      l_DDIStr := '';
  END IF;


  IF (p_DDDFon > 0) THEN
      SP_INTSTR(p_DDDFon,'999',l_DDDStr OUT);
      l_DDDStr := lTrim(l_DDDStr);
      l_DDDStr := rTrim(l_DDDStr);
      l_DDDStr := '(' || l_DDDStr ||')';
  ELSE
      l_DDDStr := '';
  END IF;

  IF (p_NumFon = '') OR (p_NumFon IS NULL) THEN
      l_FonStr := '';
  ELSE
      l_FonStr := lTrim(p_NumFon);
      l_FonStr := rTrim(l_FonStr);
      l_FonStr :=  l_DDISTr || l_DDDStr || l_FonStr;
  END IF;

  /* Calcula o tamanho das strings */
  l_TamNum := LENGTH(l_NomCon);
  SP_INTSTR(l_TamNum,'999',l_tamNom OUT);

  l_TamNum := LENGTH(l_FonStr);
  SP_INTSTR(l_TamNum,'99',l_tamFon OUT);

  IF (p_desBlo IS NULL) THEN
    l_desblo := '';
    l_TamNum := 0;
    l_tamMot := '00';
  ELSE
    l_desblo := p_DesBlo;
    l_TamNum := LENGTH(p_desBlo);
    SP_INTSTR(l_TamNum,'99',l_tamMot OUT);
  END IF;

  /* monta o comando */
  l_valstr := '60' || l_datenv || p_idtpes;
  IF (l_TamNom IS NULL) OR (l_TamNom = '0') THEN
    l_valstr := l_valstr || '000';
  ELSE
    l_valstr := l_valstr || l_TamNom || l_NomCon;
  END IF;

  l_valstr := l_valstr || l_PisStr;

  IF (l_TamFon IS NULL) OR (l_TamFon = '0') THEN
    l_valstr := l_valstr || '00';
  ELSE
    l_valstr := l_valstr || l_TamFon || l_FonStr;
  END IF;

  IF (l_BloStr IS NULL) THEN
      l_BloStr := '0';
  END IF;

  IF  (l_BloStr = '0') AND ((l_TamMot IS NULL) OR (l_TamMot = '0')) THEN
    l_valstr := l_valstr || l_BloStr || '00';
  ELSE
    l_valstr := l_valstr || l_BloStr || l_TamMot || l_desblo;
  END IF;

  /* envia o comando */
  BEGIN
      SP_PORCOM(l_valstr, '0');
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'SP_PEND60: Erro ao gerar pendência 60.';
  END;
END		SENIOR;20.SP_DATSTR
SP_INTSTR
SP_STRTOSTR
SP_PORCOM
