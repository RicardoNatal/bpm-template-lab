  OR (:NEW.nroarm<>:OLD.nroarm)  
  OR (:NEW.iniarm<>:OLD.iniarm)  
  OR (:NEW.fimarm<>:OLD.fimarm)  
  OR (:NEW.emapar<>:OLD.emapar)  
  OR (:NEW.emacom<>:OLD.emacom)  
  OR (:NEW.catvei<>:OLD.catvei)  
  OR (:NEW.sitreg<>:OLD.sitreg)  
  OR (:NEW.nomcom<>:OLD.nomcom)
  OR (:NEW.nomsoc<>:OLD.nomsoc)  
  OR (:NEW.datven<>:OLD.datven)  
  OR (:NEW.dddtel<>:OLD.dddtel)  
  OR (:NEW.dditel<>:OLD.dditel)  
  OR (:NEW.nmddi2<>:OLD.nmddi2)  
  OR (:NEW.nmddd2<>:OLD.nmddd2)  
  OR (:NEW.nmtel2<>:OLD.nmtel2)  
  OR (:NEW.nmram2<>:OLD.nmram2)  
  OR (:NEW.nifext<>:OLD.nifext)  
  OR (:NEW.maspsa<>:OLD.maspsa)  
  OR (:NEW.nasviv<>:OLD.nasviv)  
  OR (:NEW.carsus<>:OLD.carsus)  
  OR (:NEW.tipcer<>:OLD.tipcer)  
  OR (:NEW.demciv<>:OLD.demciv)  
  OR (:NEW.matccv<>:OLD.matccv)  
  OR (:NEW.matciv<>:OLD.matciv)  
  OR (:NEW.livciv<>:OLD.livciv)  
  OR (:NEW.folciv<>:OLD.folciv)  
  OR (:NEW.carciv<>:OLD.carciv)  
  OR (:NEW.estciv<>:OLD.estciv)  
  OR (:NEW.cidciv<>:OLD.cidciv)  
  OR (:NEW.numpsp<>:OLD.numpsp)  
  OR (:NEW.emipsp<>:OLD.emipsp)  
  OR (:NEW.estpsp<>:OLD.estpsp)  
  OR (:NEW.dempsp<>:OLD.dempsp)  
  OR (:NEW.dvapsp<>:OLD.dvapsp)  
  OR (:NEW.paipsp<>:OLD.paipsp)  
  OR (:NEW.numpor<>:OLD.numpor)  
  OR (:NEW.datpor<>:OLD.datpor)  
  OR (:NEW.numric<>:OLD.numric)  
  OR (:NEW.estric<>:OLD.estric)  
  OR (:NEW.emiric<>:OLD.emiric)  
  OR (:NEW.cidric<>:OLD.cidric)  
  OR (:NEW.dexric<>:OLD.dexric)  
  OR (:NEW.seqreg<>:OLD.seqreg)  
  OR (:NEW.datexp<>:OLD.datexp)  
  OR (:NEW.orgcnh<>:OLD.orgcnh)) THEN
     /* Geração do histórico da ficha complementar */
      l_tipalt := 'A';
      SP_R034CPL_HIST(l_tipalt, :NEW.numemp, :NEW.tipcol, :NEW.numcad, :NEW.ficreg, :NEW.codpai, :NEW.codest, :NEW.codcid, :NEW.codbai, :NEW.codrad, :NEW.nomrad, :NEW.endcep, :NEW.tiplgr, 
  		:NEW.endrua, :NEW.endnum, :NEW.endcpl, :NEW.numtel, :NEW.painas, :NEW.estnas, :NEW.ccinas, :NEW.docidn, :NEW.numcid, :NEW.emicid, :NEW.cidemi, :NEW.estcid, :NEW.dexcid, 
  		:NEW.zonele, :NEW.secele, :NEW.numele, :NEW.numcnh, :NEW.catcnh, :NEW.datcnh, :NEW.vencnh, :NEW.numres, :NEW.catres, :NEW.codprf, :NEW.regcon, :NEW.durcon, :NEW.procon, 
  		:NEW.proexm, :NEW.ultexm, :NEW.codqua, :NEW.estpad, :NEW.clasal, :NEW.nivsal, :NEW.matipe, :NEW.altipe, :NEW.sitipe, :NEW.tippsa, :NEW.codpsa, :NEW.matpsa, :NEW.incpsa, 
  		:NEW.excpsa, :NEW.codrlr, :NEW.codcas, :NEW.numram, :NEW.pretrb, :NEW.andtrb, :NEW.nroarm, :NEW.iniarm, :NEW.fimarm, :NEW.emapar, :NEW.emacom, :NEW.catvei, :NEW.sitreg, 
  		:NEW.nomcom, :NEW.nomsoc, :NEW.datven, :NEW.dddtel, :NEW.dditel, :NEW.nmddi2, :NEW.nmddd2, :NEW.nmtel2, :NEW.nmram2, :NEW.nifext, :NEW.maspsa, :NEW.nasviv, :NEW.carsus, 
  		:NEW.tipcer, :NEW.demciv, :NEW.matccv, :NEW.matciv, :NEW.livciv, :NEW.folciv, :NEW.carciv, :NEW.estciv, :NEW.cidciv, :NEW.numpsp, :NEW.emipsp, :NEW.estpsp, :NEW.dempsp, 
  		:NEW.dvapsp, :NEW.paipsp, :NEW.numpor, :NEW.datpor, :NEW.numric, :NEW.estric, :NEW.emiric, l_seqhis OUT);
  		
      /* Atualização do histórico da ficha complementar criada devido limite de parâmetros no PostgreSQL */		
      SP_R034CPL_HIST_UP(l_seqhis, :NEW.numemp, :NEW.tipcol, :NEW.numcad, :NEW.cidric, :NEW.dexric, :NEW.seqreg, :NEW.datexp, :NEW.orgcnh); 

  END IF;
  
  IF ((:OLD.ENDRUA <> :NEW.ENDRUA) 
   OR (:OLD.ENDNUM <> :NEW.ENDNUM)
   OR (:OLD.CODBAI <> :NEW.CODBAI)
   OR (:OLD.ENDCEP <> :NEW.ENDCEP)
   OR (:OLD.CODEST <> :NEW.CODEST)
   OR (:OLD.CODCID <> :NEW.CODCID)
   OR (:OLD.DDDTEL <> :NEW.DDDTEL)
   OR (:OLD.DDITEL <> :NEW.DDITEL)
   OR (:OLD.NUMTEL <> :NEW.NUMTEL)
   OR (:OLD.NUMRAM <> :NEW.NUMRAM)
   OR (:OLD.NMDDI2 <> :NEW.NMDDI2)
   OR (:OLD.NMDDD2 <> :NEW.NMDDD2)
   OR (:OLD.NMTEL2 <> :NEW.NMTEL2)
   OR (:OLD.NMRAM2 <> :NEW.NMRAM2)
   OR (:OLD.NUMCID <> :NEW.NUMCID)
   OR (:OLD.NUMCNH <> :NEW.NUMCNH)
   OR (:OLD.EMAPAR <> :NEW.EMAPAR)
   OR (:OLD.EMACOM <> :NEW.EMACOM)
   OR ((:OLD.NUMPSP <> :NEW.NUMPSP) OR (:OLD.NUMPSP IS NULL AND :NEW.NUMPSP IS NOT NULL) OR (:NEW.NUMPSP IS NULL AND :OLD.NUMPSP IS NOT NULL))) THEN
  	   SP_RETIDTPES(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, NULL, NULL, NULL, NULL, l_IDTPES OUT); 
       SP_SAM_PENDENCIES(1,2,l_IDTPES); 
  END IF;
  
  /* Geração de logs Ficha Complementar (Tabela: R034CPL)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 109;     /* Ficha Complementar (Tabela: R034CPL)*/
  l_codtpa := 330;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.FicReg <> :NEW.FicReg)
   OR (:OLD.CodPai <> :NEW.CodPai)
   OR (:OLD.CodEst <> :NEW.CodEst)
