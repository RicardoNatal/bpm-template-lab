DECLARE
  l_PaiPlf NUMBER(7);
  l_DesPlf VARCHAR2(60);
  l_IdtRel NUMBER(5);
  l_CatPlf NUMBER(2);
  l_QtdPes NUMBER(4);
BEGIN
  /* Busco as informações, conforme local físico */
  BEGIN
    SELECT PAIPLF, DESPLF, IDTREL, CATPLF, QTDPES INTO l_PaiPlf, l_DesPlf, l_IdtRel, l_CatPlf, l_QtdPes FROM R058PLF
      WHERE VERPLF=:NEW.VERPLF AND CODPLF=:NEW.CODPLF;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'R058AUT: Erro ao buscar informações do local físico.';
  END;

  /* UpdatePhysicalLocationTree, sempre como alteração (1) */
  SP_PEND78(1, :NEW.VERPLF, :NEW.CODPLF, l_PaiPlf, l_DesPlf, l_IdtRel, l_CatPlf, l_QtdPes);
END␀o×␀␀		SENIOR;0³␀␀

