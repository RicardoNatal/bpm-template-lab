␀␀/* INSERT (NEW) */
TRIGGER R146PRM_EI AFTER INSERT ON R146PRM FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  xCodLoc 		   R016HIE.CODLOC%TYPE;
BEGIN

  /* Geração de logs ProvisaoMestre*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 63;     /* ProvisaoMestre*/
  l_codtpa := 237;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R146PRM_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.MESANO, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MESANO', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPPRV', CONVERT(NUMBER_TO_CHAR, :NEW.TIPPRV));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQPRV', CONVERT(NUMBER_TO_CHAR, :NEW.SEQPRV));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R146PRM_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORIPRV', :NEW.ORIPRV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCCU', :NEW.CODCCU);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :NEW.TABORG));
        RH_RET_CODLOC(:NEW.TABORG,:NEW.NUMLOC,:NEW.MESANO, xCodLoc OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', xCodLoc);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EMPANT', CONVERT(NUMBER_TO_CHAR, :NEW.EMPANT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CADANT', CONVERT(NUMBER_TO_CHAR, :NEW.CADANT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPTRF', CONVERT(NUMBER_TO_CHAR, :NEW.TIPTRF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MATMES', CONVERT(NUMBER_TO_CHAR, :NEW.MATMES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MATANO', CONVERT(NUMBER_TO_CHAR, :NEW.MATANO));
      END;
  END IF; 
END␀·â␀␀		SENIOR;0w␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R146PRM_EU AFTER UPDATE ON R146PRM FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  xCodLoc 		   R016HIE.CODLOC%TYPE;
BEGIN

  /* Geração de logs ProvisaoMestre*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 63;     /* ProvisaoMestre*/
  l_codtpa := 238;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.MesAno <> :NEW.MesAno)
   OR (:OLD.TipPrv <> :NEW.TipPrv)
   OR (:OLD.SeqPrv <> :NEW.SeqPrv)
   OR (:OLD.OriPrv <> :NEW.OriPrv)
   OR (:OLD.CodCcu <> :NEW.CodCcu)
   OR (:OLD.TabOrg <> :NEW.TabOrg)
   OR (:OLD.NumLoc <> :NEW.NumLoc)
   OR (:OLD.EmpAnt <> :NEW.EmpAnt)
   OR (:OLD.CadAnt <> :NEW.CadAnt)
   OR (:OLD.TipTrf <> :NEW.TipTrf)
   OR (:OLD.MatMes <> :NEW.MatMes)
   OR (:OLD.MatAno <> :NEW.MatAno)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R146PRM_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.MESANO, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MESANO', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPPRV', CONVERT(NUMBER_TO_CHAR, :OLD.TIPPRV));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQPRV', CONVERT(NUMBER_TO_CHAR, :OLD.SEQPRV));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R146PRM_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDORIPRV', :OLD.ORIPRV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWORIPRV', :NEW.ORIPRV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCCU', :OLD.CODCCU);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCCU', :NEW.CODCCU);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTABORG', CONVERT(NUMBER_TO_CHAR, :OLD.TABORG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTABORG', CONVERT(NUMBER_TO_CHAR, :NEW.TABORG));
        RH_RET_CODLOC(:OLD.TABORG,:OLD.NUMLOC,:OLD.MESANO, xCodLoc OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMLOC', xCodLoc);
        RH_RET_CODLOC(:NEW.TABORG,:NEW.NUMLOC,:NEW.MESANO, xCodLoc OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMLOC', xCodLoc);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDEMPANT', CONVERT(NUMBER_TO_CHAR, :OLD.EMPANT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWEMPANT', CONVERT(NUMBER_TO_CHAR, :NEW.EMPANT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCADANT', CONVERT(NUMBER_TO_CHAR, :OLD.CADANT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCADANT', CONVERT(NUMBER_TO_CHAR, :NEW.CADANT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPTRF', CONVERT(NUMBER_TO_CHAR, :OLD.TIPTRF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPTRF', CONVERT(NUMBER_TO_CHAR, :NEW.TIPTRF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDMATMES', CONVERT(NUMBER_TO_CHAR, :OLD.MATMES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWMATMES', CONVERT(NUMBER_TO_CHAR, :NEW.MATMES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDMATANO', CONVERT(NUMBER_TO_CHAR, :OLD.MATANO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWMATANO', CONVERT(NUMBER_TO_CHAR, :NEW.MATANO));
      END;
    END IF; 
  END IF; 
