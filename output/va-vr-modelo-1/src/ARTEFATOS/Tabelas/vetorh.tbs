  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 116;     /* Eventos - Tipos de Salário Inválidos (Tabela: R008TSA)*/
  l_codtpa := 361;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008TSA_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAB', CONVERT(NUMBER_TO_CHAR, :OLD.CODTAB));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :OLD.CODEVE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPSAL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPSAL));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R008TSA_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      
      BEGIN
	  	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
	  END;
  END IF; 
END␀␀␀Şg␀␀␀QÏ␀␀­-±␀	l!␀␀␀␀␀>´␀û␀q␀Æÿ␀␀Ï␀␀␀…,´␀	l!␀␀␀␀␀_@NgNgr␀Æÿ␀␀#␀İ-­␀	l!␀␀␀␀␀ÈAš(␀š(␀p␀Æÿ␀␀Ñ␀␀␀␀␀RÏ␀␀␀␀0;1;2WÏ␀␀	SENIOR;0HTRIGGER R008VIN_SI AFTER INSERT ON R008VIN

