/*CRACHÁ(Nº LÓGICO) DO VEÍCULO QUE SERÁ ASSOCIADO A PESSOA*/
PROCEDURE SP_VEIPESCON(P_TIPOPE CHAR(1),P_CRAVEI NUMBER(12),P_NUMCRA NUMBER(12),P_SITCRA NUMBER(1),P_PLAVEI VARCHAR2(10),P_DATVAL DATE,P_HORVAL NUMBER,P_TIPPES NUMBER(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20))
 IS

l_tipope     CHAR(1);
 l_datatu     DATE;
 l_horatu     NUMBER(4);
 l_sitcra     NUMBER(1); 
 l_numbar     NUMBER(12);
 l_numpro     NUMBER(12);
 l_numsma     NUMBER(12);
 l_crapri     NUMBER(12);
 l_tecpri     NUMBER(1);
 l_count      NUMBER;
 l_idtpes     VARCHAR2(23); 
 l_tippes_str CHAR(2);
 l_numemp     CHAR(4);
 l_tipcol     CHAR(1);
 l_numcad     CHAR(9);
 l_tipdoc     CHAR(1);
 l_datval     CHAR(16);
 l_datstr     CHAR(6);
 l_horstr     CHAR(4);
 /*TELEMÁTICA*/
 l_usutel     VARCHAR2(31);
 l_comando    VARCHAR2(1024);
 l_numcra     VARCHAR2(12);  
 l_cravei     VARCHAR(12);
 l_craveiTSI  VARCHAR(12);
 l_retstr     VARCHAR(2048);
 l_reterr     NUMBER(1);
 l_sitcra_str CHAR(1);
 l_condutor   CHAR(1);
 l_frota      CHAR(1);
 l_data_zero  DATE;
 l_datval_aux DATE;
 l_datval_fro DATE;
 l_datval_cnh DATE;
 l_horval_aux NUMBER(4);
 l_conlpr     CHAR(1);
 l_veifro     CHAR(1);
 l_numser     VARCHAR(12);
 l_icardR     VARCHAR(12);
 l_icard_vis  CHAR(1);
BEGIN
  
  /* Carrega variáveis */
  l_conlpr    := 'N';
  l_veifro    := 'N';
  l_condutor  := 'N';
  l_frota     := 'N';
  l_icard_vis := 'N'; /* Grava crachá do veículo do visitante no campo ICARDV (CONTVEI) */
  l_data_zero := '31/12/1900,00:00:00';
  l_tipope    := UPPER(p_tipope);
  l_count     := 0;
  l_datatu    := CURDATE();
  l_horatu    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  /* Controle LPR*/
  BEGIN
      SELECT CONLPR INTO l_conlpr FROM R088VEI WHERE PLAVEI = p_plavei;
  EXCEPTION
      WHEN OTHERS THEN l_conlpr := 'N';
  END;
  
  IF ((l_conlpr IS NULL) OR (l_conlpr <> 'S')) THEN
    l_conlpr := 'N';
  END IF;
	
  /* Faz parte da frota */
  BEGIN
	  SELECT COUNT(1) INTO l_count FROM R088VEF WHERE PLAVEI = p_plavei AND DATINI <= l_datatu AND (DATFIM >= l_datatu OR DATFIM = l_data_zero);
  EXCEPTION
      WHEN OTHERS THEN l_count := 0;
  END;  
  IF (l_count > 0) THEN
      l_veifro := 'S';
  END IF;	
  l_count := 0;
  
  /* Definições gerais */
  BEGIN
      SELECT FROONL, CONCON, VISTSI INTO l_frota, l_condutor, l_icard_vis FROM R088DFR;
  EXCEPTION
      WHEN OTHERS THEN 
                       l_frota := 'N';
                       l_condutor := 'N';
                       l_icard_vis := 'N';
  END;
  IF (l_icard_vis IS NULL OR l_icard_vis <> 'S') THEN
  	  l_icard_vis := 'N'; 
  END IF;
  
  /* TSI */
  SP_USUTEL(l_usutel OUT);		
  SP_RETICARD(l_idtpes, p_cravei, l_craveiTSI OUT , l_icardR OUT, l_numser OUT);
  SP_RETICARD(l_idtpes, p_numcra, l_numcra OUT , l_icardR OUT, l_numser OUT);
  IF (p_tippes = 4 AND l_icard_vis = 'N') THEN
      SP_RETICARD(l_idtpes, p_numcra, l_craveiTSI OUT , l_icardR OUT, l_numser OUT); /* TSI visitantes: CRACHÁ DO VEÍCULO É O MESMO CRACHÁ DO VISITANTE*/
  END IF;
  
  /*CONSISTE A OPERAÇÃO : U-UPDATE, I-INSERT OU D-REMOÇÃO*/
  IF (l_tipope <> 'I') AND (l_tipope <> 'U') AND (l_tipope <> 'D') AND (l_tipope <> 'R') THEN
      RAISERROR 103 'SP_VEIPESCON: Operação inválida.';
  END IF;	
  
  /* Monta IDTPES */
  IF (l_tipope<>'R') THEN
	  IF (p_tippes = 4) THEN
	      /* Visitantes */
	      IF ( (p_tipdoc = 0) OR (p_tipdoc IS NULL) ) OR ( (p_numdoc = '') OR (p_numdoc IS NULL) )  THEN
	          RAISERROR 103 'SP_VEIPESCON: Visitante não encontrado.';
	      END IF;
	      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
	      l_idtpes := '04'||l_tipdoc||p_numdoc;
	  ELSE	
	      /* Colaborador */
	      IF ( (p_tipcol = 0) OR (p_tipcol IS NULL) ) OR ( (p_numcad = 0) OR (p_numcad IS NULL) ) OR ( (p_numemp = 0) OR (p_numemp IS NULL) ) THEN
	          RAISERROR 103 'SP_VEIPESCON: Colaborador não encontrado.';
	      END IF;
	      SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
	      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
	      SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
	      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
	      l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
	  END IF;
	
	
	  /* GARANTIR 23 POSIÇÕES NO IDTPES*/
	  LOOP
	      IF (Length(l_idtpes) > 22) THEN
	          EXIT;
		  END IF;
		  l_idtpes := ' '||l_idtpes;
	  END LOOP;  
  END IF;
  
  /*BUSCA AS TECNOLOGIAS DO CRACHÁ DO VEÍCULO PARA VALIDAR NA CONTROLE (R0088CON)*/
  l_tecpri := 1;
  SP_MAPFIS(p_cravei, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
  
  /*caso não possua pré cadastro, assume tecnologia barras e número lógico*/
  IF (l_crapri = 0) THEN
      l_tecpri := 1;
      l_crapri := p_cravei;      
  END IF;
  
  IF (l_tecpri = 1) THEN
      /*SE TECNOLOGIA BARRAS, VERIFICA SE TEM PROXIMIDADE OU SMART, CASO CONTRÁRIO SAI DO LOOP*/
      IF (l_numpro > 0) THEN
          l_tecpri := 2;
          l_crapri := l_numpro;
      ELSE
          IF (l_numsma > 0) THEN
              l_tecpri := 3;
              l_crapri := l_numsma;
          END IF;
      END IF;
  ELSE
      IF (l_tecpri = 2) THEN
          /*SE TECNOLOGIA PROXIMIDADE, VERIFICA SE TEM SMART, CASO CONTRÁRIO SAI DO LOOP*/
          IF (l_numsma > 0) THEN
              l_tecpri := 3;
              l_crapri := l_numsma;
          END IF;
      END IF;
  END IF;
  
  /* CALCULA VALIDADE */
  l_sitcra := p_sitcra;
  IF ((p_datval < l_datatu) OR ( (l_datatu = p_datval) AND (p_horval <= l_horatu) )) AND (p_datval <> l_data_zero) THEN
      l_sitcra := 1;
  END IF;
  l_datval_aux := p_datval;
  l_horval_aux := p_horval;
  IF (l_datval_aux = l_data_zero) THEN
      SP_STRTODATE('31122050', 'DDMMAAAA', l_datval_aux OUT);
      l_horval_aux := 1439;
  END IF;
  
  IF (l_frota = 'S') THEN
      /*Validade do veículo na frota*/
      BEGIN
	      SELECT MAX(DATFIM) INTO l_datval_fro FROM R088VEF WHERE PLAVEI = p_plavei AND DATFIM >= l_datatu;
	  EXCEPTION
	      WHEN OTHERS THEN l_datval_aux := p_datval;
      END;
	  /*Valida a menor*/
	  IF (l_datval_aux > l_datval_fro) AND (l_datval_fro <> l_data_zero) THEN
	      l_datval_aux := l_datval_fro;
	      l_horval_aux := 0;
	  END IF;
  END IF;
	
  IF (l_condutor = 'S') THEN
      /*Validade da CNH do condutor*/
	  BEGIN
	      SELECT VENCNH INTO l_datval_cnh FROM R088COF WHERE EMPCON = p_numemp AND TCLCON = p_tipcol AND CADCON = p_numcad;
	  EXCEPTION
	      WHEN OTHERS THEN l_datval_cnh := p_datval;
	  END;
      /*Valida a menor*/
	  IF (l_datval_aux > l_datval_cnh) AND (l_datval_cnh <> l_data_zero) THEN
	      l_datval_aux := l_datval_cnh;
	      l_horval_aux := 1439;
	  END IF;
  END IF;
  SP_DATSTR(l_datval_aux,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_horval_aux,'HHMM',l_horstr OUT);
  l_datval := l_datstr||l_horstr||'000000';

	                  
    
  /*REMOÇÃO DO HISTÓRICO DO VEÍCULO NO SISTEMA, LOGO AS ASSOCIAÇÕES DESTE VEÍCULOS SÃO FINALIZADAS*/
  IF (l_tipope = 'R') THEN
      BEGIN
	      DELETE FROM R088CON WHERE PLAVEI = p_plavei;
	  EXCEPTION
	      WHEN OTHERS THEN RAISERROR 103 'SP_VEIPESCON: Erro ao remover veículo da controle.';
	  END;
	  /*TSI*/
	  l_comando := 'DELETE '||l_usutel||'CONTVEI WHERE ICARDV ='''|| l_craveiTSI ||''' ';
	  SP_CMDTSI(l_comando);
  END IF;
  
  /* DELETE */
  IF (l_tipope = 'D') THEN
      BEGIN
	      DELETE FROM R088CON WHERE IDTPES = l_idtpes AND NUMFIS = l_crapri AND TECCRA = l_tecpri AND PLAVEI = p_plavei;
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SP_VEIPESCON: Erro ao excluir registro da controle.';
      END; 
      /*TSI*/
      l_comando := 'DELETE '||l_usutel||'CONTVEI WHERE ICARD ='''|| l_numcra ||''' AND ICARDV ='''|| l_craveiTSI ||''' ';
      SP_CMDTSI(l_comando);      
  END IF;
  
  /* INSERT  */
  IF (l_tipope = 'I') OR (l_tipope = 'U') THEN
      
      IF (p_cravei > 0) THEN
	      BEGIN
		      SELECT COUNT(*) INTO l_count FROM R088CON
	                           WHERE IDTPES = l_idtpes AND NUMFIS = l_crapri AND TECCRA = l_tecpri AND 
	                                 PLAVEI = p_plavei AND CRAVEI = p_cravei;
		  EXCEPTION
		      WHEN OTHERS THEN l_count := 0;
		  END;
		  IF (l_count > 0) THEN
		      BEGIN
			      /*ALTERA O REGISTRO DA CONTROLE DE VEÍCULOS*/
			      UPDATE R088CON SET DATVAL = l_datval, SITCRA = l_sitcra, VEIFRO = l_veifro, CONLPR = l_conlpr 
			               WHERE IDTPES = l_idtpes AND NUMFIS = l_crapri AND TECCRA = l_tecpri AND PLAVEI = p_plavei;
	          EXCEPTION
	              WHEN OTHERS THEN RAISERROR 103 'SP_VEIPESCON: Erro ao atualizar registro na controle.';
	          END;
	      ELSE
		      BEGIN
		          /*INSERE O REGISTRO NA CONTROLE DE VEÍCULOS*/
		          INSERT INTO R088CON (IDTPES,NUMFIS,TECCRA, PLAVEI, CRAVEI, DATVAL, SITCRA, CONLPR, VEIFRO)
		                       VALUES (l_idtpes, l_crapri, l_tecpri, p_plavei, p_cravei, l_datval, l_sitcra, l_conlpr, l_veifro);
		      EXCEPTION
		          WHEN OTHERS THEN RAISERROR 103 'SP_VEIPESCON: Erro ao inserir registro na controle.';
		      END;
		  END IF;
		  
		  /* TSI */
		  l_count := 0;
		  l_comando := 'SELECT COUNT(1) FROM '||l_usutel||'CONTVEI WHERE ICARD ='''|| l_numcra ||''' AND ICARDV ='''|| l_craveiTSI ||''' ';
		  SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
		  /*NO DATA FOUND E TO MANY ROWS*/
		  IF (l_reterr = 1) OR (l_reterr = 2) THEN
		      l_count := 0;
		  END IF;
		  SP_INTSTR(l_sitcra,'9',l_sitcra_str OUT);
		  IF (l_count > 0) THEN
		      l_comando := 'UPDATE '||l_usutel||'CONTVEI SET DATAHORA='''|| SUBSTRING(l_datval,1,10) ||''', SITUA='''||
		                         l_sitcra_str ||''' WHERE ICARD = '''|| l_numcra ||''' AND ICARDV = '''|| l_craveiTSI ||''' ';
		  ELSE
		      l_comando := 'INSERT INTO '||l_usutel||'CONTVEI (ICARD, ICARDV, DATAHORA, SITUA)';
		      l_comando := l_comando||' VALUES ('''|| l_numcra ||''','''|| l_craveiTSI ||''','''|| SUBSTRING(l_datval,1,10) ||''','''||l_sitcra_str ||''') ';
		  END IF;
		  SP_CMDTSI(l_comando);
	  ELSE
	      /* Se não tiver crachá do veículo = Veículo particular, atualiza se for LPR */
	      IF (l_conLPR = 'S') THEN
		      BEGIN
			      SELECT COUNT(*) INTO l_count FROM R088CON
		                           WHERE IDTPES = l_idtpes AND NUMFIS = l_crapri AND TECCRA = l_tecpri AND 
		                                 PLAVEI = p_plavei;
			  EXCEPTION
			      WHEN OTHERS THEN l_count := 0;
			  END;
			  IF (l_count > 0) THEN
			      BEGIN
				      /*ALTERA O REGISTRO DA CONTROLE DE VEÍCULOS*/
				      UPDATE R088CON SET DATVAL = l_datval, SITCRA = l_sitcra, VEIFRO = l_veifro, CONLPR = l_conlpr 
				               WHERE IDTPES = l_idtpes AND NUMFIS = l_crapri AND TECCRA = l_tecpri AND PLAVEI = p_plavei;
		          EXCEPTION
		              WHEN OTHERS THEN RAISERROR 103 'SP_VEIPESCON: Erro ao atualizar registro na controle.';
		          END;
		      ELSE
			      BEGIN
			          /*INSERE O REGISTRO NA CONTROLE DE VEÍCULOS*/
			          INSERT INTO R088CON (IDTPES,NUMFIS,TECCRA, PLAVEI, CRAVEI, DATVAL, SITCRA, CONLPR, VEIFRO)
			                       VALUES (l_idtpes, l_crapri, l_tecpri, p_plavei, p_cravei, l_datval, l_sitcra, l_conlpr, l_veifro);
			      EXCEPTION
			          WHEN OTHERS THEN RAISERROR 103 'SP_VEIPESCON: Erro ao inserir registro na controle.';
			      END;
			  END IF;
		  END IF;	  
	  END IF; /* p_numcra = 0*/
	  
  
  END IF;
END		SENIOR;22]SP_USUTEL
SP_INTSTR
SP_MAPFIS
SP_STRTODATE
SP_DATSTR
SP_CMDTSI
SP_SELTSI
