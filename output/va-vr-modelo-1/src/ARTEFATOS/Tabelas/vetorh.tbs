DECLARE
	l_StaEnv CHAR;
BEGIN
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio e Erro Envio podem ser alterados.';
	END IF;
END␀bå␀␀	SENIOR;0/␀␀

