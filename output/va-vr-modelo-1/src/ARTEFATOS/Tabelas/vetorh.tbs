	    /* insere os campos que não são chave na Tabela R995PRT (Tipo de auditoria) */
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REFFIN', CONVERT(NUMBER_TO_CHAR, :OLD.RefFin));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALFIN', CONVERT(NUMBER_TO_CHAR, :OLD.ValFin));		 
	END;	
  END IF;  
END␀␀␀³£␀␀␀␀␀␀␀␀␀␀␀␀␀␀Ö␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t	␀␀␀␀␀␀␀Ù␀t␀Ü␀n¼‡␀Æÿ␀␀ÿ␀c¬␀␀Ì␀	␀␀␀␀␀␀␀.%€$0.w¼‡␀Æÿ␀␀ÿ␀-,·␀	␀␀␀␀␀␀␀O?ë9O?sI‰␀Æÿ␀␀ûÕ␀␀␀™ı␀␀´␀	␀␀␀␀␀␀␀xş␀␀xş␀␀xş␀␀r␀Æÿ␀␀ÿ␀0To␀␀␀␀␀␀␀;YvÆ␀␀;Yi␀␀ÿ␀␀ÿ␀á	␀Ì␀␀␀␀␀␀␀␀Œ
