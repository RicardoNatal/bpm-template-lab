␀␀␀␀␀␀l␀␀ÿ␀␀ÿ␀Ê␀␀±␀€␀␀␀␀␀␀Ì␀␀”Ê␀␀¶Ê␀␀q␀Æÿ␀␀ÿ␀µDÑ␀€␀␀␀␀␀␀}IşZuFqC␀êÿ␀␀ÿ␀óÉ␀␀±␀€␀␀␀␀␀␀Ì␀␀@É␀␀¦Ê␀␀q␀Æÿ␀␀ÿ␀ëÉ␀␀±␀€␀␀␀␀␀␀ÍË␀␀?É␀␀£Ê␀␀q␀Æÿ␀␀ÿ␀”‘␀␀=€␀␀␀␀␀␀’␀␀á␀}’␀␀c␀␀␀ÿ␀␀ÿ␀-±␀€␀␀␀␀␀␀*£␀␀Î¢␀␀Î¢␀␀q␀Æÿ␀␀Åİ␀␀␀r³␀␀€␀€␀␀␀␀␀␀ñ³␀␀G²␀␀¯´␀␀"␀␀ÿ␀␀ÿ␀[M€␀␀␀␀␀␀|␀␀|Ç␀␀“c␀␀␀ÿ␀␀ÿN×-‹␀€␀␀␀␀␀␀»Am␀m␀—)␀␀Æÿ␀␀ÿ␀©¬␀␀Ì␀€␀␀␀␀␀␀õ«␀␀\›␀␀\›␀␀”)␀␀Æÿ␀␀ÿ␀-Ç␀€␀␀␀␀␀␀v@ppz␀Æÿ␀␀ÖÒ␀␀␀i)(€␀␀␀␀␀␀ˆ)ù!ƒ)1␀␀ÿ␀␀ÿ␀vï␀␀F€␀␀␀␀␀␀Õï␀␀Eï␀␀Õï␀␀F␀␀ÿ␀␀ÿ␀-[¡␀€␀␀␀␀␀␀¯N­N®Np␀Æÿ␀␀ÿ␀ƒ¬␀␀€␀␀␀␀␀␀ÆcŠcÅce␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3;4;5²İ␀␀		SENIOR;0¹␀␀TRIGGER R096DIE_EI BEFORE INSERT ON R096DIE FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataMaxima DATE;
	l_DataInicioSST DATE;
	l_CerEPI   R086DEF.CerEPI%TYPE;
	l_Json VARCHAR2(2000);
	l_codSistema NUMBER(2);
	l_codcpa NUMBER(4);
	l_codtpa NUMBER(4);
	l_temAud BOOLEAN;
	l_codrpa NUMBER(15);
	l_datTemp VARCHAR(10);
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DataMaxima := DATETIME(04, 08, 2080, 0, 0, 0);
	
	RH_RET_DATINISST(:NEW.NumEmp, l_DataInicioSST OUT);
	IF (l_DataInicioSST > l_DataZero AND :NEW.DatEnt >= l_DataInicioSST) THEN
		SM_RETDEFPPP(:NEW.NumEmp, l_CerEPI OUT);
		IF (l_CerEPI = 'C' OR l_CerEPI = 'D') THEN
			l_Json := '';
			SP_CONCATENAR_NUM('CODEPI', :NEW.CodEpi, l_Json OUT);
			SP_CONCATENAR_NUM('SEQDIE', :NEW.SeqDie, l_Json OUT);
			
			SP_E_SOCIAL_SM('S-2240', 'R096DIE', 'N', 'I', :NEW.DatEnt, l_DataMaxima, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_Json, '', 0, NULL, :NEW.DatEnt, 0, 'R096DIE_EI');
		END IF;
	END IF;
	
	l_codSistema := 1;
	l_codcpa := 124;
	l_codtpa := 379;
	
	SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);
	
	IF (l_temAud = TRUE) THEN
	  SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R096DIE_EI', '');
      
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEPI', CONVERT(NUMBER_TO_CHAR, :NEW.CODEPI));
        SP_DATSTR(:NEW.DATENT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATENT', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQDIE', CONVERT(NUMBER_TO_CHAR, :NEW.SEQDIE));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R096DIE_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MEDEPI', :NEW.MEDEPI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDENT', CONVERT(NUMBER_TO_CHAR, :NEW.QTDENT));
        SP_DATSTR(:NEW.DATDEV, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATDEV', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDDEV', CONVERT(NUMBER_TO_CHAR, :NEW.QTDDEV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDDAN', CONVERT(NUMBER_TO_CHAR, :NEW.QTDDAN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INSUSO', :NEW.INSUSO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODMTV', CONVERT(NUMBER_TO_CHAR, :NEW.CODMTV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSDIS', :NEW.OBSDIS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ASSPRO', :NEW.ASSPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR, :NEW.CODUSU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOT', CONVERT(NUMBER_TO_CHAR, :NEW.NUMLOT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOEM', CONVERT(NUMBER_TO_CHAR, :NEW.CODOEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CERAPR', :NEW.CERAPR);
      END;
	END IF;
END␀³İ␀␀		SENIOR;0\␀␀

TRIGGER R096DIE_EU BEFORE UPDATE ON R096DIE FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataMaxima DATE;
	l_DataInicioSST DATE;
	l_AlterouCampo BOOLEAN;
	l_AlterouRegistro BOOLEAN;
	l_CerEPI   R086DEF.CerEPI%TYPE;
	l_Json VARCHAR2(2000);
	l_JsonAlteracao VARCHAR2(2000);
	l_codSistema NUMBER(2);
	l_codcpa NUMBER(4);
	l_codtpa NUMBER(4);
	l_temAud BOOLEAN;
	l_codrpa NUMBER(15);
	l_datTemp VARCHAR(10);
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DataMaxima := DATETIME(04, 08, 2080, 0, 0, 0);
	l_Json := '';
	
	RH_RET_DATINISST(:NEW.NumEmp, l_DataInicioSST OUT);
	IF (l_DataInicioSST > l_DataZero AND :NEW.DatEnt >= l_DataInicioSST) THEN
		SM_RETDEFPPP(:NEW.NumEmp, l_CerEPI OUT);
		
		IF ((l_CerEPI = 'D') OR (l_CerEPI = 'C')) THEN
			SP_VALUPDATE_NUM(:OLD.CodOem, :NEW.CodOem, l_AlterouCampo OUT);
	  		IF (l_AlterouCampo = TRUE) THEN
				l_AlterouRegistro := TRUE;
				SP_CONCAT_NUM_JSON('CODOEM', :NEW.CodOem, :OLD.CodOem, l_JsonAlteracao OUT);
	  		END IF;
  		END IF;
  		
  		IF (l_CerEPI = 'C') THEN
 			SP_VALUPDATE_DES(:OLD.CerApr, :NEW.CerApr, l_AlterouCampo OUT);
  			IF (l_AlterouCampo = TRUE) THEN
				l_AlterouRegistro := TRUE;
				SP_CONCAT_DES_JSON('CERAPR', :NEW.CerApr, :OLD.CerApr, l_JsonAlteracao OUT);
  			END IF;
  		END IF;
  		
  		IF (l_AlterouRegistro = TRUE) THEN
  			SP_CONCATENAR_NUM('CODEPI', :NEW.CodEpi, l_Json OUT);
  			SP_CONCATENAR_NUM('SEQDIE', :NEW.SeqDie, l_Json OUT);
  			
			SP_E_SOCIAL_SM('S-2240', 'R096DIE', 'N', 'A', :NEW.DatEnt, l_DataMaxima, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, l_Json, l_JsonAlteracao, 0, NULL, :NEW.DatEnt, 0, 'R096DIE_EU');
		END IF;
	END IF;
	
	l_codSistema := 1;
	l_codcpa := 124;
	l_codtpa := 380;
	
	SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);
	
	IF ((:OLD.NumEmp <> :NEW.NumEmp) 
	 OR (:OLD.TIPCOL <> :NEW.TIPCOL) 
	 OR (:OLD.NUMCAD <> :NEW.NUMCAD)
	 OR (:OLD.CODEPI <> :NEW.CODEPI)
	 OR (:OLD.DATENT <> :NEW.DATENT)
	 OR (:OLD.SEQDIE <> :NEW.SEQDIE)
	 OR (:OLD.MEDEPI <> :NEW.MEDEPI)
	 OR (:OLD.QTDENT <> :NEW.QTDENT)
	 OR (:OLD.DATDEV <> :NEW.DATDEV)
	 OR (:OLD.QTDDEV <> :NEW.QTDDEV)
	 OR (:OLD.QTDDAN <> :NEW.QTDDAN)
	 OR (:OLD.INSUSO <> :NEW.INSUSO)
	 OR (:OLD.CODMTV <> :NEW.CODMTV)
	 OR (:OLD.OBSDIS <> :NEW.OBSDIS)
	 OR (:OLD.ASSPRO <> :NEW.ASSPRO)
	 OR (:OLD.CODUSU <> :NEW.CODUSU)
	 OR (:OLD.NUMLOT <> :NEW.NUMLOT)
	 OR (:OLD.CODOEM <> :NEW.CODOEM)
	 OR (:OLD.CERAPR <> :NEW.CERAPR)) THEN
	
	  IF (l_temAud = TRUE) THEN
	    SP_RET_REG_AUD(l_codrpa OUT); 
        SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R096DIE_EU', '');
      
        BEGIN
          INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
          INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
          INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
          INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEPI', CONVERT(NUMBER_TO_CHAR, :OLD.CODEPI));
          SP_DATSTR(:OLD.DATENT, 'DD/MM/YYYY', l_datTemp OUT);
          INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATENT', l_datTemp);
          INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQDIE', CONVERT(NUMBER_TO_CHAR, :OLD.SEQDIE));
        EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'R096DIE_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
        END;
        
        BEGIN
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDMEDEPI', :OLD.MEDEPI);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWMEDEPI', :NEW.MEDEPI);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQTDENT', CONVERT(NUMBER_TO_CHAR, :OLD.QTDENT));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQTDENT', CONVERT(NUMBER_TO_CHAR, :NEW.QTDENT));
          SP_DATSTR(:OLD.DATDEV, 'DD/MM/YYYY', l_datTemp OUT);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATDEV', l_datTemp);
          SP_DATSTR(:NEW.DATDEV, 'DD/MM/YYYY', l_datTemp OUT);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATDEV', l_datTemp);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQTDDEV', CONVERT(NUMBER_TO_CHAR, :OLD.QTDDEV));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQTDDEV', CONVERT(NUMBER_TO_CHAR, :NEW.QTDDEV));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQTDDAN', CONVERT(NUMBER_TO_CHAR,:OLD.QTDDAN));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQTDDAN', CONVERT(NUMBER_TO_CHAR,:NEW.QTDDAN));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINSUSO', :OLD.INSUSO);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINSUSO', :NEW.INSUSO);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODMTV', CONVERT(NUMBER_TO_CHAR, :OLD.CODMTV));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODMTV', CONVERT(NUMBER_TO_CHAR, :NEW.CODMTV));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSDIS', :OLD.OBSDIS);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSDIS', :NEW.OBSDIS);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDASSPRO', :OLD.ASSPRO);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWASSPRO', :NEW.ASSPRO);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODUSU', CONVERT(NUMBER_TO_CHAR, :OLD.CODUSU));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODUSU', CONVERT(NUMBER_TO_CHAR, :NEW.CODUSU));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMLOT', CONVERT(NUMBER_TO_CHAR, :OLD.NUMLOT));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMLOT', CONVERT(NUMBER_TO_CHAR, :NEW.NUMLOT));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODOEM', CONVERT(NUMBER_TO_CHAR, :OLD.CODOEM));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODOEM', CONVERT(NUMBER_TO_CHAR, :NEW.CODOEM));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCERAPR', :OLD.CERAPR);
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCERAPR', :NEW.CERAPR);
        END;
	  END IF;
	END IF; 
END␀±İ␀␀		SENIOR;0␀␀

TRIGGER R096DIE_ED BEFORE DELETE ON R096DIE FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DataInicioSST DATE;
	l_DataMaxima DATE;
	l_CerEPI   R086DEF.CerEPI%TYPE;
	l_Json VARCHAR2(2000);
	l_codSistema NUMBER(2);
	l_codcpa NUMBER(4);
	l_codtpa NUMBER(4);
	l_temAud BOOLEAN;
	l_codrpa NUMBER(15);
	l_datTemp VARCHAR(10);
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DataMaxima := DATETIME(04, 08, 2080, 0, 0, 0);
	
	RH_RET_DATINISST(:OLD.NumEmp, l_DataInicioSST OUT);
	IF (l_DataInicioSST > l_DataZero AND :OLD.DatEnt >= l_DataInicioSST) THEN
		SM_RETDEFPPP(:OLD.NumEmp, l_CerEPI OUT);
		IF (l_CerEPI = 'C' OR l_CerEPI = 'D') THEN
			l_Json := '';
			SP_CONCATENAR_NUM('CODEPI', :OLD.CodEpi, l_Json OUT);
			SP_CONCATENAR_NUM('SEQDIE', :OLD.SeqDie, l_Json OUT);
			
			SP_E_SOCIAL_SM('S-2240', 'R096DIE', 'N', 'E', :OLD.DatEnt, l_DataMaxima, :OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, l_Json, '', 0, NULL, :OLD.DatEnt, 0, 'R096DIE_ED');
		END IF;
	END IF;
	
	l_codSistema := 1;
	l_codcpa := 124;
	l_codtpa := 379;
	
	SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);
	
	IF (l_temAud = TRUE) THEN
	  SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R096DIE_ED', '');
      
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEPI', CONVERT(NUMBER_TO_CHAR, :OLD.CODEPI));
        SP_DATSTR(:OLD.DATENT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATENT', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQDIE', CONVERT(NUMBER_TO_CHAR, :OLD.SEQDIE));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R096DIE_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MEDEPI', :OLD.MEDEPI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDENT', CONVERT(NUMBER_TO_CHAR, :OLD.QTDENT));
        SP_DATSTR(:OLD.DATDEV, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATDEV', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDDEV', CONVERT(NUMBER_TO_CHAR, :OLD.QTDDEV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDDAN', CONVERT(NUMBER_TO_CHAR,:OLD.QTDDAN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INSUSO', :OLD.INSUSO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODMTV', CONVERT(NUMBER_TO_CHAR, :OLD.CODMTV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSDIS', :OLD.OBSDIS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ASSPRO', :OLD.ASSPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR, :OLD.CODUSU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOT', CONVERT(NUMBER_TO_CHAR, :OLD.NUMLOT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOEM', CONVERT(NUMBER_TO_CHAR, :OLD.CODOEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CERAPR', :OLD.CERAPR); 
      END;
	END IF;
		    
    BEGIN
        DELETE FROM R240EPI
        WHERE
            NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND 
            CODEPI = :OLD.CODEPI AND DATENT = :OLD.DATENT AND SEQDIE = :OLD.SEQDIE;
    EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro no Delete da Tabela R240EPI. ';
