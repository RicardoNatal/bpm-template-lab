TRIGGER R110MAT_AD
AFTER DELETE ON R110MAT
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  l_codSistema := 1;
  l_codcpa := 142;
  l_codtpa := 415;

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110MAT_AD', '');

    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:OLD.CODFIC));
      SP_DATSTR(:OLD.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR,:OLD.HORATE));
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110MAT_AD: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPATE', CONVERT(NUMBER_TO_CHAR,:OLD.TIPATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR,:OLD.CODATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AREATE', CONVERT(NUMBER_TO_CHAR,:OLD.AREATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOCO', CONVERT(NUMBER_TO_CHAR,:OLD.CODOCO));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALCUS', CONVERT(NUMBER_TO_CHAR,:OLD.VALCUS));
      SP_DATSTR(:OLD.DATRET, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATRET', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORENT', CONVERT(NUMBER_TO_CHAR,:OLD.HORENT));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORSAI', CONVERT(NUMBER_TO_CHAR,:OLD.HORSAI));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSATE', :OLD.OBSATE);
      SP_DATSTR(:OLD.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAFA', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORAFA', CONVERT(NUMBER_TO_CHAR,:OLD.HORAFA));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITATE', CONVERT(NUMBER_TO_CHAR,:OLD.SITATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAATE', CONVERT(NUMBER_TO_CHAR,:OLD.DIAATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITAFA', CONVERT(NUMBER_TO_CHAR,:OLD.SITAFA));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAAFA', CONVERT(NUMBER_TO_CHAR,:OLD.DIAAFA));
      SP_DATSTR(:OLD.FIMAFA, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMAFA', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORTER', CONVERT(NUMBER_TO_CHAR,:OLD.HORTER));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EXMRET', :OLD.EXMRET);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMREC', CONVERT(NUMBER_TO_CHAR,:OLD.NUMREC));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMATE', CONVERT(NUMBER_TO_CHAR,:OLD.NUMATE));
      SP_DATSTR(:OLD.DATACT, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATACT', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORACT', CONVERT(NUMBER_TO_CHAR,:OLD.HORACT));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR,:OLD.CODUSU));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ATECPL', CONVERT(NUMBER_TO_CHAR,:OLD.ATECPL));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ARECPL', CONVERT(NUMBER_TO_CHAR,:OLD.ARECPL));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RECCPL', CONVERT(NUMBER_TO_CHAR,:OLD.RECCPL));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NATCPL', CONVERT(NUMBER_TO_CHAR,:OLD.NATCPL));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSCPL', :OLD.OBSCPL);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ATEPRE', CONVERT(NUMBER_TO_CHAR,:OLD.ATEPRE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITATD', CONVERT(NUMBER_TO_CHAR,:OLD.SITATD));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ATEFIM', CONVERT(NUMBER_TO_CHAR,:OLD.ATEFIM));
      SP_DATSTR(:OLD.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATFIM', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORFIM', CONVERT(NUMBER_TO_CHAR,:OLD.HORFIM));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPOS', CONVERT(NUMBER_TO_CHAR,:OLD.CODPOS));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDALT', :OLD.INDALT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSPRE', :OLD.OBSPRE);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDAGE', :OLD.INDAGE);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORRET', CONVERT(NUMBER_TO_CHAR,:OLD.HORRET));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RAIATE', CONVERT(NUMBER_TO_CHAR,:OLD.RAIATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RAIAFA', CONVERT(NUMBER_TO_CHAR,:OLD.RAIAFA));
      SP_DATSTR(:OLD.FIMATE, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMATE', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PREAFA', :OLD.PREAFA);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ATEASS', :OLD.ATEASS);      
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DURTRA', CONVERT(NUMBER_TO_CHAR,:OLD.DURTRA));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RISNEX', :OLD.RISNEX);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAJUS', CONVERT(NUMBER_TO_CHAR,:OLD.DIAJUS));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABPRI', CONVERT(NUMBER_TO_CHAR,:OLD.TABPRI));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRI', CONVERT(NUMBER_TO_CHAR,:OLD.CODPRI));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ACITRA', CONVERT(NUMBER_TO_CHAR,:OLD.ACITRA));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MSMMOT', :OLD.MSMMOT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ATEEXT', CONVERT(NUMBER_TO_CHAR,:OLD.ATEEXT));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NATEXT', CONVERT(NUMBER_TO_CHAR,:OLD.NATEXT));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MODATD', CONVERT(NUMBER_TO_CHAR,:OLD.MODATD));
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110MAT_AD: Erro ao inserir valores dos campos para a tabela de log de auditoria R995PRT.';
    END;
  END IF;
