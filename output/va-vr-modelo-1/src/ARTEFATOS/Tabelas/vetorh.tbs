/* P_OPERATIONKIND: CREATE_ALL(0), CREATE(1), UPDATE(2), DELETE(3) */
PROCEDURE SP_SAM_PENDENCIES(P_ROTINE NUMBER(2), P_OPERATIONKIND NUMBER(1), P_IDREGISTER VARCHAR(255))
 IS
BEGIN
  NULL;
END	ORACLE;0
␀␀CREATE or replace PROCEDURE SP_SAM_PENDENCIES(P_ROTINE IN NUMBER,P_OPERATIONKIND IN NUMBER,P_IDREGISTER IN VARCHAR2) is
  l_data_atual DATE;
  l_intsam VARCHAR2(1);
  l_IntVis VARCHAR2(1);
  l_IntAlu VARCHAR2(1);
  l_IntRes VARCHAR2(1);
  l_IntPac VARCHAR2(1);
  l_IntAce VARCHAR2(1);
  l_IntAlm VARCHAR2(1);
  l_IntPlf VARCHAR2(1);
  l_IntDsp VARCHAR2(1);
  l_IntUsu VARCHAR2(1);
  l_IntFot VARCHAR2(1);
  l_IntTvi VARCHAR2(1);
  l_IntEmp VARCHAR2(1);
  l_IntFil VARCHAR2(1);
  l_IntCar VARCHAR2(1);
  l_IntCCu VARCHAR2(1);
  l_IntOrg VARCHAR2(1);
  l_IntCon VARCHAR2(1);
  l_IntPrm VARCHAR2(1);
  l_IntEsc VARCHAR2(1);
  l_IntGTE VARCHAR2(1);
begin
  l_data_atual := SYSDATE;
  begin
    SELECT 
      INTSAM , IntVis, IntAlu, IntRes, IntPac, IntAce, IntAlm, IntPlf, IntDsp, IntUsu, IntFot, IntTvi, IntEmp, IntFil, IntCar, IntCCu, IntOrg, IntCon, IntPrm, IntEsc, IntGTE
      INTO l_intsam, l_IntVis, l_IntAlu, l_IntRes, l_IntPac, l_IntAce, l_IntAlm, l_Intplf, l_IntDsp, l_IntUsu, l_IntFot, l_IntTvi, l_IntEmp, l_IntFil, l_IntCar, l_IntCCu, l_IntOrg, l_IntCon, l_IntPrm, l_IntEsc, l_IntGTE
      FROM R000ASS;
  exception
    when OTHERS then
      raise_application_error(-20000 + -(103),'SP_SAM_PENDENCIES: Não conseguiu efetuar SELECT na tabela R000ASS.'||SQLERRM);
  end;
  
  if (l_intsam='S') and (P_IDREGISTER IS NOT NULL) and
     (
       ((P_ROTINE = 7 or P_ROTINE = 8) and l_IntVis = 'S') or  /* VISITOR(7), VISITOR_CREDENTIAL(8) */  
       ((P_ROTINE = 9 or P_ROTINE = 10) and l_IntAlu = 'S') or  /* STUDENT(9), STUDENT_CREDENTIAL(10) */
       ((P_ROTINE = 11 or P_ROTINE = 12) and l_IntRes = 'S') or  /* RESPONSIBLE_STUDENT(11), RESPONSIBLE_STUDENT_CREDENTIAL(12) */
       ((P_ROTINE = 13 or P_ROTINE = 14) and l_IntPac = 'S') or  /* PATIENT(13), PATIENT_CREDENTIAL(14) */
       ((P_ROTINE = 17) and l_IntAce = 'S') or /* ACCESS_EVENT_SAM(17) */
       ((P_ROTINE = 18 or P_ROTINE = 19) and l_IntAlm = 'S') or /* DEVICE_ALARM(18), DEVICE_NOTIFICATION(19) */
       ((P_ROTINE = 22) and l_IntPlf = 'S') or /* PHYSICAL_LOCATION(22) */
       ((P_ROTINE = 23) and l_IntDsp = 'S') or /* DEVICE(23) */
       ((P_ROTINE = 25) and l_IntUsu = 'S') or /* USER_SAM(25) */
       ((P_ROTINE = 27) and l_IntTvi = 'S') or /* VISIT_TYPE(27) */
       ((P_ROTINE = 30) and l_IntFot = 'S') or /* PHOTO(30) */
       ((P_ROTINE = 31) and l_IntEmp = 'S') or /* COMPANY(31) */
       ((P_ROTINE = 32) and l_IntFil = 'S') or /* BRANCH(32) */
       ((P_ROTINE = 33) and l_IntCar = 'S') or /* JOB(33) */
       ((P_ROTINE = 34) and l_IntCCu = 'S') or /* COST_CENTER(34) */
       ((P_ROTINE = 35) and l_IntOrg = 'S') or /* ORG_CHART(35) */
       ((P_ROTINE = 36 or P_ROTINE = 37) and l_IntCon = 'S') or /* OTHER_COMPANY(36), CONTRACT(37) */
       ((P_ROTINE = 40 or P_ROTINE = 41) and l_IntPrm = 'S') or /* PERMISSION(40), PERSON_PERMISSION(41) */
       ((P_ROTINE = 42) and l_IntEsc = 'S') or /* WORKER_SCHEDULE(42) */
       ((P_ROTINE = 43 or P_ROTINE = 44 or P_ROTINE = 45) and l_IntGTE = 'S') or /* GT_OTHER_COMPANY(43), GT_CONTRACT(44), GT_CONTRACT_PERSON(45) */
       (P_ROTINE not in (7, 8, 9, 10, 11, 12, 13, 14, 17, 18, 19, 22, 23, 25, 27, 30, 31, 32, 33, 34, 35, 36, 37, 40, 41, 42, 43, 44, 45))  /* todos os outros tipos */
     ) 
  then
    begin
      INSERT INTO SAM_PENDENCIES(ID_PENDENCY, ROTINE, OPERATIONTIME, OPERATIONKIND, STATUS, IDREGISTER, NUMBERTRIALS) VALUES (SEQ_SAM_PENDENCIES.nextval, P_ROTINE, l_data_atual, P_OPERATIONKIND, 0, P_IDREGISTER, 0);
    exception
      when OTHERS then
        raise_application_error(-20000 + -(103),'SP_SAM_PENDENCIES: Erro no insert da tabela de pendências.'||SQLERRM);
    end;
  end if;
end;	MSSQL;0
½␀␀CREATE  PROCEDURE sp_sam_pendencies(@P_ROTINE SMALLINT, @P_OPERATIONKIND SMALLINT, @P_IDREGISTER VARCHAR(255)) AS
BEGIN
  DECLARE @l_data_atual DATETIME
  DECLARE @l_intsam CHAR(1)
  DECLARE @l_IntVis CHAR(1)
  DECLARE @l_IntAlu CHAR(1)
  DECLARE @l_IntRes CHAR(1)
  DECLARE @l_IntPac CHAR(1)
  DECLARE @l_IntAce CHAR(1)
  DECLARE @l_IntAlm CHAR(1)
  DECLARE @l_IntPlf CHAR(1)
  DECLARE @l_IntDsp CHAR(1)
  DECLARE @l_IntUsu CHAR(1)
  DECLARE @l_IntFot CHAR(1)
  DECLARE @l_IntTvi CHAR(1)
  DECLARE @l_IntEmp CHAR(1)
  DECLARE @l_IntFil CHAR(1)
  DECLARE @l_IntCar CHAR(1)
  DECLARE @l_IntCCu CHAR(1)
  DECLARE @l_IntOrg CHAR(1)
  DECLARE @l_IntCon CHAR(1)
  DECLARE @l_IntPrm CHAR(1)
  DECLARE @l_IntEsc CHAR(1)
  DECLARE @l_IntGTE CHAR(1)
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @SE_EXC2 INTEGER
  SELECT @ChkError = 0
  SELECT @l_data_atual = GETDATE()
  /* TRY */
    SELECT 
      @l_intsam=r000ass.intsam,
      @l_IntVis=r000ass.IntVis, 
      @l_IntAlu=r000ass.IntAlu, 
      @l_IntRes=r000ass.IntRes, 
      @l_IntPac=r000ass.IntPac,
      @l_IntAce=r000ass.IntAce,
      @l_IntAlm=r000ass.IntAlm,
      @l_IntPlf=r000ass.IntPlf,
      @l_IntDsp=r000ass.IntDsp,
      @l_IntUsu=r000ass.IntUsu,
      @l_IntFot=r000ass.IntFot,
      @l_IntTvi=r000ass.IntTvi,
      @l_IntEmp=r000ass.IntEmp,
      @l_IntFil=r000ass.IntFil,
      @l_IntCar=r000ass.IntCar,
      @l_IntCCu=r000ass.IntCCu,
      @l_IntOrg=r000ass.IntOrg,
      @l_IntCon=r000ass.IntCon,
      @l_IntPrm=r000ass.IntPrm,
      @l_IntEsc=r000ass.IntEsc,
      @l_IntGTE=r000ass.IntGTE
       FROM r000ass r000ass
    SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
    IF @ChkError <> 0
    BEGIN
      GOTO EXC1
    END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC1:
    SELECT @SE_EXC1 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        BEGIN
          RAISERROR('SP_SAM_PENDENCIES: Não conseguiu efetuar SELECT na tabela R000ASS.',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
  IF (@l_intsam='S') AND (@P_IDREGISTER IS NOT NULL) AND
     (
       ((@P_ROTINE = 7 or @P_ROTINE = 8) and @l_IntVis = 'S') or  /* VISITOR(7), VISITOR_CREDENTIAL(8) */  
       ((@P_ROTINE = 9 or @P_ROTINE = 10) and @l_IntAlu = 'S') or  /* STUDENT(9), STUDENT_CREDENTIAL(10) */
       ((@P_ROTINE = 11 or @P_ROTINE = 12) and @l_IntRes = 'S') or  /* RESPONSIBLE_STUDENT(11), RESPONSIBLE_STUDENT_CREDENTIAL(12) */
       ((@P_ROTINE = 13 or @P_ROTINE = 14) and @l_IntPac = 'S') or  /* PATIENT(13), PATIENT_CREDENTIAL(14) */
       ((@P_ROTINE = 17) and @l_IntAce = 'S') or /* ACCESS_EVENT_SAM(17) */
       ((@P_ROTINE = 18 or @P_ROTINE = 19) and @l_IntAlm = 'S') or /* DEVICE_ALARM(18), DEVICE_NOTIFICATION(19) */
       ((@P_ROTINE = 22) and @l_IntPlf = 'S') or /* PHYSICAL_LOCATION(22) */
       ((@P_ROTINE = 23) and @l_IntDsp = 'S') or /* DEVICE(23) */
       ((@P_ROTINE = 25) and @l_IntUsu = 'S') or /* USER_SAM(25) */
       ((@P_ROTINE = 27) and @l_IntTvi = 'S') or /* VISIT_TYPE(27) */
       ((@P_ROTINE = 30) and @l_IntFot = 'S') or /* PHOTO(30) */
       ((@P_ROTINE = 31) and @l_IntEmp = 'S') or /* COMPANY(31) */
       ((@P_ROTINE = 32) and @l_IntFil = 'S') or /* BRANCH(32) */
       ((@P_ROTINE = 33) and @l_IntCar = 'S') or /* JOB(33) */
       ((@P_ROTINE = 34) and @l_IntCCu = 'S') or /* COST_CENTER(34) */
       ((@P_ROTINE = 35) and @l_IntOrg = 'S') or /* ORG_CHART(35) */
       ((@P_ROTINE = 36 or @P_ROTINE = 37) and @l_IntCon = 'S') or /* OTHER_COMPANY(36), CONTRACT(37) */
       ((@P_ROTINE = 40 or @P_ROTINE = 41) and @l_IntPrm = 'S') or /* PERMISSION(40), PERSON_PERMISSION(41) */
       ((@P_ROTINE = 42) and @l_IntEsc = 'S') or /* WORKER_SCHEDULE(42) */
       ((@P_ROTINE = 43 or @P_ROTINE = 44 or @P_ROTINE = 45) and @l_IntGTE = 'S') or /* GT_OTHER_COMPANY(43), GT_CONTRACT(44), GT_CONTRACT_PERSON(45) */
       (@P_ROTINE not in (7, 8, 9, 10, 11, 12, 13, 14, 17, 18, 19, 22, 23, 25, 27, 30, 31, 32, 33, 34, 35, 36, 37, 40, 41, 42, 43, 44, 45))  /* todos os outros tipos */
     ) 
  BEGIN
    /* TRY */
      INSERT INTO sam_pendencies
       (rotine,operationtime,operationkind,status,idregister,numbertrials) 
      VALUES 
      (@P_ROTINE,@l_data_atual,@P_OPERATIONKIND,0,@P_IDREGISTER,0)
      SELECT @ChkError = @@Error
      IF @ChkError <> 0
      BEGIN
        GOTO EXC2
      END
    /* END TRY */
    /* BEGIN EXCEPTION HANDLER */
      EXC2:
      SELECT @SE_EXC2 = @ChkError
      IF @ChkError <> 0
      BEGIN
        BEGIN
          SELECT @ChkError = 0
          BEGIN
            RAISERROR('SP_SAM_PENDENCIES: Erro no insert da tabela de pendências.',11,1) WITH SETERROR
            SELECT @ChkError = -30
            GOTO FIM
          END
        END
      END
    /* END EXCEPTION HANDLER */
  END
FIM:
  RETURN @ChkError
END	POSTGRESQL;0
␀␀CREATE or replace PROCEDURE SP_SAM_PENDENCIES(P_ROTINE IN INT,P_OPERATIONKIND IN INT,P_IDREGISTER IN VARCHAR(4000))
LANGUAGE 'plpgsql'
AS $BODY$
 declare
  l_data_atual TIMESTAMP(0);
  l_intsam VARCHAR(1);
  l_IntVis VARCHAR(1);
  l_IntAlu VARCHAR(1);
  l_IntRes VARCHAR(1);
  l_IntPac VARCHAR(1);
  l_IntAce VARCHAR(1);
  l_IntAlm VARCHAR(1);
  l_IntPlf VARCHAR(1);
  l_IntDsp VARCHAR(1);
  l_IntUsu VARCHAR(1);
  l_IntFot VARCHAR(1);
  l_IntTvi VARCHAR(1);
  l_IntEmp VARCHAR(1);
  l_IntFil VARCHAR(1);
  l_IntCar VARCHAR(1);
  l_IntCCu VARCHAR(1);
  l_IntOrg VARCHAR(1);
  l_IntCon VARCHAR(1);
  l_IntPrm VARCHAR(1);
  l_IntEsc VARCHAR(1);
  l_IntGTE VARCHAR(1);
begin
  l_data_atual := CURRENT_TIMESTAMP;
  begin
    SELECT 
      INTSAM , IntVis, IntAlu, IntRes, IntPac, IntAce, IntAlm, IntPlf, IntDsp, IntUsu, IntFot, IntTvi, IntEmp, IntFil, IntCar, IntCCu, IntOrg, IntCon, IntPrm, IntEsc, IntGTE
      INTO l_intsam, l_IntVis, l_IntAlu, l_IntRes, l_IntPac, l_IntAce, l_IntAlm, l_Intplf, l_IntDsp, l_IntUsu, l_IntFot, l_IntTvi, l_IntEmp, l_IntFil, l_IntCar, l_IntCCu, l_IntOrg, l_IntCon, l_IntPrm, l_IntEsc, l_IntGTE
      FROM R000ASS;
  exception
    when OTHERS then
      RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_SAM_PENDENCIES: Não conseguiu efetuar SELECT na tabela R000ASS.';
  end;

  if (l_intsam='S') and (P_IDREGISTER IS NOT NULL) and
     (
       ((P_ROTINE = 7 or P_ROTINE = 8) and l_IntVis = 'S') or  /* VISITOR(7), VISITOR_CREDENTIAL(8) */  
       ((P_ROTINE = 9 or P_ROTINE = 10) and l_IntAlu = 'S') or  /* STUDENT(9), STUDENT_CREDENTIAL(10) */
       ((P_ROTINE = 11 or P_ROTINE = 12) and l_IntRes = 'S') or  /* RESPONSIBLE_STUDENT(11), RESPONSIBLE_STUDENT_CREDENTIAL(12) */
       ((P_ROTINE = 13 or P_ROTINE = 14) and l_IntPac = 'S') or  /* PATIENT(13), PATIENT_CREDENTIAL(14) */
       ((P_ROTINE = 17) and l_IntAce = 'S') or /* ACCESS_EVENT_SAM(17) */
       ((P_ROTINE = 18 or P_ROTINE = 19) and l_IntAlm = 'S') or /* DEVICE_ALARM(18), DEVICE_NOTIFICATION(19) */
       ((P_ROTINE = 22) and l_IntPlf = 'S') or /* PHYSICAL_LOCATION(22) */
       ((P_ROTINE = 23) and l_IntDsp = 'S') or /* DEVICE(23) */
       ((P_ROTINE = 25) and l_IntUsu = 'S') or /* USER_SAM(25) */
       ((P_ROTINE = 27) and l_IntTvi = 'S') or /* VISIT_TYPE(27) */
       ((P_ROTINE = 30) and l_IntFot = 'S') or /* PHOTO(30) */
       ((P_ROTINE = 31) and l_IntEmp = 'S') or /* COMPANY(31) */
       ((P_ROTINE = 32) and l_IntFil = 'S') or /* BRANCH(32) */
       ((P_ROTINE = 33) and l_IntCar = 'S') or /* JOB(33) */
       ((P_ROTINE = 34) and l_IntCCu = 'S') or /* COST_CENTER(34) */
       ((P_ROTINE = 35) and l_IntOrg = 'S') or /* ORG_CHART(35) */
       ((P_ROTINE = 36 or P_ROTINE = 37) and l_IntCon = 'S') or /* OTHER_COMPANY(36), CONTRACT(37) */
       ((P_ROTINE = 40 or P_ROTINE = 41) and l_IntPrm = 'S') or /* PERMISSION(40), PERSON_PERMISSION(41) */
       ((P_ROTINE = 42) and l_IntEsc = 'S') or /* WORKER_SCHEDULE(42) */
       ((P_ROTINE = 43 or P_ROTINE = 44 or P_ROTINE = 45) and l_IntGTE = 'S') or /* GT_OTHER_COMPANY(43), GT_CONTRACT(44), GT_CONTRACT_PERSON(45) */
       (P_ROTINE not in (7, 8, 9, 10, 11, 12, 13, 14, 17, 18, 19, 22, 23, 25, 27, 30, 31, 32, 33, 34, 35, 36, 37, 40, 41, 42, 43, 44, 45))  /* todos os outros tipos */
     ) 
  then
    begin
      INSERT INTO SAM_PENDENCIES(ROTINE, OPERATIONTIME, OPERATIONKIND, STATUS, IDREGISTER, NUMBERTRIALS) VALUES (P_ROTINE, l_data_atual, P_OPERATIONKIND, 0, P_IDREGISTER, 0);
    exception
      when OTHERS then
        RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_SAM_PENDENCIES: Erro no insert da tabela de pendências.';
    end;
  end if;
end;
$BODY$;␀Ûø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0!SP_RETIDTPES
SP_SAM_PENDENCIES
J␀␀/* -- Inclusao de pendencias de escala para o SAMSenior na alteracao de faixa horaria -- */
PROCEDURE SP_SAM_PEND_FHR(P_CODHOR NUMBER(4))
 IS

  l_intesc      CHAR(1);
  l_pend_aberta NUMBER;
  l_idtpes      CHAR(23);

  /* CURSOR com os registros das pessoas que possuem escala com a faixa alterada, controlam faixa horaria e nao possuem outra escala mais nova sem esta faixa. */
  CURSOR c_r038hes IS SELECT HES.NUMEMP, HES.TIPCOL, HES.NUMCAD FROM R038HES HES, R034DAC DAC WHERE
                      DAC.NUMEMP = HES.NUMEMP AND DAC.TIPCOL = HES.TIPCOL AND DAC.NUMCAD = HES.NUMCAD AND
                      DAC.CONFAI > 0 AND
                      HES.CODESC IN (SELECT HOR.CODESC FROM R006HOR HOR WHERE HOR.CODHOR = P_CODHOR) AND
                      0 = (SELECT COUNT(H.CODESC) FROM R038HES H WHERE 
                           H.CODESC IN (SELECT HO.CODESC FROM R006HOR HO WHERE HO.CODHOR <> P_CODHOR) AND 
                           H.DATALT > HES.DATALT AND
                           H.NUMEMP = HES.NUMEMP AND
                           H.TIPCOL = HES.TIPCOL AND
                           H.NUMCAD = HES.NUMCAD);
  TYPE t_r038hes IS RECORD(
       NUMEMP   R038HES.NUMEMP%TYPE,
       TIPCOL   R038HES.TIPCOL%TYPE,
       NUMCAD   R038HES.NUMCAD%TYPE);
  l_r038hes t_r038hes;
BEGIN
  l_intesc := 'N';
  
  BEGIN
      SELECT INTESC INTO l_intesc FROM R000ASS;
  EXCEPTION WHEN OTHERS THEN
      l_intesc := 'N';
  END;

  IF (l_intesc = 'S') THEN
      FOREACH c_r038hes INTO l_r038hes.NUMEMP,
                             l_r038hes.TIPCOL,
                             l_r038hes.NUMCAD
      LOOP
          l_pend_aberta := 0;
          SP_RETIDTPES(l_r038hes.NUMEMP, l_r038hes.TIPCOL, l_r038hes.NUMCAD, 0, '', '', '', l_idtpes OUT);

          BEGIN
              SELECT COUNT(ID_PENDENCY) INTO l_pend_aberta FROM SAM_PENDENCIES WHERE ROTINE = 42 AND STATUS = 0 AND IDREGISTER = l_idtpes;
          EXCEPTION WHEN OTHERS THEN
              l_pend_aberta := 0;
          END;

          IF (l_pend_aberta = 0) THEN
              SP_SAM_PENDENCIES(42, 2, l_idtpes);
          END IF;
      END LOOP;
  END IF;
END␀Üø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0!SP_RETIDTPES
SP_SAM_PENDENCIES
␀␀/* -- Inclusao de pendencias de escala para o SAMSenior na alteracao das faixas da escala -- */
PROCEDURE SP_SAM_PEND_HOR(P_CODESC NUMBER(9))
 IS

  l_intesc      CHAR(1);
  l_pend_aberta NUMBER;
  l_idtpes      CHAR(23);
 
  /* CURSOR com os registros das pessoas que possuem a escala alterada, controlam faixa horaria e nao possuem outra escala mais nova. */
  CURSOR c_r038hes IS SELECT HES.NUMEMP, HES.TIPCOL, HES.NUMCAD FROM R038HES HES, R034DAC DAC WHERE 
                      DAC.NUMEMP = HES.NUMEMP AND DAC.TIPCOL = HES.TIPCOL AND DAC.NUMCAD = HES.NUMCAD AND
                      DAC.CONFAI > 0 AND
                      HES.CODESC = P_CODESC AND
                      HES.DATALT = (SELECT MAX(H.DATALT) FROM R038HES H WHERE H.NUMEMP = HES.NUMEMP AND H.TIPCOL = HES.TIPCOL AND H.NUMCAD = HES.NUMCAD);
  TYPE t_r038hes IS RECORD(
       NUMEMP   R038HES.NUMEMP%TYPE,
       TIPCOL   R038HES.TIPCOL%TYPE,
       NUMCAD   R038HES.NUMCAD%TYPE);
  l_r038hes t_r038hes;
BEGIN
  l_intesc := 'N';
  
  BEGIN
      SELECT INTESC INTO l_intesc FROM R000ASS;
  EXCEPTION WHEN OTHERS THEN
      l_intesc := 'N';
  END;

  IF (l_intesc = 'S') THEN
      FOREACH c_r038hes INTO l_r038hes.NUMEMP,
                             l_r038hes.TIPCOL,
                             l_r038hes.NUMCAD
      LOOP
          l_pend_aberta := 0;
          SP_RETIDTPES(l_r038hes.NUMEMP, l_r038hes.TIPCOL, l_r038hes.NUMCAD, 0, '', '', '', l_idtpes OUT);

          BEGIN
              SELECT COUNT(ID_PENDENCY) INTO l_pend_aberta FROM SAM_PENDENCIES WHERE ROTINE = 42 AND STATUS = 0 AND IDREGISTER = l_idtpes;
          EXCEPTION WHEN OTHERS THEN
              l_pend_aberta := 0;
          END;

          IF (l_pend_aberta = 0) THEN
              SP_SAM_PENDENCIES(42, 2, l_idtpes);
          END IF;
      END LOOP;
  END IF;
END␀İø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ÔPROCEDURE SP_SELTSI(P_TIPRET NUMBER,P_NAMERET VARCHAR2(40),P_CMDSEL VARCHAR2(1024),P_RETNUMBER OUT NUMBER,P_RETSTR OUT VARCHAR2(2048),P_RETERR OUT NUMBER(1))
 IS

l_strerr  VARCHAR2(3072);
BEGIN
  NULL;
END		ORACLE;20
ë␀␀create or replace PROCEDURE SP_SELTSI(p_tipret IN NUMBER,P_nameret IN VARCHAR2,p_cmdsel IN VARCHAR2,p_retnumber OUT NUMBER,p_retstr OUT VARCHAR2,p_reterr OUT NUMBER) IS
  l_strerr VARCHAR2(3072);
begin
  p_reterr := 0;
  begin
    if p_tipret=0 then
      EXECUTE IMMEDIATE p_cmdsel INTO p_retnumber;
    else
      EXECUTE IMMEDIATE p_cmdsel INTO p_retstr;
    end if;
  exception
    when NO_DATA_FOUND then
      p_reterr := 1;
    when TOO_MANY_ROWS then
      p_reterr := 2;
    when OTHERS then
      p_reterr := 3;
      l_strerr := 'Erro ao executar procedure SP_SELTSI para o campo de retorno '||p_nameret||'. Comando:'||p_cmdsel||'. '||SQLERRM;
      raise_application_error(-20000 + -(103),l_strerr);
  end;
end;

	MSSQL;23
‘	␀␀CREATE  PROCEDURE sp_seltsi(@p_tipret FLOAT, @P_nameret VARCHAR(40), @p_cmdsel VARCHAR(1024), @p_retnumber FLOAT OUTPUT, @p_retstr VARCHAR(2048) OUTPUT, @p_reterr SMALLINT OUTPUT) AS
BEGIN

DECLARE @l_strerr VARCHAR(3072)
DECLARE @ChkError INTEGER
DECLARE @SE_EXC1 INTEGER
DECLARE @l_comando   NVARCHAR(2048)
DECLARE @l_parameter   NVARCHAR(50)
DECLARE @l_comandosel   VARCHAR(2048)
DECLARE @rowcount INTEGER

  SELECT @rowcount = 0
  SELECT @ChkError = 0
  SELECT @p_reterr = 0  
  /* TRY */
    IF @p_tipret=0
    BEGIN
	  SELECT @l_comandosel = 'SELECT @p_retnumber='+SUBSTRING(LTRIM(@p_cmdsel), 7, LEN(LTRIM(@p_cmdsel))-6)
         SELECT @l_comando = CONVERT(NVARCHAR(2048), @l_comandosel);
	  SELECT @l_parameter = CONVERT(NVARCHAR(50), '@p_retnumber INTEGER OUTPUT');	
	  EXEC sp_executesql @l_comando, @l_parameter, @p_retnumber OUTPUT			
	  SELECT @rowcount = @@ROWCOUNT
	  /*NO DATA FOUND*/
	  IF @rowcount = 0
	  BEGIN
	    SELECT @p_reterr = 1
	  END
	  /*TOO MANY ROWS*/
	  IF @rowcount > 1
	  BEGIN
	    SELECT @p_reterr = 2
	  END			
    END
    ELSE
    BEGIN
	  SELECT @l_comandosel = 'SELECT @p_retstr='+SUBSTRING(LTRIM(@p_cmdsel), 7, LEN(LTRIM(@p_cmdsel))-6)
         SELECT @l_comando = CONVERT(NVARCHAR(2048), @l_comandosel);
	  SELECT @l_parameter = CONVERT(NVARCHAR(50), '@p_retstr VARCHAR(2048) OUTPUT');	
	  EXEC sp_executesql @l_comando, @l_parameter, @p_retstr OUTPUT	
	  SELECT @rowcount = @@ROWCOUNT
	  /*NO DATA FOUND*/
	  IF @rowcount = 0
	  BEGIN
	    SELECT @p_reterr = 1
	  END
	  /*TOO MANY ROWS*/
	  IF @rowcount > 1
	  BEGIN
	    SELECT @p_reterr = 2
	  END		
    END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC1:
    SELECT @SE_EXC1 = @ChkError
    IF @ChkError <> 0
    BEGIN
      IF @ChkError = -50
      BEGIN
        SELECT @ChkError = 0
        SELECT @p_reterr = 1
      END
      ELSE
      IF @ChkError = 512
      BEGIN
        SELECT @ChkError = 0
        SELECT @p_reterr = 2
      END
      ELSE
      BEGIN
        SELECT @ChkError = 0
        SELECT @p_reterr = 3
        SELECT @l_strerr = 'Erro ao executar procedure SP_SELTSI para o campo de retorno '+@p_nameret+'. Comando:'+@p_cmdsel+'. '
        BEGIN
          RAISERROR(@l_strerr,11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
FIM:
  RETURN @ChkError
END

␀Şø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
´PROCEDURE SP_SIMNAO_INT(P_VALOR IN OUT VARCHAR2(255))
 IS
