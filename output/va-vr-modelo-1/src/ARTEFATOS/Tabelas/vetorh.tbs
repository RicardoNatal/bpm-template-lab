å␀␀PROCEDURE SP_GERSTA_ESFINGE(P_LAYOUT NUMBER(2), P_PIDSTA VARCHAR2(30), P_DATREF DATE, P_DESRES VARCHAR2(250), P_NUMEMP NUMBER(4), P_TIPCOL NUMBER(1), P_NUMCAD NUMBER(9)) IS
BEGIN
	BEGIN
		INSERT INTO R304STA (PIDSTA, DATREF, STAENV, TIPOPE, LAYOUT, DESRES, NUMEMP, TIPCOL, NUMCAD)
		VALUES (P_PIDSTA, P_DATREF, 'P', 'I', P_LAYOUT, P_DESRES, P_NUMEMP, P_TIPCOL, P_NUMCAD);
	EXCEPTION WHEN OTHERS THEN
    	RAISERROR 103 'Erro ao inserir registro de status na tabela R304STA.';
	END;
END␀Dø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
