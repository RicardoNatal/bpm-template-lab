				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAUTDBL', l_r034DAC.AUTDBL);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (NEWAUTDBL)';
						END;
				END IF;
				
		
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVERAFA', l_r034DAC.VERAFA);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (OLDVERAFA)';
