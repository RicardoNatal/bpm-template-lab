DECLARE
l_online BOOLEAN;
BEGIN
  /*AO ATUALIZAR AS DEFINIÇÕES DA CONCENTRADORA EM MODO STAND ALONE,
    GERA PENDÊNCIA PARA CSM Center atualizar a Concentradora com as novas definições*/
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) THEN
      /* GERA PENDÊNCIA updateCSMProperties para todas as centralizadoras - Pendência 56 */
      SP_PEND56(0);
  END IF;
END␀ßÙ␀␀	SENIOR;0¯␀␀

