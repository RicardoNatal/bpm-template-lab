/* Procedure que gera os creditos de acesso de acordo com a definição.*/
PROCEDURE SP_GerCrc(P_TIPOPE CHAR(1),P_TIPHIS NUMBER(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DATALT DATE,P_EMPATU NUMBER(5),P_CADATU NUMBER(9),P_CODFIL NUMBER(6),P_CODESC NUMBER(9),P_STAHIS NUMBER(1))
 IS

  l_gercrc       CHAR(1);
  l_uticcr       CHAR(1);
  l_codesc         R006ESC.CodEsc%TYPE;
  l_count        NUMBER(5);
  l_fimTes       DATE;
  l_dathes       DATE;  
  l_datalt       DATE;
  l_datult       DATE;
  l_datant       DATE;
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_datcon       DATE;
  l_qtdcon       NUMBER(3);
  l_hora_atual   NUMBER(4);
  l_verplf       NUMBER(3);
  l_alterar      BOOLEAN;
  l_concre       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp_str   CHAR(4);
  l_tipcol_str   CHAR(1);
  l_numcad_str   CHAR(9);
  l_alt_cred     BOOLEAN;
  l_cracha       NUMBER(12);
  l_staacc       NUMBER(1);

  /* CURSOR que busca os créditos de acesso para o visitante com escala. */
  CURSOR c_R070DCA IS
         SELECT INIFAI,FIMFAI,CREDIA,LIMCON,VERPLF,CODPLF FROM R070DCA
         WHERE NUMEMP = p_numemp AND CODFIL = p_codfil AND CODESC = l_codesc AND TIPPES = p_tipcol;
  TYPE t_R070DCA IS RECORD(
    INIFAI   R070DCA.INIFAI%TYPE,
    FIMFAI   R070DCA.FIMFAI%TYPE,
    CREDIA   R070DCA.CREDIA%TYPE,
    LIMCON   R070DCA.LIMCON%TYPE,
    VERPLF   R070DCA.VERPLF%TYPE,
    CODPLF   R070DCA.CODPLF%TYPE);
  l_r070DCA t_R070DCA;

  /*CURSOR PARA BUSCAR OS LOCAIS FÍSICOS QUE A PESSOA POSSÚI CRÉDITOS ATIVOS, ONDE O LOCAL SEJA MAIOR QUE ZERO*/
  CURSOR c_CREDCOL IS
         SELECT DISTINCT VERPLF
                        ,CODPLF
           FROM R070CRC
          WHERE R070CRC.NUMEMP = p_numemp
            AND R070CRC.TIPCOL = p_tipcol
            AND R070CRC.NUMCAD = p_numcad
            AND R070CRC.CODPLF > 0
            AND R070CRC.DATINI <= l_data_atual
            AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR
                 (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual));
  TYPE t_CREDCOL IS RECORD(
    VERPLF   R070CRC.INIFAI%TYPE,
    CODPLF   R070CRC.FIMFAI%TYPE);
  l_CREDCOL t_CREDCOL;

BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_alt_cred   := FALSE;
  l_datcon     := l_data_zero;
  l_qtdcon     := 0;
  l_cracha     := 0;

  /*Busca versão do plano ativa*/
  BEGIN
      SELECT VERPLF INTO l_verplf
        FROM R058VPL
       WHERE DATCRI <= l_data_atual
         AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
  EXCEPTION
      WHEN OTHERS THEN
          l_verplf := 1;
  END;

  /*Monta o idtpes da pessoa*/
  SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
  SP_INTSTR(p_numemp,'9999',l_numemp_str OUT);
  SP_INTSTR(p_tipcol,'9',l_tipcol_str OUT);
  SP_INTSTR(p_numcad,'999999999',l_numcad_str OUT);
  l_idtpes:= l_tippes_str||l_numemp_str||l_tipcol_str||l_numcad_str;
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
      /*Controle do Loop.*/
      IF (Length(l_idtpes) > 22) THEN
          EXIT;
      END IF;
      l_idtpes := ' '||l_idtpes;
  END LOOP;

  /* Busca parametro que indica se eh para gerar créditos de acesso automaticamente. */
  BEGIN
     SELECT GERCRC, UTICCR INTO l_gercrc, l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_gercrc := 'N';
      l_uticcr := 'N';
  END;

  /* Busca parametro que indica */
  BEGIN
     SELECT CONCRE INTO l_concre FROM R034DAC WHERE
            NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
  EXCEPTION
    WHEN OTHERS THEN
      l_concre := 0;
  END;

  /*Se utilizar a rotina de compra de créditos, não deve prosseguir com a geração automática de créditos*/
  IF (l_uticcr = 'N') OR (l_uticcr IS NULL) OR
     ((l_uticcr = 'S') AND (l_concre = 0 OR l_concre = 3)) THEN

      /* se estiver inserindo um histórico de filial e deixar a escala zerado */
      /* significa que ele deve usar a última escala do colaborador.          */
      l_codesc := 0;
      IF  (p_tiphis = 1) AND (p_codesc = 0) THEN
          BEGIN
             SELECT CODESC INTO l_codesc FROM R038HES WHERE
                    NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                    DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND
                    TIPCOL = p_tipcol AND NUMCAD = p_numcad);
          EXCEPTION
              WHEN OTHERS THEN l_codesc := 0;
          END;
      ELSE
          l_codesc := p_codesc;
      END IF;

      /* Verifica se existe faixas para a definição informada de filial e escala */
      l_count := 0;
      BEGIN
         SELECT COUNT(*) INTO l_count FROM R070DCA WHERE
                NUMEMP = p_numemp AND CODFIL = p_codfil AND CODESC = l_codesc AND TIPPES = p_tipcol;
      EXCEPTION
          WHEN OTHERS THEN l_count := 0;
      END;
      /* se não encontrar nada de acordo com a definição, então buscar o registro com a escala zero.*/
      IF  (l_count = 0) THEN
          l_codesc := 0;
      END IF;

      /* Se estiver alterando o histórico de escala e não existir faixa com a escala informada */
      /* é preciso verificar se já existem créditos em aberto. Se existirem não deve fazer nada. */
      IF  (p_tiphis = 2) AND (l_codesc = 0) THEN
          BEGIN
             SELECT COUNT(*) INTO l_count FROM R070CRC 
                 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad 
                     AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR 
                         (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual)
                     );
          EXCEPTION
              WHEN OTHERS THEN l_alterar := FALSE;
          END;
          IF (l_count > 0) THEN
              l_alterar := FALSE;
          ELSE
              l_alterar := TRUE;
          END IF;
      ELSE
          l_alterar := TRUE;
      END IF;

      /* somente gravar créditos se o historico for somente de troca de filial. */
      IF  (l_gercrc = 'S') AND (p_stahis = 1) AND (p_empatu = p_numemp) AND
          (p_cadatu = p_numcad) AND (l_alterar = TRUE) THEN
          l_datult:='31/12/1900,00:00:00';
          /* busca as informações do histórico de filial. (p_tiphis = 1) */
          IF  (p_tiphis = 1) THEN
              /* Pega o historico anterior cuja empresa destino for igual a atual */
              BEGIN
                  SELECT MAX(DATALT) INTO l_datalt FROM R038HFI WHERE
                         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND EMPATU = NUMEMP AND
                         CADATU = NUMCAD AND DATALT < p_datalt AND STAHIS = 1;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datalt:='31/12/1900,00:00:00';
              END;

              /* Pega o ultimo historico do colaborador */
              BEGIN
                  SELECT MAX(DATALT) INTO l_datult FROM R038HFI WHERE
                         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND EMPATU = NUMEMP AND
                         CADATU = NUMCAD AND DATALT <> p_datalt AND STAHIS = 1;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datult:='31/12/1900,00:00:00';
              END;

          ELSE
              /* busca as informações do histórico de escala. (p_tiphis = 2) */
              BEGIN
                  SELECT DATALT INTO l_datalt FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT < p_datalt AND STAHIS = 1 AND
                         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT < p_datalt AND STAHIS = 1);
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datalt:='31/12/1900,00:00:00';
                  WHEN OTHERS THEN l_datalt:='31/12/1900,00:00:00';
              END;
              BEGIN
                  SELECT DATALT INTO l_datult FROM R038HES WHERE NUMEMP = p_numemp AND
                         TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATALT <> p_datalt AND STAHIS = 1 AND
                         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND
                                  NUMCAD = p_numcad AND DATALT <> p_datalt AND STAHIS = 1 );
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_datult:='31/12/1900,00:00:00';
                  WHEN OTHERS THEN l_datult:='31/12/1900,00:00:00';
              END;
          END IF;

          IF  (p_tipope = 'I') OR (p_tipope = 'U') THEN

              /* fecha todos os históricos em aberto para este colaborador */
              l_datant := DATETimeAdd(DD,-1,p_datalt);
              UPDATE R070CRC SET DATFIM = l_datant, STAACC = 2 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                     DATINI < p_datalt AND 
                     ((DATFIM >= p_datalt) OR (DATFIM = l_data_zero));
              l_alt_cred := TRUE;

              /* Se tiver incluindo o ultimo historico */
              IF  (p_datalt > l_datult) OR (l_datult = l_data_zero) OR (l_datult IS NULL) THEN
                  /* busca os créditos de acesso para o colaborador com a escala. */
                  FOREACH c_r070dca INTO  l_r070dca.IniFai,
                                          l_r070dca.FimFai,
                                          l_r070dca.CreDia,
                                          l_r070dca.LimCon,
                                          l_r070dca.VerPlf,
                                          l_r070dca.CodPlf
                  LOOP
                      l_count:=0;
                      BEGIN
                          /* verifica se já existe o registro. */
                          SELECT COUNT(*) INTO l_count
                            FROM R070CRC
                           WHERE NUMEMP = p_numemp
                             AND TIPCOL = p_tipcol
                             AND NUMCAD = p_numcad
                             AND DATINI = p_datalt
                             AND INIFAI = l_r070dca.IniFai
                             AND VERPLF = l_r070dca.VerPlf
                             AND CODPLF = l_r070dca.CodPlf;
                      EXCEPTION
                          WHEN NO_DATA_FOUND THEN l_count:=0;
                      END;

                      IF  l_count = 0 THEN
                          /* inclui os creditos de acesso do colaborador. */
                          INSERT INTO R070CRC (NUMEMP,TIPCOL,NUMCAD,DATINI,DATFIM,INIFAI,FIMFAI,
                                               CREDIA,SALATU,STAACC,LIMCON,DATCON,QTDCON,VERPLF,CODPLF)
                                 VALUES (p_numemp,p_tipcol,p_numcad,p_datalt,l_data_zero,
                                         l_r070dca.IniFai,l_r070dca.FimFai,l_r070dca.CreDia,
                                         l_r070dca.CreDia,1,l_r070dca.LimCon,l_datcon,l_qtdcon,l_r070dca.VerPlf,l_r070dca.CodPlf);
                          l_alt_cred := TRUE;
                      ELSE
		                  UPDATE R070CRC SET DATFIM = l_data_zero WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt AND INIFAI = l_r070dca.IniFai AND 
		                  VERPLF = l_r070dca.VerPlf AND CODPLF = l_r070dca.CodPlf;
		                  l_alt_cred := TRUE;
                      END IF;
                  END LOOP;
              END IF;
          ELSIF p_tipope = 'D' THEN
              /* exclui historico de créditos de acesso. */
              DELETE FROM R070CRC WHERE NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND DATINI=p_datalt;
              /* abre o historico anterior.  */
              UPDATE R070CRC SET DATFIM = l_data_zero, STAACC = 1, DATCON = l_datcon, QTDCON = l_qtdcon
               WHERE NUMEMP = p_numemp
                 AND TIPCOL = p_tipcol
                 AND NUMCAD = p_numcad
                 AND DATINI = l_datult;
              l_alt_cred := TRUE;
          END IF;
      ELSE
          /* fecha todos os históricos em aberto para este colaborador */
          IF  (p_tipope = 'I') AND (NOT ((p_tiphis=2) AND (l_codesc=0))) THEN
              l_datant := DATETimeAdd(DD,-1,p_datalt);
              UPDATE R070CRC SET DATFIM = l_datant, STAACC = 2 WHERE
                     NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                     DATINI < p_datalt AND
                     ((DATFIM >= p_datalt) OR (DATFIM = l_data_zero));
              l_alt_cred := TRUE;
          END IF;
      END IF;
      
      /* Para retorno da troca de escala */
      IF  (p_tipOpe = 'U') AND (p_tiphis = 2) AND (l_codesc = 0) THEN
          l_count := 0;
          BEGIN
              SELECT 1, DATFIM INTO l_count, l_fimTES FROM R064TES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt;
          EXCEPTION
              WHEN NO_DATA_FOUND THEN l_count:=0;
          END;
          
          IF (l_count > 0) THEN
              IF (l_fimtes < l_data_atual) THEN
                  l_staacc := 2;
              ELSE
                  l_staacc := 1;              
              END IF;
              BEGIN
                  UPDATE R070CRC SET DATFIM = l_fimtes, STAACC = l_staacc WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI = p_datalt;
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN NULL;
              END;                  
          END IF; 
          
          /* Busca a escala original para atualizar */
          l_codesc := 0;
          BEGIN
              SELECT DATALT, CODESC INTO l_dathes, l_codesc FROM R038HES WHERE
			         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND STAHIS = 1 AND
			         DATALT = (SELECT MAX(DATALT) FROM R038HES WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND STAHIS = 1);
          EXCEPTION
              WHEN OTHERS THEN l_codesc := 0;
		  END;
          
		  /* Procedure que atualiza os creditos de acesso.*/
          IF (l_codesc > 0) THEN
              SP_GerCrc('I', 2, p_NUMEMP, p_TIPCOL, p_NUMCAD, l_dathes, p_NUMEMP, p_NUMCAD, p_codfil, l_CODESC, 1);
		  END IF;          
            
      END IF;

      /* SE HOUVE ALTERAÇÕES NOS CRÉDITOS DE ACESSO DA PESSOA */
      IF ( l_alt_cred = TRUE ) THEN

        /*Remove os créditos globais e créditos por local físico da pessoa na Concentradora, somente se houver crachá*/
        SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
        IF   (l_cracha = 0)  THEN
            SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
        END IF;

        IF (l_cracha <> 0) THEN
          SP_PEND06(4,l_idtpes,0,0);
        END IF;

        /*Chama a SP_CRECON passando o local físico 0(zero), afim de atualizar os registros da r070con*/
        SP_CRECON(p_tipcol, p_numemp, p_tipcol, p_numcad,0,'0','0','0', l_verplf, 0);

        /*INSERE OS CRÉDITOS ATIVOS*/
        FOREACH c_CREDCOL INTO  l_CREDCOL.VerPlf,
                                l_CREDCOL.CodPlf
        LOOP
          /*Atualiza os créditos*/
          SP_CRECON(p_tipcol, p_numemp, p_tipcol, p_numcad,0,'0','0','0', l_CREDCOL.VerPlf, l_CREDCOL.CodPlf);
        END LOOP;
      END IF;

  END IF;
END		SENIOR;21,SP_INTSTR
SP_RETCRA
SP_PEND06
SP_CRECON
