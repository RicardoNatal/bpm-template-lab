0;1âÑ␀␀		SENIOR;0¥␀␀TRIGGER R030ASS_EI AFTER INSERT ON R030ASS FOR EACH ROW
DECLARE
	l_Valor	VARCHAR(1000);		
	xNumEmp   R030ASS.NUMEMP%TYPE;
	l_ValorVARCHAR 	VARCHAR2(20);
BEGIN	
	xNumEmp := :NEW.NUMEMP;
	SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_ValorVARCHAR OUT);
	l_Valor := 'Incluído o Assinalamento na data de referência ' || l_ValorVARCHAR || ' para a Empresa ' || CONVERT(NUMBER_TO_CHAR, xNumEmp) || '.';
	SP_GRAVALPR(212, l_Valor);
END␀ãÑ␀␀		SENIOR;0 ␀␀

TRIGGER R030ASS_EU AFTER UPDATE ON R030ASS FOR EACH ROW
DECLARE
	l_Valor			VARCHAR(1000);
    l_ValorAux	    VARCHAR(1000);	
	l_ValorVARCHAR 	VARCHAR2(20);
BEGIN
	/* Os campos que não serão monitorados */	
	/* OpcInt - Per. Férias Troca Categ. Intermitente */

	IF  (:NEW.OPCINT <> :OLD.OPCINT) THEN
  		SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_ValorVARCHAR OUT);
 		
		l_ValorAux := 'Foram alteradas as definições do Assinalamento na data de referência ' || l_ValorVARCHAR || ' da Empresa ' || CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP) || '.';
		
		l_Valor := l_ValorAux || ' - Campo: Período Férias na Troca Categoria Intermitente. Valor Anterior: ' || CONVERT(NUMBER_TO_CHAR, :OLD.OPCINT) || ', Valor Novo: ' || CONVERT(NUMBER_TO_CHAR, :NEW.OPCINT) || '.';
		SP_GRAVALPR(212, l_Valor);				
	END IF;
END␀áÑ␀␀		SENIOR;0£␀␀

TRIGGER R030ASS_ED AFTER DELETE ON R030ASS FOR EACH ROW
DECLARE
	l_Valor	VARCHAR(1000);	
	xNumEmp   R030ASS.NUMEMP%TYPE;
	l_ValorVARCHAR 	VARCHAR2(20);
BEGIN
	xNumEmp := :OLD.NUMEMP;
	SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_ValorVARCHAR OUT);
  	l_Valor := 'Excluído o Assinalamento na data de referência ' || l_ValorVARCHAR || ' da Empresa ' || CONVERT(NUMBER_TO_CHAR, xNumEmp) || '.';
	SP_GRAVALPR(212, l_Valor);
END␀␀␀bb␀␀␀␀␀␀␀äÑ␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀XbXbXbr␀Æÿ␀␀Ò␀␀␀ı␀4	Ôÿ?␀␀␀␀␀$␀␀$␀q␀Æÿ␀␀ÿ0×-Ì␀	Ôÿ?␀␀␀␀␀‘A‘A‘A”)␀␀Æÿ␀␀ÿ␀şD¡␀	Ôÿ?␀␀␀␀␀­M•M–Mp␀Æÿ␀␀ÿ␀pû␀␀EÔÿ?␀␀␀␀␀°û␀␀™û␀␀°û␀␀G␀␀ÿ␀␀ÿ␀␀␀␀0;1␀␀D␀␀␀␀␀␀åÑ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀÷,´␀	␀␀␀␀␀␀␀Ş@zœ␀␀zœ␀␀r␀Æÿ␀␀qÒ␀␀␀EÑ␀	␀␀␀␀␀␀␀ÙIÙE¢NqC␀êÿ␀␀•Ò␀␀␀Öw·␀	␀␀␀␀␀␀␀‹yıwıwì*␀␀Æÿ␀␀–Ò␀␀␀\¬␀␀´␀	␀␀␀␀␀␀␀í¯␀␀­␀␀­␀␀r␀Æÿ␀␀ÿ␀¶␀o␀␀␀␀␀␀␀Š␀u␀u␀i␀␀ÿ␀␀ÿ␀T*␀␀␀␀␀␀␀{W°V°V-␀␀ÿ␀␀ÿ␀EÑ␀	␀␀␀␀␀␀␀EL“”␀␀¶GqC␀êÿ␀␀ÿ␀µEÑ␀	␀␀␀␀␀␀␀´LJ␀ÑHqC␀␀êÿ␀␀ÿ␀ÆDÑ␀	␀␀␀␀␀␀␀ÈJFÈJqC␀␀êÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀Š/␀␀␀␀␀␀␀␀␀␀␀æÑ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀÷,´␀	␀␀␀␀␀␀␀Ş@zœ␀␀zœ␀␀r␀Æÿ␀␀qÒ␀␀␀.␀t	␀␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀.%0.0.w␀Æÿ␀␀…Ó␀␀␀EÑ␀␀␀␀␀␀␀␀␀␀™G™GqC␀êÿ␀␀ÿ␀Ê␀␀´␀␀␀␀␀␀␀␀␀␀¢É␀␀Ì␀␀)␀␀␀Æÿ␀␀ÿ␀´&=␀␀␀␀␀␀␀A␀␀í`í`c␀␀␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3èÑ␀␀		SENIOR;0"␀␀TRIGGER R030CAN_EI AFTER INSERT ON R030CAN FOR EACH ROW
