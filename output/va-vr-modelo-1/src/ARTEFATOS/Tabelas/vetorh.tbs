PROCEDURE R034FUN_ATUCON(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_NUMCPF NUMBER(11),P_NUMPSP VARCHAR2(40),P_REPONL VARCHAR2(1))
 IS

  l_cracha       NUMBER(12);
  l_cracha_pro   NUMBER(12);
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_tipdoccol    NUMBER(1);
  l_numdoccol    VARCHAR2(20);
  l_idtpes       VARCHAR2(23);
  l_nompes       VARCHAR2(40);
  l_ddifon       NUMBER(3);
  l_dddfon       NUMBER(3);
  l_numfon       VARCHAR2(20);
BEGIN
    /*Busca o crachá principal do colaborador. Caso não encontrar, busca pelo provisório*/
    SP_RETCRA_IDTPES(1, p_numemp, p_tipcol, p_numcad, 0, '', 0, '', l_cracha OUT);
    IF (l_cracha = 0) THEN
        SP_RETCRA_IDTPES(2, p_numemp, p_tipcol, p_numcad, 0, '', 0, '', l_cracha OUT);
    END IF;

    /* Verifica se Colaborador possui Cracha */
    IF (l_cracha <> 0) THEN
        /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
        IF ((p_nomfun IS NULL) OR (LENGTH(LTRIM(RTRIM(p_nomfun))) = 0)) THEN
            l_nomfun := '';
        ELSE
            l_nomfun := LTRIM(p_nomfun);
            l_nomfun := RTRIM(l_nomfun);
        END IF;

        IF (p_numpis IS NULL) THEN
            l_numpis := 0;
        ELSE
            l_numpis := p_numpis;
        END IF;

        /*Inicializa o tipo e o documento*/
        l_tipdoccol := 0;
        l_numdoccol := '0';

        /*Busca e atualiza o CPF ou Passaporte do colaborador*/
        IF (p_numcpf <> 0) THEN
            l_tipdoccol := 2;
            l_numdoccol := CONVERT(NUMBER_TO_CHAR, p_numcpf);
        ELSE
            IF (p_numpsp <> ' ') AND (p_numpsp <> '0') THEN
                l_tipdoccol := 4;
                l_numdoccol := p_numpsp;
            END IF;
        END IF;

        SP_RETIDTPES(p_numemp, p_tipcol, p_numcad, 0, '', '', '', l_idtpes OUT);

        BEGIN
            SELECT DDITEL, DDDTEL, NUMTEL INTO l_ddifon, l_dddfon, l_numfon FROM R034CPL
            WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN 
                l_ddifon := 0;
                l_dddfon := 0;
                l_numfon := '';
            WHEN OTHERS THEN RAISERROR 103 'R034FUN_ATUCON: Erro SELECT na R034CPL.';
        END;

        LOOP
            /* atualiza r070con */
            BEGIN
                IF (p_reponl = 'S') AND  /* REP ON-LINE = 'S', COLABORADOR 1 OU 2 E NOMES OU PIS DIFERENTES */
                   ((p_tipcol = 1) OR (p_tipcol = 2)) THEN
                   UPDATE R070CON SET
                           NOMFUN = l_nomfun,
                           NUMPIS = l_numpis,
                           NOMPES = l_nomfun,
                           DDIFON = l_ddifon,
                           DDDFON = l_dddfon,
                           NUMFON = l_numfon,
                           TIPDOC = l_tipdoccol,
                           NUMDOC = l_numdoccol
                    WHERE NUMCRA = l_cracha;
                ELSE
                   UPDATE R070CON SET
                           NOMPES = l_nomfun,
                           DDIFON = l_ddifon,
                           DDDFON = l_dddfon,
                           NUMFON = l_numfon,
                           TIPDOC = l_tipdoccol,
                           NUMDOC = l_numdoccol
                    WHERE NUMCRA = l_cracha;
                END IF;
            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'R034FUN_ATUCON: Erro UPDATE R070CON.';
            END;

            /*Controle do Looping, onde deve ser efetuado o update no crachá provisório caso o mesmo exista.*/
            SP_RETCRA_IDTPES(2,p_numemp, p_tipcol, p_numcad, 0, '', 0, '', l_cracha_pro OUT);
            IF (l_cracha_pro = l_cracha) OR (l_cracha_pro = 0) THEN
                EXIT;
            ELSE
               l_cracha := l_cracha_pro;
            END IF;
        END LOOP;
    END IF;
