e␀␀PROCEDURE R057RLG_ATUTER(P_TIPOPE CHAR,P_CODBNF INTEGER,P_CODPLT INTEGER,P_CODRLG INTEGER)
 IS

  l_existe_registro BOOLEAN;
  l_codbnf       VARCHAR2(2);
  l_numeip       VARCHAR2(15);
  l_lbenef       VARCHAR2(8);
  l_strerr       VARCHAR2(250);
  l_exists       NUMBER;
  l_codcen       INTEGER;
  l_censtr       VARCHAR2(2);
  l_rlgalf       VARCHAR2(2);
  /*TELEMÁTICA*/
  l_usutel       VARCHAR2(31);
  l_comando      VARCHAR2(1024);
  l_retnumber    NUMBER(1);
  l_retstr       VARCHAR(1);
  l_reterr       NUMBER(1);
BEGIN
  l_existe_registro := FALSE;
  /* TSI */
  SP_USUTEL(l_usutel);    

  SP_INTSTR(p_codbnf,'99',l_codbnf OUT);
  l_lbenef := 'LBENEF'||l_codbnf;

  BEGIN
      SELECT CODCEN,RLGALF,NUMEIP INTO l_codcen,l_rlgalf,l_numeip
      FROM R058RLG WHERE CODPLT = p_codplt AND CODRLG = p_codrlg;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'Erro no SELECT em R058RLG. Planta = '||p_codplt||' Coletor = '||p_codrlg;
  END;

  /* verifica o tipo de comunicação do coletor */
  IF  (l_numeip <> '000.000.000.000') THEN
      l_censtr := '00';
      l_rlgalf := '00';
  ELSE
      SP_INTSTR(l_codcen,'99',l_censtr OUT);
  END IF;

  IF  (p_tipope = 'E') THEN
      BEGIN
          l_comando := 'DELETE FROM '||l_usutel||'TERMBENEF WHERE END_IP = '''|| l_numeip ||''' AND BLUEB = '''|| l_censtr ||''' '||' AND TERM = '''|| l_rlgalf ||''' ';
          SP_CMDTSI(l_comando);          
      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;
  ELSE
      l_existe_registro := FALSE;

      l_comando := 'SELECT 1 FROM '||l_usutel||'TERMBENEF WHERE END_IP ='''|| l_numeip ||''' AND BLUEB ='''|| l_censtr ||''' ' ||' AND TERM ='''|| l_rlgalf ||''' ';
      SP_SELTSI(0, '1', l_comando, l_exists OUT, l_retstr OUT, l_reterr OUT);
      
      
      IF (l_reterr > 1) THEN
          RAISERROR 103 'Erro no retorno do comando SELECT em TERMBENEF. Retorno = '||l_reterr;
      ELSE
	  IF (l_reterr = 0) THEN
        	  l_existe_registro := TRUE;
      	  END IF;
      	  IF (l_reterr = 1) THEN      
              l_existe_registro := FALSE;      
          END IF;
      
          /* Se não deu erro no seelct da TERMBENEF  */
          IF  (l_existe_registro = TRUE) THEN
              l_comando := 'UPDATE '||l_usutel||'TERMBENEF SET LBENEF = '''|| l_Lbenef || ''', IND_LIS = '''|| l_codbnf || ''' ' ||
                           'WHERE END_IP ='''|| l_numeip ||''' AND BLUEB ='''|| l_censtr ||''' ' ||' AND TERM ='''|| l_rlgalf ||''' '; 
              SP_CMDTSI(l_comando);
          ELSE
              l_comando := 'INSERT INTO TERMBENEF (END_IP,BLUEB,TERM,LBENEF,IND_LIS) ' ||
                           'VALUES ('''||l_numeip || ''', ''' || l_censtr || ''', ''' || l_rlgalf || ''' , ''' || l_lbenef || ''', ''' || l_codbnf || ''')';
              SP_CMDTSI(l_comando);
          END IF;
      END IF;
  END IF;
END␀æ×␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
