TRIGGER R030FIL_EBU BEFORE UPDATE ON R030FIL FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
  l_Valido BOOLEAN;
  l_AlterouRegistro_S1000 BOOLEAN;
  l_AlterouRegistro_S1005 BOOLEAN;
  l_DataEncerramento DATE;  
  l_ExisteEmpregadorEsocial NUMBER;
  l_online BOOLEAN;
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);

  l_numemp_str   VARCHAR2(4);
  l_codfil_str   VARCHAR2(6);
  l_valstr       VARCHAR2(51);
  l_InfoFacult   BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;  
BEGIN
  /*e-Social -> S-1000, S-1005 e S-1020*/
  l_Valor := '';
  l_Valido := FALSE;
  l_AlterouRegistro_S1000 := FALSE;
  l_AlterouRegistro_S1005 := FALSE;
  l_DataEncerramento := '31/12/1900,00:00:00';
  l_InfoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;
  
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  
  IF (l_InfoFacult = TRUE AND l_SimplificaoESocial = FALSE) THEN
  	SP_VALUPDATE_DES(:OLD.RAZSOC, :NEW.RAZSOC, l_Valido OUT);
  	IF (l_Valido = TRUE) THEN
  		l_AlterouRegistro_S1000 := TRUE;
  	END IF;

  	SP_VALUPDATE_DES(:OLD.NOMCOM, :NEW.NOMCOM, l_Valido OUT);
  	IF (l_Valido = TRUE) THEN
  		l_AlterouRegistro_S1000 := TRUE;
  	END IF;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.TIPINS, :NEW.TIPINS, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1000 := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.NUMCGC, :NEW.NUMCGC, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1000 := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.TIPCAE, :NEW.TIPCAE, l_Valido OUT);
  IF (l_Valido=TRUE) THEN
    l_AlterouRegistro_S1005 := TRUE;
  END IF;
    
  SP_CONCATENAR_NUM('CODFIL', :NEW.CODFIL, l_Valor OUT);
	 
  IF (l_AlterouRegistro_S1000 = TRUE) THEN      
    SP_E_SOCIAL('S-1000', 'R030FIL', 'T', 'A', NULL, NULL, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, l_DataEncerramento, NULL, 0, 'R030FIL_EBU');
  END IF;
	
  IF (l_AlterouRegistro_S1005 = TRUE) THEN
    SP_E_SOCIAL('S-1005', 'R030FIL', 'T', 'A', NULL, NULL, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030FIL_EBU');
  END IF;


  /*e-Social -> S-1000, S-1005 e S-1020*/
  
  IF ((:NEW.NUMEMP <> :OLD.NUMEMP) OR
     (:NEW.CODFIL <> :OLD.CODFIL) OR
     (:NEW.TIPINS <> :OLD.TIPINS) OR
     (:NEW.NUMCGC <> :OLD.NUMCGC) OR
     (:NEW.INSCEI <> :OLD.INSCEI) OR
     (:NEW.RAZSOC <> :OLD.RAZSOC)) THEN

    SP_VerOnLine(l_online OUT);
	
    IF (l_online = TRUE) THEN
      R030FIL_ATUCON(2, :NEW.NUMEMP, :NEW.CODFIL, :NEW.TIPINS, :NEW.NUMCGC, :NEW.INSCEI, :NEW.RAZSOC, :OLD.TIPINS, :OLD.NUMCGC, NULL);
    END IF;
  END IF;
  
  
  /* Geração de logs Filial - Cadastro*/
  l_codSistema := 1;  /* Código do sistema vetorh.*/
  l_codcpa := 30;     /* R030FIL - CADASTRO FILIAIS */
  l_codtpa := 171;    /* Incluir/Excluir  */
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);  
  
  IF  ((:OLD.NumEmp <> :NEW.NumEmp)
	OR (:OLD.CodFil <> :NEW.CodFil)
	OR (:OLD.RazSoc <> :NEW.RazSoc)
	OR (:OLD.NomFil <> :NEW.NomFil)
	OR (:OLD.AtvFil <> :NEW.AtvFil)
	OR (:OLD.CplFil <> :NEW.CplFil)
	OR (:OLD.TipLgr <> :NEW.TipLgr)
	OR (:OLD.EndFil <> :NEW.EndFil)
	OR (:OLD.EndNum <> :NEW.EndNum)
	OR (:OLD.CodPai <> :NEW.CodPai)
	OR (:OLD.CodEst <> :NEW.CodEst)
	OR (:OLD.CodCid <> :NEW.CodCid)
	OR (:OLD.CodBai <> :NEW.CodBai)
	OR (:OLD.CodCep <> :NEW.CodCep)
	OR (:OLD.TipFil <> :NEW.TipFil)
	OR (:OLD.RecFgt <> :NEW.RecFgt)
	OR (:OLD.CenFgt <> :NEW.CenFgt)
	OR (:OLD.CatFgt <> :NEW.CatFgt)
	OR (:OLD.CdrFgt <> :NEW.CdrFgt)
	OR (:OLD.NatEst <> :NEW.NatEst)
	OR (:OLD.TipIns <> :NEW.TipIns)
	OR (:OLD.NumCgc <> :NEW.NumCgc)
	OR (:OLD.InsCei <> :NEW.InsCei)
	OR (:OLD.EmpFgt <> :NEW.EmpFgt)
	OR (:OLD.InsEst <> :NEW.InsEst)
	OR (:OLD.AtiIrf <> :NEW.AtiIrf)
	OR (:OLD.AtiRai <> :NEW.AtiRai)
	OR (:OLD.BanFgt <> :NEW.BanFgt)
	OR (:OLD.AgeFgt <> :NEW.AgeFgt)
	OR (:OLD.CodBan <> :NEW.CodBan)
