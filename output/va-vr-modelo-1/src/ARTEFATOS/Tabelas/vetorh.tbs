ğ␀␀Òï␀␀Ôï␀␀ ␀␀ÿ␀␀ÿ␀›§␀␀v␀␀␀␀␀␀³©␀␀³©␀␀³©␀␀n␀␀ÿ␀␀ÿ␀Ì␀␀'␀␀␀␀␀␀Ø␀␀Ø␀␀Ø␀␀‚␀␀␀ÿ␀␀ÿ␀ïµ␀␀Â␀␀␀␀␀␀¡+␀¡+␀¡+␀n␀Æÿ␀␀ÿ␀ß␀à␀␀␀␀␀␀ªB|␀|␀n␀Æÿ␀␀ÿ␀‰qC€␀␀␀␀␀␀ŒqŒqŒqp␀Æÿ␀␀ÿ␀␀␀÷Û␀␀␀ûÛ␀␀␀␀␀0;1;2;3;4;5;6ùÛ␀␀		SENIOR;0ü␀␀TRIGGER R086CAT_AI AFTER INSERT ON R086CAT FOR EACH ROW DECLARE
  l_Valor VARCHAR2(2000);
BEGIN
  l_Valor := '';
  SP_CONCATENAR_DAT('DATACT', :NEW.DATACT, l_Valor OUT);
  SP_CONCATENAR_NUM('HORACT', :NEW.HORACT, l_Valor OUT);
  SP_CONCATENAR_DAT('DATCAT', :NEW.DATCAT, l_Valor OUT);
  SP_CONCATENAR_DES('TIPCAT', :NEW.TIPCAT, l_Valor OUT);

	SP_E_SOCIAL_SM('S-2210', 'R086CAT', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0,
	NULL, :NEW.DATACT, 0, 'R086CAT_AI');
END␀úÛ␀␀		SENIOR;0\␀␀

TRIGGER R086CAT_AU AFTER UPDATE ON R086CAT FOR EACH ROW DECLARE
  l_Valor VARCHAR2(2000);
  l_Alterou BOOLEAN;
  l_Valido  BOOLEAN; 
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
  l_infoFacult BOOLEAN;
  l_NT06 BOOLEAN;
BEGIN
  l_Valor := '';
  l_Alterou := FALSE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;
  l_infoFacult := TRUE;
  l_NT06 := FALSE;
  
  SP_VALUPDATE_NUM(:OLD.TIPACI, :NEW.TIPACI, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
  	l_Alterou := TRUE;
  END IF;    
  
  SP_VALUPDATE_DAT(:OLD.DATOBI, :NEW.DATOBI, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_DAT(:OLD.DATAFA, :NEW.DATAFA, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
     
  SP_VALUPDATE_DES(:OLD.HOUINT, :NEW.HOUINT, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_DES(:OLD.DSCLES, :NEW.DSCLES, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_DES(:OLD.DIAACT, :NEW.DIAACT, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_DES(:OLD.CODDOE, :NEW.CODDOE, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_DES(:OLD.OBSLAU, :NEW.OBSLAU, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_DES(:OLD.OBSCAT, :NEW.OBSCAT, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_DES(:OLD.NOMMED, :NEW.NOMMED, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_DES(:OLD.REGCON, :NEW.REGCON, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_DES(:OLD.SIGORG, :NEW.SIGORG, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.ORGCLA, :NEW.ORGCLA, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_DES(:OLD.INICAT, :NEW.INICAT, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_DAT(:OLD.DATATE, :NEW.DATATE, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.HORATE, :NEW.HORATE, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.DURTRA, :NEW.DURTRA, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
      
  SP_VALUPDATE_DES(:OLD.CODSUB, :NEW.CODSUB, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  RH_ESOCIAL_NT06(:NEW.NUMEMP, l_NT06 OUT);
  
  IF (l_VersaoESocial >= 5) OR (l_NT06 = TRUE AND l_VersaoESocial = 4) THEN
    SP_VALUPDATE_DAT(:OLD.DATULT, :NEW.DATULT, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
    END IF;
    
    SP_VALUPDATE_DES(:OLD.AfsTra, :NEW.AfsTra, l_Valido OUT);
    IF(l_Valido = TRUE) THEN
      l_Alterou := TRUE;
    END IF;
  END IF;
    
  IF (l_Alterou = TRUE) THEN
	SP_CONCATENAR_DAT('DATACT', :NEW.DATACT, l_Valor OUT);
	SP_CONCATENAR_NUM('HORACT', :NEW.HORACT, l_Valor OUT);
	SP_CONCATENAR_DAT('DATCAT', :NEW.DATCAT, l_Valor OUT);
	SP_CONCATENAR_DES('TIPCAT', :NEW.TIPCAT, l_Valor OUT);
	
		SP_E_SOCIAL_SM('S-2210', 'R086CAT', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0,
		NULL, :NEW.DATACT, 0, 'R086CAT_AU');
  END IF;
END␀øÛ␀␀		SENIOR;0v␀␀

TRIGGER R086CAT_AD AFTER DELETE ON R086CAT FOR EACH ROW DECLARE
  l_Valor VARCHAR2(2000);
BEGIN
  l_Valor := '';

  SP_CONCATENAR_DAT('DATACT', :OLD.DATACT, l_Valor OUT);
  SP_CONCATENAR_NUM('HORACT', :OLD.HORACT, l_Valor OUT);
  SP_CONCATENAR_DAT('DATCAT', :OLD.DATCAT, l_Valor OUT);
  SP_CONCATENAR_DES('TIPCAT', :OLD.TIPCAT, l_Valor OUT);
  SP_CONCATENAR_DES('LAYOUT', 'S-2210', l_Valor OUT);

	SP_E_SOCIAL_SM('S-3000', 'R086CAT', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0,
	NULL, :OLD.DATACT, 0, 'R086CAT_AD');

	BEGIN
		DELETE FROM R240ACT
		WHERE
			NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATACT = :OLD.DATACT AND HORACT =
			:OLD.HORACT AND DATCAT = :OLD.DATCAT AND TIPCAT = :OLD.TIPCAT;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro no Delete da Tabela R240ACT. ';
	END;
