        l_identif := l_ideaux||l_milstr;

        /*Tratamento especial para a pendência de mensagem*/
        IF (p_numcpo = 20) THEN
            /*Data diferente de zerada, verifica se é maior do que a data atual*/
            IF (l_inform <> '      ') THEN
                BEGIN
                  l_data_atual := CURDATE();
                  /*CONVERTE CARACTERE EM DATA*/
                  l_comando := SUBSTRING(l_inform,1,2) || '/' || SUBSTRING(l_inform,3,2) ||'/'||SUBSTRING(l_inform,5,2);
                  SP_STRTODATE(l_comando, 'DD/MM/AA', l_dta_msg_date OUT);
                  l_comando := '';
                  IF ( (l_data_atual<l_dta_msg_date) OR (l_inform = '311250') ) THEN
                    l_inform := '999999';
                  END IF;
                EXCEPTION
                  WHEN OTHERS THEN
                    NULL;
                END;
            END IF;                                                                       
        END IF;

        /*Tabela de Log Senior das pendências geradas para a telemática*/
        BEGIN
            INSERT INTO R600PEN (IdeNti, NumFis, NumCra, NumCpo, InfOrm, StaPen) VALUES
                                (l_identif, l_numserial, l_icard, l_numcpo, l_inform, '1');
        EXCEPTION
          WHEN OTHERS THEN
            l_generate := FALSE;
        END;
        
        IF (l_generate = TRUE) THEN
            /* INSERE PENDÊNCIA NA ATUALI, ATRAVÉS DE COMANDO DINÂMICO */
            l_comando := 'INSERT INTO '||l_usutel||'ATUALI (IDENTIF,NUMSERIAL,ICARD,NUMCPO,INFORM) ';
            l_comando := l_comando||' VALUES ('''||l_identif||''','''||l_numserial||''','''||l_icard||''','''||l_numcpo||''','''||l_inform||''')';
            SP_CMDTSI(l_comando);
        END IF;

    END LOOP;
