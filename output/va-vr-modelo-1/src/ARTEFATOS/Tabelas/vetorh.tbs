/* Inclusao de Historico do Saldo.                    */
TRIGGER R010SAL_EI AFTER INSERT ON R010SAL FOR EACH ROW

BEGIN
R010SAL_ATUSAL ('I',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODSAL,:NEW.DATALT,:NEW.HORSAL,0);
END␀¡Ï␀␀		SENIOR;0(␀␀

/* Trigger de Atualizacao do Fechamento do Saldo apos */
/* Alteracao de Historico do Saldo.                   */
TRIGGER R010SAL_EU AFTER UPDATE ON R010SAL FOR EACH ROW

BEGIN
R010SAL_ATUSAL ('U',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODSAL,:NEW.DATALT,:NEW.HORSAL,:OLD.HORSAL);
END␀ŸÏ␀␀		SENIOR;0␀␀

/* Trigger de Atualizacao do Fechamento do Saldo apos */
/* Exclusao de Historico do Saldo.                    */
TRIGGER R010SAL_ED AFTER DELETE ON R010SAL FOR EACH ROW

BEGIN
R010SAL_ATUSAL ('D',:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.CODSAL,:OLD.DATALT,0,:OLD.HORSAL);
END␀␀␀Êù␀␀␀␀␀␀␀␀␀¢Ï␀␀-±␀	␀␀␀␀␀␀␀MAMA¤:q␀Æÿ␀␀£Ï␀␀␀Ç§␀␀E␀␀␀␀␀␀␀Ó©␀␀ç§␀␀ç§␀␀G␀␀ÿ␀␀ÿ␀ZUo␀␀␀␀␀␀␀QY°V°Vi␀␀ÿ␀␀ÿ␀½%=␀␀␀␀␀␀␀&&&c␀␀␀ÿ␀␀ÿ␀º%=␀␀␀␀␀␀␀␀&␀&␀&c␀␀␀ÿ␀␀ÿ␀¼%=␀␀␀␀␀␀␀&&&c␀␀␀ÿ␀␀ÿ␀␀™␀␀␀␀␀␀␀b␀b␀b␀q␀Æÿ␀␀ÿ␀p=␀␀␀␀␀␀␀IpIpIpp␀Æÿ␀␀ÿ␀7␀V␀␀␀␀␀␀␀q␀q␀q␀n␀Æÿ␀␀ÿ␀…¬␀␀´␀␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀D-Ì␀␀␀␀␀␀␀␀-AvÆ␀␀vÆ␀␀l␀Æÿ␀␀1#␀¤-␀␀␀␀␀␀␀␀<<<)␀␀	Æÿ␀␀ˆÒ␀␀␀Ÿj␀␀␀␀␀␀␀jšj›jn␀Æÿ␀␀ÿ␀␀‘␀␀Ñ␀␀␀␀␀␀␀␀ø”␀␀¯”␀␀g”␀␀œ␀␀␀êÿ␀␀ÿ␀oÑ␀␀␀␀␀␀␀␀¹n˜ngnœ␀␀␀êÿ␀␀ÿ␀␀␀␀0␀␀¢␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀¤Ï␀␀•-±␀	Ôÿ?␀␀␀␀␀÷=Ÿ␀Ÿ␀q␀Æÿ␀␀¨Ï␀␀␀bUEÔÿ?␀␀␀␀␀ıW°V°VG␀␀ÿ␀␀ÿ␀ìSTÔÿ1␀␀␀␀␀·V..]␀␀ÿ␀␀ÿ␀#␀±␀Ôÿ1␀␀␀␀␀º␀º0º␀q␀Æÿ␀␀¨Ï␀␀␀<␀¶Ôÿ1␀␀␀␀␀Ó␀t␀Ó␀p␀Æÿ␀␀ÿ␀,␀±␀Ôÿ1␀␀␀␀␀ ␀Ï␀Ä␀q␀Æÿ␀␀¨Ï␀␀␀g˜␀␀
