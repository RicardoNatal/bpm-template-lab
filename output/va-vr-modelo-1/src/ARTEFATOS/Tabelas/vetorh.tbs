/* INSERT (NEW) */
TRIGGER R026INS_EI AFTER INSERT ON R026INS FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Previdência*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 41;     /* Previdência*/
  l_codtpa := 193;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R026INS_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        SP_DATSTR(:NEW.PERREF, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERREF', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R026INS_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIACOR', CONVERT(NUMBER_TO_CHAR, :NEW.DIACOR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAVEN', CONVERT(NUMBER_TO_CHAR, :NEW.DIAVEN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VENCAR', CONVERT(NUMBER_TO_CHAR, :NEW.VENCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VEN13S', CONVERT(NUMBER_TO_CHAR, :NEW.VEN13S));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SALMIN', CONVERT(NUMBER_TO_CHAR, :NEW.SALMIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SALCON', CONVERT(NUMBER_TO_CHAR, :NEW.SALCON));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RECMIN', CONVERT(NUMBER_TO_CHAR, :NEW.RECMIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MINIPE', CONVERT(NUMBER_TO_CHAR, :NEW.MINIPE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MAXIPE', CONVERT(NUMBER_TO_CHAR, :NEW.MAXIPE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VENCOO', CONVERT(NUMBER_TO_CHAR, :NEW.VENCOO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VENCDO', CONVERT(NUMBER_TO_CHAR, :NEW.VENCDO));
      END;
  END IF; 
