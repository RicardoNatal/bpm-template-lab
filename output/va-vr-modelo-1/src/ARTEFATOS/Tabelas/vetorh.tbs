        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWMINABO', CONVERT(NUMBER_TO_CHAR, :NEW.MINABO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDMINABN', CONVERT(NUMBER_TO_CHAR, :OLD.MINABN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWMINABN', CONVERT(NUMBER_TO_CHAR, :NEW.MINABN));
