Ã␀␀PROCEDURE SP_PENDADE02(P_TIPEVE NUMBER(1), P_TIPOPE CHAR, P_VERPLF NUMBER(3), P_CODPLF NUMBER(7), P_CODREC NUMBER(15), P_CODPEN OUT NUMBER(18))
  IS

  l_datpen     DATE;
  l_codpen_str VARCHAR2(18);
  l_codpen     NUMBER(18);
BEGIN
  l_datpen := GETDBDATETIME;

  GETNEXTVALUEINT64('SEQADE', 1, NULL, l_codpen_str OUT);

  l_codpen := CONVERT(CHAR_TO_NUMBER, l_codpen_str);

  BEGIN
    INSERT INTO R152PEN (CODPEN, TIPEVE, TIPOPE, DTHPEN, STAPEN, VERPLF, CODPLF, CODREC) VALUES (l_codpen, P_TIPEVE, P_TIPOPE, l_datpen, 0, P_VERPLF, P_CODPLF, P_CODREC);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'SP_PENDADE02: Erro na inserção da pendência na R152PEN.';
  END;

  p_codpen := l_codpen;

  RETURN;
END		SENIOR;22GetNextValueInt64
