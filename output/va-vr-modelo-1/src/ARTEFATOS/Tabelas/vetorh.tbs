[␀␀/* 84 = UpdatePNG */
PROCEDURE SP_PEND84(P_TIPOPE NUMBER(1),P_TIPDOC NUMBER(2),P_NUMDOC VARCHAR2(20),P_SEGTDO NUMBER(2),P_SEGDOC VARCHAR2(20),P_NOMPNG VARCHAR2(40),P_BLODOC CHAR(1),P_BLONOM CHAR(1))
 IS

l_valstr     VARCHAR2(2047);
  l_tipOpeStr  CHAR(1);
  l_datatu     DATE;
  l_horatu     NUMBER(4);
  l_seqenv     NUMBER(2);
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datenv     CHAR(16);
  l_seqstr     CHAR(2);
  l_idtpes     CHAR(23);
  l_idtpes2    CHAR(23);
  l_nompng     VARCHAR2(40);
  l_TamNom     NUMBER(2);
  l_TamNomStr  VARCHAR2(2);
  l_bloDoc     CHAR(1);
  l_bloNom     CHAR(1);
  l_count      NUMBER;
BEGIN
  l_count := 0;
  BEGIN
	  SELECT COUNT(*) INTO l_count FROM R090DPN;
  EXCEPTION
      WHEN OTHERS THEN l_count := 0;
  END;  	
  /* Só envia pendência se houver definições de PNG setadas*/
  /* Se não tem definições, considera que não utiliza controle para PNG */
  IF (l_count > 0) THEN
	  /* Calcula  data/hora de envio da pendência.*/
	  l_datatu := CURDATE();
	  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
	  SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
	  SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);
	  l_seqenv := SECOND(CURTIME());
	  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
	  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';
	
	  SP_RETIDTPES(NULL,4,NULL,p_tipdoc,p_numdoc,NULL,NULL,l_idtpes OUT);
	  SP_RETIDTPES(NULL,4,NULL,p_segtdo,p_segdoc,NULL,NULL,l_idtpes2 OUT);
	
	  l_nompng := RTrim(LTrim(p_nompng));
	  l_TamNom := LENGTH(l_nompng); 
	  
	  SP_INTSTR(p_tipOpe, '9', l_tipOpeStr OUT);
	  SP_INTSTR(l_TamNom, '99', l_TamNomStr OUT);
	  
	  IF (p_bloDoc = 'S') THEN
	    l_bloDoc := '1';
	  ELSE
	    l_bloDoc := '0';
	  END IF;
	
	  IF (P_bloNom = 'S') THEN
	    l_bloNom := '1';
	  ELSE
	    l_bloNom := '0';
	  END IF;
	  
	  l_valstr := '84' || l_datenv || l_tipOpeStr || l_idtpes || l_idtpes2 || l_TamNomStr || l_nompng || l_bloDoc || l_bloNom;  
	  
	  BEGIN
	    SP_PORCOM(l_valstr, '0');
	  EXCEPTION
	    WHEN OTHERS THEN RAISERROR 103 'SP_PEND84: Erro ao gerar pendência 84.';
	  END;
  END IF;
END␀yø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
