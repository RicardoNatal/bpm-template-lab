DECLARE
l_Valor VARCHAR2(2000);
  l_InfoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_layout VARCHAR2(6);    
  l_gerarPendencia BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  l_Valor := '';
  l_InfoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_gerarPendencia := TRUE;
  l_VersaoESocial := 0;
  
  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
  IF (l_layout IS NOT NULL)THEN
    N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    IF (l_gerarPendencia = TRUE) THEN
      SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
    
      IF (l_SimplificaoESocial = TRUE) THEN
        SP_CONCATENAR_DAT('DATAFA', :NEW.DATAFA, l_Valor OUT);
	    SP_CONCATENAR_NUM('HORAFA', :NEW.HORAFA, l_Valor OUT);
	    SP_CONCATENAR_NUM('SEQREG', :NEW.SEQREG, l_Valor OUT);
        SP_CONCATENAR_DAT('INIFER', :NEW.INIFER, l_Valor OUT);
        SP_E_SOCIAL('S-2230', 'R038AFF', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.INIFER, 0, 'R038AFF_AI');
      END IF;
    END IF;    
  END IF;      
END␀XÔ␀␀		SENIOR;0á␀␀

TRIGGER R038AFF_AD AFTER DELETE ON R038AFF FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);
  l_InfoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_layout VARCHAR2(6);    
  l_gerarPendencia BOOLEAN;
  l_VersaoESocial NUMBER;  
BEGIN
  l_Valor := '';
  l_InfoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_gerarPendencia := TRUE;
  l_VersaoESocial := 0;
  
  RH_LAYOUTCOLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layout OUT);
  IF (l_layout IS NOT NULL)THEN
    N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    IF (l_gerarPendencia = TRUE) THEN  
      SP_ESOCIAL_INFO(:OLD.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);

      IF (l_SimplificaoESocial = TRUE) THEN
        SP_CONCATENAR_DAT('DATAFA', :OLD.DATAFA, l_Valor OUT);
	    SP_CONCATENAR_NUM('HORAFA', :OLD.HORAFA, l_Valor OUT);
	    SP_CONCATENAR_NUM('SEQREG', :OLD.SEQREG, l_Valor OUT);
        SP_CONCATENAR_DAT('INIFER', :OLD.INIFER, l_Valor OUT);
	    SP_CONCATENAR_DES('LAYOUT', 'S-2230', l_Valor OUT);
	    SP_E_SOCIAL('S-3000', 'R038AFF', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0, NULL, :OLD.INIFER, 0, 'R038AFF_AD');
      END IF;
    END IF;      
  END IF;      
END␀␀␀c␀␀␀␀␀␀␀␀␀␀␀ZÔ␀␀…¬␀␀´␀	„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	„␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	„␀␀␀␀␀␀.%0.0.w␀Æÿ␀␀…Ó␀␀␀Ï␀␀Ñ␀	„␀␀␀␀␀␀û”␀␀Á␀␀ù”␀␀qC␀êÿ␀␀ÿ␀␀Ñ␀„␀␀␀␀␀␀ï+␀¿+␀Ô+␀qC␀êÿ␀␀ÿ␀N8„␀␀␀␀␀␀␀`␀n␀Æÿ␀␀ÿ␀Ñ19„␀␀␀␀␀␀Ô677n␀Æÿ␀␀ÿ␀“º␀␀=„␀␀␀␀␀␀␀U»␀␀<»␀␀V»␀␀c␀␀␀ÿ␀␀ÿN:=„␀␀␀␀␀␀␀ˆÆ␀␀QQc␀␀␀ÿ␀␀ÿN=„␀␀␀␀␀␀␀‰Æ␀␀((c␀␀␀ÿ␀␀ÿN:F„␀␀␀␀␀␀␀;;;n␀␀Æÿ␀␀ÿ1`,±␀Ôÿ1␀␀␀␀␀Œ<RRq␀Æÿ␀␀RØ␀␀␀ŠqC„␀␀␀␀␀␀ŒqŒqŒqp␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3␀␀Âv␀␀␀␀␀␀␀␀␀␀␀␀␀[Ô␀␀…¬␀␀´␀	€€␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	€€␀␀␀␀␀Ü␀Ü␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	€€␀␀␀␀␀@0.0.w␀Æÿ␀␀…Ó␀␀␀pDÑ␀	€€␀␀␀␀␀JÙEFqC␀êÿ␀␀]Ô␀␀␀ˆü␀␀­␀	€€␀␀␀␀␀&ÿ␀␀xş␀␀xş␀␀p␀Æÿ␀␀^Ô␀␀␀“ü␀␀­␀	€€␀␀␀␀␀µÿ␀␀ƒş␀␀ƒş␀␀p␀Æÿ␀␀ÿ␀+§␀␀9€€␀␀␀␀␀B©␀␀ìì:␀␀ÿ␀␀ÿ␀İÒ␀€€␀␀␀␀␀ììÿ␀ÿÿ␀␀ÿ␀␀␀␀0;1;2;3;4;5␀␀␀␀␀␀␀␀␀␀␀\Ô␀␀…¬␀␀´␀	€€␀␀␀␀␀j>XbYbr␀Æÿ␀␀Ò␀␀␀.␀t	€€␀␀␀␀␀␀Ü␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	€€␀␀␀␀␀–%€$0.w␀Æÿ␀␀…Ó␀␀␀pDÑ␀	€€␀␀␀␀␀JÙEFqC␀êÿ␀␀]Ô␀␀␀ˆü␀␀­␀	€€␀␀␀␀␀&ÿ␀␀xş␀␀xş␀␀p␀Æÿ␀␀^Ô␀␀␀Ïa´␀€€␀␀␀␀␀cXbybr␀Æÿ␀␀Ò␀␀␀␀t€€␀␀␀␀␀␀Ô␀à␀n¼‡␀Æÿ␀␀ˆÓ␀␀␀=$Ì␀€€␀␀␀␀␀}%ˆ$w¼‡␀Æÿ␀␀…Ó␀␀␀jPƒ€€␀␀␀␀␀ŒQ¿␀␀¿␀␀n␀Æÿ␀␀ÿ␀T€€␀␀␀␀␀X°V°VB␀␀ÿ␀␀ÿ␀ñ␀>€€␀␀␀␀␀­␀t␀t␀n␀Æÿ␀␀ÿ0␀␀␀	0;1;2;3;4␀␀␀␀␀␀␀␀␀␀␀␀␀␀_Ô␀␀…¬␀␀´␀	Ôÿ1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ1␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ1␀␀␀␀␀œ$€$€$w␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ôÿ1␀␀␀␀␀ÿEÿEÿEqC