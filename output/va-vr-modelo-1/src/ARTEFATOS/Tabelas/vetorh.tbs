DECLARE
  l_verseq    NUMBER(10);
  l_seqreg    NUMBER(15);
  l_auditoria CHAR(1);
BEGIN
    /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
    l_auditoria := 'N';
    SP_AUDVER(l_auditoria OUT, 'R095MTC');

    IF (l_auditoria = 'S') THEN

        SP_AUDGETVERSEQ(0, l_seqreg OUT, l_verseq OUT);
        :NEW.SEQREG := l_seqreg;

        BEGIN
            INSERT INTO R095MTC_AUD(SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,CODMAT,OBSMAT)
                         VALUES (l_seqreg,l_verseq,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODMAT,:NEW.OBSMAT);

            SP_AUDGENREG(l_seqreg,l_verseq,'R095MTC','INSERÇÃO');
        EXCEPTION
          WHEN OTHERS THEN
              RAISERROR 103 'Erro gerar registro para auditoria ';
        END;
    END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀¢İ␀␀		SENIOR;0°
␀␀

TRIGGER R095MTC_EU AFTER UPDATE ON R095MTC FOR EACH ROW
DECLARE
  l_alterou         BOOLEAN;
  l_camposAlterados VARCHAR(100);
  l_verseq          NUMBER(10);
  l_seqreg          NUMBER(15);
  l_auditoria       CHAR(1);
BEGIN
    /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
    l_auditoria := 'N';
    SP_AUDVER(l_auditoria OUT, 'R095MTC');

    IF (l_auditoria = 'S') THEN

        l_camposAlterados := 'Campo(s) alterado(s): ';
        l_alterou := FALSE;

        IF (:NEW.NUMEMP <> :OLD.NUMEMP) THEN
            l_alterou := TRUE;
            l_camposAlterados := l_camposAlterados||'NUMEMP ';
        END IF;

        IF (:NEW.TIPCOL <> :OLD.TIPCOL) THEN
            l_alterou := TRUE;
            l_camposAlterados := l_camposAlterados||'TIPCOL ';
        END IF;

        IF (:NEW.NUMCAD <> :OLD.NUMCAD) THEN
            l_alterou := TRUE;
            l_camposAlterados := l_camposAlterados||'NUMCAD ';
        END IF;

        IF (:NEW.CODMAT <> :OLD.CODMAT) THEN
            l_alterou := TRUE;
            l_camposAlterados := l_camposAlterados||'CODMAT ';
        END IF;

        IF ((:NEW.OBSMAT <> :OLD.OBSMAT) OR (:OLD.OBSMAT IS NULL AND :NEW.OBSMAT IS NOT NULL) OR (:NEW.OBSMAT IS NULL AND :OLD.OBSMAT IS NOT NULL)) THEN
            l_alterou := TRUE;
            l_camposAlterados := l_camposAlterados||'OBSMAT ';
        END IF;

        IF (l_alterou = TRUE) THEN

            l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

            l_seqreg := :NEW.SEQREG;

            IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

                BEGIN
                    SELECT MAX(SEQREG) INTO l_seqreg
                      FROM R095MTC_AUD
                     WHERE NUMEMP = :OLD.NUMEMP AND
                           TIPCOL = :OLD.TIPCOL AND
                           NUMCAD = :OLD.NUMCAD AND
                           CODMAT = :OLD.CODMAT;

                EXCEPTION
                  WHEN OTHERS THEN
                      RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
                END;
            END IF;

            SP_AUDGETVERSEQ(l_seqreg, l_seqreg OUT, l_verseq OUT);

            BEGIN
                INSERT INTO R095MTC_AUD(SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,CODMAT,OBSMAT)
                             VALUES (l_seqreg,l_verseq,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODMAT,:NEW.OBSMAT);

                SP_AUDGENREG(l_seqreg,l_verseq,'R095MTC',l_camposAlterados);
            EXCEPTION
              WHEN OTHERS THEN
                  RAISERROR 103 'Erro gerar registro para auditoria. ';
            END;
        END IF;
    END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀ İ␀␀		SENIOR;0Œ␀␀

TRIGGER R095MTC_ED AFTER DELETE ON R095MTC FOR EACH ROW
DECLARE
  l_verseq    NUMBER(10);
  l_seqreg    NUMBER(15);
  l_auditoria CHAR(1);
BEGIN
    /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
    l_auditoria := 'N';
    SP_AUDVER(l_auditoria OUT, 'R095MTC');

    IF (l_auditoria = 'S') THEN
        l_seqreg := :OLD.SEQREG;

        IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

            BEGIN
                SELECT MAX(SEQREG) INTO l_seqreg
                  FROM R095MTC_AUD
                 WHERE NUMEMP = :OLD.NUMEMP AND
                       TIPCOL = :OLD.TIPCOL AND
                       NUMCAD = :OLD.NUMCAD AND
                       CODMAT = :OLD.CODMAT;
             EXCEPTION
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
            END;
        END IF;

        SP_AUDGETVERSEQ(l_seqreg, l_seqreg OUT, l_verseq OUT);

        BEGIN
            INSERT INTO R095MTC_AUD(SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,CODMAT,OBSMAT)
                         VALUES (l_seqreg,l_verseq,:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.CODMAT,:OLD.OBSMAT);

            SP_AUDGENREG(l_seqreg,l_verseq,'R095MTC','DELETE');
        EXCEPTION
          WHEN OTHERS THEN
              RAISERROR 103 'Erro gerar registro para auditoria. ';
        END;
    END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀␀␀U␀␀␀␀␀␀␀␀␀Ÿİ␀␀ş␀␀¢␀	␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀­%␀‹␀	␀␀␀␀␀␀(&␀|%␀&␀a␀Æÿ␀␀ÿ␀…¬␀␀´␀	␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀Ü␀t␀Ü␀n¼‡␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀.%€$0.w¼‡␀Æÿ␀␀…Ó␀␀␀ú,	␀␀␀␀␀␀à@ ; ;w␀␀␀ÿ␀␀›İ␀␀␀³␀␀€␀␀␀␀␀␀␀ñ³␀␀ñ³␀␀ñ³␀␀"␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3;4;5␀␀V␀␀␀␀␀␀␀␀␀␀£İ␀␀…¬␀␀´␀	␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀B%€$€$w␀Æÿ␀␀DÚ␀␀␀ú,	␀␀␀␀␀␀à@ ; ;w␀␀␀ÿ␀␀›İ␀␀␀³␀␀€␀␀␀␀␀␀␀ñ³␀␀ñ³␀␀ñ³␀␀"␀␀ÿ␀␀ÿ␀␀␀␀0;1;2␀␀W␀␀␀␀␀␀␀¤İ␀␀N␀	␀␀␀␀␀␀£␀␀0␀n␀Æÿ␀␀|İ␀␀␀~¬␀␀(	␀␀␀␀␀␀V±␀␀†^¯␀␀d␀␀␀ÿ␀␀{İ␀␀␀ú,	␀␀␀␀␀␀à@ ; ;w␀␀␀ÿ␀␀›İ␀␀␀³␀␀€␀␀␀␀␀␀␀ñ³␀␀ñ³␀␀ñ³␀␀"␀␀ÿ␀␀ÿ␀ş␀␀¢␀␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀␀␀␀0;1;2§İ␀␀		SENIOR;0Z␀␀TRIGGER R095MTV_EI BEFORE INSERT ON R095MTV FOR EACH ROW
DECLARE
  l_verseq    NUMBER(10);
  l_seqreg    NUMBER(15);
  l_auditoria CHAR(1);
BEGIN
    /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
    l_auditoria := 'N';
    SP_AUDVER(l_auditoria OUT, 'R095MTV');

    IF (l_auditoria = 'S') THEN

        SP_AUDGETVERSEQ(0, l_seqreg OUT, l_verseq OUT);
        :NEW.SEQREG := l_seqreg;

        BEGIN
            INSERT INTO R095MTV_AUD(SEQREG,VERSEQ,TIPDOC,NUMDOC,CODMAT,OBSMAT)
                         VALUES (l_seqreg,l_verseq,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.CODMAT,:NEW.OBSMAT);

            SP_AUDGENREG(l_seqreg,l_verseq,'R095MTV','INSERÇÃO');
        EXCEPTION
          WHEN OTHERS THEN
              RAISERROR 103 'Erro gerar registro para auditoria ';
        END;
    END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀¨İ␀␀		SENIOR;0Ç	␀␀

TRIGGER R095MTV_EU AFTER UPDATE ON R095MTV FOR EACH ROW
DECLARE
  l_alterou         BOOLEAN;
  l_camposAlterados VARCHAR(100);
  l_verseq          NUMBER(10);
  l_seqreg          NUMBER(15);
  l_auditoria       CHAR(1);
BEGIN
    /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
    l_auditoria := 'N';
    SP_AUDVER(l_auditoria OUT, 'R095MTV');

    IF (l_auditoria = 'S') THEN

        l_camposAlterados := 'Campo(s) alterado(s): ';
        l_alterou := FALSE;

        IF (:NEW.TIPDOC <> :OLD.TIPDOC) THEN
            l_alterou := TRUE;
            l_camposAlterados := l_camposAlterados||'TIPDOC ';
        END IF;

        IF (:NEW.NUMDOC <> :OLD.NUMDOC) THEN
            l_alterou := TRUE;
            l_camposAlterados := l_camposAlterados||'NUMDOC ';
        END IF;

        IF (:NEW.CODMAT <> :OLD.CODMAT) THEN
            l_alterou := TRUE;
            l_camposAlterados := l_camposAlterados||'CODMAT ';
        END IF;

        IF ((:NEW.OBSMAT <> :OLD.OBSMAT) OR (:OLD.OBSMAT IS NULL AND :NEW.OBSMAT IS NOT NULL) OR (:NEW.OBSMAT IS NULL AND :OLD.OBSMAT IS NOT NULL)) THEN
            l_alterou := TRUE;
            l_camposAlterados := l_camposAlterados||'OBSMAT ';
        END IF;

        IF (l_alterou = TRUE) THEN

            l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

            l_seqreg := :NEW.SEQREG;

            IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

                BEGIN
                    SELECT MAX(SEQREG) INTO l_seqreg
                      FROM R095MTV_AUD
                     WHERE TIPDOC = :OLD.TIPDOC AND
                           NUMDOC = :OLD.NUMDOC AND
                           CODMAT = :OLD.CODMAT;

                EXCEPTION
                  WHEN OTHERS THEN
                      RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
                END;
            END IF;

            SP_AUDGETVERSEQ(l_seqreg, l_seqreg OUT, l_verseq OUT);

            BEGIN
                INSERT INTO R095MTV_AUD(SEQREG,VERSEQ,TIPDOC,NUMDOC,CODMAT,OBSMAT)
                             VALUES (l_seqreg,l_verseq,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.CODMAT,:NEW.OBSMAT);

                SP_AUDGENREG(l_seqreg,l_verseq,'R095MTV',l_camposAlterados);
            EXCEPTION
              WHEN OTHERS THEN
                  RAISERROR 103 'Erro gerar registro para auditoria. ';
            END;
        END IF;
    END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀¦İ␀␀		SENIOR;0H␀␀

TRIGGER R095MTV_ED AFTER DELETE ON R095MTV FOR EACH ROW
DECLARE
  l_verseq    NUMBER(10);
  l_seqreg    NUMBER(15);
  l_auditoria CHAR(1);
BEGIN
    /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
    l_auditoria := 'N';
    SP_AUDVER(l_auditoria OUT, 'R095MTV');

    IF (l_auditoria = 'S') THEN
        l_seqreg := :OLD.SEQREG;

        IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

            BEGIN
                SELECT MAX(SEQREG) INTO l_seqreg
                  FROM R095MTV_AUD
                 WHERE TIPDOC = :OLD.TIPDOC AND
                       NUMDOC = :OLD.NUMDOC AND
                       CODMAT = :OLD.CODMAT;
             EXCEPTION
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
            END;
        END IF;

        SP_AUDGETVERSEQ(l_seqreg, l_seqreg OUT, l_verseq OUT);

        BEGIN
            INSERT INTO R095MTV_AUD(SEQREG,VERSEQ,TIPDOC,NUMDOC,CODMAT,OBSMAT)
                         VALUES (l_seqreg,l_verseq,:OLD.TIPDOC,:OLD.NUMDOC,:OLD.CODMAT,:OLD.OBSMAT);

            SP_AUDGENREG(l_seqreg,l_verseq,'R095MTV','DELETE');
        EXCEPTION
          WHEN OTHERS THEN
              RAISERROR 103 'Erro gerar registro para auditoria. ';
        END;
    END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀␀␀X␀␀␀␀␀␀␀␀¥İ␀␀ş␀␀¢␀	␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀­%␀‹␀	␀␀␀␀␀␀(&␀|%␀&␀a␀Æÿ␀␀ÿ␀N␀	␀␀␀␀␀␀£␀␀0␀n␀Æÿ␀␀|İ␀␀␀~¬␀␀(	␀␀␀␀␀␀V±␀␀†^¯␀␀d␀␀␀ÿ␀␀{İ␀␀␀ú,	␀␀␀␀␀␀à@ ; ;w␀␀␀ÿ␀␀›İ␀␀␀³␀␀€␀␀␀␀␀␀␀ñ³␀␀ñ³␀␀ñ³␀␀"␀␀ÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀Y␀␀␀␀␀␀␀␀␀©İ␀␀6EÑ␀	␀␀␀␀␀´IÙEHqC␀êÿ␀␀ÿ␀¼w·␀	␀␀␀␀␀yıw¤xì*␀␀Æÿ␀␀ÿ␀©ı␀␀­␀	␀␀␀␀␀£ÿ␀␀Eü␀␀xş␀␀p␀Æ`␀␀ÿ␀ú,␀␀␀␀␀à@ ; ;w␀␀␀ÿ␀␀›İ␀␀␀àTU␀␀␀␀␀YWWV␀␀ÿ␀␀ÿ␀-Ê␀␀¼␀␀␀␀␀␀°Ë␀␀°Ë␀␀°Ë␀␀v␀Æÿ␀␀ÿ␀Ì␀'␀␀␀␀␀␀›£␀␀␀c␀␀␀ÿ␀␀ÿ␀ù␀m␀␀␀␀␀5␀ø␀ø␀n¼‡␀Æÿ␀␀ÿ␀…¬␀␀´␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t␀␀␀␀␀Ü␀t␀Ü␀n¼‡␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀␀␀␀␀␀.%0.0.w	ˆ␀Æÿ␀␀…Ó␀␀␀N␀␀␀␀␀␀£␀␀0␀n␀Æÿ␀␀|İ␀␀␀~¬␀␀(␀␀␀␀␀V±␀␀†^¯␀␀d␀␀␀ÿ␀␀{İ␀␀␀ÿa´␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀Y$Ì␀␀␀␀␀␀B%€$€$w␀Æÿ␀␀DÚ␀␀␀ª¬␀␀␀␀␀␀␀’␀␀v␀␀v␀␀#␀␀ÿ␀␀±Ú␀␀␀¯¦␀␀Á␀␀␀␀␀␀&°␀␀,«␀␀,«␀␀y␀Æÿ␀␀ÿ␀°¦␀␀Á␀␀␀␀␀␀'°␀␀-«␀␀-«␀␀y␀Æÿ␀␀ÿ␀³␀␀€␀␀␀␀␀␀i´␀␀ñ³␀␀ñ³␀␀"␀␀ÿ␀␀ÿ␀M³␀␀€␀␀␀␀␀␀´␀␀&³␀␀ñ³␀␀"␀␀ÿ␀␀ÿ␀×-‹␀␀␀␀␀␀ÄAm␀m␀—)␀␀Æÿ␀␀ÿ␀␀ô␀␀=␀␀␀␀␀\␀␀6Å␀␀6Å␀␀c␀␀␀ÿ␀␀ÿ␀2␀è␀␀␀␀␀è␀R␀R␀n␀Æÿ␀␀ÿ␀9-±␀␀␀␀␀␀“=àÃ␀␀àÃ␀␀q␀Æÿ␀␀ğ×␀␀␀ş␀␀¢␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀␀␀␀0;1;2¬İ␀␀		SENIOR;0N␀␀TRIGGER R095MVM_EI BEFORE INSERT ON R095MVM FOR EACH ROW
DECLARE
  l_verseq    NUMBER(10);
  l_seqreg    NUMBER(15);
  l_auditoria CHAR(1);
BEGIN
    IF (:NEW.TIPPES <= 4) THEN /* Apenas colaboradores e visitantes */
        /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
        l_auditoria := 'N';
        SP_AUDVER(l_auditoria OUT, 'R095MVM');

        IF (l_auditoria = 'S') THEN

            SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
            :NEW.SEQREG := l_seqreg;

            BEGIN
                INSERT INTO R095MVM_AUD(SEQREG,VERSEQ,DATMOV,HORMOV,SEQMOV,CODMAT,DESMAT,QTDMAT,TIPMOV,TIPPES,
                                     NUMEMP,TIPCOL,NUMCAD,TIPDOC,NUMDOC,EMPOCR,CADOCR,NUMMAT,NFSENT,NFSSAI,
                                     OBSMAT,OBSATU,CODUSU,RETMAT,STAMAT,CODPOR)
                             VALUES (l_seqreg,l_verseq,:NEW.DATMOV,:NEW.HORMOV,:NEW.SEQMOV,:NEW.CODMAT,:NEW.DESMAT,
                                    :NEW.QTDMAT,:NEW.TIPMOV,:NEW.TIPPES,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.TIPDOC,
                                    :NEW.NUMDOC,:NEW.EMPOCR,:NEW.CADOCR,:NEW.NUMMAT,:NEW.NFSENT,:NEW.NFSSAI,:NEW.OBSMAT,
                                    :NEW.OBSATU,:NEW.CODUSU,:NEW.RETMAT,:NEW.STAMAT,:NEW.CODPOR);

                SP_AUDGENREG(l_seqreg,l_verseq,'R095MVM','INSERÇÃO');
            EXCEPTION
              WHEN OTHERS THEN
                  RAISERROR 103 'Erro gerar registro para auditoria ';
            END;
        END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
    END IF;/* Apenas colaboradores e visitantes */
END␀­İ␀␀		SENIOR;0> ␀␀

TRIGGER R095MVM_EU AFTER UPDATE ON R095MVM FOR EACH ROW
DECLARE
  l_alterou         BOOLEAN;
  l_camposAlterados VARCHAR(2000);
  l_verseq          NUMBER(10);
  l_seqreg          NUMBER(15);
  l_auditoria       CHAR(1);
BEGIN
    IF (:NEW.TIPPES <= 4) THEN /* Apenas colaboradores e visitantes */
        /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
        l_auditoria := 'N';
        SP_AUDVER(l_auditoria OUT, 'R095MVM');

        IF (l_auditoria = 'S') THEN

            l_camposAlterados := 'Campo(s) alterado(s): ';
            l_alterou := FALSE;

            IF (:NEW.DATMOV <> :OLD.DATMOV) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'DATMOV ';
            END IF;

            IF (:NEW.HORMOV <> :OLD.HORMOV) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'HORMOV ';
            END IF;

            IF (:NEW.SEQMOV <> :OLD.SEQMOV) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'SEQMOV ';
            END IF;

            IF ((:NEW.CODMAT <> :OLD.CODMAT) OR (:OLD.CODMAT IS NULL AND :NEW.CODMAT IS NOT NULL) OR (:NEW.CODMAT IS NULL AND :OLD.CODMAT IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'CODMAT ';
            END IF;

            IF ((:NEW.DESMAT <> :OLD.DESMAT) OR (:OLD.DESMAT IS NULL AND :NEW.DESMAT IS NOT NULL) OR (:NEW.DESMAT IS NULL AND :OLD.DESMAT IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'DESMAT ';
            END IF;

            IF ((:NEW.QTDMAT <> :OLD.QTDMAT) OR (:OLD.QTDMAT IS NULL AND :NEW.QTDMAT IS NOT NULL) OR (:NEW.QTDMAT IS NULL AND :OLD.QTDMAT IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'QTDMAT ';
            END IF;

            IF ((:NEW.TIPMOV <> :OLD.TIPMOV) OR (:OLD.TIPMOV IS NULL AND :NEW.TIPMOV IS NOT NULL) OR (:NEW.TIPMOV IS NULL AND :OLD.TIPMOV IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'TIPMOV ';
            END IF;

            IF ((:NEW.TIPPES <> :OLD.TIPPES) OR (:OLD.TIPPES IS NULL AND :NEW.TIPPES IS NOT NULL) OR (:NEW.TIPPES IS NULL AND :OLD.TIPPES IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'TIPPES ';
            END IF;

            IF ((:NEW.NUMEMP <> :OLD.NUMEMP) OR (:OLD.NUMEMP IS NULL AND :NEW.NUMEMP IS NOT NULL) OR (:NEW.NUMEMP IS NULL AND :OLD.NUMEMP IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'NUMEMP ';
            END IF;

            IF ((:NEW.TIPCOL <> :OLD.TIPCOL) OR (:OLD.TIPCOL IS NULL AND :NEW.TIPCOL IS NOT NULL) OR (:NEW.TIPCOL IS NULL AND :OLD.TIPCOL IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'TIPCOL ';
            END IF;

            IF ((:NEW.NUMCAD <> :OLD.NUMCAD) OR (:OLD.NUMCAD IS NULL AND :NEW.NUMCAD IS NOT NULL) OR (:NEW.NUMCAD IS NULL AND :OLD.NUMCAD IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'NUMCAD ';
            END IF;

            IF ((:NEW.TIPDOC <> :OLD.TIPDOC) OR (:OLD.TIPDOC IS NULL AND :NEW.TIPDOC IS NOT NULL) OR (:NEW.TIPDOC IS NULL AND :OLD.TIPDOC IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'TIPDOC ';
            END IF;

            IF ((:NEW.NUMDOC <> :OLD.NUMDOC) OR (:OLD.NUMDOC IS NULL AND :NEW.NUMDOC IS NOT NULL) OR (:NEW.NUMDOC IS NULL AND :OLD.NUMDOC IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'NUMDOC ';
            END IF;

            IF ((:NEW.NFSENT <> :OLD.NFSENT) OR (:OLD.NFSENT IS NULL AND :NEW.NFSENT IS NOT NULL) OR (:NEW.NFSENT IS NULL AND :OLD.NFSENT IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'NFSENT ';
            END IF;

            IF ((:NEW.NFSSAI <> :OLD.NFSSAI) OR (:OLD.NFSSAI IS NULL AND :NEW.NFSSAI IS NOT NULL) OR (:NEW.NFSSAI IS NULL AND :OLD.NFSSAI IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'NFSSAI ';
            END IF;

            IF ((:NEW.OBSMAT <> :OLD.OBSMAT) OR (:OLD.OBSMAT IS NULL AND :NEW.OBSMAT IS NOT NULL) OR (:NEW.OBSMAT IS NULL AND :OLD.OBSMAT IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'OBSMAT ';
            END IF;

            IF ((:NEW.OBSATU <> :OLD.OBSATU) OR (:OLD.OBSATU IS NULL AND :NEW.OBSATU IS NOT NULL) OR (:NEW.OBSATU IS NULL AND :OLD.OBSATU IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'OBSATU ';
            END IF;

            IF ((:NEW.CODUSU <> :OLD.CODUSU) OR (:OLD.CODUSU IS NULL AND :NEW.CODUSU IS NOT NULL) OR (:NEW.CODUSU IS NULL AND :OLD.CODUSU IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'CODUSU ';
            END IF;

            IF ((:NEW.RETMAT <> :OLD.RETMAT) OR (:OLD.RETMAT IS NULL AND :NEW.RETMAT IS NOT NULL) OR (:NEW.RETMAT IS NULL AND :OLD.RETMAT IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'RETMAT ';
            END IF;

            IF ((:NEW.STAMAT <> :OLD.STAMAT) OR (:OLD.STAMAT IS NULL AND :NEW.STAMAT IS NOT NULL) OR (:NEW.STAMAT IS NULL AND :OLD.STAMAT IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'STAMAT ';
            END IF;

            IF ((:NEW.CODPOR <> :OLD.CODPOR) OR (:OLD.CODPOR IS NULL AND :NEW.CODPOR IS NOT NULL) OR (:NEW.CODPOR IS NULL AND :OLD.CODPOR IS NOT NULL)) THEN
                l_alterou := TRUE;
                l_camposAlterados := l_camposAlterados||'CODPOR ';
            END IF;

            IF (l_alterou = TRUE) THEN

                l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

                l_seqreg := :NEW.SEQREG;

                IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

                    BEGIN
                        SELECT MAX(SEQREG) INTO l_seqreg
                          FROM R095MVM_AUD
                         WHERE DATMOV = :OLD.DATMOV AND
                               HORMOV = :OLD.HORMOV AND
                               SEQMOV = :OLD.SEQMOV;
                     EXCEPTION
                      WHEN OTHERS THEN
                        RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
                    END;
                END IF;

                SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

                BEGIN
                    INSERT INTO R095MVM_AUD(SEQREG,VERSEQ,DATMOV,HORMOV,SEQMOV,CODMAT,DESMAT,QTDMAT,TIPMOV,TIPPES,
                                         NUMEMP,TIPCOL,NUMCAD,TIPDOC,NUMDOC,EMPOCR,CADOCR,NUMMAT,NFSENT,NFSSAI,
                                         OBSMAT,OBSATU,CODUSU,RETMAT,STAMAT,CODPOR)
                                 VALUES (l_seqreg,l_verseq,:NEW.DATMOV,:NEW.HORMOV,:NEW.SEQMOV,:NEW.CODMAT,:NEW.DESMAT,
                                        :NEW.QTDMAT,:NEW.TIPMOV,:NEW.TIPPES,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.TIPDOC,
                                        :NEW.NUMDOC,:NEW.EMPOCR,:NEW.CADOCR,:NEW.NUMMAT,:NEW.NFSENT,:NEW.NFSSAI,:NEW.OBSMAT,
                                        :NEW.OBSATU,:NEW.CODUSU,:NEW.RETMAT,:NEW.STAMAT,:NEW.CODPOR);

                    SP_AUDGENREG(l_seqreg,l_verseq,'R095MVM',l_camposAlterados);
                EXCEPTION
                  WHEN OTHERS THEN
                      RAISERROR 103 'Erro gerar registro para auditoria. ';
                END;
            END IF;
        END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
    END IF;/* Apenas colaboradores e visitantes */
END␀«İ␀␀		SENIOR;0q␀␀

TRIGGER R095MVM_ED AFTER DELETE ON R095MVM FOR EACH ROW
DECLARE
  l_verseq    NUMBER(10);
  l_seqreg    NUMBER(15);
  l_auditoria CHAR(1);
BEGIN
    IF (:OLD.TIPPES <= 4) THEN /* Apenas colaboradores e visitantes */
        /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
        l_auditoria := 'N';
        SP_AUDVER(l_auditoria OUT, 'R095MVM');

        IF (l_auditoria = 'S') THEN
            l_seqreg := :OLD.SEQREG;

            IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

                BEGIN
                    SELECT MAX(SEQREG) INTO l_seqreg
                      FROM R095MVM_AUD
                     WHERE DATMOV = :OLD.DATMOV AND
                           HORMOV = :OLD.HORMOV AND
                           SEQMOV = :OLD.SEQMOV;
                 EXCEPTION
                  WHEN OTHERS THEN
                    RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
                END;
            END IF;
            SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

            BEGIN
                 INSERT INTO R095MVM_AUD(SEQREG,VERSEQ,DATMOV,HORMOV,SEQMOV,CODMAT,DESMAT,QTDMAT,TIPMOV,TIPPES,
                                      NUMEMP,TIPCOL,NUMCAD,TIPDOC,NUMDOC,EMPOCR,CADOCR,NUMMAT,NFSENT,NFSSAI,
                                      OBSMAT,OBSATU,CODUSU,RETMAT,STAMAT,CODPOR)
                              VALUES (l_seqreg,l_verseq,:OLD.DATMOV,:OLD.HORMOV,:OLD.SEQMOV,:OLD.CODMAT,:OLD.DESMAT,
                                     :OLD.QTDMAT,:OLD.TIPMOV,:OLD.TIPPES,:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.TIPDOC,
                                     :OLD.NUMDOC,:OLD.EMPOCR,:OLD.CADOCR,:OLD.NUMMAT,:OLD.NFSENT,:OLD.NFSSAI,:OLD.OBSMAT,
                                     :OLD.OBSATU,:OLD.CODUSU,:OLD.RETMAT,:OLD.STAMAT,:OLD.CODPOR);

                SP_AUDGENREG(l_seqreg,l_verseq,'R095MVM','DELETE');
            EXCEPTION
              WHEN OTHERS THEN
                  RAISERROR 103 'Erro gerar registro para auditoria. ';
            END;
        END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
    END IF;/* Apenas colaboradores e visitantes */
END␀␀␀£␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ªİ␀␀ş␀␀¢␀	␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀­%␀‹␀	␀␀␀␀␀(&␀|%␀&␀a␀Æÿ␀␀ÿ␀6EÑ␀	␀␀␀␀␀´IÙEHqC␀êÿ␀␀ÿ␀¼w·␀	␀␀␀␀␀yıw¤xì*␀␀Æÿ␀␀ÿ␀©ı␀␀­␀	␀␀␀␀␀£ÿ␀␀Eü␀␀xş␀␀p␀Æ`␀␀ÿ␀ú,␀␀␀␀␀à@ ; ;w␀␀␀ÿ␀␀›İ␀␀␀àTU␀␀␀␀␀YWWV␀␀ÿ␀␀ÿ␀-Ê␀␀¼␀␀␀␀␀␀°Ë␀␀°Ë␀␀°Ë␀␀v␀Æÿ␀␀ÿ␀Ì␀'␀␀␀␀␀␀›£␀␀␀c␀␀␀ÿ␀␀ÿ␀ù␀m␀␀␀␀␀5␀ø␀ø␀n¼‡␀Æÿ␀␀ÿ␀…¬␀␀´␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t␀␀␀␀␀Ü␀t␀Ü␀n¼‡␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀␀␀␀␀␀.%0.0.w	ˆ␀Æÿ␀␀…Ó␀␀␀N␀␀␀␀␀␀£␀␀0␀n␀Æÿ␀␀|İ␀␀␀~¬␀␀(␀␀␀␀␀V±␀␀†^¯␀␀d␀␀␀ÿ␀␀{İ␀␀␀ÿa´␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀Y$Ì␀␀␀␀␀␀B%€$€$w␀Æÿ␀␀DÚ␀␀␀ª¬␀␀␀␀␀␀␀’␀␀v␀␀v␀␀#␀␀ÿ␀␀±Ú␀␀␀¯¦␀␀Á␀␀␀␀␀␀&°␀␀,«␀␀,«␀␀y␀Æÿ␀␀ÿ␀°¦␀␀Á␀␀␀␀␀␀'°␀␀-«␀␀-«␀␀y␀Æÿ␀␀ÿ␀³␀␀€␀␀␀␀␀␀i´␀␀ñ³␀␀ñ³␀␀"␀␀ÿ␀␀ÿ␀M³␀␀€␀␀␀␀␀␀´␀␀&³␀␀ñ³␀␀"␀␀ÿ␀␀ÿ␀×-‹␀␀␀␀␀␀ÄAm␀m␀—)␀␀Æÿ␀␀ÿ␀␀ô␀␀=␀␀␀␀␀\␀␀6Å␀␀6Å␀␀c␀␀␀ÿ␀␀ÿ␀2␀è␀␀␀␀␀è␀R␀R␀n␀Æÿ␀␀ÿ␀9-±␀␀␀␀␀␀“=àÃ␀␀àÃ␀␀q␀Æÿ␀␀ğ×␀␀␀␀␀␀	0;1;2;3;4␀␀Ÿ£␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀®İ␀␀-Ì␀	„␀␀␀␀␀␀<<<{␀Æÿ␀␀¯İ␀␀␀«EÑ␀„␀␀␀␀␀␀¹HÙE·HqC␀êÿ␀␀ÿ␀éw·␀„␀␀␀␀␀␀ÕxıwÔxì*␀␀Æÿ␀␀ÿ␀ù␀m„␀␀␀␀␀␀4␀ø␀ø␀n¼‡␀Æÿ␀␀ÿ␀…¬␀␀´␀„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t„␀␀␀␀␀␀Ü␀t␀Ü␀n¼‡␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀„␀␀␀␀␀␀.%€$0.w¼‡␀Æÿ␀␀…Ó␀␀␀N␀„␀␀␀␀␀␀£␀␀0␀n␀Æÿ␀␀|İ␀␀␀~¬␀␀(„␀␀␀␀␀␀V±␀␀†^¯␀␀d␀␀␀ÿ␀␀{İ␀␀␀ÿa´␀„␀␀␀␀␀␀‘<XbXbr