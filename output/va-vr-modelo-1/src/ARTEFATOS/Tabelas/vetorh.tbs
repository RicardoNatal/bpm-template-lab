(␀␀PROCEDURE SP_RETCRA(P_TIPCRA NUMBER(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_TECCRA NUMBER(1),P_NUMMAT VARCHAR2(15),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_CRACHA OUT NUMBER(12))
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_numcra      NUMBER(12);
  l_craext      NUMBER(12);
  l_crafis      NUMBER(12);
  l_straux      VARCHAR2(255);
  l_teccra	NUMBER(1);
BEGIN
  /* Inicializa */
  l_numcra := 0;
  l_craext := 0;  
  l_data_atual := CURDATE();
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  /* Verifica se crachá de Outras Unidades */
  IF   p_tipcol = 5 THEN
       BEGIN
         SELECT NUMCRA INTO l_numcra
           FROM R070HCH
          WHERE R070HCH.TIPCRA = p_tipcra AND
                R070HCH.NUMEMP = p_numemp AND
                R070HCH.NUMCAD = p_numcad AND
                (R070HCH.DATINI < l_data_atual OR
                (R070HCH.DATINI = l_data_atual AND R070HCH.HORINI <= l_hora_atual)) AND
                (R070HCH.DATFIM = l_data_zero OR
                 R070HCH.DATFIM > l_data_atual OR
                 (R070HCH.DATFIM = l_data_atual AND R070HCH.HORFIM > l_hora_atual));
       EXCEPTION
         WHEN TOO_MANY_ROWS THEN
           l_straux := 'Erro em R070HCH - TOO MANY ROWS. '||
                       'Tip.Cra.: '||CONVERT(NUMBER_TO_CHAR,p_tipcra)||
                       'Empresa : '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                       'Num.Cad.: '||CONVERT(NUMBER_TO_CHAR,p_numcad);
           RAISERROR 103 l_straux;
         WHEN NO_DATA_FOUND THEN
           l_numcra := 0;
         WHEN OTHERS THEN
           l_straux := 'ON-Line: Erro no SELECT em R070HCH. '||
                       'Tip.Cra.: '||CONVERT(NUMBER_TO_CHAR,p_tipcra)||
                       'Empresa : '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                       'Num.Cad.: '||CONVERT(NUMBER_TO_CHAR,p_numcad);
           RAISERROR 103 l_straux;
       END;
  ELSE
       /* Verifica se crachá de Aluno */
       IF   p_tipcol = 6 THEN
            BEGIN
              SELECT NUMCRA INTO l_numcra FROM R073HCH
              WHERE R073HCH.TIPCRA = p_tipcra AND
                  R073HCH.NUMMAT = p_nummat AND
                  (R073HCH.DATINI < l_data_atual OR
                   (R073HCH.DATINI = l_data_atual AND R073HCH.HORINI <= l_hora_atual)) AND
                  (R073HCH.DATFIM = l_data_zero OR
                   R073HCH.DATFIM > l_data_atual OR
                   (R073HCH.DATFIM = l_data_atual AND R073HCH.HORFIM > l_hora_atual));
            EXCEPTION
              WHEN TOO_MANY_ROWS THEN
                l_straux := 'Erro em R073HCH - TOO MANY ROWS. '||
                            'Tip.Cra.: '||CONVERT(NUMBER_TO_CHAR,p_tipcra)||
                            'Num.Mat.: '||p_nummat;
                RAISERROR 103 l_straux;
              WHEN NO_DATA_FOUND THEN
                l_numcra := 0;
              WHEN OTHERS THEN
                l_straux := 'ON-Line: Erro no SELECT em R073HCH. '||
                            'Tip.Cra.: '||CONVERT(NUMBER_TO_CHAR,p_tipcra)||
                            'Num.Mat.: '||p_nummat;
                RAISERROR 103 l_straux;
            END;
       ELSE
	 /* verifica se é crachá de responsável do aluno*/
       	 IF   p_tipcol = 7 THEN
            BEGIN
              SELECT NUMCRA INTO l_numcra FROM R073HCR
              WHERE R073HCR.TIPCRA = p_tipcra AND
                  R073HCR.TIPDOC = p_tipdoc AND
                  R073HCR.NUMDOC = p_numdoc AND
                  (R073HCR.DATINI < l_data_atual OR
                   (R073HCR.DATINI = l_data_atual AND R073HCR.HORINI <= l_hora_atual)) AND
                  (R073HCR.DATFIM = l_data_zero OR
                   R073HCR.DATFIM > l_data_atual OR
                   (R073HCR.DATFIM = l_data_atual AND R073HCR.HORFIM > l_hora_atual));
            EXCEPTION
              WHEN TOO_MANY_ROWS THEN
                l_straux := 'Erro em R073HCR - TOO MANY ROWS. '||
                            'Tip.Cra.: '||CONVERT(NUMBER_TO_CHAR,p_tipcra)||
                            'Tip.Doc.: '||CONVERT(NUMBER_TO_CHAR,p_tipdoc)||
                            'Num.Doc.: '||p_numdoc;
                RAISERROR 103 l_straux;
              WHEN NO_DATA_FOUND THEN
                l_numcra := 0;
              WHEN OTHERS THEN
                l_straux := 'ON-Line: Erro no SELECT em R073HCR. '||
                            'Tip.Cra.: '||CONVERT(NUMBER_TO_CHAR,p_tipcra)||
                            'Tip.Doc.: '||CONVERT(NUMBER_TO_CHAR,p_tipdoc)||
                            'Num.Doc.: '||p_numdoc;
                RAISERROR 103 l_straux;
            END;
	 ELSE
            BEGIN
                 SELECT NUMCRA INTO l_numcra
                   FROM R038HCH
                   WHERE R038HCH.TIPCRA = p_tipcra AND
                     R038HCH.NUMEMP = p_numemp AND
                     R038HCH.TIPCOL = p_tipcol AND
                     R038HCH.NUMCAD = p_numcad AND
                     (R038HCH.DATINI < l_data_atual OR
                     (R038HCH.DATINI = l_data_atual AND R038HCH.HORINI <= l_hora_atual)) AND
                     (R038HCH.DATFIM = l_data_zero OR
                     R038HCH.DATFIM > l_data_atual OR
                     (R038HCH.DATFIM = l_data_atual AND R038HCH.HORFIM > l_hora_atual));
            EXCEPTION
              WHEN TOO_MANY_ROWS THEN
                l_straux := 'Erro em R038HCH - TOO MANY ROWS. '||
                            'Tip.Cra.: '||CONVERT(NUMBER_TO_CHAR,p_tipcra)||
                            'Empresa : '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                            'Tip.Col.: '||CONVERT(NUMBER_TO_CHAR,p_tipcol)||
                            'Num.Cad.: '||CONVERT(NUMBER_TO_CHAR,p_numcad);
                RAISERROR 103 l_straux;
              WHEN NO_DATA_FOUND THEN
                l_numcra := 0;
              WHEN OTHERS THEN
                l_straux := 'ON-Line: Erro no SELECT em R038HCH. '||
                            'Tip.Cra.: '||CONVERT(NUMBER_TO_CHAR,p_tipcra)||
                            'Empresa : '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                            'Tip.Col.: '||CONVERT(NUMBER_TO_CHAR,p_tipcol)||
                            'Num.Cad.: '||CONVERT(NUMBER_TO_CHAR,p_numcad);
                RAISERROR 103 l_straux;
            END;
	 END IF;
       END IF;
  END IF;

  /* verifica crachá extraviado */
  BEGIN
       SELECT NUMCRA INTO l_craext FROM R090CEX WHERE NUMCRA = l_numcra;
  EXCEPTION
       WHEN OTHERS THEN l_craext := 0;
  END;
  IF   (l_numcra = l_craext) THEN
       l_numcra := 0;
  END IF;

  /* Busca Número Fisico do Crachá se Existir */
  p_cracha := l_numcra;
  IF   l_numcra <> 0 THEN
       SP_RETFIS(l_numcra , p_teccra, l_crafis OUT);
       p_cracha := l_crafis;
  END IF;
END		SENIOR;20
j+␀␀PROCEDURE SP_RETCRA(P_TIPCRA NUMBER(1),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_TECCRA NUMBER(1),P_NUMMAT VARCHAR2(15),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_CRACHA OUT NUMBER(12))
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_numcra      NUMBER(12);
  l_craext      NUMBER(12);
  l_crafis      NUMBER(12);
  l_straux      VARCHAR2(255);
  l_teccra	    NUMBER(1);
  l_usacpd      CHAR(1);
BEGIN
  /* Inicializa */
  l_numcra := 0;
  l_craext := 0;  
  l_data_atual := CURDATE();
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  
  /*Visitantes */
  IF (p_tipcol = 4) THEN
      BEGIN
      	  SELECT NUMCRA INTO l_numcra
           FROM R090HCH
          WHERE R090HCH.TIPDOC = p_tipdoc AND
                R090HCH.NUMDOC = p_numdoc AND
                (R090HCH.DATINI < l_data_atual OR
                (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
                (R090HCH.DATFIM = l_data_zero OR
                 R090HCH.DATFIM > l_data_atual OR
                 (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM > l_hora_atual));
      EXCEPTION
          WHEN TOO_MANY_ROWS THEN
           l_straux := 'Erro em R090HCH - TOO MANY ROWS. '||
                       'Tip.Doc.: '||CONVERT(NUMBER_TO_CHAR,p_tipdoc)||
                       'Num.Doc.: '||CONVERT(NUMBER_TO_CHAR,p_numdoc);
           RAISERROR 103 l_straux;
         WHEN NO_DATA_FOUND THEN
           l_numcra := 0;
         WHEN OTHERS THEN
           l_straux := 'ON-Line: Erro no SELECT em R090HCH. '||
                       'Tip.Doc.: '||CONVERT(NUMBER_TO_CHAR,p_tipdoc)||
                       'Num.Doc.: '||CONVERT(NUMBER_TO_CHAR,p_numdoc);
           RAISERROR 103 l_straux;
      END;
      
      /*Se não encontrou procura nos visitantes de pacientes */
      IF (l_numcra = 0) THEN
      	  BEGIN
      	  SELECT NUMCRA INTO l_numcra
           FROM R097VMV
          WHERE R097VMV.TIPDOC = p_tipdoc AND
                R097VMV.NUMDOC = p_numdoc AND
                (R097VMV.DATENT < l_data_atual OR
                (R097VMV.DATENT = l_data_atual AND R097VMV.HORENT <= l_hora_atual)) AND
                (R097VMV.DATSAI = l_data_zero OR
                 R097VMV.DATSAI > l_data_atual OR
                 (R097VMV.DATSAI = l_data_atual AND R097VMV.HORSAI >= l_hora_atual));
      EXCEPTION
          WHEN TOO_MANY_ROWS THEN
           l_straux := 'Erro em R097VMV - TOO MANY ROWS. '||
                       'Tip.Doc.: '||CONVERT(NUMBER_TO_CHAR,p_tipdoc)||
                       'Num.Doc.: '||CONVERT(NUMBER_TO_CHAR,p_numdoc);
           RAISERROR 103 l_straux;
         WHEN NO_DATA_FOUND THEN
           l_numcra := 0;
         WHEN OTHERS THEN
           l_straux := 'ON-Line: Erro no SELECT em R097VMV. '||
                       'Tip.Doc.: '||CONVERT(NUMBER_TO_CHAR,p_tipdoc)||
                       'Num.Doc.: '||CONVERT(NUMBER_TO_CHAR,p_numdoc);
           RAISERROR 103 l_straux;
      END;
      END IF;
  ELSE
  /* Verifica se crachá de Outras Unidades */
  IF (p_tipcol = 5) THEN
       BEGIN
         SELECT NUMCRA INTO l_numcra
           FROM R070HCH
          WHERE R070HCH.TIPCRA = p_tipcra AND
                R070HCH.NUMEMP = p_numemp AND
                R070HCH.NUMCAD = p_numcad AND
                (R070HCH.DATINI < l_data_atual OR
                (R070HCH.DATINI = l_data_atual AND R070HCH.HORINI <= l_hora_atual)) AND
                (R070HCH.DATFIM = l_data_zero OR
                 R070HCH.DATFIM > l_data_atual OR
                 (R070HCH.DATFIM = l_data_atual AND R070HCH.HORFIM > l_hora_atual));
       EXCEPTION
         WHEN TOO_MANY_ROWS THEN
           l_straux := 'Erro em R070HCH - TOO MANY ROWS. '||
                       'Tip.Cra.: '||CONVERT(NUMBER_TO_CHAR,p_tipcra)||
                       'Empresa : '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                       'Num.Cad.: '||CONVERT(NUMBER_TO_CHAR,p_numcad);
           RAISERROR 103 l_straux;
         WHEN NO_DATA_FOUND THEN
           l_numcra := 0;
         WHEN OTHERS THEN
           l_straux := 'ON-Line: Erro no SELECT em R070HCH. '||
                       'Tip.Cra.: '||CONVERT(NUMBER_TO_CHAR,p_tipcra)||
                       'Empresa : '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                       'Num.Cad.: '||CONVERT(NUMBER_TO_CHAR,p_numcad);
           RAISERROR 103 l_straux;
       END;
  ELSE
       /* Verifica se crachá de Aluno */
       IF (p_tipcol = 6) THEN
            BEGIN
              SELECT NUMCRA INTO l_numcra FROM R073HCH
              WHERE R073HCH.TIPCRA = p_tipcra AND
                  R073HCH.NUMMAT = p_nummat AND
                  (R073HCH.DATINI < l_data_atual OR
                   (R073HCH.DATINI = l_data_atual AND R073HCH.HORINI <= l_hora_atual)) AND
                  (R073HCH.DATFIM = l_data_zero OR
                   R073HCH.DATFIM > l_data_atual OR
                   (R073HCH.DATFIM = l_data_atual AND R073HCH.HORFIM > l_hora_atual));
            EXCEPTION
              WHEN TOO_MANY_ROWS THEN
                l_straux := 'Erro em R073HCH - TOO MANY ROWS. '||
                            'Tip.Cra.: '||CONVERT(NUMBER_TO_CHAR,p_tipcra)||
                            'Num.Mat.: '||p_nummat;
                RAISERROR 103 l_straux;
