PROCEDURE SP_R034FUN_HIST(P_TIPALT VARCHAR2(255),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(4),P_NUMCAD NUMBER(9),P_NOMFUN VARCHAR2(255),P_APEFUN VARCHAR2(255),P_TIPSEX VARCHAR2(255),P_RACCOR NUMBER(4),P_ESTCIV NUMBER(4),P_GRAINS NUMBER(4),P_DATNAS DATE,P_CODNAC NUMBER(4),P_NUMCTP NUMBER(9),P_SERCTP VARCHAR2(255),P_DIGCAR VARCHAR2(255),P_ESTCTP VARCHAR2(255),P_DEXCTP DATE,P_NUMCPF NUMBER(18),P_NUMPIS NUMBER(18),P_DCDPIS DATE,P_MOVSEF VARCHAR2(255),P_IRRISE VARCHAR2(255),P_APOIDA VARCHAR2(255),P_EMTCAR VARCHAR2(255),P_NUMINS NUMBER(18),P_CODDEF NUMBER(4),P_DEFFIS VARCHAR2(255),P_BENREA VARCHAR2(255),P_NMFUN1 VARCHAR2(255),P_NMFUN2 VARCHAR2(255),P_NMFUN3 VARCHAR2(255),P_NMFUN4 VARCHAR2(255),P_CODPRO NUMBER(9),P_ANOCHE NUMBER(4),P_VISEST NUMBER(4),P_DVLEST DATE,P_REGEST VARCHAR2(255),P_DVLCTP DATE,P_DOCEST NUMBER(4),P_DATCHE DATE,P_NUMPSP VARCHAR2(255),P_DATADM DATE,P_TIPADM NUMBER(4),P_TIPCON NUMBER(4),P_TIPOPC VARCHAR2(255),P_DATOPC DATE,P_CONFGT NUMBER(18),P_MODPAG VARCHAR2(255),P_CODBAN NUMBER(4),P_CODAGE NUMBER(9),P_CONBAN NUMBER(18),P_DIGBAN VARCHAR2(255),P_PERPAG VARCHAR2(255),P_RECADI VARCHAR2(255),P_REC13S VARCHAR2(255),P_LISRAI VARCHAR2(255),P_EMICAR VARCHAR2(255),P_CODCHA VARCHAR2(255),P_NUMCRA NUMBER(18),P_OUTCON VARCHAR2(255),P_OUTTET VARCHAR2(255),P_OUTEMP NUMBER(4),P_OUTTIP NUMBER(4),P_OUTCAD NUMBER(9),P_PERDES NUMBER(5,2),P_PERISS NUMBER(5,2),P_FAIINS NUMBER(4),P_OPCATU VARCHAR2(255),P_DCTINS NUMBER(4),P_CADFOL VARCHAR2(255),P_CATTER VARCHAR2(255),P_FATTPO NUMBER(5,2),P_EMPRES NUMBER(4),P_TIPRES NUMBER(4),P_CADRES NUMBER(9),P_TIPTER NUMBER(4),P_CAUADV VARCHAR2(255),P_INSCUR NUMBER(4),P_ASSPPR NUMBER(4),P_DATPPR DATE,P_VERINT VARCHAR2(255),P_CONTOV VARCHAR2(255),P_APUPFS VARCHAR2(255),P_TIPPFS VARCHAR2(255),P_RATPFS VARCHAR2(255),P_GPSTRI DATE,P_DEDCAR VARCHAR2(255),P_CODFOR NUMBER(9),P_RATEVE VARCHAR2(255),P_PERTRA NUMBER(5,2),P_PERIRT NUMBER(5,2),P_DEDINS NUMBER,P_TIPSRV NUMBER(4),P_BUSHOR NUMBER(4),P_RECGRA VARCHAR2(255),P_CODIDN NUMBER(18),P_TPCTBA NUMBER(4),P_CODLIM NUMBER(4),P_RETTRP VARCHAR2(255), P_SEQHIS OUT NUMBER(18))
 IS
