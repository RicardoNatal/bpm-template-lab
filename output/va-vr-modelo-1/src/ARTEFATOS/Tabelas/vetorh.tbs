TRIGGER R034CPL_ED AFTER DELETE ON R034CPL FOR EACH ROW

DECLARE
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_online           BOOLEAN;
  l_idtpes           VARCHAR2(23);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);

  /* Para store procedures de histórico */
  l_seqhis       NUMBER(15);
  l_tipalt       VARCHAR2(1);
BEGIN

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116*/
  RS_UPDCURCOMP(0, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD);

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R034CPL');

  IF (l_auditoria = 'S') THEN
      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg
                FROM R034CPL_AUD
               WHERE NUMEMP = :OLD.NUMEMP AND
                     TIPCOL = :OLD.TIPCOL AND
                     NUMCAD = :OLD.NUMCAD;
           EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
           INSERT INTO R034CPL_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,CODPAI,CODEST,CODCID,CODBAI,ENDCEP,ENDRUA,ENDNUM,ENDCPL,
                                    PAINAS,ESTNAS,CCINAS,NUMCID,EMICID,CIDEMI,ESTCID,DEXCID,EMAPAR,EMACOM,NUMTEL,NUMRAM,DDDTEL,
                                    DDITEL,NUMCNH,CATCNH,DATCNH,VENCNH,NUMPSP,EMIPSP,ESTPSP,DEMPSP,DVAPSP,PAIPSP)
                            VALUES (l_seqreg,l_verseq,:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.CODPAI,:OLD.CODEST,:OLD.CODCID,:OLD.CODBAI,
                                   :OLD.ENDCEP,:OLD.ENDRUA,:OLD.ENDNUM,:OLD.ENDCPL,:OLD.PAINAS,:OLD.ESTNAS,:OLD.CCINAS,:OLD.NUMCID,
                                   :OLD.EMICID,:OLD.CIDEMI,:OLD.ESTCID,:OLD.DEXCID,:OLD.EMAPAR,:OLD.EMACOM,:OLD.NUMTEL,:OLD.NUMRAM,
                                   :OLD.DDDTEL,:OLD.DDITEL,:OLD.NUMCNH,:OLD.CATCNH,:OLD.DATCNH,:OLD.VENCNH,:OLD.NUMPSP,:OLD.EMIPSP,
                                   :OLD.ESTPSP,:OLD.DEMPSP,:OLD.DVAPSP,:OLD.PAIPSP);

          SP_AUDGENREG(l_seqreg,l_verseq,'R034CPL','DELETE');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  /* Atualiza rotinas do acesso*/
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) THEN
       R034CPL_ATUCON('D', :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DDITEL, :OLD.DDDTEL, :OLD.NUMTEL);
  END IF;

    /* Geração do histórico da ficha complementar */
  l_tipalt := 'E';
  SP_R034CPL_HIST(l_tipalt, :OLD.numemp, :OLD.tipcol, :OLD.numcad, :OLD.ficreg, :OLD.codpai, :OLD.codest, :OLD.codcid, :OLD.codbai, :OLD.codrad, :OLD.nomrad, :OLD.endcep, :OLD.tiplgr, 
  		:OLD.endrua, :OLD.endnum, :OLD.endcpl, :OLD.numtel, :OLD.painas, :OLD.estnas, :OLD.ccinas, :OLD.docidn, :OLD.numcid, :OLD.emicid, :OLD.cidemi, :OLD.estcid, :OLD.dexcid, 
  		:OLD.zonele, :OLD.secele, :OLD.numele, :OLD.numcnh, :OLD.catcnh, :OLD.datcnh, :OLD.vencnh, :OLD.numres, :OLD.catres, :OLD.codprf, :OLD.regcon, :OLD.durcon, :OLD.procon, 
  		:OLD.proexm, :OLD.ultexm, :OLD.codqua, :OLD.estpad, :OLD.clasal, :OLD.nivsal, :OLD.matipe, :OLD.altipe, :OLD.sitipe, :OLD.tippsa, :OLD.codpsa, :OLD.matpsa, :OLD.incpsa, 
  		:OLD.excpsa, :OLD.codrlr, :OLD.codcas, :OLD.numram, :OLD.pretrb, :OLD.andtrb, :OLD.nroarm, :OLD.iniarm, :OLD.fimarm, :OLD.emapar, :OLD.emacom, :OLD.catvei, :OLD.sitreg, 
  		:OLD.nomcom, :OLD.nomsoc, :OLD.datven, :OLD.dddtel, :OLD.dditel, :OLD.nmddi2, :OLD.nmddd2, :OLD.nmtel2, :OLD.nmram2, :OLD.nifext, :OLD.maspsa, :OLD.nasviv, :OLD.carsus, 
  		:OLD.tipcer, :OLD.demciv, :OLD.matccv, :OLD.matciv, :OLD.livciv, :OLD.folciv, :OLD.carciv, :OLD.estciv, :OLD.cidciv, :OLD.numpsp, :OLD.emipsp, :OLD.estpsp, :OLD.dempsp, 
  		:OLD.dvapsp, :OLD.paipsp, :OLD.numpor, :OLD.datpor, :OLD.numric, :OLD.estric, :OLD.emiric, l_seqhis OUT);
  		
  /* Atualização do histórico da ficha complementar criada devido limite de parâmetros no PostgreSQL */		
  SP_R034CPL_HIST_UP(l_seqhis, :OLD.numemp, :OLD.tipcol, :OLD.numcad, :OLD.cidric, :OLD.dexric, :OLD.seqreg, :OLD.datexp, :OLD.orgcnh);  

  /* PENDÊNCIA SAMSenior */
  SP_RETIDTPES(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, NULL, NULL, NULL, NULL, l_IDTPES OUT); 
  SP_SAM_PENDENCIES(1,3,l_idtpes);
  
  /* Geração de logs Ficha Complementar (Tabela: R034CPL)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 109;     /* Ficha Complementar (Tabela: R034CPL)*/
  l_codtpa := 329;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034CPL_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034CPL_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

