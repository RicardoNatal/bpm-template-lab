                END IF;
              END IF;
            END IF;
          END IF;
        END IF;
      END IF;
      UPDATE R900LCN SET EVTPOS = VEVTPOS, MAXPOS = VMAXPOS;
      FETCH CUR_R900LCN INTO VEVTPOS, VMAXPOS;
    END LOOP;
    EXCEPTION WHEN OTHERS THEN
      CLOSE CUR_R900LCN;
      RAISE;
    END;
  CLOSE CUR_R900LCN;
END;
