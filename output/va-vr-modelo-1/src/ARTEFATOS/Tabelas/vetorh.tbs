TRIGGER R030EES_SU AFTER UPDATE ON R030EES FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs cCategoriaEstabelecimentoFilial*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 61;     /* cCategoriaEstabelecimentoFilial*/
  l_codtpa := 234;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFil <> :NEW.CodFil)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.RegPon <> :NEW.RegPon)
   OR (:OLD.ConPcd <> :NEW.ConPcd)
   OR (:OLD.ProPcd <> :NEW.ProPcd)
   OR (:OLD.ConApr <> :NEW.ConApr)
   OR (:OLD.ProEEd <> :NEW.ProEEd)
   OR (:OLD.EntEEd <> :NEW.EntEEd) 
   OR (:OLD.CnpRes <> :NEW.CnpRes)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030EES_SU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030EES_SU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDREGPON', CONVERT(NUMBER_TO_CHAR, :OLD.REGPON));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWREGPON', CONVERT(NUMBER_TO_CHAR, :NEW.REGPON));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONPCD', CONVERT(NUMBER_TO_CHAR, :OLD.CONPCD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONPCD', CONVERT(NUMBER_TO_CHAR, :NEW.CONPCD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPROPCD', CONVERT(NUMBER_TO_CHAR, :OLD.PROPCD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPROPCD', CONVERT(NUMBER_TO_CHAR, :NEW.PROPCD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONAPR', CONVERT(NUMBER_TO_CHAR, :OLD.CONAPR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONAPR', CONVERT(NUMBER_TO_CHAR, :NEW.CONAPR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPROEED', CONVERT(NUMBER_TO_CHAR, :OLD.PROEED));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPROEED', CONVERT(NUMBER_TO_CHAR, :NEW.PROEED));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENTEED', :OLD.ENTEED);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENTEED', :NEW.ENTEED);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCNPRES', CONVERT(NUMBER_TO_CHAR, :OLD.CNPRES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENTEED', CONVERT(NUMBER_TO_CHAR, :NEW.CNPRES));
      END;
    END IF; 
  END IF; 
END␀Ò␀␀		SENIOR;0
␀␀ 

TRIGGER R030EES_EU BEFORE UPDATE ON R030EES FOR EACH ROW
DECLARE
	l_Valor VARCHAR2(2000);
	l_Valido BOOLEAN;
	l_ProximaData DATE;
	l_AlterouRegistro_S1005 BOOLEAN;
	l_Where VARCHAR(2000);
	l_EmpresaStr VARCHAR(11);
	l_FilialStr VARCHAR(11);
	l_infoFacult BOOLEAN;
	l_SimplificaoESocial BOOLEAN;
	l_VersaoESocial NUMBER;
BEGIN
/* e-Social -> S-1005 */
	l_Valor := '';
	l_ProximaData := '31/12/1900,00:00:00';
	l_AlterouRegistro_S1005 := FALSE;
	l_infoFacult := TRUE;
	l_SimplificaoESocial := FALSE;
	l_VersaoESocial := 0;

	/* Só monitora o campo se o cliente opta por enviar as informações facultativas	*/
	SP_ESOCIAL_INFO(:NEW.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);

	/*infoPCD - Nº Processo PCD*/
	SP_VALUPDATE_NUM(:OLD.PROPCD, :NEW.PROPCD, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_AlterouRegistro_S1005 := TRUE;
	END IF;
	
	
    IF (l_SimplificaoESocial = TRUE) THEN
		/*CnpRes*/
		SP_VALUPDATE_NUM(:OLD.CNPRES, :NEW.CNPRES, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			  l_AlterouRegistro_S1005 := TRUE;
		END IF;
    END IF;

	/*infoApr*/
	SP_VALUPDATE_NUM(:OLD.PROEED, :NEW.PROEED, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_AlterouRegistro_S1005 := TRUE;
	END IF;

	IF (l_infoFacult = TRUE AND l_SimplificaoESocial = FALSE) THEN
		/*infoPCD - Ind. Contratação PCD*/
		SP_VALUPDATE_NUM(:OLD.CONPCD, :NEW.CONPCD, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_AlterouRegistro_S1005 := TRUE;
		END IF;

		/*infoApr - Ind. Contratação Aprendiz*/
		SP_VALUPDATE_NUM(:OLD.CONAPR, :NEW.CONAPR, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_AlterouRegistro_S1005 := TRUE;
		END IF;

		/*contEntEd*/
		SP_VALUPDATE_DES(:OLD.ENTEED, :NEW.ENTEED, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_AlterouRegistro_S1005 := TRUE;
		END IF;

		/*infoTrab*/
		SP_VALUPDATE_NUM(:OLD.REGPON, :NEW.REGPON, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_AlterouRegistro_S1005 := TRUE;
		END IF;
	END IF;

	IF (l_AlterouRegistro_S1005 = TRUE) THEN
		l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP);
		l_FilialStr := CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL);

		l_Where := 'NUMEMP = ' || l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr;
		SP_PROXIMOHIST('DATALT', 'R030EES', l_Where, :NEW.DATALT, l_ProximaData OUT);
		SP_CONCATENAR_NUM('CODFIL', :NEW.CODFIL, l_Valor OUT);

		SP_E_SOCIAL('S-1005', 'R030EES', 'T', 'A', :NEW.DATALT, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030EES_EU');
	END IF;
	/* e-Social -> S-1005 */
END␀Ò␀␀		SENIOR;0•␀␀

