␀␀

TRIGGER R088AGF_EI AFTER INSERT ON R088AGF FOR EACH ROW

DECLARE
l_online       BOOLEAN;
  l_cravei       NUMBER(12);
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_froonl       BOOLEAN;
  l_libvei       NUMBER(1);  
  l_data_zero    DATE;
  l_comando_nulo BOOLEAN;
  l_datfim       DATE;
  l_horfim       NUMBER;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_data_histo   DATE;
  l_hora_histo   NUMBER(4);
BEGIN
	SP_VerOnLine(l_online OUT);
	SP_UsaFronline(l_froonl OUT, l_libvei OUT);
	l_data_zero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_data_atual := CURDATE();
	l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
	l_comando_nulo:=FALSE;
	IF   (l_online = TRUE) AND (l_froonl = TRUE) AND  (l_libvei = 2) THEN
		 BEGIN
			SELECT NUMCRA, DATFIM, HORFIM INTO l_cravei, l_data_histo, l_hora_histo
			  FROM R088HCH
			  WHERE PLAVEI = :NEW.PLAVEI AND
					(DATINI < :NEW.DATAGF OR (DATINI = :NEW.DATAGF AND HORINI <= :NEW.HORAGF)) AND
					(DATFIM > :NEW.DATAGF OR DATFIM = l_data_zero OR (DATFIM = :NEW.DATAGF AND HORFIM >= :NEW.HORAGF)) AND
					STAACC = 1;
		 EXCEPTION
			 WHEN TOO_MANY_ROWS THEN
				  RAISERROR 103 'Erro no R088HCH - TOO MANY ROWS.';
			 WHEN NO_DATA_FOUND THEN
				 l_comando_nulo:=TRUE;
			 WHEN OTHERS THEN
				  RAISERROR 103 'Erro no SELECT em R088HCH.';
		 END;
		 /* Se tiver crachá provísório vale ele. senão pegar o titular */
		 SP_RETCRA (2, :NEW.EMPCON, :NEW.TCLCON, :NEW.CADCON, 0,'',0,'',l_crapro OUT);
		 IF   (l_crapro = 0)  THEN
			SP_RETCRA (1, :NEW.EMPCON, :NEW.TCLCON, :NEW.CADCON,0,'',0,'', l_cracha OUT);
		 ELSE  
			l_cracha := l_crapro;
		 END IF;

		 IF (l_cracha <> 0) AND (l_cravei <> 0) THEN

			l_datfim := :NEW.DATRET;
			l_horfim := :NEW.HORRET;
			
			/* se a data for zero ou maior que 31/12/2050, recebe 31/12/2050 */
			IF (l_data_histo = l_data_zero) OR (l_data_histo > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
				l_data_histo := DATETIME(31, 12, 2050, 0, 0, 0);
				l_hora_histo := 1439;
			END IF;
			
			/* se a data for zero ou maior que 31/12/2050, recebe 31/12/2050 */
			IF (l_datfim = l_data_zero) OR (l_datfim > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
			   l_datfim := DATETIME(31, 12, 2050, 0, 0, 0);
			   l_horfim := 1439;
			END IF;
			
			/*Valida as datas do histórico e agendamento*/
			IF ( (l_datfim > l_data_histo) OR (l_datfim = l_data_histo AND l_horfim > l_hora_histo) ) THEN
				l_datfim := l_data_histo;
				l_horfim := l_hora_histo;
			END IF;

			/* SE FOR AGENDAMENTO EM TEMPO PRESENTE, ATUALIZA A CONTVEI */
			IF  (:NEW.STAATU = 1) THEN
				SP_VEIPESCON('I', l_cravei, l_cracha, 0, :NEW.PLAVEI, 
							 l_datfim, l_horfim, :NEW.TCLCON, :NEW.EMPCON, :NEW.TCLCON, :NEW.CADCON, 0, '');
			END IF;
		 END IF;
	END IF;
END␀=Ü␀␀		SENIOR;0Ë-␀␀TRIGGER R088AGF_EU AFTER UPDATE ON R088AGF FOR EACH ROW

DECLARE
l_online       BOOLEAN;
  l_cravei       NUMBER(12);
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_libvei       NUMBER(1);
  l_situa        NUMBER(1);
  l_data_zero    DATE;
  l_data_histo   DATE;
  l_hora_histo   NUMBER;
  l_comando_nulo BOOLEAN;
  l_froonl       BOOLEAN;
  l_usuonl       BOOLEAN;
  l_datfim       DATE;
  l_horfim       NUMBER;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_datval       DATE;
  l_horval       NUMBER(4);
  l_crausu       NUMBER(12);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);

  CURSOR c_r088usu IS SELECT TIPCLB,NUMEMP,TIPCOL,NUMCAD,CADOCR,DATVAL,HORVAL
                           FROM R088USU
                           WHERE PLAVEI = :NEW.PLAVEI
                           AND DATALT <= :NEW.DATAGF
                           AND ACELIV = 'S';
       TYPE t_r088usu IS RECORD(
                TIPCLB   R088USU.TipClb%TYPE,
                NUMEMP   R088USU.NumEmp%TYPE,
                TIPCOL   R088USU.TipCol%TYPE,
                NUMCAD   R088USU.NumCad%TYPE,
                CADOCR   R088USU.CadOcr%TYPE,
                DATVAL   R088USU.DatVal%TYPE,
                HORVAL   R088USU.HorVal%TYPE);
       l_r088usu t_r088usu;

BEGIN
    SP_VerOnLine(l_online OUT);
    SP_UsaFronline(l_froonl OUT, l_libvei OUT);
    SP_Usuonline(l_froonl OUT, l_usuonl OUT);
    l_data_zero := DATETIME(31, 12, 1900, 0, 0, 0);
    l_data_atual := CURDATE();
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_situa := 0;
    IF   (l_online = TRUE) AND (l_froonl = TRUE) AND  (l_libvei = 2) THEN
         l_comando_nulo:=FALSE;
         BEGIN
            SELECT NUMCRA, DATFIM, HORFIM INTO l_cravei, l_data_histo, l_hora_histo
              FROM R088HCH
              WHERE PLAVEI = :NEW.PLAVEI AND
                    (DATINI < :NEW.DATAGF OR (DATINI = :NEW.DATAGF AND HORINI <= :NEW.HORAGF)) AND
                    (DATFIM > :NEW.DATAGF OR DATFIM = l_data_zero OR (DATFIM = :NEW.DATAGF AND HORFIM >= :NEW.HORAGF)) AND
                    STAACC = 1;
         EXCEPTION
         WHEN TOO_MANY_ROWS THEN
              RAISERROR 103 'Erro no R088HCH - TOO MANY ROWS.';
         WHEN NO_DATA_FOUND THEN
             l_comando_nulo:=TRUE;
         WHEN OTHERS THEN
              RAISERROR 103 'Erro no SELECT em R088HCH.';
         END;

         /* se a data for zero ou maior que 31/12/2050, recebe 31/12/2050 */
         IF (l_data_histo = l_data_zero) OR (l_data_histo > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
            l_data_histo := DATETIME(31, 12, 2050, 0, 0, 0);
            l_hora_histo := 1439;
         END IF;

         /* SE NÃO FOR MOVIMENTAÇÃO DE RETORNO, ATUALIZA NA CONTVEI COM SITUA 0 */
         IF (:NEW.VEIUTI <> 'R') THEN
             l_datfim := :NEW.DATRET;
             l_horfim := :NEW.HORRET;

             /* se a data for zero ou maior que 31/12/2050, recebe 31/12/2050 */
             IF (l_datfim = l_data_zero) OR (l_datfim > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
                l_datfim := DATETIME(31, 12, 2050, 0, 0, 0);
                l_horfim := 1439;
             END IF;
			 /*Valida as datas do histórico e agendamento*/
			 IF ( (l_datfim > l_data_histo) OR (l_datfim = l_data_histo AND l_horfim > l_hora_histo) ) THEN
				l_datfim := l_data_histo;
                l_horfim := l_hora_histo;
			 END IF;

                IF  (l_usuonl = TRUE) AND (l_online = TRUE) THEN

                    /* Chama procedure para alteração */
                    FOREACH c_r088usu INTO  l_r088usu.TipClb,
                                            l_r088usu.NumEmp,
                                            l_r088usu.TipCol,
                                            l_r088usu.NumCad,
                                            l_r088usu.CadOcr,
                                            l_r088usu.DatVal,
                                            l_r088usu.HorVal
                 LOOP
                     IF (l_r088usu.TipClb = 1) THEN
                        /*  Busca pelo crachá do colaborador. */
                        SP_RETCRA (2, l_r088usu.numemp, l_r088usu.tipcol, l_r088usu.numcad, 0,'',0,'',l_crapro OUT);
                        IF   (l_crapro = 0)  THEN
                              SP_RETCRA (1, l_r088usu.numemp, l_r088usu.tipcol, l_r088usu.numcad,0,'',0,'', l_cracha OUT);
                        ELSE l_cracha := l_crapro;
                        END IF;
                        l_numemp := l_r088usu.numemp;
                        l_tipcol := l_r088usu.tipcol;
                        l_numcad := l_r088usu.numcad;
                     ELSE
                        /*  Busca pelo crachá do colaborador. */
                        SP_RETCRA (2, l_r088usu.numemp, 5, l_r088usu.cadocr, 0,'',0,'',l_crapro OUT);
                        IF   (l_crapro = 0)  THEN
                              SP_RETCRA (1, l_r088usu.numemp, 5, l_r088usu.cadocr,0,'',0,'', l_cracha OUT);
                        ELSE l_cracha := l_crapro;
                        END IF;
                        l_numemp := l_r088usu.numemp;
                        l_tipcol := 5;
                        l_numcad := l_r088usu.cadocr;
                     END IF;

                     IF (l_r088usu.DATVAL = l_data_zero) OR (l_r088usu.DATVAL > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
                       l_r088usu.DATVAL := DATETIME(31, 12, 2050, 0, 0, 0);
                       l_r088usu.horval := 1439;
                     END IF;

                     IF  (:NEW.STAATU = 1)  THEN
                         l_situa := 1;
                     ELSE
                         IF (:NEW.STAATU = 2)  THEN
                            l_situa := 0;
                         END IF;
                     END IF;

                     l_crausu := l_cracha;

                     /* PEGA A MENOR DATA FINAL ENTRE A DATA DO HISTORICO E A DO CADASTRO DE USUARIOS */
                     IF  (l_data_histo < l_r088usu.DATVAL) OR ((l_data_histo = l_r088usu.DATVAL AND l_hora_histo <= l_r088usu.horval)) THEN
                         l_datval := l_data_histo;
                         l_horval := l_hora_histo;
                     ELSE
                         l_datval := l_r088usu.DATVAL;
                         l_horval := l_r088usu.horval;
                     END IF;


                     IF (l_cravei <> 0) AND (l_cracha <> 0) THEN                    
                         SP_VEIPESCON('U', l_cravei, l_crausu, l_situa, :NEW.PLAVEI,
                                      l_datval, l_horval, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
                     END IF;
                 END LOOP;
             END IF;
             /* Se tiver crachá provísório vale ele. senão pegar o titular */
             SP_RETCRA (2, :NEW.EMPCON, :NEW.TCLCON, :NEW.CADCON, 0,'',0,'',l_crapro OUT);
             IF   (l_crapro = 0)  THEN
                  SP_RETCRA (1, :NEW.EMPCON, :NEW.TCLCON, :NEW.CADCON,0,'',0,'', l_cracha OUT);
             ELSE l_cracha := l_crapro;
             END IF;

             /* ATUALIZA A CONTVEI */
             IF (l_cravei <> 0) AND (l_cracha <> 0) THEN
                IF  (:NEW.STAATU = 1)  THEN                
                    SP_VEIPESCON('U', l_cravei, l_cracha, 0, :NEW.PLAVEI, 
                                 l_datfim, l_horfim, :NEW.TCLCON, :NEW.EMPCON, :NEW.TCLCON, :NEW.CADCON, 0, '');
                ELSE
                    IF (:NEW.STAATU = 2)  THEN
                        SP_VEIPESCON('U', l_cravei, l_cracha, 1, :NEW.PLAVEI,
                                     l_datfim, l_horfim, :NEW.TCLCON, :NEW.EMPCON, :NEW.TCLCON, :NEW.CADCON, 0, '');
						IF (l_crausu > 0) THEN
                            SP_VEIPESCON('U', l_cravei, l_crausu, l_situa, :NEW.PLAVEI,
                                         l_datval, l_horval, :NEW.TCLCON, :NEW.EMPCON, :NEW.TCLCON, :NEW.CADCON, 0, '');
                        END IF;
                    END IF;
                END IF;
             END IF;
         
         /* SE TIVER RETORNANDO, ATIVA O USUARIO VIP NA CONTVEI */
         ELSE
             IF  (l_usuonl = TRUE) AND (l_online = TRUE) THEN

                 /* Chama procedure para alteração */
                 FOREACH c_r088usu INTO  l_r088usu.TipClb,
                                         l_r088usu.NumEmp,
                                         l_r088usu.TipCol,
                                         l_r088usu.NumCad,
                                         l_r088usu.CadOcr,
                                         l_r088usu.DatVal,
                                         l_r088usu.HorVal
                 LOOP
                     IF (l_r088usu.TipClb = 1) THEN
                        /*  Busca pelo crachá do colaborador. */
                        SP_RETCRA (2, l_r088usu.numemp, l_r088usu.tipcol, l_r088usu.numcad, 0,'',0,'',l_crapro OUT);
                        IF   (l_crapro = 0)  THEN
                              SP_RETCRA (1, l_r088usu.numemp, l_r088usu.tipcol, l_r088usu.numcad,0,'',0,'', l_cracha OUT);
                        ELSE l_cracha := l_crapro;
                        END IF;
                        l_numemp := l_r088usu.numemp;
                        l_tipcol := l_r088usu.tipcol;
                        l_numcad := l_r088usu.numcad;
                     ELSE
                        /*  Busca pelo crachá do colaborador. */
                        SP_RETCRA (2, l_r088usu.numemp, 5, l_r088usu.cadocr, 0,'',0,'',l_crapro OUT);
                        IF   (l_crapro = 0)  THEN
                              SP_RETCRA (1, l_r088usu.numemp, 5, l_r088usu.cadocr,0,'',0,'', l_cracha OUT);
                        ELSE l_cracha := l_crapro;
                        END IF;
                        l_numemp := l_r088usu.numemp;
                        l_tipcol := 5;
                        l_numcad := l_r088usu.cadocr;
                     END IF;

                     l_datfim := :NEW.DATRET;
                     l_horfim := :NEW.HORRET;
                     IF (l_datfim = l_data_zero) OR (l_datfim > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
                       l_datfim := DATETIME(31, 12, 2050, 0, 0, 0);
                       l_horfim := 1439;
                     END IF;
 

                     IF (l_r088usu.DATVAL = l_data_zero) OR (l_r088usu.DATVAL > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
                       l_r088usu.DATVAL := DATETIME(31, 12, 2050, 0, 0, 0);
                       l_r088usu.horval := 1439;
                     END IF;

                     SP_VEIPESCON('U', l_cravei, l_cracha, 1, :NEW.PLAVEI,
                                  l_datfim, l_horfim, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
                     /* PEGA A MENOR DATA FINAL ENTRE A DATA DO HISTORICO E A DO CADASTRO DE USUARIOS */
                     IF  (l_data_histo < l_r088usu.DATVAL) OR ((l_data_histo = l_r088usu.DATVAL AND l_hora_histo <= 1439)) THEN
                         SP_VEIPESCON('U', l_cravei, l_cracha, 0, :NEW.PLAVEI,
                                      l_data_histo, l_hora_histo, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
                     ELSE 
                         SP_VEIPESCON('U', l_cravei, l_cracha, 0, :NEW.PLAVEI, 
                                      l_r088usu.DATVAL, l_r088usu.horval, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
                     END IF;
                 END LOOP;
             END IF;
         END IF;
    END IF;
END␀;Ü␀␀		SENIOR;0µ␀␀

TRIGGER R088AGF_ED AFTER DELETE ON R088AGF FOR EACH ROW

DECLARE
l_online       BOOLEAN;
  l_cravei       NUMBER(12);
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_libvei       NUMBER(1);
  l_situa        NUMBER(1);
  l_data_zero    DATE;
  l_comando_nulo BOOLEAN;
  l_froonl       BOOLEAN;
  l_usuonl       BOOLEAN;
  l_data_histo   DATE;
  l_hora_histo   NUMBER;
  l_datfim       DATE;
  l_horfim       NUMBER(4);
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);

  CURSOR c_r088usu IS SELECT TIPCLB,NUMEMP,TIPCOL,NUMCAD,CADOCR,DATVAL,HORVAL
                         FROM R088USU
                         WHERE PLAVEI = :OLD.PLAVEI
                         AND DATALT <= :OLD.DATAGF
                         AND ACELIV = 'S';
     TYPE t_r088usu IS RECORD(
              TIPCLB   R088USU.TipClb%TYPE,
              NUMEMP   R088USU.NumEmp%TYPE,
              TIPCOL   R088USU.TipCol%TYPE,
              NUMCAD   R088USU.NumCad%TYPE,
              CADOCR   R088USU.CadOcr%TYPE,
              DATVAL   R088USU.DatVal%TYPE,
              HORVAL   R088USU.HorVal%TYPE);
     l_r088usu t_r088usu;

BEGIN
SP_VerOnLine(l_online OUT);
SP_UsaFronline(l_froonl OUT, l_libvei OUT);
SP_Usuonline(l_froonl OUT, l_usuonl OUT);
l_situa := 1;
l_data_zero := DATETIME(31, 12, 1900, 0, 0, 0);
l_data_atual := CURDATE();
l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

IF   (l_online = TRUE) AND (l_froonl = TRUE) AND  (l_libvei = 2) THEN
     l_comando_nulo:=FALSE;
     BEGIN
        SELECT NUMCRA, DATFIM, HORFIM INTO l_cravei, l_data_histo, l_hora_histo
          FROM R088HCH
          WHERE PLAVEI = :OLD.PLAVEI AND
                (DATINI < :OLD.DATAGF OR (DATINI = :OLD.DATAGF AND HORINI <= :OLD.HORAGF)) AND
                (DATFIM > :OLD.DATAGF OR DATFIM = l_data_zero OR (DATFIM = :OLD.DATAGF AND HORFIM >= :OLD.HORAGF)) AND
                STAACC = 1;
     EXCEPTION
     WHEN TOO_MANY_ROWS THEN
          RAISERROR 103 'Erro no R088HCH - TOO MANY ROWS.';
     WHEN NO_DATA_FOUND THEN
         l_comando_nulo:=TRUE;
     WHEN OTHERS THEN
          RAISERROR 103 'Erro no SELECT em R088HCH.';
     END;

     /* se a data for zero ou maior que 31/12/2050, recebe 31/12/2050 */
     IF (l_data_histo = l_data_zero) OR (l_data_histo > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
        l_data_histo := DATETIME(31, 12, 2050, 0, 0, 0);
        l_hora_histo := 1439;
     END IF;

     /* Se tiver crachá provísório vale ele. senão pegar o titular */
     SP_RETCRA (2, :OLD.EMPCON, :OLD.TCLCON, :OLD.CADCON, 0,'',0,'',l_crapro OUT);
     IF   (l_crapro = 0)  THEN
           SP_RETCRA (1, :OLD.EMPCON, :OLD.TCLCON, :OLD.CADCON,0,'',0,'', l_cracha OUT);
     ELSE  l_cracha := l_crapro;
     END IF;

     /* altera o situa do condutor para '1' */
     IF (l_cracha <> 0) AND (l_cravei <> 0) THEN         
		 SP_VEIPESCON('D', l_cravei, l_cracha, l_situa, :OLD.PLAVEI, 
		              :OLD.DATRET, :OLD.HORRET, :OLD.TCLCON, :OLD.EMPCON, :OLD.TCLCON, :OLD.CADCON, 0, '');
     END IF;
END IF;
/* Após a exclusão do agendamento, ativa o usuário VIP novamente */
IF  (l_usuonl = TRUE) AND (l_online = TRUE) THEN
    /* Chama procedure para alteração */
    FOREACH c_r088usu INTO  l_r088usu.TipClb,
                            l_r088usu.NumEmp,
                            l_r088usu.TipCol,
                            l_r088usu.NumCad,
                            l_r088usu.CadOcr,
                            l_r088usu.DatVal,
                            l_r088usu.HorVal
    LOOP
        IF (l_r088usu.TipClb = 1) THEN
           /*  Busca pelo crachá do colaborador. */
           SP_RETCRA (2, l_r088usu.numemp, l_r088usu.tipcol, l_r088usu.numcad, 0,'',0,'',l_crapro OUT);
           IF   (l_crapro = 0)  THEN
                 SP_RETCRA (1, l_r088usu.numemp, l_r088usu.tipcol, l_r088usu.numcad,0,'',0,'', l_cracha OUT);
           ELSE l_cracha := l_crapro;
           END IF;
		   l_numemp := l_r088usu.numemp;
		   l_tipcol := l_r088usu.tipcol;
		   l_numcad := l_r088usu.numcad;
        ELSE
           /*  Busca pelo crachá do colaborador. */
           SP_RETCRA (2, l_r088usu.numemp, 5, l_r088usu.cadocr, 0,'',0,'',l_crapro OUT);
           IF   (l_crapro = 0)  THEN
                 SP_RETCRA (1, l_r088usu.numemp, 5, l_r088usu.cadocr,0,'',0,'', l_cracha OUT);
           ELSE l_cracha := l_crapro;
           END IF;
		   l_numemp := l_r088usu.numemp;
		   l_tipcol := 5;
		   l_numcad := l_r088usu.cadocr;
        END IF;

        /* padroniza a data final: se for zero ou maior que 31/12/2050, passa para 31/12/2050 */
        IF  (l_data_histo = l_data_zero) OR (l_data_histo > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
             l_data_histo := DATETIME(31, 12, 2050, 0, 0, 0);
        END IF;

        IF  (l_r088usu.DATVAL = l_data_zero) OR (l_r088usu.DATVAL > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
             l_r088usu.DATVAL := DATETIME(31, 12, 2050, 0, 0, 0);
        END IF;

        /* passa a menor data final entre o historico e o cadastro de usuarios para uma variavel unica  */
        IF  (l_data_histo < l_r088usu.DATVAL) OR ((l_data_histo = l_r088usu.DATVAL AND l_hora_histo <= l_r088usu.horval)) THEN
            l_datfim := l_data_histo;
            l_horfim := l_hora_histo;
        ELSE
            l_datfim := l_r088usu.DATVAL;
            l_horfim := l_r088usu.horval;
        END IF;

        /* SE A DATA FINAL FOR MENOR QUE A ATUAL, INSERE O VIP COM SITUA 1 */
        IF  (l_datfim < l_data_atual) OR (l_datfim = l_data_atual AND l_horfim <= l_hora_atual) THEN
            l_situa := 1;
        ELSE l_situa := 0;
        END IF;

        /* após excluido o agendamento, ativa o usuário VIP novamente*/        
		SP_VEIPESCON('U', l_cravei, l_cracha, l_situa, :OLD.PLAVEI, 
		              l_datfim, l_horfim, l_tipcol, l_numemp, l_tipcol, l_numcad, 0, '');
    END LOOP;
END IF;
