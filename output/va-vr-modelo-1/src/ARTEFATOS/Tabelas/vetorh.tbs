PROCEDURE SP_PEND19(P_NUMCRA NUMBER,P_IDTPES CHAR(23))
 IS

l_Comando             VARCHAR2(2047);
  l_data_atual          DATE;
  l_hora_atual          NUMBER(4);
  l_datatu_str   		CHAR(16);
  l_seqenv              NUMBER(2);
  l_datstr              CHAR(6);
  l_horstr              CHAR(4);
  l_seqstr              CHAR(2);
  l_datenv              CHAR(16);
  l_QtdCr1_str          CHAR(2);
  l_QtdCr2_str          CHAR(2);
  l_QtdCr3_str          CHAR(2);
  l_QtdCr4_str          CHAR(2);
  l_QtdCr5_str          CHAR(2);
  l_QtdCr6_str          CHAR(2);
  l_BloFal_str          CHAR(1);
  l_ConAdp_str          CHAR(1);
  l_VerPrm_str          CHAR(1);
  l_TemAlm_str          CHAR(3);
  l_ConCre_str          CHAR(1);
  l_ConFai_str          CHAR(1);
  l_VerAfa_str          CHAR(1);
  l_Prmrt1_str          CHAR(5);
  l_Prmrt2_str          CHAR(5);
  l_Prmrt3_str          CHAR(5);
  l_QtdMsg_str          CHAR(2);
  l_ConIal_str          CHAR(1);
  l_BloAut_str          CHAR(1);
  l_CodPrm_str          CHAR(5);
  l_PrmSab_str          CHAR(5);
