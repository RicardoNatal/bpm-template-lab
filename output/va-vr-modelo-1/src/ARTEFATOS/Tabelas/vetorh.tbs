      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DURTRA', CONVERT(NUMBER_TO_CHAR,:NEW.DURTRA));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RISNEX', :NEW.RISNEX);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAJUS', CONVERT(NUMBER_TO_CHAR,:NEW.DIAJUS));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABPRI', CONVERT(NUMBER_TO_CHAR,:NEW.TABPRI));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRI', CONVERT(NUMBER_TO_CHAR,:NEW.CODPRI));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ACITRA', CONVERT(NUMBER_TO_CHAR,:NEW.ACITRA));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MSMMOT', :NEW.MSMMOT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ATEEXT', CONVERT(NUMBER_TO_CHAR,:NEW.ATEEXT));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NATEXT', CONVERT(NUMBER_TO_CHAR,:NEW.NATEXT));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MODATD', CONVERT(NUMBER_TO_CHAR,:NEW.MODATD));
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110MAT_AI: Erro ao inserir valores dos campos para a tabela de log de auditoria R995PRT.';
    END;
  END IF;
END␀ƒß␀␀		SENIOR;0?␀␀

TRIGGER R110MAT_AU
AFTER UPDATE ON R110MAT
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  IF (
    :OLD.TIPATE <> :NEW.TIPATE OR
    :OLD.CODATE <> :NEW.CODATE OR
    :OLD.AREATE <> :NEW.AREATE OR
    :OLD.CODOCO <> :NEW.CODOCO OR
    :OLD.VALCUS <> :NEW.VALCUS OR
    :OLD.DATRET <> :NEW.DATRET OR
    :OLD.HORENT <> :NEW.HORENT OR
    :OLD.HORSAI <> :NEW.HORSAI OR
    :OLD.OBSATE <> :NEW.OBSATE OR
    :OLD.DATAFA <> :NEW.DATAFA OR
    :OLD.HORAFA <> :NEW.HORAFA OR
    :OLD.SITATE <> :NEW.SITATE OR
    :OLD.DIAATE <> :NEW.DIAATE OR
    :OLD.SITAFA <> :NEW.SITAFA OR
    :OLD.DIAAFA <> :NEW.DIAAFA OR
    :OLD.FIMAFA <> :NEW.FIMAFA OR
    :OLD.HORTER <> :NEW.HORTER OR
    :OLD.EXMRET <> :NEW.EXMRET OR
    :OLD.NUMREC <> :NEW.NUMREC OR
    :OLD.NUMATE <> :NEW.NUMATE OR
    :OLD.DATACT <> :NEW.DATACT OR
    :OLD.HORACT <> :NEW.HORACT OR
    :OLD.CODUSU <> :NEW.CODUSU OR
    :OLD.ATECPL <> :NEW.ATECPL OR
    :OLD.ARECPL <> :NEW.ARECPL OR
    :OLD.RECCPL <> :NEW.RECCPL OR
    :OLD.NATCPL <> :NEW.NATCPL OR
    :OLD.OBSCPL <> :NEW.OBSCPL OR
    :OLD.ATEPRE <> :NEW.ATEPRE OR
    :OLD.SITATD <> :NEW.SITATD OR
    :OLD.ATEFIM <> :NEW.ATEFIM OR
    :OLD.DATFIM <> :NEW.DATFIM OR
    :OLD.HORFIM <> :NEW.HORFIM OR
    :OLD.CODPOS <> :NEW.CODPOS OR
    :OLD.INDALT <> :NEW.INDALT OR
    :OLD.OBSPRE <> :NEW.OBSPRE OR
    :OLD.INDAGE <> :NEW.INDAGE OR
    :OLD.HORRET <> :NEW.HORRET OR
    :OLD.RAIATE <> :NEW.RAIATE OR
    :OLD.RAIAFA <> :NEW.RAIAFA OR
    :OLD.FIMATE <> :NEW.FIMATE OR
    :OLD.PREAFA <> :NEW.PREAFA OR
    :OLD.ATEASS <> :NEW.ATEASS OR
    :OLD.DURTRA <> :NEW.DURTRA OR
    :OLD.RISNEX <> :NEW.RISNEX OR
    :OLD.DIAJUS <> :NEW.DIAJUS OR
    :OLD.TABPRI <> :NEW.TABPRI OR
    :OLD.CODPRI <> :NEW.CODPRI OR
    :OLD.ACITRA <> :NEW.ACITRA OR
    :OLD.MSMMOT <> :NEW.MSMMOT OR
    :OLD.ATEEXT <> :NEW.ATEEXT OR
    :OLD.NATEXT <> :NEW.NATEXT OR
    :OLD.MODATD <> :NEW.MODATD
  ) THEN
    l_codSistema := 1;
    l_codcpa := 142;
    l_codtpa := 416;

    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110MAT_AU', '');

      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:OLD.CODFIC));
        SP_DATSTR(:OLD.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR,:OLD.HORATE));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110MAT_AU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPATE', CONVERT(NUMBER_TO_CHAR,:OLD.TIPATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPATE', CONVERT(NUMBER_TO_CHAR,:NEW.TIPATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODATE', CONVERT(NUMBER_TO_CHAR,:OLD.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODATE', CONVERT(NUMBER_TO_CHAR,:NEW.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAREATE', CONVERT(NUMBER_TO_CHAR,:OLD.AREATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAREATE', CONVERT(NUMBER_TO_CHAR,:NEW.AREATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODOCO', CONVERT(NUMBER_TO_CHAR,:OLD.CODOCO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODOCO', CONVERT(NUMBER_TO_CHAR,:NEW.CODOCO));
