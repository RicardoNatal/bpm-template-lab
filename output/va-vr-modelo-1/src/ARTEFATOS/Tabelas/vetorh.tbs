DECLARE
  l_verplf    VARCHAR2(3);
  l_codplf    VARCHAR2(7);
  l_valstr    VARCHAR2(10);
BEGIN
/* UPDATEPhysicalLocationTree */
  SP_PEND78(1, :NEW.VERPLF, :NEW.CODPLF, :NEW.PAIPLF, :NEW.DESPLF, :NEW.IDTREL, :NEW.CATPLF, :NEW.QTDPES);
  
  SP_INTSTR(:NEW.VERPLF, '999', l_verplf OUT);
  SP_INTSTR(:NEW.CODPLF, '9999999', l_codplf OUT);
  l_valstr := l_verplf || l_codplf;
  SP_SAM_PENDENCIES(22, 1, l_valstr);
END␀é×␀␀		SENIOR;0é␀␀

TRIGGER R058PLF_EU AFTER UPDATE ON R058PLF FOR EACH ROW
DECLARE
  l_verplf    VARCHAR2(3);
  l_codplf    VARCHAR2(7);
  l_valstr    VARCHAR2(10);
BEGIN
  /*SOMENTE ENVIA A PENDÊNCIA, SE HOUVE TROCA NA DESCRIÇÃO OU NO PAI*/
  IF (:NEW.PAIPLF <> :OLD.PAIPLF) OR (:NEW.DESPLF <> :OLD.DESPLF) OR (:NEW.QTDPES <> :OLD.QTDPES) THEN
    /* UPDATEPhysicalLocationTree */
    SP_PEND78(1, :OLD.VERPLF, :OLD.CODPLF, :NEW.PAIPLF, :NEW.DESPLF, :NEW.IDTREL, :NEW.CATPLF, :NEW.QTDPES);
  END IF;
  
  IF (:NEW.DESPLF <> :OLD.DESPLF) THEN
      SP_INTSTR(:NEW.VERPLF, '999', l_verplf OUT);
  	  SP_INTSTR(:NEW.CODPLF, '9999999', l_codplf OUT);
  	  l_valstr := l_verplf || l_codplf;
  	  SP_SAM_PENDENCIES(22, 2, l_valstr);	
  END IF;
END␀ç×␀␀		SENIOR;0T␀␀

TRIGGER R058PLF_ED AFTER DELETE ON R058PLF FOR EACH ROW
DECLARE
  l_verplf    VARCHAR2(3);
  l_codplf    VARCHAR2(7);
  l_valstr    VARCHAR2(10);
BEGIN
  /* Faz a exclusão de registros relacionados à Gestão de Locais Controlados */
  R058PLF_DELPLF(:OLD.VERPLF, :OLD.CODPLF);

  /* UPDATEPhysicalLocationTree */
  SP_PEND78(2, :OLD.VERPLF, :OLD.CODPLF, 0, '', :OLD.IDTREL, :OLD.CATPLF, :OLD.QTDPES);

  SP_INTSTR(:OLD.VERPLF, '999', l_verplf OUT);
  SP_INTSTR(:OLD.CODPLF, '9999999', l_codplf OUT);
  l_valstr := l_verplf || l_codplf;
  SP_SAM_PENDENCIES(22, 3, l_valstr);
END␀␀␀•Â␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ê×␀␀5-·␀	Ôÿ?ü␀␀␀␀\A“␀“␀s␀Æÿ␀␀ë×␀␀␀UEÔÿ?ü␀␀␀␀XY°V°VG␀␀ÿ␀␀ÿ␀Ú\‹␀␀␀␀␀␀␀]ê\ë\`␀Æÿ␀␀ÿ␀…¬␀␀´␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀—,¼␀␀␀␀␀␀␀=nnX)␀ˆ␀Æÿ␀␀!#␀~‹␀␀Ò␀␀␀␀␀␀␀[‹␀␀V‹␀␀V‹␀␀ÿ␀ÿÿ␀␀ÿ␀¥%␀±␀␀␀␀␀␀␀?&␀;&␀;&␀q␀Æÿ␀␀6Ø␀␀␀3-Á␀␀␀␀␀␀␀Ï@˜š␀␀˜š␀␀y␀Æÿ␀␀å×␀␀␀L1=␀␀␀␀␀␀a6`6a6c␀␀␀ÿ␀␀ÿS␀␀␀0í×␀␀		SENIOR;0ÿ␀␀TRIGGER R058PLT_EI AFTER INSERT ON R058PLT FOR EACH ROW

DECLARE
l_valstr  VARCHAR2(9);
  l_tipope  CHAR(1);
  l_codplt  CHAR(5);
  l_conaso  CHAR(1);
  l_online  BOOLEAN;
BEGIN
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN
      /*UPDATESiteDefinition*/
      l_valstr := '76';
      l_tipope := '1'; /*Incluir/Alterar*/
      SP_INTSTR(:NEW.CODPLT,'99999',l_codplt OUT);
      /*SE ESTIVER VAZIO O PADRÃO É 'S'(CONTROLA)*/
      IF (:NEW.CONASO = '') OR (:NEW.CONASO IS NULL) THEN
        l_conaso := 'S';
      ELSE
        l_conaso := :NEW.CONASO;
      END IF;
      l_valstr := l_valstr || l_tipope || l_codplt || l_conaso;
      /*Manda o comando para todas as Concentradoras*/
      SP_PORCOM(l_valstr,'0');
  END IF;
END␀î×␀␀		SENIOR;0‚␀␀

TRIGGER R058PLT_EU AFTER UPDATE ON R058PLT FOR EACH ROW

DECLARE
l_valstr  VARCHAR2(9);
  l_tipope  CHAR(1);
  l_codplt  CHAR(5);
  l_conaso  CHAR(1);
  l_cntplt  CHAR(1);
  l_usutel  VARCHAR(31);
  l_online  BOOLEAN;
  l_comando VARCHAR2(256);

  /*Busca todas as validades por site deste site OU ZERO(TODOS SITES), afim de atualizar as informaÃ’Â§Ã’Âµes na CONTPLANTA da TelemÃ’Â¡tica*/
  CURSOR C_r034pla_atuplt IS SELECT R034PLA.NUMEMP
                                   ,R034PLA.TIPCOL
                                   ,R034PLA.NUMCAD
                                   ,R034PLA.DATASO
                                   ,R034PLA.DATTSE
                                   ,R034PLA.BLOPLT
                               FROM R034PLA R034PLA
                              WHERE (R034PLA.CODPLT = :NEW.CODPLT OR R034PLA.CODPLT = 0);

  TYPE T_r034pla_atuplt IS RECORD(NUMEMP   R034PLA.NUMEMP%TYPE
                                 ,TIPCOL   R034PLA.TIPCOL%TYPE
                                 ,NUMCAD   R034PLA.NUMCAD%TYPE
                                 ,DATASO   R034PLA.DATASO%TYPE
                                 ,DATTSE   R034PLA.DATTSE%TYPE
                                 ,BLOPLT   R034PLA.BLOPLT%TYPE);

  l_atu_contplanta T_r034pla_atuplt;
BEGIN
    SP_VerOnLine(l_online OUT);
    IF  (l_online = TRUE) THEN
        /*SE HOUVE TROCA*/
        IF (:NEW.CONASO <> :OLD.CONASO) THEN
            /*UPDATESiteDefinition*/
            l_valstr := '76';
            l_tipope := '1'; /*Incluir/Alterar*/
            SP_INTSTR(:NEW.CODPLT,'99999',l_codplt OUT);
            /*SE ESTIVER VAZIO O PADRÃ’Æ'O Ã’â¬° 'S'(CONTROLA)*/
            IF (:NEW.CONASO = '') OR (:NEW.CONASO IS NULL) THEN
              l_conaso := 'S';
            ELSE
              l_conaso := :NEW.CONASO;
            END IF;
            l_valstr := l_valstr || l_tipope || l_codplt || l_conaso;
            /*Manda o comando para todas as Concentradoras*/
            SP_PORCOM(l_valstr,'0');


            /*SOMENTE PARA TBS 20 e 23, verifica R070TSI.CNTPLT*/
            BEGIN
                SELECT CNTPLT INTO l_cntplt FROM R070TSI;
            EXCEPTION
                WHEN OTHERS THEN
                  l_cntplt := 'N';
            END;

            IF (l_cntplt = 'S') THEN
                SP_USUTEL(l_usutel OUT);
                /*SE PASSOU A NÃ’Æ'O CONTROLAR ASO, REMOVE OS REGISTROS DA CONTPLANTA PARA ESTE SITE, **SOMENTE SE ESTIVER A CONTPLANTA*/
                IF (:NEW.CONASO = 'N') THEN
                    l_comando := 'DELETE FROM '||l_usutel||'CONTPLANTA WHERE PLANTACESSO='||l_codplt;
                    SP_CMDTSI(l_comando);
                ELSE
                    /*CONTROLA*/
                    FOREACH C_r034pla_atuplt INTO l_atu_contplanta.NUMEMP
                                                 ,l_atu_contplanta.TIPCOL
                                                 ,l_atu_contplanta.NUMCAD
                                                 ,l_atu_contplanta.DATASO
                                                 ,l_atu_contplanta.DATTSE
                                                 ,l_atu_contplanta.BLOPLT
                    LOOP
                        R034PLA_CONTPLANTA('I',0,l_atu_contplanta.NUMEMP
                                                ,l_atu_contplanta.TIPCOL,l_atu_contplanta.NUMCAD
                                                ,:NEW.CODPLT,l_atu_contplanta.DATASO
                                                ,l_atu_contplanta.DATTSE,'000000','2359',l_atu_contplanta.BLOPLT);
                    END LOOP;
                END IF;
            END IF;
        END IF;
    END IF;
END␀ì×␀␀		SENIOR;0û␀␀

TRIGGER R058PLT_ED AFTER DELETE ON R058PLT FOR EACH ROW

DECLARE
l_valstr  VARCHAR2(9);
  l_tipope  CHAR(1);
  l_codplt  CHAR(5);
  l_conaso  CHAR(1);
  l_online  BOOLEAN;
BEGIN
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN
      /*UPDATESiteDefinition*/
      l_valstr := '76';
      l_tipope := '2'; /*Excluir*/
      SP_INTSTR(:OLD.CODPLT,'99999',l_codplt OUT);
      /*SE ESTIVER VAZIO O PADRÃO É 'S'(CONTROLA)*/
      IF (:OLD.CONASO = '') OR (:OLD.CONASO IS NULL) THEN
        l_conaso := 'S';
      ELSE
        l_conaso := :OLD.CONASO;
      END IF;
      l_valstr := l_valstr || l_tipope || l_codplt || l_conaso;
      /*Manda o comando para todas as Concentradoras*/
      SP_PORCOM(l_valstr,'0');
  END IF;
END␀␀␀ Â␀␀␀␀␀␀␀␀␀␀␀ï×␀␀9-±␀	„␀␀␀␀␀“=àÃ␀␀àÃ␀␀q␀Æÿ␀␀ğ×␀␀␀U(„␀␀␀␀␀ãW°V°V1␀␀ÿ␀␀ÿ␀ú¼␀␀=␀␀␀␀␀␀ò¿␀␀ğ¿␀␀ñ¿␀␀c␀␀␀ÿ␀␀ÿ␀r=␀␀␀␀␀␀äÃ␀␀¶s¶sc␀␀␀ÿ␀␀ÿ␀5-·␀␀␀␀␀␀␀^A“␀“␀s␀Æÿ␀␀ë×␀␀␀¥%␀±␀␀␀␀␀␀␀?&␀;&␀;&␀q␀Æÿ␀␀6Ø␀␀␀3-Á␀␀␀␀␀␀␀Ï@˜š␀␀˜š␀␀y␀Æÿ␀␀å×␀␀␀$␀=␀␀␀␀␀␀~␀ãÃ␀␀~␀c␀␀␀ÿ␀␀ÿNâ¼␀␀=␀␀␀␀␀␀—À␀␀†¿␀␀—À␀␀c␀␀␀ÿ␀␀ÿSû␀␀=␀␀␀␀␀␀û␀␀ƒû␀␀c␀␀␀ÿ␀␀ÿN'␀=␀␀␀␀␀␀Û␀o˜␀␀q˜␀␀c␀␀␀ÿ␀␀ÿNÊ␀␀­␀␀␀␀␀␀␀9Ë␀␀8Ë␀␀9Ë␀␀p␀Æÿ␀␀ÿ00ûw·␀␀␀␀␀␀␀)z+z)zì*␀␀Æÿ␀␀ÿ␀u=␀␀␀␀␀␀jjc␀␀␀ÿ␀␀ÿN1␀=␀␀␀␀␀␀­␀¬␀­␀c␀␀␀ÿ␀␀ÿN/␀o	␀␀␀␀␀␀íÃ␀␀ìÃ␀␀íÃ␀␀n␀Æÿ␀␀ÿ0³␀␀␀␀␀␀␀␀è␀3␀è␀n␀Æÿ␀␀ÿ0 ␀␀D␀␀␀␀␀␀r¡␀␀q¡␀␀r¡␀␀n␀Æÿ␀␀ÿ0˜␀␀␀␀␀␀␀␀p¡␀␀ëŸ␀␀p¡␀␀n␀Æÿ␀␀ÿ0˜␀␀=␀␀␀␀␀␀¨í␀␀T˜␀␀¨í␀␀c␀␀␀ÿ␀␀ÿSp=␀␀␀␀␀␀®c␀␀␀ÿ␀␀ÿSµ½␀␀=␀␀␀␀␀␀'À␀␀$À␀␀'À␀␀c␀␀␀ÿ␀␀ÿSm␀±␀„␀␀␀␀␀␀ç␀ã␀æ␀q␀Æÿ␀␀hİ␀␀␀v^␀␀␀␀␀␀™␀␀1␀n␀Æÿ␀␀ÿ␀»’␀␀=␀␀␀␀␀␀I“␀␀Š’␀␀I“␀␀c␀␀␀ÿ␀␀ÿN␀␀␀0ò×␀␀		SENIOR;0H␀␀TRIGGER R058POR_EI BEFORE INSERT ON R058POR FOR EACH ROW
