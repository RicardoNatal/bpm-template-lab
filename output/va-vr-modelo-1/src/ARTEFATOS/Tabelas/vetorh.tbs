				l_r034EDP.CONCRE := 0;
				l_r034EDP.CONIAL := 0;
				l_r034EDP.TEMALM := 0;
				l_r034EDP.BLOFAL := 0;
				l_r034EDP.RECVIS := 0;
				l_r034EDP.AUTAGV := 0;
				l_r034EDP.AUTASA := 0;
				l_r034EDP.AUTEXT := 0;
				l_r034EDP.USAFRO := 0;
				l_r034EDP.GRACON := 0;
				l_r034EDP.CONPAC := 0;
				l_r034EDP.TEMPAC := 0;
				l_r034EDP.TOLACP := 0;
				l_r034EDP.USABIO := 0;
				l_r034EDP.AUTDBL := 0;
				l_r034EDP.VERAFA := 0;
				l_r034EDP.APRSOL := 0;
