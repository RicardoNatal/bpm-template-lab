¾␀␀CREATE OR REPLACE PROCEDURE SP_EXITELTAB (p_TabNam IN VARCHAR, p_Exists OUT boolean) IS 
  l_sql VARCHAR2(250);
  l_usutel VARCHAR2(31);
  l_count NUMBER(30);
BEGIN

  /* verifica o usuário tsi*/
  l_usutel := '';
  BEGIN
      SELECT UPPER(LTRIM(RTRIM(USUTEL))) INTO l_usutel FROM R070DAC;
  EXCEPTION 
      WHEN OTHERS THEN l_usutel := '';
  END;  

  BEGIN
      SELECT COUNT(TABLE_NAME) qtdReg into l_count FROM ALL_TAB_COLUMNS WHERE TABLE_NAME = ''||p_tabnam||'' AND OWNER = ''||l_usutel||'';
  EXCEPTION 
      WHEN OTHERS THEN p_Exists := false;
  END;  
  
  IF (l_count = 0) THEN
      p_Exists := false;
  ELSE
      p_Exists := true;
  END IF;
  
END SP_EXITELTAB;	MSSQL;0SP_USUTEL
Q␀␀CREATE PROCEDURE SP_EXITELTAB (@p_TabNam VARCHAR(20), @p_Exists BIT OUTPUT) AS
BEGIN
DECLARE @l_sql VARCHAR(250)
DECLARE @l_usutel VARCHAR(31)
DECLARE @l_count INT
DECLARE @ChkError INTEGER

/* TRY */
  SELECT 
    @l_usutel=UPPER(LTRIM(RTRIM(r070dac.usutel))) FROM r070dac r070dac
  SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
  IF @ChkError <> 0
  BEGIN
    SELECT @l_usutel = 'TELESSVR'
  END
/* END TRY */

IF (@l_usutel = '' or @l_usutel IS null)
  SELECT @l_usutel = 'TELESSVR'
ELSE IF (@l_usutel like '%.')
  SELECT @l_usutel = SUBSTRING(@l_usutel, 0, LEN(@l_usutel))
  
SELECT @l_count = COUNT(TABLE_NAME) FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_SCHEMA = ''+@l_usutel+'' AND TABLE_NAME = ''+@p_TabNam+''
IF (@l_count = 0)
  SELECT @p_Exists = 0
ELSE
  SELECT @p_Exists = 1
END␀0ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0ÈRH_VER_MODULO_PRP
