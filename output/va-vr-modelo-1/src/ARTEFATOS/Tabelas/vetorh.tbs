/*promoção de candidato*/
TRIGGER R126CPE_EI AFTER INSERT ON R126CPE FOR EACH ROW
BEGIN
	BEGIN
    	INSERT INTO R126CIN (SEQCAN,EMPRQU,TIPCAN,NUMCAN,NUMEMP,TIPCOL,NUMCAD,DATADM,CODRQU)
        VALUES (:NEW.SEQCAN,:NEW.EMPRQU,:NEW.TIPCAN,:NEW.NUMCAN,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATADM,:NEW.CODRQU);
    EXCEPTION WHEN OTHERS THEN
       RAISERROR 103 'Erro no INSERT em R126CIN.';
    END;
END␀á␀␀		SENIOR;0p␀␀

TRIGGER R126CPE_EU AFTER UPDATE ON R126CPE FOR EACH ROW
DECLARE
  l_xUtiPos CHAR;
  l_xEstPos NUMBER(3);
  l_xCodPlv NUMBER(4);
  l_xManHRR NUMBER(1);
  l_xSitRqu NUMBER(1);
  l_xQtdRqu NUMBER(6);
  l_xDatRqu DATE;
  l_Nao_Iniciada NUMBER(1);
  l_Em_Andamento NUMBER(1);
  l_Cancelada NUMBER(1);
  l_Finalizada NUMBER(1);
  l_Proposta NUMBER(1);
  l_Suspensa NUMBER(1);
BEGIN
  	l_Nao_Iniciada := 0;
	l_Em_Andamento := 1;
	l_Cancelada := 2;
	l_Finalizada := 3;
	l_Proposta := 4;
	l_Suspensa := 5;
	
     BEGIN
          UPDATE R126CIN
             SET  TIPCAN = :NEW.TIPCAN,
                  EMPRQU = :NEW.EMPRQU,
                  NUMCAN = :NEW.NUMCAN,
                  NUMEMP = :NEW.NUMEMP,
                  TIPCOL = :NEW.TIPCOL,
                  NUMCAD = :NEW.NUMCAD,
                  DATADM = :NEW.DATADM
           WHERE  CODRQU = :NEW.CODRQU
             AND  SEQCAN = :NEW.SEQCAN;
     EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro Na Atualização do R126CIN';
     END;
		 
	QL_MANTERHISTREQ(l_xManHRR OUT);
    IF (l_xManHRR = 1) THEN		
        QL_DADOSRQU(:OLD.CODRQU, l_xQtdRqu OUT, l_xDatRqu OUT, l_xSitRqu OUT);		
        IF ((l_xSitRqu = l_Finalizada) OR (l_xSitRqu = l_Nao_Iniciada) OR (l_xSitRqu = l_Em_Andamento) OR (l_xSitRqu = l_Cancelada) OR (l_xSitRqu = l_Suspensa)) THEN		 
			/* Colaborador estava efetivado debitamos do efetivo por posto */
			IF (:OLD.CANEFE = 'S') AND (IFNULL(:NEW.CANEFE, 'N') <> 'S') THEN
				/* Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
				QL_UTIPOSTRA(:OLD.EMPRQU, l_xDatRqu, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
				IF (l_xUtiPos = 'S') THEN
					QL_PROCECPE('O', :OLD.EMPRQU, l_xEstPos, l_xCodPlv, :OLD.CODRQU, :OLD.DATADM);
				END IF;
			END IF;

			/* Colaborador foi efetivado creditamos do efetivo por posto */
			IF (:NEW.CANEFE = 'S') AND (IFNULL(:OLD.CANEFE, 'N') <> 'S') THEN
				/* Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
				QL_UTIPOSTRA(:NEW.EMPRQU, :NEW.DATADM, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
				IF (l_xUtiPos = 'S') THEN
					QL_PROCECPE('U', :NEW.EMPRQU, l_xEstPos, l_xCodPlv, :NEW.CODRQU, :NEW.DATADM);
				END IF;
			END IF;			
		END IF;		 		
	ELSE		
		/* Colaborador estava efetivado debitamos do efetivo por posto */
		IF (:OLD.CANEFE = 'S') AND (IFNULL(:NEW.CANEFE, 'N') <> 'S') THEN
			/* Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
			QL_UTIPOSTRA(:OLD.EMPRQU, :OLD.DATADM, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
			IF (l_xUtiPos = 'S') THEN
				QL_PROCECPE('O', :OLD.EMPRQU, l_xEstPos, l_xCodPlv, :OLD.CODRQU, :OLD.DATADM);
			END IF;
		END IF;

		/* Colaborador foi efetivado creditamos do efetivo por posto */
		IF (:NEW.CANEFE = 'S') AND (IFNULL(:OLD.CANEFE, 'N') <> 'S') THEN
			/* Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
			QL_UTIPOSTRA(:NEW.EMPRQU, :NEW.DATADM, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
			IF (l_xUtiPos = 'S') THEN
				QL_PROCECPE('U', :NEW.EMPRQU, l_xEstPos, l_xCodPlv, :NEW.CODRQU, :NEW.DATADM);
			END IF;
		END IF;
	END IF;
END␀á␀␀		SENIOR;0£	␀␀

TRIGGER R126CPE_ED AFTER DELETE ON R126CPE FOR EACH ROW

DECLARE
  l_xUtiPos CHAR;
  l_xEstPos NUMBER(3);
  l_xCodPlv NUMBER(4);
  l_xManHRR NUMBER(1);
  l_xSitRqu NUMBER(1);
  l_xQtdRqu NUMBER(6);
  l_xDatRqu DATE;
  l_Nao_Iniciada NUMBER(1);
  l_Em_Andamento NUMBER(1);
  l_Cancelada NUMBER(1);
  l_Finalizada NUMBER(1);
  l_Proposta NUMBER(1);
  l_Suspensa NUMBER(1);
BEGIN
  	l_Nao_Iniciada := 0;
	l_Em_Andamento := 1;
	l_Cancelada := 2;
	l_Finalizada := 3;
	l_Proposta := 4;
	l_Suspensa := 5;
	
	BEGIN
		DELETE FROM R126CIN
		 WHERE CODRQU = :OLD.CODRQU
		   AND SEQCAN = :OLD.SEQCAN;
	EXCEPTION WHEN OTHERS THEN
		RAISERROR 103 'Erro no DELETE em R126CIN.';
	END;

	QL_MANTERHISTREQ(l_xManHRR OUT);
	IF (l_xManHRR = 1) THEN
		QL_DADOSRQU(:OLD.CODRQU, l_xQtdRqu OUT, l_xDatRqu OUT, l_xSitRqu OUT);
		
		
        /* 0-Não iniciada 1-Em Andamento */
    	IF (l_xSitRqu = l_Nao_Iniciada) OR (l_xSitRqu = l_Em_Andamento) THEN
			/* Colaborador estava efetivado, creditamos na reserva por posto */
			IF (:OLD.CANEFE = 'S') THEN
				/* Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
				QL_UTIPOSTRA(:OLD.EMPRQU, :OLD.DATADM, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
				IF (l_xUtiPos = 'S') THEN
					QL_PROCECPE('D', :OLD.EMPRQU, l_xEstPos, l_xCodPlv, :OLD.CODRQU, :OLD.DATADM);
				END IF;
			END IF;
		ELSE
			IF ((l_xSitRqu = l_Finalizada) OR (l_xSitRqu = l_Cancelada) OR (l_xSitRqu = l_Suspensa) ) THEN
				QL_UTIPOSTRA(:OLD.EMPRQU, :OLD.DATADM, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
				IF (l_xEstPos <> 0 AND l_xCodPlv <> 0) THEN
					/* Colaborador não estava efetivado debitamos da reserva por posto */
					IF (:OLD.CANEFE = 'S') THEN
						QL_PROCECPE('D', :OLD.EMPRQU, l_xEstPos, l_xCodPlv, :OLD.CODRQU, :OLD.DATADM);    				
					END IF; 
					QL_PROCECPE('U', :OLD.EMPRQU, l_xEstPos, l_xCodPlv, :OLD.CODRQU, l_xDatRqu);
				END IF;
			END IF;	 				
		END IF;				
	ELSE
    	/* Colaborador estava efetivado debitamos do efetivo por posto */
    	IF (:OLD.CANEFE = 'S') THEN
			/* Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
			QL_UTIPOSTRA(:OLD.EMPRQU, :OLD.DATADM, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
      		IF (l_xUtiPos = 'S' AND l_xEstPos <> 0 AND l_xCodPlv <> 0) THEN
        		QL_PROCECPE('D', :OLD.EMPRQU, l_xEstPos, l_xCodPlv, :OLD.CODRQU, :OLD.DATADM);
      		END IF;
    	END IF;
	END IF;
