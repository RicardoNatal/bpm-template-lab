TRIGGER R038AFA_SD AFTER DELETE ON R038AFA

DECLARE
  l_online            BOOLEAN;
  l_sittra            NUMBER(3);
  l_TipSit            NUMBER(2);
  l_data_zero         DATE;
  l_datatu            DATE;
  l_xUtiPos           CHAR;
  l_xEstPos           NUMBER(3);
  l_xCodPlv           NUMBER(4);
  l_DataAdmissao      DATE;
  l_DataInicioEsocial DATE;
  l_DataInicioTabelas DATE;
  l_DataInicioNaoPeriodicos DATE;
  l_DataInicioPeriodicos DATE;
  l_DataInicioSST DATE;
  l_DataInicioMigracao DATE;
  l_layout            VARCHAR(6);
  l_gerarPendencia    BOOLEAN;
  l_data_fim          DATE;
  l_DataAfasTmp       DATE;

/* CURSOR c/ os registros gravados no R038AFA_AUXl */
  CURSOR c_r038afa_del IS SELECT NUMEMP,TIPCOL,NUMCAD,DATAFA,HORAFA,DATTER,HORTER,SITAFA,ORIAFA,STAATU,DIABLQ, MOTALT FROM R038AFA_AUX;
  TYPE t_r038AFA_aux IS RECORD(
    NUMEMP   R038AFA_AUX.NUMEMP%TYPE,
    TIPCOL   R038AFA_AUX.TIPCOL%TYPE,
    NUMCAD   R038AFA_AUX.NUMCAD%TYPE,
    DATAFA   R038AFA_AUX.DATAFA%TYPE,
    HORAFA   R038AFA_AUX.HORAFA%TYPE,
    DATTER   R038AFA_AUX.DATTER%TYPE,
    HORTER   R038AFA_AUX.HORTER%TYPE,
    SITAFA   R038AFA_AUX.SITAFA%TYPE,
    ORIAFA   R038AFA_AUX.ORIAFA%TYPE,
    STAATU   R038AFA_AUX.STAATU%TYPE,
    DIABLQ   R038AFA_AUX.DIABLQ%TYPE,
	MOTALT   R038AFA_AUX.MOTALT%TYPE);
  
  l_r038AFA_aux t_r038AFA_aux;
  /* VARIAVEIS DE CONTROLE E-SOCIAL */
  l_Valor            VARCHAR(2000);
  l_Valor2            VARCHAR(2000);
  
  l_DataAnteriorAfastamento   R038AFA.DATAFA%TYPE;
  l_DatAfaAux                 R038AFA.DATAFA%TYPE;
  l_DatTerAux                 R038AFA.DATTER%TYPE;
  l_HorAfaAux                 R038AFA.HORAFA%TYPE;
  l_HorTerAux                 R038AFA.HORTER%TYPE;
  l_DatAfa                    R038AFA.DATAFA%TYPE;
  l_DatTer                    R038AFA.DATTER%TYPE;
  l_HorAfa                    R038AFA.HORAFA%TYPE;
  l_MotEso                    R010ESO.MOTESO%TYPE;
  l_EnvObs                    R010ESO.ENVOBS%TYPE;
  l_EnvEso                    R038HCE.ENVESO%TYPE;
  l_BloAce                    R010SIT.BLOACE%TYPE;

  CURSOR cursorPlanoContas IS 
  SELECT R017PLV.ESTPOS, R017PLV.CODPLV, R017PLV.DATINI
          FROM R017PLE, R017PLV
         WHERE R017PLE.ESTPOS = R017PLV.ESTPOS
           AND R017PLE.CODPLV = R017PLV.CODPLV
           AND R017PLV.DATINI <= l_data_fim
           AND R017PLV.DATTER >= l_r038afa_aux.DATAFA    
           AND R017PLE.NUMEMP = l_r038afa_aux.NUMEMP
           AND R017PLE.PLNATI = 'S' 
     ORDER BY DATINI ;  
                 
  x_ESTPOS    R017PLV.ESTPOS%TYPE;
  x_CODPLV    R017PLV.CODPLV%TYPE;
  x_DATINI    R017PLV.DATINI%TYPE;

  CURSOR C_AFAANT_ED IS
		SELECT AFA.DATAFA, AFA.HORAFA, AFA.HORTER, AFA.DATTER
           FROM R038AFA AFA 
          WHERE AFA.NUMEMP = l_r038afa_aux.NUMEMP AND AFA.TIPCOL = l_r038afa_aux.TIPCOL AND AFA.NUMCAD = l_r038afa_aux.NUMCAD
            AND AFA.DATTER = (SELECT MAX(AFA2.DATTER) FROM R038AFA AFA2
                               WHERE AFA2.NUMEMP = AFA.NUMEMP AND AFA2.TIPCOL = AFA.TIPCOL AND AFA2.NUMCAD = AFA.NUMCAD
                                 AND ((AFA2.DATTER = l_r038afa_aux.DATAFA AND AFA2.HORTER <= l_r038afa_aux.HORTER) OR AFA2.DATTER = l_DataAnteriorAfastamento))
       ORDER BY AFA.HORTER DESC; 	   
BEGIN
  l_Valor := '';
  l_data_zero:= DATETIME(31, 12, 1900, 0, 0, 0);
  l_datatu   := CURDATE();
  SP_VerOnLine(l_online OUT);

  /* BUSCA SISTUACAO DE TRABALHANDO */
  BEGIN
    SELECT MIN(CODSIT) INTO l_sittra
      FROM R010SIT
     WHERE R010SIT.TIPSIT = 1;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro No SELECT do R010SIT';
  END;

  /* Le Registro do CURSOR */
  FOREACH c_r038afa_del INTO  l_r038afa_aux.NUMEMP,
                              l_r038afa_aux.TIPCOL,
                              l_r038afa_aux.NUMCAD,
                              l_r038afa_aux.DATAFA,
                              l_r038afa_aux.HORAFA,
                              l_r038afa_aux.DATTER,
                              l_r038afa_aux.HORTER,
                              l_r038afa_aux.SITAFA,
                              l_r038afa_aux.ORIAFA,
                              l_r038afa_aux.STAATU,
                              l_r038afa_aux.DIABLQ,
							  l_r038afa_aux.MOTALT
  LOOP
    /* atualiza a situcao do afastamento em r034fun se for historico atual */
    IF l_r038afa_aux.STAATU = 1 THEN
      SP_RETORNAR_TIPSIT(l_r038afa_aux.SITAFA, l_TipSit OUT, l_BloAce OUT);
      /* Se for tipo de Situacao Demitido */
      IF  l_TipSit = 7 THEN
        R038AFA_ATUHCH('D',
                       l_r038afa_aux.NUMEMP,
                       l_r038afa_aux.TIPCOL,
                       l_r038afa_aux.NUMCAD,
                       l_datatu,
                       l_r038afa_aux.DATAFA,
                       l_r038afa_aux.HORAFA,
                       l_r038afa_aux.SITAFA,
                       l_r038afa_aux.DIABLQ);
      END IF;

      /* Seta Colaborador como Trabalhando */
      BEGIN
        UPDATE R034FUN
           SET SITAFA = l_sittra,
               DATAFA = l_data_zero,
               HORAFA = 0,
               CAUDEM = 0
         WHERE R034FUN.TIPCOL = l_r038afa_aux.TIPCOL AND
               R034FUN.NUMEMP = l_r038afa_aux.NUMEMP AND
               R034FUN.NUMCAD = l_r038afa_aux.NUMCAD;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro Na Atualização do R034FUN';
      END;

      /* FOR ON-LINE ATUALIZAR A CONTROLE DATINI/DATFIM */
      IF (l_online = TRUE) THEN
        SP_HisAfa ('D', l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_r038afa_aux.DATAFA, l_r038afa_aux.HORAFA, l_r038afa_aux.DATTER, l_r038afa_aux.HORTER, l_r038afa_aux.SITAFA, l_r038afa_aux.DATTER, l_r038afa_aux.HORTER, l_r038afa_aux.SITAFA);
      END IF;
    END IF;
    
    	 /* tratamento para afastamentos */
    	 l_data_fim := DATETIME(04, 06, 2080, 0, 0, 0);
      
         IF (l_r038afa_aux.DATTER > l_data_zero) THEN
              l_data_fim := l_r038afa_aux.DATTER; 
         END IF;
      
         FOREACH cursorPlanoContas INTO x_ESTPOS, x_CODPLV, x_DATINI
         LOOP
             l_xCodPlv := x_CODPLV;
             l_xEstPos := x_ESTPOS;
             
             IF ( l_r038afa_aux.DATAFA < x_DATINI ) THEN
               l_DataAfasTmp := x_DATINI;
             ELSE
                l_DataAfasTmp := l_r038afa_aux.DATAFA; 
             END IF;
      
             QL_PROCEAFA('D', l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_r038afa_aux.SITAFA, l_xEstPos, l_xCodPlv, l_DataAfasTmp, l_r038afa_aux.DATTER, 0);
         END LOOP; /* fim loop cursor */

    /* Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
    QL_UTIPOSTRA(l_r038afa_aux.NUMEMP, l_r038afa_aux.DATAFA, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
    IF (l_xUtiPos = 'N') THEN
		/* Atualiza o Quadro Efetivo - QL */
      QL_EXCAFAST(l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_r038afa_aux.DATAFA, l_r038afa_aux.SITAFA, l_r038afa_aux.DATTER, l_r038afa_aux.DATAFA, 0, l_r038afa_aux.DATTER);      
    END IF;

    /* INÍCIO - eSocial */
    l_gerarPendencia := FALSE;
	RH_LAYOUTCOLAB(l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_layout OUT);
    N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    	
	IF (l_gerarPendencia = TRUE) THEN
	    SP_RETORNAR_MOTESO(l_r038afa_aux.SITAFA, l_r038afa_aux.DATAFA, l_MotEso OUT, l_EnvObs OUT);
	    SP_RETORNAR_TIPSIT(l_r038afa_aux.SITAFA, l_TipSit OUT, l_BloAce OUT);
	    RH_RET_DATADM(l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_DataAdmissao OUT);
		  
		l_EnvEso := 1; /* 1 - Sim*/
		/* Quando motivo eSocial for 14 - Cessão/Requisição ou 24 - Mandato Sindical - Afastamento temporário para exercício de mandato sindical obrigatoriamente deve existir histórico de cessão
		 * No histórico de cessão é indicado se deve enviar ao eSocial ou não (campo envEso), visto que existem cenários facultativos, sendo assim, o envio só deve ser efetuado para envEso = 1 - Sim */
		IF (l_MotEso IN (14, 24)) THEN
		  SP_RETENVESO_HCE(l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_r038afa_aux.DATAFA, l_EnvEso OUT);
		END IF;
		  
	    /* MotEso = 0 - Não enviar ao eSocial */
	    IF ((l_MotEso <> 0) AND (l_TipSit NOT IN (16,17,18)) AND (l_EnvEso = 1) AND ((l_r038afa_aux.DatTer >= l_DataAdmissao) OR (l_r038afa_aux.DatTer = DATETIME(31, 12, 1900, 0, 0, 0)))) THEN
	      RH_DEF_ESOCIAL(l_r038afa_aux.NUMEMP, l_DataInicioTabelas OUT, l_DataInicioEsocial OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
		  
		  /* CONTROLE MOTIVO AFASTAMENTO NÃO RETROATIVO ESOCIAL */
		  IF (l_r038afa_aux.MOTALT = 'S') THEN
		    /* RETORNAR AFASTAMENTO ANTERIOR */
		    l_data_zero := DATETIME(31, 12, 1900, 0, 0, 0);
		    l_DataAnteriorAfastamento := DATETIMEADD(DD, -1, l_r038afa_aux.DATAFA);  
		    l_DatAfa := DATETIME(31, 12, 1900, 0, 0, 0);
		    l_DatTer := DATETIME(31, 12, 1900, 0, 0, 0);
		    l_HorAfa := 0;
		  
		    FOREACH C_AFAANT_ED INTO l_DatAfaAux, l_HorAfaAux, l_HorTerAux, l_DatTerAux
		    LOOP
		      l_DatAfa := l_DatAfaAux;
		      l_HorAfa := l_HorAfaAux;
		      l_DatTer := l_DatTerAux;
		      EXIT; 
		    END LOOP;
		    
		   /* IF ((l_DatAfa <> l_data_zero) AND (l_r038afa_aux.DATTER = l_data_zero)) THEN
			  l_Valor := '';
		      SP_CONCATENAR_DAT('DATAFA', l_DatAfa, l_Valor OUT);
		      SP_CONCATENAR_NUM('HORAFA', l_HorAfa, l_Valor OUT);
		      SP_CONCATENAR_DES('LAYOUT', 'S-2230', l_Valor OUT);
		      SP_E_SOCIAL('S-3000', 'R038AFA', 'N', 'E', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_DatAfa, 0, 'R038AFA_SD');
		           
		      IF (l_r038afa_aux.DATTER <> l_data_zero) THEN
		         l_Valor := '';
		         SP_CONCATENAR_DAT('DATAFA', l_DatAfa, l_Valor OUT);
		         SP_CONCATENAR_NUM('HORAFA', l_HorAfa, l_Valor OUT);
		         SP_CONCATENAR_DES('LAYOUT', 'S-2230', l_Valor OUT);
		         SP_E_SOCIAL('S-3000', 'R038AFA', 'N', 'E', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_DatAfa, 0, 'R038AFA_SD');
		      END; 
		    END;*/
		   /* Gera uma pendencia de retificação para o leiaute S-2230, informando a data de inicio do afastamento cadastrada no afastamento anterior ao excluido */
		    IF(l_DatTer <> l_data_zero)THEN 
		       SP_CONCATENAR_DAT('DATAFA', l_DatAfa, l_Valor OUT);
		       SP_CONCATENAR_NUM('HORAFA', l_HorAfa, l_Valor OUT);
		       SP_CONCATENAR_DES('SECAFA', 1, l_Valor OUT); /* 1 - Inicio Afastamento  */
		       SP_E_SOCIAL('S-2230', 'R038AFA', 'N', 'A', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_DatAfa, 0, 'R038AFA_SD');	
		    
		    	  l_Valor2 := '';
		       SP_CONCATENAR_DAT('DATAFA', l_DatAfa, l_Valor2 OUT);
		       SP_CONCATENAR_NUM('HORAFA', l_HorAfa, l_Valor2 OUT);
		       SP_CONCATENAR_DES('SECAFA', 3, l_Valor2 OUT); /* 1 - Fim Afastamento  */
		       SP_E_SOCIAL('S-2230', 'R038AFA', 'N', 'A', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor2, '', 0, NULL, l_DatTer, 0, 'R038AFA_SD');	
		    END IF;
		    
	        IF (l_DataInicioNaoPeriodicos > l_DataAdmissao) THEN
		      IF (l_DatAfa < l_DataInicioNaoPeriodicos AND (l_r038afa_aux.DATTER = l_data_zero OR l_r038afa_aux.DATTER >= l_DataInicioNaoPeriodicos)) THEN
		        SP_CONCATENAR_NUM('SECAFA', 3, l_Valor OUT); /* 3 - Fim afastamento */
		        SP_E_SOCIAL(l_layout, 'R038AFA', 'N', 'E', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_DataInicioNaoPeriodicos, 0, 'R038AFA_SD');
		      END IF;
		    END IF;	       
		  ELSE
		    l_Valor := '';
		    SP_CONCATENAR_DAT('DATAFA', l_r038afa_aux.DATAFA, l_Valor OUT);
		    SP_CONCATENAR_NUM('HORAFA', l_r038afa_aux.HORAFA, l_Valor OUT);
		    SP_CONCATENAR_DES('LAYOUT', 'S-2230', l_Valor OUT);
		    SP_CONCATENAR_NUM('MOTESO', l_MotEso, l_Valor OUT);
		  
		    SP_E_SOCIAL('S-3000', 'R038AFA', 'N', 'E', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_r038afa_aux.DATAFA, 0, 'R038AFA_SD6');
		    
		    IF (l_DataInicioNaoPeriodicos > l_DataAdmissao) THEN
		      IF (l_r038afa_aux.DATAFA < l_DataInicioNaoPeriodicos AND (l_r038afa_aux.DATTER = l_data_zero OR l_r038afa_aux.DATTER >= l_DataInicioNaoPeriodicos)) THEN
		        SP_CONCATENAR_NUM('SECAFA', 3, l_Valor OUT); /* 3 - Fim afastamento */
		        SP_E_SOCIAL(l_layout, 'R038AFA', 'N', 'E', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_DataInicioNaoPeriodicos, 0, 'R038AFA_SD');
		      END IF;
		    END IF;
		    
		    /* Gera uma pendencia de retificação para o leiaute S-2200(ou leiaute de admissão) */
		    IF (l_DataAdmissao > l_DataInicioNaoPeriodicos) THEN
		      IF (l_r038afa_aux.DATAFA < l_DataAdmissao AND (l_r038afa_aux.DATTER = l_data_zero OR l_r038afa_aux.DATTER >= l_DataInicioNaoPeriodicos)) THEN
		        SP_CONCATENAR_NUM('SECAFA', 1, l_Valor OUT); /* inicio afastamento */
		        SP_E_SOCIAL(l_layout, 'R038AFA', 'N', 'A', NULL, NULL, l_r038afa_aux.NUMEMP, l_r038afa_aux.TIPCOL, l_r038afa_aux.NUMCAD, l_Valor, '', 0, NULL, l_DataAdmissao, 0, 'R038AFA_SD8');
		      END IF;
		    END IF;
		    
		  END IF;
	    END IF;
	END IF;	    	  
    /* FIM - eSocial */    
  END LOOP;
 /* Apaga Registro OLD em R038AFA_AUX */
  BEGIN
    DELETE FROM R038AFA_AUX;
    DROP_TEMP_TABLE R038AFA_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀OÔ␀␀		SENIOR;0ê;␀␀

TRIGGER R038AFA_ED AFTER DELETE ON R038AFA FOR EACH ROW
DECLARE
  l_TipSit       NUMBER(2);
  l_OriExa       NUMBER(3);
  l_TipOri       NUMBER(3);
  l_data_zero     DATE;
  l_data_fim     DATE;

  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_BloAce         R010SIT.BloAce%TYPE;
  /* VARIÁVEIS DO LOG */
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);

  /* Declaracao para criar tabela temporária em SQL Server - Erros de DeadLock */
  CREATE_TEMP_TABLE R038AFA_AUX;
  /*VARIAVEIS DO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  
  l_chave       VARCHAR2(50);
  l_tippesstr    CHAR(2);
  l_numempstr    CHAR(4);
  l_tipcolstr    CHAR(1);
  l_numcadstr    CHAR(9);
  l_data         CHAR(8);
  l_hora         CHAR(4);
  l_IDTPES       VARCHAR(23);
  l_tipsitstr    CHAR(2);
BEGIN
  /* Verifica se existe pendência gerada exclusivamente pelo histórico de Afastamento para o
     cadastro de origem que está sendo excluído */
  BEGIN
       SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf
         FROM R038PEN
        WHERE R038PEN.NUMEMP = :OLD.NUMEMP AND
              R038PEN.TIPCOL = :OLD.TIPCOL AND
              R038PEN.NUMCAD = :OLD.NUMCAD AND
              R038PEN.DATTRF = :OLD.DATAFA AND
              R038PEN.ALTEMP = 'N' AND
              R038PEN.ALTFIL = 'N' AND
              R038PEN.ALTLOC = 'N' AND
              R038PEN.ALTCCU = 'N' AND
              R038PEN.ALTCAR = 'N' AND
              R038PEN.ALTESC = 'N' AND
              R038PEN.ALTDES = 'S';
  EXCEPTION
       WHEN NO_DATA_FOUND THEN
            l_NumEmp := 0;
            l_TipCol := 0;
            l_NumCad := 0;
            l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
  END;

  /* Se existe pendência exclusiva do histórico de Afastamento para o cadastro de origem
     verifica se já foi atendida para então excluir */
  IF (l_NumCad <> 0) THEN
    R038PEN_DELPEN(l_NumEmp, l_TipCol, l_NumCad, l_DatTrf);
  ELSE
    /* Atualiza pendência do Afastamento com 'N' */
    BEGIN
      UPDATE R038PEN SET ALTDES = 'N'
               WHERE R038PEN.NUMEMP = :OLD.NUMEMP AND
                     R038PEN.TIPCOL = :OLD.TIPCOL AND
                     R038PEN.NUMCAD = :OLD.NUMCAD AND
                     R038PEN.DATTRF = :OLD.DATAFA;
    EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no update da Tabela R038PEN.';
    END;
  END IF;

  BEGIN
    /* Insere Registro Old */
    INSERT INTO R038AFA_AUX (NUMEMP,TIPCOL,NUMCAD,DATAFA,HORAFA,SITAFA,DATTER,HORTER,ORIAFA,STAATU,DIABLQ,MOTALT)
                     VALUES (:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.DATAFA,:OLD.HORAFA,:OLD.SITAFA,:OLD.DATTER,:OLD.HORTER,0,:OLD.STAATU,:OLD.DIABLQ,:OLD.MOTALT);
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro no INSERT em R038AFA_AUX.';
  END;

  /* Busca o Tipo da Situação */
  SP_RETORNAR_TIPSIT(:OLD.SITAFA, l_TipSit OUT, l_BloAce OUT);

  /* Dependendo do Tipo de situação, a Origem é diferente */
  l_TipOri := 0;
  IF   (l_TipSit = 3) THEN
       l_TipOri := 3;
  ELSIF (l_TipSit = 4) THEN
       l_TipOri := 4;
  ELSIF (l_TipSit = 5) THEN
       l_TipOri := 5;
  ELSIF (l_TipSit = 6) THEN
       l_TipOri := 6;
  ELSIF (l_TipSit = 7) THEN
       l_TipOri := 12;
      /* VERIFICA SE FOI INCLUÍDO COMO PNG */
      /* Se o afastamento for gerado por troca de filial, não altera */
      IF  (:OLD.oriAfa <> 5) THEN
          R038AFA_ATUPNG('E',:OLD.numemp, :OLD.tipcol, :OLD.numcad, :OLD.datafa);
      END IF;       
 ELSIF (l_TipSit = 14) THEN
       l_TipOri := 8;
  ELSIF (l_TipSit = 19) THEN
       l_TipOri := 7;
  END IF;

  /* Busca a Origem do Exame com o Tipo especificado */
  l_OriExa := 0;
  RH_RETORIEXA(l_TipOri, l_OriExa OUT);

  IF   (l_OriExa > 0) THEN
       IF   (l_TipOri = 12) THEN
            /* Exclui as Solicitações cadastradas anteriormente para Demissão */
            RH_EXC_SOLIC('D', :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATAFA, l_OriExa);
       ELSE
            /* Exclui as Solicitações cadastradas anteriormente */
            RH_EXC_SOLIC('A', :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATAFA, l_OriExa);
       END IF;
  END IF;

  /* OriAfa = 1 = Afastamentos de Perda de Férias Incluídos na Apuração do Ronda */
  /* Condição "IS NULL" incluída para tratar quando houver (por ex.) telas do SGI que não setam ORIAFA. */
  IF   (:OLD.ORIAFA <> 1) OR (:OLD.ORIAFA IS NULL) THEN
       l_data_zero := DATETIME(31, 12, 1900, 0, 0, 0);
       l_data_fim := :OLD.DATTER;
       IF   (l_data_fim = l_data_zero) THEN
            l_data_fim := DATETIME(04, 06, 2080, 0, 0, 0);
       END IF;

       BEGIN
       UPDATE R066APU SET DIAALT = 8
              WHERE NUMEMP = :OLD.NUMEMP AND
                    TIPCOL = :OLD.TIPCOL AND
                    NUMCAD = :OLD.NUMCAD AND
                    DATAPU >= :OLD.DATAFA AND
                    DATAPU <= l_data_fim;
       EXCEPTION WHEN OTHERS THEN
         NULL;
       END;
  END IF;

   /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R038AFA');

  IF (l_auditoria = 'S') THEN
      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg
                FROM R038AFA_AUD
               WHERE NUMEMP = :OLD.NUMEMP AND
                     TIPCOL = :OLD.TIPCOL AND
                     NUMCAD = :OLD.NUMCAD AND
                     DATAFA = :OLD.DATAFA AND
                     HORAFA = :OLD.HORAFA;
           EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
          INSERT INTO R038AFA_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,DATAFA,HORAFA,DATTER,HORTER,PRVTER,
                                   SITAFA,DIAJUS,OBSAFA,STAATU,CAUDEM,DIABLQ,QHRAFA,ORIAFA,EXMRET,CONTOV,
                                   MOTRAI,NROAUT,CODOEM,CODSUB,DATPER,SITINI,RISNEX,DATNEX,DIAPRV,CODCUA,
                                   TMACUA,DATPAR,FIMQUA)
                           VALUES (l_seqreg,l_verseq,:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.DATAFA,
                                  :OLD.HORAFA,:OLD.DATTER,:OLD.HORTER,:OLD.PRVTER,:OLD.SITAFA,:OLD.DIAJUS,
                                  :OLD.OBSAFA,:OLD.STAATU,:OLD.CAUDEM,:OLD.DIABLQ,:OLD.QHRAFA,:OLD.ORIAFA,
                                  :OLD.EXMRET,:OLD.CONTOV,:OLD.MOTRAI,:OLD.NROAUT,:OLD.CODOEM,:OLD.CODSUB,
                                  :OLD.DATPER,:OLD.SITINI,:OLD.RISNEX,:OLD.DATNEX,:OLD.DIAPRV,:OLD.CODCUA,
                                  :OLD.TMACUA,:OLD.DATPAR,:OLD.FIMQUA);

          SP_AUDGENREG(l_seqreg,l_verseq,'R038AFA','DELETE');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
  
  IF (l_BloAce = 'S' OR l_TipSit = 7) THEN  
     SP_INTSTR(:OLD.TIPCOL,'99',l_tippesstr OUT);
     SP_INTSTR(:OLD.NUMEMP,'9999',l_numempstr OUT);
     SP_INTSTR(:OLD.TIPCOL,'9',l_tipcolstr OUT);
     SP_INTSTR(:OLD.NUMCAD,'999999999',l_numcadstr OUT);
     SP_DATSTR(:OLD.DATAFA,'DDMMYYYY',l_data OUT);
     SP_INTSTR(:OLD.HORAFA,'9999',l_hora OUT);
     SP_INTSTR(l_TipSit,'99',l_tipsitstr OUT);
     l_chave := l_tippesstr||l_numempstr||l_tipcolstr||l_numcadstr||l_data||l_hora||l_tipsitstr;
     SP_SAM_PENDENCIES(3,3,l_chave);     
  END IF;
     
  /* CONTROLE DO LOG */
  BEGIN
    l_codcpa := 16;        /*l_codcpa representa a categoria  */
    l_codtpa := 145;       /*l_codtpa representa a o tipo Inserir/Excluir/Alterar*/
  
    SP_EXISTE_LOG(l_codcpa, l_codtpa, 1, l_temAud OUT);
  
    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R038AFA_ED', 'FR038AFA'); 
     
      BEGIN
  	    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
		SP_DATSTR(:OLD.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAFA', l_datTemp);
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORAFA', CONVERT(NUMBER_TO_CHAR, :OLD.HORAFA));
  	  EXCEPTION
	      WHEN OTHERS THEN RAISERROR 103 'R038AFA_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	  END;
	 
	  BEGIN
	    SP_DATSTR(:OLD.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATTER', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORTER', CONVERT(NUMBER_TO_CHAR, :OLD.HORTER));
		SP_DATSTR(:OLD.PRVTER, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRVTER', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITAFA', CONVERT(NUMBER_TO_CHAR, :OLD.SITAFA));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CAUDEM', CONVERT(NUMBER_TO_CHAR, :OLD.CAUDEM));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAJUS', CONVERT(NUMBER_TO_CHAR, :OLD.DIAJUS));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDREM', CONVERT(NUMBER_TO_CHAR, :OLD.INDREM));
		SP_DATSTR(:OLD.FIMQUA, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMQUA', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QHRAFA', CONVERT(NUMBER_TO_CHAR, :OLD.QHRAFA));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORIAFA', CONVERT(NUMBER_TO_CHAR, :OLD.ORIAFA));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EXMRET', :OLD.EXMRET);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONTOV', :OLD.CONTOV);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSAFA', :OLD.OBSAFA);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAATU', CONVERT(NUMBER_TO_CHAR, :OLD.STAATU));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MOTRAI', CONVERT(NUMBER_TO_CHAR, :OLD.MOTRAI));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NROAUT', :OLD.NROAUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOEM', CONVERT(NUMBER_TO_CHAR, :OLD.CODOEM));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSUB', :OLD.CODSUB);
		SP_DATSTR(:OLD.DATPER, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPER', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITINI', CONVERT(NUMBER_TO_CHAR, :OLD.SITINI));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RISNEX', :OLD.RISNEX);
		SP_DATSTR(:OLD.DATNEX, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATNEX', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAPRV', CONVERT(NUMBER_TO_CHAR, :OLD.DIAPRV));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCUA', CONVERT(NUMBER_TO_CHAR, :OLD.CODCUA));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TMACUA', CONVERT(NUMBER_TO_CHAR, :OLD.TMACUA));
		SP_DATSTR(:OLD.DATPAR, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPAR', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIABLQ', CONVERT(NUMBER_TO_CHAR, :OLD.DIABLQ));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQREG', CONVERT(NUMBER_TO_CHAR, :OLD.SEQREG));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HRTRCS', CONVERT(NUMBER_TO_CHAR, :OLD.HRTRCS));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDOE', :OLD.CODDOE);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCID', :OLD.CODCID);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR, :OLD.CODATE));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ACITRA', CONVERT(NUMBER_TO_CHAR, :OLD.ACITRA));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EFERET', :OLD.EFERET);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENCAFA', CONVERT(NUMBER_TO_CHAR, :OLD.ENCAFA));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPSUC', CONVERT(NUMBER_TO_CHAR, :OLD.TIPSUC));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CGCSUC', CONVERT(NUMBER_TO_CHAR, :OLD.CGCSUC));
		SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITORI', CONVERT(NUMBER_TO_CHAR, :OLD.SITORI));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MOTALT', :OLD.MOTALT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMATE', :OLD.NOMATE);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORGCLA', CONVERT(NUMBER_TO_CHAR, :OLD.ORGCLA));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REGCON', :OLD.REGCON);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCON', :OLD.ESTCON);
