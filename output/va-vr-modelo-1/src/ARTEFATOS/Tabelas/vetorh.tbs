Ã␀␀PROCEDURE SP_TAB_ESOCIAL(P_LAYOUTALTERACAO VARCHAR2(6), P_EMPRESA NUMBER(4), P_TIPOCOLABORADOR NUMBER(1), P_COLABORADOR NUMBER(9), P_DATAINICIOHISTORICO DATE, P_DATAFIMHISTORICO DATE, P_TABELAHISTORICO VARCHAR2(7), P_ACAO VARCHAR2(1), P_VALORJSON VARCHAR2(2000), P_VALORJSON2 VARCHAR2(2000), P_PENEXT NUMBER(1), P_ORIGEM VARCHAR2(60))
 IS

	l_DataInicioEsocial DATE;
	l_DataInicioTabelas DATE;
	l_DataInicioNaoPeriodicos DATE;
	l_DataInicioPeriodicos DATE;
	l_DataInicioSST DATE;
	l_DataInicioHistorico DATE;
	l_DataFimHistorico DATE;
	l_DataZero DATE;
	l_DataAdmissao DATE;
	l_DataEfetivoRetorno DATE;
	l_DataESocial DATE;
	l_LayoutOrigem VARCHAR2(6);
	l_DataInicioMigracao DATE;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	
	l_DataInicioHistorico := P_DATAINICIOHISTORICO;
	SP_INITEMPTY_DAT(l_DataInicioHistorico IN OUT);
	
	l_DataFimHistorico := P_DATAFIMHISTORICO;
	SP_INITEMPTY_DAT(l_DataFimHistorico IN OUT);

	RH_DEF_ESOCIAL(P_EMPRESA, l_DataInicioTabelas OUT, l_DataInicioEsocial OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
	RH_RET_DATADM(P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, l_DataAdmissao OUT);
	RH_RET_DATRET(P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, l_DataEfetivoRetorno OUT);
	RH_LAYOUTCOLAB(P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, l_LayoutOrigem OUT);
	
	IF (l_DataAdmissao > l_DataInicioNaoPeriodicos) THEN
		l_DataESocial := l_DataAdmissao;
	ELSE
		l_DataESocial := l_DataInicioNaoPeriodicos;
	END IF;
	
	IF (l_DataESocial < l_DataEfetivoRetorno) THEN
		l_DataESocial := l_DataEfetivoRetorno;
	END IF;
	
	/* Se o histórico iniciar antes do eSocial, ele pode estar vigente durante o eSocial. Neste caso será criada uma pendência para o leiaute original */
	IF (l_DataInicioHistorico < l_DataESocial) THEN
		/* Verifica se a data de término está dentro do eSocial */	
		IF ((l_DataFimHistorico >=	l_DataESocial) OR (l_DataFimHistorico = l_DataZero))THEN
			/* Cria uma pendência de retificação para o leiaute inicial e outra para verificar a retificação do leiaute de alteração cadastral/contratual */
			IF (l_DataEfetivoRetorno = l_DataZero) THEN
			   SP_E_SOCIAL(l_LayoutOrigem, P_TABELAHISTORICO, 'N', P_ACAO, NULL, NULL, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataESocial, P_PENEXT, P_ORIGEM);		
			ELSE
			   SP_E_SOCIAL(P_LAYOUTALTERACAO, P_TABELAHISTORICO, 'N', P_ACAO, l_DataESocial, l_DataFimHistorico, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataESocial, P_PENEXT, P_ORIGEM);
			END IF;  			   
			IF ((l_DataFimHistorico > l_DataESocial) OR (l_DataFimHistorico = l_DataZero)) THEN
				SP_E_SOCIAL(P_LAYOUTALTERACAO, P_TABELAHISTORICO, 'N', P_ACAO, l_DataESocial, l_DataFimHistorico, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataESocial, P_PENEXT, P_ORIGEM);
			END IF;
		END IF;
	ELSE
		/* Se a data do histórico for igual à data do envio inicial, cria uma pendência de retificação para o leiaute inicial e outra para o leiaute de alteração cadastral/contratual no dia posterior ao do envio inicial */
		IF (l_DataInicioHistorico = l_DataESocial) THEN
			/* Cria uma pendência de retificação para o leiaute inicial e outra para verificar a retificação do leiaute de alteração cadastral/contratual para envios que não são de Reintegração. */
			IF (l_DataEfetivoRetorno = l_DataZero) THEN
			   SP_E_SOCIAL(l_LayoutOrigem, P_TABELAHISTORICO, 'N', P_ACAO, NULL, NULL, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataESocial, P_PENEXT, P_ORIGEM);
			ELSE
			   SP_E_SOCIAL(P_LAYOUTALTERACAO, P_TABELAHISTORICO, 'N', P_ACAO, l_DataESocial, l_DataFimHistorico, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataESocial, P_PENEXT, P_ORIGEM);
			END IF;	
			
			IF ((l_DataFimHistorico > l_DataESocial) OR (l_DataFimHistorico = l_DataZero)) THEN	
				SP_E_SOCIAL(P_LAYOUTALTERACAO, P_TABELAHISTORICO, 'N', P_ACAO, l_DataInicioHistorico, l_DataFimHistorico, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataInicioHistorico, P_PENEXT, P_ORIGEM);
			END IF;
		ELSE
			SP_E_SOCIAL(P_LAYOUTALTERACAO, P_TABELAHISTORICO, 'N', P_ACAO, l_DataInicioHistorico, l_DataFimHistorico, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataInicioHistorico, P_PENEXT, P_ORIGEM);
		END IF;
	END IF;
END␀òø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
u␀␀/* parâmetro de entrada */
PROCEDURE SP_TAMSTR(P_PARENT NUMBER,P_PARSAI OUT VARCHAR2(255))
 IS

	l_tamstr      NUMBER(2);
    l_auxtam      NUMBER(2);   
    l_tamaux      NUMBER(2);    
    l_mascara     VARCHAR2(255);
BEGIN  
    l_mascara := '';
    l_tamaux  := 0;
    l_auxtam  := 1;
    l_tamstr  := Length(CONVERT(NUMBER_TO_CHAR, p_parEnt));

    IF (l_tamstr > 0) THEN
	    LOOP        
	        l_mascara := l_mascara || '9';
	    	l_auxtam := l_auxtam+1;
	        IF  (l_auxtam > l_tamstr) THEN
	         	EXIT;    	
	        END IF;
	    END LOOP;
	END IF;
    	
    p_parSai := l_mascara;
END␀óø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_LAYOUTCOLAB
␀␀PROCEDURE SP_TEMREGISTRO_VIN(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_TEM IN OUT BOOLEAN)
 IS

  L_SEQADM    R350ADM.SEQADM%TYPE;
  L_SEQSVI    R350SVI.SEQSVI%TYPE;
  L_LAYOUT  VARCHAR2(10);

BEGIN
  P_TEM := FALSE;
  
  RH_LAYOUTCOLAB(P_NUMEMP, P_TIPCOL, P_NUMCAD, L_LAYOUT OUT);
  
  IF (L_LAYOUT IS NOT NULL) THEN

    IF (L_LAYOUT = 'S-2200') THEN
      P_TEM := TRUE;
      BEGIN
        SELECT SEQADM INTO L_SEQADM FROM R350ADM
        WHERE NUMEMP = P_NUMEMP
          AND TIPCOL = P_TIPCOL
          AND NUMCAD = P_NUMCAD
          AND ENVVAL = 'S';
        EXCEPTION WHEN NO_DATA_FOUND THEN
          P_TEM := FALSE;
        WHEN OTHERS THEN
          P_TEM := FALSE;
      END; 
    END IF;  
  
    IF (L_LAYOUT = 'S-2300') THEN
      P_TEM := TRUE;
	  BEGIN
        SELECT SEQSVI INTO L_SEQSVI FROM R350SVI
        WHERE NUMEMP = P_NUMEMP
          AND TIPCOL = P_TIPCOL
          AND NUMCAD = P_NUMCAD
          AND ENVVAL = 'S';
        EXCEPTION WHEN NO_DATA_FOUND THEN
          P_TEM := FALSE;
        WHEN OTHERS THEN
          P_TEM := FALSE;
      END; 
    END IF;
  
  END IF;
END␀ôø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
(␀␀PROCEDURE SP_TPCARGO_ESFINGE(P_NUMEMP NUMBER(4), P_TIPO_QUADRO NUMBER(4), P_CODIGO_CARGO VARCHAR2(16), P_DATA_INICIO_VIGENCIA DATE, P_TIPO_CARGO_ESFINGE OUT NUMBER)
 IS

  l_TipCar NUMBER;
BEGIN
  BEGIN
    SELECT R304ACF.TIPCAR
      INTO l_TipCar
      FROM R304ACF
     WHERE R304ACF.NUMEMP = p_numemp
       AND R304ACF.TIPQUA = p_tipo_quadro
       AND R304ACF.CARFUN = p_codigo_cargo
       AND R304ACF.DATINI = p_data_inicio_vigencia
       AND R304ACF.TIPENV = 1
       AND R304ACF.TIPATU = 1
       AND R304ACF.SEQREG = (SELECT MAX(ACF2.SEQREG)
       	                     FROM R304ACF ACF2
       	                     WHERE ACF2.NUMEMP = R304ACF.NUMEMP
       	                       AND ACF2.TIPQUA = R304ACF.TIPQUA
       	                       AND ACF2.CARFUN = R304ACF.CARFUN
       	                       AND ACF2.DATINI = R304ACF.DATINI
       	                       AND ACF2.TIPENV = 1
       	                       AND ACF2.TIPATU = 1
       	                       AND EXISTS (SELECT 1 FROM R304STA STA2
       	                       	           WHERE STA2.PIDSTA = ACF2.PIDSTA
       	                       	             AND STA2.STAENV = 'E'))
       AND EXISTS (SELECT 1 FROM R304STA
       	           WHERE R304STA.PIDSTA = R304ACF.PIDSTA
       	           AND R304STA.STAENV = 'E');
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      BEGIN
        SELECT MAX(R304ACF.TIPCAR)
        INTO l_TipCar
        FROM R304ACF
        WHERE R304ACF.NUMEMP = p_numemp
          AND R304ACF.TIPQUA = p_tipo_quadro
          AND R304ACF.CARFUN = p_codigo_cargo
          AND R304ACF.DATINI = p_data_inicio_vigencia
          AND R304ACF.TIPENV = 1
          AND R304ACF.TIPATU = 1;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_TipCar := 0;
      END;
  END;
  
  p_tipo_cargo_esfinge := l_TipCar;
END␀õø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_INTSTR
