        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPCOL', CONVERT(NUMBER_TO_CHAR,:OLD.TIPCOL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPCOL', CONVERT(NUMBER_TO_CHAR,:NEW.TIPCOL));
