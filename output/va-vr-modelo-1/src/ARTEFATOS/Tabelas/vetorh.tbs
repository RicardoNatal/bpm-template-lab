          END IF;
      END IF;
  /*Atualiza as permissões de áreas restritas*/
  ELSE
      IF (l_tecpri <> 0) THEN
          /*Atualiza o Crachá de Barras se exisir*/
          IF (l_numbar <> 0) AND (l_tecpri <> 1) THEN
              BEGIN
                  UPDATE R070CON SET PRMRT1 = p_prmrt1, PRMRT2 = p_prmrt2, PRMRT3 = p_prmrt3
                  WHERE NUMFIS = l_numbar;
              EXCEPTION
                  WHEN OTHERS THEN NULL;
              END;
          END IF;
          /*Atualiza o Crachá de Proximidade se exisir*/
          IF (l_numpro <> 0) AND (l_tecpri <> 2)THEN
              BEGIN
                  UPDATE R070CON SET PRMRT1 = p_prmrt1, PRMRT2 = p_prmrt2, PRMRT3 = p_prmrt3
                  WHERE NUMFIS = l_numpro;
              EXCEPTION
                  WHEN OTHERS THEN NULL;
              END;
          END IF;
          /*Atualiza o Crachá Smart se exisir*/
          IF (l_numsma <> 0) AND (l_tecpri <> 3) THEN
              BEGIN
                  UPDATE R070CON SET PRMRT1 = p_prmrt1, PRMRT2 = p_prmrt2, PRMRT3 = p_prmrt3
                  WHERE NUMFIS = l_numsma;
              EXCEPTION
                  WHEN OTHERS THEN NULL;
              END;
          END IF;
      END IF;
  END IF;
END␀ıø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀␀PROCEDURE SP_USAFRONLINE(P_USAONLINE OUT BOOLEAN,P_USALIBVEI OUT NUMBER(1))
 IS

  l_froonl      CHAR(1);
  l_libvei      NUMBER(1);
BEGIN
  p_usaonline := FALSE;
  p_usalibvei := 0;
  BEGIN
     SELECT FROONL,LIBVEI INTO l_froonl,l_libvei FROM R088DFR;
  EXCEPTION
     WHEN NO_DATA_FOUND THEN
     l_froonl := 'N';
     l_libvei := 0;
  END;
  IF (l_froonl = 'S') THEN
    p_usaonline := TRUE;
  END IF;
  IF (l_libvei < 1) THEN
    l_libvei := 1;
  END IF;
  p_usalibvei := l_libvei;
END␀şø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
