    l_datTemp VARCHAR(10);
BEGIN
	/* eSocial S-2220 - Início */
	l_Valor := '';
    
	IF (:NEW.SitExa = 'R') THEN /* 'R' = Realizado */
		IF ((:NEW.AteAso > 0) AND (:NEW.NumAte > 0)) THEN
			RH_RETATNFICMED(:NEW.NumEmp, :NEW.CodFic, :NEW.DatSol, l_TipAtn OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
			RH_RETFICMED(:NEW.NumEmp, :NEW.CodFic,l_AtnFic OUT, l_TipCol OUT, l_NumCad OUT, l_CodDep OUT, l_NumCan OUT);
			IF (l_TipAtn = 1) OR (l_AtnFic = 1) THEN /* 1 - Colaborador */			
				RH_RETENVESO(:NEW.NumEmp, :NEW.AteAso, :NEW.NumAte, l_EnvEso OUT);
						
				IF (l_EnvEso = 'S') THEN			   
	   				RH_RETDATATE(:NEW.NumEmp, :NEW.AteAso, :NEW.NumAte, l_DataASO OUT);
    	
					SP_CONCATENAR_NUM('CODATE', :NEW.AteAso, l_Valor OUT);
					SP_CONCATENAR_NUM('NUMATE', :NEW.NumAte, l_Valor OUT);
					SP_CONCATENAR_DAT('DATASO', l_DataASO, l_Valor OUT);
		    		    	
					SP_E_SOCIAL_SM('S-2220', 'R108RES', 'N', 'I', NULL, NULL, :NEW.NumEmp, l_TipCol, l_NumCad, l_Valor, '', 0, NULL, l_DataASO, 0, 'R108RES_AI');
				END IF;  			
			END IF;
		END IF;
	END IF;
	/* eSocial S-2220 - Fim */
	
	/*Log INSERT - Inicio*/
	l_codSistema := 1;
	l_codcpa := 130;
	l_codtpa := 391;
	/* INSERT (NEW) */ 
  	SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R108RES_AI', '');

      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIC));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEXA', CONVERT(NUMBER_TO_CHAR, :NEW.CODEXA));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATSOL', CONVERT(DATE_TO_CHAR, :NEW.DATSOL));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R108RES_AI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      
      BEGIN
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORIEXA', CONVERT(NUMBER_TO_CHAR, :NEW.ORIEXA));
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATMAR', CONVERT(DATE_TO_CHAR, :NEW.DATMAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORMAR', CONVERT(NUMBER_TO_CHAR, :NEW.HORMAR));
