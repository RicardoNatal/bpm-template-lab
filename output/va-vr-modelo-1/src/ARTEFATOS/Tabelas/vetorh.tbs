    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'documento', p_NUMDOC);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'tipoVisita', l_TIPVISStr);
