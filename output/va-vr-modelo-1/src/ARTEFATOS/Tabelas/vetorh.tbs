    l_tem_dsp_fac NUMBER(1);
BEGIN
    SP_USARFA_CAN(:NEW.NUMCAN, l_deve_enviar OUT);
    IF (l_deve_enviar = 1) THEN
      SP_CHECKDSP_PEND82(l_tem_dsp_fac OUT);
      IF (l_tem_dsp_fac = 1) THEN
        SP_INTSTR(:NEW.NUMCAN, '9999999', l_numcan OUT);
        l_idtpes:= '13'||l_numcan;

        /*Preenche o campo com espaços para completar 23 posições*/
        l_idtpes := LTRIM(l_idtpes);
        l_idtpes := RTRIM(l_idtpes);
        LOOP
          /*Controle do Loop.*/
          IF (LENGTH(l_idtpes) > 22) THEN
            EXIT;
          END IF;
          l_idtpes := ' '||l_idtpes;
        END LOOP;

        SP_PEND82(l_idtpes, 2);
      END IF;
    END IF;
END␀à␀␀		SENIOR;04␀␀

TRIGGER R122FOT_EU AFTER UPDATE ON R122FOT FOR EACH ROW DECLARE
    l_numcan VARCHAR2(7);
    l_idtpes VARCHAR2(23);
