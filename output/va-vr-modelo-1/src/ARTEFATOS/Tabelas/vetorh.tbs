DECLARE
l_online BOOLEAN;
l_idtpes VARCHAR(23);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) AND (:NEW.STAACC = 1) THEN
    R070BLO_ATUCON('I', :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODMOT);
  END IF;

  /* Geração de pendência de bloqueio do acesso p/ o Ronda senior X */
  IF (:NEW.INTEGR IS NULL) OR (:NEW.INTEGR = 'N') THEN
    SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_SAM_PENDENCIES(46, 1, l_idtpes);
  END IF;
END␀hÙ␀␀		SENIOR;0b␀␀

TRIGGER R070BLO_EU AFTER UPDATE ON R070BLO FOR EACH ROW

DECLARE
l_online BOOLEAN;
l_idtpes VARCHAR(23);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) THEN
    IF (:NEW.DATLIB <> :OLD.DATLIB) OR
       ((:NEW.DATLIB = :OLD.DATLIB) AND (:NEW.HORLIB <> :OLD.HORLIB)) OR
       (:NEW.STAACC <> :OLD.STAACC) THEN
      IF (:NEW.STAACC = 1) THEN
        R070BLO_ATUCON('I', :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODMOT);
      ELSE
        R070BLO_ATUCON('U', :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODMOT);
      END IF;
    END IF;
  END IF;

  /* Geração de pendência de bloqueio do acesso p/ o Ronda senior X */
  IF (:NEW.INTEGR IS NULL) OR (:NEW.INTEGR = 'N') THEN
    SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_SAM_PENDENCIES(46, 2, l_idtpes);
  END IF;
END␀fÙ␀␀		SENIOR;0ó␀␀

