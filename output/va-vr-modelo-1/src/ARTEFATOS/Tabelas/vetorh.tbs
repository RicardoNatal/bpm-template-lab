7␀␀PROCEDURE SP_ATUCONTFUNC(P_TIPOPE CHAR,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_NUMCRA NUMBER(12))
 IS

  l_codfun       CHAR(2);
  l_estcar       NUMBER(4);
  l_codcar       VARCHAR2(24);
  l_nodatafound  BOOLEAN;
  l_cntfnc       CHAR(1);
  l_usutel       VARCHAR(31);
  l_comando      VARCHAR(2048);
  l_icardA       VARCHAR2(12);
  l_icardR       VARCHAR2(12);
  l_numser       VARCHAR2(12);
  l_idtcol       CHAR(23);

/* CURSOR c/ as funções do cargo do colaborador */
  CURSOR c_r058frc IS
         SELECT codfra FROM R058FRC
         WHERE ESTCAR = l_estcar AND CODCAR = l_codcar;

  TYPE t_r058frc IS RECORD(
    codfra   R058FRC.CODFRA%TYPE);

  l_r058frc t_r058frc;

BEGIN
  SP_USUTEL(l_usutel OUT);
  /*Verifica se Possui o campo Atuali*/
  BEGIN
      SELECT CNTFNC INTO l_cntfnc FROM R070TSI;
  EXCEPTION
    WHEN OTHERS THEN
      l_cntfnc := 'N';
  END;

  IF (l_cntfnc = 'S') THEN
      /* Monto o idtpes, e com ele busco o ICARD a ser utilizado */
      SP_RETIDTPES(p_numemp, p_tipcol, p_numcad, NULL, NULL, NULL, NULL, l_idtcol OUT);
      SP_RETICARD(l_idtcol, p_numcra, l_icardA OUT, l_icardR OUT, l_numser OUT);
      
      IF  p_tipope <> 'D' THEN
          l_nodatafound := FALSE;
          BEGIN
              SELECT ESTCAR, CODCAR INTO l_estcar, l_codcar FROM R038HCA A
               WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad
               AND DATALT = (SELECT MAX(DATALT) FROM R038HCA WHERE NUMEMP = A.NUMEMP AND TIPCOL = A.TIPCOL AND NUMCAD = A.NUMCAD);
          EXCEPTION
              WHEN TOO_MANY_ROWS THEN RAISERROR 103 'Erro em R038HCA - TOO MANY ROWS';
              WHEN NO_DATA_FOUND THEN l_nodatafound := TRUE;
              WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no SELECT em R038HCA.';
          END;

          /* Apaga todos os registros antes de inserir os novos */
          IF  l_nodatafound = FALSE THEN
              BEGIN
                l_comando := 'DELETE FROM '||l_usutel||'CONTFUNC WHERE ICARD = '''||l_icardA||'''';
                SP_CMDTSI(l_comando);
              EXCEPTION
                  WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no delete tabela CONTFUNC.';
              END;

              FOREACH c_r058frc INTO l_r058frc.codfra      /* Le Registro do CURSOR */
              /* Insere registros na tabela ContFunc */
              LOOP
                  SP_INTSTR(l_r058frc.codfra,'99',l_codfun OUT);
                  BEGIN
                    l_comando := 'INSERT INTO '||l_usutel||'CONTFUNC (ICARD,CODFUNC) VALUES ('''||l_icardA||''','''||l_codfun||''')';
                    SP_CMDTSI(l_comando);
                  EXCEPTION
                      WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no INSERT Tabela CONTFUNC.';
                  END;
              END LOOP;
          END IF;
      ELSE
          BEGIN
            l_comando := 'DELETE FROM '||l_usutel||'CONTFUNC WHERE ICARD = '''||l_icardA||'''';
            SP_CMDTSI(l_comando);
          EXCEPTION
              WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no delete tabela CONTFUNC.';
          END;
      END IF;
  END IF;
END		SENIOR;23<SP_USUTEL
SP_INTSTR
SP_CMDTSI
SP_RETIDTPES
SP_RETICARD
7␀␀PROCEDURE SP_ATUCONTFUNC(P_TIPOPE CHAR,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_NUMCRA NUMBER(12))
