ÅPROCEDURE SP_REPEMPR001(P_TIPOPE NUMBER(1),P_TIPINS NUMBER(1),P_NUMCGC NUMBER(14),P_INSCEI NUMBER(12),P_RAZSOC VARCHAR2(40),P_OLD_TIPINS NUMBER(1),P_OLD_NUMCGC NUMBER(14))
 IS
BEGIN
  NULL;
END		SENIOR;20!SP_USUTEL
SP_INTSTR
SP_CMDTSI
␀␀/* Atualiza as permissões da tabela REPEMPR001 */
PROCEDURE SP_REPEMPR001(P_TIPOPE NUMBER(1),P_TIPINS NUMBER(1),P_NUMCGC NUMBER(14),P_INSCEI NUMBER(12),P_RAZSOC VARCHAR2(40),P_OLD_TIPINS NUMBER(1),P_OLD_NUMCGC NUMBER(14))
 IS

l_ident        VARCHAR2(14);
  l_old_ident    VARCHAR2(14);
  l_tipo_id      VARCHAR2(1);
  l_old_tipo_id  VARCHAR2(1);
  l_cei          VARCHAR2(12);
  l_rsocial      VARCHAR2(40);
  l_local_serv   VARCHAR2(100);
  l_comando      VARCHAR2(2048);
  l_utirep       VARCHAR2(1);
  l_usutel       VARCHAR(31);
BEGIN
  SP_USUTEL(l_usutel OUT);
  BEGIN
      SELECT UTIREP INTO l_utirep FROM R070TSI;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN RAISERROR 103 'SP_REPEMPR001: Não encontrou registro na tabela R070TSI';
      WHEN OTHERS        THEN RAISERROR 103 'SP_REPEMPR001: Não foi possível obter definições da tabela R070TSI';
  END;     

  /*Se possui a tabelas REP então realiza o processamento*/
  IF (l_utirep = 'S') THEN

      /*Como a chave da tabela da telemática é diferente da R030FIL, é necessário realizar este tratamento*/
      l_old_ident := CONVERT(NUMBER_TO_CHAR, p_old_numcgc);
      l_old_ident := lTrim(l_old_ident);
      l_old_ident := rTrim(l_old_ident);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_old_ident) > 13) THEN
              EXIT;
          END IF;
          l_old_ident := '0'||l_old_ident;
      END LOOP;

      SP_INTSTR(p_old_tipins, '9', l_old_tipo_id OUT);
      BEGIN
          /*Deleta a tabela REPEMPR001*/
	IF (p_old_numcgc > 0) THEN
          l_comando := 'DELETE FROM '||l_usutel||'REPEMPR001 WHERE IDENT = '''||l_old_ident||''' AND TIPO_ID = '''||l_old_tipo_id||'''';
          SP_CMDTSI(l_comando);
	END IF;
      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;

      IF (p_tipope <> 3) THEN
          /*Realiza conversões...*/
          l_ident := CONVERT(NUMBER_TO_CHAR, p_numcgc);

          l_ident := lTrim(l_ident);
          l_ident := rTrim(l_ident);
          LOOP
              /*Controle do Loop.*/
              IF (Length(l_ident) > 13) THEN
                  EXIT;
              END IF;
              l_ident := '0'||l_ident;
          END LOOP;

          SP_INTSTR(p_tipins, '9', l_tipo_id OUT);
          SP_INTSTR(p_inscei, '999999999999', l_cei OUT);
          l_rsocial := p_razsoc;
          l_local_serv := ' ';
		  IF (p_numcgc > 0) THEN
			  BEGIN
				  l_comando := 'DELETE FROM '||l_usutel||'REPEMPR001 WHERE IDENT = '''||l_ident||''' AND TIPO_ID = '''||l_tipo_id||'''';
				  SP_CMDTSI(l_comando);

				  /*Insere a empresa na tabela REPEMPR001*/
				  l_comando := 'INSERT INTO '||l_usutel||'REPEMPR001 (IDENT, TIPO_ID, CEI, RSOCIAL, LOCAL_SERV) ';
				  l_comando := l_comando || 'VALUES ('''||l_ident||''','''||l_tipo_id||''','''||l_cei||''','''||l_rsocial||''','''||l_local_serv||''')';
				  SP_CMDTSI(l_comando);
			  EXCEPTION
				  WHEN OTHERS THEN RAISERROR 103 'SP_REPEMPR001: Erro ao inserir registro na tabela RepEmpr001';
			  END;
		  END IF;
      END IF;
  END IF;
END		SENIOR;23!SP_USUTEL
