TRIGGER R058POR_EU AFTER UPDATE ON R058POR FOR EACH ROW
DECLARE
  l_codPor CHAR(3);	
BEGIN
  IF (:NEW.UtiPor = 'S') THEN
    SP_PEND87('2', :NEW.CodPor, :NEW.DesPor, :NEW.PerAgv, :NEW.SelPor, :NEW.VisLma, :NEW.QtdVis,
                   :NEW.HorVis, :NEW.UtiWav, :NEW.UtiVei, :NEW.ObrFmv, :NEW.ModBio, :NEW.LeiDoc,
                   :NEW.LeiAut, :NEW.FotPes, :NEW.PerBcr, :NEW.AgeAut, :NEW.PerSAc, :NEW.TipPNG, 
                   :NEW.DocObr, :NEW.VerPlf, :NEW.CodPlf);
  END IF;

  IF (:OLD.UtiPor = 'S' AND :NEW.UtiPor = 'N') THEN
    SP_PEND87('3', :NEW.CodPor, :NEW.DesPor, :NEW.PerAgv, :NEW.SelPor, :NEW.VisLma, :NEW.QtdVis,
                   :NEW.HorVis, :NEW.UtiWav, :NEW.UtiVei, :NEW.ObrFmv, :NEW.ModBio, :NEW.LeiDoc,
                   :NEW.LeiAut, :NEW.FotPes, :NEW.PerBcr, :NEW.AgeAut, :NEW.PerSAc, :NEW.TipPNG, 
                   :NEW.DocObr, :NEW.VerPlf, :NEW.CodPlf);
  END IF;
  
  SP_INTSTR(:NEW.CodPor, '999', l_codPor OUT);
  SP_SAM_PENDENCIES(21, 2, l_codPor);
END␀ñ×␀␀		SENIOR;0U␀␀

