À␀␀CREATE OR REPLACE PROCEDURE ExecSql3
( p_sqltex        IN VARCHAR2,
  p_numcra        OUT CHAR,
  p_sequencia     OUT NUMBER
) IS
  L_SOUCUR INTEGER;
  l_ret           INTEGER;
  l_numcra        CHAR(12);
  l_sequencia     NUMBER;
BEGIN
  L_SOUCUR := dbms_sql.open_cursor;
  BEGIN
    DBMS_SQL.PARSE(L_SOUCUR,p_sqltex,DBMS_SQL.V7);
    /* define colunas do select */
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR, 1, l_numcra, 12);
    DBMS_SQL.DEFINE_COLUMN(L_SOUCUR, 2, l_sequencia);
    l_ret:=DBMS_SQL.Execute_And_Fetch(L_SOUCUR,True);
    /* pega o valor das colunas */
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR, 1, l_numcra);
    DBMS_SQL.COLUMN_VALUE(L_SOUCUR, 2, l_sequencia);
    DBMS_SQL.CLOSE_CURSOR(L_SOUCUR);
    p_numcra:=l_numcra;
    p_sequencia:=l_sequencia;
  EXCEPTION
     WHEN TOO_MANY_ROWS THEN
      /* fecha o cursor */
       DBMS_SQL.CLOSE_CURSOR(L_SOUCUR);
       RAISE TOO_MANY_ROWS;
     WHEN NO_DATA_FOUND THEN
      /* fecha o cursor */
       DBMS_SQL.CLOSE_CURSOR(L_SOUCUR);
       RAISE NO_DATA_FOUND;
     WHEN OTHERS THEN
      /* fecha o cursor */
       DBMS_SQL.CLOSE_CURSOR(L_SOUCUR);
      raise_application_error(-20000 + -(103),SQLERRM);
  END;
END;

