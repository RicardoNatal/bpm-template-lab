{␀Æÿ␀␀}ß␀␀␀¥ï␀␀=€␀␀␀␀␀␀úï␀␀çï␀␀çï␀␀c␀␀␀␀ÿ␀␀ÿ␀Ü–␀␀F€␀␀␀␀␀␀ş–␀␀Ş–␀␀ğ–␀␀7␀␀ÿ␀␀ÿ␀␀ ␀␀B€␀␀␀␀␀␀œ ␀␀• ␀␀™ ␀␀n␀Æÿ␀␀ÿ␀ßp±␀€␀␀␀␀␀␀ğpïpğpO)␀␀Æÿ␀␀ÿ␀yú␀␀¹␀€␀␀␀␀␀␀|ú␀␀zú␀␀{ú␀␀Q)␀␀Æÿ␀␀ÿ␀òs½␀€␀␀␀␀␀␀õsósôsq)␀␀Æÿ␀␀ÿ␀¬’␀␀Ÿ€␀␀␀␀␀␀Õ“␀␀Ó“␀␀Ô“␀␀n␀Æÿ␀␀ÿ␀_³␀␀*€␀␀␀␀␀␀È´␀␀(³␀␀²´␀␀?␀␀ÿ␀␀ÿ␀œ␀¹␀€␀␀␀␀␀␀¡␀›␀ ␀Q)␀␀Æÿ␀␀ÿ␀?,€␀␀␀␀␀␀CZ"Z"␀␀␀ÿ␀␀ä␀␀␀ê␀‚␀€␀␀␀␀␀␀Û÷␀␀J␀J␀9␀␀ÿ␀␀ÿ␀è␀‚␀€␀␀␀␀␀␀Ù÷␀␀š²␀␀š²␀␀9␀␀ÿ␀␀ÿ␀ç␀‚␀€␀␀␀␀␀␀Ø÷␀␀%%9␀␀ÿ␀␀ÿ␀é␀‚␀€␀␀␀␀␀␀Ú÷␀␀‡Â␀␀‡Â␀␀9␀␀ÿ␀␀ÿ␀Û–␀␀‚␀€␀␀␀␀␀␀ï–␀␀ï–␀␀ï–␀␀9␀␀ÿ␀␀ÿ␀‰qC€␀␀␀␀␀␀ŒqŒqŒqp␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3‚ß␀␀		SENIOR;0ò␀␀TRIGGER R110MAT_AI
AFTER INSERT ON R110MAT
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4); /* Código da categoria de auditoria*/
  l_codtpa NUMBER(4); /* Código do tipo de auditoria - Inclusão*/
  l_datTemp VARCHAR(10);
BEGIN
  l_codSistema := 1;
  l_codcpa := 142;  /* Código da categoria de auditoria - Atendimentos*/
  l_codtpa := 415;  /* Código do tipo de auditoria - Incluir/Excluir*/

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110MAT_AI', '');

    /* Insere os campos chave na tabela de auditoria R995PRC*/
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:NEW.CODFIC));
      SP_DATSTR(:NEW.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR,:NEW.HORATE));
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110MAT_AI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    /* Insere os valores dos campos na tabela de auditoria R995PRT*/
    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');  /* Operação*/
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPATE', CONVERT(NUMBER_TO_CHAR,:NEW.TIPATE));
