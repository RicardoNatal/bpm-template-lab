TRIGGER R304PCP_SI AFTER INSERT ON R304PCP
DECLARE
	CURSOR c_R304PCP IS
	SELECT NUMEMP, NUMATO, DATATO, NUMMAT, NUMCPF, CODUNI, SEQPRO, SEQREG
	  FROM R304PCP
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304PCP IS RECORD (
		NUMEMP   R304PCP.NumEmp%TYPE,
		NUMATO   R304PCP.NUMATO%TYPE,
		DATATO   R304PCP.DATATO%TYPE,
		NUMMAT   R304PCP.NUMMAT%TYPE,
		NUMCPF   R304PCP.NUMCPF%TYPE,
		CODUNI   R304PCP.CODUNI%TYPE,
		SEQPRO   R304PCP.SEQPRO%TYPE,
		SEQREG   R304PCP.SEQREG%TYPE
	);
    
    l_R304PCP t_R304PCP;
    l_PidSta VARCHAR2(30);
    l_MsgErr VARCHAR2(255);
BEGIN
	FOREACH c_R304PCP INTO l_R304PCP.NumEmp, l_R304PCP.NUMATO, l_R304PCP.DATATO, l_R304PCP.NUMMAT, l_R304PCP.NUMCPF, l_R304PCP.CODUNI, l_R304PCP.SEQPRO, l_R304PCP.SEQREG
	LOOP
		/* Busca PID gravado no registro do Concurso/Processo Seletivo */
		BEGIN
			SELECT CPE.PIDSTA INTO l_PidSta
			  FROM R304CPE CPE, R304STA STA
			 WHERE CPE.PIDSTA = STA.PIDSTA
			   AND CPE.NUMEMP = l_R304PCP.NumEmp
			   AND CPE.NUMATO = l_R304PCP.NUMATO
			   AND CPE.DATATO = l_R304PCP.DATATO
			   AND CPE.NUMMAT = l_R304PCP.NUMMAT
			   AND CPE.NUMCPF = l_R304PCP.NUMCPF
			   AND CPE.CODUNI = l_R304PCP.CODUNI
			   AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_MsgErr := 'Não existe registro de concessão pensão pendente com as seguintes chaves: ' ||
					'Empresa: ' || CONVERT(NUMBER_TO_CHAR, l_R304PCP.NumEmp) || ', Ato: ' || l_R304PCP.NUMATO || '.';
				RAISERROR 103 l_MsgErr;
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304PCP.';
		END;
		
		BEGIN
			UPDATE R304PCP
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304PCP.NumEmp
			   AND NUMATO = l_R304PCP.NUMATO
			   AND DATATO = l_R304PCP.DATATO
			   AND NUMMAT = l_R304PCP.NUMMAT
			   AND NUMCPF = l_R304PCP.NUMCPF
			   AND CODUNI = l_R304PCP.CODUNI
			   AND SEQPRO = l_R304PCP.SEQPRO
			   AND SEQREG = l_R304PCP.SEQREG;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304PCP.';
		END;
	END LOOP;
END␀¿å␀␀		SENIOR;0␀␀TRIGGER R304PCP_EI BEFORE INSERT ON R304PCP FOR EACH ROW
