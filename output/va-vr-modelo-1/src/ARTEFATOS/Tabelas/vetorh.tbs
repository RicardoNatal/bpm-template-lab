/*
 * Stored procedure responsável por atualizar todos os créditos por local físico da pessoa
 */
PROCEDURE SP_ATUCRELOC(P_IDTPES CHAR(23))
 IS

l_tippes      NUMBER(2);
  l_idtpes      VARCHAR2(23);
  l_numemp      NUMBER(4);
  l_numemp_out  NUMBER(4);
  l_tipcol      NUMBER(1);
  l_numcad      NUMBER(9);
  l_numcad_out  NUMBER(9);
  l_tipdoc      NUMBER(1);
  l_numdoc      VARCHAR2(20);
  l_tipdoc_res  NUMBER(1);
  l_numdoc_res  VARCHAR2(20);
  l_nummat      VARCHAR2(15);
  l_propac      VARCHAR2(20);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);

  /*crédito de aluno*/
  CURSOR c_Atu_r070CRX IS
       SELECT DISTINCT VERPLF,CODPLF,10 TIPPES
         FROM R070CRA
        WHERE R070CRA.NUMMAT = l_nummat
          AND R070CRA.DATINI <= l_data_atual
          AND ( R070CRA.DATFIM = l_data_zero OR R070CRA.DATFIM > l_data_atual OR
               (R070CRA.DATFIM = l_data_atual AND R070CRA.FIMFAI >= l_hora_atual) )
          AND CODPLF > 0
  /*crédito de Colaborador*/
  UNION
      (SELECT DISTINCT VERPLF,CODPLF,TIPCOL TIPPES
         FROM R070CRC
        WHERE R070CRC.NUMEMP = l_numemp
          AND R070CRC.TIPCOL = l_tipcol
          AND R070CRC.NUMCAD = l_numcad
          AND R070CRC.DATINI <= l_data_atual
          AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR
               (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual))
          AND CODPLF > 0
  /*crédito de Colaborador Outras Unidades*/
  UNION
      (SELECT DISTINCT VERPLF,CODPLF,5 TIPPES
         FROM R070CRO
        WHERE R070CRO.NUMEMP = l_numemp_out
          AND R070CRO.NUMCAD = l_numcad_out
          AND R070CRO.DATINI <= l_data_atual
          AND (R070CRO.DATFIM = l_data_zero OR R070CRO.DATFIM > l_data_atual OR
               (R070CRO.DATFIM = l_data_atual AND R070CRO.FIMFAI >= l_hora_atual))
          AND CODPLF > 0
  /*crédito de Paciente*/
  UNION
      (SELECT DISTINCT VERPLF,CODPLF,9 TIPPES
         FROM R070CRP
        WHERE R070CRP.PROPAC = l_propac
          AND R070CRP.DATINI <= l_data_atual
          AND (R070CRP.DATFIM = l_data_zero OR R070CRP.DATFIM > l_data_atual OR
               (R070CRP.DATFIM = l_data_atual AND R070CRP.FIMFAI >= l_hora_atual))
          AND CODPLF > 0
  /*crédito de Responsável de Aluno*/
  UNION
      (SELECT DISTINCT VERPLF,CODPLF,7 TIPPES
         FROM R070CRR
        WHERE R070CRR.TIPDOC = l_tipdoc_res
          AND R070CRR.NUMDOC = l_numdoc_res
          AND R070CRR.DATINI <= l_data_atual
          AND (R070CRR.DATFIM = l_data_zero OR R070CRR.DATFIM > l_data_atual OR
               (R070CRR.DATFIM = l_data_atual AND R070CRR.FIMFAI >= l_hora_atual))
          AND CODPLF > 0
  /*crédito de Visitante*/
  UNION
      (SELECT DISTINCT VERPLF,CODPLF,4 TIPPES
         FROM R070CRV
        WHERE R070CRV.TIPDOC = l_tipdoc
          AND R070CRV.NUMDOC = l_numdoc
          AND R070CRV.DATINI <= l_data_atual
          AND (R070CRV.DATFIM = l_data_zero OR R070CRV.DATFIM > l_data_atual OR
               (R070CRV.DATFIM = l_data_atual AND R070CRV.FIMFAI >= l_hora_atual) )
          AND CODPLF > 0)
          ))))
  ORDER BY 3 ASC;

  TYPE T_AtuCred IS RECORD(
    VERPLF   R070CRC.VERPLF%TYPE,
    CODPLF   R070CRC.CODPLF%TYPE,
    TIPPES NUMBER(2));
  l_atuCred T_AtuCred;
BEGIN
  l_idtpes     := LTRIM(RTRIM(p_idtpes));
  l_data_atual := CURDATE();
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_tippes     := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,1,2));
  l_numemp     := 0;
  l_numemp_out := 0;
  l_tipcol     := 0;
  l_numcad     := 0;
  l_numcad_out := 0;
  l_tipdoc     := 0;
  l_numdoc     := '';
  l_tipdoc_res := 0;
  l_numdoc_res := '';
  l_nummat     := '';
  l_propac     := '';
  
  /* BUSCA OS CAMPOS CHAVE DE ACORDO COM IDTPES */
  /*Colaborador*/
  IF (l_tippes < 4) THEN
    l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
    l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
    l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
  ELSE
    /*Visitante*/
    IF (l_tippes = 4) THEN
      l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
      l_numdoc := SUBSTRING(l_idtpes,4,20);
    ELSE
      /*Outras unidades*/
      IF (l_tippes = 5) THEN
        l_numemp_out := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
        l_numcad_out := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,9));
      ELSE
          /* Aluno */
        IF (l_tippes = 10) THEN
          l_nummat := SUBSTRING(l_idtpes,3,15);
        ELSE
          /* Responsável Aluno */
          IF (l_tippes = 7) THEN
            l_tipdoc_res := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
            l_numdoc_res := SUBSTRING(l_idtpes,4,20);
          ELSE
            /* Paciente */
            IF (l_tippes = 9) THEN
              l_propac := SUBSTRING(l_idtpes,3,20);
            END IF;
          END IF;
        END IF;
      END IF;
    END IF;
  END IF;

  IF (l_tippes > 0) THEN
      /*BUSCA TODOS OS CRÉDITOS POR LOCAL FÍSICO DA PESSOA E MANDA ATUALIZAR*/
      FOREACH c_Atu_r070CRX INTO l_atuCred.VerPlf
                                ,l_atuCred.CodPlf
                                ,l_atuCred.TipPes
      LOOP
        IF (l_tippes = l_atuCred.TipPes) THEN
          SP_PEND06(1, p_idtpes, l_atuCred.VerPlf, l_atuCred.CodPlf);
        END IF;
      END LOOP;
  END IF;
END␀ë÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
–␀␀PROCEDURE SP_ATUFIS(P_NUMCRA NUMBER,P_NUMFIS NUMBER,P_CHCPRI NUMBER,P_TECCRA NUMBER,P_TIPCRA NUMBER,P_SITCRA CHAR(1),P_INIVAL CHAR(16),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 CHAR(5),P_PRMRT2 CHAR(5),P_PRMRT3 CHAR(5),P_BLOFAL NUMBER(1),P_NUMPIS NUMBER(11),P_NOMFUN VARCHAR2(40),P_VERPRM NUMBER(1))
 IS
BEGIN
    NULL;
END		SENIOR;245SP_PESFROMIDTPES
SP_RETAUT
SP_STRTOINT
SP_RETFON
í␀␀

PROCEDURE SP_ATUFIS(P_NUMCRA NUMBER,P_NUMFIS NUMBER,P_CHCPRI NUMBER,P_TECCRA NUMBER,P_TIPCRA NUMBER,P_SITCRA CHAR(1),P_INIVAL CHAR(16),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 CHAR(5),P_PRMRT2 CHAR(5),P_PRMRT3 CHAR(5),P_BLOFAL NUMBER(1),P_NUMPIS NUMBER(11),P_NOMFUN VARCHAR2(40),P_VERPRM NUMBER(1))
 IS

  l_notfound     BOOLEAN;
  l_faixa        CHAR(56);
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_segu_atual   NUMBER(2);
  l_tippes       NUMBER(2);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);
  l_tipdoc       NUMBER(1);
  l_numdoc       VARCHAR2(20);
  l_tipdoc70con  NUMBER(1);
  l_numdoc70con  VARCHAR2(20);
  l_nummat       VARCHAR2(15);
  l_propac       VARCHAR2(20);
  l_numcan       NUMBER(7);
  l_valaut       NUMBER(1);
  l_nivatu       CHAR(5);  
  l_usabio       CHAR(1);
  l_sitcra       NUMBER;
  l_nompes       VARCHAR2(40);
  l_ddifon       NUMBER(3);
  l_dddfon       NUMBER(3);
  l_numfon       VARCHAR2(20);
BEGIN
    l_faixa      := '24002400240024002400240024002400240024002400240024002400';
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_data_atual := CURDATE();
    l_segu_atual := SECOND(CURTIME());
    l_nivatu     := '99000'; 
    l_usabio     := '0';
    SP_STRTOINT(p_sitcra, l_sitcra OUT);
    /*Atualiza R070CON*/
    l_notfound:=FALSE;
    BEGIN
        SELECT NIVATU INTO l_nivatu FROM R070CON WHERE NUMFIS = p_numfis;
    EXCEPTION
        WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUFIS: Erro em R070CON - TOO MANY ROWS.=';
        WHEN NO_DATA_FOUND THEN l_notfound:= TRUE;
        WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro No SELECT R070CON.NIVATU';
    END;
    
    IF (P_CHCPRI <> 0) THEN
        BEGIN
            SELECT USABIO, TIPDOC, NUMDOC INTO l_usabio, l_tipdoc70con, l_numdoc70con FROM R070CON WHERE NUMFIS = p_chcpri;
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro No SELECT R070CON.USABIO';
        END;
    END IF;

    /*RETORNA A PESSOA A PARTIR DO IDTPES*/
    SP_PESFROMIDTPES(p_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT, l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);
    SP_RETFON(p_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

    /* SE A SP_PESFROMIDTPES NÃO BUSCA TIPDOC/NUMDOC DO TIPO DE PESSOA, USA OS VALORES BUSCADOS NA R070CON */
    IF ((l_tippes <> 4) AND (l_tippes <> 7) AND (l_tippes <> 11)) THEN
        l_tipdoc := l_tipdoc70con;
        l_numdoc := l_numdoc70con;
    END IF;
    
    IF (l_tippes = 13) THEN 
      l_numcan := l_numcad;
      l_numcad := 0;
    END IF;

    BEGIN
        IF (l_notfound = TRUE) THEN
            /* Para colab, terceiro e parceiro, verifico se necessita de autorizador */
            l_valaut := 0;
            IF (l_tippes < 4) THEN
                SP_RETAUT(p_idtpes, l_valaut OUT);
            END IF;

            INSERT INTO R070CON(NUMCRA,NUMFIS,CHCPRI,TECCRA,TIPCRA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                                SENCOL,SITCRA,INIVAL,DATVAL,DATAFA,MSGACC,DATMSG,QTDMSG,MSGATU,CONIAL,
                                TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,CONPAC,TEMPAC,TOLACP,
                                BLOAUT,BLOFAL,FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,
                                FAIAC7,FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,FAIREF,
                                CREAC1,CREFX1,QTDCR1,CREAC2,CREFX2,QTDCR2,CREAC3,CREFX3,QTDCR3,
                                CREAC4,CREFX4,QTDCR4,CREAC5,CREFX5,QTDCR5,CREAC6,CREFX6,QTDCR6,
                                PRMRT1,DINPR1,DFNPR1,PRMRT2,DINPR2,DFNPR2,PRMRT3,DINPR3,DFNPR3,
                                INIAFA,IDTPES,GRACON,CONINT,TOLINT,NIVATU,DATNIV,HORNIV,SEQNIV,VALAUT,
                                NOMFUN,NUMPIS,CONREA,NUMEMP,TIPCOL,NUMCAD,TIPDOC,NUMDOC,NOMPES,DDIFON,DDDFON,NUMFON,
                                NUMMAT,PROPAC,NUMCAN,PROPRE)
                         VALUES(p_numcra,p_numfis,p_chcpri,p_teccra,p_tipcra,p_codprm,p_prmsab,p_prmdom,p_prmfer,
                                '     ',l_sitcra,p_inival,p_datval,'0000000000000000','                                ',
                                '0000000000000000',0,0,0,0,0, CONVERT(CHAR_TO_NUMBER, l_usabio),p_verprm,0,0,0,0,0,0,0,p_blofal,l_faixa,l_faixa,
                                l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                                l_faixa,l_faixa,l_faixa,l_faixa,0,'00000000',0,0,'00000000',0,0,'00000000',
                                0,0,'00000000',0,0,'00000000',0,0,'00000000',0, CONVERT(CHAR_TO_NUMBER, p_prmrt1),'0000000000','0000000000',
                                CONVERT(CHAR_TO_NUMBER, p_prmrt2), '0000000000','0000000000', CONVERT(CHAR_TO_NUMBER, p_prmrt3),'0000000000','0000000000',
                                '0000000000000000',p_idtpes,0,0,0,'99000',l_data_atual,l_hora_atual,l_segu_atual,l_valaut,
                                p_nomfun,p_numpis,0,l_numemp,l_tipcol,l_numcad,l_tipdoc,l_numdoc,l_nompes,l_ddifon,l_dddfon,l_numfon,
                                l_nummat,l_propac,l_numcan,0);
        ELSE
            UPDATE R070CON SET
                   NUMCRA=p_numcra,NUMFIS=p_numfis,CHCPRI=p_chcpri,TECCRA=p_teccra,TIPCRA=p_tipcra,
                   CODPRM=p_codprm,PRMSAB=p_prmsab,PRMDOM=p_prmdom,PRMFER=p_prmfer,SENCOL='     ',SITCRA=l_sitcra,
                   INIVAL=p_inival,DATVAL=p_datval,DATAFA='0000000000000000',MSGACC='                                ',
                   DATMSG='0000000000000000',QTDMSG=0,MSGATU=0,CONIAL=0,TEMALM=0,VERAFA=0,USABIO=CONVERT(CHAR_TO_NUMBER, l_usabio),GRACON=0,
                   VERPRM=p_verprm,CONFAI=0,CONADP=0,CONCRE=0,CONPAC=0,TEMPAC=0,TOLACP=0,BLOAUT=0,BLOFAL=p_blofal,FAIAC1=l_faixa,
                   FAIAC2=l_faixa,FAIAC3=l_faixa,FAIAC4=l_faixa,FAIAC5=l_faixa,FAIAC6=l_faixa,FAIAC7=l_faixa,FAIPT1=l_faixa,
                   FAIPT2=l_faixa,FAIPT3=l_faixa,FAIPT4=l_faixa,FAIPT5=l_faixa,FAIPT6=l_faixa,FAIPT7=l_faixa,
                   FAIREF=l_faixa,CREAC1=0,CREFX1='00000000',QTDCR1=0,CREAC2=0,CREFX2='00000000',QTDCR2=0,
                   CREAC3=0,CREFX3='00000000',QTDCR3=0,CREAC4=0,CREFX4='00000000',QTDCR4=0,CREAC5=0,CREFX5='00000000',
                   QTDCR5=0,CREAC6=0,CREFX6='00000000',QTDCR6=0,PRMRT1= CONVERT(CHAR_TO_NUMBER, p_prmrt1),DINPR1='0000000000',DFNPR1='0000000000',
                   PRMRT2=CONVERT(CHAR_TO_NUMBER, p_prmrt2),DINPR2='0000000000',DFNPR2='0000000000',PRMRT3=CONVERT(CHAR_TO_NUMBER, p_prmrt3),DINPR3='0000000000',
                   DFNPR3='0000000000', INIAFA='0000000000000000',IDTPES = p_idtpes,CONINT=0,TOLINT=0,NIVATU=l_nivatu,
                   DATNIV=l_data_atual,HORNIV=l_hora_atual,SEQNIV=l_segu_atual,NOMFUN=p_nomfun,NUMPIS=p_numpis,CONREA=0,
                   NUMEMP=l_numemp,TIPCOL=l_tipcol,NUMCAD=l_numcad,TIPDOC=l_tipdoc,NUMDOC=l_numdoc,NOMPES=l_nompes,DDIFON=l_ddifon,
                   DDDFON=l_dddfon,NUMFON=l_numfon,NUMMAT=l_nummat,PROPAC=l_propac,NUMCAN=l_numcan
            WHERE NUMFIS = p_numfis;
        END IF;
    EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro na Atualizaçao da Tabela R070CON';
    END;
END		SENIOR;20(SP_PESFROMIDTPES
SP_RETAUT
SP_RETFON
k%␀␀


PROCEDURE SP_ATUFIS(P_NUMCRA NUMBER,P_NUMFIS NUMBER,P_CHCPRI NUMBER,P_TECCRA NUMBER,P_TIPCRA NUMBER,P_SITCRA CHAR(1),P_INIVAL CHAR(16),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 CHAR(5),P_PRMRT2 CHAR(5),P_PRMRT3 CHAR(5),P_BLOFAL NUMBER(1),P_NUMPIS NUMBER(11),P_NOMFUN VARCHAR2(40),P_VERPRM NUMBER(1))
 IS

  l_notfound     BOOLEAN;
  l_faixa        CHAR(56);
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_segu_atual   NUMBER(2);
  l_tippes       NUMBER(2);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);
  l_tipdoc       NUMBER(1);
  l_numdoc       VARCHAR2(20);
  l_tipdoc70con  NUMBER(1);
  l_numdoc70con  VARCHAR2(20);
  l_nummat       VARCHAR2(15);
  l_propac       VARCHAR2(20);
  l_numcan       NUMBER(7);
  l_valaut       NUMBER(1);
  l_nivatu       CHAR(5);  
  l_usabio       CHAR(1);
  l_usarfastr    CHAR(1);
  l_usarfa       NUMBER(1);
  l_verafastr    CHAR(1);
  l_verafa       NUMBER(1);
  l_nompes       VARCHAR2(40);
  l_ddifon       NUMBER(3);
  l_dddfon       NUMBER(3);
  l_numfon       VARCHAR2(20);
  l_iniafa       VARCHAR2(16);
  l_datafa       VARCHAR2(16);
BEGIN
    l_faixa      := '24002400240024002400240024002400240024002400240024002400';
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_data_atual := CURDATE();
    l_segu_atual := SECOND(CURTIME());
    l_nivatu     := '99000'; 
    l_usabio     := '0';
    l_usarfastr  := 'N';
    l_usarfa     := 0;
    l_verafastr  := 'N';
    l_verafa     := 0;
    l_iniafa     := '0000000000000000';
    l_datafa     := '0000000000000000';
    /*Atualiza R070CON*/
    l_notfound:=FALSE;
    BEGIN
        SELECT NIVATU INTO l_nivatu FROM R070CON WHERE NUMFIS = p_numfis;
    EXCEPTION
        WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUFIS: Erro em R070CON - TOO MANY ROWS.=';
        WHEN NO_DATA_FOUND THEN l_notfound:= TRUE;
        WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro No SELECT R070CON.NIVATU';
    END;
    
    IF (P_CHCPRI <> 0) THEN
        BEGIN
            SELECT USABIO, TIPDOC, NUMDOC, INIAFA, DATAFA INTO l_usabio, l_tipdoc70con, l_numdoc70con, l_iniafa, l_datafa FROM R070CON WHERE NUMFIS = p_chcpri;
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro No SELECT R070CON.USABIO';
        END;
    END IF;

    /*RETORNA A PESSOA A PARTIR DO IDTPES*/
    SP_PESFROMIDTPES(p_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT, l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);
    SP_RETFON(p_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

    /* SE A SP_PESFROMIDTPES NÃO BUSCA TIPDOC/NUMDOC DO TIPO DE PESSOA, USA OS VALORES BUSCADOS NA R070CON */
    IF ((l_tippes <> 4) AND (l_tippes <> 7) AND (l_tippes <> 11)) THEN
        l_tipdoc := l_tipdoc70con;
        l_numdoc := l_numdoc70con;
    END IF;    

    IF (l_tippes < 4) THEN    
        BEGIN
            SELECT USARFA, VERAFA INTO l_usarfastr, l_verafastr  FROM R034DAC WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
        EXCEPTION
        WHEN OTHERS THEN
            l_usarfa := 0;
            l_usarfastr := 'N';
        END;
    ELSE
        IF (l_tippes = 5) THEN /* Colab. de Outra Unidade */
            BEGIN
                SELECT USARFA INTO l_usarfastr FROM R070OCR WHERE NUMEMP = l_numemp AND NUMCAD = l_numcad;
            EXCEPTION
            WHEN OTHERS THEN
                l_usarfa := 0;
                l_usarfastr := 'N';
            END;
        ELSE
            IF (l_tippes = 10) THEN /* Aluno */
                BEGIN
                    SELECT USARFA INTO l_usarfastr FROM R073ALU WHERE NUMMAT = l_nummat;
                EXCEPTION
                WHEN OTHERS THEN
                    l_usarfa := 0;
                    l_usarfastr := 'N';
                END;
            ELSE
                IF (l_tippes = 7) THEN /* Resp. de Aluno */
                    BEGIN
                        SELECT USARFA INTO l_usarfastr FROM R073RES WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
                    EXCEPTION
                    WHEN OTHERS THEN
                        l_usarfa := 0;
                        l_usarfastr := 'N';
                    END;
                ELSE
                    IF (l_tippes = 13) THEN /* Candidato */
                        l_numcan := l_numcad;
                        l_numcad := 0;

                        BEGIN
                            SELECT USARFA INTO l_usarfastr FROM R122CEX WHERE NUMCAN = l_numcan;
                        EXCEPTION
                        WHEN OTHERS THEN
                            l_usarfa := 0;
                            l_usarfastr := 'N';
                        END;
                    END IF;
                END IF;
            END IF;
        END IF;
    END IF;
    IF (l_usarfastr = 'S') THEN
        l_usarfa := 1;
    END IF;
    IF (l_verafastr = 'S') THEN
        l_verafa := 1;
    END IF;

    BEGIN
        IF (l_notfound = TRUE) THEN
            /* Para colab, terceiro e parceiro, verifico se necessita de autorizador */
            l_valaut := 0;
            IF (l_tippes < 4) THEN
                SP_RETAUT(p_idtpes, l_valaut OUT);
            END IF;

            INSERT INTO R070CON(NUMCRA,NUMFIS,CHCPRI,TECCRA,TIPCRA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                                SENCOL,SITCRA,INIVAL,DATVAL,DATAFA,MSGACC,DATMSG,QTDMSG,MSGATU,CONIAL,
                                TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,CONPAC,TEMPAC,TOLACP,
                                BLOAUT,BLOFAL,FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,
                                FAIAC7,FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,FAIREF,
                                CREAC1,CREFX1,QTDCR1,CREAC2,CREFX2,QTDCR2,CREAC3,CREFX3,QTDCR3,
                                CREAC4,CREFX4,QTDCR4,CREAC5,CREFX5,QTDCR5,CREAC6,CREFX6,QTDCR6,
                                PRMRT1,DINPR1,DFNPR1,PRMRT2,DINPR2,DFNPR2,PRMRT3,DINPR3,DFNPR3,
                                INIAFA,IDTPES,GRACON,CONINT,TOLINT,NIVATU,DATNIV,HORNIV,SEQNIV,VALAUT,
                                NOMFUN,NUMPIS,CONREA,NUMEMP,TIPCOL,NUMCAD,TIPDOC,NUMDOC,NOMPES,DDIFON,DDDFON,NUMFON,
                                NUMMAT,PROPAC,NUMCAN,PROPRE,USARFA)
                         VALUES(p_numcra,p_numfis,p_chcpri,p_teccra,p_tipcra,p_codprm,p_prmsab,p_prmdom,p_prmfer,
                                '     ',p_sitcra,p_inival,p_datval,l_datafa,'                                ',
                                '0000000000000000',0,0,0,0,l_verafa,l_usabio,p_verprm,0,0,0,0,0,0,0,p_blofal,l_faixa,l_faixa,
                                l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                                l_faixa,l_faixa,l_faixa,l_faixa,0,'00000000',0,0,'00000000',0,0,'00000000',
                                0,0,'00000000',0,0,'00000000',0,0,'00000000',0,p_prmrt1,'0000000000','0000000000',
                                p_prmrt2, '0000000000','0000000000',p_prmrt3,'0000000000','0000000000',
                                l_iniafa,p_idtpes,0,0,0,'99000',l_data_atual,l_hora_atual,l_segu_atual,l_valaut,
                                p_nomfun,p_numpis,0,l_numemp,l_tipcol,l_numcad,l_tipdoc,l_numdoc,l_nompes,l_ddifon,l_dddfon,l_numfon,
                                l_nummat,l_propac,l_numcan,0,l_usarfa);
        ELSE
            UPDATE R070CON SET
                   NUMCRA=p_numcra,NUMFIS=p_numfis,CHCPRI=p_chcpri,TECCRA=p_teccra,TIPCRA=p_tipcra,
                   CODPRM=p_codprm,PRMSAB=p_prmsab,PRMDOM=p_prmdom,PRMFER=p_prmfer,SENCOL='     ',SITCRA=p_sitcra,
                   INIVAL=p_inival,DATVAL=p_datval,DATAFA=l_datafa,MSGACC='                                ',
                   DATMSG='0000000000000000',QTDMSG=0,MSGATU=0,CONIAL=0,TEMALM=0,VERAFA=l_verafa,USABIO=l_usabio,GRACON=0,
                   VERPRM=p_verprm,CONFAI=0,CONADP=0,CONCRE=0,CONPAC=0,TEMPAC=0,TOLACP=0,BLOAUT=0,BLOFAL=p_blofal,FAIAC1=l_faixa,
                   FAIAC2=l_faixa,FAIAC3=l_faixa,FAIAC4=l_faixa,FAIAC5=l_faixa,FAIAC6=l_faixa,FAIAC7=l_faixa,FAIPT1=l_faixa,
                   FAIPT2=l_faixa,FAIPT3=l_faixa,FAIPT4=l_faixa,FAIPT5=l_faixa,FAIPT6=l_faixa,FAIPT7=l_faixa,
                   FAIREF=l_faixa,CREAC1=0,CREFX1='00000000',QTDCR1=0,CREAC2=0,CREFX2='00000000',QTDCR2=0,
                   CREAC3=0,CREFX3='00000000',QTDCR3=0,CREAC4=0,CREFX4='00000000',QTDCR4=0,CREAC5=0,CREFX5='00000000',
                   QTDCR5=0,CREAC6=0,CREFX6='00000000',QTDCR6=0,PRMRT1=p_prmrt1,DINPR1='0000000000',DFNPR1='0000000000',
                   PRMRT2=p_prmrt2,DINPR2='0000000000',DFNPR2='0000000000',PRMRT3=p_prmrt3,DINPR3='0000000000',
                   DFNPR3='0000000000', INIAFA=l_iniafa,IDTPES = p_idtpes,CONINT=0,TOLINT=0,NIVATU=l_nivatu,
                   DATNIV=l_data_atual,HORNIV=l_hora_atual,SEQNIV=l_segu_atual,NOMFUN=p_nomfun,NUMPIS=p_numpis,CONREA=0,
                   NUMEMP=l_numemp,TIPCOL=l_tipcol,NUMCAD=l_numcad,TIPDOC=l_tipdoc,NUMDOC=l_numdoc,NOMPES=l_nompes,DDIFON=l_ddifon,
                   DDDFON=l_dddfon,NUMFON=l_numfon,NUMMAT=l_nummat,PROPAC=l_propac,NUMCAN=l_numcan,USARFA=l_usarfa
            WHERE NUMFIS = p_numfis;
        END IF;
    EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro na Atualizaçao da Tabela R070CON';
    END;
END		SENIOR;21(SP_PESFROMIDTPES
SP_RETAUT
SP_RETFON
k%␀␀


PROCEDURE SP_ATUFIS(P_NUMCRA NUMBER,P_NUMFIS NUMBER,P_CHCPRI NUMBER,P_TECCRA NUMBER,P_TIPCRA NUMBER,P_SITCRA CHAR(1),P_INIVAL CHAR(16),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 CHAR(5),P_PRMRT2 CHAR(5),P_PRMRT3 CHAR(5),P_BLOFAL NUMBER(1),P_NUMPIS NUMBER(11),P_NOMFUN VARCHAR2(40),P_VERPRM NUMBER(1))
 IS

  l_notfound     BOOLEAN;
  l_faixa        CHAR(56);
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_segu_atual   NUMBER(2);
  l_tippes       NUMBER(2);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);
  l_tipdoc       NUMBER(1);
  l_numdoc       VARCHAR2(20);
  l_tipdoc70con  NUMBER(1);
  l_numdoc70con  VARCHAR2(20);
  l_nummat       VARCHAR2(15);
  l_propac       VARCHAR2(20);
  l_numcan       NUMBER(7);
  l_valaut       NUMBER(1);
  l_nivatu       CHAR(5);  
  l_usabio       CHAR(1);
  l_usarfastr    CHAR(1);
  l_usarfa       NUMBER(1);
  l_verafastr    CHAR(1);
  l_verafa       NUMBER(1);
  l_nompes       VARCHAR2(40);
  l_ddifon       NUMBER(3);
  l_dddfon       NUMBER(3);
  l_numfon       VARCHAR2(20);
  l_iniafa       VARCHAR2(16);
  l_datafa       VARCHAR2(16);
BEGIN
    l_faixa      := '24002400240024002400240024002400240024002400240024002400';
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_data_atual := CURDATE();
    l_segu_atual := SECOND(CURTIME());
    l_nivatu     := '99000'; 
    l_usabio     := '0';
    l_usarfastr  := 'N';
    l_usarfa     := 0;
    l_verafastr  := 'N';
    l_verafa     := 0;
    l_iniafa     := '0000000000000000';
    l_datafa     := '0000000000000000';
    /*Atualiza R070CON*/
    l_notfound:=FALSE;
    BEGIN
        SELECT NIVATU INTO l_nivatu FROM R070CON WHERE NUMFIS = p_numfis;
    EXCEPTION
        WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUFIS: Erro em R070CON - TOO MANY ROWS.=';
        WHEN NO_DATA_FOUND THEN l_notfound:= TRUE;
        WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro No SELECT R070CON.NIVATU';
    END;
    
    IF (P_CHCPRI <> 0) THEN
        BEGIN
            SELECT USABIO, TIPDOC, NUMDOC, INIAFA, DATAFA INTO l_usabio, l_tipdoc70con, l_numdoc70con, l_iniafa, l_datafa FROM R070CON WHERE NUMFIS = p_chcpri;
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro No SELECT R070CON.USABIO';
        END;
    END IF;

    /*RETORNA A PESSOA A PARTIR DO IDTPES*/
    SP_PESFROMIDTPES(p_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT, l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);
    SP_RETFON(p_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

    /* SE A SP_PESFROMIDTPES NÃO BUSCA TIPDOC/NUMDOC DO TIPO DE PESSOA, USA OS VALORES BUSCADOS NA R070CON */
    IF ((l_tippes <> 4) AND (l_tippes <> 7) AND (l_tippes <> 11)) THEN
        l_tipdoc := l_tipdoc70con;
        l_numdoc := l_numdoc70con;
    END IF;    

    IF (l_tippes < 4) THEN    
        BEGIN
            SELECT USARFA, VERAFA INTO l_usarfastr, l_verafastr  FROM R034DAC WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
        EXCEPTION
        WHEN OTHERS THEN
            l_usarfa := 0;
            l_usarfastr := 'N';
        END;
    ELSE
        IF (l_tippes = 5) THEN /* Colab. de Outra Unidade */
            BEGIN
                SELECT USARFA INTO l_usarfastr FROM R070OCR WHERE NUMEMP = l_numemp AND NUMCAD = l_numcad;
            EXCEPTION
            WHEN OTHERS THEN
                l_usarfa := 0;
                l_usarfastr := 'N';
            END;
        ELSE
            IF (l_tippes = 10) THEN /* Aluno */
                BEGIN
                    SELECT USARFA INTO l_usarfastr FROM R073ALU WHERE NUMMAT = l_nummat;
                EXCEPTION
                WHEN OTHERS THEN
                    l_usarfa := 0;
                    l_usarfastr := 'N';
                END;
            ELSE
                IF (l_tippes = 7) THEN /* Resp. de Aluno */
                    BEGIN
                        SELECT USARFA INTO l_usarfastr FROM R073RES WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
                    EXCEPTION
                    WHEN OTHERS THEN
                        l_usarfa := 0;
                        l_usarfastr := 'N';
                    END;
                ELSE
                    IF (l_tippes = 13) THEN /* Candidato */
                        l_numcan := l_numcad;
                        l_numcad := 0;

                        BEGIN
                            SELECT USARFA INTO l_usarfastr FROM R122CEX WHERE NUMCAN = l_numcan;
                        EXCEPTION
                        WHEN OTHERS THEN
                            l_usarfa := 0;
                            l_usarfastr := 'N';
                        END;
                    END IF;
                END IF;
            END IF;
        END IF;
    END IF;
    IF (l_usarfastr = 'S') THEN
        l_usarfa := 1;
    END IF;
    IF (l_verafastr = 'S') THEN
        l_verafa := 1;
    END IF;

    BEGIN
        IF (l_notfound = TRUE) THEN
            /* Para colab, terceiro e parceiro, verifico se necessita de autorizador */
            l_valaut := 0;
            IF (l_tippes < 4) THEN
                SP_RETAUT(p_idtpes, l_valaut OUT);
            END IF;

            INSERT INTO R070CON(NUMCRA,NUMFIS,CHCPRI,TECCRA,TIPCRA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                                SENCOL,SITCRA,INIVAL,DATVAL,DATAFA,MSGACC,DATMSG,QTDMSG,MSGATU,CONIAL,
                                TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,CONPAC,TEMPAC,TOLACP,
                                BLOAUT,BLOFAL,FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,
                                FAIAC7,FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,FAIREF,
                                CREAC1,CREFX1,QTDCR1,CREAC2,CREFX2,QTDCR2,CREAC3,CREFX3,QTDCR3,
                                CREAC4,CREFX4,QTDCR4,CREAC5,CREFX5,QTDCR5,CREAC6,CREFX6,QTDCR6,
                                PRMRT1,DINPR1,DFNPR1,PRMRT2,DINPR2,DFNPR2,PRMRT3,DINPR3,DFNPR3,
                                INIAFA,IDTPES,GRACON,CONINT,TOLINT,NIVATU,DATNIV,HORNIV,SEQNIV,VALAUT,
                                NOMFUN,NUMPIS,CONREA,NUMEMP,TIPCOL,NUMCAD,TIPDOC,NUMDOC,NOMPES,DDIFON,DDDFON,NUMFON,
                                NUMMAT,PROPAC,NUMCAN,PROPRE,USARFA)
                         VALUES(p_numcra,p_numfis,p_chcpri,p_teccra,p_tipcra,p_codprm,p_prmsab,p_prmdom,p_prmfer,
                                '     ',p_sitcra,p_inival,p_datval,l_datafa,'                                ',
                                '0000000000000000',0,0,0,0,l_verafa,l_usabio,p_verprm,0,0,0,0,0,0,0,p_blofal,l_faixa,l_faixa,
                                l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                                l_faixa,l_faixa,l_faixa,l_faixa,0,'00000000',0,0,'00000000',0,0,'00000000',
                                0,0,'00000000',0,0,'00000000',0,0,'00000000',0,p_prmrt1,'0000000000','0000000000',
                                p_prmrt2, '0000000000','0000000000',p_prmrt3,'0000000000','0000000000',
                                l_iniafa,p_idtpes,0,0,0,'99000',l_data_atual,l_hora_atual,l_segu_atual,l_valaut,
                                p_nomfun,p_numpis,0,l_numemp,l_tipcol,l_numcad,l_tipdoc,l_numdoc,l_nompes,l_ddifon,l_dddfon,l_numfon,
                                l_nummat,l_propac,l_numcan,0,l_usarfa);
        ELSE
            UPDATE R070CON SET
                   NUMCRA=p_numcra,NUMFIS=p_numfis,CHCPRI=p_chcpri,TECCRA=p_teccra,TIPCRA=p_tipcra,
                   CODPRM=p_codprm,PRMSAB=p_prmsab,PRMDOM=p_prmdom,PRMFER=p_prmfer,SENCOL='     ',SITCRA=p_sitcra,
                   INIVAL=p_inival,DATVAL=p_datval,DATAFA=l_datafa,MSGACC='                                ',
                   DATMSG='0000000000000000',QTDMSG=0,MSGATU=0,CONIAL=0,TEMALM=0,VERAFA=l_verafa,USABIO=l_usabio,GRACON=0,
                   VERPRM=p_verprm,CONFAI=0,CONADP=0,CONCRE=0,CONPAC=0,TEMPAC=0,TOLACP=0,BLOAUT=0,BLOFAL=p_blofal,FAIAC1=l_faixa,
                   FAIAC2=l_faixa,FAIAC3=l_faixa,FAIAC4=l_faixa,FAIAC5=l_faixa,FAIAC6=l_faixa,FAIAC7=l_faixa,FAIPT1=l_faixa,
                   FAIPT2=l_faixa,FAIPT3=l_faixa,FAIPT4=l_faixa,FAIPT5=l_faixa,FAIPT6=l_faixa,FAIPT7=l_faixa,
                   FAIREF=l_faixa,CREAC1=0,CREFX1='00000000',QTDCR1=0,CREAC2=0,CREFX2='00000000',QTDCR2=0,
                   CREAC3=0,CREFX3='00000000',QTDCR3=0,CREAC4=0,CREFX4='00000000',QTDCR4=0,CREAC5=0,CREFX5='00000000',
                   QTDCR5=0,CREAC6=0,CREFX6='00000000',QTDCR6=0,PRMRT1=p_prmrt1,DINPR1='0000000000',DFNPR1='0000000000',
                   PRMRT2=p_prmrt2,DINPR2='0000000000',DFNPR2='0000000000',PRMRT3=p_prmrt3,DINPR3='0000000000',
                   DFNPR3='0000000000', INIAFA=l_iniafa,IDTPES = p_idtpes,CONINT=0,TOLINT=0,NIVATU=l_nivatu,
                   DATNIV=l_data_atual,HORNIV=l_hora_atual,SEQNIV=l_segu_atual,NOMFUN=p_nomfun,NUMPIS=p_numpis,CONREA=0,
                   NUMEMP=l_numemp,TIPCOL=l_tipcol,NUMCAD=l_numcad,TIPDOC=l_tipdoc,NUMDOC=l_numdoc,NOMPES=l_nompes,DDIFON=l_ddifon,
                   DDDFON=l_dddfon,NUMFON=l_numfon,NUMMAT=l_nummat,PROPAC=l_propac,NUMCAN=l_numcan,USARFA=l_usarfa
            WHERE NUMFIS = p_numfis;
        END IF;
    EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro na Atualizaçao da Tabela R070CON';
    END;
END		SENIOR;22(SP_PESFROMIDTPES
SP_RETAUT
SP_RETFON
k%␀␀


PROCEDURE SP_ATUFIS(P_NUMCRA NUMBER,P_NUMFIS NUMBER,P_CHCPRI NUMBER,P_TECCRA NUMBER,P_TIPCRA NUMBER,P_SITCRA CHAR(1),P_INIVAL CHAR(16),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 CHAR(5),P_PRMRT2 CHAR(5),P_PRMRT3 CHAR(5),P_BLOFAL NUMBER(1),P_NUMPIS NUMBER(11),P_NOMFUN VARCHAR2(40),P_VERPRM NUMBER(1))
 IS

  l_notfound     BOOLEAN;
  l_faixa        CHAR(56);
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_segu_atual   NUMBER(2);
  l_tippes       NUMBER(2);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);
  l_tipdoc       NUMBER(1);
  l_numdoc       VARCHAR2(20);
  l_tipdoc70con  NUMBER(1);
  l_numdoc70con  VARCHAR2(20);
  l_nummat       VARCHAR2(15);
  l_propac       VARCHAR2(20);
  l_numcan       NUMBER(7);
  l_valaut       NUMBER(1);
  l_nivatu       CHAR(5);  
  l_usabio       CHAR(1);
  l_usarfastr    CHAR(1);
  l_usarfa       NUMBER(1);
  l_verafastr    CHAR(1);
  l_verafa       NUMBER(1);
  l_nompes       VARCHAR2(40);
  l_ddifon       NUMBER(3);
  l_dddfon       NUMBER(3);
  l_numfon       VARCHAR2(20);
  l_iniafa       VARCHAR2(16);
  l_datafa       VARCHAR2(16);
BEGIN
    l_faixa      := '24002400240024002400240024002400240024002400240024002400';
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_data_atual := CURDATE();
    l_segu_atual := SECOND(CURTIME());
    l_nivatu     := '99000'; 
    l_usabio     := '0';
    l_usarfastr  := 'N';
    l_usarfa     := 0;
    l_verafastr  := 'N';
    l_verafa     := 0;
    l_iniafa     := '0000000000000000';
    l_datafa     := '0000000000000000';
    /*Atualiza R070CON*/
    l_notfound:=FALSE;
    BEGIN
        SELECT NIVATU INTO l_nivatu FROM R070CON WHERE NUMFIS = p_numfis;
    EXCEPTION
        WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUFIS: Erro em R070CON - TOO MANY ROWS.=';
        WHEN NO_DATA_FOUND THEN l_notfound:= TRUE;
        WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro No SELECT R070CON.NIVATU';
    END;
    
    IF (P_CHCPRI <> 0) THEN
        BEGIN
            SELECT USABIO, TIPDOC, NUMDOC, INIAFA, DATAFA INTO l_usabio, l_tipdoc70con, l_numdoc70con, l_iniafa, l_datafa FROM R070CON WHERE NUMFIS = p_chcpri;
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro No SELECT R070CON.USABIO';
        END;
    END IF;

    /*RETORNA A PESSOA A PARTIR DO IDTPES*/
    SP_PESFROMIDTPES(p_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT, l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);
    SP_RETFON(p_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

    /* SE A SP_PESFROMIDTPES NÃO BUSCA TIPDOC/NUMDOC DO TIPO DE PESSOA, USA OS VALORES BUSCADOS NA R070CON */
    IF ((l_tippes <> 4) AND (l_tippes <> 7) AND (l_tippes <> 11)) THEN
        l_tipdoc := l_tipdoc70con;
        l_numdoc := l_numdoc70con;
    END IF;    

    IF (l_tippes < 4) THEN    
        BEGIN
            SELECT USARFA, VERAFA INTO l_usarfastr, l_verafastr  FROM R034DAC WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
        EXCEPTION
        WHEN OTHERS THEN
            l_usarfa := 0;
            l_usarfastr := 'N';
        END;
    ELSE
        IF (l_tippes = 5) THEN /* Colab. de Outra Unidade */
            BEGIN
                SELECT USARFA INTO l_usarfastr FROM R070OCR WHERE NUMEMP = l_numemp AND NUMCAD = l_numcad;
            EXCEPTION
            WHEN OTHERS THEN
                l_usarfa := 0;
                l_usarfastr := 'N';
            END;
        ELSE
            IF (l_tippes = 10) THEN /* Aluno */
                BEGIN
                    SELECT USARFA INTO l_usarfastr FROM R073ALU WHERE NUMMAT = l_nummat;
                EXCEPTION
                WHEN OTHERS THEN
                    l_usarfa := 0;
                    l_usarfastr := 'N';
                END;
            ELSE
                IF (l_tippes = 7) THEN /* Resp. de Aluno */
                    BEGIN
                        SELECT USARFA INTO l_usarfastr FROM R073RES WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
                    EXCEPTION
                    WHEN OTHERS THEN
                        l_usarfa := 0;
                        l_usarfastr := 'N';
                    END;
                ELSE
                    IF (l_tippes = 13) THEN /* Candidato */
                        l_numcan := l_numcad;
                        l_numcad := 0;

                        BEGIN
                            SELECT USARFA INTO l_usarfastr FROM R122CEX WHERE NUMCAN = l_numcan;
                        EXCEPTION
                        WHEN OTHERS THEN
                            l_usarfa := 0;
                            l_usarfastr := 'N';
                        END;
                    END IF;
                END IF;
            END IF;
        END IF;
    END IF;
    IF (l_usarfastr = 'S') THEN
        l_usarfa := 1;
    END IF;
    IF (l_verafastr = 'S') THEN
        l_verafa := 1;
    END IF;

    BEGIN
        IF (l_notfound = TRUE) THEN
            /* Para colab, terceiro e parceiro, verifico se necessita de autorizador */
            l_valaut := 0;
            IF (l_tippes < 4) THEN
                SP_RETAUT(p_idtpes, l_valaut OUT);
            END IF;

            INSERT INTO R070CON(NUMCRA,NUMFIS,CHCPRI,TECCRA,TIPCRA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                                SENCOL,SITCRA,INIVAL,DATVAL,DATAFA,MSGACC,DATMSG,QTDMSG,MSGATU,CONIAL,
                                TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,CONPAC,TEMPAC,TOLACP,
                                BLOAUT,BLOFAL,FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,
                                FAIAC7,FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,FAIREF,
                                CREAC1,CREFX1,QTDCR1,CREAC2,CREFX2,QTDCR2,CREAC3,CREFX3,QTDCR3,
                                CREAC4,CREFX4,QTDCR4,CREAC5,CREFX5,QTDCR5,CREAC6,CREFX6,QTDCR6,
                                PRMRT1,DINPR1,DFNPR1,PRMRT2,DINPR2,DFNPR2,PRMRT3,DINPR3,DFNPR3,
                                INIAFA,IDTPES,GRACON,CONINT,TOLINT,NIVATU,DATNIV,HORNIV,SEQNIV,VALAUT,
                                NOMFUN,NUMPIS,CONREA,NUMEMP,TIPCOL,NUMCAD,TIPDOC,NUMDOC,NOMPES,DDIFON,DDDFON,NUMFON,
                                NUMMAT,PROPAC,NUMCAN,PROPRE,USARFA)
                         VALUES(p_numcra,p_numfis,p_chcpri,p_teccra,p_tipcra,p_codprm,p_prmsab,p_prmdom,p_prmfer,
                                '     ',p_sitcra,p_inival,p_datval,l_datafa,'                                ',
                                '0000000000000000',0,0,0,0,l_verafa,l_usabio,p_verprm,0,0,0,0,0,0,0,p_blofal,l_faixa,l_faixa,
                                l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                                l_faixa,l_faixa,l_faixa,l_faixa,0,'00000000',0,0,'00000000',0,0,'00000000',
                                0,0,'00000000',0,0,'00000000',0,0,'00000000',0,p_prmrt1,'0000000000','0000000000',
                                p_prmrt2, '0000000000','0000000000',p_prmrt3,'0000000000','0000000000',
                                l_iniafa,p_idtpes,0,0,0,'99000',l_data_atual,l_hora_atual,l_segu_atual,l_valaut,
                                p_nomfun,p_numpis,0,l_numemp,l_tipcol,l_numcad,l_tipdoc,l_numdoc,l_nompes,l_ddifon,l_dddfon,l_numfon,
                                l_nummat,l_propac,l_numcan,0,l_usarfa);
        ELSE
            UPDATE R070CON SET
                   NUMCRA=p_numcra,NUMFIS=p_numfis,CHCPRI=p_chcpri,TECCRA=p_teccra,TIPCRA=p_tipcra,
                   CODPRM=p_codprm,PRMSAB=p_prmsab,PRMDOM=p_prmdom,PRMFER=p_prmfer,SENCOL='     ',SITCRA=p_sitcra,
                   INIVAL=p_inival,DATVAL=p_datval,DATAFA=l_datafa,MSGACC='                                ',
                   DATMSG='0000000000000000',QTDMSG=0,MSGATU=0,CONIAL=0,TEMALM=0,VERAFA=l_verafa,USABIO=l_usabio,GRACON=0,
                   VERPRM=p_verprm,CONFAI=0,CONADP=0,CONCRE=0,CONPAC=0,TEMPAC=0,TOLACP=0,BLOAUT=0,BLOFAL=p_blofal,FAIAC1=l_faixa,
                   FAIAC2=l_faixa,FAIAC3=l_faixa,FAIAC4=l_faixa,FAIAC5=l_faixa,FAIAC6=l_faixa,FAIAC7=l_faixa,FAIPT1=l_faixa,
                   FAIPT2=l_faixa,FAIPT3=l_faixa,FAIPT4=l_faixa,FAIPT5=l_faixa,FAIPT6=l_faixa,FAIPT7=l_faixa,
                   FAIREF=l_faixa,CREAC1=0,CREFX1='00000000',QTDCR1=0,CREAC2=0,CREFX2='00000000',QTDCR2=0,
                   CREAC3=0,CREFX3='00000000',QTDCR3=0,CREAC4=0,CREFX4='00000000',QTDCR4=0,CREAC5=0,CREFX5='00000000',
                   QTDCR5=0,CREAC6=0,CREFX6='00000000',QTDCR6=0,PRMRT1=p_prmrt1,DINPR1='0000000000',DFNPR1='0000000000',
                   PRMRT2=p_prmrt2,DINPR2='0000000000',DFNPR2='0000000000',PRMRT3=p_prmrt3,DINPR3='0000000000',
                   DFNPR3='0000000000', INIAFA=l_iniafa,IDTPES = p_idtpes,CONINT=0,TOLINT=0,NIVATU=l_nivatu,
                   DATNIV=l_data_atual,HORNIV=l_hora_atual,SEQNIV=l_segu_atual,NOMFUN=p_nomfun,NUMPIS=p_numpis,CONREA=0,
                   NUMEMP=l_numemp,TIPCOL=l_tipcol,NUMCAD=l_numcad,TIPDOC=l_tipdoc,NUMDOC=l_numdoc,NOMPES=l_nompes,DDIFON=l_ddifon,
                   DDDFON=l_dddfon,NUMFON=l_numfon,NUMMAT=l_nummat,PROPAC=l_propac,NUMCAN=l_numcan,USARFA=l_usarfa
            WHERE NUMFIS = p_numfis;
        END IF;
    EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro na Atualizaçao da Tabela R070CON';
    END;
END		SENIOR;23(SP_PESFROMIDTPES
SP_RETAUT
SP_RETFON
k%␀␀


PROCEDURE SP_ATUFIS(P_NUMCRA NUMBER,P_NUMFIS NUMBER,P_CHCPRI NUMBER,P_TECCRA NUMBER,P_TIPCRA NUMBER,P_SITCRA CHAR(1),P_INIVAL CHAR(16),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 CHAR(5),P_PRMRT2 CHAR(5),P_PRMRT3 CHAR(5),P_BLOFAL NUMBER(1),P_NUMPIS NUMBER(11),P_NOMFUN VARCHAR2(40),P_VERPRM NUMBER(1))
 IS

  l_notfound     BOOLEAN;
  l_faixa        CHAR(56);
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_segu_atual   NUMBER(2);
  l_tippes       NUMBER(2);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);
  l_tipdoc       NUMBER(1);
  l_numdoc       VARCHAR2(20);
  l_tipdoc70con  NUMBER(1);
  l_numdoc70con  VARCHAR2(20);
  l_nummat       VARCHAR2(15);
  l_propac       VARCHAR2(20);
  l_numcan       NUMBER(7);
  l_valaut       NUMBER(1);
  l_nivatu       CHAR(5);  
  l_usabio       CHAR(1);
  l_usarfastr    CHAR(1);
  l_usarfa       NUMBER(1);
  l_verafastr    CHAR(1);
  l_verafa       NUMBER(1);
  l_nompes       VARCHAR2(40);
  l_ddifon       NUMBER(3);
  l_dddfon       NUMBER(3);
  l_numfon       VARCHAR2(20);
  l_iniafa       VARCHAR2(16);
  l_datafa       VARCHAR2(16);
BEGIN
    l_faixa      := '24002400240024002400240024002400240024002400240024002400';
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_data_atual := CURDATE();
    l_segu_atual := SECOND(CURTIME());
    l_nivatu     := '99000'; 
    l_usabio     := '0';
    l_usarfastr  := 'N';
    l_usarfa     := 0;
    l_verafastr  := 'N';
    l_verafa     := 0;
    l_iniafa     := '0000000000000000';
    l_datafa     := '0000000000000000';
    /*Atualiza R070CON*/
    l_notfound:=FALSE;
    BEGIN
        SELECT NIVATU INTO l_nivatu FROM R070CON WHERE NUMFIS = p_numfis;
    EXCEPTION
        WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUFIS: Erro em R070CON - TOO MANY ROWS.=';
        WHEN NO_DATA_FOUND THEN l_notfound:= TRUE;
        WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro No SELECT R070CON.NIVATU';
    END;
    
    IF (P_CHCPRI <> 0) THEN
        BEGIN
            SELECT USABIO, TIPDOC, NUMDOC, INIAFA, DATAFA INTO l_usabio, l_tipdoc70con, l_numdoc70con, l_iniafa, l_datafa FROM R070CON WHERE NUMFIS = p_chcpri;
        EXCEPTION
            WHEN OTHERS THEN RAISERROR 103 'SP_ATUFIS: Erro No SELECT R070CON.USABIO';
        END;
    END IF;

    /*RETORNA A PESSOA A PARTIR DO IDTPES*/
    SP_PESFROMIDTPES(p_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT, l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);
    SP_RETFON(p_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

    /* SE A SP_PESFROMIDTPES NÃO BUSCA TIPDOC/NUMDOC DO TIPO DE PESSOA, USA OS VALORES BUSCADOS NA R070CON */
    IF ((l_tippes <> 4) AND (l_tippes <> 7) AND (l_tippes <> 11)) THEN
        l_tipdoc := l_tipdoc70con;
        l_numdoc := l_numdoc70con;
    END IF;    

    IF (l_tippes < 4) THEN    
        BEGIN
            SELECT USARFA, VERAFA INTO l_usarfastr, l_verafastr  FROM R034DAC WHERE NUMEMP = l_numemp AND TIPCOL = l_tipcol AND NUMCAD = l_numcad;
        EXCEPTION
        WHEN OTHERS THEN
            l_usarfa := 0;
            l_usarfastr := 'N';
        END;
    ELSE
        IF (l_tippes = 5) THEN /* Colab. de Outra Unidade */
            BEGIN
                SELECT USARFA INTO l_usarfastr FROM R070OCR WHERE NUMEMP = l_numemp AND NUMCAD = l_numcad;
            EXCEPTION
            WHEN OTHERS THEN
                l_usarfa := 0;
                l_usarfastr := 'N';
            END;
        ELSE
            IF (l_tippes = 10) THEN /* Aluno */
                BEGIN
                    SELECT USARFA INTO l_usarfastr FROM R073ALU WHERE NUMMAT = l_nummat;
                EXCEPTION
                WHEN OTHERS THEN
                    l_usarfa := 0;
                    l_usarfastr := 'N';
                END;
            ELSE
                IF (l_tippes = 7) THEN /* Resp. de Aluno */
                    BEGIN
                        SELECT USARFA INTO l_usarfastr FROM R073RES WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
                    EXCEPTION
                    WHEN OTHERS THEN
                        l_usarfa := 0;
                        l_usarfastr := 'N';
                    END;
                ELSE
                    IF (l_tippes = 13) THEN /* Candidato */
                        l_numcan := l_numcad;
                        l_numcad := 0;

                        BEGIN
                            SELECT USARFA INTO l_usarfastr FROM R122CEX WHERE NUMCAN = l_numcan;
                        EXCEPTION
                        WHEN OTHERS THEN
                            l_usarfa := 0;
                            l_usarfastr := 'N';
                        END;
                    END IF;
                END IF;
            END IF;
        END IF;
    END IF;
    IF (l_usarfastr = 'S') THEN
        l_usarfa := 1;
    END IF;
    IF (l_verafastr = 'S') THEN
        l_verafa := 1;
    END IF;

    BEGIN
        IF (l_notfound = TRUE) THEN
            /* Para colab, terceiro e parceiro, verifico se necessita de autorizador */
            l_valaut := 0;
            IF (l_tippes < 4) THEN
                SP_RETAUT(p_idtpes, l_valaut OUT);
            END IF;

            INSERT INTO R070CON(NUMCRA,NUMFIS,CHCPRI,TECCRA,TIPCRA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                                SENCOL,SITCRA,INIVAL,DATVAL,DATAFA,MSGACC,DATMSG,QTDMSG,MSGATU,CONIAL,
                                TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,CONPAC,TEMPAC,TOLACP,
