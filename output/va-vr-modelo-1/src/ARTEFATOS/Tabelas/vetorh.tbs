TRIGGER R090MVI_EI BEFORE INSERT ON R090MVI FOR EACH ROW
BEGIN
  NULL;
END		SENIOR;20\(␀␀

TRIGGER R090MVI_EI BEFORE INSERT ON R090MVI FOR EACH ROW
DECLARE
  l_online       BOOLEAN;
  l_bloaut       CHAR(1);
  l_tippev       NUMBER(1);
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_EnvChe       NUMBER(1);
  l_DesPor       VARCHAR(20);
  l_NomEmp       VARCHAR(40);
  l_NomVis       VARCHAR(80);
  l_Email        VARCHAR(100);
  l_NomOem       VARCHAR(60);
  l_NomFun       VARCHAR(40);
  l_DatPrv       DATE;
  l_HorPrv       NUMBER(4);
  l_verdoc       NUMBER(1);
  l_mblvis       NUMBER(1);
  l_DDITelFun    NUMBER(3);
  l_DDDTelFun    NUMBER(3);
  l_TelConFun    VARCHAR2(20);
  l_DDITelVis    NUMBER(3);
  l_DDDTelVis    NUMBER(3);
  l_TelConVis    VARCHAR2(20);
  l_LocAGV       NUMBER(9);
  l_data_zero    DATE;
BEGIN
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN
  	  /* Procedure que atualiza os creditos de acesso.*/
      R090MVI_ATUCRV('I',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATENT,:NEW.DATVAL,:NEW.TIPVIS);

      BEGIN
          SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
       EXCEPTION WHEN OTHERS THEN
          l_bloaut := 'N';
          l_tippev := 1;
       END;

       IF   l_bloaut =  'S' THEN
            l_bloaut := '1';
       ELSE l_bloaut := '0';
       END IF;

      SP_VISCON_PEND93(:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,:NEW.CODPRM,:NEW.DATENT,:NEW.HORENT,:NEW.DATVAL,:NEW.HORVAL,l_bloaut,l_tippev,:NEW.TIPVIS,0,0,0,1,1, :NEW.ANDVIS);
      SP_PEND93(:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,:NEW.CODPRM,:NEW.TIPVIS, :NEW.ANDVIS);
  END IF;

  l_data_zero := '31/12/1900,00:00:00';

  /* Verifica definições de acesso */
  l_verdoc := 0;
  l_mblvis := 0;
  BEGIN
      SELECT VERDOC, MBLVIS INTO l_verdoc, l_mblvis FROM R070DAC;
  EXCEPTION
      WHEN OTHERS THEN l_verdoc := 0;
  END;

  /* Bloqueia se houver colaborador associado */
  IF (l_verdoc > 2) AND                            /* se bloqueia colaborador */
     (l_mblvis > 0) AND                            /* se tem motivo para bloqueio cadastrado*/
     ((:NEW.TIPDOC = 2) OR (:NEW.TIPDOC = 4)) THEN /* só considera CPF ou passaporte */
     SP_BloColVIS( :NEW.TIPDOC, :NEW.NUMDOC, :NEW.DATENT, :NEW.HORENT, :NEW.DATVAl, :NEW.HORVAL, :NEW.CODUSU, l_mblvis);
  END IF;

  /* GERACAO DE REGISTRO PARA O NOTIFICADOR */
  IF (:NEW.TipVis IS NOT NULL) THEN
    BEGIN
      SELECT EnvChe INTO l_EnvChe FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_EnvChe := 0;
      WHEN OTHERS THEN NULL;
    END;

    l_LocAGV := :NEW.LOCAGV;
    IF l_LocAGV IS NULL OR l_LocAGV = 0 THEN
      l_LocAGV := NULL;
      GETNEXTVALUE('SEQNOT', 1, NULL, l_LocAGV OUT);
      /* A ATRIBUICAO DO :NEW.LOCAGV PARA O ORACLE, OU UPDATE DO LOCAGV PARA O SQL SERVER, FACO ALI NO FIM DA R090AGV_EI,
      PARA EVITAR QUE O UPDATE DO REGISTRO DO AGENDAMENTO NO SQL SERVER GERE MAIS UMA NOTIFICACAO IGUAL A EXISTENTE */
    END IF;

    BEGIN
      SELECT R030EMP.NomEmp, R034FUN.NomFun INTO l_NomEmp, l_NomFun FROM R030EMP, R034FUN
        WHERE
          R030EMP.NUMEMP = :NEW.NUMEMP AND
          R034FUN.NUMEMP = :NEW.NUMEMP AND R034FUN.TIPCOL = :NEW.TIPCOL AND R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;

    BEGIN
      SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;

    BEGIN
      SELECT R090VIS.NomVis, R090VIS.DdiTel, R090VIS.DddTel, R090VIS.TelCon INTO l_NomVis, l_DDITelVis, l_DDDTelVis, l_TelConVis FROM R090VIS
      WHERE R090VIS.TIPDOC = :NEW.TIPDOC AND R090VIS.NUMDOC = :NEW.NUMDOC;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;

    IF (l_EnvChe = 1) OR (l_EnvChe = 9) THEN
      BEGIN
        SELECT R034CPL.EmaCom
        INTO l_Email
        FROM R034CPL
        WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      R115NOT_ATUNOT(3,
                     l_LocAGV,
                     l_NomVis,
                     NULL,
                     l_data_zero,  /* l_DatPrv */
                     0,  /* l_HorPrv */
                     :NEW.DATVAL,
                     :NEW.HORVAL,
                     :NEW.NOMOEM,
                     l_DDITelVis,
                     l_DDDTelVis,
                     l_TelConVis,
                     l_DesPor,
                     l_NomEmp,
                     l_NomFun,
                     0, /* DDITelVisitado */
                     0, /* DDDTelVisitado */
                     '', /* TelConVisitado */
                     NULL, /* SituacaoWAV */
                     NULL, /* TIPDOC */
                     '', /* Desc. TipDoc*/
                     '', /* NUMDOC */
                     NULL, /* TIPVIS */
                     '', /* NomTIPVIS */
                     NULL, /* CODPOR */
                     NULL, /* CODPRM */
                     '', /* DESPRM */
                     '', /* PLAVEI*/
                     '', /* NomAut */
                     '', /* OBSVIS */
                     '', /* NomSol */
                     l_Email, /* EmaSol */
                     NULL, /* DATSAG */
                     NULL, /* HORSAG */
                     '', /* NOMUSU */
                     NULL, /* DATPSA */
                     NULL, /* HORPSA */
                     '' /* OBSREP */
                    );
    END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - EMAIL*/

    IF (l_EnvChe = 2) OR (l_EnvChe = 9) THEN
      BEGIN
        SELECT R034CPL.NmDdi2, R034CPL.NmDdd2, R034CPL.NmTel2 INTO l_DDITelFun, l_DDDTelFun, l_TelConFun
        FROM R034CPL
        WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      R115NOT_ATUNOT(4,
                     l_LocAGV,
                     l_NomVis,
                     '',
                     l_data_zero,  /* l_DatPrv */
                     0,  /* l_HorPrv */
                     :NEW.DATVAL,
                     :NEW.HORVAL,
                     :NEW.NOMOEM,
                     l_DDITelVis,
                     l_DDDTelVis,
                     l_TelConVis,
                     l_DesPor,
                     l_NomEmp,
                     l_NomFun,
                     l_DDITelFun, /* DDITelVisitado */
                     l_DDDTelFun, /* DDDTelVisitado */
                     l_TelConFun,  /* TelConVisitado */
                     NULL, /* SituacaoWAV */
                     NULL, /* TIPDOC */
                     '', /* Desc. TipDoc*/
                     '', /* NUMDOC */
                     NULL, /* TIPVIS */
                     '', /* NomTIPVIS */
                     NULL, /* CODPOR */
                     NULL, /* CODPRM */
                     '', /* DESPRM */
                     '', /* PLAVEI*/
                     '', /* NomAut */
                     '', /* OBSVIS */
                     '', /* NomSol */
                     l_Email, /* EmaSol */
                     NULL, /* DATSAG */
                     NULL, /* HORSAG */
                     '', /* NOMUSU */
                     NULL, /* DATPSA */
                     NULL, /* HORPSA */
                     '' /* OBSREP */
                    );
    END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - SMS*/

    /* ORACLE*/
    :NEW.LOCAGV := l_LocAGV;

  END IF; /* FIM DA GERACAO DE REGISTRO PARA O NOTIFICADOR */

  IF (:NEW.PLAVEE IS NOT NULL) THEN

    SP_VEIPESCON('I',
                 :NEW.CRAVEI,
                 :NEW.NUMCRA,
                 0,
                 :NEW.PLAVEE,
                 :NEW.DATVAL,
                 :NEW.HORVAL,
                 4,
                 :NEW.NUMEMP,
                 :NEW.TIPCOL,
                 :NEW.NUMCAD,
                 :NEW.TIPDOC,
                 :NEW.NUMDOC);

  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090MVI');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R090MVI_AUD (SEQREG,VERSEQ,DATENT,HORENT,SEQENT,NUMCRA,NUMEMP,TIPCOL,NUMCAD,TABORG,
                                   NUMLOC,CODPOR,TIPDOC,NUMDOC,SEGTDO,SEGDOC,PLAVEE,CODPRM,DDITEL,DDDTEL,
                                   DATVAL,HORVAL,TIPVIS,OBSVIS,CODUSU,DATSAI,HORSAI,DATSLO,HORSLO,PLAVES,
                                   TELCON,PLACAE,PLACAS,ASSVID,CODOEM,NUMCON,EMPCCU,CODCCU,NOMOEM,CODLIB,
                                   CODNAC,CODMOT,CRAVEI,PLACE2,PLACE3,PLACS2,PLACS3,EmaVis,LocAgv,
                                   VerPlf,CodPlf,ANDVIS,CPFRES,REPRES,REPTDO,REPDOC)
                           VALUES (l_seqreg,l_verseq,:NEW.DATENT,:NEW.HORENT,:NEW.SEQENT,:NEW.NUMCRA,:NEW.NUMEMP,
                                  :NEW.TIPCOL,:NEW.NUMCAD,:NEW.TABORG,:NEW.NUMLOC,:NEW.CODPOR,:NEW.TIPDOC,
                                  :NEW.NUMDOC,:NEW.SEGTDO,:NEW.SEGDOC,:NEW.PLAVEE,:NEW.CODPRM,:NEW.DDITEL,
                                  :NEW.DDDTEL,:NEW.DATVAL,:NEW.HORVAL,:NEW.TIPVIS,:NEW.OBSVIS,:NEW.CODUSU,
                                  :NEW.DATSAI,:NEW.HORSAI,:NEW.DATSLO,:NEW.HORSLO,:NEW.PLAVES,:NEW.TELCON,
                                  :NEW.PLACAE,:NEW.PLACAS,:NEW.ASSVID,:NEW.CODOEM,:NEW.NUMCON,:NEW.EMPCCU,
                                  :NEW.CODCCU,:NEW.NOMOEM,:NEW.CODLIB,:NEW.CODNAC,:NEW.CODMOT,:NEW.CRAVEI,
                                  :NEW.PLACE2,:NEW.PLACE3,:NEW.PLACS2,:NEW.PLACS3,:NEW.EmaVis,:NEW.LocAgv,
                                  :NEW.VerPlf,:NEW.CodPlf,:NEW.ANDVIS,:NEW.CPFRES,:NEW.REPRES,:NEW.REPTDO,
                                  :NEW.REPDOC);

          SP_AUDGENREG(l_seqreg,l_verseq,'R090MVI','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END		SENIOR;22\(␀␀

TRIGGER R090MVI_EI BEFORE INSERT ON R090MVI FOR EACH ROW
DECLARE
  l_online       BOOLEAN;
  l_bloaut       CHAR(1);
  l_tippev       NUMBER(1);
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_EnvChe       NUMBER(1);
  l_DesPor       VARCHAR(20);
  l_NomEmp       VARCHAR(40);
  l_NomVis       VARCHAR(80);
  l_Email        VARCHAR(100);
  l_NomOem       VARCHAR(60);
  l_NomFun       VARCHAR(40);
  l_DatPrv       DATE;
  l_HorPrv       NUMBER(4);
  l_verdoc       NUMBER(1);
  l_mblvis       NUMBER(1);
  l_DDITelFun    NUMBER(3);
  l_DDDTelFun    NUMBER(3);
  l_TelConFun    VARCHAR2(20);
  l_DDITelVis    NUMBER(3);
  l_DDDTelVis    NUMBER(3);
  l_TelConVis    VARCHAR2(20);
  l_LocAGV       NUMBER(9);
  l_data_zero    DATE;
BEGIN
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN
  	  /* Procedure que atualiza os creditos de acesso.*/
      R090MVI_ATUCRV('I',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATENT,:NEW.DATVAL,:NEW.TIPVIS);

      BEGIN
          SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
       EXCEPTION WHEN OTHERS THEN
          l_bloaut := 'N';
          l_tippev := 1;
       END;

       IF   l_bloaut =  'S' THEN
            l_bloaut := '1';
       ELSE l_bloaut := '0';
       END IF;

      SP_VISCON_PEND93(:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,:NEW.CODPRM,:NEW.DATENT,:NEW.HORENT,:NEW.DATVAL,:NEW.HORVAL,l_bloaut,l_tippev,:NEW.TIPVIS,0,0,0,1,1, :NEW.ANDVIS);
      SP_PEND93(:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,:NEW.CODPRM,:NEW.TIPVIS, :NEW.ANDVIS);
  END IF;

  l_data_zero := '31/12/1900,00:00:00';

  /* Verifica definições de acesso */
  l_verdoc := 0;
  l_mblvis := 0;
  BEGIN
      SELECT VERDOC, MBLVIS INTO l_verdoc, l_mblvis FROM R070DAC;
  EXCEPTION
      WHEN OTHERS THEN l_verdoc := 0;
  END;

  /* Bloqueia se houver colaborador associado */
  IF (l_verdoc > 2) AND                            /* se bloqueia colaborador */
     (l_mblvis > 0) AND                            /* se tem motivo para bloqueio cadastrado*/
     ((:NEW.TIPDOC = 2) OR (:NEW.TIPDOC = 4)) THEN /* só considera CPF ou passaporte */
     SP_BloColVIS( :NEW.TIPDOC, :NEW.NUMDOC, :NEW.DATENT, :NEW.HORENT, :NEW.DATVAl, :NEW.HORVAL, :NEW.CODUSU, l_mblvis);
  END IF;

  /* GERACAO DE REGISTRO PARA O NOTIFICADOR */
  IF (:NEW.TipVis IS NOT NULL) THEN
    BEGIN
      SELECT EnvChe INTO l_EnvChe FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_EnvChe := 0;
      WHEN OTHERS THEN NULL;
    END;

    l_LocAGV := :NEW.LOCAGV;
    IF l_LocAGV IS NULL OR l_LocAGV = 0 THEN
      l_LocAGV := NULL;
      GETNEXTVALUE('SEQNOT', 1, NULL, l_LocAGV OUT);
      /* A ATRIBUICAO DO :NEW.LOCAGV PARA O ORACLE, OU UPDATE DO LOCAGV PARA O SQL SERVER, FACO ALI NO FIM DA R090AGV_EI,
      PARA EVITAR QUE O UPDATE DO REGISTRO DO AGENDAMENTO NO SQL SERVER GERE MAIS UMA NOTIFICACAO IGUAL A EXISTENTE */
    END IF;

    BEGIN
      SELECT R030EMP.NomEmp, R034FUN.NomFun INTO l_NomEmp, l_NomFun FROM R030EMP, R034FUN
        WHERE
          R030EMP.NUMEMP = :NEW.NUMEMP AND
          R034FUN.NUMEMP = :NEW.NUMEMP AND R034FUN.TIPCOL = :NEW.TIPCOL AND R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;

    BEGIN
      SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;

    BEGIN
      SELECT R090VIS.NomVis, R090VIS.DdiTel, R090VIS.DddTel, R090VIS.TelCon INTO l_NomVis, l_DDITelVis, l_DDDTelVis, l_TelConVis FROM R090VIS
      WHERE R090VIS.TIPDOC = :NEW.TIPDOC AND R090VIS.NUMDOC = :NEW.NUMDOC;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;

    IF (l_EnvChe = 1) OR (l_EnvChe = 9) THEN
      BEGIN
        SELECT R034CPL.EmaCom
        INTO l_Email
        FROM R034CPL
        WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      R115NOT_ATUNOT(3,
                     l_LocAGV,
                     l_NomVis,
                     NULL,
                     l_data_zero,  /* l_DatPrv */
                     0,  /* l_HorPrv */
                     :NEW.DATVAL,
                     :NEW.HORVAL,
                     :NEW.NOMOEM,
                     l_DDITelVis,
                     l_DDDTelVis,
                     l_TelConVis,
                     l_DesPor,
                     l_NomEmp,
                     l_NomFun,
                     0, /* DDITelVisitado */
                     0, /* DDDTelVisitado */
                     '', /* TelConVisitado */
                     NULL, /* SituacaoWAV */
                     NULL, /* TIPDOC */
                     '', /* Desc. TipDoc*/
                     '', /* NUMDOC */
                     NULL, /* TIPVIS */
                     '', /* NomTIPVIS */
                     NULL, /* CODPOR */
                     NULL, /* CODPRM */
                     '', /* DESPRM */
                     '', /* PLAVEI*/
                     '', /* NomAut */
                     '', /* OBSVIS */
                     '', /* NomSol */
                     l_Email, /* EmaSol */
                     NULL, /* DATSAG */
                     NULL, /* HORSAG */
                     '', /* NOMUSU */
                     NULL, /* DATPSA */
                     NULL, /* HORPSA */
                     '' /* OBSREP */
                    );
    END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - EMAIL*/

    IF (l_EnvChe = 2) OR (l_EnvChe = 9) THEN
      BEGIN
        SELECT R034CPL.NmDdi2, R034CPL.NmDdd2, R034CPL.NmTel2 INTO l_DDITelFun, l_DDDTelFun, l_TelConFun
        FROM R034CPL
        WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      R115NOT_ATUNOT(4,
                     l_LocAGV,
                     l_NomVis,
                     '',
                     l_data_zero,  /* l_DatPrv */
                     0,  /* l_HorPrv */
                     :NEW.DATVAL,
                     :NEW.HORVAL,
                     :NEW.NOMOEM,
                     l_DDITelVis,
                     l_DDDTelVis,
                     l_TelConVis,
                     l_DesPor,
                     l_NomEmp,
                     l_NomFun,
                     l_DDITelFun, /* DDITelVisitado */
                     l_DDDTelFun, /* DDDTelVisitado */
                     l_TelConFun,  /* TelConVisitado */
                     NULL, /* SituacaoWAV */
                     NULL, /* TIPDOC */
                     '', /* Desc. TipDoc*/
                     '', /* NUMDOC */
                     NULL, /* TIPVIS */
                     '', /* NomTIPVIS */
                     NULL, /* CODPOR */
                     NULL, /* CODPRM */
                     '', /* DESPRM */
                     '', /* PLAVEI*/
                     '', /* NomAut */
                     '', /* OBSVIS */
                     '', /* NomSol */
                     l_Email, /* EmaSol */
                     NULL, /* DATSAG */
                     NULL, /* HORSAG */
                     '', /* NOMUSU */
                     NULL, /* DATPSA */
                     NULL, /* HORPSA */
                     '' /* OBSREP */
                    );
    END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - SMS*/

    /* ORACLE*/
    :NEW.LOCAGV := l_LocAGV;

  END IF; /* FIM DA GERACAO DE REGISTRO PARA O NOTIFICADOR */

  IF (:NEW.PLAVEE IS NOT NULL) THEN

    SP_VEIPESCON('I',
                 :NEW.CRAVEI,
                 :NEW.NUMCRA,
                 0,
                 :NEW.PLAVEE,
                 :NEW.DATVAL,
                 :NEW.HORVAL,
                 4,
                 :NEW.NUMEMP,
                 :NEW.TIPCOL,
                 :NEW.NUMCAD,
                 :NEW.TIPDOC,
                 :NEW.NUMDOC);

  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090MVI');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R090MVI_AUD (SEQREG,VERSEQ,DATENT,HORENT,SEQENT,NUMCRA,NUMEMP,TIPCOL,NUMCAD,TABORG,
                                   NUMLOC,CODPOR,TIPDOC,NUMDOC,SEGTDO,SEGDOC,PLAVEE,CODPRM,DDITEL,DDDTEL,
                                   DATVAL,HORVAL,TIPVIS,OBSVIS,CODUSU,DATSAI,HORSAI,DATSLO,HORSLO,PLAVES,
                                   TELCON,PLACAE,PLACAS,ASSVID,CODOEM,NUMCON,EMPCCU,CODCCU,NOMOEM,CODLIB,
                                   CODNAC,CODMOT,CRAVEI,PLACE2,PLACE3,PLACS2,PLACS3,EmaVis,LocAgv,
                                   VerPlf,CodPlf,ANDVIS,CPFRES,REPRES,REPTDO,REPDOC)
                           VALUES (l_seqreg,l_verseq,:NEW.DATENT,:NEW.HORENT,:NEW.SEQENT,:NEW.NUMCRA,:NEW.NUMEMP,
                                  :NEW.TIPCOL,:NEW.NUMCAD,:NEW.TABORG,:NEW.NUMLOC,:NEW.CODPOR,:NEW.TIPDOC,
                                  :NEW.NUMDOC,:NEW.SEGTDO,:NEW.SEGDOC,:NEW.PLAVEE,:NEW.CODPRM,:NEW.DDITEL,
                                  :NEW.DDDTEL,:NEW.DATVAL,:NEW.HORVAL,:NEW.TIPVIS,:NEW.OBSVIS,:NEW.CODUSU,
                                  :NEW.DATSAI,:NEW.HORSAI,:NEW.DATSLO,:NEW.HORSLO,:NEW.PLAVES,:NEW.TELCON,
                                  :NEW.PLACAE,:NEW.PLACAS,:NEW.ASSVID,:NEW.CODOEM,:NEW.NUMCON,:NEW.EMPCCU,
                                  :NEW.CODCCU,:NEW.NOMOEM,:NEW.CODLIB,:NEW.CODNAC,:NEW.CODMOT,:NEW.CRAVEI,
                                  :NEW.PLACE2,:NEW.PLACE3,:NEW.PLACS2,:NEW.PLACS3,:NEW.EmaVis,:NEW.LocAgv,
                                  :NEW.VerPlf,:NEW.CodPlf,:NEW.ANDVIS,:NEW.CPFRES,:NEW.REPRES,:NEW.REPTDO,
                                  :NEW.REPDOC);

          SP_AUDGENREG(l_seqreg,l_verseq,'R090MVI','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END		SENIOR;21·&␀␀

TRIGGER R090MVI_EI BEFORE INSERT ON R090MVI FOR EACH ROW
DECLARE
  l_online       BOOLEAN;
  l_bloaut       CHAR(1);
  l_tippev       NUMBER(1);
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_EnvChe       NUMBER(1);
  l_DesPor       VARCHAR(20);
  l_NomEmp       VARCHAR(40);
  l_NomVis       VARCHAR(80);
  l_Email        VARCHAR(100);
  l_NomOem       VARCHAR(60);
  l_NomFun       VARCHAR(40);
  l_DatPrv       DATE; 
  l_HorPrv       NUMBER(4);
  l_verdoc       NUMBER(1);
  l_mblvis       NUMBER(1);
  l_DDITelFun    NUMBER(3);
  l_DDDTelFun    NUMBER(3);
  l_TelConFun    VARCHAR2(20);
  l_DDITelVis    NUMBER(3);
  l_DDDTelVis    NUMBER(3);
  l_TelConVis    VARCHAR2(20);
  l_data_zero    DATE;
BEGIN
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN
  	  /* Procedure que atualiza os creditos de acesso.*/
      R090MVI_ATUCRV('I',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATENT,:NEW.DATVAL,:NEW.TIPVIS);

      BEGIN
          SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
       EXCEPTION WHEN OTHERS THEN
          l_bloaut := 'N';
          l_tippev := 1;
       END;

       IF   l_bloaut =  'S' THEN
            l_bloaut := '1';
       ELSE l_bloaut := '0';
       END IF;

      SP_VISCON_PEND93(:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,:NEW.CODPRM,:NEW.DATENT,:NEW.HORENT,:NEW.DATVAL,:NEW.HORVAL,l_bloaut,l_tippev,:NEW.TIPVIS,0,0,0,1,1, :NEW.ANDVIS);

      SP_PEND93(:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,:NEW.CODPRM,:NEW.TIPVIS, :NEW.ANDVIS);			
  END IF;

  l_data_zero := '31/12/1900,00:00:00';
  
  /* Verifica definições de acesso */
  l_verdoc := 0;
  l_mblvis := 0;
  BEGIN
      SELECT VERDOC, MBLVIS INTO l_verdoc, l_mblvis FROM R070DAC;
  EXCEPTION 
      WHEN OTHERS THEN l_verdoc := 0;
  END;
  
  /* Bloqueia se houver colaborador associado */
  IF (l_verdoc > 2) AND                            /* se bloqueia colaborador */
     (l_mblvis > 0) AND                            /* se tem motivo para bloqueio cadastrado*/ 
     ((:NEW.TIPDOC = 2) OR (:NEW.TIPDOC = 4)) THEN /* só considera CPF ou passaporte */
     SP_BloColVIS( :NEW.TIPDOC, :NEW.NUMDOC, :NEW.DATENT, :NEW.HORENT, :NEW.DATVAl, :NEW.HORVAL, :NEW.CODUSU, l_mblvis);
  END IF;
 
  /* GERACAO DE REGISTRO PARA O NOTIFICADOR */
  IF (:NEW.TipVis IS NOT NULL) THEN
    BEGIN
      SELECT EnvChe INTO l_EnvChe FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_EnvChe := 0;
      WHEN OTHERS THEN NULL;
    END;

    BEGIN
      SELECT R030EMP.NomEmp, R034FUN.NomFun INTO l_NomEmp, l_NomFun FROM R030EMP, R034FUN
        WHERE 
          R030EMP.NUMEMP = :NEW.NUMEMP AND
          R034FUN.NUMEMP = :NEW.NUMEMP AND R034FUN.TIPCOL = :NEW.TIPCOL AND R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;

    BEGIN
      SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;

    BEGIN
      SELECT R090VIS.NomVis, R090VIS.DdiTel, R090VIS.DddTel, R090VIS.TelCon INTO l_NomVis, l_DDITelVis, l_DDDTelVis, l_TelConVis FROM R090VIS
      WHERE R090VIS.TIPDOC = :NEW.TIPDOC AND R090VIS.NUMDOC = :NEW.NUMDOC;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;
	  
    IF (l_EnvChe = 1) OR (l_EnvChe = 9) THEN
      BEGIN
        SELECT R034CPL.EmaCom
        INTO l_Email
        FROM R034CPL
        WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      R115NOT_ATUNOT(3,
                     :NEW.LOCAGV,
                     l_NomVis,
                     NULL,
                     l_data_zero,  /* l_DatPrv */
                     0,  /* l_HorPrv */
                     :NEW.DATVAL, 
                     :NEW.HORVAL,
                     :NEW.NOMOEM,
                     l_DDITelVis,
                     l_DDDTelVis,
                     l_TelConVis,
                     l_DesPor,
                     l_NomEmp,
                     l_NomFun,
                     0, /* DDITelVisitado */
                     0, /* DDDTelVisitado */
                     '', /* TelConVisitado */
                     NULL, /* SituacaoWAV */
                     NULL, /* TIPDOC */
                     '', /* Desc. TipDoc*/
                     '', /* NUMDOC */
                     NULL, /* TIPVIS */
                     '', /* NomTIPVIS */
                     NULL, /* CODPOR */
                     NULL, /* CODPRM */
                     '', /* DESPRM */
                     '', /* PLAVEI*/
                     '', /* NomAut */
                     '', /* OBSVIS */
                     '', /* NomSol */
                     l_Email, /* EmaSol */
                     NULL, /* DATSAG */
                     NULL, /* HORSAG */
                     '', /* NOMUSU */
                     NULL, /* DATPSA */
                     NULL, /* HORPSA */
                     '' /* OBSREP */
                    );    
    END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - EMAIL*/

    IF (l_EnvChe = 2) OR (l_EnvChe = 9) THEN
      BEGIN
        SELECT R034CPL.NmDdi2, R034CPL.NmDdd2, R034CPL.NmTel2 INTO l_DDITelFun, l_DDDTelFun, l_TelConFun
        FROM R034CPL
        WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      R115NOT_ATUNOT(4,
                     :NEW.LOCAGV,
                     l_NomVis,
                     '',
                     l_data_zero,  /* l_DatPrv */
                     0,  /* l_HorPrv */
                     :NEW.DATVAL, 
                     :NEW.HORVAL,
                     :NEW.NOMOEM,
                     l_DDITelVis,
                     l_DDDTelVis,
                     l_TelConVis,
                     l_DesPor,
                     l_NomEmp,
                     l_NomFun,
                     l_DDITelFun, /* DDITelVisitado */
                     l_DDDTelFun, /* DDDTelVisitado */
                     l_TelConFun,  /* TelConVisitado */
                     NULL, /* SituacaoWAV */
                     NULL, /* TIPDOC */
                     '', /* Desc. TipDoc*/
                     '', /* NUMDOC */
                     NULL, /* TIPVIS */
                     '', /* NomTIPVIS */
                     NULL, /* CODPOR */
                     NULL, /* CODPRM */
                     '', /* DESPRM */
                     '', /* PLAVEI*/
                     '', /* NomAut */
                     '', /* OBSVIS */
                     '', /* NomSol */
                     l_Email, /* EmaSol */
                     NULL, /* DATSAG */
                     NULL, /* HORSAG */
                     '', /* NOMUSU */
                     NULL, /* DATPSA */
                     NULL, /* HORPSA */
                     '' /* OBSREP */
                    );                       
    END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - SMS*/

  END IF; /* FIM DA GERACAO DE REGISTRO PARA O NOTIFICADOR */

  IF (:NEW.PLAVEE IS NOT NULL) THEN

    SP_VEIPESCON('I',
                 :NEW.CRAVEI,
                 :NEW.NUMCRA,
                 0,
                 :NEW.PLAVEE,
                 :NEW.DATVAL,
                 :NEW.HORVAL, 
                 4,
                 :NEW.NUMEMP,
                 :NEW.TIPCOL,
                 :NEW.NUMCAD,
                 :NEW.TIPDOC,
                 :NEW.NUMDOC);
                 
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090MVI');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R090MVI_AUD (SEQREG,VERSEQ,DATENT,HORENT,SEQENT,NUMCRA,NUMEMP,TIPCOL,NUMCAD,TABORG,
                                   NUMLOC,CODPOR,TIPDOC,NUMDOC,SEGTDO,SEGDOC,PLAVEE,CODPRM,DDITEL,DDDTEL,
                                   DATVAL,HORVAL,TIPVIS,OBSVIS,CODUSU,DATSAI,HORSAI,DATSLO,HORSLO,PLAVES,
                                   TELCON,PLACAE,PLACAS,ASSVID,CODOEM,NUMCON,EMPCCU,CODCCU,NOMOEM,CODLIB,
                                   CODNAC,CODMOT,CRAVEI,PLACE2,PLACE3,PLACS2,PLACS3,EmaVis,LocAgv,
                                   VerPlf,CodPlf,ANDVIS,CPFRES,REPRES,REPTDO,REPDOC)
                           VALUES (l_seqreg,l_verseq,:NEW.DATENT,:NEW.HORENT,:NEW.SEQENT,:NEW.NUMCRA,:NEW.NUMEMP,
                                  :NEW.TIPCOL,:NEW.NUMCAD,:NEW.TABORG,:NEW.NUMLOC,:NEW.CODPOR,:NEW.TIPDOC,
                                  :NEW.NUMDOC,:NEW.SEGTDO,:NEW.SEGDOC,:NEW.PLAVEE,:NEW.CODPRM,:NEW.DDITEL,
                                  :NEW.DDDTEL,:NEW.DATVAL,:NEW.HORVAL,:NEW.TIPVIS,:NEW.OBSVIS,:NEW.CODUSU,
                                  :NEW.DATSAI,:NEW.HORSAI,:NEW.DATSLO,:NEW.HORSLO,:NEW.PLAVES,:NEW.TELCON,
                                  :NEW.PLACAE,:NEW.PLACAS,:NEW.ASSVID,:NEW.CODOEM,:NEW.NUMCON,:NEW.EMPCCU,
                                  :NEW.CODCCU,:NEW.NOMOEM,:NEW.CODLIB,:NEW.CODNAC,:NEW.CODMOT,:NEW.CRAVEI,
                                  :NEW.PLACE2,:NEW.PLACE3,:NEW.PLACS2,:NEW.PLACS3,:NEW.EmaVis,:NEW.LocAgv,
                                  :NEW.VerPlf,:NEW.CodPlf,:NEW.ANDVIS,:NEW.CPFRES,:NEW.REPRES,:NEW.REPTDO,
                                  :NEW.REPDOC);

          SP_AUDGENREG(l_seqreg,l_verseq,'R090MVI','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END		SENIOR;23·&␀␀

TRIGGER R090MVI_EI BEFORE INSERT ON R090MVI FOR EACH ROW
DECLARE
  l_online       BOOLEAN;
  l_bloaut       CHAR(1);
  l_tippev       NUMBER(1);
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_EnvChe       NUMBER(1);
  l_DesPor       VARCHAR(20);
  l_NomEmp       VARCHAR(40);
  l_NomVis       VARCHAR(80);
  l_Email        VARCHAR(100);
  l_NomOem       VARCHAR(60);
  l_NomFun       VARCHAR(40);
  l_DatPrv       DATE; 
  l_HorPrv       NUMBER(4);
  l_verdoc       NUMBER(1);
  l_mblvis       NUMBER(1);
  l_DDITelFun    NUMBER(3);
  l_DDDTelFun    NUMBER(3);
  l_TelConFun    VARCHAR2(20);
  l_DDITelVis    NUMBER(3);
  l_DDDTelVis    NUMBER(3);
  l_TelConVis    VARCHAR2(20);
  l_data_zero    DATE;
BEGIN
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN
  	  /* Procedure que atualiza os creditos de acesso.*/
      R090MVI_ATUCRV('I',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATENT,:NEW.DATVAL,:NEW.TIPVIS);

      BEGIN
          SELECT BLOAUT, TIPPEV INTO l_bloaut, l_tippev FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
       EXCEPTION WHEN OTHERS THEN
          l_bloaut := 'N';
          l_tippev := 1;
       END;

       IF   l_bloaut =  'S' THEN
            l_bloaut := '1';
       ELSE l_bloaut := '0';
       END IF;

      SP_VISCON_PEND93(:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,:NEW.CODPRM,:NEW.DATENT,:NEW.HORENT,:NEW.DATVAL,:NEW.HORVAL,l_bloaut,l_tippev,:NEW.TIPVIS,0,0,0,1,1, :NEW.ANDVIS);

      SP_PEND93(:NEW.TIPDOC,:NEW.NUMDOC,:NEW.NUMCRA,:NEW.CODPRM,:NEW.TIPVIS, :NEW.ANDVIS);			
  END IF;

  l_data_zero := '31/12/1900,00:00:00';
  
  /* Verifica definições de acesso */
  l_verdoc := 0;
  l_mblvis := 0;
  BEGIN
      SELECT VERDOC, MBLVIS INTO l_verdoc, l_mblvis FROM R070DAC;
  EXCEPTION 
      WHEN OTHERS THEN l_verdoc := 0;
  END;
  
  /* Bloqueia se houver colaborador associado */
  IF (l_verdoc > 2) AND                            /* se bloqueia colaborador */
     (l_mblvis > 0) AND                            /* se tem motivo para bloqueio cadastrado*/ 
     ((:NEW.TIPDOC = 2) OR (:NEW.TIPDOC = 4)) THEN /* só considera CPF ou passaporte */
     SP_BloColVIS( :NEW.TIPDOC, :NEW.NUMDOC, :NEW.DATENT, :NEW.HORENT, :NEW.DATVAl, :NEW.HORVAL, :NEW.CODUSU, l_mblvis);
  END IF;
 
  /* GERACAO DE REGISTRO PARA O NOTIFICADOR */
  IF (:NEW.TipVis IS NOT NULL) THEN
    BEGIN
      SELECT EnvChe INTO l_EnvChe FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_EnvChe := 0;
      WHEN OTHERS THEN NULL;
    END;

    BEGIN
      SELECT R030EMP.NomEmp, R034FUN.NomFun INTO l_NomEmp, l_NomFun FROM R030EMP, R034FUN
        WHERE 
          R030EMP.NUMEMP = :NEW.NUMEMP AND
          R034FUN.NUMEMP = :NEW.NUMEMP AND R034FUN.TIPCOL = :NEW.TIPCOL AND R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;

    BEGIN
      SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;

    BEGIN
      SELECT R090VIS.NomVis, R090VIS.DdiTel, R090VIS.DddTel, R090VIS.TelCon INTO l_NomVis, l_DDITelVis, l_DDDTelVis, l_TelConVis FROM R090VIS
      WHERE R090VIS.TIPDOC = :NEW.TIPDOC AND R090VIS.NUMDOC = :NEW.NUMDOC;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;
	  
    IF (l_EnvChe = 1) OR (l_EnvChe = 9) THEN
      BEGIN
        SELECT R034CPL.EmaCom
        INTO l_Email
        FROM R034CPL
        WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      R115NOT_ATUNOT(3,
                     :NEW.LOCAGV,
                     l_NomVis,
                     NULL,
                     l_data_zero,  /* l_DatPrv */
                     0,  /* l_HorPrv */
                     :NEW.DATVAL, 
                     :NEW.HORVAL,
                     :NEW.NOMOEM,
                     l_DDITelVis,
                     l_DDDTelVis,
                     l_TelConVis,
                     l_DesPor,
                     l_NomEmp,
                     l_NomFun,
                     0, /* DDITelVisitado */
                     0, /* DDDTelVisitado */
                     '', /* TelConVisitado */
                     NULL, /* SituacaoWAV */
                     NULL, /* TIPDOC */
                     '', /* Desc. TipDoc*/
                     '', /* NUMDOC */
                     NULL, /* TIPVIS */
                     '', /* NomTIPVIS */
                     NULL, /* CODPOR */
                     NULL, /* CODPRM */
                     '', /* DESPRM */
                     '', /* PLAVEI*/
                     '', /* NomAut */
                     '', /* OBSVIS */
                     '', /* NomSol */
                     l_Email, /* EmaSol */
                     NULL, /* DATSAG */
                     NULL, /* HORSAG */
                     '', /* NOMUSU */
                     NULL, /* DATPSA */
                     NULL, /* HORPSA */
                     '' /* OBSREP */
                    );    
    END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - EMAIL*/

    IF (l_EnvChe = 2) OR (l_EnvChe = 9) THEN
      BEGIN
        SELECT R034CPL.NmDdi2, R034CPL.NmDdd2, R034CPL.NmTel2 INTO l_DDITelFun, l_DDDTelFun, l_TelConFun
        FROM R034CPL
        WHERE R034CPL.NUMEMP = :NEW.NUMEMP AND R034CPL.TIPCOL = :NEW.TIPCOL AND R034CPL.NUMCAD = :NEW.NUMCAD;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      R115NOT_ATUNOT(4,
                     :NEW.LOCAGV,
                     l_NomVis,
                     '',
                     l_data_zero,  /* l_DatPrv */
                     0,  /* l_HorPrv */
                     :NEW.DATVAL, 
                     :NEW.HORVAL,
                     :NEW.NOMOEM,
                     l_DDITelVis,
                     l_DDDTelVis,
                     l_TelConVis,
                     l_DesPor,
                     l_NomEmp,
                     l_NomFun,
                     l_DDITelFun, /* DDITelVisitado */
                     l_DDDTelFun, /* DDDTelVisitado */
                     l_TelConFun,  /* TelConVisitado */
                     NULL, /* SituacaoWAV */
                     NULL, /* TIPDOC */
                     '', /* Desc. TipDoc*/
                     '', /* NUMDOC */
                     NULL, /* TIPVIS */
                     '', /* NomTIPVIS */
                     NULL, /* CODPOR */
                     NULL, /* CODPRM */
                     '', /* DESPRM */
                     '', /* PLAVEI*/
                     '', /* NomAut */
                     '', /* OBSVIS */
                     '', /* NomSol */
                     l_Email, /* EmaSol */
                     NULL, /* DATSAG */
                     NULL, /* HORSAG */
                     '', /* NOMUSU */
                     NULL, /* DATPSA */
                     NULL, /* HORPSA */
                     '' /* OBSREP */
                    );                       
    END IF; /* FIM DA NOTIFICAÇÃO DE CHEGADA DO VISITANTE - SMS*/

  END IF; /* FIM DA GERACAO DE REGISTRO PARA O NOTIFICADOR */

  IF (:NEW.PLAVEE IS NOT NULL) THEN

    SP_VEIPESCON('I',
                 :NEW.CRAVEI,
                 :NEW.NUMCRA,
                 0,
                 :NEW.PLAVEE,
                 :NEW.DATVAL,
                 :NEW.HORVAL, 
                 4,
                 :NEW.NUMEMP,
                 :NEW.TIPCOL,
                 :NEW.NUMCAD,
                 :NEW.TIPDOC,
                 :NEW.NUMDOC);
                 
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090MVI');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R090MVI_AUD (SEQREG,VERSEQ,DATENT,HORENT,SEQENT,NUMCRA,NUMEMP,TIPCOL,NUMCAD,TABORG,
                                   NUMLOC,CODPOR,TIPDOC,NUMDOC,SEGTDO,SEGDOC,PLAVEE,CODPRM,DDITEL,DDDTEL,
                                   DATVAL,HORVAL,TIPVIS,OBSVIS,CODUSU,DATSAI,HORSAI,DATSLO,HORSLO,PLAVES,
                                   TELCON,PLACAE,PLACAS,ASSVID,CODOEM,NUMCON,EMPCCU,CODCCU,NOMOEM,CODLIB,
                                   CODNAC,CODMOT,CRAVEI,PLACE2,PLACE3,PLACS2,PLACS3,EmaVis,LocAgv,
                                   VerPlf,CodPlf,ANDVIS,CPFRES,REPRES,REPTDO,REPDOC)
                           VALUES (l_seqreg,l_verseq,:NEW.DATENT,:NEW.HORENT,:NEW.SEQENT,:NEW.NUMCRA,:NEW.NUMEMP,
                                  :NEW.TIPCOL,:NEW.NUMCAD,:NEW.TABORG,:NEW.NUMLOC,:NEW.CODPOR,:NEW.TIPDOC,
                                  :NEW.NUMDOC,:NEW.SEGTDO,:NEW.SEGDOC,:NEW.PLAVEE,:NEW.CODPRM,:NEW.DDITEL,
                                  :NEW.DDDTEL,:NEW.DATVAL,:NEW.HORVAL,:NEW.TIPVIS,:NEW.OBSVIS,:NEW.CODUSU,
                                  :NEW.DATSAI,:NEW.HORSAI,:NEW.DATSLO,:NEW.HORSLO,:NEW.PLAVES,:NEW.TELCON,
                                  :NEW.PLACAE,:NEW.PLACAS,:NEW.ASSVID,:NEW.CODOEM,:NEW.NUMCON,:NEW.EMPCCU,
                                  :NEW.CODCCU,:NEW.NOMOEM,:NEW.CODLIB,:NEW.CODNAC,:NEW.CODMOT,:NEW.CRAVEI,
                                  :NEW.PLACE2,:NEW.PLACE3,:NEW.PLACS2,:NEW.PLACS3,:NEW.EmaVis,:NEW.LocAgv,
                                  :NEW.VerPlf,:NEW.CodPlf,:NEW.ANDVIS,:NEW.CPFRES,:NEW.REPRES,:NEW.REPTDO,
                                  :NEW.REPDOC);

          SP_AUDGENREG(l_seqreg,l_verseq,'R090MVI','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀Hİ␀␀		SENIOR;0P

TRIGGER R090MVI_EU AFTER UPDATE ON R090MVI FOR EACH ROW
