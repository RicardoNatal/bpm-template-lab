TRIGGER R070DAC_SU AFTER UPDATE ON R070DAC FOR EACH ROW
DECLARE
  l_online BOOLEAN;
BEGIN
  IF (:OLD.UsaCpd <> :NEW.UsaCpd) OR (:OLD.UsaCpd IS NULL AND :NEW.UsaCpd IS NOT NULL) THEN 
    SP_VerOnLine(l_online OUT);
    IF (l_online = TRUE) THEN
        /* GERA PENDÊNCIA updateCSMProperties para todas as centralizadoras - Pendência 56 */
        SP_PEND56(0);
    END IF;
  END IF;
END		SENIOR;21„␀␀

