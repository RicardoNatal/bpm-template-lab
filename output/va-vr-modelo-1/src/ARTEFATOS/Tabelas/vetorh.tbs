TRIGGER R064CMP_EU AFTER UPDATE ON R064CMP FOR EACH ROW

DECLARE
   l_strerr      VARCHAR2(255);
   l_DataZero    DATE;
   l_data_fim    DATE;
   l_online      BOOLEAN;
   l_datatu      DATE;
   
   /* Tabela temporária */
   CREATE_TEMP_TABLE R064CMP_AUX;
   
BEGIN
   l_datatu := CURDATE();
   IF :NEW.TIPCMP = 1 THEN
      IF (:NEW.PERCMP <> 1) AND (:NEW.PERCMP <> 2) AND
         (:NEW.PERCMP <> 3) AND (:NEW.PERCMP <> 4) AND
         (:NEW.PERCMP <> 5) AND (:NEW.PERCMP <> 6) AND
         (:NEW.PERCMP <> 7) THEN
         l_strerr := 'Perído da Compensação não permitido para o Tipo: ' ||
                     CONVERT(NUMBER_TO_CHAR,:NEW.TIPCMP) || ' Período: ' ||
                     CONVERT(NUMBER_TO_CHAR,:NEW.PERCMP) || ' Período: ' ||
                     ' tipcol = '||CONVERT(NUMBER_TO_CHAR,:NEW.TIPCOL) ||
                     ' numemp = '||CONVERT(NUMBER_TO_CHAR,:NEW.NUMEMP) ||
                     ' numcad = '||CONVERT(NUMBER_TO_CHAR,:NEW.NUMCAD);
         RAISERROR 103 l_strerr;
      END IF;
   END IF;

   IF :NEW.TIPCMP = 2 THEN
      IF (:NEW.PERCMP <> 1) AND (:NEW.PERCMP <> 2) AND
         (:NEW.PERCMP <> 3) AND (:NEW.PERCMP <> 4) AND
         (:NEW.PERCMP <> 5) THEN
         l_strerr := 'Perído da Compensação não permitido para o Tipo: ' ||
                     CONVERT(NUMBER_TO_CHAR,:NEW.TIPCMP) || ' Período: ' ||
                     CONVERT(NUMBER_TO_CHAR,:NEW.PERCMP) || ' Período: ' ||
                     ' tipcol = '||CONVERT(NUMBER_TO_CHAR,:NEW.TIPCOL) ||
                     ' numemp = '||CONVERT(NUMBER_TO_CHAR,:NEW.NUMEMP) ||
                     ' numcad = '||CONVERT(NUMBER_TO_CHAR,:NEW.NUMCAD);
         RAISERROR 103 l_strerr;
      END IF;
   END IF;

   IF :NEW.TIPCMP = 4 THEN
      IF (:NEW.PERCMP <> 8) AND (:NEW.PERCMP <> 9) THEN
         l_strerr := 'Perído da Compensação não permitido para o Tipo: ' ||
                     CONVERT(NUMBER_TO_CHAR,:NEW.TIPCMP) || ' Período: ' ||
                     CONVERT(NUMBER_TO_CHAR,:NEW.PERCMP) || ' Período: ' ||
                     ' tipcol = '||CONVERT(NUMBER_TO_CHAR,:NEW.TIPCOL) ||
                     ' numemp = '||CONVERT(NUMBER_TO_CHAR,:NEW.NUMEMP) ||
                     ' numcad = '||CONVERT(NUMBER_TO_CHAR,:NEW.NUMCAD);
         RAISERROR 103 l_strerr;
      END IF;
   END IF;

   /* Na Alteração do Registro seta todo o periodo como alterado */
   /* Também verifica a Data Final                               */
   l_DataZero := '31/12/1900,00:00:00';
   IF   ((:OLD.DATFIM = l_DataZero) OR (:NEW.DATFIM = l_DataZero)) THEN
        l_data_fim := '04/06/2080,00:00:00';
   ELSIF (:NEW.DATFIM > :OLD.DATFIM) THEN
        l_data_fim := :NEW.DATFIM;
   ELSE l_data_fim := :OLD.DATFIM;
   END IF;


   /* ACESSO */
   /* ACESSO atualiza as faixas de acesso e ponto */
   IF  (DATETIMEADD(DD,-6,:NEW.DATINI) <= l_datatu)
   AND (:NEW.DATFIM >= l_datatu) THEN
        SP_VerOnLine(l_online OUT);
        IF   (l_online = TRUE) THEN
            BEGIN
            /* Salva Registro */
              INSERT INTO R064CMP_AUX (NUMEMP,TIPCOL,NUMCAD,DATINI)
                          VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI);
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro no INSERT em R064CMP_AUX.';
            END;
        END IF;
   END IF;

   BEGIN
   UPDATE R066APU SET DIAALT = 4
          WHERE NUMEMP = :NEW.NUMEMP AND
                TIPCOL = :NEW.TIPCOL AND
                NUMCAD = :NEW.NUMCAD AND
                DATAPU >= :NEW.DATINI AND
                DATAPU <= l_data_fim;
   EXCEPTION WHEN OTHERS THEN
     NULL;
   END;
END␀•Ø␀␀	SENIOR;0U␀␀

