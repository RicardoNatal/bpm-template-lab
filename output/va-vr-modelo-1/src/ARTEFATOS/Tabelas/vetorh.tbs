		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FILCTB', CONVERT(NUMBER_TO_CHAR, :OLD.FilCtb));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CCURAT', :OLD.CcuRat);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LOCRAT', CONVERT(NUMBER_TO_CHAR, :OLD.LocRat));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRAT', CONVERT(NUMBER_TO_CHAR, :OLD.CodRat));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONDEB', :OLD.ConDeb);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONCRE', :OLD.ConCre);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REDDEB', CONVERT(NUMBER_TO_CHAR, :OLD.RedDeb));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REDCRE', CONVERT(NUMBER_TO_CHAR, :OLD.RedCre));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FILCTP', CONVERT(NUMBER_TO_CHAR, :OLD.FilCtP));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCCU', :OLD.CodCcu);
		RH_RET_CODLOC(:OLD.TABORG,:OLD.NUMLOC,:OLD.DATLAN, xCodLoc OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', xCodLoc);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RATPAD', CONVERT(NUMBER_TO_CHAR, :OLD.RatPad));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONDEP', :OLD.ConDeP);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONCRP', :OLD.ConCrP);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REDDEP', CONVERT(NUMBER_TO_CHAR, :OLD.RedDeP));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REDCRP', CONVERT(NUMBER_TO_CHAR, :OLD.RedCrP));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DEFCON', CONVERT(NUMBER_TO_CHAR, :OLD.DefCon));
