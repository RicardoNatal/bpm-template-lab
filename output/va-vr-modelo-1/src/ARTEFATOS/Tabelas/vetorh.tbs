␀␀PROCEDURE R034FUN_ATUFGT
 IS

l_strerr       VARCHAR2(255);

/* CURSOR c/ os registros gravados no R034FGT_AUX */
  CURSOR c_r034fgt_upd IS
  SELECT NUMEMP,TIPCOL,NUMCAD,CMPFGT,NOMFUN,NUMCTP,SERCTP,ESTCTP,
         NUMPIS,DATADM,DATNAS,ALTEND,DATOPC,NUMCPF
    FROM R034FGT_AUX;
  TYPE t_r034fgt_aux IS RECORD(
    NUMEMP   r034fgt_AUX.NUMEMP%TYPE,
    TIPCOL   r034fgt_AUX.TIPCOL%TYPE,
    NUMCAD   r034fgt_AUX.NUMCAD%TYPE,
    CMPFGT   r034fgt_AUX.CMPFGT%TYPE,
    NOMFUN   r034fgt_AUX.NOMFUN%TYPE,
    NUMCTP   r034fgt_AUX.NUMCTP%TYPE,
    SERCTP   r034fgt_AUX.SERCTP%TYPE,
    ESTCTP   r034fgt_AUX.ESTCTP%TYPE,
    NUMPIS   r034fgt_AUX.NUMPIS%TYPE,
    DATADM   r034fgt_AUX.DATADM%TYPE,
    DATNAS   r034fgt_AUX.DATNAS%TYPE,
    ALTEND   r034fgt_AUX.ALTEND%TYPE,
    DATOPC   r034fgt_AUX.DATOPC%TYPE,
    NUMCPF   r034fgt_AUX.NUMCPF%TYPE);
  l_r034fgt_aux t_r034fgt_aux;

BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r034fgt_upd INTO  l_r034fgt_aux.NUMEMP,
                              l_r034fgt_aux.TIPCOL,
                              l_r034fgt_aux.NUMCAD,
                              l_r034fgt_aux.CMPFGT,
                              l_r034fgt_aux.NOMFUN,
                              l_r034fgt_aux.NUMCTP,
                              l_r034fgt_aux.SERCTP,
                              l_r034fgt_aux.ESTCTP,
                              l_r034fgt_aux.NUMPIS,
                              l_r034fgt_aux.DATADM,
                              l_r034fgt_aux.DATNAS,
                              l_r034fgt_aux.ALTEND,
                              l_r034fgt_aux.DATOPC,
                              l_r034fgt_aux.NUMCPF  
  LOOP
   /* Grava tabela de fgts */
      BEGIN
      /* Insere Registro Aux */
        INSERT INTO R034FGT (NUMEMP,TIPCOL,NUMCAD,CMPFGT,NOMFUN,NUMCTP,SERCTP,ESTCTP,NUMPIS,DATADM,DATNAS,ALTEND,DATOPC,NUMCPF)
                     VALUES (l_r034fgt_aux.NUMEMP,l_r034fgt_aux.TIPCOL,l_r034fgt_aux.NUMCAD,l_r034fgt_aux.CMPFGT,
                             l_r034fgt_aux.NOMFUN,l_r034fgt_aux.NUMCTP,l_r034fgt_aux.SERCTP,l_r034fgt_aux.ESTCTP,
                             l_r034fgt_aux.NUMPIS,l_r034fgt_aux.DATADM,l_r034fgt_aux.DATNAS,l_r034fgt_aux.ALTEND,
                             l_r034fgt_aux.DATOPC,l_r034fgt_aux.NUMCPF);
      EXCEPTION WHEN OTHERS THEN
        l_strerr := 'Erro no INSERT do R034FGT'||
                    ' tipcol = '||CONVERT(NUMBER_TO_CHAR,l_r034fgt_aux.TIPCOL)||
                    ' numemp = '||CONVERT(NUMBER_TO_CHAR,l_r034fgt_aux.NUMEMP)||
                    ' numcad = '||CONVERT(NUMBER_TO_CHAR,l_r034fgt_aux.NUMCAD);
        RAISERROR 103 l_strerr;
      END;
  END LOOP;

 /* Apaga Registro OLD em r034fgt_AUX */
  BEGIN
    DELETE FROM R034FGT_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀„Ó␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE R034FUN_FGTAUX(N_NUMEMP NUMBER(4),N_TIPCOL NUMBER(1),N_NUMCAD NUMBER(9),O_NOMFUN VARCHAR2(40),O_NUMCTP NUMBER,O_SERCTP VARCHAR2(5),O_ESTCTP VARCHAR2(2),O_NUMPIS NUMBER,O_DATADM DATE,O_DATNAS DATE,O_DATOPC DATE,O_NUMCPF NUMBER)
 IS

l_data_atual   DATE;
  l_cmpfgt       DATE;
  l_incfgt       BOOLEAN;
  l_dias_mes     NUMBER(2);
  l_aux          NUMBER(1);
BEGIN
  /* calcula a data da competência = 1o. dia do mês */
  l_data_atual := CURDATE();
  l_dias_Mes := DAYOFMONTH(l_data_atual) - 1;
  l_dias_Mes := l_dias_Mes * -1;
  l_cmpfgt := DATETIMEADD(DD,l_dias_Mes,l_data_atual);
  l_incfgt := FALSE;
  BEGIN
   SELECT TIPCOL INTO l_aux FROM R034FGT
     WHERE NUMEMP = n_numemp
       AND TIPCOL = n_tipcol
       AND NUMCAD = n_numcad
       AND CMPFGT = l_cmpfgt;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
         l_incfgt := TRUE;
    WHEN OTHERS THEN
         RAISERROR 103 'Erro no SELECT R034FGT';
  END;
  /* se não encontrou o registro inclui senão não faz nada */
  IF  (l_incfgt = TRUE) THEN
       BEGIN
       /* Insere Registro Aux */
         INSERT INTO R034FGT_AUX (NUMEMP,TIPCOL,NUMCAD,CMPFGT,NOMFUN,NUMCTP,SERCTP,ESTCTP,NUMPIS,DATADM,DATNAS,ALTEND,DATOPC,NUMCPF)
                      VALUES (n_numemp,n_tipcol,n_numcad,l_cmpfgt,
                              o_nomfun,o_numctp,o_serctp,o_estctp,
                              o_numpis,o_datadm,o_datnas,'N',o_datopc,o_numcpf);
       EXCEPTION WHEN OTHERS THEN
         RAISERROR 103 'Erro no INSERT em R034FGT_AUX.';
       END;
  END IF;
END␀¦Ó␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_VER_MODULO_PRP
Œ␀␀PROCEDURE R034MDL_VERUSOBS(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9))
 IS

l_qtde   NUMBER;
  l_TemMod VARCHAR2(1);
BEGIN
  RH_VER_MODULO_PRP(1, l_TemMod OUT);
  IF (l_TemMod = 'S') THEN
    BEGIN
      SELECT COUNT(*) INTO l_qtde FROM R044MOV
        WHERE NUMEMP = p_numemp
          AND TIPCOL = p_tipcol
          AND NUMCAD = p_numcad
          AND (ORIMOV = 'B');
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT da tabela R044MOV.';
    END;
    IF (l_qtde > 0) THEN
      RAISERROR 103 '[msg-R044MOV-BS]Colaborador está sendo usado na tabela R044MOV (módulo BS).';
    END IF;
  END IF;
END␀§Ó␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_VER_MODULO_PRP
s␀␀PROCEDURE R034MDL_VERUSOCS(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9))
 IS

l_qtde   NUMBER;
  l_TemMod VARCHAR2(1);
BEGIN
  RH_VER_MODULO_PRP(2, l_TemMod OUT);
  IF (l_TemMod = 'S') THEN
    BEGIN
      SELECT COUNT(*) INTO l_qtde FROM R077ACT
        WHERE (NUMEMP = p_numemp
          AND TIPCOL = p_tipcol
          AND NUMCAD = p_numcad)
           OR (EMPAVL = p_numemp
          AND TIPAVL = p_tipcol
          AND CADAVL = p_numcad);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT da tabela R077ACT.';
    END;
    IF (l_qtde > 0) THEN
      RAISERROR 103 '[msg-R077ACT-CS]Colaborador está sendo usado na tabela R077ACT (módulo CS).';
    END IF;

    BEGIN
      SELECT COUNT(*) INTO l_qtde FROM R077APA
        WHERE (NUMEMP = p_numemp
          AND TIPCOL = p_tipcol
          AND NUMCAD = p_numcad)
           OR (EMPAVA = p_numemp
          AND TCLAVA = p_tipcol
          AND CADAVA = p_numcad);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT da tabela R077APA.';
    END;
    IF (l_qtde > 0) THEN
      RAISERROR 103 '[msg-R077APA-CS]Colaborador está sendo usado na tabela R077APA (módulo CS).';
    END IF;

    BEGIN
      SELECT COUNT(*) INTO l_qtde FROM R079AEA
        WHERE (NUMEMP = p_numemp
          AND TIPCOL = p_tipcol
          AND NUMCAD = p_numcad)
           OR (EMPAVA = p_numemp
          AND TCLAVA = p_tipcol
          AND CADAVA = p_numcad);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT da tabela R079AEA.';
    END;
    IF (l_qtde > 0) THEN
      RAISERROR 103 '[msg-R079AEA-CS]Colaborador está sendo usado na tabela R079AEA (módulo CS).';
    END IF;

    BEGIN
      SELECT COUNT(*) INTO l_qtde FROM R077HHT
        WHERE NUMEMP = p_numemp
          AND TIPCOL = p_tipcol
          AND NUMCAD = p_numcad;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT da tabela R077HHT.';
    END;
    IF (l_qtde > 0) THEN
      RAISERROR 103 '[msg-R077HHT-CS]Colaborador está sendo usado na tabela R077HHT (módulo CS).';
    END IF;

    BEGIN
      SELECT COUNT(*) INTO l_qtde FROM R076PCA
        WHERE NUMEMP = p_numemp
          AND TIPCOL = p_tipcol
          AND NUMCAD = p_numcad;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT da tabela R076PCA.';
    END;
    IF (l_qtde > 0) THEN
      RAISERROR 103 '[msg-R076PCA-CS]Colaborador está sendo usado na tabela R076PCA (módulo CS).';
    END IF;

    BEGIN
      SELECT COUNT(*) INTO l_qtde FROM R076PSA
        WHERE NUMEMP = p_numemp
          AND TIPCOL = p_tipcol
          AND NUMCAD = p_numcad;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT da tabela R076PSA.';
    END;
    IF (l_qtde > 0) THEN
      RAISERROR 103 '[msg-R076PSA-CS]Colaborador está sendo usado na tabela R076PSA (módulo CS).';
    END IF;
  END IF;
END␀¨Ó␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_VER_MODULO_PRP
À␀␀PROCEDURE R034MDL_VERUSOJR(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9))
 IS

l_qtde   NUMBER;
  l_TemMod VARCHAR2(1);
BEGIN
  RH_VER_MODULO_PRP(3, l_TemMod OUT);
  IF (l_TemMod = 'S') THEN
    BEGIN
      SELECT COUNT(*) INTO l_qtde FROM R104REC
        WHERE (EMPAUT = p_numemp
          AND TIPCOL = p_tipcol
          AND NUMCAD = p_numcad);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT da tabela R104REC.';
    END;
    IF (l_qtde > 0) THEN
      RAISERROR 103 '[msg-R104REC-JR]Colaborador está sendo usado na tabela R104REC (módulo JR).';
    END IF;

    BEGIN
      SELECT COUNT(*) INTO l_qtde FROM R104REF
        WHERE (EMPREU = p_numemp
          AND TIPCOL = p_tipcol
          AND NUMCAD = p_numcad);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT da tabela R104REF.';
    END;
    IF (l_qtde > 0) THEN
      RAISERROR 103 '[msg-R104REF-JR]Colaborador está sendo usado na tabela R104REF (módulo JR).';
    END IF;

    BEGIN
      SELECT COUNT(*) INTO l_qtde FROM R104TES
        WHERE (EMPTES = p_numemp
          AND TIPCOL = p_tipcol
          AND NUMCAD = p_numcad);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT da tabela R104TES.';
    END;
    IF (l_qtde > 0) THEN
      RAISERROR 103 '[msg-R104TES-JR]Colaborador está sendo usado na tabela R104TES (módulo JR).';
    END IF;
    
    BEGIN
      SELECT COUNT(*) INTO l_qtde FROM R346CPT
        WHERE (NUMEMP = p_numemp
          AND TIPCOL = p_tipcol
          AND NUMCAD = p_numcad);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT da tabela R346CPT.';
    END;
    IF (l_qtde > 0) THEN
      RAISERROR 103 '[msg-R346CPT-JR]Colaborador está sendo usado na tabela R346CPT (módulo JR).';
    END IF;
    
    BEGIN
      SELECT COUNT(*) INTO l_qtde FROM R346TPT
        WHERE (NUMEMP = p_numemp
          AND TIPCOL = p_tipcol
          AND NUMCAD = p_numcad);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT da tabela R346TPT.';
    END;
    IF (l_qtde > 0) THEN
      RAISERROR 103 '[msg-R346TPT-JR]Colaborador está sendo usado na tabela R346TPT (módulo JR).';
    END IF;
  END IF;
END␀©Ó␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_VER_MODULO_PRP
