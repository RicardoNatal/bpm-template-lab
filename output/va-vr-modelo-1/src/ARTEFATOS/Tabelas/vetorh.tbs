TRIGGER R304RRC_SI AFTER INSERT ON R304RRC
DECLARE
	CURSOR c_R304RRC IS
	SELECT NUMEMP, NUMEDI, NUMESP, TIPQUA, CARFUN, DATINI, NUMCPF, NUMINS, SEQREG
	  FROM R304RRC
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304RRC IS RECORD (
		NUMEMP   R304RRC.NumEmp%TYPE,
		NUMEDI   R304RRC.NumEdi%TYPE,
		NUMESP   R304RRC.NumEsp%TYPE,
		TIPQUA   R304RRC.TipQua%TYPE,
		CARFUN   R304RRC.CarFun%TYPE,
		DATINI   R304RRC.DatIni%TYPE,
		NUMCPF   R304RRC.NUMCPF%TYPE,
		NUMINS   R304RRC.NUMINS%TYPE,
		SEQREG   R304RRC.SeqReg%TYPE
	);
    
    l_R304RRC t_R304RRC;
    l_PidSta VARCHAR2(30);
    l_MsgErr VARCHAR2(255);
BEGIN
	FOREACH c_R304RRC INTO l_R304RRC.NumEmp, l_R304RRC.NumEdi, l_R304RRC.NumEsp, l_R304RRC.TipQua, l_R304RRC.CarFun, l_R304RRC.DatIni, l_R304RRC.NUMCPF, l_R304RRC.NUMINS, l_R304RRC.SeqReg
	LOOP
		/* Busca PID gravado no registro do Concurso/Processo Seletivo */
		BEGIN
			SELECT RCC.PIDSTA INTO l_PidSta
			  FROM R304RCC RCC, R304STA STA
			 WHERE RCC.PIDSTA = STA.PIDSTA
			   AND RCC.NUMEMP = l_R304RRC.NumEmp
			   AND RCC.NUMEDI = l_R304RRC.NumEdi
			   AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_MsgErr := 'Não existe registro de Resultado do Concurso pendente com as seguintes chaves: ' ||
					'Empresa: ' || CONVERT(NUMBER_TO_CHAR, l_R304RRC.NumEmp) || ', Edital: ' || l_R304RRC.NumEdi || '.';
				RAISERROR 103 l_MsgErr;
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304RCC.';
		END;
		
		BEGIN
			UPDATE R304RRC
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304RRC.NumEmp
			   AND NUMEDI = l_R304RRC.NumEdi
			   AND NUMESP = l_R304RRC.NumEsp
			   AND TIPQUA = l_R304RRC.TipQua
			   AND CARFUN = l_R304RRC.CarFun
			   AND DATINI = l_R304RRC.DatIni
			   AND NUMCPF = l_R304RRC.NUMCPF
			   AND NUMINS = l_R304RRC.NUMINS
			   AND SEQREG = l_R304RRC.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304RRC.';
		END;
	END LOOP;
END␀ßå␀␀		SENIOR;0*␀␀TRIGGER R304RRC_EI BEFORE INSERT ON R304RRC FOR EACH ROW
DECLARE
	l_SeqReg   R304RRC.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Verifica se está tentando incluir um registro com sequência maior do que a última já cadastrada */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304RRC
		 WHERE NUMEMP = :NEW.NumEmp
		   AND NUMEDI = :NEW.NumEdi
		   AND NUMESP = :NEW.NumEsp
		   AND TIPQUA = :NEW.TipQua
		   AND CARFUN = :NEW.CarFun
		   AND DATINI = :NEW.DatIni
		   AND NUMCPF = :NEW.NUMCPF
		   AND NUMINS = :NEW.NUMINS
		   AND SEQREG <> :NEW.SeqReg;
	   
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304RRC.';
	END;
	
	IF (l_SeqReg > 0) THEN
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀àå␀␀		SENIOR;0ª␀␀

TRIGGER R304RRC_EU BEFORE UPDATE ON R304RRC FOR EACH ROW
