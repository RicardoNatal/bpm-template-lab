PROCEDURE SP_PEND85(P_TIPOPE NUMBER(1),P_TIPVIS NUMBER(3),P_DESVIS VARCHAR2(40),P_CODPRM NUMBER(5),P_BLOAUT CHAR(1),P_TIPPES NUMBER(1),P_GERCRE CHAR(1),P_CTRCRE NUMBER(1),P_CTRADP CHAR(1),P_CTRBIO CHAR(1),P_GRACON NUMBER(3),P_HORVIS NUMBER(4),P_HORLIM NUMBER(4),P_CONREA CHAR(1),P_USATAA CHAR(1),P_ENVAGE NUMBER(1),P_ENVCHE NUMBER(1),P_USARFA CHAR(1))
 IS

l_valstr     VARCHAR2(2047);
  l_tipOpe     CHAR(1);
  l_tipVis     CHAR(3);
  l_codPrmStr  CHAR(5);
  l_tipPesStr  CHAR(1);
  l_TamVis     NUMBER(3);
  l_desVis     VARCHAR2(40);
  l_TamVisStr  CHAR(2);
  l_datatu     DATE;
  l_horatu     NUMBER(4);
  l_seqenv     NUMBER(2);
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datenv     CHAR(16);
  l_seqstr     CHAR(2);
  l_ctrCreStr  CHAR(1);
  l_graConStr  CHAR(3);
  l_horvisstr  CHAR(4);
  l_horlimstr  CHAR(4);
  l_conRea     CHAR(1);
  l_bloAut     CHAR(1);
  l_gerCre     CHAR(1);
  l_ctrAdp     CHAR(1); 
  l_ctrBio     CHAR(1);
  l_usaTAA     CHAR(1);
  l_EnvAgeStr  CHAR(1);
  l_EnvCheStr  CHAR(1);
  l_usaRfa     CHAR(1);
BEGIN
  /* Calcula  data/hora de envio da pendência.*/
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

  SP_INTSTR(p_tipOpe,'9'           , l_tipOpe OUT);
  SP_INTSTR(p_tipVis,'999'         , l_tipVis OUT);
  SP_INTSTR(p_tipPes,'9'           , l_tipPesStr OUT);
  IF (l_tipPesStr <> '2') THEN
      l_tipPesStr := '1';
  END IF;  
  SP_INTSTR(p_codPrm,'99999'       , l_codPrmStr OUT);  
  SP_INTSTR(p_ctrCre,'9'           , l_ctrCreStr OUT);
  SP_INTSTR(p_graCon,'999'         , l_graConStr OUT);
  SP_INTSTR(p_horvis,'HHMM',l_horvisstr OUT);
  SP_INTSTR(p_horlim,'HHMM',l_horlimstr OUT);
  l_desVis := RTrim(LTrim(p_desVis));
  l_TamVis := LENGTH(l_desVis);
  SP_INTSTR(l_TamVis,'99',l_TamVisStr OUT);
  l_conRea := p_conRea;
  l_bloAut := p_bloAut;
  l_gerCre := p_gerCre;
  l_ctrAdp := p_ctrAdp; 
  l_ctrBio := p_ctrBio;
  l_usaTAA := p_usaTAA;
  l_usaRfa := p_usaRfa;
  SP_INTSTR(p_EnvAge,'9'           , l_EnvAgeStr OUT);
  SP_INTSTR(p_EnvChe,'9'           , l_EnvCheStr OUT);
  SP_SIMNAO_INT(l_conRea OUT);
  SP_SIMNAO_INT(l_bloAut OUT); 
  SP_SIMNAO_INT(l_gerCre OUT); 
  SP_SIMNAO_INT(l_ctrAdp OUT);
  SP_SIMNAO_INT(l_usaTAA OUT);
  SP_SIMNAO_INT(l_usaRfa OUT);
  
  IF (p_ctrBio = '1') THEN 
    l_ctrBio := '0';
  ELSIF (p_ctrBio = '2') THEN 
    l_ctrBio := '1';
  ELSIF (p_ctrBio = '3') THEN 
    l_ctrBio := '2';
  ELSE
    l_ctrBio := p_ctrBio; 
  END IF;
  
  IF (l_TamVis IS NULL) OR (l_TamVis = 0) THEN
    l_valstr := '85' || l_datenv || l_tipOpe || l_tipVis || '00'; 
  ELSE
    l_valstr := '85' || l_datenv || l_tipOpe || l_tipVis || l_TamVisStr || l_desVis;
  END IF;
  
  l_valstr := l_valstr || l_codPrmStr || l_bloAut || l_tipPesStr || l_gerCre || l_ctrCreStr || l_ctrAdp;
  l_valstr := l_valstr || l_ctrBio;
  l_valstr := l_valstr || l_graConStr || l_horvisstr || l_horlimstr || l_conRea;
  l_valstr := l_valstr || l_usaTAA;
  l_valstr := l_valstr || l_EnvAgeStr;
  l_valstr := l_valstr || l_EnvCheStr;
  l_valstr := l_valstr || l_usaRfa;
  
  BEGIN
    SP_PORCOM(l_valstr, '0');
  EXCEPTION
    WHEN OTHERS THEN RAISERROR 103 'SP_PEND85: Erro ao gerar pendência 85.';
  END;
END		SENIOR;210SP_DATSTR
SP_INTSTR
SP_SIMNAO_INT
SP_PORCOM
­␀␀

PROCEDURE SP_PEND85(P_TIPOPE NUMBER(1),P_TIPVIS NUMBER(3),P_DESVIS VARCHAR2(40),P_CODPRM NUMBER(5),P_BLOAUT CHAR(1),P_TIPPES NUMBER(1),P_GERCRE CHAR(1),P_CTRCRE NUMBER(1),P_CTRADP CHAR(1),P_CTRBIO CHAR(1),P_GRACON NUMBER(3),P_HORVIS NUMBER(4),P_HORLIM NUMBER(4),P_CONREA CHAR(1),P_USATAA CHAR(1),P_ENVAGE NUMBER(1),P_ENVCHE NUMBER(1),P_USARFA CHAR(1))
 IS

l_valstr     VARCHAR2(2047);
  l_tipOpe     CHAR(1);
  l_tipVis     CHAR(3);
  l_codPrmStr  CHAR(5);
  l_tipPesStr  CHAR(1);
  l_TamVis     NUMBER(3);
  l_desVis     VARCHAR2(40);
  l_TamVisStr  CHAR(2);
  l_datatu     DATE;
  l_horatu     NUMBER(4);
  l_seqenv     NUMBER(2);
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datenv     CHAR(16);
  l_seqstr     CHAR(2);
  l_ctrCreStr  CHAR(1);
  l_graConStr  CHAR(3);
  l_horvisstr  CHAR(4);
  l_horlimstr  CHAR(4);
  l_conRea     CHAR(1);
  l_bloAut     CHAR(1);
  l_gerCre     CHAR(1);
  l_ctrAdp     CHAR(1); 
  l_ctrBio     CHAR(1);
  l_usaTAA     CHAR(1);
  l_EnvAgeStr  CHAR(1);
  l_EnvCheStr  CHAR(1);
  l_usaRfa     CHAR(1);
BEGIN
  /* Calcula  data/hora de envio da pendência.*/
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

  SP_INTSTR(p_tipOpe,'9'           , l_tipOpe OUT);
  SP_INTSTR(p_tipVis,'999'         , l_tipVis OUT);
  SP_INTSTR(p_tipPes,'9'           , l_tipPesStr OUT);
  IF (l_tipPesStr <> '2') THEN
      l_tipPesStr := '1';
  END IF;  
  SP_INTSTR(p_codPrm,'99999'       , l_codPrmStr OUT);  
  SP_INTSTR(p_ctrCre,'9'           , l_ctrCreStr OUT);
  SP_INTSTR(p_graCon,'999'         , l_graConStr OUT);
  SP_INTSTR(p_horvis,'HHMM',l_horvisstr OUT);
  SP_INTSTR(p_horlim,'HHMM',l_horlimstr OUT);
  l_desVis := RTrim(LTrim(p_desVis));
  l_TamVis := LENGTH(l_desVis);
  SP_INTSTR(l_TamVis,'99',l_TamVisStr OUT);
  l_conRea := p_conRea;
  l_bloAut := p_bloAut;
  l_gerCre := p_gerCre;
  l_ctrAdp := p_ctrAdp; 
  l_ctrBio := p_ctrBio;
  l_usaTAA := p_usaTAA;
  l_usaRfa := p_usaRfa;
  SP_INTSTR(p_EnvAge,'9'           , l_EnvAgeStr OUT);
  SP_INTSTR(p_EnvChe,'9'           , l_EnvCheStr OUT);
  SP_SIMNAO_INT(l_conRea OUT);
  SP_SIMNAO_INT(l_bloAut OUT); 
  SP_SIMNAO_INT(l_gerCre OUT); 
  SP_SIMNAO_INT(l_ctrAdp OUT);
  SP_SIMNAO_INT(l_usaTAA OUT);
  SP_SIMNAO_INT(l_usaRfa OUT);
  
  IF (p_ctrBio = '1') THEN 
    l_ctrBio := '0';
  ELSIF (p_ctrBio = '2') THEN 
    l_ctrBio := '1';
  ELSIF (p_ctrBio = '3') THEN 
    l_ctrBio := '2';
  ELSE
    l_ctrBio := p_ctrBio; 
  END IF;
  
  IF (l_TamVis IS NULL) OR (l_TamVis = 0) THEN
    l_valstr := '85' || l_datenv || l_tipOpe || l_tipVis || '00'; 
  ELSE
    l_valstr := '85' || l_datenv || l_tipOpe || l_tipVis || l_TamVisStr || l_desVis;
  END IF;
  
  l_valstr := l_valstr || l_codPrmStr || l_bloAut || l_tipPesStr || l_gerCre || l_ctrCreStr || l_ctrAdp;
  l_valstr := l_valstr || l_ctrBio;
  l_valstr := l_valstr || l_graConStr || l_horvisstr || l_horlimstr || l_conRea;
  l_valstr := l_valstr || l_usaTAA;
  l_valstr := l_valstr || l_EnvAgeStr;
  l_valstr := l_valstr || l_EnvCheStr;
  l_valstr := l_valstr || l_usaRfa;
  
  BEGIN
    SP_PORCOM(l_valstr, '0');
  EXCEPTION
    WHEN OTHERS THEN RAISERROR 103 'SP_PEND85: Erro ao gerar pendência 85.';
  END;
END		SENIOR;220SP_DATSTR
