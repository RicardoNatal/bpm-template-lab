		  l_UtiCPF := 'S';
		  l_UtiCNH := 'S';
		  l_UtiPas := 'S';
		  l_UtiOut := 'S';
		  l_UtiSDO := 'S';
		  l_UtiREs := 'S';
  END;

  l_PerAgv := p_PerAgv;
