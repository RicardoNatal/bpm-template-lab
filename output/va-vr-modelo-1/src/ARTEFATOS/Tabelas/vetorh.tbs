END␀YÜ␀␀		SENIOR;0î␀␀TRIGGER R088CON_ED AFTER DELETE ON R088CON FOR EACH ROW

DECLARE
l_online BOOLEAN;
BEGIN
	SP_VERONLINE(l_online OUT);
	/*SOMENTE VERSÃO ONLINE*/
	IF (l_online = TRUE) THEN
		BEGIN
			/*Gera pendência para SDK - UPDATEVehicleWithPerson*/
			SP_PEND75('D', :OLD.IDTPES, :OLD.TECCRA, :OLD.NUMFIS, :OLD.PLAVEI, :OLD.CRAVEI, :OLD.DATVAL, :OLD.SITCRA,:OLD.CONLPR,:OLD.VEIFRO);
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'R088CON: Erro ao deletar controle.';
