ı␀␀PROCEDURE SP_CONCAT_DAT_JSON(P_CAMPO VARCHAR2(6), P_VALOR_NEW DATE, P_VALOR_OLD DATE, P_RETORNO IN OUT VARCHAR2(5000))
 IS


  l_ValorVARCHAR_NEW VARCHAR2(2000);
  l_ValorVARCHAR_OLD VARCHAR2(2000);
  l_NewDate DATE;
  l_OldDate DATE; 
BEGIN
  l_NewDate := P_VALOR_NEW;
  l_OldDate := P_VALOR_OLD;	
  
  IF (l_NewDate IS NULL) THEN
	l_NewDate := DATETIME(31, 12, 1900, 0, 0, 0);   	
  END IF;
  
  IF (l_OldDate IS NULL) THEN
	l_OldDate := DATETIME(31, 12, 1900, 0, 0, 0);   	
  END IF;
  
  SP_DATSTR(l_NewDate, 'DDMMYYYY', l_ValorVARCHAR_NEW OUT);
  l_ValorVARCHAR_NEW := SUBSTRING(l_ValorVARCHAR_NEW, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR_NEW, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR_NEW, 5, 4);
  
  SP_DATSTR(l_OldDate, 'DDMMYYYY', l_ValorVARCHAR_OLD OUT);
  l_ValorVARCHAR_OLD := SUBSTRING(l_ValorVARCHAR_OLD, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR_OLD, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR_OLD, 5, 4);
  
  SP_CONCAT_DES_JSON(P_CAMPO, l_ValorVARCHAR_NEW, l_ValorVARCHAR_OLD, P_RETORNO OUT);
  RETURN;
END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
