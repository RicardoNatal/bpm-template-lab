TRIGGER R347BER_EU AFTER UPDATE ON R347BER FOR EACH ROW DECLARE
	l_Valor VARCHAR2(2000);
	l_Alterou BOOLEAN;
	l_AlterouChave BOOLEAN;
	l_Valido BOOLEAN;
	l_Incluir BOOLEAN;
	l_Excluir BOOLEAN;
	l_InfoFacult BOOLEAN;
	l_SimplificaoESocial BOOLEAN;
	l_VersaoESocial NUMBER;
BEGIN
	l_Valor := '';
	l_Valido := FALSE;
	l_Alterou := FALSE;
	l_AlterouChave := FALSE;
	l_Incluir := FALSE;
    l_Excluir := FALSE;	
	l_InfoFacult := TRUE;
	l_SimplificaoESocial := FALSE;
	
	SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT );

	IF (l_SimplificaoESocial = TRUE) THEN
			
		SP_VALUPDATE_DAT(:OLD.DatRea, :NEW.DatRea, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;		

		SP_VALUPDATE_DAT(:OLD.DatEfe, :NEW.DatEfe, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;
		
		SP_VALUPDATE_NUM(:OLD.NumEmp, :NEW.NumEmp, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_AlterouChave := TRUE;
		END IF;
		
		SP_VALUPDATE_NUM(:OLD.TipCol, :NEW.TipCol, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_AlterouChave := TRUE;
		END IF;
		
		SP_VALUPDATE_NUM(:OLD.NumCad, :NEW.NumCad, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_AlterouChave := TRUE;
		END IF;
		
		IF (l_Alterou = TRUE) OR (l_AlterouChave = TRUE) THEN
			SP_CONCATENAR_DES('NROBEN', :NEW.NroBen, l_Valor OUT);
			SP_CONCATENAR_NUM('SEQBEN', :NEW.SeqBer, l_Valor OUT);
			SP_CONCATENAR_NUM('TPREBN', 5, l_Valor OUT);
		
			SP_E_SOCIAL('S-2418', 'R347BER', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DatRea, 0, 'R347BER_EU');
		END IF;
		
		IF (l_AlterouChave = TRUE) THEN
			l_Valor := '';
			SP_CONCATENAR_DES('LAYOUT', 'S-2418', l_Valor OUT);
			SP_CONCATENAR_DES('NROBEN', :OLD.NroBen, l_Valor OUT);
			SP_CONCATENAR_NUM('SEQBEN', :OLD.SeqBer, l_Valor OUT);
			SP_CONCATENAR_NUM('TPREBN', 5, l_Valor OUT);
			
		    SP_E_SOCIAL('S-3000', 'R347BER', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0, NULL, :OLD.DatRea, 0, 'R347BER_EU');
		END IF;
	END IF;
