îc␀␀CREATE OR REPLACE PROCEDURE SP_MATGRP(p_numcra IN NUMBER,p_tippes IN INTEGER,p_numemp IN NUMBER,p_tipcol IN INTEGER,p_numcad IN NUMBER,p_tipdoc IN INTEGER,p_numdoc IN VARCHAR2,p_nummat IN VARCHAR2) IS
  l_icard CHAR(12);
  l_data_zero DATE;
  l_data_atual DATE;
  l_hora_atual NUMBER(4);
  l_grupo CHAR(3);
  l_grupo_5 CHAR(5);
  l_datini CHAR(8);
  l_datfim CHAR(8);
  l_horini CHAR(4);
  l_horfim CHAR(4);
  l_inigrp Date;
  l_fimgrp Date;
  l_matgrp CHAR(1);
  l_numbar NUMBER(12);
  l_numpro NUMBER(12);
  l_numsma NUMBER(12);
  l_crapri NUMBER(12);
  l_tecpri NUMBER(1);
  l_chcpri NUMBER(12);
  l_comando CHAR(2048);
  l_ediprm CHAR(5);
  l_newprm BOOLEAN;
  l_compila CHAR(1);
  l_craprov NUMBER(12);
  l_numbarprov NUMBER(12);
  l_numproprov NUMBER(12);
  l_numsmaprov NUMBER(12);
  l_crapriprov NUMBER(12);
  l_tecpriprov NUMBER(1);
  l_dat_conv VARCHAR(25);
  l_icardA CHAR(12);
  l_icardR CHAR(12);
  l_numser VARCHAR(12);
  l_idtpes CHAR(23);
  l_usutel VARCHAR2(31);

  cursor c_r070PEC is
    SELECT
      R070PEC.CODPRM CODPRM,R070PEC.DATINI DATINI,R070PEC.HORINI HORINI,R070PEC.DATFIM DATFIM,R070PEC.HORFIM HORFIM
       FROM R070PEC R070PEC
       WHERE R070PEC.NUMEMP=p_numemp
      AND R070PEC.TIPCOL=p_tipcol
      AND R070PEC.NUMCAD=p_numcad
      AND (R070PEC.DATFIM=l_data_zero
      OR R070PEC.DATFIM>l_data_atual
      OR (R070PEC.DATFIM=l_data_atual
      AND R070PEC.HORFIM>l_hora_atual))
      AND (R070PEC.DATINI<l_data_atual
      OR (R070PEC.DATINI=l_data_atual
      AND R070PEC.HORINI<l_hora_atual))
       ORDER BY 2 ASC,3 ASC;
  c_r070PEC_cnt integer;
  type t_r070PEC is record (
    CODPRM R070PEC.CODPRM%TYPE,
    DATINI R070PEC.DATINI%TYPE,
    HORINI R070PEC.HORINI%TYPE,
    DATFIM R070PEC.DATFIM%TYPE,
    HORFIM R070PEC.HORFIM%TYPE
  );
  l_r070PEC t_r070PEC;
  cursor c_r070PEV is
    SELECT
      R070PEV.CODPRM CODPRM,R070PEV.DATINI DATINI,R070PEV.HORINI HORINI,R070PEV.DATFIM DATFIM,R070PEV.HORFIM HORFIM
       FROM R070PEV R070PEV
       WHERE R070PEV.TIPDOC=p_tipdoc
      AND R070PEV.NUMDOC=p_numdoc
      AND (R070PEV.DATFIM=l_data_zero
      OR R070PEV.DATFIM>l_data_atual
      OR (R070PEV.DATFIM=l_data_atual
      AND R070PEV.HORFIM>l_hora_atual))
      AND (R070PEV.DATINI<l_data_atual
      OR (R070PEV.DATINI=l_data_atual
      AND R070PEV.HORINI<l_hora_atual))
       ORDER BY 2 ASC,3 ASC;
  c_r070PEV_cnt integer;
  type t_r070PEV is record (
    CODPRM R070PEV.CODPRM%TYPE,
    DATINI R070PEV.DATINI%TYPE,
    HORINI R070PEV.HORINI%TYPE,
    DATFIM R070PEV.DATFIM%TYPE,
    HORFIM R070PEV.HORFIM%TYPE
  );
  l_r070PEV t_r070PEV;
  cursor c_r070PEO is
    SELECT
      R070PEO.CODPRM CODPRM,R070PEO.DATINI DATINI,R070PEO.HORINI HORINI,R070PEO.DATFIM DATFIM,R070PEO.HORFIM HORFIM
       FROM R070PEO R070PEO
       WHERE R070PEO.NUMEMP=p_numemp
      AND R070PEO.NUMCAD=p_numcad
      AND (R070PEO.DATFIM=l_data_zero
      OR R070PEO.DATFIM>l_data_atual
      OR (R070PEO.DATFIM=l_data_atual
      AND R070PEO.HORFIM>l_hora_atual))
      AND (R070PEO.DATINI<l_data_atual
      OR (R070PEO.DATINI=l_data_atual
      AND R070PEO.HORINI<l_hora_atual))
       ORDER BY 2 ASC,3 ASC;
  c_r070PEO_cnt integer;
  type t_r070PEO is record (
    CODPRM R070PEO.CODPRM%TYPE,
    DATINI R070PEO.DATINI%TYPE,
    HORINI R070PEO.HORINI%TYPE,
    DATFIM R070PEO.DATFIM%TYPE,
    HORFIM R070PEO.HORFIM%TYPE
  );
  l_r070PEO t_r070PEO;
  cursor c_r070PEA is
    SELECT
      R070PEA.CODPRM CODPRM,R070PEA.DATINI DATINI,R070PEA.HORINI HORINI,R070PEA.DATFIM DATFIM,R070PEA.HORFIM HORFIM
       FROM R070PEA R070PEA
       WHERE R070PEA.NUMMAT=p_nummat
      AND (R070PEA.DATFIM=l_data_zero
      OR R070PEA.DATFIM>l_data_atual
      OR (R070PEA.DATFIM=l_data_atual
      AND R070PEA.HORFIM>l_hora_atual))
       ORDER BY 2 ASC,3 ASC;
  c_r070PEA_cnt integer;
  type t_r070PEA is record (
    CODPRM R070PEA.CODPRM%TYPE,
    DATINI R070PEA.DATINI%TYPE,
    HORINI R070PEA.HORINI%TYPE,
    DATFIM R070PEA.DATFIM%TYPE,
    HORFIM R070PEA.HORFIM%TYPE
  );
  l_r070PEA t_r070PEA;
begin
  SP_RETIDTPES(p_numemp, p_tipcol, p_numcad, NULL, NULL, NULL, NULL, l_idtpes);

  /* TSI */
  SP_USUTEL(l_usutel);

  l_data_atual := TO_DATE(TO_CHAR(SYSDATE,'DD/MM/YYYY'),'DD/MM/YYYY');
  l_hora_atual := TO_NUMBER(TO_CHAR(TO_DATE(TO_CHAR(SYSDATE,'HH24:MI:SS'),'HH24:MI:SS'),'HH24'))*60+TO_NUMBER(TO_CHAR(TO_DATE(TO_CHAR(SYSDATE,'HH24:MI:SS'),'HH24:MI:SS'),'MI'));
  l_data_zero :=  TO_DATE('31/12/1900,00:00:00','DD/MM/YYYY,HH24:MI:SS');
  begin
    SELECT
      R070TSI.MATGRP MATGRP
       INTO l_matgrp
       FROM R070TSI R070TSI;
  exception
    when OTHERS then
      l_matgrp := 'N';
  end;
  begin
    SELECT
      R000ASS.EDIPRM EDIPRM
       INTO l_ediprm
       FROM R000ASS R000ASS;
    if (l_ediprm='99999') then
      l_newprm := TRUE;
    else
      l_newprm := FALSE;
    end if;
  exception
    when OTHERS then
      raise_application_error(-20000 + -(103),'SP_MATGRP: Não conseguiu obter a máscara da permissão R000ASS.EDIPRM.');
  end;
  if (l_matgrp='S') then
    SP_MAPFIS(p_numcra,l_numbar,l_numpro,l_numsma,l_tecpri,l_crapri);
    l_comando := 'DELETE FROM ' || l_usutel || 'MATGRUPO WHERE ICARD = :1';
    if ((l_crapri=0) OR (l_tecpri=3)) then
      SP_RETICARD(l_idtpes, p_numcra, l_icardA, l_icardR, l_numser);
      EXECUTE IMMEDIATE l_comando USING l_icardA;
    else
      if (l_numpro<>0) then
        SP_INTSTR(l_numpro,'999999999999',l_icard);
        EXECUTE IMMEDIATE l_comando USING l_icard;
      end if;
      if (l_numbar<>0) then
        SP_INTSTR(l_numbar,'999999999999',l_icard);
              EXECUTE IMMEDIATE l_comando USING l_icard;
      end if;
    end if;
    SP_RETCRA(2,p_numemp,p_tipcol,p_numcad,0,0,0,'',l_craprov);
    if (l_craprov<>0) then
      SP_MAPFIS(l_craprov,l_numbarprov,l_numproprov,l_numsmaprov,l_tecpriprov,l_crapriprov);
      l_comando := 'DELETE FROM ' || l_usutel || 'MATGRUPO WHERE ICARD = :1';
      if ((l_crapriprov=0) OR (l_tecpriprov=3)) then
        SP_RETICARD(l_idtpes, l_craprov, l_icardA, l_icardR, l_numser);
        EXECUTE IMMEDIATE l_comando USING l_icardA;
      else
        if (l_numproprov<>0) then
          SP_INTSTR(l_numproprov,'999999999999',l_icard);
                EXECUTE IMMEDIATE l_comando USING l_icard;
        end if;
        if (l_numbarprov<>0) then
          SP_INTSTR(l_numbarprov,'999999999999',l_icard);
                EXECUTE IMMEDIATE l_comando USING l_icard;
        end if;
      end if;
    end if;
    if (p_tippes<4) then
      open c_r070PEC;
      begin
        fetch c_r070PEC into l_r070pec.CODPRM,l_r070pec.DATINI,l_r070pec.HORINI,l_r070pec.DATFIM,l_r070pec.HORFIM;
        while (c_r070PEC%FOUND)
        loop
          SP_DATSTR(l_r070PEC.DATINI,'DDMMYYYY',l_datini);
          if (l_r070PEC.DATFIM<>l_data_zero) then
            SP_DATSTR(l_r070PEC.DATFIM,'DDMMYYYY',l_datfim);
          else
            l_datfim := '31122050';
          end if;
          SP_INTSTR(l_r070PEC.HORINI,'HHMM',l_horini);
          SP_INTSTR(l_r070PEC.HORFIM,'HHMM',l_horfim);
          if (l_newprm=true) then
            SP_INTSTR(l_r070PEC.CODPRM,'99999',l_grupo_5);
          else
            SP_INTSTR(l_r070PEC.CODPRM,'999',l_grupo);
          end if;
          l_dat_conv := SUBSTR(l_datini,1,2)||'/'||SUBSTR(l_datini,3,2)||'/'||SUBSTR(l_datini,5,4)||','||SUBSTR(l_horini,1,2)||':'||SUBSTR(l_horini,3,2);
          SP_STRTODATE(l_dat_conv,'DD/MM/AAAA,HH:MI',l_inigrp);
          l_dat_conv := SUBSTR(l_datfim,1,2)||'/'||SUBSTR(l_datfim,3,2)||'/'||SUBSTR(l_datfim,5,4)||','||SUBSTR(l_horfim,1,2)||':'||SUBSTR(l_horfim,3,2);
          SP_STRTODATE(l_dat_conv,'DD/MM/AAAA,HH:MI',l_fimgrp);
          begin
            l_comando := 'INSERT INTO ' || l_usutel || 'MATGRUPO (ICARD, GRUPO, DATINI, DATFIM) VALUES (:1,:2,:3,:4)';
            if ((l_crapri=0) OR (l_tecpri=3)) then
              SP_RETICARD(l_idtpes, p_numcra, l_icardA, l_icardR, l_numser);
              if (l_newprm=true) then
                l_compila := 'A';
                EXECUTE IMMEDIATE l_comando USING l_icardA,l_grupo_5,l_inigrp,l_fimgrp;
              else
                l_compila := 'A';
                EXECUTE IMMEDIATE l_comando USING l_icardA,l_grupo,l_inigrp,l_fimgrp;
              end if;
            else
              if (l_numpro<>0) then
                SP_INTSTR(l_numpro,'999999999999',l_icard);
                if (l_newprm=true) then
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo_5,l_inigrp,l_fimgrp;
                else
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo,l_inigrp,l_fimgrp;
                end if;
              end if;
              if (l_numbar<>0) then
                SP_INTSTR(l_numbar,'999999999999',l_icard);
                if (l_newprm=true) then
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo_5,l_inigrp,l_fimgrp;
                else
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo,l_inigrp,l_fimgrp;
                end if;
              end if;
            end if;
          exception
            when OTHERS then
              raise_application_error(-20000 + -(103),'SP_MATGRP: ON-Line: Problemas ao inserir a permissão do crachá de colaborador.'||SQLERRM);
          end;
          begin
            if (l_craprov<>0 AND l_craprov<>p_numcra) then
              l_comando := 'INSERT INTO ' || l_usutel || 'MATGRUPO (ICARD, GRUPO, DATINI, DATFIM) VALUES (:1,:2,:3,:4)';
              if ((l_crapriprov=0) OR (l_tecpriprov=3)) then
                SP_RETICARD(l_idtpes, l_craprov, l_icardA, l_icardR, l_numser);
                if (l_newprm=true) then
                  l_compila := 'A';
                            EXECUTE IMMEDIATE l_comando USING l_icardA,l_grupo_5,l_inigrp,l_fimgrp;
                else
                  l_compila := 'A';
                            EXECUTE IMMEDIATE l_comando USING l_icardA,l_grupo,l_inigrp,l_fimgrp;
                end if;
              else
                if (l_numproprov<>0) then
                  SP_INTSTR(l_numproprov,'999999999999',l_icard);
                  if (l_newprm=true) then
                    l_compila := 'A';
                                EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo_5,l_inigrp,l_fimgrp;
                  else
                    l_compila := 'A';
                                EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo,l_inigrp,l_fimgrp;
                  end if;
                end if;
                if (l_numbarprov<>0) then
                  SP_INTSTR(l_numbarprov,'999999999999',l_icard);
                  if (l_newprm=true) then
                    l_compila := 'A';
                                EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo_5,l_inigrp,l_fimgrp;
                  else
                    l_compila := 'A';
                                EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo,l_inigrp,l_fimgrp;
                  end if;
                end if;
              end if;
            end if;
          exception
            when OTHERS then
              raise_application_error(-20000 + -(103),'SP_MATGRP: ON-Line: Problemas ao inserir a permissão do crachá provisório de colaborador.'||SQLERRM);
          end;
          fetch c_r070PEC into l_r070pec.CODPRM,l_r070pec.DATINI,l_r070pec.HORINI,l_r070pec.DATFIM,l_r070pec.HORFIM;
        end loop;
      exception when others then
        close c_r070PEC;
        raise;
      end;
      close c_r070PEC;
    elsif (p_tippes=4) then
      open c_r070PEV;
      begin
        fetch c_r070PEV into l_r070pev.CODPRM,l_r070pev.DATINI,l_r070pev.HORINI,l_r070pev.DATFIM,l_r070pev.HORFIM;
        while (c_r070PEV%FOUND)
        loop
          SP_DATSTR(l_r070PEV.DATINI,'DDMMYYYY',l_datini);
          if (l_r070PEV.DATFIM<>l_data_zero) then
            SP_DATSTR(l_r070PEV.DATFIM,'DDMMYYYY',l_datfim);
          else
            l_datfim := '31122050';
          end if;
          SP_INTSTR(l_r070PEV.HORINI,'HHMM',l_horini);
          SP_INTSTR(l_r070PEV.HORFIM,'HHMM',l_horfim);
          if (l_newprm=true) then
            SP_INTSTR(l_r070PEV.CODPRM,'99999',l_grupo_5);
          else
            SP_INTSTR(l_r070PEV.CODPRM,'999',l_grupo);
          end if;
          l_dat_conv := SUBSTR(l_datini,1,2)||'/'||SUBSTR(l_datini,3,2)||'/'||SUBSTR(l_datini,5,4)||','||SUBSTR(l_horini,1,2)||':'||SUBSTR(l_horini,3,2);
          SP_STRTODATE(l_dat_conv,'DD/MM/AAAA,HH:MI',l_inigrp);
          l_dat_conv := SUBSTR(l_datfim,1,2)||'/'||SUBSTR(l_datfim,3,2)||'/'||SUBSTR(l_datfim,5,4)||','||SUBSTR(l_horfim,1,2)||':'||SUBSTR(l_horfim,3,2);
          SP_STRTODATE(l_dat_conv,'DD/MM/AAAA,HH:MI',l_fimgrp);
          begin
            l_comando := 'INSERT INTO ' || l_usutel || 'MATGRUPO (ICARD, GRUPO, DATINI, DATFIM) VALUES (:1,:2,:3,:4)';
            if ((l_crapri=0) OR (l_tecpri=3)) then
              SP_RETICARD(l_idtpes, p_numcra, l_icardA, l_icardR, l_numser);
              if (l_newprm=true) then
                l_compila := 'A';
                EXECUTE IMMEDIATE l_comando USING l_icardA,l_grupo_5,l_inigrp,l_fimgrp;
              else
                l_compila := 'A';
                EXECUTE IMMEDIATE l_comando USING l_icardA,l_grupo,l_inigrp,l_fimgrp;
              end if;
            else
              if (l_numpro<>0) then
                SP_INTSTR(l_numpro,'999999999999',l_icard);
                if (l_newprm=true) then
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo_5,l_inigrp,l_fimgrp;
                else
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo,l_inigrp,l_fimgrp;
                end if;
              end if;
              if (l_numbar<>0) then
                SP_INTSTR(l_numbar,'999999999999',l_icard);
                if (l_newprm=true) then
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo_5,l_inigrp,l_fimgrp;
                else
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo,l_inigrp,l_fimgrp;
                end if;
              end if;
            end if;
          exception
            when OTHERS then
              raise_application_error(-20000 + -(103),'SP_MATGRP: ON-Line: Problemas ao inserir a permissão.'||SQLERRM);
          end;
          fetch c_r070PEV into l_r070pev.CODPRM,l_r070pev.DATINI,l_r070pev.HORINI,l_r070pev.DATFIM,l_r070pev.HORFIM;
        end loop;
      exception when others then
        close c_r070PEV;
        raise;
      end;
      close c_r070PEV;
    elsif (p_tippes=5) then
      open c_r070PEO;
      begin
        fetch c_r070PEO into l_r070peo.CODPRM,l_r070peo.DATINI,l_r070peo.HORINI,l_r070peo.DATFIM,l_r070peo.HORFIM;
        while (c_r070PEO%FOUND)
        loop
          SP_DATSTR(l_r070PEO.DATINI,'DDMMYYYY',l_datini);
          if l_r070PEO.DATFIM<>l_data_zero then
            SP_DATSTR(l_r070PEO.DATFIM,'DDMMYYYY',l_datfim);
          else
            l_datfim := '31122050';
          end if;
          SP_INTSTR(l_r070PEO.HORINI,'HHMM',l_horini);
          SP_INTSTR(l_r070PEO.HORFIM,'HHMM',l_horfim);
          if (l_newprm=true) then
            SP_INTSTR(l_r070PEO.CODPRM,'99999',l_grupo_5);
          else
            SP_INTSTR(l_r070PEO.CODPRM,'999',l_grupo);
          end if;
          l_dat_conv := SUBSTR(l_datini,1,2)||'/'||SUBSTR(l_datini,3,2)||'/'||SUBSTR(l_datini,5,4)||','||SUBSTR(l_horini,1,2)||':'||SUBSTR(l_horini,3,2);
          SP_STRTODATE(l_dat_conv,'DD/MM/AAAA,HH:MI',l_inigrp);
          l_dat_conv := SUBSTR(l_datfim,1,2)||'/'||SUBSTR(l_datfim,3,2)||'/'||SUBSTR(l_datfim,5,4)||','||SUBSTR(l_horfim,1,2)||':'||SUBSTR(l_horfim,3,2);
          SP_STRTODATE(l_dat_conv,'DD/MM/AAAA,HH:MI',l_fimgrp);
          begin
            l_comando := 'INSERT INTO ' || l_usutel || 'MATGRUPO (ICARD, GRUPO, DATINI, DATFIM) VALUES (:1,:2,:3,:4)';
            if ((l_crapri=0) OR (l_tecpri=3)) then
              SP_RETICARD(l_idtpes, p_numcra, l_icardA, l_icardR, l_numser);
              if (l_newprm=true) then
                l_compila := 'A';
                EXECUTE IMMEDIATE l_comando USING l_icardA,l_grupo_5,l_inigrp,l_fimgrp;
              else
                l_compila := 'A';
                EXECUTE IMMEDIATE l_comando USING l_icardA,l_grupo,l_inigrp,l_fimgrp;
              end if;
            else
              if (l_numpro<>0) then
                SP_INTSTR(l_numpro,'999999999999',l_icard);
                if (l_newprm=true) then
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo_5,l_inigrp,l_fimgrp;
                else
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo,l_inigrp,l_fimgrp;
                end if;
              end if;
              if (l_numbar<>0) then
                SP_INTSTR(l_numbar,'999999999999',l_icard);
                if (l_newprm=true) then
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo_5,l_inigrp,l_fimgrp;
                else
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo,l_inigrp,l_fimgrp;
                end if;
              end if;
            end if;
          exception
            when OTHERS then
              raise_application_error(-20000 + -(103),'SP_MATGRP: ON-Line: Problemas ao inserir a permissão do crachá de outra unidade.'||SQLERRM);
          end;
          begin
            if (l_craprov<>0 AND l_craprov<>p_numcra) then
              l_comando := 'INSERT INTO ' || l_usutel || 'MATGRUPO (ICARD, GRUPO, DATINI, DATFIM) VALUES (:1,:2,:3,:4)';
              if ((l_crapriprov=0) OR (l_tecpriprov=3)) then
                SP_RETICARD(l_idtpes, l_craprov, l_icardA, l_icardR, l_numser);
                if (l_newprm=true) then
                  l_compila := 'A';
                          EXECUTE IMMEDIATE l_comando USING l_icardA,l_grupo_5,l_inigrp,l_fimgrp;
                else
                  l_compila := 'A';
                          EXECUTE IMMEDIATE l_comando USING l_icardA,l_grupo,l_inigrp,l_fimgrp;
                end if;
              else
                if (l_numproprov<>0) then
                  SP_INTSTR(l_numproprov,'999999999999',l_icard);
                  if (l_newprm=true) then
                    l_compila := 'A';
                              EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo_5,l_inigrp,l_fimgrp;
                  else
                    l_compila := 'A';
                              EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo,l_inigrp,l_fimgrp;
                  end if;
                end if;
                if (l_numbarprov<>0) then
                  SP_INTSTR(l_numbarprov,'999999999999',l_icard);
                  if (l_newprm=true) then
                    l_compila := 'A';
                              EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo_5,l_inigrp,l_fimgrp;
                  else
                    l_compila := 'A';
                              EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo,l_inigrp,l_fimgrp;
                  end if;
                end if;
              end if;
            end if;
          exception
            when OTHERS then
              raise_application_error(-20000 + -(103),'SP_MATGRP: ON-Line: Problemas ao inserir a permissão do crachá provisório de outra unidade.'||SQLERRM);
          end;
          fetch c_r070PEO into l_r070peo.CODPRM,l_r070peo.DATINI,l_r070peo.HORINI,l_r070peo.DATFIM,l_r070peo.HORFIM;
        end loop;
      exception when others then
        close c_r070PEO;
        raise;
      end;
      close c_r070PEO;
    elsif (p_tippes=6) then
      open c_r070PEA;
      begin
        fetch c_r070PEA into l_r070pea.CODPRM,l_r070pea.DATINI,l_r070pea.HORINI,l_r070pea.DATFIM,l_r070pea.HORFIM;
        while (c_r070PEA%FOUND)
        loop
          SP_DATSTR(l_r070PEA.DATINI,'DDMMYYYY',l_datini);
          if l_r070PEA.DATFIM<>l_data_zero then
            SP_DATSTR(l_r070PEA.DATFIM,'DDMMYYYY',l_datfim);
          else
            l_datfim := '31122050';
          end if;
          SP_INTSTR(l_r070PEA.HORINI,'HHMM',l_horini);
          SP_INTSTR(l_r070PEA.HORFIM,'HHMM',l_horfim);
          if (l_newprm=true) then
            SP_INTSTR(l_r070PEA.CODPRM,'99999',l_grupo_5);
          else
            SP_INTSTR(l_r070PEA.CODPRM,'999',l_grupo);
          end if;
          l_dat_conv := SUBSTR(l_datini,1,2)||'/'||SUBSTR(l_datini,3,2)||'/'||SUBSTR(l_datini,5,4)||','||SUBSTR(l_horini,1,2)||':'||SUBSTR(l_horini,3,2);
          SP_STRTODATE(l_dat_conv,'DD/MM/AAAA,HH:MI',l_inigrp);
          l_dat_conv := SUBSTR(l_datfim,1,2)||'/'||SUBSTR(l_datfim,3,2)||'/'||SUBSTR(l_datfim,5,4)||','||SUBSTR(l_horfim,1,2)||':'||SUBSTR(l_horfim,3,2);
          SP_STRTODATE(l_dat_conv,'DD/MM/AAAA,HH:MI',l_fimgrp);
          begin
            l_comando := 'INSERT INTO ' || l_usutel || 'MATGRUPO (ICARD, GRUPO, DATINI, DATFIM) VALUES (:1,:2,:3,:4)';
            if ((l_crapri=0) OR (l_tecpri=3)) then
              SP_RETICARD(l_idtpes, p_numcra, l_icardA, l_icardR, l_numser);
              if (l_newprm=true) then
                l_compila := 'A';
                EXECUTE IMMEDIATE l_comando USING l_icardA,l_grupo_5,l_inigrp,l_fimgrp;
              else
                l_compila := 'A';
                EXECUTE IMMEDIATE l_comando USING l_icardA,l_grupo,l_inigrp,l_fimgrp;
              end if;
            else
              if (l_numpro<>0) then
                SP_INTSTR(l_numpro,'999999999999',l_icard);
                if (l_newprm=true) then
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo_5,l_inigrp,l_fimgrp;
                else
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo,l_inigrp,l_fimgrp;
                end if;
              end if;
              if (l_numbar<>0) then
                SP_INTSTR(l_numbar,'999999999999',l_icard);
                if (l_newprm=true) then
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo_5,l_inigrp,l_fimgrp;
                else
                  l_compila := 'A';
                  EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo,l_inigrp,l_fimgrp;
                end if;
              end if;
            end if;
          exception
            when OTHERS then
              raise_application_error(-20000 + -(103),'SP_MATGRP: ON-Line: Problemas ao inserir a permissão do crachá de aluno.'||SQLERRM);
          end;
          begin
            if (l_craprov<>0
      AND l_craprov<>p_numcra) then
              l_comando := 'INSERT INTO ' || l_usutel || 'MATGRUPO (ICARD, GRUPO, DATINI, DATFIM) VALUES (:1,:2,:3,:4)';
              if ((l_crapriprov=0) OR (l_tecpriprov=3)) then
                SP_RETICARD(l_idtpes, l_craprov, l_icardA, l_icardR, l_numser);
                if (l_newprm=true) then
                  l_compila := 'A';
                          EXECUTE IMMEDIATE l_comando USING l_icardA,l_grupo_5,l_inigrp,l_fimgrp;
                else
                  l_compila := 'A';
                          EXECUTE IMMEDIATE l_comando USING l_icardA,l_grupo,l_inigrp,l_fimgrp;
                end if;
              else
                if (l_numproprov<>0) then
                  SP_INTSTR(l_numproprov,'999999999999',l_icard);
                  if (l_newprm=true) then
                    l_compila := 'A';
                              EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo_5,l_inigrp,l_fimgrp;
                  else
                    l_compila := 'A';
                              EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo,l_inigrp,l_fimgrp;
                  end if;
                end if;
                if (l_numbarprov<>0) then
                  SP_INTSTR(l_numbarprov,'999999999999',l_icard);
                  if (l_newprm=true) then
                    l_compila := 'A';
                              EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo_5,l_inigrp,l_fimgrp;
                  else
                    l_compila := 'A';
                              EXECUTE IMMEDIATE l_comando USING l_icard,l_grupo,l_inigrp,l_fimgrp;
                  end if;
                end if;
              end if;
            end if;
          exception
            when OTHERS then
              raise_application_error(-20000 + -(103),'SP_MATGRP: ON-Line: Problemas ao inserir a permissão do crachá provisório de aluno.'||SQLERRM);
          end;
          fetch c_r070PEA into l_r070pea.CODPRM,l_r070pea.DATINI,l_r070pea.HORINI,l_r070pea.DATFIM,l_r070pea.HORFIM;
        end loop;
      exception when others then
        close c_r070PEA;
        raise;
      end;
      close c_r070PEA;
    end if;
  end if;
end;
	MSSQL;23<SP_DATSTR
