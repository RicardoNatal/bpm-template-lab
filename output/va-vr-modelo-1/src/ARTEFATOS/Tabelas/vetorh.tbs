      fetch c_r058cen into l_r058cen.dirsvr,l_r058cen.gersen,l_r058cen.cenati,l_r058cen.stacsm, l_r058cen.codcen;
      while (c_r058cen%FOUND)
      loop
        SELECT COUNT(*) 
         INTO temrlg 
         FROM R058RLG R058RLG 
         WHERE CODCEN=l_r058cen.codcen;
        if (l_r058cen.gersen='S') and (l_r058cen.cenati='S') and (l_r058cen.stacsm=1) and (temrlg > 0) then
          begin
            if l_codcmd 
      NOT  IN (11,12,30,31,32,76,91) then
              if (l_codcmd=62) then
                if (l_tipope<>3) then
                  l_CodDsp := SUBSTR(l_straux,19,9);
                  UPDATE R070ADM  SET  STACMD = 7  WHERE IDTPES=l_idtpes 
      AND NUMFIS=l_numfis 
      AND NUMCRA=l_numcra 
      AND STACMD IN (0,1,5,8,9) 
      AND CODCMD = l_CodTraduzido 
      AND DIRSVR=l_r058cen.dirsvr 
      AND CODADM IN (SELECT 
      R070ONL.CODADM CODADM
       FROM R070ONL R070ONL
       WHERE CODDSP=l_CodDsp )  ;
                else
                  l_straux := SUBSTR(p_Straux,1,27)||'0'||SUBSTR(p_Straux,29,LENGTH(p_Straux)-28);
                end if;
              else
                if (l_codcmd=6) then
                  UPDATE R070ADM  SET  STACMD = 7
                  WHERE CODADM IN ( SELECT CODADM FROM R070ADM WHERE
                                    IDTPES=l_idtpes AND STACMD IN (0,1,5,8,9) AND 
                                    CODCMD = l_CodTraduzido AND DIRSVR=l_r058cen.dirsvr AND 
                                    SUBSTR(VALSTR,27,3)=SUBSTR(l_straux,27,3) AND 
                                    SUBSTR(VALSTR,30,7)=SUBSTR(l_straux,30,7)
                                  );
                else
                  if (l_codcmd=78) then
                    UPDATE R070ADM  SET  STACMD = 7  WHERE SUBSTR(VALSTR,4,3)=SUBSTR(l_straux,4,3) 
      AND SUBSTR(VALSTR,7,7)=SUBSTR(l_straux,7,7) 
      AND STACMD IN (0,1,5,8,9) 
      AND CODCMD = l_CodTraduzido 
      AND DIRSVR=l_r058cen.dirsvr  ;
                  else
                    UPDATE R070ADM  SET  STACMD = 7  WHERE IDTPES=l_idtpes 
      AND NUMFIS=l_numfis 
      AND NUMCRA=l_numcra 
      AND STACMD IN (0,1,5,8,9) 
      AND CODCMD = l_CodTraduzido 
      AND DIRSVR=l_r058cen.dirsvr  ;
                  end if;
                end if;
              end if;
            end if;

            SP_RETLOGPEN(l_logpen);
            INSERT INTO R070ADM (CODADM,DATENV,HORENV,DIRSVR,VALSTR,RETPEN,QTDTEN,CICATU,NUMFIS,CODCMD,STACMD,SEQENV,NUMCRA,IDTPES,VERRON,LOGPEN) VALUES (SEQ_R070ADM.nextval,l_datenv,l_horenv,l_r058cen.dirsvr,l_straux,l_retpen,0,0,l_numfis, l_CodTraduzido, l_stacmd,l_seqenv,l_numcra,l_idtpes,NULL,l_logpen);
          exception
            when OTHERS then
              NULL;
              raise_application_error(-20000 + -(103),'SP_PORCOM: Erro na inserção da pendência na R070ADM Insert 1.');
          end;
        end if;
        fetch c_r058cen into l_r058cen.dirsvr,l_r058cen.gersen,l_r058cen.cenati, l_r058cen.stacsm, l_r058cen.codcen;
      end loop;
    exception when others then
      close c_r058cen;
      raise;
    end;
    close c_r058cen;
  else
    loop
      begin
        l_aux := INSTR(l_cenpen,',',1);
        if (l_aux=0) then
          l_codcen := l_cenpen;
          l_cenpen := 'FIM';
        else
          l_codcen := SUBSTR(l_cenpen,1,1);
