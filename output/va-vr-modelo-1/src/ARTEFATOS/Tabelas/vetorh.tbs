DECLARE
l_online  BOOLEAN;
  l_registro_ativo BOOLEAN;
  l_hora_atual     NUMBER(4);
  l_data_atual     DATE;
  l_data_zero      DATE;
  l_datini         CHAR(8);
  l_horini         CHAR(4);
  l_datfim         CHAR(8);
  l_horfim         CHAR(4);
  l_valstr         VARCHAR2(47);
  l_IDTPES         VARCHAR(23);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN
      l_hora_atual  := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_data_atual := CURDATE();
      l_data_zero :=  '31/12/1900,00:00:00';
      l_registro_ativo := FALSE;

      IF  (:NEW.DATFIM = l_data_zero) OR (:NEW.DATFIM > l_data_atual) OR
          ((:NEW.DATFIM = l_data_atual) AND (:NEW.HORFIM >= l_hora_atual)) THEN
        l_registro_ativo := TRUE;
      END IF;

      IF  (l_registro_ativo = TRUE) THEN
        R073HSA_ATUCON (:NEW.NUMMAT,:NEW.CODSTA);
      END IF;
  END IF;
  SP_DATSTR(:NEW.DATINI,'DDMMYYYY',l_datini OUT);
  SP_INTSTR(:NEW.HORINI,'9999',l_horini OUT);
  
  SP_DATSTR(:NEW.DATFIM,'DDMMYYYY',l_datfim OUT);
  SP_INTSTR(:NEW.HORFIM,'9999',l_horfim OUT);
  
  SP_RETIDTPES(NULL, 6, NULL, NULL, NULL, :NEW.NUMMAT, NULL, l_IDTPES OUT);
  l_valstr := l_IDTPES || l_datini || l_horini || l_datfim || l_horfim;  
    
  SP_SAM_PENDENCIES(20, 1, l_valstr);
END␀îÚ␀␀		SENIOR;0¢
␀␀

TRIGGER R073HSA_EU AFTER UPDATE ON R073HSA FOR EACH ROW

DECLARE
l_online BOOLEAN;
  l_registro_ativo BOOLEAN;
  l_hora_atual     NUMBER(4);
  l_data_atual     DATE;
  l_data_zero      DATE;
  l_datini         CHAR(8);
  l_horini         CHAR(4);
  l_datfim         CHAR(8);
  l_horfim         CHAR(4);
  l_valstr         VARCHAR2(47);
  l_IDTPES         VARCHAR2(23);
  l_bloace           R073STA.BLOACE%TYPE;
BEGIN
  /* Quando a situaçao for alterada para Bloqueado, a data fim do papel no SAMSenior deve ser alterada para a data atual */
  BEGIN
    SELECT BloAce INTO l_bloace
      FROM R073STA
      WHERE R073STA.CODSTA = :NEW.CODSTA;
    EXCEPTION 
      WHEN NO_DATA_FOUND THEN
        l_bloace := 'S';
  END;

  /* Verifica se alterou alguma informação relevante ao acesso online */
  IF  (:NEW.CODSTA <> :OLD.CODSTA)  THEN
      l_online := TRUE;

      IF (l_bloace = 'S') THEN
      	 SP_DATSTR(:OLD.DATINI,'DDMMYYYY',l_datini OUT);
  	 	 SP_INTSTR(:OLD.HORINI,'9999',l_horini OUT);
  	 	 
  	 	 l_data_atual := CURDATE();
  	 	 l_hora_atual  := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  	 	 SP_DATSTR(l_data_atual,'DDMMYYYY',l_datfim OUT);
  	 	 SP_INTSTR(l_hora_atual,'9999',l_horfim OUT);
  	 	 
  	 	 SP_RETIDTPES(NULL, 6, NULL, NULL, NULL, :NEW.NUMMAT, NULL, l_IDTPES OUT);
  	 	 l_valstr := l_IDTPES || l_datini || l_horini || l_datfim || l_horfim;
    
  	 	 SP_SAM_PENDENCIES(20, 2, l_valstr);
      END IF;
  END IF;
  IF  (l_online = TRUE) THEN
      SP_VerOnLine(l_online OUT);
      IF  (l_online = TRUE) THEN
          l_hora_atual  := HOUR(CURTIME())*60 + MINUTE(CURTIME());
          l_data_atual := CURDATE();
          l_data_zero :=  '31/12/1900,00:00:00';
          l_registro_ativo := FALSE;

          IF  (:NEW.DATFIM = l_data_zero) OR (:NEW.DATFIM > l_data_atual) OR
              ((:NEW.DATFIM = l_data_atual) AND (:NEW.HORFIM >= l_hora_atual)) THEN
            l_registro_ativo := TRUE;
          END IF;

          IF  (l_registro_ativo = TRUE) THEN
            R073HSA_ATUCON (:NEW.NUMMAT,:NEW.CODSTA);
          END IF;
      END IF;
  END IF;
  
  IF (l_bloace = 'N') AND ((:NEW.DATFIM <> :OLD.DATFIM) OR ((:NEW.DATFIM = :OLD.DATFIM) AND (:NEW.HORFIM <> :OLD.HORFIM))) THEN
  	 SP_DATSTR(:NEW.DATINI,'DDMMYYYY',l_datini OUT);
  	 SP_INTSTR(:NEW.HORINI,'9999',l_horini OUT);
  	 
  	 SP_DATSTR(:NEW.DATFIM,'DDMMYYYY',l_datfim OUT);
  	 SP_INTSTR(:NEW.HORFIM,'9999',l_horfim OUT);
  	 
  	 SP_RETIDTPES(NULL, 6, NULL, NULL, NULL, :NEW.NUMMAT, NULL, l_IDTPES OUT);
  	 l_valstr := l_IDTPES || l_datini || l_horini || l_datfim || l_horfim;
    
  	 SP_SAM_PENDENCIES(20, 2, l_valstr);  	 
  END IF;  
END␀ìÚ␀␀		SENIOR;0¨␀␀

TRIGGER R073HSA_ED AFTER DELETE ON R073HSA FOR EACH ROW

DECLARE
  l_hora_atual     NUMBER(4);
  l_data_atual     DATE;
  l_datini         CHAR(8);
  l_horini         CHAR(4);
  l_datfim         CHAR(8);
  l_horfim         CHAR(4);
  l_valstr         VARCHAR2(47);
  l_IDTPES         VARCHAR2(23);
BEGIN
  /* Caso o histórico de situação seja excluído, da data fim no SAMSenior deve ser alterada para a data atual */
  SP_DATSTR(:OLD.DATINI,'DDMMYYYY',l_datini OUT);
  SP_INTSTR(:OLD.HORINI,'9999',l_horini OUT);
  	 	 
  l_data_atual := CURDATE();
  l_hora_atual  := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_data_atual,'DDMMYYYY',l_datfim OUT);
  SP_INTSTR(l_hora_atual,'9999',l_horfim OUT);
  	 	 
  SP_RETIDTPES(NULL, 6, NULL, NULL, NULL, :OLD.NUMMAT, NULL, l_IDTPES OUT);
  l_valstr := l_IDTPES || l_datini || l_horini || l_datfim || l_horfim;
    
  SP_SAM_PENDENCIES(20, 2, l_valstr);
END␀␀␀şv␀␀␀␀␀␀␀ïÚ␀␀N␀	„␀␀␀␀␀¢␀/␀0␀n␀Æÿ␀␀÷Ú␀␀␀~¬␀␀(	„␀␀␀␀␀U±␀␀†^¯␀␀d␀␀␀ÿ␀␀õÚ␀␀␀Ã§␀␀c„␀␀␀␀␀Ì©␀␀ç§␀␀ç§␀␀`␀␀ÿ␀␀ÿ␀øo(„␀␀␀␀␀␀¡	␀€	␀“	␀1␀␀ÿ␀␀ÿ␀6ac„␀␀␀␀␀␀`ü_ü_`␀␀ÿ␀␀ÿ␀C-·␀„␀␀␀␀␀␀¤¿␀␀¿␀␀£¿␀␀t␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀„␀␀␀␀␀␀ª¿␀␀©¿␀␀©¿␀␀t␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀„␀␀␀␀␀␀³¿␀␀²¿␀␀²¿␀␀t␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀„␀␀␀␀␀␀§¿␀␀¦¿␀␀¦¿␀␀t␀Æÿ␀␀ı×␀␀␀¸,´␀„␀␀␀␀␀␀şzızızr␀Æÿ␀␀fÎ␀␀␀Şw´␀„␀␀␀␀␀␀{{{r␀Æÿ␀␀fÎ␀␀␀~w´␀„␀␀␀␀␀␀␀{ÿzÿzr␀Æÿ␀␀fÎ␀␀␀	2=„␀␀␀␀␀␀Ÿ6Ÿ6Ÿ6c␀␀␀ÿ␀␀ÿ␀ä1=„␀␀␀␀␀␀‡6…6‡6c␀␀␀ÿ␀␀ÿN^␀„␀␀␀␀␀␀Q␀Q␀Q␀n␀Æÿ␀␀ÿ␀t±␀„␀␀␀␀␀␀ktš2htq␀Æÿ␀␀ÿ␀EO±␀„␀␀␀␀␀␀;␀;␀;q␀Æÿ␀␀ÿ␀]O±␀„␀␀␀␀␀␀/;;;q␀Æÿ␀␀ÿ␀D1=„␀␀␀␀␀␀z6 ¯␀␀{6c␀␀␀ÿ␀␀ÿN›␀=„␀␀␀␀␀␀‡␀…␀‡␀c␀␀␀ÿ␀␀ÿN␀␀␀0;1óÚ␀␀		SENIOR;0ê

TRIGGER R073RES_EI AFTER INSERT ON R073RES FOR EACH ROW
DECLARE
  l_IDTPES       VARCHAR(23);
BEGIN
  SP_RETIDTPES(NULL, 7, NULL, :NEW.TIPDOC, :NEW.NUMDOC, NULL, NULL, l_IDTPES OUT);
  SP_SAM_PENDENCIES(11, 1, l_IDTPES);
END␀öÚ␀␀	SENIOR;0Q␀␀

TRIGGER R073RES_SU AFTER UPDATE ON R073RES
DECLARE
/*CURSOR c/ os registros gravados no R073RES_AUX*/
  CURSOR c_r073res_upd IS SELECT TIPDOC,NUMDOC,CODPRM,PRMSAB,PRMDOM,PRMFER,CONTPM,USABIO,GRACON,CONADP,CONREE,USARFA FROM R073RES_AUX;
  TYPE t_r073res_aux IS RECORD(
    TIPDOC   R073RES_AUX.TIPDOC%TYPE,
    NUMDOC   R073RES_AUX.NUMDOC%TYPE,
    CODPRM   R073RES_AUX.CODPRM%TYPE,
    PRMSAB   R073RES_AUX.PRMSAB%TYPE,
    PRMDOM   R073RES_AUX.PRMDOM%TYPE,
    PRMFER   R073RES_AUX.PRMFER%TYPE,
    CONTPM   R073RES_AUX.CONTPM%TYPE,
    USABIO   R073RES_AUX.USABIO%TYPE,
    GRACON   R073RES_AUX.GRACON%TYPE,
    CONADP   R073RES_AUX.CONADP%TYPE,
    CONREE   R073RES_AUX.CONREE%TYPE,
    USARFA   R073RES_AUX.USARFA%TYPE);
  l_r073res_aux t_r073res_aux;

BEGIN
  FOREACH c_r073res_upd INTO  l_r073res_aux.TIPDOC,
                              l_r073res_aux.NUMDOC,
                              l_r073res_aux.CODPRM,
                              l_r073res_aux.PRMSAB,
                              l_r073res_aux.PRMDOM,
                              l_r073res_aux.PRMFER,
                              l_r073res_aux.CONTPM,
                              l_r073res_aux.USABIO,
                              l_r073res_aux.GRACON,
                              l_r073res_aux.CONADP,
                              l_r073res_aux.CONREE,
                              l_r073res_aux.USARFA
  LOOP
    R073RES_ATUCON (l_r073res_aux.TIPDOC,
                    l_r073res_aux.NUMDOC,
                    l_r073res_aux.CODPRM,
                    l_r073res_aux.PRMSAB,
                    l_r073res_aux.PRMDOM,
                    l_r073res_aux.PRMFER,
                    l_r073res_aux.CONTPM,
                    l_r073res_aux.USABIO,
                    l_r073res_aux.GRACON,
                    l_r073res_aux.CONADP,
                    l_r073res_aux.CONREE,
                    l_r073res_aux.USARFA);
  END LOOP;
  /* Apaga Registro OLD em R073RES_AUX */
  BEGIN
    DELETE FROM R073RES_AUX;
    DROP_TEMP_TABLE R073RES_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ôÚ␀␀		SENIOR;0´␀␀TRIGGER R073RES_EU AFTER UPDATE ON R073RES FOR EACH ROW
DECLARE
  l_online       BOOLEAN;
  l_IDTPES       VARCHAR(23);
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R073RES_AUX;
  
BEGIN
    SP_VerOnLine(l_online OUT);
    IF (l_online = TRUE) THEN
       BEGIN
       /* salva Registro  */
         INSERT INTO R073RES_AUX (TIPDOC,NUMDOC,CODPRM,PRMSAB,PRMDOM,PRMFER,CONTPM,USABIO,GRACON,CONADP,NOMRES,DDITEL,DDDTEL,FONRES,CONREE,USARFA)
                     VALUES (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.CODPRM,:NEW.PRMSAB,:NEW.PRMDOM,:NEW.PRMFER,:NEW.CONTPM,:NEW.USABIO,:NEW.GRACON,:NEW.CONADP,
					         :NEW.NOMRES,:NEW.DDITEL,:NEW.DDDTEL,:NEW.FONRES,:NEW.CONREE,:NEW.USARFA);
         EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro no INSERT em R073RES_AUX.';
       END;
    END IF;

  SP_RETIDTPES(NULL, 7, NULL, :NEW.TIPDOC, :NEW.NUMDOC, NULL, NULL, l_IDTPES OUT);
  SP_SAM_PENDENCIES(11, 2, l_IDTPES);
END␀òÚ␀␀		SENIOR;0ê

TRIGGER R073RES_ED AFTER DELETE ON R073RES FOR EACH ROW
DECLARE
  l_IDTPES       VARCHAR(23);
BEGIN
  SP_RETIDTPES(NULL, 7, NULL, :OLD.TIPDOC, :OLD.NUMDOC, NULL, NULL, l_IDTPES OUT);
  SP_SAM_PENDENCIES(11, 3, l_IDTPES);
