k=␀␀CREATE OR REPLACE PROCEDURE R115NOT_ATUNOT(P_TIPPNO INT,P_CODORI INT,P_NOMVIS VARCHAR(4000),P_EMAVIS VARCHAR(4000),P_DATPRV TIMESTAMP(0),P_HORPRV INT,P_DATVAL TIMESTAMP(0),P_HORVAL INT,P_NOMOEM VARCHAR(4000),P_DDITEL INT,P_DDDTEL INT,P_TELCON VARCHAR(4000),P_DESPOR 
VARCHAR(4000),P_NOMEMP VARCHAR(4000),P_NOMFUN VARCHAR(4000),P_DDITELVISITADO INT,P_DDDTELVISITADO INT,P_TELCONVISITADO VARCHAR(4000),P_SITUACAOWAV VARCHAR(4000),P_TIPDOC INT,P_DESDOC VARCHAR(4000),P_NUMDOC VARCHAR(4000),P_TIPVIS INT,P_NOMTIPVIS VARCHAR(4000),P_CODPOR 
INT,P_CODPRM INT,P_DESPRM VARCHAR(4000),P_PLAVEI VARCHAR(4000),P_NOMAUT VARCHAR(4000),P_OBSVIS VARCHAR(4000),P_NOMSOL VARCHAR(4000),P_EMASOL VARCHAR(4000),P_DATSAG TIMESTAMP(0),P_HORSAG INT,P_NOMUSU VARCHAR(4000),P_DATPSA TIMESTAMP(0),P_HORPSA INT,P_OBSREP VARCHAR(4000)) 
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  l_data TIMESTAMP(0);
  l_DatHorAtu DECIMAL(14,6);
  l_DatAtuStr VARCHAR(10);
  l_HorAtuStr VARCHAR(5);
  l_data_zero DECIMAL(14,6);
  l_DthLim DECIMAL(14,6);
  l_codnot INT;
  l_LocAgvStr VARCHAR(6);
  l_DatVisStr VARCHAR(10);
  l_HorVisStr VARCHAR(5);
  l_fonVis VARCHAR(30);
  l_fonVisitado VARCHAR(30);
  l_DatValStr VARCHAR(10);
  l_HorValStr VARCHAR(5);
  l_DtHValStr VARCHAR(25);
  l_DatHorVal TIMESTAMP(0);
  l_TIPDOCStr VARCHAR(1);
  l_TIPVISStr VARCHAR(3);
  l_CODPORStr VARCHAR(3);
  l_CODPRMStr VARCHAR(5);
  l_DATSAGStr VARCHAR(10);
  l_HORSAGStr VARCHAR(5);
  l_DATPSAStr VARCHAR(10);
  l_HORPSAStr VARCHAR(5);
begin
  l_data_zero := 364.0;
  PERFORM SP_DATETIME(l_DatHorAtu);
  l_data := current_timestamp;
  PERFORM SP_DATSTR(l_data,'DD/MM/YYYY',l_DatAtuStr);
  PERFORM SP_HORSTR(l_data,'HH:MM',l_HorAtuStr);
  if (p_DatPrv IS  
      NOT NULL) then
    PERFORM SP_DATSTR(p_DatPrv,'DD/MM/YYYY',l_DatVisStr);
    PERFORM SP_INTSTR(p_HorPrv,'HH:MM',l_HorVisStr);
  end if;
  if (p_DatVal IS  
      NOT NULL) then
    PERFORM SP_DATSTR(p_DatVal,'DD/MM/YYYY',l_DatValStr);
    PERFORM SP_INTSTR(p_HorVal,'HH:MM',l_HorValStr);
    l_DtHValStr := l_DatValStr||' '||l_HorValStr||':00';
    PERFORM SP_STRTODATE(l_DtHValStr,'DD/MM/AAAA hh:mi:ss',l_DatHorVal);
    PERFORM SP_DATETONUMBER(l_DatHorVal,l_DthLim);
  else
    l_DthLim := l_data_zero;
  end if;
  l_fonVisitado := ltrim(rtrim(replace(p_TelconVisitado,'-','')));
  if p_DDDTelVisitado IS  
      NOT NULL 
      AND p_DDDTelVisitado>0 then
    l_fonVisitado := ltrim(rtrim(p_DDDTelVisitado))||'-'||l_fonVisitado;
  end if;
  if p_DDITelVisitado IS  
      NOT NULL 
      AND p_DDITelVisitado>0 then
    l_fonVisitado := ltrim(rtrim(p_DDITelVisitado))||'-'||l_fonVisitado;
  end if;
  if (p_TipPNo=1) 
      AND (p_EmaVis IS  
      NOT NULL 
      AND POSITION('@' IN p_EmaVis)>0) then
    PERFORM SP_CODLOCALIZADOR(p_CodOri,l_LocAgvStr);

    INSERT INTO R115NOT (CodNot,TipNot,StaNot,DthNot,DthLim,CodOri,QtdEnv) VALUES  (l_codnot,p_TipPNo,0,l_DatHorAtu,l_DthLim,p_CodOri,0) returning codNot into l_codNot;

    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'email',p_EmaVis);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'assunto','Agendamento de visita realizado');
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'localizador',l_LocAgvStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'dataVisita',l_DatVisStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'horaVisita',l_HorVisStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeVisitante',p_NomVis);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomePortaria',p_DesPor);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeEmpresaVisitante',p_NomOem);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeEmpresaVisitado',p_NomEmp);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeVisitado',p_NomFun);
  elsif (p_TipPNo=2) 
      AND (p_TelCon IS  
      NOT NULL 
      AND LENGTH(LTRIM(RTRIM(p_TelCon)))>0) then
    PERFORM SP_CODLOCALIZADOR(p_CodOri,l_LocAgvStr);

    INSERT INTO R115NOT (CodNot,TipNot,StaNot,DthNot,DthLim,CodOri,QtdEnv) VALUES  (l_codnot,p_TipPNo,0,l_DatHorAtu,l_DthLim,p_CodOri,0) returning codNot into l_codNot;
    l_fonVis := ltrim(rtrim(replace(p_Telcon,'-','')));
    if p_DDDTel IS  
      NOT NULL 
      AND p_DDDTel>0 then
      l_fonVis := ltrim(rtrim(p_DDDTel))||'-'||l_fonVis;
    end if;
    if p_DDITel IS  
      NOT NULL 
      AND p_DDITel>0 then
      l_fonVis := ltrim(rtrim(p_DDITel))||'-'||l_fonVis;
    end if;
    
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'telefone',l_fonVis);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'localizador',l_LocAgvStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'dataVisita',l_DatVisStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'horaVisita',l_HorVisStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeVisitante',p_NomVis);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomePortaria',p_DesPor);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeEmpresaVisitante',p_NomOem);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeEmpresaVisitado',p_NomEmp);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeVisitado',p_NomFun);
  elsif (p_TipPNo=3) 
      AND (p_EmaSol IS  
      NOT NULL 
      AND POSITION('@' IN p_EmaSol)>0) then
    
    INSERT INTO R115NOT (CodNot,TipNot,StaNot,DthNot,DthLim,CodOri,QtdEnv) VALUES  (l_codnot,p_TipPNo,0,l_DatHorAtu,l_data_zero,p_CodOri,0) returning codNot into l_codNot;
    l_fonVis := ltrim(rtrim(replace(p_Telcon,'-','')));
    if p_DDDTel IS  
      NOT NULL 
      AND p_DDDTel>0 then
      l_fonVis := ltrim(rtrim(p_DDDTel))||'-'||l_fonVis;
    end if;
    if p_DDITel IS  
      NOT NULL 
      AND p_DDITel>0 then
      l_fonVis := ltrim(rtrim(p_DDITel))||'-'||l_fonVis;
    end if;
    
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'email',p_EmaSol);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'assunto','Chegada do visitante '||p_NomVis);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'dataChegada',l_DatAtuStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'horaChegada',l_HorAtuStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeVisitante',p_NomVis);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'telefoneVisitante',l_fonVis);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomePortaria',p_DesPor);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeEmpresaVisitado',p_NomEmp);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeVisitado',p_NomFun);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeEmpresaVisitante',p_NomOem);
  elsif (p_TipPNo=4) 
      AND (p_TelConVisitado IS  
      NOT NULL 
      AND LENGTH(LTRIM(RTRIM(p_TelConVisitado)))>0) then
    
    INSERT INTO R115NOT (CodNot,TipNot,StaNot,DthNot,DthLim,CodOri,QtdEnv) VALUES  (l_codnot,p_TipPNo,0,l_DatHorAtu,l_data_zero,p_CodOri,0) returning codNot into l_codNot;
    l_fonVis := ltrim(rtrim(replace(p_Telcon,'-','')));
    if p_DDDTel IS  
      NOT NULL 
      AND p_DDDTel>0 then
      l_fonVis := ltrim(rtrim(p_DDDTel))||'-'||l_fonVis;
    end if;
    if p_DDITel IS  
      NOT NULL 
      AND p_DDITel>0 then
      l_fonVis := ltrim(rtrim(p_DDITel))||'-'||l_fonVis;
    end if;
    
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'telefone',l_fonVisitado);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'dataChegada',l_DatAtuStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'horaChegada',l_HorAtuStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeVisitante',p_NomVis);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'telefoneVisitante',l_fonVis);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomePortaria',p_DesPor);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeEmpresaVisitado',p_NomEmp);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeVisitado',p_NomFun);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeEmpresaVisitante',p_NomOem);
  elsif (p_TipPNo=5) 
      AND (p_EmaSol IS  
      NOT NULL 
      AND POSITION('@' IN p_EmaSol)>0) then
    PERFORM SP_CODLOCALIZADOR(p_CodOri,l_LocAgvStr);
    
    INSERT INTO R115NOT (CodNot,TipNot,StaNot,DthNot,DthLim,CodOri,QtdEnv) VALUES  (l_codnot,p_TipPNo,0,l_DatHorAtu,l_DthLim,p_CodOri,0) returning codNot into l_codNot;
    l_fonVis := ltrim(rtrim(replace(p_Telcon,'-','')));
    if p_DDDTel IS  
      NOT NULL 
      AND p_DDDTel>0 then
      l_fonVis := ltrim(rtrim(p_DDDTel))||'-'||l_fonVis;
    end if;
    if p_DDITel IS  
      NOT NULL 
      AND p_DDITel>0 then
      l_fonVis := ltrim(rtrim(p_DDITel))||'-'||l_fonVis;
    end if;
    if (p_DATVAL IS  
      NOT NULL) then
      PERFORM SP_DATSTR(p_DATVAL,'DD/MM/YYYY',l_DATVALStr);
    end if;
    if (p_HORVAL IS  
      NOT NULL) then
      PERFORM SP_INTSTR(p_HORVAL,'HH:MM',l_HORValStr);
    end if;
    if (p_DATSAG IS  
      NOT NULL) then
      PERFORM SP_DATSTR(p_DATSAG,'DD/MM/YYYY',l_DATSAGStr);
    end if;
    if (p_HORSAG IS  
      NOT NULL) then
      PERFORM SP_INTSTR(p_HORSAG,'HH:MM',l_HORSAGStr);
    end if;
    if (p_DATPSA IS  
      NOT NULL) then
      PERFORM SP_DATSTR(p_DATPSA,'DD/MM/YYYY',l_DATPSAStr);
    end if;
    if (p_HORPSA IS  
      NOT NULL) then
      PERFORM SP_INTSTR(p_HORPSA,'HH:MM',l_HORPSAStr);
    end if;
    PERFORM SP_INTSTR(p_TIPDOC,'9',l_TIPDOCStr);
    PERFORM SP_INTSTR(p_TIPVIS,'999',l_TIPVISStr);
    PERFORM SP_INTSTR(p_CODPOR,'999',l_CODPORStr);
    PERFORM SP_INTSTR(p_CODPRM,'99999',l_CODPRMStr);
    
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'email',p_EmaSol);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'assunto','AGENDAMENTO DE VISITA '||p_SituacaoWAV);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeEmpresaVisitado',p_NomEmp);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeVisitado',p_NomFun);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeEmpresaVisitante',p_NomOem);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'dataVisita',l_DatVisStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomePortaria',p_DesPor);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'tipoDocumento',l_TIPDOCStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeDocumento',p_DESDOC);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'documento',p_NUMDOC);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'tipoVisita',l_TIPVISStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeTipoVisita',p_NomTIPVIS);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'idPortaria',l_CODPORStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'tipoPermissao',l_CODPRMStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomePermissao',p_DESPRM);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'placaVeiculo',p_PLAVEI);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeAutorizador',p_NomAut);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'observacaoVisita',p_OBSVIS);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeSolicitante',p_NomSol);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'emailSolicitante',p_EmaSol);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'dataSolicitacao',l_DATSAGStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'horaSolicitacao',l_HORSAGStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeUsuarioProcessamento',p_NOMUSU);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'dataProcessamento',l_DATPSAStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'horaProcessamento',l_HORPSAStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'observacaoReprovacao',p_OBSREP);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'situacao',p_SituacaoWAV);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'horaVisita',l_HorVisStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeVisitante',p_NomVis);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'emailVisitante',p_EmaVis);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'foneVisitante',l_fonVis);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'dataValidadeVisita',l_DATVALStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'horaValidadeVisita',l_HORVALStr);
  elsif (p_TipPNo=6) 
      AND (p_TelConVisitado IS  
      NOT NULL 
      AND LENGTH(LTRIM(RTRIM(p_TelConVisitado)))>0) then
    PERFORM SP_CODLOCALIZADOR(p_CodOri,l_LocAgvStr);
    
    INSERT INTO R115NOT (CodNot,TipNot,StaNot,DthNot,DthLim,CodOri,QtdEnv) VALUES  (l_codnot,p_TipPNo,0,l_DatHorAtu,l_DthLim,p_CodOri,0) returning codNot into l_codNot;
    
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'telefone',l_fonVisitado);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'dataVisita',l_DatVisStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'horaVisita',l_HorVisStr);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'situacao',p_SituacaoWAV);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeVisitante',p_NomVis);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeEmpresaVisitante',p_NomOem);
  elsif (p_TipPNo=7) 
      AND (p_EmaSol IS  
      NOT NULL 
      AND POSITION('@' IN p_EmaSol)>0) then
    PERFORM SP_CODLOCALIZADOR(p_CodOri,l_LocAgvStr);
    
    INSERT INTO R115NOT (CodNot,TipNot,StaNot,DthNot,DthLim,CodOri,QtdEnv) VALUES  (l_codnot,p_TipPNo,0,l_DatHorAtu,l_DthLim,p_CodOri,0) returning codNot into l_codNot;
    
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'email',p_EmaSol);
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'assunto','Agendamento de Visita Pendente de Aprovação');
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'nomeEmpresaVisitado',p_NomEmp);
  elsif (p_TipPNo=8) 
      AND (p_TelConVisitado IS  
      NOT NULL 
      AND LENGTH(LTRIM(RTRIM(p_TelConVisitado)))>0) then
    PERFORM SP_CODLOCALIZADOR(p_CodOri,l_LocAgvStr);
    
    INSERT INTO R115NOT (CodNot,TipNot,StaNot,DthNot,DthLim,CodOri,QtdEnv) VALUES  (l_codnot,p_TipPNo,0,l_DatHorAtu,l_DthLim,p_CodOri,0) returning codNot into l_codNot;
    l_fonVis := ltrim(rtrim(replace(p_Telcon,'-','')));
    if p_DDDTel IS  
      NOT NULL 
      AND p_DDDTel>0 then
      l_fonVis := ltrim(rtrim(p_DDDTel))||'-'||l_fonVis;
    end if;
    if p_DDITel IS  
      NOT NULL 
      AND p_DDITel>0 then
      l_fonVis := ltrim(rtrim(p_DDITel))||'-'||l_fonVis;
    end if;
    
    INSERT INTO R115CNO (CodNot,NomCam,ValStr) VALUES  (l_codnot,'telefone',l_fonVisitado);
  end if;
end;
