TRIGGER R017RHP_SI AFTER INSERT ON R017RHP

DECLARE
/* CURSOR c/ os registros gravados na tabela R017RHP_AUX */
  CURSOR c_R017RHP_AuxI IS SELECT DISTINCT R017RHP_AUX.ESTPOS, R017RHP_AUX.CODTHP FROM R017RHP_AUX;

  TYPE t_R017RHP_AuxI IS RECORD(
    ESTPOS   R017RHP_AUX.ESTPOS%TYPE,
    CODTHP   R017RHP_AUX.CODTHP%TYPE);

  l_R017RHP_AuxI t_R017RHP_AuxI;
BEGIN
  /* Seta flag de controle para 1, evitando que a trigger seja
     processada em mais de uma instancia, controle necessário para evitar a Recursividade */
  BEGIN
    UPDATE R017RHP_AUX SET FLGCON = 1;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro flag de controle da tabela R017RHP_AUX.';
  END;

  /* Calcula data final para todos os registros da estrutura e hierarquia informada */
  FOREACH c_R017RHP_AuxI INTO l_R017RHP_AuxI.ESTPOS,
                              l_R017RHP_AuxI.CODTHP
  LOOP
    BEGIN
      UPDATE R017RHP
         SET DATFIM = (SELECT IFNULL((DATETIMEADD(DD, -1, MIN(RHP.DATREV))), DATETIME(31, 12, 1900, 0, 0, 0)) FROM R017RHP RHP
                        WHERE RHP.ESTPOS = R017RHP.ESTPOS AND RHP.CODTHP = R017RHP.CODTHP
                          AND RHP.DATREV > R017RHP.DATREV)
       WHERE ESTPOS = l_R017RHP_AuxI.ESTPOS
         AND CODTHP = l_R017RHP_AuxI.CODTHP;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar data de término da revisão.';
    END;
  END LOOP;

  /* Apaga Registros em R017RHP_AUX */
  BEGIN
    DELETE FROM R017RHP_AUX;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao excluir registros da tabela R017RHP_AUX.';
  END;
END␀±Ğ␀␀		SENIOR;03␀␀TRIGGER R017RHP_EI AFTER INSERT ON R017RHP FOR EACH ROW

BEGIN
BEGIN
    /* Insere Registro New */
    INSERT INTO R017RHP_AUX (ESTPOS, CODTHP, FLGCON) VALUES (:NEW.ESTPOS, :NEW.CODTHP, 0);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao inserir registro na tabela R017RHP_AUX.';
  END;
END␀¶Ğ␀␀	SENIOR;0N␀␀

TRIGGER R017RHP_SU AFTER UPDATE ON R017RHP

DECLARE
/* CURSOR c/ os registros gravados na tabela R017RHP_AUX */
  CURSOR c_R017RHP_AuxU IS SELECT DISTINCT R017RHP_AUX.ESTPOS, R017RHP_AUX.CODTHP FROM R017RHP_AUX;

  TYPE t_R017RHP_AuxU IS RECORD(
    ESTPOS   R017RHP_AUX.ESTPOS%TYPE,
    CODTHP   R017RHP_AUX.CODTHP%TYPE);

  l_R017RHP_AuxU t_R017RHP_AuxU;
  l_Count        NUMBER;
BEGIN
  /* Garante que está sendo processado a trigger uma unica vez, evitando assim LOOP */
  BEGIN
    SELECT COUNT(*) INTO l_Count FROM R017RHP_AUX
     WHERE FLGCON = 1;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao retornar flag de controle da tabela R017RHP_AUX.';
  END;

  /* Se não existe registro com Flag = 1 significa estar passando pela primeira vez na trigger */
  IF (l_Count  = 0) THEN
    /* Seta flag de controle para 1, evitando que a trigger seja
       processada em mais de uma instancia, controle necessário para evitar a Recursividade */
    BEGIN
      UPDATE R017RHP_AUX SET FLGCON = 1;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro flag de controle da tabela R017RHP_AUX.';
    END;

    /* Calcula data final para todos os registros da estrutura e hierarquia informada */
    FOREACH c_R017RHP_AuxU INTO l_R017RHP_AuxU.ESTPOS,
                                l_R017RHP_AuxU.CODTHP
    LOOP
      BEGIN
        UPDATE R017RHP
           SET DATFIM = (SELECT IFNULL((DATETIMEADD(DD, -1, MIN(RHP.DATREV))), DATETIME(31, 12, 1900, 0, 0, 0)) FROM R017RHP RHP
                          WHERE RHP.ESTPOS = R017RHP.ESTPOS AND RHP.CODTHP = R017RHP.CODTHP
                            AND RHP.DATREV > R017RHP.DATREV)
         WHERE ESTPOS = l_R017RHP_AuxU.ESTPOS
           AND CODTHP = l_R017RHP_AuxU.CODTHP;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao atualizar data de término da revisão.';
      END;
    END LOOP;

    /* Apaga Registros em R017RHP_AUX */
    BEGIN
      DELETE FROM R017RHP_AUX;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao excluir registros da tabela R017RHP_AUX.';
    END;
  END IF;
END␀²Ğ␀␀		SENIOR;0—␀␀

TRIGGER R017RHP_EU AFTER UPDATE ON R017RHP FOR EACH ROW

DECLARE
l_New_DatRev   R017RHP.DATREV%TYPE;
  l_Old_DatRev   R017RHP.DATREV%TYPE;
BEGIN
  BEGIN
    l_New_DatRev := IFNULL(:NEW.DATREV, DATETIME(31, 12, 1900, 0, 0, 0));
    l_Old_DatRev := IFNULL(:OLD.DATREV, DATETIME(31, 12, 1900, 0, 0, 0));
    /* Somente processa se alterou a data inicial */
    IF (l_New_DatRev <> l_Old_DatRev) THEN
      /* Insere Registro New */
      INSERT INTO R017RHP_AUX (ESTPOS, CODTHP, FLGCON) VALUES (:NEW.ESTPOS, :NEW.CODTHP, 0);
    END IF;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao inserir registro na tabela R017RHP_AUX.';
  END;
END␀´Ğ␀␀	SENIOR;0Q␀␀

TRIGGER R017RHP_SD AFTER DELETE ON R017RHP

DECLARE
/* CURSOR c/ os registros gravados na tabela R017RHP_AUX */
  CURSOR c_R017RHP_AuxD IS SELECT DISTINCT R017RHP_AUX.ESTPOS, R017RHP_AUX.CODTHP FROM R017RHP_AUX;

  TYPE t_R017RHP_AuxD IS RECORD(
    ESTPOS   R017RHP_AUX.ESTPOS%TYPE,
    CODTHP   R017RHP_AUX.CODTHP%TYPE);

  l_R017RHP_AuxD t_R017RHP_AuxD;
