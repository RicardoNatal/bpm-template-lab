¶␀␀+␀1␀␀ÿ␀␀6`␀få„␀␀␀␀␀xfº␀ƒfh␀ŸŠ␀␀ÿ␀␀ÿ␀ [Ñ␀„␀␀␀␀␀ØJgj®FqC␀êÿ␀␀ÿ␀b´␀„␀␀␀␀␀øb´aÒbr␀Æÿ␀␀Ò␀␀␀&	␀t„␀␀␀␀␀†␀L␀L␀n␀Æÿ␀␀ˆÓ␀␀␀l$Ì␀„␀␀␀␀␀=%$$¼$w␀Æÿ␀␀…Ó␀␀␀Ğa´␀„␀␀␀␀␀îb—a€br␀Æÿ␀␀Ò␀␀␀',„␀␀␀␀␀@Ñ!)b␀␀␀ÿ␀␀)`␀M␀„␀␀␀␀␀ö␀a␀b␀n␀Æÿ␀␀ÿ␀İ,­␀„␀␀␀␀␀?Bş¢␀␀ş¢␀␀p␀Æÿ␀␀Ú␀␀␀-±␀„␀␀␀␀␀W=¦␀␀¦␀␀q␀Æÿ␀␀Ñ␀␀␀Àú␀␀„␀␀␀␀␀Üú␀␀µú␀␀Ôú␀␀n¾ˆ␀Æÿ␀␀|İ␀␀␀»ú␀␀(„␀␀␀␀␀Úú␀␀´ú␀␀Ôú␀␀d␀¹ˆ␀␀ÿ␀␀{İ␀␀␀9-±␀„␀␀␀␀␀Ÿ=àÃ␀␀òÃ␀␀qi‡␀Æÿ␀␀ğ×␀␀␀-´␀„␀␀␀␀␀¤;¤;¤;r␀Æÿ␀␀Åê␀␀␀;a„␀␀␀␀␀````␀␀ÿ␀␀ÿ␀¥%␀±␀„␀␀␀␀␀?&␀<&␀<&␀q␀Æÿ␀␀6Ø␀␀␀3-Á␀„␀␀␀␀␀Ï@˜š␀␀˜š␀␀y␀Æÿ␀␀å×␀␀␀šEÑ␀„␀␀␀␀␀K=_ÒNqC␀êÿ␀␀ÿ␀Üw·␀„␀␀␀␀␀šy}{Ôxì*␀␀Æÿ␀␀ÿ␀`EÑ␀„␀␀␀␀␀eK4_ÅNqC␀êÿ␀␀ÿ␀Æw·␀„␀␀␀␀␀•yv{¸xì*␀␀Æÿ␀␀ÿ␀Ó-‹␀„␀␀␀␀␀³Aˆ␀‰␀—)␀␀Æÿ␀␀ÿ␀Æ³␀␀„␀␀␀␀␀I´␀␀1³␀␀´␀␀!␀␀ÿ␀␀ÿ␀Nš␀␀Ì␀„␀␀␀␀␀—;ä+–;{␀Æÿ␀␀ÿ␀o§␀␀U„␀␀␀␀␀pª␀␀†ª␀␀…¨␀␀V␀␀ÿ␀␀ÿ␀<EÑ␀„␀␀␀␀␀RK(¦␀␀HqC␀êÿ␀␀ÿ␀qo„␀␀␀␀␀|qPqzqi␀␀ÿ␀␀ÿ␀bË␀␀o„␀␀␀␀␀–Ë␀␀Ë␀␀•Ë␀␀i␀␀ÿ␀␀ÿ␀Ò_Ñ␀„␀␀␀␀␀KóH÷HqC␀êÿ␀␀ÿ␀Dº␀␀´␀„␀␀␀␀␀Ø»␀␀Ì»␀␀Î»␀␀r␀Æÿ␀␀Û␀␀␀8␀²„␀␀␀␀␀­␀␀Ÿ␀␀Ÿ␀␀c␀␀␀ÿ␀␀ÿ␀␀␀İ␀␀␀␀İ␀␀␀İ␀␀␀İ␀␀␀İ␀␀7␀␀0;1;2;3;4;5İ␀␀		SENIOR;0␀␀TRIGGER R090AGV_EI BEFORE INSERT ON R090AGV FOR EACH ROW
BEGIN
  SP_PEND86('2', :NEW.DATPRV, :NEW.HORPRV, :NEW.SEQAGV, :NEW.NUMEMP, :NEW.TIPCOL,
                 :NEW.NUMCAD, :NEW.TIPDOC, :NEW.NUMDOC, :NEW.NOMVIS, :NEW.TIPVIS, :NEW.CODPRM,
                 :NEW.DATVAL, :NEW.HORVAL, :NEW.CODPOR, 
                 :NEW.CODNAC, :NEW.OBSVIS, :NEW.CODOEM, :NEW.NOMOEM, :NEW.DDITEL, :NEW.DDDTEL, :NEW.TELCON, :NEW.EMAVIS,
                 :NEW.LOCAGV, :NEW.EMPAUT, :NEW.TCLAUT, :NEW.CADAUT, :NEW.STAWAV, :NEW.VERPLF, :NEW.CODPLF, 'N');
END		SENIOR;20(␀␀TRIGGER R090AGV_EI BEFORE INSERT ON R090AGV FOR EACH ROW
DECLARE
l_UsaTAA    VARCHAR(1);
  l_EnvAge    NUMBER(1);
  l_DesPor    VARCHAR2(20);
  l_NomEmp    VARCHAR2(40);
  l_NomFun    VARCHAR2(40);
  l_NomAut    VARCHAR2(40);
  l_EmaAut    VARCHAR2(100);
  l_DDITelAut NUMBER(3);
  l_DDDTelAut NUMBER(3);
  l_TelConAut VARCHAR2(20);
  l_LocAGV    NUMBER(9);
BEGIN
    GETNEXTVALUE('SEQNOT', 1, NULL, l_LocAGV OUT);
  /* A ATRIBUICAO DO :NEW.LOCAGV PARA O ORACLE, OU UPDATE DO LOCAGV PARA O SQL SERVER, FACO ALI NO FIM DA R090AGV_EI,
       PARA EVITAR QUE O UPDATE DO REGISTRO DO AGENDAMENTO NO SQL SERVER GERE MAIS UMA NOTIFICACAO IGUAL A EXISTENTE */

  SP_PEND86('2', :NEW.DATPRV, :NEW.HORPRV, :NEW.SEQAGV, :NEW.NUMEMP, :NEW.TIPCOL,
                 :NEW.NUMCAD, :NEW.TIPDOC, :NEW.NUMDOC, :NEW.NOMVIS, :NEW.TIPVIS, :NEW.CODPRM,
                 :NEW.DATVAL, :NEW.HORVAL, :NEW.CODPOR, 
                 :NEW.CODNAC, :NEW.OBSVIS, :NEW.CODOEM, :NEW.NOMOEM, :NEW.DDITEL, :NEW.DDDTEL, :NEW.TELCON, :NEW.EMAVIS,
                 l_LocAGV, :NEW.EMPAUT, :NEW.TCLAUT, :NEW.CADAUT, :NEW.STAWAV, :NEW.VERPLF, :NEW.CODPLF, 'N');

  /* NOTIFICACAO DE AGENDAMENTO DE VISITA CRIADO - AO VISITANTE - TERMINAL DE AUTOATENDIMENTO */
  IF (:NEW.STAWAV = 1) AND (:NEW.TipVis IS NOT NULL) THEN

    BEGIN
      SELECT UsaTAA, EnvAge INTO l_UsaTAA, l_EnvAge FROM R090TVI WHERE TIPVIS = :NEW.TIPVIS;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_UsaTAA := 'N';
      WHEN OTHERS THEN NULL;
    END;

    IF (l_UsaTAA = 'S') AND (l_EnvAge > 0) THEN

      BEGIN
        SELECT R058POR.DesPor INTO l_DesPor FROM R058POR WHERE R058POR.CODPOR = :NEW.CODPOR;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      BEGIN
        SELECT R030EMP.NomEmp INTO l_NomEmp FROM R030EMP WHERE R030EMP.NUMEMP = :NEW.NUMEMP;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;

      BEGIN
        SELECT R034FUN.NomFun INTO l_NomFun FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.NUMEMP AND R034FUN.TIPCOL = :NEW.TIPCOL AND R034FUN.NUMCAD = :NEW.NUMCAD;
      EXCEPTION
        WHEN OTHERS THEN NULL;
      END;
      
      /* Envio Confirmacao Agendamento ao Visitante - email */
      IF (l_EnvAge = 1) OR (l_EnvAge = 9) THEN
        R115NOT_ATUNOT(1, 
                       l_LocAGV,
                       :NEW.NOMVIS,
                       :NEW.EMAVIS,
                       :NEW.DATPRV,
                       :NEW.HORPRV,
                       :NEW.DATVAL,
                       :NEW.HORVAL,
                       :NEW.NOMOEM,
                       NULL,  /*:NEW.DDITEL,*/
                       NULL,  /*:NEW.DDDTEL,*/
                       NULL,  /*:NEW.TELCON,*/
                       l_DesPor,
                       l_NomEmp,
                       l_NomFun,
                       NULL,  /* DDI Visitado */
                       NULL,  /* DDD Visitado */
                       NULL,  /* Fone do Visitado */
                       NULL,  /* SituacaoWAV */
                       NULL, /* TIPDOC */
                       '', /* Desc. TipDoc*/
                       '', /* NUMDOC */
                       NULL, /* TIPVIS */
                       '', /* NomTIPVIS */
                       NULL, /* CODPOR */
                       NULL, /* CODPRM */
                       '', /* DESPRM */
                       '', /* PLAVEI*/
                       '', /* NomAut */
                       '', /* OBSVIS */
                       '', /* NomSol */
                       NULL, /* EmaSol */
                       NULL, /* DATSAG */
                       NULL, /* HORSAG */
                       '', /* NOMUSU */
                       NULL, /* DATPSA */
                       NULL, /* HORPSA */
                       '' /* OBSREP */
                       );
      END IF;

      /* Envio Confirmacao Agendamento ao Visitante - SMS */
      IF (l_EnvAge = 2) OR (l_EnvAge = 9) THEN
        R115NOT_ATUNOT(2, 
                       l_LocAGV,
                       :NEW.NOMVIS,
                       NULL, /*:NEW.EMAVIS,*/
                       :NEW.DATPRV,
                       :NEW.HORPRV,
                       :NEW.DATVAL,
                       :NEW.HORVAL,
                       :NEW.NOMOEM,
                       :NEW.DDITEL, 
                       :NEW.DDDTEL, 
                       :NEW.TELCON,
                       l_DesPor,
                       l_NomEmp,
                       l_NomFun,        
                       NULL,  /* DDI Visitado */
                       NULL,  /* DDD Visitado */
                       NULL,  /* Fone do Visitado */
                       NULL,  /* SituacaoWAV */
                       NULL, /* TIPDOC */
                       '', /* Desc. TipDoc*/
                       '', /* NUMDOC */
                       NULL, /* TIPVIS */
                       '', /* NomTIPVIS */
                       NULL, /* CODPOR */
                       NULL, /* CODPRM */
                       '', /* DESPRM */
                       '', /* PLAVEI*/
                       '', /* NomAut */
                       '', /* OBSVIS */
                       '', /* NomSol */
                       NULL, /* EmaSol */
                       NULL, /* DATSAG */
                       NULL, /* HORSAG */
                       '', /* NOMUSU */
                       NULL, /* DATPSA */
                       NULL, /* HORPSA */
                       '' /* OBSREP */
                       );    
      END IF;
    END IF;
  END IF;

  /* NOTIFICACAO DE AGENDAMENTO PENDENTE DE AUTORIZACAO - E-MAIL E SMS */
  IF (:NEW.STAWAV = 0) AND (:NEW.TipVis IS NOT NULL) THEN
  
    BEGIN
      SELECT NOTCOL INTO l_EnvAge FROM R070DAC;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;

    BEGIN
      SELECT R030EMP.NomEmp INTO l_NomEmp FROM R030EMP WHERE R030EMP.NUMEMP = :NEW.EMPAUT;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;
    
    BEGIN
      SELECT R034FUN.NomFun INTO l_NomAut FROM R034FUN WHERE R034FUN.NUMEMP = :NEW.EMPAUT AND R034FUN.TIPCOL = :NEW.TCLAUT AND R034FUN.NUMCAD = :NEW.CADAUT;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;
          
    BEGIN
      SELECT R034CPL.EmaCom
      INTO l_EmaAut
      FROM R034CPL
      WHERE R034CPL.NUMEMP = :NEW.EMPAUT AND R034CPL.TIPCOL = :NEW.TCLAUT AND R034CPL.NUMCAD = :NEW.CADAUT;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;
          
    /* EMAIL ou AMBOS */
    IF (l_EnvAge = 1) OR (l_EnvAge = 9) THEN
            R115NOT_ATUNOT(7, 
                           l_LocAGV,
                           '',
                           '',
                           NULL,
                           NULL,
                           NULL,
                           NULL,
                           '',
                           NULL,
                           NULL,
                           NULL,
                           '',
                           l_NomEmp,
                           '',       
                           NULL,
                           NULL,
                           NULL,
                           '',    /* SituacaoWAV */
                           NULL,
                           '',
                           '',
                           NULL,
                           '',
