␀␀PROCEDURE SP_PENDADE_DSP(P_TIPOPE CHAR, P_CODDSP NUMBER(9), P_MODRLG NUMBER(4), P_VERPLF NUMBER(3), P_CODPLF NUMBER(7), P_PROORI VARCHAR2(36))
  IS

  l_codrec NUMBER(15);
  l_codpen NUMBER(18);
  l_modrlg NUMBER(4);
BEGIN
    /* Verifica a categoria do local físico. Só envia se for recinto alfandegado */
    BEGIN
        SELECT PLF.CODREC INTO  l_codrec
          FROM R058PLF PLF, R151PLF PLL, R151LEG LEG
         WHERE PLF.VERPLF = P_VERPLF AND PLF.CODPLF = P_CODPLF AND PLF.CATPLF = 9
           AND PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3;
    EXCEPTION WHEN OTHERS THEN
        l_codrec := 0;
    END;

    IF (l_codrec > 0) THEN
        /* Verifica se eh uma leitora, câmera, gerenciador e placa controladora*/
        l_modrlg := 0;
        BEGIN
            SELECT MODRLG INTO l_modrlg FROM R058MOD WHERE MODRLG = P_MODRLG AND CATMOD IN (1, 3, 5, 8);
        EXCEPTION
            WHEN OTHERS THEN
                l_modrlg := 0;
        END;

        IF (l_modrlg > 0) THEN
            /* Gerar pendência ADE02 */
            SP_PENDADE02(5, P_TIPOPE, P_VERPLF, P_CODPLF, l_codrec, l_codpen OUT);

            BEGIN
                INSERT INTO R152GEO (CODPEN, CODDSP, VERPLF, CODPLF, PROORI)
                VALUES (l_codpen, P_CODDSP, NULL, NULL, P_PROORI);
            EXCEPTION
              WHEN OTHERS THEN
                RAISERROR 103 'SP_PENDADE_DSP: Erro ao inserir pendência de georreferenciamento de dispositivo';
            END;
        END IF;
    END IF;
END		SENIOR;21SP_PENDADE02

