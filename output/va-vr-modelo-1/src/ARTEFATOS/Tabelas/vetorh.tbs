␀)
␀2
␀q␀Æÿ␀␀ÿ␀ä1=␀␀␀␀␀␀‡6…6‡6c␀␀␀ÿ␀␀ÿN7␀·␀␀␀␀␀␀␀F␀!␀"␀ì*␀ô†␀Æÿ␀␀ÿ␀^␀␀␀␀␀␀␀Q␀Q␀Q␀n␀Æÿ␀␀ÿ␀{DÑ␀␀␀␀␀␀␀IùHùHqC␀êÿ␀␀ÿ␀¾EÑ␀␀␀␀␀␀␀şHşHşHqC␀êÿ␀␀ÿ␀u=␀␀␀␀␀␀®¯­c␀␀␀ÿ␀␀ÿ␀‚%␀=␀␀␀␀␀␀»%␀»%␀»%␀c␀␀␀ÿ␀␀ÿ␀¥=␀␀␀␀␀␀2&2c␀␀␀ÿ␀␀ÿ␀Ù¡␀␀=␀␀␀␀␀␀P»␀␀P»␀␀P»␀␀c␀␀␀ÿ␀␀ÿ␀§1=␀␀␀␀␀␀r6r6r6c␀␀␀ÿ␀␀ÿ␀>␀±␀␀␀␀␀␀␀`␀_␀_␀q␀Æÿ␀␀ÿ␀£’␀␀=␀␀␀␀␀␀␀“␀␀ê’␀␀ê’␀␀c␀␀␀ÿ␀␀ÿ␀EÑ␀␀␀␀␀␀␀GGGqC␀êÿ␀␀ÿ␀¡w·␀␀␀␀␀␀␀†x†x†xì*␀␀Æÿ␀␀ÿ␀␀Ê␀␀␀␀␀␀h␀h␀h␀n␀Æÿ␀␀ÿ␀â1=␀␀␀␀␀␀R»␀␀ô␀␀Q»␀␀c␀␀␀ÿ␀␀ÿ␀␀=„␀␀␀␀␀W␀Ú6W␀c␀␀␀ÿ␀␀ÿSşñ␀␀=„␀␀␀␀␀S␀?ì␀␀?ì␀␀c␀␀␀ÿ␀␀ÿNş␀␀¢␀␀␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀ ␀=„␀␀␀␀␀‡␀…␀‡␀c␀␀␀ÿ␀␀ÿN␀␀␀0;1;2CÓ␀␀		SENIOR;0Ê(␀␀TRIGGER R034DAC_EI BEFORE INSERT ON R034DAC FOR EACH ROW

DECLARE
  l_online     BOOLEAN;
  l_verseq     NUMBER(10);
  l_seqreg     NUMBER(15);
  l_auditoria  CHAR(1);
  l_idtpes     CHAR(23);
  l_codprm_str CHAR(5);
  l_idregister CHAR(28);
  l_ade_gerpen BOOLEAN;
    
  /* variáveis para atualização da r070con */  
  l_codprm       NUMBER;
  l_prmsab       NUMBER;
  l_prmdom       NUMBER;
  l_prmfer       NUMBER;
  l_conadp       CHAR;
  l_conial       CHAR;
  l_temalm       NUMBER;
  l_confai       NUMBER;
  l_verprm       CHAR;
  l_concre       NUMBER;
  l_dataso       DATE;
  l_dattse       DATE;  
  l_verafa       CHAR;
  l_conpac       CHAR;
  l_tempac       NUMBER;
  l_tolacp       NUMBER;
  l_usabio       NUMBER;
  l_conint       CHAR;
  l_tolint       NUMBER;
  l_gracon       NUMBER;
  l_conrea       CHAR;
  l_reponl       CHAR;
  l_recvis       CHAR;
  l_conree       CHAR;
  l_usarfa       CHAR;
  /*****************************************/
  
BEGIN
  SP_VerOnLine(l_online OUT);

  IF   (l_online = TRUE) THEN
  
      /* garante que não joga valor nulo na R070CON*/
      
      IF (:NEW.CODPRM IS NULL) OR (:NEW.CODPRM ='') THEN
          l_codprm := 0;      
      ELSE
          l_codprm := :NEW.CODPRM;          
      END IF; 
      
      IF (:NEW.PRMSAB IS NULL) OR (:NEW.PRMSAB ='') THEN
          l_prmsab := 0;      
      ELSE
          l_prmsab := :NEW.PRMSAB;          
      END IF;
      
      IF (:NEW.PRMDOM IS NULL) OR (:NEW.PRMDOM ='') THEN
          l_prmdom := 0;      
      ELSE
          l_prmdom := :NEW.PRMDOM;          
      END IF;
      
      IF (:NEW.PRMFER IS NULL) OR (:NEW.PRMFER ='') THEN
          l_prmfer := 0;      
      ELSE
          l_prmfer := :NEW.PRMFER;          
      END IF;
       
      IF ((:NEW.CONADP <> 'S') AND (:NEW.CONADP <>'N')) OR 
          (:NEW.CONADP IS NULL) OR 
          (:NEW.CONADP ='') OR 
          (:NEW.CONADP =' ') THEN
          l_conadp := 'S';      
      ELSE
          l_conadp := :NEW.CONADP;          
      END IF;

      IF ((:NEW.CONIAL <> 'S') AND (:NEW.CONIAL <>'N')) OR 
          (:NEW.CONIAL IS NULL) OR 
          (:NEW.CONIAL ='') OR 
          (:NEW.CONIAL =' ') THEN
          l_conial := 'N';      
      ELSE
          l_conial := :NEW.CONIAL;          
      END IF;

      IF (:NEW.TEMALM IS NULL) OR (:NEW.TEMALM ='') THEN
          l_temalm := 0;      
      ELSE
          l_temalm := :NEW.TEMALM;          
      END IF;
                                            
      IF (:NEW.CONFAI IS NULL) OR (:NEW.CONFAI > 3) THEN
          l_confai := 0;      
      ELSE
          l_confai := :NEW.CONFAI;          
      END IF;

      IF ((:NEW.VERPRM <> 'S') AND (:NEW.VERPRM <>'N')) OR 
          (:NEW.VERPRM IS NULL) OR 
          (:NEW.VERPRM ='') OR 
          (:NEW.VERPRM =' ') THEN
          l_verprm := 'S';      
      ELSE
          l_verprm := :NEW.VERPRM;          
      END IF;

      IF (:NEW.CONCRE IS NULL) OR (:NEW.CONCRE > 4) THEN
          l_concre := 0;      
      ELSE
          l_concre := :NEW.CONCRE;          
      END IF;
                                            
      IF (:NEW.DATASO IS NULL)  THEN
          l_dataso := '31/12/1900,00:00:00';      
      ELSE
          l_dataso := :NEW.DATASO;          
      END IF;

      IF (:NEW.DATTSE IS NULL)  THEN
          l_dattse := '31/12/1900,00:00:00';      
      ELSE
          l_dattse := :NEW.DATTSE;          
      END IF;
                   
      IF ((:NEW.VERAFA <> 'S') AND (:NEW.VERAFA <>'N')) OR 
          (:NEW.VERAFA IS NULL) OR 
          (:NEW.VERAFA ='') OR 
          (:NEW.VERAFA =' ') THEN     
          l_verafa := 'S';      
      ELSE
          l_verafa := :NEW.VERAFA;          
      END IF;
                   
      IF ((:NEW.CONPAC <> 'S') AND (:NEW.CONPAC <>'N')) OR 
          (:NEW.CONPAC IS NULL) OR 
          (:NEW.CONPAC ='') OR 
          (:NEW.CONPAC =' ') THEN      
          l_conpac := 'N';      
      ELSE
          l_conpac := :NEW.CONPAC;          
      END IF;
      
      IF (:NEW.TEMPAC IS NULL) OR (:NEW.TEMPAC ='') THEN
          l_tempac := 0;      
      ELSE
          l_tempac := :NEW.TEMPAC;          
      END IF;
      
      IF (:NEW.TOLACP IS NULL) OR (:NEW.TOLACP ='') THEN
          l_tolacp := 0;      
      ELSE
          l_tolacp := :NEW.TOLACP;          
      END IF;

      IF (:NEW.USABIO IS NULL) OR (:NEW.USABIO = 0) OR (:NEW.USABIO > 3) THEN
          l_usabio := 1;      
      ELSE
          l_usabio := :NEW.USABIO;          
      END IF;
                            
      IF ((:NEW.CONINT <> 'S') AND (:NEW.CONINT <>'N')) OR 
          (:NEW.CONINT IS NULL) OR 
          (:NEW.CONINT ='') OR 
          (:NEW.CONINT =' ') THEN            
          l_conint := 'N';      
      ELSE
          l_conint := :NEW.CONINT;          
      END IF;
                      
      IF (:NEW.TOLINT IS NULL) OR (:NEW.TOLINT ='') THEN
          l_tolint := 0;      
      ELSE
          l_tolint := :NEW.TOLINT;          
      END IF;

      IF (:NEW.GRACON IS NULL) OR (:NEW.GRACON ='') THEN
          l_gracon := 0;      
      ELSE
          l_gracon := :NEW.GRACON;          
      END IF;
                      
      IF ((:NEW.CONREA <> 'S') AND (:NEW.CONREA <>'N')) OR 
          (:NEW.CONREA IS NULL) OR 
          (:NEW.CONREA ='') OR 
          (:NEW.CONREA =' ') THEN                  
          l_conrea := 'N';      
      ELSE
          l_conrea := :NEW.CONREA;          
      END IF;

      IF ((:NEW.REPONL <> 'S') AND (:NEW.REPONL <>'N')) OR 
          (:NEW.REPONL IS NULL) OR 
          (:NEW.REPONL ='') OR 
          (:NEW.REPONL =' ') THEN                  
          l_reponl := 'N';      
      ELSE
          l_reponl := :NEW.REPONL;          
      END IF;

      IF ((:NEW.RECVIS <> 'S') AND (:NEW.RECVIS <>'N')) OR 
          (:NEW.RECVIS IS NULL) OR 
          (:NEW.RECVIS ='') OR 
          (:NEW.RECVIS =' ') THEN                  
          l_recvis := 'N';      
      ELSE
          l_recvis := :NEW.RECVIS;          
      END IF;

      IF ((:NEW.CONREE <> 'S') AND (:NEW.CONREE <>'N')) OR 
          (:NEW.CONREE IS NULL) OR 
          (:NEW.CONREE ='') OR 
          (:NEW.CONREE =' ') THEN                  
          l_conree := 'N';      
      ELSE
          l_conree := :NEW.CONREE;          
      END IF;
      
      IF (:NEW.USARFA = 'S') THEN
          l_usarfa := :NEW.USARFA;
      ELSE
          l_usarfa := 'N';
      END IF;
      /* final do controle das variáveis para não isnerir nulo */
       
      R034DAC_ATUCON(:NEW.TIPCOL,
                     :NEW.NUMEMP,
                     :NEW.NUMCAD,
                     l_codprm,
                     l_prmsab,
                     l_prmdom,
                     l_prmfer,
                     l_conadp,
                     l_conial,
                     l_temalm,
                     l_confai,
                     l_verprm,
                     l_concre,
                     l_dataso,
                     l_dattse,
                     l_verafa,
                     l_conpac,
                     l_tempac,
                     l_tolacp,
                     l_usabio,
                     l_conint,
                     l_tolint,
                     l_gracon,
                     l_conrea,
                     l_reponl,
                     l_recvis,
                     l_conree,
                     l_usarfa);

      /* Atualiza o campo Status Alfandegado no colaborador (ADE-02) */
      IF (l_codprm > 0 OR l_prmsab > 0 OR l_prmdom > 0 OR l_prmfer > 0) THEN
          SP_RECALF_GERPEN_1(:NEW.TIPCOL, l_ade_gerpen OUT);
          IF (l_ade_gerpen = TRUE) THEN
              SP_RECALF_PRMCOL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_codprm, l_prmsab, l_prmdom, l_prmfer, NULL, NULL, NULL, NULL, NULL, NULL);
          END IF;
      END IF;
  END IF;

  IF (:NEW.CODPRM IS NOT NULL AND :NEW.CODPRM > 0) THEN
      SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
      SP_INTSTR(:NEW.CODPRM, '99999', l_codprm_str OUT);
      l_idregister := l_idtpes || l_codprm_str;
      SP_SAM_PENDENCIES(41, 1, l_idregister);
  END IF;

  IF (:NEW.CONFAI IS NOT NULL AND :NEW.CONFAI > 0) THEN
      SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
      SP_SAM_PENDENCIES(42, 1, l_idtpes);
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R034DAC');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R034DAC_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,VERPRM,CODPRM,PRMFER,PRMSAB,PRMDOM,
                                   PRMVIS,CONFAI,CONADP,CONCRE,CONIAL,TEMALM,BLOFAL,RECVIS,AUTAGV,AUTASA,
                                   AUTEXT,USAFRO,GRACON,CONPAC,TEMPAC,TOLACP,USABIO,DATASO,DATTSE,AUTDBL,
                                   VERAFA,APRSOL,MONLOT,CONINT,TOLINT,INTBDC,DATINC,HORINC,STABDC,CONREA,
                                   UTICHV,REPONL,CONREE,USARFA)
                           VALUES (l_seqreg,l_verseq,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.VERPRM,
                                  :NEW.CODPRM,:NEW.PRMFER,:NEW.PRMSAB,:NEW.PRMDOM,:NEW.PRMVIS,:NEW.CONFAI,
                                  :NEW.CONADP,:NEW.CONCRE,:NEW.CONIAL,:NEW.TEMALM,:NEW.BLOFAL,:NEW.RECVIS,
                                  :NEW.AUTAGV,:NEW.AUTASA,:NEW.AUTEXT,:NEW.USAFRO,:NEW.GRACON,:NEW.CONPAC,
                                  :NEW.TEMPAC,:NEW.TOLACP,:NEW.USABIO,:NEW.DATASO,:NEW.DATTSE,:NEW.AUTDBL,
                                  :NEW.VERAFA,:NEW.APRSOL,:NEW.MONLOT,:NEW.CONINT,:NEW.TOLINT,:NEW.INTBDC,
                                  :NEW.DATINC,:NEW.HORINC,:NEW.STABDC,:NEW.CONREA,:NEW.UTICHV,:NEW.REPONL,
                                  :NEW.CONREE,:NEW.USARFA);

          SP_AUDGENREG(l_seqreg,l_verseq,'R034DAC','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀DÓ␀␀		SENIOR;06T␀␀

TRIGGER R034DAC_EU AFTER UPDATE ON R034DAC FOR EACH ROW

DECLARE
  l_altinfonl       BOOLEAN;
  l_online          BOOLEAN;
  l_altprm          BOOLEAN;
  l_alterou         BOOLEAN;
  l_camposAlterados VARCHAR(2000);
  l_verseq          NUMBER(10);
  l_seqreg          NUMBER(15);
  l_auditoria       CHAR(1);
  l_idtpes          CHAR(23);
  l_codprm_str      CHAR(5);
  l_idregister      CHAR(28);
  l_ade_gerpen      BOOLEAN;

/* variáveis para atualização da r070con */  
  l_codprm       NUMBER;
  l_prmsab       NUMBER;
  l_prmdom       NUMBER;
  l_prmfer       NUMBER;
  l_conadp       CHAR;
  l_conial       CHAR;
  l_temalm       NUMBER;
  l_confai       NUMBER;
  l_verprm       CHAR;
  l_concre       NUMBER;
  l_dataso       DATE;
  l_dattse       DATE;  
  l_verafa       CHAR;
  l_conpac       CHAR;
  l_tempac       NUMBER;
  l_tolacp       NUMBER;
  l_usabio       NUMBER;
  l_conint       CHAR;
  l_tolint       NUMBER;
  l_gracon       NUMBER;
  l_conrea       CHAR;
  l_reponl       CHAR;
  l_recvis       CHAR;
  l_conree       CHAR;
  l_usarfa       CHAR;
  /*****************************************/  
BEGIN
  /* Verifica se alterou alguma informação relevante ao acesso online */
  l_altinfonl := FALSE;
  IF   (:NEW.CONADP <> :OLD.CONADP)
  OR   (:NEW.CONIAL <> :OLD.CONIAL)
  OR   (:NEW.TEMALM <> :OLD.TEMALM)
  OR   (:NEW.CONFAI <> :OLD.CONFAI)
  OR   (:NEW.CONCRE <> :OLD.CONCRE)
  OR   (:NEW.VERPRM <> :OLD.VERPRM)
  OR   (:NEW.CODPRM <> :OLD.CODPRM)
  OR   (:NEW.PRMSAB <> :OLD.PRMSAB)
  OR   (:NEW.PRMDOM <> :OLD.PRMDOM)
  OR   (:NEW.PRMFER <> :OLD.PRMFER)
  OR   (:NEW.DATASO <> :OLD.DATASO)
  OR   (:NEW.DATTSE <> :OLD.DATTSE)
  OR   (:NEW.VERAFA <> :OLD.VERAFA)
  OR   (:NEW.CONPAC <> :OLD.CONPAC)
  OR   (:NEW.TEMPAC <> :OLD.TEMPAC)
  OR   (:NEW.TOLACP <> :OLD.TOLACP)
  OR   (:NEW.USABIO <> :OLD.USABIO)
  OR   (:NEW.CONINT <> :OLD.CONINT)
  OR   (:NEW.TOLINT <> :OLD.TOLINT)
  OR   (:NEW.GRACON <> :OLD.GRACON)
  OR   (:NEW.CONREA <> :OLD.CONREA)
  OR   (:NEW.REPONL <> :OLD.REPONL)
  OR   (:NEW.RECVIS <> :OLD.RECVIS)
  OR   (:NEW.CONREE <> :OLD.CONREE)
  OR   (:NEW.USARFA <> :OLD.USARFA)
  THEN
       l_altinfonl := TRUE;
  END IF;

  l_altprm := FALSE;
  IF   (:NEW.CODPRM <> :OLD.CODPRM)
  OR   (:NEW.PRMSAB <> :OLD.PRMSAB)
  OR   (:NEW.PRMDOM <> :OLD.PRMDOM)
  OR   (:NEW.PRMFER <> :OLD.PRMFER) THEN
       l_altprm := TRUE;
  END IF;

  IF   (l_altinfonl = TRUE) OR (l_altprm = TRUE) THEN
       SP_VerOnLine(l_online OUT);

       IF   (l_online = TRUE) THEN
       
		      /* garante que não joga valor nulo na R070CON*/
		      
		      IF (:NEW.CODPRM IS NULL) OR (:NEW.CODPRM ='') THEN
		          l_codprm := 0;      
		      ELSE
		          l_codprm := :NEW.CODPRM;          
		      END IF; 
		      
		      IF (:NEW.PRMSAB IS NULL) OR (:NEW.PRMSAB ='') THEN
		          l_prmsab := 0;      
		      ELSE
		          l_prmsab := :NEW.PRMSAB;          
		      END IF;
		      
		      IF (:NEW.PRMDOM IS NULL) OR (:NEW.PRMDOM ='') THEN
		          l_prmdom := 0;      
		      ELSE
		          l_prmdom := :NEW.PRMDOM;          
		      END IF;
		      
		      IF (:NEW.PRMFER IS NULL) OR (:NEW.PRMFER ='') THEN
		          l_prmfer := 0;      
		      ELSE
		          l_prmfer := :NEW.PRMFER;          
		      END IF;
		       
		      IF ((:NEW.CONADP <> 'S') AND (:NEW.CONADP <>'N')) OR 
		          (:NEW.CONADP IS NULL) OR 
		          (:NEW.CONADP ='') OR 
		          (:NEW.CONADP =' ') THEN
		          l_conadp := 'S';      
		      ELSE
		          l_conadp := :NEW.CONADP;          
		      END IF;
		
		      IF ((:NEW.CONIAL <> 'S') AND (:NEW.CONIAL <>'N')) OR 
		          (:NEW.CONIAL IS NULL) OR 
		          (:NEW.CONIAL ='') OR 
		          (:NEW.CONIAL =' ') THEN
		          l_conial := 'N';      
		      ELSE
		          l_conial := :NEW.CONIAL;          
		      END IF;
		
		      IF (:NEW.TEMALM IS NULL) OR (:NEW.TEMALM ='') THEN
		          l_temalm := 0;      
		      ELSE
		          l_temalm := :NEW.TEMALM;          
		      END IF;
		                                            
		      IF (:NEW.CONFAI IS NULL) OR (:NEW.CONFAI > 3) THEN
		          l_confai := 0;      
		      ELSE
		          l_confai := :NEW.CONFAI;          
		      END IF;
		
		      IF ((:NEW.VERPRM <> 'S') AND (:NEW.VERPRM <>'N')) OR 
		          (:NEW.VERPRM IS NULL) OR 
		          (:NEW.VERPRM ='') OR 
		          (:NEW.VERPRM =' ') THEN
		          l_verprm := 'S';      
		      ELSE
		          l_verprm := :NEW.VERPRM;          
		      END IF;
		
		      IF (:NEW.CONCRE IS NULL) OR (:NEW.CONCRE > 4) THEN
		          l_concre := 0;      
		      ELSE
		          l_concre := :NEW.CONCRE;          
		      END IF;
		                                            
		      IF (:NEW.DATASO IS NULL)  THEN
		          l_dataso := '31/12/1900,00:00:00';      
		      ELSE
		          l_dataso := :NEW.DATASO;          
		      END IF;
		
		      IF (:NEW.DATTSE IS NULL)  THEN
		          l_dattse := '31/12/1900,00:00:00';      
		      ELSE
		          l_dattse := :NEW.DATTSE;          
		      END IF;
		                   
		      IF ((:NEW.VERAFA <> 'S') AND (:NEW.VERAFA <>'N')) OR 
		          (:NEW.VERAFA IS NULL) OR 
		          (:NEW.VERAFA ='') OR 
		          (:NEW.VERAFA =' ') THEN     
		          l_verafa := 'S';      
		      ELSE
		          l_verafa := :NEW.VERAFA;          
		      END IF;
		                   
		      IF ((:NEW.CONPAC <> 'S') AND (:NEW.CONPAC <>'N')) OR 
		          (:NEW.CONPAC IS NULL) OR 
		          (:NEW.CONPAC ='') OR 
		          (:NEW.CONPAC =' ') THEN      
		          l_conpac := 'N';      
		      ELSE
		          l_conpac := :NEW.CONPAC;          
		      END IF;
		      
		      IF (:NEW.TEMPAC IS NULL) OR (:NEW.TEMPAC ='') THEN
		          l_tempac := 0;      
		      ELSE
		          l_tempac := :NEW.TEMPAC;          
		      END IF;
		      
		      IF (:NEW.TOLACP IS NULL) OR (:NEW.TOLACP ='') THEN
		          l_tolacp := 0;      
		      ELSE
		          l_tolacp := :NEW.TOLACP;          
		      END IF;
		
		      IF (:NEW.USABIO IS NULL) OR (:NEW.USABIO = 0) OR (:NEW.USABIO > 3) THEN
		          l_usabio := 1;      
		      ELSE
		          l_usabio := :NEW.USABIO;          
		      END IF;
		                            
		      IF ((:NEW.CONINT <> 'S') AND (:NEW.CONINT <>'N')) OR 
		          (:NEW.CONINT IS NULL) OR 
		          (:NEW.CONINT ='') OR 
		          (:NEW.CONINT =' ') THEN            
		          l_conint := 'N';      
		      ELSE
		          l_conint := :NEW.CONINT;          
		      END IF;
		                      
		      IF (:NEW.TOLINT IS NULL) OR (:NEW.TOLINT ='') THEN
		          l_tolint := 0;      
		      ELSE
		          l_tolint := :NEW.TOLINT;          
		      END IF;
		
		      IF (:NEW.GRACON IS NULL) OR (:NEW.GRACON ='') THEN
		          l_gracon := 0;      
		      ELSE
		          l_gracon := :NEW.GRACON;          
		      END IF;
		                      
		      IF ((:NEW.CONREA <> 'S') AND (:NEW.CONREA <>'N')) OR 
		          (:NEW.CONREA IS NULL) OR 
		          (:NEW.CONREA ='') OR 
		          (:NEW.CONREA =' ') THEN                  
		          l_conrea := 'N';      
		      ELSE
		          l_conrea := :NEW.CONREA;          
		      END IF;
		
		      IF ((:NEW.REPONL <> 'S') AND (:NEW.REPONL <>'N')) OR 
		          (:NEW.REPONL IS NULL) OR 
		          (:NEW.REPONL ='') OR 
		          (:NEW.REPONL =' ') THEN                  
		          l_reponl := 'N';      
		      ELSE
		          l_reponl := :NEW.REPONL;          
		      END IF;
		
		      IF ((:NEW.RECVIS <> 'S') AND (:NEW.RECVIS <>'N')) OR 
		          (:NEW.RECVIS IS NULL) OR 
		          (:NEW.RECVIS ='') OR 
		          (:NEW.RECVIS =' ') THEN                  
		          l_recvis := 'N';      
		      ELSE
		          l_recvis := :NEW.RECVIS;          
		      END IF;
		
		      IF ((:NEW.CONREE <> 'S') AND (:NEW.CONREE <>'N')) OR 
		          (:NEW.CONREE IS NULL) OR 
		          (:NEW.CONREE ='') OR 
		          (:NEW.CONREE =' ') THEN                  
		          l_conree := 'N';      
		      ELSE
		          l_conree := :NEW.CONREE;          
		      END IF;

              IF (:NEW.USARFA = 'S') THEN
                  l_usarfa := :NEW.USARFA;
              ELSE
                  l_usarfa := 'N';
              END IF;
		      /* final do controle das variáveis para não isnerir nulo */
       
              R034DAC_ATUCON(:NEW.TIPCOL,
                             :NEW.NUMEMP,
                             :NEW.NUMCAD,
  	                          l_codprm,
		                      l_prmsab,
		                      l_prmdom,
		                      l_prmfer,
		                      l_conadp,
		                      l_conial,
  		                      l_temalm,
	 	                      l_confai,
		                      l_verprm,
		                      l_concre,
 		                      l_dataso,
		                      l_dattse,
		                      l_verafa,
		                      l_conpac,
		                      l_tempac,
		                      l_tolacp,
		                      l_usabio,
		                      l_conint,
		                      l_tolint,
		                      l_gracon,
		                      l_conrea,
		                      l_reponl,
		                      l_recvis,
		                      l_conree,
		                      l_usarfa);
              
              /* Caso ganhou, perdeu ou trocou alguma permissão, verifica se deve gerar pendência para ADE02 e */
              /* atualizar o campo Status Alfandegado no colaborador (ADE-02). */
              IF (((:OLD.CODPRM IS NULL AND :NEW.CODPRM > 0) OR (:OLD.CODPRM IS NOT NULL AND :NEW.CODPRM IS NULL) OR :NEW.CODPRM <> :OLD.CODPRM) OR
                  ((:OLD.PRMSAB IS NULL AND :NEW.PRMSAB > 0) OR (:OLD.PRMSAB IS NOT NULL AND :NEW.PRMSAB IS NULL) OR :NEW.PRMSAB <> :OLD.PRMSAB) OR
                  ((:OLD.PRMDOM IS NULL AND :NEW.PRMDOM > 0) OR (:OLD.PRMDOM IS NOT NULL AND :NEW.PRMDOM IS NULL) OR :NEW.PRMDOM <> :OLD.PRMDOM) OR
                  ((:OLD.PRMFER IS NULL AND :NEW.PRMFER > 0) OR (:OLD.PRMFER IS NOT NULL AND :NEW.PRMFER IS NULL) OR :NEW.PRMFER <> :OLD.PRMFER)) THEN

                  l_codprm := :NEW.CODPRM;
                  l_prmsab := :NEW.PRMSAB;
                  l_prmdom := :NEW.PRMDOM;
                  l_prmfer := :NEW.PRMFER;

                  /* Verifica se tem troca de permissão ativa. Se tiver, envia as permissões da troca. */
                  BEGIN
                      SELECT CODPRM, PRMSAB, PRMDOM, PRMFER 
                      INTO l_codprm, l_prmsab, l_prmdom, l_prmfer
                      FROM R064TPE
                      WHERE STAACC = 1 AND NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
                  EXCEPTION
                      WHEN OTHERS THEN NULL;
                  END;

                  SP_RECALF_GERPEN_1(:NEW.TIPCOL, l_ade_gerpen OUT);
                  IF (l_ade_gerpen = TRUE) THEN
                      SP_RECALF_PRMCOL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_codprm, l_prmsab, l_prmdom, l_prmfer, NULL, NULL, NULL, NULL, NULL, NULL);
                  END IF;
              END IF;
       END IF;
  END IF;

  IF ((:OLD.CODPRM IS NULL AND :NEW.CODPRM IS NOT NULL) OR (:OLD.CODPRM <> :NEW.CODPRM)) THEN
      SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
      
      IF (:NEW.CODPRM IS NOT NULL) THEN
          SP_INTSTR(:NEW.CODPRM, '99999', l_codprm_str OUT);
      ELSE
          l_codprm_str := '00000';
      END IF;
      
      l_idregister := l_idtpes || l_codprm_str;
      SP_SAM_PENDENCIES(41, 2, l_idregister);
  END IF;

  IF ((:OLD.CONFAI IS NULL AND :NEW.CONFAI IS NOT NULL AND :NEW.CONFAI > 0) OR (:OLD.CONFAI <> :NEW.CONFAI AND :OLD.CONFAI = 0)) THEN
      SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
      SP_SAM_PENDENCIES(42, 1, l_idtpes);
  END IF;

  IF (:OLD.CONFAI <> :NEW.CONFAI AND :NEW.CONFAI = 0) THEN
      SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
      SP_SAM_PENDENCIES(42, 3, l_idtpes);
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R034DAC');

  IF (l_auditoria = 'S') THEN

       l_camposAlterados := 'Campo(s) alterado(s): ';
       l_alterou := FALSE;

      IF (:NEW.NUMEMP <> :OLD.NUMEMP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMEMP ';
      END IF;

      IF (:NEW.TIPCOL <> :OLD.TIPCOL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPCOL ';
      END IF;

      IF (:NEW.NUMCAD <> :OLD.NUMCAD) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCAD ';
      END IF;

      IF (:NEW.VERPRM <> :OLD.VERPRM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'VERPRM ';
      END IF;

      IF (:NEW.CODPRM <> :OLD.CODPRM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPRM ';
      END IF;

      IF (:NEW.PRMFER <> :OLD.PRMFER) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PRMFER ';
      END IF;

      IF (:NEW.PRMSAB <> :OLD.PRMSAB) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PRMSAB ';
      END IF;

      IF (:NEW.PRMDOM <> :OLD.PRMDOM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PRMDOM ';
      END IF;

      IF (:NEW.PRMVIS <> :OLD.PRMVIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PRMVIS ';
      END IF;

      IF (:NEW.CONFAI <> :OLD.CONFAI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CONFAI ';
      END IF;

      IF (:NEW.CONADP <> :OLD.CONADP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CONADP ';
      END IF;

      IF (:NEW.CONCRE <> :OLD.CONCRE) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CONCRE ';
      END IF;

      IF (:NEW.CONIAL <> :OLD.CONIAL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CONIAL ';
      END IF;

      IF (:NEW.TEMALM <> :OLD.TEMALM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TEMALM ';
      END IF;

      IF (:NEW.BLOFAL <> :OLD.BLOFAL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'BLOFAL ';
      END IF;

      IF (:NEW.RECVIS <> :OLD.RECVIS) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'RECVIS ';
      END IF;

      IF (:NEW.AUTAGV <> :OLD.AUTAGV) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'AUTAGV ';
      END IF;

      IF (:NEW.AUTASA <> :OLD.AUTASA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'AUTASA ';
      END IF;

      IF (:NEW.AUTEXT <> :OLD.AUTEXT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'AUTEXT ';
      END IF;

      IF (:NEW.USAFRO <> :OLD.USAFRO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'USAFRO ';
      END IF;

      IF (:NEW.GRACON <> :OLD.GRACON) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'GRACON ';
      END IF;

      IF (:NEW.CONPAC <> :OLD.CONPAC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CONPAC ';
      END IF;

      IF (:NEW.TEMPAC <> :OLD.TEMPAC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TEMPAC ';
      END IF;

      IF (:NEW.TOLACP <> :OLD.TOLACP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TOLACP ';
      END IF;

      IF (:NEW.USABIO <> :OLD.USABIO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'USABIO ';
      END IF;

      IF (:NEW.DATASO <> :OLD.DATASO) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATASO ';
      END IF;

      IF (:NEW.DATTSE <> :OLD.DATTSE) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATTSE ';
      END IF;

      IF (:NEW.AUTDBL <> :OLD.AUTDBL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'AUTDBL ';
      END IF;

      IF (:NEW.VERAFA <> :OLD.VERAFA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'VERAFA ';
      END IF;

      IF (:NEW.APRSOL <> :OLD.APRSOL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'APRSOL ';
      END IF;

      IF (:NEW.MONLOT <> :OLD.MONLOT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'MONLOT ';
      END IF;

      IF (:NEW.CONINT <> :OLD.CONINT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CONINT ';
      END IF;

      IF (:NEW.TOLINT <> :OLD.TOLINT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TOLINT ';
      END IF;

      IF (:NEW.INTBDC <> :OLD.INTBDC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'INTBDC ';
      END IF;

      IF (:NEW.DATINC <> :OLD.DATINC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATINC ';
      END IF;

      IF (:NEW.HORINC <> :OLD.HORINC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORINC ';
      END IF;

      IF (:NEW.STABDC <> :OLD.STABDC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'STABDC ';
      END IF;

      IF (:NEW.CONREA <> :OLD.CONREA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CONREA ';
      END IF;

      IF (:NEW.UTICHV <> :OLD.UTICHV) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'UTICHV ';
      END IF;

      IF (:NEW.REPONL <> :OLD.REPONL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'REPONL ';
      END IF;

      IF (:NEW.CONREE <> :OLD.CONREE) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CONREE ';
      END IF;
      
      IF (:NEW.USARFA <> :OLD.USARFA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'USARFA ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R034DAC_AUD
                   WHERE NUMEMP = :OLD.NUMEMP AND
                         TIPCOL = :OLD.TIPCOL AND
                         NUMCAD = :OLD.NUMCAD;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R034DAC_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,VERPRM,CODPRM,PRMFER,PRMSAB,PRMDOM,
                                       PRMVIS,CONFAI,CONADP,CONCRE,CONIAL,TEMALM,BLOFAL,RECVIS,AUTAGV,AUTASA,
                                       AUTEXT,USAFRO,GRACON,CONPAC,TEMPAC,TOLACP,USABIO,DATASO,DATTSE,AUTDBL,
                                       VERAFA,APRSOL,MONLOT,CONINT,TOLINT,INTBDC,DATINC,HORINC,STABDC,CONREA,
                                       UTICHV,REPONL,CONREE,USARFA)
                               VALUES (l_seqreg,l_verseq,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.VERPRM,
                                      :NEW.CODPRM,:NEW.PRMFER,:NEW.PRMSAB,:NEW.PRMDOM,:NEW.PRMVIS,:NEW.CONFAI,
                                      :NEW.CONADP,:NEW.CONCRE,:NEW.CONIAL,:NEW.TEMALM,:NEW.BLOFAL,:NEW.RECVIS,
                                      :NEW.AUTAGV,:NEW.AUTASA,:NEW.AUTEXT,:NEW.USAFRO,:NEW.GRACON,:NEW.CONPAC,
                                      :NEW.TEMPAC,:NEW.TOLACP,:NEW.USABIO,:NEW.DATASO,:NEW.DATTSE,:NEW.AUTDBL,
                                      :NEW.VERAFA,:NEW.APRSOL,:NEW.MONLOT,:NEW.CONINT,:NEW.TOLINT,:NEW.INTBDC,
                                      :NEW.DATINC,:NEW.HORINC,:NEW.STABDC,:NEW.CONREA,:NEW.UTICHV,:NEW.REPONL,
                                      :NEW.CONREE,:NEW.USARFA);

              SP_AUDGENREG(l_seqreg,l_verseq,'R034DAC',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀BÓ␀␀		SENIOR;0C␀␀

TRIGGER R034DAC_ED AFTER DELETE ON R034DAC FOR EACH ROW

DECLARE
  l_verseq     NUMBER(10);
  l_seqreg     NUMBER(15);
  l_auditoria  CHAR(1);
  l_idtpes     CHAR(23);
  l_codprm_str CHAR(5);
  l_idregister CHAR(28);
  l_ade_gerpen BOOLEAN;
BEGIN
  IF (:OLD.CODPRM IS NOT NULL AND :OLD.CODPRM > 0) THEN
      SP_RETIDTPES(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, 0, '', '', '', l_idtpes OUT);
      SP_INTSTR(:OLD.CODPRM, '99999', l_codprm_str OUT);
      l_idregister := l_idtpes || l_codprm_str;
      SP_SAM_PENDENCIES(41, 3, l_idregister);
  END IF;
  
  IF (:OLD.CONFAI IS NOT NULL AND :OLD.CONFAI > 0) THEN
      SP_RETIDTPES(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, 0, '', '', '', l_idtpes OUT);
      SP_SAM_PENDENCIES(42, 3, l_idtpes);
  END IF;

  /* Atualiza o campo Status Alfandegado no colaborador (ADE-02) */
  /* Garanto para que o status não permaneça como 2 - Ativo, pois o vínculo com as permissões foi excluído */
  SP_RECALF_GERPEN_1(:OLD.TIPCOL, l_ade_gerpen OUT);
  IF (l_ade_gerpen = TRUE) THEN
      SP_RECALF_E_CRACOL(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD);
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R034DAC');  

  IF (l_auditoria = 'S') THEN
      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg
                FROM R034DAC_AUD
               WHERE NUMEMP = :OLD.NUMEMP AND
                     TIPCOL = :OLD.TIPCOL AND
                     NUMCAD = :OLD.NUMCAD;
           EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
          INSERT INTO R034DAC_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,VERPRM,CODPRM,PRMFER,PRMSAB,PRMDOM,
                                   PRMVIS,CONFAI,CONADP,CONCRE,CONIAL,TEMALM,BLOFAL,RECVIS,AUTAGV,AUTASA,
                                   AUTEXT,USAFRO,GRACON,CONPAC,TEMPAC,TOLACP,USABIO,DATASO,DATTSE,AUTDBL,
                                   VERAFA,APRSOL,MONLOT,CONINT,TOLINT,INTBDC,DATINC,HORINC,STABDC,CONREA,
                                   UTICHV,REPONL,CONREE,USARFA)
                           VALUES (l_seqreg,l_verseq,:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.VERPRM,
                                  :OLD.CODPRM,:OLD.PRMFER,:OLD.PRMSAB,:OLD.PRMDOM,:OLD.PRMVIS,:OLD.CONFAI,
                                  :OLD.CONADP,:OLD.CONCRE,:OLD.CONIAL,:OLD.TEMALM,:OLD.BLOFAL,:OLD.RECVIS,
                                  :OLD.AUTAGV,:OLD.AUTASA,:OLD.AUTEXT,:OLD.USAFRO,:OLD.GRACON,:OLD.CONPAC,
                                  :OLD.TEMPAC,:OLD.TOLACP,:OLD.USABIO,:OLD.DATASO,:OLD.DATTSE,:OLD.AUTDBL,
                                  :OLD.VERAFA,:OLD.APRSOL,:OLD.MONLOT,:OLD.CONINT,:OLD.TOLINT,:OLD.INTBDC,
                                  :OLD.DATINC,:OLD.HORINC,:OLD.STABDC,:OLD.CONREA,:OLD.UTICHV,:OLD.REPONL,
                                  :OLD.CONREE,:OLD.USARFA);

          SP_AUDGENREG(l_seqreg,l_verseq,'R034DAC','DELETE');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀␀␀öR␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀AÓ␀␀ş␀␀¢␀	„␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀­%␀‹␀	„␀␀␀␀␀(&␀|%␀&␀a␀Æÿ␀␀ÿ␀…¬␀␀´␀	„␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t	„␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀	„␀␀␀␀␀œ$€$€$w␀Æÿ␀␀ÿ␀¦%␀=␀␀␀␀␀␀ä%␀{%␀Ï%␀c␀␀␀ÿ␀␀ÿ␀C-·␀␀␀␀␀␀␀À¿␀␀£¿␀␀£¿␀␀t␀Æÿ␀␀ÿ␀Æ␀␀·␀␀␀␀␀␀␀Â¿␀␀¨¿␀␀©¿␀␀t␀Æÿ␀␀ÿ␀Æ␀␀·␀␀␀␀␀␀␀Ã¿␀␀±¿␀␀²¿␀␀t␀Æÿ␀␀ÿ␀Æ␀␀·␀␀␀␀␀␀␀Á¿␀␀¥¿␀␀¦¿␀␀t␀Æÿ␀␀ÿ␀Æ␀␀·␀␀␀␀␀␀␀¾¿␀␀µ¿␀␀É¿␀␀t␀Æÿ␀␀ÿ␀~1(␀␀␀␀␀␀g6lf6n␀Æÿ␀␀ÿ␀D1=␀␀␀␀␀␀{6 ¯␀␀{6c␀␀␀ÿ␀␀ÿ␀f1␀␀␀␀␀␀\6V6X6n␀Æÿ␀␀ÿ␀—1=␀␀␀␀␀␀t6q6s6c␀␀␀ÿ␀␀ÿ␀¿	␀±␀␀␀␀␀␀␀6
