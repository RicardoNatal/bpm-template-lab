²␀␀ı+␀,␀n␀Æÿ␀␀ÿ␀8–␀„␀␀␀␀␀␀²␀␀û+␀␀,␀n␀Æÿ␀␀ÿ␀␀␀␀␀␀␀õ¬␀␀␀␀␀␀␀␀␀?Ú␀␀…¬␀␀´␀	„␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀c¬␀␀Ì␀	„␀␀␀␀␀B%€$€$w␀Æÿ␀␀DÚ␀␀␀d§␀␀U„␀␀␀␀␀…ª␀␀ç§␀␀ç§␀␀V␀␀ÿ␀␀ÿ␀Ş␀´␀␀␀␀␀␀␀>½␀␀r␀Æÿ␀␀YĞ␀␀␀§¬␀␀Ì␀␀␀␀␀␀␀Ôš␀␀€š␀␀€š␀␀m␀Æÿ␀␀aĞ␀␀␀C-·␀␀␀␀␀␀␀„=¿␀␀¿␀␀t␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀␀␀␀␀␀␀Â¿␀␀¨¿␀␀©¿␀␀t␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀␀␀␀␀␀␀Ã¿␀␀±¿␀␀²¿␀␀t␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀␀␀␀␀␀␀Á¿␀␀¥¿␀␀¦¿␀␀t␀Æÿ␀␀ı×␀␀␀\ë␀␀␀␀␀␀␀Ê␀`␀É␀n␀Æÿ␀␀ÿ␀b´␀␀␀␀␀␀␀£<¬bébr␀Æÿ␀␀Ò␀␀␀êm¼␀␀␀␀␀␀␀=5n=nX)␀␀Æÿ␀␀!#␀y,Ì␀␀␀␀␀␀␀í<œeœe)␀␀Æÿ␀␀ÀÎ␀␀␀Â-Š␀␀␀␀␀␀␀)>Ì␀Ì␀n␀Æÿ␀␀éÎ␀␀␀~1(␀␀␀␀␀␀g6lf6n␀Æÿ␀␀ÿ␀œpÒ␀␀␀␀␀␀␀¸p£p£pÿ␀ÿÿ␀␀ÿ␀␀=„␀␀␀␀␀°Â␀␀°Â␀␀°Â␀␀c␀␀␀ÿ␀␀ÿSëDÑ␀„␀␀␀␀␀“I,G“IqC␀êÿ␀␀ÿ␀’w·␀„␀␀␀␀␀y]xyì*␀␀Æÿ␀␀ÿ␀›␀=„␀␀␀␀␀‡␀…␀‡␀c␀␀␀ÿ␀␀ÿN␀␀␀0;1BÚ␀␀		SENIOR;0o␀␀

TRIGGER R070OCR_EI AFTER INSERT ON R070OCR FOR EACH ROW
DECLARE
l_online     BOOLEAN;
  l_datatu     DATE;
  l_datfim     DATE;
  l_tem_escala BOOLEAN;
  l_uticcr     CHAR(1);
  l_idtpes     VARCHAR2(23);
  l_tippes     CHAR(2);
  l_numemp     CHAR(4);
  l_numcad     CHAR(10);
  l_verplf     NUMBER(3);
  l_data_atual DATE;
  l_data_zero  DATE;

 /* CURSOR que busca os créditos de acesso outras unidades com escala. */
 CURSOR c_R070DCA IS
        SELECT INIFAI,FIMFAI,CREDIA,LIMCON,VERPLF,CODPLF FROM R070DCA WHERE
               NUMEMP = :NEW.NUMEMP AND CODESC = :NEW.CODESC AND TIPPES = 5;
 TYPE t_R070DCA IS RECORD(
    INIFAI   R070DCA.INIFAI%TYPE,
    FIMFAI   R070DCA.FIMFAI%TYPE,
    CREDIA   R070DCA.CREDIA%TYPE,
    LIMCON   R070DCA.LIMCON%TYPE,
    VERPLF   R070DCA.VERPLF%TYPE,
    CODPLF   R070DCA.CODPLF%TYPE);
 l_r070DCA t_R070DCA;

  /* CURSOR que busca os créditos de acesso outras unidades sem escala. */
 CURSOR c_R070DCA_2 IS
        SELECT INIFAI,FIMFAI,CREDIA,LIMCON,VERPLF,CODPLF FROM R070DCA WHERE
               NUMEMP = :NEW.NUMEMP AND CODESC = 0 AND TIPPES = 5;
 TYPE t_R070DCA_2 IS RECORD(
    INIFAI   R070DCA.INIFAI%TYPE,
    FIMFAI   R070DCA.FIMFAI%TYPE,
    CREDIA   R070DCA.CREDIA%TYPE,
    LIMCON   R070DCA.LIMCON%TYPE,
    VERPLF   R070DCA.VERPLF%TYPE,
    CODPLF   R070DCA.CODPLF%TYPE);
 l_r070DCA_2 t_R070DCA_2;

BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN

      /*Se utilizar a rotina de compra de créditos, não deve prosseguir com a geração automática de créditos*/
      BEGIN
          SELECT UTICCR INTO l_uticcr FROM R070DAC;
      EXCEPTION
          WHEN OTHERS THEN l_uticcr := 'N';
      END;

      IF (l_uticcr <> 'S') OR (l_uticcr IS NULL) THEN

          l_datatu := CURDATE();
          l_datfim := '31/12/1900,00:00:00';
          l_tem_escala := FALSE;
          FOREACH c_r070dca INTO  l_r070dca.IniFai,
                                  l_r070dca.FimFai,
                                  l_r070dca.CreDia,
                                  l_r070dca.LimCon,
                                  l_r070dca.VerPlf,
                                  l_r070dca.CodPlf
          LOOP
              l_tem_escala := TRUE;
              INSERT INTO R070CRO (NUMEMP,NUMCAD,DATINI,DATFIM,INIFAI,FIMFAI,CREDIA,SALATU,STAACC,LIMCON,VERPLF,CODPLF,QTDCON,DATCON)
                          VALUES  (:NEW.NUMEMP,:NEW.NUMCAD,l_datatu,l_datfim,l_r070dca.IniFai,
                                   l_r070dca.FimFai,l_r070dca.CreDia,l_r070dca.CreDia,1,
                                   l_r070dca.LimCon,l_r070dca.VerPlf,l_r070dca.CodPlf,0,l_data_zero);
          END LOOP;

          /* se não encontrou nenhum registro no CURSOR com escala. procura os registros com escala zero*/
          IF  (l_tem_escala = FALSE) THEN
              FOREACH c_r070dca_2 INTO l_r070dca_2.IniFai,
                                       l_r070dca_2.FimFai,
                                       l_r070dca_2.CreDia,
                                       l_r070dca_2.LimCon,
                                       l_r070dca_2.VerPlf,
                                       l_r070dca_2.CodPlf
              LOOP
                  INSERT INTO R070CRO (NUMEMP,NUMCAD,DATINI,DATFIM,INIFAI,FIMFAI,CREDIA,SALATU,STAACC,LIMCON,VERPLF,CODPLF,QTDCON,DATCON)
                              VALUES  (:NEW.NUMEMP,:NEW.NUMCAD,l_datatu,l_datfim,l_r070dca_2.IniFai,
                                       l_r070dca_2.FimFai,l_r070dca_2.CreDia,l_r070dca_2.CreDia,1,
                                       l_r070dca_2.LimCon,l_r070dca_2.VerPlf,l_r070dca_2.CodPlf,0,l_data_zero);
              END LOOP;
          END IF;
          /*Atualiza os créditos por local e sem local*/

          /*Busca versão do plano ativa*/
          BEGIN
              SELECT VERPLF INTO l_verplf
                FROM R058VPL
               WHERE DATCRI <= l_data_atual
                 AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
          EXCEPTION
              WHEN OTHERS THEN
                  l_verplf := 1;
          END;

          l_tippes:= '05';
          SP_INTSTR(:NEW.NUMEMP,'9999',l_numemp OUT);
          SP_INTSTR(:NEW.NUMCAD,'999999999',l_numcad OUT);
          l_idtpes:= l_tippes||l_numemp||l_numcad;
          /*Preenche o campo com espaços para completar 23 posições*/
          l_idtpes := lTrim(l_idtpes);
          l_idtpes := rTrim(l_idtpes);
          LOOP
             /*Controle do Loop.*/
             IF (Length(l_idtpes) > 22) THEN
                 EXIT;
             END IF;
             l_idtpes := ' '||l_idtpes;
          END LOOP;
          /*POR LOCAL*/
          SP_ATUCRELOC(l_idtpes);
          /*SEM LOCAL*/
          SP_CRECON(5, :NEW.NUMEMP, 0, :NEW.NUMCAD, 0, '0', '0', '0', l_verplf, 0);
      END IF;
  END IF;
END␀CÚ␀␀		SENIOR;0£␀␀


TRIGGER R070OCR_EU AFTER UPDATE ON R070OCR FOR EACH ROW
DECLARE
  l_online       BOOLEAN;
  l_IDTPES       VARCHAR(23);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) THEN
     IF   (:NEW.CODESC <> :OLD.CODESC)
     OR   (:NEW.CODTMA <> :OLD.CODTMA)  THEN
           R070OCR_ATUCON (:NEW.NUMEMP,:NEW.NUMCAD,:NEW.CODPRM,:NEW.PRMFER,:NEW.PRMSAB,:NEW.PRMDOM,
                           :NEW.ACEOCR,:NEW.CODESC,:NEW.CODTMA,:NEW.CONFAI,:NEW.NOMCRA,:NEW.USARFA);
     ELSIF  (:NEW.CODPRM <> :OLD.CODPRM) OR (:NEW.PRMFER <> :OLD.PRMFER) OR (:NEW.PRMSAB <> :OLD.PRMSAB) OR
            (:NEW.PRMDOM <> :OLD.PRMDOM) OR (:NEW.ACEOCR <> :OLD.ACEOCR) OR (:NEW.CONFAI <> :OLD.CONFAI) OR (:NEW.NOMCRA <> :OLD.NOMCRA) OR (:NEW.USARFA <> :OLD.USARFA) THEN
            R070OCR_ATUCON (:NEW.NUMEMP,:NEW.NUMCAD,:NEW.CODPRM,:NEW.PRMFER,:NEW.PRMSAB,:NEW.PRMDOM,:NEW.ACEOCR,0,0,:NEW.CONFAI,:NEW.NOMCRA,:NEW.USARFA);
     END IF;
  END IF;

  SP_RETIDTPES(:NEW.NUMEMP, 5, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_IDTPES OUT);

  IF (:NEW.NOMCRA <> :OLD.NOMCRA) THEN
      /* ATUALIZAÇÃO DO NOME NA TABELA R158PES */
      SP_ATUNOMPES(l_IDTPES, :NEW.NOMCRA);
  END IF;
END		SENIOR;20q␀␀TRIGGER R070OCR_EU AFTER UPDATE ON R070OCR FOR EACH ROW
DECLARE
  l_online       BOOLEAN;
  l_IDTPES       VARCHAR(23);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) THEN
     IF   (:NEW.CODESC <> :OLD.CODESC)
     OR   (:NEW.CODTMA <> :OLD.CODTMA)  THEN
           R070OCR_ATUCON (:NEW.NUMEMP,:NEW.NUMCAD,:NEW.CODPRM,:NEW.PRMFER,:NEW.PRMSAB,:NEW.PRMDOM,
                           :NEW.ACEOCR,:NEW.CODESC,:NEW.CODTMA,:NEW.CONFAI,:NEW.NOMCRA,:NEW.USARFA);
     ELSIF  (:NEW.CODPRM <> :OLD.CODPRM) OR (:NEW.PRMFER <> :OLD.PRMFER) OR (:NEW.PRMSAB <> :OLD.PRMSAB) OR
            (:NEW.PRMDOM <> :OLD.PRMDOM) OR (:NEW.ACEOCR <> :OLD.ACEOCR) OR (:NEW.CONFAI <> :OLD.CONFAI) OR (:NEW.NOMCRA <> :OLD.NOMCRA) OR (:NEW.USARFA <> :OLD.USARFA) THEN
            R070OCR_ATUCON (:NEW.NUMEMP,:NEW.NUMCAD,:NEW.CODPRM,:NEW.PRMFER,:NEW.PRMSAB,:NEW.PRMDOM,:NEW.ACEOCR,0,0,:NEW.CONFAI,:NEW.NOMCRA,:NEW.USARFA);
     END IF;
  END IF;

  SP_RETIDTPES(:NEW.NUMEMP, 5, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_IDTPES OUT);

  IF (:NEW.NOMCRA <> :OLD.NOMCRA) THEN
      /* ATUALIZAÇÃO DO NOME NA TABELA R158PES */
      SP_ATUNOMPES(l_IDTPES, :NEW.NOMCRA);
  END IF;

  IF (:OLD.FOTOCR IS NOT NULL AND :NEW.FOTOCR IS NULL) THEN
      /* Gera pendência para remover a foto da concentradora. Isto devido a exclusão da foto via LGPD. */
      SP_PEND82(l_IDTPES, 3);
  END IF;
