TRIGGER R034USU_EI AFTER INSERT ON R034USU FOR EACH ROW
DECLARE
  l_idtpes   VARCHAR2(23);
  l_codusu   VARCHAR2(10);
  l_valstr   VARCHAR2(33);
BEGIN
  SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_IDTPES OUT);
