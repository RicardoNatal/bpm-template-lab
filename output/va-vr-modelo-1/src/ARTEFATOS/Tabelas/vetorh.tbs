DECLARE
  l_temAud       BOOLEAN;
  l_codRpa       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

	l_codSistema := 1;
	l_codcpa := 126;
	l_codtpa := 383;
	/* INSERT (NEW) */ 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R111VAC_EI', '');

      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIC));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODREM', CONVERT(NUMBER_TO_CHAR, :NEW.CODREM));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATSOL', CONVERT(DATE_TO_CHAR, :NEW.DATSOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQDOS', CONVERT(NUMBER_TO_CHAR, :NEW.SEQDOS));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R111VAC_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      
      BEGIN
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAPL', CONVERT(DATE_TO_CHAR, :NEW.DATAPL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATVEN', CONVERT(DATE_TO_CHAR, :NEW.DATVEN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR, :NEW.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSVAC', :NEW.OBSVAC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR, :NEW.CODUSU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITVAC', CONVERT(NUMBER_TO_CHAR, :NEW.SITVAC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAM', CONVERT(NUMBER_TO_CHAR, :NEW.CODCAM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQCAM', CONVERT(NUMBER_TO_CHAR, :NEW.SEQCAM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', CONVERT(DATE_TO_CHAR, :NEW.DATATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR, :NEW.HORATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMVAC', CONVERT(NUMBER_TO_CHAR, :NEW.NUMVAC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDAPL', CONVERT(NUMBER_TO_CHAR, :NEW.QTDAPL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPOS', CONVERT(NUMBER_TO_CHAR, :NEW.CODPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDELOT', :NEW.IDELOT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMREC', CONVERT(NUMBER_TO_CHAR, :NEW.NUMREC));
      END;
  END IF; 
END␀½ß␀␀		SENIOR;0ƒ␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R111VAC_EU AFTER UPDATE ON R111VAC FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  l_codSistema := 1;  
  l_codcpa := 126;    
  l_codtpa := 384;    
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFic <> :NEW.CodFic)
   OR (:OLD.CodRem <> :NEW.CodRem)
   OR (:OLD.DatSol <> :NEW.DatSol)
   OR (:OLD.SeqDos <> :NEW.SeqDos)
   OR (:OLD.DatApl <> :NEW.DatApl)
   OR (:OLD.DatVen <> :NEW.DatVen)
   OR (:OLD.CodAte <> :NEW.CodAte)
   OR (:OLD.ObsVac <> :NEW.ObsVac)
   OR (:OLD.CodUsu <> :NEW.CodUsu)
   OR (:OLD.SitVac <> :NEW.SitVac)
   OR (:OLD.CodCam <> :NEW.CodCam)
   OR (:OLD.SeqCam <> :NEW.SeqCam)
   OR (:OLD.DatAte <> :NEW.DatAte)  
   OR (:OLD.HorAte <> :NEW.HorAte)
   OR (:OLD.NumVac <> :NEW.NumVac)
   OR (:OLD.QtdApl <> :NEW.QtdApl)
   OR (:OLD.CodPos <> :NEW.CodPos)
   OR (:OLD.IdeLot <> :NEW.IdeLot)
   OR (:OLD.NumRec <> :NEW.NumRec)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R111VAC_EU', '');

      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIC));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODREM', CONVERT(NUMBER_TO_CHAR, :OLD.CODREM));
        SP_DATSTR(:OLD.DATSOL, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATSOL', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQDOS', CONVERT(NUMBER_TO_CHAR, :OLD.SEQDOS));      
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R111VAC_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
        SP_DATSTR(:OLD.DATAPL, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATAPL', l_datTemp);
        SP_DATSTR(:NEW.DATAPL, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATAPL', l_datTemp);
        SP_DATSTR(:OLD.DATVEN, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATVEN', l_datTemp);
        SP_DATSTR(:NEW.DATVEN, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATVEN', l_datTemp); 
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODATE', CONVERT(NUMBER_TO_CHAR, :OLD.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODATE', CONVERT(NUMBER_TO_CHAR, :NEW.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSVAC', :OLD.OBSVAC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSVAC', :NEW.OBSVAC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODUSU', CONVERT(NUMBER_TO_CHAR, :OLD.CODUSU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODUSU', CONVERT(NUMBER_TO_CHAR, :NEW.CODUSU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSITVAC', CONVERT(NUMBER_TO_CHAR, :OLD.SITVAC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSITVAC', CONVERT(NUMBER_TO_CHAR, :NEW.SITVAC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCAM', CONVERT(NUMBER_TO_CHAR, :OLD.CODCAM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCAM', CONVERT(NUMBER_TO_CHAR, :NEW.CODCAM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSEQCAM', CONVERT(NUMBER_TO_CHAR, :OLD.SEQCAM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSEQCAM', CONVERT(NUMBER_TO_CHAR, :NEW.SEQCAM));
        SP_DATSTR(:OLD.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATATE', l_datTemp);
        SP_DATSTR(:NEW.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATATE', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORATE', CONVERT(NUMBER_TO_CHAR, :OLD.HORATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORATE', CONVERT(NUMBER_TO_CHAR, :NEW.HORATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMVAC', CONVERT(NUMBER_TO_CHAR, :OLD.NUMVAC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMVAC', CONVERT(NUMBER_TO_CHAR, :NEW.NUMVAC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQTDAPL', CONVERT(NUMBER_TO_CHAR, :OLD.QTDAPL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQTDAPL', CONVERT(NUMBER_TO_CHAR, :NEW.QTDAPL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPOS', CONVERT(NUMBER_TO_CHAR, :OLD.CODPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPOS', CONVERT(NUMBER_TO_CHAR, :NEW.CODPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDIDELOT', :OLD.IDELOT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWIDELOT', :NEW.IDELOT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMREC', CONVERT(NUMBER_TO_CHAR, :OLD.NUMREC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMREC', CONVERT(NUMBER_TO_CHAR, :NEW.NUMREC));
      END;
    END IF; 
  END IF; 
END␀»ß␀␀		SENIOR;0…␀␀ 

/* DELETE (OLD) */
TRIGGER R111VAC_ED AFTER DELETE ON R111VAC FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  l_codSistema := 1;  
  l_codcpa := 126;    
  l_codtpa := 383;    
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R111VAC_ED', '');

      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIC));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODREM', CONVERT(NUMBER_TO_CHAR, :OLD.CODREM));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATSOL', CONVERT(DATE_TO_CHAR, :OLD.DATSOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQDOS', CONVERT(NUMBER_TO_CHAR, :OLD.SEQDOS));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R111VAC_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAPL', CONVERT(DATE_TO_CHAR, :OLD.DATAPL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATVEN', CONVERT(DATE_TO_CHAR, :OLD.DATVEN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR, :OLD.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSVAC', :OLD.OBSVAC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR, :OLD.CODUSU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITVAC', CONVERT(NUMBER_TO_CHAR, :OLD.SITVAC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAM', CONVERT(NUMBER_TO_CHAR, :OLD.CODCAM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQCAM', CONVERT(NUMBER_TO_CHAR, :OLD.SEQCAM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', CONVERT(DATE_TO_CHAR, :OLD.DATATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR, :OLD.HORATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMVAC', CONVERT(NUMBER_TO_CHAR, :OLD.NUMVAC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDAPL', CONVERT(NUMBER_TO_CHAR, :OLD.QTDAPL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPOS', CONVERT(NUMBER_TO_CHAR, :OLD.CODPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'IDELOT', :OLD.IDELOT);     
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMREC', CONVERT(NUMBER_TO_CHAR, :OLD.NUMREC));
      END;
  END IF; 
END␀␀␀Î␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀¾ß␀␀…¬␀␀´␀	€␀␀␀␀␀␀G;XbXbr␀Æÿ␀␀Ò␀␀␀.,´␀	€␀␀␀␀␀␀?D&D&r␀Æÿ␀␀·ß␀␀␀¼ü␀␀­␀	€␀␀␀␀␀␀,ÿ␀␀xş␀␀xş␀␀p␀Æÿ␀␀¹ß␀␀␀f´␀	€␀␀␀␀␀␀•>îe¹fr␀Æÿ␀␀)Ñ␀␀␀0,4	€␀␀␀␀␀␀òAµ'µ'}␀␀ÿ␀␀Ñ␀␀␀b-¼␀	€␀␀␀␀␀␀.?Ì␀Ì␀v␀Æÿ␀␀§ß␀␀␀EÑ␀	€␀␀␀␀␀␀0LZ”␀␀Z”␀␀qC␀êÿ␀␀ÿ␀µEÑ␀€␀␀␀␀␀␀°L6␀6␀qC␀êÿ␀␀ÿ␀`-±␀€␀␀␀␀␀␀?ğ␀␀›ğ␀␀q␀Æÿ␀␀ÿ␀½␀␀=€␀␀␀␀␀␀¹Qb¿␀␀t¿␀␀c␀␀␀ÿ␀␀ÿ␀ÁÅ␀␀±␀€␀␀␀␀␀␀j¿␀␀Æ¼␀␀Æ¼␀␀O)␀␀Æÿ␀␀ÿ␀¼ú␀␀±␀€␀␀␀␀␀␀k¿␀␀È¼␀␀È¼␀␀O)␀␀Æÿ␀␀ÿ␀Â
