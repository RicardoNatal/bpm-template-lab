/*
 * Retorna as faixas de créditos para local físico zero(funcionamento global de créditos) para Colaboradores
 */
PROCEDURE SP_RETCRC(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_CREFX1 OUT CHAR(2),P_FX1 OUT CHAR(8),P_CREFX2 OUT CHAR(2),P_FX2 OUT CHAR(8),P_CREFX3 OUT CHAR(2),P_FX3 OUT CHAR(8),P_CREFX4 OUT CHAR(2),P_FX4 OUT CHAR(8),P_CREFX5 OUT CHAR(2),P_FX5 OUT CHAR(8),P_CREFX6 OUT CHAR(2),P_FX6 OUT CHAR(8))
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_verplf      NUMBER(3);
  l_codplf      NUMBER(7);
  l_concre      NUMBER(1);
  l_inifai      CHAR(4);
  l_fimfai      CHAR(4);
  l_faixa       CHAR(8);
  l_salatu      CHAR(2);
  l_crefx1      CHAR(2);
  l_fx1         CHAR(8);
  l_crefx2      CHAR(2);
  l_fx2         CHAR(8);
  l_crefx3      CHAR(2);
  l_fx3         CHAR(8);
  l_crefx4      CHAR(2);
  l_fx4         CHAR(8);
  l_crefx5      CHAR(2);
  l_fx5         CHAR(8);
  l_crefx6      CHAR(2);
  l_fx6         CHAR(8);

  CURSOR c_r070CRC IS
       SELECT INIFAI,FIMFAI,SALATU
         FROM R070CRC
        WHERE R070CRC.NUMEMP = p_numemp
          AND R070CRC.TIPCOL = p_tipcol
          AND R070CRC.NUMCAD = p_numcad
          AND R070CRC.DATINI <= l_data_atual
          AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR R070CRC.DATFIM = l_data_atual)
          AND R070CRC.VERPLF = l_verplf
          AND R070CRC.CODPLF = l_codplf;

  TYPE t_r070CRC IS RECORD(
    INIFAI   R070CRC.INIFAI%TYPE,
    FIMFAI   R070CRC.FIMFAI%TYPE,
    SALATU   R070CRC.SALATU%TYPE);
  l_r070CRC t_r070CRC;


BEGIN
  /* Inicializa */
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';

  /*Busca versão do plano ativa*/
  l_codplf := 0;
  BEGIN
      SELECT VERPLF INTO l_verplf
        FROM R058VPL
       WHERE DATCRI <= l_data_atual
         AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
  EXCEPTION
      WHEN OTHERS THEN
          l_verplf := 1;
  END;

  /*Busca o controle do credito de acesso*/
  l_concre := 0;
  BEGIN
      SELECT CONCRE INTO l_concre
        FROM R034DAC
       WHERE R034DAC.NUMEMP = p_numemp
          AND R034DAC.TIPCOL = p_tipcol
          AND R034DAC.NUMCAD = p_numcad;
  EXCEPTION
      WHEN OTHERS THEN
          l_concre := 0;
  END;

  l_crefx1 := '00';
  l_fx1 := '24002400';
  l_crefx2 := '00';
  l_fx2 := '24002400';
  l_crefx3 := '00';
  l_fx3 := '24002400';
  l_crefx4 := '00';
  l_fx4 := '24002400';
  l_crefx5 := '00';
  l_fx5 := '24002400';
  l_crefx6 := '00';
  l_fx6 := '24002400';


  FOREACH c_r070CRC INTO  l_r070CRC.inifai,
                          l_r070CRC.fimfai,
                          l_r070CRC.salatu
  LOOP
      SP_INTSTR(l_r070CRC.inifai,'HHMM',l_inifai OUT);
      SP_INTSTR(l_r070CRC.fimfai,'HHMM',l_fimfai OUT);

      IF (l_r070crc.salatu > 0) THEN
        SP_INTSTR(l_r070CRC.salatu,'99',l_salatu OUT);
      ELSIF (l_concre = 3) THEN
      	SP_INTSTR(1,'99',l_salatu OUT);
      ELSE 
        l_salatu := 0;
      END IF;

      l_faixa := l_inifai || l_fimfai;

      IF    l_fx1 = '24002400' THEN
           l_fx1 := l_faixa;
           l_crefx1 := l_salatu;
      ELSIF l_fx2 = '24002400' THEN
           l_fx2 := l_faixa;
           l_crefx2 := l_salatu;
      ELSIF l_fx3 = '24002400' THEN
           l_fx3 := l_faixa;
           l_crefx3 := l_salatu;
      ELSIF l_fx4 = '24002400' THEN
           l_fx4 := l_faixa;
           l_crefx4 := l_salatu;
      ELSIF l_fx5 = '24002400' THEN
           l_fx5 := l_faixa;
           l_crefx5 := l_salatu;
      ELSIF l_fx6 = '24002400' THEN
           l_fx6 := l_faixa;
           l_crefx6 := l_salatu;
      END IF;
  END LOOP;

  p_crefx1 := l_crefx1;
  p_fx1 := l_fx1;
  p_crefx2 := l_crefx2;
  p_fx2 := l_fx2;
  p_crefx3 := l_crefx3;
  p_fx3 := l_fx3;
  p_crefx4 := l_crefx4;
  p_fx4 := l_fx4;
  p_crefx5 := l_crefx5;
  p_fx5 := l_fx5;
  p_crefx6 := l_crefx6;
  p_fx6 := l_fx6;
END␀µø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
¿␀␀/*
 * DESCRIÇÃO: STORED PROCEDURE CRIADA PARA RETORNAR AS INFORMAÇÕES DE CONTROLE DAS FAIXAS DE UMA PESSOA, POR LOCAL FÍSICO
 * PARÂMETROS: - p_idtpes: Identificador da pessoa
               - p_verplf: Versão do plano de localização física
               - p_codplf: Código do local físico, se informado zero, retorna somente as 6 faixas permitidas
               - p_qtdfx: Quantidade de faixas presentes no campo p_fxstr
               - p_fxstr: Armazena todas as faixas selecionadas e suas informações para controle, conforme abaixo:
                          - Faixa do crédito, 8 posições, ex: 08391200, ou seja, 08:39 ás 12:00;
                          - Quantidade consumida na faixa, 3 posições, ex: 009;
                          - Data do último consumo na faixa, 8 posições DDMMYYYY, ex: 05062013 = 05/06/2013
                          - Limite de consumo diário na faixa, 2 posições, ex: 29
 */
PROCEDURE SP_RETCREATI(P_IDTPES CHAR(23),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7),P_QTDFX OUT NUMBER(2),P_FXSTR OUT VARCHAR2(1248))
 IS

l_tippes      NUMBER(2);
  l_idtpes      VARCHAR2(23);
  l_numemp      NUMBER(4);
  l_numemp_out  NUMBER(4);
  l_tipcol      NUMBER(1);
  l_numcad      NUMBER(9);
  l_numcad_out  NUMBER(9);
  l_tipdoc      NUMBER(1);
  l_numdoc      VARCHAR2(20);
  l_tipdoc_res  NUMBER(1);
  l_numdoc_res  VARCHAR2(20);
  l_nummat      VARCHAR2(15);
  l_propac      VARCHAR2(20);
  l_fxstr       VARCHAR2(1248);
  l_counter     NUMBER(3);
  /*CAMPO PARA CONTROLE DE FLUXO. DETERMINA O NÚMERO MÁXIMO DE FAIXAS A SEREM GERADAS*/
  l_limite_fx   NUMBER(3);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  /*campos auxiliares*/
  l_salatu_str  CHAR(3);
  l_inifai_str  CHAR(4);
  l_fimfai_str  CHAR(4);
  l_qtdcon_str  CHAR(3);
  l_datcon_str  CHAR(8);
  l_limcon_str  CHAR(2);

  /*Os selects possuem os campos em comum e o tipo para diferenciá-los*/
  /*crédito de aluno*/
  CURSOR c_r070CRX IS
       SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,10 TIPPES
         FROM R070CRA
        WHERE R070CRA.NUMMAT = l_nummat
          AND R070CRA.DATINI <= l_data_atual
          AND ( R070CRA.DATFIM = l_data_zero OR R070CRA.DATFIM > l_data_atual OR
               (R070CRA.DATFIM = l_data_atual AND R070CRA.FIMFAI >= l_hora_atual) )
          AND R070CRA.CODPLF = p_codplf
          AND R070CRA.VERPLF = p_verplf
  /*crédito de Colaborador*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,TIPCOL TIPPES
         FROM R070CRC
        WHERE R070CRC.NUMEMP = l_numemp
          AND R070CRC.TIPCOL = l_tipcol
          AND R070CRC.NUMCAD = l_numcad
          AND R070CRC.DATINI <= l_data_atual
          AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR
               (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual))
          AND R070CRC.VERPLF = p_verplf
          AND R070CRC.CODPLF = p_codplf
  /*crédito de Colaborador Outras Unidades*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,5 TIPPES
         FROM R070CRO
        WHERE R070CRO.NUMEMP = l_numemp_out
          AND R070CRO.NUMCAD = l_numcad_out
          AND R070CRO.DATINI <= l_data_atual
          AND (R070CRO.DATFIM = l_data_zero OR R070CRO.DATFIM > l_data_atual OR
               (R070CRO.DATFIM = l_data_atual AND R070CRO.FIMFAI >= l_hora_atual))
          AND R070CRO.VERPLF = p_verplf
          AND R070CRO.CODPLF = p_codplf
  /*crédito de Paciente*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,9 TIPPES
         FROM R070CRP
        WHERE R070CRP.PROPAC = l_propac
          AND R070CRP.DATINI <= l_data_atual
          AND (R070CRP.DATFIM = l_data_zero OR R070CRP.DATFIM > l_data_atual OR
               (R070CRP.DATFIM = l_data_atual AND R070CRP.FIMFAI >= l_hora_atual))
          AND R070CRP.VERPLF = p_verplf
          AND R070CRP.CODPLF = p_codplf
  /*crédito de Responsável de Aluno*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,7 TIPPES
         FROM R070CRR
        WHERE R070CRR.TIPDOC = l_tipdoc_res
          AND R070CRR.NUMDOC = l_numdoc_res
          AND R070CRR.DATINI <= l_data_atual
          AND (R070CRR.DATFIM = l_data_zero OR R070CRR.DATFIM > l_data_atual OR
               (R070CRR.DATFIM = l_data_atual AND R070CRR.FIMFAI >= l_hora_atual))
          AND R070CRR.VERPLF = p_verplf
          AND R070CRR.CODPLF = p_codplf
  /*crédito de Visitante*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,4 TIPPES
         FROM R070CRV
        WHERE R070CRV.TIPDOC = l_tipdoc
          AND R070CRV.NUMDOC = l_numdoc
          AND R070CRV.DATINI <= l_data_atual
          AND (R070CRV.DATFIM = l_data_zero OR R070CRV.DATFIM > l_data_atual OR
               (R070CRV.DATFIM = l_data_atual AND R070CRV.FIMFAI >= l_hora_atual))
          AND R070CRV.VERPLF = p_verplf
          AND R070CRV.CODPLF = p_codplf)))))
  ORDER BY 7 ASC;

  TYPE T_infoCred IS RECORD(
    SALATU   R070CRC.SALATU%TYPE,
    INIFAI   R070CRC.INIFAI%TYPE,
    FIMFAI   R070CRC.FIMFAI%TYPE,
    QTDCON   R070CRC.QTDCON%TYPE,
    DATCON   R070CRC.DATCON%TYPE,
    LIMCON   R070CRC.LIMCON%TYPE,
    TIPPES NUMBER(2));
  l_infoCred T_infoCred;
BEGIN
    NULL;
END		SENIOR;20SP_INTSTR
SP_DATSTR
÷+␀␀/*
 * DESCRIÇÃO: STORED PROCEDURE CRIADA PARA RETORNAR AS INFORMAÇÕES DE CONTROLE DAS FAIXAS DE UMA PESSOA, POR LOCAL FÍSICO
 * PARÂMETROS: - p_idtpes: Identificador da pessoa
               - p_verplf: Versão do plano de localização física
               - p_codplf: Código do local físico, se informado zero, retorna somente as 6 faixas permitidas
               - p_qtdfx: Quantidade de faixas presentes no campo p_fxstr
               - p_fxstr: Armazena todas as faixas selecionadas e suas informações para controle, conforme abaixo:
                          - Faixa do crédito, 8 posições, ex: 08391200, ou seja, 08:39 ás 12:00;
                          - Quantidade consumida na faixa, 3 posições, ex: 009;
                          - Data do último consumo na faixa, 8 posições DDMMYYYY, ex: 05062013 = 05/06/2013
                          - Limite de consumo diário na faixa, 2 posições, ex: 29
 */
PROCEDURE SP_RETCREATI(P_IDTPES CHAR(23),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7),P_QTDFX OUT NUMBER(2),P_FXSTR OUT VARCHAR2(1248))
 IS

l_tippes      NUMBER(2);
  l_idtpes      VARCHAR2(23);
  l_numemp      NUMBER(4);
  l_numemp_out  NUMBER(4);
  l_tipcol      NUMBER(1);
  l_numcad      NUMBER(9);
  l_numcad_out  NUMBER(9);
  l_tipdoc      NUMBER(1);
  l_numdoc      VARCHAR2(20);
  l_tipdoc_res  NUMBER(1);
  l_numdoc_res  VARCHAR2(20);
  l_nummat      VARCHAR2(15);
  l_propac      VARCHAR2(20);
  l_fxstr       VARCHAR2(1248);
  l_counter     NUMBER(3);
  /*CAMPO PARA CONTROLE DE FLUXO. DETERMINA O NÚMERO MÁXIMO DE FAIXAS A SEREM GERADAS*/
  l_limite_fx   NUMBER(3);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  /*campos auxiliares*/
  l_salatu_str  CHAR(3);
  l_inifai_str  CHAR(4);
  l_fimfai_str  CHAR(4);
  l_qtdcon_str  CHAR(3);
  l_datcon_str  CHAR(8);
  l_limcon_str  CHAR(2);
  l_horcon_str  CHAR(4);

  /*Os selects possuem os campos em comum e o tipo para diferenciá-los*/
  /*crédito de aluno*/
  CURSOR c_r070CRX IS
       SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,10 TIPPES,HORCON
         FROM R070CRA
        WHERE R070CRA.NUMMAT = l_nummat
          AND R070CRA.DATINI <= l_data_atual
          AND ( R070CRA.DATFIM = l_data_zero OR R070CRA.DATFIM > l_data_atual OR
               (R070CRA.DATFIM = l_data_atual AND R070CRA.FIMFAI >= l_hora_atual) )
          AND R070CRA.CODPLF = p_codplf
          AND R070CRA.VERPLF = p_verplf
  /*crédito de Colaborador*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,TIPCOL TIPPES,HORCON
         FROM R070CRC
        WHERE R070CRC.NUMEMP = l_numemp
          AND R070CRC.TIPCOL = l_tipcol
          AND R070CRC.NUMCAD = l_numcad
          AND R070CRC.DATINI <= l_data_atual
          AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR
               (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual))
          AND R070CRC.VERPLF = p_verplf
          AND R070CRC.CODPLF = p_codplf
  /*crédito de Colaborador Outras Unidades*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,5 TIPPES,HORCON
         FROM R070CRO
        WHERE R070CRO.NUMEMP = l_numemp_out
          AND R070CRO.NUMCAD = l_numcad_out
          AND R070CRO.DATINI <= l_data_atual
          AND (R070CRO.DATFIM = l_data_zero OR R070CRO.DATFIM > l_data_atual OR
               (R070CRO.DATFIM = l_data_atual AND R070CRO.FIMFAI >= l_hora_atual))
          AND R070CRO.VERPLF = p_verplf
          AND R070CRO.CODPLF = p_codplf
  /*crédito de Paciente*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,9 TIPPES,HORCON
         FROM R070CRP
        WHERE R070CRP.PROPAC = l_propac
          AND R070CRP.DATINI <= l_data_atual
          AND (R070CRP.DATFIM = l_data_zero OR R070CRP.DATFIM > l_data_atual OR
               (R070CRP.DATFIM = l_data_atual AND R070CRP.FIMFAI >= l_hora_atual))
          AND R070CRP.VERPLF = p_verplf
          AND R070CRP.CODPLF = p_codplf
  /*crédito de Responsável de Aluno*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,7 TIPPES,HORCON
         FROM R070CRR
        WHERE R070CRR.TIPDOC = l_tipdoc_res
          AND R070CRR.NUMDOC = l_numdoc_res
          AND R070CRR.DATINI <= l_data_atual
          AND (R070CRR.DATFIM = l_data_zero OR R070CRR.DATFIM > l_data_atual OR
               (R070CRR.DATFIM = l_data_atual AND R070CRR.FIMFAI >= l_hora_atual))
          AND R070CRR.VERPLF = p_verplf
          AND R070CRR.CODPLF = p_codplf
  /*crédito de Visitante*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,4 TIPPES,HORCON
         FROM R070CRV
        WHERE R070CRV.TIPDOC = l_tipdoc
          AND R070CRV.NUMDOC = l_numdoc
          AND R070CRV.DATINI <= l_data_atual
          AND (R070CRV.DATFIM = l_data_zero OR R070CRV.DATFIM > l_data_atual OR
               (R070CRV.DATFIM = l_data_atual AND R070CRV.FIMFAI >= l_hora_atual))
          AND R070CRV.VERPLF = p_verplf
          AND R070CRV.CODPLF = p_codplf
                             UNION (SELECT R070CAP.SALATU SALATU,
                                          R070CAP.INIFAI INIFAI,
                                          R070CAP.FIMFAI FIMFAI,
                                          R070CAP.QTDCON QTDCON,
                                          R070CAP.DATCON DATCON,
                                          R070CAP.LIMCON LIMCON,
                                          11             TIPPES,
                                          R070CAP.HORCON HORCON
                                     FROM R070CAP R070CAP
                                    WHERE R070CAP.TIPDOC = l_tipdoc
                                      AND R070CAP.NUMDOC = l_numdoc
                                      AND R070CAP.DATINI <= l_data_atual
                                      AND (R070CAP.DATFIM = l_data_zero OR
                                          R070CAP.DATFIM > l_data_atual OR
                                          (R070CAP.DATFIM = l_data_atual AND
                                          R070CAP.FIMFAI >= l_hora_atual))
                                      AND R070CAP.VERPLF = p_verplf
                                      AND R070CAP.CODPLF = p_codplf))))))
  ORDER BY 7 ASC;

  TYPE T_infoCred IS RECORD(
    SALATU   R070CRC.SALATU%TYPE,
    INIFAI   R070CRC.INIFAI%TYPE,
    FIMFAI   R070CRC.FIMFAI%TYPE,
    QTDCON   R070CRC.QTDCON%TYPE,
    DATCON   R070CRC.DATCON%TYPE,
    LIMCON   R070CRC.LIMCON%TYPE,
    TIPPES NUMBER(2),
    HORCON   R070CRC.HORCON%TYPE);
  l_infoCred T_infoCred;
BEGIN
  /*Inicializa os valores*/
  IF (p_codplf = 0) THEN
    l_limite_fx := 6;
  ELSE
    l_limite_fx := 50;
  END IF;
  l_idtpes     := LTRIM(RTRIM(p_idtpes));
  l_counter    := 0;
  l_fxstr      := '';
  l_data_atual := CURDATE();
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_tippes     := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,1,2));
  l_numemp     := 0;
  l_numemp_out := 0;
  l_tipcol     := 0;
  l_numcad     := 0;
  l_numcad_out := 0;
  l_tipdoc     := 0;
  l_numdoc     := '';
  l_tipdoc_res := 0;
  l_numdoc_res := '';
  l_nummat     := '';
  l_propac     := '';
  /* BUSCA OS CAMPOS CHAVE DE ACORDO COM IDTPES */
  /*Colaborador*/
  IF (l_tippes < 4) THEN
    l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
    l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
    l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
  ELSE
    /*Visitante*/
    IF (l_tippes = 4) THEN
      l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
      l_numdoc := SUBSTRING(l_idtpes,4,20);
    ELSE
      /*Outras unidades*/
      IF (l_tippes = 5) THEN
        l_numemp_out := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
        l_numcad_out := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,9));
      ELSE
          /* Aluno */
        IF (l_tippes = 10) THEN
          l_nummat := SUBSTRING(l_idtpes,3,15);
        ELSE
          /* Responsável Aluno */
          IF (l_tippes = 7) THEN
            l_tipdoc_res := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
            l_numdoc_res := SUBSTRING(l_idtpes,4,20);
          ELSE
            /* Paciente */
            IF (l_tippes = 9) THEN
              l_propac := SUBSTRING(l_idtpes,3,20);
            ELSE
              IF (l_tippes = 11) THEN
                l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                l_numdoc := SUBSTRING(l_idtpes,4,20);
              END IF;
            END IF;
          END IF;
        END IF;
      END IF;
    END IF;
  END IF;

  IF (l_tippes > 0) THEN
    /*Lê os registros para montar o retorno*/
    FOREACH c_r070CRX INTO  l_infoCred.salatu,
                            l_infoCred.inifai,
                            l_infoCred.fimfai,
                            l_infoCred.qtdcon,
                            l_infoCred.datcon,
                            l_infoCred.limcon,
                            l_infoCred.tippes,
                            l_infoCred.horcon
    LOOP
      /*Garante que somente tipo de pessoa igual é adcionada*/
      IF (l_infoCred.tippes = l_tippes) THEN
        /*caso a data de consumo sejá nula, assume data zero*/
        IF (l_infoCred.datcon IS NULL) THEN
          l_infoCred.datcon := l_data_zero;
        END IF;

        IF (l_infoCred.salatu <= 0) THEN
          l_salatu_str := '000';
        ELSE
          SP_INTSTR(l_infoCred.salatu,'999',l_salatu_str OUT);
        END IF;

        SP_INTSTR(l_infoCred.inifai,'HHMM',l_inifai_str OUT);
        SP_INTSTR(l_infoCred.fimfai,'HHMM',l_fimfai_str OUT);
        SP_INTSTR(l_infoCred.qtdcon,'999',l_qtdcon_str OUT);
        SP_DATSTR(l_infoCred.datcon,'DDMMYYYY',l_datcon_str OUT);
        SP_INTSTR(l_infoCred.limcon,'99',l_limcon_str OUT);
        SP_INTSTR(l_infoCred.horcon,'HHMM',l_horcon_str OUT);

        IF ( (l_horcon_str = '') OR (l_horcon_str IS NULL) ) THEN
          l_horcon_str := '0000'; 
        END IF;

        /*SE ALGUMA INFORMAÇÃO ESTIVER NÃO NULA/VAZIA, ADCIONA*/
        IF    ( ( (l_salatu_str <> '') OR (l_salatu_str IS NOT NULL) ) OR
                ( (l_inifai_str <> '') OR (l_inifai_str IS NOT NULL) ) OR
                ( (l_fimfai_str <> '') OR (l_fimfai_str IS NOT NULL) ) OR
                ( (l_qtdcon_str <> '') OR (l_qtdcon_str IS NOT NULL) ) OR
                ( (l_datcon_str <> '') OR (l_datcon_str IS NOT NULL) ) OR
                ( (l_horcon_str <> '') OR (l_horcon_str IS NOT NULL) ) OR
                ( (l_limcon_str <> '') OR (l_limcon_str IS NOT NULL) ) ) THEN
          /* adciona as informações do crédito */
          l_fxstr := l_fxstr || l_salatu_str || l_inifai_str || l_fimfai_str || l_qtdcon_str || l_datcon_str || l_limcon_str || l_horcon_str;
          l_counter := l_counter + 1;
          
          /*Atingiu o limite*/
          IF (l_counter = l_limite_fx) THEN
            EXIT;
          END IF;

        END IF;
      END IF;
    END LOOP;
  END IF;

  p_qtdfx := l_counter;
  p_fxstr := l_fxstr;
END		SENIOR;21SP_INTSTR
SP_DATSTR
÷+␀␀/*
 * DESCRIÇÃO: STORED PROCEDURE CRIADA PARA RETORNAR AS INFORMAÇÕES DE CONTROLE DAS FAIXAS DE UMA PESSOA, POR LOCAL FÍSICO
 * PARÂMETROS: - p_idtpes: Identificador da pessoa
               - p_verplf: Versão do plano de localização física
               - p_codplf: Código do local físico, se informado zero, retorna somente as 6 faixas permitidas
               - p_qtdfx: Quantidade de faixas presentes no campo p_fxstr
               - p_fxstr: Armazena todas as faixas selecionadas e suas informações para controle, conforme abaixo:
                          - Faixa do crédito, 8 posições, ex: 08391200, ou seja, 08:39 ás 12:00;
                          - Quantidade consumida na faixa, 3 posições, ex: 009;
                          - Data do último consumo na faixa, 8 posições DDMMYYYY, ex: 05062013 = 05/06/2013
                          - Limite de consumo diário na faixa, 2 posições, ex: 29
 */
PROCEDURE SP_RETCREATI(P_IDTPES CHAR(23),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7),P_QTDFX OUT NUMBER(2),P_FXSTR OUT VARCHAR2(1248))
 IS

l_tippes      NUMBER(2);
  l_idtpes      VARCHAR2(23);
  l_numemp      NUMBER(4);
  l_numemp_out  NUMBER(4);
  l_tipcol      NUMBER(1);
  l_numcad      NUMBER(9);
  l_numcad_out  NUMBER(9);
  l_tipdoc      NUMBER(1);
  l_numdoc      VARCHAR2(20);
  l_tipdoc_res  NUMBER(1);
  l_numdoc_res  VARCHAR2(20);
  l_nummat      VARCHAR2(15);
  l_propac      VARCHAR2(20);
  l_fxstr       VARCHAR2(1248);
  l_counter     NUMBER(3);
  /*CAMPO PARA CONTROLE DE FLUXO. DETERMINA O NÚMERO MÁXIMO DE FAIXAS A SEREM GERADAS*/
  l_limite_fx   NUMBER(3);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  /*campos auxiliares*/
  l_salatu_str  CHAR(3);
  l_inifai_str  CHAR(4);
  l_fimfai_str  CHAR(4);
  l_qtdcon_str  CHAR(3);
  l_datcon_str  CHAR(8);
  l_limcon_str  CHAR(2);
  l_horcon_str  CHAR(4);

  /*Os selects possuem os campos em comum e o tipo para diferenciá-los*/
  /*crédito de aluno*/
  CURSOR c_r070CRX IS
       SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,10 TIPPES,HORCON
         FROM R070CRA
        WHERE R070CRA.NUMMAT = l_nummat
          AND R070CRA.DATINI <= l_data_atual
          AND ( R070CRA.DATFIM = l_data_zero OR R070CRA.DATFIM > l_data_atual OR
               (R070CRA.DATFIM = l_data_atual AND R070CRA.FIMFAI >= l_hora_atual) )
          AND R070CRA.CODPLF = p_codplf
          AND R070CRA.VERPLF = p_verplf
  /*crédito de Colaborador*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,TIPCOL TIPPES,HORCON
         FROM R070CRC
        WHERE R070CRC.NUMEMP = l_numemp
          AND R070CRC.TIPCOL = l_tipcol
          AND R070CRC.NUMCAD = l_numcad
          AND R070CRC.DATINI <= l_data_atual
          AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR
               (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual))
          AND R070CRC.VERPLF = p_verplf
          AND R070CRC.CODPLF = p_codplf
  /*crédito de Colaborador Outras Unidades*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,5 TIPPES,HORCON
         FROM R070CRO
        WHERE R070CRO.NUMEMP = l_numemp_out
          AND R070CRO.NUMCAD = l_numcad_out
          AND R070CRO.DATINI <= l_data_atual
          AND (R070CRO.DATFIM = l_data_zero OR R070CRO.DATFIM > l_data_atual OR
               (R070CRO.DATFIM = l_data_atual AND R070CRO.FIMFAI >= l_hora_atual))
          AND R070CRO.VERPLF = p_verplf
          AND R070CRO.CODPLF = p_codplf
  /*crédito de Paciente*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,9 TIPPES,HORCON
         FROM R070CRP
        WHERE R070CRP.PROPAC = l_propac
          AND R070CRP.DATINI <= l_data_atual
          AND (R070CRP.DATFIM = l_data_zero OR R070CRP.DATFIM > l_data_atual OR
               (R070CRP.DATFIM = l_data_atual AND R070CRP.FIMFAI >= l_hora_atual))
          AND R070CRP.VERPLF = p_verplf
          AND R070CRP.CODPLF = p_codplf
  /*crédito de Responsável de Aluno*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,7 TIPPES,HORCON
         FROM R070CRR
        WHERE R070CRR.TIPDOC = l_tipdoc_res
          AND R070CRR.NUMDOC = l_numdoc_res
          AND R070CRR.DATINI <= l_data_atual
          AND (R070CRR.DATFIM = l_data_zero OR R070CRR.DATFIM > l_data_atual OR
               (R070CRR.DATFIM = l_data_atual AND R070CRR.FIMFAI >= l_hora_atual))
          AND R070CRR.VERPLF = p_verplf
          AND R070CRR.CODPLF = p_codplf
  /*crédito de Visitante*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,4 TIPPES,HORCON
         FROM R070CRV
        WHERE R070CRV.TIPDOC = l_tipdoc
          AND R070CRV.NUMDOC = l_numdoc
          AND R070CRV.DATINI <= l_data_atual
          AND (R070CRV.DATFIM = l_data_zero OR R070CRV.DATFIM > l_data_atual OR
               (R070CRV.DATFIM = l_data_atual AND R070CRV.FIMFAI >= l_hora_atual))
          AND R070CRV.VERPLF = p_verplf
          AND R070CRV.CODPLF = p_codplf
                             UNION (SELECT R070CAP.SALATU SALATU,
                                          R070CAP.INIFAI INIFAI,
                                          R070CAP.FIMFAI FIMFAI,
                                          R070CAP.QTDCON QTDCON,
                                          R070CAP.DATCON DATCON,
                                          R070CAP.LIMCON LIMCON,
                                          11             TIPPES,
                                          R070CAP.HORCON HORCON
                                     FROM R070CAP R070CAP
                                    WHERE R070CAP.TIPDOC = l_tipdoc
                                      AND R070CAP.NUMDOC = l_numdoc
                                      AND R070CAP.DATINI <= l_data_atual
                                      AND (R070CAP.DATFIM = l_data_zero OR
                                          R070CAP.DATFIM > l_data_atual OR
                                          (R070CAP.DATFIM = l_data_atual AND
                                          R070CAP.FIMFAI >= l_hora_atual))
                                      AND R070CAP.VERPLF = p_verplf
                                      AND R070CAP.CODPLF = p_codplf))))))
  ORDER BY 7 ASC;

  TYPE T_infoCred IS RECORD(
    SALATU   R070CRC.SALATU%TYPE,
    INIFAI   R070CRC.INIFAI%TYPE,
    FIMFAI   R070CRC.FIMFAI%TYPE,
    QTDCON   R070CRC.QTDCON%TYPE,
    DATCON   R070CRC.DATCON%TYPE,
    LIMCON   R070CRC.LIMCON%TYPE,
    TIPPES NUMBER(2),
    HORCON   R070CRC.HORCON%TYPE);
  l_infoCred T_infoCred;
BEGIN
  /*Inicializa os valores*/
  IF (p_codplf = 0) THEN
    l_limite_fx := 6;
  ELSE
    l_limite_fx := 50;
  END IF;
  l_idtpes     := LTRIM(RTRIM(p_idtpes));
  l_counter    := 0;
  l_fxstr      := '';
  l_data_atual := CURDATE();
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_tippes     := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,1,2));
  l_numemp     := 0;
  l_numemp_out := 0;
  l_tipcol     := 0;
  l_numcad     := 0;
  l_numcad_out := 0;
  l_tipdoc     := 0;
  l_numdoc     := '';
  l_tipdoc_res := 0;
  l_numdoc_res := '';
  l_nummat     := '';
  l_propac     := '';
  /* BUSCA OS CAMPOS CHAVE DE ACORDO COM IDTPES */
  /*Colaborador*/
  IF (l_tippes < 4) THEN
    l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
    l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
    l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
  ELSE
    /*Visitante*/
    IF (l_tippes = 4) THEN
      l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
      l_numdoc := SUBSTRING(l_idtpes,4,20);
    ELSE
      /*Outras unidades*/
      IF (l_tippes = 5) THEN
        l_numemp_out := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
        l_numcad_out := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,9));
      ELSE
          /* Aluno */
        IF (l_tippes = 10) THEN
          l_nummat := SUBSTRING(l_idtpes,3,15);
        ELSE
          /* Responsável Aluno */
          IF (l_tippes = 7) THEN
            l_tipdoc_res := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
            l_numdoc_res := SUBSTRING(l_idtpes,4,20);
          ELSE
            /* Paciente */
            IF (l_tippes = 9) THEN
              l_propac := SUBSTRING(l_idtpes,3,20);
            ELSE
              IF (l_tippes = 11) THEN
                l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                l_numdoc := SUBSTRING(l_idtpes,4,20);
              END IF;
            END IF;
          END IF;
        END IF;
      END IF;
    END IF;
  END IF;

  IF (l_tippes > 0) THEN
    /*Lê os registros para montar o retorno*/
    FOREACH c_r070CRX INTO  l_infoCred.salatu,
                            l_infoCred.inifai,
                            l_infoCred.fimfai,
                            l_infoCred.qtdcon,
                            l_infoCred.datcon,
                            l_infoCred.limcon,
                            l_infoCred.tippes,
                            l_infoCred.horcon
    LOOP
      /*Garante que somente tipo de pessoa igual é adcionada*/
      IF (l_infoCred.tippes = l_tippes) THEN
        /*caso a data de consumo sejá nula, assume data zero*/
        IF (l_infoCred.datcon IS NULL) THEN
          l_infoCred.datcon := l_data_zero;
        END IF;

        IF (l_infoCred.salatu <= 0) THEN
          l_salatu_str := '000';
        ELSE
          SP_INTSTR(l_infoCred.salatu,'999',l_salatu_str OUT);
        END IF;

        SP_INTSTR(l_infoCred.inifai,'HHMM',l_inifai_str OUT);
        SP_INTSTR(l_infoCred.fimfai,'HHMM',l_fimfai_str OUT);
        SP_INTSTR(l_infoCred.qtdcon,'999',l_qtdcon_str OUT);
        SP_DATSTR(l_infoCred.datcon,'DDMMYYYY',l_datcon_str OUT);
        SP_INTSTR(l_infoCred.limcon,'99',l_limcon_str OUT);
        SP_INTSTR(l_infoCred.horcon,'HHMM',l_horcon_str OUT);

        IF ( (l_horcon_str = '') OR (l_horcon_str IS NULL) ) THEN
          l_horcon_str := '0000'; 
        END IF;

        /*SE ALGUMA INFORMAÇÃO ESTIVER NÃO NULA/VAZIA, ADCIONA*/
        IF    ( ( (l_salatu_str <> '') OR (l_salatu_str IS NOT NULL) ) OR
                ( (l_inifai_str <> '') OR (l_inifai_str IS NOT NULL) ) OR
                ( (l_fimfai_str <> '') OR (l_fimfai_str IS NOT NULL) ) OR
                ( (l_qtdcon_str <> '') OR (l_qtdcon_str IS NOT NULL) ) OR
                ( (l_datcon_str <> '') OR (l_datcon_str IS NOT NULL) ) OR
                ( (l_horcon_str <> '') OR (l_horcon_str IS NOT NULL) ) OR
                ( (l_limcon_str <> '') OR (l_limcon_str IS NOT NULL) ) ) THEN
          /* adciona as informações do crédito */
          l_fxstr := l_fxstr || l_salatu_str || l_inifai_str || l_fimfai_str || l_qtdcon_str || l_datcon_str || l_limcon_str || l_horcon_str;
          l_counter := l_counter + 1;
          
          /*Atingiu o limite*/
          IF (l_counter = l_limite_fx) THEN
            EXIT;
          END IF;

        END IF;
      END IF;
    END LOOP;
  END IF;

  p_qtdfx := l_counter;
  p_fxstr := l_fxstr;
END		SENIOR;22SP_INTSTR
SP_DATSTR
÷+␀␀/*
 * DESCRIÇÃO: STORED PROCEDURE CRIADA PARA RETORNAR AS INFORMAÇÕES DE CONTROLE DAS FAIXAS DE UMA PESSOA, POR LOCAL FÍSICO
 * PARÂMETROS: - p_idtpes: Identificador da pessoa
               - p_verplf: Versão do plano de localização física
               - p_codplf: Código do local físico, se informado zero, retorna somente as 6 faixas permitidas
               - p_qtdfx: Quantidade de faixas presentes no campo p_fxstr
               - p_fxstr: Armazena todas as faixas selecionadas e suas informações para controle, conforme abaixo:
                          - Faixa do crédito, 8 posições, ex: 08391200, ou seja, 08:39 ás 12:00;
                          - Quantidade consumida na faixa, 3 posições, ex: 009;
                          - Data do último consumo na faixa, 8 posições DDMMYYYY, ex: 05062013 = 05/06/2013
                          - Limite de consumo diário na faixa, 2 posições, ex: 29
 */
PROCEDURE SP_RETCREATI(P_IDTPES CHAR(23),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7),P_QTDFX OUT NUMBER(2),P_FXSTR OUT VARCHAR2(1248))
 IS

l_tippes      NUMBER(2);
  l_idtpes      VARCHAR2(23);
  l_numemp      NUMBER(4);
  l_numemp_out  NUMBER(4);
  l_tipcol      NUMBER(1);
  l_numcad      NUMBER(9);
  l_numcad_out  NUMBER(9);
  l_tipdoc      NUMBER(1);
  l_numdoc      VARCHAR2(20);
  l_tipdoc_res  NUMBER(1);
  l_numdoc_res  VARCHAR2(20);
  l_nummat      VARCHAR2(15);
  l_propac      VARCHAR2(20);
  l_fxstr       VARCHAR2(1248);
  l_counter     NUMBER(3);
  /*CAMPO PARA CONTROLE DE FLUXO. DETERMINA O NÚMERO MÁXIMO DE FAIXAS A SEREM GERADAS*/
  l_limite_fx   NUMBER(3);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  /*campos auxiliares*/
  l_salatu_str  CHAR(3);
  l_inifai_str  CHAR(4);
  l_fimfai_str  CHAR(4);
  l_qtdcon_str  CHAR(3);
  l_datcon_str  CHAR(8);
  l_limcon_str  CHAR(2);
  l_horcon_str  CHAR(4);

  /*Os selects possuem os campos em comum e o tipo para diferenciá-los*/
  /*crédito de aluno*/
  CURSOR c_r070CRX IS
       SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,10 TIPPES,HORCON
         FROM R070CRA
        WHERE R070CRA.NUMMAT = l_nummat
          AND R070CRA.DATINI <= l_data_atual
          AND ( R070CRA.DATFIM = l_data_zero OR R070CRA.DATFIM > l_data_atual OR
               (R070CRA.DATFIM = l_data_atual AND R070CRA.FIMFAI >= l_hora_atual) )
          AND R070CRA.CODPLF = p_codplf
          AND R070CRA.VERPLF = p_verplf
  /*crédito de Colaborador*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,TIPCOL TIPPES,HORCON
         FROM R070CRC
        WHERE R070CRC.NUMEMP = l_numemp
          AND R070CRC.TIPCOL = l_tipcol
          AND R070CRC.NUMCAD = l_numcad
          AND R070CRC.DATINI <= l_data_atual
          AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR
               (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual))
          AND R070CRC.VERPLF = p_verplf
          AND R070CRC.CODPLF = p_codplf
  /*crédito de Colaborador Outras Unidades*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,5 TIPPES,HORCON
         FROM R070CRO
        WHERE R070CRO.NUMEMP = l_numemp_out
          AND R070CRO.NUMCAD = l_numcad_out
          AND R070CRO.DATINI <= l_data_atual
          AND (R070CRO.DATFIM = l_data_zero OR R070CRO.DATFIM > l_data_atual OR
               (R070CRO.DATFIM = l_data_atual AND R070CRO.FIMFAI >= l_hora_atual))
          AND R070CRO.VERPLF = p_verplf
          AND R070CRO.CODPLF = p_codplf
  /*crédito de Paciente*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,9 TIPPES,HORCON
         FROM R070CRP
        WHERE R070CRP.PROPAC = l_propac
          AND R070CRP.DATINI <= l_data_atual
          AND (R070CRP.DATFIM = l_data_zero OR R070CRP.DATFIM > l_data_atual OR
               (R070CRP.DATFIM = l_data_atual AND R070CRP.FIMFAI >= l_hora_atual))
          AND R070CRP.VERPLF = p_verplf
          AND R070CRP.CODPLF = p_codplf
  /*crédito de Responsável de Aluno*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,7 TIPPES,HORCON
         FROM R070CRR
        WHERE R070CRR.TIPDOC = l_tipdoc_res
          AND R070CRR.NUMDOC = l_numdoc_res
          AND R070CRR.DATINI <= l_data_atual
          AND (R070CRR.DATFIM = l_data_zero OR R070CRR.DATFIM > l_data_atual OR
               (R070CRR.DATFIM = l_data_atual AND R070CRR.FIMFAI >= l_hora_atual))
          AND R070CRR.VERPLF = p_verplf
          AND R070CRR.CODPLF = p_codplf
  /*crédito de Visitante*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,4 TIPPES,HORCON
         FROM R070CRV
        WHERE R070CRV.TIPDOC = l_tipdoc
          AND R070CRV.NUMDOC = l_numdoc
          AND R070CRV.DATINI <= l_data_atual
          AND (R070CRV.DATFIM = l_data_zero OR R070CRV.DATFIM > l_data_atual OR
               (R070CRV.DATFIM = l_data_atual AND R070CRV.FIMFAI >= l_hora_atual))
          AND R070CRV.VERPLF = p_verplf
          AND R070CRV.CODPLF = p_codplf
                             UNION (SELECT R070CAP.SALATU SALATU,
                                          R070CAP.INIFAI INIFAI,
                                          R070CAP.FIMFAI FIMFAI,
                                          R070CAP.QTDCON QTDCON,
                                          R070CAP.DATCON DATCON,
                                          R070CAP.LIMCON LIMCON,
                                          11             TIPPES,
                                          R070CAP.HORCON HORCON
                                     FROM R070CAP R070CAP
                                    WHERE R070CAP.TIPDOC = l_tipdoc
                                      AND R070CAP.NUMDOC = l_numdoc
                                      AND R070CAP.DATINI <= l_data_atual
                                      AND (R070CAP.DATFIM = l_data_zero OR
                                          R070CAP.DATFIM > l_data_atual OR
                                          (R070CAP.DATFIM = l_data_atual AND
                                          R070CAP.FIMFAI >= l_hora_atual))
                                      AND R070CAP.VERPLF = p_verplf
                                      AND R070CAP.CODPLF = p_codplf))))))
  ORDER BY 7 ASC;

  TYPE T_infoCred IS RECORD(
    SALATU   R070CRC.SALATU%TYPE,
    INIFAI   R070CRC.INIFAI%TYPE,
    FIMFAI   R070CRC.FIMFAI%TYPE,
    QTDCON   R070CRC.QTDCON%TYPE,
    DATCON   R070CRC.DATCON%TYPE,
    LIMCON   R070CRC.LIMCON%TYPE,
    TIPPES NUMBER(2),
    HORCON   R070CRC.HORCON%TYPE);
  l_infoCred T_infoCred;
BEGIN
  /*Inicializa os valores*/
  IF (p_codplf = 0) THEN
    l_limite_fx := 6;
  ELSE
    l_limite_fx := 50;
  END IF;
  l_idtpes     := LTRIM(RTRIM(p_idtpes));
  l_counter    := 0;
  l_fxstr      := '';
  l_data_atual := CURDATE();
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_tippes     := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,1,2));
  l_numemp     := 0;
  l_numemp_out := 0;
  l_tipcol     := 0;
  l_numcad     := 0;
  l_numcad_out := 0;
  l_tipdoc     := 0;
  l_numdoc     := '';
  l_tipdoc_res := 0;
  l_numdoc_res := '';
  l_nummat     := '';
  l_propac     := '';
  /* BUSCA OS CAMPOS CHAVE DE ACORDO COM IDTPES */
  /*Colaborador*/
  IF (l_tippes < 4) THEN
    l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
    l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
    l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
  ELSE
    /*Visitante*/
    IF (l_tippes = 4) THEN
      l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
      l_numdoc := SUBSTRING(l_idtpes,4,20);
    ELSE
      /*Outras unidades*/
      IF (l_tippes = 5) THEN
        l_numemp_out := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
        l_numcad_out := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,9));
      ELSE
          /* Aluno */
        IF (l_tippes = 10) THEN
          l_nummat := SUBSTRING(l_idtpes,3,15);
        ELSE
          /* Responsável Aluno */
          IF (l_tippes = 7) THEN
            l_tipdoc_res := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
            l_numdoc_res := SUBSTRING(l_idtpes,4,20);
          ELSE
            /* Paciente */
            IF (l_tippes = 9) THEN
              l_propac := SUBSTRING(l_idtpes,3,20);
            ELSE
              IF (l_tippes = 11) THEN
                l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                l_numdoc := SUBSTRING(l_idtpes,4,20);
              END IF;
            END IF;
          END IF;
        END IF;
      END IF;
    END IF;
  END IF;

  IF (l_tippes > 0) THEN
    /*Lê os registros para montar o retorno*/
    FOREACH c_r070CRX INTO  l_infoCred.salatu,
                            l_infoCred.inifai,
                            l_infoCred.fimfai,
                            l_infoCred.qtdcon,
                            l_infoCred.datcon,
                            l_infoCred.limcon,
                            l_infoCred.tippes,
                            l_infoCred.horcon
    LOOP
      /*Garante que somente tipo de pessoa igual é adcionada*/
      IF (l_infoCred.tippes = l_tippes) THEN
        /*caso a data de consumo sejá nula, assume data zero*/
        IF (l_infoCred.datcon IS NULL) THEN
          l_infoCred.datcon := l_data_zero;
        END IF;

        IF (l_infoCred.salatu <= 0) THEN
          l_salatu_str := '000';
        ELSE
          SP_INTSTR(l_infoCred.salatu,'999',l_salatu_str OUT);
        END IF;

        SP_INTSTR(l_infoCred.inifai,'HHMM',l_inifai_str OUT);
        SP_INTSTR(l_infoCred.fimfai,'HHMM',l_fimfai_str OUT);
        SP_INTSTR(l_infoCred.qtdcon,'999',l_qtdcon_str OUT);
        SP_DATSTR(l_infoCred.datcon,'DDMMYYYY',l_datcon_str OUT);
        SP_INTSTR(l_infoCred.limcon,'99',l_limcon_str OUT);
        SP_INTSTR(l_infoCred.horcon,'HHMM',l_horcon_str OUT);

        IF ( (l_horcon_str = '') OR (l_horcon_str IS NULL) ) THEN
          l_horcon_str := '0000'; 
        END IF;

        /*SE ALGUMA INFORMAÇÃO ESTIVER NÃO NULA/VAZIA, ADCIONA*/
        IF    ( ( (l_salatu_str <> '') OR (l_salatu_str IS NOT NULL) ) OR
                ( (l_inifai_str <> '') OR (l_inifai_str IS NOT NULL) ) OR
                ( (l_fimfai_str <> '') OR (l_fimfai_str IS NOT NULL) ) OR
                ( (l_qtdcon_str <> '') OR (l_qtdcon_str IS NOT NULL) ) OR
                ( (l_datcon_str <> '') OR (l_datcon_str IS NOT NULL) ) OR
                ( (l_horcon_str <> '') OR (l_horcon_str IS NOT NULL) ) OR
                ( (l_limcon_str <> '') OR (l_limcon_str IS NOT NULL) ) ) THEN
          /* adciona as informações do crédito */
          l_fxstr := l_fxstr || l_salatu_str || l_inifai_str || l_fimfai_str || l_qtdcon_str || l_datcon_str || l_limcon_str || l_horcon_str;
          l_counter := l_counter + 1;
          
          /*Atingiu o limite*/
          IF (l_counter = l_limite_fx) THEN
            EXIT;
          END IF;

        END IF;
      END IF;
    END LOOP;
  END IF;

  p_qtdfx := l_counter;
  p_fxstr := l_fxstr;
END		SENIOR;23SP_INTSTR
SP_DATSTR
÷+␀␀/*
 * DESCRIÇÃO: STORED PROCEDURE CRIADA PARA RETORNAR AS INFORMAÇÕES DE CONTROLE DAS FAIXAS DE UMA PESSOA, POR LOCAL FÍSICO
 * PARÂMETROS: - p_idtpes: Identificador da pessoa
               - p_verplf: Versão do plano de localização física
               - p_codplf: Código do local físico, se informado zero, retorna somente as 6 faixas permitidas
               - p_qtdfx: Quantidade de faixas presentes no campo p_fxstr
               - p_fxstr: Armazena todas as faixas selecionadas e suas informações para controle, conforme abaixo:
                          - Faixa do crédito, 8 posições, ex: 08391200, ou seja, 08:39 ás 12:00;
                          - Quantidade consumida na faixa, 3 posições, ex: 009;
                          - Data do último consumo na faixa, 8 posições DDMMYYYY, ex: 05062013 = 05/06/2013
                          - Limite de consumo diário na faixa, 2 posições, ex: 29
 */
PROCEDURE SP_RETCREATI(P_IDTPES CHAR(23),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7),P_QTDFX OUT NUMBER(2),P_FXSTR OUT VARCHAR2(1248))
 IS

l_tippes      NUMBER(2);
  l_idtpes      VARCHAR2(23);
  l_numemp      NUMBER(4);
  l_numemp_out  NUMBER(4);
  l_tipcol      NUMBER(1);
  l_numcad      NUMBER(9);
  l_numcad_out  NUMBER(9);
  l_tipdoc      NUMBER(1);
  l_numdoc      VARCHAR2(20);
  l_tipdoc_res  NUMBER(1);
  l_numdoc_res  VARCHAR2(20);
  l_nummat      VARCHAR2(15);
  l_propac      VARCHAR2(20);
  l_fxstr       VARCHAR2(1248);
  l_counter     NUMBER(3);
  /*CAMPO PARA CONTROLE DE FLUXO. DETERMINA O NÚMERO MÁXIMO DE FAIXAS A SEREM GERADAS*/
  l_limite_fx   NUMBER(3);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  /*campos auxiliares*/
  l_salatu_str  CHAR(3);
  l_inifai_str  CHAR(4);
  l_fimfai_str  CHAR(4);
  l_qtdcon_str  CHAR(3);
  l_datcon_str  CHAR(8);
  l_limcon_str  CHAR(2);
  l_horcon_str  CHAR(4);

  /*Os selects possuem os campos em comum e o tipo para diferenciá-los*/
  /*crédito de aluno*/
  CURSOR c_r070CRX IS
       SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,10 TIPPES,HORCON
         FROM R070CRA
        WHERE R070CRA.NUMMAT = l_nummat
          AND R070CRA.DATINI <= l_data_atual
          AND ( R070CRA.DATFIM = l_data_zero OR R070CRA.DATFIM > l_data_atual OR
               (R070CRA.DATFIM = l_data_atual AND R070CRA.FIMFAI >= l_hora_atual) )
          AND R070CRA.CODPLF = p_codplf
          AND R070CRA.VERPLF = p_verplf
  /*crédito de Colaborador*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,TIPCOL TIPPES,HORCON
         FROM R070CRC
        WHERE R070CRC.NUMEMP = l_numemp
          AND R070CRC.TIPCOL = l_tipcol
          AND R070CRC.NUMCAD = l_numcad
          AND R070CRC.DATINI <= l_data_atual
          AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR
               (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual))
          AND R070CRC.VERPLF = p_verplf
          AND R070CRC.CODPLF = p_codplf
  /*crédito de Colaborador Outras Unidades*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,5 TIPPES,HORCON
         FROM R070CRO
        WHERE R070CRO.NUMEMP = l_numemp_out
          AND R070CRO.NUMCAD = l_numcad_out
          AND R070CRO.DATINI <= l_data_atual
          AND (R070CRO.DATFIM = l_data_zero OR R070CRO.DATFIM > l_data_atual OR
               (R070CRO.DATFIM = l_data_atual AND R070CRO.FIMFAI >= l_hora_atual))
          AND R070CRO.VERPLF = p_verplf
          AND R070CRO.CODPLF = p_codplf
  /*crédito de Paciente*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,9 TIPPES,HORCON
         FROM R070CRP
        WHERE R070CRP.PROPAC = l_propac
          AND R070CRP.DATINI <= l_data_atual
          AND (R070CRP.DATFIM = l_data_zero OR R070CRP.DATFIM > l_data_atual OR
               (R070CRP.DATFIM = l_data_atual AND R070CRP.FIMFAI >= l_hora_atual))
          AND R070CRP.VERPLF = p_verplf
          AND R070CRP.CODPLF = p_codplf
  /*crédito de Responsável de Aluno*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,7 TIPPES,HORCON
         FROM R070CRR
        WHERE R070CRR.TIPDOC = l_tipdoc_res
          AND R070CRR.NUMDOC = l_numdoc_res
          AND R070CRR.DATINI <= l_data_atual
          AND (R070CRR.DATFIM = l_data_zero OR R070CRR.DATFIM > l_data_atual OR
               (R070CRR.DATFIM = l_data_atual AND R070CRR.FIMFAI >= l_hora_atual))
          AND R070CRR.VERPLF = p_verplf
          AND R070CRR.CODPLF = p_codplf
  /*crédito de Visitante*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,4 TIPPES,HORCON
         FROM R070CRV
        WHERE R070CRV.TIPDOC = l_tipdoc
          AND R070CRV.NUMDOC = l_numdoc
          AND R070CRV.DATINI <= l_data_atual
          AND (R070CRV.DATFIM = l_data_zero OR R070CRV.DATFIM > l_data_atual OR
               (R070CRV.DATFIM = l_data_atual AND R070CRV.FIMFAI >= l_hora_atual))
          AND R070CRV.VERPLF = p_verplf
          AND R070CRV.CODPLF = p_codplf
                             UNION (SELECT R070CAP.SALATU SALATU,
                                          R070CAP.INIFAI INIFAI,
                                          R070CAP.FIMFAI FIMFAI,
                                          R070CAP.QTDCON QTDCON,
                                          R070CAP.DATCON DATCON,
                                          R070CAP.LIMCON LIMCON,
                                          11             TIPPES,
                                          R070CAP.HORCON HORCON
                                     FROM R070CAP R070CAP
                                    WHERE R070CAP.TIPDOC = l_tipdoc
                                      AND R070CAP.NUMDOC = l_numdoc
                                      AND R070CAP.DATINI <= l_data_atual
                                      AND (R070CAP.DATFIM = l_data_zero OR
                                          R070CAP.DATFIM > l_data_atual OR
                                          (R070CAP.DATFIM = l_data_atual AND
                                          R070CAP.FIMFAI >= l_hora_atual))
                                      AND R070CAP.VERPLF = p_verplf
                                      AND R070CAP.CODPLF = p_codplf))))))
  ORDER BY 7 ASC;

  TYPE T_infoCred IS RECORD(
    SALATU   R070CRC.SALATU%TYPE,
    INIFAI   R070CRC.INIFAI%TYPE,
    FIMFAI   R070CRC.FIMFAI%TYPE,
    QTDCON   R070CRC.QTDCON%TYPE,
    DATCON   R070CRC.DATCON%TYPE,
    LIMCON   R070CRC.LIMCON%TYPE,
    TIPPES NUMBER(2),
    HORCON   R070CRC.HORCON%TYPE);
  l_infoCred T_infoCred;
BEGIN
  /*Inicializa os valores*/
  IF (p_codplf = 0) THEN
    l_limite_fx := 6;
  ELSE
    l_limite_fx := 50;
  END IF;
  l_idtpes     := LTRIM(RTRIM(p_idtpes));
  l_counter    := 0;
  l_fxstr      := '';
  l_data_atual := CURDATE();
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_tippes     := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,1,2));
  l_numemp     := 0;
  l_numemp_out := 0;
  l_tipcol     := 0;
  l_numcad     := 0;
  l_numcad_out := 0;
  l_tipdoc     := 0;
  l_numdoc     := '';
  l_tipdoc_res := 0;
  l_numdoc_res := '';
  l_nummat     := '';
  l_propac     := '';
  /* BUSCA OS CAMPOS CHAVE DE ACORDO COM IDTPES */
  /*Colaborador*/
  IF (l_tippes < 4) THEN
    l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
    l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
    l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
  ELSE
    /*Visitante*/
    IF (l_tippes = 4) THEN
      l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
      l_numdoc := SUBSTRING(l_idtpes,4,20);
    ELSE
      /*Outras unidades*/
      IF (l_tippes = 5) THEN
        l_numemp_out := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
        l_numcad_out := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,9));
      ELSE
          /* Aluno */
        IF (l_tippes = 10) THEN
          l_nummat := SUBSTRING(l_idtpes,3,15);
        ELSE
          /* Responsável Aluno */
          IF (l_tippes = 7) THEN
            l_tipdoc_res := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
            l_numdoc_res := SUBSTRING(l_idtpes,4,20);
          ELSE
            /* Paciente */
            IF (l_tippes = 9) THEN
              l_propac := SUBSTRING(l_idtpes,3,20);
            ELSE
              IF (l_tippes = 11) THEN
                l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                l_numdoc := SUBSTRING(l_idtpes,4,20);
              END IF;
            END IF;
          END IF;
        END IF;
      END IF;
    END IF;
  END IF;

  IF (l_tippes > 0) THEN
    /*Lê os registros para montar o retorno*/
    FOREACH c_r070CRX INTO  l_infoCred.salatu,
                            l_infoCred.inifai,
                            l_infoCred.fimfai,
                            l_infoCred.qtdcon,
                            l_infoCred.datcon,
                            l_infoCred.limcon,
                            l_infoCred.tippes,
                            l_infoCred.horcon
    LOOP
      /*Garante que somente tipo de pessoa igual é adcionada*/
      IF (l_infoCred.tippes = l_tippes) THEN
        /*caso a data de consumo sejá nula, assume data zero*/
        IF (l_infoCred.datcon IS NULL) THEN
          l_infoCred.datcon := l_data_zero;
        END IF;

        IF (l_infoCred.salatu <= 0) THEN
          l_salatu_str := '000';
        ELSE
          SP_INTSTR(l_infoCred.salatu,'999',l_salatu_str OUT);
        END IF;

        SP_INTSTR(l_infoCred.inifai,'HHMM',l_inifai_str OUT);
        SP_INTSTR(l_infoCred.fimfai,'HHMM',l_fimfai_str OUT);
        SP_INTSTR(l_infoCred.qtdcon,'999',l_qtdcon_str OUT);
        SP_DATSTR(l_infoCred.datcon,'DDMMYYYY',l_datcon_str OUT);
        SP_INTSTR(l_infoCred.limcon,'99',l_limcon_str OUT);
        SP_INTSTR(l_infoCred.horcon,'HHMM',l_horcon_str OUT);

        IF ( (l_horcon_str = '') OR (l_horcon_str IS NULL) ) THEN
          l_horcon_str := '0000'; 
        END IF;

        /*SE ALGUMA INFORMAÇÃO ESTIVER NÃO NULA/VAZIA, ADCIONA*/
        IF    ( ( (l_salatu_str <> '') OR (l_salatu_str IS NOT NULL) ) OR
                ( (l_inifai_str <> '') OR (l_inifai_str IS NOT NULL) ) OR
                ( (l_fimfai_str <> '') OR (l_fimfai_str IS NOT NULL) ) OR
                ( (l_qtdcon_str <> '') OR (l_qtdcon_str IS NOT NULL) ) OR
                ( (l_datcon_str <> '') OR (l_datcon_str IS NOT NULL) ) OR
                ( (l_horcon_str <> '') OR (l_horcon_str IS NOT NULL) ) OR
                ( (l_limcon_str <> '') OR (l_limcon_str IS NOT NULL) ) ) THEN
          /* adciona as informações do crédito */
          l_fxstr := l_fxstr || l_salatu_str || l_inifai_str || l_fimfai_str || l_qtdcon_str || l_datcon_str || l_limcon_str || l_horcon_str;
          l_counter := l_counter + 1;
          
          /*Atingiu o limite*/
          IF (l_counter = l_limite_fx) THEN
            EXIT;
          END IF;

        END IF;
      END IF;
    END LOOP;
  END IF;

  p_qtdfx := l_counter;
  p_fxstr := l_fxstr;
END		SENIOR;24SP_INTSTR
SP_DATSTR
÷+␀␀/*
 * DESCRIÇÃO: STORED PROCEDURE CRIADA PARA RETORNAR AS INFORMAÇÕES DE CONTROLE DAS FAIXAS DE UMA PESSOA, POR LOCAL FÍSICO
 * PARÂMETROS: - p_idtpes: Identificador da pessoa
               - p_verplf: Versão do plano de localização física
               - p_codplf: Código do local físico, se informado zero, retorna somente as 6 faixas permitidas
               - p_qtdfx: Quantidade de faixas presentes no campo p_fxstr
               - p_fxstr: Armazena todas as faixas selecionadas e suas informações para controle, conforme abaixo:
                          - Faixa do crédito, 8 posições, ex: 08391200, ou seja, 08:39 ás 12:00;
                          - Quantidade consumida na faixa, 3 posições, ex: 009;
                          - Data do último consumo na faixa, 8 posições DDMMYYYY, ex: 05062013 = 05/06/2013
                          - Limite de consumo diário na faixa, 2 posições, ex: 29
 */
PROCEDURE SP_RETCREATI(P_IDTPES CHAR(23),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7),P_QTDFX OUT NUMBER(2),P_FXSTR OUT VARCHAR2(1248))
 IS

l_tippes      NUMBER(2);
  l_idtpes      VARCHAR2(23);
  l_numemp      NUMBER(4);
  l_numemp_out  NUMBER(4);
  l_tipcol      NUMBER(1);
  l_numcad      NUMBER(9);
  l_numcad_out  NUMBER(9);
  l_tipdoc      NUMBER(1);
  l_numdoc      VARCHAR2(20);
  l_tipdoc_res  NUMBER(1);
  l_numdoc_res  VARCHAR2(20);
  l_nummat      VARCHAR2(15);
  l_propac      VARCHAR2(20);
  l_fxstr       VARCHAR2(1248);
  l_counter     NUMBER(3);
  /*CAMPO PARA CONTROLE DE FLUXO. DETERMINA O NÚMERO MÁXIMO DE FAIXAS A SEREM GERADAS*/
  l_limite_fx   NUMBER(3);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  /*campos auxiliares*/
  l_salatu_str  CHAR(3);
  l_inifai_str  CHAR(4);
  l_fimfai_str  CHAR(4);
  l_qtdcon_str  CHAR(3);
  l_datcon_str  CHAR(8);
  l_limcon_str  CHAR(2);
  l_horcon_str  CHAR(4);

  /*Os selects possuem os campos em comum e o tipo para diferenciá-los*/
  /*crédito de aluno*/
  CURSOR c_r070CRX IS
       SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,10 TIPPES,HORCON
         FROM R070CRA
        WHERE R070CRA.NUMMAT = l_nummat
          AND R070CRA.DATINI <= l_data_atual
          AND ( R070CRA.DATFIM = l_data_zero OR R070CRA.DATFIM > l_data_atual OR
               (R070CRA.DATFIM = l_data_atual AND R070CRA.FIMFAI >= l_hora_atual) )
          AND R070CRA.CODPLF = p_codplf
          AND R070CRA.VERPLF = p_verplf
  /*crédito de Colaborador*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,TIPCOL TIPPES,HORCON
         FROM R070CRC
        WHERE R070CRC.NUMEMP = l_numemp
          AND R070CRC.TIPCOL = l_tipcol
          AND R070CRC.NUMCAD = l_numcad
          AND R070CRC.DATINI <= l_data_atual
          AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR
               (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual))
          AND R070CRC.VERPLF = p_verplf
          AND R070CRC.CODPLF = p_codplf
  /*crédito de Colaborador Outras Unidades*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,5 TIPPES,HORCON
         FROM R070CRO
        WHERE R070CRO.NUMEMP = l_numemp_out
          AND R070CRO.NUMCAD = l_numcad_out
          AND R070CRO.DATINI <= l_data_atual
          AND (R070CRO.DATFIM = l_data_zero OR R070CRO.DATFIM > l_data_atual OR
               (R070CRO.DATFIM = l_data_atual AND R070CRO.FIMFAI >= l_hora_atual))
          AND R070CRO.VERPLF = p_verplf
          AND R070CRO.CODPLF = p_codplf
  /*crédito de Paciente*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,9 TIPPES,HORCON
         FROM R070CRP
        WHERE R070CRP.PROPAC = l_propac
          AND R070CRP.DATINI <= l_data_atual
          AND (R070CRP.DATFIM = l_data_zero OR R070CRP.DATFIM > l_data_atual OR
               (R070CRP.DATFIM = l_data_atual AND R070CRP.FIMFAI >= l_hora_atual))
          AND R070CRP.VERPLF = p_verplf
          AND R070CRP.CODPLF = p_codplf
  /*crédito de Responsável de Aluno*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,7 TIPPES,HORCON
         FROM R070CRR
        WHERE R070CRR.TIPDOC = l_tipdoc_res
          AND R070CRR.NUMDOC = l_numdoc_res
          AND R070CRR.DATINI <= l_data_atual
          AND (R070CRR.DATFIM = l_data_zero OR R070CRR.DATFIM > l_data_atual OR
               (R070CRR.DATFIM = l_data_atual AND R070CRR.FIMFAI >= l_hora_atual))
          AND R070CRR.VERPLF = p_verplf
          AND R070CRR.CODPLF = p_codplf
  /*crédito de Visitante*/
  UNION
      (SELECT SALATU,INIFAI,FIMFAI,QTDCON,DATCON,LIMCON,4 TIPPES,HORCON
         FROM R070CRV
        WHERE R070CRV.TIPDOC = l_tipdoc
          AND R070CRV.NUMDOC = l_numdoc
          AND R070CRV.DATINI <= l_data_atual
          AND (R070CRV.DATFIM = l_data_zero OR R070CRV.DATFIM > l_data_atual OR
               (R070CRV.DATFIM = l_data_atual AND R070CRV.FIMFAI >= l_hora_atual))
          AND R070CRV.VERPLF = p_verplf
          AND R070CRV.CODPLF = p_codplf
                             UNION (SELECT R070CAP.SALATU SALATU,
                                          R070CAP.INIFAI INIFAI,
                                          R070CAP.FIMFAI FIMFAI,
                                          R070CAP.QTDCON QTDCON,
                                          R070CAP.DATCON DATCON,
                                          R070CAP.LIMCON LIMCON,
                                          11             TIPPES,
                                          R070CAP.HORCON HORCON
                                     FROM R070CAP R070CAP
                                    WHERE R070CAP.TIPDOC = l_tipdoc
                                      AND R070CAP.NUMDOC = l_numdoc
                                      AND R070CAP.DATINI <= l_data_atual
                                      AND (R070CAP.DATFIM = l_data_zero OR
                                          R070CAP.DATFIM > l_data_atual OR
                                          (R070CAP.DATFIM = l_data_atual AND
                                          R070CAP.FIMFAI >= l_hora_atual))
                                      AND R070CAP.VERPLF = p_verplf
                                      AND R070CAP.CODPLF = p_codplf))))))
  ORDER BY 7 ASC;

  TYPE T_infoCred IS RECORD(
    SALATU   R070CRC.SALATU%TYPE,
    INIFAI   R070CRC.INIFAI%TYPE,
    FIMFAI   R070CRC.FIMFAI%TYPE,
    QTDCON   R070CRC.QTDCON%TYPE,
    DATCON   R070CRC.DATCON%TYPE,
    LIMCON   R070CRC.LIMCON%TYPE,
    TIPPES NUMBER(2),
    HORCON   R070CRC.HORCON%TYPE);
  l_infoCred T_infoCred;
BEGIN
  /*Inicializa os valores*/
  IF (p_codplf = 0) THEN
    l_limite_fx := 6;
  ELSE
    l_limite_fx := 50;
  END IF;
  l_idtpes     := LTRIM(RTRIM(p_idtpes));
  l_counter    := 0;
  l_fxstr      := '';
  l_data_atual := CURDATE();
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_tippes     := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,1,2));
  l_numemp     := 0;
  l_numemp_out := 0;
  l_tipcol     := 0;
  l_numcad     := 0;
  l_numcad_out := 0;
  l_tipdoc     := 0;
  l_numdoc     := '';
  l_tipdoc_res := 0;
  l_numdoc_res := '';
  l_nummat     := '';
  l_propac     := '';
  /* BUSCA OS CAMPOS CHAVE DE ACORDO COM IDTPES */
  /*Colaborador*/
  IF (l_tippes < 4) THEN
    l_numemp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
    l_tipcol := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,1));
    l_numcad := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,8,9));
  ELSE
    /*Visitante*/
    IF (l_tippes = 4) THEN
      l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
      l_numdoc := SUBSTRING(l_idtpes,4,20);
    ELSE
      /*Outras unidades*/
      IF (l_tippes = 5) THEN
        l_numemp_out := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,4));
        l_numcad_out := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,7,9));
      ELSE
          /* Aluno */
        IF (l_tippes = 10) THEN
          l_nummat := SUBSTRING(l_idtpes,3,15);
        ELSE
          /* Responsável Aluno */
          IF (l_tippes = 7) THEN
            l_tipdoc_res := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
            l_numdoc_res := SUBSTRING(l_idtpes,4,20);
          ELSE
            /* Paciente */
            IF (l_tippes = 9) THEN
              l_propac := SUBSTRING(l_idtpes,3,20);
            ELSE
              IF (l_tippes = 11) THEN
                l_tipdoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtpes,3,1));
                l_numdoc := SUBSTRING(l_idtpes,4,20);
              END IF;
            END IF;
          END IF;
        END IF;
      END IF;
    END IF;
  END IF;

  IF (l_tippes > 0) THEN
    /*Lê os registros para montar o retorno*/
    FOREACH c_r070CRX INTO  l_infoCred.salatu,
                            l_infoCred.inifai,
                            l_infoCred.fimfai,
                            l_infoCred.qtdcon,
                            l_infoCred.datcon,
                            l_infoCred.limcon,
                            l_infoCred.tippes,
                            l_infoCred.horcon
    LOOP
      /*Garante que somente tipo de pessoa igual é adcionada*/
      IF (l_infoCred.tippes = l_tippes) THEN
        /*caso a data de consumo sejá nula, assume data zero*/
        IF (l_infoCred.datcon IS NULL) THEN
          l_infoCred.datcon := l_data_zero;
        END IF;

        IF (l_infoCred.salatu <= 0) THEN
          l_salatu_str := '000';
        ELSE
          SP_INTSTR(l_infoCred.salatu,'999',l_salatu_str OUT);
        END IF;

        SP_INTSTR(l_infoCred.inifai,'HHMM',l_inifai_str OUT);
        SP_INTSTR(l_infoCred.fimfai,'HHMM',l_fimfai_str OUT);
        SP_INTSTR(l_infoCred.qtdcon,'999',l_qtdcon_str OUT);
        SP_DATSTR(l_infoCred.datcon,'DDMMYYYY',l_datcon_str OUT);
        SP_INTSTR(l_infoCred.limcon,'99',l_limcon_str OUT);
        SP_INTSTR(l_infoCred.horcon,'HHMM',l_horcon_str OUT);

        IF ( (l_horcon_str = '') OR (l_horcon_str IS NULL) ) THEN
          l_horcon_str := '0000'; 
        END IF;

        /*SE ALGUMA INFORMAÇÃO ESTIVER NÃO NULA/VAZIA, ADCIONA*/
        IF    ( ( (l_salatu_str <> '') OR (l_salatu_str IS NOT NULL) ) OR
                ( (l_inifai_str <> '') OR (l_inifai_str IS NOT NULL) ) OR
                ( (l_fimfai_str <> '') OR (l_fimfai_str IS NOT NULL) ) OR
                ( (l_qtdcon_str <> '') OR (l_qtdcon_str IS NOT NULL) ) OR
                ( (l_datcon_str <> '') OR (l_datcon_str IS NOT NULL) ) OR
                ( (l_horcon_str <> '') OR (l_horcon_str IS NOT NULL) ) OR
                ( (l_limcon_str <> '') OR (l_limcon_str IS NOT NULL) ) ) THEN
          /* adciona as informações do crédito */
          l_fxstr := l_fxstr || l_salatu_str || l_inifai_str || l_fimfai_str || l_qtdcon_str || l_datcon_str || l_limcon_str || l_horcon_str;
          l_counter := l_counter + 1;
          
          /*Atingiu o limite*/
          IF (l_counter = l_limite_fx) THEN
            EXIT;
          END IF;

        END IF;
      END IF;
    END LOOP;
  END IF;

  p_qtdfx := l_counter;
  p_fxstr := l_fxstr;
END␀¶ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
8␀␀PROCEDURE SP_RETCRO(P_NUMEMP NUMBER,P_NUMCAD NUMBER,P_CREFX1 OUT CHAR(2),P_FX1 OUT CHAR(8),P_CREFX2 OUT CHAR(2),P_FX2 OUT CHAR(8),P_CREFX3 OUT CHAR(2),P_FX3 OUT CHAR(8),P_CREFX4 OUT CHAR(2),P_FX4 OUT CHAR(8),P_CREFX5 OUT CHAR(2),P_FX5 OUT CHAR(8),P_CREFX6 OUT CHAR(2),P_FX6 OUT CHAR(8))
 IS
BEGIN
  NULL;
END		SENIOR;20SP_INTSTR
␀␀


/*
 * Retorna as faixas de créditos para local físico zero(funcionamento global de créditos) para Colaboradores Outras Unidades
 */
PROCEDURE SP_RETCRO(P_NUMEMP NUMBER,P_NUMCAD NUMBER,P_CREFX1 OUT CHAR(2),P_FX1 OUT CHAR(8),P_CREFX2 OUT CHAR(2),P_FX2 OUT CHAR(8),P_CREFX3 OUT CHAR(2),P_FX3 OUT CHAR(8),P_CREFX4 OUT CHAR(2),P_FX4 OUT CHAR(8),P_CREFX5 OUT CHAR(2),P_FX5 OUT CHAR(8),P_CREFX6 OUT CHAR(2),P_FX6 OUT CHAR(8))
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_verplf      NUMBER(3);
  l_codplf      NUMBER(7);
  l_inifai      CHAR(4);
  l_fimfai      CHAR(4);
  l_faixa       CHAR(8);
  l_salatu      CHAR(2);
  l_crefx1      CHAR(2);
  l_fx1         CHAR(8);
  l_crefx2      CHAR(2);
  l_fx2         CHAR(8);
  l_crefx3      CHAR(2);
  l_fx3         CHAR(8);
  l_crefx4      CHAR(2);
  l_fx4         CHAR(8);
  l_crefx5      CHAR(2);
  l_fx5         CHAR(8);
  l_crefx6      CHAR(2);
  l_fx6         CHAR(8);

  CURSOR c_r070CRO IS
       SELECT INIFAI,FIMFAI,SALATU
         FROM R070CRO
        WHERE R070CRO.NUMEMP = p_numemp
          AND R070CRO.NUMCAD = p_numcad
          AND R070CRO.DATINI <= l_data_atual
          AND (R070CRO.DATFIM = l_data_zero OR R070CRO.DATFIM > l_data_atual OR R070CRO.DATFIM = l_data_atual)
          AND R070CRO.VERPLF = l_verplf
          AND R070CRO.CODPLF = l_codplf;

  TYPE t_r070CRO IS RECORD(
    INIFAI   R070CRO.INIFAI%TYPE,
    FIMFAI   R070CRO.FIMFAI%TYPE,
    SALATU   R070CRO.SALATU%TYPE);
  l_r070CRO t_r070CRO;


BEGIN
  /* Inicializa */
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';

  /*Busca versão do plano ativa*/
  l_codplf := 0;
  BEGIN
      SELECT VERPLF INTO l_verplf
        FROM R058VPL
       WHERE DATCRI <= l_data_atual
         AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
  EXCEPTION
      WHEN OTHERS THEN
          l_verplf := 1;
  END;

  l_crefx1 := '00';
  l_fx1 := '24002400';
  l_crefx2 := '00';
  l_fx2 := '24002400';
  l_crefx3 := '00';
  l_fx3 := '24002400';
  l_crefx4 := '00';
  l_fx4 := '24002400';
  l_crefx5 := '00';
  l_fx5 := '24002400';
  l_crefx6 := '00';
  l_fx6 := '24002400';

  FOREACH c_r070CRO INTO  l_r070CRO.inifai,
                          l_r070CRO.fimfai,
                          l_r070CRO.salatu
  LOOP
     SP_INTSTR(l_r070CRO.inifai,'HHMM',l_inifai OUT);
     SP_INTSTR(l_r070CRO.fimfai,'HHMM',l_fimfai OUT);

     IF (l_r070CRO.salatu > 0) THEN
        SP_INTSTR(l_r070CRO.salatu,'99',l_salatu OUT);
     ELSE
        l_salatu := 0;
     END IF;

     l_faixa := l_inifai || l_fimfai;

     IF    l_fx1 = '24002400' THEN
           l_fx1 := l_faixa;
           l_crefx1 := l_salatu;
     ELSIF l_fx2 = '24002400' THEN
           l_fx2 := l_faixa;
           l_crefx2 := l_salatu;
     ELSIF l_fx3 = '24002400' THEN
           l_fx3 := l_faixa;
           l_crefx3 := l_salatu;
     ELSIF l_fx4 = '24002400' THEN
           l_fx4 := l_faixa;
           l_crefx4 := l_salatu;
     ELSIF l_fx5 = '24002400' THEN
           l_fx5 := l_faixa;
           l_crefx5 := l_salatu;
     ELSIF l_fx6 = '24002400' THEN
           l_fx6 := l_faixa;
           l_crefx6 := l_salatu;
     END IF;

  END LOOP;

  p_crefx1 := l_crefx1;
  p_fx1 := l_fx1;
  p_crefx2 := l_crefx2;
  p_fx2 := l_fx2;
  p_crefx3 := l_crefx3;
  p_fx3 := l_fx3;
  p_crefx4 := l_crefx4;
  p_fx4 := l_fx4;
  p_crefx5 := l_crefx5;
  p_fx5 := l_fx5;
  p_crefx6 := l_crefx6;
  p_fx6 := l_fx6;
END		SENIOR;21SP_INTSTR
␀␀


