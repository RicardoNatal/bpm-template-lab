TRIGGER R058RLG_EU AFTER UPDATE ON R058RLG FOR EACH ROW

DECLARE
  l_gerpen      BOOLEAN;
  l_stadsp      NUMBER(1);
  l_coddsp_str  VARCHAR2(9);
  l_codplt      NUMBER(5);
  l_codrlg      NUMBER(5);
  l_plfcon      CHAR(1);
  l_stalfc      NUMBER(1);

  /* CURSOR c/ as leitoras dos dispositivos gerenciadores */
  CURSOR c_r058dsp_ins IS SELECT LEC.CODDSP, DSP.VERPLF, DSP.PLFENT, DSP.PLFSAI FROM R058LEC LEC, R058DSP DSP WHERE LEC.CODDSP = DSP.CODDSP AND LEC.CODPLT = l_codplt AND LEC.CODRLG = l_codrlg AND DSP.STADSP = 1;
  TYPE t_r058dsp IS RECORD(
    CODDSP   R058DSP.CODDSP%TYPE,
    VERPLF   R058DSP.VERPLF%TYPE,
    PLFENT   R058DSP.PLFENT%TYPE,
    PLFSAI   R058DSP.PLFSAI%TYPE);

  l_r058dsp t_r058dsp;

BEGIN
    IF ((:NEW.CODPLT <> :OLD.CODPLT) OR
        (:NEW.CODRLG <> :OLD.CODRLG) OR
        (:NEW.MODRLG <> :OLD.MODRLG) OR
        (:NEW.CODDSP <> :OLD.CODDSP) OR
        (:NEW.TIPLEI <> :OLD.TIPLEI) OR
        (:NEW.COMRLG <> :OLD.COMRLG) OR
        (:NEW.CODCEN <> :OLD.CODCEN) OR
        (:NEW.RLGALF <> :OLD.RLGALF) OR
        (:NEW.NUMEIP <> :OLD.NUMEIP) OR
        (:NEW.SISGER <> :OLD.SISGER)) THEN
            RH_250ALT(23);
    END IF;

    /* Caso não tenha registro na tabela R058DSP com o mesmo código da tabela R058RLG, considera como dispositivo ativo (LStaDsp = 1)*/
    BEGIN
        SELECT STADSP INTO l_stadsp FROM R058DSP WHERE CODDSP = :NEW.CODDSP;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN l_stadsp := 1;
        WHEN OTHERS THEN l_stadsp := 1;
    END;

    /* Verifica o status do dispositivo (R058DSP.STADSP), pois só será gerada pendência caso o dispositivo esteja ativo no sistema */
    IF (l_stadsp = 1) THEN
        l_gerpen := FALSE;

        IF (((:OLD.COMRLG = 2 AND :NEW.COMRLG <> 2) OR (:OLD.COMRLG <> 2 AND :NEW.COMRLG = 2)) OR /* Comunicação passou para, ou deixou de ser, 2 - On-Line*/
            (:NEW.NUMEIP <> :OLD.NUMEIP) OR
            (:NEW.NUMFIS <> :OLD.NUMFIS) OR
            (:NEW.PORCOM <> :OLD.PORCOM)) THEN
            l_gerpen := TRUE;
        END IF;

        IF (l_gerpen = TRUE) THEN
            SP_INTSTR(:NEW.CODDSP, '999999999', l_coddsp_str OUT);
            SP_SAM_PENDENCIES(23, 2, l_coddsp_str);
        END IF;
    END IF;

    l_codplt := :NEW.CODPLT;
    l_codrlg := :NEW.CODRLG;

    IF (l_stadsp = 1) THEN
        /* Verifica se o dispositivo é Telemática, pois pendências para disps. Telemática são geradas com o status 1 - Pendente */
        BEGIN
            SELECT 1 INTO l_stalfc FROM R058MOD WHERE MODRLG = :NEW.MODRLG AND FABMOD = 1;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_stalfc := 0;
            WHEN OTHERS THEN
                l_stalfc := 0;
        END;

        FOREACH c_r058dsp_ins INTO l_r058dsp.CODDSP, l_r058dsp.VERPLF, l_r058dsp.PLFENT, l_r058dsp.PLFSAI
        LOOP
            IF (:NEW.COMRLG IS NOT NULL AND :NEW.COMRLG = 2) THEN
                IF (l_r058dsp.PLFENT IS NOT NULL) THEN
                    /* Incluir no novo PLFENT*/
                    BEGIN
                        SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = l_r058dsp.VERPLF AND CODPLF = l_r058dsp.PLFENT;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            l_plfcon := 'N';
                    END;

                    IF (l_plfcon = 'S') THEN
                        SP_PENDLFC(l_r058dsp.CODDSP, l_r058dsp.VERPLF, l_r058dsp.PLFENT, 'I', l_stalfc);
                    END IF;
                END IF;
                IF ((l_r058dsp.PLFSAI IS NOT NULL) AND (l_r058dsp.PLFENT IS NULL OR l_r058dsp.PLFSAI <> l_r058dsp.PLFENT)) THEN
                    /* Incluir no novo PLFSAI*/
                    BEGIN
                        SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = l_r058dsp.VERPLF AND CODPLF = l_r058dsp.PLFSAI;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            l_plfcon := 'N';
                    END;

                    IF (l_plfcon = 'S') THEN
                        SP_PENDLFC(l_r058dsp.CODDSP, l_r058dsp.VERPLF, l_r058dsp.PLFSAI, 'I', l_stalfc);
                    END IF;
                END IF;
            ELSE
                IF (l_r058dsp.PLFENT IS NOT NULL) THEN
                    /* Remover do antigo PLFENT*/
                    BEGIN
                        SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = l_r058dsp.VERPLF AND CODPLF = l_r058dsp.PLFENT;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            l_plfcon := 'N';
                    END;

                    IF (l_plfcon = 'S') THEN
                        SP_PENDLFC(l_r058dsp.CODDSP, l_r058dsp.VERPLF, l_r058dsp.PLFENT, 'E', l_stalfc);
                    END IF;
                END IF;
                IF ((l_r058dsp.PLFSAI IS NOT NULL) AND (l_r058dsp.PLFENT IS NULL OR l_r058dsp.PLFSAI <> l_r058dsp.PLFENT)) THEN
                    /* Remover do antigo PLFSAI*/
                    BEGIN
                        SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = l_r058dsp.VERPLF AND CODPLF = l_r058dsp.PLFSAI;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            l_plfcon := 'N';
                    END;

                    IF (l_plfcon = 'S') THEN
                        SP_PENDLFC(l_r058dsp.CODDSP, l_r058dsp.VERPLF, l_r058dsp.PLFSAI, 'E', l_stalfc);
                    END IF;
                END IF;
            END IF;
        END LOOP;
    END IF;
END␀Ø␀␀		SENIOR;0Y

TRIGGER R058RLG_ED AFTER DELETE ON R058RLG FOR EACH ROW

BEGIN
RH_250ALT(23);
END␀␀␀®.␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Ø␀␀C-·␀	␀␀␀␀␀␀~=¿␀␀¿␀␀t␀Æÿ␀␀ı×␀␀␀5-·␀	␀␀␀␀␀␀\A“␀“␀s␀Æÿ␀␀ë×␀␀␀x-·␀	␀␀␀␀␀␀#@¥.¥.u␀Æÿ␀␀Ø␀␀␀\ ␀␀±␀	␀␀␀␀␀␀&¡␀␀&¡␀␀&¡␀␀q␀Æÿ␀␀ÿ␀m,Ì␀	␀␀␀␀␀␀N@N@N@{␀Æÿ␀␀…×␀␀␀,±␀␀␀␀␀␀␀
=llq␀Æÿ␀␀ÿ␀␀␀␀	0;1;2;3;4Ø␀␀		SENIOR;0␀␀TRIGGER R058RLP_EI AFTER INSERT ON R058RLP FOR EACH ROW
DECLARE
    l_verplf NUMBER(3);
    l_codplf NUMBER(7);
    l_temrec NUMBER(1);
    alfmen   VARCHAR2(255);

BEGIN
    /* Ao incluir um dispositivo em uma permissão:
       - Pego o local físico do dispositivo, e vejo se é um local físico alfandegado (recinto alfandegado);
       - Se sim, verifico se este recinto alfandegado já está associado à permissão;
         - Se ainda não está associado, incluo a associação permissão x recinto alfandegado. */
    BEGIN
       SELECT DSP.VERPLF, DSP.CODPLF INTO l_verplf, l_codplf
        FROM R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE DSP.CODDSP = :NEW.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF AND PLF.CATPLF = 9
         AND PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3;
    EXCEPTION WHEN OTHERS THEN
        l_verplf := 0;
        l_codplf := 0;
    END;

    IF (l_codplf > 0) THEN
        BEGIN
            SELECT 1 INTO l_temrec FROM R058PRR 
             WHERE CODPRM = :NEW.CODPRM AND VERPLF = l_verplf AND CODPLF = l_codplf;
        EXCEPTION
            WHEN OTHERS THEN l_temrec := 0;
        END;

        IF (l_temrec <> 1) THEN
            BEGIN
                INSERT INTO R058PRR (CODPRM, VERPLF, CODPLF)
                     VALUES (:NEW.CODPRM, l_verplf, l_codplf);
            EXCEPTION WHEN OTHERS THEN
                alfmen := 'R058RLP_EI: Erro ao inserir associação entre permissão e local físico. Permissão: '
                      || CONVERT(NUMBER_TO_CHAR, :NEW.CODPRM) || '. Versão: ' || CONVERT(NUMBER_TO_CHAR, l_verplf)
                      || '. Cód. Local Físico: ' || CONVERT(NUMBER_TO_CHAR, l_codplf);
                RAISERROR 103 alfmen;
            END;
        END IF;
    END IF;
END␀Ø␀␀		SENIOR;0+	␀␀

TRIGGER R058RLP_ED AFTER DELETE ON R058RLP FOR EACH ROW
DECLARE
    l_verplf NUMBER(3);
    l_codplf NUMBER(7);
    l_temrlp NUMBER(1);
    l_temgrp NUMBER(1);
    alfmen   VARCHAR2(255);

BEGIN
    /* Ao remover um dispositivo de uma permissão:
       - Pego o local físico do dispositivo, e vejo se é um local físico alfandegado (recinto alfandegado);
       - Se sim, verifico se existem outros dispositivos ou grupos de dispositivos nessa permissão que dão acesso a este recinto alfandegado;
         - Se não existe mais nenhum dispositivo ligado ao recinto alfandegado, excluo da associação permissão x recinto alfandegado. */
    BEGIN
       SELECT DSP.VERPLF, DSP.CODPLF INTO l_verplf, l_codplf
        FROM R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE DSP.CODDSP = :OLD.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF AND PLF.CATPLF = 9
         AND PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3;
    EXCEPTION WHEN OTHERS THEN
        l_verplf := 0;
        l_codplf := 0;
    END;

    IF (l_codplf > 0) THEN
        BEGIN
           SELECT 1 INTO l_temrlp FROM R058RLP RLP, R058DSP DSP
            WHERE RLP.CODDSP = DSP.CODDSP
              AND RLP.CODPRM = :OLD.CODPRM AND DSP.VERPLF = l_verplf AND DSP.CODPLF = l_codplf;
        EXCEPTION
            WHEN OTHERS THEN l_temrlp := 0;
        END;

        BEGIN
           SELECT 1 INTO l_temgrp FROM R058GRP GRP, R058GRL GRL, R058DSP DSP
            WHERE GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP
              AND GRP.CODPRM = :OLD.CODPRM AND DSP.VERPLF = l_verplf AND DSP.CODPLF = l_codplf;
        EXCEPTION
            WHEN OTHERS THEN l_temgrp := 0;
        END;

        IF (l_temrlp = 0 AND l_temgrp = 0) THEN
            BEGIN
                DELETE FROM R058PRR WHERE CODPRM = :OLD.CODPRM AND VERPLF = l_verplf AND CODPLF = l_codplf;
            EXCEPTION WHEN OTHERS THEN
                alfmen := 'R058RLP_ED: Erro ao excluir associação entre permissão e local físico. Permissão: '
                      || CONVERT(NUMBER_TO_CHAR, :OLD.CODPRM) || '. Versão: ' || CONVERT(NUMBER_TO_CHAR, l_verplf)
                      || '. Cód. Local Físico: ' || CONVERT(NUMBER_TO_CHAR, l_codplf);
                RAISERROR 103 alfmen;
            END;
        END IF;
    END IF;
END␀␀␀°.␀␀␀␀␀␀Ø␀␀} ␀␀´␀	␀␀␀␀␀␀æ@*¡␀␀*¡␀␀r␀Æÿ␀␀Í×␀␀␀\ ␀␀±␀	␀␀␀␀␀␀&¡␀␀&¡␀␀&¡␀␀q␀Æÿ␀␀ÿ␀ß␀.	␀␀␀␀␀␀␀␀␀n␀Æÿ␀␀ÿ␀…-õ	␀␀␀␀␀␀>=‚;‚;q␀Æÿ␀␀ÿ␀SUE␀␀␀␀␀␀¾W␀W␀WG␀␀ÿ␀␀ÿ␀ê	␀´␀␀␀␀␀␀␀
