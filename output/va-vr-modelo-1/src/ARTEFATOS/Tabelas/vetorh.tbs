Ë␀␀CREATE PROCEDURE SP_PENDPAL(@P_CODDSP INTEGER, @P_TIPOPE CHAR(1), @P_NUMFIS BIGINT, @P_TECCRA SMALLINT, @P_IDTPES CHAR(23)) AS
BEGIN
	DECLARE @l_count SMALLINT

	SELECT @l_count=COUNT(*)
	FROM R070PAL
	WHERE TIPOPE=@P_TIPOPE AND NUMFIS=@P_NUMFIS AND TECCRA=@P_TECCRA AND IDTPES=@P_IDTPES

	IF @l_count = 0
	BEGIN
		INSERT INTO R070PAL(CODDSP, TIPOPE, NUMFIS, TECCRA, IDTPES) VALUES (@P_CODDSP, @P_TIPOPE, @P_NUMFIS, @P_TECCRA, @P_IDTPES);
	END
END	MSSQL;23
Ë␀␀CREATE PROCEDURE SP_PENDPAL(@P_CODDSP INTEGER, @P_TIPOPE CHAR(1), @P_NUMFIS BIGINT, @P_TECCRA SMALLINT, @P_IDTPES CHAR(23)) AS
BEGIN
	DECLARE @l_count SMALLINT

	SELECT @l_count=COUNT(*)
	FROM R070PAL
	WHERE TIPOPE=@P_TIPOPE AND NUMFIS=@P_NUMFIS AND TECCRA=@P_TECCRA AND IDTPES=@P_IDTPES

	IF @l_count = 0
	BEGIN
		INSERT INTO R070PAL(CODDSP, TIPOPE, NUMFIS, TECCRA, IDTPES) VALUES (@P_CODDSP, @P_TIPOPE, @P_NUMFIS, @P_TECCRA, @P_IDTPES);
