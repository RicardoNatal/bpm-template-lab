                                             R034FUN.NUMCAD = VFP_CONJUGES.NUMCAD)
     LEFT OUTER JOIN VFP_FILHOS ON R034FUN.NUMEMP = VFP_FILHOS.NUMEMP AND
                                   R034FUN.TIPCOL = VFP_FILHOS.TIPCOL AND
                                   R034FUN.NUMCAD = VFP_FILHOS.NUMCAD)
     LEFT OUTER JOIN VFP_PARENTES ON R034FUN.NUMEMP = VFP_PARENTES.NUMEMP AND
                                    R034FUN.TIPCOL = VFP_PARENTES.TIPCOL AND
                                    R034FUN.NUMCAD = VFP_PARENTES.NUMCAD)(VFP_CONJUGES
