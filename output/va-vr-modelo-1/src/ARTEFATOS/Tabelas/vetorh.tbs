K-␀␀PROCEDURE SP_LFUSOMARCACAO(P_FUSO NUMBER(4), P_LFUSO OUT NUMBER(2))
 IS

    l_lfuso NUMBER(2);

BEGIN
    l_lfuso := 0;

    IF (p_fuso <= -720) THEN
        l_lfuso := 1;
    ELSE
        IF (p_fuso > -720) AND (p_fuso <= -660) THEN
            l_lfuso := 2;
        ELSE
            IF (p_fuso > -660) AND (p_fuso <= -600) THEN
                l_lfuso := 3;
            ELSE
                IF (p_fuso > -600) AND (p_fuso <= -540) THEN
                    l_lfuso := 4;
                ELSE
                    IF (p_fuso > -540) AND (p_fuso <= -480) THEN
                        l_lfuso := 5;
                    ELSE
                        IF (p_fuso > -480) AND (p_fuso <= -420) THEN
                            l_lfuso := 6;
                        ELSE
                            IF (p_fuso > -420) AND (p_fuso <= -360) THEN
                                l_lfuso := 7;
                            ELSE
                                IF (p_fuso > -360) AND (p_fuso <= -300) THEN
                                    l_lfuso := 8;
                                ELSE
                                    IF (p_fuso > -300) AND (p_fuso <= -240) THEN
                                        l_lfuso := 9;
                                    ELSE
                                        IF (p_fuso > -240) AND (p_fuso <= -210) THEN
                                            l_lfuso := 10;
                                        ELSE
                                            IF (p_fuso > -210) AND (p_fuso <= -180) THEN
                                                l_lfuso := 11;
                                            ELSE
                                                IF (p_fuso > -180) AND (p_fuso <= -120) THEN
                                                    l_lfuso := 12;
                                                ELSE
                                                    IF (p_fuso > -120) AND (p_fuso <= -60) THEN
                                                        l_lfuso := 13;
                                                    ELSE
                                                        IF (p_fuso > -60) AND (p_fuso <= 0) THEN
                                                            l_lfuso := 14;
                                                        ELSE
                                                            IF (p_fuso > 0) AND (p_fuso <= 60) THEN
                                                                l_lfuso := 15;
                                                            ELSE
                                                                IF (p_fuso > 60) AND (p_fuso <= 120) THEN
                                                                    l_lfuso := 16;
                                                                ELSE
                                                                    IF (p_fuso > 120) AND (p_fuso <= 180) THEN
                                                                        l_lfuso := 17;
                                                                    ELSE
                                                                        IF (p_fuso > 180) AND (p_fuso <= 210) THEN
                                                                            l_lfuso := 18;
                                                                        ELSE
                                                                            IF (p_fuso > 210) AND (p_fuso <= 240) THEN
                                                                                l_lfuso := 19;
                                                                            ELSE
                                                                                IF (p_fuso > 240) AND (p_fuso <= 270) THEN
                                                                                    l_lfuso := 20;
                                                                                ELSE
                                                                                    IF (p_fuso > 270) AND (p_fuso <= 300) THEN
                                                                                        l_lfuso := 21;
                                                                                    ELSE
                                                                                        IF (p_fuso > 300) AND (p_fuso <= 330) THEN
                                                                                            l_lfuso := 22;
                                                                                        ELSE
                                                                                            IF (p_fuso > 330) AND (p_fuso <= 345) THEN
                                                                                                l_lfuso := 23;
                                                                                            ELSE
                                                                                                IF (p_fuso > 345) AND (p_fuso <= 360) THEN
                                                                                                    l_lfuso := 24;
                                                                                                ELSE
                                                                                                    IF (p_fuso > 360) AND (p_fuso <= 390) THEN
                                                                                                        l_lfuso := 25;
                                                                                                    ELSE
                                                                                                        IF (p_fuso > 390) AND (p_fuso <= 420) THEN
                                                                                                            l_lfuso := 26;
                                                                                                        ELSE
                                                                                                            IF (p_fuso > 420) AND (p_fuso <= 480) THEN
                                                                                                                l_lfuso := 27;
                                                                                                            ELSE
                                                                                                                IF (p_fuso > 460) AND (p_fuso <= 540) THEN
                                                                                                                    l_lfuso := 28;
                                                                                                                ELSE
                                                                                                                    IF (p_fuso > 540) AND (p_fuso <= 570) THEN
                                                                                                                        l_lfuso := 29;
                                                                                                                    ELSE
                                                                                                                        IF (p_fuso > 570) AND (p_fuso <= 600) THEN
                                                                                                                            l_lfuso := 30;
                                                                                                                        ELSE
                                                                                                                            IF (p_fuso > 600) AND (p_fuso <= 660) THEN
                                                                                                                                l_lfuso := 31;
                                                                                                                            ELSE
                                                                                                                                IF (p_fuso > 660) AND (p_fuso <= 720) THEN
                                                                                                                                    l_lfuso := 32;
                                                                                                                                ELSE
                                                                                                                                    IF (p_fuso > 720) AND (p_fuso <= 780) THEN
                                                                                                                                        l_lfuso := 33;
                                                                                                                                    END IF;
                                                                                                                                END IF;
                                                                                                                            END IF;
                                                                                                                        END IF;
                                                                                                                    END IF;
                                                                                                                END IF;
                                                                                                            END IF;
                                                                                                        END IF;
                                                                                                    END IF;
                                                                                                END IF;
                                                                                            END IF;
                                                                                        END IF;
                                                                                    END IF;
                                                                                END IF;
                                                                            END IF;
                                                                        END IF;
                                                                    END IF;
                                                                END IF;
                                                            END IF;
                                                        END IF;
                                                    END IF;
                                                END IF;
                                            END IF;
                                        END IF;
                                    END IF;
                                END IF;
                            END IF;
                        END IF;
                    END IF;
                END IF;
            END IF;
        END IF;
    END IF;

    p_lfuso := l_lfuso;
END␀^ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
