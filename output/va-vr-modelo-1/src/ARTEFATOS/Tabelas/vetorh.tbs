      IF (@NEW_TELCON<>@OLD_TELCON)
      BEGIN
        SELECT @l_alterou = 1
        SELECT @l_camposAlterados = @l_camposAlterados+'TELCON '
      END
      IF (@NEW_SEGTDO<>@OLD_SEGTDO)
      BEGIN
        SELECT @l_alterou = 1
        SELECT @l_camposAlterados = @l_camposAlterados+'SEGTDO '
      END
      IF (@NEW_SEGDOC<>@OLD_SEGDOC)
      BEGIN
        SELECT @l_alterou = 1
        SELECT @l_camposAlterados = @l_camposAlterados+'SEGDOC '
