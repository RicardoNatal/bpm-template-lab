DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs - Filiais - Base das Liminares */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 55;     /* Filiais - Base das Liminares */
  l_codtpa := 221;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030LFB_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
        SP_DATSTR(:NEW.CMPLIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPLIM', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODLIM', CONVERT(NUMBER_TO_CHAR, :NEW.CODLIM));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TABEVE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQLIM', CONVERT(NUMBER_TO_CHAR, :NEW.SEQLIM));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030LFB_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPLIM', CONVERT(NUMBER_TO_CHAR, :NEW.TIPLIM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CODEVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CRTEVE', :NEW.CRTEVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPINC', CONVERT(NUMBER_TO_CHAR, :NEW.TIPINC));
      END;
  END IF; 
END␀cÒ␀␀		SENIOR;0¸␀␀ 

TRIGGER R030LFB_EU AFTER UPDATE ON R030LFB FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs - Filiais - Base das Liminares */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 55;     /* Filiais - Base das Liminares */
  l_codtpa := 222;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFil <> :NEW.CodFil)
   OR (:OLD.CmpLim <> :NEW.CmpLim)
   OR (:OLD.CodLim <> :NEW.CodLim)
   OR (:OLD.TabEve <> :NEW.TabEve)
   OR (:OLD.SeqLim <> :NEW.SeqLim)
   OR (:OLD.TipLim <> :NEW.TipLim)
   OR (:OLD.CodEve <> :NEW.CodEve)
   OR (:OLD.CrtEve <> :NEW.CrtEve)
   OR (:OLD.TipInc <> :NEW.TipInc)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030LFB_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        SP_DATSTR(:OLD.CMPLIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CMPLIM', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODLIM', CONVERT(NUMBER_TO_CHAR, :OLD.CODLIM));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :OLD.TABEVE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQLIM', CONVERT(NUMBER_TO_CHAR, :OLD.SEQLIM));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030LFB_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPLIM', CONVERT(NUMBER_TO_CHAR, :OLD.TIPLIM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPLIM', CONVERT(NUMBER_TO_CHAR, :NEW.TIPLIM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODEVE', CONVERT(NUMBER_TO_CHAR, :OLD.CODEVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CODEVE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCRTEVE', :OLD.CRTEVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCRTEVE', :NEW.CRTEVE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPINC', CONVERT(NUMBER_TO_CHAR, :OLD.TIPINC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPINC', CONVERT(NUMBER_TO_CHAR, :NEW.TIPINC));
      END;
    END IF; 
  END IF; 
END␀aÒ␀␀		SENIOR;0g␀␀ 

