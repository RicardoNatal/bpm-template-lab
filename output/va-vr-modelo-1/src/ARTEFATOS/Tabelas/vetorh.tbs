s␀␀CREATE  PROCEDURE SP_FORDAT(@p_data CHAR(8), @p_hora CHAR(4), @p_datetime DATETIME OUTPUT) AS
BEGIN
  DECLARE @ChkError INTEGER
  SELECT @ChkError = 0
  SELECT @p_datetime = CONVERT(DATETIME,SUBSTRING(@p_data,3,2)+'/'+SUBSTRING(@p_data,1,2)+'/'+SUBSTRING(@p_data,5,4)+' '+SUBSTRING(@p_hora,1,2)+':'+SUBSTRING(@p_hora,3,2)+':00',101)
FIM:
  RETURN @ChkError
END

␀:ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_E_SOCIAL
SP_ESOCIAL_INFO
¨␀␀PROCEDURE SP_FUNCAOESOCIAL(P_TABELA VARCHAR2(7),P_ESTCAR NUMBER(4),P_CODCAR VARCHAR2(24),P_VALOR VARCHAR2(2000), P_DATAALTERACAO DATE, P_PROXIMADATA DATE, P_DATENC DATE)
 IS


  l_data_atual  DATE;
    
CURSOR C_EMPRESA IS SELECT DISTINCT NUMEMP FROM R350FUN WHERE ESTCAR = P_ESTCAR AND CODCAR = P_CODCAR AND ENVVAL = 'S' ORDER BY NUMEMP;
	TYPE T_EMPRESA IS RECORD (NUMEMP   R350FUN.NUMEMP%TYPE);
	EMPRESA_CARGO T_EMPRESA;
CURSOR C_EMPRESA_HISTORICO_FUNCAO IS SELECT R030DES.NUMEMP FROM R030DES 
                                     WHERE (EXISTS (SELECT 1 FROM R034MAT, R038HFU 
                                                    WHERE R034MAT.NUMEMP = R030DES.NUMEMP AND R034MAT.NUMEMP = R038HFU.NUMEMP AND R034MAT.TIPCOL = R038HFU.TIPCOL 
                                     			   AND R034MAT.NUMCAD = R038HFU.NUMCAD AND R038HFU.ESTCAR = P_ESTCAR AND R038HFU.CODCAR = P_CODCAR AND R038HFU.FUNESO = 'S'
                                     			   AND NOT EXISTS (SELECT 1 FROM R038AFA AFA1, R010SIT SIT 
                                     			   	               WHERE AFA1.NUMEMP = R034MAT.NUMEMP 
                                     			   	               AND AFA1.TIPCOL = R034MAT.TIPCOL 
                                     			   	               AND AFA1.NUMCAD = R034MAT.NUMCAD 
                                     			   	               AND AFA1.DATAFA <= l_data_atual 
                                     			   	               AND SIT.CODSIT = AFA1.SITAFA 
                                     			   	               AND SIT.TIPSIT = 7)) 
                                     	   OR EXISTS (SELECT 1 FROM R034MAT, R038HCA 
                                     	              WHERE R034MAT.NUMEMP = R030DES.NUMEMP AND R034MAT.NUMEMP = R038HCA.NUMEMP AND R034MAT.TIPCOL = R038HCA.TIPCOL 
                                     				  AND R034MAT.NUMCAD = R038HCA.NUMCAD AND R038HCA.ESTCAR = P_ESTCAR AND R038HCA.CODCAR = P_CODCAR AND R038HCA.FUNESO = 'S'
                                     				  AND NOT EXISTS (SELECT 1 FROM R038AFA AFA1, R010SIT SIT 
                                     			   	               WHERE AFA1.NUMEMP = R034MAT.NUMEMP 
                                     			   	               AND AFA1.TIPCOL = R034MAT.TIPCOL 
                                     			   	               AND AFA1.NUMCAD = R034MAT.NUMCAD 
                                     			   	               AND AFA1.DATAFA <= l_data_atual 
                                     			   	               AND SIT.CODSIT = AFA1.SITAFA 
                                     			   	               AND SIT.TIPSIT = 7))
                                     	   OR EXISTS (SELECT 1 FROM R034MAT, R038HPO, R017POS, R017CAR
                                     	              WHERE R034MAT.NUMEMP = R030DES.NUMEMP AND R034MAT.NUMEMP = R038HPO.NUMEMP AND R034MAT.TIPCOL = R038HPO.TIPCOL
                                     				  AND R034MAT.NUMCAD = R038HPO.NUMCAD AND R038HPO.FUNESO = 'S'
                                     				  AND R038HPO.ESTPOS = R017POS.ESTPOS AND R038HPO.POSTRA = R017POS.POSTRA
                                     				  AND R017POS.ESTPOS = R017CAR.ESTPOS AND R017POS.POSTRA = R017CAR.POSTRA
                                     				  AND R017CAR.ESTCAR = P_ESTCAR AND R017CAR.CODCAR = P_CODCAR
                                     				  AND NOT EXISTS (SELECT 1 FROM R038AFA AFA1, R010SIT SIT 
                                     			   	               WHERE AFA1.NUMEMP = R034MAT.NUMEMP 
                                     			   	               AND AFA1.TIPCOL = R034MAT.TIPCOL 
                                     			   	               AND AFA1.NUMCAD = R034MAT.NUMCAD 
                                     			   	               AND AFA1.DATAFA <= l_data_atual 
                                     			   	               AND SIT.CODSIT = AFA1.SITAFA 
                                     			   	               AND SIT.TIPSIT = 7)))
                                     AND ((R030DES.SIMFOL > DATETIME(31, 12, 1900, 0, 0, 0) AND l_data_atual >= R030DES.SIMFOL) OR (l_data_atual > (SELECT FIMSIM FROM R030DAT WHERE GRUESO = 0))) 
                                     ORDER BY NUMEMP;
	TYPE T_EMPRESA_HISTORICO_FUNCAO IS RECORD (NUMEMP   R038HFU.NUMEMP%TYPE);
	EMPRESA_HISTORICO_FUNCAO T_EMPRESA_HISTORICO_FUNCAO;
  l_InfoFacult   BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
    /* Inicializa */
    l_data_atual := CURDATE();
    
	FOREACH C_EMPRESA_HISTORICO_FUNCAO INTO EMPRESA_HISTORICO_FUNCAO.NUMEMP
	LOOP
		SP_E_SOCIAL('S-1040', P_TABELA, 'T', 'A', P_DATAALTERACAO, P_PROXIMADATA, EMPRESA_HISTORICO_FUNCAO.NUMEMP, 0, 0, P_VALOR, '', 0, P_DATENC, NULL, 0, 'SP_FUNCAOESOCIAL');	
	END LOOP;
	
	FOREACH C_EMPRESA INTO EMPRESA_CARGO.NUMEMP
	LOOP
		l_InfoFacult := TRUE;
        l_SimplificaoESocial := FALSE;
        l_VersaoESocial := 0;
        SP_ESOCIAL_INFO(EMPRESA_CARGO.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
		IF (l_SimplificaoESocial = FALSE) THEN
			SP_E_SOCIAL('S-1040', P_TABELA, 'T', 'A', P_DATAALTERACAO, P_PROXIMADATA, EMPRESA_CARGO.NUMEMP, 0, 0, P_VALOR, '', 0, P_DATENC, NULL, 0, 'SP_FUNCAOESOCIAL');
		END IF;	
	END LOOP;
END␀;ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_ISINFORMIX
«␀␀PROCEDURE SP_GERAPOSTO(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9))
 IS

l_UsaPos        R000ASS.USAPOS%TYPE;
  l_TapDef        R000ASS.TAPDEF%TYPE;
  l_MotDef        R000ASS.MOTDEF%TYPE;

  l_UsaPEm        R030EMP.USAPEM%TYPE;
  l_UsaPTe        R030EMP.USAPTE%TYPE;
  l_UsaPPa        R030EMP.USAPPA%TYPE;    

  l_EstPos        R030POS.ESTPOS%TYPE;
  l_PosDef        R030POS.POSDEF%TYPE;

  l_data_zero   DATE;
  l_TerAtu      DATE;
  l_Count       NUMBER;              /* Contador de Histórico de Posto */
  l_DatAdm        R034FUN.DATADM%TYPE;
  l_isInformix  BOOLEAN;             /* Flag Informix */
BEGIN
  /* Verifica se existe posto de trabalhado cadastrado para o colaborador */  
  BEGIN
    SELECT COUNT(*) INTO l_Count FROM R038HPO WHERE NUMEMP = p_NumEmp AND TIPCOL = p_TipCol AND NUMCAD = p_NumCad;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao retornar o Data de Admissão - R034FUN';
  END;

  /* Se não existir histórico de Posto Cadastrado então verifica se deve inserir posto padrão */
  IF (l_Count = 0) THEN
    /*data zerada*/
    l_data_zero  := '31/12/1900,00:00:00';

    /* INÍCIO DO CONTROLE DE HISTÓRICO DE POSTO DE TRABALHO */
    /* Verifica assinalamentos para ver se a rotina de Posto de Trabalho foi habilitata */
    BEGIN
      SELECT IFNULL(USAPOS, 'N'),IFNULL(TAPDEF, 0),IFNULL(MOTDEF, 0) INTO l_UsaPos,l_TapDef,l_MotDef FROM R000ASS;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R000ASS';
    END;

    /* Valida Tipo de atuação padrão e Motivo de Alteração padrão */
    IF (l_TapDef = 0) OR (l_MotDef = 0) THEN
      RAISERROR 103 'Tipo de atuação padrão e Motivo de alteração padrão estão zerados. É Necessário informar Tipo de atuação padrão e Motivo de alteração padrão nos Assinalamentos diversos.';
    END IF;

    /* Verifica se Empresa NÃO usa Posto */
    BEGIN
      /* 2 - Não  */
      SELECT IFNULL(USAPEM, 2),IFNULL(USAPTE, 2),IFNULL(USAPPA, 2) INTO l_UsaPEm,l_UsaPTe,l_UsaPPa
        FROM R030EMP WHERE NUMEMP = p_NumEmp;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R030EMP';
    END;

    /* Somente se estiver assinalado para NÃO usar Posto de Trabalho(R000ASS.USAPOS = N)
      OU assinalado para Usar posto (R000ASS.USAPOS = S) E Empresa definida para NÃO usar */
    IF (l_UsaPos = 'N') OR
       ((l_UsaPos = 'S') AND
        (((p_TipCol = 1) AND (l_UsaPEm = 2)) OR
         ((p_TipCol = 2) AND (l_UsaPTe = 2)) OR
         ((p_TipCol = 3) AND (l_UsaPPa = 2)))) THEN
      /* Retorna Data de Admissao */
      BEGIN
        SELECT DATADM INTO l_DatAdm FROM R034FUN WHERE NUMEMP = p_NumEmp AND TIPCOL = p_TipCol AND NUMCAD = p_NumCad;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao retornar Data de Admissão - R034FUN';
      END;

      /* Retorna Estrutura e Posto Padrão */
      BEGIN
        SELECT IFNULL(ESTPOS, 0),IFNULL(POSDEF, ' ') INTO l_EstPos,l_PosDef FROM R030POS
         WHERE NUMEMP = p_NumEmp
           AND DATALT = (SELECT MAX(DATALT) FROM R030POS
                          WHERE NUMEMP = p_NumEmp AND DATALT <= l_DatAdm);
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_EstPos := 0;
          l_PosDef := ' ';
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler R030POS';
      END;

      /* Valida Tipo de atuação padrão e Motivo de Alteração padrão */
      IF (l_EstPos = 0) OR (l_PosDef = ' ') THEN
        RAISERROR 103 'Não foi possível encontrar o Posto de trabalho padrão para a empresa do Colaborador na sua data de admissão.';
      END IF;

      /* Retorna se está sendo executado via informix */
      /* Tratamento feito devido a limitação do banco informix (Erro -747), */
      /* não é possivel executar duas trigger's de statement para o mesmo registro */
      RH_ISINFORMIX(l_isInformix OUT);
      IF (l_isInformix = TRUE) THEN
        l_TerAtu := '04/06/2080,00:00:00';
      ELSE
        l_TerAtu := l_data_zero;
      END IF;

      BEGIN
        /* Inserir na R038HPO - Posto Padrão */
        INSERT INTO R038HPO (NUMEMP,TIPCOL,NUMCAD,INIATU,SEQHIS,CODTAP,MOTALT,ESTPOS,POSTRA,TERATU,OBSHPO,STAHIS,TIPSBS,CADSBS,PERADI)
                     VALUES (p_NumEmp,p_TipCol,p_NumCad,l_DatAdm, 1,
                             l_TapDef,l_MotDef,l_EstPos,l_PosDef,l_TerAtu,
                             'Este histórico de posto de trabalho foi gerado pelo sistema para definir um Posto de trabalho padrão para o Colaborador.',1, 0, 0, 0);
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao Inserir R038HPO. (SP_GERAPOSTO)';
      END;

      /* Se Informix, Atualiza posto de trabalho da R034FUN */
      IF (l_isInformix = TRUE) THEN
        BEGIN
          UPDATE R034FUN
             SET ESTPOS = l_EstPos,
                 POSTRA = l_PosDef,
                 CODTAP = l_TapDef,
                 DATPOS = l_DatAdm
           WHERE R034FUN.NUMEMP = p_NumEmp AND
                 R034FUN.TIPCOL = p_TipCol AND
                 R034FUN.NUMCAD = p_NumCad;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R034FUN campos dos posto. (SP_GERAPOSTO)';
        END;
      END IF;
    END IF; /* FIM - POSTO DE TRABALHO */
  END IF;
END␀<ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
˜␀␀PROCEDURE SP_GERAR_PEN_S2500 (P_NUMEMP NUMBER(4), P_TIPCOL NUMBER(1), P_NUMCAD NUMBER(9), P_CODPRO NUMBER(9), P_GERAR_PENDENCIA OUT BOOLEAN)
IS

	l_CodAca NUMBER;
	l_OriInf NUMBER;
BEGIN
    l_CodAca := 0;
    l_OriInf := 0;

	BEGIN
		SELECT CODACA, ORIINF 
		  INTO l_CodAca, l_OriInf
		  FROM R346CPT
		 WHERE NUMEMP = P_NUMEMP
		   AND TIPCOL = P_TIPCOL
		   AND NUMCAD = P_NUMCAD
		   AND CODPRO = P_CODPRO;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar informações do processo trabalhista.';
	END;
   
    P_GERAR_PENDENCIA := TRUE;
	IF (l_CodAca > 0 AND l_OriInf = 2) THEN
		P_GERAR_PENDENCIA := FALSE;
	END IF;
END␀=ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Ã␀␀PROCEDURE SP_GERAR_PEN_S2501 (P_NUMEMP NUMBER(4), P_TIPCOL NUMBER(1), P_NUMCAD NUMBER(9), P_CODPRO NUMBER(9), P_CMPPAG DATE, P_GERAR_PENDENCIA OUT BOOLEAN)
IS

	l_CodAca NUMBER;
	l_OriInf NUMBER;
BEGIN
    l_CodAca := 0;
    l_OriInf := 0;

	BEGIN
		SELECT CODACA, ORIINF 
		  INTO l_CodAca, l_OriInf
		  FROM R346TPT
		 WHERE NUMEMP = P_NUMEMP
		   AND TIPCOL = P_TIPCOL
		   AND NUMCAD = P_NUMCAD
		   AND CODPRO = P_CODPRO
		   AND CMPPAG = P_CMPPAG;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar informações do processo trabalhista.';
	END;
   
    P_GERAR_PENDENCIA := TRUE;
	IF (l_CodAca > 0 AND l_OriInf = 2) THEN
		P_GERAR_PENDENCIA := FALSE;
	END IF;
END␀>ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
