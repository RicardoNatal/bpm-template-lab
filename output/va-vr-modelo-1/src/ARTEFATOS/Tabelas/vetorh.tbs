          /* Apaga todos os registros antes de inserir os novos */
          IF  l_nodatafound = FALSE THEN
              BEGIN
                l_comando := 'DELETE FROM '||l_usutel||'CONTFUNC WHERE ICARD = '''||l_icardA||'''';
                SP_CMDTSI(l_comando);
              EXCEPTION
                  WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no delete tabela CONTFUNC.';
              END;

              FOREACH c_r058frc INTO l_r058frc.codfra      /* Le Registro do CURSOR */
              /* Insere registros na tabela ContFunc */
              LOOP
                  SP_INTSTR(l_r058frc.codfra,'99',l_codfun OUT);
                  BEGIN
                    l_comando := 'INSERT INTO '||l_usutel||'CONTFUNC (ICARD,CODFUNC) VALUES ('''||l_icardA||''','''||l_codfun||''')';
                    SP_CMDTSI(l_comando);
                  EXCEPTION
                      WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no INSERT Tabela CONTFUNC.';
                  END;
              END LOOP;
          END IF;
      ELSE
          BEGIN
            l_comando := 'DELETE FROM '||l_usutel||'CONTFUNC WHERE ICARD = '''||l_icardA||'''';
            SP_CMDTSI(l_comando);
          EXCEPTION
              WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no delete tabela CONTFUNC.';
          END;
      END IF;
  END IF;
