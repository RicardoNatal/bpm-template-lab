œ PROCEDURE SP_AUDGETVERSEQ(PSEQREGIN NUMBER(15),PSEQREGOUT OUT NUMBER(15),PVERSEQ OUT NUMBER(10))
 IS
BEGIN
  pSeqRegOUT  := 0;
  pVerSeq     := 0;
END		SENIOR;20SP_AUDGETSEQREG
¼␀␀


 PROCEDURE SP_AUDGETVERSEQ(PSEQREGIN NUMBER(15),PSEQREGOUT OUT NUMBER(15),PVERSEQ OUT NUMBER(10))
 IS
BEGIN
  pSeqRegOUT  := pSeqRegIN;
  pVerSeq     := 0;

  IF (pSeqRegIN = 0) OR (pSeqRegIN IS NULL) THEN
      SP_AudGetSeqReg(pSeqRegOUT OUT);
      pVerSeq	:= 0;
  ELSE
      BEGIN
          SELECT MAX(VerSeq) + 1 INTO pVerSeq  FROM R151REG WHERE SEQREG = pSeqRegIN;
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SP_AUDGETVERSEQ. Erro ao gerar a versão do registro. ';
      END;

      IF ((pVerSeq IS NULL) OR (pSeqRegOUT < 1)) THEN
          RAISERROR 103 'SP_AUDGETVERSEQ. Registro alterado não possui histórico de alteração.';
      END IF;
  END IF;
END		SENIOR;21SP_AUDGETSEQREG
¼␀␀


