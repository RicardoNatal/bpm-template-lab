TRIGGER R110CID_AU
AFTER UPDATE ON R110CID
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4); /* Código da categoria de auditoria*/
  l_codtpa NUMBER(4); /* Código do tipo de auditoria - Alteração*/
  l_datTemp VARCHAR(10);
BEGIN
  IF (
  :OLD.CODDOE <>:NEW.CODDOE OR 
  :OLD.PRIDEF <>:NEW.PRIDEF OR 
  :OLD.CODATE <>:NEW.CODATE OR
  :OLD.CODDOE <>:NEW.CODDOE
  ) THEN
    l_codSistema:= 1;
    l_codcpa:= 140;  /* Código da categoria de auditoria - CID-10*/
    l_codtpa:= 412;  /* Código do tipo de auditoria - Alteração*/

    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110CID_AU', '');

      /* Insere os campos chave na tabela de auditoria R995PRC*/
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:OLD.CODFIC));
        SP_DATSTR(:OLD.DATATE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATATE', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORATE', CONVERT(NUMBER_TO_CHAR,:OLD.HORATE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDOE',:OLD.CODDOE);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSUB',:OLD.CODSUB);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110CID_AU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      /* Insere os valores dos campos na tabela de auditoria R995PRT*/
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPRIDEF',:OLD.PRIDEF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPRIDEF',:NEW.PRIDEF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODATE', CONVERT(NUMBER_TO_CHAR,:OLD.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODATE', CONVERT(NUMBER_TO_CHAR,:NEW.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODDOE',:OLD.CODDOE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODDOE',:NEW.CODDOE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODSUB',:OLD.CODSUB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODSUB',:NEW.CODSUB);        
      END;
    END IF;
  END IF;
END␀-ß␀␀		SENIOR;02␀␀

