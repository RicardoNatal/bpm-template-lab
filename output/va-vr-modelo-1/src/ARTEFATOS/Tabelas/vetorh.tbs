DECLARE
  l_temAud BOOLEAN;
  l_codrpa NUMBER(15);
  l_datTemp VARCHAR(10);
BEGIN  
/* Log - Rastreamento */

  SP_EXISTE_LOG(27, 167, 1, l_temAud OUT);
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, 27, 1, 167, 1, 'R026PLF_EI', 'FR026IRF'); 

    BEGIN  
      SP_DATSTR(:NEW.PERREF, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERREF', l_datTemp);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFAI', CONVERT(NUMBER_TO_CHAR, :NEW.CODFAI));
    EXCEPTION
  	  WHEN OTHERS THEN RAISERROR 103 'R026PLF_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;      
  
    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LIMFAI', CONVERT(NUMBER_TO_CHAR, :NEW.LIMFAI));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERFAI', CONVERT(NUMBER_TO_CHAR, :NEW.PERFAI));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESFAI', CONVERT(NUMBER_TO_CHAR, :NEW.DESFAI));
    END;      
  END IF;    
/* Log - Rastreamento */
END␀§Ñ␀␀		SENIOR;0*␀␀

TRIGGER R026PLF_EU AFTER UPDATE ON R026PLF FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codrpa NUMBER(15);
  l_datTemp VARCHAR(10);
BEGIN
/* Log - Rastreamento */
  IF ((:OLD.PerRef <> :NEW.PerRef)
  OR (:OLD.CodFai <> :NEW.CodFai)
  OR (:OLD.LimFai <> :NEW.LimFai)
  OR (:OLD.PerFai <> :NEW.PerFai)
  OR (:OLD.DesFai <> :NEW.DesFai)) THEN
    SP_EXISTE_LOG(27, 168, 1, l_temAud OUT);
    IF (l_temAud = TRUE) THEN
		SP_RET_REG_AUD(l_codrpa OUT);
        SP_INS_REG_AUD(l_codrpa, 1, 27, 1, 168, 1, 'R026PLF_EI', 'FR026IRF'); 
        
        BEGIN
          SP_DATSTR(:OLD.PERREF, 'DD/MM/YYYY', l_datTemp OUT);
          INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERREF', l_datTemp);
          INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFAI', CONVERT(NUMBER_TO_CHAR, :OLD.CODFAI));     
        EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'R026PLF_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
        END;
        
        BEGIN
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDLIMFAI', CONVERT(NUMBER_TO_CHAR, :OLD.LIMFAI));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWLIMFAI', CONVERT(NUMBER_TO_CHAR, :NEW.LIMFAI));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERFAI', CONVERT(NUMBER_TO_CHAR, :OLD.PERFAI));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERFAI', CONVERT(NUMBER_TO_CHAR, :NEW.PERFAI));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDESFAI', CONVERT(NUMBER_TO_CHAR, :OLD.DESFAI));
          INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDESFAI', CONVERT(NUMBER_TO_CHAR, :NEW.DESFAI));
        END;
    END IF;
  END IF;
/* Log - Rastreamento */
END␀¥Ñ␀␀		SENIOR;0½␀␀

