        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMCAN', CONVERT(NUMBER_TO_CHAR,:NEW.NUMCAN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODDEP', CONVERT(NUMBER_TO_CHAR,:OLD.CODDEP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODDEP', CONVERT(NUMBER_TO_CHAR,:NEW.CODDEP));
      END;
