TRIGGER R346IVL_EU BEFORE UPDATE ON R346IVL FOR EACH ROW
DECLARE
	l_Valor VARCHAR2(2000);
	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_JsonCamposAlterados VARCHAR2(2000);
	l_VersaoESocial NUMBER;
	l_isGerarPendencia BOOLEAN;
BEGIN
  l_Valor := '';
  l_VersaoESocial := 0;
  l_JsonCamposAlterados := '';

  SP_GERAR_PEN_S2501(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODPRO, :NEW.CMPPAG, l_isGerarPendencia OUT);
  
  IF (l_isGerarPendencia = TRUE) THEN
	SP_ESOCIAL_S250X(:NEW.NUMEMP, :NEW.CMPPAG, l_VersaoESocial OUT);

	IF (l_VersaoESocial >= 6) THEN
		SP_VALUPDATE_NUM(:OLD.INDAPU, :NEW.INDAPU, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('INDAPU', :NEW.INDAPU, :OLD.INDAPU, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_NUM(:OLD.VLRNRE, :NEW.VLRNRE, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_FLO_JSON('VLRNRE', :NEW.VLRNRE, :OLD.VLRNRE, 2, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_NUM(:OLD.VLRDJU, :NEW.VLRDJU, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_FLO_JSON('VLRDJU', :NEW.VLRDJU, :OLD.VLRDJU, 2, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_NUM(:OLD.VLRANC, :NEW.VLRANC, l_Valido OUT);
