  /*Entra somente quando for o crachá principal.*/
  /*SP_DELINSCRA70ACR se encarrega de enviar comando para todos os números físicos do crachá titular e provisório(se tiver)*/
  IF ((l_enviar = TRUE) AND (l_Pend23 = TRUE) AND (:NEW.ChcPri = 0)) THEN
      SP_DELINSCRA70ACR('D', :NEW.VERPRM, :NEW.CodPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                             :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRt3,
                             :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis,
                             2, 1, 0, :OLD.CodPrm, :OLD.PrmSab, :OLD.PrmDom, :OLD.PrmFer,
                             :OLD.PrmRt1, :OLD.PrmRt2, :OLD.PrmRt3, l_newnumcpf);

      SP_DELINSCRA70ACR('I', :NEW.VERPRM, :NEW.CodPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                             :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRT3,
