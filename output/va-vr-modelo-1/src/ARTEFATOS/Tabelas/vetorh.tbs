!J␀␀

PROCEDURE SP_PENDAce62(P_TIPOPE VARCHAR2(1),P_NUMCRA NUMBER(12),P_NUMFIS NUMBER(12),P_TECCRA NUMBER(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1),P_TIPCRA NUMBER(1),
	                   P_CODPRMOLD NUMBER(5),P_PRMSABOLD NUMBER(5),P_PRMDOMOLD NUMBER(5),P_PRMFEROLD NUMBER(5),
	                   P_PRMRT1OLD NUMBER(5),P_PRMRT2OLD NUMBER(5),P_PRMRT3OLD NUMBER(5),P_NUMCPF NUMBER(11)
)
 IS

  l_datatu        DATE;
  l_horatu        NUMBER(4);
  l_datstr        CHAR(6);
  l_horstr        CHAR(4);
  l_datAux        CHAR(10);
  l_ValAux        CHAR(10);
  l_datenv        CHAR(16);
  l_count         NUMBER;
  l_insere        BOOLEAN;
  l_anostr        CHAR(2);
  l_tipope        VARCHAR2(1);
  l_coddsp        CHAR(9);
  l_Straux        VARCHAR2(2047);
  l_CenPen        VARCHAR2(1);
  l_data_atual    DATE;
  l_hora_atual    NUMBER(4);
  l_seqenv        NUMBER(2);
  l_seqstr        CHAR(2);
  l_gersen        BOOLEAN;
  l_numfis        CHAR(12);
  l_teccra        NUMBER(1);
  l_tcraux        CHAR(1);
  l_idtpes        VARCHAR2(23);
  l_tamnom        NUMBER(3);
  l_tamnom_str    CHAR(3);
  l_nomfun        VARCHAR2(40);
  l_numId         CHAR(11);
  l_numpis        CHAR(11);
  l_numcpf        CHAR(11);
  l_altbio        CHAR(1);
  l_cpf_repleg_str CHAR(11);

  /* busca dispositivos SDK, não REPs, verificando todas permissões */
  CURSOR c_r058prm IS
  SELECT DISTINCT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN, B.AUTPES
         FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F, R058CEN Z
         WHERE
         (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = B.CODDSP AND F.STADSP = 1     /*Dispositivo deve estar ativo*/
		 AND (B.AUTPES = 'S' OR B.AUTPES = 'L')
         AND Z.CODCEN = B.CODCEN AND Z.DATUMC IS NOT NULL
		 
         AND A.CODDSP NOT IN (
		    SELECT DISTINCT A.CODDSP
		      FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F
		     WHERE A.CODPRM IN (p_CodPrmOLD,
		                        p_PrmSabOLD,
		                        p_PrmDomOLD,
		                        p_PrmFerOLD,
		                        p_PrmRt1OLD,
		                        p_PrmRt2OLD,
		                        p_PrmRt3OLD)
		       AND A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND B.MODRLG = D.MODRLG
		       AND B.COMRLG = 2
		       AND D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
		       AND ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2)
		       AND F.CODDSP = B.CODDSP AND F.STADSP = 1 AND (B.AUTPES = 'S' OR B.AUTPES = 'L')
		 )
		 
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN, C.AUTPES
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DSP F, R058CEN Z
         WHERE (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND
         Z.CODCEN = C.CODCEN AND Z.DATUMC IS NOT NULL AND          
         D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
         F.CODDSP = C.CODDSP AND F.STADSP = 1 AND  /*Dispositivo deve estar ativo*/
         (C.AUTPES = 'S' OR C.AUTPES = 'L'));

  TYPE t_r058prm IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm t_r058prm;

  /* busca todos os dispositivos SDK, indepentende de permissão*/
  CURSOR c_r058prm2 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN, A.AUTPES
         FROM R058RLG A, R058MOD B, R058DSP F, R058CEN Z
         WHERE A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND 
               B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
              ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2) AND /*ou Digicon*/
			   F.CODDSP = A.CODDSP AND F.STADSP = 1 AND
			   (A.AUTPES = 'S' OR A.AUTPES = 'L')   /*Dispositivo deve estar ativo*/
			   AND Z.CODCEN = A.CODCEN AND Z.DATUMC IS NOT NULL

         AND A.CODDSP NOT IN
           (SELECT DISTINCT A.CODDSP A_CODDSP
              FROM R058RLG A, R058MOD B, R058DSP F, R058RLP M
             WHERE A.MODRLG = B.MODRLG
               AND A.COMRLG = 2
               AND M.CODPLT = A.CODPLT
               AND M.CODRLG = A.CODRLG
               AND M.CODPRM IN (p_CodPrmOLD,
                                p_PrmSabOLD,
                                p_PrmDomOLD,
                                p_PrmFerOLD/*,
                                p_PrmRt1OLD,
                                p_PrmRt2OLD,
                                p_PrmRt3OLD*/)
               AND B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR
                   B.FABMOD = 2)
               AND F.CODDSP = A.CODDSP
               AND F.STADSP = 1
               AND (A.AUTPES = 'S' OR A.AUTPES = 'L'));

  TYPE t_r058prm2 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm2 t_r058prm2;

  /* CURSOR para gerar a lista de exclusão
   o primeiro parãmetro p_codprm não é o codprm normal
   é usado a primeira posição como parâmtro da permissão que vai mudar
   os outros parâmetros são as demais permissões que ele tem
   busca dispositivos SDK que estão na permissão informada no primeiro parâmetro p_CodPrm */
  CURSOR c_r058prm3 IS
  SELECT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN, B.AUTPES
         FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F, R058CEN Z
         WHERE
         (A.CODPRM IN (p_CodPrmOLD, p_PrmSabOLD, p_PrmDomOLD, p_PrmFerOLD /*, p_PrmRt1OLD, p_PrmRt2OLD, p_PrmRt3OLD*/) OR (p_tipcra = 8)) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         Z.CODCEN = B.CODCEN AND Z.DATUMC IS NOT NULL AND
		 D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = B.CODDSP AND F.STADSP = 1 AND  /*Dispositivo deve estar ativo*/
		 (B.AUTPES = 'S' OR B.AUTPES = 'L')

         AND A.CODDSP NOT IN
           (SELECT E.CODDSP E_CODDSP
              FROM R058RLP E, R058RLG F, R058MOD H, R058DSP K
             WHERE E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer/*,
                                p_PrmRt1, p_PrmRt2, p_PrmRt3*/)
               AND E.CODPLT = F.CODPLT
               AND E.CODRLG = F.CODRLG
               AND F.MODRLG = H.MODRLG
               AND F.COMRLG = 2
               AND H.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((H.FABMOD > 2 AND H.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR H.FABMOD = 2)
               AND K.CODDSP = F.CODDSP
               AND K.STADSP = 1
               AND (F.AUTPES = 'S' OR F.AUTPES = 'L'))
		 
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN, C.AUTPES
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DSP F, R058CEN Z
         WHERE (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND
         Z.CODCEN = C.CODCEN AND Z.DATUMC IS NOT NULL AND 
		 D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = C.CODDSP AND F.STADSP = 1 AND   /*Dispositivo deve estar ativo*/
         (C.AUTPES = 'S' OR C.AUTPES = 'L')
         
         AND C.CODDSP NOT IN
           (SELECT F.CODDSP F_CODDSP
              FROM R058RLP E, R058RLG F, R058MOD H, R058DSP K
             WHERE E.CODPRM IN (p_CodPrmOLD, p_PrmSabOLD, p_PrmDomOLD, p_PrmFerOLD,
                                p_PrmRt1OLD, p_PrmRt2OLD, p_PrmRt3OLD)
               AND E.CODPLT = F.CODPLT
               AND E.CODRLG = F.CODRLG
               AND F.MODRLG = H.MODRLG
               AND F.COMRLG = 2
               AND H.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((H.FABMOD > 2 AND H.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR H.FABMOD = 2)
               AND K.CODDSP = F.CODDSP
               AND K.STADSP = 1
               AND (F.AUTPES = 'S' OR F.AUTPES = 'L'))
  );

  TYPE t_r058prm3 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm3 t_r058prm3;


  /* CURSOR para buscar todos os dispositivos SDK que não
  estão na permissão, para gerar delete ao trocar VERPRM */
  CURSOR c_r058prm4 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN, A.AUTPES
        FROM R058RLG A, R058MOD B, R058DSP F, R058CEN Z
        WHERE
        A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND
		B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
        ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2) AND /*ou Digicon*/
        F.CODDSP = A.CODDSP AND F.STADSP = 1 AND /*Dispositivo deve estar ativo*/
        (A.AUTPES = 'S' OR A.AUTPES = 'L') AND
        Z.CODCEN = A.CODCEN AND Z.DATUMC IS NOT NULL

        AND NOT EXISTS 
          (SELECT C.CODPLT, C.CODRLG 
          	 FROM R058RLP C 
            WHERE C.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND A.CODPLT = C.CODPLT AND A.CODRLG = C.CODRLG
          )
        AND NOT EXISTS 
          (SELECT D.CODPLT, D.CODRLG 
          	 FROM R058GRL D, R058GRP E 
            WHERE E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) 
              AND E.CODGRR = D.CODGRR AND A.CODPLT = D.CODPLT AND A.CODRLG = D.CODRLG 
              AND ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2)
          );

  
  TYPE t_r058prm4 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm4 t_r058prm4;

BEGIN
   SP_GERSEN(l_gersen OUT);
   l_CenPen:= '0';

   l_data_atual := CURDATE();
   l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

   SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
   SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);

   /*Obtem o Segundo*/
   l_seqenv := SECOND(CURTIME());
   SP_INTSTR(l_seqenv, '99', l_seqstr OUT);

   l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

   /*Número Crachá*/
   SP_INTSTR(p_numfis,'999999999999',l_numfis OUT);

   /*Tecnologia do Crachá*/
   l_teccra := p_teccra;
   SP_INTSTR(l_teccra,'9',l_tcraux OUT);

   /*Identificador da Pessoa*/
   l_idtpes := p_idtpes;

   /*Responsável Legal pela alteração*/
   SP_INTSTR(0, '99999999999', l_cpf_repleg_str OUT);
   
   /*Nome da Pessoa*/
   l_nomfun := p_nomfun;
   l_nomfun := lTrim(l_nomfun);
   l_nomfun := rTrim(l_nomfun);
   
   /*tamanho do Nome da pessoa*/
   l_tamnom := Length(l_nomfun);
   SP_INTSTR(l_tamnom,'999',l_tamnom_str OUT);
   SP_INTSTR(p_altbio,'9',l_altbio OUT);

   /* Repasso tambem o PIS e o CPF em campos distintos, 
    * para que a CSM Center não precise adivinhar o documento */
   SP_INTSTR(p_numpis,'99999999999',l_numpis OUT);
   SP_INTSTR(p_numcpf,'99999999999',l_numcpf OUT);

   /* Informa o CPF quando não há PIS (alteração para a portaria 671) */
   IF (p_numpis > 0) THEN
     l_numId := l_numpis;
   ELSE
     l_numId := l_numcpf;
   END IF;
   
   l_datatu    := CURDATE();
   l_horatu    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

   SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
   SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);

   /* data atual string no formato YYMMDDHHmm*/
   l_DatAux := SUBSTRING(l_datstr,5,2)||SUBSTRING(l_datstr,3,2)||SUBSTRING(l_datstr,1,2)||l_horstr;
   /* converte a data de validade no formato string YYMMDDHHmm*/
   l_ValAux :=  SUBSTRING(p_datval,5,2)||SUBSTRING(p_datval,3,2)||SUBSTRING(p_datval,1,2)||SUBSTRING(p_datval,7,4);

   /*Evitar que seja inserido registro INSERT com data passada. Se for I, data validade tem que ser maior igual a data atual*/
   IF (p_tipOpe <> 'I') OR ((p_tipOpe = 'I') AND (l_valAux >= l_DatAux)) THEN
	 /* verifica se é geração da lista de exclusão */
	 IF (p_tipOpe = 'D') OR (p_tipOpe = 'E') THEN
	   /*Parâmetro "D" é usado em todas as exclusões, na TR070CON, exceto na troca do VERPRM.*/
	   /*Gera na R070ACR registros para exclusão, que alteraram alguma permissão*/
	   IF (p_tipOpe = 'D') THEN
		   /* LOOP dos dispositivos que estão dentro da permissão */
		   FOREACH c_r058prm3 INTO l_r058prm3.numeip,
								   l_r058prm3.tiplei,
								   l_r058prm3.coddsp,
								   l_r058prm3.fabmod,
								   l_r058prm3.codcen,
								   l_r058prm3.autpes
								   
		   LOOP
				/* Multitecnologia */
				IF (l_r058prm3.tiplei = 11) THEN
					l_insere := TRUE;
				END IF;

				IF (p_numcra = p_numfis) THEN
				   l_insere := TRUE;
				END IF;

				IF (l_insere = TRUE) THEN
				  IF (l_gersen = TRUE) THEN
					 SP_INTSTR(l_r058prm3.coddsp,'999999999',l_coddsp OUT);
                     
					 /* tipope 1 = remove card */
					 l_tipope := '1';
					 l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
					 
					 IF (l_r058prm3.autpes = 'L') AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm3.codcen);
					 END IF;

				  END IF;
				END IF;
		   END LOOP;
		ELSE
		   /*Passa aqui, quando o parâmetro de exclusão for "E" */
		   /*Parâmetro "E" é passado na troca do VERPRM, caso seja feita alteração de Não para SIM (Verifica Permissão)*/
		   /*Gera na R070ACR registros para exclusão, que estão fora da permissão do colaborador*/
		   /* LOOP dos dispositivos que estão dentro da permissão */
		   FOREACH c_r058prm4 INTO l_r058prm4.numeip,
								   l_r058prm4.tiplei,
								   l_r058prm4.coddsp,
								   l_r058prm4.fabmod,
								   l_r058prm4.codcen,
								   l_r058prm4.autpes
		   LOOP
			   /* trata registro de acordo com a leitora e tecnologia do crachá */
			   l_insere := FALSE;

			   /* Multitecnologia */
			   IF (l_r058prm4.tiplei = 11) THEN
				  l_insere := TRUE;
			   END IF;

			   IF (p_numcra = p_numfis) THEN
				  l_insere := TRUE;
			   END IF;

			   IF (l_insere = TRUE) THEN
				 IF (l_gersen = TRUE) THEN
				   SP_INTSTR(l_r058prm4.coddsp,'999999999',l_coddsp OUT);

				   /* tipope 1 = remove card */
				   l_tipope := '1';
				   l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm4.autpes = 'L') AND (P_TIPOPE <> 'D')  THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm4.codcen);
				     END IF;
				 END IF;
			   END IF;
		   END LOOP;
		END IF;
	 ELSE
		 /* para operação normal de INSERT e delete */
		 IF (p_tipope = 'F') OR (p_tipope = 'D') THEN
		   l_tipope := '1';
		 ELSE
		   l_tipope := '0';
		 END IF;

		 IF (p_verPrm = 1) THEN /* verprm = 'S' */

			 /* LOOP dos dispositivos que estão dentro da permissão*/
			 FOREACH c_r058prm INTO l_r058prm.numeip,
									l_r058prm.tiplei,
									l_r058prm.coddsp,
									l_r058prm.fabmod,
									l_r058prm.codcen,
									l_r058prm.autpes
			 LOOP
				 /* trata registro de acordo com a leitora e tecnologia do crachá */
				 l_insere := FALSE;
				   /* Multitecnologia */
				 IF (l_r058prm.tiplei = 11) THEN
					l_insere := TRUE;
				 END IF;

				 IF (l_insere = TRUE) THEN
					 /*verifica se já existe um registro ainda não enviado para este crachá e dispositivo */
				   IF (l_gersen = TRUE) THEN
					 SP_INTSTR(l_r058prm.coddsp,'999999999',l_coddsp OUT);

					 l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm.autpes = 'L')  AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm.codcen);
  					 END IF;
				   END IF;
				 END IF;
			 END LOOP;
		 ELSE
			 /* se não verifica permissão, gera para todos os dispositivos */
			 FOREACH c_r058prm2 INTO l_r058prm2.numeip,
									 l_r058prm2.tiplei,
									 l_r058prm2.coddsp,
									 l_r058prm2.fabmod,
									 l_r058prm2.codcen,
									 l_r058prm2.autpes
			 LOOP
				 /* trata registro de acordo com a leitora e tecnologia do crachá */
				 l_insere := FALSE;

				 /* Multitecnologia */
				 IF (l_r058prm2.tiplei = 11) THEN
					 l_insere := TRUE;
				 END IF;

				 IF (l_insere = TRUE) THEN
				   IF (l_gersen = TRUE) THEN
					  SP_INTSTR(l_r058prm2.coddsp,'999999999',l_coddsp OUT);
					  l_tipope := '0';
					  l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm2.autpes = 'L')  AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm2.codcen);
					 END IF;
				   END IF;
				 END IF;

			 END LOOP;
		 END IF;
	 END IF;
   END IF;
   
END		SENIOR;20KSP_GERSEN
SP_DATSTR
SP_INTSTR
SP_PORCOMDSP
SP_PENDPAL
SP_RET_RESPLEG
J␀␀

PROCEDURE SP_PENDAce62(P_TIPOPE VARCHAR2(1),P_NUMCRA NUMBER(12),P_NUMFIS NUMBER(12),P_TECCRA NUMBER(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1),P_TIPCRA NUMBER(1),
	                   P_CODPRMOLD NUMBER(5),P_PRMSABOLD NUMBER(5),P_PRMDOMOLD NUMBER(5),P_PRMFEROLD NUMBER(5),
	                   P_PRMRT1OLD NUMBER(5),P_PRMRT2OLD NUMBER(5),P_PRMRT3OLD NUMBER(5),P_NUMCPF NUMBER(11)
)
 IS

  l_datatu        DATE;
  l_horatu        NUMBER(4);
  l_datstr        CHAR(6);
  l_horstr        CHAR(4);
  l_datAux        CHAR(10);
  l_ValAux        CHAR(10);
  l_datenv        CHAR(16);
  l_count         NUMBER;
  l_insere        BOOLEAN;
  l_anostr        CHAR(2);
  l_tipope        VARCHAR2(1);
  l_coddsp        CHAR(9);
  l_Straux        VARCHAR2(2047);
  l_CenPen        VARCHAR2(1);
  l_data_atual    DATE;
  l_hora_atual    NUMBER(4);
  l_seqenv        NUMBER(2);
  l_seqstr        CHAR(2);
  l_gersen        BOOLEAN;
  l_numfis        CHAR(12);
  l_teccra        NUMBER(1);
  l_tcraux        CHAR(1);
  l_idtpes        VARCHAR2(23);
  l_tamnom        NUMBER(3);
  l_tamnom_str    CHAR(3);
  l_nomfun        VARCHAR2(40);
  l_numId         CHAR(11);
  l_numpis        CHAR(11);
  l_numcpf        CHAR(11);
  l_altbio        CHAR(1);
  l_cpf_repleg_str CHAR(11);

  /* busca dispositivos SDK, não REPs, verificando todas permissões */
  CURSOR c_r058prm IS
  SELECT DISTINCT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN, B.AUTPES
         FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F, R058CEN Z
         WHERE
         (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = B.CODDSP AND F.STADSP = 1     /*Dispositivo deve estar ativo*/
		 AND (B.AUTPES = 'S' OR B.AUTPES = 'L')
         AND Z.CODCEN = B.CODCEN AND Z.DATUMC IS NOT NULL
		 
         AND A.CODDSP NOT IN (
		    SELECT DISTINCT A.CODDSP
		      FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F
		     WHERE A.CODPRM IN (p_CodPrmOLD,
		                        p_PrmSabOLD,
		                        p_PrmDomOLD,
		                        p_PrmFerOLD,
		                        p_PrmRt1OLD,
		                        p_PrmRt2OLD,
		                        p_PrmRt3OLD)
		       AND A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND B.MODRLG = D.MODRLG
		       AND B.COMRLG = 2
		       AND D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
		       AND ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2)
		       AND F.CODDSP = B.CODDSP AND F.STADSP = 1 AND (B.AUTPES = 'S' OR B.AUTPES = 'L')
		 )
		 
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN, C.AUTPES
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DSP F, R058CEN Z
         WHERE (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND
         Z.CODCEN = C.CODCEN AND Z.DATUMC IS NOT NULL AND          
         D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
         F.CODDSP = C.CODDSP AND F.STADSP = 1 AND  /*Dispositivo deve estar ativo*/
         (C.AUTPES = 'S' OR C.AUTPES = 'L'));

  TYPE t_r058prm IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm t_r058prm;

  /* busca todos os dispositivos SDK, indepentende de permissão*/
  CURSOR c_r058prm2 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN, A.AUTPES
         FROM R058RLG A, R058MOD B, R058DSP F, R058CEN Z
         WHERE A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND 
               B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
              ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2) AND /*ou Digicon*/
			   F.CODDSP = A.CODDSP AND F.STADSP = 1 AND
			   (A.AUTPES = 'S' OR A.AUTPES = 'L')   /*Dispositivo deve estar ativo*/
			   AND Z.CODCEN = A.CODCEN AND Z.DATUMC IS NOT NULL

         AND A.CODDSP NOT IN
           (SELECT DISTINCT A.CODDSP A_CODDSP
              FROM R058RLG A, R058MOD B, R058DSP F, R058RLP M
             WHERE A.MODRLG = B.MODRLG
               AND A.COMRLG = 2
               AND M.CODPLT = A.CODPLT
               AND M.CODRLG = A.CODRLG
               AND M.CODPRM IN (p_CodPrmOLD,
                                p_PrmSabOLD,
                                p_PrmDomOLD,
                                p_PrmFerOLD/*,
                                p_PrmRt1OLD,
                                p_PrmRt2OLD,
                                p_PrmRt3OLD*/)
               AND B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR
                   B.FABMOD = 2)
               AND F.CODDSP = A.CODDSP
               AND F.STADSP = 1
               AND (A.AUTPES = 'S' OR A.AUTPES = 'L'));

  TYPE t_r058prm2 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm2 t_r058prm2;

  /* CURSOR para gerar a lista de exclusão
   o primeiro parãmetro p_codprm não é o codprm normal
   é usado a primeira posição como parâmtro da permissão que vai mudar
   os outros parâmetros são as demais permissões que ele tem
   busca dispositivos SDK que estão na permissão informada no primeiro parâmetro p_CodPrm */
  CURSOR c_r058prm3 IS
  SELECT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN, B.AUTPES
         FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F, R058CEN Z
         WHERE
         (A.CODPRM IN (p_CodPrmOLD, p_PrmSabOLD, p_PrmDomOLD, p_PrmFerOLD /*, p_PrmRt1OLD, p_PrmRt2OLD, p_PrmRt3OLD*/) OR (p_tipcra = 8)) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         Z.CODCEN = B.CODCEN AND Z.DATUMC IS NOT NULL AND
		 D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = B.CODDSP AND F.STADSP = 1 AND  /*Dispositivo deve estar ativo*/
		 (B.AUTPES = 'S' OR B.AUTPES = 'L')

         AND A.CODDSP NOT IN
           (SELECT E.CODDSP E_CODDSP
              FROM R058RLP E, R058RLG F, R058MOD H, R058DSP K
             WHERE E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer/*,
                                p_PrmRt1, p_PrmRt2, p_PrmRt3*/)
               AND E.CODPLT = F.CODPLT
               AND E.CODRLG = F.CODRLG
               AND F.MODRLG = H.MODRLG
               AND F.COMRLG = 2
               AND H.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((H.FABMOD > 2 AND H.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR H.FABMOD = 2)
               AND K.CODDSP = F.CODDSP
               AND K.STADSP = 1
               AND (F.AUTPES = 'S' OR F.AUTPES = 'L'))
		 
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN, C.AUTPES
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DSP F, R058CEN Z
         WHERE (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND
         Z.CODCEN = C.CODCEN AND Z.DATUMC IS NOT NULL AND 
		 D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = C.CODDSP AND F.STADSP = 1 AND   /*Dispositivo deve estar ativo*/
         (C.AUTPES = 'S' OR C.AUTPES = 'L')
         
         AND C.CODDSP NOT IN
           (SELECT F.CODDSP F_CODDSP
              FROM R058RLP E, R058RLG F, R058MOD H, R058DSP K
             WHERE E.CODPRM IN (p_CodPrmOLD, p_PrmSabOLD, p_PrmDomOLD, p_PrmFerOLD,
                                p_PrmRt1OLD, p_PrmRt2OLD, p_PrmRt3OLD)
               AND E.CODPLT = F.CODPLT
               AND E.CODRLG = F.CODRLG
               AND F.MODRLG = H.MODRLG
               AND F.COMRLG = 2
               AND H.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((H.FABMOD > 2 AND H.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR H.FABMOD = 2)
               AND K.CODDSP = F.CODDSP
               AND K.STADSP = 1
               AND (F.AUTPES = 'S' OR F.AUTPES = 'L'))
  );

  TYPE t_r058prm3 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm3 t_r058prm3;


  /* CURSOR para buscar todos os dispositivos SDK que não
  estão na permissão, para gerar delete ao trocar VERPRM */
  CURSOR c_r058prm4 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN, A.AUTPES
        FROM R058RLG A, R058MOD B, R058DSP F, R058CEN Z
        WHERE
        A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND
		B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
        ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2) AND /*ou Digicon*/
        F.CODDSP = A.CODDSP AND F.STADSP = 1 AND /*Dispositivo deve estar ativo*/
        (A.AUTPES = 'S' OR A.AUTPES = 'L') AND
        Z.CODCEN = A.CODCEN AND Z.DATUMC IS NOT NULL

        AND NOT EXISTS 
          (SELECT C.CODPLT, C.CODRLG 
          	 FROM R058RLP C 
            WHERE C.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND A.CODPLT = C.CODPLT AND A.CODRLG = C.CODRLG
          )
        AND NOT EXISTS 
          (SELECT D.CODPLT, D.CODRLG 
          	 FROM R058GRL D, R058GRP E 
            WHERE E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) 
              AND E.CODGRR = D.CODGRR AND A.CODPLT = D.CODPLT AND A.CODRLG = D.CODRLG 
              AND ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2)
          );

  
  TYPE t_r058prm4 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm4 t_r058prm4;

BEGIN
   SP_GERSEN(l_gersen OUT);
   l_CenPen:= '0';

   l_data_atual := CURDATE();
   l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

   SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
   SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);

   /*Obtem o Segundo*/
   l_seqenv := SECOND(CURTIME());
   SP_INTSTR(l_seqenv, '99', l_seqstr OUT);

   l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

   /*Número Crachá*/
   SP_INTSTR(p_numfis,'999999999999',l_numfis OUT);

   /*Tecnologia do Crachá*/
   l_teccra := p_teccra;
   SP_INTSTR(l_teccra,'9',l_tcraux OUT);

   /*Identificador da Pessoa*/
   l_idtpes := p_idtpes;

   /*Responsável Legal pela alteração*/
   SP_INTSTR(0, '99999999999', l_cpf_repleg_str OUT);
   
   /*Nome da Pessoa*/
   l_nomfun := p_nomfun;
   l_nomfun := lTrim(l_nomfun);
   l_nomfun := rTrim(l_nomfun);
   
   /*tamanho do Nome da pessoa*/
   l_tamnom := Length(l_nomfun);
   SP_INTSTR(l_tamnom,'999',l_tamnom_str OUT);
   SP_INTSTR(p_altbio,'9',l_altbio OUT);

   /* Repasso tambem o PIS e o CPF em campos distintos, 
    * para que a CSM Center não precise adivinhar o documento */
   SP_INTSTR(p_numpis,'99999999999',l_numpis OUT);
   SP_INTSTR(p_numcpf,'99999999999',l_numcpf OUT);

   /* Informa o CPF quando não há PIS (alteração para a portaria 671) */
   IF (p_numpis > 0) THEN
     l_numId := l_numpis;
   ELSE
     l_numId := l_numcpf;
   END IF;

   l_datatu    := CURDATE();
   l_horatu    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

   SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
   SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);

   /* data atual string no formato YYMMDDHHmm*/
   l_DatAux := SUBSTRING(l_datstr,5,2)||SUBSTRING(l_datstr,3,2)||SUBSTRING(l_datstr,1,2)||l_horstr;
   /* converte a data de validade no formato string YYMMDDHHmm*/
   l_ValAux :=  SUBSTRING(p_datval,5,2)||SUBSTRING(p_datval,3,2)||SUBSTRING(p_datval,1,2)||SUBSTRING(p_datval,7,4);

   /*Evitar que seja inserido registro INSERT com data passada. Se for I, data validade tem que ser maior igual a data atual*/
   IF (p_tipOpe <> 'I') OR ((p_tipOpe = 'I') AND (l_valAux >= l_DatAux)) THEN
	 /* verifica se é geração da lista de exclusão */
	 IF (p_tipOpe = 'D') OR (p_tipOpe = 'E') THEN
	   /*Parâmetro "D" é usado em todas as exclusões, na TR070CON, exceto na troca do VERPRM.*/
	   /*Gera na R070ACR registros para exclusão, que alteraram alguma permissão*/
	   IF (p_tipOpe = 'D') THEN
		   /* LOOP dos dispositivos que estão dentro da permissão */
		   FOREACH c_r058prm3 INTO l_r058prm3.numeip,
								   l_r058prm3.tiplei,
								   l_r058prm3.coddsp,
								   l_r058prm3.fabmod,
								   l_r058prm3.codcen,
								   l_r058prm3.autpes
								   
		   LOOP
				/* Multitecnologia */
				IF (l_r058prm3.tiplei = 11) THEN
					l_insere := TRUE;
				END IF;

				IF (p_numcra = p_numfis) THEN
				   l_insere := TRUE;
				END IF;

				IF (l_insere = TRUE) THEN
				  IF (l_gersen = TRUE) THEN
					 SP_INTSTR(l_r058prm3.coddsp,'999999999',l_coddsp OUT);
                     
					 /* tipope 1 = remove card */
					 l_tipope := '1';
					 l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
					 
					 IF (l_r058prm3.autpes = 'L') AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm3.codcen);
					 END IF;

				  END IF;
				END IF;
		   END LOOP;
		ELSE
		   /*Passa aqui, quando o parâmetro de exclusão for "E" */
		   /*Parâmetro "E" é passado na troca do VERPRM, caso seja feita alteração de Não para SIM (Verifica Permissão)*/
		   /*Gera na R070ACR registros para exclusão, que estão fora da permissão do colaborador*/
		   /* LOOP dos dispositivos que estão dentro da permissão */
		   FOREACH c_r058prm4 INTO l_r058prm4.numeip,
								   l_r058prm4.tiplei,
								   l_r058prm4.coddsp,
								   l_r058prm4.fabmod,
								   l_r058prm4.codcen,
								   l_r058prm4.autpes
		   LOOP
			   /* trata registro de acordo com a leitora e tecnologia do crachá */
			   l_insere := FALSE;

			   /* Multitecnologia */
			   IF (l_r058prm4.tiplei = 11) THEN
				  l_insere := TRUE;
			   END IF;

			   IF (p_numcra = p_numfis) THEN
				  l_insere := TRUE;
			   END IF;

			   IF (l_insere = TRUE) THEN
				 IF (l_gersen = TRUE) THEN
				   SP_INTSTR(l_r058prm4.coddsp,'999999999',l_coddsp OUT);

				   /* tipope 1 = remove card */
				   l_tipope := '1';
				   l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm4.autpes = 'L') AND (P_TIPOPE <> 'D')  THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm4.codcen);
				     END IF;
				 END IF;
			   END IF;
		   END LOOP;
		END IF;
	 ELSE
		 /* para operação normal de INSERT e delete */
		 IF (p_tipope = 'F') OR (p_tipope = 'D') THEN
		   l_tipope := '1';
		 ELSE
		   l_tipope := '0';
		 END IF;

		 IF (p_verPrm = 1) THEN /* verprm = 'S' */

			 /* LOOP dos dispositivos que estão dentro da permissão*/
			 FOREACH c_r058prm INTO l_r058prm.numeip,
									l_r058prm.tiplei,
									l_r058prm.coddsp,
									l_r058prm.fabmod,
									l_r058prm.codcen,
									l_r058prm.autpes
			 LOOP
				 /* trata registro de acordo com a leitora e tecnologia do crachá */
				 l_insere := FALSE;
				   /* Multitecnologia */
				 IF (l_r058prm.tiplei = 11) THEN
					l_insere := TRUE;
				 END IF;

				 IF (l_insere = TRUE) THEN
					 /*verifica se já existe um registro ainda não enviado para este crachá e dispositivo */
				   IF (l_gersen = TRUE) THEN
					 SP_INTSTR(l_r058prm.coddsp,'999999999',l_coddsp OUT);

					 l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm.autpes = 'L')  AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm.codcen);
  					 END IF;
				   END IF;
				 END IF;
			 END LOOP;
		 ELSE
			 /* se não verifica permissão, gera para todos os dispositivos */
			 FOREACH c_r058prm2 INTO l_r058prm2.numeip,
									 l_r058prm2.tiplei,
									 l_r058prm2.coddsp,
									 l_r058prm2.fabmod,
									 l_r058prm2.codcen,
									 l_r058prm2.autpes
			 LOOP
				 /* trata registro de acordo com a leitora e tecnologia do crachá */
				 l_insere := FALSE;

				 /* Multitecnologia */
				 IF (l_r058prm2.tiplei = 11) THEN
					 l_insere := TRUE;
				 END IF;

				 IF (l_insere = TRUE) THEN
				   IF (l_gersen = TRUE) THEN
					  SP_INTSTR(l_r058prm2.coddsp,'999999999',l_coddsp OUT);
					  l_tipope := '0';
					  l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm2.autpes = 'L')  AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm2.codcen);
					 END IF;
				   END IF;
				 END IF;

			 END LOOP;
		 END IF;
	 END IF;
   END IF;
   
END		SENIOR;21KSP_GERSEN
SP_DATSTR
SP_INTSTR
SP_PORCOMDSP
SP_PENDPAL
SP_RET_RESPLEG
J␀␀

PROCEDURE SP_PENDAce62(P_TIPOPE VARCHAR2(1),P_NUMCRA NUMBER(12),P_NUMFIS NUMBER(12),P_TECCRA NUMBER(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1),P_TIPCRA NUMBER(1),
	                   P_CODPRMOLD NUMBER(5),P_PRMSABOLD NUMBER(5),P_PRMDOMOLD NUMBER(5),P_PRMFEROLD NUMBER(5),
	                   P_PRMRT1OLD NUMBER(5),P_PRMRT2OLD NUMBER(5),P_PRMRT3OLD NUMBER(5),P_NUMCPF NUMBER(11)
)
 IS

  l_datatu        DATE;
  l_horatu        NUMBER(4);
  l_datstr        CHAR(6);
  l_horstr        CHAR(4);
  l_datAux        CHAR(10);
  l_ValAux        CHAR(10);
  l_datenv        CHAR(16);
  l_count         NUMBER;
  l_insere        BOOLEAN;
  l_anostr        CHAR(2);
  l_tipope        VARCHAR2(1);
  l_coddsp        CHAR(9);
  l_Straux        VARCHAR2(2047);
  l_CenPen        VARCHAR2(1);
  l_data_atual    DATE;
  l_hora_atual    NUMBER(4);
  l_seqenv        NUMBER(2);
  l_seqstr        CHAR(2);
  l_gersen        BOOLEAN;
  l_numfis        CHAR(12);
  l_teccra        NUMBER(1);
  l_tcraux        CHAR(1);
  l_idtpes        VARCHAR2(23);
  l_tamnom        NUMBER(3);
  l_tamnom_str    CHAR(3);
  l_nomfun        VARCHAR2(40);
  l_numId         CHAR(11);
  l_numpis        CHAR(11);
  l_numcpf        CHAR(11);
  l_altbio        CHAR(1);
  l_cpf_repleg_str CHAR(11);

  /* busca dispositivos SDK, não REPs, verificando todas permissões */
  CURSOR c_r058prm IS
  SELECT DISTINCT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN, B.AUTPES
         FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F, R058CEN Z
         WHERE
         (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = B.CODDSP AND F.STADSP = 1     /*Dispositivo deve estar ativo*/
		 AND (B.AUTPES = 'S' OR B.AUTPES = 'L')
         AND Z.CODCEN = B.CODCEN AND Z.DATUMC IS NOT NULL
		 
         AND A.CODDSP NOT IN (
		    SELECT DISTINCT A.CODDSP
		      FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F
		     WHERE A.CODPRM IN (p_CodPrmOLD,
		                        p_PrmSabOLD,
		                        p_PrmDomOLD,
		                        p_PrmFerOLD,
		                        p_PrmRt1OLD,
		                        p_PrmRt2OLD,
		                        p_PrmRt3OLD)
		       AND A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND B.MODRLG = D.MODRLG
		       AND B.COMRLG = 2
		       AND D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
		       AND ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2)
		       AND F.CODDSP = B.CODDSP AND F.STADSP = 1 AND (B.AUTPES = 'S' OR B.AUTPES = 'L')
		 )
		 
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN, C.AUTPES
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DSP F, R058CEN Z
         WHERE (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND
         Z.CODCEN = C.CODCEN AND Z.DATUMC IS NOT NULL AND          
         D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
         F.CODDSP = C.CODDSP AND F.STADSP = 1 AND  /*Dispositivo deve estar ativo*/
         (C.AUTPES = 'S' OR C.AUTPES = 'L'));

  TYPE t_r058prm IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm t_r058prm;

  /* busca todos os dispositivos SDK, indepentende de permissão*/
  CURSOR c_r058prm2 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN, A.AUTPES
         FROM R058RLG A, R058MOD B, R058DSP F, R058CEN Z
         WHERE A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND 
               B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
              ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2) AND /*ou Digicon*/
			   F.CODDSP = A.CODDSP AND F.STADSP = 1 AND
			   (A.AUTPES = 'S' OR A.AUTPES = 'L')   /*Dispositivo deve estar ativo*/
			   AND Z.CODCEN = A.CODCEN AND Z.DATUMC IS NOT NULL

         AND A.CODDSP NOT IN
           (SELECT DISTINCT A.CODDSP A_CODDSP
              FROM R058RLG A, R058MOD B, R058DSP F, R058RLP M
             WHERE A.MODRLG = B.MODRLG
               AND A.COMRLG = 2
               AND M.CODPLT = A.CODPLT
               AND M.CODRLG = A.CODRLG
               AND M.CODPRM IN (p_CodPrmOLD,
                                p_PrmSabOLD,
                                p_PrmDomOLD,
                                p_PrmFerOLD/*,
                                p_PrmRt1OLD,
                                p_PrmRt2OLD,
                                p_PrmRt3OLD*/)
               AND B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR
                   B.FABMOD = 2)
               AND F.CODDSP = A.CODDSP
               AND F.STADSP = 1
               AND (A.AUTPES = 'S' OR A.AUTPES = 'L'));

  TYPE t_r058prm2 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm2 t_r058prm2;

  /* CURSOR para gerar a lista de exclusão
   o primeiro parãmetro p_codprm não é o codprm normal
   é usado a primeira posição como parâmtro da permissão que vai mudar
   os outros parâmetros são as demais permissões que ele tem
   busca dispositivos SDK que estão na permissão informada no primeiro parâmetro p_CodPrm */
  CURSOR c_r058prm3 IS
  SELECT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN, B.AUTPES
         FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F, R058CEN Z
         WHERE
         (A.CODPRM IN (p_CodPrmOLD, p_PrmSabOLD, p_PrmDomOLD, p_PrmFerOLD /*, p_PrmRt1OLD, p_PrmRt2OLD, p_PrmRt3OLD*/) OR (p_tipcra = 8)) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         Z.CODCEN = B.CODCEN AND Z.DATUMC IS NOT NULL AND
		 D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = B.CODDSP AND F.STADSP = 1 AND  /*Dispositivo deve estar ativo*/
		 (B.AUTPES = 'S' OR B.AUTPES = 'L')

         AND A.CODDSP NOT IN
           (SELECT E.CODDSP E_CODDSP
              FROM R058RLP E, R058RLG F, R058MOD H, R058DSP K
             WHERE E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer/*,
                                p_PrmRt1, p_PrmRt2, p_PrmRt3*/)
               AND E.CODPLT = F.CODPLT
               AND E.CODRLG = F.CODRLG
               AND F.MODRLG = H.MODRLG
               AND F.COMRLG = 2
               AND H.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((H.FABMOD > 2 AND H.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR H.FABMOD = 2)
               AND K.CODDSP = F.CODDSP
               AND K.STADSP = 1
               AND (F.AUTPES = 'S' OR F.AUTPES = 'L'))
		 
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN, C.AUTPES
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DSP F, R058CEN Z
         WHERE (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND
         Z.CODCEN = C.CODCEN AND Z.DATUMC IS NOT NULL AND 
		 D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = C.CODDSP AND F.STADSP = 1 AND   /*Dispositivo deve estar ativo*/
         (C.AUTPES = 'S' OR C.AUTPES = 'L')
         
         AND C.CODDSP NOT IN
           (SELECT F.CODDSP F_CODDSP
              FROM R058RLP E, R058RLG F, R058MOD H, R058DSP K
             WHERE E.CODPRM IN (p_CodPrmOLD, p_PrmSabOLD, p_PrmDomOLD, p_PrmFerOLD,
                                p_PrmRt1OLD, p_PrmRt2OLD, p_PrmRt3OLD)
               AND E.CODPLT = F.CODPLT
               AND E.CODRLG = F.CODRLG
               AND F.MODRLG = H.MODRLG
               AND F.COMRLG = 2
               AND H.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((H.FABMOD > 2 AND H.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR H.FABMOD = 2)
               AND K.CODDSP = F.CODDSP
               AND K.STADSP = 1
               AND (F.AUTPES = 'S' OR F.AUTPES = 'L'))
  );

  TYPE t_r058prm3 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm3 t_r058prm3;


  /* CURSOR para buscar todos os dispositivos SDK que não
  estão na permissão, para gerar delete ao trocar VERPRM */
  CURSOR c_r058prm4 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN, A.AUTPES
        FROM R058RLG A, R058MOD B, R058DSP F, R058CEN Z
        WHERE
        A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND
		B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
        ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2) AND /*ou Digicon*/
        F.CODDSP = A.CODDSP AND F.STADSP = 1 AND /*Dispositivo deve estar ativo*/
        (A.AUTPES = 'S' OR A.AUTPES = 'L') AND
        Z.CODCEN = A.CODCEN AND Z.DATUMC IS NOT NULL

        AND NOT EXISTS 
          (SELECT C.CODPLT, C.CODRLG 
          	 FROM R058RLP C 
            WHERE C.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND A.CODPLT = C.CODPLT AND A.CODRLG = C.CODRLG
          )
        AND NOT EXISTS 
          (SELECT D.CODPLT, D.CODRLG 
          	 FROM R058GRL D, R058GRP E 
            WHERE E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) 
              AND E.CODGRR = D.CODGRR AND A.CODPLT = D.CODPLT AND A.CODRLG = D.CODRLG 
              AND ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2)
          );

  
  TYPE t_r058prm4 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm4 t_r058prm4;

BEGIN
   SP_GERSEN(l_gersen OUT);
   l_CenPen:= '0';

   l_data_atual := CURDATE();
   l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

   SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
   SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);

   /*Obtem o Segundo*/
   l_seqenv := SECOND(CURTIME());
   SP_INTSTR(l_seqenv, '99', l_seqstr OUT);

   l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

   /*Número Crachá*/
   SP_INTSTR(p_numfis,'999999999999',l_numfis OUT);

   /*Tecnologia do Crachá*/
   l_teccra := p_teccra;
   SP_INTSTR(l_teccra,'9',l_tcraux OUT);

   /*Identificador da Pessoa*/
   l_idtpes := p_idtpes;

   /*Responsável Legal pela alteração*/
   SP_INTSTR(0, '99999999999', l_cpf_repleg_str OUT);
   
   /*Nome da Pessoa*/
   l_nomfun := p_nomfun;
   l_nomfun := lTrim(l_nomfun);
   l_nomfun := rTrim(l_nomfun);
   
   /*tamanho do Nome da pessoa*/
   l_tamnom := Length(l_nomfun);
   SP_INTSTR(l_tamnom,'999',l_tamnom_str OUT);
   SP_INTSTR(p_altbio,'9',l_altbio OUT);

   /* Repasso tambem o PIS e o CPF em campos distintos, 
    * para que a CSM Center não precise adivinhar o documento */
   SP_INTSTR(p_numpis,'99999999999',l_numpis OUT);
   SP_INTSTR(p_numcpf,'99999999999',l_numcpf OUT);

   /* Informa o CPF quando não há PIS (alteração para a portaria 671) */
   IF (p_numpis > 0) THEN
     l_numId := l_numpis;
   ELSE
     l_numId := l_numcpf;
   END IF;

   l_datatu    := CURDATE();
   l_horatu    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

   SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
   SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);

   /* data atual string no formato YYMMDDHHmm*/
   l_DatAux := SUBSTRING(l_datstr,5,2)||SUBSTRING(l_datstr,3,2)||SUBSTRING(l_datstr,1,2)||l_horstr;
   /* converte a data de validade no formato string YYMMDDHHmm*/
   l_ValAux :=  SUBSTRING(p_datval,5,2)||SUBSTRING(p_datval,3,2)||SUBSTRING(p_datval,1,2)||SUBSTRING(p_datval,7,4);

   /*Evitar que seja inserido registro INSERT com data passada. Se for I, data validade tem que ser maior igual a data atual*/
   IF (p_tipOpe <> 'I') OR ((p_tipOpe = 'I') AND (l_valAux >= l_DatAux)) THEN
	 /* verifica se é geração da lista de exclusão */
	 IF (p_tipOpe = 'D') OR (p_tipOpe = 'E') THEN
	   /*Parâmetro "D" é usado em todas as exclusões, na TR070CON, exceto na troca do VERPRM.*/
	   /*Gera na R070ACR registros para exclusão, que alteraram alguma permissão*/
	   IF (p_tipOpe = 'D') THEN
		   /* LOOP dos dispositivos que estão dentro da permissão */
		   FOREACH c_r058prm3 INTO l_r058prm3.numeip,
								   l_r058prm3.tiplei,
								   l_r058prm3.coddsp,
								   l_r058prm3.fabmod,
								   l_r058prm3.codcen,
								   l_r058prm3.autpes
								   
		   LOOP
				/* Multitecnologia */
				IF (l_r058prm3.tiplei = 11) THEN
					l_insere := TRUE;
				END IF;

				IF (p_numcra = p_numfis) THEN
				   l_insere := TRUE;
				END IF;

				IF (l_insere = TRUE) THEN
				  IF (l_gersen = TRUE) THEN
					 SP_INTSTR(l_r058prm3.coddsp,'999999999',l_coddsp OUT);
                     
					 /* tipope 1 = remove card */
					 l_tipope := '1';
					 l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
					 
					 IF (l_r058prm3.autpes = 'L') AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm3.codcen);
					 END IF;

				  END IF;
				END IF;
		   END LOOP;
		ELSE
		   /*Passa aqui, quando o parâmetro de exclusão for "E" */
		   /*Parâmetro "E" é passado na troca do VERPRM, caso seja feita alteração de Não para SIM (Verifica Permissão)*/
		   /*Gera na R070ACR registros para exclusão, que estão fora da permissão do colaborador*/
		   /* LOOP dos dispositivos que estão dentro da permissão */
		   FOREACH c_r058prm4 INTO l_r058prm4.numeip,
								   l_r058prm4.tiplei,
								   l_r058prm4.coddsp,
								   l_r058prm4.fabmod,
								   l_r058prm4.codcen,
								   l_r058prm4.autpes
		   LOOP
			   /* trata registro de acordo com a leitora e tecnologia do crachá */
			   l_insere := FALSE;

			   /* Multitecnologia */
			   IF (l_r058prm4.tiplei = 11) THEN
				  l_insere := TRUE;
			   END IF;

			   IF (p_numcra = p_numfis) THEN
				  l_insere := TRUE;
			   END IF;

			   IF (l_insere = TRUE) THEN
				 IF (l_gersen = TRUE) THEN
				   SP_INTSTR(l_r058prm4.coddsp,'999999999',l_coddsp OUT);

				   /* tipope 1 = remove card */
				   l_tipope := '1';
				   l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm4.autpes = 'L') AND (P_TIPOPE <> 'D')  THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm4.codcen);
				     END IF;
				 END IF;
			   END IF;
		   END LOOP;
		END IF;
	 ELSE
		 /* para operação normal de INSERT e delete */
		 IF (p_tipope = 'F') OR (p_tipope = 'D') THEN
		   l_tipope := '1';
		 ELSE
		   l_tipope := '0';
		 END IF;

		 IF (p_verPrm = 1) THEN /* verprm = 'S' */

			 /* LOOP dos dispositivos que estão dentro da permissão*/
			 FOREACH c_r058prm INTO l_r058prm.numeip,
									l_r058prm.tiplei,
									l_r058prm.coddsp,
									l_r058prm.fabmod,
									l_r058prm.codcen,
									l_r058prm.autpes
			 LOOP
				 /* trata registro de acordo com a leitora e tecnologia do crachá */
				 l_insere := FALSE;
				   /* Multitecnologia */
				 IF (l_r058prm.tiplei = 11) THEN
					l_insere := TRUE;
				 END IF;

				 IF (l_insere = TRUE) THEN
					 /*verifica se já existe um registro ainda não enviado para este crachá e dispositivo */
				   IF (l_gersen = TRUE) THEN
					 SP_INTSTR(l_r058prm.coddsp,'999999999',l_coddsp OUT);

					 l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm.autpes = 'L')  AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm.codcen);
  					 END IF;
				   END IF;
				 END IF;
			 END LOOP;
		 ELSE
			 /* se não verifica permissão, gera para todos os dispositivos */
			 FOREACH c_r058prm2 INTO l_r058prm2.numeip,
									 l_r058prm2.tiplei,
									 l_r058prm2.coddsp,
									 l_r058prm2.fabmod,
									 l_r058prm2.codcen,
									 l_r058prm2.autpes
			 LOOP
				 /* trata registro de acordo com a leitora e tecnologia do crachá */
				 l_insere := FALSE;

				 /* Multitecnologia */
				 IF (l_r058prm2.tiplei = 11) THEN
					 l_insere := TRUE;
				 END IF;

				 IF (l_insere = TRUE) THEN
				   IF (l_gersen = TRUE) THEN
					  SP_INTSTR(l_r058prm2.coddsp,'999999999',l_coddsp OUT);
					  l_tipope := '0';
					  l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm2.autpes = 'L')  AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm2.codcen);
					 END IF;
				   END IF;
				 END IF;

			 END LOOP;
		 END IF;
	 END IF;
   END IF;
   
END		SENIOR;22KSP_GERSEN
SP_DATSTR
SP_INTSTR
SP_PORCOMDSP
SP_PENDPAL
SP_RET_RESPLEG
J␀␀

PROCEDURE SP_PENDAce62(P_TIPOPE VARCHAR2(1),P_NUMCRA NUMBER(12),P_NUMFIS NUMBER(12),P_TECCRA NUMBER(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1),P_TIPCRA NUMBER(1),
	                   P_CODPRMOLD NUMBER(5),P_PRMSABOLD NUMBER(5),P_PRMDOMOLD NUMBER(5),P_PRMFEROLD NUMBER(5),
	                   P_PRMRT1OLD NUMBER(5),P_PRMRT2OLD NUMBER(5),P_PRMRT3OLD NUMBER(5),P_NUMCPF NUMBER(11)
)
 IS

  l_datatu        DATE;
  l_horatu        NUMBER(4);
  l_datstr        CHAR(6);
  l_horstr        CHAR(4);
  l_datAux        CHAR(10);
  l_ValAux        CHAR(10);
  l_datenv        CHAR(16);
  l_count         NUMBER;
  l_insere        BOOLEAN;
  l_anostr        CHAR(2);
  l_tipope        VARCHAR2(1);
  l_coddsp        CHAR(9);
  l_Straux        VARCHAR2(2047);
  l_CenPen        VARCHAR2(1);
  l_data_atual    DATE;
  l_hora_atual    NUMBER(4);
  l_seqenv        NUMBER(2);
  l_seqstr        CHAR(2);
  l_gersen        BOOLEAN;
  l_numfis        CHAR(12);
  l_teccra        NUMBER(1);
  l_tcraux        CHAR(1);
  l_idtpes        VARCHAR2(23);
  l_tamnom        NUMBER(3);
  l_tamnom_str    CHAR(3);
  l_nomfun        VARCHAR2(40);
  l_numId         CHAR(11);
  l_numpis        CHAR(11);
  l_numcpf        CHAR(11);
  l_altbio        CHAR(1);
  l_cpf_repleg_str CHAR(11);

  /* busca dispositivos SDK, não REPs, verificando todas permissões */
  CURSOR c_r058prm IS
  SELECT DISTINCT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN, B.AUTPES
         FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F, R058CEN Z
         WHERE
         (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = B.CODDSP AND F.STADSP = 1     /*Dispositivo deve estar ativo*/
		 AND (B.AUTPES = 'S' OR B.AUTPES = 'L')
         AND Z.CODCEN = B.CODCEN AND Z.DATUMC IS NOT NULL
		 
         AND A.CODDSP NOT IN (
		    SELECT DISTINCT A.CODDSP
		      FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F
		     WHERE A.CODPRM IN (p_CodPrmOLD,
		                        p_PrmSabOLD,
		                        p_PrmDomOLD,
		                        p_PrmFerOLD,
		                        p_PrmRt1OLD,
		                        p_PrmRt2OLD,
		                        p_PrmRt3OLD)
		       AND A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND B.MODRLG = D.MODRLG
		       AND B.COMRLG = 2
		       AND D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
		       AND ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2)
		       AND F.CODDSP = B.CODDSP AND F.STADSP = 1 AND (B.AUTPES = 'S' OR B.AUTPES = 'L')
		 )
		 
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN, C.AUTPES
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DSP F, R058CEN Z
         WHERE (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND
         Z.CODCEN = C.CODCEN AND Z.DATUMC IS NOT NULL AND          
         D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
         F.CODDSP = C.CODDSP AND F.STADSP = 1 AND  /*Dispositivo deve estar ativo*/
         (C.AUTPES = 'S' OR C.AUTPES = 'L'));

  TYPE t_r058prm IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm t_r058prm;

  /* busca todos os dispositivos SDK, indepentende de permissão*/
  CURSOR c_r058prm2 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN, A.AUTPES
         FROM R058RLG A, R058MOD B, R058DSP F, R058CEN Z
         WHERE A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND 
               B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
              ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2) AND /*ou Digicon*/
			   F.CODDSP = A.CODDSP AND F.STADSP = 1 AND
			   (A.AUTPES = 'S' OR A.AUTPES = 'L')   /*Dispositivo deve estar ativo*/
			   AND Z.CODCEN = A.CODCEN AND Z.DATUMC IS NOT NULL

         AND A.CODDSP NOT IN
           (SELECT DISTINCT A.CODDSP A_CODDSP
              FROM R058RLG A, R058MOD B, R058DSP F, R058RLP M
             WHERE A.MODRLG = B.MODRLG
               AND A.COMRLG = 2
               AND M.CODPLT = A.CODPLT
               AND M.CODRLG = A.CODRLG
               AND M.CODPRM IN (p_CodPrmOLD,
                                p_PrmSabOLD,
                                p_PrmDomOLD,
                                p_PrmFerOLD/*,
                                p_PrmRt1OLD,
                                p_PrmRt2OLD,
                                p_PrmRt3OLD*/)
               AND B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR
                   B.FABMOD = 2)
               AND F.CODDSP = A.CODDSP
               AND F.STADSP = 1
               AND (A.AUTPES = 'S' OR A.AUTPES = 'L'));

  TYPE t_r058prm2 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm2 t_r058prm2;

  /* CURSOR para gerar a lista de exclusão
   o primeiro parãmetro p_codprm não é o codprm normal
   é usado a primeira posição como parâmtro da permissão que vai mudar
   os outros parâmetros são as demais permissões que ele tem
   busca dispositivos SDK que estão na permissão informada no primeiro parâmetro p_CodPrm */
  CURSOR c_r058prm3 IS
  SELECT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN, B.AUTPES
         FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F, R058CEN Z
         WHERE
         (A.CODPRM IN (p_CodPrmOLD, p_PrmSabOLD, p_PrmDomOLD, p_PrmFerOLD /*, p_PrmRt1OLD, p_PrmRt2OLD, p_PrmRt3OLD*/) OR (p_tipcra = 8)) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         Z.CODCEN = B.CODCEN AND Z.DATUMC IS NOT NULL AND
		 D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = B.CODDSP AND F.STADSP = 1 AND  /*Dispositivo deve estar ativo*/
		 (B.AUTPES = 'S' OR B.AUTPES = 'L')

         AND A.CODDSP NOT IN
           (SELECT E.CODDSP E_CODDSP
              FROM R058RLP E, R058RLG F, R058MOD H, R058DSP K
             WHERE E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer/*,
                                p_PrmRt1, p_PrmRt2, p_PrmRt3*/)
               AND E.CODPLT = F.CODPLT
               AND E.CODRLG = F.CODRLG
               AND F.MODRLG = H.MODRLG
               AND F.COMRLG = 2
               AND H.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((H.FABMOD > 2 AND H.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR H.FABMOD = 2)
               AND K.CODDSP = F.CODDSP
               AND K.STADSP = 1
               AND (F.AUTPES = 'S' OR F.AUTPES = 'L'))
		 
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN, C.AUTPES
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DSP F, R058CEN Z
         WHERE (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND
         Z.CODCEN = C.CODCEN AND Z.DATUMC IS NOT NULL AND 
		 D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = C.CODDSP AND F.STADSP = 1 AND   /*Dispositivo deve estar ativo*/
         (C.AUTPES = 'S' OR C.AUTPES = 'L')
         
         AND C.CODDSP NOT IN
           (SELECT F.CODDSP F_CODDSP
              FROM R058RLP E, R058RLG F, R058MOD H, R058DSP K
             WHERE E.CODPRM IN (p_CodPrmOLD, p_PrmSabOLD, p_PrmDomOLD, p_PrmFerOLD,
                                p_PrmRt1OLD, p_PrmRt2OLD, p_PrmRt3OLD)
               AND E.CODPLT = F.CODPLT
               AND E.CODRLG = F.CODRLG
               AND F.MODRLG = H.MODRLG
               AND F.COMRLG = 2
               AND H.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((H.FABMOD > 2 AND H.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR H.FABMOD = 2)
               AND K.CODDSP = F.CODDSP
               AND K.STADSP = 1
               AND (F.AUTPES = 'S' OR F.AUTPES = 'L'))
  );

  TYPE t_r058prm3 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm3 t_r058prm3;


  /* CURSOR para buscar todos os dispositivos SDK que não
  estão na permissão, para gerar delete ao trocar VERPRM */
  CURSOR c_r058prm4 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN, A.AUTPES
        FROM R058RLG A, R058MOD B, R058DSP F, R058CEN Z
        WHERE
        A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND
		B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
        ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2) AND /*ou Digicon*/
        F.CODDSP = A.CODDSP AND F.STADSP = 1 AND /*Dispositivo deve estar ativo*/
        (A.AUTPES = 'S' OR A.AUTPES = 'L') AND
        Z.CODCEN = A.CODCEN AND Z.DATUMC IS NOT NULL

        AND NOT EXISTS 
          (SELECT C.CODPLT, C.CODRLG 
          	 FROM R058RLP C 
            WHERE C.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND A.CODPLT = C.CODPLT AND A.CODRLG = C.CODRLG
          )
        AND NOT EXISTS 
          (SELECT D.CODPLT, D.CODRLG 
          	 FROM R058GRL D, R058GRP E 
            WHERE E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) 
              AND E.CODGRR = D.CODGRR AND A.CODPLT = D.CODPLT AND A.CODRLG = D.CODRLG 
              AND ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2)
          );

  
  TYPE t_r058prm4 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm4 t_r058prm4;

BEGIN
   SP_GERSEN(l_gersen OUT);
   l_CenPen:= '0';

   l_data_atual := CURDATE();
   l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

   SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
   SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);

   /*Obtem o Segundo*/
   l_seqenv := SECOND(CURTIME());
   SP_INTSTR(l_seqenv, '99', l_seqstr OUT);

   l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

   /*Número Crachá*/
   SP_INTSTR(p_numfis,'999999999999',l_numfis OUT);

   /*Tecnologia do Crachá*/
   l_teccra := p_teccra;
   SP_INTSTR(l_teccra,'9',l_tcraux OUT);

   /*Identificador da Pessoa*/
   l_idtpes := p_idtpes;

   /*Responsável Legal pela alteração*/
   SP_INTSTR(0, '99999999999', l_cpf_repleg_str OUT);
   
   /*Nome da Pessoa*/
   l_nomfun := p_nomfun;
   l_nomfun := lTrim(l_nomfun);
   l_nomfun := rTrim(l_nomfun);
   
   /*tamanho do Nome da pessoa*/
   l_tamnom := Length(l_nomfun);
   SP_INTSTR(l_tamnom,'999',l_tamnom_str OUT);
   SP_INTSTR(p_altbio,'9',l_altbio OUT);

   /* Repasso tambem o PIS e o CPF em campos distintos, 
    * para que a CSM Center não precise adivinhar o documento */
   SP_INTSTR(p_numpis,'99999999999',l_numpis OUT);
   SP_INTSTR(p_numcpf,'99999999999',l_numcpf OUT);

   /* Informa o CPF quando não há PIS (alteração para a portaria 671) */
   IF (p_numpis > 0) THEN
     l_numId := l_numpis;
   ELSE
     l_numId := l_numcpf;
   END IF;

   l_datatu    := CURDATE();
   l_horatu    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

   SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
   SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);

   /* data atual string no formato YYMMDDHHmm*/
   l_DatAux := SUBSTRING(l_datstr,5,2)||SUBSTRING(l_datstr,3,2)||SUBSTRING(l_datstr,1,2)||l_horstr;
   /* converte a data de validade no formato string YYMMDDHHmm*/
   l_ValAux :=  SUBSTRING(p_datval,5,2)||SUBSTRING(p_datval,3,2)||SUBSTRING(p_datval,1,2)||SUBSTRING(p_datval,7,4);

   /*Evitar que seja inserido registro INSERT com data passada. Se for I, data validade tem que ser maior igual a data atual*/
   IF (p_tipOpe <> 'I') OR ((p_tipOpe = 'I') AND (l_valAux >= l_DatAux)) THEN
	 /* verifica se é geração da lista de exclusão */
	 IF (p_tipOpe = 'D') OR (p_tipOpe = 'E') THEN
	   /*Parâmetro "D" é usado em todas as exclusões, na TR070CON, exceto na troca do VERPRM.*/
	   /*Gera na R070ACR registros para exclusão, que alteraram alguma permissão*/
	   IF (p_tipOpe = 'D') THEN
		   /* LOOP dos dispositivos que estão dentro da permissão */
		   FOREACH c_r058prm3 INTO l_r058prm3.numeip,
								   l_r058prm3.tiplei,
								   l_r058prm3.coddsp,
								   l_r058prm3.fabmod,
								   l_r058prm3.codcen,
								   l_r058prm3.autpes
								   
		   LOOP
				/* Multitecnologia */
				IF (l_r058prm3.tiplei = 11) THEN
					l_insere := TRUE;
				END IF;

				IF (p_numcra = p_numfis) THEN
				   l_insere := TRUE;
				END IF;

				IF (l_insere = TRUE) THEN
				  IF (l_gersen = TRUE) THEN
					 SP_INTSTR(l_r058prm3.coddsp,'999999999',l_coddsp OUT);
                     
					 /* tipope 1 = remove card */
					 l_tipope := '1';
					 l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
					 
					 IF (l_r058prm3.autpes = 'L') AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm3.codcen);
					 END IF;

				  END IF;
				END IF;
		   END LOOP;
		ELSE
		   /*Passa aqui, quando o parâmetro de exclusão for "E" */
		   /*Parâmetro "E" é passado na troca do VERPRM, caso seja feita alteração de Não para SIM (Verifica Permissão)*/
		   /*Gera na R070ACR registros para exclusão, que estão fora da permissão do colaborador*/
		   /* LOOP dos dispositivos que estão dentro da permissão */
		   FOREACH c_r058prm4 INTO l_r058prm4.numeip,
								   l_r058prm4.tiplei,
								   l_r058prm4.coddsp,
								   l_r058prm4.fabmod,
								   l_r058prm4.codcen,
								   l_r058prm4.autpes
		   LOOP
			   /* trata registro de acordo com a leitora e tecnologia do crachá */
			   l_insere := FALSE;

			   /* Multitecnologia */
			   IF (l_r058prm4.tiplei = 11) THEN
				  l_insere := TRUE;
			   END IF;

			   IF (p_numcra = p_numfis) THEN
				  l_insere := TRUE;
			   END IF;

			   IF (l_insere = TRUE) THEN
				 IF (l_gersen = TRUE) THEN
				   SP_INTSTR(l_r058prm4.coddsp,'999999999',l_coddsp OUT);

				   /* tipope 1 = remove card */
				   l_tipope := '1';
				   l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm4.autpes = 'L') AND (P_TIPOPE <> 'D')  THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm4.codcen);
				     END IF;
				 END IF;
			   END IF;
		   END LOOP;
		END IF;
	 ELSE
		 /* para operação normal de INSERT e delete */
		 IF (p_tipope = 'F') OR (p_tipope = 'D') THEN
		   l_tipope := '1';
		 ELSE
		   l_tipope := '0';
		 END IF;

		 IF (p_verPrm = 1) THEN /* verprm = 'S' */

			 /* LOOP dos dispositivos que estão dentro da permissão*/
			 FOREACH c_r058prm INTO l_r058prm.numeip,
									l_r058prm.tiplei,
									l_r058prm.coddsp,
									l_r058prm.fabmod,
									l_r058prm.codcen,
									l_r058prm.autpes
			 LOOP
				 /* trata registro de acordo com a leitora e tecnologia do crachá */
				 l_insere := FALSE;
				   /* Multitecnologia */
				 IF (l_r058prm.tiplei = 11) THEN
					l_insere := TRUE;
				 END IF;

				 IF (l_insere = TRUE) THEN
					 /*verifica se já existe um registro ainda não enviado para este crachá e dispositivo */
				   IF (l_gersen = TRUE) THEN
					 SP_INTSTR(l_r058prm.coddsp,'999999999',l_coddsp OUT);

					 l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm.autpes = 'L')  AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm.codcen);
  					 END IF;
				   END IF;
				 END IF;
			 END LOOP;
		 ELSE
			 /* se não verifica permissão, gera para todos os dispositivos */
			 FOREACH c_r058prm2 INTO l_r058prm2.numeip,
									 l_r058prm2.tiplei,
									 l_r058prm2.coddsp,
									 l_r058prm2.fabmod,
									 l_r058prm2.codcen,
									 l_r058prm2.autpes
			 LOOP
				 /* trata registro de acordo com a leitora e tecnologia do crachá */
				 l_insere := FALSE;

				 /* Multitecnologia */
				 IF (l_r058prm2.tiplei = 11) THEN
					 l_insere := TRUE;
				 END IF;

				 IF (l_insere = TRUE) THEN
				   IF (l_gersen = TRUE) THEN
					  SP_INTSTR(l_r058prm2.coddsp,'999999999',l_coddsp OUT);
					  l_tipope := '0';
					  l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm2.autpes = 'L')  AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm2.codcen);
					 END IF;
				   END IF;
				 END IF;

			 END LOOP;
		 END IF;
	 END IF;
   END IF;
   
END		SENIOR;23KSP_GERSEN
SP_DATSTR
SP_INTSTR
SP_PORCOMDSP
SP_PENDPAL
SP_RET_RESPLEG
J␀␀

PROCEDURE SP_PENDAce62(P_TIPOPE VARCHAR2(1),P_NUMCRA NUMBER(12),P_NUMFIS NUMBER(12),P_TECCRA NUMBER(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_DATVAL CHAR(16),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1),P_TIPCRA NUMBER(1),
	                   P_CODPRMOLD NUMBER(5),P_PRMSABOLD NUMBER(5),P_PRMDOMOLD NUMBER(5),P_PRMFEROLD NUMBER(5),
	                   P_PRMRT1OLD NUMBER(5),P_PRMRT2OLD NUMBER(5),P_PRMRT3OLD NUMBER(5),P_NUMCPF NUMBER(11)
)
 IS

  l_datatu        DATE;
  l_horatu        NUMBER(4);
  l_datstr        CHAR(6);
  l_horstr        CHAR(4);
  l_datAux        CHAR(10);
  l_ValAux        CHAR(10);
  l_datenv        CHAR(16);
  l_count         NUMBER;
  l_insere        BOOLEAN;
  l_anostr        CHAR(2);
  l_tipope        VARCHAR2(1);
  l_coddsp        CHAR(9);
  l_Straux        VARCHAR2(2047);
  l_CenPen        VARCHAR2(1);
  l_data_atual    DATE;
  l_hora_atual    NUMBER(4);
  l_seqenv        NUMBER(2);
  l_seqstr        CHAR(2);
  l_gersen        BOOLEAN;
  l_numfis        CHAR(12);
  l_teccra        NUMBER(1);
  l_tcraux        CHAR(1);
  l_idtpes        VARCHAR2(23);
  l_tamnom        NUMBER(3);
  l_tamnom_str    CHAR(3);
  l_nomfun        VARCHAR2(40);
  l_numId         CHAR(11);
  l_numpis        CHAR(11);
  l_numcpf        CHAR(11);
  l_altbio        CHAR(1);
  l_cpf_repleg_str CHAR(11);

  /* busca dispositivos SDK, não REPs, verificando todas permissões */
  CURSOR c_r058prm IS
  SELECT DISTINCT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN, B.AUTPES
         FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F, R058CEN Z
         WHERE
         (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = B.CODDSP AND F.STADSP = 1     /*Dispositivo deve estar ativo*/
		 AND (B.AUTPES = 'S' OR B.AUTPES = 'L')
         AND Z.CODCEN = B.CODCEN AND Z.DATUMC IS NOT NULL
		 
         AND A.CODDSP NOT IN (
		    SELECT DISTINCT A.CODDSP
		      FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F
		     WHERE A.CODPRM IN (p_CodPrmOLD,
		                        p_PrmSabOLD,
		                        p_PrmDomOLD,
		                        p_PrmFerOLD,
		                        p_PrmRt1OLD,
		                        p_PrmRt2OLD,
		                        p_PrmRt3OLD)
		       AND A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND B.MODRLG = D.MODRLG
		       AND B.COMRLG = 2
		       AND D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
		       AND ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2)
		       AND F.CODDSP = B.CODDSP AND F.STADSP = 1 AND (B.AUTPES = 'S' OR B.AUTPES = 'L')
		 )
		 
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN, C.AUTPES
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DSP F, R058CEN Z
         WHERE (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND
         Z.CODCEN = C.CODCEN AND Z.DATUMC IS NOT NULL AND          
         D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
         F.CODDSP = C.CODDSP AND F.STADSP = 1 AND  /*Dispositivo deve estar ativo*/
         (C.AUTPES = 'S' OR C.AUTPES = 'L'));

  TYPE t_r058prm IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm t_r058prm;

  /* busca todos os dispositivos SDK, indepentende de permissão*/
  CURSOR c_r058prm2 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN, A.AUTPES
         FROM R058RLG A, R058MOD B, R058DSP F, R058CEN Z
         WHERE A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND 
               B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
              ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2) AND /*ou Digicon*/
			   F.CODDSP = A.CODDSP AND F.STADSP = 1 AND
			   (A.AUTPES = 'S' OR A.AUTPES = 'L')   /*Dispositivo deve estar ativo*/
			   AND Z.CODCEN = A.CODCEN AND Z.DATUMC IS NOT NULL

         AND A.CODDSP NOT IN
           (SELECT DISTINCT A.CODDSP A_CODDSP
              FROM R058RLG A, R058MOD B, R058DSP F, R058RLP M
             WHERE A.MODRLG = B.MODRLG
               AND A.COMRLG = 2
               AND M.CODPLT = A.CODPLT
               AND M.CODRLG = A.CODRLG
               AND M.CODPRM IN (p_CodPrmOLD,
                                p_PrmSabOLD,
                                p_PrmDomOLD,
                                p_PrmFerOLD/*,
                                p_PrmRt1OLD,
                                p_PrmRt2OLD,
                                p_PrmRt3OLD*/)
               AND B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR
                   B.FABMOD = 2)
               AND F.CODDSP = A.CODDSP
               AND F.STADSP = 1
               AND (A.AUTPES = 'S' OR A.AUTPES = 'L'));

  TYPE t_r058prm2 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm2 t_r058prm2;

  /* CURSOR para gerar a lista de exclusão
   o primeiro parãmetro p_codprm não é o codprm normal
   é usado a primeira posição como parâmtro da permissão que vai mudar
   os outros parâmetros são as demais permissões que ele tem
   busca dispositivos SDK que estão na permissão informada no primeiro parâmetro p_CodPrm */
  CURSOR c_r058prm3 IS
  SELECT B.NUMEIP, B.TIPLEI, B.CODDSP, D.FABMOD, B.CODCEN, B.AUTPES
         FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F, R058CEN Z
         WHERE
         (A.CODPRM IN (p_CodPrmOLD, p_PrmSabOLD, p_PrmDomOLD, p_PrmFerOLD /*, p_PrmRt1OLD, p_PrmRt2OLD, p_PrmRt3OLD*/) OR (p_tipcra = 8)) AND
         A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
         B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
         Z.CODCEN = B.CODCEN AND Z.DATUMC IS NOT NULL AND
		 D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = B.CODDSP AND F.STADSP = 1 AND  /*Dispositivo deve estar ativo*/
		 (B.AUTPES = 'S' OR B.AUTPES = 'L')

         AND A.CODDSP NOT IN
           (SELECT E.CODDSP E_CODDSP
              FROM R058RLP E, R058RLG F, R058MOD H, R058DSP K
             WHERE E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer/*,
                                p_PrmRt1, p_PrmRt2, p_PrmRt3*/)
               AND E.CODPLT = F.CODPLT
               AND E.CODRLG = F.CODRLG
               AND F.MODRLG = H.MODRLG
               AND F.COMRLG = 2
               AND H.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((H.FABMOD > 2 AND H.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR H.FABMOD = 2)
               AND K.CODDSP = F.CODDSP
               AND K.STADSP = 1
               AND (F.AUTPES = 'S' OR F.AUTPES = 'L'))
		 
  UNION  /* grupo */
  (SELECT C.NUMEIP, C.TIPLEI, C.CODDSP, D.FABMOD, C.CODCEN, C.AUTPES
         FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DSP F, R058CEN Z
         WHERE (A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) OR (p_tipcra = 8)) AND
         A.CODGRR = B.CODGRR AND
         B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
         C.MODRLG = D.MODRLG AND
         Z.CODCEN = C.CODCEN AND Z.DATUMC IS NOT NULL AND 
		 D.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
         ((D.FABMOD > 2 AND D.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR D.FABMOD = 2) AND /*ou Digicon*/
		 F.CODDSP = C.CODDSP AND F.STADSP = 1 AND   /*Dispositivo deve estar ativo*/
         (C.AUTPES = 'S' OR C.AUTPES = 'L')
         
         AND C.CODDSP NOT IN
           (SELECT F.CODDSP F_CODDSP
              FROM R058RLP E, R058RLG F, R058MOD H, R058DSP K
             WHERE E.CODPRM IN (p_CodPrmOLD, p_PrmSabOLD, p_PrmDomOLD, p_PrmFerOLD,
                                p_PrmRt1OLD, p_PrmRt2OLD, p_PrmRt3OLD)
               AND E.CODPLT = F.CODPLT
               AND E.CODRLG = F.CODRLG
               AND F.MODRLG = H.MODRLG
               AND F.COMRLG = 2
               AND H.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99)
               AND ((H.FABMOD > 2 AND H.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR H.FABMOD = 2)
               AND K.CODDSP = F.CODDSP
               AND K.STADSP = 1
               AND (F.AUTPES = 'S' OR F.AUTPES = 'L'))
  );

  TYPE t_r058prm3 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm3 t_r058prm3;


  /* CURSOR para buscar todos os dispositivos SDK que não
  estão na permissão, para gerar delete ao trocar VERPRM */
  CURSOR c_r058prm4 IS
  SELECT DISTINCT A.NUMEIP, A.TIPLEI, A.CODDSP, B.FABMOD, A.CODCEN, A.AUTPES
        FROM R058RLG A, R058MOD B, R058DSP F, R058CEN Z
        WHERE
        A.MODRLG = B.MODRLG AND A.COMRLG = 2 AND
		B.CLAMOD IN (1, 2, 3, 4, 5, 6, 7, 8, 9, 99) AND
        ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2) AND /*ou Digicon*/
        F.CODDSP = A.CODDSP AND F.STADSP = 1 AND /*Dispositivo deve estar ativo*/
        (A.AUTPES = 'S' OR A.AUTPES = 'L') AND
        Z.CODCEN = A.CODCEN AND Z.DATUMC IS NOT NULL

        AND NOT EXISTS 
          (SELECT C.CODPLT, C.CODRLG 
          	 FROM R058RLP C 
            WHERE C.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND A.CODPLT = C.CODPLT AND A.CODRLG = C.CODRLG
          )
        AND NOT EXISTS 
          (SELECT D.CODPLT, D.CODRLG 
          	 FROM R058GRL D, R058GRP E 
            WHERE E.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) 
              AND E.CODGRR = D.CODGRR AND A.CODPLT = D.CODPLT AND A.CODRLG = D.CODRLG 
              AND ((B.FABMOD > 2 AND B.CODDRV IN (SELECT CODDRV FROM R058DRV WHERE VERDRV > 5)) OR B.FABMOD = 2)
          );

  
  TYPE t_r058prm4 IS RECORD(
    NUMEIP   R058RLG.NUMEIP%TYPE,
    TIPLEI   R058RLG.TIPLEI%TYPE,
    CODDSP   R058RLG.CODDSP%TYPE,
    FABMOD   R058MOD.FABMOD%TYPE,
    CODCEN   R058RLG.CODCEN%TYPE,
    AUTPES   R058RLG.AUTPES%TYPE);
  l_r058prm4 t_r058prm4;

BEGIN
   SP_GERSEN(l_gersen OUT);
   l_CenPen:= '0';

   l_data_atual := CURDATE();
   l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

   SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
   SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);

   /*Obtem o Segundo*/
   l_seqenv := SECOND(CURTIME());
   SP_INTSTR(l_seqenv, '99', l_seqstr OUT);

   l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

   /*Número Crachá*/
   SP_INTSTR(p_numfis,'999999999999',l_numfis OUT);

   /*Tecnologia do Crachá*/
   l_teccra := p_teccra;
   SP_INTSTR(l_teccra,'9',l_tcraux OUT);

   /*Identificador da Pessoa*/
   l_idtpes := p_idtpes;

   /*Responsável Legal pela alteração*/
   SP_INTSTR(0, '99999999999', l_cpf_repleg_str OUT);
   
   /*Nome da Pessoa*/
   l_nomfun := p_nomfun;
   l_nomfun := lTrim(l_nomfun);
   l_nomfun := rTrim(l_nomfun);
   
   /*tamanho do Nome da pessoa*/
   l_tamnom := Length(l_nomfun);
   SP_INTSTR(l_tamnom,'999',l_tamnom_str OUT);
   SP_INTSTR(p_altbio,'9',l_altbio OUT);

   /* Repasso tambem o PIS e o CPF em campos distintos, 
    * para que a CSM Center não precise adivinhar o documento */
   SP_INTSTR(p_numpis,'99999999999',l_numpis OUT);
   SP_INTSTR(p_numcpf,'99999999999',l_numcpf OUT);

   /* Informa o CPF quando não há PIS (alteração para a portaria 671) */
   IF (p_numpis > 0) THEN
     l_numId := l_numpis;
   ELSE
     l_numId := l_numcpf;
   END IF;

   l_datatu    := CURDATE();
   l_horatu    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

   SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
   SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);

   /* data atual string no formato YYMMDDHHmm*/
   l_DatAux := SUBSTRING(l_datstr,5,2)||SUBSTRING(l_datstr,3,2)||SUBSTRING(l_datstr,1,2)||l_horstr;
   /* converte a data de validade no formato string YYMMDDHHmm*/
   l_ValAux :=  SUBSTRING(p_datval,5,2)||SUBSTRING(p_datval,3,2)||SUBSTRING(p_datval,1,2)||SUBSTRING(p_datval,7,4);

   /*Evitar que seja inserido registro INSERT com data passada. Se for I, data validade tem que ser maior igual a data atual*/
   IF (p_tipOpe <> 'I') OR ((p_tipOpe = 'I') AND (l_valAux >= l_DatAux)) THEN
	 /* verifica se é geração da lista de exclusão */
	 IF (p_tipOpe = 'D') OR (p_tipOpe = 'E') THEN
	   /*Parâmetro "D" é usado em todas as exclusões, na TR070CON, exceto na troca do VERPRM.*/
	   /*Gera na R070ACR registros para exclusão, que alteraram alguma permissão*/
	   IF (p_tipOpe = 'D') THEN
		   /* LOOP dos dispositivos que estão dentro da permissão */
		   FOREACH c_r058prm3 INTO l_r058prm3.numeip,
								   l_r058prm3.tiplei,
								   l_r058prm3.coddsp,
								   l_r058prm3.fabmod,
								   l_r058prm3.codcen,
								   l_r058prm3.autpes
								   
		   LOOP
				/* Multitecnologia */
				IF (l_r058prm3.tiplei = 11) THEN
					l_insere := TRUE;
				END IF;

				IF (p_numcra = p_numfis) THEN
				   l_insere := TRUE;
				END IF;

				IF (l_insere = TRUE) THEN
				  IF (l_gersen = TRUE) THEN
					 SP_INTSTR(l_r058prm3.coddsp,'999999999',l_coddsp OUT);
                     
					 /* tipope 1 = remove card */
					 l_tipope := '1';
					 l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;
					 
					 IF (l_r058prm3.autpes = 'L') AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm3.codcen);
					 END IF;

				  END IF;
				END IF;
		   END LOOP;
		ELSE
		   /*Passa aqui, quando o parâmetro de exclusão for "E" */
		   /*Parâmetro "E" é passado na troca do VERPRM, caso seja feita alteração de Não para SIM (Verifica Permissão)*/
		   /*Gera na R070ACR registros para exclusão, que estão fora da permissão do colaborador*/
		   /* LOOP dos dispositivos que estão dentro da permissão */
		   FOREACH c_r058prm4 INTO l_r058prm4.numeip,
								   l_r058prm4.tiplei,
								   l_r058prm4.coddsp,
								   l_r058prm4.fabmod,
								   l_r058prm4.codcen,
								   l_r058prm4.autpes
		   LOOP
			   /* trata registro de acordo com a leitora e tecnologia do crachá */
			   l_insere := FALSE;

			   /* Multitecnologia */
			   IF (l_r058prm4.tiplei = 11) THEN
				  l_insere := TRUE;
			   END IF;

			   IF (p_numcra = p_numfis) THEN
				  l_insere := TRUE;
			   END IF;

			   IF (l_insere = TRUE) THEN
				 IF (l_gersen = TRUE) THEN
				   SP_INTSTR(l_r058prm4.coddsp,'999999999',l_coddsp OUT);

				   /* tipope 1 = remove card */
				   l_tipope := '1';
				   l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm4.autpes = 'L') AND (P_TIPOPE <> 'D')  THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm4.codcen);
				     END IF;
				 END IF;
			   END IF;
		   END LOOP;
		END IF;
	 ELSE
		 /* para operação normal de INSERT e delete */
		 IF (p_tipope = 'F') OR (p_tipope = 'D') THEN
		   l_tipope := '1';
		 ELSE
		   l_tipope := '0';
		 END IF;

		 IF (p_verPrm = 1) THEN /* verprm = 'S' */

			 /* LOOP dos dispositivos que estão dentro da permissão*/
			 FOREACH c_r058prm INTO l_r058prm.numeip,
									l_r058prm.tiplei,
									l_r058prm.coddsp,
									l_r058prm.fabmod,
									l_r058prm.codcen,
									l_r058prm.autpes
			 LOOP
				 /* trata registro de acordo com a leitora e tecnologia do crachá */
				 l_insere := FALSE;
				   /* Multitecnologia */
				 IF (l_r058prm.tiplei = 11) THEN
					l_insere := TRUE;
				 END IF;

				 IF (l_insere = TRUE) THEN
					 /*verifica se já existe um registro ainda não enviado para este crachá e dispositivo */
				   IF (l_gersen = TRUE) THEN
					 SP_INTSTR(l_r058prm.coddsp,'999999999',l_coddsp OUT);

					 l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm.autpes = 'L')  AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm.codcen);
  					 END IF;
				   END IF;
				 END IF;
			 END LOOP;
		 ELSE
			 /* se não verifica permissão, gera para todos os dispositivos */
			 FOREACH c_r058prm2 INTO l_r058prm2.numeip,
									 l_r058prm2.tiplei,
									 l_r058prm2.coddsp,
									 l_r058prm2.fabmod,
									 l_r058prm2.codcen,
									 l_r058prm2.autpes
			 LOOP
				 /* trata registro de acordo com a leitora e tecnologia do crachá */
				 l_insere := FALSE;

				 /* Multitecnologia */
				 IF (l_r058prm2.tiplei = 11) THEN
					 l_insere := TRUE;
				 END IF;

				 IF (l_insere = TRUE) THEN
				   IF (l_gersen = TRUE) THEN
					  SP_INTSTR(l_r058prm2.coddsp,'999999999',l_coddsp OUT);
					  l_tipope := '0';
					  l_StrAux := '62'||l_datenv||l_coddsp||l_tipope||l_numfis||l_tcraux||l_idtpes||l_tamnom_str||l_nomfun||l_numId||l_altbio||l_cpf_repleg_str||l_numpis||l_numcpf;

					 IF (l_r058prm2.autpes = 'L')  AND (P_TIPOPE <> 'D') THEN
						SP_PENDPAL(l_coddsp, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
					 ELSE
						SP_PorComDSP(l_StrAux, l_r058prm2.codcen);
					 END IF;
				   END IF;
				 END IF;

			 END LOOP;
		 END IF;
	 END IF;
   END IF;
   
END␀€ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
