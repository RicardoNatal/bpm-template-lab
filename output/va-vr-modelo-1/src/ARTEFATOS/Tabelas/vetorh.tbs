  CURSOR c_r058CEN IS
    SELECT CODCEN FROM R058CEN WHERE GERSEN = 'S' AND TIPGER = 2;
  TYPE t_r058cen IS RECORD(
    CODCEN   R058CEN.CODCEN%TYPE);
  l_r058cen t_r058cen;
BEGIN
  /*Valida o código da CENTRALIZADORA, caso seja diferente de zero*/
  IF (p_codcen <> 0) THEN
      BEGIN
          SELECT COUNT(1) INTO l_count
            FROM R058CEN
           WHERE GERSEN = 'S'
             AND TIPGER = 2
             AND CODCEN = p_codcen;
      EXCEPTION
          WHEN OTHERS THEN
            RAISERROR 103 'SP_PEND56: Erro ao obter código da centralizadora.';
      END;
      IF (l_count = 0) THEN
          RAISERROR 103 'SP_PEND56: Centralizadora não encontrada.';
      END IF;
  END IF;

  /*Obtem a data/hora de envio da pendência.*/
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
  /*Obtem o Segundo*/
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  /*Monta a data do evento ddmmyyhhmmss*/
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

  /*p_codcen igual a zero, manda para todas as centralizadoras*/
  IF (p_codcen = 0) THEN
      FOREACH c_r058CEN INTO l_r058cen.CODCEN
      LOOP
          SP_INTSTR(l_r058cen.CODCEN, '99', l_codcenStr OUT);
          l_valstr := '56'||l_datenv||l_codcenStr;
          BEGIN
              SP_PORCOM(l_valstr,l_codcenStr);
          EXCEPTION
              WHEN OTHERS THEN
                RAISERROR 103 'SP_PEND56: Erro ao enviar pendência.(erro 01)';
          END;
      END LOOP;
  ELSE
      /*Manda para a centralizadora específicada*/
      SP_INTSTR(p_codcen, '99', l_codcenStr OUT);
      l_valstr := '56'||l_datenv||l_codcenStr;
      BEGIN
          SP_PORCOM(l_valstr,l_codcenStr);
      EXCEPTION
          WHEN OTHERS THEN
            RAISERROR 103 'SP_PEND56: Erro ao enviar pendência.(erro 02)';
      END;
  END IF;
END␀pø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
