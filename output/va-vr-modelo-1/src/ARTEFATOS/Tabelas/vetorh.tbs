            BEGIN
              GOTO EXC5
            END
            INSERT INTO r995prt
       (codrpa,namppa,conppa)
      VALUES
      (@l_codrpa,'TIPOPE','INCLUSÃO')
            SELECT @ChkError = @@Error
            IF @ChkError <> 0
            BEGIN
              GOTO EXC5
            END
          /* END TRY */
