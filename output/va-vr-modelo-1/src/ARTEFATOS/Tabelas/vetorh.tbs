									   CFGSAP,INTSAP,TABINT,FERSAB,ATUEFE,VERADM,VERQUA,VERQUF,USATUR,CTLQUA,TIPQUA,CONCAR,NIVQUA,
									   ULTPRE,EXCPRE,APRNAT,BAKINI,BAKFIM,CONCFI,CONTPV,CONTMP,NORRQU,SIMFIL,AJUSLD,APRFAI,APRLOT,
									   ORCIND,IDADEP,USASLD,CONFIS,ROTTOM,VALCAP,TIPSIJ,ALIRED,HISCON,ADMPER,CODIDN,HISPEN,CODDGH,
									   BAIFGT,SELCEN,PASPRV,GERVOC,ENTCAS,CLCSAI,BAIPIS,CONSIT,MODINF,MODP41,ABRCEN,INTDEM,VINPES,
									   VINPE2,VINPE3,VIPEDE,DIFIMP,USAPEM,USAPTE,USAPPA,DDDTEL,DDITEL,DDDFAX,DDIFAX,BASINS,LIMFIL,
									   USACOM,BLQADM,TABEST,NIVLOC,ORDFRE,CONEMI,INITOM,ARQINS,AMBSAP,RATADT,CENDIF,BUSREC,ADIPOS,USAHAG,DATHAG,FTOPIS)
