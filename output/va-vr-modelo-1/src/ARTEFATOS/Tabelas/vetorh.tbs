SP_RETICARD
␀␀/* Historico de Cracha - Colaborador */
PROCEDURE SP_CRAREL(P_TIPOPE CHAR,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_NUMCRA NUMBER(12),P_TIPCRA NUMBER(1),P_DATFIM DATE,P_HORFIM NUMBER(5))
 IS

  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_chcass       CHAR(1);
  l_cratit       NUMBER(12);
  l_crapro       NUMBER(12);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_craTitCon    NUMBER(12);
  l_craTitPro    NUMBER(12);
  l_comando      CHAR(2048);
  l_usutel       VARCHAR(31);
  l_cratitStr    CHAR(12);
  l_craproStr    CHAR(12);
  l_icardATit    VARCHAR2(12);
  l_icardRTit    VARCHAR2(12);
  l_numserTit    VARCHAR2(12);
  l_icardAPro    VARCHAR2(12);
  l_icardRPro    VARCHAR2(12);
  l_numserPro    VARCHAR2(12);
  l_idtcol       CHAR(23);
BEGIN
  SP_USUTEL(l_usutel OUT);
  BEGIN
      SELECT CHCASS INTO l_chcass FROM R070DAC;
  EXCEPTION
      WHEN OTHERS THEN
        l_chcass := 'N';
        RAISERROR 103 'SP_ATUTSI: Não Conseguiu Efetuar SELECT na Tabela R070DAC.';
  END;

  /*Se a operação for diferente de exclusão*/
  IF ((l_chcass = 'D') AND (p_tipope <> 'D')) THEN
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_data_atual := CURDATE();
      l_data_zero  := '31/12/1900,00:00:00';
      
      /* Monto o IDTPES para utilizar na SP_RETICARD */
      SP_RETIDTPES(p_numemp, p_tipcol, p_numcad, NULL, NULL, NULL, NULL, l_idtcol OUT);

      /*Gravando Crachá Provisório*/
      IF (p_tipcra = 2) THEN
          /*Verifica Validade do Crachá Provisório*/
          IF ((p_datfim > l_data_atual) OR (p_datfim = l_data_atual AND p_horfim > l_hora_atual) OR (p_datfim = l_data_zero)) THEN
              SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0, '',0,'', l_cratit OUT);
              IF (l_cratit <> 0) THEN
                  /*Obtem os Crachás Principais*/
                  /*Titular*/
                  SP_MAPFIS(l_cratit, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_craTitCon OUT);
                  /*No Caso do Smart ser o principal, na controle será o Icard 010000000001 (NumCra)*/
                  IF ((l_craTitCon = 0) OR (l_tecpri = 3)) THEN
                      l_craTitCon := l_cratit;
                      
                      /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
                      SP_RETICARD(l_idtcol, l_craTitCon, l_icardATit OUT, l_icardRTit OUT, l_numserTit OUT);
                      
                      l_cratitStr := l_icardATit;
                  ELSE
                      SP_INTSTR(l_craTitCon, '999999999999', l_cratitStr OUT);
                  END IF;
                  

                  /*Provisório*/
                  SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_craTitPro OUT);
                  /*No Caso do Smart ser o principal, na controle será o Icard 010000000001 (NumCra)*/
                  IF ((l_craTitPro = 0) OR (l_tecpri = 3)) THEN
                      l_craTitPro := p_numcra;
                      
                      /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
                      SP_RETICARD(l_idtcol, l_craTitPro, l_icardAPro OUT, l_icardRPro OUT, l_numserPro OUT);
                      
                      l_craproStr := l_icardAPro;
                  ELSE
                  	  SP_INTSTR(l_craTitPro, '999999999999', l_craproStr OUT);
                  END IF;

                  l_comando := 'UPDATE '||l_usutel||'CONTROLE SET SITUA = 4, TITULAR = '''||l_cratitStr||''' WHERE ICARD = '''||l_craproStr||'''';
                  SP_CMDTSI(l_comando);

                  l_comando := 'UPDATE '||l_usutel||'CONTROLE SET SITUA = 8 WHERE ICARD = '''||l_cratitStr||'''';
                  SP_CMDTSI(l_comando);

              END IF;
          END IF;
      /*Gravando Crachá Titular*/
      ELSIF (p_tipcra = 1) THEN
          SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0, '',0,'', l_crapro OUT);
          IF (l_crapro <> 0) THEN

              /*Obtem os Crachás Principais*/
              /*Titular*/
              SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_craTitCon OUT);
              /*No Caso do Smart ser o principal, na controle será o Icard 010000000001 (NumCra)*/
              IF ((l_craTitCon = 0) OR (l_tecpri = 3))THEN
                  l_craTitCon := p_numcra;

                  /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
                  SP_RETICARD(l_idtcol, l_craTitCon, l_icardATit OUT, l_icardRTit OUT, l_numserTit OUT);

                  l_cratitStr := l_icardATit;
              ELSE
                  SP_INTSTR(l_craTitCon,'999999999999',l_cratitStr OUT);
              END IF;

              /*Provisório*/
              SP_MAPFIS(l_crapro, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_craTitPro OUT);
              /*No Caso do Smart ser o principal, na controle será o Icard 010000000001 (NumCra)*/
              IF ((l_craTitPro = 0) OR (l_tecpri = 3)) THEN
                  l_craTitPro := l_crapro;

                  /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
                  SP_RETICARD(l_idtcol, l_craTitPro, l_icardAPro OUT, l_icardRPro OUT, l_numserPro OUT);

                  l_craproStr := l_icardAPro;
              ELSE
                  SP_INTSTR(l_craTitPro,'999999999999',l_craproStr OUT);
              END IF;

              l_comando := 'UPDATE '||l_usutel||'CONTROLE SET SITUA = 4, TITULAR = '''||l_cratitStr||''' WHERE ICARD = '''||l_craproStr||'''';
              SP_CMDTSI(l_comando);

              l_comando := 'UPDATE '||l_usutel||'CONTROLE SET SITUA = 8 WHERE ICARD = '''||l_cratitStr||'''';
              SP_CMDTSI(l_comando);
          END IF;
      END IF;
  END IF;
END		SENIOR;23RSP_USUTEL
SP_RETCRA
SP_MAPFIS
SP_INTSTR
SP_CMDTSI
SP_RETIDTPES
SP_RETICARD
␀␀/* Historico de Cracha - Colaborador */
PROCEDURE SP_CRAREL(P_TIPOPE CHAR,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_NUMCRA NUMBER(12),P_TIPCRA NUMBER(1),P_DATFIM DATE,P_HORFIM NUMBER(5))
 IS

  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_chcass       CHAR(1);
  l_cratit       NUMBER(12);
  l_crapro       NUMBER(12);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_craTitCon    NUMBER(12);
  l_craTitPro    NUMBER(12);
  l_comando      CHAR(2048);
  l_usutel       VARCHAR(31);
  l_cratitStr    CHAR(12);
  l_craproStr    CHAR(12);
  l_icardATit    VARCHAR2(12);
  l_icardRTit    VARCHAR2(12);
  l_numserTit    VARCHAR2(12);
  l_icardAPro    VARCHAR2(12);
  l_icardRPro    VARCHAR2(12);
  l_numserPro    VARCHAR2(12);
  l_idtcol       CHAR(23);
BEGIN
  SP_USUTEL(l_usutel OUT);
  BEGIN
      SELECT CHCASS INTO l_chcass FROM R070DAC;
  EXCEPTION
      WHEN OTHERS THEN
        l_chcass := 'N';
        RAISERROR 103 'SP_ATUTSI: Não Conseguiu Efetuar SELECT na Tabela R070DAC.';
  END;

  /*Se a operação for diferente de exclusão*/
  IF ((l_chcass = 'D') AND (p_tipope <> 'D')) THEN
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_data_atual := CURDATE();
      l_data_zero  := '31/12/1900,00:00:00';
      
      /* Monto o IDTPES para utilizar na SP_RETICARD */
      SP_RETIDTPES(p_numemp, p_tipcol, p_numcad, NULL, NULL, NULL, NULL, l_idtcol OUT);

      /*Gravando Crachá Provisório*/
      IF (p_tipcra = 2) THEN
          /*Verifica Validade do Crachá Provisório*/
          IF ((p_datfim > l_data_atual) OR (p_datfim = l_data_atual AND p_horfim > l_hora_atual) OR (p_datfim = l_data_zero)) THEN
              SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0, '',0,'', l_cratit OUT);
              IF (l_cratit <> 0) THEN
                  /*Obtem os Crachás Principais*/
                  /*Titular*/
                  SP_MAPFIS(l_cratit, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_craTitCon OUT);
                  /*No Caso do Smart ser o principal, na controle será o Icard 010000000001 (NumCra)*/
                  IF ((l_craTitCon = 0) OR (l_tecpri = 3)) THEN
                      l_craTitCon := l_cratit;
                      
                      /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
                      SP_RETICARD(l_idtcol, l_craTitCon, l_icardATit OUT, l_icardRTit OUT, l_numserTit OUT);
                      
                      l_cratitStr := l_icardATit;
                  ELSE
                      SP_INTSTR(l_craTitCon, '999999999999', l_cratitStr OUT);
                  END IF;
                  

                  /*Provisório*/
                  SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_craTitPro OUT);
                  /*No Caso do Smart ser o principal, na controle será o Icard 010000000001 (NumCra)*/
                  IF ((l_craTitPro = 0) OR (l_tecpri = 3)) THEN
                      l_craTitPro := p_numcra;
                      
                      /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
                      SP_RETICARD(l_idtcol, l_craTitPro, l_icardAPro OUT, l_icardRPro OUT, l_numserPro OUT);
                      
                      l_craproStr := l_icardAPro;
                  ELSE
                  	  SP_INTSTR(l_craTitPro, '999999999999', l_craproStr OUT);
                  END IF;

                  l_comando := 'UPDATE '||l_usutel||'CONTROLE SET SITUA = 4, TITULAR = '''||l_cratitStr||''' WHERE ICARD = '''||l_craproStr||'''';
                  SP_CMDTSI(l_comando);

                  l_comando := 'UPDATE '||l_usutel||'CONTROLE SET SITUA = 8 WHERE ICARD = '''||l_cratitStr||'''';
                  SP_CMDTSI(l_comando);

              END IF;
          END IF;
      /*Gravando Crachá Titular*/
      ELSIF (p_tipcra = 1) THEN
          SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0, '',0,'', l_crapro OUT);
          IF (l_crapro <> 0) THEN

              /*Obtem os Crachás Principais*/
              /*Titular*/
              SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_craTitCon OUT);
              /*No Caso do Smart ser o principal, na controle será o Icard 010000000001 (NumCra)*/
              IF ((l_craTitCon = 0) OR (l_tecpri = 3))THEN
                  l_craTitCon := p_numcra;

                  /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
                  SP_RETICARD(l_idtcol, l_craTitCon, l_icardATit OUT, l_icardRTit OUT, l_numserTit OUT);

                  l_cratitStr := l_icardATit;
              ELSE
                  SP_INTSTR(l_craTitCon,'999999999999',l_cratitStr OUT);
              END IF;

              /*Provisório*/
              SP_MAPFIS(l_crapro, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_craTitPro OUT);
              /*No Caso do Smart ser o principal, na controle será o Icard 010000000001 (NumCra)*/
              IF ((l_craTitPro = 0) OR (l_tecpri = 3)) THEN
                  l_craTitPro := l_crapro;

                  /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
                  SP_RETICARD(l_idtcol, l_craTitPro, l_icardAPro OUT, l_icardRPro OUT, l_numserPro OUT);

                  l_craproStr := l_icardAPro;
              ELSE
                  SP_INTSTR(l_craTitPro,'999999999999',l_craproStr OUT);
              END IF;

              l_comando := 'UPDATE '||l_usutel||'CONTROLE SET SITUA = 4, TITULAR = '''||l_cratitStr||''' WHERE ICARD = '''||l_craproStr||'''';
              SP_CMDTSI(l_comando);

              l_comando := 'UPDATE '||l_usutel||'CONTROLE SET SITUA = 8 WHERE ICARD = '''||l_cratitStr||'''';
              SP_CMDTSI(l_comando);
          END IF;
      END IF;
  END IF;
END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
