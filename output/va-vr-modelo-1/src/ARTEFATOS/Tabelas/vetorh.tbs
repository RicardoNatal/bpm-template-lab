␀ÿ␀␀ÿ␀0␀=€␀␀␀␀␀␀Èoï␀ï␀c␀␀␀␀ÿ␀␀ÿ␀èÄ␀␀=€␀␀␀␀␀␀ÅoüÄ␀␀ÿÄ␀␀c␀␀␀␀ÿ␀␀ÿ␀Ê½␀␀=€␀␀␀␀␀␀Q+␀f¿␀␀s¿␀␀c␀␀␀␀ÿ␀␀ÿ␀‰³␀␀=€␀␀␀␀␀␀N+␀OvOvc␀␀␀␀ÿ␀␀ÿ␀␀␀␀	0;1;2;3;4#ê␀␀		SENIOR;0À␀␀TRIGGER R583EPI_EI AFTER INSERT ON R583EPI FOR EACH ROW
DECLARE
	l_EmiPPPAgt   R082AGT.EmiPPP%TYPE;
	l_EmiPPPLau   R583LAU.EmiPPP%TYPE;
	l_ConsideraEPI BOOLEAN;
	l_NumEmp   R583FIL.NumEmp%TYPE;
	l_Json VARCHAR(2000);
	l_DatIniRevGhe   R583REV.DatIni%TYPE;
	l_DatTerRevGhe   R583REV.DatTer%TYPE;
	l_SitEsoRevGhe   R583REV.SitEso%TYPE;
	l_DataZero DATE;
	l_DatIniSST DATE;
	
	CURSOR C_EMPRESAS IS 
	SELECT DISTINCT NumEmp 
	FROM R583FIL 
	WHERE CodPRA = :NEW.CodPRA
	ORDER BY NumEmp;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	
	l_ConsideraEPI := TRUE;
	
	/* Se o EPI é específico de um agente de risco, verifica se o agente de risco está sendo considerado no PPP/eSocial */
	IF (:NEW.CodAgt > 0) THEN
		SM_RETINFAGT(:NEW.CodAgt, l_EmiPPPAgt OUT);
		SM_RETINFLAU(:NEW.CodPRA, :NEW.CodGHE, :NEW.RevGHE, :NEW.CodAgt, l_EmiPPPLau OUT);
		
		IF (l_EmiPPPAgt = 'N' OR l_EmiPPPLau = 'N') THEN
			l_ConsideraEPI := FALSE;
		END IF;
	END IF;
	
	IF (l_ConsideraEPI = TRUE) THEN
		SM_RETINFREVGHE(:NEW.CodPRA, :NEW.CodGHE, :NEW.RevGHE, l_DatIniRevGhe OUT, l_DatTerRevGhe OUT, l_SitEsoRevGhe OUT);
		
		/* Gera pendência apenas se a revisão do GHE estiver com situação 1 - Ativo */
		IF (l_SitEsoRevGhe = 1) THEN
			SP_CONCATENAR_NUM('CODPRA', :NEW.CodPRA, l_Json OUT);
			SP_CONCATENAR_NUM('CODGHE', :NEW.CodGHE, l_Json OUT);
			SP_CONCATENAR_DES('REVGHE', :NEW.RevGHE, l_Json OUT);
		
	  		FOREACH C_EMPRESAS INTO l_NumEmp
	  		LOOP
	  			RH_RET_DATINISST(l_NumEmp, l_DatIniSST OUT);
	  			IF (l_DatIniSST > l_DataZero) THEN
	 				IF (l_DatTerRevGhe > l_DatIniSST OR l_DatTerRevGhe = l_DataZero) THEN
  			  			IF (l_DatIniRevGhe < l_DatIniSST) THEN
  							l_DatIniRevGhe := l_DatIniSST;
  						END IF;
				
						SP_E_SOCIAL_SM('S-2240', 'R583EPI', 'N', 'I', l_DatIniRevGhe, l_DatTerRevGhe, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DatIniRevGhe, 0, 'R583EPI_EI');
					END IF;
				END IF;
			END LOOP;
		END IF;
	END IF;
END␀$ê␀␀		SENIOR;0i
