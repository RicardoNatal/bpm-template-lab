H␀␀PROCEDURE R115NOT_ATUNOT(P_TIPPNO NUMBER,P_CODORI NUMBER,P_NOMVIS VARCHAR2(255),P_EMAVIS VARCHAR2(255),P_DATPRV DATE,P_HORPRV NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_NOMOEM VARCHAR2(255),P_DDITEL NUMBER,P_DDDTEL NUMBER,P_TELCON VARCHAR2(255),P_DESPOR VARCHAR2(255),P_NOMEMP VARCHAR2(255),P_NOMFUN VARCHAR2(255),P_DDITELVISITADO NUMBER,P_DDDTELVISITADO NUMBER,P_TELCONVISITADO VARCHAR2(255),P_SITUACAOWAV VARCHAR2(255),P_TIPDOC NUMBER,P_DESDOC VARCHAR2(255),P_NUMDOC VARCHAR2(255),P_TIPVIS NUMBER,P_NOMTIPVIS VARCHAR2(255),P_CODPOR NUMBER,P_CODPRM NUMBER,P_DESPRM VARCHAR2(255),P_PLAVEI VARCHAR2(255),P_NOMAUT VARCHAR2(255),P_OBSVIS VARCHAR2(255),P_NOMSOL VARCHAR2(255),P_EMASOL VARCHAR2(255),P_DATSAG DATE,P_HORSAG NUMBER,P_NOMUSU VARCHAR2(255),P_DATPSA DATE,P_HORPSA NUMBER,P_OBSREP VARCHAR2(255))
 IS

l_data      DATE;
  l_DatHorAtu NUMBER(14, 6);
  l_DatAtuStr VARCHAR(10);
  l_HorAtuStr VARCHAR(5);
  l_data_zero NUMBER(14, 6);
  l_DthLim    NUMBER(14, 6);
  l_codnot    NUMBER(8);
  l_LocAgvStr VARCHAR(6);
  l_DatVisStr VARCHAR(10);
  l_HorVisStr VARCHAR(5);
  l_fonVis    VARCHAR(30);
  l_fonVisitado VARCHAR(30);
  l_DatValStr VARCHAR(10);
  l_HorValStr VARCHAR(5);
  l_DtHValStr VARCHAR(25);
  l_DatHorVal DATE;

  l_TIPDOCStr VARCHAR(1);
  l_TIPVISStr VARCHAR(3);
  l_CODPORStr VARCHAR(3);
  l_CODPRMStr VARCHAR(5);
  l_DATSAGStr VARCHAR(10);
  l_HORSAGStr VARCHAR(5);
  l_DATPSAStr VARCHAR(10);
  l_HORPSAStr VARCHAR(5);
  
BEGIN
  /*DATA ZERO*/
  l_data_zero := 364.0; /* '31-12-1900' */

  /* Retorna Data e hora atual (DateTime) */
  SP_DATETIME(l_DatHorAtu OUT);
  
  /* ORACLE */
  /* l_data := GETDBDATETIME();*/
  
  /* SQL SERVER */
  l_data := GETDATE();

  SP_DATSTR(l_data,'DD/MM/YYYY', l_DatAtuStr OUT);
  SP_HORSTR(l_data, 'HH:MM', l_HorAtuStr OUT);

  IF (p_DatPrv IS NOT NULL) THEN
    SP_DATSTR(p_DatPrv,'DD/MM/YYYY', l_DatVisStr OUT);
    SP_INTSTR(p_HorPrv, 'HH:MM', l_HorVisStr OUT);
  END IF;
  /* Data Validade */
  IF (p_DatVal IS NOT NULL) THEN
    SP_DATSTR(p_DatVal,'DD/MM/YYYY', l_DatValStr OUT);
    SP_INTSTR(p_HorVal, 'HH:MM', l_HorValStr OUT);
    l_DtHValStr := l_DatValStr || ' ' || l_HorValStr || ':00';
    SP_STRTODATE(l_DtHValStr, 'DD/MM/AAAA hh:mi:ss', l_DatHorVal OUT);
    
    /* Atualizar variável "Data/Hora Limite" */
    SP_DATETONUMBER(l_DatHorVal, l_DthLim OUT);
  ELSE
    l_DthLim := l_data_zero;
  END IF;

  /* Telefone do Visitado */  
  l_fonVisitado := ltrim(rtrim(replace(p_TelconVisitado, '-', '')));

  IF p_DDDTelVisitado IS NOT NULL AND p_DDDTelVisitado > 0 THEN
    l_fonVisitado := ltrim(rtrim(p_DDDTelVisitado)) || '-' || l_fonVisitado; 
  END IF;

  IF p_DDITelVisitado IS NOT NULL AND p_DDITelVisitado > 0 THEN
    l_fonVisitado := ltrim(rtrim(p_DDITelVisitado)) || '-' || l_fonVisitado; 
  END IF;
  
  /* Agendamento de Visita por E-mail */  
  IF (p_TipPNo = 1) AND (p_EmaVis IS NOT NULL AND LOCATE('@', p_EmaVis, 1) > 0) THEN
    /*GERA A STRING DO CODIGO LOCALIZADOR*/
    SP_CODLOCALIZADOR(p_CodOri, l_LocAgvStr OUT);  

    /* ORACLE */ 
    /*l_codnot := SEQ_R115NOT.nextval;
     
    INSERT INTO R115NOT 
      (CodNot, TipNot, StaNot, DthNot, DthLim, CodOri, QtdEnv)
    VALUES
      (l_codnot, p_TipPNo, 0, l_DatHorAtu, l_DthLim, p_CodOri, 0);*/
    
    /* SQL SERVER*/
    INSERT INTO R115NOT 
      (TipNot, StaNot, DthNot, DthLim, CodOri, QtdEnv)
    VALUES
      (p_TipPNo, 0, l_DatHorAtu, l_DthLim, p_CodOri, 0);

    l_codnot := SCOPE_IDENTITY();
    
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'email', p_EmaVis);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'assunto', 'Agendamento de visita realizado');
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'localizador', l_LocAgvStr);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'dataVisita', l_DatVisStr);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'horaVisita', l_HorVisStr);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomeVisitante', p_NomVis);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomePortaria', p_DesPor);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomeEmpresaVisitante', p_NomOem);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomeEmpresaVisitado', p_NomEmp);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomeVisitado', p_NomFun);
    
  /* Agendamento de Visita por SMS */
  ELSIF (p_TipPNo = 2) AND (p_TelCon IS NOT NULL AND LENGTH(LTRIM(RTRIM(p_TelCon))) > 0) THEN
    /*GERA A STRING DO CODIGO LOCALIZADOR*/
    SP_CODLOCALIZADOR(p_CodOri, l_LocAgvStr OUT);  
  
    /* ORACLE */ 
    /*l_codnot := SEQ_R115NOT.nextval;

    INSERT INTO R115NOT 
      (CodNot, TipNot, StaNot, DthNot, DthLim, CodOri, QtdEnv)
    VALUES
      (l_codnot, p_TipPNo, 0, l_DatHorAtu, l_DthLim, p_CodOri, 0);*/

    /* SQLSERVER*/
    INSERT INTO R115NOT 
      (TipNot, StaNot, DthNot, DthLim, CodOri, QtdEnv)
    VALUES
      (p_TipPNo, 0, l_DatHorAtu, l_DthLim, p_CodOri, 0);

    l_codnot := SCOPE_IDENTITY();   
  
    l_fonVis := ltrim(rtrim(replace(p_Telcon, '-', '')));

    IF p_DDDTel IS NOT NULL AND p_DDDTel > 0 THEN
      l_fonVis := ltrim(rtrim(p_DDDTel)) || '-' || l_fonVis; 
    END IF;

    IF p_DDITel IS NOT NULL AND p_DDITel > 0 THEN
      l_fonVis := ltrim(rtrim(p_DDITel)) || '-' || l_fonVis; 
    END IF;

    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'telefone', l_fonVis);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'localizador', l_LocAgvStr);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'dataVisita', l_DatVisStr);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'horaVisita', l_HorVisStr);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomeVisitante', p_NomVis);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomePortaria', p_DesPor);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomeEmpresaVisitante', p_NomOem);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomeEmpresaVisitado', p_NomEmp);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomeVisitado', p_NomFun);
    
  /* Chegada do Visitante por E-mail */
  ELSIF (p_TipPNo = 3)  AND (p_EmaSol IS NOT NULL AND LOCATE('@', p_EmaSol, 1) > 0) THEN
  
    /* ORACLE */
    /*l_codnot := SEQ_R115NOT.nextval;
    
    INSERT INTO R115NOT 
      (CodNot, TipNot, StaNot, DthNot, DthLim, CodOri, QtdEnv)
    VALUES
      (l_codnot, p_TipPNo, 0, l_DatHorAtu, l_data_zero, p_CodOri, 0);*/
      
    /* SQLSERVER */
    INSERT INTO R115NOT 
      (TipNot, StaNot, DthNot, DthLim, CodOri, QtdEnv)
    VALUES
      (p_TipPNo, 0, l_DatHorAtu, l_data_zero, p_CodOri, 0);

    l_codnot := SCOPE_IDENTITY();
	
	l_fonVis := ltrim(rtrim(replace(p_Telcon, '-', '')));

    IF p_DDDTel IS NOT NULL AND p_DDDTel > 0 THEN
      l_fonVis := ltrim(rtrim(p_DDDTel)) || '-' || l_fonVis; 
    END IF;

    IF p_DDITel IS NOT NULL AND p_DDITel > 0 THEN
      l_fonVis := ltrim(rtrim(p_DDITel)) || '-' || l_fonVis; 
    END IF;

    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'email', p_EmaSol);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'assunto', 'Chegada do visitante ' || p_NomVis);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'dataChegada', l_DatAtuStr);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'horaChegada', l_HorAtuStr);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomeVisitante', p_NomVis);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'telefoneVisitante', l_fonVis);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomePortaria', p_DesPor);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomeEmpresaVisitado', p_NomEmp);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomeVisitado', p_NomFun);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomeEmpresaVisitante', p_NomOem);
    
  /* Chegada do Visitante por SMS */
  ELSIF (p_TipPNo = 4) AND (p_TelConVisitado IS NOT NULL AND LENGTH(LTRIM(RTRIM(p_TelConVisitado))) > 0) THEN
  
    /* ORACLE */ 
    /*l_codnot := SEQ_R115NOT.nextval;
    
    INSERT INTO R115NOT 
      (CodNot, TipNot, StaNot, DthNot, DthLim, CodOri, QtdEnv)
    VALUES
      (l_codnot, p_TipPNo, 0, l_DatHorAtu, l_data_zero, p_CodOri, 0); */
  
    /* SQL SERVER */
    INSERT INTO R115NOT 
      (TipNot, StaNot, DthNot, DthLim, CodOri, QtdEnv)
    VALUES
      (p_TipPNo, 0, l_DatHorAtu, l_data_zero, p_CodOri, 0);
     l_codnot := SCOPE_IDENTITY();

