™␀␀
™␀␀c␀␀␀ÿ␀␀ÿ␀XÆ␀␀Ì␀Ôï!␀␀␀␀␀İ±␀␀Ë¯␀␀Ì¯␀␀k␀Æÿ␀␀†Ò␀␀␀␀␀␀0;1;20Ò␀␀		SENIOR;0␀␀TRIGGER R030FGF_EI AFTER INSERT ON R030FGF FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs - Filiais - Percentuais Adicionais FGTS */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 53;     /* Filiais - Percentuais Adicionais FGTS */
  l_codtpa := 217;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030FGF_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
        SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030FGF_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OPTSIM', CONVERT(NUMBER_TO_CHAR, :NEW.OPTSIM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERFGT', CONVERT(NUMBER_TO_CHAR, :NEW.PERFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERMUL', CONVERT(NUMBER_TO_CHAR, :NEW.PERMUL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TEMLIM', :NEW.TEMLIM);
      END;
  END IF; 
END␀1Ò␀␀		SENIOR;0ø	␀␀ 

TRIGGER R030FGF_EU AFTER UPDATE ON R030FGF FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs - Filiais - Percentuais Adicionais FGTS */
  l_codSistema := 1;  /* Código do sistema vetorh. */ 
  l_codcpa := 53;     /* Filiais - Percentuais Adicionais FGTS */
  l_codtpa := 218;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);  

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFil <> :NEW.CodFil)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.OptSim <> :NEW.OptSim)
   OR (:OLD.PerFgt <> :NEW.PerFgt)
   OR (:OLD.PerMul <> :NEW.PerMul)
   OR (:OLD.TemLim <> :NEW.TemLim)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030FGF_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030FGF_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOPTSIM', CONVERT(NUMBER_TO_CHAR, :OLD.OPTSIM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOPTSIM', CONVERT(NUMBER_TO_CHAR, :NEW.OPTSIM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERFGT', CONVERT(NUMBER_TO_CHAR, :OLD.PERFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERFGT', CONVERT(NUMBER_TO_CHAR, :NEW.PERFGT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERMUL', CONVERT(NUMBER_TO_CHAR, :OLD.PERMUL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERMUL', CONVERT(NUMBER_TO_CHAR, :NEW.PERMUL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTEMLIM', :OLD.TEMLIM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTEMLIM', :NEW.TEMLIM);
      END;
    END IF; 
  END IF; 
END␀/Ò␀␀		SENIOR;0␀␀ 

