TRIGGER R071AEO_EU AFTER UPDATE ON R071AEO FOR EACH ROW
DECLARE
  l_online       BOOLEAN;
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R071AEO_AUX;
  
BEGIN
SP_VerOnLine(l_online OUT);
IF   (l_online = TRUE) THEN
     IF  (    (:NEW.DATSAI <> :OLD.DATSAI)
           OR (:NEW.HORSAI <> :OLD.HORSAI)  )
       OR(    (:NEW.DATVAL <> :OLD.DATVAL)
           OR (:NEW.HORVAL <> :OLD.HORVAL)  )  THEN
         BEGIN

            /* Insere Registro NEW */
            INSERT INTO R071AEO_AUX (NUMEMP,NUMCAD)
            VALUES (:NEW.NUMEMP,:NEW.NUMCAD);
         EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'Erro no INSERT em R071AEO_AUX.';
         END;
     END IF;
END IF;
END␀£Ú␀␀	SENIOR;0İ␀␀

