ò␀␀PROCEDURE SP_RETDATREF_S2500 (P_NUMEMP NUMBER(4), P_TIPCOL NUMBER(1), P_NUMCAD NUMBER(9), P_CODPRO NUMBER(9), P_DATREF OUT DATE)
IS

	l_OriPro NUMBER;
	l_DatSen DATE;
	l_DatCon DATE;
BEGIN
	l_OriPro := 0;
	l_DatSen := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DatCon := DATETIME(31, 12, 1900, 0, 0, 0);

	BEGIN
		SELECT ORIPRO, DATSEN, DATCON 
		  INTO l_OriPro, l_DatSen, l_DatCon
		  FROM R346CPT
		 WHERE NUMEMP = P_NUMEMP
		   AND TIPCOL = P_TIPCOL
		   AND NUMCAD = P_NUMCAD
		   AND CODPRO = P_CODPRO;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar informações do processo trabalhista.';
	END;
   
	IF (l_OriPro = 1) THEN
		P_DATREF := l_DatSen;
	ELSIF (l_OriPro = 2) THEN
		P_DATREF := l_DatCon;
	END IF;
END␀»ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
²␀␀PROCEDURE SP_RETENVESO_HCE(P_NUMEMP NUMBER(4), P_TIPCOL NUMBER(1), P_NUMCAD NUMBER(9), P_DATINI DATE, P_ENVESO OUT NUMBER(1)) IS

	l_EnvEso   R038HCE.ENVESO%TYPE;
BEGIN
	BEGIN
		SELECT IFNULL(ENVESO, 0) INTO l_EnvEso
		  FROM R038HCE
		 WHERE NUMEMP = P_NUMEMP 
		   AND TIPCOL = P_TIPCOL 
		   AND NUMCAD = P_NUMCAD 
		   AND DATINI = P_DATINI;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_EnvEso := 0;
	END;

	P_ENVESO := l_EnvEso;
END␀¼ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Û/* Troca caracteres acentuados pelo o mesmo sem acento e deleta carateres especiais*/
PROCEDURE SP_RETFILIAL(P_VERPLF NUMBER(3),P_CODPLF NUMBER(7),P_NUMEMP OUT NUMBER(4),P_CODFIL OUT NUMBER(6))
 IS
BEGIN
 NULL;
END		ORACLE;20
	␀␀create or replace PROCEDURE SP_RETFILIAL(p_verplf IN NUMBER,p_codplf IN NUMBER,p_numemp OUT NUMBER,p_codfil OUT NUMBER) is
  l_numcgc NUMBER(14);
  l_verplf NUMBER(3);
  l_codplf NUMBER(9);
  l_paiplf NUMBER(9);
  l_numemp NUMBER(4);
  l_codfil NUMBER(6);
begin
  l_numcgc := 0;
  l_verplf := p_verplf;
  l_codplf := p_codplf;
  begin
    loop
      SELECT 
      R058PLF.PAIPLF R058PLF_PAIPLF,R058PLT.NUMEMP R058PLT_NUMEMP,R058PLT.CODFIL R058PLT_CODFIL
       INTO l_paiplf,l_numemp,l_codfil 
       FROM R058PLF R058PLF, R058PLT R058PLT WHERE 
       R058PLF.VERPLF = R058PLT.VERPLF(+) AND R058PLF.CODPLF = R058PLT.CODPLF(+) AND 
       R058PLF.CODPLF=l_codplf 
      AND R058PLF.VERPLF=l_verplf;
      if (l_numemp<>0 
      AND l_codfil<>0) 
      OR (l_paiplf=0) then
        EXIT;
      else
        l_codplf := l_paiplf;
      end if;
    end loop;
  exception
    when OTHERS then
      l_numemp := 0;
      l_codfil := 0;
  end;
  p_numemp := l_numemp;
  p_codfil := l_codfil;
end;



	MSSQL;23
‡␀␀-- P:\TRIGGERS\SPRETFILIAL.SQL vs. MSSQL2000, traduzido em: 01/04/2011 - 10:52:20

CREATE  PROCEDURE sp_retfilial(@p_verplf SMALLINT, @p_codplf INTEGER, @p_numemp SMALLINT OUTPUT, @p_codfil SMALLINT OUTPUT) AS
BEGIN
DECLARE @l_numcgc BIGINT
DECLARE @l_verplf SMALLINT
DECLARE @l_codplf INTEGER
DECLARE @l_paiplf INTEGER
DECLARE @l_numemp SMALLINT
DECLARE @l_codfil SMALLINT
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  SELECT @ChkError = 0
  SELECT @l_numcgc = 0
  SELECT @l_verplf = @p_verplf
  SELECT @l_codplf = @p_codplf
  /* TRY */
    WHILE 1=1
    BEGIN
      SELECT 
      @l_paiplf=r058plf.paiplf ,@l_numemp=r058plt.numemp ,@l_codfil=r058plt.codfil 
       FROM r058plf r058plf
       LEFT OUTER JOIN R058PLT ON R058PLF.VERPLF = R058PLT.VERPLF AND R058PLF.CODPLF = R058PLT.CODPLF
       WHERE r058plf.codplf=@l_codplf 
      and r058plf.verplf=@l_verplf
      SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
      IF @ChkError <> 0
      BEGIN
        GOTO EXC1
      END
      IF (@l_numemp<>0 
      AND @l_codfil<>0) 
      OR (@l_paiplf=0)
      BEGIN
        BREAK
      END
      ELSE
      BEGIN
        SELECT @l_codplf = @l_paiplf
      END
    END
    IF @ChkError <> 0
      GOTO EXC1
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC1:
    SELECT @SE_EXC1 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        SELECT @l_numemp = 0
        SELECT @l_codfil = 0
      END
    END
  /* END EXCEPTION HANDLER */
  SELECT @p_numemp = @l_numemp
  SELECT @p_codfil = @l_codfil
FIM:
  RETURN @ChkError
END


