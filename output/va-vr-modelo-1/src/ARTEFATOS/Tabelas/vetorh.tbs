␀ÿ;␀Åu‘␀␀␀␀␀␀␀␀␀ÿÿÿÿ␀	␀Æÿ␀␀ÿ␀ó¥␀␀´␀	␀␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀ê¥␀␀Ì␀	␀␀␀␀␀␀␀␀‚%€$0.w␀Æÿ␀␀ÿ␀W␀Š␀	␀␀␀␀␀␀␀␀Ü␀Ü␀Ü␀n␀Æÿ␀␀ÿ␀†¸␀␀Ñ␀␀␀␀␀␀␀␀␀m0Ó/Ó/œ␀␀␀êÿ␀␀ÿ␀␀“␀␀ SELECT 
     CASE max(horcen)
        WHEN 'S'  THEN sum(R046VER.REFEVE)
        WHEN 'N' THEN sum(R046VER.Refeve + (((R046VER.Refeve - Trunc(R046ver.Refeve,0))/60)  * 100))
    END horfal,
    r046ver.numemp,
    r046ver.numcad,
    r046ver.tipcol,
    r044cal.perref
FROM 
    R046VER,
    R044CAL,
    R008EVC,
    R000ASS 
WHERE 
    R044CAL.NUMEMP = R046VER.NUMEMP 
    AND R044CAL.CODCAL = R046VER.CODCAL 
    AND R008EVC.CODTAB = R046VER.TABEVE 
    AND R008EVC.CODEVE = R046VER.CODEVE 
    AND R008EVC.CODCRT  IN (103,203,303,104,204,304)
GROUP BY
    r046ver.numemp,
    r046ver.tipcol,
    r046ver.numcad,
    r044cal.perref␀␀ÿÇ␀#­␀␀␀␀␀␀␀␀␀ú(ô(ø(p␀Æÿ␀␀ÿ␀0#·␀	␀␀␀␀␀␀␀␀~=¿␀␀¿␀␀q␀Æÿ␀␀ÿ␀­␀␀␀␀␀␀␀␀␀4␀Ç2␀c␀␀␀ÿ␀␀ÿ␀␀␀␀ SELECT b.codcen, a.CODPRM, d.acaprm
FROM r058rlp a, r058rlg b, r058prm d
WHERE a.CODPLT = b.CODPLT 
	AND a.CODRLG = b.CODRLG 
        AND b.codcen IN (SELECT c.codcen FROM r058cen c WHERE gersen = 'S')
        AND a.CODPRM = d.CODPRM
UNION       
SELECT b.codcen, a.CODPRM, e.acaprm
FROM r058grp a, r058rlg b, r058grl d, r058prm e
WHERE d.codgrr = a.codgrr 
      AND d.CODPLT = b.CODPLT
      AND d.CODRLG = b.CODRLG
      AND b.codcen IN (SELECT c.codcen FROM r058cen c WHERE gersen = 'S')
      AND e.CODPRM = a.CODPRM␀␀ÿ¶␀ó¥␀␀´␀	␀␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀(␀´␀	␀␀␀␀␀␀␀␀>½␀␀r␀Æÿ␀␀ÿ␀ù¥␀␀Ì␀	␀␀␀␀␀␀␀␀Ôš␀␀€š␀␀€š␀␀m␀Æÿ␀␀ÿ␀c`´␀	␀␀␀␀␀␀␀␀÷<ïe»fr␀Æÿ␀␀ÿ␀#4	␀␀␀␀␀␀␀␀ÿ?µ'µ'}␀␀ÿ␀␀ÿ␀"Ñ␀	␀␀␀␀␀␀␀␀;MÙEÙEqC␀êÿ␀␀ÿ␀␀_␀␀ SELECT 
R080QUA.NUMEMP NUMEMP,
R080QUA.TABORG TABORG,
R080QUA.NUMLOC NUMLOC,
R080QUA.ESTCAR ESTCAR,
R080QUA.CODCAR CODCAR,
R080QUA.CMPQUA CMPQUA
FROM 	
R080QUA,R016HIE
WHERE
(R016HIE.DATINI <= R080QUA.CMPQUA) AND
(R016HIE.DATFIM >= R080QUA.CMPQUA) AND
(R016HIE.NUMLOC = R080QUA.NUMLOC)
UNION 
(SELECT 
R080EFE.NUMEMP NUMEMP,
R080EFE.TABORG TABORG,
R080EFE.NUMLOC NUMLOC,
R080EFE.ESTCAR ESTCAR,
R080EFE.CODCAR CODCAR,
