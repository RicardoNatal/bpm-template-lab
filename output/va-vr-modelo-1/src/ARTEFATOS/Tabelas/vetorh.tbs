n#␀␀PROCEDURE SP_SINHCH2(
    p_tipope    NUMBER(1),
    p_numemp    NUMBER(4),
    p_tipcol    NUMBER(1),
    p_numcad    NUMBER(9),
    p_nummat    VARCHAR2(15),	
    p_numcra    NUMBER(12),
    p_datIni    DATE,
    p_horIni    NUMBER(4),
    p_datFim    DATE,
    p_horFim    NUMBER(4),
    p_codusu    NUMBER(10),
    p_craent    CHAR(1),
    p_codmso    NUMBER(2),
	P_RETERR OUT NUMBER(2)
)
 IS

    l_coderr    NUMBER(2);
    l_datFim    DATE;
    l_horFim    NUMBER(4);
    l_Straux   VARCHAR2(2047);
    l_seqenv   NUMBER(2);
    l_seqstr   VARCHAR2(2);
    l_datstr   VARCHAR2(6);
    l_horstr   VARCHAR2(4);
    l_datenv   VARCHAR2(16);
    l_cratit   NUMBER(12);
    l_tectit   NUMBER(1);
    l_fispri   NUMBER(12);
    l_numbar   NUMBER(12);
    l_numpro   NUMBER(12);
    l_numsma   NUMBER(12);
    l_numfis_str VARCHAR2(12);
    l_hora_atual      NUMBER(4);
    l_data_atual      DATE;
BEGIN
    /* inicializa variáveis */
    l_coderr := 0;
    p_RetErr := 0;
    l_datFim := p_datFim;
    l_horFim := p_horFim;
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    l_data_atual := CURDATE();

    /* Se colaborador                                      */
    /*          INSERÇÃO                                   */
    /*                  verifica sobreposição              */
    /*                  registro de log de auditoria       */
    /*          BAIXA                                      */
    /*                  registro de log de auditoria       */
    /*                  verifica sobreposição              */
    /* Se aluno                                            */
    /*          INSERÇÃO                                   */
    /*                  verifica sobreposição              */
    /*          BAIXA                                      */
    /*                  verifica sobreposição              */


    IF  (l_coderr = 0) THEN
        /* colaborador */
        IF (p_tipcol > 0) THEN

            /* Verifica operação */
            IF  (p_tipope = 0) THEN    /* Inserir crachá de colaborador */

                /* verifica sobreposição */
                BEGIN
                    R038HCH_VSOB('I',2, p_NumEmp, p_TipCol, p_NumCad, p_numcra, p_datIni, p_horIni,p_datIni, 1439);
                EXCEPTION
                    WHEN OTHERS THEN l_coderr := 2;  /* erro de sobreposição */
                END;

                IF  (l_coderr = 0) THEN
                    BEGIN
                        INSERT INTO R038HCH (TIPCRA,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,VIACRA,
                                             NUMCRA,DATFIM,HORFIM,RECEPR,STAATU,STAACC,CODUSU,CRAENT,CODMSO) VALUES
                                            (2,p_numemp,p_tipcol,p_numcad,p_datIni,p_horIni,1,
                                             p_numcra,l_datFim,l_horFim,'',1,1,p_codusu,p_craent,p_codmso);
                    EXCEPTION
                        WHEN OTHERS THEN l_coderr := 3;  /* erro no INSERT do registro*/
                    END;

                    /* Sincronizar histórico de alterações */
                    SP_SINAUD(p_tipope, p_numemp, p_tipcol, p_numcad, p_datIni, p_horIni, p_numcra,
                              l_datFim, l_horFim, p_codusu, l_coderr OUT);
                END IF;
            END IF; /*(p_tipope = 0)*/

            /* Verifica operação */
            IF  (p_tipope = 1) THEN    /* Baixa crachá de colaborador */
                IF NOT((l_datFim = p_datIni) AND (l_horFim = p_horIni)) THEN
                    IF  ((l_horFim = 0) OR (l_horFim = 1) AND (p_horIni > 0)) THEN
                       l_horFim := 1439;
                       l_datFim := DATETimeAdd(DD, -1, l_datFim);
                    ELSE
                       l_horFim := l_horFim-1;
                    END IF;
                END IF;
            
                /* verifica sobreposição */
                BEGIN
                    R038HCH_VSOB('U',2, p_NumEmp, p_TipCol, p_NumCad, p_numcra, p_datIni, p_horIni,p_datIni, 1439);
                EXCEPTION
                    WHEN OTHERS THEN l_coderr := 4;  /* erro de sobreposição */
                END;
                
                IF  (l_coderr = 0) THEN

                    /* Sincronizar histórico de alterações antes para pegar o valor OLD */
                    SP_SINAUD(p_tipope, p_numemp, p_tipcol, p_numcad, p_datIni, p_horIni, p_numcra,
                              l_datFim, l_horFim, p_codusu, l_coderr OUT);

                    BEGIN
                        UPDATE R038HCH SET DATFIM = l_datFim, HORFIM = l_horFim, STAACC = 2, STAATU = 2, CRAENT = p_craent
                                     WHERE TIPCRA = 2 AND
                                           NUMEMP = p_numemp AND
                                           TIPCOL = p_tipcol AND
                                           NUMCAD = p_numcad AND
                                           DATINI = p_datIni AND
                                           HORINI = p_horIni;
                    EXCEPTION
                        WHEN OTHERS THEN l_coderr := 5;  /* erro no update do registro */
                    END;
                END IF;
            END IF;
        END IF;  /* colaborador */

        /* aluno */
        IF (p_tipcol = 0) THEN
            /* Verifica operação */
            IF  (p_tipope = 0) THEN    /* Inserir crachá de aluno */

                /* verifica sobreposição */
                BEGIN
                    R073HCH_VSOB('I',2, p_nummat, p_numcra, p_datIni, p_horIni, l_datFim, l_horFim);
                EXCEPTION
                    WHEN OTHERS THEN l_coderr := 6;  /* erro de sobreposição */
                END;
                IF  (l_coderr = 0) THEN
                    BEGIN
                        INSERT INTO R073HCH (TIPCRA,NUMMAT,DATINI,HORINI,NUMCRA,DATFIM,HORFIM,STAATU,CODUSU,CRAENT) VALUES
                                            (2,p_nummat,p_datIni,p_horIni,p_numcra,l_datFim,l_horFim,1,p_codusu,p_craent);
                    EXCEPTION
                        WHEN OTHERS THEN l_coderr := 7;  /* erro no INSERT do registro*/
                    END;
                END IF;
            END IF;

            /* Verifica operação */
            IF  (p_tipope = 1) THEN    /* Baixa crachá de aluno */
                IF NOT((l_datFim = p_datIni) AND (l_horFim = p_horIni)) THEN
                    IF  ((l_horFim = 0) OR (l_horFim = 1) AND (p_horIni > 0)) THEN
                       l_horFim := 1439;
                       l_datFim := DATETimeAdd(DD, -1, l_datFim);
                    ELSE
                       l_horFim := l_horFim-1;
                    END IF;
                END IF;
                /* verifica sobreposição */
                BEGIN
                    R073HCH_VSOB('U',2, p_nummat, p_numcra, p_datIni, p_horIni, l_datFim, l_horFim);
                EXCEPTION
                    WHEN OTHERS THEN l_coderr := 8;  /* erro de sobreposição */
                END;
                IF  (l_coderr = 0) THEN
                    BEGIN
                        UPDATE R073HCH SET DATFIM = l_datFim, HORFIM = l_horFim, STAATU = 2, CRAENT = p_craent
                                     WHERE TIPCRA = 2 AND
                                           NUMMAT = p_nummat AND
                                           DATINI = p_datIni AND
                                           HORINI = p_horIni;
                    EXCEPTION
                        WHEN OTHERS THEN l_coderr := 9;  /* erro no update do registro */
                    END;                    
                    
                    /* Envia pendência de desbloqueio do crachá titular do aluno. */
                    l_seqenv := SECOND(CURTIME());
                    SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
                    SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
                    SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
                    l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

                    SP_RETCRA(1, 0, 6, 0, 0, p_nummat, 0, '', l_cratit OUT);
                    SP_MAPFIS(l_cratit, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tectit OUT, l_fispri OUT);

                    IF (l_numbar > 0) THEN
                      SP_INTSTR(l_numbar, '999999999999', l_numfis_str OUT);
                    ELSE
                      IF (l_numpro > 0) THEN
                        SP_INTSTR(l_numpro, '999999999999', l_numfis_str OUT);
                      ELSE
                        IF (l_numsma > 0) THEN
                          SP_INTSTR(l_numsma, '999999999999', l_numfis_str OUT);
                        ELSE
                          SP_INTSTR(l_cratit, '999999999999', l_numfis_str OUT);
                        END IF;
                      END IF;
                    END IF;
 
                    l_StrAux := '05'||l_datenv||l_numfis_str||'000';
                    SP_PorCom(l_StrAux, '0');
                    
                END IF;
            END IF;
        END IF;  /* aluno */
    END IF; /* (l_coderr = 0) */

    /* retorna Código do erro */
    p_retErr := l_codErr;
END␀åø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
dPROCEDURE SP_SININC(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS
BEGIN
    p_retErr := 0;
END		SENIOR;20SP_STRTODATE
SP_CHR
€␀␀

/* Processa demanda de sicronismo - 13 = Geração de Incidente de Pessoa Não Grata (R090OCP e R090OPE) */
PROCEDURE SP_SININC(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

    l_codErr NUMBER(2);
    l_pos    NUMBER(3);
    l_codPor NUMBER(3);
    l_datOcp DATE;
    l_horOcp NUMBER(4);
    l_idtPNG VARCHAR2(23);
    l_tipOcp NUMBER(3);
    l_tam    NUMBER(3);
    l_obsOcp VARCHAR2(999);
    l_codUsu NUMBER(10);
    l_tipInc NUMBER(1);
    l_datStr VARCHAR2(16);
    l_datCon VARCHAR2(8);
    l_tipPes NUMBER(2);
    l_tipDoc NUMBER(1);
    l_numDoc VARCHAR2(20);
    l_codPlt NUMBER(5);
    l_seqOcp NUMBER(2);
    l_numAmb NUMBER(9);
    l_eccOcp VARCHAR2(1);
    l_verPlf NUMBER(3);
    l_codPlf NUMBER(7);
    l_seqEnv NUMBER(2);
    l_carRet CHAR;
    l_lineFd CHAR;
    l_repStr VARCHAR2(2);
BEGIN
    /* Inicializa variáveis */
    l_codErr := 0;
    p_retErr := 0;
    l_codUsu := 0;
    l_codPor := 0;
    l_codPlt := 0;
    l_datOcp := CURDATE();
    l_horOcp := 0;
    l_idtPNG := '';
    l_seqOcp := 0;
    l_numAmb := 0;
    l_tipOcp := 0;
    l_obsOcp := '';
    l_eccOcp := '';
    l_verPlf := 0;
    l_codPlf := 0;
    l_codUsu := 0;
    l_tipInc := 0;
    l_seqEnv := 1;
    
    /* Pego os caracteres carriage return e line feed */
    SP_CHR(13, l_carRet OUT);
    SP_CHR(10, l_lineFd OUT);
    l_repStr := l_carRet || l_lineFd;
    
    /* Separa os valores da string do p_valStr em cada variável */
	BEGIN
        l_pos := 3;
        l_codPor := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3)); l_pos := l_pos + 3;
        l_datStr := SUBSTRING(p_ValStr, l_pos, 16); l_pos := l_pos + 16;
        l_idtPNG := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_tipOcp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3)); l_pos := l_pos + 3;
        l_tam    := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3)); l_pos := l_pos + 3;
        IF (l_tam > 0) THEN
            l_obsOcp := REPLACE(SUBSTRING(p_ValStr, l_pos, l_tam), '|$', l_repStr); l_pos := l_pos + l_tam;
        END IF;
        l_codUsu := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 10)); l_pos := l_pos + 10;
        l_tipInc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));

        /* Converte data/hora do incidente */
        l_datCon := SUBSTRING(l_datStr, 1, 2) || '/' || SUBSTRING(l_datStr, 3, 2) || '/' || SUBSTRING(l_datStr, 5, 2);
        SP_STRTODATE(l_datCon, 'DD/MM/AA', l_datOcp OUT);
        l_horOcp := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datStr, 7, 2))) * 60 + CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datStr, 9, 2)));
	    
        /* Quebra o IDTPES, para pegar a pessoa não grata */
        l_idtPNG := LTRIM(RTRIM(l_idtPNG));
        l_tipPes := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtPNG, 1, 2));
        IF (l_tippes = 4) THEN
            l_tipDoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtPNG, 3, 1));
            l_numDoc := SUBSTRING(l_idtPNG, 4, 20);
        ELSE
            l_coderr := 53; /* erro de conversão na string */
        END IF;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 53; /* erro de conversão na string */
    END;
    
    /* Busca informações da portaria */
    BEGIN
        SELECT CODPLT, VERPLF, CODPLF INTO l_codPlt, l_verPlf, l_codPlf FROM R058POR WHERE CODPOR = l_codPor;
    EXCEPTION
        WHEN OTHERS THEN
            l_coderr := 53; /* erro de conversão na string */
    END;
    
    /* Busca a sequência do registro, procurando pela chave da tabela R090OCP */
    BEGIN
        SELECT IFNULL(MAX(SEQOCP), 0) INTO l_seqOcp FROM R090OCP WHERE CODPLT = l_codPlt AND DATOCP = l_datOcp AND HOROCP = l_horOcp;
    EXCEPTION
        WHEN OTHERS THEN
            l_seqOcp := 0;
    END;    
    l_seqOcp := l_seqOcp + 1;
    
    /* Insere a ocorrência do incidente */
    IF  (l_coderr = 0) THEN
        BEGIN
            INSERT INTO R090OCP (CODPLT, DATOCP, HOROCP, SEQOCP, NUMAMB, TIPOCP, OBSOCP, ECCOCP, VERPLF, CODPLF, CODUSU, INCENV)
                VALUES (l_codPlt, l_datOcp, l_horOcp, l_seqOcp, l_numAmb, l_tipOcp, l_obsOcp, l_eccOcp, l_verPlf, l_codPlf, l_codUsu, l_tipInc);
        EXCEPTION
            WHEN OTHERS THEN l_coderr := 54; /* erro ao incluir a ocorrência do incidente */
        END;
    END IF;

    /* Insere a pessoa não grata ligada à ocorrência do incidente */
    IF  (l_coderr = 0) THEN
        BEGIN
            INSERT INTO R090OPE (CODPLT, DATOCP, HOROCP, SEQOCP, SEQENV, TIPDOC, NUMDOC)
                VALUES (l_codPlt, l_datOcp, l_horOcp, l_seqOcp, l_seqEnv, l_tipDoc, l_numDoc);
        EXCEPTION
            WHEN OTHERS THEN l_coderr := 55; /* erro ao incluir a pessoa não grata da ocorrência do incidente */
        END;
    END IF;

    /* Retorna Código do erro */
    p_retErr := l_codErr;
END		SENIOR;21SP_STRTODATE
SP_CHR
€␀␀

/* Processa demanda de sicronismo - 13 = Geração de Incidente de Pessoa Não Grata (R090OCP e R090OPE) */
PROCEDURE SP_SININC(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

    l_codErr NUMBER(2);
    l_pos    NUMBER(3);
    l_codPor NUMBER(3);
    l_datOcp DATE;
    l_horOcp NUMBER(4);
    l_idtPNG VARCHAR2(23);
    l_tipOcp NUMBER(3);
    l_tam    NUMBER(3);
    l_obsOcp VARCHAR2(999);
    l_codUsu NUMBER(10);
    l_tipInc NUMBER(1);
    l_datStr VARCHAR2(16);
    l_datCon VARCHAR2(8);
    l_tipPes NUMBER(2);
    l_tipDoc NUMBER(1);
    l_numDoc VARCHAR2(20);
    l_codPlt NUMBER(5);
    l_seqOcp NUMBER(2);
    l_numAmb NUMBER(9);
    l_eccOcp VARCHAR2(1);
    l_verPlf NUMBER(3);
    l_codPlf NUMBER(7);
    l_seqEnv NUMBER(2);
    l_carRet CHAR;
    l_lineFd CHAR;
    l_repStr VARCHAR2(2);
BEGIN
    /* Inicializa variáveis */
    l_codErr := 0;
    p_retErr := 0;
    l_codUsu := 0;
    l_codPor := 0;
    l_codPlt := 0;
    l_datOcp := CURDATE();
    l_horOcp := 0;
    l_idtPNG := '';
    l_seqOcp := 0;
    l_numAmb := 0;
    l_tipOcp := 0;
    l_obsOcp := '';
    l_eccOcp := '';
    l_verPlf := 0;
    l_codPlf := 0;
    l_codUsu := 0;
    l_tipInc := 0;
    l_seqEnv := 1;
    
    /* Pego os caracteres carriage return e line feed */
    SP_CHR(13, l_carRet OUT);
    SP_CHR(10, l_lineFd OUT);
    l_repStr := l_carRet || l_lineFd;
    
    /* Separa os valores da string do p_valStr em cada variável */
	BEGIN
        l_pos := 3;
        l_codPor := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3)); l_pos := l_pos + 3;
        l_datStr := SUBSTRING(p_ValStr, l_pos, 16); l_pos := l_pos + 16;
        l_idtPNG := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_tipOcp := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3)); l_pos := l_pos + 3;
        l_tam    := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 3)); l_pos := l_pos + 3;
        IF (l_tam > 0) THEN
            l_obsOcp := REPLACE(SUBSTRING(p_ValStr, l_pos, l_tam), '|$', l_repStr); l_pos := l_pos + l_tam;
        END IF;
        l_codUsu := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 10)); l_pos := l_pos + 10;
        l_tipInc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(p_ValStr, l_pos, 2));

        /* Converte data/hora do incidente */
        l_datCon := SUBSTRING(l_datStr, 1, 2) || '/' || SUBSTRING(l_datStr, 3, 2) || '/' || SUBSTRING(l_datStr, 5, 2);
        SP_STRTODATE(l_datCon, 'DD/MM/AA', l_datOcp OUT);
        l_horOcp := CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datStr, 7, 2))) * 60 + CONVERT(CHAR_TO_NUMBER, (SUBSTRING(l_datStr, 9, 2)));
	    
        /* Quebra o IDTPES, para pegar a pessoa não grata */
        l_idtPNG := LTRIM(RTRIM(l_idtPNG));
        l_tipPes := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtPNG, 1, 2));
        IF (l_tippes = 4) THEN
            l_tipDoc := CONVERT(CHAR_TO_NUMBER, SUBSTRING(l_idtPNG, 3, 1));
            l_numDoc := SUBSTRING(l_idtPNG, 4, 20);
        ELSE
            l_coderr := 53; /* erro de conversão na string */
        END IF;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 53; /* erro de conversão na string */
    END;
    
    /* Busca informações da portaria */
    BEGIN
        SELECT CODPLT, VERPLF, CODPLF INTO l_codPlt, l_verPlf, l_codPlf FROM R058POR WHERE CODPOR = l_codPor;
    EXCEPTION
        WHEN OTHERS THEN
            l_coderr := 53; /* erro de conversão na string */
    END;
    
    /* Busca a sequência do registro, procurando pela chave da tabela R090OCP */
    BEGIN
        SELECT IFNULL(MAX(SEQOCP), 0) INTO l_seqOcp FROM R090OCP WHERE CODPLT = l_codPlt AND DATOCP = l_datOcp AND HOROCP = l_horOcp;
    EXCEPTION
        WHEN OTHERS THEN
            l_seqOcp := 0;
    END;    
    l_seqOcp := l_seqOcp + 1;
    
    /* Insere a ocorrência do incidente */
    IF  (l_coderr = 0) THEN
        BEGIN
            INSERT INTO R090OCP (CODPLT, DATOCP, HOROCP, SEQOCP, NUMAMB, TIPOCP, OBSOCP, ECCOCP, VERPLF, CODPLF, CODUSU, INCENV)
                VALUES (l_codPlt, l_datOcp, l_horOcp, l_seqOcp, l_numAmb, l_tipOcp, l_obsOcp, l_eccOcp, l_verPlf, l_codPlf, l_codUsu, l_tipInc);
        EXCEPTION
            WHEN OTHERS THEN l_coderr := 54; /* erro ao incluir a ocorrência do incidente */
        END;
    END IF;

    /* Insere a pessoa não grata ligada à ocorrência do incidente */
    IF  (l_coderr = 0) THEN
        BEGIN
            INSERT INTO R090OPE (CODPLT, DATOCP, HOROCP, SEQOCP, SEQENV, TIPDOC, NUMDOC)
                VALUES (l_codPlt, l_datOcp, l_horOcp, l_seqOcp, l_seqEnv, l_tipDoc, l_numDoc);
        EXCEPTION
            WHEN OTHERS THEN l_coderr := 55; /* erro ao incluir a pessoa não grata da ocorrência do incidente */
        END;
    END IF;

    /* Retorna Código do erro */
    p_retErr := l_codErr;
END		SENIOR;22SP_STRTODATE
SP_CHR
