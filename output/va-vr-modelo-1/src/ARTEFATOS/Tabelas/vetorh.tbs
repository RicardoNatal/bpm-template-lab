            WHEN OTHERS THEN RAISERROR 103 'R038HPO_EI: Erro ao inserir na tabela R070PEC.';
        END;
    END LOOP;
	
	/* se for posto de trabalho adicional */
	IF (l_oriDef = 2) THEN
	    BEGIN
	        SELECT CODPRM INTO l_codprm FROM R017DAC WHERE ESTPOS = :NEW.ESTPOS AND POSTRA = :NEW.POSTRA;
		EXCEPTION 
		    WHEN NO_DATA_FOUND THEN l_codprm := 0;
		END;
		
		IF (l_codprm <> 0) THEN
	   	    BEGIN
		        SELECT CODPRM INTO l_codprmAux FROM R070PEC WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD AND CODPRM = l_codprm AND DATINI < l_data_atual AND (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual)) AND ORIDEF = 2;
		    EXCEPTION 
    		    WHEN NO_DATA_FOUND THEN l_codprmAux := 0;
	    	END;
		    IF (l_codprmAux = 0) THEN
		        SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_codprm, l_oriDef);
		        INSERT INTO R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM,  ORIDEF)
                             VALUES ( :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, 0,  l_codprm, :NEW.TERATU, 1439,  :NEW.CODUSU, l_r017PEP.OBSPRM,  l_oriDef);
		    END IF;
	    END IF;
	END IF;
	
	/* Inclui definições de acesso e permissões por local físico/dispositivo pela trigger, pois o processo automático
	 * somente irá tratar o STAHIS quando passa de 0 (futuro) para 1 (presente) ou de 1 (presente) para 2 (passado). */
    IF  (:NEW.STAHIS = 1) THEN /* o histórico já é presente */
        SP_GesPer('I', :NEW.ESTPOS, :NEW.POSTRA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, l_oriDef);
	END IF;
	
  /* Início eSocial */
  IF (:NEW.FUNESO = 'S') THEN
    RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT); 
    IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
	  SP_TAB_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, 'R038HPO', 'I', '', '', 0, 'R038HPO_EI');
	  l_DataFimHistorico := :NEW.TERATU;
	  SP_INITEMPTY_DAT(l_DataFimHistorico IN OUT);
	  IF (l_DataZero <> l_DataFimHistorico) THEN
	    SP_HIST_DT_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DataFimHistorico, 'R038HPO', 'INIATU', 'I', '', '', ' AND FUNESO = ''S''', 0, 'R038HPO_EI');	    
	  END IF;	
    END IF;
  END IF;
  /* Fim eSocial */
  
  /* Início S-2240 */
  l_DataMax := DATETIME(04, 06, 2080, 0, 0, 0);
  
  l_IniHis := :NEW.IniAtu;
  l_TerHis := :NEW.TerAtu;
  
  RH_RET_DATINISST(:NEW.NumEmp, l_DatIniSST OUT);
  IF (l_DatIniSST > l_DataZero) THEN
  	IF (l_TerHis > l_DatIniSST OR l_TerHis = l_DataZero) THEN
  	  IF (l_IniHis < l_DatIniSST) THEN
  	    l_IniHis := l_DatIniSST;
  	  END IF;
  	
      SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'I', l_IniHis, l_TerHis, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_IniHis, 0, 'R038HPO_EI');
 
      IF (l_TerHis > l_DataZero) AND (l_TerHis < l_DataMax) THEN
        l_DatAux := DATETIMEADD(DD, 1, l_TerHis);
        SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'I', l_DatAux, l_DatAux, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DatAux, 0, 'R038HPO_EI');
      END IF;
    END IF;
  END IF;
  /* Fim S-2240 */
  
  RH_ALTHIEPOS();  
END		SENIOR;24Ú␀␀TRIGGER R038HPO_EI AFTER INSERT ON R038HPO FOR EACH ROW
DECLARE
	l_isInformix BOOLEAN;
	l_layoutAlteracaoContrato VARCHAR2(6); 
	l_DataZero DATE;
	l_DataFimHistorico DATE;
	l_DatIniSST DATE;
	l_IniHis DATE;
	l_TerHis DATE;
	l_DatAux DATE;
	l_DataMax DATE;
	
	/* ACESSO */
	l_Valor VARCHAR2(2000);
	l_TemPermissaoPorPosto BOOLEAN;
	l_estPos   R038HPO.EstPos%TYPE;
	l_posTra   R038HPO.PosTra%TYPE;
	l_data_zero   DATE;
	l_data_atual  DATE;
	l_hora_atual  NUMBER(4);
	l_oriDef NUMBER(1);
	l_hisPri VARCHAR2(1);
	l_codprm NUMBER(5); 
	l_codprmAux NUMBER(5);
	
	CURSOR c_r017PEP IS
       SELECT CODPRM, CODUSU, OBSPRM
         FROM R017PEP
        WHERE R017PEP.ESTPOS = l_estPos AND
              R017PEP.POSTRA = l_posTra;

    TYPE t_r017PEP IS RECORD(
       CODPRM   R017PEP.CODPRM%TYPE,
       CODUSU   R017PEP.CODUSU%TYPE,
       OBSPRM   R017PEP.OBSPRM%TYPE);
    l_r017PEP t_r017PEP;
    
BEGIN
    /*Inicializações*/  
    l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);

    l_estPos := :NEW.ESTPOS;
	l_posTra := :NEW.POSTRA;
	l_data_atual := CURDATE();
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
	l_data_zero  := '31/12/1900,00:00:00';
	l_oriDef := 2;

    RH_ISINFORMIX(l_isInformix OUT);
    /* No informix, a trigger não pode atualizar o próprio registro */
    IF (l_isInformix = FALSE) THEN
        BEGIN
        /* Insere Registro New */
            INSERT INTO R038HPO_AUX (NUMEMP, TIPCOL, NUMCAD, INIATU, SEQHIS, CODTAP, MOTALT, ESTPOS, POSTRA, TERATU)
                       VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.SEQHIS, :NEW.CODTAP,
                               :NEW.MOTALT, :NEW.ESTPOS, :NEW.POSTRA, :NEW.TERATU);
        EXCEPTION 
            WHEN OTHERS THEN RAISERROR 103 'Erro ao inserir registro na tabela R038HPO_AUX.';
        END;
    END IF;
	
	/* ACESSO */
	BEGIN
        SELECT HISPRI INTO l_hisPri FROM R017TAP WHERE R017TAP.CODTAP = :NEW.CODTAP;
	EXCEPTION 
	    WHEN OTHERS THEN RAISERROR 103 'R038HPO_EI: Erro ao fazer a seleção na tabela R017TAP.';
    END;
	
	IF (l_hisPri = 'S') THEN
	    l_oriDef := 1;
	END IF;
	
	FOREACH c_r017PEP INTO l_r017PEP.CODPRM,
                           l_r017PEP.CODUSU,
                           l_r017PEP.OBSPRM
    LOOP
	    BEGIN
	        SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_r017PEP.CODPRM, l_oriDef);
            INSERT INTO R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM, ORIDEF)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, 0,  l_r017PEP.CODPRM, :NEW.TERATU, 1439,  :NEW.CODUSU, l_r017PEP.OBSPRM,  l_oriDef);
        EXCEPTION 
            WHEN OTHERS THEN RAISERROR 103 'R038HPO_EI: Erro ao inserir na tabela R070PEC.';
        END;
    END LOOP;
	
	/* se for posto de trabalho adicional */
	IF (l_oriDef = 2) THEN
	    BEGIN
	        SELECT CODPRM INTO l_codprm FROM R017DAC WHERE ESTPOS = :NEW.ESTPOS AND POSTRA = :NEW.POSTRA;
		EXCEPTION 
		    WHEN NO_DATA_FOUND THEN l_codprm := 0;
		END;
		
		IF (l_codprm <> 0) THEN
	   	    BEGIN
		        SELECT CODPRM INTO l_codprmAux FROM R070PEC WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD AND CODPRM = l_codprm AND DATINI < l_data_atual AND (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual)) AND ORIDEF = 2;
		    EXCEPTION 
    		    WHEN NO_DATA_FOUND THEN l_codprmAux := 0;
	    	END;
		    IF (l_codprmAux = 0) THEN
		        SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_codprm, l_oriDef);
		        INSERT INTO R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM,  ORIDEF)
                             VALUES ( :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, 0,  l_codprm, :NEW.TERATU, 1439,  :NEW.CODUSU, l_r017PEP.OBSPRM,  l_oriDef);
		    END IF;
	    END IF;
	END IF;
	
	/* Inclui definições de acesso e permissões por local físico/dispositivo pela trigger, pois o processo automático
	 * somente irá tratar o STAHIS quando passa de 0 (futuro) para 1 (presente) ou de 1 (presente) para 2 (passado). */
    IF  (:NEW.STAHIS = 1) THEN /* o histórico já é presente */
        SP_GesPer('I', :NEW.ESTPOS, :NEW.POSTRA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, l_oriDef);
	END IF;
	
  /* Início eSocial */
  IF (:NEW.FUNESO = 'S') THEN
    RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT); 
    IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
	  SP_TAB_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, 'R038HPO', 'I', '', '', 0, 'R038HPO_EI');
	  l_DataFimHistorico := :NEW.TERATU;
	  SP_INITEMPTY_DAT(l_DataFimHistorico IN OUT);
	  IF (l_DataZero <> l_DataFimHistorico) THEN
	    SP_HIST_DT_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DataFimHistorico, 'R038HPO', 'INIATU', 'I', '', '', ' AND FUNESO = ''S''', 0, 'R038HPO_EI');	    
	  END IF;	
    END IF;
  END IF;
  /* Fim eSocial */
  
  /* Início S-2240 */
  l_DataMax := DATETIME(04, 06, 2080, 0, 0, 0);
  
  l_IniHis := :NEW.IniAtu;
  l_TerHis := :NEW.TerAtu;
  
  RH_RET_DATINISST(:NEW.NumEmp, l_DatIniSST OUT);
  IF (l_DatIniSST > l_DataZero) THEN
  	IF (l_TerHis > l_DatIniSST OR l_TerHis = l_DataZero) THEN
  	  IF (l_IniHis < l_DatIniSST) THEN
  	    l_IniHis := l_DatIniSST;
  	  END IF;
  	
      SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'I', l_IniHis, l_TerHis, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_IniHis, 0, 'R038HPO_EI');
 
      IF (l_TerHis > l_DataZero) AND (l_TerHis < l_DataMax) THEN
        l_DatAux := DATETIMEADD(DD, 1, l_TerHis);
        SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'I', l_DatAux, l_DatAux, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DatAux, 0, 'R038HPO_EI');
      END IF;
    END IF;
  END IF;
  /* Fim S-2240 */
  
  RH_ALTHIEPOS();  
END␀Õ␀␀	SENIOR;0 	␀␀

TRIGGER R038HPO_SU AFTER UPDATE ON R038HPO

DECLARE
/* Não foi feito tratamento ultilizando tabela _AUX pois a trigger de inserção faz uso da tabela _AUX e dispara a trigger de UPDATE */
  /* CURSOR c/ os registros gravados na tabela R038HPO */
  CURSOR c_r038hpo_AUXu IS SELECT NUMEMP, TIPCOL, NUMCAD, INIATU, SEQHIS, R038HPO.CODTAP, MOTALT, ESTPOS, POSTRA, TERATU
                                FROM R038HPO, R017TAP 
						       WHERE R038HPO.CODTAP = R017TAP.CODTAP AND R017TAP.HISPRI <> 'S' AND
  							         ((R038HPO.TERATU = DATETIME(31,12,1900,0,0,0)) OR (R038HPO.TERATU IS NULL));  
                           
  TYPE t_r038hpo_aux IS RECORD(
    NUMEMP   R038HPO_AUX.NUMEMP%TYPE, 
    TIPCOL   R038HPO_AUX.TIPCOL%TYPE,
    NUMCAD   R038HPO_AUX.NUMCAD%TYPE,
    INIATU   R038HPO_AUX.INIATU%TYPE,
    SEQHIS   R038HPO_AUX.SEQHIS%TYPE,
    CODTAP   R038HPO_AUX.CODTAP%TYPE,
    MOTALT   R038HPO_AUX.MOTALT%TYPE,
    ESTPOS   R038HPO_AUX.ESTPOS%TYPE,
    POSTRA   R038HPO_AUX.POSTRA%TYPE,
    TERATU   R038HPO_AUX.TERATU%TYPE);

  l_r038hpo_aux t_r038hpo_aux;
  l_datTer DATE;
  l_isInformix BOOLEAN;
BEGIN
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN
    /* Le Registro do CURSOR */
    FOREACH c_r038hpo_AUXu INTO l_r038hpo_aux.NUMEMP,
                                l_r038hpo_aux.TIPCOL,
                                l_r038hpo_aux.NUMCAD,
                                l_r038hpo_aux.INIATU,
                                l_r038hpo_aux.SEQHIS,
                                l_r038hpo_aux.CODTAP,
                                l_r038hpo_aux.MOTALT,
                                l_r038hpo_aux.ESTPOS,
                                l_r038hpo_aux.POSTRA,
                                l_r038hpo_aux.TERATU
    LOOP
      l_datTer :=DATETIME(04, 06, 2080, 0, 0, 0);
      BEGIN
        UPDATE R038HPO
           SET TERATU = l_datTer
         WHERE NUMEMP = l_r038hpo_aux.NUMEMP
           AND TIPCOL = l_r038hpo_aux.TIPCOL
           AND NUMCAD = l_r038hpo_aux.NUMCAD
           AND INIATU = l_r038hpo_aux.INIATU
           AND SEQHIS = l_r038hpo_aux.SEQHIS;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 ' Erro ao atualizar data de término do histórico de posto não titular.';
      END;
    END LOOP;
  END IF;
END␀Õ␀␀		SENIOR;0[%␀␀

TRIGGER R038HPO_EU AFTER UPDATE ON R038HPO FOR EACH ROW

DECLARE
  l_datpos     DATE;
  l_hisPriAux  CHAR(1);
  l_isInformix BOOLEAN;
  l_xUtiPosOri CHAR;
  l_xEstPosOri NUMBER(3);
  l_xCodPlvOri NUMBER(4);
  l_xUtiPosDes CHAR;
  l_xEstPosDes NUMBER(3);
  l_xCodPlvDes NUMBER(4);
  l_xPosOriAut CHAR;
  l_xPosDesAut CHAR;
  l_xIndCon CHAR;
  
  l_Alterou BOOLEAN;
  l_Valido  BOOLEAN;
  l_AlterouSomenteDataFim BOOLEAN;
  l_HistoriaPrincipal CHAR;
  l_layoutAlteracaoContrato VARCHAR(6);
  l_JsonCamposAlterados VARCHAR2(2000);
  l_JsonCamposAlterados2240 VARCHAR2(2000);
  
  l_DataZero DATE;
  l_DataMax DATE;
  l_DatIniSST DATE;
  l_AlterouDataTermino BOOLEAN;
  l_AlterouPosto BOOLEAN;
  l_DataInicio DATE;
  l_DataTermino DATE;
  l_DataAux DATE;
BEGIN

  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  l_DataMax := DATETIME(04, 06, 2080, 0, 0, 0);
  
  RH_ISINFORMIX(l_isInformix OUT);
  /* No informix, a trigger não pode atualizar o próprio registro */
  IF (l_isInformix = FALSE) THEN
    BEGIN
      BEGIN
        SELECT HISPRI
          INTO l_hisPriAux
          FROM R017TAP
         WHERE R017TAP.CODTAP = :NEW.CODTAP;
      EXCEPTION WHEN OTHERS THEN
        NULL;
      END;

      IF (l_hisPriAux = 'S') THEN
        IF (:NEW.STAHIS = 1) THEN
          BEGIN
            SELECT R034FUN.DATPOS INTO l_datpos
              FROM R034FUN
             WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                   R034FUN.NUMEMP = :NEW.NUMEMP AND
                   R034FUN.NUMCAD = :NEW.NUMCAD;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              RAISERROR 103 'Erro ao carregar dados do colaborador.';
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao carregar dados do colaborador.';
          END;

          IF ((:NEW.INIATU >= l_datpos) OR (l_datpos IS NULL)) THEN
            BEGIN
              UPDATE R034FUN
                 SET ESTPOS = :NEW.ESTPOS,
                     POSTRA = :NEW.POSTRA,
                     CODTAP = :NEW.CODTAP,
                     DATPOS = :NEW.INIATU
               WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                     R034FUN.NUMEMP = :NEW.NUMEMP AND
                     R034FUN.NUMCAD = :NEW.NUMCAD;
            EXCEPTION
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao atualizar dados do colaborador quando o histórico do posto é alterado.';
            END;
          END IF;
        END IF;
      END IF;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar R034FUN campos dos posto de trabalho.';
    END;
	
    IF ((:OLD.NUMEMP <> :NEW.NUMEMP) OR (:OLD.POSTRA <> :NEW.POSTRA)) THEN
      /* Caso trabalho com postos de trabalho atualizamos o efetivo por posto do registro origem e destino */
      QL_UTIPOSTRA(:OLD.NUMEMP, :OLD.INIATU, l_xUtiPosOri OUT, l_xEstPosOri OUT, l_xCodPlvOri OUT);
      QL_UTIPOSTRA(:NEW.NUMEMP, :NEW.INIATU, l_xUtiPosDes OUT, l_xEstPosDes OUT, l_xCodPlvDes OUT);
	  
	  /* Verifica se o colaborador está indicado no módulo QL. */
	  QL_VERMODQL(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_xIndCon OUT);
	  IF (l_xIndCon <> 'N') THEN
        QL_POSTOAUT(l_xEstPosOri, :OLD.POSTRA, :OLD.INIATU, :OLD.CODTAP, l_xPosOriAut OUT);
	  END IF;
      IF (l_xUtiPosOri = 'S') AND (l_xPosOriAut = 'S') THEN
        QL_ATUEFEPOS('U', 'R038HPO', :OLD.NUMEMP, l_xEstPosOri, l_xCodPlvOri, :OLD.POSTRA, -1, :OLD.INIATU, 'N', 'N', 'N');
        QL_AJUQTDEFE('R038HPO', l_xEstPosOri, l_xCodPlvOri, :OLD.POSTRA, :OLD.INIATU, :OLD.TERATU, -1);
      END IF;
	  
	  /* Verifica se o colaborador está indicado no módulo QL. */
      QL_VERMODQL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_xIndCon OUT);
	  IF (l_xIndCon <> 'N') THEN
        QL_POSTOAUT(l_xEstPosDes, :NEW.POSTRA, :NEW.INIATU, :NEW.CODTAP, l_xPosDesAut OUT);
	  END IF;	
      IF (l_xUtiPosDes = 'S') AND (l_xPosDesAut = 'S') THEN
        QL_ATUEFEPOS('U', 'R038HPO', :NEW.NUMEMP, l_xEstPosDes, l_xCodPlvDes, :NEW.POSTRA, 1, :NEW.INIATU, 'N', 'N', 'N');
        QL_AJUQTDEFE('R038HPO', l_xEstPosDes, l_xCodPlvDes, :NEW.POSTRA, :NEW.INIATU, :NEW.TERATU, 1);
      END IF;
    END IF;
  END IF;
  
	/* Início eSocial */
	IF ((:NEW.FUNESO = 'S') OR (:OLD.FUNESO = 'S')) THEN
		l_Alterou := FALSE;
		l_AlterouSomenteDataFim := FALSE;
		l_JsonCamposAlterados := '';
		l_JsonCamposAlterados2240 := '';

		SP_VALUPDATE_NUM(:OLD.ESTPOS, :NEW.ESTPOS, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('ESTPOS', :NEW.EstPos, :OLD.EstPos, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DES(:OLD.POSTRA, :NEW.POSTRA, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('POSTRA', :NEW.PosTra, :OLD.PosTra, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DES(:OLD.FUNESO, :NEW.FUNESO, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('FUNESO', :NEW.FunEso, :OLD.FunEso, l_JsonCamposAlterados OUT);
		END IF;
	
		SP_VALUPDATE_DAT(:OLD.TERATU, :NEW.TERATU, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			IF (l_Alterou = FALSE) THEN
				l_AlterouSomenteDataFim := TRUE;
			END IF;
			l_Alterou := TRUE;
			SP_CONCAT_DAT_JSON('TERATU', :NEW.TerAtu, :OLD.TerAtu, l_JsonCamposAlterados OUT);	
		END IF;	

		IF (l_AlterouSomenteDataFim = TRUE) THEN
			l_HistoriaPrincipal := ' ';
			SP_RETR017TAP(:NEW.CODTAP, l_HistoriaPrincipal OUT);
 			IF (l_HistoriaPrincipal = 'S') THEN
		 		l_Alterou := FALSE;
			END IF;
		END IF;

		IF (l_Alterou = TRUE) THEN 
			RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);
			IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
				SP_ALT_TAB_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, :OLD.TERATU, 'R038HPO', '', l_JsonCamposAlterados, l_AlterouSomenteDataFim, 'INIATU', ' AND FUNESO = ''S''', 0, 'R038HPO_EU');
			END IF;	
		END IF;
	END IF;
	/* Fim eSocial */
  
	/* Início S-2240 */
	RH_RET_DATINISST(:NEW.NumEmp, l_DatIniSST OUT);
	IF (l_DatIniSST > l_DataZero) THEN
		IF (:NEW.TerAtu > l_DatIniSST OR :NEW.TerAtu = l_DataZero OR :OLD.TerAtu > l_DatIniSST OR :OLD.TerAtu = l_DataZero) THEN  	  	
			l_AlterouPosto := FALSE;
			l_AlterouDataTermino := FALSE;			
	
			SP_VALUPDATE_NUM(:OLD.EstPos, :NEW.EstPos, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouPosto := TRUE;
				SP_CONCAT_NUM_JSON('ESTPOS', :NEW.EstPos, :OLD.EstPos, l_JsonCamposAlterados2240 OUT);
			END IF;
	
			SP_VALUPDATE_DES(:OLD.PosTra, :NEW.PosTra, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouPosto := TRUE;
				SP_CONCAT_DES_JSON('POSTRA', :NEW.PosTra, :OLD.PosTra, l_JsonCamposAlterados2240 OUT);
			END IF;
		
			SP_VALUPDATE_DAT(:OLD.TerAtu, :NEW.TerAtu, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouDataTermino := TRUE;
				SP_CONCAT_DAT_JSON('TERATU', :NEW.TerAtu, :OLD.TerAtu, l_JsonCamposAlterados2240 OUT);
			END IF;
			
			IF (l_AlterouPosto = TRUE) THEN
				l_DataInicio := :NEW.IniAtu;
				IF (l_DataInicio < l_DatIniSST) THEN
	  				l_DataInicio := l_DatIniSST;
	  			END IF;
	  			
	  			IF (:OLD.TerAtu < :NEW.TerAtu) THEN
	  				l_DataTermino := :OLD.TerAtu;
	  			ELSE
	  				l_DataTermino := :NEW.TerAtu;
	  			END IF;
	  			
				SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonCamposAlterados2240, 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
			END IF;
			
			IF (l_AlterouDataTermino = TRUE) THEN
				IF (:OLD.TerAtu > l_DataZero AND :NEW.TerAtu > l_DataZero) THEN
					IF (:NEW.TerAtu > :OLD.TerAtu) THEN
						l_DataInicio := DATETIMEADD(DD, 1, :OLD.TerAtu);
						l_DataTermino := :NEW.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonCamposAlterados2240, 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
						
						IF (:NEW.TerAtu < l_DataMax) THEN
							l_DataAux := DATETIMEADD(DD, 1, :NEW.TerAtu);
							SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataAux, l_DataAux, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonCamposAlterados2240, 0, NULL, l_DataAux, 0, 'R038HPO_EU');
						END IF;
					ELSE
						l_DataInicio := DATETIMEADD(DD, 1, :NEW.TerAtu);
						l_DataTermino := :OLD.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonCamposAlterados2240, 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
					END IF;
				ELSE
					IF (:OLD.TerAtu = l_DataZero AND :NEW.TerAtu > l_DataZero AND :NEW.TerAtu < l_DataMax) THEN
						l_DataInicio := DATETIMEADD(DD, 1, :NEW.TerAtu);
						l_DataTermino := :OLD.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonCamposAlterados2240, 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
					ELSE
						IF (:NEW.TerAtu = l_DataZero AND :OLD.TerAtu > l_DataZero  AND :OLD.TerAtu < l_DataMax) THEN
							l_DataInicio := DATETIMEADD(DD, 1, :OLD.TerAtu);
							l_DataTermino := :NEW.TerAtu;
							SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonCamposAlterados2240, 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
						END IF;
					END IF;
				END IF;
			END IF;
		END IF;
	END IF;
	/* Fim S-2240 */
	
	RH_ALTHIEPOS();
END		SENIOR;20r7␀␀

TRIGGER R038HPO_EU AFTER UPDATE ON R038HPO FOR EACH ROW
DECLARE
  l_datpos     DATE;
  l_hisPriAux  CHAR(1);
  l_isInformix BOOLEAN;
  l_xUtiPosOri CHAR;
  l_xEstPosOri NUMBER(3);
  l_xCodPlvOri NUMBER(4);
  l_xUtiPosDes CHAR;
  l_xEstPosDes NUMBER(3);
  l_xCodPlvDes NUMBER(4);
  l_xPosOriAut CHAR;
  l_xPosDesAut CHAR;
  l_xIndCon CHAR;
  
  l_Alterou BOOLEAN;
  l_Valido  BOOLEAN;
  l_AlterouSomenteDataFim BOOLEAN;
  l_HistoriaPrincipal CHAR;
  l_layoutAlteracaoContrato VARCHAR(6);
  l_JsonCamposAlterados VARCHAR2(2000);
  
  l_DataZero DATE;
  l_DataMax DATE;
  l_DatIniSST DATE;
  l_AlterouDataTermino BOOLEAN;
  l_AlterouPosto BOOLEAN;
  l_DataInicio DATE;
  l_DataTermino DATE;
  l_DataAux DATE;

  /* ACESSO */
  l_oriDef NUMBER(1);
  l_oldOriDef NUMBER(1);
  l_hisPri VARCHAR2(1);
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_codprm NUMBER(5);
  l_codprmAux NUMBER(5);
  l_estPos   R038HPO.EstPos%TYPE;
  l_posTra   R038HPO.PosTra%TYPE;
  l_data_zero DATE;
  
  CURSOR c_r017PEP IS
       SELECT CODPRM, CODUSU, OBSPRM
         FROM R017PEP
        WHERE R017PEP.ESTPOS = l_estPos AND
              R017PEP.POSTRA = l_posTra;

  TYPE t_r017PEP IS RECORD(
    CODPRM   R017PEP.CODPRM%TYPE,
    CODUSU   R017PEP.CODUSU%TYPE,
    OBSPRM   R017PEP.OBSPRM%TYPE);
  l_r017PEP t_r017PEP;
  

BEGIN
  /* Inicializações */
  l_DataZero := '31/12/1900,00:00:00';
  l_DataMax := '04/06/2080,00:00:00';
  l_oriDef := 2;
  l_oldOriDef := 2;
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';
  
  RH_ISINFORMIX(l_isInformix OUT);
  /* No informix, a trigger não pode atualizar o próprio registro */
  IF (l_isInformix = FALSE) THEN
    BEGIN
      BEGIN
        SELECT HISPRI
          INTO l_hisPriAux
          FROM R017TAP
         WHERE R017TAP.CODTAP = :NEW.CODTAP;
      EXCEPTION WHEN OTHERS THEN
        NULL;
      END;

      IF (l_hisPriAux = 'S') THEN
        IF (:NEW.STAHIS = 1) THEN
          BEGIN
            SELECT R034FUN.DATPOS INTO l_datpos
              FROM R034FUN
             WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                   R034FUN.NUMEMP = :NEW.NUMEMP AND
                   R034FUN.NUMCAD = :NEW.NUMCAD;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              RAISERROR 103 'Erro ao carregar dados do colaborador.';
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao carregar dados do colaborador.';
          END;

          IF ((:NEW.INIATU >= l_datpos) OR (l_datpos IS NULL)) THEN
            BEGIN
              UPDATE R034FUN
                 SET ESTPOS = :NEW.ESTPOS,
                     POSTRA = :NEW.POSTRA,
                     CODTAP = :NEW.CODTAP,
                     DATPOS = :NEW.INIATU
               WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                     R034FUN.NUMEMP = :NEW.NUMEMP AND
                     R034FUN.NUMCAD = :NEW.NUMCAD;
            EXCEPTION
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao atualizar dados do colaborador quando o histórico do posto é alterado.';
            END;
          END IF;
        END IF;
      END IF;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar R034FUN campos dos posto de trabalho.';
    END;

    /* ACESSO */	
	BEGIN
	    SELECT HISPRI INTO l_hisPri FROM R017TAP WHERE R017TAP.CODTAP = :NEW.CODTAP;
	EXCEPTION 
	    WHEN OTHERS THEN RAISERROR 103 'R038HPO_EU: Erro ao fazer a seleção na tabela R017TAP.';
    END;
	
	IF (l_hisPri = 'S') THEN
	    l_oriDef := 1;
	END IF;
	
	l_hispri := 'N';
	BEGIN
	    SELECT HISPRI INTO l_hisPri FROM R017TAP WHERE R017TAP.CODTAP = :OLD.CODTAP;
	EXCEPTION 
	    WHEN OTHERS THEN RAISERROR 103 'R038HPO_EU: Erro ao fazer a seleção na tabela R017TAP. 2';
    END;
	
	IF (l_hisPri = 'S') THEN
	    l_oldOriDef := 1;
	END IF;
	
    IF ((:OLD.NUMEMP <> :NEW.NUMEMP) OR (:OLD.POSTRA <> :NEW.POSTRA)) THEN
      /* Caso trabalho com postos de trabalho atualizamos o efetivo por posto do registro origem e destino */
      QL_UTIPOSTRA(:OLD.NUMEMP, :OLD.INIATU, l_xUtiPosOri OUT, l_xEstPosOri OUT, l_xCodPlvOri OUT);
      QL_UTIPOSTRA(:NEW.NUMEMP, :NEW.INIATU, l_xUtiPosDes OUT, l_xEstPosDes OUT, l_xCodPlvDes OUT);
	  
	  /* Verifica se o colaborador está indicado no módulo QL. */
	  QL_VERMODQL(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_xIndCon OUT);
	  IF (l_xIndCon <> 'N') THEN
        QL_POSTOAUT(l_xEstPosOri, :OLD.POSTRA, :OLD.INIATU, :OLD.CODTAP, l_xPosOriAut OUT);
	  END IF;
      IF (l_xUtiPosOri = 'S') AND (l_xPosOriAut = 'S') THEN
        QL_ATUEFEPOS('U', 'R038HPO', :OLD.NUMEMP, l_xEstPosOri, l_xCodPlvOri, :OLD.POSTRA, -1, :OLD.INIATU, 'N', 'N', 'N');
        QL_AJUQTDEFE('R038HPO', l_xEstPosOri, l_xCodPlvOri, :OLD.POSTRA, :OLD.INIATU, :OLD.TERATU, -1);
      END IF;
	  
	  /* Verifica se o colaborador está indicado no módulo QL. */
      QL_VERMODQL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_xIndCon OUT);
	  IF (l_xIndCon <> 'N') THEN
        QL_POSTOAUT(l_xEstPosDes, :NEW.POSTRA, :NEW.INIATU, :NEW.CODTAP, l_xPosDesAut OUT);
	  END IF;	
      IF (l_xUtiPosDes = 'S') AND (l_xPosDesAut = 'S') THEN
        QL_ATUEFEPOS('U', 'R038HPO', :NEW.NUMEMP, l_xEstPosDes, l_xCodPlvDes, :NEW.POSTRA, 1, :NEW.INIATU, 'N', 'N', 'N');
        QL_AJUQTDEFE('R038HPO', l_xEstPosDes, l_xCodPlvDes, :NEW.POSTRA, :NEW.INIATU, :NEW.TERATU, 1);
      END IF;
    END IF;	
  END IF;
	
	FOREACH c_r017PEP INTO l_r017PEP.CODPRM,
                           l_r017PEP.CODUSU,
                           l_r017PEP.OBSPRM							 
    LOOP
	    BEGIN
	        IF ((:OLD.ESTPOS <> :NEW.ESTPOS) OR (:OLD.POSTRA <> :NEW.POSTRA)) THEN
			    UPDATE R070PEC SET DATFIM = l_data_atual, HORFIM = l_hora_atual, CODUSU = :NEW.CODUSU WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATINI = :OLD.INIATU AND ORIDEF = l_oldOriDef;
				SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_r017PEP.CODPRM, l_oriDef);
                INSERT INTO R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM, ORIDEF)
                             VALUES ( :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, 0,  l_r017PEP.CODPRM, :NEW.TERATU, 1439,  :NEW.CODUSU, l_r017PEP.OBSPRM,  l_oriDef);
			END IF;
				
			IF (:OLD.OBSHPO <> :NEW.OBSHPO) THEN
			    UPDATE R070PEC SET OBSPRM = :NEW.OBSHPO, CODUSU = :NEW.CODUSU WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATINI = :OLD.INIATU AND ORIDEF = l_oldOriDef;
			END IF;
        EXCEPTION 
            WHEN OTHERS THEN RAISERROR 103 'R038HPO_EI: Erro ao atualizar a tabela R017PEC.';
        END;
    END LOOP;
	
	IF (l_oriDef = 2) THEN
		BEGIN
	        SELECT CODPRM INTO l_codprm FROM R017DAC WHERE ESTPOS = :NEW.ESTPOS AND POSTRA = :NEW.POSTRA;
		EXCEPTION 
		    WHEN NO_DATA_FOUND THEN l_codprm := 0;
		END;
		IF (l_codprm <> 0) THEN
		    BEGIN
		        SELECT CODPRM INTO l_codprmAux FROM R070PEC WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD AND CODPRM = l_codprm AND DATINI < l_data_atual AND (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual)) AND ORIDEF = 2;
			EXCEPTION 
			    WHEN NO_DATA_FOUND THEN l_codprmAux := 0;
			END;
			IF (l_codprmAux = 0) THEN
			    SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_codprm, l_oriDef);
		        INSERT INTO R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM,  ORIDEF)
                             VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, 0,  l_codprm, :NEW.TERATU, 1439,  :NEW.CODUSU, l_r017PEP.OBSPRM,  l_oriDef);
			END IF;
		END IF;
	END IF;
	
	BEGIN
		INSERT INTO R038HPO_AUX (NUMEMP, TIPCOL, NUMCAD, INIATU, SEQHIS, CODTAP, MOTALT, ESTPOS, POSTRA, TERATU, CODUSU)
										 VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.SEQHIS, :NEW.CODTAP,
														 :NEW.MOTALT, :NEW.ESTPOS, :NEW.POSTRA, :NEW.TERATU, :NEW.CODUSU);
	EXCEPTION WHEN OTHERS THEN
		RAISERROR 103 'Erro ao inserir registro na tabela R038HPO_AUX.';
	END;
	
	/* Atualizar definicoes de acesso e permissoes por local fisico/dispositivo. Verifico o status do histórico. */
	/* Se tinha um histórico presente e ficou passado, devo retirar as definições de acesso e permissões por local físico/disp. */
	/* Se tinha um histórico futuro e ficou presente, devo incluir as definições de acesso e permissões por local físico/disp. */
    IF  (:NEW.STAHIS = 1) AND (:OLD.STAHIS = 0) THEN /* de futuro para presente */
        SP_GesPer('I', :NEW.ESTPOS, :NEW.POSTRA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, l_oriDef);
    END IF;
    IF  (:NEW.STAHIS = 2) AND (:OLD.STAHIS = 1) THEN /* de presente para passado */
        SP_GesPer('D', :NEW.ESTPOS, :NEW.POSTRA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, l_oriDef);
    END IF;
		
		BEGIN
			DELETE FROM R038HPO_AUX ;
		EXCEPTION WHEN OTHERS THEN
			RAISERROR 103 'Erro ao deletar registro na tabela R038HPO_AUX.';
		END;
  
	/* Início eSocial */
	IF ((:NEW.FUNESO = 'S') OR (:OLD.FUNESO = 'S')) THEN
		l_Alterou := FALSE;
		l_AlterouSomenteDataFim := FALSE;
		l_JsonCamposAlterados := '';

		SP_VALUPDATE_NUM(:OLD.ESTPOS, :NEW.ESTPOS, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('ESTPOS', :NEW.EstPos, :OLD.EstPos, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DES(:OLD.POSTRA, :NEW.POSTRA, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('POSTRA', :NEW.PosTra, :OLD.PosTra, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DES(:OLD.FUNESO, :NEW.FUNESO, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('FUNESO', :NEW.FunEso, :OLD.FunEso, l_JsonCamposAlterados OUT);
		END IF;
	
		SP_VALUPDATE_DAT(:OLD.TERATU, :NEW.TERATU, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			IF (l_Alterou = FALSE) THEN
				l_AlterouSomenteDataFim := TRUE;
			END IF;
			l_Alterou := TRUE;
			SP_CONCAT_DAT_JSON('TERATU', :NEW.TerAtu, :OLD.TerAtu, l_JsonCamposAlterados OUT);	
		END IF;	

		IF (l_AlterouSomenteDataFim = TRUE) THEN
			l_HistoriaPrincipal := ' ';
			SP_RETR017TAP(:NEW.CODTAP, l_HistoriaPrincipal OUT);
 			IF (l_HistoriaPrincipal = 'S') THEN
		 		l_Alterou := FALSE;
			END IF;
		END IF;

		IF (l_Alterou = TRUE) THEN 
			RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);
			IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
				SP_ALT_TAB_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, :OLD.TERATU, 'R038HPO', '', l_JsonCamposAlterados, l_AlterouSomenteDataFim, 'INIATU', ' AND FUNESO = ''S''', 0, 'R038HPO_EU');
			END IF;	
		END IF;
	END IF;
	/* Fim eSocial */
  
	/* Início S-2240 */
	RH_RET_DATINISST(:NEW.NumEmp, l_DatIniSST OUT);
	IF (l_DatIniSST > l_DataZero) THEN
		IF (:NEW.TerAtu > l_DatIniSST OR :NEW.TerAtu = l_DataZero OR :OLD.TerAtu > l_DatIniSST OR :OLD.TerAtu = l_DataZero) THEN  	  	
			l_AlterouPosto := FALSE;
			l_AlterouDataTermino := FALSE;
	
			SP_VALUPDATE_NUM(:OLD.EstPos, :NEW.EstPos, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouPosto := TRUE;
			END IF;
	
			SP_VALUPDATE_DES(:OLD.PosTra, :NEW.PosTra, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouPosto := TRUE;
			END IF;
		
			SP_VALUPDATE_DAT(:OLD.TerAtu, :NEW.TerAtu, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouDataTermino := TRUE;
			END IF;
			
			IF (l_AlterouPosto = TRUE) THEN
				l_DataInicio := :NEW.IniAtu;
				IF (l_DataInicio < l_DatIniSST) THEN
	  				l_DataInicio := l_DatIniSST;
	  			END IF;
	  			
	  			IF (:OLD.TerAtu < :NEW.TerAtu) THEN
	  				l_DataTermino := :OLD.TerAtu;
	  			ELSE
	  				l_DataTermino := :NEW.TerAtu;
	  			END IF;
	  			
				SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
			END IF;
			
			IF (l_AlterouDataTermino = TRUE) THEN
				IF (:OLD.TerAtu > l_DataZero AND :NEW.TerAtu > l_DataZero) THEN
					IF (:NEW.TerAtu > :OLD.TerAtu) THEN
						l_DataInicio := DATETIMEADD(DD, 1, :OLD.TerAtu);
						l_DataTermino := :NEW.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
						
						IF (:NEW.TerAtu < l_DataMax) THEN
							l_DataAux := DATETIMEADD(DD, 1, :NEW.TerAtu);
							SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataAux, l_DataAux, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataAux, 0, 'R038HPO_EU');
						END IF;
					ELSE
						l_DataInicio := DATETIMEADD(DD, 1, :NEW.TerAtu);
						l_DataTermino := :OLD.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
					END IF;
				ELSE
					IF (:OLD.TerAtu = l_DataZero AND :NEW.TerAtu > l_DataZero AND :NEW.TerAtu < l_DataMax) THEN
						l_DataInicio := DATETIMEADD(DD, 1, :NEW.TerAtu);
						l_DataTermino := :OLD.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
					ELSE
						IF (:NEW.TerAtu = l_DataZero AND :OLD.TerAtu > l_DataZero  AND :OLD.TerAtu < l_DataMax) THEN
							l_DataInicio := DATETIMEADD(DD, 1, :OLD.TerAtu);
							l_DataTermino := :NEW.TerAtu;
							SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
						END IF;
					END IF;
				END IF;
			END IF;
		END IF;
	END IF;
	/* Fim S-2240 */
	
	RH_ALTHIEPOS();
END		SENIOR;21r7␀␀

TRIGGER R038HPO_EU AFTER UPDATE ON R038HPO FOR EACH ROW
DECLARE
  l_datpos     DATE;
  l_hisPriAux  CHAR(1);
  l_isInformix BOOLEAN;
  l_xUtiPosOri CHAR;
  l_xEstPosOri NUMBER(3);
  l_xCodPlvOri NUMBER(4);
  l_xUtiPosDes CHAR;
  l_xEstPosDes NUMBER(3);
  l_xCodPlvDes NUMBER(4);
  l_xPosOriAut CHAR;
  l_xPosDesAut CHAR;
  l_xIndCon CHAR;
  
  l_Alterou BOOLEAN;
  l_Valido  BOOLEAN;
  l_AlterouSomenteDataFim BOOLEAN;
  l_HistoriaPrincipal CHAR;
  l_layoutAlteracaoContrato VARCHAR(6);
  l_JsonCamposAlterados VARCHAR2(2000);
  
  l_DataZero DATE;
  l_DataMax DATE;
  l_DatIniSST DATE;
  l_AlterouDataTermino BOOLEAN;
  l_AlterouPosto BOOLEAN;
  l_DataInicio DATE;
  l_DataTermino DATE;
  l_DataAux DATE;

  /* ACESSO */
  l_oriDef NUMBER(1);
  l_oldOriDef NUMBER(1);
  l_hisPri VARCHAR2(1);
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_codprm NUMBER(5);
  l_codprmAux NUMBER(5);
  l_estPos   R038HPO.EstPos%TYPE;
  l_posTra   R038HPO.PosTra%TYPE;
  l_data_zero DATE;
  
  CURSOR c_r017PEP IS
       SELECT CODPRM, CODUSU, OBSPRM
         FROM R017PEP
        WHERE R017PEP.ESTPOS = l_estPos AND
              R017PEP.POSTRA = l_posTra;

  TYPE t_r017PEP IS RECORD(
    CODPRM   R017PEP.CODPRM%TYPE,
    CODUSU   R017PEP.CODUSU%TYPE,
    OBSPRM   R017PEP.OBSPRM%TYPE);
  l_r017PEP t_r017PEP;
  

BEGIN
  /* Inicializações */
  l_DataZero := '31/12/1900,00:00:00';
  l_DataMax := '04/06/2080,00:00:00';
  l_oriDef := 2;
  l_oldOriDef := 2;
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';
  
  RH_ISINFORMIX(l_isInformix OUT);
  /* No informix, a trigger não pode atualizar o próprio registro */
  IF (l_isInformix = FALSE) THEN
    BEGIN
      BEGIN
        SELECT HISPRI
          INTO l_hisPriAux
          FROM R017TAP
         WHERE R017TAP.CODTAP = :NEW.CODTAP;
      EXCEPTION WHEN OTHERS THEN
        NULL;
      END;

      IF (l_hisPriAux = 'S') THEN
        IF (:NEW.STAHIS = 1) THEN
          BEGIN
            SELECT R034FUN.DATPOS INTO l_datpos
              FROM R034FUN
             WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                   R034FUN.NUMEMP = :NEW.NUMEMP AND
                   R034FUN.NUMCAD = :NEW.NUMCAD;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              RAISERROR 103 'Erro ao carregar dados do colaborador.';
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao carregar dados do colaborador.';
          END;

          IF ((:NEW.INIATU >= l_datpos) OR (l_datpos IS NULL)) THEN
            BEGIN
              UPDATE R034FUN
                 SET ESTPOS = :NEW.ESTPOS,
                     POSTRA = :NEW.POSTRA,
                     CODTAP = :NEW.CODTAP,
                     DATPOS = :NEW.INIATU
               WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                     R034FUN.NUMEMP = :NEW.NUMEMP AND
                     R034FUN.NUMCAD = :NEW.NUMCAD;
            EXCEPTION
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao atualizar dados do colaborador quando o histórico do posto é alterado.';
            END;
          END IF;
        END IF;
      END IF;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar R034FUN campos dos posto de trabalho.';
    END;

    /* ACESSO */	
	BEGIN
	    SELECT HISPRI INTO l_hisPri FROM R017TAP WHERE R017TAP.CODTAP = :NEW.CODTAP;
	EXCEPTION 
	    WHEN OTHERS THEN RAISERROR 103 'R038HPO_EU: Erro ao fazer a seleção na tabela R017TAP.';
    END;
	
	IF (l_hisPri = 'S') THEN
	    l_oriDef := 1;
	END IF;
	
	l_hispri := 'N';
	BEGIN
	    SELECT HISPRI INTO l_hisPri FROM R017TAP WHERE R017TAP.CODTAP = :OLD.CODTAP;
	EXCEPTION 
	    WHEN OTHERS THEN RAISERROR 103 'R038HPO_EU: Erro ao fazer a seleção na tabela R017TAP. 2';
    END;
	
	IF (l_hisPri = 'S') THEN
	    l_oldOriDef := 1;
	END IF;
	
    IF ((:OLD.NUMEMP <> :NEW.NUMEMP) OR (:OLD.POSTRA <> :NEW.POSTRA)) THEN
      /* Caso trabalho com postos de trabalho atualizamos o efetivo por posto do registro origem e destino */
      QL_UTIPOSTRA(:OLD.NUMEMP, :OLD.INIATU, l_xUtiPosOri OUT, l_xEstPosOri OUT, l_xCodPlvOri OUT);
      QL_UTIPOSTRA(:NEW.NUMEMP, :NEW.INIATU, l_xUtiPosDes OUT, l_xEstPosDes OUT, l_xCodPlvDes OUT);
	  
	  /* Verifica se o colaborador está indicado no módulo QL. */
	  QL_VERMODQL(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_xIndCon OUT);
	  IF (l_xIndCon <> 'N') THEN
        QL_POSTOAUT(l_xEstPosOri, :OLD.POSTRA, :OLD.INIATU, :OLD.CODTAP, l_xPosOriAut OUT);
	  END IF;
      IF (l_xUtiPosOri = 'S') AND (l_xPosOriAut = 'S') THEN
        QL_ATUEFEPOS('U', 'R038HPO', :OLD.NUMEMP, l_xEstPosOri, l_xCodPlvOri, :OLD.POSTRA, -1, :OLD.INIATU, 'N', 'N', 'N');
        QL_AJUQTDEFE('R038HPO', l_xEstPosOri, l_xCodPlvOri, :OLD.POSTRA, :OLD.INIATU, :OLD.TERATU, -1);
      END IF;
	  
	  /* Verifica se o colaborador está indicado no módulo QL. */
      QL_VERMODQL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_xIndCon OUT);
	  IF (l_xIndCon <> 'N') THEN
        QL_POSTOAUT(l_xEstPosDes, :NEW.POSTRA, :NEW.INIATU, :NEW.CODTAP, l_xPosDesAut OUT);
	  END IF;	
      IF (l_xUtiPosDes = 'S') AND (l_xPosDesAut = 'S') THEN
        QL_ATUEFEPOS('U', 'R038HPO', :NEW.NUMEMP, l_xEstPosDes, l_xCodPlvDes, :NEW.POSTRA, 1, :NEW.INIATU, 'N', 'N', 'N');
        QL_AJUQTDEFE('R038HPO', l_xEstPosDes, l_xCodPlvDes, :NEW.POSTRA, :NEW.INIATU, :NEW.TERATU, 1);
      END IF;
    END IF;	
  END IF;
	
	FOREACH c_r017PEP INTO l_r017PEP.CODPRM,
                           l_r017PEP.CODUSU,
                           l_r017PEP.OBSPRM							 
    LOOP
	    BEGIN
	        IF ((:OLD.ESTPOS <> :NEW.ESTPOS) OR (:OLD.POSTRA <> :NEW.POSTRA)) THEN
			    UPDATE R070PEC SET DATFIM = l_data_atual, HORFIM = l_hora_atual, CODUSU = :NEW.CODUSU WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATINI = :OLD.INIATU AND ORIDEF = l_oldOriDef;
				SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_r017PEP.CODPRM, l_oriDef);
                INSERT INTO R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM, ORIDEF)
                             VALUES ( :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, 0,  l_r017PEP.CODPRM, :NEW.TERATU, 1439,  :NEW.CODUSU, l_r017PEP.OBSPRM,  l_oriDef);
			END IF;
				
			IF (:OLD.OBSHPO <> :NEW.OBSHPO) THEN
			    UPDATE R070PEC SET OBSPRM = :NEW.OBSHPO, CODUSU = :NEW.CODUSU WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATINI = :OLD.INIATU AND ORIDEF = l_oldOriDef;
			END IF;
        EXCEPTION 
            WHEN OTHERS THEN RAISERROR 103 'R038HPO_EI: Erro ao atualizar a tabela R017PEC.';
        END;
    END LOOP;
	
	IF (l_oriDef = 2) THEN
		BEGIN
	        SELECT CODPRM INTO l_codprm FROM R017DAC WHERE ESTPOS = :NEW.ESTPOS AND POSTRA = :NEW.POSTRA;
		EXCEPTION 
		    WHEN NO_DATA_FOUND THEN l_codprm := 0;
		END;
		IF (l_codprm <> 0) THEN
		    BEGIN
		        SELECT CODPRM INTO l_codprmAux FROM R070PEC WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD AND CODPRM = l_codprm AND DATINI < l_data_atual AND (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual)) AND ORIDEF = 2;
			EXCEPTION 
			    WHEN NO_DATA_FOUND THEN l_codprmAux := 0;
			END;
			IF (l_codprmAux = 0) THEN
			    SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_codprm, l_oriDef);
		        INSERT INTO R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM,  ORIDEF)
                             VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, 0,  l_codprm, :NEW.TERATU, 1439,  :NEW.CODUSU, l_r017PEP.OBSPRM,  l_oriDef);
			END IF;
		END IF;
	END IF;
	
	BEGIN
		INSERT INTO R038HPO_AUX (NUMEMP, TIPCOL, NUMCAD, INIATU, SEQHIS, CODTAP, MOTALT, ESTPOS, POSTRA, TERATU, CODUSU)
										 VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.SEQHIS, :NEW.CODTAP,
														 :NEW.MOTALT, :NEW.ESTPOS, :NEW.POSTRA, :NEW.TERATU, :NEW.CODUSU);
	EXCEPTION WHEN OTHERS THEN
		RAISERROR 103 'Erro ao inserir registro na tabela R038HPO_AUX.';
	END;
	
	/* Atualizar definicoes de acesso e permissoes por local fisico/dispositivo. Verifico o status do histórico. */
	/* Se tinha um histórico presente e ficou passado, devo retirar as definições de acesso e permissões por local físico/disp. */
	/* Se tinha um histórico futuro e ficou presente, devo incluir as definições de acesso e permissões por local físico/disp. */
    IF  (:NEW.STAHIS = 1) AND (:OLD.STAHIS = 0) THEN /* de futuro para presente */
        SP_GesPer('I', :NEW.ESTPOS, :NEW.POSTRA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, l_oriDef);
    END IF;
    IF  (:NEW.STAHIS = 2) AND (:OLD.STAHIS = 1) THEN /* de presente para passado */
        SP_GesPer('D', :NEW.ESTPOS, :NEW.POSTRA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, l_oriDef);
    END IF;
		
		BEGIN
			DELETE FROM R038HPO_AUX ;
		EXCEPTION WHEN OTHERS THEN
			RAISERROR 103 'Erro ao deletar registro na tabela R038HPO_AUX.';
		END;
  
	/* Início eSocial */
	IF ((:NEW.FUNESO = 'S') OR (:OLD.FUNESO = 'S')) THEN
		l_Alterou := FALSE;
		l_AlterouSomenteDataFim := FALSE;
		l_JsonCamposAlterados := '';

		SP_VALUPDATE_NUM(:OLD.ESTPOS, :NEW.ESTPOS, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('ESTPOS', :NEW.EstPos, :OLD.EstPos, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DES(:OLD.POSTRA, :NEW.POSTRA, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('POSTRA', :NEW.PosTra, :OLD.PosTra, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DES(:OLD.FUNESO, :NEW.FUNESO, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('FUNESO', :NEW.FunEso, :OLD.FunEso, l_JsonCamposAlterados OUT);
		END IF;
	
		SP_VALUPDATE_DAT(:OLD.TERATU, :NEW.TERATU, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			IF (l_Alterou = FALSE) THEN
				l_AlterouSomenteDataFim := TRUE;
			END IF;
			l_Alterou := TRUE;
			SP_CONCAT_DAT_JSON('TERATU', :NEW.TerAtu, :OLD.TerAtu, l_JsonCamposAlterados OUT);	
		END IF;	

		IF (l_AlterouSomenteDataFim = TRUE) THEN
			l_HistoriaPrincipal := ' ';
			SP_RETR017TAP(:NEW.CODTAP, l_HistoriaPrincipal OUT);
 			IF (l_HistoriaPrincipal = 'S') THEN
		 		l_Alterou := FALSE;
			END IF;
		END IF;

		IF (l_Alterou = TRUE) THEN 
			RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);
			IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
				SP_ALT_TAB_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, :OLD.TERATU, 'R038HPO', '', l_JsonCamposAlterados, l_AlterouSomenteDataFim, 'INIATU', ' AND FUNESO = ''S''', 0, 'R038HPO_EU');
			END IF;	
		END IF;
	END IF;
	/* Fim eSocial */
  
	/* Início S-2240 */
	RH_RET_DATINISST(:NEW.NumEmp, l_DatIniSST OUT);
	IF (l_DatIniSST > l_DataZero) THEN
		IF (:NEW.TerAtu > l_DatIniSST OR :NEW.TerAtu = l_DataZero OR :OLD.TerAtu > l_DatIniSST OR :OLD.TerAtu = l_DataZero) THEN  	  	
			l_AlterouPosto := FALSE;
			l_AlterouDataTermino := FALSE;
	
			SP_VALUPDATE_NUM(:OLD.EstPos, :NEW.EstPos, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouPosto := TRUE;
			END IF;
	
			SP_VALUPDATE_DES(:OLD.PosTra, :NEW.PosTra, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouPosto := TRUE;
			END IF;
		
			SP_VALUPDATE_DAT(:OLD.TerAtu, :NEW.TerAtu, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouDataTermino := TRUE;
			END IF;
			
			IF (l_AlterouPosto = TRUE) THEN
				l_DataInicio := :NEW.IniAtu;
				IF (l_DataInicio < l_DatIniSST) THEN
	  				l_DataInicio := l_DatIniSST;
	  			END IF;
	  			
	  			IF (:OLD.TerAtu < :NEW.TerAtu) THEN
	  				l_DataTermino := :OLD.TerAtu;
	  			ELSE
	  				l_DataTermino := :NEW.TerAtu;
	  			END IF;
	  			
				SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
			END IF;
			
			IF (l_AlterouDataTermino = TRUE) THEN
				IF (:OLD.TerAtu > l_DataZero AND :NEW.TerAtu > l_DataZero) THEN
					IF (:NEW.TerAtu > :OLD.TerAtu) THEN
						l_DataInicio := DATETIMEADD(DD, 1, :OLD.TerAtu);
						l_DataTermino := :NEW.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
						
						IF (:NEW.TerAtu < l_DataMax) THEN
							l_DataAux := DATETIMEADD(DD, 1, :NEW.TerAtu);
							SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataAux, l_DataAux, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataAux, 0, 'R038HPO_EU');
						END IF;
					ELSE
						l_DataInicio := DATETIMEADD(DD, 1, :NEW.TerAtu);
						l_DataTermino := :OLD.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
					END IF;
				ELSE
					IF (:OLD.TerAtu = l_DataZero AND :NEW.TerAtu > l_DataZero AND :NEW.TerAtu < l_DataMax) THEN
						l_DataInicio := DATETIMEADD(DD, 1, :NEW.TerAtu);
						l_DataTermino := :OLD.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
					ELSE
						IF (:NEW.TerAtu = l_DataZero AND :OLD.TerAtu > l_DataZero  AND :OLD.TerAtu < l_DataMax) THEN
							l_DataInicio := DATETIMEADD(DD, 1, :OLD.TerAtu);
							l_DataTermino := :NEW.TerAtu;
							SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
						END IF;
					END IF;
				END IF;
			END IF;
		END IF;
	END IF;
	/* Fim S-2240 */
	
	RH_ALTHIEPOS();
END		SENIOR;22r7␀␀

TRIGGER R038HPO_EU AFTER UPDATE ON R038HPO FOR EACH ROW
DECLARE
  l_datpos     DATE;
  l_hisPriAux  CHAR(1);
  l_isInformix BOOLEAN;
  l_xUtiPosOri CHAR;
  l_xEstPosOri NUMBER(3);
  l_xCodPlvOri NUMBER(4);
  l_xUtiPosDes CHAR;
  l_xEstPosDes NUMBER(3);
  l_xCodPlvDes NUMBER(4);
  l_xPosOriAut CHAR;
  l_xPosDesAut CHAR;
  l_xIndCon CHAR;
  
  l_Alterou BOOLEAN;
  l_Valido  BOOLEAN;
  l_AlterouSomenteDataFim BOOLEAN;
  l_HistoriaPrincipal CHAR;
  l_layoutAlteracaoContrato VARCHAR(6);
  l_JsonCamposAlterados VARCHAR2(2000);
  
  l_DataZero DATE;
  l_DataMax DATE;
  l_DatIniSST DATE;
  l_AlterouDataTermino BOOLEAN;
  l_AlterouPosto BOOLEAN;
  l_DataInicio DATE;
  l_DataTermino DATE;
  l_DataAux DATE;

  /* ACESSO */
  l_oriDef NUMBER(1);
  l_oldOriDef NUMBER(1);
  l_hisPri VARCHAR2(1);
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_codprm NUMBER(5);
  l_codprmAux NUMBER(5);
  l_estPos   R038HPO.EstPos%TYPE;
  l_posTra   R038HPO.PosTra%TYPE;
  l_data_zero DATE;
  
  CURSOR c_r017PEP IS
       SELECT CODPRM, CODUSU, OBSPRM
         FROM R017PEP
        WHERE R017PEP.ESTPOS = l_estPos AND
              R017PEP.POSTRA = l_posTra;

  TYPE t_r017PEP IS RECORD(
    CODPRM   R017PEP.CODPRM%TYPE,
    CODUSU   R017PEP.CODUSU%TYPE,
    OBSPRM   R017PEP.OBSPRM%TYPE);
  l_r017PEP t_r017PEP;
  

BEGIN
  /* Inicializações */
  l_DataZero := '31/12/1900,00:00:00';
  l_DataMax := '04/06/2080,00:00:00';
  l_oriDef := 2;
  l_oldOriDef := 2;
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';
  
  RH_ISINFORMIX(l_isInformix OUT);
  /* No informix, a trigger não pode atualizar o próprio registro */
  IF (l_isInformix = FALSE) THEN
    BEGIN
      BEGIN
        SELECT HISPRI
          INTO l_hisPriAux
          FROM R017TAP
         WHERE R017TAP.CODTAP = :NEW.CODTAP;
      EXCEPTION WHEN OTHERS THEN
        NULL;
      END;

      IF (l_hisPriAux = 'S') THEN
        IF (:NEW.STAHIS = 1) THEN
          BEGIN
            SELECT R034FUN.DATPOS INTO l_datpos
              FROM R034FUN
             WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                   R034FUN.NUMEMP = :NEW.NUMEMP AND
                   R034FUN.NUMCAD = :NEW.NUMCAD;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              RAISERROR 103 'Erro ao carregar dados do colaborador.';
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao carregar dados do colaborador.';
          END;

          IF ((:NEW.INIATU >= l_datpos) OR (l_datpos IS NULL)) THEN
            BEGIN
              UPDATE R034FUN
                 SET ESTPOS = :NEW.ESTPOS,
                     POSTRA = :NEW.POSTRA,
                     CODTAP = :NEW.CODTAP,
                     DATPOS = :NEW.INIATU
               WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                     R034FUN.NUMEMP = :NEW.NUMEMP AND
                     R034FUN.NUMCAD = :NEW.NUMCAD;
            EXCEPTION
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao atualizar dados do colaborador quando o histórico do posto é alterado.';
            END;
          END IF;
        END IF;
      END IF;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar R034FUN campos dos posto de trabalho.';
    END;

    /* ACESSO */	
	BEGIN
	    SELECT HISPRI INTO l_hisPri FROM R017TAP WHERE R017TAP.CODTAP = :NEW.CODTAP;
	EXCEPTION 
	    WHEN OTHERS THEN RAISERROR 103 'R038HPO_EU: Erro ao fazer a seleção na tabela R017TAP.';
    END;
	
	IF (l_hisPri = 'S') THEN
	    l_oriDef := 1;
	END IF;
	
	l_hispri := 'N';
	BEGIN
	    SELECT HISPRI INTO l_hisPri FROM R017TAP WHERE R017TAP.CODTAP = :OLD.CODTAP;
	EXCEPTION 
	    WHEN OTHERS THEN RAISERROR 103 'R038HPO_EU: Erro ao fazer a seleção na tabela R017TAP. 2';
    END;
	
	IF (l_hisPri = 'S') THEN
	    l_oldOriDef := 1;
	END IF;
	
    IF ((:OLD.NUMEMP <> :NEW.NUMEMP) OR (:OLD.POSTRA <> :NEW.POSTRA)) THEN
      /* Caso trabalho com postos de trabalho atualizamos o efetivo por posto do registro origem e destino */
      QL_UTIPOSTRA(:OLD.NUMEMP, :OLD.INIATU, l_xUtiPosOri OUT, l_xEstPosOri OUT, l_xCodPlvOri OUT);
      QL_UTIPOSTRA(:NEW.NUMEMP, :NEW.INIATU, l_xUtiPosDes OUT, l_xEstPosDes OUT, l_xCodPlvDes OUT);
	  
	  /* Verifica se o colaborador está indicado no módulo QL. */
	  QL_VERMODQL(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_xIndCon OUT);
	  IF (l_xIndCon <> 'N') THEN
        QL_POSTOAUT(l_xEstPosOri, :OLD.POSTRA, :OLD.INIATU, :OLD.CODTAP, l_xPosOriAut OUT);
	  END IF;
      IF (l_xUtiPosOri = 'S') AND (l_xPosOriAut = 'S') THEN
        QL_ATUEFEPOS('U', 'R038HPO', :OLD.NUMEMP, l_xEstPosOri, l_xCodPlvOri, :OLD.POSTRA, -1, :OLD.INIATU, 'N', 'N', 'N');
        QL_AJUQTDEFE('R038HPO', l_xEstPosOri, l_xCodPlvOri, :OLD.POSTRA, :OLD.INIATU, :OLD.TERATU, -1);
      END IF;
	  
	  /* Verifica se o colaborador está indicado no módulo QL. */
      QL_VERMODQL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_xIndCon OUT);
	  IF (l_xIndCon <> 'N') THEN
        QL_POSTOAUT(l_xEstPosDes, :NEW.POSTRA, :NEW.INIATU, :NEW.CODTAP, l_xPosDesAut OUT);
	  END IF;	
      IF (l_xUtiPosDes = 'S') AND (l_xPosDesAut = 'S') THEN
        QL_ATUEFEPOS('U', 'R038HPO', :NEW.NUMEMP, l_xEstPosDes, l_xCodPlvDes, :NEW.POSTRA, 1, :NEW.INIATU, 'N', 'N', 'N');
        QL_AJUQTDEFE('R038HPO', l_xEstPosDes, l_xCodPlvDes, :NEW.POSTRA, :NEW.INIATU, :NEW.TERATU, 1);
      END IF;
    END IF;	
  END IF;
	
	FOREACH c_r017PEP INTO l_r017PEP.CODPRM,
                           l_r017PEP.CODUSU,
                           l_r017PEP.OBSPRM							 
    LOOP
	    BEGIN
	        IF ((:OLD.ESTPOS <> :NEW.ESTPOS) OR (:OLD.POSTRA <> :NEW.POSTRA)) THEN
			    UPDATE R070PEC SET DATFIM = l_data_atual, HORFIM = l_hora_atual, CODUSU = :NEW.CODUSU WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATINI = :OLD.INIATU AND ORIDEF = l_oldOriDef;
				SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_r017PEP.CODPRM, l_oriDef);
                INSERT INTO R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM, ORIDEF)
                             VALUES ( :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, 0,  l_r017PEP.CODPRM, :NEW.TERATU, 1439,  :NEW.CODUSU, l_r017PEP.OBSPRM,  l_oriDef);
			END IF;
				
			IF (:OLD.OBSHPO <> :NEW.OBSHPO) THEN
			    UPDATE R070PEC SET OBSPRM = :NEW.OBSHPO, CODUSU = :NEW.CODUSU WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATINI = :OLD.INIATU AND ORIDEF = l_oldOriDef;
			END IF;
        EXCEPTION 
            WHEN OTHERS THEN RAISERROR 103 'R038HPO_EI: Erro ao atualizar a tabela R017PEC.';
        END;
    END LOOP;
	
	IF (l_oriDef = 2) THEN
		BEGIN
	        SELECT CODPRM INTO l_codprm FROM R017DAC WHERE ESTPOS = :NEW.ESTPOS AND POSTRA = :NEW.POSTRA;
		EXCEPTION 
		    WHEN NO_DATA_FOUND THEN l_codprm := 0;
		END;
		IF (l_codprm <> 0) THEN
		    BEGIN
		        SELECT CODPRM INTO l_codprmAux FROM R070PEC WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD AND CODPRM = l_codprm AND DATINI < l_data_atual AND (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual)) AND ORIDEF = 2;
			EXCEPTION 
			    WHEN NO_DATA_FOUND THEN l_codprmAux := 0;
			END;
			IF (l_codprmAux = 0) THEN
			    SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_codprm, l_oriDef);
		        INSERT INTO R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM,  ORIDEF)
                             VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, 0,  l_codprm, :NEW.TERATU, 1439,  :NEW.CODUSU, l_r017PEP.OBSPRM,  l_oriDef);
			END IF;
		END IF;
	END IF;
	
	BEGIN
		INSERT INTO R038HPO_AUX (NUMEMP, TIPCOL, NUMCAD, INIATU, SEQHIS, CODTAP, MOTALT, ESTPOS, POSTRA, TERATU, CODUSU)
										 VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.SEQHIS, :NEW.CODTAP,
														 :NEW.MOTALT, :NEW.ESTPOS, :NEW.POSTRA, :NEW.TERATU, :NEW.CODUSU);
	EXCEPTION WHEN OTHERS THEN
		RAISERROR 103 'Erro ao inserir registro na tabela R038HPO_AUX.';
	END;
	
	/* Atualizar definicoes de acesso e permissoes por local fisico/dispositivo. Verifico o status do histórico. */
	/* Se tinha um histórico presente e ficou passado, devo retirar as definições de acesso e permissões por local físico/disp. */
	/* Se tinha um histórico futuro e ficou presente, devo incluir as definições de acesso e permissões por local físico/disp. */
    IF  (:NEW.STAHIS = 1) AND (:OLD.STAHIS = 0) THEN /* de futuro para presente */
        SP_GesPer('I', :NEW.ESTPOS, :NEW.POSTRA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, l_oriDef);
    END IF;
    IF  (:NEW.STAHIS = 2) AND (:OLD.STAHIS = 1) THEN /* de presente para passado */
        SP_GesPer('D', :NEW.ESTPOS, :NEW.POSTRA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, l_oriDef);
    END IF;
		
		BEGIN
			DELETE FROM R038HPO_AUX ;
		EXCEPTION WHEN OTHERS THEN
			RAISERROR 103 'Erro ao deletar registro na tabela R038HPO_AUX.';
		END;
  
	/* Início eSocial */
	IF ((:NEW.FUNESO = 'S') OR (:OLD.FUNESO = 'S')) THEN
		l_Alterou := FALSE;
		l_AlterouSomenteDataFim := FALSE;
		l_JsonCamposAlterados := '';

		SP_VALUPDATE_NUM(:OLD.ESTPOS, :NEW.ESTPOS, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('ESTPOS', :NEW.EstPos, :OLD.EstPos, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DES(:OLD.POSTRA, :NEW.POSTRA, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('POSTRA', :NEW.PosTra, :OLD.PosTra, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DES(:OLD.FUNESO, :NEW.FUNESO, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('FUNESO', :NEW.FunEso, :OLD.FunEso, l_JsonCamposAlterados OUT);
		END IF;
	
		SP_VALUPDATE_DAT(:OLD.TERATU, :NEW.TERATU, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			IF (l_Alterou = FALSE) THEN
				l_AlterouSomenteDataFim := TRUE;
			END IF;
			l_Alterou := TRUE;
			SP_CONCAT_DAT_JSON('TERATU', :NEW.TerAtu, :OLD.TerAtu, l_JsonCamposAlterados OUT);	
		END IF;	

		IF (l_AlterouSomenteDataFim = TRUE) THEN
			l_HistoriaPrincipal := ' ';
			SP_RETR017TAP(:NEW.CODTAP, l_HistoriaPrincipal OUT);
 			IF (l_HistoriaPrincipal = 'S') THEN
		 		l_Alterou := FALSE;
			END IF;
		END IF;

		IF (l_Alterou = TRUE) THEN 
			RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);
			IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
				SP_ALT_TAB_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, :OLD.TERATU, 'R038HPO', '', l_JsonCamposAlterados, l_AlterouSomenteDataFim, 'INIATU', ' AND FUNESO = ''S''', 0, 'R038HPO_EU');
			END IF;	
		END IF;
	END IF;
	/* Fim eSocial */
  
	/* Início S-2240 */
	RH_RET_DATINISST(:NEW.NumEmp, l_DatIniSST OUT);
	IF (l_DatIniSST > l_DataZero) THEN
		IF (:NEW.TerAtu > l_DatIniSST OR :NEW.TerAtu = l_DataZero OR :OLD.TerAtu > l_DatIniSST OR :OLD.TerAtu = l_DataZero) THEN  	  	
			l_AlterouPosto := FALSE;
			l_AlterouDataTermino := FALSE;
	
			SP_VALUPDATE_NUM(:OLD.EstPos, :NEW.EstPos, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouPosto := TRUE;
			END IF;
	
			SP_VALUPDATE_DES(:OLD.PosTra, :NEW.PosTra, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouPosto := TRUE;
			END IF;
		
			SP_VALUPDATE_DAT(:OLD.TerAtu, :NEW.TerAtu, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouDataTermino := TRUE;
			END IF;
			
			IF (l_AlterouPosto = TRUE) THEN
				l_DataInicio := :NEW.IniAtu;
				IF (l_DataInicio < l_DatIniSST) THEN
	  				l_DataInicio := l_DatIniSST;
	  			END IF;
	  			
	  			IF (:OLD.TerAtu < :NEW.TerAtu) THEN
	  				l_DataTermino := :OLD.TerAtu;
	  			ELSE
	  				l_DataTermino := :NEW.TerAtu;
	  			END IF;
	  			
				SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
			END IF;
			
			IF (l_AlterouDataTermino = TRUE) THEN
				IF (:OLD.TerAtu > l_DataZero AND :NEW.TerAtu > l_DataZero) THEN
					IF (:NEW.TerAtu > :OLD.TerAtu) THEN
						l_DataInicio := DATETIMEADD(DD, 1, :OLD.TerAtu);
						l_DataTermino := :NEW.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
						
						IF (:NEW.TerAtu < l_DataMax) THEN
							l_DataAux := DATETIMEADD(DD, 1, :NEW.TerAtu);
							SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataAux, l_DataAux, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataAux, 0, 'R038HPO_EU');
						END IF;
					ELSE
						l_DataInicio := DATETIMEADD(DD, 1, :NEW.TerAtu);
						l_DataTermino := :OLD.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
					END IF;
				ELSE
					IF (:OLD.TerAtu = l_DataZero AND :NEW.TerAtu > l_DataZero AND :NEW.TerAtu < l_DataMax) THEN
						l_DataInicio := DATETIMEADD(DD, 1, :NEW.TerAtu);
						l_DataTermino := :OLD.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
					ELSE
						IF (:NEW.TerAtu = l_DataZero AND :OLD.TerAtu > l_DataZero  AND :OLD.TerAtu < l_DataMax) THEN
							l_DataInicio := DATETIMEADD(DD, 1, :OLD.TerAtu);
							l_DataTermino := :NEW.TerAtu;
							SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
						END IF;
					END IF;
				END IF;
			END IF;
		END IF;
	END IF;
	/* Fim S-2240 */
	
	RH_ALTHIEPOS();
END		SENIOR;23r7␀␀

TRIGGER R038HPO_EU AFTER UPDATE ON R038HPO FOR EACH ROW
DECLARE
  l_datpos     DATE;
  l_hisPriAux  CHAR(1);
  l_isInformix BOOLEAN;
  l_xUtiPosOri CHAR;
  l_xEstPosOri NUMBER(3);
  l_xCodPlvOri NUMBER(4);
  l_xUtiPosDes CHAR;
  l_xEstPosDes NUMBER(3);
  l_xCodPlvDes NUMBER(4);
  l_xPosOriAut CHAR;
  l_xPosDesAut CHAR;
  l_xIndCon CHAR;
  
  l_Alterou BOOLEAN;
  l_Valido  BOOLEAN;
  l_AlterouSomenteDataFim BOOLEAN;
  l_HistoriaPrincipal CHAR;
  l_layoutAlteracaoContrato VARCHAR(6);
  l_JsonCamposAlterados VARCHAR2(2000);
  
  l_DataZero DATE;
  l_DataMax DATE;
  l_DatIniSST DATE;
  l_AlterouDataTermino BOOLEAN;
  l_AlterouPosto BOOLEAN;
  l_DataInicio DATE;
  l_DataTermino DATE;
  l_DataAux DATE;

  /* ACESSO */
  l_oriDef NUMBER(1);
  l_oldOriDef NUMBER(1);
  l_hisPri VARCHAR2(1);
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_codprm NUMBER(5);
  l_codprmAux NUMBER(5);
  l_estPos   R038HPO.EstPos%TYPE;
  l_posTra   R038HPO.PosTra%TYPE;
  l_data_zero DATE;
  
  CURSOR c_r017PEP IS
       SELECT CODPRM, CODUSU, OBSPRM
         FROM R017PEP
        WHERE R017PEP.ESTPOS = l_estPos AND
              R017PEP.POSTRA = l_posTra;

  TYPE t_r017PEP IS RECORD(
    CODPRM   R017PEP.CODPRM%TYPE,
    CODUSU   R017PEP.CODUSU%TYPE,
    OBSPRM   R017PEP.OBSPRM%TYPE);
  l_r017PEP t_r017PEP;
  

BEGIN
  /* Inicializações */
  l_DataZero := '31/12/1900,00:00:00';
  l_DataMax := '04/06/2080,00:00:00';
  l_oriDef := 2;
  l_oldOriDef := 2;
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';
  
  RH_ISINFORMIX(l_isInformix OUT);
  /* No informix, a trigger não pode atualizar o próprio registro */
  IF (l_isInformix = FALSE) THEN
    BEGIN
      BEGIN
        SELECT HISPRI
          INTO l_hisPriAux
          FROM R017TAP
         WHERE R017TAP.CODTAP = :NEW.CODTAP;
      EXCEPTION WHEN OTHERS THEN
        NULL;
      END;

      IF (l_hisPriAux = 'S') THEN
        IF (:NEW.STAHIS = 1) THEN
          BEGIN
            SELECT R034FUN.DATPOS INTO l_datpos
              FROM R034FUN
             WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                   R034FUN.NUMEMP = :NEW.NUMEMP AND
                   R034FUN.NUMCAD = :NEW.NUMCAD;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              RAISERROR 103 'Erro ao carregar dados do colaborador.';
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao carregar dados do colaborador.';
          END;

          IF ((:NEW.INIATU >= l_datpos) OR (l_datpos IS NULL)) THEN
            BEGIN
              UPDATE R034FUN
                 SET ESTPOS = :NEW.ESTPOS,
                     POSTRA = :NEW.POSTRA,
                     CODTAP = :NEW.CODTAP,
                     DATPOS = :NEW.INIATU
               WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                     R034FUN.NUMEMP = :NEW.NUMEMP AND
                     R034FUN.NUMCAD = :NEW.NUMCAD;
            EXCEPTION
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao atualizar dados do colaborador quando o histórico do posto é alterado.';
            END;
          END IF;
        END IF;
      END IF;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar R034FUN campos dos posto de trabalho.';
    END;

    /* ACESSO */	
	BEGIN
	    SELECT HISPRI INTO l_hisPri FROM R017TAP WHERE R017TAP.CODTAP = :NEW.CODTAP;
	EXCEPTION 
	    WHEN OTHERS THEN RAISERROR 103 'R038HPO_EU: Erro ao fazer a seleção na tabela R017TAP.';
    END;
	
	IF (l_hisPri = 'S') THEN
	    l_oriDef := 1;
	END IF;
	
	l_hispri := 'N';
	BEGIN
	    SELECT HISPRI INTO l_hisPri FROM R017TAP WHERE R017TAP.CODTAP = :OLD.CODTAP;
	EXCEPTION 
	    WHEN OTHERS THEN RAISERROR 103 'R038HPO_EU: Erro ao fazer a seleção na tabela R017TAP. 2';
    END;
	
	IF (l_hisPri = 'S') THEN
	    l_oldOriDef := 1;
	END IF;
	
    IF ((:OLD.NUMEMP <> :NEW.NUMEMP) OR (:OLD.POSTRA <> :NEW.POSTRA)) THEN
      /* Caso trabalho com postos de trabalho atualizamos o efetivo por posto do registro origem e destino */
      QL_UTIPOSTRA(:OLD.NUMEMP, :OLD.INIATU, l_xUtiPosOri OUT, l_xEstPosOri OUT, l_xCodPlvOri OUT);
      QL_UTIPOSTRA(:NEW.NUMEMP, :NEW.INIATU, l_xUtiPosDes OUT, l_xEstPosDes OUT, l_xCodPlvDes OUT);
	  
	  /* Verifica se o colaborador está indicado no módulo QL. */
	  QL_VERMODQL(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_xIndCon OUT);
	  IF (l_xIndCon <> 'N') THEN
        QL_POSTOAUT(l_xEstPosOri, :OLD.POSTRA, :OLD.INIATU, :OLD.CODTAP, l_xPosOriAut OUT);
	  END IF;
      IF (l_xUtiPosOri = 'S') AND (l_xPosOriAut = 'S') THEN
        QL_ATUEFEPOS('U', 'R038HPO', :OLD.NUMEMP, l_xEstPosOri, l_xCodPlvOri, :OLD.POSTRA, -1, :OLD.INIATU, 'N', 'N', 'N');
        QL_AJUQTDEFE('R038HPO', l_xEstPosOri, l_xCodPlvOri, :OLD.POSTRA, :OLD.INIATU, :OLD.TERATU, -1);
      END IF;
	  
	  /* Verifica se o colaborador está indicado no módulo QL. */
      QL_VERMODQL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_xIndCon OUT);
	  IF (l_xIndCon <> 'N') THEN
        QL_POSTOAUT(l_xEstPosDes, :NEW.POSTRA, :NEW.INIATU, :NEW.CODTAP, l_xPosDesAut OUT);
	  END IF;	
      IF (l_xUtiPosDes = 'S') AND (l_xPosDesAut = 'S') THEN
        QL_ATUEFEPOS('U', 'R038HPO', :NEW.NUMEMP, l_xEstPosDes, l_xCodPlvDes, :NEW.POSTRA, 1, :NEW.INIATU, 'N', 'N', 'N');
        QL_AJUQTDEFE('R038HPO', l_xEstPosDes, l_xCodPlvDes, :NEW.POSTRA, :NEW.INIATU, :NEW.TERATU, 1);
      END IF;
    END IF;	
  END IF;
	
	FOREACH c_r017PEP INTO l_r017PEP.CODPRM,
                           l_r017PEP.CODUSU,
                           l_r017PEP.OBSPRM							 
    LOOP
	    BEGIN
	        IF ((:OLD.ESTPOS <> :NEW.ESTPOS) OR (:OLD.POSTRA <> :NEW.POSTRA)) THEN
			    UPDATE R070PEC SET DATFIM = l_data_atual, HORFIM = l_hora_atual, CODUSU = :NEW.CODUSU WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATINI = :OLD.INIATU AND ORIDEF = l_oldOriDef;
				SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_r017PEP.CODPRM, l_oriDef);
                INSERT INTO R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM, ORIDEF)
                             VALUES ( :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, 0,  l_r017PEP.CODPRM, :NEW.TERATU, 1439,  :NEW.CODUSU, l_r017PEP.OBSPRM,  l_oriDef);
			END IF;
				
			IF (:OLD.OBSHPO <> :NEW.OBSHPO) THEN
			    UPDATE R070PEC SET OBSPRM = :NEW.OBSHPO, CODUSU = :NEW.CODUSU WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATINI = :OLD.INIATU AND ORIDEF = l_oldOriDef;
			END IF;
        EXCEPTION 
            WHEN OTHERS THEN RAISERROR 103 'R038HPO_EI: Erro ao atualizar a tabela R017PEC.';
        END;
    END LOOP;
	
	IF (l_oriDef = 2) THEN
		BEGIN
	        SELECT CODPRM INTO l_codprm FROM R017DAC WHERE ESTPOS = :NEW.ESTPOS AND POSTRA = :NEW.POSTRA;
		EXCEPTION 
		    WHEN NO_DATA_FOUND THEN l_codprm := 0;
		END;
		IF (l_codprm <> 0) THEN
		    BEGIN
		        SELECT CODPRM INTO l_codprmAux FROM R070PEC WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD AND CODPRM = l_codprm AND DATINI < l_data_atual AND (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual)) AND ORIDEF = 2;
			EXCEPTION 
			    WHEN NO_DATA_FOUND THEN l_codprmAux := 0;
			END;
			IF (l_codprmAux = 0) THEN
			    SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_codprm, l_oriDef);
		        INSERT INTO R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM,  ORIDEF)
                             VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, 0,  l_codprm, :NEW.TERATU, 1439,  :NEW.CODUSU, l_r017PEP.OBSPRM,  l_oriDef);
			END IF;
		END IF;
	END IF;
	
	BEGIN
		INSERT INTO R038HPO_AUX (NUMEMP, TIPCOL, NUMCAD, INIATU, SEQHIS, CODTAP, MOTALT, ESTPOS, POSTRA, TERATU, CODUSU)
										 VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.SEQHIS, :NEW.CODTAP,
														 :NEW.MOTALT, :NEW.ESTPOS, :NEW.POSTRA, :NEW.TERATU, :NEW.CODUSU);
	EXCEPTION WHEN OTHERS THEN
		RAISERROR 103 'Erro ao inserir registro na tabela R038HPO_AUX.';
	END;
	
	/* Atualizar definicoes de acesso e permissoes por local fisico/dispositivo. Verifico o status do histórico. */
	/* Se tinha um histórico presente e ficou passado, devo retirar as definições de acesso e permissões por local físico/disp. */
	/* Se tinha um histórico futuro e ficou presente, devo incluir as definições de acesso e permissões por local físico/disp. */
    IF  (:NEW.STAHIS = 1) AND (:OLD.STAHIS = 0) THEN /* de futuro para presente */
        SP_GesPer('I', :NEW.ESTPOS, :NEW.POSTRA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, l_oriDef);
    END IF;
    IF  (:NEW.STAHIS = 2) AND (:OLD.STAHIS = 1) THEN /* de presente para passado */
        SP_GesPer('D', :NEW.ESTPOS, :NEW.POSTRA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, l_oriDef);
    END IF;
		
		BEGIN
			DELETE FROM R038HPO_AUX ;
		EXCEPTION WHEN OTHERS THEN
			RAISERROR 103 'Erro ao deletar registro na tabela R038HPO_AUX.';
		END;
  
	/* Início eSocial */
	IF ((:NEW.FUNESO = 'S') OR (:OLD.FUNESO = 'S')) THEN
		l_Alterou := FALSE;
		l_AlterouSomenteDataFim := FALSE;
		l_JsonCamposAlterados := '';

		SP_VALUPDATE_NUM(:OLD.ESTPOS, :NEW.ESTPOS, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('ESTPOS', :NEW.EstPos, :OLD.EstPos, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DES(:OLD.POSTRA, :NEW.POSTRA, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('POSTRA', :NEW.PosTra, :OLD.PosTra, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DES(:OLD.FUNESO, :NEW.FUNESO, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('FUNESO', :NEW.FunEso, :OLD.FunEso, l_JsonCamposAlterados OUT);
		END IF;
	
		SP_VALUPDATE_DAT(:OLD.TERATU, :NEW.TERATU, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			IF (l_Alterou = FALSE) THEN
				l_AlterouSomenteDataFim := TRUE;
			END IF;
			l_Alterou := TRUE;
			SP_CONCAT_DAT_JSON('TERATU', :NEW.TerAtu, :OLD.TerAtu, l_JsonCamposAlterados OUT);	
		END IF;	

		IF (l_AlterouSomenteDataFim = TRUE) THEN
			l_HistoriaPrincipal := ' ';
			SP_RETR017TAP(:NEW.CODTAP, l_HistoriaPrincipal OUT);
 			IF (l_HistoriaPrincipal = 'S') THEN
		 		l_Alterou := FALSE;
			END IF;
		END IF;

		IF (l_Alterou = TRUE) THEN 
			RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);
			IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
				SP_ALT_TAB_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, :OLD.TERATU, 'R038HPO', '', l_JsonCamposAlterados, l_AlterouSomenteDataFim, 'INIATU', ' AND FUNESO = ''S''', 0, 'R038HPO_EU');
			END IF;	
		END IF;
	END IF;
	/* Fim eSocial */
  
	/* Início S-2240 */
	RH_RET_DATINISST(:NEW.NumEmp, l_DatIniSST OUT);
	IF (l_DatIniSST > l_DataZero) THEN
		IF (:NEW.TerAtu > l_DatIniSST OR :NEW.TerAtu = l_DataZero OR :OLD.TerAtu > l_DatIniSST OR :OLD.TerAtu = l_DataZero) THEN  	  	
			l_AlterouPosto := FALSE;
			l_AlterouDataTermino := FALSE;
	
			SP_VALUPDATE_NUM(:OLD.EstPos, :NEW.EstPos, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouPosto := TRUE;
			END IF;
	
			SP_VALUPDATE_DES(:OLD.PosTra, :NEW.PosTra, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouPosto := TRUE;
			END IF;
		
			SP_VALUPDATE_DAT(:OLD.TerAtu, :NEW.TerAtu, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouDataTermino := TRUE;
			END IF;
			
			IF (l_AlterouPosto = TRUE) THEN
				l_DataInicio := :NEW.IniAtu;
				IF (l_DataInicio < l_DatIniSST) THEN
	  				l_DataInicio := l_DatIniSST;
	  			END IF;
	  			
	  			IF (:OLD.TerAtu < :NEW.TerAtu) THEN
	  				l_DataTermino := :OLD.TerAtu;
	  			ELSE
	  				l_DataTermino := :NEW.TerAtu;
	  			END IF;
	  			
				SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
			END IF;
			
			IF (l_AlterouDataTermino = TRUE) THEN
				IF (:OLD.TerAtu > l_DataZero AND :NEW.TerAtu > l_DataZero) THEN
					IF (:NEW.TerAtu > :OLD.TerAtu) THEN
						l_DataInicio := DATETIMEADD(DD, 1, :OLD.TerAtu);
						l_DataTermino := :NEW.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
						
						IF (:NEW.TerAtu < l_DataMax) THEN
							l_DataAux := DATETIMEADD(DD, 1, :NEW.TerAtu);
							SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataAux, l_DataAux, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataAux, 0, 'R038HPO_EU');
						END IF;
					ELSE
						l_DataInicio := DATETIMEADD(DD, 1, :NEW.TerAtu);
						l_DataTermino := :OLD.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
					END IF;
				ELSE
					IF (:OLD.TerAtu = l_DataZero AND :NEW.TerAtu > l_DataZero AND :NEW.TerAtu < l_DataMax) THEN
						l_DataInicio := DATETIMEADD(DD, 1, :NEW.TerAtu);
						l_DataTermino := :OLD.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
					ELSE
						IF (:NEW.TerAtu = l_DataZero AND :OLD.TerAtu > l_DataZero  AND :OLD.TerAtu < l_DataMax) THEN
							l_DataInicio := DATETIMEADD(DD, 1, :OLD.TerAtu);
							l_DataTermino := :NEW.TerAtu;
							SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
						END IF;
					END IF;
				END IF;
			END IF;
		END IF;
	END IF;
	/* Fim S-2240 */
	
	RH_ALTHIEPOS();
END		SENIOR;24r7␀␀

TRIGGER R038HPO_EU AFTER UPDATE ON R038HPO FOR EACH ROW
DECLARE
  l_datpos     DATE;
  l_hisPriAux  CHAR(1);
  l_isInformix BOOLEAN;
  l_xUtiPosOri CHAR;
  l_xEstPosOri NUMBER(3);
  l_xCodPlvOri NUMBER(4);
  l_xUtiPosDes CHAR;
  l_xEstPosDes NUMBER(3);
  l_xCodPlvDes NUMBER(4);
  l_xPosOriAut CHAR;
  l_xPosDesAut CHAR;
  l_xIndCon CHAR;
  
  l_Alterou BOOLEAN;
  l_Valido  BOOLEAN;
  l_AlterouSomenteDataFim BOOLEAN;
  l_HistoriaPrincipal CHAR;
  l_layoutAlteracaoContrato VARCHAR(6);
  l_JsonCamposAlterados VARCHAR2(2000);
  
  l_DataZero DATE;
  l_DataMax DATE;
  l_DatIniSST DATE;
  l_AlterouDataTermino BOOLEAN;
  l_AlterouPosto BOOLEAN;
  l_DataInicio DATE;
  l_DataTermino DATE;
  l_DataAux DATE;

  /* ACESSO */
  l_oriDef NUMBER(1);
  l_oldOriDef NUMBER(1);
  l_hisPri VARCHAR2(1);
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_codprm NUMBER(5);
  l_codprmAux NUMBER(5);
  l_estPos   R038HPO.EstPos%TYPE;
  l_posTra   R038HPO.PosTra%TYPE;
  l_data_zero DATE;
  
  CURSOR c_r017PEP IS
       SELECT CODPRM, CODUSU, OBSPRM
         FROM R017PEP
        WHERE R017PEP.ESTPOS = l_estPos AND
              R017PEP.POSTRA = l_posTra;

  TYPE t_r017PEP IS RECORD(
    CODPRM   R017PEP.CODPRM%TYPE,
    CODUSU   R017PEP.CODUSU%TYPE,
    OBSPRM   R017PEP.OBSPRM%TYPE);
  l_r017PEP t_r017PEP;
  

BEGIN
  /* Inicializações */
  l_DataZero := '31/12/1900,00:00:00';
  l_DataMax := '04/06/2080,00:00:00';
  l_oriDef := 2;
  l_oldOriDef := 2;
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';
  
  RH_ISINFORMIX(l_isInformix OUT);
  /* No informix, a trigger não pode atualizar o próprio registro */
  IF (l_isInformix = FALSE) THEN
    BEGIN
      BEGIN
        SELECT HISPRI
          INTO l_hisPriAux
          FROM R017TAP
         WHERE R017TAP.CODTAP = :NEW.CODTAP;
      EXCEPTION WHEN OTHERS THEN
        NULL;
      END;

      IF (l_hisPriAux = 'S') THEN
        IF (:NEW.STAHIS = 1) THEN
          BEGIN
            SELECT R034FUN.DATPOS INTO l_datpos
              FROM R034FUN
             WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                   R034FUN.NUMEMP = :NEW.NUMEMP AND
                   R034FUN.NUMCAD = :NEW.NUMCAD;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              RAISERROR 103 'Erro ao carregar dados do colaborador.';
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao carregar dados do colaborador.';
          END;

          IF ((:NEW.INIATU >= l_datpos) OR (l_datpos IS NULL)) THEN
            BEGIN
              UPDATE R034FUN
                 SET ESTPOS = :NEW.ESTPOS,
                     POSTRA = :NEW.POSTRA,
                     CODTAP = :NEW.CODTAP,
                     DATPOS = :NEW.INIATU
               WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                     R034FUN.NUMEMP = :NEW.NUMEMP AND
                     R034FUN.NUMCAD = :NEW.NUMCAD;
            EXCEPTION
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao atualizar dados do colaborador quando o histórico do posto é alterado.';
            END;
          END IF;
        END IF;
      END IF;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar R034FUN campos dos posto de trabalho.';
    END;

    /* ACESSO */	
	BEGIN
	    SELECT HISPRI INTO l_hisPri FROM R017TAP WHERE R017TAP.CODTAP = :NEW.CODTAP;
	EXCEPTION 
	    WHEN OTHERS THEN RAISERROR 103 'R038HPO_EU: Erro ao fazer a seleção na tabela R017TAP.';
    END;
	
	IF (l_hisPri = 'S') THEN
	    l_oriDef := 1;
	END IF;
	
	l_hispri := 'N';
	BEGIN
	    SELECT HISPRI INTO l_hisPri FROM R017TAP WHERE R017TAP.CODTAP = :OLD.CODTAP;
	EXCEPTION 
	    WHEN OTHERS THEN RAISERROR 103 'R038HPO_EU: Erro ao fazer a seleção na tabela R017TAP. 2';
    END;
	
	IF (l_hisPri = 'S') THEN
	    l_oldOriDef := 1;
	END IF;
	
    IF ((:OLD.NUMEMP <> :NEW.NUMEMP) OR (:OLD.POSTRA <> :NEW.POSTRA)) THEN
      /* Caso trabalho com postos de trabalho atualizamos o efetivo por posto do registro origem e destino */
      QL_UTIPOSTRA(:OLD.NUMEMP, :OLD.INIATU, l_xUtiPosOri OUT, l_xEstPosOri OUT, l_xCodPlvOri OUT);
      QL_UTIPOSTRA(:NEW.NUMEMP, :NEW.INIATU, l_xUtiPosDes OUT, l_xEstPosDes OUT, l_xCodPlvDes OUT);
	  
	  /* Verifica se o colaborador está indicado no módulo QL. */
	  QL_VERMODQL(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_xIndCon OUT);
	  IF (l_xIndCon <> 'N') THEN
        QL_POSTOAUT(l_xEstPosOri, :OLD.POSTRA, :OLD.INIATU, :OLD.CODTAP, l_xPosOriAut OUT);
	  END IF;
      IF (l_xUtiPosOri = 'S') AND (l_xPosOriAut = 'S') THEN
        QL_ATUEFEPOS('U', 'R038HPO', :OLD.NUMEMP, l_xEstPosOri, l_xCodPlvOri, :OLD.POSTRA, -1, :OLD.INIATU, 'N', 'N', 'N');
        QL_AJUQTDEFE('R038HPO', l_xEstPosOri, l_xCodPlvOri, :OLD.POSTRA, :OLD.INIATU, :OLD.TERATU, -1);
      END IF;
	  
	  /* Verifica se o colaborador está indicado no módulo QL. */
      QL_VERMODQL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_xIndCon OUT);
	  IF (l_xIndCon <> 'N') THEN
        QL_POSTOAUT(l_xEstPosDes, :NEW.POSTRA, :NEW.INIATU, :NEW.CODTAP, l_xPosDesAut OUT);
	  END IF;	
      IF (l_xUtiPosDes = 'S') AND (l_xPosDesAut = 'S') THEN
        QL_ATUEFEPOS('U', 'R038HPO', :NEW.NUMEMP, l_xEstPosDes, l_xCodPlvDes, :NEW.POSTRA, 1, :NEW.INIATU, 'N', 'N', 'N');
        QL_AJUQTDEFE('R038HPO', l_xEstPosDes, l_xCodPlvDes, :NEW.POSTRA, :NEW.INIATU, :NEW.TERATU, 1);
      END IF;
    END IF;	
  END IF;
	
	FOREACH c_r017PEP INTO l_r017PEP.CODPRM,
                           l_r017PEP.CODUSU,
                           l_r017PEP.OBSPRM							 
    LOOP
	    BEGIN
	        IF ((:OLD.ESTPOS <> :NEW.ESTPOS) OR (:OLD.POSTRA <> :NEW.POSTRA)) THEN
			    UPDATE R070PEC SET DATFIM = l_data_atual, HORFIM = l_hora_atual, CODUSU = :NEW.CODUSU WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATINI = :OLD.INIATU AND ORIDEF = l_oldOriDef;
				SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_r017PEP.CODPRM, l_oriDef);
                INSERT INTO R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM, ORIDEF)
                             VALUES ( :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, 0,  l_r017PEP.CODPRM, :NEW.TERATU, 1439,  :NEW.CODUSU, l_r017PEP.OBSPRM,  l_oriDef);
			END IF;
				
			IF (:OLD.OBSHPO <> :NEW.OBSHPO) THEN
			    UPDATE R070PEC SET OBSPRM = :NEW.OBSHPO, CODUSU = :NEW.CODUSU WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATINI = :OLD.INIATU AND ORIDEF = l_oldOriDef;
			END IF;
        EXCEPTION 
            WHEN OTHERS THEN RAISERROR 103 'R038HPO_EI: Erro ao atualizar a tabela R017PEC.';
        END;
    END LOOP;
	
	IF (l_oriDef = 2) THEN
		BEGIN
	        SELECT CODPRM INTO l_codprm FROM R017DAC WHERE ESTPOS = :NEW.ESTPOS AND POSTRA = :NEW.POSTRA;
		EXCEPTION 
		    WHEN NO_DATA_FOUND THEN l_codprm := 0;
		END;
		IF (l_codprm <> 0) THEN
		    BEGIN
		        SELECT CODPRM INTO l_codprmAux FROM R070PEC WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD AND CODPRM = l_codprm AND DATINI < l_data_atual AND (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual)) AND ORIDEF = 2;
			EXCEPTION 
			    WHEN NO_DATA_FOUND THEN l_codprmAux := 0;
			END;
			IF (l_codprmAux = 0) THEN
			    SP_ConsBI_R017PEC(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, l_codprm, l_oriDef);
		        INSERT INTO R070PEC (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI, CODPRM, DATFIM, HORFIM, CODUSU, OBSPRM,  ORIDEF)
                             VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, 0,  l_codprm, :NEW.TERATU, 1439,  :NEW.CODUSU, l_r017PEP.OBSPRM,  l_oriDef);
			END IF;
		END IF;
	END IF;
	
	BEGIN
		INSERT INTO R038HPO_AUX (NUMEMP, TIPCOL, NUMCAD, INIATU, SEQHIS, CODTAP, MOTALT, ESTPOS, POSTRA, TERATU, CODUSU)
										 VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.SEQHIS, :NEW.CODTAP,
														 :NEW.MOTALT, :NEW.ESTPOS, :NEW.POSTRA, :NEW.TERATU, :NEW.CODUSU);
	EXCEPTION WHEN OTHERS THEN
		RAISERROR 103 'Erro ao inserir registro na tabela R038HPO_AUX.';
	END;
	
	/* Atualizar definicoes de acesso e permissoes por local fisico/dispositivo. Verifico o status do histórico. */
	/* Se tinha um histórico presente e ficou passado, devo retirar as definições de acesso e permissões por local físico/disp. */
	/* Se tinha um histórico futuro e ficou presente, devo incluir as definições de acesso e permissões por local físico/disp. */
    IF  (:NEW.STAHIS = 1) AND (:OLD.STAHIS = 0) THEN /* de futuro para presente */
        SP_GesPer('I', :NEW.ESTPOS, :NEW.POSTRA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, l_oriDef);
    END IF;
    IF  (:NEW.STAHIS = 2) AND (:OLD.STAHIS = 1) THEN /* de presente para passado */
        SP_GesPer('D', :NEW.ESTPOS, :NEW.POSTRA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, l_oriDef);
    END IF;
		
		BEGIN
			DELETE FROM R038HPO_AUX ;
		EXCEPTION WHEN OTHERS THEN
			RAISERROR 103 'Erro ao deletar registro na tabela R038HPO_AUX.';
		END;
  
	/* Início eSocial */
	IF ((:NEW.FUNESO = 'S') OR (:OLD.FUNESO = 'S')) THEN
		l_Alterou := FALSE;
		l_AlterouSomenteDataFim := FALSE;
		l_JsonCamposAlterados := '';

		SP_VALUPDATE_NUM(:OLD.ESTPOS, :NEW.ESTPOS, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_NUM_JSON('ESTPOS', :NEW.EstPos, :OLD.EstPos, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DES(:OLD.POSTRA, :NEW.POSTRA, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('POSTRA', :NEW.PosTra, :OLD.PosTra, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_DES(:OLD.FUNESO, :NEW.FUNESO, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_DES_JSON('FUNESO', :NEW.FunEso, :OLD.FunEso, l_JsonCamposAlterados OUT);
		END IF;
	
		SP_VALUPDATE_DAT(:OLD.TERATU, :NEW.TERATU, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			IF (l_Alterou = FALSE) THEN
				l_AlterouSomenteDataFim := TRUE;
			END IF;
			l_Alterou := TRUE;
			SP_CONCAT_DAT_JSON('TERATU', :NEW.TerAtu, :OLD.TerAtu, l_JsonCamposAlterados OUT);	
		END IF;	

		IF (l_AlterouSomenteDataFim = TRUE) THEN
			l_HistoriaPrincipal := ' ';
			SP_RETR017TAP(:NEW.CODTAP, l_HistoriaPrincipal OUT);
 			IF (l_HistoriaPrincipal = 'S') THEN
		 		l_Alterou := FALSE;
			END IF;
		END IF;

		IF (l_Alterou = TRUE) THEN 
			RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);
			IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
				SP_ALT_TAB_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.INIATU, :NEW.TERATU, :OLD.TERATU, 'R038HPO', '', l_JsonCamposAlterados, l_AlterouSomenteDataFim, 'INIATU', ' AND FUNESO = ''S''', 0, 'R038HPO_EU');
			END IF;	
		END IF;
	END IF;
	/* Fim eSocial */
  
	/* Início S-2240 */
	RH_RET_DATINISST(:NEW.NumEmp, l_DatIniSST OUT);
	IF (l_DatIniSST > l_DataZero) THEN
		IF (:NEW.TerAtu > l_DatIniSST OR :NEW.TerAtu = l_DataZero OR :OLD.TerAtu > l_DatIniSST OR :OLD.TerAtu = l_DataZero) THEN  	  	
			l_AlterouPosto := FALSE;
			l_AlterouDataTermino := FALSE;
	
			SP_VALUPDATE_NUM(:OLD.EstPos, :NEW.EstPos, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouPosto := TRUE;
			END IF;
	
			SP_VALUPDATE_DES(:OLD.PosTra, :NEW.PosTra, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouPosto := TRUE;
			END IF;
		
			SP_VALUPDATE_DAT(:OLD.TerAtu, :NEW.TerAtu, l_Valido OUT);
			IF (l_Valido = TRUE) THEN
				l_AlterouDataTermino := TRUE;
			END IF;
			
			IF (l_AlterouPosto = TRUE) THEN
				l_DataInicio := :NEW.IniAtu;
				IF (l_DataInicio < l_DatIniSST) THEN
	  				l_DataInicio := l_DatIniSST;
	  			END IF;
	  			
	  			IF (:OLD.TerAtu < :NEW.TerAtu) THEN
	  				l_DataTermino := :OLD.TerAtu;
	  			ELSE
	  				l_DataTermino := :NEW.TerAtu;
	  			END IF;
	  			
				SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
			END IF;
			
			IF (l_AlterouDataTermino = TRUE) THEN
				IF (:OLD.TerAtu > l_DataZero AND :NEW.TerAtu > l_DataZero) THEN
					IF (:NEW.TerAtu > :OLD.TerAtu) THEN
						l_DataInicio := DATETIMEADD(DD, 1, :OLD.TerAtu);
						l_DataTermino := :NEW.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
						
						IF (:NEW.TerAtu < l_DataMax) THEN
							l_DataAux := DATETIMEADD(DD, 1, :NEW.TerAtu);
							SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataAux, l_DataAux, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataAux, 0, 'R038HPO_EU');
						END IF;
					ELSE
						l_DataInicio := DATETIMEADD(DD, 1, :NEW.TerAtu);
						l_DataTermino := :OLD.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
					END IF;
				ELSE
					IF (:OLD.TerAtu = l_DataZero AND :NEW.TerAtu > l_DataZero AND :NEW.TerAtu < l_DataMax) THEN
						l_DataInicio := DATETIMEADD(DD, 1, :NEW.TerAtu);
						l_DataTermino := :OLD.TerAtu;
						SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
					ELSE
						IF (:NEW.TerAtu = l_DataZero AND :OLD.TerAtu > l_DataZero  AND :OLD.TerAtu < l_DataMax) THEN
							l_DataInicio := DATETIMEADD(DD, 1, :OLD.TerAtu);
							l_DataTermino := :NEW.TerAtu;
							SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'A', l_DataInicio, l_DataTermino, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_DataInicio, 0, 'R038HPO_EU');
						END IF;
					END IF;
				END IF;
			END IF;
		END IF;
	END IF;
	/* Fim S-2240 */
	
	RH_ALTHIEPOS();
END␀Õ␀␀	SENIOR;0µ␀␀

TRIGGER R038HPO_SD AFTER DELETE ON R038HPO

DECLARE
/* CURSOR c/ os registros gravados na tabela R038HPO_AUX */
  CURSOR c_r038hpo_del IS
         SELECT R038HPO_AUX.NUMEMP, R038HPO_AUX.TIPCOL, R038HPO_AUX.NUMCAD, R038HPO_AUX.INIATU, R038HPO_AUX.SEQHIS, R038HPO_AUX.CODTAP,
                R038HPO_AUX.MOTALT, R038HPO_AUX.ESTPOS, R038HPO_AUX.POSTRA, R038HPO_AUX.TERATU, R017TAP.HISPRI
				   FROM R038HPO_AUX, R017TAP
				  WHERE R038HPO_AUX.CODTAP = R017TAP.CODTAP;

  TYPE t_r038hpo_aux IS RECORD(
    NUMEMP   R038HPO_AUX.NUMEMP%TYPE,
    TIPCOL   R038HPO_AUX.TIPCOL%TYPE,
    NUMCAD   R038HPO_AUX.NUMCAD%TYPE,
    INIATU   R038HPO_AUX.INIATU%TYPE,
    SEQHIS   R038HPO_AUX.SEQHIS%TYPE,
    CODTAP   R038HPO_AUX.CODTAP%TYPE,
    MOTALT   R038HPO_AUX.MOTALT%TYPE,
    ESTPOS   R038HPO_AUX.ESTPOS%TYPE,
    POSTRA   R038HPO_AUX.POSTRA%TYPE,
    TERATU   R038HPO_AUX.TERATU%TYPE,
    HISPRI   R017TAP.HISPRI%TYPE);

  l_r038hpo_aux t_r038hpo_aux;
  l_datTerAnt2 DATE;
  l_seqHis   R038HPO_AUX.SEQHIS%TYPE;
  l_estPos   R038HPO_AUX.ESTPOS%TYPE;
  l_postra   R038HPO_AUX.POSTRA%TYPE;
  l_codTap   R038HPO_AUX.CODTAP%TYPE;
  l_datPos DATE;
  l_datAux DATE;
  l_isInformix BOOLEAN;
  l_xUtiPos CHAR;
  l_xEstPos NUMBER(3);
  l_xCodPlv NUMBER(4);
  l_xDatPrimFil DATE; 
BEGIN
  RH_ISINFORMIX(l_isInformix OUT);
  /* No informix, a trigger não pode atualizar o próprio registro */
  IF (l_isInformix = FALSE) THEN
    /* Le Registro do CURSOR */
    FOREACH c_r038hpo_del INTO l_r038hpo_aux.NUMEMP,
                               l_r038hpo_aux.TIPCOL,
                               l_r038hpo_aux.NUMCAD,
                               l_r038hpo_aux.INIATU,
                               l_r038hpo_aux.SEQHIS,
                               l_r038hpo_aux.CODTAP,
                               l_r038hpo_aux.MOTALT,
                               l_r038hpo_aux.ESTPOS,
                               l_r038hpo_aux.POSTRA,
                               l_r038hpo_aux.TERATU,
                               l_r038hpo_aux.HISPRI

    LOOP
      IF (UPPER(l_r038hpo_aux.HISPRI) = 'S') THEN
        BEGIN
          SELECT MAX(R038HPO.INIATU)
            INTO l_datTerAnt2
            FROM R038HPO, R017TAP
           WHERE R038HPO.CODTAP = R017TAP.CODTAP
             AND R017TAP.HISPRI = 'S'
             AND R038HPO.NUMEMP = l_r038hpo_aux.NUMEMP
             AND R038HPO.TIPCOL = l_r038hpo_aux.TIPCOL
             AND R038HPO.NUMCAD = l_r038hpo_aux.NUMCAD
             AND R038HPO.INIATU < l_r038hpo_aux.INIATU;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_datTerAnt2 := NULL;
          WHEN OTHERS THEN
            NULL;
        END;

        BEGIN
          SELECT DATPOS
            INTO l_datPos
            FROM R034FUN
           WHERE NUMEMP = l_r038hpo_aux.NUMEMP
             AND TIPCOL = l_r038hpo_aux.TIPCOL
             AND NUMCAD = l_r038hpo_aux.NUMCAD;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            RAISERROR 103 'Erro ao carregar dados do colaborador.';
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao carregar dados do colaborador.';
        END;

        IF (l_datTerAnt2 IS NOT NULL) THEN
          BEGIN
            SELECT R038HPO.SEQHIS, R038HPO.INIATU, R038HPO.POSTRA, R038HPO.ESTPOS, R038HPO.CODTAP
              INTO l_seqHis, l_datAux, l_postra, l_estPos, l_codTap
              FROM R038HPO, R017TAP
             WHERE R038HPO.NUMEMP = l_r038hpo_aux.NUMEMP
               AND R038HPO.TIPCOL = l_r038hpo_aux.TIPCOL
               AND R038HPO.NUMCAD = l_r038hpo_aux.NUMCAD
               AND R038HPO.INIATU = l_datTerAnt2
               AND R038HPO.CODTAP = R017TAP.CODTAP
               AND R017TAP.HISPRI = 'S';
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao buscar histórico de posto titular anterior.';
          END;
          BEGIN
            UPDATE R038HPO
               SET TERATU = l_r038hpo_aux.TERATU
             WHERE R038HPO.NUMEMP = l_r038hpo_aux.NUMEMP
               AND R038HPO.TIPCOL = l_r038hpo_aux.TIPCOL
               AND R038HPO.NUMCAD = l_r038hpo_aux.NUMCAD
               AND R038HPO.SEQHIS = l_seqHis
               AND R038HPO.INIATU = l_datTerAnt2;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar histórico de posto titular anterior.';
          END;

          IF (l_r038hpo_aux.INIATU = l_datPos) THEN
            BEGIN
              UPDATE R034FUN
                 SET ESTPOS = l_estPos,
                     POSTRA = l_postra,
                     CODTAP = l_codTap,
                     DATPOS = l_datAux
               WHERE R034FUN.TIPCOL = l_r038hpo_aux.TIPCOL AND
                     R034FUN.NUMEMP = l_r038hpo_aux.NUMEMP AND
                     R034FUN.NUMCAD = l_r038hpo_aux.NUMCAD;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar R034FUN campos dos posto.';
            END;
          END IF;
        ELSE
          BEGIN
            UPDATE R034FUN
               SET ESTPOS = 0,
                   POSTRA = '',
                   CODTAP = 0,
                   DATPOS = DATETIME(31,12,1900,0,0,0)
             WHERE R034FUN.TIPCOL = l_r038hpo_aux.TIPCOL AND
                   R034FUN.NUMEMP = l_r038hpo_aux.NUMEMP AND
                   R034FUN.NUMCAD = l_r038hpo_aux.NUMCAD;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R034FUN campos dos posto de trabalho.';
          END;
        END IF;
      END IF;

      /* Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
      QL_UTIPOSTRA(l_r038hpo_aux.NUMEMP, l_r038hpo_aux.INIATU, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
      
      SELECT MIN(DATALT)
	  INTO	 l_xDatPrimFil
	  FROM	 R038HFI
	  WHERE	 NUMEMP = l_r038hpo_aux.NUMEMP
	  AND	 TIPCOL = l_r038hpo_aux.TIPCOL
	  AND	 NUMCAD = l_r038hpo_aux.NUMCAD;
      
      IF ((l_xUtiPos = 'S') AND ((l_r038hpo_aux.INIATU >= l_xDatPrimFil) OR (l_xDatPrimFil IS NULL))) THEN
        QL_PROCEHPO('D', l_r038hpo_aux.NUMEMP, l_r038hpo_aux.TIPCOL, l_r038hpo_aux.NUMCAD, l_xEstPos, l_xCodPlv, l_r038hpo_aux.POSTRA, l_r038hpo_aux.INIATU, l_r038hpo_aux.TERATU, l_r038hpo_aux.HISPRI, l_r038hpo_aux.CODTAP);
      END IF;
    END LOOP;

    /* Apaga Registro OLD da R038HPO_AUX */
    BEGIN
      DELETE FROM R038HPO_AUX;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao excluir registros da tabela R038HPO_AUX.';
    END;
  END IF;
END␀	Õ␀␀		SENIOR;05␀␀

TRIGGER R038HPO_ED AFTER DELETE ON R038HPO FOR EACH ROW
DECLARE
	l_isInformix BOOLEAN;
	l_layoutAlteracaoContrato VARCHAR2(6);
	l_DataZero DATE;
	l_IniHis DATE;
	l_TerHis DATE;
	l_DatIniSST DATE;
BEGIN
  RH_ISINFORMIX(l_isInformix OUT);
  /* No informix, a trigger não pode atualizar o próprio registro */
  IF (l_isInformix = FALSE) THEN
    BEGIN
      /* Insere Registro Old */
      INSERT INTO R038HPO_AUX (NUMEMP, TIPCOL, NUMCAD, INIATU, SEQHIS, CODTAP, MOTALT, ESTPOS, POSTRA, TERATU)
                       VALUES (:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.INIATU, :OLD.SEQHIS, :OLD.CODTAP,
                               :OLD.MOTALT, :OLD.ESTPOS, :OLD.POSTRA, :OLD.TERATU);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao inserir registro old na tabela R038HPO_AUX.';
    END;
  END IF;

  /* Início eSocial */
  IF (:OLD.FUNESO = 'S') THEN
	RH_LAY_CONTR_COLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layoutAlteracaoContrato OUT);
	IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
	  SP_TAB_ESOCIAL(l_layoutAlteracaoContrato, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.INIATU, :OLD.TERATU, 'R038HPO', 'E', '', '', 0, 'R038HPO_ED');
	END IF;	  
  END IF;
  /* Fim eSocial */
  
  /* Início S-2240 */
  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  
  l_IniHis := :OLD.IniAtu;
  l_TerHis := :OLD.TerAtu;
  
  RH_RET_DATINISST(:OLD.NumEmp, l_DatIniSST OUT);
  IF (l_DatIniSST > l_DataZero) THEN
    IF (l_TerHis > l_DatIniSST OR l_TerHis = l_DataZero) THEN
  	  IF (l_IniHis < l_DatIniSST) THEN
  	    l_IniHis := l_DatIniSST;
  	  END IF;
  	
      SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'E', l_IniHis, l_TerHis, :OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, '', '', 0, NULL, l_IniHis, 0, 'R038HPO_ED');
    END IF;
  END IF;
  /* Fim S-2240 */
 	
  RH_ALTHIEPOS(); 	
END		SENIOR;20u␀␀

TRIGGER R038HPO_ED AFTER DELETE ON R038HPO FOR EACH ROW
DECLARE
	l_isInformix BOOLEAN;
	l_layoutAlteracaoContrato VARCHAR2(6);
	l_DataZero DATE;
	l_IniHis DATE;
	l_TerHis DATE;
	l_DatIniSST DATE;

    /* ACESSO */
    l_data_atual  DATE;
    l_hora_atual  NUMBER(4);
    l_oriDef NUMBER(1);
    l_hisPriAux  CHAR(1);
BEGIN

  RH_ISINFORMIX(l_isInformix OUT);
  /* No informix, a trigger não pode atualizar o próprio registro */
  IF (l_isInformix = FALSE) THEN
    BEGIN
      /* Insere Registro Old */
      INSERT INTO R038HPO_AUX (NUMEMP, TIPCOL, NUMCAD, INIATU, SEQHIS, CODTAP, MOTALT, ESTPOS, POSTRA, TERATU)
                       VALUES (:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.INIATU, :OLD.SEQHIS, :OLD.CODTAP,
                               :OLD.MOTALT, :OLD.ESTPOS, :OLD.POSTRA, :OLD.TERATU);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao inserir registro old na tabela R038HPO_AUX.';
    END;
  END IF;
    
  /* ACESSO */
  l_oriDef := 2;
  BEGIN
      SELECT HISPRI INTO l_hisPriAux FROM R017TAP WHERE R017TAP.CODTAP = :OLD.CODTAP;
  EXCEPTION 
      WHEN OTHERS THEN RAISERROR 103 'R038HPO_EI: Erro ao fazer a seleção na tabela R017TAP.';
  END;
  
  IF (l_hisPriAux   = 'S') THEN
	  l_oriDef := 1;
  END IF;
	
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  DELETE FROM R070PEC WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATINI = :OLD.INIATU;
	
  IF (l_isInformix = TRUE) THEN
		BEGIN
			INSERT INTO R038HPO_AUX (NUMEMP, TIPCOL, NUMCAD, INIATU, SEQHIS, CODTAP, MOTALT, ESTPOS, POSTRA, TERATU, CODUSU)
											 VALUES (:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.INIATU, :OLD.SEQHIS, :OLD.CODTAP,
															 :OLD.MOTALT, :OLD.ESTPOS, :OLD.POSTRA, :OLD.TERATU, :OLD.CODUSU);
		EXCEPTION WHEN OTHERS THEN
			RAISERROR 103 'Erro ao inserir registro na tabela R038HPO_AUX.';
		END;
	END IF;
	
  /* Em um delete, removo as definições de acesso e permissões por local físico. */
  SP_GesPer('D', :OLD.ESTPOS, :OLD.POSTRA, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.INIATU, :OLD.TERATU, l_oriDef);
	
	
  /* Início eSocial */
  IF (:OLD.FUNESO = 'S') THEN
	RH_LAY_CONTR_COLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layoutAlteracaoContrato OUT);
	IF (l_layoutAlteracaoContrato IS NOT NULL) THEN
	  SP_TAB_ESOCIAL(l_layoutAlteracaoContrato, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.INIATU, :OLD.TERATU, 'R038HPO', 'E', '', '', 0, 'R038HPO_ED');
	END IF;	  
  END IF;
  /* Fim eSocial */
  
  /* Início S-2240 */
  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  
  l_IniHis := :OLD.IniAtu;
  l_TerHis := :OLD.TerAtu;
  
  RH_RET_DATINISST(:OLD.NumEmp, l_DatIniSST OUT);
  IF (l_DatIniSST > l_DataZero) THEN
    IF (l_TerHis > l_DatIniSST OR l_TerHis = l_DataZero) THEN
  	  IF (l_IniHis < l_DatIniSST) THEN
  	    l_IniHis := l_DatIniSST;
  	  END IF;
  	
      SP_E_SOCIAL_SM('S-2240', 'R038HPO', 'N', 'E', l_IniHis, l_TerHis, :OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, '', '', 0, NULL, l_IniHis, 0, 'R038HPO_ED');
    END IF;
  END IF;
  /* Fim S-2240 */
 	
  RH_ALTHIEPOS(); 		
END		SENIOR;21u␀␀

