l'␀␀/*Tipo de operação: 1/3 - Altera apenas o número físico/serial (do crachá principal),
                      2 - Altera o icard (do crachá principal),
                      4 - Alteração dos Icards na controle que não são principais
                      5 - Deleta o Icard
                      6 - Atualizar ICARD se utilizado SmartCard
                      7 - Atualizar CONTPLANTA quando alterado o código de barras*/
PROCEDURE SP_CHCTSI(P_TIPOPE NUMBER(1),P_NUMCRA NUMBER(12),P_OLDCRA NUMBER(12),P_NUMSER NUMBER(12),P_OLDSER NUMBER(12))
 IS

l_numcra          CHAR(12);
  l_oldcra          CHAR(12);
  l_numser          CHAR(10);
  l_oldser          CHAR(10);
  l_comando         CHAR(2048);
  l_pndgrp          CHAR(1);
  l_matgrp          CHAR(1);
  l_matcod          CHAR(1);
  l_sertsi          CHAR(1);
  l_digsag          CHAR(1);
  l_utirep          CHAR(1);
  l_numserial       CHAR(10);
  l_usutel          VARCHAR(31);
  l_cntdigtsi       BOOLEAN;
  l_chcass			CHAR(1);
  l_chcace          NUMBER(1);
  l_cntPlt          CHAR(1);

BEGIN
  SP_USUTEL(l_usutel OUT);
  /*Verifica se possui a tabela Pend_Grupo*/
  BEGIN
      SELECT PNDGRP, MATGRP, NUMSER, DIGSAG, UTIREP, MATCOD, CNTPLT INTO l_pndgrp, l_matgrp, l_sertsi, l_digsag, l_utirep, l_matcod, l_cntPlt FROM R070TSI;
  EXCEPTION
    WHEN OTHERS THEN
      l_pndgrp := 'N';
      l_matgrp := 'N';
      l_sertsi := 'N';
      l_digsag := 'N';
      l_utirep := 'N';
  END;

  /*Inicialização de Variáveis*/
  SP_INTSTR(p_numcra,'999999999999',l_numcra OUT);
  SP_INTSTR(p_oldcra,'999999999999',l_oldcra OUT);
  SP_INTSTR(p_numser,'9999999999',l_numser OUT);
  SP_INTSTR(p_oldser,'9999999999',l_oldser OUT);

	BEGIN
  		SELECT CHCASS INTO l_chcass FROM R070DAC;
 	EXCEPTION
    	WHEN OTHERS THEN
      	  l_chcass := 'N';
  	END;

    BEGIN
        SELECT CHCACE INTO l_chcACe FROM R070TSI;
    EXCEPTION
        WHEN OTHERS THEN
            l_chcAce := 0;
    END;
  /*Atualização tabela pend_grupo*/
  IF (l_pndgrp = 'S') THEN
      BEGIN
          /*Se o tipo de operação for igual a 1, atualiza apenas o número serial*/
          IF (p_tipope = 1) THEN
              l_comando := 'DELETE '||l_usutel||'PEND_GRUPO WHERE NUMSERIAL = '''||l_numser||'''';
              SP_CMDTSI(l_comando);
              l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET NUMSERIAL = '''||l_numser||''' WHERE NUMSERIAL = '''||l_oldser||'''';
              SP_CMDTSI(l_comando);
          ELSIF (p_tipope = 2 OR p_tipope = 6) THEN
          	  IF(l_chcass <> 'D' OR l_chcAce = 3) THEN
	                /*atualiza o icard*/
              	    l_comando := 'DELETE '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              	    SP_CMDTSI(l_comando);
              		l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET ICARD = '''||l_numcra||''' WHERE ICARD = '''||l_oldcra||'''';
              		SP_CMDTSI(l_comando);
              END IF;
          ELSIF (p_tipope = 3) THEN
              /*Deleta o NUMSERIAL antes de realizar o update*/
              l_comando := 'DELETE '||l_usutel||'PEND_GRUPO WHERE NUMSERIAL = '''||l_numser||'''';
              SP_CMDTSI(l_comando);
              /*Atualiza o Numserial a partir do icard*/
              l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET NUMSERIAL = '''||l_numser||''' WHERE ICARD = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
          END IF;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SPCHCTSI: Erro no update da pend_grupo. ';
      END;
  END IF;

  /*Atualização tabela MATGRUPO*/
  IF (l_matgrp = 'S') THEN
      BEGIN
          IF (p_tipope = 4) OR ((p_tipope = 2 OR p_tipope = 6) AND ((l_chcass <> 'D') OR (l_chcAce = 3))) THEN
	              /*atualiza o icard*/
	              l_comando := 'DELETE FROM '||l_usutel||'MATGRUPO WHERE ICARD = '''||l_numcra||'''';
	              SP_CMDTSI(l_comando);
	              l_comando := 'UPDATE '||l_usutel||'MATGRUPO SET ICARD = '''||l_numcra||''' WHERE ICARD = '''||l_oldcra||'''';
	              SP_CMDTSI(l_comando);
          ELSIF (p_tipope = 5) THEN
              /*atualiza o icard*/
              l_comando := 'DELETE FROM '||l_usutel||'MATGRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
          END IF;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SPCHCTSI: Erro no update da matgrupo. ';
      END;
  END IF;

  /*Atualização tabela MATCODIN*/
  IF (l_matcod = 'S') THEN
      BEGIN
         IF (p_tipope = 4) OR ((p_tipope = 2 OR p_tipope = 6) AND ((l_chcass <> 'D') OR (l_chcAce = 3))) THEN
	              /*atualiza o icard*/
	              l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD = '''||l_numcra||'''';
	              SP_CMDTSI(l_comando);
	              l_comando := 'UPDATE '||l_usutel||'MATCODIN SET ICARD = '''||l_numcra||''' WHERE ICARD = '''||l_oldcra||'''';
	              SP_CMDTSI(l_comando);
          ELSIF (p_tipope = 5) THEN
              /*atualiza o icard*/
              l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
          END IF;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SPCHCTSI: Erro no update da matcodin. ';
      END;
  END IF;

  /*Atualização tabela CONTDIG_SAGEM*/
  IF (l_digsag = 'S') THEN
      BEGIN
         IF (p_tipope = 4) OR ((p_tipope = 2 OR (p_tipope = 6)) AND ((l_chcass <> 'D') OR (l_chcAce = 3))) THEN
	              /*atualiza o icard*/
	              l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_SAGEM WHERE ICARD = '''||l_numcra||'''';
	              SP_CMDTSI(l_comando);
	              l_comando := 'UPDATE '||l_usutel||'CONTDIG_SAGEM SET ICARD = '''||l_numcra||''' WHERE ICARD = '''||l_oldcra||'''';
	              SP_CMDTSI(l_comando);
          ELSIF (p_tipope = 5) THEN
              /*atualiza o icard*/
              l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_SAGEM WHERE ICARD = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
          END IF;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SPCHCTSI: Erro no update da CONTDIG_SAGEM. ';
      END;
  END IF;

  SP_EXITELTAB('CONTDIG_TSI1', l_cntdigtsi OUT);

  /*Atualização tabela CONTDIG_TSI1*/
  IF (l_cntdigtsi = TRUE) THEN
      BEGIN
         IF ((p_tipope = 4) OR ((p_tipope = 2 OR p_tipope = 6 AND ((l_chcass <> 'D') OR (l_chcAce = 3))))) THEN
	              /*atualiza o icard*/
	              l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_TSI1 WHERE ICARD = '''||l_numcra||'''';
	              SP_CMDTSI(l_comando);
	              l_comando := 'UPDATE '||l_usutel||'CONTDIG_TSI1 SET ICARD = '''||l_numcra||''' WHERE ICARD = '''||l_oldcra||'''';
	              SP_CMDTSI(l_comando);
          ELSIF (p_tipope = 5) THEN
              /*atualiza o icard*/
              l_comando := 'DELETE FROM '||l_usutel||'CONTDIG_TSI1 WHERE ICARD = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
          END IF;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SPCHCTSI: Erro no update da CONTDIG_TSI1. ';
      END;
  END IF;

  /*Atualização tabela REPEMPR002*/
  IF (l_utirep = 'S') THEN
      BEGIN
          IF ((p_tipope = 2) OR (p_tipope = 4)) THEN
              /*atualiza o icard*/
              l_comando := 'DELETE FROM '||l_usutel||'REPEMPR002 WHERE IFUNC = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
              l_comando := 'UPDATE '||l_usutel||'REPEMPR002 SET IFUNC = '''||l_numcra||''' WHERE IFUNC = '''||l_oldcra||'''';
              SP_CMDTSI(l_comando);

              /*Salva na tabela R058LTP*/
              SP_R058LTP(l_numcra);
          ELSIF ((p_tipope = 5) OR (p_tipope = 6)) THEN
              /*atualiza o icard*/
              l_comando := 'DELETE FROM '||l_usutel||'REPEMPR002 WHERE IFUNC = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
          END IF;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SPCHCTSI: Erro no update da REPEMPR002. ';
      END;
  END IF;

  /*Atualização do campo NUMSERIAL da CONTROLE*/
  IF (l_sertsi = 'S') THEN
      BEGIN
          IF ((p_tipope = 1) OR (p_tipope = 3)) THEN
              /*atualiza o icard*/
              IF (l_chcAce =3) THEN
                l_numserial := '0000000000';
                l_comando := 'UPDATE '||l_usutel||'CONTROLE SET NUMSERIAL = '''||l_numserial||''' WHERE NUMSERIAL = '''||l_numser||'''';
                SP_CMDTSI(l_comando);
                l_comando := 'UPDATE '||l_usutel||'CONTROLE SET NUMSERIAL = '''||l_numser||''' WHERE NUMSERIAL = '''||l_oldser||'''';
                SP_CMDTSI(l_comando);
              ELSE
                l_numserial := '0000000000';
                l_comando := 'UPDATE '||l_usutel||'CONTROLE SET NUMSERIAL = '''||l_numserial||''' WHERE NUMSERIAL = '''||l_numser||'''';
                SP_CMDTSI(l_comando);
                l_comando := 'UPDATE '||l_usutel||'CONTROLE SET NUMSERIAL = '''||l_numser||''' WHERE ICARD = '''||l_numcra||''' AND NUMSERIAL = '''||l_oldser||'''';
                SP_CMDTSI(l_comando);
              END IF;
          ELSIF (p_tipope = 6) THEN
              l_comando := 'DELETE FROM '||l_usutel||'CONTROLE WHERE ICARD = '''||l_numcra||'''';
              SP_CMDTSI(l_comando);
              l_comando := 'UPDATE '||l_usutel||'CONTROLE SET ICARD = '''||l_numcra||''' WHERE ICARD = '''||l_oldcra||'''';
              SP_CMDTSI(l_comando);
          END IF;
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SPCHCTSI: Erro no update do NUMSERIAL controle. ';
      END;
  END IF;

  IF (l_cntPlt = 'S') THEN
    l_comando := 'DELETE FROM '||l_usutel||'CONTPLANTA WHERE ICARD = '''||l_numcra||'''';
    SP_CMDTSI(l_comando);
    l_comando := 'UPDATE '||l_usutel||'CONTPLANTA SET ICARD = '''||l_numcra||''' WHERE ICARD = '''||l_oldcra||'''';
    SP_CMDTSI(l_comando);
  END IF;
END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ö␀␀PROCEDURE SP_CHECKDSP_PEND82(P_SEND OUT NUMBER(1))
 IS

  L_AUX NUMBER(10);
BEGIN
  P_SEND := 0;

  L_AUX := 0;
  BEGIN
    SELECT COUNT(B.CODDSP) INTO L_AUX
    FROM R058LEC A, R058RLG B, R058DSP C
    WHERE A.CODRLG = B.CODRLG AND A.CODPLT = B.CODPLT AND
          B.COMRLG = 2 AND A.CODDSP = C.CODDSP AND C.STADSP = 1 AND
          A.CODTBI IN (SELECT CODTBI FROM R058BIO WHERE TIPBIO = 5);
  EXCEPTION
  WHEN OTHERS THEN
    L_AUX := 0;
  END;

  IF (L_AUX >= 1) THEN
    P_SEND := 1;
  END IF;
END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
