TRIGGER R034FUN_SI AFTER INSERT ON R034FUN

DECLARE
/* C_R034FUN_AUX_INS para C_R034FUN_AUXi limitação informix       */
  /*CURSOR para buscar código de pessoa armazendo na tabela auxiliar*/
  CURSOR C_R034FUN_AUXi IS
  SELECT NUMEMP,TIPCOL,NUMCAD,CODPES FROM R034FUN_AUX;
  TYPE T_R034FUN_AUX IS RECORD(
    NUMEMP   R034FUN_AUX.NUMEMP%TYPE,
    TIPCOL   R034FUN_AUX.TIPCOL%TYPE,
    NUMCAD   R034FUN_AUX.NUMCAD%TYPE,
    CODPES   R034FUN_AUX.CODPES%TYPE);
  L_R034FUN_AUX T_R034FUN_AUX;
BEGIN
  FOREACH C_R034FUN_AUXi INTO  L_R034FUN_AUX.NUMEMP,
                              L_R034FUN_AUX.TIPCOL,
                              L_R034FUN_AUX.NUMCAD,
                              L_R034FUN_AUX.CODPES
  LOOP
    BEGIN
      /*atualizar a R034FUN com o código da pessoa gerada*/
      UPDATE R034FUN SET CODPES = L_R034FUN_AUX.CODPES
      WHERE NUMEMP = L_R034FUN_AUX.NUMEMP
        AND TIPCOL = L_R034FUN_AUX.TIPCOL
        AND NUMCAD = L_R034FUN_AUX.NUMCAD;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao atualizar R034FUN';
    END;
  END LOOP;

  BEGIN
    /*limpar tabela auxiliar*/
    DELETE FROM R034FUN_AUX;
    DROP_TEMP_TABLE R034FUN_AUX;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao excluir registros da tabela R034FUN_AUX';
  END;
END␀‚Ó␀␀		SENIOR;0ÊÊ␀␀

TRIGGER R034FUN_EI BEFORE INSERT ON R034FUN FOR EACH ROW

DECLARE
  l_codmod       NUMBER(2);
  l_strerr       VARCHAR2(255);
  l_DATCTL       DATE;
  l_HORCTL         R034CTL.HORCTL%TYPE;
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);

/* CURSOR com os registros gravados no R000DFM. */
  CURSOR c_r000dfm IS
  SELECT CODMOD
    FROM R000DFM
   WHERE INDCON = 'N' AND TIPCOL = :NEW.TIPCOL;

  /*Declarações de Variáveis/CURSOR Sincronização de Pessoas*/
  l_UltPes        R033PES.CODPES%TYPE;
  l_CodPes        R033PES.CODPES%TYPE;
  l_CodPesAux     R033PES.CODPES%TYPE;
  l_CriPes        R034TRI.CRIPES%TYPE;
  l_CriarPessoa   R034TRI.CRIPES%TYPE;
  l_DatAtu        R033PES.DATALT%TYPE;
  l_HorAtu        R033PES.HORALT%TYPE;
  l_HabPes        R000ASS.HABPES%TYPE;
  l_VinPes        R000ASS.VINPES%TYPE;
  l_VinPe2        R030EMP.VINPE2%TYPE;
  l_VinPe3        R030EMP.VINPE3%TYPE;
  l_data_zero   DATE;

  l_HisCon      R030EMP.HISCON%TYPE;
  l_Existe    BOOLEAN;
  L_ULTSEQCON   R033CON.SEQCON%TYPE;
  L_SEQCON      R033CON.SEQCON%TYPE;
  L_DATALT      R033CON.DATALT%TYPE;
  L_CODBAN      R033CON.CODBAN%TYPE;
  L_CODAGE      R033CON.CODAGE%TYPE;
  L_TIPBAN      R033CON.TIPBAN%TYPE;
  L_CONBAN      R033CON.CONBAN%TYPE;
  L_DIGBAN      R033CON.DIGBAN%TYPE;
  l_DatAltHFI   R033CON.DATAUX%TYPE;
  l_ColAti      R033CON.COLATI%TYPE;

  l_AlterouPessoa BOOLEAN;
  L_TPCPIX      R033PIX.TPCPIX%TYPE;
  L_CHVPIX      R033PIX.CHVPIX%TYPE;

/* CURSOR para buscar os códigos de pessoas*/
  CURSOR C_R033PES IS
  SELECT CODPES FROM R033PES WHERE CODPES >= l_CodPes ORDER BY CODPES;

  CREATE_TEMP_TABLE R034FUN_AUX; /*colocar como temporária padrão novamente*/

  /*VARIAVEIS DO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);

  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  
  /* Para store procedures de histórico */
  l_seqhis       NUMBER(15);
  l_tipalt       VARCHAR2(1);

CURSOR C_R034LOC IS SELECT NUMEMP, TIPCOL, NUMCAD, CNXUSU, CODUSU FROM R034LOC WHERE NUMEMP = :NEW.NUMEMP
     AND TIPCOL = :NEW.TIPCOL
     AND NUMCAD = :NEW.NUMCAD;

  l_cnxusu       NUMBER(14); 
  l_numsec		 NUMBER(14);
  l_program      VARCHAR2(40);
  l_machine      VARCHAR2(100);  
  l_codusu		 NUMBER(10);  
  l_nomusu       VARCHAR2(100);
  l_mensagem    VARCHAR2(155);
 
BEGIN
 
	FOREACH C_R034LOC INTO l_numemp,
						   l_tipcol,
						   l_numcad,
						   l_cnxusu,
						   l_codusu
	LOOP
		SP_GETSESSIONID(l_numsec OUT, l_program OUT, l_machine OUT);
		IF (l_cnxusu <> l_numsec) THEN
			BEGIN
				SELECT NOMUSU INTO l_nomusu FROM R999USU WHERE CODUSU = l_codusu;
				l_mensagem := 'Não é possível inserir um colaborador com o código informado, pois o mesmo está sendo utilizado pelo usuário: '
								||CONVERT(NUMBER_TO_CHAR, l_codusu) ||' - '
								||l_nomusu
								||' Na seção: '||CONVERT(NUMBER_TO_CHAR, l_cnxusu);
				RAISERROR 103 l_mensagem;
			END;
 
		END IF;
	END LOOP;
  /*  limpar034mdl(newconrho, xtemregpto, xtemregref); substituir delete abaixo por limpar.*/

  /* Apaga os Registros da R034MDL (Apenas para garantir que ao incluir não tenha
    registros nesta tabela). */
  BEGIN
    DELETE FROM R034MDL WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND
      NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      NULL;
  END;

  /* Insere Registro na Tabela de Controle(Referente ao assunto controle de quantidade por colaborador). */
  l_DATCTL := CURDATE();
  l_HORCTL := HOUR(CURTIME())* 60 + MINUTE(CURTIME());
  BEGIN
    INSERT INTO R034CTL (NUMEMP,TIPCOL,NUMCAD,DATCTL,HORCTL)
         VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,l_DATCTL,l_HORCTL);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao Inserir da Tabela R034CTL';
  END;

  /* Le Registro do CURSOR. */
  FOREACH c_r000dfm INTO l_codmod
  LOOP
    /* Grava na Tabela R034MDL. */
    /* Se ConRho 1-Conta Poto/Refeitório, 2-Ponto, 3-Refeitório, 4-Não Conta.
       CodMod 9-Ponto e CodMod 10-Refeitório.*/
    /*
      IF ((:NEW.CONRHO = 0) OR (:NEW.CONRHO = 4) OR (:NEW.CONRHO IS NULL) OR
      ((:NEW.CONRHO = 1) AND ((l_codmod <> 9) AND (l_codmod <> 10))) OR
      ((:NEW.CONRHO = 2) AND (l_codmod <> 9)) OR ((:NEW.CONRHO = 3) AND (l_codmod <> 10))) THEN
    */
      BEGIN
      /* Insere Registro. */
      INSERT INTO R034MDL (NUMEMP,TIPCOL,NUMCAD,CODMOD,INDCON)
                  VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,l_codmod,'N');
      EXCEPTION
      WHEN OTHERS THEN
      l_strerr := 'Erro no INSERT da Tabela R034MDL'||
                  ' tipcol = '||CONVERT(NUMBER_TO_CHAR,:NEW.TIPCOL)||
                  ' numcad = '||CONVERT(NUMBER_TO_CHAR,:NEW.NUMCAD)||
                  ' codmod = '||CONVERT(NUMBER_TO_CHAR,l_codmod);
      RAISERROR 103 l_strerr;
      END;
      /*
      END;
      */
  END LOOP;

  BEGIN
    DELETE FROM R034CTL WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND
      NUMCAD = :NEW.NUMCAD AND DATCTL = l_DATCTL AND HORCTL = l_HORCTL;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no DELETE da Tabela R034CTL';
  END;

  /*SINCRONIZAÇÃO DE COLABORADORES COM PESSOAS*/
  /*==========================================================================*/
  /*data zerada*/
  l_data_zero := DATETIME(31, 12, 1900, 0, 0, 0); /*'31/12/1900,00:00:00';*/
  /*Data atual*/
  l_DatAtu := CURDATE();

  /*Se uma pessoa já existe atualizar dados conforme dados do colaborador*/
  IF (:NEW.CODPES > 0) THEN

	  l_AlterouPessoa := FALSE;

      /* Atualiza a R033PES para os campos alterados */
      IF (IFNULL(:NEW.NOMFUN, ' ') <> ' ') THEN
        BEGIN
          UPDATE R033PES SET NOMPES = :NEW.NOMFUN WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar R033PES campo NOMPES';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.APEFUN, ' ') <> ' ') THEN
        BEGIN
          UPDATE R033PES SET APEPES = :NEW.APEFUN WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo APEPES';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.TIPSEX, ' ') <> ' ') THEN
        BEGIN
          UPDATE R033PES SET TIPSEX = :NEW.TIPSEX WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo TIPSEX';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.ESTCIV, 0) <> 0) THEN
        BEGIN
          UPDATE R033PES SET ESTCIV = :NEW.ESTCIV WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo ESTCIV';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.NUMCPF, 0) <> 0) THEN
        BEGIN
          UPDATE R033PES SET NUMCPF = :NEW.NUMCPF WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NUMCPF';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.DATNAS, DATETIME(31, 12, 1900, 0, 0, 0)) <> l_data_zero) THEN
        BEGIN
          UPDATE R033PES SET DATNAS = :NEW.DATNAS WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DATNAS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.CODNAC, 0) <> 0) THEN
        BEGIN
          UPDATE R033PES SET CODNAC = :NEW.CODNAC WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo CODNAC';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.GRAINS, 0) <> 0) THEN
        BEGIN
          UPDATE R033PES SET GRAINS = :NEW.GRAINS WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo GRAINS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.DEFFIS, ' ') <> ' ') THEN
        BEGIN
          UPDATE R033PES SET DEFFIS = :NEW.DEFFIS WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DEFFIS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.CODDEF, 0) <> 0) THEN
        BEGIN
          UPDATE R033PES SET CODDEF = :NEW.CODDEF WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo CODDEF';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.BENREA, ' ') <> ' ') THEN
        BEGIN
          UPDATE R033PES SET BENREA = :NEW.BENREA WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo BENREA';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.RACCOR, 0) <> 0) THEN
        BEGIN
          UPDATE R033PES SET RACCOR = :NEW.RACCOR WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo RACCOR';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.NUMPIS, 0) <> 0) THEN
        BEGIN
          UPDATE R033PES SET NUMPIS = :NEW.NUMPIS WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NUMPIS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.DCDPIS, DATETIME(31, 12, 1900, 0, 0, 0)) <> l_data_zero) THEN
        BEGIN
          UPDATE R033PES SET DCDPIS = :NEW.DCDPIS WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DCDPIS';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.NUMCTP, 0) <> 0) THEN
        BEGIN
          UPDATE R033PES SET NUMCTP = :NEW.NUMCTP WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo NUMCTP';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.SERCTP, ' ') <> ' ') THEN
        BEGIN
          UPDATE R033PES SET SERCTP = :NEW.SERCTP WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo SERCTP';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.DIGCAR, ' ') <> ' ') THEN
        BEGIN
          UPDATE R033PES SET DIGCAR = :NEW.DIGCAR WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DIGCAR';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.DEXCTP, DATETIME(31, 12, 1900, 0, 0, 0)) <> l_data_zero) THEN
        BEGIN
          UPDATE R033PES SET DEXCTP = :NEW.DEXCTP WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo DEXCTP';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

      IF (IFNULL(:NEW.ESTCTP, ' ') <> ' ') THEN
        BEGIN
          UPDATE R033PES SET ESTCTP = :NEW.ESTCTP WHERE CODPES = :NEW.CODPES;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar R033PES campo ESTCTP';
        END;
        l_AlterouPessoa := TRUE;
      END IF;

	  IF (l_AlterouPessoa = TRUE) THEN
       	/* Retornar a data do primeiro hist. filial do colaborador */
        R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);

        /* Retornar se o colaborador está ativo */
        R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);

	    BEGIN
          UPDATE R033PES SET EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                             DEPAUX = 0, COLATI = l_ColAti, CANAUX = 0, DATAUX = l_DatAltHFI WHERE CODPES = :NEW.CODPES;
        EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'Erro ao atualizar campos auxiliares da R033PES';
        END;
	  END IF;

    /*Verifica assinalimento de histório de contas bancárias*/
    BEGIN
      SELECT HISCON INTO l_HisCon FROM R030EMP
      WHERE NUMEMP = :NEW.NUMEMP;
      EXCEPTION WHEN NO_DATA_FOUND THEN
        l_HisCon := ' ';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler R030EMP';
    END;

    /*Se não histórico de contas*/
    IF (l_HisCon = 'N') THEN
      IF (:NEW.CODBAN <> 0) AND (:NEW.CODAGE <> 0) AND (:NEW.CONBAN <> 0) AND (:NEW.TPCTBA <> 0) THEN
        BEGIN
          l_Existe := TRUE;
          /*Verifica se conta já existe*/
          SELECT SEQCON,  DATALT,  CODBAN,  CODAGE,  CONBAN,  TIPBAN,  DIGBAN
            INTO L_SEQCON,L_DATALT,L_CODBAN,L_CODAGE,L_CONBAN,L_TIPBAN,L_DIGBAN
            FROM R033CON
           WHERE CODBAN = :NEW.CODBAN
             AND CODAGE = :NEW.CODAGE
             AND CONBAN = :NEW.CONBAN
             AND CODPES = :NEW.CODPES
             AND DATALT = (SELECT MAX(DATALT)
                           FROM R033CON TAB2
                           WHERE TAB2.CODBAN = :NEW.CODBAN
                             AND TAB2.CODAGE = :NEW.CODAGE
                             AND TAB2.CONBAN = :NEW.CONBAN
                             AND TAB2.CODPES = :NEW.CODPES
                             AND TAB2.DATALT <= l_DatAtu)
             AND SEQCON = (SELECT MAX(SEQCON)
                           FROM R033CON TAB2
                           WHERE TAB2.CODPES = L_CODPES
                        	 AND TAB2.DATALT = (SELECT MAX(DATALT) FROM R033CON CON WHERE CON.CODPES = L_CODPES AND CON.CODBAN = :NEW.CODBAN AND CON.CODAGE = :NEW.CODAGE AND CON.DATALT <= l_DatAtu)
                        	 AND TAB2.CODBAN = :NEW.CODBAN
           					 AND TAB2.CODAGE = :NEW.CODAGE
           					 AND TAB2.CONBAN = :NEW.CONBAN);
          EXCEPTION WHEN NO_DATA_FOUND THEN
            L_SEQCON := 0;
            L_DATALT := L_DATATU;
            L_CODBAN := :NEW.CODBAN;
            L_CODAGE := :NEW.CODAGE;
            L_CONBAN := :NEW.CONBAN;
            L_DIGBAN := :NEW.DIGBAN;
            L_TIPBAN := :NEW.TPCTBA;
            l_Existe := FALSE;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler R033CON na R034FUN';
        END;

        /* Retornar a data do primeiro hist. filial do colaborador */
        R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);

        /* Retornar se o colaborador está ativo */
        R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);

        IF (l_Existe = TRUE) THEN
          BEGIN
            /*Se existe zera data de encerramento*/
            UPDATE R033CON SET TIPBAN = :NEW.TPCTBA, DIGBAN = :NEW.DIGBAN, DATABE = L_DATATU, DATENC = l_data_zero,
                               EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                               DEPAUX = 0, COLATI = l_ColAti, CANAUX = 0, DATAUX = l_DatAltHFI
            WHERE CODPES = :NEW.CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON AND DATENC <> l_data_zero;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a R033CON';
          END;
        ELSE
          BEGIN
            /*Gera próxima sequência*/
            SELECT IFNULL(MAX(SEQCON),0) INTO L_ULTSEQCON FROM R033CON
            WHERE CODPES = :NEW.CODPES;
            EXCEPTION WHEN NO_DATA_FOUND THEN
              L_ULTSEQCON := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao ler R033CON.SEQCON';
          END;
          L_SEQCON := L_ULTSEQCON + 1;

          BEGIN
            /*Se conta não existe insere na R033CON*/
            INSERT INTO R033CON (CODPES, DATALT, SEQCON, CODBAN, CODAGE, TIPBAN, CONBAN, DIGBAN, DATABE, DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX)
            VALUES (:NEW.CODPES, L_DATALT, L_SEQCON, L_CODBAN, L_CODAGE, L_TIPBAN, L_CONBAN, L_DIGBAN, l_DatAtu, l_data_zero, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, l_ColAti, 0, l_DatAltHFI);
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao inserir na R033CON';
          END;
        END IF;
      END IF;
    END IF;
    
    /* chave pix */
    IF (l_HisCon = 'N') THEN
      IF (:NEW.TPCPIX <> 0)  THEN
        BEGIN
          l_Existe := TRUE;
          /*Verifica se chave já existe*/
          SELECT SEQCON,  DATALT, TPCPIX, CHVPIX
            INTO L_SEQCON,L_DATALT,L_TPCPIX,L_CHVPIX
            FROM R033PIX
           WHERE TPCPIX = :NEW.TPCPIX
             AND CHVPIX = :NEW.CHVPIX
             AND CODPES = :NEW.CODPES
             AND DATALT = (SELECT MAX(DATALT)
                           FROM R033PIX TAB2
                           WHERE TAB2.TPCPIX = :NEW.TPCPIX
                             AND TAB2.CHVPIX = :NEW.CHVPIX
                             AND TAB2.CODPES = :NEW.CODPES
                             AND TAB2.DATALT <= l_DatAtu);
          EXCEPTION WHEN NO_DATA_FOUND THEN
            L_SEQCON := 0;
            L_DATALT := L_DATATU;
            L_TPCPIX := :NEW.TPCPIX;
            L_CHVPIX := :NEW.CHVPIX;
            l_Existe := FALSE;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler R033PIX na R034FUN';
        END;

        /* Retornar a data do primeiro hist. filial do colaborador */
        R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);

        /* Retornar se o colaborador está ativo */
        R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);

        IF (l_Existe = TRUE) THEN
          BEGIN
            /*Se existe zera data de encerramento*/
            UPDATE R033PIX SET DATABE = L_DATATU, DATENC = l_data_zero,
                               EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                               DEPAUX = 0, COLATI = l_ColAti, CANAUX = 0, DATAUX = l_DatAltHFI
            WHERE CODPES = :NEW.CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON AND DATENC <> l_data_zero;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a R033PIX';
          END;
        ELSE
          BEGIN
            /*Gera próxima sequência*/
            SELECT IFNULL(MAX(SEQCON),0) INTO L_ULTSEQCON FROM R033PIX
            WHERE CODPES = :NEW.CODPES;
            EXCEPTION WHEN NO_DATA_FOUND THEN
              L_ULTSEQCON := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao ler R033PIX.SEQCON';
          END;
          L_SEQCON := L_ULTSEQCON + 1;

          BEGIN
            /*Se chave não existe insere na R033PIX*/
            INSERT INTO R033PIX (CODPES, DATALT, SEQCON, DATABE, DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX, TPCPIX, CHVPIX)
            VALUES (:NEW.CODPES, L_DATALT, L_SEQCON, l_DatAtu, l_data_zero, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, l_ColAti, 0, l_DatAltHFI, L_TPCPIX, L_CHVPIX);
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao inserir na R033PIX';
          END;
        END IF;
      END IF;
    END IF;
  END IF;


  /*Se não existe uma pessoa, gera/insere registro na tabela R033PES, conforme assinalamentos*/
  IF (:NEW.CODPES = 0) THEN
    /*Verifica assinalamentos para ver se a rotina de pessoas foi habilitata e se existe obrigatoriédade*/
    BEGIN
      SELECT HABPES,VINPES INTO l_HabPes,l_VinPes FROM R000ASS;
      EXCEPTION WHEN NO_DATA_FOUND THEN
        l_HabPes := 'N';
        l_VinPes := 0;
      WHEN OTHERS THEN
        l_strerr := 'Erro ao ler R000ASS'; RAISERROR 103 l_strerr;
    END;

    IF (l_HabPes = 'S') THEN
      IF (l_VinPes = 1) THEN
        l_CriarPessoa := 'S';
      ELSE
        BEGIN
          /*Criada tabela R034TRI, como solução para o problema de número de campos na R034FUN*/
          SELECT CRIPES INTO l_CriPes FROM R034TRI
          WHERE NUMEMP = :NEW.NUMEMP
            AND TIPCOL = :NEW.TIPCOL
            AND NUMCAD = :NEW.NUMCAD;
          EXCEPTION WHEN NO_DATA_FOUND THEN
            l_CriPes := 'N';
          WHEN OTHERS THEN
            l_strerr := 'Erro ao ler R034TRI.CRIPES'; RAISERROR 103 l_strerr;
        END;

        IF (l_VinPes = 2) THEN
          BEGIN
            /*Buscar assinalamento de obrigatoriedade conforme a empresa do colaborador*/
            SELECT VINPES,VINPE2,VINPE3 INTO l_VinPes,l_VinPe2,l_VinPe3 FROM R030EMP WHERE NUMEMP = :NEW.NUMEMP;
            EXCEPTION WHEN NO_DATA_FOUND THEN
              l_VinPes := 0;
              l_VinPe2 := 0;
              l_VinPe3 := 0;
            WHEN OTHERS THEN
              l_strerr := 'Erro ao ler R030EMP'; RAISERROR 103 l_strerr;
          END;

          IF ((:NEW.TIPCOL = 1) AND (l_VinPes = 1)) OR ((:NEW.TIPCOL = 2) AND (l_VinPe2 = 1)) OR ((:NEW.TIPCOL = 3) AND (l_VinPe3 = 1)) THEN
            l_CriarPessoa := 'S';
          ELSE
            /*Se o vínculo não for obrigatório buscar resposta se vai ser criada um nova pessoa*/
            l_CriarPessoa := l_CriPes;
          END IF;
        ELSE
          /*Se o vínculo não for obrigatório buscar resposta se vai ser criada um nova pessoa*/
          l_CriarPessoa := l_CriPes;
        END IF;
      END IF;

      /*Se optar para gerar pessoa*/
      IF (l_CriarPessoa = 'S') THEN
        /* Busca maior codigo de sequencia reservado geração, somente WEG.
         * Demais clientes vão estar zerados */
        BEGIN
        	SELECT IFNULL(MAX(REFPES), 1) INTO l_CodPes FROM R033ORD;
        EXCEPTION
        	WHEN OTHERS THEN
            	RAISERROR 103 'Falha ao retornar código da pessoa (R033ORD)';
        END;

        /* Se retornou  R033ORD, deve incrementar uma posição.
         * O valor retornado é resevado para geração de pessoas, para criação dinâmica deve ser superior. */
        IF (l_CodPes > 1) THEN
            l_CodPes := l_CodPes + 1;
        END IF;

        IF (l_CodPes = 0) THEN
            l_CodPes := 1;
        END IF;

        /*Busca o primeiro código livre para a nova pessoa */
        FOREACH C_R033PES INTO l_CodPesAux
        LOOP
          /* Encontrou um código vago */
          IF (l_CodPes < l_CodPesAux) THEN
            EXIT;
          END IF;

          /* Limite foi atingido */
          IF (l_CodPes = 999999999) THEN
            RAISERROR 103 'Não existem códigos disponíveis para a nova Pessoa. Inclusão não permitida';
          END IF;

          l_CodPes := l_CodPes + 1;
        END LOOP;

        /*Data e hora atual*/
        l_DatAtu := CURDATE();
        l_HorAtu := HOUR(CURTIME())*60 + MINUTE(CURTIME());

        /* Retornar a data do primeiro hist. filial do colaborador */
        R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);

        /* Retornar se o colaborador está ativo */
        R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);

        /*Inserir nova pessoa com os dados do novo colaborador*/
        BEGIN
          INSERT INTO R033PES (CodPes, NomPes, ApePes, TipSex, EstCiv, NumCpf, DatNas, CciNas, CodNac, GraIns, DatAlt, HorAlt, CodUsu, DefFis, CodDef, BenRea, RacCor, NomCom, NumPis, DcdPis, NumCid, EmiCid, EstCid, DexCid, CidEmi, NumCtp, SerCtp, DigCar, DexCtp, EstCtp, NumEle, ZonEle, SecEle, NumCnh, CatCnh, DatCnh, VenCnh, EmaCom, EmaPar, NumTel, NumRam, NumCel, TelCom, DddCel, DdiCel, DddTel, DdiTel, DddCom, DdiCom, EmpAux, TipAux, CadAux, DepAux, ColAti, CanAux, DatAux)
                       VALUES (l_CodPes, :NEW.NOMFUN, :NEW.APEFUN, :NEW.TIPSEX, :NEW.ESTCIV, :NEW.NUMCPF, :NEW.DATNAS, 0, :NEW.CODNAC, :NEW.GRAINS, l_DatAtu, l_HorAtu, 0, :NEW.DEFFIS, :NEW.CODDEF, :NEW.BENREA, :NEW.RACCOR, '', :NEW.NUMPIS, :NEW.DCDPIS, '', '', '', l_data_zero, 0, :NEW.NUMCTP, :NEW.SERCTP, :NEW.DIGCAR, :NEW.DEXCTP, :NEW.ESTCTP, '', '',  '', '', '', l_data_zero, l_data_zero, '', '', '', '', '', '', 0, 0, 0, 0, 0, 0, :NEW.numemp, :NEW.tipcol, :NEW.numcad, 0, l_ColAti, 0, l_DatAltHFI);
          EXCEPTION WHEN OTHERS THEN
            l_strerr := 'Erro ao Inserir Pessoa'; RAISERROR 103 l_strerr;
        END;

        /*Inserir na R034FUN_AUX o novo código da pessoa para atualizar na R034FUN*/
        BEGIN
          INSERT INTO R034FUN_AUX (NUMEMP,TIPCOL,NUMCAD,CODPES)
                          VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,l_CodPes);
          EXCEPTION WHEN OTHERS THEN
            l_strerr := 'Erro ao Inserir R034FUN_AUX'; RAISERROR 103 l_strerr;
        END;

      END IF;
    END IF;
  END IF;
  /*FIM SINCRONIZAÇÃO*/

  /* Insere registro CURRICULO COMPILADO */
  /* Garante que todo colaborador tenha registro na tabela R122CCO - Tarefa: 236116*/
  RS_INSCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R034FUN');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R034FUN_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,NOMFUN,APEFUN,DATADM,SITAFA,TIPCON,
                                   TIPSEX,ESTCIV,DATNAS,CODNAC,ANOCHE,VISEST,REGEST,DVLEST,DVLCTP,NUMCTP,
                                   NUMCPF,NUMPIS,DCDPIS,DATAFA,HORAFA,EMPRES,TIPRES,CADRES,TIPTER,APUPFS,
                                   NUMPSP,ESTCAR,CODCAR,STAALF)
                           VALUES (l_seqreg,l_verseq,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.NOMFUN,
                                  :NEW.APEFUN,:NEW.DATADM,:NEW.SITAFA,:NEW.TIPCON,:NEW.TIPSEX,:NEW.ESTCIV,
                                  :NEW.DATNAS,:NEW.CODNAC,:NEW.ANOCHE,:NEW.VISEST,:NEW.REGEST,:NEW.DVLEST,
                                  :NEW.DVLCTP,:NEW.NUMCTP,:NEW.NUMCPF,:NEW.NUMPIS,:NEW.DCDPIS,:NEW.DATAFA,
                                  :NEW.HORAFA,:NEW.EMPRES,:NEW.TIPRES,:NEW.CADRES,:NEW.TIPTER,:NEW.APUPFS,
                                  :NEW.NUMPSP,:NEW.ESTCAR,:NEW.CODCAR,:NEW.STAALF);

          SP_AUDGENREG(l_seqreg,l_verseq,'R034FUN','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            NULL; /* Erro em auditoria não pode parar o cadastro todo. */
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  /* Geração de histórico da ficha básica */
	l_tipalt := 'I';
  	SP_R034FUN_HIST(l_tipalt, :NEW.numemp, :NEW.tipcol, :NEW.numcad, :NEW.nomfun, :NEW.apefun, :NEW.tipsex, :NEW.raccor, :NEW.estciv, :NEW.grains, :NEW.datnas, :NEW.codnac, 
		:NEW.numctp, :NEW.serctp, :NEW.digcar, :NEW.estctp, :NEW.dexctp, :NEW.numcpf, :NEW.numpis, :NEW.dcdpis, :NEW.movsef, :NEW.irrise, :NEW.apoida, :NEW.emtcar, 
		:NEW.numins, :NEW.coddef, :NEW.deffis, :NEW.benrea, :NEW.nmfun1, :NEW.nmfun2, :NEW.nmfun3, :NEW.nmfun4, :NEW.codpro, :NEW.anoche, :NEW.visest, :NEW.dvlest, 
		:NEW.regest, :NEW.dvlctp, :NEW.docest, :NEW.datche, :NEW.numpsp, :NEW.datadm, :NEW.tipadm, :NEW.tipcon, :NEW.tipopc, :NEW.datopc, :NEW.confgt, :NEW.modpag, 
		:NEW.codban, :NEW.codage, :NEW.conban, :NEW.digban, :NEW.perpag, :NEW.recadi, :NEW.rec13s, :NEW.lisrai, :NEW.emicar, :NEW.codcha, :NEW.NUMCRA, :NEW.outcon, 
		:NEW.outtet, :NEW.outemp, :NEW.outtip, :NEW.outcad, :NEW.perdes, :NEW.periss, :NEW.faiins, :NEW.opcatu, :NEW.dctins, :NEW.cadfol, :NEW.catter, :NEW.fattpo, 
		:NEW.empres, :NEW.tipres, :NEW.cadres, :NEW.tipter, :NEW.cauadv, :NEW.inscur, :NEW.assppr, :NEW.datppr, :NEW.verint, :NEW.contov, :NEW.apupfs, :NEW.tippfs, 
		:NEW.ratpfs, :NEW.gpstri, :NEW.dedcar, :NEW.codfor, :NEW.rateve, :NEW.pertra, :NEW.perirt, :NEW.dedins, :NEW.tipsrv, :NEW.bushor, :NEW.recgra, :NEW.codidn, 
		:NEW.tpctba, :NEW.codlim, :NEW.rettrp, l_seqhis OUT); 
	SP_R034FUN_HIST_UP(l_seqhis, :NEW.numemp, :NEW.tipcol, :NEW.numcad,:NEW.depirf, :NEW.depsaf, :NEW.tpcpix, :NEW.chvpix);

  /* Pendência de integração SAMSenior */
  SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_IDTPES OUT);
  SP_SAM_PENDENCIES(1,1,l_idtpes);


   /* Geração de logs Ficha Básica Colaborador (Tabela: R034FUN)*/
  l_codSistema := 1;  /* Código do sistema vetorh.*/
  l_codcpa := 83;     /* Ficha Básica Colaborador (Tabela: R034FUN)*/
  l_codtpa := 297;

  l_temAud := FALSE;
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034FUN_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034FUN_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMFUN', :NEW.NOMFUN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'APEFUN', :NEW.APEFUN);
        SP_DATSTR(:NEW.DATADM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATADM', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPADM', CONVERT(NUMBER_TO_CHAR, :NEW.TIPADM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITAFA', CONVERT(NUMBER_TO_CHAR, :NEW.SITAFA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAP', CONVERT(NUMBER_TO_CHAR, :NEW.CODTAP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', CONVERT(NUMBER_TO_CHAR, :NEW.ESTPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', :NEW.POSTRA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODETB', CONVERT(NUMBER_TO_CHAR, :NEW.CODETB));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCAR', CONVERT(NUMBER_TO_CHAR, :NEW.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAR', :NEW.CODCAR);
