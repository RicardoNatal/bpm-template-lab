DECLARE
l_online       BOOLEAN;
  l_data_atual   DATE;
  l_data_zero    DATE;
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       IF   (:NEW.DATINI <= l_data_atual)
       AND  ((:NEW.DATFIM >= l_data_atual) OR (:NEW.DATFIM = l_data_zero)) AND (:NEW.STADIB = 0) THEN
            R057DIB_CRABEN('I',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODBNF,:NEW.QTDENB);
       END IF;
  END IF;
END␀R×␀␀		SENIOR;0;␀␀

