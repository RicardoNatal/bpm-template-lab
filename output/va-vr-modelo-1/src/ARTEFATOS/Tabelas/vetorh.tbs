s␀␀PROCEDURE SP_ALT_ETNIA_ESOC(OLD_RACCOR NUMBER(2), NEW_RACCOR NUMBER(2), l_Etnia_Alterada OUT BOOLEAN)
 IS

  l_esoEtnNovo      NUMBER(1);
  l_esoEtnVelho     NUMBER(1);
  
BEGIN  
   BEGIN
     SELECT ESOETN INTO l_esoEtnVelho FROM R010ETN WHERE codEtn = OLD_RACCOR; 
   EXCEPTION
     WHEN NO_DATA_FOUND THEN
       l_esoEtnVelho := 0;
   END;
  
  BEGIN
    SELECT ESOETN INTO l_esoEtnNovo FROM R010ETN WHERE codEtn = NEW_RACCOR;
  EXCEPTION 
    WHEN NO_DATA_FOUND THEN
    l_esoEtnNovo := 0;
  END;

  IF l_esoEtnNovo <> l_esoEtnVelho THEN
    l_Etnia_Alterada := TRUE;
  ELSE
    l_Etnia_Alterada := FALSE;  
  END IF;
END␀â÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0tSP_VALUPDATE_DAT
RH_DEF_ESOCIAL
RH_RET_DATADM
RH_LAYOUTCOLAB
SP_E_SOCIAL
SP_INITEMPTY_DAT
SP_HIST_DT_ESOCIAL
Ô␀␀PROCEDURE SP_ALT_TAB_ESOCIAL(P_LAYOUTALTERACAO VARCHAR2(6), P_EMPRESA NUMBER(4), P_TIPOCOLABORADOR NUMBER(1), P_COLABORADOR NUMBER(9), P_DATAINICIOHISTORICO DATE, P_DATAFIMHISTORICO DATE, P_DATAOLDFIMHISTORICO DATE, P_TABELAHISTORICO VARCHAR2(7), P_VALORJSON VARCHAR2(2000), P_VALORJSON2 VARCHAR2(2000), P_ALTEROUSOMENTEDATAFIM BOOLEAN, P_CAMPODATA VARCHAR2(6), P_FILTROSQL VARCHAR2(500), P_PENEXT NUMBER(1), P_ORIGEM VARCHAR2(60))
 IS

	l_DataZero DATE;
	l_DataInicio DATE;
	l_DataInicioEsocial DATE;
	l_DataInicioTabelas DATE;
	l_DataInicioNaoPeriodicos DATE;
	l_DataInicioPeriodicos DATE;
	l_DataInicioSST DATE;
	
	l_DataAdmissao DATE;
	l_DataESocial DATE;		
	l_PeriodoValido BOOLEAN;
	l_AlterouDataFim BOOLEAN;
	l_LayoutOrigem VARCHAR2(6);
	l_DataInicioHistorico DATE;
	l_DataFimHistorico DATE;
	l_DataOldFimHistorico DATE;
	l_DataInicioMigracao DATE;
BEGIN
	l_PeriodoValido := FALSE;
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);	
	
	l_DataInicioHistorico := P_DATAINICIOHISTORICO;
	SP_INITEMPTY_DAT(l_DataInicioHistorico IN OUT);
	
	l_DataFimHistorico := P_DATAFIMHISTORICO;
	SP_INITEMPTY_DAT(l_DataFimHistorico IN OUT);
	
	l_DataOldFimHistorico := P_DATAOLDFIMHISTORICO;
	SP_INITEMPTY_DAT(l_DataOldFimHistorico IN OUT);
		
	l_AlterouDataFim := FALSE;
	SP_VALUPDATE_DAT(l_DataOldFimHistorico, l_DataFimHistorico, l_AlterouDataFim OUT);

	RH_DEF_ESOCIAL(P_EMPRESA, l_DataInicioTabelas OUT, l_DataInicioEsocial OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
	RH_RET_DATADM(P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, l_DataAdmissao OUT);
	RH_LAYOUTCOLAB(P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, l_LayoutOrigem OUT);
	
	IF (l_DataAdmissao > l_DataInicioNaoPeriodicos) THEN
		l_DataESocial := l_DataAdmissao;
	ELSE
		l_DataESocial := l_DataInicioNaoPeriodicos;
	END IF;
	
	/* Se o histórico iniciar antes do eSocial, ele pode estar vigente durante o eSocial. Neste caso será criada uma pendência para o leiaute original*/
	IF (l_DataInicioHistorico < l_DataESocial) THEN
		/* Verifica se a data de término está dentro do eSocial */		
		IF (l_DataFimHistorico >= l_DataESocial) OR (l_DataFimHistorico = l_DataZero) THEN
			/* Se alterou somente a data de término, não precisa criar pendência pois nenhuma informação mudou na data de início */
			IF (P_ALTEROUSOMENTEDATAFIM = FALSE) THEN		
				/* Cria uma pendência de retificação para o leiaute inicial e outra para verificar a retificação do leiaute de alteração cadastral/contratual */	
				SP_E_SOCIAL(l_LayoutOrigem, P_TABELAHISTORICO, 'N', 'A', NULL, NULL, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataESocial, P_PENEXT, P_ORIGEM);
				IF ((l_DataFimHistorico > l_DataESocial) OR (l_DataFimHistorico = l_DataZero)) THEN
					SP_E_SOCIAL(P_LAYOUTALTERACAO, P_TABELAHISTORICO, 'N', 'A', l_DataESocial, l_DataFimHistorico, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataESocial, P_PENEXT, P_ORIGEM);
				END IF;
			END IF;
			l_PeriodoValido := TRUE;
		ELSE 
			/* Caso a data de término tenha sido alterada, verifica se a data de término antiga estava dentro do eSocial */ 
			IF (l_AlterouDataFim = TRUE) AND ((l_DataOldFimHistorico >=	l_DataESocial) OR (l_DataOldFimHistorico = l_DataZero)) THEN
				SP_E_SOCIAL(l_LayoutOrigem, P_TABELAHISTORICO, 'N', 'A', NULL, NULL, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataESocial, P_PENEXT, P_ORIGEM);
				IF ((l_DataOldFimHistorico > l_DataESocial) OR (l_DataOldFimHistorico = l_DataZero)) THEN
					SP_E_SOCIAL(P_LAYOUTALTERACAO, P_TABELAHISTORICO, 'N', 'A', l_DataESocial, l_DataOldFimHistorico, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataESocial, P_PENEXT, P_ORIGEM);
				END IF;
			END IF;
		END IF;
	ELSE
		/* Se alterou somente a data de término, não precisa criar pendência pois nenhuma informação mudou na data de início */
		IF (P_ALTEROUSOMENTEDATAFIM = FALSE) THEN 
			/* Cria uma pendência de retificação para o leiaute inicial e outra para verificar a retificação do leiaute de alteração cadastral/contratual */
			IF (l_DataInicioHistorico = l_DataESocial) THEN
				SP_E_SOCIAL(l_LayoutOrigem, P_TABELAHISTORICO, 'N', 'A', NULL, NULL, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataInicioHistorico, P_PENEXT, P_ORIGEM);
				IF ((l_DataFimHistorico > l_DataESocial) OR (l_DataFimHistorico = l_DataZero)) THEN	
					SP_E_SOCIAL(P_LAYOUTALTERACAO, P_TABELAHISTORICO, 'N', 'A', l_DataInicioHistorico, l_DataFimHistorico, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataInicioHistorico, P_PENEXT, P_ORIGEM);
				END IF;
			ELSE
				SP_E_SOCIAL(P_LAYOUTALTERACAO, P_TABELAHISTORICO, 'N', 'A', l_DataInicioHistorico, l_DataFimHistorico, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataInicioHistorico, P_PENEXT, P_ORIGEM);
			END IF;
		END IF;
		l_PeriodoValido := TRUE;
	END IF;

	
	IF (l_PeriodoValido = TRUE) AND (l_AlterouDataFim = TRUE) THEN
	/* Tratativa para ajustar envios quando a data de término for diminuida ou zerada */
		IF ((l_DataFimHistorico < l_DataOldFimHistorico) OR (l_DataFimHistorico = l_DataZero)) THEN
		/* Quando o histórico tiver sua data de fim zerada, deverá existir uma pendência a partir da data OLD.Término para ajustar os envios posteriores */ 
			IF (l_DataFimHistorico = l_DataZero) THEN  
				l_DataInicio := l_DataOldFimHistorico + 1;
				SP_E_SOCIAL(P_LAYOUTALTERACAO, P_TABELAHISTORICO, 'N', 'A', l_DataInicio, l_DataZero, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataInicio, P_PENEXT, P_ORIGEM);
			ELSE
				/* Se a data de término foi reduzida, cria uma pendência para ajustar o envios ocorridos entre a nova e a antiga data de término */
				l_DataInicio := DATETIMEADD(DD, 1, l_DataFimHistorico);		  
				SP_E_SOCIAL(P_LAYOUTALTERACAO, P_TABELAHISTORICO, 'N', 'A', l_DataInicio, l_DataOldFimHistorico, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataInicio, P_PENEXT, P_ORIGEM);		  
			END IF;
		END IF;	  
		/* Se a data de término for aumentada cria uma pendência para ajustar o envios ocorridos entre a nova término + 1 e o próximo histórico*/
		IF (l_DataFimHistorico > l_DataOldFimHistorico) THEN	    	  	  	    
			IF (l_DataOldFimHistorico <> l_DataZero AND P_ALTEROUSOMENTEDATAFIM = TRUE) THEN
				l_DataInicio := l_DataOldFimHistorico + 1;		  
				SP_E_SOCIAL(P_LAYOUTALTERACAO, P_TABELAHISTORICO, 'N', 'A', l_DataInicio, l_DataFimHistorico, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, P_VALORJSON, P_VALORJSON2, 0, NULL, l_DataInicio, P_PENEXT, P_ORIGEM);		  				        
			END IF;		  
			SP_HIST_DT_ESOCIAL(P_LAYOUTALTERACAO, P_EMPRESA, P_TIPOCOLABORADOR, P_COLABORADOR, l_DataFimHistorico, P_TABELAHISTORICO, P_CAMPODATA, 'A', P_VALORJSON, P_VALORJSON2, P_FILTROSQL, P_PENEXT, P_ORIGEM);				
		END IF;
	END IF;
END␀ã÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
