END␀␀␀Ï¿␀␀␀␀␀␀␀ÿ×␀␀8‹␀␀±␀	␀␀␀␀␀␀£Š␀␀ZŠ␀␀£Š␀␀q␀Æÿ␀␀␀Ø␀␀␀'UE␀␀␀␀␀␀;Y%W;YG␀␀ÿ␀␀ÿ␀…-õ␀␀␀␀␀␀º?°:º?q␀Æÿ␀␀ÿ␀EÑ␀␀␀␀␀␀␀mG]GmGqC␀êÿ␀␀ÿ␀¤w·␀␀␀␀␀␀␀ixdxixì*␀␀Æÿ␀␀ÿ␀ø␀x␀␀␀␀␀␀A␀õ␀A␀n␀Æÿ␀␀ÿ␀5½␀␀(␀␀␀␀␀␀i¿␀␀c¿␀␀i¿␀␀1␀␀ÿ␀␀ÿ␀Ì	␀·␀␀␀␀␀␀␀_
␀
␀_
␀s␀Æÿ␀␀ÿ␀ÌEÑ␀␀␀␀␀␀␀­KK­KqC␀êÿ␀␀ÿ␀™i=␀␀␀␀␀␀¨i¨i¨ic␀␀␀ÿ␀␀ÿ␀␀␀␀0␀␀¿2␀␀␀␀␀␀␀␀␀␀␀Ø␀␀C-·␀	„␀␀␀␀␀~=¿␀␀¿␀␀t␀Æÿ␀␀ı×␀␀␀¥%␀±␀	„␀␀␀␀␀?&␀<&␀<&␀q␀Æÿ␀␀6Ø␀␀␀3-Á␀	„␀␀␀␀␀Ï@˜š␀␀˜š␀␀y␀Æÿ␀␀å×␀␀␀␀␀Ø␀␀␀␀0;1;2Ø␀␀		SENIOR;0³:␀␀TRIGGER R058PRR_EI AFTER INSERT ON R058PRR FOR EACH ROW
DECLARE
    l_data_atual DATE;
    l_data_zero  DATE;
    l_hora_atual NUMBER(4);
    l_codpen     NUMBER(18);
    l_numcra     NUMBER(12);
    l_verplf     NUMBER(3);
    l_codplf     NUMBER(7);
    l_codrec     NUMBER(15);
    l_cracha     NUMBER(12);
    l_datini     DATE;
    l_horini     NUMBER(4);
    l_datfim     DATE;
    l_horfim     NUMBER(4);
    l_tipcra     NUMBER(1);
    l_gerpen_emp BOOLEAN;
    l_gerpen_ter BOOLEAN;
    l_gerpen_par BOOLEAN;
    l_gerpen_vis BOOLEAN;
    l_gerpen     BOOLEAN;
    alfmen       VARCHAR2(255);

    CURSOR c_prmcol IS SELECT DAC.NUMEMP, DAC.TIPCOL, DAC.NUMCAD FROM R034DAC DAC
                        WHERE (DAC.CODPRM = :NEW.CODPRM OR DAC.PRMSAB = :NEW.CODPRM OR DAC.PRMDOM = :NEW.CODPRM OR DAC.PRMFER = :NEW.CODPRM)
                          AND NOT EXISTS
                              (SELECT 1 FROM R064TPE TPC
                                WHERE TPC.NUMEMP = DAC.NUMEMP AND TPC.TIPCOL = DAC.TIPCOL AND TPC.NUMCAD = DAC.NUMCAD
                                  AND TPC.STAACC = 1 AND (TPC.DATFIM = l_data_zero OR TPC.DATFIM > l_data_atual OR
                                      (TPC.DATFIM = l_data_atual AND TPC.HORFIM > l_hora_atual)))
                       UNION(
                       SELECT PEC.NUMEMP, PEC.TIPCOL, PEC.NUMCAD FROM R070PEC PEC
                        WHERE PEC.CODPRM = :NEW.CODPRM AND PEC.STAACC = 1
                          AND (PEC.DATFIM = l_data_zero OR PEC.DATFIM > l_data_atual OR
                              (PEC.DATFIM = l_data_atual AND PEC.HORFIM > l_hora_atual))
                       UNION(
                       SELECT TPE.NUMEMP, TPE.TIPCOL, TPE.NUMCAD FROM R064TPE TPE
                        WHERE (TPE.CODPRM = :NEW.CODPRM OR TPE.PRMSAB = :NEW.CODPRM OR TPE.PRMDOM = :NEW.CODPRM OR TPE.PRMFER = :NEW.CODPRM)
                          AND TPE.STAACC = 1 AND (TPE.DATFIM = l_data_zero OR TPE.DATFIM > l_data_atual OR
                              (TPE.DATFIM = l_data_atual AND TPE.HORFIM > l_hora_atual))));

    CURSOR c_prmvis IS SELECT HCH.TIPDOC, HCH.NUMDOC, HCH.NUMCRA, HCH.DATINI, HCH.HORINI, HCH.DATFIM, HCH.HORFIM, HCH.SEQENT
                         FROM R090HCH HCH, R090MVI MVI
                        WHERE HCH.DATINI = MVI.DATENT AND HCH.HORINI = MVI.HORENT AND HCH.SEQENT = MVI.SEQENT
                          AND MVI.CODPRM = :NEW.CODPRM AND MVI.DATSAI = l_data_zero
                       UNION(
                       SELECT HC2.TIPDOC, HC2.NUMDOC, HC2.NUMCRA, HC2.DATINI, HC2.HORINI, HC2.DATFIM, HC2.HORFIM, HC2.SEQENT
                         FROM R090HCH HC2, R070PEV PEV
                        WHERE HC2.TIPDOC = PEV.TIPDOC AND HC2.NUMDOC = PEV.NUMDOC
                          AND PEV.CODPRM = :NEW.CODPRM AND PEV.STAACC = 1
                          AND (PEV.DATFIM = l_data_zero OR PEV.DATFIM > l_data_atual OR
                              (PEV.DATFIM = l_data_atual AND PEV.HORFIM > l_hora_atual))
                          AND (HC2.DATINI < l_data_atual OR
                              (HC2.DATINI = l_data_atual AND HC2.HORINI <= l_hora_atual))
                          AND (HC2.DATFIM = l_data_zero OR HC2.DATFIM > l_data_atual OR
                              (HC2.DATFIM = l_data_atual AND HC2.HORFIM >= l_hora_atual)));

    TYPE t_prmcol IS RECORD(
           NUMEMP   R034DAC.NumEmp%TYPE,
           TIPCOL   R034DAC.TipCol%TYPE,
           NUMCAD   R034DAC.NumCad%TYPE);

    TYPE t_prmvis IS RECORD(
           TIPDOC   R090VIS.TipDoc%TYPE,
           NUMDOC   R090VIS.NumDoc%TYPE,
           NUMCRA   R090HCH.NumCra%TYPE,
           DATINI   R090HCH.DatIni%TYPE,
           HORINI   R090HCH.HorIni%TYPE,
           DATFIM   R090HCH.DatFim%TYPE,
           HORFIM   R090HCH.HorFim%TYPE,
           SEQENT   R090HCH.SeqEnt%TYPE);

    l_prmcol t_prmcol;
    l_prmvis t_prmvis;

BEGIN
    l_verplf := :NEW.VERPLF;
    l_codplf := :NEW.CODPLF;

    BEGIN
        SELECT CODREC INTO l_codrec FROM R058PLF WHERE VERPLF = l_verplf AND CODPLF = l_codplf;
    EXCEPTION
        WHEN OTHERS THEN l_codrec := 0;
    END;

    IF (l_codrec > 0)  THEN
        /* Verifico os tipos de pessoas, se devo gerar pendência de credenciamento */
        SP_RECALF_GERPEN(11, l_gerpen_emp OUT); /* Credenciamento-pessoas - Empregado */
        SP_RECALF_GERPEN(12, l_gerpen_ter OUT); /* Credenciamento-pessoas - Terceiro */
        SP_RECALF_GERPEN(13, l_gerpen_par OUT); /* Credenciamento-pessoas - Parceiro */
        SP_RECALF_GERPEN(14, l_gerpen_vis OUT); /* Credenciamento-pessoas - Visitante */

        l_data_atual := CURDATE();
        l_data_zero  := '31/12/1900,00:00:00';
        l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

        /* Incluí um recinto aduaneiro na permissão. Logo preciso:
             - Verificar colaboradores que possuam esta permissão (permissões da R034DAC que não possua
               troca de permissão vigente, área restrita da R070PEC, troca de permissão vigente);
               - Incluir vínculo dos colaboradores que possuam esta permissão de acesso para este recinto;
             - Verificar visitantes que possuam esta permissão (visita em aberto, área restrita da R070PEV);
               - Incluir vínculo dos visitantes que possuam esta permissão de acesso para este recinto;
           Obs.: é necessário que o colaborador/visitante tenha um crachá ativo. */
        FOREACH c_prmcol INTO l_prmcol.NUMEMP,
                              l_prmcol.TIPCOL,
                              l_prmcol.NUMCAD
        LOOP
            l_gerpen := FALSE;
            IF (l_prmcol.TIPCOL = 1) THEN
                IF (l_gerpen_emp = TRUE) THEN
                    l_gerpen := TRUE;
                END IF;
            ELSE
                IF (l_prmcol.TIPCOL = 2) THEN
                    IF (l_gerpen_ter = TRUE) THEN
                        l_gerpen := TRUE;
                    END IF;
                ELSE
                    IF (l_prmcol.TIPCOL = 3) THEN
                        IF (l_gerpen_par = TRUE) THEN
                            l_gerpen := TRUE;
                        END IF;
                    END IF;
                END IF;
            END IF;

            IF (l_gerpen = TRUE) THEN
                /* Verifico se esse recinto já está presente p/ o colaborador (registro 1 - Atualizado e 2 - Ativo p/ este recinto ) */
                BEGIN
                    SELECT NUMCRA INTO l_numcra FROM R151CCR 
                     WHERE NUMEMP = l_prmcol.NUMEMP AND TIPCOL = l_prmcol.TIPCOL AND NUMCAD = l_prmcol.NUMCAD AND
                           VERPLF = l_verplf AND CODPLF = l_codplf AND STAREC = 1 AND STAALF = 2;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN l_numcra := 0;
                END;

                IF (l_numcra = 0) THEN
                    /* Não existe vínculo entre o colaborador e o recinto */

                    /* Verifica se a pessoa tem crachá válido */
                    /* Obtem o crachá Provisório, se não existir obtem o Titular */
                    BEGIN
                        SP_RETCRA(2, l_prmcol.NUMEMP, l_prmcol.TIPCOL, l_prmcol.NUMCAD, 0, '', 0, '', l_cracha OUT);
                        IF (l_cracha = 0) THEN
                            SP_RETCRA(1, l_prmcol.NUMEMP, l_prmcol.TIPCOL, l_prmcol.NUMCAD, 0, '', 0, '', l_cracha OUT);
                        END IF;
                    EXCEPTION
                        WHEN OTHERS THEN l_cracha := 0;
                    END;

                    IF (l_cracha <> 0) THEN

                        /* Obtem a data/hora inicial e final do crachá ativo do colaborador. */
                        BEGIN
                            SELECT DATINI, HORINI, DATFIM, HORFIM, TIPCRA
                            INTO l_datini, l_horini, l_datfim, l_horfim, l_tipcra
                            FROM R038HCH
                            WHERE NUMCRA = l_cracha AND NUMEMP = l_prmcol.NUMEMP AND TIPCOL = l_prmcol.TIPCOL AND NUMCAD = l_prmcol.NUMCAD AND
                                  (DATINI < l_data_atual OR (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
                                  (DATFIM = l_data_zero OR DATFIM > l_data_atual OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
                        EXCEPTION
                            WHEN TOO_MANY_ROWS THEN
                                RAISERROR 103 'R058PRR_EI: Erro em R038HCH - TOO MANY ROWS.';
                            WHEN NO_DATA_FOUND THEN
                                RAISERROR 103 'R058PRR_EI: Erro em R038HCH - NO DATA FOUND.';
                            WHEN OTHERS THEN
                                RAISERROR 103 'R058PRR_EI: Erro no SELECT R038HCH.';
                        END;
                    END IF;

                    IF (l_cracha <> 0)  THEN
                        /* Gero uma nova pendência para este novo recinto */
                        /* Insere uma pendência do evento 1 - Credenciamento de Pessoas, para envio pelo eDocs */
                        SP_PENDADE02(1, 'I', l_verplf, l_codplf, l_codrec, l_codpen OUT);

                        BEGIN
                            INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                                 VALUES (l_codpen, l_prmcol.TIPCOL, l_prmcol.NUMEMP, l_prmcol.TIPCOL, l_prmcol.NUMCAD, NULL, NULL, l_datini, l_horini, l_tipcra, NULL, NULL);
                        EXCEPTION WHEN OTHERS THEN
                            alfmen := 'R058PRR_EI: Erro ao inserir pendência de inclusão de Credenciamento de Pessoas. Nro. Emp.: '
                                  || CONVERT(NUMBER_TO_CHAR, l_prmcol.NUMEMP) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_prmcol.TIPCOL)
                                  || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_prmcol.NUMCAD) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_codrec);
                            RAISERROR 103 alfmen;
                        END;

                        BEGIN
                            INSERT INTO R151CCR (CODPEN, NUMEMP, TIPCOL, NUMCAD, NUMCRA, DATINI, HORINI, DATFIM, HORFIM, TIPCRA, VERPLF, CODPLF, CODREC, STAREC, STAALF)
                                 VALUES (l_codpen, l_prmcol.NUMEMP, l_prmcol.TIPCOL, l_prmcol.NUMCAD, l_cracha, l_datini, l_horini, l_datfim, l_horfim, l_tipcra,
                                         l_verplf, l_codplf, l_codrec, 1, 2);
                        EXCEPTION WHEN OTHERS THEN
                            alfmen := 'R058PRR_EI: Erro ao inserir crachá atual do colaborador na R151CCR. Nro. Emp.: '
                                  || CONVERT(NUMBER_TO_CHAR, l_prmcol.NUMEMP) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_prmcol.TIPCOL)
                                  || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_prmcol.NUMCAD) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_codrec);
                            RAISERROR 103 alfmen;
                        END;
                    END IF; /* IF (l_cracha <> 0)  THEN */
                END IF; /* IF (l_numcra = 0) THEN */
            END IF; /* IF (l_gerpen = TRUE) THEN */
        END LOOP; /* LOOP */

        IF (l_gerpen_vis = TRUE) THEN
            FOREACH c_prmvis INTO l_prmvis.TIPDOC,
                                  l_prmvis.NUMDOC,
                                  l_prmvis.NUMCRA,
                                  l_prmvis.DATINI,
                                  l_prmvis.HORINI,
                                  l_prmvis.DATFIM,
                                  l_prmvis.HORFIM,
                                  l_prmvis.SEQENT
            LOOP

                /* Verifico se esse recinto já está presente p/ o visitante (registro 1 - Atualizado e 2 - Ativo p/ este recinto ) */
                BEGIN
                    SELECT NUMCRA INTO l_numcra FROM R151CVR
                     WHERE TIPDOC = l_prmvis.TIPDOC AND NUMDOC = l_prmvis.NUMDOC AND
                           VERPLF = l_verplf AND CODPLF = l_codplf AND STAREC = 1 AND STAALF = 2;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN l_numcra := 0;
                END;

                IF (l_numcra = 0) THEN
                    /* Não existe vínculo entre o visitante e o recinto */

                    /* Não preciso verificar se possui crachá válido, pois o select de visitante
                       já cruza com o crachá, e me traz as informações do crachá do visitante.
                       Só considero o visitante, caso a permissão c/ dispositivos em recintos
                       aduaneiros esteja associada a ele através da movimentação de visita ou
                       da área restrita de visitante E possua crachá de visitante em aberto */

                    /* Gero uma nova pendência para este novo recinto */
                    /* Insere uma pendência do evento 1 - Credenciamento de Pessoas, para envio pelo eDocs */
                    SP_PENDADE02(1, 'I', l_verplf, l_codplf, l_codrec, l_codpen OUT);

                    BEGIN
                        INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                             VALUES (l_codpen, 4, NULL, NULL, NULL, l_prmvis.TIPDOC, l_prmvis.NUMDOC, l_prmvis.DATINI, l_prmvis.HORINI, NULL, l_prmvis.SEQENT, NULL);
                    EXCEPTION WHEN OTHERS THEN
                        alfmen := 'R058PRR_EI: Erro ao inserir pendência de inclusão de Credenciamento de Pessoas. Tipo Doc.: '
                          || CONVERT(NUMBER_TO_CHAR, l_prmvis.TIPDOC) || '. Nro. Doc.: ' || l_prmvis.NUMDOC || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_codrec);
                        RAISERROR 103 alfmen;
                    END;

                    BEGIN
                        INSERT INTO R151CVR (CODPEN, TIPDOC, NUMDOC, NUMCRA, DATINI, HORINI, DATFIM, HORFIM, SEQENT, VERPLF, CODPLF, CODREC, STAREC, STAALF)
                             VALUES (l_codpen, l_prmvis.TIPDOC, l_prmvis.NUMDOC, l_prmvis.NUMCRA, l_prmvis.DATINI, l_prmvis.HORINI, l_prmvis.DATFIM, l_prmvis.HORFIM, l_prmvis.SEQENT,
                                     l_verplf, l_codplf, l_codrec, 1, 2);
                    EXCEPTION WHEN OTHERS THEN
                        alfmen := 'R058PRR_EI: Erro ao inserir crachá atual do visitante na R151CVR. Tipo Doc.: '
                          || CONVERT(NUMBER_TO_CHAR, l_prmvis.TIPDOC) || '. Nro. Doc.: ' || l_prmvis.NUMDOC || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_codrec);
                        RAISERROR 103 alfmen;
                    END;
                END IF; /* IF (l_numcra = 0) THEN */
            END LOOP; /* LOOP */
        END IF; /* IF (l_gerpen_vis = TRUE) THEN */
    END IF; /* IF (l_codrec > 0)  THEN */
END␀Ø␀␀		SENIOR;0é?␀␀

TRIGGER R058PRR_ED AFTER DELETE ON R058PRR FOR EACH ROW
DECLARE

    l_data_atual DATE;
    l_data_zero  DATE;
    l_hora_atual NUMBER(4);
    l_codrec     NUMBER(15);
    l_codpen     NUMBER(18);
    l_numcra     NUMBER(12);
    l_verplf     NUMBER(3);
    l_codplf     NUMBER(7);
    l_datini     DATE;
    l_horini     NUMBER(4);
    l_tipcra     NUMBER(1);
    l_protcl     VARCHAR2(36);
    l_gerpen_emp BOOLEAN;
    l_gerpen_ter BOOLEAN;
    l_gerpen_par BOOLEAN;
    l_gerpen_vis BOOLEAN;
    l_gerpen     BOOLEAN;
    alfmen       VARCHAR2(255);

    l_temdac     NUMBER(1);
    l_tempec     NUMBER(1);
    l_tempev     NUMBER(1);

    CURSOR c_prmcol IS SELECT DAC.NUMEMP, DAC.TIPCOL, DAC.NUMCAD FROM R034DAC DAC
                        WHERE (DAC.CODPRM = :OLD.CODPRM OR DAC.PRMSAB = :OLD.CODPRM OR DAC.PRMDOM = :OLD.CODPRM OR DAC.PRMFER = :OLD.CODPRM)
                          AND NOT EXISTS
                              (SELECT 1 FROM R064TPE TPC
                                WHERE TPC.NUMEMP = DAC.NUMEMP AND TPC.TIPCOL = DAC.TIPCOL AND TPC.NUMCAD = DAC.NUMCAD
                                  AND TPC.STAACC = 1 AND (TPC.DATFIM = l_data_zero OR TPC.DATFIM > l_data_atual OR
                                      (TPC.DATFIM = l_data_atual AND TPC.HORFIM > l_hora_atual)))
                       UNION(
                       SELECT PEC.NUMEMP, PEC.TIPCOL, PEC.NUMCAD FROM R070PEC PEC
                        WHERE PEC.CODPRM = :OLD.CODPRM AND PEC.STAACC = 1
                          AND (PEC.DATFIM = l_data_zero OR PEC.DATFIM > l_data_atual OR
                              (PEC.DATFIM = l_data_atual AND PEC.HORFIM > l_hora_atual))
                       UNION(
                       SELECT TPE.NUMEMP, TPE.TIPCOL, TPE.NUMCAD FROM R064TPE TPE
                        WHERE (TPE.CODPRM = :OLD.CODPRM OR TPE.PRMSAB = :OLD.CODPRM OR TPE.PRMDOM = :OLD.CODPRM OR TPE.PRMFER = :OLD.CODPRM)
                          AND TPE.STAACC = 1 AND (TPE.DATFIM = l_data_zero OR TPE.DATFIM > l_data_atual OR
                              (TPE.DATFIM = l_data_atual AND TPE.HORFIM > l_hora_atual))));

    CURSOR c_prmvis IS SELECT HCH.TIPDOC, HCH.NUMDOC, HCH.NUMCRA, HCH.DATINI, HCH.HORINI, HCH.SEQENT
                         FROM R090HCH HCH, R090MVI MVI
                        WHERE HCH.DATINI = MVI.DATENT AND HCH.HORINI = MVI.HORENT AND HCH.SEQENT = MVI.SEQENT
                          AND MVI.CODPRM = :OLD.CODPRM AND MVI.DATSAI = l_data_zero
                       UNION(
                       SELECT HC2.TIPDOC, HC2.NUMDOC, HC2.NUMCRA, HC2.DATINI, HC2.HORINI, HC2.SEQENT
                         FROM R090HCH HC2, R070PEV PEV
                        WHERE HC2.TIPDOC = PEV.TIPDOC AND HC2.NUMDOC = PEV.NUMDOC
                          AND PEV.CODPRM = :OLD.CODPRM AND PEV.STAACC = 1
                          AND (PEV.DATFIM = l_data_zero OR PEV.DATFIM > l_data_atual OR
                              (PEV.DATFIM = l_data_atual AND PEV.HORFIM > l_hora_atual))
                          AND (HC2.DATINI < l_data_atual OR
                              (HC2.DATINI = l_data_atual AND HC2.HORINI <= l_hora_atual))
                          AND (HC2.DATFIM = l_data_zero OR HC2.DATFIM > l_data_atual OR
                              (HC2.DATFIM = l_data_atual AND HC2.HORFIM >= l_hora_atual)));

    TYPE t_prmcol IS RECORD(
           NUMEMP   R034DAC.NumEmp%TYPE,
           TIPCOL   R034DAC.TipCol%TYPE,
           NUMCAD   R034DAC.NumCad%TYPE);

    TYPE t_prmvis IS RECORD(
           TIPDOC   R090VIS.TipDoc%TYPE,
           NUMDOC   R090VIS.NumDoc%TYPE,
           NUMCRA   R090HCH.NumCra%TYPE,
           DATINI   R090HCH.DatIni%TYPE,
           HORINI   R090HCH.HorIni%TYPE,
           SEQENT   R090HCH.SeqEnt%TYPE);

    l_prmcol t_prmcol;
    l_prmvis t_prmvis;

BEGIN
    l_verplf := :OLD.VERPLF;
    l_codplf := :OLD.CODPLF;

    BEGIN
        SELECT CODREC INTO l_codrec FROM R058PLF WHERE VERPLF = l_verplf AND CODPLF = l_codplf;
    EXCEPTION
        WHEN OTHERS THEN l_codrec := 0;
    END;

    IF (l_codrec > 0)  THEN
        /* Verifico os tipos de pessoas, se devo gerar pendência de credenciamento */
        SP_RECALF_GERPEN(11, l_gerpen_emp OUT); /* Credenciamento-pessoas - Empregado */
        SP_RECALF_GERPEN(12, l_gerpen_ter OUT); /* Credenciamento-pessoas - Terceiro */
        SP_RECALF_GERPEN(13, l_gerpen_par OUT); /* Credenciamento-pessoas - Parceiro */
        SP_RECALF_GERPEN(14, l_gerpen_vis OUT); /* Credenciamento-pessoas - Visitante */

        l_data_atual := CURDATE();
        l_data_zero  := '31/12/1900,00:00:00';
        l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

        /* Excluí um recinto aduaneiro da permissão. Logo preciso: */
        /*   - Buscar todos os colaboradores que possuem a permissão 5
             - Pra cada colaborador que possui a permissão 5 (por ex., que deixou de ser alfandegada):
               - Pega o recinto Rec5 da permissão 5 (VerPlf, CodPlf).
               - Verifica se o colaborador ainda possui alguma permissão que dê acesso ao recinto Rec5 (VerPlf, CodPlf das permissões normal, sáb, dom, fer,
                 troca de permissão ou áreas restritas).
                 - Se não tiver mais nenhuma, retifico (inativando) o vínculo do colaborador ao recinto aduaneiro.
                 - Obs.: Não preciso buscar crachá para saber qual é o crachá do colaborador. Só removo o vínculo do colaborador ao recinto aduaneiro.
                 - Obs2.: Neste ponto, já não existe mais a permissão 5 vinculado ao recinto, na tabela R058PRR (registro excluído).
                          Logo, estou realmente procurando pelas demais permissões (se existirem) que dão acesso ao mesmo recinto que a permissão 5. */
        /*   - Buscar todos os visitantes que possuem a permissão 5
             - Pra cada visitante que possui a permissão 5 (por ex., que deixou de ser alfandegada):
               - Verifica se o visitante ainda possui alguma permissão que dê acesso ao recinto Rec5 (somente por áreas restritas).
                 - Se não tiver mais nenhuma, retifico (inativando) o vínculo do visitante ao recinto aduaneiro.
                 - Obs.: Na busca pelos visitantes que possuem a permissão, já trago junto as informações do crachá. 
                 - Obs2.: Neste ponto, já não existe mais a permissão 5 vinculado ao recinto, na tabela R058PRR (registro excluído).
                          Logo, estou realmente procurando pelas demais permissões (se existirem) que dão acesso ao mesmo recinto que a permissão 5. */
        FOREACH c_prmcol INTO l_prmcol.NUMEMP,
                              l_prmcol.TIPCOL,
                              l_prmcol.NUMCAD
        LOOP
            l_gerpen := FALSE;
            IF (l_prmcol.TIPCOL = 1) THEN
                IF (l_gerpen_emp = TRUE) THEN
                    l_gerpen := TRUE;
                END IF;
            ELSE
                IF (l_prmcol.TIPCOL = 2) THEN
                    IF (l_gerpen_ter = TRUE) THEN
                        l_gerpen := TRUE;
                    END IF;
                ELSE
                    IF (l_prmcol.TIPCOL = 3) THEN
                        IF (l_gerpen_par = TRUE) THEN
                            l_gerpen := TRUE;
                        END IF;
                    END IF;
                END IF;
            END IF;

            IF (l_gerpen = TRUE) THEN
                /* Outras permissões do colaborador que dão acesso ao recinto da permissão excluída */
                BEGIN
                    SELECT 1 INTO l_temdac FROM R034DAC DAC, R058PRR PRR
                     WHERE DAC.NUMEMP = l_prmcol.NUMEMP AND DAC.TIPCOL = l_prmcol.TIPCOL AND DAC.NUMCAD = l_prmcol.NUMCAD
                       AND (DAC.CODPRM = PRR.CODPRM OR DAC.PRMSAB = PRR.CODPRM OR DAC.PRMDOM = PRR.CODPRM OR DAC.PRMFER = PRR.CODPRM)
                       AND PRR.VERPLF = l_verplf AND PRR.CODPLF = l_codplf;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN l_temdac := 0;
                    WHEN OTHERS THEN l_temdac := 0;
                END;

                /* Outras áreas restritas do colaborador que dão acesso ao recinto da permissão excluída */
                BEGIN
                    SELECT 1 INTO l_tempec FROM R070PEC PEC, R058PRR PRR
                     WHERE PEC.NUMEMP = l_prmcol.NUMEMP AND PEC.TIPCOL = l_prmcol.TIPCOL AND PEC.NUMCAD = l_prmcol.NUMCAD
                       AND PEC.CODPRM = PRR.CODPRM AND PRR.VERPLF = l_verplf AND PRR.CODPLF = l_codplf
                       AND PEC.STAACC = 1
                       AND (PEC.DATFIM = l_data_zero OR PEC.DATFIM > l_data_atual OR
                           (PEC.DATFIM = l_data_atual AND PEC.HORFIM > l_hora_atual));
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN l_tempec := 0;
                    WHEN OTHERS THEN l_tempec := 0;
                END;

                IF (l_temdac = 0 AND l_tempec = 0) THEN
                    /* Retifico (inativando) o vínculo do colaborador ao recinto aduaneiro */

                    /* Busco as informações da credencial para este recinto, p/ gerar a pendência de retificação */
                    BEGIN
                        SELECT NUMCRA, DATINI, HORINI, TIPCRA, PROTCL INTO l_numcra, l_datini, l_horini, l_tipcra, l_protcl FROM R151CCR 
                         WHERE NUMEMP = l_prmcol.NUMEMP AND TIPCOL = l_prmcol.TIPCOL AND NUMCAD = l_prmcol.NUMCAD AND
                               VERPLF = l_verplf AND CODPLF = l_codplf AND STAREC = 1 AND STAALF = 2;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN l_numcra := 0;
                    END;

                    IF (l_numcra > 0) THEN
                        /* --- Envio a pendência de retificação de credencial --- */
                        SP_PENDADE02(1, 'R', l_verplf, l_codplf, l_codrec, l_codpen OUT);

                        BEGIN
                            INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                                    VALUES (l_codpen, l_prmcol.TIPCOL, l_prmcol.NUMEMP, l_prmcol.TIPCOL, l_prmcol.NUMCAD, NULL, NULL, l_datini, l_horini, l_tipcra, NULL, l_protcl);
                        EXCEPTION
                        WHEN OTHERS THEN
                            alfmen := 'R058PRR_ED: Erro ao inserir pendência de retificação de Credenciamento de Pessoas. Nro. Emp.: '
                                      || CONVERT(NUMBER_TO_CHAR, l_prmcol.NUMEMP) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_prmcol.TIPCOL)
                                      || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_prmcol.NUMCAD) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_codrec);
                            RAISERROR 103 alfmen;
                        END;
                        /* --- --- */

                        /* --- Atualizo o status do registro para 2 - Histórico, e o recinto para 1 - Inativo. Apenas para este recinto --- */
                        BEGIN
                            UPDATE R151CCR SET STAREC = 2, STAALF = 1, DATFIM = l_data_atual, HORFIM = l_hora_atual
                             WHERE NUMEMP = l_prmcol.NUMEMP AND TIPCOL = l_prmcol.TIPCOL AND NUMCAD = l_prmcol.NUMCAD AND CODREC = l_codrec
                               AND STAREC = 1 AND STAALF = 2;
                        EXCEPTION WHEN OTHERS THEN
                            alfmen := 'R058PRR_ED: Erro ao atualizar crachá atual do colaborador na R151CCR. Nro. Emp.: '
                                      || CONVERT(NUMBER_TO_CHAR, l_prmcol.NUMEMP) || '. Tipo Col.: ' || CONVERT(NUMBER_TO_CHAR, l_prmcol.TIPCOL)
                                      || '. Nro. Cad.: ' || CONVERT(NUMBER_TO_CHAR, l_prmcol.NUMCAD) || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_codrec);
                            RAISERROR 103 alfmen;
                        END;
                        /* --- --- */
                    END IF; /* IF (l_numcra > 0) THEN */
                END IF; /* IF (l_temdac = 0 AND l_tempec = 0) THEN */
            END IF; /* IF (l_gerpen = TRUE) THEN */
        END LOOP; /* LOOP */

        IF (l_gerpen_vis = TRUE) THEN
            FOREACH c_prmvis INTO l_prmvis.TIPDOC,
                                  l_prmvis.NUMDOC,
                                  l_prmvis.NUMCRA,
                                  l_prmvis.DATINI,
                                  l_prmvis.HORINI,
                                  l_prmvis.SEQENT
            LOOP

                /* Outras áreas restritas do colaborador que dão acesso ao recinto da permissão excluída */
                BEGIN
                    SELECT 1 INTO l_tempev FROM R070PEV PEV, R058PRR PRR
                     WHERE PEV.TIPDOC = l_prmvis.TIPDOC AND PEV.NUMDOC = l_prmvis.NUMDOC
                       AND PEV.CODPRM = PRR.CODPRM AND PRR.VERPLF = l_verplf AND PRR.CODPLF = l_codplf
                       AND PEV.STAACC = 1
                       AND (PEV.DATFIM = l_data_zero OR PEV.DATFIM > l_data_atual OR
                           (PEV.DATFIM = l_data_atual AND PEV.HORFIM > l_hora_atual));
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN l_tempev := 0;
                    WHEN OTHERS THEN l_tempev := 0;
                END;

                IF (l_tempev = 0) THEN
                    /* Removo o vínculo do visitante ao recinto aduaneiro. Já possuo as informações da credencial. */

                    /* Busco a informação do protocolo da credencial para este recinto, p/ gerar a pendência de retificação */
                    BEGIN
                        SELECT PROTCL INTO l_protcl FROM R151CVR 
                         WHERE TIPDOC = l_prmvis.TIPDOC AND NUMDOC = l_prmvis.NUMDOC AND
                               DATINI = l_prmvis.DATINI AND HORINI = l_prmvis.HORINI AND SEQENT = l_prmvis.SEQENT AND
                               VERPLF = l_verplf AND CODPLF = l_codplf AND STAREC = 1 AND STAALF = 2;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN l_protcl := NULL;
                    END;

                    /* --- Envio a pendência de retificação de credencial --- */
                    SP_PENDADE02(1, 'R', l_verplf, l_codplf, l_codrec, l_codpen OUT);

                    BEGIN
                        INSERT INTO R152CRE (CODPEN, TIPPES, NUMEMP, TIPCOL, NUMCAD, TIPDOC, NUMDOC, DATINI, HORINI, TIPCRA, SEQENT, PROORI)
                                VALUES (l_codpen, 4, NULL, NULL, NULL, l_prmvis.TIPDOC, l_prmvis.NUMDOC, l_prmvis.DATINI, l_prmvis.HORINI, NULL, l_prmvis.SEQENT, l_protcl);
                    EXCEPTION
                    WHEN OTHERS THEN
                        alfmen := 'R058PRR_ED: Erro ao inserir pendência de retificação de Credenciamento de Pessoas. Tipo Doc.: '
                          || CONVERT(NUMBER_TO_CHAR, l_prmvis.TIPDOC) || '. Nro. Doc.: ' || l_prmvis.NUMDOC|| '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_codrec);
                        RAISERROR 103 alfmen;
                    END;
                    /* --- --- */

                    /* --- Atualizo o status do registro para 2 - Histórico, e o recinto para 1 - Inativo. Apenas para este recinto --- */
                    BEGIN
                        UPDATE R151CVR SET STAREC = 2, STAALF = 1, DATFIM = l_data_atual, HORFIM = l_hora_atual
                         WHERE TIPDOC = l_prmvis.TIPDOC AND NUMDOC = l_prmvis.NUMDOC AND CODREC = l_codrec
                           AND STAREC = 1 AND STAALF = 2;
                    EXCEPTION WHEN OTHERS THEN
                        alfmen := 'R058PRR_ED: Erro ao atualizar crachá atual do visitante na R151CVR. Tipo Doc.: '
                          || CONVERT(NUMBER_TO_CHAR, l_prmvis.TIPDOC) || '. Nro. Doc.: ' || l_prmvis.NUMDOC || '. Recinto: ' || CONVERT(NUMBER_TO_CHAR, l_codrec);
                        RAISERROR 103 alfmen;
                    END;
                    /* --- --- */
                END IF; /* IF (l_tempev = 0) THEN */
            END LOOP; /* LOOP */
        END IF; /* IF (l_gerpen_vis = TRUE) THEN */
    END IF; /* IF (l_codrec > 0)  THEN */
END␀␀␀Dî␀␀␀␀␀␀Ø␀␀m,Ì␀	␀␀␀␀␀␀ö]ö]ö]{␀Æÿ␀␀…×␀␀␀È␀␀›	␀␀␀␀␀␀ÎÃ␀␀ÎÃ␀␀ÎÃ␀␀n␀Æÿ␀␀ÿ␀2 ␀␀F␀␀␀␀␀␀±¡␀␀©¡␀␀©¡␀␀n␀Æÿ␀␀ÿ␀³␀´␀␀␀␀␀␀␀"S!S!Sr␀Æÿ␀␀ÿ␀jí␀␀´␀␀␀␀␀␀␀SSSr␀Æÿ␀␀ÿ␀t¹␀␀´␀␀␀␀␀␀␀½␀Â␀Â␀r␀Æÿ␀␀ÿ␀bõ␀␀´␀␀␀␀␀␀␀»␀º␀º␀r␀Æÿ␀␀ÿ␀ÊÂ␀␀´␀␀␀␀␀␀␀¾␀Á␀Á␀r␀Æÿ␀␀ÿ␀ÇÂ␀␀´␀␀␀␀␀␀␀¿␀À␀À␀r␀Æÿ␀␀ÿ␀␀␀␀0;1Ø␀␀		SENIOR;0»TRIGGER R058PRT_EI AFTER INSERT ON R058PRT FOR EACH ROW

DECLARE
	l_coddsp VARCHAR2(9);

BEGIN
	SP_INTSTR(:NEW.CODDSP, '999999999', l_coddsp OUT);
	SP_SAM_PENDENCIES(23, 2, l_coddsp);
END␀Ø␀␀		SENIOR;0½␀␀

TRIGGER R058PRT_EU AFTER UPDATE ON R058PRT FOR EACH ROW

DECLARE
	l_coddsp VARCHAR2(9);

BEGIN

	IF (:NEW.MODCOM <> :OLD.MODCOM) OR
		(:NEW.TXDDLY <> :OLD.TXDDLY) OR
		(:NEW.RCBDLY <> :OLD.RCBDLY) OR
		(:NEW.PACTIM <> :OLD.PACTIM) OR
		(:NEW.RSPTIM <> :OLD.RSPTIM) OR
		(:NEW.POLTIM <> :OLD.POLTIM) OR
		(:NEW.POLOFF <> :OLD.POLOFF)
	THEN
		SP_INTSTR(:NEW.CODDSP, '999999999', l_coddsp OUT);
		SP_SAM_PENDENCIES(23, 2, l_coddsp);
	END IF;

END␀Ø␀␀		SENIOR;0½

TRIGGER R058PRT_ED AFTER DELETE ON R058PRT FOR EACH ROW

DECLARE
	l_coddsp VARCHAR2(9);

BEGIN
	SP_INTSTR(:OLD.CODDSP, '999999999', l_coddsp OUT);
	SP_SAM_PENDENCIES(23, 2, l_coddsp);
END␀␀␀¾2␀␀␀␀␀␀␀␀␀␀	Ø␀␀¬-Ì␀␀␀␀␀␀␀N@ã
