  END IF;
  l_FaiAc1 := lTrim(l_FaiAc1);
  l_FaiAc1 := rTrim(l_FaiAc1);
  LOOP
      /*Controle do Loop.*/
      IF (Length(l_FaiAc1) > 55 ) THEN
