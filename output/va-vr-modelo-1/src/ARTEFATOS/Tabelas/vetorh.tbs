	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados/excluídos.';
	END IF;
END␀␀␀4*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Âå␀␀…¬␀␀´␀	Ôÿ?ü␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀‚¬␀␀	Ôÿ?ü␀␀␀␀Ä±␀␀<¯␀␀\±␀␀%␀␀ÿ␀␀ÿ␀[¬␀␀	Ôÿ?ü␀␀␀␀±␀␀±␀␀±␀␀%␀␀ÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀vEÑ␀	Ôÿ?ü␀␀␀␀9J`HÆIqC␀êÿ␀␀ÿ␀ÌEÑ␀	Ôÿ?ü␀␀␀␀ÏLöHóIqC␀êÿ␀␀ÿ␀5Â␀␀EÔÿ␀␀␀␀␀,Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀)+Ñ␀Ôÿ␀␀␀␀␀M&M&M&qC␀␀êÿ␀␀ÿ␀++Ñ␀Ôÿ␀␀␀␀␀U&U&U&qC␀␀êÿ␀␀ÿ␀,+Ç␀Ôÿ␀␀␀␀␀W&W&W&z␀Æÿ␀␀ÿ␀-+Ç␀Ôÿ␀␀␀␀␀Y&Y&Y&z␀Æÿ␀␀ÿ␀.+Ç␀Ôÿ␀␀␀␀␀[&[&[&z␀Æÿ␀␀ÿ␀/+Ç␀Ôÿ␀␀␀␀␀\&\&\&z␀Æÿ␀␀ÿ␀0+'Ôÿ␀␀␀␀␀]&]&]&D␀␀ÿ␀␀ÿ␀1+'Ôÿ␀␀␀␀␀^&^&^&D␀␀ÿ␀␀ÿ␀2+*Ôÿ␀␀␀␀␀_&_&_&,␀␀ÿ␀␀ÿ␀␀␀Ãå␀␀␀␀0;1;2;3Éå␀␀	SENIOR;0(␀␀

TRIGGER R304PRO_SI AFTER INSERT ON R304PRO
DECLARE
	CURSOR c_R304PRO IS
	SELECT NUMEMP, NUMEDI, NUMATO, SEQREG, DATPRO
	  FROM R304PRO
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304PRO IS RECORD (
		NUMEMP   R304PRO.NumEmp%TYPE,
		NUMEDI   R304PRO.NumEdi%TYPE,
		NUMATO   R304PRO.NumAto%TYPE,
		SEQREG   R304PRO.SeqReg%TYPE,
		DATPRO   R304PRO.DatPro%TYPE
	);
    
    l_R304PRO t_R304PRO;
    
	l_PidSta   R304PRO.PidSta%TYPE;
	l_DesRes   R304STA.DesRes%TYPE;
BEGIN
	FOREACH c_R304PRO INTO l_R304PRO.NumEmp, l_R304PRO.NumEdi, l_R304PRO.NumAto, l_R304PRO.SeqReg, l_R304PRO.DatPro
	LOOP
		/* Gera um novo PID */
		SP_GERPIDSTA(l_R304PRO.NumEmp, 4, l_PidSta OUT);

		l_DesRes := 'Número do Edital: ' || l_R304PRO.NumEdi || ', Número do Ato: ' || l_R304PRO.NumAto;

		/* Inclui registro de status na tabela R304STA */
		SP_GERSTA_ESFINGE(4, l_PidSta, l_R304PRO.DatPro, l_DesRes, l_R304PRO.NumEmp, 0, 0);
		
		/* Grava o PID gerado no campo PIDSTA da própria tabela */
		BEGIN
			UPDATE R304PRO
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304PRO.NumEmp
			   AND NUMEDI = l_R304PRO.NumEdi
			   AND NUMATO = l_R304PRO.NumAto
			   AND SEQREG = l_R304PRO.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304PRO.';		
		END;
	END LOOP;
END␀Æå␀␀		SENIOR;0c␀␀TRIGGER R304PRO_EI BEFORE INSERT ON R304PRO FOR EACH ROW
DECLARE
	l_QtdReg NUMBER;
	l_SeqReg NUMBER(9);
	l_StaEnv CHAR;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Verifica se já existe o concurso/processo seletivo na R304CON */
	BEGIN
		SELECT COUNT(1) INTO l_QtdReg FROM R304CON WHERE NUMEMP = :NEW.NumEmp AND NUMEDI = :NEW.NumEdi;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_QtdReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao verificar se existe registro na tabela R304CON.';
	END;
	
	IF (l_QtdReg = 0) THEN
		l_MsgErr := 'Não existe registro de Concurso/Processo Seletivo com as seguintes chaves: ' ||
			'Empresa: ' || CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp) || ', Edital: ' || :NEW.NumEdi || '.';
		RAISERROR 103 l_MsgErr;
	END IF;

	/* Busca última sequência cadastrada */
	BEGIN
		SELECT PRO.SEQREG, STA.STAENV INTO l_SeqReg, l_StaEnv FROM R304PRO PRO, R304STA STA
		 WHERE PRO.NUMEMP = :NEW.NumEmp
		   AND PRO.NUMEDI = :NEW.NumEdi
		   AND PRO.NUMATO = :NEW.NumAto
		   AND PRO.PIDSTA = STA.PIDSTA
		   AND PRO.SEQREG = (SELECT MAX(PRO2.SEQREG) FROM R304PRO PRO2
		   					  WHERE PRO2.NUMEMP = PRO.NUMEMP
		   					    AND PRO2.NUMEDI = PRO.NUMEDI
		   					    AND PRO2.NUMATO = PRO.NUMATO);
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
			l_StaEnv := '';
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304PRO.';
	END;
	
	/* Verifica se encontrou última sequência */
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
		
		/* Verifica se a última sequência está com status Cancelado */
		IF (l_StaEnv <> 'N') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que registro de sequência anterior ' || l_SeqRegStr || ' esteja com status Cancelado.';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;

	/* Verifica se já tem algum outro registro com a mesma chave que esteja com status "P - Pendente Envio" */
	BEGIN
		SELECT R304PRO.SEQREG INTO l_SeqReg
		  FROM R304PRO, R304STA
		 WHERE R304PRO.PIDSTA = R304STA.PIDSTA
		   AND R304PRO.NUMEMP = :NEW.NumEmp
		   AND R304PRO.NUMEDI = :NEW.NumEdi
		   AND R304PRO.NUMATO = :NEW.NumAto
		   AND R304STA.STAENV = 'P';
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN TOO_MANY_ROWS THEN
			RAISERROR 103 'Foi encontrado mais de um registro para mesma chave com status com situação Pendente Envio.';	
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao tentar encontrar outro registro registro para mesma chave com status com situação Pendente Envio.';
	END;
	
	IF (l_SeqReg > 0) THEN
		l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
		l_MsgErr := 'O registro de sequência ' || l_SeqRegStr || ' está pendente, é necessário realizar seu envio antes de incluir uma nova sequência.';
		RAISERROR 103 l_MsgErr;
	END IF;
END␀Åå␀␀		SENIOR;04␀␀

TRIGGER R304PRO_AU AFTER UPDATE ON R304PRO FOR EACH ROW
BEGIN
	IF (:OLD.DatPro <> :NEW.DatPro) THEN
		BEGIN
			UPDATE R304STA SET DATREF = :NEW.DatPro WHERE PIDSTA = :NEW.PidSta;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar data de referência na tabela R304STA';
		END;
	END IF;
END␀Çå␀␀		SENIOR;0²␀␀

TRIGGER R304PRO_EU BEFORE UPDATE ON R304PRO FOR EACH ROW
DECLARE
	l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
	/* Não deixa alterar registro caso status seja diferente de P - Pendente Envio ou R - Erro Envio */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados/excluídos.';
	END IF;
END␀Èå␀␀	SENIOR;0.␀␀

TRIGGER R304PRO_SD AFTER DELETE ON R304PRO
BEGIN
	BEGIN
		DELETE FROM R304STA
		 WHERE LAYOUT = 4
		   AND NOT EXISTS (SELECT 1 FROM R304PRO WHERE R304PRO.PIDSTA = R304STA.PIDSTA);
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao excluir registros não utilizados na tabela R304STA.';
	END;
END␀Äå␀␀		SENIOR;0d

TRIGGER R304PRO_AD AFTER DELETE ON R304PRO FOR EACH ROW
BEGIN
	SP_EXCSTA_ESFINGE(:OLD.PidSta);
END␀␀␀2*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Êå␀␀…¬␀␀´␀	Ôÿ?ü␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀Ñ␀␀Ñ␀	Ôÿ␀␀␀␀␀7²␀␀¥␀␀¥␀␀œ␀␀␀êÿ␀␀ÿ␀␀¤	Ôÿ␀␀␀␀␀U␀U␀U␀p␀Æÿ␀␀ÿ␀U'	Ôÿ?␀␀␀␀␀ûAİ'	@%␀␀ÿ␀␀ÿ␀EÑ␀	Ôÿ␀␀␀␀␀+Kì”␀␀+KqC␀êÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀:Ê␀␀Ç␀Ôÿ␀␀␀␀␀NÍ␀␀␀uÌ␀␀z␀␀Æÿ␀␀ÿ␀Ê␀␀Ç␀Ôÿ␀␀␀␀␀(Í␀␀FË␀␀tÌ␀␀z␀␀Æÿ␀␀ÿ␀øÉ␀␀Ç␀Ôÿ␀␀␀␀␀zÌ␀␀EË␀␀sÌ␀␀z␀␀Æÿ␀␀ÿ␀f´␀Ôÿ?␀␀␀␀␀÷<ïe»fr␀␀Æÿ␀␀)Ñ␀␀␀0,4Ôÿ?␀␀␀␀␀ÿ?µ'µ'}␀␀␀ÿ␀␀Ñ␀␀␀5Â␀␀EÔÿ␀␀␀␀␀,Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀)+Ñ␀Ôÿ␀␀␀␀␀M&M&M&qC␀␀êÿ␀␀ÿ␀++Ñ␀Ôÿ␀␀␀␀␀U&U&U&qC␀␀êÿ␀␀ÿ␀,+Ç␀Ôÿ␀␀␀␀␀W&W&W&z␀Æÿ␀␀ÿ␀-+Ç␀Ôÿ␀␀␀␀␀Y&Y&Y&z␀Æÿ␀␀ÿ␀.+Ç␀Ôÿ␀␀␀␀␀[&[&[&z␀Æÿ␀␀ÿ␀/+Ç␀Ôÿ␀␀␀␀␀\&\&\&z␀Æÿ␀␀ÿ␀0+'Ôÿ␀␀␀␀␀]&]&]&D␀␀ÿ␀␀ÿ␀1+'Ôÿ␀␀␀␀␀^&^&^&D␀␀ÿ␀␀ÿ␀2+*Ôÿ␀␀␀␀␀_&_&_&,␀␀ÿ␀␀ÿ␀␀␀Ëå␀␀␀␀0;1;2;3;4;5Ïå␀␀	SENIOR;0Ê
