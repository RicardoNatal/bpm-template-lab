TRIGGER R097MOP_SI AFTER INSERT ON R097MOP

DECLARE
/* CURSOR c/ os registros gravados no R097MOP_AUX */
  CURSOR c_r097mop_ins IS
  SELECT PROPAC, DATINI, HORINI, SEQMOV FROM r097mop_AUX;
  TYPE t_r097mop_aux IS RECORD(
    PROPAC   r097mop_AUX.PROPAC%TYPE,
    DATINI   r097mop_AUX.DATINI%TYPE,
    HORINI   r097mop_AUX.HORINI%TYPE,
    SEQMOV   r097mop_AUX.SEQMOV%TYPE);
  l_r097mop_aux t_r097mop_aux;

BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r097mop_ins INTO  l_r097mop_aux.PROPAC,
                              l_r097mop_aux.DATINI,
                              l_r097mop_aux.HORINI,
                              l_r097mop_aux.SEQMOV
  LOOP
    R097MOP_ATUCON('I', l_r097mop_aux.ProPac);
  END LOOP;
  /* Apaga Registro OLD/NEW em r097mop_AUX */
  BEGIN
    DELETE FROM r097mop_AUX;
    DROP_TEMP_TABLE R097MOP_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀àİ␀␀		SENIOR;0␀␀TRIGGER R097MOP_EI AFTER INSERT ON R097MOP FOR EACH ROW

