␀Ö␀␀␀␀0;1;2;3;4;5;6;7;8Ö␀␀		SENIOR;0²	␀␀/* Trigger de Atualizacao dos Saldos de Eventos apos */
/* Inclusao de Evento do Movimento.                  */
TRIGGER R044MOF_EI AFTER INSERT ON R044MOF FOR EACH ROW

DECLARE
l_temAud       BOOLEAN;
l_codRPA       NUMBER(15);
l_codcpa       NUMBER(4);
l_codtpa       NUMBER(4);

BEGIN
/* Geração de log de inserção de eventos variáveis */
  l_codcpa := 14;        /*l_codcpa representa a categoria e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java  */
  l_codtpa := 141;       /*l_codtpa representa a o tipo Inserir/Excluir e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java*/
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, 1, l_temAud OUT);
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);   
    SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R044MOF_EI', 'FRFIXVAR');
     
     /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
    BEGIN
	    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TipCol));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NumCad));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAL', CONVERT(NUMBER_TO_CHAR, :NEW.CodCal));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TabEve));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CodEve));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRAT', CONVERT(NUMBER_TO_CHAR, :NEW.CodRat));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQEVE', CONVERT(NUMBER_TO_CHAR, :NEW.SeqEve));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONFIN', CONVERT(NUMBER_TO_CHAR, :NEW.ConFin));		
	EXCEPTION
	    WHEN OTHERS THEN RAISERROR 103 'R044MOF_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	END;
	 
	BEGIN
	    /* insere os campos que não são chave na Tabela R995PRT (Tipo de auditoria) */
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REFFIN', CONVERT(NUMBER_TO_CHAR, :NEW.RefFin));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALFIN', CONVERT(NUMBER_TO_CHAR, :NEW.ValFin));	 
	END;	
  END IF;  
END␀Ö␀␀		SENIOR;0C␀␀

/* Trigger de Atualizacao dos Saldos de Eventos apos */
/* Alteracao de Evento do Movimento.                 */
TRIGGER R044MOF_EU AFTER UPDATE ON R044MOF FOR EACH ROW

DECLARE
l_temAud       BOOLEAN;
l_codRPA       NUMBER(15);
l_codcpa       NUMBER(4);
l_codtpa       NUMBER(4);

BEGIN
/* Geração de log de alteração de eventos fixos */
  l_codcpa := 14;        /*l_codcpa representa a categoria e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java  */
  l_codtpa := 142;       /*l_codtpa representa a o tipo Alteração e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java*/
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, 1, l_temAud OUT);
  
  IF ((:OLD.NumEmp <> :NEW.NumEmp)
	OR (:OLD.TipCol <> :NEW.TipCol)
	OR (:OLD.NumCad <> :NEW.NumCad)
	OR (:OLD.CodCal <> :NEW.CodCal)
	OR (:OLD.TabEve <> :NEW.TabEve)
	OR (:OLD.CodEve <> :NEW.CodEve)
	OR (:OLD.CodRat <> :NEW.CodRat)
	OR (:OLD.SeqEve <> :NEW.SeqEve)
	OR (:OLD.ConFin <> :NEW.ConFin)
	OR (:OLD.RefFin <> :NEW.RefFin)
	OR (:OLD.ValFin <> :NEW.ValFin)) THEN
  BEGIN
	  IF (l_temAud = TRUE) THEN
        SP_RET_REG_AUD(l_codrpa OUT);
	    SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R044MOF_EU', 'FRFIXVAR');
	     
	     /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
	    BEGIN
		    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TipCol));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NumCad));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAL', CONVERT(NUMBER_TO_CHAR, :NEW.CodCal));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TabEve));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CodEve));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRAT', CONVERT(NUMBER_TO_CHAR, :NEW.CodRat));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQEVE', CONVERT(NUMBER_TO_CHAR, :NEW.SeqEve));
			INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONFIN', CONVERT(NUMBER_TO_CHAR, :NEW.ConFin));
		EXCEPTION
		    WHEN OTHERS THEN RAISERROR 103 'R044MOF_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
		END;
		 
		BEGIN
		    /* insere os campos que não são chave na Tabela R995PRT (Tipo de auditoria) */
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDREFFIN', CONVERT(NUMBER_TO_CHAR, :OLD.RefFin));
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWREFFIN', CONVERT(NUMBER_TO_CHAR, :NEW.RefFin));
			
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVALFIN', CONVERT(NUMBER_TO_CHAR, :OLD.ValFin));
			INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWVALFIN', CONVERT(NUMBER_TO_CHAR, :NEW.ValFin));	 
		END;	
	  END IF;  
	END;
  END IF;
END␀Ö␀␀		SENIOR;0²	␀␀

/* Trigger de Atualizacao dos Saldos de Eventos apos */
/* Exclusao de Evento do Movimento.                  */
