            Unificação na pior da hipóteses, e assim sucessivamente*/
            l_iteracao := l_iteracao -1;
            LOOP
                FOREACH c_r004TMP INTO l_r004TMP.FaiIni, l_r004TMP.FaiFim, l_r004TMP.TurTrb LOOP
                    l_faiIni := l_r004TMP.FaiIni;
                    l_faiFim := l_r004TMP.FaiFim;
                    l_TurTrb := l_r004TMP.TurTrb;

                    FOREACH c_r004TMP_1 INTO l_r004TMP_1.FaiIni, l_r004TMP_1.FaiFim, l_r004TMP_1.TurTrb LOOP
                        /* compara se há sobreposição de faixas */
                        IF  (l_r004TMP_1.FaiIni <= l_FaiFim) THEN

                            /* o terceiro turno prevalece sobre o turno*/
                            IF  (l_r004TMP_1.TurTrb = 3) THEN
                                l_TurTrb := l_r004TMP_1.TurTrb;
                            END IF;

                            /* verifica qual a maior faixa final */
                            IF  (l_faifim < l_r004TMP_1.faifim) THEN
                                l_faifim := l_r004TMP_1.faifim;
                            END IF;

                            /* atualiza o campo informando qual registro não será considerado para montar a faixa */
                            UPDATE R004TMP SET TURTRB = 2 WHERE DATHOR = l_data AND TIPFAI = l_tipFai AND
                                   NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
                                   (FAIINI >= l_FaiIni AND FAIFIM <= l_faifim);

                            /* cria a nova faixa */
                            SP_GRA004TMP(l_data, l_tipFai, l_faiini, l_faifim,l_turtrb,p_numemp,p_tipcol,p_numcad);
                        END IF;
                    END LOOP;
                END LOOP;

                /* exclui as linhas que não vão ser geradas */
                BEGIN
                    DELETE FROM R004TMP WHERE TURTRB = 2 AND NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
                EXCEPTION
                    WHEN OTHERS THEN NULL;
                END;

                /*Verifica se atingiu a quantidade de iteração, caso afirmativo, unifica o próximo dia*/
                IF (l_count >= l_iteracao) THEN
                    EXIT;
                ELSE
                    l_count := l_count + 1;
                END IF;   
            END LOOP;
        END IF;

        l_data := DATETimeAdd(DD,1,l_data);
        IF  (l_data > l_data_limite) THEN
            EXIT;
        END IF;
    END LOOP;
END		SENIOR;22SP_GRA004TMP
