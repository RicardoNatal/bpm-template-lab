PROCEDURE R030EMP_ATUCON(P_TIPOPE NUMBER(1),P_NUMEMP NUMBER(4),P_NOMEMP VARCHAR2(40))
 IS

l_codfil      NUMBER(6);
  l_tipins      NUMBER(1);
  l_numcgc      NUMBER(14);
  l_inscei      NUMBER(12);
  l_razsoc      VARCHAR2(40);

  /* CURSOR QUE RETORNA AS FILIAIS DA EMPRESA */
  CURSOR c_fil IS
    SELECT CODFIL, TIPINS, NUMCGC, INSCEI, RAZSOC
      FROM R030FIL
     WHERE R030FIL.NUMEMP = p_numemp;
BEGIN
  FOREACH c_fil INTO l_codfil, l_tipins, l_numcgc, l_inscei, l_razsoc
  LOOP
    R030FIL_ATUCON(p_tipope, p_numemp, l_codfil, l_tipins, l_numcgc, l_inscei, l_razsoc, 0, 0, p_nomemp);
  END LOOP;
END		SENIOR;21R030FIL_ATUCON
