SP_MATGRP
ä␀␀PROCEDURE R070PEO_ATUCON
 IS

l_cracha       NUMBER(12);
  l_crastr       CHAR(12);
  l_grupo1       CHAR(5);
  l_inigr1       CHAR(10);
  l_fimgr1       CHAR(10);
  l_grupo2       CHAR(5);
  l_inigr2       CHAR(10);
  l_fimgr2       CHAR(10);
  l_grupo3       CHAR(5);
  l_inigr3       CHAR(10);
  l_fimgr3       CHAR(10);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);

  /* CURSOR c/ os registros gravados no R070PEO_AUX */
  CURSOR c_r070peo_ins IS SELECT NUMEMP,NUMCAD,DATINI,HORINI FROM R070PEO_AUX;
  TYPE t_r070peo_aux IS RECORD(
    NUMEMP   R070PEO_AUX.NUMEMP%TYPE,
    NUMCAD   R070PEO_AUX.NUMCAD%TYPE,
    DATINI   R070PEO_AUX.DATINI%TYPE,
    HORINI   R070PEO_AUX.HORINI%TYPE);
  l_r070peo_aux t_r070peo_aux;

BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_R070PEO_ins INTO  l_r070peo_aux.NUMEMP,
                              l_r070peo_aux.NUMCAD,
                              l_r070peo_aux.DATINI,
                              l_r070peo_aux.HORINI
  LOOP
       SP_RetCra (1, l_r070peo_aux.NUMEMP,5,l_r070peo_aux.NUMCAD,0,'',0,'',l_cracha OUT);
       IF   l_cracha = 0 THEN
            SP_RetCra (2, l_r070peo_aux.NUMEMP,5,l_r070peo_aux.NUMCAD,0,'',0,'',l_cracha OUT);
       END IF;

       /* Verifica se Colaborador possui Cracha */
       IF   (l_cracha <> 0) THEN
            SP_INTSTR(l_cracha,'999999999999',l_crastr OUT);

            /* Retornas as tres permissoes ativas, caso houver */
            SP_RETPEO(l_r070peo_aux.NUMEMP,l_r070peo_aux.NUMCAD, l_cracha,
                      l_grupo1 OUT, l_inigr1 OUT, l_fimgr1 OUT, l_grupo2 OUT, l_inigr2 OUT, l_fimgr2 OUT, l_grupo3 OUT, l_inigr3 OUT, l_fimgr3 OUT);

            /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
            SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
            IF (l_crapri = 0) THEN
                l_crapri := l_cracha;
            END IF;
            /*Atualiza somente o crachá principal*/
            BEGIN
              UPDATE R070CON SET PRMRT1 = l_grupo1, DINPR1 = l_inigr1, DFNPR1 = l_fimgr1,
                                 PRMRT2 = l_grupo2, DINPR2 = l_inigr2, DFNPR2 = l_fimgr2,
                                 PRMRT3 = l_grupo3, DINPR3 = l_inigr3, DFNPR3 = l_fimgr3
                                 WHERE NUMFIS = l_crapri;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'R070PEO_ATUCON: Erro Na Atualização da tabela R070CON.';
            END;
            /*Atualiza os crachás secundários da R070CON*/
            SP_UPDPRM(l_cracha,0,0,0,0,l_grupo1,l_grupo2,l_grupo3);

            /*Atualiza a Pend_grupo se possuir smart*/
            IF (l_numsma > 0) THEN
                /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
                IF (l_tecpri = 3) THEN
                    SP_ATUPRM(l_cracha, l_numsma, 0, l_grupo1, l_grupo2, l_grupo3, 0, 0, 0);
                ELSE
                    SP_ATUPRM(l_crapri, l_numsma, 0, l_grupo1, l_grupo2, l_grupo3, 0, 0, 0);
                END IF;
            END IF;
            /*Atualiza a Controle*/
            BEGIN
                SELECT IDTPES INTO l_idtpes FROM R070CON WHERE NUMCRA = l_cracha AND NUMFIS = l_crapri;
            EXCEPTION
              WHEN OTHERS THEN
                NULL;
            END;
            SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
            /*Atualiza tabela MatGrupo*/
            SP_MATGRP(l_cracha, 5, l_r070peo_aux.NUMEMP, 0, l_r070peo_aux.NUMCAD, 0, '', '');

       END IF;
       BEGIN
         DELETE FROM R070PEO_AUX
         WHERE NUMEMP = l_r070peo_aux.NUMEMP AND
               NUMCAD = l_r070peo_aux.NUMCAD AND
               DATINI = l_r070peo_aux.DATINI AND
               HORINI = l_r070peo_aux.HORINI;
       EXCEPTION
         WHEN OTHERS THEN
           NULL;
       END;
  END LOOP;
END		SENIOR;23XSP_RETCRA
SP_INTSTR
SP_RETPEO
SP_MAPFIS
SP_UPDPRM
SP_ATUPRM
SP_ATUTSI
SP_MATGRP
