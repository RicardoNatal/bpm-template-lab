		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONFIN', CONVERT(NUMBER_TO_CHAR, :OLD.ConFin));		
	EXCEPTION
	    WHEN OTHERS THEN RAISERROR 103 'R044MOF_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	END;
	 
