									:NEW.ESCHOR,:NEW.USAVTR,:NEW.USADEP,:NEW.USAVLI,:NEW.FECSAL,:NEW.USARAT,:NEW.RATPRV,:NEW.HORNOT,:NEW.PAGESC,
									:NEW.GRPSOC,:NEW.PAGANU,:NEW.FECCOM,:NEW.DIAHOR,:NEW.USAPIS,:NEW.CALSAL,:NEW.TIPULT,:NEW.HORFER,:NEW.ULTPRO,
									:NEW.ULTMEN,:NEW.ULTADT,:NEW.ULTSEM,:NEW.ULTQUI,:NEW.ULT13S,:NEW.ULTPAR,:NEW.ENCPRV,:NEW.BENPRV,:NEW.SLDPRV,
									:NEW.PISPRV,:NEW.BAIRAT,:NEW.CTBFER,:NEW.CTBEFE,:NEW.TOTPIS,:NEW.NROCON,:NEW.ULTRPA,:NEW.USARAH,:NEW.POREMP,
									:NEW.CMPSIM,:NEW.SALPRP,:NEW.USATIM,:NEW.HOMPAG,:NEW.HORCTT,:NEW.CTLDFI,:NEW.HISFNC,:NEW.PAGFNC,:NEW.PROFIX,
									:NEW.USAPRF,:NEW.VACFRE,:NEW.PRVFER,:NEW.PROADI,:NEW.ORCMAO,:NEW.CONPAG,:NEW.CPFRES,:NEW.APUPRO,:NEW.CALDPN,
									:NEW.CODDAP,:NEW.CODDSI,:NEW.USAFIN,:NEW.RESDAD,:NEW.PRVTRF,:NEW.LANDEM,:NEW.CFGSAP,:NEW.INTSAP,:NEW.TABINT,
									:NEW.FERSAB,:NEW.ATUEFE,:NEW.VERADM,:NEW.VERQUA,:NEW.VERQUF,:NEW.USATUR,:NEW.CTLQUA,:NEW.TIPQUA,:NEW.CONCAR,
									:NEW.NIVQUA,:NEW.ULTPRE,:NEW.EXCPRE,:NEW.APRNAT,:NEW.BAKINI,:NEW.BAKFIM,:NEW.CONCFI,:NEW.CONTPV,:NEW.CONTMP,
