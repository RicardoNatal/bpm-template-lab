PROCEDURE SP_PEND21(P_NUMFIS NUMBER)
 IS

l_data_atual         DATE;
  l_hora_atual         NUMBER(4);
  l_seqenv             NUMBER(2);
  l_datstr             CHAR(6);
  l_horstr             CHAR(4);
  l_seqstr             CHAR(2);
  l_datenv             CHAR(16);
  l_numcra             NUMBER(12);
  l_numcra_str         CHAR(12);
  l_numfis_str         CHAR(12);
  l_tipcra             NUMBER(2);
  l_tipcra_str         CHAR(2);
  l_inival             CHAR(16);
  l_datval             CHAR(16);
  l_sitcra             NUMBER(2);
  l_sitcra_str         CHAR(2);
  l_teccra             NUMBER(2);
  l_teccra_str         CHAR(2);
  l_idtPes             CHAR(23);
  l_prmaut             NUMBER(5);
  l_prmaut_str         CHAR(5);
  l_Straux             VARCHAR2(2047);
BEGIN
    /*Inicializações*/
    /*Obtem a data/hora de envio da pendência.*/
    l_data_atual := CURDATE();
    l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
    SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
    SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
    /*Obtem o Segundo*/
    l_seqenv := SECOND(CURTIME());
    SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
    l_datenv := l_datstr||l_horstr||l_seqstr||'0000';
    BEGIN
        SELECT NUMCRA, TIPCRA, INIVAL, DATVAL, SITCRA, TECCRA, IDTPES, CODPRM
        INTO l_numcra, l_tipcra, l_inival, l_datval, l_sitcra, l_teccra, l_idtPes, l_prmaut
        FROM R070CON WHERE NUMFIS = p_numfis;
    EXCEPTION
        WHEN OTHERS THEN NULL;
    END;
    /*Formata o retorno*/
    SP_INTSTR(l_numcra,'999999999999',l_numcra_str OUT);
    SP_INTSTR(p_numfis,'999999999999',l_numfis_str OUT);
    SP_INTSTR(l_tipcra,'99',l_tipcra_str OUT);
    SP_INTSTR(l_sitcra,'99',l_sitcra_str OUT);
    IF  (l_sitcra_str = '00') THEN
        l_sitcra_str := '10';
    END IF;

    /*Se for cracha de autorizacao de entrada popula a variavel de permissão de autorizacao de entrada*/
    IF (l_tipcra = 12) THEN
      SP_INTSTR(l_prmaut,'99999',l_prmaut_str OUT);
    ELSE
      l_prmaut_str := '00000';
    END IF;

    SP_INTSTR(l_teccra,'99',l_teccra_str OUT);
    /*Monta e envia a Pendência*/
    l_StrAux := '21'||l_datenv||l_numfis_str||l_tipcra_str||l_inival||l_datval||l_sitcra_str
                ||l_teccra_str||l_numcra_str||l_prmaut_str||l_idtpes;

    /*Envia a pendência*/
    SP_PorCom(l_straux,'0');
END		SENIOR;21!SP_DATSTR
SP_INTSTR
SP_PORCOM
