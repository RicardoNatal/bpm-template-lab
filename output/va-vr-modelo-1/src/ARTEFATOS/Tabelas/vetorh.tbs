DECLARE
	l_temAud       BOOLEAN;
	l_codRPA       NUMBER(15);
	l_codSistema   NUMBER(2);
	l_codcpa       NUMBER(4);
	l_codtpa       NUMBER(4);
	l_datTemp      VARCHAR(10);
BEGIN
  /* Geração de logs Filial - Cadastro*/
  l_codSistema := 1;  /* Código do sistema vetorh.*/
  l_codcpa := 33;     /* R030EFE - CADASTRO FILIAIS - ÓRGÃO PÚBLICO - ENTE FEDERATIVO */
  l_codtpa := 176;    /* Incluir/Excluir   */
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);  
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R030EFE_EI', 'FR030FIL'); 
     
     /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
    BEGIN
	    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
        SP_DATSTR(:NEW.DATALT, 'MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPPUB', CONVERT(NUMBER_TO_CHAR, :NEW.TIPPUB));
	EXCEPTION
	    WHEN OTHERS THEN RAISERROR 103 'R030EFE_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	END;
	 
	BEGIN
	   INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESLEI', :NEW.DESLEI);
       INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERSEG', CONVERT(NUMBER_TO_CHAR, :NEW.PERSEG));
       INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERNOR', CONVERT(NUMBER_TO_CHAR, :NEW.PERNOR));
       INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERSUP', CONVERT(NUMBER_TO_CHAR, :NEW.PERSUP)); 
    END;	
  END IF;  
END␀Ò␀␀		SENIOR;0t
