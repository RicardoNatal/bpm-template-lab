‚#␀␀PROCEDURE R044MOV_ATUSAL(IN_TIPOPE VARCHAR2(255),IN_NUMEMP NUMBER(4),IN_TIPCOL NUMBER(1),IN_NUMCAD NUMBER(9),IN_CODCAL NUMBER,IN_CODEVE NUMBER,IN_TABEVE NUMBER,IN_NEWREFEVE NUMBER,IN_OLDREFEVE NUMBER)
 IS

/* V_DESOPE      VARCHAR2(20); */
     /* V_CONDEP      NUMBER(3);    */
     /* V_DATATU      VARCHAR2(20); */
     V_TIPINF      VARCHAR2(1);
     V_TABEVE      NUMBER(3);
     V_CODCAL        R044CAL.CODCAL%TYPE;
     V_TIPCAL      NUMBER(2);
     V_PEREVE      DATE;
     V_PERANT      DATE;
     V_PERATU      DATE;
     V_CODSAL      NUMBER(4);
     V_SINEVE      VARCHAR2(1);
     V_ALTSAL      NUMBER(10);
     V_SALANT      NUMBER(10);
     V_SALATU      NUMBER(10);
     V_TIPOPE      NUMBER(1);

     V_ESTANAABR   NUMBER(3);
     V_TEMABRFIL   NUMBER(3);
     V_CODFIL      NUMBER;
     V_FILIAL      NUMBER;
     V_DATALT      DATE;

     V_FIMAPU      DATE;


     CURSOR C_ATUSALEVE IS
            SELECT R008CSE.CODSAL,R008CSE.SINEVE,R044CAL.CODCAL,R044CAL.PERREF,R044CAL.FIMAPU
            FROM   R008CSE,R044CAL
            WHERE  R008CSE.CODEVE = IN_CODEVE AND
                   R008CSE.CODTAB = IN_TABEVE AND 
                   R044CAL.NUMEMP = IN_NUMEMP AND
                   R044CAL.TIPCAL = 11 AND
                   R044CAL.PERREF >= V_PERANT AND
                   R008CSE.CMPINI <= V_PEREVE
            ORDER BY R008CSE.CODSAL,R044CAL.PERREF,R044CAL.CODCAL;

     CURSOR C_HISFIL IS
            SELECT R038HFI.DATALT,R038HFI.CODFIL
            FROM   R038HFI
            WHERE  R038HFI.NUMEMP = IN_NUMEMP AND
                   R038HFI.TIPCOL = IN_TIPCOL AND
                   R038HFI.NUMCAD = IN_NUMCAD AND
                   R038HFI.DATALT <= V_FIMAPU
            ORDER BY R038HFI.DATALT;

     CURSOR C_RETABRFIL IS
            SELECT R008CSF.CODFIL
            FROM   R008CSF
            WHERE  R008CSF.CODTAB = IN_TABEVE AND
                   R008CSF.CODSAL = V_CODSAL AND
                   R008CSF.NUMEMP = IN_NUMEMP;

     BEGIN
     /* Seta Descricao do Tipo de Operacao. */
     /*
     IF  (IN_TIPOPE = 'I') THEN
         V_DESOPE := ' R044MOV_INSERT ';
     ELSIF (IN_TIPOPE = 'U') THEN
         V_DESOPE := ' R044MOV_UPDATE ';
     ELSIF (IN_TIPOPE = 'D') THEN
         V_DESOPE := ' R044MOV_DELETE ';
     END;
     */

     /* Busca Data/Hora Atual do Oracle p/ Log de Depuracao. */
     /* SELECT TO_CHAR (SYSDATE, 'DD/MM/YYYY hh:mi') INTO V_DATATU FROM DUAL; */
     /* V_CONDEP := 1; */

     /* Buca Tipo de Calculo/Competencia do Calculo Segundo o Codigo de Calculo no Lancamento do Evento. */
     BEGIN
          SELECT TIPCAL,PERREF INTO V_TIPCAL,V_PEREVE FROM R044CAL
                 WHERE NUMEMP = IN_NUMEMP AND CODCAL = IN_CODCAL;
     EXCEPTION
          WHEN NO_DATA_FOUND THEN
               RAISERROR 103 'Cálculo do Lançamento do Evento Não Cadastrado.';
     END;

     /* Buca Tabela de Eventos Segundo a Empresa do Colaborador. */
     BEGIN
          SELECT TABEVE INTO V_TABEVE FROM R030EMP
                 WHERE NUMEMP = IN_NUMEMP;
     EXCEPTION
          WHEN NO_DATA_FOUND THEN
               RAISERROR 103 'Empresa do Lançamento do Evento Não Cadastrada.';
     END;

     /* DECREMENTA UM MES DA DATA */
     V_PERANT := DATETimeAdd(MM,-1,V_PEREVE);

     /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'[TIPCAL,PEREVE]: '||V_TIPCAL||' '||V_PEREVE); */
     /* V_CONDEP := V_CONDEP + 1; */

     /* Verifica o Tipo de Calculo (11-Mensal). */
     IF   (V_TIPCAL = 11) THEN
          BEGIN
          /* Busca Unidade do Evento (Saldo de Eventos Somente Para Eventos de Horas). */
          BEGIN
               SELECT TIPINF INTO V_TIPINF FROM R008EVC
                      WHERE CODTAB = IN_TABEVE AND CODEVE = IN_CODEVE;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    RAISERROR 103 'Evento do Lançamento do Evento Não Cadastrado.';
          END;
          IF   ((V_TIPINF <> 'H') AND (V_TIPINF <> 'N')) THEN
               RETURN;
          END IF;

          /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'[TABEVE,TIPINF]: '||V_TABEVE||' '||V_TIPINF); */
          /* V_CONDEP := V_CONDEP + 1; */

          /* Inicializa Variaveis Auxiliares. */
          V_ALTSAL := 0;
          V_SALANT := 0;
          V_SALATU := 0;

          /* Busca os Saldos de Eventos a Serem Alterados. */
          FOREACH C_ATUSALEVE INTO V_CODSAL,V_SINEVE,V_CODCAL,V_PERATU,V_FIMAPU
          LOOP
               /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'[CODSAL,SINEVE,CODCAL,PERATU]: '||V_CODSAL||' '||V_SINEVE||' '||V_CODCAL||' '||V_PERATU); */
               /* V_CONDEP := V_CONDEP + 1; */

               V_FILIAL := 0;
               FOREACH C_HISFIL INTO V_DATALT,V_FILIAL
               LOOP
                 V_TEMABRFIL := 0;
                 V_ESTANAABR := 0;
               END LOOP;

               V_TEMABRFIL := 0;
               V_ESTANAABR := 0;

               FOREACH C_RETABRFIL INTO V_CODFIL
               LOOP

                 V_TEMABRFIL := V_TEMABRFIL + 1;
                 IF (V_CODFIL = V_FILIAL) THEN
                   V_ESTANAABR := 1;
                 END IF;
               END LOOP;

               /* Se não tem abrangência de filial de saldo de eventos, então
                  vale para todas filiais, ou se tem abrangência e é a mesma do
                  histórico do colaborador.*/

               IF ((V_TEMABRFIL = 0) OR (V_ESTANAABR = 1)) THEN
               BEGIN
                 /* Verifica o Tipo de Operacao. */
                 IF   (IN_TIPOPE = 'I') THEN
                      BEGIN
                      V_ALTSAL := IN_NEWREFEVE;
                      IF   (V_SINEVE = '-') THEN
                           V_ALTSAL := V_ALTSAL * (-1);
                      END IF;
                      END;
                 ELSIF (IN_TIPOPE = 'U') THEN
                      BEGIN
                      V_ALTSAL := IN_OLDREFEVE - IN_NEWREFEVE;
                      IF   (V_SINEVE = '+') THEN
                           V_ALTSAL := V_ALTSAL * (-1);
                      END IF;
                      END;
                 ELSIF (IN_TIPOPE = 'D') THEN
                      BEGIN
                      V_ALTSAL := IN_OLDREFEVE;
                      IF   (V_SINEVE = '+') THEN
                           V_ALTSAL := V_ALTSAL * (-1);
                      END IF;
                      END;
                 END IF;

                 /* Inicializa Variavel c/ Tipo de Operacao a Ser Realizada no Calculo. */
                 V_TIPOPE := 0;

                 /* Verifica se Existe Saldo do Evento Neste Calculo. */
                 BEGIN
                      SELECT IFNULL (HORSAL,0) INTO V_SALATU FROM R008SAL
                             WHERE NUMEMP = IN_NUMEMP AND TIPCOL = IN_TIPCOL AND NUMCAD = IN_NUMCAD AND
                                   CODCAL = V_CODCAL AND CODSAL = V_CODSAL;
                 EXCEPTION
                      WHEN NO_DATA_FOUND THEN
                           V_SALATU := 0;
                           V_TIPOPE := 1;
                 END;
                 /* Realiza Inclusao/Alteracao/Exclusao do Saldo de Evento. */
                 IF   (V_TIPOPE = 0) THEN
                      BEGIN
                      V_SALATU := V_SALATU + V_ALTSAL;
                      V_SALANT := V_SALATU;
                      IF   (V_PERATU >= V_PEREVE) THEN
                           BEGIN
                           UPDATE R008SAL SET HORSAL = V_SALATU
                                  WHERE NUMEMP = IN_NUMEMP AND TIPCOL = IN_TIPCOL AND NUMCAD = IN_NUMCAD AND
                                        CODCAL = V_CODCAL AND CODSAL = V_CODSAL;

                           /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'Alterado Valor Saldo: '||V_SALATU); */
                           /* V_CONDEP := V_CONDEP + 1; */
                           END;
                      END IF;
                      END;
                 ELSIF (V_TIPOPE = 1) THEN
                      BEGIN
                      IF   (V_PERATU = V_PEREVE) THEN
                           V_SALANT := V_ALTSAL;
                      END IF;
                      IF   (V_PERATU >= V_PEREVE) THEN
                           BEGIN
                           INSERT INTO R008SAL (NUMEMP,TIPCOL,NUMCAD,CODCAL,TABEVE,CODSAL,HORSAL,ORIALT)
                                  VALUES (IN_NUMEMP,IN_TIPCOL,IN_NUMCAD,V_CODCAL,V_TABEVE,V_CODSAL,V_SALANT,'T');

                           /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'Incluido Valor Saldo: '||V_SALANT); */
                           /* V_CONDEP := V_CONDEP + 1; */
                           END;
                      END IF;
                      END;
                 END IF;
               END;
               END IF;
          END LOOP;
          END;
     END IF;
     END␀J×␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
