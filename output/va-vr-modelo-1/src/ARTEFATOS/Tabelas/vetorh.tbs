Ÿ␀␀PROCEDURE SP_FAIOnl(P_PSQHOR NUMBER,P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_NUMCRA NUMBER,P_NUMMAT VARCHAR2(15))
 IS

l_icard        CHAR(12);
  l_craaux       NUMBER(12);
  l_crastr       CHAR(12);
  /* Controle de Faixas Horarias */
  l_fx_dom_a     CHAR(56);
  l_fx_seg_a     CHAR(56);
  l_fx_ter_a     CHAR(56);
  l_fx_qua_a     CHAR(56);
  l_fx_qui_a     CHAR(56);
  l_fx_sex_a     CHAR(56);
  l_fx_sab_a     CHAR(56);
  l_fx_dom_p     CHAR(56);
  l_fx_seg_p     CHAR(56);
  l_fx_ter_p     CHAR(56);
  l_fx_qua_p     CHAR(56);
  l_fx_qui_p     CHAR(56);
  l_fx_sex_p     CHAR(56);
  l_fx_sab_p     CHAR(56);
  l_fx_ref       CHAR(56);
  l_codesc         R006ESC.CodEsc%TYPE;
  l_codtma       NUMBER(1);
  L_NODATAFOUND  BOOLEAN;
  /*Controle de permissão para 3º turno*/
  l_prmsabequal  NUMBER;
  l_prmdomequal  NUMBER;
  l_prmsegequal  NUMBER;
  l_datini       CHAR(6);
  l_datfim       CHAR(6);
  l_horini       CHAR(4);
  l_horfim       CHAR(4);
  l_cracha       NUMBER(12);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_apupfs       CHAR(1);
BEGIN
  l_apupfs := 'E';
  /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
  SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
  IF (l_crapri = 0) THEN
      l_crapri := p_numcra;
  END IF;

  /* se é para pesquisar horário então */
  IF  p_psqhor = 1 THEN
      /* Pega as faixas horárias de acordo com o tipo de colaborador */
      IF  (p_tipcol = 5) THEN /* OUTRAS UNIDADES */
          l_codesc := 0;
          l_codtma := 0;
          BEGIN
              SELECT CODESC,CODTMA INTO l_codesc,l_codtma FROM R070OCR
              WHERE NUMEMP=p_numemp  AND NUMCAD=p_numcad;
          EXCEPTION
              WHEN NO_DATA_FOUND THEN RAISERROR 103 'SpFaiOnl: Não achou cadastro em Outras Unidades.';
              WHEN OTHERS THEN RAISERROR 103 'SPFaiOnl: Erro no SELECT em R070OCR.';
          END;
          SP_FaiOcr(p_numemp,p_numcad,l_codesc,l_codtma,
          l_fx_dom_a OUT,l_fx_seg_a OUT,l_fx_ter_a OUT,l_fx_qua_a OUT,l_fx_qui_a OUT,l_fx_sex_a OUT,l_fx_sab_a OUT,
          l_fx_dom_p OUT,l_fx_seg_p OUT,l_fx_ter_p OUT,l_fx_qua_p OUT,l_fx_qui_p OUT,l_fx_sex_p OUT,l_fx_sAB_p OUT,
                    l_fx_ref OUT);

      ELSE
          IF  (p_tipcol = 6 ) THEN
              /* alunos */
              SP_FaiAlu (p_nummat,
                         l_fx_dom_a OUT, l_fx_seg_a OUT, l_fx_ter_a OUT, l_fx_qua_a OUT, l_fx_qui_a OUT, l_fx_sex_a OUT, l_fx_sab_a OUT,
                         l_fx_dom_p OUT, l_fx_seg_p OUT, l_fx_ter_p OUT, l_fx_qua_p OUT, l_fx_qui_p OUT, l_fx_sex_p OUT, l_fx_sab_p OUT,
                         l_fx_ref OUT);

          ELSE
              SP_APUCOL(p_numemp, p_tipcol, p_numcad, l_apupfs OUT);
              /*Se o controle for por atividades do professor*/
              IF (l_apupfs = 'A') THEN
                  SP_FaiPro (p_numemp, p_tipcol, p_numcad,
                             l_fx_dom_a OUT, l_fx_seg_a OUT, l_fx_ter_a OUT, l_fx_qua_a OUT, l_fx_qui_a OUT, l_fx_sex_a OUT, l_fx_sab_a OUT,
                             l_fx_dom_p OUT, l_fx_seg_p OUT, l_fx_ter_p OUT, l_fx_qua_p OUT, l_fx_qui_p OUT, l_fx_sex_p OUT, l_fx_sab_p OUT,
                             l_fx_ref OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);

              ELSE
                  SP_FaiHor (p_numemp, p_tipcol, p_numcad,
                             l_fx_dom_a OUT, l_fx_seg_a OUT, l_fx_ter_a OUT, l_fx_qua_a OUT, l_fx_qui_a OUT, l_fx_sex_a OUT, l_fx_sab_a OUT,
                             l_fx_dom_p OUT, l_fx_seg_p OUT, l_fx_ter_p OUT, l_fx_qua_p OUT, l_fx_qui_p OUT, l_fx_sex_p OUT, l_fx_sab_p OUT,
                             l_fx_ref OUT, l_prmsabequal OUT, l_prmdomequal OUT, l_prmsegequal OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);
              END IF;
          END IF;
      END IF;
  ELSE
      l_fx_dom_a := '00002359240024002400240024002400240024002400240024002400';
      l_fx_seg_a := '00002359240024002400240024002400240024002400240024002400';
      l_fx_ter_a := '00002359240024002400240024002400240024002400240024002400';
      l_fx_qua_a := '00002359240024002400240024002400240024002400240024002400';
      l_fx_qui_a := '00002359240024002400240024002400240024002400240024002400';
      l_fx_sex_a := '00002359240024002400240024002400240024002400240024002400';
      l_fx_sab_a := '00002359240024002400240024002400240024002400240024002400';
      l_fx_dom_p := '00002359240024002400240024002400240024002400240024002400';
      l_fx_seg_p := '00002359240024002400240024002400240024002400240024002400';
      l_fx_ter_p := '00002359240024002400240024002400240024002400240024002400';
      l_fx_qua_p := '00002359240024002400240024002400240024002400240024002400';
      l_fx_qui_p := '00002359240024002400240024002400240024002400240024002400';
      l_fx_sex_p := '00002359240024002400240024002400240024002400240024002400';
      l_fx_sab_p := '00002359240024002400240024002400240024002400240024002400';
      l_fx_ref   := '24002400240024002400240024002400240024002400240024002400';
  END IF;

  /* atualiza a tabela R070CON */
  BEGIN
      UPDATE R070CON SET
             FAIAC1=l_fx_dom_a,FAIAC2=l_fx_seg_a,FAIAC3=l_fx_ter_a,FAIAC4=l_fx_qua_a,
             FAIAC5=l_fx_qui_a,FAIAC6=l_fx_sex_a,FAIAC7=l_fx_sab_a,
             FAIPT1=l_fx_dom_p,FAIPT2=l_fx_seg_p,FAIPT3=l_fx_ter_p,FAIPT4=l_fx_qua_p,
             FAIPT5=l_fx_qui_p,FAIPT6=l_fx_sex_p,FAIPT7=l_fx_sab_p,
             FAIREF=l_fx_ref
      WHERE NUMFIS = l_crapri;
  EXCEPTION
      WHEN OTHERS THEN NULL;
  END;
  /*Atualiza a Controle*/
  IF (p_tipcol = 5) THEN /* OUTRAS UNIDADES */
      /*Obtem o Tipo de Pessoa*/
      SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes_str||l_numemp||l_numcad;
  ELSIF (p_tipcol = 6 ) THEN
      /*Preenche o Identificador da pessoa*/
      l_idtpes:= '10'||p_nummat;
  ELSE /*Colaborador*/
      /*Obtem o Tipo de Pessoa*/
      SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
  END IF;
  /*Preenche o campo com espaços para completar 23 posições*/
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
      /*Controle do Loop.*/
      IF (Length(l_idtpes) > 22) THEN
          EXIT;
      END IF;
      l_idtpes := ' '||l_idtpes;
  END LOOP;
  /*Procedure que atualiza a controle*/
  SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);
END		SENIOR;23XSP_MAPFIS
SP_FAIOCR
SP_FAIALU
SP_APUCOL
SP_FAIPRO
SP_FAIHOR
SP_INTSTR
SP_ATUTSI
