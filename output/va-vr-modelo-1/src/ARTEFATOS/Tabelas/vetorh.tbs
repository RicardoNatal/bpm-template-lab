/* DELETE (OLD) */
TRIGGER R008INC_ED AFTER DELETE ON R008INC FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Eventos - Incidências (Tabela: R008INC)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 102;     /* Eventos - Incidências (Tabela: R008INC)*/
  l_codtpa := 349;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008INC_ED', '');

