      l_nomfun := :NEW.NOMFUN;
  ELSE
      l_nomfun := :OLD.NOMFUN;
  END IF;

  IF (l_nomfun IS NULL) OR (l_nomfun = '') THEN
      l_nomfun := '';
      l_numpis := 0;
      IF (LENGTH(LTRIM(RTRIM(:OLD.NomFun))) > 0) THEN
        l_TipOpeRep := 'E';
      END IF;
  END IF;

  IF (:NEW.NUMPIS <> :OLD.NUMPIS) THEN
      l_numpis := :NEW.NUMPIS;
  ELSE
      l_numpis := :OLD.NUMPIS;
  END IF;

  IF (l_numpis IS NULL) OR (l_numpis = 0) THEN
      l_numpis := 0;
      IF (:OLD.NUMPIS > 0) THEN
        l_TipOpeRep := 'E';
      END IF;
  END IF;

  IF (l_creac1 IS NULL) THEN
      l_creac1 := '00';
      l_qtdcr1 := '00';
      l_fxcre1 := '00000000';
  END IF;

  IF (l_creac2 IS NULL) THEN
      l_creac2 := '00';
      l_qtdcr2 := '00';
      l_fxcre2 := '00000000';
  END IF;

