        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATSIN', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPES', CONVERT(NUMBER_TO_CHAR, :OLD.CODPES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPES', CONVERT(NUMBER_TO_CHAR, :NEW.CODPES));
        SP_DATSTR(:OLD.DATEVT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATEVT', l_datTemp);
        SP_DATSTR(:NEW.DATEVT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATEVT', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTEMHCT', CONVERT(NUMBER_TO_CHAR, :OLD.TEMHCT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTEMHCT', CONVERT(NUMBER_TO_CHAR, :NEW.TEMHCT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSTAHCT', CONVERT(NUMBER_TO_CHAR, :OLD.STAHCT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSTAHCT', CONVERT(NUMBER_TO_CHAR, :NEW.STAHCT));
        SP_DATSTR(:OLD.DATHCT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATHCT', l_datTemp);
        SP_DATSTR(:NEW.DATHCT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATHCT', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMPSP', :OLD.NUMPSP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMPSP', :NEW.NUMPSP);
        SP_DATSTR(:OLD.DATCHE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATCHE', l_datTemp);
        SP_DATSTR(:NEW.DATCHE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATCHE', l_datTemp);
        SP_DATSTR(:OLD.DATSEF, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATSEF', l_datTemp);
        SP_DATSTR(:NEW.DATSEF, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATSEF', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSEQREG', CONVERT(NUMBER_TO_CHAR, :OLD.SEQREG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSEQREG', CONVERT(NUMBER_TO_CHAR, :NEW.SEQREG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDGESPON', :OLD.GESPON);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWGESPON', :NEW.GESPON);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPRO', CONVERT(NUMBER_TO_CHAR, :OLD.CODPRO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPRO', CONVERT(NUMBER_TO_CHAR, :NEW.CODPRO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCATESO', CONVERT(NUMBER_TO_CHAR, :OLD.CATESO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCATESO', CONVERT(NUMBER_TO_CHAR, :NEW.CATESO));
        SP_DATSTR(:OLD.DATCES, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATCES', l_datTemp);
        SP_DATSTR(:NEW.DATCES, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATCES', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCOTDEF', CONVERT(NUMBER_TO_CHAR, :OLD.COTDEF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCOTDEF', CONVERT(NUMBER_TO_CHAR, :NEW.COTDEF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFORPRO', :OLD.FORPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFORPRO', :NEW.FORPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCBO', :OLD.CODCBO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCBO', :NEW.CODCBO);
      END;
    END IF;
  END IF;
END␀Ó␀␀		SENIOR;0îz␀␀

TRIGGER R034FUN_ED AFTER DELETE ON R034FUN FOR EACH ROW

DECLARE
l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_tippes       CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_seqenv       NUMBER(2);
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_seqstr       CHAR(2);
  l_datenv       CHAR(16);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_numcpf       NUMBER(11);

  /* CURSOR c/ todos os registros da pessoa da tabela R070CON */
  CURSOR c_r070con IS SELECT DISTINCT NUMCRA, NUMFIS, TECCRA, VERPRM, CODPRM,
                                      PRMSAB, PRMDOM, PRMFER, PRMRT1, PRMRT2,
                                      PRMRT3, NOMFUN, NUMPIS, TIPDOC, NUMDOC
                                 FROM R070CON WHERE IDTPES = l_idtpes;

  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NumCra%TYPE,
    NUMFIS   R070CON.NumFis%TYPE,
    TECCRA   R070CON.TecCra%TYPE,
    VERPRM   R070CON.VerPrm%TYPE,
    CODPRM   R070CON.CodPrm%TYPE,
    PRMSAB   R070CON.PrmSab%TYPE,
    PRMDOM   R070CON.PrmDom%TYPE,
    PRMFER   R070CON.PrmFer%TYPE,
    PRMRT1   R070CON.PrmRt1%TYPE,
    PRMRT2   R070CON.PrmRt2%TYPE,
    PRMRT3   R070CON.PrmRt3%TYPE,
    NOMFUN   R070CON.NomFun%TYPE,
    NUMPIS   R070CON.NumPis%TYPE,
    TIPDOC   R070CON.TipDoc%TYPE,
    NUMDOC   R070CON.NumDoc%TYPE);

  l_r070con t_r070con;
  
  /* Para store procedures de histórico */
  l_seqhis       NUMBER(15);
  l_tipalt       VARCHAR2(1);
    
BEGIN
  /* Deleta registro CURRICULO COMPILADO */
  /* Garante que o registro na tabela R122CCO seja excluido - Tarefa: 236116 */
  RS_DELCURCOMP(0, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD);

  /*Obtem a data/hora de envio da pendência.*/
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
  /*Obtem o Segundo*/
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

  /*Monta o IDTPES*/
  SP_INTSTR(:OLD.TIPCOL,'99',l_tippes_str OUT);
  SP_INTSTR(:OLD.NUMEMP,'9999',l_numemp OUT);
  SP_INTSTR(:OLD.TIPCOL,'9',l_tipcol OUT);
  SP_INTSTR(:OLD.NUMCAD,'999999999',l_numcad OUT);
  l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
  /*Preenche o campo com espaços para completar 23 posições*/
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
      /*Controle do Loop.*/
      IF (Length(l_idtpes) > 22) THEN
          EXIT;
      END IF;
      l_idtpes := ' '||l_idtpes;
  END LOOP;

  /*Gera pendencias para remover a pessoa do REP*/
  BEGIN
    FOREACH c_r070con INTO l_r070con.NumCra,l_r070con.NumFis,
                           l_r070con.TecCra,l_r070con.VerPrm,
                           l_r070con.CodPrm,l_r070con.PrmSab,
                           l_r070con.PrmDom,l_r070con.PrmFer,
                           l_r070con.PrmRt1,l_r070con.PrmRt2,
                           l_r070con.PrmRt3,l_r070con.NomFun,
                           l_r070con.NumPis, l_r070con.TipDoc, l_r070con.NumDoc
    LOOP
    	IF (l_r070con.TIPDOC = 2) THEN
            l_numcpf := l_r070con.NUMDOC;
        ELSE
            l_numcpf := 0;
        END IF;
        /*Para cada registro encontrado na R070CON, gera pendencia 62 para remover a pessoa do REP*/
        SP_R070ACR('J', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                   0, l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                   l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3,
                   0, 0, 0, 0, 0, 0, 0,
                   l_datenv, l_idtpes, l_r070con.NomFun, l_r070con.NumPis,1,2,0, l_numcpf);

        SP_R070ACR('Y', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                   0, l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                   l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3,
                   0, 0, 0, 0, 0, 0, 0,
                   l_datenv, l_idtpes, l_r070con.NomFun, l_r070con.NumPis,0,0,27, l_numcpf);
    END LOOP;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'TR034FUN: Erro ao gerar pendência de exclusão do REP.';
  END;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R034FUN');

  IF (l_auditoria = 'S') THEN
      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg
                FROM R034FUN_AUD
               WHERE NUMEMP = :OLD.NUMEMP AND
                     TIPCOL = :OLD.TIPCOL AND
                     NUMCAD = :OLD.NUMCAD;
           EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
          INSERT INTO R034FUN_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,NOMFUN,APEFUN,DATADM,SITAFA,TIPCON,
                                   TIPSEX,ESTCIV,DATNAS,CODNAC,ANOCHE,VISEST,REGEST,DVLEST,DVLCTP,NUMCTP,
                                   NUMCPF,NUMPIS,DCDPIS,DATAFA,HORAFA,EMPRES,TIPRES,CADRES,TIPTER,APUPFS,
                                   NUMPSP,ESTCAR,CODCAR,STAALF)
                           VALUES (l_seqreg,l_verseq,:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.NOMFUN,
                                  :OLD.APEFUN,:OLD.DATADM,:OLD.SITAFA,:OLD.TIPCON,:OLD.TIPSEX,:OLD.ESTCIV,
                                  :OLD.DATNAS,:OLD.CODNAC,:OLD.ANOCHE,:OLD.VISEST,:OLD.REGEST,:OLD.DVLEST,
                                  :OLD.DVLCTP,:OLD.NUMCTP,:OLD.NUMCPF,:OLD.NUMPIS,:OLD.DCDPIS,:OLD.DATAFA,
                                  :OLD.HORAFA,:OLD.EMPRES,:OLD.TIPRES,:OLD.CADRES,:OLD.TIPTER,:OLD.APUPFS,
                                  :OLD.NUMPSP,:OLD.ESTCAR,:OLD.CODCAR,:OLD.STAALF);

          SP_AUDGENREG(l_seqreg,l_verseq,'R034FUN','DELETE');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  /* Geração de histórico da ficha básica */
  l_tipalt := 'E';
  SP_R034FUN_HIST(l_tipalt, :OLD.numemp, :OLD.tipcol, :OLD.numcad, :OLD.nomfun, :OLD.apefun, :OLD.tipsex, :OLD.raccor, :OLD.estciv, :OLD.grains, :OLD.datnas, :OLD.codnac, 
  	:OLD.numctp, :OLD.serctp, :OLD.digcar, :OLD.estctp, :OLD.dexctp, :OLD.numcpf, :OLD.numpis, :OLD.dcdpis, :OLD.movsef, :OLD.irrise, :OLD.apoida, :OLD.emtcar, 
  	:OLD.numins, :OLD.coddef, :OLD.deffis, :OLD.benrea, :OLD.nmfun1, :OLD.nmfun2, :OLD.nmfun3, :OLD.nmfun4, :OLD.codpro, :OLD.anoche, :OLD.visest, :OLD.dvlest, 
  	:OLD.regest, :OLD.dvlctp, :OLD.docest, :OLD.datche, :OLD.numpsp, :OLD.datadm, :OLD.tipadm, :OLD.tipcon, :OLD.tipopc, :OLD.datopc, :OLD.confgt, :OLD.modpag, 
  	:OLD.codban, :OLD.codage, :OLD.conban, :OLD.digban, :OLD.perpag, :OLD.recadi, :OLD.rec13s, :OLD.lisrai, :OLD.emicar, :OLD.codcha, :OLD.NUMCRA, :OLD.outcon, 
  	:OLD.outtet, :OLD.outemp, :OLD.outtip, :OLD.outcad, :OLD.perdes, :OLD.periss, :OLD.faiins, :OLD.opcatu, :OLD.dctins, :OLD.cadfol, :OLD.catter, :OLD.fattpo, 
  	:OLD.empres, :OLD.tipres, :OLD.cadres, :OLD.tipter, :OLD.cauadv, :OLD.inscur, :OLD.assppr, :OLD.datppr, :OLD.verint, :OLD.contov, :OLD.apupfs, :OLD.tippfs, 
  	:OLD.ratpfs, :OLD.gpstri, :OLD.dedcar, :OLD.codfor, :OLD.rateve, :OLD.pertra, :OLD.perirt, :OLD.dedins, :OLD.tipsrv, :OLD.bushor, :OLD.recgra, :OLD.codidn, 
  	:OLD.tpctba, :OLD.codlim, :OLD.rettrp, l_seqhis OUT);
  

  /* Pendência de sincronismo SAMSenior */
  SP_RETIDTPES(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, NULL, NULL, NULL, NULL, l_IDTPES OUT);
  SP_SAM_PENDENCIES(1,3,l_idtpes);

   /* Geração de logs Ficha Básica Colaborador (Tabela: R034FUN)*/
  l_codSistema := 1;  /* Código do sistema vetorh.*/
  l_codcpa := 83;     /* Ficha Básica Colaborador (Tabela: R034FUN)*/
  l_codtpa := 297;

   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034FUN_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034FUN_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMFUN', :OLD.NOMFUN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'APEFUN', :OLD.APEFUN);
        SP_DATSTR(:OLD.DATADM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATADM', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPADM', CONVERT(NUMBER_TO_CHAR, :OLD.TIPADM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITAFA', CONVERT(NUMBER_TO_CHAR, :OLD.SITAFA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAP', CONVERT(NUMBER_TO_CHAR, :OLD.CODTAP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', CONVERT(NUMBER_TO_CHAR, :OLD.ESTPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', :OLD.POSTRA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODETB', CONVERT(NUMBER_TO_CHAR, :OLD.CODETB));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCAR', CONVERT(NUMBER_TO_CHAR, :OLD.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAR', :OLD.CODCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODESC', CONVERT(NUMBER_TO_CHAR, :OLD.CODESC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTMA', CONVERT(NUMBER_TO_CHAR, :OLD.CODTMA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TURINT', CONVERT(NUMBER_TO_CHAR, :OLD.TURINT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :OLD.TABORG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', CONVERT(NUMBER_TO_CHAR, :OLD.NUMLOC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCCU', :OLD.CODCCU);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCON', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCON));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPSEX', :OLD.TIPSEX);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCIV', CONVERT(NUMBER_TO_CHAR, :OLD.ESTCIV));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'GRAINS', CONVERT(NUMBER_TO_CHAR, :OLD.GRAINS));
        SP_DATSTR(:OLD.DATNAS, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATNAS', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODNAC', CONVERT(NUMBER_TO_CHAR, :OLD.CODNAC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ANOCHE', CONVERT(NUMBER_TO_CHAR, :OLD.ANOCHE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VISEST', CONVERT(NUMBER_TO_CHAR, :OLD.VISEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REGEST', :OLD.REGEST);
        SP_DATSTR(:OLD.DVLEST, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DVLEST', l_datTemp);
        SP_DATSTR(:OLD.DVLCTP, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DVLCTP', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCTP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCTP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SERCTP', :OLD.SERCTP);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCTP', :OLD.ESTCTP);
        SP_DATSTR(:OLD.DEXCTP, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DEXCTP', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCPF', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCPF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMPIS', CONVERT(NUMBER_TO_CHAR, :OLD.NUMPIS));
        SP_DATSTR(:OLD.DCDPIS, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DCDPIS', l_datTemp);
