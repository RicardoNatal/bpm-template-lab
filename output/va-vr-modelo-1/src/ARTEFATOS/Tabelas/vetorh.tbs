DECLARE
l_comando_nulo BOOLEAN;
  l_count        NUMBER(5);
  l_data_zero    DATE;
  l_online       BOOLEAN;
  l_strerr       VARCHAR2(255);
  l_codfil       NUMBER(6);

/* CURSOR c/ os registros gravados no R064tes_AUX */
  CURSOR c_r064tes_ins IS SELECT NUMEMP,TIPCOL,NUMCAD,DATINI,DATFIM,STAACC,CODESC FROM R064TES_AUX;
  TYPE t_r064TES_aux IS RECORD(
    NUMEMP   R064TES_AUX.NUMEMP%TYPE,
    TIPCOL   R064TES_AUX.TIPCOL%TYPE,
    NUMCAD   R064TES_AUX.NUMCAD%TYPE,
    DATINI   R064TES_AUX.DATINI%TYPE,
    DATFIM   R064TES_AUX.DATFIM%TYPE,
    STAACC   R064TES_AUX.STAACC%TYPE,
    CODESC   R064TES_AUX.CODESC%TYPE);
  l_r064TES_aux t_r064TES_aux;

BEGIN
  l_comando_nulo:=FALSE;
  l_data_zero  := '31/12/1900,00:00:00';

  /* Le Registro do CURSOR */
  FOREACH c_r064tes_ins INTO  l_r064TES_aux.NUMEMP,
                              l_r064TES_aux.TIPCOL,
                              l_r064TES_aux.NUMCAD,
                              l_r064TES_aux.DATINI,
                              l_r064TES_aux.DATFIM,
                              l_r064TES_aux.STAACC,
                              l_r064TES_aux.CODESC
  LOOP
    l_count := 0;
    BEGIN
      SELECT COUNT(*) INTO l_count
       FROM R064TES A
      WHERE  A.NUMEMP = l_r064tes_aux.NUMEMP
        AND  A.TIPCOL = l_r064tes_aux.TIPCOL
        AND  A.NUMCAD = l_r064tes_aux.NUMCAD
        AND  A.DATINI <> l_r064tes_aux.DATINI
        AND ( ( (A.DATINI > l_r064tes_aux.DATINI) AND
                (A.DATINI < l_r064tes_aux.DATFIM OR l_r064tes_aux.DATFIM = l_data_zero) )
         OR   ( (A.DATFIM > l_r064tes_aux.DATINI OR A.DATFIM = l_data_zero) AND
                ((A.DATFIM < l_r064tes_aux.DATFIM AND A.DATFIM <> l_data_zero) OR l_r064tes_aux.DATFIM = l_data_zero) )
         OR   ( (l_r064tes_aux.DATINI > A.DATINI) AND
                ( (l_r064tes_aux.DATFIM < A.DATFIM AND l_r064tes_aux.DATFIM <> l_data_zero) OR A.DATFIM = l_data_zero) ) );
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_count:=0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro no SELECT R038TES - em R064TES_AI';
    END;
    IF  (l_count > 0) THEN
        l_strerr := 'Erro de Sobreposição de Escalas para Empresa = '||
                     CONVERT(NUMBER_TO_CHAR,l_r064tes_aux.NUMEMP)||' Colaborador = '||
                     CONVERT(NUMBER_TO_CHAR,l_r064tes_aux.NUMCAD);
        RAISERROR 103 l_strerr;
    END IF;

    SP_VerOnLine(l_online OUT);
    IF   (l_online = TRUE) THEN        
        SP_AtuHor (l_r064tes_aux.numemp, l_r064tes_aux.tipcol, l_r064tes_aux.numcad,'');

        SELECT CODFIL INTO l_codfil FROM R034FUN WHERE NUMEMP = l_r064tes_aux.NUMEMP AND TIPCOL = l_r064tes_aux.TIPCOL AND NUMCAD = l_r064tes_aux.NUMCAD;

        IF (l_r064tes_aux.StaAcc = 1) THEN
            SP_GerCrc('I',2,l_r064tes_aux.NUMEMP,
                        l_r064tes_aux.TIPCOL,
                        l_r064tes_aux.NUMCAD,
                        l_r064tes_aux.DATINI,
                        l_r064tes_aux.NUMEMP,
                        l_r064tes_aux.NUMCAD,
                        l_codfil,
                        l_r064tes_aux.CODESC,
                        l_r064tes_aux.STAACC);
        END IF;
    END IF;
  END LOOP;

  /* Apaga Registro R064TES_AUX */
  BEGIN
    DELETE FROM R064TES_AUX;
    DROP_TEMP_TABLE R064TES_AUX;
  EXCEPTION WHEN OTHERS THEN
    l_comando_nulo:=TRUE;
  END;
END␀ÁØ␀␀		SENIOR;0E␀␀

TRIGGER R064TES_EI AFTER INSERT ON R064TES FOR EACH ROW

DECLARE
  l_DataZero   DATE;
  l_data_fim   DATE;
  l_idtpes     CHAR(23);
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R064TES_AUX;
  
BEGIN
  BEGIN
    INSERT INTO R064TES_AUX (TIPCOL,NUMEMP,NUMCAD,DATINI,DATFIM,STAACC,CODESC)
    VALUES (:NEW.TIPCOL,:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATINI,:NEW.DATFIM,:NEW.STAACC,:NEW.CODESC);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R064TES_AUX.';
  END;

  l_DataZero := '31/12/1900,00:00:00';
  l_data_fim := :NEW.DATFIM;
  IF   (l_data_fim = l_DataZero) THEN
       l_data_fim := '04/06/2080,00:00:00';
  END IF;

  BEGIN
  
  UPDATE R066APU SET DIAALT = 2
         WHERE NUMEMP = :NEW.NUMEMP AND
               TIPCOL = :NEW.TIPCOL AND
               NUMCAD = :NEW.NUMCAD AND
               DATAPU >= :NEW.DATINI AND
               DATAPU <= l_data_fim;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;

  SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
  SP_SAM_PENDENCIES(42, 2, l_idtpes);
END␀ÅØ␀␀	SENIOR;0␀␀

TRIGGER R064TES_SU AFTER UPDATE ON R064TES

DECLARE
l_comando_nulo BOOLEAN;
  l_count        NUMBER(5);
  l_data_zero    DATE;
  l_online       BOOLEAN;
  l_strerr       VARCHAR2(255);
  l_codfil       NUMBER(6);

/* CURSOR c/ os registros gravados no R064tes_AUX */
  CURSOR c_r064tes_upd IS SELECT NUMEMP,TIPCOL,NUMCAD,DATINI,DATFIM,STAACC,CODESC FROM R064TES_AUX;
  TYPE t_r064TES_aux IS RECORD(
    NUMEMP   R064TES_AUX.NUMEMP%TYPE,
    TIPCOL   R064TES_AUX.TIPCOL%TYPE,
    NUMCAD   R064TES_AUX.NUMCAD%TYPE,
    DATINI   R064TES_AUX.DATINI%TYPE,
    DATFIM   R064TES_AUX.DATFIM%TYPE,
    STAACC   R064TES_AUX.STAACC%TYPE,
    CODESC   R064TES_AUX.CODESC%TYPE);
  l_r064TES_aux t_r064TES_aux;

BEGIN
  l_comando_nulo:=FALSE;
  l_data_zero  := '31/12/1900,00:00:00';

  /* Le Registro do CURSOR */
  FOREACH c_r064tes_upd INTO  l_r064TES_aux.NUMEMP,
                              l_r064TES_aux.TIPCOL,
                              l_r064TES_aux.NUMCAD,
                              l_r064TES_aux.DATINI,
                              l_r064TES_aux.DATFIM,
                              l_r064TES_aux.STAACC,
                              l_r064TES_aux.CODESC
  LOOP
    l_count := 0;
    BEGIN
      SELECT COUNT(*) INTO l_count
       FROM R064TES A
      WHERE  A.NUMEMP = l_r064tes_aux.NUMEMP
        AND  A.TIPCOL = l_r064tes_aux.TIPCOL
        AND  A.NUMCAD = l_r064tes_aux.NUMCAD
        AND  A.DATINI <> l_r064tes_aux.DATINI
        AND ( ( (A.DATINI > l_r064tes_aux.DATINI) AND
                (A.DATINI < l_r064tes_aux.DATFIM OR l_r064tes_aux.DATFIM = l_data_zero) )
         OR   ( (A.DATFIM > l_r064tes_aux.DATINI OR A.DATFIM = l_data_zero) AND
                ((A.DATFIM < l_r064tes_aux.DATFIM AND A.DATFIM <> l_data_zero) OR l_r064tes_aux.DATFIM = l_data_zero) )
         OR   ( (l_r064tes_aux.DATINI > A.DATINI) AND
                ( (l_r064tes_aux.DATFIM < A.DATFIM AND l_r064tes_aux.DATFIM <> l_data_zero) OR A.DATFIM = l_data_zero) ) );
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_count:=0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro no SELECT R038TES - em R064TES_AU';
    END;
    IF  (l_count > 0) THEN
        l_strerr := 'Erro de Sobreposição de Escalas para Empresa = '||
                     CONVERT(NUMBER_TO_CHAR,l_r064tes_aux.NUMEMP)||' Colaborador = '||
                     CONVERT(NUMBER_TO_CHAR,l_r064tes_aux.NUMCAD);
        RAISERROR 103 l_strerr;
    END IF;

    SP_VerOnLine(l_online OUT);
    IF   (l_online = TRUE) THEN
        SP_AtuHor (l_r064tes_aux.numemp, l_r064tes_aux.tipcol, l_r064tes_aux.numcad,'');

        IF (l_r064tes_aux.STAACC = 2) THEN
            SELECT CODFIL INTO l_codfil FROM R034FUN WHERE NUMEMP = l_r064tes_aux.NUMEMP AND TIPCOL = l_r064tes_aux.TIPCOL AND NUMCAD = l_r064tes_aux.NUMCAD;
            SP_GerCrc('U',2,l_r064tes_aux.NUMEMP,
                        l_r064tes_aux.TIPCOL,
                        l_r064tes_aux.NUMCAD,
                        l_r064tes_aux.DATINI,
                        l_r064tes_aux.NUMEMP,
                        l_r064tes_aux.NUMCAD,
                        l_codfil,
                        0,
                        l_r064tes_aux.STAACC);
        END IF;
    END IF;
  END LOOP;

  /* Apaga Registro R064TES_AUX */
  BEGIN
    DELETE FROM R064TES_AUX;
    DROP_TEMP_TABLE R064TES_AUX;
  EXCEPTION WHEN OTHERS THEN
    l_comando_nulo:=TRUE;
  END;
END␀ÂØ␀␀		SENIOR;0ß␀␀

TRIGGER R064TES_EU AFTER UPDATE  ON R064TES FOR EACH ROW
DECLARE
  l_DataZero   DATE;
  l_data_fim   DATE;
  l_idtpes     CHAR(23);
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R064TES_AUX;
  
BEGIN
  /* Na Alteração do Registro seta todo o periodo como alterado */
  /* Também verifica a Data Final                               */
  l_DataZero := '31/12/1900,00:00:00';
  IF   ((:OLD.DATFIM = l_DataZero) OR (:NEW.DATFIM = l_DataZero)) THEN
       l_data_fim := '04/06/2080,00:00:00';
  ELSIF (:NEW.DATFIM > :OLD.DATFIM) THEN
       l_data_fim := :NEW.DATFIM;
  ELSE l_data_fim := :OLD.DATFIM;
  END IF;

  /* Verifica se foi alterado alguma campo que infuencia. Campo status nao influencia. */
  IF  (:NEW.DATFIM <> :OLD.DATFIM) OR (:NEW.CODESC <> :OLD.CODESC) OR (:NEW.CODTMA <> :OLD.CODTMA) OR (:NEW.TURINT <> :OLD.TURINT) OR (:NEW.STAACC <> :OLD.STAACC) THEN
      BEGIN
      UPDATE R066APU SET DIAALT = 2
         WHERE NUMEMP = :NEW.NUMEMP AND
               TIPCOL = :NEW.TIPCOL AND
               NUMCAD = :NEW.NUMCAD AND
               DATAPU >= :NEW.DATINI AND
               DATAPU <= l_data_fim;
      EXCEPTION WHEN OTHERS THEN
        NULL;
      END;
      
      /* se alterou o status ou o horário, então chama a atualização dos horários */
 	  BEGIN
	      INSERT INTO R064TES_AUX (TIPCOL,NUMEMP,NUMCAD,DATINI,DATFIM,STAACC,CODESC)
	                       VALUES (:NEW.TIPCOL,:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATINI,:NEW.DATFIM,:NEW.STAACC,:NEW.CODESC);
	  EXCEPTION 
	      WHEN OTHERS THEN RAISERROR 103 'Erro no INSERT em R064TES_AUX.';
	  END;      
  END IF;

  SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
  SP_SAM_PENDENCIES(42, 2, l_idtpes);
END␀ÃØ␀␀	SENIOR;0=␀␀

TRIGGER R064TES_SD AFTER DELETE ON R064TES

DECLARE
l_comando_nulo BOOLEAN;
  l_count        NUMBER(5);
  l_data_zero    DATE;
  l_online       BOOLEAN;
  l_codfil       NUMBER(6);

/* CURSOR c/ os registros gravados no R064tes_AUX */
  CURSOR c_r064tes_del IS SELECT NUMEMP,TIPCOL,NUMCAD,DATINI,DATFIM,STAACC,CODESC FROM R064TES_AUX;
  TYPE t_r064TES_aux IS RECORD(
    NUMEMP   R064TES_AUX.NUMEMP%TYPE,
    TIPCOL   R064TES_AUX.TIPCOL%TYPE,
    NUMCAD   R064TES_AUX.NUMCAD%TYPE,
    DATINI   R064TES_AUX.DATINI%TYPE,
    DATFIM   R064TES_AUX.DATFIM%TYPE,
    STAACC   R064TES_AUX.STAACC%TYPE,
    CODESC   R064TES_AUX.CODESC%TYPE);
  l_r064TES_aux t_r064TES_aux;

BEGIN
  l_comando_nulo:=FALSE;
  l_data_zero  := '31/12/1900,00:00:00';

  /* Le Registro do CURSOR */
  FOREACH c_r064tes_del INTO  l_r064TES_aux.NUMEMP,
                              l_r064TES_aux.TIPCOL,
                              l_r064TES_aux.NUMCAD,
                              l_r064TES_aux.DATINI,
                              l_r064TES_aux.DATFIM,
                              l_r064TES_aux.STAACC,
                              l_r064TES_aux.CODESC
  LOOP
    SP_VerOnLine(l_online OUT);
    IF   (l_online = TRUE) THEN
        SP_AtuHor (l_r064tes_aux.numemp, l_r064tes_aux.tipcol, l_r064tes_aux.numcad,'');

        SELECT CODFIL INTO l_codfil FROM R034FUN WHERE NUMEMP = l_r064tes_aux.NUMEMP AND TIPCOL = l_r064tes_aux.TIPCOL AND NUMCAD = l_r064tes_aux.NUMCAD;

        SP_GerCrc('D',2,l_r064tes_aux.NUMEMP,
                        l_r064tes_aux.TIPCOL,
                        l_r064tes_aux.NUMCAD,
                        l_r064tes_aux.DATINI,
                        l_r064tes_aux.NUMEMP,
                        l_r064tes_aux.NUMCAD,
                        l_codfil,
                        l_r064tes_aux.CODESC,
                        l_r064tes_aux.STAACC);
    END IF;
  END LOOP;

  /* Apaga Registro R064TES_AUX */
  BEGIN
    DELETE FROM R064TES_AUX;
    DROP_TEMP_TABLE R064TES_AUX;
  EXCEPTION WHEN OTHERS THEN
    l_comando_nulo:=TRUE;
  END;
END␀ÀØ␀␀		SENIOR;0F␀␀

TRIGGER R064TES_ED AFTER DELETE ON R064TES FOR EACH ROW
