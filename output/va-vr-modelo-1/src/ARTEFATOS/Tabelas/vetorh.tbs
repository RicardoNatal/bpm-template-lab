  NUMEMP,
  TIPCOL,
  NUMCAD,
  SISCES,
  SUM(VALMES) TOTACU,
  SUM(VALANT) TOTANT,
  SUM(JURANT) TOTJAN,
  SUM(DIATRB) TOTTRB,
  SUM(DIAFAL) TOTFAL,
  SUM(VALQUI) TOTQUI,
  SUM(JURQUI) TOTJQI
FROM 
