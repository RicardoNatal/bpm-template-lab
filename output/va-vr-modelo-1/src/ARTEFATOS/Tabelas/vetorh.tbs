␀µ_µ_q␀Æÿ␀␀ÿ␀D*‹␀„“␀␀␀␀␀•'•'•'ï*␀␀Æÿ␀␀ÿ␀2=„“␀␀␀␀␀X4D9D9c␀␀␀ÿ␀␀ÿ␀␀␀␀0Gá␀␀		SENIOR;0¿␀␀TRIGGER R127CUF_EU AFTER UPDATE ON R127CUF FOR EACH ROW

DECLARE
l_CurForPadrao   R000ASS.CUFDEF%TYPE;
BEGIN
  BEGIN
    /* Busca o curso de formação padrão definido nos assinalamentos diversos - R000ASS */  
    SELECT IFNULL(CUFDEF, 0) INTO l_CurForPadrao FROM R000ASS;  
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao ler R000ASS';
  END;

  /* Se NÃO é Curso Padrão E efetuou alteração no Nome do Curso deve Atualizar    */    
  /* o Nome do Curso na tabela R122CCF e R124HCF    */
  IF (l_CurForPadrao <> :NEW.CODCUF) AND
     (:OLD.NOMCUF <> :NEW.NOMCUF) THEN
    /* Utilizada tabela _AUX para controle, pois os UPDATES abaixo disparam triggers
       que fazem SELECT para o mesmo registro da tabela R127CUF e isso gera erro.
       A _AUX irá servir como flag de controle, indicando que o update foi chamado
       via trigger R127CUF e sendo assim, não é precisa executar as rotinas das
       demais triggers.                                                              */
    BEGIN
      INSERT INTO R127CUF_AUX (CODCUF)
                       VALUES (:NEW.CODCUF);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao inserir na R127CUF_AUX';
    END;

    BEGIN
      UPDATE R122CCF
         SET NOMCUF = :NEW.NOMCUF
       WHERE CODCUF = :NEW.CODCUF;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar a tabela R122CCF';
    END;

    BEGIN
      UPDATE R124HCF
         SET NOMCUF = :NEW.NOMCUF
       WHERE CODCUF = :NEW.CODCUF;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar a tabela R124HCF';
    END;

    BEGIN
      UPDATE R033HFO
         SET NOMCUF = :NEW.NOMCUF
       WHERE CODCUF = :NEW.CODCUF;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar a tabela R033HFO';
    END;

    BEGIN
      DELETE FROM R127CUF_AUX;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao excluir R127CUF_AUX';
    END;
  END IF;
