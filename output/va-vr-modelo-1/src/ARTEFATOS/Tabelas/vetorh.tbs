       END IF;

       BEGIN
         DELETE FROM R070PEV_AUX
         WHERE TIPDOC = l_r070pev_aux.TIPDOC AND
               NUMDOC = l_r070pev_aux.NUMDOC AND
               DATINI = l_r070pev_aux.DATINI AND
               HORINI = l_r070pev_aux.HORINI;
       EXCEPTION
         WHEN OTHERS THEN
           NULL;
       END;
  END LOOP;
END		SENIOR;22!SP_RETPEV
