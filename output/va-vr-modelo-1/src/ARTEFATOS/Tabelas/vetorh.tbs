mPROCEDURE SP_RET_ERROBANCO(MENSAGEMERRO IN OUT VARCHAR2(1024))
 IS
BEGIN
  MENSAGEMERRO := ' ';
  RETURN;
END	MSSQL;0
.␀␀CREATE PROCEDURE SP_RET_ERROBANCO ( @MENSAGEMERRO VARCHAR(1024) OUTPUT ) AS
BEGIN
  IF ERROR_NUMBER() <> 0
  BEGIN
    SET @MENSAGEMERRO = ' Erro banco: ' + CONVERT(VARCHAR, ERROR_NUMBER()) + '-' + ERROR_MESSAGE();  
  END
  ELSE
  BEGIN
    SET @MENSAGEMERRO = ' ';
  END;

  RETURN;
END
