í␀␀PROCEDURE R070HCH_VSOB(P_TIPOPE CHAR,P_TIPCRA NUMBER,P_NUMEMP NUMBER(4),P_NUMCAD NUMBER(9),P_NUMCRA NUMBER,P_DATINI DATE,P_HORINI NUMBER,P_DATFIM DATE,P_HORFIM NUMBER)
 IS

l_data_zero    DATE;
  l_datini       DATE;
  l_datant       DATE;
  l_count        NUMBER(5);
  l_horant       NUMBER(5);
  l_horini       NUMBER(5);
  l_tipcra  	  NUMBER(2);
  l_numemp       NUMBER;
  l_numcad       NUMBER;
  l_comando_nulo BOOLEAN;
  l_errstr       VARCHAR2(255);


BEGIN
  /* Faz consistencia de sobreposição de crachá */
  l_count := 0;
  l_data_zero  :='31/12/1900,00:00:00';
  BEGIN
    SELECT COUNT(*) INTO l_count
     FROM R038HCH A
    WHERE  (A.NUMCRA = p_numcra)
      AND ( ( (A.DATINI > p_datini OR (A.DATINI = p_datini AND A.HORINI >= p_horini)) AND
              (A.DATINI < p_datfim OR p_DATFIM = l_data_zero OR (A.DATINI = p_datfim AND (A.HORINI <= p_horfim OR p_horfim = 0))) )
       OR   ( (A.DATFIM > p_datini OR A.DATFIM = l_data_zero OR (A.DATFIM = p_datini AND (A.HORFIM >= p_horini OR A.HORFIM = 0))) AND
              ((A.DATFIM < p_datfim AND A.DATFIM <> l_data_zero) OR p_datfim = l_data_zero OR (A.DATFIM = p_datfim AND (A.HORFIM <= p_horfim OR p_horfim = 0)))
       OR   ( (p_datini > A.DATINI OR (p_datini = A.DATINI AND p_horini >= A.HORINI)) AND
              ((p_datfim < A.DATFIM AND p_datfim <> l_data_zero) OR A.DATFIM = l_data_zero OR (p_DATFIM = A.DATFIM AND p_horfim <= A.HORFIM)) ) ) );
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_count:=0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT R038HCH';
  END;
  /* Se não houver sobreposição de crachá em colaboradores */
  IF  l_count = 0 THEN
      BEGIN
        SELECT NUMEMP,TIPCRA,NUMCAD,COUNT(*) INTO l_numemp,l_tipcra,l_numcad,l_count
         FROM R070HCH A
        WHERE  ((A.TIPCRA = p_tipcra AND  A.NUMEMP = p_numemp AND  A.NUMCAD = p_numcad) OR (A.NUMCRA = p_numcra))
          AND (A.DATINI <> p_datini OR (A.DATINI = p_datini AND A.HORINI <> p_horini))
          AND ( ( (A.DATINI > p_datini OR (A.DATINI = p_datini AND A.HORINI >= p_horini)) AND
                  (A.DATINI < p_datfim OR p_DATFIM = l_data_zero OR (A.DATINI = p_datfim AND (A.HORINI <= p_horfim OR p_horfim = 0))) )
           OR   ( (A.DATFIM > p_datini OR A.DATFIM = l_data_zero OR (A.DATFIM = p_datini AND (A.HORFIM >= p_horini OR A.HORFIM = 0))) AND
                  ((A.DATFIM < p_datfim AND A.DATFIM <> l_data_zero) OR p_datfim = l_data_zero OR (A.DATFIM = p_datfim AND (A.HORFIM <= p_horfim OR p_horfim = 0)))
           OR   ( (p_datini > A.DATINI OR (p_datini = A.DATINI AND p_horini >= A.HORINI)) AND
                  ((p_datfim < A.DATFIM AND p_datfim <> l_data_zero) OR A.DATFIM = l_data_zero OR (p_DATFIM = A.DATFIM AND p_horfim <= A.HORFIM)) ) ) )
        GROUP BY NUMEMP,TIPCRA,NUMCAD;
      EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_count:=0;
            l_comando_nulo:=TRUE;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT R070HCH-1';
      END;
      IF  l_count > 0 THEN
          /* se estiver inserindo e for o mesmo colaborador que sobrepos */
          IF   (p_tipope = 'I') AND
               (l_numemp = p_numemp) AND
               (l_tipcra = p_tipcra) AND
               (l_numcad = p_numcad) THEN
               /* Se tiver incluindo fechar o ultimo cracha */
               /* verifica se a sobreposição esta no ultimo historico */
               /* pega o ultimo historico em aberto */
               l_comando_nulo:=TRUE;
               BEGIN
                SELECT A.DATINI,A.HORINI INTO l_datini,l_horini
                FROM R070HCH A
                WHERE A.NUMEMP = p_NUMEMP
                  AND A.TIPCRA = p_TIPCRA
                  AND A.NUMCAD = p_NUMCAD
                  AND A.DATFIM = l_data_zero
                  AND A.DATINI IN (SELECT MAX(DATINI) FROM R070HCH
                                 WHERE NUMEMP = p_NUMEMP
                                   AND   TIPCRA = p_TIPCRA
                                   AND   NUMCAD = p_NUMCAD
                                   AND   (DATINI < p_DATINI OR
                                         (DATINI = p_DATINI AND HORINI < p_HORINI)))
                  AND A.HORINI IN (SELECT MAX(HORINI) FROM R070HCH
                                  WHERE NUMEMP = p_NUMEMP
                                    AND   TIPCRA = p_TIPCRA
                                    AND   NUMCAD = p_NUMCAD
                                    AND   (DATINI < p_DATINI OR
                                          (DATINI = p_DATINI AND HORINI < p_HORINI)));
               EXCEPTION
                 WHEN TOO_MANY_ROWS THEN
                   l_errstr := 'Erro em R070HCH - TOO MANY ROWS. '||
                               ' EMP : '||CONVERT(NUMBER_TO_CHAR,p_NUMEMP)||
                               ' TIP : '||CONVERT(NUMBER_TO_CHAR,p_TIPCRA)||
                               ' CAD : '||CONVERT(NUMBER_TO_CHAR,p_NUMCAD);
                   RAISERROR 103 l_errstr;

                 WHEN NO_DATA_FOUND THEN
                   l_comando_nulo:=FALSE;
                 WHEN OTHERS THEN
                   RAISERROR 103 'Erro no SELECT R070HCH';
               END;
               /* fecha o ultimo historico se este estiver aberto */
               IF   (l_comando_nulo = TRUE) THEN
                    /* se a hora inicial do novo historico for zero hora então decrementa o dia e a hora fica = 23:59 */
                    IF  p_HORINI = 0 THEN
                        l_horant := 1439;
                        l_datant := DATETimeAdd(DD,-1,p_datini);
                    ELSE
                        l_datant := p_datini;
                        l_horant := p_horini-1;
                    END IF;
                    /* fecha o ultimo historico em aberto */
                    UPDATE R070HCH
                    SET DATFIM = l_datant, HORFIM = l_horant
                    WHERE NUMEMP = p_NUMEMP
                    AND   TIPCRA = p_TIPCRA
                    AND   NUMCAD = p_NUMCAD
                    AND   DATINI = l_datini
                    AND   HORINI = l_horini;
               ELSE
                    l_errstr := 'Erro de Sobreposição de crachás para Empresa = '||
                                 CONVERT(NUMBER_TO_CHAR,p_numemp)||' Colaborador = '||
                                 CONVERT(NUMBER_TO_CHAR,p_numcad);
                    RAISERROR 103 l_errstr;
               END IF;
               l_comando_nulo:=FALSE;
          ELSE
               l_errstr := 'Erro de Sobreposição de crachás para Empresa = '||
                            CONVERT(NUMBER_TO_CHAR,p_numemp)||' Colaborador = '||
                            CONVERT(NUMBER_TO_CHAR,p_numcad)||' Crachá = '||
                            CONVERT(NUMBER_TO_CHAR,p_numcra);
               RAISERROR 103 l_errstr;
          END IF;
      END IF;
  ELSE
      l_errstr := 'Sobreposição de crachás com Histórico de Colaboradores para Crachá = '||
                   CONVERT(NUMBER_TO_CHAR,p_numcra);
      RAISERROR 103 l_errstr;
  END IF;
END␀Ú␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
