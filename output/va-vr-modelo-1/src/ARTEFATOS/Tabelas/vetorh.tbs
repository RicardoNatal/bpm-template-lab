    END;
  END IF;
END␀␀␀¿m␀␀␀␀␀␀␀␀bß␀␀…¬␀␀´␀	€␀␀␀␀␀␀G;XbXbr␀Æÿ␀␀Ò␀␀␀–,Ì␀	€␀␀␀␀␀␀=§m¹m”)␀␀Æÿ␀␀>ß␀␀␀EÑ␀	€␀␀␀␀␀␀=NZ”␀␀£GqC␀êÿ␀␀eß␀␀␀Ş␀´␀€␀␀␀␀␀␀>½␀␀r␀Æÿ␀␀YĞ␀␀␀§¬␀␀Ì␀€␀␀␀␀␀␀Ôš␀␀€š␀␀€š␀␀m␀Æÿ␀␀aĞ␀␀␀f´␀€␀␀␀␀␀␀÷<ïe»fr␀Æÿ␀␀)Ñ␀␀␀0,4€␀␀␀␀␀␀ÿ?µ'µ'}␀␀ÿ␀␀Ñ␀␀␀µEÑ␀€␀␀␀␀␀␀‡N6␀ÉHqC␀êÿ␀␀ÿ␀Ì³␀␀d€␀␀␀␀␀␀©´␀␀ñ³␀␀ñ³␀␀C␀␀ÿ␀␀ÿ␀îTU€␀␀␀␀␀␀g£␀␀Î¢␀␀Î¢␀␀V␀␀ÿ␀␀ÿ␀,¼␀€␀␀␀␀␀␀Ğ?ääv␀Æÿ␀␀ß␀␀␀Ç1=€␀␀␀␀␀␀Ç3␀¹␀␀3c␀␀␀ÿ␀␀ÿ␀␀␀␀0;1;2fß␀␀		SENIOR;0ò␀␀TRIGGER R110HRE_EI AFTER INSERT ON R110HRE FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  l_codSistema := 1;
  l_codcpa := 134;
  l_codtpa := 399;

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110HRE_AI', '');

    /* Insere os campos chave na tabela de auditoria R995PRC*/
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIC));
      SP_DATSTR(:NEW.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110HRE_AI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    /* Insere os valores dos campos na tabela de auditoria R995PRT*/
    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :NEW.TABORG));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', CONVERT(NUMBER_TO_CHAR, :NEW.NUMLOC));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCAR', CONVERT(NUMBER_TO_CHAR, :NEW.ESTCAR));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAR', :NEW.CODCAR);
      SP_DATSTR(:NEW.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATTER', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSRMJ', :NEW.OBSRMJ);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESMOT', :NEW.DESMOT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR, :NEW.CODATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONPPP', :NEW.CONPPP);      
    END;
  END IF;
END␀dß␀␀		SENIOR;0í␀␀


TRIGGER R110HRE_AU
AFTER UPDATE ON R110HRE
FOR EACH ROW
DECLARE
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
BEGIN
  IF (
  :OLD.TABORG <>:NEW.TABORG OR
  :OLD.NUMLOC <>:NEW.NUMLOC OR
  :OLD.ESTCAR <>:NEW.ESTCAR OR
  :OLD.CODCAR <>:NEW.CODCAR OR
  :OLD.DATTER <>:NEW.DATTER OR
  :OLD.OBSRMJ <>:NEW.OBSRMJ OR
  :OLD.DESMOT <>:NEW.DESMOT OR
  :OLD.CODATE <>:NEW.CODATE OR
  :OLD.CONPPP <>:NEW.CONPPP
  ) THEN
    l_codSistema:= 1;
    l_codcpa:= 134;  /* Código da categoria de auditoria - Histórico de Remanejamento*/
    l_codtpa:= 400;  /* Código do tipo de auditoria - Alteração*/

    SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110HRE_AU', '');

      /* Insere os campos chave na tabela de auditoria R995PRC*/
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR,:OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR,:OLD.CODFIC));
        SP_DATSTR(:OLD.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110HRE_AU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      /* Insere os valores dos campos na tabela de auditoria R995PRT*/
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTABORG', CONVERT(NUMBER_TO_CHAR,:OLD.TABORG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTABORG', CONVERT(NUMBER_TO_CHAR,:NEW.TABORG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMLOC', CONVERT(NUMBER_TO_CHAR,:OLD.NUMLOC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMLOC', CONVERT(NUMBER_TO_CHAR,:NEW.NUMLOC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDESTCAR', CONVERT(NUMBER_TO_CHAR,:OLD.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWESTCAR', CONVERT(NUMBER_TO_CHAR,:NEW.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCAR',:OLD.CODCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCAR',:NEW.CODCAR);
        SP_DATSTR(:OLD.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATTER', l_datTemp);
        SP_DATSTR(:NEW.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATTER', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSRMJ',:OLD.OBSRMJ);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSRMJ',:NEW.OBSRMJ);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDESMOT',:OLD.DESMOT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDESMOT',:NEW.DESMOT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODATE', CONVERT(NUMBER_TO_CHAR,:OLD.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODATE', CONVERT(NUMBER_TO_CHAR,:NEW.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONPPP',:OLD.CONPPP);      
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONPPP',:NEW.CONPPP);
      END;
    END IF;
  END IF;
END␀cß␀␀		SENIOR;0õ␀␀

