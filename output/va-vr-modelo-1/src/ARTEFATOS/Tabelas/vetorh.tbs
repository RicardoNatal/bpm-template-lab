    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'situacao', p_SituacaoWAV);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'horaVisita', l_HorVisStr);
    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomeVisitante', p_NomVis);
