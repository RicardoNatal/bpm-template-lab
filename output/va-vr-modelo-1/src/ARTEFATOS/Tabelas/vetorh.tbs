DECLARE
  l_Valor VARCHAR2(2000);
  l_DataInicioTabelas DATE;
  l_VarDateAux DATE;
  l_DataInicioNaoPeriodicos DATE;
  l_DataInicioPeriodicos DATE;
  l_DataInicioSST DATE;
  l_DataInicioMigracao DATE;
  l_layout VARCHAR(6);
  l_gerarPendencia BOOLEAN;
BEGIN
  l_Valor := '';
  l_gerarPendencia := TRUE;
  
  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
  N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
  IF (l_gerarPendencia = TRUE) THEN  	
    SP_CONCATENAR_NUM('FILEMP', :NEW.FILEMP, l_Valor OUT);
    SP_CONCATENAR_NUM('CPFTRA', :NEW.CPFTRA, l_Valor OUT);
    SP_CONCATENAR_DES('NOMFUN', :NEW.NOMFUN, l_Valor OUT);
    SP_CONCATENAR_DAT('DATADM', :NEW.ADMCOL, l_Valor OUT);
    SP_CONCATENAR_DES('MATESO', :NEW.MATESO, l_Valor OUT);
    SP_CONCATENAR_NUM('SEQPRL', :NEW.SEQPRL, l_Valor OUT);
  
    RH_DEF_ESOCIAL(:NEW.NUMEMP, l_DataInicioTabelas OUT, l_VarDateAux OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
    IF ((l_DataInicioNaoPeriodicos <> DATETIME(31, 12, 1900, 0, 0, 0)) AND (l_DataInicioNaoPeriodicos <= :NEW.ADMCOL) AND (:NEW.OriReg <> 1)) THEN
  	  SP_E_SOCIAL('S-2190', 'R034PRL', 'N', 'I', NULL, NULL, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, :NEW.ADMCOL, 0, 'R034PRL_AI');
    END IF;
  END IF;    
END␀ÒÓ␀␀		SENIOR;0'␀␀

TRIGGER R034PRL_EU AFTER UPDATE ON R034PRL FOR EACH ROW
DECLARE
	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_layout VARCHAR2(6); 
	l_TipoEsocial NUMBER;
    l_VarDateAux DATE;
	l_DataInicioTabelas DATE;
    l_DataInicioNaoPeriodicos DATE;
    l_DataInicioPeriodicos DATE;
    l_DataInicioSST DATE;
    l_DataInicioMigracao DATE;
	l_Valor VARCHAR2(2000);
	l_JsonCamposAlterados VARCHAR2(2000);
    l_gerarPendencia BOOLEAN;	
BEGIN
	/* eSocial */
	l_Alterou := FALSE;
	l_JsonCamposAlterados := '';
	l_Valor := '';
    l_gerarPendencia := TRUE;
  
    IF (:NEW.OriReg = 1) THEN
    	l_gerarPendencia := FALSE;
    ELSE 
      RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
      N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    END IF;
    IF (l_gerarPendencia = TRUE) THEN  	  
	
      SP_CONCATENAR_NUM('FILEMP', :NEW.FILEMP, l_Valor OUT);
      SP_CONCATENAR_NUM('CPFTRA', :NEW.CPFTRA, l_Valor OUT);
      SP_CONCATENAR_DES('NOMFUN', :NEW.NOMFUN, l_Valor OUT);
      SP_CONCATENAR_DAT('DATADM', :NEW.ADMCOL, l_Valor OUT);
      SP_CONCATENAR_DES('MATESO', :NEW.MATESO, l_Valor OUT);
      SP_CONCATENAR_NUM('SEQPRL', :NEW.SEQPRL, l_Valor OUT);
      
      SP_VALUPDATE_DAT(:OLD.AdmCol, :NEW.AdmCol, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_DAT_JSON('ADMCOL', :NEW.AdmCol, :OLD.AdmCol, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_DES(:OLD.NomFun, :NEW.NomFun, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_DES_JSON('NOMFUN', :NEW.NomFun, :OLD.NomFun, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_NUM(:OLD.CodVin, :NEW.CodVin, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_NUM_JSON('CODVIN', :NEW.CodVin, :OLD.CodVin, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_NUM(:OLD.CateSo, :NEW.CateSo, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_NUM_JSON('CATESO', :NEW.CateSo, :OLD.CateSo, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_NUM(:OLD.EstCar, :NEW.EstCar, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_NUM_JSON('ESTCAR', :NEW.EstCar, :OLD.EstCar, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_DES(:OLD.CodCar, :NEW.CodCar, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_DES_JSON('CODCAR', :NEW.CodCar, :OLD.CodCar, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_NUM(:OLD.CodEst, :NEW.CodEst, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_NUM_JSON('CODEST', :NEW.CodEst, :OLD.CodEst, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_NUM(:OLD.TipSal, :NEW.TipSal, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_NUM_JSON('TIPSAL', :NEW.TipSal, :OLD.TipSal, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_NUM(:OLD.TipEst, :NEW.TipEst, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_NUM_JSON('TIPEST', :NEW.TipEst, :OLD.TipEst, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_DES(:OLD.ClaSal, :NEW.ClaSal, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_DES_JSON('CLASAL', :NEW.ClaSal, :OLD.ClaSal, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_DES(:OLD.NivSal, :NEW.NivSal, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_DES_JSON('NIVSAL', :NEW.NivSal, :OLD.NivSal, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_NUM(:OLD.ValSal, :NEW.ValSal, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_FLO_JSON('VALSAL', :NEW.VALSAL, :OLD.VALSAL, 4, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_DAT(:OLD.DatNas, :NEW.DatNas, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_DAT_JSON('DATNAS', :NEW.DatNas, :OLD.DatNas, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_NUM(:OLD.DurCon, :NEW.DurCon, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_NUM_JSON('DURCON', :NEW.DurCon, :OLD.DurCon, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_NUM(:OLD.ProCon, :NEW.ProCon, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_NUM_JSON('PROCON', :NEW.ProCon, :OLD.ProCon, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_DES(:OLD.ObjDet, :NEW.ObjDet, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_DES_JSON('OBJDET', :NEW.ObjDet, :OLD.ObjDet, l_JsonCamposAlterados OUT);
      END IF;
      
      /* ATENÇÃO: Tipo de Colaborador e Cadastro não devem ter monitoramento */
      IF (l_Alterou = TRUE) THEN
      	RH_DEF_ESOCIAL(:OLD.NUMEMP, l_DataInicioTabelas OUT, l_VarDateAux OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
      	IF ((l_DataInicioNaoPeriodicos <> DATETIME(31, 12, 1900, 0, 0, 0)) AND (l_DataInicioNaoPeriodicos <= :OLD.ADMCOL)) THEN
      		SP_E_SOCIAL('S-2190', 'R034PRL', 'N', 'A', NULL, NULL, :NEW.NUMEMP, 0, 0, l_Valor, l_JsonCamposAlterados, 0, NULL, :NEW.ADMCOL, 0, 'R034PRL_EU');
      	END IF;
      END IF;
  END IF;	
END␀ĞÓ␀␀		SENIOR;0␀␀

TRIGGER R034PRL_AD AFTER DELETE ON R034PRL FOR EACH ROW
DECLARE
  l_Valor VARCHAR2(2000);
  l_DataInicioTabelas DATE;
  l_VarDateAux DATE;
  l_DataInicioNaoPeriodicos DATE;
  l_DataInicioPeriodicos DATE;
  l_DataInicioSST DATE;
  l_DataInicioMigracao DATE;
  l_layout VARCHAR(6);
  l_gerarPendencia BOOLEAN;	  
BEGIN
  l_Valor := '';
  l_gerarPendencia := TRUE;
 
  RH_LAYOUTCOLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layout OUT);
  N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
  IF (l_gerarPendencia = TRUE) THEN  	  
    SP_CONCATENAR_NUM('FILEMP', :OLD.FILEMP, l_Valor OUT);
    SP_CONCATENAR_NUM('CPFTRA', :OLD.CPFTRA, l_Valor OUT);
    SP_CONCATENAR_DES('NOMFUN', :OLD.NOMFUN, l_Valor OUT);
    SP_CONCATENAR_DAT('DATADM', :OLD.ADMCOL, l_Valor OUT);
    SP_CONCATENAR_DES('MATESO', :OLD.MATESO, l_Valor OUT);
    SP_CONCATENAR_NUM('SEQPRL', :OLD.SEQPRL, l_Valor OUT);
    SP_CONCATENAR_DES('LAYOUT', 'S-2190', l_Valor OUT);
  
    RH_DEF_ESOCIAL(:OLD.NUMEMP, l_DataInicioTabelas OUT, l_VarDateAux OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
    IF ((l_DataInicioNaoPeriodicos <> DATETIME(31, 12, 1900, 0, 0, 0)) AND (l_DataInicioNaoPeriodicos <= :OLD.ADMCOL)) THEN
	  SP_E_SOCIAL('S-3000', 'R034PRL', 'N', 'E', NULL, NULL, :OLD.NUMEMP, 0, 0, l_Valor, '', 0, NULL, :OLD.ADMCOL, 0, 'R034PRL_AD');
    END IF;
  END IF;  
END␀␀␀åï␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÔÓ␀␀7‹␀␀3	␀␀␀␀␀␀bŠ␀␀bŠ␀␀YŠ␀␀4␀␀ÿ␀␀ÿ␀5-·␀	␀␀␀␀␀␀\A“␀“␀s␀Æÿ␀␀ë×␀␀␀x-·␀	␀␀␀␀␀␀@¥.¥.u␀Æÿ␀␀Ø␀␀␀¥%␀±␀	␀␀␀␀␀␀?&␀;&␀<&␀q␀Æÿ␀␀6Ø␀␀␀3-Á␀	␀␀␀␀␀␀Ï@˜š␀␀˜š␀␀y␀Æÿ␀␀å×␀␀␀m,Ì␀	␀␀␀␀␀␀N@¤:¤:{␀Æÿ␀␀ÿ␀V¬␀␀Ì␀␀␀␀␀␀␀iaa{␀Æÿ␀␀f×␀␀␀…¬␀␀´␀␀␀␀␀␀␀‘<XbXbr␀␀Æÿ␀␀Ò␀␀␀.␀t␀␀␀␀␀␀Ü␀t␀Ü␀n ˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀␀␀␀␀␀␀.%0.0.wˆ␀␀Æÿ␀␀…Ó␀␀␀ş␀␀¢␀␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀+f±␀␀␀␀␀␀␀=øeËfq␀Æÿ␀␀d`␀Ä␀␀4␀␀␀␀␀␀(Ap:Û;f␀␀␀ÿ␀␀ş¸␀␀␀5¶␀␀İ␀␀␀␀␀␀ò¶␀␀§¶␀␀ò¶␀␀n␀Æÿ␀␀ÿ0␀␀␀0;3;4;1;2;5×Ó␀␀		SENIOR;0á␀␀TRIGGER R034PRM_EI BEFORE INSERT ON R034PRM FOR EACH ROW

DECLARE
l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
BEGIN
  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R034PRM');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R034PRM_AUD (SEQREG,VERSEQ,IDTPES,CODPLT,CODRLG,VERPLF,CODPLF,CODDSP,NUMAMB,NUMEMP,TIPCOL,NUMCAD)
                           VALUES (l_seqreg,l_verseq,:NEW.IDTPES,:NEW.CODPLT,:NEW.CODRLG,:NEW.VERPLF,
                                   :NEW.CODPLF,:NEW.CODDSP,:NEW.NUMAMB,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD);

          SP_AUDGENREG(l_seqreg,l_verseq,'R034PRM','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀ØÓ␀␀		SENIOR;0Ë␀␀

TRIGGER R034PRM_EU AFTER UPDATE ON R034PRM FOR EACH ROW

DECLARE
l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
BEGIN
  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R034PRM');

  IF (l_auditoria = 'S') THEN
      l_camposAlterados := 'Campo(s) alterado(s): ';
      l_alterou := FALSE;

      IF (:NEW.IDTPES <> :OLD.IDTPES) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'IDTPES ';
      END IF;

      IF (:NEW.CODPLT <> :OLD.CODPLT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPLT ';
      END IF;

      IF (:NEW.CODRLG <> :OLD.CODRLG) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODRLG ';
      END IF;

      IF (:NEW.VERPLF <> :OLD.VERPLF) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'VERPLF ';
      END IF;

      IF (:NEW.CODPLF <> :OLD.CODPLF) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPLF ';
      END IF;

      IF (:NEW.CODDSP <> :OLD.CODDSP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODDSP ';
      END IF;

      IF (:NEW.NUMAMB <> :OLD.NUMAMB) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMAMB ';
      END IF;

      IF (:NEW.NUMEMP <> :OLD.NUMEMP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMEMP ';
      END IF;

      IF (:NEW.TIPCOL <> :OLD.TIPCOL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPCOL ';
      END IF;

      IF (:NEW.NUMCAD <> :OLD.NUMCAD) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCAD ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R034PRM_AUD
                   WHERE IDTPES = :OLD.IDTPES AND
                         CODPLT = :OLD.CODPLT AND
                         CODRLG = :OLD.CODRLG AND
                         VERPLF = :OLD.VERPLF AND
                         CODPLF = :OLD.CODPLF AND
                         CODDSP = :OLD.CODDSP;
                EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R034PRM_AUD (SEQREG,VERSEQ,IDTPES,CODPLT,CODRLG,VERPLF,CODPLF,CODDSP,NUMAMB,NUMEMP,TIPCOL,NUMCAD)
                               VALUES (l_seqreg,l_verseq,:NEW.IDTPES,:NEW.CODPLT,:NEW.CODRLG,:NEW.VERPLF,
                                      :NEW.CODPLF,:NEW.CODDSP,:NEW.NUMAMB,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD);

              SP_AUDGENREG(l_seqreg,l_verseq,'R034PRM',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀ÖÓ␀␀		SENIOR;0[␀␀

TRIGGER R034PRM_ED AFTER DELETE ON R034PRM FOR EACH ROW

DECLARE
l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
BEGIN
  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R034PRM');

  IF (l_auditoria = 'S') THEN
      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN
          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R034PRM_AUD
                   WHERE IDTPES = :OLD.IDTPES AND
                         CODPLT = :OLD.CODPLT AND
                         CODRLG = :OLD.CODRLG AND
                         VERPLF = :OLD.VERPLF AND
                         CODPLF = :OLD.CODPLF AND
                         CODDSP = :OLD.CODDSP;
           EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
          INSERT INTO R034PRM_AUD (SEQREG,VERSEQ,IDTPES,CODPLT,CODRLG,VERPLF,CODPLF,CODDSP,NUMAMB,NUMEMP,TIPCOL,NUMCAD)
                           VALUES (l_seqreg,l_verseq,:OLD.IDTPES,:OLD.CODPLT,:OLD.CODRLG,:OLD.VERPLF,
                                  :OLD.CODPLF,:OLD.CODDSP,:OLD.NUMAMB,:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD);

          SP_AUDGENREG(l_seqreg,l_verseq,'R034PRM','DELETE');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀␀␀Ä¿␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÕÓ␀␀ş␀␀¢␀	␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀­%␀‹␀	␀␀␀␀␀␀(&␀|%␀&␀a␀Æÿ␀␀ÿ␀7‹␀␀3	␀␀␀␀␀␀bŠ␀␀bŠ␀␀YŠ␀␀4␀␀ÿ␀␀ÿ␀5-·␀	␀␀␀␀␀␀\A“␀“␀s␀Æÿ␀␀ÿ␀x-·␀	␀␀␀␀␀␀@¥.¥.u␀Æÿ␀␀ÿ␀¥%␀±␀	␀␀␀␀␀␀?&␀;&␀<&␀q␀Æÿ␀␀ÿ␀3-Á␀	␀␀␀␀␀␀Ï@˜š␀␀˜š␀␀y␀Æÿ␀␀ÿ␀m,Ì␀	␀␀␀␀␀␀N@¤:¤:{␀Æÿ␀␀ÿ␀V¬␀␀Ì␀␀␀␀␀␀␀iaa{␀Æÿ␀␀ÿ␀…¬␀␀´␀␀␀␀␀␀␀‘<XbXbr␀␀Æÿ␀␀ÿ␀.␀t␀␀␀␀␀␀Ü␀t␀Ü␀n ˆ␀Æÿ␀␀ÿ␀c¬␀␀Ì␀␀␀␀␀␀␀.%0.0.wˆ␀␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3;4;5;6;7␀␀J␀␀␀␀␀␀␀␀␀␀␀␀␀ÙÓ␀␀…¬␀␀´␀	Ôÿ1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ1␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ1␀␀␀␀␀.%€$0.w␀Æÿ␀␀…Ó␀␀␀ª¬␀␀	Ôÿ1␀␀␀␀␀©␀␀v␀␀v␀␀%␀␀ÿ␀␀ÿ␀EÑ␀Ôÿ1␀␀␀␀␀,N]G]GqC␀␀êÿ␀␀ÿ␀␀␀␀0;1;2␀␀–␀␀␀␀␀␀␀␀ÚÓ␀␀…¬␀␀´␀	€‚␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	€‚␀␀␀␀␀Ü␀t␀Ü␀n%ˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	€‚␀␀␀␀␀.%0.0.w"ˆ␀Æÿ␀␀…Ó␀␀␀˜EÑ␀	€‚␀␀␀␀␀^L“H”HqCş‡␀êÿ␀␀ÿ␀Y,Ì␀	€‚␀␀␀␀␀?@V9V9{␀Æÿ␀␀xá␀␀␀,‹␀␀~€‚␀␀␀␀␀½®␀␀P˜␀␀P˜␀␀c␀␀␀ÿ␀␀ÿ␀*‹␀␀~€‚␀␀␀␀␀¼®␀␀´e´ec␀␀␀ÿ␀␀ÿ␀(‹␀␀~€‚␀␀␀␀␀»®␀␀2727c␀␀␀ÿ␀␀ÿ␀µEÑ␀€‚␀␀␀␀␀ÈLT␀U␀qCş‡␀êÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀wò␀␀␀␀␀␀␀␀␀␀␀␀ÛÓ␀␀…¬␀␀´␀	€‚␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	€‚␀␀␀␀␀Ü␀t␀Ü␀n%ˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	€‚␀␀␀␀␀.%0.0.w"ˆ␀Æÿ␀␀…Ó␀␀␀˜EÑ␀	€‚␀␀␀␀␀^L“H”HqCş‡␀êÿ␀␀ÿ␀‘lT	€‚␀␀␀␀␀=—lšlp␀␀␀ÿ␀␀ûà␀␀␀L,b	€‚␀␀␀␀␀3@<3<3r␀␀␀ÿ␀␀ùà␀␀␀,‹␀␀~€‚␀␀␀␀␀½®␀␀P˜␀␀P˜␀␀c␀␀␀ÿ␀␀ÿ␀*‹␀␀~€‚␀␀␀␀␀¼®␀␀´e´ec␀␀␀ÿ␀␀ÿ␀(‹␀␀~€‚␀␀␀␀␀»®␀␀2727c␀␀␀ÿ␀␀ÿ␀Ûiÿ€‚␀␀␀␀␀QjN