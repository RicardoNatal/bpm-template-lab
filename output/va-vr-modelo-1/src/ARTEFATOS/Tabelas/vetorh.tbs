␀␀PROCEDURE SP_AUltRs(P_CRAATU NUMBER(12),P_CRAOLD NUMBER(12))
 IS

  l_craAtu       CHAR(12);
  l_craOld       CHAR(12);
  l_craAux       CHAR(12);
  l_ultrs        CHAR(25);
  l_update       BOOLEAN;
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_usutel       VARCHAR(31);
  l_comando      VARCHAR(2048);
  l_retnumberaux NUMBER(1);
  l_reterr       NUMBER(1);
  l_craAux_num   NUMBER(12);
  l_icardA       VARCHAR2(12);
  l_icardR       VARCHAR2(12);
  l_numser       VARCHAR2(12);  
  l_nivatu       CHAR(5);
  l_datniv       DATE;
  l_horniv       CHAR(5);
  l_seqniv       CHAR(6);  
BEGIN

  /*Atualiza Nível na R070CON*/
  l_nivatu := '99000';
  l_datniv := CURDATE();
  l_horniv := '2359';
  l_seqniv := '000001';  
  BEGIN
      SELECT nivatu, datniv, CONVERT(NUMBER_TO_CHAR, horniv), CONVERT(NUMBER_TO_CHAR, seqniv) INTO l_nivatu, l_datniv, l_horniv, l_seqniv 
        FROM R070CON WHERE NUMCRA = p_craold AND CHCPRI = 0;
  EXCEPTION
      WHEN OTHERS THEN  l_nivatu := '99000';
                        l_datniv := CURDATE();
                        l_horniv := '2359';
                        l_seqniv := '000001';
  END;
  BEGIN
	  UPDATE R070CON SET NIVATU = l_nivatu, DATNIV = l_datniv, HORNIV = CONVERT(CHAR_TO_NUMBER, l_horniv), SEQNIV = CONVERT(CHAR_TO_NUMBER, l_seqniv) WHERE NUMCRA = CONVERT(CHAR_TO_NUMBER, p_craatu);                     
	  /*SP_PEND26(l_idtpes, l_nivatu, l_datniv, l_horniv, l_seqniv);*/
  EXCEPTION 
      WHEN OTHERS THEN RAISERROR 103 'SP_AultRs: Erro Na Atualização do nível.';
  END;  
END		SENIOR;20DSP_USUTEL
