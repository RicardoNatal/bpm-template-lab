/* DELETE (OLD) */
TRIGGER R048CTB_ED AFTER DELETE ON R048CTB FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  xCodLoc 		   R016HIE.CODLOC%TYPE;
BEGIN

  /* Geração de logs FichaFinanceiraRateio*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 69;     /* FichaFinanceiraRateio*/
  l_codtpa := 249;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R048CTB_ED', '');
      
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NumEmp));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TipCol));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NumCad));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CodFil));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOEM', CONVERT(NUMBER_TO_CHAR, :OLD.CodOem));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQPAG', CONVERT(NUMBER_TO_CHAR, :OLD.SeqPag));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :OLD.TabOrg));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :OLD.TabEve));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCLC', CONVERT(NUMBER_TO_CHAR, :OLD.CodClc));
		SP_DATSTR(:OLD.DatLan, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATLAN', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OPCCTB', CONVERT(NUMBER_TO_CHAR, :OLD.OpcCtb));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAL', CONVERT(NUMBER_TO_CHAR, :OLD.CodCal));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODLOT', CONVERT(NUMBER_TO_CHAR, :OLD.CodLot));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQLOT', CONVERT(NUMBER_TO_CHAR, :OLD.SeqLot));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DEBCRE', :OLD.DebCre);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HISPAD', CONVERT(NUMBER_TO_CHAR, :OLD.HisPad));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CPLHIS', :OLD.CplHis);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NATDES', CONVERT(NUMBER_TO_CHAR, :OLD.NatDes));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONFIN', CONVERT(NUMBER_TO_CHAR, :OLD.ConFin));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODAUX', CONVERT(NUMBER_TO_CHAR, :OLD.CodAux));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONGER', :OLD.ConGer);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERRAT', CONVERT(NUMBER_TO_CHAR, :OLD.PerRat));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFOR', CONVERT(NUMBER_TO_CHAR, :OLD.CodFor));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CLCPDB', CONVERT(NUMBER_TO_CHAR, :OLD.ClcPDb));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMDOC', :OLD.NumDoc);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMCON', :OLD.NomCon);
