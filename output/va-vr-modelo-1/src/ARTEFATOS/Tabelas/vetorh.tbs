/* INSERT (NEW) */
TRIGGER R016HIE_EI AFTER INSERT ON R016HIE FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs HierarquiaLocaisOrganograma*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 70;     /* HierarquiaLocaisOrganograma*/
  l_codtpa := 251;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R016HIE_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :NEW.TABORG));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', CONVERT(NUMBER_TO_CHAR, :NEW.NUMLOC));
        SP_DATSTR(:NEW.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R016HIE_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:NEW.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATFIM', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSLOC', :NEW.POSLOC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODLOC', :NEW.CODLOC);
      END;
  END IF; 
END␀RĞ␀␀	SENIOR;0L

TRIGGER R016HIE_SU AFTER UPDATE ON R016HIE

BEGIN
RH_250ALT(35);
END␀OĞ␀␀		SENIOR;0&	␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R016HIE_EU AFTER UPDATE ON R016HIE FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs HierarquiaLocaisOrganograma*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 70;     /* HierarquiaLocaisOrganograma*/
  l_codtpa := 252;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.TabOrg <> :NEW.TabOrg)
   OR (:OLD.NumLoc <> :NEW.NumLoc)
   OR (:OLD.DatIni <> :NEW.DatIni)
   OR (:OLD.DatFim <> :NEW.DatFim)
   OR (:OLD.PosLoc <> :NEW.PosLoc)
   OR (:OLD.CodLoc <> :NEW.CodLoc)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R016HIE_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :OLD.TABORG));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', CONVERT(NUMBER_TO_CHAR, :OLD.NUMLOC));
        SP_DATSTR(:OLD.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R016HIE_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:OLD.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATFIM', l_datTemp);
        SP_DATSTR(:NEW.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATFIM', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPOSLOC', :OLD.POSLOC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPOSLOC', :NEW.POSLOC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODLOC', :OLD.CODLOC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODLOC', :NEW.CODLOC);
      END;
    END IF; 
  END IF; 
END␀PĞ␀␀	SENIOR;0L

