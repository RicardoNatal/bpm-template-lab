      BEGIN        
        ROLLBACK TRAN
        CLOSE CUR_R900LCN
        GOTO BEGINADDLOG
      END
      GOTO FNCUR_R900LCN1
    END
    COMMIT TRAN
    FETCH NEXT FROM CUR_R900LCN INTO @VEVTPOS, @VMAXPOS
  END
  FNCUR_R900LCN1: /* FINALLY OPEN CURSOR */
  CLOSE CUR_R900LCN
  DEALLOCATE CUR_R900LCN
  IF @ChkError <> 0
    GOTO FIM
FIM:
  RETURN @ChkError
END

	POSTGRESQL;0
™^␀␀CREATE OR REPLACE PROCEDURE SP_ADDLOG(PEVTIDT NUMERIC, PEVTTIM NUMERIC, PEVTUSR NUMERIC, PEVTDA1 VARCHAR, PEVTDA2 VARCHAR, PEVTDA3 VARCHAR, PEVTDA4 VARCHAR, PEVTDA5 VARCHAR, PEVTDA6 VARCHAR, PEVTDA7 VARCHAR, PEVTDA8 VARCHAR, PEVTDA9 VARCHAR, PEVTDA10 VARCHAR, PEVTDA11 VARCHAR, PEVTDA12 VARCHAR, PEVTDA13 VARCHAR, PEVTDA14 VARCHAR, PEVTDA15 VARCHAR, PEVTDA16 VARCHAR, PEVTDA17 VARCHAR, PEVTDA18 VARCHAR, PEVTDA19 VARCHAR, PEVTDA20 VARCHAR, PEVTDA21 VARCHAR, PEVTDA22 VARCHAR, PEVTDA23 VARCHAR, PEVTDA24 VARCHAR, PEVTDA25 VARCHAR, PEVTDA26 VARCHAR, PEVTDA27 VARCHAR, PEVTDA28 VARCHAR, PEVTDA29 VARCHAR, PEVTDA30 VARCHAR, PEVTDA31 VARCHAR, PEVTDA32 VARCHAR)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
VEVTPOS BIGINT;
VMAXPOS BIGINT;
VEVTNBR BIGINT;
VEVTPOSCNT BIGINT;
VISCIRCULAR BOOLEAN;

CUR_R900LCN CURSOR FOR
  SELECT EVTPOS, MAXPOS FROM R900LCN FOR UPDATE;

BEGIN
  VISCIRCULAR := TRUE;
  OPEN CUR_R900LCN;
  BEGIN
    FETCH CUR_R900LCN INTO VEVTPOS, VMAXPOS;
    WHILE (FOUND) LOOP
      IF (VMAXPOS = -1727) THEN
        VISCIRCULAR := FALSE;
      END IF;
	  
      VEVTNBR := VEVTPOS;
      SELECT COUNT(*) INTO VEVTPOSCNT FROM R900LOG WHERE EVTPOS = VEVTPOS;    
      IF (VISCIRCULAR = TRUE) THEN	  
        IF (VEVTPOSCNT <> 1)  THEN
          RAISE EXCEPTION 'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log';
        END IF;
		
        UPDATE
          R900LOG
        SET
          EVTNBR = VEVTNBR,
          EVTIDT = PEVTIDT,
          EVTTIM = PEVTTIM,
          EVTUSR = PEVTUSR,
          EVTDA1 = PEVTDA1,
          EVTDA2 = PEVTDA2
        WHERE
          EVTPOS = VEVTPOS;
      ELSE    
        INSERT INTO
          R900LOG(EVTPOS, EVTNBR, EVTIDT, EVTTIM, EVTUSR, EVTDA1, EVTDA2)
        VALUES(VEVTPOS, VEVTNBR, PEVTIDT, PEVTTIM, PEVTUSR, PEVTDA1,PEVTDA2);
      END IF;
	  
      IF (VEVTPOS < VMAXPOS) OR (VISCIRCULAR = FALSE) THEN
        VEVTPOS := VEVTPOS + 1;
      ELSE
        VEVTPOS := 1;
      END IF;
	  
      IF (COALESCE(LENGTH(PEVTDA3),0) <> 0) THEN
        SELECT COUNT(*) INTO VEVTPOSCNT FROM R900LOG WHERE EVTPOS = VEVTPOS;
		
        IF (VISCIRCULAR = TRUE) THEN
          IF (VEVTPOSCNT <> 1) THEN
            RAISE EXCEPTION 'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log';
          END IF;
          UPDATE
            R900LOG
          SET
            EVTNBR = VEVTNBR,
            EVTIDT = PEVTIDT,
            EVTTIM = PEVTTIM,
            EVTUSR = PEVTUSR,
            EVTDA1 = PEVTDA3,
            EVTDA2 = PEVTDA4
          WHERE
            EVTPOS = VEVTPOS;
        ELSE    
          INSERT INTO
            R900LOG(EVTPOS, EVTNBR, EVTIDT, EVTTIM, EVTUSR, EVTDA1, EVTDA2)
          VALUES(VEVTPOS, VEVTNBR, PEVTIDT, PEVTTIM, PEVTUSR, PEVTDA3,PEVTDA4);
        END IF;
		
        IF (VEVTPOS < VMAXPOS) OR (VISCIRCULAR = FALSE) THEN
          VEVTPOS := VEVTPOS + 1;
        ELSE
          VEVTPOS := 1;
        END IF;
		
        IF (COALESCE(LENGTH(PEVTDA5),0) <> 0) THEN
          SELECT COUNT(*) INTO VEVTPOSCNT FROM R900LOG WHERE EVTPOS = VEVTPOS;  
		  
          IF (VISCIRCULAR = TRUE) THEN
            IF (VEVTPOSCNT <> 1) THEN
              RAISE EXCEPTION 'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log';
            END IF;
			
            UPDATE
              R900LOG
            SET
              EVTNBR = VEVTNBR,
              EVTIDT = PEVTIDT,
              EVTTIM = PEVTTIM,
              EVTUSR = PEVTUSR,
              EVTDA1 = PEVTDA5,
              EVTDA2 = PEVTDA6
            WHERE
              EVTPOS = VEVTPOS;
          ELSE
            INSERT INTO
              R900LOG(EVTPOS, EVTNBR, EVTIDT, EVTTIM, EVTUSR, EVTDA1, EVTDA2)
            VALUES
              (VEVTPOS, VEVTNBR, PEVTIDT, PEVTTIM, PEVTUSR, PEVTDA5,PEVTDA6);
          END IF;
		  
          IF (VEVTPOS < VMAXPOS) OR (VISCIRCULAR = FALSE) THEN
            VEVTPOS := VEVTPOS + 1;
          ELSE
            VEVTPOS := 1;
          END IF;
		  
          IF (COALESCE(LENGTH(PEVTDA7),0) <> 0) THEN
            SELECT COUNT(*) INTO VEVTPOSCNT FROM R900LOG WHERE EVTPOS = VEVTPOS;
			
            IF (VISCIRCULAR = TRUE) THEN
              IF (VEVTPOSCNT <> 1) THEN
                RAISE EXCEPTION 'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log';
              END IF;
			  
              UPDATE
                R900LOG
              SET
                EVTNBR = VEVTNBR,
                EVTIDT = PEVTIDT,
                EVTTIM = PEVTTIM,
                EVTUSR = PEVTUSR,
                EVTDA1 = PEVTDA7,
                EVTDA2 = PEVTDA8
              WHERE
                EVTPOS = VEVTPOS;
            ELSE    
              INSERT INTO
                R900LOG(EVTPOS, EVTNBR, EVTIDT, EVTTIM, EVTUSR, EVTDA1, EVTDA2)
              VALUES   
                (VEVTPOS, VEVTNBR, PEVTIDT, PEVTTIM, PEVTUSR, PEVTDA7,PEVTDA8);              
            END IF;
			
            IF (VEVTPOS < VMAXPOS) OR (VISCIRCULAR = FALSE) THEN
              VEVTPOS := VEVTPOS + 1;
            ELSE
              VEVTPOS := 1;
            END IF;
			
            IF (COALESCE(LENGTH(PEVTDA9),0) <> 0) THEN
              SELECT COUNT(*) INTO VEVTPOSCNT FROM R900LOG WHERE EVTPOS = VEVTPOS;
			  
              IF(VISCIRCULAR = TRUE)THEN  
                IF (VEVTPOSCNT <> 1) THEN
                  RAISE EXCEPTION 'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log';
                END IF;  
                UPDATE
                  R900LOG
                SET
                  EVTNBR = VEVTNBR,
                  EVTIDT = PEVTIDT,
                  EVTTIM = PEVTTIM,
                  EVTUSR = PEVTUSR,
                  EVTDA1 = PEVTDA9,
                  EVTDA2 = PEVTDA10
                WHERE
                  EVTPOS = VEVTPOS;
              ELSE
                INSERT INTO
                  R900LOG(EVTPOS, EVTNBR, EVTIDT, EVTTIM, EVTUSR, EVTDA1, EVTDA2)
                VALUES   
                  (VEVTPOS, VEVTNBR, PEVTIDT, PEVTTIM, PEVTUSR, PEVTDA9,PEVTDA10);                
              END IF;
			  
              IF (VEVTPOS < VMAXPOS) OR (VISCIRCULAR = FALSE) THEN
                VEVTPOS := VEVTPOS + 1;
              ELSE
                VEVTPOS := 1;
              END IF;
			  
              IF (COALESCE(LENGTH(PEVTDA11),0) <> 0) THEN
                SELECT COUNT(*) INTO VEVTPOSCNT FROM R900LOG WHERE EVTPOS = VEVTPOS;
				
                IF (VISCIRCULAR = TRUE) THEN
                  IF (VEVTPOSCNT <> 1)THEN
                    RAISE EXCEPTION 'A Tabela de Log (R900LOG) está corrompida ! Execute Consistir Log do Gerenciador de Log';
                  END IF;
				  
                  UPDATE
                    R900LOG
                  SET
                    EVTNBR = VEVTNBR,
                    EVTIDT = PEVTIDT,
                    EVTTIM = PEVTTIM,
                    EVTUSR = PEVTUSR,
                    EVTDA1 = PEVTDA11,
                    EVTDA2 = PEVTDA12
                  WHERE
                    EVTPOS = VEVTPOS;
                ELSE    
                  INSERT INTO
                    R900LOG(EVTPOS, EVTNBR, EVTIDT, EVTTIM, EVTUSR, EVTDA1, EVTDA2)
                  VALUES   
                    (VEVTPOS, VEVTNBR, PEVTIDT, PEVTTIM, PEVTUSR, PEVTDA11,PEVTDA12);
                END IF;    
              
                IF (VEVTPOS < VMAXPOS) OR (VISCIRCULAR = FALSE) THEN
