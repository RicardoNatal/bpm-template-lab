Ò␀␀PROCEDURE SM_GHE_ATIVO(p_gheAtivo OUT BOOLEAN)
IS

	l_RotGhe   R000SEG.RotGHE%TYPE;
BEGIN
    BEGIN
    	SELECT RotGHE INTO l_RotGhe FROM R000SEG;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            l_RotGhe := 0;
        WHEN OTHERS THEN
            RAISERROR 103 'Erro ao obter a rotina do GHE';
    END;   
    
    IF (l_RotGhe = 1) OR (l_RotGhe = 4) THEN
    	p_gheAtivo := TRUE;   
    ELSE 
      p_gheAtivo := FALSE;
    END IF; 
END␀Ñ÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
<␀␀PROCEDURE SM_LAYOUT_SST(P_LAYOUT VARCHAR(6), P_RETORNO OUT BOOLEAN)
IS

  l_Layout VARCHAR(6);
BEGIN
  P_RETORNO := FALSE;
  l_Layout := UPPER(P_LAYOUT);
  
  IF (l_Layout = 'S-2210') OR
     (l_Layout = 'S-2220') OR
     (l_Layout = 'S-2221') OR
     (l_Layout = 'S-2240') THEN
    P_RETORNO := TRUE;
  END IF; 
END␀Ò÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
š␀␀PROCEDURE SM_LIGACAOGHE(p_NumEmp NUMBER(4), p_LigacaoGHE OUT NUMBER(1))
IS

	l_ColGhe   R000SEG.ColGHE%TYPE;
BEGIN
    /* 1 - Colaborador, 2 - Posto de Trabalho */
    BEGIN
    	SELECT IFNULL(COLGHE,0) INTO l_ColGhe FROM R086DEF WHERE NUMEMP = p_NumEmp;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            l_ColGhe := 0;
        WHEN OTHERS THEN
            RAISERROR 103 'Erro ao obter a ligação do colaborador ao GHE.';
    END;   
    
    IF (l_ColGhe = 0) THEN
    	BEGIN           
            SELECT COLGHE INTO l_ColGhe FROM R000SEG;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_ColGhe := 0;
            WHEN TOO_MANY_ROWS THEN
                RAISERROR 103 'Foi encontrado mais de um registro na tabela R000SEG.';
            WHEN OTHERS THEN
                RAISERROR 103 'Erro ao obter a ligação do colaborador ao GHE.';
    	END;
    END IF;
    p_LigacaoGHE := l_ColGhe; 
END␀Ó÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0[RH_RET_DATINISST
SP_CONCATENAR_DAT
SP_CONCATENAR_NUM
