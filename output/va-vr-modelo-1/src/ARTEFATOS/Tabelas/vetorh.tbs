DECLARE
l_DthCan     NUMBER(14,6);
l_temAud     BOOLEAN;
l_codRPA     NUMBER(15);
l_codSistema NUMBER(2);
l_codcpa     NUMBER(4);
l_codtpa     NUMBER(4);
l_datTemp    VARCHAR(10);
BEGIN
  BEGIN
    SP_DATETIME(l_DthCan OUT);
    UPDATE R122CCO
       SET DTHCAN = l_DthCan
     WHERE NumEmp = :NEW.NumEmp
       AND TipCol = :NEW.TipCol
       AND NumCad = :NEW.NumCad;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar curriculo compilado do candidato (R122CCO).';
  END;
  
  /* Geração de logs Colaborador - Endereços Eletrônicos (Tabela: R034EEL)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 112;     /* Colaborador - Endereços Eletrônicos (Tabela: R034EEL)*/
  l_codtpa := 335;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034EEL_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEEL', CONVERT(NUMBER_TO_CHAR, :NEW.CODEEL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQEEL', CONVERT(NUMBER_TO_CHAR, :NEW.SEQEEL));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034EEL_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDELE', :NEW.ENDELE);
      END;
  END IF; 
END␀QÓ␀␀		SENIOR;0[	␀␀

TRIGGER R034EEL_EU AFTER UPDATE ON R034EEL FOR EACH ROW

DECLARE
l_temAud       BOOLEAN;
l_codRPA       NUMBER(15);
l_codSistema   NUMBER(2);
l_codcpa       NUMBER(4);
l_codtpa       NUMBER(4);
l_datTemp      VARCHAR(10);
l_DthCan     NUMBER(14,6);BEGIN
BEGIN
    SP_DATETIME(l_DthCan OUT);
    UPDATE R122CCO
       SET DTHCAN = l_DthCan
     WHERE NumEmp = :NEW.NumEmp
       AND TipCol = :NEW.TipCol
       AND NumCad = :NEW.NumCad;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar curriculo compilado do candidato (R122CCO).';
  END;
  
  /* Geração de logs Colaborador - Endereços Eletrônicos (Tabela: R034EEL)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 112;     /* Colaborador - Endereços Eletrônicos (Tabela: R034EEL)*/
  l_codtpa := 336;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.CodEEl <> :NEW.CodEEl)
   OR (:OLD.SeqEEl <> :NEW.SeqEEl)
   OR (:OLD.EndEle <> :NEW.EndEle)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034EEL_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEEL', CONVERT(NUMBER_TO_CHAR, :OLD.CODEEL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQEEL', CONVERT(NUMBER_TO_CHAR, :OLD.SEQEEL));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034EEL_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENDELE', :OLD.ENDELE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENDELE', :NEW.ENDELE);
      END;
    END IF; 
  END IF;
END␀OÓ␀␀		SENIOR;0k␀␀

TRIGGER R034EEL_ED AFTER DELETE ON R034EEL FOR EACH ROW

DECLARE
l_temAud       BOOLEAN;
l_codRPA       NUMBER(15);
l_codSistema   NUMBER(2);
l_codcpa       NUMBER(4);
l_codtpa       NUMBER(4);
l_datTemp      VARCHAR(10);
l_DthCan     NUMBER(14,6);
BEGIN
  BEGIN
    SP_DATETIME(l_DthCan OUT);
    UPDATE R122CCO
       SET DTHCAN = l_DthCan
     WHERE NumEmp = :OLD.NumEmp
       AND TipCol = :OLD.TipCol
       AND NumCad = :OLD.NumCad;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar curriculo compilado do candidato (R122CCO).';
  END;
  
  /* Geração de logs Colaborador - Endereços Eletrônicos (Tabela: R034EEL)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 112;     /* Colaborador - Endereços Eletrônicos (Tabela: R034EEL)*/
  l_codtpa := 335;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034EEL_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEEL', CONVERT(NUMBER_TO_CHAR, :OLD.CODEEL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQEEL', CONVERT(NUMBER_TO_CHAR, :OLD.SEQEEL));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034EEL_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDELE', :OLD.ENDELE);
      END;
  END IF; 
END␀␀␀D.␀␀␀␀␀␀␀RÓ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀$0.0.w␀Æÿ␀␀…Ó␀␀␀mDÑ␀	␀␀␀␀␀␀␀ŠJ‡J‡JqC␀êÿ␀␀ÿ␀Œ-±␀	␀␀␀␀␀␀␀zş␀␀xş␀␀xş␀␀q␀Æÿ␀␀ÿ␀ª[=␀␀␀␀␀␀␀c[c[c[c␀␀␀ÿ␀␀ÿ␀-´␀␀␀␀␀␀␀␀MA]␀␀]␀␀r␀Æÿ␀␀ŸÎ␀␀␀«-­␀␀␀␀␀␀␀␀
␀␀␀p␀Æÿ␀␀¬Î␀␀␀„␀­␀␀␀␀␀␀␀␀Ë␀Ë␀Ë␀p␀Æÿ␀␀‰Î␀␀␀Uû␀␀­␀␀␀␀␀␀␀␀Xû␀␀Xû␀␀Xû␀␀p␀Æÿ␀␀ÿ␀␀␀␀	0;1;2;3;4SÓ␀␀		SENIOR;0G␀␀TRIGGER R034ESR_EI AFTER INSERT ON R034ESR FOR EACH ROW
DECLARE
  l_Valor        VARCHAR2(2000);  
  l_EncontrouMatricula BOOLEAN;
  l_EncontrouMatriculaSST BOOLEAN;
  l_DataFechamentoTreinamento DATE;
BEGIN 

  /*e-Social*/  
  l_DataFechamentoTreinamento := DATETIME(31, 12, 1900, 0, 0, 0);

  l_EncontrouMatricula := TRUE;
  RH_NUMMAT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_EncontrouMatricula OUT, l_EncontrouMatriculaSST OUT, l_DataFechamentoTreinamento OUT);

  IF (l_EncontrouMatricula = TRUE) THEN
    l_Valor := '';
    SP_CONCATENAR_NUM('TIPCOL', :NEW.TIPCOL, l_Valor OUT);
    SP_CONCATENAR_NUM('NUMCAD', :NEW.NUMCAD, l_Valor OUT);
    SP_CONCATENAR_DAT('DATALT', :NEW.DATALT, l_Valor OUT);

    SP_ESOCIAL_1050(:NEW.NUMEMP, 'R034ESR', 'I', l_Valor, '', 0, 'R034ESR_EI');
  END IF;
  
  /*e-Social*/
END␀TÓ␀␀		SENIOR;0t␀␀

TRIGGER R034ESR_EU AFTER UPDATE ON R034ESR FOR EACH ROW
DECLARE
  l_Alterou BOOLEAN;  
  l_Valor        VARCHAR2(2000);
  l_Valor2       VARCHAR2(2000);
  l_Valido       BOOLEAN;
  l_EncontrouMatricula BOOLEAN;
  l_EncontrouMatriculaSST BOOLEAN;
  l_DataFechamentoTreinamento DATE;
BEGIN 
  
  /*e-Social*/ 
  l_DataFechamentoTreinamento := DATETIME(31, 12, 1900, 0, 0, 0);
  
  l_Valido := FALSE;
  l_Alterou := FALSE;  
  
  SP_VALUPDATE_DES(:OLD.DIAFOL, :NEW.DIAFOL, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.CODSRV, :NEW.CODSRV, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.CODTSE, :NEW.CODTSE, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;

  IF (l_Alterou = TRUE) THEN
    l_EncontrouMatricula := TRUE;
    RH_NUMMAT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_EncontrouMatricula OUT, l_EncontrouMatriculaSST OUT, l_DataFechamentoTreinamento OUT);

    IF (l_EncontrouMatricula = TRUE) THEN
      l_Valor := '';
      SP_CONCATENAR_NUM('TIPCOL', :NEW.TIPCOL, l_Valor OUT);
      SP_CONCATENAR_NUM('NUMCAD', :NEW.NUMCAD, l_Valor OUT);
      SP_CONCATENAR_DAT('DATALT', :NEW.DATALT, l_Valor OUT);
      
      l_Valor2 := '';
      SP_CONCATENAR_NUM('TIPCOL', :OLD.TIPCOL, l_Valor2 OUT);
      SP_CONCATENAR_NUM('NUMCAD', :OLD.NUMCAD, l_Valor2 OUT);
      SP_CONCATENAR_DAT('DATALT', :OLD.DATALT, l_Valor2 OUT);

      SP_ESOCIAL_1050(:NEW.NUMEMP, 'R034ESR', 'A', l_Valor, l_Valor2, 0 , 'R034ESR_EU');
    END IF;  
  END IF;
 
  /*e-Social*/
END␀␀␀¤e␀␀␀␀␀␀␀␀␀␀UÓ␀␀…¬␀␀´␀	Ôÿ?ü␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ?ü␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ?ü␀␀␀␀œ$€$€$w␀Æÿ␀␀…Ó␀␀␀–DÑ␀Ôÿ?ü␀␀␀␀ÌK§JFFqC␀êÿ␀␀ÿ␀'␀•	Ôÿ1␀␀␀␀␀è*k2k2p␀Æÿ␀␀ÿ␀€ï␀␀Ôÿ1␀␀␀␀␀%(Oï␀␀Oï␀␀ ␀␀ÿ␀␀2ì␀␀␀Ya(Ôÿ1␀␀␀␀␀®+␀ +␀+␀1␀␀ÿ␀␀ÿ␀ÍDÑ␀Ôÿ1␀␀␀␀␀ôK¬F±FqC␀êÿ␀␀ÿ
31/12/1900Ø_Ñ␀Ôÿ1␀␀␀␀␀¡Ku␀‹␀qC␀êÿ␀␀ÿ␀×_Ñ␀Ôÿ1␀␀␀␀␀£Ki␀úHqC␀êÿ␀␀ÿ␀4(=Ôÿ1␀␀␀␀␀<(;(<(c␀␀␀ÿ␀␀ÿNØm=Ôÿ1␀␀␀␀␀şmşmşmc␀␀␀ÿ␀␀ÿNÂ¬␀␀Ôÿ!␀␀␀␀␀4°␀␀-¯␀␀Ç¯␀␀%␀␀ÿ␀␀ÿ␀oEÑ␀Ôÿ!␀␀␀␀␀WK#H#HqC␀êÿ␀␀ÿ␀ó␀!Ôÿ1␀␀␀␀␀„
␀C
␀q
␀n␀␀Æÿ␀␀ÿ␀µEÑ␀Ôÿ1␀␀␀␀␀«LÉH‘KqC␀␀êÿ␀␀ÿ␀␀␀␀0;1;2WÓ␀␀		SENIOR;0,␀␀TRIGGER R034EST_AI AFTER INSERT ON R034EST FOR EACH ROW

DECLARE
  l_DataAlteracao  DATE;
  l_layout         VARCHAR2(6);
  l_temAud         BOOLEAN;
  l_codRPA         NUMBER(15);
  l_codSistema     NUMBER(2);
  l_codcpa         NUMBER(4);
  l_codtpa         NUMBER(4);
  l_datTemp        VARCHAR(10);
  l_idtpes         VARCHAR2(23);
  l_gerarPendencia BOOLEAN;
BEGIN
  UPDATE R034FUN SET DATCHE = :NEW.DATCHE, VISEST = :NEW.VISEST, 
    REGEST = :NEW.REGEST, DVLEST = :NEW.DVLEST, DVLCTP = :NEW.DVLCTP
  WHERE NUMEMP = :NEW.NUMEMP
    AND TIPCOL = :NEW.TIPCOL
    AND NUMCAD = :NEW.NUMCAD;
    
  UPDATE R034CPL SET DATPOR = :NEW.DATPOR, NUMPOR = :NEW.NUMPOR
  WHERE NUMEMP = :NEW.NUMEMP
    AND TIPCOL = :NEW.TIPCOL
    AND NUMCAD = :NEW.NUMCAD; 

  /*e-Social*/	
  l_gerarPendencia := TRUE;
  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
  IF (l_layout IS NOT NULL) THEN
    N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    IF (l_gerarPendencia = TRUE) THEN
      l_DataAlteracao := CURDATE();
      SP_E_SOCIAL('S-2205', 'R034EST', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, '', '', 0, NULL, l_DataAlteracao, 0, 'R034EST_AI');
    END IF;
  END IF;	
  /*e-Social*/

  /* Pendência SAMSenior */
  IF (:NEW.REGEST IS NOT NULL AND LENGTH(LTRIM(RTRIM(:NEW.REGEST))) > 0) THEN
  	SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
  	SP_SAM_PENDENCIES(1, 2, l_idtpes);
  END IF;

  /* Geração de logs Informações do Estrangeiro (Tabela: R034EST)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 87;     /* Informações do Estrangeiro (Tabela: R034EST)*/
  l_codtpa := 285;
 
   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034EST_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034EST_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
      	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        SP_DATSTR(:NEW.DATCHE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATCHE', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VISEST', CONVERT(NUMBER_TO_CHAR, :NEW.VISEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REGEST', :NEW.REGEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EMIEST', :NEW.EMIEST);
        SP_DATSTR(:NEW.DATEST, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATEST', l_datTemp);
        SP_DATSTR(:NEW.DVLEST, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DVLEST', l_datTemp);
        SP_DATSTR(:NEW.DVLCTP, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DVLCTP', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CASBRA', :NEW.CASBRA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FILCBR', :NEW.FILCBR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMPOR', :NEW.NUMPOR);
        SP_DATSTR(:NEW.DATPOR, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPOR', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TMPRES', CONVERT(NUMBER_TO_CHAR, :NEW.TMPRES));
        SP_DATSTR(:NEW.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATTER', l_datTemp);
      END;
  END IF;   
END␀XÓ␀␀		SENIOR;0E%␀␀

TRIGGER R034EST_AU AFTER UPDATE ON R034EST FOR EACH ROW
DECLARE
  l_Alterou              BOOLEAN;
  l_Valido               BOOLEAN;
  l_DataAlteracao        DATE;
  l_layout               VARCHAR2(6);
  l_JsonCamposAlterados  VARCHAR2(2000);
  l_temAud               BOOLEAN;
  l_codRPA               NUMBER(15);
  l_codSistema           NUMBER(2);
  l_codcpa               NUMBER(4);
  l_codtpa               NUMBER(4);
  l_datTemp              VARCHAR(10);
  l_idtpes               VARCHAR2(23);
  l_InfoFacult           BOOLEAN;
  l_SimplificacaoESocial BOOLEAN;
  l_gerarPendencia       BOOLEAN;
  l_VersaoESocial        NUMBER;
BEGIN
  UPDATE R034FUN SET DATCHE = :NEW.DATCHE, VISEST = :NEW.VISEST, 
    REGEST = :NEW.REGEST, DVLEST = :NEW.DVLEST, DVLCTP = :NEW.DVLCTP
  WHERE NUMEMP = :NEW.NUMEMP
    AND TIPCOL = :NEW.TIPCOL
    AND NUMCAD = :NEW.NUMCAD;
    
  UPDATE R034CPL SET DATPOR = :NEW.DATPOR, NUMPOR = :NEW.NUMPOR
  WHERE NUMEMP = :NEW.NUMEMP
    AND TIPCOL = :NEW.TIPCOL
    AND NUMCAD = :NEW.NUMCAD;  
  
  /*e-Social*/
  l_gerarPendencia := TRUE;
  l_Alterou  := FALSE;
  l_InfoFacult := TRUE;  
  l_SimplificacaoESocial := FALSE;
  l_VersaoESocial := 0;
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificacaoESocial OUT, l_VersaoESocial OUT);
  l_JsonCamposAlterados := '';
  
  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
  IF (l_layout IS NOT NULL) THEN
    N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    IF (l_gerarPendencia = TRUE) THEN
        
      IF (l_SimplificacaoESocial = FALSE) THEN
        SP_VALUPDATE_DES(:OLD.CASBRA, :NEW.CASBRA, l_Valido OUT);
      	IF (l_Valido = TRUE) THEN
  	      l_Alterou := TRUE;
  	      SP_CONCAT_DES_JSON('CASBRA', :NEW.CasBra, :OLD.CasBra, l_JsonCamposAlterados OUT);
        END IF;
        
        SP_VALUPDATE_DES(:OLD.FILCBR, :NEW.FILCBR, l_Valido OUT);
  	    IF (l_Valido = TRUE) THEN
  	      l_Alterou := TRUE;
  	      SP_CONCAT_DES_JSON('FILCBR', :NEW.FilCbr, :OLD.FilCbr, l_JsonCamposAlterados OUT);
  	    END IF;    
        
  	    SP_VALUPDATE_DAT(:OLD.DATCHE, :NEW.DATCHE, l_Valido OUT);
  	    IF (l_Valido = TRUE) THEN
  	      l_Alterou := TRUE;
  	      SP_CONCAT_DAT_JSON('DATCHE', :NEW.DatChe, :OLD.DatChe, l_JsonCamposAlterados OUT);
  	    END IF;
      END IF;  
      
      IF (l_InfoFacult = TRUE AND l_SimplificacaoESocial = FALSE) THEN
        SP_VALUPDATE_DAT(:OLD.DATEST, :NEW.DATEST, l_Valido OUT);
        IF (l_Valido = TRUE) THEN
  	      l_Alterou := TRUE;
  	      SP_CONCAT_DAT_JSON('DATEST', :NEW.DatEst, :OLD.DatEst, l_JsonCamposAlterados OUT);
        END IF;    
      
        SP_VALUPDATE_DES(:OLD.EMIEST, :NEW.EMIEST, l_Valido OUT);
        IF (l_Valido = TRUE) THEN
  	      l_Alterou := TRUE;
  	      SP_CONCAT_DES_JSON('EMIEST', :NEW.EmiEst, :OLD.EmiEst, l_JsonCamposAlterados OUT);
        END IF;
        
        SP_VALUPDATE_DES(:OLD.REGEST, :NEW.REGEST, l_Valido OUT);
        IF (l_Valido = TRUE) THEN
  	      l_Alterou := TRUE;
  	      SP_CONCAT_DES_JSON('REGEST', :NEW.RegEst, :OLD.RegEst, l_JsonCamposAlterados OUT);
        END IF;
      END IF;
      
      SP_VALUPDATE_NUM(:OLD.VISEST, :NEW.VISEST, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
  	    l_Alterou := TRUE;
  	    SP_CONCAT_NUM_JSON('VISEST', :NEW.VisEst, :OLD.VisEst, l_JsonCamposAlterados OUT);
      END IF;
      
      IF (l_SimplificacaoESocial = TRUE) THEN
        SP_VALUPDATE_NUM(:OLD.TMPRES, :NEW.TMPRES, l_Valido OUT);
        IF (l_Valido = TRUE) THEN
  	      l_Alterou := TRUE;
  	      SP_CONCAT_NUM_JSON('TMPRES', :NEW.TmpRes, :OLD.TmpRes, l_JsonCamposAlterados OUT);
        END IF;
      END IF;
      
      IF (l_Alterou = TRUE) THEN 
        l_DataAlteracao := CURDATE();
        SP_E_SOCIAL('S-2205', 'R034EST', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, '', l_JsonCamposAlterados, 0, NULL, l_DataAlteracao, 0, 'R034EST_AU');
      END IF;
    END IF;
  END IF;    
  /*e-Social*/

  /* Pendência SAMSenior */
  IF ((:OLD.REGEST <> :NEW.REGEST) OR (:OLD.REGEST IS NULL AND :NEW.REGEST IS NOT NULL) OR (:NEW.REGEST IS NULL AND :OLD.REGEST IS NOT NULL)) THEN
        SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
        SP_SAM_PENDENCIES(1, 2, l_idtpes);
  END IF;

  /* Geração de logs Informações do Estrangeiro (Tabela: R034EST)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 87;     /* Informações do Estrangeiro (Tabela: R034EST)*/
  l_codtpa := 286;
 
  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatChe <> :NEW.DatChe)
   OR (:OLD.VisEst <> :NEW.VisEst)
   OR (:OLD.RegEst <> :NEW.RegEst)
   OR (:OLD.EmiEst <> :NEW.EmiEst)
   OR (:OLD.DatEst <> :NEW.DatEst)
   OR (:OLD.DvlEst <> :NEW.DvlEst)
   OR (:OLD.DvlCtp <> :NEW.DvlCtp)
   OR (:OLD.CasBra <> :NEW.CasBra)
   OR (:OLD.FilCbr <> :NEW.FilCbr)
   OR (:OLD.NumPor <> :NEW.NumPor)
   OR (:OLD.DatPor <> :NEW.DatPor)
   OR (:OLD.TmpRes <> :NEW.TmpRes)
   OR (:OLD.DatTer <> :NEW.DatTer)) THEN

   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034EST_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034EST_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:OLD.DATCHE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATCHE', l_datTemp);
        SP_DATSTR(:NEW.DATCHE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATCHE', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVISEST', CONVERT(NUMBER_TO_CHAR, :OLD.VISEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWVISEST', CONVERT(NUMBER_TO_CHAR, :NEW.VISEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDREGEST', :OLD.REGEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWREGEST', :NEW.REGEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDEMIEST', :OLD.EMIEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWEMIEST', :NEW.EMIEST);
        SP_DATSTR(:OLD.DATEST, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATEST', l_datTemp);
        SP_DATSTR(:NEW.DATEST, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATEST', l_datTemp);
        SP_DATSTR(:OLD.DVLEST, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDVLEST', l_datTemp);
        SP_DATSTR(:NEW.DVLEST, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDVLEST', l_datTemp);
        SP_DATSTR(:OLD.DVLCTP, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDVLCTP', l_datTemp);
        SP_DATSTR(:NEW.DVLCTP, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDVLCTP', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCASBRA', :OLD.CASBRA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCASBRA', :NEW.CASBRA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFILCBR', :OLD.FILCBR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFILCBR', :NEW.FILCBR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMPOR', :OLD.NUMPOR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMPOR', :NEW.NUMPOR);
        SP_DATSTR(:OLD.DATPOR, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATPOR', l_datTemp);
        SP_DATSTR(:NEW.DATPOR, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATPOR', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTMPRES', CONVERT(NUMBER_TO_CHAR, :OLD.TMPRES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTMPRES', CONVERT(NUMBER_TO_CHAR, :NEW.TMPRES));        
        SP_DATSTR(:OLD.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATTER', l_datTemp);
        SP_DATSTR(:NEW.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATTER', l_datTemp);
      END;
    END IF; 
  END IF;   
END␀VÓ␀␀		SENIOR;0M␀␀

TRIGGER R034EST_AD AFTER DELETE ON R034EST FOR EACH ROW
DECLARE
  l_layout         VARCHAR2(6); 
  l_temAud         BOOLEAN;
  l_codRPA         NUMBER(15);
  l_codSistema     NUMBER(2);
  l_codcpa         NUMBER(4);
  l_codtpa         NUMBER(4);
  l_datTemp        VARCHAR(10);
  l_idtpes         VARCHAR2(23); 
  l_DataAlteracao  DATE;
  l_gerarPendencia BOOLEAN;
BEGIN
  /*e-Social*/	
  l_gerarPendencia := TRUE;
  RH_LAYOUTCOLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layout OUT);
  IF (l_layout IS NOT NULL) THEN
    N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    IF (l_gerarPendencia = TRUE) THEN
    	l_DataAlteracao := CURDATE();
    	SP_E_SOCIAL(l_layout, 'R034EST', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, '', '', 0, NULL, l_DataAlteracao, 0, 'R034EST_AD');
    END IF;
  END IF;
  /*e-Social*/	

  /* Pendência SAMSenior */
  SP_RETIDTPES(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT); 
  SP_SAM_PENDENCIES(1, 2, l_idtpes);  

  /* Geração de logs Informações do Estrangeiro (Tabela: R034EST)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 87;     /* Informações do Estrangeiro (Tabela: R034EST)*/
  l_codtpa := 285;
 
   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034EST_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034EST_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        SP_DATSTR(:OLD.DATCHE, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATCHE', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VISEST', CONVERT(NUMBER_TO_CHAR, :OLD.VISEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REGEST', :OLD.REGEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EMIEST', :OLD.EMIEST);
        SP_DATSTR(:OLD.DATEST, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATEST', l_datTemp);
        SP_DATSTR(:OLD.DVLEST, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DVLEST', l_datTemp);
        SP_DATSTR(:OLD.DVLCTP, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DVLCTP', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CASBRA', :OLD.CASBRA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FILCBR', :OLD.FILCBR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMPOR', :OLD.NUMPOR);
        SP_DATSTR(:OLD.DATPOR, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPOR', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TMPRES', CONVERT(NUMBER_TO_CHAR, :OLD.TMPRES));
        SP_DATSTR(:OLD.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATTER', l_datTemp);
      END;
  END IF;   
END␀␀␀’␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀YÓ␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ?␀␀␀␀␀Ü␀t␀Ü␀nˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ?␀␀␀␀␀.%0.0.wı‡␀Æÿ␀␀…Ó␀␀␀…EÑ␀	Ôÿ?␀␀␀␀␀mKmKmKqC␀êÿ␀␀ÿ␀<¦␀␀vÔÿ?␀␀␀␀␀j¦␀␀I¦␀␀I¦␀␀c␀␀␀ÿ␀␀ÿ␀É¦␀␀}Ôÿ?␀␀␀␀␀¯␀␀±®␀␀±®␀␀n␀Æÿ␀␀ÿ␀¹Ôÿ?␀␀␀␀␀>+␀=+␀=+␀␀␀ÿ␀␀ÿ␀ğEÔÿ?␀␀␀␀␀yyyG␀␀ÿ␀␀ÿ␀␀›␀Ôÿ?␀␀␀␀␀|"␀|"␀|"␀j)␀␀Æÿ␀␀ÿ␀1Å␀␀Ñ␀Ôÿ?␀␀␀␀␀`N¦Å␀␀¦Å␀␀qC␀êÿ␀␀ÿ␀€‘␀␀Ç␀Ôÿ?␀␀␀␀␀i’␀␀f’␀␀i’␀␀z␀␀Æÿ␀␀ÖÒ␀␀␀xÇ␀Ôÿ?␀␀␀␀␀ºººz␀␀Æÿ␀␀ÖÒ␀␀␀×a´␀Ôÿ?␀␀␀␀␀c·acr␀␀Æÿ␀␀Ò␀␀␀1␀tÔÿ?␀␀␀␀␀Y␀t␀Y␀n¼‡␀Æÿ␀␀ˆÓ␀␀␀r¬␀␀Ì␀Ôÿ?␀␀␀␀␀s%¨␀¨␀w¼‡␀␀Æÿ␀␀…Ó␀␀␀a§␀␀vÔÿ?␀␀␀␀␀Ö©␀␀ç§␀␀ç§␀␀n␀␀␀ÿ␀␀ÿ␀ş7␀Ôÿ?␀␀␀␀␀±␀␀‰#‰#Q␀␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3[Ó␀␀		SENIOR;0ğ␀␀TRIGGER R034ETG_AI AFTER INSERT ON R034ETG FOR EACH ROW

DECLARE
  l_layoutAlteracaoContrato  VARCHAR2(6);
BEGIN
  RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAlteracaoContrato OUT);    
  IF ((l_layoutAlteracaoContrato IS NOT NULL) AND LENGTH(LTRIM(RTRIM(l_layoutAlteracaoContrato))) > 0)  THEN
     SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATREF, 'R034ETG', 'DATREF', 'I', '', '', 0, 'R034ETG_AI');    
  END IF;
END␀\Ó␀␀		SENIOR;0␀␀

TRIGGER R034ETG_AU AFTER UPDATE ON R034ETG FOR EACH ROW
DECLARE
  l_layoutAlteracaoContrato  VARCHAR2(6);
  l_layoutInicial VARCHAR2(6);
  l_Alterou BOOLEAN;
  l_Valido BOOLEAN;
  l_JsonCamposAlterados VARCHAR2(2000);
  l_InfoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  l_Alterou := FALSE;
  l_JsonCamposAlterados := '';
  l_layoutInicial := '';
  l_VersaoESocial := 0;
  
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
 
  SP_VALUPDATE_DES(:OLD.NATETG, :NEW.NATETG, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_DES_JSON('NATETG', :NEW.NatEtg, :OLD.NatEtg, l_JsonCamposAlterados OUT);
  END IF;

  SP_VALUPDATE_NUM(:OLD.NIVETG, :NEW.NIVETG, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_NUM_JSON('NIVETG', :NEW.NivEtg, :OLD.NivEtg, l_JsonCamposAlterados OUT);
  END IF;

  SP_VALUPDATE_DES(:OLD.AREATU, :NEW.AREATU, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_DES_JSON('AREATU', :NEW.AreAtu, :OLD.AreAtu, l_JsonCamposAlterados OUT);
  END IF;

  SP_VALUPDATE_DES(:OLD.APOSEG, :NEW.APOSEG, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_DES_JSON('APOSEG', :NEW.ApoSeg, :OLD.ApoSeg, l_JsonCamposAlterados OUT);
  END IF;
  
  SP_VALUPDATE_DAT(:OLD.PRETER, :NEW.PRETER, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_DAT_JSON('PRETER', :NEW.PreTer, :OLD.PreTer, l_JsonCamposAlterados OUT);
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.INSENS, :NEW.INSENS, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_NUM_JSON('INSENS', :NEW.InsEns, :OLD.InsEns, l_JsonCamposAlterados OUT);
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.AGEINT, :NEW.AGEINT, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_NUM_JSON('AGEINT', :NEW.AgeInt, :OLD.AgeInt, l_JsonCamposAlterados OUT);
  END IF;
    
  SP_VALUPDATE_NUM(:OLD.CPFCOO, :NEW.CPFCOO, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_FLO_JSON('CPFCOO', :NEW.CpfCoo, :OLD.CpfCoo, 0, l_JsonCamposAlterados OUT);
  END IF;
  
  IF (l_SimplificaoESocial = FALSE) THEN
    SP_VALUPDATE_NUM(:OLD.VALBOL, :NEW.VALBOL, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_FLO_JSON('VALBOL', :NEW.ValBol, :OLD.ValBol, 4, l_JsonCamposAlterados OUT);
    END IF;
    
    SP_VALUPDATE_DES(:OLD.NOMCOO, :NEW.NOMCOO, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_DES_JSON('NOMCOO', :NEW.NomCoo, :OLD.NomCoo, l_JsonCamposAlterados OUT);
    END IF;
  END IF;  
   
  IF (l_Alterou = TRUE) THEN 
    RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutInicial OUT);    
    IF (l_layoutInicial IS NOT NULL) THEN
      RH_LAYOUT_ENVIADO(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutInicial, l_layoutAlteracaoContrato OUT);
      IF (l_layoutAlteracaoContrato IS NOT NULL) THEN  /*Se não voltou com informação então é porque não tem 2300 ou 2200 enviado*/
        SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATREF, 'R034ETG', 'DATREF', 'I', '', l_JsonCamposAlterados, 0, 'R034ETG_AU');      	
      ELSE
        SP_HIST_ESOCIAL(l_layoutInicial, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATREF, 'R034ETG', 'DATREF', 'I', '', l_JsonCamposAlterados, 0, 'R034ETG_AU');
      END IF;	           
    END IF;  
  END IF;
END␀ZÓ␀␀		SENIOR;0í␀␀

TRIGGER R034ETG_AD AFTER DELETE ON R034ETG FOR EACH ROW
DECLARE
  l_layoutAlteracaoContrato  VARCHAR2(6);
BEGIN
  RH_LAY_CONTR_COLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layoutAlteracaoContrato OUT);    
  IF ((l_layoutAlteracaoContrato IS NOT NULL) AND LENGTH(LTRIM(RTRIM(l_layoutAlteracaoContrato))) > 0)  THEN
    SP_HIST_ESOCIAL(l_layoutAlteracaoContrato, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATREF, 'R034ETG', 'DATREF', 'I', '', '', 0, 'R034ETG_AD');
  END IF;
END␀␀␀‹␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀]Ó␀␀…¬␀␀´␀	Ôÿ1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ1␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀9Ó␀␀␀c¬␀␀Ì␀	Ôÿ1␀␀␀␀␀œ$€$€$w␀Æÿ␀␀…Ó␀␀␀␀	Ôÿ1␀␀␀␀␀␀␀␀p␀Æÿ␀␀ÿ␀CEÑ␀Ôÿ1␀␀␀␀␀$H$H$HqC␀êÿ␀␀ÿ␀pEÑ␀Ôÿ1␀␀␀␀␀EHEHEHqC␀êÿ␀␀ÿ␀D-Ì␀Ôÿ1␀␀␀␀␀æ±␀␀~Æ␀␀~Æ␀␀l␀␀Æÿ␀␀1#␀␀␀␀0;1;2_Ó␀␀		SENIOR;0·
␀␀TRIGGER R034ETT_EI AFTER INSERT ON R034ETT FOR EACH ROW

DECLARE
  l_DataAlteracao DATE;
  l_layout VARCHAR2(6); /* layout do colaborador no esocial */
  l_AltAdm VARCHAR2(2000); /* campos alterados que influenciam no layout de admissao */
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_gerarPendencia BOOLEAN;  
BEGIN
  l_gerarPendencia := TRUE;
  l_AltAdm := '';
  l_DataAlteracao := CURDATE();
  SP_CONCATENAR_DAT('DATALT', l_DataAlteracao, l_AltAdm OUT);
  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
  IF (l_layout IS NOT NULL)THEN
    N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    IF (l_gerarPendencia = TRUE) THEN
	  SP_E_SOCIAL(l_layout, 'R034ETT', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_AltAdm, '', 0, NULL, l_DataAlteracao, 0, 'R034ETT_EI');
    END IF;
  END IF;
  
  /* Geração de logs Informações do Estatutário (Tabela: R034ETT)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 113;     /* Informações do Estatutário (Tabela: R034ETT)*/
  l_codtpa := 337;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034ETT_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034ETT_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPPRO', CONVERT(NUMBER_TO_CHAR, :NEW.TIPPRO));
        SP_DATSTR(:NEW.DATNOM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATNOM', l_datTemp);
        SP_DATSTR(:NEW.DATPOS, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPOS', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRO', CONVERT(NUMBER_TO_CHAR, :NEW.CODPRO));
      END;
  END IF; 
END␀`Ó␀␀		SENIOR;0n␀␀

TRIGGER R034ETT_EU AFTER UPDATE ON R034ETT FOR EACH ROW

DECLARE
  l_Valido BOOLEAN;
  l_Alterou BOOLEAN;
  l_DataAlteracao DATE;
  l_layout VARCHAR2(6); /* layout do colaborador no esocial */
  l_AltAdm VARCHAR2(2000); /* campos alterados que influenciam no layout de admissao */
  l_JsonCamposAlterados VARCHAR2(2000);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_InfoFacult   BOOLEAN;
  l_SimplificacaoESocial BOOLEAN;
  l_gerarPendencia BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  l_Alterou := FALSE;
  l_gerarPendencia := TRUE;
  l_InfoFacult := TRUE;
  l_SimplificacaoESocial := FALSE;
  l_VersaoESocial := 0;
  l_JsonCamposAlterados := '';

  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificacaoESocial OUT, l_VersaoESocial OUT);

  SP_VALUPDATE_NUM(:OLD.TIPPRO, :NEW.TIPPRO, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_NUM_JSON('TIPPRO', :NEW.TipPro, :OLD.TipPro, l_JsonCamposAlterados OUT);
  END IF;

  IF (l_SimplificacaoESocial = FALSE) THEN
     SP_VALUPDATE_DAT(:OLD.DATNOM, :NEW.DATNOM, l_Valido OUT);
     IF (l_Valido = TRUE) THEN
       l_Alterou := TRUE;
       SP_CONCAT_DAT_JSON('DATNOM', :NEW.DatNom, :OLD.DatNom, l_JsonCamposAlterados OUT);
     END IF;
   
     SP_VALUPDATE_DAT(:OLD.DATPOS, :NEW.DATPOS, l_Valido OUT);
     IF (l_Valido = TRUE) THEN
       l_Alterou := TRUE;
       SP_CONCAT_DAT_JSON('DATPOS', :NEW.DatPos, :OLD.DatPos, l_JsonCamposAlterados OUT);
     END IF;

     SP_VALUPDATE_NUM(:OLD.CODPRO, :NEW.CODPRO, l_Valido OUT);
     IF (l_Valido = TRUE) THEN
       l_Alterou := TRUE;
       SP_CONCAT_NUM_JSON('CODPRO', :NEW.CodPro, :OLD.CodPro, l_JsonCamposAlterados OUT);
     END IF;
  END IF;

  IF (l_Alterou = TRUE) THEN
    l_AltAdm := '';

    l_DataAlteracao := CURDATE();
    SP_CONCATENAR_DAT('DATALT', l_DataAlteracao, l_AltAdm OUT);
    
    RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
    IF (l_layout IS NOT NULL)THEN
      N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
      IF (l_gerarPendencia = TRUE) THEN
        SP_E_SOCIAL(l_layout, 'R034ETT', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_AltAdm, l_JsonCamposAlterados, 0, NULL, l_DataAlteracao, 0, 'R034ETT_EU');
      END IF;
    END IF;
  END IF;
  
  /* Geração de logs Informações do Estatutário (Tabela: R034ETT)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 113;     /* Informações do Estatutário (Tabela: R034ETT)*/
  l_codtpa := 338;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.TipPro <> :NEW.TipPro)
   OR (:OLD.DatNom <> :NEW.DatNom)
   OR (:OLD.DatPos <> :NEW.DatPos)
   OR (:OLD.CodPro <> :NEW.CodPro)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034ETT_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034ETT_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPPRO', CONVERT(NUMBER_TO_CHAR, :OLD.TIPPRO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPPRO', CONVERT(NUMBER_TO_CHAR, :NEW.TIPPRO));
        SP_DATSTR(:OLD.DATNOM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATNOM', l_datTemp);
        SP_DATSTR(:NEW.DATNOM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATNOM', l_datTemp);
        SP_DATSTR(:OLD.DATPOS, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATPOS', l_datTemp);
        SP_DATSTR(:NEW.DATPOS, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATPOS', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPRO', CONVERT(NUMBER_TO_CHAR, :OLD.CODPRO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPRO', CONVERT(NUMBER_TO_CHAR, :NEW.CODPRO));
      END;
    END IF; 
  END IF; 
END␀^Ó␀␀		SENIOR;0Û
␀␀

TRIGGER R034ETT_ED AFTER DELETE ON R034ETT FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);
  l_DataAlteracao DATE;
  l_layout VARCHAR2(6); /* layout do colaborador no esocial */
  l_AltAdm VARCHAR2(2000); /* campos alterados que influenciam no layout de admissao */
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_gerarPendencia BOOLEAN;  
BEGIN
  l_AltAdm := '';
  l_DataAlteracao := CURDATE();
  l_gerarPendencia := TRUE;
  SP_CONCATENAR_DAT('DATALT', l_DataAlteracao, l_AltAdm OUT);
  RH_LAYOUTCOLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layout OUT);
  IF (l_layout IS NOT NULL) THEN
    N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    IF (l_gerarPendencia = TRUE) THEN  
      SP_E_SOCIAL(l_layout, 'R034ETT', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_AltAdm, '', 0, NULL, l_DataAlteracao, 0, 'R034ETT_ED');
    END IF;
  END IF;
  
  /* Geração de logs Informações do Estatutário (Tabela: R034ETT)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 113;     /* Informações do Estatutário (Tabela: R034ETT)*/
  l_codtpa := 337;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034ETT_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034ETT_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPPRO', CONVERT(NUMBER_TO_CHAR, :OLD.TIPPRO));
        SP_DATSTR(:OLD.DATNOM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATNOM', l_datTemp);
        SP_DATSTR(:OLD.DATPOS, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPOS', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRO', CONVERT(NUMBER_TO_CHAR, :OLD.CODPRO));
      END;
  END IF;
END␀␀␀Š␀␀␀␀␀␀␀␀␀␀aÓ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀g>XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀›␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀‚%€$€$w␀Æÿ␀␀…Ó␀␀␀ÔDÑ␀	␀␀␀␀␀␀␀õMÙE¢FqC␀êÿ␀␀ÿ␀7ı␀␀­␀	␀␀␀␀␀␀␀hÿ␀␀ü␀␀xş␀␀p␀Æÿ␀␀ÿ␀u␀c␀␀␀␀␀␀␀,␀>␀O␀`§†␀␀ÿ␀␀ÿ␀T)␀␀␀␀␀␀␀ÖYùº␀␀»␀␀=§†␀␀ÿ␀␀ÿ␀=h=␀␀␀␀␀␀␀Š␀␀==c␀␀␀ÿ␀␀ÿ␀␀L␀␀␀␀␀␀␀*␀␀¤␀c␀␀␀ÿ␀␀ÿ␀½ª␀␀‡␀␀␀␀␀␀␀Ùó␀␀´ó␀␀´ó␀␀c␀␀␀ÿ␀␀ÿ␀hğ␀␀␀␀␀␀␀h	hhc␀␀␀ÿ␀␀ÿ␀}␀¦␀␀␀␀␀␀␀‹␀µ␀␀µ␀␀c␀␀␀ÿ␀␀ÿ␀>¦␀␀c␀␀␀␀␀␀␀t¦␀␀I¦␀␀I¦␀␀`§†␀␀ÿ␀␀ÿ␀{DÑ␀␀␀␀␀␀␀␀ÛEÛEÛEqC␀êÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀¹␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀bÓ␀␀…¬␀␀´␀	Ôÿ!␀␀␀␀␀g>XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ!␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀9Ó␀␀␀c¬␀␀Ì␀	Ôÿ!␀␀␀␀␀œ$€$€$w␀Æÿ␀␀…Ó␀␀␀EÑ␀	Ôÿ!␀␀␀␀␀éG¢G¢GqC␀êÿ␀␀ÿ␀'-´␀Ôÿ!␀␀␀␀␀AÉ»␀␀É»␀␀r␀Æÿ␀␀Û␀␀␀yTUÔÿ!␀␀␀␀␀„f„f„fV␀␀ÿ␀␀ÿ␀Z§␀␀UÔÿ!␀␀␀␀␀o*o*o*V␀␀ÿ␀␀ÿ␀@§␀␀(Ôÿ!␀␀␀␀␀‹‹‹1␀␀ÿ␀␀ÿ␀:-
Ôÿ!␀␀␀␀␀Ù;Ù;Ù;␀␀ÿ␀␀ÿ␀©cÔÿ!␀␀␀␀␀Íc²c²c␀␀ÿ␀␀ÿ␀¢cnÔÿ!␀␀␀␀␀]¯␀␀]¯␀␀]¯␀␀l␀␀ÿ␀␀ÿ␀’c8Ôÿ!␀␀␀␀␀Ê0Ç0Ç0?␀␀ÿ␀␀ÿ␀è¬␀␀¢␀Ôÿ!␀␀␀␀␀—±␀␀€	␀€	␀†)␀␀Æÿ␀␀ÿ␀åDÑ␀Ôÿ!␀␀␀␀␀GÔFÔFqC␀êÿ␀␀ÿ␀±¦␀␀E␀␀␀␀␀␀␀y°␀␀ƒ¥␀␀ƒ¥␀␀G␀␀ÿ␀␀ÿ␀…␀␀·␀␀␀␀␀␀␀”␀␀÷Š␀␀”␀␀n␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3dÓ␀␀		SENIOR;0ö␀␀TRIGGER R034EXT_AI AFTER INSERT ON R034EXT FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_temAud       BOOLEAN;
	l_codRPA       NUMBER(15);
	l_codSistema   NUMBER(2);
	l_codcpa       NUMBER(4);
	l_codtpa       NUMBER(4);
	l_datTemp      VARCHAR2(10);
	l_layout       VARCHAR2(6);
    l_layoutAlteracaoCadastral VARCHAR2(6);	
BEGIN
	RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
	IF (l_layout IS NOT NULL) THEN
	    RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
		SP_TAB_ESOCIAL(l_layoutAlteracaoCadastral, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATINI, :NEW.DATFIM, 'R034EXT', 'I', '', '', 0, 'R034EXT_AI');
		l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
		IF (l_DataZero <> :NEW.DATFIM) THEN
          SP_HIST_DT_ESOCIAL(l_layoutAlteracaoCadastral, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATFIM, 'R034EXT', 'DATINI', 'I', '', '', '', 0, 'R034EXT_AI');
        END IF;   		
	END IF;
	
	/* Geração de logs Dados no Exterior (Tabela: R034EXT)*/ 
	l_codSistema := 1;  /* Código do sistema vetorh. */
	l_codcpa := 114;     /* Dados no Exterior (Tabela: R034EXT)*/
	l_codtpa := 339;
 
	SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
	  SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034EXT_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034EXT_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPAI', CONVERT(NUMBER_TO_CHAR, :NEW.CODPAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESEST', :NEW.DESEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMCID', :NEW.NOMCID);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMBAI', :NEW.NOMBAI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPOS', :NEW.CODPOS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDRUA', :NEW.ENDRUA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDNUM', :NEW.ENDNUM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDCPL', :NEW.ENDCPL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMTEL', CONVERT(NUMBER_TO_CHAR, :NEW.NUMTEL));
        SP_DATSTR(:NEW.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATFIM', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NIFEXT', :NEW.NIFEXT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDNIF', CONVERT(NUMBER_TO_CHAR, :NEW.INDNIF));
      END;
  END IF; 
END␀eÓ␀␀		SENIOR;0.␀␀

TRIGGER R034EXT_AU AFTER UPDATE ON R034EXT FOR EACH ROW
DECLARE
	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_AlterouSomenteDataFim BOOLEAN;
	l_temAud       BOOLEAN;
	l_codRPA       NUMBER(15);
	l_codSistema   NUMBER(2);
	l_codcpa       NUMBER(4);
	l_codtpa       NUMBER(4);
	l_datTemp      VARCHAR2(10);
	l_JsonCamposAlterados VARCHAR2(2000);
	l_layout VARCHAR2(6);
	l_layoutAlteracaoCadastral VARCHAR2(6);
BEGIN
	l_Alterou := FALSE;
	l_AlterouSomenteDataFim := FALSE;
	l_JsonCamposAlterados := '';

	SP_VALUPDATE_NUM(:OLD.CODPAI, :NEW.CODPAI, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_NUM_JSON('CODPAI', :NEW.CodPai, :OLD.CodPai, l_JsonCamposAlterados OUT);
	END IF;

	SP_VALUPDATE_DES(:OLD.ENDRUA, :NEW.ENDRUA, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_DES_JSON('ENDRUA', :NEW.EndRua, :OLD.EndRua, l_JsonCamposAlterados OUT);
	END IF;

	SP_VALUPDATE_DES(:OLD.ENDNUM, :NEW.ENDNUM, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_DES_JSON('ENDNUM', :NEW.EndNum, :OLD.EndNum, l_JsonCamposAlterados OUT);
	END IF;

	SP_VALUPDATE_DES(:OLD.ENDCPL, :NEW.ENDCPL, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_DES_JSON('ENDCPL', :NEW.EndCpl, :OLD.EndCpl, l_JsonCamposAlterados OUT);
	END IF;

	SP_VALUPDATE_DES(:OLD.NOMBAI, :NEW.NOMBAI, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_DES_JSON('NOMBAI', :NEW.NomBai, :OLD.NomBai, l_JsonCamposAlterados OUT);
	END IF;

	SP_VALUPDATE_DES(:OLD.NOMCID, :NEW.NOMCID, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_DES_JSON('NOMCID', :NEW.NomCid, :OLD.NomCid, l_JsonCamposAlterados OUT);
	END IF;

	SP_VALUPDATE_DES(:OLD.CodPos, :NEW.CodPos, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_DES_JSON('CODPOS', :NEW.CodPos, :OLD.CodPos, l_JsonCamposAlterados OUT);
	END IF;

	SP_VALUPDATE_DAT(:OLD.DATFIM, :NEW.DATFIM, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		IF (l_Alterou = FALSE) THEN
			l_AlterouSomenteDataFim := TRUE;
		END IF;
		l_Alterou := TRUE;
		SP_CONCAT_DAT_JSON('DATFIM', :NEW.DatFim, :OLD.DatFim, l_JsonCamposAlterados OUT);	
	END IF;

	IF (l_Alterou = TRUE) THEN	
	  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
	  IF (l_layout IS NOT NULL) THEN
	        RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
			SP_ALT_TAB_ESOCIAL(l_layoutAlteracaoCadastral, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATINI, :NEW.DATFIM, :OLD.DATFIM, 'R034EXT', '', l_JsonCamposAlterados, l_AlterouSomenteDataFim, 'DATINI', '', 0, 'R034EXT_AU'); 
	  END IF;
	END IF;
	
  /* Geração de logs Dados no Exterior (Tabela: R034EXT)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 114;     /* Dados no Exterior (Tabela: R034EXT)*/
  l_codtpa := 340;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatIni <> :NEW.DatIni)
   OR (:OLD.CodPai <> :NEW.CodPai)
   OR (:OLD.DesEst <> :NEW.DesEst)
   OR (:OLD.NomCid <> :NEW.NomCid)
   OR (:OLD.NomBai <> :NEW.NomBai)
   OR (:OLD.CodPos <> :NEW.CodPos)
   OR (:OLD.EndRua <> :NEW.EndRua)
   OR (:OLD.EndNum <> :NEW.EndNum)
   OR (:OLD.EndCpl <> :NEW.EndCpl)
   OR (:OLD.NumTel <> :NEW.NumTel)
   OR (:OLD.DatFim <> :NEW.DatFim)
   OR (:OLD.NifExt <> :NEW.NifExt)
   OR (:OLD.IndNif <> :NEW.IndNif)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034EXT_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034EXT_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPAI', CONVERT(NUMBER_TO_CHAR, :OLD.CODPAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPAI', CONVERT(NUMBER_TO_CHAR, :NEW.CODPAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDESEST', :OLD.DESEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDESEST', :NEW.DESEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOMCID', :OLD.NOMCID);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNOMCID', :NEW.NOMCID);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOMBAI', :OLD.NOMBAI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNOMBAI', :NEW.NOMBAI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPOS', :OLD.CODPOS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPOS', :NEW.CODPOS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENDRUA', :OLD.ENDRUA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENDRUA', :NEW.ENDRUA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENDNUM', :OLD.ENDNUM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENDNUM', :NEW.ENDNUM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENDCPL', :OLD.ENDCPL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENDCPL', :NEW.ENDCPL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMTEL', CONVERT(NUMBER_TO_CHAR, :OLD.NUMTEL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMTEL', CONVERT(NUMBER_TO_CHAR, :NEW.NUMTEL));
        SP_DATSTR(:OLD.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATFIM', l_datTemp);
        SP_DATSTR(:NEW.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATFIM', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNIFEXT', :OLD.NIFEXT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNIFEXT', :NEW.NIFEXT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINDNIF', CONVERT(NUMBER_TO_CHAR, :OLD.INDNIF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINDNIF', CONVERT(NUMBER_TO_CHAR, :NEW.INDNIF));
      END;
    END IF; 
  END IF;
END␀cÓ␀␀		SENIOR;0İ␀␀

TRIGGER R034EXT_AD AFTER DELETE ON R034EXT FOR EACH ROW
DECLARE
	l_temAud       BOOLEAN;
    l_codRPA       NUMBER(15);
    l_codSistema   NUMBER(2);
    l_codcpa       NUMBER(4);
    l_codtpa       NUMBER(4);
    l_datTemp      VARCHAR2(10);
	l_layout VARCHAR2(6);
    l_layoutAlteracaoCadastral VARCHAR2(6);    
BEGIN
	RH_LAYOUTCOLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layout OUT);
	IF (l_layout IS NOT NULL) THEN
	    RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
		SP_TAB_ESOCIAL(l_layoutAlteracaoCadastral, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATINI, :OLD.DATFIM, 'R034EXT', 'E', '', '', 0, 'R034EXT_AD');
	END IF;
	
	/* Geração de logs Dados no Exterior (Tabela: R034EXT)*/ 
	l_codSistema := 1;  /* Código do sistema vetorh. */
	l_codcpa := 114;     /* Dados no Exterior (Tabela: R034EXT)*/
	l_codtpa := 339;
	
	SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
	  SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034EXT_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034EXT_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPAI', CONVERT(NUMBER_TO_CHAR, :OLD.CODPAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESEST', :OLD.DESEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMCID', :OLD.NOMCID);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMBAI', :OLD.NOMBAI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPOS', :OLD.CODPOS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDRUA', :OLD.ENDRUA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDNUM', :OLD.ENDNUM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDCPL', :OLD.ENDCPL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMTEL', CONVERT(NUMBER_TO_CHAR, :OLD.NUMTEL));
        SP_DATSTR(:OLD.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATFIM', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NIFEXT', :OLD.NIFEXT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDNIF', CONVERT(NUMBER_TO_CHAR, :OLD.INDNIF));
      END;
  END IF;
END␀␀␀,D␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀fÓ␀␀7‹␀␀3	␀␀␀␀␀␀bŠ␀␀bŠ␀␀YŠ␀␀4␀␀ÿ␀␀ÿ␀5-·␀	␀␀␀␀␀␀\A“␀“␀s␀Æÿ␀␀ë×␀␀␀x-·␀	␀␀␀␀␀␀@¥.¥.u␀Æÿ␀␀Ø␀␀␀¥%␀±␀	␀␀␀␀␀␀?&␀;&␀<&␀q␀Æÿ␀␀6Ø␀␀␀3-Á␀	␀␀␀␀␀␀Ï@˜š␀␀˜š␀␀y␀Æÿ␀␀å×␀␀␀ï␀␀·␀	␀␀␀␀␀␀•␀␀•”␀␀•␀␀ì*␀␀Æÿ␀␀ÿ␀Æ[¡	␀␀␀␀␀␀Z[Z[Z[n␀Æÿ␀␀ÿ␀m,Ì␀	␀␀␀␀␀␀N@¤:¤:{␀Æÿ␀␀ÿ␀V¬␀␀Ì␀␀␀␀␀␀␀iaa{␀Æÿ␀␀f×␀␀␀o·␀␀␀␀␀␀␀Én€nÀnì*␀␀Æÿ␀␀ÿ␀+f±␀␀␀␀␀␀␀␀=øeËfq␀Æÿ␀␀d`␀Ä␀␀4␀␀␀␀␀␀(Ap:Û;f␀␀␀ÿ␀␀ş¸␀␀␀␀␀␀0;3;4;1;2;6;5;7␀␀0l␀␀␀␀␀␀␀␀␀␀␀␀␀gÓ␀␀…¬␀␀´␀	Ôÿ!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ!␀␀␀␀␀›␀Ü␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ!␀␀␀␀␀‚%€$€$w␀Æÿ␀␀…Ó␀␀␀P+Ñ␀	Ôÿ!␀␀␀␀␀Ó/Ó/Ó/œ␀␀␀êÿ␀␀ÿ␀‡§␀␀UÔÿ!␀␀␀␀␀ş§␀␀ç§␀␀ç§␀␀V␀␀ÿ␀␀ÿ␀y¬␀␀Ì␀Ôÿ!␀␀␀␀␀ø¯␀␀ı#$({␀Æÿ␀␀ÿ␀%␀␀bÔÿ!␀␀␀␀␀à␀Ù␀Ü␀g␀␀ÿ␀␀ÿ␀fåÔÿ!␀␀␀␀␀ef¾␀À␀h␀␀␀ÿ␀␀ÿ␀À¬␀␀␀Ôÿ!␀␀␀␀␀x±␀␀¡¸␀␀¡¸␀␀U␀Æÿ␀␀ÿ␀bDÑ␀Ôÿ!␀␀␀␀␀€JîEîEqC␀êÿ␀␀ÿ␀OEÑ␀Ôÿ!␀␀␀␀␀YKwµ␀␀,HqC␀êÿ␀␀ÿ␀<EÑ␀Ôÿ!␀␀␀␀␀RKHHqC␀êÿ␀␀ÿ␀ä=Ôÿ!␀␀␀␀␀&Õ%c␀␀␀ÿ␀␀ÿ␀s¬␀␀␀Ôÿ!␀␀␀␀␀±␀␀‰#‰#Q␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3␀␀Ú␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀hÓ␀␀…¬␀␀´␀Ôÿ!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀tÔÿ!␀␀␀␀␀›␀Ü␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀Ôÿ!␀␀␀␀␀‚%€$€$w␀Æÿ␀␀ÿ␀P+Ñ␀Ôÿ!␀␀␀␀␀Ó/Ó/Ó/œ␀␀␀êÿ␀␀ÿ␀‡§␀␀UÔÿ!␀␀␀␀␀ş§␀␀ç§␀␀ç§␀␀V␀␀ÿ␀␀ÿ␀y¬␀␀Ì␀Ôÿ!␀␀␀␀␀ø¯␀␀ı#$({␀Æÿ␀␀ÿ␀%␀␀bÔÿ!␀␀␀␀␀à␀Ù␀Ü␀g␀␀ÿ␀␀ÿ␀fåÔÿ!␀␀␀␀␀ef¾␀À␀h␀␀␀ÿ␀␀ÿ␀À¬␀␀␀Ôÿ!␀␀␀␀␀x±␀␀¡¸␀␀¡¸␀␀U␀Æÿ␀␀ÿ␀bDÑ␀Ôÿ!␀␀␀␀␀€JîEîEqC␀êÿ␀␀ÿ␀OEÑ␀Ôÿ!␀␀␀␀␀YKwµ␀␀,HqC␀êÿ␀␀ÿ␀