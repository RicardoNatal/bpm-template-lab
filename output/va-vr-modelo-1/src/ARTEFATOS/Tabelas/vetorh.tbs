i­␀␀l±␀␀p␀Æÿ␀␀ÿ␀{EÑ␀Ôï!␀␀␀␀␀;J7_pHqC␀êÿ␀␀ÿ␀µEÑ␀Ôï!␀␀␀␀␀©L6␀ÉHqC␀êÿ␀␀ÿ␀_¬␀␀¼␀Ôï!␀␀␀␀␀±␀␀g­␀␀±␀␀v␀Æÿ␀␀ÿ␀¼³␀␀~Ôï!␀␀␀␀␀ñ³␀␀ñ³␀␀ñ³␀␀B␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3;4;5dÕ␀␀		SENIOR;0Õ	␀␀/* INSERT (NEW) */
TRIGGER R038PRO_EI AFTER INSERT ON R038PRO FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs HistoricoAfastamentosProrrogacoes*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 73;     /* HistoricoAfastamentosProrrogacoes*/
  l_codtpa := 257;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038PRO_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAFA', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORAFA', CONVERT(NUMBER_TO_CHAR, :NEW.HORAFA));
        SP_DATSTR(:NEW.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038PRO_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMATO', CONVERT(NUMBER_TO_CHAR, :NEW.NUMATO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLAU', CONVERT(NUMBER_TO_CHAR, :NEW.NUMLAU));
        SP_DATSTR(:NEW.DATPUB, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPUB', l_datTemp);
        SP_DATSTR(:NEW.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATTER', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMBOL', CONVERT(NUMBER_TO_CHAR, :NEW.NUMBOL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSPRO', :NEW.OBSPRO);
      END;
  END IF; 
END␀eÕ␀␀		SENIOR;0³␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R038PRO_EU AFTER UPDATE ON R038PRO FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs HistoricoAfastamentosProrrogacoes*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 73;     /* HistoricoAfastamentosProrrogacoes*/
  l_codtpa := 258;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatAfa <> :NEW.DatAfa)
   OR (:OLD.HorAfa <> :NEW.HorAfa)
   OR (:OLD.DatIni <> :NEW.DatIni)
   OR (:OLD.NumAto <> :NEW.NumAto)
   OR (:OLD.NumLau <> :NEW.NumLau)
   OR (:OLD.DatPub <> :NEW.DatPub)
   OR (:OLD.DatTer <> :NEW.DatTer)
   OR (:OLD.NumBol <> :NEW.NumBol)
   OR (:OLD.ObsPro <> :NEW.ObsPro)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038PRO_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATAFA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATAFA', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORAFA', CONVERT(NUMBER_TO_CHAR, :OLD.HORAFA));
        SP_DATSTR(:OLD.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038PRO_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMATO', CONVERT(NUMBER_TO_CHAR, :OLD.NUMATO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMATO', CONVERT(NUMBER_TO_CHAR, :NEW.NUMATO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMLAU', CONVERT(NUMBER_TO_CHAR, :OLD.NUMLAU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMLAU', CONVERT(NUMBER_TO_CHAR, :NEW.NUMLAU));
        SP_DATSTR(:OLD.DATPUB, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATPUB', l_datTemp);
        SP_DATSTR(:NEW.DATPUB, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATPUB', l_datTemp);
        SP_DATSTR(:OLD.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATTER', l_datTemp);
        SP_DATSTR(:NEW.DATTER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATTER', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMBOL', CONVERT(NUMBER_TO_CHAR, :OLD.NUMBOL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMBOL', CONVERT(NUMBER_TO_CHAR, :NEW.NUMBOL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSPRO', :OLD.OBSPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSPRO', :NEW.OBSPRO);
      END;
    END IF; 
  END IF; 
END␀cÕ␀␀		SENIOR;0Ø	␀␀ 

