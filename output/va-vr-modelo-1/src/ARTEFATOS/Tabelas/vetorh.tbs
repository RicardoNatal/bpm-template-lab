DECLARE
  l_codplt       CHAR(5);
  l_datocp       CHAR(8);
  l_horocp       CHAR(4);
  l_seqocp       CHAR(2);
  l_seqenv       CHAR(2);
  l_idtpes       CHAR(23);
  l_valstr       VARCHAR2(45);
BEGIN
  SP_INTSTR(:NEW.CODPLT, '99999', l_codplt OUT);
  SP_DATSTR(:NEW.DATOCP, 'DDMMYYYY', l_datocp OUT);
  SP_INTSTR(:NEW.HOROCP, '9999', l_horocp OUT);
  SP_INTSTR(:NEW.SEQOCP, '99', l_seqocp OUT);
  SP_INTSTR(:NEW.SEQENV, '99', l_seqenv OUT);
  SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '', '', '', l_idtpes OUT);
    
  l_valstr := 'C' || l_codplt || l_datocp || l_horocp || l_seqocp || l_seqenv || l_idtpes;
   
  SP_SAM_PENDENCIES(5, 1, l_valstr);
END␀␀␀‹.␀␀␀␀␀␀␀␀Qİ␀␀5-·␀	␀␀␀␀␀␀—␀“␀“␀s␀Æÿ␀␀ë×␀␀␀IEÑ␀	␀␀␀␀␀␀MÙEQGqC␀êÿ␀␀Rİ␀␀␀Âw·␀	␀␀␀␀␀␀Øyıw`xì*␀␀Æÿ␀␀Tİ␀␀␀½ı␀␀­␀	␀␀␀␀␀␀’ÿ␀␀xş␀␀¶ş␀␀p␀Æÿ␀␀Uİ␀␀␀V¬␀␀Ì␀␀␀␀␀␀␀kgk{␀Æÿ␀␀f×␀␀␀×␀±␀␀␀␀␀␀␀µ␀t␀␀q␀Æÿ␀␀hİ␀␀␀§³␀␀␀␀␀␀␀␀øX°V°V␀␀ÿ␀␀ÿ␀`=␀␀␀␀␀␀½cºc»c<␀␀ÿ␀␀ÿ␀¥%␀±␀␀␀␀␀␀␀?&␀;&␀;&␀q␀Æÿ␀␀6Ø␀␀␀3-Á␀␀␀␀␀␀␀Ï@˜š␀␀˜š␀␀y␀Æÿ␀␀å×␀␀␀×-‹␀␀␀␀␀␀␀‘A¤:¤:—)␀␀Æÿ␀␀ÿ␀ú‹␀␀”␀␀␀␀␀␀ù␀ø␀[␀n␀Æÿ␀␀ÿ0␀␀␀0;1;2;3Sİ␀␀		SENIOR;0␀␀TRIGGER R090OCP_EI BEFORE INSERT ON R090OCP FOR EACH ROW
DECLARE
  l_codplt       CHAR(5);
  l_datocp       CHAR(8);
  l_horocp       CHAR(4);
  l_seqocp       CHAR(2);
  l_valstr       VARCHAR2(20);
BEGIN
  SP_INTSTR(:NEW.CODPLT, '99999', l_codplt OUT);
  SP_DATSTR(:NEW.DATOCP, 'DDMMYYYY', l_datocp OUT);
  SP_INTSTR(:NEW.HOROCP, '9999', l_horocp OUT);
  SP_INTSTR(:NEW.SEQOCP, '99', l_seqocp OUT);
    
  l_valstr := 'I' || l_codplt || l_datocp || l_horocp || l_seqocp;
   
  SP_SAM_PENDENCIES(5, 1, l_valstr);
END␀␀␀Œ␀␀␀␀␀␀␀␀␀␀␀␀␀␀Vİ␀␀5-·␀	␀␀␀␀␀␀–␀“␀“␀s␀Æÿ␀␀ë×␀␀␀IEÑ␀	␀␀␀␀␀␀¼IÙE'HqC␀êÿ␀␀ÿ␀Âw·␀	␀␀␀␀␀␀!yıwªxì*␀␀Æÿ␀␀ÿ␀½ı␀␀­␀	␀␀␀␀␀␀ÿ␀␀xş␀␀Îş␀␀p␀Æÿ␀␀ÿ␀(ı␀␀­␀	␀␀␀␀␀␀ÿ␀␀¨ş␀␀¨ş␀␀p␀Æÿ␀␀ÿ␀N␀	␀␀␀␀␀␀š␀␀0␀n␀Æÿ␀␀bİ␀␀␀~¬␀␀(	␀␀␀␀␀␀M±␀␀†^¯␀␀d␀␀␀ÿ␀␀aİ␀␀␀␀␀␀	0;1;2;3;4Wİ␀␀		SENIOR;0“␀␀TRIGGER R090OPE_EI BEFORE INSERT ON R090OPE FOR EACH ROW
DECLARE
  l_codplt       CHAR(5);
  l_datocp       CHAR(8);
  l_horocp       CHAR(4);
  l_seqocp       CHAR(2);
  l_seqenv       CHAR(2);
  l_idtpes       CHAR(23);
  l_valstr       VARCHAR2(45);
  l_numemp       NUMBER;
  l_tipcol       NUMBER;
  l_numcad       NUMBER;
BEGIN
  SP_INTSTR(:NEW.CODPLT, '99999', l_codplt OUT);
  SP_DATSTR(:NEW.DATOCP, 'DDMMYYYY', l_datocp OUT);
  SP_INTSTR(:NEW.HOROCP, '9999', l_horocp OUT);
  SP_INTSTR(:NEW.SEQOCP, '99', l_seqocp OUT);
  SP_INTSTR(:NEW.SEQENV, '99', l_seqenv OUT);
  
  /* Verificar se a pessoa não grata é um colaborador */
  BEGIN
  	SELECT NUMEMP, TIPCOL, NUMCAD INTO l_numemp, l_tipcol, l_numcad FROM R090PNG WHERE TIPDOC = :NEW.TIPDOC AND NUMDOC = :NEW.NUMDOC;
  EXCEPTION
  	WHEN OTHERS THEN  
      l_numemp := 0;
      l_tipcol := 0;
      l_numcad := 0;
  END;
  
  /* Caso for colaborador, monta IDTPES de colaborador. Caso contrário, monta IDTPES como visitante */
  IF (l_numemp IS NOT NULL AND l_tipcol IS NOT NULL AND l_numcad IS NOT NULL AND l_numemp > 0 AND l_tipcol > 0 AND l_numcad > 0) THEN
    SP_RETIDTPES(l_numemp, l_tipcol, l_numcad, 0, '', '', '', l_idtpes OUT);
  ELSE
    SP_RETIDTPES(0, 4, 0, :NEW.TIPDOC, :NEW.NUMDOC, '', '', l_idtpes OUT);
  END IF;
  
  l_valstr := 'P' || l_codplt || l_datocp || l_horocp || l_seqocp || l_seqenv || l_idtpes;
   
  SP_SAM_PENDENCIES(5, 1, l_valstr);
END␀␀␀Â␀␀␀␀␀␀␀␀␀␀Xİ␀␀5-·␀	␀␀␀␀␀␀–␀“␀“␀s␀Æÿ␀␀ë×␀␀␀IEÑ␀	␀␀␀␀␀␀¼IÙE'HqC␀êÿ␀␀ÿ␀Âw·␀	␀␀␀␀␀␀!yıwªxì*␀␀Æÿ␀␀ÿ␀½ı␀␀­␀	␀␀␀␀␀␀ÿ␀␀xş␀␀Îş␀␀p␀Æÿ␀␀ÿ␀(ı␀␀­␀	␀␀␀␀␀␀ÿ␀␀¨ş␀␀¨ş␀␀p␀Æÿ␀␀ÿ␀N␀	␀␀␀␀␀␀£␀␀0␀n␀Æÿ␀␀|İ␀␀␀~¬␀␀(	␀␀␀␀␀␀V±␀␀†^¯␀␀d␀␀␀ÿ␀␀{İ␀␀␀␀␀␀	0;1;2;3;4Yİ␀␀		SENIOR;0É␀␀TRIGGER R090OVE_EI BEFORE INSERT ON R090OVE FOR EACH ROW
DECLARE
  l_codplt       CHAR(5);
  l_datocp       CHAR(8);
  l_horocp       CHAR(4);
  l_seqocp       CHAR(2);
  l_seqenv       CHAR(2);
  l_idtpes       CHAR(23);
  l_valstr       VARCHAR2(45);
BEGIN
  SP_INTSTR(:NEW.CODPLT, '99999', l_codplt OUT);
  SP_DATSTR(:NEW.DATOCP, 'DDMMYYYY', l_datocp OUT);
  SP_INTSTR(:NEW.HOROCP, '9999', l_horocp OUT);
  SP_INTSTR(:NEW.SEQOCP, '99', l_seqocp OUT);
  SP_INTSTR(:NEW.SEQENV, '99', l_seqenv OUT);
  SP_RETIDTPES(0, 4, 0, :NEW.TIPDOC, :NEW.NUMDOC, '', '', l_idtpes OUT);
    
  l_valstr := 'V' || l_codplt || l_datocp || l_horocp || l_seqocp || l_seqenv || l_idtpes;
   
  SP_SAM_PENDENCIES(5, 1, l_valstr);
END␀␀␀#'␀␀␀␀␀␀␀␀␀Zİ␀␀N␀	␀␀␀␀␀␀š␀␀0␀n␀Æÿ␀␀bİ␀␀␀~¬␀␀(	␀␀␀␀␀␀M±␀␀†^¯␀␀d␀␀␀ÿ␀␀aİ␀␀␀°§␀␀U␀␀␀␀␀␀è§␀␀ç§␀␀ç§␀␀V␀␀ÿ␀␀ÿ␀¥c␀␀␀␀␀␀©©©`␀␀ÿ␀␀ÿ␀ª§␀␀U␀␀␀␀␀␀¸©␀␀<º␀␀¸©␀␀V␀␀ÿ␀␀ÿ␀™§␀␀v␀␀␀␀␀␀µ¨␀␀e¤␀␀µ¨␀␀n␀␀ÿ␀␀ÿ␀w^(␀␀␀␀␀␀’^^^1␀␀ÿ␀␀ÿ␀<EÑ␀␀␀␀␀␀␀SK(¦␀␀HqC␀êÿ␀␀ÿ␀ò&␀	␀␀␀␀␀␀š(␀š(␀›(␀c␀␀␀ÿ␀␀ÿ␀Àú␀␀␀␀␀␀␀␀Üú␀␀µú␀␀Ôú␀␀n␀Æÿ␀␀ÿ␀»ú␀␀(␀␀␀␀␀␀Úú␀␀´ú␀␀Ôú␀␀d␀␀␀ÿ␀␀ÿ␀EÆ␀␀␀␀␀␀␀␀]Æ␀␀ZÆ␀␀ZÆ␀␀'␀␀ÿ␀␀ÿ␀1½␀␀[␀␀␀␀␀␀À␀␀À␀␀À␀␀c␀␀␀ÿ␀␀ÿ␀»¢␀␀␀␀␀␀␀␀Ï¢␀␀Î¢␀␀Î¢␀␀#␀␀ÿ␀␀ÿ␀ŸpÒ␀␀␀␀␀␀␀£p£p£pÿ␀ÿÿ␀␀ÿ␀-­␀␀␀␀␀␀␀è@Î¢␀␀£;p␀Æÿ␀␀>İ␀␀␀ŒDÑ␀␀␀␀␀␀␀øJ8F8FqC␀êÿ␀␀ÿ␀…¬␀␀´␀␀␀␀␀␀␀¢<¬b¬brˆ␀Æÿ␀␀ÿ␀.␀t␀␀␀␀␀␀O␀Ò␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀␀␀␀␀␀␀ù$$ª$w	ˆ␀␀Æÿ␀␀ÿ␀¨ =␀␀␀␀␀␀ö ı ı c␀␀␀ÿ␀␀ÿ␀Z½␀␀[␀␀␀␀␀␀À␀␀À␀␀À␀␀c␀␀␀ÿ␀␀ÿ␀×-‹␀␀␀␀␀␀␀ÍBm␀m␀—)␀␀Æÿ␀␀ÿ␀␀␀[İ␀␀␀\İ␀␀␀]İ␀␀	
␀␀0;1_İ␀␀		SENIOR;0Ü␀␀TRIGGER R090PNG_EI BEFORE INSERT ON R090PNG FOR EACH ROW
DECLARE
  l_conhom VARCHAR2(1);
  l_IDTPES VARCHAR(23);
BEGIN
  BEGIN
      SELECT CONHOM INTO l_conhom FROM R090DPN;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN l_conhom := 'N';
      WHEN OTHERS THEN RAISERROR 103 'Erro no SELECT R090DPN';
  END;

  IF (:NEW.PERENT = 'N') OR (l_conhom = 'S' AND (:NEW.PERENT = 'P' OR :NEW.PERENT = 'R') AND :NEW.PERHOM = 'N') THEN
    SP_PEND84('2', :NEW.TIPDOC, :NEW.NUMDOC, :NEW.SEGTDO, :NEW.SEGDOC, :NEW.NOMPNG, :NEW.PERENT, :NEW.PERHOM);
  END IF;

  IF (:NEW.PERENT = 'N') THEN
    SP_RETIDTPES(NULL, 4, NULL, :NEW.TIPDOC, :NEW.NUMDOC, NULL, NULL, l_IDTPES OUT);
    SP_SAM_PENDENCIES(26, 1, l_IDTPES);
  END IF;
END␀`İ␀␀		SENIOR;0␀␀

TRIGGER R090PNG_EU AFTER UPDATE ON R090PNG FOR EACH ROW
DECLARE
  l_conhom VARCHAR2(1);
  l_IDTPES VARCHAR(23);
BEGIN
  IF (:NEW.TIPDOC <> :OLD.TIPDOC) OR (:NEW.NUMDOC <> :OLD.NUMDOC) OR (:NEW.SEGTDO <> :OLD.SEGTDO) OR (:NEW.SEGDOC <> :OLD.SEGDOC) OR (:NEW.NOMPNG <> :OLD.NOMPNG) OR (:NEW.PERENT <> :OLD.PERENT) OR (:NEW.PERHOM <> :OLD.PERHOM) THEN
    BEGIN
      SELECT CONHOM INTO l_conhom FROM R090DPN;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN l_conhom := 'N';
      WHEN OTHERS THEN RAISERROR 103 'Erro no SELECT R090DPN';
    END;

    IF (:NEW.PERENT = 'N') OR (l_conhom = 'S' AND (:NEW.PERENT = 'P' OR :NEW.PERENT = 'R') AND :NEW.PERHOM = 'N') THEN
      SP_PEND84('2', :NEW.TIPDOC, :NEW.NUMDOC, :NEW.SEGTDO, :NEW.SEGDOC, :NEW.NOMPNG, :NEW.PERENT, :NEW.PERHOM);
    ELSIF (l_conhom='S' AND :OLD.PERENT<>'N' AND (:OLD.PERHOM='R' OR :OLD.PERHOM='P') AND :NEW.PERHOM='N') THEN
      SP_PEND84('2',:NEW.TIPDOC,:NEW.NUMDOC,:NEW.SEGTDO,:NEW.SEGDOC,:NEW.NOMPNG,:NEW.PERENT,:NEW.PERHOM);
    ELSIF ((:OLD.PERENT = 'N') AND (:NEW.PERENT <> 'N')) AND (l_conhom = 'N' OR (l_conhom = 'S' AND (:NEW.PERHOM='R' OR :NEW.PERHOM='P'))) THEN
      SP_PEND84('3',:OLD.TIPDOC,:OLD.NUMDOC,:OLD.SEGTDO,:OLD.SEGDOC,:OLD.NOMPNG,:OLD.PERENT,:OLD.PERHOM);
    END IF;
    
    SP_RETIDTPES(NULL, 4, NULL, :NEW.TIPDOC, :NEW.NUMDOC, NULL, NULL, l_IDTPES OUT);
    SP_SAM_PENDENCIES(26, 2, l_IDTPES);
  END IF;
END␀^İ␀␀		SENIOR;0ì␀␀

TRIGGER R090PNG_ED AFTER DELETE ON R090PNG FOR EACH ROW 
DECLARE
  l_conhom VARCHAR2(1);
  l_IDTPES VARCHAR(23);
BEGIN
  BEGIN
    SELECT 
      R090DPN.CONHOM CONHOM
       INTO l_conhom 
       FROM R090DPN R090DPN;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_conhom := 'N';
    WHEN OTHERS THEN
      RAISERROR 103 'Erro no SELECT R090DPN';
  END;
  IF (:OLD.PERENT='N') 
      OR (:OLD.PERHOM='N' 
      AND l_conhom='S') THEN
    SP_PEND84('3',:OLD.TIPDOC,:OLD.NUMDOC,:OLD.SEGTDO,:OLD.SEGDOC,:OLD.NOMPNG,:OLD.PERENT,:OLD.PERHOM);
  END IF;

  IF (:OLD.PERENT = 'N') THEN
    SP_RETIDTPES(NULL, 4, NULL, :OLD.TIPDOC, :OLD.NUMDOC, NULL, NULL, l_IDTPES OUT);
