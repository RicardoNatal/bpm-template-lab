PROCEDURE SP_PENDADE_CREVEI(P_TIPOPE CHAR, P_PLAVEI VARCHAR2(10), P_DATINI DATE, P_HORINI NUMBER, P_PROORI VARCHAR2(36))
  IS
BEGIN
  NULL;
END		SENIOR;20SP_PENDADE02
c␀␀PROCEDURE SP_PENDADE_CREVEI(P_TIPOPE CHAR, P_PLAVEI VARCHAR2(10), P_DATINI DATE, P_HORINI NUMBER, P_PROORI VARCHAR2(36))
  IS

    l_codpen NUMBER(18);

    CURSOR C_RECINTOS IS
      SELECT F.CODREC, F.VERPLF, F.CODPLF FROM R058PLF F, R151PLF L
       WHERE F.VERPLF = L.VERPLF AND F.CODPLF = L.CODPLF AND
             L.CODLEG IN (SELECT G.CODLEG FROM R151LEG G WHERE G.TIPLEG = 3);

    TYPE T_RECINTO IS RECORD (
      CODREC   R058PLF.CODREC%TYPE,
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE);

    l_recinto T_RECINTO;

BEGIN
    /* Verifica se possui um recinto alfandegado com auditoria de registros alfandegados. 
     * Obs.: Insiro pendência para todos os recintos da base. */
    FOREACH C_RECINTOS INTO l_recinto.CODREC,
                            l_recinto.VERPLF,
                            l_recinto.CODPLF
    LOOP
        /* Gerar pendência ADE02, 3 - Credenciamento de Veículo */
        SP_PENDADE02(3, P_TIPOPE, l_recinto.VERPLF, l_recinto.CODPLF, l_recinto.CODREC, l_codpen OUT);

        BEGIN
            INSERT INTO R152CRV (CODPEN, PLAVEI, DATINI, HORINI, PROORI)
                 VALUES (l_codpen, P_PLAVEI, P_DATINI, P_HORINI, P_PROORI);
        EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'SP_PENDADE_CREVEI: Erro ao inserir pendência de credenciamento de veículo';
        END;
    END LOOP;
END		SENIOR;21SP_PENDADE02
