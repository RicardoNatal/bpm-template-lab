u
␀␀PROCEDURE SP_EXECCONTPLANTA(P_TIPOPE CHAR(1),P_ICARD CHAR(12),P_PLTSTR CHAR(5),P_DATSTR CHAR(10))
 IS

  l_comando   VARCHAR(2048);
  l_craauxstr CHAR(12);
  l_usutel    VARCHAR(31);
  l_ediplt    CHAR(5);
  l_pltstr    CHAR(5);
  l_pltstrOLD CHAR(3);
  l_icard_num NUMBER(12);
  l_icardA    VARCHAR2(12);
  l_icardR    VARCHAR2(12);
  l_numser    VARCHAR2(12);
  l_retnumberaux NUMBER(1);
  l_reterr       NUMBER(1);
  l_qtdreg    NUMBER;
BEGIN
  SP_USUTEL(l_usutel OUT);

  /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
  l_icard_num := CONVERT(CHAR_TO_NUMBER, p_icard);
  SP_RETICARD(NULL, l_icard_num, l_icardA OUT, l_icardR OUT, l_numser OUT);

  l_craauxstr := l_icardA;

  IF(p_tipope='I') THEN
      l_comando := 'SELECT COUNT(ICARD) FROM '||l_usutel||'CONTPLANTA WHERE ICARD='''||l_craauxstr||'''';
      SP_SELTSI(0, 'l_qtdreg', l_comando, l_qtdreg OUT, l_retnumberaux OUT,  l_reterr OUT);
      IF (l_reterr = 1) OR (l_reterr = 2) THEN
          /*EXCEÇÃO: NO DATA FOUND*/
          l_qtdreg := 0;
      END IF;
      IF (l_qtdreg >= 1) THEN 
          SP_EXECCONTPLANTA('D', P_ICARD, P_PLTSTR, P_DATSTR);
      END IF;
  END IF;

  /* Verifica tamanho do campo na base. Tem versão com 5 dígitos e com 3 dígitos */
  BEGIN
      SELECT EDIPLT INTO l_ediplt FROM R000ASS;
  EXCEPTION
      WHEN OTHERS THEN l_ediplt:= '999';
  END;
  IF (l_ediplt = '99999') THEN
      SP_INTSTR(p_pltstr,'99999',l_pltstr OUT);
 	  /*INSERIR NA CONTPLANTA*/
	  IF (p_tipope = 'I') THEN
	      l_comando := 'INSERT INTO '||l_usutel||'CONTPLANTA(ICARD,PLANTACESSO,DATAHORA) ';
	      l_comando := l_comando || ' VALUES ('''||l_craauxstr||''','''||l_pltstr||''','''||p_datstr||''') ';
	      SP_CMDTSI(l_comando);
	  END IF;

	  /*DELETAR DA CONTPLANTA*/
	  IF (p_tipope = 'D') THEN
	      l_comando := 'DELETE FROM '||l_usutel||'CONTPLANTA WHERE ICARD='''||l_craauxstr||''' AND PLANTACESSO='''||l_pltstr||'''';
	      SP_CMDTSI(l_comando);
	  END IF;
  ELSE
      SP_INTSTR(p_pltstr,'999',l_pltstrOLD OUT);
  	  /*INSERIR NA CONTPLANTA*/
	  IF (p_tipope = 'I') THEN
	      l_comando := 'INSERT INTO '||l_usutel||'CONTPLANTA(ICARD,PLANTACESSO,DATAHORA) ';
	      l_comando := l_comando || ' VALUES ('''||l_craauxstr||''','''||l_pltstrOLD||''','''||p_datstr||''') ';
	      SP_CMDTSI(l_comando);
	  END IF;

	  /*DELETAR DA CONTPLANTA*/
	  IF (p_tipope = 'D') THEN
	      l_comando := 'DELETE FROM '||l_usutel||'CONTPLANTA WHERE ICARD='''||l_craauxstr||''' AND PLANTACESSO='''||l_pltstrOLD||'''';
	      SP_CMDTSI(l_comando);
	  END IF;
  END IF;
END		SENIOR;239SP_USUTEL
