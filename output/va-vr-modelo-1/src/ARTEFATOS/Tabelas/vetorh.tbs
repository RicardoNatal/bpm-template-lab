									:OLD.ADIPOS,:OLD.USAHAG,:OLD.DATHAG,:OLD.FTOPIS);

		  SP_AUDGENREG(l_seqreg,l_verseq,'R030EMP','DELETE');
	  EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro gerar registro para auditoria. ';
	  END;
	END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

        SP_VerOnLine(l_online OUT);
        IF (l_online = TRUE) THEN
          R030EMP_ATUCON(3, :OLD.NUMEMP, :OLD.NOMEMP);
        END IF;
