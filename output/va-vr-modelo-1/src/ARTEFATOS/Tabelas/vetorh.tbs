         SP_INTSTR(l_r069FIS_aux.NUMFIS, '999999999999', l_numfis_str OUT);
         SP_DATSTR(l_r069FIS_aux.DATFIM, 'DDMMYYYY', l_datfim_str OUT);
         SP_INTSTR(l_r069FIS_aux.HORFIM, '9999', l_horfim_str OUT);
         l_idregister := l_usocra_str||l_numcra_str||l_teccra_str||l_numfis_str||l_datfim_str||l_horfim_str;
         SP_SAM_PENDENCIES(38, 3, l_idregister);
     END IF;
  END LOOP;
 /* Apaga Registro OLD em R069FIS_AUX */
  BEGIN
    DELETE FROM R069FIS_AUX WHERE TIPOPE = 'D';
    DROP_TEMP_TABLE R069FIS_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀2Ù␀␀		SENIOR;0Q␀␀

TRIGGER R069FIS_ED AFTER DELETE ON R069FIS FOR EACH ROW
DECLARE
  /* Tabela temporária */
  CREATE_TEMP_TABLE R069FIS_AUX;
BEGIN
  INSERT INTO R069FIS_AUX (TIPOPE,NUMCRA,DATALT,HORINI,NUMFIS,TECCRA,DATFIM,HORFIM)
            VALUES ('D',:OLD.NUMCRA,:OLD.DATALT,:OLD.HORINI,:OLD.NUMFIS,:OLD.TECCRA,:OLD.DATFIM,:OLD.HORFIM);
