DECLARE
	l_Valor	VARCHAR(1000);		
	xCodSin   R014ASS.CODSIN%TYPE;
	l_ValorVARCHAR 	VARCHAR2(20);
BEGIN	
	xCodSin := :NEW.CODSIN;
	SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_ValorVARCHAR OUT);
	l_Valor := 'Incluído o Assinalamento na data de referência ' || l_ValorVARCHAR || ' para o Sindicato ' || CONVERT(NUMBER_TO_CHAR, xCodSin) || '.';
	SP_GRAVALPR(214, l_Valor);
END␀õÏ␀␀		SENIOR;0É␀␀

TRIGGER R014ASS_EU AFTER UPDATE ON R014ASS FOR EACH ROW
DECLARE
	l_Valor			VARCHAR(1000);
    l_ValorAux	    VARCHAR(1000);	
	l_ValorVARCHAR 	VARCHAR2(20);
BEGIN
	IF  (:NEW.DESVTR <> :OLD.DESVTR) THEN
  		SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_ValorVARCHAR OUT);
 		
		l_ValorAux := 'Foram alteradas as definições do Assinalamento na data de referência ' || l_ValorVARCHAR || ' do Sindicato ' || CONVERT(NUMBER_TO_CHAR, :NEW.CODSIN) || '.';
		
		l_Valor := l_ValorAux || ' - Campo: % de Desconto Vale Transporte. Valor Anterior: ' || CONVERT(NUMBER_TO_CHAR, :OLD.DESVTR) || ', Valor Novo: ' || CONVERT(NUMBER_TO_CHAR, :NEW.DESVTR) || '.';
		SP_GRAVALPR(214, l_Valor);				
	END IF;
	
	IF  (:NEW.PDVPSI <> :OLD.PDVPSI) THEN
  		SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_ValorVARCHAR OUT);
 		
		l_ValorAux := 'Foram alteradas as definições do Assinalamento na data de referência ' || l_ValorVARCHAR || ' do Sindicato ' || CONVERT(NUMBER_TO_CHAR, :NEW.CODSIN) || '.';
		
		l_Valor := l_ValorAux || ' - Campo: Usa % de Desconto Vale Transporte por Sindicato. Valor Anterior: ' || CONVERT(NUMBER_TO_CHAR, :OLD.PDVPSI) || ', Valor Novo: ' || CONVERT(NUMBER_TO_CHAR, :NEW.PDVPSI) || '.';
		SP_GRAVALPR(214, l_Valor);				
	END IF;
END␀óÏ␀␀		SENIOR;0¥␀␀

TRIGGER R014ASS_ED AFTER DELETE ON R014ASS FOR EACH ROW
DECLARE
	l_Valor	VARCHAR(1000);	
	xCodSin   R014ASS.CODSIN%TYPE;
	l_ValorVARCHAR 	VARCHAR2(20);
BEGIN
	xCodSin := :OLD.CODSIN;
	SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_ValorVARCHAR OUT);
  	l_Valor := 'Excluído o Assinalamento na data de referência ' || l_ValorVARCHAR || ' do Sindicato ' || CONVERT(NUMBER_TO_CHAR, xCodSin) || '.';
	SP_GRAVALPR(214, l_Valor);
END␀␀␀„␀␀␀␀␀␀␀␀öÏ␀␀“-´␀	Ôÿ!␀␀␀␀␀UA‚␀‚␀r"‡␀Æÿ␀␀+Ğ␀␀␀mDÑ␀	Ôÿ!␀␀␀␀␀DIşEşEqCˆ␀êÿ␀␀øÏ␀␀␀p4Ôÿ!␀␀␀␀␀	:	:	:n␀Æÿ␀␀ÿ␀[±␀Ôÿ!␀␀␀␀␀	\\	\q␀Æÿ␀␀ÿ␀À[±␀Ôÿ!␀␀␀␀␀\\\q␀Æÿ␀␀ÿ␀­␀Ôÿ!␀␀␀␀␀
