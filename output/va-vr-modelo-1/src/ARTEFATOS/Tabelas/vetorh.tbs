           UPDATE R070CON SET PESBLO = l_pesBlo, DESBLO = l_desblo WHERE NUMFIS = l_crapri;
       EXCEPTION
           WHEN OTHERS THEN NULL;
       END;

       /* atualiza r070con */
       l_sitAux := CONVERT(CHAR_TO_NUMBER,l_situa);
       IF  (l_blofal = p_codmot) THEN
           BEGIN
               UPDATE R070CON SET BLOFAL = l_SitAux WHERE NUMFIS = l_crapri;
           EXCEPTION
               WHEN OTHERS THEN NULL;
           END;
           /*Atualiza os demais crachás na R070CON*/
           SP_UPDFAL(l_cracha,l_sitAux);
       ELSE
           /*Se alterar o Situa, altera para os demais crachás.*/
           /*UPDATE na R070CON.SITCRA*/
           SP_UPDFIS(l_cracha,l_SitAux,' ');
       END IF;
  END IF;
END		SENIOR;24,SP_RETCRA
SP_MAPFIS
SP_UPDFAL
SP_UPDFIS
␀␀PROCEDURE R070BLO_ATUCON(P_TIPOPE CHAR,P_NUMEMP NUMBER,P_TIPCOL INTEGER,P_NUMCAD NUMBER,P_CODMOT NUMBER)
 IS

l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_crastr       CHAR(12);
  l_craaux       NUMBER(12);  
  l_comando_nulo BOOLEAN;
  l_situa        CHAR(1);
  l_sequencia    NUMBER;
  l_blofal       NUMBER(2);
  l_SitAux       NUMBER(2);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_pesBlo       NUMBER(1);
  l_desBlo       VARCHAR2(30);
BEGIN

  l_pesBlo := 0;
  l_desBlo := '';

  /* Se tiver crachá provísório vale ele. senão pegar o titular */
  SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_crapro OUT);
  IF  (l_crapro = 0)  THEN
      SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
  ELSE
      l_cracha := l_crapro;
  END IF;

  /* Verifica se Colaborador possui Cracha */
  IF   l_cracha <> 0  THEN

       /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
       SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
       IF (l_crapri = 0) THEN
           l_crapri := l_cracha;
       END IF;

       /* Verifica motivo */
       BEGIN
           SELECT 1, DESMOT INTO l_pesBlo, l_desblo FROM R070MBL;
       EXCEPTION
           WHEN OTHERS THEN l_desblo := '';
       END;


       /* Verifica se eh bloqueio por Falta */
       BEGIN
           SELECT MOTBLO INTO l_blofal FROM R070DAC;
       EXCEPTION
           WHEN OTHERS THEN l_blofal := 0;
       END;

       IF  (p_tipope = 'I') THEN
           l_situa := '1';
           /* Verifica motivo */
           BEGIN
               SELECT 1, DESMOT INTO l_pesBlo, l_desblo FROM R070MBL WHERE CODMOT = p_codmot;
           EXCEPTION
               WHEN OTHERS THEN l_pesBlo := 0; l_desblo := '';
           END;
       ELSE
           l_situa  := '0';
           l_pesBlo := 0;
           l_desblo := '';
       END IF;

       BEGIN
           UPDATE R070CON SET PESBLO = l_pesBlo, DESBLO = l_desblo WHERE NUMFIS = l_crapri;
       EXCEPTION
           WHEN OTHERS THEN NULL;
       END;

       /* atualiza r070con */
       l_sitAux := CONVERT(CHAR_TO_NUMBER,l_situa);
       IF  (l_blofal = p_codmot) THEN
           BEGIN
               UPDATE R070CON SET BLOFAL = l_SitAux WHERE NUMFIS = l_crapri;
           EXCEPTION
               WHEN OTHERS THEN NULL;
           END;
           /*Atualiza os demais crachás na R070CON*/
           SP_UPDFAL(l_cracha,l_sitAux);
       ELSE
           /*Se alterar o Situa, altera para os demais crachás.*/
           /*UPDATE na R070CON.SITCRA*/
           SP_UPDFIS(l_cracha,l_SitAux,' ');
       END IF;
  END IF;
END␀ˆÙ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
