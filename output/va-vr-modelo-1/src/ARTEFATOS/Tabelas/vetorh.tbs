PROCEDURE R034CPL_ATUCON(P_TIPOPE CHAR,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_DDIFON NUMBER(3),P_DDDFON NUMBER(3),P_NUMFON VARCHAR2(20))
 IS

l_idtpes     VARCHAR2(23);
  l_tipcol_str CHAR(1);
  l_tippes_str CHAR(2);
  l_numemp_str CHAR(4);
  l_numcad_str CHAR(9);
  l_nompes     VARCHAR2(40);
  l_ddifon     NUMBER(3);
  l_dddfon     NUMBER(3);
  l_numfon     VARCHAR2(20);
  l_datatu       CHAR(16);
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_DatAtuStr    CHAR(6);
  l_HorAtuStr    CHAR(4);
  l_seqatu       NUMBER(2);
  l_seqstr       CHAR(2);

BEGIN
  l_nompes := '';
  l_ddifon := 0;
  l_dddfon := 0;
  l_numfon := '';

  /* monta idtpes*/
  SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
  SP_INTSTR(p_numemp,'9999',l_numemp_str OUT);
  SP_INTSTR(p_tipcol,'9',l_tipcol_str OUT);
  SP_INTSTR(p_numcad,'999999999',l_numcad_str OUT);
  l_idtpes:= l_tippes_str||l_numemp_str||l_tipcol_str||l_numcad_str;

  /*Preenche o campo com espaços para completar 23 posições*/
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
     /*Controle do Loop.*/
     IF (Length(l_idtpes) > 22) THEN
         EXIT;
     END IF;
     l_idtpes := ' '||l_idtpes;
  END LOOP;

  /* converte a data atual para verificar se existe crachá válido na r070con */
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();

  /* data atual no formato string (r070con) */
  SP_DATSTR(l_data_atual,'DDMMYY',l_datatustr OUT);
  SP_INTSTR(l_hora_atual,'HHMM',l_horatustr OUT);
  l_seqatu := SECOND(CURTIME());
  SP_INTSTR(l_seqatu, '99', l_seqstr OUT);
  l_datatu := l_datAtuStr||l_horAtuStr||l_seqstr||'0000';

  /* YYMMDDHHMMSEQ0000 */
  l_datatu := SUBSTRING(l_datatu,5,2)||SUBSTRING(l_datatu,3,2)||SUBSTRING(l_datatu,1,2)||SUBSTRING(l_datatu,7,10);

  IF (p_tipOpe = 'D') THEN
      /* se operação for DELETE, limpa dados da R070CON */
      l_nompes := '';
      l_ddifon := 0;
      l_dddfon := 0;
      l_numfon := '';
  ELSE
      /* verifica o nome da pessoa */
      BEGIN
          SELECT NOMFUN INTO l_nompes FROM R034FUN
           WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;

      EXCEPTION
          WHEN OTHERS THEN l_nompes := '';
      END;
      l_ddifon := p_ddifon;
      l_dddfon := p_dddfon;
      l_numfon := p_numfon;
  END IF;

  /* Atualiza R070CON */
  BEGIN
      UPDATE R070CON SET NOMPES = l_nompes, DDIFON = l_ddifon,
                         DDDFON = l_dddfon, NUMFON = l_numfon WHERE IDTPES = l_idtpes AND CHCPRI=0 AND
                         ( SUBSTRING(DATVAL,5,2)
                           ||SUBSTRING(DATVAL,3,2)
                           ||SUBSTRING(DATVAL,1,2)
                           ||SUBSTRING(DATVAL,7,10) > l_datatu
                           OR DATVAL = '3112502359000000');
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R034CPL. Erro ao atualizar tabela R070CON.';
  END;
END		SENIOR;21SP_INTSTR
SP_DATSTR
