  /* Autorização de Saída */
  FOREACH c_r073asa INTO l_r073asa.datasa,
                         l_r073asa.horasa,
                         l_r073asa.horter
  LOOP
      SP_INTSTR(l_r073asa.horasa,'HHMM',l_striac OUT);
      SP_INTSTR(l_r073asa.horter,'HHMM',l_strfac OUT);
      SP_INTSTR(l_r073asa.horasa,'HHMM',l_stript OUT);
      SP_INTSTR(l_r073asa.horter,'HHMM',l_strfpt OUT);

      l_dia_semana := DAYOFWEEK(l_r073asa.datasa);
      IF    l_dia_semana = 1 THEN /* domingo */
            IF  ((LENGTH(l_faidom_ace)) < 49) OR ((LENGTH(l_faidom_ace) IS NULL)) THEN
                l_faidom_ace := l_faidom_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faidom_pto)) < 49) OR ((LENGTH(l_faidom_pto) IS NULL)) THEN
                l_faidom_pto := l_faidom_pto || l_stript || l_strfpt;
            END IF;
      ELSIF l_dia_semana = 2 THEN /* segunda */
            IF  ((LENGTH(l_faiseg_ace)) < 49) OR ((LENGTH(l_faiseg_ace) IS NULL)) THEN
                l_faiseg_ace := l_faiseg_ace || l_striac || l_strfac;
            END IF;
            IF  ((LENGTH(l_faiseg_pto)) < 49) OR ((LENGTH(l_faiseg_pto) IS NULL)) THEN
                l_faiseg_pto := l_faiseg_pto || l_stript || l_strfpt;
            END IF;
      ELSIF l_dia_semana = 3 THEN /* terca */
