TRIGGER R073ALU_EI AFTER INSERT ON R073ALU FOR EACH ROW
DECLARE
  l_IDTPES   VARCHAR(23);
BEGIN
  SP_RETIDTPES(NULL, 6, NULL, NULL, NULL, :NEW.NUMMAT, NULL, l_IDTPES OUT);
  SP_SAM_PENDENCIES(9, 1, l_IDTPES);  
END␀°Ú␀␀		SENIOR;0©	␀␀TRIGGER R073ALU_EU AFTER UPDATE ON R073ALU FOR EACH ROW
DECLARE
  l_altinfonl    BOOLEAN;
  l_online       BOOLEAN;
  l_tipdoc       NUMBER(1);
  l_numdoc   VARCHAR2(20);
  l_nompes   VARCHAR2(40);
  l_IDTPES   VARCHAR(23);
BEGIN
  SP_VerOnLine(l_online OUT);

  l_altinfonl := FALSE;
  IF   (:NEW.CODPRM <> :OLD.CODPRM) OR
       (:NEW.PRMSAB <> :OLD.PRMSAB) OR
       (:NEW.PRMDOM <> :OLD.PRMDOM) OR
       (:NEW.PRMFER <> :OLD.PRMFER) OR
       (:NEW.CONTPM <> :OLD.CONTPM) OR
       (:NEW.CONREE <> :OLD.CONREE) OR
       (:NEW.USABIO <> :OLD.USABIO) OR
       (:NEW.GRACON <> :OLD.GRACON) OR
       (:NEW.CONADP <> :OLD.CONADP) OR
       (:NEW.NOMALU <> :OLD.NOMALU) OR
       (:NEW.DDDTEL <> :OLD.DDDTEL) OR
       (:NEW.DDITEL <> :OLD.DDITEL) OR
       (:NEW.NUMTEL <> :OLD.NUMTEL) OR
       (:NEW.NUMCPF <> :OLD.NUMCPF) OR
       (:NEW.NUMDOC <> :OLD.NUMDOC) OR
       (:NEW.CONREE <> :OLD.CONREE) OR
       (:NEW.USARFA <> :OLD.USARFA) THEN
       l_altinfonl := TRUE;
  END IF;

  IF  (l_altinfonl = TRUE) AND (l_online = TRUE) THEN

      /* Envia o valor do documento */
      l_tipdoc := 0;
      l_numdoc := '';
      IF  (:NEW.NUMCPF > 0) THEN
          l_tipdoc := 2;
          l_numdoc := CONVERT(NUMBER_TO_CHAR,:NEW.NUMCPF);
      ELSE
          IF ((:NEW.NUMDOC IS NOT NULL) AND
              (:NEW.NUMDOC <> ' ')) THEN
              l_tipdoc := 1;
              l_numdoc := :NEW.NUMDOC;
          END IF;

      END IF;
	  
      l_nompes := SUBSTRING(:NEW.NOMALU,1,40);

      R073ALU_ATUCON (:NEW.NUMMAT,
                      :NEW.CODPRM,
                      :NEW.PRMSAB,
                      :NEW.PRMDOM,
                      :NEW.PRMFER,
                      :NEW.CONTPM,
                      :NEW.USABIO,
                      :NEW.GRACON,
                      :NEW.CONADP,
                      l_nompes,
                      :NEW.DDITEL,
                      :NEW.DDDTEL,
                      :NEW.NUMTEL,
                      l_tipdoc,
                      l_numdoc,
                      :NEW.CONREE,
                      :NEW.USARFA);
  END IF;

  SP_RETIDTPES(NULL, 6, NULL, NULL, NULL, :NEW.NUMMAT, NULL, l_IDTPES OUT);
  SP_SAM_PENDENCIES(9, 2, l_IDTPES);
  
  /* ATUALIZAÇÃO DO NOME NA TABELA R158PES */
  IF (:NEW.NOMALU <> :OLD.NOMALU) THEN
      l_nompes := SUBSTRING(:NEW.NOMALU, 1, 40);
      SP_ATUNOMPES(l_IDTPES, l_nompes);
