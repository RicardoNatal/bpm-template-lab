END␀dø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
^PROCEDURE SP_MILLISECOND(P_SEGUNDOS OUT NUMBER,P_PRECISAO NUMBER(1))
 IS
BEGIN
  NULL;
END	ORACLE;0
àCREATE OR REPLACE PROCEDURE SP_MILLISECOND
(
  p_Segundos OUT NUMBER,
  p_Precisao IN NUMBER
)
IS
BEGIN
  SELECT TO_NUMBER(SUBSTRB(TO_CHAR(SYSTIMESTAMP, 'FF'), 1, p_Precisao)) INTO p_Segundos
    FROM DUAL;
END;

	MSSQL;0
àCREATE PROCEDURE SP_MILLISECOND
(
  @p_Segundos INTEGER OUTPUT,
  @p_Presicao INT
)
AS
BEGIN
  SELECT @p_Segundos = CONVERT(INT, SUBSTRING(CONVERT(VARCHAR, DATEPART(MILLISECOND, GETDATE())), 1, @p_Presicao));
END

	POSTGRESQL;0
:␀␀CREATE OR REPLACE PROCEDURE SP_MILLISECOND(p_Segundos IN OUT NUMERIC, p_Precisao SMALLINT)
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN
  SELECT CAST (substring(CAST (extract(MILLISECONDS FROM TIMEOFDAY()::timestamp without time zone)*1000 AS varchar) from 3 for p_Precisao) AS INTEGER) INTO p_Segundos;
END;
$BODY$;
␀eø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
¡␀␀PROCEDURE SP_MOCKEDPIS(P_MOCKEDPIS VARCHAR2(12), P_PIS OUT NUMBER(11), P_CPF OUT NUMBER(11), P_CODERR OUT VARCHAR2(1))
 IS

  l_chrmok VARCHAR2(1);
  l_tammok INTEGER;
  l_pis NUMBER(11);
  l_cpf NUMBER(11);
  l_aux VARCHAR2(11);
  l_rev VARCHAR2(11);
  l_posatu INTEGER;
  l_sum INTEGER;
  l_multip INTEGER;
  l_chrcpf VARCHAR2(1);
  l_chrcpf_int INTEGER;
  l_result INTEGER;
  l_coderr VARCHAR2(1);

BEGIN
  l_pis := 0;
  l_cpf := 0;
  l_coderr := '0';
  l_tammok := LENGTH(p_mockedpis);

  IF (l_tammok = 12) THEN
    l_chrmok := SUBSTRING(p_mockedpis, 1, 1);

    IF (l_chrmok = '9') THEN
      /* CPF pronto */
      l_aux := SUBSTRING(p_mockedpis, 2, 11);
      l_cpf := CONVERT(CHAR_TO_NUMBER, l_aux);
    ELSE
      IF (l_chrmok = '8') THEN
        /* Fake PIS - Extrai o CPF cfme. portaria 671, Art. 96*/
        l_aux := SUBSTRING(p_mockedpis, 2, 10);

        l_rev := '';
        FOR l_posatu IN 1..10 LOOP
          l_rev := SUBSTRING(l_aux, l_posatu, 1) || l_rev;
        END LOOP;

        l_sum := 0;
        l_multip := 2;
        FOR l_posatu IN 1..10 LOOP
          l_chrcpf := SUBSTRING(l_rev, l_posatu, 1);
          l_chrcpf_int := CONVERT(CHAR_TO_NUMBER, l_chrcpf);
          l_sum := l_sum + (l_chrcpf_int * l_multip);
          l_multip := l_multip + 1;
        END LOOP;

        l_result := 11 - (MOD(l_sum, 11));
        IF (l_result > 9) THEN
          l_result := 0;
        END IF;

        l_aux := l_aux || CONVERT(NUMBER_TO_CHAR, l_result);
        l_cpf := CONVERT(CHAR_TO_NUMBER, l_aux);
      ELSE
        IF (l_chrmok = '0') THEN
          /* PIS pronto */
          l_aux := SUBSTRING(p_mockedpis, 2, 11);
          l_pis := CONVERT(CHAR_TO_NUMBER, l_aux);
        ELSE
          l_coderr := '3';
        END IF;
      END IF;
    END IF;
  ELSE
    l_coderr := '4';
  END IF;

  p_pis := l_pis;
  p_cpf := l_cpf;
  p_coderr := l_coderr;
END␀fø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
uPROCEDURE SP_NORMALIZA_DES(P_DESIN IN VARCHAR2(8000), P_DESOUT OUT VARCHAR2(8000))
 IS
BEGIN
	P_DESOUT := '';
END	ORACLE;0
ÈCREATE OR REPLACE PROCEDURE SP_NORMALIZA_DES(P_DESIN IN VARCHAR2, P_DESOUT OUT VARCHAR2) 
 AS
BEGIN
  P_DESOUT := NVL(REPLACE (REPLACE(RTRIM(LTRIM(P_DESIN)), CHR(13), ''), CHR(10), ''), ' ');
END;	MSSQL;0
ÊCREATE  PROCEDURE SP_NORMALIZA_DES(@P_DESIN VARCHAR(8000), @P_DESOUT VARCHAR(8000) OUTPUT) 
 AS
BEGIN
  SELECT @P_DESOUT = REPLACE (REPLACE (RTRIM(LTRIM(@P_DESIN)), CHAR(13), ''), CHAR(10), '');
END	POSTGRESQL;0
îCREATE OR REPLACE PROCEDURE SP_NORMALIZA_DES(P_DESIN VARCHAR, P_DESOUT IN OUT VARCHAR) 
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN
  P_DESOUT := COALESCE(REPLACE (REPLACE(RTRIM(LTRIM(P_DESIN)), CHR(13), ''), CHR(10), ''), ' ');
END;
$BODY$;␀gø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
