/* INSERT (NEW) */
TRIGGER R026INF_EI AFTER INSERT ON R026INF FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs R026INF - PREVIDÊNCIA - FAIXAS INSS*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 39;     /* R026INF - PREVIDÊNCIA - FAIXAS INSS*/
  l_codtpa := 189;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R026INF_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        SP_DATSTR(:NEW.PERREF, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERREF', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFAI', CONVERT(NUMBER_TO_CHAR, :NEW.CODFAI));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R026INF_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TETFAI', CONVERT(NUMBER_TO_CHAR, :NEW.TETFAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERFAI', CONVERT(NUMBER_TO_CHAR, :NEW.PERFAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PARDED', CONVERT(NUMBER_TO_CHAR, :NEW.PARDED));
      END;
  END IF; 
END␀wÑ␀␀	SENIOR;0L

TRIGGER R026INF_SU AFTER UPDATE ON R026INF

BEGIN
RH_250ALT(46);
END␀tÑ␀␀		SENIOR;0·␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R026INF_EU AFTER UPDATE ON R026INF FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs R026INF - PREVIDÊNCIA - FAIXAS INSS*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 39;     /* R026INF - PREVIDÊNCIA - FAIXAS INSS*/
  l_codtpa := 190;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.PerRef <> :NEW.PerRef)
   OR (:OLD.CodFai <> :NEW.CodFai)
   OR (:OLD.TetFai <> :NEW.TetFai)
   OR (:OLD.PerFai <> :NEW.PerFai)
   OR (:OLD.ParDed <> :NEW.ParDed)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R026INF_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        SP_DATSTR(:OLD.PERREF, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERREF', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFAI', CONVERT(NUMBER_TO_CHAR, :OLD.CODFAI));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R026INF_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTETFAI', CONVERT(NUMBER_TO_CHAR, :OLD.TETFAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTETFAI', CONVERT(NUMBER_TO_CHAR, :NEW.TETFAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERFAI', CONVERT(NUMBER_TO_CHAR, :OLD.PERFAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERFAI', CONVERT(NUMBER_TO_CHAR, :NEW.PERFAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPARDED', CONVERT(NUMBER_TO_CHAR, :OLD.PARDED));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPARDED', CONVERT(NUMBER_TO_CHAR, :NEW.PARDED));
      END;
    END IF; 
  END IF; 
END␀uÑ␀␀	SENIOR;0L

