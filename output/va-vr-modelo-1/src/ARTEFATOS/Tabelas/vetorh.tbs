TRIGGER R070BLC_EU AFTER UPDATE ON R070BLC FOR EACH ROW

DECLARE
l_online       BOOLEAN;
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       IF   (:NEW.DATLIB <> :OLD.DATLIB) OR
            (:NEW.STAACC <> :OLD.STAACC) THEN
            IF (:NEW.STAACC = 1) THEN
                R070BLC_ATUCON('I',:NEW.NUMCRA,:NEW.CODMOT);
            ELSE
                R070BLC_ATUCON('U',:NEW.NUMCRA,:NEW.CODMOT);
            END IF;
       END IF;
  END IF;
END␀aÙ␀␀		SENIOR;0Ü␀␀

TRIGGER R070BLC_ED AFTER DELETE ON R070BLC FOR EACH ROW

DECLARE
l_online       BOOLEAN;
  l_data_atual   DATE;
  l_data_zero    DATE;
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       l_data_atual := CURDATE();
       l_data_zero  := '31/12/1900,00:00:00';
       IF   (:OLD.DATLIB >= l_data_atual) OR
            (:OLD.DATLIB = l_data_zero) THEN
            R070BLC_ATUCON('E',:OLD.NUMCRA,:OLD.CODMOT);
       END IF;
  END IF;
