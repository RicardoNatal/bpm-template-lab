TRIGGER R048CTB_EI AFTER INSERT ON R048CTB FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  xCodLoc 		   R016HIE.CODLOC%TYPE;
BEGIN

  /* Geração de logs ContabilizacaoNova*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 69;     /* ContabilizacaoNova*/
  l_codtpa := 249;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R048CTB_EI', '');

      BEGIN
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TipCol));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NumCad));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CodFil));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOEM', CONVERT(NUMBER_TO_CHAR, :NEW.CodOem));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQPAG', CONVERT(NUMBER_TO_CHAR, :NEW.SeqPag));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :NEW.TabOrg));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TabEve));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCLC', CONVERT(NUMBER_TO_CHAR, :NEW.CodClc));		
		SP_DATSTR(:NEW.DatLan, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATLAN', l_datTemp);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OPCCTB', CONVERT(NUMBER_TO_CHAR, :NEW.OpcCtb));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAL', CONVERT(NUMBER_TO_CHAR, :NEW.CodCal));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODLOT', CONVERT(NUMBER_TO_CHAR, :NEW.CodLot));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQLOT', CONVERT(NUMBER_TO_CHAR, :NEW.SeqLot));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DEBCRE', :NEW.DebCre);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HISPAD', CONVERT(NUMBER_TO_CHAR, :NEW.HisPad));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CPLHIS', :NEW.CplHis);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NATDES', CONVERT(NUMBER_TO_CHAR, :NEW.NatDes));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONFIN', CONVERT(NUMBER_TO_CHAR, :NEW.ConFin));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODAUX', CONVERT(NUMBER_TO_CHAR, :NEW.CodAux));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONGER', :NEW.ConGer);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERRAT', CONVERT(NUMBER_TO_CHAR, :NEW.PerRat));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFOR', CONVERT(NUMBER_TO_CHAR, :NEW.CodFor));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CLCPDB', CONVERT(NUMBER_TO_CHAR, :NEW.ClcPDb));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMDOC', :NEW.NumDoc);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMCON', :NEW.NomCon);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ORICTB', :NEW.OriCtb);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LOTSAP', CONVERT(NUMBER_TO_CHAR, :NEW.LotSAP));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALLAN', CONVERT(NUMBER_TO_CHAR, :NEW.ValLan));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FILCTB', CONVERT(NUMBER_TO_CHAR, :NEW.FilCtb));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CCURAT', :NEW.CcuRat);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LOCRAT', CONVERT(NUMBER_TO_CHAR, :NEW.LocRat));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRAT', CONVERT(NUMBER_TO_CHAR, :NEW.CodRat));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONDEB', :NEW.ConDeb);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONCRE', :NEW.ConCre);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REDDEB', CONVERT(NUMBER_TO_CHAR, :NEW.RedDeb));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REDCRE', CONVERT(NUMBER_TO_CHAR, :NEW.RedCre));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FILCTP', CONVERT(NUMBER_TO_CHAR, :NEW.FilCtP));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCCU', :NEW.CodCcu);
		RH_RET_CODLOC(:NEW.TABORG,:NEW.NUMLOC,:NEW.DATLAN, xCodLoc OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', xCodLoc);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RATPAD', CONVERT(NUMBER_TO_CHAR, :NEW.RatPad));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONDEP', :NEW.ConDeP);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONCRP', :NEW.ConCrP);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REDDEP', CONVERT(NUMBER_TO_CHAR, :NEW.RedDeP));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REDCRP', CONVERT(NUMBER_TO_CHAR, :NEW.RedCrP));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DEFCON', CONVERT(NUMBER_TO_CHAR, :NEW.DefCon));
      END;
  END IF; 
END␀ÇÖ␀␀		SENIOR;01␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R048CTB_EU AFTER UPDATE ON R048CTB FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  xCodLoc 		   R016HIE.CODLOC%TYPE;
BEGIN

  /* Geração de logs ContabilizacaoNova */ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 69;     /* ContabilizacaoNova*/
  l_codtpa := 250;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.CodFil <> :NEW.CodFil)
   OR (:OLD.CodOem <> :NEW.CodOem)
   OR (:OLD.SeqPag <> :NEW.SeqPag)
   OR (:OLD.TabOrg <> :NEW.TabOrg)
   OR (:OLD.TabEve <> :NEW.TabEve)
   OR (:OLD.CodClc <> :NEW.CodClc)
   OR (:OLD.DatLan <> :NEW.DatLan)
   OR (:OLD.OpcCtb <> :NEW.OpcCtb)
   OR (:OLD.CodCal <> :NEW.CodCal)
   OR (:OLD.CodLot <> :NEW.CodLot)
   OR (:OLD.SeqLot <> :NEW.SeqLot)
   OR (:OLD.DebCre <> :NEW.DebCre)
   OR (:OLD.HisPad <> :NEW.HisPad)
   OR (:OLD.CplHis <> :NEW.CplHis)
   OR (:OLD.NatDes <> :NEW.NatDes)
   OR (:OLD.ConFin <> :NEW.ConFin)
   OR (:OLD.CodAux <> :NEW.CodAux)
   OR (:OLD.ConGer <> :NEW.ConGer)
   OR (:OLD.PerRat <> :NEW.PerRat)
   OR (:OLD.CodFor <> :NEW.CodFor)
   OR (:OLD.ClcPDb <> :NEW.ClcPDb)
   OR (:OLD.NumDoc <> :NEW.NumDoc)
   OR (:OLD.NomCon <> :NEW.NomCon)
   OR (:OLD.OriCtb <> :NEW.OriCtb)
   OR (:OLD.LotSAP <> :NEW.LotSAP)
   OR (:OLD.ValLan <> :NEW.ValLan)
   OR (:OLD.FilCtb <> :NEW.FilCtb)
   OR (:OLD.CcuRat <> :NEW.CcuRat)
   OR (:OLD.LocRat <> :NEW.LocRat)
   OR (:OLD.CodRat <> :NEW.CodRat)
   OR (:OLD.ConDeb <> :NEW.ConDeb)
   OR (:OLD.ConCre <> :NEW.ConCre)
   OR (:OLD.RedDeb <> :NEW.RedDeb)
   OR (:OLD.RedCre <> :NEW.RedCre)
   OR (:OLD.FilCtP <> :NEW.FilCtP)
   OR (:OLD.CodCcu <> :NEW.CodCcu)
   OR (:OLD.NumLoc <> :NEW.NumLoc)
   OR (:OLD.RatPad <> :NEW.RatPad)
   OR (:OLD.ConDeP <> :NEW.ConDeP)
   OR (:OLD.ConCrP <> :NEW.ConCrP)
   OR (:OLD.RedDeP <> :NEW.RedDeP)
   OR (:OLD.RedCrP <> :NEW.RedCrP)
   OR (:OLD.DefCon <> :NEW.DefCon)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R048CTB_EU', '');

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NumEmp));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TipCol));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TipCol));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NumCad));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NumCad));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CodFil));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CodFil));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODOEM', CONVERT(NUMBER_TO_CHAR, :OLD.CodOem));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODOEM', CONVERT(NUMBER_TO_CHAR, :NEW.CodOem));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSEQPAG', CONVERT(NUMBER_TO_CHAR, :OLD.SeqPag));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSEQPAG', CONVERT(NUMBER_TO_CHAR, :NEW.SeqPag));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTABORG', CONVERT(NUMBER_TO_CHAR, :OLD.TabOrg));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTABORG', CONVERT(NUMBER_TO_CHAR, :NEW.TabOrg));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTABEVE', CONVERT(NUMBER_TO_CHAR, :OLD.TabEve));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTABEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TabEve));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCLC', CONVERT(NUMBER_TO_CHAR, :OLD.CodClc));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCLC', CONVERT(NUMBER_TO_CHAR, :NEW.CodClc));		
		SP_DATSTR(:OLD.DatLan, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATLAN', l_datTemp);	
        SP_DATSTR(:NEW.DatLan, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATLAN', l_datTemp);			
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOPCCTB', CONVERT(NUMBER_TO_CHAR, :OLD.OpcCtb));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOPCCTB', CONVERT(NUMBER_TO_CHAR, :NEW.OpcCtb));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCAL', CONVERT(NUMBER_TO_CHAR, :OLD.CodCal));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCAL', CONVERT(NUMBER_TO_CHAR, :NEW.CodCal));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODLOT', CONVERT(NUMBER_TO_CHAR, :OLD.CodLot));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODLOT', CONVERT(NUMBER_TO_CHAR, :NEW.CodLot));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSEQLOT', CONVERT(NUMBER_TO_CHAR, :OLD.SeqLot));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSEQLOT', CONVERT(NUMBER_TO_CHAR, :NEW.SeqLot));
