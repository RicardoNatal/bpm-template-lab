␀Ñ␀Ôÿ1␀␀␀␀␀ÏHÎHÏHqC␀êÿ␀␀ÿ␀“ï␀␀EÔÿ1␀␀␀␀␀”±␀␀Mï␀␀æï␀␀G␀␀ÿ␀␀ÿ␀Ë§␀␀vÔÿ␀␀␀␀␀t¨␀␀q¨␀␀q¨␀␀n␀␀␀ÿ␀␀ÿ␀˜*=Ôÿ?ü␀␀␀␀¦␀␀ûŒ␀␀+c␀␀␀ÿ␀␀ÿ␀‹²␀␀>Ôÿ?ü␀␀␀␀ª²␀␀‡²␀␀«²␀␀P␀␀ÿ␀␀ÿ␀␀␀1Ó␀␀␀2Ó␀␀␀␀0;1;27Ó␀␀		SENIOR;0tc␀␀

TRIGGER R034CPL_EI BEFORE INSERT ON R034CPL FOR EACH ROW

DECLARE
l_DatAtu    DATE;
  l_data_zero DATE;
  L_CODPES      R034FUN.CODPES%TYPE;
  l_EndRua      R033END.ENDRUA%TYPE;
  l_EndNum      R033END.ENDNUM%TYPE;
  l_EndCpl      R033END.ENDCPL%TYPE;
  l_CodCid      R033END.CODCID%TYPE;
  l_CodBai      R033END.CODBAI%TYPE;
  l_EndCep      R033END.ENDCEP%TYPE;
  l_DatAlt      R033END.DATALT%TYPE;
  
  l_TipLgr      R033END.TIPLGR%TYPE;
  l_EndRuaAnt   R033END.ENDRUA%TYPE;
  l_EndNumAnt   R033END.ENDNUM%TYPE;
  l_EndCplAnt   R033END.ENDCPL%TYPE;
  l_CodCidAnt   R033END.CODCID%TYPE;
  l_CodBaiAnt   R033END.CODBAI%TYPE;
  l_EndCepAnt   R033END.ENDCEP%TYPE;
  l_TipLgrAnt   R033END.TIPLGR%TYPE;
  l_AlterouEndereco NUMBER(1); 
  
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_online    BOOLEAN;
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  
  l_DatAltHFI    R033PES.DATAUX%TYPE;
  l_ColAti       R033PES.COLATI%TYPE;  
  
  /* Para store procedures de histórico */
  l_seqhis       NUMBER(15);
  l_tipalt       VARCHAR2(1);
BEGIN
  BEGIN
    /*Verifca se colaborador tem vínculo com pessoa*/
    SELECT CODPES INTO L_CODPES FROM R034FUN
    WHERE NUMEMP = :NEW.NUMEMP
      AND TIPCOL = :NEW.TIPCOL
      AND NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_CODPES := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R034FUN.CODPES';
  END;

  /*Data zerada*/
  l_data_zero  := DATETIME(31, 12, 1900, 0, 0, 0); /*'31/12/1900,00:00:00';*/
  /*Data Atual*/
  l_DatAtu := CURDATE();

  /*Se existe pessoa vinculada, atualiza todos os dados em comum com a R034CPL e R033PES*/
  IF (L_CODPES > 0) THEN
    /* Retornar a data do primeiro hist. filial do colaborador */
    R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);
        
    /* Retornar se o colaborador está ativo */
    R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);
    
    BEGIN
      UPDATE R033PES SET
        CCINAS=:NEW.CCINAS,
        NOMCOM=:NEW.NOMCOM,
        NOMSOC=:NEW.NOMSOC,
        NUMCID=:NEW.NUMCID,
        EMICID=:NEW.EMICID,
        ESTCID=:NEW.ESTCID,
        DEXCID=:NEW.DEXCID,
        CIDEMI=:NEW.CIDEMI,
        NUMELE=:NEW.NUMELE,
        ZONELE=:NEW.ZONELE,
        SECELE=:NEW.SECELE,
        NUMCNH=:NEW.NUMCNH,
        CATCNH=:NEW.CATCNH,
        DATCNH=:NEW.DATCNH,
        VENCNH=:NEW.VENCNH,
        EMACOM=:NEW.EMACOM,
        EMAPAR=:NEW.EMAPAR,
        DDITEL=:NEW.DDITEL,
        DDDTEL=:NEW.DDDTEL,
        NUMTEL=:NEW.NUMTEL,
        NUMRAM=:NEW.NUMRAM,
        NASVIV=:NEW.NASVIV,
        CARSUS=:NEW.CARSUS,
        NUMRIC=:NEW.NUMRIC,
        TIPCER=:NEW.TIPCER,
        DEMCIV=:NEW.DEMCIV,
        MATCIV=:NEW.MATCIV,
        MATCCV=:NEW.MATCCV,
        LIVCIV=:NEW.LIVCIV,
        FOLCIV=:NEW.FOLCIV,
        CARCIV=:NEW.CARCIV,
        ESTCER=:NEW.ESTCIV,
        CIDCIV=:NEW.CIDCIV,
        NUMPSP=:NEW.NUMPSP,
        EMIPSP=:NEW.EMIPSP,
        ESTPSP=:NEW.ESTPSP,
        DEMPSP=:NEW.DEMPSP,
        DVAPSP=:NEW.DVAPSP,
        PAIPSP=:NEW.PAIPSP,
        NUMPOR=:NEW.NUMPOR,
        DATPOR=:NEW.DATPOR,
        ESTRIC=:NEW.ESTRIC,
        EMIRIC=:NEW.EMIRIC,
        CIDRIC=:NEW.CIDRIC,
        DEXRIC=:NEW.DEXRIC,
		REGCON=:NEW.REGCON,
		CODPRF=:NEW.CODPRF,
		DEXCON=:NEW.DATEXP,
		DATCON=:NEW.DATVEN,
		ORGCNH=:NEW.ORGCNH,
		ESTCNH=:NEW.ESTCNH,
		PRICNH=:NEW.PRICNH,
		EMPAUX=:NEW.NUMEMP,
		TIPAUX=:NEW.TIPCOL,
		CADAUX=:NEW.NUMCAD,
		SITREG=:NEW.SITREG,
		NUMRES=:NEW.NUMRES,
		CATRES=:NEW.CATRES,
		DEPAUX=0,
		COLATI=l_ColAti,
		CANAUX=0,
		DATAUX=l_DatAltHFI
      WHERE CODPES = L_CODPES;
      EXCEPTION WHEN OTHERS THEN
       RAISERROR 103 'Erro ao atualizar R033PES';
    END;

    /**VERIFICA ENDEREÇO*/
    BEGIN
      SELECT DATALT,ENDRUA,ENDNUM,ENDCPL,CODCID,CODBAI,ENDCEP,TIPLGR
      INTO l_DatAlt,l_EndRua,l_EndNum,l_EndCpl,l_CodCid,l_CodBai,l_EndCep,l_TipLgr
      FROM R033END
      WHERE CODPES = L_CODPES AND TIPEND = 1 AND DATALT =
       (SELECT MAX(B.DATALT) FROM R033END B WHERE B.CODPES = R033END.CODPES AND B.DATALT <= l_DatAtu);
      EXCEPTION WHEN NO_DATA_FOUND THEN
        l_EndRua := :NEW.ENDRUA;
        l_EndNum := :NEW.ENDNUM;
        l_EndCpl := :NEW.ENDCPL;
        l_CodCid := :NEW.CODCID;
        l_CodBai := :NEW.CODBAI;
        l_EndCep := :NEW.ENDCEP;
        l_DatAlt := l_data_zero;
        l_TipLgr := ' ';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler R033END';
    END;

    l_AlterouEndereco := 0;
    IF (:NEW.ENDRUA <> l_EndRua) THEN
      l_EndRua := :NEW.ENDRUA;
      l_AlterouEndereco := 1;
    END IF;
    IF (:NEW.ENDNUM <> l_EndNum) THEN
      l_EndNum := :NEW.ENDNUM;
      l_AlterouEndereco := 1;
    END IF;
    IF (:NEW.ENDCPL <> l_EndCpl) THEN
      l_EndCpl := :NEW.ENDCPL;
      l_AlterouEndereco := 1;
    END IF;
    IF (:NEW.CODCID <> l_CodCid) THEN
      l_CodCid := :NEW.CODCID;
      l_AlterouEndereco := 1;
    END IF;
    IF (:NEW.CODBAI <> l_CodBai) THEN
      l_CodBai := :NEW.CODBAI;
      l_AlterouEndereco := 1;
    END IF;
    IF (:NEW.ENDCEP <> l_EndCep) THEN
      l_EndCep := :NEW.ENDCEP;
      l_AlterouEndereco := 1;
    END IF;
    IF (:NEW.TIPLGR <> l_TipLgr) THEN
      l_TipLgr := :NEW.TIPLGR;
      l_AlterouEndereco := 1;
    END IF;

    IF (l_AlterouEndereco = 1) THEN
      IF (l_DatAtu <> l_DatAlt) THEN
        BEGIN
          INSERT INTO R033END(CODPES,TIPEND,DATALT,ENDRUA,ENDNUM,ENDCPL,CODCID,CODBAI,ENDCEP,TIPLGR,EMPAUX,TIPAUX,CADAUX,DEPAUX,COLATI,CANAUX,DATAUX)
          VALUES (L_CODPES,1,l_DatAtu,l_EndRua,l_EndNum,l_EndCpl,l_CodCid,l_CodBai,l_EndCep,l_TipLgr,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,0,l_ColAti,0,l_DatAltHFI);
        EXCEPTION
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao inserir na R033END';
        END;
      ELSE
        BEGIN
          SELECT ENDRUA,ENDNUM,ENDCPL,CODCID,CODBAI,ENDCEP,TIPLGR
          INTO l_EndRuaAnt,l_EndNumAnt,l_EndCplAnt,l_CodCidAnt,l_CodBaiAnt,l_EndCepAnt,l_TipLgrAnt
          FROM R033END WHERE CODPES = L_CODPES AND TIPEND = 1 AND DATALT = (SELECT MAX(B.DATALT) FROM R033END B WHERE B.CODPES = R033END.CODPES AND B.DATALT < l_DatAtu);
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_EndRuaAnt := ' ';
            l_EndNumAnt := ' ';
            l_EndCplAnt := ' ';
            l_CodCidAnt := 0;
            l_CodBaiAnt := 0;
            l_EndCepAnt := 0;
            l_TipLgrAnt := ' ';
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler R033END';
        END;

        IF (l_EndRuaAnt <> l_EndRua) OR (l_EndNumAnt <> l_EndNum) OR (l_EndCplAnt <> l_EndCpl) OR (l_CodCidAnt <>
          l_CodCid) OR (l_CodBaiAnt <> l_CodBai) OR (l_EndCepAnt <> l_EndCep) OR (l_TipLgrAnt <> l_TipLgr) THEN
          BEGIN
            UPDATE R033END SET
              ENDRUA = l_EndRua,
              ENDNUM = l_EndNum,
              ENDCPL = l_EndCpl,
              CODCID = l_CodCid,
              CODBAI = l_CodBai,
              ENDCEP = l_EndCep,
              TIPLGR = l_TipLgr,
              EMPAUX = :NEW.NUMEMP,
              TIPAUX = :NEW.TIPCOL,
              CADAUX = :NEW.NUMCAD,
              DEPAUX = 0,
              COLATI = l_ColAti,
              CANAUX = 0,
              DATAUX = l_DatAltHFI
            WHERE
              (CODPES = L_CODPES) AND (TIPEND = 1) AND (DATALT = l_DatAlt);
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a R033END';
          END;
        ELSE
          BEGIN         
            DELETE FROM R033END
            WHERE
              (CODPES = L_CODPES) AND (TIPEND = 1) AND (DATALT = l_DatAlt);
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a R033END';
          END;
        END IF;
      END IF;
    END IF;   
  END IF;

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116*/
  RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/  
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R034CPL');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R034CPL_AUD (SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,CODPAI,CODEST,CODCID,CODBAI,ENDCEP,ENDRUA,ENDNUM,ENDCPL,
                                   PAINAS,ESTNAS,CCINAS,NUMCID,EMICID,CIDEMI,ESTCID,DEXCID,EMAPAR,EMACOM,NUMTEL,NUMRAM,DDDTEL,
                                   DDITEL,NUMCNH,CATCNH,DATCNH,VENCNH,NUMPSP,EMIPSP,ESTPSP,DEMPSP,DVAPSP,PAIPSP)
                           VALUES (l_seqreg,l_verseq,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.CODPAI,:NEW.CODEST,:NEW.CODCID,:NEW.CODBAI,
                                   :NEW.ENDCEP,:NEW.ENDRUA,:NEW.ENDNUM,:NEW.ENDCPL,:NEW.PAINAS,:NEW.ESTNAS,:NEW.CCINAS,:NEW.NUMCID,
                                   :NEW.EMICID,:NEW.CIDEMI,:NEW.ESTCID,:NEW.DEXCID,:NEW.EMAPAR,:NEW.EMACOM,:NEW.NUMTEL,:NEW.NUMRAM,
                                   :NEW.DDDTEL,:NEW.DDITEL,:NEW.NUMCNH,:NEW.CATCNH,:NEW.DATCNH,:NEW.VENCNH,:NEW.NUMPSP,:NEW.EMIPSP,
                                   :NEW.ESTPSP,:NEW.DEMPSP,:NEW.DVAPSP,:NEW.PAIPSP);

          SP_AUDGENREG(l_seqreg,l_verseq,'R034CPL','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  /* Atualiza rotinas do acesso*/
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) THEN
       R034CPL_ATUCON('I', :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DDITEL, :NEW.DDDTEL, :NEW.NUMTEL);
  END IF;

  /* Geração do histórico da ficha complementar */
  l_tipalt := 'I';
  SP_R034CPL_HIST(l_tipalt, :NEW.numemp, :NEW.tipcol, :NEW.numcad, :NEW.ficreg, :NEW.codpai, :NEW.codest, :NEW.codcid, :NEW.codbai, :NEW.codrad, :NEW.nomrad, :NEW.endcep, :NEW.tiplgr, 
  		:NEW.endrua, :NEW.endnum, :NEW.endcpl, :NEW.numtel, :NEW.painas, :NEW.estnas, :NEW.ccinas, :NEW.docidn, :NEW.numcid, :NEW.emicid, :NEW.cidemi, :NEW.estcid, :NEW.dexcid, 
  		:NEW.zonele, :NEW.secele, :NEW.numele, :NEW.numcnh, :NEW.catcnh, :NEW.datcnh, :NEW.vencnh, :NEW.numres, :NEW.catres, :NEW.codprf, :NEW.regcon, :NEW.durcon, :NEW.procon, 
  		:NEW.proexm, :NEW.ultexm, :NEW.codqua, :NEW.estpad, :NEW.clasal, :NEW.nivsal, :NEW.matipe, :NEW.altipe, :NEW.sitipe, :NEW.tippsa, :NEW.codpsa, :NEW.matpsa, :NEW.incpsa, 
  		:NEW.excpsa, :NEW.codrlr, :NEW.codcas, :NEW.numram, :NEW.pretrb, :NEW.andtrb, :NEW.nroarm, :NEW.iniarm, :NEW.fimarm, :NEW.emapar, :NEW.emacom, :NEW.catvei, :NEW.sitreg, 
  		:NEW.nomcom, :NEW.nomsoc, :NEW.datven, :NEW.dddtel, :NEW.dditel, :NEW.nmddi2, :NEW.nmddd2, :NEW.nmtel2, :NEW.nmram2, :NEW.nifext, :NEW.maspsa, :NEW.nasviv, :NEW.carsus, 
  		:NEW.tipcer, :NEW.demciv, :NEW.matccv, :NEW.matciv, :NEW.livciv, :NEW.folciv, :NEW.carciv, :NEW.estciv, :NEW.cidciv, :NEW.numpsp, :NEW.emipsp, :NEW.estpsp, :NEW.dempsp, 
  		:NEW.dvapsp, :NEW.paipsp, :NEW.numpor, :NEW.datpor, :NEW.numric, :NEW.estric, :NEW.emiric, l_seqhis OUT);
  		
  /* Atualização do histórico da ficha complementar criada devido limite de parâmetros no PostgreSQL */		
  SP_R034CPL_HIST_UP(l_seqhis, :NEW.numemp, :NEW.tipcol, :NEW.numcad, :NEW.cidric, :NEW.dexric, :NEW.seqreg, :NEW.datexp, :NEW.orgcnh); 

  /* PENDÊNCIA SAMSenior */
  SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_IDTPES OUT);
  SP_SAM_PENDENCIES(1,1,l_idtpes); 
  
  /* Geração de logs Ficha Complementar (Tabela: R034CPL)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 109;     /* Ficha Complementar (Tabela: R034CPL)*/
  l_codtpa := 329;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034CPL_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034CPL_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FICREG', CONVERT(NUMBER_TO_CHAR, :NEW.FICREG));
