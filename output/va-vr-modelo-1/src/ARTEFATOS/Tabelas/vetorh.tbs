PROCEDURE SP_PEND97(P_TIPOPE CHAR(1),P_CODPOR NUMBER(3),P_CODUSU NUMBER(10),P_PORPRI CHAR(1))
 IS
 
  l_valstr     VARCHAR2(2047);
  l_datatu     DATE;
  l_horatu     NUMBER(4);
  l_seqenv     NUMBER(2);
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datenv     CHAR(16);
  l_seqstr     CHAR(2);
  l_codporStr  CHAR(3);
  l_codusuStr  CHAR(10); 
  l_porpri     CHAR(1);
BEGIN
  	
  /* Calcula  data/hora de envio da pendência.*/
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';
  
   
  SP_INTSTR(p_CodPor, '999', l_codporStr OUT);
  SP_INTSTR(p_codusu, '9999999999', l_codusuStr OUT);
  
  /* Portaria Principal */
  l_porpri := p_porpri;
  IF l_porpri IS NULL THEN
    SP_INTSTR(0, '9', l_porpri OUT);
  ELSE
    SP_SIMNAO_INT(l_porpri IN OUT);
  END IF;  
  
  /* monta o VALSTR*/
  /* 02 = Código da pendência (97)         */
  /* 16 = Data de envio                    */
  /* 01 = Tipo de Operação (2 - Insert/Update, 3 - Delete) */
  /* 03 = Código da Portaria (CODPOR)      */
  /* 10 = Código do Usuário (CODUSU)		 */
  /* 01 = Portária Principal (PORPRI, 0 - Não, 1 - Sim) */
  l_valstr := '97' || l_datenv || p_tipOpe || l_codporStr || l_codusuStr || l_porpri;
  
  BEGIN
      SP_PORCOM(l_valstr, '0');
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'SP_PEND97: Erro ao gerar pendência 97 (UpdateUserEntrance).';
  END;
END		SENIOR;210SP_DATSTR
SP_INTSTR
SP_SIMNAO_INT
SP_PORCOM
