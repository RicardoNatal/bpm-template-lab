PROCEDURE SP_UPDPRM(P_NUMCRA NUMBER,P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 CHAR(5),P_PRMRT2 CHAR(5),P_PRMRT3 CHAR(5))
 IS

l_cratit       NUMBER(12);
 l_crapro       NUMBER(12);
 l_numbar       NUMBER(12);
 l_numpro       NUMBER(12);
 l_numsma       NUMBER(12);
 l_crapri       NUMBER(12);
 l_tecpri       NUMBER(1);
BEGIN
  /*Obtem o(s) número(s) físico(s)*/
  SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
  /*Se a permissão de área Restrita estiver zerada atualiza as permissões normais da Pessoa*/
  IF p_prmrt1 = ' ' THEN
      /*Atualiza apenas os Crachás Secundários*/
      IF (l_tecpri <> 0) THEN
          /*Atualiza o Crachá de Barras se exisir*/
          IF (l_numbar <> 0) AND (l_tecpri <> 1) THEN
              BEGIN
                  UPDATE R070CON SET CODPRM = p_codprm, PRMSAB = p_prmsab, PRMDOM = p_prmdom, PRMFER = p_prmfer
                  WHERE NUMFIS = l_numbar;
              EXCEPTION
                  WHEN OTHERS THEN NULL;
              END;
          END IF;
          /*Atualiza o Crachá de Proximidade se exisir*/
          IF (l_numpro <> 0) AND (l_tecpri <> 2)THEN
              BEGIN
                  UPDATE R070CON SET CODPRM = p_codprm, PRMSAB = p_prmsab, PRMDOM = p_prmdom, PRMFER = p_prmfer
                  WHERE NUMFIS = l_numpro;
              EXCEPTION
                  WHEN OTHERS THEN NULL;
              END;
          END IF;
          /*Atualiza o Crachá Smart se exisir*/
          IF (l_numsma <> 0) AND (l_tecpri <> 3) THEN
              BEGIN
                  UPDATE R070CON SET CODPRM = p_codprm, PRMSAB = p_prmsab, PRMDOM = p_prmdom, PRMFER = p_prmfer
                  WHERE NUMFIS = l_numsma;
              EXCEPTION
                  WHEN OTHERS THEN NULL;
              END;
          END IF;
      END IF;
  /*Atualiza as permissões de áreas restritas*/
  ELSE
      IF (l_tecpri <> 0) THEN
          /*Atualiza o Crachá de Barras se exisir*/
          IF (l_numbar <> 0) AND (l_tecpri <> 1) THEN
              BEGIN
                  UPDATE R070CON SET PRMRT1 = CONVERT(CHAR_TO_NUMBER, p_prmrt1), PRMRT2 = CONVERT(CHAR_TO_NUMBER, p_prmrt2), PRMRT3 = CONVERT(CHAR_TO_NUMBER, p_prmrt3)
                  WHERE NUMFIS = l_numbar;
              EXCEPTION
                  WHEN OTHERS THEN NULL;
              END;
          END IF;
          /*Atualiza o Crachá de Proximidade se exisir*/
          IF (l_numpro <> 0) AND (l_tecpri <> 2)THEN
              BEGIN
                  UPDATE R070CON SET PRMRT1 = CONVERT(CHAR_TO_NUMBER, p_prmrt1), PRMRT2 = CONVERT(CHAR_TO_NUMBER, p_prmrt2), PRMRT3 = CONVERT(CHAR_TO_NUMBER, p_prmrt3)
                  WHERE NUMFIS = l_numpro;
              EXCEPTION
                  WHEN OTHERS THEN NULL;
              END;
          END IF;
          /*Atualiza o Crachá Smart se exisir*/
          IF (l_numsma <> 0) AND (l_tecpri <> 3) THEN
              BEGIN
                  UPDATE R070CON SET PRMRT1 = CONVERT(CHAR_TO_NUMBER, p_prmrt1), PRMRT2 = CONVERT(CHAR_TO_NUMBER, p_prmrt2), PRMRT3 = CONVERT(CHAR_TO_NUMBER, p_prmrt3)
                  WHERE NUMFIS = l_numsma;
              EXCEPTION
                  WHEN OTHERS THEN NULL;
              END;
          END IF;
      END IF;
  END IF;
END		SENIOR;20SP_MAPFIS
