  END
  ELSE
  BEGIN
    SELECT @l_tempac = 'N'
  END
  IF (@l_dat08rep='S' AND @l_repgrpf='S')
  BEGIN
    SELECT @l_utiaut = 'S'
  END
  ELSE
  BEGIN
    SELECT @l_utiaut = 'N'
  END
  /* TRY */
    SELECT 
      @l_count=COUNT(*) 
       FROM r070tsi r070tsi
    SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
    IF @ChkError <> 0
    BEGIN
      GOTO EXC7
    END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC7:
    SELECT @SE_EXC7 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        BEGIN
          RAISERROR('SP_PRPTSI: ERRO NO SELECT R070TSI',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
  /* TRY */
    IF (@l_count=0)
    BEGIN
      INSERT INTO r070tsi
       (temgrp,antdpl,blofal,tmpalm,verhor,verloc,verval,verafa,vercre,visesp,verdig,temtit,numser,temcrc,planta,temfxh,pndgrp,mapbio,cntdig,digver,digomo,digsag,cntfnc,convei,lbenef,trmbnf,blqsad,blqtip,excsad,exctip,atuali,conint,tempac,matcod,matgrp,damseg,dameip,damfnc,damvei,damono,dampes,damvlr,damkil,damqtd,damblu,damcod,utirep,dathor,blocon,utiaut,rep671) 
      VALUES 
      (@l_TEMGRP,@l_ANTDPL,@l_BLOFAL,@l_TMPALM,@l_VERHOR,@l_VERLOC,@l_VERVAL,@l_VERAFA,@l_VERCRE,@l_VISESP,@l_VERDIG,@l_TEMTIT,@l_NUMSER,@l_TEMCRC,@l_PLANTA,@l_TEMFXH,@l_PNDGRP,@l_MAPBIO,@l_CNTDIG,@l_DIGVER,@l_DIGOMO,@l_DIGSAG,@l_CNTFNC,@l_CONVEI,@l_LBENEF,@l_TRMBNF,@l_BLQSAD,@l_BLQTIP,@l_EXCSAD,@l_EXCTIP,@l_ATUALI,@l_CONINT,@l_TEMPAC,@l_MATCOD,@l_MATGRP,@l_DAMSEG,@l_DAMEIP,@l_DAMFNC,@l_DAMVEI,@l_DAMONO,@l_DAMPES,@l_DAMVLR,@l_DAMKIL,@l_DAMQTD,@l_DAMBLU,@l_DAMCOD,@l_UTIREP,@l_DATHOR,@l_BLOQ,@l_UTIAUT,@l_REP671)
      SELECT @ChkError = @@Error
      IF @ChkError <> 0
      BEGIN
        GOTO EXC8
      END
    END
    ELSE
    BEGIN
      UPDATE r070tsi SET 
      temgrp=@l_TEMGRP,antdpl=@l_ANTDPL,blofal=@l_BLOFAL,tmpalm=@l_TMPALM,verhor=@l_VERHOR,verloc=@l_VERLOC,verval=@l_VERVAL,verafa=@l_VERAFA,vercre=@l_VERCRE,visesp=@l_VISESP,verdig=@l_VERDIG,temtit=@l_TEMTIT,numser=@l_NUMSER,temcrc=@l_TEMCRC,planta=@l_PLANTA,temfxh=@l_TEMFXH,pndgrp=@l_PNDGRP,mapbio=@l_MAPBIO,cntdig=@l_CNTDIG,digver=@l_DIGVER,digomo=@l_DIGOMO,digsag=@l_DIGSAG,cntfnc=@l_CNTFNC,convei=@l_CONVEI,lbenef=@l_LBENEF,trmbnf=@l_TRMBNF,blqsad=@l_BLQSAD,blqtip=@l_BLQTIP,excsad=@l_EXCSAD,exctip=@l_EXCTIP,atuali=@l_ATUALI,conint=@l_CONINT,tempac=@l_TEMPAC,matcod=@l_MATCOD,matgrp=@l_MATGRP,damseg=@l_DAMSEG,dameip=@l_DAMEIP,damfnc=@l_DAMFNC,damvei=@l_DAMVEI,damono=@l_DAMONO,dampes=@l_DAMPES,damvlr=@l_DAMVLR,damkil=@l_DAMKIL,damqtd=@l_DAMQTD,damblu=@l_DAMBLU,damcod=@l_DAMCOD,utirep=@l_UTIREP,dathor=@l_DATHOR,blocon=@l_BLOQ,rep671=@l_REP671 
      SELECT @ChkError = @@Error
      IF @ChkError <> 0
      BEGIN
        GOTO EXC8
      END
    END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC8:
    SELECT @SE_EXC8 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        BEGIN
          RAISERROR('SP_PRPTSI: ERRO NA ATUALIZAÇÃO DA R070TSI',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
FIM:
  RETURN @ChkError
END
