          l_concre := 0;
  END;

  l_crefx1 := '00';
  l_fx1 := '24002400';
  l_crefx2 := '00';
  l_fx2 := '24002400';
  l_crefx3 := '00';
  l_fx3 := '24002400';
  l_crefx4 := '00';
  l_fx4 := '24002400';
  l_crefx5 := '00';
  l_fx5 := '24002400';
  l_crefx6 := '00';
  l_fx6 := '24002400';


  FOREACH c_r070CRC INTO  l_r070CRC.inifai,
                          l_r070CRC.fimfai,
                          l_r070CRC.salatu
  LOOP
      SP_INTSTR(l_r070CRC.inifai,'HHMM',l_inifai OUT);
      SP_INTSTR(l_r070CRC.fimfai,'HHMM',l_fimfai OUT);

      IF (l_r070crc.salatu > 0) THEN
        SP_INTSTR(l_r070CRC.salatu,'99',l_salatu OUT);
      ELSIF (l_concre = 3) THEN
      	SP_INTSTR(1,'99',l_salatu OUT);
      ELSE 
        l_salatu := 0;
      END IF;

      l_faixa := l_inifai || l_fimfai;

      IF    l_fx1 = '24002400' THEN
           l_fx1 := l_faixa;
           l_crefx1 := l_salatu;
      ELSIF l_fx2 = '24002400' THEN
           l_fx2 := l_faixa;
           l_crefx2 := l_salatu;
      ELSIF l_fx3 = '24002400' THEN
           l_fx3 := l_faixa;
           l_crefx3 := l_salatu;
      ELSIF l_fx4 = '24002400' THEN
           l_fx4 := l_faixa;
           l_crefx4 := l_salatu;
      ELSIF l_fx5 = '24002400' THEN
           l_fx5 := l_faixa;
           l_crefx5 := l_salatu;
      ELSIF l_fx6 = '24002400' THEN
           l_fx6 := l_faixa;
           l_crefx6 := l_salatu;
      END IF;
  END LOOP;

  p_crefx1 := l_crefx1;
  p_fx1 := l_fx1;
  p_crefx2 := l_crefx2;
  p_fx2 := l_fx2;
  p_crefx3 := l_crefx3;
  p_fx3 := l_fx3;
  p_crefx4 := l_crefx4;
  p_fx4 := l_fx4;
  p_crefx5 := l_crefx5;
  p_fx5 := l_fx5;
  p_crefx6 := l_crefx6;
  p_fx6 := l_fx6;
END		SENIOR;24SP_INTSTR
