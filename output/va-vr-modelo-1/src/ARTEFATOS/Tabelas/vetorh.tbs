PROCEDURE SP_PEND86(P_TIPOPE NUMBER(1),P_DATPRV DATE,P_HORPRV NUMBER(4),P_SEQAGV NUMBER(2),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(6),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NOMVIS VARCHAR2(40),P_TIPVIS NUMBER(3),P_CODPRM NUMBER(5),P_DATVAL DATE,P_HORVAL NUMBER(4),P_CODPOR NUMBER(3),P_CODNAC NUMBER(3),P_OBSAGV VARCHAR2(160),P_CODOEM NUMBER(8),P_NOMOEM VARCHAR2(40),P_DDITEL VARCHAR2(3),P_DDDTEL VARCHAR2(3),P_FONVIS VARCHAR2(20),P_EMAVIS VARCHAR2(100),P_LOCAGV NUMBER(9),P_EMPAUT NUMBER(4),P_TCLAUT NUMBER(1),P_CADAUT NUMBER(6),P_STAWAV CHAR(1),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7),P_VISEFE CHAR(1))
 IS

  l_valstr     VARCHAR2(2047);
  l_tipOpe     CHAR(1);
  l_datatu     DATE;
  l_horatu     NUMBER(4);
  l_seqenv     NUMBER(2);
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datenv     CHAR(16);
  l_seqstr     CHAR(2);  
  l_datagvStr  CHAR(16);  
  l_codprmStr  CHAR(5);
  l_codporStr  CHAR(3);
  l_idtVis     CHAR(23);
  l_idtCol     CHAR(23);
  l_TamVis     NUMBER(2);
  l_TamVisStr  CHAR(2);
  l_tipvisStr  CHAR(3);
  l_datvalStr  CHAR(16);
  l_datval     CHAR(6);
  l_horValStr  CHAR(4);
  l_locagvStr  CHAR(9);
  l_datPrvStr  CHAR(6);
  l_horPrvStr  CHAR(4);
  l_seqAgvStr  CHAR(2);
  l_TamObsStr  CHAR(3);
  l_codoemStr  CHAR(8);
  l_TamOEmStr  CHAR(2);
  l_TamEmaVisStr CHAR(2);
  l_codnacStr  CHAR(3);
  l_TamNac     NUMBER(2);
  l_TamNacStr  CHAR(2);  
  l_desNac     VARCHAR(40);
  l_DDIStr     VARCHAR(3);
  l_DDDStr     VARCHAR(3);
  l_telStr     VARCHAR2(99);
  l_TamObsAgv  NUMBER(3);
  l_TamOEm     NUMBER(2);
  l_TamTel     NUMBER(2);
  l_TamEmaVis  NUMBER(2);
  l_TamFonVisStr CHAR(2);
  l_idtAut     CHAR(23);
  l_StaWav     CHAR(1);
  l_locagv     NUMBER(9);
  l_verplf     NUMBER(3);
  l_codplf     NUMBER(7);  
  l_VerPlfStr  CHAR(3);
  l_CodPlfStr  CHAR(7);
  l_TamDesPlf  NUMBER(2);
  l_TamDesPlfStr CHAR(2);
  l_desplf     VARCHAR2(60);
  l_data_zero  DATE;
  l_visEfe     CHAR(1);
BEGIN
  l_data_zero := '31/12/1900,00:00:00';
	
  /* Calcula  data/hora de envio da pendência.*/
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';
  
  SP_DATSTR(p_datprv,'DDMMYY',l_datPrvStr OUT);
  SP_INTSTR(p_horprv,'HHMM',l_horPrvStr OUT);
  SP_INTSTR(p_seqagv, '99', l_seqAgvStr OUT);
  l_datagvStr := l_datPrvStr||l_horPrvStr||l_seqAgvStr||'0000';  

  IF (p_datval IS NOT NULL) THEN
    SP_DATSTR(p_datval,'DDMMYY',l_datval OUT);
  ELSE
    SP_DATSTR(l_data_zero,'DDMMYY',l_datval OUT);
  END IF;

  IF (p_horval IS NOT NULL) THEN
    SP_INTSTR(p_horval,'HHMM',l_horValStr OUT);
  ELSE
    SP_INTSTR(1439,'HHMM',l_horValStr OUT);
  END IF;

  l_datValStr := l_datval||l_horValStr||'00'||'0000';  
  
  SP_INTSTR(p_tipvis,'999', l_tipvisStr OUT);

  IF (p_nomvis IS NOT NULL) THEN
    l_TamVis := LENGTH(p_nomvis);
  ELSE
    l_TamVis := 0; 
  END IF;

  SP_INTSTR(p_dditel,'999', l_DDIStr OUT);  
  SP_INTSTR(p_dddtel,'999', l_DDDStr OUT);  

  WHILE (LENGTH(l_DDIStr) > 0) AND (SUBSTRING(l_DDIStr, 1, 1) = '0') LOOP 
    l_DDIStr := RTRIM(SUBSTRING(l_DDIStr, 2, LENGTH(l_DDIStr)));
  END LOOP;

  WHILE (LENGTH(l_DDDStr) > 0) AND (SUBSTRING(l_DDDStr, 1, 1) = '0') LOOP 
    l_DDDStr := RTRIM(SUBSTRING(l_DDDStr, 2, LENGTH(l_DDDStr)));
  END LOOP;
  
  l_telStr := REPLACE(REPLACE(p_fonvis, '-', ''), ' ', '');
  IF (p_dddtel IS NOT NULL AND LENGTH(RTRIM(LTRIM(p_dddtel))) > 0) THEN
    l_telStr := '(' || l_DDDStr || ')' || l_telStr; 
  END IF;
  IF (p_dditel IS NOT NULL AND LENGTH(RTRIM(LTRIM(p_dditel))) > 0) THEN
    l_telStr := l_DDIStr || l_telStr; 
  END IF;

  IF (p_obsagv IS NULL) THEN
    l_TamObsAgv := 0;
  ELSE
    l_TamObsAgv := LENGTH(p_obsagv);
  END IF;
  
  IF (p_nomoem IS NULL) THEN
    l_TamOEm := 0;
  ELSE
    l_TamOEm := LENGTH(p_nomoem);
  END IF;
  
  IF (l_telStr IS NOT NULL) THEN
    l_TamTel := LENGTH(l_telStr);
  ELSE
    l_TamTel := 0;
  END IF;
  
  IF (p_emavis IS NULL) THEN
    l_TamEmaVis := 0; 
  ELSE
    l_TamEmaVis := LENGTH(p_emavis);
  END IF;
  
  IF (p_locagv IS NULL) THEN
    l_locagv := 0;
  ELSE
    l_locagv := p_locagv;
  END IF;
  l_VERPLF := p_VERPLF;
  l_CODPLF := p_CODPLF;
    
  IF l_VERPLF IS NOT NULL AND l_CODPLF IS NOT NULL THEN
    BEGIN
      SELECT DesPlf INTO l_DesPlf FROM R058PLF WHERE VERPLF = l_VERPLF AND CODPLF = l_CODPLF;
    EXCEPTION
      WHEN OTHERS THEN NULL;
    END;
  ELSE
    l_DesPlf := NULL;
    l_VERPLF := 0;
    l_CODPLF := 0;
  END IF;

  IF (l_desplf IS NULL) THEN
    l_TamDesPlf := 0; 
  ELSE
    l_TamDesPlf := LENGTH(l_desplf);
  END IF;
  
  IF (p_codnac IS NOT NULL) THEN
    SP_INTSTR(p_codnac,'999'         , l_codnacStr OUT);
  ELSE
    SP_INTSTR(0,'999'         , l_codnacStr OUT);
  END IF;
  
  IF (p_codoem IS NOT NULL) THEN
    SP_INTSTR(p_codoem,'99999999'    , l_codoemStr OUT);
  ELSE
    SP_INTSTR(0,'99999999'    , l_codoemStr OUT);
  END IF;
  
  SP_INTSTR(p_tipOpe,'9'           , l_tipOpe OUT);
  SP_INTSTR(l_TamVis,'99'          , l_TamVisStr OUT);  
  SP_INTSTR(p_codprm,'99999'       , l_codPrmStr OUT);
  IF (p_codpor IS NOT NULL) THEN
    SP_INTSTR(p_codpor,'999'         , l_codporStr OUT);
  ELSE
    SP_INTSTR(0,'999'         , l_codporStr OUT);
  END IF;
  SP_INTSTR(l_locagv,'999999999'   , l_locagvStr OUT);
  
  /* Verifica a DESCrição da nacionalidade*/
  l_TamNac := 0;
  l_desnac := '';
  BEGIN
      SELECT DESNAC INTO l_DesNac FROM R023NAC WHERE CODNAC = p_codnac;
  EXCEPTION
      WHEN OTHERS THEN l_desnac := '';
  END;  
  l_TamNac := LENGTH(l_desnac);
  SP_INTSTR(l_TamNac, '99', l_TamnacStr OUT);  
  
  SP_INTSTR(l_TamObsAgv,'999'      , l_TamObsStr OUT);
  SP_INTSTR(l_TamOEm,'99'          , l_TamOEmStr OUT);
  SP_INTSTR(l_TamTel,'99'          , l_TamFonVisStr OUT);
  SP_INTSTR(l_TamEmaVis,'99'       , l_TamEmaVisStr OUT);
  SP_SIMNAO_INT(l_StaWav OUT);  
  SP_INTSTR(l_verplf,'999'         , l_verplfStr OUT);
  SP_INTSTR(l_codplf,'9999999'     , l_codplfStr OUT);
  SP_INTSTR(l_TamDesPlf,'99'       , l_TamDesPlfStr OUT);
  
  SP_RETIDTPES(p_numemp, p_tipcol, p_numcad, NULL, NULL, NULL, NULL, l_idtCol OUT);
  SP_RETIDTPES(NULL, 4, NULL, p_tipdoc, p_numdoc, NULL, NULL, l_idtVis OUT);
  SP_RETIDTPES(p_empaut, p_tclaut, p_cadaut, NULL, NULL, NULL, NULL, l_idtAut OUT);

  IF (p_StaWav IS NULL) THEN
    l_StaWav := '0';
  ELSE
    l_StaWav := p_StaWav;
  END IF;

  l_valstr := '86' || l_datenv || l_tipOpe || l_datagvStr || l_idtCol || l_idtVis;

  IF (l_TamVis > 0) THEN
    l_valstr := l_valstr || l_TamVisStr || p_nomvis;
  ELSE
    l_valstr := l_valstr || l_TamVisStr;
  END IF;
 
  l_valstr := l_valstr || l_tipvisStr || l_codPrmStr || l_datvalStr || l_codporStr || l_codnacStr;

  IF (l_TamNac > 0) THEN  
      l_valstr := l_valstr ||l_tamNacStr||l_desnac;
  ELSE
      l_valstr := l_valstr ||'00';  
  END IF;
  
  IF (l_TamObsAgv > 0) THEN
    l_valstr := l_valstr || l_TamObsStr || p_obsagv;
  ELSE
    l_valstr := l_valstr || l_TamObsStr;
  END IF;

  l_valstr := l_valstr || l_codoemStr; 
  
  IF (l_TamOEm > 0) THEN
    l_valstr := l_valstr || l_TamOEmStr || p_nomoem;
  ELSE
    l_valstr := l_valstr || l_TamOEmStr;
  END IF;

  IF (l_TamTel > 0) THEN
    l_valstr := l_valstr || l_TamFonVisStr || l_telStr;
  ELSE
    l_valstr := l_valstr || l_TamFonVisStr;
  END IF;

  IF (l_TamEmaVis > 0) THEN
    l_valstr := l_valstr || l_TamEmaVisStr || p_emavis;
  ELSE
    l_valstr := l_valstr || l_TamEmaVisStr;
  END IF;

  l_valstr := l_valstr || l_locagvStr;                      
  l_valstr := l_valstr || l_idtAut || l_StaWav;
  l_valstr := l_valstr || l_VerPlfStr || l_CodPlfStr;

  IF (l_TamDesPlf > 0) THEN
    l_valstr := l_valstr || l_TamDesPlfStr || l_desplf;
  ELSE
    l_valstr := l_valstr || l_TamDesPlfStr;
  END IF;
  
  IF (P_VISEFE = 'S') THEN
  	l_visEfe := '1';
  ELSE
  	l_visEfe := '0';
  END IF;
  
  l_valstr := l_valstr || l_visefe; 
  
  BEGIN
    SP_PORCOM(l_valstr, '0');
  EXCEPTION
    WHEN OTHERS THEN RAISERROR 103 'SP_PEND86: Erro ao gerar pendência 86.';
  END;
END␀{ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
