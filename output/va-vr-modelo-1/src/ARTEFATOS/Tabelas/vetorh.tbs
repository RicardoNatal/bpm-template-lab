TRIGGER R124HEA_SI AFTER INSERT ON R124HEA

DECLARE
/* SINCRONIZAÇÃO DO NOME DA ENTIDADE DE ENSINO COM O CADASTRO DA ENTIDADE */
  /* CURSOR para buscar os registros que foram inseridos na tabela R124HEA_AUX na trigger EI */
  /* CURSOR na tabela R124HEA_aux, o nome do CURSOR foi abreviado devido limitação no informix */
  /* de 18 caracteres para nome de identificadores, foi colocado 14 caracteres no máximo pois a */
  /* svcl adiciona mais 3 caracteres ao final */  
  CURSOR C_124HEA_I_AX IS
  SELECT NUMEMP, TIPCOL, NUMCAD, SEQADM, NOMOEM, TIPOPE
    FROM R124HEA_AUX
   WHERE TIPOPE = 'I';

  /* SINCRONIZAÇÃO DO NOME DA ENTIDADE DE ENSINO COM O CADASTRO DA ENTIDADE */
  /* RECORD com os campos da tabela R124HEA_AUX */
  TYPE t_R124HEA_aux IS RECORD(
    NUMEMP   R124HEA_AUX.NUMEMP%TYPE,
    TIPCOL   R124HEA_AUX.TIPCOL%TYPE,
    NUMCAD   R124HEA_AUX.NUMCAD%TYPE,
    SEQADM   R124HEA_AUX.SEQADM%TYPE,
    NOMOEM   R124HEA_AUX.NOMOEM%TYPE,
    TIPOPE   R124HEA_AUX.TIPOPE%TYPE);

  /* SINCRONIZAÇÃO DO NOME DA ENTIDADE DE ENSINO COM O CADASTRO DA ENTIDADE */
  l_R124HEA_aux t_R124HEA_aux;

  l_isInformix  BOOLEAN;
BEGIN
  /* Se for informix não pode executar rotina de atualização do nome outras empresas */
  /* Existe a limitação do banco e é gerado o erro -747 no informix                  */
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN
    /* SINCRONIZAÇÃO DO NOME DA ENTIDADE DE ENSINO COM O CADASTRO DA ENTIDADE */
    /* Busca os registros inserido na AUX */
    FOREACH C_124HEA_I_AX INTO l_R124HEA_aux.NUMEMP,
                               l_R124HEA_aux.TIPCOL,
                               l_R124HEA_aux.NUMCAD,
                               l_R124HEA_aux.SEQADM,
                               l_R124HEA_aux.NOMOEM,
                               l_R124HEA_aux.TIPOPE
    LOOP
      /* Se o nome não estiver nulo deve ser ajustado na tabela R124HEA */
      /* Este estará nulo quando nenhum ajuste precisa ser feito (Tratado no INSERT da EI na tabela AUX)*/
      IF (l_R124HEA_aux.NOMOEM IS NOT NULL) THEN
        BEGIN
          /* Sincroniza o nome da entidade de ensino do histórico           */
          /* com o nome cadastrado no cadastro de outras empresas (R032OEM) */
          UPDATE R124HEA
             SET NOMOEM = L_R124HEA_AUX.NOMOEM
           WHERE NUMEMP = L_R124HEA_AUX.NUMEMP
             AND TIPCOL = L_R124HEA_AUX.TIPCOL
             AND NUMCAD = L_R124HEA_AUX.NUMCAD
             AND SEQADM = L_R124HEA_AUX.SEQADM;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar o nome da entidade de ensino na tabela R124HEA. (R124HEA_SI)';
        END;
      END IF;
    END LOOP;

    /* Apaga os registro da tabela R124HEA_AUX onde o seu tipo de operação for de inclusão */
    BEGIN
      DELETE FROM R124HEA_AUX WHERE TIPOPE = 'I';
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro Exclusão da tabela R124HEA_AUX onde o tipo de operação (TIPOPE) for de inclusão.';
    END;
  END IF;
END␀Ìà␀␀		SENIOR;0‡␀␀TRIGGER R124HEA_EI AFTER INSERT ON R124HEA FOR EACH ROW

DECLARE
/* SINCRONIZAÇÃO DA EMPRESA ANTERIOR COM O CADASTRO DA ENTIDADE */
  l_EntPadrao      R126DEF.OEMDEF%TYPE; /* Nome da entidade de ensino padrão informado na tela de assinalamentos diversos */
  l_NomOemOrig     R124HEA.NOMOEM%TYPE; /* Nome da entidade de ensino cadastrado na tabela R032OEM, nome original da outra empresa*/
  /* Variável para controle do que deve ser sincronizado, se esta variáveis */
  /* estiverem com o valor nulo não será executado update na tabela R124HEA, ou seja, a sincronização não será feita pois o registro já deve está correto */
  l_NomOem         R124HEA.NOMOEM%TYPE;
  l_isInformix   BOOLEAN;
BEGIN
  /* variáveis utilizadas na sincronização do histórico onde o nome da entidade de ensino esteja   */
  /* diferentes dos seus respectivos cadastros. Só não será sincronizado quando a entidade estiver */
  /* igual ao definido como padrão nos assinalamentos                                              */
  l_NomOem := NULL;

  /* Se for informix não pode executar rotina de atualização do nome outras empresas */
  /* Existe a limitação do banco e é gerado o erro -747 no informix                  */
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN
    /* SINCRONIZAÇÃO DO NOME DA ENTIDADE DE ENSINO COM O CADASTRO DA ENTIDADE */
    BEGIN
      /* Busca a Empresa Anterior padrão definido nas definições gerais - R126DEF */
      SELECT IFNULL(OEMDEF, 0) INTO l_EntPadrao
        FROM R126DEF;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_EntPadrao := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler nas definições gerais a empresa anterior padrão (R126DEF) - (R124HEA_EI)';
    END;

    /* Somente se a entidade de ensino informado for diferente do padrão deve prosseguir com o processo de sincronização do nome */
    /* Se não entrar nesta condição a variável l_NomOem continua com o valor nulo */
    IF ((:NEW.CODOEM <> l_EntPadrao) AND (:NEW.CODOEM <> 0)) THEN
      BEGIN
        /* Bunca o nome da entidade de ensino original, cadastrado no cadastro de outras empresas */
        SELECT NOMOEM INTO l_NomOemOrig
          FROM R032OEM
         WHERE CODOEM = :NEW.CODOEM;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler o cadastro de outras empresas (R032OEM) - (R124HEA_EI)';
      END;
      /* Se o nome informado para o histórico for diferente do padrão. continua com a sincronização */
      IF (IFNULL(:NEW.NOMOEM, ' ') <> l_NomOemOrig) THEN
        /* Atribui o nome original da entidade de ensino para a variável, com isso na SI será substituído o que o usuário */
        /* informou pelo nome original da entidade. */
        l_NomOem := l_NomOemOrig;
      END IF;
    END IF;

    /* Se uma das variáveis l_NomCuf ou l_NomOem não estiver nula, então insere na tabela R124HEA_AUX */
    /* para que na SI seja tratado se deve ser atualizado ou não, se por exemplo a variável l_NomOem */
    /* estiver com o valor nulo, não será sincronizado o nome da entidade quando chegar na SI */
    IF (l_NomOem IS NOT NULL) THEN
      BEGIN
        INSERT INTO R124HEA_AUX (NUMEMP, TIPCOL, NUMCAD, SEQADM, NOMOEM, TIPOPE, FLGCON)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.SEQADM, l_NomOem, 'I', 0);
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao inserir na R124HEA_AUX (R124HEA_EI)';
      END;
    END IF;
  END IF;

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
END␀Ğà␀␀	SENIOR;0ò␀␀

TRIGGER R124HEA_SU AFTER UPDATE ON R124HEA

DECLARE
/* SINCRONIZAÇÃO DO NOME DA ENTIDADE DE ENSINO COM O CADASTRO DA ENTIDADE */
  /* CURSOR para buscar os registros que foram inseridos na tabela R124HEA_AUX na trigger EI */
  /* CURSOR na tabela R124HEA_aux, o nome do CURSOR foi abreviado devido limitação no informix */
  /* de 18 caracteres para nome de identificadores, foi colocado 14 caracteres no máximo pois a */
  /* svcl adiciona mais 3 caracteres ao final */  
  CURSOR C_124HEA_U_AX IS
  SELECT NUMEMP, TIPCOL, NUMCAD, SEQADM, NOMOEM, TIPOPE
    FROM R124HEA_AUX
   WHERE TIPOPE = 'U';

  /* SINCRONIZAÇÃO DO NOME DA ENTIDADE DE ENSINO COM O CADASTRO DA ENTIDADE */
  /* RECORD com os campos da tabela R124HEA_AUX */
  TYPE t_R124HEA_aux IS RECORD(
    NUMEMP   R124HEA_AUX.NUMEMP%TYPE,
    TIPCOL   R124HEA_AUX.TIPCOL%TYPE,
    NUMCAD   R124HEA_AUX.NUMCAD%TYPE,
    SEQADM   R124HEA_AUX.SEQADM%TYPE,
    NOMOEM   R124HEA_AUX.NOMOEM%TYPE,
    TIPOPE   R124HEA_AUX.TIPOPE%TYPE);

  /* SINCRONIZAÇÃO DO NOME DA ENTIDADE DE ENSINO COM O CADASTRO DA ENTIDADE */
  l_R124HEA_aux t_R124HEA_aux;

  l_Count       NUMBER;
  l_isInformix  BOOLEAN;
BEGIN
  /* Se for informix não pode executar rotina de atualização do nome outras empresas */
  /* Existe a limitação do banco e é gerado o erro -747 no informix                  */
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN
    /* Garante que está sendo processado a trigger de _SU uma unica vez
       evitando assim LOOP, pois via trigger de SU é feito um update para o mesmo registro. */
    BEGIN
      SELECT COUNT(*) INTO l_Count FROM R124HEA_AUX
       WHERE TIPOPE = 'U' AND FLGCON = 1;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao retornar Flag de Controle da tabela R124HEA_AUX.';
    END;

    /* Se não existe registro com Flag = 1 significa estar passando pela primeira vez na trigger de _SU */
    IF (l_Count  = 0) THEN
      /* Seta flag de controle para 1, evitando que a trigger de _SU seja
         processada em mais de uma instancia, controle necessário para evitar a Recursividade */
      BEGIN
        UPDATE R124HEA_AUX SET FLGCON = 1
         WHERE TIPOPE = 'U';
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro Flag de Controle da tabela R124HEA_AUX.';
      END;

      /* SINCRONIZAÇÃO DO NOME DA ENTIDADE DE ENSINO COM O CADASTRO DA ENTIDADE */
      /* Busca os registros inserido na AUX */
      FOREACH C_124HEA_U_AX INTO l_R124HEA_aux.NUMEMP,
                                 l_R124HEA_aux.TIPCOL,
                                 l_R124HEA_aux.NUMCAD,
                                 l_R124HEA_aux.SEQADM,
                                 l_R124HEA_aux.NOMOEM,
                                 l_R124HEA_aux.TIPOPE
      LOOP
        /* Se o nome não estiver nulo deve ser ajustado na tabela R124HEA */
        /* Este estará nulo quando nenhum ajuste precisa ser feito (Tratado no INSERT da EI na tabela AUX )*/
        IF (l_R124HEA_aux.NOMOEM IS NOT NULL) THEN
          BEGIN
            /* Sincroniza o nome da entidade de ensino do histórico           */
            /* com o nome cadastrado no cadastro de outras empresas (R032OEM) */
            UPDATE R124HEA
               SET NOMOEM = L_R124HEA_AUX.NOMOEM
             WHERE NUMEMP = L_R124HEA_AUX.NUMEMP
               AND TIPCOL = L_R124HEA_AUX.TIPCOL
               AND NUMCAD = L_R124HEA_AUX.NUMCAD
               AND SEQADM = L_R124HEA_AUX.SEQADM;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar o nome da Entidade de ensino na tabela R124HEA. (R124HEA_SU)';
          END;
        END IF;
      END LOOP;

      /* Apaga os registro da tabela R124HEA_AUX onde o seu tipo de operação for de inclusão */
      BEGIN
        DELETE FROM R124HEA_AUX WHERE TIPOPE = 'U';
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro Exclusão da tabela R124HEA_AUX onde o tipo de operação (TIPOPE) for de alteração.';
      END;
    END IF;
  END IF;
END␀Íà␀␀		SENIOR;0␀␀

TRIGGER R124HEA_EU AFTER UPDATE ON R124HEA FOR EACH ROW

DECLARE
/* SINCRONIZAÇÃO DA ENTIDADE DE ENSINO COM O CADASTRO DA ENTIDADE */
  l_EntPadrao      R126DEF.OEMDEF%TYPE; /* Nome da entidade de ensino padrão informado na tela de assinalamentos diversos */
  l_NomOemOrig     R124HEA.NOMOEM%TYPE; /* Nome da entidade de ensino cadastrado na tabela R032OEM, nome original da outra empresa*/
  /* Variável para controle do que deve ser sincronizado, se esta variáveis */
  /* estiverem com o valor nulo não será executado update na tabela R124HEA, ou seja, a sincronização não será feita pois o registro já deve está correto */
  l_NomOem         R124HEA.NOMOEM%TYPE;
  l_Count        NUMBER;
  l_isInformix   BOOLEAN;
BEGIN
  l_NomOem := NULL;

  /* Se for informix não pode executar rotina de atualização do nome outras empresas */
  /* Existe a limitação do banco e é gerado o erro -747 no informix                             */
  RH_ISINFORMIX(l_isInformix OUT);
  IF (l_isInformix = FALSE) THEN
    /* Sincroniza nome da Entidade de ensino */
    BEGIN
      /* Busca a Empresa Anterior padrão definido nas definições gerais - R126DEF */
      SELECT IFNULL(OEMDEF, 0) INTO l_EntPadrao
        FROM R126DEF;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_EntPadrao := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler nas definições gerais a empresa anterior padrão (R000ASS) - (R124HEA_EU)';
    END;

    /* Somente se a entidade de ensino informado for diferente do padrão deve prosseguir com o processo de sincronização do nome */
    /* Se não entrar nesta condição a variável l_NomOem continua com o valor nulo */
    IF ((IFNULL(:NEW.CODOEM, 0) <> IFNULL(:OLD.CODOEM, 0)) OR (IFNULL(:NEW.NOMOEM, ' ') <> IFNULL(:OLD.NOMOEM, ' '))) THEN
      IF ((IFNULL(:NEW.CODOEM, 0) <> l_EntPadrao) OR (IFNULL(:NEW.CODOEM, 0) = 0)) THEN
        BEGIN
          /* Verifica se existe na _AUX, indica que o processo foi startado via UPDATE NA R032OEM,
             e sendo assim, não se deve executar a rotina abaixo, visto que os valores já estão
             corretos e o SELECT na R032OEM daria erro.                                           */
          SELECT COUNT(*) INTO l_Count
            FROM R032OEM_AUX
           WHERE CODOEM = :NEW.CODOEM;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler o cadastro de outras empresas (R032OEM_AUX) - (R124HEA_EU)';
        END;

        /* Se não existe registro na _aux */
        IF (l_Count = 0) THEN
          BEGIN
            /* Busca o nome da entidade de ensino original, cadastrado no cadastro de outras empresas */
            SELECT NOMOEM INTO l_NomOemOrig
              FROM R032OEM
             WHERE CODOEM = :NEW.CODOEM;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              l_NomOemOrig := ' ';
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao ler o cadastro de outras empresas (R032OEM) - (R124HEA_EU)';
          END;

          /* Se o nome informado para o histórico for diferente do padrão. continua com a sincronização */
          IF (IFNULL(:NEW.NOMOEM, ' ') <> l_NomOemOrig) THEN
            /* Atribui o nome original da entidade de ensino para a variável, com isso na SU será substituído o que o usuário */
            /* informou pelo nome original da entidade. */
            l_NomOem := l_NomOemOrig;
          END IF;
        END IF;
      END IF;
    END IF;

    /* Se l_NomOem não estiver nula, então insere na tabela R124HEA_AUX */
    /* para que na SI seja tratado se deve ser atualizado ou não, se por exemplo a variável l_NomOem */
    /* estiver com o valor nulo, não será sincronizado o nome da entidade quando chegar na SU */
    IF (l_NomOem IS NOT NULL) THEN
      BEGIN
        INSERT INTO R124HEA_AUX (NUMEMP, TIPCOL, NUMCAD, SEQADM, NOMOEM, TIPOPE, FLGCON)
                 VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.SEQADM, l_NomOem, 'U', 0);
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao inserir na R124HEA_AUX (R124HEA_EU)';
      END;
    END IF;
  END IF;

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
END␀Ëà␀␀		SENIOR;0␀␀

TRIGGER R124HEA_ED AFTER DELETE ON R124HEA FOR EACH ROW

BEGIN
/* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD);
END␀␀␀>.␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Êà␀␀…¬␀␀´␀”␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t”␀␀␀␀␀␀O␀t␀t␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀”␀␀␀␀␀␀.%0.0.w␀␀Æÿ␀␀ÿ␀}ü␀␀­␀”␀␀␀␀␀␀óş␀␀ü␀␀xş␀␀p␀Æÿ␀␀ÿ␀¤§␀␀o”␀␀␀␀␀␀Ø¨␀␀vª␀␀vª␀␀i°‡␀␀ÿ␀␀ÿ␀à␀␀”␀␀␀␀␀␀ß␀Ş␀Ş␀c␀␀␀ÿ␀␀ÿ␀–oŠ␀”␀␀␀␀␀␀zoyoyon␀Æÿ␀␀ÿ␀␀␀␀␀␀␀A.␀␀␀␀␀␀␀␀Ñà␀␀…¬␀␀´␀	”␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	”␀␀␀␀␀␀O␀t␀t␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	”␀␀␀␀␀␀.%0.0.w␀Æÿ␀␀…Ó␀␀␀}ü␀␀­␀	”␀␀␀␀␀␀óş␀␀ü␀␀xş␀␀p␀Æÿ␀␀Îà␀␀␀DÑ␀	”␀␀␀␀␀␀F¼¼qC␀êÿ␀␀ÿ␀f´␀”␀␀␀␀␀␀÷<ïe»fr␀Æÿ␀␀)Ñ␀␀␀0,4”␀␀␀␀␀␀ÿ?µ'µ'}␀␀ÿ␀␀Ñ␀␀␀·␀”␀␀␀␀␀␀™␀u␀v␀¦†␀␀ÿ␀␀ÿ␀à.*”␀␀␀␀␀␀>/>/>/>␀␀ÿ␀␀ÿ␀^␀±␀”␀␀␀␀␀␀j
