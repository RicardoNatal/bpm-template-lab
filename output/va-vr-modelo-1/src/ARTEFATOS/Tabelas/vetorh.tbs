M„␀␀CREATE  PROCEDURE sp_addlog(@PEVTIDT FLOAT, @PEVTTIM FLOAT, @PEVTUSR FLOAT, @PEVTDA1 VARCHAR(255), @PEVTDA2 VARCHAR(255), @PEVTDA3 VARCHAR(255), @PEVTDA4 VARCHAR(255), @PEVTDA5 VARCHAR(255), @PEVTDA6 VARCHAR(255), @PEVTDA7 VARCHAR(255), @PEVTDA8 VARCHAR(255), @PEVTDA9 VARCHAR(255), @PEVTDA10 VARCHAR(255), @PEVTDA11 VARCHAR(255), @PEVTDA12 VARCHAR(255), @PEVTDA13 VARCHAR(255), @PEVTDA14 VARCHAR(255), @PEVTDA15 VARCHAR(255), @PEVTDA16 VARCHAR(255), @PEVTDA17 VARCHAR(255), @PEVTDA18 VARCHAR(255), @PEVTDA19 VARCHAR(255), @PEVTDA20 VARCHAR(255), @PEVTDA21 VARCHAR(255), @PEVTDA22 VARCHAR(255), @PEVTDA23 VARCHAR(255), @PEVTDA24 VARCHAR(255), @PEVTDA25 VARCHAR(255), @PEVTDA26 VARCHAR(255), @PEVTDA27 VARCHAR(255), @PEVTDA28 VARCHAR(255), @PEVTDA29 VARCHAR(255), @PEVTDA30 VARCHAR(255), @PEVTDA31 VARCHAR(255), @PEVTDA32 VARCHAR(255)) AS
BEGIN
  SET NOCOUNT ON
  DECLARE @vevtpos BIGINT
  DECLARE @vmaxpos BIGINT
  DECLARE @vevtnbr BIGINT
  DECLARE @vevtposcnt BIGINT
  DECLARE @viscircular NUMERIC(1,0)
  DECLARE @ChkError INTEGER
  SELECT @ChkError = 0
  SELECT @VISCIRCULAR = 1
  DECLARE cur_r900lcn CURSOR FOR SELECT 
      r900lcn.evtpos EVTPOS,r900lcn.maxpos MAXPOS
       FROM r900lcn r900lcn WITH(UPDLOCK)
  
BEGINADDLOG:	
  BEGIN TRAN       
  OPEN CUR_R900LCN
  FETCH NEXT FROM CUR_R900LCN INTO @VEVTPOS, @VMAXPOS
  WHILE  (@@FETCH_STATUS = 0)
  BEGIN
    IF (@VMAXPOS=-1727)
    BEGIN
      SELECT @VISCIRCULAR = 0
    END
    SELECT @VEVTNBR = @VEVTPOS
    SELECT 
      @VEVTPOSCNT=COUNT(*) 
       FROM r900log r900log
       WHERE evtpos=@vevtpos
    SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
    IF @ChkError <> 0
    BEGIN
      GOTO FNCUR_R900LCN1
    END
    IF (@VISCIRCULAR=1)
    BEGIN
      IF (@VEVTPOSCNT<>1)
