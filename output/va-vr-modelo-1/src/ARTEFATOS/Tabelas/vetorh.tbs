DECLARE
  L_CODPES      R033PES.CODPES%TYPE;
  l_DatAltHFI   R033PES.DATAUX%TYPE;
  l_ColAti      R033PES.COLATI%TYPE;
BEGIN
/* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
  
  BEGIN
    /*Verifca se colaborador tem vínculo com pessoa*/
    SELECT CODPES INTO L_CODPES FROM R034FUN
    WHERE NUMEMP = :NEW.NUMEMP
      AND TIPCOL = :NEW.TIPCOL
      AND NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_CODPES := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R034FUN.CODPES';
  END;

  /*Se existe pessoa vinculada, atualiza todos os dados em comum com a R034DCO e R033PES*/
  IF (L_CODPES > 0) THEN
    /* Retornar a data do primeiro hist. filial do colaborador */
    R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);
        
    /* Retornar se o colaborador está ativo */
    R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);
    
    BEGIN
      UPDATE R033PES SET
        FUNPRO=:NEW.FUNPRO,
        NUMSEG=:NEW.NUMSEG,
        DOCIDE=:NEW.DOCIDE,
		EMPAUX=:NEW.NUMEMP,
		TIPAUX=:NEW.TIPCOL,
		CADAUX=:NEW.NUMCAD,
		DEPAUX=0,
		COLATI=l_ColAti,
		CANAUX=0,
		DATAUX=l_DatAltHFI
      WHERE CODPES = L_CODPES;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao atualizar R033PES';
    END;  
  END IF;
END␀HÓ␀␀		SENIOR;0[␀␀

TRIGGER R034DCO_EU AFTER UPDATE ON R034DCO FOR EACH ROW
DECLARE
  L_CODPES      R033PES.CODPES%TYPE;
  L_SITAFA      R034FUN.SITAFA%TYPE;
  L_DEMITIDOS BOOLEAN;  
  l_AlterouPessoa BOOLEAN;
  l_DatAltHFI   R033PES.DATAUX%TYPE;
  l_ColAti      R033PES.COLATI%TYPE;
BEGIN
/* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116 */
  RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
  
  /*Verifca se colaborador tem vínculo com pessoa*/
  BEGIN
    SELECT CODPES,SITAFA INTO L_CODPES,L_SITAFA FROM R034FUN
    WHERE NUMEMP = :NEW.NUMEMP
      AND TIPCOL = :NEW.TIPCOL
      AND NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_CODPES := 0;
      L_SITAFA := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R034FUN.CODPES';
  END;

  IF (L_CODPES > 0) THEN
    RH_VERCOLDEM(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,L_CODPES,L_SITAFA,'R034DCO',L_DEMITIDOS OUT);
    IF (L_DEMITIDOS=TRUE) THEN
      /*Se existe vínculo com pessoa verificar os campos em comum entre
        R034DCO e R033PES se os mesmos foram alterados atualizar na R033PES*/
      l_AlterouPessoa := FALSE;
      IF (:NEW.FUNPRO <> :OLD.FUNPRO) THEN
        BEGIN
          UPDATE R033PES SET FUNPRO = :NEW.FUNPRO WHERE CODPES = L_CODPES;
          EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R033PES campo FUNPRO';
        END;    
        l_AlterouPessoa := TRUE;    
      END IF;
      IF (:NEW.NUMSEG <> :OLD.NUMSEG) THEN
        BEGIN
          UPDATE R033PES SET NUMSEG = :NEW.NUMSEG WHERE CODPES = L_CODPES;
          EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R033PES campo NUMSEG';
        END;        
        l_AlterouPessoa := TRUE;
      END IF;
      IF (:NEW.DOCIDE <> :OLD.DOCIDE) THEN
        BEGIN
          UPDATE R033PES SET DOCIDE = :NEW.DOCIDE WHERE CODPES = L_CODPES;
          EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao atualizar R033PES campo DOCIDE';
        END;        
        l_AlterouPessoa := TRUE;
      END IF;
      
      IF (l_AlterouPessoa = TRUE) THEN
       	/* Retornar a data do primeiro hist. filial do colaborador */
        R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);
        
        /* Retornar se o colaborador está ativo */
        R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);
        
	    BEGIN
          UPDATE R033PES SET EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                             DEPAUX = 0, COLATI = l_ColAti, CANAUX = 0, DATAUX = l_DatAltHFI WHERE CODPES = L_CODPES;
        EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'Erro ao atualizar campos auxiliares da R033PES';
        END;	
	  END IF;
    END IF;
  END IF;    
END␀FÓ␀␀		SENIOR;0␀␀

TRIGGER R034DCO_ED AFTER DELETE ON R034DCO FOR EACH ROW

BEGIN
/* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116*/
  RS_UPDCURCOMP(0, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD);
END␀␀␀¡^␀␀␀␀␀␀␀IÓ␀␀…¬␀␀´␀	Ôï1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôï1␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀9Ó␀␀␀c¬␀␀Ì␀	Ôï1␀␀␀␀␀œ$€$€$w␀Æÿ␀␀…Ó␀␀␀ºDÑ␀	Ôï1␀␀␀␀␀MMMqC␀êÿ␀␀ÿ␀N␀´␀	Ôï1␀␀␀␀␀˜␀˜␀˜␀r␀Æÿ␀␀íĞ␀␀␀ı␀␀´␀	Ôï1␀␀␀␀␀‚ÿ␀␀‚ÿ␀␀‚ÿ␀␀r␀Æÿ␀␀ÿ␀p^Ò␀Ôï1␀␀␀␀␀g‹␀␀g‹␀␀g‹␀␀ÿ␀ÿÿ␀␀ÿ␀s³␀␀`Ôï1␀␀␀␀␀ñ³␀␀ñ³␀␀ñ³␀␀B␀␀ÿ␀␀ÿ␀+§␀␀9Ôï1␀␀␀␀␀¨␀␀¨␀␀¨␀␀:␀␀ÿ␀␀ÿ ␀␀␀0;1;2;3;4;5KÓ␀␀		SENIOR;0!␀␀/* INSERT (NEW) */
TRIGGER R034DOC_EI AFTER INSERT ON R034DOC FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Fotos de Documentos do Colaborador (Tabela: R034DOC)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 111;     /* Fotos de Documentos do Colaborador (Tabela: R034DOC)*/
  l_codtpa := 333;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034DOC_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATDOC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATDOC', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPDOC', CONVERT(NUMBER_TO_CHAR, :NEW.TIPDOC));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQDOC', CONVERT(NUMBER_TO_CHAR, :NEW.SEQDOC));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034DOC_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSDOC', :NEW.OBSDOC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOMARQ', :NEW.NOMARQ);
      END;
  END IF; 
END␀LÓ␀␀		SENIOR;0Í	␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R034DOC_EU AFTER UPDATE ON R034DOC FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Fotos de Documentos do Colaborador (Tabela: R034DOC)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 111;     /* Fotos de Documentos do Colaborador (Tabela: R034DOC)*/
  l_codtpa := 334;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatDoc <> :NEW.DatDoc)
   OR (:OLD.TipDoc <> :NEW.TipDoc)
   OR (:OLD.SeqDoc <> :NEW.SeqDoc)
   OR (:OLD.ObsDoc <> :NEW.ObsDoc)
   OR (:OLD.NomArq <> :NEW.NomArq)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034DOC_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATDOC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATDOC', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPDOC', CONVERT(NUMBER_TO_CHAR, :OLD.TIPDOC));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQDOC', CONVERT(NUMBER_TO_CHAR, :OLD.SEQDOC));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034DOC_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSDOC', :OLD.OBSDOC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSDOC', :NEW.OBSDOC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOMARQ', :OLD.NOMARQ);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNOMARQ', :NEW.NOMARQ);
      END;
    END IF; 
  END IF; 
END␀JÓ␀␀		SENIOR;0&␀␀ 

