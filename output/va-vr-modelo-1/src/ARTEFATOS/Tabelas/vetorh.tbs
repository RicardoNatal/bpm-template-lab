   OR (:OLD.AfgInd <> :NEW.AfgInd)
   OR (:OLD.BaApFd <> :NEW.BaApFd)
   OR (:OLD.AfgI13 <> :NEW.AfgI13)
   OR (:OLD.TotPro <> :NEW.TotPro)
   OR (:OLD.TotDes <> :NEW.TotDes)
   OR (:OLD.IntRcs <> :NEW.IntRcs)
   OR (:OLD.TotVan <> :NEW.TotVan)
   OR (:OLD.MaiRem <> :NEW.MaiRem)
   OR (:OLD.BirPar <> :NEW.BirPar)
   OR (:OLD.DisCol <> :NEW.DisCol)
   OR (:OLD.TemDis <> :NEW.TemDis)
   OR (:OLD.SalBas <> :NEW.SalBas)
   OR (:OLD.CalRcs <> :NEW.CalRcs)
