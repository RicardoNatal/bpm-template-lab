/* UPDATE (OLD/NEW) */
TRIGGER R008INC_EU AFTER UPDATE ON R008INC FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Eventos - Incidências (Tabela: R008INC)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 102;     /* Eventos - Incidências (Tabela: R008INC)*/
  l_codtpa := 350;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.CodTab <> :NEW.CodTab)
   OR (:OLD.CodEve <> :NEW.CodEve)
   OR (:OLD.CmpInc <> :NEW.CmpInc)
   OR (:OLD.SeqInc <> :NEW.SeqInc)
   OR (:OLD.IncRem <> :NEW.IncRem)
   OR (:OLD.IncMvv <> :NEW.IncMvv)
   OR (:OLD.IncAd1 <> :NEW.IncAd1)
   OR (:OLD.IncAd2 <> :NEW.IncAd2)
   OR (:OLD.IncFgm <> :NEW.IncFgm)
   OR (:OLD.IncFgd <> :NEW.IncFgd)
   OR (:OLD.IncFgi <> :NEW.IncFgi)
   OR (:OLD.IncFdi <> :NEW.IncFdi)
   OR (:OLD.IncInm <> :NEW.IncInm)
   OR (:OLD.IncInd <> :NEW.IncInd)
   OR (:OLD.IncIna <> :NEW.IncIna)
   OR (:OLD.IncIrm <> :NEW.IncIrm)
   OR (:OLD.IncIrf <> :NEW.IncIrf)
   OR (:OLD.IncIrd <> :NEW.IncIrd)
   OR (:OLD.IncIrp <> :NEW.IncIrp)
   OR (:OLD.IncIra <> :NEW.IncIra)
   OR (:OLD.IncIpm <> :NEW.IncIpm)
   OR (:OLD.IncIpf <> :NEW.IncIpf)
   OR (:OLD.IncIpd <> :NEW.IncIpd)
   OR (:OLD.IncPis <> :NEW.IncPis)
   OR (:OLD.IncPid <> :NEW.IncPid)
   OR (:OLD.IncRer <> :NEW.IncRer)
   OR (:OLD.IncMsc <> :NEW.IncMsc)
   OR (:OLD.AbrVin <> :NEW.AbrVin)
   OR (:OLD.ConMed <> :NEW.ConMed)
   OR (:OLD.ComSal <> :NEW.ComSal)
   OR (:OLD.MotMai <> :NEW.MotMai)
   OR (:OLD.MotMen <> :NEW.MotMen)
   OR (:OLD.MotZer <> :NEW.MotZer)
   OR (:OLD.NatRub <> :NEW.NatRub)
   OR (:OLD.RepDSR <> :NEW.RepDSR)
