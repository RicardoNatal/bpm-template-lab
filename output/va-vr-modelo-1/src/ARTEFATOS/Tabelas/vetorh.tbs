									:NEW.CENDIF,:NEW.BUSREC,:NEW.ADIPOS,:NEW.USAHAG,:NEW.DATHAG,:NEW.FTOPIS);

              SP_AUDGENREG(l_seqreg,l_verseq,'R030EMP',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  IF (:NEW.NOMEMP <> :OLD.NOMEMP) THEN
    SP_VerOnLine(l_online OUT);

    IF (l_online = TRUE) THEN
      R030EMP_ATUCON(2, :OLD.NUMEMP, :NEW.NOMEMP);
    END IF;

    /* Pendência SAMSenior */
    SP_INTSTR(:OLD.NUMEMP, '9999', l_numemp_str OUT);
    l_valstr := 'E' || l_numemp_str || :OLD.NOMEMP;
    SP_SAM_PENDENCIES(31, 2, l_valstr);
  END IF;
  
  /* PENDENCIA S-1000 eSocial*/
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_inffac OUT, l_simeso OUT, l_versaoEsocial OUT);
  
  IF (l_versaoEsocial >= 5) THEN
  	/* Está na versão 1.1 do eSocial ou superior, então gera pendencia */
  	IF ((:OLD.USAPIS <> :NEW.USAPIS) OR (:OLD.EXTPIS <> :NEW.EXTPIS)) THEN
  		SP_E_SOCIAL('S-1000', 'R030EMP', 'T', 'A', NULL, NULL, :NEW.NUMEMP, 0, 0, '', '', 0, NULL, NULL, 0, 'R030EMP_EU');
  	END IF;
  END IF;
  
END␀Ò␀␀	SENIOR;0L

TRIGGER R030EMP_SD AFTER DELETE ON R030EMP

BEGIN
RH_250ALT(22);
END␀Ò␀␀		SENIOR;0£␀␀

TRIGGER R030EMP_ED AFTER DELETE ON R030EMP FOR EACH ROW

DECLARE
l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_online       BOOLEAN;
BEGIN
	RH_250ALT(22);

    /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
    l_auditoria := 'N';
    SP_AUDVER(l_auditoria OUT, 'R030EMP');

	IF (l_auditoria = 'S') THEN
	  l_seqreg := :OLD.SEQREG;

	  IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

		  BEGIN
			  SELECT MAX(SEQREG) INTO l_seqreg
				FROM R030EMP_AUD
			   WHERE NUMEMP = :OLD.NUMEMP;
		   EXCEPTION
			WHEN OTHERS THEN
			  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
		  END;
	  END IF;
	  SP_AUDGETVERSEQ(l_seqreg,l_seqreg OUT, l_verseq OUT);

	  BEGIN
		  INSERT INTO R030EMP_AUD (SEQREG,VERSEQ,NUMEMP,NOMEMP,APEEMP,SIGEMP,CODPAI,NUMTEL,NUMFAX,CADBOM,TOTCTB,TABEVE,PERADI,
								   MED13S,CPL13S,FECDIG,DSRMEN,GERAFA,ESCHOR,USAVTR,USADEP,USAVLI,FECSAL,USARAT,RATPRV,HORNOT,
								   PAGESC,GRPSOC,PAGANU,FECCOM,DIAHOR,USAPIS,CALSAL,TIPULT,HORFER,ULTPRO,ULTMEN,ULTADT,ULTSEM,
								   ULTQUI,ULT13S,ULTPAR,ENCPRV,BENPRV,SLDPRV,PISPRV,BAIRAT,CTBFER,CTBEFE,TOTPIS,NROCON,ULTRPA,
								   USARAH,POREMP,CMPSIM,SALPRP,USATIM,HOMPAG,HORCTT,CTLDFI,HISFNC,PAGFNC,PROFIX,USAPRF,VACFRE,
								   PRVFER,PROADI,ORCMAO,CONPAG,CPFRES,APUPRO,CALDPN,CODDAP,CODDSI,USAFIN,RESDAD,PRVTRF,LANDEM,
								   CFGSAP,INTSAP,TABINT,FERSAB,ATUEFE,VERADM,VERQUA,VERQUF,USATUR,CTLQUA,TIPQUA,CONCAR,NIVQUA,
								   ULTPRE,EXCPRE,APRNAT,BAKINI,BAKFIM,CONCFI,CONTPV,CONTMP,NORRQU,SIMFIL,AJUSLD,APRFAI,APRLOT,
								   ORCIND,IDADEP,USASLD,CONFIS,ROTTOM,VALCAP,TIPSIJ,ALIRED,HISCON,ADMPER,CODIDN,HISPEN,CODDGH,
								   BAIFGT,SELCEN,PASPRV,GERVOC,ENTCAS,CLCSAI,BAIPIS,CONSIT,MODINF,MODP41,ABRCEN,INTDEM,VINPES,
								   VINPE2,VINPE3,VIPEDE,DIFIMP,USAPEM,USAPTE,USAPPA,DDDTEL,DDITEL,DDDFAX,DDIFAX,BASINS,LIMFIL,USACOM,BLQADM,
								   TABEST,NIVLOC,ORDFRE,CONEMI,INITOM,ARQINS,AMBSAP,RATADT,CENDIF,BUSREC,ADIPOS,USAHAG,DATHAG,FTOPIS)
							VALUES (l_seqreg,l_verseq,:OLD.NUMEMP,:OLD.NOMEMP,:OLD.APEEMP,:OLD.SIGEMP,:OLD.CODPAI,:OLD.NUMTEL,:OLD.NUMFAX,
									:OLD.CADBOM,:OLD.TOTCTB,:OLD.TABEVE,:OLD.PERADI,:OLD.MED13S,:OLD.CPL13S,:OLD.FECDIG,:OLD.DSRMEN,:OLD.GERAFA,
									:OLD.ESCHOR,:OLD.USAVTR,:OLD.USADEP,:OLD.USAVLI,:OLD.FECSAL,:OLD.USARAT,:OLD.RATPRV,:OLD.HORNOT,:OLD.PAGESC,
									:OLD.GRPSOC,:OLD.PAGANU,:OLD.FECCOM,:OLD.DIAHOR,:OLD.USAPIS,:OLD.CALSAL,:OLD.TIPULT,:OLD.HORFER,:OLD.ULTPRO,
									:OLD.ULTMEN,:OLD.ULTADT,:OLD.ULTSEM,:OLD.ULTQUI,:OLD.ULT13S,:OLD.ULTPAR,:OLD.ENCPRV,:OLD.BENPRV,:OLD.SLDPRV,
									:OLD.PISPRV,:OLD.BAIRAT,:OLD.CTBFER,:OLD.CTBEFE,:OLD.TOTPIS,:OLD.NROCON,:OLD.ULTRPA,:OLD.USARAH,:OLD.POREMP,
									:OLD.CMPSIM,:OLD.SALPRP,:OLD.USATIM,:OLD.HOMPAG,:OLD.HORCTT,:OLD.CTLDFI,:OLD.HISFNC,:OLD.PAGFNC,:OLD.PROFIX,
									:OLD.USAPRF,:OLD.VACFRE,:OLD.PRVFER,:OLD.PROADI,:OLD.ORCMAO,:OLD.CONPAG,:OLD.CPFRES,:OLD.APUPRO,:OLD.CALDPN,
									:OLD.CODDAP,:OLD.CODDSI,:OLD.USAFIN,:OLD.RESDAD,:OLD.PRVTRF,:OLD.LANDEM,:OLD.CFGSAP,:OLD.INTSAP,:OLD.TABINT,
									:OLD.FERSAB,:OLD.ATUEFE,:OLD.VERADM,:OLD.VERQUA,:OLD.VERQUF,:OLD.USATUR,:OLD.CTLQUA,:OLD.TIPQUA,:OLD.CONCAR,
									:OLD.NIVQUA,:OLD.ULTPRE,:OLD.EXCPRE,:OLD.APRNAT,:OLD.BAKINI,:OLD.BAKFIM,:OLD.CONCFI,:OLD.CONTPV,:OLD.CONTMP,
									:OLD.NORRQU,:OLD.SIMFIL,:OLD.AJUSLD,:OLD.APRFAI,:OLD.APRLOT,:OLD.ORCIND,:OLD.IDADEP,:OLD.USASLD,:OLD.CONFIS,
									:OLD.ROTTOM,:OLD.VALCAP,:OLD.TIPSIJ,:OLD.ALIRED,:OLD.HISCON,:OLD.ADMPER,:OLD.CODIDN,:OLD.HISPEN,:OLD.CODDGH,
									:OLD.BAIFGT,:OLD.SELCEN,:OLD.PASPRV,:OLD.GERVOC,:OLD.ENTCAS,:OLD.CLCSAI,:OLD.BAIPIS,:OLD.CONSIT,:OLD.MODINF,
									:OLD.MODP41,:OLD.ABRCEN,:OLD.INTDEM,:OLD.VINPES,:OLD.VINPE2,:OLD.VINPE3,:OLD.VIPEDE,:OLD.DIFIMP,:OLD.USAPEM,:OLD.USAPTE,:OLD.USAPPA,
