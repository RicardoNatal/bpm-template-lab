PROCEDURE SP_PEND78(P_TIPOPE NUMBER(1),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7),P_PAIPLF NUMBER(7),P_DESPLF VARCHAR2(60),P_IDTREL NUMBER(5),P_CATPLF NUMBER(2),P_QTDPES NUMBER(5))
 IS

l_tipope          CHAR(1);
  l_verplf          CHAR(3);
  l_codplf          CHAR(7);
  l_paiplf          CHAR(7);
  l_idtrel          CHAR(5);
  l_catPlf          CHAR(2);
  l_valstr          VARCHAR(128);
  l_desplf          VARCHAR(60);
  l_size_desplf     NUMBER(2);
  l_size_desplf_str CHAR(2);
  l_qtdPesStr       CHAR(4);
  l_qtdAtuStr       CHAR(4);
  l_qtdAtuPes       NUMBER(6);
BEGIN
  SP_INTSTR(p_tipope,'9'       ,l_tipope OUT);
  SP_INTSTR(p_verplf,'999'     ,l_verplf OUT);
  SP_INTSTR(p_codplf,'9999999' ,l_codplf OUT);
  SP_INTSTR(p_idtrel,'99999'   ,l_idtrel OUT);
  SP_INTSTR(p_catplf,'99'      ,l_catplf OUT);

  /* EXCLUIR */
  IF (p_tipope = 2) THEN
      l_valstr := '78' || l_tipope || l_verplf || l_codplf;
  ELSE /* INSERIR/ALTERAR */
      SP_INTSTR(p_paiplf,'9999999' ,l_paiplf OUT);
      l_desplf := RTrim(LTrim(p_desplf));
      l_size_desplf := LENGTH(l_desplf);
      IF (l_size_desplf IS NULL) OR (l_size_desplf = 0) THEN
          l_valstr := '78' || l_tipope || l_verplf || l_codplf || l_paiplf || '00';
      ELSE
          SP_INTSTR(l_size_desplf,'99' ,l_size_desplf_str OUT);
          l_valstr := '78' || l_tipope || l_verplf || l_codplf || l_paiplf || l_size_desplf_str || l_desplf || l_idtrel || l_catplf;
      END IF;

      BEGIN
        SELECT COUNT(*) INTO l_qtdAtuPes FROM R070PLF WHERE CODPLF= CONVERT(CHAR_TO_NUMBER, l_codplf) AND VERPLF= p_verplf;
      EXCEPTION
        WHEN OTHERS THEN
          l_qtdAtuPes := 0;
      END;

      SP_INTSTR(p_qtdPes,'9999',l_qtdPesStr OUT);
      SP_INTSTR(l_qtdAtuPes,'9999',l_qtdAtuStr OUT);
      
      l_valstr := l_valstr || l_qtdPesStr || l_qtdAtuStr;
  END IF;

  BEGIN
      SP_PORCOM(l_valstr, '0');
  EXCEPTION
      WHEN OTHERS THEN
          RAISERROR 103 'SP_PEND78: Erro ao gerar pendência 78.	UPDATEPhysicalLocationTree.';
  END;
END		SENIOR;20SP_INTSTR
SP_PORCOM
