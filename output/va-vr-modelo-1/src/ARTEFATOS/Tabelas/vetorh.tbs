DECLARE
l_Valor VARCHAR2(2000);
  l_ConfirmouCessao  BOOLEAN;
  l_Valido BOOLEAN;
  l_AlterouIni       BOOLEAN;
  l_AlterouFim       BOOLEAN;
  l_ZerouDatTer      BOOLEAN;
  l_DataZero         DATE;
  l_SimplificacaoESocial    BOOLEAN;
  l_InfoFacult              BOOLEAN;
  l_DataInicioEsocial       DATE;
  l_DataInicioTabelas       DATE;
  l_DataInicioNaoPeriodicos DATE;
  l_DataInicioPeriodicos    DATE;
  l_DataInicioSST           DATE;
  l_DataInicioMigracao      DATE;
  l_layoutColab             VARCHAR(6);
  l_gerarPendencia          BOOLEAN;
  l_VersaoESocial            NUMBER;
BEGIN
  /* INÍCIO - eSocial */
  /* Somente para hist. Cessão Confirmados assinalados para enviar ao eSocial  */
  IF (:NEW.SITHCE = 2) AND (:NEW.ENVESO = 1) THEN
     l_gerarPendencia := TRUE;
	 RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutColab OUT);
     N_GR_PEN_BENEF(l_layoutColab, l_gerarPendencia OUT);	
	 IF (l_gerarPendencia = TRUE) THEN     
	   
	   l_ConfirmouCessao := FALSE;
       l_DataZero := '31/12/1900,00:00:00';
     
       l_SimplificacaoESocial := FALSE;
       l_VersaoESocial := 0;
       
       SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificacaoESocial OUT, l_VersaoESocial OUT);
     
       /* Está cofirmando a cessão */
       SP_VALUPDATE_NUM(:OLD.SITHCE, :NEW.SITHCE, l_Valido OUT);
       IF (l_Valido = TRUE) THEN
         l_ConfirmouCessao := TRUE;
       END IF;
     
       /* A partir da simplificação, a cessão do tipo 1 - Cessão deve ser enviada através do novo leiaute S-2231 */
       IF (l_SimplificacaoESocial = TRUE) AND (:NEW.TIPCAD = 1) THEN
     
          RH_DEF_ESOCIAL(:NEW.NUMEMP, l_DataInicioTabelas OUT, l_DataInicioEsocial OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
     
          /* Está cofirmando a cessão */
          IF (l_ConfirmouCessao = TRUE) THEN
     
             /* Se a data fim é anterior ao início dos não periódicos, significa que o empregado está ativo para o eSocial, e não cedido */
             IF (:NEW.DATTER = l_DataZero) OR (:NEW.DATTER >= l_DataInicioNaoPeriodicos) THEN
                l_Valor := '';
     
                IF (:NEW.DATINI < l_DataInicioNaoPeriodicos) THEN
                   SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
                   SP_CONCATENAR_NUM('TIPHCE', 1, l_Valor OUT);
                   SP_E_SOCIAL(l_layoutColab, 'R038HCE', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATINI, 0, 'R038HCE_EU');
                ELSE
                   SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
                   SP_CONCATENAR_NUM('TIPHCE', 1, l_Valor OUT);
                   SP_E_SOCIAL('S-2231', 'R038HCE', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATINI, 0, 'R038HCE_EU');
                END IF;
     
                IF (:NEW.DATTER <> l_DataZero) THEN
                  l_Valor := '';
                  SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
                  SP_CONCATENAR_NUM('TIPHCE', 2, l_Valor OUT);
                  SP_CONCATENAR_DAT('DATTER', :NEW.DATTER, l_Valor OUT);
                  SP_E_SOCIAL('S-2231', 'R038HCE', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATTER, 0, 'R038HCE_EU');
                END IF;
             END IF;
          ELSE /* Já havia confirmado a cessão */
             l_Valor := '';
     
             /* Se não havia informado a data de término e agora informou, gera uma inclusão com a data de término, caso a data seja maior que a data de início dos não periodicos */
             IF (:OLD.DATTER = l_DataZero) AND (:NEW.DATTER <> l_DataZero) THEN
                IF (:NEW.DATTER < l_DataInicioNaoPeriodicos) THEN
                   SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
                   SP_CONCATENAR_NUM('TIPHCE', 1, l_Valor OUT);
                   SP_E_SOCIAL(l_layoutColab, 'R038HCE', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATINI, 0, 'R038HCE_EU');
                ELSE
                   SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
                   SP_CONCATENAR_NUM('TIPHCE', 2, l_Valor OUT);
                   SP_CONCATENAR_DAT('DATTER', :NEW.DATTER, l_Valor OUT);
                   SP_E_SOCIAL('S-2231', 'R038HCE', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATTER, 0, 'R038HCE_EU');
                END IF;
             END IF;
     
             /* Se havia informado a data de término e agora zerou, gera uma exclusão da data de término, ou retifica o S-2200 caso a data seja menor que a data de início dos não periodicos */
             IF (:OLD.DATTER <> l_DataZero) AND (:NEW.DATTER = l_DataZero) THEN
                IF (:OLD.DATTER < l_DataInicioNaoPeriodicos) THEN
                   SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
                   SP_CONCATENAR_NUM('TIPHCE', 1, l_Valor OUT);
                   SP_E_SOCIAL(l_layoutColab, 'R038HCE', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATINI, 0, 'R038HCE_EU');
                ELSE
                   SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
                   SP_CONCATENAR_NUM('TIPHCE', 2, l_Valor OUT);
                   SP_CONCATENAR_DAT('DATTER', :OLD.DATTER, l_Valor OUT);
                   SP_CONCATENAR_DES('LAYOUT', 'S-2231', l_Valor OUT);
                   SP_E_SOCIAL('S-3000', 'R038HCE', 'N', 'E', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :OLD.DATTER, 0, 'R038HCE_EU');
                END IF;
             END IF;
     
             /* Se havia informado a data de término e agora informou outra data, gera uma alteração da data de término */
             IF (:OLD.DATTER <> l_DataZero) AND (:NEW.DATTER <> l_DataZero) AND (:NEW.DATTER <> :OLD.DATTER) THEN
                IF (:OLD.DATTER >= l_DataInicioNaoPeriodicos) AND (:NEW.DATTER >= l_DataInicioNaoPeriodicos) THEN
                   SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
                   SP_CONCATENAR_NUM('TIPHCE', 2, l_Valor OUT);
                   SP_CONCATENAR_DAT('DATTER', :NEW.DATTER, l_Valor OUT);
                   SP_E_SOCIAL('S-2231', 'R038HCE', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATTER, 0, 'R038HCE_EU');
                END IF;
     
                IF (:OLD.DATTER >= l_DataInicioNaoPeriodicos AND :NEW.DATTER < l_DataInicioNaoPeriodicos) OR (:OLD.DATTER < l_DataInicioNaoPeriodicos AND :NEW.DATTER >= l_DataInicioNaoPeriodicos) THEN
                   l_Valor := '';
                   SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
                   SP_CONCATENAR_NUM('TIPHCE', 1, l_Valor OUT);
                   SP_E_SOCIAL(l_layoutColab, 'R038HCE', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATINI, 0, 'R038HCE_EU');
                   
                   IF (:OLD.DATTER < l_DataInicioNaoPeriodicos AND :NEW.DATTER >= l_DataInicioNaoPeriodicos) THEN
                      l_Valor := '';
                      SP_CONCATENAR_DAT('DATINI', :NEW.DATINI, l_Valor OUT);
                      SP_CONCATENAR_NUM('TIPHCE', 2, l_Valor OUT);
                      SP_CONCATENAR_DAT('DATTER', :NEW.DATTER, l_Valor OUT);
                      SP_E_SOCIAL('S-2231', 'R038HCE', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATTER, 0, 'R038HCE_EU');
                   END IF;
                END IF;
             END IF;
          END IF;
       ELSE
          /* Na versão 2.5, ou simplificação do tipo 2 - Mandato Sindical, somente se onus cedente/empregador deve gerar pendência R038HCE, demais situações são tratadas via afastamento (R038AFA) */
          IF (:NEW.TIPONU = 1 OR :NEW.TIPONU = 3 OR :NEW.ONUSIN = 1 OR :NEW.ONUSIN = 3)  THEN
            IF (l_ConfirmouCessao = TRUE) THEN
              l_Valor := '';
              SP_CONCATENAR_DAT('DATAFA', :NEW.DATINI, l_Valor OUT);
              SP_CONCATENAR_NUM('HORAFA', 0, l_Valor OUT);
              SP_CONCATENAR_NUM('SECAFA', 1, l_Valor OUT);
              SP_E_SOCIAL('S-2230', 'R038HCE', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATINI, 0, 'R038HCE_EU');
              
              IF (:NEW.DATTER <> l_DataZero) THEN
                l_Valor := '';
                SP_CONCATENAR_DAT('DATAFA', :NEW.DATINI, l_Valor OUT);
                SP_CONCATENAR_NUM('HORAFA', 0, l_Valor OUT);
                SP_CONCATENAR_NUM('SECAFA', 3, l_Valor OUT);
                SP_E_SOCIAL('S-2230', 'R038HCE', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATINI, 0, 'R038HCE_EU');
              END IF;
            ELSE
              l_AlterouIni := FALSE;
              l_AlterouFim := FALSE;
              
              SP_VALUPDATE_DAT(:OLD.DATTER, :NEW.DATTER, l_Valido OUT);
              IF (l_Valido = TRUE) THEN
                l_AlterouFim := TRUE;
                IF (:NEW.DATTER = l_DataZero) THEN
                   l_ZerouDatTer := TRUE;
                END IF;
              END IF;
     
              SP_VALUPDATE_DES(:OLD.OBSHIS, :NEW.OBSHIS, l_Valido OUT);
              IF (l_Valido = TRUE) THEN
                l_AlterouIni := TRUE;
              END IF;
     
              IF (l_AlterouIni = TRUE) THEN
                 l_Valor := '';
                 SP_CONCATENAR_DAT('DATAFA', :NEW.DATINI, l_Valor OUT);
                 SP_CONCATENAR_NUM('HORAFA', 0, l_Valor OUT);
                 SP_CONCATENAR_NUM('SECAFA', 1, l_Valor OUT);
                 SP_E_SOCIAL('S-2230', 'R038HCE', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATINI, 0, 'R038HCE_EU');
              END IF;
     
              IF (l_AlterouFim = TRUE) THEN
                 l_Valor := '';
                 SP_CONCATENAR_DAT('DATAFA', :NEW.DATINI, l_Valor OUT);
                 SP_CONCATENAR_NUM('HORAFA', 0, l_Valor OUT);
                 SP_CONCATENAR_NUM('SECAFA', 3, l_Valor OUT);
                
                 /* SE ZEROU DATA DE TERMINO DEVE ENVIAR A EXCLUSÃO DA SEÇÃO fimAfastamento */
                 IF (l_ZerouDatTer = TRUE) THEN
                   SP_CONCATENAR_DES('LAYOUT', 'S-2230', l_Valor OUT);
                   SP_E_SOCIAL('S-3000', 'R038HCE', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATINI, 0, 'R038HCE_EU');
                 ELSE
                   SP_E_SOCIAL('S-2230', 'R038HCE', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATINI, 0, 'R038HCE_EU');
                 END IF;
              END IF;
            END IF;
          END IF;
       END IF;
    END IF;	   
  END IF;
  /* FIM - eSocial */
END␀ Ô␀␀		SENIOR;0␀␀

TRIGGER R038HCE_ED AFTER DELETE ON R038HCE FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);
  l_InfoFacult BOOLEAN;
  l_SimplificacaoESocial BOOLEAN;
  l_DataZero DATE;
  l_DataInicioEsocial       DATE;
  l_DataInicioTabelas       DATE;
  l_DataInicioNaoPeriodicos DATE;
  l_DataInicioPeriodicos    DATE;
  l_DataInicioSST           DATE;
  l_DataInicioMigracao      DATE;
  l_layoutColab             VARCHAR(6);
  l_gerarPendencia          BOOLEAN;
  l_VersaoESocial           NUMBER;
BEGIN
  /* INÍCIO - eSocial */
  IF (:OLD.SITHCE = 2) AND (:OLD.ENVESO = 1) THEN
     l_gerarPendencia := TRUE;
	 RH_LAYOUTCOLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layoutColab OUT);
     N_GR_PEN_BENEF(l_layoutColab, l_gerarPendencia OUT);	
	 IF (l_gerarPendencia = TRUE) THEN     	 
       l_SimplificacaoESocial := FALSE;
       l_VersaoESocial := 0;
       SP_ESOCIAL_INFO(:OLD.NUMEMP, l_InfoFacult OUT, l_SimplificacaoESocial OUT, l_VersaoESocial OUT);
	   
       /* A partir da simplificação, a cessão do tipo 1 - Cessão é enviada através do novo leiaute S-2231 */
       IF (l_SimplificacaoESocial = TRUE) AND (:OLD.TIPCAD = 1) THEN
          l_DataZero := '31/12/1900,00:00:00';
          RH_DEF_ESOCIAL(:OLD.NUMEMP, l_DataInicioTabelas OUT, l_DataInicioEsocial OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
	   
          /* Se a data fim é anterior ao início dos não periódicos, significa que o empregado está ativo para o eSocial, e não cedido */
          IF (:OLD.DATTER = l_DataZero) OR (:OLD.DATTER >= l_DataInicioNaoPeriodicos) THEN
             l_Valor := '';
	   
             IF (:OLD.DATINI < l_DataInicioNaoPeriodicos) THEN
                SP_CONCATENAR_DAT('DATINI', :OLD.DATINI, l_Valor OUT);
                SP_CONCATENAR_NUM('TIPHCE', 1, l_Valor OUT);
                SP_E_SOCIAL(l_layoutColab, 'R038HCE', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0, NULL, :OLD.DATINI, 0, 'R038HCE_ED');
             ELSE
                SP_CONCATENAR_DAT('DATINI', :OLD.DATINI, l_Valor OUT);
                SP_CONCATENAR_NUM('TIPHCE', 1, l_Valor OUT);
                SP_CONCATENAR_DES('LAYOUT', 'S-2231', l_Valor OUT);
                SP_E_SOCIAL('S-3000', 'R038HCE', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0, NULL, :OLD.DATINI, 0, 'R038HCE_ED');
             END IF;
             
             IF (:OLD.DATTER <> l_DataZero) THEN
                l_Valor := '';
                SP_CONCATENAR_DAT('DATINI', :OLD.DATINI, l_Valor OUT);
                SP_CONCATENAR_NUM('TIPHCE', 2, l_Valor OUT);
                SP_CONCATENAR_DAT('DATTER', :OLD.DATTER, l_Valor OUT);
                SP_CONCATENAR_DES('LAYOUT', 'S-2231', l_Valor OUT);
                SP_E_SOCIAL('S-3000', 'R038HCE', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0, NULL, :OLD.DATTER, 0, 'R038HCE_ED');
             END IF;
          END IF;
       ELSE
          /* Na versão 2.5, ou simplificação do tipo 2 - Mandato Sindical, somente para hist. Cessão Confirmados onde o onus é do cedente/empregador. Onus Cessionário/Sindicado é gerado pelo afastamento (R038AFA)  */
          IF (:OLD.TIPONU = 1 OR :OLD.TIPONU = 3 OR :OLD.ONUSIN = 1 OR :OLD.ONUSIN = 3) THEN
             l_Valor := '';
             SP_CONCATENAR_DAT('DATAFA', :OLD.DATINI, l_Valor OUT);
             SP_CONCATENAR_NUM('HORAFA', 0, l_Valor OUT);
             SP_CONCATENAR_DES('LAYOUT', 'S-2230', l_Valor OUT);
          
             SP_E_SOCIAL('S-3000', 'R038HCE', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0, NULL, :OLD.DATINI, 0, 'R038HCE_ED');
          END IF;
       END IF;
    END IF;	   
  END IF;
  /* FIM - eSocial */
END␀␀␀Év␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀¢Ô␀␀3␀{	„␀␀␀␀␀␀␀␀␀nˆ␀Æÿ␀␀ÿ␀…¬␀␀´␀	„␀␀␀␀␀␀‘<XbXbrˆ␀Æÿ␀␀Ò␀␀␀.␀t	„␀␀␀␀␀␀O␀Ò␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	„␀␀␀␀␀␀u%&$Á$w	ˆ␀Æÿ␀␀…Ó␀␀␀EÑ␀	„␀␀␀␀␀␀KK¢G¢GqCˆ␀êÿ␀␀ÿ␀¤w·␀	„␀␀␀␀␀␀’yˆxˆxì*␀ˆ␀Æÿ␀␀ÿ␀Ç&␀­␀„␀␀␀␀␀␀<°␀␀°&␀À&␀pŞ‡␀Æÿ␀␀ÿ␀u¬␀␀–␀„␀␀␀␀␀␀>±␀␀)8)8n
ˆ␀Æÿ␀␀ÿ␀åDÑ␀„␀␀␀␀␀␀)GÔFÔFqCˆ␀êÿ␀␀ÿ␀w·␀„␀␀␀␀␀␀[x<x<xì*␀ˆ␀Æÿ␀␀ÿ␀Õí␀␀E„␀␀␀␀␀␀/î␀␀$î␀␀;î␀␀G␀␀ÿ␀␀ÿ␀␀É„␀␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀␀Ã„␀␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀×-‹␀„␀␀␀␀␀␀¨Am␀m␀—)␀␀Æÿ␀␀ÿ␀ş␀␀¢␀␀␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀!8T„␀␀␀␀␀␀S8M8M8+␀␀ÿ␀␀ÿ␀õ,­␀„␀␀␀␀␀␀y£␀␀x£␀␀y£␀␀p␀Æÿ␀␀ÿ␀{Ç␀␀N„␀␀␀␀␀␀‰Ç␀␀yÇ␀␀†Ç␀␀M␀␀ÿ␀␀ÿ␀␀␀£Ô␀␀␀¤Ô␀␀␀¥Ô␀␀	␀¦Ô␀␀	␀§Ô␀␀␀␀␀0;1;2;3;4;5±Ô␀␀	SENIOR;0K␀␀TRIGGER R038HCH_SI AFTER INSERT ON R038HCH

DECLARE
  l_data_zero       DATE;
  l_data_atual      DATE;
  l_data_ontem      DATE;
  L_DATTOL          DATE;
  L_HORTOL          NUMBER(4);
  l_hora_atual      NUMBER(4);
  l_numcra          NUMBER(12);
  l_HinCra          NUMBER(5);
  l_online          BOOLEAN;
  l_numemp          NUMBER(12);
  l_tipcol          NUMBER(12);
  l_numcad          NUMBER(12);
  l_tippes_str      CHAR(2);
  l_numempidtpes    CHAR(4);
  l_tipcolidtpes    CHAR(1);
  l_numcadidtpes    CHAR(10);
  l_idtpes          VARCHAR2(23);
  l_cravei          NUMBER(12);
  l_cratit          NUMBER(12);
  l_craprv          NUMBER(12);
  l_froonl          BOOLEAN;
  l_usabio          NUMBER(1);
  l_datfim          DATE;
  l_datval          DATE;
  l_horval          NUMBER(4);
  l_libvei          NUMBER(1);
  l_chcass          CHAR(1);
  l_subnv_colcon    NUMBER(1);
  l_froaut          NUMBER(1);

/* CURSOR c/ os registros gravados no R038hch_AUX */
  CURSOR c_r038hch_ins IS SELECT TIPOPE,TIPCRA,NUMEMP,TIPCOL,NUMCAD,NUMCRA,CRAOLD,DATINI,HORINI,DATFIM,HORFIM,STAATU, STAACC FROM R038HCH_AUX;
  TYPE t_r038hch_aux IS RECORD(
    TIPOPE   R038HCH_AUX.TipOpe%TYPE,
    TIPCRA   R038HCH_AUX.TipCra%TYPE,
    NUMEMP   R038HCH_AUX.NumEmp%TYPE,
    TIPCOL   R038HCH_AUX.TipCol%TYPE,
    NUMCAD   R038HCH_AUX.NumCad%TYPE,
    NUMCRA   R038HCH_AUX.NumCra%TYPE,
    CRAOLD   R038HCH_AUX.CraOld%TYPE,
    DATINI   R038HCH_AUX.DatIni%TYPE,
    HORINI   R038HCH_AUX.HorIni%TYPE,
    DATFIM   R038HCH_AUX.DatFim%TYPE,
    HORFIM   R038HCH_AUX.HorFim%TYPE,
    STAATU   R038HCH_AUX.STAATU%TYPE,
    STAACC   R038HCH_AUX.STAACC%TYPE);

  l_r038hch_aux t_r038hch_aux;

/* CURSOR c/ os registros gravados na R088AUT e R088VEC */
  CURSOR c_r088hch_ins IS SELECT PLAVEI, DATFIM, 1 VEIAUT 
							FROM R088AUT 
						  WHERE EMPCON = l_r038hch_aux.NumEmp 
							AND TCLCON = l_r038hch_aux.TipCol 
							AND CADCON = l_r038hch_aux.NumCad 
							AND DATINI <= l_data_atual 
							AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
					UNION( SELECT PLAVEI, DATETIME(31, 12, 1900, 0, 0, 0) DATFIM, 0 VEIAUT 
							FROM R088VEC
						  WHERE NUMEMP = l_r038hch_aux.NumEmp 
							AND TIPCOL = l_r038hch_aux.TipCol 
							AND NUMCAD = l_r038hch_aux.NumCad);
  TYPE t_r088vei IS RECORD(
    PLAVEI   R088AUT.PlaVei%TYPE,
	DATFIM   R088AUT.DatFim%TYPE,
	VEIAUT   R088AUT.TclAut%TYPE); /* VEIAUT campo auxiliar para verificar posteriormente se veio da R088AUT ou R088VEC */
  l_r088vei t_r088vei; 

BEGIN
  l_data_zero  := DATETIME(31, 12, 1900, 0, 0, 0);
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  SP_VerOnLine(l_online OUT);
  SP_UsaFronline(l_froonl OUT, l_libvei OUT);
  l_cratit := 0;
  l_craprv := 0;
  
  BEGIN
	  SELECT CHCASS INTO l_chcass FROM R070DAC;	
  EXCEPTION
	  WHEN OTHERS THEN
  	    l_chcass := 'N';     
  END;
  	
  /* Le Registro do CURSOR */
  FOREACH c_r038hch_ins INTO  l_r038hch_aux.TipOpe,
                               l_r038hch_aux.TipCra,
                               l_r038hch_aux.NumEmp,
                               l_r038hch_aux.TipCol,
                               l_r038hch_aux.NumCad,
                               l_r038hch_aux.NumCra,
                               l_r038hch_aux.CraOld,
                               l_r038hch_aux.DatIni,
                               l_r038hch_aux.HorIni,
                               l_r038hch_aux.DatFim,
                               l_r038hch_aux.HorFim,
                               l_r038hch_aux.STAATU,
                               l_r038hch_aux.STAACC
  LOOP
     /* consiste sobreposicaode crachás */
     R038HCH_VSOB('I',l_r038hch_aux.TipCra, l_r038hch_aux.NumEmp, l_r038hch_aux.TipCol,l_r038hch_aux.NumCad,
                      l_r038hch_aux.NumCra, l_r038hch_aux.DatIni, l_r038hch_aux.HorIni,
                      l_r038hch_aux.DatFim, l_r038hch_aux.HorFim);

     IF   (l_online = TRUE) THEN
          /* TRATAR O STAATU DO HISTÓRICO */
          L_DATTOL:= l_r038hch_aux.DATINI;
          L_HORTOL:= l_r038hch_aux.HORINI;

          /* tolerância fixa de 5 minutos na hora de entrada */
          IF    l_r038hch_aux.DATINI = l_data_atual THEN
                L_HORTOL := l_r038hch_aux.HORINI-5;
          ELSE  IF (DATETIMEDIF(DD,l_r038hch_aux.DATINI,l_data_atual) = 1) THEN   /* se passou da meia noite */
                    /* verifica quantos minutos passou */
                    L_HORTOL:=1440 - (1440 - l_hora_atual);
                    IF   L_HORTOL <= 5 THEN
                         L_HORTOL := l_hora_atual;
                         L_DATTOL:=l_data_atual;
                    END IF;
                END IF;
          END IF;

          /* Valida Cracha/Datas */
          IF   (l_r038hch_aux.NUMCRA > 0) AND (l_r038hch_aux.STAACC > 0)  THEN
               IF   (L_DATTOL < l_data_atual OR (L_DATTOL = l_data_atual AND L_HORTOL <= l_hora_atual)) AND
                    (l_r038hch_aux.DATFIM = l_data_zero OR l_r038hch_aux.DATFIM > l_data_atual OR (l_r038hch_aux.DATFIM = l_data_atual AND l_r038hch_aux.HORFIM >= l_hora_atual)) THEN

                    /* Atualiza Lista Negra. */
                    R038HCH_ATULN('I',l_r038hch_aux.TipCra, l_r038hch_aux.NumEmp, l_r038hch_aux.TipCol,l_r038hch_aux.NumCad,
                                      l_r038hch_aux.NumCra);

                    /* Atualiza Tabela Controle. */
                    l_subnv_colcon := 0;
                    IF (l_r038hch_aux.TIPOPE = 1 AND l_r038hch_aux.TIPCOL = 2 AND l_r038hch_aux.TIPCRA = 1) THEN
                        l_subnv_colcon := 1;
                    END IF;
                    SP_ColCon ('I', l_r038hch_aux.TIPCRA,
                                    l_r038hch_aux.NUMEMP,
                                    l_r038hch_aux.TIPCOL,
                                    l_r038hch_aux.NUMCAD,0,'0','0',
                                    l_r038hch_aux.DATINI,
                                    l_r038hch_aux.HORINI,
                                    l_r038hch_aux.NUMCRA,
                                    l_r038hch_aux.DATFIM,
                                    l_r038hch_aux.HORFIM, 0,
                                    l_r038hch_aux.STAACC, l_subnv_colcon, 1);

                    /*********** Iniciar montar o IDTPES *****************************/
                    SP_INTSTR(l_r038hch_aux.TIPCOL,'99',l_tippes_str OUT);
                    SP_INTSTR(l_r038hch_aux.NUMEMP,'9999',l_numempidtpes OUT);
                    SP_INTSTR(l_r038hch_aux.TIPCOL,'9',l_tipcolidtpes OUT);
                    SP_INTSTR(l_r038hch_aux.NUMCAD,'999999999',l_numcadidtpes OUT);
                    l_idtpes:= l_tippes_str||l_numempidtpes||l_tipcolidtpes||l_numcadidtpes;
                      /*Preenche o campo com espaços para completar 23 posições*/
                    l_idtpes := lTrim(l_idtpes);
                    l_idtpes := rTrim(l_idtpes);
                    LOOP
                        /*Controle do Loop.*/
                        IF (Length(l_idtpes) > 22) THEN
                            EXIT;
                        END IF;
                        l_idtpes := ' '||l_idtpes;
                    END LOOP;
                    /*********** termina de montar o IDTPES *****************************/
                    SP_ATUPRMLOC (l_idtpes, 0);
                    
                    
                    IF (l_r038hch_aux.TIPCRA = 2) THEN
                        /*Retorna o crachá titular*/
                        SP_RETCRA (1, l_r038hch_aux.NUMEMP, l_r038hch_aux.TIPCOL, l_r038hch_aux.NUMCAD, 0,'',0,'',l_cratit OUT);

                        /* Quando for inserção de novo provisório, atualiza o campo de última passagem para Telemática*/
                        Sp_AUltRs(l_r038hch_aux.NUMCRA , l_cratit);
                    END IF;
               END IF;
          END IF;
		  
		  /*VALIDAÇÕES REFERENTE A VEÍCULOS*/
          /* Verifica se o sistema de frota está trabalhando de forma on-line */
          IF  (l_froonl = TRUE)  AND (l_libvei = 1) THEN 
		  			  
			  l_craprv := 0;
			  l_cratit := 0;
			  /*RETORNA O PROVISÓRIO SE EXISTIR*/
			  SP_RETCRA (2, l_r038hch_aux.NumEmp, l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0,'',0,'',l_craprv OUT);				  
			  /*RETORNA O TITULAR SE EXISTIR*/
		      SP_RETCRA (1, l_r038hch_aux.NumEmp, l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0,'',0,'',l_cratit OUT);	
			  
              FOREACH c_r088hch_ins INTO l_r088vei.PlaVei, l_r088vei.DatFim, l_r088vei.VeiAut 
              LOOP
                 BEGIN
                    SELECT NUMCRA, DATFIM, HORFIM INTO l_cravei, l_datval, l_horval
                                FROM R088HCH
                               WHERE PLAVEI = l_r088vei.PlaVei 
                       AND DATINI <= l_data_atual 
                       AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)  
                       AND STAACC = 1;
                 EXCEPTION
                     WHEN OTHERS THEN 
                        l_cravei := 0;
                 END;
                 IF (l_r088vei.VEIAUT = 1) THEN /* Se é veículo autorizado, então busca o registro na frota(R088VEF) */
                 	BEGIN
                        SELECT 1 INTO l_froaut FROM R088VEF
                            WHERE PLAVEI = l_r088vei.PlaVei 
                              AND DATINI <= l_data_atual 
                              AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero); 
                     EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            l_froaut := 0;
                        WHEN OTHERS THEN 
                            l_froaut := 0;
                     END;
                 END IF;
                 /* Verifica se é veículo de frota e está autorizado ou se for de colaborador e possuir crachá em aberto */
                 IF (l_cravei <> 0 AND (l_r088vei.VEIAUT = 0 OR (l_r088vei.VEIAUT = 1 AND l_froaut = 1))) THEN				 					
                     /*valida data zerada ou maior que 31/12/2050*/
                     IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
                         l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
                       l_horval := 1439;
                     END IF;					 
                     /*VALIDA A MENOR DATA ENTRE AUTORIZAÇÃO E HISTÓRICO DE CRACHÁ DE VEÍCULO*/
                     IF (l_r088vei.DatFim < DATETIME(31, 12, 2050, 0, 0, 0)) AND (l_r088vei.DatFim < l_datval) AND
                     	(l_r088vei.DatFim <> l_data_zero) AND (l_r088vei.VEIAUT = 1) THEN
                     	l_datval := l_r088vei.DatFim;
                     	l_horval := 1439;
                     END IF;
                     /*CRACHÁ TITULAR*/
                     IF (l_r038hch_aux.TIPCRA = 1) THEN						 
                       /*CASO EXISTA PROVISÓRIO ATIVO, A INSERÇÃO DESTE TITULAR SERÁ COM SITUAÇÃO INVÁLIDA*/
                       IF (l_craprv > 0) THEN
                         l_data_ontem := l_data_atual-1;
                         /*baixa com data atual para ontem o TITULAR*/
                         SP_VEIPESCON('I', l_cravei, l_r038hch_aux.NUMCRA, 1, l_r088vei.PlaVei,
                                l_data_ontem, 0, l_r038hch_aux.TipCol, l_r038hch_aux.NumEmp,
                                l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0, '');
                         /*ATUALIZA O PROVISÓRIO*/
                         SP_VEIPESCON('U', l_cravei, l_craprv, 0, l_r088vei.PlaVei, 
                                  l_datval, l_horval, l_r038hch_aux.TipCol, l_r038hch_aux.NumEmp,
                                  l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0, '');
                       ELSE
                           /*insere o titular ativo*/
                         IF (l_r038hch_aux.StaAtu = 2) THEN
                           SP_VEIPESCON('I', l_cravei, l_r038hch_aux.NUMCRA, 1, l_r088vei.PlaVei, 
                                  l_r038hch_aux.DATFIM, l_r038hch_aux.HORFIM, l_r038hch_aux.TipCol, l_r038hch_aux.NumEmp,
                                  l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0, '');
                         ELSE
                           IF (l_r038hch_aux.StaAtu = 1) THEN
                             SP_VEIPESCON('I', l_cravei, l_r038hch_aux.NUMCRA, 0, l_r088vei.PlaVei, 
                                    l_datval, l_horval, l_r038hch_aux.TipCol, l_r038hch_aux.NumEmp,
                                    l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0, '');
                           END IF;
                         END IF;
                       END IF;						 
                     ELSE /*PROVISÓRIO*/ 	
                      IF (l_r038hch_aux.StaAtu = 2) THEN
                        /*insere o provisório DESATIVO*/
                        SP_VEIPESCON('I', l_cravei, l_r038hch_aux.NUMCRA, 1, l_r088vei.PlaVei, 
                                 l_r038hch_aux.DATFIM, l_r038hch_aux.HORFIM, l_r038hch_aux.TipCol, l_r038hch_aux.NumEmp,
                                 l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0, '');
                        IF (l_cratit > 0)  THEN
                           /*BAIXA O TITULAR com a data de início do provisório, POIS, ESTOU INSERINDO UM PROVISÓRIO*/
                           SP_VEIPESCON('U', l_cravei, l_cratit, 0, l_r088vei.PlaVei, 
                                  l_datval, l_horval, l_r038hch_aux.TipCol, l_r038hch_aux.NumEmp,
                                  l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0, '');
                        END IF;
                      ELSE
                        IF (l_r038hch_aux.StaAtu = 1) THEN
                          IF (l_cratit > 0)  THEN
                             /*BAIXA O TITULAR com a data de início do provisório, POIS, ESTOU INSERINDO UM PROVISÓRIO*/
                             SP_VEIPESCON('U', l_cravei, l_cratit, 1, l_r088vei.PlaVei, 
                                    l_r038hch_aux.DATINI, l_r038hch_aux.HORINI, l_r038hch_aux.TipCol, l_r038hch_aux.NumEmp,
                                    l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0, '');
                          END IF;     
                          /*insere o provisório ativo*/
                          SP_VEIPESCON('I', l_cravei, l_r038hch_aux.NUMCRA, 0, l_r088vei.PlaVei, 
                                   l_datval, l_horval, l_r038hch_aux.TipCol, l_r038hch_aux.NumEmp,
                                   l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0, '');
                        END IF;
                      END IF;
                     END IF;
                 END IF;
              END LOOP;
          END IF;
          /*FIM DAS VALIDAÇÕES DE VEÍCULO*/

          /* Atualiza crachá na tabela de benefícios */
          IF  (l_r038hch_aux.STAACC = 1) THEN
              R038HCH_CRABNF(l_r038hch_aux.TIPCRA,
                             l_r038hch_aux.NUMEMP,
                             l_r038hch_aux.TIPCOL,
                             l_r038hch_aux.NUMCAD,
                             l_r038hch_aux.NUMCRA,
                             l_r038hch_aux.DATINI,
                             l_r038hch_aux.HORINI);
          END IF;
          /* Verifica se utiliza biometria */
          BEGIN
             SELECT USABIO INTO l_usabio FROM R034DAC WHERE NUMEMP = l_r038hch_aux.NUMEMP AND TIPCOL = l_r038hch_aux.TIPCOL AND NUMCAD = l_r038hch_aux.NUMCAD;
          EXCEPTION WHEN OTHERS THEN
             l_usabio := 0;
          END;

          IF   (l_usabio = 2) OR (l_usabio = 3) THEN
               /* Se for titular verifica se tem provisório aberto senão verifica se tem titular ativo */
               IF   (l_r038hch_aux.TIPCRA = 1) THEN
                    SP_RETCRA (2, l_r038hch_aux.NUMEMP, l_r038hch_aux.TIPCOL, l_r038hch_aux.NUMCAD, 0,'',0,'',l_craprv OUT);
               ELSE
                    SP_RETCRA (1, l_r038hch_aux.NUMEMP, l_r038hch_aux.TIPCOL, l_r038hch_aux.NUMCAD, 0,'',0,'',l_cratit OUT);
               END IF;

               /* Se não há crachá titular ativo busca o último histórico */
               IF  l_cratit = 0 THEN
                   BEGIN
                       SELECT MAX(DATFIM) INTO l_datfim FROM R038HCH WHERE
                              TIPCRA = 1 AND
                              NUMEMP = l_r038hch_aux.NUMEMP AND
                              TIPCOL = l_r038hch_aux.TIPCOL AND
                              NUMCAD = l_r038hch_aux.NUMCAD;
                   EXCEPTION
                       WHEN OTHERS THEN
                            l_datfim := DATETIME(31, 12, 1900, 0, 0, 0);
                   END;

                   BEGIN
                       SELECT NUMCRA INTO l_cratit FROM R038HCH WHERE
                              DATFIM = l_datfim AND
                              TIPCRA = 1 AND
                              NUMEMP = l_r038hch_aux.NUMEMP AND
                              TIPCOL = l_r038hch_aux.TIPCOL AND
                              NUMCAD = l_r038hch_aux.NUMCAD AND
                              HORFIM = (SELECT MAX(HORFIM) FROM R038HCH WHERE
                                               TIPCRA = 1 AND
                                               NUMEMP = l_r038hch_aux.NUMEMP AND
                                               TIPCOL = l_r038hch_aux.TIPCOL AND
                                               NUMCAD = l_r038hch_aux.NUMCAD AND
                                               DATFIM = l_datfim);
                   EXCEPTION
                       WHEN OTHERS THEN
                            l_cratit := 0;
                   END;
               END IF;
               IF   l_r038hch_aux.TipCra = 1 THEN
                    IF   l_craprv <> 0 THEN /* se existir um provisório ativo */
                         R038HCH_ATUBIO(l_r038hch_aux.NUMCRA , l_craprv);
                    ELSE R038HCH_ATUBIO(l_r038hch_aux.NUMCRA , l_cratit);
                    END IF;
               ELSE
                    /* Se for crachá provisório verifica se tem titular aberto */
                    IF   l_cratit <> 0 THEN /* se existir um titular ativo */
                         IF l_chcass <> 'D' THEN
                         	R038HCH_ATUBIO(l_r038hch_aux.NUMCRA , l_cratit);
                         END IF;
                    ELSE R038HCH_ATUBIO(l_r038hch_aux.NUMCRA , l_craprv);
                    END IF;
               END IF;
          END IF;
     END IF;
    /* Apaga Registro OLD/NEW em R038HCH_AUX */
     BEGIN
       DELETE FROM R038HCH_AUX
        WHERE TIPCRA = l_r038hch_aux.TIPCRA
          AND NUMEMP = l_r038hch_aux.NUMEMP
          AND TIPCOL = l_r038hch_aux.TIPCOL
          AND NUMCAD = l_r038hch_aux.NUMCAD
          AND DATINI = l_r038hch_aux.DATINI
          AND HORINI = l_r038hch_aux.HORINI;         
     EXCEPTION WHEN OTHERS THEN
       NULL;
     END;
  END LOOP;
  DROP_TEMP_TABLE R038HCH_AUX;  
END␀®Ô␀␀		SENIOR;0¯␀␀

TRIGGER R038HCH_EI BEFORE INSERT ON R038HCH FOR EACH ROW

DECLARE
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_idtpes       VARCHAR2(50);
  l_tippes       CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(9);
  l_tipcra       CHAR(1);
  l_data         CHAR(8);
  l_hora         CHAR(4);
  l_ade_gerpen   BOOLEAN;
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HCH_AUX;
  
BEGIN
  /* Inicializa */
  IF  (:NEW.TIPCRA = 1) AND (:NEW.STAATU = 1)  THEN /* VERIFICA SE EH CRACHÁ TITULAR */
      /* atualiza historico de crachá no colaborador*/
      BEGIN
        UPDATE R034FUN
           SET NUMCRA = :NEW.NUMCRA,
               DINCRA = :NEW.DATINI,
               HINCRA = :NEW.HORINI
         WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
               R034FUN.NUMEMP = :NEW.NUMEMP AND
               R034FUN.NUMCAD = :NEW.NUMCAD;
      EXCEPTION WHEN OTHERS THEN
        NULL;
      END;
  END IF;

  BEGIN
    INSERT INTO R038HCH_AUX (TIPOPE,TIPCRA,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,NUMCRA,DATFIM,HORFIM,STAATU,STAACC)
    VALUES (1,:NEW.TIPCRA,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI,:NEW.NUMCRA,:NEW.DATFIM,:NEW.HORFIM,:NEW.STAATU,:NEW.STAACC);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'ON-Line: Erro no INSERT em R038HCH_AUX.';
  END;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R038HCH');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R038HCH_AUD (SEQREG,VERSEQ,TIPCRA,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,VIACRA,
                                   NUMCRA,DATFIM,HORFIM,RECEPR,STAATU,STAACC,CODUSU)
                           VALUES (l_seqreg,l_verseq,:NEW.TIPCRA,:NEW.NUMEMP,:NEW.TIPCOL,
                                  :NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI,:NEW.VIACRA,:NEW.NUMCRA,
                                  :NEW.DATFIM,:NEW.HORFIM,:NEW.RECEPR,:NEW.STAATU,:NEW.STAACC,:NEW.CODUSU);

          SP_AUDGENREG(l_seqreg,l_verseq,'R038HCH','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  IF (:NEW.STAATU = 1) THEN
      /* Atualiza o campo Status Alfandegado no colaborador (ADE-02) */
      SP_RECALF_GERPEN_1(:NEW.TIPCOL, l_ade_gerpen OUT);
      IF (l_ade_gerpen = TRUE) THEN
          SP_RECALF_PRMCOL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, :NEW.NUMCRA, :NEW.DATINI, :NEW.HORINI, :NEW.DATFIM, :NEW.HORFIM, :NEW.TIPCRA);
      END IF;

      SP_INTSTR(:NEW.TIPCOL,'99',l_tippes OUT);
      SP_INTSTR(:NEW.NUMEMP,'9999',l_numemp OUT);
      SP_INTSTR(:NEW.TIPCOL,'9',l_tipcol OUT);
      SP_INTSTR(:NEW.NUMCAD,'999999999',l_numcad OUT);
      SP_INTSTR(:NEW.TIPCRA,'9',l_tipcra OUT);
      SP_DATSTR(:NEW.DATINI,'DDMMYYYY',l_data OUT);
      SP_INTSTR(:NEW.HORINI,'9999',l_hora OUT);
      l_idtpes:= l_tippes||l_numemp||l_tipcol||l_numcad||l_tipcra||l_data||l_hora;
      SP_SAM_PENDENCIES(2,1,l_idtpes);
  END IF;
END␀²Ô␀␀	SENIOR;0‡G␀␀

TRIGGER R038HCH_SU AFTER UPDATE ON R038HCH

DECLARE
  l_online          BOOLEAN;
  l_cravei          NUMBER(12);
  l_cratit          NUMBER(12);
  l_craprv          NUMBER(12);
  l_froonl          BOOLEAN;
  l_data_zero       DATE;
  l_data_atual      DATE;
  l_data_ontem      DATE;
  l_hora_atual      NUMBER(4);
  l_usabio          NUMBER(1);
  l_datfim          DATE;
  l_libvei          NUMBER(1);
  l_tipope          CHAR;
  l_datval          DATE;
  l_horval          NUMBER(4);
  l_tippes_str      CHAR(2);
  l_numempidtpes    CHAR(4);
  l_tipcolidtpes    CHAR(1);
  l_numcadidtpes    CHAR(10);
  l_idtpes          VARCHAR2(23);
  l_froaut          NUMBER(1);

/* CURSOR c/ os registros gravados no R038hch_AUX */
  CURSOR c_r038hch_upd IS SELECT TIPOPE,TIPCRA,NUMEMP,TIPCOL,NUMCAD,NUMCRA,CRAOLD,DATINI,HORINI,DATFIM,HORFIM,STAATU,STAACC FROM R038HCH_AUX;
  TYPE t_r038hch_aux IS RECORD(
    TIPOPE   R038HCH_AUX.TipOpe%TYPE,
    TIPCRA   R038HCH_AUX.TipCra%TYPE,
    NUMEMP   R038HCH_AUX.NumEmp%TYPE,
    TIPCOL   R038HCH_AUX.TipCol%TYPE,
    NUMCAD   R038HCH_AUX.NumCad%TYPE,
    NUMCRA   R038HCH_AUX.NumCra%TYPE,
    CRAOLD   R038HCH_AUX.CraOld%TYPE,
    DATINI   R038HCH_AUX.DatIni%TYPE,
    HORINI   R038HCH_AUX.HorIni%TYPE,
    DATFIM   R038HCH_AUX.DatFim%TYPE,
    HORFIM   R038HCH_AUX.HorFim%TYPE,
    STAATU   R038HCH_AUX.STAATU%TYPE,
    STAACC   R038HCH_AUX.STAACC%TYPE);

  l_r038hch_aux t_r038hch_aux;

/* CURSOR c/ os registros gravados na R088AUT e R088VEC */
  CURSOR c_r088hch_upd IS SELECT PLAVEI, DATFIM, 1 VEIAUT 
							FROM R088AUT 
						  WHERE EMPCON = l_r038hch_aux.NumEmp 
							AND TCLCON = l_r038hch_aux.TipCol 
							AND CADCON = l_r038hch_aux.NumCad 
							AND DATINI <= l_data_atual 
							AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
					UNION( SELECT PLAVEI, DATETIME(31, 12, 1900, 0, 0, 0) DATFIM, 0 VEIAUT 
							FROM R088VEC
						  WHERE NUMEMP = l_r038hch_aux.NumEmp 
							AND TIPCOL = l_r038hch_aux.TipCol 
							AND NUMCAD = l_r038hch_aux.NumCad);
  TYPE t_r088vei IS RECORD(
    PLAVEI   R088AUT.PlaVei%TYPE,
	DATFIM   R088AUT.DatFim%TYPE,
	VEIAUT   R088AUT.TclAut%TYPE); /* VEIAUT campo auxiliar para verificar posteriormente se veio da R088AUT ou R088VEC */
  l_r088vei t_r088vei;   

BEGIN
  l_data_zero  := DATETIME(31, 12, 1900, 0, 0, 0);
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  SP_VerOnLine(l_online OUT);
  SP_UsaFronline(l_froonl OUT, l_libvei OUT);
  l_cratit := 0;
  /* Le Registro do CURSOR */
  FOREACH c_r038hch_upd INTO  l_r038hch_aux.TipOpe,
                               l_r038hch_aux.TipCra,
                               l_r038hch_aux.NumEmp,
                               l_r038hch_aux.TipCol,
                               l_r038hch_aux.NumCad,
                               l_r038hch_aux.NumCra,
                               l_r038hch_aux.CraOld,
                               l_r038hch_aux.DatIni,
                               l_r038hch_aux.HorIni,
                               l_r038hch_aux.DatFim,
                               l_r038hch_aux.HorFim,
                               l_r038hch_aux.STAATU,
                               l_r038hch_aux.STAACC
													   		   
  LOOP
     /* consiste sobreposicao de crachás */
     R038HCH_VSOB('U',l_r038hch_aux.TipCra, l_r038hch_aux.NumEmp, l_r038hch_aux.TipCol, l_r038hch_aux.NumCad,
                       l_r038hch_aux.NumCra,l_r038hch_aux.DatIni, l_r038hch_aux.HorIni,
                       l_r038hch_aux.DatFim,l_r038hch_aux.HorFim);

     /* Na baixa do historico atualiza a Lista Negra. */
     IF   (l_r038hch_aux.TIPOPE = 1)
     AND  ((l_r038hch_aux.DATFIM < l_data_atual)
     OR   ((l_r038hch_aux.DATFIM = l_data_atual) AND (l_r038hch_aux.HORFIM <= l_hora_atual)))  THEN
          R038HCH_ATULN('U',l_r038hch_aux.TipCra, l_r038hch_aux.NumEmp, l_r038hch_aux.TipCol,l_r038hch_aux.NumCad,
                            l_r038hch_aux.NumCra);
     END IF;

  /* Quando o novo STAATU esta setado como 1 significa que esta querendo gerar somente o controle novamente */
     IF   (l_r038hch_aux.TIPOPE = 1) OR (l_r038hch_aux.TIPOPE = 3)THEN
          IF (l_r038hch_aux.TIPOPE = 3) THEN
              l_tipope := 'A';
          ELSE
              l_tipope := 'U';
          END IF;

          /* Atualiza Tabela Controle. */
          SP_ColCon(l_tipope, l_r038hch_aux.TIPCRA,
                              l_r038hch_aux.NUMEMP,
                              l_r038hch_aux.TIPCOL,
                              l_r038hch_aux.NUMCAD,0,'0','0',
                              l_r038hch_aux.DATINI,
                              l_r038hch_aux.HORINI,
                              l_r038hch_aux.NUMCRA,
                              l_r038hch_aux.DATFIM,
                              l_r038hch_aux.HORFIM,
                              l_r038hch_aux.CRAOLD,
                              l_r038hch_aux.STAACC, 0, 1);
                              
          /*********** Iniciar montar o IDTPES *****************************/
          SP_INTSTR(l_r038hch_aux.TIPCOL,'99',l_tippes_str OUT);
          SP_INTSTR(l_r038hch_aux.NUMEMP,'9999',l_numempidtpes OUT);
          SP_INTSTR(l_r038hch_aux.TIPCOL,'9',l_tipcolidtpes OUT);
          SP_INTSTR(l_r038hch_aux.NUMCAD,'999999999',l_numcadidtpes OUT);
          l_idtpes:= l_tippes_str||l_numempidtpes||l_tipcolidtpes||l_numcadidtpes;
            /*Preenche o campo com espaços para completar 23 posições*/
          l_idtpes := lTrim(l_idtpes);
          l_idtpes := rTrim(l_idtpes);
          LOOP
              /*Controle do Loop.*/
              IF (Length(l_idtpes) > 22) THEN
                  EXIT;
              END IF;
              l_idtpes := ' '||l_idtpes;
          END LOOP;
          /*********** termina de montar o IDTPES *****************************/
          SP_ATUPRMLOC (l_idtpes, 0);

          IF (l_r038hch_aux.TIPCRA = 2) THEN
              IF (l_r038hch_aux.DATFIM < l_data_atual) OR
                   ((l_r038hch_aux.DATFIM = l_data_atual) AND (l_r038hch_aux.HORFIM <= l_hora_atual)) THEN

                   /* Verifica se possui crachá titular ativo */
                   SP_RETCRA (1, l_r038hch_aux.NUMEMP, l_r038hch_aux.TIPCOL, l_r038hch_aux.NUMCAD, 0,'',0,'',l_cratit OUT);

                   /* Se não há crachá titular ativo busca o último histórico */
                   IF  l_cratit = 0 THEN
                       BEGIN
                           SELECT MAX(DATFIM) INTO l_datfim FROM R038HCH WHERE
                              TIPCRA = 1 AND
                              NUMEMP = l_r038hch_aux.NUMEMP AND
                              TIPCOL = l_r038hch_aux.TIPCOL AND
                              NUMCAD = l_r038hch_aux.NUMCAD;
                       EXCEPTION WHEN OTHERS THEN
                              l_datfim := DATETIME(31, 12, 1900, 0, 0, 0);
                       END;
                       BEGIN
                           SELECT NUMCRA INTO l_cratit FROM R038HCH WHERE
                                  DATFIM = l_datfim AND
                                  TIPCRA = 1 AND
                                  NUMEMP = l_r038hch_aux.NUMEMP AND
                                  TIPCOL = l_r038hch_aux.TIPCOL AND
                                  NUMCAD = l_r038hch_aux.NUMCAD AND
                                  HORFIM = (SELECT MAX(HORFIM) FROM R038HCH WHERE
                                                   TIPCRA = 1 AND
                                                   NUMEMP = l_r038hch_aux.NUMEMP AND
                                                   TIPCOL = l_r038hch_aux.TIPCOL AND
                                                   NUMCAD = l_r038hch_aux.NUMCAD AND
                                                   DATFIM = l_datfim);
                       EXCEPTION
                           WHEN NO_DATA_FOUND THEN
                                l_cratit := 0;
                       END;
                   END IF;

                   /* Quando for baixa de provisório, atualiza o campo de última passagem para Telemática do titular*/
                   Sp_AUltRs(l_cratit,l_r038hch_aux.NUMCRA);

              END IF;
          END IF;
     END IF;
	 
	 /*VALIDAÇÕES REFERENTE A VEÍCULOS*/
     /* Verifica se o sistema de frota está trabalhando de forma on-line */
     IF  (l_online = TRUE) AND (l_froonl = TRUE) AND (l_libvei = 1) THEN
	 
		 l_craprv := 0;
		 l_cratit := 0;
		 /*RETORNA O PROVISÓRIO SE EXISTIR*/
		 SP_RETCRA (2, l_r038hch_aux.NumEmp, l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0,'',0,'',l_craprv OUT);				  
		 /*RETORNA O TITULAR SE EXISTIR*/
		 SP_RETCRA (1, l_r038hch_aux.NumEmp, l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0,'',0,'',l_cratit OUT);

         FOREACH c_r088hch_upd INTO  l_r088vei.PlaVei, l_r088vei.DatFim, l_r088vei.VeiAut 
         LOOP
             BEGIN
             SELECT NUMCRA, DATFIM, HORFIM INTO l_cravei, l_datval, l_horval
                FROM R088HCH
                WHERE PLAVEI = l_r088vei.PlaVei
                  AND DATINI <= l_data_atual
                  AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
                  AND STAACC = 1;
             EXCEPTION
               WHEN OTHERS THEN l_cravei := 0;
             END;
             IF (l_r088vei.VEIAUT = 1) THEN /* Se é veículo autorizado, então busca o registro na frota(R088VEF) */
             	BEGIN
                    SELECT 1 INTO l_froaut FROM R088VEF
           	            WHERE PLAVEI = l_r088vei.PlaVei 
                          AND DATINI <= l_data_atual 
                          AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero); 
                 EXCEPTION
                 	WHEN NO_DATA_FOUND THEN
                        l_froaut := 0;
                    WHEN OTHERS THEN 
                        l_froaut := 0;
                 END;
             END IF;
             /* Verifica se é veículo de frota e está autorizado ou se for de colaborador e possuir crachá em aberto */
             IF (l_cravei <> 0 AND (l_r088vei.VEIAUT = 0 OR (l_r088vei.VEIAUT = 1 AND l_froaut = 1))) THEN	
                /*valida data zerada ou maior que 31/12/2050*/
                  IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
                    l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
                    l_horval := 1439;
                END IF;
                /*VALIDA A MENOR DATA ENTRE AUTORIZAÇÃO E HISTÓRICO DE CRACHÁ DE VEÍCULO*/
                IF (l_r088vei.DatFim < DATETIME(31, 12, 2050, 0, 0, 0)) AND (l_r088vei.DatFim < l_datval) AND
                	(l_r088vei.DatFim <> l_data_zero) AND (l_r088vei.VeiAut = 1) THEN
                	l_datval := l_r088vei.DatFim;
                	l_horval := 1439;
                END IF;

                /*CRACHÁ TITULAR*/
                IF (l_r038hch_aux.TIPCRA = 1) THEN
                  /*CASO EXISTA PROVISÓRIO ATIVO, A INSERÇÃO DESTE TITULAR SERÁ COM SITUAÇÃO INVÁLIDA*/
                    IF (l_craprv > 0) THEN
                      l_data_ontem := l_data_atual-1;
                      /*baixa o titular com data de validade para ontem*/
                      SP_VEIPESCON('U', l_cravei, l_r038hch_aux.NumCra, 1, l_r088vei.PlaVei, l_data_ontem, 0,
                             l_r038hch_aux.TipCol, l_r038hch_aux.NUMEMP, l_r038hch_aux.TipCol, l_r038hch_aux.NUMCAD, 0, '');
                      /*atualiza o provisório ativo*/
                      SP_VEIPESCON('U', l_cravei, l_craprv, 0, l_r088vei.PlaVei, l_datval, l_horval,
                             l_r038hch_aux.TipCol, l_r038hch_aux.NUMEMP, l_r038hch_aux.TipCol, l_r038hch_aux.NUMCAD, 0, '');
                  ELSE
                      /*atualiza o titular ativo*/
                    IF (l_r038hch_aux.StaAtu = 2) THEN
                      SP_VEIPESCON('U', l_cravei, l_r038hch_aux.NumCra, 1, l_r088vei.PlaVei, l_r038hch_aux.DATFIM, l_r038hch_aux.HORFIM,
                             l_r038hch_aux.TipCol, l_r038hch_aux.NUMEMP, l_r038hch_aux.TipCol, l_r038hch_aux.NUMCAD, 0, '');	
                    ELSE
                      IF (l_r038hch_aux.StaAtu = 1) THEN
                        SP_VEIPESCON('U', l_cravei, l_r038hch_aux.NumCra, 0, l_r088vei.PlaVei, l_datval, l_horval,
                               l_r038hch_aux.TipCol, l_r038hch_aux.NUMEMP, l_r038hch_aux.TipCol, l_r038hch_aux.NUMCAD, 0, '');
                      END IF;
                    END IF;
                  END IF;
                ELSE /*PROVISÓRIO*/
                  IF (l_r038hch_aux.StaAtu = 2) THEN
                    l_data_ontem := l_data_atual-1;
                    /*atualiza o provisório ativo*/
                    SP_VEIPESCON('U', l_cravei, l_r038hch_aux.NumCra, 1, l_r088vei.PlaVei, l_data_ontem, 0,
                             l_r038hch_aux.TipCol, l_r038hch_aux.NUMEMP, l_r038hch_aux.TipCol, l_r038hch_aux.NUMCAD, 0, '');
                    IF (l_cratit > 0) THEN
                      /*baixa o titular com data de início do provisório*/
                      SP_VEIPESCON('U', l_cravei, l_cratit, 0, l_r088vei.PlaVei, l_datval, l_horval,
                             l_r038hch_aux.TipCol, l_r038hch_aux.NUMEMP, l_r038hch_aux.TipCol, l_r038hch_aux.NUMCAD, 0, '');
                    END IF;
                  ELSE		
                    IF (l_r038hch_aux.StaAtu = 1) THEN							
                      IF (l_cratit > 0) THEN
                        /*baixa o titular com data de início do provisório*/
                        SP_VEIPESCON('U', l_cravei, l_cratit, 1, l_r088vei.PlaVei, l_r038hch_aux.DATINI, l_r038hch_aux.HORINI,
                               l_r038hch_aux.TipCol, l_r038hch_aux.NUMEMP, l_r038hch_aux.TipCol, l_r038hch_aux.NUMCAD, 0, '');
                      END IF;
                      /*atualiza o provisório ativo*/
                      SP_VEIPESCON('U', l_cravei, l_r038hch_aux.NumCra, 0, l_r088vei.PlaVei, l_datval, l_horval,
                             l_r038hch_aux.TipCol, l_r038hch_aux.NUMEMP, l_r038hch_aux.TipCol, l_r038hch_aux.NUMCAD, 0, '');
                    END IF;
                  END IF;										
                END IF;
             END IF;
         END LOOP;
     END IF;
	 /*FIM DAS VALIDAÇÕES DE VEÍCULO*/

     IF  (l_online = TRUE) THEN
         IF  ((l_r038hch_aux.DATFIM < l_data_atual) OR
             ((l_r038hch_aux.DATFIM = l_data_atual) AND (l_r038hch_aux.HORFIM < l_hora_atual))) THEN
             /* Atualiza crachá na tabela de benefícios */
             R038HCH_TITBNF( 'F',
                            l_r038hch_aux.TIPCRA,
                            l_r038hch_aux.NUMEMP,
                            l_r038hch_aux.TIPCOL,
                            l_r038hch_aux.NUMCAD,
                            l_r038hch_aux.NUMCRA);
         ELSE
             /* Atualiza crachá na tabela de benefícios */
             R038HCH_TITBNF( 'A',
                            l_r038hch_aux.TIPCRA,
                            l_r038hch_aux.NUMEMP,
                            l_r038hch_aux.TIPCOL,
                            l_r038hch_aux.NUMCAD,
                            l_r038hch_aux.NUMCRA);
         END IF;
     END IF;

     /* Verifica se utiliza biometria */
     BEGIN
        SELECT USABIO INTO l_usabio FROM R034DAC WHERE NUMEMP = l_r038hch_aux.NUMEMP AND TIPCOL = l_r038hch_aux.TIPCOL AND NUMCAD = l_r038hch_aux.NUMCAD;
     EXCEPTION WHEN OTHERS THEN
        l_usabio := 1;
     END;

     IF   ((l_usabio = 2) OR (l_usabio = 3)) AND (l_r038hch_aux.TIPCRA = 2) THEN
          IF   (l_r038hch_aux.DATFIM < l_data_atual) OR
               ((l_r038hch_aux.DATFIM = l_data_atual) AND (l_r038hch_aux.HORFIM <= l_hora_atual)) THEN

               /* Verifica se possui crachá titular ativo */
               SP_RETCRA (1, l_r038hch_aux.NUMEMP, l_r038hch_aux.TIPCOL, l_r038hch_aux.NUMCAD, 0,'',0,'',l_cratit OUT);

               /* Se não há crachá titular ativo busca o último histórico */
               IF  l_cratit = 0 THEN
                   BEGIN
                       SELECT MAX(DATFIM) INTO l_datfim FROM R038HCH WHERE
                          TIPCRA = 1 AND
                          NUMEMP = l_r038hch_aux.NUMEMP AND
                          TIPCOL = l_r038hch_aux.TIPCOL AND
                          NUMCAD = l_r038hch_aux.NUMCAD;
                   EXCEPTION WHEN OTHERS THEN
                          l_datfim := DATETIME(31, 12, 1900, 0, 0, 0);
                   END;
                   BEGIN
                       SELECT NUMCRA INTO l_cratit FROM R038HCH WHERE
                              DATFIM = l_datfim AND
                              TIPCRA = 1 AND
                              NUMEMP = l_r038hch_aux.NUMEMP AND
                              TIPCOL = l_r038hch_aux.TIPCOL AND
                              NUMCAD = l_r038hch_aux.NUMCAD AND
                              HORFIM = (SELECT MAX(HORFIM) FROM R038HCH WHERE
                                               TIPCRA = 1 AND
                                               NUMEMP = l_r038hch_aux.NUMEMP AND
                                               TIPCOL = l_r038hch_aux.TIPCOL AND
                                               NUMCAD = l_r038hch_aux.NUMCAD AND
                                               DATFIM = l_datfim);
                   EXCEPTION
                       WHEN NO_DATA_FOUND THEN
                            l_cratit := 0;
                   END;
               END IF;

               R038HCH_ATUBIO(l_cratit, l_r038hch_aux.NUMCRA);
          END IF;
     END IF;
    /* Apaga Registro OLD/NEW em R038HCH_AUX */
     BEGIN
       DELETE FROM R038HCH_AUX
        WHERE TIPCRA = l_r038hch_aux.TIPCRA
          AND NUMEMP = l_r038hch_aux.NUMEMP
          AND TIPCOL = l_r038hch_aux.TIPCOL
          AND NUMCAD = l_r038hch_aux.NUMCAD
          AND DATINI = l_r038hch_aux.DATINI
          AND HORINI = l_r038hch_aux.HORINI;         
     EXCEPTION WHEN OTHERS THEN
       NULL;
     END;
  END LOOP;
  DROP_TEMP_TABLE R038HCH_AUX;  
END␀¯Ô␀␀		SENIOR;0G#␀␀

TRIGGER R038HCH_EU AFTER UPDATE ON R038HCH FOR EACH ROW

DECLARE
l_data_zero       DATE;
  l_data_atual      DATE;
  l_hora_atual      NUMBER(4);
  l_numcra          NUMBER(12);
  l_tipope          NUMBER(1);
  l_HinCra          NUMBER(5);
  l_online          BOOLEAN;
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_idtpes       VARCHAR2(50);
  l_tippes       CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(9);
  l_tipcra       CHAR(1);
  l_data         CHAR(8);
  l_hora         CHAR(4);
  l_ade_gerpen   BOOLEAN;

  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HCH_AUX;  
  
BEGIN
  /* Inicializa */
  SP_VerOnLine(l_online OUT);
  l_tipope := 0;
  l_data_zero  := DATETIME(31, 12, 1900, 0, 0, 0);

  IF  (:NEW.TIPCRA = 1) AND (:NEW.STAATU = 1) THEN /* VERIFICA SE EH CRACHÁ TITULAR */
        /* atualiza historico de crachá no colaborador*/
      BEGIN
        UPDATE R034FUN
           SET NUMCRA = :NEW.NUMCRA,
               DINCRA = :NEW.DATINI,
               HINCRA = :NEW.HORINI
         WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
               R034FUN.NUMEMP = :NEW.NUMEMP AND
               R034FUN.NUMCAD = :NEW.NUMCAD;
      EXCEPTION WHEN OTHERS THEN
        NULL;
      END;
  END IF;

  IF  (:OLD.STAATU = 1) AND (:NEW.STAATU = 2) AND (:NEW.TIPCRA = 1) THEN /* EH CRACHÁ TITULAR MUDANDO DE TITULAR PARA PASSADO. */
        /* Atualiza tabela de colaboradores */
         BEGIN
           UPDATE R034FUN
              SET NUMCRA = 0,
                  DINCRA = l_data_zero,
                  HINCRA = 0
            WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                  R034FUN.NUMEMP = :NEW.NUMEMP AND
                  R034FUN.NUMCAD = :NEW.NUMCAD AND
                  R034FUN.NUMCRA = :OLD.Numcra;
         EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'Erro Na Atualização do R034FUN';
         END;
     END IF;

  /* se esta voltando o status de 4 para 2 ou de 3 para 1 então não precisa atualizar nada e não gera o registro na auxiliar */
  IF (:OLD.STAACC < 3) THEN

      IF   (l_online = TRUE) THEN
           l_data_zero  := DATETIME(31, 12, 1900, 0, 0, 0);
           l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
           l_data_atual := CURDATE();
           /* Valida Cracha/Datas */
           IF   (:NEW.NUMCRA > 0)  THEN
                IF    ((:OLD.STAATU <> :NEW.STAATU) OR (:OLD.STAACC <> :NEW.STAACC) OR
                      ((:NEW.NUMCRA <> :OLD.NUMCRA OR :NEW.DATFIM <> :OLD.DATFIM OR :NEW.HORFIM <> :OLD.HORFIM) AND
                      (((:NEW.DATINI < l_data_atual OR (:NEW.DATINI = l_data_atual AND :NEW.HORINI <= l_hora_atual)) AND
                        (:NEW.DATFIM = l_data_zero OR :NEW.DATFIM > l_data_atual OR (:NEW.DATFIM = l_data_atual AND :NEW.HORFIM >= l_hora_atual))) OR
                       ((:OLD.DATINI < l_data_atual OR (:OLD.DATINI = l_data_atual AND :OLD.HORINI <= l_hora_atual)) AND
                        (:OLD.DATFIM = l_data_zero OR :OLD.DATFIM > l_data_atual OR (:OLD.DATFIM = l_data_atual AND :OLD.HORFIM >= l_hora_atual)))))) THEN
                       l_tipope := 1;
                END IF;
           END IF;
           IF (:NEW.STAACC = 3) THEN
               l_tipope := 3;
           END IF;
      END IF;
  END IF;

  BEGIN
    INSERT INTO R038HCH_AUX (TIPOPE,TIPCRA,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,NUMCRA,CRAOLD,DATFIM,HORFIM,STAATU,STAACC)
    VALUES (l_tipope,:NEW.TIPCRA,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI,:NEW.NUMCRA,:OLD.NUMCRA,:NEW.DATFIM,:NEW.HORFIM,:NEW.STAATU,:NEW.STAACC);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'ON-Line: Erro no INSERT em R038HCH_AUX.';
  END;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R038HCH');

  IF (l_auditoria = 'S') THEN

       l_camposAlterados := 'Campo(s) alterado(s): ';
       l_alterou := FALSE;

      IF (:NEW.TIPCRA <> :OLD.TIPCRA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPCRA ';
      END IF;

      IF (:NEW.NUMEMP <> :OLD.NUMEMP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMEMP ';
      END IF;

      IF (:NEW.TIPCOL <> :OLD.TIPCOL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPCOL ';
      END IF;

      IF (:NEW.NUMCAD <> :OLD.NUMCAD) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCAD ';
      END IF;

      IF (:NEW.DATINI <> :OLD.DATINI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATINI ';
      END IF;

      IF (:NEW.HORINI <> :OLD.HORINI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORINI ';
      END IF;

      IF (:NEW.VIACRA <> :OLD.VIACRA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'VIACRA ';
      END IF;

      IF (:NEW.NUMCRA <> :OLD.NUMCRA) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCRA ';
      END IF;

      IF (:NEW.DATFIM <> :OLD.DATFIM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATFIM ';
      END IF;

      IF (:NEW.HORFIM <> :OLD.HORFIM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORFIM ';
      END IF;

      IF (:NEW.RECEPR <> :OLD.RECEPR) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'RECEPR ';
      END IF;

      IF (:NEW.STAATU <> :OLD.STAATU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'STAATU ';
      END IF;

      IF (:NEW.STAACC <> :OLD.STAACC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'STAACC ';
      END IF;

      IF (:NEW.CODUSU <> :OLD.CODUSU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODUSU ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R038HCH_AUD
                   WHERE TIPCRA = :OLD.TIPCRA AND
                         NUMEMP = :OLD.NUMEMP AND
                         TIPCOL = :OLD.TIPCOL AND
                         NUMCAD = :OLD.NUMCAD AND
                         DATINI = :OLD.DATINI AND
                         HORINI = :OLD.HORINI;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R038HCH_AUD (SEQREG,VERSEQ,TIPCRA,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,VIACRA,
                                       NUMCRA,DATFIM,HORFIM,RECEPR,STAATU,STAACC,CODUSU)
                               VALUES (l_seqreg,l_verseq,:NEW.TIPCRA,:NEW.NUMEMP,:NEW.TIPCOL,
                                      :NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI,:NEW.VIACRA,:NEW.NUMCRA,
                                      :NEW.DATFIM,:NEW.HORFIM,:NEW.RECEPR,:NEW.STAATU,:NEW.STAACC,:NEW.CODUSU);

              SP_AUDGENREG(l_seqreg,l_verseq,'R038HCH',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  IF (:NEW.STAATU = 1 OR :OLD.STAATU = 1) THEN
      /* Atualiza o campo Status Alfandegado no colaborador (ADE-02) */
      SP_RECALF_GERPEN_1(:NEW.TIPCOL, l_ade_gerpen OUT);
      IF (l_ade_gerpen = TRUE) THEN
          IF (:NEW.STAATU = 1) THEN
              SP_RECALF_PRMCOL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, :NEW.NUMCRA, :NEW.DATINI, :NEW.HORINI, :NEW.DATFIM, :NEW.HORFIM, :NEW.TIPCRA);
          ELSE
              SP_RECALF_PRMCOL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
          END IF;
      END IF;

      SP_INTSTR(:NEW.TIPCOL,'99',l_tippes OUT);
      SP_INTSTR(:NEW.NUMEMP,'9999',l_numemp OUT);
      SP_INTSTR(:NEW.TIPCOL,'9',l_tipcol OUT);
      SP_INTSTR(:NEW.NUMCAD,'999999999',l_numcad OUT);
      SP_INTSTR(:NEW.TIPCRA,'9',l_tipcra OUT);
      SP_DATSTR(:NEW.DATINI,'DDMMYYYY',l_data OUT);
      SP_INTSTR(:NEW.HORINI,'9999',l_hora OUT);
      l_idtpes:= l_tippes||l_numemp||l_tipcol||l_numcad||l_tipcra||l_data||l_hora;
      SP_SAM_PENDENCIES(2,2,l_idtpes);
  END IF;

END␀°Ô␀␀	SENIOR;0=␀␀

TRIGGER R038HCH_SD AFTER DELETE ON R038HCH

DECLARE
  l_data_zero       DATE;
  l_data_atual      DATE;
  l_hora_atual      NUMBER(4);
  l_numcra          NUMBER(12);
  l_DinCra          DATE;
  l_tipope          NUMBER(1);
  l_HinCra          NUMBER(5);
  l_comando_nulo    BOOLEAN;
  l_valido          BOOLEAN;
  l_online          BOOLEAN;
  l_datini          DATE;
  l_datant          DATE;
  l_count           NUMBER(5);
  l_horini          NUMBER(5);
  l_errstr          VARCHAR2(255);
  l_cravei          NUMBER(12);
  l_cratit          NUMBER(12);
  l_craprv          NUMBER(12);
  l_froonl          BOOLEAN;
  l_usabio          NUMBER(1);
  l_datfim          DATE;
  l_libvei          NUMBER(1);
  l_datval          DATE;
  l_horval          NUMBER(4);
  l_tippes_str      CHAR(2);
  l_numempidtpes    CHAR(4);
  l_tipcolidtpes    CHAR(1);
  l_numcadidtpes    CHAR(10);
  l_idtpes          VARCHAR2(23);
  l_froaut          NUMBER(1);

/* CURSOR c/ os registros gravados no R038hch_AUX */
  CURSOR c_r038hch_del IS SELECT TIPOPE,TIPCRA,NUMEMP,TIPCOL,NUMCAD,NUMCRA,CRAOLD,DATINI,HORINI,DATFIM,HORFIM,STAATU,STAACC FROM R038HCH_AUX;
  TYPE t_r038hch_aux IS RECORD(
    TIPOPE   R038HCH_AUX.TipOpe%TYPE,
    TIPCRA   R038HCH_AUX.TipCra%TYPE,
    NUMEMP   R038HCH_AUX.NumEmp%TYPE,
    TIPCOL   R038HCH_AUX.TipCol%TYPE,
    NUMCAD   R038HCH_AUX.NumCad%TYPE,
    NUMCRA   R038HCH_AUX.NumCra%TYPE,
    CRAOLD   R038HCH_AUX.CraOld%TYPE,
    DATINI   R038HCH_AUX.DatIni%TYPE,
    HORINI   R038HCH_AUX.HorIni%TYPE,
    DATFIM   R038HCH_AUX.DatFim%TYPE,
    HORFIM   R038HCH_AUX.HorFim%TYPE,
    STAATU   R038HCH_AUX.STAATU%TYPE,
    STAACC   R038HCH_AUX.STAACC%TYPE);

  l_r038hch_aux t_r038hch_aux;
  
/* CURSOR c/ os registros gravados na R088AUT e R088VEC */
  CURSOR c_r088hch_del IS SELECT PLAVEI, DATFIM, 1 VEIAUT 
                            FROM R088AUT 
						  WHERE EMPCON = l_r038hch_aux.NumEmp 
							AND TCLCON = l_r038hch_aux.TipCol 
							AND CADCON = l_r038hch_aux.NumCad 
							AND DATINI <= l_data_atual 
							AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)
					UNION( SELECT PLAVEI, DATETIME(31, 12, 1900, 0, 0, 0) DATFIM, 0 VEIAUT 
							FROM R088VEC
						  WHERE NUMEMP = l_r038hch_aux.NumEmp 
							AND TIPCOL = l_r038hch_aux.TipCol 
							AND NUMCAD = l_r038hch_aux.NumCad);
  TYPE t_r088vei IS RECORD(
    PLAVEI   R088AUT.PlaVei%TYPE,
	DATFIM   R088AUT.DatFim%TYPE,
	VEIAUT   R088AUT.TclAut%TYPE); /* VEIAUT campo auxiliar para verificar posteriormente se veio da R088AUT ou R088VEC */
  l_r088vei t_r088vei; 

BEGIN
  l_data_zero  := DATETIME(31, 12, 1900, 0, 0, 0);
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  SP_VerOnLine(l_online OUT);
  SP_UsaFronline(l_froonl OUT, l_libvei OUT);
  l_cratit := 0;

  /* Le Registro do CURSOR */
  FOREACH c_r038hch_del INTO  l_r038hch_aux.TipOpe,
                              l_r038hch_aux.TipCra,
                              l_r038hch_aux.NumEmp,
                              l_r038hch_aux.TipCol,
                              l_r038hch_aux.NumCad,
                              l_r038hch_aux.NumCra,
                              l_r038hch_aux.CraOld,
                              l_r038hch_aux.DatIni,
                              l_r038hch_aux.HorIni,
                              l_r038hch_aux.DatFim,
                              l_r038hch_aux.HorFim,
                              l_r038hch_aux.STAATU,
                              l_r038hch_aux.STAACC
  LOOP

     IF  l_r038hch_aux.TIPCRA = 1 THEN /* EH CRACHÁ TITULAR */

        /* Atualiza tabela de colaboradores */
         BEGIN
           UPDATE R034FUN
              SET NUMCRA = 0,
                  DINCRA = l_data_zero,
                  HINCRA = 0
            WHERE R034FUN.TIPCOL = l_r038hch_aux.TIPCOL AND
                  R034FUN.NUMEMP = l_r038hch_aux.NUMEMP AND
                  R034FUN.NUMCAD = l_r038hch_aux.NUMCAD;
         EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'Erro Na Atualização do R034FUN';
         END;
     END IF;

     /* Atualiza Telematica */
     IF   (l_online = TRUE)
     AND  (l_r038hch_aux.NUMCRA > 0)
     AND  ((l_r038hch_aux.DATINI < l_data_atual OR (l_r038hch_aux.DATINI = l_data_atual AND l_r038hch_aux.HORINI <= l_hora_atual)) AND
           (l_r038hch_aux.DATFIM = l_data_zero OR l_r038hch_aux.DATFIM > l_data_atual OR (l_r038hch_aux.DATFIM = l_data_atual AND l_r038hch_aux.HORFIM >= l_hora_atual))) THEN

          /* Atualiza Lista Negra. */
          R038HCH_ATULN('D',l_r038hch_aux.TipCra, l_r038hch_aux.NumEmp, l_r038hch_aux.TipCol,l_r038hch_aux.NumCad,
                            l_r038hch_aux.NumCra);

          /* Atualiza Tabela Controle. */
          sp_colcon ('D', l_r038hch_aux.TIPCRA,
                          l_r038hch_aux.NUMEMP,
                          l_r038hch_aux.TIPCOL,
                          l_r038hch_aux.NUMCAD,0,'0','0',
                          l_r038hch_aux.DATINI,
                          l_r038hch_aux.HORINI,
                          l_r038hch_aux.NUMCRA,
                          l_r038hch_aux.DATFIM,
                          l_r038hch_aux.HORFIM, 0,
                          l_r038hch_aux.STAACC, 0, 1);
                          
           /*********** Iniciar montar o IDTPES *****************************/
           SP_INTSTR(l_r038hch_aux.TIPCOL,'99',l_tippes_str OUT);
           SP_INTSTR(l_r038hch_aux.NUMEMP,'9999',l_numempidtpes OUT);
           SP_INTSTR(l_r038hch_aux.TIPCOL,'9',l_tipcolidtpes OUT);
           SP_INTSTR(l_r038hch_aux.NUMCAD,'999999999',l_numcadidtpes OUT);
           l_idtpes:= l_tippes_str||l_numempidtpes||l_tipcolidtpes||l_numcadidtpes;
             /*Preenche o campo com espaços para completar 23 posições*/
           l_idtpes := lTrim(l_idtpes);
           l_idtpes := rTrim(l_idtpes);
           LOOP
               /*Controle do Loop.*/
               IF (Length(l_idtpes) > 22) THEN
                   EXIT;
               END IF;
               l_idtpes := ' '||l_idtpes;
           END LOOP;
           /*********** termina de montar o IDTPES *****************************/
           SP_ATUPRMLOC (l_idtpes, 0);

          IF  (l_r038hch_aux.tipcra = 2) THEN
                /* Verifica se possui crachá titular ativo */
                SP_RETCRA (1, l_r038hch_aux.NUMEMP, l_r038hch_aux.TIPCOL, l_r038hch_aux.NUMCAD, 0,'',0,'',l_cratit OUT);

                /* Se não há crachá titular ativo busca o último histórico */
                IF  (l_cratit = 0) THEN
                    BEGIN
                        SELECT MAX(DATFIM) INTO l_datfim FROM R038HCH WHERE
                           TIPCRA = 1 AND
                           NUMEMP = l_r038hch_aux.NUMEMP AND
                           TIPCOL = l_r038hch_aux.TIPCOL AND
                           NUMCAD = l_r038hch_aux.NUMCAD AND
                           NUMCRA <> l_r038hch_aux.NUMCRA;
                    EXCEPTION WHEN OTHERS THEN
                           l_datfim := DATETIME(31, 12, 1900, 0, 0, 0);
                    END;

                    BEGIN
                        SELECT NUMCRA INTO l_cratit FROM R038HCH WHERE
                               DATFIM = l_datfim AND
                               TIPCRA = 1 AND
                               NUMEMP = l_r038hch_aux.NUMEMP AND
                               TIPCOL = l_r038hch_aux.TIPCOL AND
                               NUMCAD = l_r038hch_aux.NUMCAD AND
                               NUMCRA <> l_r038hch_aux.NUMCRA AND
                               HORFIM = (SELECT MAX(HORFIM) FROM R038HCH WHERE
                                                TIPCRA = 1 AND
                                                NUMEMP = l_r038hch_aux.NUMEMP AND
                                                TIPCOL = l_r038hch_aux.TIPCOL AND
                                                NUMCAD = l_r038hch_aux.NUMCAD AND
                                                DATFIM = l_datfim AND
                                                NUMCRA <> l_r038hch_aux.NUMCRA);
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN l_cratit := 0;
                    END;
                END IF;
           END IF;
     END IF;
	 
	 /*VALIDAÇÕES REFERENTE A VEÍCULOS*/
     /* Verifica se o sistema de frota está trabalhando de forma on-line */
     IF  (l_froonl = TRUE) AND (l_online = TRUE) AND (l_libvei = 1) THEN
	      
		  l_craprv := 0;
		  l_cratit := 0;
		  /*RETORNA O PROVISÓRIO SE EXISTIR*/
		  SP_RETCRA (2, l_r038hch_aux.NumEmp, l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0,'',0,'',l_craprv OUT); 
		  /*RETORNA O CRACHÁ TITULAR*/	
          SP_RETCRA (1, l_r038hch_aux.NumEmp, l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0,'',0,'',l_cratit OUT);

          FOREACH c_r088hch_del INTO  l_r088vei.PlaVei, l_r088vei.DatFim, l_r088vei.VeiAut
          LOOP
             BEGIN
              SELECT NUMCRA, DATFIM, HORFIM INTO l_cravei, l_datval, l_horval
                FROM R088HCH
               WHERE PLAVEI = l_r088vei.PlaVei 
                 AND DATINI <= l_data_atual 
                 AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero)  
                 AND STAACC = 1;
             EXCEPTION
                WHEN OTHERS THEN 
                    l_cravei := 0;
             END;
             IF (l_r088vei.VEIAUT = 1) THEN /* Se é veículo autorizado, então busca o registro na frota(R088VEF) */
             	BEGIN
                    SELECT 1 INTO l_froaut FROM R088VEF
                        WHERE PLAVEI = l_r088vei.PlaVei 
                          AND DATINI <= l_data_atual 
                          AND (DATFIM >= l_data_atual OR DATFIM = l_data_zero); 
                 EXCEPTION
                 	WHEN NO_DATA_FOUND THEN
                        l_froaut := 0;
                    WHEN OTHERS THEN 
                        l_froaut := 0;
                 END;
             END IF;
             /* Verifica se é veículo de frota e está autorizado ou se for de colaborador e possuir crachá em aberto */
             IF (l_cravei <> 0 AND (l_r088vei.VEIAUT = 0 OR (l_r088vei.VEIAUT = 1 AND l_froaut = 1))) THEN			 			     				 
                 /*REMOVE O CRACHÁ DA CONTROLE DE VEÍCULOS*/ 
               SP_VEIPESCON('D', l_cravei, l_r038hch_aux.NUMCRA, 1, l_r088vei.PlaVei, 
                         l_r038hch_aux.DATFIM, l_r038hch_aux.HORFIM, l_r038hch_aux.TipCol,
                         l_r038hch_aux.NumEmp, l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0, '');
								   
               /*valida data zerada ou maior que 31/12/2050*/
               IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
                 l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
                 l_horval := 1439;
               END IF;					 
               /*VALIDA A MENOR DATA ENTRE AUTORIZAÇÃO E HISTÓRICO DE CRACHÁ DE VEÍCULO*/
               IF (l_r088vei.DatFim < DATETIME(31, 12, 2050, 0, 0, 0)) AND (l_r088vei.DatFim < l_datval) AND
               	(l_r088vei.DatFim <> l_data_zero) AND (l_r088vei.VeiAut = 1) THEN
               	l_datval := l_r088vei.DatFim;
               	l_horval := 1439;
               END IF; 
				 
               /*SE O CRACHÁ ERA PROVISÓRIO E TINHA TITULAR, ENTÃO ATUALIZA O TITULAR*/
               IF (l_r038hch_aux.TIPCRA = 2) THEN				     
                   IF   (l_cratit > 0)  THEN					     
                     /*ATUALIZA O CRACHÁ TITULAR*/
                     SP_VEIPESCON('U', l_cravei, l_cratit, 0, l_r088vei.PlaVei, 
                            l_datval, l_horval, l_r038hch_aux.TipCol,
                            l_r038hch_aux.NumEmp, l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0, '');
                   END IF;
               ELSE /*SE O CRACHÁ É TITULAR E POSSÚI UM PROVISÓRIO, ENTÃO ATUALIZA O PROVISÓRIO*/
                   IF (l_craprv > 0) THEN
                     /*ATUALIZA O CRACHÁ TITULAR*/
                     SP_VEIPESCON('U', l_cravei, l_craprv, 0, l_r088vei.PlaVei,
                            l_datval, l_horval, l_r038hch_aux.TipCol,
                            l_r038hch_aux.NumEmp, l_r038hch_aux.TipCol, l_r038hch_aux.NumCad, 0, '');
                   END IF;
               END IF;				 			     				 
             END IF;
			 
          END LOOP;
     END IF;
	 /*FIM DAS VALIDAÇÕES DE VEÍCULO*/

     IF  (l_online = TRUE) THEN
        /* Atualiza crachá titular na tabela de benefícios */
        R038HCH_TITBNF('F',
                       l_r038hch_aux.TIPCRA,
                       l_r038hch_aux.NUMEMP,
                       l_r038hch_aux.TIPCOL,
                       l_r038hch_aux.NUMCAD,
                       l_r038hch_aux.NUMCRA);
     END IF;
     /* Verifica se utiliza biometria */
     BEGIN
        SELECT USABIO INTO l_usabio FROM R034DAC WHERE NUMEMP = l_r038hch_aux.NUMEMP AND TIPCOL = l_r038hch_aux.TIPCOL AND NUMCAD = l_r038hch_aux.NUMCAD;
     EXCEPTION WHEN OTHERS THEN
        l_usabio := 1;
     END;
     /* somente atualiza as tabelas de biometria se for exclusão de provisório */
     IF   ((l_usabio = 2) OR (l_usabio = 3)) AND (l_r038hch_aux.tipcra = 2) THEN
          /* Verifica se possui crachá titular ativo */
          SP_RETCRA (1, l_r038hch_aux.NUMEMP, l_r038hch_aux.TIPCOL, l_r038hch_aux.NUMCAD, 0,'',0,'',l_cratit OUT);

          /* Se não há crachá titular ativo busca o último histórico */
          IF  (l_cratit = 0) THEN
              BEGIN
                  SELECT MAX(DATFIM) INTO l_datfim FROM R038HCH WHERE
                     TIPCRA = 1 AND
                     NUMEMP = l_r038hch_aux.NUMEMP AND
                     TIPCOL = l_r038hch_aux.TIPCOL AND
                     NUMCAD = l_r038hch_aux.NUMCAD AND
                     NUMCRA <> l_r038hch_aux.NUMCRA;
              EXCEPTION WHEN OTHERS THEN
                     l_datfim := DATETIME(31, 12, 1900, 0, 0, 0);
              END;

              BEGIN
                  SELECT NUMCRA INTO l_cratit FROM R038HCH WHERE
                         DATFIM = l_datfim AND
                         TIPCRA = 1 AND
                         NUMEMP = l_r038hch_aux.NUMEMP AND
                         TIPCOL = l_r038hch_aux.TIPCOL AND
                         NUMCAD = l_r038hch_aux.NUMCAD AND
                         NUMCRA <> l_r038hch_aux.NUMCRA AND
                         HORFIM = (SELECT MAX(HORFIM) FROM R038HCH WHERE
                                          TIPCRA = 1 AND
                                          NUMEMP = l_r038hch_aux.NUMEMP AND
                                          TIPCOL = l_r038hch_aux.TIPCOL AND
                                          NUMCAD = l_r038hch_aux.NUMCAD AND
                                          DATFIM = l_datfim AND
                                          NUMCRA <> l_r038hch_aux.NUMCRA);
              EXCEPTION
                  WHEN NO_DATA_FOUND THEN l_cratit := 0;
              END;
          END IF;

          R038HCH_ATUBIO(l_cratit, l_r038hch_aux.NUMCRA);
     END IF;
    /* Apaga Registro OLD/NEW em R038HCH_AUX */
     BEGIN
       DELETE FROM R038HCH_AUX
        WHERE TIPCRA = l_r038hch_aux.TIPCRA
          AND NUMEMP = l_r038hch_aux.NUMEMP
          AND TIPCOL = l_r038hch_aux.TIPCOL
          AND NUMCAD = l_r038hch_aux.NUMCAD
          AND DATINI = l_r038hch_aux.DATINI
          AND HORINI = l_r038hch_aux.HORINI;         
     EXCEPTION WHEN OTHERS THEN
       NULL;
     END;
  END LOOP;
  DROP_TEMP_TABLE R038HCH_AUX;  
END␀­Ô␀␀		SENIOR;0␀␀

TRIGGER R038HCH_ED AFTER DELETE ON R038HCH FOR EACH ROW
DECLARE
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_idtpes       VARCHAR2(50);
  l_tippes       CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(9);
  l_tipcra       CHAR(1);
  l_data         CHAR(8);
  l_hora         CHAR(4);
  l_ade_gerpen   BOOLEAN;

  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HCH_AUX;
  
BEGIN
  IF  :OLD.STAATU = 1 THEN
      BEGIN
        INSERT INTO R038HCH_AUX (TIPOPE,TIPCRA,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,NUMCRA,DATFIM,HORFIM,STAATU,STAACC)
        VALUES (1,:OLD.TIPCRA,:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.DATINI,:OLD.HORINI,:OLD.NUMCRA,:OLD.DATFIM,:OLD.HORFIM,:OLD.STAATU,:OLD.STAACC);
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'ON-Line: Erro no INSERT em R038HCH_AUX.';
      END;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R038HCH');

  IF (l_auditoria = 'S') THEN
      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg
                FROM R038HCH_AUD
               WHERE TIPCRA = :OLD.TIPCRA AND
                     NUMEMP = :OLD.NUMEMP AND
                     TIPCOL = :OLD.TIPCOL AND
                     NUMCAD = :OLD.NUMCAD AND
                     DATINI = :OLD.DATINI AND
                     HORINI = :OLD.HORINI;
           EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
          INSERT INTO R038HCH_AUD (SEQREG,VERSEQ,TIPCRA,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,VIACRA,
                                   NUMCRA,DATFIM,HORFIM,RECEPR,STAATU,STAACC,CODUSU)
                           VALUES (l_seqreg,l_verseq,:OLD.TIPCRA,:OLD.NUMEMP,:OLD.TIPCOL,
                                  :OLD.NUMCAD,:OLD.DATINI,:OLD.HORINI,:OLD.VIACRA,:OLD.NUMCRA,
                                  :OLD.DATFIM,:OLD.HORFIM,:OLD.RECEPR,:OLD.STAATU,:OLD.STAACC,:OLD.CODUSU);

          SP_AUDGENREG(l_seqreg,l_verseq,'R038HCH','DELETE');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  IF (:OLD.STAATU = 1) THEN
      /* Atualiza o campo Status Alfandegado no colaborador (ADE-02) */
      /* Garanto para que o status não permaneça como 2 - Ativo, pois o crachá ativo foi excluído */
      SP_RECALF_GERPEN_1(:OLD.TIPCOL, l_ade_gerpen OUT);
      IF (l_ade_gerpen = TRUE) THEN
          SP_RECALF_E_CRACOL(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD);
      END IF;
  END IF;

  SP_INTSTR(:OLD.TIPCOL,'99',l_tippes OUT);
  SP_INTSTR(:OLD.NUMEMP,'9999',l_numemp OUT);
  SP_INTSTR(:OLD.TIPCOL,'9',l_tipcol OUT);
  SP_INTSTR(:OLD.NUMCAD,'999999999',l_numcad OUT);
  SP_INTSTR(:OLD.TIPCRA,'9',l_tipcra OUT);
  SP_DATSTR(:OLD.DATINI,'DDMMYYYY',l_data OUT);
  SP_INTSTR(:OLD.HORINI,'9999',l_hora OUT);
  l_idtpes := l_tippes||l_numemp||l_tipcol||l_numcad||l_tipcra||l_data||l_hora;
  SP_SAM_PENDENCIES(2,2,l_idtpes);
END␀␀␀Ûv␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ªÔ␀␀ş␀␀¢␀	„␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀­%␀‹␀	„␀␀␀␀␀␀(&␀|%␀&␀a␀Æÿ␀␀ÿ␀3␀{	„␀␀␀␀␀␀␀␀␀nˆ␀Æÿ␀␀ÿ␀…¬␀␀´␀	„␀␀␀␀␀␀‘<XbXbrˆ␀Æÿ␀␀ÿ␀.␀t	„␀␀␀␀␀␀O␀Ò␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀	„␀␀␀␀␀␀u%&$Á$w	ˆ␀Æÿ␀␀ÿ␀EÑ␀	„␀␀␀␀␀␀KK¢G¢GqCˆ␀êÿ␀␀ÿ␀¤w·␀	„␀␀␀␀␀␀’yˆxˆxì*␀ˆ␀Æÿ␀␀ÿ␀Ç&␀­␀„␀␀␀␀␀␀<°␀␀°&␀À&␀pŞ‡␀Æÿ␀␀ÿ␀u¬␀␀–␀„␀␀␀␀␀␀>±␀␀)8)8n
