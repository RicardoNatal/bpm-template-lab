        SP_INTSTR(p_horval_new,'HHMM',l_horstr OUT);
    ELSE
        SP_DATSTR(p_datsai,'DDMMYY',l_datstr OUT);
        SP_INTSTR(p_horsai,'HHMM',l_horstr OUT);
    END IF;
    /* corrige a data se vier com valor zero */
    IF  (l_datstr = '311200') THEN
        l_datstr :=  '311250';
    END IF;
    IF  (l_horstr = '0000') THEN
        l_horstr :=  '2359';
    END IF;
    l_datval := l_datstr||l_horstr||'000000';

    /* Verifica qual é o crachá Principal e obtem os números físicos */
    SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
    IF (l_crapri = 0) THEN
        l_crapri := p_numcra;
    END IF;

    /*Atualiza o datval dos crachás na R070CON.*/
    SP_UPDFIS(p_numcra,' ',l_datval);
    /*Importante: em algumas situações (Baixa de um acompanhante, o sistema atualizava o crachá do acompanhante*/
    /*com as permissões zeradas. Por esse motivo primeiramente é atualizado campo DatVal da R070CON e posteriormente*/
    /*as permissões da pessoa para que todas estas pendências sejam geradas na R070CON.*/

    /*Atualiza o Crachá Principal na R070CON*/
    BEGIN
        UPDATE R070CON SET DATVAL=l_datval, CODPRM=p_codprm_new, PRMSAB=p_codprm_new, PRMDOM=p_codprm_new, PRMFER=p_codprm_new, ANDVIS=p_andvis
        WHERE NUMFIS = l_crapri;
    EXCEPTION
        WHEN OTHERS THEN NULL;
    END;
   
    /*Atualiza as permissões para os demais crachás da pessoa*/
    SP_UPDPRM(p_numcra, p_codprm_new, p_codprm_new, p_codprm_new, p_codprm_new, ' ', ' ', ' ');
END		SENIOR;227SP_DATSTR
