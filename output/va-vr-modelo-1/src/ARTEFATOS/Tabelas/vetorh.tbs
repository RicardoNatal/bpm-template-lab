/* INSERT (NEW) */
TRIGGER R008ATI_EI AFTER INSERT ON R008ATI FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Eventos - Atividades Válidas (Tabela: R008ATI)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 98;     /* Eventos - Atividades Válidas (Tabela: R008ATI)*/
  l_codtpa := 277;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008ATI_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAB', CONVERT(NUMBER_TO_CHAR, :NEW.CODTAB));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CODEVE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATI', CONVERT(NUMBER_TO_CHAR, :NEW.CODATI));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R008ATI_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      
      BEGIN
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
	  END;
  END IF; 
END␀óÎ␀␀	SENIOR;0L

TRIGGER R008ATI_SU AFTER UPDATE ON R008ATI

BEGIN
RH_250ALT(18);
END␀ğÎ␀␀		SENIOR;0×␀␀ 

