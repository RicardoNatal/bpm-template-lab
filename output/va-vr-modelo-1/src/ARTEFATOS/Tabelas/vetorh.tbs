/* Inclusao  */
TRIGGER R038HCS_EI AFTER INSERT ON R038HCS FOR EACH ROW

DECLARE
  l_DATSEF       DATE;
  l_comando_nulo BOOLEAN;
  
  /* VARIAVEIS DO LOG */
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);

BEGIN

  IF  :NEW.STAHIS = 1 THEN
    BEGIN
      SELECT R034FUN.DATSEF INTO l_DATSEF
        FROM R034FUN
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      l_comando_nulo:=TRUE;
    END;

    IF   (:NEW.DATALT >= l_DATSEF)
    OR   (l_DATSEF IS NULL) THEN
         UPDATE R034FUN
            SET CATSEF = :NEW.CATSEF,
                DATSEF = :NEW.DATALT
          WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                R034FUN.NUMEMP = :NEW.NUMEMP AND
                R034FUN.NUMCAD = :NEW.NUMCAD;
    END IF;
  END IF;
    
  /* Geração de logs Histórico Categoria Sefip*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 59;     /* Histórico Categoria Sefip*/
  l_codtpa := 229;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HCS_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HCS_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CATSEF', CONVERT(NUMBER_TO_CHAR, :NEW.CATSEF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
      END;
  END IF;
  
END␀¼Ô␀␀		SENIOR;0¸␀␀

/* Alteracao  */
TRIGGER R038HCS_EU AFTER UPDATE ON R038HCS FOR EACH ROW

DECLARE
  l_DATSEF       DATE;
  l_comando_nulo BOOLEAN;
  
  /* VARIÁVEIS DE CONTROLE DO LOG */
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  
BEGIN
  
  IF  :NEW.STAHIS = 1 THEN
    BEGIN
      SELECT R034FUN.DATSEF INTO l_DATSEF
        FROM R034FUN
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      l_comando_nulo:=TRUE;
    END;
    IF   (:NEW.datalt >= l_DATSEF)
    OR   (l_DATSEF IS NULL) THEN
         UPDATE R034FUN
            SET CATSEF = :NEW.CATSEF,
                DATSEF = :NEW.DATALT
          WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                R034FUN.NUMEMP = :NEW.NUMEMP AND
                R034FUN.NUMCAD = :NEW.NUMCAD;
    END IF;
  END IF;
    
  /* Geração de logs Histórico Categoria Sefip*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 59;     /* Histórico Categoria Sefip*/
  l_codtpa := 230;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.CatSef <> :NEW.CatSef)
   OR (:OLD.StaHis <> :NEW.StaHis)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HCS_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HCS_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCATSEF', CONVERT(NUMBER_TO_CHAR, :OLD.CATSEF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCATSEF', CONVERT(NUMBER_TO_CHAR, :NEW.CATSEF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSTAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSTAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
      END;
    END IF; 
  END IF;
  
END␀½Ô␀␀	SENIOR;0ì
␀␀TRIGGER R038HCS_SD AFTER DELETE ON R038HCS

DECLARE
l_catsef       NUMBER(2);
  l_datsef       DATE;

  /* CURSOR c/ os registros gravados no R038HCS_AUX */
  CURSOR c_r038HCS_del IS SELECT NUMEMP,TIPCOL,NUMCAD,DATALT,CATSEF,STAHIS FROM R038HCS_AUX;

  TYPE t_r038HCS_aux IS RECORD(
    NUMEMP   R038HCS_AUX.NUMEMP%TYPE,
    TIPCOL   R038HCS_AUX.TIPCOL%TYPE,
    NUMCAD   R038HCS_AUX.NUMCAD%TYPE,
    DATALT   R038HCS_AUX.DATALT%TYPE,
    CATSEF   R038HCS_AUX.CATSEF%TYPE,
    STAHIS   R038HCS_AUX.STAHIS%TYPE);

  l_r038HCS_aux t_r038HCS_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r038HCS_del INTO  l_r038HCS_aux.NUMEMP,
                              l_r038HCS_aux.TIPCOL,
                              l_r038HCS_aux.NUMCAD,
                              l_r038HCS_aux.DATALT,
                              l_r038HCS_aux.CATSEF,
                              l_r038HCS_aux.STAHIS
  LOOP
    IF l_r038HCS_aux.STAHIS = 1 THEN
      SELECT CATSEF, DATSEF INTO l_catsef, l_datsef FROM R034FUN
       WHERE NUMEMP = l_r038HCS_aux.NUMEMP AND TIPCOL = l_r038HCS_aux.TIPCOL AND NUMCAD = l_r038HCS_aux.NUMCAD;

      IF (l_r038HCS_aux.CATSEF = l_catsef) AND (l_r038HCS_aux.DATALT = l_datsef) THEN
        /* Pega o historico anterior */
        BEGIN
          SELECT A.CATSEF,A.DATALT
          INTO l_catsef,l_datsef
          FROM R038HCS A
          WHERE A.NUMEMP = l_r038HCS_aux.NUMEMP
          AND   A.TIPCOL = l_r038HCS_aux.TIPCOL
          AND   A.NUMCAD = l_r038HCS_aux.NUMCAD
          AND   A.STAHIS = 1
          AND DATALT IN (SELECT MAX(DATALT) FROM R038HCS
                         WHERE NUMEMP = l_r038HCS_aux.NUMEMP
                         AND   TIPCOL = l_r038HCS_aux.TIPCOL
                         AND   NUMCAD = l_r038HCS_aux.NUMCAD
                         AND   STAHIS = 1);
        EXCEPTION
          WHEN TOO_MANY_ROWS THEN
            RAISERROR 103 'Erro em R038HCS - TOO MANY ROWS';
          WHEN NO_DATA_FOUND THEN
            l_catsef:=0;
            l_datsef:='31/12/1900,00:00:00';
          WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT R038HCS';
        END;

        /* Atualiza tabela de colaboradores */
        BEGIN
          UPDATE R034FUN
             SET CATSEF = l_catsef,
                 DATSEF = l_datsef
           WHERE R034FUN.TIPCOL = l_r038HCS_aux.TIPCOL AND
                 R034FUN.NUMEMP = l_r038HCS_aux.NUMEMP AND
                 R034FUN.NUMCAD = l_r038HCS_aux.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro Na Atualização do R034FUN';
        END;
      END IF;
    END IF;

  END LOOP;

  /* Apaga Registro OLD em R038HCS_AUX */
  BEGIN
    DELETE FROM R038HCS_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ºÔ␀␀		SENIOR;01␀␀

/* Exclusao */
TRIGGER R038HCS_ED AFTER DELETE ON R038HCS FOR EACH ROW

DECLARE
  /* VARIÁVEIS DO LOG */
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);

BEGIN
  BEGIN
    /* Insere Registro Old */
    INSERT INTO R038HCS_AUX (NUMEMP, TIPCOL, NUMCAD, DATALT, CATSEF, STAHIS)
                     VALUES (:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, :OLD.CATSEF, :OLD.STAHIS);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R038HCS_AUX.';
  END;
  
  /* Geração de logs Histórico Categoria Sefip*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 59;     /* Histórico Categoria Sefip*/
  l_codtpa := 229;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN    
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HCS_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HCS_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CATSEF', CONVERT(NUMBER_TO_CHAR, :OLD.CATSEF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
      END;
  END IF;
  
END␀␀␀{v␀␀␀␀␀␀¹Ô␀␀…¬␀␀´␀Ôï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀tÔï!␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀Ôï!␀␀␀␀␀.%0.0.w␀Æÿ␀␀ÿ␀mDÑ␀Ôï!␀␀␀␀␀JIşEşEqC␀êÿ␀␀ÿ␀a(½Ôï!␀␀␀␀␀u(u(u(p␀Æÿ␀␀ÿ␀␀b´␀Ôï!␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀Û␀tÔï!␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ÿ␀Z$Ì␀Ôï!␀␀␀␀␀.%0.0.w␀Æÿ␀␀ÿ␀MEÑ␀Ôï!␀␀␀␀␀JIşEşEqC␀êÿ␀␀ÿ␀[(½Ôï!␀␀␀␀␀u(u(u(p␀Æÿ␀␀ÿ␀*␀áÔï!␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀␀␀␀|v␀␀␀␀␀␀␀␀␀␀␀␀¾Ô␀␀…¬␀␀´␀	Ôÿ1␀␀␀␀␀‘<XbXbrˆ␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ1␀␀␀␀␀O␀Ò␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ1␀␀␀␀␀u%&$Á$w	ˆ␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ôÿ1␀␀␀␀␀ÿIşEşEqCˆ␀êÿ␀␀ÿ␀-Ç␀Ôÿ1␀␀␀␀␀e=¹·␀␀¹·␀␀z␀Æÿ␀␀ÖÒ␀␀␀q¬␀␀Ôÿ1␀␀␀␀␀=±␀␀û«␀␀z¯␀␀#␀␀ÿ␀␀ÊÒ␀␀␀åDÑ␀Ôÿ1␀␀␀␀␀ÔFÔFÔFqCˆ␀êÿ␀␀ÿ␀␀ÉÔÿ1␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3ÂÔ␀␀		SENIOR;0Ò␀␀TRIGGER R038HCT_EI AFTER INSERT ON R038HCT FOR EACH ROW

DECLARE
  l_online       BOOLEAN;
  l_idtpes       VARCHAR2(23);
  l_codoem_str   VARCHAR2(8);
  l_numcon_str   VARCHAR2(15);
  l_valstr_oem   VARCHAR2(32);
  l_valstr_con   VARCHAR2(47);
  l_valstr_his   VARCHAR2(46);
  l_datalt       CHAR(8);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) AND
     (:NEW.STAATU > 0) AND
     (:NEW.TIPCOL > 1) THEN
     R038HCT_ATUCON ('I',:NEW.NUMEMP,
                     :NEW.TIPCOL,
                     :NEW.NUMCAD,
                     :NEW.CODOEM,
                     :NEW.NUMCON,
                     :NEW.DATFIM);
  END IF;
  
  /* Pendências SAMSenior */
  IF (:NEW.STAATU <> 2) THEN  /* Histórico presente ou futuro */
    SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_INTSTR(:NEW.CODOEM, '99999999', l_codoem_str OUT);

    IF (:NEW.STAATU = 1) THEN
      l_valstr_oem := 'H' || l_idtpes || l_codoem_str;
      SP_SAM_PENDENCIES(36, 1, l_valstr_oem);  /* Pend. de Estr. Org. - Outra Empresa */
    END IF;

    IF (LENGTH(LTRIM(:NEW.NUMCON)) > 0) THEN  
      SP_ESPSTR(:NEW.NUMCON, 15, l_numcon_str OUT);

      IF (:NEW.STAATU = 1) THEN
        l_valstr_con := 'H' || l_idtpes || l_codoem_str || l_numcon_str;
        SP_SAM_PENDENCIES(37, 1, l_valstr_con);  /* Pend. de Estr. Org. - Contrato */
      END IF;

      /* Tem que ser um Terceiro. Empregados e Parceiros não geram pendência para o GT */
      IF (:NEW.TIPCOL = 2) THEN
        SP_DATSTR(:NEW.DATALT, 'DDMMYYYY', l_datalt OUT);
        l_valstr_his := l_idtpes || l_datalt;
        SP_SAM_PENDENCIES(45, 1, l_valstr_his);
      END IF;
    END IF;
  END IF;
END␀ÃÔ␀␀		SENIOR;0æ␀␀

TRIGGER R038HCT_EU AFTER UPDATE ON R038HCT FOR EACH ROW

DECLARE
  l_online       BOOLEAN;
  l_idtpes       VARCHAR2(23);
  l_codoem_str   VARCHAR2(8);
  l_numcon_str   VARCHAR2(15);
  l_valstr_oem   VARCHAR2(32);
  l_valstr_con   VARCHAR2(47);
  l_valstr_his   VARCHAR2(46);
  l_penoem_inc   BOOLEAN;
  l_penoem_exc   BOOLEAN;
  l_pencon_inc   BOOLEAN;
  l_pencon_exc   BOOLEAN;
  l_codoem         R032OEM.CODOEM%TYPE;
  l_numcon         R032EMC.NUMCON%TYPE;
  l_datalt       CHAR(8);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) AND
     (:NEW.TIPCOL > 1) AND (
     (:OLD.STAATU <> :NEW.STAATU) OR
     (:OLD.CODOEM <> :NEW.CODOEM) OR
     (:OLD.NUMCON <> :NEW.NUMCON) OR
     (:OLD.DATFIM <> :NEW.DATFIM)
     ) THEN
    /*Chama a R038HCT_ATUCON somente se não for um histórico já fechado.*/
    IF NOT ((:OLD.STAATU = 2) AND (:NEW.STAATU = 2)) THEN
      /*Somente Atualiza se for histórico Atual.*/
      IF ((:OLD.STAATU = 1) OR (:NEW.STAATU = 1)) THEN
             R038HCT_ATUCON ('U',:NEW.NUMEMP,
                                 :NEW.TIPCOL,
                                 :NEW.NUMCAD,
                                 :NEW.CODOEM,
                                 :NEW.NUMCON,
                                 :NEW.DATFIM);
      END IF;
    END IF;
  END IF;

  /* Pendência SAMSenior */
  l_penoem_inc := FALSE;
  l_penoem_exc := FALSE;
  l_pencon_inc := FALSE;
  l_pencon_exc := FALSE;

  IF (:NEW.STAATU = 1) AND (:OLD.STAATU <> 1) THEN
    l_penoem_inc := TRUE;
    l_codoem := :NEW.CODOEM;
    IF (LENGTH(LTRIM(:NEW.NUMCON)) > 0) THEN
      l_pencon_inc := TRUE;
      l_numcon := :NEW.NUMCON;
    END IF;
  END IF;
  IF (:OLD.STAATU = 1) AND (:NEW.STAATU <> 1) THEN
    l_penoem_exc := TRUE;
    l_codoem := :OLD.CODOEM;
    IF (LENGTH(LTRIM(:NEW.NUMCON)) > 0) THEN
      l_pencon_exc := TRUE;
      l_numcon := :OLD.NUMCON;
    END IF;
  END IF;  
  IF (:NEW.CODOEM <> :OLD.CODOEM) THEN
    l_penoem_inc := TRUE;
    l_codoem := :NEW.CODOEM;
    IF (LENGTH(LTRIM(:NEW.NUMCON)) > 0) THEN
      l_pencon_inc := TRUE;
      l_numcon := :NEW.NUMCON;
    END IF;
  ELSE
    IF (LENGTH(LTRIM(:NEW.NUMCON)) > 0) AND (:NEW.NUMCON <> :OLD.NUMCON) THEN
      l_pencon_inc := TRUE;
      l_numcon := :NEW.NUMCON;
    END IF;
    IF (LENGTH(LTRIM(:OLD.NUMCON)) > 0) AND (:NEW.NUMCON <> :OLD.NUMCON) THEN
      l_pencon_exc := TRUE;
      l_numcon := :OLD.NUMCON;
    END IF;
  END IF;

  IF (l_penoem_inc = TRUE) OR (l_penoem_exc = TRUE) OR (l_pencon_inc = TRUE) OR (l_pencon_exc = TRUE) THEN
    SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_INTSTR(l_codoem, '99999999', l_codoem_str OUT);
    SP_ESPSTR(l_numcon, 15, l_numcon_str OUT);
    l_valstr_oem := 'H' || l_idtpes || l_codoem_str;
    l_valstr_con := 'H' || l_idtpes || l_codoem_str || l_numcon_str;

    IF (l_penoem_inc = TRUE) THEN
      SP_SAM_PENDENCIES(36, 1, l_valstr_oem);
    END IF;

    IF (l_penoem_exc = TRUE) THEN
      SP_SAM_PENDENCIES(36, 3, l_valstr_oem);
    END IF;

    IF (l_pencon_inc = TRUE) THEN
      SP_SAM_PENDENCIES(37, 1, l_valstr_con);
    END IF;

    IF (l_pencon_exc = TRUE) THEN
      SP_SAM_PENDENCIES(37, 3, l_valstr_con);
    END IF;
  END IF;

  /* Pendência GT - Contrato 
   * Pendência de Outra Empresa para GT (43), só nas triggers da tabela R032OEM 
   * Tem que ser um Terceiro. Empregados e Parceiros não geram pendência para o GT */
  IF NOT ((:OLD.STAATU = 2) AND (:NEW.STAATU = 2)) THEN /* Registros que estavam no passado e permanecem no passado não geram pendência */
    IF (:NEW.TIPCOL = 2) AND ((:NEW.CODOEM <> :OLD.CODOEM) OR (:NEW.NUMCON <> :OLD.NUMCON) OR (:NEW.DATFIM <> :OLD.DATFIM)) THEN
      SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
      SP_DATSTR(:NEW.DATALT, 'DDMMYYYY', l_datalt OUT);
      l_valstr_his := l_idtpes || l_datalt;
      SP_SAM_PENDENCIES(45, 2, l_valstr_his);
    END IF;
  END IF;
END␀ÄÔ␀␀	SENIOR;0
␀␀

TRIGGER R038HCT_SD AFTER DELETE ON R038HCT

DECLARE
  l_tipope       VARCHAR2(2);
  l_idtpes       VARCHAR2(23);
  l_codoem_str   VARCHAR2(8);
  l_numcon_str   VARCHAR2(15);
  l_valstr_oem   VARCHAR2(32);
  l_valstr_con   VARCHAR2(47);
 
 /* CURSOR c/ os registros gravados no R038HCT_AUX */
  CURSOR c_r038hct_aux IS SELECT NUMEMP,TIPCOL,NUMCAD,DATALT,CODOEM,DATFIM,NUMCON,STAATU FROM R038HCT_AUX;

  TYPE t_r038HCT_aux IS RECORD(
    NUMEMP   R038HCT_AUX.NUMEMP%TYPE,
    TIPCOL   R038HCT_AUX.TIPCOL%TYPE,
    NUMCAD   R038HCT_AUX.NUMCAD%TYPE,
    DATALT   R038HCT_AUX.DATALT%TYPE,
    CODOEM   R038HCT_AUX.CODOEM%TYPE,
    NUMCON   R038HCT_AUX.NUMCON%TYPE,
	DATFIM   R038HCT_AUX.DATFIM%TYPE,
	STAATU   R038HCT_AUX.STAATU%TYPE);

  l_r038HCT_aux t_r038HCT_aux;
  x_r038HCT_atucon t_r038HCT_aux;
  
BEGIN
	l_tipope := 'U';
	FOREACH c_r038hct_aux INTO  l_r038HCT_aux.NUMEMP, l_r038HCT_aux.TIPCOL, l_r038HCT_aux.NUMCAD, 
								l_r038HCT_aux.DATALT, l_r038HCT_aux.CODOEM, l_r038HCT_aux.DATFIM,
								l_r038HCT_aux.NUMCON, l_r038HCT_aux.STAATU
	LOOP
		IF (l_r038HCT_aux.TIPCOL > 1) THEN
			BEGIN
				SELECT NUMEMP,TIPCOL,NUMCAD,DATALT,CODOEM,NUMCON,DATFIM,STAATU 
				INTO x_r038HCT_atucon.NUMEMP, x_r038HCT_atucon.TIPCOL, x_r038HCT_atucon.NUMCAD,
						  x_r038HCT_atucon.DATALT, x_r038HCT_atucon.CODOEM, x_r038HCT_atucon.NUMCON,
						  x_r038HCT_atucon.DATFIM, x_r038HCT_atucon.STAATU 
				FROM R038HCT 
				WHERE NUMEMP = l_r038HCT_aux.NUMEMP AND TIPCOL = l_r038HCT_aux.TIPCOL AND 
					  NUMCAD = l_r038HCT_aux.NUMCAD AND
				DATALT = (
									SELECT MAX(DATALT) FROM R038HCT 
									WHERE NUMEMP = l_r038HCT_aux.NUMEMP AND TIPCOL = l_r038HCT_aux.TIPCOL AND 
												 NUMCAD = l_r038HCT_aux.NUMCAD
									);
			EXCEPTION
				   WHEN NO_DATA_FOUND THEN
						x_r038HCT_atucon.NUMEMP := l_r038HCT_aux.NUMEMP;
						x_r038HCT_atucon.TIPCOL := l_r038HCT_aux.TIPCOL;
						x_r038HCT_atucon.NUMCAD := l_r038HCT_aux.NUMCAD;
						x_r038HCT_atucon.CODOEM := l_r038HCT_aux.CODOEM;
						x_r038HCT_atucon.NUMCON := l_r038HCT_aux.NUMCON;
						x_r038HCT_atucon.DATFIM := l_r038HCT_aux.DATFIM;
						x_r038HCT_atucon.codoem := 0;
						x_r038HCT_atucon.numcon := '';
						x_r038HCT_atucon.DATFIM := '31/12/1900';
			END;
			R038HCT_ATUCON(l_tipope,
						   x_r038HCT_atucon.NUMEMP,
						   x_r038HCT_atucon.TIPCOL,
						   x_r038HCT_atucon.NUMCAD,
						   x_r038HCT_atucon.CODOEM,
						   x_r038HCT_atucon.NUMCON,
						   x_r038HCT_atucon.DATFIM);						
		END IF;

	END LOOP;
	DELETE FROM R038HCT_AUX;
END␀ÁÔ␀␀		SENIOR;0␀␀

TRIGGER R038HCT_ED AFTER DELETE ON R038HCT FOR EACH ROW

DECLARE
  l_online       BOOLEAN;
  l_data_zero    DATE;
  l_idtpes       VARCHAR2(23);
  l_codoem_str   VARCHAR2(8);
  l_numcon_str   VARCHAR2(15);
  l_valstr_oem   VARCHAR2(32);
  l_valstr_con   VARCHAR2(47);
  l_valstr_his   VARCHAR2(46);
  l_datalt       CHAR(8);
BEGIN
  l_data_zero := '31/12/2050,00:00:00';
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) AND
     (:OLD.TIPCOL > 1) THEN
    /*Somente Atualiza se for histórico Atual.*/
    IF (:OLD.STAATU = 1) THEN
       R038HCT_ATUCON ('D',:OLD.NUMEMP,
                         :OLD.TIPCOL,
                         :OLD.NUMCAD,
                         :OLD.CODOEM,
                         :OLD.NUMCON,
                         l_data_zero);
    END IF;
  END IF;
  INSERT INTO R038HCT_AUX (numemp, tipcol, numcad, datalt, codoem, numcon, datfim, staatu) VALUES
                        (:OLD.numemp, :OLD.tipcol, :OLD.numcad, :OLD.datalt, :OLD.codoem, :OLD.numcon, :OLD.DATFIM, :OLD.staatu);

  /* Pendência SAMSenior */
  IF (:OLD.STAATU = 1) THEN
    SP_RETIDTPES(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_INTSTR(:OLD.CODOEM, '99999999', l_codoem_str OUT);
    l_valstr_oem := 'H' || l_idtpes || l_codoem_str;
    SP_SAM_PENDENCIES(36, 3, l_valstr_oem);

    IF (LENGTH(LTRIM(:OLD.NUMCON)) > 0) THEN
      SP_ESPSTR(:OLD.NUMCON, 15, l_numcon_str OUT);
      l_valstr_con := 'H' || l_idtpes || l_codoem_str || l_numcon_str;
      SP_SAM_PENDENCIES(37, 3, l_valstr_con);
    END IF;
  END IF;

  /* Pendência GT - Empresa Terceira 
   * Tem que ser um Terceiro. Empregados e Parceiros não geram pendência para o GT */
  IF (:OLD.TIPCOL = 2) AND (LENGTH(LTRIM(:OLD.NUMCON)) > 0) THEN
    SP_RETIDTPES(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);
    SP_DATSTR(:OLD.DATALT, 'DDMMYYYY', l_datalt OUT);
    l_valstr_his := l_idtpes || l_datalt;
    SP_SAM_PENDENCIES(45, 3, l_valstr_his);
  END IF;
END␀␀␀‚v␀␀␀␀␀␀␀␀␀ÀÔ␀␀…¬␀␀´␀Ôÿ1␀␀␀␀␀‘<XbXbrˆ␀Æÿ␀␀Ò␀␀␀.␀tÔÿ1␀␀␀␀␀O␀Ò␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀Ôÿ1␀␀␀␀␀u%&$Á$w	ˆ␀Æÿ␀␀…Ó␀␀␀mDÑ␀Ôÿ1␀␀␀␀␀ÿIşEşEqCˆ␀êÿ␀␀ÿ␀-Ç␀Ôÿ1␀␀␀␀␀e=¹·␀␀¹·␀␀z␀Æÿ␀␀ÖÒ␀␀␀q¬␀␀Ôÿ1␀␀␀␀␀=±␀␀û«␀␀z¯␀␀#␀␀ÿ␀␀ÊÒ␀␀␀åDÑ␀Ôÿ1␀␀␀␀␀ÔFÔFÔFqCˆ␀êÿ␀␀ÿ␀␀ÉÔÿ1␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀␀␀␀‚v␀␀␀␀␀␀␀␀␀ÅÔ␀␀…¬␀␀´␀	”‘␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	”‘␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	”‘␀␀␀␀␀␀ƒ%€$0.w␀Æÿ␀␀…Ó␀␀␀é␀␀Ñ␀	”‘␀␀␀␀␀␀KZ”␀␀Z”␀␀qC␀êÿ␀␀ÿ␀oÑ␀”‘␀␀␀␀␀␀òF`n`nqC␀êÿ␀␀ÿ␀,è”‘␀␀␀␀␀␀ó<t␀t␀p␀Æÿ␀␀ÿ␀␀É”‘␀␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀?¶␀␀ç”‘␀␀␀␀␀␀ô¶␀␀‘¶␀␀‘¶␀␀n␀Æÿ␀␀ÿ␀‘³␀␀>”‘␀␀␀␀␀␀´␀␀´␀␀´␀␀=␀␀ÿ␀␀ÿ␀³␀␀>”‘␀␀␀␀␀␀ÿ³␀␀ÿ³␀␀ÿ³␀␀=␀␀ÿ␀␀ÿ␀Ë␀␀Ñ␀”‘␀␀␀␀␀␀¬G¬G¬GqC␀êÿ␀␀ÿ␀␀␀ÆÔ␀␀␀ÇÔ␀␀␀␀0;1;2;3ÊÔ␀␀		SENIOR;0M␀␀

TRIGGER R038HEB_EI AFTER INSERT ON R038HEB FOR EACH ROW

DECLARE
  l_datetb       DATE;
BEGIN
  IF  (:NEW.STAATU = 1) THEN
      SELECT R034FUN.DATETB INTO l_datetb
        FROM R034FUN
       WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
             
      IF  ((:NEW.INIETB >= l_datetb) OR (l_datetb IS NULL)) THEN
          BEGIN
            UPDATE R034FUN
               SET CODETB = :NEW.CODETB,
                   DATETB = :NEW.INIETB
             WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                   R034FUN.NUMEMP = :NEW.NUMEMP AND
                   R034FUN.NUMCAD = :NEW.NUMCAD;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro Na Atualização do R034FUN';
          END;
      END IF;
  END IF;
END␀ÍÔ␀␀	SENIOR;0‘␀␀

TRIGGER R038HEB_SU AFTER UPDATE ON R038HEB

DECLARE
  l_codetb       NUMBER(2);
  l_inietb       DATE;
  l_fimetb       DATE;
  l_nofound      BOOLEAN;

  /* CURSOR c/ os registros gravados no R038HEB_AUX */
  CURSOR c_r038heb_del IS SELECT NUMEMP,TIPCOL,NUMCAD FROM R038HEB_AUX;
  TYPE t_r038HEB_aux IS RECORD(
    NUMEMP   R038HEB_AUX.NUMEMP%TYPE,
    TIPCOL   R038HEB_AUX.TIPCOL%TYPE,
    NUMCAD   R038HEB_AUX.NUMCAD%TYPE);
  l_r038HEB_aux t_r038HEB_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r038heb_del INTO  l_r038HEB_aux.NUMEMP,
                              l_r038HEB_aux.TIPCOL,
                              l_r038HEB_aux.NUMCAD
  LOOP
   /* Pega o historico anterior */
    l_nofound:=FALSE;
    BEGIN
      SELECT A.CODETB,A.INIETB,A.FIMETB INTO l_codetb,l_inietb,l_fimetb
      FROM R038HEB A
      WHERE A.NUMEMP = l_r038heb_aux.NUMEMP
      AND   A.TIPCOL = l_r038heb_aux.TIPCOL
      AND   A.NUMCAD = l_r038heb_aux.NUMCAD
      AND   A.STAATU = 1
      AND INIETB IN (SELECT MAX(INIETB) FROM R038HEB
                     WHERE NUMEMP = l_r038heb_aux.NUMEMP
                     AND   TIPCOL = l_r038heb_aux.TIPCOL
                     AND   NUMCAD = l_r038heb_aux.NUMCAD
                     AND   STAATU = 1);
    EXCEPTION
      WHEN TOO_MANY_ROWS THEN
        RAISERROR 103 'Erro em R038HEB - TOO MANY ROWS';
      WHEN NO_DATA_FOUND THEN
        l_nofound := TRUE;
        l_codetb:=0;
        l_inietb:='31/12/1900,00:00:00';
        l_fimetb:='31/12/1900,00:00:00';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT R038HEB';
    END;
   /* Atualiza tabela de colaboradores */

    BEGIN
       UPDATE R034FUN
          SET CODETB = l_codetb,
              DATETB = l_inietb
        WHERE R034FUN.TIPCOL = l_r038heb_aux.TIPCOL AND
              R034FUN.NUMEMP = l_r038heb_aux.NUMEMP AND
              R034FUN.NUMCAD = l_r038heb_aux.NUMCAD;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro Na Atualização do R034FUN';
    END;
    
  END LOOP;

 /* Apaga Registro OLD em R038HEB_AUX */
  BEGIN
    DELETE FROM R038HEB_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ËÔ␀␀		SENIOR;0ü␀␀

TRIGGER R038HEB_EU AFTER UPDATE ON R038HEB FOR EACH ROW

DECLARE
  l_datetb       DATE;
  l_datzer       DATE;
BEGIN
  l_datzer:='31/12/1900,00:00:00';
  SELECT R034FUN.DATETB INTO l_datetb
    FROM R034FUN
   WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
         R034FUN.NUMEMP = :NEW.NUMEMP AND
         R034FUN.NUMCAD = :NEW.NUMCAD;

  IF  ((:NEW.INIETB >= l_datetb) OR (l_datetb IS NULL)) THEN
      IF  (:NEW.STAATU = 1) THEN
           BEGIN
             UPDATE R034FUN
                SET CODETB = :NEW.CODETB,
                    DATETB = :NEW.INIETB
              WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                    R034FUN.NUMEMP = :NEW.NUMEMP AND
                    R034FUN.NUMCAD = :NEW.NUMCAD;
           EXCEPTION WHEN OTHERS THEN
             RAISERROR 103 'Erro Na Atualização do R034FUN';
           END;
      ELSE
           /* se alterou para historico passado, verificar se tem outra em aberto. */
           BEGIN
           /* Insere Registro Old */
             INSERT INTO R038HEB_AUX (NUMEMP,TIPCOL,NUMCAD)
             VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD);
           EXCEPTION WHEN OTHERS THEN
             RAISERROR 103 'Erro no INSERT em R038HEB_AUX.';
           END;
      END IF;
  END IF;
END␀ÌÔ␀␀	SENIOR;0‹␀␀TRIGGER R038HEB_SD AFTER DELETE ON R038HEB

