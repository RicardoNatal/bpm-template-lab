TRIGGER R070REV_EU AFTER UPDATE ON R070REV FOR EACH ROW
BEGIN
  IF ((:NEW.STAREV <> :OLD.STAREV) AND (:NEW.STAREV = 1)) THEN
    SP_PEND96(:NEW.IdtPes);
  END IF;
END␀␀␀ğ␀␀␀␀␀␀␀␀␀␀␀␀ƒÚ␀␀7‹␀␀3␀␀␀␀␀␀bŠ␀␀bŠ␀␀YŠ␀␀4␀␀ÿ␀␀ÿ␀åDÑ␀␀␀␀␀␀␀)GÔFÔFqCˆ␀êÿ␀␀ÿ␀w·␀␀␀␀␀␀␀[x<x<xì*␀ˆ␀Æÿ␀␀ÿ␀m,Ì␀␀␀␀␀␀␀N@¤:¤:{␀Æÿ␀␀ÿ␀␀Š␀␀␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀„Ú␀␀␀␀␀␀␀␀wñ␀␀␀␀␀␀␀␀…Ú␀␀…¬␀␀´␀	„␀␀␀␀␀␀␀‘<XbXbrˆ␀Æÿ␀␀Ò␀␀␀c¬␀␀Ì␀	„␀␀␀␀␀␀␀u%&$Á$w	ˆ␀Æÿ␀␀DÚ␀␀␀EÑ␀	„␀␀␀␀␀␀␀KK¢G¢GqCˆ␀êÿ␀␀ÿ␀¤w·␀	„␀␀␀␀␀␀␀’yˆxˆxì*␀ˆ␀Æÿ␀␀ÿ␀uû␀␀n„␀␀␀␀␀␀␀µû␀␀û␀␀µû␀␀l␀␀ÿ␀␀ÿ␀␀Ã„␀␀␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3␀␀ıv␀␀␀␀␀␀␀†Ú␀␀…¬␀␀´␀	␀␀␀␀␀␀Ş<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀õ␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀—$0.0.w␀Æÿ␀␀…Ó␀␀␀EÑ␀	␀␀␀␀␀␀qG]G]GqC␀êÿ␀␀ÿ␀¤w·␀	␀␀␀␀␀␀mxdxdxì*␀␀Æÿ␀␀ÿ␀b´␀␀␀␀␀␀␀Ë<´a	cr␀Æÿ␀␀Ò␀␀␀&	␀t␀␀␀␀␀␀w␀L␀L␀n␀Æÿ␀␀ˆÓ␀␀␀l$Ì␀␀␀␀␀␀␀l%$$¼$w␀Æÿ␀␀…Ó␀␀␀Ó³␀␀€␀␀␀␀␀␀␀*´␀␀ñ³␀␀ñ³␀␀!␀␀ÿ␀␀ÿ␀×-‹␀␀␀␀␀␀␀£Am␀m␀—)␀␀Æÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀K␀␀␀␀␀␀␀␀␀␀␀‡Ú␀␀=#­␀	␀␀␀␀␀␀Ä>h:Ä>p␀Æÿ␀␀ÿ␀_CÑ␀	␀␀␀␀␀␀~M~M~MqC␀êÿ␀␀ÿ␀Ëu·␀	␀␀␀␀␀␀zzzs␀Æÿ␀␀ÿ␀¤÷␀␀´␀	␀␀␀␀␀␀jş␀␀Sş␀␀jş␀␀r␀Æÿ␀␀ÿ␀,␀.␀␀␀␀␀␀â$␀â$␀â$␀/␀␀ÿ␀␀ÿ␀4ù␀␀—␀␀␀␀␀␀␀␀␀p␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3␀␀|␀␀␀␀␀␀␀␀ˆÚ␀␀Ş␀±␀	„␀␀␀␀␀␀lA{␀␀q␀Æÿ␀␀ŒÚ␀␀␀vU€␀„␀␀␀␀␀␀dY°V°Vw␀␀ÿ␀␀ÿ␀:U(„␀␀␀␀␀␀‚␀t␀ƒ␀1␀␀ÿ␀␀ÿ␀Få␀„␀␀␀␀␀␀ÖÇÇn␀Æÿ␀␀ÿ␀K1=„␀␀␀␀␀␀?44b4c␀␀␀ÿ␀␀ÿ␀›,­␀„␀␀␀␀␀␀ò-iqlqp␀Æÿ␀␀—×␀␀␀Éi=„␀␀␀␀␀␀j
