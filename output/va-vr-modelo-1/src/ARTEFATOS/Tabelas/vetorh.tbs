–␀␀PROCEDURE R073ALU_ATUCON(P_NUMMAT VARCHAR2(15),P_CODPRM NUMBER,P_PRMSAB NUMBER,P_PRMDOM NUMBER,P_PRMFER NUMBER,P_CONTPM CHAR,P_USABIO NUMBER,P_GRACON NUMBER,P_CONADP CHAR,P_NOMPES VARCHAR2(40),P_DDIFON VARCHAR2(3),P_DDDFON VARCHAR2(3),P_NUMFON VARCHAR2(20),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_CONREE CHAR,P_USARFA CHAR)
 IS

