DECLARE @l_segdocstr VARCHAR(255)
DECLARE @l_emicidstr VARCHAR(255)
DECLARE @l_estcidstr VARCHAR(255)
DECLARE @l_dexcidstr VARCHAR(255)
DECLARE @l_codnacstr VARCHAR(255)
DECLARE @l_nomvisstr VARCHAR(255)
DECLARE @l_codormstr VARCHAR(255)
DECLARE @l_nomoemstr VARCHAR(255)
