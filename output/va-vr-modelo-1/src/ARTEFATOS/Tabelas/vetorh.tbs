	l_CmpDatPag DATE;
	l_codcat NUMBER(4);
	l_tipSer NUMBER(1);
	l_DataReferencia DATE;
BEGIN
	/* Caso informado codigo de serviço e o codigo de retenção for 588 - Rend.Trab.s/Vinc.Empregaticio, retornar tipo de serviço para posterior verificação de direitos autorais.
	   Em resumo, pagamento de direitos autorais pode possuir base de INSS zerada mas precisa ser enviado ao eSocial */
	IF (:NEW.BASINS = 0) AND (:NEW.CODSER <> 0) AND (:NEW.CODRET = 588) THEN
		RH_RETTIPSER(:NEW.CODSER, l_tipSer OUT);
	ELSE
		l_tipSer := -1;
	END IF;
	
    l_DataReferencia := DATETIMEADD(MM, +1, :NEW.CMPPTE);
	/* Verifica se possui base INSS informada OU a categoria eSocial for 903 - Bolsista, nos termos da lei 8958/1994 OU tipo de serviço for 2 - Direitos autorais e intelectuais */
	RH_RETCODCATCOL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DataReferencia, l_codcat OUT);
	IF (:NEW.BASINS > 0) OR (l_codcat = 903) OR (l_tipSer = 2) THEN
		l_CmpDatPag := DATETIME(1, MONTH(:NEW.CMPPTE), YEAR(:NEW.CMPPTE), 0, 0, 0);
		BEGIN
			SP_R350PEM(:NEW.NUMEMP,:NEW.CODFIL,:NEW.TIPCOL,:NEW.NUMCAD,l_CmpDatPag,1,5,1,'S-1200');
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro gerar registro de pendência mensal para envio do layout S-1200.';
		END;
	END IF;
END␀óÒ␀␀		SENIOR;0Î␀␀

TRIGGER R032TPG_EU AFTER UPDATE ON R032TPG FOR EACH ROW DECLARE
	l_CmpDatPag DATE;
	l_codcat NUMBER(4);
	l_tipSer NUMBER(1);
	l_DataReferencia DATE;	
BEGIN
	l_tipSer := -1;
	/* Caso informado codigo de serviço e o codigo de retenção for 588 - Rend.Trab.s/Vinc.Empregaticio, retornar tipo de serviço para posterior verificação de direitos autorais.
	   Em resumo, pagamento de direitos autorais pode possuir base de INSS zerada mas precisa ser enviado ao eSocial */
	IF (:NEW.BASINS = 0) AND (:NEW.CODSER <> 0) AND (:NEW.CODRET = 588) THEN
		RH_RETTIPSER(:NEW.CODSER, l_tipSer OUT);
	END IF;
	
	/* Se o novo é 2 - Direitos autorais e intelectuais deve gerar pendencia, senão deve verificar se antes era direitos autorais com base zerada */
	IF (l_tipSer <> 2) THEN
		IF (:OLD.BASINS = 0) AND (:OLD.CODSER <> 0) AND (:OLD.CODRET = 588) THEN
			RH_RETTIPSER(:OLD.CODSER, l_tipSer OUT);
		END IF;
	END IF;
	l_DataReferencia := DATETIMEADD(MM, +1, :NEW.CMPPTE);
	RH_RETCODCATCOL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DataReferencia, l_codcat OUT);
	IF ((:OLD.BASINS > 0) OR (:NEW.BASINS > 0)) OR (l_codcat = 903) OR (l_tipSer = 2) THEN
		l_CmpDatPag := DATETIME(1, MONTH(:NEW.CMPPTE), YEAR(:NEW.CMPPTE), 0, 0, 0);
		BEGIN
			SP_R350PEM(:NEW.NUMEMP,:NEW.CODFIL,:NEW.TIPCOL,:NEW.NUMCAD,l_CmpDatPag,1,5,1,'S-1200');
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro gerar registro de pendência mensal para envio do layout S-1200.';
		END;
	END IF;
END␀ñÒ␀␀		SENIOR;0␀␀

TRIGGER R032TPG_ED AFTER DELETE ON R032TPG FOR EACH ROW DECLARE
	l_CmpDatPag DATE;
	l_codcat NUMBER(4);
	l_tipSer NUMBER(1);
	l_DataReferencia DATE;	
BEGIN
	/* Caso informado codigo de serviço e o codigo de retenção for 588 - Rend.Trab.s/Vinc.Empregaticio, retornar tipo de serviço para posterior verificação de direitos autorais.
	   Em resumo, pagamento de direitos autorais pode possuir base de INSS zerada mas precisa ser enviado ao eSocial */
	IF (:OLD.BASINS = 0) AND (:OLD.CODSER <> 0) AND (:OLD.CODRET = 588) THEN
		RH_RETTIPSER(:OLD.CODSER, l_tipSer OUT);
	ELSE
		l_tipSer := -1;
	END IF;
	l_DataReferencia := DATETIMEADD(MM, +1, :OLD.CMPPTE);
	RH_RETCODCATCOL(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_DataReferencia, l_codcat OUT);
	IF (:OLD.BASINS > 0) OR (l_codcat = 903) OR (l_tipSer = 2) THEN
		l_CmpDatPag := DATETIME(1, MONTH(:OLD.CMPPTE), YEAR(:OLD.CMPPTE), 0, 0, 0);
		BEGIN
			SP_R350PEM(:OLD.NUMEMP,:OLD.CODFIL,:OLD.TIPCOL,:OLD.NUMCAD,l_CmpDatPag,1,5,1,'S-1200');
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro gerar registro de pendência mensal para envio do layout S-1200.';
		END;
	END IF;
END␀␀␀8º␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀öÒ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀—,¼␀	␀␀␀␀␀␀␀=nnX)␀␀Æÿ␀␀!#␀w+Ñ␀	␀␀␀␀␀␀␀Q0Í/Ó/œ␀␀␀êÿ␀␀ğÒ␀␀␀.␀t	␀␀␀␀␀␀␀O␀Ü␀Ü␀n␀Æÿ␀␀õÒ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀t%Ó
␀Ó
␀w␀Æÿ␀␀…Ó␀␀␀óı␀␀±␀	␀␀␀␀␀␀␀xş␀␀ü␀␀xş␀␀q␀Æÿ␀␀ôÒ␀␀␀#-´␀	␀␀␀␀␀␀␀AÆAAr␀Æÿ␀␀¶Ï␀␀␀␀‘␀␀␀␀␀␀␀␀¦␀¦␀¦␀h)␀␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3;4;5;6øÒ␀␀		SENIOR;0-␀␀TRIGGER R032TPO_EI AFTER INSERT ON R032TPO FOR EACH ROW DECLARE
	l_CmpDatPag DATE;
	l_PossuiEnvio NUMBER(1);
BEGIN
	BEGIN
	/* Busca se existe envio de S-1200 para o colaborador */
    SELECT 1 INTO l_PossuiEnvio
      FROM R350RPA
      WHERE NUMEMP = :NEW.NUMEMP 
		AND INDAPU = 1 
		AND PERAPU = :NEW.CMPPTE
		AND TIPCOL = :NEW.TIPCOL 
		AND NUMCAD = :NEW.NUMCAD
		AND SEQRE0 = (SELECT MAX(SEQRE0)
		FROM R350RPA RPA
        WHERE RPA.NUMEMP = NUMEMP
          AND RPA.TIPCOL = TIPCOL
          AND RPA.NUMCAD = NUMCAD
          AND RPA.PERAPU = PERAPU
          AND RPA.INDAPU = INDAPU); 
		
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_PossuiEnvio := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao ler R350RPA';
	END;
	
	IF (l_PossuiEnvio = 1) THEN
		l_CmpDatPag := DATETIME(1, MONTH(:NEW.CMPPTE), YEAR(:NEW.CMPPTE), 0, 0, 0);
		BEGIN
			SP_R350PEM(:NEW.NUMEMP,:NEW.CODFIL,:NEW.TIPCOL,:NEW.NUMCAD,l_CmpDatPag,1,5,1,'S-1200');
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro gerar registro de pendência mensal para envio do layout S-1200.';
		END;
	END IF;
END␀ùÒ␀␀		SENIOR;0,␀␀

