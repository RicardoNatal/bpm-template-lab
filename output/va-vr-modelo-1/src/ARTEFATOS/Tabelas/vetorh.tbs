ƒ␀␀/* Atualiza as permissões da tabela REPEMPR002 */
PROCEDURE SP_REPEMPR002_CPF(P_NUMCRA NUMBER(12),P_NUMCPF NUMBER(11),P_NUMPIS NUMBER(12),P_NOMFUN VARCHAR2(40))
 IS

  l_ifunc       VARCHAR(12);
  l_pis         CHAR(12);
  l_cpf         CHAR(11);
  l_nome        CHAR(40);
  l_retstr      VARCHAR(1);
  l_utirep      CHAR(1);
  l_rep671      CHAR(1);
  l_AtuRep      BOOLEAN;
  l_count       NUMBER;
  l_reterr      NUMBER(1);
  l_comando     CHAR(2048);
  l_usutel      VARCHAR(31);
BEGIN
  l_reterr := 0;
  SP_USUTEL(l_usutel OUT);
  /* verifica se tem as tabelas de REP TSI*/
  l_utirep := 'N';
  l_rep671 := 'N';
  BEGIN
      SELECT UTIREP, REP671 INTO l_utirep, l_rep671 FROM R070TSI;
  EXCEPTION
      WHEN OTHERS THEN
          l_utirep := 'N';
          l_rep671 := 'N';
  END;

  IF (l_utirep = 'S') THEN
      /* Verifica se a pessoa é para gerar */
      l_AtuRep := TRUE;
	  
	  SP_INTSTR(p_numcra, '999999999999',l_ifunc OUT);

      /* verifica se tem PIS ou CPF*/
      IF (p_numpis = 0) AND (p_numcpf = 0) THEN
        l_AtuRep := FALSE;
      ELSE
        SP_INTSTR(p_numpis, '999999999999',l_pis OUT);
        SP_INTSTR(p_numcpf, '99999999999',l_cpf OUT);
      END IF;

      /* verifica se tem nome */
      IF (p_nomfun IS NULL) THEN
        l_AtuRep := FALSE;
      ELSE
        l_nome := p_nomfun;
      END IF;

      /* realiza o processamento */
      IF (l_AtuRep = TRUE) THEN

          /*Verifica se já existe*/
          l_count:= 0;
          l_comando := 'SELECT COUNT(*) FROM '||l_usutel||'REPEMPR002 WHERE IFUNC = '''||l_ifunc||'''';
          SP_SELTSI(0, 'l_count', l_comando, l_count OUT, l_retstr OUT, l_reterr OUT);
          /*EXCEÇÃO NO_DATA_FOUND OU TOO_MANY_ROWS*/
          IF (l_reterr = 1) OR (l_reterr = 2) THEN
            l_count := 0;
          END IF;

          IF (l_count = 0) THEN
              /*COMANDO DINÂMICO*/
              IF (l_rep671 = 'S') THEN
                  l_comando := 'INSERT INTO '||l_usutel||'REPEMPR002 (IFUNC, PIS, NOME, CPF) VALUES ('''||l_ifunc||''','''||l_pis||''','''||l_nome||''','''||l_cpf||''')';
              ELSE
                  l_comando := 'INSERT INTO '||l_usutel||'REPEMPR002 (IFUNC, PIS, NOME) VALUES ('''||l_ifunc||''','''||l_pis||''','''||l_nome||''')';
              END IF;
              SP_CMDTSI(l_comando);
          ELSE
              /*COMANDO DINÂMICO*/
              IF (l_rep671 = 'S') THEN
                  l_comando := 'UPDATE '||l_usutel||'REPEMPR002 SET PIS = '''||l_pis||''', NOME = '''||l_nome||''', CPF = '''||l_cpf||''' WHERE IFUNC = '''||l_ifunc||'''';
              ELSE
                  l_comando := 'UPDATE '||l_usutel||'REPEMPR002 SET PIS = '''||l_pis||''', NOME = '''||l_nome||''' WHERE IFUNC = '''||l_ifunc||'''';
              END IF;
              SP_CMDTSI(l_comando);
          END IF;
      END IF;
  END IF; /* END R070TSI.UtiRep*/
END		SENIOR;239SP_USUTEL
SP_INTSTR
SP_SELTSI
SP_CMDTSI
SP_RETICARD
