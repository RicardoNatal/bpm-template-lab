␀␀›œ␀␀F ›œ␀␀n␀Æÿ␀␀ÿ1j␀␀×Ôÿ?␀␀␀␀␀ƒ␀␀¡␀␀ƒ␀␀c␀␀␀ÿ␀␀ÿA‘␀␀Ñ␀Ôÿ?␀␀␀␀␀ÓG¥GÑGqC␀␀êÿ␀␀ÿ␀)+Ñ␀Ôÿ?␀␀␀␀␀M&M&M&qC␀␀êÿ␀␀ÿ␀++Ñ␀Ôÿ?␀␀␀␀␀U&U&U&qC␀␀êÿ␀␀ÿ␀,+=Ôÿ?␀␀␀␀␀W&W&W&c␀␀␀ÿ␀␀ÿ␀-+´␀Ôÿ?␀␀␀␀␀Y&Y&Y&r␀Æÿ␀␀ÿ␀.+‘␀Ôÿ?␀␀␀␀␀[&[&[&h)␀␀Æÿ␀␀ÿ␀/+*Ôÿ?␀␀␀␀␀\&\&\&,␀␀ÿ␀␀ÿ␀0+*Ôÿ?␀␀␀␀␀]&]&]&,␀␀ÿ␀␀ÿ␀²dÍÔÿ?␀␀␀␀␀F¥␀␀D¥␀␀E¥␀␀n␀Æÿ␀␀ÿ0‘␀␀Ñ␀Ôÿ?␀␀␀␀␀ÔG¦GÒGqC␀␀êÿ␀␀ÿ␀2EÑ␀Ôÿ?␀␀␀␀␀•␀␀°”␀␀°”␀␀qC␀êÿ␀␀ÿ␀‘␀␀Ñ␀Ôÿ?␀␀␀␀␀BN§GĞGqC␀␀êÿ␀␀ÿ␀H␀—Ôÿ1␀␀␀␀␀ÆXÆXÆXn␀␀Æÿ␀␀ÿ0␀␀␀0øÑ␀␀		SENIOR;0“␀␀TRIGGER R030DES_EI AFTER INSERT ON R030DES FOR EACH ROW
DECLARE
	l_Valor	VARCHAR(1000);
	xTipAmb   R030DES.TIPAMB%TYPE;
	xNumEmp   R030DES.NUMEMP%TYPE;
BEGIN
	xTipAmb := :NEW.TIPAMB;
	xNumEmp := :NEW.NUMEMP;
	l_Valor := 'Incluído o Tipo Ambiente ' || CONVERT(NUMBER_TO_CHAR, xTipAmb) || ' nas Definições do eSocial da Empresa ' || CONVERT(NUMBER_TO_CHAR, xNumEmp) || '.';
	SP_GRAVALPR(185, l_Valor);
END␀ùÑ␀␀		SENIOR;0 9␀␀

TRIGGER R030DES_EU AFTER UPDATE ON R030DES FOR EACH ROW
DECLARE
	l_Valor			VARCHAR(1000);
    l_ValorAux	    VARCHAR(1000);
	xDatAnt 		VARCHAR(20);
	xDatNov 		VARCHAR(20);
	l_ValorVARCHAR 	VARCHAR2(20);
BEGIN
	/* Os campos que não serão monitorados */
	/* UltMat - Última Matrícula */
	/* ConInd - Enviar Contr. Individual Opcionais S-2300 */
	/* DetNfe - Enviar Detalhamento Nota Fiscal S-1260 */
	/* EnvObs - Enviar Observações Eventos S-1010 */
	/* HorCon - Enviar Grupo Horário Contratual S-2200/S-2206 */
	/* FecFol - Consistir Fechamento Folha S-1299 */
	/* EnvPla - Enviar Plano de Saúde S-1200/S-2299/S-2399 */

	/* Verifica se alterou os demais campos e grava no log */
	IF  (:NEW.DATUES <> :OLD.DATUES) OR
		(:NEW.TERSIS <> :OLD.TERSIS) OR
		(:NEW.TERUES <> :OLD.TERUES) OR
		(:NEW.GERLOT <> :OLD.GERLOT) OR
		(:NEW.OLDLOT <> :OLD.OLDLOT) OR
		(:NEW.DATPEN <> :OLD.DATPEN) OR
		(:NEW.DTGFIP <> :OLD.DTGFIP) OR
		(:NEW.ABRISE <> :OLD.ABRISE) OR
		(:NEW.IDEEMP <> :OLD.IDEEMP) OR
		(:NEW.TIPAMB <> :OLD.TIPAMB) OR
		(:NEW.DATTAB <> :OLD.DATTAB) OR
		(:NEW.FUNESO <> :OLD.FUNESO) OR
		(:NEW.BASDES <> :OLD.BASDES) OR
		(:NEW.BASSEQ <> :OLD.BASSEQ) OR
		(:NEW.ININPE <> :OLD.ININPE) OR
		(:NEW.INIPER <> :OLD.INIPER) OR
		(:NEW.OPCDIS <> :OLD.OPCDIS) OR
		(:NEW.PRXVER <> :OLD.PRXVER) OR
		(:NEW.CARFUN <> :OLD.CARFUN) OR
		(:NEW.REMCPL <> :OLD.REMCPL) OR
		(:NEW.INISST <> :OLD.INISST) OR
		(:NEW.INSST2 <> :OLD.INSST2) OR
		(:NEW.INIDCT <> :OLD.INIDCT) OR
		(:NEW.SENALT <> :OLD.SENALT) OR
		(:NEW.CONPAR <> :OLD.CONPAR) OR
		(:NEW.RESEXA <> :OLD.RESEXA) OR
		(:NEW.SIMFOL <> :OLD.SIMFOL) OR
		(:NEW.MOSPRE <> :OLD.MOSPRE) OR
		(:NEW.INFFAC <> :OLD.INFFAC) OR
		(:NEW.GEREVT <> :OLD.GEREVT) OR
		(:NEW.ENVIPE <> :OLD.ENVIPE) THEN
  		
		/* A gravação será campo a campo pois a R067PLR tem limitação de 300 caracteres por log. */
		l_ValorAux := 'Foram alteradas as Definições do eSocial da Empresa ' || CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP) || '.';
   		
		IF (:NEW.DATUES <> :OLD.DATUES) THEN
			SP_DATSTR(:OLD.DATUES, 'DDMMYYYY', l_ValorVARCHAR OUT);
			xDatAnt := SUBSTRING(l_ValorVARCHAR, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 5, 4);
		 	SP_DATSTR(:NEW.DATUES, 'DDMMYYYY', l_ValorVARCHAR OUT);
		 	xDatNov := SUBSTRING(l_ValorVARCHAR, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 5, 4);
		 	
		 	l_Valor := '';
			l_Valor := l_ValorAux || ' - Campo: Início Tabelas. Valor Anterior: ' || xDatAnt || ', Valor Novo: ' || xDatNov || '.';
			SP_GRAVALPR(185, l_Valor);
		END IF;
		
		IF (:NEW.TERSIS <> :OLD.TERSIS) THEN
			SP_DATSTR(:OLD.TERSIS, 'DDMMYYYY', l_ValorVARCHAR OUT);
			xDatAnt := SUBSTRING(l_ValorVARCHAR, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 5, 4);
		 	SP_DATSTR(:NEW.TERSIS, 'DDMMYYYY', l_ValorVARCHAR OUT);
		 	xDatNov := SUBSTRING(l_ValorVARCHAR, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 5, 4);
			
			l_Valor := '';
			l_Valor := l_ValorAux ||' - Campo: Data da Troca de Sistema pela Empresa. Valor Anterior: ' || xDatAnt || ', Valor Novo: ' || xDatNov || '.';
			SP_GRAVALPR(185, l_Valor);
		END IF;

		IF (:NEW.TERUES <> :OLD.TERUES) THEN
			SP_DATSTR(:OLD.TERUES, 'DDMMYYYY', l_ValorVARCHAR OUT);
			xDatAnt := SUBSTRING(l_ValorVARCHAR, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 5, 4);
		 	SP_DATSTR(:NEW.TERUES, 'DDMMYYYY', l_ValorVARCHAR OUT);
		 	xDatNov := SUBSTRING(l_ValorVARCHAR, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 5, 4);
			
			l_Valor := '';
			l_Valor := l_ValorAux || ' - Campo: Data Encerramento Empresa. Valor Anterior: ' || xDatAnt || ', Valor Novo: ' || xDatNov || '.';
			SP_GRAVALPR(185, l_Valor);
		END IF;
		
		IF (:NEW.GERLOT <> :OLD.GERLOT) THEN
		    l_Valor := '';
			l_Valor := l_ValorAux || ' - Campo: Geração Lotação. Valor Anterior: ' || CONVERT(NUMBER_TO_CHAR, :OLD.GERLOT) || ', Valor Novo: ' || CONVERT(NUMBER_TO_CHAR, :NEW.GERLOT) || '.';
			SP_GRAVALPR(185, l_Valor);
		END IF;
		
		IF (:NEW.OLDLOT <> :OLD.OLDLOT) THEN
			l_Valor := '';
			l_Valor := l_ValorAux || ' - Campo: Lotação Anterior. Valor Anterior: ' || CONVERT(NUMBER_TO_CHAR, :OLD.OLDLOT) || ', Valor Novo: ' || CONVERT(NUMBER_TO_CHAR, :NEW.OLDLOT) || '.';
			SP_GRAVALPR(185, l_Valor);
		END IF;
		
		IF (:NEW.DATPEN <> :OLD.DATPEN) THEN
			SP_DATSTR(:OLD.DATPEN, 'DDMMYYYY', l_ValorVARCHAR OUT);
			xDatAnt := SUBSTRING(l_ValorVARCHAR, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 5, 4);
		 	SP_DATSTR(:NEW.DATPEN, 'DDMMYYYY', l_ValorVARCHAR OUT);
		 	xDatNov := SUBSTRING(l_ValorVARCHAR, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 5, 4);
			
			l_Valor := '';
			l_Valor := l_ValorAux || ' - Campo: Data Pendência. Valor Anterior: ' || xDatAnt || ', Valor Novo: ' || xDatNov || '.';
			SP_GRAVALPR(185, l_Valor);
		END IF;
		
		IF (:NEW.DTGFIP <> :OLD.DTGFIP) THEN
			SP_DATSTR(:OLD.DTGFIP, 'DDMMYYYY', l_ValorVARCHAR OUT);
			xDatAnt := SUBSTRING(l_ValorVARCHAR, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 5, 4);
		 	SP_DATSTR(:NEW.DTGFIP, 'DDMMYYYY', l_ValorVARCHAR OUT);
		 	xDatNov := SUBSTRING(l_ValorVARCHAR, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 5, 4);
			
			l_Valor := '';
			l_Valor := l_ValorAux || ' - Campo: Comp. Substituição GFIP. Valor Anterior: ' || xDatAnt || ', Valor Novo: ' || xDatNov || '.';
			SP_GRAVALPR(185, l_Valor);
		END IF;
		
		IF (:NEW.ABRISE <> :OLD.ABRISE) THEN
			l_Valor := '';
			l_Valor := l_ValorAux || ' - Campo: Totalizador Isento. Valor Anterior: ' || :OLD.ABRISE || ', Valor Novo: ' || :NEW.ABRISE || '.';
			SP_GRAVALPR(185, l_Valor);
		END IF;
		
		IF (:NEW.IDEEMP <> :OLD.IDEEMP) THEN
			l_Valor := '';
			l_Valor := l_ValorAux || ' - Campo: Identificador empresa. Valor Anterior: ' || :OLD.IDEEMP || ', Valor Novo: ' || :NEW.IDEEMP || '.';
		 	SP_GRAVALPR(185, l_Valor);
		END IF;
		
		IF (:NEW.TIPAMB <> :OLD.TIPAMB) THEN
			l_Valor := '';
			l_Valor := l_ValorAux || ' - Campo: Tipo de Ambiente. Valor Anterior: ' || CONVERT(NUMBER_TO_CHAR, :OLD.TIPAMB) || ', Valor Novo: ' || CONVERT(NUMBER_TO_CHAR, :NEW.TIPAMB) || '.';
			SP_GRAVALPR(185, l_Valor);
		END IF;
		
		IF (:NEW.DATTAB <> :OLD.DATTAB) THEN
			SP_DATSTR(:OLD.DATTAB, 'DDMMYYYY', l_ValorVARCHAR OUT);
			xDatAnt := SUBSTRING(l_ValorVARCHAR, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 5, 4);
		 	SP_DATSTR(:NEW.DATTAB, 'DDMMYYYY', l_ValorVARCHAR OUT);
		 	xDatNov := SUBSTRING(l_ValorVARCHAR, 1, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 3, 2) || '/' || SUBSTRING(l_ValorVARCHAR, 5, 4);

			l_Valor := '';
			l_Valor := l_ValorAux || ' - Campo: Data início tabelas. Valor Anterior: ' || xDatAnt || ', Valor Novo: ' || xDatNov || '.';
			SP_GRAVALPR(185, l_Valor);
		END IF;
		
		IF (:NEW.FUNESO <> :OLD.FUNESO) THEN
			l_Valor := '';
			l_Valor := l_ValorAux || ' - Campo: Função eSocial. Valor Anterior: ' || CONVERT(NUMBER_TO_CHAR, :OLD.FUNESO) || ', Valor Novo: ' || CONVERT(NUMBER_TO_CHAR, :NEW.FUNESO) || '.';
			SP_GRAVALPR(185, l_Valor);
