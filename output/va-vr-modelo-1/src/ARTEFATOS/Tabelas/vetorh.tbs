␀␀0;1;2;3;4;5îØ␀␀		SENIOR;0␀␀/* Trigger de Atualizacao dos Saldos de Situacoes apos */
/* Inclusao de Situacao na Apuracao.                   */
TRIGGER R066SIT_EI AFTER INSERT ON R066SIT FOR EACH ROW
DECLARE
     l_colaboradordogestaoponto   BOOLEAN;
     l_codCli   R250TAB.CODCLI%TYPE;
BEGIN

/* Colaboradores do gestão de ponto não geram saldo de situações. */
RH_COLABORADOR_GPO(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD, l_colaboradordogestaoponto OUT);

QL_RETORNACODCLI(l_codCli OUT);
     
IF ((l_colaboradordogestaoponto = FALSE) OR (l_codCli = 553))  THEN
	R066SIT_ATUSAL ('I',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATAPU,:NEW.CODSIT,:NEW.QTDHOR,0);
END IF;
END␀ïØ␀␀		SENIOR;0␀␀

/* Trigger de Atualizacao dos Saldos de Situacoes apos */
/* Alteracao de Situacao na Apuracao.                  */
TRIGGER R066SIT_EU AFTER UPDATE ON R066SIT FOR EACH ROW
DECLARE
     l_colaboradordogestaoponto   BOOLEAN;
     l_codCli   R250TAB.CODCLI%TYPE;
BEGIN
/* Colaboradores do gestão de ponto não geram saldo de situações. */
RH_COLABORADOR_GPO(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD, l_colaboradordogestaoponto OUT);

QL_RETORNACODCLI(l_codCli OUT);
     
IF ((l_colaboradordogestaoponto = FALSE) OR (l_codCli = 553))   THEN
	R066SIT_ATUSAL ('U',:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATAPU,:NEW.CODSIT,:NEW.QTDHOR,:OLD.QTDHOR);
END IF;
END␀íØ␀␀		SENIOR;0W␀␀

/* Trigger de Atualizacao dos Saldos de Situacoes apos */
TRIGGER R066SIT_ED AFTER DELETE ON R066SIT FOR EACH ROW
DECLARE
     l_colaboradordogestaoponto   BOOLEAN;
     l_codCli   R250TAB.CODCLI%TYPE;
BEGIN
/* Colaboradores do gestão de ponto não geram saldo de situações. */
RH_COLABORADOR_GPO(:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD, l_colaboradordogestaoponto OUT);

QL_RETORNACODCLI(l_codCli OUT);
     
IF ((l_colaboradordogestaoponto = FALSE) OR (l_codCli = 553))  THEN
	R066SIT_ATUSAL ('D',:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.DATAPU,:OLD.CODSIT,0,:OLD.QTDHOR);
