  CURSOR c_R073DIA_upd IS SELECT NUMMAT,DATINI FROM R073ATA_AUX;
  TYPE t_R073DIA_aux IS RECORD(
      NUMMAT   R073ATA_AUX.NUMMAT%TYPE,
      DATINI   R073ATA_AUX.DATINI%TYPE);
  l_R073DIA_aux t_R073DIA_aux;

BEGIN
  l_data_limite := DATETimeAdd(DD,6,CURDATE());
  FOREACH c_R073DIA_upd INTO l_R073DIA_aux.NUMMAT,
                             l_R073DIA_aux.DATINI
  LOOP
      IF  (l_R073DIA_aux.DATINI <= l_data_limite) THEN
          SP_AtuHor (0,6,0,l_R073DIA_aux.NumMat);
      END IF;
  END LOOP;

  BEGIN
      DELETE FROM R073ATA_AUX;
  EXCEPTION
      WHEN OTHERS THEN NULL;
  END;
END␀ÈÚ␀␀		SENIOR;0x␀␀

TRIGGER R073DIA_EU AFTER UPDATE ON R073DIA FOR EACH ROW

DECLARE
l_online BOOLEAN;
BEGIN
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN
      BEGIN
          INSERT INTO R073ATA_AUX (NUMMAT,DATINI) VALUES (:NEW.NUMMAT,:NEW.DATINI);
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'Erro no INSERT em R073ATA_AUX.';
      END;
  END IF;
END␀ÉÚ␀␀	SENIOR;0␀␀

TRIGGER R073DIA_SD AFTER DELETE ON R073DIA

DECLARE
l_data_limite  DATE;

  CURSOR c_R073DIA_del IS SELECT NUMMAT,DATINI FROM R073ATA_AUX;
  TYPE t_R073DIA_aux IS RECORD(
      NUMMAT   R073ATA_AUX.NUMMAT%TYPE,
      DATINI   R073ATA_AUX.DATINI%TYPE);
  l_R073DIA_aux t_R073DIA_aux;

BEGIN
  l_data_limite := DATETimeAdd(DD,6,CURDATE());

  /* Le Registro do CURSOR */
  FOREACH c_r073dia_del INTO l_R073DIA_aux.NUMMAT,
                             l_R073DIA_aux.DATINI
  LOOP
      IF  (l_R073DIA_aux.DATINI <= l_data_limite) THEN
          SP_AtuHor(0,6,0,l_R073DIA_aux.NUMMAT);
      END IF;
  END LOOP;

  /* Apaga Registro OLD em R073ATA_AUX */
  BEGIN
      DELETE FROM R073ATA_AUX;
  EXCEPTION
      WHEN OTHERS THEN NULL;
  END;
END␀ÆÚ␀␀		SENIOR;0w␀␀

