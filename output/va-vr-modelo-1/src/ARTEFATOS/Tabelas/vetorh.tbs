BEGIN
SP_VerOnLine(l_online OUT);
IF   (l_online = TRUE) THEN
     IF  (:NEW.STAATU = 1) THEN
         R070MES_ATUCON('I',:NEW.NUMCRA,:NEW.DATFIM,:NEW.HORFIM,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD);
     END IF;
END IF;
END␀Ú␀␀		SENIOR;0ó␀␀

TRIGGER R070MES_EU AFTER UPDATE ON R070MES FOR EACH ROW

DECLARE
l_online       BOOLEAN;

BEGIN
SP_VerOnLine(l_online OUT);
IF   (l_online = TRUE) THEN
     IF  (:NEW.STAATU > 1) THEN
         R070MES_ATUCON('D',:NEW.NUMCRA,:NEW.DATFIM,:NEW.HORFIM,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD);
     ELSE
         IF  (:NEW.STAATU = 1) THEN
             R070MES_ATUCON('U',:NEW.NUMCRA,:NEW.DATFIM,:NEW.HORFIM,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD);
         END IF;
     END IF;
END IF;
END␀Ú␀␀		SENIOR;0␀␀

TRIGGER R070MES_ED AFTER DELETE ON R070MES FOR EACH ROW

DECLARE
l_online       BOOLEAN;

BEGIN
SP_VerOnLine(l_online OUT);
IF   (l_online = TRUE) THEN
     R070MES_ATUCON('D',:OLD.NUMCRA,:OLD.DATFIM,:OLD.HORFIM,:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD);
END IF;
