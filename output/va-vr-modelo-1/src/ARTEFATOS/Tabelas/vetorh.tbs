           l_datatu := CURDATE();

           SP_DATSTR(l_datatu,'DDMMYY',l_dataux OUT);
           l_dataux := SUBSTRING(l_dataux,5,2)||SUBSTRING(l_dataux,3,2)||SUBSTRING(l_dataux,1,2);

           l_horaux := HOUR(CURTIME());
           SP_INTSTR(l_horaux,'99',l_horstr OUT);

           l_minaux := MINUTE(CURTIME());
           SP_INTSTR(l_minaux,'99',l_minstr OUT);

           l_segaux := SECOND(CURTIME());
           SP_INTSTR(l_segaux,'99',l_segstr OUT);

           l_ideaux := l_dataux||l_horstr||l_minstr||l_segstr;
           /*Obtem novamente o milésimo*/
           SELECT MAX(IDENTI) MAXIMO INTO l_atuiden FROM R600PEN WHERE IDENTI LIKE l_ideaux||'%';

           IF ((l_atuiden IS NULL) OR (l_atuiden = ' ')) THEN
               l_milseg:= 0;
           ELSE
               l_milseg:= CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_atuiden,13,2)));
           END IF;
        END LOOP;
        /*Monta o Identificador*/
