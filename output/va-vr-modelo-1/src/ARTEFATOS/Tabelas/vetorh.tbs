è␀␀PROCEDURE RegisterAccess(P_MODID IN NUMBER(5), P_CODUSU IN NUMBER(10), P_ITEMID IN NUMBER(10), P_ITKIND IN NUMBER(1), P_DATACC IN DATE) 
IS

	L_COUNTER NUMBER(10);
	L_DATE_LIMIT DATE;
BEGIN
	/* TABELA DE ACESSOS RECENTES*/
	SELECT COUNT(1) INTO L_COUNTER FROM R975RAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITEMID = P_ITEMID;
	
	IF (L_COUNTER > 0) THEN
		UPDATE R975RAC SET DATACC = P_DATACC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITEMID = P_ITEMID;
	ELSE
		INSERT INTO R975RAC (MODID, CODUSU, ITEMID, ITKIND, DATACC) VALUES (P_MODID, P_CODUSU, P_ITEMID, P_ITKIND, P_DATACC);
	END IF;
	
	ClearRecentAccess(P_MODID, P_CODUSU, P_ITKIND);
	
	
	/* TABELA DE MAIS ACESSADOS*/
	BEGIN
		SELECT ACCCNT INTO L_COUNTER FROM R975MAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITEMID = P_ITEMID;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			L_COUNTER := 0;
	END;
	
	IF (L_COUNTER > 0) THEN
		L_COUNTER := L_COUNTER + 1;
		UPDATE R975MAC SET DATACC = P_DATACC, ACCCNT = L_COUNTER WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITEMID = P_ITEMID;
	ELSE
		INSERT INTO R975MAC (MODID, CODUSU, ITEMID, ITKIND, DATACC, ACCCNT) VALUES (P_MODID, P_CODUSU, P_ITEMID, P_ITKIND, P_DATACC, 1);
	END IF;
	
	L_DATE_LIMIT := DATETIMEADD(DD , -60, P_DATACC);
	
	DELETE FROM R975MAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND DATACC <= L_DATE_LIMIT;
	
	DELETE FROM R975SNS WHERE MODID = P_MODID AND CODUSU = P_CODUSU AND ITEMID NOT IN (SELECT ITEMID FROM R975MAC WHERE MODID = P_MODID AND CODUSU = P_CODUSU);		 
END␀^ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_DATAHORA
Å␀␀PROCEDURE RH_250ALT (P_CODALT NUMBER)
 IS
 
	l_DatHorAtu NUMBER(14, 6);
	l_numreg NUMBER;
BEGIN
	SP_DATAHORA(l_DatHorAtu OUT, 'DH');
	SELECT COUNT(*) INTO l_numreg FROM R250ALT WHERE CodAlt = p_CodAlt; 
	IF l_numreg = 0 THEN
	BEGIN
		INSERT INTO R250ALT (CodAlt, DatHor) VALUES (p_CodAlt, l_DatHorAtu);
	EXCEPTION 
		WHEN OTHERS THEN NULL;
    END; 
	ELSE
		UPDATE R250ALT SET DatHor = l_DatHorAtu WHERE CodAlt = p_CodAlt;	
	END IF;
END␀_ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_DATAHORA
‘␀␀PROCEDURE RH_ALTHIEPOS
 IS

	l_DatHorAtu NUMBER(14, 6);
	l_numreg NUMBER;
BEGIN
	SP_DATAHORA(l_DatHorAtu OUT, 'DH');
	SELECT COUNT(*) INTO l_numreg FROM R250ALT WHERE CodAlt = 11; /* Hierarquia de postos */
	IF l_numreg = 0 THEN
		INSERT INTO R250ALT (CodAlt, DatHor) VALUES (11, l_DatHorAtu);
	ELSE
		UPDATE R250ALT SET DatHor = l_DatHorAtu WHERE CodAlt = 11; /* Hierarquia de postos */	
	END IF;
END␀`ì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE RH_ANOTACAOESOCIAL(P_CODIGONOTACAO NUMBER(3),P_TIPOESOCIAL OUT NUMBER)
 IS

l_tipoEsocial NUMBER(2); 
BEGIN
  BEGIN
    SELECT TPESOC INTO l_tipoEsocial 
      FROM R022NOT 
     WHERE CODNOT = p_codigoNotacao
       AND TPESOC IN (7, 8, 10, 11, 12, 13, 14, 15);
  EXCEPTION
  WHEN NO_DATA_FOUND THEN
    l_tipoEsocial := 0;
  END;
  
  p_tipoEsocial := l_tipoEsocial;
END␀aì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
É
␀␀PROCEDURE RH_ARCHIVING(P_NOMTAB VARCHAR2(255),P_PERREF DATE,P_TIPBAS INTEGER,P_TIPOPE VARCHAR2(255),P_REGCOM INTEGER)
 IS

CURSOR R066APU_CURSOR
        IS SELECT 
	      NUMEMP,TIPCOL,NUMCAD,DATAPU,HORDAT,CODUSU,USUVER,DIAALT,CODESC,CODTMA,TURINT 
           FROM R066APU
           WHERE DATAPU<=p_PerRef;

    CURSOR R066SIT_CURSOR
	IS SELECT 
	     NUMEMP,TIPCOL,NUMCAD,DATAPU,CODSIT,CODRAT,QTDHOR,MOTSIT
	   FROM R066SIT 
           WHERE DATAPU<= p_PerRef;

    CURSOR R070ACC_CURSOR
        IS SELECT 
             NUMCRA,DATACC,HORACC,SEQACC,TIPACC,CODPLT,CODRLG,CODFNC,DIRACC,QTDACC,ORIACC,USOMAR,
             NUMEMP,TIPCOL,NUMCAD,DATAPU,CODREF,USOREF,VALREF,CODSOR,FLAACC,CODBNF,STARLG,EXCPON,CODDSP
	   FROM R070ACC 
           WHERE DATACC<=p_PerRef;


    TYPE t_R066APU_aux IS RECORD(
        NUMEMP   R066APU.NUMEMP%TYPE,
        TIPCOL   R066APU.TIPCOL%TYPE,
        NUMCAD   R066APU.NUMCAD%TYPE,
        DATAPU   R066APU.DATAPU%TYPE,
        HORDAT   R066APU.HORDAT%TYPE,
        CODUSU   R066APU.CODUSU%TYPE,
        USUVER   R066APU.USUVER%TYPE,
        DIAALT   R066APU.DIAALT%TYPE,
        CODESC   R066APU.CODESC%TYPE,
        CODTMA   R066APU.CODTMA%TYPE,
        TURINT   R066APU.TURINT%TYPE
      );

    TYPE t_R066SIT_aux IS RECORD(
        NUMEMP   R066SIT.NUMEMP%TYPE,
        TIPCOL   R066SIT.TIPCOL%TYPE,
        NUMCAD   R066SIT.NUMCAD%TYPE,
        DATAPU   R066SIT.DATAPU%TYPE,
        CODSIT   R066SIT.CODSIT%TYPE,
        CODRAT   R066SIT.CODRAT%TYPE,
        QTDHOR   R066SIT.QTDHOR%TYPE,
        MOTSIT   R066SIT.MOTSIT%TYPE
      );

    TYPE t_R070ACC_aux IS RECORD(
        NUMCRA   R070ACC.NUMCRA%TYPE,
        DATACC   R070ACC.DATACC%TYPE,
        HORACC   R070ACC.HORACC%TYPE,
        SEQACC   R070ACC.SEQACC%TYPE,
        TIPACC   R070ACC.TIPACC%TYPE,
        CODPLT   R070ACC.CODPLT%TYPE,
        CODRLG   R070ACC.CODRLG%TYPE,
        CODFNC   R070ACC.CODFNC%TYPE,
        DIRACC   R070ACC.DIRACC%TYPE,
        QTDACC   R070ACC.QTDACC%TYPE,
        ORIACC   R070ACC.ORIACC%TYPE,
        USOMAR   R070ACC.USOMAR%TYPE,
        NUMEMP   R070ACC.NUMEMP%TYPE,
        TIPCOL   R070ACC.TIPCOL%TYPE,
        NUMCAD   R070ACC.NUMCAD%TYPE,
        DATAPU   R070ACC.DATAPU%TYPE,
        CODREF   R070ACC.CODREF%TYPE,
        USOREF   R070ACC.USOREF%TYPE,
        VALREF   R070ACC.VALREF%TYPE,
        CODSOR   R070ACC.CODSOR%TYPE,
        FLAACC   R070ACC.FLAACC%TYPE,
        CODBNF   R070ACC.CODBNF%TYPE,
        STARLG   R070ACC.STARLG%TYPE,
        EXCPON   R070ACC.EXCPON%TYPE,
        CODDSP   R070ACC.CODDSP%TYPE
      );

    xR066APU_aux t_R066APU_aux;
    xR066SIT_aux t_R066SIT_aux;
    xR070ACC_aux t_R070ACC_aux;
BEGIN
  NULL;
END␀bì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
¯)␀␀/* Stored Procedure que atualiza a Ficha do Colaborador com o maior Grau de Instrução encontrado nos Históricos */
PROCEDURE RH_ATGRIN(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_SITCUF NUMBER(1),P_NIVCUF NUMBER(2),P_SEQNIV NUMBER(3),P_FASCUF VARCHAR2(255),P_ORIGEM VARCHAR2(255))
 IS

l_SitCuf         R124HCF.SITCUF%TYPE;
  l_NivCuf         R127FAS.NIVCUF%TYPE;
  l_SeqNiv         R127FAS.SEQNIV%TYPE;
  l_FasCuf         R127FAS.FASCUF%TYPE;
  l_RaiAtu         R022GRA.INSRAI%TYPE;
  l_RaiNew         R022GRA.INSRAI%TYPE;
  l_GinAtu         R034FUN.GRAINS%TYPE;
  l_AntGin         R034FUN.GRAINS%TYPE;
  l_NivAtu         R127FAS.NIVCUF%TYPE;
  l_NivNew         R127FAS.NIVCUF%TYPE;
  l_strerr       VARCHAR2(255);
  l_NumEmp         R034FUN.NUMEMP%TYPE;
  l_TipCol         R034FUN.TIPCOL%TYPE;
  l_NumCad         R034FUN.NUMCAD%TYPE;
  l_GinMax         R022GRA.GRAINS%TYPE;
  l_GinCpl         R022GRA.GRAINS%TYPE;
  l_RaiCpl         R022GRA.INSRAI%TYPE;
  l_GinInc         R022GRA.GRAINS%TYPE;
  l_RaiInc         R022GRA.INSRAI%TYPE;
  l_GinMaxCpl      R022GRA.GRAINS%TYPE;
  l_RaiMaxCpl      R022GRA.INSRAI%TYPE;
  l_GinMaxInc      R022GRA.GRAINS%TYPE;
  l_RaiMaxInc      R022GRA.INSRAI%TYPE;

  CURSOR C_R124HCF IS
  SELECT DISTINCT HCF1.SITCUF, HCF1.NIVCUF, HCF1.SEQNIV, HCF1.FASCUF
    FROM R124HCF HCF1, R127FAS FAS1, R022GRA GRA1
   WHERE HCF1.NUMEMP = l_NumEmp
     AND HCF1.TIPCOL = l_TipCol
     AND HCF1.NUMCAD = l_NumCad
     AND HCF1.NIVCUF = FAS1.NIVCUF
     AND HCF1.SEQNIV = FAS1.SEQNIV
     AND HCF1.FASCUF = FAS1.FASCUF
     AND ((HCF1.SITCUF = 2 AND FAS1.GINCPL = GRA1.GRAINS) OR (HCF1.SITCUF <> 2 AND FAS1.GININC = GRA1.GRAINS))
     AND GRA1.INSRAI = (SELECT MAX(GRA2.INSRAI)
                          FROM R124HCF HCF2, R127FAS FAS2, R022GRA GRA2
                         WHERE HCF2.NUMEMP = HCF1.NUMEMP
                           AND HCF2.TIPCOL = HCF1.TIPCOL
                           AND HCF2.NUMCAD = HCF1.NUMCAD
                           AND HCF2.NIVCUF = FAS2.NIVCUF
                           AND HCF2.SEQNIV = FAS2.SEQNIV
                           AND HCF2.FASCUF = FAS2.FASCUF
                           AND ((HCF2.SITCUF = 2 AND FAS2.GINCPL = GRA2.GRAINS) OR (HCF2.SITCUF <> 2 AND FAS2.GININC = GRA2.GRAINS)))
     AND HCF1.NIVCUF = (SELECT MAX(HCF3.NIVCUF)
                          FROM R124HCF HCF3, R127FAS FAS3, R022GRA GRA3
                         WHERE HCF3.NUMEMP = HCF1.NUMEMP
                           AND HCF3.TIPCOL = HCF1.TIPCOL
                           AND HCF3.NUMCAD = HCF1.NUMCAD
                           AND HCF3.NIVCUF = FAS3.NIVCUF
                           AND HCF3.SEQNIV = FAS3.SEQNIV
                           AND HCF3.FASCUF = FAS3.FASCUF
                           AND ((HCF3.SITCUF = 2 AND FAS3.GINCPL = GRA3.GRAINS) OR (HCF3.SITCUF <> 2 AND FAS3.GININC = GRA3.GRAINS))
                           AND GRA3.INSRAI = GRA1.INSRAI)
     AND HCF1.SEQNIV = (SELECT MAX(HCF4.SEQNIV)
                          FROM R124HCF HCF4, R127FAS FAS4, R022GRA GRA4
                         WHERE HCF4.NUMEMP = HCF1.NUMEMP
                           AND HCF4.TIPCOL = HCF1.TIPCOL
                           AND HCF4.NUMCAD = HCF1.NUMCAD
                           AND HCF4.NIVCUF = HCF1.NIVCUF
                           AND HCF4.NIVCUF = FAS4.NIVCUF
                           AND HCF4.SEQNIV = FAS4.SEQNIV
                           AND HCF4.FASCUF = FAS4.FASCUF
                           AND ((HCF4.SITCUF = 2 AND FAS4.GINCPL = GRA4.GRAINS) OR (HCF4.SITCUF <> 2 AND FAS4.GININC = GRA4.GRAINS))
                           AND GRA4.INSRAI = GRA1.INSRAI)
     AND HCF1.FASCUF = (SELECT MAX(HCF5.FASCUF)
                          FROM R124HCF HCF5, R127FAS FAS5, R022GRA GRA5
                         WHERE HCF5.NUMEMP = HCF1.NUMEMP
                           AND HCF5.TIPCOL = HCF1.TIPCOL
                           AND HCF5.NUMCAD = HCF1.NUMCAD
                           AND HCF5.NIVCUF = HCF1.NIVCUF
                           AND HCF5.SEQNIV = HCF1.SEQNIV
                           AND HCF5.NIVCUF = FAS5.NIVCUF
                           AND HCF5.SEQNIV = FAS5.SEQNIV
                           AND HCF5.FASCUF = FAS5.FASCUF
                           AND ((HCF5.SITCUF = 2 AND FAS5.GINCPL = GRA5.GRAINS) OR (HCF5.SITCUF <> 2 AND FAS5.GININC = GRA5.GRAINS))
                           AND GRA5.INSRAI = GRA1.INSRAI);
BEGIN
  l_GinMaxCpl := 0;
  l_RaiMaxCpl := 0;
  l_GinMaxInc := 0;
  l_RaiMaxInc := 0;

  /* Procura no histórico do Colaborador o maior grau de Instrução que ele possui e retorna o respectivo Nível, Sequência, Fase e Situação */
  l_NumEmp := p_NumEmp;
  l_TipCol := p_TipCol;
  l_NumCad := p_NumCad;
  
  FOREACH C_R124HCF INTO l_SitCuf,
                         l_NivCuf,
                         l_SeqNiv,
                         l_FasCuf
  LOOP

    l_GinCpl := 0;
    l_RaiCpl := 0;
    l_GinInc := 0;
    l_RaiInc := 0;

    /* Busca o grau de instrução de acordo com a situação do curso */
    IF (l_SitCuf = 2) THEN
      BEGIN
        SELECT R127FAS.GINCPL, R022GRA.INSRAI INTO l_GinCpl, l_RaiCpl
          FROM R127FAS, R022GRA
         WHERE R127FAS.NIVCUF = l_NivCuf
           AND R127FAS.SEQNIV = l_SeqNiv
           AND R127FAS.FASCUF = l_FasCuf
           AND R127FAS.GINCPL = R022GRA.GRAINS;
      EXCEPTION
        WHEN OTHERS THEN
          NULL;
      END;
    ELSE
      BEGIN
        SELECT R127FAS.GININC, R022GRA.INSRAI INTO l_GinInc, l_RaiInc
          FROM R127FAS, R022GRA
         WHERE R127FAS.NIVCUF = l_NivCuf
           AND R127FAS.SEQNIV = l_SeqNiv
           AND R127FAS.FASCUF = l_FasCuf
           AND R127FAS.GININC = R022GRA.GRAINS;
      EXCEPTION
        WHEN OTHERS THEN
          NULL;
      END;
    END IF;

    IF (l_SitCuf = 2) THEN
      IF (l_RaiCpl > l_RaiMaxCpl) THEN
        l_GinMaxCpl := l_GinCpl;
        l_RaiMaxCpl := l_RaiCpl;
      END IF;
    ELSE
      IF (l_RaiInc > l_RaiMaxInc) THEN
        l_GinMaxInc := l_GinInc;
        l_RaiMaxInc := l_RaiInc;
      END IF;
    END IF;

  END LOOP;

  /* Seta o maior grau de instrução do Colaborador na variável que será utilizada para atualizar a R034FUN */
  IF (l_RaiMaxCpl >= l_RaiMaxInc) THEN
    l_GinMax := l_GinMaxCpl;
  ELSE
    l_GinMax := l_GinMaxInc;
  END IF;

  /* Busca o Grau do Rais do atual Grau de Instrução do Colaborador */
  BEGIN
    SELECT R034FUN.GRAINS, R022GRA.INSRAI INTO l_GinAtu, l_RaiAtu
      FROM R034FUN, R022GRA
     WHERE R034FUN.NUMEMP = p_NumEmp AND R034FUN.TIPCOL = p_TipCol
       AND R034FUN.NUMCAD = p_NumCad AND R034FUN.GRAINS = R022GRA.GRAINS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_RaiAtu := 0;
    WHEN OTHERS THEN
      NULL;
  END;

  /* No caso de exclusão ou alteração, busca o Grau de Instrução completo ou incompleto da Fase em que o Colaborador estava */
  IF (p_SitCuf = 2) THEN
    BEGIN
      SELECT GINCPL INTO l_AntGin FROM R127FAS
       WHERE NIVCUF = p_NivCuf AND SEQNIV = p_SeqNiv AND FASCUF = p_FasCuf;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_AntGin := 0;
      WHEN OTHERS THEN
        NULL;
    END;
  ELSE
    BEGIN
      SELECT GININC INTO l_AntGin FROM R127FAS
       WHERE NIVCUF = p_NivCuf AND SEQNIV = p_SeqNiv AND FASCUF = p_FasCuf;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_AntGin := 0;
      WHEN OTHERS THEN
        NULL;
    END;
  END IF;

  /* Se for uma operação de UPDATE ou DELETE e o Grau de Instrução que existia antes no histórico for igual ao do
     Colaborador, então atualiza direto. Senão compara o Rais dos Graus para ver se alguém não informou manualmente
     algum Grau de Instrução para o Colaborador */
  IF (l_AntGin = l_GinAtu) AND ((p_Origem = 'D') OR (p_Origem = 'U')) THEN
    /* Atualiza a Ficha do Colaborador com o Grau de Instrução */
    BEGIN
      UPDATE R034FUN
         SET GRAINS = l_GinMax
       WHERE R034FUN.NUMEMP = p_NumEmp AND R034FUN.TIPCOL = p_TipCol AND R034FUN.NUMCAD = p_NumCad;
    EXCEPTION
      WHEN OTHERS THEN
        l_strerr := 'Erro na Atualização da R034FUN '||
                    ' GraIns = '||CONVERT(NUMBER_TO_CHAR,l_GinMax);
        RAISERROR 103 l_strerr;
    END;
  ELSE
    /* Busca o Grau do Rais do maior Grau de Instrução cadastrados nos Históricos do Colaborador */
    BEGIN
      SELECT INSRAI INTO l_RaiNew FROM R022GRA
       WHERE GRAINS = l_GinMax;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_RaiNew := 0;
      WHEN OTHERS THEN
        NULL;
    END;

    IF (l_RaiNew = l_RaiAtu) THEN
      /* Busca o maior Nível cadastrado para o Grau de Instrução do Histórico de Colaborador */
      BEGIN
        SELECT MAX(NIVCUF) INTO l_NivNew FROM R127FAS
         WHERE GINCPL = l_GinCpl;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_NivNew := 0;
        WHEN OTHERS THEN
          NULL;
      END;

      /* Busca o maior Nível cadastrado para o atual Grau de Instrução do Colaborador */
      BEGIN
        SELECT IFNULL(MAX(NIVCUF),0) INTO l_NivAtu FROM R127FAS
         WHERE GINCPL = l_GinAtu;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_NivAtu := 0;
        WHEN OTHERS THEN
          NULL;
      END;

      /* Se não achou o maior Nível do grau do Colaborador pesquisando pelo Grau completo,
         pesquisa pelo Grau incompleto */
      IF (l_NivAtu = 0) THEN
        BEGIN
          SELECT IFNULL(MAX(NIVCUF),0) INTO l_NivAtu FROM R127FAS
           WHERE GININC = l_GinAtu;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_NivAtu := 0;
          WHEN OTHERS THEN
            NULL;
        END;
      END IF;

      /* Se o Nível do novo Grau de Instrução for maior, então atualiza a R034FUN zerando a variável l_RaiAtu
         Caso não foi encontrado o nível atual do colaborador, não atualiza pois deve ser uma informação manual */
      IF ((l_NivAtu <> 0) AND (l_NivNew > l_NivAtu)) THEN
        l_RaiAtu := 0;
      END IF;
    END IF;

    IF (l_RaiNew >= l_RaiAtu) THEN
      /* Atualiza a Ficha do Colaborador com o Grau de Instrução */
      BEGIN
        UPDATE R034FUN
           SET GRAINS = l_GinMax
         WHERE R034FUN.NUMEMP = p_NumEmp AND R034FUN.TIPCOL = p_TipCol AND R034FUN.NUMCAD = p_NumCad;
      EXCEPTION
        WHEN OTHERS THEN
          l_strerr := 'Erro na Atualização da R034FUN '||
                      ' GraIns = '||CONVERT(NUMBER_TO_CHAR,l_GinMax);
          RAISERROR 103 l_strerr;
      END;
    END IF;
  END IF;
END␀cì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
±9␀␀/* Stored Procedure que atualiza o cadastro do candidato com o maior grau de instrução encontrado nos históricos */
PROCEDURE RH_ATGRINCAN(P_NUMCAN NUMBER(9),P_SITCUF NUMBER(1),P_NIVCUF NUMBER(2),P_SEQNIV NUMBER(3),P_FASCUF VARCHAR2(255),P_ORIGEM VARCHAR2(255))
 IS

l_SitCuf         R122CCF.SITCUF%TYPE;
    l_NivCuf         R127FAS.NIVCUF%TYPE;
    l_SeqNiv         R127FAS.SEQNIV%TYPE;
    l_FasCuf         R127FAS.FASCUF%TYPE;
    l_GinCpl         R127FAS.GINCPL%TYPE;
    l_GinInc         R127FAS.GININC%TYPE;
    l_RaiAtu         R022GRA.INSRAI%TYPE;
    l_RaiNew         R022GRA.INSRAI%TYPE;
    l_GinAtu         R122CEX.GRAINS%TYPE;
    l_AntGin         R122CEX.GRAINS%TYPE;
    l_NivAtu         R127FAS.NIVCUF%TYPE;
    l_NivNew         R127FAS.NIVCUF%TYPE;
    l_comando_nulo BOOLEAN;
    l_strerr       VARCHAR2(255);
    l_GinMax         R127FAS.GINCPL%TYPE;
    l_QtdCcf       NUMBER(3);
BEGIN
    /* Procura no histórico do candidato o maior grau de instrução que ele possui e retorna o respectivo Nível, Sequência, Fase e Situação */
    l_comando_nulo := FALSE;
    BEGIN
        SELECT DISTINCT CCF1.SITCUF, CCF1.NIVCUF, CCF1.SEQNIV, CCF1.FASCUF INTO l_SitCuf, l_NivCuf, l_SeqNiv, l_FasCuf
          FROM R122CCF CCF1, R127FAS FAS1, R022GRA GRA1
         WHERE CCF1.NUMCAN = p_NumCan
           AND CCF1.NIVCUF = FAS1.NIVCUF
           AND CCF1.SEQNIV = FAS1.SEQNIV
           AND CCF1.FASCUF = FAS1.FASCUF
           AND ((CCF1.SITCUF = 2 AND FAS1.GINCPL = GRA1.GRAINS) OR (CCF1.SITCUF <> 2 AND FAS1.GININC = GRA1.GRAINS))
           AND GRA1.INSRAI = (SELECT MAX(GRA2.INSRAI)
                                FROM R122CCF CCF2, R127FAS FAS2, R022GRA GRA2
                               WHERE CCF2.NUMCAN = CCF1.NUMCAN
                                 AND CCF2.NIVCUF = FAS2.NIVCUF
                                 AND CCF2.SEQNIV = FAS2.SEQNIV
                                 AND CCF2.FASCUF = FAS2.FASCUF
                                 AND ((CCF2.SITCUF = 2 AND FAS2.GINCPL = GRA2.GRAINS) OR (CCF2.SITCUF <> 2 AND FAS2.GININC = GRA2.GRAINS)))
           AND CCF1.NIVCUF = (SELECT MAX(CCF3.NIVCUF)
                                FROM R122CCF CCF3, R127FAS FAS3, R022GRA GRA3
                               WHERE CCF3.NUMCAN = CCF1.NUMCAN
                                 AND CCF3.NIVCUF = FAS3.NIVCUF
                                 AND CCF3.SEQNIV = FAS3.SEQNIV
                                 AND CCF3.FASCUF = FAS3.FASCUF
                                 AND ((CCF3.SITCUF = 2 AND FAS3.GINCPL = GRA3.GRAINS) OR (CCF3.SITCUF <> 2 AND FAS3.GININC = GRA3.GRAINS))
                                 AND GRA3.INSRAI = GRA1.INSRAI)
           AND CCF1.SEQNIV = (SELECT MAX(CCF4.SEQNIV)
                                FROM R122CCF CCF4, R127FAS FAS4, R022GRA GRA4
                               WHERE CCF4.NUMCAN = CCF1.NUMCAN
                                 AND CCF4.NIVCUF = CCF1.NIVCUF
                                 AND CCF4.NIVCUF = FAS4.NIVCUF
                                 AND CCF4.SEQNIV = FAS4.SEQNIV
                                 AND CCF4.FASCUF = FAS4.FASCUF
                                 AND ((CCF4.SITCUF = 2 AND FAS4.GINCPL = GRA4.GRAINS) OR (CCF4.SITCUF <> 2 AND FAS4.GININC = GRA4.GRAINS))
                                 AND GRA4.INSRAI = GRA1.INSRAI)
           AND CCF1.FASCUF = (SELECT MAX(CCF5.FASCUF)
                                FROM R122CCF CCF5, R127FAS FAS5, R022GRA GRA5
                               WHERE CCF5.NUMCAN = CCF1.NUMCAN
                                 AND CCF5.NIVCUF = CCF1.NIVCUF
                                 AND CCF5.SEQNIV = CCF1.SEQNIV
                                 AND CCF5.NIVCUF = FAS5.NIVCUF
                                 AND CCF5.SEQNIV = FAS5.SEQNIV
                                 AND CCF5.FASCUF = FAS5.FASCUF
                                 AND ((CCF5.SITCUF = 2 AND FAS5.GINCPL = GRA5.GRAINS) OR (CCF5.SITCUF <> 2 AND FAS5.GININC = GRA5.GRAINS))
                                 AND GRA5.INSRAI = GRA1.INSRAI);
    EXCEPTION
        WHEN OTHERS THEN
            l_comando_nulo := TRUE;
    END;

    /* Se encontrou a Fase que possui o maior Grau de Instrução, localiza o grau de Instrução p/ Curso Completo e Incompleto */
    IF   (l_comando_nulo <> TRUE) THEN
        BEGIN
            SELECT GINCPL, GININC INTO l_GinCpl, l_GinInc FROM R127FAS
             WHERE NIVCUF = l_NivCuf AND SEQNIV = l_SeqNiv AND FASCUF = l_FasCuf;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_GinCpl := 0;
                l_GinInc := 0;
        END;

        /* Seta o maior grau de instrução do candidato na variável que será utilizada para atualizar a R122CEX */
        l_GinMax := l_GinCpl;

        /* Se o histórico do curso não estiver concluído, assume grau de instrução incompleto para atualizar o candidato */
        IF   (l_SitCuf <> 2) THEN

            /* Verifica se não existe cadastrado um histórico com o mesmo nível e com situação = 2 */
            l_comando_nulo := FALSE;
            BEGIN
                SELECT SITCUF INTO l_SitCuf FROM R122CCF
                 WHERE NUMCAN = p_NumCan AND NIVCUF = l_NivCuf
                   AND SEQNIV = l_SeqNiv AND FASCUF = l_FasCuf AND SITCUF = 2;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    l_comando_nulo := TRUE;

                WHEN OTHERS THEN
                    NULL;
            END;

            IF   (l_comando_nulo = TRUE) THEN
                l_GinMax := l_GinInc;
            END IF;
        END IF;

        /* Busca o Grau do Rais do atual grau de instrução do candidato */
        BEGIN
            SELECT R122CEX.GRAINS, R022GRA.INSRAI INTO l_GinAtu, l_RaiAtu FROM R122CEX, R022GRA
             WHERE R122CEX.NUMCAN = p_NumCan AND R122CEX.GRAINS = R022GRA.GRAINS;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_RaiAtu := 0;
            WHEN OTHERS THEN
                NULL;
        END;

        /* No caso de exclusão ou alteração, busca o grau de instrução completo ou incompleto da fase em que o candidato estava */
        IF   (p_SitCuf = 2) THEN
            BEGIN
                SELECT GINCPL INTO l_AntGin FROM R127FAS
                 WHERE NIVCUF = p_NivCuf AND SEQNIV = p_SeqNiv AND FASCUF = p_FasCuf;
            EXCEPTION
              WHEN NO_DATA_FOUND THEN
                  l_AntGin := 0;
              WHEN OTHERS THEN
                  NULL;
            END;
        ELSE
            BEGIN
                SELECT GININC INTO l_AntGin FROM R127FAS
                 WHERE NIVCUF = p_NivCuf AND SEQNIV = p_SeqNiv AND FASCUF = p_FasCuf;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    l_AntGin := 0;
                WHEN OTHERS THEN
                    NULL;
            END;
        END IF;

        /* Se for uma operação de UPDATE ou DELETE e o Grau de Instrução que existia antes no histórico for igual ao do
           candidato, então atualiza direto. Senão compara o Rais dos Graus para ver se alguém não informou manualmente
           algum Grau de Instrução para o candidato */
        IF (l_AntGin = l_GinAtu) AND ((p_Origem = 'D') OR (p_Origem = 'U')) THEN
            /* Atualiza a ficha do candidato com o Grau de Instrução */
            BEGIN
                UPDATE R122CEX
                   SET GRAINS = l_GinMax
                 WHERE R122CEX.NUMCAN = p_NumCan;
            EXCEPTION
                WHEN OTHERS THEN
                    l_strerr := 'Erro na Atualização da R122CEX '||
                                ' GraIns = '||CONVERT(NUMBER_TO_CHAR,l_GinMax);
                    RAISERROR 103 l_strerr;
            END;
         ELSE
            /* Busca o Grau do Rais do maior Grau de Instrução cadastrados nos históricos do candidato */
            BEGIN
                SELECT INSRAI INTO l_RaiNew FROM R022GRA WHERE GRAINS = l_GinMax;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    l_RaiNew := 0;
                WHEN OTHERS THEN
                    NULL;
            END;

            IF (l_RaiNew = l_RaiAtu) THEN
                /* Busca o maior Nível cadastrado para o Grau de Instrução do histórico de candidato */
                BEGIN
                    SELECT MAX(NIVCUF) INTO l_NivNew FROM R127FAS WHERE GINCPL = l_GinCpl;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        l_NivNew := 0;
                    WHEN OTHERS THEN
                        NULL;
                END;

                /* Busca o maior Nível cadastrado para o atual Grau de Instrução do candidato */
                BEGIN
                    SELECT IFNULL(MAX(NIVCUF),0) INTO l_NivAtu FROM R127FAS WHERE GINCPL = l_GinAtu;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        l_NivAtu := 0;
                    WHEN OTHERS THEN
                        NULL;
                END;

                /* Se não achou o maior Nível do grau do candidato pesquisando pelo Grau completo, pesquisa pelo Grau incompleto */
                IF (l_NivAtu = 0) THEN
                    BEGIN
                        SELECT IFNULL(MAX(NIVCUF),0) INTO l_NivAtu FROM R127FAS WHERE GININC = l_GinAtu;
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            l_NivAtu := 0;
                        WHEN OTHERS THEN
                            NULL;
                    END;
                END IF;

                /* Se o Nível do novo Grau de Instrução for maior, então atualiza a R122CEX zerando a variável l_RaiAtu
                   Caso não foi encontrado o nível atual do candidato, não atualiza pois deve ser uma informação manual */
                IF ((l_NivAtu <> 0) AND (l_NivNew > l_NivAtu)) THEN
                    l_RaiAtu := 0;
                END IF;
            END IF;

            IF (l_RaiNew >= l_RaiAtu) THEN
                /* Atualiza a ficha do candidato com o Grau de Instrução */
                BEGIN
                    UPDATE R122CEX
                       SET GRAINS = l_GinMax
                     WHERE R122CEX.NUMCAN = p_NumCan;
                EXCEPTION
                    WHEN OTHERS THEN
                        l_strerr := 'Erro na Atualização da R122CEX '||
                                    ' GraIns = '||CONVERT(NUMBER_TO_CHAR,l_GinMax);
                        RAISERROR 103 l_strerr;
                END;
            END IF;
        END IF;
    ELSE
        /* Busca o Grau do Rais do atual grau de instrução do candidato */
        BEGIN
            SELECT R122CEX.GRAINS, R022GRA.INSRAI INTO l_GinAtu, l_RaiAtu FROM R122CEX, R022GRA
             WHERE R122CEX.NUMCAN = p_NumCan AND R122CEX.GRAINS = R022GRA.GRAINS;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_RaiAtu := 0;
                l_GinAtu := 0;
        END;

        /* Verifica se tem Ensino Médio Normal ou Técnico com situação Incompleto */
        BEGIN
            SELECT IFNULL(COUNT(*),0) INTO l_QtdCcf FROM R122CCF
             WHERE NUMCAN = p_NumCan AND (NIVCUF = 3 OR NIVCUF = 5) AND SITCUF <> 2;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_QtdCcf := 0;
        END;
        IF (l_QtdCcf > 0) THEN
            l_RaiNew := 6;
        END IF;

        /* Verifica se tem Ensino Médio Normal ou Técnico com situação Completo */
        BEGIN
            SELECT IFNULL(COUNT(*),0) INTO l_QtdCcf FROM R122CCF
             WHERE NUMCAN = p_NumCan AND (NIVCUF = 3 OR NIVCUF = 5) AND SITCUF = 2;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_QtdCcf := 0;
        END;
        IF (l_QtdCcf > 0) THEN
            l_RaiNew := 7;
        END IF;

        /* Verifica se tem Graduação com situação Incompleto */
        BEGIN
            SELECT IFNULL(COUNT(*),0) INTO l_QtdCcf FROM R122CCF
             WHERE NUMCAN = p_NumCan AND NIVCUF = 6 AND SITCUF <> 2;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_QtdCcf := 0;
        END;
        IF (l_QtdCcf > 0) THEN
            l_RaiNew := 8;
        END IF;

        /* Verifica se tem Graduação com situação Completo */
        BEGIN
            SELECT IFNULL(COUNT(*),0) INTO l_QtdCcf FROM R122CCF
             WHERE NUMCAN = p_NumCan AND NIVCUF = 6 AND SITCUF = 2;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_QtdCcf := 0;
        END;
        IF (l_QtdCcf > 0) THEN
            l_RaiNew := 9;
        END IF;

        /* Verifica se tem Pós-Graduação */
        BEGIN
            SELECT IFNULL(COUNT(*),0) INTO l_QtdCcf FROM R122CCF
             WHERE NUMCAN = p_NumCan AND NIVCUF = 7;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_QtdCcf := 0;
        END;
        IF (l_QtdCcf > 0) THEN
            l_RaiNew := 10;
        END IF;

        /* Verifica se tem Mestrado */
        BEGIN
            SELECT IFNULL(COUNT(*),0) INTO l_QtdCcf FROM R122CCF
             WHERE NUMCAN = p_NumCan AND NIVCUF = 8;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_QtdCcf := 0;
        END;
        IF (l_QtdCcf > 0) THEN
            l_RaiNew := 11;
        END IF;

        /* Verifica se tem Doutorado */
        BEGIN
            SELECT IFNULL(COUNT(*),0) INTO l_QtdCcf FROM R122CCF
             WHERE NUMCAN = p_NumCan AND NIVCUF = 9;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_QtdCcf := 0;
        END;
        IF (l_QtdCcf > 0) THEN
            l_RaiNew := 12;
        END IF;

        /* Verifica se grau encontrado não é menor que o atual, pois pode ter sido alterado manualmente, e neste caso não será atualizado */
        IF (l_RaiNew >= l_RaiAtu) THEN
            BEGIN
                SELECT MIN(GRAINS) INTO l_GinMax FROM R022GRA
                 WHERE INSRAI = l_RaiNew;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    l_GinMax := 0;
            END;

            IF (l_GinMax > 0) THEN
                BEGIN
                    UPDATE R122CEX SET GRAINS = l_GinMax
                     WHERE NUMCAN = p_NumCan;
                EXCEPTION
                    WHEN OTHERS THEN
                        l_strerr := 'Erro na Atualização da R122CEX '||
                                    ' GraIns = '||CONVERT(NUMBER_TO_CHAR,l_GinMax);
                        RAISERROR 103 l_strerr;
                END;
            END IF;
        END IF;
    END IF;
END␀dì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
¢␀␀PROCEDURE RH_ATUALIZAR006HBA(P_CODESC INTEGER, P_SEQREG INTEGER, P_SEQHOP INTEGER, P_HOROPC INTEGER)
 IS

  l_codhop   R006HBA.CodHOp%TYPE;
  l_temregistro BOOLEAN;
BEGIN
	/* Preciso executar o select no outro lado para ver se está ok para não entrar em loop infinito na atualização 
	 * r006hba <-> r006hor. Assim só atualizo o outro lado se realmente precisar atualizar.*/
	l_temregistro := TRUE;
	BEGIN	
		SELECT IFNULL(CODHOP,0) INTO l_codhop FROM R006HBA WHERE CODESC = p_CODESC AND SEQREG = P_SEQREG AND SEQHOP = P_SEQHOP;
	EXCEPTION
	WHEN NO_DATA_FOUND THEN
		l_codhop := 0;
		l_temregistro := FALSE;
	END;
	
	IF  (P_HOROPC > 0) THEN
		IF (l_temregistro = TRUE) THEN
			IF  (P_HOROPC <> l_codhop) THEN
				BEGIN
					UPDATE R006HBA SET CODHOP = P_HOROPC WHERE CODESC = P_CODESC AND SEQREG =  P_SEQREG AND SEQHOP = P_SEQHOP;
				EXCEPTION WHEN OTHERS THEN
					RAISERROR 103 'Erro no update da R006HBA.';
				END;
			END IF;
		ELSE
			BEGIN
				INSERT INTO R006HBA (CODESC, SEQREG, SEQHOP, CODHOP) VALUES (P_CODESC, P_SEQREG, P_SEQHOP, P_HOROPC);  
			EXCEPTION WHEN OTHERS THEN
				RAISERROR 103 'Erro no insert da R006HBA.';
			END;
		END IF;
	ELSE
		IF (l_temregistro = TRUE) THEN
			BEGIN
				DELETE FROM R006HBA WHERE CODESC = P_CODESC AND SEQREG =  P_SEQREG AND SEQHOP = P_SEQHOP;
			EXCEPTION WHEN OTHERS THEN
				RAISERROR 103 'Erro no delete da R006HBA';
			END;
		END IF;
	END IF;
END␀eì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
D␀␀PROCEDURE RH_ATUALIZAR006HOR(P_CODESC INTEGER, P_SEQREG INTEGER, P_SEQHOP INTEGER, P_HOROPC INTEGER)
 IS

    l_horbu_atual   R006HOR.HorBu1%TYPE;
    l_temregistro BOOLEAN;
BEGIN

	/* Preciso executar o select no outro lado para ver se está ok para não entrar em loop infinito na atualização 
	 * r006hba <-> r006hor. Assim só atualizo o outro lado se realmente precisar atualizar.*/
	IF  (P_SEQHOP <= 5) THEN
	BEGIN
		l_temregistro := TRUE;
    	IF (P_SEQHOP = 1) THEN
    	BEGIN
	    	BEGIN	
		    	SELECT HORBU1 INTO l_horbu_atual FROM R006HOR WHERE CODESC = P_CODESC AND SEQREG = P_SEQREG;
	    	EXCEPTION
	    	WHEN NO_DATA_FOUND THEN
		    	l_horbu_atual := 0;
		    	l_temregistro := FALSE;
	    	END;
    
	    	/* Mantive o comportamento da trigger que só faz update. */  
			/* Nos cadastramentos primeiro grava a r006hor(porque tem o codhor obrigatório), só depois consegue gravar r006hba. */ 
   			IF ((l_temregistro = TRUE) AND (l_horbu_atual <> P_HOROPC)) THEN
   				BEGIN
    				UPDATE R006HOR SET HORBU1 = P_HOROPC WHERE CODESC = P_CODESC AND SEQREG = P_SEQREG;
				EXCEPTION WHEN OTHERS THEN
					RAISERROR 103 'Erro no update da R006HBA.';
				END;
    		END IF;
       END;
       ELSIF (P_SEQHOP = 2) THEN
       BEGIN
	    	BEGIN	
		    	SELECT HORBU2 INTO l_horbu_atual FROM R006HOR WHERE CODESC = P_CODESC AND SEQREG = P_SEQREG;
	    	EXCEPTION
	    	WHEN NO_DATA_FOUND THEN
		    	l_horbu_atual := 0;
		    	l_temregistro := FALSE;
	    	END;
    
	    	/* Mantive o comportamento da trigger que só faz update. */  
			/* Nos cadastramentos primeiro grava a r006hor(porque tem o codhor obrigatório), só depois consegue gravar r006hba. */ 
   			IF ((l_temregistro = TRUE) AND (l_horbu_atual <> P_HOROPC)) THEN
   				BEGIN
    				UPDATE R006HOR SET HORBU2 = P_HOROPC WHERE CODESC = P_CODESC AND SEQREG = P_SEQREG;
				EXCEPTION WHEN OTHERS THEN
					RAISERROR 103 'Erro no update da R006HBA.';
				END;
    		END IF;
       END;
       ELSIF (P_SEQHOP = 3) THEN
       BEGIN
	    	BEGIN	
		    	SELECT HORBU3 INTO l_horbu_atual FROM R006HOR WHERE CODESC = P_CODESC AND SEQREG = P_SEQREG;
	    	EXCEPTION
	    	WHEN NO_DATA_FOUND THEN
		    	l_horbu_atual := 0;
		    	l_temregistro := FALSE;
	    	END;
    
	    	/* Mantive o comportamento da trigger que só faz update. */  
			/* Nos cadastramentos primeiro grava a r006hor(porque tem o codhor obrigatório), só depois consegue gravar r006hba. */ 
   			IF ((l_temregistro = TRUE) AND (l_horbu_atual <> P_HOROPC)) THEN
   				BEGIN
    				UPDATE R006HOR SET HORBU3 = P_HOROPC WHERE CODESC = P_CODESC AND SEQREG = P_SEQREG;
				EXCEPTION WHEN OTHERS THEN
					RAISERROR 103 'Erro no update da R006HBA.';
				END;
    		END IF;
       END;
       ELSIF (P_SEQHOP = 4) THEN
       BEGIN
	    	BEGIN	
		    	SELECT HORBU4 INTO l_horbu_atual FROM R006HOR WHERE CODESC = P_CODESC AND SEQREG = P_SEQREG;
	    	EXCEPTION
	    	WHEN NO_DATA_FOUND THEN
		    	l_horbu_atual := 0;
		    	l_temregistro := FALSE;
	    	END;
    
	    	/* Mantive o comportamento da trigger que só faz update. */  
			/* Nos cadastramentos primeiro grava a r006hor(porque tem o codhor obrigatório), só depois consegue gravar r006hba. */ 
   			IF ((l_temregistro = TRUE) AND (l_horbu_atual <> P_HOROPC)) THEN
   				BEGIN
    				UPDATE R006HOR SET HORBU4 = P_HOROPC WHERE CODESC = P_CODESC AND SEQREG = P_SEQREG;
				EXCEPTION WHEN OTHERS THEN
					RAISERROR 103 'Erro no update da R006HBA.';
				END;
    		END IF;
       END;	
       ELSIF (P_SEQHOP = 5) THEN
       BEGIN
	    	BEGIN	
		    	SELECT HORBU5 INTO l_horbu_atual FROM R006HOR WHERE CODESC = P_CODESC AND SEQREG = P_SEQREG;
	    	EXCEPTION
	    	WHEN NO_DATA_FOUND THEN
		    	l_horbu_atual := 0;
		    	l_temregistro := FALSE;
	    	END;
    
	    	/* Mantive o comportamento da trigger que só faz update. */  
			/* Nos cadastramentos primeiro grava a r006hor(porque tem o codhor obrigatório), só depois consegue gravar r006hba. */ 
   			IF ((l_temregistro = TRUE) AND (l_horbu_atual <> P_HOROPC)) THEN
   				BEGIN
    				UPDATE R006HOR SET HORBU5 = P_HOROPC WHERE CODESC = P_CODESC AND SEQREG = P_SEQREG;
				EXCEPTION WHEN OTHERS THEN
					RAISERROR 103 'Erro no update da R006HBA.';
				END;
    		END IF;
    	END;/*fim ELSIF (P_SEQHOP = 5) THEN*/
	    END IF;
	END;
	END IF; 
END␀fì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Ø-␀␀PROCEDURE RH_CHECKVALCOP(P_SITAFA1 NUMBER,P_SITAFA2 NUMBER,P_SITAFA3 NUMBER,P_SITAFA4 NUMBER,P_SITAFA5 NUMBER,P_MAISSITDEM NUMBER,P_DATAZERO DATE,P_DATAREF DATE,P_NUMEMP NUMBER,P_PAGUSU NUMBER,P_QTDTERCAD OUT NUMBER,P_QTDTERPON OUT NUMBER,P_QTDTERREF OUT NUMBER,P_QTDTERTCO OUT NUMBER,P_QTDTERGES OUT NUMBER,P_QTDPARCAD OUT NUMBER,P_QTDPARPON OUT NUMBER,P_QTDPARREF OUT NUMBER,P_QTDPARTCO OUT NUMBER,P_QTDPARGES OUT NUMBER)
 IS

/* CURSOR que contempla contagem de colaboradores (Terceiros e Parceiros) nos
     módulos Ronda, Ronda Refeitório e Ronda Transporte Coletivo. */
  CURSOR C_R034FUN_ATU IS
     SELECT 'R034FUN' TIPTAB, R034FUN.NUMEMP NUMEMP, R034FUN.TIPCOL TIPCOL, R034FUN.NUMCAD NUMCAD,
            R034FUN.SITAFA SITAFA, R034FUN.CONRHO CONRHO, R034FUN.BUSHOR BUSHOR, p_DataZero DATALT, p_DataZero DATFIM
       FROM R034FUN WHERE ((TIPCOL=2) OR (TIPCOL=3)) AND (CONRHO<>4) AND ((P_PAGUSU=0) OR (NUMEMP=P_NUMEMP))
  UNION ALL (SELECT 'R038HCT' TIPTAB, R038HCT.NUMEMP NUMEMP, R038HCT.TIPCOL TIPCOL, R038HCT.NUMCAD NUMCAD,
                    0 SITAFA, R034FUN.CONRHO CONRHO, 0 BUSHOR, R038HCT.DATALT DATALT, R038HCT.DATFIM DATFIM
       FROM R038HCT, R034FUN WHERE ((R038HCT.TIPCOL=2) OR (R038HCT.TIPCOL=3)) AND ((P_PAGUSU=0) OR (R038HCT.NUMEMP=P_NUMEMP)) AND 
	                               ((R034FUN.NUMEMP=R038HCT.NUMEMP) AND (R034FUN.TIPCOL=R038HCT.TIPCOL) AND (R034FUN.NUMCAD=R038HCT.NUMCAD)) AND (R034FUN.CONRHO<>4))
   ORDER BY NUMEMP,TIPCOL,NUMCAD,TIPTAB DESC;


  /* CURSOR que contempla contagem de colaboradores (Terceiros e Parceiros) no
     módulo Ronda Geração de Escalas. */
  CURSOR C_R034FUN_GES IS
     SELECT ' GERESC ' TIPTAB, R034FUN.NUMEMP NUMEMP, R034FUN.TIPCOL TIPCOL, R034FUN.NUMCAD NUMCAD,
            R034FUN.SITAFA SITAFA, R034FUN.CONRHO CONRHO
       FROM R034FUN, R006ESC, R038HES
      WHERE ((((R034FUN.TIPCOL=2) OR (R034FUN.TIPCOL=3)) AND (p_PagUsu = 0)) OR
            (((R034FUN.TIPCOL=2) OR (R034FUN.TIPCOL=3)) AND (R034FUN.NUMEMP = (p_NumEmp)) AND (p_PagUsu = 1))) AND
            R006ESC.CODESC = R038HES.CODESC AND R006ESC.TIPESC = 'G' AND
            R034FUN.NUMEMP = R038HES.NUMEMP AND R034FUN.TIPCOL = R038HES.TIPCOL AND
            R034FUN.NUMCAD = R038HES.NUMCAD AND (R038HES.DATALT = (SELECT MAX (DATALT)
            FROM R038HES HES
            WHERE (HES.NUMEMP = R038HES.NUMEMP) AND (HES.TIPCOL = R038HES.TIPCOL) AND
(HES.NUMCAD = R038HES.NUMCAD) AND (HES.DATALT <= p_DataRef)))
   ORDER BY NUMEMP,TIPCOL,NUMCAD;


  TYPE T_R034FUN_AUX IS RECORD (
    TIPTAB VARCHAR2(10),
    NUMEMP   R034FUN.NUMEMP%TYPE,
    TIPCOL   R034FUN.TIPCOL%TYPE,
    NUMCAD   R034FUN.NUMCAD%TYPE,
    SITAFA   R034FUN.SITAFA%TYPE,
    CONRHO   R034FUN.CONRHO%TYPE,
    BUSHOR   R034FUN.BUSHOR%TYPE,
    DATALT   R038HCT.DATALT%TYPE,
    DATFIM   R038HCT.DATFIM%TYPE);

  TYPE T_R034FUN_GES_AUX IS RECORD (
    TIPTAB VARCHAR2(10),
    NUMEMP   R034FUN.NUMEMP%TYPE,
    TIPCOL   R034FUN.TIPCOL%TYPE,
    NUMCAD   R034FUN.NUMCAD%TYPE,
    SITAFA   R034FUN.SITAFA%TYPE,
    CONRHO   R034FUN.CONRHO%TYPE);

  l_TemHist INTEGER;
  l_TemNoPer INTEGER;
  l_DataZero DATE;
  l_DataAtual DATE;
  l_QtdTerCad INTEGER;
  l_QtdTerPon INTEGER;
  l_QtdTerRef INTEGER;
  l_QtdTerTCo INTEGER;
  l_QtdTerGEs INTEGER;
  l_QtdParCad INTEGER;
  l_QtdParPon INTEGER;
  l_QtdParRef INTEGER;
  l_QtdParTCo INTEGER;
  l_QtdParGEs INTEGER;
  l_estademitido BOOLEAN;
  l_empant   R034FUN.NUMEMP%TYPE;
  l_sitdem   R034FUN.SITAFA%TYPE;
  l_codsit   R010SIT.CODSIT%TYPE;
  l_R034FUN_AUX T_R034FUN_AUX;
  l_R034FUN_GES_AUX T_R034FUN_GES_AUX;
  l_vetrtc   CHAR;
  l_vetrge   CHAR;

BEGIN
  p_QtdTerCad := 0;
  p_QtdTerPon := 0;
  p_QtdTerRef := 0;
  p_QtdTerTCo := 0;
  p_QtdTerGEs := 0;
  p_QtdParCad := 0;
  p_QtdParPon := 0;
  p_QtdParRef := 0;
  p_QtdParTCo := 0;
  p_QtdParGEs := 0;
  l_QtdTerCad := 0;
  l_QtdTerPon := 0;
  l_QtdTerRef := 0;
  l_QtdTerTCo := 0;
  l_QtdTerGEs := 0;
  l_QtdParCad := 0;
  l_QtdParPon := 0;
  l_QtdParRef := 0;
  l_QtdParTCo := 0;
  l_QtdParGEs := 0;
  l_empant    := 0;
  l_sitdem    := 0;
  l_TemHist   := 0;
  l_TemNoPer  := 0;
  l_DataAtual := CURDATE();
  l_DataZero  := '31/12/1900,00:00:00';

  /* Verifica se é integrado com o Ronda Transporte Coletivo e Ronda Geração de Escalas. */
  BEGIN
     SELECT VETRTC, VETRGE INTO l_vetrtc, l_vetrge FROM R000PRP;
  EXCEPTION
    WHEN TOO_MANY_ROWS THEN
      RAISERROR 103 'Erro em R000PRP - TOO MANY ROWS';
    WHEN OTHERS THEN
     l_vetrtc := 'N';
     l_vetrge := 'N';
  END;

  /* Rotina referente a contagem de colaboradores (Terceiros e Parceiros) nos
     módulos Ronda, Ronda Refeitório e Ronda Transporte Coletivo. */
  FOREACH C_R034FUN_ATU INTO l_R034FUN_AUX.TIPTAB,
                             l_R034FUN_AUX.NUMEMP,
                             l_R034FUN_AUX.TIPCOL,
                             l_R034FUN_AUX.NUMCAD,
                             l_R034FUN_AUX.SITAFA,
                             l_R034FUN_AUX.CONRHO,
                             l_R034FUN_AUX.BUSHOR,
                             l_R034FUN_AUX.DATALT,
                             l_R034FUN_AUX.DATFIM
  LOOP
    IF (l_R034FUN_AUX.TIPTAB='R038HCT') THEN
      l_TemHist := 1;
      IF (l_DataAtual >= l_R034FUN_AUX.DATALT) AND ((l_R034FUN_AUX.DATFIM >= l_DataAtual) OR (l_R034FUN_AUX.DATFIM = l_DataZero)) THEN
        l_TemNoPer := 1;
      END IF;
    ELSE
      /* Incrementa a Quantidade Cadastrada */
      IF (l_R034FUN_AUX.TIPCOL=2) THEN
        l_QtdTerCad := l_QtdTerCad+1;
      ELSE
        l_QtdParCad := l_QtdParCad+1;
      END IF;
      
      IF (l_R034FUN_AUX.CONRHO<>4) THEN
        IF (l_R034FUN_AUX.NUMEMP<>l_empant) THEN
          BEGIN
            SELECT r060dap.sitdem SITDEM INTO l_sitdem FROM r030emp r030emp,r060dap r060dap WHERE r030emp.coddap=r060dap.coddap AND r030emp.numemp=l_R034FUN_AUX.NUMEMP;
          EXCEPTION
            WHEN OTHERS THEN
              l_sitdem := 0;
          END;
          l_empant := l_R034FUN_AUX.NUMEMP;
        END IF;
        
        /***************************************************************************************/
        /* Foi realizado o tratamento para verificar se o terceiro/parceiro esta demito desta forma para não precisar */
        /* executar um SELECT na R010SIT para verificar a situação de afastamento a cada troca de terceiro/parceiro. */
        /***************************************************************************************/
        l_estademitido := FALSE;

        IF ((p_sitafa1 = l_R034FUN_AUX.SITAFA) OR (p_sitafa2 = l_R034FUN_AUX.SITAFA) OR (p_sitafa3 = l_R034FUN_AUX.SITAFA) OR (p_sitafa4 = l_R034FUN_AUX.SITAFA) OR (p_sitafa5 = l_R034FUN_AUX.SITAFA)) THEN
          l_estademitido := TRUE;   
        ELSIF (p_maissitdem = 1) THEN
          BEGIN
            SELECT CODSIT CODSIT INTO l_codsit FROM R010SIT WHERE (TIPSIT=7) AND (CODSIT = l_R034FUN_AUX.SITAFA);
          EXCEPTION
            WHEN OTHERS THEN
              l_codsit := 0;
          END;
          IF (l_codsit <> 0) THEN
            l_estademitido := TRUE;
          END IF;
        ELSE
          IF (l_sitdem <> 0) AND (l_sitdem = l_R034FUN_AUX.SITAFA) THEN
            l_estademitido := TRUE;
          END IF;
        END IF;
        /***************************************************************************************/
        IF (l_estademitido = FALSE) THEN
          IF (l_R034FUN_AUX.TIPCOL=2) THEN
            IF ((l_TemHist=0) OR (l_TemNoPer=1)) THEN
              IF ((l_R034FUN_AUX.ConRho=1) OR (l_R034FUN_AUX.ConRho=2)) THEN
                l_QtdTerPon := l_QtdTerPon+1;
              END IF;
              IF ((l_R034FUN_AUX.ConRho=1) OR (l_R034FUN_AUX.ConRho=3)) THEN
                l_QtdTerRef := l_QtdTerRef+1;
              END IF;
              IF (l_R034FUN_AUX.BusHor=2) THEN
                l_QtdTerTCo := l_QtdTerTCo+1;
              END IF;
            END IF;
          ELSE
            IF ((l_TemHist=0) OR (l_TemNoPer=1)) THEN
              IF ((l_R034FUN_AUX.ConRho=1) OR (l_R034FUN_AUX.ConRho=2)) THEN
                l_QtdParPon := l_QtdParPon+1;
              END IF;
              IF ((l_R034FUN_AUX.ConRho=1) OR (l_R034FUN_AUX.ConRho=3)) THEN
                l_QtdParRef := l_QtdParRef+1;
              END IF;
              IF (l_R034FUN_AUX.BusHor=2) THEN
                l_QtdParTCo := l_QtdParTCo+1;
              END IF;
            END IF;
          END IF;
        END IF;
      END IF;
      l_TemHist := 0;
      l_TemNoPer := 0;
    END IF;
  END LOOP;

  /* Se tem Ronda Geração de Escalas, totaliza colaboradores. */
  IF (l_vetrge = 'S') THEN

    /* Rotina referente a contagem de colaboradores (Terceiros e Parceiros) no
       módulo Ronda Geração de Escalas. */
    FOREACH C_R034FUN_GES INTO l_R034FUN_GES_AUX.TIPTAB,
                               l_R034FUN_GES_AUX.NUMEMP,
                               l_R034FUN_GES_AUX.TIPCOL,
                               l_R034FUN_GES_AUX.NUMCAD,
                               l_R034FUN_GES_AUX.SITAFA,
                               l_R034FUN_GES_AUX.CONRHO
    LOOP
        IF (l_R034FUN_GES_AUX.CONRHO<>4) THEN
          IF (l_R034FUN_GES_AUX.NUMEMP<>l_empant) THEN
            BEGIN
              SELECT r060dap.sitdem SITDEM INTO l_sitdem FROM r030emp r030emp,r060dap r060dap WHERE r030emp.coddap=r060dap.coddap AND r030emp.numemp=l_R034FUN_GES_AUX.NUMEMP;
            EXCEPTION
              WHEN OTHERS THEN
                l_sitdem := 0;
            END;
            l_empant := l_R034FUN_GES_AUX.NUMEMP;
          END IF;

          /***************************************************************************************/
          /* Foi realizado o tratamento para verificar se o terceiro/parceiro esta demito desta forma para não precisar */
          /* executar um SELECT na R010SIT para verificar a situação de afastamento a cada troca de terceiro/parceiro. */
          /***************************************************************************************/
          l_estademitido := FALSE;

          IF ((p_sitafa1 = l_R034FUN_GES_AUX.SITAFA) OR (p_sitafa2 = l_R034FUN_GES_AUX.SITAFA) OR (p_sitafa3 = l_R034FUN_GES_AUX.SITAFA) OR (p_sitafa4 = l_R034FUN_GES_AUX.SITAFA) OR (p_sitafa5 = l_R034FUN_GES_AUX.SITAFA)) THEN
            l_estademitido := TRUE;
          ELSIF (p_maissitdem = 1) THEN
            BEGIN
              SELECT CODSIT CODSIT INTO l_codsit FROM R010SIT WHERE (TIPSIT=7) AND (CODSIT = l_R034FUN_GES_AUX.SITAFA);
            EXCEPTION
              WHEN OTHERS THEN
                l_codsit := 0;
            END;
            IF (l_codsit <> 0) THEN
              l_estademitido := TRUE;
            END IF;
          ELSE
            IF (l_sitdem <> 0) AND (l_sitdem = l_R034FUN_GES_AUX.SITAFA) THEN
              l_estademitido := TRUE;
            END IF;
          END IF;
          /***************************************************************************************/
          IF (l_estademitido = FALSE) THEN
            IF (l_R034FUN_GES_AUX.TIPCOL=2) THEN
                l_QtdTerGEs := l_QtdTerGEs+1;
            ELSE
                l_QtdParGEs := l_QtdParGEs+1;
            END IF;
          END IF;
        END IF;
    END LOOP;
  END IF;

  p_QtdTerCad := l_QtdTerCad;
  p_QtdTerPon := l_QtdTerPon;
  p_QtdTerRef := l_QtdTerRef;
  p_QtdTerTCo := l_QtdTerTCo;
  p_QtdTerGEs := l_QtdTerGEs;
  p_QtdParCad := l_QtdParCad;
  p_QtdParPon := l_QtdParPon;
  p_QtdParRef := l_QtdParRef;
  p_QtdParTCo := l_QtdParTCo;
  p_QtdParGEs := l_QtdParGEs;
END␀gì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE RH_COLABORADOR_GPO(P_NUMEMP NUMBER(4), P_TIPCOL NUMBER(1), P_NUMCAD NUMBER(9), P_RETURN OUT BOOLEAN)
 IS

  l_GesPon   R034FUN.GesPon%TYPE;
BEGIN
    p_return := FALSE;
    
    
	BEGIN
    	SELECT IFNULL(UPPER(GESPON),'N') INTO l_GesPon
        FROM R034FUN
        WHERE NUMEMP=p_numemp AND
        	  TIPCOL=p_tipcol AND
              NUMCAD=p_numcad;
    EXCEPTION
    WHEN OTHERS THEN
    	l_GesPon := 'N';
    END;
    
    
	IF l_GesPon = 'S' THEN
	    p_return := TRUE;
	END IF;
END␀hì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
±␀␀PROCEDURE RH_CURSOESOCIAL(P_CODIGOCURSO NUMBER(9),P_CURSOESOCIAL OUT BOOLEAN)
 IS

  l_CursoEsocial BOOLEAN; 
  l_CodigoTreinamentoEsocial   R128CUA.CodTce%TYPE;
BEGIN
  l_CursoEsocial := FALSE;
  BEGIN
  	SELECT CodTce INTO l_CodigoTreinamentoEsocial
	  FROM R128CUA_AUX
	 WHERE CodCua = P_CODIGOCURSO;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      BEGIN
	    SELECT CodTce INTO l_CodigoTreinamentoEsocial
	    FROM R128CUA, R128ASS
	    WHERE R128CUA.CODASS = R128ASS.CODASS
	    AND R128ASS.ENVESO = 'S'
	    AND (R128CUA.CODTCE = 1006 OR R128CUA.CODTCE = 1207)
	    AND CodCua = P_CODIGOCURSO;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
	      l_CodigoTreinamentoEsocial := 0;
      END;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao buscar código do treinamento eSocial';
  END;
  IF (l_CodigoTreinamentoEsocial > 0) THEN
	l_CursoEsocial := TRUE;
  END IF;
  
  P_CURSOESOCIAL := l_CursoEsocial;
END␀iì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
µ␀␀PROCEDURE RH_DATFER(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_CODFIL NUMBER,P_TIPFER CHAR,P_TABFER NUMBER,P_TURHOR NUMBER,P_DATA DATE,P_TIPESC CHAR,P_FERIADO OUT BOOLEAN)
 IS

/* Auxiliares */
  l_codfer  NUMBER;
  l_retorno BOOLEAN;
/* R002FEC */
  l_datfer  DATE;
/* R030FIL */
  l_tabfen  NUMBER;
  l_tabfed  NUMBER;
  l_comando_nulo BOOLEAN;
/* R038HLO */
  l_taborg  NUMBER;
  l_numloc  NUMBER(9);
BEGIN
  l_retorno := FALSE;
  l_comando_nulo := FALSE;
  l_codfer := 0;

  IF (p_tipesc = 'G') THEN
     l_codfer := p_tabfer;
     BEGIN
       SELECT TABFER INTO l_codfer FROM R031DEF;
       EXCEPTION
       WHEN OTHERS THEN
         l_codfer := p_tabfer;
     END;
  ELSE
    /* Verifica Qual Tabela Feriado Deve Usar */
    IF  (p_tipfer = 'F') THEN
        /* Tabelas Feriados da Filial */
        BEGIN
           SELECT TABFEN,TABFED INTO l_tabfen,l_tabfed FROM R030FIL WHERE NUMEMP=p_numemp AND CODFIL=p_codfil;
        EXCEPTION
           WHEN NO_DATA_FOUND THEN
                l_codfer := p_tabfer;
                l_comando_nulo := TRUE;
           WHEN OTHERS THEN
                l_comando_nulo := TRUE;
        END;
        IF  (l_comando_nulo = FALSE) THEN
            IF   (p_turhor = 3) THEN
                 l_codfer := l_tabfen;
            ELSE l_codfer := l_tabfed;
            END IF;
        END IF;
    END IF;

    IF  (p_tipfer = 'P') THEN
        /* Propria */
        l_codfer := p_tabfer;
    END IF;


    IF  (p_tipfer = 'L') THEN
        /* Tabelas Feriados do Local */

        BEGIN
          SELECT HLO.TABORG, HLO.NUMLOC INTO l_TabOrg, l_NumLoc FROM R038HLO HLO
           WHERE HLO.NUMEMP = p_NumEmp AND HLO.TIPCOL = p_TipCol AND HLO.NUMCAD = p_NumCad
             AND HLO.DATALT = (SELECT MAX(HLO2.DATALT) FROM R038HLO HLO2
                                WHERE HLO2.NUMEMP = p_NumEmp AND HLO2.TIPCOL = p_TipCol AND
                                      HLO2.NUMCAD = p_NumCad AND HLO2.DATALT <= p_Data);
          SELECT TABFEN,TABFED INTO l_tabfen,l_tabfed FROM R016ORN WHERE TABORG=l_TabOrg AND NUMLOC=l_numloc;
        EXCEPTION
           WHEN NO_DATA_FOUND THEN
                l_codfer := p_tabfer;
                l_comando_nulo := TRUE;
           WHEN OTHERS THEN
                l_comando_nulo := TRUE;
        END;

        IF  (l_comando_nulo = FALSE) THEN
            IF   (p_turhor = 3) THEN
                 l_codfer := l_tabfen;
            ELSE l_codfer := l_tabfed;
            END IF;
        END IF;
    END IF;
  END IF;

  /* Verifica se "datatu" e' Feriado */
  IF  (l_codfer > 0) THEN
      l_comando_nulo:=FALSE;
      BEGIN
         SELECT DATFER INTO l_datfer FROM R002FEC WHERE CODFER=l_codfer AND DATFER=p_data;
      EXCEPTION WHEN OTHERS THEN
         l_comando_nulo:=TRUE;
      END;
      IF  (l_comando_nulo = FALSE) THEN
          l_retorno := TRUE;
      END IF;
  END IF;

  p_feriado := l_retorno;
END␀jì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
®PROCEDURE RH_DATFIM(P_DATFIM OUT DATE)
 IS

l_data_atual   DATE;
BEGIN
  /* Inicializa */
  l_data_atual:=CURDATE();
  p_datfim := DATETimeAdd(DD,6,l_data_atual);
END␀kì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_INITEMPTY_DAT
Å␀␀PROCEDURE RH_DEF_ESOCIAL(P_NUMEMP NUMBER(4), p_DataInicioTabelas OUT DATE, p_DataInicioESocial OUT DATE, p_DataInicioNaoPeriodicos OUT DATE, p_DataInicioPeriodicos OUT DATE, p_DataInicioSST OUT DATE, p_DataInicioMigracao OUT DATE)
IS

	l_DataInicioTabelas DATE;
	l_DataInicioESocial DATE;
	l_DataInicioNaoPeriodicos DATE;
	l_DataInicioPeriodicos DATE;
	l_DataInicioSST DATE;
	l_DataInicioMigracao DATE;
BEGIN
  BEGIN
    SELECT DATTAB, DATUES, ININPE, INIPER, INISST, DATMIG
      INTO l_DataInicioTabelas, l_DataInicioESocial, l_DataInicioNaoPeriodicos, l_DataInicioPeriodicos, l_DataInicioSST, l_DataInicioMigracao
      FROM R030DES
     WHERE NUMEMP = P_NUMEMP;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_DataInicioTabelas := DATETIME(31, 12, 1900, 0, 0, 0);
      l_DataInicioESocial := DATETIME(31, 12, 1900, 0, 0, 0);
      l_DataInicioNaoPeriodicos := DATETIME(31, 12, 1900, 0, 0, 0);
      l_DataInicioPeriodicos := DATETIME(31, 12, 1900, 0, 0, 0);
      l_DataInicioSST := DATETIME(31, 12, 1900, 0, 0, 0);
      l_DataInicioMigracao := DATETIME(31, 12, 1900, 0, 0, 0);
  END;
     
  SP_INITEMPTY_DAT(l_DataInicioTabelas IN OUT);
  SP_INITEMPTY_DAT(l_DataInicioESocial IN OUT);
  SP_INITEMPTY_DAT(l_DataInicioNaoPeriodicos IN OUT);
  SP_INITEMPTY_DAT(l_DataInicioPeriodicos IN OUT);
  SP_INITEMPTY_DAT(l_DataInicioSST IN OUT);
  SP_INITEMPTY_DAT(l_DataInicioMigracao IN OUT);
          
  p_DataInicioTabelas := l_DataInicioTabelas;
  p_DataInicioESocial := l_DataInicioESocial;
  p_DataInicioNaoPeriodicos := l_DataInicioNaoPeriodicos;
  p_DataInicioPeriodicos := l_DataInicioPeriodicos;
  p_DataInicioSST := l_DataInicioSST;
  p_DataInicioMigracao := l_DataInicioMigracao;  
END␀lì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
9␀␀PROCEDURE RH_DEF_ESOC_CONHSA(P_NUMEMP NUMBER(4), P_CONHSA OUT CHAR(1))
IS

	L_CONHSA CHAR(1);
BEGIN
  BEGIN
    SELECT CONHSA INTO L_CONHSA
      FROM R030DES
     WHERE NUMEMP = P_NUMEMP;
    EXCEPTION
    WHEN NO_DATA_FOUND THEN
      P_CONHSA := NULL; 
  END;
     
  P_CONHSA := L_CONHSA;  
END␀mì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Y␀␀PROCEDURE RH_DEF_ESOC_SIMFOL(P_NUMEMP NUMBER(4), P_SIMFOL OUT DATE)
IS

	l_SimFol DATE;
	alfmen   VARCHAR2(255); 
	l_DataAtual DATE;
	l_FimSim DATE;
BEGIN
  l_DataAtual := CURDATE();
  SP_INITEMPTY_DAT(l_SIMFOL IN OUT);
  
  BEGIN
    SELECT SIMFOL INTO l_SimFol
      FROM R030DES
     WHERE NUMEMP = P_NUMEMP;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
	  SP_INITEMPTY_DAT(l_SIMFOL IN OUT);
    WHEN OTHERS THEN
      alfmen := 'Erro no SELECT em R030DES na RH_DEF_ESOC_SIMFOL';
	  RAISERROR 103 alfmen;
  END;
  
  BEGIN
  	SELECT FIMSIM INTO l_FimSim
      FROM R030DAT
     WHERE GRUESO = 0;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      ALFMEN := 'Erro no SELECT em R030DAT.';
      RAISERROR 103 alfmen;
  END;
  
  IF (l_DataAtual >= l_FimSim) THEN
	l_SimFol := l_FimSim;
  END IF;
  
  P_SIMFOL := l_SimFol;  
END␀nì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀/* 
 * Exclui histórico de anotação do colaborador, comunicando início ou fim das atividades em regime de teletrabalho, quando:
 * - O vínculo do novo histórico esteja definido com Teletrabalho = Sim;
 * - Exista um tipo de anotação cadastrado com tipo de Regime de Jornada correspondente.
 */
PROCEDURE RH_DELNOTTELTRA(p_NumEmp NUMBER(4), p_TipCol NUMBER(1), p_NumCad NUMBER(9), p_DatAlt DATE, p_BasLeg NUMBER(1))
IS

	l_TipNot NUMBER(3);
BEGIN	
	/* Busca tipo de anotação que esteja definido com a opção 5 ou 6 no campo Regime Jornada */
	BEGIN		
		SELECT CodNot INTO l_TipNot
		  FROM R022NOT
		 WHERE R022NOT.BasLeg = p_BasLeg;
	EXCEPTION
		WHEN OTHERS THEN
			l_TipNot := 0;
	END;
	
	/* Se encontrou tipo de anotação para o regime de jornada */
	IF (l_TipNot > 0) THEN
		
		BEGIN
			DELETE FROM R038NOT WHERE NumEmp = p_NumEmp AND TipCol = p_TipCol AND NumCad = p_NumCad AND DatNot = p_DatAlt AND TipNot = l_TipNot;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao excluir registro da tabela R038NOT.';
		END;
			
	END IF;
END␀oì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
=␀␀PROCEDURE RH_DELORIOPE(P_ORIOPE VARCHAR2(1))
 IS
BEGIN
  /* Deleta na tabela R110FIC, no campo ORIOPE, o valor passado por parâmetro */
  BEGIN
    DELETE FROM R110TRI
          WHERE ORIOPE = p_oriope;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao deletar operação na Tabela R110TRI.';
  END;
END␀pì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0RH_MODINT
.␀␀PROCEDURE RH_DIASEM(P_DATSRV DATE,P_DIASEM OUT NUMBER)
 IS

/* Auxiliares */
   l_data_zero DATE;
   l_difdat INTEGER;
BEGIN
l_data_zero := '31/12/1900,00:00:00';
l_difdat := DATETIMEDIF(DD, p_datsrv, l_data_zero);
/* Recebe o resto da divisão por 7. */
RH_MODINT(l_difdat, 7, p_diasem);
END␀qì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
2␀␀PROCEDURE RH_ESOCIAL_NT06(P_NUMEMP NUMBER(4), P_NT06 OUT BOOLEAN)
IS

  l_AlfMen VARCHAR2(255);
  l_DataAtual DATE;
  l_DataZero DATE;
  l_DataIniNT06 DATE;
  l_TipAmb   R030DES.TIPAMB%TYPE;
BEGIN
  P_NT06 := FALSE;
  l_DataAtual := CURDATE();
  l_TipAmb := 0;
  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  l_DataIniNT06 := l_DataZero;

  BEGIN
    SELECT R030DES.TIPAMB INTO l_TipAmb
      FROM R030DES
     WHERE R030DES.NUMEMP = P_NUMEMP;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_AlfMen := 'Erro no SELECT da R030DES na RH_ESOCIAL_NT06.';
      RAISERROR 103 l_AlfMen;
  END;

  IF (l_TipAmb = 2) THEN
    BEGIN
      SELECT R000ESO.DATESO INTO l_DataIniNT06
        FROM R000ESO
       WHERE TIPAMB = 2 AND GRUESO = 0 AND TIPDAT = 8;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_AlfMen := 'Erro no SELECT da R000ESO na RH_ESOCIAL_NT06.';
        RAISERROR 103 l_AlfMen;
    END;
  ELSE
    BEGIN
      SELECT INIS11 INTO l_DataIniNT06
        FROM R030DAT
       WHERE GRUESO = 0;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_AlfMen := 'Erro no SELECT da R030DAT na RH_ESOCIAL_NT06.';
        RAISERROR 103 l_AlfMen;
    END;
  END IF;

  IF ((l_DataAtual >= l_DataIniNT06) AND (l_DataIniNT06 > l_DataZero)) THEN
    P_NT06 := TRUE;
  END IF;
END␀rì␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0XRH_RETORIEXA
