TRIGGER R064TPE_EU AFTER UPDATE ON R064TPE FOR EACH ROW
DECLARE
  l_codprm      NUMBER(5);
  l_prmsab      NUMBER(5);
  l_prmdom      NUMBER(5);
  l_prmfer      NUMBER(5);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_online      BOOLEAN;
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_ade_gerpen       BOOLEAN;
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R064TPE_AUX;
  

BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN

       l_codprm := 0;
       l_prmsab := 0;
       l_prmdom := 0;
       l_prmfer := 0;
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       IF   (:NEW.DATINI < l_data_atual OR
            (:NEW.DATINI = l_data_atual AND :NEW.HORINI <= l_hora_atual)) AND
            (:NEW.DATFIM = l_data_zero OR :NEW.DATFIM > l_data_atual OR
            (:NEW.DATFIM = l_data_atual AND :NEW.HORFIM > l_hora_atual)) THEN
            l_codprm:=:NEW.CODPRM;
            l_prmsab:=:NEW.PRMSAB;
            l_prmdom:=:NEW.PRMDOM;
            l_prmfer:=:NEW.PRMFER;
       ELSE
            IF  (:OLD.STAACC <> :NEW.STAACC) THEN
                 BEGIN
                   SELECT CODPRM,PRMSAB,PRMDOM,PRMFER
                     INTO l_codprm,l_prmsab,l_prmdom,l_prmfer
                     FROM R034DAC WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD;
                 EXCEPTION WHEN OTHERS THEN
                   RAISERROR 103 'ON-Line: Erro no SELECT do R034DAC.';
                 END;
            END IF;
       END IF;
       IF  (l_codprm <> 0) OR (l_prmsab <> 0) OR (l_prmdom <> 0) OR (l_prmfer <> 0) THEN
           R064TPE_ATUCON(:NEW.TIPCOL,:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATINI,:NEW.DATFIM,l_codprm,l_prmsab,l_prmdom,l_prmfer);
       END IF;
  END IF;
  BEGIN
  /* Insere Registro NEW */
    INSERT INTO R064TPE_AUX (NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,DATFIM,HORFIM,CODPRM,STAACC)
    VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI,:NEW.DATFIM,:NEW.HORFIM,:NEW.CODPRM,:NEW.STAACC);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R064TPE_AUX.';
  END;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R064TPE');

  IF (l_auditoria = 'S') THEN

       l_camposAlterados := 'Campo(s) alterado(s): ';
       l_alterou := FALSE;

      IF (:NEW.NUMEMP <> :OLD.NUMEMP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMEMP ';
      END IF;

      IF (:NEW.TIPCOL <> :OLD.TIPCOL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPCOL ';
      END IF;

      IF (:NEW.NUMCAD <> :OLD.NUMCAD) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCAD ';
      END IF;

      IF (:NEW.DATINI <> :OLD.DATINI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATINI ';
      END IF;

      IF (:NEW.HORINI <> :OLD.HORINI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORINI ';
      END IF;

      IF (:NEW.DATFIM <> :OLD.DATFIM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATFIM ';
      END IF;

      IF (:NEW.HORFIM <> :OLD.HORFIM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORFIM ';
      END IF;

      IF (:NEW.CODPRM <> :OLD.CODPRM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPRM ';
      END IF;

      IF (:NEW.PRMFER <> :OLD.PRMFER) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PRMFER ';
      END IF;

      IF (:NEW.PRMSAB <> :OLD.PRMSAB) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PRMSAB ';
      END IF;

      IF (:NEW.PRMDOM <> :OLD.PRMDOM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'PRMDOM ';
      END IF;

      IF (:NEW.EMPAUT <> :OLD.EMPAUT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'EMPAUT ';
      END IF;

      IF (:NEW.TCLAUT <> :OLD.TCLAUT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TCLAUT ';
      END IF;

      IF (:NEW.CADAUT <> :OLD.CADAUT) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CADAUT ';
      END IF;

      IF (:NEW.CODUSU <> :OLD.CODUSU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODUSU ';
      END IF;

      IF (:NEW.STAACC <> :OLD.STAACC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'STAACC ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R064TPE_AUD
                   WHERE NUMEMP = :OLD.NUMEMP AND
                         TIPCOL = :OLD.TIPCOL AND
                         NUMCAD = :OLD.NUMCAD AND
                         DATINI = :OLD.DATINI AND
                         HORINI = :OLD.HORINI;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R064TPE_AUD(SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,DATFIM,HORFIM,
                                      CODPRM,PRMFER,PRMSAB,PRMDOM,EMPAUT,TCLAUT,CADAUT,CODUSU,STAACC)
                              VALUES (l_seqreg,l_verseq,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI,
                                     :NEW.DATFIM,:NEW.HORFIM,:NEW.CODPRM,:NEW.PRMFER,:NEW.PRMSAB,:NEW.PRMDOM,
                                     :NEW.EMPAUT,:NEW.TCLAUT,:NEW.CADAUT,:NEW.CODUSU,:NEW.STAACC);


              SP_AUDGENREG(l_seqreg,l_verseq,'R064TPE',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
  
  IF (:OLD.STAACC = 1 OR :NEW.STAACC = 1) THEN
      /* Caso o histórico foi finalizado (STAACC = 2), verifica se tem que remover o credenciamento da pessoa da ADE02. */
      /* Caso contrário, verifica se tem que incluir o credenciamento da pessoa na ADE02. */
      SP_RECALF_GERPEN_1(:NEW.TIPCOL, l_ade_gerpen OUT);
      IF (l_ade_gerpen = TRUE) THEN
          IF (:NEW.STAACC = 2) THEN
              l_codprm := 0;
              l_prmsab := 0;
              l_prmdom := 0;
              l_prmfer := 0;

              BEGIN
                  SELECT CODPRM, PRMSAB, PRMDOM, PRMFER 
                  INTO l_codprm, l_prmsab, l_prmdom, l_prmfer 
                  FROM R034DAC
                  WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
              EXCEPTION
                  WHEN OTHERS THEN RAISERROR 103 'R064TPE: Erro no SELECT da tabela R034DAC.';
              END;

              SP_RECALF_PRMCOL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_codprm, l_prmsab, l_prmdom, l_prmfer, NULL, NULL, NULL, NULL, NULL, NULL);
          ELSE
              SP_RECALF_PRMCOL(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODPRM, :NEW.PRMSAB, :NEW.PRMDOM, :NEW.PRMFER, NULL, NULL, NULL, NULL, NULL, NULL);
          END IF;
      END IF;
  END IF;
END␀ÔØ␀␀		SENIOR;0t␀␀

TRIGGER R064TPE_ED AFTER DELETE ON R064TPE FOR EACH ROW
DECLARE
  l_codprm      NUMBER(5);
  l_prmsab      NUMBER(5);
  l_prmdom      NUMBER(5);
  l_prmfer      NUMBER(5);
  l_data_zero   DATE;
  l_data_atual  DATE;
  l_hora_atual  NUMBER(4);
  l_online      BOOLEAN;
  l_verseq      NUMBER(10);
  l_seqreg      NUMBER(15);
  l_auditoria   CHAR(1);
  l_ade_gerpen  BOOLEAN;
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN

       l_codprm := 0;
       l_prmsab := 0;
       l_prmdom := 0;
       l_prmfer := 0;
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       IF   (:OLD.DATINI < l_data_atual OR
            (:OLD.DATINI = l_data_atual AND :OLD.HORINI <= l_hora_atual)) AND
            (:OLD.DATFIM = l_data_zero OR :OLD.DATFIM > l_data_atual OR
            (:OLD.DATFIM = l_data_atual AND :OLD.HORFIM > l_hora_atual)) THEN
            BEGIN
              SELECT CODPRM,PRMSAB,PRMDOM,PRMFER
                INTO l_codprm,l_prmsab,l_prmdom,l_prmfer
                FROM R034DAC WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'ON-Line: Erro no SELECT do R034DAC.';
            END;
       END IF;
       IF  (l_codprm <> 0) OR (l_prmsab <> 0) OR (l_prmdom <> 0) OR (l_prmfer <> 0) THEN
            R064TPE_ATUCON(:OLD.TIPCOL,:OLD.NUMEMP,:OLD.NUMCAD,:OLD.DATINI,:OLD.DATFIM,l_codprm,l_prmsab,l_prmdom,l_prmfer);
       END IF;
  END IF;

   /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R064TPE');

  IF (l_auditoria = 'S') THEN
      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg
                FROM R064TPE_AUD
               WHERE NUMEMP = :OLD.NUMEMP AND
                     TIPCOL = :OLD.TIPCOL AND
                     NUMCAD = :OLD.NUMCAD AND
                     DATINI = :OLD.DATINI AND
                     HORINI = :OLD.HORINI;
           EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
          INSERT INTO R064TPE_AUD(SEQREG,VERSEQ,NUMEMP,TIPCOL,NUMCAD,DATINI,HORINI,DATFIM,HORFIM,
                                  CODPRM,PRMFER,PRMSAB,PRMDOM,EMPAUT,TCLAUT,CADAUT,CODUSU,STAACC)
                          VALUES (l_seqreg,l_verseq,:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.DATINI,:OLD.HORINI,
                                 :OLD.DATFIM,:OLD.HORFIM,:OLD.CODPRM,:OLD.PRMFER,:OLD.PRMSAB,:OLD.PRMDOM,
                                 :OLD.EMPAUT,:OLD.TCLAUT,:OLD.CADAUT,:OLD.CODUSU,:OLD.STAACC);

          SP_AUDGENREG(l_seqreg,l_verseq,'R064TPE','DELETE');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/

  IF (:OLD.STAACC = 1) THEN
      SP_RECALF_GERPEN_1(:OLD.TIPCOL, l_ade_gerpen OUT);
      IF (l_ade_gerpen = TRUE) THEN
          l_codprm := 0;
          l_prmsab := 0;
          l_prmdom := 0;
          l_prmfer := 0;

          BEGIN
              SELECT CODPRM, PRMSAB, PRMDOM, PRMFER
              INTO l_codprm, l_prmsab, l_prmdom, l_prmfer
              FROM R034DAC
              WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD;
          EXCEPTION
              WHEN OTHERS THEN RAISERROR 103 'R064TPE: Erro no SELECT da tabela R034DAC.';
          END;

          SP_RECALF_PRMCOL(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_codprm, l_prmsab, l_prmdom, l_prmfer, NULL, NULL, NULL, NULL, NULL, NULL);
       END IF;
   END IF;
END␀␀␀¢␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÒØ␀␀ş␀␀¢␀	„␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀­%␀‹␀	„␀␀␀␀␀␀(&␀|%␀&␀a␀Æÿ␀␀ÿ␀…¬␀␀´␀	„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t	„␀␀␀␀␀␀Ü␀t␀Ü␀n5‰␀Æÿ␀␀ÿ␀c¬␀␀Ì␀	„␀␀␀␀␀␀$0.0.w1‰␀Æÿ␀␀ÿ␀EÑ␀	„␀␀␀␀␀␀G]G]GqC3‰␀êÿ␀␀ÿ␀¤w·␀	„␀␀␀␀␀␀wxdxdxì*␀␀Æÿ␀␀ÿ␀åDÑ␀„␀␀␀␀␀␀GÔFÔFqC2‰␀êÿ␀␀ÿ␀w·␀„␀␀␀␀␀␀Nx<x<xì*␀␀Æÿ␀␀ÿ␀C-·␀„␀␀␀␀␀␀À¿␀␀£¿␀␀£¿␀␀t4‰␀Æÿ␀␀ÿ␀Æ␀␀·␀„␀␀␀␀␀␀Â¿␀␀¨¿␀␀©¿␀␀t␀Æÿ␀␀ÿ␀Æ␀␀·␀„␀␀␀␀␀␀Ã¿␀␀±¿␀␀²¿␀␀t␀Æÿ␀␀ÿ␀Æ␀␀·␀„␀␀␀␀␀␀Á¿␀␀¥¿␀␀¦¿␀␀t␀Æÿ␀␀ÿ␀Ìa´␀„␀␀␀␀␀␀¯<•awbr␀Æÿ␀␀ÿ␀=␀t„␀␀␀␀␀␀m␀§␀§␀n␀Æÿ␀␀ÿ␀:$Ì␀„␀␀␀␀␀␀ %$†$w␀Æÿ␀␀ÿ␀␀Ã„␀␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀×-‹␀„␀␀␀␀␀␀¦Am␀m␀—)␀␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3;4;5;6␀␀M␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÓØ␀␀…¬␀␀´␀„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t„␀␀␀␀␀␀Ü␀t␀Ü␀n5‰␀Æÿ␀␀ÿ␀c¬␀␀Ì␀„␀␀␀␀␀␀$0.0.w1‰␀Æÿ␀␀ÿ␀EÑ␀„␀␀␀␀␀␀dG]G]GqC3‰␀êÿ␀␀ÿ␀¤w·␀„␀␀␀␀␀␀wxdxdxì*␀␀Æÿ␀␀ÿ␀åDÑ␀„␀␀␀␀␀␀êFÔFÔFqC2‰␀êÿ␀␀ÿ␀w·␀„␀␀␀␀␀␀Nx<x<xì*␀␀Æÿ␀␀ÿ␀C-·␀„␀␀␀␀␀␀À¿␀␀£¿␀␀£¿␀␀t4‰␀Æÿ␀␀ÿ␀Æ␀␀·␀„␀␀␀␀␀␀Â¿␀␀¨¿␀␀©¿␀␀t␀Æÿ␀␀ÿ␀Æ␀␀·␀„␀␀␀␀␀␀Ã¿␀␀±¿␀␀²¿␀␀t␀Æÿ␀␀ÿ␀Æ␀␀·␀„␀␀␀␀␀␀Á¿␀␀¥¿␀␀¦¿␀␀t␀Æÿ␀␀ÿ␀Ìa´␀„␀␀␀␀␀␀¯<•awbr␀Æÿ␀␀ÿ␀=␀t„␀␀␀␀␀␀m␀§␀§␀n␀Æÿ␀␀ÿ␀:$Ì␀„␀␀␀␀␀␀ %$†$w␀Æÿ␀␀ÿ␀␀Ã„␀␀␀␀␀␀•␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀␀␀	␀£␀␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÙØ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀$0.0.w␀Æÿ␀␀…Ó␀␀␀EÑ␀	