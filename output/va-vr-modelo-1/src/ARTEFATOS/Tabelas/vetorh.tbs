    INSERT R115CNO (CodNot, NomCam, ValStr) VALUES (l_codnot, 'nomeEmpresaVisitado', p_NomEmp);
    
  /* Aviso ao autorizador ref.aprovações pendentes por SMS */
  ELSIF (p_TipPNo = 8) AND (p_TelConVisitado IS NOT NULL AND LENGTH(LTRIM(RTRIM(p_TelConVisitado))) > 0) THEN
