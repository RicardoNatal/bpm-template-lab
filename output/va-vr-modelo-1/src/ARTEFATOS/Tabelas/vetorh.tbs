l_idregister      VARCHAR2(26);

/* CURSOR c/ os Crachás principais na R070CON */
  CURSOR c_r070con IS SELECT NUMCRA,NUMFIS,TECCRA,VERPRM,CODPRM,PRMSAB,PRMDOM,PRMFER,
                             PRMRT1,PRMRT2,PRMRT3,DATVAL,NOMFUN,NUMPIS,TIPCRA,TIPDOC,NUMDOC,USABIO
                            FROM R070CON
                            WHERE IDTPES = l_idtpes AND CHCPRI = 0;
  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NUMCRA%TYPE,
    NUMFIS   R070CON.NUMFIS%TYPE,
    TECCRA   R070CON.TECCRA%TYPE,
    VERPRM   R070CON.VERPRM%TYPE,
    CODPRM   R070CON.CODPRM%TYPE,
    PRMSAB   R070CON.PRMSAB%TYPE,
    PRMDOM   R070CON.PRMDOM%TYPE,
    PRMFER   R070CON.PRMFER%TYPE,
    PRMRT1   R070CON.PRMRT1%TYPE,
    PRMRT2   R070CON.PRMRT2%TYPE,
    PRMRT3   R070CON.PRMRT3%TYPE,
    DATVAL   R070CON.DATVAL%TYPE,
    NOMFUN   R070CON.NOMFUN%TYPE,
    NUMPIS   R070CON.NUMPIS%TYPE,
    TIPCRA   R070CON.TIPCRA%TYPE,
    TIPDOC   R070CON.TIPDOC%TYPE,
    NUMDOC   R070CON.NUMDOC%TYPE,
    USABIO   R070CON.USABIO%TYPE);
  l_r070con t_r070con;
BEGIN
  l_idtpes := :OLD.IDTPES;
  
  SP_ATUBIOTELEMAT('D', :OLD.idtpes, :OLD.codtbi, :OLD.tiptem, :OLD.tembio);
  
  /* Busca todos os registros de crachá principal na R070CON para gerar na R070ACR */
  FOREACH c_r070con INTO l_r070con.NUMCRA,
                         l_r070con.NUMFIS,
                         l_r070con.TECCRA,
                         l_r070con.VERPRM,
                         l_r070con.CODPRM,
                         l_r070con.PRMSAB,
                         l_r070con.PRMDOM,
                         l_r070con.PRMFER,
                         l_r070con.PRMRT1,
                         l_r070con.PRMRT2,
                         l_r070con.PRMRT3,
                         l_r070con.DATVAL,
                         l_r070con.NOMFUN,
                         l_r070con.NUMPIS,
                         l_r070con.TIPCRA,
                         l_r070con.TIPDOC,
                         l_r070con.NUMDOC,
                         l_r070con.USABIO
  LOOP
      IF (l_r070con.TIPDOC = 2) THEN
          l_numcpf := l_r070con.NUMDOC;
      ELSE
          l_numcpf := 0;
      END IF;
      /*Insere registro na R070ACR com parametro AltBio=2 (excluir).*/
      /* Somente se a pessoa utilizar biometria */
      IF ((l_r070con.TIPCRA = 1) OR (l_r070con.TIPCRA = 2) OR (l_r070con.TIPCRA = 6)) AND 
         ((l_r070con.NUMPIS > 0) OR (l_numcpf > 0)) AND
         (l_r070con.USABIO > 1) AND
         (:OLD.TIPTEM = 1) THEN
          SP_R070ACR('A', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                          0, l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                          l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3,
                          0, 0, 0, 0, 0, 0, 0,
                          l_r070con.DATVAL, l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,2,0,0, l_numcpf);
                          
          SP_R070ACR('Y', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                          0, l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                          l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3,
                          0, 0, 0, 0, 0, 0, 0,
                          l_r070con.DATVAL, l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,0,0,27, l_numcpf);
                          
         /* desatualiza todas as pendencias para dispositivos Telemática na exclusão da biometria*/
         /* o registro não existe mais na CONTIDIG_xxx e com isso não pode permanecer na lista */
         BEGIN
             UPDATE R070ACR SET STAATU = 2 WHERE 
                 NUMCRA = l_r070con.NumCra AND 
                 NUMFIS = l_r070con.NumFis AND 
                 STAATU IN (0,3,4) AND 
                 TIPLIS = 27 AND
                 NUMEIP IN (SELECT NUMEIP FROM R058RLG WHERE CODCEN IN (SELECT CODCEN FROM R058CEN WHERE GERSEN = 'N'));
         EXCEPTION
             WHEN OTHERS THEN NULL;
         END;            
      END IF;

      SP_PEND62('I', l_r070con.NumCra, l_r070con.NumFis, l_r070con.TecCra, l_r070con.VERPRM,
                     l_r070con.CODPrm, l_r070con.PrmSab, l_r070con.PrmDom, l_r070con.PrmFer,
                     l_r070con.PrmRt1, l_r070con.PrmRt2, l_r070con.PrmRt3, l_r070con.DATVAL,
                     l_Idtpes, l_r070con.NomFun, l_r070con.NumPis,2,l_numcpf);
  END LOOP;

  /* Geração de pendência de biometria p/ o Ronda senior X */
  IF (:OLD.INTEGR IS NULL) OR (:OLD.INTEGR ='N') THEN
      SP_INTSTR(:OLD.CODTBI, '99', l_codtbi_str OUT);
      SP_INTSTR(:OLD.TIPTEM, '9', l_tiptem_str OUT);
      l_idregister := l_idtpes || l_codtbi_str || l_tiptem_str;
      SP_SAM_PENDENCIES(47, 3, l_idregister);
  END IF;
END		SENIOR;23½␀␀TRIGGER R070BIO_ED AFTER DELETE ON R070BIO FOR EACH ROW
