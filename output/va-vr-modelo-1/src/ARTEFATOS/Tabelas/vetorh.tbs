  ELSE
      l_fxcre6 := :OLD.CREFX6;
  END IF;

  IF ((:NEW.NOMFUN <> :OLD.NOMFUN) OR (:NEW.NOMFUN IS NOT NULL AND :OLD.NOMFUN IS NULL) OR (:NEW.NOMFUN IS NULL AND :OLD.NOMFUN IS NOT NULL)) THEN
      l_nomfun := :NEW.NOMFUN;
  ELSE
      l_nomfun := :OLD.NOMFUN;
  END IF;

  IF (l_nomfun IS NULL) OR (l_nomfun = '') THEN
      l_nomfun := '';
      l_numpis := 0;
      IF (LENGTH(LTRIM(RTRIM(:OLD.NomFun))) > 0) THEN
        l_TipOpeRep := 'E';
      END IF;
  END IF;

  IF (:NEW.NUMPIS <> :OLD.NUMPIS) THEN
      l_numpis := :NEW.NUMPIS;
  ELSE
      l_numpis := :OLD.NUMPIS;
  END IF;

  IF (l_numpis IS NULL) OR (l_numpis = 0) THEN
      l_numpis := 0;
      IF (:OLD.NUMPIS > 0) THEN
        l_TipOpeRep := 'E';
      END IF;
  END IF;

  IF (l_creac1 IS NULL) THEN
      l_creac1 := '00';
      l_qtdcr1 := '00';
      l_fxcre1 := '00000000';
  END IF;

  IF (l_creac2 IS NULL) THEN
      l_creac2 := '00';
      l_qtdcr2 := '00';
      l_fxcre2 := '00000000';
  END IF;

  IF (l_creac3 IS NULL) THEN
      l_creac3 := '00';
      l_qtdcr3 := '00';
      l_fxcre3 := '00000000';
  END IF;

  IF (l_creac4 IS NULL) THEN
      l_creac4 := '00';
      l_qtdcr4 := '00';
      l_fxcre4 := '00000000';
  END IF;

  IF (l_creac5 IS NULL) THEN
      l_creac5 := '00';
      l_qtdcr5 := '00';
      l_fxcre5 := '00000000';
  END IF;

  IF (l_creac6 IS NULL) THEN
      l_creac6 := '00';
      l_qtdcr6 := '00';
      l_fxcre6 := '00000000';
  END IF;

  IF  (l_msgacc IS NULL) THEN
      l_msgacc := '                                ';
  END IF;

  IF (l_gracon IS NULL) THEN
      /*Se for nulo, define o valor padrão de biometria.*/
      l_gracon := '050';
  END IF;

  IF (l_ValAut IS NULL) THEN
      /*Se for nulo, define o valor padrão de validação por autorizador.*/
      l_ValAut := '1';
  END IF;

  IF (:NEW.QTDPRV <> :OLD.QTDPRV) THEN
      SP_INTSTR(:NEW.QTDPRV,'99',l_qtdprv OUT);
  ELSE
      SP_INTSTR(:OLD.QTDPRV,'99',l_qtdprv OUT);
  END IF;

  IF (l_qtdprv IS NULL) THEN
      l_qtdprv := '00';
  END IF;

  IF (l_conrea IS NULL) THEN
    l_conrea := '1';
  END IF;

  IF (l_conree IS NULL) THEN
    l_conree := '0';
  END IF;

  IF (l_usarfa IS NULL) THEN
    l_usarfa := '0';
  END IF;

  /* verifica se existe alguma centralizadora gerenciada pela Senior */
  SP_GERSEN(l_gersen OUT);

  IF  (l_gersen = TRUE) THEN

      IF ((:NEW.CHCPRI = 0) AND (:NEW.TIPCRA <> 12)) THEN

          /* Sem processamento prévio (PEND93) */
          IF (l_propre = 0) THEN

            /* Verifica se há alguma central gerenciada pela Telemática (não-Senior). */
            l_gertel := 0;
            BEGIN
                SELECT COUNT(*) INTO l_gertel FROM R058CEN WHERE GERSEN = 'N';
            EXCEPTION
                WHEN OTHERS THEN  l_gertel := 0;
            END;

            /*Monta as Strings para Enviar o Comando (Pendência)*/
            /*Comando para as Pessoas (IdtPes) somente para os crachas principais (chcpri = 0)*/
            /*Nao pode enviar comandos de pessoa para crachas de autorizacao de entrada(tipcra=12)*/

            IF (((l_uLevel = TRUE) AND ((l_mulcon = 'S') OR (l_gertel > 0))) OR (l_uLevelVis = TRUE)) THEN
                l_StrAux := '26'||l_datenv||l_idtpes||l_nivatu||l_datniv||l_horniv||l_seqniv;
                SP_PorCom(l_StrAux, l_CenPen);
            END IF;

            IF ((l_uPersonInfo = TRUE) OR (l_uPerson60 = TRUE)) THEN
                IF  (:NEW.NOMPES = '') OR (:NEW.NOMPES IS NULL) THEN
                    l_nome := :NEW.NOMFUN;
                ELSE
                    l_nome := :NEW.NOMPES;
                END IF;
                SP_PEND60(:NEW.IDTPES, l_nome, :NEW.NUMPIS, :NEW.DDIFON, :NEW.DDDFON, :NEW.NUMFON, :NEW.PESBLO, :NEW.DESBLO);
            END IF;

            /* monta update de autorizadores */
            IF (l_uAuthorization = TRUE) OR (l_uLevelVis = TRUE) THEN
                l_StrAux := '27'||l_datenv||l_idtpes||l_ValAut;
                SP_PorCom(l_StrAux, l_CenPen);
            END IF;

            IF  (l_uDefAcc = TRUE) OR (l_uLevelVis = TRUE) THEN
                l_Straux := '22'||l_datenv||l_idtPes||'1'||
                                  l_blofal||l_conadp||l_verprm||l_sencol||l_temalm||l_concre||
                                  l_confai||l_verafa||l_conial||l_blosai||l_usabio||l_gracon||
                                  l_conint||l_tolint||l_conpac||l_conrea||l_recvis||l_conree||
                                  l_andvis||l_usarfa;

                SP_PorCom(l_straux, l_CenPen);
            END IF;

            IF  ((l_uPerm = TRUE) OR (l_uLevelVis = TRUE)) THEN
                l_Straux := '03'||l_datenv||l_idtPes||l_codprm||l_prmsab||l_prmdom||l_prmfer;
                SP_PorCom(l_straux, l_CenPen);
            END IF;

            IF  (l_uMessage = TRUE) OR (l_uLevelVis = TRUE) THEN
                l_Straux := '04'||l_datenv||l_idtPes||l_datmsg||l_qtdmsg||l_msgacc;
                SP_PorCom(l_straux, l_CenPen);
            END IF;

            IF  (l_uCredit = TRUE) OR (l_uLevelVis = TRUE) THEN
                /*Busca versao do plano ativa*/
                l_codplf := 0;
                BEGIN
                    SELECT VERPLF INTO l_verplf
                      FROM R058VPL
                     WHERE DATCRI <= l_data_atual
                       AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
                EXCEPTION
                    WHEN OTHERS THEN
                        l_verplf := 1;
                END;
                /*Gera pendencia para a CSM Center, informando os creditos de acesso para local fisico 0*/
                SP_PEND06(1, l_idtPes, l_verplf, l_codplf);
            END IF;
          END IF; /* (l_propre = 0) - Sem processamento prévio (PEND93) */

          /* so gera pendencia de afastamento quando for alteracao no cracha principal.  */
          IF  (l_uRemoval  = TRUE) AND (:NEW.CHCPRI = 0) THEN
              l_Straux := '08'||l_datenv||l_idtPes||l_iniafa||l_datafa;
              SP_PorCom(l_straux, l_CenPen);
          END IF;

          /* Sem processamento prévio (PEND93) */
          IF (l_propre = 0) THEN

            IF (l_Biometry = TRUE) THEN
                FOREACH c_r070bio INTO l_r070bio.CodTbi
                LOOP
                    l_Straux := '24'||l_datenv||l_idtPes||CONVERT(NUMBER_TO_CHAR,l_r070bio.CodTbi);
                    SP_PorCom(l_straux, l_CenPen);
                END LOOP;
            END IF;

            IF  (l_uRange = TRUE) THEN
                /* acesso */
                l_Straux := '12'||l_datenv||'1'||l_idtPes||'007'||
                            '1'||l_faiac1||'2'||l_faiac2||'3'||l_faiac3||
                            '4'||l_faiac4||'5'||l_faiac5||'6'||l_faiac6||'7'||l_faiac7;
                SP_PorCom(l_straux, l_CenPen);
                /* ponto */
                l_Straux := '12'||l_datenv||'2'||l_idtPes||'007'||
                            '1'||l_faipt1||'2'||l_faipt2||'3'||l_faipt3||
                            '4'||l_faipt4||'5'||l_faipt5||'6'||l_faipt6||'7'||l_faipt7;
                SP_PorCom(l_straux, l_CenPen);

              /* refeitório */
                l_Straux := '12'||l_datenv||'3'||l_idtPes||'001'||'1'||l_fairef;
                SP_PorCom(l_straux, l_CenPen);
            END IF;

            IF (l_Pend23 = TRUE) THEN
                SP_PEND23(l_idtpes);
            END IF;

          END IF; /* (l_propre = 0) - Sem processamento prévio (PEND93) */
      END IF;

      /* Sem processamento prévio (PEND93) */
      IF (l_propre = 0) THEN

        /*Se foi alterado o tipo ou o documento gera o comando 77(UPDATEPersonDocument)*/
        IF (:OLD.TIPDOC <> :NEW.TIPDOC) OR (:OLD.NUMDOC <> :NEW.NUMDOC) THEN
          /*Converte o tipo do documento para string de 1 posição*/
            SP_INTSTR(:NEW.TIPDOC,'9',l_tipdoc_str OUT);
          /*Pega o tamanho do número do documento*/
            l_tamnumdoc := Length(:NEW.NUMDOC);
          /*Converte o tamanho do documento para string de 2 posições*/
            SP_INTSTR(l_tamnumdoc,'99',l_tamnumdoc_str OUT);

            /*Monta o ValStr do comando*/
            l_Straux := '77'||l_datenv||:NEW.IDTPES||l_tipdoc_str||l_tamnumdoc_str||:NEW.NUMDOC;
            /*Envia o comando 77*/
            SP_PorCom(l_straux, l_CenPen);
        END IF;

      /*Comando para todos os Crachás, Independente da Pessoa.*/
        IF (l_removeCard = TRUE) THEN
          /*Conforme Tarefa: 161512, não será mais enviado o comando removeCard, e sim o lockCard*/
          /*l_StrAux := '02'||l_datenv||l_numfis_old;*/
            l_StrAux := '05'||l_datenv||l_numfis_old||'1'||'00';
            SP_PorCom(l_StrAux, l_CenPen);
        END IF;

        IF (l_uCard = TRUE) THEN

            l_StrAux := '21'||l_datenv||l_numfis||l_tipcra||l_inival||l_datval||l_sitcra||
                              l_teccra||l_numcra||l_prmaut||l_idtpes;
            SP_PorCom(l_straux, l_CenPen);

        END IF;

        IF (l_lockCard = TRUE) THEN
            IF  (l_sitcra = '01') THEN
                IF  (l_blofal = '1') THEN
                  l_blocra := '3';     /* bloqueado por situação e por falta */
                ELSE
                  l_blocra := '1';     /* bloqueado somente por situação */
                END IF;
            ELSE
                IF  (l_blofal = '1') THEN
                    l_blocra := '2';     /* bloqueado somente por falta */
                ELSE
                    l_blocra := '0';     /* liberado */
                END IF;
            END IF;

            l_Straux := '05'||l_datenv||l_numfis||l_blocra||l_qtdprv;
            SP_PorCom(l_straux, l_CenPen);
        END IF;

        IF  (l_uValidity = TRUE) THEN
            l_Straux := '09'||l_datenv||l_numfis||l_inival||l_datval;
            SP_PorCom(l_straux, l_CenPen);
        END IF;

      END IF; /* (l_propre = 0) - Sem processamento prévio (PEND93) */
  END IF;

  /*INICIO*/
  /*Chama a SP_AtuCpfTsi para atualizar o CPF na tabela CONTCPF da Telemática*/
  /*Pega data e hora atual*/
  l_data_atual_cpf := CURDATE();
  l_hora_atual_cpf := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_seqenv_cpf := SECOND(CURTIME());

  SP_DATSTR(l_data_atual_cpf, 'DDMMYY', l_datstr_cpf OUT);
  SP_INTSTR(l_hora_atual_cpf, 'HHMM', l_horstr_cpf OUT);
  SP_INTSTR(l_seqenv_cpf, '99', l_seqstr_cpf OUT);

  /*Monta a string de data e hora atual*/
  l_datatustr_cpf := l_datstr_cpf||l_horstr_cpf||l_seqstr_cpf||'0000';

  /*Só atualiza a contcpf se o crachá estiver em aberto*/
  IF (l_datval_new >= l_data_atual_cpf) OR (:NEW.DATVAL = '3112502359000000') OR (:NEW.DATVAL = '0000000000000000') THEN
      /*Pega o icard usando o número físico*/
      SP_INTSTR(:NEW.NUMFIS, '999999999999', l_icard OUT);

      /*Caso for SmartCard, pega o icard usando o crachá principal se tiver. Se não tiver crachá principal, usa o número do crachá*/
      IF (:NEW.TECCRA = 3) THEN
          IF (:NEW.CHCPRI <> 0) THEN
              SP_INTSTR(:NEW.CHCPRI, '999999999999', l_icard OUT);
          ELSE
              SP_INTSTR(:NEW.NUMCRA, '999999999999', l_icard OUT);
          END IF;
      END IF;

      /*Chama a procedure que atualiza a CONTCPF*/
      SP_ATUCPFTSI(l_icard, :NEW.TIPDOC, :NEW.NUMDOC);
  END IF;
  /*FIM*/

  /* VERIFICA SE O NOME EXISTE */
  IF (LENGTH(LTRIM(RTRIM(l_nomfun))) > 0) THEN
      /* SE O NOME ESTIVER PREENCHIDO */
      /* Forca a atualizacao da REPEMPR002 se a pessoa esta com o cracha ativo e tem PIS ou CPF */
      IF ((l_numpis > 0) OR (l_newnumcpf > 0)) AND (l_datval_new >= l_datatu_date OR :NEW.DATVAL = '3112502359000000') THEN
          /* retira os acentos e caracteres especiais do nome e atualiza RepEmpr002*/
          l_NomFunOriginal := UPPER(:NEW.NOMFUN);
          SP_STRTOSTR(l_NomFunOriginal, l_NomFunConvertido OUT);
          IF (l_numpis > 0) THEN
            SP_REPEMPR002_CPF(:NEW.NUMCRA, l_newnumcpf, :NEW.NUMPIS, l_NomFunConvertido);
            SP_REPEMPR002_CPF(:NEW.NUMFIS, l_newnumcpf, :NEW.NUMPIS, l_NomFunConvertido);
          ELSE
            SP_GETPISFROMCPF(l_newnumcpf, l_fakepis OUT);
            SP_REPEMPR002_CPF(:NEW.NUMCRA, l_newnumcpf, l_fakepis, l_NomFunConvertido);
            SP_REPEMPR002_CPF(:NEW.NUMFIS, l_newnumcpf, l_fakepis, l_NomFunConvertido);
          END IF;
      END IF;
  END IF;


  /* atualiza tabela REP Telematica*/
  IF (l_TipOpeRep <> 'N') AND
     ((:NEW.NOMFUN IS NOT NULL AND :OLD.NOMFUN IS NULL) OR  /*se mudou algo (para o caso de já esta com valor nulo nos campos)*/
      (:NEW.NOMFUN IS NULL AND :OLD.NOMFUN IS NOT NULL) OR  /*compara nulos, pois se comparado valor nulo <> nao nulo em oracle resulta em nulo (false) */
      (:NEW.NOMFUN <> :OLD.NOMFUN) OR (:NEW.NUMPIS <> :OLD.NUMPIS) OR
      (l_newnumcpf <> l_oldnumcpf) OR (:NEW.NUMFIS <> :OLD.NUMFIS) OR
      (l_uValidity = TRUE) OR (l_lockCard = TRUE))  THEN

      IF (:NEW.USABIO > 1) THEN
        l_altbio := 1;
      ELSE
        IF (:NEW.USABIO = 1) THEN
          l_altbio := 2;
        END IF;
      END IF;

      /* Se mudou numero fisico, delete o antigo */
      IF ((l_enviar = TRUE) AND (:NEW.NUMFIS <> :OLD.NUMFIS)) OR (l_TipOpeRep = 'E') AND (l_PodeIgnorar = FALSE) THEN
          /*Ao alterar um numero fisico, chama SP_R070ACR passando F para exclusao normal*/
          IF (:OLD.UsaBio > 1) THEN
            SP_R070ACR('J',
                     :OLD.NumCra, :OLD.NumFis, :OLD.TecCra, :OLD.VERPRM,
                     0, :OLD.CODPrm, :OLD.PrmSab, :OLD.PrmDom, :OLD.PrmFer,
                     :OLD.PrmRt1, :OLD.PrmRt2, :OLD.PrmRt3,
                     0, 0, 0, 0, 0, 0, 0,
                     l_datenv, :OLD.Idtpes, :OLD.NomFun, :OLD.NumPis,2,2,0, l_oldnumcpf);

            SP_R070ACR('Y',
                     :OLD.NumCra, :OLD.NumFis, :OLD.TecCra, :OLD.VERPRM,
                     0, :OLD.CODPrm, :OLD.PrmSab, :OLD.PrmDom, :OLD.PrmFer,
                     :OLD.PrmRt1, :OLD.PrmRt2, :OLD.PrmRt3,
                     0, 0, 0, 0, 0, 0, 0,
                     l_datenv, :OLD.Idtpes, :OLD.NomFun, :OLD.NumPis,0,2,0, l_oldnumcpf);
          ELSE
            SP_R070ACR('F',
                     :OLD.NumCra, :OLD.NumFis, :OLD.TecCra, :OLD.VERPRM,
                     0, :OLD.CODPrm, :OLD.PrmSab, :OLD.PrmDom, :OLD.PrmFer,
                     :OLD.PrmRt1, :OLD.PrmRt2, :OLD.PrmRt3,
                     0, 0, 0, 0, 0, 0, 0,
                     l_datenv, :OLD.Idtpes, :OLD.NomFun, :OLD.NumPis,0,2,0, l_oldnumcpf);
          END IF;
      END IF;

      IF (l_enviar = TRUE) THEN
          /* atualiza tabela temporaria de crachas alterados*/
          IF (l_TipOpeRep = 'I') THEN
              l_TipOpeRepAux := 'A';
          END IF;

          IF (l_TipOpeRep = 'U') THEN
              l_TipOpeRepAux := 'P';
          END IF;

          IF (l_TipOpeRep = 'D') THEN
              l_TipOpeRepAux := 'B';
          END IF;

          IF (l_TipOpeRep = 'F') THEN
              l_TipOpeRepAux := 'J';
          END IF;

          IF (l_TipOpeRep = 'E') THEN
              l_TipOpeRepAux := 'K';
          END IF;

          IF (l_TipOpeRep IN ('I', 'U') OR l_PodeIgnorar = FALSE) THEN
            SP_R070ACR(l_TipOpeRepAux,
                       :NEW.NumCra, :NEW.NumFis, :NEW.TecCra, :NEW.VERPRM,
                       0, :NEW.CODPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                       :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRt3,
                       0, 0, 0, 0, 0, 0, 0,
                       l_datenv, :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis,l_altbio,0,0, l_newnumcpf);
          END IF;

          IF (l_TipOpeRep = 'I') THEN
              l_TipOpeRepAux := 'H';
          END IF;

          IF (l_TipOpeRep = 'U') THEN
              l_TipOpeRepAux := 'M';
          END IF;

          IF (l_TipOpeRep = 'D') THEN
              l_TipOpeRepAux := 'X';
          END IF;

          IF (l_TipOpeRep = 'F') THEN
              l_TipOpeRepAux := 'Y';
          END IF;

          IF (l_TipOpeRep = 'E') THEN
              l_TipOpeRepAux := 'Z';
          END IF;

          IF (l_TipOpeRep IN ('I', 'U') OR l_PodeIgnorar = FALSE) THEN
            SP_R070ACR(l_TipOpeRepAux,
                       :NEW.NumCra, :NEW.NumFis, :NEW.TecCra, :NEW.VERPRM,
                       0, :NEW.CODPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                       :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRt3,
                       0, 0, 0, 0, 0, 0, 0,
                       l_datenv, :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis,0,0,0, l_newnumcpf);
          END IF;
      END IF;

      IF (l_TipOpeRep = 'E') THEN
          l_exc62 := TRUE;
      END IF;
      IF (l_TipOpeRep = 'I') THEN
          l_inc62 := TRUE;
      END IF;

  END IF;

  l_TipOpeRep := 'I';
  IF (l_sitcra <> '00' OR               /* Situacao */
      l_blofal = '1' OR                 /* Por Falta */
      l_datval_new <= l_datatu_date OR  /* Por validade */
      l_iniafa <> '0000000000000000')   /* Por Afastamento */
  THEN
      l_TipOpeRep := 'D';  /* Se alguma das condicoes bloqueiam, nao deixa a operacao incluir. */
  END IF;

  IF (l_lockCard = TRUE) THEN
    IF ( ((:NEW.SITCRA = 1) AND (:OLD.SITCRA = 0)) OR (l_blofal = '1')) THEN
      SP_PENDAce62('D',
                   :NEW.NumCra, :NEW.NumFis, :NEW.TecCra, :NEW.VERPRM,
                   0, 0, 0, 0, 0, 0, 0, :NEW.DatVal,
                   :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis, 2, :OLD.TipCra,
                   :NEW.CODPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                   :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRt3, l_newnumcpf);
    ELSE
      IF ( ((:NEW.SITCRA = 0) AND (:OLD.SITCRA = 1)) OR (l_blofal <> '1')) THEN
        SP_PENDAce62(l_TipOpeRep,
                     :NEW.NumCra, :NEW.NumFis, :NEW.TecCra, :NEW.VERPRM,
                     :NEW.CODPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                     :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRt3, :NEW.DatVal,
                     :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis, 1, :OLD.TipCra,
                     l_CodPrmOLD, l_PrmSabOLD, l_PrmDomOLD, l_PrmFerOLD,
                     l_PrmRt1Old, l_PrmRt2Old, l_PrmRt3Old, l_newnumcpf);
      END IF;
    END IF;
  END IF;

  IF ((l_uValidity = TRUE) AND (l_datval_new <= l_datatu_date)) THEN
    SP_PENDAce62('D',
                 :NEW.NumCra, :NEW.NumFis, :NEW.TecCra, :NEW.VERPRM,
                 0, 0, 0, 0, 0, 0, 0, :NEW.DatVal,
                 :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis, 2, :OLD.TipCra,
                 :NEW.CODPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                 :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRt3, l_newnumcpf);
  ELSE
    IF (l_uValidity = TRUE) AND ((l_datval_new > l_datatu_date) OR (:NEW.DATVAL = '3112502359000000')) THEN
      SP_PENDAce62(l_TipOpeRep,
                   :NEW.NumCra, :NEW.NumFis, :NEW.TecCra, :NEW.VERPRM,
                   :NEW.CODPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                   :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRt3, :NEW.DatVal,
                   :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis, 1, :OLD.TipCra,
                   0, 0, 0, 0, 0, 0, 0, l_newnumcpf);
    END IF;
  END IF;

  IF (l_uRemoval = TRUE) THEN
      /* Passa sem permissão para buscar os valores corretos de um comando de DELETE ou INSERT */
      IF (l_iniafa = '0000000000000000') THEN
          SP_PENDAce62(l_TipOpeRep,
                   :NEW.NumCra, :NEW.NumFis, :NEW.TecCra, :NEW.VERPRM,
                   :NEW.CODPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                   :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRt3, :NEW.DatVal,
                   :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis, 1, :OLD.TipCra,
                   0,0,0,0,0,0,0, l_newnumcpf);
      ELSE
          SP_PENDAce62('D',
                   :NEW.NumCra, :NEW.NumFis, :NEW.TecCra, :NEW.VERPRM,
                   0,0,0,0,0,0,0,
                   :NEW.DatVal,
                   :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis, 2, :OLD.TipCra,
                   :NEW.CODPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                   :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRt3, l_newnumcpf);
      END IF;
  END IF;

  /* Controle da pendencia 62 */
  /* Assim gera uma vez so para comandos iguais */
  IF ((l_exc62 = TRUE) AND ((:OLD.NumPis > 0) OR (l_oldnumcpf <> 0)) AND (l_podeIgnorar = FALSE)) THEN
      IF (:OLD.UsaBio > 1) THEN
                SP_R070ACR('J',:OLD.NumCra, :OLD.NumFis, :OLD.TecCra, :OLD.VERPRM,
                               0, :OLD.CODPrm, :OLD.PrmSab, :OLD.PrmDom, :OLD.PrmFer,
                               :OLD.PrmRt1, :OLD.PrmRt2, :OLD.PrmRt3,
                               0, 0, 0, 0, 0, 0, 0,
                               l_datenv, :OLD.Idtpes, :OLD.NomFun, :OLD.NumPis,2,1,0, l_oldnumcpf);

                SP_R070ACR('Y',:OLD.NumCra, :OLD.NumFis, :OLD.TecCra, :OLD.VERPRM,
                               0, :OLD.CODPrm, :OLD.PrmSab, :OLD.PrmDom, :OLD.PrmFer,
                               :OLD.PrmRt1, :OLD.PrmRt2, :OLD.PrmRt3,
                               0, 0, 0, 0, 0, 0, 0,
                               l_datenv, :OLD.Idtpes, :OLD.NomFun, :OLD.NumPis,0,1,0, l_oldnumcpf);
                ELSE
                SP_R070ACR('F',:OLD.NumCra, :OLD.NumFis, :OLD.TecCra, :OLD.VERPRM,
                               0, :OLD.CODPrm, :OLD.PrmSab, :OLD.PrmDom, :OLD.PrmFer,
                               :OLD.PrmRt1, :OLD.PrmRt2, :OLD.PrmRt3,
                               0, 0, 0, 0, 0, 0, 0,
                               l_datenv, :OLD.Idtpes, :OLD.NomFun, :OLD.NumPis,0,1,0, l_oldnumcpf);
      END IF;
  END IF;

  /*Se alterou o NUMFIS do crachá, manda comando de delete para todos dsp das permissões */
  IF (:OLD.NUMFIS <> :NEW.NUMFIS) THEN
      SP_PEND62('F',:OLD.NumCra, :OLD.NumFis, :OLD.TecCra, :OLD.VERPRM,
                    :OLD.CODPrm, :OLD.PrmSab, :OLD.PrmDom, :OLD.PrmFer,
                    :OLD.PrmRt1, :OLD.PrmRt2, :OLD.PrmRt3, :OLD.DatVal,
                    :OLD.Idtpes, :OLD.NomFun, :OLD.NumPis, 1, l_oldnumcpf);

      SP_PENDAce62('D', :NEW.NumCra, :OLD.NumFis, :NEW.TecCra, :NEW.VerPrm, 
                        0, 0, 0, 0, 0, 0, 0, :NEW.DatVal, :NEW.IdtPes, :NEW.NomFun, :NEW.NumPis, 2, 
                        :OLD.TipCra, :NEW.CodPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer, :NEW.PrmRt1, 
                        :NEW.PrmRt2, :NEW.PrmRt3, l_newnumcpf);

      SP_PENDAce62('I', :NEW.NumCra, :NEW.NumFis, :NEW.TecCra, :NEW.VerPrm, 
                        :NEW.CodPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer, :NEW.PrmRt1, :NEW.PrmRt2, 
                        :NEW.PrmRt3, :NEW.DatVal, :NEW.IdtPes, :NEW.NomFun, :NEW.NumPis, 1, 
                        :OLD.TipCra, l_CodPrmOld, l_PrmSabOld, l_PrmDomOld, l_PrmFerOld, l_PrmRt1Old, 
                        l_PrmRt2Old, l_PrmRt3Old, l_newnumcpf);
  END IF;

  IF (l_inc62 = TRUE AND ((:NEW.NumPis > 0) OR (l_newnumcpf > 0)) AND (l_podeIgnorar = FALSE OR (l_crapro = 0 AND :NEW.TIPCRA <> 1))) THEN
      IF (:NEW.USABIO > 1) THEN
            SP_R070ACR('A', :NEW.NumCra, :NEW.NumFis, :NEW.TecCra, :NEW.VERPRM,
                            0, :NEW.CODPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                            :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRt3,
                            0, 0, 0, 0, 0, 0, 0,
                            l_datenv, :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis,1,0,0, l_newnumcpf);

            SP_R070ACR('H', :NEW.NumCra, :NEW.NumFis, :NEW.TecCra, :NEW.VERPRM,
                            0, :NEW.CODPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                            :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRt3,
                            0, 0, 0, 0, 0, 0, 0,
                            l_datenv, :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis,0,0,0, l_newnumcpf);
      ELSE
            SP_R070ACR('I', :NEW.NumCra, :NEW.NumFis, :NEW.TecCra, :NEW.VERPRM,
                            0, :NEW.CODPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                            :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRt3,
                            0, 0, 0, 0, 0, 0, 0,
                            l_datenv, :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis,0,0,0, l_newnumcpf);
      END IF;
  END IF;

  /* Controle da pendencia ACE62 */
  IF (l_excAce62 = TRUE) THEN
    SP_PENDAce62('D',
                 :NEW.NumCra, :NEW.NumFis, :NEW.TecCra, :NEW.VERPRM,
                 :NEW.CODPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                 :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRt3, :NEW.DatVal,
                 :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis, 2, :OLD.TipCra,
                 l_CodPrmOLD, l_PrmSabOLD, l_PrmDomOLD, l_PrmFerOLD,
                 l_PrmRt1OLD, l_PrmRt2OLD, l_PrmRt3OLD, l_newnumcpf);
  END IF;

  IF (l_incAce62 = TRUE) THEN
    SP_PENDAce62('I',
                 :NEW.NumCra, :NEW.NumFis, :NEW.TecCra, :NEW.VERPRM,
                 :NEW.CODPrm, :NEW.PrmSab, :NEW.PrmDom, :NEW.PrmFer,
                 :NEW.PrmRt1, :NEW.PrmRt2, :NEW.PrmRt3, :NEW.DatVal,
                 :NEW.Idtpes, :NEW.NomFun, :NEW.NumPis, 1, :OLD.TipCra,
                 l_CodPrmOLD, l_PrmSabOLD, l_PrmDomOLD, l_PrmFerOLD,
                 l_PrmRt1OLD, l_PrmRt2OLD, l_PrmRt3OLD, l_newnumcpf);
  END IF;


/*-------------------------------------------------------------------------*/
/*-------------------------------------------------------------------------*/
/*Tratamento para geração da pendência tabela Atuali*/
  IF ((l_atuali = 'S') AND (l_gerpen = 'S')) THEN
      /*Tratamento especial para caso a pessoa alterar o número smart*/
      IF (:NEW.NUMFIS <> :OLD.NUMFIS) THEN
          IF ((:NEW.TECCRA = 3) AND (:OLD.TECCRA = 3))THEN
              /*Verifica se o crachá principal é smart*/
              IF (:NEW.CHCPRI = 0) THEN
                  /*Obtem o "icard" como o principal é smart, o icard será o número lógico*/
                  l_numcra_atuali := :NEW.NUMCRA;
              ELSE
                  /*Obtem o "icard" como o principal é smart, o icard será o número lógico*/
                  l_numcra_atuali := :NEW.CHCPRI;
              END IF;
              /*Bloqueia o crachá antigo*/
              SP_ATUALI(:OLD.NUMFIS, l_numcra_atuali, '2', '1');
          END IF;
      END IF;
      /*Verifica se é o crachá principal da pessoa, pois somente é gerada pendência para o crachá
      principal da pessoa, pois este contém todas as informações da pessoa.*/
      IF (:NEW.CHCPRI = 0) THEN
          /*Verifica se o crachá principal é smart*/
          IF (:NEW.TECCRA = 3) THEN
              /*Obtem o "icard" como o principal é smart, o icard será o número lógico*/
              l_numcra_atuali := :NEW.NUMCRA;
              l_numsma := :NEW.NUMFIS;
          ELSE
              /*Obtem o "icard" que será o NumFis*/
              l_numcra_atuali := :NEW.NUMFIS;
              /*Busca o crachá smart da pessoa*/
              BEGIN
                  SELECT A.NUMFIS INTO l_numsma
                  FROM R069FIS A
                  WHERE NUMCRA = :NEW.NUMCRA
                  AND TECCRA = 3
                  AND HORINI = (SELECT MAX(HORINI)
                                FROM R069FIS
                                WHERE NUMCRA = A.NUMCRA AND
                                DATALT = (SELECT MAX(DATALT)
                                          FROM R069FIS
                                          WHERE NUMCRA = A.NUMCRA AND
                                          TECCRA = 3 AND DATALT <= l_data_atual
                                          )
                                AND TECCRA = 3)
                  AND DATALT = (SELECT MAX(DATALT)
                                FROM R069FIS
                                WHERE NUMCRA = A.NUMCRA AND
                                TECCRA = 3 AND DATALT <= l_data_atual
                                )
                  AND DATFIM = l_data_zero;
              EXCEPTION
                  WHEN OTHERS THEN l_numsma := 0;
              END;
          END IF;

          /*Se encontrou o crachá efetua a geração da pendência pro campo alterado*/
          IF (l_numsma > 0) THEN
              /*Envia as pendências*/
              /*Pendências que são sempre geradas*/
              /*2 - situa*/
              IF (:NEW.SITCRA <> :OLD.SITCRA) THEN
                  SP_INTSTR(:NEW.SitCra, '9',l_situa OUT);
                  /*Tratamento especial para o sitcra*/
                  IF (l_situa = '0') THEN
                      l_situa := '10';
                  END IF;
                  SP_ATUALI(l_numsma, l_numcra_atuali, '02',l_situa);
              END IF;

              IF (:NEW.PESBLO <> :OLD.PESBLO) THEN
                  SP_INTSTR(:NEW.PESBLO, '9',l_situa OUT);
                  /*Tratamento especial para o pesblo*/
                  IF (l_situa = '0' AND :NEW.SitCra = 0) THEN
                      l_situa := '10';
                  ELSE
                      l_situa := '1';
                  END IF;
                  SP_ATUALI(l_numsma, l_numcra_atuali, '02',l_situa);
              END IF;

              /*5 - bloq_falta*/
              IF (:NEW.BLOFAL <> :OLD.BLOFAL) THEN
                  SP_INTSTR(:NEW.BLOFAL, '9',l_bloq_falta OUT);
                  SP_ATUALI(l_numsma, l_numcra_atuali, '05',l_bloq_falta);
              END IF;

              /*14 - datahora*/
              IF (:NEW.DATVAL <> :OLD.DATVAL) THEN
                  l_datahora := SUBSTRING (:NEW.DATVAL,1,10);
                  SP_ATUALI(l_numsma, l_numcra_atuali, '14',l_datahora);
              END IF;

              /*15 - datini*/
              IF (:NEW.INIAFA <> :OLD.INIAFA) THEN
                  l_datini := SUBSTRING (:NEW.INIAFA,1,6);
                  IF (l_datini = '000000') THEN
                      l_datini := '      ';
                  END IF;
                  SP_ATUALI(l_numsma, l_numcra_atuali, '15',l_datini);
              END IF;

               /*19 - datfim*/
              IF (:NEW.DATAFA <> :OLD.DATAFA) THEN
                  l_datfim := SUBSTRING (:NEW.DATAFA,1,6);
                  IF (l_datfim = '000000') THEN
                      l_datfim := '      ';
                  END IF;
                  SP_ATUALI(l_numsma, l_numcra_atuali, '19',l_datfim);
              END IF;

              /*Verifica se gera pendência de definições de acesso*/
              IF (l_pendef = 'S') THEN

                  /*1 - tpfis*/
                  IF (:NEW.TIPCRA <> :OLD.TIPCRA) THEN
                      IF (:NEW.TipCra > 9) THEN /*Prever tipos maiores do que 9*/
                          l_tpfis := '0';
                      ELSE
                          SP_INTSTR(:NEW.TipCra, '9',l_tpfis OUT);
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '01', l_tpfis);
                  END IF;

                  /*3 - fx_flg*/
                  IF (:NEW.CONIAL <> :OLD.CONIAL) THEN
                      SP_INTSTR(:NEW.CONIAL,'9',l_fx_flg OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '03',l_fx_flg);
                  END IF;

                  /*4 - anti_dupla*/
                  IF (:NEW.CONADP <> :OLD.CONADP) THEN
                      SP_INTSTR(:NEW.CONADP, '9',l_anti_dupla OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '04',l_anti_dupla);
                  END IF;

                  /*6 - ver_local*/
                  IF (:NEW.VERPRM <> :OLD.VERPRM) THEN
                      SP_INTSTR(:NEW.VERPRM, '9',l_ver_local OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '06',l_ver_local);
                  END IF;

                  /*7 - ver_valid (Não possui na R070CON)*/

                  /*8 - ver_afast*/
                  IF (:NEW.VERAFA <> :OLD.VERAFA) THEN
                      SP_INTSTR(:NEW.VERAFA, '9',l_ver_afast OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '08',l_ver_afast);
                  END IF;

                  /*9 - vis_esp*/
                  IF (:NEW.BLOAUT <> :OLD.BLOAUT) THEN
                      SP_INTSTR(:NEW.BLOAUT, '9',l_vis_esp OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '09',l_vis_esp);
                  END IF;

                  /*10 - ver_ret*/
                  IF (:NEW.CONINT <> :OLD.CONINT) THEN
                      SP_INTSTR(:NEW.CONINT, '9',l_ver_ret OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '10',l_ver_ret);
                  END IF;

                  /*11 - ver_hora*/
                  IF (:NEW.CONFAI <> :OLD.CONFAI) THEN
                      SP_INTSTR(:NEW.CONFAI, '9',l_ver_hora OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '11',l_ver_hora);
                  END IF;

                  /*12 - ver_cred*/
                  IF (:NEW.CONCRE <> :OLD.CONCRE) THEN
                      SP_INTSTR(:NEW.CONCRE, '9',l_ver_cred OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '12',l_ver_cred);
                  END IF;

                   /*13 - codig*/
                  IF (:NEW.SENCOL <> :OLD.SENCOL) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '13',:NEW.SENCOL );
                  END IF;


                  /*24 - tempo_alm*/
                  IF (:NEW.TEMALM <> :OLD.TEMALM) THEN
                      SP_INTSTR(:NEW.TEMALM, '999',l_tempo_alm OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '24',l_tempo_alm);
                  END IF;

                  /*38 - toler_ret*/
                  IF (:NEW.TOLINT <> :OLD.TOLINT) THEN
                      SP_INTSTR(:NEW.TOLINT, '999',l_toler_ret OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '38',l_toler_ret);
                  END IF;
              END IF;

              /*Pendência de permissões*/
              IF (l_penper = 'S') THEN
                  BEGIN
                      SELECT EDIPRM INTO l_ediprm FROM R000ASS;
                      IF (l_ediprm = '99999') THEN
                          l_newprm := TRUE;
                      ELSE
                          l_newprm := FALSE;
                      END IF;
                  EXCEPTION
                      WHEN OTHERS THEN RAISERROR 103 'TR070CON: Não conseguiu obter a máscara da permissão R000ASS.EDIPRM.';
                      l_newprm := FALSE;
                  END;

                  /*25 - grupo*/
                  IF (:NEW.CODPRM <> :OLD.CODPRM) THEN
                      IF (l_newprm = TRUE) THEN
                          SP_INTSTR(:NEW.CODPRM ,'99999',l_grupo OUT);
                      ELSE
                          SP_INTSTR(:NEW.CODPRM ,'999',l_grupo OUT);
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '25',l_grupo);
                  END IF;

                  /*26 - grupo1*/
                  IF (:NEW.PRMRT1 <> :OLD.PRMRT1) THEN
                      IF (l_newprm = TRUE) THEN
                          SP_INTSTR(:NEW.PRMRT1, '99999',l_grupo1 OUT);
                      ELSE
                          SP_INTSTR(:NEW.PRMRT1, '999',l_grupo1 OUT);
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '26',l_grupo1);
                  END IF;

                  /*27 - datinig1*/
                  IF (:NEW.DINPR1 <> :OLD.DINPR1) THEN
                      l_datinig1 := :NEW.DINPR1;
                      IF (l_datinig1 = '0000000000') THEN
                          l_datinig1 := '          ';
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '27',l_datinig1);
                  END IF;

                  /* 28 - datfimg1 */
                  IF (:NEW.DFNPR1 <> :OLD.DFNPR1) THEN
                      l_datfimg1 := :NEW.DFNPR1;
                      IF (l_datfimg1 = '0000000000') THEN
                          l_datfimg1 := '          ';
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '28',l_datfimg1);
                  END IF;

                  /*29 - grupo2*/
                  IF (:NEW.PRMRT2 <> :OLD.PRMRT2) THEN
                      IF (l_newprm = TRUE) THEN
                          SP_INTSTR(:NEW.PRMRT2, '99999',l_grupo2 OUT);
                      ELSE
                          SP_INTSTR(:NEW.PRMRT2, '999',l_grupo2 OUT);
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '29',l_grupo2);
                  END IF;

                  /*30 - datinig2*/
                  IF (:NEW.DINPR2 <> :OLD.DINPR2) THEN
                      l_datinig2 := :NEW.DINPR2;
                      IF (l_datinig2 = '0000000000') THEN
                          l_datinig2 := '          ';
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '30',l_datinig2);
                  END IF;

                  /*31 - datfimg2*/
                  IF (:NEW.DFNPR2 <> :OLD.DFNPR2) THEN
                      l_datfimg2 := :NEW.DFNPR2;
                      IF (l_datfimg2 = '0000000000') THEN
                          l_datfimg2 := '          ';
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '31',l_datfimg2);
                  END IF;

                  /*32 - grupo3*/
                  IF (:NEW.PRMRT3 <> :OLD.PRMRT3) THEN
                      IF (l_newprm = TRUE) THEN
                          SP_INTSTR(:NEW.PRMRT3, '99999',l_grupo3 OUT);
                      ELSE
                          SP_INTSTR(:NEW.PRMRT3, '999',l_grupo3 OUT);
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '32',l_grupo3);
                  END IF;

                  /*33 - datinig3*/
                  IF (:NEW.DINPR3 <> :OLD.DINPR3) THEN
                      l_datinig3 := :NEW.DINPR3;
                      IF (l_datinig3 = '0000000000') THEN
                          l_datinig3 := '          ';
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '33',l_datinig3);
                  END IF;

                  /*34 - datfimg3*/
                  IF (:NEW.DFNPR3 <> :OLD.DFNPR3) THEN
                      l_datfimg3 := :NEW.DFNPR3;
                      IF (l_datfimg3 = '0000000000') THEN
                          l_datfimg3 := '          ';
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '34',l_datfimg3);
                  END IF;

                  /*35 - grupo_sab*/
                  IF (:NEW.PRMSAB <> :OLD.PRMSAB) THEN
                      IF (l_newprm = TRUE) THEN
                          SP_INTSTR(:NEW.PRMSAB, '99999',l_grupo_sab OUT);
                      ELSE
                          SP_INTSTR(:NEW.PRMSAB, '999',l_grupo_sab OUT);
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '35',l_grupo_sab);
                  END IF;

                  /*36 - grupo_dom*/
                  IF (:NEW.PRMDOM <> :OLD.PRMDOM) THEN
                      IF (l_newprm = TRUE) THEN
                          SP_INTSTR(:NEW.PRMDOM, '99999',l_grupo_dom OUT);
                      ELSE
                          SP_INTSTR(:NEW.PRMDOM, '999',l_grupo_dom OUT);
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '36',l_grupo_dom);
                  END IF;

                  /*37 - grupo_fer*/
                  IF (:NEW.PRMFER <> :OLD.PRMFER) THEN
                      IF (l_newprm = TRUE) THEN
                          SP_INTSTR(:NEW.PRMFER, '99999',l_grupo_fer OUT);
                      ELSE
                          SP_INTSTR(:NEW.PRMFER, '999',l_grupo_fer OUT);
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '37',l_grupo_fer);
                  END IF;
              END IF;

              /*Pendência de créditos de acesso*/
              IF (l_pencrc = 'S') THEN

                  /*53 - fx_1*/
                  IF (:NEW.CREFX1 <> :OLD.CREFX1) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '53',:NEW.CREFX1);
                  END IF;

                  /*54 - fx_2*/
                  IF (:NEW.CREFX2 <> :OLD.CREFX2) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '54',:NEW.CREFX2);
                  END IF;

                  /*55 - fx_3*/
                  IF (:NEW.CREFX3 <> :OLD.CREFX3) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '55',:NEW.CREFX3);
                  END IF;

                  /*56 - fx_4*/
                  IF (:NEW.CREFX4 <> :OLD.CREFX4) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '56',:NEW.CREFX4);
                  END IF;

                  /*57 - fx_5*/
                  IF (:NEW.CREFX5 <> :OLD.CREFX5) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '57',:NEW.CREFX5);
                  END IF;

                  /*58 - fx_6*/
                  IF (:NEW.CREFX6 <> :OLD.CREFX6) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '58',:NEW.CREFX6);
                  END IF;

                  /*61 - cred_fx1*/
                  IF (:NEW.CREAC1 <> :OLD.CREAC1) THEN
                      SP_INTSTR(:NEW.CREAC1, '99',l_cred_fx1 OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '61',l_cred_fx1);
                  END IF;

                  /*62 - cred_fx2*/
                  IF (:NEW.CREAC2 <> :OLD.CREAC2) THEN
                      SP_INTSTR(:NEW.CREAC2, '99',l_cred_fx2 OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '62',l_cred_fx2);
                  END IF;

                  /*63 - cred_fx3*/
                  IF (:NEW.CREAC3 <> :OLD.CREAC3) THEN
                      SP_INTSTR(:NEW.CREAC3, '99',l_cred_fx3 OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '63',l_cred_fx3);
                  END IF;

                  /*64 - cred_fx4*/
                  IF (:NEW.CREAC4 <> :OLD.CREAC4) THEN
                      SP_INTSTR(:NEW.CREAC4, '99',l_cred_fx4 OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '64',l_cred_fx4);
                  END IF;

                  /*65 - cred_fx5*/
                  IF (:NEW.CREAC5 <> :OLD.CREAC5) THEN
                      SP_INTSTR(:NEW.CREAC5, '99',l_cred_fx5 OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '65',l_cred_fx5);
                  END IF;

                  /*66 - cred_fx6*/
                  IF (:NEW.CREAC6 <> :OLD.CREAC6) THEN
                      SP_INTSTR(:NEW.CREAC6, '99',l_cred_fx6 OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '66',l_cred_fx6);
                  END IF;
              END IF;

              /*Pendência de mensagens*/
              IF (l_penmsg = 'S') THEN

                  /*17 - qtd_mens*/
                  IF (:NEW.QTDMSG <> :OLD.QTDMSG) THEN
                      SP_INTSTR(:NEW.QTDMSG, '99',l_qtd_mens OUT);
                      SP_ATUALI(l_numsma, l_numcra_atuali, '17',l_qtd_mens);
                  END IF;

                  /*20 - dta_mens*/
                  IF (:NEW.DATMSG <> :OLD.DATMSG) THEN
                      l_dta_msg := SUBSTRING (:NEW.DATMSG,1,6);
                      IF ((l_dta_msg = '000000') OR (l_dta_msg IS NULL)) THEN
                          l_dta_msg := '      ';
                      END IF;
                      SP_ATUALI(l_numsma, l_numcra_atuali, '20',l_dta_msg);
                  END IF;

                  /*22 - mensagem*/
                  IF (:NEW.MSGACC <> :OLD.MSGACC) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '22',:NEW.MSGACC);
                  END IF;
              END IF;

              /*Geração de pendência de faixa horária*/
              IF (l_penfxh = 'S') THEN

                  /*23 - fx_ref*/
                  IF (:NEW.FAIREF <> :OLD.FAIREF) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '23',:NEW.FAIREF);
                  END IF;

                  /*39 - fx_dom_a*/
                  IF (:NEW.FAIAC1 <> :OLD.FAIAC1) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '39',:NEW.FAIAC1);
                  END IF;

                  /*40 - fx_seg_a*/
                  IF (:NEW.FAIAC2 <> :OLD.FAIAC2) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '40',:NEW.FAIAC2);
                  END IF;

                  /*41 - fx_ter_a*/
                  IF (:NEW.FAIAC3 <> :OLD.FAIAC3) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '41',:NEW.FAIAC3);
                  END IF;

                  /*42 - fx_qua_a*/
                  IF (:NEW.FAIAC4 <> :OLD.FAIAC4) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '42',:NEW.FAIAC4);
                  END IF;

                  /*43 - fx_qui_a*/
                  IF (:NEW.FAIAC5 <> :OLD.FAIAC5) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '43',:NEW.FAIAC5);
                  END IF;

                  /*44 - fx_sex_a*/
                  IF (:NEW.FAIAC6 <> :OLD.FAIAC6) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '44',:NEW.FAIAC6);
                  END IF;

                  /*45 - fx_sab_a*/
                  IF (:NEW.FAIAC7 <> :OLD.FAIAC7) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '45',:NEW.FAIAC7);
                  END IF;

                  /*46 - fx_dom_p*/
                  IF (:NEW.FAIPT1 <> :OLD.FAIPT1) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '46',:NEW.FAIPT1);
                  END IF;

                  /*47 - fx_seg_p*/
                  IF (:NEW.FAIPT2 <> :OLD.FAIPT2) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '47',:NEW.FAIPT2);
                  END IF;

                  /*48 - fx_ter_p*/
                  IF (:NEW.FAIPT3 <> :OLD.FAIPT3) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '48',:NEW.FAIPT3);
                  END IF;

                  /*49 - fx_qua_p*/
                  IF (:NEW.FAIPT4 <> :OLD.FAIPT4) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '49',:NEW.FAIPT4);
                  END IF;

                  /*50 - fx_qui_p*/
                  IF (:NEW.FAIPT5 <> :OLD.FAIPT5) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '50',:NEW.FAIPT5);
                  END IF;

                  /*51 - fx_sex_p*/
                  IF (:NEW.FAIPT6 <> :OLD.FAIPT6) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '51',:NEW.FAIPT6);
                  END IF;

                  /*52 - fx_sab_p*/
                  IF (:NEW.FAIPT7 <> :OLD.FAIPT7) THEN
                      SP_ATUALI(l_numsma, l_numcra_atuali, '52',:NEW.FAIPT7);
                  END IF;
              END IF;
          END IF;
      END IF;
  END IF;
END␀„Ù␀␀		SENIOR;0P

TRIGGER R070CON_ED AFTER DELETE ON R070CON FOR EACH ROW
BEGIN
  NULL;
END		SENIOR;20.␀␀



TRIGGER R070CON_ED AFTER DELETE ON R070CON FOR EACH ROW
DECLARE
  l_numfis             CHAR(12);
  l_Straux             VARCHAR2(2047);
  l_gersen             BOOLEAN;
  l_data_atual         DATE;
  l_datval             DATE;
  l_datatu             DATE;
  l_enviar             BOOLEAN;
  l_hora_atual         NUMBER(4);
  l_seqenv             NUMBER(2);
  l_datstr             CHAR(6);
  l_horstr             CHAR(4);
  l_seqstr             CHAR(2);
  l_datenv             CHAR(16);
  l_CenPen             VARCHAR2(255);
  l_idtpesAux          CHAR(23);
  l_dat_conv           VARCHAR(25); /*Variável auxiliar para conversão de data*/
  l_numcpf             NUMBER(11); /* Variável para simplificar as operações com cpf. Quando o tipo de documento for diferente de 2, é zerada */
  l_remrep             NUMBER(1);
  l_exclui_pes_rep     NUMBER(1);
  l_nao_exclui_pes_rep NUMBER(1);
  l_data_zero          DATE;
  l_qtd_cracha_fisico  NUMBER(4);

BEGIN
  IF (:OLD.TIPDOC = 2) THEN
      l_numcpf := :OLD.NUMDOC;
  ELSE
      l_numcpf := 0;
  END IF;  
  
  /*Envia para todas as centralizadoras*/
  l_CenPen := '0';

  /*Obtem a data/hora de envio da pendência.*/
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
  /*Obtem o Segundo*/
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

  /*CONVERTE CARACTERE EM DATA*/
  l_dat_conv := SUBSTRING(:OLD.DATVAL,1,2) || '/' || SUBSTRING(:OLD.DATVAL,3,2) ||'/'||SUBSTRING(:OLD.DATVAL,5,2)||' '||
                                                     SUBSTRING(:OLD.DATVAL,7,2)||':'||SUBSTRING(:OLD.DATVAL,9,2)||':00';
  SP_STRTODATE(l_dat_conv, 'dd/mm/aa HH:MI:SS', l_datval OUT);
  l_dat_conv := SUBSTRING(l_datstr,1,2) || '/' || SUBSTRING(l_datstr,3,2) ||'/'||SUBSTRING(l_datstr,5,2)||' '||
                                                  SUBSTRING(l_horstr,1,2)||':'||SUBSTRING(l_horstr,3,2)||':00';
  SP_STRTODATE(l_dat_conv, 'DD/MM/AA hh:mi:ss', l_datatu OUT);

  SP_GERSEN(l_gersen OUT);
  IF  (l_gersen = TRUE AND NOT(:OLD.TIPCRA = 6 AND l_datval < l_datatu)) THEN
      SP_INTSTR(:OLD.NUMFIS,'999999999999',l_numfis OUT);
      /*Ao excluir o crachá envia o comando LockCard para bloquear o mesmo*/
      l_StrAux := '05'||l_datenv||l_numfis||'1'||'00';
      SP_PorCom(l_StrAux, l_CenPen);
  END IF;

  /* Deletar um número físico, chama SP_R070ACR passando F, para exclusão normal */
  l_enviar := TRUE;
  IF (l_datval <= l_datatu AND :OLD.DATVAL <> '3112502359000000') THEN
    l_enviar := FALSE;
  END IF;

  IF (((:OLD.NUMPIS > 0) OR (l_numcpf > 0)) AND ((:OLD.TIPCRA = 1) OR (:OLD.TIPCRA = 2) OR (:OLD.TIPCRA = 6)) AND (l_enviar = TRUE)) THEN
      /*Se encontrar algum cracha fisico ativo para esse cracha logico, nao exclui a pessoa do rep*/
      BEGIN
      l_exclui_pes_rep := 1;
      l_nao_exclui_pes_rep := 0;
      l_data_zero  := '31/12/1900,00:00:00';
      SELECT COUNT(1) INTO l_qtd_cracha_fisico
      FROM R069FIS A
      WHERE NUMCRA = :OLD.NumCra
      AND HORINI = (SELECT MAX(HORINI)
                      FROM R069FIS
                      WHERE NUMCRA = A.NUMCRA AND
                      DATALT = (SELECT MAX(DATALT)
                                FROM R069FIS
                                WHERE NUMCRA = A.NUMCRA
                                AND DATALT <= l_data_atual))
      AND DATALT = (SELECT MAX(DATALT)
                      FROM R069FIS
                      WHERE NUMCRA = A.NUMCRA
                      AND DATALT <= l_data_atual)
      AND DATFIM = l_data_zero;
      EXCEPTION
          WHEN OTHERS THEN l_qtd_cracha_fisico := 0;
      END;

      IF (l_qtd_cracha_fisico > 0) THEN
      	l_remrep := l_nao_exclui_pes_rep;
      ELSE
      	l_remrep := l_exclui_pes_rep;
      END IF;

      IF (:OLD.USABIO > 1) THEN
        SP_R070ACR('J', :OLD.NumCra, :OLD.NumFis, :OLD.TecCra, :OLD.VERPRM,
                        0, :OLD.CODPrm, :OLD.PrmSab, :OLD.PrmDom, :OLD.PrmFer,
                        :OLD.PrmRt1, :OLD.PrmRt2, :OLD.PrmRt3,
                        0, 0, 0, 0, 0, 0, 0,
                        l_datenv, :OLD.Idtpes, :OLD.NomFun, :OLD.NumPis,2,l_remrep,0, l_numcpf);

        SP_R070ACR('Y', :OLD.NumCra, :OLD.NumFis, :OLD.TecCra, :OLD.VERPRM,
                        0, :OLD.CODPrm, :OLD.PrmSab, :OLD.PrmDom, :OLD.PrmFer,
                        :OLD.PrmRt1, :OLD.PrmRt2, :OLD.PrmRt3,
                        0, 0, 0, 0, 0, 0, 0,
                        l_datenv, :OLD.Idtpes, :OLD.NomFun, :OLD.NumPis,0,l_remrep,27, l_numcpf);
      ELSE
        SP_R070ACR('F', :OLD.NumCra, :OLD.NumFis, :OLD.TecCra, :OLD.VERPRM,
                        0, :OLD.CODPrm, :OLD.PrmSab, :OLD.PrmDom, :OLD.PrmFer,
                        :OLD.PrmRt1, :OLD.PrmRt2, :OLD.PrmRt3,
                        0, 0, 0, 0, 0, 0, 0,
                        l_datenv, :OLD.Idtpes, :OLD.NomFun, :OLD.NumPis,0,l_remrep,0, l_numcpf);
      END IF;
  END IF;

  SP_PEND62('F', :OLD.NumCra, :OLD.NumFis, :OLD.TecCra, :OLD.VERPRM,
                 :OLD.CODPrm, :OLD.PrmSab, :OLD.PrmDom, :OLD.PrmFer,
                 :OLD.PrmRt1, :OLD.PrmRt2, :OLD.PrmRt3, l_datenv,
                 :OLD.Idtpes, :OLD.NomFun, :OLD.NumPis, 1, l_numcpf);

  SP_PENDAce62('F', :OLD.NumCra, :OLD.NumFis, :OLD.TecCra, :OLD.VERPRM,
                    :OLD.CODPrm, :OLD.PrmSab, :OLD.PrmDom, :OLD.PrmFer,
                    :OLD.PrmRt1, :OLD.PrmRt2, :OLD.PrmRt3, l_datenv,
                    :OLD.Idtpes, :OLD.NomFun, :OLD.NumPis, 1, :OLD.TipCra,
                    0, 0, 0, 0,
                    0, 0, 0, l_numcpf);

  /* Realiza limpeza da CONTROLE (se ambiente híbrido). */
  SP_DELCONTROLE(:OLD.NUMFIS, :OLD.DATVAL);

END		SENIOR;21.␀␀



