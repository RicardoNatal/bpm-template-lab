WPROCEDURE SP_PORCOMDSP(p_Straux IN VARCHAR2, p_CenPen IN VARCHAR2)
IS
BEGIN
  NULL;
END		ORACLE;20
‹␀␀CREATE OR REPLACE PROCEDURE SP_PORCOMDSP(p_Straux IN VARCHAR2, p_CenPen IN VARCHAR2) IS
  l_retpen     CHAR(3);
  l_datenv     DATE;
  l_datenv_str CHAR(16);
  l_horenv     NUMBER(4);
  l_idtpes     VARCHAR2(23);
  l_numfis     NUMBER(12);
  l_dirsvr     VARCHAR2(250);
  l_codcmd     NUMBER(3);
  l_stacmd     NUMBER(1);
  l_seqenv     NUMBER(2);
  l_coddsp     NUMBER(9);
  l_tipope     NUMBER(1);
  l_dat_conv   VARCHAR(25);
  l_straux     VARCHAR2(2047);
  l_logpen     VARCHAR(2047);
  l_CenPen     VARCHAR2(255);
  l_codcen     NUMBER(2);
  l_aux        NUMBER(2);
  l_gersen     CHAR(1);
  l_cenati     CHAR(1);

  cursor c_r058cen2 is 
    SELECT 
      R058CEN.DIRSVR DIRSVR,R058CEN.GERSEN GERSEN,R058CEN.CENATI CENATI
       FROM R058CEN R058CEN
       WHERE GERSEN='S' 
      AND TIPGER=2;
  c_r058cen2_cnt integer;
  type t_r058cen is record (
    DIRSVR R058CEN.DIRSVR%TYPE,
    GERSEN R058CEN.GERSEN%TYPE,
	CENATI R058CEN.CENATI%TYPE
  );
  l_r058cen t_r058cen;
begin
  l_datenv := TO_DATE(TO_CHAR(SYSDATE, 'DD/MM/YYYY'), 'DD/MM/YYYY');
  l_horenv := TO_NUMBER(TO_CHAR(TO_DATE(TO_CHAR(SYSDATE, 'HH24:MI:SS'),
                                        'HH24:MI:SS'),
                                'HH24')) * 60 +
              TO_NUMBER(TO_CHAR(TO_DATE(TO_CHAR(SYSDATE, 'HH24:MI:SS'),
                                        'HH24:MI:SS'),
                                'MI'));
  l_seqenv := TO_NUMBER(TO_CHAR(TO_DATE(TO_CHAR(SYSDATE, 'HH24:MI:SS'),
                                        'HH24:MI:SS'),
                                'SS'));
  l_stacmd := 1;
  l_tipope := 0;
  l_retpen := '001';
  l_CodCmd := 162;

  begin
    l_idtpes := SUBSTR(p_Straux, 42, 23);
    l_numfis := SUBSTR(p_Straux, 29, 12);

    l_tipope     := SUBSTR(p_Straux, 28, 1);
    l_datenv_str := SUBSTR(p_Straux, 3, 16);
    l_dat_conv   := SUBSTR(l_datenv_str, 1, 2) || '/' ||
                    SUBSTR(l_datenv_str, 3, 2) || '/' ||
                    SUBSTR(l_datenv_str, 5, 2);
    SP_STRTODATE(l_dat_conv, 'DD/MM/AA', l_datenv);
    l_horenv := TO_NUMBER((SUBSTR(l_datenv_str, 7, 2))) * 60 +
                TO_NUMBER((SUBSTR(l_datenv_str, 9, 2)));

    if (l_tipope = 1) then
      if (l_seqenv > 2) then
        l_seqenv := l_seqenv - 3;
      else
        if (l_horenv > 0) then
          l_horenv := l_horenv - 1;
          l_seqenv := 57;
        else
          l_datenv := (l_datenv + -1);
          l_horenv := 1439;
          l_seqenv := 57;
        end if;
      end if;
    end if;
  exception
    when OTHERS then
      raise_application_error(-20000 + - (103),
                              'SP_PorComDSP: Problemas ao Formatar a Pendência.');
  end;

  l_CenPen := p_CenPen;
  l_CenPen := LTRIM(l_CenPen);
  l_CenPen := RTRIM(l_CenPen);
  l_straux := p_Straux;

  if (l_CenPen='0') then
    open c_r058cen2;
    begin
      fetch c_r058cen2 into l_r058cen.dirsvr,l_r058cen.gersen,l_r058cen.cenati;
      while (c_r058cen2%FOUND)
      loop
        if (l_r058cen.gersen='S') and (l_r058cen.cenati='S') then

          l_CodDsp := SUBSTR(l_straux, 19, 9);

          if (l_tipope<>3) then
            UPDATE R070DSP SET STACMD = 7 
            WHERE NUMFIS=l_numfis
			AND SUBSTR(VALSTR,42,23)=l_idtpes
            AND STACMD IN (0,1,5,8,9) 
            AND CODCMD=l_codcmd
            AND DIRSVR=l_r058cen.dirsvr
            AND CODDSP=l_CodDsp;
          else
            l_straux := SUBSTR(p_Straux,1,27)||'0'||SUBSTR(p_Straux,29,LENGTH(p_Straux)-28);
          end if;

          begin
            SP_RETLOGPEN(l_logpen);
            INSERT INTO R070DSP (CODPEN,DATENV,HORENV,DIRSVR,VALSTR,RETPEN,QTDTEN,CICATU,NUMFIS,CODCMD,STACMD,SEQENV,LOGPEN,CODDSP) VALUES  (SEQ_R070DSP.nextval,l_datenv,l_horenv,l_r058cen.dirsvr,l_straux,l_retpen,0,0,l_numfis,l_codcmd,l_stacmd,l_seqenv,l_logpen,l_CodDsp);
          exception
            when OTHERS then
              NULL;
            raise_application_error(-20000 + - (103), 'SP_PorComDSP: Erro na inserção da pendência na R070DSP Insert 1.');
          end;

        end if;
        fetch c_r058cen2 into l_r058cen.dirsvr,l_r058cen.gersen,l_r058cen.cenati;
      end loop;
    exception when others then
      close c_r058cen2;
      raise;
    end;
    close c_r058cen2;
  else
    loop
      begin
        l_aux := INSTR(l_cenpen,',',1);
        if (l_aux=0) then
          l_codcen := l_cenpen;
          l_cenpen := 'FIM';
        else
          l_codcen := SUBSTR(l_cenpen,1,1);
          l_cenpen := SUBSTR(l_cenpen,(l_aux+1),(LENGTH(l_cenpen)));
        end if;
      exception
        when OTHERS then
          raise_application_error(-20000 + -(103),'SP_PORCOM: Problemas ao Obter a Concentradora.');
      end;
      begin
        SELECT R058CEN.DIRSVR DIRSVR,R058CEN.GERSEN GERSEN,R058CEN.CENATI CENATI
        INTO l_dirsvr, l_gersen, l_cenati
        FROM R058CEN R058CEN
        WHERE CODCEN = l_codcen;
        if (l_gersen='S') and (l_cenati='S') then
        
          l_CodDsp := SUBSTR(l_straux,19,9);
          if (l_tipope<>3) then
            UPDATE R070DSP SET STACMD = 7  
            WHERE NUMFIS=l_numfis
			AND SUBSTR(VALSTR,42,23)=l_idtpes
            AND STACMD IN (0,1,5,8,9) 
            AND CODCMD=l_codcmd 
            AND DIRSVR=l_dirsvr 
            AND CODDSP=l_CodDsp;
          else
            l_straux := SUBSTR(p_Straux,1,27)||'0'||SUBSTR(p_Straux,29,LENGTH(p_Straux)-28);
          end if;

          begin
            SP_RETLOGPEN(l_logpen);
            INSERT INTO R070DSP (CODPEN,DATENV,HORENV,DIRSVR,VALSTR,RETPEN,QTDTEN,CICATU,NUMFIS,CODCMD,STACMD,SEQENV,LOGPEN,CODDSP) VALUES  (SEQ_R070DSP.nextval,l_datenv,l_horenv,l_dirsvr,l_straux,l_retpen,0,0,l_numfis,l_codcmd,l_stacmd,l_seqenv,l_logpen,l_CodDsp);
          exception
            when OTHERS then
              NULL;
            raise_application_error(-20000 + - (103), 'SP_PorComDSP: Erro na inserção da pendência na R070DSP Insert 1.');
          end;

        end if;
      exception
        when OTHERS then
          NULL;
      end;

      if (l_cenpen='FIM') then
        exit;
      end if;

    end loop;
  end if;
end;
