/* INSERT (NEW) */
TRIGGER R008EVB_EI AFTER INSERT ON R008EVB FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Eventos - Base de Cálculo (Tabela: R008EVB)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 101;     /* Eventos - Base de Cálculo (Tabela: R008EVB)*/
  l_codtpa := 345;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008EVB_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAB', CONVERT(NUMBER_TO_CHAR, :NEW.CODTAB));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CODEVE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSEQ', CONVERT(NUMBER_TO_CHAR, :NEW.CODSEQ));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R008EVB_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SINBAS', :NEW.SINBAS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPBAS', CONVERT(NUMBER_TO_CHAR, :NEW.TIPBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EVEBAS', CONVERT(NUMBER_TO_CHAR, :NEW.EVEBAS));
      END;
  END IF; 
END␀Ï␀␀	SENIOR;0L

TRIGGER R008EVB_SU AFTER UPDATE ON R008EVB

BEGIN
RH_250ALT(18);
END␀Ï␀␀		SENIOR;0	␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R008EVB_EU AFTER UPDATE ON R008EVB FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Eventos - Base de Cálculo (Tabela: R008EVB)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 101;     /* Eventos - Base de Cálculo (Tabela: R008EVB)*/
  l_codtpa := 346;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.CodTab <> :NEW.CodTab)
   OR (:OLD.CodEve <> :NEW.CodEve)
   OR (:OLD.CodSeq <> :NEW.CodSeq)
   OR (:OLD.SinBas <> :NEW.SinBas)
   OR (:OLD.TipBas <> :NEW.TipBas)
   OR (:OLD.EveBas <> :NEW.EveBas)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R008EVB_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAB', CONVERT(NUMBER_TO_CHAR, :OLD.CODTAB));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :OLD.CODEVE));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSEQ', CONVERT(NUMBER_TO_CHAR, :OLD.CODSEQ));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R008EVB_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSINBAS', :OLD.SINBAS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSINBAS', :NEW.SINBAS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPBAS', CONVERT(NUMBER_TO_CHAR, :OLD.TIPBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPBAS', CONVERT(NUMBER_TO_CHAR, :NEW.TIPBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDEVEBAS', CONVERT(NUMBER_TO_CHAR, :OLD.EVEBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWEVEBAS', CONVERT(NUMBER_TO_CHAR, :NEW.EVEBAS));
      END;
    END IF; 
  END IF; 
END␀Ï␀␀	SENIOR;0L

