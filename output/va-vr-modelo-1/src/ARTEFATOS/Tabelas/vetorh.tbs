TRIGGER R304CFP_ED BEFORE DELETE ON R304CFP FOR EACH ROW
DECLARE
	l_PidSta VARCHAR2(30);
	l_CountFOP NUMBER;
BEGIN
	BEGIN
		SELECT COUNT(*) INTO l_CountFOP 
	  	  FROM R304FOP 
	 	 WHERE NUMEMP = :OLD.NumEmp 
	   	   AND CODCOM = :OLD.CodCom 
	   	   AND ANOMES = :OLD.AnoMes;
	EXCEPTION 
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registros relacionados ao componente da folha de pagamento na tabela R304FOP.';
	END;		
	
	IF (l_CountFOP > 0) THEN
		RAISERROR 103 'Não é possível excluir o registro pois existem registros de provento/desconto do servidor (R304FOP) relacionados ao componente da folha de pagamento.';
	END IF;		
END␀␀␀*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀då␀␀…¬␀␀´␀	Ôÿ?ü␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀‚¬␀␀	Ôÿ?ü␀␀␀␀Ä±␀␀<¯␀␀\±␀␀%␀␀ÿ␀␀ÿ␀+§␀␀	Ôÿ␀␀␀␀␀ô©␀␀B©␀␀B©␀␀␀␀ÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀4¦␀␀p	Ôÿ␀␀␀␀␀f¦␀␀d¦␀␀e¦␀␀p␀Æÿ␀␀ÿ␀ü␀Ôÿ␀␀␀␀␀ç␀â␀æ␀␀␀␀ÿ␀␀ÿ␀#&Ôÿ␀␀␀␀␀]O]]␀␀␀ÿ␀␀ÿ␀ÚÒ␀Ôÿ/␀␀␀␀␀ììÿ␀ÿÿ␀␀ÿ␀5Â␀␀EÔÿ␀␀␀␀␀,Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀)+Ñ␀Ôÿ␀␀␀␀␀M&M&M&qC␀␀êÿ␀␀ÿ␀++Ñ␀Ôÿ␀␀␀␀␀U&U&U&qC␀␀êÿ␀␀ÿ␀,+Ç␀Ôÿ␀␀␀␀␀W&W&W&z␀Æÿ␀␀ÿ␀-+Ç␀Ôÿ␀␀␀␀␀Y&Y&Y&z␀Æÿ␀␀ÿ␀.+Ç␀Ôÿ␀␀␀␀␀[&[&[&z␀Æÿ␀␀ÿ␀/+Ç␀Ôÿ␀␀␀␀␀\&\&\&z␀Æÿ␀␀ÿ␀0+'Ôÿ␀␀␀␀␀]&]&]&D␀␀ÿ␀␀ÿ␀1+'Ôÿ␀␀␀␀␀^&^&^&D␀␀ÿ␀␀ÿ␀2+*Ôÿ␀␀␀␀␀_&_&_&,␀␀ÿ␀␀ÿ␀␀␀eå␀␀␀␀0;1;2;3hå␀␀	SENIOR;0␀␀

TRIGGER R304COD_SI AFTER INSERT ON R304COD
DECLARE
	CURSOR c_R304COD IS
	SELECT NUMEMP, NUMEDI, NOMARQ, SEQREG
	  FROM R304COD
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304COD IS RECORD (
		NUMEMP   R304COD.NumEmp%TYPE,
		NUMEDI   R304COD.NumEdi%TYPE,
		NOMARQ   R304COD.NomArq%TYPE,
		SEQREG   R304COD.SeqReg%TYPE
	);
    
    l_R304COD t_R304COD;
    l_PidSta VARCHAR2(30);
    l_MsgErr VARCHAR(255);
BEGIN
	FOREACH c_R304COD INTO l_R304COD.NumEmp, l_R304COD.NumEdi, l_R304COD.NomArq, l_R304COD.SeqReg
	LOOP
		/* Busca PID gravado no registro do Concurso/Processo Seletivo */
		BEGIN
			SELECT CON.PIDSTA INTO l_PidSta
			  FROM R304CON CON, R304STA STA
			 WHERE CON.PIDSTA = STA.PIDSTA
			   AND CON.NUMEMP = l_R304COD.NumEmp
			   AND CON.NUMEDI = l_R304COD.NumEdi
			   AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_MsgErr := 'Não existe registro de Concurso/Processo Seletivo pendente com a seguinte chave: ' || 
					'Empresa: ' || CONVERT(NUMBER_TO_CHAR, l_R304COD.NumEmp) || ', Edital: ' || l_R304COD.NumEdi || '.';
				RAISERROR 103 l_MsgErr;
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304CON.';
		END;
	
		BEGIN
			UPDATE R304COD
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304COD.NumEmp
			   AND NUMEDI = l_R304COD.NumEdi
			   AND NOMARQ = l_R304COD.NomArq
			   AND SEQREG = l_R304COD.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304COD.';
		END;
	END LOOP;
END␀få␀␀		SENIOR;0␀␀TRIGGER R304COD_EI BEFORE INSERT ON R304COD FOR EACH ROW
DECLARE
	l_SeqReg   R304COD.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR(255);
BEGIN
	/* Verifica se está tentando incluir um registro com sequência maior do que a última já cadastrada */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304COD
		 WHERE NUMEMP = :NEW.NumEmp
		   AND NUMEDI = :NEW.NumEdi
		   AND NOMARQ = :NEW.NomArq
		   AND SEQREG <> :NEW.SeqReg;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304COD.';
	END;
	
	IF (l_SeqReg > 0) THEN
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀gå␀␀		SENIOR;0ª␀␀

