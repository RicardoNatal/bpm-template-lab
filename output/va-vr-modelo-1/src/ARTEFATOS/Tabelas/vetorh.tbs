DECLARE
	l_layout VARCHAR2(6);
	l_TipoEsocial NUMBER;	
    l_basleg NUMBER(1);
    l_datnot DATE;
BEGIN
	/* eSocial */
	RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
	IF (l_layout IS NOT NULL) THEN
		RH_ANOTACAOESOCIAL(:NEW.TIPNOT, l_TipoEsocial OUT);
		
		/* verifica a base legal par controle de teletrabalho */
		BEGIN
		  SELECT BASLEG INTO l_basleg FROM R022NOT WHERE CODNOT = :NEW.TIPNOT;		     
		EXCEPTION
		    WHEN NO_DATA_FOUND THEN l_basleg := 1;
		END;
		l_datnot := :NEW.DATNOT;
		IF (l_basleg = 6) THEN
		    l_datnot := DATETIMEADD(DD, 1, l_datnot);
		END IF;

		IF (l_tipoEsocial <> 0) THEN   
			RH_PEN_ANOTACAO(l_layout, l_TipoEsocial, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_datnot, :NEW.SEQNOT, 'I', '', 'R038NOT_EI');
		END IF;   
	END IF;
	/*e-Social*/
END␀XÕ␀␀		SENIOR;0¡	␀␀

TRIGGER R038NOT_EU AFTER UPDATE ON R038NOT FOR EACH ROW
DECLARE
	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_layout VARCHAR2(6); 
	l_TipoEsocial NUMBER;
	l_JsonCamposAlterados VARCHAR2(2000);
	l_infoFacult BOOLEAN;
    l_SimplificaoESocial BOOLEAN;
    l_basleg NUMBER(1);
    l_datnot DATE;	
    l_VersaoESocial NUMBER;
BEGIN
	/* eSocial */
	l_Alterou := FALSE;
	l_JsonCamposAlterados := '';
	l_infoFacult := TRUE;
    l_SimplificaoESocial := FALSE;
    l_VersaoESocial := 0;

    SP_ESOCIAL_INFO(:NEW.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);

	SP_VALUPDATE_NUM(:OLD.TipNot, :NEW.TipNot, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		SP_CONCAT_NUM_JSON('TIPNOT', :NEW.TipNot, :OLD.TipNot, l_JsonCamposAlterados OUT);
	END IF;
	
	IF (l_SimplificaoESocial = TRUE) THEN
	    SP_VALUPDATE_NUM(:OLD.CodTce, :NEW.CodTce, l_Valido OUT);
	    IF (l_Valido = TRUE) THEN
		    l_Alterou := TRUE;
		    SP_CONCAT_NUM_JSON('CODTCE', :NEW.CodTce, :OLD.CodTce, l_JsonCamposAlterados OUT);
		END IF;
	END IF;

	SP_VALUPDATE_DES(:OLD.NotFic, :NEW.NotFic, l_Valido OUT);
	IF (l_Valido = TRUE) THEN
		l_Alterou := TRUE;
		l_JsonCamposAlterados := '{"NOTFIC":{"NEW":"Descrição do Histórico de Anotação Alterada.","OLD":"Descrição do Histórico de Anotação Alterada."}}';
	END IF;

	IF (l_Alterou = TRUE) THEN
		RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);

		IF (l_layout IS NOT NULL) THEN
			RH_ANOTACAOESOCIAL(:NEW.TIPNOT, l_TipoEsocial OUT);
			
			/* verifica a base legal par controle de teletrabalho */
			BEGIN
			  SELECT BASLEG INTO l_basleg FROM R022NOT WHERE CODNOT = :NEW.TIPNOT;		     
			EXCEPTION
			    WHEN NO_DATA_FOUND THEN l_basleg := 1;
			END;
			l_datnot := :NEW.DATNOT;
			IF (l_basleg = 6) THEN
			    l_datnot := DATETIMEADD(DD, 1, l_datnot);
			END IF;					 

			IF (l_TipoEsocial <> 0) THEN
				RH_PEN_ANOTACAO(l_layout, l_TipoEsocial, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_datnot, :NEW.SEQNOT, 'A', l_JsonCamposAlterados, 'R038NOT_EU');
			END IF;		

			IF (:OLD.TIPNOT <> :NEW.TIPNOT) THEN
				RH_ANOTACAOESOCIAL(:OLD.TIPNOT, l_TipoEsocial OUT);
					 
				IF (l_TipoEsocial <> 0) THEN
					RH_PEN_ANOTACAO(l_layout, l_TipoEsocial, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_datnot, :NEW.SEQNOT, 'A', l_JsonCamposAlterados, 'R038NOT_EU');
				END IF;
			END IF; 		
		END IF; 
	END IF;
	/* eSocial */
END␀VÕ␀␀		SENIOR;0|␀␀

TRIGGER R038NOT_ED AFTER DELETE ON R038NOT FOR EACH ROW
DECLARE
	l_layout VARCHAR2(6);
	l_TipoEsocial NUMBER;
    l_basleg NUMBER(1);
    l_datnot DATE;		
BEGIN
	/* eSocial */
	RH_LAYOUTCOLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layout OUT);
	IF (l_layout IS NOT NULL) THEN
		RH_ANOTACAOESOCIAL(:OLD.TIPNOT, l_TipoEsocial OUT);

    	/* verifica a base legal par controle de teletrabalho */
		BEGIN
		  SELECT BASLEG INTO l_basleg FROM R022NOT WHERE CODNOT = :OLD.TIPNOT;		     
		EXCEPTION
		    WHEN NO_DATA_FOUND THEN l_basleg := 1;
		END;
		l_datnot := :OLD.DATNOT;
		IF (l_basleg = 6) THEN
		    l_datnot := DATETIMEADD(DD, 1, l_datnot);
		END IF;		 

		IF (l_tipoEsocial <> 0) THEN
			RH_PEN_ANOTACAO(l_layout, l_TipoEsocial, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_datnot, :OLD.SEQNOT, 'E', '', 'R038NOT_ED');
		END IF; 
	END IF;
	/* eSocial */
