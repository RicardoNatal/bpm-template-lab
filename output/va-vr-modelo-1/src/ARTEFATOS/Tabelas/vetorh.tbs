PROCEDURE SP_PEND83(P_NUMCRA NUMBER(12),P_TIPOPE NUMBER(1),P_ORIBLO NUMBER(1),P_DESMOT VARCHAR2(30))
 IS

l_valstr     VARCHAR2(2047);
  l_numcra     NUMBER(12);
  l_craStr     CHAR(12);
  l_OpeStr     CHAR(1);
  l_BloStr     CHAR(1);
  l_TamMot     NUMBER(2);
  l_TamStr     CHAR(2);
  l_desMot     VARCHAR2(30);

  l_datatu     DATE;
  l_horatu     NUMBER(4);
  l_seqenv     NUMBER(2);
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datenv     CHAR(16);
  l_seqstr     CHAR(2);
BEGIN
  SP_INTSTR(p_numcra,'999999999999',l_craStr OUT);
  SP_INTSTR(p_tipOpe,'9'           ,l_opeStr OUT);
  SP_INTSTR(p_oriBlo,'9'           ,l_bloStr OUT);

  /* Calcula  data/hora de envio da pendência.*/
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  SP_DATSTR(l_datatu,'DDMMYY',l_datstr OUT);
  SP_INTSTR(l_horatu,'HHMM',l_horstr OUT);
  l_seqenv := SECOND(CURTIME());
  SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
  l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

  /* Operação EXCLUIR */
  IF  (p_tipOpe = 3) THEN
      l_valstr := '83' || l_datenv || l_craStr || l_OpeStr || l_BloStr ;
  ELSE
      /* Operação INSERIR/ALTERAR */
      l_desMot := RTrim(LTrim(p_desMot));
      l_TamMot := LENGTH(l_desMot);
      IF (l_TamMot IS NULL) OR (l_TamMot = 0) THEN
          l_valstr := '83' || l_datenv || l_craStr || l_OpeStr || l_BloStr || '00';
      ELSE
          SP_INTSTR(l_TamMot,'99' ,l_Tamstr OUT);
          l_valstr := '83' || l_datenv || l_craStr || l_OpeStr || l_BloStr || l_TamStr || l_desMot;
      END IF;
  END IF;

  BEGIN
      SP_PORCOM(l_valstr, '0');
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'SP_PEND83: Erro ao gerar pendência 83.';
  END;
END		SENIOR;21!SP_INTSTR
SP_DATSTR
SP_PORCOM
