DECLARE
l_data_zero    DATE;
  l_data_atual   DATE;
  l_online       BOOLEAN;

BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       IF   :NEW.STAACC = 1 THEN
            R070CRR_ATUCON('I',:NEW.TIPDOC,:NEW.NUMDOC,:NEW.INIFAI,:NEW.FIMFAI,:NEW.CREDIA);
       END IF;
  END IF;
END␀ÉÙ␀␀		SENIOR;0J␀␀

TRIGGER R070CRR_EU AFTER UPDATE ON R070CRR FOR EACH ROW

DECLARE
l_data_zero    DATE;
  l_data_atual   DATE;
  l_online       BOOLEAN;

BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       IF   :NEW.STAACC = 1 THEN
             R070CRR_ATUCON('A',:NEW.TIPDOC,:NEW.NUMDOC,:NEW.INIFAI,:NEW.FIMFAI,:NEW.CREDIA);
       ELSIF :NEW.STAACC = 2 THEN
            R070CRR_ATUCON('E',:NEW.TIPDOC,:NEW.NUMDOC,:NEW.INIFAI,:NEW.FIMFAI,:NEW.CREDIA);
       END IF;
  END IF;
