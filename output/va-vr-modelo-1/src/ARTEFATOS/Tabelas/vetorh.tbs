Æ␀␀

PROCEDURE R122CEX_ATUCON(P_NUMCAN NUMBER,P_NOMPES VARCHAR2(40),P_DDIFON VARCHAR2(3),P_DDDFON VARCHAR2(3),P_NUMFON VARCHAR2(20),P_NUMDOC VARCHAR2(20),P_USARFA CHAR)
 IS

  l_numcan       VARCHAR2(7);
  l_idtpes       VARCHAR2(23);
  l_ddifon       NUMBER;
  l_dddfon       NUMBER;
  l_usarfa       NUMBER(1);
BEGIN
  SP_INTSTR(p_numcan, '9999999', l_numcan OUT);
  l_idtpes:= '13'||l_numcan;

  /*Preenche o campo com espaços para completar 23 posições*/
  l_idtpes := lTrim(l_idtpes);
  l_idtpes := rTrim(l_idtpes);
  LOOP
	/*Controle do Loop.*/
	IF (Length(l_idtpes) > 22) THEN
	  EXIT;
    END IF;
	l_idtpes := ' '||l_idtpes;
  END LOOP;
  
  SP_STRTOINT(p_ddifon , l_ddifon OUT);
  SP_STRTOINT(p_dddfon , l_dddfon OUT);

  /* Assinala na tabela Controle que o Colab. de Outra Unidade utiliza reconhecimento facial */
  IF  p_usarfa = 'S' THEN
    l_usarfa := 1;
  ELSE
    l_usarfa := 0;
  END IF;

  BEGIN
	  UPDATE R070CON SET
			 NOMPES=p_nompes,DDIFON=l_ddifon,DDDFON=l_dddfon,NUMFON=p_numfon,QTDPRV=0,NUMDOC=p_numdoc,USARFA=l_usarfa
	  WHERE IDTPES = l_idtpes;
  EXCEPTION WHEN OTHERS THEN
	  RAISERROR 103 'R122CEX_ATUCON: Erro Na Atualização de R070CON 1.';
  END;
END		SENIOR;20SP_INTSTR
:␀␀

