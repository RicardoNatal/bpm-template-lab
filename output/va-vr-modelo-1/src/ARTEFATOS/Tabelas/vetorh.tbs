ˆ␀Æÿ␀␀ÿ␀5-·␀␀␀␀␀␀␀\A“␀“␀s␀Æÿ␀␀ÿ␀x-·␀␀␀␀␀␀␀(@¥.¥.u␀Æÿ␀␀ÿ␀[DÑ␀␀␀␀␀␀␀âLŞEŞEqC␀êÿ␀␀ÿ␀Fw·␀␀␀␀␀␀␀Àyxxì*␀␀Æÿ␀␀ÿ␀m,Ì␀␀␀␀␀␀␀N@¤:¤:{␀Æÿ␀␀ÿ␀…¬␀␀´␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀t␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀␀␀␀␀␀␀.%€$0.w␀Æÿ␀␀ÿ␀N␀Š␀␀␀␀␀␀␀˜␀˜␀˜␀n␀Æÿ␀␀ÿ␀~¬␀␀(␀␀␀␀␀␀L±␀␀L±␀␀L±␀␀1␀␀ÿ␀␀ÿ␀␀␀␀2␀␀£␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀zÚ␀␀7‹␀␀3	␀␀␀␀␀␀bŠ␀␀bŠ␀␀YŠ␀␀4␀␀ÿ␀␀ÿ␀EÑ␀	␀␀␀␀␀␀@J@J@JqCˆ␀êÿ␀␀ÿ␀mÁ␀␀=␀␀␀␀␀␀ô␀␀ô␀␀ô␀␀c␀␀␀ÿ␀␀ÿ␀×-Ì␀␀␀␀␀␀␀␀ÊB¤:¤:{␀Æÿ␀␀ÿ␀␀␀␀0;1|Ú␀␀		SENIOR;0±␀␀TRIGGER R070REA_EI AFTER INSERT ON R070REA FOR EACH ROW

DECLARE
l_Straux       VARCHAR2(2047);
  l_gersen       BOOLEAN;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_seqenv       NUMBER(2);
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_seqstr       CHAR(2);
  l_datenv       CHAR(16);
  l_idtPes       CHAR(23);
  l_datrev       CHAR(8);
  l_CenPen       VARCHAR2(255);

BEGIN
  /* verifica se existe alguma centralizadora gerenciada pela Senior */
  SP_GERSEN(l_gersen OUT);
  IF   (l_gersen = TRUE) THEN
      l_CenPen := '0';

      /*Obtem a data/hora de envio da pendência.*/
      l_data_atual := CURDATE();
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
      SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
      /*Obtem o Segundo*/
      l_seqenv := SECOND(CURTIME());
      SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
      l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

      l_idtpes := :NEW.IdtPes;
      SP_DATSTR(:NEW.DatRev,'DDMMYYYY',l_datrev OUT);

      l_StrAux := '61'||l_datenv||l_idtpes||l_datrev||'0';
      SP_PorCom(l_StrAux, l_CenPen);
  END IF;
END␀}Ú␀␀		SENIOR;0­␀␀

TRIGGER R070REA_EU AFTER UPDATE ON R070REA FOR EACH ROW

DECLARE
l_Straux       VARCHAR2(2047);
  l_gersen       BOOLEAN;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_seqenv       NUMBER(2);
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_seqstr       CHAR(2);
  l_datenv       CHAR(16);
  l_idtPes       CHAR(23);
  l_datrev       CHAR(8);
  l_CenPen       VARCHAR2(255);
  l_ope          CHAR(1);

BEGIN
  /* verifica se existe alguma centralizadora gerenciada pela Senior */
  SP_GERSEN(l_gersen OUT);
  IF   (l_gersen = TRUE) THEN
      l_CenPen := '0';
      l_ope := '1';

      /*Obtem a data/hora de envio da pendência.*/
      l_data_atual := CURDATE();
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
      SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
      /*Obtem o Segundo*/
      l_seqenv := SECOND(CURTIME());
      SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
      l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

      l_idtpes := :NEW.IdtPes;
      SP_DATSTR(:NEW.DatRev,'DDMMYYYY',l_datrev OUT);

      IF (:NEW.PESREV <> :OLD.PESREV) THEN

          IF (:NEW.PESREV = 'S') THEN
             l_ope := '0';
          ELSE
             l_ope := '2';
          END IF;   

      END IF;

      l_StrAux := '61'||l_datenv||l_idtpes||l_datrev||l_ope;
      SP_PorCom(l_StrAux, l_CenPen);
  END IF;
END␀{Ú␀␀		SENIOR;0µ␀␀

TRIGGER R070REA_ED AFTER DELETE ON R070REA FOR EACH ROW

DECLARE
l_Straux       VARCHAR2(2047);
  l_gersen       BOOLEAN;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
