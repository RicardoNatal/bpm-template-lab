				END IF;
		
		
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								l_prmSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.CODPRM);
								l_prmSTR := LTRIM(l_prmSTR);
								l_prmSTR := RTRIM(l_prmSTR);
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPRM', l_prmSTR);
						EXCEPTION
