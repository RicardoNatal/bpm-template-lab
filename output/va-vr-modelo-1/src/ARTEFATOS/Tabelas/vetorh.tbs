          VALUES (:NEW.TIPCOL,:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATINI);
      EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro no INSERT em R064THR_AUX.';
      END;
