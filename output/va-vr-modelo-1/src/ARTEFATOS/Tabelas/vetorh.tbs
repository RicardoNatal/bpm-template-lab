				END IF;
				IF (l_r034EDP.CONPAC = 2) THEN /* VALOR VEM DO POSTO ADICIONAL. RESTAURO O VALOR DO POSTO PRINCIPAL. */
					l_r034DAC.CONPAC := l_r017DAC.CONPAC;
					l_r034EDP.CONPAC := 1;
				END IF;
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONPAC', l_r034DAC.CONPAC);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (NEWCONPAC)';
						END;
				END IF;
				
		
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								l_TemPacSTR := CONVERT(NUMBER_TO_CHAR,l_r034DAC.TEMPAC);
								l_TemPacSTR := LTRIM(l_TemPacSTR);
								l_TemPacSTR := RTRIM(l_TemPacSTR);
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTEMPAC', l_TemPacSTR);
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTEMPAC', l_TemPacSTR);
						EXCEPTION
								WHEN OTHERS THEN RAISERROR 103 'SP_GESPER: Erro inserir campo detalhe log auditoria. (OLDTEMPAC)';
						END;
				END IF;
				
				
				IF (l_temAud34DAC > 0) THEN
						BEGIN
								SP_INTSTR(l_r034DAC.TOLACP,'HH:MM'        ,l_TolAcpSTR OUT);
								INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTOLACP', l_TolAcpSTR);
