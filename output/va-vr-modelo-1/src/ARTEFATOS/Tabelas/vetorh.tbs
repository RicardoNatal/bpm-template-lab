  BEGIN
    /* Busca a outra empresa padrão definido nos assinalamentos diversos - R000ASS */
    SELECT IFNULL(ENTDEF, 0) INTO l_EmpresaPadrao FROM R000ASS;
  EXCEPTION 
    WHEN NO_DATA_FOUND THEN	
      l_EmpresaPadrao := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R000ASS';
  END;

  BEGIN
    /* Busca a outra empresa padrão para empregos anteriores definida nas Definições Gerais do RS - R126DEF */
    SELECT IFNULL(OEMDEF, 0) INTO l_OemDef FROM R126DEF;
  EXCEPTION 
    WHEN NO_DATA_FOUND THEN	
      l_OemDef := 0; 
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R126DEF';
  END;


  /* Se NÃO é a Outra empresa Padrão E efetuou alteração no Nome da Outra empresa deve Atualizar    */
  /* o Nome do Curso na tabela R122CCF, R124HCF, R033HFO e R033HAP  */
  IF (l_EmpresaPadrao <> :NEW.CODOEM) AND
     (:OLD.NOMOEM <> :NEW.NOMOEM) THEN

    /* Utilizada tabela _AUX para controle, pois os UPDATES abaixo disparam triggers
       que fazem SELECT para o mesmo registro da tabela R032OEM e isso gera erro.
       A _AUX irá servir como flag de controle, indicando que o update foi chamado
       via trigger r032oem e sendo assim, não é precisa executar as rotinas das
       demais triggers.                                                              */
    BEGIN
      INSERT INTO R032OEM_AUX (CODOEM)
                       VALUES (:NEW.CODOEM);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao inserir na R032OEM_AUX';
    END;

    BEGIN
      UPDATE R122CCF
         SET NOMOEM = :NEW.NOMOEM
       WHERE CODOEM = :NEW.CODOEM;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar a tabela R122CCF';
    END;

    BEGIN
      UPDATE R124HCF
         SET NOMOEM = :NEW.NOMOEM
       WHERE CODOEM = :NEW.CODOEM;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar a tabela R124HCF';
    END;

    BEGIN
      UPDATE R122CCR
         SET NOMOEM = :NEW.NOMOEM
       WHERE CODOEM = :NEW.CODOEM;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar a tabela R122CCR';
    END;

    BEGIN
      UPDATE R124HCR
         SET NOMOEM = :NEW.NOMOEM
       WHERE CODOEM = :NEW.CODOEM;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar a tabela R124HCR';
    END;

    BEGIN
      UPDATE R033HAP
         SET NOMOEM = :NEW.NOMOEM
       WHERE CODOEM = :NEW.CODOEM;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar a tabela R033HAP';
    END;

    BEGIN
      UPDATE R033HFO
         SET NOMOEM = :NEW.NOMOEM
       WHERE CODOEM = :NEW.CODOEM;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar a tabela R033HFO';
    END;

    BEGIN
      DELETE FROM R032OEM_AUX;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao excluir R032OEM_AUX';
    END;
  END IF;

  /* Se NÃO é a Outra empresa Padrão para Empregos Anteriores E efetuou alteração no Nome da Outra empresa deve Atualizar    */
  /* o Nome do Curso na tabela R122CEA e R124HEA  */
  IF (l_OemDef <> :NEW.CODOEM) AND
     (:OLD.NOMOEM <> :NEW.NOMOEM) THEN

    /* Utilizada tabela _AUX para controle, pois os UPDATES abaixo disparam triggers
       que fazem SELECT para o mesmo registro da tabela R032OEM e isso gera erro.
       A _AUX irá servir como flag de controle, indicando que o update foi chamado
       via trigger r032oem e sendo assim, não é precisa executar as rotinas das
       demais triggers.                                                              */
    BEGIN
      INSERT INTO R032OEM_AUX (CODOEM)
                       VALUES (:NEW.CODOEM);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao inserir na R032OEM_AUX';
    END;

    BEGIN
      UPDATE R122CEA
         SET NOMOEM = :NEW.NOMOEM
       WHERE CODOEM = :NEW.CODOEM;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar a tabela R122CEA';
    END;

    BEGIN
      UPDATE R124HEA
         SET NOMOEM = :NEW.NOMOEM
       WHERE CODOEM = :NEW.CODOEM;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar a tabela R124HEA';
    END;

    BEGIN
      DELETE FROM R032OEM_AUX;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao excluir R032OEM_AUX';
    END;

  END IF;

  /* Pendência SAMSenior */
  IF (:NEW.NOMOEM <> :OLD.NOMOEM) THEN
    SP_INTSTR(:OLD.CODOEM, '99999999', l_codoem_str OUT);
    l_valstr := 'E' || l_codoem_str || :OLD.NOMOEM;
    SP_SAM_PENDENCIES(36, 2, l_valstr);
  END IF;

  /* Tabela temporária */
  DROP_TEMP_TABLE R032OEM_AUX;

  /* Pendência GT - Empresa Terceira */
  l_alterou := FALSE;

  IF (:NEW.NOMOEM <> :OLD.NOMOEM) THEN
    l_alterou := TRUE;
  END IF;

  IF (:NEW.APEOEM <> :OLD.APEOEM) THEN
    l_alterou := TRUE;
  END IF;

  IF (:NEW.NUMCGC <> :OLD.NUMCGC) THEN
    l_alterou := TRUE;
  END IF;

  IF (:NEW.INSEST <> :OLD.INSEST) THEN
    l_alterou := TRUE;
  END IF;

  IF (:NEW.DDDTEL <> :OLD.DDDTEL) THEN
    l_alterou := TRUE;
  END IF;

  IF (:NEW.NUMTEL <> :OLD.NUMTEL) THEN
    l_alterou := TRUE;
  END IF;

  IF (:NEW.EMAEMP <> :OLD.EMAEMP) THEN
    l_alterou := TRUE;
  END IF;

  IF (:NEW.ENDOEM <> :OLD.ENDOEM) THEN
    l_alterou := TRUE;
  END IF;

  IF (:NEW.ENDNUM <> :OLD.ENDNUM) THEN
    l_alterou := TRUE;
  END IF;

  IF (:NEW.ENDCPL <> :OLD.ENDCPL) THEN
    l_alterou := TRUE;
  END IF;

  IF (:NEW.CODPAI <> :OLD.CODPAI) THEN
    l_alterou := TRUE;
  END IF;

  IF (:NEW.CODEST <> :OLD.CODEST) THEN
    l_alterou := TRUE;
  END IF;

  IF (:NEW.CODCID <> :OLD.CODCID) THEN
    l_alterou := TRUE;
  END IF;

  IF (:NEW.CODBAI <> :OLD.CODBAI) THEN
    l_alterou := TRUE;
  END IF;

  IF (:NEW.CODCEP <> :OLD.CODCEP) THEN
    l_alterou := TRUE;
  END IF;

  IF (l_alterou = TRUE) THEN
    SP_INTSTR(:NEW.CODOEM, '99999999', l_codoem_str OUT);
    SP_SAM_PENDENCIES(43, 2, l_codoem_str);
  END IF;
END␀×Ò␀␀		SENIOR;0u%␀␀

TRIGGER R032OEM_EBU BEFORE UPDATE ON R032OEM FOR EACH ROW

DECLARE
  l_Valor            VARCHAR2(2000);
  l_Valido           BOOLEAN;
  l_AlterouRegistro_S1000  BOOLEAN;
  l_AlterouRegistro_S1005  BOOLEAN;
  l_AlterouRegistro_S1020  BOOLEAN;
  l_AlterouRegistro_S2300  BOOLEAN;
  l_AlterouFim             BOOLEAN;
  l_EmpresaNaR030SOF  NUMBER;
  l_ExisteEmpregadorEsocial NUMBER;
  l_NumEmp NUMBER;
  l_CodFil NUMBER;
  l_TipFil VARCHAR(1);
  l_DatAlt DATE;
  l_ProximaData DATE;
  l_Where VARCHAR(2000);
  l_EmpresaStr VARCHAR(11);
  l_FilialStr VARCHAR(11);
  l_TipCol NUMBER(1);
  l_NumCad NUMBER(9);
  l_JsonCamposAlterados VARCHAR2(2000);
  l_layoutInicialContrato VARCHAR2(6);
  l_DataAlteracao   DATE;
  l_layoutEnviado   BOOLEAN;
  l_layout VARCHAR2(6);
  l_infoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_gerarPendencia BOOLEAN; 
  l_VersaoESocial NUMBER;
  
  CURSOR c_r030sof IS
  SELECT NUMEMP
    FROM R030SOF
   WHERE CODOEM = :NEW.CODOEM;

  CURSOR c_r030emp IS
  SELECT NUMEMP
  FROM R030EMP;
  
  CURSOR c_r030eed IS
  SELECT NUMEMP, CODFIL, DATALT
  FROM R030EED EED
  WHERE CODOEM = :NEW.CODOEM;
  
  CURSOR c_r030fil IS
  SELECT NUMEMP, CODFIL, TIPFIL
  FROM R030FIL EED
  WHERE CODOEM = :NEW.CODOEM;

  CURSOR c_r034etg IS
  SELECT NUMEMP, TIPCOL, NUMCAD
  FROM R034ETG 
  WHERE INSENS = :NEW.CODOEM;
BEGIN
  /*e-Social -> S-1000, S-1005 e S-1020*/
  l_Valor := '';
  l_AlterouRegistro_S1000 := FALSE;
  l_AlterouRegistro_S1005 := FALSE;
  l_AlterouRegistro_S1020 := FALSE;
  l_AlterouFim            := FALSE;
  l_AlterouRegistro_S2300 := FALSE;
  l_JsonCamposAlterados     := '';
  l_layoutInicialContrato := '';
  l_layoutEnviado := FALSE;
  l_layout := '';
  l_gerarPendencia := TRUE;
  l_infoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;
  
  SP_ESOCIAL_INFO(l_NumEmp, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
   
  SP_VALUPDATE_DES(:OLD.EMAEMP, :NEW.EMAEMP, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1000 := TRUE;
  END IF;
 
  SP_VALUPDATE_NUM(:OLD.DDDTEL, :NEW.DDDTEL, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1000 := TRUE;
  END IF;

  SP_VALUPDATE_DES(:OLD.NUMTEL, :NEW.NUMTEL, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1000 := TRUE;
  END IF;

  SP_VALUPDATE_DES(:OLD.NOMOEM, :NEW.NOMOEM, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1000 := TRUE;
  END IF;
   
  SP_VALUPDATE_NUM(:OLD.NUMCGC, :NEW.NUMCGC, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1000 := TRUE;
    l_AlterouRegistro_S1005 := TRUE;
    l_AlterouRegistro_S1020 := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.TIPINS, :NEW.TIPINS, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1020 := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.TINPRO, :NEW.TINPRO, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1020 := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.INSPRO, :NEW.INSPRO, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1020 := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.TINCON, :NEW.TINCON, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1020 := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.INSCON, :NEW.INSCON, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S1020 := TRUE;
  END IF;
  
  SP_VALUPDATE_DAT(:OLD.FIMVAL, :NEW.FIMVAL, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouFim := TRUE;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.NUMCGC, :NEW.NUMCGC, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_AlterouRegistro_S2300 := TRUE;
    SP_CONCAT_NUM_JSON('NUMCGC', :NEW.NUMCGC, :OLD.NUMCGC, l_JsonCamposAlterados OUT);
  END IF;
  
  IF ((l_SimplificaoESocial = FALSE) OR (l_SimplificaoESocial = TRUE AND :OLD.NUMCGC = 0 AND :NEW.NUMCGC = 0)) THEN
  	SP_VALUPDATE_DES(:OLD.CODEST, :NEW.CODEST, l_Valido OUT);
  	IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S2300 := TRUE;
      SP_CONCAT_DES_JSON('CODEST', :NEW.CODEST, :OLD.CODEST, l_JsonCamposAlterados OUT);
  	END IF;
  
  	SP_VALUPDATE_NUM(:OLD.CODCID, :NEW.CODCID, l_Valido OUT);
  	IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S2300 := TRUE;
      SP_CONCAT_NUM_JSON('CODCID', :NEW.CODCID, :OLD.CODCID, l_JsonCamposAlterados OUT);
  	END IF;
  
  	SP_VALUPDATE_NUM(:OLD.CODCEP, :NEW.CODCEP, l_Valido OUT);
  	IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S2300 := TRUE;
      SP_CONCAT_NUM_JSON('CODCEP', :NEW.CODCEP, :OLD.CODCEP, l_JsonCamposAlterados OUT);
  	END IF;
  
  	SP_VALUPDATE_NUM(:OLD.CODBAI, :NEW.CODBAI, l_Valido OUT);
  	IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S2300 := TRUE;
      SP_CONCAT_NUM_JSON('CODBAI', :NEW.CODBAI, :OLD.CODBAI, l_JsonCamposAlterados OUT);
  	END IF;
  
  	SP_VALUPDATE_DES(:OLD.ENDOEM, :NEW.ENDOEM, l_Valido OUT);
  	IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S2300 := TRUE;
      SP_CONCAT_DES_JSON('ENDOEM', :NEW.ENDOEM, :OLD.ENDOEM, l_JsonCamposAlterados OUT);
  	END IF;
  
    SP_VALUPDATE_DES(:OLD.ENDNUM, :NEW.ENDNUM, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S2300 := TRUE;
      SP_CONCAT_DES_JSON('ENDNUM', :NEW.ENDNUM, :OLD.ENDNUM, l_JsonCamposAlterados OUT);
    END IF;
  
  	SP_VALUPDATE_DES(:OLD.NOMOEM, :NEW.NOMOEM, l_Valido OUT);
  	IF (l_Valido = TRUE) THEN
      l_AlterouRegistro_S2300 := TRUE;
      SP_CONCAT_DES_JSON('NOMOEM', :NEW.NOMOEM, :OLD.NOMOEM, l_JsonCamposAlterados OUT);
  	END IF;
  END IF;
  
  IF (l_AlterouRegistro_S1000 = TRUE) THEN
    /* Validação: Somente Filial Tipo Empregador eSocial ou Matriz ou Domestica e informada na tabela R030Sof
       OBS.: Tipo Matriz e Domestica somente se não existir filial do tipo Empregador eSocial */
    FOREACH c_r030sof INTO l_EmpresaNaR030SOF
    LOOP
      SP_CONCATENAR_NUM('CODOEM', :NEW.CODOEM, l_Valor OUT);

      /* Envia Leiaute S-1000 */
      SP_E_SOCIAL('S-1000', 'R032OEM', 'T', 'A', NULL, NULL, l_EmpresaNaR030SOF, 0, 0,  l_Valor, '', 0, NULL, NULL, 0, 'R032OEM_EBU');
    END LOOP;
  END IF;
  
  IF (l_AlterouRegistro_S2300 = TRUE) THEN       
    FOREACH c_r034etg INTO l_NumEmp, l_TipCol, l_NumCad
    LOOP
      RH_LAYOUTCOLAB(l_NumEmp, l_TipCol, l_NumCad, l_layoutInicialContrato OUT);
      IF (l_layoutInicialContrato IS NOT NULL) THEN
        N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
        IF (l_gerarPendencia = TRUE) THEN 
      	  RH_LAYOUT_ENVIADO(l_NumEmp, l_TipCol, l_NumCad, l_layoutInicialContrato, l_layout OUT);
      	  l_DataAlteracao := CURDATE();
      	  IF (l_layout IS NOT NULL) THEN  /*Se não voltou com informação então é porque não tem 2300 ou 2200 enviado, tem a pendencia mas não enviou*/      	
             SP_TAB_ESOCIAL(l_layout, l_NumEmp, l_TipCol, l_NumCad, l_DataAlteracao, l_ProximaData, 'R032OEM', 'A' , '', l_JsonCamposAlterados, 0, 'R032OEM_EBU');
      	  ELSE
      	     SP_TAB_ESOCIAL(l_layoutInicialContrato, l_NumEmp, l_TipCol, l_NumCad, l_DataAlteracao, l_ProximaData, 'R032OEM', 'A' , '', l_JsonCamposAlterados, 0, 'R032OEM_EBU');
      	  END IF;	
        END IF;	  
      END IF;
    END LOOP;
  END IF;

  IF (l_AlterouRegistro_S1020 = TRUE) THEN
    l_Valor := '';
    SP_CONCATENAR_NUM('CODOEM', :NEW.CODOEM, l_Valor OUT);

    FOREACH c_r030emp INTO l_NumEmp
    LOOP
      /* Envia Leiaute S-1020 */
      IF (l_AlterouRegistro_S1020 = TRUE) THEN
      	SP_E_SOCIAL('S-1020', 'R032OEM', 'T', 'A', NULL, NULL, l_NumEmp, 0, 0,  l_Valor, '', 0,  NULL, NULL, 0, 'R032OEM_EBU');
      END IF;
    END LOOP;
  END IF;
  
  IF (l_AlterouRegistro_S1005 = TRUE) THEN
    FOREACH c_r030eed INTO l_NumEmp, l_CodFil, l_DatAlt
    LOOP
      /* Envia Leiaute S-1005 */
      l_Valor := '';
      SP_CONCATENAR_NUM('CODOEM', :NEW.CODOEM, l_Valor OUT);
      SP_CONCATENAR_NUM('CODFIL', l_CodFil, l_Valor OUT);
      
      l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, l_NumEmp);
	  l_FilialStr := CONVERT(NUMBER_TO_CHAR, l_CodFil);
      
      l_Where := 'NUMEMP = ' || l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr;
	  SP_PROXIMOHIST('DATALT', 'R030EED', l_Where, l_DatAlt, l_ProximaData OUT);
      
      SP_E_SOCIAL('S-1005', 'R032OEM', 'T', 'A', l_DatAlt, l_ProximaData, l_NumEmp, 0, 0,  l_Valor, '', 0, NULL, NULL, 0, 'R032OEM_EBU');
    END LOOP;
  END IF;
  
  IF (l_AlterouFim = TRUE) THEN
  	FOREACH c_r030fil INTO l_NumEmp, l_CodFil, l_TipFil
    LOOP      
      /* Cria pendência S-1005 e S-1080 */
      l_Valor := '';
      SP_CONCATENAR_NUM('CODFIL', l_CodFil, l_Valor OUT);
      SP_CONCATENAR_DES('TIPFIL', l_TipFil, l_Valor OUT);
      
      l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, l_NumEmp);
	  l_FilialStr := CONVERT(NUMBER_TO_CHAR, l_CodFil);
            
      SP_E_SOCIAL('S-1005', 'R032OEM', 'T', 'A', :NEW.FIMVAL, :NEW.FIMVAL, l_NumEmp, 0, 0,  l_Valor, '', 0, :NEW.FIMVAL, NULL, 0, 'R032OEM_EBU');
      IF (l_SimplificaoESocial = FALSE) THEN
      	SP_E_SOCIAL('S-1080', 'R032OEM', 'T', 'A', :NEW.FIMVAL, :NEW.FIMVAL, l_NumEmp, 0, 0,  l_Valor, '', 0, :NEW.FIMVAL, NULL, 0, 'R032OEM_EBU');
      END IF;
    END LOOP;
    
    l_Valor := '';
    SP_CONCATENAR_NUM('CODOEM', :NEW.CODOEM, l_Valor OUT);
    
    FOREACH c_r030emp INTO l_NumEmp
    LOOP
      SP_E_SOCIAL('S-1020', 'R032OEM', 'T', 'A', :NEW.FIMVAL, :NEW.FIMVAL, l_NumEmp, 0, 0,  l_Valor, '', 0, :NEW.FIMVAL, NULL, 0, 'R032OEM_EBU');
    END LOOP;
    
  END IF;
END␀ØÒ␀␀		SENIOR;0ü

TRIGGER R032OEM_ED AFTER DELETE ON R032OEM FOR EACH ROW

DECLARE
  l_codoem_str VARCHAR2(8);
BEGIN
  /* Pendência GT - Empresa Terceira */
  SP_INTSTR(:OLD.CODOEM, '99999999', l_codoem_str OUT);
  SP_SAM_PENDENCIES(43, 3, l_codoem_str);
