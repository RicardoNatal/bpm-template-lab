      END
      IF (@l_online=1)
      BEGIN
        EXECUTE  @ChkError = R090VIS_ATUCON @NEW_TIPDOC,@NEW_NUMDOC,@NEW_CODPRM 
        IF @ChkError <> 0
        BEGIN
          CLOSE CUR_r090vis_UPD_OLD
          DEALLOCATE CUR_r090vis_UPD_OLD
          CLOSE CUR_r090vis_UPD_NEW
          DEALLOCATE CUR_r090vis_UPD_NEW
          GOTO FIM
        END
      END
    END
    IF (@OLD_SEGTDO<>@NEW_SEGTDO) 
      OR (@OLD_SEGDOC<>@OLD_SEGDOC)
    BEGIN
      SELECT @l_numdoc = @NEW_NUMDOC
      SELECT @l_tippes = '04'
      EXECUTE  @ChkError = SP_INTSTR @NEW_TIPDOC,'9',@l_tipdoc OUTPUT  
      IF @ChkError <> 0
      BEGIN
        CLOSE CUR_r090vis_UPD_OLD
        DEALLOCATE CUR_r090vis_UPD_OLD
        CLOSE CUR_r090vis_UPD_NEW
        DEALLOCATE CUR_r090vis_UPD_NEW
        GOTO FIM
      END
      SELECT @l_idtpes = @l_tippes+@l_tipdoc+@l_numdoc
      SELECT @l_idtpes = LTRIM(@l_idtpes)
      SELECT @l_idtpes = RTRIM(@l_idtpes)
      WHILE 1=1
      BEGIN
        IF (DATALENGTH(@l_idtpes)>22)
        BEGIN
          BREAK
        END
        SELECT @l_idtpes = ' '+@l_idtpes
      END
      SELECT @l_tipdoccon = 0
      SELECT @l_numdoccon = '0'
      SELECT @l_segtdo = @NEW_SEGTDO
      SELECT @l_segdoc = @NEW_SEGDOC
      IF (@l_tipdoc='2')
      BEGIN
        SELECT @l_tipdoccon = 2
        SELECT @l_numdoccon = @l_numdoc
      END
      ELSE
      BEGIN
        IF (@l_segtdo=2)
        BEGIN
          SELECT @l_tipdoccon = 2
          SELECT @l_numdoccon = @l_segdoc
        END
        ELSE
        BEGIN
          IF ((@l_tipdoc='7') 
      OR (@l_tipdoc='4' 
      AND @l_segtdo<>7))
          BEGIN
            SELECT @l_tipdoccon = 4
            SELECT @l_numdoccon = @l_numdoc
          END
          ELSE
          BEGIN
            IF (@l_segtdo=7 
      OR @l_segtdo=4)
            BEGIN
              SELECT @l_tipdoccon = 4
              SELECT @l_numdoccon = @l_segdoc
            END
          END
        END
      END
      UPDATE r070con SET 
      tipdoc=@l_tipdoccon,numdoc=@l_numdoccon 
       WHERE idtpes=@l_idtpes
      SELECT @ChkError = @@Error
      IF @ChkError <> 0
      BEGIN
        CLOSE CUR_r090vis_UPD_OLD
        DEALLOCATE CUR_r090vis_UPD_OLD
        CLOSE CUR_r090vis_UPD_NEW
        DEALLOCATE CUR_r090vis_UPD_NEW
        GOTO FIM
      END
    END
    IF (@OLD_NOMVIS<>@NEW_NOMVIS) 
      OR (@OLD_DDITEL<>@NEW_DDITEL) 
      OR (@OLD_DDDTEL<>@NEW_DDDTEL) 
      OR (@OLD_TELCON<>@NEW_TELCON)
    BEGIN
      EXECUTE  @ChkError = SP_VerOnLine @l_online OUTPUT  
      IF @ChkError <> 0
      BEGIN
        CLOSE CUR_r090vis_UPD_OLD
        DEALLOCATE CUR_r090vis_UPD_OLD
        CLOSE CUR_r090vis_UPD_NEW
        DEALLOCATE CUR_r090vis_UPD_NEW
        GOTO FIM
      END
      IF (@l_online=1)
      BEGIN
        SELECT @l_numdoc = @NEW_NUMDOC
        SELECT @l_tippes = '04'
        EXECUTE  @ChkError = SP_INTSTR @NEW_TIPDOC,'9',@l_tipdoc OUTPUT  
        IF @ChkError <> 0
        BEGIN
          CLOSE CUR_r090vis_UPD_OLD
          DEALLOCATE CUR_r090vis_UPD_OLD
          CLOSE CUR_r090vis_UPD_NEW
          DEALLOCATE CUR_r090vis_UPD_NEW
