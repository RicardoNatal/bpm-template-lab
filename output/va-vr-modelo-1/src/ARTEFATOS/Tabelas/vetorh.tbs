%␀␀PROCEDURE SP_REPFUN(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_NOMFUN OUT VARCHAR2(40),P_NUMPIS OUT NUMBER(11))
 IS

l_verrpo       BOOLEAN;
BEGIN
    /* Só retorna nome e PIS para colaboradores 1 (empregados) ou 2 (terceiros) */
    IF ((p_tipcol = 1) OR (p_tipcol = 2)) THEN
        BEGIN
            SELECT F.NOMFUN, F.NUMPIS
            INTO p_nomfun, p_numpis
            FROM R034FUN F, R034DAC D
            WHERE F.NUMEMP = p_numemp
            AND F.TIPCOL = p_tipcol
            AND F.NUMCAD = p_numcad
            AND F.NUMEMP = D.NUMEMP
            AND F.TIPCOL = D.TIPCOL
            AND F.NUMCAD = D.NUMCAD
            AND D.REPONL = 'S';
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                 p_nomfun := '';
                 p_numpis := 0;
              WHEN OTHERS THEN RAISERROR 103 'SPREPFUN: Erro no SELECT em R034FUN.';
        END;
    ELSE
        /* Retorna Nome e PIS em branco para TipCol diferente de 1 ou 2*/
        p_nomfun := '';
        p_numpis := 0;
    END IF;
END␀ªø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0,SP_USUTEL
SP_SELTSI
SP_INTSTR
SP_CMDTSI
®␀␀PROCEDURE SP_REPGRPFTsi (P_TIPOPE VARCHAR2(1), P_NUMCRA NUMBER(12), P_CODPRM NUMBER(5))
IS

  l_nodatafound         BOOLEAN;
  l_count               NUMBER(1);

  l_usutel              VARCHAR2(31);
  l_utiaut              CHAR(1);
  l_numcra              CHAR(12);
  l_codprm              CHAR(3);
  l_codprm_5            CHAR(5);  

  l_comando             VARCHAR2(2048);
  l_retstraux           VARCHAR2(2048);
  l_retnumberaux        NUMBER;
  l_reterr              NUMBER(1);
  
  l_ediprm              CHAR(5);
  l_newprm              BOOLEAN;
  
BEGIN
  SP_USUTEL(l_usutel OUT);
  
  /* verifica o tamanho do campo de permissão das tabelas da Telemática (GRUPO) */
  l_ediprm := '999';
  BEGIN
      SELECT EDIPRM INTO l_ediprm FROM R000ASS;
      IF (l_ediprm = '99999') THEN
          l_newprm := TRUE;
      ELSE
          l_newprm := FALSE;
      END IF;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'SP_REPGRPFTsi: Não conseguiu obter a máscara da permissão R000ASS.EDIPRM.';
  END;  
  
  /* verifica definição se a tabela existe */
  BEGIN
      SELECT utiAut INTO l_utiaut FROM R070TSI;
  EXCEPTION
      WHEN OTHERS THEN l_utiaut := 'N';
  END;

  IF l_utiaut = 'S' THEN
    SP_INTSTR(p_numcra,'999999999999',l_numcra OUT);

    IF (P_TIPOPE = 'D') OR (P_TIPOPE = 'F') THEN
      l_comando := 'DELETE FROM '|| l_usutel ||'REPGRPF WHERE IFUNC = ''' || l_numcra || '''';
      SP_CMDTSI(l_comando);
    ELSE
      l_nodatafound := FALSE;
      BEGIN
        l_comando := 'SELECT COUNT(*) FROM ' || l_usutel || 'REPGRPF WHERE IFUNC = ''' || l_numcra || '''';
        SP_SELTSI(0, 'QNTREG', l_comando, l_retnumberaux OUT, l_retstraux OUT, l_reterr OUT);
        IF (l_reterr = 1) THEN /*NO_DATA_FOUND*/
          l_nodatafound := TRUE;
        END IF;
        IF (l_reterr = 2) THEN /*TOO_MANY_ROWS*/
          l_nodatafound := TRUE; 
        END IF;

        IF (l_reterr = 0) THEN
          l_count := l_retnumberaux;
        ELSE
          l_count := 0;
        END IF;
      EXCEPTION
        WHEN OTHERS THEN
          l_nodatafound := FALSE;
      END;

      BEGIN
       
	    IF (l_newprm = TRUE) THEN
	        SP_INTSTR(P_CODPRM, '99999', l_codprm_5 OUT);
	    ELSE
	        SP_INTSTR(P_CODPRM, '999', l_codprm OUT);
	    END IF;        

        IF (l_nodatafound = TRUE OR l_count = 0) THEN            
		    IF (l_newprm = TRUE) THEN
                l_comando := 'INSERT INTO '|| l_usutel ||'REPGRPF (IFUNC, GRUPO) VALUES (''' || l_numcra || ''', ''' || l_codprm_5 || ''')';		        
		    ELSE
                l_comando := 'INSERT INTO '|| l_usutel ||'REPGRPF (IFUNC, GRUPO) VALUES (''' || l_numcra || ''', ''' || l_codprm || ''')';		        
		    END IF;                  
        ELSE            
		    IF (l_newprm = TRUE) THEN
		        l_comando := 'UPDATE '|| l_usutel ||'REPGRPF SET GRUPO = ''' || l_codprm_5 || ''' WHERE IFUNC = ''' || l_numcra || '''';
		    ELSE
		        l_comando := 'UPDATE '|| l_usutel ||'REPGRPF SET GRUPO = ''' || l_codprm || ''' WHERE IFUNC = ''' || l_numcra || '''';
		    END IF;
        END IF;

        SP_CMDTSI(l_comando);
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'SP_REPGRPFTSI: ERRO NA ATUALIZAÇÃO DA REPGRPF';
      END;
    END IF;
  END IF;
END␀Ùø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Ï␀␀PROCEDURE SP_ResCon(P_TIPOPE CHAR,P_TIPCRA NUMBER(1),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_DATINI DATE,P_HORINI NUMBER(5),P_NUMCRA NUMBER(12),P_DATFIM DATE,P_HORFIM NUMBER(5),P_CRAOLD NUMBER(12),P_STATUS NUMBER(1))
 IS

l_achounumfis BOOLEAN;
 l_cratit NUMBER(12);

/* CURSOR para os números físicos dos crachás */
  CURSOR c_r069fis IS SELECT TECCRA,NUMFIS FROM R069FIS A
                      WHERE NUMCRA = p_numcra
                      AND DATALT = (
                      SELECT MAX(DATALT) FROM R069FIS WHERE NUMCRA = A.NUMCRA AND TECCRA = A.TECCRA);
  TYPE t_r069fis IS RECORD(
    TECCRA   R069FIS.TecCra%TYPE,
    NUMFIS   R069FIS.NumFis%TYPE);
  l_r069fis t_r069fis;

BEGIN
  NULL;
END␀«ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
+␀␀/* STORED PROCEDURE RESPONSÁVEL POR RESETAR/REINICIAR TODOS OS CRÉDITOS DE ACESSO DE UMA PESSOA*/
PROCEDURE SP_RESETCRED(P_TIPPES INTEGER,P_NUMEMP NUMBER,P_TIPCOL INTEGER,P_NUMCAD NUMBER,P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMMAT VARCHAR2(15),P_PROPAC VARCHAR2(20))
 IS
BEGIN
    NULL;
END		SENIOR;20$SP_INTSTR
SP_CRECON
SP_ATUCRELOC
␀␀

/* STORED PROCEDURE RESPONSÁVEL POR RESETAR/REINICIAR TODOS OS CRÉDITOS DE ACESSO DE UMA PESSOA*/
PROCEDURE SP_RESETCRED(P_TIPPES INTEGER,P_NUMEMP NUMBER,P_TIPCOL INTEGER,P_NUMCAD NUMBER,P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMMAT VARCHAR2(15),P_PROPAC VARCHAR2(20))
 IS

l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_idtpes       VARCHAR2(23);
  l_verplf       NUMBER(3);
  l_tipdoc       CHAR(1);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
BEGIN
  /*Busca versão do plano ativa*/
  BEGIN
      SELECT VERPLF INTO l_verplf
        FROM R058VPL
       WHERE DATCRI <= l_data_atual
         AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
  EXCEPTION
      WHEN OTHERS THEN
          l_verplf := 1;
  END;
  /*Inicializações*/
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  
  /*EFETUA A OPERAÇÃO DE ACORDO COM A PESSOA*/

  /*COLABORADOR*/
  IF (p_tippes < 4) THEN
      SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;

      UPDATE R070CRC SET SALATU = CREDIA, QTDCON = 0, DATCON = l_data_zero
       WHERE R070CRC.NUMEMP = p_numemp
         AND R070CRC.TIPCOL = p_tipcol
         AND R070CRC.NUMCAD = p_numcad
         AND R070CRC.DATINI <= l_data_atual
         AND (R070CRC.DATFIM = l_data_zero OR R070CRC.DATFIM > l_data_atual OR
              (R070CRC.DATFIM = l_data_atual AND R070CRC.FIMFAI >= l_hora_atual));

      /*Atualiza os créditos sem local físico*/
      SP_CRECON(p_tippes, p_numemp, p_tipcol, p_numcad, 0, '0', '0', '0', l_verplf, 0);
      
  /*VISITANTE*/
  ELSIF (p_tippes = 4) THEN
      SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
      l_idtpes := '04'||l_tipdoc||p_numdoc;

      UPDATE R070CRV SET SALATU = CREDIA, QTDCON = 0, DATCON = l_data_zero
       WHERE R070CRV.TIPDOC = p_tipdoc
         AND R070CRV.NUMDOC = p_numdoc
         AND R070CRV.DATINI <= l_data_atual
         AND (R070CRV.DATFIM = l_data_zero OR R070CRV.DATFIM > l_data_atual OR
              (R070CRV.DATFIM = l_data_atual AND R070CRV.FIMFAI >= l_hora_atual) );

      /*Atualiza os créditos sem local físico*/
      SP_CRECON(p_tippes, 0, 0, 0, p_tipdoc, p_numdoc, '0', '0', l_verplf, 0);
      
  /*Outras Unidades*/
  ELSIF (p_tippes = 5) THEN
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= '05'||l_numemp||l_numcad;

