Ê]␀␀

PROCEDURE SP_PACCON(P_TIPPES NUMBER(2),P_PROPAC VARCHAR2(20),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER,P_VERPLF NUMBER(3),P_CODPLF NUMBER(5),P_DATINI DATE,P_HORINI NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_SUBNV NUMBER(1),P_CREACC NUMBER(1))
 IS

l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numpro_ret   BOOLEAN;
  l_numsma       NUMBER(12);
  l_numsma_ret   BOOLEAN;
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_teccra       NUMBER(1);
  l_inival       CHAR(16);
  l_tipcra       NUMBER(2);
  l_codig        CHAR(6);
  l_situa        CHAR(1);
  l_situaAnt     CHAR(1);
  l_sitcra       NUMBER;
  l_subnv        CHAR(5);
  l_faixa        CHAR(56);
  l_fairef       CHAR(56);
  l_datahora     CHAR(10);
  l_desmsg       VARCHAR2(32);
  l_qtdmsg       CHAR(2);
  l_qtdmsg_nmb   NUMBER;
  l_crefx1       CHAR(2);
  l_fx1          CHAR(8);
  l_crefx2       CHAR(2);
  l_fx2          CHAR(8);
  l_crefx3       CHAR(2);
  l_fx3          CHAR(8);
  l_crefx4       CHAR(2);
  l_fx4          CHAR(8);
  l_crefx5       CHAR(2);
  l_fx5          CHAR(8);
  l_crefx6       CHAR(2);
  l_fx6          CHAR(8);
  l_datmsgaux    CHAR(16);
  l_qtdIdtPes    NUMBER(2);
  l_count        NUMBER(4);
  l_iPerson      BOOLEAN;
  l_datano       NUMBER(4);
  l_usarfastr    CHAR(1);
  l_usarfa       NUMBER(1);

  /* Controle de Areas Restritas */
  l_grupo1       CHAR(5);
  l_iniAR1       CHAR(10);
  l_fimAR1       CHAR(10);
  l_grupo2       CHAR(5);
  l_iniAR2       CHAR(10);
  l_fimAR2       CHAR(10);
  l_grupo3       CHAR(5);
  l_iniAR3       CHAR(10);
  l_fimAR3       CHAR(10);

  /* Definições de acesso por visitante */
  l_anti_dupla   CHAR(1); /* Controla Anti-Dupla */
  l_anti_dupla_nmb NUMBER; /* Controla Anti-Dupla */
  l_vis_esp      CHAR(1); /* se for visitante especial bloqueia automaticamente na saida. */
  l_idtpes       VARCHAR2(23);
  l_tippes       VARCHAR2(2);
  l_numcra       CHAR(12);
  l_comando_nulo BOOLEAN;
  l_datstr       VARCHAR2(6);
  l_horstr       VARCHAR2(4);
  l_datstr_ini   VARCHAR2(6);
  l_horstr_ini   VARCHAR2(4);
  l_concre       NUMBER(1);
  l_conrea       NUMBER(1);
  l_gercrv       CHAR(1);
  l_usabio       NUMBER(1);
  l_VerPrm       NUMBER(1);
  l_gracon       NUMBER(3);
  l_auxval       CHAR(16);
  l_creacc_bol   BOOLEAN;
  l_subnv_bol    BOOLEAN;
  l_ValAut       NUMBER(1);
  /*Interjornadas*/
  l_ConInt_int   NUMBER(1);
  l_TolInt       NUMBER(3);
  l_conpac       NUMBER(1);
  l_tempac       NUMBER(3);
  l_tolacp       NUMBER(2);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_hora_tol     NUMBER(4);
  l_pode_ignorar BOOLEAN;
  l_segu_atual   NUMBER(2);
  l_codprm       NUMBER;
  l_tipdoc       VARCHAR2(1);
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_uticcr       CHAR(1);
  l_atucreloc    BOOLEAN;
  l_verplf       NUMBER(3);
  l_nompes       VARCHAR2(40);
  l_ddifon       NUMBER(3);
  l_dddfon       NUMBER(3);
  l_numfon       VARCHAR2(20);
  l_qtdprv       NUMBER(2);
  l_pesblo       NUMBER(1);
  l_desblo       VARCHAR(29);
  l_numcracex    NUMBER(12);
BEGIN
  l_atucreloc  := FALSE;
  l_nompes := '';
  l_ddifon := 0;
  l_dddfon := 0;
  l_numfon := '';
  l_qtdprv := 0;
  l_pesblo := 0;
  l_desblo := '';
  l_pode_ignorar := FALSE;

  /* Busca parametro que indica se utiliza compra. */
  BEGIN
     SELECT UTICCR INTO l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_uticcr := 'N';
  END;

  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_hora_tol := l_hora_atual + 5;
  IF (l_hora_tol > 1439) THEN
    l_hora_tol := 1439;
  END IF;
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_segu_atual := SECOND(CURTIME());

  IF (p_datini > l_data_atual OR (p_datini = l_data_atual AND P_HORINI >= l_hora_tol)) THEN
    l_pode_ignorar := TRUE;
  END IF;

  IF (p_numcra > 0 AND l_pode_ignorar = FALSE) THEN
      /*Inicializações*/
      l_iPerson := FALSE;
      l_concre := 0;
      l_conrea := 1;
      l_crefx1 := '00';
      l_crefx2 := '00';
      l_crefx3 := '00';
      l_crefx4 := '00';
      l_crefx5 := '00';
      l_crefx6 := '00';
      l_fx1 := '24002400';
      l_fx2 := '24002400';
      l_fx3 := '24002400';
      l_fx4 := '24002400';
      l_fx5 := '24002400';
      l_fx6 := '24002400';
      /* Inicializa Areas Restritas */
      l_grupo1 := '00000';
      l_iniAR1 := '0000000000';
      l_fimAR1 := '0000000000';
      l_grupo2 := '00000';
      l_iniAR2 := '0000000000';
      l_fimAR2 := '0000000000';
      l_grupo3 := '00000';
      l_iniAR3 := '0000000000';
      l_fimAR3 := '0000000000';
      l_vis_esp     := '0';
      l_subnv       := '99000';
      l_gercrv      :='N';
      l_anti_dupla  := '1';
      /*Biometria*/
      l_usabio      := 1;
      l_verprm      := 1;
      l_gracon      := 50;
      l_usarfastr   := 'N';
      /*Interjornadas*/
      l_ConInt_int := 0;
      l_TolInt := 0;
      l_conpac := 0;
      l_tempac := 0;
      l_tolacp := 0;
      l_desmsg := '                                ';
      l_qtdmsg := '0';
      l_datmsgaux  := '0000000000000000';
      l_codig := '';
      l_situa  := '0';
      l_situaAnt:= '1';
      l_faixa  := '00002359240024002400240024002400240024002400240024002400';
      l_fairef := '24002400240024002400240024002400240024002400240024002400';
      l_nomfun := '';
      l_numpis := 0;
      /*Busca versão do plano ativa*/
      BEGIN
          SELECT VERPLF INTO l_verplf
            FROM R058VPL
           WHERE DATCRI <= l_data_atual
             AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
      EXCEPTION
          WHEN OTHERS THEN
              l_verplf := 1;
      END;
      /*Se a data inicial for menor do que 1980, então considera como 01/01/1980*/
      l_datano := Year(p_datini);
      IF (l_datano < 1980) THEN
         l_inival := '0101802359000000';
      ELSE
         /*obtem a data inicial do crachá*/
         SP_DATSTR(p_datini,'DDMMYY',l_datstr_ini OUT);
         SP_INTSTR(p_horini,'HHMM',l_horstr_ini OUT);
         l_inival := l_datstr_ini||l_horstr_ini||'000000';
      END IF;

      /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
      SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

      IF (l_crapri = 0) THEN
         l_crapri := p_numcra;
         /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
         l_teccra := 1;
      ELSE
         l_teccra := l_tecpri;
      END IF;

      /* Atualiza R070CON */
      l_comando_nulo:=FALSE;
      BEGIN
          SELECT NUMFIS,SITCRA INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
      EXCEPTION
          WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_PACCON: Erro em R070CON - TOO MANY ROWS';
          WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro no SELECT R070CON 5.';
      END;

      /* Monta o identificador do paciente ou acompanhante de paciente */
      SP_INTSTR(p_tippes,'99',l_tippes OUT);
      l_tipcra := p_tippes;

      /*Se for paciente que está atualizando...*/
      IF (p_tippes = 9) THEN
          /* Busca definições de créditos de acesso para pacientes/acompanhantes. */
          BEGIN
              SELECT CREPAC INTO l_concre FROM R070DAC;
          EXCEPTION
              WHEN OTHERS THEN l_concre := 0;
          END;

          IF ((l_comando_nulo = FALSE) AND (p_creacc = 1) AND (l_uticcr = 'N')) THEN
          	  /* marca como atualizado os créditos da pessoa */
          	  l_atucreloc := TRUE;
              /*reseta os créditos do paciente*/
              SP_RESETCRED(p_tippes, 0, 0, 0, 0, '0', '0', p_propac);
          END IF;

          SP_RETCRP (p_propac, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);

          /* Busca definição 'Utiliza Reconhecimento Facial' para pacientes */
          BEGIN
              SELECT R097TIN.USARFA INTO l_usarfastr FROM R097INT, R097TIN
               WHERE R097INT.CODTIN = R097TIN.CODTIN AND R097INT.PROPAC = p_propac AND ((
                     ((r097int.DATINI < p_datini) OR ((r097int.DATINI = p_datini) AND (r097int.HORINI <= p_horini)) )AND
                      ((r097int.DATFIM > p_datini) OR ((r097int.DATFIM = p_datini) AND (r097int.HORFIM >= p_horini)) OR (r097int.DATFIM = l_data_zero))));
          EXCEPTION
              WHEN OTHERS THEN l_usarfastr := 'N';
          END;

          l_idtpes := l_tippes||p_propac;

      /*Se for acompanhante de paciente que está atualizando...*/
      ELSIF (p_tippes = 11) THEN
          /* Busca definições de créditos de acesso para acompanhantes de pacientes */
          BEGIN
              SELECT R097TIN.CONCRE, R097TIN.GRACON, R097TIN.USABIO, R097TIN.USARAC INTO l_concre, l_gracon, l_usabio, l_usarfastr FROM R097INT, R097TIN
               WHERE R097INT.CODTIN = R097TIN.CODTIN AND R097INT.PROPAC = p_propac AND ((
                     ((r097int.DATINI < p_datini) OR ((r097int.DATINI = p_datini) AND (r097int.HORINI <= p_horini)) )AND
                      ((r097int.DATFIM > p_datini) OR ((r097int.DATFIM = p_datini) AND (r097int.HORFIM >= p_horini)) OR (r097int.DATFIM = l_data_zero))));
          EXCEPTION
              WHEN OTHERS THEN l_concre := 0; l_gracon := 50; l_usabio := 1; l_usarfastr := 'N';
          END;

          IF ((l_comando_nulo = FALSE) AND (p_creacc = 1) AND (l_uticcr = 'N')) THEN
          	  /* marca como atualizado os créditos da pessoa */
          	  l_atucreloc := TRUE;
              /*reseta os créditos do acompanhante de paciente*/
              SP_RESETCRED(p_tippes, 0, 0, 0, p_tipdoc, p_numdoc, '0', '0');
          END IF;

          SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
          SP_RETCAP (l_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);

          /*Monta o Identificador da Pessoa*/
          l_idtpes := l_tippes||l_tipdoc||p_numdoc;
      ELSE
          SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
          /*Monta o Identificador da Pessoa*/
          l_idtpes := l_tippes||l_tipdoc||p_numdoc;
      END IF;

      /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);

      LOOP
         /*Controle do Loop.*/
         IF (Length(l_idtpes) > 22) THEN
             EXIT;
         END IF;
         l_idtpes := ' '||l_idtpes;
      END LOOP;

      SP_DATSTR(p_datval,'DDMMYY',l_datstr OUT);
      SP_INTSTR(p_horval,'HHMM',l_horstr OUT);
      /* corrige a data se vier com valor zero */
      IF  (l_datstr = '311200') THEN
         l_datstr :=  '311250';
      END IF;
      IF  (l_horstr = '0000') THEN
         l_horstr :=  '2359';
      END IF;
      l_datahora := l_datstr || l_horstr;
      l_auxval := l_datahora||'000000';

      /*Obtem a permissão da pessoa*/
      SP_PRMAMB(p_verplf, p_codplf, l_codprm OUT);

      /* verifica se o crachá é de uma nova entrada */
      IF  (l_situaAnt = '1') THEN
          l_subnv := '99000';
      END IF;

      /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
      BEGIN
          SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON WHERE IDTPES = l_idtpes;
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro No SELECT R070CON (IdtPes).';
      END;

      IF (l_qtdIdtPes > 0) THEN
          l_iPerson := FALSE;
      ELSE
          l_iPerson := TRUE;
      END IF;

      /* verifica se possui registros na tabela R090VAU.. Se possuir, ValAut = 1 */
      l_count := 0;
      BEGIN
          SELECT COUNT(*) INTO l_count FROM R090VAU WHERE IDTPES = l_idtpes AND
                 (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                 (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro No SELECT R090VAU (IdtPes).';
      END;

      /* necessita de validação por autorizador */
      l_ValAut := 0;
      IF  (l_count > 0) THEN
          l_ValAut := 1;
      END IF;

      SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

      l_numcracex := 0;
      BEGIN
          SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
      EXCEPTION
      	WHEN OTHERS THEN NULL;
      END;

      IF (l_numcracex = p_numcra) THEN
        l_situa := '1';
      END IF;

      /* Assinala na tabela Controle que o Paciente ou Acomp. de Paciente utiliza reconhecimento facial */
      IF  l_usarfastr = 'S' THEN
          l_usarfa := 1;
      ELSE
          l_usarfa := 0;
      END IF;

      SP_STRTOINT(l_situa , l_sitcra OUT);
      SP_STRTOINT(l_qtdmsg , l_qtdmsg_nmb OUT);
      SP_STRTOINT(l_anti_dupla , l_anti_dupla_nmb OUT);

      IF (l_comando_nulo = FALSE) THEN
          /* atualiza a tabela R070CON */
          BEGIN
              UPDATE R070CON SET
                     NUMCRA=p_numcra, TIPCRA=l_tipcra, SENCOL= l_codig,INIAFA= '0000000000000000',
                     DATAFA='0000000000000000',
                     CODPRM=l_codprm, PRMSAB=l_codprm, PRMDOM=l_codprm, PRMFER=l_codprm,
                     SITCRA=l_sitcra, INIVAL = l_inival, DATVAL=l_auxval,
                     MSGACC=l_desmsg, DATMSG=l_datmsgaux, QTDMSG=l_qtdmsg_nmb,
                     CONADP=l_anti_dupla_nmb, CONCRE=l_concre,
                     CREAC1=CONVERT(CHAR_TO_NUMBER, l_crefx1),CREFX1=l_fx1,QTDCR1=CONVERT(CHAR_TO_NUMBER, l_crefx1),
                     CREAC2=CONVERT(CHAR_TO_NUMBER, l_crefx2),CREFX2=l_fx2,QTDCR2=CONVERT(CHAR_TO_NUMBER, l_crefx2),
                     CREAC3=CONVERT(CHAR_TO_NUMBER, l_crefx3),CREFX3=l_fx3,QTDCR3=CONVERT(CHAR_TO_NUMBER, l_crefx3),
                     CREAC4=CONVERT(CHAR_TO_NUMBER, l_crefx4),CREFX4=l_fx4,QTDCR4=CONVERT(CHAR_TO_NUMBER, l_crefx4),
                     CREAC5=CONVERT(CHAR_TO_NUMBER, l_crefx5),CREFX5=l_fx5,QTDCR5=CONVERT(CHAR_TO_NUMBER, l_crefx5),
                     CREAC6=CONVERT(CHAR_TO_NUMBER, l_crefx6),CREFX6=l_fx6,QTDCR6=CONVERT(CHAR_TO_NUMBER, l_crefx6),
                     PRMRT1=CONVERT(CHAR_TO_NUMBER, l_grupo1), DINPR1=l_iniAr1, DFNPR1=l_fimAr1,
                     PRMRT2=CONVERT(CHAR_TO_NUMBER, l_grupo2), DINPR2=l_iniAr2, DFNPR2=l_fimAr2,
                     PRMRT3=CONVERT(CHAR_TO_NUMBER, l_grupo3), DINPR3=l_iniAr3, DFNPR3=l_fimAr3,
                     TECCRA=l_teccra, CHCPRI=0, IDTPES=l_idtpes, USABIO=l_usabio, GRACON=l_gracon,
                     CONINT=l_conInt_Int, TOLINT=l_tolInt, CONPAC=l_conpac, TEMPAC=l_tempac,
                     TOLACP=l_tolacp,VALAUT=l_ValAut,NOMFUN=l_nomfun,NUMPIS=l_numpis,CONREA=l_conrea,
                     NOMPES=l_nompes,DDIFON=l_ddifon,DDDFON=l_dddfon,NUMFON=l_numfon,QTDPRV=l_qtdprv,
                     PESBLO=l_pesblo,DESBLO=l_desblo,TIPDOC=p_tipdoc,NUMDOC=p_numdoc,BLOAUT=CONVERT(CHAR_TO_NUMBER, l_vis_esp),
                     NUMEMP=0, TIPCOL=0, NUMCAD=0, NUMMAT='0', PROPAC=p_propac, NUMCAN=0, USARFA=l_usarfa
              WHERE NUMFIS = l_crapri;

              /* Verifica se atualiza SubNv*/
              IF (p_subnv = 1) THEN
                BEGIN
                    UPDATE R070CON SET
                         NIVATU = '99000', DATNIV = l_data_atual, HORNIV = l_hora_atual, SEQNIV = l_segu_atual
                    WHERE IDTPES = l_idtpes;
                    /*Gera pendência de atualização de nível*/
                    SP_PEND26(l_idtpes, '99000', l_data_atual, l_hora_atual, l_segu_atual);
                EXCEPTION WHEN OTHERS THEN
                    RAISERROR 103 'SP_PACCON: Erro Na Atualização de SPVISCON 2.';
                END;
              END IF;

          EXCEPTION
              WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro Na Atualização de R070CON';
          END;
      ELSE
         /* insere na tabela R070CON */
         BEGIN
             INSERT INTO R070CON(
                         NUMCRA,NUMFIS,TIPCRA,SITCRA,NIVATU,DATNIV,HORNIV,SEQNIV,
                         INIVAL,DATVAL,INIAFA, DATAFA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                         SENCOL,MSGACC,DATMSG,QTDMSG,MSGATU,
                         CONIAL,TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,
                         CONPAC,TEMPAC,TOLACP,BLOAUT,BLOFAL,
                         CREAC1,CREFX1,QTDCR1,CREAC2,CREFX2,QTDCR2,
                         CREAC3,CREFX3,QTDCR3,CREAC4,CREFX4,QTDCR4,
                         CREAC5,CREFX5,QTDCR5,CREAC6,CREFX6,QTDCR6,
                         PRMRT1,DINPR1,DFNPR1,PRMRT2,DINPR2,DFNPR2,PRMRT3,DINPR3,DFNPR3,
                         FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,FAIAC7,
                         FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,FAIREF,
                         TECCRA,CHCPRI,IDTPES,GRACON,CONINT,TOLINT,VALAUT,
                         NOMFUN,NUMPIS,CONREA,
                         NOMPES,DDIFON,DDDFON,NUMFON,QTDPRV,PESBLO,DESBLO,TIPDOC,NUMDOC,
                         RECVIS,PROPRE,NUMEMP,TIPCOL,NUMCAD,NUMMAT,PROPAC,NUMCAN,USARFA)
             VALUES(
                         p_numcra,l_crapri,l_tipcra,l_sitcra,l_subnv,l_data_atual,
                         l_hora_atual,l_segu_atual,l_inival,l_auxval,
                         '0000000000000000','0000000000000000',l_codprm,l_codprm,
                         l_codprm,l_codprm,l_codig,l_desmsg,l_datmsgaux,l_qtdmsg_nmb,l_qtdmsg_nmb,
                         0,0,0,l_usabio,l_VerPrm,0,l_anti_dupla_nmb,l_concre,l_conpac,l_tempac,l_tolacp,CONVERT(CHAR_TO_NUMBER, l_vis_esp),0,
                         CONVERT(CHAR_TO_NUMBER, l_crefx1),l_fx1,CONVERT(CHAR_TO_NUMBER, l_crefx1),CONVERT(CHAR_TO_NUMBER, l_crefx2),l_fx2,CONVERT(CHAR_TO_NUMBER, l_crefx2),
                         CONVERT(CHAR_TO_NUMBER, l_crefx3),l_fx3,CONVERT(CHAR_TO_NUMBER, l_crefx3),CONVERT(CHAR_TO_NUMBER, l_crefx4),l_fx4,CONVERT(CHAR_TO_NUMBER, l_crefx4),
                         CONVERT(CHAR_TO_NUMBER, l_crefx5),l_fx5,CONVERT(CHAR_TO_NUMBER, l_crefx5),CONVERT(CHAR_TO_NUMBER, l_crefx6),l_fx6,CONVERT(CHAR_TO_NUMBER, l_crefx6),
                         CONVERT(CHAR_TO_NUMBER, l_grupo1),l_iniAr1,l_fimAr1,CONVERT(CHAR_TO_NUMBER, l_grupo2),l_iniAr2,l_fimAr2,
                         CONVERT(CHAR_TO_NUMBER, l_grupo3),l_iniAr3,l_fimAr3,
                         l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                         l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                         l_fairef,l_teccra,0,l_idtpes,l_gracon,l_conInt_Int,l_tolInt,l_ValAut,
                         l_nomfun,l_numpis,l_conrea,
                         l_nompes,l_ddifon,l_dddfon,l_numfon,l_qtdprv,l_pesblo,l_desblo,p_tipdoc,p_numdoc,
                         0, 0, 0, 0, 0, '0', p_propac, 0, l_usarfa);
         EXCEPTION
             WHEN OTHERS THEN      RAISERROR 103 'SP_PACCON: Erro no INSERT Tabela R070CON.';

         END;

      END IF;
      /*Atualiza Pend_Grupo*/
      IF (l_numsma > 0) THEN
          /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
          IF (l_tecpri = 3) THEN
              SP_ATUPRM(p_numcra, l_numsma, l_codprm, l_grupo1, l_grupo2, l_grupo3, l_codprm, l_codprm, l_codprm);
          ELSE
              SP_ATUPRM(l_crapri, l_numsma, l_codprm, l_grupo1, l_grupo2, l_grupo3, l_codprm, l_codprm, l_codprm);
          END IF;
      END IF;


      /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
      IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
          SP_PEND21(l_crapri);
      END IF;

      /*Atualiza os demais Crachás*/
      /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
      IF (l_tecpri = 1) THEN
          /*Atualiza o crachá de proximidade*/
          IF (l_numpro <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numpro, l_numpro_ret OUT);
                /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numpro);
              END IF;
          END IF;
          /*Atualiza o crachá Smart*/
          IF (l_numsma <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numsma, l_numsma_ret OUT);
              /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numsma);
              END IF;
          END IF;
      /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
      ELSIF (l_tecpri = 2) THEN
          /*Atualiza o crachá Smart*/
          IF (l_numsma <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numsma, l_numsma_ret OUT);
              /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numsma);
              END IF;
          END IF;
      END IF;
      /*Verifica se Gera o Comando IncludePerson*/
      IF (l_iPerson = TRUE) THEN
          /*Gera o Include Person*/
          SP_PEND19(p_numcra, l_idtpes);
          /*Atualiza os créditos somente se o mesmo já não foi atualizado*/
          IF (l_atucreloc = FALSE) THEN
              /*Atualiza os créditos sem local físico*/
              SP_PEND06(1, l_idtpes, l_verplf, 0);
              /*Atualiza os créditos por local físico da pessoa*/
              SP_ATUCRELOC(l_idtpes);
          END IF;
      END IF;
  END IF;
  IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
    l_creacc_bol := TRUE;
  ELSE
    l_creacc_bol := FALSE;
  END IF;
  IF (p_subnv = 1) THEN
    l_subnv_bol := TRUE;
  ELSE
    l_subnv_bol := FALSE;
  END IF;

  /*Atualiza a Controle*/
  IF (l_pode_ignorar = FALSE) THEN
    SP_ATUTSI(l_idtpes, l_crapri, l_creacc_bol, TRUE, l_subnv_bol, TRUE);
  END IF;
END		SENIOR;20ÁSP_DATSTR
SP_INTSTR
SP_RETCRP
SP_RETCAP
SP_MAPFIS
SP_PRMAMB
SP_RETFON
SP_PEND26
SP_RESETCRED
SP_ATUPRM
SP_PEND21
SP_VERCON
SP_ATUFIS
SP_PEND19
SP_PEND06
SP_ATUCRELOC
SP_ATUTSI
ˆY␀␀


PROCEDURE SP_PACCON(P_TIPPES NUMBER(2),P_PROPAC VARCHAR2(20),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER,P_VERPLF NUMBER(3),P_CODPLF NUMBER(5),P_DATINI DATE,P_HORINI NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_SUBNV NUMBER(1),P_CREACC NUMBER(1))
 IS

l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numpro_ret   BOOLEAN;
  l_numsma       NUMBER(12);
  l_numsma_ret   BOOLEAN;
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_teccra       NUMBER(1);
  l_inival       CHAR(16);
  l_tipcra       NUMBER(2);
  l_codig        CHAR(6);
  l_situa        CHAR(1);
  l_situaAnt     CHAR(1);
  l_subnv        CHAR(5);
  l_faixa        CHAR(56);
  l_fairef       CHAR(56);
  l_datahora     CHAR(10);
  l_desmsg       VARCHAR2(32);
  l_qtdmsg       CHAR(2);
  l_crefx1       CHAR(2);
  l_fx1          CHAR(8);
  l_crefx2       CHAR(2);
  l_fx2          CHAR(8);
  l_crefx3       CHAR(2);
  l_fx3          CHAR(8);
  l_crefx4       CHAR(2);
  l_fx4          CHAR(8);
  l_crefx5       CHAR(2);
  l_fx5          CHAR(8);
  l_crefx6       CHAR(2);
  l_fx6          CHAR(8);
  l_datmsgaux    CHAR(16);
  l_qtdIdtPes    NUMBER(2);
  l_count        NUMBER(4);
  l_iPerson      BOOLEAN;
  l_datano       NUMBER(4);
  l_usarfastr    CHAR(1);
  l_usarfa       NUMBER(1);

  /* Controle de Areas Restritas */
  l_grupo1       CHAR(5);
  l_iniAR1       CHAR(10);
  l_fimAR1       CHAR(10);
  l_grupo2       CHAR(5);
  l_iniAR2       CHAR(10);
  l_fimAR2       CHAR(10);
  l_grupo3       CHAR(5);
  l_iniAR3       CHAR(10);
  l_fimAR3       CHAR(10);

  /* Definições de acesso por visitante */
  l_anti_dupla   CHAR(1); /* Controla Anti-Dupla */
  l_vis_esp      CHAR(1); /* se for visitante especial bloqueia automaticamente na saida. */
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_numcra       CHAR(12);
  l_comando_nulo BOOLEAN;
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_datstr_ini   CHAR(6);
  l_horstr_ini   CHAR(4);
  l_concre       NUMBER(1);
  l_conrea       NUMBER(1);
  l_gercrv       CHAR(1);
  l_usabio       NUMBER(1);
  l_VerPrm       NUMBER(1);
  l_gracon       NUMBER(3);
  l_auxval       CHAR(16);
  l_creacc_bol   BOOLEAN;
  l_subnv_bol    BOOLEAN;
  l_ValAut       NUMBER(1);
  /*Interjornadas*/
  l_ConInt_int   NUMBER(1);
  l_TolInt       NUMBER(3);
  l_conpac       NUMBER(1);
  l_tempac       NUMBER(3);
  l_tolacp       NUMBER(2);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_hora_tol     NUMBER(4);
  l_pode_ignorar BOOLEAN;
  l_segu_atual   NUMBER(2);
  l_codprm       NUMBER;
  l_tipdoc       CHAR(1);
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_uticcr       CHAR(1);
  l_atucreloc    BOOLEAN;
  l_verplf       NUMBER(3);
  l_nompes       VARCHAR2(40);
  l_ddifon       NUMBER(3);
  l_dddfon       NUMBER(3);
  l_numfon       VARCHAR2(20);
  l_qtdprv       NUMBER(2);
  l_pesblo       NUMBER(1);
  l_desblo       VARCHAR(29);
  l_numcracex    NUMBER(12);
BEGIN
  l_atucreloc  := FALSE;
  l_nompes := '';
  l_ddifon := 0;
  l_dddfon := 0;
  l_numfon := '';
  l_qtdprv := 0;
  l_pesblo := 0;
  l_desblo := '';
  l_pode_ignorar := FALSE;

  /* Busca parametro que indica se utiliza compra. */
  BEGIN
     SELECT UTICCR INTO l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_uticcr := 'N';
  END;

  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_hora_tol := l_hora_atual + 5;
  IF (l_hora_tol > 1439) THEN
    l_hora_tol := 1439;
  END IF;
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_segu_atual := SECOND(CURTIME());

  IF (p_datini > l_data_atual OR (p_datini = l_data_atual AND P_HORINI >= l_hora_tol)) THEN
    l_pode_ignorar := TRUE;
  END IF;

  IF (p_numcra > 0 AND l_pode_ignorar = FALSE) THEN
      /*Inicializações*/
      l_iPerson := FALSE;
      l_concre := 0;
      l_conrea := 1;
      l_crefx1 := '00';
      l_crefx2 := '00';
      l_crefx3 := '00';
      l_crefx4 := '00';
      l_crefx5 := '00';
      l_crefx6 := '00';
      l_fx1 := '24002400';
      l_fx2 := '24002400';
      l_fx3 := '24002400';
      l_fx4 := '24002400';
      l_fx5 := '24002400';
      l_fx6 := '24002400';
      /* Inicializa Areas Restritas */
      l_grupo1 := '00000';
      l_iniAR1 := '0000000000';
      l_fimAR1 := '0000000000';
      l_grupo2 := '00000';
      l_iniAR2 := '0000000000';
      l_fimAR2 := '0000000000';
      l_grupo3 := '00000';
      l_iniAR3 := '0000000000';
      l_fimAR3 := '0000000000';
      l_vis_esp     := '0';
      l_subnv       := '99000';
      l_gercrv      :='N';
      l_anti_dupla  := '1';
      /*Biometria*/
      l_usabio      := 1;
      l_verprm      := 1;
      l_gracon      := 50;
      l_usarfastr   := 'N';
      /*Interjornadas*/
      l_ConInt_int := 0;
      l_TolInt := 0;
      l_conpac := 0;
      l_tempac := 0;
      l_tolacp := 0;
      l_desmsg := '                                ';
      l_qtdmsg := '0';
      l_datmsgaux  := '0000000000000000';
      l_codig := '';
      l_situa  := '0';
      l_situaAnt:= '1';
      l_faixa  := '00002359240024002400240024002400240024002400240024002400';
      l_fairef := '24002400240024002400240024002400240024002400240024002400';
      l_nomfun := '';
      l_numpis := 0;
      /*Busca versão do plano ativa*/
      BEGIN
          SELECT VERPLF INTO l_verplf
            FROM R058VPL
           WHERE DATCRI <= l_data_atual
             AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
      EXCEPTION
          WHEN OTHERS THEN
              l_verplf := 1;
      END;
      /*Se a data inicial for menor do que 1980, então considera como 01/01/1980*/
      l_datano := Year(p_datini);
      IF (l_datano < 1980) THEN
         l_inival := '0101802359000000';
      ELSE
         /*obtem a data inicial do crachá*/
         SP_DATSTR(p_datini,'DDMMYY',l_datstr_ini OUT);
         SP_INTSTR(p_horini,'HHMM',l_horstr_ini OUT);
         l_inival := l_datstr_ini||l_horstr_ini||'000000';
      END IF;

      /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
      SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

      IF (l_crapri = 0) THEN
         l_crapri := p_numcra;
         /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
         l_teccra := 1;
      ELSE
         l_teccra := l_tecpri;
      END IF;

      /* Atualiza R070CON */
      l_comando_nulo:=FALSE;
      BEGIN
          SELECT NUMFIS,SITCRA INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
      EXCEPTION
          WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_PACCON: Erro em R070CON - TOO MANY ROWS';
          WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro no SELECT R070CON 5.';
      END;

      /* Monta o identificador do paciente ou acompanhante de paciente */
      SP_INTSTR(p_tippes,'99',l_tippes OUT);
      l_tipcra := p_tippes;

      /*Se for paciente que está atualizando...*/
      IF (p_tippes = 9) THEN
          /* Busca definições de créditos de acesso para pacientes/acompanhantes. */
          BEGIN
              SELECT CREPAC INTO l_concre FROM R070DAC;
          EXCEPTION
              WHEN OTHERS THEN l_concre := 0;
          END;

          IF ((l_comando_nulo = FALSE) AND (p_creacc = 1) AND (l_uticcr = 'N')) THEN
          	  /* marca como atualizado os créditos da pessoa */
          	  l_atucreloc := TRUE;
              /*reseta os créditos do paciente*/
              SP_RESETCRED(p_tippes, 0, 0, 0, 0, '0', '0', p_propac);
          END IF;

          SP_RETCRP (p_propac, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);

          /* Busca definição 'Utiliza Reconhecimento Facial' para pacientes */
          BEGIN
              SELECT R097TIN.USARFA INTO l_usarfastr FROM R097INT, R097TIN
               WHERE R097INT.CODTIN = R097TIN.CODTIN AND R097INT.PROPAC = p_propac AND ((
                     ((r097int.DATINI < p_datini) OR ((r097int.DATINI = p_datini) AND (r097int.HORINI <= p_horini)) )AND
                      ((r097int.DATFIM > p_datini) OR ((r097int.DATFIM = p_datini) AND (r097int.HORFIM >= p_horini)) OR (r097int.DATFIM = l_data_zero))));
          EXCEPTION
              WHEN OTHERS THEN l_usarfastr := 'N';
          END;

          l_idtpes := l_tippes||p_propac;

      /*Se for acompanhante de paciente que está atualizando...*/
      ELSIF (p_tippes = 11) THEN
          /* Busca definições de créditos de acesso para acompanhantes de pacientes */
          BEGIN
              SELECT R097TIN.CONCRE, R097TIN.GRACON, R097TIN.USABIO, R097TIN.USARAC INTO l_concre, l_gracon, l_usabio, l_usarfastr FROM R097INT, R097TIN
               WHERE R097INT.CODTIN = R097TIN.CODTIN AND R097INT.PROPAC = p_propac AND ((
                     ((r097int.DATINI < p_datini) OR ((r097int.DATINI = p_datini) AND (r097int.HORINI <= p_horini)) )AND
                      ((r097int.DATFIM > p_datini) OR ((r097int.DATFIM = p_datini) AND (r097int.HORFIM >= p_horini)) OR (r097int.DATFIM = l_data_zero))));
          EXCEPTION
              WHEN OTHERS THEN l_concre := 0; l_gracon := 50; l_usabio := 1; l_usarfastr := 'N';
          END;

          IF ((l_comando_nulo = FALSE) AND (p_creacc = 1) AND (l_uticcr = 'N')) THEN
          	  /* marca como atualizado os créditos da pessoa */
          	  l_atucreloc := TRUE;
              /*reseta os créditos do acompanhante de paciente*/
              SP_RESETCRED(p_tippes, 0, 0, 0, p_tipdoc, p_numdoc, '0', '0');
          END IF;

          SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
          SP_RETCAP (l_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);

          /*Monta o Identificador da Pessoa*/
          l_idtpes := l_tippes||l_tipdoc||p_numdoc;
      ELSE
          SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
          /*Monta o Identificador da Pessoa*/
          l_idtpes := l_tippes||l_tipdoc||p_numdoc;
      END IF;

      /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);

      LOOP
         /*Controle do Loop.*/
         IF (Length(l_idtpes) > 22) THEN
             EXIT;
         END IF;
         l_idtpes := ' '||l_idtpes;
      END LOOP;

      SP_DATSTR(p_datval,'DDMMYY',l_datstr OUT);
      SP_INTSTR(p_horval,'HHMM',l_horstr OUT);
      /* corrige a data se vier com valor zero */
      IF  (l_datstr = '311200') THEN
         l_datstr :=  '311250';
      END IF;
      IF  (l_horstr = '0000') THEN
         l_horstr :=  '2359';
      END IF;
      l_datahora := l_datstr || l_horstr;
      l_auxval := l_datahora||'000000';

      /*Obtem a permissão da pessoa*/
      SP_PRMAMB(p_verplf, p_codplf, l_codprm OUT);

      /* verifica se o crachá é de uma nova entrada */
      IF  (l_situaAnt = '1') THEN
          l_subnv := '99000';
      END IF;

      /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
      BEGIN
          SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON WHERE IDTPES = l_idtpes;
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro No SELECT R070CON (IdtPes).';
      END;

      IF (l_qtdIdtPes > 0) THEN
          l_iPerson := FALSE;
      ELSE
          l_iPerson := TRUE;
      END IF;

      /* verifica se possui registros na tabela R090VAU.. Se possuir, ValAut = 1 */
      l_count := 0;
      BEGIN
          SELECT COUNT(*) INTO l_count FROM R090VAU WHERE IDTPES = l_idtpes AND
                 (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                 (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro No SELECT R090VAU (IdtPes).';
      END;

      /* necessita de validação por autorizador */
      l_ValAut := 0;
      IF  (l_count > 0) THEN
          l_ValAut := 1;
      END IF;

      SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

      l_numcracex := 0;
      BEGIN
          SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
      EXCEPTION
      	WHEN OTHERS THEN NULL;
      END;

      IF (l_numcracex = p_numcra) THEN
        l_situa := '1';
      END IF;

      /* Assinala na tabela Controle que o Paciente ou Acomp. de Paciente utiliza reconhecimento facial */
      IF  l_usarfastr = 'S' THEN
          l_usarfa := 1;
      ELSE
          l_usarfa := 0;
      END IF;

      IF (l_comando_nulo = FALSE) THEN
          /* atualiza a tabela R070CON */
          BEGIN
              UPDATE R070CON SET
                     NUMCRA=p_numcra, TIPCRA=l_tipcra, SENCOL= l_codig,INIAFA= '0000000000000000',
                     DATAFA='0000000000000000',
                     CODPRM=l_codprm, PRMSAB=l_codprm, PRMDOM=l_codprm, PRMFER=l_codprm,
                     SITCRA=l_situa, INIVAL = l_inival, DATVAL=l_auxval,
                     MSGACC=l_desmsg, DATMSG=l_datmsgaux, QTDMSG=l_qtdmsg,
                     CONADP=l_anti_dupla, CONCRE=l_concre,
                     CREAC1=l_crefx1,CREFX1=l_fx1,QTDCR1=l_crefx1,
                     CREAC2=l_crefx2,CREFX2=l_fx2,QTDCR2=l_crefx2,
                     CREAC3=l_crefx3,CREFX3=l_fx3,QTDCR3=l_crefx3,
                     CREAC4=l_crefx4,CREFX4=l_fx4,QTDCR4=l_crefx4,
                     CREAC5=l_crefx5,CREFX5=l_fx5,QTDCR5=l_crefx5,
                     CREAC6=l_crefx6,CREFX6=l_fx6,QTDCR6=l_crefx6,
                     PRMRT1=l_grupo1, DINPR1=l_iniAr1, DFNPR1=l_fimAr1,
                     PRMRT2=l_grupo2, DINPR2=l_iniAr2, DFNPR2=l_fimAr2,
                     PRMRT3=l_grupo3, DINPR3=l_iniAr3, DFNPR3=l_fimAr3,
                     TECCRA=l_teccra, CHCPRI=0, IDTPES=l_idtpes, USABIO=l_usabio, GRACON=l_gracon,
                     CONINT=l_conInt_Int, TOLINT=l_tolInt, CONPAC=l_conpac, TEMPAC=l_tempac,
                     TOLACP=l_tolacp, VALAUT=l_ValAut, NOMFUN=l_nomfun, NUMPIS=l_numpis, CONREA=l_conrea,
                     NOMPES=l_nompes, DDIFON=l_ddifon, DDDFON=l_dddfon, NUMFON=l_numfon, QTDPRV=l_qtdprv,
                     PESBLO=l_pesblo, DESBLO=l_desblo, TIPDOC=p_tipdoc, NUMDOC=p_numdoc, BLOAUT=l_vis_esp,
                     NUMEMP=0, TIPCOL=0, NUMCAD=0, NUMMAT='0', PROPAC=p_propac, NUMCAN=0, USARFA=l_usarfa
              WHERE NUMFIS = l_crapri;

              /* Verifica se atualiza SubNv*/
              IF (p_subnv = 1) THEN
                BEGIN
                    UPDATE R070CON SET
                         NIVATU = '99000', DATNIV = l_data_atual, HORNIV = l_hora_atual, SEQNIV = l_segu_atual
                    WHERE IDTPES = l_idtpes;
                    /*Gera pendência de atualização de nível*/
                    SP_PEND26(l_idtpes, '99000', l_data_atual, l_hora_atual, l_segu_atual);
                EXCEPTION WHEN OTHERS THEN
                    RAISERROR 103 'SP_PACCON: Erro Na Atualização de SPVISCON 2.';
                END;
              END IF;

          EXCEPTION
              WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro Na Atualização de R070CON';
          END;
      ELSE
         /* insere na tabela R070CON */
         BEGIN
             INSERT INTO R070CON(
                         NUMCRA,NUMFIS,TIPCRA,SITCRA,NIVATU,DATNIV,HORNIV,SEQNIV,
                         INIVAL,DATVAL,INIAFA, DATAFA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                         SENCOL,MSGACC,DATMSG,QTDMSG,MSGATU,
                         CONIAL,TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,
                         CONPAC,TEMPAC,TOLACP,BLOAUT,BLOFAL,
                         CREAC1,CREFX1,QTDCR1,CREAC2,CREFX2,QTDCR2,
                         CREAC3,CREFX3,QTDCR3,CREAC4,CREFX4,QTDCR4,
                         CREAC5,CREFX5,QTDCR5,CREAC6,CREFX6,QTDCR6,
                         PRMRT1,DINPR1,DFNPR1,PRMRT2,DINPR2,DFNPR2,PRMRT3,DINPR3,DFNPR3,
                         FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,FAIAC7,
                         FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,FAIREF,
                         TECCRA,CHCPRI,IDTPES,GRACON,CONINT,TOLINT,VALAUT,
                         NOMFUN,NUMPIS,CONREA,
                         NOMPES,DDIFON,DDDFON,NUMFON,QTDPRV,PESBLO,DESBLO,TIPDOC,NUMDOC,
                         RECVIS,PROPRE,NUMEMP,TIPCOL,NUMCAD,NUMMAT,PROPAC,NUMCAN,USARFA)
             VALUES(
                         p_numcra,l_crapri,l_tipcra,l_situa,l_subnv,l_data_atual,
                         l_hora_atual,l_segu_atual,l_inival,l_auxval,
                         '0000000000000000','0000000000000000',l_codprm,l_codprm,
                         l_codprm,l_codprm,l_codig,l_desmsg,l_datmsgaux,l_qtdmsg,l_qtdmsg,
                         0,0,0,l_usabio,l_VerPrm,0,l_anti_dupla,l_concre,l_conpac,l_tempac,l_tolacp,l_vis_esp,0,
                         l_crefx1,l_fx1,l_crefx1,l_crefx2,l_fx2,l_crefx2,
                         l_crefx3,l_fx3,l_crefx3,l_crefx4,l_fx4,l_crefx4,
                         l_crefx5,l_fx5,l_crefx5,l_crefx6,l_fx6,l_crefx6,
                         l_grupo1,l_iniAr1,l_fimAr1,l_grupo2,l_iniAr2,l_fimAr2,
                         l_grupo3,l_iniAr3,l_fimAr3,
                         l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                         l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                         l_fairef,l_teccra,0,l_idtpes,l_gracon,l_conInt_Int,l_tolInt,l_ValAut,
                         l_nomfun,l_numpis,l_conrea,
                         l_nompes,l_ddifon,l_dddfon,l_numfon,l_qtdprv,l_pesblo,l_desblo,p_tipdoc,p_numdoc,
                         0, 0, 0, 0, 0, '0', p_propac, 0, l_usarfa);
         EXCEPTION
             WHEN OTHERS THEN      RAISERROR 103 'SP_PACCON: Erro no INSERT Tabela R070CON.';

         END;

      END IF;
      /*Atualiza Pend_Grupo*/
      IF (l_numsma > 0) THEN
          /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
          IF (l_tecpri = 3) THEN
              SP_ATUPRM(p_numcra, l_numsma, l_codprm, l_grupo1, l_grupo2, l_grupo3, l_codprm, l_codprm, l_codprm);
          ELSE
              SP_ATUPRM(l_crapri, l_numsma, l_codprm, l_grupo1, l_grupo2, l_grupo3, l_codprm, l_codprm, l_codprm);
          END IF;
      END IF;


      /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
      IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
          SP_PEND21(l_crapri);
      END IF;

      /*Atualiza os demais Crachás*/
      /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
      IF (l_tecpri = 1) THEN
          /*Atualiza o crachá de proximidade*/
          IF (l_numpro <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numpro, l_numpro_ret OUT);
                /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numpro);
              END IF;
          END IF;
          /*Atualiza o crachá Smart*/
          IF (l_numsma <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numsma, l_numsma_ret OUT);
              /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numsma);
              END IF;
          END IF;
      /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
      ELSIF (l_tecpri = 2) THEN
          /*Atualiza o crachá Smart*/
          IF (l_numsma <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numsma, l_numsma_ret OUT);
              /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numsma);
              END IF;
          END IF;
      END IF;
      /*Verifica se Gera o Comando IncludePerson*/
      IF (l_iPerson = TRUE) THEN
          /*Gera o Include Person*/
          SP_PEND19(p_numcra, l_idtpes);
          /*Atualiza os créditos somente se o mesmo já não foi atualizado*/
          IF (l_atucreloc = FALSE) THEN
              /*Atualiza os créditos sem local físico*/
              SP_PEND06(1, l_idtpes, l_verplf, 0);
              /*Atualiza os créditos por local físico da pessoa*/
              SP_ATUCRELOC(l_idtpes);
          END IF;
      END IF;
  END IF;
  IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
    l_creacc_bol := TRUE;
  ELSE
    l_creacc_bol := FALSE;
  END IF;
  IF (p_subnv = 1) THEN
    l_subnv_bol := TRUE;
  ELSE
    l_subnv_bol := FALSE;
  END IF;

  /*Atualiza a Controle*/
  IF (l_pode_ignorar = FALSE) THEN
    SP_ATUTSI(l_idtpes, l_crapri, l_creacc_bol, TRUE, l_subnv_bol, TRUE);
  END IF;
END		SENIOR;21ÁSP_DATSTR
SP_INTSTR
SP_RETCRP
SP_RETCAP
SP_MAPFIS
SP_PRMAMB
SP_RETFON
SP_PEND26
SP_RESETCRED
SP_ATUPRM
SP_PEND21
SP_VERCON
SP_ATUFIS
SP_PEND19
SP_PEND06
SP_ATUCRELOC
SP_ATUTSI
ˆY␀␀


PROCEDURE SP_PACCON(P_TIPPES NUMBER(2),P_PROPAC VARCHAR2(20),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER,P_VERPLF NUMBER(3),P_CODPLF NUMBER(5),P_DATINI DATE,P_HORINI NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_SUBNV NUMBER(1),P_CREACC NUMBER(1))
 IS

l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numpro_ret   BOOLEAN;
  l_numsma       NUMBER(12);
  l_numsma_ret   BOOLEAN;
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_teccra       NUMBER(1);
  l_inival       CHAR(16);
  l_tipcra       NUMBER(2);
  l_codig        CHAR(6);
  l_situa        CHAR(1);
  l_situaAnt     CHAR(1);
  l_subnv        CHAR(5);
  l_faixa        CHAR(56);
  l_fairef       CHAR(56);
  l_datahora     CHAR(10);
  l_desmsg       VARCHAR2(32);
  l_qtdmsg       CHAR(2);
  l_crefx1       CHAR(2);
  l_fx1          CHAR(8);
  l_crefx2       CHAR(2);
  l_fx2          CHAR(8);
  l_crefx3       CHAR(2);
  l_fx3          CHAR(8);
  l_crefx4       CHAR(2);
  l_fx4          CHAR(8);
  l_crefx5       CHAR(2);
  l_fx5          CHAR(8);
  l_crefx6       CHAR(2);
  l_fx6          CHAR(8);
  l_datmsgaux    CHAR(16);
  l_qtdIdtPes    NUMBER(2);
  l_count        NUMBER(4);
  l_iPerson      BOOLEAN;
  l_datano       NUMBER(4);
  l_usarfastr    CHAR(1);
  l_usarfa       NUMBER(1);

  /* Controle de Areas Restritas */
  l_grupo1       CHAR(5);
  l_iniAR1       CHAR(10);
  l_fimAR1       CHAR(10);
  l_grupo2       CHAR(5);
  l_iniAR2       CHAR(10);
  l_fimAR2       CHAR(10);
  l_grupo3       CHAR(5);
  l_iniAR3       CHAR(10);
  l_fimAR3       CHAR(10);

  /* Definições de acesso por visitante */
  l_anti_dupla   CHAR(1); /* Controla Anti-Dupla */
  l_vis_esp      CHAR(1); /* se for visitante especial bloqueia automaticamente na saida. */
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_numcra       CHAR(12);
  l_comando_nulo BOOLEAN;
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_datstr_ini   CHAR(6);
  l_horstr_ini   CHAR(4);
  l_concre       NUMBER(1);
  l_conrea       NUMBER(1);
  l_gercrv       CHAR(1);
  l_usabio       NUMBER(1);
  l_VerPrm       NUMBER(1);
  l_gracon       NUMBER(3);
  l_auxval       CHAR(16);
  l_creacc_bol   BOOLEAN;
  l_subnv_bol    BOOLEAN;
  l_ValAut       NUMBER(1);
  /*Interjornadas*/
  l_ConInt_int   NUMBER(1);
  l_TolInt       NUMBER(3);
  l_conpac       NUMBER(1);
  l_tempac       NUMBER(3);
  l_tolacp       NUMBER(2);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_hora_tol     NUMBER(4);
  l_pode_ignorar BOOLEAN;
  l_segu_atual   NUMBER(2);
  l_codprm       NUMBER;
  l_tipdoc       CHAR(1);
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_uticcr       CHAR(1);
  l_atucreloc    BOOLEAN;
  l_verplf       NUMBER(3);
  l_nompes       VARCHAR2(40);
  l_ddifon       NUMBER(3);
  l_dddfon       NUMBER(3);
  l_numfon       VARCHAR2(20);
  l_qtdprv       NUMBER(2);
  l_pesblo       NUMBER(1);
  l_desblo       VARCHAR(29);
  l_numcracex    NUMBER(12);
BEGIN
  l_atucreloc  := FALSE;
  l_nompes := '';
  l_ddifon := 0;
  l_dddfon := 0;
  l_numfon := '';
  l_qtdprv := 0;
  l_pesblo := 0;
  l_desblo := '';
  l_pode_ignorar := FALSE;

  /* Busca parametro que indica se utiliza compra. */
  BEGIN
     SELECT UTICCR INTO l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_uticcr := 'N';
  END;

  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_hora_tol := l_hora_atual + 5;
  IF (l_hora_tol > 1439) THEN
    l_hora_tol := 1439;
  END IF;
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_segu_atual := SECOND(CURTIME());

  IF (p_datini > l_data_atual OR (p_datini = l_data_atual AND P_HORINI >= l_hora_tol)) THEN
    l_pode_ignorar := TRUE;
  END IF;

  IF (p_numcra > 0 AND l_pode_ignorar = FALSE) THEN
      /*Inicializações*/
      l_iPerson := FALSE;
      l_concre := 0;
      l_conrea := 1;
      l_crefx1 := '00';
      l_crefx2 := '00';
      l_crefx3 := '00';
      l_crefx4 := '00';
      l_crefx5 := '00';
      l_crefx6 := '00';
      l_fx1 := '24002400';
      l_fx2 := '24002400';
      l_fx3 := '24002400';
      l_fx4 := '24002400';
      l_fx5 := '24002400';
      l_fx6 := '24002400';
      /* Inicializa Areas Restritas */
      l_grupo1 := '00000';
      l_iniAR1 := '0000000000';
      l_fimAR1 := '0000000000';
      l_grupo2 := '00000';
      l_iniAR2 := '0000000000';
      l_fimAR2 := '0000000000';
      l_grupo3 := '00000';
      l_iniAR3 := '0000000000';
      l_fimAR3 := '0000000000';
      l_vis_esp     := '0';
      l_subnv       := '99000';
      l_gercrv      :='N';
      l_anti_dupla  := '1';
      /*Biometria*/
      l_usabio      := 1;
      l_verprm      := 1;
      l_gracon      := 50;
      l_usarfastr   := 'N';
      /*Interjornadas*/
      l_ConInt_int := 0;
      l_TolInt := 0;
      l_conpac := 0;
      l_tempac := 0;
      l_tolacp := 0;
      l_desmsg := '                                ';
      l_qtdmsg := '0';
      l_datmsgaux  := '0000000000000000';
      l_codig := '';
      l_situa  := '0';
      l_situaAnt:= '1';
      l_faixa  := '00002359240024002400240024002400240024002400240024002400';
      l_fairef := '24002400240024002400240024002400240024002400240024002400';
      l_nomfun := '';
      l_numpis := 0;
      /*Busca versão do plano ativa*/
      BEGIN
          SELECT VERPLF INTO l_verplf
            FROM R058VPL
           WHERE DATCRI <= l_data_atual
             AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
      EXCEPTION
          WHEN OTHERS THEN
              l_verplf := 1;
      END;
      /*Se a data inicial for menor do que 1980, então considera como 01/01/1980*/
      l_datano := Year(p_datini);
      IF (l_datano < 1980) THEN
         l_inival := '0101802359000000';
      ELSE
         /*obtem a data inicial do crachá*/
         SP_DATSTR(p_datini,'DDMMYY',l_datstr_ini OUT);
         SP_INTSTR(p_horini,'HHMM',l_horstr_ini OUT);
         l_inival := l_datstr_ini||l_horstr_ini||'000000';
      END IF;

      /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
      SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

      IF (l_crapri = 0) THEN
         l_crapri := p_numcra;
         /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
         l_teccra := 1;
      ELSE
         l_teccra := l_tecpri;
      END IF;

      /* Atualiza R070CON */
      l_comando_nulo:=FALSE;
      BEGIN
          SELECT NUMFIS,SITCRA INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
      EXCEPTION
          WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_PACCON: Erro em R070CON - TOO MANY ROWS';
          WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro no SELECT R070CON 5.';
      END;

      /* Monta o identificador do paciente ou acompanhante de paciente */
      SP_INTSTR(p_tippes,'99',l_tippes OUT);
      l_tipcra := p_tippes;

      /*Se for paciente que está atualizando...*/
      IF (p_tippes = 9) THEN
          /* Busca definições de créditos de acesso para pacientes/acompanhantes. */
          BEGIN
              SELECT CREPAC INTO l_concre FROM R070DAC;
          EXCEPTION
              WHEN OTHERS THEN l_concre := 0;
          END;

          IF ((l_comando_nulo = FALSE) AND (p_creacc = 1) AND (l_uticcr = 'N')) THEN
          	  /* marca como atualizado os créditos da pessoa */
          	  l_atucreloc := TRUE;
              /*reseta os créditos do paciente*/
              SP_RESETCRED(p_tippes, 0, 0, 0, 0, '0', '0', p_propac);
          END IF;

          SP_RETCRP (p_propac, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);

          /* Busca definição 'Utiliza Reconhecimento Facial' para pacientes */
          BEGIN
              SELECT R097TIN.USARFA INTO l_usarfastr FROM R097INT, R097TIN
               WHERE R097INT.CODTIN = R097TIN.CODTIN AND R097INT.PROPAC = p_propac AND ((
                     ((r097int.DATINI < p_datini) OR ((r097int.DATINI = p_datini) AND (r097int.HORINI <= p_horini)) )AND
                      ((r097int.DATFIM > p_datini) OR ((r097int.DATFIM = p_datini) AND (r097int.HORFIM >= p_horini)) OR (r097int.DATFIM = l_data_zero))));
          EXCEPTION
              WHEN OTHERS THEN l_usarfastr := 'N';
          END;

          l_idtpes := l_tippes||p_propac;

      /*Se for acompanhante de paciente que está atualizando...*/
      ELSIF (p_tippes = 11) THEN
          /* Busca definições de créditos de acesso para acompanhantes de pacientes */
          BEGIN
              SELECT R097TIN.CONCRE, R097TIN.GRACON, R097TIN.USABIO, R097TIN.USARAC INTO l_concre, l_gracon, l_usabio, l_usarfastr FROM R097INT, R097TIN
               WHERE R097INT.CODTIN = R097TIN.CODTIN AND R097INT.PROPAC = p_propac AND ((
                     ((r097int.DATINI < p_datini) OR ((r097int.DATINI = p_datini) AND (r097int.HORINI <= p_horini)) )AND
                      ((r097int.DATFIM > p_datini) OR ((r097int.DATFIM = p_datini) AND (r097int.HORFIM >= p_horini)) OR (r097int.DATFIM = l_data_zero))));
          EXCEPTION
              WHEN OTHERS THEN l_concre := 0; l_gracon := 50; l_usabio := 1; l_usarfastr := 'N';
          END;

          IF ((l_comando_nulo = FALSE) AND (p_creacc = 1) AND (l_uticcr = 'N')) THEN
          	  /* marca como atualizado os créditos da pessoa */
          	  l_atucreloc := TRUE;
              /*reseta os créditos do acompanhante de paciente*/
              SP_RESETCRED(p_tippes, 0, 0, 0, p_tipdoc, p_numdoc, '0', '0');
          END IF;

          SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
          SP_RETCAP (l_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);

          /*Monta o Identificador da Pessoa*/
          l_idtpes := l_tippes||l_tipdoc||p_numdoc;
      ELSE
          SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
          /*Monta o Identificador da Pessoa*/
          l_idtpes := l_tippes||l_tipdoc||p_numdoc;
      END IF;

      /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);

      LOOP
         /*Controle do Loop.*/
         IF (Length(l_idtpes) > 22) THEN
             EXIT;
         END IF;
         l_idtpes := ' '||l_idtpes;
      END LOOP;

      SP_DATSTR(p_datval,'DDMMYY',l_datstr OUT);
      SP_INTSTR(p_horval,'HHMM',l_horstr OUT);
      /* corrige a data se vier com valor zero */
      IF  (l_datstr = '311200') THEN
         l_datstr :=  '311250';
      END IF;
      IF  (l_horstr = '0000') THEN
         l_horstr :=  '2359';
      END IF;
      l_datahora := l_datstr || l_horstr;
      l_auxval := l_datahora||'000000';

      /*Obtem a permissão da pessoa*/
      SP_PRMAMB(p_verplf, p_codplf, l_codprm OUT);

      /* verifica se o crachá é de uma nova entrada */
      IF  (l_situaAnt = '1') THEN
          l_subnv := '99000';
      END IF;

      /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
      BEGIN
          SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON WHERE IDTPES = l_idtpes;
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro No SELECT R070CON (IdtPes).';
      END;

      IF (l_qtdIdtPes > 0) THEN
          l_iPerson := FALSE;
      ELSE
          l_iPerson := TRUE;
      END IF;

      /* verifica se possui registros na tabela R090VAU.. Se possuir, ValAut = 1 */
      l_count := 0;
      BEGIN
          SELECT COUNT(*) INTO l_count FROM R090VAU WHERE IDTPES = l_idtpes AND
                 (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                 (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro No SELECT R090VAU (IdtPes).';
      END;

      /* necessita de validação por autorizador */
      l_ValAut := 0;
      IF  (l_count > 0) THEN
          l_ValAut := 1;
      END IF;

      SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

      l_numcracex := 0;
      BEGIN
          SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
      EXCEPTION
      	WHEN OTHERS THEN NULL;
      END;

      IF (l_numcracex = p_numcra) THEN
        l_situa := '1';
      END IF;

      /* Assinala na tabela Controle que o Paciente ou Acomp. de Paciente utiliza reconhecimento facial */
      IF  l_usarfastr = 'S' THEN
          l_usarfa := 1;
      ELSE
          l_usarfa := 0;
      END IF;

      IF (l_comando_nulo = FALSE) THEN
          /* atualiza a tabela R070CON */
          BEGIN
              UPDATE R070CON SET
                     NUMCRA=p_numcra, TIPCRA=l_tipcra, SENCOL= l_codig,INIAFA= '0000000000000000',
                     DATAFA='0000000000000000',
                     CODPRM=l_codprm, PRMSAB=l_codprm, PRMDOM=l_codprm, PRMFER=l_codprm,
                     SITCRA=l_situa, INIVAL = l_inival, DATVAL=l_auxval,
                     MSGACC=l_desmsg, DATMSG=l_datmsgaux, QTDMSG=l_qtdmsg,
                     CONADP=l_anti_dupla, CONCRE=l_concre,
                     CREAC1=l_crefx1,CREFX1=l_fx1,QTDCR1=l_crefx1,
                     CREAC2=l_crefx2,CREFX2=l_fx2,QTDCR2=l_crefx2,
                     CREAC3=l_crefx3,CREFX3=l_fx3,QTDCR3=l_crefx3,
                     CREAC4=l_crefx4,CREFX4=l_fx4,QTDCR4=l_crefx4,
                     CREAC5=l_crefx5,CREFX5=l_fx5,QTDCR5=l_crefx5,
                     CREAC6=l_crefx6,CREFX6=l_fx6,QTDCR6=l_crefx6,
                     PRMRT1=l_grupo1, DINPR1=l_iniAr1, DFNPR1=l_fimAr1,
                     PRMRT2=l_grupo2, DINPR2=l_iniAr2, DFNPR2=l_fimAr2,
                     PRMRT3=l_grupo3, DINPR3=l_iniAr3, DFNPR3=l_fimAr3,
                     TECCRA=l_teccra, CHCPRI=0, IDTPES=l_idtpes, USABIO=l_usabio, GRACON=l_gracon,
                     CONINT=l_conInt_Int, TOLINT=l_tolInt, CONPAC=l_conpac, TEMPAC=l_tempac,
                     TOLACP=l_tolacp, VALAUT=l_ValAut, NOMFUN=l_nomfun, NUMPIS=l_numpis, CONREA=l_conrea,
                     NOMPES=l_nompes, DDIFON=l_ddifon, DDDFON=l_dddfon, NUMFON=l_numfon, QTDPRV=l_qtdprv,
                     PESBLO=l_pesblo, DESBLO=l_desblo, TIPDOC=p_tipdoc, NUMDOC=p_numdoc, BLOAUT=l_vis_esp,
                     NUMEMP=0, TIPCOL=0, NUMCAD=0, NUMMAT='0', PROPAC=p_propac, NUMCAN=0, USARFA=l_usarfa
              WHERE NUMFIS = l_crapri;

              /* Verifica se atualiza SubNv*/
              IF (p_subnv = 1) THEN
                BEGIN
                    UPDATE R070CON SET
                         NIVATU = '99000', DATNIV = l_data_atual, HORNIV = l_hora_atual, SEQNIV = l_segu_atual
                    WHERE IDTPES = l_idtpes;
                    /*Gera pendência de atualização de nível*/
                    SP_PEND26(l_idtpes, '99000', l_data_atual, l_hora_atual, l_segu_atual);
                EXCEPTION WHEN OTHERS THEN
                    RAISERROR 103 'SP_PACCON: Erro Na Atualização de SPVISCON 2.';
                END;
              END IF;

          EXCEPTION
              WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro Na Atualização de R070CON';
          END;
      ELSE
         /* insere na tabela R070CON */
         BEGIN
             INSERT INTO R070CON(
                         NUMCRA,NUMFIS,TIPCRA,SITCRA,NIVATU,DATNIV,HORNIV,SEQNIV,
                         INIVAL,DATVAL,INIAFA, DATAFA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                         SENCOL,MSGACC,DATMSG,QTDMSG,MSGATU,
                         CONIAL,TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,
                         CONPAC,TEMPAC,TOLACP,BLOAUT,BLOFAL,
                         CREAC1,CREFX1,QTDCR1,CREAC2,CREFX2,QTDCR2,
                         CREAC3,CREFX3,QTDCR3,CREAC4,CREFX4,QTDCR4,
                         CREAC5,CREFX5,QTDCR5,CREAC6,CREFX6,QTDCR6,
                         PRMRT1,DINPR1,DFNPR1,PRMRT2,DINPR2,DFNPR2,PRMRT3,DINPR3,DFNPR3,
                         FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,FAIAC7,
                         FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,FAIREF,
                         TECCRA,CHCPRI,IDTPES,GRACON,CONINT,TOLINT,VALAUT,
                         NOMFUN,NUMPIS,CONREA,
                         NOMPES,DDIFON,DDDFON,NUMFON,QTDPRV,PESBLO,DESBLO,TIPDOC,NUMDOC,
                         RECVIS,PROPRE,NUMEMP,TIPCOL,NUMCAD,NUMMAT,PROPAC,NUMCAN,USARFA)
             VALUES(
                         p_numcra,l_crapri,l_tipcra,l_situa,l_subnv,l_data_atual,
                         l_hora_atual,l_segu_atual,l_inival,l_auxval,
                         '0000000000000000','0000000000000000',l_codprm,l_codprm,
                         l_codprm,l_codprm,l_codig,l_desmsg,l_datmsgaux,l_qtdmsg,l_qtdmsg,
                         0,0,0,l_usabio,l_VerPrm,0,l_anti_dupla,l_concre,l_conpac,l_tempac,l_tolacp,l_vis_esp,0,
                         l_crefx1,l_fx1,l_crefx1,l_crefx2,l_fx2,l_crefx2,
                         l_crefx3,l_fx3,l_crefx3,l_crefx4,l_fx4,l_crefx4,
                         l_crefx5,l_fx5,l_crefx5,l_crefx6,l_fx6,l_crefx6,
                         l_grupo1,l_iniAr1,l_fimAr1,l_grupo2,l_iniAr2,l_fimAr2,
                         l_grupo3,l_iniAr3,l_fimAr3,
                         l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                         l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                         l_fairef,l_teccra,0,l_idtpes,l_gracon,l_conInt_Int,l_tolInt,l_ValAut,
                         l_nomfun,l_numpis,l_conrea,
                         l_nompes,l_ddifon,l_dddfon,l_numfon,l_qtdprv,l_pesblo,l_desblo,p_tipdoc,p_numdoc,
                         0, 0, 0, 0, 0, '0', p_propac, 0, l_usarfa);
         EXCEPTION
             WHEN OTHERS THEN      RAISERROR 103 'SP_PACCON: Erro no INSERT Tabela R070CON.';

         END;

      END IF;
      /*Atualiza Pend_Grupo*/
      IF (l_numsma > 0) THEN
          /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
          IF (l_tecpri = 3) THEN
              SP_ATUPRM(p_numcra, l_numsma, l_codprm, l_grupo1, l_grupo2, l_grupo3, l_codprm, l_codprm, l_codprm);
          ELSE
              SP_ATUPRM(l_crapri, l_numsma, l_codprm, l_grupo1, l_grupo2, l_grupo3, l_codprm, l_codprm, l_codprm);
          END IF;
      END IF;


      /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
      IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
          SP_PEND21(l_crapri);
      END IF;

      /*Atualiza os demais Crachás*/
      /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
      IF (l_tecpri = 1) THEN
          /*Atualiza o crachá de proximidade*/
          IF (l_numpro <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numpro, l_numpro_ret OUT);
                /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numpro);
              END IF;
          END IF;
          /*Atualiza o crachá Smart*/
          IF (l_numsma <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numsma, l_numsma_ret OUT);
              /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numsma);
              END IF;
          END IF;
      /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
      ELSIF (l_tecpri = 2) THEN
          /*Atualiza o crachá Smart*/
          IF (l_numsma <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numsma, l_numsma_ret OUT);
              /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numsma);
              END IF;
          END IF;
      END IF;
      /*Verifica se Gera o Comando IncludePerson*/
      IF (l_iPerson = TRUE) THEN
          /*Gera o Include Person*/
          SP_PEND19(p_numcra, l_idtpes);
          /*Atualiza os créditos somente se o mesmo já não foi atualizado*/
          IF (l_atucreloc = FALSE) THEN
              /*Atualiza os créditos sem local físico*/
              SP_PEND06(1, l_idtpes, l_verplf, 0);
              /*Atualiza os créditos por local físico da pessoa*/
              SP_ATUCRELOC(l_idtpes);
          END IF;
      END IF;
  END IF;
  IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
    l_creacc_bol := TRUE;
  ELSE
    l_creacc_bol := FALSE;
  END IF;
  IF (p_subnv = 1) THEN
    l_subnv_bol := TRUE;
  ELSE
    l_subnv_bol := FALSE;
  END IF;

  /*Atualiza a Controle*/
  IF (l_pode_ignorar = FALSE) THEN
    SP_ATUTSI(l_idtpes, l_crapri, l_creacc_bol, TRUE, l_subnv_bol, TRUE);
  END IF;
END		SENIOR;22ÁSP_DATSTR
SP_INTSTR
SP_RETCRP
SP_RETCAP
SP_MAPFIS
SP_PRMAMB
SP_RETFON
SP_PEND26
SP_RESETCRED
SP_ATUPRM
SP_PEND21
SP_VERCON
SP_ATUFIS
SP_PEND19
SP_PEND06
SP_ATUCRELOC
SP_ATUTSI
ˆY␀␀


PROCEDURE SP_PACCON(P_TIPPES NUMBER(2),P_PROPAC VARCHAR2(20),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER,P_VERPLF NUMBER(3),P_CODPLF NUMBER(5),P_DATINI DATE,P_HORINI NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_SUBNV NUMBER(1),P_CREACC NUMBER(1))
 IS

l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numpro_ret   BOOLEAN;
  l_numsma       NUMBER(12);
  l_numsma_ret   BOOLEAN;
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_teccra       NUMBER(1);
  l_inival       CHAR(16);
  l_tipcra       NUMBER(2);
  l_codig        CHAR(6);
  l_situa        CHAR(1);
  l_situaAnt     CHAR(1);
  l_subnv        CHAR(5);
  l_faixa        CHAR(56);
  l_fairef       CHAR(56);
  l_datahora     CHAR(10);
  l_desmsg       VARCHAR2(32);
  l_qtdmsg       CHAR(2);
  l_crefx1       CHAR(2);
  l_fx1          CHAR(8);
  l_crefx2       CHAR(2);
  l_fx2          CHAR(8);
  l_crefx3       CHAR(2);
  l_fx3          CHAR(8);
  l_crefx4       CHAR(2);
  l_fx4          CHAR(8);
  l_crefx5       CHAR(2);
  l_fx5          CHAR(8);
  l_crefx6       CHAR(2);
  l_fx6          CHAR(8);
  l_datmsgaux    CHAR(16);
  l_qtdIdtPes    NUMBER(2);
  l_count        NUMBER(4);
  l_iPerson      BOOLEAN;
  l_datano       NUMBER(4);
  l_usarfastr    CHAR(1);
  l_usarfa       NUMBER(1);

  /* Controle de Areas Restritas */
  l_grupo1       CHAR(5);
  l_iniAR1       CHAR(10);
  l_fimAR1       CHAR(10);
  l_grupo2       CHAR(5);
  l_iniAR2       CHAR(10);
  l_fimAR2       CHAR(10);
  l_grupo3       CHAR(5);
  l_iniAR3       CHAR(10);
  l_fimAR3       CHAR(10);

  /* Definições de acesso por visitante */
  l_anti_dupla   CHAR(1); /* Controla Anti-Dupla */
  l_vis_esp      CHAR(1); /* se for visitante especial bloqueia automaticamente na saida. */
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_numcra       CHAR(12);
  l_comando_nulo BOOLEAN;
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_datstr_ini   CHAR(6);
  l_horstr_ini   CHAR(4);
  l_concre       NUMBER(1);
  l_conrea       NUMBER(1);
  l_gercrv       CHAR(1);
  l_usabio       NUMBER(1);
  l_VerPrm       NUMBER(1);
  l_gracon       NUMBER(3);
  l_auxval       CHAR(16);
  l_creacc_bol   BOOLEAN;
  l_subnv_bol    BOOLEAN;
  l_ValAut       NUMBER(1);
  /*Interjornadas*/
  l_ConInt_int   NUMBER(1);
  l_TolInt       NUMBER(3);
  l_conpac       NUMBER(1);
  l_tempac       NUMBER(3);
  l_tolacp       NUMBER(2);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_hora_tol     NUMBER(4);
  l_pode_ignorar BOOLEAN;
  l_segu_atual   NUMBER(2);
  l_codprm       NUMBER;
  l_tipdoc       CHAR(1);
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_uticcr       CHAR(1);
  l_atucreloc    BOOLEAN;
  l_verplf       NUMBER(3);
  l_nompes       VARCHAR2(40);
  l_ddifon       NUMBER(3);
  l_dddfon       NUMBER(3);
  l_numfon       VARCHAR2(20);
  l_qtdprv       NUMBER(2);
  l_pesblo       NUMBER(1);
  l_desblo       VARCHAR(29);
  l_numcracex    NUMBER(12);
BEGIN
  l_atucreloc  := FALSE;
  l_nompes := '';
  l_ddifon := 0;
  l_dddfon := 0;
  l_numfon := '';
  l_qtdprv := 0;
  l_pesblo := 0;
  l_desblo := '';
  l_pode_ignorar := FALSE;

  /* Busca parametro que indica se utiliza compra. */
  BEGIN
     SELECT UTICCR INTO l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_uticcr := 'N';
  END;

  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_hora_tol := l_hora_atual + 5;
  IF (l_hora_tol > 1439) THEN
    l_hora_tol := 1439;
  END IF;
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_segu_atual := SECOND(CURTIME());

  IF (p_datini > l_data_atual OR (p_datini = l_data_atual AND P_HORINI >= l_hora_tol)) THEN
    l_pode_ignorar := TRUE;
  END IF;

  IF (p_numcra > 0 AND l_pode_ignorar = FALSE) THEN
      /*Inicializações*/
      l_iPerson := FALSE;
      l_concre := 0;
      l_conrea := 1;
      l_crefx1 := '00';
      l_crefx2 := '00';
      l_crefx3 := '00';
      l_crefx4 := '00';
      l_crefx5 := '00';
      l_crefx6 := '00';
      l_fx1 := '24002400';
      l_fx2 := '24002400';
      l_fx3 := '24002400';
      l_fx4 := '24002400';
      l_fx5 := '24002400';
      l_fx6 := '24002400';
      /* Inicializa Areas Restritas */
      l_grupo1 := '00000';
      l_iniAR1 := '0000000000';
      l_fimAR1 := '0000000000';
      l_grupo2 := '00000';
      l_iniAR2 := '0000000000';
      l_fimAR2 := '0000000000';
      l_grupo3 := '00000';
      l_iniAR3 := '0000000000';
      l_fimAR3 := '0000000000';
      l_vis_esp     := '0';
      l_subnv       := '99000';
      l_gercrv      :='N';
      l_anti_dupla  := '1';
      /*Biometria*/
      l_usabio      := 1;
      l_verprm      := 1;
      l_gracon      := 50;
      l_usarfastr   := 'N';
      /*Interjornadas*/
      l_ConInt_int := 0;
      l_TolInt := 0;
      l_conpac := 0;
      l_tempac := 0;
      l_tolacp := 0;
      l_desmsg := '                                ';
      l_qtdmsg := '0';
      l_datmsgaux  := '0000000000000000';
      l_codig := '';
      l_situa  := '0';
      l_situaAnt:= '1';
      l_faixa  := '00002359240024002400240024002400240024002400240024002400';
      l_fairef := '24002400240024002400240024002400240024002400240024002400';
      l_nomfun := '';
      l_numpis := 0;
      /*Busca versão do plano ativa*/
      BEGIN
          SELECT VERPLF INTO l_verplf
            FROM R058VPL
           WHERE DATCRI <= l_data_atual
             AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
      EXCEPTION
          WHEN OTHERS THEN
              l_verplf := 1;
      END;
      /*Se a data inicial for menor do que 1980, então considera como 01/01/1980*/
      l_datano := Year(p_datini);
      IF (l_datano < 1980) THEN
         l_inival := '0101802359000000';
      ELSE
         /*obtem a data inicial do crachá*/
         SP_DATSTR(p_datini,'DDMMYY',l_datstr_ini OUT);
         SP_INTSTR(p_horini,'HHMM',l_horstr_ini OUT);
         l_inival := l_datstr_ini||l_horstr_ini||'000000';
      END IF;

      /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
      SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

      IF (l_crapri = 0) THEN
         l_crapri := p_numcra;
         /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
         l_teccra := 1;
      ELSE
         l_teccra := l_tecpri;
      END IF;

      /* Atualiza R070CON */
      l_comando_nulo:=FALSE;
      BEGIN
          SELECT NUMFIS,SITCRA INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
      EXCEPTION
          WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_PACCON: Erro em R070CON - TOO MANY ROWS';
          WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro no SELECT R070CON 5.';
      END;

      /* Monta o identificador do paciente ou acompanhante de paciente */
      SP_INTSTR(p_tippes,'99',l_tippes OUT);
      l_tipcra := p_tippes;

      /*Se for paciente que está atualizando...*/
      IF (p_tippes = 9) THEN
          /* Busca definições de créditos de acesso para pacientes/acompanhantes. */
          BEGIN
              SELECT CREPAC INTO l_concre FROM R070DAC;
          EXCEPTION
              WHEN OTHERS THEN l_concre := 0;
          END;

          IF ((l_comando_nulo = FALSE) AND (p_creacc = 1) AND (l_uticcr = 'N')) THEN
          	  /* marca como atualizado os créditos da pessoa */
          	  l_atucreloc := TRUE;
              /*reseta os créditos do paciente*/
              SP_RESETCRED(p_tippes, 0, 0, 0, 0, '0', '0', p_propac);
          END IF;

          SP_RETCRP (p_propac, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);

          /* Busca definição 'Utiliza Reconhecimento Facial' para pacientes */
          BEGIN
              SELECT R097TIN.USARFA INTO l_usarfastr FROM R097INT, R097TIN
               WHERE R097INT.CODTIN = R097TIN.CODTIN AND R097INT.PROPAC = p_propac AND ((
                     ((r097int.DATINI < p_datini) OR ((r097int.DATINI = p_datini) AND (r097int.HORINI <= p_horini)) )AND
                      ((r097int.DATFIM > p_datini) OR ((r097int.DATFIM = p_datini) AND (r097int.HORFIM >= p_horini)) OR (r097int.DATFIM = l_data_zero))));
          EXCEPTION
              WHEN OTHERS THEN l_usarfastr := 'N';
          END;

          l_idtpes := l_tippes||p_propac;

      /*Se for acompanhante de paciente que está atualizando...*/
      ELSIF (p_tippes = 11) THEN
          /* Busca definições de créditos de acesso para acompanhantes de pacientes */
          BEGIN
              SELECT R097TIN.CONCRE, R097TIN.GRACON, R097TIN.USABIO, R097TIN.USARAC INTO l_concre, l_gracon, l_usabio, l_usarfastr FROM R097INT, R097TIN
               WHERE R097INT.CODTIN = R097TIN.CODTIN AND R097INT.PROPAC = p_propac AND ((
                     ((r097int.DATINI < p_datini) OR ((r097int.DATINI = p_datini) AND (r097int.HORINI <= p_horini)) )AND
                      ((r097int.DATFIM > p_datini) OR ((r097int.DATFIM = p_datini) AND (r097int.HORFIM >= p_horini)) OR (r097int.DATFIM = l_data_zero))));
          EXCEPTION
              WHEN OTHERS THEN l_concre := 0; l_gracon := 50; l_usabio := 1; l_usarfastr := 'N';
          END;

          IF ((l_comando_nulo = FALSE) AND (p_creacc = 1) AND (l_uticcr = 'N')) THEN
          	  /* marca como atualizado os créditos da pessoa */
          	  l_atucreloc := TRUE;
              /*reseta os créditos do acompanhante de paciente*/
              SP_RESETCRED(p_tippes, 0, 0, 0, p_tipdoc, p_numdoc, '0', '0');
          END IF;

          SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
          SP_RETCAP (l_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);

          /*Monta o Identificador da Pessoa*/
          l_idtpes := l_tippes||l_tipdoc||p_numdoc;
      ELSE
          SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
          /*Monta o Identificador da Pessoa*/
          l_idtpes := l_tippes||l_tipdoc||p_numdoc;
      END IF;

      /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);

      LOOP
         /*Controle do Loop.*/
         IF (Length(l_idtpes) > 22) THEN
             EXIT;
         END IF;
         l_idtpes := ' '||l_idtpes;
      END LOOP;

      SP_DATSTR(p_datval,'DDMMYY',l_datstr OUT);
      SP_INTSTR(p_horval,'HHMM',l_horstr OUT);
      /* corrige a data se vier com valor zero */
      IF  (l_datstr = '311200') THEN
         l_datstr :=  '311250';
      END IF;
      IF  (l_horstr = '0000') THEN
         l_horstr :=  '2359';
      END IF;
      l_datahora := l_datstr || l_horstr;
      l_auxval := l_datahora||'000000';

      /*Obtem a permissão da pessoa*/
      SP_PRMAMB(p_verplf, p_codplf, l_codprm OUT);

      /* verifica se o crachá é de uma nova entrada */
      IF  (l_situaAnt = '1') THEN
          l_subnv := '99000';
      END IF;

      /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
      BEGIN
          SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON WHERE IDTPES = l_idtpes;
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro No SELECT R070CON (IdtPes).';
      END;

      IF (l_qtdIdtPes > 0) THEN
          l_iPerson := FALSE;
      ELSE
          l_iPerson := TRUE;
      END IF;

      /* verifica se possui registros na tabela R090VAU.. Se possuir, ValAut = 1 */
      l_count := 0;
      BEGIN
          SELECT COUNT(*) INTO l_count FROM R090VAU WHERE IDTPES = l_idtpes AND
                 (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                 (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro No SELECT R090VAU (IdtPes).';
      END;

      /* necessita de validação por autorizador */
      l_ValAut := 0;
      IF  (l_count > 0) THEN
          l_ValAut := 1;
      END IF;

      SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

      l_numcracex := 0;
      BEGIN
          SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
      EXCEPTION
      	WHEN OTHERS THEN NULL;
      END;

      IF (l_numcracex = p_numcra) THEN
        l_situa := '1';
      END IF;

      /* Assinala na tabela Controle que o Paciente ou Acomp. de Paciente utiliza reconhecimento facial */
      IF  l_usarfastr = 'S' THEN
          l_usarfa := 1;
      ELSE
          l_usarfa := 0;
      END IF;

      IF (l_comando_nulo = FALSE) THEN
          /* atualiza a tabela R070CON */
          BEGIN
              UPDATE R070CON SET
                     NUMCRA=p_numcra, TIPCRA=l_tipcra, SENCOL= l_codig,INIAFA= '0000000000000000',
                     DATAFA='0000000000000000',
                     CODPRM=l_codprm, PRMSAB=l_codprm, PRMDOM=l_codprm, PRMFER=l_codprm,
                     SITCRA=l_situa, INIVAL = l_inival, DATVAL=l_auxval,
                     MSGACC=l_desmsg, DATMSG=l_datmsgaux, QTDMSG=l_qtdmsg,
                     CONADP=l_anti_dupla, CONCRE=l_concre,
                     CREAC1=l_crefx1,CREFX1=l_fx1,QTDCR1=l_crefx1,
                     CREAC2=l_crefx2,CREFX2=l_fx2,QTDCR2=l_crefx2,
                     CREAC3=l_crefx3,CREFX3=l_fx3,QTDCR3=l_crefx3,
                     CREAC4=l_crefx4,CREFX4=l_fx4,QTDCR4=l_crefx4,
                     CREAC5=l_crefx5,CREFX5=l_fx5,QTDCR5=l_crefx5,
                     CREAC6=l_crefx6,CREFX6=l_fx6,QTDCR6=l_crefx6,
                     PRMRT1=l_grupo1, DINPR1=l_iniAr1, DFNPR1=l_fimAr1,
                     PRMRT2=l_grupo2, DINPR2=l_iniAr2, DFNPR2=l_fimAr2,
                     PRMRT3=l_grupo3, DINPR3=l_iniAr3, DFNPR3=l_fimAr3,
                     TECCRA=l_teccra, CHCPRI=0, IDTPES=l_idtpes, USABIO=l_usabio, GRACON=l_gracon,
                     CONINT=l_conInt_Int, TOLINT=l_tolInt, CONPAC=l_conpac, TEMPAC=l_tempac,
                     TOLACP=l_tolacp, VALAUT=l_ValAut, NOMFUN=l_nomfun, NUMPIS=l_numpis, CONREA=l_conrea,
                     NOMPES=l_nompes, DDIFON=l_ddifon, DDDFON=l_dddfon, NUMFON=l_numfon, QTDPRV=l_qtdprv,
                     PESBLO=l_pesblo, DESBLO=l_desblo, TIPDOC=p_tipdoc, NUMDOC=p_numdoc, BLOAUT=l_vis_esp,
                     NUMEMP=0, TIPCOL=0, NUMCAD=0, NUMMAT='0', PROPAC=p_propac, NUMCAN=0, USARFA=l_usarfa
              WHERE NUMFIS = l_crapri;

              /* Verifica se atualiza SubNv*/
              IF (p_subnv = 1) THEN
                BEGIN
                    UPDATE R070CON SET
                         NIVATU = '99000', DATNIV = l_data_atual, HORNIV = l_hora_atual, SEQNIV = l_segu_atual
                    WHERE IDTPES = l_idtpes;
                    /*Gera pendência de atualização de nível*/
                    SP_PEND26(l_idtpes, '99000', l_data_atual, l_hora_atual, l_segu_atual);
                EXCEPTION WHEN OTHERS THEN
                    RAISERROR 103 'SP_PACCON: Erro Na Atualização de SPVISCON 2.';
                END;
              END IF;

          EXCEPTION
              WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro Na Atualização de R070CON';
          END;
      ELSE
         /* insere na tabela R070CON */
         BEGIN
             INSERT INTO R070CON(
                         NUMCRA,NUMFIS,TIPCRA,SITCRA,NIVATU,DATNIV,HORNIV,SEQNIV,
                         INIVAL,DATVAL,INIAFA, DATAFA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                         SENCOL,MSGACC,DATMSG,QTDMSG,MSGATU,
                         CONIAL,TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,
                         CONPAC,TEMPAC,TOLACP,BLOAUT,BLOFAL,
                         CREAC1,CREFX1,QTDCR1,CREAC2,CREFX2,QTDCR2,
                         CREAC3,CREFX3,QTDCR3,CREAC4,CREFX4,QTDCR4,
                         CREAC5,CREFX5,QTDCR5,CREAC6,CREFX6,QTDCR6,
                         PRMRT1,DINPR1,DFNPR1,PRMRT2,DINPR2,DFNPR2,PRMRT3,DINPR3,DFNPR3,
                         FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,FAIAC7,
                         FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,FAIREF,
                         TECCRA,CHCPRI,IDTPES,GRACON,CONINT,TOLINT,VALAUT,
                         NOMFUN,NUMPIS,CONREA,
                         NOMPES,DDIFON,DDDFON,NUMFON,QTDPRV,PESBLO,DESBLO,TIPDOC,NUMDOC,
                         RECVIS,PROPRE,NUMEMP,TIPCOL,NUMCAD,NUMMAT,PROPAC,NUMCAN,USARFA)
             VALUES(
                         p_numcra,l_crapri,l_tipcra,l_situa,l_subnv,l_data_atual,
                         l_hora_atual,l_segu_atual,l_inival,l_auxval,
                         '0000000000000000','0000000000000000',l_codprm,l_codprm,
                         l_codprm,l_codprm,l_codig,l_desmsg,l_datmsgaux,l_qtdmsg,l_qtdmsg,
                         0,0,0,l_usabio,l_VerPrm,0,l_anti_dupla,l_concre,l_conpac,l_tempac,l_tolacp,l_vis_esp,0,
                         l_crefx1,l_fx1,l_crefx1,l_crefx2,l_fx2,l_crefx2,
                         l_crefx3,l_fx3,l_crefx3,l_crefx4,l_fx4,l_crefx4,
                         l_crefx5,l_fx5,l_crefx5,l_crefx6,l_fx6,l_crefx6,
                         l_grupo1,l_iniAr1,l_fimAr1,l_grupo2,l_iniAr2,l_fimAr2,
                         l_grupo3,l_iniAr3,l_fimAr3,
                         l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                         l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                         l_fairef,l_teccra,0,l_idtpes,l_gracon,l_conInt_Int,l_tolInt,l_ValAut,
                         l_nomfun,l_numpis,l_conrea,
                         l_nompes,l_ddifon,l_dddfon,l_numfon,l_qtdprv,l_pesblo,l_desblo,p_tipdoc,p_numdoc,
                         0, 0, 0, 0, 0, '0', p_propac, 0, l_usarfa);
         EXCEPTION
             WHEN OTHERS THEN      RAISERROR 103 'SP_PACCON: Erro no INSERT Tabela R070CON.';

         END;

      END IF;
      /*Atualiza Pend_Grupo*/
      IF (l_numsma > 0) THEN
          /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
          IF (l_tecpri = 3) THEN
              SP_ATUPRM(p_numcra, l_numsma, l_codprm, l_grupo1, l_grupo2, l_grupo3, l_codprm, l_codprm, l_codprm);
          ELSE
              SP_ATUPRM(l_crapri, l_numsma, l_codprm, l_grupo1, l_grupo2, l_grupo3, l_codprm, l_codprm, l_codprm);
          END IF;
      END IF;


      /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
      IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
          SP_PEND21(l_crapri);
      END IF;

      /*Atualiza os demais Crachás*/
      /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
      IF (l_tecpri = 1) THEN
          /*Atualiza o crachá de proximidade*/
          IF (l_numpro <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numpro, l_numpro_ret OUT);
                /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numpro);
              END IF;
          END IF;
          /*Atualiza o crachá Smart*/
          IF (l_numsma <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numsma, l_numsma_ret OUT);
              /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numsma);
              END IF;
          END IF;
      /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
      ELSIF (l_tecpri = 2) THEN
          /*Atualiza o crachá Smart*/
          IF (l_numsma <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numsma, l_numsma_ret OUT);
              /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numsma);
              END IF;
          END IF;
      END IF;
      /*Verifica se Gera o Comando IncludePerson*/
      IF (l_iPerson = TRUE) THEN
          /*Gera o Include Person*/
          SP_PEND19(p_numcra, l_idtpes);
          /*Atualiza os créditos somente se o mesmo já não foi atualizado*/
          IF (l_atucreloc = FALSE) THEN
              /*Atualiza os créditos sem local físico*/
              SP_PEND06(1, l_idtpes, l_verplf, 0);
              /*Atualiza os créditos por local físico da pessoa*/
              SP_ATUCRELOC(l_idtpes);
          END IF;
      END IF;
  END IF;
  IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
    l_creacc_bol := TRUE;
  ELSE
    l_creacc_bol := FALSE;
  END IF;
  IF (p_subnv = 1) THEN
    l_subnv_bol := TRUE;
  ELSE
    l_subnv_bol := FALSE;
  END IF;

  /*Atualiza a Controle*/
  IF (l_pode_ignorar = FALSE) THEN
    SP_ATUTSI(l_idtpes, l_crapri, l_creacc_bol, TRUE, l_subnv_bol, TRUE);
  END IF;
END		SENIOR;23ÁSP_DATSTR
SP_INTSTR
SP_RETCRP
SP_RETCAP
SP_MAPFIS
SP_PRMAMB
SP_RETFON
SP_PEND26
SP_RESETCRED
SP_ATUPRM
SP_PEND21
SP_VERCON
SP_ATUFIS
SP_PEND19
SP_PEND06
SP_ATUCRELOC
SP_ATUTSI
ˆY␀␀


PROCEDURE SP_PACCON(P_TIPPES NUMBER(2),P_PROPAC VARCHAR2(20),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER,P_VERPLF NUMBER(3),P_CODPLF NUMBER(5),P_DATINI DATE,P_HORINI NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_SUBNV NUMBER(1),P_CREACC NUMBER(1))
 IS

l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numpro_ret   BOOLEAN;
  l_numsma       NUMBER(12);
  l_numsma_ret   BOOLEAN;
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_teccra       NUMBER(1);
  l_inival       CHAR(16);
  l_tipcra       NUMBER(2);
  l_codig        CHAR(6);
  l_situa        CHAR(1);
  l_situaAnt     CHAR(1);
  l_subnv        CHAR(5);
  l_faixa        CHAR(56);
  l_fairef       CHAR(56);
  l_datahora     CHAR(10);
  l_desmsg       VARCHAR2(32);
  l_qtdmsg       CHAR(2);
  l_crefx1       CHAR(2);
  l_fx1          CHAR(8);
  l_crefx2       CHAR(2);
  l_fx2          CHAR(8);
  l_crefx3       CHAR(2);
  l_fx3          CHAR(8);
  l_crefx4       CHAR(2);
  l_fx4          CHAR(8);
  l_crefx5       CHAR(2);
  l_fx5          CHAR(8);
  l_crefx6       CHAR(2);
  l_fx6          CHAR(8);
  l_datmsgaux    CHAR(16);
  l_qtdIdtPes    NUMBER(2);
  l_count        NUMBER(4);
  l_iPerson      BOOLEAN;
  l_datano       NUMBER(4);
  l_usarfastr    CHAR(1);
  l_usarfa       NUMBER(1);

  /* Controle de Areas Restritas */
  l_grupo1       CHAR(5);
  l_iniAR1       CHAR(10);
  l_fimAR1       CHAR(10);
  l_grupo2       CHAR(5);
  l_iniAR2       CHAR(10);
  l_fimAR2       CHAR(10);
  l_grupo3       CHAR(5);
  l_iniAR3       CHAR(10);
  l_fimAR3       CHAR(10);

  /* Definições de acesso por visitante */
  l_anti_dupla   CHAR(1); /* Controla Anti-Dupla */
  l_vis_esp      CHAR(1); /* se for visitante especial bloqueia automaticamente na saida. */
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_numcra       CHAR(12);
  l_comando_nulo BOOLEAN;
  l_datstr       CHAR(6);
  l_horstr       CHAR(4);
  l_datstr_ini   CHAR(6);
  l_horstr_ini   CHAR(4);
  l_concre       NUMBER(1);
  l_conrea       NUMBER(1);
  l_gercrv       CHAR(1);
  l_usabio       NUMBER(1);
  l_VerPrm       NUMBER(1);
  l_gracon       NUMBER(3);
  l_auxval       CHAR(16);
  l_creacc_bol   BOOLEAN;
  l_subnv_bol    BOOLEAN;
  l_ValAut       NUMBER(1);
  /*Interjornadas*/
  l_ConInt_int   NUMBER(1);
  l_TolInt       NUMBER(3);
  l_conpac       NUMBER(1);
  l_tempac       NUMBER(3);
  l_tolacp       NUMBER(2);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_hora_tol     NUMBER(4);
  l_pode_ignorar BOOLEAN;
  l_segu_atual   NUMBER(2);
  l_codprm       NUMBER;
  l_tipdoc       CHAR(1);
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_uticcr       CHAR(1);
  l_atucreloc    BOOLEAN;
  l_verplf       NUMBER(3);
  l_nompes       VARCHAR2(40);
  l_ddifon       NUMBER(3);
  l_dddfon       NUMBER(3);
  l_numfon       VARCHAR2(20);
  l_qtdprv       NUMBER(2);
  l_pesblo       NUMBER(1);
  l_desblo       VARCHAR(29);
  l_numcracex    NUMBER(12);
BEGIN
  l_atucreloc  := FALSE;
  l_nompes := '';
  l_ddifon := 0;
  l_dddfon := 0;
  l_numfon := '';
  l_qtdprv := 0;
  l_pesblo := 0;
  l_desblo := '';
  l_pode_ignorar := FALSE;

  /* Busca parametro que indica se utiliza compra. */
  BEGIN
     SELECT UTICCR INTO l_uticcr FROM R070DAC;
  EXCEPTION
    WHEN OTHERS THEN
      l_uticcr := 'N';
  END;

  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_hora_tol := l_hora_atual + 5;
  IF (l_hora_tol > 1439) THEN
    l_hora_tol := 1439;
  END IF;
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_segu_atual := SECOND(CURTIME());

  IF (p_datini > l_data_atual OR (p_datini = l_data_atual AND P_HORINI >= l_hora_tol)) THEN
    l_pode_ignorar := TRUE;
  END IF;

  IF (p_numcra > 0 AND l_pode_ignorar = FALSE) THEN
      /*Inicializações*/
      l_iPerson := FALSE;
      l_concre := 0;
      l_conrea := 1;
      l_crefx1 := '00';
      l_crefx2 := '00';
      l_crefx3 := '00';
      l_crefx4 := '00';
      l_crefx5 := '00';
      l_crefx6 := '00';
      l_fx1 := '24002400';
      l_fx2 := '24002400';
      l_fx3 := '24002400';
      l_fx4 := '24002400';
      l_fx5 := '24002400';
      l_fx6 := '24002400';
      /* Inicializa Areas Restritas */
      l_grupo1 := '00000';
      l_iniAR1 := '0000000000';
      l_fimAR1 := '0000000000';
      l_grupo2 := '00000';
      l_iniAR2 := '0000000000';
      l_fimAR2 := '0000000000';
      l_grupo3 := '00000';
      l_iniAR3 := '0000000000';
      l_fimAR3 := '0000000000';
      l_vis_esp     := '0';
      l_subnv       := '99000';
      l_gercrv      :='N';
      l_anti_dupla  := '1';
      /*Biometria*/
      l_usabio      := 1;
      l_verprm      := 1;
      l_gracon      := 50;
      l_usarfastr   := 'N';
      /*Interjornadas*/
      l_ConInt_int := 0;
      l_TolInt := 0;
      l_conpac := 0;
      l_tempac := 0;
      l_tolacp := 0;
      l_desmsg := '                                ';
      l_qtdmsg := '0';
      l_datmsgaux  := '0000000000000000';
      l_codig := '';
      l_situa  := '0';
      l_situaAnt:= '1';
      l_faixa  := '00002359240024002400240024002400240024002400240024002400';
      l_fairef := '24002400240024002400240024002400240024002400240024002400';
      l_nomfun := '';
      l_numpis := 0;
      /*Busca versão do plano ativa*/
      BEGIN
          SELECT VERPLF INTO l_verplf
            FROM R058VPL
           WHERE DATCRI <= l_data_atual
             AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
      EXCEPTION
          WHEN OTHERS THEN
              l_verplf := 1;
      END;
      /*Se a data inicial for menor do que 1980, então considera como 01/01/1980*/
      l_datano := Year(p_datini);
      IF (l_datano < 1980) THEN
         l_inival := '0101802359000000';
      ELSE
         /*obtem a data inicial do crachá*/
         SP_DATSTR(p_datini,'DDMMYY',l_datstr_ini OUT);
         SP_INTSTR(p_horini,'HHMM',l_horstr_ini OUT);
         l_inival := l_datstr_ini||l_horstr_ini||'000000';
      END IF;

      /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
      SP_MAPFIS(p_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

      IF (l_crapri = 0) THEN
         l_crapri := p_numcra;
         /*Se não possuir Tecnologia, o campo TecCra da R070CON será preenchido com valor 1.*/
         l_teccra := 1;
      ELSE
         l_teccra := l_tecpri;
      END IF;

      /* Atualiza R070CON */
      l_comando_nulo:=FALSE;
      BEGIN
          SELECT NUMFIS,SITCRA INTO l_numcra, l_situaAnt FROM R070CON WHERE NUMFIS = l_crapri;
      EXCEPTION
          WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_PACCON: Erro em R070CON - TOO MANY ROWS';
          WHEN NO_DATA_FOUND THEN l_comando_nulo:=TRUE;
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro no SELECT R070CON 5.';
      END;

      /* Monta o identificador do paciente ou acompanhante de paciente */
      SP_INTSTR(p_tippes,'99',l_tippes OUT);
      l_tipcra := p_tippes;

      /*Se for paciente que está atualizando...*/
      IF (p_tippes = 9) THEN
          /* Busca definições de créditos de acesso para pacientes/acompanhantes. */
          BEGIN
              SELECT CREPAC INTO l_concre FROM R070DAC;
          EXCEPTION
              WHEN OTHERS THEN l_concre := 0;
          END;

          IF ((l_comando_nulo = FALSE) AND (p_creacc = 1) AND (l_uticcr = 'N')) THEN
          	  /* marca como atualizado os créditos da pessoa */
          	  l_atucreloc := TRUE;
              /*reseta os créditos do paciente*/
              SP_RESETCRED(p_tippes, 0, 0, 0, 0, '0', '0', p_propac);
          END IF;

          SP_RETCRP (p_propac, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);

          /* Busca definição 'Utiliza Reconhecimento Facial' para pacientes */
          BEGIN
              SELECT R097TIN.USARFA INTO l_usarfastr FROM R097INT, R097TIN
               WHERE R097INT.CODTIN = R097TIN.CODTIN AND R097INT.PROPAC = p_propac AND ((
                     ((r097int.DATINI < p_datini) OR ((r097int.DATINI = p_datini) AND (r097int.HORINI <= p_horini)) )AND
                      ((r097int.DATFIM > p_datini) OR ((r097int.DATFIM = p_datini) AND (r097int.HORFIM >= p_horini)) OR (r097int.DATFIM = l_data_zero))));
          EXCEPTION
              WHEN OTHERS THEN l_usarfastr := 'N';
          END;

          l_idtpes := l_tippes||p_propac;

      /*Se for acompanhante de paciente que está atualizando...*/
      ELSIF (p_tippes = 11) THEN
          /* Busca definições de créditos de acesso para acompanhantes de pacientes */
          BEGIN
              SELECT R097TIN.CONCRE, R097TIN.GRACON, R097TIN.USABIO, R097TIN.USARAC INTO l_concre, l_gracon, l_usabio, l_usarfastr FROM R097INT, R097TIN
               WHERE R097INT.CODTIN = R097TIN.CODTIN AND R097INT.PROPAC = p_propac AND ((
                     ((r097int.DATINI < p_datini) OR ((r097int.DATINI = p_datini) AND (r097int.HORINI <= p_horini)) )AND
                      ((r097int.DATFIM > p_datini) OR ((r097int.DATFIM = p_datini) AND (r097int.HORFIM >= p_horini)) OR (r097int.DATFIM = l_data_zero))));
          EXCEPTION
              WHEN OTHERS THEN l_concre := 0; l_gracon := 50; l_usabio := 1; l_usarfastr := 'N';
          END;

          IF ((l_comando_nulo = FALSE) AND (p_creacc = 1) AND (l_uticcr = 'N')) THEN
          	  /* marca como atualizado os créditos da pessoa */
          	  l_atucreloc := TRUE;
              /*reseta os créditos do acompanhante de paciente*/
              SP_RESETCRED(p_tippes, 0, 0, 0, p_tipdoc, p_numdoc, '0', '0');
          END IF;

          SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
          SP_RETCAP (l_tipdoc, p_numdoc, l_crefx1 OUT, l_fx1 OUT, l_crefx2 OUT, l_fx2 OUT, l_crefx3 OUT, l_fx3 OUT, l_crefx4 OUT, l_fx4 OUT, l_crefx5 OUT, l_fx5 OUT, l_crefx6 OUT, l_fx6 OUT);

          /*Monta o Identificador da Pessoa*/
          l_idtpes := l_tippes||l_tipdoc||p_numdoc;
      ELSE
          SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
          /*Monta o Identificador da Pessoa*/
          l_idtpes := l_tippes||l_tipdoc||p_numdoc;
      END IF;

      /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);

      LOOP
         /*Controle do Loop.*/
         IF (Length(l_idtpes) > 22) THEN
             EXIT;
         END IF;
         l_idtpes := ' '||l_idtpes;
      END LOOP;

      SP_DATSTR(p_datval,'DDMMYY',l_datstr OUT);
      SP_INTSTR(p_horval,'HHMM',l_horstr OUT);
      /* corrige a data se vier com valor zero */
      IF  (l_datstr = '311200') THEN
         l_datstr :=  '311250';
      END IF;
      IF  (l_horstr = '0000') THEN
         l_horstr :=  '2359';
      END IF;
      l_datahora := l_datstr || l_horstr;
      l_auxval := l_datahora||'000000';

      /*Obtem a permissão da pessoa*/
      SP_PRMAMB(p_verplf, p_codplf, l_codprm OUT);

      /* verifica se o crachá é de uma nova entrada */
      IF  (l_situaAnt = '1') THEN
          l_subnv := '99000';
      END IF;

      /*Verifica se existe o identificador da R070CON (idtpes) caso negativo deverá gerar comando 19.*/
      BEGIN
          SELECT COUNT(*) INTO l_qtdIdtPes FROM R070CON WHERE IDTPES = l_idtpes;
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro No SELECT R070CON (IdtPes).';
      END;

      IF (l_qtdIdtPes > 0) THEN
          l_iPerson := FALSE;
      ELSE
          l_iPerson := TRUE;
      END IF;

      /* verifica se possui registros na tabela R090VAU.. Se possuir, ValAut = 1 */
      l_count := 0;
      BEGIN
          SELECT COUNT(*) INTO l_count FROM R090VAU WHERE IDTPES = l_idtpes AND
                 (DATENT < l_data_atual OR (DATENT = l_data_atual AND HORENT <= l_hora_atual)) AND
                 (DATFIM > l_data_atual OR DATFIM = l_data_zero OR (DATFIM = l_data_atual AND HORFIM >= l_hora_atual));
      EXCEPTION
          WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro No SELECT R090VAU (IdtPes).';
      END;

      /* necessita de validação por autorizador */
      l_ValAut := 0;
      IF  (l_count > 0) THEN
          l_ValAut := 1;
      END IF;

      SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

      l_numcracex := 0;
      BEGIN
          SELECT NUMCRA INTO l_numcracex FROM R090CEX WHERE NUMCRA = p_numcra;
      EXCEPTION
      	WHEN OTHERS THEN NULL;
      END;

      IF (l_numcracex = p_numcra) THEN
        l_situa := '1';
      END IF;

      /* Assinala na tabela Controle que o Paciente ou Acomp. de Paciente utiliza reconhecimento facial */
      IF  l_usarfastr = 'S' THEN
          l_usarfa := 1;
      ELSE
          l_usarfa := 0;
      END IF;

      IF (l_comando_nulo = FALSE) THEN
          /* atualiza a tabela R070CON */
          BEGIN
              UPDATE R070CON SET
                     NUMCRA=p_numcra, TIPCRA=l_tipcra, SENCOL= l_codig,INIAFA= '0000000000000000',
                     DATAFA='0000000000000000',
                     CODPRM=l_codprm, PRMSAB=l_codprm, PRMDOM=l_codprm, PRMFER=l_codprm,
                     SITCRA=l_situa, INIVAL = l_inival, DATVAL=l_auxval,
                     MSGACC=l_desmsg, DATMSG=l_datmsgaux, QTDMSG=l_qtdmsg,
                     CONADP=l_anti_dupla, CONCRE=l_concre,
                     CREAC1=l_crefx1,CREFX1=l_fx1,QTDCR1=l_crefx1,
                     CREAC2=l_crefx2,CREFX2=l_fx2,QTDCR2=l_crefx2,
                     CREAC3=l_crefx3,CREFX3=l_fx3,QTDCR3=l_crefx3,
                     CREAC4=l_crefx4,CREFX4=l_fx4,QTDCR4=l_crefx4,
                     CREAC5=l_crefx5,CREFX5=l_fx5,QTDCR5=l_crefx5,
                     CREAC6=l_crefx6,CREFX6=l_fx6,QTDCR6=l_crefx6,
                     PRMRT1=l_grupo1, DINPR1=l_iniAr1, DFNPR1=l_fimAr1,
                     PRMRT2=l_grupo2, DINPR2=l_iniAr2, DFNPR2=l_fimAr2,
                     PRMRT3=l_grupo3, DINPR3=l_iniAr3, DFNPR3=l_fimAr3,
                     TECCRA=l_teccra, CHCPRI=0, IDTPES=l_idtpes, USABIO=l_usabio, GRACON=l_gracon,
                     CONINT=l_conInt_Int, TOLINT=l_tolInt, CONPAC=l_conpac, TEMPAC=l_tempac,
                     TOLACP=l_tolacp, VALAUT=l_ValAut, NOMFUN=l_nomfun, NUMPIS=l_numpis, CONREA=l_conrea,
                     NOMPES=l_nompes, DDIFON=l_ddifon, DDDFON=l_dddfon, NUMFON=l_numfon, QTDPRV=l_qtdprv,
                     PESBLO=l_pesblo, DESBLO=l_desblo, TIPDOC=p_tipdoc, NUMDOC=p_numdoc, BLOAUT=l_vis_esp,
                     NUMEMP=0, TIPCOL=0, NUMCAD=0, NUMMAT='0', PROPAC=p_propac, NUMCAN=0, USARFA=l_usarfa
              WHERE NUMFIS = l_crapri;

              /* Verifica se atualiza SubNv*/
              IF (p_subnv = 1) THEN
                BEGIN
                    UPDATE R070CON SET
                         NIVATU = '99000', DATNIV = l_data_atual, HORNIV = l_hora_atual, SEQNIV = l_segu_atual
                    WHERE IDTPES = l_idtpes;
                    /*Gera pendência de atualização de nível*/
                    SP_PEND26(l_idtpes, '99000', l_data_atual, l_hora_atual, l_segu_atual);
                EXCEPTION WHEN OTHERS THEN
                    RAISERROR 103 'SP_PACCON: Erro Na Atualização de SPVISCON 2.';
                END;
              END IF;

          EXCEPTION
              WHEN OTHERS THEN RAISERROR 103 'SP_PACCON: Erro Na Atualização de R070CON';
          END;
      ELSE
         /* insere na tabela R070CON */
         BEGIN
             INSERT INTO R070CON(
                         NUMCRA,NUMFIS,TIPCRA,SITCRA,NIVATU,DATNIV,HORNIV,SEQNIV,
                         INIVAL,DATVAL,INIAFA, DATAFA,CODPRM,PRMSAB,PRMDOM,PRMFER,
                         SENCOL,MSGACC,DATMSG,QTDMSG,MSGATU,
                         CONIAL,TEMALM,VERAFA,USABIO,VERPRM,CONFAI,CONADP,CONCRE,
                         CONPAC,TEMPAC,TOLACP,BLOAUT,BLOFAL,
                         CREAC1,CREFX1,QTDCR1,CREAC2,CREFX2,QTDCR2,
                         CREAC3,CREFX3,QTDCR3,CREAC4,CREFX4,QTDCR4,
                         CREAC5,CREFX5,QTDCR5,CREAC6,CREFX6,QTDCR6,
                         PRMRT1,DINPR1,DFNPR1,PRMRT2,DINPR2,DFNPR2,PRMRT3,DINPR3,DFNPR3,
                         FAIAC1,FAIAC2,FAIAC3,FAIAC4,FAIAC5,FAIAC6,FAIAC7,
                         FAIPT1,FAIPT2,FAIPT3,FAIPT4,FAIPT5,FAIPT6,FAIPT7,FAIREF,
                         TECCRA,CHCPRI,IDTPES,GRACON,CONINT,TOLINT,VALAUT,
                         NOMFUN,NUMPIS,CONREA,
                         NOMPES,DDIFON,DDDFON,NUMFON,QTDPRV,PESBLO,DESBLO,TIPDOC,NUMDOC,
                         RECVIS,PROPRE,NUMEMP,TIPCOL,NUMCAD,NUMMAT,PROPAC,NUMCAN,USARFA)
             VALUES(
                         p_numcra,l_crapri,l_tipcra,l_situa,l_subnv,l_data_atual,
                         l_hora_atual,l_segu_atual,l_inival,l_auxval,
                         '0000000000000000','0000000000000000',l_codprm,l_codprm,
                         l_codprm,l_codprm,l_codig,l_desmsg,l_datmsgaux,l_qtdmsg,l_qtdmsg,
                         0,0,0,l_usabio,l_VerPrm,0,l_anti_dupla,l_concre,l_conpac,l_tempac,l_tolacp,l_vis_esp,0,
                         l_crefx1,l_fx1,l_crefx1,l_crefx2,l_fx2,l_crefx2,
                         l_crefx3,l_fx3,l_crefx3,l_crefx4,l_fx4,l_crefx4,
                         l_crefx5,l_fx5,l_crefx5,l_crefx6,l_fx6,l_crefx6,
                         l_grupo1,l_iniAr1,l_fimAr1,l_grupo2,l_iniAr2,l_fimAr2,
                         l_grupo3,l_iniAr3,l_fimAr3,
                         l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                         l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,l_faixa,
                         l_fairef,l_teccra,0,l_idtpes,l_gracon,l_conInt_Int,l_tolInt,l_ValAut,
                         l_nomfun,l_numpis,l_conrea,
                         l_nompes,l_ddifon,l_dddfon,l_numfon,l_qtdprv,l_pesblo,l_desblo,p_tipdoc,p_numdoc,
                         0, 0, 0, 0, 0, '0', p_propac, 0, l_usarfa);
         EXCEPTION
             WHEN OTHERS THEN      RAISERROR 103 'SP_PACCON: Erro no INSERT Tabela R070CON.';

         END;

      END IF;
      /*Atualiza Pend_Grupo*/
      IF (l_numsma > 0) THEN
          /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
          IF (l_tecpri = 3) THEN
              SP_ATUPRM(p_numcra, l_numsma, l_codprm, l_grupo1, l_grupo2, l_grupo3, l_codprm, l_codprm, l_codprm);
          ELSE
              SP_ATUPRM(l_crapri, l_numsma, l_codprm, l_grupo1, l_grupo2, l_grupo3, l_codprm, l_codprm, l_codprm);
          END IF;
      END IF;


      /*Se não encontrou o crachá Principal na R070CON e não vai gerar o comando includePerson*/
      IF ((l_comando_nulo = TRUE) AND (l_iPerson = FALSE)) THEN
          SP_PEND21(l_crapri);
      END IF;

      /*Atualiza os demais Crachás*/
      /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
      IF (l_tecpri = 1) THEN
          /*Atualiza o crachá de proximidade*/
          IF (l_numpro <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numpro, l_numpro_ret OUT);
                /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numpro,l_crapri,2,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numpro_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numpro);
              END IF;
          END IF;
          /*Atualiza o crachá Smart*/
          IF (l_numsma <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numsma, l_numsma_ret OUT);
              /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numsma);
              END IF;
          END IF;
      /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
      ELSIF (l_tecpri = 2) THEN
          /*Atualiza o crachá Smart*/
          IF (l_numsma <> 0) THEN
              /*Verifica se o Crachá já está na R070CON*/
              SP_VERCON(l_numsma, l_numsma_ret OUT);
              /*Atualiza o crachá na R070CON*/
              SP_ATUFIS(p_numcra,l_numsma,l_crapri,3,l_tipcra,l_situa,l_inival,l_auxval,l_idtpes,
                        l_codprm,l_codprm,l_codprm,l_codprm,l_grupo1,l_grupo2,l_grupo3,0,0,' ',l_VerPrm);
              /*Se não vai gerar o includePerson, verifica se será necessário enviar o comando 21*/
              /*Se não estiver na R070CON e não for gerar o includePerson, então gera comando 21 updateCard*/
              IF ((l_iPerson = FALSE) AND (l_numsma_ret = FALSE)) THEN
                  /*Gera Pendência 21*/
                  SP_PEND21(l_numsma);
              END IF;
          END IF;
      END IF;
      /*Verifica se Gera o Comando IncludePerson*/
      IF (l_iPerson = TRUE) THEN
          /*Gera o Include Person*/
          SP_PEND19(p_numcra, l_idtpes);
          /*Atualiza os créditos somente se o mesmo já não foi atualizado*/
          IF (l_atucreloc = FALSE) THEN
              /*Atualiza os créditos sem local físico*/
              SP_PEND06(1, l_idtpes, l_verplf, 0);
              /*Atualiza os créditos por local físico da pessoa*/
              SP_ATUCRELOC(l_idtpes);
          END IF;
      END IF;
  END IF;
  IF (p_creacc = 1) AND (l_uticcr = 'N') THEN
    l_creacc_bol := TRUE;
  ELSE
    l_creacc_bol := FALSE;
  END IF;
  IF (p_subnv = 1) THEN
    l_subnv_bol := TRUE;
  ELSE
    l_subnv_bol := FALSE;
  END IF;

  /*Atualiza a Controle*/
  IF (l_pode_ignorar = FALSE) THEN
    SP_ATUTSI(l_idtpes, l_crapri, l_creacc_bol, TRUE, l_subnv_bol, TRUE);
  END IF;
END␀jø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀/*
 * updateCreditAccess - Atualiza as faixas de créditos de acesso da pessoa, por local 

físico
 * parâmetros: - p_tipope: 1- Inserir créditos
 *                         2- Excluir créditos globais da pessoa
 *                         3- Excluir créditos por local físico da pessoa
 *                         4- Excluir todos os créditos da pessoa
 *             - p_idtpes: Identificador da pessoa
 *             - p_verplf: Versão do plano de localização física
 *             - p_codplf: Código do local físico
 */
PROCEDURE SP_PEND06(P_TIPOPE NUMBER(1),P_IDTPES CHAR(23),P_VERPLF NUMBER(3),P_CODPLF NUMBER(7))
 IS
BEGIN
    NULL;
END		SENIOR;20$SP_INTSTR
