			l_Alterou := TRUE;
			SP_CONCAT_FLO_JSON('VLRMOG', :NEW.VLRMOG, :OLD.VLRMOG, 2, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_NUM(:OLD.VLRR65, :NEW.VLRR65, l_Valido OUT);
