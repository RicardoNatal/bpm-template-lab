TRIGGER R070PEA_SI AFTER INSERT ON R070PEA

BEGIN
  R070PEA_ATUCON();
  /* Tabela temporária */
  BEGIN
      DELETE FROM R070PEA_AUX;
      DROP_TEMP_TABLE R070PEA_AUX;
  EXCEPTION 
      WHEN OTHERS THEN NULL;
   END;  
END␀SÚ␀␀		SENIOR;0»␀␀TRIGGER R070PEA_EI AFTER INSERT ON R070PEA FOR EACH ROW

DECLARE
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_online       BOOLEAN;

  /* Tabela temporária */
  CREATE_TEMP_TABLE R070PEA_AUX;
  
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       IF   (:NEW.DATFIM = l_data_zero OR :NEW.DATFIM > l_data_atual OR
            (:NEW.DATFIM = l_data_atual AND :NEW.HORFIM > l_hora_atual)) THEN
            BEGIN
            /* Insere Registro NEW */
              INSERT INTO R070PEA_AUX (NUMMAT,DATINI,HORINI)
                               VALUES (:NEW.NUMMAT,:NEW.DATINI,:NEW.HORINI);
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro no INSERT em R070PEA_AUX.';
            END;
       END IF;
  END IF;
END␀WÚ␀␀	SENIOR;0ğ

