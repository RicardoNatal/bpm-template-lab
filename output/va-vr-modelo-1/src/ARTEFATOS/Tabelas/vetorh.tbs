  l_DDIStr     VARCHAR(3);
  l_DDDStr     VARCHAR(3);
  l_telStr     VARCHAR2(99);
  l_TamObsAgv  NUMBER(3);
  l_TamOEm     NUMBER(2);
  l_TamTel     NUMBER(2);
  l_TamEmaVis  NUMBER(2);
