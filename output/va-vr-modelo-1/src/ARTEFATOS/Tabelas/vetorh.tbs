END␀8Ó␀␀		SENIOR;0%␀TRIGGER R034CPL_EU AFTER UPDATE ON R034CPL FOR EACH ROW

DECLARE
l_data_atual   DATE;
  l_cmpfgt       DATE;
  l_altcplfun    BOOLEAN;
  l_incfgt       BOOLEAN;
  l_dias_mes     NUMBER(2);
  l_aux          NUMBER(1);
  l_nomfun       VARCHAR2(40);
  l_numctp       NUMBER(9);
  l_serctp       VARCHAR2(5);
  l_estctp       VARCHAR2(2);
  l_numpis       NUMBER(11);
  l_datadm       DATE;
  l_datnas       DATE;
  I_numcpf       NUMBER(11);
  l_usaRubi      BOOLEAN;
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_datTempNew   VARCHAR(10);

  /*Variáveis Sincronização*/
  L_CODPES      R033PES.CODPES%TYPE;
  L_SITAFA      R034FUN.SITAFA%TYPE;
  L_DEMITIDOS BOOLEAN;
  l_AlterouPessoa BOOLEAN;
  
  l_data_zero DATE;
  l_DatAtu    DATE;

  l_EndRua   R033END.ENDRUA%TYPE;
  l_EndNum   R033END.ENDNUM%TYPE;
  l_EndCpl   R033END.ENDCPL%TYPE;
  l_CodCid   R033END.CODCID%TYPE;
  l_CodBai   R033END.CODBAI%TYPE;
  l_EndCep   R033END.ENDCEP%TYPE;
  l_DatAlt   R033END.DATALT%TYPE;
  
  l_TipLgr   R033END.TIPLGR%TYPE;
  l_EndRuaAnt   R033END.ENDRUA%TYPE;
  l_EndNumAnt   R033END.ENDNUM%TYPE;
  l_EndCplAnt   R033END.ENDCPL%TYPE;
  l_CodCidAnt   R033END.CODCID%TYPE;
  l_CodBaiAnt   R033END.CODBAI%TYPE;
  l_EndCepAnt   R033END.ENDCEP%TYPE;
  l_TipLgrAnt   R033END.TIPLGR%TYPE;
  l_AlterouEndereco NUMBER(1);   
  
  /*VARIÁVEID DE AUDITORIA DE REGISTRO*/
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_Valido           BOOLEAN;
  l_online           BOOLEAN;

  l_DataAlteracao   DATE;
  l_layout VARCHAR2(6); /* Layout do colaborador no eSocial */
  l_layoutAlteracaoCadastral VARCHAR2(6);
  l_AlterouInfoCadastral BOOLEAN;  
  l_AlterouInfoVinculo BOOLEAN;
  l_AlterouInfoNascimento BOOLEAN;  
  l_AlterouInfoObjCon BOOLEAN; 
  l_InfoFacult BOOLEAN;
  l_SimplificacaoESocial BOOLEAN;
  l_JsonFlags VARCHAR2(2000);
  l_JsonFlagsCadastral VARCHAR2(2000);
  l_JsonFlagsVinculo VARCHAR2(2000);
  l_JsonFlagsObjetivoContrato VARCHAR2(2000);
  l_JsonInfoCadastral VARCHAR2(2000);
  l_JsonInfoVinculo VARCHAR2(2000);
  l_JsonInfoObjetivoContrato VARCHAR2(2000);
  
  l_DatAltHFI          R033PES.DATAUX%TYPE;
  l_ColAti             R033PES.COLATI%TYPE;  

  l_idtpes       VARCHAR2(23);
  l_VersaoESocial NUMBER;	
  
  /* Para store procedures de histórico */
  l_seqhis       NUMBER(15);
  l_tipalt       VARCHAR2(1);
 
BEGIN
  l_layout := '';
  RH_VerRubi(l_usaRubi OUT);
  l_data_atual := CURDATE();

  /* Verifica se foi alterado algum dos campos abaixo */
  l_altcplfun := FALSE;
  IF  (l_usaRubi = TRUE) AND
     ((:NEW.ENDRUA <> :OLD.ENDRUA)
  OR  (:NEW.ENDNUM <> :OLD.ENDNUM)
  OR  (:NEW.ENDCPL <> :OLD.ENDCPL)
  OR  (:NEW.CODCID <> :OLD.CODCID)
  OR  (:NEW.CODBAI <> :OLD.CODBAI)
  OR  (:NEW.ENDCEP <> :OLD.ENDCEP)) THEN
      l_altcplfun := TRUE;
  END IF;

  IF   (l_altcplfun = TRUE) THEN
        /* calcula a data da competência = 1o. dia do mês */
        l_dias_Mes := DAYOFMONTH(l_data_atual) - 1;
        l_dias_Mes := l_dias_Mes * -1;
        l_cmpfgt := DATETIMEADD(DD,l_dias_Mes,l_data_atual);
        l_incfgt := FALSE;
        BEGIN
         SELECT TIPCOL INTO l_aux FROM R034FGT
           WHERE NUMEMP = :NEW.NUMEMP
             AND TIPCOL = :NEW.TIPCOL
             AND NUMCAD = :NEW.NUMCAD
             AND CMPFGT = l_cmpfgt;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
               l_incfgt := TRUE;
          WHEN OTHERS THEN
               RAISERROR 103 'Erro no SELECT R034FGT';
        END;
        /* se não encontrou o registro inclui pela ficha básica */
        IF  (l_incfgt = TRUE) THEN
             BEGIN
              SELECT NOMFUN,NUMCTP,SERCTP,ESTCTP,NUMPIS,DATADM,DATNAS,NUMCPF
                INTO l_nomfun,l_numctp,l_serctp,l_estctp,l_numpis,l_datadm,l_datnas,I_numcpf FROM R034FUN
                WHERE NUMEMP = :NEW.NUMEMP
                  AND TIPCOL = :NEW.TIPCOL
                  AND NUMCAD = :NEW.NUMCAD;
             EXCEPTION WHEN OTHERS THEN
                RAISERROR 103 'Erro no SELECT R034FUN';
             END;
             BEGIN
               INSERT INTO R034FGT (NUMEMP,TIPCOL,NUMCAD,CMPFGT,NOMFUN,NUMCTP,SERCTP,ESTCTP,NUMPIS,DATADM,DATNAS,ALTEND,NUMCPF)
                            VALUES (:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,
                                    l_cmpfgt,l_nomfun,l_numctp,l_serctp,l_estctp,l_numpis,l_datadm,l_datnas,'S',I_numcpf);
             EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro ao Gravar Tabela R034FGT';
             END;
        ELSE
             BEGIN
               UPDATE R034FGT SET ALTEND = 'S'
               WHERE NUMEMP = :NEW.NUMEMP
                 AND TIPCOL = :NEW.TIPCOL
                 AND NUMCAD = :NEW.NUMCAD
                 AND CMPFGT = l_cmpfgt;
             EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro ao Regravar Tabela R034FGT';
             END;
        END IF;
  END IF;

  /*SINCRONIZAÇÃO DOS DADOS DE FICHACOMPLEMENTAR E PESSOAS*/
  /*==========================================================================*/
  /*Data zerada*/
  l_data_zero  := DATETIME(31, 12, 1900, 0, 0, 0); /*'31/12/1900,00:00:00';*/
  /*Data atual*/
  l_DatAtu := CURDATE();
  BEGIN
    /*Verifca se colaborador tem vínculo com pessoa*/
    SELECT CODPES,SITAFA INTO L_CODPES,L_SITAFA FROM R034FUN
    WHERE NUMEMP = :NEW.NUMEMP
      AND TIPCOL = :NEW.TIPCOL
      AND NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_CODPES := 0;
      L_SITAFA := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R034FUN.CODPES';
  END;

  IF (L_CODPES>0) THEN
    RH_VERCOLDEM(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,L_CODPES,L_SITAFA,'R034CPL',L_DEMITIDOS OUT);
    IF (L_DEMITIDOS=TRUE) THEN
      l_AlterouPessoa := FALSE;
      /*Se existe vínculo com pessoa verificar os campos em comum entre
        R034CPL e R033PES se os mesmos foram alterados atualizar na R033PES*/
      IF (:NEW.CCINAS <> :OLD.CCINAS) THEN
       BEGIN
         UPDATE R033PES SET CCINAS = :NEW.CCINAS WHERE CODPES = L_CODPES;
         EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'Erro ao atualizar R033PES campo CCINAS';
       END;
       l_AlterouPessoa := TRUE; 
      END IF;

      IF (:NEW.NOMCOM <> :OLD.NOMCOM) THEN
       BEGIN
