       FUN.DATINC, FUN.NUMINS, FUN.NUMPIS, FUN.TIPCON, FUN.CATSEF,
       FUN.NUMCPF, FUN.NOMFUN, FUN.DATNAS, FUN.DATADM, FUN.RATEVE,
       CAL.CODCAL, CAL.PERREF, CAL.TIPCAL, CAL.DATPAG, CAL.INICMP, CAL.TIPCAO,
       VER.TABEVE, VER.CODEVE, VER.REFEVE, VER.VALEVE,
       EVC.CODCRT, EVC.CRTEVE, EVC.TIPEVE, EVC.DESEVE, EVC.CODCLC
   FROM VFP_CALDPS CAL, R046VER VER, R008EVC EVC, R034FUN FUN
   WHERE VER.NUMEMP = FUN.NUMEMP
     AND VER.TIPCOL = FUN.TIPCOL
     AND VER.NUMCAD = FUN.NUMCAD
     AND VER.NUMEMP = CAL.NUMEMP
     AND VER.CODCAL = CAL.CODCAL
     AND VER.TABEVE = EVC.CODTAB
     AND VER.CODEVE = EVC.CODEVE
     AND ( EVC.CODEVE < 2000)
     AND (    (CAL.TIPCAL = 31 OR CAL.TIPCAL = 32 OR CAL.TIPCAO = 31 OR CAL.TIPCAO = 32)
           OR (     (EVC.CODCRT < 1501 OR EVC.CODCRT > 1526)
                AND (EVC.CODCRT < 1601 OR EVC.CODCRT > 1626)
                AND (EVC.CODCRT < 1701 OR EVC.CODCRT > 1726)
                AND (EVC.CODCRT < 1801 OR EVC.CODCRT > 1826)
                AND EVC.CODCRT <> 2507 AND EVC.CODCRT <> 2607 AND EVC.CODCRT <> 3105 AND EVC.CODCRT <> 3108
                AND EVC.CODCRT <> 3110 AND EVC.CODCRT <> 3503 AND EVC.CODCRT <> 3505 AND EVC.CODCRT <> 3603
                AND EVC.CODCRT <> 3606 AND EVC.CODCRT <> 4003 AND EVC.CODCRT <> 4006 AND EVC.CODCRT <> 4010
                AND EVC.CODCRT <> 4018 AND EVC.CODCRT <> 4022 AND EVC.CODCRT <> 4402 AND EVC.CODCRT <> 4403
                AND EVC.CODCRT <> 4409 AND EVC.CODCRT <> 4410 AND EVC.CODCRT <> 4503 AND EVC.CODCRT <> 4508
                AND EVC.CODCRT <> 4511 AND EVC.CODCRT <> 5006 AND EVC.CODCRT <> 5007 AND EVC.CODCRT <> 5008
                AND EVC.CODCRT <> 1606 AND EVC.CODCRT <> 4401 AND EVC.CODCRT <> 4403 AND EVC.CODCRT <> 4404
                AND EVC.CODCRT <> 4405 AND EVC.CODCRT <> 4406 AND EVC.CODCRT <> 4407 AND EVC.CODCRT <> 4408
          )
       )
     AND (     (EVC.CODCRT < 1101 OR EVC.CODCRT > 1326)
           AND (EVC.CODCRT < 4201 OR EVC.CODCRT > 4226)
           AND EVC.CODCRT <> 105  AND EVC.CODCRT <>  205 AND EVC.CODCRT <>  305
           AND EVC.CODCRT <> 3502 AND EVC.CODCRT <> 3506 AND EVC.CODCRT <> 3507
           AND EVC.CODCRT <> 4002 AND EVC.CODCRT <> 4005 AND EVC.CODCRT <> 4009
           AND EVC.CODCRT <> 4016 AND EVC.CODCRT <> 4017 AND EVC.CODCRT <> 4020
           AND EVC.CODCRT <> 4021 AND EVC.CODCRT <> 4023 AND EVC.CODCRT <> 4502
           AND EVC.CODCRT <> 4507 AND EVC.CODCRT <> 4510
         )

UNION

SELECT FUN.NUMEMP, FUN.TIPCOL, FUN.NUMCAD, FUN.DEPIRF, FUN.DEPSAF,
       FUN.DATINC, FUN.NUMINS, FUN.NUMPIS, FUN.TIPCON, FUN.CATSEF,
       FUN.NUMCPF, FUN.NOMFUN, FUN.DATNAS, FUN.DATADM, FUN.RATEVE,
       CAL.CODCAL, CAL.PERREF,  32 TIPCAL, CAL.DATPAG, CAL.INICMP, CAL.TIPCAO,
       VER.TABEVE, VER.CODEVE, VER.REFEVE, VER.VALEVE,
       EVC.CODCRT, EVC.CRTEVE, EVC.TIPEVE, EVC.DESEVE, EVC.CODCLC
  FROM VFP_CALDPS CAL, R046VER VER, R008EVC EVC, R034FUN FUN
 WHERE VER.NUMEMP = FUN.NUMEMP
   AND VER.TIPCOL = FUN.TIPCOL
   AND VER.NUMCAD = FUN.NUMCAD
   AND VER.NUMEMP = CAL.NUMEMP
   AND VER.CODCAL = CAL.CODCAL
   AND VER.TABEVE = EVC.CODTAB
   AND VER.CODEVE = EVC.CODEVE
   AND EVC.CODEVE < 2000
   AND (    (CAL.TIPCAL <> 31 AND CAL.TIPCAL <> 32 AND CAL.TIPCAO <> 31 AND CAL.TIPCAO <> 32) AND
            (    (EVC.CODCRT >= 1501 AND EVC.CODCRT <= 1526)
              OR (EVC.CODCRT >= 1601 AND EVC.CODCRT <= 1626 AND EVC.CODCRT <> 1606)
              OR (EVC.CODCRT >= 1701 AND EVC.CODCRT <= 1726)
              OR (EVC.CODCRT >= 1801 AND EVC.CODCRT <= 1826)
              OR EVC.CODCRT = 2507 OR EVC.CODCRT = 2607 OR EVC.CODCRT = 3105 OR EVC.CODCRT = 3108
              OR EVC.CODCRT = 3110 OR EVC.CODCRT = 3503 OR EVC.CODCRT = 3505 OR EVC.CODCRT = 3603
              OR EVC.CODCRT = 3606 OR EVC.CODCRT = 4003 OR EVC.CODCRT = 4006 OR EVC.CODCRT = 4010
              OR EVC.CODCRT = 4018 OR EVC.CODCRT = 4022 OR EVC.CODCRT = 4402 OR EVC.CODCRT = 4409
              OR EVC.CODCRT = 4410 OR EVC.CODCRT = 4503 OR EVC.CODCRT = 4508 OR EVC.CODCRT = 4511
              OR EVC.CODCRT = 5006 OR EVC.CODCRT = 5007 OR EVC.CODCRT = 5008
            )
       )

UNION

SELECT FUN.NUMEMP, FUN.TIPCOL, FUN.NUMCAD, FUN.DEPIRF, FUN.DEPSAF,
       FUN.DATINC, FUN.NUMINS, FUN.NUMPIS, FUN.TIPCON, FUN.CATSEF,
       FUN.NUMCPF, FUN.NOMFUN, FUN.DATNAS, FUN.DATADM, FUN.RATEVE,
       CAL.CODCAL, CAL.PERREF,  33 TIPCAL, CAL.DATPAG, CAL.INICMP, CAL.TIPCAO,
       VER.TABEVE, VER.CODEVE, VER.REFEVE, VER.VALEVE,
       EVC.CODCRT, EVC.CRTEVE, EVC.TIPEVE, EVC.DESEVE, EVC.CODCLC
  FROM VFP_CALDPS CAL, R046VER VER, R008EVC EVC, R034FUN FUN
 WHERE VER.NUMEMP = FUN.NUMEMP
   AND VER.TIPCOL = FUN.TIPCOL
   AND VER.NUMCAD = FUN.NUMCAD
   AND VER.NUMEMP = CAL.NUMEMP
   AND VER.CODCAL = CAL.CODCAL
   AND VER.TABEVE = EVC.CODTAB
   AND VER.CODEVE = EVC.CODEVE
   AND EVC.CODEVE < 2000
   AND (    (CAL.TIPCAL <> 31 AND CAL.TIPCAL <> 32 AND CAL.TIPCAO <> 31 AND CAL.TIPCAO <> 32) AND
            (    EVC.CODCRT = 1606 OR EVC.CODCRT = 4401 OR EVC.CODCRT = 4403 OR EVC.CODCRT = 4404
              OR EVC.CODCRT = 4405 OR EVC.CODCRT = 4406 OR EVC.CODCRT = 4407 OR EVC.CODCRT = 4408
            )
       )

UNION

SELECT FUN.NUMEMP, FUN.TIPCOL, FUN.NUMCAD, FUN.DEPIRF, FUN.DEPSAF,
       FUN.DATINC, FUN.NUMINS, FUN.NUMPIS, FUN.TIPCON, FUN.CATSEF,
       FUN.NUMCPF, FUN.NOMFUN, FUN.DATNAS, FUN.DATADM, FUN.RATEVE,
       CAL.CODCAL, CAL.PERREF,  99 TIPCAL, CAL.DATPAG, CAL.INICMP, CAL.TIPCAO,
       VER.TABEVE, VER.CODEVE, VER.REFEVE, VER.VALEVE,
       EVC.CODCRT, EVC.CRTEVE, EVC.TIPEVE, EVC.DESEVE, EVC.CODCLC
  FROM VFP_CALDPS CAL, R046VER VER, R008EVC EVC, R034FUN FUN
 WHERE VER.NUMEMP = FUN.NUMEMP
   AND VER.TIPCOL = FUN.TIPCOL
   AND VER.NUMCAD = FUN.NUMCAD
   AND VER.NUMEMP = CAL.NUMEMP
   AND VER.CODCAL = CAL.CODCAL
   AND VER.TABEVE = EVC.CODTAB
   AND VER.CODEVE = EVC.CODEVE
   AND ( EVC.CODEVE < 2000)
   AND (    (EVC.CODCRT >= 1101 AND EVC.CODCRT <= 1326)
         OR (EVC.CODCRT >= 4201 AND EVC.CODCRT <= 4226)
         OR EVC.CODCRT = 105  OR EVC.CODCRT = 205  OR EVC.CODCRT = 305
         OR EVC.CODCRT = 3502 OR EVC.CODCRT = 3506 OR EVC.CODCRT = 3507
         OR EVC.CODCRT = 4002 OR EVC.CODCRT = 4005 OR EVC.CODCRT = 4009
         OR EVC.CODCRT = 4016 OR EVC.CODCRT = 4017 OR EVC.CODCRT = 4020
         OR EVC.CODCRT = 4021 OR EVC.CODCRT = 4023 OR EVC.CODCRT = 4502
         OR EVC.CODCRT = 4507 OR EVC.CODCRT = 4510
       )VFP_CALDPS
