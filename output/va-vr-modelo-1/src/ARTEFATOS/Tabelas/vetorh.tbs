       INTO l_datfimANT,l_horfimANT,l_staaccANT,l_staatuANT 
       FROM R038HCH R038HCH
       WHERE TIPCRA=2 
      AND NUMEMP=p_numemp 
      AND TIPCOL=p_tipcol 
      AND NUMCAD=p_numcad 
      AND DATINI=p_datini 
      AND HORINI=p_horini;
          exception
            when OTHERS then
              l_coderr := 1;
          end;
          SP_DATSTR(l_datfimANT,'DDMMYY',l_OLDdatfim);
          l_OLDdatfim := SUBSTR(l_OLDdatfim,1,2)||'/'||SUBSTR(l_OLDdatfim,3,2)||'/20'||SUBSTR(l_OLDdatfim,5,2);
          SP_INTSTR(l_horfimANT,'HHMM',l_OLDhorfim);
