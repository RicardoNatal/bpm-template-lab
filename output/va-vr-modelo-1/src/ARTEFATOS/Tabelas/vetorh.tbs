TRIGGER R017PRM_ED AFTER DELETE ON R017PRM FOR EACH ROW
BEGIN
/* -- EXCLUO AS PERMISSOES POR LOCAL FISICO/DISPOSITIVO DE TODOS OS COLABORADORES, VINCULADOS A ESTE POSTO DE TRABALHO,
	 *    TANTO FAZ SE O HISTORICO EH PRINCIPAL OU ADICIONAL DE POSTO. A EXCLUSAO DESTA FORMA FICA MAIS PERFORMATICA. -- */
	BEGIN
		DELETE FROM R034PRM WHERE ESTPOS = :OLD.ESTPOS AND POSTRA = :OLD.POSTRA AND CODPLT = :OLD.CODPLT AND CODRLG = :OLD.CODRLG
				AND VERPLF = :OLD.VERPLF AND CODPLF = :OLD.CODPLF AND CODDSP = :OLD.CODDSP;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'R017PRM_ED: Erro ao excluir as permissao por local fisico/dispositivo dos colaboradores, com origem no posto de trabalho.';
	END;
	
	/* EXCLUO AS FAIXAS DE ACESSO DA PERMISSAO, DE TODOS OS COLABORADORES, VINCULADOS A ESTE POSTO DE TRABALHO */
	BEGIN
		DELETE FROM R034FAP WHERE ESTPOS = :OLD.ESTPOS AND POSTRA = :OLD.POSTRA AND CODPLT = :OLD.CODPLT AND CODRLG = :OLD.CODRLG
				AND VERPLF = :OLD.VERPLF AND CODPLF = :OLD.CODPLF AND CODDSP = :OLD.CODDSP;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'R017PRM_ED: Erro ao excluir as faixas de acesso da permissao, com origem no posto de trabalho.';
	END;
	
	/* EXCLUO TAMBEM AS ACOES DA FAIXA - POR DISPOSITIVO E POR LOCAL FISICO, DE TODOS OS COLABORADORES, VINCULADOS A ESTE POSTO DE TRABALHO */
	BEGIN
		DELETE FROM R034AFD WHERE ESTPOS = :OLD.ESTPOS AND POSTRA = :OLD.POSTRA AND CODDSP = :OLD.CODDSP;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'R017PRM_ED: Erro ao excluir as acoes da faixa/dispositivo dos colaboradores, com origem no posto de trabalho.';
	END;
	BEGIN
		DELETE FROM R034AFL WHERE ESTPOS = :OLD.ESTPOS AND POSTRA = :OLD.POSTRA AND VERPLF = :OLD.VERPLF AND CODPLF = :OLD.CODPLF;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'R017PRM_ED: Erro ao excluir as acoes da faixa/local fisico dos colaboradores, com origem no posto de trabalho.';
	END;
END		SENIOR;21␀␀

TRIGGER R017PRM_ED AFTER DELETE ON R017PRM FOR EACH ROW
BEGIN
/* -- EXCLUO AS PERMISSOES POR LOCAL FISICO/DISPOSITIVO DE TODOS OS COLABORADORES, VINCULADOS A ESTE POSTO DE TRABALHO,
	 *    TANTO FAZ SE O HISTORICO EH PRINCIPAL OU ADICIONAL DE POSTO. A EXCLUSAO DESTA FORMA FICA MAIS PERFORMATICA. -- */
	BEGIN
		DELETE FROM R034PRM WHERE ESTPOS = :OLD.ESTPOS AND POSTRA = :OLD.POSTRA AND CODPLT = :OLD.CODPLT AND CODRLG = :OLD.CODRLG
				AND VERPLF = :OLD.VERPLF AND CODPLF = :OLD.CODPLF AND CODDSP = :OLD.CODDSP;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'R017PRM_ED: Erro ao excluir as permissao por local fisico/dispositivo dos colaboradores, com origem no posto de trabalho.';
	END;
	
	/* EXCLUO AS FAIXAS DE ACESSO DA PERMISSAO, DE TODOS OS COLABORADORES, VINCULADOS A ESTE POSTO DE TRABALHO */
	BEGIN
		DELETE FROM R034FAP WHERE ESTPOS = :OLD.ESTPOS AND POSTRA = :OLD.POSTRA AND CODPLT = :OLD.CODPLT AND CODRLG = :OLD.CODRLG
				AND VERPLF = :OLD.VERPLF AND CODPLF = :OLD.CODPLF AND CODDSP = :OLD.CODDSP;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'R017PRM_ED: Erro ao excluir as faixas de acesso da permissao, com origem no posto de trabalho.';
