        SP_VALUPDATE_NUM(:OLD.CCINAS, :NEW.CCINAS, l_Valido OUT);
        IF (l_Valido = TRUE) THEN
          l_AlterouInfoNascimento := TRUE;
          SP_CONCAT_NUM_JSON('CCINAS', :NEW.CciNas, :OLD.CciNas, l_JsonInfoCadastral OUT);
          SP_CONCAT_NUM_JSON('CCINAS', :NEW.CciNas, :OLD.CciNas, l_JsonInfoVinculo OUT);
        END IF;
        
        SP_VALUPDATE_DES(:OLD.ESTNAS, :NEW.ESTNAS, l_Valido OUT);
        IF (l_Valido = TRUE) THEN
          l_AlterouInfoNascimento := TRUE;
          SP_CONCAT_DES_JSON('ESTNAS', :NEW.EstNas, :OLD.EstNas, l_JsonInfoCadastral OUT);
          SP_CONCAT_DES_JSON('ESTNAS', :NEW.EstNas, :OLD.EstNas, l_JsonInfoVinculo OUT);
        END IF;
      END IF;
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.DDITEL, :NEW.DDITEL, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouInfoCadastral := TRUE;
      SP_CONCAT_NUM_JSON('DDITEL', :NEW.DdiTel, :OLD.DdiTel, l_JsonInfoCadastral OUT);
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.DDDTEL, :NEW.DDDTEL, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouInfoCadastral := TRUE;
      SP_CONCAT_NUM_JSON('DDDTEL', :NEW.DddTel, :OLD.DddTel, l_JsonInfoCadastral OUT);
    END IF;
    
    SP_VALUPDATE_DES(:OLD.NUMTEL, :NEW.NUMTEL, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouInfoCadastral := TRUE;
      SP_CONCAT_DES_JSON('NUMTEL', :NEW.NumTel, :OLD.NumTel, l_JsonInfoCadastral OUT);
    END IF;
    
    IF (l_SimplificacaoESocial = FALSE) THEN
  	  SP_VALUPDATE_NUM(:OLD.NMDDI2, :NEW.NMDDI2, l_Valido OUT);
  	  IF (l_Valido = TRUE) THEN
  	    l_AlterouInfoCadastral := TRUE;
  	    SP_CONCAT_NUM_JSON('NMDDI2', :NEW.NmDdi2, :OLD.NmDdi2, l_JsonInfoCadastral OUT);
  	  END IF;
 	 
  	  SP_VALUPDATE_NUM(:OLD.NMDDD2, :NEW.NMDDD2, l_Valido OUT);
  	  IF (l_Valido = TRUE) THEN
  	    l_AlterouInfoCadastral := TRUE;
  	    SP_CONCAT_NUM_JSON('NMDDD2', :NEW.NmDdd2, :OLD.NmDdd2, l_JsonInfoCadastral OUT);
  	  END IF;
 	 
  	  SP_VALUPDATE_DES(:OLD.NMTEL2, :NEW.NMTEL2, l_Valido OUT);
  	  IF (l_Valido = TRUE) THEN
  	    l_AlterouInfoCadastral := TRUE;
  	    SP_CONCAT_DES_JSON('NMTEL2', :NEW.NmTel2, :OLD.NmTel2, l_JsonInfoCadastral OUT);
  	  END IF;
  	  
  	  SP_VALUPDATE_DES(:OLD.EMACOM, :NEW.EMACOM, l_Valido OUT);
  	  IF (l_Valido = TRUE) THEN
  	    l_AlterouInfoCadastral := TRUE;
  	    SP_CONCAT_DES_JSON('EMACOM', :NEW.EmaCom, :OLD.EmaCom, l_JsonInfoCadastral OUT);
  	  END IF;
    END IF;
    
    SP_VALUPDATE_DES(:OLD.EMAPAR, :NEW.EMAPAR, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_AlterouInfoCadastral := TRUE;
      SP_CONCAT_DES_JSON('EMAPAR', :NEW.EmaPar, :OLD.EmaPar, l_JsonInfoCadastral OUT);
    END IF;
    
    /* Campos monitorados de envio de Vinculo */
    SP_VALUPDATE_NUM(:OLD.PAINAS, :NEW.PAINAS, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      IF (l_SimplificacaoESocial = FALSE) THEN
        l_AlterouInfoNascimento := TRUE;
        SP_CONCAT_NUM_JSON('PAINAS', :NEW.PaiNas, :OLD.PaiNas, l_JsonInfoCadastral OUT);
        SP_CONCAT_NUM_JSON('PAINAS', :NEW.PaiNas, :OLD.PaiNas, l_JsonInfoVinculo OUT);
      END IF;
    
      IF (l_SimplificacaoESocial = TRUE) THEN
        SP_CONCAT_NUM_JSON('PAINAS', :NEW.PaiNas, :OLD.PaiNas, l_JsonInfoVinculo OUT);
        l_AlterouInfoVinculo := TRUE;
      END IF;
    END IF;    
    
    SP_VALUPDATE_DES(:OLD.CLAASS, :NEW.CLAASS, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      IF (l_layout = 'S-2200') THEN
        l_AlterouInfoVinculo := TRUE;
        SP_CONCAT_DES_JSON('CLAASS', :NEW.ClaAss, :OLD.ClaAss, l_JsonInfoVinculo OUT);
      END IF;  
    END IF;
    
    SP_VALUPDATE_DES(:OLD.OBJDET, :NEW.OBJDET, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      IF (l_layout = 'S-2200') THEN
        l_AlterouInfoObjCon := TRUE;
        SP_CONCAT_DES_JSON('OBJDET', :NEW.ObjDet, :OLD.ObjDet, l_JsonInfoVinculo OUT);
        SP_CONCAT_DES_JSON('OBJDET', :NEW.ObjDet, :OLD.ObjDet, l_JsonInfoObjetivoContrato OUT);
      END IF;  
    END IF;
  END IF;  
  
  l_JsonFlagsCadastral := l_JsonFlags;
  l_JsonFlagsVinculo := l_JsonFlags;
  l_JsonFlagsObjetivoContrato := l_JsonFlags;
  
  /* Flag para sinalizar que alterou exclusivamente informações de nascimento */
  IF (l_AlterouInfoNascimento = TRUE) THEN
    IF (l_AlterouInfoVinculo = FALSE) THEN
      SP_CONCATENAR_DES('INFNAS', '0', l_JsonFlagsVinculo OUT);
    END IF;
    IF (l_AlterouInfoCadastral = FALSE) THEN
      SP_CONCATENAR_DES('INFNAS', '0', l_JsonFlagsCadastral OUT);
    END IF;
  END IF;
  
  IF (l_AlterouInfoNascimento = TRUE) THEN
    l_AlterouInfoCadastral := TRUE;
    l_AlterouInfoVinculo := TRUE;
  END IF;
  
  IF ((l_AlterouInfoCadastral = TRUE) OR (l_AlterouInfoVinculo  = TRUE) OR (l_AlterouInfoObjCon = TRUE)) THEN
    IF (l_layout IS NOT NULL) THEN
      l_DataAlteracao := CURDATE();
    
      IF (l_AlterouInfoObjCon = TRUE) THEN
        SP_E_SOCIAL('S-2206', 'R034CPL', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_JsonFlagsObjetivoContrato, l_JsonInfoObjetivoContrato, 0, NULL, l_DataAlteracao, 0, 'R034CPL_EU');
      END IF;    
    
      IF (l_AlterouInfoVinculo = TRUE) THEN
        SP_E_SOCIAL(l_layout, 'R034CPL', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_JsonFlagsVinculo, l_JsonInfoVinculo, 0, NULL, l_DataAlteracao, 0, 'R034CPL_EU');
      END IF;    
    
      IF (l_AlterouInfoCadastral = TRUE) THEN
        RH_LAYOUT_ALT_CAD(l_layout, l_layoutAlteracaoCadastral OUT);
        SP_E_SOCIAL(l_layoutAlteracaoCadastral, 'R034CPL', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_JsonFlagsCadastral, l_JsonInfoCadastral, 0, NULL, l_DataAlteracao, 0, 'R034CPL_EU');
      END IF;        
    END IF;    
  END IF;  
  /*e-Social*/
  
  /* Geração do histórico da ficha complementar */
  IF ((:NEW.ficreg<>:OLD.ficreg)  
  OR (:NEW.codpai<>:OLD.codpai)  
