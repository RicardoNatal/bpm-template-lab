    END IF; 

    /* Verifica se tem registro com a mesma chave */
    IF  (l_coderr = 0) THEN
        /* busca autorização de liberação de interjornada */
        BEGIN
            SELECT COUNT(*) INTO l_count FROM R070LIJ WHERE NUMEMP = l_numEmp AND TIPCOL = l_tipCol AND NUMCAD = l_numCad AND DATINI = l_datIni AND HORINI = l_horIni;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN l_count := 0;
            WHEN OTHERS THEN l_count := 0;
        END;
        
        /* se tem a mesma chave, siginifca q foi gravado no mesmo momento */
        /* então só mantem o ultimo número físico */
        IF (l_count > 0) THEN
            /* fecha o histórico anterior do número físico, se existir */
            BEGIN
                UPDATE R070LIJ SET 
                        EMPAUT = l_numEmpAut,
                        TCLAUT = l_tipColAut,
                        CADAUT = l_numCadAut,
                        OBSSIJ = l_obsSij,
                        CODUSU = l_codUsu,
                        STAACC = l_staAcc
                    WHERE
                        NUMEMP = l_numEmp AND
                        TIPCOL = l_tipCol AND
                        NUMCAD = l_numCad AND
                        DATINI = l_datIni AND
                        HORINI = l_horIni;
            EXCEPTION
                WHEN OTHERS THEN l_coderr := 48;
            END;
        ELSE
            BEGIN
                INSERT INTO R070LIJ (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI,
                                     EMPAUT, TCLAUT, CADAUT, OBSSIJ, CODUSU, STAACC)
                             VALUES (l_numEmp, l_tipCol, l_numCad, l_datIni, l_horIni,
                                      l_numEmpAut, l_tipColAut, l_numCadAut, l_obsSij, l_codUsu, l_staAcc);
            EXCEPTION
                WHEN OTHERS THEN l_coderr := 49;
            END;
        END IF;

        /* não vou gerar a pendência 25 - updateRestTime como a tela G5 faz, pois a Portaria Avançada
         * é responsável por atualizar o Data Mart instantaneamente */
    END IF; /* l_coderr = 0 */
    
    /* retorna Código do erro */
    p_retErr := l_codErr;
END		SENIOR;24 SP_STRTODATE
SP_PESFROMIDTPES
ø␀␀/* Processa demanda de sicronismo - 11 = Liberação de Interjornada (R070LIJ) */
PROCEDURE SP_SINLIJ(P_VALSTR VARCHAR2(255),P_RETERR OUT NUMBER(2))
 IS

    l_codErr     NUMBER(2);
    l_datCon     VARCHAR2(25);
    l_idtPes     VARCHAR2(23);
    l_idtAut     VARCHAR2(23);
    l_datStr     VARCHAR2(16);
    l_pos        NUMBER(3);
    l_tam        NUMBER(3);
    l_obsSij     VARCHAR2(80);
    l_codUsu     NUMBER(10);
    l_datIni     DATE;
    l_horIni     NUMBER(4);
    l_count      NUMBER(1);
    l_temInt     CHAR(1);
    l_temDat     CHAR(1);
    l_craPro     NUMBER(12);
    l_craTit     NUMBER(12);
    l_craAti     NUMBER(12);
    l_craAtiStr  CHAR(12);
    l_datAtu     DATE;
    l_horAtu     NUMBER(4);
    l_staAcc     NUMBER(1);
    
    /*Variáveis auxiliares para desmontar IDTPES do colaborador*/
    l_tipPes     NUMBER(2);
    l_numEmp     NUMBER(4);
    l_tipCol     NUMBER(1);
    l_numCad     NUMBER(9);
    l_tipDoc     NUMBER(1);
    l_numDoc     VARCHAR2(20);
    l_numMat     VARCHAR2(15);
    l_proPac     VARCHAR2(20);
    
    /*Variáveis auxiliares para desmontar IDTPES do autorizador*/
    l_tipPesAut  NUMBER(2);
    l_numEmpAut  NUMBER(4);
    l_tipColAut  NUMBER(1);
    l_numCadAut  NUMBER(9);
    l_tipDocAut  NUMBER(1);
    l_numDocAut  VARCHAR2(20);
    l_numMatAut  VARCHAR2(15);
    l_proPacAut  VARCHAR2(20);
BEGIN
    /* inicializa variáveis */
    l_codErr := 0;
    p_retErr := 0;
    l_count  := 0;
    l_craAti := 0;
    l_codUsu := 0;
    
    /* separa os valores da string do p_valStr em cada variável */
    BEGIN
        l_pos := 3;    
        l_idtPes := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_datStr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
        l_idtAut := SUBSTRING(p_ValStr, l_pos, 23); l_pos := l_pos + 23;
        l_obsSij := NULL;
        
        l_tam := CONVERT(CHAR_TO_NUMBER,SUBSTRING(p_valStr, l_pos, 3)); l_pos := l_pos + 3;        
        IF (l_tam > 0) THEN
            l_obsSij := LTRIM(RTRIM(SUBSTRING(p_valStr, l_pos, l_tam))); l_pos := l_pos + l_tam;

            IF  (l_obsSij = '') THEN
              l_obsSij := NULL;
            END IF;
        END IF;
        
        /* CODUSU */
        l_codUsu := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
        
        /* converte data/hora inicial */
        l_datCon := SUBSTRING(l_datStr,1,2) || '/' || SUBSTRING(l_datStr,3,2) ||'/'||SUBSTRING(l_datStr,5,2);
        SP_STRTODATE(l_datCon,'DD/MM/AA', l_datIni OUT);
        l_horIni := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datStr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datStr,9,2)));

        /* desmontar IDTPES do visitante */
        SP_PESFROMIDTPES(l_idtPes, l_tipPes OUT, l_numEmp OUT, l_tipCol OUT, l_numCad OUT, l_tipDoc OUT, l_numDoc OUT, l_numMat OUT, l_proPac OUT);
        
        /* desmontar IDTPES do autorizador */
        SP_PESFROMIDTPES(l_idtAut, l_tipPesAut OUT, l_numEmpAut OUT, l_tipColAut OUT, l_numCadAut OUT, l_tipDocAut OUT, l_numDocAut OUT, l_numMatAut OUT, l_proPacAut OUT);
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 47; /* erro de conversão na string */
    END;
    
    /* Calcula data/hora */
    l_datAtu := CURDATE();
    l_horAtu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  
    /* Calcula o status */
    l_staAcc := 0;
    IF (l_datIni > l_datAtu) OR ((l_datIni = l_datAtu) AND (l_horIni > l_horAtu)) THEN
        l_staAcc := 0; /* liberação futura */
    ELSE
        l_staAcc := 1; /* liberação presente */
    END IF; 

    /* Verifica se tem registro com a mesma chave */
    IF  (l_coderr = 0) THEN
        /* busca autorização de liberação de interjornada */
        BEGIN
            SELECT COUNT(*) INTO l_count FROM R070LIJ WHERE NUMEMP = l_numEmp AND TIPCOL = l_tipCol AND NUMCAD = l_numCad AND DATINI = l_datIni AND HORINI = l_horIni;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN l_count := 0;
            WHEN OTHERS THEN l_count := 0;
        END;
        
        /* se tem a mesma chave, siginifca q foi gravado no mesmo momento */
        /* então só mantem o ultimo número físico */
        IF (l_count > 0) THEN
            /* fecha o histórico anterior do número físico, se existir */
            BEGIN
                UPDATE R070LIJ SET 
                        EMPAUT = l_numEmpAut,
                        TCLAUT = l_tipColAut,
                        CADAUT = l_numCadAut,
                        OBSSIJ = l_obsSij,
                        CODUSU = l_codUsu,
                        STAACC = l_staAcc
                    WHERE
                        NUMEMP = l_numEmp AND
                        TIPCOL = l_tipCol AND
                        NUMCAD = l_numCad AND
                        DATINI = l_datIni AND
                        HORINI = l_horIni;
            EXCEPTION
                WHEN OTHERS THEN l_coderr := 48;
            END;
        ELSE
            BEGIN
                INSERT INTO R070LIJ (NUMEMP, TIPCOL, NUMCAD, DATINI, HORINI,
                                     EMPAUT, TCLAUT, CADAUT, OBSSIJ, CODUSU, STAACC)
                             VALUES (l_numEmp, l_tipCol, l_numCad, l_datIni, l_horIni,
                                      l_numEmpAut, l_tipColAut, l_numCadAut, l_obsSij, l_codUsu, l_staAcc);
            EXCEPTION
                WHEN OTHERS THEN l_coderr := 49;
            END;
        END IF;

        /* não vou gerar a pendência 25 - updateRestTime como a tela G5 faz, pois a Portaria Avançada
         * é responsável por atualizar o Data Mart instantaneamente */
    END IF; /* l_coderr = 0 */
    
    /* retorna Código do erro */
    p_retErr := l_codErr;
END␀èø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_STRTODATE
º␀␀/* Processa demanda de sicronismo da Portaria OFF LINE  - 04 -  Sincronizar alterações de local (R070PLF/R070MEV) */
PROCEDURE SP_SINMEV(P_VALSTR VARCHAR2(2047),P_RETERR OUT NUMBER(2))
 IS

l_datIns     DATE;
    l_horIns     NUMBER(4);
    l_seqIns     NUMBER(2);
    l_tipOpe     NUMBER(1);
    l_idtpes     VARCHAR2(23);
    l_verPlf     NUMBER(3);
    l_codPlf     NUMBER(7);
    l_datzer     DATE;
    l_codusu     NUMBER(10);
    l_coderr     NUMBER(2);
    l_datatu     DATE;
    l_count      NUMBER(1);

    /*Variáveis auxiliares para conversão de data*/
    l_datstr     CHAR(16);
    l_datcon     VARCHAR(25);

BEGIN
    /* inicializa variáveis */
    l_coderr := 0;
    p_RetErr := 0;
    l_datins := CURDATE();
    l_datatu := CURDATE();
    l_datzer := '31/12/1900,00:00:00';
    l_codusu := 0;
    l_verplf := 1;
    l_codplf := 0;

    /* separa os valores da string do p_valStr em cada variável */
    BEGIN
        /* converte data/hora inicial */
        l_datstr := SUBSTRING(p_ValStr, 3,16);
        l_datcon := SUBSTRING(l_datstr,1,2) || '/' || SUBSTRING(l_datstr,3,2) ||'/'||SUBSTRING(l_datstr,5,2);
        SP_STRTODATE(l_datcon,'DD/MM/AA', l_datIns OUT);
        l_horIns := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datstr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datstr,9,2)));
        l_seqIns := SUBSTRING(l_datstr,11,2);

        l_tipope := SUBSTRING(p_ValStr, 19,1);
        l_idtpes := SUBSTRING(p_ValStr, 20,23);
        l_verplf := SUBSTRING(p_ValStr, 43,3);
        l_codplf := SUBSTRING(p_ValStr, 46,7);
	l_codusu := SUBSTRING(p_ValStr, 53,10);
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 1; /* erro de conversão na string */
            /*RAISERROR 103 'END Sincronismo: '|| SQLERRM();*/
    END;

    IF (l_datins IS NULL) THEN
        l_datins := CURDATE();
    END IF;

    IF  (l_coderr = 0) THEN
        BEGIN
            INSERT INTO R070MEV (DATINS, HORINS, SEQINS, TPOPER, IDTPES, VERPLF,
                                 CODPLF, NUMCRA, CODPLT, CODRLG, DATACC, HORACC,
                                 CODUSU, CODDSP) VALUES
                                (l_datins, l_horins, l_seqins, l_tipope, l_idtpes, l_verplf,
                                 l_codplf, 0, 0, 0, l_datins, l_horins,
                                 l_codusu, 0);
        EXCEPTION
            WHEN OTHERS THEN l_coderr := 11;  /* erro no INSERT do registro*/
        END;

    END IF;

    IF  (l_coderr = 0) THEN
        /* se operação for 1, retira a pessoa da r070plf */
        IF (l_tipope = 1) THEN
            BEGIN
                DELETE FROM R070PLF WHERE IDTPES = l_idtpes;
            EXCEPTION
                WHEN OTHERS THEN l_coderr := 14;  /* erro no INSERT do registro*/
            END;
        END IF;

        /* se operação for 2, atualizar também a r070plf */
        IF (l_tipope = 2) THEN
            BEGIN
                /* exclui para garantir a inserção */
                DELETE FROM R070PLF WHERE IDTPES = l_idtpes;
                
                INSERT INTO R070PLF (VERPLF, CODPLF, NUMCRA, CODPLT, CODRLG, DATACC, HORACC, IDTPES, CODDSP) VALUES
                                    (l_verplf, l_codplf, 0, 0, 0, l_datins, l_horins, l_idtpes, 0);
            EXCEPTION
                WHEN OTHERS THEN l_coderr := 15;  /* erro no INSERT do registro*/
            END;
        END IF;
    END IF;

    /* retorna Código do erro */
    p_retErr := l_codErr;
END␀éø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
