␀␀CREATE OR REPLACE PROCEDURE SP_CONCAT_FLO_JSON(
    p_Campo IN VARCHAR2,
    p_Valor_New IN NUMBER,
    p_Valor_Old IN NUMBER,
    p_Decim INTEGER,
    p_Retorno IN OUT VARCHAR2)
IS
    l_Valor_New VARCHAR2(2000);
    l_Valor_Old VARCHAR2(2000);
BEGIN
  
  SELECT REPLACE(TO_CHAR(p_Valor_New), '.', ',')
  INTO l_Valor_New
  FROM DUAL;
  
  SELECT REPLACE(TO_CHAR(p_Valor_Old), '.', ',')
  INTO l_Valor_Old
  FROM DUAL;
    
  SP_CONCAT_DES_JSON(p_Campo,l_Valor_New,l_Valor_Old,p_Retorno);
  RETURN;
END;

