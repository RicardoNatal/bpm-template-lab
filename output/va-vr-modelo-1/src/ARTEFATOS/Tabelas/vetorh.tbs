/* INSERT (NEW) */
TRIGGER R030EED_SI AFTER INSERT ON R030EED FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs ENTIDADES EDUCATIVAS - ESTABELECIMENTO ESOCIAL */ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 62;     /* ENTIDADES EDUCATIVAS - ESTABELECIMENTO ESOCIAL*/
  l_codtpa := 235;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030EED_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
        SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOEM', CONVERT(NUMBER_TO_CHAR, :NEW.CODOEM));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030EED_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
  END IF; 
END␀Ò␀␀		SENIOR;0␀␀TRIGGER R030EED_EI BEFORE INSERT ON R030EED FOR EACH ROW DECLARE
	l_Valor VARCHAR2(2000);
	l_ProximaData DATE;
	l_Where VARCHAR(2000);
	l_EmpresaStr VARCHAR(11);
	l_FilialStr VARCHAR(11);
BEGIN
/* e-Social -> S-1005 */
	l_Valor := '';
	l_ProximaData := '31/12/1900,00:00:00';

	l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP);
	l_FilialStr := CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL);

	l_Where := 'NUMEMP = ' || l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr;
	SP_PROXIMOHIST('DATALT', 'R030EES', l_Where, :NEW.DATALT, l_ProximaData OUT);
	SP_CONCATENAR_NUM('CODFIL', :NEW.CODFIL, l_Valor OUT);

	SP_E_SOCIAL('S-1005', 'R030EES', 'T', 'A', :NEW.DATALT, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030EED_EI');
	/* e-Social -> S-1005 */
END␀Ò␀␀		SENIOR;0€␀␀ 

TRIGGER R030EED_SU AFTER UPDATE ON R030EED FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs ENTIDADES EDUCATIVAS - ESTABELECIMENTO ESOCIAL*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 62;     /* ENTIDADES EDUCATIVAS - ESTABELECIMENTO ESOCIAL*/
  l_codtpa := 236;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFil <> :NEW.CodFil)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.CodOem <> :NEW.CodOem)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R030EED_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOEM', CONVERT(NUMBER_TO_CHAR, :OLD.CODOEM));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R030EED_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
    END IF; 
  END IF; 
END␀	Ò␀␀		SENIOR;0§␀␀

TRIGGER R030EED_EU BEFORE UPDATE ON R030EED FOR EACH ROW DECLARE
	l_Valor VARCHAR2(2000);
	l_ProximaData DATE;
	l_Where VARCHAR(2000);
	l_EmpresaStr VARCHAR(11);
	l_FilialStr VARCHAR(11);
	l_infoFacult BOOLEAN;
	l_SimplificaoESocial BOOLEAN;
	l_VersaoESocial NUMBER;
BEGIN
	/* e-Social -> S-1005 */
	l_Valor := '';
	l_ProximaData := '31/12/1900,00:00:00';
	l_infoFacult := TRUE;
	l_SimplificaoESocial := FALSE;
	l_VersaoESocial := 0;
	
	/* Só monitora o campo se o cliente opta por enviar as informações facultativas	*/
	SP_ESOCIAL_INFO(:NEW.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
	
	IF (l_infoFacult = TRUE) THEN
		l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP);
		l_FilialStr := CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL);

		l_Where := 'NUMEMP = ' || l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr;
		SP_PROXIMOHIST('DATALT', 'R030EES', l_Where, :NEW.DATALT, l_ProximaData OUT);
		SP_CONCATENAR_NUM('CODFIL', :NEW.CODFIL, l_Valor OUT);

		SP_E_SOCIAL('S-1005', 'R030EES', 'T', 'A', :NEW.DATALT, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL,
		NULL, 0, 'R030EED_EU');
		/* e-Social -> S-1005 */
	END IF;
END␀
Ò␀␀		SENIOR;0î␀␀ 

