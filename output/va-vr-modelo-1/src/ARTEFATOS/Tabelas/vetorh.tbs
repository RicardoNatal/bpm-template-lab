Ö␀␀create or replace PROCEDURE SP_QTDPRV(p_IdtPes IN CHAR,p_QtdPrv OUT NUMBER) IS
  l_QtdPrv NUMBER(2);
  l_datzer DATE;
  l_fimmes DATE;
  l_inimes DATE;
  l_numemp NUMBER(4);
  l_tipcol NUMBER(1);
  l_numcad NUMBER(9);
  l_tipdoc NUMBER(1);
  l_numdoc VARCHAR2(20);
  l_nummat VARCHAR2(15);
  l_propac VARCHAR2(20);
  l_tippes NUMBER(2);
  l_conprc CHAR(1);
begin
  l_QtdPrv := 0;
  p_QtdPrv := 0;
  l_datzer :=  TO_DATE('31/12/1900,00:00:00','DD/MM/YYYY,HH24:MI:SS');
  l_conprc := 'N';
  begin
    SELECT 
      R058DCR.CONPRC CONPRC
       INTO l_conprc 
       FROM R058DCR R058DCR;
  exception
    when OTHERS then
      l_conprc := 'N';
  end;
  if (l_conprc='S') then
    begin
      SELECT 
      TRUNC(SYSDATE,'MONTH') EXPR1392845731
       INTO l_inimes 
       FROM DUAL DUAL;
      SELECT 
      LAST_DAY(SYSDATE) EXPR43663924
       INTO l_fimmes 
       FROM DUAL DUAL;
    exception
      when OTHERS then
        raise_application_error(-20000 + -(103),'Procedure SP_QTDPRV. Erro na conversão de datas.');
    end;
    SP_PESFROMIDTPES(p_idtpes,l_tippes,l_numemp,l_tipcol,l_numcad,l_tipdoc,l_numdoc,l_nummat,l_propac);
    if (l_tippes<4) then
      begin
        SELECT 
      COUNT(*) EXPR1288330502
       INTO l_qtdPrv 
       FROM R038HCH R038HCH
       WHERE NUMEMP=l_numemp 
      AND TIPCOL=l_tipcol 
      AND NUMCAD=l_numcad 
      AND TIPCRA=2 
      AND DATINI>=l_inimes 
      AND DATINI<=l_fimmes 
      AND (DATFIM<=l_fimmes 
      OR DATFIM=l_datzer);
      exception
        when OTHERS then
          l_qtdPrv := 0;
      end;
    else
      l_qtdPrv := 0;
    end if;
  else
    l_qtdPrv := 0;
  end if;
  p_QtdPrv := l_qtdPrv;
end SP_QTDPRV;


		ORACLE;22SP_PESFROMIDTPES
