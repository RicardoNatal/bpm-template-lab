	  IF (l_AlterouPessoa = TRUE) THEN
       	/* Retornar a data do primeiro hist. filial do colaborador */
        R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);
        
        /* Retornar se o colaborador está ativo */
        R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);
        
	    BEGIN
          UPDATE R033PES SET EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                             DEPAUX = 0, COLATI = l_ColAti, CANAUX = 0, DATAUX = l_DatAltHFI WHERE CODPES = L_CODPES;
        EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'Erro ao atualizar campos auxiliares da R033PES';
        END;	
      END IF;	
	  	  
      /**VERIFICA ENDEREÇO*/
      BEGIN
        SELECT DATALT,ENDRUA,ENDNUM,ENDCPL,CODCID,CODBAI,ENDCEP,TIPLGR
        INTO l_DatAlt,l_EndRua,l_EndNum,l_EndCpl,l_CodCid,l_CodBai,l_EndCep,l_TipLgr
        FROM R033END
        WHERE CODPES = L_CODPES AND TIPEND = 1 AND DATALT =
         (SELECT MAX(B.DATALT) FROM R033END B WHERE B.CODPES = R033END.CODPES AND B.DATALT <= l_DatAtu);
        EXCEPTION WHEN NO_DATA_FOUND THEN
          l_EndRua := ' ';
          l_EndNum := ' ';
          l_EndCpl := ' ';
          l_CodCid := 0;
          l_CodBai := 0;
          l_EndCep := 0;
          l_DatAlt := l_data_zero;
          l_TipLgr := ' ';
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler R033END';
      END;

      l_AlterouEndereco := 0;
      IF (:NEW.ENDRUA <> l_EndRua) THEN
        l_EndRua := :NEW.ENDRUA;
        l_AlterouEndereco := 1;
      END IF;
      IF (:NEW.ENDNUM<>l_EndNum) THEN
        l_EndNum := :NEW.ENDNUM;
        l_AlterouEndereco := 1;
      END IF;
      IF (:NEW.ENDCPL <> l_EndCpl) THEN
        l_EndCpl := :NEW.ENDCPL;
        l_AlterouEndereco := 1;
      END IF;
      IF (:NEW.CODCID <> l_CodCid) THEN
        l_CodCid := :NEW.CODCID;
        l_AlterouEndereco := 1;
      END IF;
      IF (:NEW.CODBAI <> l_CodBai) THEN
        l_CodBai := :NEW.CODBAI;
        l_AlterouEndereco := 1;
      END IF;
      IF (:NEW.ENDCEP <> l_EndCep) THEN
        l_EndCep := :NEW.ENDCEP;
        l_AlterouEndereco := 1;
      END IF;
      IF (:NEW.TIPLGR <> l_TipLgr) THEN
        l_TipLgr := :NEW.TIPLGR;
        l_AlterouEndereco := 1;
      END IF;

      IF (l_AlterouEndereco = 1) THEN
       	/* Retornar a data do primeiro hist. filial do colaborador */
        R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);
        
        /* Retornar se o colaborador está ativo */
        R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);
          
        IF (l_DatAtu <> l_DatAlt) THEN
          BEGIN
            INSERT INTO R033END(CODPES,TIPEND,DATALT,ENDRUA,ENDNUM,ENDCPL,CODCID,CODBAI,ENDCEP,TIPLGR,EMPAUX,TIPAUX,CADAUX,DEPAUX,COLATI,CANAUX,DATAUX)
            VALUES (L_CODPES,1,l_DatAtu,l_EndRua,l_EndNum,l_EndCpl,l_CodCid,l_CodBai,l_EndCep,l_TipLgr,:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,0,l_ColAti,0,l_DatAltHFI);
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao inserir na R033END';
          END;
        ELSE
          BEGIN
            SELECT ENDRUA,ENDNUM,ENDCPL,CODCID,CODBAI,ENDCEP,TIPLGR
            INTO l_EndRuaAnt,l_EndNumAnt,l_EndCplAnt,l_CodCidAnt,l_CodBaiAnt,l_EndCepAnt,l_TipLgrAnt
            FROM R033END WHERE  CODPES = L_CODPES AND TIPEND = 1 AND DATALT = (SELECT MAX(B.DATALT) FROM R033END B WHERE B.CODPES = R033END.CODPES AND B.DATALT < l_DatAtu);
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              l_EndRuaAnt := ' ';
              l_EndNumAnt := ' ';
              l_EndCplAnt := ' ';
              l_CodCidAnt := 0;
              l_CodBaiAnt := 0;
              l_EndCepAnt := 0;
              l_TipLgrAnt := ' ';
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao ler R033END';
          END;

          IF (l_EndRuaAnt <> l_EndRua) OR (l_EndNumAnt <> l_EndNum) OR (l_EndCplAnt <> l_EndCpl) OR (l_CodCidAnt <>
            l_CodCid) OR (l_CodBaiAnt <> l_CodBai) OR (l_EndCepAnt <> l_EndCep) OR (l_TipLgrAnt <> l_TipLgr) THEN
            BEGIN
            /*Se jÃ¡ existir o endereÃ§o atulizar com os dados atuais do Ficha complementar*/
              UPDATE R033END SET ENDRUA = l_EndRua,ENDNUM = l_EndNum,ENDCPL = l_EndCpl,CODCID = l_CodCid,CODBAI = l_CodBai,ENDCEP = l_EndCep,TIPLGR = l_TipLgr,
                                 EMPAUX = :NEW.NUMEMP,TIPAUX = :NEW.TIPCOL,CADAUX = :NEW.NUMCAD,DEPAUX = 0,COLATI = l_ColAti,CANAUX = 0,DATAUX = l_DatAltHFI 
              WHERE (CODPES = L_CODPES) AND (TIPEND = 1) AND (DATALT = l_DatAlt);
            EXCEPTION
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao atualizar a R033END';
            END;
          ELSE
            BEGIN
              DELETE FROM R033END
              WHERE (CODPES = L_CODPES) AND (TIPEND = 1) AND (DATALT = l_DatAlt);
            EXCEPTION
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao atualizar a R033END';
            END;
          END IF;
        END IF;
      END IF;
    END IF;
  END IF;
  /*FIM SINCRONIZAÇÃO*/

  /* Atualiza registro CURRICULO COMPILADO */
  /* Garante que todo colaborador está com registro atualizado na tabela R122CCO - Tarefa: 236116*/
  IF (:NEW.PAINAS <> :OLD.PAINAS) OR (:NEW.ESTNAS <> :OLD.ESTNAS) OR (:NEW.CCINAS <> :OLD.CCINAS) OR
     (:NEW.CODPAI <> :OLD.CODPAI) OR (:NEW.CODEST <> :OLD.CODEST) OR (:NEW.CODCID <> :OLD.CODCID) OR (:NEW.CODBAI <> :OLD.CODBAI) OR
     (:NEW.ENDRUA <> :OLD.ENDRUA) OR (:NEW.ENDNUM <> :OLD.ENDNUM) OR (:NEW.ENDCPL <> :OLD.ENDCPL) OR (:NEW.ENDCEP <> :OLD.ENDCEP) OR
     (:NEW.DDITEL <> :OLD.DDITEL) OR (:NEW.DDDTEL <> :OLD.DDDTEL) OR (:NEW.NUMTEL <> :OLD.NUMTEL) OR
     (:NEW.NMDDI2 <> :OLD.NMDDI2) OR (:NEW.NMDDD2 <> :OLD.NMDDD2) OR (:NEW.NMTEL2 <> :OLD.NMTEL2) OR
     (:NEW.NUMCID <> :OLD.NUMCID) OR (:NEW.EMICID <> :OLD.EMICID) OR (:NEW.DEXCID <> :OLD.DEXCID) OR (:NEW.ESTCID <> :OLD.ESTCID) OR
     (:NEW.NUMELE <> :OLD.NUMELE) OR (:NEW.ZONELE <> :OLD.ZONELE) OR (:NEW.SECELE <> :OLD.SECELE) OR
     (:NEW.NUMRES <> :OLD.NUMRES) OR (:NEW.CATRES <> :OLD.CATRES) OR (:NEW.NUMCNH <> :OLD.NUMCNH) OR (:NEW.CATCNH <> :OLD.CATCNH) OR
     (:NEW.EMAPAR <> :OLD.EMAPAR) OR (:NEW.EMACOM <> :OLD.EMACOM) OR (:NEW.CODRLR <> :OLD.CODRLR) OR (:NEW.CODQUA <> :OLD.CODQUA) THEN
    RS_UPDCURCOMP(0, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD);
