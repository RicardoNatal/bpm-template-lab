␀␀␀␀␀␀␀␀Á␀Á␀r␀␀␀ÿ␀␀ÿR␀␀␀0;1;2;3=Ó␀␀		SENIOR;0P␀␀TRIGGER R034CTR_EI AFTER INSERT ON R034CTR FOR EACH ROW

DECLARE
  l_layoutAltContratual VARCHAR2(6);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN
  /* eSocial */ 
	RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAltContratual OUT);
	IF ((l_layoutAltContratual IS NOT NULL) AND LENGTH(LTRIM(RTRIM(l_layoutAltContratual))) > 0)  THEN
	   SP_HIST_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATINI, 'R034CTR', 'DATINI', 'I', '', '', 0, 'R034CTR_EI');
	END IF;
  /* eSocial */
  
  /* Geração de logs Contrato Temporário (Tabela: R034CTR)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 110;     /* Contrato Temporário (Tabela: R034CTR)*/
  l_codtpa := 331;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
  	  SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034CTR_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034CTR_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MOTCTR', CONVERT(NUMBER_TO_CHAR, :NEW.MOTCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCTR', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INCCTR', CONVERT(NUMBER_TO_CHAR, :NEW.INCCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'JUSCTR', 'registro incluído (excede limite de exibição)');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CPFSBS', CONVERT(NUMBER_TO_CHAR, :NEW.CPFSBS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MATSBS', :NEW.MATSBS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITGER', CONVERT(NUMBER_TO_CHAR, :NEW.SITGER));
        SP_DATSTR(:NEW.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATFIM', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDDIF', :NEW.ENDDIF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPAI', CONVERT(NUMBER_TO_CHAR, :NEW.CODPAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEST', :NEW.CODEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCID', CONVERT(NUMBER_TO_CHAR, :NEW.CODCID));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODBAI', CONVERT(NUMBER_TO_CHAR, :NEW.CODBAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDCEP', CONVERT(NUMBER_TO_CHAR, :NEW.ENDCEP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDRUA', :NEW.ENDRUA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDNUM', :NEW.ENDNUM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDCPL', :NEW.ENDCPL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOEM', CONVERT(NUMBER_TO_CHAR, :NEW.CODOEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPINS', CONVERT(NUMBER_TO_CHAR, :NEW.TIPINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMINS', CONVERT(NUMBER_TO_CHAR, :NEW.NUMINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPLGR', :NEW.TIPLGR);
      END;
  END IF; 
END␀>Ó␀␀		SENIOR;0ú/␀␀

TRIGGER R034CTR_EU AFTER UPDATE ON R034CTR FOR EACH ROW

DECLARE
  l_Alterou BOOLEAN;
  l_Valido  BOOLEAN;
  l_layoutAltContratual VARCHAR2(6);
  l_JsonCamposAlterados VARCHAR2(2000);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_InfoFacult   BOOLEAN;
  l_SimplificacaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  l_Alterou := FALSE;
  l_JsonCamposAlterados := '';
  l_InfoFacult := TRUE;
  l_SimplificacaoESocial := FALSE;
  l_VersaoESocial := 0;
  
  /* Só monitora o campo se o cliente opta por enviar as informações facultativas*/
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificacaoESocial OUT, l_VersaoESocial OUT);

  SP_VALUPDATE_DAT(:OLD.DatFim, :NEW.DatFim, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_DAT_JSON('DATFIM', :NEW.DatFim, :OLD.DatFim, l_JsonCamposAlterados OUT);
  END IF;

  SP_VALUPDATE_NUM(:OLD.MotCtr, :NEW.MotCtr, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_NUM_JSON('MOTCTR', :NEW.MotCtr, :OLD.MotCtr, l_JsonCamposAlterados OUT);
  END IF;
  
  IF (l_InfoFacult = TRUE) THEN
    IF (l_SimplificacaoESocial = FALSE) THEN
		SP_VALUPDATE_NUM(:OLD.IncCtr, :NEW.IncCtr, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
		  l_Alterou := TRUE;
		  SP_CONCAT_NUM_JSON('INCCTR', :NEW.IncCtr, :OLD.IncCtr, l_JsonCamposAlterados OUT);
		END IF;
	END IF;
	
	SP_VALUPDATE_DES(:OLD.TipLgr, :NEW.TipLgr, l_Valido OUT);
  	IF (l_Valido = TRUE) THEN
    	l_Alterou := TRUE;
    SP_CONCAT_DES_JSON('TIPLGR', :NEW.TipLgr, :OLD.TipLgr, l_JsonCamposAlterados OUT);
  	END IF;
  END IF;
  
  SP_VALUPDATE_DES(:OLD.JusCtr, :NEW.JusCtr, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_DES_JSON('JUSCTR', 'Justificativa alterada.', 'Justificativa alterada.', l_JsonCamposAlterados OUT);
  END IF;

  SP_VALUPDATE_NUM(:OLD.CPFSbs, :NEW.CPFSbs, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_FLO_JSON('CPFSBS', :NEW.CPFSbs, :OLD.CPFSbs, 0, l_JsonCamposAlterados OUT);
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.TipIns, :NEW.TipIns, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_NUM_JSON('TIPINS', :NEW.TipIns, :OLD.TipIns, l_JsonCamposAlterados OUT);
  END IF;
 
  SP_VALUPDATE_NUM(:OLD.NumIns, :NEW.NumIns, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_FLO_JSON('NUMINS', :NEW.NumIns, :OLD.NumIns, 0, l_JsonCamposAlterados OUT);
  END IF;
  
  SP_VALUPDATE_DES(:OLD.EndDif, :NEW.EndDif, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_DES_JSON('ENDDIF', :NEW.EndDif, :OLD.EndDif, l_JsonCamposAlterados OUT);
  END IF;
  
  SP_VALUPDATE_DES(:OLD.CodEst, :NEW.CodEst, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_DES_JSON('CODEST', :NEW.CodEst, :OLD.CodEst, l_JsonCamposAlterados OUT);
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.CodCid, :NEW.CodCid, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_NUM_JSON('CODCID', :NEW.CodCid, :OLD.CodCid, l_JsonCamposAlterados OUT);
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.CodBai, :NEW.CodBai, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_NUM_JSON('CODBAI', :NEW.CodBai, :OLD.CodBai, l_JsonCamposAlterados OUT);
  END IF;
  
  SP_VALUPDATE_DES(:OLD.EndCep, :NEW.EndCep, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_DES_JSON('ENDCEP', :NEW.EndCep, :OLD.EndCep, l_JsonCamposAlterados OUT);
  END IF;
  
  SP_VALUPDATE_DES(:OLD.EndRua, :NEW.EndRua, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_DES_JSON('ENDRUA', :NEW.EndRua, :OLD.EndRua, l_JsonCamposAlterados OUT);
  END IF;
  
  SP_VALUPDATE_DES(:OLD.EndNum, :NEW.EndNum, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_DES_JSON('ENDNUM', :NEW.EndNum, :OLD.EndNum, l_JsonCamposAlterados OUT);
  END IF;
  
  SP_VALUPDATE_DES(:OLD.EndCpl, :NEW.EndCpl, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
    SP_CONCAT_DES_JSON('ENDCPL', :NEW.EndCpl, :OLD.EndCpl, l_JsonCamposAlterados OUT);
  END IF;
  
  
  IF (l_Alterou = TRUE) THEN 
	RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAltContratual OUT);
  	IF ((l_layoutAltContratual IS NOT NULL) AND LENGTH(LTRIM(RTRIM(l_layoutAltContratual))) > 0)  THEN
	  	SP_HIST_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATINI, 'R034CTR', 'DATINI', 'A', '', l_JsonCamposAlterados, 0, 'R034CTR_EU');
	END IF;


  END IF;
  
  /* Geração de logs Contrato Temporário (Tabela: R034CTR)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 110;     /* Contrato Temporário (Tabela: R034CTR)*/
  l_codtpa := 332;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatIni <> :NEW.DatIni)
   OR (:OLD.MotCtr <> :NEW.MotCtr)
   OR (:OLD.TipCtr <> :NEW.TipCtr)
   OR (:OLD.IncCtr <> :NEW.IncCtr)
   OR (:OLD.JusCtr <> :NEW.JusCtr)
   OR (:OLD.CPFSbs <> :NEW.CPFSbs)
   OR (:OLD.MatSbs <> :NEW.MatSbs)
   OR (:OLD.SitGer <> :NEW.SitGer)
   OR (:OLD.DatFim <> :NEW.DatFim)
   OR (:OLD.EndDif <> :NEW.EndDif)
   OR (:OLD.CodPai <> :NEW.CodPai)
   OR (:OLD.CodEst <> :NEW.CodEst)
   OR (:OLD.CodCid <> :NEW.CodCid)
   OR (:OLD.CodBai <> :NEW.CodBai)
   OR (:OLD.EndCep <> :NEW.EndCep)
   OR (:OLD.EndRua <> :NEW.EndRua)
   OR (:OLD.EndNum <> :NEW.EndNum)
   OR (:OLD.EndCpl <> :NEW.EndCpl)
   OR (:OLD.CodOem <> :NEW.CodOem)
   OR (:OLD.TipIns <> :NEW.TipIns)
   OR (:OLD.NumIns <> :NEW.NumIns)
   OR (:OLD.TipLgr <> :NEW.TipLgr)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034CTR_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034CTR_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDMOTCTR', CONVERT(NUMBER_TO_CHAR, :OLD.MOTCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWMOTCTR', CONVERT(NUMBER_TO_CHAR, :NEW.MOTCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPCTR', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPCTR', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINCCTR', CONVERT(NUMBER_TO_CHAR, :OLD.INCCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINCCTR', CONVERT(NUMBER_TO_CHAR, :NEW.INCCTR));
        IF (:OLD.JusCtr <> :NEW.JusCtr) THEN
        	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDJUSCTR', 'alterado (excede limite de exibição)');
        	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWJUSCTR', 'alterado (excede limite de exibição)');
        ELSE
        	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDJUSCTR', 'não houve alteração (excede limite de exibição)');
        	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWJUSCTR', 'não houve alteração (excede limite de exibição)');
        END IF;
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCPFSBS', CONVERT(NUMBER_TO_CHAR, :OLD.CPFSBS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCPFSBS', CONVERT(NUMBER_TO_CHAR, :NEW.CPFSBS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDMATSBS', :OLD.MATSBS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWMATSBS', :NEW.MATSBS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSITGER', CONVERT(NUMBER_TO_CHAR, :OLD.SITGER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSITGER', CONVERT(NUMBER_TO_CHAR, :NEW.SITGER));
        SP_DATSTR(:OLD.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATFIM', l_datTemp);
        SP_DATSTR(:NEW.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATFIM', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENDDIF', :OLD.ENDDIF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENDDIF', :NEW.ENDDIF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPAI', CONVERT(NUMBER_TO_CHAR, :OLD.CODPAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPAI', CONVERT(NUMBER_TO_CHAR, :NEW.CODPAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODEST', :OLD.CODEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODEST', :NEW.CODEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCID', CONVERT(NUMBER_TO_CHAR, :OLD.CODCID));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCID', CONVERT(NUMBER_TO_CHAR, :NEW.CODCID));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODBAI', CONVERT(NUMBER_TO_CHAR, :OLD.CODBAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODBAI', CONVERT(NUMBER_TO_CHAR, :NEW.CODBAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENDCEP', CONVERT(NUMBER_TO_CHAR, :OLD.ENDCEP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENDCEP', CONVERT(NUMBER_TO_CHAR, :NEW.ENDCEP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENDRUA', :OLD.ENDRUA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENDRUA', :NEW.ENDRUA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENDNUM', :OLD.ENDNUM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENDNUM', :NEW.ENDNUM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDENDCPL', :OLD.ENDCPL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWENDCPL', :NEW.ENDCPL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODOEM', CONVERT(NUMBER_TO_CHAR, :OLD.CODOEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODOEM', CONVERT(NUMBER_TO_CHAR, :NEW.CODOEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPINS', CONVERT(NUMBER_TO_CHAR, :OLD.TIPINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPINS', CONVERT(NUMBER_TO_CHAR, :NEW.TIPINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMINS', CONVERT(NUMBER_TO_CHAR, :OLD.NUMINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMINS', CONVERT(NUMBER_TO_CHAR, :NEW.NUMINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPLGR', :OLD.TIPLGR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPLGR', :NEW.TIPLGR);
      END;
    END IF; 
  END IF;
END␀<Ó␀␀		SENIOR;0Y␀␀

TRIGGER R034CTR_ED AFTER DELETE ON R034CTR FOR EACH ROW

DECLARE
  l_layoutAltContratual VARCHAR2(6);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN
  /* eSocial */ 
	RH_LAY_CONTR_COLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layoutAltContratual OUT);
	IF ((l_layoutAltContratual IS NOT NULL) AND LENGTH(LTRIM(RTRIM(l_layoutAltContratual))) > 0)  THEN
	   SP_HIST_ESOCIAL(l_layoutAltContratual, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATINI, 'R034CTR', 'DATINI', 'E', '', '', 0, 'R034CTR_ED');  
	END IF;
  /* eSocial */  
  
  /* Geração de logs Contrato Temporário (Tabela: R034CTR)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 110;     /* Contrato Temporário (Tabela: R034CTR)*/
  l_codtpa := 331;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034CTR_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034CTR_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MOTCTR', CONVERT(NUMBER_TO_CHAR, :OLD.MOTCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCTR', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INCCTR', CONVERT(NUMBER_TO_CHAR, :OLD.INCCTR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'JUSCTR', 'registro excluído (excede limite de exibição)');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CPFSBS', CONVERT(NUMBER_TO_CHAR, :OLD.CPFSBS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MATSBS', :OLD.MATSBS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITGER', CONVERT(NUMBER_TO_CHAR, :OLD.SITGER));
        SP_DATSTR(:OLD.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATFIM', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDDIF', :OLD.ENDDIF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPAI', CONVERT(NUMBER_TO_CHAR, :OLD.CODPAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEST', :OLD.CODEST);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCID', CONVERT(NUMBER_TO_CHAR, :OLD.CODCID));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODBAI', CONVERT(NUMBER_TO_CHAR, :OLD.CODBAI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDCEP', CONVERT(NUMBER_TO_CHAR, :OLD.ENDCEP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDRUA', :OLD.ENDRUA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDNUM', :OLD.ENDNUM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ENDCPL', :OLD.ENDCPL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODOEM', CONVERT(NUMBER_TO_CHAR, :OLD.CODOEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPINS', CONVERT(NUMBER_TO_CHAR, :OLD.TIPINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMINS', CONVERT(NUMBER_TO_CHAR, :OLD.NUMINS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPLGR', :OLD.TIPLGR);
      END;
  END IF; 
END␀␀␀Â5␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀?Ó␀␀…¬␀␀´␀	„␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	„␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	„␀␀␀␀␀œ$€$€$w␀Æÿ␀␀…Ó␀␀␀¦%␀=␀␀␀␀␀␀ä%␀{%␀Ï%␀c␀␀␀ÿ␀␀ÿ␀C-·␀␀␀␀␀␀␀À¿␀␀£¿␀␀£¿␀␀t␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀␀␀␀␀␀␀Â¿␀␀¨¿␀␀©¿␀␀t␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀␀␀␀␀␀␀Ã¿␀␀±¿␀␀²¿␀␀t␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀␀␀␀␀␀␀Á¿␀␀¥¿␀␀¦¿␀␀t␀Æÿ␀␀ı×␀␀␀Æ␀␀·␀␀␀␀␀␀␀¾¿␀␀µ¿␀␀É¿␀␀t␀Æÿ␀␀ı×␀␀␀~1(␀␀␀␀␀␀g6lf6n␀Æÿ␀␀ÿ␀D1=␀␀␀␀␀␀{6 ¯␀␀{6c␀␀␀ÿ␀␀ÿ␀f1␀␀␀␀␀␀\6V6X6n␀Æÿ␀␀ÿ␀—1=␀␀␀␀␀␀t6q6s6c␀␀␀ÿ␀␀ÿ␀¿	␀±␀␀␀␀␀␀␀6
