            INSERT INTO r995prt
       (codrpa,namppa,conppa)
      VALUES
      (@l_codrpa,'DATINI',@l_datiniSTR)
            SELECT @ChkError = @@Error
            IF @ChkError <> 0
            BEGIN
              GOTO EXC5
            END
            INSERT INTO r995prt
       (codrpa,namppa,conppa)
      VALUES
      (@l_codrpa,'HORINI',@l_horiniSTR)
            SELECT @ChkError = @@Error
