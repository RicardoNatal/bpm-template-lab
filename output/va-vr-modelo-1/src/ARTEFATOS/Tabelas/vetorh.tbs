	/* EXCLUO TAMBEM AS ACOES DA FAIXA - POR DISPOSITIVO E POR LOCAL FISICO, DE TODOS OS COLABORADORES, VINCULADOS A ESTE POSTO DE TRABALHO */
	BEGIN
		DELETE FROM R034AFD WHERE ESTPOS = :OLD.ESTPOS AND POSTRA = :OLD.POSTRA AND CODDSP = :OLD.CODDSP;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'R017PRM_ED: Erro ao excluir as acoes da faixa/dispositivo dos colaboradores, com origem no posto de trabalho.';
	END;
	BEGIN
		DELETE FROM R034AFL WHERE ESTPOS = :OLD.ESTPOS AND POSTRA = :OLD.POSTRA AND VERPLF = :OLD.VERPLF AND CODPLF = :OLD.CODPLF;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'R017PRM_ED: Erro ao excluir as acoes da faixa/local fisico dos colaboradores, com origem no posto de trabalho.';
