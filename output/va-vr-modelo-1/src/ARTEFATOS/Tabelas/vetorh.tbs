È␀␀CREATE  PROCEDURE SP_R034FUN_HIST(@p_tipalt VARCHAR(1), @p_numemp SMALLINT, @p_tipcol SMALLINT, @p_numcad INTEGER, @p_nomfun VARCHAR(40), @p_apefun VARCHAR(50), @p_tipsex VARCHAR(1), @p_raccor SMALLINT, @p_estciv SMALLINT, @p_grains SMALLINT, @p_datnas DATETIME, @p_codnac SMALLINT, @p_numctp INTEGER, @p_serctp VARCHAR(5), @p_digcar VARCHAR(2), @p_estctp VARCHAR(2), @p_dexctp DATETIME, @p_numcpf BIGINT, @p_numpis BIGINT, @p_dcdpis DATETIME, @p_movsef VARCHAR(2), @p_irrise VARCHAR(1), @p_apoida VARCHAR(1), @p_emtcar VARCHAR(1), @p_numins BIGINT, @p_coddef SMALLINT, @p_deffis VARCHAR(1), @p_benrea VARCHAR(1), @p_nmfun1 VARCHAR(25), @p_nmfun2 VARCHAR(25), @p_nmfun3 VARCHAR(25), @p_nmfun4 VARCHAR(25), @p_codpro INTEGER, @p_anoche SMALLINT, @p_visest SMALLINT, @p_dvlest DATETIME, @p_regest VARCHAR(14), @p_dvlctp DATETIME, @p_docest SMALLINT, @p_datche DATETIME, @p_numpsp VARCHAR(20), @p_datadm DATETIME, @p_tipadm SMALLINT, @p_tipcon SMALLINT, @p_tipopc VARCHAR(1), @p_datopc DATETIME, @p_confgt BIGINT, @p_modpag VARCHAR(1), @p_codban SMALLINT, @p_codage INTEGER, @p_conban BIGINT, @p_digban VARCHAR(3), @p_perpag VARCHAR(1), @p_recadi VARCHAR(1), @p_rec13s VARCHAR(1), @p_lisrai VARCHAR(1), @p_emicar VARCHAR(1), @p_codcha VARCHAR(6), @p_numcra BIGINT, @p_outcon VARCHAR(1), @p_outtet VARCHAR(1), @p_outemp SMALLINT, @p_outtip SMALLINT, @p_outcad INTEGER, @p_perdes FLOAT, @p_periss FLOAT, @p_faiins SMALLINT, @p_opcatu VARCHAR(1), @p_dctins SMALLINT, @p_cadfol VARCHAR(15), @p_catter VARCHAR(1), @p_fattpo FLOAT, @p_empres SMALLINT, @p_tipres SMALLINT, @p_cadres INTEGER, @p_tipter SMALLINT, @p_cauadv VARCHAR(30), @p_inscur SMALLINT, @p_assppr SMALLINT, @p_datppr DATETIME, @p_verint VARCHAR(1), @p_contov VARCHAR(1), @p_apupfs VARCHAR(1), @p_tippfs VARCHAR(1), @p_ratpfs VARCHAR(1), @p_gpstri DATETIME, @p_dedcar VARCHAR(1), @p_codfor INTEGER, @p_rateve VARCHAR(1), @p_pertra FLOAT, @p_perirt FLOAT, @p_dedins FLOAT, @p_tipsrv SMALLINT, @p_bushor SMALLINT, @p_recgra VARCHAR(1), @p_codidn BIGINT, @p_tpctba SMALLINT, @p_codlim SMALLINT, @p_rettrp VARCHAR(1), @p_seqhis bigint output) AS
BEGIN
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @SE_EXC2 INTEGER
  SELECT @ChkError = 0
    IF (@p_tipalt<>'E')
    BEGIN
	/* TRY */
	  INSERT INTO r038hfb
		(numemp,tipcol,numcad,dathis,tipalt,nomfun,apefun,tipsex,raccor,estciv,grains,datnas,codnac,numctp,serctp,digcar,estctp,dexctp,numcpf,numpis,dcdpis,movsef,irrise,apoida,emtcar,numins,coddef,deffis,benrea,nmfun1,nmfun2,nmfun3,nmfun4,codpro,anoche,visest,dvlest,regest,dvlctp,docest,datche,numpsp,datadm,tipadm,tipcon,tipopc,datopc,confgt,modpag,codban,codage,conban,digban,perpag,recadi,rec13s,lisrai,emicar,codcha,numcra,outcon,outtet,outemp,outtip,outcad,perdes,periss,faiins,opcatu,dctins,cadfol,catter,fattpo,empres,tipres,cadres,tipter,cauadv,inscur,assppr,datppr,verint,contov,apupfs,tippfs,ratpfs,gpstri,dedcar,codfor,rateve,pertra,perirt,dedins,tipsrv,bushor,recgra,codidn,tpctba,codlim,rettrp) 
	  VALUES 
		(@p_numemp,@p_tipcol,@p_numcad,GETDATE(),@p_tipalt,@p_nomfun,@p_apefun,@p_tipsex,@p_raccor,@p_estciv,@p_grains,@p_datnas,@p_codnac,@p_numctp,@p_serctp,@p_digcar,@p_estctp,@p_dexctp,@p_numcpf,@p_numpis,@p_dcdpis,@p_movsef,@p_irrise,@p_apoida,@p_emtcar,@p_numins,@p_coddef,@p_deffis,@p_benrea,@p_nmfun1,@p_nmfun2,@p_nmfun3,@p_nmfun4,@p_codpro,@p_anoche,@p_visest,@p_dvlest,@p_regest,@p_dvlctp,@p_docest,@p_datche,@p_numpsp,@p_datadm,@p_tipadm,@p_tipcon,@p_tipopc,@p_datopc,@p_confgt,@p_modpag,@p_codban,@p_codage,@p_conban,@p_digban,@p_perpag,@p_recadi,@p_rec13s,@p_lisrai,@p_emicar,@p_codcha,@p_numcra,@p_outcon,@p_outtet,@p_outemp,@p_outtip,@p_outcad,@p_perdes,@p_periss,@p_faiins,@p_opcatu,@p_dctins,@p_cadfol,@p_catter,@p_fattpo,@p_empres,@p_tipres,@p_cadres,@p_tipter,@p_cauadv,@p_inscur,@p_assppr,@p_datppr,@p_verint,@p_contov,@p_apupfs,@p_tippfs,@p_ratpfs,@p_gpstri,@p_dedcar,@p_codfor,@p_rateve,@p_pertra,@p_perirt,@p_dedins,@p_tipsrv,@p_bushor,@p_recgra,@p_codidn,@p_tpctba,@p_codlim,@p_rettrp)
		SELECT @p_seqhis = cast(SCOPE_IDENTITY() as bigint)
	  SELECT @ChkError = @@Error
	  IF @ChkError <> 0
	  BEGIN
		GOTO EXC1
	  END
	/* END TRY */
	/* BEGIN EXCEPTION HANDLER */
	  EXC1:
	  SELECT @SE_EXC1 = @ChkError
	  IF @ChkError <> 0
	  BEGIN
		BEGIN
		  SELECT @ChkError = 0
		  BEGIN
			RAISERROR('Erro ao registrar histórico de alteração da ficha básica.',11,1) WITH SETERROR
			SELECT @ChkError = -30
			GOTO FIM
		  END
		END
	  END
	/* END EXCEPTION HANDLER */
    END
    ELSE
    BEGIN
      /* TRY */
      DELETE FROM r038hfc
      WHERE numemp=@p_numemp 
      and tipcol=@p_tipcol 
      and numcad=@p_numcad
          SELECT @ChkError = @@Error
          IF @ChkError <> 0
          BEGIN
            GOTO EXC2
          END
		  
      DELETE FROM r038hfb
      WHERE numemp=@p_numemp 
      and tipcol=@p_tipcol 
      and numcad=@p_numcad
          SELECT @ChkError = @@Error
          IF @ChkError <> 0
          BEGIN
            GOTO EXC2
          END
       /* END TRY */
 	   /* BEGIN EXCEPTION HANDLER */
          EXC2:
          SELECT @SE_EXC2 = @ChkError
          IF @ChkError <> 0
          BEGIN
            BEGIN
              SELECT @ChkError = 0
              BEGIN
                RAISERROR('Erro ao excluir históricos da ficha básica e  ficha complementar.',11,1) WITH SETERROR
                SELECT @ChkError = -30
                GOTO FIM
              END
            END
          END
        /* END EXCEPTION HANDLER */
    END
FIM:
  RETURN @ChkError
END	POSTGRESQL;0
¼␀␀create or replace PROCEDURE SP_R034FUN_HIST(p_tipalt VARCHAR(255), p_numemp SMALLINT, p_tipcol SMALLINT, p_numcad INTEGER, p_nomfun VARCHAR, p_apefun VARCHAR, p_tipsex VARCHAR, p_raccor SMALLINT, p_estciv SMALLINT, p_grains SMALLINT, p_datnas timestamp without time zone, p_codnac SMALLINT, p_numctp INTEGER, p_serctp VARCHAR, p_digcar VARCHAR, p_estctp VARCHAR, p_dexctp timestamp without time zone, p_numcpf BIGINT, p_numpis BIGINT, p_dcdpis timestamp without time zone, p_movsef VARCHAR, p_irrise VARCHAR, p_apoida VARCHAR, p_emtcar VARCHAR, p_numins BIGINT, p_coddef SMALLINT, p_deffis VARCHAR, p_benrea VARCHAR, p_nmfun1 VARCHAR, p_nmfun2 VARCHAR, p_nmfun3 VARCHAR, p_nmfun4 VARCHAR, p_codpro INTEGER, p_anoche SMALLINT, p_visest SMALLINT, p_dvlest timestamp without time zone, p_regest VARCHAR, p_dvlctp timestamp without time zone, p_docest SMALLINT, p_datche timestamp without time zone, p_numpsp VARCHAR, p_datadm timestamp without time zone, p_tipadm SMALLINT, p_tipcon SMALLINT, p_tipopc VARCHAR, p_datopc timestamp without time zone, p_confgt BIGINT, p_modpag VARCHAR, p_codban SMALLINT, p_codage INTEGER, p_conban BIGINT, p_digban VARCHAR, p_perpag VARCHAR, p_recadi VARCHAR, p_rec13s VARCHAR, p_lisrai VARCHAR, p_emicar VARCHAR, p_codcha VARCHAR, p_numcra BIGINT, p_outcon VARCHAR, p_outtet VARCHAR, p_outemp SMALLINT, p_outtip SMALLINT, p_outcad INTEGER, p_perdes numeric(5,2), p_periss numeric(5,2), p_faiins SMALLINT, p_opcatu VARCHAR, p_dctins SMALLINT, p_cadfol VARCHAR, p_catter VARCHAR, p_fattpo numeric(5,2), p_empres SMALLINT, p_tipres SMALLINT, p_cadres INTEGER, p_tipter SMALLINT, p_cauadv VARCHAR, p_inscur SMALLINT, p_assppr SMALLINT, p_datppr timestamp without time zone, p_verint VARCHAR, p_contov VARCHAR, p_apupfs VARCHAR, p_tippfs VARCHAR, p_ratpfs VARCHAR, p_gpstri timestamp without time zone, p_dedcar VARCHAR, p_codfor INTEGER, p_rateve VARCHAR, p_pertra numeric(5,2), p_perirt numeric(5,2), p_dedins numeric(5,2), p_tipsrv SMALLINT, p_bushor SMALLINT, p_recgra VARCHAR, p_codidn BIGINT, p_tpctba SMALLINT, p_codlim SMALLINT, p_rettrp VARCHAR, p_seqhis in out bigint)
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN
  begin
	INSERT INTO r038hfb 
		(numemp,tipcol,numcad,dathis,tipalt,nomfun,apefun,tipsex,raccor,estciv,grains,datnas,codnac,numctp,serctp,digcar,estctp,dexctp,numcpf,numpis,dcdpis,movsef,irrise,apoida,emtcar,numins,coddef,deffis,benrea,nmfun1,nmfun2,nmfun3,nmfun4,codpro,anoche,visest,dvlest,regest,dvlctp,docest,datche,numpsp,datadm,tipadm,tipcon,tipopc,datopc,confgt,modpag,codban,codage,conban,digban,perpag,recadi,rec13s,lisrai,emicar,codcha,numcra,outcon,outtet,outemp,outtip,outcad,perdes,periss,faiins,opcatu,dctins,cadfol,catter,fattpo,empres,tipres,cadres,tipter,cauadv,inscur,assppr,datppr,verint,contov,apupfs,tippfs,ratpfs,gpstri,dedcar,codfor,rateve,pertra,perirt,dedins,tipsrv,bushor,recgra,codidn,tpctba,codlim,rettrp)
			VALUES (p_numemp,p_tipcol,p_numcad,TIMEOFDAY()::timestamp without time zone,p_tipalt,p_nomfun,p_apefun,p_tipsex,p_raccor,p_estciv,p_grains,p_datnas,p_codnac,p_numctp,p_serctp,p_digcar,p_estctp,p_dexctp,p_numcpf,p_numpis,p_dcdpis,p_movsef,p_irrise,p_apoida,p_emtcar,p_numins,p_coddef,p_deffis,p_benrea,p_nmfun1,p_nmfun2,p_nmfun3,p_nmfun4,p_codpro,p_anoche,p_visest,p_dvlest,p_regest,p_dvlctp,p_docest,p_datche,p_numpsp,p_datadm,p_tipadm,p_tipcon,p_tipopc,p_datopc,p_confgt,p_modpag,p_codban,p_codage,p_conban,p_digban,p_perpag,p_recadi,p_rec13s,p_lisrai,p_emicar,p_codcha,p_numcra,p_outcon,p_outtet,p_outemp,p_outtip,p_outcad,p_perdes,p_periss,p_faiins,p_opcatu,p_dctins,p_cadfol,p_catter,p_fattpo,p_empres,p_tipres,p_cadres,p_tipter,p_cauadv,p_inscur,p_assppr,p_datppr,p_verint,p_contov,p_apupfs,p_tippfs,p_ratpfs,p_gpstri,p_dedcar,p_codfor,p_rateve,p_pertra,p_perirt,p_dedins,p_tipsrv,p_bushor,p_recgra,p_codidn,p_tpctba,p_codlim,p_rettrp)
			returning seqhis into p_seqhis;
  exception
	when OTHERS then
	  RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'Erro ao registrar histórico de alteração da ficha básica.';
  end;
end;
