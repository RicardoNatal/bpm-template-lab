Û␀␀PROCEDURE SP_RETFON(P_IDTPES CHAR(23),P_NOMPES OUT VARCHAR2(40),P_DDIFON OUT NUMBER(3),P_DDDFON OUT NUMBER(3),P_NUMFON OUT VARCHAR2(20))
 IS

l_numemp      NUMBER(4);
    l_tipcol      NUMBER(1);
    l_numcad      NUMBER(9);
    l_tipdoc      NUMBER(1);
    l_numdoc      VARCHAR2(20);
    l_nummat      VARCHAR2(15);
    l_propac      VARCHAR2(20);
    l_tippes      NUMBER(2);

    l_NomPes      VARCHAR2(40);
    l_DDIFon      NUMBER(3);
    l_DDDFon      NUMBER(3);
    l_numFon      VARCHAR2(20);
BEGIN
    /* Inicializa */
    l_NomPes := '';
    l_DDIFon := 0;
    l_DDDFon := 0;
    l_numFon := '';

    /* retornar a pessoa */
    SP_PESFROMIDTPES(p_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT,
                               l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);

    /* Se colaborador */
    IF  (l_tippes < 4) THEN
        BEGIN
            SELECT A.NOMFUN, B.DDITEL, B.DDDTEL, B.NUMTEL INTO l_NomPes, l_DDIFon, l_DDDFon, l_numFon
             FROM R034FUN A, R034CPL B WHERE
             B.NUMEMP (+)= A.NUMEMP AND B.TIPCOL (+)= A.TIPCOL AND B.NUMCAD (+)= A.NUMCAD AND
             A.NUMEMP = l_numemp AND A.TIPCOL = l_tipcol AND A.NUMCAD = l_numcad;
        EXCEPTION
            WHEN OTHERS THEN l_NomPes := '';
                             l_DDIFon := 0;
                             l_DDDFon := 0;
                             l_numFon := '';
        END;
    END IF;

    /*Visitante*/
    IF (l_tippes = 4) THEN
        BEGIN
            SELECT NOMVIS, DDITEL, DDDTEL, TELCON INTO l_NomPes, l_DDIFon, l_DDDFon, l_numFon
             FROM R090VIS WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
        EXCEPTION
            WHEN OTHERS THEN l_NomPes := '';
                             l_DDIFon := 0;
                             l_DDDFon := 0;
                             l_numFon := '';
        END;
    END IF;

    /*Outras unidades*/
    IF (l_tippes = 5) THEN
        l_DDIFon := 0;
        l_DDDFon := 0;
        l_numFon := '';

        BEGIN
            SELECT NOMCRA INTO l_NomPes
             FROM R070OCR WHERE NUMEMP = l_numemp AND NUMCAD = l_numcad;
        EXCEPTION
            WHEN OTHERS THEN l_NomPes := '';
                             l_DDIFon := 0;
                             l_DDDFon := 0;
                             l_numFon := '';
        END;
    END IF;

    /* Se responsável de aluno */
    IF  (l_tippes = 7) THEN
        BEGIN
            SELECT NOMRES, DDITEL, DDDTEL, FONRES INTO l_NomPes, l_DDIFon, l_DDDFon, l_numFon
             FROM R073RES WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
        EXCEPTION
            WHEN OTHERS THEN l_NomPes := '';
                             l_DDIFon := 0;
                             l_DDDFon := 0;
                             l_numFon := '';
        END;
    END IF;

    /* Paciente */
    IF (l_tippes = 9) THEN
        l_DDIFon := 0;
        l_DDDFon := 0;
        l_numFon := '';

        BEGIN
            SELECT NOMPAC INTO l_NomPes
             FROM R097PAC WHERE PROPAC = l_propac;
        EXCEPTION
            WHEN OTHERS THEN l_NomPes := '';
                             l_DDIFon := 0;
                             l_DDDFon := 0;
                             l_numFon := '';
        END;
    END IF;

    /* Se Aluno */
    IF  (l_tippes = 10) THEN
        BEGIN
            SELECT NOMALU, DDITEL, DDDTEL, NUMTEL INTO l_NomPes, l_DDIFon, l_DDDFon, l_numFon
             FROM R073ALU WHERE NUMMAT = l_nummat;
        EXCEPTION
            WHEN OTHERS THEN l_NomPes := '';
                             l_DDIFon := 0;
                             l_DDDFon := 0;
                             l_numFon := '';
        END;
    END IF;

    /* Se  Visitantes Autorizados */
    IF  (l_tippes = 11) THEN
        BEGIN
            SELECT NOMVIS, DDITEL, DDDTEL, TELCON INTO l_NomPes, l_DDIFon, l_DDDFon, l_numFon
              FROM R090VIS WHERE TIPDOC = l_tipdoc AND NUMDOC = l_numdoc;
        EXCEPTION
            WHEN OTHERS THEN l_NomPes := '';
                             l_DDIFon := 0;
                             l_DDDFon := 0;
                             l_numFon := '';
        END;
    END IF;

	/* Se Candidato */
    IF  (l_tippes = 13) THEN
        BEGIN
            SELECT NOMCAN, DDICO1, DDDCO1, TELCO1   INTO l_NomPes, l_DDIFon, l_DDDFon, l_numFon
			  FROM R122CEX WHERE NUMCAN = l_numcad;
        EXCEPTION
            WHEN OTHERS THEN l_NomPes := '';
                             l_DDIFon := 0;
                             l_DDDFon := 0;
                             l_numFon := '';
        END;
    END IF;

    p_NomPes := l_NomPes;
    p_DDIFon := l_DDIFon;
    p_DDDFon := l_DDDFon;
    p_numFon := l_numFon;
END␀¿ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
e␀␀PROCEDURE SP_RETGRACONUSABIO(p_NumEmp IN NUMBER(4),p_TipPes IN NUMBER(2),p_NumCad IN NUMBER(10),p_TipDoc IN NUMBER(1),p_NumDoc IN VARCHAR2(20),p_NumMat IN VARCHAR2(15),p_UsaBio OUT NUMBER(1),p_GraCon OUT NUMBER(3))
IS

  l_TipVisVis NUMBER(3);
  l_DatEntVis DATE;
  l_HorEntVis NUMBER(4);
  l_SeqEntVis NUMBER(2);
  l_TipVisAco NUMBER(3);  
  l_DatEntAco DATE;
  l_HorEntAco NUMBER(4);
  l_SeqEntAco NUMBER(2);
  l_TipVisPac NUMBER(3);  
  l_DatEntPac DATE;
  l_HorEntPac NUMBER(4);
  l_SeqEntPac NUMBER(2);
  l_errvis    BOOLEAN;
BEGIN 
  BEGIN
    IF (p_TipPes IN (1,2,3)) THEN
      SELECT GRACON, USABIO INTO p_GraCon, p_UsaBio FROM R034DAC WHERE NUMEMP = p_NumEmp AND TIPCOL = p_TipPes AND NUMCAD = p_NumCad;
    END IF;

    IF (p_TipPes = 4) THEN
        l_errvis := TRUE;
    	l_TipVisVis := 0;
    	l_DatEntVis := '31/12/1900,00:00:00';
    	l_HorEntVis := 0;
    	l_SeqEntVis := 0;
    	l_TipVisAco := 0;
    	l_DatEntAco := '31/12/1900,00:00:00';
    	l_HorEntAco := 0;
    	l_SeqEntAco := 0;
    	l_TipVisPac := 0;
    	l_DatEntPac := '31/12/1900,00:00:00';
    	l_HorEntPac := 0;
    	l_SeqEntPac := 0;    	
    	
        BEGIN
	        SELECT A.TIPVIS, A.DATENT, A.HORENT, A.SEQENT INTO l_TipVisVis, l_DatEntVis, l_HorEntVis, l_SeqEntVis FROM R090MVI A 
		      WHERE A.TIPDOC = p_TipDoc AND A.NUMDOC = p_NumDoc AND A.DATENT = (
		      SELECT MAX(R090MVI.DATENT) FROM R090MVI WHERE R090MVI.TIPDOC = A.TIPDOC AND R090MVI.NUMDOC = A.NUMDOC) AND A.HORENT = (
		      SELECT MAX(R090MVI.HORENT) FROM R090MVI WHERE R090MVI.TIPDOC = A.TIPDOC AND R090MVI.NUMDOC = A.NUMDOC AND R090MVI.DATENT = A.DATENT) AND A.SEQENT = (
		      SELECT MAX(R090MVI.SEQENT) FROM R090MVI WHERE R090MVI.TIPDOC = A.TIPDOC AND R090MVI.NUMDOC = A.NUMDOC AND R090MVI.DATENT = A.DATENT AND R090MVI.HORENT = A.HORENT);
	    EXCEPTION
	        WHEN NO_DATA_FOUND THEN
	          NULL;
	    END;  
	    
	    BEGIN
		    SELECT B.TIPVIS, A.DATENT, A.HORENT, A.SEQENT INTO l_TipVisAco, l_DatEntAco, l_HorEntAco, l_SeqEntAco FROM R090ACO A, R090MVI B 
		      WHERE A.TIPDOC = p_TipDoc AND A.NUMDOC = p_NumDoc AND A.DATENT = B.DATENT AND A.HORENT = B.HORENT AND A.SEQENT = B.SEQENT AND A.DATENT = (
		      SELECT MAX(R090ACO.DATENT) FROM R090ACO WHERE R090ACO.TIPDOC = A.TIPDOC AND R090ACO.NUMDOC = A.NUMDOC) AND A.HORENT = (
		      SELECT MAX(R090ACO.HORENT) FROM R090ACO WHERE R090ACO.TIPDOC = A.TIPDOC AND R090ACO.NUMDOC = A.NUMDOC AND R090ACO.DATENT = A.DATENT) AND A.SEQENT = (
		      SELECT MAX(R090ACO.SEQENT) FROM R090ACO WHERE R090ACO.TIPDOC = A.TIPDOC AND R090ACO.NUMDOC = A.NUMDOC AND R090ACO.DATENT = A.DATENT AND R090ACO.HORENT = A.HORENT);
	    EXCEPTION
	        WHEN NO_DATA_FOUND THEN
	          NULL;
	    END;  
  	  
  	   /*Visitante de paciente*/
       BEGIN
	       SELECT A.TIPVIS, A.DATENT, A.HORENT, A.SEQENT INTO l_TipVisPac, l_DatEntPac, l_HorEntPac, l_SeqEntPac FROM R097MOV A, R097VMV B
		      WHERE B.TIPDOC = p_TipDoc AND B.NUMDOC = p_NumDoc AND A.DATENT = B.DATENT AND A.HORENT = B.HORENT AND A.SEQENT = B.SEQENT AND 
		      A.DATENT = (SELECT MAX(R097VMV.DATENT) FROM R097VMV WHERE R097VMV.TIPDOC = B.TIPDOC AND R097VMV.NUMDOC = B.NUMDOC) AND 
		      A.HORENT = (SELECT MAX(R097VMV.HORENT) FROM R097VMV WHERE R097VMV.TIPDOC = B.TIPDOC AND R097VMV.NUMDOC = B.NUMDOC AND R097VMV.DATENT = A.DATENT) AND 
		      A.SEQENT = (SELECT MAX(R097VMV.SEQENT) FROM R097VMV WHERE R097VMV.TIPDOC = B.TIPDOC AND R097VMV.NUMDOC = B.NUMDOC AND R097VMV.DATENT = A.DATENT AND R097VMV.HORENT = A.HORENT);
	   EXCEPTION
	        WHEN NO_DATA_FOUND THEN
	          NULL;
	   END; 
	      
	   IF (l_TipVisPac > 0 AND ((l_DatEntPac > l_DatEntVis OR (l_DatEntPac = l_DatEntVis AND l_HorEntPac > l_HorEntVis))) AND 
	   	                       ((l_DatEntPac > l_DatEntAco OR (l_DatEntPac = l_DatEntAco AND l_HorEntPac > l_HorEntAco)))) THEN
	   	   l_errvis := FALSE;
	       SELECT GRACON, USABIO INTO p_GraCon, p_UsaBio FROM R090TVI WHERE TIPVIS = l_TipVisPac;
	   ELSE  
	       /*verifica se a ultima entrada foi como acompanhante ou visitante, e retorna o credito de acesso do tipo de visita da movimentação*/
		   IF (l_DatEntAco > l_DatEntVis OR (l_DatEntAco = l_DatEntVis AND l_HorEntAco > l_HorEntVis) OR (l_DatEntAco = l_DatEntVis AND l_HorEntAco = l_HorEntVis AND l_SeqEntAco > l_SeqEntVis)) THEN
	  	       l_errvis := FALSE;
	  	       SELECT GRACON, USABIO INTO p_GraCon, p_UsaBio FROM R090TVI WHERE TIPVIS = l_TipVisAco;
		   ELSE
		   	   l_errvis := FALSE;
	  	       SELECT GRACON, USABIO INTO p_GraCon, p_UsaBio FROM R090TVI WHERE TIPVIS = l_TipVisVis;
		   END IF;
	    END IF;
	    
	    IF (l_errvis = TRUE) THEN
	     	RAISERROR 103 'SP_RETGRACONUSABIO: Não foi possível buscar as informações relacionadas a biometria do visitante.';
	    END IF;
    END IF;

    IF (p_TipPes = 14) THEN
      SELECT GRACON, USABIO INTO p_GraCon, p_UsaBio FROM R073ALU WHERE NUMMAT = p_NumMat;
    END IF;

    IF (p_TipPes = 15) THEN
      SELECT GRACON, USABIO INTO p_GraCon, p_UsaBio FROM R073RES WHERE TIPDOC = p_TipDoc AND NUMDOC = p_NumDoc;
    END IF;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'SP_RETGRACONUSABIO: Não foi possível buscar as informações relacionadas a biometria da pessoa.';
  END;
END␀Àø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
