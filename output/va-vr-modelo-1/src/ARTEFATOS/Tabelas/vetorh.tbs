		  WHEN OTHERS THEN RAISERROR 103 'R030EFE_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	  END; 
	  
	  BEGIN	  
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDESLEI', :OLD.DESLEI);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDESLEI', :NEW.DESLEI);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERSEG', CONVERT(NUMBER_TO_CHAR, :OLD.PERSEG));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERSEG', CONVERT(NUMBER_TO_CHAR, :NEW.PERSEG));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERNOR', CONVERT(NUMBER_TO_CHAR, :OLD.PERNOR));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERNOR', CONVERT(NUMBER_TO_CHAR, :NEW.PERNOR));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERSUP', CONVERT(NUMBER_TO_CHAR, :OLD.PERSUP));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERSUP', CONVERT(NUMBER_TO_CHAR, :NEW.PERSUP));	  	  
	  END;
    END IF;
  END IF;  
END␀Ò␀␀		SENIOR;0|␀␀

TRIGGER R030EFE_ED AFTER DELETE ON R030EFE FOR EACH ROW

DECLARE
	l_temAud       BOOLEAN;
	l_codRPA       NUMBER(15);
	l_codSistema   NUMBER(2);
	l_codcpa       NUMBER(4);
	l_codtpa       NUMBER(4);
	l_datTemp      VARCHAR(10);
BEGIN
  /* Geração de logs Filial - Cadastro*/
  l_codSistema := 1;  /* Código do sistema vetorh.*/
  l_codcpa := 33;     /* R030EFE - CADASTRO FILIAIS - ÓRGÃO PÚBLICO - ENTE FEDERATIVO */
  l_codtpa := 176;    /* Incluir/Excluir   */
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);  
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R030EFE_ED', 'FR030FIL'); 
     
     /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
	  SP_DATSTR(:OLD.DATALT, 'MM/YYYY', l_datTemp OUT);
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPPUB', CONVERT(NUMBER_TO_CHAR, :OLD.TIPPUB));	
	EXCEPTION
	    WHEN OTHERS THEN RAISERROR 103 'R030EFE_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	END;
	 
	BEGIN	
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESLEI', :OLD.DESLEI);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERSEG', CONVERT(NUMBER_TO_CHAR, :OLD.PERSEG));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERNOR', CONVERT(NUMBER_TO_CHAR, :OLD.PERNOR));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERSUP', CONVERT(NUMBER_TO_CHAR, :OLD.PERSUP));
	END;	
  END IF;
