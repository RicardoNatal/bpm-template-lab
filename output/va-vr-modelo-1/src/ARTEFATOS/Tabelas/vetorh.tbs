—␀␀/* Verifica se Utiliza Ronda Ponto  */
PROCEDURE SP_VERRPO(P_USARPO OUT BOOLEAN)
 IS

l_vetrpo      CHAR(1);
  l_qtdrpo      NUMBER(8);
BEGIN

  BEGIN
      SELECT VETRPO, QTDRPO INTO l_vetrpo, l_qtdrpo FROM R000PRP;
  EXCEPTION WHEN OTHERS THEN
      l_vetrpo := 'N';
  END;

  IF (l_vetrpo = 'S') AND (l_qtdrpo > 0) THEN
    p_usarpo := TRUE;
  ELSE
    p_usarpo := FALSE;
  END IF;
END␀ù␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
®␀␀PROCEDURE SP_VERSAO_ESFINGE(P_NUMEMP NUMBER(4), P_DATA_REFERENCIA DATE, P_VERSAO_ESFINGE OUT NUMBER)
 IS

  l_DataVersao5 DATE;
  l_DataVersao6 DATE;
  alfmen VARCHAR2(255);
BEGIN
  BEGIN
    SELECT R304AUT.CMPAU1, R304AUT.CMPAU2
      INTO l_DataVersao5, l_DataVersao6
      FROM R304AUT
     WHERE R304AUT.NUMEMP = p_numemp;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      ALFMEN := 'Erro no SELECT em R304AUT.';
      RAISERROR 103 alfmen;
  END;
  
  IF ((l_DataVersao5 IS NULL) OR (l_DataVersao5 = DATETIME(31, 12, 1900, 0, 0, 0))) THEN
    l_DataVersao5 := DATETIME(1, 1, 2025, 0, 0, 0);
  END IF;
  
  IF ((l_DataVersao6 IS NULL) OR (l_DataVersao6 = DATETIME(31, 12, 1900, 0, 0, 0))) THEN
    l_DataVersao6 := DATETIME(1, 1, 2026, 0, 0, 0);
  END IF;
  
  /* Conforme enum LVersaoESfinge.java */
  IF (P_DATA_REFERENCIA >= l_DataVersao6) THEN
    P_VERSAO_ESFINGE := 9;  /*6.01*/
  ELSE
    P_VERSAO_ESFINGE := 8;  /*5.07*/
  END IF;
END␀ù␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Z␀␀PROCEDURE SP_VISCON(P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_NUMCRA NUMBER,P_CODPRM NUMBER,P_DATINI DATE,P_HORINI NUMBER,P_DATVAL DATE,P_HORVAL NUMBER,P_BLOAUT VARCHAR2(1),P_TIPPEV NUMBER,P_TIPVIS NUMBER,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_SUBNV NUMBER(1),P_CREACC NUMBER(1),P_ANDVIS NUMBER(3))
 IS
BEGIN
    NULL;
END		SENIOR;20␀␀SP_USUTEL
