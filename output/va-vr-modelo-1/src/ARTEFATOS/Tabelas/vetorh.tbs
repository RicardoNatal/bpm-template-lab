  LOOP
    BEGIN
      UPDATE R017RHP
         SET DATFIM = (SELECT IFNULL((DATETIMEADD(DD, -1, MIN(RHP.DATREV))), DATETIME(31, 12, 1900, 0, 0, 0)) FROM R017RHP RHP
                        WHERE RHP.ESTPOS = R017RHP.ESTPOS AND RHP.CODTHP = R017RHP.CODTHP
                          AND RHP.DATREV > R017RHP.DATREV)
       WHERE ESTPOS = l_R017RHP_AuxD.ESTPOS
         AND CODTHP = l_R017RHP_AuxD.CODTHP;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar data de término da revisão.';
    END;
  END LOOP;

  /* Apaga Registros em R017RHP_AUX */
  BEGIN
    DELETE FROM R017RHP_AUX;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao excluir registros da tabela R017RHP_AUX.';
  END;
END␀°Ğ␀␀		SENIOR;07␀␀

TRIGGER R017RHP_ED AFTER DELETE ON R017RHP FOR EACH ROW

BEGIN
BEGIN
    /* Insere Registro Old */
    INSERT INTO R017RHP_AUX (ESTPOS, CODTHP, FLGCON) VALUES (:OLD.ESTPOS, :OLD.CODTHP, 0);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao inserir registro na tabela R017RHP_AUX.';
  END;
END␀␀␀ÌÄ␀␀␀␀␀␀␀␀␀␀␀¯Ğ␀␀+f±␀Ôÿ?␀␀␀␀␀=øeËfq␀Æÿ␀␀ÿ␀½-±␀Ôÿ?␀␀␀␀␀‚A:vÕ␀q‡␀Æÿ␀␀ÿ␀–oŠ␀Ôÿ?␀␀␀␀␀~o}o}on␀Æÿ␀␀ÿ␀␀␀␀␀␀␀ÍÄ␀␀␀␀␀␀·Ğ␀␀+f±␀	€␀␀␀␀␀›>÷eËfq␀Æÿ␀␀€Ğ␀␀␀Ä␀␀4	€␀␀␀␀␀(A§Ä␀␀§Ä␀␀f␀␀␀ÿ␀␀ş¸␀␀␀úDÑ␀	€␀␀␀␀␀BJ§H§HqCş‡␀êÿ␀␀‰Ğ␀␀␀…¬␀␀´␀	€␀␀␀␀␀‘<XbXbr‰‡␀Æÿ␀␀Ò␀␀␀,Á␀	€␀␀␀␀␀T<GGy␀Æÿ␀␀¤Û␀␀␀␀␀␀	0;1;2;3;4¹Ğ␀␀		SENIOR;0ü␀␀TRIGGER R017RIS_EI AFTER INSERT ON R017RIS FOR EACH ROW
DECLARE
	l_DataZero DATE;
	l_DatIniHis DATE;
	l_DatTerHis DATE;
	l_DataInicioSST DATE;
  	l_EstPosStr VARCHAR(3);
  	l_PosTraStr   R017RIS.PosTra%TYPE;
  	l_Where VARCHAR(200);
	l_NumEmp   R030DES.NumEmp%TYPE;
	l_Json VARCHAR(2000);

	CURSOR C_R030DES IS SELECT NumEmp, IniSST 
	FROM R030DES 
	WHERE IniSST > l_DataZero AND (l_DatTerHis > IniSST OR l_DatTerHis = l_DataZero) 
	ORDER BY NumEmp;
BEGIN
	l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	l_DatIniHis := :NEW.DatHis;
	
	l_EstPosStr := CONVERT(NUMBER_TO_CHAR, :NEW.EstPos);
	l_PosTraStr := :NEW.PosTra;
	l_Where := 'ESTPOS = ' || l_EstPosStr || ' AND POSTRA = ''' || l_PosTraStr || '''';
  	SP_PROXHIST_NPER('DATHIS', 'R017HDE', l_Where, l_DatIniHis, l_DatTerHis OUT);
  	
  	SP_CONCATENAR_NUM('ESTPOS', :NEW.EstPos, l_Json OUT);
  	SP_CONCATENAR_DES('POSTRA', :NEW.PosTra, l_Json OUT);
  	SP_CONCATENAR_DAT('DATHIS', :NEW.DatHis, l_Json OUT);
  	
  	FOREACH C_R030DES INTO l_NumEmp, l_DataInicioSST
  	LOOP
  		IF (l_DatIniHis < l_DataInicioSST) THEN
  			l_DatIniHis := l_DataInicioSST;
  		END IF;
	
		SP_E_SOCIAL_SM('S-2240', 'R017RIS', 'N', 'I', l_DatIniHis, l_DatTerHis, l_NumEmp, 0, 0, l_Json, '', 0, NULL, l_DatIniHis, 0, 'R017RIS_EI');
  	END LOOP;
END␀ºĞ␀␀		SENIOR;0␀␀

TRIGGER R017RIS_EU AFTER UPDATE ON R017RIS FOR EACH ROW
DECLARE
	l_Alterou BOOLEAN;
	l_DataZero DATE;
	l_DatIniHis DATE;
	l_DatTerHis DATE;
	l_DataInicioSST DATE;
  	l_EstPosStr VARCHAR(3);
  	l_PosTraStr   R017RIS.PosTra%TYPE;
  	l_Where VARCHAR(200);
	l_NumEmp   R030DES.NumEmp%TYPE;
	l_Json VARCHAR(2000);
	l_JsonAlteracao VARCHAR2(2000);
	
	CURSOR C_R030DES IS SELECT NumEmp, IniSST 
	FROM R030DES 
	WHERE IniSST > l_DataZero AND (l_DatTerHis > IniSST OR l_DatTerHis = l_DataZero) 
	ORDER BY NumEmp;
BEGIN
	SP_VALUPDATE_NUM(:OLD.CodAtv, :NEW.CodAtv, l_Alterou OUT);
	IF (l_Alterou = TRUE) THEN
		l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
		l_DatIniHis := :NEW.DatHis;		
		SP_CONCAT_NUM_JSON('CODATV',:NEW.CodAtv, :OLD.CodAtv, l_JsonAlteracao OUT);
		
		l_EstPosStr := CONVERT(NUMBER_TO_CHAR, :NEW.EstPos);
		l_PosTraStr := :NEW.PosTra;
		l_Where := 'ESTPOS = ' || l_EstPosStr || ' AND POSTRA = ''' || l_PosTraStr || '''';
	  	SP_PROXHIST_NPER('DATHIS', 'R017HDE', l_Where, l_DatIniHis, l_DatTerHis OUT);
	  	
	  	SP_CONCATENAR_NUM('ESTPOS', :NEW.EstPos, l_Json OUT);
	  	SP_CONCATENAR_DES('POSTRA', :NEW.PosTra, l_Json OUT);
  		SP_CONCATENAR_DAT('DATHIS', :NEW.DatHis, l_Json OUT);
	  	
	   	FOREACH C_R030DES INTO l_NumEmp, l_DataInicioSST
	  	LOOP
  			IF (l_DatIniHis < l_DataInicioSST) THEN
  				l_DatIniHis := l_DataInicioSST;
  			END IF;
  		
  			SP_E_SOCIAL_SM('S-2240', 'R017RIS', 'N', 'A', l_DatIniHis, l_DatTerHis, l_NumEmp, 0, 0, l_Json, l_JsonAlteracao, 0, NULL, l_DatIniHis, 0, 'R017RIS_EU');
	  	END LOOP;
  	END IF;
END␀¸Ğ␀␀		SENIOR;0␀␀

TRIGGER R017RIS_ED AFTER DELETE ON R017RIS FOR EACH ROW
