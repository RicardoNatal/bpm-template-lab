        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODMOD', CONVERT(NUMBER_TO_CHAR, :OLD.CODMOD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034MDL_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDCON', :OLD.INDCON);
      END;
  END IF; 
END␀␀␀´␀␀␀␀␀␀␀␀±Ó␀␀-´␀	Ôÿ!␀␀␀␀␀ğ@Î¢␀␀ø¢␀␀r␀Æÿ␀␀²Ó␀␀␀îT‡␀Ôÿ!␀␀␀␀␀Y°V°V}␀␀ÿ␀␀ÿ␀␀␀␀0␀␀£␀␀␀␀³Ó␀␀…¬␀␀´␀	Ôï1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôï1␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôï1␀␀␀␀␀œ$€$€$w␀Æÿ␀␀…Ó␀␀␀Äı␀␀­␀	Ôï1␀␀␀␀␀xş␀␀xş␀␀xş␀␀p␀Æÿ␀␀ÿ␀␀ÛÔï1␀␀␀␀␀é␀é␀é␀n␀Æÿ␀␀ÿ␀š¬␀␀¢␀Ôï1␀␀␀␀␀–¯␀␀–¯␀␀–¯␀␀;)␀␀Æÿ␀␀ÿ␀Ø)Ôï1␀␀␀␀␀–¯␀␀–¯␀␀–¯␀␀£␀␀ÿ␀␀O"␀¤§␀␀oÔï1␀␀␀␀␀í¨␀␀ç§␀␀U¨␀␀i␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3␀␀¸␀␀␀␀␀␀␀␀␀␀␀´Ó␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀œ$€$€$w␀Æÿ␀␀…Ó␀␀␀o ␀␀L	␀␀␀␀␀␀␀š ␀␀” ␀␀” ␀␀n␀Æÿ␀␀ÿ␀␀␀␀0;1;2;3¶Ó␀␀		SENIOR;0␀␀TRIGGER R034PAT_EI AFTER INSERT ON R034PAT FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN
  /* Geração de logs Modalidades do PAT (Tabela: R034PAT)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 93;     /* Modalidades do PAT (Tabela: R034PAT)*/
  l_codtpa := 300;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034PAT_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MODPAT', CONVERT(NUMBER_TO_CHAR, :NEW.MODPAT));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034PAT_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      
      BEGIN
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
	  END;
  END IF; 
END␀·Ó␀␀		SENIOR;0D␀␀ 

TRIGGER R034PAT_EU AFTER UPDATE ON R034PAT FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN
  /* Geração de logs Modalidades do PAT (Tabela: R034PAT)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 93;     /* Modalidades do PAT (Tabela: R034PAT)*/
  l_codtpa := 301;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.ModPat <> :NEW.ModPat)) THEN
    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034PAT_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MODPAT', CONVERT(NUMBER_TO_CHAR, :OLD.MODPAT));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034PAT_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
    END IF; 
  END IF; 
END␀µÓ␀␀		SENIOR;0␀␀ 

TRIGGER R034PAT_ED AFTER DELETE ON R034PAT FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Modalidades do PAT (Tabela: R034PAT)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 93;     /* Modalidades do PAT (Tabela: R034PAT)*/
  l_codtpa := 300;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034PAT_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MODPAT', CONVERT(NUMBER_TO_CHAR, :OLD.MODPAT));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034PAT_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      
      BEGIN
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
	  END;
  END IF; 
END␀␀␀ ␀␀␀␀␀␀␀¸Ó␀␀…¬␀␀´␀	Ôÿ#␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ#␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ#␀␀␀␀␀œ$€$€$w␀Æÿ␀␀…Ó␀␀␀mDÑ␀	Ôÿ#␀␀␀␀␀‡JşEşEqC␀êÿ␀␀ÿ␀Öü␀␀­␀	Ôÿ#␀␀␀␀␀xş␀␀xş␀␀xş␀␀3)␀␀Æÿ␀␀ÿ␀½␀␀¹␀Ôÿ#␀␀␀␀␀÷½␀␀÷½␀␀ø½␀␀Q)␀␀Æÿ␀␀ÿ␀\␀jÔÿ#␀␀␀␀␀K␀Í␀J␀p␀Æÿ␀␀Ó␀␀␀H*Ôÿ#␀␀␀␀␀***␀␀ÿ␀␀Ó␀␀␀␀␀␀	0;1;2;3;4ºÓ␀␀		SENIOR;0 ␀␀TRIGGER R034PIX_EI AFTER INSERT ON R034PIX FOR EACH ROW

DECLARE
  L_CODPES         R033pes.CODPES%TYPE;
  L_COUNT        NUMBER;
  l_DatAtu       DATE;
  l_Data_zero    DATE;
  l_existe       BOOLEAN;
  L_DATALT         R033PIX.DATALT%TYPE;
  L_ULTSEQCON      R033PIX.SEQCON%TYPE;
  L_SEQCON         R033PIX.SEQCON%TYPE;
  L_TPCPIX         R033PIX.TPCPIX%TYPE;
  L_CHVPIX         R033PIX.CHVPIX%TYPE;
  l_DatAltHFI      R033PIX.DATAUX%TYPE;
  l_ColAti         R033PIX.COLATI%TYPE;
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);

BEGIN
  /*Data atual*/
  l_DatAtu := CURDATE();
  /*Data zerada*/
  l_data_zero  := '31/12/1900,00:00:00';

  /*Verifica se existe código da pessoa vinculado ao colaborador*/
  BEGIN
    SELECT CODPES INTO L_CODPES FROM R034FUN
     WHERE NUMEMP = :NEW.NUMEMP
       AND TIPCOL = :NEW.TIPCOL
       AND NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_CODPES := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R034FUN.CODPES';
  END;

  IF (L_CODPES > 0) THEN
    /*Verifica se pessoa existe na base*/
    BEGIN
      SELECT COUNT(*) INTO L_COUNT FROM R033pes
       WHERE CODPES = L_CODPES;
      EXCEPTION WHEN NO_DATA_FOUND THEN
        L_COUNT := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler R033pes.CODPES 1';
    END;

    IF (L_COUNT > 0) THEN
      l_existe := TRUE;
      BEGIN
        /*Verifica se chave já existe*/
        SELECT SEQCON,  DATALT,  TPCPIX, CHVPIX
          INTO L_SEQCON,L_DATALT,L_TPCPIX,L_CHVPIX
          FROM R033PIX
         WHERE CODPES = L_CODPES
           AND DATALT = :NEW.DATALT
           AND TPCPIX = :NEW.TPCPIX
           AND CHVPIX = :NEW.CHVPIX;
        EXCEPTION WHEN NO_DATA_FOUND THEN
          L_SEQCON := 0;
          L_DATALT := :NEW.DATALT;
          L_TPCPIX := :NEW.TPCPIX;
          L_CHVPIX := :NEW.CHVPIX;
          l_Existe := FALSE;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao ler R033PIX';
      END;

      /* Retornar a data do primeiro hist. filial do colaborador */
      R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);
        
      /* Retornar se o colaborador está ativo */
      R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);

      IF (l_Existe = TRUE) THEN
        BEGIN
          /*Se já existe zera a data encerramento */
          UPDATE R033PIX SET DATENC = l_data_zero,
                             EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                             DEPAUX = 0, COLATI = l_ColAti, CANAUX = 0, DATAUX = l_DatAltHFI
           WHERE CODPES = L_CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON AND TPCPIX = L_TPCPIX AND CHVPIX = L_CHVPIX;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao atualizar a R033PIX';
        END;
      ELSE
        BEGIN
            /*Gera próxima sequência*/
            SELECT IFNULL(MAX(SEQCON),0) INTO L_ULTSEQCON FROM R033PIX
             WHERE CODPES = L_CODPES;
            EXCEPTION WHEN NO_DATA_FOUND THEN
              L_ULTSEQCON := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao ler R033PIX.SEQCON';
        END;
        L_SEQCON := L_ULTSEQCON + 1;
        BEGIN
          /*Se a chave não existe insere na base */
          INSERT INTO R033PIX (CODPES, DATALT, SEQCON, DATABE, DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX, TPCPIX, CHVPIX)
          VALUES (L_CODPES, L_DATALT, L_SEQCON, l_DatAtu, l_data_zero, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, l_ColAti, 0, l_DatAltHFI, L_TPCPIX, L_CHVPIX);
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao inserir na R033PIX';
        END;
      END IF;
    END IF;
  END IF;
  /* Geração de logs Chaves Pix (Tabela: R034PIX)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 119;    /* Chaves Pix (Tabela: R034PIX)*/
  l_codtpa := 369;
 
   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
	  SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034PIX_EI', '');

	  /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
	  BEGIN
	    INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
		SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQCON', CONVERT(NUMBER_TO_CHAR, :NEW.SEQCON));
	  EXCEPTION
		WHEN OTHERS THEN RAISERROR 103 'R034PIX_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	  END;

	  BEGIN
	    INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TPCPIX', CONVERT(NUMBER_TO_CHAR, :NEW.TPCPIX));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CHVPIX', :NEW.CHVPIX);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERCON', CONVERT(NUMBER_TO_CHAR, :NEW.PERCON));
	  END;
  END IF;   
END␀»Ó␀␀		SENIOR;07␀␀

TRIGGER R034PIX_EU AFTER UPDATE ON R034PIX FOR EACH ROW

DECLARE
  L_CODPES    	   R033pes.CODPES%TYPE;
  L_COUNT     	 NUMBER;
  L_SITAFA    	   R034FUN.SITAFA%TYPE;
  L_DEMITIDOS 	 BOOLEAN;
  l_DatAtu    	 DATE;
  l_Data_zero 	 DATE;
  l_existe    	 BOOLEAN;
  L_DATALT    	   R033PIX.DATALT%TYPE;
  L_ULTSEQCON 	   R033PIX.SEQCON%TYPE;
  L_SEQCON    	   R033PIX.SEQCON%TYPE;
  L_TPCPIX    	   R033PIX.TPCPIX%TYPE;
  L_CHVPIX    	   R033PIX.CHVPIX%TYPE;
  l_DatAltHFI 	   R033PIX.DATAUX%TYPE;
  l_ColAti    	   R033PIX.COLATI%TYPE;
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN
  /*Data atual*/
  l_DatAtu := CURDATE();
  /*Data zerada*/
  l_data_zero  := '31/12/1900,00:00:00';

  /*Verifica se existe código da pessoa vinculado ao colaborador*/
  BEGIN
    SELECT CODPES,SITAFA INTO L_CODPES,L_SITAFA FROM R034FUN
     WHERE NUMEMP = :NEW.NUMEMP
       AND TIPCOL = :NEW.TIPCOL
       AND NUMCAD = :NEW.NUMCAD;
    EXCEPTION WHEN NO_DATA_FOUND THEN
      L_CODPES := 0;
      L_SITAFA := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler R034FUN.CODPES';
  END;

  IF (L_CODPES > 0) THEN
    /*Verifica se pessoa existe na base*/
    BEGIN
      SELECT COUNT(*) INTO L_COUNT FROM R033pes
       WHERE CODPES = L_CODPES;
      EXCEPTION WHEN NO_DATA_FOUND THEN
        L_COUNT := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao ler R033pes.CODPES 1';
    END;

    IF (L_COUNT > 0) THEN
      RH_VERCOLDEM(:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,L_CODPES,L_SITAFA,'R034PIX',L_DEMITIDOS OUT);
      IF (L_DEMITIDOS = TRUE) THEN
        l_existe := TRUE;
        BEGIN
          /*Verifica se chave já existe*/
          SELECT DATALT,   SEQCON,   TPCPIX,   CHVPIX
            INTO L_DATALT, L_SEQCON, L_TPCPIX, L_CHVPIX
            FROM R033PIX
           WHERE CODPES = L_CODPES
             AND DATALT = :OLD.DATALT
             AND TPCPIX = :OLD.TPCPIX
             AND CHVPIX = :OLD.CHVPIX;
          EXCEPTION WHEN NO_DATA_FOUND THEN
            L_SEQCON := 0;
            L_DATALT := :NEW.DATALT;
            L_TPCPIX := :NEW.TPCPIX;
            L_CHVPIX := :NEW.CHVPIX;
            l_existe := FALSE;
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao ler R033PIX';
        END;

        /* Retornar a data do primeiro hist. filial do colaborador */
        R038HFI_MINDATALT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_DatAltHFI OUT);
        
        /* Retornar se o colaborador está ativo */
        R038AFA_COLATI(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_ColAti OUT);

        IF (l_Existe = TRUE) THEN
          BEGIN
            /*Se já existe atualiza com data encerramento zerada*/
            UPDATE R033PIX SET TPCPIX = :NEW.TPCPIX, CHVPIX = :NEW.CHVPIX, DATENC = l_data_zero,
                               EMPAUX = :NEW.NUMEMP, TIPAUX = :NEW.TIPCOL, CADAUX = :NEW.NUMCAD,
                               DEPAUX = 0, COLATI = l_ColAti, CANAUX = 0, DATAUX = l_DatAltHFI
             WHERE CODPES = L_CODPES AND DATALT = L_DATALT AND SEQCON = L_SEQCON AND TPCPIX = L_TPCPIX AND CHVPIX = L_CHVPIX;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao atualizar a R033PIX';
          END;
        ELSE
          BEGIN
            /*Gera próxima sequência*/
            SELECT IFNULL(MAX(SEQCON),0) INTO L_ULTSEQCON FROM R033PIX
             WHERE CODPES = L_CODPES;
            EXCEPTION WHEN NO_DATA_FOUND THEN
              L_ULTSEQCON := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao ler R033PIX';
          END;
          L_SEQCON := L_ULTSEQCON + 1;
          BEGIN
            /*Se a chave não existe insere na base*/
            INSERT INTO R033PIX (CODPES, DATALT, SEQCON, DATABE, DATENC, EMPAUX, TIPAUX, CADAUX, DEPAUX, COLATI, CANAUX, DATAUX, TPCPIX, CHVPIX)
            VALUES (L_CODPES, L_DATALT, L_SEQCON, l_DatAtu, l_data_zero, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, l_ColAti, 0, l_DatAltHFI, L_TPCPIX, L_CHVPIX);
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao inserir na R033PIX';
          END;
        END IF;
      END IF;
    END IF;
  END IF;

  /* Geração de logs Chaves Pix (Tabela: R034PIX)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 119;     /* Chaves Pix (Tabela: R034PIX)*/
  l_codtpa := 370;
 
  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.SeqCon <> :NEW.SeqCon)
   OR (:OLD.TPCPIX <> :NEW.TPCPIX)
   OR (:OLD.CHVPIX <> :NEW.CHVPIX)
   OR (:OLD.PerCon <> :NEW.PerCon)) THEN

   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034PIX_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQCON', CONVERT(NUMBER_TO_CHAR, :OLD.SEQCON));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034PIX_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTPCPIX', CONVERT(NUMBER_TO_CHAR, :OLD.TPCPIX));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTPCPIX', CONVERT(NUMBER_TO_CHAR, :NEW.TPCPIX));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCHVPIX', :OLD.CHVPIX);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCHVPIX', :NEW.CHVPIX);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERCON', CONVERT(NUMBER_TO_CHAR, :OLD.PERCON));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERCON', CONVERT(NUMBER_TO_CHAR, :NEW.PERCON));
      END;
    END IF; 
  END IF;   
END␀¹Ó␀␀		SENIOR;0␀␀

TRIGGER R034PIX_ED AFTER DELETE ON R034PIX FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Chaves Pix (Tabela: R034PIX)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 119;     /* Chaves Pix (Tabela: R034PIX)*/
  l_codtpa := 369;
 
   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034PIX_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQCON', CONVERT(NUMBER_TO_CHAR, :OLD.SEQCON));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034PIX_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TPCPIX', CONVERT(NUMBER_TO_CHAR, :OLD.TPCPIX));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CHVPIX', :OLD.CHVPIX);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERCON', CONVERT(NUMBER_TO_CHAR, :OLD.PERCON));
      END;
