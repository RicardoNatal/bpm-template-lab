        INSERT INTO R097MOP_AUX (PROPAC,DATINI,HORINI,SEQMOV)
        VALUES (:NEW.PROPAC,:NEW.DATINI,:NEW.HORINI,:NEW.SEQMOV);
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no INSERT em R097MOP_AUX.';
      END;
