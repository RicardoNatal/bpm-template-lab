						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (NEWVERAFA)';
				END;
		END IF;
		

		IF (l_temAud > 0) THEN
				BEGIN
						INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAPRSOL', l_r034DAC.APRSOL);
				EXCEPTION
						WHEN OTHERS THEN RAISERROR 103 'R017DAC_EU: Erro inserir campo detalhe log auditoria. (OLDAPRSOL)';
