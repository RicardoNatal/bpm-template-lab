DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_layout VARCHAR2(6);
  l_gerarPendencia BOOLEAN;  
BEGIN
  /*e-Social*/
  l_gerarPendencia := TRUE;
  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
  IF (l_layout IS NOT NULL)THEN
    N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    IF (l_gerarPendencia = TRUE) THEN
      SP_E_SOCIAL('S-2298', 'R034REI', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, '', '', 0, NULL, :NEW.DATRET, 0, 'R034REI_AI');
    END IF;
  END IF;
  /* Geração de logs Reintegração (Tabela: R034REI)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 90;     /* Reintegração (Tabela: R034REI)*/
  l_codtpa := 291;
  

  BEGIN
    UPDATE R034FUN SET DATREI = :NEW.DATREI WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
  EXCEPTION
    WHEN OTHERS THEN RAISERROR 103 'R034REI_AI: Erro ao alterar data reintegração na tabela R034FUN.';
  END;
 
  l_temAud := FALSE;
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034REI_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034REI_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
        SP_DATSTR(:NEW.DATREI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATREI', l_datTemp);
        SP_DATSTR(:NEW.DATRET, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATRET', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPREI', CONVERT(NUMBER_TO_CHAR, :NEW.TIPREI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRO', :NEW.CODPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LEIANI', :NEW.LEIANI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EMPORI', CONVERT(NUMBER_TO_CHAR, :NEW.EMPORI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CADORI', CONVERT(NUMBER_TO_CHAR, :NEW.CADORI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOTFIC', 'registro incluído (excede limite de exibição)');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PAGJUI', :NEW.PAGJUI);
      END;
  END IF; 		
END␀àÓ␀␀		SENIOR;0p␀␀

TRIGGER R034REI_AU AFTER UPDATE ON R034REI FOR EACH ROW
DECLARE
  l_AlterouInfoCampo  BOOLEAN;
  l_AlterouInfoLayout BOOLEAN;
  l_temAud            BOOLEAN;
  l_codRPA            NUMBER(15);
  l_codSistema        NUMBER(2);
  l_codcpa            NUMBER(4);
  l_codtpa            NUMBER(4);
  l_datTemp           VARCHAR(10);
  l_InfoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_layout VARCHAR2(6);
  l_gerarPendencia BOOLEAN;
  l_VersaoESocial NUMBER;    
BEGIN
  l_InfoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_gerarPendencia := TRUE;
  l_VersaoESocial := 0;  
  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layout OUT);
  IF (l_layout IS NOT NULL)THEN
    N_GR_PEN_BENEF(l_layout, l_gerarPendencia OUT);
    IF (l_gerarPendencia = TRUE) THEN
  
      SP_ESOCIAL_INFO(:OLD.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
      
      /*e-Social*/
      SP_VALUPDATE_NUM(:OLD.TipRei, :NEW.TipRei, l_AlterouInfoCampo OUT);
      IF (l_AlterouInfoCampo = TRUE) THEN
      	l_AlterouInfoLayout := TRUE;
      END IF;
      
      SP_VALUPDATE_DES(:OLD.CodPro, :NEW.CodPro, l_AlterouInfoCampo OUT);
      IF (l_AlterouInfoCampo = TRUE) THEN
      	l_AlterouInfoLayout := TRUE;
      END IF;
      
      SP_VALUPDATE_DES(:OLD.LeiAni, :NEW.LeiAni, l_AlterouInfoCampo OUT);
      IF (l_AlterouInfoCampo = TRUE) THEN
      	l_AlterouInfoLayout := TRUE;
      END IF;
      
      SP_VALUPDATE_DES(:OLD.PagJui, :NEW.PagJui, l_AlterouInfoCampo OUT);
      IF (l_AlterouInfoCampo = TRUE AND l_SimplificaoESocial = FALSE) THEN
      	l_AlterouInfoLayout := TRUE;
      END IF;
      
      SP_VALUPDATE_DES(:OLD.DatRet, :NEW.DatRet, l_AlterouInfoCampo OUT);
      IF (l_AlterouInfoCampo = TRUE) THEN
      	l_AlterouInfoLayout := TRUE;
      END IF;
      
      IF (l_AlterouInfoLayout = TRUE) THEN
      	SP_E_SOCIAL('S-2298', 'R034REI', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, '', '', 0, NULL,
      	:NEW.DATRET, 0, 'R034REI_AU');
      END IF;
    END IF;    
  END IF;      

  /* Geração de logs Reintegração (Tabela: R034REI)*/
  l_codSistema := 1; /* Código do sistema vetorh. */
  l_codcpa := 90; /* Reintegração (Tabela: R034REI)*/
  l_codtpa := 292;

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatRei <> :NEW.DatRei)
   OR (:OLD.DatRet <> :NEW.DatRet)
   OR (:OLD.TipRei <> :NEW.TipRei)
   OR (:OLD.CodPro <> :NEW.CodPro)
   OR (:OLD.LeiAni <> :NEW.LeiAni)
   OR (:OLD.EmpOri <> :NEW.EmpOri)
   OR (:OLD.CadOri <> :NEW.CadOri)
   OR (:OLD.NotFic <> :NEW.NotFic)
   OR (:OLD.PagJui <> :NEW.PagJui)) THEN

   BEGIN
     UPDATE R034FUN SET DATREI = :NEW.DATREI WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD;
   EXCEPTION
     WHEN OTHERS THEN RAISERROR 103 'R034REI_AU: Erro ao alterar data reintegração na tabela R034FUN.';
   END;

   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034REI_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034REI_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        SP_DATSTR(:OLD.DATREI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATREI', l_datTemp);
        SP_DATSTR(:NEW.DATREI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATREI', l_datTemp);
        SP_DATSTR(:OLD.DATRET, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATRET', l_datTemp);
        SP_DATSTR(:NEW.DATRET, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATRET', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPREI', CONVERT(NUMBER_TO_CHAR, :OLD.TIPREI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPREI', CONVERT(NUMBER_TO_CHAR, :NEW.TIPREI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODPRO', :OLD.CODPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODPRO', :NEW.CODPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDLEIANI', :OLD.LEIANI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWLEIANI', :NEW.LEIANI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDEMPORI', CONVERT(NUMBER_TO_CHAR, :OLD.EMPORI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWEMPORI', CONVERT(NUMBER_TO_CHAR, :NEW.EMPORI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCADORI', CONVERT(NUMBER_TO_CHAR, :OLD.CADORI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCADORI', CONVERT(NUMBER_TO_CHAR, :NEW.CADORI));
        IF (:OLD.NotFic <> :NEW.NotFic) THEN
        	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOTFIC', 'alterado (excede limite de exibição)');
        	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNOTFIC', 'alterado (excede limite de exibição)');
        ELSE
        	INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNOTFIC', 'não houve alteração (excede limite de exibição)');
            INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNOTFIC', 'não houve alteração (excede limite de exibição)');
        END IF;
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPAGJUI', :OLD.PAGJUI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPAGJUI', :NEW.PAGJUI);
      END;
    END IF; 
  END IF; 	
END␀áÓ␀␀		SENIOR;0?␀␀

TRIGGER R034REI_ED AFTER DELETE ON R034REI FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_datazero     DATE;
BEGIN
  /* Geração de logs Reintegração (Tabela: R034REI)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 90;     /* Reintegração (Tabela: R034REI)*/
  l_codtpa := 291;
  l_datazero := DATETIME(31, 12, 1900, 0, 0, 0);

  BEGIN
    UPDATE R034FUN SET DATREI = l_datazero WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD;
  EXCEPTION
    WHEN OTHERS THEN RAISERROR 103 'R034REI_ED: Erro ao alterar data reintegração na tabela R034FUN.';
  END;
 
   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034REI_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034REI_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        SP_DATSTR(:OLD.DATREI, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATREI', l_datTemp);
        SP_DATSTR(:OLD.DATRET, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATRET', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPREI', CONVERT(NUMBER_TO_CHAR, :OLD.TIPREI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODPRO', :OLD.CODPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LEIANI', :OLD.LEIANI);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EMPORI', CONVERT(NUMBER_TO_CHAR, :OLD.EMPORI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CADORI', CONVERT(NUMBER_TO_CHAR, :OLD.CADORI));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NOTFIC', 'registro excluído (excede limite de exibição)');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PAGJUI', :OLD.PAGJUI);
      END;
  END IF; 
END␀␀␀O.␀␀␀␀␀␀␀␀␀␀␀␀␀âÓ␀␀…¬␀␀´␀	€‚␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	€‚␀␀␀␀␀Ü␀t␀Ü␀n%ˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	€‚␀␀␀␀␀.%0.0.w"ˆ␀Æÿ␀␀…Ó␀␀␀˜EÑ␀	€‚␀␀␀␀␀^L“H”HqCş‡␀êÿ␀␀ÿ␀Z,´␀	€‚␀␀␀␀␀@@V9V9r␀Æÿ␀␀Fá␀␀␀+␀s€‚␀␀␀␀␀e␀Ÿ␀Ÿ␀n␀Æÿ␀␀ÿ␀µEÑ␀€‚␀␀␀␀␀ÈLT␀U␀qCş‡␀êÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀xò␀␀␀␀␀␀␀␀␀␀ãÓ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀g>XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀Ü␀Ü␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀‚%€$€$w␀Æÿ␀␀…Ó␀␀␀‰-±␀	␀␀␀␀␀␀␀M␀úú␀␀ç␀q␀Æÿ␀␀dã␀␀␀␀␀␀0;1;2;3åÓ␀␀		SENIOR;0M␀␀/* INSERT (NEW) */
TRIGGER R034SEG_EI AFTER INSERT ON R034SEG FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Seguros do Empregado (Tabela: R034SEG)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 88;     /* Seguros do Empregado (Tabela: R034SEG)*/
  l_codtpa := 287;
 
   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034SEG_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSEG', CONVERT(NUMBER_TO_CHAR, :NEW.CODSEG));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034SEG_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
      END;
  END IF; 
END␀æÓ␀␀		SENIOR;0~␀␀ 

