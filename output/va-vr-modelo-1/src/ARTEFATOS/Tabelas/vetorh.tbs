l_online       BOOLEAN;
  l_cravei       NUMBER(12);
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_froonl       BOOLEAN;
  l_situa        NUMBER(1);
  l_data_zero    DATE;
  l_libvei       NUMBER(1);
  l_datfim       DATE;
  l_datval       DATE;
  l_horval       NUMBER;
BEGIN
	SP_VerOnLine(l_online OUT);
	SP_UsaFronline(l_froonl OUT, l_libvei OUT);
	IF   (l_online = TRUE) AND (l_froonl = TRUE) AND (l_libvei = 1)THEN
		l_data_zero :=  DATETIME(31, 12, 1900, 0, 0, 0);
		l_situa := 0;
		BEGIN
			SELECT NUMCRA, DATFIM, HORFIM INTO l_cravei, l_datval, l_horval
				FROM R088HCH
				WHERE PLAVEI = :NEW.PLAVEI
				AND ((DATINI <= :NEW.DATINI) AND (DATFIM >= :NEW.DATFIM
				OR DATFIM = l_data_zero)) AND STAACC = 1;
		EXCEPTION
			WHEN TOO_MANY_ROWS THEN
			  RAISERROR 103 'Erro no R088HCH - TOO MANY ROWS.';
			WHEN NO_DATA_FOUND THEN
			  l_cravei := 0;
			WHEN OTHERS THEN
			  RAISERROR 103 'Erro no SELECT em R088HCH.';
		END;
		/* Se tiver crachá provísório vale ele. senão pegar o titular */
		SP_RETCRA (2, :NEW.EMPCON, :NEW.TCLCON, :NEW.CADCON, 0,'',0,'',l_crapro OUT);
		IF   (l_crapro = 0)  THEN
			SP_RETCRA (1, :NEW.EMPCON, :NEW.TCLCON, :NEW.CADCON,0,'',0,'', l_cracha OUT);
		ELSE  
			l_cracha := l_crapro;
		END IF;
		
		l_datfim := :NEW.DATFIM;
		IF (l_datfim = l_data_zero) OR (l_datfim > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
			l_datfim := DATETIME(31, 12, 2050, 0, 0, 0);		
		END IF;
		
		IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
			l_datval := DATETIME(31, 12, 2050, 0, 0, 0);		
			l_horval := 1439;
		END IF;
		
		/*VALIDA A MENOR DAS DUAS DATAS - HISTÓRICO - AUTORIZAÇÃO*/
		IF (l_datval > l_datfim) THEN
			l_datval := l_datfim;
			l_horval := 1439;
		END IF;
		
		IF (l_cracha <> 0) AND (l_cravei <> 0) THEN
			SP_VEIPESCON('I', l_cravei, l_cracha, l_situa, :NEW.PLAVEI, 
						l_datval, l_horval, :NEW.TCLCON, :NEW.EMPCON, :NEW.TCLCON, :NEW.CADCON, 0, '');
		END IF;
	END IF;
END␀NÜ␀␀		SENIOR;05␀␀

TRIGGER R088AUT_EU AFTER UPDATE ON R088AUT FOR EACH ROW

DECLARE
l_online       BOOLEAN;
