DECLARE
l_CodPrm          NUMBER(5);
    l_DatVal          DATE;
    l_HorVal          NUMBER(5);
    l_DatSai          DATE;
    l_HorSai          NUMBER(5);
BEGIN
    BEGIN
        SELECT CODPRM, DATVAL, HORVAL
        INTO l_CodPrm, l_DatVal, l_HorVal
        FROM R088VCD A
        WHERE A.PLAVEI = :NEW.PLAVEI
        AND A.DATCHG = :NEW.DATCHG
        AND A.HORCHG = :NEW.HORCHG;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN RAISERROR 103 'R088AJD_EI: Não encontrou registro na tabela R088VCD.';
        WHEN OTHERS THEN RAISERROR 103 'R088AJD_EI: Erro No SELECT R088VCD.';
    END;

    BEGIN
        SELECT DATSAI, HORSAI
        INTO l_DatSai, l_HorSai
        FROM R088VCS A
        WHERE A.PLAVEI = :NEW.PLAVEI
        AND A.DATCHG = :NEW.DATCHG
        AND A.HORCHG = :NEW.HORCHG;

        SP_VEICON('I', :NEW.TIPDOC, :NEW.NUMDOC, :NEW.NUMCRA, l_CodPrm, l_DatSai, l_HorSai);
    EXCEPTION
        WHEN NO_DATA_FOUND THEN     /*Se não encontrou DATSAI, passa DATVAL */
            SP_VEICON('I', :NEW.TIPDOC, :NEW.NUMDOC, :NEW.NUMCRA, l_CodPrm, l_DatVal, l_HorVal);

        WHEN OTHERS THEN RAISERROR 103 'R088AJD_EI: Erro No SELECT R088VCS.';
    END;
END␀DÜ␀␀		SENIOR;0ò␀␀

