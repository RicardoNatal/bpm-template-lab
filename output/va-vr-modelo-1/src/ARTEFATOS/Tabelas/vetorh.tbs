ş␀␀PROCEDURE SP_RETSEN(P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_CODIG OUT CHAR(6))
 IS

l_errstr      VARCHAR2(255);
  l_codig       CHAR(6);

BEGIN

  BEGIN
    SELECT SENCOL INTO l_codig FROM R038SEN
      WHERE R038SEN.NUMEMP = p_numemp AND
            R038SEN.TIPCOL = p_tipcol AND
            R038SEN.NUMCAD = p_numcad;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_codig := '     ';
    WHEN OTHERS THEN
      l_errstr := 'SP_RetSen. Erro em R038Sen. '||
                  'Empresa : '||CONVERT(NUMBER_TO_CHAR,p_numemp)||
                  'Tip.Col.: '||CONVERT(NUMBER_TO_CHAR,p_tipcol)||
                  'Num.Cad.: '||CONVERT(NUMBER_TO_CHAR,p_numcad);
      RAISERROR 103 l_errstr;
  END;

  p_codig := l_codig;
END␀Òø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
îPROCEDURE SP_RET_CUR_VERSION (P_VERSION OUT VARCHAR(20)) 
IS
BEGIN

  SELECT VerIns INTO P_VERSION
  FROM R490VER
  WHERE DatVer = (SELECT MAX(DatVer) FROM R490VER);  
  EXCEPTION   
    WHEN NO_DATA_FOUND THEN
      P_VERSION := '0';
