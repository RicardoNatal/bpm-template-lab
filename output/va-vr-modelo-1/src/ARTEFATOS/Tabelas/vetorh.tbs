`␀␀CREATE PROCEDURE SP_CODLOCALIZADOR (@p_codigo BIGINT, @p_StrRet VARCHAR(8) OUTPUT) AS
BEGIN
  declare @ChkError INTEGER
  declare @str VARCHAR(10)
  declare @digito INTEGER
  declare @index INTEGER
  declare @campo INTEGER
  declare @offset INTEGER
  declare @temp INTEGER
  declare @magic_index INTEGER
  declare @magic VARCHAR(10)
  declare @result VARCHAR(10)
  declare @val bigint
  declare @answer VARCHAR(10)
  declare @alldigits as VARCHAR(36);

  set @alldigits='0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ'

  EXECUTE @ChkError = SP_INTSTR @p_codigo, '99999999', @str OUT
  
  set @str = reverse(@str)

  DECLARE @reversed_base_val varchar(100)
  DECLARE @weight varchar(10)
  DECLARE @i int
  DECLARE @SUM int
  DECLARE @remainder int

  SELECT @weight = '234567234567234567234567'
  SELECT @reversed_base_val = @str /* REVERSE(@str) */
  SELECT @i = 1, @sum = 0

  WHILE (@i <= LEN(@reversed_base_val))
  BEGIN
    /* Calculate product and accumulate. */
    SELECT @sum = @sum + (CONVERT(int, SUBSTRING(@reversed_base_val, @i, 1)) * CONVERT(int, SUBSTRING(@weight, @i, 1)))
    SELECT	@i = @i + 1
  END

  /* Determine check digit, and concatenate to base value. */
  SELECT @remainder = @sum % 11
  SELECT @digito = CASE @remainder WHEN 0 THEN '0' WHEN 1 THEN '0' ELSE CONVERT(varchar(2), 11 - @remainder) END

  select @magic = '9182730645'
  
  set @result = ''
  set @magic_index = @digito + 1
  set @index = 1
  while @index < 9
  begin
	set @campo = substring(@str, @index, 1)
	set @offset = convert(int, substring(@magic, @magic_index, 1))
	set @temp = @campo + @offset
	set @temp = case when @temp > 9 then @temp - 10 else @temp end
	set @result = @result + convert(varchar, @temp)
	set @magic_index = case when @magic_index = 10 then 1 else @magic_index + 1 end
	set @index = @index + 1
  end
  set @result = @result + convert(varchar, @digito)

  set @val = convert(bigint, @result)
  set @answer='';

  while @val>0
  begin
    set @answer=substring(@alldigits,@val % 36 + 1,1) + @answer;
    set @val = @val / 36;
  end

  SET @p_StrRet = @answer;
END


	MSSQL;23SP_INTSTR
