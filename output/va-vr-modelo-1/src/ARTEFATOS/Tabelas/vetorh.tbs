Ôÿ?␀␀␀␀␀¥¯␀␀E¬␀␀¥¯␀␀␀␀ÿ␀␀ÿ␀(EÑ␀Ôÿ?␀␀␀␀␀ùGùGùGqC␀êÿ␀␀ÿ␀Z␀ŒÔÿ?␀␀␀␀␀’␀ë␀’␀n␀Æÿ␀␀ÿ␀p÷␀␀¤Ôÿ?␀␀␀␀␀X␀␀W␀p␀Æÿ␀␀ÿ␀␀␀␀0;1;2 Ñ␀␀		SENIOR;0␀␀TRIGGER R024CPU_EI AFTER INSERT ON R024CPU FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
l_ProximaData DATE;
l_Where VARCHAR(2000);
l_EstCarStr VARCHAR(4);
l_CodCar VARCHAR(25);
BEGIN
  l_Valor := '';
  l_ProximaData := DATETIME(31,12,1900,0,0,0);
  
  SP_CONCATENAR_NUM('ESTCAR', :NEW.EstCar, l_Valor OUT);
  SP_CONCATENAR_DES('CODCAR', :NEW.CodCar, l_Valor OUT);
  SP_CONCATENAR_DAT('DATALT', :NEW.DatAlt, l_Valor OUT);
  SP_CONCATENAR_NUM('ACUCAR', :NEW.AcuCar, l_Valor OUT);
  SP_CONCATENAR_NUM('CONESP', :NEW.ConEsp, l_Valor OUT);
  SP_CONCATENAR_DES('DEDEXC', :NEW.DedExc, l_Valor OUT);
  SP_CONCATENAR_DES('LEICAR', :NEW.LeiCar, l_Valor OUT);
  SP_CONCATENAR_DAT('DATLEI', :NEW.DatLei, l_Valor OUT);
  SP_CONCATENAR_NUM('SITLEI', :NEW.SitLei, l_Valor OUT);
  SP_CONCATENAR_NUM('SCTPQU', :NEW.SCTpQu, l_Valor OUT);  
  
  l_EstCarStr := CONVERT(NUMBER_TO_CHAR, :NEW.ESTCAR);
  l_Where := 'ESTCAR = ' || l_EstCarStr || ' AND CODCAR = ''' || :NEW.CODCAR || '''';

  SP_PROXIMOHIST('DATALT', 'R024CPU', l_Where, :NEW.DATALT, l_ProximaData OUT);
  
  SP_CARGOESOCIAL('R024CPU', :NEW.ESTCAR, :NEW.CODCAR, l_Valor, :NEW.DATALT, l_ProximaData, NULL);
  SP_FUNCAOESOCIAL('R024CPU', :NEW.ESTCAR, :NEW.CODCAR, L_VALOR, :NEW.DATALT, l_ProximaData, NULL);
END␀!Ñ␀␀		SENIOR;0	␀␀

TRIGGER R024CPU_EU AFTER UPDATE ON R024CPU FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
l_Alterou BOOLEAN;
l_Valido  BOOLEAN;
l_ProximaData DATE;
l_Where VARCHAR(2000);
l_EstCarStr VARCHAR(4);
l_CodCar VARCHAR(25);
BEGIN
  l_Valor := '';
  l_Alterou := FALSE;
  l_ProximaData := DATETIME(31,12,1900,0,0,0);
  
  SP_VALUPDATE_NUM(:OLD.AcuCar, :NEW.AcuCar, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    SP_CONCATENAR_NUM('ACUCAR', :NEW.AcuCar, l_Valor OUT);
    l_Alterou := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.ConEsp, :NEW.ConEsp, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    SP_CONCATENAR_NUM('CONESP', :NEW.ConEsp, l_Valor OUT);
    l_Alterou := TRUE;
  END IF;

  SP_VALUPDATE_DES(:OLD.DedExc, :NEW.DedExc, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    SP_CONCATENAR_DES('DEDEXC', :NEW.DedExc, l_Valor OUT);
    l_Alterou := TRUE;
  END IF;

  SP_VALUPDATE_DES(:OLD.LeiCar, :NEW.LeiCar, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    SP_CONCATENAR_DES('LEICAR', :NEW.LeiCar, l_Valor OUT);
    l_Alterou := TRUE;
  END IF;

  SP_VALUPDATE_DAT(:OLD.DatLei, :NEW.DatLei, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    SP_CONCATENAR_DAT('DATLEI', :NEW.DatLei, l_Valor OUT);
    l_Alterou := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.SitLei, :NEW.SitLei, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    SP_CONCATENAR_NUM('SITLEI', :NEW.SitLei, l_Valor OUT);
    l_Alterou := TRUE;
  END IF;

  SP_VALUPDATE_NUM(:OLD.SCTpQu, :NEW.SCTpQu, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    SP_CONCATENAR_NUM('SCTPQU', :NEW.SCTpQu, l_Valor OUT);
    l_Alterou := TRUE;
  END IF;

  IF (l_Alterou = TRUE) THEN  
    l_EstCarStr := CONVERT(NUMBER_TO_CHAR, :OLD.ESTCAR);
    l_Where := 'ESTCAR = ' || l_EstCarStr || ' AND CODCAR = ''' || :OLD.CODCAR || '''';
    SP_PROXIMOHIST('DATALT', 'R024CPU', l_Where, :NEW.DATALT, l_ProximaData OUT);
    
    SP_CONCATENAR_NUM('ESTCAR', :NEW.EstCar, l_Valor OUT);
    SP_CONCATENAR_DES('CODCAR', :NEW.CodCar, l_Valor OUT);
    SP_CONCATENAR_DAT('DATALT', :NEW.DatAlt, l_Valor OUT);
    SP_CARGOESOCIAL('R024CPU', :NEW.ESTCAR, :NEW.CODCAR, l_Valor, :NEW.DATALT, l_ProximaData, NULL);
    SP_FUNCAOESOCIAL('R024CPU', :NEW.ESTCAR, :NEW.CODCAR, L_VALOR, :NEW.DATALT, l_ProximaData, NULL);
  END IF;
END␀Ñ␀␀		SENIOR;00␀␀

TRIGGER R024CPU_ED AFTER DELETE ON R024CPU FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
l_ProximaData DATE;
l_Where VARCHAR(2000);
l_EstCarStr VARCHAR(4);
l_CodCar VARCHAR(25);
BEGIN
  l_Valor := '';
  l_ProximaData := DATETIME(31,12,1900,0,0,0); 
  
  l_EstCarStr := CONVERT(NUMBER_TO_CHAR, :OLD.ESTCAR);
  l_Where := 'ESTCAR = ' || l_EstCarStr || ' AND CODCAR = ''' || :OLD.CODCAR || '''';
  SP_PROXIMOHIST('DATALT', 'R024CPU', l_Where, :OLD.DATALT, l_ProximaData OUT);
  
  SP_CONCATENAR_NUM('ESTCAR', :OLD.EstCar, l_Valor OUT);
  SP_CONCATENAR_DES('CODCAR', :OLD.CodCar, l_Valor OUT);
  SP_CARGOESOCIAL('R024CPU', :OLD.ESTCAR, :OLD.CODCAR, l_Valor, :OLD.DATALT, l_ProximaData, NULL);
  SP_FUNCAOESOCIAL('R024CPU', :OLD.ESTCAR, :OLD.CODCAR, L_VALOR, :OLD.DATALT, l_ProximaData, NULL);
