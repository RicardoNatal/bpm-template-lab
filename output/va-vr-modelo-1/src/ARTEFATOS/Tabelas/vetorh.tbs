J␀␀create or replace PROCEDURE SP_R034FUN_HIST_UP(p_seqhis IN NUMBER, p_numemp IN NUMBER,p_tipcol IN NUMBER,p_numcad IN NUMBER,p_depirf IN NUMBER,p_depsaf IN NUMBER, p_tpcpix IN NUMBER, p_chvpix IN VARCHAR2) is
begin
  begin
	UPDATE R038HFB 
	SET 
		depirf = p_depirf, 
		depsaf = p_depsaf,
		tpcpix = p_tpcpix,
		chvpix = p_chvpix
	WHERE numemp = p_numemp
	  AND tipcol = p_tipcol
	  AND numcad = p_numcad
	  AND seqhis = p_seqhis;
  exception
	when OTHERS then
	  raise_application_error(-20000 + -(103),'Erro ao atualizar histórico de alteração da ficha.');
  end;
end;	MSSQL;0
ø␀␀CREATE  PROCEDURE SP_R034FUN_HIST_UP(@p_seqhis bigint, @p_numemp SMALLINT, @p_tipcol SMALLINT, @p_numcad INTEGER, @p_depirf SMALLINT, @p_depsaf SMALLINT,  @p_tpcpix SMALLINT, @p_chvpix VARCHAR(100)) as
BEGIN
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @SE_EXC2 INTEGER
  SELECT @ChkError = 0
	/* TRY */
	  UPDATE r038hfb
    SET 
		depirf = @p_depirf, 
		depsaf = @p_depsaf,
		tpcpix = @p_tpcpix,
		chvpix = @p_chvpix
	WHERE numemp = @p_numemp
	  AND tipcol = @p_tipcol
	  AND numcad = @p_numcad
	  AND seqhis = @p_seqhis
	SELECT @ChkError = @@Error
	IF @ChkError <> 0
	BEGIN
	  GOTO EXC1
	END
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
	EXC1:
	SELECT @SE_EXC1 = @ChkError
	IF @ChkError <> 0
	BEGIN
	  BEGIN
		SELECT @ChkError = 0
		BEGIN
		  RAISERROR('Erro ao atualizar o histórico de alteração da ficha basica.',11,1) WITH SETERROR
		  SELECT @ChkError = -30
		  GOTO FIM
		END
	  END
	END
  /* END EXCEPTION HANDLER */
FIM:
  RETURN @ChkError
END	POSTGRESQL;0
u␀␀create or replace PROCEDURE SP_R034FUN_HIST_UP(p_seqhis bigint, p_numemp SMALLINT,p_tipcol SMALLINT,p_numcad INTEGER,p_depirf SMALLINT,p_depsaf SMALLINT, p_tpcpix SMALLINT, p_chvpix VARCHAR(100))
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN
  begin
	UPDATE R038HFB 
	SET 
		depirf = p_depirf, 
		depsaf = p_depsaf,
		tpcpix = p_tpcpix,
		chvpix = p_chvpix
	WHERE numemp = p_numemp
	  AND tipcol = p_tipcol
	  AND numcad = p_numcad
	  AND seqhis = p_seqhis;
  exception
	when OTHERS then
	  RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'Erro ao atualizar histórico de alteração da ficha básica.';
