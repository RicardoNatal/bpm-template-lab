PROCEDURE SP_LNKCON(P_LNKCON OUT CHAR)
 IS

l_lnkcon     VARCHAR2(31);
BEGIN
  BEGIN
    SELECT R070DAC.LNKCON INTO l_lnkcon FROM R070DAC;
  EXCEPTION WHEN OTHERS THEN
    l_lnkcon := '';
  END;
  IF  (LENGTH(RTRIM(l_lnkcon)) > 0) THEN
       l_lnkcon:='@'||l_lnkcon;
  ELSE l_lnkcon := '';
  END IF;
  p_lnkcon := l_lnkcon;
END␀`ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
