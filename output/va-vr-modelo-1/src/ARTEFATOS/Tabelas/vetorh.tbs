PROCEDURE SP_SINLFH(P_VALSTR VARCHAR2(255),P_RETERR OUT NUMBER(2))
 IS

    l_coderr     NUMBER(2);
    l_count      NUMBER(1);
    l_pos        NUMBER(3);
    l_numCra     VARCHAR2(12);
    l_numCra_Nmb NUMBER;
    l_datIni     DATE;
    l_horIni     NUMBER(4);
    l_horFim     NUMBER(4);
    l_codUsu     NUMBER(10);
    l_datStr     VARCHAR2(16);
    l_datCon     VARCHAR2(25);
    
BEGIN
    /* inicializa variáveis */
    l_codErr := 0;
    p_retErr := 0;
    l_count  := 0;
    l_codUsu := 0;
    
    /* separa os valores da string do p_valStr em cada variável */
	BEGIN
	    l_pos := 3;    
	    L_numCra := SUBSTRING(p_ValStr, l_pos, 12); l_pos := l_pos + 12;
	    l_datStr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
	    
	    /* converte data/hora inicial */
	    l_datCon := SUBSTRING(l_datStr,1,2) || '/' || SUBSTRING(l_datStr,3,2) ||'/'||SUBSTRING(l_datStr,5,2);
	    SP_STRTODATE(l_datCon,'DD/MM/AA', l_datIni OUT);
	    l_horIni := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datStr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datStr,9,2)));
	    
	    l_datStr := SUBSTRING(p_ValStr, l_pos, 16);  l_pos := l_pos + 16;
	
	    /* converte hora final */
	    l_horFim := CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datStr,7,2)))*60 + CONVERT(CHAR_TO_NUMBER,(SUBSTRING(l_datStr,9,2)));
	
	    /* CODUSU */
	    l_codUsu := SUBSTRING(p_ValStr, l_pos, 10); l_pos := l_pos + 10;
    EXCEPTION
        WHEN OTHERS THEN l_coderr := 50; /* erro de conversão na string */
    END;
    
    SP_STRTOINT(l_numCra, l_numCra_Nmb OUT);
    
    /* Verifica se tem registro com a mesma chave */
    IF  (l_coderr = 0) THEN
        /* busca liberação de faixa horaria */
        BEGIN
            SELECT COUNT(*) INTO l_count FROM R070LFH WHERE NUMCRA = l_numCra_Nmb AND DATLIB = l_datIni AND HORINI = l_horIni;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN l_count := 0;
            WHEN OTHERS THEN l_count := 0;
        END;
        
        /* Se possui registro com a mesma chave, atualiza; senao, insere */
        IF (l_count > 0) THEN
            BEGIN
                UPDATE R070LFH SET 
                        HORFIM = l_horFim,
                        CODUSU = l_codUsu
                    WHERE
                        NUMCRA = l_numCra_Nmb AND
                        DATLIB = l_datIni AND
                        HORINI = l_horIni;
            EXCEPTION
                WHEN OTHERS THEN l_coderr := 51;
            END;
        ELSE
            BEGIN
                INSERT INTO R070LFH (NUMCRA, DATLIB, HORINI, HORFIM, OBSLIB, CODUSU)
                    VALUES (l_numCra_Nmb, l_datIni, l_horIni, l_horFim, NULL, l_codUsu);
            EXCEPTION
                WHEN OTHERS THEN l_coderr := 52;
            END;
        END IF;
    END IF;

    /* retorna Código do erro */
    p_retErr := l_codErr;
END		SENIOR;20SP_STRTODATE
