TRIGGER R346IBC_EU BEFORE UPDATE ON R346IBC FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
  l_Alterou BOOLEAN;
  l_Valido BOOLEAN;
  l_JsonCamposAlterados VARCHAR2(2000);
  l_VersaoESocial NUMBER;
  l_DatRef DATE;
  l_isGerarPendencia BOOLEAN;
BEGIN
  l_VersaoESocial := 0;
  l_Valor := '';
  l_JsonCamposAlterados := '';

  SP_GERAR_PEN_S2500(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODPRO, l_isGerarPendencia OUT);
  
  IF (l_isGerarPendencia = TRUE) THEN
    SP_RETDATREF_S2500(:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, :NEW.CodPro, l_DatRef OUT);
    SP_ESOCIAL_S250X(:NEW.NumEmp, l_DatRef, l_VersaoESocial OUT);
    
    SP_VALUPDATE_DAT(:OLD.PERREF, :NEW.PERREF, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_DAT_JSON('PERREF', :NEW.PERREF, :OLD.PERREF, l_JsonCamposAlterados OUT);
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.BCCPMS, :NEW.BCCPMS, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_FLO_JSON('BCCPMS', :NEW.BCCPMS, :OLD.BCCPMS, 2, l_JsonCamposAlterados OUT);
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.BCCP13, :NEW.BCCP13, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_FLO_JSON('BCCP13', :NEW.BCCP13, :OLD.BCCP13, 2, l_JsonCamposAlterados OUT);
    END IF;
    
    IF (l_VersaoESocial = 5) THEN
    	SP_VALUPDATE_NUM(:OLD.BCFGTG, :NEW.BCFGTG, l_Valido OUT);
    	IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_FLO_JSON('BCFGTG', :NEW.BCFGTG, :OLD.BCFGTG, 2, l_JsonCamposAlterados OUT);
    	END IF;
    	
  	SP_VALUPDATE_NUM(:OLD.BCF13G, :NEW.BCF13G, l_Valido OUT);
    	IF (l_Valido = TRUE) THEN
      	l_Alterou := TRUE;
      	SP_CONCAT_FLO_JSON('BCFG13', :NEW.BCF13G, :OLD.BCF13G, 2, l_JsonCamposAlterados OUT);
    	END IF;
    	
    	SP_VALUPDATE_DES(:OLD.PARDIR, :NEW.PARDIR, l_Valido OUT);
    	IF (l_Valido = TRUE) THEN
        l_Alterou := TRUE;
        SP_CONCAT_DES_JSON('PARDIR', :NEW.PARDIR, :OLD.PARDIR, l_JsonCamposAlterados OUT);
      END IF;
    END IF;
  
    IF (l_VersaoEsocial >= 6) THEN
      SP_VALUPDATE_NUM(:OLD.BCFG12, :NEW.BCFG12, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_Alterou := TRUE;
      SP_CONCAT_FLO_JSON('BCFG12', :NEW.BCFG12, :OLD.BCFG12, 2, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_NUM(:OLD.BCFGSE, :NEW.BCFGSE, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_Alterou := TRUE;
      SP_CONCAT_FLO_JSON('BCFGSE', :NEW.BCFGSE, :OLD.BCFGSE, 2, l_JsonCamposAlterados OUT);
      END IF;
      
      SP_VALUPDATE_NUM(:OLD.BCFGES, :NEW.BCFGES, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
        l_Alterou := TRUE;
      SP_CONCAT_FLO_JSON('BCFGES', :NEW.BCFGES, :OLD.BCFGES, 2, l_JsonCamposAlterados OUT);
      END IF;
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.GRAEXP, :NEW.GRAEXP, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_NUM_JSON('GRAEXP', :NEW.GRAEXP, :OLD.GRAEXP, l_JsonCamposAlterados OUT);
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.BCFGTS, :NEW.BCFGTS, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_FLO_JSON('BCFGTS', :NEW.BCFGTS, :OLD.BCFGTS, 2, l_JsonCamposAlterados OUT);
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.BCFG13, :NEW.BCFG13, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_FLO_JSON('BCFG13', :NEW.BCFG13, :OLD.BCFG13, 2, l_JsonCamposAlterados OUT);
    END IF;
    
    SP_VALUPDATE_DES(:OLD.MUDCAT, :NEW.MUDCAT, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_DES_JSON('MUDCAT', :NEW.MUDCAT, :OLD.MUDCAT, l_JsonCamposAlterados OUT);
    END IF;

    SP_VALUPDATE_NUM(:OLD.CODCAT, :NEW.CODCAT, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_NUM_JSON('CODCAT', :NEW.CODCAT, :OLD.CODCAT, l_JsonCamposAlterados OUT);
    END IF;
    
    SP_VALUPDATE_NUM(:OLD.VRBCCP, :NEW.VRBCCP, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_FLO_JSON('VRBCCP', :NEW.VRBCCP, :OLD.VRBCCP, 2, l_JsonCamposAlterados OUT);
    END IF;
    
    IF (l_Alterou = TRUE) THEN  
      SP_CONCATENAR_NUM('CODPRO', :NEW.CODPRO, l_Valor OUT);
      
      SP_E_SOCIAL('S-2500', 'R346IBC', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, l_JsonCamposAlterados, 0, NULL, :NEW.PERREF, 0, 'R346IBC_EU');
    END IF;
  END IF;
END␀Cæ␀␀		SENIOR;0␀␀

