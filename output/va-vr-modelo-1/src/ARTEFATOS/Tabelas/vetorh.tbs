31/12/1900Tw·␀„›␀␀␀␀␀[yıw;zì*␀␀Æÿ␀␀ÿ01Ÿ␀␀±␀„›␀␀␀␀␀Ã¾␀␀:Ÿ␀␀;Ÿ␀␀q␀Æÿ␀␀ÿ000‹[±␀„›␀␀␀␀␀ŸÌ␀␀û[û[q␀␀Æÿ␀␀ÿ␀<9Ì␀„›␀␀␀␀␀A@c9c9{␀␀Æÿ␀␀xá␀␀␀·-´␀„›␀␀␀␀␀¹BíBíBr␀␀Æÿ␀␀¤á␀␀␀␀␀␀0yá␀␀		SENIOR;0s␀␀TRIGGER R128CUA_EU AFTER UPDATE ON R128CUA FOR EACH ROW

DECLARE
  l_CurApePadrao   R000ASS.CUADEF%TYPE;
  l_DthCan NUMBER(14,6);
BEGIN
  BEGIN
    /* Busca o curso de aperfeiçoamento padrão definido nos assinalamentos diversos - R000ASS */
    SELECT IFNULL(CUADEF, 0) INTO l_CurApePadrao FROM R000ASS;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao ler R000ASS';
  END;

  /* Se NÃO é Curso Padrão E efetuou alteração no Nome do Curso deve Atualizar    */    
  /* o Nome do Curso na tabela R122CCR e R124HCR    */
  IF (l_CurApePadrao <> :NEW.CODCUA) AND
     (:OLD.NOMCUA <> :NEW.NOMCUA) THEN
    /* Utilizada tabela _AUX para controle, pois os UPDATES abaixo disparam triggers
       que fazem SELECT para o mesmo registro da tabela R128CUA e isso gera erro.
       A _AUX irá servir como flag de controle, indicando que o update foi chamado
       via trigger R128CUA e sendo assim, não é precisa executar as rotinas das
       demais triggers.                                                              */
    BEGIN
      INSERT INTO R128CUA_AUX (CODCUA,CODTCE)
                       VALUES (:NEW.CODCUA,:NEW.CODTCE);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao inserir na R128CUA_AUX';
    END;

    BEGIN
      UPDATE R122CCR
         SET NOMCUA = :NEW.NOMCUA
       WHERE CODCUA = :NEW.CODCUA;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar a tabela R122CCR';
    END;

    BEGIN
      UPDATE R124HCR
         SET NOMCUA = :NEW.NOMCUA
       WHERE CODCUA = :NEW.CODCUA;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar a tabela R124HCR';
    END;

    BEGIN
      UPDATE R033HAP
         SET NOMCUA = :NEW.NOMCUA
       WHERE CODCUA = :NEW.CODCUA;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar a tabela R033HAP';
    END;

    BEGIN
      DELETE FROM R128CUA_AUX;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao excluir R128CUA_AUX';
    END;
	
	SP_DATETIME(l_DthCan OUT);
	
	BEGIN
	  UPDATE R122CCO SET DTHCAN = l_DthCan WHERE SEQCCO IN (SELECT
        SEQCCO
      FROM
        r122cco r122cco
      WHERE
        numemp = 0
      AND tipcol = 0
      AND numcad = 0
      AND numcan IN (
        SELECT
            numcan
        FROM
            r122ccr
        WHERE
            codcua = :NEW.CODCUA
      ));
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar candidatos R122CCO';
    END;
	
	BEGIN
      UPDATE R122CCO
	  SET DTHCAN = l_DthCan
		WHERE numcan = 0
		AND EXISTS (
			SELECT 1
			FROM R124HCR 
			WHERE R124HCR.codcua = :NEW.CODCUA
			AND R122CCO.numemp = R124HCR.numemp
			AND R122CCO.tipcol = R124HCR.tipcol
			AND R122CCO.numcad = R124HCR.numcad
		);
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar colaboradores R122CCO';
    END;
	
	
  END IF;
