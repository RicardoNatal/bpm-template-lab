/* CURSOR c/ os registros gravados no R064EXT_AUX */
  CURSOR c_r064ext_del IS SELECT NUMEMP,TIPCOL,NUMCAD FROM R064EXT_AUX;
  TYPE t_r064ext_aux IS RECORD(
    NUMEMP   R064EXT_AUX.NUMEMP%TYPE,
    TIPCOL   R064EXT_AUX.TIPCOL%TYPE,
    NUMCAD   R064EXT_AUX.NUMCAD%TYPE);
  l_r064ext_aux t_r064ext_aux;

BEGIN
   /* Le Registro do CURSOR */
   FOREACH c_r064ext_del INTO  l_r064ext_aux.NUMEMP,
                               l_r064ext_aux.TIPCOL,
                               l_r064ext_aux.NUMCAD
   LOOP
     R064EXT_FH(l_r064ext_aux.NUMEMP, l_r064ext_aux.TIPCOL, l_r064ext_aux.NUMCAD);
   END LOOP;
   /* Apaga Registro OLD em R064EXT_AUX */
   BEGIN
     DELETE FROM R064EXT_AUX;
     DROP_TEMP_TABLE R064EXT_AUX;
   EXCEPTION WHEN OTHERS THEN
     NULL;
   END;
END␀›Ø␀␀		SENIOR;0 ␀␀

