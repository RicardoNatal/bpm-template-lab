  l_crefx1      CHAR(2);
  l_fx1         CHAR(8);
  l_crefx2      CHAR(2);
  l_fx2         CHAR(8);
  l_crefx3      CHAR(2);
  l_fx3         CHAR(8);
  l_crefx4      CHAR(2);
  l_fx4         CHAR(8);
  l_crefx5      CHAR(2);
  l_fx5         CHAR(8);
  l_crefx6      CHAR(2);
  l_fx6         CHAR(8);

  CURSOR c_r070CRO IS
       SELECT INIFAI,FIMFAI,SALATU
         FROM R070CRO
        WHERE R070CRO.NUMEMP = p_numemp
          AND R070CRO.NUMCAD = p_numcad
          AND R070CRO.DATINI <= l_data_atual
          AND (R070CRO.DATFIM = l_data_zero OR R070CRO.DATFIM > l_data_atual OR R070CRO.DATFIM = l_data_atual)
          AND R070CRO.VERPLF = l_verplf
          AND R070CRO.CODPLF = l_codplf;

  TYPE t_r070CRO IS RECORD(
    INIFAI   R070CRO.INIFAI%TYPE,
    FIMFAI   R070CRO.FIMFAI%TYPE,
    SALATU   R070CRO.SALATU%TYPE);
  l_r070CRO t_r070CRO;


BEGIN
  /* Inicializa */
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_zero  := '31/12/1900,00:00:00';

  /*Busca versão do plano ativa*/
  l_codplf := 0;
  BEGIN
      SELECT VERPLF INTO l_verplf
        FROM R058VPL
       WHERE DATCRI <= l_data_atual
         AND (DATEXT = l_data_zero OR DATEXT > l_data_atual);
  EXCEPTION
      WHEN OTHERS THEN
          l_verplf := 1;
  END;

  l_crefx1 := '00';
  l_fx1 := '24002400';
  l_crefx2 := '00';
  l_fx2 := '24002400';
  l_crefx3 := '00';
  l_fx3 := '24002400';
  l_crefx4 := '00';
  l_fx4 := '24002400';
  l_crefx5 := '00';
  l_fx5 := '24002400';
  l_crefx6 := '00';
  l_fx6 := '24002400';

  FOREACH c_r070CRO INTO  l_r070CRO.inifai,
                          l_r070CRO.fimfai,
                          l_r070CRO.salatu
  LOOP
     SP_INTSTR(l_r070CRO.inifai,'HHMM',l_inifai OUT);
     SP_INTSTR(l_r070CRO.fimfai,'HHMM',l_fimfai OUT);

     IF (l_r070CRO.salatu > 0) THEN
        SP_INTSTR(l_r070CRO.salatu,'99',l_salatu OUT);
