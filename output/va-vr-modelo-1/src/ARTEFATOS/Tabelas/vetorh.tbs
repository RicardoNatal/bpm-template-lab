DECLARE
  l_VersaoESocial NUMBER;
  l_SimplificaoESocial BOOLEAN;
  l_infoFacult BOOLEAN;
  l_Valor VARCHAR2(2000);
  l_Valido  BOOLEAN; 
  l_dataReferencia DATE;
  l_LayoutOrigem VARCHAR2(6);
  l_AlterouInfoCadastral BOOLEAN;
BEGIN
  l_VersaoESocial := 0;
  l_SimplificaoESocial := FALSE;
  l_infoFacult := FALSE;
  l_Valor := '';
  l_Valido := FALSE; 
  l_dataReferencia := CURDATE();
  l_layoutOrigem := '';
  l_AlterouInfoCadastral := FALSE;

  RH_LAYOUTCOLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutOrigem OUT);
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);

  
  IF (l_layoutOrigem IS NOT NULL) THEN
  
      /* Matr?cula do funcion?rio na anota??o judicial */
      SP_VALUPDATE_DES(:OLD.MANTJD, :NEW.MANTJD, l_Valido OUT);
      IF (l_layoutOrigem = 'S-2200') AND (l_Valido = TRUE) AND (l_VersaoESocial >= 6) THEN
	     SP_CONCATENAR_DES('MANTJD', :NEW.MANTJD, l_Valor OUT);
	     l_AlterouInfoCadastral := TRUE;
      END IF;
    
     /* Tipo de admiss?o do trabalhador */
     SP_VALUPDATE_NUM(:OLD.ADMESO, :NEW.ADMESO, l_Valido OUT);
     IF (l_Valido = TRUE) AND (l_layoutOrigem = 'S-2200') THEN
         SP_CONCATENAR_NUM('ADMESO', :NEW.ADMESO, l_Valor OUT);
         l_AlterouInfoCadastral := TRUE;
     END IF;

     /* Indicativo de admiss?o  */ 
     SP_VALUPDATE_NUM(:OLD.INDADM, :NEW.INDADM, l_Valido OUT);
     IF (l_Valido = TRUE) AND (l_layoutOrigem = 'S-2200') THEN
         SP_CONCATENAR_NUM('INDADM', :NEW.INDADM, l_Valor OUT);
         l_AlterouInfoCadastral := TRUE;
     END IF; 
  
      /* C?digo da categoria eSocial de origem do trabalhador  */ 
      SP_VALUPDATE_NUM(:OLD.CATANT, :NEW.CATANT, l_Valido OUT);
      IF (l_Valido = TRUE) AND (l_layoutOrigem = 'S-2300')THEN
          SP_CONCATENAR_NUM('CATANT', :NEW.CATANT, l_Valor OUT);
          l_AlterouInfoCadastral := TRUE;
      END IF;

      /* Data de Admiss?o nesta Empresa  */
      SP_VALUPDATE_DAT(:OLD.DATADM, :NEW.DATADM, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
            SP_CONCATENAR_DAT('DATADM', :NEW.DATADM, l_Valor OUT);
			l_AlterouInfoCadastral := TRUE;
      END IF;

      /* Matr?cula do trabalhador na empresa que deu origem ao v?nculo trabalhista  */
      SP_VALUPDATE_DES(:OLD.MATANT, :NEW.MATANT, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
            SP_CONCATENAR_DES('MATANT', :NEW.MATANT, l_Valor OUT);
			l_AlterouInfoCadastral := TRUE;
      END IF;

      /* Data de in?cio do v?nculo trabalhista  */
      SP_VALUPDATE_DAT(:OLD.ADMANT, :NEW.ADMANT, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
            SP_CONCATENAR_DAT('ADMANT', :NEW.ADMANT, l_Valor OUT);
			l_AlterouInfoCadastral := TRUE;
      END IF;

      /* N?mero de inscri??o do empregador anterior  */
      SP_VALUPDATE_NUM(:OLD.CNPJAN, :NEW.CNPJAN, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
            SP_CONCATENAR_NUM('CNPJAN', :NEW.CNPJAN, l_Valor OUT);
			l_AlterouInfoCadastral := TRUE;
      END IF;

      /* Tipo de inscri??o do empregador anterior  */      
	  SP_VALUPDATE_NUM(:OLD.TINANT, :NEW.TINANT, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
            SP_CONCATENAR_NUM('TINANT', :NEW.TINANT, l_Valor OUT);
			l_AlterouInfoCadastral := TRUE;
      END IF;
      
      /* Data admissão Judicial  */      
	  SP_VALUPDATE_DAT(:OLD.DATJUD, :NEW.DATJUD, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
            SP_CONCATENAR_DAT('DATJUD', :NEW.DATJUD, l_Valor OUT);
			l_AlterouInfoCadastral := TRUE;
      END IF;
      
      /* Numero do processo  */      
	  SP_VALUPDATE_NUM(:OLD.ADMPRO, :NEW.ADMPRO, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
            SP_CONCATENAR_NUM('ADMPRO', :NEW.ADMPRO, l_Valor OUT);
			l_AlterouInfoCadastral := TRUE;
      END IF;
      
      /* Numero do recibo  */      
	  SP_VALUPDATE_DES(:OLD.NUMREC, :NEW.NUMREC, l_Valido OUT);
      IF (l_Valido = TRUE) THEN
            SP_CONCATENAR_DES('NUMREC', :NEW.NUMREC, l_Valor OUT);
			l_AlterouInfoCadastral := TRUE;
      END IF;
      
  END IF;
  
  
  IF (l_AlterouInfoCadastral = TRUE) THEN
  	     SP_E_SOCIAL(l_layoutOrigem, 'R034ADM', 'N', 'A', :NEW.DATADM, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, l_dataReferencia, 0, 'R034ADM_AU');
  END IF;

