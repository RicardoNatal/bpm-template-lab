!␀␀PROCEDURE SP_BLOQSAD(P_TIPOPE CHAR,P_CODFIL NUMBER)
 IS

l_crastr CHAR(12);
   l_codfil CHAR(9);
   l_utitsi CHAR(1);

   l_Straux             VARCHAR2(2047);
   l_gersen             BOOLEAN;
   l_data_atual         DATE;
   l_hora_atual         NUMBER(4);
   l_seqenv             NUMBER(2);
   l_datstr             CHAR(6);
   l_horstr             CHAR(4);
   l_seqstr             CHAR(2);
   l_datenv             CHAR(16);
BEGIN

  /* verifica se existe as tabelas da Telemática para controle do SAD*/
  l_utitsi := 'N';
  BEGIN
      SELECT BLQSAD INTO l_utiTsi FROM R070TSI;
  EXCEPTION
      WHEN OTHERS THEN l_utiTsi := 'N';
  END;

  IF (l_utiTsi = 'S') THEN

      SP_INTSTR(p_codfil,'999999999',l_codfil OUT);

      /* Apaga os registros antes de inserir */
      BEGIN
          ExecSql('DELETE FROM BLOQSAD WHERE SAD = '||l_codfil);
      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;

      IF   p_tipope = 'I' THEN
         /* Tenta inserir. se ja existir ignorar. */
         BEGIN
             ExecSql('INSERT INTO BLOQSAD (SAD,BLOQUEADO) VALUES ('''||l_codfil||''',''1'')');
         EXCEPTION
             WHEN DUPVALONINDEX THEN NULL;
         END;
      END IF;
  END IF;

  /* Envia pendência para Digicon */
  SP_GERSEN(l_gersen OUT);
  IF  (l_gersen = TRUE) THEN
      /* Monta data/hora de envio da pendência.*/
      l_data_atual := CURDATE();
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
      SP_INTSTR(l_hora_atual,'HHMM',l_horstr OUT);
      l_seqenv := SECOND(CURTIME());
      SP_INTSTR(l_seqenv, '99', l_seqstr OUT);
      l_datenv := l_datstr||l_horstr||l_seqstr||'0000';

      l_StrAux := '67'||l_datenv;
      SP_PorCom(l_StrAux, '0');
  END IF;
END		SENIOR;21,SP_GERSEN
SP_DATSTR
SP_INTSTR
SP_PORCOM
