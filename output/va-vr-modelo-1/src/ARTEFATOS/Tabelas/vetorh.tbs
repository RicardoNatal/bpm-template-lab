"␀␀/* Troca caracteres acentuados pelo o mesmo sem acento e deleta carateres especiais*/
PROCEDURE SP_STRTOSTR(P_VALOR VARCHAR2(255),P_RET OUT VARCHAR2(255))
 IS

l_ret    VARCHAR2(200);
 l_CarEsp VARCHAR2(200);
 l_CarTro VARCHAR2(200);
 i NUMBER(4);
 j NUMBER(4);

BEGIN
  l_CarEsp := '-áàãâäªÁÀÃÂÄéèêÊÉÈíìîÎÍÌóòöõôºøØÓÒÖÕÔúùüûÛÚÙÜçÇñÑ<>!@#$%¨&*()_+={}[]?;:|*"~^´`¨æÆ£’¿®½¼ßµşıİ'||'''';
  l_CarTro := ' aaaaaaAAAAAeeeEEEiiiiIIoooooooOOOOOOuuuuUUUUcCnN                                 F       yY ';
  l_ret := p_valor;
  IF (LENGTH(p_valor) > 0) THEN
      BEGIN
          FOR i IN 1 .. (LENGTH(l_CarEsp)) LOOP
              FOR j IN 1 .. (LENGTH(p_valor)) LOOP
                  IF (SUBSTRING(p_valor,j,1) = SUBSTRING(l_CarEsp,i,1)) THEN
                      l_ret := SUBSTRING(l_ret,1, j-1) || SUBSTRING(l_cartro,i,1) || SUBSTRING(l_ret,j+1,LENGTH(l_ret));
                  END IF;
              END LOOP;
          END LOOP;
      EXCEPTION WHEN OTHERS THEN
          p_ret := p_valor;
      END;
  END IF;
  p_ret := l_ret;
END		SENIOR;23
"␀␀/* Troca caracteres acentuados pelo o mesmo sem acento e deleta carateres especiais*/
