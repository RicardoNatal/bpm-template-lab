DECLARE
l_online      BOOLEAN;
BEGIN
    SP_VerOnLine(l_online OUT);
    IF (l_online = TRUE) THEN
        SP_CANCON (:NEW.DATENT, :NEW.HORENT, :NEW.NUMCAN, :NEW.NUMCRA, :NEW.CODPRM, :NEW.DATVAL, :NEW.HORVAL);
    END IF;
END␀ˆİ␀␀		SENIOR;0R␀␀

TRIGGER R091MCA_EU AFTER UPDATE ON R091MCA FOR EACH ROW

DECLARE
l_online       BOOLEAN;
BEGIN
SP_VerOnLine(l_online OUT);
IF   (l_online = TRUE) THEN
   SP_ATUCON (:NEW.NUMCRA,:NEW.CODPRM,:OLD.CODPRM,:NEW.DATVAL,
               :NEW.HORVAL,:OLD.DATVAL,:OLD.HORVAL,:NEW.DATSAI,
               :NEW.HORSAI,NULL);
END IF;
END␀†İ␀␀		SENIOR;0j␀␀

TRIGGER R091MCA_ED AFTER DELETE ON R091MCA FOR EACH ROW

DECLARE
l_data_zero    DATE;
  l_online       BOOLEAN;
BEGIN
SP_VerOnLine(l_online OUT);
IF   (l_online = TRUE)
AND  (:OLD.NUMCRA <> 0) THEN
     l_data_zero := '31/12/1900,00:00:00';
     IF   :OLD.DATSAI = l_data_zero THEN
          AtuSitCra('1',:OLD.NUMCRA);
