          begin
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DATINI',l_datiniSTR);
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'HORINI',l_horiniSTR);
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'NUMCRA',l_numcraSTR);
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'VIACRA','0');
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'DATFIM',l_datfimSTR);
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'HORFIM',l_horfimSTR);
            INSERT INTO R995PRT (CODRPA,NAMPPA,CONPPA) VALUES  (l_codrpa,'RECEPR','');
