          /* END EXCEPTION HANDLER */
        END
      END
    END
  END
  IF (@p_tipope=1)
  BEGIN
    SELECT @l_temAud = 0
    /* TRY */
      SELECT
      @l_temAud=COUNT(*)
       FROM r995cte r995cte
       WHERE codcpa=6
      and codtpa=98
      SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
      IF @ChkError <> 0

      BEGIN
        GOTO EXC6
      END
    /* END TRY */
    /* BEGIN EXCEPTION HANDLER */
      EXC6:
      SELECT @SE_EXC6 = @ChkError
      IF @ChkError <> 0
      BEGIN
        BEGIN
          SELECT @ChkError = 0
          SELECT @l_coderr = 1
        END
