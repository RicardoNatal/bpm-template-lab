QL_VERREGEXI
QL_ATUREGEFE
zL␀␀/* Atualiza dos dados do Quadro Efetivo conforme histórico do Colaborador
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aTabOrg - Organograma novo
   aLocCcu - Local/Centro Custo novo
   aEstCar - Estrut. nova
   aCodCar - Cargo novo
   aCodEsc - Escala/Horário Novo
   aTipSit - Situação nova
   aPerIni - Período Inicial para atualizar Quadro
   aPerFim - Período Final para atualizar Quadro
   aQtdVag - Qtd. de vagas para atualizar
   aNCDatAlt - Data a não ser considerada
   aNCTabOrg - Organograma a não ser considerado
   aNCLocCcu - Local/Centro Custo a não ser considerado
   aNCEstCar - Estrutura a não ser considerada
   aNCCodCar - Cargo a não ser considerado
   aNCCodEsc - Escala/Horário a não ser considerado
   aNCTipSit - Situação de Afast. a não ser considerada
   aNCDatTer - Data de Término do Afast. a não ser considerada */
PROCEDURE QL_ATUQUAEFE(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ATABORG NUMBER(4),ALOCCCU VARCHAR2(18),AESTCAR NUMBER(4),ACODCAR VARCHAR2(25),ACODESC NUMBER(9),ATIPSIT NUMBER(3),ACODVIN NUMBER(2),APERINI DATE,APERFIM DATE,AQTDVAG NUMBER(4),AINCLUSAO VARCHAR2(1),AALTFILIAL VARCHAR2(1),ANCDATALT DATE,ANCTABORG NUMBER(4),ANCLOCCCU VARCHAR2(18),ANCESTCAR NUMBER(4),ANCCODCAR VARCHAR2(25),ANCCODESC NUMBER(9),ANCTIPSIT NUMBER(3),ANCCODVIN NUMBER(2),ANCDATTER DATE)
 IS

xAntDatLoc   R038HLO.DATAlT%TYPE;
  xAntTabOrg   R038HLO.TABORG%TYPE;
  xAntLocCcu   R038HCC.CODCCU%TYPE;
  xAntNumLoc   R038HLO.NUMLOC%TYPE;
  xNCNumLoc   R038HLO.NUMLOC%TYPE;

  xAntDatCar   R038HCA.DATALT%TYPE;
  xAntEstCar   R038HCA.ESTCAR%TYPE;
  xAntCodCar   R038HCA.CODCAR%TYPE;

  xAntDatFil   R038HFI.DATALT%TYPE;
  xEmpFilAtu   R038HFI.EMPATU%TYPE;
  xCodFilAtu   R038HFI.CODFIL%TYPE;

  xAntDatTur   R038HES.DATALT%TYPE;
  xAntCodEsc   R038HES.CODESC%TYPE;

  xAntDatAfa   R038AFA.DATAFA%TYPE;
  xAntTipSit   R010SIT.TIPSIT%TYPE;

  xAntDatVin   R038HVI.DATALT%TYPE;
  xAntCodVin   R038HVI.CODVIN%TYPE;
  xAntTipVag   R022VAG.TIPVAG%TYPE;

  xDatAnt   R038HLO.DATAlT%TYPE;
  xPrxDat   R038HLO.DATAlT%TYPE;
  xVagAfa NUMBER(4);
  xAntTipTur   R006ESC.TURESC%TYPE;

  xTmpDat DATE;
  xUltDat DATE;
  xRegExi NUMBER(1);
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
  xTipVag NUMBER(2);

  xAtualizouEfe NUMBER(1);

  CURSOR c_Histor_sel IS
    SELECT DATALT DATALT, 'LOCAL' TIPALT, TABORG TABORG, CONVERT(NUMBER_TO_CHAR, NUMLOC) LOCCCU,      0 ESTCAR, ' '    CODCAR, ' '    CARVAG,      0 CODESC, 0 TIPSIT, 0 CODVIN, 0 TIPVAG FROM R038HLO
     WHERE NUMEMP = aNumEmp AND TIPCOL = aTipCol AND NUMCAD = aNumCad AND DATALT >= aPerIni AND DATALT < aPerFim
       AND DATALT <> aNCDatAlt AND ((TABORG <> aNCTabOrg) OR (NUMLOC <> xNCNumLoc)) AND xCtlQua = 0
    UNION
   (SELECT DATALT DATALT, 'CUSTO' TIPALT,      0 TABORG,   CODCCU LOCCCU,      0 ESTCAR, ' '    CODCAR, ' '    CARVAG,      0 CODESC, 0 TIPSIT,      0 CODVIN, 0 TIPVAG FROM R038HCC
     WHERE NUMEMP = aNumEmp AND TIPCOL = aTipCol AND NUMCAD = aNumCad AND DATALT >= aPerIni AND DATALT < aPerFim
       AND DATALT <> aNCDatAlt AND (CODCCU <> aNCLocCcu) AND xCtlQua = 1
    UNION
   (SELECT DATALT DATALT, 'CARGO' TIPALT,      0 TABORG,      ' ' LOCCCU, ESTCAR ESTCAR, CODCAR CODCAR, CARVAG CARVAG,      0 CODESC, 0 TIPSIT,      0 CODVIN, 0 TIPVAG FROM R038HCA
     WHERE NUMEMP = aNumEmp AND TIPCOL = aTipCol AND NUMCAD = aNumCad AND DATALT >= aPerIni AND DATALT < aPerFim
       AND DATALT <> aNCDatAlt AND ((ESTCAR <> aNCEstCar) OR (CODCAR <> aNCCodCar))
    UNION
   (SELECT R038HVI.DATALT DATALT, 'VINCULO' TIPALT,    0 TABORG,      ' ' LOCCCU,      0 ESTCAR, ' '    CODCAR, ' '    CARVAG,      0 CODESC, 0 TIPSIT, R038HVI.CODVIN CODVIN, R022VIN.TIPVAG TIPVAG FROM R038HVI, R022VIN
     WHERE R038HVI.NUMEMP = aNumEmp AND R038HVI.TIPCOL = aTipCol AND R038HVI.NUMCAD = aNumCad AND R038HVI.DATALT >= aPerIni AND R038HVI.DATALT < aPerFim AND R022VIN.CODVIN = R038HVI.CODVIN
       AND R038HVI.DATALT <> aNCDatAlt AND (R038HVI.CODVIN <> aNCCodVin) AND xConTpV = 'S'
    UNION
   (SELECT DATALT DATALT, 'FILIAL' TIPALT,     0 TABORG,      ' ' LOCCCU,      0 ESTCAR, ' '    CODCAR, ' '    CARVAG,      0 CODESC, 0 TIPSIT,      0 CODVIN, 0 TIPVAG FROM R038HFI
     WHERE NUMEMP = aNumEmp AND TIPCOL = aTipCol AND NUMCAD = aNumCad AND DATALT >= aPerIni AND DATALT < aPerFim
       AND DATALT <> aNCDatAlt
       AND NOT EXISTS(SELECT 1 FROM R038HFI HFI2
                       WHERE HFI2.NUMEMP = aNumEmp AND HFI2.TIPCOL = aTipCol AND HFI2.NUMCAD = aNumCad AND HFI2.DATALT < R038HFI.DATALT)
       AND aAltFilial <> 'S'
    UNION
   (SELECT DATALT DATALT, 'TURNO' TIPALT,      0 TABORG,      ' ' LOCCCU,      0 ESTCAR, ' '    CODCAR, ' '    CARVAG, CODESC CODESC, 0 TIPSIT,      0 CODVIN, 0 TIPVAG FROM R038HES, R030EMP
     WHERE R038HES.NUMEMP = aNumEmp AND TIPCOL = aTipCol AND NUMCAD = aNumCad AND DATALT >= aPerIni AND DATALT < aPerFim
       AND DATALT <> aNCDatAlt AND CODESC <> aNCCodEsc AND R030EMP.NUMEMP = aNumEmp AND R030EMP.ESCHOR = 'S' AND xUsaTur = 'S'
    UNION
   (SELECT DATALT DATALT, 'TURNO' TIPALT,      0 TABORG,      ' ' LOCCCU,      0 ESTCAR, ' '    CODCAR, ' '    CARVAG, HORBAS CODESC, 0 TIPSIT,      0 CODVIN, 0 TIPVAG FROM R038HES, R030EMP
     WHERE R038HES.NUMEMP = aNumEmp AND TIPCOL = aTipCol AND NUMCAD = aNumCad AND DATALT >= aPerIni AND DATALT < aPerFim
       AND DATALT <> aNCDatAlt AND HORBAS <> aNCCodEsc AND R030EMP.NUMEMP = aNumEmp AND R030EMP.ESCHOR = 'N' AND xUsaTur = 'S'
    UNION
   (SELECT DATAFA DATALT, 'AFA_INI' TIPALT,    0 TABORG,      ' ' LOCCCU,      0 ESTCAR, ' '    CODCAR, ' '    CARVAG, 0      CODESC, SIT.TIPSIT TIPSIT,      0 CODVIN, 0 TIPVAG FROM R038AFA, R010SIT SIT
     WHERE NUMEMP = aNumEmp AND TIPCOL = aTipCol AND NUMCAD = aNumCad AND DATAFA <> DATTER AND DATAFA >= aPerIni AND DATAFA < aPerFim
       AND DATAFA <> aNCDatAlt AND DATAFA <> aNCDatTer AND SIT.TIPSIT <> aNCTipSit AND SIT.CODSIT = R038AFA.SITAFA AND (SIT.AFAQUA = 'S' OR SIT.TIPSIT=7)
    UNION
   (SELECT DATETIMEADD(DD, 1, DATTER) DATALT, 'AFA_FIM' TIPALT,    0 TABORG,      ' ' LOCCCU,      0 ESTCAR, ' '    CODCAR, ' '    CARVAG, 0      CODESC, 0      TIPSIT,      0 CODVIN, 0 TIPVAG FROM R038AFA, R010SIT SIT
     WHERE NUMEMP = aNumEmp AND TIPCOL = aTipCol AND NUMCAD = aNumCad AND DATAFA <> DATTER AND DATTER >= aPerIni AND DATTER <= aPerFim
       AND ((DATTER <> aNCDatAlt AND DATTER <> aNCDatTer) OR SIT.TIPSIT <> aNCTipSit) AND SIT.CODSIT = R038AFA.SITAFA AND (SIT.AFAQUA = 'S' OR SIT.TIPSIT=7)
       AND NOT EXISTS (SELECT 1 FROM R038AFA AFA3, R010SIT SIT1
                        WHERE AFA3.NUMEMP = aNumEmp AND AFA3.TIPCOL = aTipCol AND AFA3.NUMCAD = aNumCad
                          AND AFA3.DATAFA = R038AFA.DATTER AND SIT1.CODSIT = AFA3.SITAFA AND SIT1.TIPSIT = 7)))))))))
  ORDER BY DATALT;

  TYPE t_Histor_aux IS RECORD(
      DATALT   R038HLO.DATALT%TYPE,
      TIPALT VARCHAR2(15),
      TABORG   R038HLO.TABORG%TYPE,
      LOCCCU   R038HCC.CODCCU%TYPE,
      ESTCAR   R038HCA.ESTCAR%TYPE,
      CODCAR   R038HCA.CODCAR%TYPE,
      CARVAG   R038HCA.CARVAG%TYPE,
      CODESC   R038HES.CODESC%TYPE,
      TIPSIT   R010SIT.TIPSIT%TYPE,
      CODVIN   R038HVI.CODVIN%TYPE,
      TIPVAG   R022VAG.TIPVAG%TYPE
      );

  xHistor_aux t_Histor_aux;
  xIndCar   R000ASS.INDCAR%TYPE;
  xCodCarCURSOR   R038HCA.CODCAR%TYPE;
BEGIN
  /* Verifica se é para atualizar o Quadro Efetivo. */
  QL_RETATUQUA(aNumEmp, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);

  xUltDat := '04/06/2080,00:00:00';
  xAntDatVin := '31/12/1900,00:00:00';
  xAntDatTur := '31/12/1900,00:00:00';
  xAntDatCar := '31/12/1900,00:00:00';
  xAntDatLoc := '31/12/1900,00:00:00';
  xAntTabOrg := 0;

  /* Seta Local que não é para ser considerado */
  IF (aNCLocCcu = ' ') OR (xCtlQua = 1) THEN
    xNCNumLoc := 0;
  ELSE
    xNCNumLoc := CONVERT(CHAR_TO_NUMBER, aNCLocCcu);
  END IF;

  /* Quadro por Local */
  IF (xCtlQua = 0) THEN
    /* Se foi passado o Local em branco busca o anterior e se não encontrar busca o Próximo */
    IF (aLocCcu = ' ') THEN
      QL_RETLOCANT(aNumEmp, aTipCol, aNumCad, aPerIni, xAntDatLoc OUT, xAntTabOrg OUT, xAntNumLoc OUT, aNCDatAlt, aNCTabOrg, xNCNumLoc);
      IF (xAntNumLoc = 0) THEN
        QL_RETPROLOC(aNumEmp, aTipCol, aNumCad, aPerIni, xAntDatLoc OUT, xAntTabOrg OUT, xAntNumLoc OUT, aNCDatAlt, aNCTabOrg, xNCNumLoc);
      END IF;

      /* Retorna no Local no nível do Quadro */
      QL_RETLOCNIV(xAntTabOrg, xAntNumLoc, xAntDatLoc, xAntNumLoc OUT);
    ELSE
      xAntTabOrg := aTabOrg;
      xAntNumLoc := CONVERT(CHAR_TO_NUMBER, aLocCcu);

      /* Retorna no Local no nível do Quadro */
      QL_RETLOCNIV(xAntTabOrg, xAntNumLoc, aPerIni, xAntNumLoc OUT);
    END IF;

    IF (xAntNumLoc = 0) THEN
      xAntLocCcu := ' ';
    ELSE
      xAntLocCcu := CONVERT(NUMBER_TO_CHAR, xAntNumLoc);
    END IF;
  ELSE
    /* Se foi passado o Centro de Custo em branco busca o anterior e se não encontrar busca o Próximo */
    IF (aLocCcu = ' ') THEN
      QL_RETCCUANT(aNumEmp, aTipCol, aNumCad, aPerIni, xAntDatLoc OUT, xAntLocCcu OUT, aNCDatAlt, aNCLocCcu);
      IF (xAntLocCcu = ' ') THEN
        QL_RETPROCCU(aNumEmp, aTipCol, aNumCad, aPerIni, xAntDatLoc OUT, xAntLocCcu OUT, aNCDatAlt, aNCLocCcu);
      END IF;
    ELSE
      xAntLocCcu := aLocCcu;
    END IF;
  END IF;

  /* Retorna o Cargo Anterior, se não foi passado como parâmetro */
  IF (aCodCar = ' ') THEN
    QL_RETCARANT(aNumEmp, aTipCol, aNumCad, aPerIni, xAntDatCar OUT, xAntEstCar OUT, xAntCodCar OUT, aNCDatAlt, aNCEstCar, aNCCodCar);
    IF (xAntCodCar = ' ') THEN
      QL_RETPROCAR(aNumEmp, aTipCol, aNumCad, aPerIni, xAntDatCar OUT, xAntEstCar OUT, xAntCodCar OUT, aNCDatAlt, aNCEstCar, aNCCodCar);
    END IF;
  ELSE
    xAntEstCar := aEstCar;
    xAntCodCar := aCodCar;
  END IF;

  /* Retorna a Filial na data da alteração */
  QL_RETFILANT(aNumEmp, aTipCol, aNumCad, aPerIni, xAntDatFil OUT, xEmpFilAtu OUT, xCodFilAtu OUT, aNCDatAlt, 0, 0);

  /* Retorna o Turno Anterior (Quando usa Turno no QL), se não foi passado como parâmetro */
  IF (xUsaTur = 'S') THEN
    IF (aCodEsc = 0) THEN
      QL_RETESCANT(aNumEmp, aTipCol, aNumCad, aPerIni, xAntDatTur OUT, xAntCodEsc OUT, aNCDatAlt, aNCCodEsc);
      IF (xAntCodEsc = 0) THEN
        QL_RETPROESC(aNumEmp, aTipCol, aNumCad, aPerIni, xAntDatTur OUT, xAntCodEsc OUT, aNCDatAlt, aNCCodEsc);
      END IF;
    ELSE
      xAntCodEsc := aCodEsc;
    END IF;
  ELSE
    xAntCodEsc := 1;
  END IF;

  /* Retorna a Situação Anterior, se não foi passada como parâmetro */
  IF (aTipSit = 0) THEN
    QL_RETSITANT(aNumEmp, aTipCol, aNumCad, aPerIni, xAntDatAfa OUT, xAntTipSit OUT, aNCDatAlt, aNCTipSit);
  ELSE
    xAntTipSit := aTipSit;
  END IF;

  /* Retorna o Vínculo Anterior (quando usa controle por tipo de vaga), se não foi passado como parâmetro */
  IF (xConTpv = 'S') THEN
    IF (aCodVin = 0) THEN
      QL_RETVINANT(aNumEmp, aTipCol, aNumCad, aPerIni, xAntDatVin OUT, xAntCodVin OUT, xAntTipVag OUT, aNCDatAlt, aNCCodVin);
      IF (xAntCodVin = 0) THEN
        QL_RETPROVIN(aNumEmp, aTipCol, aNumCad, aPerIni, xAntDatVin OUT, xAntCodVin OUT, xAntTipVag OUT, aNCDatAlt, aNCCodVin);
      END IF;
    ELSE
      xAntCodVin := aCodVin;

      /* Lê o Tipo de Vaga do Vínculo passado como parâmetro */
      BEGIN
        SELECT TIPVAG INTO xAntTipVag FROM R022VIN WHERE CODVIN = aCodVin;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          xAntTipVag := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao buscar Situação para Atualizar Quadro Efetivo';
      END;
    END IF;
  ELSE
    xAntCodVin := 0;
    xAntTipVag := 1;
  END IF;

  /* Se não foi encontrado um dos 3 itens chave para gerar o Efetivo (Local, Cargo e Turno) não gera */
  IF (NOT (((aLocCcu = ' ') AND (xAntLocCcu = ' ')) OR
           ((aCodCar = ' ') AND (xAntCodCar = ' ')) OR
           ((aCodEsc = 0) AND (xAntCodEsc = 0)))) THEN
    xDatAnt := aPerIni;
    /* Caso só exista Local, Cargo e Turno após a Data Inicial, pega o mais recente */
    IF (xAntDatTur > xDatAnt) THEN
      xDatAnt := xAntDatTur;
    END IF;
    IF (xAntDatCar > xDatAnt) THEN
      xDatAnt := xAntDatCar;
    END IF;
    IF (xAntDatLoc > xDatAnt) THEN
      xDatAnt := xAntDatLoc;
    END IF;

    /* Retorna o Turno e o Cargo no Nível do Quadro  */
    QL_RETTIPTUR(aNumEmp, xAntCodEsc, xAntTipTur OUT, xUsaTur);

    QL_RETCARNIV(xAntEstCar, xAntCodCar, xDatAnt, xAntCodCar OUT);

    /* Verifica se usa Cargo de Vaga */
    QL_VERASS(xIndCar OUT);

    xAtualizouEfe := 0;
    FOREACH c_Histor_sel INTO xHistor_aux.DATALT,
                              xHistor_aux.TIPALT,
                              xHistor_aux.TABORG,
                              xHistor_aux.LOCCCU,
                              xHistor_aux.ESTCAR,
                              xHistor_aux.CODCAR,
                              xHistor_aux.CARVAG,
                              xHistor_aux.CODESC,
                              xHistor_aux.TIPSIT,
                              xHistor_aux.CODVIN,
                              xHistor_aux.TIPVAG
    LOOP
      xPrxDat := xHistor_aux.DATALT;

      IF (xIndCar <> 'S') THEN
        xCodCarCURSOR := xHistor_aux.CODCAR;
      ELSE
        xCodCarCURSOR := xHistor_aux.CARVAG;
      END IF;  

      /* Indica que atualizou os registros da R080EFE */
      xAtualizouEfe := 1;

      /* Se for a mesma Data, significa que foram alterados mais de um tipo de Histórico na mesma Data. E se estiver Demitido, não gera mais */
      /* Somente deve gerar Efetivo, quando o Colaborador tiver um histórico de Filial cadastrado ou quando a procedure foi chamada
         pela própria rotina de Alteração de Filial */
      IF (xDatAnt <> xPrxDat) AND (xAntTipSit <> 7) AND ((xCodFilAtu <> 0) OR (aAltFilial = 'S')) AND ((xConTpV = 'N') OR (xAntTipVag > 0)) THEN
        /* Inclui um registro Efetivo na Data, se não existir */
        QL_VERREGEXI(aNumEmp, xAntTabOrg, xAntLocCcu, xAntEstCar, xAntCodCar, xAntTipVag, xDatAnt, xRegExi OUT, xCtlQua);

        /* Se a situação foi passada, significa que é para atualizar somente a quantidade efetiva */
        IF (aTipSit > 0) THEN
          QL_ATUREGEFE(aNumEmp, xAntTabOrg, xAntLocCcu, xAntEstCar, xAntCodCar, xAntTipTur, xAntTipSit, xAntTipVag, xDatAnt, xPrxDat, 0, aQtdVag, xCtlQua);
        ELSE
          QL_ATUREGEFE(aNumEmp, xAntTabOrg, xAntLocCcu, xAntEstCar, xAntCodCar, xAntTipTur, xAntTipSit, xAntTipVag, xDatAnt, xPrxDat, aQtdVag, aQtdVag, xCtlQua);
        END IF;

        /* Se for uma inclusão (+1), tem que diminuir na data final */
        IF (aInclusao = 'S') AND (xPrxDat <> xUltDat) THEN
          /* Inclui um registro Efetivo na Data, se não existir */
          QL_VERREGEXI(aNumEmp, xAntTabOrg, xAntLocCcu, xAntEstCar, xAntCodCar, xAntTipVag, xPrxDat, xRegExi OUT, xCtlQua);

          /* Se não tinha um registro na data, retira 1 do Efetivo nesta Data */
          IF (xRegExi = 0) THEN
            xTmpDat := DATETIMEADD(DD, 1, xPrxDat);
            /* Se a situação foi passada, significa que é para atualizar somente a quantidade efetiva */
            IF (aTipSit > 0) THEN
              QL_ATUREGEFE(aNumEmp, xAntTabOrg, xAntLocCcu, xAntEstCar, xAntCodCar, xAntTipTur, xAntTipSit, xAntTipVag, xPrxDat, xTmpDat, 0, -1, xCtlQua);
            ELSE
              QL_ATUREGEFE(aNumEmp, xAntTabOrg, xAntLocCcu, xAntEstCar, xAntCodCar, xAntTipTur, xAntTipSit, xAntTipVag, xPrxDat, xTmpDat, -1, -1, xCtlQua);
            END IF;
          END IF;
        END IF;
      END IF;

      /* Verifica quais dos Históricos foram alterados e joga para as devidas variáveis */
      IF (xHistor_aux.LOCCCU <> ' ') THEN
        xAntTabOrg := xHistor_aux.TABORG;
        xAntLocCcu := xHistor_aux.LOCCCU;

        IF (xCtlQua = 0) THEN
          xAntNumLoc := CONVERT(CHAR_TO_NUMBER, xAntLocCcu);
          QL_RETLOCNIV(xAntTabOrg, xAntNumLoc, xHistor_aux.DATALT, xAntNumLoc OUT);

          IF (xAntNumLoc = 0) THEN
            xAntLocCcu := ' ';
          ELSE
            xAntLocCcu := CONVERT(NUMBER_TO_CHAR, xAntNumLoc);
          END IF;
        END IF;
      ELSE
        IF (xCodCarCURSOR <> ' ') THEN
          xAntEstCar := xHistor_aux.ESTCAR;
          xAntCodCar := xCodCarCURSOR;

          QL_RETCARNIV(xAntEstCar, xAntCodCar, xHistor_aux.DATALT, xAntCodCar OUT);
        ELSE
          IF (xHistor_aux.CODESC <> 0) THEN
            xAntCodEsc := xHistor_aux.CODESC;

            QL_RETTIPTUR(aNumEmp, xAntCodEsc, xAntTipTur OUT, xUsaTur);
          ELSE
            IF (xHistor_aux.CODVIN <> 0) THEN
              xAntCodVin := xHistor_aux.CODVIN;
              xAntTipVag := xHistor_aux.TIPVAG;
            ELSE
              IF ((xHistor_aux.TIPSIT <> 0) OR (xHistor_aux.TIPALT = 'AFA_FIM')) THEN
                xAntTipSit := xHistor_aux.TipSit;
              ELSE
                IF (xHistor_aux.TIPALT = 'FILIAL') THEN
                  /* Quando a primeira alteração de filial é encontrada, seta a variável xCodFilAtu com um valor diferente de zero. */
                  xCodFilAtu := 1;
                END IF;
              END IF;
            END IF;
          END IF;
        END IF;
      END IF;

      /* Salva a Data anterior */
      xDatAnt := xHistor_aux.DATALT;
    END LOOP;

    /* Somente deve gerar Efetivo, quando o Colaborador tiver um histórico de Filial cadastrado ou quando a procedure foi chamada
       pela própria rotina de Alteração de Filial */
    IF (xAntTipSit <> 7) AND ((xCodFilAtu <> 0) OR (aAltFilial = 'S')) AND ((xConTpV = 'N') OR (xAntTipVag > 0)) THEN
      xPrxDat := aPerFim;

      /* Inclui um registro Efetivo na Data, se não existir */
      QL_VERREGEXI(aNumEmp, xAntTabOrg, xAntLocCcu, xAntEstCar, xAntCodCar, xAntTipVag, xDatAnt, xRegExi OUT, xCtlQua);

      /* Se a situação foi passada, significa que é para atualizar somente a quantidade efetiva */
      IF (aTipSit > 0) THEN
        QL_ATUREGEFE(aNumEmp, xAntTabOrg, xAntLocCcu, xAntEstCar, xAntCodCar, xAntTipTur, xAntTipSit, xAntTipVag, xDatAnt, xPrxDat, 0, aQtdVag, xCtlQua);
      ELSE
        QL_ATUREGEFE(aNumEmp, xAntTabOrg, xAntLocCcu, xAntEstCar, xAntCodCar, xAntTipTur, xAntTipSit, xAntTipVag, xDatAnt, xPrxDat, aQtdVag, aQtdVag, xCtlQua);
      END IF;

      /* Se for uma inclusão (+1), tem que diminuir na data final */
      IF (aInclusao = 'S') AND (xPrxDat <> xUltDat) THEN
        /* Inclui um registro Efetivo na Data, se não existir */
        QL_VERREGEXI(aNumEmp, xAntTabOrg, xAntLocCcu, xAntEstCar, xAntCodCar, xAntTipVag, xPrxDat, xRegExi OUT, xCtlQua);

        /* Se não tinha um registro na data, retira 1 do Efetivo nesta Data */
        IF (xRegExi = 0) THEN
          xTmpDat := DATETIMEADD(DD, 1, xPrxDat);
          /* Se a situação foi passada, significa que é para atualizar somente a quantidade efetiva */
          IF (aTipSit > 0) THEN
            QL_ATUREGEFE(aNumEmp, xAntTabOrg, xAntLocCcu, xAntEstCar, xAntCodCar, xAntTipTur, xAntTipSit, xAntTipVag, xPrxDat, xTmpDat, 0, -1, xCtlQua);
          ELSE
            QL_ATUREGEFE(aNumEmp, xAntTabOrg, xAntLocCcu, xAntEstCar, xAntCodCar, xAntTipTur, xAntTipSit, xAntTipVag, xPrxDat, xTmpDat, -1, -1, xCtlQua);
          END IF;
        END IF;
      END IF;
    END IF;
  END IF;
END␀ÚÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
G4␀␀/* Atualiza os Registros do Efetivo
   aNumEmp - Empresa
   aTabOrg - Organograma
   aLocCcu - Local
   aEstCar - Estrutura
   aCodCar - Cargo
   aTipTur - Turno
   aTipSit - Situação
   aPerIni - Data Inicial
   aPerFim - Data Final
   aQtdVag - Vagas a serem consideradas para o Quadro normal
   aQtdAfa - Vagas a serem consideradas para o Quadro de Afastados
   aCtlQua - Tipo do Quadro */
PROCEDURE QL_ATUREGEFE(ANUMEMP NUMBER(4),ATABORG NUMBER(4),ALOCCCU VARCHAR2(18),AESTCAR NUMBER(4),ACODCAR VARCHAR2(25),ATIPTUR NUMBER(1),ATIPSIT NUMBER(3),ATIPVAG NUMBER(2),APERINI DATE,APERFIM DATE,AQTDVAG NUMBER(4),AQTDAFA NUMBER(4),ACTLQUA NUMBER(1))
 IS

xVagAfa NUMBER(4);
  xNumLoc   R080EFE.NUMLOC%TYPE;
BEGIN
  /* Se for passada a Situação, atualiza Afastados */
  IF (aTipSit > 0) THEN
    xVagAfa := aQtdAfa;
  ELSE
    xVagAfa := 0;
  END IF;

  /* Quadro por Local */
  IF (aCtlQua = 0) THEN
    xNumLoc := CONVERT(CHAR_TO_NUMBER, aLocCcu);
    /* Dependendo do Turno, atualiza campos diferentes */
    IF (aTipTur = 1) THEN
      UPDATE R080EFE SET VAGTU1 = VAGTU1 + (aQtdVag) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU1 > 0 OR aQtdVag >= 0);
      UPDATE R080EFE SET VAGT1A = VAGT1A + (xVagAfa) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT1A > 0 OR xVagAfa >= 0);
      UPDATE R080EFD SET VAGTU1 = VAGTU1 + (aQtdVag) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU1 > 0 OR aQtdVag >= 0);
      UPDATE R080EFD SET VAGT1A = VAGT1A + (xVagAfa) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT1A > 0 OR xVagAfa >= 0);
    ELSE
      IF (aTipTur = 2) THEN
        UPDATE R080EFE SET VAGTU2 = VAGTU2 + (aQtdVag) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU2 > 0 OR aQtdVag >= 0);
        UPDATE R080EFE SET VAGT2A = VAGT2A + (xVagAfa) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT2A > 0 OR xVagAfa >= 0);
        UPDATE R080EFD SET VAGTU2 = VAGTU2 + (aQtdVag) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU2 > 0 OR aQtdVag >= 0);
        UPDATE R080EFD SET VAGT2A = VAGT2A + (xVagAfa) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT2A > 0 OR xVagAfa >= 0);
      ELSE
        IF (aTipTur = 3) THEN
          UPDATE R080EFE SET VAGTU3 = VAGTU3 + (aQtdVag) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU3 > 0 OR aQtdVag >= 0);
          UPDATE R080EFE SET VAGT3A = VAGT3A + (xVagAfa) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT3A > 0 OR xVagAfa >= 0);
          UPDATE R080EFD SET VAGTU3 = VAGTU3 + (aQtdVag) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU3 > 0 OR aQtdVag >= 0);
          UPDATE R080EFD SET VAGT3A = VAGT3A + (xVagAfa) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT3A > 0 OR xVagAfa >= 0);
        ELSE
          IF (aTipTur = 4) THEN
            UPDATE R080EFE SET VAGTU4 = VAGTU4 + (aQtdVag) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU4 > 0 OR aQtdVag >= 0);
            UPDATE R080EFE SET VAGT4A = VAGT4A + (xVagAfa) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT4A > 0 OR xVagAfa >= 0);
            UPDATE R080EFD SET VAGTU4 = VAGTU4 + (aQtdVag) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU4 > 0 OR aQtdVag >= 0);
            UPDATE R080EFD SET VAGT4A = VAGT4A + (xVagAfa) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT4A > 0 OR xVagAfa >= 0);
          ELSE
            IF (aTipTur = 8) THEN
              UPDATE R080EFE SET VAGMIS = VAGMIS + (aQtdVag) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGMIS > 0 OR aQtdVag >= 0);
              UPDATE R080EFE SET VAGMIA = VAGMIA + (xVagAfa) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGMIA > 0 OR xVagAfa >= 0);
              UPDATE R080EFD SET VAGMIS = VAGMIS + (aQtdVag) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGMIS > 0 OR aQtdVag >= 0);
              UPDATE R080EFD SET VAGMIA = VAGMIA + (xVagAfa) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGMIA > 0 OR xVagAfa >= 0);
            ELSE
              UPDATE R080EFE SET VAGGER = VAGGER + (aQtdVag) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGGER > 0 OR aQtdVag >= 0);
              UPDATE R080EFE SET VAGGEA = VAGGEA + (xVagAfa) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGGEA > 0 OR xVagAfa >= 0);
              UPDATE R080EFD SET VAGGER = VAGGER + (aQtdVag) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGGER > 0 OR aQtdVag >= 0);
              UPDATE R080EFD SET VAGGEA = VAGGEA + (xVagAfa) WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGGEA > 0 OR xVagAfa >= 0);
            END IF;
          END IF;
        END IF;
      END IF;
    END IF;
  ELSE
    /* Dependendo do Turno, atualiza campos diferentes */
    IF (aTipTur = 1) THEN
      UPDATE R087EFE SET VAGTU1 = VAGTU1 + (aQtdVag) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU1 > 0 OR aQtdVag >= 0);
      UPDATE R087EFE SET VAGT1A = VAGT1A + (xVagAfa) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT1A > 0 OR xVagAfa >= 0);
      UPDATE R087EFD SET VAGTU1 = VAGTU1 + (aQtdVag) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU1 > 0 OR aQtdVag >= 0);
      UPDATE R087EFD SET VAGT1A = VAGT1A + (xVagAfa) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT1A > 0 OR xVagAfa >= 0);
    ELSE
      IF (aTipTur = 2) THEN
        UPDATE R087EFE SET VAGTU2 = VAGTU2 + (aQtdVag) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU2 > 0 OR aQtdVag >= 0);
        UPDATE R087EFE SET VAGT2A = VAGT2A + (xVagAfa) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT2A > 0 OR xVagAfa >= 0);
        UPDATE R087EFD SET VAGTU2 = VAGTU2 + (aQtdVag) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU2 > 0 OR aQtdVag >= 0);
        UPDATE R087EFD SET VAGT2A = VAGT2A + (xVagAfa) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT2A > 0 OR xVagAfa >= 0);
      ELSE
        IF (aTipTur = 3) THEN
          UPDATE R087EFE SET VAGTU3 = VAGTU3 + (aQtdVag) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU3 > 0 OR aQtdVag >= 0);
          UPDATE R087EFE SET VAGT3A = VAGT3A + (xVagAfa) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT3A > 0 OR xVagAfa >= 0);
          UPDATE R087EFD SET VAGTU3 = VAGTU3 + (aQtdVag) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU3 > 0 OR aQtdVag >= 0);
          UPDATE R087EFD SET VAGT3A = VAGT3A + (xVagAfa) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT3A > 0 OR xVagAfa >= 0);
        ELSE
          IF (aTipTur = 4) THEN
            UPDATE R087EFE SET VAGTU4 = VAGTU4 + (aQtdVag) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU4 > 0 OR aQtdVag >= 0);
            UPDATE R087EFE SET VAGT4A = VAGT4A + (xVagAfa) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT4A > 0 OR xVagAfa >= 0);
            UPDATE R087EFD SET VAGTU4 = VAGTU4 + (aQtdVag) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGTU4 > 0 OR aQtdVag >= 0);
            UPDATE R087EFD SET VAGT4A = VAGT4A + (xVagAfa) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGT4A > 0 OR xVagAfa >= 0);
          ELSE
            IF (aTipTur = 8) THEN
              UPDATE R087EFE SET VAGMIS = VAGMIS + (aQtdVag) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGMIS > 0 OR aQtdVag >= 0);
              UPDATE R087EFE SET VAGMIA = VAGMIA + (xVagAfa) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGMIA > 0 OR xVagAfa >= 0);
              UPDATE R087EFD SET VAGMIS = VAGMIS + (aQtdVag) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGMIS > 0 OR aQtdVag >= 0);
              UPDATE R087EFD SET VAGMIA = VAGMIA + (xVagAfa) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGMIA > 0 OR xVagAfa >= 0);
            ELSE
              UPDATE R087EFE SET VAGGER = VAGGER + (aQtdVag) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGGER > 0 OR aQtdVag >= 0);
              UPDATE R087EFE SET VAGGEA = VAGGEA + (xVagAfa) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGGEA > 0 OR xVagAfa >= 0);
              UPDATE R087EFD SET VAGGER = VAGGER + (aQtdVag) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGGER > 0 OR aQtdVag >= 0);
              UPDATE R087EFD SET VAGGEA = VAGGEA + (xVagAfa) WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA >= aPerIni AND CMPQUA < aPerFim AND (VAGGEA > 0 OR xVagAfa >= 0);
            END IF;
          END IF;
        END IF;
      END IF;
    END IF;
  END IF;
END␀ÛÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0QL_VERMODQL
Š␀␀PROCEDURE QL_BUSPOSTRA(L_ANUMEMP NUMBER(4),L_ATIPCOL NUMBER(1),L_ANUMCAD NUMBER(9),L_ADATPOS DATE,L_AESTPOS OUT NUMBER(3),L_APOSTRA OUT VARCHAR2(25),L_AINIATU OUT DATE,L_ATERATU OUT DATE)
 IS

l_xIndCon CHAR;
BEGIN
  l_aPosTra := ' ';
  BEGIN
    QL_VERMODQL(l_aNumEmp, l_aTipCol, l_aNumCad, l_xIndCon OUT);
	IF (l_xIndCon <> 'N') THEN
      SELECT R038HPO.ESTPOS, R038HPO.POSTRA, R038HPO.INIATU, R038HPO.TERATU INTO l_aEstPos, l_aPosTra, l_aIniAtu, l_aTerAtu FROM R038HPO, R017TAP, R017HCV
       WHERE R038HPO.CODTAP = R017TAP.CODTAP
         AND R038HPO.NUMEMP = l_aNumEmp
         AND R038HPO.TIPCOL = l_aTipCol
         AND R038HPO.NUMCAD = l_aNumCad
         AND R038HPO.ESTPOS = R017HCV.ESTPOS
         AND R038HPO.POSTRA = R017HCV.POSTRA
         AND R017HCV.DATALT = (SELECT MAX(R017HCV2.DATALT) FROM R017HCV R017HCV2
                                WHERE R017HCV2.ESTPOS = R017HCV.ESTPOS
                                  AND R017HCV2.POSTRA = R017HCV.POSTRA
                                  AND R017HCV2.DATALT <= l_aDatPos)
         AND (R017HCV.TIPCVA = 1 OR R017HCV.TIPCVA = 2) /* Controla vagas na data de referência */
         AND R017TAP.CONVAG = 'S' /* Contabiliza vaga */
         AND R017TAP.HISPRI = 'S' /* Histórico principal */
         AND R038HPO.INIATU <= l_aDatPos
         AND R038HPO.TERATU >= l_aDatPos;
	END IF;	 
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_aPosTra := ' ';
      l_aIniAtu := '31/12/1900,00:00:00';
      l_aTerAtu := '31/12/1900,00:00:00';
      l_aEstPos := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao buscar dados do posto de trabalho principal do colaborador.';
  END;
END␀ÜÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ó␀␀PROCEDURE QL_DADOSRQU(L_ACODRQU NUMBER(9),L_ASALRQU OUT NUMBER(6),L_ADATRQU OUT DATE,L_ASITRQU OUT NUMBER(1))
 IS

l_xQtdRqu NUMBER(6);
  l_xDatRqu DATE; 
  l_xSitRqu NUMBER(1);
BEGIN
	BEGIN
		SELECT QTDRQU, DATRQU, SITRQU INTO l_xQtdRqu, l_xDatRqu, l_xSitRqu FROM R126RQU
		 WHERE CODRQU = l_aCodRqu;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar informações da requisição.'; 
	END;
	
	l_aDatRqu := l_xDatRqu;
	l_aSitRqu := l_xSitRqu;
	l_aSalRqu := l_xQtdRqu;
END␀İÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;08QL_RETATUQUA
QL_EXIAFADEM
QL_RETSITANT
QL_ATUQUAEFE
\␀␀/* Procedure que processa a Atualização do Quadro de Lotação efetivo na Exclusão do Afastamento
   aNumEmpExc - Empresa
   aTipColExc - Tipo
   aNumCadExc - Cadastro
   aDatAfaExc - Data do Afastamento
   aSitAfaExc - Sit. Afastamento exc.
   aDatTerExc - Data de Término
   aNCDatAfa - Data a não ser considerada
   aNCSitAfa - Sit. Afastamento a não ser considerada
   aNCDatTer - Data de Término a não ser considerada */
PROCEDURE QL_EXCAFAST(ANUMEMPEXC NUMBER(4),ATIPCOLEXC NUMBER(1),ANUMCADEXC NUMBER(9),ADATAFAEXC DATE,ASITAFAEXC NUMBER(3),ADATTEREXC DATE,ANCDATAFA DATE,ANCSITAFA NUMBER(3),ANCDATTER DATE)
 IS

xDatTmp   R038AFA.DATAFA%TYPE;
  xDatFim   R038AFA.DATAFA%TYPE;
  xVetQlo CHAR;
  xTipSit NUMBER(2);
  xAfaQua CHAR;
  xTmpIni   R038AFA.DATAFA%TYPE;
  xAntDatAfa   R038AFA.DATAFA%TYPE;
  xAntTipSit   R010SIT.TIPSIT%TYPE;
  xNCTipSit   R010SIT.TIPSIT%TYPE;
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
  xExiAfaDem NUMBER(1);
BEGIN
    /* Verifica se é para atualizar o Quadro Efetivo. */
    QL_RETATUQUA(aNumEmpExc, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);
    IF (xAtuQua = 'S') AND ((xConTpV = 'S') OR (aTipColExc = 1)) THEN
      /* Retorna o Tipo da Situação e se este Tipo Afeta o Quadro de Lotação */
      BEGIN
        SELECT TIPSIT, AFAQUA INTO xTipSit, xAfaQua FROM R010SIT WHERE CODSIT = aSitAfaExc;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          xTipSit := 0;
          xAfaQua := 'N';
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao buscar Situação para Atualizar Quadro Efetivo';
      END;

      IF (xTipSit = 7) OR (xAfaQua = 'S') THEN
        xDatTmp := '31/12/1900,00:00:00';

        /* Se não houver próximo Afastamento, seta a Data da Próxima alteração de Afastamento como sendo futura. */
        IF (aDatTerExc = xDatTmp) THEN
          xDatFim := '04/06/2080,00:00:00';
        ELSE
          /* Verifica se existe um Afastamento de demissão na data de término. Se existir a data de retorno para o QL é a data de término.
            Senão é a data + 1 */
          QL_EXIAFADEM(aNumEmpExc, aTipColExc, aNumCadExc, aDatTerExc, xExiAfaDem OUT);
          IF (xExiAfaDem = 1) THEN
            xDatFim := aDatTerExc;
          ELSE
            xDatFim := DATETIMEADD(DD, 1, aDatTerExc);
          END IF;
        END IF;

        /* Retorna o Tipo da Situação que não é para considerar */
        xNCTipSit := 0;
        IF (aNCSitAfa > 0) THEN
          BEGIN
            SELECT TIPSIT INTO xNCTipSit FROM R010SIT WHERE CODSIT = aNCSitAfa;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              xNCTipSit := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao buscar Situação para Atualizar Quadro Efetivo';
          END;
        END IF;

        QL_RETSITANT(aNumEmpExc, aTipColExc, aNumCadExc, aDatAfaExc, xAntDatAfa OUT, xAntTipSit OUT, aNCDatAfa, xNCTipSit);

        /* Se tem um afastamento aberto e fechado na mesma data, acresce 1 no retorno, exceto se for afast. de demissão. */
        IF (xAntTipSit > 0) AND (xTipSit <> 7) THEN
          xTmpIni := DATETIMEADD(DD, 1, aDatAfaExc);
        ELSE
          xTmpIni := aDatAfaExc;
        END IF;

        IF (xTipSit <> 7) THEN
          /* Decrementa 1 do Efetivo para o Afastamento Excluído no período da Data da Exclusão até a Data final do Afastamento */
          QL_ATUQUAEFE(aNumEmpExc, aTipColExc, aNumCadExc, 0, ' ', 0, ' ', 0, xTipSit, 0, xTmpIni, xDatFim, -1, 'N', 'N', aNCDatAfa, 0, ' ', 0, ' ', 0, xNCTipSit, 0, aNCDatTer);
        ELSE
          /* Incrementa 1 no Efetivo a partir da Data de Demissão, se for Tipo 7 */
          QL_ATUQUAEFE(aNumEmpExc, aTipColExc, aNumCadExc, 0, ' ', 0, ' ', 0, 0, 0, xTmpIni, xDatFim, 1, 'S', 'N', aNCDatAfa, 0, ' ', 0, ' ', 0, xNCTipSit, 0, aNCDatTer);
        END IF;
      END IF;
    END IF;
END␀ŞÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0FQL_RETATUQUA
QL_RETPROCAR
QL_RETCARANT
QL_RETCARNIV
QL_ATUQUAEFE
␀␀/* Procedure que processa a Atualização do Quadro de Lotação efetivo na Exclusão do Cargo
   aNumEmpExc - Empresa
   aTipColExc - Tipo
   aNumCadExc - Cadastro
   aDatAltExc - Data da operação
   aEstCarExc - Estrut. excluída
   aCodCarExc - Cargo excluído
   aNCDatAlt - Data a não ser considerada
   aNCEstCar - Estrutura a não ser considerada
   aNCCodCar - Cargo a não ser considerado */
PROCEDURE QL_EXCCARGO(ANUMEMPEXC NUMBER(4),ATIPCOLEXC NUMBER(1),ANUMCADEXC NUMBER(9),ADATALTEXC DATE,AESTCAREXC NUMBER(4),ACODCAREXC VARCHAR2(25),ANCDATALT DATE,ANCESTCAR NUMBER(4),ANCCODCAR VARCHAR2(25))
 IS

xPrxDatAlt   R038HCA.DATALT%TYPE;
  xPrxEstCar   R038HCA.ESTCAR%TYPE;
  xPrxCodCar   R038HCA.CODCAR%TYPE;
  xAntDatAlt   R038HCA.DATALT%TYPE;
  xAntEstCar   R038HCA.ESTCAR%TYPE;
  xAntCodCar   R038HCA.CODCAR%TYPE;
  
  xAntCodCarNiv   R038HCA.CODCAR%TYPE;
  xCodCarNivExc   R038HCA.CODCAR%TYPE;

  xDatTmp   R038HCA.DATALT%TYPE;
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
BEGIN
  /* Verifica se é para atualizar o Quadro Efetivo. */
  QL_RETATUQUA(aNumEmpExc, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);
  IF (xAtuQua = 'S') AND ((xConTpV = 'S') OR (aTipColExc = 1)) THEN
    xDatTmp := '31/12/1900,00:00:00';

    /* Retorna os dados (data e Cargo) da próxima alteração de Cargo */
    QL_RETPROCAR(aNumEmpExc, aTipColExc, aNumCadExc, aDatAltExc, xPrxDatAlt OUT, xPrxEstCar OUT, xPrxCodCar OUT, aNCDatAlt, aNCEstCar, aNCCodCar);

    /* Retorna os dados (data e Cargo) da alteração de Cargo anterior */
    QL_RETCARANT(aNumEmpExc, aTipColExc, aNumCadExc, aDatAltExc, xAntDatAlt OUT, xAntEstCar OUT, xAntCodCar OUT, aNCDatAlt, aNCEstCar, aNCCodCar);

    /* Retorna o Cargo do Nível do Quadro */
    IF (xAntEstCar > 0) THEN
      QL_RETCARNIV(xAntEstCar, xAntCodCar, xAntDatAlt, xAntCodCarNiv OUT);

      QL_RETCARNIV(aEstCarExc, aCodCarExc, aDatAltExc, xCodCarNivExc OUT);
    ELSE
      xAntCodCarNiv := xAntCodCar;
      xCodCarNivExc := aCodCarExc;
    END IF;

    IF (xAntEstCar <> aEstCarExc) OR (xAntCodCarNiv <> xCodCarNivExc) THEN
      /* Se não houver próximo Cargo, seta a Data da Próxima alteração de Cargo como sendo futura. */
      IF (xPrxDatAlt = xDatTmp) THEN
        xPrxDatAlt := '04/06/2080,00:00:00';
      END IF;

      /* Decrementa 1 do Cargo excluído no período da Data da Operação até a Data da próxima Alteração de Cargo */
      QL_ATUQUAEFE(aNumEmpExc, aTipColExc, aNumCadExc, 0, ' ', aEstCarExc, aCodCarExc, 0, 0, 0, aDatAltExc, xPrxDatAlt, -1, 'N', 'N', aNCDatAlt, 0, ' ', aNCEstCar, aNCCodCar, 0, 0, 0, xDatTmp);

      /* Incrementa 1 no Efetivo para o novo Cargo no período da Data da Operação até a Data da próxima Alteração de Cargo
         Somente se existir um Cargo anterior  */
      IF (xAntEstCar > 0) THEN
        QL_ATUQUAEFE(aNumEmpExc, aTipColExc, aNumCadExc, 0, ' ', xAntEstCar, xAntCodCar, 0, 0, 0, aDatAltExc, xPrxDatAlt, 1, 'S', 'N', aNCDatAlt, 0, ' ', aNCEstCar, aNCCodCar, 0, 0, 0, xDatTmp);
      END IF;
    END IF;
  END IF;
END␀ßÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;08QL_RETATUQUA
QL_RETPROCCU
QL_ATUQUAEFE
QL_RETCCUANT
‘	␀␀/* Procedure que processa a Atualização do Quadro de Lotação efetivo na Exclusão do Centro de Custo
   aNumEmpExc - Empresa
   aTipColExc - Tipo
   aNumCadExc - Cadastro
   aDatAltExc - Data da operação
   aCodCcuExc - Centro de Custo excluído
   aNCDatAlt - Data a não ser considerada
   aNCCodCcu - Centro de Custo a não ser considerado */
PROCEDURE QL_EXCCCUSTO(ANUMEMPEXC NUMBER(4),ATIPCOLEXC NUMBER(1),ANUMCADEXC NUMBER(9),ADATALTEXC DATE,ACODCCUEXC VARCHAR2(18),ANCDATALT DATE,ANCCODCCU VARCHAR2(18))
 IS

xPrxDatAlt   R038HCC.DATALT%TYPE;
  xPrxCodCcu   R038HCC.CODCCU%TYPE;
  xAntDatAlt   R038HCC.DATALT%TYPE;
  xAntCodCcu   R038HCC.CODCCU%TYPE;

  xDatTmp   R038HCC.DATALT%TYPE;
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
BEGIN
  /* Verifica se é para atualizar o Quadro Efetivo. */
  QL_RETATUQUA(aNumEmpExc, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);
  IF (xAtuQua = 'S') AND (xCtlQua = 1) AND ((xConTpV = 'S') OR (aTipColExc = 1)) THEN
    xDatTmp := '31/12/1900,00:00:00';

    /* Retorna os dados (data e Centro de Custo) da próxima alteração de Centro de Custo */
    QL_RETPROCCU(aNumEmpExc, aTipColExc, aNumCadExc, aDatAltExc, xPrxDatAlt OUT, xPrxCodCcu OUT, aNCDatAlt, aNCCodCcu);

    /* Se não houver próximo Centro de Custo, seta a Data da Próxima alteração de Centro de Custo como sendo futura. */
    IF (xPrxDatAlt = xDatTmp) THEN
      xPrxDatAlt := '04/06/2080,00:00:00';
    END IF;

    /* Decrementa 1 do Centro de Custo excluído no período da Data da Operação até a Data da próxima Alteração de Centro de Custo */
    QL_ATUQUAEFE(aNumEmpExc, aTipColExc, aNumCadExc, 0, aCodCcuExc, 0, ' ', 0, 0, 0, aDatAltExc, xPrxDatAlt, -1, 'N', 'N', aNCDatAlt, 0, aNCCodCcu, 0, ' ', 0, 0, 0, xDatTmp);

    /* Retorna os dados (data e Centro de Custo) da alteração de Centro de Custo anterior */
    QL_RETCCUANT(aNumEmpExc, aTipColExc, aNumCadExc, aDatAltExc, xAntDatAlt OUT, xAntCodCcu OUT, aNCDatAlt, aNCCodCcu);

    /* Incrementa 1 no Efetivo para o novo Centro de Custo no período da Data da Operação até a Data da próxima Alteração de Centro de Custo
       Somente se existir um Centro de Custo anterior  */
    IF (xAntCodCcu <> ' ') THEN
      QL_ATUQUAEFE(aNumEmpExc, aTipColExc, aNumCadExc, 0, xAntCodCcu, 0, ' ', 0, 0, 0, aDatAltExc, xPrxDatAlt, 1, 'S', 'N', aNCDatAlt, 0, aNCCodCcu, 0, ' ', 0, 0, 0, xDatTmp);
    END IF;
  END IF;
END␀àÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;08QL_RETATUQUA
QL_RETPROESC
QL_ATUQUAEFE
QL_RETESCANT
„	␀␀/* Procedure que processa a Atualização do Quadro de Lotação efetivo na Exclusão do Escala/Horário
   aNumEmpExc - Empresa
   aTipColExc - Tipo
   aNumCadExc - Cadastro
   aDatAltExc - Data da operação
   aCodEscExc - Escala/Horário excluído
   aNCDatAlt - Data a não ser considerada
   aNCCodEsc - Escala/Horário a não ser considerado */
PROCEDURE QL_EXCESCALA(ANUMEMPEXC NUMBER(4),ATIPCOLEXC NUMBER(1),ANUMCADEXC NUMBER(9),ADATALTEXC DATE,ACODESCEXC NUMBER(9),ANCDATALT DATE,ANCCODESC NUMBER(9))
 IS

xPrxDatAlt   R038HES.DATALT%TYPE;
  xPrxCodEsc   R038HES.CODESC%TYPE;
  xAntDatAlt   R038HES.DATALT%TYPE;
  xAntCodEsc   R038HES.CODESC%TYPE;

  xDatTmp   R038HES.DATALT%TYPE;
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
BEGIN
  /* Verifica se é para atualizar o Quadro Efetivo. */
  QL_RETATUQUA(aNumEmpExc, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);
  IF (xAtuQua = 'S') AND (xUsaTur = 'S') AND ((xConTpV = 'S') OR (aTipColExc = 1)) THEN
    xDatTmp := '31/12/1900,00:00:00';

    /* Retorna os dados (data e Escala/Horário) da próxima alteração de Escala/Horário */
    QL_RETPROESC(aNumEmpExc, aTipColExc, aNumCadExc, aDatAltExc, xPrxDatAlt OUT, xPrxCodEsc OUT, aNCDatAlt, aNCCodEsc);

    /* Se não houver próximo Escala/Horário, seta a Data da Próxima alteração de Escala/Horário como sendo futura. */
    IF (xPrxDatAlt = xDatTmp) THEN
      xPrxDatAlt := '04/06/2080,00:00:00';
    END IF;

    /* Decrementa 1 do Escala/Horário excluído no período da Data da Operação até a Data da próxima Alteração de Escala/Horário */
    QL_ATUQUAEFE(aNumEmpExc, aTipColExc, aNumCadExc, 0, ' ', 0, ' ', aCodEscExc, 0, 0, aDatAltExc, xPrxDatAlt, -1, 'N', 'N', aNCDatAlt, 0, ' ', 0, ' ', aNCCodEsc, 0, 0, xDatTmp);

    /* Retorna os dados (data e Escala/Horário) da alteração de Escala/Horário anterior */
    QL_RETESCANT(aNumEmpExc, aTipColExc, aNumCadExc, aDatAltExc, xAntDatAlt OUT, xAntCodEsc OUT, aNCDatAlt, aNCCodEsc);

    /* Incrementa 1 no Efetivo para o novo Escala/Horário no período da Data da Operação até a Data da próxima Alteração de Escala/Horário
       Somente se existir um Escala/Horário anterior  */
    IF (xAntCodEsc > 0) THEN
      QL_ATUQUAEFE(aNumEmpExc, aTipColExc, aNumCadExc, 0, ' ', 0, ' ', xAntCodEsc, 0, 0, aDatAltExc, xPrxDatAlt, 1, 'S', 'N', aNCDatAlt, 0, ' ', 0, ' ', aNCCodEsc, 0, 0, xDatTmp);
    END IF;
  END IF;
END␀áÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;08QL_RETATUQUA
QL_RETFILANT
QL_ATUQUAEFE
QL_RETPROFIL
Œ	␀␀/* Procedure que processa a Atualização do Quadro de Lotação efetivo na Exclusão da Filial
   aNumEmpExc - Empresa
   aTipColExc - Tipo
   aNumCadExc - Cadastro
   aDatAltExc - Data da operação
   aEmpAtuExc - Empresa Filial excluída
   aCodFilExc - Filial excluído
   aNCDatAlt - Data a não ser considerada
   aNCEmpAtu - Empresa Filial a não ser considerada
   aNCCodFil - Filial a não ser considerado */
PROCEDURE QL_EXCFILIAL(ANUMEMPEXC NUMBER(4),ATIPCOLEXC NUMBER(1),ANUMCADEXC NUMBER(9),ADATALTEXC DATE,AEMPATUEXC NUMBER(4),ACODFILEXC NUMBER,ANCDATALT DATE,ANCEMPATU NUMBER(4),ANCCODFIL NUMBER)
 IS

xPrxDatAlt   R038HFI.DATALT%TYPE;
  xPrxEmpAtu   R038HFI.EMPATU%TYPE;
  xPrxCodFil   R038HFI.CODFIL%TYPE;
  xAntDatAlt   R038HFI.DATALT%TYPE;
  xAntEmpAtu   R038HFI.EMPATU%TYPE;
  xAntCodFil   R038HFI.CODFIL%TYPE;
  
  xDatTmp      R038HFI.DATALT%TYPE;
  xDatAltFut   R038HFI.DATALT%TYPE;
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
BEGIN
  /* Verifica se é para atualizar o Quadro Efetivo. */
  QL_RETATUQUA(aNumEmpExc, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);
  IF (xAtuQua = 'S') AND ((xConTpV = 'S') OR (aTipColExc = 1)) THEN
    xDatTmp := '31/12/1900,00:00:00';

    /* Retorna os dados (data e Filial) da alteração de Filial anterior */
    QL_RETFILANT(aNumEmpExc, aTipColExc, aNumCadExc, aDatAltExc, xAntDatAlt OUT, xAntEmpAtu OUT, xAntCodFil OUT, aNCDatAlt, aNCEmpAtu, aNCCodFil);

    /* Se é o primeiro histórico de filial, exclui efetivo a partir da data */
    IF (xAntDatAlt = xDatTmp) THEN
      xDatAltFut := '04/06/2080,00:00:00';

      /* Decrementa 1 do Efetivo a partir da exclusão de Filial */
      QL_ATUQUAEFE(aNumEmpExc, aTipColExc, aNumCadExc, 0, ' ', 0, ' ', 0, 0, 0, aDatAltExc, xDatAltFut, -1, 'N', 'S', aNCDatAlt, 0, ' ', 0, ' ', 0, 0, 0, xDatTmp);

      /* Retorna os dados (data e Filial) da próxima alteração de Filial */
      QL_RETPROFIL(aNumEmpExc, aTipColExc, aNumCadExc, aDatAltExc, xPrxDatAlt OUT, xPrxEmpAtu OUT, xPrxCodFil OUT, aNCDatAlt, aNCEmpAtu, aNCCodFil);

      /* Se houver próxima Filial, incrementa 1 a partir da Data da Próxima alteração de Filial. */
      IF (xPrxDatAlt <> xDatTmp) THEN
        QL_ATUQUAEFE(aNumEmpExc, aTipColExc, aNumCadExc, 0, ' ', 0, ' ', 0, 0, 0, xPrxDatAlt, xDatAltFut, 1, 'S', 'S', aNCDatAlt, 0, ' ', 0, ' ', 0, 0, 0, xDatTmp);
      END IF;
    END IF;
  END IF;
END␀âÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0FQL_RETATUQUA
QL_RETPROLOC
QL_RETLOCANT
QL_RETLOCNIV
QL_ATUQUAEFE
1␀␀/* Procedure que processa a Atualização do Quadro de Lotação efetivo na Exclusão do Local
   aNumEmpExc - Empresa
   aTipColExc - Tipo
   aNumCadExc - Cadastro
   aDatAltExc - Data da operação
   aTabOrgExc - Organ. excluída
   aNumLocExc - Local excluído
   aNCDatAlt - Data a não ser considerada
   aNCTabOrg - Organograma a não ser considerada
   aNCNumLoc - Local a não ser considerado */
PROCEDURE QL_EXCLOCAL(ANUMEMPEXC NUMBER(4),ATIPCOLEXC NUMBER(1),ANUMCADEXC NUMBER(9),ADATALTEXC DATE,ATABORGEXC NUMBER(4),ANUMLOCEXC NUMBER(9),ANCDATALT DATE,ANCTABORG NUMBER(4),ANCNUMLOC NUMBER(9))
 IS

xPrxDatAlt   R038HLO.DATALT%TYPE;
  xPrxTabOrg   R038HLO.TABORG%TYPE;
  xPrxNumLoc   R038HLO.NUMLOC%TYPE;
  xAntDatAlt   R038HLO.DATALT%TYPE;
  xAntTabOrg   R038HLO.TABORG%TYPE;
  xAntNumLoc   R038HLO.NUMLOC%TYPE;

  xAntNumLocNiv   R038HLO.NUMLOC%TYPE;
  xNumLocNivExc   R038HLO.NUMLOC%TYPE;

  xDatTmp   R038HLO.DATALT%TYPE;
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
  xLocCcu VARCHAR2(18);
  xNCLocCcu VARCHAR2(18);
BEGIN
  /* Verifica se é para atualizar o Quadro Efetivo. */
  QL_RETATUQUA(aNumEmpExc, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);
  IF (xAtuQua = 'S') AND (xCtlQua = 0) AND ((xConTpV = 'S') OR (aTipColExc = 1)) THEN
    xDatTmp := '31/12/1900,00:00:00';

    /* Retorna os dados (data e Local) da próxima alteração de Local */
    QL_RETPROLOC(aNumEmpExc, aTipColExc, aNumCadExc, aDatAltExc, xPrxDatAlt OUT, xPrxTabOrg OUT, xPrxNumLoc OUT, aNCDatAlt, aNCTabOrg, aNCNumLoc);

    /* Retorna os dados (data e Local) da alteração de Local anterior */
    QL_RETLOCANT(aNumEmpExc, aTipColExc, aNumCadExc, aDatAltExc, xAntDatAlt OUT, xAntTabOrg OUT, xAntNumLoc OUT, aNCDatAlt, aNCTabOrg, aNCNumLoc);

    /* Retorna o Local do Nível do Quadro */
    IF (xAntTabOrg > 0) THEN
      QL_RETLOCNIV(xAntTabOrg, xAntNumLoc, xAntDatAlt, xAntNumLocNiv OUT);

      QL_RETLOCNIV(aTabOrgExc, aNumLocExc, aDatAltExc, xNumLocNivExc OUT);
    ELSE
      xAntNumLocNiv := xAntNumLoc;
      xNumLocNivExc := aNumLocExc;
    END IF;

    IF (xAntTabOrg <> aTabOrgExc) OR (xAntNumLocNiv <> xNumLocNivExc) THEN
      /* Se não houver próximo Local, seta a Data da Próxima alteração de Local como sendo futura. */
      IF (xPrxDatAlt = xDatTmp) THEN
        xPrxDatAlt := '04/06/2080,00:00:00';
      END IF;

      /* Decrementa 1 do Local excluído no período da Data da Operação até a Data da próxima Alteração de Local */
      xLocCcu := CONVERT(NUMBER_TO_CHAR, aNumLocExc);
      xNCLocCcu := CONVERT(NUMBER_TO_CHAR, aNCNumLoc);
      QL_ATUQUAEFE(aNumEmpExc, aTipColExc, aNumCadExc, aTabOrgExc, xLocCcu, 0, ' ', 0, 0, 0, aDatAltExc, xPrxDatAlt, -1, 'N', 'N', aNCDatAlt, aNCTabOrg, xNCLocCcu, 0, ' ', 0, 0, 0, xDatTmp);

      /* Incrementa 1 no Efetivo para o novo Local no período da Data da Operação até a Data da próxima Alteração de Local
         Somente se existir um Local anterior  */
      IF (xAntTabOrg > 0) THEN
        xLocCcu := CONVERT(NUMBER_TO_CHAR, xAntNumLoc);
        xNCLocCcu := CONVERT(NUMBER_TO_CHAR, aNCNumLoc);
        QL_ATUQUAEFE(aNumEmpExc, aTipColExc, aNumCadExc, xAntTabOrg, xLocCcu, 0, ' ', 0, 0, 0, aDatAltExc, xPrxDatAlt, 1, 'S', 'N', aNCDatAlt, aNCTabOrg, xNCLocCcu, 0, ' ', 0, 0, 0, xDatTmp);
      END IF;
    END IF;
  END IF;
END␀ãÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;08QL_RETATUQUA
QL_RETPROVIN
QL_ATUQUAEFE
QL_RETVINANT
c	␀␀/* Procedure que processa a Atualização do Quadro de Lotação efetivo na Exclusão do Vínculo
   aNumEmpExc - Empresa
   aTipColExc - Tipo
   aNumCadExc - Cadastro
   aDatAltExc - Data da operação
   aCodVinExc - Vínculo excluído
   aNCDatAlt - Data a não ser considerada
   aNCCodVin - Vínculo a não ser considerado */
PROCEDURE QL_EXCVINCULO(ANUMEMPEXC NUMBER(4),ATIPCOLEXC NUMBER(1),ANUMCADEXC NUMBER(9),ADATALTEXC DATE,ACODVINEXC NUMBER(2),ANCDATALT DATE,ANCCODVIN NUMBER(3))
 IS

xPrxDatAlt   R038HVI.DATALT%TYPE;
  xPrxCodVin   R038HVI.CODVIN%TYPE;
  xPrxTipVag   R022VAG.TIPVAG%TYPE;
  xAntDatAlt   R038HVI.DATALT%TYPE;
  xAntCodVin   R038HVI.CODVIN%TYPE;
  xAntTipVag   R022VAG.TIPVAG%TYPE;

  xDatTmp   R038HVI.DATALT%TYPE;
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
BEGIN
  /* Verifica se é para atualizar o Quadro Efetivo. */
  QL_RETATUQUA(aNumEmpExc, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);
  IF (xAtuQua = 'S') AND (xConTpV = 'S') THEN
    xDatTmp := '31/12/1900,00:00:00';

    /* Retorna os dados (data e vínculo) da próxima alteração de vínculo */
    QL_RETPROVIN(aNumEmpExc, aTipColExc, aNumCadExc, aDatAltExc, xPrxDatAlt OUT, xPrxCodVin OUT, xPrxTipVag OUT, aNCDatAlt, aNCCodVin);

    /* Se não houver próximo vínculo, seta a Data da Próxima alteração de vínculo como sendo futura. */
    IF (xPrxDatAlt = xDatTmp) THEN
      xPrxDatAlt := '04/06/2080,00:00:00';
    END IF;

    /* Decrementa 1 do vínculo excluído no período da Data da Operação até a Data da próxima Alteração de vínculo */
    QL_ATUQUAEFE(aNumEmpExc, aTipColExc, aNumCadExc, 0, ' ', 0, ' ', 0, 0, aCodVinExc, aDatAltExc, xPrxDatAlt, -1, 'N', 'N', aNCDatAlt, 0, ' ', 0, ' ', 0, 0, aNCCodVin, xDatTmp);

    /* Retorna os dados (data e vínculo) da alteração de vínculo anterior */
    QL_RETVINANT(aNumEmpExc, aTipColExc, aNumCadExc, aDatAltExc, xAntDatAlt OUT, xAntCodVin OUT, xAntTipVag OUT, aNCDatAlt, aNCCodVin);

    /* Incrementa 1 no Efetivo para o novo vínculo no período da Data da Operação até a Data da próxima Alteração de vínculo
       Somente se existir um vínculo anterior  */
    IF (xAntCodVin > 0) THEN
      QL_ATUQUAEFE(aNumEmpExc, aTipColExc, aNumCadExc, 0, ' ', 0, ' ', 0, 0, xAntCodVin, aDatAltExc, xPrxDatAlt, 1, 'S', 'N', aNCDatAlt, 0, ' ', 0, ' ', 0, 0, aNCCodVin, xDatTmp);
    END IF;
  END IF;
END␀äÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
 ␀␀/* Verifica se existe um Afastamento de Demissão na Data de referência
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aDatRef - Data Referencia
   aExiAfa - Retorna 1 se tiver Afastamento de Demissão */
PROCEDURE QL_EXIAFADEM(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATREF DATE,AEXIAFA OUT NUMBER(1))
 IS

xDatTmp DATE;
BEGIN
  xDatTmp := '31/12/1900,00:00:00';

  BEGIN
    SELECT 1 INTO aExiAfa FROM R038AFA AFA, R010SIT SIT
     WHERE AFA.NUMEMP = aNumEmp AND AFA.TIPCOL = aTipCol AND AFA.NUMCAD = aNumCad
       AND AFA.DATAFA = aDatRef AND SIT.CODSIT = AFA.SITAFA AND SIT.TIPSIT = 7;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      aExiAfa := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na busca do Afastamento de Demissão.';
  END;
END␀åÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;08QL_RETATUQUA
QL_EXIAFADEM
QL_RETSITANT
QL_ATUQUAEFE
g␀␀/* Procedure que processa a Atualização do Quadro de Lotação efetivo na Inclusão do Afastamento
   aNumEmpInc - Empresa
   aTipColInc - Tipo
   aNumCadInc - Cadastro
   aDatAfaInc - Data do Afastamento
   aSitAfaInc - Sit. Afastamento nova
   aDatTerInc - Data de Término
   aNCDatAfa - Data a não ser considerada
   aNCSitAfa - Sit. Afastamento a não ser considerada
   aNCDatTer - Data de Término a não ser considerada */
PROCEDURE QL_INCAFAST(ANUMEMPINC NUMBER(4),ATIPCOLINC NUMBER(1),ANUMCADINC NUMBER(9),ADATAFAINC DATE,ASITAFAINC NUMBER(3),ADATTERINC DATE,ANCDATAFA DATE,ANCSITAFA NUMBER(3),ANCDATTER DATE)
 IS

xDatTmp   R038AFA.DATAFA%TYPE;
  xDatFim   R038AFA.DATAFA%TYPE;
  xVetQlo CHAR;
  xTipSit NUMBER(2);
  xAfaQua CHAR;
  xTmpIni   R038AFA.DATAFA%TYPE;
  xAntDatAfa   R038AFA.DATAFA%TYPE;
  xAntTipSit   R010SIT.TIPSIT%TYPE;
  xNCTipSit   R010SIT.TIPSIT%TYPE;
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
  xExiAfaDem NUMBER(1);
BEGIN
    /* Verifica se é para atualizar o Quadro Efetivo. */
    QL_RETATUQUA(aNumEmpInc, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);
    IF (xAtuQua = 'S') AND ((xConTpV = 'S') OR (aTipColInc = 1)) THEN
      /* Retorna o Tipo da Situação e se este Tipo Afeta o Quadro de Lotação */
      BEGIN
        SELECT TIPSIT, AFAQUA INTO xTipSit, xAfaQua FROM R010SIT WHERE CODSIT = aSitAfaInc;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          xTipSit := 0;
          xAfaQua := 'N';
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao buscar Situação para Atualizar Quadro Efetivo';
      END;

      IF (xTipSit = 7) OR (xAfaQua = 'S') THEN
        xDatTmp := '31/12/1900,00:00:00';

        /* Se não houver próximo Afastamento, seta a Data da Próxima alteração de Afastamento como sendo futura. */
        IF (aDatTerInc = xDatTmp) THEN
          xDatFim := '04/06/2080,00:00:00';
        ELSE
          /* Verifica se existe um Afastamento de demissão na data de término. Se existir a data de retorno para o QL é a data de término.
            Senão é a data + 1 */
          QL_EXIAFADEM(aNumEmpInc, aTipColInc, aNumCadInc, aDatTerInc, xExiAfaDem OUT);
          IF (xExiAfaDem = 1) THEN
            xDatFim := aDatTerInc;
          ELSE
            xDatFim := DATETIMEADD(DD, 1, aDatTerInc);
          END IF;
        END IF;

        /* Retorna o Tipo da Situação que não é para considerar */
        xNCTipSit := 0;
        IF (aNCSitAfa > 0) THEN
          BEGIN
            SELECT TIPSIT INTO xNCTipSit FROM R010SIT WHERE CODSIT = aNCSitAfa;
          EXCEPTION
            WHEN NO_DATA_FOUND THEN
              xNCTipSit := 0;
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao buscar Situação para Atualizar Quadro Efetivo';
          END;
        END IF;

        QL_RETSITANT(aNumEmpInc, aTipColInc, aNumCadInc, aDatAfaInc, xAntDatAfa OUT, xAntTipSit OUT, aNCDatAfa, xNCTipSit);

        /* Se tem um afastamento aberto e fechado na mesma data, acresce 1 no retorno, exceto se for afast. de demissão. */
        IF (xAntTipSit > 0) AND (xTipSit <> 7) THEN
          xTmpIni := DATETIMEADD(DD, 1, aDatAfaInc);
        ELSE
          xTmpIni := aDatAfaInc;
        END IF;

        IF (xTipSit <> 7) THEN
          /* Incrementa 1 no Efetivo para o novo Afastamento no período da Data da Operação até a Data da próxima Alteração de Afastamento */
          QL_ATUQUAEFE(aNumEmpInc, aTipColInc, aNumCadInc, 0, ' ', 0, ' ', 0, xTipSit, 0, xTmpIni, xDatFim, 1, 'S', 'N', aNCDatAfa, 0, ' ', 0, ' ', 0, xNCTipSit, 0, aNCDatTer);
        ELSE
          /* Decrementa 1 do Efetivo a partir da Data de Demissão, se for Tipo 7 */
          QL_ATUQUAEFE(aNumEmpInc, aTipColInc, aNumCadInc, 0, ' ', 0, ' ', 0, 0, 0, xTmpIni, xDatFim, -1, 'N', 'N', aNCDatAfa, 0, ' ', 0, ' ', 0, xNCTipSit, 0, aNCDatTer);
        END IF;
      END IF;
    END IF;
END␀æÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0FQL_RETATUQUA
QL_RETPROCAR
QL_RETCARANT
QL_RETCARNIV
QL_ATUQUAEFE
␀␀/* Procedure que processa a Atualização do Quadro de Lotação efetivo na Inclusão do Cargo
   aNumEmpInc - Empresa
   aTipColInc - Tipo
   aNumCadInc - Cadastro
   aDatAltInc - Data da operação
   aEstCarInc - Estrut. nova
   aCodCarInc - Cargo novo
   aNCDatAlt - Data a não ser considerada
   aNCEstCar - Estrutura a não ser considerada
   aNCCodCar - Cargo a não ser considerado */
PROCEDURE QL_INCCARGO(ANUMEMPINC NUMBER(4),ATIPCOLINC NUMBER(1),ANUMCADINC NUMBER(9),ADATALTINC DATE,AESTCARINC NUMBER(4),ACODCARINC VARCHAR2(25),ANCDATALT DATE,ANCESTCAR NUMBER(4),ANCCODCAR VARCHAR2(25))
 IS

xPrxDatAlt   R038HCA.DATALT%TYPE;
  xPrxEstCar   R038HCA.ESTCAR%TYPE;
  xPrxCodCar   R038HCA.CODCAR%TYPE;
  xAntDatAlt   R038HCA.DATALT%TYPE;
  xAntEstCar   R038HCA.ESTCAR%TYPE;
  xAntCodCar   R038HCA.CODCAR%TYPE;

  xAntCodCarNiv   R038HCA.CODCAR%TYPE;
  xCodCarNivInc   R038HCA.CODCAR%TYPE;

  xDatTmp   R038HCA.DATALT%TYPE;
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
BEGIN
  /* Verifica se é para atualizar o Quadro Efetivo. */
  QL_RETATUQUA(aNumEmpInc, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);
  IF (xAtuQua = 'S') AND ((xConTpV = 'S') OR (aTipColInc = 1)) THEN
    xDatTmp := '31/12/1900,00:00:00';

    /* Retorna os dados (data e Cargo) da próxima alteração de Cargo */
    QL_RETPROCAR(aNumEmpInc, aTipColInc, aNumCadInc, aDatAltInc, xPrxDatAlt OUT, xPrxEstCar OUT, xPrxCodCar OUT, aNCDatAlt, aNCEstCar, aNCCodCar);

    /* Retorna os dados (data e Cargo) da alteração de Cargo anterior */
    QL_RETCARANT(aNumEmpInc, aTipColInc, aNumCadInc, aDatAltInc, xAntDatAlt OUT, xAntEstCar OUT, xAntCodCar OUT, aNCDatAlt, aNCEstCar, aNCCodCar);

    /* Retorna o Cargo do Nível do Quadro */
    IF (xAntEstCar > 0) THEN
      QL_RETCARNIV(xAntEstCar, xAntCodCar, xAntDatAlt, xAntCodCarNiv OUT);

      QL_RETCARNIV(aEstCarInc, aCodCarInc, aDatAltInc, xCodCarNivInc OUT);
    ELSE
      xAntCodCarNiv := xAntCodCar;
      xCodCarNivInc := aCodCarInc;
    END IF;

    IF (xAntEstCar <> aEstCarInc) OR (xAntCodCarNiv <> xCodCarNivInc) THEN
      /* Se não houver próximo Cargo, seta a Data da Próxima alteração de Cargo como sendo futura. */
      IF (xPrxDatAlt = xDatTmp) THEN
        xPrxDatAlt := '04/06/2080,00:00:00';
      END IF;

      /* Decrementa 1 do Efetivo do Cargo anterior no período da Data da Operação até a Data da próxima Alteração de Cargo.
         Somente se existir um Cargo anterior */
      IF (xAntEstCar > 0) THEN
        QL_ATUQUAEFE(aNumEmpInc, aTipColInc, aNumCadInc, 0, ' ', xAntEstCar, xAntCodCar, 0, 0, 0, aDatAltInc, xPrxDatAlt, -1, 'N', 'N', aNCDatAlt, 0, ' ', aNCEstCar, aNCCodCar, 0, 0, 0, xDatTmp);
      END IF;

      /* Incrementa 1 no Efetivo para o novo Cargo no período da Data da Operação até a Data da próxima Alteração de Cargo */
      QL_ATUQUAEFE(aNumEmpInc, aTipColInc, aNumCadInc, 0, ' ', aEstCarInc, aCodCarInc, 0, 0, 0, aDatAltInc, xPrxDatAlt, 1, 'S', 'N', aNCDatAlt, 0, ' ', aNCEstCar, aNCCodCar, 0, 0, 0, xDatTmp);
    END IF;
  END IF;
END␀çÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;08QL_RETATUQUA
QL_RETPROCCU
QL_RETCCUANT
QL_ATUQUAEFE
˜	␀␀/* Procedure que processa a Atualização do Quadro de Lotação efetivo na Inclusão do Centro de Custo
   aNumEmpInc - Empresa
   aTipColInc - Tipo
   aNumCadInc - Cadastro
   aDatAltInc - Data da operação
   aCodCcuInc - Centro de Custo novo
   aNCDatAlt - Data a não ser considerada
   aNCCodCcu - Centro de Custo a não ser considerado */
PROCEDURE QL_INCCCUSTO(ANUMEMPINC NUMBER(4),ATIPCOLINC NUMBER(1),ANUMCADINC NUMBER(9),ADATALTINC DATE,ACODCCUINC VARCHAR2(18),ANCDATALT DATE,ANCCODCCU VARCHAR2(18))
 IS

xPrxDatAlt   R038HCC.DATALT%TYPE;
  xPrxCodCcu   R038HCC.CODCCU%TYPE;
  xAntDatAlt   R038HCC.DATALT%TYPE;
  xAntCodCcu   R038HCC.CODCCU%TYPE;

  xDatTmp   R038HCC.DATALT%TYPE;
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
BEGIN
  /* Verifica se é para atualizar o Quadro Efetivo. */
  QL_RETATUQUA(aNumEmpInc, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);
  IF (xAtuQua = 'S') AND (xCtlQua = 1) AND ((xConTpV = 'S') OR (aTipColInc = 1)) THEN
    xDatTmp := '31/12/1900,00:00:00';

    /* Retorna os dados (data e Centro de Custo) da próxima alteração de Centro de Custo */
    QL_RETPROCCU(aNumEmpInc, aTipColInc, aNumCadInc, aDatAltInc, xPrxDatAlt OUT, xPrxCodCcu OUT, aNCDatAlt, aNCCodCcu);

    /* Retorna os dados (data e Centro de Custo) da alteração de Centro de Custo anterior */
    QL_RETCCUANT(aNumEmpInc, aTipColInc, aNumCadInc, aDatAltInc, xAntDatAlt OUT, xAntCodCcu OUT, aNCDatAlt, aNCCodCcu);

    /* Se não houver próximo Centro de Custo, seta a Data da Próxima alteração de Centro de Custo como sendo futura. */
    IF (xPrxDatAlt = xDatTmp) THEN
      xPrxDatAlt := '04/06/2080,00:00:00';
    END IF;

    /* Decrementa 1 do Efetivo do Centro de Custo anterior no período da Data da Operação até a Data da próxima Alteração de Centro de Custo.
       Somente se existir um Centro de Custo anterior */
    IF (xAntCodCcu <> ' ') THEN
      QL_ATUQUAEFE(aNumEmpInc, aTipColInc, aNumCadInc, 0, xAntCodCcu, 0, ' ', 0, 0, 0, aDatAltInc, xPrxDatAlt, -1, 'N', 'N', aNCDatAlt, 0, aNCCodCcu, 0, ' ', 0, 0, 0, xDatTmp);
    END IF;

    /* Incrementa 1 no Efetivo para o novo Centro de Custo no período da Data da Operação até a Data da próxima Alteração de Centro de Custo */
    QL_ATUQUAEFE(aNumEmpInc, aTipColInc, aNumCadInc, 0, aCodCcuInc, 0, ' ', 0, 0, 0, aDatAltInc, xPrxDatAlt, 1, 'S', 'N', aNCDatAlt, 0, aNCCodCcu, 0, ' ', 0, 0, 0, xDatTmp);
  END IF;
END␀èÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;08QL_RETATUQUA
QL_RETPROESC
QL_RETESCANT
QL_ATUQUAEFE
‹	␀␀/* Procedure que processa a Atualização do Quadro de Lotação efetivo na Inclusão do Escala/Horário
   aNumEmpInc - Empresa
   aTipColInc - Tipo
   aNumCadInc - Cadastro
   aDatAltInc - Data da operação
   aCodEscInc - Escala/Horário novo
   aNCDatAlt - Data a não ser considerada
   aNCCodEsc - Escala/Horário a não ser considerado */
PROCEDURE QL_INCESCALA(ANUMEMPINC NUMBER(4),ATIPCOLINC NUMBER(1),ANUMCADINC NUMBER(9),ADATALTINC DATE,ACODESCINC NUMBER(9),ANCDATALT DATE,ANCCODESC NUMBER(9))
 IS

xPrxDatAlt   R038HES.DATALT%TYPE;
  xPrxCodEsc   R038HES.CODESC%TYPE;
  xAntDatAlt   R038HES.DATALT%TYPE;
  xAntCodEsc   R038HES.CODESC%TYPE;

  xDatTmp   R038HES.DATALT%TYPE;
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
BEGIN
  /* Verifica se é para atualizar o Quadro Efetivo. */
  QL_RETATUQUA(aNumEmpInc, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);
  IF (xAtuQua = 'S') AND (xUsaTur = 'S') AND ((xConTpV = 'S') OR (aTipColInc = 1)) THEN
    xDatTmp := '31/12/1900,00:00:00';

    /* Retorna os dados (data e Escala/Horário) da próxima alteração de Escala/Horário */
    QL_RETPROESC(aNumEmpInc, aTipColInc, aNumCadInc, aDatAltInc, xPrxDatAlt OUT, xPrxCodEsc OUT, aNCDatAlt, aNCCodEsc);

    /* Retorna os dados (data e Escala/Horário) da alteração de Escala/Horário anterior */
    QL_RETESCANT(aNumEmpInc, aTipColInc, aNumCadInc, aDatAltInc, xAntDatAlt OUT, xAntCodEsc OUT, aNCDatAlt, aNCCodEsc);

    /* Se não houver próximo Escala/Horário, seta a Data da Próxima alteração de Escala/Horário como sendo futura. */
    IF (xPrxDatAlt = xDatTmp) THEN
      xPrxDatAlt := '04/06/2080,00:00:00';
    END IF;

    /* Decrementa 1 do Efetivo do Escala/Horário anterior no período da Data da Operação até a Data da próxima Alteração de Escala/Horário.
       Somente se existir um Escala/Horário anterior */
    IF (xAntCodEsc > 0) THEN
      QL_ATUQUAEFE(aNumEmpInc, aTipColInc, aNumCadInc, 0, ' ', 0, ' ', xAntCodEsc, 0, 0, aDatAltInc, xPrxDatAlt, -1, 'N', 'N', aNCDatAlt, 0, ' ', 0, ' ', aNCCodEsc, 0, 0, xDatTmp);
    END IF;

    /* Incrementa 1 no Efetivo para o novo Escala/Horário no período da Data da Operação até a Data da próxima Alteração de Escala/Horário */
    QL_ATUQUAEFE(aNumEmpInc, aTipColInc, aNumCadInc, 0, ' ', 0, ' ', aCodEscInc, 0, 0, aDatAltInc, xPrxDatAlt, 1, 'S', 'N', aNCDatAlt, 0, ' ', 0, ' ', aNCCodEsc, 0, 0, xDatTmp);
  END IF;
END␀éÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;08QL_RETATUQUA
QL_RETFILANT
QL_RETPROFIL
QL_ATUQUAEFE
â␀␀/* Procedure que processa a Atualização do Quadro de Lotação efetivo na Inclusão da Filial
   aNumEmpInc - Empresa
   aTipColInc - Tipo
   aNumCadInc - Cadastro
   aDatAltInc - Data da operação
   aEmpAtuInc - Empresa Filial nova
   aCodFilInc - Filial nova
   aNCDatAlt - Data a não ser considerada
   aNCEmpAtu - Empresa Filial a não ser considerada
   aNCCodFil - Filial a não ser considerada */
PROCEDURE QL_INCFILIAL(ANUMEMPINC NUMBER(4),ATIPCOLINC NUMBER(1),ANUMCADINC NUMBER(9),ADATALTINC DATE,AEMPATUINC NUMBER(4),ACODFILINC NUMBER,ANCDATALT DATE,ANCEMPATU NUMBER(4),ANCCODFIL NUMBER)
 IS

xPrxDatAlt   R038HFI.DATALT%TYPE;
  xPrxEmpAtu   R038HFI.EMPATU%TYPE;
  xPrxCodFil   R038HFI.CODFIL%TYPE;
  xAntDatAlt   R038HFI.DATALT%TYPE;
  xAntEmpAtu   R038HFI.EMPATU%TYPE;
  xAntCodFil   R038HFI.CODFIL%TYPE;

  xDatTmp   R038HFI.DATALT%TYPE;
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
BEGIN
  /* Verifica se é para atualizar o Quadro Efetivo. */
  QL_RETATUQUA(aNumEmpInc, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);
  IF (xAtuQua = 'S') AND ((xConTpV = 'S') OR (aTipColInc = 1)) THEN
    xDatTmp := '31/12/1900,00:00:00';

    /* Retorna os dados (data e Filial) da alteração de Filial anterior */
    QL_RETFILANT(aNumEmpInc, aTipColInc, aNumCadInc, aDatAltInc, xAntDatAlt OUT, xAntEmpAtu OUT, xAntCodFil OUT, aNCDatAlt, aNCEmpAtu, aNCCodFil);

    /* Se é o primeiro histórico de filial, registra efetivo a partir da data */
    IF (xAntDatAlt = xDatTmp) THEN
      /* Retorna os dados (data e Filial) da próxima alteração de Filial */
      QL_RETPROFIL(aNumEmpInc, aTipColInc, aNumCadInc, aDatAltInc, xPrxDatAlt OUT, xPrxEmpAtu OUT, xPrxCodFil OUT, aNCDatAlt, aNCEmpAtu, aNCCodFil);

      /* Se não houver próximo Filial, seta a Data da Próxima alteração de Filial como sendo futura. */
      IF (xPrxDatAlt = xDatTmp) THEN
        xPrxDatAlt := '04/06/2080,00:00:00';
      END IF;

      /* Incrementa 1 no Efetivo no período da Data da Operação até a Data da próxima Alteração de Filial */
      QL_ATUQUAEFE(aNumEmpInc, aTipColInc, aNumCadInc, 0, ' ', 0, ' ', 0, 0, 0, aDatAltInc, xPrxDatAlt, 1, 'S', 'S', aNCDatAlt, 0, ' ', 0, ' ', 0, 0, 0, xDatTmp);
    END IF;
  END IF;
END␀êÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0FQL_RETATUQUA
QL_RETPROLOC
QL_RETLOCANT
QL_RETLOCNIV
QL_ATUQUAEFE
4␀␀/* Procedure que processa a Atualização do Quadro de Lotação efetivo na Inclusão do Local
   aNumEmpInc - Empresa
   aTipColInc - Tipo
   aNumCadInc - Cadastro
   aDatAltInc - Data da operação
   aTabOrgInc - Organ. nova
   aNumLocInc - Local novo
   aNCDatAlt - Data a não ser considerada
   aNCTabOrg - Organograma a não ser considerada
   aNCNumLoc - Local a não ser considerado */
PROCEDURE QL_INCLOCAL(ANUMEMPINC NUMBER(4),ATIPCOLINC NUMBER(1),ANUMCADINC NUMBER(9),ADATALTINC DATE,ATABORGINC NUMBER(4),ANUMLOCINC NUMBER(9),ANCDATALT DATE,ANCTABORG NUMBER(4),ANCNUMLOC NUMBER(9))
 IS

xPrxDatAlt   R038HLO.DATALT%TYPE;
  xPrxTabOrg   R038HLO.TABORG%TYPE;
  xPrxNumLoc   R038HLO.NUMLOC%TYPE;
  xAntDatAlt   R038HLO.DATALT%TYPE;
  xAntTabOrg   R038HLO.TABORG%TYPE;
  xAntNumLoc   R038HLO.NUMLOC%TYPE;

  xAntNumLocNiv   R038HLO.NUMLOC%TYPE;
  xNumLocNivInc   R038HLO.NUMLOC%TYPE;

  xDatTmp   R038HLO.DATALT%TYPE;
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
  xLocCcu VARCHAR2(18);
  xNCLocCcu VARCHAR2(18);
BEGIN
  /* Verifica se é para atualizar o Quadro Efetivo. */
  QL_RETATUQUA(aNumEmpInc, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);
  IF (xAtuQua = 'S') AND (xCtlQua = 0) AND ((xConTpV = 'S') OR (aTipColInc = 1)) THEN
    xDatTmp := '31/12/1900,00:00:00';

    /* Retorna os dados (data e Local) da próxima alteração de Local */
    QL_RETPROLOC(aNumEmpInc, aTipColInc, aNumCadInc, aDatAltInc, xPrxDatAlt OUT, xPrxTabOrg OUT, xPrxNumLoc OUT, aNCDatAlt, aNCTabOrg, aNCNumLoc);

    /* Retorna os dados (data e Local) da alteração de Local anterior */
    QL_RETLOCANT(aNumEmpInc, aTipColInc, aNumCadInc, aDatAltInc, xAntDatAlt OUT, xAntTabOrg OUT, xAntNumLoc OUT, aNCDatAlt, aNCTabOrg, aNCNumLoc);

    /* Retorna o Local do Nível do Quadro */
    IF (xAntTabOrg > 0) THEN
      QL_RETLOCNIV(xAntTabOrg, xAntNumLoc, xAntDatAlt, xAntNumLocNiv OUT);

      QL_RETLOCNIV(aTabOrgInc, aNumLocInc, aDatAltInc, xNumLocNivInc OUT);
    ELSE
      xAntNumLocNiv := xAntNumLoc;
      xNumLocNivInc := aNumLocInc;
    END IF;

    IF (xAntTabOrg <> aTabOrgInc) OR (xAntNumLocNiv <> xNumLocNivInc) THEN
      /* Se não houver próximo Local, seta a Data da Próxima alteração de Local como sendo futura. */
      IF (xPrxDatAlt = xDatTmp) THEN
        xPrxDatAlt := '04/06/2080,00:00:00';
      END IF;

      /* Decrementa 1 do Efetivo do Local anterior no período da Data da Operação até a Data da próxima Alteração de Local.
         Somente se existir um Local anterior */
      IF (xAntTabOrg > 0) THEN
        xLocCcu := CONVERT(NUMBER_TO_CHAR, xAntNumLoc);
        xNCLocCcu := CONVERT(NUMBER_TO_CHAR, aNCNumLoc);
        QL_ATUQUAEFE(aNumEmpInc, aTipColInc, aNumCadInc, xAntTabOrg, xLocCcu, 0, ' ', 0, 0, 0, aDatAltInc, xPrxDatAlt, -1, 'N', 'N', aNCDatAlt, aNCTabOrg, xNCLocCcu, 0, ' ', 0, 0, 0, xDatTmp);
      END IF;

      /* Incrementa 1 no Efetivo para o novo Local no período da Data da Operação até a Data da próxima Alteração de Local */
      xLocCcu := CONVERT(NUMBER_TO_CHAR, aNumLocInc);
      xNCLocCcu := CONVERT(NUMBER_TO_CHAR, aNCNumLoc);
      QL_ATUQUAEFE(aNumEmpInc, aTipColInc, aNumCadInc, aTabOrgInc, xLocCcu, 0, ' ', 0, 0, 0, aDatAltInc, xPrxDatAlt, 1, 'S', 'N', aNCDatAlt, aNCTabOrg, xNCLocCcu, 0, ' ', 0, 0, 0, xDatTmp);
    END IF;
  END IF;
END␀ëÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;08QL_RETATUQUA
QL_RETPROVIN
QL_RETVINANT
QL_ATUQUAEFE
\	␀␀/* Procedure que processa a Atualização do Quadro de Lotação efetivo na Inclusão do Vínculo
   aNumEmpInc - Empresa
   aTipColInc - Tipo
   aNumCadInc - Cadastro
   aDatAltInc - Data da operação
   aCodVinInc - Novo Vínculo
   aNCDatAlt - Data a não ser considerada
   aNCCodVin - Vínculo a não ser considerado */
PROCEDURE QL_INCVINCULO(ANUMEMPINC NUMBER(4),ATIPCOLINC NUMBER(1),ANUMCADINC NUMBER(9),ADATALTINC DATE,ACODVININC NUMBER(2),ANCDATALT DATE,ANCCODVIN NUMBER(3))
 IS

xPrxDatAlt   R038HVI.DATALT%TYPE;
  xPrxCodVin   R038HVI.CODVIN%TYPE;
  xPrxTipVag   R022VAG.TIPVAG%TYPE;
  xAntDatAlt   R038HVI.DATALT%TYPE;
  xAntCodVin   R038HVI.CODVIN%TYPE;
  xAntTipVag   R022VAG.TIPVAG%TYPE;

  xDatTmp   R038HVI.DATALT%TYPE;
  xAtuQua CHAR;
  xCtlQua NUMBER(1);
  xUsaTur CHAR;
  xConTpV CHAR;
BEGIN
  /* Verifica se é para atualizar o Quadro Efetivo. */
  QL_RETATUQUA(aNumEmpInc, xAtuQua OUT, xCtlQua OUT, xUsaTur OUT, xConTpV OUT);
  IF (xAtuQua = 'S') AND (xConTpV = 'S') THEN
    xDatTmp := '31/12/1900,00:00:00';

    /* Retorna os dados (data e vínculo) da próxima alteração de vínculo */
    QL_RETPROVIN(aNumEmpInc, aTipColInc, aNumCadInc, aDatAltInc, xPrxDatAlt OUT, xPrxCodVin OUT, xPrxTipVag OUT, aNCDatAlt, aNCCodVin);

    /* Retorna os dados (data e vínculo) da alteração de vínculo anterior */
    QL_RETVINANT(aNumEmpInc, aTipColInc, aNumCadInc, aDatAltInc, xAntDatAlt OUT, xAntCodVin OUT, xAntTipVag OUT, aNCDatAlt, aNCCodVin);

    /* Se não houver próximo Local, seta a Data da Próxima alteração de Local como sendo futura. */
    IF (xPrxDatAlt = xDatTmp) THEN
      xPrxDatAlt := '04/06/2080,00:00:00';
    END IF;

    /* Decrementa 1 do Efetivo do Local anterior no período da Data da Operação até a Data da próxima Alteração de Local.
       Somente se existir um Local anterior */
    IF (xAntCodVin > 0) THEN
      QL_ATUQUAEFE(aNumEmpInc, aTipColInc, aNumCadInc, 0, ' ', 0, ' ', 0, 0, xAntCodVin, aDatAltInc, xPrxDatAlt, -1, 'N', 'N', aNCDatAlt, 0, ' ', 0, ' ', 0, 0, aNCCodVin, xDatTmp);
    END IF;

    /* Incrementa 1 no Efetivo para o novo Local no período da Data da Operação até a Data da próxima Alteração de Local */
    QL_ATUQUAEFE(aNumEmpInc, aTipColInc, aNumCadInc, 0, ' ', 0, ' ', 0, 0, aCodVinInc, aDatAltInc, xPrxDatAlt, 1, 'S', 'N', aNCDatAlt, 0, ' ', 0, ' ', 0, 0, aNCCodVin, xDatTmp);
  END IF;
END␀ìÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
8␀␀PROCEDURE QL_MANTERHISTREQ(L_AMANHRR OUT NUMBER(1))
 IS

l_xManHRR NUMBER(1);  
BEGIN
  L_AMANHRR := 0;
	
  BEGIN
		SELECT IFNULL(MANHRR, 2) INTO l_xManHRR FROM R000ASS;
	EXCEPTION
		WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler o campo ManHRR da tabela R000ASS.';
  END;
     
  L_AMANHRR := l_xManHRR; 
END␀íÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ò␀␀PROCEDURE QL_POSTOAUT(L_AESTPOS NUMBER(3),L_APOSTRA VARCHAR2(25),L_ADATPOS DATE,L_ACODTAP NUMBER(3),L_APOSAUT OUT CHAR)
 IS

l_xDatZer DATE;
  l_xPosTra VARCHAR2(25);
BEGIN
  l_xDatZer := '31/12/1900,00:00:00';
  BEGIN
    SELECT R017POS.POSTRA, 'S' POSATU INTO l_xPosTra, l_aPosAut FROM R017POS, R017HCV, R017TAP
     WHERE R017POS.ESTPOS = R017HCV.ESTPOS
       AND R017POS.POSTRA = R017HCV.POSTRA
       AND R017HCV.DATALT = (SELECT MAX(R017HCV2.DATALT) FROM R017HCV R017HCV2
                              WHERE R017HCV2.ESTPOS = R017HCV.ESTPOS
                                AND R017HCV2.POSTRA = R017HCV.POSTRA
                                AND R017HCV2.DATALT <= l_aDatPos)
       AND R017TAP.CODTAP = l_aCodTap
       AND R017TAP.CONVAG = 'S' /* Contabiliza vaga */
       AND (R017HCV.TIPCVA = 1 OR R017HCV.TIPCVA = 2) /* Controla vagas na data de referência */
       AND R017POS.ESTPOS = l_aEstPos
       AND R017POS.DATCRI <= l_aDatPos
       AND (R017POS.DATEXT >= l_aDatPos OR R017POS.DATEXT = l_xDatZer)
       AND R017POS.POSTRA = l_aPosTra;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_aPosAut := 'N';
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao buscar informações do posto de trabalho autorizado.';
  END;
END␀îÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0HQL_BUSPOSTRA
QL_ATUEFEPOS
QL_AJUQTDEFE
QL_PROCEPOSAD
SP_LOGEFETIVO
_␀␀PROCEDURE QL_PROCEAFA(L_ATIPOPE CHAR,L_ANUMEMP NUMBER(4),L_ATIPCOL NUMBER(1),L_ANUMCAD NUMBER(9),L_ASITAFA NUMBER(2),L_AESTPOS NUMBER(3),L_ACODPLV NUMBER(4),L_ADATAFA DATE,L_ADATTER DATE,L_ACAUDEM NUMBER(2))
 IS

l_xTipSit NUMBER(2);
  l_xAfaQua CHAR;
  l_xTipOpe CHAR;
  l_xPosTra VARCHAR2(25);
  l_xIniAtu DATE;
  l_xTerAtu DATE;
  l_xDatTer DATE;
  l_xDatAfa DATE;
  l_xQtdDem NUMBER(6);
  l_xQtdAfa NUMBER(6);
  l_xQtdFut NUMBER(6);
  l_xCarQua NUMBER(3);
  l_xDatZer DATE;
  l_xDatFut DATE;
  l_DatTerInc DATE;
  l_xTipTsf CHAR;
  l_xEstPos NUMBER(3);
  l_QtdAfaEfe   R092EFE.QTDAFA%TYPE;
BEGIN
  l_xDatZer := '31/12/1900,00:00:00';
  l_xDatFut := '04/06/2080,00:00:00';
  l_xTipOpe := l_aTipOpe;
  l_xDatTer := l_aDatTer;
  l_xDatAfa := l_aDatAfa;
  
  IF ((l_aTipOpe = 'D') OR (l_aTipOpe = 'O')) THEN
  	l_xQtdDem := 1;
  	l_xQtdAfa := -1;
  	l_xQtdFut := 0;
  	IF (l_xTipOpe = 'O') THEN
  		l_xTipOpe := 'U';
  	END IF;
  ELSE
  	IF ((l_aTipOpe = 'I') OR (l_aTipOpe = 'U')) THEN
  		l_xQtdDem := -1;
  		l_xQtdAfa := 1;
  		l_xQtdFut := -1;
  	END IF;
  END IF;

  QL_BUSPOSTRA(l_aNumEmp, l_aTipCol, l_aNumCad, l_xDatAfa, l_xEstPos OUT, l_xPosTra OUT, l_xIniAtu OUT, l_xTerAtu OUT);
  IF ((l_xPosTra <> ' ') AND (l_xEstPos = l_aEstPos)) THEN
    /* Busca Tipo afastamento / Considera afastado quadro */
    BEGIN
      SELECT IFNULL(TIPSIT, 0), IFNULL(AFAQUA, 'N'), IFNULL(CARQUA, 0) INTO l_xTipSit, l_xAfaQua, l_xCarQua FROM R010SIT
       WHERE CODSIT = l_aSitAfa;
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao buscar situação do colaborador.';
    END;
    /* Caso demissão contabiliza da R038HPO */
    IF (l_xTipSit = 7) THEN
      QL_ATUEFEPOS(l_xTipOpe, 'R038HPO', l_aNumEmp, l_aEstPos, l_aCodPlv, l_xPosTra, l_xQtdDem, l_xDatAfa, 'N', 'N', 'N');
      QL_AJUQTDEFE('R038HPO', l_aEstPos, l_aCodPlv, l_xPosTra, l_xDatAfa, l_xDatFut, l_xQtdDem);
      QL_PROCEPOSAD(l_xTipOpe, 'R038HPO', l_aNumEmp, l_aTipCol, l_aNumCad, l_aEstPos, l_aCodPlv, l_xDatAfa, l_xDatFut, l_xQtdDem);
    ELSE
      /* Para os outros afastamentos gera registro da R038AFA */
	  l_xDatAfa := DATETIMEADD(DD, l_xCarQua, l_xDatAfa);
	  IF (l_xDatAfa > l_xDatFut) THEN
	  	l_xDatAfa := l_xDatFut;
	  END IF;

	  l_DatTerInc := l_xDatFut;
	  IF (l_aDatTer = l_xDatZer) THEN
	  	l_xDatTer := l_xDatFut; /* 04/06/2080,00:00:00 */
	  ELSE
	    /* Verifica se é o ultimo dia, não permite processar a proxima data */
	  	IF (l_aDatTer < l_xDatFut) THEN
	  		l_DatTerInc := DATETIMEADD(DD, 1, l_aDatTer);
	  	END IF;
	  	l_xDatTer := l_aDatTer;
	  END IF;	
      
      IF (l_xAfaQua = 'S') AND (l_xDatTer > l_xDatAfa) THEN
        /* Incrementa até data máxima */
        QL_ATUEFEPOS(l_xTipOpe, 'R038AFA', l_aNumEmp, l_aEstPos, l_aCodPlv, l_xPosTra, l_xQtdAfa, l_xDatAfa, 'N', 'N', 'N');
        QL_AJUQTDEFE('R038AFA', l_aEstPos, l_aCodPlv, l_xPosTra, l_xDatAfa, l_xDatTer, l_xQtdAfa);
        
        IF (l_xDatFut > l_DatTerInc) THEN        
          /* Verifica se existe registro de efetivção para os parâmetros informados */
	  	  BEGIN
	  	  	SELECT
	  	  		IFNULL(R092EFE.QTDAFA, 0)
	  	  	INTO
	  	  		l_QtdAfaEfe
	  	  	FROM
	  	  		R092EFE
	  	  	WHERE
	  	  		ESTPOS = l_aEstPos AND CODPLV = l_aCodPlv AND POSTRA = l_xPosTra AND DATEFE = l_DatTerInc;
	  	  EXCEPTION
	  	  /* Caso não existir o registro */
	  	  	WHEN NO_DATA_FOUND THEN
	  	  		l_QtdAfaEfe := -1;
	  	  END;
          
          /* Caso não existir o registro inserimos ele com os valores do último registro - 1 */
          IF (l_QtdAfaEfe = -1) THEN
          	QL_ATUEFEPOS(l_xTipOpe, 'R038AFA', l_aNumEmp, l_aEstPos, l_aCodPlv, l_xPosTra, l_xQtdFut, l_DatTerInc, 'N', 'N', 'N');
          END IF;
        END IF;
        
        QL_PROCEPOSAD(l_xTipOpe, 'R038AFA', l_aNumEmp, l_aTipCol, l_aNumCad, l_aEstPos, l_aCodPlv, l_xDatAfa, l_xDatTer, l_xQtdAfa);
      END IF;
    END IF;
  ELSE
    SP_LOGEFETIVO(l_aNumEmp, l_aCodPlv, l_aEstPos, l_xPosTra, l_xDatAfa, l_xQtdAfa, l_xTipOpe, 4, 'Afastamento não contabilizado no quadro do efetivo por motivo do posto não estar adequado.');
  END IF;
END␀ïÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0QL_ATUEFEPOS
QL_AJUQTDEFE
1␀␀PROCEDURE QL_PROCECPE(L_ATIPOPE CHAR,L_ANUMEMP NUMBER(4),L_AESTPOS NUMBER(3),L_ACODPLV NUMBER(4),L_ACODRQU NUMBER(9),L_ADATCPE DATE)
 IS

l_xTipOpe CHAR;
	l_xPosTra VARCHAR2(25);
	l_xQtdCpe NUMBER(6);
	l_xDatFut DATE;
	l_xDatCpe DATE;
BEGIN
	l_xDatFut := '04/06/2080,00:00:00';
	l_xTipOpe := l_aTipOpe;
	l_xDatCpe := l_aDatCpe;
	
	IF ((l_xTipOpe = 'O') OR (l_xTipOpe = 'D')) THEN
    	IF (l_xTipOpe = 'O') THEN
			l_xTipOpe := 'U';
		END IF;
    	l_xQtdCpe := 1;
  	ELSE
    	IF (l_xTipOpe = 'U') THEN
      		l_xQtdCpe := -1;
		END IF;
	END IF;

  	BEGIN
    	SELECT POSTRA INTO l_xPosTra FROM R126RQU WHERE CODRQU = l_aCodRqu;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN 
			l_xPosTra := ' ';
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar posto de trabalho da requisição.';
  	END;

	IF (l_xPosTra <> ' ') THEN
		QL_ATUEFEPOS(l_xTipOpe, 'R126RQU', l_aNumEmp, l_aEstPos, l_aCodPlv, l_xPosTra, l_xQtdCpe, l_xDatCpe, 'N', 'N', 'N');
		QL_AJUQTDEFE('R126RQU', l_aEstPos, l_aCodPlv, l_xPosTra, l_xDatCpe, l_xDatFut, l_xQtdCpe);
	END IF;
END␀ğÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0DQL_BUSPOSTRA
QL_ATUEFEPOS
QL_AJUQTDEFE
QL_VERMODQL
QL_POSTOAUT
l␀␀PROCEDURE QL_PROCEHPO(L_XTIPOPE CHAR,L_ANUMEMP NUMBER(4),L_ATIPCOL NUMBER(1),L_ANUMCAD NUMBER(9),L_AESTPOS NUMBER(3),L_ACODPLV NUMBER(4),L_APOSTRA VARCHAR2(25),L_AINIATU DATE,L_ATERATU DATE,L_AHISPRI CHAR,L_ACODTAP NUMBER(3))
 IS

l_xQtdOld NUMBER(6);
  l_xQtdOpe NUMBER(6);
  l_xIniAnt DATE;
  l_xTerAnt DATE;
  l_xTerOld DATE;
  l_xDatFut DATE;
  l_xTerAtu DATE;
  l_xDatPrimFil DATE;
  l_xPosOld VARCHAR2(25);
  l_xPosAut CHAR;
  l_xIndCon CHAR;
  l_xEstPos NUMBER(3);	
BEGIN
  l_xDatFut := '04/06/2080,00:00:00';
  l_xTerAtu := l_aTerAtu;

  IF (l_xTerAtu = DATETIME(31,12,1900,0,0,0)) THEN
    l_xTerAtu := '04/06/2080,00:00:00';
  END IF;

  IF (l_xTipOpe = 'I') THEN
    l_xQtdOld := -1;
    l_xQtdOpe := 1;
  ELSE
    IF (l_xTipOpe = 'D') THEN
      l_xQtdOld := 1;
      l_xQtdOpe := -1;
    END IF;
  END IF;

  /* Apenas para posto principal - busca o posto anterior para debita-lo */
  IF (l_aHisPri = 'S') THEN
    l_xTerAnt := DATETIMEADD(DD, -1, l_aIniAtu);
    QL_BUSPOSTRA(l_aNumEmp, l_aTipcol, l_aNumCad, l_xTerAnt, l_xEstPos OUT, l_xPosOld OUT, l_xIniAnt OUT, l_xTerOld OUT);
    IF ((l_xPosOld <> ' ') AND (l_xEstPos = l_aEstPos)) THEN
      SELECT MIN(DATALT)
	  INTO	 l_xDatPrimFil
	  FROM	 R038HFI
	  WHERE	 NUMEMP = l_aNumEmp
	  AND	 TIPCOL = l_aTipcol
	  AND	 NUMCAD = l_aNumCad;
	  IF (l_xDatPrimFil <> l_aIniAtu) THEN
	    QL_ATUEFEPOS(l_xTipOpe, 'R038HPO', l_aNumEmp, l_aEstPos, l_aCodPlv, l_xPosOld, l_xQtdOld, l_aIniAtu, 'N', 'N', 'N');
        QL_AJUQTDEFE('R038HPO', l_aEstPos, l_aCodPlv, l_xPosOld, l_aIniAtu, l_xDatFut, l_xQtdOld);
	  END IF;
    END IF;
  END IF;
  /* Verifica se o colaborador está indicado no módulo QL. */
  QL_VERMODQL(l_aNumEmp, l_aTipCol, l_aNumCad, l_xIndCon OUT);
  IF (l_xIndCon <> 'N') THEN
    QL_POSTOAUT(l_aEstPos, l_aPosTra, l_aIniAtu, l_aCodTap, l_xPosAut OUT);
  END IF;	
  IF (l_xPosAut = 'S') THEN
    QL_ATUEFEPOS(l_xTipOpe, 'R038HPO', l_aNumEmp, l_aEstPos, l_aCodPlv, l_aPosTra, l_xQtdOpe, l_aIniAtu, 'N', 'N', 'N');
    QL_AJUQTDEFE('R038HPO', l_aEstPos, l_aCodPlv, l_aPosTra, l_aIniAtu, l_xTerAtu, l_xQtdOpe);
  END IF;
END␀ñÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0QL_ATUEFEPOS
QL_AJUQTDEFE
É␀␀PROCEDURE QL_PROCEPOSAD(L_ATIPOPE CHAR,L_ATABOPE VARCHAR2(7),L_ANUMEMP NUMBER(4),L_ATIPCOL NUMBER(1),L_ANUMCAD NUMBER(9),L_AESTPOS NUMBER(3),L_ACODPLV NUMBER(4),L_ADATOPE DATE,L_ADATFIM DATE,L_AQTDEFE NUMBER(6))
 IS

l_xPosTra   R038HPO.PosTra%TYPE;

  /* Curso para buscar postos adicionais de um colabordor */
  CURSOR l_xPostos IS
         SELECT R038HPO.POSTRA
           FROM R038HPO, R017TAP, R017HCV
          WHERE R038HPO.CODTAP = R017TAP.CODTAP
            AND R038HPO.NUMEMP = l_aNumEmp
            AND R038HPO.TIPCOL = l_aTipCol
            AND R038HPO.NUMCAD = l_aNumCad
            AND R038HPO.NUMCAD = l_aEstPos
            AND R038HPO.ESTPOS = R017HCV.ESTPOS
            AND R038HPO.POSTRA = R017HCV.POSTRA
            AND R017HCV.DATALT = (SELECT MAX(R017HCV2.DATALT) FROM R017HCV R017HCV2
                                   WHERE R017HCV2.ESTPOS = R017HCV.ESTPOS
                                     AND R017HCV2.POSTRA = R017HCV.POSTRA
                                     AND R017HCV2.DATALT <= l_aDatOpe)
            AND (R017HCV.TIPCVA = 1 OR R017HCV.TIPCVA = 2) /* Controla vagas na data de referência */
            AND R017TAP.CONVAG = 'S' /* Contabiliza vaga */
            AND R017TAP.HISPRI = 'N' /* Histórico adicional */
            AND R038HPO.INIATU <= l_aDatOpe
            AND R038HPO.TERATU >= l_aDatOpe;
BEGIN
  /* Para cada posto encontrado gera registro na data de origem e ajusta o período */
  FOREACH l_xPostos INTO l_xPosTra
  LOOP
    QL_ATUEFEPOS(l_aTipOpe, l_aTabOpe, l_aNumEmp, l_aEstPos, l_aCodPlv, l_xPosTra, l_aQtdEfe, l_aDatOpe, 'N', 'N', 'N');
    QL_AJUQTDEFE(l_aTabOpe, l_aEstPos, l_aCodPlv, l_xPosTra, l_aDatOpe, l_aDatFim, l_aQtdEfe);
  END LOOP;
END␀òÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0pQL_MANTERHISTREQ
QL_POSTOAUT
GETQTDADMITIDOSRQU
QL_SALDORQU
QL_AJUSTARSALDORQU
QL_ATUEFEPOS
QL_AJUQTDEFE
c␀␀PROCEDURE QL_PROCERQU(L_ATIPOPE CHAR,L_ANUMEMP NUMBER(4),L_AESTPOS NUMBER(3),L_ACODPLV NUMBER(4),L_APOSTRA VARCHAR2(25),L_AQTDRQU NUMBER(4),L_ADATRQU DATE,L_ANEWSIT NUMBER(1),L_AOLDSIT NUMBER(1),L_ACODTAP NUMBER(3),L_ACODRQU NUMBER(9))
 IS

l_xPosAut CHAR;
  	l_xTipOpe CHAR;
  	l_xSalRqu NUMBER(6);
  	l_xDatFut DATE;
	l_xManHRR NUMBER(1);
	lp_CodRqu   R126CPE.CodRqu%TYPE;
	lp_DatAdm   R126CPE.DatAdm%TYPE;
	l_DatAdm    R126CPE.DatAdm%TYPE;
	l_DatIni  DATE;
	l_DatFim  DATE;
		
    /* Curso para buscar os colaboradores efetivados no RS */
    CURSOR c_CandidatosAdmitidos IS
         SELECT DISTINCT R126CPE.DATADM
           FROM R126CPE
          WHERE R126CPE.CODRQU = lp_CodRqu
            AND R126CPE.DATADM > lp_DatAdm
            AND R126CPE.CANEFE = 'S'
	   ORDER BY R126CPE.DATADM;
	   
	l_Nao_Iniciada NUMBER(1);
	l_Em_Andamento NUMBER(1);
	l_Cancelada NUMBER(1);
	l_Finalizada NUMBER(1);
	l_Proposta NUMBER(1);
	l_Suspensa NUMBER(1);
BEGIN
	l_Nao_Iniciada := 0;
	l_Em_Andamento := 1;
	l_Cancelada := 2;
	l_Finalizada := 3;
	l_Proposta := 4;
	l_Suspensa := 5;
	
	l_xDatFut := '04/06/2080,00:00:00';
	l_xTipOpe := l_aTipOpe;
	l_xSalRqu := 0;
	
	QL_MANTERHISTREQ(l_xManHRR OUT);
	QL_POSTOAUT(l_aEstPos, l_aPosTra, l_aDatRqu, l_aCodTap, l_xPosAut OUT);
 	IF (l_xPosAut = 'S') THEN
	    IF (l_xManHRR = 1) THEN
	    	GETQTDADMITIDOSRQU(l_aCodRqu, l_aDatRqu, l_xSalRqu OUT);
        	l_xSalRqu := (l_aQtdRqu - l_xSalRqu);
        ELSE
	    	QL_SALDORQU(l_aCodRqu, l_aQtdRqu, l_xSalRqu OUT);
		END IF;
		
    	IF (l_xTipOpe = 'I') THEN
			l_xSalRqu := l_xSalRqu;
		ELSE
			IF ((l_xTipOpe = 'O') OR (l_xTipOpe = 'D')) THEN
				IF (l_xTipOpe = 'O') THEN
   	      			l_xTipOpe := 'U';
    	   		END IF;
       			l_xSalRqu := l_xSalRqu *(-1);
      		ELSE
        		IF (l_xTipOpe = 'S') THEN				
					l_xTipOpe := 'U';					
					IF (l_xManHRR = 1) THEN
						/* ============================================================================================================= */	
					    l_DatIni := l_aDatRqu;
						lp_CodRqu := l_aCodRqu;
						lp_DatAdm := l_aDatRqu;
						/* Le Registro do CURSOR */
  						FOREACH c_CandidatosAdmitidos INTO l_DatAdm
						LOOP
						    l_DatFim := (l_DatAdm-1);
  							QL_AJUSTARSALDORQU(l_aOldSit, l_aNewSit, l_aNumEmp, l_aEstPos, l_aCodPlv, l_aPosTra, l_aCodRqu, l_DatIni, l_DatFim, l_aQtdRqu);
  							l_DatIni := l_DatAdm;
						END LOOP;				
						QL_AJUSTARSALDORQU(l_aOldSit, l_aNewSit, l_aNumEmp, l_aEstPos, l_aCodPlv, l_aPosTra, l_aCodRqu, l_DatIni, l_xDatFut, l_aQtdRqu);
                        
						l_xSalRqu := 0;					
						/* ============================================================================================================= */ 						
					ELSE					
						IF (((l_aOldSit = l_Nao_Iniciada) OR (l_aOldSit = l_Em_Andamento)) AND ((l_aNewSit = l_Cancelada) OR (l_aNewSit = l_Finalizada) OR (l_aNewSit = l_Proposta) OR (l_aNewSit = l_Suspensa))) THEN
							l_xSalRqu := l_xSalRqu *(-1);
						ELSE
							IF (((l_aOldSit = l_Cancelada) OR (l_aOldSit = l_Finalizada) OR (l_aOldSit = l_Proposta) OR (l_aOldSit = l_Suspensa)) AND ((l_aNewSit = l_Nao_Iniciada) OR (l_aNewSit = l_Em_Andamento))) THEN
								l_xSalRqu := l_xSalRqu;
							ELSE
								l_xSalRqu := 0;
							END IF;
						END IF;										
					END IF;
				END IF;
			END IF;
		END IF;

		IF (l_xSalRqu <> 0) THEN
			QL_ATUEFEPOS(l_xTipOpe, 'R126RQU', l_aNumEmp, l_aEstPos, l_aCodPlv, l_aPosTra, l_xSalRqu, l_aDatRqu, 'N', 'N', 'N');
			QL_AJUQTDEFE('R126RQU', l_aEstPos, l_aCodPlv, l_aPosTra, l_aDatRqu, l_xDatFut, l_xSalRqu);
		END IF;
	END IF;
END␀óÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0)QL_POSTOAUT
QL_ATUEFEPOS
QL_AJUQTDEFE
‡␀␀PROCEDURE QL_PROCESVA(L_ATIPOPE CHAR,L_ANUMEMP NUMBER(4),L_AESTPOS NUMBER(3),L_ACODPLV NUMBER(4),L_APOSTRA VARCHAR2(25),L_AQTDSVA NUMBER(4),L_ASITSVA NUMBER(1),L_ADATSVA DATE,L_ACODTAP NUMBER(3),L_ADATDIF CHAR,L_AVAGDIF CHAR,L_ASIT33 CHAR)
 IS

l_xPosAut CHAR;
  l_xDatFut DATE;
  l_xQtdSva NUMBER(4);
BEGIN
  /* l_aSitSva
     1 - Em definição - Nada
     2 - Em aprovação - Soma
     3 - Solicitação de alteração - Subtrai
     4 - Aprovada - Subtrai
     5 - Rejeitada - Subtrai
     6 - Cancelada - Subtrai */
  l_xDatFut := '04/06/2080,00:00:00';
  l_xQtdSva := l_aQtdSva;

  IF (l_aSitSva <> 1) THEN
    QL_POSTOAUT(l_aEstPos, l_aPosTra, l_aDatSva, l_aCodTap, l_xPosAut OUT);
    IF ((l_aTipOpe = 'D') OR (l_aSitSva = 3) OR (l_aSitSva = 4) OR (l_aSitSva = 5) OR (l_aSitSva = 6)) THEN
      l_xQtdSva := l_aQtdSva *(-1);
    END IF;

    IF (l_xPosAut = 'S') THEN
      QL_ATUEFEPOS(l_aTipOpe, 'R126SVA', l_aNumEmp, l_aEstPos, l_aCodPlv, l_aPosTra, l_xQtdSva, l_aDatSva, l_aDatDif, l_aVagDif, l_aSit33);
      QL_AJUQTDEFE('R126SVA', l_aEstPos, l_aCodPlv, l_aPosTra, l_aDatSva, l_xDatFut, l_xQtdSva);
    END IF;
  END IF;
END␀ôÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
1␀␀/* Retorna se é para atualizar o Quadro Efetivo e qual o Tipo de Quadro que está sendo utilizado.
  aAtuQua - Indica se é para atualizar o Quadro
  aCtlQua - Indica o Tipo de Quadro em uso */
PROCEDURE QL_RETATUQUA(ANUMEMP NUMBER(4),AATUQUA OUT CHAR,ACTLQUA OUT NUMBER(1),AUSATUR OUT CHAR,ACONTPV OUT CHAR)
 IS

xVetQlo CHAR;
  xAtuEfe CHAR;
  l_CountReg     NUMBER;
BEGIN
  /* Verifica quantos registros existem na tabela da Proprietária. */
  SELECT COUNT(*) INTO l_CountReg FROM R000PRP;

  /* a tabela da proprietária não pode ter mais de 1 registro */
  IF (l_CountReg > 1) THEN
    RAISERROR 103 'Erro ao buscar dados da tabela da Proprietária (R000PRP): A tabela possui mais de um registro';
  END IF;

  /* Verifica se está integrado com o Quadro de Lotação */
  BEGIN
    SELECT VETQLO INTO xVetQlo FROM R000PRP;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      xVetQlo := 'N';
  END;

  /* Lê assinalamentos do Quadro (por Empresa) */
  BEGIN
    SELECT IFNULL(CTLQUA, 0), IFNULL(ATUEFE, 'S'), IFNULL(USATUR, 'N'), IFNULL(CONTPV, 'N') INTO aCtlQua, xAtuEfe, aUsaTur, aConTpV FROM R030EMP WHERE NUMEMP = aNumEmp;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      aCtlQua := 0;
      xAtuEfe := 'S';
      aUsaTur := 'N';
      aConTpV := 'N';
  END;

  /* O quadro Efetivo pode ser atualizado quando o Assinalamento para atualização estiver diferente de "N" e quando o
     Quadro não for controlado por Time. */
  IF (xVetQlo = 'S') AND (xAtuEfe <> 'N') AND (aCtlQua <> 2) THEN
    aAtuQua := 'S';
  ELSE
    aAtuQua := 'N';
  END IF;
END␀õÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0QL_VERASS
u	␀␀/* Busca o Cargo anterior a Data passada como parametro
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aDatRef - Data Referencia
   aAntDatAlt - Data da alteração de Cargo anterior
   aAntEstCar - Estrutura de Cargo anterior
   aAntCodCar - Cargo anterior
   aNCDatAlt - Data a não ser considerada
   aNCEstCar - Estrutura a não ser considerada
   aNCCodCar - Cargo a não ser considerado */
PROCEDURE QL_RETCARANT(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATREF DATE,AANTDATALT OUT DATE,AANTESTCAR OUT NUMBER(4),AANTCODCAR OUT VARCHAR2(25),ANCDATALT DATE,ANCESTCAR NUMBER(4),ANCCODCAR VARCHAR2(25))
 IS

xIndCar   R000ASS.INDCAR%TYPE;
BEGIN
  QL_VERASS(xIndCar OUT);

  IF (xIndCar <> 'S') THEN
    /* Se não utilizar Cargo de Vaga - campo CODCAR */
    BEGIN
      SELECT HCA.DATALT, HCA.ESTCAR, HCA.CODCAR INTO aAntDatAlt, aAntEstCar, aAntCodCar FROM R038HCA HCA
       WHERE HCA.NUMEMP = aNumEmp AND HCA.TIPCOL = aTipCol AND HCA.NUMCAD = aNumCad
         AND HCA.DATALT = (SELECT MAX(HCA2.DATALT) FROM R038HCA HCA2
                            WHERE HCA2.NUMEMP = aNumEmp AND HCA2.TIPCOL = aTipCol AND HCA2.NUMCAD = aNumCad AND HCA2.DATALT <= aDatRef
                              AND ((HCA2.DATALT <> aNCDatAlt) OR (HCA2.ESTCAR <> aNCEstCar) OR (HCA2.CODCAR <> aNCCodCar)));
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        aAntDatAlt := '31/12/1900,00:00:00';
        aAntEstCar := 0;
        aAntCodCar := ' ';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na Busca do Cargo anterior.';
    END;
  ELSE
    /* Se utilizar Cargo de Vaga - campo CARVAG */
    BEGIN
      SELECT HCA.DATALT, HCA.ESTCAR, HCA.CARVAG INTO aAntDatAlt, aAntEstCar, aAntCodCar FROM R038HCA HCA
       WHERE HCA.NUMEMP = aNumEmp AND HCA.TIPCOL = aTipCol AND HCA.NUMCAD = aNumCad
         AND HCA.DATALT = (SELECT MAX(HCA2.DATALT) FROM R038HCA HCA2
                            WHERE HCA2.NUMEMP = aNumEmp AND HCA2.TIPCOL = aTipCol AND HCA2.NUMCAD = aNumCad AND HCA2.DATALT <= aDatRef
                              AND ((HCA2.DATALT <> aNCDatAlt) OR (HCA2.ESTCAR <> aNCEstCar) OR (HCA2.CARVAG <> aNCCodCar)));
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        aAntDatAlt := '31/12/1900,00:00:00';
        aAntEstCar := 0;
        aAntCodCar := ' ';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na Busca do Cargo anterior.';
    END;
  END IF;
END␀öÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
í␀␀/* Retorna o Cargo do Nível de controle do Quadro de Lotação
   aEstCar - Estrutura
   aCodCar - Cargo
   aDatAlt - Data referência
   aCodCarNiv - Cargo do Nível do Quadro */
PROCEDURE QL_RETCARNIV(AESTCAR NUMBER(4),ACODCAR VARCHAR2(25),ADATALT DATE,ACODCARNIV OUT VARCHAR2(25))
 IS

xMsg VARCHAR2(255);
  xNivQua   R016ORE.NIVQUA%TYPE;
  xQtdPos NUMBER(2);
BEGIN
  /* Retorna o Nível do Quadro de controle dos Cargos */
  BEGIN
    SELECT NIVQUA INTO xNivQua FROM R024EST WHERE ESTCAR = aEstCar;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      xNivQua := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na busca do Nível de controle do Quadro na Estrutura de Cargo.';
  END;

  IF (xNivQua <> 0) THEN
    /* Busca o Cargo do nível especificado */
    BEGIN
      SELECT SUM(NUMPOS) INTO xQtdPos FROM R024NIV WHERE ESTCAR = aEstCar AND NIVCAR <= xNivQua;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        xQtdPos := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao buscar o Nível do Cargo.';
    END;

    aCodCarNiv := SUBSTRING(aCodCar, 1, xQtdPos);
    BEGIN
      SELECT CODCAR INTO aCodCarNiv FROM R024CAR WHERE ESTCAR = aEstCar AND CODCAR = aCodCarNiv;
    EXCEPTION
      WHEN OTHERS THEN
        xMsg := 'O cargo ' || aCodCarNiv ||
                ' não está cadastrado na Estrutura de Cargos. Cadastre-o ou altere Nível de Controle do Quadro na Estrutura de Cargos.';
        RAISERROR 103 xMsg;
    END;
  ELSE
    aCodCarNiv := aCodCar;
  END IF;
END␀÷È␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Å␀␀/* Busca o Centro Custo anterior a Data passada como parametro
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aDatRef - Data Referencia
   aAntDatAlt - Data da alteração de Centro Custo anterior
   aAntCodCcu - Centro Custo anterior
   aNCDatAlt - Data a não ser considerada
   aNCCodCcu - Centro Custo a não ser considerado */
PROCEDURE QL_RETCCUANT(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATREF DATE,AANTDATALT OUT DATE,AANTCODCCU OUT VARCHAR2(18),ANCDATALT DATE,ANCCODCCU VARCHAR2(18))
 IS
BEGIN
  BEGIN
    SELECT HCC.DATALT, HCC.CODCCU INTO aAntDatAlt, aAntCodCcu FROM R038HCC HCC
     WHERE HCC.NUMEMP = aNumEmp AND HCC.TIPCOL = aTipCol AND HCC.NUMCAD = aNumCad
       AND HCC.DATALT = (SELECT MAX(HCC2.DATALT) FROM R038HCC HCC2
                          WHERE HCC2.NUMEMP = aNumEmp AND HCC2.TIPCOL = aTipCol AND HCC2.NUMCAD = aNumCad AND HCC2.DATALT <= aDatRef
                            AND ((HCC2.DATALT <> aNCDatAlt) OR (HCC2.CODCCU <> aNCCodCcu)));
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      aAntDatAlt := '31/12/1900,00:00:00';
      aAntCodCcu := ' ';
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na Busca do Centro Custo anterior.';
  END;
END␀øÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ß␀␀/* Busca o Escala/Horário anterior a Data passada como parametro
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aDatRef - Data Referencia
   aAntDatAlt - Data da alteração de Escala/Horário Anterior
   aAntCodEsc - Escala/Horário Anterior
   aNCDatAlt - Data a não ser considerada
   aNCCodEsc - Escala/Horário a não ser considerado */
PROCEDURE QL_RETESCANT(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATREF DATE,AANTDATALT OUT DATE,AANTCODESC OUT NUMBER(9),ANCDATALT DATE,ANCCODESC NUMBER(9))
 IS

xEscHor CHAR;
BEGIN
  /* Verifica se a Empresa Usa Escala */
  BEGIN
    SELECT ESCHOR INTO xEscHor FROM R030EMP WHERE NUMEMP = aNumEmp;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      xEscHor := 'N';
  END;

  /* Se não estiver integrado, não controla Quadro Efetivo. */
  IF (xEscHor = 'S') THEN
    BEGIN
      SELECT HES.DATALT, HES.CODESC INTO aAntDatAlt, aAntCodEsc FROM R038HES HES
       WHERE HES.NUMEMP = aNumEmp AND HES.TIPCOL = aTipCol AND HES.NUMCAD = aNumCad
         AND HES.DATALT = (SELECT MAX(HES2.DATALT) FROM R038HES HES2
                            WHERE HES2.NUMEMP = aNumEmp AND HES2.TIPCOL = aTipCol AND HES2.NUMCAD = aNumCad AND HES2.DATALT <= aDatRef
                              AND ((HES2.DATALT <> aNCDatAlt) OR (HES2.CODESC <> aNCCodEsc)));
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        aAntDatAlt := '31/12/1900,00:00:00';
        aAntCodEsc := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na Busca do Escala/Horário Anterior.';
    END;
  ELSE
    BEGIN
      SELECT HES.DATALT, HES.HORBAS INTO aAntDatAlt, aAntCodEsc FROM R038HES HES
       WHERE HES.NUMEMP = aNumEmp AND HES.TIPCOL = aTipCol AND HES.NUMCAD = aNumCad
         AND HES.DATALT = (SELECT MAX(HES2.DATALT) FROM R038HES HES2
                            WHERE HES2.NUMEMP = aNumEmp AND HES2.TIPCOL = aTipCol AND HES2.NUMCAD = aNumCad AND HES2.DATALT <= aDatRef
                              AND ((HES2.DATALT <> aNCDatAlt) OR (HES2.HORBAS <> aNCCodEsc)));
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        aAntDatAlt := '31/12/1900,00:00:00';
        aAntCodEsc := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na Busca do Escala/Horário Anterior.';
    END;
  END IF;
END␀ùÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
t␀␀/* Busca a Filial anterior a Data passada como parametro
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aDatRef - Data Referencia
   aAntDatAlt - Data da alteração da Filial anterior
   aAntEmpAtu - Empresa da Filial anterior
   aAntCodFil - Filial anterior
   aNCDatAlt - Data a não ser considerada
   aNCEmpAtu - Empresa a não ser considerada
   aNCCodFil - Filial a não ser considerado */
PROCEDURE QL_RETFILANT(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATREF DATE,AANTDATALT OUT DATE,AANTEMPATU OUT NUMBER(4),AANTCODFIL OUT NUMBER(6),ANCDATALT DATE,ANCEMPATU NUMBER(4),ANCCODFIL NUMBER(6))
 IS
BEGIN
  BEGIN
    SELECT HFI.DATALT, HFI.EMPATU, HFI.CODFIL INTO aAntDatAlt, aAntEmpAtu, aAntCodFil FROM R038HFI HFI
     WHERE HFI.NUMEMP = aNumEmp AND HFI.TIPCOL = aTipCol AND HFI.NUMCAD = aNumCad
       AND HFI.DATALT = (SELECT MAX(HFI2.DATALT) FROM R038HFI HFI2
                          WHERE HFI2.NUMEMP = aNumEmp AND HFI2.TIPCOL = aTipCol AND HFI2.NUMCAD = aNumCad AND HFI2.DATALT <= aDatRef
                            AND ((HFI2.DATALT <> aNCDatAlt) OR (HFI2.EMPATU <> aNCEmpAtu) OR (HFI2.CODFIL <> aNCCodFil)));
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      aAntDatAlt := '31/12/1900,00:00:00';
      aAntEmpAtu := 0;
      aAntCodFil := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na Busca do Filial anterior.';
  END;
END␀úÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
t␀␀/* Busca o Local anterior a Data passada como parametro
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aDatRef - Data Referencia
   aAntDatAlt - Data da alteração de Local anterior
   aAntTabOrg - Estrutura de Local anterior
   aAntNumLoc - Local anterior
   aNCDatAlt - Data a não ser considerada
   aNCTabOrg - Organograma a não ser considerado
   aNCNumLoc - Local a não ser considerado */
PROCEDURE QL_RETLOCANT(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATREF DATE,AANTDATALT OUT DATE,AANTTABORG OUT NUMBER(4),AANTNUMLOC OUT NUMBER(9),ANCDATALT DATE,ANCTABORG NUMBER(4),ANCNUMLOC NUMBER(9))
 IS
BEGIN
  BEGIN
    SELECT HLO.DATALT, HLO.TABORG, HLO.NUMLOC INTO aAntDatAlt, aAntTabOrg, aAntNumLoc FROM R038HLO HLO
     WHERE HLO.NUMEMP = aNumEmp AND HLO.TIPCOL = aTipCol AND HLO.NUMCAD = aNumCad
       AND HLO.DATALT = (SELECT MAX(HLO2.DATALT) FROM R038HLO HLO2
                          WHERE HLO2.NUMEMP = aNumEmp AND HLO2.TIPCOL = aTipCol AND HLO2.NUMCAD = aNumCad AND HLO2.DATALT <= aDatRef
                            AND ((HLO2.DATALT <> aNCDatAlt) OR (HLO2.TABORG <> aNCTabOrg) OR (HLO2.NUMLOC <> aNCNumLoc)));
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      aAntDatAlt := '31/12/1900,00:00:00';
      aAntTabOrg := 0;
      aAntNumLoc := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na Busca do Local anterior.';
  END;
END␀ûÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Ï␀␀/* Retorna o Local do Nível de controle do Quadro de Lotação
   aTabOrg - Organograma
   aNumLoc - Local
   aDatAlt - Data referência
   aNumLocNiv - Local do Nível do Quadro */
PROCEDURE QL_RETLOCNIV(ATABORG NUMBER(4),ANUMLOC NUMBER(9),ADATALT DATE,ANUMLOCNIV OUT NUMBER(9))
 IS

xMsg VARCHAR2(255);
  xNivQua   R016ORE.NIVQUA%TYPE;
  xPosLoc   R016HIE.POSLOC%TYPE;
  xCodLoc   R016HIE.CODLOC%TYPE;
  xPosLocNiv   R016HIE.POSLOC%TYPE;
  xQtdPos NUMBER(2);
BEGIN
  /* Busca o nível do Quadro no Organograma */
  BEGIN
    SELECT NIVQUA INTO xNivQua FROM R016ORE WHERE TABORG = aTabOrg;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      xNivQua := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na busca do Nível de controle do Quadro no Organograma.';
  END;

  /* Se tiver um Nível cadastrado, pega o Local deste Nível */
  IF (xNivQua <> 0) THEN
    /* Acha o nível do local */
    BEGIN
      SELECT POSLOC, CODLOC INTO xPosLoc, xCodLoc FROM R016HIE
       WHERE TABORG = aTabOrg AND NUMLOC = aNumLoc AND DATINI <= aDatAlt AND DATFIM >= aDatAlt;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        xPosLoc := ' ';
        xCodLoc := ' ';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro ao buscar o Nível do Local.';
    END;

    /* Busca o Local do Nível */
    IF (LENGTH(xPosLoc) >= (xNivQua * 2)) THEN
      xQtdPos := (xNivQua * 2);
      xPosLocNiv := SUBSTRING(xPosLoc, 1, xQtdPos);
      BEGIN
        SELECT NUMLOC INTO aNumLocNiv FROM R016HIE
         WHERE TABORG = aTabOrg AND POSLOC = xPosLocNiv AND DATINI <= aDatAlt AND DATFIM >= aDatAlt;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          xPosLoc := ' ';
          xCodLoc := ' ';
        WHEN OTHERS THEN
          RAISERROR 103 'Não existe um Local para o Nível cadastrado para o controle do Quadro.';
      END;
    ELSE
      xMsg := 'O Local ' || xCodLoc ||
              ' não está de acordo com o Nível do Quadro da Estrutura de Organograma. Altere o Local ou o Nível de controle do Quadro! Nível atual: ' ||
              CONVERT(NUMBER_TO_CHAR,xNivQua);
      RAISERROR 103 xMsg;
    END IF;
  ELSE
    /* Se não tiver um Nível cadastrado, retorna o mesmo Local */
    aNumLocNiv := aNumLoc;
  END IF;
END␀üÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
?␀␀PROCEDURE QL_RETORNACODCLI(L_ACODCLI OUT NUMBER(9))
 IS

l_xCodCli   R250TAB.CODCLI%TYPE;  
BEGIN
  l_xCodCli := 0;
	
  BEGIN
		SELECT IFNULL(CODCLI, 0) INTO l_xCodCli FROM R250TAB;
	EXCEPTION
		WHEN OTHERS THEN
      RAISERROR 103 'Erro ao ler código do cliente.';
  END;
	
  l_aCodCli := l_xCodCli;
END␀ıÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0QL_VERASS
o	␀␀/* Busca o Cargo posterior a Data passada como parametro
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aDatRef - Data Referencia
   aPrxDatAlt - Data da próxima alteração de Cargo
   aPrxEstCar - Próxima Estrutura de Cargo
   aPrxCodCar - Próximo Cargo
   aNCDatAlt - Data a não ser considerada
   aNCEstCar - Estrutura a não ser considerada
   aNCCodCar - Cargo a não ser considerado */
PROCEDURE QL_RETPROCAR(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATREF DATE,APRXDATALT OUT DATE,APRXESTCAR OUT NUMBER(4),APRXCODCAR OUT VARCHAR2(25),ANCDATALT DATE,ANCESTCAR NUMBER(4),ANCCODCAR VARCHAR2(25))
 IS

xIndCar   R000ASS.INDCAR%TYPE;
BEGIN
  QL_VERASS(xIndCar OUT);

  IF (xIndCar <> 'S') THEN
    /* Se não utilizar Cargo de Vaga - campo CODCAR */
    BEGIN
      SELECT HCA.DATALT, HCA.ESTCAR, HCA.CODCAR INTO aPrxDatAlt, aPrxEstCar, aPrxCodCar FROM R038HCA HCA
       WHERE HCA.NUMEMP = aNumEmp AND HCA.TIPCOL = aTipCol AND HCA.NUMCAD = aNumCad
         AND HCA.DATALT = (SELECT MIN(HCA2.DATALT) FROM R038HCA HCA2
                            WHERE HCA2.NUMEMP = aNumEmp AND HCA2.TIPCOL = aTipCol AND HCA2.NUMCAD = aNumCad AND HCA2.DATALT > aDatRef
                              AND ((HCA2.DATALT <> aNCDatAlt) OR (HCA2.ESTCAR <> aNCEstCar) OR (HCA2.CODCAR <> aNCCodCar)));
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        aPrxDatAlt := '31/12/1900,00:00:00';
        aPrxEstCar := 0;
        aPrxCodCar := ' ';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na Busca do Próximo Cargo.';
    END;
  ELSE
    /* Se utilizar Cargo de Vaga - campo CARVAG */
    BEGIN
      SELECT HCA.DATALT, HCA.ESTCAR, HCA.CARVAG INTO aPrxDatAlt, aPrxEstCar, aPrxCodCar FROM R038HCA HCA
       WHERE HCA.NUMEMP = aNumEmp AND HCA.TIPCOL = aTipCol AND HCA.NUMCAD = aNumCad
         AND HCA.DATALT = (SELECT MIN(HCA2.DATALT) FROM R038HCA HCA2
                            WHERE HCA2.NUMEMP = aNumEmp AND HCA2.TIPCOL = aTipCol AND HCA2.NUMCAD = aNumCad AND HCA2.DATALT > aDatRef
                              AND ((HCA2.DATALT <> aNCDatAlt) OR (HCA2.ESTCAR <> aNCEstCar) OR (HCA2.CARVAG <> aNCCodCar)));
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        aPrxDatAlt := '31/12/1900,00:00:00';
        aPrxEstCar := 0;
        aPrxCodCar := ' ';
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na Busca do Próximo Cargo.';
    END;
  END IF;
END␀şÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Â␀␀/* Busca o Centro Custo posterior a Data passada como parametro
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aDatRef - Data Referencia
   aPrxDatAlt - Data da próxima alteração de Centro Custo
   aPrxCodCcu - Próximo Centro Custo
   aNCDatAlt - Data a não ser considerada
   aNCCodCcu - Centro Custo a não ser considerado */
PROCEDURE QL_RETPROCCU(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATREF DATE,APRXDATALT OUT DATE,APRXCODCCU OUT VARCHAR2(18),ANCDATALT DATE,ANCCODCCU VARCHAR2(18))
 IS
BEGIN
  BEGIN
    SELECT HCC.DATALT, HCC.CODCCU INTO aPrxDatAlt, aPrxCodCcu FROM R038HCC HCC
     WHERE HCC.NUMEMP = aNumEmp AND HCC.TIPCOL = aTipCol AND HCC.NUMCAD = aNumCad
       AND HCC.DATALT = (SELECT MIN(HCC2.DATALT) FROM R038HCC HCC2
                          WHERE HCC2.NUMEMP = aNumEmp AND HCC2.TIPCOL = aTipCol AND HCC2.NUMCAD = aNumCad AND HCC2.DATALT > aDatRef
                            AND ((HCC2.DATALT <> aNCDatAlt) OR (HCC2.CODCCU <> aNCCodCcu)));
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      aPrxDatAlt := '31/12/1900,00:00:00';
      aPrxCodCcu := ' ';
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na Busca do Próximo Centro Custo.';
  END;
END␀ÿÈ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Ú␀␀/* Busca o Escala/Horário posterior a Data passada como parametro
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aDatRef - Data Referencia
   aPrxDatAlt - Data da alteração do próximo Escala/Horário
   aPrxCodEsc - Próximo Escala/Horário
   aNCDatAlt - Data a não ser considerada
   aNCCodEsc - Escala/Horário a não ser considerado */
PROCEDURE QL_RETPROESC(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATREF DATE,APRXDATALT OUT DATE,APRXCODESC OUT NUMBER(9),ANCDATALT DATE,ANCCODESC NUMBER(9))
 IS

xEscHor CHAR;
BEGIN
  /* Verifica se a Empresa Usa Escala */
  BEGIN
    SELECT ESCHOR INTO xEscHor FROM R030EMP WHERE NUMEMP = aNumEmp;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      xEscHor := 'N';
  END;

  /* Se não estiver integrado, não controla Quadro Efetivo. */
  IF (xEscHor = 'S') THEN
    BEGIN
      SELECT HES.DATALT, HES.CODESC INTO aPrxDatAlt, aPrxCodEsc FROM R038HES HES
       WHERE HES.NUMEMP = aNumEmp AND HES.TIPCOL = aTipCol AND HES.NUMCAD = aNumCad
         AND HES.DATALT = (SELECT MIN(HES2.DATALT) FROM R038HES HES2
                            WHERE HES2.NUMEMP = aNumEmp AND HES2.TIPCOL = aTipCol AND HES2.NUMCAD = aNumCad AND HES2.DATALT > aDatRef
                              AND ((HES2.DATALT <> aNCDatAlt) OR (HES2.CODESC <> aNCCodEsc)));
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        aPrxDatAlt := '31/12/1900,00:00:00';
        aPrxCodEsc := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na Busca do Próximo Escala/Horário.';
    END;
  ELSE
    BEGIN
      SELECT HES.DATALT, HES.HORBAS INTO aPrxDatAlt, aPrxCodEsc FROM R038HES HES
       WHERE HES.NUMEMP = aNumEmp AND HES.TIPCOL = aTipCol AND HES.NUMCAD = aNumCad
         AND HES.DATALT = (SELECT MIN(HES2.DATALT) FROM R038HES HES2
                            WHERE HES2.NUMEMP = aNumEmp AND HES2.TIPCOL = aTipCol AND HES2.NUMCAD = aNumCad AND HES2.DATALT > aDatRef
                              AND ((HES2.DATALT <> aNCDatAlt) OR (HES2.HORBAS <> aNCCodEsc)));
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        aPrxDatAlt := '31/12/1900,00:00:00';
        aPrxCodEsc := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na Busca do Próximo Escala/Horário.';
    END;
  END IF;
END␀␀É␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
p␀␀/* Busca a Filial posterior a Data passada como parametro
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aDatRef - Data Referencia
   aPrxDatAlt - Data da próxima alteração de Filial
   aPrxEmpAtu - Próxima Empresa da Filial
   aPrxCodFil - Próximo Filial
   aNCDatAlt - Data a não ser considerada
   aNCEmpAtu - Empresa a não ser considerada
   aNCCodFil - Filial a não ser considerado */
PROCEDURE QL_RETPROFIL(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATREF DATE,APRXDATALT OUT DATE,APRXEMPATU OUT NUMBER(4),APRXCODFIL OUT NUMBER(6),ANCDATALT DATE,ANCEMPATU NUMBER(4),ANCCODFIL NUMBER(6))
 IS
BEGIN
  BEGIN
    SELECT HFI.DATALT, HFI.EMPATU, HFI.CODFIL INTO aPrxDatAlt, aPrxEmpAtu, aPrxCodFil FROM R038HFI HFI
     WHERE HFI.NUMEMP = aNumEmp AND HFI.TIPCOL = aTipCol AND HFI.NUMCAD = aNumCad
       AND HFI.DATALT = (SELECT MIN(HFI2.DATALT) FROM R038HFI HFI2
                          WHERE HFI2.NUMEMP = aNumEmp AND HFI2.TIPCOL = aTipCol AND HFI2.NUMCAD = aNumCad AND HFI2.DATALT > aDatRef
                            AND ((HFI2.DATALT <> aNCDatAlt) OR (HFI2.EMPATU <> aNCEmpAtu) OR (HFI2.CODFIL <> aNCCodFil)));
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      aPrxDatAlt := '31/12/1900,00:00:00';
      aPrxEmpAtu := 0;
      aPrxCodFil := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na Busca do Próximo Filial.';
  END;
END␀É␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
p␀␀/* Busca o Local posterior a Data passada como parametro
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aDatRef - Data Referencia
   aPrxDatAlt - Data da próxima alteração de Local
   aPrxTabOrg - Próxima Estrutura de Local
   aPrxNumLoc - Próximo Local
   aNCDatAlt - Data a não ser considerada
   aNCTabOrg - Organograma a não ser considerado
   aNCNumLoc - Local a não ser considerado */
PROCEDURE QL_RETPROLOC(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATREF DATE,APRXDATALT OUT DATE,APRXTABORG OUT NUMBER(4),APRXNUMLOC OUT NUMBER(9),ANCDATALT DATE,ANCTABORG NUMBER(4),ANCNUMLOC NUMBER(9))
 IS
BEGIN
  BEGIN
    SELECT HLO.DATALT, HLO.TABORG, HLO.NUMLOC INTO aPrxDatAlt, aPrxTabOrg, aPrxNumLoc FROM R038HLO HLO
     WHERE HLO.NUMEMP = aNumEmp AND HLO.TIPCOL = aTipCol AND HLO.NUMCAD = aNumCad
       AND HLO.DATALT = (SELECT MIN(HLO2.DATALT) FROM R038HLO HLO2
                          WHERE HLO2.NUMEMP = aNumEmp AND HLO2.TIPCOL = aTipCol AND HLO2.NUMCAD = aNumCad AND HLO2.DATALT > aDatRef
                            AND ((HLO2.DATALT <> aNCDatAlt) OR (HLO2.TABORG <> aNCTabOrg) OR (HLO2.NUMLOC <> aNCNumLoc)));
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      aPrxDatAlt := '31/12/1900,00:00:00';
      aPrxTabOrg := 0;
      aPrxNumLoc := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na Busca do Próximo Local.';
  END;
END␀É␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
?␀␀/* Busca o Vínculo posterior a Data passada como parametro
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aDatRef - Data Referencia
   aPrxDatAlt - Data da próxima alteração de Cargo
   aPrxCodVin - Próximo Vínculo
   aPrxTipVag - Próximo Tipo de Vaga
   aNCDatAlt - Data a não ser considerada
   aNCCodVin - Vínculo a não ser considerado */
PROCEDURE QL_RETPROVIN(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATREF DATE,APRXDATALT OUT DATE,APRXCODVIN OUT NUMBER(2),APRXTIPVAG OUT NUMBER(2),ANCDATALT DATE,ANCCODVIN NUMBER(2))
 IS
BEGIN
  BEGIN
    SELECT HVI.DATALT, HVI.CODVIN, VIN.TIPVAG INTO aPrxDatAlt, aPrxCodVin, aPrxTipVag FROM R038HVI HVI, R022VIN VIN
     WHERE HVI.NUMEMP = aNumEmp AND HVI.TIPCOL = aTipCol AND HVI.NUMCAD = aNumCad
       AND HVI.DATALT = (SELECT MIN(HVI2.DATALT) FROM R038HVI HVI2
                          WHERE HVI2.NUMEMP = aNumEmp AND HVI2.TIPCOL = aTipCol AND HVI2.NUMCAD = aNumCad AND HVI2.DATALT > aDatRef
                            AND ((HVI2.DATALT <> aNCDatAlt) OR (HVI2.CODVIN <> aNCCodVin)))
       AND VIN.CODVIN = HVI.CODVIN;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      aPrxDatAlt := '31/12/1900,00:00:00';
      aPrxCodVin := 0;
      aPrxTipVag := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na busca do próximo Vínculo.';
  END;
END␀É␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Æ␀␀/* Busca o Afastamento anterior a Data passada como parametro
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aDatRef - Data Referencia
   aAntDatAfa - Data da alteração da Situação
   aAntTipSit - Situação Anterior
   aNCDatAfa - Data a não ser considerada
   aNCTipSit - Situação a não ser considerada */
PROCEDURE QL_RETSITANT(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATREF DATE,AANTDATAFA OUT DATE,AANTTIPSIT OUT NUMBER(3),ANCDATAFA DATE,ANCTIPSIT NUMBER(3))
 IS

xDatTmp DATE;
BEGIN
  xDatTmp := '31/12/1900,00:00:00';

  BEGIN
    SELECT AFA.DATAFA, SIT.TIPSIT INTO aAntDatAfa, aAntTipSit FROM R038AFA AFA, R010SIT SIT
     WHERE AFA.NUMEMP = aNumEmp AND AFA.TIPCOL = aTipCol AND AFA.NUMCAD = aNumCad
       AND AFA.DATAFA <= aDatRef AND (AFA.DATTER >= aDatRef OR AFA.DATTER = xDatTmp)
       AND AFA.DATAFA <> AFA.DATTER AND SIT.CODSIT = AFA.SITAFA AND (SIT.AFAQUA = 'S' OR SIT.TIPSIT = 7)
       AND ((AFA.DATAFA <> aNCDatAfa) OR (SIT.TIPSIT <> aNCTipSit));
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      aAntDatAfa := '31/12/1900,00:00:00';
      aAntTipSit := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na Busca da Situação Anterior.';
  END;
END␀É␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
Á␀␀/* Busca o Tipo de Turno da Escala/Horário passada como parametro
   aNumEmp - Empresa
   aCodEsc - Escala/Horário
   aTipTur - Tipo de Turno retornado */
PROCEDURE QL_RETTIPTUR(ANUMEMP NUMBER(4),ACODESC NUMBER(9),ATIPTUR OUT NUMBER(4),AUSATUR CHAR)
 IS

xEscHor CHAR;
BEGIN
  IF (aUsaTur = 'S') THEN
    /* Verifica se a Empresa Usa Escala */
    BEGIN
      SELECT ESCHOR INTO xEscHor FROM R030EMP WHERE NUMEMP = aNumEmp;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        xEscHor := 'N';
    END;

    /* Se não estiver integrado, não controla Quadro Efetivo. */
    IF (xEscHor = 'S') THEN
      BEGIN
        SELECT TURESC INTO aTipTur FROM R006ESC
         WHERE CODESC = aCodEsc;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          aTipTur := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro na Busca do Tipo de Turno.';
      END;
    ELSE
      BEGIN
        SELECT TURHOR INTO aTipTur FROM R004HOR
         WHERE CODHOR = aCodEsc;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          aTipTur := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro na Busca do Tipo de Turno.';
      END;
    END IF;
  ELSE
    aTipTur := 9;
  END IF;
END␀É␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
C␀␀/* Busca o Vínculo anterior a Data passada como parametro
   aNumEmp - Empresa
   aTipCol - Tipo
   aNumCad - Cadastro
   aDatRef - Data Referencia
   aAntDatAlt - Data da alteração de Cargo anterior
   aAntCodVin - Vínculo anterior
   aAntTipVag - Tipo de Vaga anterior
   aNCDatAlt - Data a não ser considerada
   aNCCodVin - Vínculo a não ser considerado */
PROCEDURE QL_RETVINANT(ANUMEMP NUMBER(4),ATIPCOL NUMBER(1),ANUMCAD NUMBER(9),ADATREF DATE,AANTDATALT OUT DATE,AANTCODVIN OUT NUMBER(2),AANTTIPVAG OUT NUMBER(2),ANCDATALT DATE,ANCCODVIN NUMBER(2))
 IS
BEGIN
  BEGIN
    SELECT HVI.DATALT, HVI.CODVIN, VIN.TIPVAG INTO aAntDatAlt, aAntCodVin, aAntTipVag FROM R038HVI HVI, R022VIN VIN
     WHERE HVI.NUMEMP = aNumEmp AND HVI.TIPCOL = aTipCol AND HVI.NUMCAD = aNumCad
       AND HVI.DATALT = (SELECT MAX(HVI2.DATALT) FROM R038HVI HVI2
                          WHERE HVI2.NUMEMP = aNumEmp AND HVI2.TIPCOL = aTipCol AND HVI2.NUMCAD = aNumCad AND HVI2.DATALT <= aDatRef
                            AND ((HVI2.DATALT <> aNCDatAlt) OR (HVI2.CODVIN <> aNCCodVin)))
       AND VIN.CODVIN = HVI.CODVIN;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      aAntDatAlt := '31/12/1900,00:00:00';
      aAntCodVin := 0;
      aAntTipVag := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na busca do Vínculo anterior.';
  END;
END␀É␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0QL_MANTERHISTREQ
×␀␀PROCEDURE QL_SALDORQU(L_ACODRQU NUMBER(9),L_AQTDRQU NUMBER(6),L_ASALRQU OUT NUMBER(6))
 IS

	l_xCount NUMBER(6);  
  	l_xManHRR NUMBER(1);
BEGIN
  QL_MANTERHISTREQ(l_xManHRR OUT);
  IF (l_xManHRR = 1) THEN	
		BEGIN
			SELECT COUNT(*) INTO l_xCount FROM R126CPE
			 WHERE CODRQU = l_aCodRqu
				 AND CANEFE = 'S';
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar quantidade de candidatos efetivados.'; 
		END;
	ELSE
		BEGIN
			SELECT COUNT(*) INTO l_xCount FROM R126CPE
			 WHERE CODRQU = l_aCodRqu
				 AND CANEFE = 'E';
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar quantidade de candidatos efetivados.'; 
		END;
	END IF;
  l_aSalRqu := (l_aQtdRqu-l_xCount);
END␀É␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
v␀␀PROCEDURE QL_SALDORQUEFE(L_ACODRQU NUMBER(9),L_ASALRQU OUT NUMBER(6))
 IS

l_xCount NUMBER(6);
BEGIN

	BEGIN
		SELECT COUNT(*) INTO l_xCount FROM R126CPE
		 WHERE CODRQU = l_aCodRqu
			 AND CANEFE <> 'S';
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar quantidade de candidatos pendentes para efetivação.'; 
	END;

  l_aSalRqu := l_xCount;
END␀É␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
m␀␀PROCEDURE QL_UTIPOSTRA(L_ANUMEMP NUMBER(4),L_ADATVER DATE,L_AUTIPOS OUT CHAR,L_AESTPOS OUT NUMBER(3),L_ACODPLV OUT NUMBER(4))
 IS
BEGIN
  /* Verifica se empresa esta ativa em algum plano de vagas para o período,
     caso SIM retornamos o código da estrutura e código do plano de vagas */
  BEGIN
    SELECT 'S' AS UTIPOS, R017PLE.ESTPOS, R017PLE.CODPLV INTO l_aUtiPos, l_aEstPos, l_aCodPlv FROM R017PLE, R017PLV
     WHERE R017PLE.ESTPOS = R017PLV.ESTPOS
       AND R017PLE.CODPLV = R017PLV.CODPLV
       AND R017PLV.DATINI <= l_aDatVer
       AND R017PLV.DATTER >= l_aDatVer
       AND R017PLE.NUMEMP = l_aNumEmp
       AND R017PLE.PLNATI = 'S';
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_aUtiPos := 'N';
      l_aEstPos := 0;
      l_aCodPlv := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro ao buscar informações do plano de vagas.';
  END;
END␀	É␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
H␀␀/* Verificar se usa Cargo de Vaga */
PROCEDURE QL_VERASS(AINDCAR OUT VARCHAR2(1))
 IS
BEGIN
  BEGIN
    SELECT INDCAR INTO aIndCar FROM R000ASS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      aIndCar := 'N';
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na leitura da tabela de assinalamentos (R000ASS).';
  END;
END␀
É␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
•␀␀PROCEDURE QL_VERMODQL(L_ANUMEMP NUMBER(4),L_ATIPCOL NUMBER(1),L_ANUMCAD NUMBER(9),L_AINDCON OUT CHAR)
 IS
BEGIN
  l_aIndCon := ' ';
  BEGIN
    SELECT R034MDL.INDCON INTO l_aIndCon FROM R034MDL
	 WHERE R034MDL.CODMOD = 7 /* Código do módulo Quadro de Vagas */
	   AND R034MDL.NUMEMP = l_aNumEmp
	   AND R034MDL.TIPCOL = l_aTipCol
	   AND R034MDL.NUMCAD = l_aNumCad;
  EXCEPTION	   
    WHEN NO_DATA_FOUND THEN
	  l_aIndCon := 'S'; /* Caso o SELECT não retornar nada, significa que o Colaborador está indicado para o Módulo QL. */
	WHEN OTHERS THEN    
	  RAISERROR 103 'Erro ao verificar indicações de colaboradores do módulo QL.';   
  END;
END␀É␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
$)␀␀/* Verifica/Inclui registro no Efetivo
   aNumEmp - Empresa
   aTabOrg - Organograma
   aLocCcu - Local
   aEstCar - Estrutura
   aCodCar - Cargo
   aCmpQua - Competência
   aRegExi - retorna se foi encontrado um registro
   aCtlQua - Tipo do Quadro */
PROCEDURE QL_VERREGEXI(ANUMEMP NUMBER(4),ATABORG NUMBER(4),ALOCCCU VARCHAR2(18),AESTCAR NUMBER(4),ACODCAR VARCHAR2(25),ATIPVAG NUMBER(2),ACMPQUA DATE,AREGEXI OUT NUMBER(1),ACTLQUA NUMBER(1))
 IS

xNumLoc   R080EFE.NUMLOC%TYPE;
  xVAGGER   R080EFE.VAGGER%TYPE;
  xVAGTU1   R080EFE.VAGTU1%TYPE;
  xVAGTU2   R080EFE.VAGTU2%TYPE;
  xVAGTU3   R080EFE.VAGTU3%TYPE;
  xVAGTU4   R080EFE.VAGTU4%TYPE;
  xVAGMIS   R080EFE.VAGMIS%TYPE;
  xVAGGEA   R080EFE.VAGGEA%TYPE;
  xVAGT1A   R080EFE.VAGT1A%TYPE;
  xVAGT2A   R080EFE.VAGT2A%TYPE;
  xVAGT3A   R080EFE.VAGT3A%TYPE;
  xVAGT4A   R080EFE.VAGT4A%TYPE;
  xVAGMIA   R080EFE.VAGMIA%TYPE;
  xVAGTER   R080EFE.VAGTER%TYPE;
BEGIN
  /* Quadro por Local */
  IF (aCtlQua = 0) THEN
    xNumLoc := CONVERT(CHAR_TO_NUMBER, aLocCcu);

    /* R080EFE */
    /* Verifica se o registro Existe */
    BEGIN
      SELECT 1 INTO aRegExi FROM R080EFE
       WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA = aCmpQua;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        aRegExi := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na Busca do Registro do Efetivo.';
    END;

    /* Se o registro não existe, pesquisa o anterior mais recente e inclui o mesmo */
    IF (aRegExi = 0) THEN
      BEGIN
        SELECT VAGGER, VAGTU1, VAGTU2, VAGTU3, VAGTU4, VAGMIS, VAGGEA, VAGT1A, VAGT2A, VAGT3A, VAGT4A, VAGMIA, VAGTER
          INTO xVAGGER, xVAGTU1, xVAGTU2, xVAGTU3, xVAGTU4, xVAGMIS, xVAGGEA, xVAGT1A, xVAGT2A, xVAGT3A, xVAGT4A, xVAGMIA, xVAGTER
          FROM R080EFE
         WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar
           AND CMPQUA = (SELECT MAX(EFE2.CMPQUA) FROM R080EFE EFE2
                          WHERE EFE2.NUMEMP = aNumEmp AND EFE2.TABORG = aTabOrg AND EFE2.NUMLOC = xNumLoc
                            AND EFE2.ESTCAR = aEstCar AND EFE2.CODCAR = aCodCar AND EFE2.CMPQUA < aCmpQua);
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          xVAGGER := 0;
          xVAGTU1 := 0;
          xVAGTU2 := 0;
          xVAGTU3 := 0;
          xVAGTU4 := 0;
          xVAGMIS := 0;
          xVAGGEA := 0;
          xVAGT1A := 0;
          xVAGT2A := 0;
          xVAGT3A := 0;
          xVAGT4A := 0;
          xVAGMIA := 0;
          xVAGTER := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro na Busca do Registro do Efetivo mais próximo a Data passada como referencia.';
      END;

      BEGIN
        INSERT INTO R080EFE (NUMEMP, TABORG, NUMLOC, ESTCAR, CODCAR, CMPQUA, VAGGER, VAGTU1, VAGTU2, VAGTU3,
                             VAGTU4, VAGMIS, VAGGEA, VAGT1A, VAGT2A, VAGT3A, VAGT4A, VAGMIA, VAGTER)
                     VALUES (aNumEmp, aTabOrg, xNumLoc, aEstCar, aCodCar, aCmpQua, xVAGGER, xVAGTU1, xVAGTU2, xVAGTU3,
                             xVAGTU4, xVAGMIS, xVAGGEA, xVAGT1A, xVAGT2A, xVAGT3A, xVAGT4A, xVAGMIA, xVAGTER);
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao Incluir registro na R080EFE na Data passada como referencia.';
      END;
    END IF;

    /* R080EFD - Detalhada */
    /* Verifica se o registro Existe */
    BEGIN
      SELECT 1 INTO aRegExi FROM R080EFD
       WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA = aCmpQua;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        aRegExi := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na Busca do Registro do Efetivo.';
    END;

    /* Se o registro não existe, pesquisa o anterior mais recente e inclui o mesmo */
    IF (aRegExi = 0) THEN
      BEGIN
        SELECT VAGGER, VAGTU1, VAGTU2, VAGTU3, VAGTU4, VAGMIS, VAGGEA, VAGT1A, VAGT2A, VAGT3A, VAGT4A, VAGMIA
          INTO xVAGGER, xVAGTU1, xVAGTU2, xVAGTU3, xVAGTU4, xVAGMIS, xVAGGEA, xVAGT1A, xVAGT2A, xVAGT3A, xVAGT4A, xVAGMIA
          FROM R080EFD
         WHERE NUMEMP = aNumEmp AND TABORG = aTabOrg AND NUMLOC = xNumLoc AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag
           AND CMPQUA = (SELECT MAX(EFD2.CMPQUA) FROM R080EFD EFD2
                          WHERE EFD2.NUMEMP = aNumEmp AND EFD2.TABORG = aTabOrg AND EFD2.NUMLOC = xNumLoc
                            AND EFD2.ESTCAR = aEstCar AND EFD2.CODCAR = aCodCar AND EFD2.TIPVAG = aTipVag
                            AND EFD2.CMPQUA < aCmpQua);
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          xVAGGER := 0;
          xVAGTU1 := 0;
          xVAGTU2 := 0;
          xVAGTU3 := 0;
          xVAGTU4 := 0;
          xVAGMIS := 0;
          xVAGGEA := 0;
          xVAGT1A := 0;
          xVAGT2A := 0;
          xVAGT3A := 0;
          xVAGT4A := 0;
          xVAGMIA := 0;
          xVAGTER := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro na Busca do Registro do Efetivo mais próximo a Data passada como referencia.';
      END;

      BEGIN
        INSERT INTO R080EFD (NUMEMP, TABORG, NUMLOC, ESTCAR, CODCAR, TIPVAG, CMPQUA, VAGGER, VAGTU1, VAGTU2,
                             VAGTU3, VAGTU4, VAGMIS, VAGGEA, VAGT1A, VAGT2A, VAGT3A, VAGT4A, VAGMIA)
                     VALUES (aNumEmp, aTabOrg, xNumLoc, aEstCar, aCodCar, aTipVag, aCmpQua, xVAGGER, xVAGTU1, xVAGTU2,
                             xVAGTU3, xVAGTU4, xVAGMIS, xVAGGEA, xVAGT1A, xVAGT2A, xVAGT3A, xVAGT4A, xVAGMIA);
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao Incluir registro na R080EFD na Data passada como referencia.';
      END;
    END IF;
  ELSE
    /* R087EFE */
    /* Verifica se o registro Existe */
    BEGIN
      SELECT 1 INTO aRegExi FROM R087EFE
       WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND CMPQUA = aCmpQua;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        aRegExi := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na Busca do Registro do Efetivo.';
    END;

    /* Se o registro não existe, pesquisa o anterior mais recente e inclui o mesmo */
    IF (aRegExi = 0) THEN
      BEGIN
        SELECT VAGGER, VAGTU1, VAGTU2, VAGTU3, VAGTU4, VAGMIS, VAGGEA, VAGT1A, VAGT2A, VAGT3A, VAGT4A, VAGMIA, VAGTER
          INTO xVAGGER, xVAGTU1, xVAGTU2, xVAGTU3, xVAGTU4, xVAGMIS, xVAGGEA, xVAGT1A, xVAGT2A, xVAGT3A, xVAGT4A, xVAGMIA, xVAGTER
          FROM R087EFE
         WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar
           AND CMPQUA = (SELECT MAX(EFE2.CMPQUA) FROM R087EFE EFE2
                          WHERE EFE2.NUMEMP = aNumEmp AND EFE2.CODCCU = aLocCcu
                            AND EFE2.ESTCAR = aEstCar AND EFE2.CODCAR = aCodCar AND EFE2.CMPQUA < aCmpQua);
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          xVAGGER := 0;
          xVAGTU1 := 0;
          xVAGTU2 := 0;
          xVAGTU3 := 0;
          xVAGTU4 := 0;
          xVAGMIS := 0;
          xVAGGEA := 0;
          xVAGT1A := 0;
          xVAGT2A := 0;
          xVAGT3A := 0;
          xVAGT4A := 0;
          xVAGMIA := 0;
          xVAGTER := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro na Busca do Registro do Efetivo mais próximo a Data passada como referencia.';
      END;

      BEGIN
        INSERT INTO R087EFE (NUMEMP, CODCCU, ESTCAR, CODCAR, CMPQUA, VAGGER, VAGTU1, VAGTU2, VAGTU3,
                             VAGTU4, VAGMIS, VAGGEA, VAGT1A, VAGT2A, VAGT3A, VAGT4A, VAGMIA, VAGTER)
                     VALUES (aNumEmp, aLocCcu, aEstCar, aCodCar, aCmpQua, xVAGGER, xVAGTU1, xVAGTU2, xVAGTU3,
                             xVAGTU4, xVAGMIS, xVAGGEA, xVAGT1A, xVAGT2A, xVAGT3A, xVAGT4A, xVAGMIA, xVAGTER);
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao Incluir registro na R087EFE na Data passada como referencia.';
      END;
    END IF;

    /* R087EFD - Detalhada */
    /* Verifica se o registro Existe */
    BEGIN
      SELECT 1 INTO aRegExi FROM R087EFD
       WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag AND CMPQUA = aCmpQua;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        aRegExi := 0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na Busca do Registro do Efetivo.';
    END;

    /* Se o registro não existe, pesquisa o anterior mais recente e inclui o mesmo */
    IF (aRegExi = 0) THEN
      BEGIN
        SELECT VAGGER, VAGTU1, VAGTU2, VAGTU3, VAGTU4, VAGMIS, VAGGEA, VAGT1A, VAGT2A, VAGT3A, VAGT4A, VAGMIA
          INTO xVAGGER, xVAGTU1, xVAGTU2, xVAGTU3, xVAGTU4, xVAGMIS, xVAGGEA, xVAGT1A, xVAGT2A, xVAGT3A, xVAGT4A, xVAGMIA
          FROM R087EFD
         WHERE NUMEMP = aNumEmp AND CODCCU = aLocCcu AND ESTCAR = aEstCar AND CODCAR = aCodCar AND TIPVAG = aTipVag
           AND CMPQUA = (SELECT MAX(EFD2.CMPQUA) FROM R087EFD EFD2
                          WHERE EFD2.NUMEMP = aNumEmp AND EFD2.CODCCU = aLocCcu AND EFD2.ESTCAR = aEstCar
                            AND EFD2.CODCAR = aCodCar AND EFD2.TIPVAG = aTipVag AND EFD2.CMPQUA < aCmpQua);
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          xVAGGER := 0;
          xVAGTU1 := 0;
          xVAGTU2 := 0;
          xVAGTU3 := 0;
          xVAGTU4 := 0;
          xVAGMIS := 0;
          xVAGGEA := 0;
          xVAGT1A := 0;
          xVAGT2A := 0;
          xVAGT3A := 0;
          xVAGT4A := 0;
          xVAGMIA := 0;
          xVAGTER := 0;
        WHEN OTHERS THEN
          RAISERROR 103 'Erro na Busca do Registro do Efetivo mais próximo a Data passada como referencia.';
      END;

      BEGIN
        INSERT INTO R087EFD (NUMEMP, CODCCU, ESTCAR, CODCAR, TIPVAG, CMPQUA, VAGGER, VAGTU1, VAGTU2, VAGTU3,
                             VAGTU4, VAGMIS, VAGGEA, VAGT1A, VAGT2A, VAGT3A, VAGT4A, VAGMIA)
                     VALUES (aNumEmp, aLocCcu, aEstCar, aCodCar, aTipVag, aCmpQua, xVAGGER, xVAGTU1, xVAGTU2, xVAGTU3,
                             xVAGTU4, xVAGMIS, xVAGGEA, xVAGT1A, xVAGT2A, xVAGT3A, xVAGT4A, xVAGMIA);
      EXCEPTION
        WHEN OTHERS THEN
          RAISERROR 103 'Erro ao Incluir registro na R087EFD na Data passada como referencia.';
      END;
    END IF;
  END IF;
END␀Ï␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ê␀␀PROCEDURE R010SAL_ATUSAL(IN_TIPOPE VARCHAR2(255),IN_NUMEMP NUMBER(4),IN_TIPCOL NUMBER(1),IN_NUMCAD NUMBER(9),IN_CODSAL NUMBER,IN_DATALT DATE,IN_NEWHORSAL NUMBER,IN_OLDHORSAL NUMBER)
 IS

/* V_DESOPE   VARCHAR2(20); */
     /* V_CONDEP   NUMBER(3);    */
     /* V_DATATU   VARCHAR2(20); */
     V_CMPSAL   DATE;
     V_CMPANT   DATE;
     V_SALANT   NUMBER(10);
     V_DEBMES   NUMBER(10);
     V_CREMES   NUMBER(10);
     V_SALATU   NUMBER(10);
     V_ALTSAL   NUMBER(10);
     V_TIPOPE   NUMBER(1);
     CURSOR C_BUSFECSAL IS
            SELECT CMPSAL,SALANT,SALATU FROM R010SAF
            WHERE  NUMEMP = IN_NUMEMP AND
                   TIPCOL = IN_TIPCOL AND
                   NUMCAD = IN_NUMCAD AND
                   CODSAL = IN_CODSAL AND
                   CMPSAL > V_CMPSAL
            ORDER BY CMPSAL;
     BEGIN
     /* Seta Descricao do Tipo de Operacao. */
     /*
     IF  (IN_TIPOPE = 'I') THEN
         V_DESOPE := ' R010SAL_INSERT ';
     ELSIF (IN_TIPOPE = 'U') THEN
         V_DESOPE := ' R010SAL_UPDATE ';
     ELSIF (IN_TIPOPE = 'D') THEN
         V_DESOPE := ' R010SAL_DELETE ';
     END;
     */

     /* Busca Data/Hora Atual do Oracle p/ Log de Depuracao. */
     /* SELECT TO_CHAR (SYSDATE, 'DD/MM/YYYY hh:mi') INTO V_DATATU FROM DUAL; */
     /* V_CONDEP := 1; */

     /* Inicializa Variaveis Auxiliares. */
     V_SALANT := 0;
     V_DEBMES := 0;
     V_CREMES := 0;
     V_SALATU := 0;

     /* Inicializa Variavel c/ Tipo de Operacao a Ser Realizada no Calculo. */
     V_TIPOPE := 0;

     /* Calcula Competencia Atual do Fechamento do Saldo. */
     V_CMPSAL := DATETIME(01,MONTH(IN_DATALT),YEAR(IN_DATALT),0,0,0);

     /* Calcula Competencia Anterior do Fechamento do Saldo. */
     V_CMPANT := DATETimeAdd(MM,-1,V_CMPSAL);

     /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'[Saldo/Cmp/Val]: '||IN_CODSAL||' '||V_CMPSAL||' '||IN_NEWHORSAL||' '||IN_OLDHORSAL); */
     /* V_CONDEP := V_CONDEP + 1; */

     /* Le Registro Competencia Atual Fechamento do Saldo. */
     BEGIN
          SELECT IFNULL(SALANT,0) ,IFNULL(DEBMES,0) ,IFNULL(CREMES,0) ,IFNULL(SALATU,0)  INTO V_SALANT,V_DEBMES,V_CREMES,V_SALATU FROM R010SAF
                 WHERE NUMEMP = IN_NUMEMP AND TIPCOL = IN_TIPCOL AND NUMCAD = IN_NUMCAD AND
                       CODSAL = IN_CODSAL AND CMPSAL = V_CMPSAL;
     EXCEPTION
          WHEN NO_DATA_FOUND THEN
               V_SALANT := 0;
               V_DEBMES := 0;
               V_CREMES := 0;
               V_SALATU := 0;
               V_TIPOPE := 1;
     END;

     /* Verifica se Nao Existe Competencia Atual Fechamento do Saldo (Busca Saldo da Competencia Anterior). */
     IF   (V_TIPOPE = 1) THEN
          BEGIN
          V_SALANT := 0;
               BEGIN
               SELECT IFNULL(SALATU,0) INTO V_SALANT FROM R010SAF
                      WHERE NUMEMP = IN_NUMEMP AND TIPCOL = IN_TIPCOL AND NUMCAD = IN_NUMCAD AND
                            CODSAL = IN_CODSAL AND CMPSAL =
                            (SELECT MAX(CMPSAL) FROM R010SAF
                                    WHERE NUMEMP = IN_NUMEMP AND TIPCOL = IN_TIPCOL AND NUMCAD = IN_NUMCAD AND
                                          CODSAL = IN_CODSAL AND CMPSAL <= V_CMPANT);
               EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                         V_SALANT := 0;
               END;
          V_SALATU := V_SALANT;
          END;
     END IF;

     /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'[DEBMES,CREMES,SALATU]: '||V_DEBMES||' '||V_CREMES||' '||V_SALATU); */
     /* V_CONDEP := V_CONDEP + 1; */

     /* Verifica o Tipo de Operacao e Calcula Debito no Mes/Credito no Mes. */
     IF   (IN_TIPOPE = 'I') THEN
          BEGIN
          IF   (IN_NEWHORSAL < 0) THEN
               V_DEBMES := V_DEBMES + IN_NEWHORSAL;
          ELSE V_CREMES := V_CREMES + IN_NEWHORSAL;
          END IF;
          END;
     ELSIF (IN_TIPOPE = 'U') THEN
          BEGIN
          IF   (IN_OLDHORSAL < 0) THEN
               V_DEBMES := V_DEBMES - IN_OLDHORSAL;
          ELSE V_CREMES := V_CREMES - IN_OLDHORSAL;
          END IF;
          IF   (IN_NEWHORSAL < 0) THEN
               V_DEBMES := V_DEBMES + IN_NEWHORSAL;
          ELSE V_CREMES := V_CREMES + IN_NEWHORSAL;
          END IF;
          END;
     ELSIF (IN_TIPOPE = 'D') THEN
          BEGIN
          IF   (IN_OLDHORSAL < 0) THEN
               V_DEBMES := V_DEBMES - IN_OLDHORSAL;
          ELSE V_CREMES := V_CREMES - IN_OLDHORSAL;
          END IF;
          END;
     END IF;

     /* Calcula Valor da Alteracao do Fechamento do Saldo. */
     V_ALTSAL := (V_SALANT + V_DEBMES + V_CREMES) - V_SALATU;
     /* Calcula Valor Atual do Saldo. */
     V_SALATU := V_SALANT + V_DEBMES + V_CREMES;

     /* Realiza Alteracao/Inclusao do Fechamento do Saldo de Situacoes. */
     IF   (V_TIPOPE = 0) THEN
          BEGIN
          UPDATE R010SAF SET DEBMES = V_DEBMES,CREMES = V_CREMES,SALATU = V_SALATU
                 WHERE NUMEMP = IN_NUMEMP AND TIPCOL = IN_TIPCOL AND NUMCAD = IN_NUMCAD AND
                       CODSAL = IN_CODSAL AND CMPSAL = V_CMPSAL;

          /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'Alterado Fec: '||V_DEBMES||' '||V_CREMES||' '||V_SALATU); */
          /* V_CONDEP := V_CONDEP + 1; */
          END;
     ELSIF (V_TIPOPE = 1) THEN
          BEGIN
          INSERT INTO R010SAF(NUMEMP,TIPCOL,NUMCAD,CODSAL,CMPSAL,SALANT,DEBMES,CREMES,SALATU)
                 VALUES (IN_NUMEMP,IN_TIPCOL,IN_NUMCAD,IN_CODSAL,V_CMPSAL,V_SALANT,V_DEBMES,V_CREMES,V_SALATU);

          /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'Inserido Fec: '||V_DEBMES||' '||V_CREMES||' '||V_SALATU); */
          /* V_CONDEP := V_CONDEP + 1; */
          END;
     END IF;

     /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'Fechamentos Posteriores.'); */
     /* V_CONDEP := V_CONDEP + 1; */

     /* Atualiza os Fechamentos Posteriores do Saldo. */
     FOREACH C_BUSFECSAL INTO V_CMPSAL,V_SALANT,V_SALATU
     LOOP

          /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'[SALANT,SALATU]: '||V_SALANT||' '||V_SALATU); */
          /* V_CONDEP := V_CONDEP + 1; */

          V_SALANT := V_SALANT + V_ALTSAL;
          V_SALATU := V_SALATU + V_ALTSAL;

          /* INSERT INTO R000DEP VALUES (V_DATATU||' - '||V_CONDEP||V_DESOPE||'Alterado [SALANT,SALATU]: '||V_SALANT||' '||V_SALATU); */
          /* V_CONDEP := V_CONDEP + 1; */

          UPDATE R010SAF SET SALANT = V_SALANT, SALATU = V_SALATU
                 WHERE NUMEMP = IN_NUMEMP AND TIPCOL = IN_TIPCOL AND NUMCAD = IN_NUMCAD AND
                       CODSAL = IN_CODSAL AND CMPSAL = V_CMPSAL;
     END LOOP;
     END␀Ò␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
oPROCEDURE R030EMP_ATUCON(P_TIPOPE NUMBER(1),P_NUMEMP NUMBER(4),P_NOMEMP VARCHAR2(40))
 IS
