TRIGGER R070PEO_ED AFTER DELETE ON R070PEO FOR EACH ROW

DECLARE
  l_online       BOOLEAN;
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R070PEO_AUX;
  
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       BEGIN
       /* Insere Registro OLD */
         INSERT INTO R070PEO_AUX (NUMEMP,NUMCAD,DATINI,HORINI)
                          VALUES (:OLD.NUMEMP,:OLD.NUMCAD,:OLD.DATINI,:OLD.HORINI);
       EXCEPTION WHEN OTHERS THEN
         RAISERROR 103 'Erro no INSERT em R070PEO_AUX.';
       END;
  END IF;
END␀␀␀™¿␀␀␀␀␀␀␀␀␀␀␀␀␀fÚ␀␀…¬␀␀´␀„␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀c¬␀␀Ì␀„␀␀␀␀␀␀$0.0.w␀Æÿ␀␀ÿ␀EÑ␀„␀␀␀␀␀␀sG]G]GqC␀êÿ␀␀ÿ␀¤w·␀„␀␀␀␀␀␀oxdxdxì*␀␀Æÿ␀␀ÿ␀C-·␀„␀␀␀␀␀␀€=¿␀␀¿␀␀t␀Æÿ␀␀ÿ␀åDÑ␀„␀␀␀␀␀␀úFÔFÔFqC␀êÿ␀␀ÿ␀w·␀„␀␀␀␀␀␀Gx<x<xì*␀␀Æÿ␀␀ÿ␀×-‹␀„␀␀␀␀␀␀¥Am␀m␀—)␀␀Æÿ␀␀ÿ␀␀␀␀␀␀	␀š¿␀␀␀	␀␀␀␀␀␀␀␀mÚ␀␀N␀	„␀␀␀␀␀␀ª␀/␀0␀n␀Æÿ␀␀|İ␀␀␀~¬␀␀(	„␀␀␀␀␀␀L±␀␀†^¯␀␀d␀␀␀ÿ␀␀{İ␀␀␀EÑ␀	„␀␀␀␀␀␀sG]G]GqC␀êÿ␀␀ÿ␀¤w·␀	„␀␀␀␀␀␀oxdxdxì*␀␀Æÿ␀␀ÿ␀C-·␀	„␀␀␀␀␀␀€=¿␀␀¿␀␀t␀Æÿ␀␀ı×␀␀␀åDÑ␀„␀␀␀␀␀␀úFÔFÔFqC␀êÿ␀␀ÿ␀w·␀„␀␀␀␀␀␀Gx<x<xì*␀␀Æÿ␀␀ÿ␀×-‹␀„␀␀␀␀␀␀¥Am␀m␀—)␀␀Æÿ␀␀ÿ␀…¬␀␀´␀„␀␀␀␀␀␀c±aÉbrwˆ␀Æÿ␀␀Ò␀␀␀.␀t„␀␀␀␀␀␀1␀1␀1␀n€ˆ␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀„␀␀␀␀␀␀Z%#$²$wtˆ␀Æÿ␀␀…Ó␀␀␀»³␀␀€␀„␀␀␀␀␀␀ñ³␀␀ñ³␀␀ñ³␀␀!|ˆ␀␀ÿ␀␀ÿ␀␀Ã„␀␀␀␀␀␀Å␀R␀R␀n␀Æÿ␀␀ÿ␀ş␀␀¢␀␀␀␀␀␀␀␀`ş␀␀Eü␀␀Tş␀␀i␀Æÿ␀␀ÿ␀␀␀␀	0;1;2;3;4wÚ␀␀	SENIOR;0H␀␀

TRIGGER R070PEV_SI AFTER INSERT ON R070PEV
BEGIN
  R070PEV_ATUCON();

  R070PEV_RECALF();

  /* Tabela temporária */
  BEGIN
      DELETE FROM R070PEV_AUX;
      DROP_TEMP_TABLE R070PEV_AUX;
      DELETE FROM R070PEV_API;
      DROP_TEMP_TABLE R070PEV_API;
  EXCEPTION
      WHEN OTHERS THEN NULL;
   END;
END␀sÚ␀␀		SENIOR;0
␀␀TRIGGER R070PEV_EI BEFORE INSERT ON R070PEV FOR EACH ROW

DECLARE
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_online       BOOLEAN;
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_ade_gerpen   BOOLEAN;

  /* Tabela temporária */
  CREATE_TEMP_TABLE R070PEV_AUX;
  CREATE_TEMP_TABLE R070PEV_API;

BEGIN
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) THEN
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       IF   (:NEW.DATFIM = l_data_zero OR :NEW.DATFIM > l_data_atual OR
            (:NEW.DATFIM = l_data_atual AND :NEW.HORFIM > l_hora_atual)) THEN
            BEGIN
            /* Insere Registro NEW */
              INSERT INTO R070PEV_AUX (TIPDOC,NUMDOC,DATINI,HORINI)
                               VALUES (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATINI,:NEW.HORINI);
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro no INSERT em R070PEV_AUX.';
            END;

            SP_RECALF_GERPEN_1(4, l_ade_gerpen OUT);
            IF (l_ade_gerpen = TRUE) THEN
                BEGIN
                    /* Insere Registro NEW */
                    INSERT INTO R070PEV_API (TIPDOC,NUMDOC,DATINI,HORINI)
                                     VALUES (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATINI,:NEW.HORINI);
                EXCEPTION WHEN OTHERS THEN
                    RAISERROR 103 'Erro no INSERT em R070PEV_API.';
                END;
            END IF;
       END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R070PEV');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R070PEV_AUD (SEQREG,VERSEQ,TIPDOC,NUMDOC,DATINI,HORINI,CODPRM,DATFIM,
                                   HORFIM,CODUSU,NUMEMP,TIPCOL,NUMCAD,OBSPRM,STAACC)
                           VALUES (l_seqreg,l_verseq,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATINI,
                                  :NEW.HORINI,:NEW.CODPRM,:NEW.DATFIM,:NEW.HORFIM,:NEW.CODUSU,
                                  :NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.OBSPRM,:NEW.STAACC);

          SP_AUDGENREG(l_seqreg,l_verseq,'R070PEV','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀xÚ␀␀	SENIOR;0I␀␀

TRIGGER R070PEV_SU AFTER UPDATE ON R070PEV
BEGIN
  R070PEV_ATUCON();

  R070PEV_RECALF();

  /* Tabela temporária */
  BEGIN
      DELETE FROM R070PEV_AUX;
      DROP_TEMP_TABLE R070PEV_AUX;
      DELETE FROM R070PEV_API;
      DROP_TEMP_TABLE R070PEV_API;
  EXCEPTION
      WHEN OTHERS THEN NULL;
   END; 
END␀tÚ␀␀		SENIOR;0/␀␀

TRIGGER R070PEV_EU AFTER UPDATE ON R070PEV FOR EACH ROW

DECLARE
  l_online           BOOLEAN;
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_ade_gerpen       BOOLEAN;

  /* Tabela temporária */
  CREATE_TEMP_TABLE R070PEV_AUX;
  CREATE_TEMP_TABLE R070PEV_API;

BEGIN
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) THEN
      BEGIN
          /* Insere Registro NEW */
          INSERT INTO R070PEV_AUX (TIPDOC,NUMDOC,DATINI,HORINI)
                           VALUES (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATINI,:NEW.HORINI);
      EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro no INSERT em R070PEV_AUX.';
      END;

      IF (:OLD.STAACC = 1 OR :NEW.STAACC = 1) THEN
          SP_RECALF_GERPEN_1(4, l_ade_gerpen OUT);
          IF (l_ade_gerpen = TRUE) THEN
              BEGIN
                  /* Insere Registro NEW */
                  INSERT INTO R070PEV_API (TIPDOC,NUMDOC,DATINI,HORINI)
                                   VALUES (:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATINI,:NEW.HORINI);
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no INSERT em R070PEV_API.';
              END;
          END IF;
      END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R070PEV');

  IF (l_auditoria = 'S') THEN

       l_camposAlterados := 'Campo(s) alterado(s): ';
       l_alterou := FALSE;

      IF (:NEW.TIPDOC <> :OLD.TIPDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPDOC ';
      END IF;

      IF (:NEW.NUMDOC <> :OLD.NUMDOC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMDOC ';
      END IF;

      IF (:NEW.DATINI <> :OLD.DATINI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATINI ';
      END IF;

      IF (:NEW.HORINI <> :OLD.HORINI) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORINI ';
      END IF;

      IF (:NEW.CODPRM <> :OLD.CODPRM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODPRM ';
      END IF;

      IF (:NEW.DATFIM <> :OLD.DATFIM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'DATFIM ';
      END IF;

      IF (:NEW.HORFIM <> :OLD.HORFIM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'HORFIM ';
      END IF;

      IF (:NEW.CODUSU <> :OLD.CODUSU) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'CODUSU ';
      END IF;

      IF (:NEW.NUMEMP <> :OLD.NUMEMP) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMEMP ';
      END IF;

      IF (:NEW.TIPCOL <> :OLD.TIPCOL) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'TIPCOL ';
      END IF;

      IF (:NEW.NUMCAD <> :OLD.NUMCAD) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'NUMCAD ';
      END IF;

      IF (:NEW.OBSPRM <> :OLD.OBSPRM) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'OBSPRM ';
      END IF;

        IF (:NEW.STAACC <> :OLD.STAACC) THEN
          l_alterou := TRUE;
          l_camposAlterados := l_camposAlterados||'STAACC ';
      END IF;

      IF (l_alterou = TRUE) THEN

          l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

          l_seqreg := :NEW.SEQREG;

          IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

              BEGIN
                  SELECT MAX(SEQREG) INTO l_seqreg
                    FROM R070PEV_AUD
                   WHERE TIPDOC = :OLD.TIPDOC AND
                         NUMDOC = :OLD.NUMDOC AND
                         DATINI = :OLD.DATINI AND
                         HORINI = :OLD.HORINI AND
                         CODPRM = :OLD.CODPRM;
               EXCEPTION
                WHEN OTHERS THEN
                  RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
              END;
          END IF;

          SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

          BEGIN
              INSERT INTO R070PEV_AUD (SEQREG,VERSEQ,TIPDOC,NUMDOC,DATINI,HORINI,CODPRM,DATFIM,
                                       HORFIM,CODUSU,NUMEMP,TIPCOL,NUMCAD,OBSPRM,STAACC)
                               VALUES (l_seqreg,l_verseq,:NEW.TIPDOC,:NEW.NUMDOC,:NEW.DATINI,
                                      :NEW.HORINI,:NEW.CODPRM,:NEW.DATFIM,:NEW.HORFIM,:NEW.CODUSU,
                                      :NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.OBSPRM,:NEW.STAACC);

              SP_AUDGENREG(l_seqreg,l_verseq,'R070PEV',l_camposAlterados);
          EXCEPTION
            WHEN OTHERS THEN
                RAISERROR 103 'Erro gerar registro para auditoria. ';
          END;
      END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
END␀vÚ␀␀	SENIOR;0H␀␀

TRIGGER R070PEV_SD AFTER DELETE ON R070PEV
BEGIN
  R070PEV_ATUCON();

  R070PEV_RECALF();

  /* Tabela temporária */
  BEGIN
      DELETE FROM R070PEV_AUX;
      DROP_TEMP_TABLE R070PEV_AUX;
      DELETE FROM R070PEV_API;
      DROP_TEMP_TABLE R070PEV_API;
  EXCEPTION
      WHEN OTHERS THEN NULL;
   END;
END␀rÚ␀␀		SENIOR;02␀␀

TRIGGER R070PEV_ED AFTER DELETE ON R070PEV FOR EACH ROW

DECLARE
  l_online       BOOLEAN;
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_ade_gerpen   BOOLEAN;

  /* Tabela temporária */
  CREATE_TEMP_TABLE R070PEV_AUX;
  CREATE_TEMP_TABLE R070PEV_API;

BEGIN
  SP_VerOnLine(l_online OUT);
  IF (l_online = TRUE) THEN
       BEGIN
           /* Insere Registro OLD */
           INSERT INTO R070PEV_AUX (TIPDOC,NUMDOC,DATINI,HORINI)
                            VALUES (:OLD.TIPDOC,:OLD.NUMDOC,:OLD.DATINI,:OLD.HORINI);
       EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'Erro no INSERT em R070PEV_AUX.';
       END;

       /* Caso o histórico for presente, verifica se tem que remover o credenciamento da pessoa da ADE02. */
       IF (:OLD.STAACC = 1) THEN
           SP_RECALF_GERPEN_1(4, l_ade_gerpen OUT);
           IF (l_ade_gerpen = TRUE) THEN
               BEGIN
                   /* Insere Registro OLD */
                   INSERT INTO R070PEV_API (TIPDOC,NUMDOC,DATINI,HORINI)
                                    VALUES (:OLD.TIPDOC,:OLD.NUMDOC,:OLD.DATINI,:OLD.HORINI);
               EXCEPTION WHEN OTHERS THEN
                   RAISERROR 103 'Erro no INSERT em R070PEV_API.';
               END;
           END IF;
       END IF;
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R070PEV');

  IF (l_auditoria = 'S') THEN
      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg
                FROM R070PEV_AUD
              WHERE TIPDOC = :OLD.TIPDOC AND
                    NUMDOC = :OLD.NUMDOC AND
                    DATINI = :OLD.DATINI AND
                    HORINI = :OLD.HORINI AND
                    CODPRM = :OLD.CODPRM;
           EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
          INSERT INTO R070PEV_AUD (SEQREG,VERSEQ,TIPDOC,NUMDOC,DATINI,HORINI,CODPRM,DATFIM,
                                   HORFIM,CODUSU,NUMEMP,TIPCOL,NUMCAD,OBSPRM,STAACC)
                           VALUES (l_seqreg,l_verseq,:OLD.TIPDOC,:OLD.NUMDOC,:OLD.DATINI,
                                  :OLD.HORINI,:OLD.CODPRM,:OLD.DATFIM,:OLD.HORFIM,:OLD.CODUSU,
                                  :OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.OBSPRM,:OLD.STAACC);

          SP_AUDGENREG(l_seqreg,l_verseq,'R070PEV','DELETE');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
