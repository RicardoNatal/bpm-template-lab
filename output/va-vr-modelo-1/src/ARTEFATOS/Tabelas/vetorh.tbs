Ú␀␀PROCEDURE R070PEV_ATUCON
 IS

l_cracha       NUMBER(12);
  l_grupo1       CHAR(5);
  l_inigr1       CHAR(10);
  l_fimgr1       CHAR(10);
  l_grupo2       CHAR(5);
  l_inigr2       CHAR(10);
  l_fimgr2       CHAR(10);
  l_grupo3       CHAR(5);
  l_inigr3       CHAR(10);
  l_fimgr3       CHAR(10);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_idtpes       VARCHAR2(23);

  /* CURSOR c/ os registros gravados no R070PEV_AUX */
  CURSOR c_r070pev_ins IS SELECT TIPDOC,NUMDOC,DATINI,HORINI FROM R070PEV_AUX;
  TYPE t_r070pev_aux IS RECORD(
    TIPDOC   R070PEV_AUX.TIPDOC%TYPE,
    NUMDOC   R070PEV_AUX.NUMDOC%TYPE,
    DATINI   R070PEV_AUX.DATINI%TYPE,
    HORINI   R070PEV_AUX.HORINI%TYPE);
  l_r070pev_aux t_r070pev_aux;

BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  /* Le Registro do CURSOR */
  FOREACH c_R070PEV_ins INTO  l_r070pev_aux.TIPDOC,
                              l_r070pev_aux.NUMDOC,
                              l_r070pev_aux.DATINI,
                              l_r070pev_aux.HORINI
  LOOP
       BEGIN
         SELECT NUMCRA INTO l_cracha
           FROM R090HCH
          WHERE R090HCH.TIPDOC = l_r070pev_aux.TIPDOC AND
                R090HCH.NUMDOC = l_r070pev_aux.NUMDOC AND
                (R090HCH.DATINI < l_data_atual OR
                 (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
                (R090HCH.DATFIM = l_data_zero OR
                 R090HCH.DATFIM > l_data_atual OR
                 (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
       EXCEPTION
         WHEN TOO_MANY_ROWS THEN
           RAISERROR 103 'Erro no SELECT R090HCH - TOO MANY ROWS';
         WHEN NO_DATA_FOUND THEN
           l_cracha := 0;
         WHEN OTHERS THEN
           RAISERROR 103 'ON-Line: Erro no SELECT R090HCH.';
       END;

       /* Verifica se Colaborador possui Cracha */
       IF   (l_cracha <> 0) THEN
            /* Retornas as tres permissoes ativas, caso houver */
            SP_RETPEV(l_r070pev_aux.TIPDOC,l_r070pev_aux.NUMDOC, l_cracha, 
                      l_grupo1 OUT, l_inigr1 OUT, l_fimgr1 OUT, l_grupo2 OUT, l_inigr2 OUT, l_fimgr2 OUT, l_grupo3 OUT, l_inigr3 OUT, l_fimgr3 OUT);

            /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
            SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
            IF (l_crapri = 0) THEN
                l_crapri := l_cracha;
            END IF;

            /*Atualiza somente o crachá principal*/
            BEGIN
              UPDATE R070CON SET PRMRT1 = l_grupo1, DINPR1 = l_inigr1, DFNPR1 = l_fimgr1,
                                       PRMRT2 = l_grupo2, DINPR2 = l_inigr2, DFNPR2 = l_fimgr2,
                                       PRMRT3 = l_grupo3, DINPR3 = l_inigr3, DFNPR3 = l_fimgr3
                                       WHERE NUMFIS = l_crapri;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'R070PEV_ATUCON: Erro Na Atualização de R070CON.';
            END;

            /*Atualiza os crachás secundários da R070CON*/
            SP_UPDPRM(l_cracha,0,0,0,0,l_grupo1,l_grupo2,l_grupo3);
            BEGIN
                SELECT IDTPES INTO l_idtpes FROM R070CON WHERE NUMCRA = l_cracha AND NUMFIS = l_crapri;
            EXCEPTION
              WHEN OTHERS THEN
                NULL;
            END;
       END IF;

       BEGIN
         DELETE FROM R070PEV_AUX
         WHERE TIPDOC = l_r070pev_aux.TIPDOC AND
               NUMDOC = l_r070pev_aux.NUMDOC AND
               DATINI = l_r070pev_aux.DATINI AND
               HORINI = l_r070pev_aux.HORINI;
       EXCEPTION
         WHEN OTHERS THEN
           NULL;
       END;
  END LOOP;
END␀uÚ␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_RECALF_PRMVIS
İ␀␀PROCEDURE R070PEV_RECALF
 IS


  /* CURSOR c/ os registros gravados no R070PEV_API */
  CURSOR c_r070pev_ins IS SELECT TIPDOC,NUMDOC,DATINI,HORINI FROM R070PEV_API;
  TYPE t_r070pev_api IS RECORD(
    TIPDOC   R070PEV_API.TIPDOC%TYPE,
    NUMDOC   R070PEV_API.NUMDOC%TYPE,
    DATINI   R070PEV_API.DATINI%TYPE,
    HORINI   R070PEV_API.HORINI%TYPE);

  l_r070pev_api t_r070pev_api;

BEGIN

    /* Le Registro do CURSOR */
    FOREACH c_R070PEV_ins INTO  l_r070pev_api.TIPDOC,
                                l_r070pev_api.NUMDOC,
                                l_r070pev_api.DATINI,
                                l_r070pev_api.HORINI
    LOOP

        /* Verifica se tem que incluir ou excluir o credenciamento da pessoa na ADE02. */
        SP_RECALF_PRMVIS(l_r070pev_api.TIPDOC, l_r070pev_api.NUMDOC, 0, NULL, NULL, NULL, NULL, NULL, NULL);

        BEGIN
            DELETE FROM R070PEV_API
                  WHERE TIPDOC = l_r070pev_api.TIPDOC AND
                        NUMDOC = l_r070pev_api.NUMDOC AND
                        DATINI = l_r070pev_api.DATINI AND
                        HORINI = l_r070pev_api.HORINI;
        EXCEPTION
            WHEN OTHERS THEN NULL;
        END;
    END LOOP;
END␀Ú␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
