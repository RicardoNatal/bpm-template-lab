31/12/1900–¢␀␀Y␀␀␀␀␀␀␀å¢␀␀å¢␀␀å¢␀␀n␀Æÿ␀␀ÿ␀W³␀␀>␀␀␀␀␀␀␀ø³␀␀'³␀␀ø³␀␀=␀␀ÿ␀␀ÿ␀␀␀␀0;1;2;3«Õ␀␀		SENIOR;0„␀␀TRIGGER R042AVI_AI AFTER INSERT ON R042AVI FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
  l_DataZero DATE;
  l_DataEhZero BOOLEAN;
  l_InfoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  l_Valor := '';
  l_DataEhZero := FALSE;
  l_DataZero := '31/12/1900,00:00:00';
  l_InfoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;

  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
    
  IF ((:NEW.TIPESO <> 0) AND (l_InfoFacult = TRUE) AND l_SimplificaoESocial = FALSE) THEN
    /* Pendência de inclusão */  
    SP_E_SOCIAL('S-2250', 'R042AVI', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATAVI, 0, 'R042AVI_AI');
  
    /* Se já tem data de cancelamento cria uma pendência de cancelamento */
    SP_VALUPDATE_DAT(:NEW.DATCAN, l_DataZero, l_DataEhZero OUT);
  
    IF (l_DataEhZero = TRUE) THEN
      SP_E_SOCIAL('S-2250', 'R042AVI', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, :NEW.DATCAN, :NEW.DATAVI, 0, 'R042AVI_AI');
    END IF;
  END IF;
END␀¬Õ␀␀		SENIOR;0d␀␀

TRIGGER R042AVI_AU AFTER UPDATE ON R042AVI FOR EACH ROW

DECLARE
l_Valor VARCHAR2(2000);
  l_Alterou BOOLEAN;
  l_Valido BOOLEAN;
  l_DataZero DATE;
  l_InformouDatCan BOOLEAN;
  l_InfoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
BEGIN
  l_Valor := '';
  l_Valido := FALSE;
  l_Alterou := FALSE;
  l_InformouDatCan := FALSE;
  l_DataZero := '31/12/1900,00:00:00';
  l_InfoFacult := TRUE;
  l_SimplificaoESocial := FALSE;
  l_VersaoESocial := 0;
  
  SP_ESOCIAL_INFO(:NEW.NUMEMP, l_InfoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
  
  SP_VALUPDATE_DAT(:OLD.DATDEM, :NEW.DATDEM, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  SP_VALUPDATE_NUM(:OLD.TIPESO, :NEW.TIPESO, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
    
  SP_VALUPDATE_DES(:OLD.OBSAVI, :NEW.OBSAVI, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := TRUE;
  END IF;
  
  /* Se a data de cancelamento já estava informada anteriomente, DESConsidera alteração.*/
  SP_VALUPDATE_DAT(:OLD.DATCAN, l_DataZero, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    l_Alterou := FALSE;
  END IF;
  
  /* Verifica se a data de cancelamento foi alterada.*/
  SP_VALUPDATE_DAT(:OLD.DATCAN, :NEW.DATCAN, l_Valido OUT);
  IF (l_Valido = TRUE) THEN
    /* Se a data anteriormente era Zero */
    SP_VALUPDATE_DAT(:OLD.DATCAN, l_DataZero, l_Valido OUT);
    IF (l_Valido = FALSE) THEN
      l_InformouDatCan := TRUE;
    END IF;
  END IF;
  
  IF (l_SimplificaoESocial = FALSE) THEN 
	  /* Se o campo TIPESO antes e depois da alteração não é zero */
	  IF ((:OLD.TIPESO <> 0) AND (:NEW.TIPESO <> 0)) THEN
	    /* Pendência de alteração para os campos DATDEM, TIPESO, OBSAVI */
	    IF (l_Alterou = TRUE) THEN
		  SP_E_SOCIAL('S-2250', 'R042AVI', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATAVI, 0, 'R042AVI_AU');
	    END IF;
	    
	    /* Pendência de alteração para quando o campo DatCan foi informado */
	    IF (l_InformouDatCan = TRUE) THEN
	        SP_E_SOCIAL('S-2250', 'R042AVI', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, :NEW.DATCAN, :NEW.DATAVI, 0, 'R042AVI_AU');
	    END IF;
	  ELSE
	    /* Se o campo TipeSo não estava informado anteriormente e agora está */
	    IF ((:OLD.TIPESO = 0) AND (:NEW.TIPESO <> 0)) THEN
	      IF (l_Alterou = TRUE) THEN
	      	/* Envia como inclusão */
		  	SP_E_SOCIAL('S-2250', 'R042AVI', 'N', 'I', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, NULL, :NEW.DATAVI, 0, 'R042AVI_AU');
		  END IF;
	      
	      IF (l_InformouDatCan = TRUE) THEN
	        /* Envia como alteração */
	        SP_E_SOCIAL('S-2250', 'R042AVI', 'N', 'A', NULL, NULL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_Valor, '', 0, :NEW.DATCAN, :NEW.DATAVI, 0, 'R042AVI_AU');
	      END IF;
	    END IF;
	    
	    /* Se o campo TipeSo estava informado anteriormente e agora não está */
	    IF ((:NEW.TIPESO = 0) AND (:OLD.TIPESO <> 0)) THEN
	      /* Cria pendência para leiaute de exclusão */
	      SP_CONCATENAR_DES('LAYOUT', 'S-2250', l_Valor OUT);            
	      SP_E_SOCIAL('S-3000', 'R042AVI', 'N', 'E', NULL, NULL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_Valor, '', 0, NULL, :OLD.DATAVI, 0, 'R042AVI_AI');
	    END IF;
	  END IF;
  END IF;
  
END␀ªÕ␀␀		SENIOR;0w␀␀

TRIGGER R042AVI_AD AFTER DELETE ON R042AVI FOR EACH ROW

DECLARE
  l_Valor VARCHAR2(2000);
BEGIN
  l_Valor := '';
  
  IF (:OLD.TIPESO <> 0) THEN
	SP_CONCATENAR_DES('LAYOUT', 'S-2250', l_Valor OUT);
