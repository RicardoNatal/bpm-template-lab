¸␀␀CREATE OR REPLACE PROCEDURE SP_PENDPAL(P_CODDSP INT, P_TIPOPE VARCHAR(4000), P_NUMFIS INT, P_TECCRA INT, P_IDTPES CHAR)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  l_count SMALLINT;
BEGIN
  BEGIN

  SELECT COUNT(*) INTO l_count
  FROM R070PAL
  WHERE TIPOPE=P_TIPOPE AND NUMFIS=P_NUMFIS AND TECCRA=P_TECCRA AND IDTPES=P_IDTPES;

  IF (l_count = 0) THEN
    INSERT INTO R070PAL(CODPAL, CODDSP, TIPOPE, NUMFIS, TECCRA, IDTPES) VALUES (SEQ_R070PAL.nextval, P_CODDSP, P_TIPOPE, P_NUMFIS, P_TECCRA, P_IDTPES);
  END IF;

  EXCEPTION
    WHEN OTHERS THEN
      RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_PENDPAL: Erro na inserção da pendência na R070PAL.';
  END;
END;
