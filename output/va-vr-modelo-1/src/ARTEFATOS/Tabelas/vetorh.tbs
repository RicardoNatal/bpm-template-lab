      l_fxcre2 := :OLD.CREFX2;
  END IF;

  IF  (:NEW.CREFX3 <> :OLD.CREFX3) THEN
      l_fxcre3 := :NEW.CREFX3;
  ELSE
      l_fxcre3 := :OLD.CREFX3;
  END IF;

