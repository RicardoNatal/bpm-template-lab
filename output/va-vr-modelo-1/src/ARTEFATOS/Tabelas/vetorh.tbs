  TYPE t_R070HCH_aux IS RECORD(
    TIPOPE   R070HCH_AUX.TipOpe%TYPE,
    NUMEMP   R070HCH_AUX.NumEmp%TYPE,
    TIPCRA   R070HCH_AUX.TipCra%TYPE,
    NUMCAD   R070HCH_AUX.NumCad%TYPE,
    NUMCRA   R070HCH_AUX.NumCra%TYPE,
    CRAOLD   R070HCH_AUX.CraOld%TYPE,
    DATINI   R070HCH_AUX.DatIni%TYPE,
    HORINI   R070HCH_AUX.HorIni%TYPE,
    DATFIM   R070HCH_AUX.DatFim%TYPE,
    HORFIM   R070HCH_AUX.HorFim%TYPE,
    STAATU   R070HCH_AUX.STAATU%TYPE,
    STAACC   R070HCH_AUX.STAACC%TYPE);

  l_R070HCH_aux t_R070HCH_aux;

BEGIN
  /* Inicializa */
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  SP_VerOnLine(l_online OUT);

  /* Le Registro do CURSOR */
  FOREACH c_R070HCH_ins INTO  l_R070HCH_aux.TipOpe,
                               l_R070HCH_aux.NumEmp,
                               l_R070HCH_aux.TipCra,
                               l_R070HCH_aux.NumCad,
                               l_R070HCH_aux.NumCra,
                               l_R070HCH_aux.CraOld,
                               l_R070HCH_aux.DatIni,
                               l_R070HCH_aux.HorIni,
                               l_R070HCH_aux.DatFim,
                               l_R070HCH_aux.HorFim,
                               l_R070HCH_aux.STAATU,
                               l_R070HCH_aux.STAACC                               
  LOOP
     /* consiste sobreposicaode crachás */
     R070HCH_VSOB('I',l_R070HCH_aux.TipCra, l_R070HCH_aux.NumEmp, l_R070HCH_aux.NumCad,
                        l_R070HCH_aux.NumCra, l_R070HCH_aux.DatIni, l_R070HCH_aux.HorIni,
                        l_R070HCH_aux.DatFim, l_R070HCH_aux.HorFim);

     IF  (l_online = TRUE) THEN
         /* TRATAR O STAATU DO HISTÓRICO */
         l_dattol := l_R070HCH_aux.DatIni;
         l_hortol := l_R070HCH_aux.HorIni;

         /* tolerância fixa de 5 minutos na hora de entrada */
         IF    l_r070hch_aux.DatIni = l_data_atual THEN
               L_HORTOL := l_r070hch_aux.HorIni-5;
         ELSE  IF (DATETIMEDIF(DD,l_r070hch_aux.DatIni,l_data_atual) = 1) THEN   /* se passou da meia noite */
                   /* verifica quantos minutos passou */
                   L_HORTOL:=1440 - (1440 - l_hora_atual);
                   IF   L_HORTOL <= 5 THEN
                        L_HORTOL := l_hora_atual;
                        L_DATTOL:=l_data_atual;
                   END IF;
               END IF;
         END IF;

         IF   (l_r070hch_aux.NUMCRA > 0)
         AND  ((L_DATTOL < l_data_atual OR (L_DATTOL = l_data_atual AND L_HORTOL <= l_hora_atual)) AND
               (l_r070hch_aux.DATFIM = l_data_zero OR l_r070hch_aux.DATFIM > l_data_atual OR (l_r070hch_aux.DATFIM = l_data_atual AND
                l_r070hch_aux.HORFIM >= l_hora_atual))) THEN
              SP_ColCon ('I', l_R070HCH_aux.TIPCRA,
                              l_R070HCH_aux.NUMEMP,5,
                              l_R070HCH_aux.NUMCAD,0,'0','0',
                              l_R070HCH_aux.DATINI,
                              l_R070HCH_aux.HORINI,
                              l_R070HCH_aux.NUMCRA,
                              l_R070HCH_aux.DATFIM,
                              l_R070HCH_aux.HORFIM, 0,
                              l_R070HCH_aux.STAACC, 1,1);
              /*********** Iniciar montar o IDTPES *****************************/
              SP_INTSTR(5,'99',l_tippes_str OUT);
              SP_INTSTR(l_R070HCH_aux.NUMEMP,'9999',l_numemp OUT);
              SP_INTSTR(l_R070HCH_aux.NUMCAD,'999999999',l_numcad OUT);
              l_idtpes:= l_tippes_str||l_numemp||l_numcad;
                /*Preenche o campo com espaços para completar 23 posições*/
              l_idtpes := lTrim(l_idtpes);
              l_idtpes := rTrim(l_idtpes);
              LOOP
                  /*Controle do Loop.*/
                  IF (Length(l_idtpes) > 22) THEN
                      EXIT;
                  END IF;
                  l_idtpes := ' '||l_idtpes;
              END LOOP;
              /*********** termina de montar o IDTPES *****************************/
              SP_ATUPRMLOC (l_idtpes, 0);
         END IF;
     END IF;

  END LOOP;
 /* Apaga Registro OLD/NEW em R070HCH_AUX */
  BEGIN
    DELETE FROM R070HCH_AUX;
    DROP_TEMP_TABLE R070HCH_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀␀Ú␀␀		SENIOR;0æ␀␀

