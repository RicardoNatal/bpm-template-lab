TRIGGER R044FIX_EU AFTER UPDATE ON R044FIX FOR EACH ROW

DECLARE
l_temAud       BOOLEAN;
l_codRPA       NUMBER(15);
l_codcpa       NUMBER(4);
l_codtpa       NUMBER(4);
l_datTemp      VARCHAR(10);

BEGIN
  /* Geração de log de alteração de eventos fixos */
  l_codcpa := 11;        /*l_codcpa representa a categoria e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java  */
  l_codtpa := 136;       /*l_codtpa representa a o tipo Alteração e é uma variável estática que tem seus valor definido no fonte u_AuditLogDefinition.java*/
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, 1, l_temAud OUT);

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
	OR (:OLD.TipCol <> :NEW.TipCol)
	OR (:OLD.NumCad <> :NEW.NumCad)
	OR (:OLD.TabEve <> :NEW.TabEve)
	OR (:OLD.CodEve <> :NEW.CodEve)
	OR (:OLD.CodRat <> :NEW.CodRat)
	OR (:OLD.ValEve <> :NEW.ValEve)
	OR (:OLD.ValEmp <> :NEW.ValEmp)
	OR (:OLD.DatIni <> :NEW.DatIni)
	OR (:OLD.DatFim <> :NEW.DatFim)) THEN
  BEGIN	  
	IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);  
	  SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R044FIX_EU', 'FRFIXVAR');  
    	  
	  BEGIN
		/* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp));	
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TipCol));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NumCad));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABEVE', CONVERT(NUMBER_TO_CHAR, :NEW.TabEve));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEVE', CONVERT(NUMBER_TO_CHAR, :NEW.CodEve));
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODRAT', CONVERT(NUMBER_TO_CHAR, :NEW.CodRat));
		SP_DATSTR(:NEW.DATINI, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATINI', l_datTemp);
	  EXCEPTION
		WHEN OTHERS THEN RAISERROR 103 'R044FIX_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	  END;
			 
	  BEGIN
		/* insere os campos que não são chave na Tabela R995PRT (Tipo de auditoria) */
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVALEVE', CONVERT(NUMBER_TO_CHAR, :OLD.ValEve));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWVALEVE', CONVERT(NUMBER_TO_CHAR, :NEW.ValEve));
			
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVALEMP', CONVERT(NUMBER_TO_CHAR, :OLD.ValEmp));
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWVALEMP', CONVERT(NUMBER_TO_CHAR, :NEW.ValEmp));
				
		SP_DATSTR(:OLD.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATFIM', l_datTemp);
		SP_DATSTR(:NEW.DATFIM, 'DD/MM/YYYY', l_datTemp OUT);
		INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATFIM', l_datTemp);	 
	  END;	
	END IF;
	  
	END; 
  END IF; 
END␀Ö␀␀		SENIOR;0&	␀␀

