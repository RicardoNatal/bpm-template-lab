      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
           INSERT INTO R090MVI_AUD (SEQREG,VERSEQ,DATENT,HORENT,SEQENT,NUMCRA,NUMEMP,TIPCOL,NUMCAD,TABORG,
                                    NUMLOC,CODPOR,TIPDOC,NUMDOC,SEGTDO,SEGDOC,PLAVEE,CODPRM,DDITEL,DDDTEL,
                                    DATVAL,HORVAL,TIPVIS,OBSVIS,CODUSU,DATSAI,HORSAI,DATSLO,HORSLO,PLAVES,
