DECLARE
l_online       BOOLEAN;
  l_cravei       NUMBER(12);
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_froonl       BOOLEAN;
  l_data_zero    DATE;
  l_libvei       NUMBER(1);
  l_datval       DATE;
  l_horval       NUMBER(4);
BEGIN
	l_data_zero :=  DATETIME(31, 12, 1900, 0, 0, 0);
	l_cravei := 0;
	/* busca crachá do veículo */
	BEGIN
		SELECT NUMCRA INTO l_cravei FROM R088HPS WHERE
			 PLAVEI = :NEW.PLAVEI AND
			(
			 ((DATINI < :NEW.DATENT) OR (DATINI = :NEW.DATENT AND HORINI <= :NEW.HORENT)) AND
			 (DATFIM > :NEW.DATSAI OR (DATFIM = :NEW.DATSAI AND HORFIM > :NEW.HORSAI) OR DATFIM = l_data_zero)
			 ) AND
			STAACC = 1;
	EXCEPTION
		WHEN OTHERS THEN l_cravei := 0;
	END;

	/* busca crachá da pessoa */
	SP_RETCRA (2, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0,'',0,'',l_crapro OUT);
	IF  (l_crapro = 0)  THEN
		SP_RETCRA (1, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD,0,'',0,'', l_cracha OUT);
	ELSE
		l_cracha := l_crapro;
	END IF;

	/* SE A DATA FINAL DO CADASTRO DO USUÁRIO FOR ZERO OU MAIOR QUE 31/12/2050, ALTERA PARA  31/12/2050 */
    l_datval := :NEW.DATSAI;
    l_horval := 1439;
    IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
       l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
       l_horval := 1439;
    END IF;
	
	/* se tiver os dois crachá, atualiza a ContVei*/
	IF (l_cracha <> 0) AND (l_cravei <> 0) THEN
		SP_VEIPESCON('I', l_cravei, l_cracha, 0, :NEW.PLAVEI, 
					 l_datval, l_horval, :NEW.TIPCOL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '');
	END IF;
END␀¦Ü␀␀		SENIOR;0I␀␀

TRIGGER R088MVS_EU AFTER UPDATE ON R088MVS FOR EACH ROW

DECLARE
l_online       BOOLEAN;
  l_cravei       NUMBER(12);
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_froonl       BOOLEAN;
  l_data_zero    DATE;
  l_libvei       NUMBER(1);
  l_datval       DATE;
  l_horval       NUMBER(4);
BEGIN
	l_data_zero :=  DATETIME(31, 12, 1900, 0, 0, 0);
	l_cravei := 0;
	/* busca crachá do veículo */
	BEGIN
		SELECT NUMCRA INTO l_cravei FROM R088HPS WHERE
			 PLAVEI = :NEW.PLAVEI AND
			(
			 ((DATINI < :NEW.DATENT) OR (DATINI = :NEW.DATENT AND HORINI <= :NEW.HORENT)) AND
			 (DATFIM > :NEW.DATSAI OR (DATFIM = :NEW.DATSAI AND HORFIM > :NEW.HORSAI) OR DATFIM = l_data_zero)
			 ) AND
			STAACC = 1;
	EXCEPTION
		WHEN OTHERS THEN l_cravei := 0;
	END;

	/* busca crachá da pessoa */
	SP_RETCRA (2, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD,0,'',0,'', l_crapro OUT);
	IF  (l_crapro = 0)  THEN
		SP_RETCRA (1, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0,'',0,'',l_cracha OUT);
	ELSE
		l_cracha := l_crapro;
	END IF;
	
	/* SE A DATA FINAL DO CADASTRO DO USUÁRIO FOR ZERO OU MAIOR QUE 31/12/2050, ALTERA PARA  31/12/2050 */
    l_datval := :NEW.DATSAI;
    l_horval := :NEW.HORSAI;
    IF (l_datval = l_data_zero) OR (l_datval > DATETIME(31, 12, 2050, 0, 0, 0)) THEN
       l_datval := DATETIME(31, 12, 2050, 0, 0, 0);
       l_horval := 1439;
    END IF;

	IF (l_cracha <> 0) AND (l_cravei <> 0) THEN
		SP_VEIPESCON('U', l_cravei, l_cracha, 0, :NEW.PLAVEI, 
				     l_datval, l_horval, :NEW.TIPCOL, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, 0, '');
	END IF;
END␀¤Ü␀␀		SENIOR;0ß␀␀

TRIGGER R088MVS_ED AFTER DELETE ON R088MVS FOR EACH ROW

DECLARE
l_online       BOOLEAN;
  l_cravei       NUMBER(12);
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_froonl       BOOLEAN;
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_libvei       NUMBER(1);
BEGIN
	l_data_atual := CURDATE();
	l_data_zero :=  DATETIME(31, 12, 1900, 0, 0, 0);

	/* busca crachá do veículo */
	BEGIN
	  SELECT NUMCRA INTO l_cravei FROM R088HPS WHERE
			 PLAVEI = :OLD.PLAVEI AND
			(
			 ((DATINI < :OLD.DATENT) OR (DATINI = :OLD.DATENT AND HORINI <= :OLD.HORENT)) AND
			 (DATFIM > :OLD.DATSAI OR (DATFIM = :OLD.DATSAI AND HORFIM > :OLD.HORSAI) OR DATFIM = l_data_zero)
			 ) AND
			STAACC = 1;
	EXCEPTION
	  WHEN OTHERS THEN l_cravei := 0;
	END;

	/* busca crachá da pessoa */
	SP_RETCRA (2, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD,0,'',0,'', l_crapro OUT);
	IF  (l_crapro = 0)  THEN
		SP_RETCRA (1, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, 0,'',0,'',l_cracha OUT);
	ELSE
		l_cracha := l_crapro;
	END IF;

	IF (l_cracha <> 0) AND (l_cravei <> 0) THEN
		SP_VEIPESCON('D', l_cravei, l_cracha, 1, :OLD.PLAVEI, 
				     l_data_atual, 0, :OLD.TIPCOL, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, 0, '');
	END IF;
