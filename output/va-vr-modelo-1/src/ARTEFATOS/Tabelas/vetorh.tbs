DECLARE
  l_codrpa NUMBER(15);
  l_temAud BOOLEAN;
  l_datTemp VARCHAR(10);
BEGIN
  SP_EXISTE_LOG(18, 150, 1, l_temAud OUT);  
    
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, 18, 1, 150, 1, 'R040PER_SI', 'FR040PER'); 
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
      SP_DATSTR(:NEW.INIPER, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIPER', l_datTemp);
    EXCEPTION
  	  WHEN OTHERS THEN RAISERROR 103 'R040PER_SI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;
   
   BEGIN
     SP_DATSTR(:NEW.FIMPER, 'DD/MM/YYYY', l_datTemp OUT);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMPER', l_datTemp);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDDIR', CONVERT(NUMBER_TO_CHAR, :NEW.QTDDIR));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDFAL', CONVERT(NUMBER_TO_CHAR, :NEW.QTDFAL));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDAFA', CONVERT(NUMBER_TO_CHAR, :NEW.QTDAFA));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDLIR', CONVERT(NUMBER_TO_CHAR, :NEW.QTDLIR));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDDEB', CONVERT(NUMBER_TO_CHAR, :NEW.QTDDEB));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDLIN', CONVERT(NUMBER_TO_CHAR, :NEW.QTDLIN));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDMIL', CONVERT(NUMBER_TO_CHAR, :NEW.QTDMIL));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDABO', CONVERT(NUMBER_TO_CHAR, :NEW.QTDABO));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDSLD', CONVERT(NUMBER_TO_CHAR, :NEW.QTDSLD));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDABN', CONVERT(NUMBER_TO_CHAR, :NEW.QTDABN));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDASD', CONVERT(NUMBER_TO_CHAR, :NEW.QTDASD));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDGAS', CONVERT(NUMBER_TO_CHAR, :NEW.QTDGAS));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AVOFER', CONVERT(NUMBER_TO_CHAR, :NEW.AVOFER));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AVOPER', CONVERT(NUMBER_TO_CHAR, :NEW.AVOPER));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIACOM', CONVERT(NUMBER_TO_CHAR, :NEW.DIACOM));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIADEV', CONVERT(NUMBER_TO_CHAR, :NEW.DIADEV));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDPNG', CONVERT(NUMBER_TO_CHAR, :NEW.QTDPNG));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITPER', CONVERT(NUMBER_TO_CHAR, :NEW.SITPER));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ALTFIM', :NEW.ALTFIM);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERSUS', :NEW.PERSUS);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PAGADI', :NEW.PAGADI);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDUTE', CONVERT(NUMBER_TO_CHAR, :NEW.QTDUTE));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TOTUTE', CONVERT(NUMBER_TO_CHAR, :NEW.TOTUTE));
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TOTU30', CONVERT(NUMBER_TO_CHAR, :NEW.TOTU30));
     SP_DATSTR(:NEW.LIMCON, 'DD/MM/YYYY', l_datTemp OUT);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LIMCON', l_datTemp);
     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAINT', CONVERT(NUMBER_TO_CHAR, :NEW.DIAINT));
    END;
  END IF;    
END␀”Õ␀␀		SENIOR;0ı!␀␀

TRIGGER R040PER_SU AFTER UPDATE ON R040PER FOR EACH ROW
DECLARE
  l_codrpa NUMBER(15);
  l_temAud BOOLEAN;
  l_datTemp VARCHAR(10);
BEGIN
IF ((:OLD.NumEmp <> :NEW.NumEmp)
OR (:OLD.TipCol <> :NEW.TipCol)
OR (:OLD.NumCad <> :NEW.NumCad)
OR (:OLD.IniPer <> :NEW.IniPer)
OR (:OLD.FimPer <> :NEW.FimPer)
OR (:OLD.QtdDir <> :NEW.QtdDir)
OR (:OLD.QtdFal <> :NEW.QtdFal)
OR (:OLD.QtdAfa <> :NEW.QtdAfa)
OR (:OLD.QtdLir <> :NEW.QtdLir)
OR (:OLD.QtdDeb <> :NEW.QtdDeb)
OR (:OLD.QtdLin <> :NEW.QtdLin)
OR (:OLD.QtdMil <> :NEW.QtdMil)
OR (:OLD.QtdAbo <> :NEW.QtdAbo)
OR (:OLD.QtdSld <> :NEW.QtdSld)
OR (:OLD.QtdAbn <> :NEW.QtdAbn)
OR (:OLD.QtdAsd <> :NEW.QtdAsd)
OR (:OLD.QtdGas <> :NEW.QtdGas)
OR (:OLD.AvoFer <> :NEW.AvoFer)
OR (:OLD.AvoPer <> :NEW.AvoPer)
OR (:OLD.DiaCom <> :NEW.DiaCom)
OR (:OLD.DiaDev <> :NEW.DiaDev)
OR (:OLD.QtdPng <> :NEW.QtdPng)
OR (:OLD.SitPer <> :NEW.SitPer)
OR (:OLD.AltFim <> :NEW.AltFim)
OR (:OLD.PerSus <> :NEW.PerSus)
OR (:OLD.PagAdi <> :NEW.PagAdi)
OR (:OLD.QtdUte <> :NEW.QtdUte)
OR (:OLD.TotUte <> :NEW.TotUte)
OR (:OLD.TotU30 <> :NEW.TotU30)
OR (:OLD.DiaInt <> :NEW.DiaInt)
OR (:OLD.LimCon <> :NEW.LimCon)) THEN
    SP_EXISTE_LOG(18, 149, 1, l_temAud OUT);    
  
    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, 1, 18, 1, 149, 1, 'R040PER_SU', 'FR040PER');
     
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
	    SP_DATSTR(:OLD.INIPER, 'DD/MM/YYYY', l_datTemp OUT);
	    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIPER', l_datTemp);
      EXCEPTION
  	    WHEN OTHERS THEN RAISERROR 103 'R040PER_SU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
    
      BEGIN 
        SP_DATSTR(:OLD.FIMPER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFIMPER', l_datTemp);
