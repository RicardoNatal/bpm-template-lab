TRIGGER R070PEO_SI AFTER INSERT ON R070PEO

BEGIN
  R070PEO_ATUCON();  
END␀hÚ␀␀		SENIOR;0Ñ␀␀TRIGGER R070PEO_EI AFTER INSERT ON R070PEO FOR EACH ROW

DECLARE
  l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_online       BOOLEAN;
  
   /* Tabela temporária */
  CREATE_TEMP_TABLE R070PEO_AUX;
  
BEGIN
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE) THEN
       l_data_zero  := '31/12/1900,00:00:00';
       l_data_atual := CURDATE();
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       IF   (:NEW.DATFIM = l_data_zero OR :NEW.DATFIM > l_data_atual OR
            (:NEW.DATFIM = l_data_atual AND :NEW.HORFIM > l_hora_atual)) THEN
            BEGIN
            /* Insere Registro NEW */
              INSERT INTO R070PEO_AUX (NUMEMP,NUMCAD,DATINI,HORINI)
                               VALUES (:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI);
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro no INSERT em R070PEO_AUX.';
            END;
       END IF;
  END IF;
END␀lÚ␀␀	SENIOR;0S

TRIGGER R070PEO_SU AFTER UPDATE ON R070PEO

BEGIN
  R070PEO_ATUCON();  
END␀iÚ␀␀		SENIOR;0š␀␀

