TRIGGER R304DAD_SI AFTER INSERT ON R304DAD
DECLARE
	CURSOR c_R304DAD IS
	SELECT NUMEMP, TIPCOL, NUMCAD, NUMMAT, NUMCPF, VIGSIT, SEQREG
	  FROM R304DAD 
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304DAD IS RECORD (
		NUMEMP   R304DAD.NumEmp%TYPE,
		TIPCOL   R304DAD.TipCol%TYPE,
		NUMCAD   R304DAD.NumCad%TYPE,
		NUMMAT   R304DAD.NumMat%TYPE,
		NUMCPF   R304DAD.NumCpf%TYPE,
		VIGSIT   R304DAD.VigSit%TYPE,
		SEQREG   R304DAD.SeqReg%TYPE
	);
    
    l_R304DAD t_R304DAD;
	l_PidSta VARCHAR2(30);
	l_DesRes VARCHAR(250);
	l_NumCpfStr VARCHAR(11);
BEGIN
	FOREACH c_R304DAD INTO l_R304DAD.NumEmp, l_R304DAD.TipCol, l_R304DAD.NumCad, l_R304DAD.NumMat, l_R304DAD.NumCpf, l_R304DAD.VigSit, l_R304DAD.SeqReg
	LOOP
		/* Gera um novo PID */
		SP_GERPIDSTA(l_R304DAD.NumEmp, 10, l_PidSta OUT);
		
		/* Adiciona zeros à esquerda do CPF quando necessário */
		l_NumCpfStr := CONVERT(NUMBER_TO_CHAR, l_R304DAD.NumCpf);
		WHILE (LENGTH(l_NumCpfStr) < 11) LOOP
			l_NumCpfStr := '0' || l_NumCpfStr;
		END LOOP;
		
		l_DesRes := 'Matrícula: ' || l_R304DAD.NumMat || ', CPF: ' || l_NumCpfStr;
		
		/* Inclui registro de status na tabela R304STA */
		SP_GERSTA_ESFINGE(10, l_PidSta, l_R304DAD.VigSit, l_DesRes, l_R304DAD.NumEmp, l_R304DAD.TipCol, l_R304DAD.NumCad);
		
		/* Grava o PID gerado no campo PIDSTA da própria tabela */
		BEGIN
			UPDATE R304DAD
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304DAD.NumEmp
			   AND TIPCOL = l_R304DAD.TipCol
			   AND NUMCAD = l_R304DAD.NumCad
			   AND NUMMAT = l_R304DAD.NumMat
			   AND NUMCPF = l_R304DAD.NumCpf
			   AND VIGSIT = l_R304DAD.VigSit
			   AND SEQREG = l_R304DAD.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304DAD.';		
		END;
	END LOOP;
END␀ˆå␀␀		SENIOR;0L␀␀TRIGGER R304DAD_EI BEFORE INSERT ON R304DAD FOR EACH ROW
DECLARE
	l_SeqReg NUMBER(9);
	l_StaEnv CHAR;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Busca última sequência cadastrada */
	BEGIN
		SELECT DAD.SEQREG, STA.STAENV INTO l_SeqReg, l_StaEnv FROM R304DAD DAD, R304STA STA
		 WHERE DAD.PIDSTA = STA.PIDSTA
		   AND DAD.NUMEMP = :NEW.NumEmp
		   AND DAD.TIPCOL = :NEW.TipCol
		   AND DAD.NUMCAD = :NEW.NumCad
		   AND DAD.NUMMAT = :NEW.NumMat
		   AND DAD.NUMCPF = :NEW.NumCpf
		   AND DAD.VIGSIT = :NEW.VigSit
		   AND DAD.PIDSTA = STA.PIDSTA
		   AND DAD.SEQREG = (SELECT MAX(DAD2.SEQREG) FROM R304DAD DAD2
		   					  WHERE DAD2.NUMEMP = DAD.NUMEMP
		   					    AND DAD2.TIPCOL = DAD.TIPCOL
		   					    AND DAD2.NUMCAD = DAD.NUMCAD
		   					    AND DAD2.NUMMAT = DAD.NUMMAT
		   					    AND DAD2.NUMCPF = DAD.NUMCPF
		   					    AND DAD2.VIGSIT = DAD.VIGSIT);
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
			l_StaEnv := '';
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304DAD.';
	END;
	
	/* Verifica se encontrou última sequência */
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
		
		/* Verifica se a última sequência está com status Cancelado */
		IF (l_StaEnv <> 'N') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que registro de sequência anterior ' || l_SeqRegStr || ' esteja com status Cancelado.';
			RAISERROR 103 l_MsgErr;			
		END IF;
	END IF;
END␀‰å␀␀		SENIOR;0•␀␀

TRIGGER R304DAD_EU BEFORE UPDATE ON R304DAD FOR EACH ROW
DECLARE
	l_StaEnv CHAR;
BEGIN
	/* Não deixa alterar registro caso status seja diferente de P - Pendente Envio ou R - Erro */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro podem ser alterados/excluídos.';
	END IF;
END␀Šå␀␀	SENIOR;0/␀␀

TRIGGER R304DAD_SD AFTER DELETE ON R304DAD
BEGIN
	BEGIN
		DELETE FROM R304STA
		 WHERE LAYOUT = 10
		   AND NOT EXISTS (SELECT 1 FROM R304DAD WHERE R304DAD.PIDSTA = R304STA.PIDSTA);
