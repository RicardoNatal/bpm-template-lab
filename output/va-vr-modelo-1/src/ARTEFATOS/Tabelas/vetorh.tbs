BEGIN
BEGIN
    IF (:NEW.DESSLA <> :OLD.DESSLA) THEN
      UPDATE R235REC SET NOMREI = :NEW.DESSLA
       WHERE R235REC.TIPREC = 2 /* LTpoRec = 2 -> Sala */
         AND R235REC.CODSLA = :NEW.CODSLA;
    END IF;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao atualizar a tabela R235REC com o nome da sala.';
