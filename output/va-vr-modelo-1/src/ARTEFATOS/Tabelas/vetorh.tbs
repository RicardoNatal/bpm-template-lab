 ␀␀PROCEDURE R070OCR_ATUCON(P_NUMEMP NUMBER,P_NUMCAD NUMBER,P_CODPRM NUMBER,P_PRMFER NUMBER,P_PRMSAB NUMBER,P_PRMDOM NUMBER,P_ACEOCR NUMBER,P_CODESC NUMBER,P_CODTMA NUMBER,P_CONFAI NUMBER,P_NOMPES VARCHAR2(40),P_USARFA CHAR)
 IS

l_comando_nulo BOOLEAN;
  l_situa        CHAR(1);
  l_cracha       NUMBER(12);
  l_craprov      NUMBER(12);
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  /* Controle de Faixas Horarias */
  l_fx_dom_a     CHAR(56);
  l_fx_seg_a     CHAR(56);
  l_fx_ter_a     CHAR(56);
  l_fx_qua_a     CHAR(56);
  l_fx_qui_a     CHAR(56);
  l_fx_sex_a     CHAR(56);
  l_fx_sab_a     CHAR(56);
  l_fx_dom_p     CHAR(56);
  l_fx_seg_p     CHAR(56);
  l_fx_ter_p     CHAR(56);
  l_fx_qua_p     CHAR(56);
  l_fx_qui_p     CHAR(56);
  l_fx_sex_p     CHAR(56);
  l_fx_sab_p     CHAR(56);
  l_fairef       CHAR(56);
  l_idtpes       VARCHAR2(23);
  l_tippes       CHAR(2);
  l_numemp       CHAR(4);
  l_numcad       CHAR(10);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_usarfa       NUMBER(1);
BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();

  SP_RetCra (1,p_numemp, 5, p_numcad, 0,'',0,'',l_cracha OUT);
  IF  (l_cracha = 0)  THEN
      SP_RetCra (2,p_numemp, 5, p_numcad, 0,'',0,'',l_cracha OUT);
      l_craprov := l_cracha;
  ELSE
      /* BUSCA O CRACHÁ PROVISÓRIO */
      SP_RetCra (2,p_numemp, 5, p_numcad, 0,'',0,'',l_craprov OUT);
  END IF;

  /* Verifica se Colaborador possui Cracha */
  IF   l_cracha <> 0 THEN
      /*Atualização da Controle*/
      /*Monta o Identificador da Pessoa*/
      l_tippes := '05';
      SP_INTSTR(p_numemp,'9999',l_numemp OUT);
      SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
      l_idtpes:= l_tippes||l_numemp||l_numcad;
      /*Preenche o campo com espaços para completar 23 posições*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_idtpes) > 22) THEN
              EXIT;
          END IF;
          l_idtpes := ' '||l_idtpes;
      END LOOP;

      LOOP /*ATUALIZA CRACHÁ PROVISÓRIO E TITULAR SE HOUVER*/

         /*Obtem o crachá principal da pessoa*/
         SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
         IF (l_crapri = 0) THEN
             l_crapri := l_cracha;
         END IF;

         /* Verifica se esta c/ acesso bloqueado */
         l_situa := '0';
         IF (p_aceocr = 2) THEN
              l_situa := '1';
         ELSE  /* P_ACEOCR = 1(Com permissão), LOGO, VERIFICAR SE EXISTE PROVISÓRIO ATIVO, SE SIM ENTÃO TITULAR FICA INVÁLIDO*/
            IF ( (l_craprov <> l_cracha) AND (l_craprov > 0) ) THEN  /* SE EXISTIR PROVISÓRIO, TITULAR É INVÁLIDO SITUA = 1 */
                l_situa := '1';
            END IF;
         END IF;

         /* Assinala na tabela Controle que o Colab. de Outra Unidade utiliza reconhecimento facial */
         IF  p_usarfa = 'S' THEN
             l_usarfa := 1;
         ELSE
             l_usarfa := 0;
         END IF;

         BEGIN
           UPDATE R070CON
           SET CODPRM = p_codprm, PRMSAB = p_prmsab, PRMDOM = p_prmdom, PRMFER = p_prmfer, SITCRA = l_situa, CONFAI = p_confai, NOMPES = p_nompes, USARFA = l_usarfa
           WHERE NUMFIS = l_crapri;
         EXCEPTION WHEN OTHERS THEN
           RAISERROR 103 'R070OCR_ATUCON: Erro Na Atualização da R070CON.';
         END;
         /*Atualiza a Pend_grupo se possuir smart*/
         IF (l_numsma > 0) THEN
             /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
             IF (l_tecpri = 3) THEN
                 SP_ATUPRM(l_cracha, l_numsma, p_codprm, 0, 0, 0, p_prmsab, p_prmdom, p_prmfer);
             ELSE
                 SP_ATUPRM(l_crapri, l_numsma, p_codprm, 0, 0, 0, p_prmsab, p_prmdom, p_prmfer);
             END IF;
         END IF;
         /*Atualiza a permissão dos crachás secundários*/
         SP_UPDPRM(l_cracha,p_codprm,p_prmsab,p_prmdom,p_prmfer,' ',' ',' ');
         IF  (p_codesc <> 0) THEN
             /* Verifica faixa horária */
             SP_FaiOcr (p_numemp, p_numcad, p_codesc, p_codtma,
                        l_fx_dom_a OUT, l_fx_seg_a OUT, l_fx_ter_a OUT, l_fx_qua_a OUT, l_fx_qui_a OUT, l_fx_sex_a OUT, l_fx_sab_a OUT,
                        l_fx_dom_p OUT, l_fx_seg_p OUT, l_fx_ter_p OUT, l_fx_qua_p OUT, l_fx_qui_p OUT, l_fx_sex_p OUT, l_fx_sab_p OUT,
                        l_fairef OUT);
             BEGIN
               UPDATE R070CON
               SET FAIAC1=l_fx_dom_a,FAIAC2=l_fx_seg_a,FAIAC3=l_fx_ter_a,FAIAC4=l_fx_qua_a,
                   FAIAC5=l_fx_qui_a,FAIAC6=l_fx_sex_a,FAIAC7=l_fx_sab_a,FAIPT1=l_fx_dom_p,
                   FAIPT2=l_fx_seg_p,FAIPT3=l_fx_ter_p,FAIPT4=l_fx_qua_p,FAIPT5=l_fx_qui_p,
                   FAIPT6=l_fx_sex_p,FAIPT7=l_fx_sab_p,FAIREF=l_fairef,NOMPES=p_nompes
               WHERE NUMFIS = l_crapri;
             EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'R070OCR_ATUCON: Erro Na Atualização da R070CON 2.';
             END;
         END IF;

         /*CONTROLE PARA SAÍDA DO LOOP*/
         IF (l_craprov = l_cracha) OR (l_craprov = 0) THEN
            EXIT;
         ELSE
            l_cracha := l_craprov; /*Faz a consistência para o provisório*/
         END IF;
         SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);
      END LOOP;
  END IF;
END		SENIOR;23MSP_RETCRA
SP_INTSTR
SP_MAPFIS
SP_ATUPRM
SP_UPDPRM
SP_FAIOCR
SP_ATUTSI
