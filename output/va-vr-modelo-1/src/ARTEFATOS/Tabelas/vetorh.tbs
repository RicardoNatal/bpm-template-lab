DECLARE
  l_datatu       DATE;
  l_datzer       DATE;
  l_codoem_str   VARCHAR2(8);
  l_numcon_str   VARCHAR2(15);
  l_valstr       VARCHAR2(64);
BEGIN
  /*Data atual*/
  l_datatu := CURDATE();
  /*Data zerada*/
  l_datzer := '31/12/1900,00:00:00';

  IF (:NEW.DATINI IS NOT NULL AND (:NEW.DATFIM >= l_datatu OR :NEW.DATFIM = l_datzer)) THEN
    IF (LENGTH(LTRIM(:NEW.DESCON)) IS NOT NULL) AND (LENGTH(LTRIM(:NEW.DESCON)) > 0) THEN
      /* Pendência GT - Empresa Terceira */
      SP_INTSTR(:NEW.CODOEM, '99999999', l_codoem_str OUT);
      SP_SAM_PENDENCIES(43, 1, l_codoem_str);

      /* Pendência GT - Contrato */      
      SP_ESPSTR(:NEW.NUMCON, 15, l_numcon_str OUT);
      l_valstr := l_codoem_str || l_numcon_str;
      SP_SAM_PENDENCIES(44, 1, l_valstr);
    END IF;
  END IF;

END␀ÉÒ␀␀		SENIOR;0ÿ␀␀

TRIGGER R032EMC_EU AFTER UPDATE ON R032EMC FOR EACH ROW

DECLARE
  l_online       BOOLEAN;
  l_codoem_str   VARCHAR2(8);
  l_numcon_str   VARCHAR2(15);
  l_valstr       VARCHAR2(64);
BEGIN
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) AND (:OLD.DATFIM <> :NEW.DATFIM) THEN
      R032EMC_ATUCON(:NEW.CODOEM,:NEW.NUMCON,:NEW.DATFIM);
  END IF;

  /* Pendência SAMSenior */
  IF (:NEW.DESCON <> :OLD.DESCON) THEN
    SP_INTSTR(:NEW.CODOEM, '99999999', l_codoem_str OUT);
    SP_ESPSTR(:NEW.NUMCON, 15, l_numcon_str OUT);
    l_valstr := 'E' || l_codoem_str || l_numcon_str || :OLD.DESCON;
    SP_SAM_PENDENCIES(37, 2, l_valstr);
  END IF;
  
  /* Pendência GT - Contrato */
  IF ((:NEW.DESCON <> :OLD.DESCON) OR (:NEW.DATINI <> :OLD.DATINI) OR (:NEW.DATFIM <> :OLD.DATFIM)) THEN
    SP_INTSTR(:NEW.CODOEM, '99999999', l_codoem_str OUT);
    SP_ESPSTR(:NEW.NUMCON, 15, l_numcon_str OUT);
    l_valstr := l_codoem_str || l_numcon_str;
    SP_SAM_PENDENCIES(44, 2, l_valstr);
  END IF;
END␀ÇÒ␀␀		SENIOR;0s␀␀

TRIGGER R032EMC_ED AFTER DELETE ON R032EMC FOR EACH ROW

DECLARE
  l_online       BOOLEAN;
  l_data_zero    DATE;
  l_codoem_str   VARCHAR2(8);
  l_numcon_str   VARCHAR2(15);
  l_valstr       VARCHAR2(64);
BEGIN
  l_data_zero   := '31/12/2050,00:00:00';
  SP_VerOnLine(l_online OUT);
  IF  (l_online = TRUE) THEN
     R032EMC_ATUCON(:OLD.CODOEM,:OLD.NUMCON,l_data_zero);
  END IF;

  /* Pendência GT - Contrato */
  SP_INTSTR(:OLD.CODOEM, '99999999', l_codoem_str OUT);
  SP_ESPSTR(:OLD.NUMCON, 15, l_numcon_str OUT);
  l_valstr := l_codoem_str || l_numcon_str;
  SP_SAM_PENDENCIES(44, 3, l_valstr);
