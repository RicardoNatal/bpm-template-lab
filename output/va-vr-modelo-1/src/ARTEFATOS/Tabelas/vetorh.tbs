  IF  (:NEW.SENCOL <> :OLD.SENCOL) THEN
      l_sencol := :NEW.SENCOL;
  ELSE
      l_sencol := :OLD.SENCOL;
  END IF;

  IF  (:NEW.DINPR1 <> :OLD.DINPR1) THEN
      IF  (:NEW.DINPR1 = '          ') THEN
          l_dinpr1 := '0000000000000000';
      ELSE
          l_dinpr1 := :NEW.DINPR1||'000000';
      END IF;
      l_Pend23 := TRUE;
  ELSE
      IF  (:OLD.DINPR1 = '          ') THEN
          l_dinpr1 := '0000000000000000';
