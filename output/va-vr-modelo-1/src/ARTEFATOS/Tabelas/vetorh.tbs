 ␀␀PROCEDURE SP_TROCRA(P_NUMCRA NUMBER(12),P_TECCRA NUMBER(1),P_NUMSER NUMBER(12))
 IS

l_auxcra      NUMBER(12);
  l_noDataFound BOOLEAN;
  l_numcra       NUMBER(12);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_chcpri       NUMBER(12);
  l_icard        VARCHAR2(12);
  l_icardpri     VARCHAR2(12);
  l_idtpes       VARCHAR2(23);
  l_data_zero    DATE;
  l_usutel       VARCHAR(31);
  l_comando      VARCHAR(2048);
  l_chcAce       NUMBER(1);
BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  SP_USUTEL(l_usutel OUT);

BEGIN
    SELECT A.CHCACE INTO l_chcAce FROM R070TSI A;
EXCEPTION
    WHEN OTHERS THEN l_chcAce := 0;
END;

  /*Obtem o Crachá Lógico*/
  BEGIN
       SELECT A.NUMCRA INTO l_numcra
       FROM R069FIS A
       WHERE A.NUMFIS = p_numser AND
             A.TECCRA = p_teccra AND
			 A.HORINI = (SELECT MAX(HORINI)
                           FROM R069FIS
                           WHERE NUMFIS = A.NUMFIS AND
                           DATALT = (SELECT MAX(DATALT)
                                     FROM R069FIS
                                     WHERE NUMFIS = A.NUMFIS AND
                                     TECCRA = p_teccra
                                     )
                           AND TECCRA = p_teccra)
              AND DATALT = (SELECT MAX(DATALT)
                           FROM R069FIS
                           WHERE NUMFIS = A.NUMFIS AND
                           TECCRA = p_teccra
                           ) AND
             DATFIM = l_data_zero;
  EXCEPTION
	   /*Se não encontrou o crachá com data em aberto, busca pela maior data de fechamento*/
       WHEN NO_DATA_FOUND THEN
          BEGIN
              SELECT NUMCRA INTO l_numcra
              FROM R069FIS A
              WHERE NUMFIS = p_numser
              AND TECCRA = p_teccra
              AND HORFIM = (SELECT MAX(HORFIM)
                           FROM R069FIS
                           WHERE NUMFIS = A.NUMFIS AND
                           DATFIM = (SELECT MAX(DATFIM)
                                     FROM R069FIS
                                     WHERE NUMFIS = A.NUMFIS AND
                                     TECCRA = p_teccra
                                     )
                           AND TECCRA = p_teccra)
              AND DATFIM = (SELECT MAX(DATFIM)
                           FROM R069FIS
                           WHERE NUMFIS = A.NUMFIS AND
                           TECCRA = p_teccra
                           );
          EXCEPTION
              WHEN NO_DATA_FOUND THEN
                l_numcra := 0;
          END;
       WHEN OTHERS THEN RAISERROR 103 'SPTROCRA 1: Erro No SELECT R069fis.';
  END;

  l_noDataFound:=FALSE;
  BEGIN
       SELECT NUMFIS INTO l_auxcra FROM R070CON WHERE NUMFIS = p_numcra;
  EXCEPTION
       WHEN TOO_MANY_ROWS THEN
         RAISERROR 103 'SP_TROCRA: Erro em Controle - TOO MANY ROWS';
       WHEN NO_DATA_FOUND THEN
         l_noDataFound := TRUE;
       WHEN OTHERS THEN
         RAISERROR 103 'SP_TROCRA: Erro No SELECT R070CON.';
  END;

  IF (l_noDataFound = FALSE) THEN
      /*Verifica se o crachá deletado é principal*/
      BEGIN
          SELECT IDTPES, CHCPRI INTO l_idtpes, l_chcpri FROM R070CON WHERE NUMFIS = p_numcra;
      EXCEPTION
        WHEN OTHERS THEN
          l_chcpri := -1;
      END;

      /*Se o crachá a ser trocado NÃO for o principal*/
      IF (l_chcpri > 0) THEN
          IF (p_numser <> p_numcra) THEN
              /*Efetua a Troca de Crachás*/
              DELETE FROM R070CON WHERE NUMFIS = p_numser;
              UPDATE R070CON SET NUMFIS = p_numser WHERE NUMFIS = p_numcra;
              /*Efetua o Mesmo procedimento anterior para a Controle*/
              IF (p_teccra <> 3) THEN
                  SP_INTSTR(p_numser, '999999999999',l_icardpri OUT);
                  SP_INTSTR(p_numcra, '999999999999',l_icard OUT);
                  /*Efetua o UPDATE para o Novo crachá Principal*/
									
                  l_comando := 'DELETE '||l_usutel||'CONTROLE WHERE ICARD = '''||l_icardpri||'''';
                  SP_CMDTSI(l_comando);
									
                  l_comando := 'UPDATE '||l_usutel||'CONTROLE SET ICARD = '''||l_icardpri||''' WHERE ICARD = '''||l_icard||'''';
                  SP_CMDTSI(l_comando);
									
                  SP_CHCTSI(4, l_icardpri, l_icard, 0, 0);
              ELSE
                /*Se for Smart, atualiza a Pend_Grupo / NumSerial*/
                IF (l_chcAce = 3) THEN
                    SP_CHCTSI(1, 0, 0, p_numser, p_numcra);
                    SP_CHCTSI(6, p_numser, p_numcra, 0, 0);
                ELSE
                    SP_CHCTSI(1, 0, 0, p_numser, p_numcra);
                END IF;
              END IF;
          END IF;
      ELSE
          /*Se a ser efetuada a troca for o principal*/
          /*A procedure sp_trocra, somente é executada caso exista um número físico de mesma*/
          /*tecnologia a ser trocado. Dessa forma, em uma operação de delete*/
          /*Obtem o Crachá Principal Atual*/
          IF (l_chcpri = 0) THEN
              SP_MAPFIS(l_numcra, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
              IF (l_crapri = 0) THEN
                  l_crapri := l_numcra;
              END IF;              
              IF (l_crapri <> p_numcra) THEN
                  /*Efetuar a Troca dos Crachás*/
                  DELETE FROM R070CON WHERE NUMFIS = l_crapri;
                  /*Efetua o UPDATE para o Novo crachá Principal*/
                  UPDATE R070CON SET NUMFIS = l_crapri WHERE NUMFIS = p_numcra;
                  /*Efetua o Mesmo procedimento anterior para a Controle*/
                  IF (p_teccra <> 3) THEN
                      SP_INTSTR(l_crapri, '999999999999',l_icardpri OUT);
                      SP_INTSTR(p_numcra, '999999999999',l_icard OUT);
                      l_comando := 'DELETE '||l_usutel||'CONTROLE WHERE ICARD = '''||l_icardpri||'''';
                      SP_CMDTSI(l_comando);
                      /*Efetua o UPDATE para o Novo crachá Principal*/
                      l_comando := 'UPDATE '||l_usutel||'CONTROLE SET ICARD = '''||l_icardpri||''' WHERE ICARD = '''||l_icard||'''';
                      SP_CMDTSI(l_comando);
                      /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
                      IF (l_tecpri = 3) THEN
                          /*Atualiza a Pend_Grupo / Icard*/
                          SP_CHCTSI(2, l_numcra, p_numcra, 0, 0);
                      ELSE
                          SP_CHCTSI(2, p_numser, p_numcra, 0, 0);
                      END IF;
                  ELSE
                      /*Crachá principal = 3, altera o número físico*/
                      SP_CHCTSI(1, 0, 0, l_crapri, p_numcra);
                  END IF;
              END IF;

              /*Atualiza os demais crachás para apontar para o novo principal*/
              /*Se o principal for de barras, então atualiza o de proximidade e smart se existir*/
              IF (l_tecpri = 1) THEN
                  /*Atualiza o crachá de proximidade*/
                  IF (l_numpro <> 0) THEN
                      UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numpro;
                  END IF;
                  /*Atualiza o crachá Smart*/
                  IF (l_numsma <> 0) THEN
                      UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numsma;
                  END IF;
              /*Se o principal for o de proximidades, então atualiza o de smart se existir*/
              ELSIF (l_tecpri = 2) THEN
                  /*Atualiza o crachá Smart*/
                  IF (l_numsma <> 0) THEN
                      UPDATE R070CON SET CHCPRI = l_crapri WHERE NUMFIS = l_numsma;
                  END IF;
              END IF;
          END IF;
      END IF;
      /*Procedure que atualiza a controle*/
      SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);
  END IF;
END		SENIOR;23BSP_INTSTR
SP_CHCTSI
SP_MAPFIS
SP_ATUTSI
SP_USUTEL
SP_CMDTSI
