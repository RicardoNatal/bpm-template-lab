"␀␀CREATE OR REPLACE PROCEDURE SP_PORCOMDSP(p_Straux IN VARCHAR(4000), p_CenPen IN VARCHAR(4000))
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  l_retpen     CHAR(3);
  l_datenv     TIMESTAMP(0);
  l_datenv_str CHAR(16);
  l_horenv     SMALLINT;
  l_idtpes     VARCHAR(23);
  l_numfis     BIGINT;
  l_dirsvr     VARCHAR(250);
  l_codcmd     SMALLINT;
  l_stacmd     SMALLINT;
  l_seqenv     SMALLINT;
  l_coddsp     BIGINT;
  l_tipope     SMALLINT;
  l_dat_conv   VARCHAR(25);
  l_straux     VARCHAR(2047);
  l_logpen     VARCHAR(2047);
  l_CenPen     VARCHAR(255);
  l_codcen     SMALLINT;
  l_aux        SMALLINT;
  l_gersen     CHAR(1);
  l_cenati     CHAR(1);
  l_r058cen$dirsvr VARCHAR(250);
  l_r058cen$gersen VARCHAR(1);
  l_r058cen$cenati VARCHAR(1);

BEGIN
  l_datenv := TO_DATE(TO_CHAR(CURRENT_TIMESTAMP, 'DD/MM/YYYY'), 'DD/MM/YYYY');
  l_horenv := (TO_CHAR(TO_DATE(TO_CHAR(CURRENT_TIMESTAMP, 'HH24:MI:SS'),'HH24:MI:SS'),'HH24'))::smallint *60 +
              (TO_CHAR(TO_DATE(TO_CHAR(CURRENT_TIMESTAMP, 'HH24:MI:SS'),'HH24:MI:SS'),'MI'))::smallint;
  l_seqenv := (TO_CHAR(TO_DATE(TO_CHAR(CURRENT_TIMESTAMP, 'HH24:MI:SS'),'HH24:MI:SS'),'SS'))::smallint;
  l_stacmd := 1;
  l_tipope := 0;
  l_retpen := '001';
  l_CodCmd := 162;

  begin
    l_idtpes := SUBSTR(p_Straux, 42, 23);
    l_numfis := SUBSTR(p_Straux, 29, 12);

    l_tipope     := SUBSTR(p_Straux, 28, 1);
    l_datenv_str := SUBSTR(p_Straux, 3, 16);
    l_dat_conv   := SUBSTR(l_datenv_str, 1, 2) || '/' ||
                    SUBSTR(l_datenv_str, 3, 2) || '/' ||
                    SUBSTR(l_datenv_str, 5, 2);
    CALL SP_STRTODATE(l_dat_conv, 'DD/MM/AA', l_datenv);
    l_horenv := ((SUBSTR(l_datenv_str, 7, 2)))::smallint * 60 +
                ((SUBSTR(l_datenv_str, 9, 2)))::smallint;

    if (l_tipope = 1) then
      if (l_seqenv > 2) then
        l_seqenv := l_seqenv - 3;
      else
        if (l_horenv > 0) then
          l_horenv := l_horenv - 1;
          l_seqenv := 57;
        else
          l_datenv := (l_datenv + -1);
          l_horenv := 1439;
          l_seqenv := 57;
        end if;
      end if;
    end if;
  exception
    when OTHERS then
      RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_PorComDSP: Problemas ao Formatar a PendĞºncia.';
  end;

  l_CenPen := p_CenPen;
  l_CenPen := LTRIM(l_CenPen);
  l_CenPen := RTRIM(l_CenPen);
  l_straux := p_Straux;

  if (l_CenPen='0') then
    begin
      FOR l_r058cen$dirsvr,l_r058cen$gersen,l_r058cen$cenati IN
      SELECT DIRSVR, GERSEN, CENATI FROM R058CEN WHERE GERSEN='S' AND TIPGER=2
      LOOP
        if (l_r058cen$gersen='S') and (l_r058cen$cenati='S') then

          l_CodDsp := SUBSTR(l_straux, 19, 9);

          if (l_tipope<>3) then
            UPDATE R070DSP SET STACMD = 7 
            WHERE NUMFIS=l_numfis
			AND SUBSTR(VALSTR,42,23)=l_idtpes
            AND STACMD IN (0,1,5,8,9) 
            AND CODCMD=l_codcmd
            AND DIRSVR=l_r058cen$dirsvr
            AND CODDSP=l_CodDsp;
          else
            l_straux := SUBSTR(p_Straux,1,27)||'0'||SUBSTR(p_Straux,29,LENGTH(p_Straux)-28);
          end if;

          begin
            CALL SP_RETLOGPEN(l_logpen);
            INSERT INTO R070DSP (DATENV,HORENV,DIRSVR,VALSTR,RETPEN,QTDTEN,CICATU,NUMFIS,CODCMD,STACMD,SEQENV,LOGPEN,CODDSP) VALUES  (l_datenv,l_horenv,l_r058cen$dirsvr,l_straux,l_retpen,0,0,l_numfis,l_codcmd,l_stacmd,l_seqenv,l_logpen,l_CodDsp);
          exception
            when OTHERS then
              NULL;
            RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_PorComDSP: Erro na inserção da pendência na R070DSP Insert 1.';
          end;

        end if;
      end loop;
    end;
  else
    loop
      begin
        l_aux := POSITION(',' IN l_cenpen);
        if (l_aux=0) then
          l_codcen := l_cenpen;
          l_cenpen := 'FIM';
        else
          l_codcen := SUBSTR(l_cenpen,1,1);
          l_cenpen := SUBSTR(l_cenpen,(l_aux+1),(LENGTH(l_cenpen)));
        end if;
      exception
        when OTHERS then
          RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_PORCOM: Problemas ao Obter a Concentradora.';
      end;
      begin
        SELECT R058CEN.DIRSVR DIRSVR,R058CEN.GERSEN GERSEN,R058CEN.CENATI CENATI
        INTO l_dirsvr, l_gersen, l_cenati
        FROM R058CEN R058CEN
        WHERE CODCEN = l_codcen;
        if (l_gersen='S') and (l_cenati='S') then
        
          l_CodDsp := SUBSTR(l_straux,19,9);
          if (l_tipope<>3) then
            UPDATE R070DSP SET STACMD = 7  
            WHERE NUMFIS=l_numfis
			AND SUBSTR(VALSTR,42,23)=l_idtpes
            AND STACMD IN (0,1,5,8,9) 
            AND CODCMD=l_codcmd 
            AND DIRSVR=l_dirsvr 
            AND CODDSP=l_CodDsp;
          else
            l_straux := SUBSTR(p_Straux,1,27)||'0'||SUBSTR(p_Straux,29,LENGTH(p_Straux)-28);
          end if;

          begin
            CALL SP_RETLOGPEN(l_logpen);
            INSERT INTO R070DSP (DATENV,HORENV,DIRSVR,VALSTR,RETPEN,QTDTEN,CICATU,NUMFIS,CODCMD,STACMD,SEQENV,LOGPEN,CODDSP) VALUES  (l_datenv,l_horenv,l_dirsvr,l_straux,l_retpen,0,0,l_numfis,l_codcmd,l_stacmd,l_seqenv,l_logpen,l_CodDsp);
          exception
            when OTHERS then
              NULL;
            RAISE EXCEPTION SQLSTATE 'PU103' USING MESSAGE = 'SP_PorComDSP: Erro na inserção da pendência na R070DSP Insert 1.';
          end;

        end if;
      exception
        when OTHERS then
          NULL;
      end;

      if (l_cenpen='FIM') then
        exit;
      end if;

    end loop;
  end if;
END;
$BODY$;␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
ª␀␀PROCEDURE SP_PRMAMB(P_VERPLF NUMBER(3),P_CODPLF NUMBER,P_CODPRM OUT NUMBER)
 IS

l_posamb VARCHAR2(24);
l_codprm NUMBER(5);
l_VerPlf NUMBER(3);
l_CodPlf NUMBER(9);
l_paiplf NUMBER(9);
l_datzer DATE;
l_datatu DATE;
BEGIN
    l_codprm := 0;
    l_datzer := '31/12/1900,00:00:00';
    l_datatu := CURDATE();
    /*atribui variaveis auxiliares*/
    l_VerPlf := p_VerPlf;
    l_CodPlf := p_CodPlf;
    /*LOOP para achar recursivamente o ambiente desejado*/
    LOOP

        /*busca prm do proprio ambiente*/
        BEGIN
            SELECT CODPRM, PAIPLF INTO l_codprm, l_paiplf FROM R058PLF WHERE VERPLF = l_VerPlf AND CODPLF = l_CodPlf;
        EXCEPTION
            WHEN OTHERS THEN
              EXIT;
        END;
        IF (l_codprm IS NULL) THEN
            l_codprm := 0;
        END IF;
        /*se for zero, então busca do pai*/
        IF (l_codprm = 0) THEN
            /*para saber quem é ambiente pai, busca informações na r058pla controlando o campo posamb*/
            BEGIN
                SELECT VERPLF, CODPLF INTO l_VerPlf, l_CodPlf FROM R058PLF WHERE VERPLF = l_VerPlf AND CODPLF = l_paiplf;
            EXCEPTION
                WHEN OTHERS THEN
                  EXIT;
            END;
        ELSE
            /*pode sair do LOOP, pois achou o codigo de permissão*/
            EXIT;
        END IF;
    END LOOP;
    /*atribui a variavel de saida*/
    p_codprm := l_codprm;
END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
