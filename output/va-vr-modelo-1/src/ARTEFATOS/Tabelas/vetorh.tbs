        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINTFER', CONVERT(NUMBER_TO_CHAR, :NEW.INTFER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINT13S', CONVERT(NUMBER_TO_CHAR, :OLD.INT13S));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINT13S', CONVERT(NUMBER_TO_CHAR, :NEW.INT13S));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQTDPAR', CONVERT(NUMBER_TO_CHAR, :OLD.QTDPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQTDPAR', CONVERT(NUMBER_TO_CHAR, :NEW.QTDPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTODINT', :OLD.TODINT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTODINT', :NEW.TODINT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDIAABN', CONVERT(NUMBER_TO_CHAR, :OLD.DIAABN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDIAABN', CONVERT(NUMBER_TO_CHAR, :NEW.DIAABN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPCAU', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCAU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPCAU', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCAU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCALHFE', :OLD.CALHFE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCALHFE', :NEW.CALHFE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCALADF', :OLD.CALADF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCALADF', :NEW.CALADF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCALTFE', :OLD.CALTFE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCALTFE', :NEW.CALTFE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCALABO', :OLD.CALABO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCALABO', :NEW.CALABO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCALAAB', :OLD.CALAAB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCALAAB', :NEW.CALAAB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCALTAB', :OLD.CALTAB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCALTAB', :NEW.CALTAB);
        SP_DATSTR(:OLD.FIMFER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFIMFER', l_datTemp);
        SP_DATSTR(:NEW.FIMFER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFIMFER', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSALBAS', CONVERT(NUMBER_TO_CHAR, :OLD.SALBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSALBAS', CONVERT(NUMBER_TO_CHAR, :NEW.SALBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDLICREM', CONVERT(NUMBER_TO_CHAR, :OLD.LICREM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWLICREM', CONVERT(NUMBER_TO_CHAR, :NEW.LICREM));
        SP_DATSTR(:OLD.INILIC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINILIC', l_datTemp);
        SP_DATSTR(:NEW.INILIC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINILIC', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINTABO', CONVERT(NUMBER_TO_CHAR, :OLD.INTABO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINTABO', CONVERT(NUMBER_TO_CHAR, :NEW.INTABO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDQTDDEP', CONVERT(NUMBER_TO_CHAR, :OLD.QTDDEP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWQTDDEP', CONVERT(NUMBER_TO_CHAR, :NEW.QTDDEP));
      END;
    END IF; 
  END IF; 
  /* Exclui registros da publicação do aviso de férias para G7 */
  l_temreg := 0;
  l_oriavi := 0;
  /* 0=Cálculo Recibo de Férias, 1=Programação Individual, 2=Programação Coletiva */
  BEGIN 
      SELECT COUNT(*) INTO l_temreg FROM R040PAF WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND INIPER = :OLD.INIPER AND INIFER = :OLD.INIFER AND ORIAVI = l_oriavi;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN l_temreg := 0;
      WHEN OTHERS THEN l_temreg := 0;       
  END;
    
  IF ((l_alterou = TRUE) AND (l_temreg > 0)) THEN
      BEGIN
          DELETE FROM R040PAF WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND INIPER = :OLD.INIPER AND INIFER = :OLD.INIFER AND ORIAVI = l_oriavi;           
      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;  
  END IF;  
END␀€Õ␀␀		SENIOR;0Î␀␀ 

/* DELETE (OLD) */
TRIGGER R040FEM_ED AFTER DELETE ON R040FEM FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
  l_temreg       NUMBER;	
  l_oriavi       NUMBER;
BEGIN

  /* Geração de logs Recibo de Férias - Mestre*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 44;     /* Recibo de Férias - Mestre*/
  l_codtpa := 199;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);    

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R040FEM_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.INIPER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIPER', l_datTemp);
        SP_DATSTR(:OLD.INIFER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INIFER', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R040FEM_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPFER', :OLD.TIPFER);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OPC13S', :OLD.OPC13S);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PAGMUL', :OLD.PAGMUL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'GERADT', :OLD.GERADT);
        SP_DATSTR(:OLD.DATPAG, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATPAG', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAFER', CONVERT(NUMBER_TO_CHAR, :OLD.DIAFER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAABO', CONVERT(NUMBER_TO_CHAR, :OLD.DIAABO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PRVDES', CONVERT(NUMBER_TO_CHAR, :OLD.PRVDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'REASAL', CONVERT(NUMBER_TO_CHAR, :OLD.REASAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PCTADT', CONVERT(NUMBER_TO_CHAR, :OLD.PCTADT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIALIC', CONVERT(NUMBER_TO_CHAR, :OLD.DIALIC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MINFED', CONVERT(NUMBER_TO_CHAR, :OLD.MINFED));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MINFEN', CONVERT(NUMBER_TO_CHAR, :OLD.MINFEN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MINABO', CONVERT(NUMBER_TO_CHAR, :OLD.MINABO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MINABN', CONVERT(NUMBER_TO_CHAR, :OLD.MINABN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INTFER', CONVERT(NUMBER_TO_CHAR, :OLD.INTFER));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INT13S', CONVERT(NUMBER_TO_CHAR, :OLD.INT13S));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDPAR', CONVERT(NUMBER_TO_CHAR, :OLD.QTDPAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TODINT', :OLD.TODINT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DIAABN', CONVERT(NUMBER_TO_CHAR, :OLD.DIAABN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCAU', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCAU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CALHFE', :OLD.CALHFE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CALADF', :OLD.CALADF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CALTFE', :OLD.CALTFE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CALABO', :OLD.CALABO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CALAAB', :OLD.CALAAB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CALTAB', :OLD.CALTAB);
        SP_DATSTR(:OLD.FIMFER, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FIMFER', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SALBAS', CONVERT(NUMBER_TO_CHAR, :OLD.SALBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'LICREM', CONVERT(NUMBER_TO_CHAR, :OLD.LICREM));
        SP_DATSTR(:OLD.INILIC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INILIC', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INTABO', CONVERT(NUMBER_TO_CHAR, :OLD.INTABO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'QTDDEP', CONVERT(NUMBER_TO_CHAR, :OLD.QTDDEP));
      END;
  END IF; 
  	
  /* Exclui registros da publicação do recibo de férias para G7 */
  l_temreg := 0;
  BEGIN	
      SELECT COUNT(*) INTO l_temreg FROM R040PRF WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND INIPER = :OLD.INIPER AND INIFER = :OLD.INIFER;
  EXCEPTION
	  WHEN NO_DATA_FOUND THEN l_temreg := 0;
      WHEN OTHERS THEN l_temreg := 0;		
  END;
    
  IF (l_temreg > 0) THEN
      BEGIN
	      DELETE FROM R040PCC WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND INIPER = :OLD.INIPER AND INIFER = :OLD.INIFER;
		  DELETE FROM R040PRI WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND INIPER = :OLD.INIPER AND INIFER = :OLD.INIFER;
		  DELETE FROM R040PRE WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND INIPER = :OLD.INIPER AND INIFER = :OLD.INIFER;
		  DELETE FROM R040PRF WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND INIPER = :OLD.INIPER AND INIFER = :OLD.INIFER;		    
   	  EXCEPTION
	      WHEN OTHERS THEN NULL;
	  END;	
  END IF;
  
  /* Exclui registros da publicação do aviso de férias para G7 */
  l_temreg := 0;
  l_oriavi := 0;
  /* 0=Cálculo Recibo de Férias, 1=Programação Individual, 2=Programação Coletiva */
  BEGIN 
      SELECT COUNT(*) INTO l_temreg FROM R040PAF WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND INIPER = :OLD.INIPER AND INIFER = :OLD.INIFER AND ORIAVI = l_oriavi;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN l_temreg := 0;
      WHEN OTHERS THEN l_temreg := 0;       
  END;
    
  IF (l_temreg > 0) THEN
      BEGIN
          DELETE FROM R040PAF WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND INIPER = :OLD.INIPER AND INIFER = :OLD.INIFER AND ORIAVI = l_oriavi;           
      EXCEPTION
          WHEN OTHERS THEN NULL;
      END;  
  END IF;  
  
END␀␀␀4î␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀„Õ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	␀␀␀␀␀␀␀}␀×␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	␀␀␀␀␀␀␀P%€$0.w␀Æÿ␀␀…Ó␀␀␀‘␀␀Ñ␀	␀␀␀␀␀␀␀êGáÀ␀␀îÀ␀␀qC␀êÿ␀␀‘Õ␀␀␀ñ␀␀Ñ␀	␀␀␀␀␀␀␀äGZ”␀␀ ”␀␀qC␀êÿ␀␀ƒÕ␀␀␀Ó␀±␀	␀␀␀␀␀␀␀>´␀û␀q␀Æÿ␀␀Ï␀␀␀…,´␀	␀␀␀␀␀␀␀_@NgNgr␀Æÿ␀␀#␀çî␀␀‘␀␀␀␀␀␀␀␀ï␀␀ï␀␀ï␀␀h)␀␀Æÿ␀␀ÿ␀º␀‘␀␀␀␀␀␀␀␀°#␀¦␀¦␀h)␀␀Æÿ␀␀ÿ␀@¶␀␀␀␀␀␀␀␀␀␀.·␀␀‘¶␀␀‘¶␀␀+␀␀ÿ␀␀ÿ␀-Ì␀␀␀␀␀␀␀␀?sõ␀␀sõ␀␀{␀Æÿ␀␀<#␀Íl¹␀␀␀␀␀␀␀␀␀môlôlQ)␀␀Æÿ␀␀ÿ␀␀␀…Õ␀␀
␀␀␀0;1;2;3;4;5;6‡Õ␀␀		SENIOR;0	␀␀/* INSERT (NEW) */
TRIGGER R040FEV_EI AFTER INSERT ON R040FEV FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Recibo de Férias - Eventos*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 45;     /* Recibo de Férias - Eventos*/
  l_codtpa := 201;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R040FEV_EI', '');

