3␀␀PROCEDURE SP_HisAsa(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_NUMMAT VARCHAR2(15),P_DATAFA DATE)
 IS

l_craaux       NUMBER(12);
  l_crastr       CHAR(12);
  l_data_atual   DATE;
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_sequencia    NUMBER;
  l_straux       VARCHAR2(2047);
  l_faidom_a     CHAR(56);
  l_faiseg_a     CHAR(56);
  l_faiter_a     CHAR(56);
  l_faiqua_a     CHAR(56);
  l_faiqui_a     CHAR(56);
  l_faisex_a     CHAR(56);
  l_faisab_a     CHAR(56);
  l_faidom_p     CHAR(56);
  l_faiseg_p     CHAR(56);
  l_faiter_p     CHAR(56);
  l_faiqua_p     CHAR(56);
  l_faiqui_p     CHAR(56);
  l_faisex_p     CHAR(56);
  l_faisab_p     CHAR(56);
  l_fairef CHAR(56);
  /*Controle de permissão para 3º turno*/
  l_prmsabequal  NUMBER;
  l_prmdomequal  NUMBER;
  l_prmsegequal  NUMBER;
  /* afastamentos */
  l_datini       CHAR(6);
  l_datfim       CHAR(6);
  l_horini       CHAR(4);
  l_horfim       CHAR(4);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_apupfs       CHAR(1);
BEGIN
  /* Inicializa */
  l_apupfs := 'E';
  l_data_atual := CURDATE();

  /* Se for um afastamento de saida autorizada e for na semana atual até sábado */
  /* ser for pro domingo não carrega porque podera ser do terceiro turno. */
  IF  (DATETIMEDIF(DD,p_datafa,l_data_atual) >= 0)
  AND (DATETIMEDIF(DD,p_datafa,l_data_atual) <= 5) THEN
       SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0, p_nummat,0,'',l_cracha OUT);
       IF   (l_cracha = 0)  THEN
             SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0, p_nummat,0,'',l_cracha OUT);
       END IF;
       IF   l_cracha > 0 THEN
           /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
           SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
           IF (l_crapri = 0) THEN
               l_crapri := l_cracha;
           END IF;
           /* busca a faixa horaria da semana */
           IF  (p_tipcol = 6) THEN
               SP_FaiAlu (p_nummat,
        	         l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                   l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                   l_fairef OUT);
               /*Preenche o Identificador da pessoa*/
               l_idtpes:= '10'||p_nummat;
           ELSE
                SP_APUCOL(p_numemp, p_tipcol, p_numcad, l_apupfs OUT);
                /*Se o controle for por atividades do professor*/
                IF (l_apupfs = 'A') THEN
                    SP_FaiPro(p_numemp,p_tipcol,p_numcad,
                              l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                              l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                              l_fairef OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);
                ELSE

                    SP_FaiHor(p_numemp,p_tipcol,p_numcad,
                              l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                              l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                              l_fairef OUT, l_prmsabequal OUT, l_prmdomequal OUT, l_prmsegequal OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);
                END IF; 

                /*Obtem o Tipo de Pessoa*/
                SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
                SP_INTSTR(p_numemp,'9999',l_numemp OUT);
                SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
                SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
                l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
           END IF;
            /* atualiza a tabela R070CON */
            BEGIN
                UPDATE R070CON SET
                       FAIAC1=l_faidom_a,FAIAC2=l_faiseg_a,FAIAC3=l_faiter_a,FAIAC4=l_faiqua_a,
                       FAIAC5=l_faiqui_a,FAIAC6=l_faisex_a,FAIAC7=l_faisab_a,
                       FAIPT1=l_faidom_p,FAIPT2=l_faiseg_p,FAIPT3=l_faiter_p,FAIPT4=l_faiqua_p,
                       FAIPT5=l_faiqui_p,FAIPT6=l_faisex_p,FAIPT7=l_faisab_p,
                       FAIREF=l_fairef
                WHERE NUMFIS = l_crapri;
            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SPHISASA: Erro no update R070CON.';
            END;
            /*Preenche o campo com espaços para completar 23 posições*/
            l_idtpes := lTrim(l_idtpes);
            l_idtpes := rTrim(l_idtpes);
            LOOP
                /*Controle do Loop.*/
                IF (Length(l_idtpes) > 22) THEN
                    EXIT;
                END IF;
                l_idtpes := ' '||l_idtpes;
            END LOOP;
            /*Procedure que atualiza a controle*/
            SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);  
       END IF;
  END IF;
END		SENIOR;23XSP_RETCRA
SP_MAPFIS
SP_FAIALU
SP_APUCOL
SP_FAIPRO
SP_FAIHOR
SP_INTSTR
SP_ATUTSI
3␀␀PROCEDURE SP_HisAsa(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_NUMMAT VARCHAR2(15),P_DATAFA DATE)
 IS

l_craaux       NUMBER(12);
  l_crastr       CHAR(12);
  l_data_atual   DATE;
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_sequencia    NUMBER;
  l_straux       VARCHAR2(2047);
  l_faidom_a     CHAR(56);
  l_faiseg_a     CHAR(56);
  l_faiter_a     CHAR(56);
  l_faiqua_a     CHAR(56);
  l_faiqui_a     CHAR(56);
  l_faisex_a     CHAR(56);
  l_faisab_a     CHAR(56);
  l_faidom_p     CHAR(56);
  l_faiseg_p     CHAR(56);
  l_faiter_p     CHAR(56);
  l_faiqua_p     CHAR(56);
  l_faiqui_p     CHAR(56);
  l_faisex_p     CHAR(56);
  l_faisab_p     CHAR(56);
  l_fairef CHAR(56);
  /*Controle de permissão para 3º turno*/
  l_prmsabequal  NUMBER;
  l_prmdomequal  NUMBER;
  l_prmsegequal  NUMBER;
  /* afastamentos */
  l_datini       CHAR(6);
  l_datfim       CHAR(6);
  l_horini       CHAR(4);
  l_horfim       CHAR(4);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_apupfs       CHAR(1);
BEGIN
  /* Inicializa */
  l_apupfs := 'E';
  l_data_atual := CURDATE();

  /* Se for um afastamento de saida autorizada e for na semana atual até sábado */
  /* ser for pro domingo não carrega porque podera ser do terceiro turno. */
  IF  (DATETIMEDIF(DD,p_datafa,l_data_atual) >= 0)
  AND (DATETIMEDIF(DD,p_datafa,l_data_atual) <= 5) THEN
       SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0, p_nummat,0,'',l_cracha OUT);
       IF   (l_cracha = 0)  THEN
             SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0, p_nummat,0,'',l_cracha OUT);
       END IF;
       IF   l_cracha > 0 THEN
           /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
           SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
           IF (l_crapri = 0) THEN
               l_crapri := l_cracha;
           END IF;
           /* busca a faixa horaria da semana */
           IF  (p_tipcol = 6) THEN
               SP_FaiAlu (p_nummat,
        	         l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                   l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                   l_fairef OUT);
               /*Preenche o Identificador da pessoa*/
               l_idtpes:= '10'||p_nummat;
           ELSE
                SP_APUCOL(p_numemp, p_tipcol, p_numcad, l_apupfs OUT);
                /*Se o controle for por atividades do professor*/
                IF (l_apupfs = 'A') THEN
                    SP_FaiPro(p_numemp,p_tipcol,p_numcad,
                              l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                              l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                              l_fairef OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);
                ELSE

                    SP_FaiHor(p_numemp,p_tipcol,p_numcad,
                              l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                              l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                              l_fairef OUT, l_prmsabequal OUT, l_prmdomequal OUT, l_prmsegequal OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);
                END IF; 

                /*Obtem o Tipo de Pessoa*/
                SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
                SP_INTSTR(p_numemp,'9999',l_numemp OUT);
                SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
                SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
                l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
           END IF;
            /* atualiza a tabela R070CON */
            BEGIN
                UPDATE R070CON SET
                       FAIAC1=l_faidom_a,FAIAC2=l_faiseg_a,FAIAC3=l_faiter_a,FAIAC4=l_faiqua_a,
                       FAIAC5=l_faiqui_a,FAIAC6=l_faisex_a,FAIAC7=l_faisab_a,
                       FAIPT1=l_faidom_p,FAIPT2=l_faiseg_p,FAIPT3=l_faiter_p,FAIPT4=l_faiqua_p,
                       FAIPT5=l_faiqui_p,FAIPT6=l_faisex_p,FAIPT7=l_faisab_p,
                       FAIREF=l_fairef
                WHERE NUMFIS = l_crapri;
            EXCEPTION
                WHEN OTHERS THEN RAISERROR 103 'SPHISASA: Erro no update R070CON.';
            END;
            /*Preenche o campo com espaços para completar 23 posições*/
            l_idtpes := lTrim(l_idtpes);
            l_idtpes := rTrim(l_idtpes);
            LOOP
                /*Controle do Loop.*/
                IF (Length(l_idtpes) > 22) THEN
                    EXIT;
                END IF;
                l_idtpes := ' '||l_idtpes;
            END LOOP;
            /*Procedure que atualiza a controle*/
            SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);  
       END IF;
  END IF;
END		SENIOR;21MSP_RETCRA
SP_MAPFIS
SP_FAIALU
SP_APUCOL
SP_FAIPRO
SP_FAIHOR
SP_INTSTR
)␀␀PROCEDURE SP_HisAsa(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_NUMMAT VARCHAR2(15),P_DATAFA DATE)
 IS

l_numcra       CHAR(12);
  l_craaux       NUMBER(12);
  l_crastr       CHAR(12);
  l_data_atual   DATE;
  l_crapro       NUMBER(12);
  l_cracha       NUMBER(12);
  l_sequencia    NUMBER;
  l_straux       VARCHAR2(2047);
  l_faidom_a     CHAR(56);
  l_faiseg_a     CHAR(56);
  l_faiter_a     CHAR(56);
  l_faiqua_a     CHAR(56);
  l_faiqui_a     CHAR(56);
  l_faisex_a     CHAR(56);
  l_faisab_a     CHAR(56);
  l_faidom_p     CHAR(56);
  l_faiseg_p     CHAR(56);
  l_faiter_p     CHAR(56);
  l_faiqua_p     CHAR(56);
  l_faiqui_p     CHAR(56);
  l_faisex_p     CHAR(56);
  l_faisab_p     CHAR(56);
  l_fairef CHAR(56);
  /*Controle de permissão para 3º turno*/
  l_prmsabequal  NUMBER;
  l_prmdomequal  NUMBER;
  l_prmsegequal  NUMBER;
  /* afastamentos */
  l_datini       CHAR(6);
  l_datfim       CHAR(6);
  l_horini       CHAR(4);
  l_horfim       CHAR(4);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_apupfs       CHAR(1);
BEGIN
  /* Inicializa */
  l_apupfs := 'E';
  l_data_atual := CURDATE();

  /* Se for um afastamento de saida autorizada e for na semana atual até sábado */
  /* ser for pro domingo não carrega porque podera ser do terceiro turno. */
  IF  (DATETIMEDIF(DD,p_datafa,l_data_atual) >= 0)
  AND (DATETIMEDIF(DD,p_datafa,l_data_atual) <= 5) THEN
       SP_RETCRA (1, p_numemp, p_tipcol, p_numcad, 0, p_nummat,0,'',l_cracha OUT);
       IF   (l_cracha = 0)  THEN
             SP_RETCRA (2, p_numemp, p_tipcol, p_numcad, 0, p_nummat,0,'',l_cracha OUT);
       END IF;
       IF   l_cracha > 0 THEN
           /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
           SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
           IF (l_crapri = 0) THEN
               l_crapri := l_cracha;
           END IF;
           /* busca a faixa horaria da semana */
           IF  (p_tipcol = 6) THEN
               SP_FaiAlu (p_nummat,
        	         l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                   l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                   l_fairef OUT);
           ELSE
              SP_APUCOL(p_numemp, p_tipcol, p_numcad, l_apupfs OUT);
              /*Se o controle for por atividades do professor*/
              IF (l_apupfs = 'A') THEN
                  SP_FaiPro(p_numemp,p_tipcol,p_numcad,
                      l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                      l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                      l_fairef OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);
              ELSE
                  SP_FaiHor(p_numemp,p_tipcol,p_numcad,
                      l_faidom_a OUT,l_faiseg_a OUT,l_faiter_a OUT,l_faiqua_a OUT,l_faiqui_a OUT,l_faisex_a OUT,l_faisab_a OUT,
                      l_faidom_p OUT,l_faiseg_p OUT,l_faiter_p OUT,l_faiqua_p OUT,l_faiqui_p OUT,l_faisex_p OUT,l_faisab_p OUT,
                      l_fairef OUT, l_prmsabequal OUT, l_prmdomequal OUT, l_prmsegequal OUT, l_datini OUT, l_datfim OUT, l_horini OUT, l_horfim OUT);
              END IF;
           END IF;
           /* coloca zeros a esquerda do numero */
           SP_INTSTR(l_cracha,'999999999999',l_numcra OUT);

           /* atualiza a tabela R070CON */
           BEGIN
               UPDATE R070CON SET
                      FAIAC1=l_faidom_a,FAIAC2=l_faiseg_a,FAIAC3=l_faiter_a,FAIAC4=l_faiqua_a,
                      FAIAC5=l_faiqui_a,FAIAC6=l_faisex_a,FAIAC7=l_faisab_a,
                      FAIPT1=l_faidom_p,FAIPT2=l_faiseg_p,FAIPT3=l_faiter_p,FAIPT4=l_faiqua_p,
                     FAIPT5=l_faiqui_p,FAIPT6=l_faisex_p,FAIPT7=l_faisab_p,
                      FAIREF=l_fairef
               WHERE NUMFIS = l_crapri;
           EXCEPTION
               WHEN OTHERS THEN RAISERROR 103 'SPHISASA: Erro no update R070CON.';
           END;
       END IF;
  END IF;
END		SENIOR;22MSP_RETCRA
