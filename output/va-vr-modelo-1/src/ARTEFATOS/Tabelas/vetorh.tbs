ó␀␀/*
 OBJETIVO: PROCEDURE CRIADA PARA REALIZAR A CONVERSÃO DE UMA DATA EM CARACTERES PARA O TIPO DATA(DATE), ATRAVÉS DE UMA MÁSCARA INFORMADA
DEFINIÇÃO: ESTA PROCEDURE SUPORTA MÁSCARA COM DIA, MÊS, ANO, HORA, MINUTO E SEGUNDO EM QUALQUER FORMATO DEFINIDO NA MÁSCARA/VALOR.	
	    DIA: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'DD'(DIA COM 2 DÍGITOS), ESTE CAMPO É OBRIGATÓRIO NA MÁSCARA.
	    MÊS: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'MM'(MÊS COM 2 DÍGITOS), ESTE CAMPO É OBRIGATÓRIO NA MÁSCARA E DEVE POSSUIR VALORES ENTRE 1 E 12.
	    ANO: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'AA'(ANO COM 2 DÍGITOS) OU 'AAAA'(ANO COM 4 DÍGITOS/MILÊNIO), ESTE CAMPO É OBRIGATÓRIO NA MÁSCARA. */
/*	   HORA: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'HH'(HORA COM 2 DÍGITOS NO FORMATO HH24) 
	       , ESTE CAMPO NÃO É OBRIGATÓRIO NA MÁSCARA E DEVE POSSUIR VALORES ENTRE 0 E 23. Valor padrão 0(zero) se não informado.
	 MINUTO: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'MI'(MINUTOS COM 2 DÍGITOS) 
	       , ESTE CAMPO NÃO É OBRIGATÓRIO NA MÁSCARA E DEVE POSSUIR VALORES ENTRE 0 E 59. Valor padrão 0(zero) se não informado.
	SEGUNDO: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'SS'(SEGUNDOS COM 2 DÍGITOS) 
	       , ESTE CAMPO NÃO É OBRIGATÓRIO NA MÁSCARA E DEVE POSSUIR VALORES ENTRE 0 E 59. Valor padrão 0(zero) se não informado. */

/* **** OBSERVAÇÃO: CASO O PARÂMETRO P_VALUE SEJA VAZIO, A DATA RETORNADA É 31/12/1900 00:00:00 */

create or replace PROCEDURE SP_STRTODATE(p_value IN VARCHAR2,p_mask IN VARCHAR2,p_return OUT DATE) is
  l_day VARCHAR2(2);
  l_month VARCHAR2(2);
  l_year VARCHAR2(4);
  l_hour VARCHAR2(2);
  l_minute VARCHAR2(2);
  l_second VARCHAR2(2);
  l_mask VARCHAR2(30);
  l_pos NUMBER(2);
  l_count NUMBER(2);
  l_validate NUMBER(2);
begin

  /*VALIDA SE A DATA PASSADA NÃO ESTÁ ZERADA*/
  IF (p_value = '') OR (p_value IS NULL) THEN        
    p_return := TO_DATE('31/12/1900', 'DD/MM/YYYY');
    GOTO DATA_VAZIA; 
  END IF;

  /*VALIDA O TAMANHO DA MÁSCARA INFORMADA*/
  if ( LENGTH(p_value) <> LENGTH(p_mask) ) then
    raise_application_error(-20000 + -(103),'SP_STRTODATE: Tamanho da máscara incompatível com literal informado.');
  end if;
  l_pos := 0;
  l_count := 0;
  l_hour := '00';
  l_minute := '00';
  l_second := '00';
  l_mask := UPPER(p_mask);
  
  /*YEAR*/
  l_count := 4;
   /*AAAA*/
  l_pos   := InStr(l_mask, 'AAAA');
  if (l_pos=0) then
    /*AA*/
    l_count := 2;
	l_pos   := InStr(l_mask, 'AA');
    if (l_pos=0) then
      raise_application_error(-20000 + -(103),'SP_STRTODATE: Ano deve ser informado na máscara para conversão.');
    else
      begin
        l_validate := TO_NUMBER( SUBSTR(p_value,l_pos,l_count) );
      exception
        when OTHERS then
          raise_application_error(-20000 + -(103),'SP_STRTODATE: Erro ao converter Ano - AA: '|| SQLERRM);
      end;	  
      if (l_validate>=0) 
      AND (l_validate<=50) then
        l_year := '20'||SUBSTR(p_value,l_pos,l_count);
      else
        l_year := '19'||SUBSTR(p_value,l_pos,l_count);
      end if;
    end if;
  else
    l_year := SUBSTR(p_value,l_pos,l_count);
  end if;
  /*END YEAR*/
  
  /*DAY*/
  l_count := 2;
  l_pos   := InStr(l_mask, 'DD');
  if (l_pos=0) then
    raise_application_error(-20000 + -(103),'SP_STRTODATE: Dia deve ser informado na máscara para conversão.');
  else
    l_day := SUBSTR(p_value,l_pos,l_count);
  end if;
  /*END DAY*/
  
  /*MONTH*/
  l_count := 2;
  l_pos   := InStr(l_mask, 'MM');
  if (l_pos=0) then
    raise_application_error(-20000 + -(103),'SP_STRTODATE: Mês deve ser informado na máscara para conversão.');
  else
    l_validate := TO_NUMBER( SUBSTR(p_value,l_pos,l_count) );
    if (l_validate>=1) 
      AND (l_validate<=12) then
      l_month := SUBSTR(p_value,l_pos,l_count);
    else
      raise_application_error(-20000 + -(103),'SP_STRTODATE: Mês deve estar entre 01 e 12.');
    end if;
  end if;
  /*END MONTH*/
  
  /*HOUR*/
  l_count := 2;
  l_pos   := InStr(l_mask, 'HH');
  if (l_pos<>0) then
    l_validate := TO_NUMBER( SUBSTR(p_value,l_pos,l_count) );
    if (l_validate>=0) 
      AND (l_validate<=23) then
      l_hour := SUBSTR(p_value,l_pos,l_count);
    else
      raise_application_error(-20000 + -(103),'SP_STRTODATE: Hora deve estar entre 0 e 23.');
    end if;
  end if;
  /*END HOUR*/
  
  /*MINUTES*/
  l_count := 2;
  l_pos   := InStr(l_mask, 'MI');
  if (l_pos<>0) then
    l_validate := TO_NUMBER( SUBSTR(p_value,l_pos,l_count) );
    if (l_validate>=0) 
      AND (l_validate<=59) then
      l_minute := SUBSTR(p_value,l_pos,l_count);
    else
      raise_application_error(-20000 + -(103),'SP_STRTODATE: Minuto deve estar entre 0 e 59.');
    end if;
  end if;
  /*END MINUTES*/
  
  /*SECOND*/
  l_count := 2;
  l_pos   := InStr(l_mask, 'SS');
  if (l_pos<>0) then
    l_validate := TO_NUMBER( SUBSTR(p_value,l_pos,l_count) );
    if (l_validate>=0) 
      AND (l_validate<=59) then
      l_second := SUBSTR(p_value,l_pos,l_count);
    else
      raise_application_error(-20000 + -(103),'SP_STRTODATE: Segundo deve estar entre 0 e 59.');
    end if;
  end if;
  /*END SECOND*/
  
  /*EFETUA A CONVERSÃO*/
  BEGIN
    p_return := TO_DATE(l_day||'/'||l_month||'/'||l_year||' '||l_hour||':'||l_minute||':'||l_second, 'DD/MM/YYYY HH24:MI:SS');
  EXCEPTION
    when OTHERS then
      raise_application_error(-20000 + -(103),'SP_STRTODATE: Erro ao converter data: '|| SQLERRM);
  END;

  <<DATA_VAZIA>>
    NULL;
end;

		ORACLE;22
ó␀␀/*
 OBJETIVO: PROCEDURE CRIADA PARA REALIZAR A CONVERSÃO DE UMA DATA EM CARACTERES PARA O TIPO DATA(DATE), ATRAVÉS DE UMA MÁSCARA INFORMADA
DEFINIÇÃO: ESTA PROCEDURE SUPORTA MÁSCARA COM DIA, MÊS, ANO, HORA, MINUTO E SEGUNDO EM QUALQUER FORMATO DEFINIDO NA MÁSCARA/VALOR.	
	    DIA: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'DD'(DIA COM 2 DÍGITOS), ESTE CAMPO É OBRIGATÓRIO NA MÁSCARA.
	    MÊS: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'MM'(MÊS COM 2 DÍGITOS), ESTE CAMPO É OBRIGATÓRIO NA MÁSCARA E DEVE POSSUIR VALORES ENTRE 1 E 12.
	    ANO: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'AA'(ANO COM 2 DÍGITOS) OU 'AAAA'(ANO COM 4 DÍGITOS/MILÊNIO), ESTE CAMPO É OBRIGATÓRIO NA MÁSCARA. */
/*	   HORA: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'HH'(HORA COM 2 DÍGITOS NO FORMATO HH24) 
	       , ESTE CAMPO NÃO É OBRIGATÓRIO NA MÁSCARA E DEVE POSSUIR VALORES ENTRE 0 E 23. Valor padrão 0(zero) se não informado.
	 MINUTO: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'MI'(MINUTOS COM 2 DÍGITOS) 
	       , ESTE CAMPO NÃO É OBRIGATÓRIO NA MÁSCARA E DEVE POSSUIR VALORES ENTRE 0 E 59. Valor padrão 0(zero) se não informado.
	SEGUNDO: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'SS'(SEGUNDOS COM 2 DÍGITOS) 
	       , ESTE CAMPO NÃO É OBRIGATÓRIO NA MÁSCARA E DEVE POSSUIR VALORES ENTRE 0 E 59. Valor padrão 0(zero) se não informado. */

/* **** OBSERVAÇÃO: CASO O PARÂMETRO P_VALUE SEJA VAZIO, A DATA RETORNADA É 31/12/1900 00:00:00 */

create or replace PROCEDURE SP_STRTODATE(p_value IN VARCHAR2,p_mask IN VARCHAR2,p_return OUT DATE) is
  l_day VARCHAR2(2);
  l_month VARCHAR2(2);
  l_year VARCHAR2(4);
  l_hour VARCHAR2(2);
  l_minute VARCHAR2(2);
  l_second VARCHAR2(2);
  l_mask VARCHAR2(30);
  l_pos NUMBER(2);
  l_count NUMBER(2);
  l_validate NUMBER(2);
begin

  /*VALIDA SE A DATA PASSADA NÃO ESTÁ ZERADA*/
  IF (p_value = '') OR (p_value IS NULL) THEN        
    p_return := TO_DATE('31/12/1900', 'DD/MM/YYYY');
    GOTO DATA_VAZIA; 
  END IF;

  /*VALIDA O TAMANHO DA MÁSCARA INFORMADA*/
  if ( LENGTH(p_value) <> LENGTH(p_mask) ) then
    raise_application_error(-20000 + -(103),'SP_STRTODATE: Tamanho da máscara incompatível com literal informado.');
  end if;
  l_pos := 0;
  l_count := 0;
  l_hour := '00';
  l_minute := '00';
  l_second := '00';
  l_mask := UPPER(p_mask);
  
  /*YEAR*/
  l_count := 4;
   /*AAAA*/
  l_pos   := InStr(l_mask, 'AAAA');
  if (l_pos=0) then
    /*AA*/
    l_count := 2;
	l_pos   := InStr(l_mask, 'AA');
    if (l_pos=0) then
      raise_application_error(-20000 + -(103),'SP_STRTODATE: Ano deve ser informado na máscara para conversão.');
    else
      begin
        l_validate := TO_NUMBER( SUBSTR(p_value,l_pos,l_count) );
      exception
        when OTHERS then
          raise_application_error(-20000 + -(103),'SP_STRTODATE: Erro ao converter Ano - AA: '|| SQLERRM);
      end;	  
      if (l_validate>=0) 
      AND (l_validate<=50) then
        l_year := '20'||SUBSTR(p_value,l_pos,l_count);
      else
        l_year := '19'||SUBSTR(p_value,l_pos,l_count);
      end if;
    end if;
  else
    l_year := SUBSTR(p_value,l_pos,l_count);
  end if;
  /*END YEAR*/
  
  /*DAY*/
  l_count := 2;
  l_pos   := InStr(l_mask, 'DD');
  if (l_pos=0) then
    raise_application_error(-20000 + -(103),'SP_STRTODATE: Dia deve ser informado na máscara para conversão.');
  else
    l_day := SUBSTR(p_value,l_pos,l_count);
  end if;
  /*END DAY*/
  
  /*MONTH*/
  l_count := 2;
  l_pos   := InStr(l_mask, 'MM');
  if (l_pos=0) then
    raise_application_error(-20000 + -(103),'SP_STRTODATE: Mês deve ser informado na máscara para conversão.');
  else
    l_validate := TO_NUMBER( SUBSTR(p_value,l_pos,l_count) );
    if (l_validate>=1) 
      AND (l_validate<=12) then
      l_month := SUBSTR(p_value,l_pos,l_count);
    else
      raise_application_error(-20000 + -(103),'SP_STRTODATE: Mês deve estar entre 01 e 12.');
    end if;
  end if;
  /*END MONTH*/
  
  /*HOUR*/
  l_count := 2;
  l_pos   := InStr(l_mask, 'HH');
  if (l_pos<>0) then
    l_validate := TO_NUMBER( SUBSTR(p_value,l_pos,l_count) );
    if (l_validate>=0) 
      AND (l_validate<=23) then
      l_hour := SUBSTR(p_value,l_pos,l_count);
    else
      raise_application_error(-20000 + -(103),'SP_STRTODATE: Hora deve estar entre 0 e 23.');
    end if;
  end if;
  /*END HOUR*/
  
  /*MINUTES*/
  l_count := 2;
  l_pos   := InStr(l_mask, 'MI');
  if (l_pos<>0) then
    l_validate := TO_NUMBER( SUBSTR(p_value,l_pos,l_count) );
    if (l_validate>=0) 
      AND (l_validate<=59) then
      l_minute := SUBSTR(p_value,l_pos,l_count);
    else
      raise_application_error(-20000 + -(103),'SP_STRTODATE: Minuto deve estar entre 0 e 59.');
    end if;
  end if;
  /*END MINUTES*/
  
  /*SECOND*/
  l_count := 2;
  l_pos   := InStr(l_mask, 'SS');
  if (l_pos<>0) then
    l_validate := TO_NUMBER( SUBSTR(p_value,l_pos,l_count) );
    if (l_validate>=0) 
      AND (l_validate<=59) then
      l_second := SUBSTR(p_value,l_pos,l_count);
    else
      raise_application_error(-20000 + -(103),'SP_STRTODATE: Segundo deve estar entre 0 e 59.');
    end if;
  end if;
  /*END SECOND*/
  
  /*EFETUA A CONVERSÃO*/
  BEGIN
    p_return := TO_DATE(l_day||'/'||l_month||'/'||l_year||' '||l_hour||':'||l_minute||':'||l_second, 'DD/MM/YYYY HH24:MI:SS');
  EXCEPTION
    when OTHERS then
      raise_application_error(-20000 + -(103),'SP_STRTODATE: Erro ao converter data: '|| SQLERRM);
  END;

  <<DATA_VAZIA>>
    NULL;
end;

	MSSQL;21
†␀␀/*
 OBJETIVO: PROCEDURE CRIADA PARA REALIZAR A CONVERSÃO DE UMA DATA EM CARACTERES PARA O TIPO DATA(DATE), ATRAVÉS DE UMA MÁSCARA INFORMADA
DEFINIÇÃO: ESTA PROCEDURE SUPORTA MÁSCARA COM DIA, MÊS, ANO, HORA, MINUTO E SEGUNDO EM QUALQUER FORMATO DEFINIDO NA MÁSCARA/VALOR.	
	    DIA: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'DD'(DIA COM 2 DÍGITOS), ESTE CAMPO É OBRIGATÓRIO NA MÁSCARA.
	    MÊS: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'MM'(MÊS COM 2 DÍGITOS), ESTE CAMPO É OBRIGATÓRIO NA MÁSCARA E DEVE POSSUIR VALORES ENTRE 1 E 12.
	    ANO: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'AA'(ANO COM 2 DÍGITOS) OU 'AAAA'(ANO COM 4 DÍGITOS/MILÊNIO), ESTE CAMPO É OBRIGATÓRIO NA MÁSCARA. */
/*	   HORA: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'HH'(HORA COM 2 DÍGITOS NO FORMATO HH24) 
	       , ESTE CAMPO NÃO É OBRIGATÓRIO NA MÁSCARA E DEVE POSSUIR VALORES ENTRE 0 E 23. Valor padrão 0(zero) se não informado.
	 MINUTO: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'MI'(MINUTOS COM 2 DÍGITOS) 
	       , ESTE CAMPO NÃO É OBRIGATÓRIO NA MÁSCARA E DEVE POSSUIR VALORES ENTRE 0 E 59. Valor padrão 0(zero) se não informado.
	SEGUNDO: É DEFINIDO NA MÁSCARA ATRAVÉS DOS IDENTIFICADORES 'SS'(SEGUNDOS COM 2 DÍGITOS) 
	       , ESTE CAMPO NÃO É OBRIGATÓRIO NA MÁSCARA E DEVE POSSUIR VALORES ENTRE 0 E 59. Valor padrão 0(zero) se não informado. */

/* **** OBSERVAÇÃO: CASO O PARÂMETRO P_VALUE SEJA VAZIO, A DATA RETORNADA É 31/12/1900 00:00:00 */

CREATE  PROCEDURE sp_strtodate(@p_value VARCHAR(255), @p_mask VARCHAR(255), @p_return DATETIME OUTPUT) AS
BEGIN
DECLARE @l_day VARCHAR(2)
DECLARE @l_month VARCHAR(2)
DECLARE @l_year VARCHAR(4)
DECLARE @l_hour VARCHAR(2)
DECLARE @l_minute VARCHAR(2)
DECLARE @l_second VARCHAR(2)
DECLARE @l_mask VARCHAR(30)
DECLARE @l_pos SMALLINT
DECLARE @l_count SMALLINT
DECLARE @l_validate SMALLINT
DECLARE @ChkError INTEGER
DECLARE @SE_EXC1 INTEGER
DECLARE @NULL_VAR INTEGER
DECLARE @SE_EXC2 INTEGER

  /*VALIDA SE A DATA PASSADA NÃO ESTÁ ZERADA*/
  IF (@p_value = '') OR (@p_value IS NULL)
  BEGIN
    SELECT @p_return = CONVERT(DATETIME, '31/12/1900 00:00:00', 103)
    SELECT @ChkError = 0
    GOTO DATA_VAZIA 
  END 	

  /*VALIDA O TAMANHO DA MÁSCARA INFORMADA*/
  IF (DATALENGTH(@p_value) <> DATALENGTH(@p_mask))
  BEGIN
	RAISERROR('SP_STRTODATE: Tamanho da máscara incompatível com literal informado.',11,1) WITH SETERROR
    SELECT @ChkError = -30
    GOTO FIM
  END
  
  SELECT @ChkError = 0
  SELECT @l_pos = 0
  SELECT @l_count = 0
  SELECT @l_hour = '00'
  SELECT @l_minute = '00'
  SELECT @l_second = '00'
  SELECT @l_mask = UPPER(@p_mask)
  
  /*YEAR*/
  SELECT @l_count = 4
  SELECT @l_pos = CHARINDEX('AAAA', @l_mask)
  IF (@l_pos=0)
  BEGIN
    SELECT @l_count = 2
	SELECT @l_pos = CHARINDEX('AA', @l_mask)
    IF (@l_pos=0)
    BEGIN
      BEGIN
        RAISERROR('SP_STRTODATE: Ano deve ser informado na máscara para conversão.',11,1) WITH SETERROR
        SELECT @ChkError = -30
        GOTO FIM
      END
    END
    ELSE
    BEGIN
      /* TRY */
        SELECT @l_validate = CONVERT(NUMERIC,SUBSTRING(@p_value,@l_pos,@l_count))
      /* END TRY */
      /* BEGIN EXCEPTION HANDLER */
        EXC1:
        SELECT @SE_EXC1 = @ChkError
        IF @ChkError <> 0
        BEGIN
          BEGIN
            SELECT @ChkError = 0
            BEGIN
              RAISERROR('SP_STRTODATE: Erro ao converter Ano - AA.',11,1) WITH SETERROR
              SELECT @ChkError = -30
              GOTO FIM
            END
          END
        END
      /* END EXCEPTION HANDLER */
      IF (@l_validate>=0) 
      AND (@l_validate<=50)
      BEGIN
        SELECT @l_year = '20'+SUBSTRING(@p_value,@l_pos,@l_count)
      END
      ELSE
      BEGIN
        SELECT @l_year = '19'+SUBSTRING(@p_value,@l_pos,@l_count)
      END
    END
  END
  ELSE
  BEGIN
    SELECT @l_year = SUBSTRING(@p_value,@l_pos,@l_count)
  END
  /*END YEAR*/
  
  /*DAY*/
  SELECT @l_pos = 0
  SELECT @l_count = 2
  SELECT @l_pos = CHARINDEX('DD', @l_mask)
  IF (@l_pos=0)
  BEGIN
    BEGIN
      RAISERROR('SP_STRTODATE: Dia deve ser informado na máscara para conversão.',11,1) WITH SETERROR
      SELECT @ChkError = -30
      GOTO FIM
    END
  END
  ELSE
  BEGIN
    SELECT @l_day = SUBSTRING(@p_value,@l_pos,@l_count)
  END
  /*END DAY*/
  
  /*MONTH*/
  SELECT @l_count = 2
  SELECT @l_pos = CHARINDEX('MM', @l_mask)
  IF (@l_pos=0)
  BEGIN
    BEGIN
      RAISERROR('SP_STRTODATE: Mês deve ser informado na máscara para conversão.',11,1) WITH SETERROR
      SELECT @ChkError = -30
      GOTO FIM
    END
  END
  ELSE
  BEGIN
	SELECT @l_validate = CONVERT(NUMERIC,SUBSTRING(@p_value,@l_pos,@l_count))
	IF (@l_validate>=1) 
     AND (@l_validate<=12)
	BEGIN
		SELECT @l_month = SUBSTRING(@p_value,@l_pos,@l_count)
	END
	ELSE
	BEGIN
		RAISERROR('SP_STRTODATE: Mês deve estar entre 01 e 12.',11,1) WITH SETERROR
		SELECT @ChkError = -30
		GOTO FIM
	END    
  END
  /*END MONTH*/
  
  /*HOUR*/
  SELECT @l_count = 2
  SELECT @l_pos = CHARINDEX('HH', @l_mask)
  IF (@l_pos<>0)
  BEGIN
    SELECT @l_validate = CONVERT(NUMERIC,SUBSTRING(@p_value,@l_pos,@l_count))
    IF (@l_validate>=0) 
      AND (@l_validate<=23)
    BEGIN
      SELECT @l_hour = SUBSTRING(@p_value,@l_pos,@l_count)
    END
    ELSE
    BEGIN
      BEGIN
        RAISERROR('SP_STRTODATE: Hora deve estar entre 0 e 23.',11,1) WITH SETERROR
        SELECT @ChkError = -30
        GOTO FIM
      END
    END
  END
  /*END HOUR*/
  
  /*MINUTES*/
  SELECT @l_count = 2
  SELECT @l_pos = CHARINDEX('MI', @l_mask)
  IF (@l_pos<>0)
  BEGIN
    SELECT @l_validate = CONVERT(NUMERIC,SUBSTRING(@p_value,@l_pos,@l_count))
    IF (@l_validate>=0) 
      AND (@l_validate<=59)
    BEGIN
      SELECT @l_minute = SUBSTRING(@p_value,@l_pos,@l_count)
    END
    ELSE
    BEGIN
      BEGIN
        RAISERROR('SP_STRTODATE: Minuto deve estar entre 0 e 59.',11,1) WITH SETERROR
        SELECT @ChkError = -30
        GOTO FIM
      END
    END
  END
  /*END MINUTES*/
  
  /*SECOND*/
  SELECT @l_count = 2
  SELECT @l_pos = CHARINDEX('SS', @l_mask)
  IF (@l_pos<>0)
  BEGIN
    SELECT @l_validate = CONVERT(NUMERIC,SUBSTRING(@p_value,@l_pos,@l_count))
    IF (@l_validate>=0) 
      AND (@l_validate<=59)
    BEGIN
      SELECT @l_second = SUBSTRING(@p_value,@l_pos,@l_count)
    END
    ELSE
    BEGIN
      BEGIN
        RAISERROR('SP_STRTODATE: Segundo deve estar entre 0 e 59.',11,1) WITH SETERROR
        SELECT @ChkError = -30
        GOTO FIM
      END
    END
  END
  /*END SECOND*/
  
  /*EFETUA A CONVERSÃO*/
  /* TRY */
    SELECT @p_return = CONVERT(DATETIME, @l_day+'/'+@l_month+'/'+@l_year+' '+@l_hour+':'+@l_minute+':'+@l_second, 103)
  /* END TRY */
  /* BEGIN EXCEPTION HANDLER */
    EXC2:
    SELECT @SE_EXC2 = @ChkError
    IF @ChkError <> 0
    BEGIN
      BEGIN
        SELECT @ChkError = 0
        BEGIN
          RAISERROR('SP_STRTODATE: Erro ao converter data.',11,1) WITH SETERROR
          SELECT @ChkError = -30
          GOTO FIM
        END
      END
    END
  /* END EXCEPTION HANDLER */
DATA_VAZIA:
  
FIM:
  RETURN @ChkError
END

