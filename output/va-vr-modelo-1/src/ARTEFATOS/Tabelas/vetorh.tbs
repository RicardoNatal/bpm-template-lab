/* Exclusao */
TRIGGER R060DAP_ED AFTER DELETE ON R060DAP FOR EACH ROW

DECLARE
l_count        NUMBER;

BEGIN
  BEGIN
    SELECT COUNT(*) INTO l_count FROM R030EMP WHERE CODDAP= :OLD.CODDAP;
    IF l_count > 0 THEN
      RAISERROR 103 'Erro de Exclusão na tabela de Definições de Apuração. Registro esta sendo Referenciado pela Tabela R030EMP.';
    END IF;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro de Exclusão na tabela de Definições de Apuração. Registro esta sendo Referenciado pela Tabela R030EMP.';
