TRIGGER R304TCA_SI AFTER INSERT ON R304TCA
DECLARE
	CURSOR c_R304TCA IS
	SELECT NUMEMP, NUMATO, DATATO, NUMMAT, NUMCPF, CODUNI, ORGTEM, DATITP, SEQREG
	  FROM R304TCA
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304TCA IS RECORD (
		NUMEMP   R304TCA.NUMEMP%TYPE,
		NUMATO   R304TCA.NUMATO%TYPE,
		DATATO   R304TCA.DATATO%TYPE,
		NUMMAT   R304TCA.NUMMAT%TYPE,
		NUMCPF   R304TCA.NUMCPF%TYPE,
		CODUNI   R304TCA.CODUNI%TYPE,
		ORGTEM   R304TCA.ORGTEM%TYPE,
		DATITP   R304TCA.DATITP%TYPE,
		SEQREG   R304TCA.SeqReg%TYPE
	);
    
    l_R304TCA t_R304TCA;
    l_PidSta VARCHAR2(30);
    l_MsgErr VARCHAR2(255);
BEGIN
	FOREACH c_R304TCA INTO l_R304TCA.NumEmp, l_R304TCA.NUMATO, l_R304TCA.DATATO, l_R304TCA.NUMMAT, l_R304TCA.NUMCPF, l_R304TCA.CODUNI, l_R304TCA.ORGTEM, l_R304TCA.DATITP, l_R304TCA.SeqReg
	LOOP
		/* Busca PID gravado no registro do Concurso/Processo Seletivo */
		BEGIN
			SELECT CAP.PIDSTA INTO l_PidSta
			  FROM R304CAP CAP, R304STA STA
			 WHERE CAP.PIDSTA = STA.PIDSTA
			   AND CAP.NUMEMP = l_R304TCA.NumEmp
			   AND CAP.NUMATO = l_R304TCA.NUMATO
			   AND CAP.DATATO = l_R304TCA.DATATO
			   AND CAP.NUMMAT = l_R304TCA.NUMMAT
			   AND CAP.NUMCPF = l_R304TCA.NUMCPF
			   AND CAP.CODUNI = l_R304TCA.CODUNI
			   AND CAP.SeqReg = l_R304TCA.SeqReg
			   AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_MsgErr := 'Não existe registro de concessão de aposentadoria pendente com as seguintes chaves: ' ||
					'Empresa: ' || CONVERT(NUMBER_TO_CHAR, l_R304TCA.NumEmp) || ', Ato: ' || l_R304TCA.NUMATO|| ', Data Ato: ' || CONVERT(DATE_TO_CHAR,l_R304TCA.DATATO)
					|| ', Número Matrícula: ' || l_R304TCA.NUMMAT ||', CPF: ' || CONVERT(NUMBER_TO_CHAR, l_R304TCA.NUMCPF) ||', Cod Unidade: ' || CONVERT(NUMBER_TO_CHAR, l_R304TCA.CODUNI) || '.';						
				RAISERROR 103 l_MsgErr;
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304CAP.';
		END;
		
		BEGIN
			UPDATE R304TCA
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304TCA.NumEmp
			   AND NUMATO = l_R304TCA.NUMATO
			   AND DATATO = l_R304TCA.DATATO
			   AND NUMMAT = l_R304TCA.NUMMAT
			   AND NUMCPF = l_R304TCA.NUMCPF
			   AND CODUNI = l_R304TCA.CODUNI
			   AND ORGTEM = l_R304TCA.ORGTEM
			   AND DATITP = l_R304TCA.DATITP
			   AND SEQREG = l_R304TCA.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304TCA,.';
		END;
	END LOOP;
END␀ïå␀␀		SENIOR;0%␀␀TRIGGER R304TCA_EI BEFORE INSERT ON R304TCA FOR EACH ROW
DECLARE
	l_SeqReg   R304TCA.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Verifica se está tentando incluir um registro com sequência maior do que a última já cadastrada */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304TCA
		 WHERE NUMEMP = :NEW.NumEmp
		   AND NUMATO = :NEW.NUMATO
		   AND DATATO = :NEW.DATATO
		   AND NUMMAT = :NEW.NUMMAT
		   AND NUMCPF = :NEW.NUMCPF
		   AND CODUNI = :NEW.CODUNI
		   AND ORGTEM = :NEW.ORGTEM
		   AND DATITP = :NEW.DATITP
		   AND SEQREG <> :NEW.SeqReg;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304TCA.';
	END;
	
	IF (l_SeqReg > 0) THEN
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀ğå␀␀		SENIOR;0ª␀␀

TRIGGER R304TCA_EU BEFORE UPDATE ON R304TCA FOR EACH ROW
DECLARE
	l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
	/* Somente permite alterar caso status do envio seja P - Pendente Envio e R - Erro Envio */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados/excluídos.';
	END IF;
END␀␀␀K*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀òå␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀[¬␀␀	Ôÿ?␀␀␀␀␀¯±␀␀3¯␀␀±␀␀%␀␀ÿ␀␀ÿ␀}DÑ␀	Ôÿ?␀␀␀␀␀^M!FğLqC␀êÿ␀␀ÿ␀ª¬␀␀	Ôÿ?␀␀␀␀␀R°␀␀H¯␀␀°␀␀%␀␀ÿ␀␀ÿ␀s¬␀␀␀	Ôÿ?␀␀␀␀␀¥?c°␀␀c°␀␀Q␀Æÿ␀␀ÿ␀Ö-¦␀	Ôÿ?␀␀␀␀␀-?:5>j␀Æÿ␀␀ÿ␀şµ␀␀'	Ôÿ?␀␀␀␀␀P·␀␀îµ␀␀=·␀␀q␀Æÿ␀␀ÿ␀!EÑ␀	Ôÿ?␀␀␀␀␀`L,_HKqC␀êÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀îDÑ␀Ôÿ?␀␀␀␀␀şK$_îJqC␀␀êÿ␀␀ÿ␀‚¬␀␀cÔÿ?␀␀␀␀␀Ã±␀␀\±␀␀\±␀␀`␀␀␀ÿ␀␀ÿ␀Â¬␀␀cÔÿ?␀␀␀␀␀V°␀␀G¬␀␀3°␀␀`␀␀␀ÿ␀␀ÿ␀›␀␀=Ôÿ?␀␀␀␀␀¤␀␀"␀␀H␀␀c␀␀␀␀ÿ␀␀ÿ␀ôÉ␀␀¦␀Ôÿ?␀␀␀␀␀œÌ␀␀#Ì␀␀#Ì␀␀j␀Æÿ␀␀ÿ␀5Â␀␀EÔÿ?␀␀␀␀␀-Â␀␀,Â␀␀,Â␀␀G␀␀␀ÿ␀␀ÿ␀␀␀óå␀␀␀␀0;1;2;3;4;5;6;7;8öå␀␀	SENIOR;0Ï␀␀

TRIGGER R304TCP_SI AFTER INSERT ON R304TCP
DECLARE
	CURSOR c_R304TCP IS
	SELECT NUMEMP, NUMATO, DATATO, NUMMAT, NUMCPF, CODUNI, ORGTEM, DATITP, SEQREG
	  FROM R304TCP
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304TCP IS RECORD (
		NUMEMP   R304TCP.NumEmp%TYPE,
		NUMATO   R304TCP.NUMATO%TYPE,
		DATATO   R304TCP.DATATO%TYPE,
		NUMMAT   R304TCP.NUMMAT%TYPE,
		NUMCPF   R304TCP.NUMCPF%TYPE,
		CODUNI   R304TCP.CODUNI%TYPE,
		ORGTEM   R304TCP.ORGTEM%TYPE,
		DATITP   R304TCP.DATITP%TYPE,
		SEQREG   R304TCP.SEQREG%TYPE
	);
    
    l_R304TCP t_R304TCP;
    l_PidSta VARCHAR2(30);
    l_MsgErr VARCHAR2(255);
BEGIN
	FOREACH c_R304TCP INTO l_R304TCP.NumEmp, l_R304TCP.NUMATO, l_R304TCP.DATATO, l_R304TCP.NUMMAT, l_R304TCP.NUMCPF, l_R304TCP.CODUNI, l_R304TCP.ORGTEM, l_R304TCP.DATITP, l_R304TCP.SEQREG
	LOOP
		/* Busca PID gravado no registro do Concurso/Processo Seletivo */
		BEGIN
			SELECT CPE.PIDSTA INTO l_PidSta
			  FROM R304CPE CPE, R304STA STA
			 WHERE CPE.PIDSTA = STA.PIDSTA
			   AND CPE.NUMEMP = l_R304TCP.NumEmp
			   AND CPE.NUMATO = l_R304TCP.NUMATO
			   AND CPE.DATATO = l_R304TCP.DATATO
			   AND CPE.NUMMAT = l_R304TCP.NUMMAT
			   AND CPE.NUMCPF = l_R304TCP.NUMCPF
			   AND CPE.CODUNI = l_R304TCP.CODUNI
			   AND (STA.STAENV = 'P' OR STA.STAENV = 'R');
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_MsgErr := 'Não existe registro de concessão pensão pendente com as seguintes chaves: ' ||
					'Empresa: ' || CONVERT(NUMBER_TO_CHAR, l_R304TCP.NumEmp) || ', Ato: ' || l_R304TCP.NUMATO || '.';
				RAISERROR 103 l_MsgErr;
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao buscar informação do campo PIDSTA da tabela R304TCP.';
		END;
		
		BEGIN
			UPDATE R304TCP
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304TCP.NumEmp
			   AND NUMATO = l_R304TCP.NUMATO
			   AND DATATO = l_R304TCP.DATATO
			   AND NUMMAT = l_R304TCP.NUMMAT
			   AND NUMCPF = l_R304TCP.NUMCPF
			   AND CODUNI = l_R304TCP.CODUNI
			   AND NUMCPF = l_R304TCP.NUMCPF
			   AND CODUNI = l_R304TCP.CODUNI
			   AND ORGTEM = l_R304TCP.ORGTEM
			   AND DATITP = l_R304TCP.DATITP
			   AND SEQREG = l_R304TCP.SEQREG;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304TCP.';
		END;
	END LOOP;
END␀ôå␀␀		SENIOR;0%␀␀TRIGGER R304TCP_EI BEFORE INSERT ON R304TCP FOR EACH ROW
DECLARE
	l_SeqReg   R304TCP.SeqReg%TYPE;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Verifica se está tentando incluir um registro com sequência maior do que a última já cadastrada */
	BEGIN
		SELECT MAX(SEQREG) INTO l_SeqReg
		  FROM R304TCP
		 WHERE NUMEMP = :NEW.NumEmp
		   AND NUMATO = :NEW.NUMATO
		   AND DATATO = :NEW.DATATO
		   AND NUMMAT = :NEW.NUMMAT
		   AND NUMCPF = :NEW.NUMCPF
		   AND CODUNI = :NEW.CODUNI
		   AND ORGTEM = :NEW.ORGTEM
		   AND DATITP = :NEW.DATITP
		   AND SEQREG <> :NEW.SeqReg;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304TCP.';
	END;
	
	IF (l_SeqReg > 0) THEN
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀õå␀␀		SENIOR;0ª␀␀

TRIGGER R304TCP_EU BEFORE UPDATE ON R304TCP FOR EACH ROW
DECLARE
	l_StaEnv   R304STA.StaEnv%TYPE;
BEGIN
	/* Somente permite alterar caso status do envio seja P - Pendente Envio e R - Erro Envio */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro Envio podem ser alterados/excluídos.';
	END IF;
