 TRIGGER R070HCH_SU AFTER UPDATE ON R070HCH

DECLARE
l_tipope          CHAR;
l_tippes_str      CHAR(2);
l_numemp          CHAR(4);
l_numcad          CHAR(10);
l_idtpes          VARCHAR2(23);
  
/* CURSOR c/ os registros gravados no R070HCH_AUX */
  CURSOR c_R070HCH_upd IS SELECT TIPOPE,NUMEMP,TIPCRA,NUMCAD,NUMCRA,CRAOLD,DATINI,HORINI,DATFIM,HORFIM,STAATU,STAACC FROM R070HCH_AUX;
  TYPE t_R070HCH_aux IS RECORD(
    TIPOPE   R070HCH_AUX.TipOpe%TYPE,
    NUMEMP   R070HCH_AUX.NumEmp%TYPE,
    TIPCRA   R070HCH_AUX.TipCra%TYPE,
    NUMCAD   R070HCH_AUX.NumCad%TYPE,
    NUMCRA   R070HCH_AUX.NumCra%TYPE,
    CRAOLD   R070HCH_AUX.CraOld%TYPE,
    DATINI   R070HCH_AUX.DatIni%TYPE,
    HORINI   R070HCH_AUX.HorIni%TYPE,
    DATFIM   R070HCH_AUX.DatFim%TYPE,
    HORFIM   R070HCH_AUX.HorFim%TYPE,
    STAATU   R070HCH_AUX.STAATU%TYPE,
    STAACC   R070HCH_AUX.STAACC%TYPE);

  l_R070HCH_aux t_R070HCH_aux;

  BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_R070HCH_upd INTO  l_R070HCH_aux.TipOpe,
                               l_R070HCH_aux.NumEmp,
                               l_R070HCH_aux.TipCra,
                               l_R070HCH_aux.NumCad,
                               l_R070HCH_aux.NumCra,
                               l_R070HCH_aux.CraOld,
                               l_R070HCH_aux.DatIni,
                               l_R070HCH_aux.HorIni,
                               l_R070HCH_aux.DatFim,
                               l_R070HCH_aux.HorFim,
                               l_R070HCH_aux.STAATU,
                               l_R070HCH_aux.STAACC
  LOOP
     /* consiste sobreposicaode crachás */
     R070HCH_VSOB('U',l_R070HCH_aux.TipCra, l_R070HCH_aux.NumEmp, l_R070HCH_aux.NumCad,
                       l_R070HCH_aux.NumCra,l_R070HCH_aux.DatIni, l_R070HCH_aux.HorIni,
                       l_R070HCH_aux.DatFim,l_R070HCH_aux.HorFim);

     IF  (l_R070HCH_aux.TIPOPE = 1) OR (l_R070HCH_aux.TIPOPE = 3) THEN
         IF (l_R070HCH_aux.TIPOPE = 3) THEN
             l_tipope := 'A';
         ELSE
             l_tipope := 'U';
         END IF;

         SP_ColCon (l_tipope, l_R070HCH_aux.TIPCRA,
                         l_R070HCH_aux.NUMEMP,5,
                         l_R070HCH_aux.NUMCAD,0,'0','0',
                         l_R070HCH_aux.DATINI,
                         l_R070HCH_aux.HORINI,
                         l_R070HCH_aux.NUMCRA,
                         l_R070HCH_aux.DATFIM,
                         l_R070HCH_aux.HORFIM,
                         l_R070HCH_aux.CRAOLD,
                         l_R070HCH_aux.STAACC,1,1);
          /*********** Iniciar montar o IDTPES *****************************/
          SP_INTSTR(5,'99',l_tippes_str OUT);
          SP_INTSTR(l_R070HCH_aux.NUMEMP,'9999',l_numemp OUT);
          SP_INTSTR(l_R070HCH_aux.NUMCAD,'999999999',l_numcad OUT);
          l_idtpes:= l_tippes_str||l_numemp||l_numcad;
            /*Preenche o campo com espaços para completar 23 posições*/
          l_idtpes := lTrim(l_idtpes);
          l_idtpes := rTrim(l_idtpes);
          LOOP
              /*Controle do Loop.*/
              IF (Length(l_idtpes) > 22) THEN
                  EXIT;
              END IF;
              l_idtpes := ' '||l_idtpes;
          END LOOP;
          /*********** termina de montar o IDTPES *****************************/
          SP_ATUPRMLOC (l_idtpes, 0);
     END IF;
  END LOOP;
 /* Apaga Registro OLD/NEW em R070HCH_AUX */
  BEGIN
    DELETE FROM R070HCH_AUX;
    DROP_TEMP_TABLE R070HCH_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀Ú␀␀		SENIOR;0A␀␀

TRIGGER R070HCH_EU AFTER UPDATE ON R070HCH FOR EACH ROW

DECLARE
  l_data_zero       DATE;
  l_data_atual      DATE;
  l_hora_atual      NUMBER(4);
  l_numcra          NUMBER(12);
  l_tipope          NUMBER(1);
  l_online          BOOLEAN; 

  /* Tabela temporária */
  CREATE_TEMP_TABLE R070HCH_AUX;
  
BEGIN
  /* Inicializa */
  SP_VerOnLine(l_online OUT);
  l_tipope := 0;
  IF   (l_online = TRUE) THEN
       l_data_zero  := '31/12/1900,00:00:00';
       l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
       l_data_atual := CURDATE();
       /* Valida Cracha/Datas */
       IF   (:NEW.NUMCRA > 0)  THEN
            IF    ((:OLD.STAATU <> :NEW.STAATU) OR (:OLD.STAACC <> :NEW.STAACC) OR
                  ((:NEW.NUMCRA <> :OLD.NUMCRA OR :NEW.DATFIM <> :OLD.DATFIM OR :NEW.HORFIM <> :OLD.HORFIM) AND
                  (((:NEW.DATINI < l_data_atual OR (:NEW.DATINI = l_data_atual AND :NEW.HORINI <= l_hora_atual)) AND
                    (:NEW.DATFIM = l_data_zero OR :NEW.DATFIM > l_data_atual OR (:NEW.DATFIM = l_data_atual AND :NEW.HORFIM >= l_hora_atual))) OR
                   ((:OLD.DATINI < l_data_atual OR (:OLD.DATINI = l_data_atual AND :OLD.HORINI <= l_hora_atual)) AND
                    (:OLD.DATFIM = l_data_zero OR :OLD.DATFIM > l_data_atual OR (:OLD.DATFIM = l_data_atual AND :OLD.HORFIM >= l_hora_atual)))))) THEN
                   l_tipope := 1;
            END IF;
       END IF;
       IF (:NEW.STAACC = 3) THEN
           l_tipope := 3;
       END IF;
  END IF;
  /* se esta voltando o status de 4 para 2 ou de 3 para 1 então não precisa atualizar nada e não gera o registro na auxiliar */
  IF (:OLD.STAACC < 3) THEN
      BEGIN
        INSERT INTO R070HCH_AUX (TIPOPE,TIPCRA,NUMEMP,NUMCAD,DATINI,HORINI,NUMCRA,CRAOLD,DATFIM,HORFIM,STAATU,STAACC)
        VALUES (l_tipope,:NEW.TIPCRA,:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATINI,:NEW.HORINI,:NEW.NUMCRA,:OLD.NUMCRA,:NEW.DATFIM,:NEW.HORFIM,:NEW.STAATU,:NEW.STAACC);
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'ON-Line: Erro no INSERT em R070HCH_AUX.';
      END;
  END IF;
END␀Ú␀␀	SENIOR;0\␀␀

TRIGGER R070HCH_SD AFTER DELETE ON R070HCH

DECLARE
l_data_zero    DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_numcra       NUMBER(12);
  l_datini       DATE;
  l_datant       DATE;
  l_count        NUMBER(5);
  l_horini       NUMBER(5);
  l_online       BOOLEAN;
  l_errstr       VARCHAR2(255);
  l_tippes_str      CHAR(2);
  l_numemp          CHAR(4);
  l_numcad          CHAR(10);
  l_idtpes          VARCHAR2(23);

/* CURSOR c/ os registros gravados no R070HCH_AUX */
  CURSOR c_R070HCH_del IS SELECT TIPOPE,NUMEMP,TIPCRA,NUMCAD,NUMCRA,CRAOLD,DATINI,HORINI,DATFIM,HORFIM,STAATU,STAACC FROM R070HCH_AUX;
  TYPE t_R070HCH_aux IS RECORD(
    TIPOPE   R070HCH_AUX.TipOpe%TYPE,
    NUMEMP   R070HCH_AUX.NumEmp%TYPE,
    TIPCRA   R070HCH_AUX.TipCra%TYPE,
    NUMCAD   R070HCH_AUX.NumCad%TYPE,
    NUMCRA   R070HCH_AUX.NumCra%TYPE,
    CRAOLD   R070HCH_AUX.CraOld%TYPE,
    DATINI   R070HCH_AUX.DatIni%TYPE,
    HORINI   R070HCH_AUX.HorIni%TYPE,
    DATFIM   R070HCH_AUX.DatFim%TYPE,
    HORFIM   R070HCH_AUX.HorFim%TYPE,
    STAATU   R070HCH_AUX.STAATU%TYPE,
    STAACC   R070HCH_AUX.STAACC%TYPE);

  l_R070HCH_aux t_R070HCH_aux;



BEGIN
  /* Inicializa */
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();
  SP_VerOnLine(l_online OUT);

  /* Le Registro do CURSOR */
  FOREACH c_R070HCH_del INTO  l_R070HCH_aux.TipOpe,
                              l_R070HCH_aux.NumEmp,
                              l_R070HCH_aux.TipCra,
                              l_R070HCH_aux.NumCad,
                              l_R070HCH_aux.NumCra,
                              l_R070HCH_aux.CraOld,
                              l_R070HCH_aux.DatIni,
                              l_R070HCH_aux.HorIni,
                              l_R070HCH_aux.DatFim,
                              l_R070HCH_aux.HorFim,
                              l_R070HCH_aux.STAATU,
                              l_R070HCH_aux.STAACC                              
  LOOP

     /* Atualiza Telematica */
     IF   (l_online = TRUE)
     AND  (l_r070hch_aux.NUMCRA > 0)
     AND  ((l_r070hch_aux.DATINI < l_data_atual OR (l_r070hch_aux.DATINI = l_data_atual AND l_r070hch_aux.HORINI <= l_hora_atual)) AND
           (l_r070hch_aux.DATFIM = l_data_zero OR l_r070hch_aux.DATFIM > l_data_atual OR (l_r070hch_aux.DATFIM = l_data_atual AND l_r070hch_aux.HORFIM >= l_hora_atual))) THEN
         SP_ColCon ('D', l_R070HCH_aux.TIPCRA,
                         l_R070HCH_aux.NUMEMP,5,
                         l_R070HCH_aux.NUMCAD,0,'0','0',
                         l_R070HCH_aux.DATINI,
                         l_R070HCH_aux.HORINI,
                         l_R070HCH_aux.NUMCRA,
                         l_R070HCH_aux.DATFIM,
                         l_R070HCH_aux.HORFIM, 0,
                         l_R070HCH_aux.STAACC, 1,1);
         /*********** Iniciar montar o IDTPES *****************************/
         SP_INTSTR(5,'99',l_tippes_str OUT);
         SP_INTSTR(l_R070HCH_aux.NUMEMP,'9999',l_numemp OUT);
         SP_INTSTR(l_R070HCH_aux.NUMCAD,'999999999',l_numcad OUT);
         l_idtpes:= l_tippes_str||l_numemp||l_numcad;
           /*Preenche o campo com espaços para completar 23 posições*/
         l_idtpes := lTrim(l_idtpes);
         l_idtpes := rTrim(l_idtpes);
         LOOP
             /*Controle do Loop.*/
             IF (Length(l_idtpes) > 22) THEN
                 EXIT;
             END IF;
             l_idtpes := ' '||l_idtpes;
         END LOOP;
         /*********** termina de montar o IDTPES *****************************/
         SP_ATUPRMLOC (l_idtpes, 0);
     END IF;
  END LOOP;
 /* Apaga Registro OLD/NEW em R070HCH_AUX */
  BEGIN
    DELETE FROM R070HCH_AUX;
    DROP_TEMP_TABLE R070HCH_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ÿÙ␀␀		SENIOR;0ô␀␀

