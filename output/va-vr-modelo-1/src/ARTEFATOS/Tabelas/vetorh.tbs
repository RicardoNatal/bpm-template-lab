/* Quando exclui um histórico de um Curso Modular, zera os dados do histórico do curso Modular. */
TRIGGER R134CUR_SD AFTER DELETE ON R134CUR

DECLARE
CURSOR C_R134CUR_del IS SELECT CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD FROM R134CUR_AUX WHERE TIPOPE = 'E';

  TYPE t_r134CUR_aux IS RECORD(
      CODCUA   R134CUR_AUX.CODCUA%TYPE,
      TMACUA   R134CUR_AUX.TMACUA%TYPE,
      NUMEMP   R134CUR_AUX.NUMEMP%TYPE,
      TIPCOL   R134CUR_AUX.TIPCOL%TYPE,
      NUMCAD   R134CUR_AUX.NUMCAD%TYPE);

  l_r134CUR_aux t_r134CUR_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH C_R134CUR_del INTO  l_r134CUR_aux.CODCUA,
                              l_r134CUR_aux.TMACUA,
                              l_r134CUR_aux.NUMEMP,
                              l_r134CUR_aux.TIPCOL,
                              l_r134CUR_aux.NUMCAD
  LOOP
    TR_ZERTURMOD(l_r134CUR_aux.CODCUA, l_r134CUR_aux.TMACUA, l_r134CUR_aux.NUMEMP, l_r134CUR_aux.TIPCOL, l_r134CUR_aux.NUMCAD);
  END LOOP;

  BEGIN
    /* Limpar tabela auxiliar */
    DELETE FROM R134CUR_AUX;
    DROP_TEMP_TABLE R134CUR_AUX;
    EXCEPTION WHEN OTHERS THEN
	    RAISERROR 103 'Erro ao excluir registros da tabela R134CUR_AUX';
  END; 
END␀øá␀␀		SENIOR;0Ï␀␀/* Exclui o registro da R134CUR na AUX para processar o registro */
TRIGGER R134CUR_ED AFTER DELETE ON R134CUR FOR EACH ROW
DECLARE
  CREATE_TEMP_TABLE R134CUR_AUX;
BEGIN
  BEGIN
    INSERT INTO R134CUR_AUX(CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, TIPOPE)
                    VALUES (:OLD.CODCUA, :OLD.TMACUA, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, 'E');
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro no delete na R134CUR_AUX.';
  END;
END␀␀␀÷␀␀␀␀␀␀␀␀␀÷á␀␀Y,Ì␀„␀␀␀␀␀?@V9Y9{␀Æÿ␀␀ÿ␀â␀¼␀„␀␀␀␀␀,<Ì␀Ì␀v␀Æÿ␀␀ÿ␀…¬␀␀´␀„␀␀␀␀␀½<Xb±br␀Æÿ␀␀ÿ␀.␀t„␀␀␀␀␀é␀t␀ë␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀„␀␀␀␀␀7%€$®$w␀Æÿ␀␀ÿ␀à␀␀„␀␀␀␀␀!␀ ␀ ␀+␀␀ÿ␀␀ÿ␀␀␀␀␀␀	␀ø␀␀	␀␀␀␀␀␀úá␀␀Y,Ì␀	€␀␀␀␀␀␀8@V9V9{␀Æÿ␀␀xá␀␀␀¬DÑ␀	€␀␀␀␀␀␀␀MZ”␀␀Z”␀␀qC␀êÿ␀␀ıá␀␀␀áü␀␀­␀	€␀␀␀␀␀␀€ÿ␀␀ü␀␀xş␀␀p␀Æÿ␀␀şá␀␀␀´,¼␀	€␀␀␀␀␀␀‘@ìzu;v␀Æÿ␀␀êá␀␀␀␀␀␀0;1;2;3␀␀&␀␀␀␀␀ûá␀␀Y,Ì␀	€␀␀␀␀␀␀?@V9Y9{␀Æÿ␀␀xá␀␀␀¬DÑ␀	€␀␀␀␀␀␀␀MZ”␀␀Z”␀␀qC␀êÿ␀␀ıá␀␀␀áü␀␀­␀	€␀␀␀␀␀␀xş␀␀ü␀␀xş␀␀p␀Æÿ␀␀şá␀␀␀…¬␀␀´␀	€␀␀␀␀␀␀º<Xb¢br␀Æÿ␀␀Ò␀␀␀.␀t	€␀␀␀␀␀␀û␀¤␀¤␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	€␀␀␀␀␀␀T%t’␀␀¢$w␀Æÿ␀␀…Ó␀␀␀␀␀␀0;1;2;3;4;5␀␀&␀␀␀␀␀␀␀üá␀␀Y,Ì␀	€␀␀␀␀␀␀?@V9Y9{␀Æÿ␀␀xá␀␀␀¬DÑ␀	€␀␀␀␀␀␀␀MZ”␀␀Z”␀␀qC␀êÿ␀␀ıá␀␀␀áü␀␀­␀	€␀␀␀␀␀␀€ÿ␀␀ü␀␀xş␀␀p␀Æÿ␀␀şá␀␀␀åDÑ␀€␀␀␀␀␀␀…K6␀6␀qC␀êÿ␀␀ÿ␀ÂÉ␀␀±␀€␀␀␀␀␀␀Ì␀␀DÉ␀␀DÉ␀␀q␀Æÿ␀␀ÿ␀S␀¥€␀␀␀␀␀␀¯␀5␀5␀n␀Æÿ␀␀ÿ␀Ê	␀±␀€␀␀␀␀␀␀
␀µ_µ_q␀Æÿ␀␀ÿ␀X'‹␀€␀␀␀␀␀␀•'•'•'ï*␀␀Æÿ␀␀ÿ␀†Ê␀␀¼␀€␀␀␀␀␀␀rÌ␀␀ù␀ù␀v␀Æÿ␀␀ÿ␀;␀€␀␀␀␀␀␀␀␀␀n␀Æÿ␀␀ÿ␀”cU€␀␀␀␀␀␀ãc²c²cV␀␀ÿ␀␀ÿ␀–-´␀€␀␀␀␀␀␀î=’ù␀␀’ù␀␀r␀Æÿ␀␀‚â␀␀␀A,Á␀€␀␀␀␀␀␀e<o*o*/␀Æÿ␀␀Û␀␀␀,´␀€␀␀␀␀␀␀Ö?~~r␀Æÿ␀␀Û␀␀␀<,Ç␀€␀␀␀␀␀␀2"R)R)v␀Æÿ␀␀ÿ␀”,Ç␀€␀␀␀␀␀␀é<Ndbdz␀Æÿ␀␀ÖÒ␀␀␀â␀¼␀€␀␀␀␀␀␀.>Ì␀Ì␀v␀Æÿ␀␀â␀␀␀␀␀␀0;1;2␀␀&␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ÿá␀␀Y,Ì␀	€␀␀␀␀␀␀?@V9Y9{␀Æÿ␀␀xá␀␀␀¬DÑ␀	€␀␀␀␀␀␀␀MZ”␀␀Z”␀␀qC␀êÿ␀␀ıá␀␀␀áü␀␀­␀	€␀␀␀␀␀␀xş␀␀ü␀␀xş␀␀p␀Æÿ␀␀şá␀␀␀/-Ì␀	€␀␀␀␀␀␀Š=íÁ␀␀íÁ␀␀”)␀␀Æÿ␀␀Ó␀␀␀␀␀␀0;1;2;3␀␀&␀␀␀␀␀␀â␀␀Y,Ì␀	€␀␀␀␀␀␀?@V9Y9{␀Æÿ␀␀xá␀␀␀â␀¼␀	€␀␀␀␀␀␀,<Ì␀Ì␀v␀Æÿ␀␀â␀␀␀…¬␀␀´␀	€␀␀␀␀␀␀½<Xb±br␀Æÿ␀␀Ò␀␀␀.␀t	€␀␀␀␀␀␀é␀t␀ë␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	€␀␀␀␀␀␀7%€$®$w␀Æÿ␀␀…Ó␀␀␀t1=€␀␀␀␀␀␀`7_7`7c␀␀␀ÿ␀␀ÿ␀m)=€␀␀␀␀␀␀†))†)c␀␀␀ÿ␀␀ÿ␀İp=€␀␀␀␀␀␀îpápîpc␀␀␀ÿ␀␀ÿ␀Ş␀´␀€␀␀␀␀␀␀>½␀␀r␀Æÿ␀␀YĞ␀␀␀§¬␀␀Ì␀€␀␀␀␀␀␀Ôš␀␀€š␀␀€š␀␀m␀Æÿ␀␀aĞ␀␀␀:,€␀␀␀␀␀␀â:Ø!Ø!b␀␀␀ÿ␀␀)`␀EÑ␀€␀␀␀␀␀␀/N¦‘␀␀¦‘␀␀qC␀êÿ␀␀ÿ␀µEÑ␀€␀␀␀␀␀␀…N6␀ÉHqC␀êÿ␀␀ÿ␀Iš␀␀9€␀␀␀␀␀␀Ú™␀␀Ë™␀␀Ë™␀␀:␀␀ÿ␀␀ÿ␀£DÑ␀€␀␀␀␀␀␀ÏKD2D2qC␀êÿ␀␀ÿ
31/12/1900␀␀â␀␀␀␀	0;1;2;3;4â␀␀	SENIOR;0ÿ<␀␀

/* Atualiza a Turma do Participante na tabela de Reservas Efetuadas */
/* Inclui o Participante na tabela de Frequencias */
/* Grava Histórico de Curso para o participante */
TRIGGER R134DRE_SI AFTER INSERT ON R134DRE

DECLARE
l_nrohis       NUMBER(1);
  l_QtdNpc   NUMBER(1);
  l_SeqHcr         R124HCR.SEQHCR%TYPE;
  l_DatIni         R124HCR.PERINI%TYPE;
  l_DatFim         R124HCR.PERFIM%TYPE;
  l_CodOem         R124HCR.CODOEM%TYPE;
  l_SitCua         R124HCR.SITCUA%TYPE;
  l_CodMin         R124HCR.CODMIN%TYPE;
  l_CarHor         R124HCR.CARHOR%TYPE;
  l_MedCua         R124HCR.MEDCUA%TYPE;
  l_FreCua         R124HCR.FRECUA%TYPE;
  l_TipTre         R124HCR.TIPTRE%TYPE;
  l_QtdAul         R134DTU.QTDAUL%TYPE;
  l_TipCnf         R134DTU.TIPCNF%TYPE;
  l_QtdFal         R140NPC.QTDFAL%TYPE;
  l_HorFal         R140NPC.HORFAL%TYPE;
  l_TipCer         R140NPC.TIPCER%TYPE;
  l_SitAre         R140NPC.SITARE%TYPE;
  l_FasCua         R134DTU.FASCUA%TYPE;
  l_AvrWeb         R134DTU.AVRWEB%TYPE;
  xTipCua          R128CUA.TIPCUA%TYPE;
  xEmiCer          R128CUA.EMICER%TYPE;
  xConFre          R128CUA.CONFRE%TYPE;

  CURSOR C_R134DRE_ins IS SELECT CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, DATINS, DATTER
                            FROM R134DRE_AUX WHERE TIPOPE = 'I';

  TYPE t_r134dre_aux IS RECORD(
      CODCUA   R134DRE_AUX.CODCUA%TYPE,
      TMACUA   R134DRE_AUX.TMACUA%TYPE,
      NUMEMP   R134DRE_AUX.NUMEMP%TYPE,
      TIPCOL   R134DRE_AUX.TIPCOL%TYPE,
      NUMCAD   R134DRE_AUX.NUMCAD%TYPE,
      DATINS   R134DRE_AUX.DATINS%TYPE,
      DATTER   R134DRE_AUX.DATTER%TYPE);

  l_r134dre_aux t_r134dre_aux;

  CURSOR C_R124HCR_sel IS SELECT SEQHCR FROM R124HCR
                           WHERE NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL
                             AND NUMCAD = l_r134dre_aux.NUMCAD AND CODCUA = l_r134dre_aux.CODCUA
                        ORDER BY SEQHCR;

  TYPE t_r124hcr_aux IS RECORD(
      SEQHCR   R124HCR.SEQHCR%TYPE);

  l_r124hcr_aux t_r124hcr_aux;

  CURSOR C_MODULOS_SEL IS
    SELECT NPC.CODCUA, NPC.TMACUA, CUA.EMICER FROM R128COM COM, R140NPC NPC, R128CUA CUA
     WHERE NPC.NUMEMP = l_r134dre_aux.NumEmp AND NPC.TIPCOL = l_r134dre_aux.TipCol AND NPC.NUMCAD = l_r134dre_aux.NumCad
       AND NPC.SITCUA = 1 AND COM.CODCUA = NPC.CODCUA AND COM.CODCUR = l_r134dre_aux.CodCua
       AND CUA.CODCUA = NPC.CODCUA
       AND ((NOT EXISTS(SELECT CUR.SEQHCR FROM R134CUR CUR
                         WHERE CUR.CODCUA = NPC.CODCUA AND CUR.TMACUA = NPC.TMACUA AND CUR.CODCUR = l_r134dre_aux.CodCua
                           AND CUR.NUMEMP = l_r134dre_aux.NumEmp AND CUR.TIPCOL = l_r134dre_aux.TipCol
                           AND CUR.NUMCAD = l_r134dre_aux.NumCad))
            OR
            (EXISTS(SELECT CUR.SEQHCR FROM R134CUR CUR, R124HCR HCR
                     WHERE CUR.CODCUA = NPC.CODCUA AND CUR.TMACUA = NPC.TMACUA AND CUR.CODCUR = l_r134dre_aux.CodCua
                       AND CUR.NUMEMP = l_r134dre_aux.NumEmp AND CUR.TIPCOL = l_r134dre_aux.TipCol AND CUR.NUMCAD = l_r134dre_aux.NumCad
                       AND HCR.NUMEMP = l_r134dre_aux.NumEmp AND HCR.TIPCOL = l_r134dre_aux.TipCol AND HCR.NUMCAD = l_r134dre_aux.NumCad
                       AND HCR.CODCUA = l_r134dre_aux.CodCua AND HCR.SEQHCR = CUR.SEQHCR AND HCR.SITCUA <> 1 AND HCR.SITCUA <> 2)));

  TYPE t_modulos_aux IS RECORD(
      CODCUA   R134DRE.CODCUA%TYPE,
      TMACUA   R134DRE.TMACUA%TYPE,
      EMICER   R128CUA.EMICER%TYPE);

  xmodulos_aux t_modulos_aux;

  r000ass_AdmRes   R000ASS.ADMRES%TYPE;

BEGIN
  /* Le Registro do CURSOR */
  BEGIN
    SELECT IFNULL(ADMRES,0) INTO r000ass_AdmRes FROM R000ASS;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no SELECT da tabela R000ASS.';
  END;

  /* Le Registro do CURSOR */
  FOREACH C_R134DRE_ins INTO  l_r134dre_aux.CODCUA,
                              l_r134dre_aux.TMACUA,
                              l_r134dre_aux.NUMEMP,
                              l_r134dre_aux.TIPCOL,
                              l_r134dre_aux.NUMCAD,
                              l_r134dre_aux.DATINS,
                              l_r134dre_aux.DATTER
  LOOP
     IF r000ass_AdmRes = 1 THEN
       /* Atualiza a turma do Participante na tabela de Reserva Individual */
       BEGIN
            UPDATE R132RPA SET TMACUA = l_r134dre_aux.TMACUA
             WHERE CODCUA = l_r134dre_aux.CODCUA AND NUMEMP = l_r134dre_aux.NUMEMP
               AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD = l_r134dre_aux.NUMCAD AND TMACUA = 0;
       EXCEPTION
            WHEN OTHERS THEN
                 RAISERROR 103 'Erro na Atualização da Turma na Reserva Individual.';
       END;
     ELSE
       /* Atualiza a turma do Participante na tabela de Reservas Efetuadas */
       BEGIN
            UPDATE R132REC SET TMACUA = l_r134dre_aux.TMACUA
             WHERE CODCUA = l_r134dre_aux.CODCUA AND EMPPAR = l_r134dre_aux.NUMEMP AND TIPPAR = l_r134dre_aux.TIPCOL
               AND CADPAR = l_r134dre_aux.NUMCAD AND TMACUA = 0;
       EXCEPTION
            WHEN OTHERS THEN
                 RAISERROR 103 'Erro na Atualização da Turma nas Reservas.';
       END;
     END IF;

     /* Atualiza a turma do Participante na tabela de Planos de Ação do PDI */
     BEGIN
          UPDATE R107PLN SET TMACUA = l_r134dre_aux.TMACUA
           WHERE CODCUA = l_r134dre_aux.CODCUA AND NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL
             AND NUMCAD = l_r134dre_aux.NUMCAD AND TMACUA = 0;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Atualização da Turma nos Planos de Ação do PDI.';
     END;

     /* Atualiza a turma do Participante na tabela de Acompanhamentos de PDI */
     BEGIN
          UPDATE R107ACO SET TMACUA = l_r134dre_aux.TMACUA
           WHERE CODCUA = l_r134dre_aux.CODCUA AND NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL
             AND NUMCAD = l_r134dre_aux.NUMCAD AND TMACUA = 0;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Atualização da Turma nos Acompanhamentos do PDI.';
     END;

     /* Busca o Tipo do Certificado, se é Modular e o Tipo de Controle de Frequencia no cadastro do Curso */
     SELECT IFNULL(TIPCER,' '), IFNULL(TIPCUA,' '), IFNULL(CONFRE, 0) INTO l_TipCer, xTipCua, xConFre FROM R128CUA WHERE R128CUA.CODCUA = l_r134dre_aux.CODCUA;

     /* Se não for Módulo */
     IF (xTipCua = 'N') THEN
       /* Verifica se é para emitir Certificados das Disciplinas do Módulo .*/
       xEmiCer := ' ';
       FOREACH C_MODULOS_SEL INTO xmodulos_aux.CODCUA,
                                  xmodulos_aux.TMACUA,
                                  xmodulos_aux.EMICER
       LOOP
         /* Se algum curso modular estiver setado para Emitir cerfiticado, seta para emitir */
         IF (xEmiCer <> 'S') THEN
           xEmiCer := xmodulos_aux.EMICER;
         END IF;
       END LOOP;

       IF (xEmiCer = 'N') THEN
         l_TipCer := 'N';
       END IF;
     END IF;

     /* Busca os dados da Turma */
     SELECT DATINI, DATFIM, CODFES, IFNULL(CARHOR, 0), IFNULL(QTDAUL,0), TIPCNF, FASCUA, IFNULL(AVRWEB, ' '), TIPTRE INTO l_DatIni, l_DatFim, l_CodOem, l_CarHor, l_QtdAul, l_TipCnf, l_FasCua, l_AvrWeb, l_TipTre
       FROM R134DTU WHERE R134DTU.CODCUA = l_r134dre_aux.CODCUA AND R134DTU.TMACUA = l_r134dre_aux.TMACUA;

     /* Verifica se a turma utiliza Avaliação de Reação Web */  
     IF (l_AvrWeb = 'S') THEN
       l_SitAre := 1; /* Não iniciado */
     ELSE
       l_SitAre := 0; /* Não controlado */
     END IF;  

     /* Verifica se o participante já tem registro na R140NPC */
     BEGIN
        SELECT IFNULL(COUNT(*),0) INTO l_QtdNpc FROM R140NPC
         WHERE NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD = l_r134dre_aux.NUMCAD
           AND CODCUA = l_r134dre_aux.CODCUA AND TMACUA = l_r134dre_aux.TMACUA;
     EXCEPTION 
          WHEN NO_DATA_FOUND THEN
              l_QtdNpc := 0;
     END;

     IF (l_QtdNpc = 0) THEN
        /* Inclui o Participante na tabela de Frequencias */
        BEGIN
          INSERT R140NPC (CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, QTDFAL, HORFAL, TIPCER, NUMCER, SITCUA, CODMIN, SITARE, SITANT)
                  VALUES (l_r134dre_aux.CODCUA, l_r134dre_aux.TMACUA, l_r134dre_aux.NUMEMP, l_r134dre_aux.TIPCOL, l_r134dre_aux.NUMCAD, 0, 0, l_TipCer, 0, 1, 0, l_SitAre, 0);
        EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Inclusão do Participante na Avaliação.';
        END;
     END IF;

     IF (xTipCua = 'S') THEN
       l_DatIni := l_r134dre_aux.DATINS;
       l_DatFim := l_r134dre_aux.DATTER;
     END IF;

     /* Se a turma for de um tipo maior que 2, não altera histórico */
     IF   (l_TipCnf < 3) THEN
          /* Busca a Qtde de Faltas, o Tipo do Certificado, a Situação do Curso, Motivo de Interrupção e as Horas de Faltas  */
          SELECT IFNULL(QTDFAL,0), IFNULL(TIPCER,' '), IFNULL(SITCUA,0), IFNULL(CODMIN,0), IFNULL(HORFAL, 0) INTO l_QtdFal, l_TipCer, l_SitCua, l_CodMin, l_HorFal FROM R140NPC
           WHERE CODCUA = l_r134dre_aux.CODCUA AND TMACUA = l_r134dre_aux.TMACUA
             AND NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD = l_r134dre_aux.NUMCAD;

          /* Se o Participante tiver Certificado de Aproveitamento ou Participação, coloca situação do Curso "Concluído" */
          IF   (l_SitCua <> 7) THEN
               /* Verifica se já existe histórico deste curso para este candidato */
               BEGIN
                    SELECT IFNULL(COUNT(*),0) INTO l_nrohis FROM R124HCR
                     WHERE NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD = l_r134dre_aux.NUMCAD
                       AND CODCUA = l_r134dre_aux.CODCUA AND TMACUA = l_r134dre_aux.TMACUA;
               EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                         l_NroHis := 0;
               END;

               /* Se o Tipo do Certificado for N, então deve gravar branco no Histórico */
               IF   l_TipCer = 'N' THEN
                    l_TipCer := ' ';
               END IF;

               l_FreCua := 0;
               l_MedCua := 0;
               /* Somente calcula a média e frequencia para as Turmas não modulares */
               IF   (xTipCua <> 'S') AND (l_SitCua <> 1) THEN
                    /* Calcula a frequência pela quantidade de aulas */
                    IF   (xConFre = 0) THEN
                         IF   (l_QtdAul <> 0) THEN
                              l_FreCua := 100 - (l_QtdFal * 100) / l_QtdAul;
                         END IF;
                    ELSE
                    /* Calcula a frequência pela carga horária */
                         IF   (l_CarHor <> 0) THEN
                              l_FreCua := 100 - (l_HorFal * 100) / l_CarHor;
                         END IF;
                    END IF;

                    /* Calcula a média do Participante */
                    TR_CALCMEDIA(l_r134dre_aux.CODCUA, l_r134dre_aux.TMACUA,
                                 l_r134dre_aux.NUMEMP, l_r134dre_aux.TIPCOL,
                                 l_r134dre_aux.NUMCAD, l_MedCua OUT);
               END IF;

               /* Se nao existe Histórico, inclui o mesmo na tabela */
               IF   l_nrohis = 0 THEN
                    /* Verifica qual é a menor sequencia cadastrada para este curso neste colaborador */
                    l_SeqHcr := 1;
                    FOREACH C_R124HCR_SEL INTO l_r124hcr_aux.SEQHCR
                    LOOP
                         IF   (l_SeqHcr < l_r124hcr_aux.SEQHCR) THEN
                              EXIT;
                         END IF;
                         l_SeqHcr := l_SeqHcr + 1;
                    END LOOP;

                    BEGIN
                         INSERT R124HCR (NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, PERINI, PERFIM, CODOEM, SITCUA, CODMIN, TIPCER, MEDCUA, FRECUA, CARHOR, FASCUA, COMCUA, INDVCT, IDILEI, IDIESC, IDICON, ORIHCR, IDICUA, TMACUA, TIPTRE)
                                 VALUES (l_r134dre_aux.NUMEMP, l_r134dre_aux.TIPCOL, l_r134dre_aux.NUMCAD, l_r134dre_aux.CODCUA, l_SeqHcr, l_DatIni, l_DatFim, l_CodOem, l_SitCua, l_CodMin, l_TipCer, l_MedCua, l_FreCua, l_CarHor, l_FasCua, ' ', ' ', ' ', ' ', ' ', 'T', 'C', l_r134dre_aux.TMACUA, l_TipTre);
                                 
                         SP_INSTRUTORES(l_r134dre_aux.NUMEMP, l_r134dre_aux.TIPCOL, l_r134dre_aux.NUMCAD, l_r134dre_aux.CODCUA, l_r134dre_aux.TMACUA, l_SeqHcr, 0, 0, 0, 'I');
                    EXCEPTION
                         WHEN OTHERS THEN
                              RAISERROR 103 'Erro na Inclusão do Histórico de Curso.';
                    END;
               ELSE
                    BEGIN
                       IF (xTipCua = 'S') THEN
                         UPDATE R124HCR SET PERFIM = l_DatFim, CODOEM = l_CodOem, SITCUA = l_SitCua, CODMIN = l_CodMin, TIPCER = l_TipCer, MEDCUA = l_MedCua, FRECUA = l_FreCua, FASCUA = l_FasCua, TIPTRE = l_TipTre, ORIHCR = 'T'
                          WHERE NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD = l_r134dre_aux.NUMCAD
                            AND CODCUA = l_r134dre_aux.CODCUA AND TMACUA = l_r134dre_aux.TMACUA;
                       ELSE
                         UPDATE R124HCR SET PERFIM = l_DatFim, CODOEM = l_CodOem, SITCUA = l_SitCua, CODMIN = l_CodMin, TIPCER = l_TipCer, MEDCUA = l_MedCua, FRECUA = l_FreCua, CARHOR = l_CarHor, FASCUA = l_FasCua, TIPTRE = l_TipTre, ORIHCR = 'T'
                          WHERE NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD = l_r134dre_aux.NUMCAD
                            AND CODCUA = l_r134dre_aux.CODCUA AND TMACUA = l_r134dre_aux.TMACUA;
                       END IF;
                       
                       SP_INSTRUTORES(l_r134dre_aux.NUMEMP, l_r134dre_aux.TIPCOL, l_r134dre_aux.NUMCAD, l_r134dre_aux.CODCUA, l_r134dre_aux.TMACUA, 0, l_r134dre_aux.NUMEMP, l_r134dre_aux.TIPCOL, l_r134dre_aux.NUMCAD, 'A');
                    EXCEPTION
                       WHEN OTHERS THEN
                            RAISERROR 103 'Erro na Atualização do Histórico de Curso.';
                    END;
               END IF;
          ELSE
               /* Exclui o Histórico de Curso para o participante se o mesmo não tiver Certificado */
               BEGIN
                    SP_INSTRUTORES(l_r134dre_aux.NUMEMP, l_r134dre_aux.TIPCOL, l_r134dre_aux.NUMCAD, l_r134dre_aux.CODCUA, l_r134dre_aux.TMACUA, 0, l_r134dre_aux.NUMEMP, l_r134dre_aux.TIPCOL, l_r134dre_aux.NUMCAD, 'E');
               
                    DELETE FROM R124HCR WHERE NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD = l_r134dre_aux.NUMCAD
                                          AND CODCUA = l_r134dre_aux.CODCUA AND TMACUA = l_r134dre_aux.TMACUA;
               EXCEPTION
                    WHEN OTHERS THEN
                         RAISERROR 103 'Erro na Exclusão do Histórico de Curso.';
               END;
          END IF;
     END IF;
  END LOOP;

  BEGIN
    /* Limpar tabela auxiliar */
    DELETE FROM R134DRE_AUX;
    DROP_TEMP_TABLE R134DRE_AUX;
    EXCEPTION WHEN OTHERS THEN
	    RAISERROR 103 'Erro ao excluir registros da tabela R134DRE_AUX';
  END;  
END␀â␀␀		SENIOR;0¢␀␀/* Insere o registro da R134DRE na AUX para processar o registro */
TRIGGER R134DRE_EI AFTER INSERT ON R134DRE FOR EACH ROW
DECLARE
  CREATE_TEMP_TABLE R134DRE_AUX;
BEGIN
IF (((:NEW.CONEMI <> 'X') AND (:NEW.CONEMI <> 'Z') AND (:NEW.CONEMI <> 'Y')) OR (:NEW.CONEMI IS NULL)) THEN
    BEGIN
      /* Insere Registro NEW */
      INSERT INTO R134DRE_AUX (CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, DATINS, DATTER, TIPOPE)
                       VALUES (:NEW.CODCUA, :NEW.TMACUA, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATINS, :NEW.DATTER, 'I');
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no INSERT em R134DRE_AUX.';
    END;
  END IF;
END␀â␀␀		SENIOR;01␀␀

/* Atualiza os participantes na Tabela de históricos */
TRIGGER R134DRE_EU AFTER UPDATE ON R134DRE FOR EACH ROW

DECLARE
xTipCua   R128CUA.TIPCUA%TYPE;
BEGIN
  IF (((:NEW.CONEMI <> 'X') AND (:NEW.CONEMI <> 'Z') AND (:NEW.CONEMI <> 'Y')) OR (:NEW.CONEMI IS NULL)) AND
     (((:OLD.CONEMI <> 'X') AND (:OLD.CONEMI <> 'Z') AND (:OLD.CONEMI <> 'Y')) OR (:OLD.CONEMI IS NULL)) THEN
    /* Busca o Tipo do Curso no cadastro do Curso */
    SELECT IFNULL(TIPCUA, ' ') INTO xTipCua FROM R128CUA WHERE R128CUA.CODCUA = :NEW.CODCUA;

    /* Se for uma Turma de um Curso Modular e as Datas Iniciais e Finais do Participante foram alteradas, altera as datas do histórico */
    IF (xTipCua = 'S') AND ((:OLD.DATINS <> :NEW.DATINS) OR (:OLD.DATTER <> :NEW.DATTER)) THEN
      BEGIN
         SP_INSTRUTORES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODCUA, :NEW.TMACUA, 0, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, 'A');
      
         UPDATE R124HCR SET PERINI = :NEW.DATINS, PERFIM = :NEW.DATTER, ORIHCR = 'T'
          WHERE NUMEMP = :NEW.NUMEMP AND TIPCOL = :NEW.TIPCOL AND NUMCAD = :NEW.NUMCAD
            AND CODCUA = :NEW.CODCUA AND TMACUA = :OLD.TMACUA;
      EXCEPTION
         WHEN OTHERS THEN
              RAISERROR 103 'Erro na Atualização do Histórico de Curso.';
      END;
    END IF;
  END IF;
END␀â␀␀	SENIOR;0Q␀␀

/* Atualiza a Turma do Participante na tabela de Reservas Efetuadas */
/* Exclui o Participante na tabela de Frequencias */
/* Exclui o Participante na tabela de Controle de Frequência */
/* Exclui o Histórico de Curso para o participante */
TRIGGER R134DRE_SD AFTER DELETE ON R134DRE

DECLARE
l_TipCnf         R134DTU.TIPCNF%TYPE;

  CURSOR C_R134DRE_del IS SELECT CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, DATINS, DATTER
                            FROM R134DRE_AUX WHERE TIPOPE = 'E';

  TYPE t_r134dre_aux IS RECORD(
      CODCUA   R134DRE_AUX.CODCUA%TYPE,
      TMACUA   R134DRE_AUX.TMACUA%TYPE,
      NUMEMP   R134DRE_AUX.NUMEMP%TYPE,
      TIPCOL   R134DRE_AUX.TIPCOL%TYPE,
      NUMCAD   R134DRE_AUX.NUMCAD%TYPE,
      DATINS   R134DRE_AUX.DATINS%TYPE,
      DATTER   R134DRE_AUX.DATTER%TYPE);

  l_r134dre_aux t_r134dre_aux;

  r000ass_AdmRes   R000ASS.ADMRES%TYPE;
BEGIN
  /* Le Registro do CURSOR */
  BEGIN
    SELECT IFNULL(ADMRES,0) INTO r000ass_AdmRes FROM R000ASS;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no SELECT da tabela R000ASS.';
  END;

  /* Le Registro do CURSOR */
  FOREACH C_R134DRE_del INTO  l_r134dre_aux.CODCUA,
                              l_r134dre_aux.TMACUA,
                              l_r134dre_aux.NUMEMP,
                              l_r134dre_aux.TIPCOL,
                              l_r134dre_aux.NUMCAD,
                              l_r134dre_aux.DATINS,
                              l_r134dre_aux.DATTER
  LOOP
     IF r000ass_AdmRes = 1 THEN
       /* Atualiza a Turma do Participante na tabela de Reserva Individual */
       BEGIN
            UPDATE R132RPA SET TMACUA = 0
             WHERE CODCUA = l_r134dre_aux.CODCUA AND NUMEMP = l_r134dre_aux.NUMEMP
               AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD = l_r134dre_aux.NUMCAD;
       EXCEPTION
            WHEN OTHERS THEN
                 RAISERROR 103 'Erro na Exclusão da Turma nas Reservas Individuais.';
       END;
     ELSE
       /* Atualiza a Turma do Participante na tabela de Reservas Efetuadas */
       BEGIN
            UPDATE R132REC SET TMACUA = 0
             WHERE CODCUA = l_r134dre_aux.CODCUA AND EMPPAR = l_r134dre_aux.NUMEMP AND TIPPAR = l_r134dre_aux.TIPCOL
               AND CADPAR = l_r134dre_aux.NUMCAD AND TMACUA = l_r134dre_aux.TMACUA;
       EXCEPTION
            WHEN OTHERS THEN
                 RAISERROR 103 'Erro na Exclusão da Turma nas Reservas.';
       END;
     END IF;

     /* Atualiza a Turma do Participante na tabela de Planos de Ação do PDI */
     BEGIN
          UPDATE R107PLN SET TMACUA = 0
           WHERE CODCUA = l_r134dre_aux.CODCUA AND NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL
             AND NUMCAD = l_r134dre_aux.NUMCAD AND TMACUA = l_r134dre_aux.TMACUA;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Exclusão da Turma nos Planos de Ação do PDI.';
     END;

     /* Atualiza a Turma do Participante na tabela de Acompanhamentos do PDI */
     BEGIN
          UPDATE R107ACO SET TMACUA = 0
           WHERE CODCUA = l_r134dre_aux.CODCUA AND NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL
             AND NUMCAD = l_r134dre_aux.NUMCAD AND TMACUA = l_r134dre_aux.TMACUA;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Exclusão da Turma nos Acompanhamentos do PDI.';
     END;

     /* Exclui o Participante na tabela de Frequencia do Participante */
     BEGIN
          DELETE FROM R140NPC WHERE CODCUA = l_r134dre_aux.CODCUA AND TMACUA = l_r134dre_aux.TMACUA AND
                                    NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD =  l_r134dre_aux.NUMCAD;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Exclusão do Participante na Avaliação.';
     END;

     /* Exclui o Participante na tabela de Controle de Frequência */
     BEGIN
          DELETE FROM R134FRE WHERE CODCUA = l_r134dre_aux.CODCUA AND TMACUA = l_r134dre_aux.TMACUA AND
                                    NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD =  l_r134dre_aux.NUMCAD;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Exclusão do Participante na Avaliação.';
     END;

     /* Busca os dados da Turma */
     SELECT TIPCNF INTO l_TipCnf FROM R134DTU
      WHERE R134DTU.CODCUA = l_r134dre_aux.CODCUA AND R134DTU.TMACUA = l_r134dre_aux.TMACUA;

     /* Se a turma for de um tipo maior que 2, não altera histórico */
     IF   (l_TipCnf < 3) THEN
          /* Exclui o Histórico de Curso para o Colaborador - Cursos Aperfeiçoamento */
          BEGIN
              SP_INSTRUTORES (l_r134dre_aux.NUMEMP, l_r134dre_aux.TIPCOL, l_r134dre_aux.NUMCAD, l_r134dre_aux.CODCUA,
								l_r134dre_aux.TMACUA, 0, l_r134dre_aux.NUMEMP, l_r134dre_aux.TIPCOL, l_r134dre_aux.NUMCAD, 'E');
          
               DELETE FROM R124HCR WHERE NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD = l_r134dre_aux.NUMCAD
                                     AND CODCUA = l_r134dre_aux.CODCUA AND TMACUA = l_r134dre_aux.TMACUA;
          EXCEPTION
               WHEN OTHERS THEN
                    RAISERROR 103 'Erro na Exclusão do Histórico de Curso.';
          END;
     END IF;

     /* Exclui o Participante na tabela de Despesas da Turma - Participante por item de despesa  */
     BEGIN
          DELETE FROM R130DPI WHERE CODCUA = l_r134dre_aux.CODCUA AND TMACUA = l_r134dre_aux.TMACUA AND
                                    NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD =  l_r134dre_aux.NUMCAD;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Exclusão dos Itens de Despesa do Participante.';
     END;

     /* Exclui o Participante na tabela de Despesas da Turma - Participantes */
     BEGIN
          DELETE FROM R130DPA WHERE CODCUA = l_r134dre_aux.CODCUA AND TMACUA = l_r134dre_aux.TMACUA AND
                                    NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD =  l_r134dre_aux.NUMCAD;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro na Exclusão da Despesa do Participante.';
     END;

     /* Exclui o Participante na tabela de Turmas Modular - Histórico Participante */
     BEGIN
       DELETE FROM R134CUR
             WHERE CODCUA = l_r134dre_aux.CODCUA AND TMACUA = l_r134dre_aux.TMACUA AND
                   NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD =  l_r134dre_aux.NUMCAD;
     EXCEPTION
       WHEN OTHERS THEN
         RAISERROR 103 'Erro na Exclusão dos Vínculos do Participante.';
     END;

     /* Exclui o Participante na tabela de Turmas - Avaliação de Eficácia - Respostas */
     BEGIN
       DELETE FROM R134AVR
             WHERE CODCUA = l_r134dre_aux.CODCUA AND TMACUA = l_r134dre_aux.TMACUA AND
                   NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD =  l_r134dre_aux.NUMCAD;
     EXCEPTION
       WHEN OTHERS THEN
         RAISERROR 103 'Erro na Exclusão dos Vínculos do Participante.';
     END;

     /* Exclui o Participante na tabela de Turmas - Avaliação de Eficácia - Avaliado */
     BEGIN
       DELETE FROM R134AVA
             WHERE CODCUA = l_r134dre_aux.CODCUA AND TMACUA = l_r134dre_aux.TMACUA AND
                   NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD =  l_r134dre_aux.NUMCAD;
     EXCEPTION
       WHEN OTHERS THEN
         RAISERROR 103 'Erro na Exclusão dos Vínculos do Participante.';
     END;
  END LOOP;

  BEGIN
    /* Limpar tabela auxiliar */
    DELETE FROM R134DRE_AUX;
    DROP_TEMP_TABLE R134DRE_AUX;
    EXCEPTION WHEN OTHERS THEN
	    RAISERROR 103 'Erro ao excluir registros da tabela R134DRE_AUX';
  END; 
END␀â␀␀		SENIOR;0†␀␀

/* Exclui o registro da R134DRE na AUX para processar o registro */
TRIGGER R134DRE_ED AFTER DELETE ON R134DRE FOR EACH ROW
DECLARE 
  CREATE_TEMP_TABLE R134DRE_AUX;
BEGIN
IF (((:OLD.CONEMI <> 'X') AND (:OLD.CONEMI <> 'Z') AND (:OLD.CONEMI <> 'Y')) OR (:OLD.CONEMI IS NULL)) THEN
    BEGIN
      INSERT INTO R134DRE_AUX (CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, DATINS, DATTER, TIPOPE)
                       VALUES (:OLD.CODCUA, :OLD.TMACUA, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATINS, :OLD.DATTER, 'E');
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no delete na R134DRE_AUX.';
    END;
  END IF;
END␀␀␀ğ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀â␀␀Y,Ì␀€␀␀␀␀␀␀?@V9Y9{␀Æÿ␀␀ÿ␀â␀¼␀€␀␀␀␀␀␀,<Ì␀Ì␀v␀Æÿ␀␀ÿ␀…¬␀␀´␀€␀␀␀␀␀␀½<Xb±br␀Æÿ␀␀ÿ␀.␀t€␀␀␀␀␀␀é␀t␀ë␀n␀Æÿ␀␀ÿ␀c¬␀␀Ì␀€␀␀␀␀␀␀7%€$®$w␀Æÿ␀␀ÿ␀EÑ␀€␀␀␀␀␀␀/N¦‘␀␀¦‘␀␀qC␀êÿ␀␀ÿ␀µEÑ␀€␀␀␀␀␀␀…N6␀ÉHqC␀êÿ␀␀ÿ␀à␀␀€␀␀␀␀␀␀!␀ ␀ ␀+␀␀ÿ␀␀ÿ␀␀␀␀␀␀	␀ñ␀␀	␀␀␀␀␀␀␀␀â␀␀Y,Ì␀	€␀␀␀␀␀␀?@V9Y9{␀Æÿ␀␀xá␀␀␀â␀¼␀	€␀␀␀␀␀␀,<Ì␀Ì␀v␀Æÿ␀␀â␀␀␀ˆü␀␀´␀	€␀␀␀␀␀␀÷ÿ␀␀xş␀␀xş␀␀r␀Æÿ␀␀ÿ␀/€␀␀␀␀␀␀K/"Ä␀␀J/>␀␀ÿ␀␀ÿ␀/€␀␀␀␀␀␀F/¥¦␀␀E/>␀␀ÿ␀␀ÿ␀␀␀␀0;1;2␀␀Õ␀␀␀␀␀␀␀	â␀␀Y,Ì␀	€␀␀␀␀␀␀?@V9Y9{␀Æÿ␀␀xá␀␀␀â␀¼␀	€␀␀␀␀␀␀'>Ì␀Ì␀v␀Æÿ␀␀â␀␀␀…¬␀␀´␀	€␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀Ş␀´␀	€␀␀␀␀␀␀>½␀␀r␀Æÿ␀␀YĞ␀␀␀§¬␀␀Ì␀	€␀␀␀␀␀␀Ôš␀␀€š␀␀€š␀␀m␀Æÿ␀␀aĞ␀␀␀İ␀¼␀€␀␀␀␀␀␀ŞÊ␀␀^␀v␀Æÿ␀␀ÿ␀Ú␀¼␀€␀␀␀␀␀␀İÊ␀␀ù␀MË␀␀v␀Æÿ␀␀ÿ␀„¶␀␀␀€␀␀␀␀␀␀å¶␀␀‘¶␀␀ä¶␀␀+␀␀ÿ␀␀ÿ␀␀␀␀	0;1;2;3;4␀␀ö␀␀␀␀␀␀␀␀␀␀
â␀␀Y,Ì␀	€␀␀␀␀␀␀?@V9Y9{␀Æÿ␀␀xá␀␀␀â␀¼␀	€␀␀␀␀␀␀'>Ì␀Ì␀v␀Æÿ␀␀â␀␀␀Ä-±␀	€␀␀␀␀␀␀´•␀␀£•␀␀£•␀␀q␀Æÿ␀␀xâ␀␀␀áü␀␀±␀€␀␀␀␀␀␀ñÿ␀␀ü␀␀xş␀␀q␀Æÿ␀␀ÿ␀cÁ␀␀­␀€␀␀␀␀␀␀±Á␀␀xÁ␀␀xÁ␀␀p␀Æÿ␀␀ÿ␀␀␀â␀␀␀␀␀0;1;2â␀␀	SENIOR;0S␀␀

/* Trigger Insert - Statement */
TRIGGER R134DTN_SI AFTER INSERT ON R134DTN

DECLARE
/* CURSOR c/ os registros gravados no R134DTN_AUX */
  CURSOR c_r134DTN_ins IS
    SELECT DISTINCT CODCUA, TMACUA FROM R134DTN_AUX;

  TYPE t_r134DTN_aux IS RECORD(
    CODCUA   R134DTN_AUX.CODCUA%TYPE,
    TMACUA   R134DTN_AUX.TMACUA%TYPE
    );

  xR134DTN_aux t_r134DTN_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r134DTN_ins INTO xR134DTN_aux.CODCUA,
                             xR134DTN_aux.TMACUA
  LOOP
    /* Atualiza a média dos participantes da Turma */
    TR_ATUMED(xR134DTN_aux.CODCUA, xR134DTN_aux.TMACUA);
  END LOOP;

  /* Apaga registros da R134DTN_AUX */
  BEGIN
    DELETE FROM R134DTN_AUX;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na exclusão dos registros da R134DTN_AUX';
  END;
END␀â␀␀		SENIOR;0V	␀␀/* Quando forem incluidos ou excluidos Itens de nota na Turma, esta Trigger atualizará os arquivos */
/* de Itens por Participante e por Curso */
TRIGGER R134DTN_EI AFTER INSERT ON R134DTN FOR EACH ROW

DECLARE
l_TipTnt  VARCHAR2(1);
BEGIN
     SELECT TIPTNT INTO l_TipTnt FROM R140NTR WHERE CODTNT = :NEW.CODTNT;
     /* Inclui o item de Nota de Participante para todos os Participantes da Turma */
     IF   l_TipTnt = 'P' THEN
          BEGIN
               INSERT R140NPA (CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, CODTNT, NOTPAR)
                       SELECT :NEW.CODCUA, :NEW.TMACUA, R140NPC.NUMEMP, R140NPC.TIPCOL, R140NPC.NUMCAD, :NEW.CODTNT, 0
                         FROM R140NPC WHERE CODCUA = :NEW.CODCUA AND TMACUA = :NEW.TMACUA;
          EXCEPTION
               WHEN OTHERS THEN
                    RAISERROR 103 'Erro na Inclusão dos Itens de Notas dos Participantes.';
          END;

          BEGIN
            /* Insere Registro NEW */
            INSERT INTO R134DTN_AUX (CODCUA, TMACUA, CODTNT)
                             VALUES (:NEW.CODCUA, :NEW.TMACUA, :NEW.CODTNT);
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro no INSERT em R134DTN_AUX.';
          END;
     END IF;

     /* Inclui o item de Nota de Curso para todos os Participantes da Turma inclusive anônimos */
     IF   l_TipTnt = 'C' THEN
          /*Participantes*/
          BEGIN
               INSERT R140NCU (CODCUA, TMACUA, NUMEMP, TIPCOL, NUMCAD, CODTNT, NOTCUR)
                       SELECT :NEW.CODCUA, :NEW.TMACUA, R140NPC.NUMEMP, R140NPC.TIPCOL, R140NPC.NUMCAD, :NEW.CODTNT, 0
                         FROM R140NPC WHERE CODCUA = :NEW.CODCUA AND TMACUA = :NEW.TMACUA;
          EXCEPTION
               WHEN OTHERS THEN
                    RAISERROR 103 'Erro na Inclusão dos Itens de Notas do Curso dos Participantes.';
          END;
          /*Anônimos*/
          BEGIN
               INSERT R140NAN (CODCUA, TMACUA, SEQANO, CODTNT, NOTCUR)
                       SELECT :NEW.CODCUA, :NEW.TMACUA, R134DTA.SEQANO, :NEW.CODTNT, 0
                         FROM R134DTA WHERE CODCUA = :NEW.CODCUA AND TMACUA = :NEW.TMACUA;
          EXCEPTION
               WHEN OTHERS THEN
                    RAISERROR 103 'Erro na Inclusão dos Itens de Notas do Curso para Anônimos.';
          END;
     END IF;
END␀â␀␀	SENIOR;0S␀␀

/* Trigger Update - Statement */
TRIGGER R134DTN_SU AFTER UPDATE ON R134DTN

DECLARE
/* CURSOR c/ os registros gravados no R134DTN_AUX */
  CURSOR c_r134DTN_upd IS
    SELECT DISTINCT CODCUA, TMACUA FROM R134DTN_AUX;

  TYPE t_r134DTN_aux IS RECORD(
    CODCUA   R134DTN_AUX.CODCUA%TYPE,
    TMACUA   R134DTN_AUX.TMACUA%TYPE
    );

  xR134DTN_aux t_r134DTN_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r134DTN_upd INTO xR134DTN_aux.CODCUA,
                             xR134DTN_aux.TMACUA
  LOOP
    /* Atualiza a média dos participantes da Turma */
    TR_ATUMED(xR134DTN_aux.CODCUA, xR134DTN_aux.TMACUA);
  END LOOP;

  /* Apaga registros da R134DTN_AUX */
  BEGIN
    DELETE FROM R134DTN_AUX;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na exclusão dos registros da R134DTN_AUX';
  END;
END␀â␀␀		SENIOR;0‚␀␀

/* Quando forem alterados os Pesos dos Itens de nota de Participante,
   esta Trigger atualizará a nota dos Participantes da Turma */
TRIGGER R134DTN_EU AFTER UPDATE ON R134DTN FOR EACH ROW

BEGIN
/* Inclui o item de Nota de Participante na tabela auxiliar para atualizar médias dos participantes */
  IF (:OLD.PESNOT <> :NEW.PESNOT) THEN
    BEGIN
      /* Insere Registro NEW */
      INSERT INTO R134DTN_AUX (CODCUA, TMACUA, CODTNT)
                       VALUES (:NEW.CODCUA, :NEW.TMACUA, :NEW.CODTNT);
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no INSERT em R134DTN_AUX.';
    END;
  END IF;
END␀â␀␀	SENIOR;0S␀␀

/* Trigger Delete - Statement */
TRIGGER R134DTN_SD AFTER DELETE ON R134DTN

DECLARE
/* CURSOR c/ os registros gravados no R134DTN_AUX */
  CURSOR c_r134DTN_del IS
    SELECT DISTINCT CODCUA, TMACUA FROM R134DTN_AUX;

  TYPE t_r134DTN_aux IS RECORD(
    CODCUA   R134DTN_AUX.CODCUA%TYPE,
    TMACUA   R134DTN_AUX.TMACUA%TYPE
    );

  xR134DTN_aux t_r134DTN_aux;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r134DTN_del INTO xR134DTN_aux.CODCUA,
                             xR134DTN_aux.TMACUA
  LOOP
    /* Atualiza a média dos participantes da Turma */
    TR_ATUMED(xR134DTN_aux.CODCUA, xR134DTN_aux.TMACUA);
  END LOOP;

  /* Apaga registros da R134DTN_AUX */
  BEGIN
    DELETE FROM R134DTN_AUX;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na exclusão dos registros da R134DTN_AUX';
  END;
END␀â␀␀		SENIOR;0Ş␀␀

TRIGGER R134DTN_ED AFTER DELETE ON R134DTN FOR EACH ROW

DECLARE
l_TipTnt  VARCHAR2(1);
BEGIN
  SELECT TIPTNT INTO l_TipTnt FROM R140NTR WHERE CODTNT = :OLD.CODTNT;
  
  /* Exclui o item de Nota de Participante de todos os Participantes da Turma */
  BEGIN
    DELETE FROM R140NPA WHERE CODCUA = :OLD.CODCUA AND TMACUA = :OLD.TMACUA AND CODTNT = :OLD.CODTNT;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na Exclusão dos Itens da Nota dos Participantes.';
  END;

  /* se for um item de Nota de Participante, deve recalcular a média */
  IF (l_TipTnt = 'P') THEN
    BEGIN
      /* Insere Registro NEW */
      INSERT INTO R134DTN_AUX (CODCUA, TMACUA, CODTNT)
                       VALUES (:OLD.CODCUA, :OLD.TMACUA, :OLD.CODTNT);
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no INSERT em R134DTN_AUX.';
    END;
  END IF;

  /* Exclui o item de Nota de Curso de todos os Participantes da Turma */
  BEGIN
    DELETE FROM R140NCU WHERE CODCUA = :OLD.CODCUA AND TMACUA = :OLD.TMACUA AND CODTNT = :OLD.CODTNT;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na Exclusão dos Itens do Curso dos Participantes.';
  END;
  
  /* Exclui o item de Nota de Curso de todos os Anônimos da Turma */
  BEGIN
    DELETE FROM R140NAN WHERE CODCUA = :OLD.CODCUA AND TMACUA = :OLD.TMACUA AND CODTNT = :OLD.CODTNT;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na Exclusão dos Itens do Curso de Anônimos.';
  END;
END␀␀␀î␀␀␀␀␀␀␀â␀␀Y,Ì␀€␀␀␀␀␀␀?@V9Y9{␀Æÿ␀␀xá␀␀␀â␀¼␀€␀␀␀␀␀␀'>Ì␀Ì␀v␀Æÿ␀␀â␀␀␀Ä-±␀€␀␀␀␀␀␀´•␀␀£•␀␀£•␀␀q␀Æÿ␀␀xâ␀␀␀cÁ␀␀­␀€␀␀␀␀␀␀±Á␀␀xÁ␀␀xÁ␀␀p␀Æÿ␀␀ÿ␀␀␀␀␀␀␀ï␀␀␀␀␀␀â␀␀Y,Ì␀	€␀␀␀␀␀␀?@V9Y9{␀Æÿ␀␀xá␀␀␀â␀¼␀	€␀␀␀␀␀␀'>Ì␀Ì␀v␀Æÿ␀␀â␀␀␀EÑ␀€␀␀␀␀␀␀çGZ”␀␀áÀ␀␀qC␀êÿ␀␀ÿ␀åDÑ␀€␀␀␀␀␀␀…K6␀6␀qC␀êÿ␀␀ÿ␀ÂÉ␀␀±␀€␀␀␀␀␀␀Ì␀␀DÉ␀␀DÉ␀␀q␀Æÿ␀␀ÿ␀S␀¥€␀␀␀␀␀␀¯␀5␀5␀n␀Æÿ␀␀ÿ␀Ê	␀±␀€␀␀␀␀␀␀\
␀µ_µ_q␀Æÿ␀␀ÿ␀X'‹␀€␀␀␀␀␀␀•'•'•'ï*␀␀Æÿ␀␀ÿ␀†Ê␀␀¼␀€␀␀␀␀␀␀rÌ␀␀ù␀ù␀v␀Æÿ␀␀ÿ␀␀±␀€␀␀␀␀␀␀\␀©í␀␀©í␀␀q␀Æÿ␀␀zâ␀␀␀”,Ç␀€␀␀␀␀␀␀á<NdNdz␀Æÿ␀␀ÖÒ␀␀␀ì␀␀¹␀€␀␀␀␀␀␀¤␀␀j¤␀␀~¤␀␀Q)␀␀Æÿ␀␀ÿ␀Üp¹␀€␀␀␀␀␀␀¥Q)␀␀Æÿ␀␀ÿ␀)␀r€␀␀␀␀␀␀›␀␀␀n␀Æÿ␀␀ÿ␀*␀t€␀␀␀␀␀␀Ó␀Ÿ␀Ÿ␀n␀Æÿ␀␀ÿ␀×-‹␀€␀␀␀␀␀␀‹␀␀}7}7—)␀␀␀Æÿ␀␀ÿ␀«lD€␀␀␀␀␀␀³l¯l±lR␀␀ÿ␀␀„á␀␀␀ï␀␀±␀€␀␀␀␀␀␀Ùğ␀␀^ğ␀␀^ğ␀␀q␀Æÿ␀␀ÿ␀©ï␀␀±␀€␀␀␀␀␀␀Üğ␀␀•ğ␀␀•ğ␀␀q␀Æÿ␀␀ÿ␀²ï␀␀±␀€␀␀␀␀␀␀İğ␀␀™ğ␀␀™ğ␀␀q␀Æÿ␀␀ÿ␀Õ_=€␀␀␀␀␀␀.^-^-^c␀␀␀ÿ␀␀ÿ␀Ğ-b€␀␀␀␀␀␀‰BKKr␀␀␀ÿ␀␀Râ␀␀␀æ␀␀±␀€␀␀␀␀␀␀Å␀␀íÄ␀␀ïÄ␀␀q␀Æÿ␀␀ÿ000ãÄ␀␀±␀€␀␀␀␀␀␀Å␀␀íÄ␀␀ïÄ␀␀q␀Æÿ␀␀ÿ␀	=€␀␀␀␀␀␀İ`[[c␀␀␀ÿ␀␀ÿ␀âÄ␀␀±␀€␀␀␀␀␀␀	Å␀␀îÄ␀␀ñÄ␀␀q␀Æÿ␀␀ÿ␀␀]€␀␀␀␀␀␀ş␀ı␀ı␀n␀Æÿ␀␀ÿ␀‘8]€␀␀␀␀␀␀ºQ¿8Ã8n␀Æÿ␀␀ÿ␀ô=€␀␀␀␀␀␀—␀..c␀␀␀ÿ␀␀ÿ␀è=€␀␀␀␀␀␀˜␀**c␀␀␀ÿ␀␀ÿ␀î=€␀␀␀␀␀␀™␀,,c␀␀␀ÿ␀␀ÿ␀DÑ␀€␀␀␀␀␀␀<FÆ&;FqC␀êÿ␀␀ÿ␀-±␀€␀␀␀␀␀␀è@Î¢␀␀Î¢␀␀q␀Æÿ␀␀7â␀␀␀Œï␀␀±␀€␀␀␀␀␀␀Úğ␀␀jğ␀␀jğ␀␀q␀Æÿ␀␀ÿ␀tï␀␀±␀€␀␀␀␀␀␀áğ␀␀Fğ␀␀Fğ␀␀q␀Æÿ␀␀ÿ␀D,±␀€␀␀␀␀␀␀‹RÙ*ä*q␀Æÿ␀␀pá␀␀␀,EÑ␀€␀␀␀␀␀␀Å␀␀úÄ␀␀úÄ␀␀qC␀êÿ␀␀ÿ␀ç&␀=€␀␀␀␀␀␀û&␀÷&␀ø&␀c␀␀␀ÿ␀␀ÿ␀»=€␀␀␀␀␀␀ÂÀ␀␀Xc␀␀␀ÿ␀␀ÿ␀‰1,€␀␀␀␀␀␀¼P¿6¿6n␀Æÿ␀␀ÿ␀JTƒ␀€␀␀␀␀␀␀ÓXl5l57␀␀ÿ␀␀ÿ␀␀U*€␀␀␀␀␀␀'Yš²␀␀š²␀␀7␀␀ÿ␀␀ÿ␀0Ÿ␀␀€␀␀␀␀␀␀GŸ␀␀FŸ␀␀FŸ␀␀?␀␀ÿ␀␀ÿ␀–È␀␀V€␀␀␀␀␀␀¾È␀␀½È␀␀½È␀␀?␀␀ÿ␀␀ÿ␀b´␀€␀␀␀␀␀␀Á<XbÉbr␀␀Æÿ␀␀Ò␀␀0000*␀t€␀␀␀␀␀␀U␀t␀1␀n␀Æÿ␀␀ˆÓ␀␀␀g$Ì␀€␀␀␀␀␀␀Z%kó␀␀²$w␀␀Æÿ␀␀…Ó␀␀0"b´␀€␀␀␀␀␀␀¤<×b£br␀␀Æÿ␀␀Ò␀␀0000ıµ␀␀´␀€␀␀␀␀␀␀>¶␀␀¶␀␀r␀␀Æÿ␀␀YĞ␀␀000uš␀␀Ì␀€␀␀␀␀␀␀Õ@³š␀␀¤š␀␀m␀␀Æÿ␀␀aĞ␀␀0[␀X€␀␀␀␀␀␀R␀p␀p␀n␀␀Æÿ␀␀ÿ␀␀␀␀0;1â␀␀	SENIOR;00y␀␀

/* Atualiza o Histórico de Curso dos Participantes da Turma */
TRIGGER R134DTU_SU AFTER UPDATE ON R134DTU

DECLARE
l_SeqHcr         R124HCR.SEQHCR%TYPE;
  l_QtdFal         R140NPC.QTDFAL%TYPE;
  l_SitCua         R140NPC.SITCUA%TYPE;
  l_CodMin         R140NPC.CODMIN%TYPE;
  l_FreCua         R124HCR.FRECUA%TYPE;
  l_MedCua         R124HCR.MEDCUA%TYPE;
  l_TipCer         R140NPC.TIPCER%TYPE;
  l_TipCua         R128CUA.TIPCUA%TYPE;
  l_ConFre         R128CUA.CONFRE%TYPE;
  l_HorFal         R140NPC.HORFAL%TYPE;
  xSeqReg        NUMBER(3);

  CURSOR C_R134DTU_up1 IS SELECT CODCUA, TMACUA, DATINI, DATFIM, QTDAUL, CARHOR, CODFES, TIPCNF,
                                 FASCUA, INIOLD, FIMOLD, FESOLD, HOROLD, FASOLD, QTDOLD, CNFOLD, TIPOPE, TIPTRE, TIPOLD
                            FROM R134DTU_AUX2 WHERE SEQREG = 1 AND TIPOPE = 'U';

  CURSOR C_R134DTU_up2 IS SELECT CODCUA, TMACUA, DATINI, DATFIM, QTDAUL, CARHOR, CODFES, TIPCNF,
                                 FASCUA, INIOLD, FIMOLD, FESOLD, HOROLD, FASOLD, QTDOLD, CNFOLD, TIPOPE, TIPTRE, TIPOLD
                            FROM R134DTU_AUX2 WHERE SEQREG = 2 AND TIPOPE = 'U';

  TYPE t_r134DTU_aux IS RECORD(
      CODCUA   R134DTU_AUX.CODCUA%TYPE,
      TMACUA   R134DTU_AUX.TMACUA%TYPE,
      DATINI   R134DTU_AUX.DATINI%TYPE,
      DATFIM   R134DTU_AUX.DATFIM%TYPE,
      QTDAUL   R134DTU_AUX.QTDAUL%TYPE,
      CARHOR   R134DTU_AUX.CARHOR%TYPE,
      CODFES   R134DTU_AUX.CODFES%TYPE,
      TIPCNF   R134DTU_AUX.TIPCNF%TYPE,
      FASCUA   R134DTU_AUX.FASCUA%TYPE,
      INIOLD   R134DTU_AUX.INIOLD%TYPE,
      FIMOLD   R134DTU_AUX.FIMOLD%TYPE,
      FESOLD   R134DTU_AUX.FESOLD%TYPE,
      HOROLD   R134DTU_AUX.HOROLD%TYPE,
      FASOLD   R134DTU_AUX.FASOLD%TYPE,
      QTDOLD   R134DTU_AUX.QTDOLD%TYPE,
      CNFOLD   R134DTU_AUX.CNFOLD%TYPE,
      TIPOPE   R134DTU_AUX.TIPOPE%TYPE,
      TIPTRE   R134DTU_AUX.TIPTRE%TYPE,
      TIPOLD   R134DTU_AUX.TIPOLD%TYPE);

  l_r134DTU_aux t_r134DTU_aux;

  CURSOR C_R124HCR_UPD IS SELECT NUMEMP, TIPCOL, NUMCAD FROM R124HCR
                           WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA;
  TYPE t_r124hcr_aux IS RECORD(
      NUMEMP   R124HCR.NUMEMP%TYPE,
      TIPCOL   R124HCR.TIPCOL%TYPE,
      NUMCAD   R124HCR.NUMCAD%TYPE);

  l_r124hcr_aux t_r124hcr_aux;

  CURSOR C_R134DRE_SEL IS SELECT NUMEMP, TIPCOL, NUMCAD FROM R134DRE
                           WHERE R134DRE.CODCUA = l_r134DTU_aux.CODCUA AND R134DRE.TMACUA = l_r134DTU_aux.TMACUA;

  TYPE t_r134dre_aux IS RECORD(
      NUMEMP   R134DRE.NUMEMP%TYPE,
      TIPCOL   R134DRE.TIPCOL%TYPE,
      NUMCAD   R134DRE.NUMCAD%TYPE);

  l_r134dre_aux t_r134dre_aux;

  CURSOR C_R124HCR_sel IS SELECT SEQHCR FROM R124HCR
                           WHERE NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL
                             AND NUMCAD = l_r134dre_aux.NUMCAD AND CODCUA = l_r134DTU_aux.CODCUA
                        ORDER BY SEQHCR;

  TYPE t_r124hcr_sel IS RECORD(
      SEQHCR   R124HCR.SEQHCR%TYPE);

  l_r124hcr_sel t_r124hcr_sel;
BEGIN
  /* Nesta Trigger os dados da AUX estão sendo inseridos na AUX2 porque os processamentos desta trigger disparam
     Triggers de outras tabelas que podem efetuar um UPDATE (segundo update) nesta mesma Tabela. Se isto acontecesse ]
     e tivesse algum registro na AUX, as triggers entrariam em LOOP porque a Trigger de statement daquele
     segundo update pegaria os registros processados pelo primeiro UPDATE.
     Jogando os valores para a AUX2 com uma sequencia, isto não mais acontecerá. */

  /* Busca a maior sequencia da AUX */
  BEGIN
    SELECT IFNULL(MAX(SEQREG), 0) INTO xSeqReg FROM R134DTU_AUX2;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      xSeqReg := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na Busca da sequencia da R134DTU_AUX';
  END;

  /* Incrementa a sequencia para incluir registros com a mesma. */
  xSeqReg := xSeqReg + 1;

  /* Le Registro da AUX para inserir na AUX2 com a sequencia */
  BEGIN
    INSERT INTO R134DTU_AUX2 (SEQREG, CODCUA, TMACUA, DATINI, DATFIM, QTDAUL, CARHOR, CODFES, TIPCNF, FASCUA, INIOLD, FIMOLD, FESOLD, HOROLD, FASOLD, QTDOLD, CNFOLD, TIPOPE, TIPTRE, TIPOLD)
                      SELECT xSeqReg, CODCUA, TMACUA, DATINI, DATFIM, QTDAUL, CARHOR, CODFES, TIPCNF, FASCUA, INIOLD, FIMOLD, FESOLD, HOROLD, FASOLD, QTDOLD, CNFOLD, TIPOPE, TIPTRE, TIPOLD
                          FROM R134DTU_AUX WHERE TIPOPE = 'U';
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro no INSERT na R134DTU_AUX2.';
  END;

  /* Apaga Registro OLD em R134DTU_AUX */
  BEGIN
    DELETE FROM R134DTU_AUX WHERE TIPOPE = 'U';
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;

  /* Le Registro do CURSOR - AUX2*/
  IF (xSeqReg = 1) THEN
    FOREACH C_R134DTU_up1 INTO l_r134DTU_aux.CODCUA,
                               l_r134DTU_aux.TMACUA,
                               l_r134DTU_aux.DATINI,
                               l_r134DTU_aux.DATFIM,
                               l_r134DTU_aux.QTDAUL,
                               l_r134DTU_aux.CARHOR,
                               l_r134DTU_aux.CODFES,
                               l_r134DTU_aux.TIPCNF,
                               l_r134DTU_aux.FASCUA,
                               l_r134DTU_aux.INIOLD,
                               l_r134DTU_aux.FIMOLD,
                               l_r134DTU_aux.FESOLD,
                               l_r134DTU_aux.HOROLD,
                               l_r134DTU_aux.FASOLD,
                               l_r134DTU_aux.QTDOLD,
                               l_r134DTU_aux.CNFOLD,
                               l_r134DTU_aux.TIPOPE,
                               l_r134DTU_aux.TIPTRE,
                               l_r134DTU_aux.TIPOLD
    LOOP
       /* Busca se a Turma é do tipo Modular e qual é a forma de controle de frequência */
       SELECT IFNULL(TIPCUA,' '), IFNULL(CONFRE,0) INTO l_TipCua, l_ConFre FROM R128CUA WHERE R128CUA.CODCUA = l_r134DTU_aux.CODCUA;

       /* Se a turma for de um tipo maior que 2, não altera histórico */
       IF   (l_r134DTU_aux.CNFOLD < 3) THEN
            IF   (l_r134DTU_aux.INIOLD <> l_r134DTU_aux.DATINI) OR (l_r134DTU_aux.FIMOLD <> l_r134DTU_aux.DATFIM)
              OR (l_r134DTU_aux.FESOLD <> l_r134DTU_aux.CODFES) OR (l_r134DTU_aux.HOROLD <> l_r134DTU_aux.CARHOR)
              OR (l_r134DTU_aux.FASOLD <> l_r134DTU_aux.FASCUA) OR (l_r134DTU_aux.TIPOLD <> l_r134DTU_aux.TIPTRE) THEN
                 /* Se não for Turma Modular, altera dados dos históricos e também data inicial e final */
                 IF (l_TipCua <> 'S') THEN
                   BEGIN
                        UPDATE R124HCR SET PERINI = l_r134DTU_aux.DATINI, PERFIM = l_r134DTU_aux.DATFIM, CODOEM = l_r134DTU_aux.CODFES, CARHOR = l_r134DTU_aux.CARHOR, FASCUA = l_r134DTU_aux.FASCUA, ORIHCR = 'T', TIPTRE = l_r134DTU_aux.TIPTRE
                         WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA;
                   EXCEPTION
                        WHEN OTHERS THEN
                             RAISERROR 103 'Erro na Atualização dos Históricos de Curso dos Participantes da Turma.';
                   END;
                 ELSE
                   /* Caso contrário, altera dados dos históricos e não altera data inicial e final pq são baseadas nas datas da R134DRE */
                   BEGIN
                        UPDATE R124HCR SET CODOEM = l_r134DTU_aux.CODFES, FASCUA = l_r134DTU_aux.FASCUA, ORIHCR = 'T'
                         WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA;
                   EXCEPTION
                        WHEN OTHERS THEN
                             RAISERROR 103 'Erro na Atualização dos Históricos de Curso dos Participantes da Turma.';
                   END;
                 END IF;
            END IF;

            /* Atualiza a Frequencia do Historico de Curso dos Participantes, se não for um Curso Modular */
            IF (l_TipCua <> 'S') AND ((l_r134DTU_aux.QTDOLD <> l_r134DTU_aux.QTDAUL) OR (l_r134DTU_aux.HOROLD <> l_r134DTU_aux.CARHOR)) THEN
                 /* Le Registro do CURSOR */
                 FOREACH C_R124HCR_UPD INTO l_r124hcr_aux.NUMEMP,
                                            l_r124hcr_aux.TIPCOL,
                                            l_r124hcr_aux.NUMCAD
                 LOOP
                      l_FreCua := 0;
                      /* Controle de frequência pela quantidade de aulas */
                      IF   (l_ConFre = 0) THEN
                           IF   (l_r134DTU_aux.QTDAUL <> 0) THEN
                                SELECT IFNULL(QTDFAL,0), IFNULL(SITCUA,0), IFNULL(CODMIN,0) INTO l_QtdFal, l_SitCua, l_CodMin FROM R140NPC
                                 WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA AND NUMEMP = l_r124hcr_aux.NUMEMP
                                   AND TIPCOL = l_r124hcr_aux.TIPCOL AND NUMCAD = l_r124hcr_aux.NUMCAD;

                                /* Calcula Frequencia */
                                IF   (l_SitCua <> 1) THEN
                                     l_FreCua := (100 - ((l_QtdFal) * 100) / l_r134DTU_aux.QTDAUL);
                                END IF;
                           END IF;
                      ELSE
                      /* Controle de frequência pela carga horária */
                           IF   (l_r134DTU_aux.CARHOR <> 0) THEN
                                SELECT IFNULL(HORFAL,0), IFNULL(SITCUA,0), IFNULL(CODMIN,0) INTO l_HorFal, l_SitCua, l_CodMin FROM R140NPC
                                 WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA AND NUMEMP = l_r124hcr_aux.NUMEMP
                                   AND TIPCOL = l_r124hcr_aux.TIPCOL AND NUMCAD = l_r124hcr_aux.NUMCAD;

                                /* Calcula Frequencia */
                                IF   (l_SitCua <> 1) THEN
                                     l_FreCua := (100 - ((l_HorFal) * 100) / l_r134DTU_aux.CARHOR);
                                END IF;
                           END IF;
                      END IF;

                      BEGIN
                           UPDATE R124HCR SET FRECUA = l_FreCua, ORIHCR = 'T'
                            WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA AND NUMEMP = l_r124hcr_aux.NUMEMP
                              AND TIPCOL = l_r124hcr_aux.TIPCOL AND NUMCAD = l_r124hcr_aux.NUMCAD;
                      EXCEPTION
                           WHEN OTHERS THEN
                                RAISERROR 103 'Erro na Atualização da Frequencia dos Históricos de Curso dos Participantes da Turma.';
                      END;
                 END LOOP;
            END IF;
       END IF;

       /* Se o Tipo da Turma era menor que 3 e agora é maior ou igual a 3, apaga os históricos de Curso */
       IF   (l_r134DTU_aux.CNFOLD < 3) AND (l_r134DTU_aux.TIPCNF >= 3) THEN
            /* Exclui o Históricos de Curso dos participantes */
            BEGIN
                 DELETE FROM R124HCR WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA;
            EXCEPTION
                 WHEN OTHERS THEN
                      RAISERROR 103 'Erro na Exclusão do Histórico de Curso.';
            END;
       ELSE
            /* Se o Tipo da Turma agora é menor que 3, inclui os históricos de Curso para os Participantes da Turma */
            IF   (l_r134DTU_aux.CNFOLD >= 3) AND (l_r134DTU_aux.TIPCNF < 3) THEN
                 /* Le Registro do CURSOR */
                 FOREACH C_R134DRE_SEL INTO l_r134dre_aux.NUMEMP,
                                            l_r134dre_aux.TIPCOL,
                                            l_r134dre_aux.NUMCAD
                 LOOP

                      /* Busca a Qtde de Faltas, o Tipo do Certificado, a Situação do Curso, Motivo de Interrupção e as Horas de Faltas  */
                      BEGIN
                           SELECT IFNULL(QTDFAL,0), IFNULL(TIPCER,' '), IFNULL(SITCUA,0), IFNULL(CODMIN,0), IFNULL(HORFAL,0) INTO l_QtdFal, l_TipCer, l_SitCua, l_CodMin, l_HorFal FROM R140NPC
                            WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA
                              AND NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD = l_r134dre_aux.NUMCAD;
                      EXCEPTION
                           WHEN NO_DATA_FOUND THEN
                                l_QtdFal := 0;
                                l_TipCer := ' ';
                                l_SitCua := 0;
                                l_CodMin := 0;
                                l_HorFal := 0;
                      END;

                      /* Se a Situação for diferente de 7 atualiza o Histórico */
                      IF   (l_SitCua <> 7) THEN

                           /* Se o Tipo do Certificado for N, então deve gravar branco no Histórico */
                           IF   l_TipCer = 'N' THEN
                                l_TipCer := ' ';
                           END IF;

                           l_FreCua := 0;
                           l_MedCua := 0;
                           IF   (l_SitCua <> 1) THEN
                                /* Calcula a frequência pela quantidade de aulas */
                                IF   (l_ConFre = 0) THEN
                                     IF   (IFNULL(l_r134DTU_aux.QTDAUL,0) <> 0) THEN
                                          l_FreCua := 100 - (l_QtdFal * 100) / IFNULL(l_r134DTU_aux.QTDAUL,0);
                                     END IF;
                                ELSE
                                /* Calcula a frequência pela carga horária */
                                     IF   (IFNULL(l_r134DTU_aux.CARHOR,0) <> 0) THEN
                                          l_FreCua := 100 - (l_HorFal * 100) / IFNULL(l_r134DTU_aux.CARHOR,0);
                                     END IF;
                                END IF;

                                /* Calcula a média do Participante */
                                TR_CALCMEDIA(l_r134DTU_aux.CODCUA, l_r134DTU_aux.TMACUA,
                                             l_r134dre_aux.NUMEMP, l_r134dre_aux.TIPCOL,
                                             l_r134dre_aux.NUMCAD, l_MedCua OUT);
                           END IF;

                           /* Verifica se já existe histórico deste curso para este candidato */
                           BEGIN
                                SELECT SEQHCR INTO l_SeqHcr FROM R124HCR
                                 WHERE NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD = l_r134dre_aux.NUMCAD
                                   AND CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA;
                           EXCEPTION
                                WHEN NO_DATA_FOUND THEN
                                     l_SeqHcr := 0;
                           END;

                           /* Se nao existe Histórico, inclui o mesmo na tabela */
                           IF   l_SeqHcr = 0 THEN
                                /* Verifica qual é a menor sequencia cadastrada para este curso neste colaborador */
                                l_SeqHcr := 1;
                                FOREACH C_R124HCR_SEL INTO l_r124hcr_sel.SEQHCR
                                LOOP
                                     IF   (l_SeqHcr < l_r124hcr_sel.SEQHCR) THEN
                                          EXIT;
                                     END IF;
                                     l_SeqHcr := l_SeqHcr + 1;
                                END LOOP;

                                BEGIN
                                     INSERT R124HCR (NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, PERINI, PERFIM, CODOEM, SITCUA, CODMIN, TIPCER, MEDCUA, FRECUA, CARHOR, FASCUA, COMCUA, INDVCT, IDILEI, IDIESC, IDICON, ORIHCR, IDICUA, TMACUA, TIPTRE)
                                             VALUES (l_r134dre_aux.NUMEMP, l_r134dre_aux.TIPCOL, l_r134dre_aux.NUMCAD, l_r134DTU_aux.CODCUA, l_SeqHcr, l_r134DTU_aux.DATINI, l_r134DTU_aux.DATFIM, l_r134DTU_aux.CODFES, l_SitCua, l_CodMin, l_TipCer, l_MedCua, l_FreCua, l_r134DTU_aux.CARHOR, l_r134DTU_aux.FASCUA, ' ', ' ', ' ', ' ', ' ', 'T', 'C', l_r134DTU_aux.TMACUA, l_r134DTU_aux.TIPTRE);
                                EXCEPTION
                                     WHEN OTHERS THEN
                                          RAISERROR 103 'Erro na Inclusão do Histórico de Curso.';
                                END;
                           ELSE
                                BEGIN
                                     UPDATE R124HCR SET PERFIM = l_r134DTU_aux.DATFIM, CODOEM = l_r134DTU_aux.CODFES, SITCUA = l_SitCua, CODMIN = l_CodMin, TIPCER = l_TipCer, MEDCUA = l_MedCua, FRECUA = l_FreCua, CARHOR = l_r134DTU_aux.CARHOR, FASCUA = l_r134DTU_aux.FASCUA, ORIHCR = 'T', TIPTRE = l_r134DTU_aux.TIPTRE
                                      WHERE NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL
                                        AND NUMCAD = l_r134dre_aux.NUMCAD AND CODCUA = l_r134DTU_aux.CODCUA AND SEQHCR = l_SeqHcr;
                                EXCEPTION
                                     WHEN OTHERS THEN
                                          RAISERROR 103 'Erro na Atualização do Histórico de Curso.';
                                END;
                           END IF;
                      END IF;

                 END LOOP;
            END IF;
       END IF;
    END LOOP;
  ELSE
    FOREACH C_R134DTU_up2 INTO l_r134DTU_aux.CODCUA,
                               l_r134DTU_aux.TMACUA,
                               l_r134DTU_aux.DATINI,
                               l_r134DTU_aux.DATFIM,
                               l_r134DTU_aux.QTDAUL,
                               l_r134DTU_aux.CARHOR,
                               l_r134DTU_aux.CODFES,
                               l_r134DTU_aux.TIPCNF,
                               l_r134DTU_aux.FASCUA,
                               l_r134DTU_aux.INIOLD,
                               l_r134DTU_aux.FIMOLD,
                               l_r134DTU_aux.FESOLD,
                               l_r134DTU_aux.HOROLD,
                               l_r134DTU_aux.FASOLD,
                               l_r134DTU_aux.QTDOLD,
                               l_r134DTU_aux.CNFOLD,
                               l_r134DTU_aux.TIPOPE,
                               l_r134DTU_aux.TIPTRE,
                               l_r134DTU_aux.TIPOLD
    LOOP
       /* Busca se a Turma é do tipo Modular */
       SELECT IFNULL(TIPCUA,' ') INTO l_TipCua FROM R128CUA WHERE R128CUA.CODCUA = l_r134DTU_aux.CODCUA;

       /* Se a turma for de um tipo maior que 2, não altera histórico */
       IF   (l_r134DTU_aux.CNFOLD < 3) THEN
            IF   (l_r134DTU_aux.INIOLD <> l_r134DTU_aux.DATINI) OR (l_r134DTU_aux.FIMOLD <> l_r134DTU_aux.DATFIM)
              OR (l_r134DTU_aux.FESOLD <> l_r134DTU_aux.CODFES) OR (l_r134DTU_aux.HOROLD <> l_r134DTU_aux.CARHOR)
              OR (l_r134DTU_aux.FASOLD <> l_r134DTU_aux.FASCUA) OR (l_r134DTU_aux.HOROLD <> l_r134DTU_aux.TIPTRE) THEN
                 /* Se não for Turma Modular, altera dados dos históricos e também data inicial e final */
                 IF (l_TipCua <> 'S') THEN
                   BEGIN
                        UPDATE R124HCR SET PERINI = l_r134DTU_aux.DATINI, PERFIM = l_r134DTU_aux.DATFIM, CODOEM = l_r134DTU_aux.CODFES, CARHOR = l_r134DTU_aux.CARHOR, FASCUA = l_r134DTU_aux.FASCUA, ORIHCR = 'T', TIPTRE = l_r134DTU_aux.TIPTRE
                         WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA;
                   EXCEPTION
                        WHEN OTHERS THEN
                             RAISERROR 103 'Erro na Atualização dos Históricos de Curso dos Participantes da Turma.';
                   END;
                 ELSE
                   /* Caso contrário, altera dados dos históricos e não altera data inicial e final pq são baseadas nas datas da R134DRE */
                   BEGIN
                        UPDATE R124HCR SET CODOEM = l_r134DTU_aux.CODFES, FASCUA = l_r134DTU_aux.FASCUA, ORIHCR = 'T'
                         WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA;
                   EXCEPTION
                        WHEN OTHERS THEN
                             RAISERROR 103 'Erro na Atualização dos Históricos de Curso dos Participantes da Turma.';
                   END;
                 END IF;
            END IF;

            /* Atualiza a Frequencia do Historico de Curso dos Participantes, se não for um Curso Modular */
            IF (l_TipCua <> 'S') AND ((l_r134DTU_aux.QTDOLD <> l_r134DTU_aux.QTDAUL) OR (l_r134DTU_aux.HOROLD <> l_r134DTU_aux.CARHOR)) THEN
                 /* Le Registro do CURSOR */
                 FOREACH C_R124HCR_UPD INTO l_r124hcr_aux.NUMEMP,
                                            l_r124hcr_aux.TIPCOL,
                                            l_r124hcr_aux.NUMCAD
                 LOOP
                      l_FreCua := 0;
                      /* Controle de frequência pela quantidade de aulas */
                      IF   (l_ConFre = 0) THEN
                           IF   (l_r134DTU_aux.QTDAUL <> 0) THEN
                                SELECT IFNULL(QTDFAL,0), IFNULL(SITCUA,0), IFNULL(CODMIN,0) INTO l_QtdFal, l_SitCua, l_CodMin FROM R140NPC
                                 WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA AND NUMEMP = l_r124hcr_aux.NUMEMP
                                   AND TIPCOL = l_r124hcr_aux.TIPCOL AND NUMCAD = l_r124hcr_aux.NUMCAD;

                                /* Calcula Frequencia */
                                IF   (l_SitCua <> 1) THEN
                                     l_FreCua := (100 - ((l_QtdFal) * 100) / l_r134DTU_aux.QTDAUL);
                                END IF;
                           END IF;
                      ELSE
                      /* Controle de frequência pela carga horária */
                           IF   (l_r134DTU_aux.CARHOR <> 0) THEN
                                SELECT IFNULL(HORFAL,0), IFNULL(SITCUA,0), IFNULL(CODMIN,0) INTO l_HorFal, l_SitCua, l_CodMin FROM R140NPC
                                 WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA AND NUMEMP = l_r124hcr_aux.NUMEMP
                                   AND TIPCOL = l_r124hcr_aux.TIPCOL AND NUMCAD = l_r124hcr_aux.NUMCAD;

                                /* Calcula Frequencia */
                                IF   (l_SitCua <> 1) THEN
                                     l_FreCua := (100 - ((l_HorFal) * 100) / l_r134DTU_aux.CARHOR);
                                END IF;
                           END IF;
                      END IF;

                      BEGIN
                           UPDATE R124HCR SET FRECUA = l_FreCua, ORIHCR = 'T'
                            WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA AND NUMEMP = l_r124hcr_aux.NUMEMP
                              AND TIPCOL = l_r124hcr_aux.TIPCOL AND NUMCAD = l_r124hcr_aux.NUMCAD;
                      EXCEPTION
                           WHEN OTHERS THEN
                                RAISERROR 103 'Erro na Atualização da Frequencia dos Históricos de Curso dos Participantes da Turma.';
                      END;
                 END LOOP;
            END IF;
       END IF;

       /* Se o Tipo da Turma era menor que 3 e agora é maior ou igual a 3, apaga os históricos de Curso */
       IF   (l_r134DTU_aux.CNFOLD < 3) AND (l_r134DTU_aux.TIPCNF >= 3) THEN
            /* Exclui o Históricos de Curso dos participantes */
            BEGIN
                 DELETE FROM R124HCR WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA;
            EXCEPTION
                 WHEN OTHERS THEN
                      RAISERROR 103 'Erro na Exclusão do Histórico de Curso.';
            END;
       ELSE
            /* Se o Tipo da Turma agora é menor que 3, inclui os históricos de Curso para os Participantes da Turma */
            IF   (l_r134DTU_aux.CNFOLD >= 3) AND (l_r134DTU_aux.TIPCNF < 3) THEN
                 /* Le Registro do CURSOR */
                 FOREACH C_R134DRE_SEL INTO l_r134dre_aux.NUMEMP,
                                            l_r134dre_aux.TIPCOL,
                                            l_r134dre_aux.NUMCAD
                 LOOP

                      /* Busca a Qtde de Faltas, o Tipo do Certificado, a Situação do Curso, Motivo de Interrupção e as Horas de Faltas  */
                      BEGIN
                           SELECT IFNULL(QTDFAL,0), IFNULL(TIPCER,' '), IFNULL(SITCUA,0), IFNULL(CODMIN,0), IFNULL(HORFAL,0) INTO l_QtdFal, l_TipCer, l_SitCua, l_CodMin, l_HorFal FROM R140NPC
                            WHERE CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA
                              AND NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD = l_r134dre_aux.NUMCAD;
                      EXCEPTION
                           WHEN NO_DATA_FOUND THEN
                                l_QtdFal := 0;
                                l_TipCer := ' ';
                                l_SitCua := 0;
                                l_CodMin := 0;
                                l_HorFal := 0;
                      END;

                      /* Se a Situação for diferente de 5 atualiza o Histórico */
                      IF   (l_SitCua <> 7) THEN

                           /* Se o Tipo do Certificado for N, então deve gravar branco no Histórico */
                           IF   l_TipCer = 'N' THEN
                                l_TipCer := ' ';
                           END IF;

                           l_FreCua := 0;
                           l_MedCua := 0;
                           IF   (l_SitCua <> 1) THEN
                                /* Calcula a frequência pela quantidade de aulas */
                                IF   (l_ConFre = 0) THEN
                                     IF   (IFNULL(l_r134DTU_aux.QTDAUL,0) <> 0) THEN
                                          l_FreCua := 100 - (l_QtdFal * 100) / IFNULL(l_r134DTU_aux.QTDAUL,0);
                                     END IF;
                                ELSE
                                /* Calcula a frequência pela carga horária */
                                     IF   (IFNULL(l_r134DTU_aux.CARHOR,0) <> 0) THEN
                                          l_FreCua := 100 - (l_HorFal * 100) / IFNULL(l_r134DTU_aux.CARHOR,0);
                                     END IF;
                                END IF;

                                /* Calcula a média do Participante */
                                TR_CALCMEDIA(l_r134DTU_aux.CODCUA, l_r134DTU_aux.TMACUA,
                                             l_r134dre_aux.NUMEMP, l_r134dre_aux.TIPCOL,
                                             l_r134dre_aux.NUMCAD, l_MedCua OUT);
                           END IF;

                           /* Verifica se já existe histórico deste curso para este candidato */
                           BEGIN
                                SELECT SEQHCR INTO l_SeqHcr FROM R124HCR
                                 WHERE NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL AND NUMCAD = l_r134dre_aux.NUMCAD
                                   AND CODCUA = l_r134DTU_aux.CODCUA AND TMACUA = l_r134DTU_aux.TMACUA;
                           EXCEPTION
                                WHEN NO_DATA_FOUND THEN
                                     l_SeqHcr := 0;
                           END;

                           /* Se nao existe Histórico, inclui o mesmo na tabela */
                           IF   l_SeqHcr = 0 THEN
                                /* Verifica qual é a menor sequencia cadastrada para este curso neste colaborador */
                                l_SeqHcr := 1;
                                FOREACH C_R124HCR_SEL INTO l_r124hcr_sel.SEQHCR
                                LOOP
                                     IF   (l_SeqHcr < l_r124hcr_sel.SEQHCR) THEN
                                          EXIT;
                                     END IF;
                                     l_SeqHcr := l_SeqHcr + 1;
                                END LOOP;

                                BEGIN
                                     INSERT R124HCR (NUMEMP, TIPCOL, NUMCAD, CODCUA, SEQHCR, PERINI, PERFIM, CODOEM, SITCUA, CODMIN, TIPCER, MEDCUA, FRECUA, CARHOR, FASCUA, COMCUA, INDVCT, IDILEI, IDIESC, IDICON, ORIHCR, IDICUA, TMACUA, TIPTRE)
                                             VALUES (l_r134dre_aux.NUMEMP, l_r134dre_aux.TIPCOL, l_r134dre_aux.NUMCAD, l_r134DTU_aux.CODCUA, l_SeqHcr, l_r134DTU_aux.DATINI, l_r134DTU_aux.DATFIM, l_r134DTU_aux.CODFES, l_SitCua, l_CodMin, l_TipCer, l_MedCua, l_FreCua, l_r134DTU_aux.CARHOR, l_r134DTU_aux.FASCUA, ' ', ' ', ' ', ' ', ' ', 'T', 'C', l_r134DTU_aux.TMACUA, l_r134DTU_aux.TIPTRE);
                                EXCEPTION
                                     WHEN OTHERS THEN
                                          RAISERROR 103 'Erro na Inclusão do Histórico de Curso.';
                                END;
                           ELSE
                                BEGIN
                                     UPDATE R124HCR SET PERFIM = l_r134DTU_aux.DATFIM, CODOEM = l_r134DTU_aux.CODFES, SITCUA = l_SitCua, CODMIN = l_CodMin, TIPCER = l_TipCer, MEDCUA = l_MedCua, FRECUA = l_FreCua, CARHOR = l_r134DTU_aux.CARHOR, FASCUA = l_r134DTU_aux.FASCUA, ORIHCR = 'T', TIPTRE = l_r134DTU_aux.TIPTRE
                                      WHERE NUMEMP = l_r134dre_aux.NUMEMP AND TIPCOL = l_r134dre_aux.TIPCOL
                                        AND NUMCAD = l_r134dre_aux.NUMCAD AND CODCUA = l_r134DTU_aux.CODCUA AND SEQHCR = l_SeqHcr;
                                EXCEPTION
                                     WHEN OTHERS THEN
                                          RAISERROR 103 'Erro na Atualização do Histórico de Curso.';
                                END;
                           END IF;
                      END IF;

                 END LOOP;
            END IF;
       END IF;
    END LOOP;
  END IF;

  /* Apaga Registro OLD em R134DTU_AUX */
  BEGIN
    DELETE FROM R134DTU_AUX2 WHERE SEQREG = xSeqReg AND TIPOPE = 'U';
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀â␀␀		SENIOR;0Ö␀␀/* Insere o registro da R134DTU na AUX para processar o registro */
TRIGGER R134DTU_EU AFTER UPDATE ON R134DTU FOR EACH ROW

BEGIN
BEGIN
    /* Insere Registro NEW */
    INSERT INTO R134DTU_AUX (CODCUA, TMACUA, DATINI, DATFIM, QTDAUL, CARHOR, CODFES, TIPCNF, FASCUA, INIOLD, FIMOLD, FESOLD, HOROLD, FASOLD, QTDOLD, CNFOLD, TIPOPE, TIPTRE, TIPOLD)
                     VALUES (:NEW.CODCUA, :NEW.TMACUA, :NEW.DATINI, :NEW.DATFIM, :NEW.QTDAUL, :NEW.CARHOR, :NEW.CODFES, :NEW.TIPCNF, :NEW.FASCUA, :OLD.DATINI, :OLD.DATFIM, :OLD.CODFES, :OLD.CARHOR, :OLD.FASCUA, :OLD.QTDAUL, :OLD.TIPCNF, 'U', :NEW.TIPTRE, :OLD.TIPTRE);
  EXCEPTION
    WHEN OTHERS THEN
