       R126CPE.DATADM ADMCPE, R126CPE.TIPCAN,
       R126RQU.CODRQU, R126RQU.ANOCON, R126RQU.NUMCON, 
       R038HCA.DATALT, R038HCA.ESTCAR, R038HCA.CODCAR,
       R024CAR.TITRED
FROM R034FUN,
     R126CPE,
     R126RQU,
     R038HCA,
     R024CAR
WHERE R034FUN.NUMEMP = R126CPE.EMPEFE
  AND R034FUN.TIPCOL = R126CPE.TIPEFE
  AND R034FUN.NUMCAD = R126CPE.CADEFE
  AND R126CPE.CODRQU = R126RQU.CODRQU
  AND R126RQU.ANOCON > 0
  AND R126RQU.NUMCON > 0
  AND R126CPE.EMPEFE = R038HCA.NUMEMP
  AND R126CPE.TIPEFE = R038HCA.TIPCOL
  AND R126CPE.CADEFE = R038HCA.NUMCAD
  AND R126RQU.ESTCAR = R038HCA.ESTCAR
  AND R126RQU.CODCAR = R038HCA.CODCAR
  AND R038HCA.ESTCAR = R024CAR.ESTCAR
  AND R038HCA.CODCAR = R024CAR.CODCAR
UNION
SELECT R034FUN.NUMEMP, R034FUN.TIPCOL, R034FUN.NUMCAD, R034FUN.NOMFUN, R034FUN.DATADM,
       R126CPE.DATADM ADMCPE, R126CPE.TIPCAN,
       R126RQU.CODRQU, R126RQU.ANOCON, R126RQU.NUMCON, 
       R038HCA.DATALT, R038HCA.ESTCAR, R038HCA.CODCAR,
       R024CAR.TITRED
FROM R034FUN,
     R126CPE,
     R126RQU,
     R038HCA,
     R024CAR
WHERE R034FUN.NUMEMP = R126CPE.NUMEMP
  AND R034FUN.TIPCOL = R126CPE.TIPCOL
  AND R034FUN.NUMCAD = R126CPE.NUMCAD
  AND R126CPE.CODRQU = R126RQU.CODRQU
  AND R126RQU.ANOCON > 0
  AND R126RQU.NUMCON > 0
  AND R126CPE.NUMEMP = R038HCA.NUMEMP
