SP_DATSTR
|	␀␀PROCEDURE SP_RETMSA(P_NUMMAT VARCHAR2(15),P_DESMSG OUT VARCHAR2(32),P_DATMSG OUT VARCHAR2(16),P_QTDMSG OUT VARCHAR2(2))
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_datfim      DATE;
  l_hora_atual  NUMBER(4);
  l_qtdmsg      INTEGER;
  l_desmsg      VARCHAR2(32);
  l_datmsg      VARCHAR2(6);
  l_errstr      VARCHAR2(255);
  l_nodatafound BOOLEAN;

BEGIN
  /* Inicializa */
  l_data_atual  := CURDATE();
  l_data_zero   := '31/12/1900,00:00:00';
  l_hora_atual  := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_desmsg      := '';
  l_qtdmsg      := 0;
  l_datfim      := l_data_zero;
  l_nodatafound := FALSE;

  /* Verifica se Existe Cracha Provisorio */
  BEGIN
    SELECT MSGACC,QTDMSG,DATFIM INTO l_desmsg,l_qtdmsg,l_datfim
      FROM R070MSA A
     WHERE A.NUMMAT = p_nummat AND
           A.DATINI =
   (SELECT MAX(DATINI) FROM R070MSA
     WHERE NUMMAT = p_nummat AND
           (DATINI < l_data_atual OR
           (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
           (DATFIM = l_data_zero OR
            DATFIM > l_data_atual OR
           (DATFIM = l_data_atual AND HORFIM >= l_hora_atual)))
      AND  A.HORINI =
   (SELECT MAX(HORINI) FROM R070MSA
     WHERE NUMMAT = p_nummat AND
           DATINI = A.DATINI);
  EXCEPTION
    WHEN TOO_MANY_ROWS THEN
      l_errstr := 'Erro em R070MSA - TOO MANY ROWS. '||
                  'Num.Mat.: '||p_nummat;
      RAISERROR 103 l_errstr;
    WHEN NO_DATA_FOUND THEN
      l_desmsg      := '';
      l_qtdmsg      := 0;
      l_datfim      := l_data_zero;
      l_nodatafound := TRUE;
    WHEN OTHERS THEN
      l_errstr := 'Erro em R070MSA - TOO MANY ROWS. '||
                  'Num.Mat.: '||p_nummat;
      RAISERROR 103 l_errstr;
  END;

  SP_INTSTR(l_qtdmsg,'99',p_qtdmsg OUT);
  IF   (NOT(l_desmsg IS NULL))  AND (l_desmsg <> ' ') THEN
       IF   (l_qtdmsg = 0) THEN
            l_datmsg := '999999';
       ELSE
            IF   l_datfim = l_data_atual THEN
                 SP_DATSTR(l_data_atual,'DDMMYY',l_datmsg OUT);
            ELSE
                 IF  (l_nodatafound = TRUE) THEN
                      l_datmsg := '      ';
                 ELSE
                      l_datmsg := '999999';
                 END IF;
            END IF;
       END IF;
  ELSE
       l_datmsg := '      ';
  END IF;
  p_desmsg := l_desmsg;
  p_datmsg := l_datmsg || '0000000000';
END		SENIOR;20#SP_INTSTR
SP_DATSTR
SP_STRTOSTR
ë	␀␀PROCEDURE SP_RETMSA(P_NUMMAT VARCHAR2(15),P_DESMSG OUT VARCHAR2(32),P_DATMSG OUT VARCHAR2(16),P_QTDMSG OUT VARCHAR2(2))
 IS

l_data_zero   DATE;
  l_data_atual  DATE;
  l_datfim      DATE;
  l_horfim      NUMBER(5);
  l_hora_atual  NUMBER(4);
  l_qtdmsg      INTEGER;
  l_desmsg      VARCHAR2(32);
  l_datstr      VARCHAR2(16);
  l_datmsg      VARCHAR2(6);
  l_hormsg      VARCHAR2(4);
  l_errstr      VARCHAR2(255);
  l_nodatafound BOOLEAN;

BEGIN
  /* Inicializa */
  l_data_atual  := CURDATE();
  l_data_zero   := '31/12/1900,00:00:00';
  l_hora_atual  := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_desmsg      := '';
  l_qtdmsg      := 0;
  l_datfim      := l_data_zero;
  l_nodatafound := FALSE;
  l_datstr := '0000000000000000';

  /* Verifica se Existe Cracha Provisorio */
  BEGIN
    SELECT MSGACC,QTDMSG,DATFIM, HORFIM INTO l_desmsg,l_qtdmsg,l_datfim,l_horfim
      FROM R070MSA A
     WHERE A.NUMMAT = p_nummat AND
           A.DATINI =
   (SELECT MAX(DATINI) FROM R070MSA
     WHERE NUMMAT = p_nummat AND
           (DATINI < l_data_atual OR
           (DATINI = l_data_atual AND HORINI <= l_hora_atual)) AND
           (DATFIM = l_data_zero OR
            DATFIM > l_data_atual OR
           (DATFIM = l_data_atual AND HORFIM >= l_hora_atual)))
      AND  A.HORINI =
   (SELECT MAX(HORINI) FROM R070MSA
     WHERE NUMMAT = p_nummat AND
           DATINI = A.DATINI);
  EXCEPTION
    WHEN TOO_MANY_ROWS THEN
      l_errstr := 'Erro em R070MSA - TOO MANY ROWS. '||
                  'Num.Mat.: '||p_nummat;
      RAISERROR 103 l_errstr;
    WHEN NO_DATA_FOUND THEN
      l_desmsg      := '';
      l_qtdmsg      := 0;
      l_datfim      := l_data_zero;
      l_nodatafound := TRUE;
    WHEN OTHERS THEN
      l_errstr := 'Erro em R070MSA - TOO MANY ROWS. '||
                  'Num.Mat.: '||p_nummat;
      RAISERROR 103 l_errstr;
  END;

  SP_INTSTR(l_qtdmsg,'99',p_qtdmsg OUT);
  IF   (NOT(l_desmsg IS NULL))  AND (l_desmsg <> ' ') THEN
    IF  (l_nodatafound = TRUE) THEN
        l_datmsg := '      ';
    ELSE
        IF (l_datfim = l_data_zero) THEN
            l_datfim := '31/12/2050,00:00:00';
        END IF;

        SP_DATSTR(l_datfim,'DDMMYY',l_datmsg OUT);
        SP_INTSTR(l_horfim,'HHMM',l_hormsg OUT);

        l_datstr := l_datmsg||l_hormsg||'000000';
    END IF;
  ELSE
       l_datmsg := '      ';
  END IF;

  /* retira caracteres especiais da mensagem */
  SP_STRTOSTR(l_desmsg, p_desmsg OUT);

  p_datmsg := l_datstr;
END		SENIOR;21#SP_INTSTR
