TRIGGER R107ACO_EU AFTER UPDATE ON R107ACO FOR EACH ROW

BEGIN
/* Se alterou o curso, exclui os vínculos entre acompanhamento e reserva para o curso antigo */
  IF (:OLD.CODCUA <> :NEW.CODCUA) THEN
    BEGIN
      DELETE FROM R132PDA
       WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD
         AND CODPLN = :OLD.CODPLN AND CODOBJ = :OLD.CODOBJ AND CODACO = :OLD.CODACO AND SEQACO = :OLD.SEQACO;
    EXCEPTION
      WHEN OTHERS THEN
        RAISERROR 103 'Erro na exclusão dos vínculos entre acompanhamento e reserva.';
    END;
  END IF;
END␀¼Ş␀␀		SENIOR;0á␀␀TRIGGER R107ACO_ED AFTER DELETE ON R107ACO FOR EACH ROW

BEGIN
/* Exclui os vínculos entre acompanhamento e reserva */
  BEGIN
    DELETE FROM R132PDA
     WHERE NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD
       AND CODPLN = :OLD.CODPLN AND CODOBJ = :OLD.CODOBJ AND CODACO = :OLD.CODACO AND SEQACO = :OLD.SEQACO;
  EXCEPTION
    WHEN OTHERS THEN
      RAISERROR 103 'Erro na exclusão dos vínculos entre acompanhamento e reserva.';
