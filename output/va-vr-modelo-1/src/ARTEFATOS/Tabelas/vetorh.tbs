        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SINBAS', :OLD.SINBAS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPBAS', CONVERT(NUMBER_TO_CHAR, :OLD.TIPBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EVEBAS', CONVERT(NUMBER_TO_CHAR, :OLD.EVEBAS));
      END;
  END IF; 
