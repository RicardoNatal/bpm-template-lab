TRIGGER R000ASS_SI AFTER INSERT ON R000ASS

DECLARE
l_count NUMBER(2);

BEGIN
  SELECT COUNT(*) INTO l_count FROM R000ASS;
  IF l_count > 1 THEN
    RAISERROR 103 'Erro de Inclusão na tabela de Assinalamentos. Tentativa de Inserção duplicada de Registro.';
  END IF;
