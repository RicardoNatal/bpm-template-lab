TRIGGER R034LOT_EI AFTER INSERT ON R034LOT FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* GeraÃ§Ã£o de logs Lote de Colaboradores (Tabela: R034LOT)*/ 
  l_codSistema := 1;  /* CÃ³digo do sistema vetorh. */
  l_codcpa := 88;     /* Lote de Colaboradores (Tabela: R034LOT)*/
  l_codtpa := 287;
 
   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034LOT_EI', '');

      /* insere os campos chave  - Tabela R995PRC (ParÃ¢metros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODLOT', CONVERT(NUMBER_TO_CHAR, :NEW.CODLOT));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034LOT_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DESLOT', :NEW.DESLOT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR, :NEW.CODUSU));
      END;
  END IF; 
END␀œÓ␀␀		SENIOR;0i␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R034LOT_EU AFTER UPDATE ON R034LOT FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* GeraÃ§Ã£o de logs Lote de Colaboradores (Tabela: R034LOT)*/ 
  l_codSistema := 1;  /* CÃ³digo do sistema vetorh. */
  l_codcpa := 88;     /* Lote de Colaboradores (Tabela: R034LOT)*/
  l_codtpa := 288;
 
  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodLot <> :NEW.CodLot)
   OR (:OLD.DesLot <> :NEW.DesLot)
   OR (:OLD.CodUsu <> :NEW.CodUsu)) THEN

   l_temAud := FALSE;
   SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

   IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R034LOT_EU', '');

      /* insere os campos chave  - Tabela R995PRC (ParÃ¢metros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODLOT', CONVERT(NUMBER_TO_CHAR, :OLD.CODLOT));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R034LOT_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDESLOT', :OLD.DESLOT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDESLOT', :NEW.DESLOT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODUSU', CONVERT(NUMBER_TO_CHAR, :OLD.CODUSU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODUSU', CONVERT(NUMBER_TO_CHAR, :NEW.CODUSU));
      END;
    END IF; 
  END IF; 
END␀šÓ␀␀		SENIOR;0Ú␀␀ 

