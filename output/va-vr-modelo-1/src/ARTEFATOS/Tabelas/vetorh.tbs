uk␀␀PROCEDURE SP_HisAfa(P_TIPOPE CHAR,P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_DATAFA DATE,P_HORAFA NUMBER,P_DATTER DATE,P_HORTER NUMBER,P_SITAFA NUMBER,P_DATTER_OLD DATE,P_HORTER_OLD NUMBER,P_SITAFA_OLD NUMBER)
 IS

  l_data_zero    DATE;
  l_data2050     DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_bloace       CHAR(1);
  l_datst1       CHAR(6);
  l_datst2       CHAR(6);
  l_cracha       NUMBER(12);
  l_cracha_pro   NUMBER(12);
  l_datter_menor BOOLEAN;
  l_comando_nulo BOOLEAN;
  l_straux       VARCHAR2(255);
  l_codfil       NUMBER(6);
  l_codhor       NUMBER(4);
  l_horant       NUMBER(4);
  l_horbu1       NUMBER(4);
  l_horbu2       NUMBER(4);
  l_horbu3       NUMBER(4);
  l_horbu4       NUMBER(4);
  l_horbu5       NUMBER(4);
  l_horbu6       NUMBER(4);
  l_horbu7       NUMBER(4);
  l_horbu8       NUMBER(4);
  l_horbu9       NUMBER(4);
  l_horbu10      NUMBER(4);
  l_horbu11      NUMBER(4);
  l_horbu12      NUMBER(4);
  l_horbu13      NUMBER(4);
  l_horbu14      NUMBER(4);
  l_horbu15      NUMBER(4);
  l_horbu16      NUMBER(4);
  l_horbu17      NUMBER(4);
  l_horbu18      NUMBER(4);
  l_horbu19      NUMBER(4);
  l_horbu20      NUMBER(4);
  l_horbu21      NUMBER(4);
  l_horbu22      NUMBER(4);
  l_horbu23      NUMBER(4);
  l_horbu24      NUMBER(4);
  l_horbu25      NUMBER(4);
  l_horbu26      NUMBER(4);
  l_horbu27      NUMBER(4);
  l_horbu28      NUMBER(4);
  l_horbu29      NUMBER(4);
  l_horbu30      NUMBER(4);
  l_seqhba         r006hba.seqreg%TYPE;
  l_diafer       NUMBER(1);
  l_coderr       NUMBER(2);
  l_seqfai       NUMBER(2);
  l_iniace       NUMBER(5);
  l_fimace       NUMBER(5);
  l_fimjor       NUMBER;
  l_codesc         R006ESC.CodEsc%TYPE;
  l_codtur       NUMBER(1);
  l_turint       NUMBER(9);
  l_codint       NUMBER(9);
  l_tipcnv       NUMBER(1);
  l_sequencia    NUMBER;
  l_horter       NUMBER;
  l_iniafa       CHAR(16);
  l_datafa       CHAR(16);
  l_auxStr       VARCHAR2(2047);
  l_craaux       NUMBER(12);
  l_crastr       CHAR(12);
  l_horafa       CHAR(4);
  l_horfim       CHAR(4);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_TipSit       NUMBER(2);
  l_datadd       DATE;
  l_jorhor       CHAR(1);
  l_jorace       NUMBER(1);
  l_horbatini    NUMBER(5);
  l_horbatfim    NUMBER(5);
  l_tolant       NUMBER(5);
  l_tolapo       NUMBER(5);
BEGIN
  /* Inicializa */
  l_crapri := 0;
  l_data_atual := CURDATE();
  l_data_zero  := '31/12/1900,00:00:00';
  l_data2050   := '31/12/2050,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_iniafa     := '0000000000000000';
  l_datafa     := '0000000000000000';


  /* Pega o codigo do horario */
  RH_RetHor (p_numemp, p_tipcol, p_numcad, l_data_atual, 1,
             l_codhor OUT, l_horbu1 OUT, l_horbu2 OUT, l_horbu3 OUT,
             l_horbu4 OUT, l_horbu5 OUT, l_codesc OUT, l_codtur OUT,
             l_turint OUT, l_codint OUT, l_diafer OUT, l_tipcnv OUT,
             l_coderr OUT, l_seqhba OUT);

  RH_RETHOROPC (l_codesc, l_seqhba, l_horbu1 OUT, l_horbu2 OUT, l_horbu3 OUT, l_horbu4 OUT, l_horbu5 OUT, l_horbu6 OUT,
                l_horbu7 OUT, l_horbu8 OUT, l_horbu9 OUT, l_horbu10 OUT, l_horbu11 OUT, l_horbu12 OUT, l_horbu13 OUT, l_horbu14 OUT,
                l_horbu15 OUT, l_horbu16 OUT, l_horbu17 OUT, l_horbu18 OUT, l_horbu19 OUT, l_horbu20 OUT, l_horbu21 OUT, l_horbu22 OUT,
                l_horbu23 OUT, l_horbu24 OUT, l_horbu25 OUT, l_horbu26 OUT, l_horbu27 OUT, l_horbu28 OUT, l_horbu29 OUT, l_horbu30 OUT );

  IF   (l_diafer = 1) THEN
      l_codhor := 9997;
  END IF;

  /* se hora inicial e final for zerada, significa o dia todo */
  IF  (p_horafa = 0) AND (p_horter = 0) THEN
      l_horter := 1439;
  ELSE
      l_horter := p_horter;
  END IF;

  /* Verifica Se Alterou Data/Hora Termino Afastamento */
  IF    p_tipope = 'U' AND (p_datter_old = l_data_zero OR p_datter_old > l_data_atual OR (p_datter_old = l_data_atual AND p_horter_old >= l_hora_atual)) THEN
        l_datter_menor := TRUE;
  ELSIF (p_tipope = 'D') OR (p_datter = l_data_zero OR p_datter > l_data_atual OR (p_datter = l_data_atual AND l_horter >= l_hora_atual)) THEN
        l_datter_menor := TRUE;
  ELSE  l_datter_menor := FALSE;
  END IF;

  /* Valida Periodo do Afastamento */
  IF   (p_datafa < l_data_atual OR (p_datafa = l_data_atual AND p_horafa <= l_hora_atual)) AND
       (l_datter_menor = TRUE) THEN

       /* Verifica Situacao Bloqueio */
       l_bloace:='';
       BEGIN
           SELECT BLOACE, TIPSIT INTO l_bloace, l_TipSit FROM R010SIT WHERE R010SIT.CODSIT = p_sitafa;
       EXCEPTION
           WHEN NO_DATA_FOUND THEN l_comando_nulo := TRUE;
           WHEN OTHERS        THEN RAISERROR 103 'ERRO NO SELECT EM R010SIT.';
       END;

       /* Pega o codigo da filial */
       BEGIN
        SELECT HFI.CODFIL INTO l_codfil FROM R038HFI HFI WHERE
               HFI.NUMEMP = p_numemp AND HFI.TIPCOL = p_tipcol AND HFI.NUMCAD = p_numcad AND
               HFI.DATALT = (SELECT MAX(HFI2.DATALT) FROM R038HFI HFI2
                               WHERE HFI2.NUMEMP = p_numemp AND HFI2.TIPCOL = p_tipcol AND HFI2.NUMCAD = p_numcad AND HFI2.DATALT <= CURDATE());
       EXCEPTION
           WHEN OTHERS THEN l_codfil := 0;
       END;

       /* Verifica ultimo turno para afastamento (final jornada = maior horario do 3º turno).*/
       BEGIN
           SELECT FHF.INIACE, FHF.FIMACE INTO l_iniace, l_fimace FROM R004FHF FHF
           WHERE FHF.NUMEMP = p_numemp AND FHF.CODFIL = l_codfil AND
                 (FHF.CODHOR = l_codhor OR FHF.CODHOR = l_horbu1 OR FHF.CODHOR = l_horbu2 OR FHF.CODHOR = l_horbu3 OR
                  FHF.CODHOR = l_horbu4 OR FHF.CODHOR = l_horbu5 OR FHF.CODHOR = l_horbu6 OR FHF.CODHOR = l_horbu7 OR
				  FHF.CODHOR = l_horbu8 OR FHF.CODHOR = l_horbu9 OR FHF.CODHOR = l_horbu10 OR FHF.CODHOR = l_horbu11 OR
				  FHF.CODHOR = l_horbu12 OR FHF.CODHOR = l_horbu13 OR FHF.CODHOR = l_horbu14 OR FHF.CODHOR = l_horbu15 OR
				  FHF.CODHOR = l_horbu16 OR FHF.CODHOR = l_horbu17 OR FHF.CODHOR = l_horbu18 OR FHF.CODHOR = l_horbu19 OR
				  FHF.CODHOR = l_horbu20 OR FHF.CODHOR = l_horbu21 OR FHF.CODHOR = l_horbu22 OR FHF.CODHOR = l_horbu23 OR
				  FHF.CODHOR = l_horbu24 OR FHF.CODHOR = l_horbu25 OR FHF.CODHOR = l_horbu26 OR FHF.CODHOR = l_horbu27 OR
				  FHF.CODHOR = l_horbu28 OR FHF.CODHOR = l_horbu29 OR FHF.CODHOR = l_horbu30) AND (FHF.SEQFAI = 1);
       EXCEPTION
           WHEN OTHERS THEN
               l_iniace := 0;
               l_fimace := 0;
       END;

       IF (l_iniace = 0 AND l_fimace = 0) THEN
	       /* Verifica primeira faixa de acesso.*/
	       BEGIN
	           SELECT INIACE INTO l_iniace FROM R004FHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND (SEQFAI = 1) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_iniace := 0;
	       END;

	      /* Verifica ultima faixa de acesso  (final jornada = maior horario do 3Âº turno).*/
	       BEGIN
	           SELECT SEQFAI, FIMACE INTO l_seqfai, l_fimace FROM R004FHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND SEQFAI = (SELECT MAX(SEQFAI) FROM R004FHR
					 																				WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
																						                   CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
																										   CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
																										   CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
																										   CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
																										   CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
																										   CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
																										   CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30)) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_fimace := 0;
	       END;
       END IF;

       /* Verifica tipo de  turno.*/
       BEGIN
           SELECT JORHOR, JORACE INTO l_jorhor, l_jorace FROM R004HOR
           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
				  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
				  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
				  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
				  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
				  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
				  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30);
       EXCEPTION WHEN OTHERS THEN
           l_jorhor := 'E';
           l_jorace := 0;
       END;

       l_horafa := '0000';
       IF  (l_iniace > l_fimace) AND (l_fimace > 0) THEN
           l_fimjor := l_fimace;
           SP_INTSTR(l_fimace,'HHMM',l_horafa OUT);
           
       /* Verifica o 3º turno pelo parâmetro "inicia e finaliza em dias distintos", para pegar os casos de clientes que não utilizam faixas de acesso */
       ELSIF (l_jorace = 1) THEN
           /* Verifica primeira faixa de marcação.*/
	       BEGIN
	           SELECT HORBAT, TOLANT INTO l_horbatini, l_tolant FROM R004MHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND (SEQMAR = 1) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_horbatini := 0;
	           l_tolant := 0;
	       END;

	       /* Verifica ultima faixa de marcação.*/
	       BEGIN
	           SELECT HORBAT, TOLAPO INTO l_horbatfim, l_tolapo FROM R004MHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND SEQMAR = (SELECT MAX(SEQMAR) FROM R004MHR
					 																				WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
																						                   CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
																										   CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
																										   CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
																										   CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
																										   CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
																										   CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
																										   CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30)) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_horbatfim := 0;
	           l_tolapo := 0;
	       END;
       
           IF (l_tolant > 0) THEN
               l_iniace := l_tolant;
           ELSE
               l_iniace := l_horbatini;
           END IF;
           
           IF (l_tolapo > 0) THEN
               l_fimace := l_tolapo;
           ELSE
               l_fimace := l_horbatfim;
           END IF;
           
           /* Inclui uma hora de tolerância, quando possível. Se o horário de entrada/saída for inferior 
            * a 60 minutos do dia anterior/dia seguinte, coloca o primeiro/último horário do dia */ 
           IF ((l_iniace > 0) AND (l_iniace < 61)) THEN
               l_iniace := 1;
           ELSE
               l_iniace := l_iniace - 60;
           END IF;
           
           IF (l_fimace > 1379) THEN
               l_fimace := 1439;
           ELSE
               l_fimace := l_fimace + 60;
           END IF;

           l_fimjor := l_fimace;
           SP_INTSTR(l_fimace,'HHMM',l_horafa OUT);
                  
       ELSE
           l_fimjor := 0;
       END IF;

       IF   (l_bloace = 'S') THEN
            SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
            IF   (l_cracha = 0)  THEN
                  SP_RETCRA_IDTPES (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
            END IF;

            IF  l_cracha > 0 THEN
                 /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                 SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                 IF (l_crapri = 0) THEN
                     l_crapri := l_cracha;
                 END IF;

	               /* coloca zeros a esquerda do numero */
                 /* Na Exclusao do Afastamento Zeras Datas */

                 IF   p_tipope = 'D' THEN
                      l_datst1 := '      ';
                      l_datst2 := '      ';
                      l_iniafa := '0000000000000000';
                      l_datafa := '0000000000000000';
                 ELSE
                      l_datst1 := '      ';
                      SP_INTSTR(p_horter,'HHMM',l_horfim OUT);

                      IF  p_horafa = 0 THEN
                          IF  ((p_datafa < l_data_atual) OR
                              ((p_datafa = l_data_atual) AND (l_hora_atual > l_fimjor)) OR
                              ((p_datafa = l_data_atual) AND (l_hora_atual = 0) AND (l_fimjor = 0)) OR
                              ((p_datafa = l_data_atual) AND (l_iniace > l_fimace))) THEN
                              SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                          END IF;
                      ELSE
                          IF  (p_datafa < l_data_atual) OR ((p_datafa = l_data_atual) AND (l_hora_atual >= p_horafa)) THEN
                              SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                          END IF;
                      END IF;

                      IF  (l_datst1 = '      ') THEN
                          l_datst2 := '      ';
                          l_iniafa := '0000000000000000';
                          l_datafa := '0000000000000000';
                      ELSE
                          IF  (p_datter <> l_data_zero) THEN
                              /* Se tiver terceiro turno, l_horafa esta preenchida */
                              IF l_horafa = '0000' THEN
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_INTSTR(p_horafa,'HHMM',l_horafa OUT);
                                  SP_DATSTR(p_datter,'DDMMYY',l_datst2 OUT);

                                  IF (l_horfim = '0000') THEN
                                  	l_horfim := '2359';
                              	  END IF;
                              ELSE
                                  /* 3Âº turno */
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_DATSTR(p_datter,'DDMMYY',l_datst2 OUT);

                                  IF (l_horfim = '0000') THEN
                                      l_horfim := '2359';
                                  END IF;

                                  /*Se o afastamento tem o inicio e fim iguais e hora inicio e fim zeradas, vai olhar a jornada e calcular o afastmento*/
                                  IF ( (p_horafa = 0) AND (p_horter = 0) ) THEN
                                      /* Entrada */
                                      IF (l_jorHor = 'E') THEN
                                          SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);

                                          l_datadd := DATETIMEADD(DD, 1, p_datter);
                                          SP_DATSTR(l_datadd,'DDMMYY',l_datst2 OUT);
                                      END IF;
                                      /* Saida */
                                      IF (l_jorHor = 'S') THEN
                                          SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);

						                  l_datadd := DATETIMEADD(DD, -1, p_datter);
                                          SP_DATSTR(l_datadd,'DDMMYY',l_datst2 OUT);
                                          /* se a data calculada de saída de acordo com a jornada for menor que a atual, significa que o afastamento já acabou */
                                          IF (l_datadd < l_data_atual) THEN
                                              l_datst1 := '000000';
                                              l_datst2 := '000000';
                                              l_horafa := '0000';
                                              l_horfim := '0000';
                                          END IF;
                                      END IF;
                                  END IF;
                              END IF;

                              /*Variaveis R070CON*/
                              l_iniafa := l_datst1||l_horafa||'000000';

                          ELSE
                              /*Data Final Zerada*/
                              l_datst2 := '311250';
							  l_horfim := '2359';

                              /*Variaveis R070CON*/
                              l_datafa := '3112502359000000';

                              /*Formata o Inicio do Afastamento*/
                              IF l_horafa = '0000' THEN
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_INTSTR(p_horafa,'HHMM',l_horafa OUT);
                              ELSE
                                  /* Se tiver 3º turno, acrescenta um dia na DatAfa e hora final eh igual a hora final do 3º turno */
                                  l_datadd := DATETIMEADD(DD, 1, p_datafa);
                                  SP_DATSTR(l_datadd,'DDMMYY',l_datst1 OUT);
                              END IF;
                              l_iniafa := l_datst1||l_horafa||'000000';
                          END IF;
                      END IF;
                 END IF;

                 /* se a data form maior que 2050, joga o limite de 2050 para que a CSM entenda que eh data em aberto */
                 IF  (p_datter > l_data2050)  THEN
                     l_datst2 := '311250';
                     l_datafa := '3112502359000000';
                 ELSE
		            l_datafa := l_datst2||l_horfim||'000000';
                    IF (p_tipope = 'D') THEN
                         l_datafa := '0000000000000000';
                     END IF;
                 END IF;

                 /* Atualiza Controle  */
                 IF  (l_TipSit <> 7) THEN
                     /* atualiza r070con */
                     LOOP
                         BEGIN
                              UPDATE R070CON SET INIAFA=l_iniafa, DATAFA=l_datafa WHERE (NUMFIS = l_crapri) OR (NUMFIS = l_numbar) OR (NUMFIS = l_numpro) OR (NUMFIS = l_numsma);
                         EXCEPTION
                              WHEN OTHERS THEN NULL;
                         END;

                         /*Controle do Looping, onde deve ser efetuado o update no cracha provisorio caso o mesmo exista.*/
                         SP_RETCRA_IDTPES (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                         IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) THEN
                           EXIT;
                         ELSE
                            l_cracha := l_cracha_pro;
                            /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                            SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                            IF (l_crapri = 0) THEN
                                l_crapri := l_cracha;
                            END IF;
                         END IF;
                     END LOOP;
                 END IF;
            END IF;
       ELSE /* Verifica se Alterou tipo Situacao Afastamento */
            IF   (p_tipope = 'U') AND (p_sitafa_old <> p_sitafa) THEN
                 BEGIN
                     SELECT BLOACE INTO l_bloace FROM R010SIT WHERE R010SIT.CODSIT = p_sitafa_old;
                 EXCEPTION WHEN OTHERS THEN
                     RAISERROR 103 'ON-Line: Erro no SELECT em R010SIT.';
                 END;
                 IF   l_bloace = 'S' THEN
                      /* Verifica se Colaborador possui Cracha */
                      SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
                      IF   l_cracha > 0 THEN
                           /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                           SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                           IF (l_crapri = 0) THEN
                               l_crapri := l_cracha;
                           END IF;
                           /* atualiza r070con */
                           l_iniafa := '0000000000000000';
                           l_datafa := '0000000000000000';

                           LOOP
                               BEGIN
                                   /* Atualiza todos os numeros fisicos por causa da sincronia de lista */
                                   UPDATE R070CON SET INIAFA=l_iniafa, DATAFA=l_datafa WHERE (NUMFIS = l_crapri) OR (NUMFIS = l_numbar) OR (NUMFIS = l_numpro) OR (NUMFIS = l_numsma);
                               EXCEPTION
                                   WHEN OTHERS THEN RAISERROR 103 'SPHisAFa - Erro no update r070con.';
                               END;
                               /* Controle do Looping, onde deve ser efetuado o update no cracha provisorio caso o mesmo exista.*/
                               SP_RETCRA_IDTPES (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                               IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) THEN
                                 EXIT;
                               ELSE
                                  l_cracha := l_cracha_pro;
                                  /* Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                                  SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                                  IF (l_crapri = 0) THEN
                                      l_crapri := l_cracha;
                                  END IF;
                               END IF;
                           END LOOP;
                      END IF;
                 END IF;
            END IF;
       END IF;
      IF (l_crapri = 0) THEN
          /* Verifica se Colaborador possui Cracha */
          SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
          IF   l_cracha > 0 THEN
               /* Atualiza o Cracha¡ Principal e obtem o(s) numero(s) fisico(s). */
               SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
               IF (l_crapri = 0) THEN
                   l_crapri := l_cracha;
               END IF;
          END IF;
      END IF;
      IF (l_crapri <> 0) THEN
          /*Obtem o Tipo de Pessoa*/
          SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
          SP_INTSTR(p_numemp,'9999',l_numemp OUT);
          SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
          SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
          l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
          /*Preenche o campo com espacos para completar 23 posicoes*/
          l_idtpes := lTrim(l_idtpes);
          l_idtpes := rTrim(l_idtpes);
          LOOP
              /*Controle do Loop.*/
              IF (Length(l_idtpes) > 22) THEN
                  EXIT;
              END IF;
              l_idtpes := ' '||l_idtpes;
          END LOOP;
          /*Procedure que atualiza a controle*/
          SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
      END IF;
  END IF;
END		SENIOR;21WRH_RETHOR
RH_RETHOROPC
SP_INTSTR
SP_RETCRA_IDTPES
SP_MAPFIS
SP_DATSTR
SP_ATUTSI
uk␀␀PROCEDURE SP_HisAfa(P_TIPOPE CHAR,P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_DATAFA DATE,P_HORAFA NUMBER,P_DATTER DATE,P_HORTER NUMBER,P_SITAFA NUMBER,P_DATTER_OLD DATE,P_HORTER_OLD NUMBER,P_SITAFA_OLD NUMBER)
 IS

  l_data_zero    DATE;
  l_data2050     DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_bloace       CHAR(1);
  l_datst1       CHAR(6);
  l_datst2       CHAR(6);
  l_cracha       NUMBER(12);
  l_cracha_pro   NUMBER(12);
  l_datter_menor BOOLEAN;
  l_comando_nulo BOOLEAN;
  l_straux       VARCHAR2(255);
  l_codfil       NUMBER(6);
  l_codhor       NUMBER(4);
  l_horant       NUMBER(4);
  l_horbu1       NUMBER(4);
  l_horbu2       NUMBER(4);
  l_horbu3       NUMBER(4);
  l_horbu4       NUMBER(4);
  l_horbu5       NUMBER(4);
  l_horbu6       NUMBER(4);
  l_horbu7       NUMBER(4);
  l_horbu8       NUMBER(4);
  l_horbu9       NUMBER(4);
  l_horbu10      NUMBER(4);
  l_horbu11      NUMBER(4);
  l_horbu12      NUMBER(4);
  l_horbu13      NUMBER(4);
  l_horbu14      NUMBER(4);
  l_horbu15      NUMBER(4);
  l_horbu16      NUMBER(4);
  l_horbu17      NUMBER(4);
  l_horbu18      NUMBER(4);
  l_horbu19      NUMBER(4);
  l_horbu20      NUMBER(4);
  l_horbu21      NUMBER(4);
  l_horbu22      NUMBER(4);
  l_horbu23      NUMBER(4);
  l_horbu24      NUMBER(4);
  l_horbu25      NUMBER(4);
  l_horbu26      NUMBER(4);
  l_horbu27      NUMBER(4);
  l_horbu28      NUMBER(4);
  l_horbu29      NUMBER(4);
  l_horbu30      NUMBER(4);
  l_seqhba         r006hba.seqreg%TYPE;
  l_diafer       NUMBER(1);
  l_coderr       NUMBER(2);
  l_seqfai       NUMBER(2);
  l_iniace       NUMBER(5);
  l_fimace       NUMBER(5);
  l_fimjor       NUMBER;
  l_codesc         R006ESC.CodEsc%TYPE;
  l_codtur       NUMBER(1);
  l_turint       NUMBER(9);
  l_codint       NUMBER(9);
  l_tipcnv       NUMBER(1);
  l_sequencia    NUMBER;
  l_horter       NUMBER;
  l_iniafa       CHAR(16);
  l_datafa       CHAR(16);
  l_auxStr       VARCHAR2(2047);
  l_craaux       NUMBER(12);
  l_crastr       CHAR(12);
  l_horafa       CHAR(4);
  l_horfim       CHAR(4);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_TipSit       NUMBER(2);
  l_datadd       DATE;
  l_jorhor       CHAR(1);
  l_jorace       NUMBER(1);
  l_horbatini    NUMBER(5);
  l_horbatfim    NUMBER(5);
  l_tolant       NUMBER(5);
  l_tolapo       NUMBER(5);
BEGIN
  /* Inicializa */
  l_crapri := 0;
  l_data_atual := CURDATE();
  l_data_zero  := '31/12/1900,00:00:00';
  l_data2050   := '31/12/2050,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_iniafa     := '0000000000000000';
  l_datafa     := '0000000000000000';


  /* Pega o codigo do horario */
  RH_RetHor (p_numemp, p_tipcol, p_numcad, l_data_atual, 1,
             l_codhor OUT, l_horbu1 OUT, l_horbu2 OUT, l_horbu3 OUT,
             l_horbu4 OUT, l_horbu5 OUT, l_codesc OUT, l_codtur OUT,
             l_turint OUT, l_codint OUT, l_diafer OUT, l_tipcnv OUT,
             l_coderr OUT, l_seqhba OUT);

  RH_RETHOROPC (l_codesc, l_seqhba, l_horbu1 OUT, l_horbu2 OUT, l_horbu3 OUT, l_horbu4 OUT, l_horbu5 OUT, l_horbu6 OUT,
                l_horbu7 OUT, l_horbu8 OUT, l_horbu9 OUT, l_horbu10 OUT, l_horbu11 OUT, l_horbu12 OUT, l_horbu13 OUT, l_horbu14 OUT,
                l_horbu15 OUT, l_horbu16 OUT, l_horbu17 OUT, l_horbu18 OUT, l_horbu19 OUT, l_horbu20 OUT, l_horbu21 OUT, l_horbu22 OUT,
                l_horbu23 OUT, l_horbu24 OUT, l_horbu25 OUT, l_horbu26 OUT, l_horbu27 OUT, l_horbu28 OUT, l_horbu29 OUT, l_horbu30 OUT );

  IF   (l_diafer = 1) THEN
      l_codhor := 9997;
  END IF;

  /* se hora inicial e final for zerada, significa o dia todo */
  IF  (p_horafa = 0) AND (p_horter = 0) THEN
      l_horter := 1439;
  ELSE
      l_horter := p_horter;
  END IF;

  /* Verifica Se Alterou Data/Hora Termino Afastamento */
  IF    p_tipope = 'U' AND (p_datter_old = l_data_zero OR p_datter_old > l_data_atual OR (p_datter_old = l_data_atual AND p_horter_old >= l_hora_atual)) THEN
        l_datter_menor := TRUE;
  ELSIF (p_tipope = 'D') OR (p_datter = l_data_zero OR p_datter > l_data_atual OR (p_datter = l_data_atual AND l_horter >= l_hora_atual)) THEN
        l_datter_menor := TRUE;
  ELSE  l_datter_menor := FALSE;
  END IF;

  /* Valida Periodo do Afastamento */
  IF   (p_datafa < l_data_atual OR (p_datafa = l_data_atual AND p_horafa <= l_hora_atual)) AND
       (l_datter_menor = TRUE) THEN

       /* Verifica Situacao Bloqueio */
       l_bloace:='';
       BEGIN
           SELECT BLOACE, TIPSIT INTO l_bloace, l_TipSit FROM R010SIT WHERE R010SIT.CODSIT = p_sitafa;
       EXCEPTION
           WHEN NO_DATA_FOUND THEN l_comando_nulo := TRUE;
           WHEN OTHERS        THEN RAISERROR 103 'ERRO NO SELECT EM R010SIT.';
       END;

       /* Pega o codigo da filial */
       BEGIN
        SELECT HFI.CODFIL INTO l_codfil FROM R038HFI HFI WHERE
               HFI.NUMEMP = p_numemp AND HFI.TIPCOL = p_tipcol AND HFI.NUMCAD = p_numcad AND
               HFI.DATALT = (SELECT MAX(HFI2.DATALT) FROM R038HFI HFI2
                               WHERE HFI2.NUMEMP = p_numemp AND HFI2.TIPCOL = p_tipcol AND HFI2.NUMCAD = p_numcad AND HFI2.DATALT <= CURDATE());
       EXCEPTION
           WHEN OTHERS THEN l_codfil := 0;
       END;

       /* Verifica ultimo turno para afastamento (final jornada = maior horario do 3º turno).*/
       BEGIN
           SELECT FHF.INIACE, FHF.FIMACE INTO l_iniace, l_fimace FROM R004FHF FHF
           WHERE FHF.NUMEMP = p_numemp AND FHF.CODFIL = l_codfil AND
                 (FHF.CODHOR = l_codhor OR FHF.CODHOR = l_horbu1 OR FHF.CODHOR = l_horbu2 OR FHF.CODHOR = l_horbu3 OR
                  FHF.CODHOR = l_horbu4 OR FHF.CODHOR = l_horbu5 OR FHF.CODHOR = l_horbu6 OR FHF.CODHOR = l_horbu7 OR
				  FHF.CODHOR = l_horbu8 OR FHF.CODHOR = l_horbu9 OR FHF.CODHOR = l_horbu10 OR FHF.CODHOR = l_horbu11 OR
				  FHF.CODHOR = l_horbu12 OR FHF.CODHOR = l_horbu13 OR FHF.CODHOR = l_horbu14 OR FHF.CODHOR = l_horbu15 OR
				  FHF.CODHOR = l_horbu16 OR FHF.CODHOR = l_horbu17 OR FHF.CODHOR = l_horbu18 OR FHF.CODHOR = l_horbu19 OR
				  FHF.CODHOR = l_horbu20 OR FHF.CODHOR = l_horbu21 OR FHF.CODHOR = l_horbu22 OR FHF.CODHOR = l_horbu23 OR
				  FHF.CODHOR = l_horbu24 OR FHF.CODHOR = l_horbu25 OR FHF.CODHOR = l_horbu26 OR FHF.CODHOR = l_horbu27 OR
				  FHF.CODHOR = l_horbu28 OR FHF.CODHOR = l_horbu29 OR FHF.CODHOR = l_horbu30) AND (FHF.SEQFAI = 1);
       EXCEPTION
           WHEN OTHERS THEN
               l_iniace := 0;
               l_fimace := 0;
       END;

       IF (l_iniace = 0 AND l_fimace = 0) THEN
	       /* Verifica primeira faixa de acesso.*/
	       BEGIN
	           SELECT INIACE INTO l_iniace FROM R004FHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND (SEQFAI = 1) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_iniace := 0;
	       END;

	      /* Verifica ultima faixa de acesso  (final jornada = maior horario do 3Âº turno).*/
	       BEGIN
	           SELECT SEQFAI, FIMACE INTO l_seqfai, l_fimace FROM R004FHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND SEQFAI = (SELECT MAX(SEQFAI) FROM R004FHR
					 																				WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
																						                   CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
																										   CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
																										   CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
																										   CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
																										   CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
																										   CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
																										   CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30)) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_fimace := 0;
	       END;
       END IF;

       /* Verifica tipo de  turno.*/
       BEGIN
           SELECT JORHOR, JORACE INTO l_jorhor, l_jorace FROM R004HOR
           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
				  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
				  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
				  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
				  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
				  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
				  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30);
       EXCEPTION WHEN OTHERS THEN
           l_jorhor := 'E';
           l_jorace := 0;
       END;

       l_horafa := '0000';
       IF  (l_iniace > l_fimace) AND (l_fimace > 0) THEN
           l_fimjor := l_fimace;
           SP_INTSTR(l_fimace,'HHMM',l_horafa OUT);
           
       /* Verifica o 3º turno pelo parâmetro "inicia e finaliza em dias distintos", para pegar os casos de clientes que não utilizam faixas de acesso */
       ELSIF (l_jorace = 1) THEN
           /* Verifica primeira faixa de marcação.*/
	       BEGIN
	           SELECT HORBAT, TOLANT INTO l_horbatini, l_tolant FROM R004MHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND (SEQMAR = 1) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_horbatini := 0;
	           l_tolant := 0;
	       END;

	       /* Verifica ultima faixa de marcação.*/
	       BEGIN
	           SELECT HORBAT, TOLAPO INTO l_horbatfim, l_tolapo FROM R004MHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND SEQMAR = (SELECT MAX(SEQMAR) FROM R004MHR
					 																				WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
																						                   CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
																										   CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
																										   CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
																										   CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
																										   CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
																										   CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
																										   CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30)) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_horbatfim := 0;
	           l_tolapo := 0;
	       END;
       
           IF (l_tolant > 0) THEN
               l_iniace := l_tolant;
           ELSE
               l_iniace := l_horbatini;
           END IF;
           
           IF (l_tolapo > 0) THEN
               l_fimace := l_tolapo;
           ELSE
               l_fimace := l_horbatfim;
           END IF;
           
           /* Inclui uma hora de tolerância, quando possível. Se o horário de entrada/saída for inferior 
            * a 60 minutos do dia anterior/dia seguinte, coloca o primeiro/último horário do dia */ 
           IF ((l_iniace > 0) AND (l_iniace < 61)) THEN
               l_iniace := 1;
           ELSE
               l_iniace := l_iniace - 60;
           END IF;
           
           IF (l_fimace > 1379) THEN
               l_fimace := 1439;
           ELSE
               l_fimace := l_fimace + 60;
           END IF;

           l_fimjor := l_fimace;
           SP_INTSTR(l_fimace,'HHMM',l_horafa OUT);
                  
       ELSE
           l_fimjor := 0;
       END IF;

       IF   (l_bloace = 'S') THEN
            SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
            IF   (l_cracha = 0)  THEN
                  SP_RETCRA_IDTPES (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
            END IF;

            IF  l_cracha > 0 THEN
                 /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                 SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                 IF (l_crapri = 0) THEN
                     l_crapri := l_cracha;
                 END IF;

	               /* coloca zeros a esquerda do numero */
                 /* Na Exclusao do Afastamento Zeras Datas */

                 IF   p_tipope = 'D' THEN
                      l_datst1 := '      ';
                      l_datst2 := '      ';
                      l_iniafa := '0000000000000000';
                      l_datafa := '0000000000000000';
                 ELSE
                      l_datst1 := '      ';
                      SP_INTSTR(p_horter,'HHMM',l_horfim OUT);

                      IF  p_horafa = 0 THEN
                          IF  ((p_datafa < l_data_atual) OR
                              ((p_datafa = l_data_atual) AND (l_hora_atual > l_fimjor)) OR
                              ((p_datafa = l_data_atual) AND (l_hora_atual = 0) AND (l_fimjor = 0)) OR
                              ((p_datafa = l_data_atual) AND (l_iniace > l_fimace))) THEN
                              SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                          END IF;
                      ELSE
                          IF  (p_datafa < l_data_atual) OR ((p_datafa = l_data_atual) AND (l_hora_atual >= p_horafa)) THEN
                              SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                          END IF;
                      END IF;

                      IF  (l_datst1 = '      ') THEN
                          l_datst2 := '      ';
                          l_iniafa := '0000000000000000';
                          l_datafa := '0000000000000000';
                      ELSE
                          IF  (p_datter <> l_data_zero) THEN
                              /* Se tiver terceiro turno, l_horafa esta preenchida */
                              IF l_horafa = '0000' THEN
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_INTSTR(p_horafa,'HHMM',l_horafa OUT);
                                  SP_DATSTR(p_datter,'DDMMYY',l_datst2 OUT);

                                  IF (l_horfim = '0000') THEN
                                  	l_horfim := '2359';
                              	  END IF;
                              ELSE
                                  /* 3Âº turno */
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_DATSTR(p_datter,'DDMMYY',l_datst2 OUT);

                                  IF (l_horfim = '0000') THEN
                                      l_horfim := '2359';
                                  END IF;

                                  /*Se o afastamento tem o inicio e fim iguais e hora inicio e fim zeradas, vai olhar a jornada e calcular o afastmento*/
                                  IF ( (p_horafa = 0) AND (p_horter = 0) ) THEN
                                      /* Entrada */
                                      IF (l_jorHor = 'E') THEN
                                          SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);

                                          l_datadd := DATETIMEADD(DD, 1, p_datter);
                                          SP_DATSTR(l_datadd,'DDMMYY',l_datst2 OUT);
                                      END IF;
                                      /* Saida */
                                      IF (l_jorHor = 'S') THEN
                                          SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);

						                  l_datadd := DATETIMEADD(DD, -1, p_datter);
                                          SP_DATSTR(l_datadd,'DDMMYY',l_datst2 OUT);
                                          /* se a data calculada de saída de acordo com a jornada for menor que a atual, significa que o afastamento já acabou */
                                          IF (l_datadd < l_data_atual) THEN
                                              l_datst1 := '000000';
                                              l_datst2 := '000000';
                                              l_horafa := '0000';
                                              l_horfim := '0000';
                                          END IF;
                                      END IF;
                                  END IF;
                              END IF;

                              /*Variaveis R070CON*/
                              l_iniafa := l_datst1||l_horafa||'000000';

                          ELSE
                              /*Data Final Zerada*/
                              l_datst2 := '311250';
							  l_horfim := '2359';

                              /*Variaveis R070CON*/
                              l_datafa := '3112502359000000';

                              /*Formata o Inicio do Afastamento*/
                              IF l_horafa = '0000' THEN
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_INTSTR(p_horafa,'HHMM',l_horafa OUT);
                              ELSE
                                  /* Se tiver 3º turno, acrescenta um dia na DatAfa e hora final eh igual a hora final do 3º turno */
                                  l_datadd := DATETIMEADD(DD, 1, p_datafa);
                                  SP_DATSTR(l_datadd,'DDMMYY',l_datst1 OUT);
                              END IF;
                              l_iniafa := l_datst1||l_horafa||'000000';
                          END IF;
                      END IF;
                 END IF;

                 /* se a data form maior que 2050, joga o limite de 2050 para que a CSM entenda que eh data em aberto */
                 IF  (p_datter > l_data2050)  THEN
                     l_datst2 := '311250';
                     l_datafa := '3112502359000000';
                 ELSE
		            l_datafa := l_datst2||l_horfim||'000000';
                    IF (p_tipope = 'D') THEN
                         l_datafa := '0000000000000000';
                     END IF;
                 END IF;

                 /* Atualiza Controle  */
                 IF  (l_TipSit <> 7) THEN
                     /* atualiza r070con */
                     LOOP
                         BEGIN
                              UPDATE R070CON SET INIAFA=l_iniafa, DATAFA=l_datafa WHERE (NUMFIS = l_crapri) OR (NUMFIS = l_numbar) OR (NUMFIS = l_numpro) OR (NUMFIS = l_numsma);
                         EXCEPTION
                              WHEN OTHERS THEN NULL;
                         END;

                         /*Controle do Looping, onde deve ser efetuado o update no cracha provisorio caso o mesmo exista.*/
                         SP_RETCRA_IDTPES (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                         IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) THEN
                           EXIT;
                         ELSE
                            l_cracha := l_cracha_pro;
                            /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                            SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                            IF (l_crapri = 0) THEN
                                l_crapri := l_cracha;
                            END IF;
                         END IF;
                     END LOOP;
                 END IF;
            END IF;
       ELSE /* Verifica se Alterou tipo Situacao Afastamento */
            IF   (p_tipope = 'U') AND (p_sitafa_old <> p_sitafa) THEN
                 BEGIN
                     SELECT BLOACE INTO l_bloace FROM R010SIT WHERE R010SIT.CODSIT = p_sitafa_old;
                 EXCEPTION WHEN OTHERS THEN
                     RAISERROR 103 'ON-Line: Erro no SELECT em R010SIT.';
                 END;
                 IF   l_bloace = 'S' THEN
                      /* Verifica se Colaborador possui Cracha */
                      SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
                      IF   l_cracha > 0 THEN
                           /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                           SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                           IF (l_crapri = 0) THEN
                               l_crapri := l_cracha;
                           END IF;
                           /* atualiza r070con */
                           l_iniafa := '0000000000000000';
                           l_datafa := '0000000000000000';

                           LOOP
                               BEGIN
                                   /* Atualiza todos os numeros fisicos por causa da sincronia de lista */
                                   UPDATE R070CON SET INIAFA=l_iniafa, DATAFA=l_datafa WHERE (NUMFIS = l_crapri) OR (NUMFIS = l_numbar) OR (NUMFIS = l_numpro) OR (NUMFIS = l_numsma);
                               EXCEPTION
                                   WHEN OTHERS THEN RAISERROR 103 'SPHisAFa - Erro no update r070con.';
                               END;
                               /* Controle do Looping, onde deve ser efetuado o update no cracha provisorio caso o mesmo exista.*/
                               SP_RETCRA_IDTPES (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                               IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) THEN
                                 EXIT;
                               ELSE
                                  l_cracha := l_cracha_pro;
                                  /* Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                                  SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                                  IF (l_crapri = 0) THEN
                                      l_crapri := l_cracha;
                                  END IF;
                               END IF;
                           END LOOP;
                      END IF;
                 END IF;
            END IF;
       END IF;
      IF (l_crapri = 0) THEN
          /* Verifica se Colaborador possui Cracha */
          SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
          IF   l_cracha > 0 THEN
               /* Atualiza o Cracha¡ Principal e obtem o(s) numero(s) fisico(s). */
               SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
               IF (l_crapri = 0) THEN
                   l_crapri := l_cracha;
               END IF;
          END IF;
      END IF;
      IF (l_crapri <> 0) THEN
          /*Obtem o Tipo de Pessoa*/
          SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
          SP_INTSTR(p_numemp,'9999',l_numemp OUT);
          SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
          SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
          l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
          /*Preenche o campo com espacos para completar 23 posicoes*/
          l_idtpes := lTrim(l_idtpes);
          l_idtpes := rTrim(l_idtpes);
          LOOP
              /*Controle do Loop.*/
              IF (Length(l_idtpes) > 22) THEN
                  EXIT;
              END IF;
              l_idtpes := ' '||l_idtpes;
          END LOOP;
          /*Procedure que atualiza a controle*/
          SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
      END IF;
  END IF;
END		SENIOR;22WRH_RETHOR
RH_RETHOROPC
SP_INTSTR
SP_RETCRA_IDTPES
SP_MAPFIS
SP_DATSTR
SP_ATUTSI
uk␀␀PROCEDURE SP_HisAfa(P_TIPOPE CHAR,P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_DATAFA DATE,P_HORAFA NUMBER,P_DATTER DATE,P_HORTER NUMBER,P_SITAFA NUMBER,P_DATTER_OLD DATE,P_HORTER_OLD NUMBER,P_SITAFA_OLD NUMBER)
 IS

  l_data_zero    DATE;
  l_data2050     DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_bloace       CHAR(1);
  l_datst1       CHAR(6);
  l_datst2       CHAR(6);
  l_cracha       NUMBER(12);
  l_cracha_pro   NUMBER(12);
  l_datter_menor BOOLEAN;
  l_comando_nulo BOOLEAN;
  l_straux       VARCHAR2(255);
  l_codfil       NUMBER(6);
  l_codhor       NUMBER(4);
  l_horant       NUMBER(4);
  l_horbu1       NUMBER(4);
  l_horbu2       NUMBER(4);
  l_horbu3       NUMBER(4);
  l_horbu4       NUMBER(4);
  l_horbu5       NUMBER(4);
  l_horbu6       NUMBER(4);
  l_horbu7       NUMBER(4);
  l_horbu8       NUMBER(4);
  l_horbu9       NUMBER(4);
  l_horbu10      NUMBER(4);
  l_horbu11      NUMBER(4);
  l_horbu12      NUMBER(4);
  l_horbu13      NUMBER(4);
  l_horbu14      NUMBER(4);
  l_horbu15      NUMBER(4);
  l_horbu16      NUMBER(4);
  l_horbu17      NUMBER(4);
  l_horbu18      NUMBER(4);
  l_horbu19      NUMBER(4);
  l_horbu20      NUMBER(4);
  l_horbu21      NUMBER(4);
  l_horbu22      NUMBER(4);
  l_horbu23      NUMBER(4);
  l_horbu24      NUMBER(4);
  l_horbu25      NUMBER(4);
  l_horbu26      NUMBER(4);
  l_horbu27      NUMBER(4);
  l_horbu28      NUMBER(4);
  l_horbu29      NUMBER(4);
  l_horbu30      NUMBER(4);
  l_seqhba         r006hba.seqreg%TYPE;
  l_diafer       NUMBER(1);
  l_coderr       NUMBER(2);
  l_seqfai       NUMBER(2);
  l_iniace       NUMBER(5);
  l_fimace       NUMBER(5);
  l_fimjor       NUMBER;
  l_codesc         R006ESC.CodEsc%TYPE;
  l_codtur       NUMBER(1);
  l_turint       NUMBER(9);
  l_codint       NUMBER(9);
  l_tipcnv       NUMBER(1);
  l_sequencia    NUMBER;
  l_horter       NUMBER;
  l_iniafa       CHAR(16);
  l_datafa       CHAR(16);
  l_auxStr       VARCHAR2(2047);
  l_craaux       NUMBER(12);
  l_crastr       CHAR(12);
  l_horafa       CHAR(4);
  l_horfim       CHAR(4);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_TipSit       NUMBER(2);
  l_datadd       DATE;
  l_jorhor       CHAR(1);
  l_jorace       NUMBER(1);
  l_horbatini    NUMBER(5);
  l_horbatfim    NUMBER(5);
  l_tolant       NUMBER(5);
  l_tolapo       NUMBER(5);
BEGIN
  /* Inicializa */
  l_crapri := 0;
  l_data_atual := CURDATE();
  l_data_zero  := '31/12/1900,00:00:00';
  l_data2050   := '31/12/2050,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_iniafa     := '0000000000000000';
  l_datafa     := '0000000000000000';


  /* Pega o codigo do horario */
  RH_RetHor (p_numemp, p_tipcol, p_numcad, l_data_atual, 1,
             l_codhor OUT, l_horbu1 OUT, l_horbu2 OUT, l_horbu3 OUT,
             l_horbu4 OUT, l_horbu5 OUT, l_codesc OUT, l_codtur OUT,
             l_turint OUT, l_codint OUT, l_diafer OUT, l_tipcnv OUT,
             l_coderr OUT, l_seqhba OUT);

  RH_RETHOROPC (l_codesc, l_seqhba, l_horbu1 OUT, l_horbu2 OUT, l_horbu3 OUT, l_horbu4 OUT, l_horbu5 OUT, l_horbu6 OUT,
                l_horbu7 OUT, l_horbu8 OUT, l_horbu9 OUT, l_horbu10 OUT, l_horbu11 OUT, l_horbu12 OUT, l_horbu13 OUT, l_horbu14 OUT,
                l_horbu15 OUT, l_horbu16 OUT, l_horbu17 OUT, l_horbu18 OUT, l_horbu19 OUT, l_horbu20 OUT, l_horbu21 OUT, l_horbu22 OUT,
                l_horbu23 OUT, l_horbu24 OUT, l_horbu25 OUT, l_horbu26 OUT, l_horbu27 OUT, l_horbu28 OUT, l_horbu29 OUT, l_horbu30 OUT );

  IF   (l_diafer = 1) THEN
      l_codhor := 9997;
  END IF;

  /* se hora inicial e final for zerada, significa o dia todo */
  IF  (p_horafa = 0) AND (p_horter = 0) THEN
      l_horter := 1439;
  ELSE
      l_horter := p_horter;
  END IF;

  /* Verifica Se Alterou Data/Hora Termino Afastamento */
  IF    p_tipope = 'U' AND (p_datter_old = l_data_zero OR p_datter_old > l_data_atual OR (p_datter_old = l_data_atual AND p_horter_old >= l_hora_atual)) THEN
        l_datter_menor := TRUE;
  ELSIF (p_tipope = 'D') OR (p_datter = l_data_zero OR p_datter > l_data_atual OR (p_datter = l_data_atual AND l_horter >= l_hora_atual)) THEN
        l_datter_menor := TRUE;
  ELSE  l_datter_menor := FALSE;
  END IF;

  /* Valida Periodo do Afastamento */
  IF   (p_datafa < l_data_atual OR (p_datafa = l_data_atual AND p_horafa <= l_hora_atual)) AND
       (l_datter_menor = TRUE) THEN

       /* Verifica Situacao Bloqueio */
       l_bloace:='';
       BEGIN
           SELECT BLOACE, TIPSIT INTO l_bloace, l_TipSit FROM R010SIT WHERE R010SIT.CODSIT = p_sitafa;
       EXCEPTION
           WHEN NO_DATA_FOUND THEN l_comando_nulo := TRUE;
           WHEN OTHERS        THEN RAISERROR 103 'ERRO NO SELECT EM R010SIT.';
       END;

       /* Pega o codigo da filial */
       BEGIN
        SELECT HFI.CODFIL INTO l_codfil FROM R038HFI HFI WHERE
               HFI.NUMEMP = p_numemp AND HFI.TIPCOL = p_tipcol AND HFI.NUMCAD = p_numcad AND
               HFI.DATALT = (SELECT MAX(HFI2.DATALT) FROM R038HFI HFI2
                               WHERE HFI2.NUMEMP = p_numemp AND HFI2.TIPCOL = p_tipcol AND HFI2.NUMCAD = p_numcad AND HFI2.DATALT <= CURDATE());
       EXCEPTION
           WHEN OTHERS THEN l_codfil := 0;
       END;

       /* Verifica ultimo turno para afastamento (final jornada = maior horario do 3º turno).*/
       BEGIN
           SELECT FHF.INIACE, FHF.FIMACE INTO l_iniace, l_fimace FROM R004FHF FHF
           WHERE FHF.NUMEMP = p_numemp AND FHF.CODFIL = l_codfil AND
                 (FHF.CODHOR = l_codhor OR FHF.CODHOR = l_horbu1 OR FHF.CODHOR = l_horbu2 OR FHF.CODHOR = l_horbu3 OR
                  FHF.CODHOR = l_horbu4 OR FHF.CODHOR = l_horbu5 OR FHF.CODHOR = l_horbu6 OR FHF.CODHOR = l_horbu7 OR
				  FHF.CODHOR = l_horbu8 OR FHF.CODHOR = l_horbu9 OR FHF.CODHOR = l_horbu10 OR FHF.CODHOR = l_horbu11 OR
				  FHF.CODHOR = l_horbu12 OR FHF.CODHOR = l_horbu13 OR FHF.CODHOR = l_horbu14 OR FHF.CODHOR = l_horbu15 OR
				  FHF.CODHOR = l_horbu16 OR FHF.CODHOR = l_horbu17 OR FHF.CODHOR = l_horbu18 OR FHF.CODHOR = l_horbu19 OR
				  FHF.CODHOR = l_horbu20 OR FHF.CODHOR = l_horbu21 OR FHF.CODHOR = l_horbu22 OR FHF.CODHOR = l_horbu23 OR
				  FHF.CODHOR = l_horbu24 OR FHF.CODHOR = l_horbu25 OR FHF.CODHOR = l_horbu26 OR FHF.CODHOR = l_horbu27 OR
				  FHF.CODHOR = l_horbu28 OR FHF.CODHOR = l_horbu29 OR FHF.CODHOR = l_horbu30) AND (FHF.SEQFAI = 1);
       EXCEPTION
           WHEN OTHERS THEN
               l_iniace := 0;
               l_fimace := 0;
       END;

       IF (l_iniace = 0 AND l_fimace = 0) THEN
	       /* Verifica primeira faixa de acesso.*/
	       BEGIN
	           SELECT INIACE INTO l_iniace FROM R004FHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND (SEQFAI = 1) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_iniace := 0;
	       END;

	      /* Verifica ultima faixa de acesso  (final jornada = maior horario do 3Âº turno).*/
	       BEGIN
	           SELECT SEQFAI, FIMACE INTO l_seqfai, l_fimace FROM R004FHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND SEQFAI = (SELECT MAX(SEQFAI) FROM R004FHR
					 																				WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
																						                   CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
																										   CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
																										   CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
																										   CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
																										   CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
																										   CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
																										   CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30)) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_fimace := 0;
	       END;
       END IF;

       /* Verifica tipo de  turno.*/
       BEGIN
           SELECT JORHOR, JORACE INTO l_jorhor, l_jorace FROM R004HOR
           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
				  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
				  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
				  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
				  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
				  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
				  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30);
       EXCEPTION WHEN OTHERS THEN
           l_jorhor := 'E';
           l_jorace := 0;
       END;

       l_horafa := '0000';
       IF  (l_iniace > l_fimace) AND (l_fimace > 0) THEN
           l_fimjor := l_fimace;
           SP_INTSTR(l_fimace,'HHMM',l_horafa OUT);
           
       /* Verifica o 3º turno pelo parâmetro "inicia e finaliza em dias distintos", para pegar os casos de clientes que não utilizam faixas de acesso */
       ELSIF (l_jorace = 1) THEN
           /* Verifica primeira faixa de marcação.*/
	       BEGIN
	           SELECT HORBAT, TOLANT INTO l_horbatini, l_tolant FROM R004MHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND (SEQMAR = 1) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_horbatini := 0;
	           l_tolant := 0;
	       END;

	       /* Verifica ultima faixa de marcação.*/
	       BEGIN
	           SELECT HORBAT, TOLAPO INTO l_horbatfim, l_tolapo FROM R004MHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND SEQMAR = (SELECT MAX(SEQMAR) FROM R004MHR
					 																				WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
																						                   CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
																										   CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
																										   CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
																										   CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
																										   CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
																										   CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
																										   CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30)) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_horbatfim := 0;
	           l_tolapo := 0;
	       END;
       
           IF (l_tolant > 0) THEN
               l_iniace := l_tolant;
           ELSE
               l_iniace := l_horbatini;
           END IF;
           
           IF (l_tolapo > 0) THEN
               l_fimace := l_tolapo;
           ELSE
               l_fimace := l_horbatfim;
           END IF;
           
           /* Inclui uma hora de tolerância, quando possível. Se o horário de entrada/saída for inferior 
            * a 60 minutos do dia anterior/dia seguinte, coloca o primeiro/último horário do dia */ 
           IF ((l_iniace > 0) AND (l_iniace < 61)) THEN
               l_iniace := 1;
           ELSE
               l_iniace := l_iniace - 60;
           END IF;
           
           IF (l_fimace > 1379) THEN
               l_fimace := 1439;
           ELSE
               l_fimace := l_fimace + 60;
           END IF;

           l_fimjor := l_fimace;
           SP_INTSTR(l_fimace,'HHMM',l_horafa OUT);
                  
       ELSE
           l_fimjor := 0;
       END IF;

       IF   (l_bloace = 'S') THEN
            SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
            IF   (l_cracha = 0)  THEN
                  SP_RETCRA_IDTPES (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
            END IF;

            IF  l_cracha > 0 THEN
                 /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                 SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                 IF (l_crapri = 0) THEN
                     l_crapri := l_cracha;
                 END IF;

	               /* coloca zeros a esquerda do numero */
                 /* Na Exclusao do Afastamento Zeras Datas */

                 IF   p_tipope = 'D' THEN
                      l_datst1 := '      ';
                      l_datst2 := '      ';
                      l_iniafa := '0000000000000000';
                      l_datafa := '0000000000000000';
                 ELSE
                      l_datst1 := '      ';
                      SP_INTSTR(p_horter,'HHMM',l_horfim OUT);

                      IF  p_horafa = 0 THEN
                          IF  ((p_datafa < l_data_atual) OR
                              ((p_datafa = l_data_atual) AND (l_hora_atual > l_fimjor)) OR
                              ((p_datafa = l_data_atual) AND (l_hora_atual = 0) AND (l_fimjor = 0)) OR
                              ((p_datafa = l_data_atual) AND (l_iniace > l_fimace))) THEN
                              SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                          END IF;
                      ELSE
                          IF  (p_datafa < l_data_atual) OR ((p_datafa = l_data_atual) AND (l_hora_atual >= p_horafa)) THEN
                              SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                          END IF;
                      END IF;

                      IF  (l_datst1 = '      ') THEN
                          l_datst2 := '      ';
                          l_iniafa := '0000000000000000';
                          l_datafa := '0000000000000000';
                      ELSE
                          IF  (p_datter <> l_data_zero) THEN
                              /* Se tiver terceiro turno, l_horafa esta preenchida */
                              IF l_horafa = '0000' THEN
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_INTSTR(p_horafa,'HHMM',l_horafa OUT);
                                  SP_DATSTR(p_datter,'DDMMYY',l_datst2 OUT);

                                  IF (l_horfim = '0000') THEN
                                  	l_horfim := '2359';
                              	  END IF;
                              ELSE
                                  /* 3Âº turno */
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_DATSTR(p_datter,'DDMMYY',l_datst2 OUT);

                                  IF (l_horfim = '0000') THEN
                                      l_horfim := '2359';
                                  END IF;

                                  /*Se o afastamento tem o inicio e fim iguais e hora inicio e fim zeradas, vai olhar a jornada e calcular o afastmento*/
                                  IF ( (p_horafa = 0) AND (p_horter = 0) ) THEN
                                      /* Entrada */
                                      IF (l_jorHor = 'E') THEN
                                          SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);

                                          l_datadd := DATETIMEADD(DD, 1, p_datter);
                                          SP_DATSTR(l_datadd,'DDMMYY',l_datst2 OUT);
                                      END IF;
                                      /* Saida */
                                      IF (l_jorHor = 'S') THEN
                                          SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);

						                  l_datadd := DATETIMEADD(DD, -1, p_datter);
                                          SP_DATSTR(l_datadd,'DDMMYY',l_datst2 OUT);
                                          /* se a data calculada de saída de acordo com a jornada for menor que a atual, significa que o afastamento já acabou */
                                          IF (l_datadd < l_data_atual) THEN
                                              l_datst1 := '000000';
                                              l_datst2 := '000000';
                                              l_horafa := '0000';
                                              l_horfim := '0000';
                                          END IF;
                                      END IF;
                                  END IF;
                              END IF;

                              /*Variaveis R070CON*/
                              l_iniafa := l_datst1||l_horafa||'000000';

                          ELSE
                              /*Data Final Zerada*/
                              l_datst2 := '311250';
							  l_horfim := '2359';

                              /*Variaveis R070CON*/
                              l_datafa := '3112502359000000';

                              /*Formata o Inicio do Afastamento*/
                              IF l_horafa = '0000' THEN
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_INTSTR(p_horafa,'HHMM',l_horafa OUT);
                              ELSE
                                  /* Se tiver 3º turno, acrescenta um dia na DatAfa e hora final eh igual a hora final do 3º turno */
                                  l_datadd := DATETIMEADD(DD, 1, p_datafa);
                                  SP_DATSTR(l_datadd,'DDMMYY',l_datst1 OUT);
                              END IF;
                              l_iniafa := l_datst1||l_horafa||'000000';
                          END IF;
                      END IF;
                 END IF;

                 /* se a data form maior que 2050, joga o limite de 2050 para que a CSM entenda que eh data em aberto */
                 IF  (p_datter > l_data2050)  THEN
                     l_datst2 := '311250';
                     l_datafa := '3112502359000000';
                 ELSE
		            l_datafa := l_datst2||l_horfim||'000000';
                    IF (p_tipope = 'D') THEN
                         l_datafa := '0000000000000000';
                     END IF;
                 END IF;

                 /* Atualiza Controle  */
                 IF  (l_TipSit <> 7) THEN
                     /* atualiza r070con */
                     LOOP
                         BEGIN
                              UPDATE R070CON SET INIAFA=l_iniafa, DATAFA=l_datafa WHERE (NUMFIS = l_crapri) OR (NUMFIS = l_numbar) OR (NUMFIS = l_numpro) OR (NUMFIS = l_numsma);
                         EXCEPTION
                              WHEN OTHERS THEN NULL;
                         END;

                         /*Controle do Looping, onde deve ser efetuado o update no cracha provisorio caso o mesmo exista.*/
                         SP_RETCRA_IDTPES (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                         IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) THEN
                           EXIT;
                         ELSE
                            l_cracha := l_cracha_pro;
                            /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                            SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                            IF (l_crapri = 0) THEN
                                l_crapri := l_cracha;
                            END IF;
                         END IF;
                     END LOOP;
                 END IF;
            END IF;
       ELSE /* Verifica se Alterou tipo Situacao Afastamento */
            IF   (p_tipope = 'U') AND (p_sitafa_old <> p_sitafa) THEN
                 BEGIN
                     SELECT BLOACE INTO l_bloace FROM R010SIT WHERE R010SIT.CODSIT = p_sitafa_old;
                 EXCEPTION WHEN OTHERS THEN
                     RAISERROR 103 'ON-Line: Erro no SELECT em R010SIT.';
                 END;
                 IF   l_bloace = 'S' THEN
                      /* Verifica se Colaborador possui Cracha */
                      SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
                      IF   l_cracha > 0 THEN
                           /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                           SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                           IF (l_crapri = 0) THEN
                               l_crapri := l_cracha;
                           END IF;
                           /* atualiza r070con */
                           l_iniafa := '0000000000000000';
                           l_datafa := '0000000000000000';

                           LOOP
                               BEGIN
                                   /* Atualiza todos os numeros fisicos por causa da sincronia de lista */
                                   UPDATE R070CON SET INIAFA=l_iniafa, DATAFA=l_datafa WHERE (NUMFIS = l_crapri) OR (NUMFIS = l_numbar) OR (NUMFIS = l_numpro) OR (NUMFIS = l_numsma);
                               EXCEPTION
                                   WHEN OTHERS THEN RAISERROR 103 'SPHisAFa - Erro no update r070con.';
                               END;
                               /* Controle do Looping, onde deve ser efetuado o update no cracha provisorio caso o mesmo exista.*/
                               SP_RETCRA_IDTPES (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                               IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) THEN
                                 EXIT;
                               ELSE
                                  l_cracha := l_cracha_pro;
                                  /* Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                                  SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                                  IF (l_crapri = 0) THEN
                                      l_crapri := l_cracha;
                                  END IF;
                               END IF;
                           END LOOP;
                      END IF;
                 END IF;
            END IF;
       END IF;
      IF (l_crapri = 0) THEN
          /* Verifica se Colaborador possui Cracha */
          SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
          IF   l_cracha > 0 THEN
               /* Atualiza o Cracha¡ Principal e obtem o(s) numero(s) fisico(s). */
               SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
               IF (l_crapri = 0) THEN
                   l_crapri := l_cracha;
               END IF;
          END IF;
      END IF;
      IF (l_crapri <> 0) THEN
          /*Obtem o Tipo de Pessoa*/
          SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
          SP_INTSTR(p_numemp,'9999',l_numemp OUT);
          SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
          SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
          l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
          /*Preenche o campo com espacos para completar 23 posicoes*/
          l_idtpes := lTrim(l_idtpes);
          l_idtpes := rTrim(l_idtpes);
          LOOP
              /*Controle do Loop.*/
              IF (Length(l_idtpes) > 22) THEN
                  EXIT;
              END IF;
              l_idtpes := ' '||l_idtpes;
          END LOOP;
          /*Procedure que atualiza a controle*/
          SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
      END IF;
  END IF;
END		SENIOR;23WRH_RETHOR
RH_RETHOROPC
SP_INTSTR
SP_RETCRA_IDTPES
SP_MAPFIS
SP_DATSTR
SP_ATUTSI
uk␀␀PROCEDURE SP_HisAfa(P_TIPOPE CHAR,P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_DATAFA DATE,P_HORAFA NUMBER,P_DATTER DATE,P_HORTER NUMBER,P_SITAFA NUMBER,P_DATTER_OLD DATE,P_HORTER_OLD NUMBER,P_SITAFA_OLD NUMBER)
 IS

  l_data_zero    DATE;
  l_data2050     DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_bloace       CHAR(1);
  l_datst1       CHAR(6);
  l_datst2       CHAR(6);
  l_cracha       NUMBER(12);
  l_cracha_pro   NUMBER(12);
  l_datter_menor BOOLEAN;
  l_comando_nulo BOOLEAN;
  l_straux       VARCHAR2(255);
  l_codfil       NUMBER(6);
  l_codhor       NUMBER(4);
  l_horant       NUMBER(4);
  l_horbu1       NUMBER(4);
  l_horbu2       NUMBER(4);
  l_horbu3       NUMBER(4);
  l_horbu4       NUMBER(4);
  l_horbu5       NUMBER(4);
  l_horbu6       NUMBER(4);
  l_horbu7       NUMBER(4);
  l_horbu8       NUMBER(4);
  l_horbu9       NUMBER(4);
  l_horbu10      NUMBER(4);
  l_horbu11      NUMBER(4);
  l_horbu12      NUMBER(4);
  l_horbu13      NUMBER(4);
  l_horbu14      NUMBER(4);
  l_horbu15      NUMBER(4);
  l_horbu16      NUMBER(4);
  l_horbu17      NUMBER(4);
  l_horbu18      NUMBER(4);
  l_horbu19      NUMBER(4);
  l_horbu20      NUMBER(4);
  l_horbu21      NUMBER(4);
  l_horbu22      NUMBER(4);
  l_horbu23      NUMBER(4);
  l_horbu24      NUMBER(4);
  l_horbu25      NUMBER(4);
  l_horbu26      NUMBER(4);
  l_horbu27      NUMBER(4);
  l_horbu28      NUMBER(4);
  l_horbu29      NUMBER(4);
  l_horbu30      NUMBER(4);
  l_seqhba         r006hba.seqreg%TYPE;
  l_diafer       NUMBER(1);
  l_coderr       NUMBER(2);
  l_seqfai       NUMBER(2);
  l_iniace       NUMBER(5);
  l_fimace       NUMBER(5);
  l_fimjor       NUMBER;
  l_codesc         R006ESC.CodEsc%TYPE;
  l_codtur       NUMBER(1);
  l_turint       NUMBER(9);
  l_codint       NUMBER(9);
  l_tipcnv       NUMBER(1);
  l_sequencia    NUMBER;
  l_horter       NUMBER;
  l_iniafa       CHAR(16);
  l_datafa       CHAR(16);
  l_auxStr       VARCHAR2(2047);
  l_craaux       NUMBER(12);
  l_crastr       CHAR(12);
  l_horafa       CHAR(4);
  l_horfim       CHAR(4);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_TipSit       NUMBER(2);
  l_datadd       DATE;
  l_jorhor       CHAR(1);
  l_jorace       NUMBER(1);
  l_horbatini    NUMBER(5);
  l_horbatfim    NUMBER(5);
  l_tolant       NUMBER(5);
  l_tolapo       NUMBER(5);
BEGIN
  /* Inicializa */
  l_crapri := 0;
  l_data_atual := CURDATE();
  l_data_zero  := '31/12/1900,00:00:00';
  l_data2050   := '31/12/2050,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_iniafa     := '0000000000000000';
  l_datafa     := '0000000000000000';


  /* Pega o codigo do horario */
  RH_RetHor (p_numemp, p_tipcol, p_numcad, l_data_atual, 1,
             l_codhor OUT, l_horbu1 OUT, l_horbu2 OUT, l_horbu3 OUT,
             l_horbu4 OUT, l_horbu5 OUT, l_codesc OUT, l_codtur OUT,
             l_turint OUT, l_codint OUT, l_diafer OUT, l_tipcnv OUT,
             l_coderr OUT, l_seqhba OUT);

  RH_RETHOROPC (l_codesc, l_seqhba, l_horbu1 OUT, l_horbu2 OUT, l_horbu3 OUT, l_horbu4 OUT, l_horbu5 OUT, l_horbu6 OUT,
                l_horbu7 OUT, l_horbu8 OUT, l_horbu9 OUT, l_horbu10 OUT, l_horbu11 OUT, l_horbu12 OUT, l_horbu13 OUT, l_horbu14 OUT,
                l_horbu15 OUT, l_horbu16 OUT, l_horbu17 OUT, l_horbu18 OUT, l_horbu19 OUT, l_horbu20 OUT, l_horbu21 OUT, l_horbu22 OUT,
                l_horbu23 OUT, l_horbu24 OUT, l_horbu25 OUT, l_horbu26 OUT, l_horbu27 OUT, l_horbu28 OUT, l_horbu29 OUT, l_horbu30 OUT );

  IF   (l_diafer = 1) THEN
      l_codhor := 9997;
  END IF;

  /* se hora inicial e final for zerada, significa o dia todo */
  IF  (p_horafa = 0) AND (p_horter = 0) THEN
      l_horter := 1439;
  ELSE
      l_horter := p_horter;
  END IF;

  /* Verifica Se Alterou Data/Hora Termino Afastamento */
  IF    p_tipope = 'U' AND (p_datter_old = l_data_zero OR p_datter_old > l_data_atual OR (p_datter_old = l_data_atual AND p_horter_old >= l_hora_atual)) THEN
        l_datter_menor := TRUE;
  ELSIF (p_tipope = 'D') OR (p_datter = l_data_zero OR p_datter > l_data_atual OR (p_datter = l_data_atual AND l_horter >= l_hora_atual)) THEN
        l_datter_menor := TRUE;
  ELSE  l_datter_menor := FALSE;
  END IF;

  /* Valida Periodo do Afastamento */
  IF   (p_datafa < l_data_atual OR (p_datafa = l_data_atual AND p_horafa <= l_hora_atual)) AND
       (l_datter_menor = TRUE) THEN

       /* Verifica Situacao Bloqueio */
       l_bloace:='';
       BEGIN
           SELECT BLOACE, TIPSIT INTO l_bloace, l_TipSit FROM R010SIT WHERE R010SIT.CODSIT = p_sitafa;
       EXCEPTION
           WHEN NO_DATA_FOUND THEN l_comando_nulo := TRUE;
           WHEN OTHERS        THEN RAISERROR 103 'ERRO NO SELECT EM R010SIT.';
       END;

       /* Pega o codigo da filial */
       BEGIN
        SELECT HFI.CODFIL INTO l_codfil FROM R038HFI HFI WHERE
               HFI.NUMEMP = p_numemp AND HFI.TIPCOL = p_tipcol AND HFI.NUMCAD = p_numcad AND
               HFI.DATALT = (SELECT MAX(HFI2.DATALT) FROM R038HFI HFI2
                               WHERE HFI2.NUMEMP = p_numemp AND HFI2.TIPCOL = p_tipcol AND HFI2.NUMCAD = p_numcad AND HFI2.DATALT <= CURDATE());
       EXCEPTION
           WHEN OTHERS THEN l_codfil := 0;
       END;

       /* Verifica ultimo turno para afastamento (final jornada = maior horario do 3º turno).*/
       BEGIN
           SELECT FHF.INIACE, FHF.FIMACE INTO l_iniace, l_fimace FROM R004FHF FHF
           WHERE FHF.NUMEMP = p_numemp AND FHF.CODFIL = l_codfil AND
                 (FHF.CODHOR = l_codhor OR FHF.CODHOR = l_horbu1 OR FHF.CODHOR = l_horbu2 OR FHF.CODHOR = l_horbu3 OR
                  FHF.CODHOR = l_horbu4 OR FHF.CODHOR = l_horbu5 OR FHF.CODHOR = l_horbu6 OR FHF.CODHOR = l_horbu7 OR
				  FHF.CODHOR = l_horbu8 OR FHF.CODHOR = l_horbu9 OR FHF.CODHOR = l_horbu10 OR FHF.CODHOR = l_horbu11 OR
				  FHF.CODHOR = l_horbu12 OR FHF.CODHOR = l_horbu13 OR FHF.CODHOR = l_horbu14 OR FHF.CODHOR = l_horbu15 OR
				  FHF.CODHOR = l_horbu16 OR FHF.CODHOR = l_horbu17 OR FHF.CODHOR = l_horbu18 OR FHF.CODHOR = l_horbu19 OR
				  FHF.CODHOR = l_horbu20 OR FHF.CODHOR = l_horbu21 OR FHF.CODHOR = l_horbu22 OR FHF.CODHOR = l_horbu23 OR
				  FHF.CODHOR = l_horbu24 OR FHF.CODHOR = l_horbu25 OR FHF.CODHOR = l_horbu26 OR FHF.CODHOR = l_horbu27 OR
				  FHF.CODHOR = l_horbu28 OR FHF.CODHOR = l_horbu29 OR FHF.CODHOR = l_horbu30) AND (FHF.SEQFAI = 1);
       EXCEPTION
           WHEN OTHERS THEN
               l_iniace := 0;
               l_fimace := 0;
       END;

       IF (l_iniace = 0 AND l_fimace = 0) THEN
	       /* Verifica primeira faixa de acesso.*/
	       BEGIN
	           SELECT INIACE INTO l_iniace FROM R004FHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND (SEQFAI = 1) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_iniace := 0;
	       END;

	      /* Verifica ultima faixa de acesso  (final jornada = maior horario do 3Âº turno).*/
	       BEGIN
	           SELECT SEQFAI, FIMACE INTO l_seqfai, l_fimace FROM R004FHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND SEQFAI = (SELECT MAX(SEQFAI) FROM R004FHR
					 																				WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
																						                   CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
																										   CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
																										   CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
																										   CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
																										   CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
																										   CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
																										   CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30)) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_fimace := 0;
	       END;
       END IF;

       /* Verifica tipo de  turno.*/
       BEGIN
           SELECT JORHOR, JORACE INTO l_jorhor, l_jorace FROM R004HOR
           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
				  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
				  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
				  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
				  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
				  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
				  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30);
       EXCEPTION WHEN OTHERS THEN
           l_jorhor := 'E';
           l_jorace := 0;
       END;

       l_horafa := '0000';
       IF  (l_iniace > l_fimace) AND (l_fimace > 0) THEN
           l_fimjor := l_fimace;
           SP_INTSTR(l_fimace,'HHMM',l_horafa OUT);
           
       /* Verifica o 3º turno pelo parâmetro "inicia e finaliza em dias distintos", para pegar os casos de clientes que não utilizam faixas de acesso */
       ELSIF (l_jorace = 1) THEN
           /* Verifica primeira faixa de marcação.*/
	       BEGIN
	           SELECT HORBAT, TOLANT INTO l_horbatini, l_tolant FROM R004MHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND (SEQMAR = 1) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_horbatini := 0;
	           l_tolant := 0;
	       END;

	       /* Verifica ultima faixa de marcação.*/
	       BEGIN
	           SELECT HORBAT, TOLAPO INTO l_horbatfim, l_tolapo FROM R004MHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND SEQMAR = (SELECT MAX(SEQMAR) FROM R004MHR
					 																				WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
																						                   CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
																										   CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
																										   CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
																										   CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
																										   CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
																										   CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
																										   CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30)) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_horbatfim := 0;
	           l_tolapo := 0;
	       END;
       
           IF (l_tolant > 0) THEN
               l_iniace := l_tolant;
           ELSE
               l_iniace := l_horbatini;
           END IF;
           
           IF (l_tolapo > 0) THEN
               l_fimace := l_tolapo;
           ELSE
               l_fimace := l_horbatfim;
           END IF;
           
           /* Inclui uma hora de tolerância, quando possível. Se o horário de entrada/saída for inferior 
            * a 60 minutos do dia anterior/dia seguinte, coloca o primeiro/último horário do dia */ 
           IF ((l_iniace > 0) AND (l_iniace < 61)) THEN
               l_iniace := 1;
           ELSE
               l_iniace := l_iniace - 60;
           END IF;
           
           IF (l_fimace > 1379) THEN
               l_fimace := 1439;
           ELSE
               l_fimace := l_fimace + 60;
           END IF;

           l_fimjor := l_fimace;
           SP_INTSTR(l_fimace,'HHMM',l_horafa OUT);
                  
       ELSE
           l_fimjor := 0;
       END IF;

       IF   (l_bloace = 'S') THEN
            SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
            IF   (l_cracha = 0)  THEN
                  SP_RETCRA_IDTPES (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
            END IF;

            IF  l_cracha > 0 THEN
                 /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                 SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                 IF (l_crapri = 0) THEN
                     l_crapri := l_cracha;
                 END IF;

	               /* coloca zeros a esquerda do numero */
                 /* Na Exclusao do Afastamento Zeras Datas */

                 IF   p_tipope = 'D' THEN
                      l_datst1 := '      ';
                      l_datst2 := '      ';
                      l_iniafa := '0000000000000000';
                      l_datafa := '0000000000000000';
                 ELSE
                      l_datst1 := '      ';
                      SP_INTSTR(p_horter,'HHMM',l_horfim OUT);

                      IF  p_horafa = 0 THEN
                          IF  ((p_datafa < l_data_atual) OR
                              ((p_datafa = l_data_atual) AND (l_hora_atual > l_fimjor)) OR
                              ((p_datafa = l_data_atual) AND (l_hora_atual = 0) AND (l_fimjor = 0)) OR
                              ((p_datafa = l_data_atual) AND (l_iniace > l_fimace))) THEN
                              SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                          END IF;
                      ELSE
                          IF  (p_datafa < l_data_atual) OR ((p_datafa = l_data_atual) AND (l_hora_atual >= p_horafa)) THEN
                              SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                          END IF;
                      END IF;

                      IF  (l_datst1 = '      ') THEN
                          l_datst2 := '      ';
                          l_iniafa := '0000000000000000';
                          l_datafa := '0000000000000000';
                      ELSE
                          IF  (p_datter <> l_data_zero) THEN
                              /* Se tiver terceiro turno, l_horafa esta preenchida */
                              IF l_horafa = '0000' THEN
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_INTSTR(p_horafa,'HHMM',l_horafa OUT);
                                  SP_DATSTR(p_datter,'DDMMYY',l_datst2 OUT);

                                  IF (l_horfim = '0000') THEN
                                  	l_horfim := '2359';
                              	  END IF;
                              ELSE
                                  /* 3Âº turno */
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_DATSTR(p_datter,'DDMMYY',l_datst2 OUT);

                                  IF (l_horfim = '0000') THEN
                                      l_horfim := '2359';
                                  END IF;

                                  /*Se o afastamento tem o inicio e fim iguais e hora inicio e fim zeradas, vai olhar a jornada e calcular o afastmento*/
                                  IF ( (p_horafa = 0) AND (p_horter = 0) ) THEN
                                      /* Entrada */
                                      IF (l_jorHor = 'E') THEN
                                          SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);

                                          l_datadd := DATETIMEADD(DD, 1, p_datter);
                                          SP_DATSTR(l_datadd,'DDMMYY',l_datst2 OUT);
                                      END IF;
                                      /* Saida */
                                      IF (l_jorHor = 'S') THEN
                                          SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);

						                  l_datadd := DATETIMEADD(DD, -1, p_datter);
                                          SP_DATSTR(l_datadd,'DDMMYY',l_datst2 OUT);
                                          /* se a data calculada de saída de acordo com a jornada for menor que a atual, significa que o afastamento já acabou */
                                          IF (l_datadd < l_data_atual) THEN
                                              l_datst1 := '000000';
                                              l_datst2 := '000000';
                                              l_horafa := '0000';
                                              l_horfim := '0000';
                                          END IF;
                                      END IF;
                                  END IF;
                              END IF;

                              /*Variaveis R070CON*/
                              l_iniafa := l_datst1||l_horafa||'000000';

                          ELSE
                              /*Data Final Zerada*/
                              l_datst2 := '311250';
							  l_horfim := '2359';

                              /*Variaveis R070CON*/
                              l_datafa := '3112502359000000';

                              /*Formata o Inicio do Afastamento*/
                              IF l_horafa = '0000' THEN
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_INTSTR(p_horafa,'HHMM',l_horafa OUT);
                              ELSE
                                  /* Se tiver 3º turno, acrescenta um dia na DatAfa e hora final eh igual a hora final do 3º turno */
                                  l_datadd := DATETIMEADD(DD, 1, p_datafa);
                                  SP_DATSTR(l_datadd,'DDMMYY',l_datst1 OUT);
                              END IF;
                              l_iniafa := l_datst1||l_horafa||'000000';
                          END IF;
                      END IF;
                 END IF;

                 /* se a data form maior que 2050, joga o limite de 2050 para que a CSM entenda que eh data em aberto */
                 IF  (p_datter > l_data2050)  THEN
                     l_datst2 := '311250';
                     l_datafa := '3112502359000000';
                 ELSE
		            l_datafa := l_datst2||l_horfim||'000000';
                    IF (p_tipope = 'D') THEN
                         l_datafa := '0000000000000000';
                     END IF;
                 END IF;

                 /* Atualiza Controle  */
                 IF  (l_TipSit <> 7) THEN
                     /* atualiza r070con */
                     LOOP
                         BEGIN
                              UPDATE R070CON SET INIAFA=l_iniafa, DATAFA=l_datafa WHERE (NUMFIS = l_crapri) OR (NUMFIS = l_numbar) OR (NUMFIS = l_numpro) OR (NUMFIS = l_numsma);
                         EXCEPTION
                              WHEN OTHERS THEN NULL;
                         END;

                         /*Controle do Looping, onde deve ser efetuado o update no cracha provisorio caso o mesmo exista.*/
                         SP_RETCRA_IDTPES (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                         IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) THEN
                           EXIT;
                         ELSE
                            l_cracha := l_cracha_pro;
                            /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                            SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                            IF (l_crapri = 0) THEN
                                l_crapri := l_cracha;
                            END IF;
                         END IF;
                     END LOOP;
                 END IF;
            END IF;
       ELSE /* Verifica se Alterou tipo Situacao Afastamento */
            IF   (p_tipope = 'U') AND (p_sitafa_old <> p_sitafa) THEN
                 BEGIN
                     SELECT BLOACE INTO l_bloace FROM R010SIT WHERE R010SIT.CODSIT = p_sitafa_old;
                 EXCEPTION WHEN OTHERS THEN
                     RAISERROR 103 'ON-Line: Erro no SELECT em R010SIT.';
                 END;
                 IF   l_bloace = 'S' THEN
                      /* Verifica se Colaborador possui Cracha */
                      SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
                      IF   l_cracha > 0 THEN
                           /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                           SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                           IF (l_crapri = 0) THEN
                               l_crapri := l_cracha;
                           END IF;
                           /* atualiza r070con */
                           l_iniafa := '0000000000000000';
                           l_datafa := '0000000000000000';

                           LOOP
                               BEGIN
                                   /* Atualiza todos os numeros fisicos por causa da sincronia de lista */
                                   UPDATE R070CON SET INIAFA=l_iniafa, DATAFA=l_datafa WHERE (NUMFIS = l_crapri) OR (NUMFIS = l_numbar) OR (NUMFIS = l_numpro) OR (NUMFIS = l_numsma);
                               EXCEPTION
                                   WHEN OTHERS THEN RAISERROR 103 'SPHisAFa - Erro no update r070con.';
                               END;
                               /* Controle do Looping, onde deve ser efetuado o update no cracha provisorio caso o mesmo exista.*/
                               SP_RETCRA_IDTPES (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                               IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) THEN
                                 EXIT;
                               ELSE
                                  l_cracha := l_cracha_pro;
                                  /* Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                                  SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                                  IF (l_crapri = 0) THEN
                                      l_crapri := l_cracha;
                                  END IF;
                               END IF;
                           END LOOP;
                      END IF;
                 END IF;
            END IF;
       END IF;
      IF (l_crapri = 0) THEN
          /* Verifica se Colaborador possui Cracha */
          SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
          IF   l_cracha > 0 THEN
               /* Atualiza o Cracha¡ Principal e obtem o(s) numero(s) fisico(s). */
               SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
               IF (l_crapri = 0) THEN
                   l_crapri := l_cracha;
               END IF;
          END IF;
      END IF;
      IF (l_crapri <> 0) THEN
          /*Obtem o Tipo de Pessoa*/
          SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
          SP_INTSTR(p_numemp,'9999',l_numemp OUT);
          SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
          SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
          l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
          /*Preenche o campo com espacos para completar 23 posicoes*/
          l_idtpes := lTrim(l_idtpes);
          l_idtpes := rTrim(l_idtpes);
          LOOP
              /*Controle do Loop.*/
              IF (Length(l_idtpes) > 22) THEN
                  EXIT;
              END IF;
              l_idtpes := ' '||l_idtpes;
          END LOOP;
          /*Procedure que atualiza a controle*/
          SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
      END IF;
  END IF;
END		SENIOR;24WRH_RETHOR
RH_RETHOROPC
SP_INTSTR
SP_RETCRA_IDTPES
SP_MAPFIS
SP_DATSTR
SP_ATUTSI
uk␀␀PROCEDURE SP_HisAfa(P_TIPOPE CHAR,P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_DATAFA DATE,P_HORAFA NUMBER,P_DATTER DATE,P_HORTER NUMBER,P_SITAFA NUMBER,P_DATTER_OLD DATE,P_HORTER_OLD NUMBER,P_SITAFA_OLD NUMBER)
 IS

  l_data_zero    DATE;
  l_data2050     DATE;
  l_data_atual   DATE;
  l_hora_atual   NUMBER(4);
  l_bloace       CHAR(1);
  l_datst1       CHAR(6);
  l_datst2       CHAR(6);
  l_cracha       NUMBER(12);
  l_cracha_pro   NUMBER(12);
  l_datter_menor BOOLEAN;
  l_comando_nulo BOOLEAN;
  l_straux       VARCHAR2(255);
  l_codfil       NUMBER(6);
  l_codhor       NUMBER(4);
  l_horant       NUMBER(4);
  l_horbu1       NUMBER(4);
  l_horbu2       NUMBER(4);
  l_horbu3       NUMBER(4);
  l_horbu4       NUMBER(4);
  l_horbu5       NUMBER(4);
  l_horbu6       NUMBER(4);
  l_horbu7       NUMBER(4);
  l_horbu8       NUMBER(4);
  l_horbu9       NUMBER(4);
  l_horbu10      NUMBER(4);
  l_horbu11      NUMBER(4);
  l_horbu12      NUMBER(4);
  l_horbu13      NUMBER(4);
  l_horbu14      NUMBER(4);
  l_horbu15      NUMBER(4);
  l_horbu16      NUMBER(4);
  l_horbu17      NUMBER(4);
  l_horbu18      NUMBER(4);
  l_horbu19      NUMBER(4);
  l_horbu20      NUMBER(4);
  l_horbu21      NUMBER(4);
  l_horbu22      NUMBER(4);
  l_horbu23      NUMBER(4);
  l_horbu24      NUMBER(4);
  l_horbu25      NUMBER(4);
  l_horbu26      NUMBER(4);
  l_horbu27      NUMBER(4);
  l_horbu28      NUMBER(4);
  l_horbu29      NUMBER(4);
  l_horbu30      NUMBER(4);
  l_seqhba         r006hba.seqreg%TYPE;
  l_diafer       NUMBER(1);
  l_coderr       NUMBER(2);
  l_seqfai       NUMBER(2);
  l_iniace       NUMBER(5);
  l_fimace       NUMBER(5);
  l_fimjor       NUMBER;
  l_codesc         R006ESC.CodEsc%TYPE;
  l_codtur       NUMBER(1);
  l_turint       NUMBER(9);
  l_codint       NUMBER(9);
  l_tipcnv       NUMBER(1);
  l_sequencia    NUMBER;
  l_horter       NUMBER;
  l_iniafa       CHAR(16);
  l_datafa       CHAR(16);
  l_auxStr       VARCHAR2(2047);
  l_craaux       NUMBER(12);
  l_crastr       CHAR(12);
  l_horafa       CHAR(4);
  l_horfim       CHAR(4);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_TipSit       NUMBER(2);
  l_datadd       DATE;
  l_jorhor       CHAR(1);
  l_jorace       NUMBER(1);
  l_horbatini    NUMBER(5);
  l_horbatfim    NUMBER(5);
  l_tolant       NUMBER(5);
  l_tolapo       NUMBER(5);
BEGIN
  /* Inicializa */
  l_crapri := 0;
  l_data_atual := CURDATE();
  l_data_zero  := '31/12/1900,00:00:00';
  l_data2050   := '31/12/2050,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_iniafa     := '0000000000000000';
  l_datafa     := '0000000000000000';


  /* Pega o codigo do horario */
  RH_RetHor (p_numemp, p_tipcol, p_numcad, l_data_atual, 1,
             l_codhor OUT, l_horbu1 OUT, l_horbu2 OUT, l_horbu3 OUT,
             l_horbu4 OUT, l_horbu5 OUT, l_codesc OUT, l_codtur OUT,
             l_turint OUT, l_codint OUT, l_diafer OUT, l_tipcnv OUT,
             l_coderr OUT, l_seqhba OUT);

  RH_RETHOROPC (l_codesc, l_seqhba, l_horbu1 OUT, l_horbu2 OUT, l_horbu3 OUT, l_horbu4 OUT, l_horbu5 OUT, l_horbu6 OUT,
                l_horbu7 OUT, l_horbu8 OUT, l_horbu9 OUT, l_horbu10 OUT, l_horbu11 OUT, l_horbu12 OUT, l_horbu13 OUT, l_horbu14 OUT,
                l_horbu15 OUT, l_horbu16 OUT, l_horbu17 OUT, l_horbu18 OUT, l_horbu19 OUT, l_horbu20 OUT, l_horbu21 OUT, l_horbu22 OUT,
                l_horbu23 OUT, l_horbu24 OUT, l_horbu25 OUT, l_horbu26 OUT, l_horbu27 OUT, l_horbu28 OUT, l_horbu29 OUT, l_horbu30 OUT );

  IF   (l_diafer = 1) THEN
      l_codhor := 9997;
  END IF;

  /* se hora inicial e final for zerada, significa o dia todo */
  IF  (p_horafa = 0) AND (p_horter = 0) THEN
      l_horter := 1439;
  ELSE
      l_horter := p_horter;
  END IF;

  /* Verifica Se Alterou Data/Hora Termino Afastamento */
  IF    p_tipope = 'U' AND (p_datter_old = l_data_zero OR p_datter_old > l_data_atual OR (p_datter_old = l_data_atual AND p_horter_old >= l_hora_atual)) THEN
        l_datter_menor := TRUE;
  ELSIF (p_tipope = 'D') OR (p_datter = l_data_zero OR p_datter > l_data_atual OR (p_datter = l_data_atual AND l_horter >= l_hora_atual)) THEN
        l_datter_menor := TRUE;
  ELSE  l_datter_menor := FALSE;
  END IF;

  /* Valida Periodo do Afastamento */
  IF   (p_datafa < l_data_atual OR (p_datafa = l_data_atual AND p_horafa <= l_hora_atual)) AND
       (l_datter_menor = TRUE) THEN

       /* Verifica Situacao Bloqueio */
       l_bloace:='';
       BEGIN
           SELECT BLOACE, TIPSIT INTO l_bloace, l_TipSit FROM R010SIT WHERE R010SIT.CODSIT = p_sitafa;
       EXCEPTION
           WHEN NO_DATA_FOUND THEN l_comando_nulo := TRUE;
           WHEN OTHERS        THEN RAISERROR 103 'ERRO NO SELECT EM R010SIT.';
       END;

       /* Pega o codigo da filial */
       BEGIN
        SELECT HFI.CODFIL INTO l_codfil FROM R038HFI HFI WHERE
               HFI.NUMEMP = p_numemp AND HFI.TIPCOL = p_tipcol AND HFI.NUMCAD = p_numcad AND
               HFI.DATALT = (SELECT MAX(HFI2.DATALT) FROM R038HFI HFI2
                               WHERE HFI2.NUMEMP = p_numemp AND HFI2.TIPCOL = p_tipcol AND HFI2.NUMCAD = p_numcad AND HFI2.DATALT <= CURDATE());
       EXCEPTION
           WHEN OTHERS THEN l_codfil := 0;
       END;

       /* Verifica ultimo turno para afastamento (final jornada = maior horario do 3º turno).*/
       BEGIN
           SELECT FHF.INIACE, FHF.FIMACE INTO l_iniace, l_fimace FROM R004FHF FHF
           WHERE FHF.NUMEMP = p_numemp AND FHF.CODFIL = l_codfil AND
                 (FHF.CODHOR = l_codhor OR FHF.CODHOR = l_horbu1 OR FHF.CODHOR = l_horbu2 OR FHF.CODHOR = l_horbu3 OR
                  FHF.CODHOR = l_horbu4 OR FHF.CODHOR = l_horbu5 OR FHF.CODHOR = l_horbu6 OR FHF.CODHOR = l_horbu7 OR
				  FHF.CODHOR = l_horbu8 OR FHF.CODHOR = l_horbu9 OR FHF.CODHOR = l_horbu10 OR FHF.CODHOR = l_horbu11 OR
				  FHF.CODHOR = l_horbu12 OR FHF.CODHOR = l_horbu13 OR FHF.CODHOR = l_horbu14 OR FHF.CODHOR = l_horbu15 OR
				  FHF.CODHOR = l_horbu16 OR FHF.CODHOR = l_horbu17 OR FHF.CODHOR = l_horbu18 OR FHF.CODHOR = l_horbu19 OR
				  FHF.CODHOR = l_horbu20 OR FHF.CODHOR = l_horbu21 OR FHF.CODHOR = l_horbu22 OR FHF.CODHOR = l_horbu23 OR
				  FHF.CODHOR = l_horbu24 OR FHF.CODHOR = l_horbu25 OR FHF.CODHOR = l_horbu26 OR FHF.CODHOR = l_horbu27 OR
				  FHF.CODHOR = l_horbu28 OR FHF.CODHOR = l_horbu29 OR FHF.CODHOR = l_horbu30) AND (FHF.SEQFAI = 1);
       EXCEPTION
           WHEN OTHERS THEN
               l_iniace := 0;
               l_fimace := 0;
       END;

       IF (l_iniace = 0 AND l_fimace = 0) THEN
	       /* Verifica primeira faixa de acesso.*/
	       BEGIN
	           SELECT INIACE INTO l_iniace FROM R004FHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND (SEQFAI = 1) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_iniace := 0;
	       END;

	      /* Verifica ultima faixa de acesso  (final jornada = maior horario do 3Âº turno).*/
	       BEGIN
	           SELECT SEQFAI, FIMACE INTO l_seqfai, l_fimace FROM R004FHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND SEQFAI = (SELECT MAX(SEQFAI) FROM R004FHR
					 																				WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
																						                   CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
																										   CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
																										   CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
																										   CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
																										   CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
																										   CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
																										   CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30)) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_fimace := 0;
	       END;
       END IF;

       /* Verifica tipo de  turno.*/
       BEGIN
           SELECT JORHOR, JORACE INTO l_jorhor, l_jorace FROM R004HOR
           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
				  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
				  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
				  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
				  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
				  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
				  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30);
       EXCEPTION WHEN OTHERS THEN
           l_jorhor := 'E';
           l_jorace := 0;
       END;

       l_horafa := '0000';
       IF  (l_iniace > l_fimace) AND (l_fimace > 0) THEN
           l_fimjor := l_fimace;
           SP_INTSTR(l_fimace,'HHMM',l_horafa OUT);
           
       /* Verifica o 3º turno pelo parâmetro "inicia e finaliza em dias distintos", para pegar os casos de clientes que não utilizam faixas de acesso */
       ELSIF (l_jorace = 1) THEN
           /* Verifica primeira faixa de marcação.*/
	       BEGIN
	           SELECT HORBAT, TOLANT INTO l_horbatini, l_tolant FROM R004MHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND (SEQMAR = 1) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_horbatini := 0;
	           l_tolant := 0;
	       END;

	       /* Verifica ultima faixa de marcação.*/
	       BEGIN
	           SELECT HORBAT, TOLAPO INTO l_horbatfim, l_tolapo FROM R004MHR
	           WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
	                  CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
					  CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
					  CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
					  CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
					  CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
					  CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
					  CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30) AND SEQMAR = (SELECT MAX(SEQMAR) FROM R004MHR
					 																				WHERE (CODHOR = l_codhor OR CODHOR = l_horbu1 OR CODHOR = l_horbu2 OR CODHOR = l_horbu3 OR
																						                   CODHOR = l_horbu4 OR CODHOR = l_horbu5 OR CODHOR = l_horbu6 OR CODHOR = l_horbu7 OR
																										   CODHOR = l_horbu8 OR CODHOR = l_horbu9 OR CODHOR = l_horbu10 OR CODHOR = l_horbu11 OR
																										   CODHOR = l_horbu12 OR CODHOR = l_horbu13 OR CODHOR = l_horbu14 OR CODHOR = l_horbu15 OR
																										   CODHOR = l_horbu16 OR CODHOR = l_horbu17 OR CODHOR = l_horbu18 OR CODHOR = l_horbu19 OR
																										   CODHOR = l_horbu20 OR CODHOR = l_horbu21 OR CODHOR = l_horbu22 OR CODHOR = l_horbu23 OR
																										   CODHOR = l_horbu24 OR CODHOR = l_horbu25 OR CODHOR = l_horbu26 OR CODHOR = l_horbu27 OR
																										   CODHOR = l_horbu28 OR CODHOR = l_horbu29 OR CODHOR = l_horbu30)) ;
	       EXCEPTION WHEN OTHERS THEN
	           l_horbatfim := 0;
	           l_tolapo := 0;
	       END;
       
           IF (l_tolant > 0) THEN
               l_iniace := l_tolant;
           ELSE
               l_iniace := l_horbatini;
           END IF;
           
           IF (l_tolapo > 0) THEN
               l_fimace := l_tolapo;
           ELSE
               l_fimace := l_horbatfim;
           END IF;
           
           /* Inclui uma hora de tolerância, quando possível. Se o horário de entrada/saída for inferior 
            * a 60 minutos do dia anterior/dia seguinte, coloca o primeiro/último horário do dia */ 
           IF ((l_iniace > 0) AND (l_iniace < 61)) THEN
               l_iniace := 1;
           ELSE
               l_iniace := l_iniace - 60;
           END IF;
           
           IF (l_fimace > 1379) THEN
               l_fimace := 1439;
           ELSE
               l_fimace := l_fimace + 60;
           END IF;

           l_fimjor := l_fimace;
           SP_INTSTR(l_fimace,'HHMM',l_horafa OUT);
                  
       ELSE
           l_fimjor := 0;
       END IF;

       IF   (l_bloace = 'S') THEN
            SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
            IF   (l_cracha = 0)  THEN
                  SP_RETCRA_IDTPES (2, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
            END IF;

            IF  l_cracha > 0 THEN
                 /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                 SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                 IF (l_crapri = 0) THEN
                     l_crapri := l_cracha;
                 END IF;

	               /* coloca zeros a esquerda do numero */
                 /* Na Exclusao do Afastamento Zeras Datas */

                 IF   p_tipope = 'D' THEN
                      l_datst1 := '      ';
                      l_datst2 := '      ';
                      l_iniafa := '0000000000000000';
                      l_datafa := '0000000000000000';
                 ELSE
                      l_datst1 := '      ';
                      SP_INTSTR(p_horter,'HHMM',l_horfim OUT);

                      IF  p_horafa = 0 THEN
                          IF  ((p_datafa < l_data_atual) OR
                              ((p_datafa = l_data_atual) AND (l_hora_atual > l_fimjor)) OR
                              ((p_datafa = l_data_atual) AND (l_hora_atual = 0) AND (l_fimjor = 0)) OR
                              ((p_datafa = l_data_atual) AND (l_iniace > l_fimace))) THEN
                              SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                          END IF;
                      ELSE
                          IF  (p_datafa < l_data_atual) OR ((p_datafa = l_data_atual) AND (l_hora_atual >= p_horafa)) THEN
                              SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                          END IF;
                      END IF;

                      IF  (l_datst1 = '      ') THEN
                          l_datst2 := '      ';
                          l_iniafa := '0000000000000000';
                          l_datafa := '0000000000000000';
                      ELSE
                          IF  (p_datter <> l_data_zero) THEN
                              /* Se tiver terceiro turno, l_horafa esta preenchida */
                              IF l_horafa = '0000' THEN
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_INTSTR(p_horafa,'HHMM',l_horafa OUT);
                                  SP_DATSTR(p_datter,'DDMMYY',l_datst2 OUT);

                                  IF (l_horfim = '0000') THEN
                                  	l_horfim := '2359';
                              	  END IF;
                              ELSE
                                  /* 3Âº turno */
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_DATSTR(p_datter,'DDMMYY',l_datst2 OUT);

                                  IF (l_horfim = '0000') THEN
                                      l_horfim := '2359';
                                  END IF;

                                  /*Se o afastamento tem o inicio e fim iguais e hora inicio e fim zeradas, vai olhar a jornada e calcular o afastmento*/
                                  IF ( (p_horafa = 0) AND (p_horter = 0) ) THEN
                                      /* Entrada */
                                      IF (l_jorHor = 'E') THEN
                                          SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);

                                          l_datadd := DATETIMEADD(DD, 1, p_datter);
                                          SP_DATSTR(l_datadd,'DDMMYY',l_datst2 OUT);
                                      END IF;
                                      /* Saida */
                                      IF (l_jorHor = 'S') THEN
                                          SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);

						                  l_datadd := DATETIMEADD(DD, -1, p_datter);
                                          SP_DATSTR(l_datadd,'DDMMYY',l_datst2 OUT);
                                          /* se a data calculada de saída de acordo com a jornada for menor que a atual, significa que o afastamento já acabou */
                                          IF (l_datadd < l_data_atual) THEN
                                              l_datst1 := '000000';
                                              l_datst2 := '000000';
                                              l_horafa := '0000';
                                              l_horfim := '0000';
                                          END IF;
                                      END IF;
                                  END IF;
                              END IF;

                              /*Variaveis R070CON*/
                              l_iniafa := l_datst1||l_horafa||'000000';

                          ELSE
                              /*Data Final Zerada*/
                              l_datst2 := '311250';
							  l_horfim := '2359';

                              /*Variaveis R070CON*/
                              l_datafa := '3112502359000000';

                              /*Formata o Inicio do Afastamento*/
                              IF l_horafa = '0000' THEN
                                  SP_DATSTR(p_datafa,'DDMMYY',l_datst1 OUT);
                                  SP_INTSTR(p_horafa,'HHMM',l_horafa OUT);
                              ELSE
                                  /* Se tiver 3º turno, acrescenta um dia na DatAfa e hora final eh igual a hora final do 3º turno */
                                  l_datadd := DATETIMEADD(DD, 1, p_datafa);
                                  SP_DATSTR(l_datadd,'DDMMYY',l_datst1 OUT);
                              END IF;
                              l_iniafa := l_datst1||l_horafa||'000000';
                          END IF;
                      END IF;
                 END IF;

                 /* se a data form maior que 2050, joga o limite de 2050 para que a CSM entenda que eh data em aberto */
                 IF  (p_datter > l_data2050)  THEN
                     l_datst2 := '311250';
                     l_datafa := '3112502359000000';
                 ELSE
		            l_datafa := l_datst2||l_horfim||'000000';
                    IF (p_tipope = 'D') THEN
                         l_datafa := '0000000000000000';
                     END IF;
                 END IF;

                 /* Atualiza Controle  */
                 IF  (l_TipSit <> 7) THEN
                     /* atualiza r070con */
                     LOOP
                         BEGIN
                              UPDATE R070CON SET INIAFA=l_iniafa, DATAFA=l_datafa WHERE (NUMFIS = l_crapri) OR (NUMFIS = l_numbar) OR (NUMFIS = l_numpro) OR (NUMFIS = l_numsma);
                         EXCEPTION
                              WHEN OTHERS THEN NULL;
                         END;

                         /*Controle do Looping, onde deve ser efetuado o update no cracha provisorio caso o mesmo exista.*/
                         SP_RETCRA_IDTPES (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                         IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) THEN
                           EXIT;
                         ELSE
                            l_cracha := l_cracha_pro;
                            /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                            SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                            IF (l_crapri = 0) THEN
                                l_crapri := l_cracha;
                            END IF;
                         END IF;
                     END LOOP;
                 END IF;
            END IF;
       ELSE /* Verifica se Alterou tipo Situacao Afastamento */
            IF   (p_tipope = 'U') AND (p_sitafa_old <> p_sitafa) THEN
                 BEGIN
                     SELECT BLOACE INTO l_bloace FROM R010SIT WHERE R010SIT.CODSIT = p_sitafa_old;
                 EXCEPTION WHEN OTHERS THEN
                     RAISERROR 103 'ON-Line: Erro no SELECT em R010SIT.';
                 END;
                 IF   l_bloace = 'S' THEN
                      /* Verifica se Colaborador possui Cracha */
                      SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
                      IF   l_cracha > 0 THEN
                           /*Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                           SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                           IF (l_crapri = 0) THEN
                               l_crapri := l_cracha;
                           END IF;
                           /* atualiza r070con */
                           l_iniafa := '0000000000000000';
                           l_datafa := '0000000000000000';

                           LOOP
                               BEGIN
                                   /* Atualiza todos os numeros fisicos por causa da sincronia de lista */
                                   UPDATE R070CON SET INIAFA=l_iniafa, DATAFA=l_datafa WHERE (NUMFIS = l_crapri) OR (NUMFIS = l_numbar) OR (NUMFIS = l_numpro) OR (NUMFIS = l_numsma);
                               EXCEPTION
                                   WHEN OTHERS THEN RAISERROR 103 'SPHisAFa - Erro no update r070con.';
                               END;
                               /* Controle do Looping, onde deve ser efetuado o update no cracha provisorio caso o mesmo exista.*/
                               SP_RETCRA_IDTPES (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
                               IF (l_cracha_pro = l_cracha) OR  (l_cracha_pro = 0) THEN
                                 EXIT;
                               ELSE
                                  l_cracha := l_cracha_pro;
                                  /* Atualiza o Cracha Principal e obtem o(s) numero(s) fisico(s). */
                                  SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
                                  IF (l_crapri = 0) THEN
                                      l_crapri := l_cracha;
                                  END IF;
                               END IF;
                           END LOOP;
                      END IF;
                 END IF;
            END IF;
       END IF;
      IF (l_crapri = 0) THEN
          /* Verifica se Colaborador possui Cracha */
          SP_RETCRA_IDTPES (1, p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
          IF   l_cracha > 0 THEN
               /* Atualiza o Cracha¡ Principal e obtem o(s) numero(s) fisico(s). */
               SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
               IF (l_crapri = 0) THEN
                   l_crapri := l_cracha;
               END IF;
          END IF;
      END IF;
      IF (l_crapri <> 0) THEN
          /*Obtem o Tipo de Pessoa*/
          SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
          SP_INTSTR(p_numemp,'9999',l_numemp OUT);
          SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
          SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
          l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
          /*Preenche o campo com espacos para completar 23 posicoes*/
          l_idtpes := lTrim(l_idtpes);
          l_idtpes := rTrim(l_idtpes);
          LOOP
              /*Controle do Loop.*/
              IF (Length(l_idtpes) > 22) THEN
                  EXIT;
              END IF;
              l_idtpes := ' '||l_idtpes;
          END LOOP;
          /*Procedure que atualiza a controle*/
          SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
      END IF;
  END IF;
END␀Sø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
‚PROCEDURE SP_HisAsa(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_NUMMAT VARCHAR2(15),P_DATAFA DATE)
 IS
BEGIN
  NULL;
END		SENIOR;20XSP_RETCRA
