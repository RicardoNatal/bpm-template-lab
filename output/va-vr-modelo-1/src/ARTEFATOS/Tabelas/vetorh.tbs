      /*Tratamento para envio da pendência*/
      IF ((p_old_tipins = 1) OR (p_old_tipins = 3)) THEN
          IF (p_old_tipins = 3) THEN
              l_old_tipins := 2;
          ELSE
              l_old_tipins := p_old_tipins;
          END IF;

          IF (p_old_numcgc IS NULL) THEN
              l_old_numcgc := 0;
          ELSE
              l_old_numcgc := p_old_numcgc;
          END IF;
      ELSE
          l_old_tipins := 0;
