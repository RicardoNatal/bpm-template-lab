DECLARE
	l_coddsp VARCHAR2(9);

BEGIN
	IF (:NEW.PORCOM <> :OLD.PORCOM) OR (:NEW.CODSEQ <> :OLD.CODSEQ) THEN
		SP_INTSTR(:NEW.CODDSP, '999999999', l_coddsp OUT);
		SP_SAM_PENDENCIES(23, 2, l_coddsp);
	END IF;

