×␀␀CREATE OR REPLACE PROCEDURE sp_r124hcf(pnumemp IN r124hcf.numemp%TYPE
                                      ,ptipcol r124hcf.tipcol%TYPE
                                      ,pnumcad r124hcf.numcad%TYPE
                                      ,pseqhcf r124hcf.seqhcf%TYPE
                                      ,pcodcuf r124hcf.codcuf%TYPE
                                      ,pseqcfp r033hfo.seqcfp%TYPE) IS
BEGIN
  UPDATE r033hfo
     SET cercur =
         /* Busca o certificado */(SELECT r124hcf.cercur
                                     FROM r124hcf r124hcf
                                    WHERE r124hcf.numemp = pnumemp
                                      AND r124hcf.tipcol = ptipcol
                                      AND r124hcf.numcad = pnumcad
                                      AND r124hcf.codcuf = pcodcuf
                                      AND r124hcf.seqhcf = pseqhcf)
   WHERE codpes =
        /* Busca o código da pessoa */
         (SELECT r034fun.codpes
            FROM r034fun
           WHERE r034fun.numemp = pnumemp
             AND r034fun.tipcol = ptipcol
             AND r034fun.numcad = pnumcad)
     AND seqcfp = pseqcfp
     AND codcuf = pcodcuf;
END sp_r124hcf;

	MSSQL;0
B␀␀CREATE PROCEDURE sp_r124hcf(@p_NumEmp SMALLINT, @p_TipCol SMALLINT, @p_NumCad INTEGER, @p_SeqHcf SMALLINT, @p_CodCuf INTEGER, @p_SeqCfp INTEGER) AS
BEGIN
  UPDATE r033hfo 
     SET cercur = 
      /* Busca o certificado */
     (SELECT r124hcf.cercur r124hcf_cercur
        FROM r124hcf r124hcf
       WHERE r124hcf.numemp=@p_NumEmp 
         and r124hcf.tipcol=@p_TipCol 
         and r124hcf.numcad=@p_NumCad 
         and r124hcf.codcuf=@p_CodCuf 
         and r124hcf.seqhcf=@p_SeqHcf) 
  WHERE codpes = 
        /* Busca o código da pessoa */
        (select r034fun.codpes r034fun_codpes
           from r034fun r034fun
          where r034fun.numemp=@p_NumEmp 
            and r034fun.tipcol=@p_TipCol 
            and r034fun.numcad=@p_NumCad) 
    and seqcfp=@p_SeqCfp 
    and codcuf=@p_CodCuf 
END;

