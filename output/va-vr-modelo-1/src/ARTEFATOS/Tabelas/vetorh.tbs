ÕPROCEDURE SP_ATUPRM(P_NUMCRA NUMBER(12),P_NUMSER NUMBER(12),P_GRUPO CHAR(3),P_GRUPO1 CHAR(3),P_GRUPO2 CHAR(3),P_GRUPO3 CHAR(3),P_GRUPO_SAB CHAR(3),P_GRUPO_DOM CHAR(3),P_GRUPO_FER CHAR(3))
 IS
BEGIN
  NULL;
END		SENIOR;209SP_USUTEL
SP_INTSTR
SP_SELTSI
SP_CMDTSI
SP_RETICARD
ÖC␀␀PROCEDURE SP_ATUPRM(P_NUMCRA NUMBER(12),P_NUMSER NUMBER(12),P_GRUPO NUMBER(5),P_GRUPO1 CHAR(5),P_GRUPO2 CHAR(5),P_GRUPO3 CHAR(5),P_GRUPO_SAB NUMBER(5),P_GRUPO_DOM NUMBER(5),P_GRUPO_FER NUMBER(5))
IS

  l_usutel          VARCHAR(31);
  l_comando         VARCHAR(2048);
  l_retnumberaux    NUMBER;
  l_reterr          NUMBER(1);
  l_numcra          VARCHAR(12);
  l_numser          VARCHAR(12);
  l_grupo           CHAR(3);
  l_grupo1          CHAR(3);
  l_grupo2          CHAR(3);
  l_grupo3          CHAR(3);
  l_grupo_sab       CHAR(3);
  l_grupo_dom       CHAR(3);
  l_grupo_fer       CHAR(3);
  l_sel_grupo       CHAR(3);
  l_sel_grupo1      CHAR(3);
  l_sel_grupo2      CHAR(3);
  l_sel_grupo3      CHAR(3);
  l_sel_grupo_sab   CHAR(3);
  l_sel_grupo_dom   CHAR(3);
  l_sel_grupo_fer   CHAR(3);
  /*Variável com 5 posições*/
  l_grupo_5           CHAR(5);
  l_grupo1_5          CHAR(5);
  l_grupo2_5          CHAR(5);
  l_grupo3_5          CHAR(5);
  l_grupo_sab_5       CHAR(5);
  l_grupo_dom_5       CHAR(5);
  l_grupo_fer_5       CHAR(5);
  l_sel_grupo_5       CHAR(5);
  l_sel_grupo1_5      CHAR(5);
  l_sel_grupo2_5      CHAR(5);
  l_sel_grupo3_5      CHAR(5);
  l_sel_grupo_sab_5   CHAR(5);
  l_sel_grupo_dom_5   CHAR(5);
  l_sel_grupo_fer_5   CHAR(5);
  l_noDataFound     BOOLEAN;
  l_pndgrp          CHAR(1);
  l_ediprm          CHAR(5);
  l_newprm          BOOLEAN;
  l_icardR          VARCHAR(12);
BEGIN
  l_reterr := 0;
  /*Verifica se possui a tabela Pend_Grupo*/
  BEGIN
      SELECT PNDGRP INTO l_pndgrp FROM R070TSI;
  EXCEPTION
    WHEN OTHERS THEN
      l_pndgrp := 'N';
  END;

  /*Usuário da telemática*/
  SP_USUTEL(l_usutel OUT);

  BEGIN
      SELECT EDIPRM INTO l_ediprm FROM R000ASS;
      IF (l_ediprm = '99999') THEN
          l_newprm := TRUE;
      ELSE
          l_newprm := FALSE;
      END IF;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'SP_ATUPRM: Não conseguiu obter a máscara da permissão R000ASS.EDIPRM.';
  END;

  IF (l_pndgrp = 'S') THEN

      SP_RETICARD(NULL, p_numcra, l_numcra OUT, l_icardR OUT, l_numser OUT);

      /*Inicialização de Variáveis*/
      SP_INTSTR(p_numser,'9999999999',l_numser OUT);

      IF (p_grupo1 IS NULL) OR (p_grupo1 = '0') OR (p_grupo1 = '000') THEN
          l_grupo1_5 := '00000';
      ELSE
          l_grupo1_5 := p_grupo1;
      END IF;

      IF (p_grupo2 IS NULL) OR (p_grupo2 = '0') OR (p_grupo2 = '000') THEN
          l_grupo2_5 := '00000';
      ELSE
          l_grupo2_5 := p_grupo2;
      END IF;

      IF (p_grupo3 IS NULL) OR (p_grupo3 = '0') OR (p_grupo3 = '000') THEN
          l_grupo3_5 := '00000';
      ELSE
          l_grupo3_5 := p_grupo3;
      END IF;

      IF (l_newprm = TRUE) THEN
          SP_INTSTR(p_grupo,'99999',l_grupo_5 OUT);
          SP_INTSTR(p_grupo_sab,'99999',l_grupo_sab_5 OUT);
          SP_INTSTR(p_grupo_dom,'99999',l_grupo_dom_5 OUT);
          SP_INTSTR(p_grupo_fer,'99999',l_grupo_fer_5 OUT);
      ELSE
          SP_INTSTR(p_grupo,'999',l_grupo OUT);
          SP_INTSTR(p_grupo_sab,'999',l_grupo_sab OUT);
          SP_INTSTR(p_grupo_dom,'999',l_grupo_dom OUT);
          SP_INTSTR(p_grupo_fer,'999',l_grupo_fer OUT);
          l_grupo1 := SUBSTRING(l_grupo1_5,3,3);
          l_grupo2 := SUBSTRING(l_grupo2_5,3,3);
          l_grupo3 := SUBSTRING(l_grupo3_5,3,3);
      END IF; 
      l_noDataFound:= FALSE;
      BEGIN
          IF (l_newprm = TRUE) THEN

              l_comando := 'SELECT GRUPO FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo_5', l_comando, l_retnumberaux OUT,     l_sel_grupo_5 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO1 FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo1_5', l_comando, l_retnumberaux OUT,    l_sel_grupo1_5 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO2 FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo2_5', l_comando, l_retnumberaux OUT,    l_sel_grupo2_5 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO3 FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo3_5', l_comando, l_retnumberaux OUT,    l_sel_grupo3_5 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO_SAB FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo_sab_5', l_comando, l_retnumberaux OUT, l_sel_grupo_sab_5 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO_DOM FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo_dom_5', l_comando, l_retnumberaux OUT, l_sel_grupo_dom_5 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO_FER FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo_fer_5', l_comando, l_retnumberaux OUT, l_sel_grupo_fer_5 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
          ELSE
              l_comando := 'SELECT GRUPO FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo', l_comando, l_retnumberaux OUT,       l_sel_grupo OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO1 FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo1', l_comando, l_retnumberaux OUT,      l_sel_grupo1 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO2 FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo2', l_comando, l_retnumberaux OUT,      l_sel_grupo2 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO3 FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo3', l_comando, l_retnumberaux OUT,      l_sel_grupo3 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO_SAB FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo_sab', l_comando, l_retnumberaux OUT,   l_sel_grupo_sab OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO_DOM FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo_dom', l_comando, l_retnumberaux OUT,   l_sel_grupo_dom OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO_FER FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo_fer', l_comando, l_retnumberaux OUT,   l_sel_grupo_fer OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
          END IF;
      EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_noDataFound:=TRUE;
          WHEN OTHERS THEN
            RAISERROR 103 'SPATUPENDGRUPO: Erro No SELECT Pend_Grupo. ';
      END;
      IF ((l_sel_grupo IS NULL) AND (l_sel_grupo_5 IS NULL)) THEN
          l_noDataFound := TRUE;
      END IF;
      /*Atualiza conforme necessário*/
      IF (l_noDataFound = FALSE) THEN
          BEGIN
              IF (l_grupo <> '000') OR
                 (l_grupo_5 <> '00000') THEN
                  IF (l_sel_grupo <> l_grupo) OR
                     (l_sel_grupo_5 <> l_grupo_5) THEN
                      IF (l_newprm = TRUE) THEN
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_ANT = GRUPO, GRUPO = '''||l_grupo_5||
                                       ''' , NUMSERIAL = '''||l_numser||''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      ELSE
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_ANT = GRUPO, GRUPO = '''||l_grupo||
                                       ''' , NUMSERIAL = '''||l_numser||''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      END IF;
                  END IF;
              END IF;

              IF (l_grupo1 <> '000') OR
                 (l_grupo1_5 <> '00000') THEN
                  IF (l_sel_grupo1 <> l_grupo1) OR
                     (l_sel_grupo1_5 <> l_grupo1_5) THEN
                      IF (l_newprm = TRUE) THEN
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO1_ANT = GRUPO1, GRUPO1 = '''||l_grupo1_5||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      ELSE
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO1_ANT = GRUPO1, GRUPO1 = '''||l_grupo1||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      END IF;
                  END IF;
              END IF;

              IF (l_grupo2 <> '000') OR
                 (l_grupo2_5 <> '00000') THEN
                  IF (l_sel_grupo2 <> l_grupo2) OR
                     (l_sel_grupo2_5 <> l_grupo2_5) THEN
                      IF (l_newprm = TRUE) THEN
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO2_ANT = GRUPO2, GRUPO2 = '''||l_grupo2_5||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      ELSE
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO2_ANT = GRUPO2, GRUPO2 = '''||l_grupo2||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      END IF;
                  END IF;
              END IF;

              IF (l_grupo3 <> '000') OR
                 (l_grupo3_5 <> '00000') THEN
                  IF (l_sel_grupo3 <> l_grupo3) OR
                     (l_sel_grupo3_5 <> l_grupo3_5) THEN
                      IF (l_newprm = TRUE) THEN
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO3_ANT = GRUPO3, GRUPO3 = '''||l_grupo3_5||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      ELSE
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO3_ANT = GRUPO3, GRUPO3 = '''||l_grupo3||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      END IF;
                  END IF;
              END IF;

              IF (l_grupo_sab <> '000') OR
                 (l_grupo_sab_5 <> '00000') THEN
                  IF (l_sel_grupo_sab <> l_grupo_sab) OR
                     (l_sel_grupo_sab_5 <> l_grupo_sab_5) THEN
                      IF (l_newprm = TRUE) THEN
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_SAB_ANT = GRUPO_SAB, GRUPO_SAB = '''||l_grupo_sab_5||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      ELSE
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_SAB_ANT = GRUPO_SAB, GRUPO_SAB = '''||l_grupo_sab||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      END IF;
                  END IF;
              END IF;

              IF (l_grupo_dom <> '000') OR
                 (l_grupo_dom_5 <> '00000') THEN
                  IF (l_sel_grupo_dom <> l_grupo_dom) OR
                     (l_sel_grupo_dom_5 <> l_grupo_dom_5) THEN
                      IF (l_newprm = TRUE) THEN
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_DOM_ANT = GRUPO_DOM, GRUPO_DOM = '''||l_grupo_dom_5||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      ELSE
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_DOM_ANT = GRUPO_DOM, GRUPO_DOM = '''||l_grupo_dom||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      END IF;
                  END IF;
              END IF;

              IF (l_grupo_fer <> '000') OR
                 (l_grupo_fer_5 <> '00000') THEN
                  IF (l_sel_grupo_fer <> l_grupo_fer) OR
                     (l_sel_grupo_fer_5 <> l_grupo_fer_5) THEN
                      IF (l_newprm = TRUE) THEN
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_FER_ANT = GRUPO_FER, GRUPO_FER = '''||l_grupo_fer_5||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      ELSE
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_FER_ANT = GRUPO_FER, GRUPO_FER = '''||l_grupo_fer||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      END IF;
                  END IF;
              END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SPATUPENDGRUPO: Erro No UPDATE Pend_Grupo. ';
          END;
      ELSE
          BEGIN
              /*Limpa os Registros antigos do crachá que será inserido*/
              l_comando := 'DELETE FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||''' OR NUMSERIAL = '''||l_numser||'''';
              SP_CMDTSI(l_comando);

              IF (l_newprm = TRUE) THEN
                  l_comando := 'INSERT INTO '||l_usutel||'PEND_GRUPO (ICARD, NUMSERIAL, GRUPO, GRUPO1, GRUPO2, GRUPO3, GRUPO_SAB, '||
                               'GRUPO_DOM, GRUPO_FER) VALUES ('''||l_numcra||''', '''||l_numser||''', '''||l_grupo_5||
                               ''', '''||l_grupo1_5||''', '''||l_grupo2_5||''', '''||l_grupo3_5||''', '''||l_grupo_sab_5||
                               ''', '''||l_grupo_dom_5||''', '''||l_grupo_fer_5||''')';
                  SP_CMDTSI(l_comando);
              ELSE
                  l_comando := 'INSERT INTO '||l_usutel||'PEND_GRUPO (ICARD, NUMSERIAL, GRUPO, GRUPO1, GRUPO2, GRUPO3, GRUPO_SAB, '||
                               'GRUPO_DOM, GRUPO_FER) VALUES ('''||l_numcra||''', '''||l_numser||''', '''||l_grupo||
                               ''', '''||l_grupo1||''', '''||l_grupo2||''', '''||l_grupo3||''', '''||l_grupo_sab||
                               ''', '''||l_grupo_dom||''', '''||l_grupo_fer||''')';
                  SP_CMDTSI(l_comando);
              END IF;

          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SPATUPENDGRUPO: Erro No INSERT Pend_Grupo. ';
          END;
      END IF;
  END IF;
END		SENIOR;239SP_USUTEL
SP_INTSTR
SP_SELTSI
SP_CMDTSI
SP_RETICARD
ÖC␀␀PROCEDURE SP_ATUPRM(P_NUMCRA NUMBER(12),P_NUMSER NUMBER(12),P_GRUPO NUMBER(5),P_GRUPO1 CHAR(5),P_GRUPO2 CHAR(5),P_GRUPO3 CHAR(5),P_GRUPO_SAB NUMBER(5),P_GRUPO_DOM NUMBER(5),P_GRUPO_FER NUMBER(5))
IS

  l_usutel          VARCHAR(31);
  l_comando         VARCHAR(2048);
  l_retnumberaux    NUMBER;
  l_reterr          NUMBER(1);
  l_numcra          VARCHAR(12);
  l_numser          VARCHAR(12);
  l_grupo           CHAR(3);
  l_grupo1          CHAR(3);
  l_grupo2          CHAR(3);
  l_grupo3          CHAR(3);
  l_grupo_sab       CHAR(3);
  l_grupo_dom       CHAR(3);
  l_grupo_fer       CHAR(3);
  l_sel_grupo       CHAR(3);
  l_sel_grupo1      CHAR(3);
  l_sel_grupo2      CHAR(3);
  l_sel_grupo3      CHAR(3);
  l_sel_grupo_sab   CHAR(3);
  l_sel_grupo_dom   CHAR(3);
  l_sel_grupo_fer   CHAR(3);
  /*Variável com 5 posições*/
  l_grupo_5           CHAR(5);
  l_grupo1_5          CHAR(5);
  l_grupo2_5          CHAR(5);
  l_grupo3_5          CHAR(5);
  l_grupo_sab_5       CHAR(5);
  l_grupo_dom_5       CHAR(5);
  l_grupo_fer_5       CHAR(5);
  l_sel_grupo_5       CHAR(5);
  l_sel_grupo1_5      CHAR(5);
  l_sel_grupo2_5      CHAR(5);
  l_sel_grupo3_5      CHAR(5);
  l_sel_grupo_sab_5   CHAR(5);
  l_sel_grupo_dom_5   CHAR(5);
  l_sel_grupo_fer_5   CHAR(5);
  l_noDataFound     BOOLEAN;
  l_pndgrp          CHAR(1);
  l_ediprm          CHAR(5);
  l_newprm          BOOLEAN;
  l_icardR          VARCHAR(12);
BEGIN
  l_reterr := 0;
  /*Verifica se possui a tabela Pend_Grupo*/
  BEGIN
      SELECT PNDGRP INTO l_pndgrp FROM R070TSI;
  EXCEPTION
    WHEN OTHERS THEN
      l_pndgrp := 'N';
  END;

  /*Usuário da telemática*/
  SP_USUTEL(l_usutel OUT);

  BEGIN
      SELECT EDIPRM INTO l_ediprm FROM R000ASS;
      IF (l_ediprm = '99999') THEN
          l_newprm := TRUE;
      ELSE
          l_newprm := FALSE;
      END IF;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'SP_ATUPRM: Não conseguiu obter a máscara da permissão R000ASS.EDIPRM.';
  END;

  IF (l_pndgrp = 'S') THEN

      SP_RETICARD(NULL, p_numcra, l_numcra OUT, l_icardR OUT, l_numser OUT);

      /*Inicialização de Variáveis*/
      SP_INTSTR(p_numser,'9999999999',l_numser OUT);

      IF (p_grupo1 IS NULL) OR (p_grupo1 = '0') OR (p_grupo1 = '000') THEN
          l_grupo1_5 := '00000';
      ELSE
          l_grupo1_5 := p_grupo1;
      END IF;

      IF (p_grupo2 IS NULL) OR (p_grupo2 = '0') OR (p_grupo2 = '000') THEN
          l_grupo2_5 := '00000';
      ELSE
          l_grupo2_5 := p_grupo2;
      END IF;

      IF (p_grupo3 IS NULL) OR (p_grupo3 = '0') OR (p_grupo3 = '000') THEN
          l_grupo3_5 := '00000';
      ELSE
          l_grupo3_5 := p_grupo3;
      END IF;

      IF (l_newprm = TRUE) THEN
          SP_INTSTR(p_grupo,'99999',l_grupo_5 OUT);
          SP_INTSTR(p_grupo_sab,'99999',l_grupo_sab_5 OUT);
          SP_INTSTR(p_grupo_dom,'99999',l_grupo_dom_5 OUT);
          SP_INTSTR(p_grupo_fer,'99999',l_grupo_fer_5 OUT);
      ELSE
          SP_INTSTR(p_grupo,'999',l_grupo OUT);
          SP_INTSTR(p_grupo_sab,'999',l_grupo_sab OUT);
          SP_INTSTR(p_grupo_dom,'999',l_grupo_dom OUT);
          SP_INTSTR(p_grupo_fer,'999',l_grupo_fer OUT);
          l_grupo1 := SUBSTRING(l_grupo1_5,3,3);
          l_grupo2 := SUBSTRING(l_grupo2_5,3,3);
          l_grupo3 := SUBSTRING(l_grupo3_5,3,3);
      END IF; 
      l_noDataFound:= FALSE;
      BEGIN
          IF (l_newprm = TRUE) THEN

              l_comando := 'SELECT GRUPO FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo_5', l_comando, l_retnumberaux OUT,     l_sel_grupo_5 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO1 FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo1_5', l_comando, l_retnumberaux OUT,    l_sel_grupo1_5 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO2 FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo2_5', l_comando, l_retnumberaux OUT,    l_sel_grupo2_5 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO3 FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo3_5', l_comando, l_retnumberaux OUT,    l_sel_grupo3_5 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO_SAB FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo_sab_5', l_comando, l_retnumberaux OUT, l_sel_grupo_sab_5 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO_DOM FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo_dom_5', l_comando, l_retnumberaux OUT, l_sel_grupo_dom_5 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO_FER FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo_fer_5', l_comando, l_retnumberaux OUT, l_sel_grupo_fer_5 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
          ELSE
              l_comando := 'SELECT GRUPO FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo', l_comando, l_retnumberaux OUT,       l_sel_grupo OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO1 FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo1', l_comando, l_retnumberaux OUT,      l_sel_grupo1 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO2 FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo2', l_comando, l_retnumberaux OUT,      l_sel_grupo2 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO3 FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo3', l_comando, l_retnumberaux OUT,      l_sel_grupo3 OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO_SAB FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo_sab', l_comando, l_retnumberaux OUT,   l_sel_grupo_sab OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO_DOM FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo_dom', l_comando, l_retnumberaux OUT,   l_sel_grupo_dom OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
              l_comando := 'SELECT GRUPO_FER FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||'''';
              SP_SELTSI(1, 'l_sel_grupo_fer', l_comando, l_retnumberaux OUT,   l_sel_grupo_fer OUT, l_reterr OUT);
              IF l_reterr = 1 THEN
                /*EXCEÇÃO: NO DATA FOUND*/
                l_noDataFound := TRUE;
              END IF;
          END IF;
      EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_noDataFound:=TRUE;
          WHEN OTHERS THEN
            RAISERROR 103 'SPATUPENDGRUPO: Erro No SELECT Pend_Grupo. ';
      END;
      IF ((l_sel_grupo IS NULL) AND (l_sel_grupo_5 IS NULL)) THEN
          l_noDataFound := TRUE;
      END IF;
      /*Atualiza conforme necessário*/
      IF (l_noDataFound = FALSE) THEN
          BEGIN
              IF (l_grupo <> '000') OR
                 (l_grupo_5 <> '00000') THEN
                  IF (l_sel_grupo <> l_grupo) OR
                     (l_sel_grupo_5 <> l_grupo_5) THEN
                      IF (l_newprm = TRUE) THEN
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_ANT = GRUPO, GRUPO = '''||l_grupo_5||
                                       ''' , NUMSERIAL = '''||l_numser||''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      ELSE
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_ANT = GRUPO, GRUPO = '''||l_grupo||
                                       ''' , NUMSERIAL = '''||l_numser||''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      END IF;
                  END IF;
              END IF;

              IF (l_grupo1 <> '000') OR
                 (l_grupo1_5 <> '00000') THEN
                  IF (l_sel_grupo1 <> l_grupo1) OR
                     (l_sel_grupo1_5 <> l_grupo1_5) THEN
                      IF (l_newprm = TRUE) THEN
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO1_ANT = GRUPO1, GRUPO1 = '''||l_grupo1_5||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      ELSE
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO1_ANT = GRUPO1, GRUPO1 = '''||l_grupo1||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      END IF;
                  END IF;
              END IF;

              IF (l_grupo2 <> '000') OR
                 (l_grupo2_5 <> '00000') THEN
                  IF (l_sel_grupo2 <> l_grupo2) OR
                     (l_sel_grupo2_5 <> l_grupo2_5) THEN
                      IF (l_newprm = TRUE) THEN
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO2_ANT = GRUPO2, GRUPO2 = '''||l_grupo2_5||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      ELSE
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO2_ANT = GRUPO2, GRUPO2 = '''||l_grupo2||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      END IF;
                  END IF;
              END IF;

              IF (l_grupo3 <> '000') OR
                 (l_grupo3_5 <> '00000') THEN
                  IF (l_sel_grupo3 <> l_grupo3) OR
                     (l_sel_grupo3_5 <> l_grupo3_5) THEN
                      IF (l_newprm = TRUE) THEN
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO3_ANT = GRUPO3, GRUPO3 = '''||l_grupo3_5||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      ELSE
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO3_ANT = GRUPO3, GRUPO3 = '''||l_grupo3||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      END IF;
                  END IF;
              END IF;

              IF (l_grupo_sab <> '000') OR
                 (l_grupo_sab_5 <> '00000') THEN
                  IF (l_sel_grupo_sab <> l_grupo_sab) OR
                     (l_sel_grupo_sab_5 <> l_grupo_sab_5) THEN
                      IF (l_newprm = TRUE) THEN
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_SAB_ANT = GRUPO_SAB, GRUPO_SAB = '''||l_grupo_sab_5||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      ELSE
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_SAB_ANT = GRUPO_SAB, GRUPO_SAB = '''||l_grupo_sab||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      END IF;
                  END IF;
              END IF;

              IF (l_grupo_dom <> '000') OR
                 (l_grupo_dom_5 <> '00000') THEN
                  IF (l_sel_grupo_dom <> l_grupo_dom) OR
                     (l_sel_grupo_dom_5 <> l_grupo_dom_5) THEN
                      IF (l_newprm = TRUE) THEN
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_DOM_ANT = GRUPO_DOM, GRUPO_DOM = '''||l_grupo_dom_5||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      ELSE
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_DOM_ANT = GRUPO_DOM, GRUPO_DOM = '''||l_grupo_dom||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      END IF;
                  END IF;
              END IF;

              IF (l_grupo_fer <> '000') OR
                 (l_grupo_fer_5 <> '00000') THEN
                  IF (l_sel_grupo_fer <> l_grupo_fer) OR
                     (l_sel_grupo_fer_5 <> l_grupo_fer_5) THEN
                      IF (l_newprm = TRUE) THEN
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_FER_ANT = GRUPO_FER, GRUPO_FER = '''||l_grupo_fer_5||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      ELSE
                          l_comando := 'UPDATE '||l_usutel||'PEND_GRUPO SET GRUPO_FER_ANT = GRUPO_FER, GRUPO_FER = '''||l_grupo_fer||''', NUMSERIAL = '''||l_numser||
                                       ''' WHERE ICARD = '''||l_numcra||'''';
                          SP_CMDTSI(l_comando);
                      END IF;
                  END IF;
              END IF;
          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SPATUPENDGRUPO: Erro No UPDATE Pend_Grupo. ';
          END;
      ELSE
          BEGIN
              /*Limpa os Registros antigos do crachá que será inserido*/
              l_comando := 'DELETE FROM '||l_usutel||'PEND_GRUPO WHERE ICARD = '''||l_numcra||''' OR NUMSERIAL = '''||l_numser||'''';
              SP_CMDTSI(l_comando);

              IF (l_newprm = TRUE) THEN
                  l_comando := 'INSERT INTO '||l_usutel||'PEND_GRUPO (ICARD, NUMSERIAL, GRUPO, GRUPO1, GRUPO2, GRUPO3, GRUPO_SAB, '||
                               'GRUPO_DOM, GRUPO_FER) VALUES ('''||l_numcra||''', '''||l_numser||''', '''||l_grupo_5||
                               ''', '''||l_grupo1_5||''', '''||l_grupo2_5||''', '''||l_grupo3_5||''', '''||l_grupo_sab_5||
                               ''', '''||l_grupo_dom_5||''', '''||l_grupo_fer_5||''')';
                  SP_CMDTSI(l_comando);
              ELSE
                  l_comando := 'INSERT INTO '||l_usutel||'PEND_GRUPO (ICARD, NUMSERIAL, GRUPO, GRUPO1, GRUPO2, GRUPO3, GRUPO_SAB, '||
                               'GRUPO_DOM, GRUPO_FER) VALUES ('''||l_numcra||''', '''||l_numser||''', '''||l_grupo||
                               ''', '''||l_grupo1||''', '''||l_grupo2||''', '''||l_grupo3||''', '''||l_grupo_sab||
                               ''', '''||l_grupo_dom||''', '''||l_grupo_fer||''')';
                  SP_CMDTSI(l_comando);
              END IF;

          EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'SPATUPENDGRUPO: Erro No INSERT Pend_Grupo. ';
          END;
      END IF;
  END IF;
END␀ğ÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
œ/*
 * Atualiza as permissões por local físico da pessoa
 */
PROCEDURE SP_ATUPRMLOC(P_IDTPES VARCHAR2(23),P_NUMCRA NUMBER(12))
 IS
BEGIN
    NULL;
END		SENIOR;20TSP_PESFROMIDTPES
SP_RETCRA
SP_PEND79
SP_USUTEL
SP_INTSTR
SP_CMDTSI
SP_MAPFIS
›M␀␀

PROCEDURE SP_ATUPRMLOC(P_IDTPES VARCHAR2(23),P_NUMCRA NUMBER(12))
 IS
 
  l_cracha       NUMBER(12);
  l_tippes       NUMBER(2);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);
  l_tipdoc       NUMBER(1);
  l_coddsp_aux   NUMBER(9);
  l_numdoc       VARCHAR2(20);
  l_nummat       VARCHAR2(15);
  l_propac       VARCHAR2(20);
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_PrmDspCSM    NUMBER;  /* tem permissão por local físico em dispositivos demais */

  /*CAMPOS PARA INTEGRAÇÃO COM TELEMÁTICA*/
  l_matcod       CHAR(1);
  l_verplf       NUMBER(3);
  l_codplf       NUMBER(7);
  l_blueb        CHAR(2);
  l_codin        CHAR(2);
  l_codplf_dsp   NUMBER(7);
  l_codplf_pai   NUMBER(7);
  l_count_fai    NUMBER(2);
  l_inifai_str   CHAR(4);
  l_fimfai_str   CHAR(4);
  l_usutel       VARCHAR(31);
  l_comando      VARCHAR(512);
  l_comando_ins  VARCHAR(512);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numbar_str   CHAR(12);
  l_numpro_str   CHAR(12);
  l_numsma_str   CHAR(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_icard        CHAR(12);
  l_faiprm       VARCHAR(56); /* 7 FAIXAS - Ex de faixa: 12001330 --> 12:00 até 13:30 */
  l_dia_sem_str  CHAR(1);
  l_dia_sem      NUMBER(1); /*   1 = Domingo       */
                            /*   2 = Segunda-feira */
                            /*   3 = Terça-feira   */
                            /*   4 = Quarta-feira  */
                            /*   5 = Quinta-feira  */
                            /*   6 = Sexta-feira   */
                            /*   7 = Sábado        */
                            /*   8 = Feriado       */
  l_acofai       NUMBER(1); /* 1 = Liberado        */
                            /* 2 = Utiliza faixa pai */

  /* tratamento para utilizar número físico como principal*/
  l_chcAce       NUMBER(1);

  /*retornar todos os dispositivos telemática da pessoa*/
  CURSOR C_R034PRM_LOC IS
         SELECT R034PRM.CODDSP, R058RLG.CODCEN, R058RLG.RLGALF, R058RLG.NUMEIP
           FROM R034PRM R034PRM
              , R058RLG R058RLG
              , R058MOD R058MOD
          WHERE R034PRM.IDTPES = p_idtpes
            AND R058RLG.CODDSP = R034PRM.CODDSP
            AND R058MOD.MODRLG = R058RLG.MODRLG
            AND R058MOD.FABMOD = 1
            AND R058RLG.COMRLG = 2;
  TYPE T_R034PRM_LOC IS RECORD (CODDSP   R058RLG.CODDSP%TYPE
                               ,CODCEN   R058RLG.CODCEN%TYPE
                               ,RLGALF   R058RLG.RLGALF%TYPE
                               ,NUMEIP   R058RLG.NUMEIP%TYPE);
  l_r034prm_loc T_R034PRM_LOC;

  CURSOR C_R034FAP_LOC IS
         SELECT INIFAI, FIMFAI
           FROM R034FAP
          WHERE IDTPES = p_idtpes
            AND CODDSP = l_coddsp_aux
            AND VERPLF = l_verplf
            AND CODPLF = l_codplf
            AND DIASEM = l_dia_sem
          ORDER BY INIFAI ASC;
  TYPE T_R034FAP_LOC IS RECORD (INIFAI   R034FAP.INIFAI%TYPE
                               ,FIMFAI   R034FAP.FIMFAI%TYPE);
  l_r034fap_loc T_R034FAP_LOC;
  /*FIM CAMPOS PARA INTEGRAÇÃO COM TELEMÁTICA*/
BEGIN
  l_PrmDspCSM := 0;
  BEGIN
      SELECT COUNT(*) INTO l_PrmDspCSM FROM R034PRM, R058RLG, R058MOD
          WHERE R034PRM.IDTPES = p_idtpes
            AND R058RLG.CODPLT = R034PRM.CODPLT
            AND R058RLG.CODRLG = R034PRM.CODRLG
            AND R058MOD.MODRLG = R058RLG.MODRLG
            AND R058MOD.FABMOD > 1
            AND R058RLG.COMRLG = 2;
  EXCEPTION
      WHEN OTHERS THEN l_PrmDspCSM := 0;
  END;

  /* Para TSI sempre chama a rotina, mesmo sem dispositivos na permissão */
  /* Pois pode ser o processo de exclusão */
  l_matcod := 'N';
  l_chcAce := 0;
  BEGIN
      SELECT CHCACE, MATCOD INTO l_chcAce, l_matcod FROM R070TSI;
  EXCEPTION
      WHEN OTHERS THEN
          l_chcAce:= 0;
          l_matcod := 'N';
  END;

  IF (l_PrmDspCSM > 0) OR (l_matcod = 'S') THEN
      l_cracha     := 0;
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_data_atual := CURDATE();
      l_data_zero  := '31/12/1900,00:00:00';

      /*RETORNA A PESSOA A PARTIR DO IDTPES*/
      SP_PESFROMIDTPES(p_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT
                               , l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);

      /*BUSCA O CRACHÁ, SENÃO INFORMADO*/
      IF (p_numcra = 0) THEN
          /*Visitante*/
          IF (l_tippes = 4) THEN
              BEGIN
                  SELECT NUMCRA INTO l_cracha FROM R090HCH
                   WHERE R090HCH.TIPDOC = l_tipdoc AND
                     R090HCH.NUMDOC = l_numdoc AND
                     (R090HCH.DATINI < l_data_atual OR
                      (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
                     (R090HCH.DATFIM = l_data_zero OR
                      R090HCH.DATFIM > l_data_atual OR
                      (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro em R090HCH - TOO MANY ROWS';
                  WHEN NO_DATA_FOUND THEN  l_cracha := 0;
                  WHEN OTHERS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro no SELECT R090HCH.';
              END;
          ELSE
              /*Paciente*/
              IF (l_tippes = 9) THEN
                  BEGIN
                      SELECT NUMCRA INTO l_cracha FROM R097INT
                       WHERE PROPAC = l_propac
                         AND ( (DATFIM > l_data_atual) OR
                             ((DATFIM = l_data_atual) AND (HORFIM >= l_hora_atual)) OR
                             (DATFIM = l_data_zero) );
                  EXCEPTION
                      WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro em R097INT - TOO MANY ROWS';
                      WHEN NO_DATA_FOUND THEN l_cracha := 0;
                      WHEN OTHERS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro no SELECT R097INT.';
                  END;
              ELSE
                  /*Outras unidades*/
                  IF (l_tippes = 5) THEN
                      SP_RETCRA (2, l_numemp, 5, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                      IF   (l_cracha = 0)  THEN
                          SP_RETCRA (1, l_numemp, 5, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                      END IF;
                  ELSE
                  /* Aluno */
                      IF (l_tippes = 10) THEN
                          SP_RETCRA (2, l_numemp, 6, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                          IF   (l_cracha = 0)  THEN
                              SP_RETCRA (1, l_numemp, 6, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                          END IF;
                      ELSE
                          /* Colaboradores */
                          IF (l_tippes < 4) THEN
                              SP_RETCRA (2, l_numemp, l_tipcol, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                              IF   (l_cracha = 0)  THEN
                                  SP_RETCRA (1, l_numemp, l_tipcol, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                              END IF;
                          END IF;
                      END IF;
                  END IF;
              END IF;
          END IF;
      ELSE   /*CASO O CRACHÁ FOR INFORMADO NO PARÂMETRO*/
          l_cracha := p_numcra;
      END IF;

      /*Efetua as operações somente se existir crachá ativo*/
      IF (l_cracha <> 0) THEN

          /* Só gerar se tiver permissão por local físico em dispositivos <> TSI */
          /* A exclusão é feita pela tela */
          IF (l_PrmDspCSM > 0) THEN
              SP_PEND79(p_idtpes); /*GERA PENDÊNCIA 79. UPDATEPersonPrecisionPermission, para a concentradora*/
          END IF;

          /**** INÍCIO INTEGRAÇÃO TELEMÁTICA ****/
          IF (l_matcod = 'S') THEN
              l_dia_sem   := 0;
              l_count_fai := 0;
              SP_USUTEL(l_usutel OUT);
              l_verplf := 1;

              /*Sempre remove o crachá lógico para evitar sobreposições*/
              SP_INTSTR(l_cracha,'999999999999', l_icard OUT);
              l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_icard||'''';
              SP_CMDTSI(l_comando);


              SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
		      /*Se utilizar definição para gravar número físico no ICARD salva igual como é salvo na tabela CONTROLE*/
		      IF (l_chcAce = 1) THEN
                  /*remove todas as definições da pessoa antes de inserir*/
                  IF (l_numbar > 0) THEN
                      SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
                  IF (l_numpro > 0) THEN
                      SP_INTSTR(l_numpro,'999999999999', l_numpro_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numpro_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
                  IF (l_numsma > 0) THEN
                      SP_INTSTR(l_numsma, '999999999999', l_numsma_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numsma_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
		      ELSE
                  IF (l_chcAce = 3) THEN
                      IF (l_numbar > 0) THEN
	                      SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
	                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
	                      SP_CMDTSI(l_comando);
	                  END IF;
	                  IF (l_numsma > 0) THEN
	                      SP_INTSTR(l_numsma, '999999999999', l_numsma_str OUT);
	                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numsma_str||'''';
	                      SP_CMDTSI(l_comando);
	                  END IF;
                  ELSE
	                 IF (l_crapri > 0) AND ((l_tecpri < 3) OR (l_chcAce = 3))  THEN
	                     /*remove todas as definições da pessoa antes de inserir*/
	                     IF (l_numbar > 0) THEN
	                         SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
	                         l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
	                         SP_CMDTSI(l_comando);
	                     END IF;
	                     IF (l_numpro > 0) THEN
	                         SP_INTSTR(l_numpro,'999999999999', l_numpro_str OUT);
	                         l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numpro_str||'''';
	                         SP_CMDTSI(l_comando);
	                     END IF;
	                 END IF;
                  END IF;
		      END IF;


              /*VARRE TODOS OS DISPOSITIVOS PARA ALIMENTAR AS TABELAS DA TELEMÁTICA*/
              FOREACH C_R034PRM_LOC INTO l_r034prm_loc.CODDSP
                                       , l_r034prm_loc.CODCEN
                                       , l_r034prm_loc.RLGALF
                                       , l_r034prm_loc.NUMEIP
              LOOP

                  BEGIN
                      SELECT CODPLF INTO l_codplf_dsp FROM R058DSP WHERE CODDSP = l_r034prm_loc.CODDSP;
                  EXCEPTION
                      WHEN OTHERS THEN l_codplf_dsp := 0;
                  END;

                  l_dia_sem := 1;

                  /*VARRE OS DIAS DA SEMANA*/
                  LOOP
                      l_codplf_pai := l_codplf_dsp;
                      l_codplf     := l_codplf_dsp;
                      l_coddsp_aux := l_r034prm_loc.CODDSP;
                      /*BUSCA A AÇÃO DA FAIXA PARA O DIA*/
                      BEGIN
                          SELECT ACOFAI INTO l_acofai FROM R034AFD
                           WHERE IDTPES = p_idtpes AND CODDSP = l_r034prm_loc.CODDSP AND DIASEM = l_dia_sem ;
                      EXCEPTION
                          WHEN OTHERS THEN l_acofai := 0;
                      END;

                      /*ENQUANTO EXISTIR AÇÃO NA FAIXA*/
                      LOOP
                          IF ( l_acofai = 0 ) THEN
                              EXIT;
                          END IF;

                          /*LIBERADO, deve buscar as faixas*/
                          IF ( l_acofai = 1 ) THEN
                              l_count_fai := 0;
                              l_faiprm := '';
                              /*BUSCA AS FAIXAS*/
                              FOREACH C_R034FAP_LOC INTO l_r034fap_loc.INIFAI, l_r034fap_loc.FIMFAI
                              LOOP
                                  l_count_fai := l_count_fai + 1;
                                  SP_INTSTR(l_r034fap_loc.INIFAI, 'HHMM', l_inifai_str OUT);
                                  SP_INTSTR(l_r034fap_loc.FIMFAI, 'HHMM', l_fimfai_str OUT);
                                  l_faiprm := l_faiprm || l_inifai_str || l_fimfai_str;
                              END LOOP;

                              IF ( l_count_fai = 0 ) THEN
                                  /*sem faixa e liberado = 00:00 ás 23:59 para este dia*/
                                  l_faiprm := '00002359';
                                  l_count_fai := 1;
                              END IF;

                              /*valida se faltou faixas*/
                              LOOP
                                  IF ( l_count_fai = 7 ) THEN
                                      EXIT;
                                  END IF;
                                  l_faiprm := l_faiprm || '24002400';
                                  l_count_fai := l_count_fai + 1;
                              END LOOP;

                              l_comando := 'INSERT INTO '||l_usutel||'MATCODIN (END_IP,BLUEB,CODIN,DIASEM,FXPERM,ICARD) ';
                              /*caso ip zerado, utiliza o rlgalf e codcen*/
                              IF (l_r034prm_loc.NUMEIP = '000.000.000.000') THEN
                                  SP_INTSTR(l_r034prm_loc.CODCEN, '99', l_blueb OUT);
                                  l_codin := SUBSTRING(l_r034prm_loc.RLGALF,1, 2);
                                  l_comando := l_comando || ' VALUES(''000.000.000.000'',''' || l_blueb || ''',''' || l_codin || '''';
                              ELSE
                                  l_comando := l_comando || ' VALUES(''' || l_r034prm_loc.NUMEIP || ''',''00'',''00''';
                              END IF;
                              SP_INTSTR(l_dia_sem, '9', l_dia_sem_str OUT);
                              l_comando := l_comando || ','''||l_dia_sem_str||''','''||l_faiprm||''',';

						      /*Se utilizar definição para gravar número físico no ICARD salva igual como é salvo na tabela CONTROLE*/
						      IF (l_chcAce = 1) THEN
	                              /*insere as faixas*/
	                              IF (l_numbar > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
	                              IF (l_numpro > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numpro_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
	                              IF (l_numsma > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numsma_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
						      ELSE
                                  IF (l_chcAce = 3) THEN
                                      IF (l_numbar > 0) THEN
	                                      l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
	                                  IF (l_numsma > 0) THEN
	                                      l_comando_ins := l_comando || ' ''' || l_numsma_str || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
                                  ELSE
	                                  /*insere as faixas*/
	                                  IF (l_crapri > 0) AND (l_tecpri < 3)  THEN
	                                      IF (l_numbar > 0) THEN
	                                          l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                          SP_CMDTSI(l_comando_ins);
	                                      END IF;
	                                      IF (l_numpro > 0) THEN
	                                          l_comando_ins := l_comando || ' ''' || l_numpro_str || ''') ';
	                                          SP_CMDTSI(l_comando_ins);
	                                      END IF;
	                                  ELSE
	                                      l_comando_ins := l_comando || ' ''' || l_icard || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
                                  END IF;
						      END IF;
                              EXIT;
                          ELSE
                              /*UTILIZA FAIXA PAI, deve buscar as definições dos locais pais*/
                              IF (l_acofai = 2) THEN
                                  l_coddsp_aux := 0;
                                  l_codplf     := l_codplf_pai;
                                  /*BUSCA A AÇÃO DA FAIXA*/
                                  BEGIN
                                      SELECT ACOFAI INTO l_acofai FROM R034AFL
                                       WHERE IDTPES = p_idtpes
                                         AND CODPLF = l_codplf
                                         AND VERPLF = l_verplf
                                         AND DIASEM = l_dia_sem;
                                  EXCEPTION
                                      WHEN OTHERS THEN l_acofai := 0;
                                  END;

                                  /*BUSCA O LOCAL PAI*/
                                  BEGIN
                                      SELECT PAIPLF INTO l_codplf_pai FROM R058PLF WHERE CODPLF = l_codplf AND VERPLF = l_verplf;
                                  EXCEPTION
                                      WHEN OTHERS THEN l_codplf_pai := 0;
                                  END;
                              END IF;
                          END IF;
                      END LOOP;

                      l_dia_sem := l_dia_sem + 1;
                      IF (l_dia_sem > 8) THEN
                          EXIT;
                      END IF;
                  END LOOP;
              END LOOP;
          END IF; /**** FIM INTEGRAÇÃO TELEMÁTICA ****/
      END IF; /* (l_cracha <> 0) */
   END IF;  /* (l_PrmDspCSM > 0) OR (l_matcon = 'S') */
END		SENIOR;21TSP_PESFROMIDTPES
SP_RETCRA
SP_PEND79
SP_USUTEL
SP_INTSTR
SP_CMDTSI
SP_MAPFIS
›M␀␀

PROCEDURE SP_ATUPRMLOC(P_IDTPES VARCHAR2(23),P_NUMCRA NUMBER(12))
 IS
 
  l_cracha       NUMBER(12);
  l_tippes       NUMBER(2);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);
  l_tipdoc       NUMBER(1);
  l_coddsp_aux   NUMBER(9);
  l_numdoc       VARCHAR2(20);
  l_nummat       VARCHAR2(15);
  l_propac       VARCHAR2(20);
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_PrmDspCSM    NUMBER;  /* tem permissão por local físico em dispositivos demais */

  /*CAMPOS PARA INTEGRAÇÃO COM TELEMÁTICA*/
  l_matcod       CHAR(1);
  l_verplf       NUMBER(3);
  l_codplf       NUMBER(7);
  l_blueb        CHAR(2);
  l_codin        CHAR(2);
  l_codplf_dsp   NUMBER(7);
  l_codplf_pai   NUMBER(7);
  l_count_fai    NUMBER(2);
  l_inifai_str   CHAR(4);
  l_fimfai_str   CHAR(4);
  l_usutel       VARCHAR(31);
  l_comando      VARCHAR(512);
  l_comando_ins  VARCHAR(512);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numbar_str   CHAR(12);
  l_numpro_str   CHAR(12);
  l_numsma_str   CHAR(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_icard        CHAR(12);
  l_faiprm       VARCHAR(56); /* 7 FAIXAS - Ex de faixa: 12001330 --> 12:00 até 13:30 */
  l_dia_sem_str  CHAR(1);
  l_dia_sem      NUMBER(1); /*   1 = Domingo       */
                            /*   2 = Segunda-feira */
                            /*   3 = Terça-feira   */
                            /*   4 = Quarta-feira  */
                            /*   5 = Quinta-feira  */
                            /*   6 = Sexta-feira   */
                            /*   7 = Sábado        */
                            /*   8 = Feriado       */
  l_acofai       NUMBER(1); /* 1 = Liberado        */
                            /* 2 = Utiliza faixa pai */

  /* tratamento para utilizar número físico como principal*/
  l_chcAce       NUMBER(1);

  /*retornar todos os dispositivos telemática da pessoa*/
  CURSOR C_R034PRM_LOC IS
         SELECT R034PRM.CODDSP, R058RLG.CODCEN, R058RLG.RLGALF, R058RLG.NUMEIP
           FROM R034PRM R034PRM
              , R058RLG R058RLG
              , R058MOD R058MOD
          WHERE R034PRM.IDTPES = p_idtpes
            AND R058RLG.CODDSP = R034PRM.CODDSP
            AND R058MOD.MODRLG = R058RLG.MODRLG
            AND R058MOD.FABMOD = 1
            AND R058RLG.COMRLG = 2;
  TYPE T_R034PRM_LOC IS RECORD (CODDSP   R058RLG.CODDSP%TYPE
                               ,CODCEN   R058RLG.CODCEN%TYPE
                               ,RLGALF   R058RLG.RLGALF%TYPE
                               ,NUMEIP   R058RLG.NUMEIP%TYPE);
  l_r034prm_loc T_R034PRM_LOC;

  CURSOR C_R034FAP_LOC IS
         SELECT INIFAI, FIMFAI
           FROM R034FAP
          WHERE IDTPES = p_idtpes
            AND CODDSP = l_coddsp_aux
            AND VERPLF = l_verplf
            AND CODPLF = l_codplf
            AND DIASEM = l_dia_sem
          ORDER BY INIFAI ASC;
  TYPE T_R034FAP_LOC IS RECORD (INIFAI   R034FAP.INIFAI%TYPE
                               ,FIMFAI   R034FAP.FIMFAI%TYPE);
  l_r034fap_loc T_R034FAP_LOC;
  /*FIM CAMPOS PARA INTEGRAÇÃO COM TELEMÁTICA*/
BEGIN
  l_PrmDspCSM := 0;
  BEGIN
      SELECT COUNT(*) INTO l_PrmDspCSM FROM R034PRM, R058RLG, R058MOD
          WHERE R034PRM.IDTPES = p_idtpes
            AND R058RLG.CODPLT = R034PRM.CODPLT
            AND R058RLG.CODRLG = R034PRM.CODRLG
            AND R058MOD.MODRLG = R058RLG.MODRLG
            AND R058MOD.FABMOD > 1
            AND R058RLG.COMRLG = 2;
  EXCEPTION
      WHEN OTHERS THEN l_PrmDspCSM := 0;
  END;

  /* Para TSI sempre chama a rotina, mesmo sem dispositivos na permissão */
  /* Pois pode ser o processo de exclusão */
  l_matcod := 'N';
  l_chcAce := 0;
  BEGIN
      SELECT CHCACE, MATCOD INTO l_chcAce, l_matcod FROM R070TSI;
  EXCEPTION
      WHEN OTHERS THEN
          l_chcAce:= 0;
          l_matcod := 'N';
  END;

  IF (l_PrmDspCSM > 0) OR (l_matcod = 'S') THEN
      l_cracha     := 0;
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_data_atual := CURDATE();
      l_data_zero  := '31/12/1900,00:00:00';

      /*RETORNA A PESSOA A PARTIR DO IDTPES*/
      SP_PESFROMIDTPES(p_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT
                               , l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);

      /*BUSCA O CRACHÁ, SENÃO INFORMADO*/
      IF (p_numcra = 0) THEN
          /*Visitante*/
          IF (l_tippes = 4) THEN
              BEGIN
                  SELECT NUMCRA INTO l_cracha FROM R090HCH
                   WHERE R090HCH.TIPDOC = l_tipdoc AND
                     R090HCH.NUMDOC = l_numdoc AND
                     (R090HCH.DATINI < l_data_atual OR
                      (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
                     (R090HCH.DATFIM = l_data_zero OR
                      R090HCH.DATFIM > l_data_atual OR
                      (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro em R090HCH - TOO MANY ROWS';
                  WHEN NO_DATA_FOUND THEN  l_cracha := 0;
                  WHEN OTHERS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro no SELECT R090HCH.';
              END;
          ELSE
              /*Paciente*/
              IF (l_tippes = 9) THEN
                  BEGIN
                      SELECT NUMCRA INTO l_cracha FROM R097INT
                       WHERE PROPAC = l_propac
                         AND ( (DATFIM > l_data_atual) OR
                             ((DATFIM = l_data_atual) AND (HORFIM >= l_hora_atual)) OR
                             (DATFIM = l_data_zero) );
                  EXCEPTION
                      WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro em R097INT - TOO MANY ROWS';
                      WHEN NO_DATA_FOUND THEN l_cracha := 0;
                      WHEN OTHERS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro no SELECT R097INT.';
                  END;
              ELSE
                  /*Outras unidades*/
                  IF (l_tippes = 5) THEN
                      SP_RETCRA (2, l_numemp, 5, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                      IF   (l_cracha = 0)  THEN
                          SP_RETCRA (1, l_numemp, 5, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                      END IF;
                  ELSE
                  /* Aluno */
                      IF (l_tippes = 10) THEN
                          SP_RETCRA (2, l_numemp, 6, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                          IF   (l_cracha = 0)  THEN
                              SP_RETCRA (1, l_numemp, 6, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                          END IF;
                      ELSE
                          /* Colaboradores */
                          IF (l_tippes < 4) THEN
                              SP_RETCRA (2, l_numemp, l_tipcol, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                              IF   (l_cracha = 0)  THEN
                                  SP_RETCRA (1, l_numemp, l_tipcol, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                              END IF;
                          END IF;
                      END IF;
                  END IF;
              END IF;
          END IF;
      ELSE   /*CASO O CRACHÁ FOR INFORMADO NO PARÂMETRO*/
          l_cracha := p_numcra;
      END IF;

      /*Efetua as operações somente se existir crachá ativo*/
      IF (l_cracha <> 0) THEN

          /* Só gerar se tiver permissão por local físico em dispositivos <> TSI */
          /* A exclusão é feita pela tela */
          IF (l_PrmDspCSM > 0) THEN
              SP_PEND79(p_idtpes); /*GERA PENDÊNCIA 79. UPDATEPersonPrecisionPermission, para a concentradora*/
          END IF;

          /**** INÍCIO INTEGRAÇÃO TELEMÁTICA ****/
          IF (l_matcod = 'S') THEN
              l_dia_sem   := 0;
              l_count_fai := 0;
              SP_USUTEL(l_usutel OUT);
              l_verplf := 1;

              /*Sempre remove o crachá lógico para evitar sobreposições*/
              SP_INTSTR(l_cracha,'999999999999', l_icard OUT);
              l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_icard||'''';
              SP_CMDTSI(l_comando);


              SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
		      /*Se utilizar definição para gravar número físico no ICARD salva igual como é salvo na tabela CONTROLE*/
		      IF (l_chcAce = 1) THEN
                  /*remove todas as definições da pessoa antes de inserir*/
                  IF (l_numbar > 0) THEN
                      SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
                  IF (l_numpro > 0) THEN
                      SP_INTSTR(l_numpro,'999999999999', l_numpro_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numpro_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
                  IF (l_numsma > 0) THEN
                      SP_INTSTR(l_numsma, '999999999999', l_numsma_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numsma_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
		      ELSE
                  IF (l_chcAce = 3) THEN
                      IF (l_numbar > 0) THEN
	                      SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
	                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
	                      SP_CMDTSI(l_comando);
	                  END IF;
	                  IF (l_numsma > 0) THEN
	                      SP_INTSTR(l_numsma, '999999999999', l_numsma_str OUT);
	                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numsma_str||'''';
	                      SP_CMDTSI(l_comando);
	                  END IF;
                  ELSE
	                 IF (l_crapri > 0) AND ((l_tecpri < 3) OR (l_chcAce = 3))  THEN
	                     /*remove todas as definições da pessoa antes de inserir*/
	                     IF (l_numbar > 0) THEN
	                         SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
	                         l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
	                         SP_CMDTSI(l_comando);
	                     END IF;
	                     IF (l_numpro > 0) THEN
	                         SP_INTSTR(l_numpro,'999999999999', l_numpro_str OUT);
	                         l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numpro_str||'''';
	                         SP_CMDTSI(l_comando);
	                     END IF;
	                 END IF;
                  END IF;
		      END IF;


              /*VARRE TODOS OS DISPOSITIVOS PARA ALIMENTAR AS TABELAS DA TELEMÁTICA*/
              FOREACH C_R034PRM_LOC INTO l_r034prm_loc.CODDSP
                                       , l_r034prm_loc.CODCEN
                                       , l_r034prm_loc.RLGALF
                                       , l_r034prm_loc.NUMEIP
              LOOP

                  BEGIN
                      SELECT CODPLF INTO l_codplf_dsp FROM R058DSP WHERE CODDSP = l_r034prm_loc.CODDSP;
                  EXCEPTION
                      WHEN OTHERS THEN l_codplf_dsp := 0;
                  END;

                  l_dia_sem := 1;

                  /*VARRE OS DIAS DA SEMANA*/
                  LOOP
                      l_codplf_pai := l_codplf_dsp;
                      l_codplf     := l_codplf_dsp;
                      l_coddsp_aux := l_r034prm_loc.CODDSP;
                      /*BUSCA A AÇÃO DA FAIXA PARA O DIA*/
                      BEGIN
                          SELECT ACOFAI INTO l_acofai FROM R034AFD
                           WHERE IDTPES = p_idtpes AND CODDSP = l_r034prm_loc.CODDSP AND DIASEM = l_dia_sem ;
                      EXCEPTION
                          WHEN OTHERS THEN l_acofai := 0;
                      END;

                      /*ENQUANTO EXISTIR AÇÃO NA FAIXA*/
                      LOOP
                          IF ( l_acofai = 0 ) THEN
                              EXIT;
                          END IF;

                          /*LIBERADO, deve buscar as faixas*/
                          IF ( l_acofai = 1 ) THEN
                              l_count_fai := 0;
                              l_faiprm := '';
                              /*BUSCA AS FAIXAS*/
                              FOREACH C_R034FAP_LOC INTO l_r034fap_loc.INIFAI, l_r034fap_loc.FIMFAI
                              LOOP
                                  l_count_fai := l_count_fai + 1;
                                  SP_INTSTR(l_r034fap_loc.INIFAI, 'HHMM', l_inifai_str OUT);
                                  SP_INTSTR(l_r034fap_loc.FIMFAI, 'HHMM', l_fimfai_str OUT);
                                  l_faiprm := l_faiprm || l_inifai_str || l_fimfai_str;
                              END LOOP;

                              IF ( l_count_fai = 0 ) THEN
                                  /*sem faixa e liberado = 00:00 ás 23:59 para este dia*/
                                  l_faiprm := '00002359';
                                  l_count_fai := 1;
                              END IF;

                              /*valida se faltou faixas*/
                              LOOP
                                  IF ( l_count_fai = 7 ) THEN
                                      EXIT;
                                  END IF;
                                  l_faiprm := l_faiprm || '24002400';
                                  l_count_fai := l_count_fai + 1;
                              END LOOP;

                              l_comando := 'INSERT INTO '||l_usutel||'MATCODIN (END_IP,BLUEB,CODIN,DIASEM,FXPERM,ICARD) ';
                              /*caso ip zerado, utiliza o rlgalf e codcen*/
                              IF (l_r034prm_loc.NUMEIP = '000.000.000.000') THEN
                                  SP_INTSTR(l_r034prm_loc.CODCEN, '99', l_blueb OUT);
                                  l_codin := SUBSTRING(l_r034prm_loc.RLGALF,1, 2);
                                  l_comando := l_comando || ' VALUES(''000.000.000.000'',''' || l_blueb || ''',''' || l_codin || '''';
                              ELSE
                                  l_comando := l_comando || ' VALUES(''' || l_r034prm_loc.NUMEIP || ''',''00'',''00''';
                              END IF;
                              SP_INTSTR(l_dia_sem, '9', l_dia_sem_str OUT);
                              l_comando := l_comando || ','''||l_dia_sem_str||''','''||l_faiprm||''',';

						      /*Se utilizar definição para gravar número físico no ICARD salva igual como é salvo na tabela CONTROLE*/
						      IF (l_chcAce = 1) THEN
	                              /*insere as faixas*/
	                              IF (l_numbar > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
	                              IF (l_numpro > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numpro_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
	                              IF (l_numsma > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numsma_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
						      ELSE
                                  IF (l_chcAce = 3) THEN
                                      IF (l_numbar > 0) THEN
	                                      l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
	                                  IF (l_numsma > 0) THEN
	                                      l_comando_ins := l_comando || ' ''' || l_numsma_str || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
                                  ELSE
	                                  /*insere as faixas*/
	                                  IF (l_crapri > 0) AND (l_tecpri < 3)  THEN
	                                      IF (l_numbar > 0) THEN
	                                          l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                          SP_CMDTSI(l_comando_ins);
	                                      END IF;
	                                      IF (l_numpro > 0) THEN
	                                          l_comando_ins := l_comando || ' ''' || l_numpro_str || ''') ';
	                                          SP_CMDTSI(l_comando_ins);
	                                      END IF;
	                                  ELSE
	                                      l_comando_ins := l_comando || ' ''' || l_icard || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
                                  END IF;
						      END IF;
                              EXIT;
                          ELSE
                              /*UTILIZA FAIXA PAI, deve buscar as definições dos locais pais*/
                              IF (l_acofai = 2) THEN
                                  l_coddsp_aux := 0;
                                  l_codplf     := l_codplf_pai;
                                  /*BUSCA A AÇÃO DA FAIXA*/
                                  BEGIN
                                      SELECT ACOFAI INTO l_acofai FROM R034AFL
                                       WHERE IDTPES = p_idtpes
                                         AND CODPLF = l_codplf
                                         AND VERPLF = l_verplf
                                         AND DIASEM = l_dia_sem;
                                  EXCEPTION
                                      WHEN OTHERS THEN l_acofai := 0;
                                  END;

                                  /*BUSCA O LOCAL PAI*/
                                  BEGIN
                                      SELECT PAIPLF INTO l_codplf_pai FROM R058PLF WHERE CODPLF = l_codplf AND VERPLF = l_verplf;
                                  EXCEPTION
                                      WHEN OTHERS THEN l_codplf_pai := 0;
                                  END;
                              END IF;
                          END IF;
                      END LOOP;

                      l_dia_sem := l_dia_sem + 1;
                      IF (l_dia_sem > 8) THEN
                          EXIT;
                      END IF;
                  END LOOP;
              END LOOP;
          END IF; /**** FIM INTEGRAÇÃO TELEMÁTICA ****/
      END IF; /* (l_cracha <> 0) */
   END IF;  /* (l_PrmDspCSM > 0) OR (l_matcon = 'S') */
END		SENIOR;22TSP_PESFROMIDTPES
SP_RETCRA
SP_PEND79
SP_USUTEL
SP_INTSTR
SP_CMDTSI
SP_MAPFIS
›M␀␀

PROCEDURE SP_ATUPRMLOC(P_IDTPES VARCHAR2(23),P_NUMCRA NUMBER(12))
 IS
 
  l_cracha       NUMBER(12);
  l_tippes       NUMBER(2);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);
  l_tipdoc       NUMBER(1);
  l_coddsp_aux   NUMBER(9);
  l_numdoc       VARCHAR2(20);
  l_nummat       VARCHAR2(15);
  l_propac       VARCHAR2(20);
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_PrmDspCSM    NUMBER;  /* tem permissão por local físico em dispositivos demais */

  /*CAMPOS PARA INTEGRAÇÃO COM TELEMÁTICA*/
  l_matcod       CHAR(1);
  l_verplf       NUMBER(3);
  l_codplf       NUMBER(7);
  l_blueb        CHAR(2);
  l_codin        CHAR(2);
  l_codplf_dsp   NUMBER(7);
  l_codplf_pai   NUMBER(7);
  l_count_fai    NUMBER(2);
  l_inifai_str   CHAR(4);
  l_fimfai_str   CHAR(4);
  l_usutel       VARCHAR(31);
  l_comando      VARCHAR(512);
  l_comando_ins  VARCHAR(512);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numbar_str   CHAR(12);
  l_numpro_str   CHAR(12);
  l_numsma_str   CHAR(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_icard        CHAR(12);
  l_faiprm       VARCHAR(56); /* 7 FAIXAS - Ex de faixa: 12001330 --> 12:00 até 13:30 */
  l_dia_sem_str  CHAR(1);
  l_dia_sem      NUMBER(1); /*   1 = Domingo       */
                            /*   2 = Segunda-feira */
                            /*   3 = Terça-feira   */
                            /*   4 = Quarta-feira  */
                            /*   5 = Quinta-feira  */
                            /*   6 = Sexta-feira   */
                            /*   7 = Sábado        */
                            /*   8 = Feriado       */
  l_acofai       NUMBER(1); /* 1 = Liberado        */
                            /* 2 = Utiliza faixa pai */

  /* tratamento para utilizar número físico como principal*/
  l_chcAce       NUMBER(1);

  /*retornar todos os dispositivos telemática da pessoa*/
  CURSOR C_R034PRM_LOC IS
         SELECT R034PRM.CODDSP, R058RLG.CODCEN, R058RLG.RLGALF, R058RLG.NUMEIP
           FROM R034PRM R034PRM
              , R058RLG R058RLG
              , R058MOD R058MOD
          WHERE R034PRM.IDTPES = p_idtpes
            AND R058RLG.CODDSP = R034PRM.CODDSP
            AND R058MOD.MODRLG = R058RLG.MODRLG
            AND R058MOD.FABMOD = 1
            AND R058RLG.COMRLG = 2;
  TYPE T_R034PRM_LOC IS RECORD (CODDSP   R058RLG.CODDSP%TYPE
                               ,CODCEN   R058RLG.CODCEN%TYPE
                               ,RLGALF   R058RLG.RLGALF%TYPE
                               ,NUMEIP   R058RLG.NUMEIP%TYPE);
  l_r034prm_loc T_R034PRM_LOC;

  CURSOR C_R034FAP_LOC IS
         SELECT INIFAI, FIMFAI
           FROM R034FAP
          WHERE IDTPES = p_idtpes
            AND CODDSP = l_coddsp_aux
            AND VERPLF = l_verplf
            AND CODPLF = l_codplf
            AND DIASEM = l_dia_sem
          ORDER BY INIFAI ASC;
  TYPE T_R034FAP_LOC IS RECORD (INIFAI   R034FAP.INIFAI%TYPE
                               ,FIMFAI   R034FAP.FIMFAI%TYPE);
  l_r034fap_loc T_R034FAP_LOC;
  /*FIM CAMPOS PARA INTEGRAÇÃO COM TELEMÁTICA*/
BEGIN
  l_PrmDspCSM := 0;
  BEGIN
      SELECT COUNT(*) INTO l_PrmDspCSM FROM R034PRM, R058RLG, R058MOD
          WHERE R034PRM.IDTPES = p_idtpes
            AND R058RLG.CODPLT = R034PRM.CODPLT
            AND R058RLG.CODRLG = R034PRM.CODRLG
            AND R058MOD.MODRLG = R058RLG.MODRLG
            AND R058MOD.FABMOD > 1
            AND R058RLG.COMRLG = 2;
  EXCEPTION
      WHEN OTHERS THEN l_PrmDspCSM := 0;
  END;

  /* Para TSI sempre chama a rotina, mesmo sem dispositivos na permissão */
  /* Pois pode ser o processo de exclusão */
  l_matcod := 'N';
  l_chcAce := 0;
  BEGIN
      SELECT CHCACE, MATCOD INTO l_chcAce, l_matcod FROM R070TSI;
  EXCEPTION
      WHEN OTHERS THEN
          l_chcAce:= 0;
          l_matcod := 'N';
  END;

  IF (l_PrmDspCSM > 0) OR (l_matcod = 'S') THEN
      l_cracha     := 0;
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_data_atual := CURDATE();
      l_data_zero  := '31/12/1900,00:00:00';

      /*RETORNA A PESSOA A PARTIR DO IDTPES*/
      SP_PESFROMIDTPES(p_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT
                               , l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);

      /*BUSCA O CRACHÁ, SENÃO INFORMADO*/
      IF (p_numcra = 0) THEN
          /*Visitante*/
          IF (l_tippes = 4) THEN
              BEGIN
                  SELECT NUMCRA INTO l_cracha FROM R090HCH
                   WHERE R090HCH.TIPDOC = l_tipdoc AND
                     R090HCH.NUMDOC = l_numdoc AND
                     (R090HCH.DATINI < l_data_atual OR
                      (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
                     (R090HCH.DATFIM = l_data_zero OR
                      R090HCH.DATFIM > l_data_atual OR
                      (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro em R090HCH - TOO MANY ROWS';
                  WHEN NO_DATA_FOUND THEN  l_cracha := 0;
                  WHEN OTHERS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro no SELECT R090HCH.';
              END;
          ELSE
              /*Paciente*/
              IF (l_tippes = 9) THEN
                  BEGIN
                      SELECT NUMCRA INTO l_cracha FROM R097INT
                       WHERE PROPAC = l_propac
                         AND ( (DATFIM > l_data_atual) OR
                             ((DATFIM = l_data_atual) AND (HORFIM >= l_hora_atual)) OR
                             (DATFIM = l_data_zero) );
                  EXCEPTION
                      WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro em R097INT - TOO MANY ROWS';
                      WHEN NO_DATA_FOUND THEN l_cracha := 0;
                      WHEN OTHERS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro no SELECT R097INT.';
                  END;
              ELSE
                  /*Outras unidades*/
                  IF (l_tippes = 5) THEN
                      SP_RETCRA (2, l_numemp, 5, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                      IF   (l_cracha = 0)  THEN
                          SP_RETCRA (1, l_numemp, 5, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                      END IF;
                  ELSE
                  /* Aluno */
                      IF (l_tippes = 10) THEN
                          SP_RETCRA (2, l_numemp, 6, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                          IF   (l_cracha = 0)  THEN
                              SP_RETCRA (1, l_numemp, 6, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                          END IF;
                      ELSE
                          /* Colaboradores */
                          IF (l_tippes < 4) THEN
                              SP_RETCRA (2, l_numemp, l_tipcol, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                              IF   (l_cracha = 0)  THEN
                                  SP_RETCRA (1, l_numemp, l_tipcol, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                              END IF;
                          END IF;
                      END IF;
                  END IF;
              END IF;
          END IF;
      ELSE   /*CASO O CRACHÁ FOR INFORMADO NO PARÂMETRO*/
          l_cracha := p_numcra;
      END IF;

      /*Efetua as operações somente se existir crachá ativo*/
      IF (l_cracha <> 0) THEN

          /* Só gerar se tiver permissão por local físico em dispositivos <> TSI */
          /* A exclusão é feita pela tela */
          IF (l_PrmDspCSM > 0) THEN
              SP_PEND79(p_idtpes); /*GERA PENDÊNCIA 79. UPDATEPersonPrecisionPermission, para a concentradora*/
          END IF;

          /**** INÍCIO INTEGRAÇÃO TELEMÁTICA ****/
          IF (l_matcod = 'S') THEN
              l_dia_sem   := 0;
              l_count_fai := 0;
              SP_USUTEL(l_usutel OUT);
              l_verplf := 1;

              /*Sempre remove o crachá lógico para evitar sobreposições*/
              SP_INTSTR(l_cracha,'999999999999', l_icard OUT);
              l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_icard||'''';
              SP_CMDTSI(l_comando);


              SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
		      /*Se utilizar definição para gravar número físico no ICARD salva igual como é salvo na tabela CONTROLE*/
		      IF (l_chcAce = 1) THEN
                  /*remove todas as definições da pessoa antes de inserir*/
                  IF (l_numbar > 0) THEN
                      SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
                  IF (l_numpro > 0) THEN
                      SP_INTSTR(l_numpro,'999999999999', l_numpro_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numpro_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
                  IF (l_numsma > 0) THEN
                      SP_INTSTR(l_numsma, '999999999999', l_numsma_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numsma_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
		      ELSE
                  IF (l_chcAce = 3) THEN
                      IF (l_numbar > 0) THEN
	                      SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
	                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
	                      SP_CMDTSI(l_comando);
	                  END IF;
	                  IF (l_numsma > 0) THEN
	                      SP_INTSTR(l_numsma, '999999999999', l_numsma_str OUT);
	                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numsma_str||'''';
	                      SP_CMDTSI(l_comando);
	                  END IF;
                  ELSE
	                 IF (l_crapri > 0) AND ((l_tecpri < 3) OR (l_chcAce = 3))  THEN
	                     /*remove todas as definições da pessoa antes de inserir*/
	                     IF (l_numbar > 0) THEN
	                         SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
	                         l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
	                         SP_CMDTSI(l_comando);
	                     END IF;
	                     IF (l_numpro > 0) THEN
	                         SP_INTSTR(l_numpro,'999999999999', l_numpro_str OUT);
	                         l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numpro_str||'''';
	                         SP_CMDTSI(l_comando);
	                     END IF;
	                 END IF;
                  END IF;
		      END IF;


              /*VARRE TODOS OS DISPOSITIVOS PARA ALIMENTAR AS TABELAS DA TELEMÁTICA*/
              FOREACH C_R034PRM_LOC INTO l_r034prm_loc.CODDSP
                                       , l_r034prm_loc.CODCEN
                                       , l_r034prm_loc.RLGALF
                                       , l_r034prm_loc.NUMEIP
              LOOP

                  BEGIN
                      SELECT CODPLF INTO l_codplf_dsp FROM R058DSP WHERE CODDSP = l_r034prm_loc.CODDSP;
                  EXCEPTION
                      WHEN OTHERS THEN l_codplf_dsp := 0;
                  END;

                  l_dia_sem := 1;

                  /*VARRE OS DIAS DA SEMANA*/
                  LOOP
                      l_codplf_pai := l_codplf_dsp;
                      l_codplf     := l_codplf_dsp;
                      l_coddsp_aux := l_r034prm_loc.CODDSP;
                      /*BUSCA A AÇÃO DA FAIXA PARA O DIA*/
                      BEGIN
                          SELECT ACOFAI INTO l_acofai FROM R034AFD
                           WHERE IDTPES = p_idtpes AND CODDSP = l_r034prm_loc.CODDSP AND DIASEM = l_dia_sem ;
                      EXCEPTION
                          WHEN OTHERS THEN l_acofai := 0;
                      END;

                      /*ENQUANTO EXISTIR AÇÃO NA FAIXA*/
                      LOOP
                          IF ( l_acofai = 0 ) THEN
                              EXIT;
                          END IF;

                          /*LIBERADO, deve buscar as faixas*/
                          IF ( l_acofai = 1 ) THEN
                              l_count_fai := 0;
                              l_faiprm := '';
                              /*BUSCA AS FAIXAS*/
                              FOREACH C_R034FAP_LOC INTO l_r034fap_loc.INIFAI, l_r034fap_loc.FIMFAI
                              LOOP
                                  l_count_fai := l_count_fai + 1;
                                  SP_INTSTR(l_r034fap_loc.INIFAI, 'HHMM', l_inifai_str OUT);
                                  SP_INTSTR(l_r034fap_loc.FIMFAI, 'HHMM', l_fimfai_str OUT);
                                  l_faiprm := l_faiprm || l_inifai_str || l_fimfai_str;
                              END LOOP;

                              IF ( l_count_fai = 0 ) THEN
                                  /*sem faixa e liberado = 00:00 ás 23:59 para este dia*/
                                  l_faiprm := '00002359';
                                  l_count_fai := 1;
                              END IF;

                              /*valida se faltou faixas*/
                              LOOP
                                  IF ( l_count_fai = 7 ) THEN
                                      EXIT;
                                  END IF;
                                  l_faiprm := l_faiprm || '24002400';
                                  l_count_fai := l_count_fai + 1;
                              END LOOP;

                              l_comando := 'INSERT INTO '||l_usutel||'MATCODIN (END_IP,BLUEB,CODIN,DIASEM,FXPERM,ICARD) ';
                              /*caso ip zerado, utiliza o rlgalf e codcen*/
                              IF (l_r034prm_loc.NUMEIP = '000.000.000.000') THEN
                                  SP_INTSTR(l_r034prm_loc.CODCEN, '99', l_blueb OUT);
                                  l_codin := SUBSTRING(l_r034prm_loc.RLGALF,1, 2);
                                  l_comando := l_comando || ' VALUES(''000.000.000.000'',''' || l_blueb || ''',''' || l_codin || '''';
                              ELSE
                                  l_comando := l_comando || ' VALUES(''' || l_r034prm_loc.NUMEIP || ''',''00'',''00''';
                              END IF;
                              SP_INTSTR(l_dia_sem, '9', l_dia_sem_str OUT);
                              l_comando := l_comando || ','''||l_dia_sem_str||''','''||l_faiprm||''',';

						      /*Se utilizar definição para gravar número físico no ICARD salva igual como é salvo na tabela CONTROLE*/
						      IF (l_chcAce = 1) THEN
	                              /*insere as faixas*/
	                              IF (l_numbar > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
	                              IF (l_numpro > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numpro_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
	                              IF (l_numsma > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numsma_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
						      ELSE
                                  IF (l_chcAce = 3) THEN
                                      IF (l_numbar > 0) THEN
	                                      l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
	                                  IF (l_numsma > 0) THEN
	                                      l_comando_ins := l_comando || ' ''' || l_numsma_str || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
                                  ELSE
	                                  /*insere as faixas*/
	                                  IF (l_crapri > 0) AND (l_tecpri < 3)  THEN
	                                      IF (l_numbar > 0) THEN
	                                          l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                          SP_CMDTSI(l_comando_ins);
	                                      END IF;
	                                      IF (l_numpro > 0) THEN
	                                          l_comando_ins := l_comando || ' ''' || l_numpro_str || ''') ';
	                                          SP_CMDTSI(l_comando_ins);
	                                      END IF;
	                                  ELSE
	                                      l_comando_ins := l_comando || ' ''' || l_icard || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
                                  END IF;
						      END IF;
                              EXIT;
                          ELSE
                              /*UTILIZA FAIXA PAI, deve buscar as definições dos locais pais*/
                              IF (l_acofai = 2) THEN
                                  l_coddsp_aux := 0;
                                  l_codplf     := l_codplf_pai;
                                  /*BUSCA A AÇÃO DA FAIXA*/
                                  BEGIN
                                      SELECT ACOFAI INTO l_acofai FROM R034AFL
                                       WHERE IDTPES = p_idtpes
                                         AND CODPLF = l_codplf
                                         AND VERPLF = l_verplf
                                         AND DIASEM = l_dia_sem;
                                  EXCEPTION
                                      WHEN OTHERS THEN l_acofai := 0;
                                  END;

                                  /*BUSCA O LOCAL PAI*/
                                  BEGIN
                                      SELECT PAIPLF INTO l_codplf_pai FROM R058PLF WHERE CODPLF = l_codplf AND VERPLF = l_verplf;
                                  EXCEPTION
                                      WHEN OTHERS THEN l_codplf_pai := 0;
                                  END;
                              END IF;
                          END IF;
                      END LOOP;

                      l_dia_sem := l_dia_sem + 1;
                      IF (l_dia_sem > 8) THEN
                          EXIT;
                      END IF;
                  END LOOP;
              END LOOP;
          END IF; /**** FIM INTEGRAÇÃO TELEMÁTICA ****/
      END IF; /* (l_cracha <> 0) */
   END IF;  /* (l_PrmDspCSM > 0) OR (l_matcon = 'S') */
END		SENIOR;23TSP_PESFROMIDTPES
SP_RETCRA
SP_PEND79
SP_USUTEL
SP_INTSTR
SP_CMDTSI
SP_MAPFIS
›M␀␀

PROCEDURE SP_ATUPRMLOC(P_IDTPES VARCHAR2(23),P_NUMCRA NUMBER(12))
 IS
 
  l_cracha       NUMBER(12);
  l_tippes       NUMBER(2);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);
  l_tipdoc       NUMBER(1);
  l_coddsp_aux   NUMBER(9);
  l_numdoc       VARCHAR2(20);
  l_nummat       VARCHAR2(15);
  l_propac       VARCHAR2(20);
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_PrmDspCSM    NUMBER;  /* tem permissão por local físico em dispositivos demais */

  /*CAMPOS PARA INTEGRAÇÃO COM TELEMÁTICA*/
  l_matcod       CHAR(1);
  l_verplf       NUMBER(3);
  l_codplf       NUMBER(7);
  l_blueb        CHAR(2);
  l_codin        CHAR(2);
  l_codplf_dsp   NUMBER(7);
  l_codplf_pai   NUMBER(7);
  l_count_fai    NUMBER(2);
  l_inifai_str   CHAR(4);
  l_fimfai_str   CHAR(4);
  l_usutel       VARCHAR(31);
  l_comando      VARCHAR(512);
  l_comando_ins  VARCHAR(512);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numbar_str   CHAR(12);
  l_numpro_str   CHAR(12);
  l_numsma_str   CHAR(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_icard        CHAR(12);
  l_faiprm       VARCHAR(56); /* 7 FAIXAS - Ex de faixa: 12001330 --> 12:00 até 13:30 */
  l_dia_sem_str  CHAR(1);
  l_dia_sem      NUMBER(1); /*   1 = Domingo       */
                            /*   2 = Segunda-feira */
                            /*   3 = Terça-feira   */
                            /*   4 = Quarta-feira  */
                            /*   5 = Quinta-feira  */
                            /*   6 = Sexta-feira   */
                            /*   7 = Sábado        */
                            /*   8 = Feriado       */
  l_acofai       NUMBER(1); /* 1 = Liberado        */
                            /* 2 = Utiliza faixa pai */

  /* tratamento para utilizar número físico como principal*/
  l_chcAce       NUMBER(1);

  /*retornar todos os dispositivos telemática da pessoa*/
  CURSOR C_R034PRM_LOC IS
         SELECT R034PRM.CODDSP, R058RLG.CODCEN, R058RLG.RLGALF, R058RLG.NUMEIP
           FROM R034PRM R034PRM
              , R058RLG R058RLG
              , R058MOD R058MOD
          WHERE R034PRM.IDTPES = p_idtpes
            AND R058RLG.CODDSP = R034PRM.CODDSP
            AND R058MOD.MODRLG = R058RLG.MODRLG
            AND R058MOD.FABMOD = 1
            AND R058RLG.COMRLG = 2;
  TYPE T_R034PRM_LOC IS RECORD (CODDSP   R058RLG.CODDSP%TYPE
                               ,CODCEN   R058RLG.CODCEN%TYPE
                               ,RLGALF   R058RLG.RLGALF%TYPE
                               ,NUMEIP   R058RLG.NUMEIP%TYPE);
  l_r034prm_loc T_R034PRM_LOC;

  CURSOR C_R034FAP_LOC IS
         SELECT INIFAI, FIMFAI
           FROM R034FAP
          WHERE IDTPES = p_idtpes
            AND CODDSP = l_coddsp_aux
            AND VERPLF = l_verplf
            AND CODPLF = l_codplf
            AND DIASEM = l_dia_sem
          ORDER BY INIFAI ASC;
  TYPE T_R034FAP_LOC IS RECORD (INIFAI   R034FAP.INIFAI%TYPE
                               ,FIMFAI   R034FAP.FIMFAI%TYPE);
  l_r034fap_loc T_R034FAP_LOC;
  /*FIM CAMPOS PARA INTEGRAÇÃO COM TELEMÁTICA*/
BEGIN
  l_PrmDspCSM := 0;
  BEGIN
      SELECT COUNT(*) INTO l_PrmDspCSM FROM R034PRM, R058RLG, R058MOD
          WHERE R034PRM.IDTPES = p_idtpes
            AND R058RLG.CODPLT = R034PRM.CODPLT
            AND R058RLG.CODRLG = R034PRM.CODRLG
            AND R058MOD.MODRLG = R058RLG.MODRLG
            AND R058MOD.FABMOD > 1
            AND R058RLG.COMRLG = 2;
  EXCEPTION
      WHEN OTHERS THEN l_PrmDspCSM := 0;
  END;

  /* Para TSI sempre chama a rotina, mesmo sem dispositivos na permissão */
  /* Pois pode ser o processo de exclusão */
  l_matcod := 'N';
  l_chcAce := 0;
  BEGIN
      SELECT CHCACE, MATCOD INTO l_chcAce, l_matcod FROM R070TSI;
  EXCEPTION
      WHEN OTHERS THEN
          l_chcAce:= 0;
          l_matcod := 'N';
  END;

  IF (l_PrmDspCSM > 0) OR (l_matcod = 'S') THEN
      l_cracha     := 0;
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_data_atual := CURDATE();
      l_data_zero  := '31/12/1900,00:00:00';

      /*RETORNA A PESSOA A PARTIR DO IDTPES*/
      SP_PESFROMIDTPES(p_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT
                               , l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);

      /*BUSCA O CRACHÁ, SENÃO INFORMADO*/
      IF (p_numcra = 0) THEN
          /*Visitante*/
          IF (l_tippes = 4) THEN
              BEGIN
                  SELECT NUMCRA INTO l_cracha FROM R090HCH
                   WHERE R090HCH.TIPDOC = l_tipdoc AND
                     R090HCH.NUMDOC = l_numdoc AND
                     (R090HCH.DATINI < l_data_atual OR
                      (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
                     (R090HCH.DATFIM = l_data_zero OR
                      R090HCH.DATFIM > l_data_atual OR
                      (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro em R090HCH - TOO MANY ROWS';
                  WHEN NO_DATA_FOUND THEN  l_cracha := 0;
                  WHEN OTHERS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro no SELECT R090HCH.';
              END;
          ELSE
              /*Paciente*/
              IF (l_tippes = 9) THEN
                  BEGIN
                      SELECT NUMCRA INTO l_cracha FROM R097INT
                       WHERE PROPAC = l_propac
                         AND ( (DATFIM > l_data_atual) OR
                             ((DATFIM = l_data_atual) AND (HORFIM >= l_hora_atual)) OR
                             (DATFIM = l_data_zero) );
                  EXCEPTION
                      WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro em R097INT - TOO MANY ROWS';
                      WHEN NO_DATA_FOUND THEN l_cracha := 0;
                      WHEN OTHERS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro no SELECT R097INT.';
                  END;
              ELSE
                  /*Outras unidades*/
                  IF (l_tippes = 5) THEN
                      SP_RETCRA (2, l_numemp, 5, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                      IF   (l_cracha = 0)  THEN
                          SP_RETCRA (1, l_numemp, 5, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                      END IF;
                  ELSE
                  /* Aluno */
                      IF (l_tippes = 10) THEN
                          SP_RETCRA (2, l_numemp, 6, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                          IF   (l_cracha = 0)  THEN
                              SP_RETCRA (1, l_numemp, 6, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                          END IF;
                      ELSE
                          /* Colaboradores */
                          IF (l_tippes < 4) THEN
                              SP_RETCRA (2, l_numemp, l_tipcol, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                              IF   (l_cracha = 0)  THEN
                                  SP_RETCRA (1, l_numemp, l_tipcol, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                              END IF;
                          END IF;
                      END IF;
                  END IF;
              END IF;
          END IF;
      ELSE   /*CASO O CRACHÁ FOR INFORMADO NO PARÂMETRO*/
          l_cracha := p_numcra;
      END IF;

      /*Efetua as operações somente se existir crachá ativo*/
      IF (l_cracha <> 0) THEN

          /* Só gerar se tiver permissão por local físico em dispositivos <> TSI */
          /* A exclusão é feita pela tela */
          IF (l_PrmDspCSM > 0) THEN
              SP_PEND79(p_idtpes); /*GERA PENDÊNCIA 79. UPDATEPersonPrecisionPermission, para a concentradora*/
          END IF;

          /**** INÍCIO INTEGRAÇÃO TELEMÁTICA ****/
          IF (l_matcod = 'S') THEN
              l_dia_sem   := 0;
              l_count_fai := 0;
              SP_USUTEL(l_usutel OUT);
              l_verplf := 1;

              /*Sempre remove o crachá lógico para evitar sobreposições*/
              SP_INTSTR(l_cracha,'999999999999', l_icard OUT);
              l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_icard||'''';
              SP_CMDTSI(l_comando);


              SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
		      /*Se utilizar definição para gravar número físico no ICARD salva igual como é salvo na tabela CONTROLE*/
		      IF (l_chcAce = 1) THEN
                  /*remove todas as definições da pessoa antes de inserir*/
                  IF (l_numbar > 0) THEN
                      SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
                  IF (l_numpro > 0) THEN
                      SP_INTSTR(l_numpro,'999999999999', l_numpro_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numpro_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
                  IF (l_numsma > 0) THEN
                      SP_INTSTR(l_numsma, '999999999999', l_numsma_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numsma_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
		      ELSE
                  IF (l_chcAce = 3) THEN
                      IF (l_numbar > 0) THEN
	                      SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
	                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
	                      SP_CMDTSI(l_comando);
	                  END IF;
	                  IF (l_numsma > 0) THEN
	                      SP_INTSTR(l_numsma, '999999999999', l_numsma_str OUT);
	                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numsma_str||'''';
	                      SP_CMDTSI(l_comando);
	                  END IF;
                  ELSE
	                 IF (l_crapri > 0) AND ((l_tecpri < 3) OR (l_chcAce = 3))  THEN
	                     /*remove todas as definições da pessoa antes de inserir*/
	                     IF (l_numbar > 0) THEN
	                         SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
	                         l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
	                         SP_CMDTSI(l_comando);
	                     END IF;
	                     IF (l_numpro > 0) THEN
	                         SP_INTSTR(l_numpro,'999999999999', l_numpro_str OUT);
	                         l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numpro_str||'''';
	                         SP_CMDTSI(l_comando);
	                     END IF;
	                 END IF;
                  END IF;
		      END IF;


              /*VARRE TODOS OS DISPOSITIVOS PARA ALIMENTAR AS TABELAS DA TELEMÁTICA*/
              FOREACH C_R034PRM_LOC INTO l_r034prm_loc.CODDSP
                                       , l_r034prm_loc.CODCEN
                                       , l_r034prm_loc.RLGALF
                                       , l_r034prm_loc.NUMEIP
              LOOP

                  BEGIN
                      SELECT CODPLF INTO l_codplf_dsp FROM R058DSP WHERE CODDSP = l_r034prm_loc.CODDSP;
                  EXCEPTION
                      WHEN OTHERS THEN l_codplf_dsp := 0;
                  END;

                  l_dia_sem := 1;

                  /*VARRE OS DIAS DA SEMANA*/
                  LOOP
                      l_codplf_pai := l_codplf_dsp;
                      l_codplf     := l_codplf_dsp;
                      l_coddsp_aux := l_r034prm_loc.CODDSP;
                      /*BUSCA A AÇÃO DA FAIXA PARA O DIA*/
                      BEGIN
                          SELECT ACOFAI INTO l_acofai FROM R034AFD
                           WHERE IDTPES = p_idtpes AND CODDSP = l_r034prm_loc.CODDSP AND DIASEM = l_dia_sem ;
                      EXCEPTION
                          WHEN OTHERS THEN l_acofai := 0;
                      END;

                      /*ENQUANTO EXISTIR AÇÃO NA FAIXA*/
                      LOOP
                          IF ( l_acofai = 0 ) THEN
                              EXIT;
                          END IF;

                          /*LIBERADO, deve buscar as faixas*/
                          IF ( l_acofai = 1 ) THEN
                              l_count_fai := 0;
                              l_faiprm := '';
                              /*BUSCA AS FAIXAS*/
                              FOREACH C_R034FAP_LOC INTO l_r034fap_loc.INIFAI, l_r034fap_loc.FIMFAI
                              LOOP
                                  l_count_fai := l_count_fai + 1;
                                  SP_INTSTR(l_r034fap_loc.INIFAI, 'HHMM', l_inifai_str OUT);
                                  SP_INTSTR(l_r034fap_loc.FIMFAI, 'HHMM', l_fimfai_str OUT);
                                  l_faiprm := l_faiprm || l_inifai_str || l_fimfai_str;
                              END LOOP;

                              IF ( l_count_fai = 0 ) THEN
                                  /*sem faixa e liberado = 00:00 ás 23:59 para este dia*/
                                  l_faiprm := '00002359';
                                  l_count_fai := 1;
                              END IF;

                              /*valida se faltou faixas*/
                              LOOP
                                  IF ( l_count_fai = 7 ) THEN
                                      EXIT;
                                  END IF;
                                  l_faiprm := l_faiprm || '24002400';
                                  l_count_fai := l_count_fai + 1;
                              END LOOP;

                              l_comando := 'INSERT INTO '||l_usutel||'MATCODIN (END_IP,BLUEB,CODIN,DIASEM,FXPERM,ICARD) ';
                              /*caso ip zerado, utiliza o rlgalf e codcen*/
                              IF (l_r034prm_loc.NUMEIP = '000.000.000.000') THEN
                                  SP_INTSTR(l_r034prm_loc.CODCEN, '99', l_blueb OUT);
                                  l_codin := SUBSTRING(l_r034prm_loc.RLGALF,1, 2);
                                  l_comando := l_comando || ' VALUES(''000.000.000.000'',''' || l_blueb || ''',''' || l_codin || '''';
                              ELSE
                                  l_comando := l_comando || ' VALUES(''' || l_r034prm_loc.NUMEIP || ''',''00'',''00''';
                              END IF;
                              SP_INTSTR(l_dia_sem, '9', l_dia_sem_str OUT);
                              l_comando := l_comando || ','''||l_dia_sem_str||''','''||l_faiprm||''',';

						      /*Se utilizar definição para gravar número físico no ICARD salva igual como é salvo na tabela CONTROLE*/
						      IF (l_chcAce = 1) THEN
	                              /*insere as faixas*/
	                              IF (l_numbar > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
	                              IF (l_numpro > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numpro_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
	                              IF (l_numsma > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numsma_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
						      ELSE
                                  IF (l_chcAce = 3) THEN
                                      IF (l_numbar > 0) THEN
	                                      l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
	                                  IF (l_numsma > 0) THEN
	                                      l_comando_ins := l_comando || ' ''' || l_numsma_str || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
                                  ELSE
	                                  /*insere as faixas*/
	                                  IF (l_crapri > 0) AND (l_tecpri < 3)  THEN
	                                      IF (l_numbar > 0) THEN
	                                          l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                          SP_CMDTSI(l_comando_ins);
	                                      END IF;
	                                      IF (l_numpro > 0) THEN
	                                          l_comando_ins := l_comando || ' ''' || l_numpro_str || ''') ';
	                                          SP_CMDTSI(l_comando_ins);
	                                      END IF;
	                                  ELSE
	                                      l_comando_ins := l_comando || ' ''' || l_icard || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
                                  END IF;
						      END IF;
                              EXIT;
                          ELSE
                              /*UTILIZA FAIXA PAI, deve buscar as definições dos locais pais*/
                              IF (l_acofai = 2) THEN
                                  l_coddsp_aux := 0;
                                  l_codplf     := l_codplf_pai;
                                  /*BUSCA A AÇÃO DA FAIXA*/
                                  BEGIN
                                      SELECT ACOFAI INTO l_acofai FROM R034AFL
                                       WHERE IDTPES = p_idtpes
                                         AND CODPLF = l_codplf
                                         AND VERPLF = l_verplf
                                         AND DIASEM = l_dia_sem;
                                  EXCEPTION
                                      WHEN OTHERS THEN l_acofai := 0;
                                  END;

                                  /*BUSCA O LOCAL PAI*/
                                  BEGIN
                                      SELECT PAIPLF INTO l_codplf_pai FROM R058PLF WHERE CODPLF = l_codplf AND VERPLF = l_verplf;
                                  EXCEPTION
                                      WHEN OTHERS THEN l_codplf_pai := 0;
                                  END;
                              END IF;
                          END IF;
                      END LOOP;

                      l_dia_sem := l_dia_sem + 1;
                      IF (l_dia_sem > 8) THEN
                          EXIT;
                      END IF;
                  END LOOP;
              END LOOP;
          END IF; /**** FIM INTEGRAÇÃO TELEMÁTICA ****/
      END IF; /* (l_cracha <> 0) */
   END IF;  /* (l_PrmDspCSM > 0) OR (l_matcon = 'S') */
END		SENIOR;24TSP_PESFROMIDTPES
SP_RETCRA
SP_PEND79
SP_USUTEL
SP_INTSTR
SP_CMDTSI
SP_MAPFIS
›M␀␀

PROCEDURE SP_ATUPRMLOC(P_IDTPES VARCHAR2(23),P_NUMCRA NUMBER(12))
 IS
 
  l_cracha       NUMBER(12);
  l_tippes       NUMBER(2);
  l_numemp       NUMBER(4);
  l_tipcol       NUMBER(1);
  l_numcad       NUMBER(9);
  l_tipdoc       NUMBER(1);
  l_coddsp_aux   NUMBER(9);
  l_numdoc       VARCHAR2(20);
  l_nummat       VARCHAR2(15);
  l_propac       VARCHAR2(20);
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_PrmDspCSM    NUMBER;  /* tem permissão por local físico em dispositivos demais */

  /*CAMPOS PARA INTEGRAÇÃO COM TELEMÁTICA*/
  l_matcod       CHAR(1);
  l_verplf       NUMBER(3);
  l_codplf       NUMBER(7);
  l_blueb        CHAR(2);
  l_codin        CHAR(2);
  l_codplf_dsp   NUMBER(7);
  l_codplf_pai   NUMBER(7);
  l_count_fai    NUMBER(2);
  l_inifai_str   CHAR(4);
  l_fimfai_str   CHAR(4);
  l_usutel       VARCHAR(31);
  l_comando      VARCHAR(512);
  l_comando_ins  VARCHAR(512);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numbar_str   CHAR(12);
  l_numpro_str   CHAR(12);
  l_numsma_str   CHAR(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_icard        CHAR(12);
  l_faiprm       VARCHAR(56); /* 7 FAIXAS - Ex de faixa: 12001330 --> 12:00 até 13:30 */
  l_dia_sem_str  CHAR(1);
  l_dia_sem      NUMBER(1); /*   1 = Domingo       */
                            /*   2 = Segunda-feira */
                            /*   3 = Terça-feira   */
                            /*   4 = Quarta-feira  */
                            /*   5 = Quinta-feira  */
                            /*   6 = Sexta-feira   */
                            /*   7 = Sábado        */
                            /*   8 = Feriado       */
  l_acofai       NUMBER(1); /* 1 = Liberado        */
                            /* 2 = Utiliza faixa pai */

  /* tratamento para utilizar número físico como principal*/
  l_chcAce       NUMBER(1);

  /*retornar todos os dispositivos telemática da pessoa*/
  CURSOR C_R034PRM_LOC IS
         SELECT R034PRM.CODDSP, R058RLG.CODCEN, R058RLG.RLGALF, R058RLG.NUMEIP
           FROM R034PRM R034PRM
              , R058RLG R058RLG
              , R058MOD R058MOD
          WHERE R034PRM.IDTPES = p_idtpes
            AND R058RLG.CODDSP = R034PRM.CODDSP
            AND R058MOD.MODRLG = R058RLG.MODRLG
            AND R058MOD.FABMOD = 1
            AND R058RLG.COMRLG = 2;
  TYPE T_R034PRM_LOC IS RECORD (CODDSP   R058RLG.CODDSP%TYPE
                               ,CODCEN   R058RLG.CODCEN%TYPE
                               ,RLGALF   R058RLG.RLGALF%TYPE
                               ,NUMEIP   R058RLG.NUMEIP%TYPE);
  l_r034prm_loc T_R034PRM_LOC;

  CURSOR C_R034FAP_LOC IS
         SELECT INIFAI, FIMFAI
           FROM R034FAP
          WHERE IDTPES = p_idtpes
            AND CODDSP = l_coddsp_aux
            AND VERPLF = l_verplf
            AND CODPLF = l_codplf
            AND DIASEM = l_dia_sem
          ORDER BY INIFAI ASC;
  TYPE T_R034FAP_LOC IS RECORD (INIFAI   R034FAP.INIFAI%TYPE
                               ,FIMFAI   R034FAP.FIMFAI%TYPE);
  l_r034fap_loc T_R034FAP_LOC;
  /*FIM CAMPOS PARA INTEGRAÇÃO COM TELEMÁTICA*/
BEGIN
  l_PrmDspCSM := 0;
  BEGIN
      SELECT COUNT(*) INTO l_PrmDspCSM FROM R034PRM, R058RLG, R058MOD
          WHERE R034PRM.IDTPES = p_idtpes
            AND R058RLG.CODPLT = R034PRM.CODPLT
            AND R058RLG.CODRLG = R034PRM.CODRLG
            AND R058MOD.MODRLG = R058RLG.MODRLG
            AND R058MOD.FABMOD > 1
            AND R058RLG.COMRLG = 2;
  EXCEPTION
      WHEN OTHERS THEN l_PrmDspCSM := 0;
  END;

  /* Para TSI sempre chama a rotina, mesmo sem dispositivos na permissão */
  /* Pois pode ser o processo de exclusão */
  l_matcod := 'N';
  l_chcAce := 0;
  BEGIN
      SELECT CHCACE, MATCOD INTO l_chcAce, l_matcod FROM R070TSI;
  EXCEPTION
      WHEN OTHERS THEN
          l_chcAce:= 0;
          l_matcod := 'N';
  END;

  IF (l_PrmDspCSM > 0) OR (l_matcod = 'S') THEN
      l_cracha     := 0;
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_data_atual := CURDATE();
      l_data_zero  := '31/12/1900,00:00:00';

      /*RETORNA A PESSOA A PARTIR DO IDTPES*/
      SP_PESFROMIDTPES(p_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT
                               , l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);

      /*BUSCA O CRACHÁ, SENÃO INFORMADO*/
      IF (p_numcra = 0) THEN
          /*Visitante*/
          IF (l_tippes = 4) THEN
              BEGIN
                  SELECT NUMCRA INTO l_cracha FROM R090HCH
                   WHERE R090HCH.TIPDOC = l_tipdoc AND
                     R090HCH.NUMDOC = l_numdoc AND
                     (R090HCH.DATINI < l_data_atual OR
                      (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
                     (R090HCH.DATFIM = l_data_zero OR
                      R090HCH.DATFIM > l_data_atual OR
                      (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
              EXCEPTION
                  WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro em R090HCH - TOO MANY ROWS';
                  WHEN NO_DATA_FOUND THEN  l_cracha := 0;
                  WHEN OTHERS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro no SELECT R090HCH.';
              END;
          ELSE
              /*Paciente*/
              IF (l_tippes = 9) THEN
                  BEGIN
                      SELECT NUMCRA INTO l_cracha FROM R097INT
                       WHERE PROPAC = l_propac
                         AND ( (DATFIM > l_data_atual) OR
                             ((DATFIM = l_data_atual) AND (HORFIM >= l_hora_atual)) OR
                             (DATFIM = l_data_zero) );
                  EXCEPTION
                      WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro em R097INT - TOO MANY ROWS';
                      WHEN NO_DATA_FOUND THEN l_cracha := 0;
                      WHEN OTHERS THEN RAISERROR 103 'SP_ATUPRMLOC: Erro no SELECT R097INT.';
                  END;
              ELSE
                  /*Outras unidades*/
                  IF (l_tippes = 5) THEN
                      SP_RETCRA (2, l_numemp, 5, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                      IF   (l_cracha = 0)  THEN
                          SP_RETCRA (1, l_numemp, 5, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                      END IF;
                  ELSE
                  /* Aluno */
                      IF (l_tippes = 10) THEN
                          SP_RETCRA (2, l_numemp, 6, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                          IF   (l_cracha = 0)  THEN
                              SP_RETCRA (1, l_numemp, 6, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                          END IF;
                      ELSE
                          /* Colaboradores */
                          IF (l_tippes < 4) THEN
                              SP_RETCRA (2, l_numemp, l_tipcol, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                              IF   (l_cracha = 0)  THEN
                                  SP_RETCRA (1, l_numemp, l_tipcol, l_numcad, 0, l_nummat, l_tipdoc, l_numdoc, l_cracha OUT);
                              END IF;
                          END IF;
                      END IF;
                  END IF;
              END IF;
          END IF;
      ELSE   /*CASO O CRACHÁ FOR INFORMADO NO PARÂMETRO*/
          l_cracha := p_numcra;
      END IF;

      /*Efetua as operações somente se existir crachá ativo*/
      IF (l_cracha <> 0) THEN

          /* Só gerar se tiver permissão por local físico em dispositivos <> TSI */
          /* A exclusão é feita pela tela */
          IF (l_PrmDspCSM > 0) THEN
              SP_PEND79(p_idtpes); /*GERA PENDÊNCIA 79. UPDATEPersonPrecisionPermission, para a concentradora*/
          END IF;

          /**** INÍCIO INTEGRAÇÃO TELEMÁTICA ****/
          IF (l_matcod = 'S') THEN
              l_dia_sem   := 0;
              l_count_fai := 0;
              SP_USUTEL(l_usutel OUT);
              l_verplf := 1;

              /*Sempre remove o crachá lógico para evitar sobreposições*/
              SP_INTSTR(l_cracha,'999999999999', l_icard OUT);
              l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_icard||'''';
              SP_CMDTSI(l_comando);


              SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
		      /*Se utilizar definição para gravar número físico no ICARD salva igual como é salvo na tabela CONTROLE*/
		      IF (l_chcAce = 1) THEN
                  /*remove todas as definições da pessoa antes de inserir*/
                  IF (l_numbar > 0) THEN
                      SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
                  IF (l_numpro > 0) THEN
                      SP_INTSTR(l_numpro,'999999999999', l_numpro_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numpro_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
                  IF (l_numsma > 0) THEN
                      SP_INTSTR(l_numsma, '999999999999', l_numsma_str OUT);
                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numsma_str||'''';
                      SP_CMDTSI(l_comando);
                  END IF;
		      ELSE
                  IF (l_chcAce = 3) THEN
                      IF (l_numbar > 0) THEN
	                      SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
	                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
	                      SP_CMDTSI(l_comando);
	                  END IF;
	                  IF (l_numsma > 0) THEN
	                      SP_INTSTR(l_numsma, '999999999999', l_numsma_str OUT);
	                      l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numsma_str||'''';
	                      SP_CMDTSI(l_comando);
	                  END IF;
                  ELSE
	                 IF (l_crapri > 0) AND ((l_tecpri < 3) OR (l_chcAce = 3))  THEN
	                     /*remove todas as definições da pessoa antes de inserir*/
	                     IF (l_numbar > 0) THEN
	                         SP_INTSTR(l_numbar,'999999999999', l_numbar_str OUT);
	                         l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numbar_str||'''';
	                         SP_CMDTSI(l_comando);
	                     END IF;
	                     IF (l_numpro > 0) THEN
	                         SP_INTSTR(l_numpro,'999999999999', l_numpro_str OUT);
	                         l_comando := 'DELETE FROM '||l_usutel||'MATCODIN WHERE ICARD='''||l_numpro_str||'''';
	                         SP_CMDTSI(l_comando);
	                     END IF;
	                 END IF;
                  END IF;
		      END IF;


              /*VARRE TODOS OS DISPOSITIVOS PARA ALIMENTAR AS TABELAS DA TELEMÁTICA*/
              FOREACH C_R034PRM_LOC INTO l_r034prm_loc.CODDSP
                                       , l_r034prm_loc.CODCEN
                                       , l_r034prm_loc.RLGALF
                                       , l_r034prm_loc.NUMEIP
              LOOP

                  BEGIN
                      SELECT CODPLF INTO l_codplf_dsp FROM R058DSP WHERE CODDSP = l_r034prm_loc.CODDSP;
                  EXCEPTION
                      WHEN OTHERS THEN l_codplf_dsp := 0;
                  END;

                  l_dia_sem := 1;

                  /*VARRE OS DIAS DA SEMANA*/
                  LOOP
                      l_codplf_pai := l_codplf_dsp;
                      l_codplf     := l_codplf_dsp;
                      l_coddsp_aux := l_r034prm_loc.CODDSP;
                      /*BUSCA A AÇÃO DA FAIXA PARA O DIA*/
                      BEGIN
                          SELECT ACOFAI INTO l_acofai FROM R034AFD
                           WHERE IDTPES = p_idtpes AND CODDSP = l_r034prm_loc.CODDSP AND DIASEM = l_dia_sem ;
                      EXCEPTION
                          WHEN OTHERS THEN l_acofai := 0;
                      END;

                      /*ENQUANTO EXISTIR AÇÃO NA FAIXA*/
                      LOOP
                          IF ( l_acofai = 0 ) THEN
                              EXIT;
                          END IF;

                          /*LIBERADO, deve buscar as faixas*/
                          IF ( l_acofai = 1 ) THEN
                              l_count_fai := 0;
                              l_faiprm := '';
                              /*BUSCA AS FAIXAS*/
                              FOREACH C_R034FAP_LOC INTO l_r034fap_loc.INIFAI, l_r034fap_loc.FIMFAI
                              LOOP
                                  l_count_fai := l_count_fai + 1;
                                  SP_INTSTR(l_r034fap_loc.INIFAI, 'HHMM', l_inifai_str OUT);
                                  SP_INTSTR(l_r034fap_loc.FIMFAI, 'HHMM', l_fimfai_str OUT);
                                  l_faiprm := l_faiprm || l_inifai_str || l_fimfai_str;
                              END LOOP;

                              IF ( l_count_fai = 0 ) THEN
                                  /*sem faixa e liberado = 00:00 ás 23:59 para este dia*/
                                  l_faiprm := '00002359';
                                  l_count_fai := 1;
                              END IF;

                              /*valida se faltou faixas*/
                              LOOP
                                  IF ( l_count_fai = 7 ) THEN
                                      EXIT;
                                  END IF;
                                  l_faiprm := l_faiprm || '24002400';
                                  l_count_fai := l_count_fai + 1;
                              END LOOP;

                              l_comando := 'INSERT INTO '||l_usutel||'MATCODIN (END_IP,BLUEB,CODIN,DIASEM,FXPERM,ICARD) ';
                              /*caso ip zerado, utiliza o rlgalf e codcen*/
                              IF (l_r034prm_loc.NUMEIP = '000.000.000.000') THEN
                                  SP_INTSTR(l_r034prm_loc.CODCEN, '99', l_blueb OUT);
                                  l_codin := SUBSTRING(l_r034prm_loc.RLGALF,1, 2);
                                  l_comando := l_comando || ' VALUES(''000.000.000.000'',''' || l_blueb || ''',''' || l_codin || '''';
                              ELSE
                                  l_comando := l_comando || ' VALUES(''' || l_r034prm_loc.NUMEIP || ''',''00'',''00''';
                              END IF;
                              SP_INTSTR(l_dia_sem, '9', l_dia_sem_str OUT);
                              l_comando := l_comando || ','''||l_dia_sem_str||''','''||l_faiprm||''',';

						      /*Se utilizar definição para gravar número físico no ICARD salva igual como é salvo na tabela CONTROLE*/
						      IF (l_chcAce = 1) THEN
	                              /*insere as faixas*/
	                              IF (l_numbar > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
	                              IF (l_numpro > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numpro_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
	                              IF (l_numsma > 0) THEN
	                                  l_comando_ins := l_comando || ' ''' || l_numsma_str || ''') ';
	                                  SP_CMDTSI(l_comando_ins);
	                              END IF;
						      ELSE
                                  IF (l_chcAce = 3) THEN
                                      IF (l_numbar > 0) THEN
	                                      l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
	                                  IF (l_numsma > 0) THEN
	                                      l_comando_ins := l_comando || ' ''' || l_numsma_str || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
                                  ELSE
	                                  /*insere as faixas*/
	                                  IF (l_crapri > 0) AND (l_tecpri < 3)  THEN
	                                      IF (l_numbar > 0) THEN
	                                          l_comando_ins := l_comando || ' ''' || l_numbar_str || ''') ';
	                                          SP_CMDTSI(l_comando_ins);
	                                      END IF;
	                                      IF (l_numpro > 0) THEN
	                                          l_comando_ins := l_comando || ' ''' || l_numpro_str || ''') ';
	                                          SP_CMDTSI(l_comando_ins);
	                                      END IF;
	                                  ELSE
	                                      l_comando_ins := l_comando || ' ''' || l_icard || ''') ';
	                                      SP_CMDTSI(l_comando_ins);
	                                  END IF;
                                  END IF;
						      END IF;
                              EXIT;
                          ELSE
                              /*UTILIZA FAIXA PAI, deve buscar as definições dos locais pais*/
                              IF (l_acofai = 2) THEN
                                  l_coddsp_aux := 0;
                                  l_codplf     := l_codplf_pai;
                                  /*BUSCA A AÇÃO DA FAIXA*/
                                  BEGIN
                                      SELECT ACOFAI INTO l_acofai FROM R034AFL
                                       WHERE IDTPES = p_idtpes
                                         AND CODPLF = l_codplf
                                         AND VERPLF = l_verplf
                                         AND DIASEM = l_dia_sem;
                                  EXCEPTION
                                      WHEN OTHERS THEN l_acofai := 0;
                                  END;

                                  /*BUSCA O LOCAL PAI*/
                                  BEGIN
                                      SELECT PAIPLF INTO l_codplf_pai FROM R058PLF WHERE CODPLF = l_codplf AND VERPLF = l_verplf;
                                  EXCEPTION
                                      WHEN OTHERS THEN l_codplf_pai := 0;
                                  END;
                              END IF;
                          END IF;
                      END LOOP;

                      l_dia_sem := l_dia_sem + 1;
                      IF (l_dia_sem > 8) THEN
                          EXIT;
                      END IF;
                  END LOOP;
              END LOOP;
          END IF; /**** FIM INTEGRAÇÃO TELEMÁTICA ****/
      END IF; /* (l_cracha <> 0) */
   END IF;  /* (l_PrmDspCSM > 0) OR (l_matcon = 'S') */
END␀ñ÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
›PROCEDURE SP_ATUTSI(P_IDTPES VARCHAR2(23),P_CRAPRI NUMBER(12),P_ATUCRE BOOLEAN,P_ATUMSG BOOLEAN,P_SUBNV BOOLEAN,P_ATUFXH BOOLEAN)
 IS
BEGIN
  NULL;
END		SENIOR;20:SP_INTSTR
SP_DATSTR
SP_STRTODATE
SP_CMDTSI
SP_SELTSI
9ë␀␀PROCEDURE SP_ATUTSI(P_IDTPES VARCHAR2(23),P_CRAPRI NUMBER(12),P_ATUCRE BOOLEAN,P_ATUMSG BOOLEAN,P_SUBNV BOOLEAN,P_ATUFXH BOOLEAN)
 IS

/*Variáveis SELECT R070CON*/
  l_Iniafa              VARCHAR2(16);
  l_DatAfa              VARCHAR2(16);
  l_SenCol              VARCHAR2(6);
  l_Dinpr1              VARCHAR2(10);
  l_Dfnpr1              VARCHAR2(10);
  l_Dinpr2              VARCHAR2(10);
  l_Dfnpr2              VARCHAR2(10);
  l_Dinpr3              VARCHAR2(10);
  l_Dfnpr3              VARCHAR2(10);
  l_DatMsg              VARCHAR2(16);
  l_MsgAcc              VARCHAR2(32);
  l_FaiAc1              VARCHAR2(56);
  l_FaiAc2              VARCHAR2(56);
  l_FaiAc3              VARCHAR2(56);
  l_FaiAc4              VARCHAR2(56);
  l_FaiAc5              VARCHAR2(56);
  l_FaiAc6              VARCHAR2(56);
  l_FaiAc7              VARCHAR2(56);
  l_FaiPt1              VARCHAR2(56);
  l_FaiPt2              VARCHAR2(56);
  l_FaiPt3              VARCHAR2(56);
  l_FaiPt4              VARCHAR2(56);
  l_FaiPt5              VARCHAR2(56);
  l_FaiPt6              VARCHAR2(56);
  l_FaiPt7              VARCHAR2(56);
  l_FaiRef              VARCHAR2(56);
  l_CreFx1              VARCHAR2(8);
  l_CreFx2              VARCHAR2(8);
  l_CreFx3              VARCHAR2(8);
  l_CreFx4              VARCHAR2(8);
  l_CreFx5              VARCHAR2(8);
  l_CreFx6              VARCHAR2(8);
  l_VerVal_con          CHAR(1);
  l_QtdCr1              NUMBER(2);
  l_QtdCr2              NUMBER(2);
  l_QtdCr3              NUMBER(2);
  l_QtdCr4              NUMBER(2);
  l_QtdCr5              NUMBER(2);
  l_QtdCr6              NUMBER(2);
  l_BloFal_con          NUMBER(1);
  l_ConAdp              NUMBER(1);
  l_VerPrm              NUMBER(1);
  l_TemAlm              NUMBER(3);
  l_ConCre              NUMBER(1);
  l_ConFai              NUMBER(1);
  l_VerAfa_con          NUMBER(1);
  l_Prmrt1              NUMBER(5);
  l_Prmrt2              NUMBER(5);
  l_Prmrt3              NUMBER(5);
  l_ConIal              NUMBER(1);
  l_QtdMsg              NUMBER(2);
  l_BloAut              NUMBER(1);
  l_CodPrm              NUMBER(5);
  l_prmAen              NUMBER(5);
  l_PrmSab              NUMBER(5);
  l_PrmDom              NUMBER(5);
  l_PrmFer              NUMBER(5);
  l_UsaBio              NUMBER(1);
  l_GraCon              NUMBER(3);
  l_ConInt              NUMBER(1);
  l_TolInt              NUMBER(3);
  l_conpac              NUMBER(1);
  l_tempac              NUMBER(3);
  l_tolacp              NUMBER(2);
  l_tipcra              NUMBER(2);  
  /*Variáveis da Controle*/
  l_icard               CHAR(12);
  l_icard_chcpri        CHAR(12);
  l_icard_bkp           CHAR(12);
  l_NumSerial           CHAR(10);
  l_Titular             CHAR(12);
  l_codig               CHAR(6);
  l_grupo               CHAR(3);
  l_grupo_5             CHAR(5);
  l_tpfis               CHAR(1);
  l_situa               CHAR(1);
  l_subnv               CHAR(5);
  l_subnv_5             CHAR(5);
  l_datahora            VARCHAR2(10);
  l_fx_flg              CHAR(1); /* Controla Intervalo de Almoço */
  l_tempo_alm           CHAR(3); /* Tempo Mínimo de Almoço (Minutos) */
  l_datini              CHAR(6);
  l_horini              CHAR(4);
  l_datfim              CHAR(6);
  l_retnumberaux        NUMBER;
  l_reterr              NUMBER(1);

  /* Controle de Mensagens */
  l_desmsg              VARCHAR2(32);
  l_dta_msg             CHAR(6);
  l_dta_msg_aux         CHAR(8);
  l_qtd_mens            CHAR(2);
  /* Controle de Creditos de Acesso */
  l_cred_fx1            CHAR(2);
  l_fx1                 CHAR(8);
  l_cred_fx2            CHAR(2);
  l_fx2                 CHAR(8);
  l_cred_fx3            CHAR(2);
  l_fx3                 CHAR(8);
  l_cred_fx4            CHAR(2);
  l_fx4                 CHAR(8);
  l_cred_fx5            CHAR(2);
  l_fx5                 CHAR(8);
  l_cred_fx6            CHAR(2);
  l_fx6                 CHAR(8);
  /* Controle de Areas Restritas */
  l_grupo1              CHAR(3);
  l_grupo1_5            CHAR(5);
  l_datinig1            CHAR(10);
  l_datfimg1            CHAR(10);
  l_grupo2              CHAR(3);
  l_grupo2_5            CHAR(5);
  l_datinig2            CHAR(10);
  l_datfimg2            CHAR(10);
  l_grupo3              CHAR(3);
  l_grupo3_5            CHAR(5);
  l_datinig3            CHAR(10);
  l_datfimg3            CHAR(10);
  l_grupo_sab           CHAR(3);
  l_grupo_dom           CHAR(3);
  l_grupo_fer           CHAR(3);
  l_grupo_sab_5         CHAR(5);
  l_grupo_dom_5         CHAR(5);
  l_grupo_fer_5         CHAR(5);
  l_anti_dupla          CHAR(1); /* Controla Anti-Dupla */
  l_bloq_falta          CHAR(1); /* Bloqueia Acesso por Falta */
  l_ver_hora            CHAR(1); /* Controla Faixa Horária de Acesso */
  l_ver_local           CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_valid           CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_afast           CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_cred            CHAR(1); /* Controla Creditos de acesso Refeitorio */
  l_vis_esp             CHAR(1); /* se for visitante especial bloqueia automaticamente na saida. */
  l_ver_digit           CHAR(1); /* Controla utiliza Biometria */
  l_faixa               CHAR(56);
  l_flg_tempo_min       CHAR(1);
  l_tempo_minimo        CHAR(3);
  l_tol_entrada         CHAR(2);
  l_tol_saida           CHAR(2);
  /*Interjornadas*/
  l_tempo_ret           CHAR(3);
  l_toler_ret           CHAR(3);
  l_ver_ret             CHAR(1);
  /*Saída Máxima*/
  l_tempo_jornada       CHAR(3);
  l_ver_saidamax        CHAR(1);
  /*Variáveis de gerenciamento da controle*/
  /*INSERT*/
  l_cmdinscol           VARCHAR2(2048);
  l_cmdinsval           VARCHAR2(2048);
  l_cmdauxval           VARCHAR2(2048);
  l_cmdauxcol           VARCHAR2(2048);
  /*UPDATE*/
  l_cmdupd              VARCHAR2(2048);
  l_cmdauxupd           VARCHAR2(2048);
  l_cmdupdaen           VARCHAR2(2048);  
  /*FxHoraria*/
  l_cmdinsfxh           VARCHAR2(2048);
  l_cmdvalfxh           VARCHAR2(2048);
  l_cmdupdfxh           VARCHAR2(2048);
  l_mesvalfxh           VARCHAR2(2048);
  l_mesupdfxh           VARCHAR2(2048);
  l_fxhauxval           VARCHAR2(2048);
  l_fxhauxcol           VARCHAR2(2048);
  l_fxhauxupd           VARCHAR2(2048);
  /*Comando pré Definido Crachá Mestre*/
  /*INSERT*/
  l_mesinsval           VARCHAR2(2048);
  l_mesauxval           VARCHAR2(2048);
  /*UPDATE*/
  l_mesupd              VARCHAR2(2048);
  l_mesauxupd           VARCHAR2(2048);
  l_comando_controle    VARCHAR2(2048);
  l_comando_fxhoraria   VARCHAR2(2048);
  l_comando_SELECT      VARCHAR2(512);
  l_campoCred           BOOLEAN;
  l_semfxh              BOOLEAN;
  l_temAen              BOOLEAN;  
  l_nodatafound         BOOLEAN;
  l_persig              CHAR(1);
  l_usutel              VARCHAR2(31);
  l_chcass              CHAR(1);
  /*Controle de Campos Telemática (Tabela R070TSI)*/
  l_temgrp              CHAR(1);
  l_antdpl              CHAR(1);
  l_blofal              CHAR(1);
  l_tmpalm              CHAR(1);
  l_verhor              CHAR(1);
  l_verloc              CHAR(1);
  l_verval              CHAR(1);
  l_verafa              CHAR(1);
  l_vercre              CHAR(1);
  l_visesp              CHAR(1);
  l_verdig              CHAR(1);
  l_temfxh              CHAR(1);
  l_planta              CHAR(1);
  l_numser              CHAR(1);
  l_temtit              CHAR(1);
  l_temcrc              CHAR(1);
  l_temInt              CHAR(1);
  l_tempac_tsi          CHAR(1);
  l_chcAce              NUMBER(1);
  l_chcRep              NUMBER(1);
  l_data_atual          DATE;
  l_hora_atual          NUMBER(4);
  l_data_atual_aux      CHAR(6);
  l_dta_msg_Date        DATE;
  l_achou               BOOLEAN;
  l_ediprm              CHAR(5);
  l_newprm              BOOLEAN;
  l_idtpes              VARCHAR2(23);
  l_tipcol              CHAR(2);
  l_horNum              NUMBER(2);
  l_MinNum              NUMBER(2);
  l_horaux              NUMBER(4);
  l_dataux              DATE;     
  l_datstr              CHAR(6);
  l_dat_conv            VARCHAR(25); /*Variável auxiliar para conversão de data*/
  /*Cursos que obtem os crachás da Pessoa*/
  CURSOR c_r070con IS
  SELECT NUMCRA, NUMFIS, TIPCRA, INIVAL, DATVAL, SITCRA, TECCRA, CHCPRI, NIVATU
  FROM R070CON WHERE IDTPES = p_IdtPes ORDER BY TECCRA;
  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NUMCRA%TYPE,
    NUMFIS   R070CON.NUMFIS%TYPE,
    TIPCRA   R070CON.TIPCRA%TYPE,
    INIVAL   R070CON.INIVAL%TYPE,
    DATVAL   R070CON.DATVAL%TYPE,
    SITCRA   R070CON.SITCRA%TYPE,
    TECCRA   R070CON.TECCRA%TYPE,
    CHCPRI   R070CON.CHCPRI%TYPE,
    NIVATU   R070CON.NIVATU%TYPE);
  l_r070con t_r070con;

BEGIN
  /*Inicializações*/
  l_achou := TRUE;
  l_VerVal_con := '1';
  l_semfxh := FALSE;
  l_faixa := '00002359240024002400240024002400240024002400240024002400';
  /*Verificar as será necessário informar o owner para os objetos da telemática*/
  BEGIN
      SELECT CHCASS, USUTEL INTO l_chcass, l_usutel FROM R070DAC;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'SP_ATUTSI: Não Conseguiu Efetuar SELECT na Tabela R070DAC.';
  END;

  BEGIN
      SELECT EDIPRM INTO l_ediprm FROM R000ASS;
      IF (l_ediprm = '99999') THEN
          l_newprm := TRUE;
      ELSE
          l_newprm := FALSE;
      END IF;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'SP_ATUTSI: Não conseguiu obter a máscara da permissão R000ASS.EDIPRM.';
  END;

  /*Tratamento para o campo Usutel*/
  IF ((l_usutel IS NULL) OR (l_usutel = '') OR (l_usutel = ' ')) THEN
    l_usutel := '';
  ELSE
    l_usutel := l_usutel ||'.';
  END IF;
  /*Obtem as informações da pessoa*/
  BEGIN
      SELECT Iniafa, DatAfa, BloFal, ConAdp, VerPrm, SenCol, TemAlm, ConCre,
             ConFai, VerAfa, Prmrt1, Dinpr1, Dfnpr1, Prmrt2, Dinpr2, Dfnpr2,
             Prmrt3, Dinpr3, Dfnpr3, FaiAc1, FaiAc2, FaiAc3, FaiAc4, FaiAc5,
             FaiAc6, FaiAc7, FaiPt1, FaiPt2, FaiPt3, FaiPt4, FaiPt5, FaiPt6,
             FaiPt7, QtdCr1, QtdCr2, QtdCr3, QtdCr4, QtdCr5, QtdCr6, CreFx1,
             CreFx2, CreFx3, CreFx4, CreFx5, CreFx6, FaiRef, ConIal, BloAut,
             CodPrm, PrmSab, PrmDom, PrmFer, UsaBio, GraCon, DatMsg, MsgAcc,
             QtdMsg, ConInt, TolInt, ConPac, TemPac, TolAcp, TipCra
      INTO
             l_Iniafa, l_DatAfa, l_BloFal_con, l_ConAdp, l_VerPrm, l_SenCol, l_TemAlm, l_ConCre,
             l_ConFai, l_VerAfa_con, l_Prmrt1, l_Dinpr1, l_Dfnpr1, l_Prmrt2, l_Dinpr2, l_Dfnpr2,
             l_Prmrt3, l_Dinpr3, l_Dfnpr3, l_FaiAc1, l_FaiAc2, l_FaiAc3, l_FaiAc4, l_FaiAc5,
             l_FaiAc6, l_FaiAc7, l_FaiPt1, l_FaiPt2, l_FaiPt3, l_FaiPt4, l_FaiPt5, l_FaiPt6,
             l_FaiPt7, l_QtdCr1, l_QtdCr2, l_QtdCr3, l_QtdCr4, l_QtdCr5, l_QtdCr6, l_CreFx1,
             l_CreFx2, l_CreFx3, l_CreFx4, l_CreFx5, l_CreFx6, l_FaiRef, l_ConIal, l_BloAut,
             l_CodPrm, l_PrmSab, l_PrmDom, l_PrmFer, l_UsaBio, l_GraCon, l_DatMsg, l_MsgAcc,
             l_QtdMsg, l_ConInt, l_TolInt, l_ConPac, l_TemPac, l_TolAcp, l_TipCra
      FROM R070CON WHERE IDTPES = p_idtpes AND NumFis = p_CraPri;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_achou := FALSE;
      WHEN OTHERS THEN
        l_achou := FALSE;
        RAISERROR 103 'ERRO NO SELECT DAS DEFINIÇÕES DA PESSOA. ';
  END;
  IF (l_achou = TRUE) THEN
      /*Conversão para inserção nos campos da telemática*/
      l_codig := l_sencol;

      IF (l_newprm = TRUE) THEN
          SP_INTSTR(l_CodPrm,'99999',l_grupo_5 OUT);
      ELSE
          SP_INTSTR(l_CodPrm,'999',l_grupo OUT);
      END IF;

      SP_INTSTR(l_ConIal,'9',l_fx_flg OUT);
      SP_INTSTR(l_TemAlm, '999',l_tempo_alm OUT);

      l_data_atual := CURDATE();
      SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_datini := SUBSTRING (l_iniafa,1,6);
      l_horini := SUBSTRING (l_iniafa,7,4);
      l_datfim := SUBSTRING (l_datafa,1,6);

      IF (l_datini <> '000000') THEN
        /*CONVERTE CARACTERE EM DATA*/
          l_dat_conv := SUBSTRING(l_datini,1,2)||'/'||SUBSTRING(l_datini,3,2) ||'/'||SUBSTRING(l_datini,5,2);
          SP_STRTODATE(l_dat_conv, 'DD/MM/AA', l_dataux OUT);
          l_dat_conv := SUBSTRING(l_datstr,1,2)||'/'||SUBSTRING(l_datstr,3,2)||'/'||SUBSTRING(l_datstr,5,2);
          SP_STRTODATE(l_dat_conv, 'DD/MM/AA', l_data_atual OUT);

         l_HorNum := CONVERT(CHAR_TO_NUMBER,SUBSTRING(l_horini, 1,2));
         l_MinNum := CONVERT(CHAR_TO_NUMBER,SUBSTRING(l_horini, 3,2));
         l_horaux := (l_horNum*60) + (l_minNum);

         
         IF ((l_dataux > l_data_atual) OR ((l_dataux = l_data_atual) AND (l_horaux > l_hora_atual))) THEN
             l_datini := '000000';
         END IF;
      END IF;

      IF (l_datini = '000000') THEN
          l_datini := '      ';
          l_datfim := '      ';
      END IF;
      l_desmsg := l_MsgAcc;
      l_dta_msg := SUBSTRING (l_DatMsg,1,6);
      IF (l_dta_msg = '000000') OR (l_dta_msg IS NULL) THEN
          l_dta_msg := '      ';
      ELSE
          BEGIN
              /*Tratamento de Datas*/
              l_data_atual := CURDATE();
              /*CONVERTE CARACTERE EM DATA*/
              SP_STRTODATE(l_dta_msg, 'DDMMAA', l_dta_msg_date OUT);
              IF (l_data_atual < l_dta_msg_date) THEN
                  l_dta_msg := '999999';
              END IF;
          EXCEPTION
            WHEN OTHERS THEN
              NULL;
          END;
      END IF;
      SP_INTSTR(l_QtdMsg, '99',l_qtd_mens OUT);
      SP_INTSTR(l_qtdcr1, '99',l_cred_fx1 OUT);
      l_fx1 := l_crefx1;
      SP_INTSTR(l_qtdcr2, '99',l_cred_fx2 OUT);
      l_fx2 := l_crefx2;
      SP_INTSTR(l_qtdcr3, '99',l_cred_fx3 OUT);
      l_fx3 := l_crefx3;
      SP_INTSTR(l_qtdcr4, '99',l_cred_fx4 OUT);
      l_fx4 := l_crefx4;
      SP_INTSTR(l_qtdcr5, '99',l_cred_fx5 OUT);
      l_fx5 := l_crefx5;
      SP_INTSTR(l_qtdcr6, '99',l_cred_fx6 OUT);
      l_fx6 := l_crefx6;
      /* Controle de Areas Restritas */
      IF (l_newprm = TRUE) THEN
          SP_INTSTR(l_prmrt1, '99999',l_grupo1_5 OUT);
      ELSE
          SP_INTSTR(l_prmrt1, '999',l_grupo1 OUT);
      END IF;
      l_datinig1 := l_dinpr1;
      l_datfimg1 := l_dfnpr1;
      IF (l_datinig1 = '0000000000') THEN
          l_datinig1 := '          ';
          l_datfimg1 := '          ';
      END IF;

      IF (l_newprm = TRUE) THEN
          SP_INTSTR(l_prmrt2, '99999',l_grupo2_5 OUT);
      ELSE
          SP_INTSTR(l_prmrt2, '999',l_grupo2 OUT);
      END IF;

      l_datinig2 := l_dinpr2;
      l_datfimg2 := l_dfnpr2;
      IF (l_datinig2 = '0000000000') THEN
          l_datinig2 := '          ';
          l_datfimg2 := '          ';
      END IF;

      IF (l_newprm = TRUE) THEN
          SP_INTSTR(l_prmrt3, '99999',l_grupo3_5 OUT);
      ELSE
          SP_INTSTR(l_prmrt3, '999',l_grupo3 OUT);
      END IF;
      l_datinig3 := l_dinpr3;
      l_datfimg3 := l_dfnpr3;
      IF (l_datinig3 = '0000000000') THEN
          l_datinig3 := '          ';
          l_datfimg3 := '          ';
      END IF;

      IF (l_newprm = TRUE) THEN
          SP_INTSTR(l_prmsab, '99999',l_grupo_sab_5 OUT);
          SP_INTSTR(l_prmdom, '99999',l_grupo_dom_5 OUT);
          SP_INTSTR(l_prmfer, '99999',l_grupo_fer_5 OUT);
      ELSE
          SP_INTSTR(l_prmsab, '999',l_grupo_sab OUT);
          SP_INTSTR(l_prmdom, '999',l_grupo_dom OUT);
          SP_INTSTR(l_prmfer, '999',l_grupo_fer OUT);
      END IF;
      SP_INTSTR(l_conadp, '9',l_anti_dupla OUT);
      SP_INTSTR(l_blofal_con, '9',l_bloq_falta OUT);
      SP_INTSTR(l_confai, '9',l_ver_hora OUT);
      SP_INTSTR(l_verprm, '9',l_ver_local OUT);
      l_ver_valid := l_verval_con; /*Valor padrão 1*/
      SP_INTSTR(l_verafa_con, '9',l_ver_afast OUT);
      /*reserva de créditos funciona apenas para digicon*/
      IF (l_concre = 4) THEN
        l_concre := 1;
      END IF;

      SP_INTSTR(l_concre, '9',l_ver_cred OUT);
      SP_INTSTR(l_bloaut, '9',l_vis_esp OUT);
      IF (l_usabio > 1) THEN
          l_ver_digit := '2';
      ELSE
          l_ver_digit := '1';
      END IF;
      l_NumSerial := '0000000000';
      /*Interjornadas*/
      SP_INTSTR(l_ConInt, '9',l_ver_ret OUT);
      SP_INTSTR(l_TolInt, '999',l_toler_ret OUT);
      l_tempo_ret := '011';
      l_tempo_jornada := '000';
      l_ver_saidamax := '0';
      /*Tempo Mínimo de Permanência*/
      SP_INTSTR(l_conpac, '9',l_flg_tempo_min OUT);
      SP_INTSTR(l_tempac, '999',l_tempo_minimo OUT);
      SP_INTSTR(l_tolacp, '99',l_tol_entrada OUT);
      SP_INTSTR(l_tolacp, '99',l_tol_saida OUT);

      /* Verifica os Campos INSERT/update utilizados */
      /*Campos INSERT Crachá Normal*/
      l_cmdinscol := 'CODIG,FX_FLG,DATINI,DATFIM,GRUPO1,DATINIG1,DATFIMG1,GRUPO2,DATINIG2,'||
                     'DATFIMG2,GRUPO3,DATINIG3,DATFIMG3,GRUPO';

      IF (l_newprm = TRUE) THEN
          /*Valor INSERT Crachá Normal*/
          l_cmdinsval := ''''||l_codig||''''||','||''''||l_fx_flg||''''||','||''''||l_datini||''''||','
                         ||''''||l_datfim||''''||','||''''||l_grupo1_5||''''||','||''''||l_datinig1||''''||','
                         ||''''||l_datfimg1||''''||','||''''||l_grupo2_5||''''||','||''''||l_datinig2||''''||','
                         ||''''||l_datfimg2||''''||','||''''||l_grupo3_5||''''||','||''''||l_datinig3||''''||','
                         ||''''||l_datfimg3||''''||','||''''||l_grupo_5||'''';

          /*Valor INSERT Mestre*/
          l_mesinsval := '''      '',''0'',''      '', ''      '',''00000'',''          '',''          '','||
                         '''00000'',''          '',''          '',''00000'',''          '',''          '',''00000''';
      ELSE
          /*Valor INSERT Crachá Normal*/
          l_cmdinsval := ''''||l_codig||''''||','||''''||l_fx_flg||''''||','||''''||l_datini||''''||','
                         ||''''||l_datfim||''''||','||''''||l_grupo1||''''||','||''''||l_datinig1||''''||','
                         ||''''||l_datfimg1||''''||','||''''||l_grupo2||''''||','||''''||l_datinig2||''''||','
                         ||''''||l_datfimg2||''''||','||''''||l_grupo3||''''||','||''''||l_datinig3||''''||','
                         ||''''||l_datfimg3||''''||','||''''||l_grupo||'''';

          /*Valor INSERT Mestre*/
          l_mesinsval := '''      '',''0'',''      '', ''      '',''000'',''          '',''          '','||
                         '''000'',''          '',''          '',''000'',''          '',''          '',''000''';
      END IF;

      IF (l_newprm = TRUE) THEN
        /*UPDATE Crachá Normal*/
          l_cmdupd := 'CODIG = '||''''||l_codig||''''||', FX_FLG = '||''''||l_fx_flg||''''||
                      ', DATINI = '||''''||l_datini||''''||', DATFIM = '||''''||l_datfim||''''||
                      ', GRUPO1 = '||''''||l_grupo1_5||''''||', DATINIG1 = '||''''||l_datinig1||''''||
                      ', DATFIMG1 = '||''''||l_datfimg1||''''||', GRUPO2 = '||''''||l_grupo2_5||''''||
                      ', DATINIG2 = '||''''||l_datinig2||''''||', DATFIMG2 = '||''''||l_datfimg2||''''||
                      ', GRUPO3 = '||''''||l_grupo3_5||''''||', DATINIG3 = '||''''||l_datinig3||''''||
                      ', DATFIMG3 = '||''''||l_datfimg3||''''||', GRUPO = '||''''||l_grupo_5||'''';
        /*UPDATE Crachá Mestre*/
        l_mesupd := 'CODIG = ''      '', FX_FLG = ''0'', DATINI = ''      '', DATFIM = ''      '','||
                      ' GRUPO1 = ''00000'', DATINIG1 = ''          '', DATFIMG1 = ''          '','||
                      ' GRUPO2 = ''00000'', DATINIG2 = ''          '', DATFIMG2 = ''          '','||
                      ' GRUPO3 = ''00000'', DATINIG3 = ''          '', DATFIMG3 = ''          '','||
                      ' GRUPO = ''00000''';
      ELSE
          /*UPDATE Crachá Normal*/
          l_cmdupd := 'CODIG = '||''''||l_codig||''''||', FX_FLG = '||''''||l_fx_flg||''''||
                      ', DATINI = '||''''||l_datini||''''||', DATFIM = '||''''||l_datfim||''''||
                      ', GRUPO1 = '||''''||l_grupo1||''''||', DATINIG1 = '||''''||l_datinig1||''''||
                      ', DATFIMG1 = '||''''||l_datfimg1||''''||', GRUPO2 = '||''''||l_grupo2||''''||
                      ', DATINIG2 = '||''''||l_datinig2||''''||', DATFIMG2 = '||''''||l_datfimg2||''''||
                      ', GRUPO3 = '||''''||l_grupo3||''''||', DATINIG3 = '||''''||l_datinig3||''''||
                      ', DATFIMG3 = '||''''||l_datfimg3||''''||', GRUPO = '||''''||l_grupo||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := 'CODIG = ''      '', FX_FLG = ''0'', DATINI = ''      '', DATFIM = ''      '','||
                      ' GRUPO1 = ''000'', DATINIG1 = ''          '', DATFIMG1 = ''          '','||
                      ' GRUPO2 = ''000'', DATINIG2 = ''          '', DATFIMG2 = ''          '','||
                      ' GRUPO3 = ''000'', DATINIG3 = ''          '', DATFIMG3 = ''          '','||
                      ' GRUPO = ''000''';
      END IF;
      /*FxHoraria*/
      /*INSERT*/
      l_cmdinsfxh := 'FX_DOM_A,FX_SEG_A,FX_TER_A,FX_QUA_A,FX_QUI_A,FX_SEX_A,FX_SAB_A,FX_DOM_P,'||
                     'FX_SEG_P,FX_TER_P,FX_QUA_P,FX_QUI_P,FX_SEX_P,FX_SAB_P,FX_REF';

      l_cmdvalfxh := ''''||l_faiac1||''''||','||''''||l_faiac2||''''||','||''''||l_faiac3||''''||','
                     ||''''||l_faiac4||''''||','||''''||l_faiac5||''''||','||''''||l_faiac6||''''||','
                     ||''''||l_faiac7||''''||','||''''||l_faipt1||''''||','||''''||l_faipt2||''''||','
                     ||''''||l_faipt3||''''||','||''''||l_faipt4||''''||','||''''||l_faipt5||''''||','
                     ||''''||l_faipt6||''''||','||''''||l_faipt7||''''||','||''''||l_fairef||'''';
      /*Mestre*/
      l_mesvalfxh := ''''||l_faixa||''''||','||''''||l_faixa||''''||','||''''||l_faixa||''''||','
                     ||''''||l_faixa||''''||','||''''||l_faixa||''''||','||''''||l_faixa||''''||','
                     ||''''||l_faixa||''''||','||''''||l_faixa||''''||','||''''||l_faixa||''''||','
                     ||''''||l_faixa||''''||','||''''||l_faixa||''''||','||''''||l_faixa||''''||','
                     ||''''||l_faixa||''''||','||''''||l_faixa||''''||','||''''||l_faixa||'''';
      /*UPDATE*/
      l_cmdupdfxh := 'FX_DOM_A = '||''''||l_faiac1||''''||', FX_SEG_A = '||''''||l_faiac2||''''||
                     ', FX_TER_A = '||''''||l_faiac3||''''||', FX_QUA_A = '||''''||l_faiac4||''''||
                     ', FX_QUI_A = '||''''||l_faiac5||''''||', FX_SEX_A = '||''''||l_faiac6||''''||
                     ', FX_SAB_A = '||''''||l_faiac7||''''||', FX_DOM_P = '||''''||l_faipt1||''''||
                     ', FX_SEG_P = '||''''||l_faipt2||''''||', FX_TER_P = '||''''||l_faipt3||''''||
                     ', FX_QUA_P = '||''''||l_faipt4||''''||', FX_QUI_P = '||''''||l_faipt5||''''||
                     ', FX_SEX_P = '||''''||l_faipt6||''''||', FX_SAB_P = '||''''||l_faipt7||''''||
                     ', FX_REF = '||''''||l_fairef||'''';
      /*Mestre*/
      l_mesupdfxh := 'FX_DOM_A = '||''''||l_faixa||''''||', FX_SEG_A = '||''''||l_faixa||''''||
                     ', FX_TER_A = '||''''||l_faixa||''''||', FX_QUA_A = '||''''||l_faixa||''''||
                     ', FX_QUI_A = '||''''||l_faixa||''''||', FX_SEX_A = '||''''||l_faixa||''''||
                     ', FX_SAB_A = '||''''||l_faixa||''''||', FX_DOM_P = '||''''||l_faixa||''''||
                     ', FX_SEG_P = '||''''||l_faixa||''''||', FX_TER_P = '||''''||l_faixa||''''||
                     ', FX_QUA_P = '||''''||l_faixa||''''||', FX_QUI_P = '||''''||l_faixa||''''||
                     ', FX_SEX_P = '||''''||l_faixa||''''||', FX_SAB_P = '||''''||l_faixa||''''||
                     ', FX_REF = '||''''||l_faixa||'''';

      /* verifica na tabala R070TSI quais os campos que a Controle opera */                               
      BEGIN
          SELECT temgrp, antdpl, blofal, tmpalm, verhor, verloc, verval, verafa, vercre,
                 visesp, verdig, temfxh, planta, numser, temtit, temcrc, conint, tempac,
                 chcAce, chcRep
          INTO   l_temgrp, l_antdpl, l_blofal, l_tmpalm, l_verhor, l_verloc, l_verval, l_verafa, l_vercre,
                 l_visesp, l_verdig, l_temfxh, l_planta, l_numser, l_temtit, l_temcrc, l_temInt, l_tempac_tsi,
                 l_chcAce, l_chcRep
          FROM R070TSI;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          RAISERROR 103 'SP_ATUTSI: Não Encontrou Resgistro na Tabela R070TSI';
        WHEN OTHERS THEN
          RAISERROR 103 'SP_ATUTSI: Não foi possível Obter as Definições da Tabela R070TSI';
      END;
      
      IF  l_temgrp = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ',GRUPO_SAB,GRUPO_DOM,GRUPO_FER';
          IF (l_newprm = TRUE) THEN
              /*Variáveis de INSERT*/
              l_cmdinsval := l_cmdinsval || ','||''''||l_grupo_sab_5||''''||
                                            ','||''''||l_grupo_dom_5||''''||
                                            ','||''''||l_grupo_fer_5||'''';
              /*INSERT Crachá Mestre*/
              l_mesinsval := l_mesinsval || ',''00000'',''00000'',''00000''';
          ELSE
              /*Variáveis de INSERT*/
              l_cmdinsval := l_cmdinsval || ','||''''||l_grupo_sab||''''||
                                            ','||''''||l_grupo_dom||''''||
                                            ','||''''||l_grupo_fer||'''';
              /*INSERT Crachá Mestre*/
              l_mesinsval := l_mesinsval || ',''000'',''000'',''000''';
          END IF;

          IF (l_newprm = TRUE) THEN
              /*Variáveis de UPDATE*/
              l_cmdupd := l_cmdupd ||', GRUPO_SAB = '||''''||l_grupo_sab_5||''''||
                                     ', GRUPO_DOM = '||''''||l_grupo_dom_5||''''||
                                     ', GRUPO_FER = '||''''||l_grupo_fer_5||'''';
              /*UPDATE Crachá Mestre*/
              l_mesupd := l_mesupd ||', GRUPO_SAB = ''00000'', GRUPO_DOM = ''00000'', GRUPO_FER = ''00000''';
          ELSE
              /*Variáveis de UPDATE*/
              l_cmdupd := l_cmdupd ||', GRUPO_SAB = '||''''||l_grupo_sab||''''||
                                     ', GRUPO_DOM = '||''''||l_grupo_dom||''''||
                                     ', GRUPO_FER = '||''''||l_grupo_fer||'''';
              /*UPDATE Crachá Mestre*/
              l_mesupd := l_mesupd ||', GRUPO_SAB = ''000'', GRUPO_DOM = ''000'', GRUPO_FER = ''000''';
          END IF;
      END IF;
      IF  l_temcrc = 'S' THEN
          l_campoCred := TRUE;
      END IF;
      /*IF  l_campo = 'PLANTA' THEN*/
          /*?????????????????????????*/
      /*END;*/
      IF  l_antdpl = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,ANTI_DUPLA';
          l_cmdinsval := l_cmdinsval || ','||''''||l_anti_dupla||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';

          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', ANTI_DUPLA = '||''''||l_anti_dupla||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', ANTI_DUPLA = ''0''';
      END IF;
      IF  l_blofal = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,BLOQ_FALTA';
          l_cmdinsval := l_cmdinsval || ','||''''||l_bloq_falta||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', BLOQ_FALTA = '||''''||l_bloq_falta||'''';
           /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', BLOQ_FALTA = ''0''';
      END IF;

      IF  l_tmpalm = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,TEMPO_ALM';
          l_cmdinsval := l_cmdinsval || ','||''''||l_tempo_alm||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''000''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', TEMPO_ALM = '||''''||l_tempo_alm||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', TEMPO_ALM = ''000''';
      END IF;

      IF  l_verhor = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,VER_HORA';
          l_cmdinsval := l_cmdinsval || ','||''''||l_ver_hora||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', VER_HORA = '||''''||l_ver_hora||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', VER_HORA = ''0''';
      END IF;
      IF  l_verloc = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,VER_LOCAL';
          l_cmdinsval := l_cmdinsval || ','||''''||l_ver_local||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', VER_LOCAL = '||''''||l_ver_local||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', VER_LOCAL = ''0''';

      END IF;
      IF  l_verval = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,VER_VALID';
          l_cmdinsval := l_cmdinsval || ','||''''||l_ver_valid||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', VER_VALID = '||''''||l_ver_valid||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', VER_VALID = ''0''';
      END IF;
      IF  l_verafa = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,VER_AFAST';
          l_cmdinsval := l_cmdinsval || ','||''''||l_ver_afast||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', VER_AFAST = '||''''||l_ver_afast||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', VER_AFAST = ''0''';
      END IF;
      IF  l_vercre = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,VER_CRED';
          l_cmdinsval := l_cmdinsval || ','||''''||l_ver_cred||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', VER_CRED = '||''''||l_ver_cred||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', VER_CRED = ''0''';
      END IF;
      IF  l_visesp = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,VIS_ESP';
          l_cmdinsval := l_cmdinsval || ','||''''||l_vis_esp||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', VIS_ESP = '||''''||l_vis_esp||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', VIS_ESP = ''0''';
      END IF;
      IF  l_verdig = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,VER_DIGIT';
          l_cmdinsval := l_cmdinsval || ','||''''||l_ver_digit||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ','||''''||l_ver_digit||'''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', VER_DIGIT = '||''''||l_ver_digit||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd || ', VER_DIGIT = '||''''||l_ver_digit||'''';
      END IF;

      /*Controle de Interjornadas*/
      IF l_temint = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,TEMPO_RET,TOLER_RET,VER_RET,TEMPO_JORNADA,VER_SAIDAMAX';
          l_cmdinsval := l_cmdinsval || ','||''''||l_tempo_ret||''''||
                                        ','||''''||l_toler_ret||''''||
                                        ','||''''||l_ver_ret||''''||
                                        ','||''''||l_tempo_jornada||''''||
                                        ','||''''||l_ver_saidamax||'''';

          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''000'''||
                                        ',''000'''||
                                        ',''0'''||
                                        ',''000'''||
                                        ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', TEMPO_RET = '||''''||l_tempo_ret||''''||
                                  ', TOLER_RET = '||''''||l_toler_ret||''''||
                                  ', VER_RET = '||''''||l_ver_ret||''''||
                                  ', TEMPO_JORNADA = '||''''||l_tempo_jornada||''''||
                                  ', VER_SAIDAMAX = '||''''||l_ver_saidamax||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd || ', TEMPO_RET = ''000'''||
                                  ', TOLER_RET = ''000'''||
                                  ', VER_RET = ''0'''||
                                  ', TEMPO_JORNADA = ''000'''||
                                  ', VER_SAIDAMAX = ''0''';
      END IF;

      /*Tempo Mínimo de Permanência*/
      IF l_tempac_tsi = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,FLG_TEMPO_MIN,TEMPO_MINIMO,TOL_ENTRADA,TOL_SAIDA';
          l_cmdinsval := l_cmdinsval || ','||''''||l_flg_tempo_min||''''||
                                        ','||''''||l_tempo_minimo||''''||
                                        ','||''''||l_tol_entrada||''''||
                                        ','||''''||l_tol_saida||'''';

          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0'''||
                                        ',''000'''||
                                        ',''00'''||
                                        ',''00''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', FLG_TEMPO_MIN = '||''''||l_flg_tempo_min||''''||
                                  ', TEMPO_MINIMO = '||''''||l_tempo_minimo||''''||
                                  ', TOL_ENTRADA = '||''''||l_tol_entrada||''''||
                                  ', TOL_SAIDA = '||''''||l_tol_saida||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd || ', FLG_TEMPO_MIN = ''0'''||
                                  ', TEMPO_MINIMO = ''000'''||
                                  ', TOL_ENTRADA = ''00'''||
                                  ', TOL_SAIDA = ''00''';
      END IF;

      IF  l_temfxh = 'N' THEN
          l_semfxh := TRUE;
          IF p_atufxh = TRUE THEN
              /*Variáveis de INSERT*/
              l_cmdinscol := l_cmdinscol || ' ,FX_DOM,FX_SEG,FX_TER,FX_QUA,FX_QUI,FX_SEX,FX_SAB,FX_REF';
              l_cmdinsval := l_cmdinsval || ','||''''||l_FaiAc1||''''||
                                            ','||''''||l_FaiAc2||''''||
                                            ','||''''||l_FaiAc3||''''||
                                            ','||''''||l_FaiAc4||''''||
                                            ','||''''||l_FaiAc5||''''||
                                            ','||''''||l_FaiAc6||''''||
                                            ','||''''||l_FaiAc7||''''||
                                            ','||''''||l_FaiRef||'''';
              /*INSERT Crachá Mestre*/
              l_mesinsval := l_mesinsval || ','||''''||l_faixa||''''||
                                            ','||''''||l_faixa||''''||
                                            ','||''''||l_faixa||''''||
                                            ','||''''||l_faixa||''''||
                                            ','||''''||l_faixa||''''||
                                            ','||''''||l_faixa||''''||
                                            ','||''''||l_faixa||''''||
                                            ','||''''||l_faixa||'''';
              /*Variáveis de UPDATE*/
              l_cmdupd := l_cmdupd ||', FX_DOM = '||''''||l_FaiAc1||''''||
                                     ', FX_SEG = '||''''||l_FaiAc2||''''||
                                     ', FX_TER = '||''''||l_FaiAc3||''''||
                                     ', FX_QUA = '||''''||l_FaiAc4||''''||
                                     ', FX_QUI = '||''''||l_FaiAc5||''''||
                                     ', FX_SEX = '||''''||l_FaiAc6||''''||
                                     ', FX_SAB = '||''''||l_FaiAc7||''''||
                                     ', FX_REF = '||''''||l_FaiRef||'''';

              /*UPDATE Crachá Mestre*/
              l_mesupd := l_mesupd ||', FX_DOM = '||''''||l_faixa||''''||
                                     ', FX_SEG = '||''''||l_faixa||''''||
                                     ', FX_TER = '||''''||l_faixa||''''||
                                     ', FX_QUA = '||''''||l_faixa||''''||
                                     ', FX_QUI = '||''''||l_faixa||''''||
                                     ', FX_SEX = '||''''||l_faixa||''''||
                                     ', FX_SAB = '||''''||l_faixa||''''||
                                     ', FX_REF = '||''''||l_faixa||'''';
          END IF;
      END IF;


      FOREACH c_r070con INTO l_r070con.NumCra, l_r070con.NumFis, l_r070con.TipCra, l_r070con.IniVal,
                             l_r070con.DatVal, l_r070con.SitCra, l_r070con.TecCra, l_r070con.ChcPri,
                             l_r070con.NivAtu LOOP

          /*Para crachá de autorização de entrada ou mestre, atualiza somente os crachás deste tipo*/
          IF (l_tipcra = 12) THEN
              IF (l_r070con.TipCra <> 12) THEN
                  GOTO continue_LOOP;
              END IF;
          ELSE
              IF (l_tipcra = 8) THEN
                  IF (l_r070con.TipCra <> 8) THEN
                    GOTO continue_LOOP;
                  END IF;
              END IF;
          END IF;

          l_cmdauxcol:= '';
          l_cmdauxval:= '';
          l_cmdauxupd:= '';
          l_fxhauxcol:= '';
          l_fxhauxval:= '';
          l_fxhauxupd:= '';
          /*Crachá Mestre*/
          l_mesauxval:= '';
          l_mesauxupd:= '';

          /*Obtem as outras informações do crachá*/
          l_datahora := SUBSTRING (l_r070con.DatVal,1,10);
          SP_INTSTR(l_r070con.SitCra, '9',l_situa OUT);
          SP_INTSTR(l_r070con.NumFis, '999999999999',l_icard OUT);
          
          IF (l_r070con.TecCra = 3) THEN
              IF (l_chcAce = 0 OR l_chcAce = 3) THEN
                  SP_INTSTR(l_r070con.ChcPri, '999999999999',l_icard_chcpri OUT);
                  SP_INTSTR(l_r070con.NumFis, '9999999999',l_NumSerial OUT);
              ELSE
                  SP_INTSTR(l_r070con.NumFis, '999999999999',l_icard OUT);	
                  l_NumSerial := '0000000000';			
              END IF;
          END IF;

          /*Guarda para fazer o SELECT na FXHORARIA*/
          l_icard_bkp := l_icard;

          IF (l_r070con.TipCra > 9) THEN /*Prever tipos maiores do que 9*/
              l_tpfis := '0';
          ELSE
              SP_INTSTR(l_r070con.TipCra, '9',l_tpfis OUT);
          END IF;

          /*Tratamento especial para crachá Smart*/
          IF (l_r070con.TecCra = 3) THEN /*Smart*/
          
              /* alteração Adri */
              IF (l_r070con.ChcPri <> 0) THEN
                  IF l_numser = 'S' THEN /*Se existe o campo NUMSERIAL*/
                      IF (l_chcAce = 0 OR l_chcAce = 3) THEN
                          SP_INTSTR(l_r070con.ChcPri, '999999999999',l_icard_chcpri OUT);
                          SP_INTSTR(l_r070con.NumFis, '9999999999',l_NumSerial OUT);
                      ELSE
                          SP_INTSTR(l_r070con.NUMFIS, '999999999999',l_icard_chcpri OUT);
                          l_NumSerial := '0000000000';
                      END IF;
                      l_comando_controle := 'UPDATE '|| l_usutel ||'CONTROLE SET NUMSERIAL = '||''''||l_NumSerial||''''||
                                            'WHERE ICARD = ' ||''''||l_icard_chcpri||'''';
                      SP_CMDTSI(l_comando_controle);
                  END IF;
              ELSE
                  /*Considera Como Icard o Número da Matrícula*/
                  IF (l_chcAce = 0 OR l_chcAce = 3) THEN
                      SP_INTSTR(l_r070con.NumCra, '999999999999',l_icard OUT);
                  ELSE
                      SP_INTSTR(l_r070con.NumFis, '999999999999',l_icard OUT);
                  END IF;
				  
				  /*Guarda para fazer o SELECT na FXHORARIA*/
				  l_icard_bkp := l_icard;
				  
                  /*Consistência Número Serial*/
                  IF l_numser = 'S' THEN /*Se existe o campo NUMSERIAL*/
                      SP_INTSTR(l_r070con.NumFis, '9999999999',l_NumSerial OUT);
                      /*INSERT*/
                      l_cmdauxcol := l_cmdauxcol || ',NUMSERIAL';
                      l_cmdauxval := l_cmdauxval || ','||''''||l_NumSerial||'''';
                      /*Crachá Mestre*/
                      l_mesauxval := l_mesauxval || ','||''''||l_NumSerial||'''';
                      /*UPDATE*/
                      l_cmdauxupd := l_cmdauxupd || ', NUMSERIAL = '||''''||l_NumSerial||'''';
                      /*Crachá Mestre*/
                      l_mesauxupd := l_mesauxupd || ', NUMSERIAL = '||''''||l_NumSerial||'''';
                  END IF;
              END IF;
          
          
          ELSE
              /*Para os demais crachás com tecnologia diferente de smart (3)*/
              IF l_numser = 'S' THEN /*Se existe o campo NUMSERIAL*/
                  /*INSERT*/
                  l_cmdauxcol := l_cmdauxcol || ',NUMSERIAL';
                  l_cmdauxval := l_cmdauxval || ','||''''||l_NumSerial||'''';
                  /*Crachá Mestre*/
                  l_mesauxval := l_mesauxval || ','||''''||l_NumSerial||'''';
                  /*UPDATE*/
                  l_cmdauxupd := l_cmdauxupd || ', NUMSERIAL = '||''''||l_NumSerial||'''';
                  /*Crachá Mestre*/
                  l_mesauxupd := l_mesauxupd || ', NUMSERIAL = '||''''||l_NumSerial||'''';
              END IF;
          END IF;
          /*INSERT*/
          l_cmdauxcol := l_cmdauxcol || ',ICARD,TPFIS,DATAHORA';
          l_cmdauxval := l_cmdauxval || ','||''''||l_icard||''''||
                                        ','||''''||l_tpfis||''''||
                                        ','||''''||l_datahora||'''';
          /*Crachá Mestre*/
          l_mesauxval := l_mesauxval || ','||''''||l_icard||''''||
                                        ','||''''||l_tpfis||''''||
                                        ','||''''||l_datahora||'''';
          /*UPDATE*/
          l_cmdauxupd := l_cmdauxupd || ', ICARD = '||''''||l_icard||''''||
                                        ', TPFIS = '||''''||l_tpfis||''''||
                                        ', DATAHORA = '||''''||l_datahora||'''';
          /*Crachá Mestre*/
          l_mesauxupd := l_mesauxupd || ', ICARD = '||''''||l_icard||''''||
                                        ', TPFIS = '||''''||l_tpfis||''''||
                                        ', DATAHORA = '||''''||l_datahora||'''';
          /*FxHoraria*/
          l_fxhauxcol := l_fxhauxcol || ',ICARD';
          l_fxhauxval := l_fxhauxval || ','||''''||l_icard||'''';
          l_fxhauxupd := l_fxhauxupd || ', ICARD = '||''''||l_icard||'''';


          /*Tratamento Especial para o Campo Situa*/
          IF ((l_temtit = 'S') AND (l_chcass = 'S')) THEN /*Definição da r070dac utiliza crachá associado.*/
              IF (l_r070con.chcpri = 0) THEN
                  IF (l_r070con.SITCRA = 0) THEN
                      l_situa := '7'; /*Principal Liberado*/
                  ELSE
                      l_situa := '1'; /*Principal Bloqueado*/
                  END IF;
              ELSE
                  l_situa := '4'; /*Crachá Secundário, se comportará de acordo com o Crachá Principal.*/
                  SP_INTSTR(l_r070con.ChcPri, '999999999999',l_Titular OUT);
                  /*Adiciona o Campo Titular na String*/
                  /*INSERT*/
                  l_cmdauxcol := l_cmdauxcol || ',TITULAR';
                  l_cmdauxval := l_cmdauxval || ','||''''||l_Titular||'''';
                  /*Crachá Mestre*/
                  l_mesauxval := l_mesauxval || ','||''''||l_Titular||'''';
                  /*UPDATE*/
                  l_cmdauxupd := l_cmdauxupd || ', TITULAR = '||''''||l_Titular||'''';
                  /*Crachá Mestre*/
                  l_mesauxupd := l_mesauxupd || ', TITULAR = '||''''||l_Titular||'''';
              END IF;
          END IF;
          /*Adiciona o Comando Situa na String*/
          /*INSERT*/
          l_cmdauxcol := l_cmdauxcol || ',SITUA';
          l_cmdauxval := l_cmdauxval || ','||''''||l_situa||'''';

          /*Crachá Mestre*/
          l_mesauxval := l_mesauxval || ','||''''||l_situa||'''';
          /*UPDATE*/
          l_cmdauxupd := l_cmdauxupd || ', SITUA = '||''''||l_situa||'''';
          /*Crachá Mestre*/
          l_mesauxupd := l_mesauxupd || ', SITUA = '||''''||l_situa||'''';

          /*Verifica se vai fazer INSERT/update, monta o comando e executa.*/
          l_nodatafound := FALSE;
          BEGIN
                l_comando_SELECT := 'SELECT ICARD FROM '||l_usutel||'CONTROLE WHERE ICARD = '''||l_icard||'''';
                SP_SELTSI(1, 'l_icard', l_comando_select, l_retnumberaux OUT, l_icard OUT, l_reterr OUT);
                IF (l_reterr = 1) THEN /*NO_DATA_FOUND*/
                    L_NODATAFOUND:=TRUE;
                END IF;
                IF (l_reterr = 2) THEN /*TOO_MANY_ROWS*/
                    RAISERROR 103 'SPUPDTSI: Erro em Controle - TOO MANY ROWS';
                END IF;
          EXCEPTION
              WHEN OTHERS THEN RAISERROR 103 'SPUPDTSI: Erro No SELECT Controle 1 - SUBNV.';
          END;

          /*Verifica se Atualiza Créditos de Acesso*/
          IF (p_atucre = TRUE) OR (l_noDataFound = TRUE) THEN

              l_cmdauxcol := l_cmdauxcol ||',CRED_FX1,FX_1,CRED_FX2,FX_2,CRED_FX3,FX_3,CRED_FX4,FX_4';
              l_cmdauxval := l_cmdauxval ||','||''''||l_cred_fx1||''''||','||''''||l_fx1||''''
                                         ||','||''''||l_cred_fx2||''''||','||''''||l_fx2||''''
                                         ||','||''''||l_cred_fx3||''''||','||''''||l_fx3||''''
                                         ||','||''''||l_cred_fx4||''''||','||''''||l_fx4||'''';

              /*Crachá Mestre*/
              l_mesauxval := l_mesauxval ||',''00'',''24002400'',''00'',''24002400'''
                                         ||',''00'',''24002400'',''00'',''24002400''';

              l_cmdauxupd := l_cmdauxupd ||', CRED_FX1 = '||''''||l_cred_fx1||''''||
                          ', FX_1 = '||''''||l_fx1||''''||', CRED_FX2 = '||''''||l_cred_fx2||''''||
                          ', FX_2 = '||''''||l_fx2||''''||', CRED_FX3 = '||''''||l_cred_fx3||''''||
                          ', FX_3 = '||''''||l_fx3||''''||', CRED_FX4 = '||''''||l_cred_fx4||''''||
                          ', FX_4 = '||''''||l_fx4||'''';

              /*Crachá Mester*/
              l_mesauxupd := l_mesauxupd ||', CRED_FX1 = ''00'', FX_1 = ''24002400'''
                                         ||', CRED_FX2 = ''00'', FX_2 = ''24002400'''
                                         ||', CRED_FX3 = ''00'', FX_3 = ''24002400'''
                                         ||', CRED_FX4 = ''00'', FX_4 = ''24002400''';

              IF (l_campoCred = TRUE) THEN
                  /*Variáveis de INSERT*/
                  l_cmdauxcol := l_cmdauxcol || ',CRED_FX5,FX_5,CRED_FX6,FX_6';
                  l_cmdauxval := l_cmdauxval || ','||''''||l_cred_fx5||''''||
                                                ','||''''||l_fx5||''''||
                                                ','||''''||l_cred_fx6||''''||
                                                ','||''''||l_fx6||'''';
                  /*Crachá Mestre*/
                  l_mesauxval := l_mesauxval ||',''00'',''24002400'',''00'',''24002400''';

                  /*Variáveis de UPDATE*/
                  l_cmdauxupd := l_cmdauxupd || ', CRED_FX5 = '||''''||l_cred_fx5||''''||
                                          ', FX_5 = '||''''||l_fx5||''''||
                                          ', CRED_FX6 = '||''''||l_cred_fx6||''''||
                                          ', FX_6 = '||''''||l_fx6||'''';
                  /*Crachá Mestre*/
                  l_mesauxupd := l_mesauxupd ||', CRED_FX5 = ''00'', FX_5 = ''24002400'''
                                             ||', CRED_FX6 = ''00'', FX_6 = ''24002400''';
              END IF;
          END IF;  

          /*Verifica se Atualiza SubNv*/

          IF (length(l_r070con.NivAtu) = 5) THEN
            l_subnv_5 := l_r070con.NivAtu;
          ELSE
            l_subnv_5 := l_r070con.NivAtu||'00';
          END IF;
          l_subnv   := l_r070con.NivAtu;


          IF (l_nodatafound = TRUE) THEN
              /* se não achou na controle é só INSERT e então verificar se é com 5 ou 3 dígitos*/
              IF (p_subnv = TRUE) THEN
                  IF (l_newprm = TRUE)THEN
                      /*INSERT*/
                      l_cmdauxcol := l_cmdauxcol || ',SUBNV';
                      l_cmdauxval := l_cmdauxval || ','||''''||l_subnv_5||'''';
                      /*Crachá Mestre*/
                      l_mesauxval := l_mesauxval || ','||''''||l_subnv_5||'''';
                      /*UPDATE*/
                      l_cmdauxupd := l_cmdauxupd || ', SUBNV = '||''''||l_subnv_5||'''';
                      /*Crachá Mestre*/
                      l_mesauxupd := l_mesauxupd || ', SUBNV = '||''''||l_subnv_5||'''';
                  ELSE
                      /*INSERT*/
                      l_cmdauxcol := l_cmdauxcol || ',SUBNV';
                      l_cmdauxval := l_cmdauxval || ','||''''||l_subnv||'''';
                      /*Crachá Mestre*/
                      l_mesauxval := l_mesauxval || ','||''''||l_subnv||'''';
                      /*UPDATE*/
                      l_cmdauxupd := l_cmdauxupd || ', SUBNV = '||''''||l_subnv||'''';
                      /*Crachá Mestre*/
                      l_mesauxupd := l_mesauxupd || ', SUBNV = '||''''||l_subnv||'''';
                  END IF;
              END IF;
          ELSE
              /* se existe na controle, verificar se é com 5 ou 3 dígitos e ainda se é INSERT ou update */
              IF (p_subnv = TRUE) THEN
                  IF (l_newprm = TRUE)THEN
                      /*UPDATE*/
                      l_cmdauxupd := l_cmdauxupd || ', SUBNV = '||''''||l_subnv_5||'''';
                      /*Crachá Mestre*/
                      l_mesauxupd := l_mesauxupd || ', SUBNV = '||''''||l_subnv_5||'''';
                  ELSE
                      /*UPDATE*/
                      l_cmdauxupd := l_cmdauxupd || ', SUBNV = '||''''||l_subnv||'''';
                      /*Crachá Mestre*/
                      l_mesauxupd := l_mesauxupd || ', SUBNV = '||''''||l_subnv||'''';
                  END IF;
              END IF;
          END IF;




          /*Verifica se Atualiza a Mensagem*/
          IF (p_atumsg = TRUE) OR (l_nodatafound = TRUE) THEN
              /*INSERT*/
              l_cmdauxcol := l_cmdauxcol ||',MENSAGEM,DTA_MENS,QTD_MENS';
              l_cmdauxval := l_cmdauxval ||','||''''||l_desmsg||''''||
                             ','||''''||l_dta_msg||''''||
                             ','||''''||l_qtd_mens||'''';
              /*Crachá Mestre*/
              l_mesauxval := l_mesauxval ||',''                                '',''      '',''00''';

              /*UPDATE*/
              l_cmdauxupd := l_cmdauxupd || ', MENSAGEM = '||''''||l_desmsg||''''||
                             ', DTA_MENS = '||''''||l_dta_msg||''''||
                             ', QTD_MENS = '||''''||l_qtd_mens||'''';
              /*Crachá Mestre*/
              l_mesauxupd := l_mesauxupd ||', MENSAGEM = ''                                '', DTA_MENS = ''      '''
                                         ||', QTD_MENS = ''00''';
          END IF;

          /*Verifica se Atualiza a ultpas_ref*/
          l_idtpes := p_idtpes;
          l_idtpes := lTrim(l_idtpes);
          l_idtpes := rTrim(l_idtpes);

          IF (Length(l_idtpes) > 2) THEN
              l_tipcol := SUBSTRING(l_idtpes,1,2);

            IF (l_tipcol = '04') THEN
                /*INSERT*/
                l_cmdauxcol := l_cmdauxcol || ',ULTPAS_REF';
                l_cmdauxval := l_cmdauxval ||',''''';
                 /*Crachá Mestre*/
                l_mesauxval := l_mesauxval || ',''''';
                 /*UPDATE*/
                l_cmdauxupd := l_cmdauxupd || ', ULTPAS_REF = ''''';
                /*Crachá Mestre*/
                l_mesauxupd := l_mesauxupd || ', ULTPAS_REF = ''''';
            END IF;
          END IF;

          /*Verifica se o Comando será para Crachá Mestre*/
          IF  (l_r070con.TipCra = 8) THEN
              /*Crachá Mestre*/
              IF  (l_nodatafound = TRUE) THEN
                  l_comando_controle := 'INSERT INTO '|| l_usutel ||'CONTROLE ('|| l_cmdinscol || l_cmdauxcol||') VALUES ('
                                                       || l_mesinsval || l_mesauxval ||')';
              ELSE
                  l_comando_controle := 'UPDATE '|| l_usutel ||'CONTROLE SET ' || l_mesupd || l_mesauxupd ||
                               ' WHERE ICARD = '||''''||l_icard|| '''';
              END IF;
          ELSE
              /*Crachá Normal*/
              IF  (l_nodatafound = TRUE) THEN
                  l_comando_controle := 'INSERT INTO '|| l_usutel ||'CONTROLE ('|| l_cmdinscol || l_cmdauxcol||') VALUES ('
                                                       || l_cmdinsval || l_cmdauxval ||')';
              ELSE
                  l_comando_controle := 'UPDATE '|| l_usutel ||'CONTROLE SET ' || l_cmdupd || l_cmdauxupd ||
                               ' WHERE ICARD = '||''''||l_icard|| '''';
              END IF;
          END IF;
          /*Monta o Comando de Atualização da Fx_Horaria*/

          /*Verifica se o Comando será para Autorização de Entrada*/
          IF (l_r070con.TipCra=8) THEN
              IF (l_nodatafound=TRUE) THEN
                  l_comando_controle := 'INSERT INTO '||l_usutel||'CONTROLE ('||l_cmdinscol||l_cmdauxcol||') VALUES ('||l_mesinsval||l_mesauxval||')';
              ELSE
                  l_comando_controle := 'UPDATE '||l_usutel||'CONTROLE SET '||l_mesupd||l_mesauxupd||' WHERE ICARD = '||''''||l_icard||'''';
              END IF;
          ELSE
              IF (l_nodatafound=TRUE) THEN
                  l_comando_controle := 'INSERT INTO '||l_usutel||'CONTROLE ('||l_cmdinscol||l_cmdauxcol||') VALUES ('||l_cmdinsval||l_cmdauxval||')';
              ELSE
                  l_comando_controle := 'UPDATE '||l_usutel||'CONTROLE SET '||l_cmdupd||l_cmdauxupd||' WHERE ICARD = '||''''||l_icard||'''';
              END IF;
          END IF;
          SP_CMDTSI(l_comando_controle);
          IF (l_r070con.TipCra = 12) THEN
              l_temAen := TRUE;

              BEGIN
                  SELECT CODPRM INTO l_prmAen FROM R070CON WHERE NUMCRA = l_r070con.NUMCRA;
              EXCEPTION
                  WHEN OTHERS THEN l_temAen := FALSE;
              END;

              IF (l_temAen = TRUE) THEN
                  IF (l_newprm = TRUE) THEN
                      SP_INTSTR(l_prmAen,'99999',l_grupo_5);
                      l_cmdupdaen := ' GRUPO = '||''''||l_grupo_sab_5||''''||', GRUPO_SAB = '||''''||l_grupo_sab_5||''''||', GRUPO_DOM = '||''''||l_grupo_dom_5||''''||', GRUPO_FER = '||''''||l_grupo_fer_5||'''';
                  ELSE
                      SP_INTSTR(l_prmAen,'999',l_grupo);
                      l_cmdupdaen := ' GRUPO = '||''''||l_grupo||''''||', GRUPO_SAB = '||''''||l_grupo||''''||', GRUPO_DOM = '||''''||l_grupo||''''||', GRUPO_FER = '||''''||l_grupo||'''';
                  END IF;
                  IF (l_verafa = 'S') THEN
                      l_cmdupdaen := l_cmdupdaen||', VER_AFAST = ''0''';
                  END IF;
                  IF (l_verhor = 'S') THEN
                      l_cmdupdaen := l_cmdupdaen||', VER_HORA = ''0''';
                  END IF;

                  l_comando_controle := 'UPDATE '||l_usutel||'CONTROLE SET '||l_cmdupdaen||' WHERE ICARD = '||''''||l_icard||'''';
                  SP_CMDTSI(l_comando_controle);
              END IF;
          END IF;

          IF ((l_semfxh = FALSE) AND (p_atufxh = TRUE)) THEN
              /*Verifica se vai fazer INSERT/update, monta o comando e executa.*/
              l_nodatafound := FALSE;
              BEGIN
                  l_comando_SELECT := 'SELECT ICARD FROM '||l_usutel||'FXHORARIA WHERE ICARD = '''||l_icard_bkp||'''';
                  SP_SELTSI(1, 'l_icard', l_comando_select, l_retnumberaux OUT, l_icard OUT, l_reterr OUT);
                  IF (l_reterr = 1) THEN /*NO_DATA_FOUND*/
                      L_NODATAFOUND:=TRUE;
                  END IF;
                  IF (l_reterr = 2) THEN /*TOO_MANY_ROWS*/
                      RAISERROR 103 'SPUPDTSI: Erro em FXHORARIA - TOO MANY ROWS';
                  END IF;
              EXCEPTION
                  WHEN OTHERS THEN RAISERROR 103 'SPUPDTSI: Erro No SELECT Fxhoraria 1.';
              END;

              /*Verifica se o Comando será para Crachá Mestre*/
              IF  (l_r070con.TipCra = 8) THEN
                  /*Crachá Mestre*/
                  IF  (l_nodatafound = TRUE) THEN
                      l_comando_fxhoraria := 'INSERT INTO '|| l_usutel ||'FXHORARIA ('||l_cmdinsfxh||l_fxhauxcol||') VALUES ('
                                                                      ||l_mesvalfxh||l_fxhauxval||')';
                  ELSE
                      l_comando_fxhoraria := 'UPDATE '|| l_usutel ||'FXHORARIA SET ' ||l_mesupdfxh||l_fxhauxupd||
                                             ' WHERE ICARD = '||''''||l_icard|| '''';
                  END IF;
              ELSE
                  /*Crachá Normal*/
                  IF  (l_nodatafound = TRUE) THEN
                      l_comando_fxhoraria := 'INSERT INTO '|| l_usutel ||'FXHORARIA ('||l_cmdinsfxh||l_fxhauxcol||') VALUES ('
                                                                      ||l_cmdvalfxh||l_fxhauxval||')';
                  ELSE
                      l_comando_fxhoraria := 'UPDATE '|| l_usutel ||'FXHORARIA SET ' ||l_cmdupdfxh||l_fxhauxupd||
                                             ' WHERE ICARD = '||''''||l_icard|| '''';
                  END IF;
              END IF;
              SP_CMDTSI(l_comando_fxhoraria);
          END IF;
          <<continue_LOOP>>
          NULL;
      END LOOP;
  END IF;
END		SENIOR;23:SP_INTSTR
SP_DATSTR
SP_STRTODATE
SP_CMDTSI
SP_SELTSI
9ë␀␀PROCEDURE SP_ATUTSI(P_IDTPES VARCHAR2(23),P_CRAPRI NUMBER(12),P_ATUCRE BOOLEAN,P_ATUMSG BOOLEAN,P_SUBNV BOOLEAN,P_ATUFXH BOOLEAN)
 IS

/*Variáveis SELECT R070CON*/
  l_Iniafa              VARCHAR2(16);
  l_DatAfa              VARCHAR2(16);
  l_SenCol              VARCHAR2(6);
  l_Dinpr1              VARCHAR2(10);
  l_Dfnpr1              VARCHAR2(10);
  l_Dinpr2              VARCHAR2(10);
  l_Dfnpr2              VARCHAR2(10);
  l_Dinpr3              VARCHAR2(10);
  l_Dfnpr3              VARCHAR2(10);
  l_DatMsg              VARCHAR2(16);
  l_MsgAcc              VARCHAR2(32);
  l_FaiAc1              VARCHAR2(56);
  l_FaiAc2              VARCHAR2(56);
  l_FaiAc3              VARCHAR2(56);
  l_FaiAc4              VARCHAR2(56);
  l_FaiAc5              VARCHAR2(56);
  l_FaiAc6              VARCHAR2(56);
  l_FaiAc7              VARCHAR2(56);
  l_FaiPt1              VARCHAR2(56);
  l_FaiPt2              VARCHAR2(56);
  l_FaiPt3              VARCHAR2(56);
  l_FaiPt4              VARCHAR2(56);
  l_FaiPt5              VARCHAR2(56);
  l_FaiPt6              VARCHAR2(56);
  l_FaiPt7              VARCHAR2(56);
  l_FaiRef              VARCHAR2(56);
  l_CreFx1              VARCHAR2(8);
  l_CreFx2              VARCHAR2(8);
  l_CreFx3              VARCHAR2(8);
  l_CreFx4              VARCHAR2(8);
  l_CreFx5              VARCHAR2(8);
  l_CreFx6              VARCHAR2(8);
  l_VerVal_con          CHAR(1);
  l_QtdCr1              NUMBER(2);
  l_QtdCr2              NUMBER(2);
  l_QtdCr3              NUMBER(2);
  l_QtdCr4              NUMBER(2);
  l_QtdCr5              NUMBER(2);
  l_QtdCr6              NUMBER(2);
  l_BloFal_con          NUMBER(1);
  l_ConAdp              NUMBER(1);
  l_VerPrm              NUMBER(1);
  l_TemAlm              NUMBER(3);
  l_ConCre              NUMBER(1);
  l_ConFai              NUMBER(1);
  l_VerAfa_con          NUMBER(1);
  l_Prmrt1              NUMBER(5);
  l_Prmrt2              NUMBER(5);
  l_Prmrt3              NUMBER(5);
  l_ConIal              NUMBER(1);
  l_QtdMsg              NUMBER(2);
  l_BloAut              NUMBER(1);
  l_CodPrm              NUMBER(5);
  l_prmAen              NUMBER(5);
  l_PrmSab              NUMBER(5);
  l_PrmDom              NUMBER(5);
  l_PrmFer              NUMBER(5);
  l_UsaBio              NUMBER(1);
  l_GraCon              NUMBER(3);
  l_ConInt              NUMBER(1);
  l_TolInt              NUMBER(3);
  l_conpac              NUMBER(1);
  l_tempac              NUMBER(3);
  l_tolacp              NUMBER(2);
  l_tipcra              NUMBER(2);  
  /*Variáveis da Controle*/
  l_icard               CHAR(12);
  l_icard_chcpri        CHAR(12);
  l_icard_bkp           CHAR(12);
  l_NumSerial           CHAR(10);
  l_Titular             CHAR(12);
  l_codig               CHAR(6);
  l_grupo               CHAR(3);
  l_grupo_5             CHAR(5);
  l_tpfis               CHAR(1);
  l_situa               CHAR(1);
  l_subnv               CHAR(5);
  l_subnv_5             CHAR(5);
  l_datahora            VARCHAR2(10);
  l_fx_flg              CHAR(1); /* Controla Intervalo de Almoço */
  l_tempo_alm           CHAR(3); /* Tempo Mínimo de Almoço (Minutos) */
  l_datini              CHAR(6);
  l_horini              CHAR(4);
  l_datfim              CHAR(6);
  l_retnumberaux        NUMBER;
  l_reterr              NUMBER(1);

  /* Controle de Mensagens */
  l_desmsg              VARCHAR2(32);
  l_dta_msg             CHAR(6);
  l_dta_msg_aux         CHAR(8);
  l_qtd_mens            CHAR(2);
  /* Controle de Creditos de Acesso */
  l_cred_fx1            CHAR(2);
  l_fx1                 CHAR(8);
  l_cred_fx2            CHAR(2);
  l_fx2                 CHAR(8);
  l_cred_fx3            CHAR(2);
  l_fx3                 CHAR(8);
  l_cred_fx4            CHAR(2);
  l_fx4                 CHAR(8);
  l_cred_fx5            CHAR(2);
  l_fx5                 CHAR(8);
  l_cred_fx6            CHAR(2);
  l_fx6                 CHAR(8);
  /* Controle de Areas Restritas */
  l_grupo1              CHAR(3);
  l_grupo1_5            CHAR(5);
  l_datinig1            CHAR(10);
  l_datfimg1            CHAR(10);
  l_grupo2              CHAR(3);
  l_grupo2_5            CHAR(5);
  l_datinig2            CHAR(10);
  l_datfimg2            CHAR(10);
  l_grupo3              CHAR(3);
  l_grupo3_5            CHAR(5);
  l_datinig3            CHAR(10);
  l_datfimg3            CHAR(10);
  l_grupo_sab           CHAR(3);
  l_grupo_dom           CHAR(3);
  l_grupo_fer           CHAR(3);
  l_grupo_sab_5         CHAR(5);
  l_grupo_dom_5         CHAR(5);
  l_grupo_fer_5         CHAR(5);
  l_anti_dupla          CHAR(1); /* Controla Anti-Dupla */
  l_bloq_falta          CHAR(1); /* Bloqueia Acesso por Falta */
  l_ver_hora            CHAR(1); /* Controla Faixa Horária de Acesso */
  l_ver_local           CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_valid           CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_afast           CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_cred            CHAR(1); /* Controla Creditos de acesso Refeitorio */
  l_vis_esp             CHAR(1); /* se for visitante especial bloqueia automaticamente na saida. */
  l_ver_digit           CHAR(1); /* Controla utiliza Biometria */
  l_faixa               CHAR(56);
  l_flg_tempo_min       CHAR(1);
  l_tempo_minimo        CHAR(3);
  l_tol_entrada         CHAR(2);
  l_tol_saida           CHAR(2);
  /*Interjornadas*/
  l_tempo_ret           CHAR(3);
  l_toler_ret           CHAR(3);
  l_ver_ret             CHAR(1);
  /*Saída Máxima*/
  l_tempo_jornada       CHAR(3);
  l_ver_saidamax        CHAR(1);
  /*Variáveis de gerenciamento da controle*/
  /*INSERT*/
  l_cmdinscol           VARCHAR2(2048);
  l_cmdinsval           VARCHAR2(2048);
  l_cmdauxval           VARCHAR2(2048);
  l_cmdauxcol           VARCHAR2(2048);
  /*UPDATE*/
  l_cmdupd              VARCHAR2(2048);
  l_cmdauxupd           VARCHAR2(2048);
  l_cmdupdaen           VARCHAR2(2048);  
  /*FxHoraria*/
  l_cmdinsfxh           VARCHAR2(2048);
  l_cmdvalfxh           VARCHAR2(2048);
  l_cmdupdfxh           VARCHAR2(2048);
  l_mesvalfxh           VARCHAR2(2048);
  l_mesupdfxh           VARCHAR2(2048);
  l_fxhauxval           VARCHAR2(2048);
  l_fxhauxcol           VARCHAR2(2048);
  l_fxhauxupd           VARCHAR2(2048);
  /*Comando pré Definido Crachá Mestre*/
  /*INSERT*/
  l_mesinsval           VARCHAR2(2048);
  l_mesauxval           VARCHAR2(2048);
  /*UPDATE*/
  l_mesupd              VARCHAR2(2048);
  l_mesauxupd           VARCHAR2(2048);
  l_comando_controle    VARCHAR2(2048);
  l_comando_fxhoraria   VARCHAR2(2048);
  l_comando_SELECT      VARCHAR2(512);
  l_campoCred           BOOLEAN;
  l_semfxh              BOOLEAN;
  l_temAen              BOOLEAN;  
  l_nodatafound         BOOLEAN;
  l_persig              CHAR(1);
  l_usutel              VARCHAR2(31);
  l_chcass              CHAR(1);
  /*Controle de Campos Telemática (Tabela R070TSI)*/
  l_temgrp              CHAR(1);
  l_antdpl              CHAR(1);
  l_blofal              CHAR(1);
  l_tmpalm              CHAR(1);
  l_verhor              CHAR(1);
  l_verloc              CHAR(1);
  l_verval              CHAR(1);
  l_verafa              CHAR(1);
  l_vercre              CHAR(1);
  l_visesp              CHAR(1);
  l_verdig              CHAR(1);
  l_temfxh              CHAR(1);
  l_planta              CHAR(1);
  l_numser              CHAR(1);
  l_temtit              CHAR(1);
  l_temcrc              CHAR(1);
  l_temInt              CHAR(1);
  l_tempac_tsi          CHAR(1);
  l_chcAce              NUMBER(1);
  l_chcRep              NUMBER(1);
  l_data_atual          DATE;
  l_hora_atual          NUMBER(4);
  l_data_atual_aux      CHAR(6);
  l_dta_msg_Date        DATE;
  l_achou               BOOLEAN;
  l_ediprm              CHAR(5);
  l_newprm              BOOLEAN;
  l_idtpes              VARCHAR2(23);
  l_tipcol              CHAR(2);
  l_horNum              NUMBER(2);
  l_MinNum              NUMBER(2);
  l_horaux              NUMBER(4);
  l_dataux              DATE;     
  l_datstr              CHAR(6);
  l_dat_conv            VARCHAR(25); /*Variável auxiliar para conversão de data*/
  /*Cursos que obtem os crachás da Pessoa*/
  CURSOR c_r070con IS
  SELECT NUMCRA, NUMFIS, TIPCRA, INIVAL, DATVAL, SITCRA, TECCRA, CHCPRI, NIVATU
  FROM R070CON WHERE IDTPES = p_IdtPes ORDER BY TECCRA;
  TYPE t_r070con IS RECORD(
    NUMCRA   R070CON.NUMCRA%TYPE,
    NUMFIS   R070CON.NUMFIS%TYPE,
    TIPCRA   R070CON.TIPCRA%TYPE,
    INIVAL   R070CON.INIVAL%TYPE,
    DATVAL   R070CON.DATVAL%TYPE,
    SITCRA   R070CON.SITCRA%TYPE,
    TECCRA   R070CON.TECCRA%TYPE,
    CHCPRI   R070CON.CHCPRI%TYPE,
    NIVATU   R070CON.NIVATU%TYPE);
  l_r070con t_r070con;

BEGIN
  /*Inicializações*/
  l_achou := TRUE;
  l_VerVal_con := '1';
  l_semfxh := FALSE;
  l_faixa := '00002359240024002400240024002400240024002400240024002400';
  /*Verificar as será necessário informar o owner para os objetos da telemática*/
  BEGIN
      SELECT CHCASS, USUTEL INTO l_chcass, l_usutel FROM R070DAC;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'SP_ATUTSI: Não Conseguiu Efetuar SELECT na Tabela R070DAC.';
  END;

  BEGIN
      SELECT EDIPRM INTO l_ediprm FROM R000ASS;
      IF (l_ediprm = '99999') THEN
          l_newprm := TRUE;
      ELSE
          l_newprm := FALSE;
      END IF;
  EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'SP_ATUTSI: Não conseguiu obter a máscara da permissão R000ASS.EDIPRM.';
  END;

  /*Tratamento para o campo Usutel*/
  IF ((l_usutel IS NULL) OR (l_usutel = '') OR (l_usutel = ' ')) THEN
    l_usutel := '';
  ELSE
    l_usutel := l_usutel ||'.';
  END IF;
  /*Obtem as informações da pessoa*/
  BEGIN
      SELECT Iniafa, DatAfa, BloFal, ConAdp, VerPrm, SenCol, TemAlm, ConCre,
             ConFai, VerAfa, Prmrt1, Dinpr1, Dfnpr1, Prmrt2, Dinpr2, Dfnpr2,
             Prmrt3, Dinpr3, Dfnpr3, FaiAc1, FaiAc2, FaiAc3, FaiAc4, FaiAc5,
             FaiAc6, FaiAc7, FaiPt1, FaiPt2, FaiPt3, FaiPt4, FaiPt5, FaiPt6,
             FaiPt7, QtdCr1, QtdCr2, QtdCr3, QtdCr4, QtdCr5, QtdCr6, CreFx1,
             CreFx2, CreFx3, CreFx4, CreFx5, CreFx6, FaiRef, ConIal, BloAut,
             CodPrm, PrmSab, PrmDom, PrmFer, UsaBio, GraCon, DatMsg, MsgAcc,
             QtdMsg, ConInt, TolInt, ConPac, TemPac, TolAcp, TipCra
      INTO
             l_Iniafa, l_DatAfa, l_BloFal_con, l_ConAdp, l_VerPrm, l_SenCol, l_TemAlm, l_ConCre,
             l_ConFai, l_VerAfa_con, l_Prmrt1, l_Dinpr1, l_Dfnpr1, l_Prmrt2, l_Dinpr2, l_Dfnpr2,
             l_Prmrt3, l_Dinpr3, l_Dfnpr3, l_FaiAc1, l_FaiAc2, l_FaiAc3, l_FaiAc4, l_FaiAc5,
             l_FaiAc6, l_FaiAc7, l_FaiPt1, l_FaiPt2, l_FaiPt3, l_FaiPt4, l_FaiPt5, l_FaiPt6,
             l_FaiPt7, l_QtdCr1, l_QtdCr2, l_QtdCr3, l_QtdCr4, l_QtdCr5, l_QtdCr6, l_CreFx1,
             l_CreFx2, l_CreFx3, l_CreFx4, l_CreFx5, l_CreFx6, l_FaiRef, l_ConIal, l_BloAut,
             l_CodPrm, l_PrmSab, l_PrmDom, l_PrmFer, l_UsaBio, l_GraCon, l_DatMsg, l_MsgAcc,
             l_QtdMsg, l_ConInt, l_TolInt, l_ConPac, l_TemPac, l_TolAcp, l_TipCra
      FROM R070CON WHERE IDTPES = p_idtpes AND NumFis = p_CraPri;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_achou := FALSE;
      WHEN OTHERS THEN
        l_achou := FALSE;
        RAISERROR 103 'ERRO NO SELECT DAS DEFINIÇÕES DA PESSOA. ';
  END;
  IF (l_achou = TRUE) THEN
      /*Conversão para inserção nos campos da telemática*/
      l_codig := l_sencol;

      IF (l_newprm = TRUE) THEN
          SP_INTSTR(l_CodPrm,'99999',l_grupo_5 OUT);
      ELSE
          SP_INTSTR(l_CodPrm,'999',l_grupo OUT);
      END IF;

      SP_INTSTR(l_ConIal,'9',l_fx_flg OUT);
      SP_INTSTR(l_TemAlm, '999',l_tempo_alm OUT);

      l_data_atual := CURDATE();
      SP_DATSTR(l_data_atual,'DDMMYY',l_datstr OUT);
      l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_datini := SUBSTRING (l_iniafa,1,6);
      l_horini := SUBSTRING (l_iniafa,7,4);
      l_datfim := SUBSTRING (l_datafa,1,6);

      IF (l_datini <> '000000') THEN
        /*CONVERTE CARACTERE EM DATA*/
          l_dat_conv := SUBSTRING(l_datini,1,2)||'/'||SUBSTRING(l_datini,3,2) ||'/'||SUBSTRING(l_datini,5,2);
          SP_STRTODATE(l_dat_conv, 'DD/MM/AA', l_dataux OUT);
          l_dat_conv := SUBSTRING(l_datstr,1,2)||'/'||SUBSTRING(l_datstr,3,2)||'/'||SUBSTRING(l_datstr,5,2);
          SP_STRTODATE(l_dat_conv, 'DD/MM/AA', l_data_atual OUT);

         l_HorNum := CONVERT(CHAR_TO_NUMBER,SUBSTRING(l_horini, 1,2));
         l_MinNum := CONVERT(CHAR_TO_NUMBER,SUBSTRING(l_horini, 3,2));
         l_horaux := (l_horNum*60) + (l_minNum);

         
         IF ((l_dataux > l_data_atual) OR ((l_dataux = l_data_atual) AND (l_horaux > l_hora_atual))) THEN
             l_datini := '000000';
         END IF;
      END IF;

      IF (l_datini = '000000') THEN
          l_datini := '      ';
          l_datfim := '      ';
      END IF;
      l_desmsg := l_MsgAcc;
      l_dta_msg := SUBSTRING (l_DatMsg,1,6);
      IF (l_dta_msg = '000000') OR (l_dta_msg IS NULL) THEN
          l_dta_msg := '      ';
      ELSE
          BEGIN
              /*Tratamento de Datas*/
              l_data_atual := CURDATE();
              /*CONVERTE CARACTERE EM DATA*/
              SP_STRTODATE(l_dta_msg, 'DDMMAA', l_dta_msg_date OUT);
              IF (l_data_atual < l_dta_msg_date) THEN
                  l_dta_msg := '999999';
              END IF;
          EXCEPTION
            WHEN OTHERS THEN
              NULL;
          END;
      END IF;
      SP_INTSTR(l_QtdMsg, '99',l_qtd_mens OUT);
      SP_INTSTR(l_qtdcr1, '99',l_cred_fx1 OUT);
      l_fx1 := l_crefx1;
      SP_INTSTR(l_qtdcr2, '99',l_cred_fx2 OUT);
      l_fx2 := l_crefx2;
      SP_INTSTR(l_qtdcr3, '99',l_cred_fx3 OUT);
      l_fx3 := l_crefx3;
      SP_INTSTR(l_qtdcr4, '99',l_cred_fx4 OUT);
      l_fx4 := l_crefx4;
      SP_INTSTR(l_qtdcr5, '99',l_cred_fx5 OUT);
      l_fx5 := l_crefx5;
      SP_INTSTR(l_qtdcr6, '99',l_cred_fx6 OUT);
      l_fx6 := l_crefx6;
      /* Controle de Areas Restritas */
      IF (l_newprm = TRUE) THEN
          SP_INTSTR(l_prmrt1, '99999',l_grupo1_5 OUT);
      ELSE
          SP_INTSTR(l_prmrt1, '999',l_grupo1 OUT);
      END IF;
      l_datinig1 := l_dinpr1;
      l_datfimg1 := l_dfnpr1;
      IF (l_datinig1 = '0000000000') THEN
          l_datinig1 := '          ';
          l_datfimg1 := '          ';
      END IF;

      IF (l_newprm = TRUE) THEN
          SP_INTSTR(l_prmrt2, '99999',l_grupo2_5 OUT);
      ELSE
          SP_INTSTR(l_prmrt2, '999',l_grupo2 OUT);
      END IF;

      l_datinig2 := l_dinpr2;
      l_datfimg2 := l_dfnpr2;
      IF (l_datinig2 = '0000000000') THEN
          l_datinig2 := '          ';
          l_datfimg2 := '          ';
      END IF;

      IF (l_newprm = TRUE) THEN
          SP_INTSTR(l_prmrt3, '99999',l_grupo3_5 OUT);
      ELSE
          SP_INTSTR(l_prmrt3, '999',l_grupo3 OUT);
      END IF;
      l_datinig3 := l_dinpr3;
      l_datfimg3 := l_dfnpr3;
      IF (l_datinig3 = '0000000000') THEN
          l_datinig3 := '          ';
          l_datfimg3 := '          ';
      END IF;

      IF (l_newprm = TRUE) THEN
          SP_INTSTR(l_prmsab, '99999',l_grupo_sab_5 OUT);
          SP_INTSTR(l_prmdom, '99999',l_grupo_dom_5 OUT);
          SP_INTSTR(l_prmfer, '99999',l_grupo_fer_5 OUT);
      ELSE
          SP_INTSTR(l_prmsab, '999',l_grupo_sab OUT);
          SP_INTSTR(l_prmdom, '999',l_grupo_dom OUT);
          SP_INTSTR(l_prmfer, '999',l_grupo_fer OUT);
      END IF;
      SP_INTSTR(l_conadp, '9',l_anti_dupla OUT);
      SP_INTSTR(l_blofal_con, '9',l_bloq_falta OUT);
      SP_INTSTR(l_confai, '9',l_ver_hora OUT);
      SP_INTSTR(l_verprm, '9',l_ver_local OUT);
      l_ver_valid := l_verval_con; /*Valor padrão 1*/
      SP_INTSTR(l_verafa_con, '9',l_ver_afast OUT);
      /*reserva de créditos funciona apenas para digicon*/
      IF (l_concre = 4) THEN
        l_concre := 1;
      END IF;

      SP_INTSTR(l_concre, '9',l_ver_cred OUT);
      SP_INTSTR(l_bloaut, '9',l_vis_esp OUT);
      IF (l_usabio > 1) THEN
          l_ver_digit := '2';
      ELSE
          l_ver_digit := '1';
      END IF;
      l_NumSerial := '0000000000';
      /*Interjornadas*/
      SP_INTSTR(l_ConInt, '9',l_ver_ret OUT);
      SP_INTSTR(l_TolInt, '999',l_toler_ret OUT);
      l_tempo_ret := '011';
      l_tempo_jornada := '000';
      l_ver_saidamax := '0';
      /*Tempo Mínimo de Permanência*/
      SP_INTSTR(l_conpac, '9',l_flg_tempo_min OUT);
      SP_INTSTR(l_tempac, '999',l_tempo_minimo OUT);
      SP_INTSTR(l_tolacp, '99',l_tol_entrada OUT);
      SP_INTSTR(l_tolacp, '99',l_tol_saida OUT);

      /* Verifica os Campos INSERT/update utilizados */
      /*Campos INSERT Crachá Normal*/
      l_cmdinscol := 'CODIG,FX_FLG,DATINI,DATFIM,GRUPO1,DATINIG1,DATFIMG1,GRUPO2,DATINIG2,'||
                     'DATFIMG2,GRUPO3,DATINIG3,DATFIMG3,GRUPO';

      IF (l_newprm = TRUE) THEN
          /*Valor INSERT Crachá Normal*/
          l_cmdinsval := ''''||l_codig||''''||','||''''||l_fx_flg||''''||','||''''||l_datini||''''||','
                         ||''''||l_datfim||''''||','||''''||l_grupo1_5||''''||','||''''||l_datinig1||''''||','
                         ||''''||l_datfimg1||''''||','||''''||l_grupo2_5||''''||','||''''||l_datinig2||''''||','
                         ||''''||l_datfimg2||''''||','||''''||l_grupo3_5||''''||','||''''||l_datinig3||''''||','
                         ||''''||l_datfimg3||''''||','||''''||l_grupo_5||'''';

          /*Valor INSERT Mestre*/
          l_mesinsval := '''      '',''0'',''      '', ''      '',''00000'',''          '',''          '','||
                         '''00000'',''          '',''          '',''00000'',''          '',''          '',''00000''';
      ELSE
          /*Valor INSERT Crachá Normal*/
          l_cmdinsval := ''''||l_codig||''''||','||''''||l_fx_flg||''''||','||''''||l_datini||''''||','
                         ||''''||l_datfim||''''||','||''''||l_grupo1||''''||','||''''||l_datinig1||''''||','
                         ||''''||l_datfimg1||''''||','||''''||l_grupo2||''''||','||''''||l_datinig2||''''||','
                         ||''''||l_datfimg2||''''||','||''''||l_grupo3||''''||','||''''||l_datinig3||''''||','
                         ||''''||l_datfimg3||''''||','||''''||l_grupo||'''';

          /*Valor INSERT Mestre*/
          l_mesinsval := '''      '',''0'',''      '', ''      '',''000'',''          '',''          '','||
                         '''000'',''          '',''          '',''000'',''          '',''          '',''000''';
      END IF;

      IF (l_newprm = TRUE) THEN
        /*UPDATE Crachá Normal*/
          l_cmdupd := 'CODIG = '||''''||l_codig||''''||', FX_FLG = '||''''||l_fx_flg||''''||
                      ', DATINI = '||''''||l_datini||''''||', DATFIM = '||''''||l_datfim||''''||
                      ', GRUPO1 = '||''''||l_grupo1_5||''''||', DATINIG1 = '||''''||l_datinig1||''''||
                      ', DATFIMG1 = '||''''||l_datfimg1||''''||', GRUPO2 = '||''''||l_grupo2_5||''''||
                      ', DATINIG2 = '||''''||l_datinig2||''''||', DATFIMG2 = '||''''||l_datfimg2||''''||
                      ', GRUPO3 = '||''''||l_grupo3_5||''''||', DATINIG3 = '||''''||l_datinig3||''''||
                      ', DATFIMG3 = '||''''||l_datfimg3||''''||', GRUPO = '||''''||l_grupo_5||'''';
        /*UPDATE Crachá Mestre*/
        l_mesupd := 'CODIG = ''      '', FX_FLG = ''0'', DATINI = ''      '', DATFIM = ''      '','||
                      ' GRUPO1 = ''00000'', DATINIG1 = ''          '', DATFIMG1 = ''          '','||
                      ' GRUPO2 = ''00000'', DATINIG2 = ''          '', DATFIMG2 = ''          '','||
                      ' GRUPO3 = ''00000'', DATINIG3 = ''          '', DATFIMG3 = ''          '','||
                      ' GRUPO = ''00000''';
      ELSE
          /*UPDATE Crachá Normal*/
          l_cmdupd := 'CODIG = '||''''||l_codig||''''||', FX_FLG = '||''''||l_fx_flg||''''||
                      ', DATINI = '||''''||l_datini||''''||', DATFIM = '||''''||l_datfim||''''||
                      ', GRUPO1 = '||''''||l_grupo1||''''||', DATINIG1 = '||''''||l_datinig1||''''||
                      ', DATFIMG1 = '||''''||l_datfimg1||''''||', GRUPO2 = '||''''||l_grupo2||''''||
                      ', DATINIG2 = '||''''||l_datinig2||''''||', DATFIMG2 = '||''''||l_datfimg2||''''||
                      ', GRUPO3 = '||''''||l_grupo3||''''||', DATINIG3 = '||''''||l_datinig3||''''||
                      ', DATFIMG3 = '||''''||l_datfimg3||''''||', GRUPO = '||''''||l_grupo||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := 'CODIG = ''      '', FX_FLG = ''0'', DATINI = ''      '', DATFIM = ''      '','||
                      ' GRUPO1 = ''000'', DATINIG1 = ''          '', DATFIMG1 = ''          '','||
                      ' GRUPO2 = ''000'', DATINIG2 = ''          '', DATFIMG2 = ''          '','||
                      ' GRUPO3 = ''000'', DATINIG3 = ''          '', DATFIMG3 = ''          '','||
                      ' GRUPO = ''000''';
      END IF;
      /*FxHoraria*/
      /*INSERT*/
      l_cmdinsfxh := 'FX_DOM_A,FX_SEG_A,FX_TER_A,FX_QUA_A,FX_QUI_A,FX_SEX_A,FX_SAB_A,FX_DOM_P,'||
                     'FX_SEG_P,FX_TER_P,FX_QUA_P,FX_QUI_P,FX_SEX_P,FX_SAB_P,FX_REF';

      l_cmdvalfxh := ''''||l_faiac1||''''||','||''''||l_faiac2||''''||','||''''||l_faiac3||''''||','
                     ||''''||l_faiac4||''''||','||''''||l_faiac5||''''||','||''''||l_faiac6||''''||','
                     ||''''||l_faiac7||''''||','||''''||l_faipt1||''''||','||''''||l_faipt2||''''||','
                     ||''''||l_faipt3||''''||','||''''||l_faipt4||''''||','||''''||l_faipt5||''''||','
                     ||''''||l_faipt6||''''||','||''''||l_faipt7||''''||','||''''||l_fairef||'''';
      /*Mestre*/
      l_mesvalfxh := ''''||l_faixa||''''||','||''''||l_faixa||''''||','||''''||l_faixa||''''||','
                     ||''''||l_faixa||''''||','||''''||l_faixa||''''||','||''''||l_faixa||''''||','
                     ||''''||l_faixa||''''||','||''''||l_faixa||''''||','||''''||l_faixa||''''||','
                     ||''''||l_faixa||''''||','||''''||l_faixa||''''||','||''''||l_faixa||''''||','
                     ||''''||l_faixa||''''||','||''''||l_faixa||''''||','||''''||l_faixa||'''';
      /*UPDATE*/
      l_cmdupdfxh := 'FX_DOM_A = '||''''||l_faiac1||''''||', FX_SEG_A = '||''''||l_faiac2||''''||
                     ', FX_TER_A = '||''''||l_faiac3||''''||', FX_QUA_A = '||''''||l_faiac4||''''||
                     ', FX_QUI_A = '||''''||l_faiac5||''''||', FX_SEX_A = '||''''||l_faiac6||''''||
                     ', FX_SAB_A = '||''''||l_faiac7||''''||', FX_DOM_P = '||''''||l_faipt1||''''||
                     ', FX_SEG_P = '||''''||l_faipt2||''''||', FX_TER_P = '||''''||l_faipt3||''''||
                     ', FX_QUA_P = '||''''||l_faipt4||''''||', FX_QUI_P = '||''''||l_faipt5||''''||
                     ', FX_SEX_P = '||''''||l_faipt6||''''||', FX_SAB_P = '||''''||l_faipt7||''''||
                     ', FX_REF = '||''''||l_fairef||'''';
      /*Mestre*/
      l_mesupdfxh := 'FX_DOM_A = '||''''||l_faixa||''''||', FX_SEG_A = '||''''||l_faixa||''''||
                     ', FX_TER_A = '||''''||l_faixa||''''||', FX_QUA_A = '||''''||l_faixa||''''||
                     ', FX_QUI_A = '||''''||l_faixa||''''||', FX_SEX_A = '||''''||l_faixa||''''||
                     ', FX_SAB_A = '||''''||l_faixa||''''||', FX_DOM_P = '||''''||l_faixa||''''||
                     ', FX_SEG_P = '||''''||l_faixa||''''||', FX_TER_P = '||''''||l_faixa||''''||
                     ', FX_QUA_P = '||''''||l_faixa||''''||', FX_QUI_P = '||''''||l_faixa||''''||
                     ', FX_SEX_P = '||''''||l_faixa||''''||', FX_SAB_P = '||''''||l_faixa||''''||
                     ', FX_REF = '||''''||l_faixa||'''';

      /* verifica na tabala R070TSI quais os campos que a Controle opera */                               
      BEGIN
          SELECT temgrp, antdpl, blofal, tmpalm, verhor, verloc, verval, verafa, vercre,
                 visesp, verdig, temfxh, planta, numser, temtit, temcrc, conint, tempac,
                 chcAce, chcRep
          INTO   l_temgrp, l_antdpl, l_blofal, l_tmpalm, l_verhor, l_verloc, l_verval, l_verafa, l_vercre,
                 l_visesp, l_verdig, l_temfxh, l_planta, l_numser, l_temtit, l_temcrc, l_temInt, l_tempac_tsi,
                 l_chcAce, l_chcRep
          FROM R070TSI;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          RAISERROR 103 'SP_ATUTSI: Não Encontrou Resgistro na Tabela R070TSI';
        WHEN OTHERS THEN
          RAISERROR 103 'SP_ATUTSI: Não foi possível Obter as Definições da Tabela R070TSI';
      END;
      
      IF  l_temgrp = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ',GRUPO_SAB,GRUPO_DOM,GRUPO_FER';
          IF (l_newprm = TRUE) THEN
              /*Variáveis de INSERT*/
              l_cmdinsval := l_cmdinsval || ','||''''||l_grupo_sab_5||''''||
                                            ','||''''||l_grupo_dom_5||''''||
                                            ','||''''||l_grupo_fer_5||'''';
              /*INSERT Crachá Mestre*/
              l_mesinsval := l_mesinsval || ',''00000'',''00000'',''00000''';
          ELSE
              /*Variáveis de INSERT*/
              l_cmdinsval := l_cmdinsval || ','||''''||l_grupo_sab||''''||
                                            ','||''''||l_grupo_dom||''''||
                                            ','||''''||l_grupo_fer||'''';
              /*INSERT Crachá Mestre*/
              l_mesinsval := l_mesinsval || ',''000'',''000'',''000''';
          END IF;

          IF (l_newprm = TRUE) THEN
              /*Variáveis de UPDATE*/
              l_cmdupd := l_cmdupd ||', GRUPO_SAB = '||''''||l_grupo_sab_5||''''||
                                     ', GRUPO_DOM = '||''''||l_grupo_dom_5||''''||
                                     ', GRUPO_FER = '||''''||l_grupo_fer_5||'''';
              /*UPDATE Crachá Mestre*/
              l_mesupd := l_mesupd ||', GRUPO_SAB = ''00000'', GRUPO_DOM = ''00000'', GRUPO_FER = ''00000''';
          ELSE
              /*Variáveis de UPDATE*/
              l_cmdupd := l_cmdupd ||', GRUPO_SAB = '||''''||l_grupo_sab||''''||
                                     ', GRUPO_DOM = '||''''||l_grupo_dom||''''||
                                     ', GRUPO_FER = '||''''||l_grupo_fer||'''';
              /*UPDATE Crachá Mestre*/
              l_mesupd := l_mesupd ||', GRUPO_SAB = ''000'', GRUPO_DOM = ''000'', GRUPO_FER = ''000''';
          END IF;
      END IF;
      IF  l_temcrc = 'S' THEN
          l_campoCred := TRUE;
      END IF;
      /*IF  l_campo = 'PLANTA' THEN*/
          /*?????????????????????????*/
      /*END;*/
      IF  l_antdpl = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,ANTI_DUPLA';
          l_cmdinsval := l_cmdinsval || ','||''''||l_anti_dupla||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';

          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', ANTI_DUPLA = '||''''||l_anti_dupla||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', ANTI_DUPLA = ''0''';
      END IF;
      IF  l_blofal = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,BLOQ_FALTA';
          l_cmdinsval := l_cmdinsval || ','||''''||l_bloq_falta||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', BLOQ_FALTA = '||''''||l_bloq_falta||'''';
           /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', BLOQ_FALTA = ''0''';
      END IF;

      IF  l_tmpalm = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,TEMPO_ALM';
          l_cmdinsval := l_cmdinsval || ','||''''||l_tempo_alm||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''000''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', TEMPO_ALM = '||''''||l_tempo_alm||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', TEMPO_ALM = ''000''';
      END IF;

      IF  l_verhor = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,VER_HORA';
          l_cmdinsval := l_cmdinsval || ','||''''||l_ver_hora||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', VER_HORA = '||''''||l_ver_hora||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', VER_HORA = ''0''';
      END IF;
      IF  l_verloc = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,VER_LOCAL';
          l_cmdinsval := l_cmdinsval || ','||''''||l_ver_local||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', VER_LOCAL = '||''''||l_ver_local||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', VER_LOCAL = ''0''';

      END IF;
      IF  l_verval = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,VER_VALID';
          l_cmdinsval := l_cmdinsval || ','||''''||l_ver_valid||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', VER_VALID = '||''''||l_ver_valid||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', VER_VALID = ''0''';
      END IF;
      IF  l_verafa = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,VER_AFAST';
          l_cmdinsval := l_cmdinsval || ','||''''||l_ver_afast||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', VER_AFAST = '||''''||l_ver_afast||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', VER_AFAST = ''0''';
      END IF;
      IF  l_vercre = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,VER_CRED';
          l_cmdinsval := l_cmdinsval || ','||''''||l_ver_cred||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', VER_CRED = '||''''||l_ver_cred||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', VER_CRED = ''0''';
      END IF;
      IF  l_visesp = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,VIS_ESP';
          l_cmdinsval := l_cmdinsval || ','||''''||l_vis_esp||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', VIS_ESP = '||''''||l_vis_esp||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd ||', VIS_ESP = ''0''';
      END IF;
      IF  l_verdig = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,VER_DIGIT';
          l_cmdinsval := l_cmdinsval || ','||''''||l_ver_digit||'''';
          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ','||''''||l_ver_digit||'''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', VER_DIGIT = '||''''||l_ver_digit||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd || ', VER_DIGIT = '||''''||l_ver_digit||'''';
      END IF;

      /*Controle de Interjornadas*/
      IF l_temint = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,TEMPO_RET,TOLER_RET,VER_RET,TEMPO_JORNADA,VER_SAIDAMAX';
          l_cmdinsval := l_cmdinsval || ','||''''||l_tempo_ret||''''||
                                        ','||''''||l_toler_ret||''''||
                                        ','||''''||l_ver_ret||''''||
                                        ','||''''||l_tempo_jornada||''''||
                                        ','||''''||l_ver_saidamax||'''';

          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''000'''||
                                        ',''000'''||
                                        ',''0'''||
                                        ',''000'''||
                                        ',''0''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', TEMPO_RET = '||''''||l_tempo_ret||''''||
                                  ', TOLER_RET = '||''''||l_toler_ret||''''||
                                  ', VER_RET = '||''''||l_ver_ret||''''||
                                  ', TEMPO_JORNADA = '||''''||l_tempo_jornada||''''||
                                  ', VER_SAIDAMAX = '||''''||l_ver_saidamax||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd || ', TEMPO_RET = ''000'''||
                                  ', TOLER_RET = ''000'''||
                                  ', VER_RET = ''0'''||
                                  ', TEMPO_JORNADA = ''000'''||
                                  ', VER_SAIDAMAX = ''0''';
      END IF;

      /*Tempo Mínimo de Permanência*/
      IF l_tempac_tsi = 'S' THEN
          /*Variáveis de INSERT*/
          l_cmdinscol := l_cmdinscol || ' ,FLG_TEMPO_MIN,TEMPO_MINIMO,TOL_ENTRADA,TOL_SAIDA';
          l_cmdinsval := l_cmdinsval || ','||''''||l_flg_tempo_min||''''||
                                        ','||''''||l_tempo_minimo||''''||
                                        ','||''''||l_tol_entrada||''''||
                                        ','||''''||l_tol_saida||'''';

          /*INSERT Crachá Mestre*/
          l_mesinsval := l_mesinsval || ',''0'''||
                                        ',''000'''||
                                        ',''00'''||
                                        ',''00''';
          /*Variáveis de UPDATE*/
          l_cmdupd := l_cmdupd || ', FLG_TEMPO_MIN = '||''''||l_flg_tempo_min||''''||
                                  ', TEMPO_MINIMO = '||''''||l_tempo_minimo||''''||
                                  ', TOL_ENTRADA = '||''''||l_tol_entrada||''''||
                                  ', TOL_SAIDA = '||''''||l_tol_saida||'''';
          /*UPDATE Crachá Mestre*/
          l_mesupd := l_mesupd || ', FLG_TEMPO_MIN = ''0'''||
                                  ', TEMPO_MINIMO = ''000'''||
                                  ', TOL_ENTRADA = ''00'''||
                                  ', TOL_SAIDA = ''00''';
      END IF;

      IF  l_temfxh = 'N' THEN
          l_semfxh := TRUE;
          IF p_atufxh = TRUE THEN
              /*Variáveis de INSERT*/
              l_cmdinscol := l_cmdinscol || ' ,FX_DOM,FX_SEG,FX_TER,FX_QUA,FX_QUI,FX_SEX,FX_SAB,FX_REF';
              l_cmdinsval := l_cmdinsval || ','||''''||l_FaiAc1||''''||
                                            ','||''''||l_FaiAc2||''''||
                                            ','||''''||l_FaiAc3||''''||
                                            ','||''''||l_FaiAc4||''''||
                                            ','||''''||l_FaiAc5||''''||
                                            ','||''''||l_FaiAc6||''''||
                                            ','||''''||l_FaiAc7||''''||
                                            ','||''''||l_FaiRef||'''';
              /*INSERT Crachá Mestre*/
              l_mesinsval := l_mesinsval || ','||''''||l_faixa||''''||
                                            ','||''''||l_faixa||''''||
                                            ','||''''||l_faixa||''''||
                                            ','||''''||l_faixa||''''||
                                            ','||''''||l_faixa||''''||
                                            ','||''''||l_faixa||''''||
                                            ','||''''||l_faixa||''''||
                                            ','||''''||l_faixa||'''';
              /*Variáveis de UPDATE*/
              l_cmdupd := l_cmdupd ||', FX_DOM = '||''''||l_FaiAc1||''''||
                                     ', FX_SEG = '||''''||l_FaiAc2||''''||
                                     ', FX_TER = '||''''||l_FaiAc3||''''||
                                     ', FX_QUA = '||''''||l_FaiAc4||''''||
                                     ', FX_QUI = '||''''||l_FaiAc5||''''||
                                     ', FX_SEX = '||''''||l_FaiAc6||''''||
                                     ', FX_SAB = '||''''||l_FaiAc7||''''||
                                     ', FX_REF = '||''''||l_FaiRef||'''';

              /*UPDATE Crachá Mestre*/
              l_mesupd := l_mesupd ||', FX_DOM = '||''''||l_faixa||''''||
                                     ', FX_SEG = '||''''||l_faixa||''''||
                                     ', FX_TER = '||''''||l_faixa||''''||
                                     ', FX_QUA = '||''''||l_faixa||''''||
                                     ', FX_QUI = '||''''||l_faixa||''''||
                                     ', FX_SEX = '||''''||l_faixa||''''||
                                     ', FX_SAB = '||''''||l_faixa||''''||
                                     ', FX_REF = '||''''||l_faixa||'''';
          END IF;
      END IF;


      FOREACH c_r070con INTO l_r070con.NumCra, l_r070con.NumFis, l_r070con.TipCra, l_r070con.IniVal,
                             l_r070con.DatVal, l_r070con.SitCra, l_r070con.TecCra, l_r070con.ChcPri,
                             l_r070con.NivAtu LOOP

          /*Para crachá de autorização de entrada ou mestre, atualiza somente os crachás deste tipo*/
          IF (l_tipcra = 12) THEN
              IF (l_r070con.TipCra <> 12) THEN
                  GOTO continue_LOOP;
              END IF;
          ELSE
              IF (l_tipcra = 8) THEN
                  IF (l_r070con.TipCra <> 8) THEN
                    GOTO continue_LOOP;
                  END IF;
              END IF;
          END IF;

          l_cmdauxcol:= '';
          l_cmdauxval:= '';
          l_cmdauxupd:= '';
          l_fxhauxcol:= '';
          l_fxhauxval:= '';
          l_fxhauxupd:= '';
          /*Crachá Mestre*/
          l_mesauxval:= '';
          l_mesauxupd:= '';

          /*Obtem as outras informações do crachá*/
          l_datahora := SUBSTRING (l_r070con.DatVal,1,10);
          SP_INTSTR(l_r070con.SitCra, '9',l_situa OUT);
          SP_INTSTR(l_r070con.NumFis, '999999999999',l_icard OUT);
          
          IF (l_r070con.TecCra = 3) THEN
              IF (l_chcAce = 0 OR l_chcAce = 3) THEN
                  SP_INTSTR(l_r070con.ChcPri, '999999999999',l_icard_chcpri OUT);
                  SP_INTSTR(l_r070con.NumFis, '9999999999',l_NumSerial OUT);
              ELSE
                  SP_INTSTR(l_r070con.NumFis, '999999999999',l_icard OUT);	
                  l_NumSerial := '0000000000';			
              END IF;
          END IF;

          /*Guarda para fazer o SELECT na FXHORARIA*/
          l_icard_bkp := l_icard;

          IF (l_r070con.TipCra > 9) THEN /*Prever tipos maiores do que 9*/
              l_tpfis := '0';
          ELSE
              SP_INTSTR(l_r070con.TipCra, '9',l_tpfis OUT);
          END IF;

          /*Tratamento especial para crachá Smart*/
          IF (l_r070con.TecCra = 3) THEN /*Smart*/
          
              /* alteração Adri */
              IF (l_r070con.ChcPri <> 0) THEN
                  IF l_numser = 'S' THEN /*Se existe o campo NUMSERIAL*/
                      IF (l_chcAce = 0 OR l_chcAce = 3) THEN
                          SP_INTSTR(l_r070con.ChcPri, '999999999999',l_icard_chcpri OUT);
                          SP_INTSTR(l_r070con.NumFis, '9999999999',l_NumSerial OUT);
                      ELSE
                          SP_INTSTR(l_r070con.NUMFIS, '999999999999',l_icard_chcpri OUT);
                          l_NumSerial := '0000000000';
                      END IF;
                      l_comando_controle := 'UPDATE '|| l_usutel ||'CONTROLE SET NUMSERIAL = '||''''||l_NumSerial||''''||
                                            'WHERE ICARD = ' ||''''||l_icard_chcpri||'''';
                      SP_CMDTSI(l_comando_controle);
                  END IF;
              ELSE
                  /*Considera Como Icard o Número da Matrícula*/
                  IF (l_chcAce = 0 OR l_chcAce = 3) THEN
                      SP_INTSTR(l_r070con.NumCra, '999999999999',l_icard OUT);
                  ELSE
                      SP_INTSTR(l_r070con.NumFis, '999999999999',l_icard OUT);
                  END IF;
				  
				  /*Guarda para fazer o SELECT na FXHORARIA*/
				  l_icard_bkp := l_icard;
				  
                  /*Consistência Número Serial*/
                  IF l_numser = 'S' THEN /*Se existe o campo NUMSERIAL*/
                      SP_INTSTR(l_r070con.NumFis, '9999999999',l_NumSerial OUT);
                      /*INSERT*/
                      l_cmdauxcol := l_cmdauxcol || ',NUMSERIAL';
                      l_cmdauxval := l_cmdauxval || ','||''''||l_NumSerial||'''';
                      /*Crachá Mestre*/
                      l_mesauxval := l_mesauxval || ','||''''||l_NumSerial||'''';
                      /*UPDATE*/
                      l_cmdauxupd := l_cmdauxupd || ', NUMSERIAL = '||''''||l_NumSerial||'''';
                      /*Crachá Mestre*/
                      l_mesauxupd := l_mesauxupd || ', NUMSERIAL = '||''''||l_NumSerial||'''';
                  END IF;
              END IF;
          
          
          ELSE
              /*Para os demais crachás com tecnologia diferente de smart (3)*/
              IF l_numser = 'S' THEN /*Se existe o campo NUMSERIAL*/
                  /*INSERT*/
                  l_cmdauxcol := l_cmdauxcol || ',NUMSERIAL';
                  l_cmdauxval := l_cmdauxval || ','||''''||l_NumSerial||'''';
                  /*Crachá Mestre*/
                  l_mesauxval := l_mesauxval || ','||''''||l_NumSerial||'''';
                  /*UPDATE*/
                  l_cmdauxupd := l_cmdauxupd || ', NUMSERIAL = '||''''||l_NumSerial||'''';
                  /*Crachá Mestre*/
                  l_mesauxupd := l_mesauxupd || ', NUMSERIAL = '||''''||l_NumSerial||'''';
              END IF;
          END IF;
          /*INSERT*/
          l_cmdauxcol := l_cmdauxcol || ',ICARD,TPFIS,DATAHORA';
          l_cmdauxval := l_cmdauxval || ','||''''||l_icard||''''||
                                        ','||''''||l_tpfis||''''||
                                        ','||''''||l_datahora||'''';
          /*Crachá Mestre*/
          l_mesauxval := l_mesauxval || ','||''''||l_icard||''''||
                                        ','||''''||l_tpfis||''''||
                                        ','||''''||l_datahora||'''';
          /*UPDATE*/
          l_cmdauxupd := l_cmdauxupd || ', ICARD = '||''''||l_icard||''''||
                                        ', TPFIS = '||''''||l_tpfis||''''||
                                        ', DATAHORA = '||''''||l_datahora||'''';
          /*Crachá Mestre*/
          l_mesauxupd := l_mesauxupd || ', ICARD = '||''''||l_icard||''''||
                                        ', TPFIS = '||''''||l_tpfis||''''||
                                        ', DATAHORA = '||''''||l_datahora||'''';
          /*FxHoraria*/
          l_fxhauxcol := l_fxhauxcol || ',ICARD';
          l_fxhauxval := l_fxhauxval || ','||''''||l_icard||'''';
          l_fxhauxupd := l_fxhauxupd || ', ICARD = '||''''||l_icard||'''';


          /*Tratamento Especial para o Campo Situa*/
          IF ((l_temtit = 'S') AND (l_chcass = 'S')) THEN /*Definição da r070dac utiliza crachá associado.*/
              IF (l_r070con.chcpri = 0) THEN
                  IF (l_r070con.SITCRA = 0) THEN
                      l_situa := '7'; /*Principal Liberado*/
                  ELSE
                      l_situa := '1'; /*Principal Bloqueado*/
                  END IF;
              ELSE
                  l_situa := '4'; /*Crachá Secundário, se comportará de acordo com o Crachá Principal.*/
                  SP_INTSTR(l_r070con.ChcPri, '999999999999',l_Titular OUT);
                  /*Adiciona o Campo Titular na String*/
                  /*INSERT*/
                  l_cmdauxcol := l_cmdauxcol || ',TITULAR';
                  l_cmdauxval := l_cmdauxval || ','||''''||l_Titular||'''';
                  /*Crachá Mestre*/
                  l_mesauxval := l_mesauxval || ','||''''||l_Titular||'''';
                  /*UPDATE*/
                  l_cmdauxupd := l_cmdauxupd || ', TITULAR = '||''''||l_Titular||'''';
                  /*Crachá Mestre*/
                  l_mesauxupd := l_mesauxupd || ', TITULAR = '||''''||l_Titular||'''';
              END IF;
          END IF;
          /*Adiciona o Comando Situa na String*/
          /*INSERT*/
          l_cmdauxcol := l_cmdauxcol || ',SITUA';
          l_cmdauxval := l_cmdauxval || ','||''''||l_situa||'''';

          /*Crachá Mestre*/
          l_mesauxval := l_mesauxval || ','||''''||l_situa||'''';
          /*UPDATE*/
          l_cmdauxupd := l_cmdauxupd || ', SITUA = '||''''||l_situa||'''';
          /*Crachá Mestre*/
          l_mesauxupd := l_mesauxupd || ', SITUA = '||''''||l_situa||'''';

          /*Verifica se vai fazer INSERT/update, monta o comando e executa.*/
          l_nodatafound := FALSE;
          BEGIN
                l_comando_SELECT := 'SELECT ICARD FROM '||l_usutel||'CONTROLE WHERE ICARD = '''||l_icard||'''';
                SP_SELTSI(1, 'l_icard', l_comando_select, l_retnumberaux OUT, l_icard OUT, l_reterr OUT);
                IF (l_reterr = 1) THEN /*NO_DATA_FOUND*/
                    L_NODATAFOUND:=TRUE;
                END IF;
                IF (l_reterr = 2) THEN /*TOO_MANY_ROWS*/
                    RAISERROR 103 'SPUPDTSI: Erro em Controle - TOO MANY ROWS';
                END IF;
          EXCEPTION
              WHEN OTHERS THEN RAISERROR 103 'SPUPDTSI: Erro No SELECT Controle 1 - SUBNV.';
          END;

          /*Verifica se Atualiza Créditos de Acesso*/
          IF (p_atucre = TRUE) OR (l_noDataFound = TRUE) THEN

              l_cmdauxcol := l_cmdauxcol ||',CRED_FX1,FX_1,CRED_FX2,FX_2,CRED_FX3,FX_3,CRED_FX4,FX_4';
              l_cmdauxval := l_cmdauxval ||','||''''||l_cred_fx1||''''||','||''''||l_fx1||''''
                                         ||','||''''||l_cred_fx2||''''||','||''''||l_fx2||''''
                                         ||','||''''||l_cred_fx3||''''||','||''''||l_fx3||''''
                                         ||','||''''||l_cred_fx4||''''||','||''''||l_fx4||'''';

              /*Crachá Mestre*/
              l_mesauxval := l_mesauxval ||',''00'',''24002400'',''00'',''24002400'''
                                         ||',''00'',''24002400'',''00'',''24002400''';

              l_cmdauxupd := l_cmdauxupd ||', CRED_FX1 = '||''''||l_cred_fx1||''''||
                          ', FX_1 = '||''''||l_fx1||''''||', CRED_FX2 = '||''''||l_cred_fx2||''''||
                          ', FX_2 = '||''''||l_fx2||''''||', CRED_FX3 = '||''''||l_cred_fx3||''''||
                          ', FX_3 = '||''''||l_fx3||''''||', CRED_FX4 = '||''''||l_cred_fx4||''''||
                          ', FX_4 = '||''''||l_fx4||'''';

              /*Crachá Mester*/
              l_mesauxupd := l_mesauxupd ||', CRED_FX1 = ''00'', FX_1 = ''24002400'''
                                         ||', CRED_FX2 = ''00'', FX_2 = ''24002400'''
                                         ||', CRED_FX3 = ''00'', FX_3 = ''24002400'''
                                         ||', CRED_FX4 = ''00'', FX_4 = ''24002400''';

              IF (l_campoCred = TRUE) THEN
                  /*Variáveis de INSERT*/
                  l_cmdauxcol := l_cmdauxcol || ',CRED_FX5,FX_5,CRED_FX6,FX_6';
                  l_cmdauxval := l_cmdauxval || ','||''''||l_cred_fx5||''''||
                                                ','||''''||l_fx5||''''||
                                                ','||''''||l_cred_fx6||''''||
                                                ','||''''||l_fx6||'''';
                  /*Crachá Mestre*/
                  l_mesauxval := l_mesauxval ||',''00'',''24002400'',''00'',''24002400''';

                  /*Variáveis de UPDATE*/
                  l_cmdauxupd := l_cmdauxupd || ', CRED_FX5 = '||''''||l_cred_fx5||''''||
                                          ', FX_5 = '||''''||l_fx5||''''||
                                          ', CRED_FX6 = '||''''||l_cred_fx6||''''||
                                          ', FX_6 = '||''''||l_fx6||'''';
                  /*Crachá Mestre*/
                  l_mesauxupd := l_mesauxupd ||', CRED_FX5 = ''00'', FX_5 = ''24002400'''
                                             ||', CRED_FX6 = ''00'', FX_6 = ''24002400''';
              END IF;
          END IF;  

          /*Verifica se Atualiza SubNv*/

          IF (length(l_r070con.NivAtu) = 5) THEN
            l_subnv_5 := l_r070con.NivAtu;
          ELSE
            l_subnv_5 := l_r070con.NivAtu||'00';
          END IF;
          l_subnv   := l_r070con.NivAtu;


          IF (l_nodatafound = TRUE) THEN
              /* se não achou na controle é só INSERT e então verificar se é com 5 ou 3 dígitos*/
              IF (p_subnv = TRUE) THEN
                  IF (l_newprm = TRUE)THEN
                      /*INSERT*/
                      l_cmdauxcol := l_cmdauxcol || ',SUBNV';
                      l_cmdauxval := l_cmdauxval || ','||''''||l_subnv_5||'''';
                      /*Crachá Mestre*/
                      l_mesauxval := l_mesauxval || ','||''''||l_subnv_5||'''';
                      /*UPDATE*/
                      l_cmdauxupd := l_cmdauxupd || ', SUBNV = '||''''||l_subnv_5||'''';
                      /*Crachá Mestre*/
                      l_mesauxupd := l_mesauxupd || ', SUBNV = '||''''||l_subnv_5||'''';
                  ELSE
                      /*INSERT*/
                      l_cmdauxcol := l_cmdauxcol || ',SUBNV';
                      l_cmdauxval := l_cmdauxval || ','||''''||l_subnv||'''';
                      /*Crachá Mestre*/
                      l_mesauxval := l_mesauxval || ','||''''||l_subnv||'''';
                      /*UPDATE*/
                      l_cmdauxupd := l_cmdauxupd || ', SUBNV = '||''''||l_subnv||'''';
                      /*Crachá Mestre*/
                      l_mesauxupd := l_mesauxupd || ', SUBNV = '||''''||l_subnv||'''';
                  END IF;
              END IF;
          ELSE
              /* se existe na controle, verificar se é com 5 ou 3 dígitos e ainda se é INSERT ou update */
              IF (p_subnv = TRUE) THEN
                  IF (l_newprm = TRUE)THEN
                      /*UPDATE*/
                      l_cmdauxupd := l_cmdauxupd || ', SUBNV = '||''''||l_subnv_5||'''';
                      /*Crachá Mestre*/
                      l_mesauxupd := l_mesauxupd || ', SUBNV = '||''''||l_subnv_5||'''';
                  ELSE
                      /*UPDATE*/
                      l_cmdauxupd := l_cmdauxupd || ', SUBNV = '||''''||l_subnv||'''';
                      /*Crachá Mestre*/
                      l_mesauxupd := l_mesauxupd || ', SUBNV = '||''''||l_subnv||'''';
                  END IF;
              END IF;
          END IF;




          /*Verifica se Atualiza a Mensagem*/
          IF (p_atumsg = TRUE) OR (l_nodatafound = TRUE) THEN
              /*INSERT*/
              l_cmdauxcol := l_cmdauxcol ||',MENSAGEM,DTA_MENS,QTD_MENS';
              l_cmdauxval := l_cmdauxval ||','||''''||l_desmsg||''''||
                             ','||''''||l_dta_msg||''''||
                             ','||''''||l_qtd_mens||'''';
              /*Crachá Mestre*/
              l_mesauxval := l_mesauxval ||',''                                '',''      '',''00''';

              /*UPDATE*/
              l_cmdauxupd := l_cmdauxupd || ', MENSAGEM = '||''''||l_desmsg||''''||
                             ', DTA_MENS = '||''''||l_dta_msg||''''||
                             ', QTD_MENS = '||''''||l_qtd_mens||'''';
              /*Crachá Mestre*/
              l_mesauxupd := l_mesauxupd ||', MENSAGEM = ''                                '', DTA_MENS = ''      '''
                                         ||', QTD_MENS = ''00''';
          END IF;

          /*Verifica se Atualiza a ultpas_ref*/
          l_idtpes := p_idtpes;
          l_idtpes := lTrim(l_idtpes);
          l_idtpes := rTrim(l_idtpes);

          IF (Length(l_idtpes) > 2) THEN
              l_tipcol := SUBSTRING(l_idtpes,1,2);

            IF (l_tipcol = '04') THEN
                /*INSERT*/
                l_cmdauxcol := l_cmdauxcol || ',ULTPAS_REF';
                l_cmdauxval := l_cmdauxval ||',''''';
                 /*Crachá Mestre*/
                l_mesauxval := l_mesauxval || ',''''';
                 /*UPDATE*/
                l_cmdauxupd := l_cmdauxupd || ', ULTPAS_REF = ''''';
                /*Crachá Mestre*/
                l_mesauxupd := l_mesauxupd || ', ULTPAS_REF = ''''';
            END IF;
          END IF;

          /*Verifica se o Comando será para Crachá Mestre*/
          IF  (l_r070con.TipCra = 8) THEN
              /*Crachá Mestre*/
              IF  (l_nodatafound = TRUE) THEN
                  l_comando_controle := 'INSERT INTO '|| l_usutel ||'CONTROLE ('|| l_cmdinscol || l_cmdauxcol||') VALUES ('
                                                       || l_mesinsval || l_mesauxval ||')';
              ELSE
                  l_comando_controle := 'UPDATE '|| l_usutel ||'CONTROLE SET ' || l_mesupd || l_mesauxupd ||
                               ' WHERE ICARD = '||''''||l_icard|| '''';
              END IF;
          ELSE
              /*Crachá Normal*/
              IF  (l_nodatafound = TRUE) THEN
                  l_comando_controle := 'INSERT INTO '|| l_usutel ||'CONTROLE ('|| l_cmdinscol || l_cmdauxcol||') VALUES ('
                                                       || l_cmdinsval || l_cmdauxval ||')';
              ELSE
                  l_comando_controle := 'UPDATE '|| l_usutel ||'CONTROLE SET ' || l_cmdupd || l_cmdauxupd ||
                               ' WHERE ICARD = '||''''||l_icard|| '''';
              END IF;
          END IF;
          /*Monta o Comando de Atualização da Fx_Horaria*/

          /*Verifica se o Comando será para Autorização de Entrada*/
          IF (l_r070con.TipCra=8) THEN
              IF (l_nodatafound=TRUE) THEN
                  l_comando_controle := 'INSERT INTO '||l_usutel||'CONTROLE ('||l_cmdinscol||l_cmdauxcol||') VALUES ('||l_mesinsval||l_mesauxval||')';
              ELSE
                  l_comando_controle := 'UPDATE '||l_usutel||'CONTROLE SET '||l_mesupd||l_mesauxupd||' WHERE ICARD = '||''''||l_icard||'''';
              END IF;
          ELSE
              IF (l_nodatafound=TRUE) THEN
                  l_comando_controle := 'INSERT INTO '||l_usutel||'CONTROLE ('||l_cmdinscol||l_cmdauxcol||') VALUES ('||l_cmdinsval||l_cmdauxval||')';
              ELSE
                  l_comando_controle := 'UPDATE '||l_usutel||'CONTROLE SET '||l_cmdupd||l_cmdauxupd||' WHERE ICARD = '||''''||l_icard||'''';
              END IF;
          END IF;
          SP_CMDTSI(l_comando_controle);
          IF (l_r070con.TipCra = 12) THEN
              l_temAen := TRUE;

              BEGIN
                  SELECT CODPRM INTO l_prmAen FROM R070CON WHERE NUMCRA = l_r070con.NUMCRA;
              EXCEPTION
                  WHEN OTHERS THEN l_temAen := FALSE;
              END;

              IF (l_temAen = TRUE) THEN
                  IF (l_newprm = TRUE) THEN
                      SP_INTSTR(l_prmAen,'99999',l_grupo_5);
                      l_cmdupdaen := ' GRUPO = '||''''||l_grupo_sab_5||''''||', GRUPO_SAB = '||''''||l_grupo_sab_5||''''||', GRUPO_DOM = '||''''||l_grupo_dom_5||''''||', GRUPO_FER = '||''''||l_grupo_fer_5||'''';
                  ELSE
                      SP_INTSTR(l_prmAen,'999',l_grupo);
                      l_cmdupdaen := ' GRUPO = '||''''||l_grupo||''''||', GRUPO_SAB = '||''''||l_grupo||''''||', GRUPO_DOM = '||''''||l_grupo||''''||', GRUPO_FER = '||''''||l_grupo||'''';
                  END IF;
                  IF (l_verafa = 'S') THEN
                      l_cmdupdaen := l_cmdupdaen||', VER_AFAST = ''0''';
                  END IF;
                  IF (l_verhor = 'S') THEN
                      l_cmdupdaen := l_cmdupdaen||', VER_HORA = ''0''';
                  END IF;

                  l_comando_controle := 'UPDATE '||l_usutel||'CONTROLE SET '||l_cmdupdaen||' WHERE ICARD = '||''''||l_icard||'''';
                  SP_CMDTSI(l_comando_controle);
              END IF;
          END IF;

          IF ((l_semfxh = FALSE) AND (p_atufxh = TRUE)) THEN
              /*Verifica se vai fazer INSERT/update, monta o comando e executa.*/
              l_nodatafound := FALSE;
              BEGIN
                  l_comando_SELECT := 'SELECT ICARD FROM '||l_usutel||'FXHORARIA WHERE ICARD = '''||l_icard_bkp||'''';
                  SP_SELTSI(1, 'l_icard', l_comando_select, l_retnumberaux OUT, l_icard OUT, l_reterr OUT);
                  IF (l_reterr = 1) THEN /*NO_DATA_FOUND*/
                      L_NODATAFOUND:=TRUE;
                  END IF;
                  IF (l_reterr = 2) THEN /*TOO_MANY_ROWS*/
                      RAISERROR 103 'SPUPDTSI: Erro em FXHORARIA - TOO MANY ROWS';
                  END IF;
              EXCEPTION
                  WHEN OTHERS THEN RAISERROR 103 'SPUPDTSI: Erro No SELECT Fxhoraria 1.';
              END;

              /*Verifica se o Comando será para Crachá Mestre*/
              IF  (l_r070con.TipCra = 8) THEN
                  /*Crachá Mestre*/
                  IF  (l_nodatafound = TRUE) THEN
                      l_comando_fxhoraria := 'INSERT INTO '|| l_usutel ||'FXHORARIA ('||l_cmdinsfxh||l_fxhauxcol||') VALUES ('
                                                                      ||l_mesvalfxh||l_fxhauxval||')';
                  ELSE
                      l_comando_fxhoraria := 'UPDATE '|| l_usutel ||'FXHORARIA SET ' ||l_mesupdfxh||l_fxhauxupd||
                                             ' WHERE ICARD = '||''''||l_icard|| '''';
                  END IF;
              ELSE
                  /*Crachá Normal*/
                  IF  (l_nodatafound = TRUE) THEN
                      l_comando_fxhoraria := 'INSERT INTO '|| l_usutel ||'FXHORARIA ('||l_cmdinsfxh||l_fxhauxcol||') VALUES ('
                                                                      ||l_cmdvalfxh||l_fxhauxval||')';
                  ELSE
                      l_comando_fxhoraria := 'UPDATE '|| l_usutel ||'FXHORARIA SET ' ||l_cmdupdfxh||l_fxhauxupd||
                                             ' WHERE ICARD = '||''''||l_icard|| '''';
                  END IF;
              END IF;
              SP_CMDTSI(l_comando_fxhoraria);
          END IF;
          <<continue_LOOP>>
          NULL;
      END LOOP;
  END IF;
END␀ò÷␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
„ PROCEDURE SP_AUDGENREG(PSEQREG NUMBER(15),PVERSEQ NUMBER(10),PNOMTAB VARCHAR2(16),PLOGREG VARCHAR2(2000))
 IS
BEGIN
  NULL;
END		SENIOR;20SP_AUDGETUSU
š␀␀


 PROCEDURE SP_AUDGENREG(PSEQREG NUMBER(15),PVERSEQ NUMBER(10),PNOMTAB VARCHAR2(16),PLOGREG VARCHAR2(2000))
 IS

l_tipdoc  NUMBER(1);
l_numdoc  VARCHAR(20);
l_codusu  NUMBER(10);
l_nomusu  VARCHAR(20);
l_datatu  DATE;
l_horatu  NUMBER(4);
l_nomtab  VARCHAR(100);
l_segatu  NUMBER(2);
BEGIN
  /*Obtem a data/hora da alteração do registro.*/
  l_datatu := CURDATE();
  l_horatu := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_segatu := SECOND(CURTIME());

  SP_AUDGetUsu(l_codusu OUT, l_tipdoc OUT, l_numdoc OUT, l_nomusu OUT);
  
  l_nomtab := pNomTab;
  
  IF (l_nomtab = 'R030EMP') THEN
	l_nomtab := 'R030EMP - Cadastro de empresas';
  END IF;
  
  IF (l_nomtab = 'R034CPL') THEN
	l_nomtab := 'R034CPL - Ficha complementar colaborador';
  END IF;
  
  IF (l_nomtab = 'R034DAC') THEN
	l_nomtab := 'R034DAC - Definições de acesso do colaborador';
  END IF;
  
  IF (l_nomtab = 'R034FUN') THEN
	l_nomtab := 'R034FUN - Cadastro Ficha básica colaborador';
  END IF;
  
  IF (l_nomtab = 'R034PRM') THEN
	l_nomtab := 'R034PRM - Permissão de acesso colaborador';
  END IF;
  
  IF (l_nomtab = 'R038AFA') THEN
	l_nomtab := 'R038AFA - Histórico afastamento';
  END IF;
  
