TRIGGER R304EMP_SI AFTER INSERT ON R304EMP
DECLARE
	CURSOR c_R304EMP IS
	SELECT NUMEMP, TIPCOL, NUMCAD, NUMATO, NUMMAT, SEQREG, PUBATO, TIPQUA, CARFUN, VIGCAR
	  FROM R304EMP 
	 WHERE (PIDSTA IS NULL OR PIDSTA = '' OR PIDSTA = ' ');
  
	TYPE t_R304EMP IS RECORD (
		NUMEMP   R304EMP.NumEmp%TYPE,
		TIPCOL   R304EMP.TipCol%TYPE,
		NUMCAD   R304EMP.NumCad%TYPE,
		NUMATO   R304EMP.NumAto%TYPE,
		NUMMAT   R304EMP.NumMat%TYPE,
		SEQREG   R304EMP.SeqReg%TYPE,
		PUBATO   R304EMP.PubAto%TYPE,
		TIPQUA   R304EMP.TipQua%TYPE,
		CARFUN   R304EMP.CarFun%TYPE,
		VIGCAR   R304EMP.VigCar%TYPE
	);
    
    l_R304EMP t_R304EMP;
	l_PidSta VARCHAR2(30);
	l_DesRes VARCHAR(250);
	l_VersaoESfinge NUMBER;
	l_TipoCargoESfinge NUMBER;
	l_LayoutGerarPendencia NUMBER;
BEGIN
	FOREACH c_R304EMP INTO l_R304EMP.NumEmp, l_R304EMP.TipCol, l_R304EMP.NumCad, l_R304EMP.NumAto, l_R304EMP.NumMat, l_R304EMP.SeqReg, l_R304EMP.PubAto, l_R304EMP.TipQua, l_R304EMP.CarFun, l_R304EMP.VigCar
	LOOP
		l_DesRes := 'Número do Ato: ' || l_R304EMP.NumAto || ', Matrícula: ' || l_R304EMP.NumMat;
		l_VersaoESfinge := 0;
		l_TipoCargoESfinge := 0;
		l_LayoutGerarPendencia := 8; /* layout descontinuado na versão 6.0 do eSfinge, substituído pelo 21 e 22.*/
		
		SP_VERSAO_ESFINGE(l_R304EMP.NumEmp, l_R304EMP.PubAto, l_VersaoESfinge OUT);
		SP_TPCARGO_ESFINGE(l_R304EMP.NumEmp, l_R304EMP.TipQua, l_R304EMP.CarFun, l_R304EMP.VigCar, l_TipoCargoESfinge OUT);
		
		IF (l_VersaoESfinge >= 9) THEN
		  IF (l_TipoCargoESfinge = 4) THEN
		    l_LayoutGerarPendencia := 22;
		  ELSE
		    l_LayoutGerarPendencia := 21;
		  END IF;
		END IF;
		
		/* Gera um novo PID */
		SP_GERPIDSTA(l_R304EMP.NumEmp, l_LayoutGerarPendencia, l_PidSta OUT);
		/* Inclui registro de status na tabela R304STA */
		SP_GERSTA_ESFINGE(l_LayoutGerarPendencia, l_PidSta, l_R304EMP.PubAto, l_DesRes, l_R304EMP.NumEmp, l_R304EMP.TipCol, l_R304EMP.NumCad);
		
		/* Grava o PID gerado no campo PIDSTA da própria tabela */
		BEGIN
			UPDATE R304EMP
			   SET PIDSTA = l_PidSta
			 WHERE NUMEMP = l_R304EMP.NumEmp
			   AND TIPCOL = l_R304EMP.TipCol
			   AND NUMCAD = l_R304EMP.NumCad
			   AND NUMATO = l_R304EMP.NumAto
			   AND NUMMAT = l_R304EMP.NumMat
			   AND SEQREG = l_R304EMP.SeqReg;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar o campo PIDSTA na tabela R304EMP.';		
		END;
	END LOOP;
END␀ å␀␀		SENIOR;0␀␀TRIGGER R304EMP_EI BEFORE INSERT ON R304EMP FOR EACH ROW
DECLARE
	l_SeqReg NUMBER(9);
	l_StaEnv CHAR;
	l_SeqRegStr VARCHAR2(9);
	l_MsgErr VARCHAR2(255);
BEGIN
	/* Busca última sequência cadastrada */
	BEGIN
		SELECT EMP.SEQREG, STA.STAENV INTO l_SeqReg, l_StaEnv FROM R304EMP EMP, R304STA STA
		 WHERE EMP.PIDSTA = STA.PIDSTA
		   AND EMP.NUMEMP = :NEW.NumEmp
		   AND EMP.TIPCOL = :NEW.TipCol
		   AND EMP.NUMCAD = :NEW.NumCad
		   AND EMP.NUMATO = :NEW.NumAto
		   AND EMP.NUMMAT = :NEW.NumMat
		   AND EMP.PIDSTA = STA.PIDSTA
		   AND EMP.SEQREG = (SELECT MAX(EMP2.SEQREG) FROM R304EMP EMP2
		   					  WHERE EMP2.NUMEMP = EMP.NUMEMP
		   					    AND EMP2.TIPCOL = EMP.TIPCOL
		   					    AND EMP2.NUMCAD = EMP.NUMCAD
		   					    AND EMP2.NUMATO = EMP.NUMATO
		   					    AND EMP2.NUMMAT = EMP.NUMMAT);
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_SeqReg := 0;
			l_StaEnv := '';
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar registro com última sequência na tabela R304EMP.';
	END;
	
	/* Verifica se encontrou última sequência */
	IF (l_SeqReg > 0) THEN
		/* Verifica se está tentando incluir um registro com sequência menor do que a última já cadastrada */
		IF (:NEW.SeqReg < l_SeqReg) THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível cadastrar com esta sequência pois existe outro registro cadastrado com maior sequência (' || l_SeqRegStr || ').';
			RAISERROR 103 l_MsgErr;
		END IF;
		
		/* Verifica se a última sequência está com status Pendente Envio ou Erro */
		IF (l_StaEnv = 'P' OR l_StaEnv = 'R') THEN
			l_SeqRegStr := CONVERT(NUMBER_TO_CHAR, l_SeqReg);
			l_MsgErr := 'Não é possível incluir uma nova sequência sem que registro de sequência anterior ' || l_SeqRegStr || ' esteja com status Cancelado.';
			RAISERROR 103 l_MsgErr;
		END IF;
	END IF;
END␀Ÿå␀␀		SENIOR;0•␀␀

TRIGGER R304EMP_AU AFTER UPDATE ON R304EMP FOR EACH ROW
DECLARE
    CURSOR c_R304STA IS
	SELECT LAYOUT
	  FROM R304STA 
	 WHERE PIDSTA = :NEW.PIDSTA;
	
	TYPE t_R304STA IS RECORD (
		LAYOUT   R304STA.layout%TYPE
	);
	
	l_R304STA t_R304STA;
    l_VersaoESfinge NUMBER;
	l_TipoCargoESfinge NUMBER;
	l_LayoutGerarPendencia NUMBER;
BEGIN
	IF (:OLD.PubAto <> :NEW.PubAto) THEN
		BEGIN
			UPDATE R304STA SET DATREF = :NEW.PubAto WHERE PIDSTA = :NEW.PidSta;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao atualizar data de referência na tabela R304STA';
		END;
	END IF;
	
	FOREACH c_R304STA INTO l_R304STA.layout
	LOOP
	  l_LayoutGerarPendencia := 8; /* layout descontinuado na versão 6.0 do eSfinge, substituído pelo 21 e 22.*/
		
	  SP_VERSAO_ESFINGE(:NEW.NumEmp, :NEW.PubAto, l_VersaoESfinge OUT);
	  SP_TPCARGO_ESFINGE(:NEW.NumEmp, :NEW.TipQua, :NEW.CarFun, :NEW.VigCar, l_TipoCargoESfinge OUT);
		
	  IF (l_VersaoESfinge >= 9) THEN
	    IF (l_TipoCargoESfinge = 4) THEN
		  l_LayoutGerarPendencia := 22;
	    ELSE
		  l_LayoutGerarPendencia := 21;
		END IF;
	  END IF;
	  
	  IF (l_R304STA.layout <> l_LayoutGerarPendencia) THEN
	    BEGIN
	      UPDATE R304STA SET 
	        LAYOUT = l_LayoutGerarPendencia,
	        DATREF = :NEW.PubAto
	       WHERE PIDSTA = :NEW.PidSta;
	    EXCEPTION
	      WHEN OTHERS THEN
		    RAISERROR 103 'Erro ao atualizar o layout na tabela R304STA';
	    END;
	  END IF;
	END LOOP;
END␀¡å␀␀		SENIOR;0•␀␀

TRIGGER R304EMP_EU BEFORE UPDATE ON R304EMP FOR EACH ROW
DECLARE
	l_StaEnv CHAR;
BEGIN
	/* Não deixa alterar registro caso status seja diferente de P - Pendente Envio ou R - Erro */
	SP_GETSTAENV(:NEW.PidSta, l_StaEnv OUT);
	IF (l_StaEnv <> 'P' AND l_StaEnv <> 'R' AND l_StaEnv <> '') THEN
		RAISERROR 103 'Apenas registros com status Pendente Envio ou Erro podem ser alterados/excluídos.';
	END IF;
END␀¢å␀␀	SENIOR;09␀␀

TRIGGER R304EMP_SD AFTER DELETE ON R304EMP
BEGIN
	BEGIN
		DELETE FROM R304STA
		 WHERE LAYOUT IN (8, 21, 22)
		   AND NOT EXISTS (SELECT 1 FROM R304EMP WHERE R304EMP.PIDSTA = R304STA.PIDSTA);
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao excluir registros não utilizados na tabela R304STA.';
	END;
END␀å␀␀		SENIOR;0d

TRIGGER R304EMP_AD AFTER DELETE ON R304EMP FOR EACH ROW
BEGIN
	SP_EXCSTA_ESFINGE(:OLD.PidSta);
