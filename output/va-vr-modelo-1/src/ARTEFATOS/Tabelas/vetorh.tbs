»␀␀PROCEDURE R073RES_ATUCON(P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_CODPRM NUMBER,P_PRMSAB NUMBER,P_PRMDOM NUMBER,P_PRMFER NUMBER,P_CONTPM CHAR,P_USABIO NUMBER,P_GRACON NUMBER,P_CONADP CHAR,P_CONREE CHAR,P_USARFA CHAR)
 IS

l_tipcol       NUMBER(1);
  l_cracha       NUMBER(12);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tipdoc       CHAR(1);
  l_faidom_a     CHAR(56);
  l_faiseg_a     CHAR(56);
  l_faiter_a     CHAR(56);
  l_faiqua_a     CHAR(56);
  l_faiqui_a     CHAR(56);
  l_faisex_a     CHAR(56);
  l_faisab_a     CHAR(56);
  l_faidom_p     CHAR(56);
  l_faiseg_p     CHAR(56);
  l_faiter_p     CHAR(56);
  l_faiqua_p     CHAR(56);
  l_faiqui_p     CHAR(56);
  l_faisex_p     CHAR(56);
  l_faisab_p     CHAR(56);
  l_fairef       CHAR(56);
  l_contpm       NUMBER(1);
  l_tempac       NUMBER(3);
  l_conrea       NUMBER(1);
  l_conadp       NUMBER(1);
  l_nompes       VARCHAR2(40);
  l_ddifon       NUMBER(3);
  l_dddfon       NUMBER(3);
  l_numfon       VARCHAR2(20);
  l_conree       NUMBER(1);
  l_numDoc       VARCHAR2(20);
  l_usarfa       NUMBER(1);
BEGIN
l_numDoc := p_numdoc;
l_numDoc := lTrim(l_numDoc);
l_numDoc := rTrim(l_numDoc);

l_tipcol := 7;
l_conrea := 1;

SP_RetCra (1,0,l_tipcol,0, 0,'',p_tipdoc,l_numDoc,l_cracha OUT);
IF  l_cracha = 0 THEN
    SP_RetCra (2,0,l_tipcol,0,0,'',p_tipdoc,l_numDoc,l_cracha OUT);
END IF;

/* Verifica se Responsável possui Cracha */
IF   l_cracha <> 0  THEN

    /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
    SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
    IF (l_crapri = 0) THEN
        l_crapri := l_cracha;
    END IF;

    /*Busca a faixa horária*/
    SP_FaiRes(p_tipdoc, l_numDoc,
              l_faidom_a OUT, l_faiseg_a OUT, l_faiter_a OUT, l_faiqua_a OUT, l_faiqui_a OUT, l_faisex_a OUT, l_faisab_a OUT,
              l_faidom_p OUT, l_faiseg_p OUT, l_faiter_p OUT, l_faiqua_p OUT, l_faiqui_p OUT, l_faisex_p OUT, l_faisab_p OUT,
              l_fairef OUT);

    IF (p_contpm = 'S') THEN
      l_contpm := 1;
      /* Busca definições do tempo de permanência de aluno na R070DAC. */
      BEGIN
          SELECT TEMPRR INTO l_tempac FROM R070DAC;
      EXCEPTION
          WHEN OTHERS THEN l_tempac := 0;
      END;
    ELSE
      l_contpm := 0;
      l_tempac := 0;
    END IF;

    IF (p_conadp = 'S') THEN
      l_conadp := '1';
    ELSE
      l_conadp := '0';
    END IF;

    IF (p_conree = 'S') THEN
      l_conree := 1;
    ELSE
      l_conree := 0;
    END IF;

    /* Assinala na tabela Controle que o Resp. de Aluno utiliza reconhecimento facial */
    IF  p_usarfa = 'S' THEN
        l_usarfa := 1;
    ELSE
        l_usarfa := 0;
    END IF;

    /*Atualização da controle*/
    SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
    l_idtpes:= '07'||l_tipdoc||l_numDoc;
     /*Preenche o campo com espaços para completar 23 posições*/
    l_idtpes := lTrim(l_idtpes);
    l_idtpes := rTrim(l_idtpes);
    LOOP
        /*Controle do Loop.*/
        IF (Length(l_idtpes) > 22) THEN
            EXIT;
        END IF;
        l_idtpes := ' '||l_idtpes;
    END LOOP;

    SP_RETFON(l_idtpes, l_nompes OUT, l_ddifon OUT, l_dddfon OUT, l_numfon OUT);

    BEGIN
        UPDATE R070CON SET CODPRM = p_codprm, PRMSAB = p_prmsab, PRMDOM = p_prmdom, PRMFER = p_prmfer,
                           FAIAC1 = l_faidom_a, FAIAC2 = l_faiseg_a, FAIAC3 = l_faiter_a, FAIAC4 = l_faiqua_a,
                           FAIAC5 = l_faiqui_a, FAIAC6 = l_faisex_a, FAIAC7 = l_faisab_a,
                           FAIPT1 = l_faidom_p, FAIPT2 = l_faiseg_p, FAIPT3 = l_faiter_p,FAIPT4 = l_faiqua_p,
                           FAIPT5 = l_faiqui_p, FAIPT6 = l_faisex_p, FAIPT7 = l_faisab_p,
                           FAIREF = l_fairef, CONPAC = l_contpm, TEMPAC = l_tempac, USABIO = p_usabio, GRACON = p_gracon,
                           CONREA = l_conrea, CONADP = l_conadp, NOMPES = l_nompes, DDIFON = l_ddifon,
                           DDDFON = l_dddfon, NUMFON = l_numfon, QTDPRV = 0, PESBLO = 0, DESBLO = '', CONREE = l_conree,
                           NUMEMP = 0, TIPCOL = 0, NUMCAD = 0, TIPDOC = p_tipdoc, NUMDOC = l_numDoc, NUMMAT = '0', PROPAC = '0', NUMCAN = 0,
                           USARFA = l_usarfa
                       WHERE NUMFIS = l_crapri;
    EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro Na Atualização da R070CON (R073RES_ATUCON).';
    END;
    /*Atualiza as permissões para os demais crachás da pessoa*/
    SP_UPDPRM(l_cracha, p_codprm, p_prmsab, p_prmdom, p_prmfer, ' ', ' ', ' ');

    /*Atualiza a Pend_grupo se possuir smart*/
    IF (l_numsma > 0) THEN
        /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
        IF (l_tecpri = 3) THEN
            SP_ATUPRM(l_cracha, l_numsma, p_codprm, 0, 0, 0, p_prmsab, p_prmdom, p_prmfer);
        ELSE
            SP_ATUPRM(l_crapri, l_numsma, p_codprm, 0, 0, 0, p_prmsab, p_prmdom, p_prmfer);
        END IF;
    END IF;

    SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, TRUE);

END IF;
END		SENIOR;21BSP_RETCRA
