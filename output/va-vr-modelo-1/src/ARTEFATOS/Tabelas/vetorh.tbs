␀␀CREATE OR REPLACE PROCEDURE SP_DATETONUMBER(p_DATE IN TIMESTAMP(0),p_result IN OUT NUMERIC) 
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
  DATA DECIMAL(14,6);
  HORA DECIMAL(14,6);
BEGIN
  p_result := 0;
  DATA := TRUNC(DATETIMEDIFF('DD', p_DATE, TO_DATE(TO_CHAR(30)||'/'||TO_CHAR(12)||'/'||TO_CHAR(1899)||' '||TO_CHAR(0)||':'||TO_CHAR(0)||':'||TO_CHAR(0),'DD/MM/YYYY HH24:MI:SS')));
  HORA := ((TO_NUMBER(TO_CHAR(p_DATE,'HH24'))*60.0+TO_NUMBER(TO_CHAR(p_DATE,'MI')))/1440.0);
  p_result := DATA+HORA;
  RETURN;
END;
$BODY$;␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
v␀␀PROCEDURE SP_DATINI_S2221(P_NUMEMP NUMBER(4), P_DATINI OUT DATE) 
 IS

	l_TipAmb   R030DES.TipAmb%TYPE;
	l_DatIni DATE;
	alfmen   VARCHAR2(255);
BEGIN
	l_DatIni := DATETIME(31, 12, 1900, 0, 0, 0);

	BEGIN
		SELECT TipAmb INTO l_TipAmb
		FROM R030DES
		WHERE NumEmp = P_NUMEMP;
	EXCEPTION
		WHEN NO_DATA_FOUND THEN
			l_TipAmb := 0;
		WHEN OTHERS THEN
			ALFMEN := 'Erro no SELECT em R030DES.';
			RAISERROR 103 alfmen;
	END;
  
	IF (l_TipAmb = 1) THEN
		/* Busca a data na R030DAT caso tiver em produção */
		BEGIN
			SELECT IniEtm INTO l_DatIni
			FROM R030DAT
			WHERE GruEso = 0;
		EXCEPTION
			WHEN OTHERS THEN
				ALFMEN := 'Erro no SELECT em R030DAT.';
				RAISERROR 103 alfmen;
		END;
	ELSE
		SP_ESOCIAL_R000ESO(2, 0, 11, l_DatIni OUT); /* Busca a data na SP que controla as datas de produção restrita */
	END IF;
	
	P_DATINI := l_DatIni;
END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
R␀␀PROCEDURE SP_DATSTR(P_DATE DATE,P_MASC VARCHAR2(255),P_RET OUT VARCHAR2(255))
 IS

l_tamstr NUMBER(4);
 l_daystr VARCHAR2(2);
 l_monstr VARCHAR2(2);
 l_yeastr VARCHAR2(4);
 l_ret    VARCHAR2(10);

BEGIN
  l_ret:='';
  IF    p_masc = 'DDMMYY' THEN

        l_daystr := CONVERT(NUMBER_TO_CHAR,DayOfMonth(p_date));
        l_tamstr:=Length(l_daystr);
        IF  l_tamstr IS NULL THEN l_tamstr:=0;
        END IF;
        l_tamstr := 2 - l_tamstr;
        l_ret:=Repeat('0',l_tamstr)||l_daystr;

        l_monstr := CONVERT(NUMBER_TO_CHAR,Month(p_date));
        l_tamstr:=Length(l_monstr);
        IF  l_tamstr IS NULL THEN l_tamstr:=0;
        END IF;
        l_tamstr := 2 - l_tamstr;
        l_ret:=l_ret || Repeat('0', l_tamstr)||l_monstr;

        l_yeastr := CONVERT(NUMBER_TO_CHAR,Year(p_date));
        l_tamstr:=Length(l_yeastr);
        IF  l_tamstr = 4 THEN
            l_yeastr := SUBSTRING(l_yeastr,3,2);
        END IF;
        l_tamstr:=Length(l_yeastr);
        IF  l_tamstr IS NULL THEN l_tamstr:=0;
        END IF;
        l_tamstr := 2 - l_tamstr;
        l_ret:=l_ret || Repeat('0', l_tamstr)||l_yeastr;

  ELSIF p_masc = 'DDMMYYYY' THEN

        l_daystr := CONVERT(NUMBER_TO_CHAR,DayOfMonth(p_date));
        l_tamstr:=Length(l_daystr);
        IF  l_tamstr IS NULL THEN l_tamstr:=0;
        END IF;
        l_tamstr := 2 - l_tamstr;
        l_ret:=Repeat('0', l_tamstr)||l_daystr;

        l_monstr := CONVERT(NUMBER_TO_CHAR,Month(p_date));
        l_tamstr:=Length(l_monstr);
        IF  l_tamstr IS NULL THEN l_tamstr:=0;
        END IF;
        l_tamstr := 2 - l_tamstr;
        l_ret:=l_ret || Repeat('0', l_tamstr)||l_monstr;

        l_yeastr := CONVERT(NUMBER_TO_CHAR,Year(p_date));
        l_tamstr:=Length(l_yeastr);
        IF  l_tamstr IS NULL THEN l_tamstr:=0;
        END IF;
        l_tamstr := 4 - l_tamstr;
        l_ret:=l_ret || Repeat('0', l_tamstr)||l_yeastr;

  ELSIF p_masc = 'DD/MM/YYYY' THEN

        l_daystr := CONVERT(NUMBER_TO_CHAR,DayOfMonth(p_date));
        l_tamstr:=Length(l_daystr);
        IF  l_tamstr IS NULL THEN l_tamstr:=0;
        END IF;
        l_tamstr := 2 - l_tamstr;
        l_ret:=Repeat('0', l_tamstr)||l_daystr;

        l_monstr := CONVERT(NUMBER_TO_CHAR,Month(p_date));
        l_tamstr:=Length(l_monstr);
        IF  l_tamstr IS NULL THEN l_tamstr:=0;
        END IF;
        l_tamstr := 2 - l_tamstr;
        l_ret:=l_ret || '/' || Repeat('0', l_tamstr)||l_monstr;

        l_yeastr := CONVERT(NUMBER_TO_CHAR,Year(p_date));
        l_tamstr:=Length(l_yeastr);
        IF  l_tamstr IS NULL THEN l_tamstr:=0;
        END IF;
        l_tamstr := 4 - l_tamstr;
        l_ret:=l_ret || '/' || Repeat('0', l_tamstr)||l_yeastr;
        
  ELSIF p_masc = 'YYYYMMDD' THEN

        l_yeastr := CONVERT(NUMBER_TO_CHAR,Year(p_date));
        l_tamstr:=Length(l_yeastr);
        IF  l_tamstr IS NULL THEN l_tamstr:=0;
        END IF;
        l_tamstr := 4 - l_tamstr;
        l_ret:=Repeat('0', l_tamstr)||l_yeastr;

        l_monstr := CONVERT(NUMBER_TO_CHAR,Month(p_date));
        l_tamstr:=Length(l_monstr);
        IF  l_tamstr IS NULL THEN l_tamstr:=0;
        END IF;
        l_tamstr := 2 - l_tamstr;
        l_ret:=l_ret || Repeat('0', l_tamstr)||l_monstr;
  
        l_daystr := CONVERT(NUMBER_TO_CHAR,DayOfMonth(p_date));
        l_tamstr:=Length(l_daystr);
        IF  l_tamstr IS NULL THEN l_tamstr:=0;
        END IF;
        l_tamstr := 2 - l_tamstr;
        l_ret:=l_ret || Repeat('0', l_tamstr)||l_daystr;
  
  ELSIF p_masc = 'MM/YYYY' THEN

        l_monstr := CONVERT(NUMBER_TO_CHAR,Month(p_date));
        l_tamstr:=Length(l_monstr);
        IF  l_tamstr IS NULL THEN l_tamstr:=0;
        END IF;
        l_tamstr := 2 - l_tamstr;
        l_ret:=Repeat('0', l_tamstr) || l_monstr;

        l_yeastr := CONVERT(NUMBER_TO_CHAR,Year(p_date));
        l_tamstr:=Length(l_yeastr);
        IF  l_tamstr IS NULL THEN l_tamstr:=0;
        END IF;
        l_tamstr := 4 - l_tamstr;
        l_ret:=l_ret || '/' || Repeat('0', l_tamstr) || l_yeastr;

  END IF;
  p_ret := l_ret;
END␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0!SP_HISCON
SP_DATSTR
SP_INTSTR

␀␀PROCEDURE SP_DATVAL(P_TIPOPE CHAR,P_NUMCRA NUMBER(12),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_DATFIM DATE,P_HORFIM NUMBER(5),P_DATAHORA OUT VARCHAR2(10))
 IS

l_data_zero DATE;
  l_datpre    DATE;
  l_dataso    DATE;
  l_dattse    DATE;
  l_datmin    DATE;
  l_datstr    CHAR(6);
  l_horstr    CHAR(4);
  l_datahora  VARCHAR2(10);
BEGIN
  /* Inicializa */
  l_data_zero := '31/12/1900,00:00:00';
  l_datahora  := '';
  
  /* contratos */
  IF  (p_tipcol = 3) OR (p_tipcol  = 2) THEN
       SP_HISCON(p_numemp,p_tipcol,p_numcad,l_datmin OUT);
  ELSE
      l_datmin := '31/12/2050,00:00:00';
  END IF;

  /* Verifica se tem data previsão de término, validade ASO e treinamento Segurança */
  BEGIN
      SELECT DATASO, DATTSE INTO l_dataso, l_dattse FROM R034DAC
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN l_dataso := '31/12/2050,00:00:00';
                              l_dattse := '31/12/2050,00:00:00';
      WHEN OTHERS THEN RAISERROR 103 'SPDatVal: Erro No SELECT R034DAC.';
  END;

  IF  (l_dataso = l_data_zero) OR (l_dataso IS NULL) THEN
      l_dataso := '31/12/2050,00:00:00';
  END IF;
  IF  (l_dattse = l_data_zero) OR (l_dattse IS NULL) THEN
      l_dattse := '31/12/2050,00:00:00';
  END IF;
  IF  (l_datmin = l_data_zero) OR (l_datmin IS NULL) THEN
      l_datmin := '31/12/2050,00:00:00';
  END IF;

  IF  (l_dataso < l_dattse) THEN
      IF  (l_dataso < l_datmin) THEN
          l_datpre := l_dataso;
      ELSE
          IF  (l_dattse < l_datmin) THEN
              l_datpre := l_dattse;
          ELSE
              l_datpre := l_datmin;
          END IF;
      END IF;
  ELSE
      IF  (l_dattse < l_datmin)  THEN
          l_datpre := l_dattse;
      ELSE
          l_datpre := l_datmin;
      END IF;
  END IF;

  IF  (p_datfim <= l_datpre) AND (p_datfim <> l_data_zero) THEN
      SP_DATSTR(p_datfim,'DDMMYY',l_datstr OUT);
      SP_INTSTR(p_horfim,'HHMM',l_horstr OUT);
  ELSE
      SP_DATSTR(l_datpre,'DDMMYY',l_datstr OUT);
      SP_INTSTR(1439,'HHMM',l_horstr OUT);
  END IF;
  l_datahora := l_datstr || l_horstr;

  IF  (l_datahora IS NULL) OR (l_datahora = '') THEN
      IF  p_datfim <> l_data_zero THEN
          SP_DATSTR(p_datfim,'DDMMYY',l_datstr OUT);
          SP_INTSTR(p_horfim,'HHMM',l_horstr OUT);
          l_datahora := l_datstr || l_horstr;
      ELSE
          l_datahora := '3112502359';
      END IF;
  END IF;

  p_datahora := l_datahora;
END		SENIOR;20uSP_USUTEL
SP_RETCRA
SP_INTSTR
SP_HISCON
SP_DATSTR
SP_CMDTSI
R034PLA_CONTPLANTA
SP_RETICARD
SP_DELCONTPLANTA
Ú␀␀PROCEDURE SP_DATVAL(P_TIPOPE CHAR,P_NUMCRA NUMBER(12),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_DATFIM DATE,P_HORFIM NUMBER(5),P_DATAHORA OUT VARCHAR2(10))
 IS

  l_data_zero  DATE;
  l_datpre     DATE;
  l_dataso     DATE;
  l_dattse     DATE;
  l_datmin     DATE;
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datahora   VARCHAR2(10);
  l_comando    CHAR(2048);
  l_cntplt     CHAR(1);
  l_numbarstr  CHAR(12);
  l_numprostr  CHAR(12);
  l_numsmastr  CHAR(12);
  l_cratit     NUMBER(12);
  l_crapro     NUMBER(12);
  l_usutel     VARCHAR(31);
  l_icardA     VARCHAR2(12);
  l_icardR     VARCHAR2(12);
  l_numser     VARCHAR2(12);

  /* CURSOR que atualiza as data de validade por planta (TBS 19) . */
  CURSOR c_r034PLA IS
  SELECT CODPLT,DATASO,DATTSE,BLOPLT FROM R034PLA WHERE
         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad ORDER BY 1;
  TYPE t_r034pla IS RECORD(
    CODPLT   R034PLA.CODPLT%TYPE,
    DATASO   R034PLA.DATASO%TYPE,
    DATTSE   R034PLA.DATTSE%TYPE,
    BLOPLT   R034PLA.BLOPLT%TYPE);
  l_r034pla t_r034pla;

BEGIN
  SP_USUTEL(l_usutel OUT);
  /* Inicializa */
  l_data_zero := '31/12/1900,00:00:00';
  l_datahora  := '';
  
  /* verifica a numeração do crachá */
  IF (p_numcra = 0) THEN
      SP_RetCra(2, p_numemp, p_tipcol, p_numcad, 0, '', 0, '', l_crapro OUT);
      IF  l_crapro = 0 THEN
          SP_RetCra(1, p_numemp, p_tipcol, p_numcad, 0, '', 0, '', l_cratit OUT);
      ELSE
          l_cratit := l_crapro;
      END IF;
  ELSE
      l_cratit := p_numcra;
  END IF;

  /* Contratos */
  /* Se for 'C', quer dizer que a procedure está sendo chamada pela tela de histórico de contratos */
  IF (p_tipope <> 'C') THEN
      IF (p_tipcol = 3) OR (p_tipcol  = 2) THEN
          SP_HISCON(p_numemp,p_tipcol,p_numcad,l_datmin OUT);
      ELSE
          l_datmin := '31/12/2050,00:00:00';
      END IF;
  ELSE
      l_datmin := p_datfim;
  END IF;

  /* Verifica se tem data previsão de término, validade ASO e treinamento Segurança */
  BEGIN
      SELECT DATASO, DATTSE INTO l_dataso, l_dattse FROM R034DAC
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN l_dataso := '31/12/2050,00:00:00';
                              l_dattse := '31/12/2050,00:00:00';
      WHEN OTHERS THEN RAISERROR 103 'SPDatVal: Erro No SELECT R034DAC.';
  END;

  IF (l_dataso = l_data_zero) OR (l_dataso IS NULL) THEN
      l_dataso := '31/12/2050,00:00:00';
  END IF;
  IF (l_dattse = l_data_zero) OR (l_dattse IS NULL) THEN
      l_dattse := '31/12/2050,00:00:00';
  END IF;
  IF (l_datmin = l_data_zero) OR (l_datmin IS NULL) THEN
      l_datmin := '31/12/2050,00:00:00';
  END IF;

  IF (l_dataso < l_dattse) THEN
      IF (l_dataso < l_datmin) THEN
          l_datpre := l_dataso;
      ELSE
          IF (l_dattse < l_datmin) THEN
              l_datpre := l_dattse;
          ELSE
              l_datpre := l_datmin;
          END IF;
      END IF;
  ELSE
      IF (l_dattse < l_datmin) THEN
          l_datpre := l_dattse;
      ELSE
          l_datpre := l_datmin;
      END IF;
  END IF;

  IF (p_datfim <= l_datpre) AND (p_datfim <> l_data_zero) THEN
      SP_DATSTR(p_datfim,'DDMMYY',l_datstr OUT);
      SP_INTSTR(p_horfim,'HHMM',l_horstr OUT);
  ELSE
      SP_DATSTR(l_datpre,'DDMMYY',l_datstr OUT);
      SP_INTSTR(1439,'HHMM',l_horstr OUT);
  END IF;
  l_datahora := l_datstr || l_horstr;

  IF (l_datahora IS NULL) OR (l_datahora = '') THEN
      IF (p_datfim <> l_data_zero) THEN
          SP_DATSTR(p_datfim,'DDMMYY',l_datstr OUT);
          SP_INTSTR(p_horfim,'HHMM',l_horstr OUT);
          l_datahora := l_datstr || l_horstr;
      ELSE
          l_datahora := '3112502359';
      END IF;
  END IF;

  p_datahora := l_datahora;

  /*SOMENTE PARA TBS 20 e 23, verifica R070TSI.CNTPLT*/
  BEGIN
      SELECT CNTPLT INTO l_cntplt FROM R070TSI;
  EXCEPTION
    WHEN OTHERS THEN
      l_cntplt := 'N';
  END;

  /* Atualiza registros da CONTPLANT nos TBSs 20 e 23 apenas se R070TI.CntPlt = S */
  IF (l_cntplt = 'S') THEN
      /*Remove este ICARD da tabela CONTPLANTA*/
      SP_DELCONTPLANTA(l_cratit);

      /*Se não estiver deletando, atualiza a tabela ContPlanta*/
      IF (p_tipope <> 'D') THEN
          FOREACH c_r034PLA INTO l_r034Pla.CODPLT,
                                 l_r034Pla.dataso,
                                 l_r034Pla.dattse,
                                 l_r034Pla.bloplt
          LOOP
            R034PLA_CONTPLANTA(p_tipope, l_cratit, p_numemp, p_tipcol, p_numcad, l_r034Pla.CODPLT, l_r034Pla.dataso, l_r034Pla.dattse, l_datstr, l_horstr, l_r034Pla.bloplt);
          END LOOP;
      END IF;
  END IF;
END		SENIOR;23uSP_USUTEL
SP_RETCRA
SP_INTSTR
SP_HISCON
SP_DATSTR
SP_CMDTSI
R034PLA_CONTPLANTA
SP_RETICARD
SP_DELCONTPLANTA
Ú␀␀PROCEDURE SP_DATVAL(P_TIPOPE CHAR,P_NUMCRA NUMBER(12),P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(10),P_DATFIM DATE,P_HORFIM NUMBER(5),P_DATAHORA OUT VARCHAR2(10))
 IS

  l_data_zero  DATE;
  l_datpre     DATE;
  l_dataso     DATE;
  l_dattse     DATE;
  l_datmin     DATE;
  l_datstr     CHAR(6);
  l_horstr     CHAR(4);
  l_datahora   VARCHAR2(10);
  l_comando    CHAR(2048);
  l_cntplt     CHAR(1);
  l_numbarstr  CHAR(12);
  l_numprostr  CHAR(12);
  l_numsmastr  CHAR(12);
  l_cratit     NUMBER(12);
  l_crapro     NUMBER(12);
  l_usutel     VARCHAR(31);
  l_icardA     VARCHAR2(12);
  l_icardR     VARCHAR2(12);
  l_numser     VARCHAR2(12);

  /* CURSOR que atualiza as data de validade por planta (TBS 19) . */
  CURSOR c_r034PLA IS
  SELECT CODPLT,DATASO,DATTSE,BLOPLT FROM R034PLA WHERE
         NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad ORDER BY 1;
  TYPE t_r034pla IS RECORD(
    CODPLT   R034PLA.CODPLT%TYPE,
    DATASO   R034PLA.DATASO%TYPE,
    DATTSE   R034PLA.DATTSE%TYPE,
    BLOPLT   R034PLA.BLOPLT%TYPE);
  l_r034pla t_r034pla;

BEGIN
  SP_USUTEL(l_usutel OUT);
  /* Inicializa */
  l_data_zero := '31/12/1900,00:00:00';
  l_datahora  := '';
  
  /* verifica a numeração do crachá */
  IF (p_numcra = 0) THEN
      SP_RetCra(2, p_numemp, p_tipcol, p_numcad, 0, '', 0, '', l_crapro OUT);
      IF  l_crapro = 0 THEN
          SP_RetCra(1, p_numemp, p_tipcol, p_numcad, 0, '', 0, '', l_cratit OUT);
      ELSE
          l_cratit := l_crapro;
      END IF;
  ELSE
      l_cratit := p_numcra;
  END IF;

  /* Contratos */
  /* Se for 'C', quer dizer que a procedure está sendo chamada pela tela de histórico de contratos */
  IF (p_tipope <> 'C') THEN
      IF (p_tipcol = 3) OR (p_tipcol  = 2) THEN
          SP_HISCON(p_numemp,p_tipcol,p_numcad,l_datmin OUT);
      ELSE
          l_datmin := '31/12/2050,00:00:00';
      END IF;
  ELSE
      l_datmin := p_datfim;
  END IF;

  /* Verifica se tem data previsão de término, validade ASO e treinamento Segurança */
  BEGIN
      SELECT DATASO, DATTSE INTO l_dataso, l_dattse FROM R034DAC
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
  EXCEPTION
      WHEN NO_DATA_FOUND THEN l_dataso := '31/12/2050,00:00:00';
                              l_dattse := '31/12/2050,00:00:00';
      WHEN OTHERS THEN RAISERROR 103 'SPDatVal: Erro No SELECT R034DAC.';
  END;

  IF (l_dataso = l_data_zero) OR (l_dataso IS NULL) THEN
      l_dataso := '31/12/2050,00:00:00';
  END IF;
  IF (l_dattse = l_data_zero) OR (l_dattse IS NULL) THEN
      l_dattse := '31/12/2050,00:00:00';
  END IF;
  IF (l_datmin = l_data_zero) OR (l_datmin IS NULL) THEN
      l_datmin := '31/12/2050,00:00:00';
  END IF;

  IF (l_dataso < l_dattse) THEN
      IF (l_dataso < l_datmin) THEN
          l_datpre := l_dataso;
      ELSE
          IF (l_dattse < l_datmin) THEN
              l_datpre := l_dattse;
          ELSE
              l_datpre := l_datmin;
