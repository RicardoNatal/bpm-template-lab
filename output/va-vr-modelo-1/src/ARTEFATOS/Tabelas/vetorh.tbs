DECLARE
/* CURSOR c/ os registros gravados no R038HFI_AUX */
  CURSOR c_r038hfi_ins IS SELECT NUMEMP,TIPCOL,NUMCAD,DATALT,EMPATU,CADATU,CODFIL,CODESC,STAHIS
                            FROM R038HFI_AUX WHERE TIPOPE = 1;
  TYPE t_r038HFI_aux IS RECORD(
    NUMEMP   R038HFI_AUX.NUMEMP%TYPE,
    TIPCOL   R038HFI_AUX.TIPCOL%TYPE,
    NUMCAD   R038HFI_AUX.NUMCAD%TYPE,
    DATALT   R038HFI_AUX.DATALT%TYPE,
    EMPATU   R038HFI_AUX.EMPATU%TYPE,
    CADATU   R038HFI_AUX.CADATU%TYPE,
    CODFIL   R038HFI_AUX.CODFIL%TYPE,
    CODESC   R038HFI_AUX.CODESC%TYPE,    
    STAHIS   R038HFI_AUX.STAHIS%TYPE);
  l_r038HFI_aux t_r038HFI_aux;
  l_online       BOOLEAN;

BEGIN
  SP_VerOnLine(l_online OUT);
  
  /* Le Registro do CURSOR */
  FOREACH c_r038hfi_ins INTO  l_r038HFI_aux.NUMEMP,
                              l_r038HFI_aux.TIPCOL,
                              l_r038HFI_aux.NUMCAD,
                              l_r038HFI_aux.DATALT,
                              l_r038HFI_aux.EMPATU,
                              l_r038HFI_aux.CADATU,
                              l_r038HFI_aux.CODFIL,
                              l_r038HFI_aux.CODESC,                              
                              l_r038HFI_aux.STAHIS
  LOOP
    IF   (l_online = TRUE) AND (l_r038HFI_aux.STAHIS = 1) THEN
      /* Procedure que atualiza os creditos de acesso.*/
      SP_GerCrc('I',1,l_r038HFI_aux.NUMEMP,
                      l_r038HFI_aux.TIPCOL,
                      l_r038HFI_aux.NUMCAD,
                      l_r038HFI_aux.DATALT,
                      l_r038HFI_aux.EMPATU,
                      l_r038HFI_aux.CADATU,
                      l_r038HFI_aux.CODFIL,
                      l_r038HFI_aux.CODESC,
                      l_r038HFI_aux.STAHIS);

      /* Procedure que atualiza a tabela controle.*/
      R038HFI_CON (l_r038hfi_aux.NUMEMP, l_r038hfi_aux.TIPCOL, l_r038hfi_aux.NUMCAD, l_r038hfi_aux.DATALT);
    END IF;

    /* Atualiza o Quadro Efetivo - QL */
    QL_INCFILIAL(l_r038hfi_aux.NumEmp, l_r038hfi_aux.TipCol, l_r038HFI_aux.NumCad, l_r038HFI_aux.DatAlt, l_r038HFI_aux.EmpAtu, l_r038HFI_aux.CodFil, l_r038HFI_aux.DatAlt, l_r038HFI_aux.EmpAtu, l_r038HFI_aux.CodFil);
  END LOOP;

  /* Apaga Registro OLD em R038HFI_AUX */
  BEGIN
    DELETE FROM R038HFI_AUX WHERE TIPOPE = 1;
    DROP_TEMP_TABLE R038HFI_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ìÔ␀␀		SENIOR;0 T␀␀

TRIGGER R038HFI_EI AFTER INSERT ON R038HFI FOR EACH ROW

DECLARE
l_datfil       DATE;
  l_comando_nulo BOOLEAN;

  l_DatAdm         R034FUN.DATADM%TYPE;

  l_TemPenFut    BOOLEAN;
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_AltEmp         R038PEN.ALTEMP%TYPE;
  l_AltFil         R038PEN.ALTFIL%TYPE;
  l_AltLoc         R038PEN.ALTLOC%TYPE;
  l_AltCcu         R038PEN.ALTCCU%TYPE;
  l_AltCar         R038PEN.ALTCAR%TYPE;
  l_AltEsc         R038PEN.ALTESC%TYPE;
  l_AltDes         R038PEN.ALTDES%TYPE;
  l_SitChe         R038PEN.SITCHE%TYPE;
  l_SitUsu         R038PEN.SITUSU%TYPE;
  l_NesRev         R038PEN.NESREV%TYPE;
  l_EmpAtu         R038PEN.EMPATU%TYPE;
  l_CadAtu         R038PEN.CADATU%TYPE;
  l_ColChe       BOOLEAN;
  l_ColUsu       BOOLEAN;

  l_auxNumEmp      R038PEN.NUMEMP%TYPE;
  l_auxTipCol      R038PEN.TIPCOL%TYPE;
  l_auxNumCad      R038PEN.NUMCAD%TYPE;
  l_auxSitChe      R038PEN.SITCHE%TYPE;
  l_auxSitUsu      R038PEN.SITUSU%TYPE;
  l_AssTrfEmp      R000ASS.TRFEMP%TYPE;
  l_AssTrfFil      R000ASS.TRFFIL%TYPE;
  l_layoutAltContratual VARCHAR2(6); 
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);   
  xCodLoc 		   R016HIE.CODLOC%TYPE;

  l_idtpes       VARCHAR2(23);
  l_numemp_str   VARCHAR2(4);
  l_valstr_emp   VARCHAR2(28);
  l_codfil_str   VARCHAR2(6);
  l_valstr_fil   VARCHAR2(34);

  l_NumEmpStr VARCHAR(11);
  l_TipColStr VARCHAR(11);
  l_NumCadStr VARCHAR(11);
  l_Where VARCHAR(2000);
  l_DataZero DATE;
  l_DatIniSST DATE;
  l_DatAltProxHist DATE;
  l_IniHis DATE;
  l_FimHis DATE;
  l_VersaoESocial NUMBER;
  l_infoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HFI_AUX;
  
BEGIN
  BEGIN
    SELECT TRFEMP, TRFFIL INTO l_AssTrfEmp, l_AssTrfFil
      FROM R000ASS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_AssTrfEmp := 0;
      l_AssTrfFil := 0;
  END;

  IF ((l_AssTrfEmp = 2 AND (:NEW.NUMEMP <> :NEW.EMPATU)) OR (l_AssTrfFil = 2)) THEN

    /* Verifica se o colaborador está associado ao cadastro de chefia ou
       se o colaborador está associado com algum usuário */
    R038PEN_COLCHEFE(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_ColChe OUT, l_ColUsu OUT);

    /* Se o colaborador não está associado ao cadastro de Chefia e a um Usuario, verifica se
       está trocando de cadastro e deve verificar se cadastro de origem está associado um usuario
       ou é Chefe */
    IF ((l_ColChe = FALSE) AND (l_ColUsu = FALSE)) THEN
      BEGIN
        SELECT NUMEMP, TIPCOL, NUMCAD INTO l_auxNumEmp, l_auxTipCol, l_auxNumCad
          FROM R038PEN
         WHERE EMPATU = :NEW.NUMEMP
           AND TIPCOL = :NEW.TIPCOL
           AND CADATU = :NEW.NUMCAD
           AND DATTRF = :NEW.DATALT
           AND (NUMEMP <> :NEW.NUMEMP OR NUMCAD <> :NEW.NUMCAD);
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_auxNumEmp := 0;
          l_auxTipCol := 0;
          l_auxNumCad := 0;
      END;

      IF (l_auxNumCad <> 0) THEN
        R038PEN_COLCHEFE(l_auxNumEmp, l_auxTipCol, l_auxNumCad, :NEW.DATALT, l_ColChe OUT, l_ColUsu OUT);
      END IF;
    END IF;

    /* Busca data de admissão do colaborador */
    BEGIN
      SELECT R034FUN.DATADM INTO l_DatAdm
        FROM R034FUN
       WHERE R034FUN.NUMEMP = :NEW.NUMEMP AND
             R034FUN.TIPCOL = :NEW.TIPCOL AND
             R034FUN.NUMCAD = :NEW.NUMCAD;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_DatAdm := DATETIME(31, 12, 1900, 0, 0, 0);
    END;

    /* Se o colaborador é chefe ou está associado a um usuário, e a data admissão for diferente da data
       do histórico gera pendência */
    IF ((l_ColChe = TRUE OR l_ColUsu = TRUE) AND (:NEW.DATALT <> l_DatAdm)) THEN
      /* Verifica se existe pendência numa data futura */
      R038PEN_TEMPENFUT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_TemPenFut OUT);

      /* se não existe pendência com data futura, verifica se existe pendência com data passada e situação não atendida */
      IF (l_TemPenFut = FALSE) THEN
        BEGIN
             SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU
               INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu
               FROM R038PEN
              WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                    R038PEN.TIPCOL = :NEW.TIPCOL AND
                    R038PEN.NUMCAD = :NEW.NUMCAD AND
                    R038PEN.DATTRF < :NEW.DATALT AND
                    ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
                     (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));
        EXCEPTION
             WHEN NO_DATA_FOUND THEN
                  l_NumEmp := 0;
                  l_TipCol := 0;
                  l_NumCad := 0;
                  l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
        END;

        /* Considera que sempre altera filial na inclusão do histórico de filial para criação da pendência */
        l_AltFil := 'S';

        /* Se alterou empresa indica pendência de empresa e filial */
        IF (:NEW.NUMEMP <> :NEW.EMPATU) THEN
          l_AltEmp := 'S';
        ELSE
          l_AltEmp := 'N';
        END IF;

        /* Verifica se deve gerar pendencia de chefia */
        IF (l_ColChe = TRUE) THEN
          l_SitChe := 1; /* Não Atendida */
        ELSE
          l_SitChe := 3; /* Sem necessidade de Alteração */
        END IF;

        /* Verifica se deve gerar pendencia de usuário */
        IF (l_ColUsu = TRUE) THEN
          l_SitUsu := 1; /* Não Atendida */
        ELSE
          l_SitUsu := 4; /* Sem necessidade de Alteração */
        END IF;

        /* Se existir uma pendência com data passada e situação 1 (Não atendida), esta
           será excluída e regerada com a nova data */
        IF (l_NumCad <> 0) THEN

          /* Insere nova pendência com base nos valores da pendência da data passada */
          BEGIN
            INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu);
          EXCEPTION
            WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
          END;

          /* Deleta pendência da data passada */
          R038PEN_DELPENPAS(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATALT);

        ELSE
          /* Verifica se existe pendência na mesma data de alteração */
          BEGIN
               SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, SITCHE, SITUSU INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_auxSitChe, l_auxSitUsu
                 FROM R038PEN
                WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                      R038PEN.TIPCOL = :NEW.TIPCOL AND
                      R038PEN.NUMCAD = :NEW.NUMCAD AND
                      R038PEN.DATTRF = :NEW.DATALT;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_NumEmp := 0;
                    l_TipCol := 0;
                    l_NumCad := 0;
                    l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
                    l_auxSitChe := 0;
                    l_auxSitUsu := 0;
          END;

          /* Se existir pendência na mesma data, atualiza a pendência */
          IF (l_NumCad <> 0) THEN

            IF ((l_auxSitChe = 1 OR l_auxSitChe = 3) AND
                (l_auxSitUsu = 1 OR l_auxSitUsu = 4)) THEN
              /* Atualiza pendência */
              BEGIN
                UPDATE R038PEN SET ALTEMP = l_AltEmp, ALTFIL = l_AltFil, SITCHE = l_SitChe, SITUSU = l_SitUsu, EMPATU = :NEW.EMPATU, CADATU = :NEW.CADATU
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            ELSE
              /* Se a Situação for diferente de Não atendida ou Sem necessidade de alteração, então
                 indica na pendência que necessita Revisão */
              BEGIN
                UPDATE R038PEN SET ALTEMP = l_AltEmp, ALTFIL = l_AltFil, NESREV = 'S', EMPATU = :NEW.EMPATU, CADATU = :NEW.CADATU
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            END IF;

          ELSE

            /* Insere nova pendência */
            BEGIN
              INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_AltEmp, l_AltFil, 'N', 'N', 'N', 'N', 'N', l_SitChe, l_SitUsu, 'N', :NEW.EMPATU, :NEW.CADATU);
            EXCEPTION
              WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
            END;

          END IF;
        END IF;
      END IF;

    END IF;
  END IF;

  /* SOMENTE ATUALIZAR O R034FUN SE NÃO MUDOU DE EMPRESA E CADASTRO */
  IF  (:NEW.STAHIS = 1)
  AND (:NEW.NUMEMP = :NEW.EMPATU)
  AND (:NEW.NUMCAD = :NEW.CADATU) THEN
       BEGIN
         SELECT R034FUN.DATFIL INTO l_datfil
           FROM R034FUN
          WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                R034FUN.NUMEMP = :NEW.NUMEMP AND
                R034FUN.NUMCAD = :NEW.NUMCAD;
       EXCEPTION WHEN OTHERS THEN
         l_comando_nulo:=TRUE;
       END;
       IF (:NEW.DATALT >= l_datfil)
       OR (l_datfil IS NULL) THEN
            /* ATUALIZA A FICHA BÁSICA */
            UPDATE R034FUN
               SET CODFIL = :NEW.CODFIL,
                   DATFIL = :NEW.DATALT,
                   CADFIL = :NEW.CADATU,
                   EMPFIL = :NEW.EMPATU,
                   CONTOV = :NEW.CONTOV,
                   TIPADM = :NEW.TIPADM
             WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                   R034FUN.NUMEMP = :NEW.NUMEMP AND
                   R034FUN.NUMCAD = :NEW.NUMCAD;

            IF  :NEW.FICREG <> 0 THEN
                /* ATUALIZA O COMPLEMENTO DA FICHA BÁSICA */
                BEGIN
                  UPDATE R034CPL
                     SET FICREG = :NEW.FICREG
                   WHERE R034CPL.TIPCOL = :NEW.TIPCOL AND
                         R034CPL.NUMEMP = :NEW.NUMEMP AND
                         R034CPL.NUMCAD = :NEW.NUMCAD;
                EXCEPTION WHEN OTHERS THEN
                  l_comando_nulo:=TRUE;
                END;
            END IF;
       END IF;
  END IF;

  BEGIN
    INSERT INTO R038HFI_AUX (TIPOPE,TIPCOL,NUMEMP,NUMCAD,DATALT,EMPATU,CADATU,CODFIL,CODESC,STAHIS)
                     VALUES (1,:NEW.TIPCOL,:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATALT,:NEW.EMPATU,:NEW.CADATU,:NEW.CODFIL,:NEW.CODESC,:NEW.STAHIS);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R064HFI_AUX.';
  END;

  BEGIN
    UPDATE R066APU SET DIAALT = 10
           WHERE NUMEMP = :NEW.NUMEMP AND
                 TIPCOL = :NEW.TIPCOL AND
                 NUMCAD = :NEW.NUMCAD AND
                 DATAPU >= :NEW.DATALT;
  EXCEPTION WHEN OTHERS THEN
      NULL;
  END;

  /* eSocial - Início */
  IF (:NEW.NUMEMP = :NEW.EMPATU) AND (:NEW.NUMCAD = :NEW.CADATU) THEN
  
    /* S-2206 - Início */
    RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAltContratual OUT);
    IF (l_layoutAltContratual = 'S-2206') THEN
      SP_HIST_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038HFI', 'DATALT', 'I', '', '', 0, 'R038HFI_EI');
    END IF;
    /* S-2206 - Fim */
  
    /* S-2306 - S-1.2 */
    IF (l_layoutAltContratual = 'S-2306') THEN
    	l_infoFacult := TRUE;
    	l_SimplificaoESocial := FALSE;
    	l_VersaoESocial := 0;
    	SP_ESOCIAL_INFO(:NEW.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
    	IF ( (l_VersaoESocial >= 6) ) THEN
      		SP_HIST_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038HFI', 'DATALT', 'I', '', '', 0, 'R038HFI_EI');
    	END IF;
    END IF;

    /* S-2240 - Início */
    l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  
    RH_RET_DATINISST(:NEW.NumEmp, l_DatIniSST OUT);
    
    IF (l_DatIniSST > l_DataZero) THEN
  	  l_NumEmpStr := CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp);
  	  l_TipColStr := CONVERT(NUMBER_TO_CHAR, :NEW.TipCol);
  	  l_NumCadStr := CONVERT(NUMBER_TO_CHAR, :NEW.NumCad);
  	  l_Where := 'NUMEMP = ' || l_NumEmpStr || ' AND TIPCOL = ' || l_TipColStr || ' AND NUMCAD = ' || l_NumCadStr;
  	  SP_PROXHIST_NPER('DATALT', 'R038HFI', l_Where, :NEW.DatAlt, l_DatAltProxHist OUT);
  
  	  l_IniHis := :NEW.DatAlt;
  	
  	  IF (l_DatAltProxHist > l_DataZero) THEN
  	    l_FimHis := DATETIMEADD(DD, -1, l_DatAltProxHist);
  	  ELSE
  	    l_FimHis := l_DataZero;
  	  END IF;
  	
  	  IF (l_FimHis > l_DatIniSST OR l_FimHis = l_DataZero) THEN
  	    IF (l_IniHis < l_DatIniSST) THEN
  		  l_IniHis := l_DatIniSST;
  	    END IF;
  
        SP_E_SOCIAL_SM('S-2240', 'R038HFI', 'N', 'I', l_IniHis, l_FimHis, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', '', 0, NULL, l_IniHis, 0, 'R038HFI_EI');
      END IF;
    END IF;
    /* S-2240 - Fim */
    
  END IF;
  /* eSocial - Fim */
  
  /* Inicio - Geração de logs HistoricoFilial*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 76;     /* HistoricoFilial*/
  l_codtpa := 263;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HFI_EI', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        SP_DATSTR(:NEW.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HFI_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EMPATU', CONVERT(NUMBER_TO_CHAR, :NEW.EMPATU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAP', CONVERT(NUMBER_TO_CHAR, :NEW.CODTAP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', CONVERT(NUMBER_TO_CHAR, :NEW.ESTPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', :NEW.POSTRA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :NEW.TABORG));
        RH_RET_CODLOC(:NEW.TABORG,:NEW.NUMLOC, :NEW.DATALT, xCodLoc OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', xCodLoc);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CADATU', CONVERT(NUMBER_TO_CHAR, :NEW.CADATU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCCU', :NEW.CODCCU);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NATDES', CONVERT(NUMBER_TO_CHAR, :NEW.NATDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPADM', CONVERT(NUMBER_TO_CHAR, :NEW.TIPADM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FICREG', CONVERT(NUMBER_TO_CHAR, :NEW.FICREG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONTOV', :NEW.CONTOV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAACC', CONVERT(NUMBER_TO_CHAR, :NEW.STAACC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MOTPOS', CONVERT(NUMBER_TO_CHAR, :NEW.MOTPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCAR', CONVERT(NUMBER_TO_CHAR, :NEW.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAR', :NEW.CODCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODMOT', CONVERT(NUMBER_TO_CHAR, :NEW.CODMOT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODESC', CONVERT(NUMBER_TO_CHAR, :NEW.CODESC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTMA', CONVERT(NUMBER_TO_CHAR, :NEW.CODTMA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TURINT', CONVERT(NUMBER_TO_CHAR, :NEW.TURINT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORBAS', CONVERT(NUMBER_TO_CHAR, :NEW.HORBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORSAB', CONVERT(NUMBER_TO_CHAR, :NEW.HORSAB));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORSEM', CONVERT(NUMBER_TO_CHAR, :NEW.HORSEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORDSR', CONVERT(NUMBER_TO_CHAR, :NEW.HORDSR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODMTS', CONVERT(NUMBER_TO_CHAR, :NEW.CODMTS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEST', CONVERT(NUMBER_TO_CHAR, :NEW.CODEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALSAL', CONVERT(NUMBER_TO_CHAR, :NEW.VALSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CPLSAL', CONVERT(NUMBER_TO_CHAR, :NEW.CPLSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPSAL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPEST', CONVERT(NUMBER_TO_CHAR, :NEW.TIPEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CLASAL', :NEW.CLASAL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NIVSAL', :NEW.NIVSAL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERDES', CONVERT(NUMBER_TO_CHAR, :NEW.PERDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERREA', CONVERT(NUMBER_TO_CHAR, :NEW.PERREA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSIN', CONVERT(NUMBER_TO_CHAR, :NEW.CODSIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCRA', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONFIN', CONVERT(NUMBER_TO_CHAR, :NEW.CONFIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODVIN', CONVERT(NUMBER_TO_CHAR, :NEW.CODVIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CARVAG', :NEW.CARVAG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SOCSIN', :NEW.SOCSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ADMESO', CONVERT(NUMBER_TO_CHAR, :NEW.ADMESO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TRABHR', CONVERT(NUMBER_TO_CHAR, :NEW.TRABHR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODBHR', CONVERT(NUMBER_TO_CHAR, :NEW.CODBHR));
      END;
  END IF;   
  /* Fim - Geração de logs HistoricoFilial*/
  
  /* Pendência SAMSenior */
  IF (:NEW.STAHIS = 1) AND (:NEW.NUMEMP = :NEW.EMPATU) AND (:NEW.NUMCAD = :NEW.CADATU) THEN
    SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);

    SP_INTSTR(:NEW.NUMEMP, '9999', l_numemp_str OUT);
    l_valstr_emp := 'H' || l_idtpes || l_numemp_str;
    SP_SAM_PENDENCIES(31, 1, l_valstr_emp);

    SP_INTSTR(:NEW.CODFIL, '999999', l_codfil_str OUT);
    l_valstr_fil := 'H' || l_idtpes || l_numemp_str || l_codfil_str;
    SP_SAM_PENDENCIES(32, 1, l_valstr_fil);
  END IF;
END␀ñÔ␀␀	SENIOR;0¨␀␀

TRIGGER R038HFI_SU AFTER UPDATE ON R038HFI

DECLARE
/* CURSOR c/ os registros gravados no R038HFI_AUX */
  CURSOR c_r038hfi_upd IS SELECT NUMEMP,TIPCOL,NUMCAD,DATALT,EMPATU,CADATU,CODFIL,CODESC,STAHIS
                            FROM R038HFI_AUX WHERE TIPOPE = 2;
  TYPE t_r038HFI_aux IS RECORD(
    NUMEMP   R038HFI_AUX.NUMEMP%TYPE,
    TIPCOL   R038HFI_AUX.TIPCOL%TYPE,
    NUMCAD   R038HFI_AUX.NUMCAD%TYPE,
    DATALT   R038HFI_AUX.DATALT%TYPE,
    EMPATU   R038HFI_AUX.EMPATU%TYPE,
    CADATU   R038HFI_AUX.CADATU%TYPE,
    CODFIL   R038HFI_AUX.CODFIL%TYPE,
    CODESC   R038HFI_AUX.CODESC%TYPE,    
    STAHIS   R038HFI_AUX.STAHIS%TYPE);
  l_r038HFI_aux t_r038HFI_aux;
  
  l_online       BOOLEAN;
  
BEGIN
  /* Verifica Acesso */
  SP_VerOnLine(l_online OUT);
  
  /* Le Registro do CURSOR */
  FOREACH c_r038hfi_upd INTO  l_r038HFI_aux.NUMEMP,
                              l_r038HFI_aux.TIPCOL,
                              l_r038HFI_aux.NUMCAD,
                              l_r038HFI_aux.DATALT,
                              l_r038HFI_aux.EMPATU,
                              l_r038HFI_aux.CADATU,
                              l_r038HFI_aux.CODFIL,
                              l_r038HFI_aux.CODESC,                              
                              l_r038HFI_aux.STAHIS
  LOOP
    /* Procedure que atualiza os creditos de acesso.*/
    IF   (l_online = TRUE) AND (l_r038HFI_aux.STAHIS = 1) THEN
        SP_GerCrc('U',1,l_r038HFI_aux.NUMEMP,
                        l_r038HFI_aux.TIPCOL,
                        l_r038HFI_aux.NUMCAD,
                        l_r038HFI_aux.DATALT,
                        l_r038HFI_aux.EMPATU,
                        l_r038HFI_aux.CADATU,
                        l_r038HFI_aux.CODFIL,
                        l_r038HFI_aux.CODESC,
                        l_r038HFI_aux.STAHIS);
    
        R038HFI_CON (l_r038hfi_aux.NUMEMP, l_r038hfi_aux.TIPCOL, l_r038hfi_aux.NUMCAD, l_r038hfi_aux.DATALT);
    END IF;
  END LOOP;

  /* Apaga Registro OLD em R038HFI_AUX */
  BEGIN
    DELETE FROM R038HFI_AUX WHERE TIPOPE = 2;
    DROP_TEMP_TABLE R038HFI_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀íÔ␀␀		SENIOR;0‘x␀␀

TRIGGER R038HFI_EU AFTER UPDATE ON R038HFI FOR EACH ROW
DECLARE
l_datfil       DATE;
  l_comando_nulo BOOLEAN;
  l_online       BOOLEAN;

  l_TemPenFut    BOOLEAN;
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_AltEmp         R038PEN.ALTEMP%TYPE;
  l_AltFil         R038PEN.ALTFIL%TYPE;
  l_AltLoc         R038PEN.ALTLOC%TYPE;
  l_AltCcu         R038PEN.ALTCCU%TYPE;
  l_AltCar         R038PEN.ALTCAR%TYPE;
  l_AltEsc         R038PEN.ALTESC%TYPE;
  l_AltDes         R038PEN.ALTDES%TYPE;
  l_SitChe         R038PEN.SITCHE%TYPE;
  l_SitUsu         R038PEN.SITUSU%TYPE;
  l_NesRev         R038PEN.NESREV%TYPE;
  l_EmpAtu         R038PEN.EMPATU%TYPE;
  l_CadAtu         R038PEN.CADATU%TYPE;
  l_ColChe       BOOLEAN;
  l_ColUsu       BOOLEAN;

  l_auxNumEmp      R038PEN.NUMEMP%TYPE;
  l_auxTipCol      R038PEN.TIPCOL%TYPE;
  l_auxNumCad      R038PEN.NUMCAD%TYPE;
  l_auxSitChe      R038PEN.SITCHE%TYPE;
  l_auxSitUsu      R038PEN.SITUSU%TYPE;
  l_AssTrfEmp      R000ASS.TRFEMP%TYPE;
  l_AssTrfFil      R000ASS.TRFFIL%TYPE; 

  CURSOR C_R034USU IS SELECT CODUSU FROM R034USU
                       WHERE R034USU.NUMEMP = :NEW.EMPATU AND R034USU.TIPCOL = :NEW.TIPCOL AND R034USU.NUMCAD = :NEW.CADATU;

  TYPE t_CodUsu IS RECORD(
      CODUSU   R000USE.CODUSU%TYPE);

  l_CodUsu t_CodUsu;
  l_Alterou BOOLEAN;
  l_Valido BOOLEAN;
  l_layoutAltContratual VARCHAR2(6);
  l_JsonCamposAlterados VARCHAR2(2000);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);  
  xCodLoc 		   R016HIE.CODLOC%TYPE;

  l_idtpes       VARCHAR2(23);
  l_numemp_str   VARCHAR2(4);
  l_valstr_emp   VARCHAR2(28);
  l_codfil_str   VARCHAR2(6);
  l_valstr_fil   VARCHAR2(34);

  l_NumEmpStr VARCHAR(11);
  l_TipColStr VARCHAR(11);
  l_NumCadStr VARCHAR(11);
  l_Where VARCHAR(2000);
  l_DataZero DATE;
  l_DatIniSST DATE;
  l_DatAltProxHist DATE;
  l_IniHis DATE;
  l_FimHis DATE;
  l_infoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
    
  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HFI_AUX;
  
BEGIN
  BEGIN
    SELECT TRFEMP, TRFFIL INTO l_AssTrfEmp, l_AssTrfFil
      FROM R000ASS;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_AssTrfEmp := 0;
      l_AssTrfFil := 0;
  END;
  
  SP_VerOnLine(l_online OUT);

  IF ((l_AssTrfEmp = 2 AND (:NEW.NUMEMP <> :NEW.EMPATU)) OR (l_AssTrfFil = 2)) THEN
    /* Verifica se o colaborador está associado ao cadastro de chefia ou
       se o colaborador está associado com algum usuário */
    R038PEN_COLCHEFE(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_ColChe OUT, l_ColUsu OUT);

    /* Se o colaborador não está associado ao cadastro de Chefia e a um Usuario, verifica se
       está trocando de cadastro e deve verificar se o cadastro de origem está associado
       um usuário ou é Chefe */
    IF ((l_ColChe = FALSE) AND (l_ColUsu = FALSE)) THEN
      BEGIN
        SELECT NUMEMP, TIPCOL, NUMCAD INTO l_auxNumEmp, l_auxTipCol, l_auxNumCad
          FROM R038PEN
         WHERE EMPATU = :NEW.NUMEMP
           AND TIPCOL = :NEW.TIPCOL
           AND CADATU = :NEW.NUMCAD
           AND DATTRF = :NEW.DATALT
           AND (NUMEMP <> :NEW.NUMEMP OR NUMCAD <> :NEW.NUMCAD);
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          l_auxNumEmp := 0;
          l_auxTipCol := 0;
          l_auxNumCad := 0;
      END;

      IF (l_auxNumCad <> 0) THEN
        R038PEN_COLCHEFE(l_auxNumEmp, l_auxTipCol, l_auxNumCad, :NEW.DATALT, l_ColChe OUT, l_ColUsu OUT);
      END IF;
    END IF;

    /* Se o colaborador é chefe ou está associado a um usuário gera pendência */
    IF (l_ColChe = TRUE OR l_ColUsu = TRUE) THEN
      /* Verifica se existe pendência numa data futura */
      R038PEN_TEMPENFUT(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_TemPenFut OUT);

      /* se não existe pendência com data futura, verifica se existe pendência com data passada e situação não atendida */
      IF (l_TemPenFut = FALSE) THEN
        BEGIN
             SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU
               INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu
               FROM R038PEN
              WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                    R038PEN.TIPCOL = :NEW.TIPCOL AND
                    R038PEN.NUMCAD = :NEW.NUMCAD AND
                    R038PEN.DATTRF < :NEW.DATALT AND
                    ((R038PEN.SITCHE = 1 OR R038PEN.SITCHE = 3) AND
                     (R038PEN.SITUSU = 1 OR R038PEN.SITUSU = 4));
        EXCEPTION
             WHEN NO_DATA_FOUND THEN
                  l_NumEmp := 0;
                  l_TipCol := 0;
                  l_NumCad := 0;
                  l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
        END;

        /* Considera que sempre altera filial na inclusão do histórico de filial para criação da pendência */
        l_AltFil := 'S';

        /* Se alterou empresa indica pendência de empresa e filial */
        IF (:NEW.NUMEMP <> :NEW.EMPATU) THEN
          l_AltEmp := 'S';
        ELSE
          l_AltEmp := 'N';
        END IF;

        /* Verifica se deve gerar pendencia de chefia */
        IF (l_ColChe = TRUE) THEN
          l_SitChe := 1; /* Não Atendida */
        ELSE
          l_SitChe := 3; /* Sem necessidade de Alteração */
        END IF;

        /* Verifica se deve gerar pendencia de usuário */
        IF (l_ColUsu = TRUE) THEN
          l_SitUsu := 1; /* Não Atendida */
        ELSE
          l_SitUsu := 4; /* Sem necessidade de Alteração */
        END IF;

        /* Se existir uma pendência com data passada e situação 1 (Não atendida), esta
           será excluída e regerada com a nova data */
        IF (l_NumCad <> 0) THEN
          /* Insere nova pendência com base nos valores da pendência da data passada */
          BEGIN
            INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                         VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_AltEmp, l_AltFil, l_AltLoc, l_AltCcu, l_AltCar, l_AltEsc, l_AltDes, l_SitChe, l_SitUsu, l_NesRev, l_EmpAtu, l_CadAtu);
          EXCEPTION
            WHEN OTHERS THEN
               RAISERROR 103 'Erro ao inserir registro na R038PEN.';
          END;

          /* Deleta pendência da data passada */
          R038PEN_DELPENPAS(:NEW.NUMEMP,:NEW.TIPCOL,:NEW.NUMCAD,:NEW.DATALT);

        ELSE
          /* Verifica se existe pendência na mesma data de alteração */
          BEGIN
               SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF, SITCHE, SITUSU INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf, l_auxSitChe, l_auxSitUsu
                 FROM R038PEN
                WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                      R038PEN.TIPCOL = :NEW.TIPCOL AND
                      R038PEN.NUMCAD = :NEW.NUMCAD AND
                      R038PEN.DATTRF = :NEW.DATALT;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_NumEmp := 0;
                    l_TipCol := 0;
                    l_NumCad := 0;
                    l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
                    l_auxSitChe := 0;
                    l_auxSitUsu := 0;
          END;

          /* Se existir pendência na mesma data, atualiza a pendência */
          IF (l_NumCad <> 0) THEN

            IF ((l_auxSitChe = 1 OR l_auxSitChe = 3) AND
                (l_auxSitUsu = 1 OR l_auxSitUsu = 4)) THEN
              /* Atualiza pendência */
              BEGIN
                UPDATE R038PEN SET ALTEMP = l_AltEmp, ALTFIL = l_AltFil, SITCHE = l_SitChe, SITUSU = l_SitUsu, EMPATU = :NEW.EMPATU, CADATU = :NEW.CADATU
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;

            ELSE
              /* Se a Situação for diferente de "Não atendida" ou "Sem necessidade de alteração", então
                 indica na pendência que necessita Revisão */
              BEGIN
                UPDATE R038PEN SET ALTEMP = l_AltEmp, ALTFIL = l_AltFil, NESREV = 'S', EMPATU = :NEW.EMPATU, CADATU = :NEW.CADATU
                         WHERE R038PEN.NUMEMP = :NEW.NUMEMP AND
                               R038PEN.TIPCOL = :NEW.TIPCOL AND
                               R038PEN.NUMCAD = :NEW.NUMCAD AND
                               R038PEN.DATTRF = :NEW.DATALT;
              EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no update da Tabela R038PEN.';
              END;
            END IF;

          ELSE

            /* Insere nova pendência */
            BEGIN
              INSERT INTO R038PEN (NUMEMP, TIPCOL, NUMCAD, DATTRF, ALTEMP, ALTFIL, ALTLOC, ALTCCU, ALTCAR, ALTESC, ALTDES, SITCHE, SITUSU, NESREV, EMPATU, CADATU)
                           VALUES (:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, l_AltEmp, l_AltFil, 'N', 'N', 'N', 'N', 'N', l_SitChe, l_SitUsu, 'N', :NEW.EMPATU, :NEW.CADATU);
            EXCEPTION
              WHEN OTHERS THEN
                 RAISERROR 103 'Erro ao inserir registro na R038PEN.';
            END;

          END IF;
        END IF;
      END IF;

    END IF;
  END IF;

  /* SOMENTE ATUALIZAR O R034FUN SE NÃO MUDOU DE EMPRESA E CADASTRO */
  IF  (:NEW.STAHIS = 1)
  AND (:NEW.NUMEMP = :NEW.EMPATU)
  AND (:NEW.NUMCAD = :NEW.CADATU) THEN
      BEGIN
        SELECT R034FUN.DATFIL INTO l_datfil
          FROM R034FUN
         WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
               R034FUN.NUMEMP = :NEW.NUMEMP AND
               R034FUN.NUMCAD = :NEW.NUMCAD;
      EXCEPTION WHEN OTHERS THEN
        l_comando_nulo:=TRUE;
      END;
      IF   (:NEW.DATALT >= l_datfil)
      OR   (l_datfil IS NULL) THEN
           UPDATE R034FUN
              SET CODFIL = :NEW.CODFIL,
                  DATFIL = :NEW.DATALT,
                  CADFIL = :NEW.CADATU,
                  EMPFIL = :NEW.EMPATU,
                  CONTOV = :NEW.CONTOV,
                  TIPADM = :NEW.TIPADM
            WHERE R034FUN.TIPCOL = :NEW.TIPCOL AND
                  R034FUN.NUMEMP = :NEW.NUMEMP AND
                  R034FUN.NUMCAD = :NEW.NUMCAD;

           IF  (:OLD.FICREG <> :NEW.FICREG) AND (:NEW.FICREG <> 0) THEN
               /* ATUALIZA O COMPLEMENTO DA FICHA BÁSICA */
               BEGIN
                 UPDATE R034CPL
                    SET FICREG = :NEW.FICREG
                  WHERE R034CPL.TIPCOL = :NEW.TIPCOL AND
                        R034CPL.NUMEMP = :NEW.NUMEMP AND
                        R034CPL.NUMCAD = :NEW.NUMCAD;
               EXCEPTION WHEN OTHERS THEN
                 l_comando_nulo:=TRUE;
               END;
           END IF;
      END IF;
  END IF;

  
  IF   (l_online = TRUE) THEN
       /* Se somente mudou a filial e continua na mesta empresa */
       IF   (:NEW.CODFIL <> :OLD.CODFIL)
       AND  (:NEW.EMPATU = :OLD.EMPATU) THEN
             BEGIN
              INSERT INTO R038HFI_AUX (TIPOPE,TIPCOL,NUMEMP,NUMCAD,DATALT,EMPATU,CADATU,CODFIL,CODESC,STAHIS)
                               VALUES (2,:NEW.TIPCOL,:NEW.NUMEMP,:NEW.NUMCAD,:NEW.DATALT,:NEW.EMPATU,:NEW.CADATU,:NEW.CODFIL,:NEW.CODESC,:NEW.STAHIS);
             EXCEPTION WHEN OTHERS THEN
               RAISERROR 103 'Erro no INSERT em R038HFI_AUX.';
             END;
       END IF;
  END IF;

  /* Verifica se foi alterado alguma campo que infuencia. Campo status nao influencia. */
  IF  (:NEW.EMPATU <> :OLD.EMPATU) OR (:NEW.CODFIL <> :OLD.CODFIL) OR (:NEW.NUMLOC <> :OLD.NUMLOC) OR
      (:NEW.CADATU <> :OLD.CADATU) OR (:NEW.CODCCU <> :OLD.CODCCU) OR (:NEW.NATDES <> :OLD.NATDES) OR
      (:NEW.TIPADM <> :OLD.TIPADM) OR (:NEW.FICREG <> :OLD.FICREG) OR (:NEW.CONTOV <> :OLD.CONTOV) THEN
      BEGIN
      UPDATE R066APU SET DIAALT = 10
        WHERE NUMEMP = :NEW.NUMEMP AND
              TIPCOL = :NEW.TIPCOL AND
              NUMCAD = :NEW.NUMCAD AND
              DATAPU >= :NEW.DATALT;
      EXCEPTION WHEN OTHERS THEN
        NULL;
      END;
  END IF;

  /* Atualiza empresa ativa em históricos futuros. */
  IF  (:NEW.STAHIS = 1) AND (:NEW.NUMEMP <> :NEW.EMPATU) THEN
      FOREACH C_R034USU INTO l_CodUsu.CODUSU
      LOOP
          IF (l_CodUsu.CODUSU <> 0) THEN
              BEGIN
              UPDATE R000USE SET EMPATI = :NEW.EMPATU
			               WHERE CODUSU = l_CodUsu.CODUSU AND EMPATI = :NEW.NUMEMP;
              EXCEPTION WHEN OTHERS THEN
                  NULL;
              END;
          END IF;
      END LOOP;
  END IF;
  
  /* eSocial */
  IF (:NEW.NUMEMP = :NEW.EMPATU) AND (:NEW.NUMCAD = :NEW.CADATU) THEN
    l_Alterou := FALSE;
    l_JsonCamposAlterados := '';

    SP_VALUPDATE_NUM(:OLD.CODFIL, :NEW.CODFIL, l_Valido OUT);
    IF (l_Valido = TRUE) THEN
      l_Alterou := TRUE;
      SP_CONCAT_NUM_JSON('CODFIL', :NEW.CodFil, :OLD.CodFil, l_JsonCamposAlterados OUT);
    END IF;

    IF (l_Alterou = TRUE) THEN
      /* S-2206 - Início */
      RH_LAY_CONTR_COLAB(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, l_layoutAltContratual OUT);
      IF (l_layoutAltContratual = 'S-2206') THEN
        SP_HIST_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038HFI', 'DATALT', 'A', '', l_JsonCamposAlterados, 0, 'R038HFI_EU');
      END IF;
      /* S-2206 - Fim */
      
      /* S-2306 - S-1.2 */
      IF (l_layoutAltContratual = 'S-2306') THEN
      	l_infoFacult := TRUE;
      	l_SimplificaoESocial := FALSE;
      	l_VersaoESocial := 0;
      	SP_ESOCIAL_INFO(:NEW.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
      	IF (l_VersaoESocial >= 6) THEN
        	SP_HIST_ESOCIAL(l_layoutAltContratual, :NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.DATALT, 'R038HFI', 'DATALT', 'A', '', '', 0, 'R038HFI_EU');
      	END IF;
      END IF;
      
      /* S-2240 - Início */
      l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
	  RH_RET_DATINISST(:NEW.NumEmp, l_DatIniSST OUT);
	  
	  IF (l_DatIniSST > l_DataZero) THEN
	    IF (l_Alterou = TRUE) THEN
	      l_NumEmpStr := CONVERT(NUMBER_TO_CHAR, :NEW.NumEmp);
	      l_TipColStr := CONVERT(NUMBER_TO_CHAR, :NEW.TipCol);
	      l_NumCadStr := CONVERT(NUMBER_TO_CHAR, :NEW.NumCad);
	      l_Where := 'NUMEMP = ' || l_NumEmpStr || ' AND TIPCOL = ' || l_TipColStr || ' AND NUMCAD = ' || l_NumCadStr;
	      SP_PROXHIST_NPER('DATALT', 'R038HFI', l_Where, :NEW.DatAlt, l_DatAltProxHist OUT);
		  
		  l_IniHis := :NEW.DatAlt;
		  
		  IF (l_DatAltProxHist > l_DataZero) THEN
		    l_FimHis := DATETIMEADD(DD, -1, l_DatAltProxHist);
		  ELSE
		    l_FimHis := l_DataZero;
		  END IF;
		  
	  	  IF (l_FimHis > l_DatIniSST OR l_FimHis = l_DataZero) THEN
	  	    IF (l_IniHis < l_DatIniSST) THEN
	  		  l_IniHis := l_DatIniSST;
	  	    END IF;
		
		    SP_E_SOCIAL_SM('S-2240', 'R038HFI', 'N', 'A', l_IniHis, l_FimHis, :NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, '', l_JsonCamposAlterados, 0, NULL, l_IniHis, 0, 'R038HFI_EU');
		  END IF;
		END IF;
	  END IF;
      /* S-2240 - Fim */
    END IF;
  END IF;
  /* eSocial */
  
  /* Inicio - Geração de logs HistoricoFilial*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 76;     /* HistoricoFilial*/
  l_codtpa := 264;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.TipCol <> :NEW.TipCol)
   OR (:OLD.NumCad <> :NEW.NumCad)
   OR (:OLD.DatAlt <> :NEW.DatAlt)
   OR (:OLD.EmpAtu <> :NEW.EmpAtu)
   OR (:OLD.CodTap <> :NEW.CodTap)
   OR (:OLD.EstPos <> :NEW.EstPos)
   OR (:OLD.PosTra <> :NEW.PosTra)
   OR (:OLD.CodFil <> :NEW.CodFil)
   OR (:OLD.TabOrg <> :NEW.TabOrg)
   OR (:OLD.NumLoc <> :NEW.NumLoc)
   OR (:OLD.CadAtu <> :NEW.CadAtu)
   OR (:OLD.CodCcu <> :NEW.CodCcu)
   OR (:OLD.NatDes <> :NEW.NatDes)
   OR (:OLD.TipAdm <> :NEW.TipAdm)
   OR (:OLD.FicReg <> :NEW.FicReg)
   OR (:OLD.ConTov <> :NEW.ConTov)
   OR (:OLD.StaAcc <> :NEW.StaAcc)
   OR (:OLD.MotPos <> :NEW.MotPos)
   OR (:OLD.EstCar <> :NEW.EstCar)
   OR (:OLD.CodCar <> :NEW.CodCar)
   OR (:OLD.CodMot <> :NEW.CodMot)
   OR (:OLD.CodEsc <> :NEW.CodEsc)
   OR (:OLD.CodTma <> :NEW.CodTma)
   OR (:OLD.TurInt <> :NEW.TurInt)
   OR (:OLD.HorBas <> :NEW.HorBas)
   OR (:OLD.HorSab <> :NEW.HorSab)
   OR (:OLD.HorSem <> :NEW.HorSem)
   OR (:OLD.HorDsr <> :NEW.HorDsr)
   OR (:OLD.CodMts <> :NEW.CodMts)
   OR (:OLD.CodEst <> :NEW.CodEst)
   OR (:OLD.ValSal <> :NEW.ValSal)
   OR (:OLD.CplSal <> :NEW.CplSal)
   OR (:OLD.TipSal <> :NEW.TipSal)
   OR (:OLD.TipEst <> :NEW.TipEst)
   OR (:OLD.ClaSal <> :NEW.ClaSal)
   OR (:OLD.NivSal <> :NEW.NivSal)
   OR (:OLD.PerDes <> :NEW.PerDes)
   OR (:OLD.PerRea <> :NEW.PerRea)
   OR (:OLD.CodSin <> :NEW.CodSin)
   OR (:OLD.NumCra <> :NEW.NumCra)
   OR (:OLD.StaHis <> :NEW.StaHis)
   OR (:OLD.ConFin <> :NEW.ConFin)
   OR (:OLD.CodVin <> :NEW.CodVin)
   OR (:OLD.CarVag <> :NEW.CarVag)
   OR (:OLD.SocSin <> :NEW.SocSin)
   OR (:OLD.AdmEso <> :NEW.AdmEso)
   OR (:OLD.TraBHr <> :NEW.TraBHr)
   OR (:OLD.CodBHr <> :NEW.CodBHr)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HFI_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HFI_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDEMPATU', CONVERT(NUMBER_TO_CHAR, :OLD.EMPATU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWEMPATU', CONVERT(NUMBER_TO_CHAR, :NEW.EMPATU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODTAP', CONVERT(NUMBER_TO_CHAR, :OLD.CODTAP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODTAP', CONVERT(NUMBER_TO_CHAR, :NEW.CODTAP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDESTPOS', CONVERT(NUMBER_TO_CHAR, :OLD.ESTPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWESTPOS', CONVERT(NUMBER_TO_CHAR, :NEW.ESTPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPOSTRA', :OLD.POSTRA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPOSTRA', :NEW.POSTRA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTABORG', CONVERT(NUMBER_TO_CHAR, :OLD.TABORG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTABORG', CONVERT(NUMBER_TO_CHAR, :NEW.TABORG));
        RH_RET_CODLOC(:OLD.TABORG,:OLD.NUMLOC,:OLD.DATALT, xCodLoc OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMLOC', xCodLoc);
        RH_RET_CODLOC(:NEW.TABORG,:NEW.NUMLOC,:NEW.DATALT, xCodLoc OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMLOC', xCodLoc);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCADATU', CONVERT(NUMBER_TO_CHAR, :OLD.CADATU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCADATU', CONVERT(NUMBER_TO_CHAR, :NEW.CADATU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCCU', :OLD.CODCCU);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCCU', :NEW.CODCCU);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNATDES', CONVERT(NUMBER_TO_CHAR, :OLD.NATDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNATDES', CONVERT(NUMBER_TO_CHAR, :NEW.NATDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPADM', CONVERT(NUMBER_TO_CHAR, :OLD.TIPADM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPADM', CONVERT(NUMBER_TO_CHAR, :NEW.TIPADM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFICREG', CONVERT(NUMBER_TO_CHAR, :OLD.FICREG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFICREG', CONVERT(NUMBER_TO_CHAR, :NEW.FICREG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONTOV', :OLD.CONTOV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONTOV', :NEW.CONTOV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSTAACC', CONVERT(NUMBER_TO_CHAR, :OLD.STAACC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSTAACC', CONVERT(NUMBER_TO_CHAR, :NEW.STAACC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDMOTPOS', CONVERT(NUMBER_TO_CHAR, :OLD.MOTPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWMOTPOS', CONVERT(NUMBER_TO_CHAR, :NEW.MOTPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDESTCAR', CONVERT(NUMBER_TO_CHAR, :OLD.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWESTCAR', CONVERT(NUMBER_TO_CHAR, :NEW.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODCAR', :OLD.CODCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODCAR', :NEW.CODCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODMOT', CONVERT(NUMBER_TO_CHAR, :OLD.CODMOT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODMOT', CONVERT(NUMBER_TO_CHAR, :NEW.CODMOT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODESC', CONVERT(NUMBER_TO_CHAR, :OLD.CODESC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODESC', CONVERT(NUMBER_TO_CHAR, :NEW.CODESC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODTMA', CONVERT(NUMBER_TO_CHAR, :OLD.CODTMA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODTMA', CONVERT(NUMBER_TO_CHAR, :NEW.CODTMA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTURINT', CONVERT(NUMBER_TO_CHAR, :OLD.TURINT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTURINT', CONVERT(NUMBER_TO_CHAR, :NEW.TURINT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORBAS', CONVERT(NUMBER_TO_CHAR, :OLD.HORBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORBAS', CONVERT(NUMBER_TO_CHAR, :NEW.HORBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORSAB', CONVERT(NUMBER_TO_CHAR, :OLD.HORSAB));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORSAB', CONVERT(NUMBER_TO_CHAR, :NEW.HORSAB));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORSEM', CONVERT(NUMBER_TO_CHAR, :OLD.HORSEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORSEM', CONVERT(NUMBER_TO_CHAR, :NEW.HORSEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORDSR', CONVERT(NUMBER_TO_CHAR, :OLD.HORDSR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORDSR', CONVERT(NUMBER_TO_CHAR, :NEW.HORDSR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODMTS', CONVERT(NUMBER_TO_CHAR, :OLD.CODMTS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODMTS', CONVERT(NUMBER_TO_CHAR, :NEW.CODMTS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODEST', CONVERT(NUMBER_TO_CHAR, :OLD.CODEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODEST', CONVERT(NUMBER_TO_CHAR, :NEW.CODEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDVALSAL', CONVERT(NUMBER_TO_CHAR, :OLD.VALSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWVALSAL', CONVERT(NUMBER_TO_CHAR, :NEW.VALSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCPLSAL', CONVERT(NUMBER_TO_CHAR, :OLD.CPLSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCPLSAL', CONVERT(NUMBER_TO_CHAR, :NEW.CPLSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPSAL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPSAL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPEST', CONVERT(NUMBER_TO_CHAR, :OLD.TIPEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPEST', CONVERT(NUMBER_TO_CHAR, :NEW.TIPEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCLASAL', :OLD.CLASAL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCLASAL', :NEW.CLASAL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNIVSAL', :OLD.NIVSAL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNIVSAL', :NEW.NIVSAL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERDES', CONVERT(NUMBER_TO_CHAR, :OLD.PERDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERDES', CONVERT(NUMBER_TO_CHAR, :NEW.PERDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPERREA', CONVERT(NUMBER_TO_CHAR, :OLD.PERREA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPERREA', CONVERT(NUMBER_TO_CHAR, :NEW.PERREA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODSIN', CONVERT(NUMBER_TO_CHAR, :OLD.CODSIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODSIN', CONVERT(NUMBER_TO_CHAR, :NEW.CODSIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMCRA', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMCRA', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSTAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSTAHIS', CONVERT(NUMBER_TO_CHAR, :NEW.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCONFIN', CONVERT(NUMBER_TO_CHAR, :OLD.CONFIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCONFIN', CONVERT(NUMBER_TO_CHAR, :NEW.CONFIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODVIN', CONVERT(NUMBER_TO_CHAR, :OLD.CODVIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODVIN', CONVERT(NUMBER_TO_CHAR, :NEW.CODVIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCARVAG', :OLD.CARVAG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCARVAG', :NEW.CARVAG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSOCSIN', :OLD.SOCSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSOCSIN', :NEW.SOCSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDADMESO', CONVERT(NUMBER_TO_CHAR, :OLD.ADMESO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWADMESO', CONVERT(NUMBER_TO_CHAR, :NEW.ADMESO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTRABHR', CONVERT(NUMBER_TO_CHAR, :OLD.TRABHR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTRABHR', CONVERT(NUMBER_TO_CHAR, :NEW.TRABHR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODBHR', CONVERT(NUMBER_TO_CHAR, :OLD.CODBHR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODBHR', CONVERT(NUMBER_TO_CHAR, :NEW.CODBHR));
      END;
    END IF; 
  END IF; 
  /* Fim - Geração de logs HistoricoFilial*/

  /* Pendência SAMSenior */
  IF (:NEW.STAHIS = 1) THEN
    IF (:OLD.STAHIS = 0) THEN 
      SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);

      SP_INTSTR(:NEW.NUMEMP, '9999', l_numemp_str OUT);
      l_valstr_emp := 'H' || l_idtpes || l_numemp_str;
      SP_SAM_PENDENCIES(31, 1, l_valstr_emp);

      SP_INTSTR(:NEW.CODFIL, '999999', l_codfil_str OUT);
      l_valstr_fil := 'H' || l_idtpes || l_numemp_str || l_codfil_str;
      SP_SAM_PENDENCIES(32, 1, l_valstr_fil);
    ELSE
      /* Pendência SAMSenior - Alteração apenas no código da filial */
      IF (:NEW.CODFIL <> :OLD.CODFIL) THEN
        SP_RETIDTPES(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);

        SP_INTSTR(:NEW.NUMEMP, '9999', l_numemp_str OUT);
        SP_INTSTR(:NEW.CODFIL, '999999', l_codfil_str OUT);
        l_valstr_fil := 'H' || l_idtpes || l_numemp_str || l_codfil_str;
        SP_SAM_PENDENCIES(32, 1, l_valstr_fil);  
      END IF;
    END IF;
  END IF;
END␀ïÔ␀␀	SENIOR;0‘␀␀

TRIGGER R038HFI_SD AFTER DELETE ON R038HFI

DECLARE
l_codfil       NUMBER;
  l_ultdat       DATE;
  l_cadatu       NUMBER(10);
  l_empatu       NUMBER(4);
  l_contov       VARCHAR2(1);
  l_tipadm       NUMBER(1);

  l_idtpes       VARCHAR2(23);
  l_numemp_str   VARCHAR2(4);
  l_valstr_emp   VARCHAR2(28);
  l_codfil_str   VARCHAR2(6);
  l_valstr_fil   VARCHAR2(34);

  /* CURSOR c/ os registros gravados no R038HFI_AUX */
  CURSOR c_r038hfi_del IS SELECT NUMEMP,TIPCOL,NUMCAD,DATALT,EMPATU,CADATU,CODFIL,CODESC,STAHIS
                            FROM R038HFI_AUX WHERE TIPOPE = 3;
  TYPE t_r038HFI_aux IS RECORD(
    NUMEMP   R038HFI_AUX.NUMEMP%TYPE,
    TIPCOL   R038HFI_AUX.TIPCOL%TYPE,
    NUMCAD   R038HFI_AUX.NUMCAD%TYPE,
    DATALT   R038HFI_AUX.DATALT%TYPE,
    EMPATU   R038HFI_AUX.EMPATU%TYPE,
    CADATU   R038HFI_AUX.CADATU%TYPE,
    CODFIL   R038HFI_AUX.CODFIL%TYPE,
    CODESC   R038HFI_AUX.CODESC%TYPE,    
    STAHIS   R038HFI_AUX.STAHIS%TYPE);
  l_r038HFI_aux t_r038HFI_aux;
  l_online       BOOLEAN;

BEGIN
  SP_VerOnLine(l_online OUT);
  
  /* Le Registro do CURSOR */
  FOREACH c_r038hfi_del INTO  l_r038HFI_aux.NUMEMP,
                              l_r038HFI_aux.TIPCOL,
                              l_r038HFI_aux.NUMCAD,
                              l_r038HFI_aux.DATALT,
                              l_r038HFI_aux.EMPATU,
                              l_r038HFI_aux.CADATU,
                              l_r038HFI_aux.CODFIL,
                              l_r038HFI_aux.CODESC,                              
                              l_r038HFI_aux.STAHIS
  LOOP
    /* Pega o historico anterior cuja empresa destino for igual a atual*/
    BEGIN
      SELECT A.CODFIL,A.DATALT,A.CADATU,A.EMPATU,A.CONTOV,A.TIPADM
      INTO l_codfil,l_ultdat,l_cadatu,l_empatu,l_contov,l_tipadm
      FROM R038HFI A
      WHERE A.NUMEMP = l_r038hfi_aux.NUMEMP
      AND   A.TIPCOL = l_r038hfi_aux.TIPCOL
      AND   A.NUMCAD = l_r038hfi_aux.NUMCAD
      AND   A.EMPATU = A.NUMEMP
      AND   A.CADATU = A.NUMCAD
      AND   A.STAHIS = 1
      AND DATALT IN (SELECT MAX(DATALT) FROM R038HFI
                     WHERE NUMEMP = l_r038hfi_aux.NUMEMP
                     AND   TIPCOL = l_r038hfi_aux.TIPCOL
                     AND   NUMCAD = l_r038hfi_aux.NUMCAD
                     AND   EMPATU = NUMEMP
                     AND   CADATU = NUMCAD
                     AND   STAHIS = 1);
    EXCEPTION
      WHEN TOO_MANY_ROWS THEN
        RAISERROR 103 'Erro em R038HFI - TOO MANY ROWS';
      WHEN NO_DATA_FOUND THEN
        l_codfil:=0;
        l_ultdat:=DATETIME(31, 12, 1900, 0, 0, 0);
        l_cadatu:=0;
        l_empatu:=0;
        l_contov:='';
        l_tipadm:=0;
      WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT R038HFI';
    END;
   /* Atualiza tabela de colaboradores */
    IF  l_codfil <> 0 THEN
        BEGIN
          UPDATE R034FUN
             SET CODFIL = l_codfil,
                 DATFIL = l_ultdat,
                 CADFIL = l_cadatu,
                 EMPFIL = l_empatu,
                 CONTOV = l_contov,
                 TIPADM = l_tipadm
           WHERE R034FUN.TIPCOL = l_r038hfi_aux.TIPCOL AND
                 R034FUN.NUMEMP = l_r038hfi_aux.NUMEMP AND
                 R034FUN.NUMCAD = l_r038hfi_aux.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro Na Atualização do R034FUN';
        END;

        /* Pendência SAMSenior */
        SP_RETIDTPES(l_r038hfi_aux.NUMEMP, l_r038hfi_aux.TIPCOL, l_r038hfi_aux.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);

        SP_INTSTR(l_r038hfi_aux.NUMEMP, '9999', l_numemp_str OUT);
        l_valstr_emp := 'H' || l_idtpes || l_numemp_str;
        SP_SAM_PENDENCIES(31, 1, l_valstr_emp);

        SP_INTSTR(l_r038HFI_aux.CODFIL, '999999', l_codfil_str OUT);
        l_valstr_fil := 'H' || l_idtpes || l_numemp_str || l_codfil_str;
        SP_SAM_PENDENCIES(32, 1, l_valstr_fil);
    ELSE
        /* Se l_CodFil = 0, ou seja se estiver deletando o último histórico atualiza somente o DatFil */
        /* ISto é usado quando se altera a data de admissão do colaborador */
        BEGIN
          UPDATE R034FUN
             SET DATFIL = DATETIME(31,12,1900,0,0,0)
           WHERE R034FUN.TIPCOL = l_r038hfi_aux.TIPCOL AND
                 R034FUN.NUMEMP = l_r038hfi_aux.NUMEMP AND
                 R034FUN.NUMCAD = l_r038hfi_aux.NUMCAD;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro Na Atualização do R034FUN';
        END;
    END IF;

    IF   (l_online = TRUE) AND (l_r038HFI_aux.STAHIS = 1) THEN
        /* Procedure que atualiza os creditos de acesso.*/
        SP_GerCrc('D',1,l_r038HFI_aux.NUMEMP,
                        l_r038HFI_aux.TIPCOL,
                        l_r038HFI_aux.NUMCAD,
                        l_r038HFI_aux.DATALT,
                        l_r038HFI_aux.EMPATU,
                        l_r038HFI_aux.CADATU,
                        l_r038HFI_aux.CODFIL,
                        l_r038HFI_aux.CODESC,
                        l_r038HFI_aux.STAHIS);

        IF  (l_codfil <> 0) THEN
            R038HFI_CON (l_r038hfi_aux.NUMEMP, l_r038hfi_aux.TIPCOL, l_r038hfi_aux.NUMCAD, l_ultdat);
        END IF;
    END IF;

    /* Atualiza o Quadro Efetivo - QL */
    QL_EXCFILIAL(l_r038hfi_aux.NumEmp, l_r038hfi_aux.TipCol, l_r038HFI_aux.NumCad, l_r038HFI_aux.DatAlt, l_r038HFI_aux.EmpAtu, l_r038HFI_aux.CodFil, l_r038HFI_aux.DatAlt, l_r038HFI_aux.EmpAtu, l_r038HFI_aux.CodFil);
  END LOOP;

  /* Apaga Registro OLD em R038HFI_AUX */
  BEGIN
    DELETE FROM R038HFI_AUX WHERE TIPOPE = 3;
    DROP_TEMP_TABLE R038HFI_AUX;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;
END␀ëÔ␀␀		SENIOR;0w7␀␀

TRIGGER R038HFI_ED AFTER DELETE ON R038HFI FOR EACH ROW
DECLARE
  l_codfil       NUMBER;
  l_datfil       DATE;
  l_cadfil       NUMBER(10);
  l_empfil       NUMBER;
  l_contov       VARCHAR2(1);
  l_comando_nulo BOOLEAN;
  l_jaincluiu    BOOLEAN;
  l_NumEmp         R038PEN.NUMEMP%TYPE;
  l_TipCol         R038PEN.TIPCOL%TYPE;
  l_NumCad         R038PEN.NUMCAD%TYPE;
  l_DatTrf         R038PEN.DATTRF%TYPE;
  l_layoutAltContratual VARCHAR2(6);
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);  
  xCodLoc 		   R016HIE.CODLOC%TYPE;

  l_idtpes       VARCHAR2(23);
  l_numemp_str   VARCHAR2(4);
  l_valstr_emp   VARCHAR2(28);
  l_codfil_str   VARCHAR2(6);
  l_valstr_fil   VARCHAR2(34);

  l_NumEmpStr VARCHAR(11);
  l_TipColStr VARCHAR(11);
  l_NumCadStr VARCHAR(11);
  l_Where VARCHAR(2000);
  l_DataZero DATE;
  l_DatIniSST DATE;
  l_DatAltProxHist DATE;
  l_IniHis DATE;
  l_FimHis DATE;
  l_infoFacult BOOLEAN;
  l_SimplificaoESocial BOOLEAN;
  l_VersaoESocial NUMBER;
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R038HFI_AUX;
  
BEGIN
  /* Verifica se existe pendência gerada exclusivamente pelo histórico de Empresa\\\\Filial para o
     cadastro de origem que está sendo excluído */
  BEGIN
       SELECT NUMEMP, TIPCOL, NUMCAD, DATTRF INTO l_NumEmp, l_TipCol, l_NumCad, l_DatTrf
         FROM R038PEN
        WHERE R038PEN.NUMEMP = :OLD.NUMEMP AND
              R038PEN.TIPCOL = :OLD.TIPCOL AND
              R038PEN.NUMCAD = :OLD.NUMCAD AND
              R038PEN.DATTRF = :OLD.DATALT AND
             (R038PEN.ALTEMP = 'S' OR R038PEN.ALTFIL = 'S') AND
              R038PEN.ALTLOC = 'N' AND R038PEN.ALTCCU = 'N' AND
              R038PEN.ALTCAR = 'N' AND R038PEN.ALTESC = 'N' AND
              R038PEN.ALTDES = 'N';
  EXCEPTION
       WHEN NO_DATA_FOUND THEN
            l_NumEmp := 0;
            l_TipCol := 0;
            l_NumCad := 0;
            l_DatTrf := DATETIME(31, 12, 1900, 0, 0, 0);
  END;

  /* Se existe pendência exclusiva do histórico de empresa/filial para o cadastro de origem
     verifica se já foi atendida para então excluir */
  IF (l_NumCad <> 0) THEN
    R038PEN_DELPEN(l_NumEmp, l_TipCol, l_NumCad, l_DatTrf);
  ELSE
    /* Atualiza pendência da empresa e da filial com 'N' */
    BEGIN
      UPDATE R038PEN SET ALTEMP = 'N', ALTFIL = 'N', EMPATU = 0, CADATU = 0
               WHERE R038PEN.NUMEMP = :OLD.NUMEMP AND
                     R038PEN.TIPCOL = :OLD.TIPCOL AND
                     R038PEN.NUMCAD = :OLD.NUMCAD AND
                     R038PEN.DATTRF = :OLD.DATALT;
    EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no update da Tabela R038PEN.';
    END;
  END IF;

  l_jaincluiu := FALSE;
  IF  :OLD.STAHIS = 1 THEN
      l_comando_nulo:=FALSE;
      BEGIN
        SELECT R034FUN.CODFIL, R034FUN.DATFIL, R034FUN.CADFIL, R034FUN.EMPFIL, R034FUN.CONTOV
          INTO l_codfil,l_datfil,l_cadfil,l_empfil,l_contov
          FROM R034FUN
         WHERE R034FUN.TIPCOL = :OLD.TIPCOL AND
               R034FUN.NUMEMP = :OLD.NUMEMP AND
               R034FUN.NUMCAD = :OLD.NUMCAD;
      EXCEPTION WHEN OTHERS THEN
          l_comando_nulo:=TRUE;
      END;
      IF   (l_comando_nulo = FALSE) THEN
           IF   ((:OLD.CODFIL = l_codfil) OR ((:OLD.CODFIL IS NULL) AND (l_codfil IS NULL)))
           AND  ((:OLD.DATALT = l_datfil) OR ((:OLD.DATALT IS NULL) AND (l_datfil IS NULL)))
           AND  ((:OLD.CADATU = l_cadfil) OR ((:OLD.CADATU IS NULL) AND (l_cadfil IS NULL)))
           AND  ((:OLD.EMPATU = l_empfil) OR ((:OLD.EMPATU IS NULL) AND (l_empfil IS NULL)))
           AND  ((:OLD.CONTOV = l_contov) OR ((:OLD.CONTOV IS NULL) AND (l_contov IS NULL))) THEN
                BEGIN
                /* Insere Registro Old */
                  INSERT INTO R038HFI_AUX (TIPOPE,TIPCOL,NUMEMP,NUMCAD,DATALT,EMPATU,CADATU,CODFIL,CODESC,STAHIS)
                                   VALUES (3,:OLD.TIPCOL,:OLD.NUMEMP,:OLD.NUMCAD,:OLD.DATALT,:OLD.EMPATU,:OLD.CADATU,:OLD.CODFIL,:OLD.CODESC,:OLD.STAHIS);
                EXCEPTION WHEN OTHERS THEN
                  RAISERROR 103 'Erro no INSERT em R038HFI_AUX.';
                END;
                l_jaincluiu := TRUE;
           END IF;
      END IF;
  END IF;

  IF  (l_jaincluiu = FALSE)  THEN
       BEGIN
       /* Insere Registro Old */
         INSERT INTO R038HFI_AUX (TIPOPE,TIPCOL,NUMEMP,NUMCAD,DATALT,EMPATU,CADATU,CODFIL,CODESC,STAHIS)
                          VALUES (3,:OLD.TIPCOL,:OLD.NUMEMP,:OLD.NUMCAD,:OLD.DATALT,:OLD.EMPATU,:OLD.CADATU,:OLD.CODFIL,:OLD.CODESC,:OLD.STAHIS);
       EXCEPTION WHEN OTHERS THEN
         RAISERROR 103 'Erro no INSERT em R038HFI_AUX.';
       END;
  END IF;

  BEGIN
    UPDATE R066APU SET DIAALT = 10
           WHERE NUMEMP = :OLD.NUMEMP AND
                 TIPCOL = :OLD.TIPCOL AND
                 NUMCAD = :OLD.NUMCAD AND
                 DATAPU >= :OLD.DATALT;
    EXCEPTION WHEN OTHERS THEN
      NULL;
  END;

  /* eSocial */ 
  IF (:OLD.NUMEMP = :OLD.EMPATU) AND (:OLD.NUMCAD = :OLD.CADATU) THEN
    RH_LAY_CONTR_COLAB(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, l_layoutAltContratual OUT);
    IF (l_layoutAltContratual = 'S-2206') THEN
      SP_HIST_ESOCIAL(l_layoutAltContratual, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, 'R038HFI', 'DATALT', 'E', '', '', 0, 'R038HFI_ED');
    END IF;
    /* S-2306 - S-1.2 */
    IF (l_layoutAltContratual = 'S-2306') THEN
    	l_infoFacult := TRUE;
    	l_SimplificaoESocial := FALSE;
    	l_VersaoESocial := 0;
    	SP_ESOCIAL_INFO(:OLD.NUMEMP, l_infoFacult OUT, l_SimplificaoESocial OUT, l_VersaoESocial OUT);
    	IF (l_VersaoESocial >= 6) THEN
      		SP_HIST_ESOCIAL(l_layoutAltContratual, :OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, :OLD.DATALT, 'R038HFI', 'DATALT', 'E', '', '', 0, 'R038HFI_ED');
    	END IF;
    END IF;
  END IF;
  /* eSocial */
  
  /* eSocial - S-2240 - Início */
  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  RH_RET_DATINISST(:OLD.NumEmp, l_DatIniSST OUT);
  
  IF (l_DatIniSST > l_DataZero) THEN
    l_NumEmpStr := CONVERT(NUMBER_TO_CHAR, :OLD.NumEmp);
  	l_TipColStr := CONVERT(NUMBER_TO_CHAR, :OLD.TipCol);
  	l_NumCadStr := CONVERT(NUMBER_TO_CHAR, :OLD.NumCad);
  	l_Where := 'NUMEMP = ' || l_NumEmpStr || ' AND TIPCOL = ' || l_TipColStr || ' AND NUMCAD = ' || l_NumCadStr;
  	SP_PROXHIST_NPER('DATALT', 'R038HFI', l_Where, :OLD.DatAlt, l_DatAltProxHist OUT);
  	
  	l_IniHis := :OLD.DatAlt;
  	
  	IF (l_DatAltProxHist > l_DataZero) THEN
  	  l_FimHis := DATETIMEADD(DD, -1, l_DatAltProxHist);
  	ELSE
  	  l_FimHis := l_DataZero;
  	END IF;
  	
  	IF (l_FimHis > l_DatIniSST OR l_FimHis = l_DataZero) THEN
  	  IF (l_IniHis < l_DatIniSST) THEN
  		l_IniHis := l_DatIniSST;
  	  END IF;
  
  	  SP_E_SOCIAL_SM('S-2240', 'R038HFI', 'N', 'E', l_IniHis, l_FimHis, :OLD.NumEmp, :OLD.TipCol, :OLD.NumCad, '', '', 0, NULL, l_IniHis, 0, 'R038HFI_ED');
  	END IF;
  END IF;
  /* eSocial - S-2240 - Fim */
  
  /* Inicio - Geração de logs HistoricoFilial*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 76;     /* HistoricoFilial*/
  l_codtpa := 263;
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);   

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R038HFI_ED', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        SP_DATSTR(:OLD.DATALT, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATALT', l_datTemp);
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R038HFI_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'EMPATU', CONVERT(NUMBER_TO_CHAR, :OLD.EMPATU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTAP', CONVERT(NUMBER_TO_CHAR, :OLD.CODTAP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTPOS', CONVERT(NUMBER_TO_CHAR, :OLD.ESTPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSTRA', :OLD.POSTRA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TABORG', CONVERT(NUMBER_TO_CHAR, :OLD.TABORG));
        RH_RET_CODLOC(:OLD.TABORG,:OLD.NUMLOC,:OLD.DATALT, xCodLoc OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMLOC', xCodLoc);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CADATU', CONVERT(NUMBER_TO_CHAR, :OLD.CADATU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCCU', :OLD.CODCCU);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NATDES', CONVERT(NUMBER_TO_CHAR, :OLD.NATDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPADM', CONVERT(NUMBER_TO_CHAR, :OLD.TIPADM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FICREG', CONVERT(NUMBER_TO_CHAR, :OLD.FICREG));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONTOV', :OLD.CONTOV);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAACC', CONVERT(NUMBER_TO_CHAR, :OLD.STAACC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'MOTPOS', CONVERT(NUMBER_TO_CHAR, :OLD.MOTPOS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ESTCAR', CONVERT(NUMBER_TO_CHAR, :OLD.ESTCAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODCAR', :OLD.CODCAR);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODMOT', CONVERT(NUMBER_TO_CHAR, :OLD.CODMOT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODESC', CONVERT(NUMBER_TO_CHAR, :OLD.CODESC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODTMA', CONVERT(NUMBER_TO_CHAR, :OLD.CODTMA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TURINT', CONVERT(NUMBER_TO_CHAR, :OLD.TURINT));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORBAS', CONVERT(NUMBER_TO_CHAR, :OLD.HORBAS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORSAB', CONVERT(NUMBER_TO_CHAR, :OLD.HORSAB));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORSEM', CONVERT(NUMBER_TO_CHAR, :OLD.HORSEM));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORDSR', CONVERT(NUMBER_TO_CHAR, :OLD.HORDSR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODMTS', CONVERT(NUMBER_TO_CHAR, :OLD.CODMTS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODEST', CONVERT(NUMBER_TO_CHAR, :OLD.CODEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'VALSAL', CONVERT(NUMBER_TO_CHAR, :OLD.VALSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CPLSAL', CONVERT(NUMBER_TO_CHAR, :OLD.CPLSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPSAL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPSAL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPEST', CONVERT(NUMBER_TO_CHAR, :OLD.TIPEST));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CLASAL', :OLD.CLASAL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NIVSAL', :OLD.NIVSAL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERDES', CONVERT(NUMBER_TO_CHAR, :OLD.PERDES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PERREA', CONVERT(NUMBER_TO_CHAR, :OLD.PERREA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODSIN', CONVERT(NUMBER_TO_CHAR, :OLD.CODSIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCRA', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCRA));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'STAHIS', CONVERT(NUMBER_TO_CHAR, :OLD.STAHIS));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CONFIN', CONVERT(NUMBER_TO_CHAR, :OLD.CONFIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODVIN', CONVERT(NUMBER_TO_CHAR, :OLD.CODVIN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CARVAG', :OLD.CARVAG);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SOCSIN', :OLD.SOCSIN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ADMESO', CONVERT(NUMBER_TO_CHAR, :OLD.ADMESO));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TRABHR', CONVERT(NUMBER_TO_CHAR, :OLD.TRABHR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODBHR', CONVERT(NUMBER_TO_CHAR, :OLD.CODBHR));
      END;
  END IF; 
  /* Fim - Geração de logs HistoricoFilial*/ 

  /* Pendência SAMSenior */
  IF (:OLD.STAHIS = 1) THEN
    SP_RETIDTPES(:OLD.NUMEMP, :OLD.TIPCOL, :OLD.NUMCAD, NULL, NULL, NULL, NULL, l_idtpes OUT);

    SP_INTSTR(:OLD.NUMEMP, '9999', l_numemp_str OUT);
    l_valstr_emp := 'H' || l_idtpes || l_numemp_str;
    SP_SAM_PENDENCIES(31, 3, l_valstr_emp);

    SP_INTSTR(:OLD.CODFIL, '999999', l_codfil_str OUT);
    l_valstr_fil := 'H' || l_idtpes || l_numemp_str || l_codfil_str;
    SP_SAM_PENDENCIES(32, 3, l_valstr_fil);
  END IF;
END␀␀␀Šv␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀éÔ␀␀…¬␀␀´␀Ôÿ1␀␀␀␀␀‘<XbXbr␀Æÿ␀␀ÿ␀.␀tÔÿ1␀␀␀␀␀Ü␀t␀Ü␀n ˆ␀Æÿ␀␀ÿ␀c¬␀␀Ì␀Ôÿ1␀␀␀␀␀.%0.0.wˆ␀Æÿ␀␀ÿ␀mDÑ␀Ôÿ1␀␀␀␀␀AIşEşEqCˆ␀êÿ␀␀ÿ␀Ëa´␀Ôÿ1␀␀␀␀␀\=¾«␀␀¾«␀␀rˆ␀Æÿ␀␀ÿ␀—,¼␀Ôÿ1␀␀␀␀␀^=Ä«␀␀Ä«␀␀X)␀ˆ␀Æÿ␀␀!#␀y,Ì␀Ôÿ1␀␀␀␀␀]=À«␀␀À«␀␀)␀ˆ␀Æÿ␀␀ÀÎ␀␀␀Ş␀´␀Ôÿ1␀␀␀␀␀>½␀␀r␀Æÿ␀␀YĞ␀␀␀§¬␀␀Ì␀Ôÿ1␀␀␀␀␀Úš␀␀€š␀␀€š␀␀m␀Æÿ␀␀ÿ␀9$Ì␀Ôÿ1␀␀␀␀␀␀AÕ«␀␀Õ«␀␀wˆ␀Æÿ␀␀ÿ␀:,Ôÿ1␀␀␀␀␀AÓ«␀␀Ó«␀␀b␀ˆ␀␀ÿ␀␀)`␀9¦␀␀±␀Ôÿ1␀␀␀␀␀Ê«␀␀È«␀␀É«␀␀qˆ␀Æÿ␀␀ÿ␀å␀3Ôÿ1␀␀␀␀␀␀…␀…␀p␀Æÿ␀␀ÿ␀¥m¼␀Ôÿ1␀␀␀␀␀
