ñ␀␀PROCEDURE SP_DELINSCRA70ACR(P_TIPOPE VARCHAR2(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1),P_REMREP NUMBER(1),P_TIPLIS NUMBER(2),P_OLDPRM NUMBER(5),P_OLDSAB NUMBER(5),P_OLDDOM NUMBER(5),P_OLDFER NUMBER(5),P_OLDRT1 NUMBER(5),P_OLDRT2 NUMBER(5),P_OLDRT3 NUMBER(5),P_NUMCPF NUMBER(11))
 IS
BEGIN
  NULL;
END		SENIOR;20JSP_DATSTR
SP_INTSTR
SP_PESFROMIDTPES
SP_RETCRA
SP_MAPFIS
SP_R070ACR
şI␀␀PROCEDURE SP_DELINSCRA70ACR(P_TIPOPE VARCHAR2(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1),P_REMREP NUMBER(1),P_TIPLIS NUMBER(2),P_OLDPRM NUMBER(5),P_OLDSAB NUMBER(5),P_OLDDOM NUMBER(5),P_OLDFER NUMBER(5),P_OLDRT1 NUMBER(5),P_OLDRT2 NUMBER(5),P_OLDRT3 NUMBER(5),P_NUMCPF NUMBER(11))
 IS

l_datatu_cra     DATE;
  l_horatu_cra     NUMBER(4);
  l_datstr_cra     CHAR(6);
  l_horstr_cra     CHAR(4);
  l_seqenv_cra     NUMBER(2);
  l_seqstr_cra     CHAR(2);
  l_datatustr_cra  CHAR(16);  
  l_cratit         NUMBER(12);
  l_numbar         NUMBER(12);
  l_numpro         NUMBER(12);
  l_numsma         NUMBER(12);
  l_tecpri         NUMBER(1);
  l_crapri         NUMBER(12);
  l_crapro         NUMBER(12);  
  l_tippes         NUMBER(2);
  l_numemp         NUMBER(4);
  l_tipcol         NUMBER(1);
  l_numcad         NUMBER(9);
  l_tipdoc         NUMBER(1);
  l_numdoc         VARCHAR2(20);
  l_nummat         VARCHAR2(15);
  l_propac         VARCHAR2(20);
  l_count          NUMBER(9);
  l_pltrlg         VARCHAR2(32000);
  l_prmlst         VARCHAR2(32000);
  l_prmdel         NUMBER(5);

  /*CURSOR para trazer os dispositivos das permissões, isto para que não seja enviado mais de um comando de DELETE para o mesmo dispositivo*/
  CURSOR c_r058rlp IS
  SELECT DISTINCT A.CODPRM, A.CODPLT, A.CODRLG FROM R058RLP A, R058RLG B, R058MOD C WHERE A.CODPRM IN (p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3) AND B.MODRLG = C.MODRLG AND C.CLAMOD = 13
  UNION  /*GRUPO*/
  (SELECT DISTINCT D.CODPRM, E.CODPLT, E.CODRLG FROM R058GRP D, R058GRL E, R058RLG F, R058MOD G WHERE D.CODPRM IN (p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3) AND D.CODGRR = E.CODGRR AND E.CODRLG = F.CODRLG AND F.MODRLG = G.MODRLG AND G.CLAMOD = 13);
  TYPE t_r058rlp IS RECORD(
    CODPRM   R058RLP.CODPRM%TYPE,
    CODPLT   R058RLP.CODPLT%TYPE,
    CODRLG   R058RLP.CODRLG%TYPE);
  l_r058rlp t_r058rlp;
  
BEGIN
  IF (p_tipope = 'A' OR p_tipope = 'H' OR p_tipope = 'I') THEN
      BEGIN
          SELECT COUNT(B.NUMEIP) INTO l_count
                 FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F
                 WHERE
                 A.CODPRM  IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
                 A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
                 B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
                 D.CLAMOD = 13 AND
                 B.CODDSP NOT IN
                 (SELECT F.CODDSP
                 FROM R058RLP E, R058RLG F, R058MOD H
                 WHERE
                 E.CODPRM IN (p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3) AND
                 E.CODPLT = F.CODPLT AND E.CODRLG = F.CODRLG AND
                 F.MODRLG = H.MODRLG AND F.COMRLG = 2 AND
                 H.CLAMOD = 13) AND
                 B.CODDSP NOT IN
                 (SELECT  G.CODDSP
                 FROM R058RLG G, R058MOD H, R034PRM I
                 WHERE
                    G.MODRLG = H.MODRLG AND
                    G.COMRLG = 2 AND
                    H.CLAMOD = 13 AND
                    G.CODPLT = I.CODPLT AND
                    G.CODRLG = I.CODRLG AND
                    I.IDTPES = p_idtpes) AND
                    F.CODDSP = B.CODDSP AND F.STADSP = 1;   /*Dispositivo deve estar ativo*/

      EXCEPTION WHEN OTHERS THEN
         l_count:= 0;
      END;

      IF (l_count = 0) THEN
          /* só faz SELECT para grupo se não encontrar nada no primeiro select. */
          BEGIN
              SELECT COUNT(C.NUMEIP) INTO l_count
                     FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DSP F
                     WHERE A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
                     A.CODGRR = B.CODGRR AND
                     B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
                     C.MODRLG = D.MODRLG AND D.CLAMOD = 13 AND
                     C.CODDSP NOT IN
                     (SELECT G.CODDSP
                     FROM R058GRP E, R058GRL F, R058RLG G, R058MOD H
                     WHERE E.CODPRM IN (p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3) AND
                     E.CODGRR = F.CODGRR AND
                     F.CODPLT = G.CODPLT  AND F.CODRLG = G.CODRLG AND G.COMRLG = 2 AND
                     G.MODRLG = H.MODRLG AND H.CLAMOD = 13) AND
                     C.CODDSP NOT IN
                     (SELECT  I.CODDSP
                     FROM R058RLG I, R058MOD J, R034PRM K
                     WHERE
                        I.MODRLG = J.MODRLG AND
                        I.COMRLG = 2 AND
                        J.CLAMOD = 13 AND
                        I.CODPLT = K.CODPLT AND
                        I.CODRLG = K.CODRLG AND
                        K.IDTPES = p_idtpes) AND
                        F.CODDSP = C.CODDSP AND F.STADSP = 1;  /*Dispositivo deve estar ativo*/

          EXCEPTION WHEN OTHERS THEN
            l_count:= 0;
          END;
      END IF;
  ELSE
    l_count:= 1;
  END IF;

  /* Só prossegue na execução da procedure se na troca de permissão */
  /* existir dispositivos ou não for uma troca de permissão (l_count > 0). */
  IF (l_count > 0) THEN
      l_datatu_cra := CURDATE();
      l_horatu_cra := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_seqenv_cra := SECOND(CURTIME());

      SP_DATSTR(l_datatu_cra, 'DDMMYY', l_datstr_cra OUT);
      SP_INTSTR(l_horatu_cra, 'HHMM', l_horstr_cra OUT);
      SP_INTSTR(l_seqenv_cra, '99', l_seqstr_cra OUT);

      /*Monta a string de data e hora atual*/
      l_datatustr_cra := l_datstr_cra||l_horstr_cra||l_seqstr_cra||'0000';

      /*Retorna as informações da pessoa a partir do idtpes*/
      SP_PESFROMIDTPES(p_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT,
                       l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);
  
      /*Busca os números físicos do crachá provisório*/
      l_crapro := 0;
      SP_RetCra (2, l_numemp, l_tipcol, l_numcad, 0, 0, 0, '', l_crapro OUT);
      SP_MAPFIS(l_crapro, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

      IF (p_tipope = 'B' OR p_tipope = 'X' OR p_tipope = 'D') THEN
          l_pltrlg := ' ';
          l_prmlst := ' ';

          /*Percorre os REPs das permissões antigas*/
          FOREACH c_r058rlp INTO l_r058rlp.CODPRM,
                                 l_r058rlp.CODPLT,
                                 l_r058rlp.CODRLG
          LOOP
              /*Passa a permissão que será enviada no comando de DELETE*/
              l_prmdel := l_r058rlp.CODPRM;

              /*Verifica se o dispositivo já está na lista e a permissão. Caso estejam, significa que já foi enviado um comando de DELETE para este dispositivo, se necessário.
                Sendo assim, não necessita entrar no if.*/
              IF ((LOCATE(',(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),', l_pltrlg, 1) = 0) AND
                  (LOCATE(',' || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',', l_prmlst, 1) = 0)) THEN

                  /*Adiciona o dispositivo na lista seguindo o padrão: ,(##,##),
                    ISto para a busca na lista ser 100% de acerto*/
                  IF (l_pltrlg = ' ') THEN
                      l_pltrlg := ',(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),';
                  ELSE
                      l_pltrlg := l_pltrlg || '(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),';
                  END IF;

                  /*Adiciona a permissão na lista seguindo o padrão: ,prm:##, */
                  IF (l_prmlst = ' ') THEN
                      l_prmlst := ',' || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',';
                  ELSE
                      l_prmlst := l_prmlst || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',';
                  END IF;

                  /*Barras*/
                  IF (l_numbar <> 0) THEN
                      SP_R070ACR(p_tipope, l_crapro, l_numbar, 1, p_VerPrm,
                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                      0, 0, 0, 0, 0, 0, 0,
                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
                  END IF;

                  /*Proximidade*/
                  IF (l_numpro <> 0) THEN
                      SP_R070ACR(p_tipope, l_crapro, l_numpro, 2, p_VerPrm,
                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                      0, 0, 0, 0, 0, 0, 0,
                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
                  END IF;

                  /*Smart*/
                  IF (l_numsma <> 0) THEN
                      SP_R070ACR(p_tipope, l_crapro, l_numsma, 3, p_VerPrm,
                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                      0, 0, 0, 0, 0, 0, 0,
                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
                  END IF;

                  /*Se não tem nenhum número físico então é barras*/
                  IF (l_numbar = 0) AND (l_numpro = 0) AND (l_numsma = 0) AND (l_crapro <> 0) THEN
                      SP_R070ACR(p_tipope, l_crapro, l_crapro, 1, p_VerPrm,
                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                      0, 0, 0, 0, 0, 0, 0,
                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
                  END IF;
              END IF;
          END LOOP;
          
      ELSE /*Inclusão Normal*/

          /*Barras*/
          IF (l_numbar <> 0) THEN
                SP_R070ACR(p_tipope, l_crapro, l_numbar, 1, p_VerPrm,
                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
          END IF;

          /*Proximidade*/
          IF (l_numpro <> 0) THEN
                SP_R070ACR(p_tipope, l_crapro, l_numpro, 2, p_VerPrm,
                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
          END IF;

          /*Smart*/
          IF (l_numsma <> 0) THEN
                SP_R070ACR(p_tipope, l_crapro, l_numsma, 3, p_VerPrm,
                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
          END IF;

          /*Se não tem nenhum número físico é barras*/
          IF (l_numbar = 0) AND (l_numpro = 0) AND (l_numsma = 0) AND (l_crapro <> 0) THEN
                SP_R070ACR(p_tipope, l_crapro, l_crapro, 1, p_VerPrm,
                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
          END IF;
      END IF;
      
      /* Se houver um provisório ativo, não precisa atualizar o titular */
      IF (l_crapro = 0) THEN 
	      /*Busca os números físicos do crachá titular*/
	      SP_RetCra (1, l_numemp, l_tipcol, l_numcad, 0, 0, 0, '', l_cratit OUT);
	      SP_MAPFIS(l_cratit, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
	
	      IF (p_tipope = 'B' OR p_tipope = 'X' OR p_tipope = 'D') THEN
	          l_pltrlg := ' ';
	          l_prmlst := ' ';
	
	          /*Percorre os REPs das permissões antigas*/
	          FOREACH c_r058rlp INTO l_r058rlp.CODPRM,
	                                 l_r058rlp.CODPLT,
	                                 l_r058rlp.CODRLG
	          LOOP
	              /*Passa a permissão que será enviada no comando de DELETE*/
	              l_prmdel := l_r058rlp.CODPRM;
	
	              /*Verifica se o dispositivo já está na lista. Caso esteja, significa que já foi enviado um comando de DELETE para este dispositivo, se necessário.
	                Sendo assim, não necessita entrar no if.*/
	              IF ((LOCATE(',(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),', l_pltrlg, 1) = 0) AND
	                  (LOCATE(',' || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',', l_prmlst, 1) = 0)) THEN
	
	                  /*Adiciona o dispositivo na lista seguindo o padrão: ,(##,##), isto para a busca na lista ser 100% de acerto*/
	                  IF (l_pltrlg = ' ') THEN
	                      l_pltrlg := ',(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),';
	                  ELSE
	                      l_pltrlg := l_pltrlg || '(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),';
	                  END IF;
	
	                 /*Adiciona a permissão na lista seguindo o padrão: ,prm:##, */
	                 IF (l_prmlst = ' ') THEN
	                     l_prmlst := ',' || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',';
	                 ELSE
	                     l_prmlst := l_prmlst || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',';
	                 END IF;
	
	                  /*Barras*/
	                  IF (l_numbar <> 0) THEN
	                      SP_R070ACR(p_tipope, l_cratit, l_numbar, 1, p_VerPrm,
	                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                      0, 0, 0, 0, 0, 0, 0,
	                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	                  END IF;
	
	                  /*Proximidade*/
	                  IF (l_numpro <> 0) THEN
	                      SP_R070ACR(p_tipope, l_cratit, l_numpro, 2, p_VerPrm,
	                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                      0, 0, 0, 0, 0, 0, 0,
	                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	                  END IF;
	
	                  /*Smart*/
	                  IF (l_numsma <> 0) THEN
	                      SP_R070ACR(p_tipope, l_cratit, l_numsma, 3, p_VerPrm,
	                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                      0, 0, 0, 0, 0, 0, 0,
	                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	                  END IF;
	
	                  /*Se não tem nenhum número físico é barras*/
	                  IF (l_numbar = 0) AND (l_numpro = 0) AND (l_numsma = 0) AND (l_cratit <> 0) THEN
	                      SP_R070ACR(p_tipope, l_cratit, l_cratit, 1, p_VerPrm,
	                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                      0, 0, 0, 0, 0, 0, 0,
	                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	                  END IF; 
	              END IF;
	          END LOOP;
	          
	      ELSE /*Inclusão Normal*/
	
	          /*Barras*/
	          IF (l_numbar <> 0) THEN
	                SP_R070ACR(p_tipope, l_cratit, l_numbar, 1, p_VerPrm,
	                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
	                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	          END IF;
	
	          /*Proximidade*/
	          IF (l_numpro <> 0) THEN
	                SP_R070ACR(p_tipope, l_cratit, l_numpro, 2, p_VerPrm,
	                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
	                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	          END IF;
	
	          /*Smart*/
	          IF (l_numsma <> 0) THEN
	                SP_R070ACR(p_tipope, l_cratit, l_numsma, 3, p_VerPrm,
	                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
	                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	          END IF;
	
	          /*Se não tem nenhum número físico é barras*/
	          IF (l_numbar = 0) AND (l_numpro = 0) AND (l_numsma = 0) AND (l_cratit <> 0) THEN
	                SP_R070ACR(p_tipope, l_cratit, l_cratit, 1, p_VerPrm,
	                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
	                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	          END IF;
	      END IF;
	  END IF;
	END IF;
END		SENIOR;22JSP_DATSTR
SP_INTSTR
SP_PESFROMIDTPES
SP_RETCRA
SP_MAPFIS
SP_R070ACR
şI␀␀PROCEDURE SP_DELINSCRA70ACR(P_TIPOPE VARCHAR2(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1),P_REMREP NUMBER(1),P_TIPLIS NUMBER(2),P_OLDPRM NUMBER(5),P_OLDSAB NUMBER(5),P_OLDDOM NUMBER(5),P_OLDFER NUMBER(5),P_OLDRT1 NUMBER(5),P_OLDRT2 NUMBER(5),P_OLDRT3 NUMBER(5),P_NUMCPF NUMBER(11))
 IS

l_datatu_cra     DATE;
  l_horatu_cra     NUMBER(4);
  l_datstr_cra     CHAR(6);
  l_horstr_cra     CHAR(4);
  l_seqenv_cra     NUMBER(2);
  l_seqstr_cra     CHAR(2);
  l_datatustr_cra  CHAR(16);  
  l_cratit         NUMBER(12);
  l_numbar         NUMBER(12);
  l_numpro         NUMBER(12);
  l_numsma         NUMBER(12);
  l_tecpri         NUMBER(1);
  l_crapri         NUMBER(12);
  l_crapro         NUMBER(12);  
  l_tippes         NUMBER(2);
  l_numemp         NUMBER(4);
  l_tipcol         NUMBER(1);
  l_numcad         NUMBER(9);
  l_tipdoc         NUMBER(1);
  l_numdoc         VARCHAR2(20);
  l_nummat         VARCHAR2(15);
  l_propac         VARCHAR2(20);
  l_count          NUMBER(9);
  l_pltrlg         VARCHAR2(32000);
  l_prmlst         VARCHAR2(32000);
  l_prmdel         NUMBER(5);

  /*CURSOR para trazer os dispositivos das permissões, isto para que não seja enviado mais de um comando de DELETE para o mesmo dispositivo*/
  CURSOR c_r058rlp IS
  SELECT DISTINCT A.CODPRM, A.CODPLT, A.CODRLG FROM R058RLP A, R058RLG B, R058MOD C WHERE A.CODPRM IN (p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3) AND B.MODRLG = C.MODRLG AND C.CLAMOD = 13
  UNION  /*GRUPO*/
  (SELECT DISTINCT D.CODPRM, E.CODPLT, E.CODRLG FROM R058GRP D, R058GRL E, R058RLG F, R058MOD G WHERE D.CODPRM IN (p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3) AND D.CODGRR = E.CODGRR AND E.CODRLG = F.CODRLG AND F.MODRLG = G.MODRLG AND G.CLAMOD = 13);
  TYPE t_r058rlp IS RECORD(
    CODPRM   R058RLP.CODPRM%TYPE,
    CODPLT   R058RLP.CODPLT%TYPE,
    CODRLG   R058RLP.CODRLG%TYPE);
  l_r058rlp t_r058rlp;
  
BEGIN
  IF (p_tipope = 'A' OR p_tipope = 'H' OR p_tipope = 'I') THEN
      BEGIN
          SELECT COUNT(B.NUMEIP) INTO l_count
                 FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F
                 WHERE
                 A.CODPRM  IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
                 A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
                 B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
                 D.CLAMOD = 13 AND
                 B.CODDSP NOT IN
                 (SELECT F.CODDSP
                 FROM R058RLP E, R058RLG F, R058MOD H
                 WHERE
                 E.CODPRM IN (p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3) AND
                 E.CODPLT = F.CODPLT AND E.CODRLG = F.CODRLG AND
                 F.MODRLG = H.MODRLG AND F.COMRLG = 2 AND
                 H.CLAMOD = 13) AND
                 B.CODDSP NOT IN
                 (SELECT  G.CODDSP
                 FROM R058RLG G, R058MOD H, R034PRM I
                 WHERE
                    G.MODRLG = H.MODRLG AND
                    G.COMRLG = 2 AND
                    H.CLAMOD = 13 AND
                    G.CODPLT = I.CODPLT AND
                    G.CODRLG = I.CODRLG AND
                    I.IDTPES = p_idtpes) AND
                    F.CODDSP = B.CODDSP AND F.STADSP = 1;   /*Dispositivo deve estar ativo*/

      EXCEPTION WHEN OTHERS THEN
         l_count:= 0;
      END;

      IF (l_count = 0) THEN
          /* só faz SELECT para grupo se não encontrar nada no primeiro select. */
          BEGIN
              SELECT COUNT(C.NUMEIP) INTO l_count
                     FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DSP F
                     WHERE A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
                     A.CODGRR = B.CODGRR AND
                     B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
                     C.MODRLG = D.MODRLG AND D.CLAMOD = 13 AND
                     C.CODDSP NOT IN
                     (SELECT G.CODDSP
                     FROM R058GRP E, R058GRL F, R058RLG G, R058MOD H
                     WHERE E.CODPRM IN (p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3) AND
                     E.CODGRR = F.CODGRR AND
                     F.CODPLT = G.CODPLT  AND F.CODRLG = G.CODRLG AND G.COMRLG = 2 AND
                     G.MODRLG = H.MODRLG AND H.CLAMOD = 13) AND
                     C.CODDSP NOT IN
                     (SELECT  I.CODDSP
                     FROM R058RLG I, R058MOD J, R034PRM K
                     WHERE
                        I.MODRLG = J.MODRLG AND
                        I.COMRLG = 2 AND
                        J.CLAMOD = 13 AND
                        I.CODPLT = K.CODPLT AND
                        I.CODRLG = K.CODRLG AND
                        K.IDTPES = p_idtpes) AND
                        F.CODDSP = C.CODDSP AND F.STADSP = 1;  /*Dispositivo deve estar ativo*/

          EXCEPTION WHEN OTHERS THEN
            l_count:= 0;
          END;
      END IF;
  ELSE
    l_count:= 1;
  END IF;

  /* Só prossegue na execução da procedure se na troca de permissão */
  /* existir dispositivos ou não for uma troca de permissão (l_count > 0). */
  IF (l_count > 0) THEN
      l_datatu_cra := CURDATE();
      l_horatu_cra := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_seqenv_cra := SECOND(CURTIME());

      SP_DATSTR(l_datatu_cra, 'DDMMYY', l_datstr_cra OUT);
      SP_INTSTR(l_horatu_cra, 'HHMM', l_horstr_cra OUT);
      SP_INTSTR(l_seqenv_cra, '99', l_seqstr_cra OUT);

      /*Monta a string de data e hora atual*/
      l_datatustr_cra := l_datstr_cra||l_horstr_cra||l_seqstr_cra||'0000';

      /*Retorna as informações da pessoa a partir do idtpes*/
      SP_PESFROMIDTPES(p_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT,
                       l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);
  
      /*Busca os números físicos do crachá provisório*/
      l_crapro := 0;
      SP_RetCra (2, l_numemp, l_tipcol, l_numcad, 0, 0, 0, '', l_crapro OUT);
      SP_MAPFIS(l_crapro, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

      IF (p_tipope = 'B' OR p_tipope = 'X' OR p_tipope = 'D') THEN
          l_pltrlg := ' ';
          l_prmlst := ' ';

          /*Percorre os REPs das permissões antigas*/
          FOREACH c_r058rlp INTO l_r058rlp.CODPRM,
                                 l_r058rlp.CODPLT,
                                 l_r058rlp.CODRLG
          LOOP
              /*Passa a permissão que será enviada no comando de DELETE*/
              l_prmdel := l_r058rlp.CODPRM;

              /*Verifica se o dispositivo já está na lista e a permissão. Caso estejam, significa que já foi enviado um comando de DELETE para este dispositivo, se necessário.
                Sendo assim, não necessita entrar no if.*/
              IF ((LOCATE(',(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),', l_pltrlg, 1) = 0) AND
                  (LOCATE(',' || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',', l_prmlst, 1) = 0)) THEN

                  /*Adiciona o dispositivo na lista seguindo o padrão: ,(##,##),
                    ISto para a busca na lista ser 100% de acerto*/
                  IF (l_pltrlg = ' ') THEN
                      l_pltrlg := ',(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),';
                  ELSE
                      l_pltrlg := l_pltrlg || '(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),';
                  END IF;

                  /*Adiciona a permissão na lista seguindo o padrão: ,prm:##, */
                  IF (l_prmlst = ' ') THEN
                      l_prmlst := ',' || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',';
                  ELSE
                      l_prmlst := l_prmlst || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',';
                  END IF;

                  /*Barras*/
                  IF (l_numbar <> 0) THEN
                      SP_R070ACR(p_tipope, l_crapro, l_numbar, 1, p_VerPrm,
                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                      0, 0, 0, 0, 0, 0, 0,
                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
                  END IF;

                  /*Proximidade*/
                  IF (l_numpro <> 0) THEN
                      SP_R070ACR(p_tipope, l_crapro, l_numpro, 2, p_VerPrm,
                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                      0, 0, 0, 0, 0, 0, 0,
                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
                  END IF;

                  /*Smart*/
                  IF (l_numsma <> 0) THEN
                      SP_R070ACR(p_tipope, l_crapro, l_numsma, 3, p_VerPrm,
                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                      0, 0, 0, 0, 0, 0, 0,
                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
                  END IF;

                  /*Se não tem nenhum número físico então é barras*/
                  IF (l_numbar = 0) AND (l_numpro = 0) AND (l_numsma = 0) AND (l_crapro <> 0) THEN
                      SP_R070ACR(p_tipope, l_crapro, l_crapro, 1, p_VerPrm,
                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                      0, 0, 0, 0, 0, 0, 0,
                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
                  END IF;
              END IF;
          END LOOP;
          
      ELSE /*Inclusão Normal*/

          /*Barras*/
          IF (l_numbar <> 0) THEN
                SP_R070ACR(p_tipope, l_crapro, l_numbar, 1, p_VerPrm,
                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
          END IF;

          /*Proximidade*/
          IF (l_numpro <> 0) THEN
                SP_R070ACR(p_tipope, l_crapro, l_numpro, 2, p_VerPrm,
                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
          END IF;

          /*Smart*/
          IF (l_numsma <> 0) THEN
                SP_R070ACR(p_tipope, l_crapro, l_numsma, 3, p_VerPrm,
                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
          END IF;

          /*Se não tem nenhum número físico é barras*/
          IF (l_numbar = 0) AND (l_numpro = 0) AND (l_numsma = 0) AND (l_crapro <> 0) THEN
                SP_R070ACR(p_tipope, l_crapro, l_crapro, 1, p_VerPrm,
                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
          END IF;
      END IF;
      
      /* Se houver um provisório ativo, não precisa atualizar o titular */
      IF (l_crapro = 0) THEN 
	      /*Busca os números físicos do crachá titular*/
	      SP_RetCra (1, l_numemp, l_tipcol, l_numcad, 0, 0, 0, '', l_cratit OUT);
	      SP_MAPFIS(l_cratit, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
	
	      IF (p_tipope = 'B' OR p_tipope = 'X' OR p_tipope = 'D') THEN
	          l_pltrlg := ' ';
	          l_prmlst := ' ';
	
	          /*Percorre os REPs das permissões antigas*/
	          FOREACH c_r058rlp INTO l_r058rlp.CODPRM,
	                                 l_r058rlp.CODPLT,
	                                 l_r058rlp.CODRLG
	          LOOP
	              /*Passa a permissão que será enviada no comando de DELETE*/
	              l_prmdel := l_r058rlp.CODPRM;
	
	              /*Verifica se o dispositivo já está na lista. Caso esteja, significa que já foi enviado um comando de DELETE para este dispositivo, se necessário.
	                Sendo assim, não necessita entrar no if.*/
	              IF ((LOCATE(',(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),', l_pltrlg, 1) = 0) AND
	                  (LOCATE(',' || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',', l_prmlst, 1) = 0)) THEN
	
	                  /*Adiciona o dispositivo na lista seguindo o padrão: ,(##,##), isto para a busca na lista ser 100% de acerto*/
	                  IF (l_pltrlg = ' ') THEN
	                      l_pltrlg := ',(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),';
	                  ELSE
	                      l_pltrlg := l_pltrlg || '(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),';
	                  END IF;
	
	                 /*Adiciona a permissão na lista seguindo o padrão: ,prm:##, */
	                 IF (l_prmlst = ' ') THEN
	                     l_prmlst := ',' || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',';
	                 ELSE
	                     l_prmlst := l_prmlst || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',';
	                 END IF;
	
	                  /*Barras*/
	                  IF (l_numbar <> 0) THEN
	                      SP_R070ACR(p_tipope, l_cratit, l_numbar, 1, p_VerPrm,
	                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                      0, 0, 0, 0, 0, 0, 0,
	                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	                  END IF;
	
	                  /*Proximidade*/
	                  IF (l_numpro <> 0) THEN
	                      SP_R070ACR(p_tipope, l_cratit, l_numpro, 2, p_VerPrm,
	                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                      0, 0, 0, 0, 0, 0, 0,
	                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	                  END IF;
	
	                  /*Smart*/
	                  IF (l_numsma <> 0) THEN
	                      SP_R070ACR(p_tipope, l_cratit, l_numsma, 3, p_VerPrm,
	                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                      0, 0, 0, 0, 0, 0, 0,
	                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	                  END IF;
	
	                  /*Se não tem nenhum número físico é barras*/
	                  IF (l_numbar = 0) AND (l_numpro = 0) AND (l_numsma = 0) AND (l_cratit <> 0) THEN
	                      SP_R070ACR(p_tipope, l_cratit, l_cratit, 1, p_VerPrm,
	                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                      0, 0, 0, 0, 0, 0, 0,
	                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	                  END IF; 
	              END IF;
	          END LOOP;
	          
	      ELSE /*Inclusão Normal*/
	
	          /*Barras*/
	          IF (l_numbar <> 0) THEN
	                SP_R070ACR(p_tipope, l_cratit, l_numbar, 1, p_VerPrm,
	                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
	                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	          END IF;
	
	          /*Proximidade*/
	          IF (l_numpro <> 0) THEN
	                SP_R070ACR(p_tipope, l_cratit, l_numpro, 2, p_VerPrm,
	                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
	                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	          END IF;
	
	          /*Smart*/
	          IF (l_numsma <> 0) THEN
	                SP_R070ACR(p_tipope, l_cratit, l_numsma, 3, p_VerPrm,
	                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
	                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	          END IF;
	
	          /*Se não tem nenhum número físico é barras*/
	          IF (l_numbar = 0) AND (l_numpro = 0) AND (l_numsma = 0) AND (l_cratit <> 0) THEN
	                SP_R070ACR(p_tipope, l_cratit, l_cratit, 1, p_VerPrm,
	                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
	                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	          END IF;
	      END IF;
	  END IF;
	END IF;
END		SENIOR;24JSP_DATSTR
SP_INTSTR
SP_PESFROMIDTPES
SP_RETCRA
SP_MAPFIS
SP_R070ACR
şI␀␀PROCEDURE SP_DELINSCRA70ACR(P_TIPOPE VARCHAR2(1),P_VERPRM NUMBER(1),P_CODPRM NUMBER(5),P_PRMSAB NUMBER(5),P_PRMDOM NUMBER(5),P_PRMFER NUMBER(5),P_PRMRT1 NUMBER(5),P_PRMRT2 NUMBER(5),P_PRMRT3 NUMBER(5),P_IDTPES CHAR(23),P_NOMFUN VARCHAR2(40),P_NUMPIS NUMBER(11),P_ALTBIO NUMBER(1),P_REMREP NUMBER(1),P_TIPLIS NUMBER(2),P_OLDPRM NUMBER(5),P_OLDSAB NUMBER(5),P_OLDDOM NUMBER(5),P_OLDFER NUMBER(5),P_OLDRT1 NUMBER(5),P_OLDRT2 NUMBER(5),P_OLDRT3 NUMBER(5),P_NUMCPF NUMBER(11))
 IS

l_datatu_cra     DATE;
  l_horatu_cra     NUMBER(4);
  l_datstr_cra     CHAR(6);
  l_horstr_cra     CHAR(4);
  l_seqenv_cra     NUMBER(2);
  l_seqstr_cra     CHAR(2);
  l_datatustr_cra  CHAR(16);  
  l_cratit         NUMBER(12);
  l_numbar         NUMBER(12);
  l_numpro         NUMBER(12);
  l_numsma         NUMBER(12);
  l_tecpri         NUMBER(1);
  l_crapri         NUMBER(12);
  l_crapro         NUMBER(12);  
  l_tippes         NUMBER(2);
  l_numemp         NUMBER(4);
  l_tipcol         NUMBER(1);
  l_numcad         NUMBER(9);
  l_tipdoc         NUMBER(1);
  l_numdoc         VARCHAR2(20);
  l_nummat         VARCHAR2(15);
  l_propac         VARCHAR2(20);
  l_count          NUMBER(9);
  l_pltrlg         VARCHAR2(32000);
  l_prmlst         VARCHAR2(32000);
  l_prmdel         NUMBER(5);

  /*CURSOR para trazer os dispositivos das permissões, isto para que não seja enviado mais de um comando de DELETE para o mesmo dispositivo*/
  CURSOR c_r058rlp IS
  SELECT DISTINCT A.CODPRM, A.CODPLT, A.CODRLG FROM R058RLP A, R058RLG B, R058MOD C WHERE A.CODPRM IN (p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3) AND B.MODRLG = C.MODRLG AND C.CLAMOD = 13
  UNION  /*GRUPO*/
  (SELECT DISTINCT D.CODPRM, E.CODPLT, E.CODRLG FROM R058GRP D, R058GRL E, R058RLG F, R058MOD G WHERE D.CODPRM IN (p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3) AND D.CODGRR = E.CODGRR AND E.CODRLG = F.CODRLG AND F.MODRLG = G.MODRLG AND G.CLAMOD = 13);
  TYPE t_r058rlp IS RECORD(
    CODPRM   R058RLP.CODPRM%TYPE,
    CODPLT   R058RLP.CODPLT%TYPE,
    CODRLG   R058RLP.CODRLG%TYPE);
  l_r058rlp t_r058rlp;
  
BEGIN
  IF (p_tipope = 'A' OR p_tipope = 'H' OR p_tipope = 'I') THEN
      BEGIN
          SELECT COUNT(B.NUMEIP) INTO l_count
                 FROM R058RLP A, R058RLG B, R058MOD D, R058DSP F
                 WHERE
                 A.CODPRM  IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
                 A.CODPLT = B.CODPLT AND A.CODRLG = B.CODRLG AND
                 B.MODRLG = D.MODRLG AND B.COMRLG = 2 AND
                 D.CLAMOD = 13 AND
                 B.CODDSP NOT IN
                 (SELECT F.CODDSP
                 FROM R058RLP E, R058RLG F, R058MOD H
                 WHERE
                 E.CODPRM IN (p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3) AND
                 E.CODPLT = F.CODPLT AND E.CODRLG = F.CODRLG AND
                 F.MODRLG = H.MODRLG AND F.COMRLG = 2 AND
                 H.CLAMOD = 13) AND
                 B.CODDSP NOT IN
                 (SELECT  G.CODDSP
                 FROM R058RLG G, R058MOD H, R034PRM I
                 WHERE
                    G.MODRLG = H.MODRLG AND
                    G.COMRLG = 2 AND
                    H.CLAMOD = 13 AND
                    G.CODPLT = I.CODPLT AND
                    G.CODRLG = I.CODRLG AND
                    I.IDTPES = p_idtpes) AND
                    F.CODDSP = B.CODDSP AND F.STADSP = 1;   /*Dispositivo deve estar ativo*/

      EXCEPTION WHEN OTHERS THEN
         l_count:= 0;
      END;

      IF (l_count = 0) THEN
          /* só faz SELECT para grupo se não encontrar nada no primeiro select. */
          BEGIN
              SELECT COUNT(C.NUMEIP) INTO l_count
                     FROM R058GRP A, R058GRL B, R058RLG C, R058MOD D, R058DSP F
                     WHERE A.CODPRM IN (p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3) AND
                     A.CODGRR = B.CODGRR AND
                     B.CODPLT = C.CODPLT  AND B.CODRLG = C.CODRLG AND C.COMRLG = 2 AND
                     C.MODRLG = D.MODRLG AND D.CLAMOD = 13 AND
                     C.CODDSP NOT IN
                     (SELECT G.CODDSP
                     FROM R058GRP E, R058GRL F, R058RLG G, R058MOD H
                     WHERE E.CODPRM IN (p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3) AND
                     E.CODGRR = F.CODGRR AND
                     F.CODPLT = G.CODPLT  AND F.CODRLG = G.CODRLG AND G.COMRLG = 2 AND
                     G.MODRLG = H.MODRLG AND H.CLAMOD = 13) AND
                     C.CODDSP NOT IN
                     (SELECT  I.CODDSP
                     FROM R058RLG I, R058MOD J, R034PRM K
                     WHERE
                        I.MODRLG = J.MODRLG AND
                        I.COMRLG = 2 AND
                        J.CLAMOD = 13 AND
                        I.CODPLT = K.CODPLT AND
                        I.CODRLG = K.CODRLG AND
                        K.IDTPES = p_idtpes) AND
                        F.CODDSP = C.CODDSP AND F.STADSP = 1;  /*Dispositivo deve estar ativo*/

          EXCEPTION WHEN OTHERS THEN
            l_count:= 0;
          END;
      END IF;
  ELSE
    l_count:= 1;
  END IF;

  /* Só prossegue na execução da procedure se na troca de permissão */
  /* existir dispositivos ou não for uma troca de permissão (l_count > 0). */
  IF (l_count > 0) THEN
      l_datatu_cra := CURDATE();
      l_horatu_cra := HOUR(CURTIME())*60 + MINUTE(CURTIME());
      l_seqenv_cra := SECOND(CURTIME());

      SP_DATSTR(l_datatu_cra, 'DDMMYY', l_datstr_cra OUT);
      SP_INTSTR(l_horatu_cra, 'HHMM', l_horstr_cra OUT);
      SP_INTSTR(l_seqenv_cra, '99', l_seqstr_cra OUT);

      /*Monta a string de data e hora atual*/
      l_datatustr_cra := l_datstr_cra||l_horstr_cra||l_seqstr_cra||'0000';

      /*Retorna as informações da pessoa a partir do idtpes*/
      SP_PESFROMIDTPES(p_idtpes, l_tippes OUT, l_numemp OUT, l_tipcol OUT, l_numcad OUT,
                       l_tipdoc OUT, l_numdoc OUT, l_nummat OUT, l_propac OUT);
  
      /*Busca os números físicos do crachá provisório*/
      l_crapro := 0;
      SP_RetCra (2, l_numemp, l_tipcol, l_numcad, 0, 0, 0, '', l_crapro OUT);
      SP_MAPFIS(l_crapro, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);

      IF (p_tipope = 'B' OR p_tipope = 'X' OR p_tipope = 'D') THEN
          l_pltrlg := ' ';
          l_prmlst := ' ';

          /*Percorre os REPs das permissões antigas*/
          FOREACH c_r058rlp INTO l_r058rlp.CODPRM,
                                 l_r058rlp.CODPLT,
                                 l_r058rlp.CODRLG
          LOOP
              /*Passa a permissão que será enviada no comando de DELETE*/
              l_prmdel := l_r058rlp.CODPRM;

              /*Verifica se o dispositivo já está na lista e a permissão. Caso estejam, significa que já foi enviado um comando de DELETE para este dispositivo, se necessário.
                Sendo assim, não necessita entrar no if.*/
              IF ((LOCATE(',(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),', l_pltrlg, 1) = 0) AND
                  (LOCATE(',' || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',', l_prmlst, 1) = 0)) THEN

                  /*Adiciona o dispositivo na lista seguindo o padrão: ,(##,##),
                    ISto para a busca na lista ser 100% de acerto*/
                  IF (l_pltrlg = ' ') THEN
                      l_pltrlg := ',(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),';
                  ELSE
                      l_pltrlg := l_pltrlg || '(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),';
                  END IF;

                  /*Adiciona a permissão na lista seguindo o padrão: ,prm:##, */
                  IF (l_prmlst = ' ') THEN
                      l_prmlst := ',' || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',';
                  ELSE
                      l_prmlst := l_prmlst || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',';
                  END IF;

                  /*Barras*/
                  IF (l_numbar <> 0) THEN
                      SP_R070ACR(p_tipope, l_crapro, l_numbar, 1, p_VerPrm,
                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                      0, 0, 0, 0, 0, 0, 0,
                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
                  END IF;

                  /*Proximidade*/
                  IF (l_numpro <> 0) THEN
                      SP_R070ACR(p_tipope, l_crapro, l_numpro, 2, p_VerPrm,
                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                      0, 0, 0, 0, 0, 0, 0,
                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
                  END IF;

                  /*Smart*/
                  IF (l_numsma <> 0) THEN
                      SP_R070ACR(p_tipope, l_crapro, l_numsma, 3, p_VerPrm,
                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                      0, 0, 0, 0, 0, 0, 0,
                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
                  END IF;

                  /*Se não tem nenhum número físico então é barras*/
                  IF (l_numbar = 0) AND (l_numpro = 0) AND (l_numsma = 0) AND (l_crapro <> 0) THEN
                      SP_R070ACR(p_tipope, l_crapro, l_crapro, 1, p_VerPrm,
                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                      0, 0, 0, 0, 0, 0, 0,
                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
                  END IF;
              END IF;
          END LOOP;
          
      ELSE /*Inclusão Normal*/

          /*Barras*/
          IF (l_numbar <> 0) THEN
                SP_R070ACR(p_tipope, l_crapro, l_numbar, 1, p_VerPrm,
                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
          END IF;

          /*Proximidade*/
          IF (l_numpro <> 0) THEN
                SP_R070ACR(p_tipope, l_crapro, l_numpro, 2, p_VerPrm,
                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
          END IF;

          /*Smart*/
          IF (l_numsma <> 0) THEN
                SP_R070ACR(p_tipope, l_crapro, l_numsma, 3, p_VerPrm,
                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
          END IF;

          /*Se não tem nenhum número físico é barras*/
          IF (l_numbar = 0) AND (l_numpro = 0) AND (l_numsma = 0) AND (l_crapro <> 0) THEN
                SP_R070ACR(p_tipope, l_crapro, l_crapro, 1, p_VerPrm,
                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
          END IF;
      END IF;
      
      /* Se houver um provisório ativo, não precisa atualizar o titular */
      IF (l_crapro = 0) THEN 
	      /*Busca os números físicos do crachá titular*/
	      SP_RetCra (1, l_numemp, l_tipcol, l_numcad, 0, 0, 0, '', l_cratit OUT);
	      SP_MAPFIS(l_cratit, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
	
	      IF (p_tipope = 'B' OR p_tipope = 'X' OR p_tipope = 'D') THEN
	          l_pltrlg := ' ';
	          l_prmlst := ' ';
	
	          /*Percorre os REPs das permissões antigas*/
	          FOREACH c_r058rlp INTO l_r058rlp.CODPRM,
	                                 l_r058rlp.CODPLT,
	                                 l_r058rlp.CODRLG
	          LOOP
	              /*Passa a permissão que será enviada no comando de DELETE*/
	              l_prmdel := l_r058rlp.CODPRM;
	
	              /*Verifica se o dispositivo já está na lista. Caso esteja, significa que já foi enviado um comando de DELETE para este dispositivo, se necessário.
	                Sendo assim, não necessita entrar no if.*/
	              IF ((LOCATE(',(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),', l_pltrlg, 1) = 0) AND
	                  (LOCATE(',' || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',', l_prmlst, 1) = 0)) THEN
	
	                  /*Adiciona o dispositivo na lista seguindo o padrão: ,(##,##), isto para a busca na lista ser 100% de acerto*/
	                  IF (l_pltrlg = ' ') THEN
	                      l_pltrlg := ',(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),';
	                  ELSE
	                      l_pltrlg := l_pltrlg || '(' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODPLT) || ',' || CONVERT(NUMBER_TO_CHAR, l_r058rlp.CODRLG) || '),';
	                  END IF;
	
	                 /*Adiciona a permissão na lista seguindo o padrão: ,prm:##, */
	                 IF (l_prmlst = ' ') THEN
	                     l_prmlst := ',' || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',';
	                 ELSE
	                     l_prmlst := l_prmlst || CONVERT(NUMBER_TO_CHAR, l_prmdel) || ',';
	                 END IF;
	
	                  /*Barras*/
	                  IF (l_numbar <> 0) THEN
	                      SP_R070ACR(p_tipope, l_cratit, l_numbar, 1, p_VerPrm,
	                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                      0, 0, 0, 0, 0, 0, 0,
	                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	                  END IF;
	
	                  /*Proximidade*/
	                  IF (l_numpro <> 0) THEN
	                      SP_R070ACR(p_tipope, l_cratit, l_numpro, 2, p_VerPrm,
	                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                      0, 0, 0, 0, 0, 0, 0,
	                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	                  END IF;
	
	                  /*Smart*/
	                  IF (l_numsma <> 0) THEN
	                      SP_R070ACR(p_tipope, l_cratit, l_numsma, 3, p_VerPrm,
	                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                      0, 0, 0, 0, 0, 0, 0,
	                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	                  END IF;
	
	                  /*Se não tem nenhum número físico é barras*/
	                  IF (l_numbar = 0) AND (l_numpro = 0) AND (l_numsma = 0) AND (l_cratit <> 0) THEN
	                      SP_R070ACR(p_tipope, l_cratit, l_cratit, 1, p_VerPrm,
	                                      l_prmdel, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                      0, 0, 0, 0, 0, 0, 0,
	                                      l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	                  END IF; 
	              END IF;
	          END LOOP;
	          
	      ELSE /*Inclusão Normal*/
	
	          /*Barras*/
	          IF (l_numbar <> 0) THEN
	                SP_R070ACR(p_tipope, l_cratit, l_numbar, 1, p_VerPrm,
	                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
	                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	          END IF;
	
	          /*Proximidade*/
	          IF (l_numpro <> 0) THEN
	                SP_R070ACR(p_tipope, l_cratit, l_numpro, 2, p_VerPrm,
	                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
	                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	          END IF;
	
	          /*Smart*/
	          IF (l_numsma <> 0) THEN
	                SP_R070ACR(p_tipope, l_cratit, l_numsma, 3, p_VerPrm,
	                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
	                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	          END IF;
	
	          /*Se não tem nenhum número físico é barras*/
	          IF (l_numbar = 0) AND (l_numpro = 0) AND (l_numsma = 0) AND (l_cratit <> 0) THEN
	                SP_R070ACR(p_tipope, l_cratit, l_cratit, 1, p_VerPrm,
	                                0, p_CodPrm, p_PrmSab, p_PrmDom, p_PrmFer, p_PrmRt1, p_PrmRt2, p_PrmRt3,
	                                p_OldPrm, p_OldSab, p_OldDom, p_OldFer, p_OldRt1, p_OldRt2, p_OldRt3,
	                                l_datatustr_cra, p_Idtpes, p_NomFun, p_NumPis, p_AltBio, p_RemRep, p_TipLis, p_NumCpf);
	          END IF;
	      END IF;
	  END IF;
	END IF;
END	MSSQL;21JSP_DATSTR
SP_INTSTR
SP_MAPFIS
SP_PESFROMIDTPES
SP_R070ACR
SP_RETCRA
­F␀␀CREATE  PROCEDURE SP_DELINSCRA70ACR(@p_tipope VARCHAR(1), @p_VerPrm SMALLINT, @p_CodPrm INTEGER, @p_PrmSab INTEGER, @p_PrmDom INTEGER, @p_PrmFer INTEGER, @p_PrmRt1 INTEGER, @p_PrmRt2 INTEGER, @p_PrmRt3 INTEGER, @p_IdtPes CHAR(23), @p_NomFun VARCHAR(40), @p_NumPis BIGINT, @p_AltBio SMALLINT, @p_RemRep SMALLINT, @p_TipLis SMALLINT, @p_OldPrm INTEGER, @p_OldSab INTEGER, @p_OldDom INTEGER, @p_OldFer INTEGER, @p_OldRt1 INTEGER, @p_OldRt2 INTEGER, @p_OldRt3 INTEGER,  @p_NumCpf BIGINT) AS
BEGIN
DECLARE @l_datatu_cra DATETIME
DECLARE @l_horatu_cra SMALLINT
DECLARE @l_datstr_cra CHAR(6)
DECLARE @l_horstr_cra CHAR(4)
DECLARE @l_seqenv_cra SMALLINT
DECLARE @l_seqstr_cra CHAR(2)
DECLARE @l_datatustr_cra CHAR(16)
DECLARE @l_cratit BIGINT
DECLARE @l_numbar BIGINT
DECLARE @l_numpro BIGINT
DECLARE @l_numsma BIGINT
DECLARE @l_tecpri SMALLINT
DECLARE @l_crapri BIGINT
DECLARE @l_crapro BIGINT
DECLARE @l_tippes SMALLINT
DECLARE @l_numemp SMALLINT
DECLARE @l_tipcol SMALLINT
DECLARE @l_numcad INTEGER
DECLARE @l_tipdoc SMALLINT
DECLARE @l_numdoc VARCHAR(20)
DECLARE @l_nummat VARCHAR(15)
DECLARE @l_propac VARCHAR(20)
DECLARE @l_count INTEGER
DECLARE @l_pltrlg VARCHAR(MAX)
DECLARE @l_prmlst VARCHAR(MAX)
DECLARE @l_prmdel INTEGER
DECLARE @l_r058rlp_CODPRM INTEGER
DECLARE @l_r058rlp_CODPLT INTEGER
DECLARE @l_r058rlp_CODRLG INTEGER
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @SE_EXC2 INTEGER
  SELECT @ChkError = 0
  IF (@p_tipOpe='A' OR @p_tipope='H' OR @p_tipope='I')
  BEGIN
    /* TRY */
      SELECT 
      @l_count=COUNT(b.numeip) 
       FROM r058rlp a,r058rlg b,r058mod d,r058dsp f
       WHERE a.codprm in (@p_codprm,@p_prmsab,@p_prmdom,@p_prmfer,@p_prmrt1,@p_prmrt2,@p_prmrt3) 
      and a.codplt=b.codplt 
      and a.codrlg=b.codrlg 
      and b.modrlg=d.modrlg 
      and b.comrlg=2 
      and d.clamod=13 
      and b.coddsp 
      not  in (select 
      f.coddsp f_coddsp
       from r058rlp e,r058rlg f,r058mod h
       where e.codprm in (@p_oldprm,@p_oldsab,@p_olddom,@p_oldfer,@p_oldrt1,@p_oldrt2,@p_oldrt3) 
      and e.codplt=f.codplt 
      and e.codrlg=f.codrlg 
      and f.modrlg=h.modrlg 
      and f.comrlg=2 
      and h.clamod=13 ) 
      and b.coddsp 
      not  in (select 
      g.coddsp g_coddsp
       from r058rlg g,r058mod h,r034prm i
       where g.modrlg=h.modrlg 
      and g.comrlg=2 
      and h.clamod=13 
      and g.codplt=i.codplt 
      and g.codrlg=i.codrlg 
      and i.idtpes=@p_idtpes ) 
      and f.coddsp=b.coddsp 
      and f.stadsp=1
      SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
      IF @ChkError <> 0
      BEGIN
        GOTO EXC1
      END
    /* END TRY */
    /* BEGIN EXCEPTION HANDLER */
      EXC1:
      SELECT @SE_EXC1 = @ChkError
      IF @ChkError <> 0
      BEGIN
        BEGIN
          SELECT @ChkError = 0
          SELECT @l_count = 0
        END
      END
    /* END EXCEPTION HANDLER */
    IF (@l_count=0)
    BEGIN
      /* TRY */
        SELECT 
      @l_count=COUNT(c.numeip) 
       FROM r058grp a,r058grl b,r058rlg c,r058mod d,r058dsp f
       WHERE a.codprm in (@p_codprm,@p_prmsab,@p_prmdom,@p_prmfer,@p_prmrt1,@p_prmrt2,@p_prmrt3) 
      and a.codgrr=b.codgrr 
      and b.codplt=c.codplt 
      and b.codrlg=c.codrlg 
      and c.comrlg=2 
      and c.modrlg=d.modrlg 
      and d.clamod=13 
      and c.coddsp 
      not  in (select 
      g.coddsp g_coddsp
       from r058grp e,r058grl f,r058rlg g,r058mod h
       where e.codprm in (@p_oldprm,@p_oldsab,@p_olddom,@p_oldfer,@p_oldrt1,@p_oldrt2,@p_oldrt3) 
      and e.codgrr=f.codgrr 
      and f.codplt=g.codplt 
      and f.codrlg=g.codrlg 
      and g.comrlg=2 
      and g.modrlg=h.modrlg 
      and h.clamod=13 ) 
      and c.coddsp 
      not  in (select 
      i.coddsp i_coddsp
       from r058rlg i,r058mod j,r034prm k
       where i.modrlg=j.modrlg 
      and i.comrlg=2 
      and j.clamod=13 
      and i.codplt=k.codplt 
      and i.codrlg=k.codrlg 
      and k.idtpes=@p_idtpes ) 
      and f.coddsp=c.coddsp 
      and f.stadsp=1
        SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
        IF @ChkError <> 0
        BEGIN
          GOTO EXC2
        END
      /* END TRY */
      /* BEGIN EXCEPTION HANDLER */
        EXC2:
        SELECT @SE_EXC2 = @ChkError
        IF @ChkError <> 0
        BEGIN
          BEGIN
            SELECT @ChkError = 0
            SELECT @l_count = 0
          END
        END
      /* END EXCEPTION HANDLER */
    END
  END
  ELSE
  BEGIN
    SELECT @l_count = 1
  END
  IF (@l_count>0)
  BEGIN
    SELECT @l_datatu_cra = CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(MM, GETDATE())))) + '/' + LTRIM(RTRIM(STR(DATEPART(DD, GETDATE())))) + '/' + LTRIM(RTRIM(STR(DATEPART(YY, GETDATE())))))
    SELECT @l_horatu_cra = DATEPART(HOUR,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))*60+DATEPART(MINUTE,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))
    SELECT @l_seqenv_cra = DATEPART(ss,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))
    EXECUTE  @ChkError = SP_DATSTR @l_datatu_cra,'DDMMYY',@l_datstr_cra OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    EXECUTE  @ChkError = SP_INTSTR @l_horatu_cra,'HHMM',@l_horstr_cra OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    EXECUTE  @ChkError = SP_INTSTR @l_seqenv_cra,'99',@l_seqstr_cra OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    SELECT @l_datatustr_cra = @l_datstr_cra+@l_horstr_cra+@l_seqstr_cra+'0000'
    EXECUTE  @ChkError = SP_PESFROMIDTPES @p_idtpes,@l_tippes OUTPUT ,@l_numemp OUTPUT ,@l_tipcol OUTPUT ,@l_numcad OUTPUT ,@l_tipdoc OUTPUT ,@l_numdoc OUTPUT ,@l_nummat OUTPUT ,@l_propac OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
	SELECT @l_crapro = 0;
    EXECUTE  @ChkError = SP_RetCra 2,@l_numemp,@l_tipcol,@l_numcad,0,0,0,'',@l_crapro OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    EXECUTE  @ChkError = SP_MAPFIS @l_crapro,@l_numbar OUTPUT ,@l_numpro OUTPUT ,@l_numsma OUTPUT ,@l_tecpri OUTPUT ,@l_crapri OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    IF (@p_tipope='B' OR @p_tipope='X' OR @p_tipope='D')
    BEGIN
      SELECT @l_pltrlg = ' '
      SELECT @l_prmlst = ' '
      DECLARE c_r058rlp CURSOR FOR SELECT 
      DISTINCT
      a.codprm A_CODPRM,a.codplt A_CODPLT,a.codrlg A_CODRLG
       FROM r058rlp a,r058rlg b,r058mod c
       WHERE a.codprm in (@p_oldprm,@p_oldsab,@p_olddom,@p_oldfer,@p_oldrt1,@p_oldrt2,@p_oldrt3) 
      and b.modrlg=c.modrlg 
      and c.clamod=13
       UNION SELECT 
      DISTINCT
      d.codprm D_CODPRM,e.codplt E_CODPLT,e.codrlg E_CODRLG
       FROM r058grp d,r058grl e,r058rlg f,r058mod g
       WHERE d.codprm in (@p_oldprm,@p_oldsab,@p_olddom,@p_oldfer,@p_oldrt1,@p_oldrt2,@p_oldrt3) 
      and d.codgrr=e.codgrr 
      and e.codrlg=f.codrlg 
      and f.modrlg=g.modrlg 
      and g.clamod=13 
      OPEN c_r058rlp
      FETCH NEXT FROM c_r058rlp INTO @l_r058rlp_codprm, @l_r058rlp_codplt, @l_r058rlp_codrlg
      WHILE  (@@FETCH_STATUS = 0)
      BEGIN
        SELECT @l_prmdel = @l_r058rlp_codprm
        IF ((CHARINDEX(SUBSTRING(',('+CONVERT(VARCHAR,@l_r058rlp_codplt)+','+CONVERT(VARCHAR,@l_r058rlp_codrlg)+'),',1,255),@l_pltrlg)=0) 
      AND (CHARINDEX(SUBSTRING(','+CONVERT(VARCHAR,@l_prmdel)+',',1,255),@l_prmlst)=0))
        BEGIN
          IF (@l_pltrlg=' ')
          BEGIN
            SELECT @l_pltrlg = ',('+CONVERT(VARCHAR,@l_r058rlp_codplt)+','+CONVERT(VARCHAR,@l_r058rlp_codrlg)+'),'
          END
          ELSE
          BEGIN
            SELECT @l_pltrlg = @l_pltrlg+'('+CONVERT(VARCHAR,@l_r058rlp_codplt)+','+CONVERT(VARCHAR,@l_r058rlp_codrlg)+'),'
          END
          IF (@l_prmlst=' ')
          BEGIN
            SELECT @l_prmlst = ','+CONVERT(VARCHAR,@l_prmdel)+','
          END
          ELSE
          BEGIN
            SELECT @l_prmlst = @l_prmlst+CONVERT(VARCHAR,@l_prmdel)+','
          END
          IF (@l_numbar<>0)
          BEGIN
            EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_crapro,@l_numbar,1,@p_VerPrm,@l_prmdel,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,0,0,0,0,0,0,0,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
            IF @ChkError <> 0
            BEGIN
              GOTO FNc_r058rlp3
            END
          END
          IF (@l_numpro<>0)
          BEGIN
            EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_crapro,@l_numpro,2,@p_VerPrm,@l_prmdel,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,0,0,0,0,0,0,0,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
            IF @ChkError <> 0
            BEGIN
              GOTO FNc_r058rlp3
            END
          END
          IF (@l_numsma<>0)
          BEGIN
            EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_crapro,@l_numsma,3,@p_VerPrm,@l_prmdel,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,0,0,0,0,0,0,0,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
            IF @ChkError <> 0
            BEGIN
              GOTO FNc_r058rlp3
            END
          END
          IF (@l_numbar=0) 
      AND (@l_numpro=0) 
      AND (@l_numsma=0) 
      AND (@l_crapro<>0)
          BEGIN
            EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_crapro,@l_crapro,1,@p_VerPrm,@l_prmdel,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,0,0,0,0,0,0,0,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
            IF @ChkError <> 0
            BEGIN
              GOTO FNc_r058rlp3
            END
          END
        END
        FETCH NEXT FROM c_r058rlp INTO @l_r058rlp_codprm, @l_r058rlp_codplt, @l_r058rlp_codrlg
      END
      FNc_r058rlp3: /* FINALLY OPEN CURSOR */
      CLOSE c_r058rlp
      DEALLOCATE c_r058rlp
      IF @ChkError <> 0
        GOTO FIM
    END
    ELSE
    BEGIN
      IF (@l_numbar<>0)
      BEGIN
        EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_crapro,@l_numbar,1,@p_VerPrm,0,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,@p_OldPrm,@p_OldSab,@p_OldDom,@p_OldFer,@p_OldRt1,@p_OldRt2,@p_OldRt3,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
        IF @ChkError <> 0
        BEGIN
          GOTO FIM
        END
      END
      IF (@l_numpro<>0)
      BEGIN
        EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_crapro,@l_numpro,2,@p_VerPrm,0,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,@p_OldPrm,@p_OldSab,@p_OldDom,@p_OldFer,@p_OldRt1,@p_OldRt2,@p_OldRt3,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
        IF @ChkError <> 0
        BEGIN
          GOTO FIM
        END
      END
      IF (@l_numsma<>0)
      BEGIN
        EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_crapro,@l_numsma,3,@p_VerPrm,0,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,@p_OldPrm,@p_OldSab,@p_OldDom,@p_OldFer,@p_OldRt1,@p_OldRt2,@p_OldRt3,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
        IF @ChkError <> 0
        BEGIN
          GOTO FIM
        END
      END
      IF (@l_numbar=0) 
      AND (@l_numpro=0) 
      AND (@l_numsma=0) 
      AND (@l_crapro<>0)
      BEGIN
        EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_crapro,@l_crapro,1,@p_VerPrm,0,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,@p_OldPrm,@p_OldSab,@p_OldDom,@p_OldFer,@p_OldRt1,@p_OldRt2,@p_OldRt3,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
        IF @ChkError <> 0
        BEGIN
          GOTO FIM
        END
      END
    END
	if (@l_crapro = 0)
	BEGIN
		EXECUTE  @ChkError = SP_RetCra 1,@l_numemp,@l_tipcol,@l_numcad,0,0,0,'',@l_cratit OUTPUT  
		IF @ChkError <> 0
		BEGIN
		  GOTO FIM
		END
		EXECUTE  @ChkError = SP_MAPFIS @l_cratit,@l_numbar OUTPUT ,@l_numpro OUTPUT ,@l_numsma OUTPUT ,@l_tecpri OUTPUT ,@l_crapri OUTPUT  
		IF @ChkError <> 0
		BEGIN
		  GOTO FIM
		END
		IF (@p_tipope='B' OR @p_tipope='X' OR @p_tipope='D')
		BEGIN
		  SELECT @l_pltrlg = ' '
		  SELECT @l_prmlst = ' '
		  DECLARE c_r058rlp CURSOR FOR SELECT 
		  DISTINCT
		  a.codprm A_CODPRM,a.codplt A_CODPLT,a.codrlg A_CODRLG
		   FROM r058rlp a,r058rlg b,r058mod c
		   WHERE a.codprm in (@p_oldprm,@p_oldsab,@p_olddom,@p_oldfer,@p_oldrt1,@p_oldrt2,@p_oldrt3) 
		  and b.modrlg=c.modrlg 
		  and c.clamod=13
		   UNION SELECT 
		  DISTINCT
		  d.codprm D_CODPRM,e.codplt E_CODPLT,e.codrlg E_CODRLG
		   FROM r058grp d,r058grl e,r058rlg f,r058mod g
		   WHERE d.codprm in (@p_oldprm,@p_oldsab,@p_olddom,@p_oldfer,@p_oldrt1,@p_oldrt2,@p_oldrt3) 
		  and d.codgrr=e.codgrr 
		  and e.codrlg=f.codrlg 
		  and f.modrlg=g.modrlg 
		  and g.clamod=13 
		  OPEN c_r058rlp
		  FETCH NEXT FROM c_r058rlp INTO @l_r058rlp_codprm, @l_r058rlp_codplt, @l_r058rlp_codrlg
		  WHILE  (@@FETCH_STATUS = 0)
		  BEGIN
			SELECT @l_prmdel = @l_r058rlp_codprm
			IF ((CHARINDEX(SUBSTRING(',('+CONVERT(VARCHAR,@l_r058rlp_codplt)+','+CONVERT(VARCHAR,@l_r058rlp_codrlg)+'),',1,255),@l_pltrlg)=0) 
		  AND (CHARINDEX(SUBSTRING(','+CONVERT(VARCHAR,@l_prmdel)+',',1,255),@l_prmlst)=0))
			BEGIN
			  IF (@l_pltrlg=' ')
			  BEGIN
				SELECT @l_pltrlg = ',('+CONVERT(VARCHAR,@l_r058rlp_codplt)+','+CONVERT(VARCHAR,@l_r058rlp_codrlg)+'),'
			  END
			  ELSE
			  BEGIN
				SELECT @l_pltrlg = @l_pltrlg+'('+CONVERT(VARCHAR,@l_r058rlp_codplt)+','+CONVERT(VARCHAR,@l_r058rlp_codrlg)+'),'
			  END
			  IF (@l_prmlst=' ')
			  BEGIN
				SELECT @l_prmlst = ','+CONVERT(VARCHAR,@l_prmdel)+','
			  END
			  ELSE
			  BEGIN
				SELECT @l_prmlst = @l_prmlst+CONVERT(VARCHAR,@l_prmdel)+','
			  END
			  IF (@l_numbar<>0)
			  BEGIN
				EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_cratit,@l_numbar,1,@p_VerPrm,@l_prmdel,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,0,0,0,0,0,0,0,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
				IF @ChkError <> 0
				BEGIN
				  GOTO FNc_r058rlp4
				END
			  END
			  IF (@l_numpro<>0)
			  BEGIN
				EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_cratit,@l_numpro,2,@p_VerPrm,@l_prmdel,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,0,0,0,0,0,0,0,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
				IF @ChkError <> 0
				BEGIN
				  GOTO FNc_r058rlp4
				END
			  END
			  IF (@l_numsma<>0)
			  BEGIN
				EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_cratit,@l_numsma,3,@p_VerPrm,@l_prmdel,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,0,0,0,0,0,0,0,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
				IF @ChkError <> 0
				BEGIN
				  GOTO FNc_r058rlp4
				END
			  END
			  IF (@l_numbar=0) 
		  AND (@l_numpro=0) 
		  AND (@l_numsma=0) 
		  AND (@l_cratit<>0)
			  BEGIN
				EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_cratit,@l_cratit,1,@p_VerPrm,@l_prmdel,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,0,0,0,0,0,0,0,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
				IF @ChkError <> 0
				BEGIN
				  GOTO FNc_r058rlp4
				END
			  END
			END
			FETCH NEXT FROM c_r058rlp INTO @l_r058rlp_codprm, @l_r058rlp_codplt, @l_r058rlp_codrlg
		  END
		  FNc_r058rlp4: /* FINALLY OPEN CURSOR */
		  CLOSE c_r058rlp
		  DEALLOCATE c_r058rlp
		  IF @ChkError <> 0
			GOTO FIM
		END
		ELSE
		BEGIN
		  IF (@l_numbar<>0)
		  BEGIN
			EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_cratit,@l_numbar,1,@p_VerPrm,0,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,@p_OldPrm,@p_OldSab,@p_OldDom,@p_OldFer,@p_OldRt1,@p_OldRt2,@p_OldRt3,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
			IF @ChkError <> 0
			BEGIN
			  GOTO FIM
			END
		  END
		  IF (@l_numpro<>0)
		  BEGIN
			EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_cratit,@l_numpro,2,@p_VerPrm,0,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,@p_OldPrm,@p_OldSab,@p_OldDom,@p_OldFer,@p_OldRt1,@p_OldRt2,@p_OldRt3,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
			IF @ChkError <> 0
			BEGIN
			  GOTO FIM
			END
		  END
		  IF (@l_numsma<>0)
		  BEGIN
			EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_cratit,@l_numsma,3,@p_VerPrm,0,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,@p_OldPrm,@p_OldSab,@p_OldDom,@p_OldFer,@p_OldRt1,@p_OldRt2,@p_OldRt3,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
			IF @ChkError <> 0
			BEGIN
			  GOTO FIM
			END
		  END
		  IF (@l_numbar=0) 
		  AND (@l_numpro=0) 
		  AND (@l_numsma=0) 
		  AND (@l_cratit<>0)
		  BEGIN
			EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_cratit,@l_cratit,1,@p_VerPrm,0,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,@p_OldPrm,@p_OldSab,@p_OldDom,@p_OldFer,@p_OldRt1,@p_OldRt2,@p_OldRt3,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
			IF @ChkError <> 0
			BEGIN
			  GOTO FIM
			END
		  END
		END
	END
  END
FIM:
  RETURN @ChkError
END

	MSSQL;23JSP_DATSTR
SP_INTSTR
SP_MAPFIS
SP_PESFROMIDTPES
SP_R070ACR
SP_RETCRA
­F␀␀CREATE  PROCEDURE SP_DELINSCRA70ACR(@p_tipope VARCHAR(1), @p_VerPrm SMALLINT, @p_CodPrm INTEGER, @p_PrmSab INTEGER, @p_PrmDom INTEGER, @p_PrmFer INTEGER, @p_PrmRt1 INTEGER, @p_PrmRt2 INTEGER, @p_PrmRt3 INTEGER, @p_IdtPes CHAR(23), @p_NomFun VARCHAR(40), @p_NumPis BIGINT, @p_AltBio SMALLINT, @p_RemRep SMALLINT, @p_TipLis SMALLINT, @p_OldPrm INTEGER, @p_OldSab INTEGER, @p_OldDom INTEGER, @p_OldFer INTEGER, @p_OldRt1 INTEGER, @p_OldRt2 INTEGER, @p_OldRt3 INTEGER,  @p_NumCpf BIGINT) AS
BEGIN
DECLARE @l_datatu_cra DATETIME
DECLARE @l_horatu_cra SMALLINT
DECLARE @l_datstr_cra CHAR(6)
DECLARE @l_horstr_cra CHAR(4)
DECLARE @l_seqenv_cra SMALLINT
DECLARE @l_seqstr_cra CHAR(2)
DECLARE @l_datatustr_cra CHAR(16)
DECLARE @l_cratit BIGINT
DECLARE @l_numbar BIGINT
DECLARE @l_numpro BIGINT
DECLARE @l_numsma BIGINT
DECLARE @l_tecpri SMALLINT
DECLARE @l_crapri BIGINT
DECLARE @l_crapro BIGINT
DECLARE @l_tippes SMALLINT
DECLARE @l_numemp SMALLINT
DECLARE @l_tipcol SMALLINT
DECLARE @l_numcad INTEGER
DECLARE @l_tipdoc SMALLINT
DECLARE @l_numdoc VARCHAR(20)
DECLARE @l_nummat VARCHAR(15)
DECLARE @l_propac VARCHAR(20)
DECLARE @l_count INTEGER
DECLARE @l_pltrlg VARCHAR(MAX)
DECLARE @l_prmlst VARCHAR(MAX)
DECLARE @l_prmdel INTEGER
DECLARE @l_r058rlp_CODPRM INTEGER
DECLARE @l_r058rlp_CODPLT INTEGER
DECLARE @l_r058rlp_CODRLG INTEGER
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @SE_EXC2 INTEGER
  SELECT @ChkError = 0
  IF (@p_tipOpe='A' OR @p_tipope='H' OR @p_tipope='I')
  BEGIN
    /* TRY */
      SELECT 
      @l_count=COUNT(b.numeip) 
       FROM r058rlp a,r058rlg b,r058mod d,r058dsp f
       WHERE a.codprm in (@p_codprm,@p_prmsab,@p_prmdom,@p_prmfer,@p_prmrt1,@p_prmrt2,@p_prmrt3) 
      and a.codplt=b.codplt 
      and a.codrlg=b.codrlg 
      and b.modrlg=d.modrlg 
      and b.comrlg=2 
      and d.clamod=13 
      and b.coddsp 
      not  in (select 
      f.coddsp f_coddsp
       from r058rlp e,r058rlg f,r058mod h
       where e.codprm in (@p_oldprm,@p_oldsab,@p_olddom,@p_oldfer,@p_oldrt1,@p_oldrt2,@p_oldrt3) 
      and e.codplt=f.codplt 
      and e.codrlg=f.codrlg 
      and f.modrlg=h.modrlg 
      and f.comrlg=2 
      and h.clamod=13 ) 
      and b.coddsp 
      not  in (select 
      g.coddsp g_coddsp
       from r058rlg g,r058mod h,r034prm i
       where g.modrlg=h.modrlg 
      and g.comrlg=2 
      and h.clamod=13 
      and g.codplt=i.codplt 
      and g.codrlg=i.codrlg 
      and i.idtpes=@p_idtpes ) 
      and f.coddsp=b.coddsp 
      and f.stadsp=1
      SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
      IF @ChkError <> 0
      BEGIN
        GOTO EXC1
      END
    /* END TRY */
    /* BEGIN EXCEPTION HANDLER */
      EXC1:
      SELECT @SE_EXC1 = @ChkError
      IF @ChkError <> 0
      BEGIN
        BEGIN
          SELECT @ChkError = 0
          SELECT @l_count = 0
        END
      END
    /* END EXCEPTION HANDLER */
    IF (@l_count=0)
    BEGIN
      /* TRY */
        SELECT 
      @l_count=COUNT(c.numeip) 
       FROM r058grp a,r058grl b,r058rlg c,r058mod d,r058dsp f
       WHERE a.codprm in (@p_codprm,@p_prmsab,@p_prmdom,@p_prmfer,@p_prmrt1,@p_prmrt2,@p_prmrt3) 
      and a.codgrr=b.codgrr 
      and b.codplt=c.codplt 
      and b.codrlg=c.codrlg 
      and c.comrlg=2 
      and c.modrlg=d.modrlg 
      and d.clamod=13 
      and c.coddsp 
      not  in (select 
      g.coddsp g_coddsp
       from r058grp e,r058grl f,r058rlg g,r058mod h
       where e.codprm in (@p_oldprm,@p_oldsab,@p_olddom,@p_oldfer,@p_oldrt1,@p_oldrt2,@p_oldrt3) 
      and e.codgrr=f.codgrr 
      and f.codplt=g.codplt 
      and f.codrlg=g.codrlg 
      and g.comrlg=2 
      and g.modrlg=h.modrlg 
      and h.clamod=13 ) 
      and c.coddsp 
      not  in (select 
      i.coddsp i_coddsp
       from r058rlg i,r058mod j,r034prm k
       where i.modrlg=j.modrlg 
      and i.comrlg=2 
      and j.clamod=13 
      and i.codplt=k.codplt 
      and i.codrlg=k.codrlg 
      and k.idtpes=@p_idtpes ) 
      and f.coddsp=c.coddsp 
      and f.stadsp=1
        SELECT @ChkError = CASE @@RowCount WHEN 0 THEN -50 WHEN 1 THEN 0 ELSE 512 END
        IF @ChkError <> 0
        BEGIN
          GOTO EXC2
        END
      /* END TRY */
      /* BEGIN EXCEPTION HANDLER */
        EXC2:
        SELECT @SE_EXC2 = @ChkError
        IF @ChkError <> 0
        BEGIN
          BEGIN
            SELECT @ChkError = 0
            SELECT @l_count = 0
          END
        END
      /* END EXCEPTION HANDLER */
    END
  END
  ELSE
  BEGIN
    SELECT @l_count = 1
  END
  IF (@l_count>0)
  BEGIN
    SELECT @l_datatu_cra = CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(MM, GETDATE())))) + '/' + LTRIM(RTRIM(STR(DATEPART(DD, GETDATE())))) + '/' + LTRIM(RTRIM(STR(DATEPART(YY, GETDATE())))))
    SELECT @l_horatu_cra = DATEPART(HOUR,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))*60+DATEPART(MINUTE,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))
    SELECT @l_seqenv_cra = DATEPART(ss,CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(HOUR, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(MINUTE, GETDATE())))) + ':' + LTRIM(RTRIM(STR(DATEPART(SECOND, GETDATE()))))))
    EXECUTE  @ChkError = SP_DATSTR @l_datatu_cra,'DDMMYY',@l_datstr_cra OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    EXECUTE  @ChkError = SP_INTSTR @l_horatu_cra,'HHMM',@l_horstr_cra OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    EXECUTE  @ChkError = SP_INTSTR @l_seqenv_cra,'99',@l_seqstr_cra OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    SELECT @l_datatustr_cra = @l_datstr_cra+@l_horstr_cra+@l_seqstr_cra+'0000'
    EXECUTE  @ChkError = SP_PESFROMIDTPES @p_idtpes,@l_tippes OUTPUT ,@l_numemp OUTPUT ,@l_tipcol OUTPUT ,@l_numcad OUTPUT ,@l_tipdoc OUTPUT ,@l_numdoc OUTPUT ,@l_nummat OUTPUT ,@l_propac OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
	SELECT @l_crapro = 0;
    EXECUTE  @ChkError = SP_RetCra 2,@l_numemp,@l_tipcol,@l_numcad,0,0,0,'',@l_crapro OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    EXECUTE  @ChkError = SP_MAPFIS @l_crapro,@l_numbar OUTPUT ,@l_numpro OUTPUT ,@l_numsma OUTPUT ,@l_tecpri OUTPUT ,@l_crapri OUTPUT  
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
    IF (@p_tipope='B' OR @p_tipope='X' OR @p_tipope='D')
    BEGIN
      SELECT @l_pltrlg = ' '
      SELECT @l_prmlst = ' '
      DECLARE c_r058rlp CURSOR FOR SELECT 
      DISTINCT
      a.codprm A_CODPRM,a.codplt A_CODPLT,a.codrlg A_CODRLG
       FROM r058rlp a,r058rlg b,r058mod c
       WHERE a.codprm in (@p_oldprm,@p_oldsab,@p_olddom,@p_oldfer,@p_oldrt1,@p_oldrt2,@p_oldrt3) 
      and b.modrlg=c.modrlg 
      and c.clamod=13
       UNION SELECT 
      DISTINCT
      d.codprm D_CODPRM,e.codplt E_CODPLT,e.codrlg E_CODRLG
       FROM r058grp d,r058grl e,r058rlg f,r058mod g
       WHERE d.codprm in (@p_oldprm,@p_oldsab,@p_olddom,@p_oldfer,@p_oldrt1,@p_oldrt2,@p_oldrt3) 
      and d.codgrr=e.codgrr 
      and e.codrlg=f.codrlg 
      and f.modrlg=g.modrlg 
      and g.clamod=13 
      OPEN c_r058rlp
      FETCH NEXT FROM c_r058rlp INTO @l_r058rlp_codprm, @l_r058rlp_codplt, @l_r058rlp_codrlg
      WHILE  (@@FETCH_STATUS = 0)
      BEGIN
        SELECT @l_prmdel = @l_r058rlp_codprm
        IF ((CHARINDEX(SUBSTRING(',('+CONVERT(VARCHAR,@l_r058rlp_codplt)+','+CONVERT(VARCHAR,@l_r058rlp_codrlg)+'),',1,255),@l_pltrlg)=0) 
      AND (CHARINDEX(SUBSTRING(','+CONVERT(VARCHAR,@l_prmdel)+',',1,255),@l_prmlst)=0))
        BEGIN
          IF (@l_pltrlg=' ')
          BEGIN
            SELECT @l_pltrlg = ',('+CONVERT(VARCHAR,@l_r058rlp_codplt)+','+CONVERT(VARCHAR,@l_r058rlp_codrlg)+'),'
          END
          ELSE
          BEGIN
            SELECT @l_pltrlg = @l_pltrlg+'('+CONVERT(VARCHAR,@l_r058rlp_codplt)+','+CONVERT(VARCHAR,@l_r058rlp_codrlg)+'),'
          END
          IF (@l_prmlst=' ')
          BEGIN
            SELECT @l_prmlst = ','+CONVERT(VARCHAR,@l_prmdel)+','
          END
          ELSE
          BEGIN
            SELECT @l_prmlst = @l_prmlst+CONVERT(VARCHAR,@l_prmdel)+','
          END
          IF (@l_numbar<>0)
          BEGIN
            EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_crapro,@l_numbar,1,@p_VerPrm,@l_prmdel,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,0,0,0,0,0,0,0,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
            IF @ChkError <> 0
            BEGIN
              GOTO FNc_r058rlp3
            END
          END
          IF (@l_numpro<>0)
          BEGIN
            EXECUTE  @ChkError = SP_R070ACR @p_tipope,@l_crapro,@l_numpro,2,@p_VerPrm,@l_prmdel,@p_CodPrm,@p_PrmSab,@p_PrmDom,@p_PrmFer,@p_PrmRt1,@p_PrmRt2,@p_PrmRt3,0,0,0,0,0,0,0,@l_datatustr_cra,@p_Idtpes,@p_NomFun,@p_NumPis,@p_AltBio,@p_RemRep,@p_TipLis,@p_NumCpf 
            IF @ChkError <> 0
            BEGIN
