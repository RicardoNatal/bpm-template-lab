PROCEDURE SP_DELCONTROLE (P_NUMFIS IN NUMBER, P_DATVAL IN VARCHAR(16))
 IS

l_icardpri    VARCHAR2(12);
l_Comando     VARCHAR2(200);
l_datahora    VARCHAR2(10);
BEGIN  
  SP_INTSTR(p_numfis, '999999999999',l_icardpri OUT);
  l_datahora := SUBSTRING(p_datval,1,10);
  l_comando := 'DELETE CONTROLE WHERE ICARD = '''||l_icardpri||''' AND DATAHORA = '''||l_datahora||'''';
