eS␀␀CREATE  PROCEDURE sp_sinaud(@p_tipope SMALLINT, @p_numemp SMALLINT, @p_tipcol SMALLINT, @p_numcad INTEGER, @p_datini DATETIME, @p_horini SMALLINT, @p_numcra BIGINT, @p_datfim DATETIME, @p_horfim SMALLINT, @p_codusu BIGINT, @p_RetSin SMALLINT OUTPUT) AS
BEGIN
DECLARE @l_temaud SMALLINT
DECLARE @l_coderr SMALLINT
DECLARE @l_codrpa BIGINT
DECLARE @l_datatu DATETIME
DECLARE @l_horatu INTEGER
DECLARE @l_datzer DATETIME
DECLARE @l_datfimant DATETIME
DECLARE @l_horfimant SMALLINT
DECLARE @l_staaccant SMALLINT
DECLARE @l_staatuant SMALLINT
DECLARE @l_numempstr VARCHAR(255)
DECLARE @l_tipcolstr VARCHAR(255)
DECLARE @l_numcadstr VARCHAR(255)
DECLARE @l_datinistr VARCHAR(255)
DECLARE @l_horinistr VARCHAR(255)
DECLARE @l_numcrastr VARCHAR(255)
DECLARE @l_oldnumcra VARCHAR(255)
DECLARE @l_datfimstr VARCHAR(255)
DECLARE @l_olddatfim VARCHAR(255)
DECLARE @l_horfimstr VARCHAR(255)
DECLARE @l_oldhorfim VARCHAR(255)
DECLARE @l_staacc VARCHAR(255)
DECLARE @l_oldstaacc VARCHAR(255)
DECLARE @l_staatu VARCHAR(255)
DECLARE @l_oldstaatu VARCHAR(255)
DECLARE @l_tamstr SMALLINT
  DECLARE @ChkError INTEGER
  DECLARE @SE_EXC1 INTEGER
  DECLARE @SE_EXC2 INTEGER
  DECLARE @SE_EXC3 INTEGER
  DECLARE @SE_EXC4 INTEGER
  DECLARE @SE_EXC5 INTEGER
  DECLARE @SE_EXC6 INTEGER
  DECLARE @SE_EXC7 INTEGER
  DECLARE @SE_EXC8 INTEGER
  DECLARE @SE_EXC9 INTEGER
  DECLARE @SE_EXC10 INTEGER
  SELECT @ChkError = 0
  SELECT @p_RetSin = 0
  SELECT @l_coderr = 0
  SELECT @l_datatu = CONVERT(DATETIME,LTRIM(RTRIM(STR(DATEPART(MM, GETDATE()))))+ '/' + LTRIM(RTRIM(STR(DATEPART(DD, GETDATE()))))+ '/' + LTRIM(RTRIM(STR(DATEPART(YY, GETDATE())))))

  select @l_horatu = (datepart(hour, CURRENT_TIMESTAMP) * 3600) +
                     (datepart(minute, CURRENT_TIMESTAMP) *60 )  +
                     (datepart(second, CURRENT_TIMESTAMP))

  SELECT @l_datzer =  CONVERT(DATETIME,'12/31/1900 00:00:00', 101)
  SELECT @l_tamstr = DATALENGTH(@p_numemp)
  IF (@l_tamstr=1)
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @p_numemp,'9',@l_numempSTR OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  IF (@l_tamstr=2)
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @p_numemp,'99',@l_numempSTR OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  IF (@l_tamstr=3)
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @p_numemp,'999',@l_numempSTR OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  IF (@l_tamstr=4)
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @p_numemp,'9999',@l_numempSTR OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  EXECUTE  @ChkError = SP_INTSTR @p_tipcol,'9',@l_tipcolSTR OUTPUT
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  SELECT @l_tamstr = DATALENGTH(@p_numcad)
  IF (@l_tamstr=1)
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @p_numcad,'9',@l_numcadSTR OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  IF (@l_tamstr=2)
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @p_numcad,'99',@l_numcadSTR OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  IF (@l_tamstr=3)
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @p_numcad,'999',@l_numcadSTR OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  IF (@l_tamstr=4)
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @p_numcad,'9999',@l_numcadSTR OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  IF (@l_tamstr=5)
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @p_numcad,'99999',@l_numcadSTR OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  IF (@l_tamstr=6)
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @p_numcad,'999999',@l_numcadSTR OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  IF (@l_tamstr=7)
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @p_numcad,'9999999',@l_numcadSTR OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  IF (@l_tamstr=8)
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @p_numcad,'99999999',@l_numcadSTR OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  IF (@l_tamstr=9)
  BEGIN
    EXECUTE  @ChkError = SP_INTSTR @p_numcad,'999999999',@l_numcadSTR OUTPUT
    IF @ChkError <> 0
    BEGIN
      GOTO FIM
    END
  END
  EXECUTE  @ChkError = SP_INTSTR @p_numcra,'999999999999',@l_numcraSTR OUTPUT
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  EXECUTE  @ChkError = SP_DATSTR @p_datini,'DDMMYY',@l_datiniSTR OUTPUT
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  SELECT @l_datiniSTR = SUBSTRING(@l_datiniSTR,1,2)+'/'+SUBSTRING(@l_datiniSTR,3,2)+'/20'+SUBSTRING(@l_datiniSTR,5,2)
  EXECUTE  @ChkError = SP_INTSTR @p_horini,'HHMM',@l_horiniSTR OUTPUT
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  SELECT @l_horiniSTR = SUBSTRING(@l_horiniSTR,1,2)+':'+SUBSTRING(@l_horiniSTR,3,2)
  EXECUTE  @ChkError = SP_DATSTR @p_datfim,'DDMMYY',@l_datfimSTR OUTPUT
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  SELECT @l_datfimSTR = SUBSTRING(@l_datfimSTR,1,2)+'/'+SUBSTRING(@l_datfimSTR,3,2)+'/20'+SUBSTRING(@l_datfimSTR,5,2)
  EXECUTE  @ChkError = SP_INTSTR @p_horfim,'HHMM',@l_horfimSTR OUTPUT
  IF @ChkError <> 0
  BEGIN
    GOTO FIM
  END
  SELECT @l_horfimSTR = SUBSTRING(@l_horfimSTR,1,2)+':'+SUBSTRING(@l_horfimSTR,3,2)
  IF (@p_DatIni>@l_datatu)
      OR ((@p_DatIni=@l_datatu)
      and (@p_HorIni>@l_horatu))
  BEGIN
    SELECT @l_staAtu = '0'
    SELECT @l_staAcc = '0'
  END
  ELSE
  BEGIN
    IF (@p_DatFim<>@l_datzer)
      AND ((@p_DatFim<@l_datatu)
      OR ((@p_DatFim=@l_datatu)
      AND ((@p_HorFim<=@l_horatu)
      AND (@p_HorFim<>0))))
    BEGIN
      SELECT @l_StaAtu = '2'
      SELECT @l_StaAcc = '2'
    END
    ELSE
    BEGIN
      SELECT @l_StaAtu = '1'
      SELECT @l_StaAcc = '1'
    END
  END
  SELECT @l_codRPA = 0
  EXECUTE SP_RET_REG_AUD @l_codRPA OUTPUT
  IF (@p_tipope=0)
