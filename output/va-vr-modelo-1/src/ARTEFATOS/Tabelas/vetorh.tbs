TRIGGER R110ENC_EI AFTER INSERT ON R110ENC FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Encaminhamento (Tabela: R110ENC)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 125;     /* Encaminhamento (Tabela: R110ENC) -- Ajustar o código da categoria*/
  l_codtpa := 381;     /* Ajustar o código do tipo de auditoria*/

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT); 
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110ENC_EI', '');

    /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIC));
      SP_DATSTR(:NEW.DATENC, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATENC', l_datTemp);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORENC', CONVERT(NUMBER_TO_CHAR, :NEW.HORENC));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQENC', CONVERT(NUMBER_TO_CHAR, :NEW.SEQENC));
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110ENC_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AREENC', CONVERT(NUMBER_TO_CHAR, :NEW.AREENC));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODENC', CONVERT(NUMBER_TO_CHAR, :NEW.CODENC));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR, :NEW.CODATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CVNMED', CONVERT(NUMBER_TO_CHAR, :NEW.CVNMED));
      SP_DATSTR(:NEW.DATMAR, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATMAR', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORMAR', CONVERT(NUMBER_TO_CHAR, :NEW.HORMAR));
      SP_DATSTR(:NEW.DATRES, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATRES', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORRES', CONVERT(NUMBER_TO_CHAR, :NEW.HORRES));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OEMENC', CONVERT(NUMBER_TO_CHAR, :NEW.OEMENC));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR, :NEW.CODUSU));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSSOL', :NEW.OBSSOL);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSATE', :NEW.OBSATE);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITENC', CONVERT(NUMBER_TO_CHAR, :NEW.SITENC));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ATEENC', CONVERT(NUMBER_TO_CHAR, :NEW.ATEENC));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AREATE', CONVERT(NUMBER_TO_CHAR, :NEW.AREATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDAGE', :NEW.INDAGE);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSSOL', CONVERT(NUMBER_TO_CHAR, :NEW.POSSOL));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSENC', CONVERT(NUMBER_TO_CHAR, :NEW.POSENC));
    END;
  END IF; 
END␀7ß␀␀		SENIOR;0␀␀ 

/* UPDATE (OLD/NEW) */
TRIGGER R110ENC_EU AFTER UPDATE ON R110ENC FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Encaminhamento (Tabela: R110ENC)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 125;     /* Encaminhamento (Tabela: R110ENC) -- Ajustar o código da categoria*/
  l_codtpa := 382;     /* Ajustar o código do tipo de auditoria*/
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF ((:OLD.NumEmp <> :NEW.NumEmp)
   OR (:OLD.CodFic <> :NEW.CodFic)
   OR (:OLD.DatEnc <> :NEW.DatEnc)
   OR (:OLD.HorEnc <> :NEW.HorEnc)
   OR (:OLD.SeqEnc <> :NEW.SeqEnc)
   OR (:OLD.AreEnc <> :NEW.AreEnc)
   OR (:OLD.CodEnc <> :NEW.CodEnc)
   OR (:OLD.CodAte <> :NEW.CodAte)
   OR (:OLD.CvnMed <> :NEW.CvnMed)
   OR (:OLD.DatMar <> :NEW.DatMar)
   OR (:OLD.HorMar <> :NEW.HorMar)
   OR (:OLD.DatRes <> :NEW.DatRes)
   OR (:OLD.HorRes <> :NEW.HorRes)
   OR (:OLD.OemEnc <> :NEW.OemEnc)
   OR (:OLD.CodUsu <> :NEW.CodUsu)
   OR (:OLD.ObsSol <> :NEW.ObsSol)
   OR (:OLD.ObsAte <> :NEW.ObsAte)
   OR (:OLD.SitEnc <> :NEW.SitEnc)
   OR (:OLD.AteEnc <> :NEW.AteEnc)
   OR (:OLD.AreAte <> :NEW.AreAte)
   OR (:OLD.IndAge <> :NEW.IndAge)
   OR (:OLD.PosSol <> :NEW.PosSol)
   OR (:OLD.PosEnc <> :NEW.PosEnc)) THEN

    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT); 
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110ENC_EU', '');

      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIC));
        SP_DATSTR(:OLD.DATENC, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATENC', l_datTemp);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORENC', CONVERT(NUMBER_TO_CHAR, :OLD.HORENC));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQENC', CONVERT(NUMBER_TO_CHAR, :OLD.SEQENC));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110ENC_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;
      
      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAREENC', CONVERT(NUMBER_TO_CHAR, :OLD.AREENC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAREENC', CONVERT(NUMBER_TO_CHAR, :NEW.AREENC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODENC', CONVERT(NUMBER_TO_CHAR, :OLD.CODENC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODENC', CONVERT(NUMBER_TO_CHAR, :NEW.CODENC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODATE', CONVERT(NUMBER_TO_CHAR, :OLD.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODATE', CONVERT(NUMBER_TO_CHAR, :NEW.CODATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCVNMED', CONVERT(NUMBER_TO_CHAR, :OLD.CVNMED));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCVNMED', CONVERT(NUMBER_TO_CHAR, :NEW.CVNMED));
        SP_DATSTR(:OLD.DATMAR, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATMAR', l_datTemp);
        SP_DATSTR(:NEW.DATMAR, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATMAR', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORMAR', CONVERT(NUMBER_TO_CHAR, :OLD.HORMAR));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORMAR', CONVERT(NUMBER_TO_CHAR, :NEW.HORMAR));
        SP_DATSTR(:OLD.DATRES, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDATRES', l_datTemp);
        SP_DATSTR(:NEW.DATRES, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDATRES', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDHORRES', CONVERT(NUMBER_TO_CHAR, :OLD.HORRES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWHORRES', CONVERT(NUMBER_TO_CHAR, :NEW.HORRES));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOEMENC', CONVERT(NUMBER_TO_CHAR, :OLD.OEMENC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOEMENC', CONVERT(NUMBER_TO_CHAR, :NEW.OEMENC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODUSU', CONVERT(NUMBER_TO_CHAR, :OLD.CODUSU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODUSU', CONVERT(NUMBER_TO_CHAR, :NEW.CODUSU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSSOL', :OLD.OBSSOL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSSOL', :NEW.OBSSOL);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSATE', :OLD.OBSATE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSATE', :NEW.OBSATE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDSITENC', CONVERT(NUMBER_TO_CHAR, :OLD.SITENC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWSITENC', CONVERT(NUMBER_TO_CHAR, :NEW.SITENC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDATEENC', CONVERT(NUMBER_TO_CHAR, :OLD.ATEENC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWATEENC', CONVERT(NUMBER_TO_CHAR, :NEW.ATEENC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDAREATE', CONVERT(NUMBER_TO_CHAR, :OLD.AREATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWAREATE', CONVERT(NUMBER_TO_CHAR, :NEW.AREATE));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDINDAGE', :OLD.INDAGE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWINDAGE', :NEW.INDAGE);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPOSSOL', CONVERT(NUMBER_TO_CHAR, :OLD.POSSOL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPOSSOL', CONVERT(NUMBER_TO_CHAR, :NEW.POSSOL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPOSENC', CONVERT(NUMBER_TO_CHAR, :OLD.POSENC));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPOSENC', CONVERT(NUMBER_TO_CHAR, :NEW.POSENC));
      END;
    END IF; 
  END IF; 
END␀5ß␀␀		SENIOR;0û␀␀

TRIGGER R110ENC_ED AFTER DELETE ON R110ENC FOR EACH ROW
DECLARE
  l_temAud       BOOLEAN;
  l_codRPA       NUMBER(15);
  l_codSistema   NUMBER(2);
  l_codcpa       NUMBER(4);
  l_codtpa       NUMBER(4);
  l_datTemp      VARCHAR(10);
BEGIN

  /* Geração de logs Encaminhamento (Tabela: R110ENC)*/ 
  l_codSistema := 1;  /* Código do sistema vetorh. */
  l_codcpa := 125;     /* Encaminhamento (Tabela: R110ENC) -- Ajustar o código da categoria*/
  l_codtpa := 381;     /* Ajustar o código do tipo de auditoria*/
 
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT); 

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT); 
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110ENC_ED', '');

    /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIC));
      SP_DATSTR(:OLD.DATENC, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATENC', l_datTemp);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORENC', CONVERT(NUMBER_TO_CHAR, :OLD.HORENC));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SEQENC', CONVERT(NUMBER_TO_CHAR, :OLD.SEQENC));
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110ENC_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Exclusão');
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AREENC', CONVERT(NUMBER_TO_CHAR, :OLD.AREENC));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODENC', CONVERT(NUMBER_TO_CHAR, :OLD.CODENC));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODATE', CONVERT(NUMBER_TO_CHAR, :OLD.CODATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CVNMED', CONVERT(NUMBER_TO_CHAR, :OLD.CVNMED));
      SP_DATSTR(:OLD.DATMAR, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATMAR', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORMAR', CONVERT(NUMBER_TO_CHAR, :OLD.HORMAR));
      SP_DATSTR(:OLD.DATRES, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATRES', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'HORRES', CONVERT(NUMBER_TO_CHAR, :OLD.HORRES));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OEMENC', CONVERT(NUMBER_TO_CHAR, :OLD.OEMENC));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR, :OLD.CODUSU));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSSOL', :OLD.OBSSOL);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSATE', :OLD.OBSATE);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'SITENC', CONVERT(NUMBER_TO_CHAR, :OLD.SITENC));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ATEENC', CONVERT(NUMBER_TO_CHAR, :OLD.ATEENC));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'AREATE', CONVERT(NUMBER_TO_CHAR, :OLD.AREATE));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'INDAGE', :OLD.INDAGE);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSSOL', CONVERT(NUMBER_TO_CHAR, :OLD.POSSOL));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'POSENC', CONVERT(NUMBER_TO_CHAR, :OLD.POSENC));
    END;
  END IF; 
END␀␀␀pc␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀8ß␀␀…¬␀␀´␀	„␀␀␀␀␀␀°␀␀aXbr␀Æÿ␀␀Ò␀␀␀–,Ì␀	„␀␀␀␀␀␀d;§m¹m”)␀␀Æÿ␀␀>ß␀␀␀ş␀G„␀␀␀␀␀␀š␀␀š␀n␀Æÿ␀␀ÿ␀.␀t„␀␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀„␀␀␀␀␀␀$û€$w␀␀Æÿ␀␀…Ó␀␀␀c,­␀„␀␀␀␀␀␀æ-NS}Sp␀␀Æÿ␀␀Ô␀␀␀d¬␀␀Á␀„␀␀␀␀␀␀%%Õ&Õ&y␀␀Æÿ␀␀aà␀␀␀-§␀␀U„␀␀␀␀␀␀M©␀␀ç§␀␀¨␀␀V␀␀ÿ␀␀ÿ␀Ätt„␀␀␀␀␀␀åtDråtm␀␀␀ÿ␀␀ÿ␀?Á␀␀¿␀„␀␀␀␀␀␀ÂÁ␀␀xÁ␀␀yÁ␀␀R)␀␀Æÿ␀␀ÿ␀Ø¹␀„␀␀␀␀␀␀?01Q)␀␀Æÿ␀␀ÿ␀ƒ␀Ğ„␀␀␀␀␀␀c␀c␀c␀c␀␀␀ÿ␀␀ÿ␀.=„␀␀␀␀␀␀*Š␀␀Y^Z^c␀␀␀ÿ␀␀ÿ␀‰␀Ñ␀„␀␀␀␀␀␀Ü+␀Ü+␀Ü+␀qC␀êÿ␀␀ÿ␀#„␀␀␀␀␀␀###>␀␀ÿ␀␀ÿ␀#„␀␀␀␀␀␀""">␀␀ÿ␀␀ÿ␀ #„␀␀␀␀␀␀$$$>␀␀ÿ␀␀ÿ␀€³␀␀ƒ␀„␀␀␀␀␀␀µ´␀␀¯´␀␀¯´␀␀:␀␀ÿ␀␀ÿ␀×-‹␀„␀␀␀␀␀␀‘Am␀m␀—)␀␀␀Æÿ␀␀ÿ␀WP=„␀␀␀␀␀␀†PƒPƒPc␀␀␀ÿ␀␀ÿ␀b,­␀„␀␀␀␀␀␀ˆ<ˆPˆPpM‡␀Æÿ␀␀êĞ␀␀␀B =„␀␀␀␀␀␀T ƒí␀␀ƒí␀␀c␀␀␀ÿ␀␀ÿ␀í	␀=„␀␀␀␀␀␀¼␀␀\Ä␀␀\Ä␀␀c␀␀␀ÿ␀␀ÿ␀ï7=„␀␀␀␀␀␀=Å␀␀ñ7<Å␀␀c␀␀␀␀ÿ␀␀ÿ␀␀␀9ß␀␀␀␀:ß␀␀␀␀;ß␀␀␀␀␀0;1Aß␀␀	SENIOR;0Õ␀␀



/* Efetua a leitura da tabela auxiliar R110FIC_AUX após a inclusão de registros na R110FIC e para cada registro */
/* encontrado, efetua verificação para não duplicar Candidatos */
TRIGGER R110FIC_SI AFTER INSERT ON R110FIC

DECLARE
CURSOR C_R110FIC_INS IS SELECT NUMEMP, CODFIC, NUMCAN FROM R110FIC_AUX;

  TYPE t_r110FIC_aux IS RECORD(
      NUMEMP   R110FIC_AUX.NUMEMP%TYPE,
      CODFIC   R110FIC_AUX.CODFIC%TYPE,
      NUMCAN   R110FIC_AUX.NUMCAN%TYPE);

  l_r110FIC_aux t_r110FIC_aux;

  l_NumEmp        R110FIC.NUMEMP%TYPE;
  l_CodFic        R110FIC.CODFIC%TYPE;
  l_errstr      VARCHAR2(255);
BEGIN
     FOREACH C_R110FIC_INS INTO l_r110FIC_aux.NUMEMP,
                                l_r110FIC_aux.CODFIC,
                                l_r110FIC_aux.NUMCAN
     LOOP
          BEGIN
               SELECT NUMEMP, CODFIC INTO l_NumEmp, l_CodFic FROM R110FIC
                WHERE CODFIC <> l_r110FIC_aux.CODFIC AND NUMEMP = l_r110FIC_aux.NUMEMP AND NUMCAN = l_r110FIC_aux.NUMCAN AND TIPATN = 4;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_NumEmp := 0;
                    l_CodFic := 0;
          END;

          IF   (l_CodFic > 0) THEN
               l_errstr := 'O Candidato ' || CONVERT(NUMBER_TO_CHAR, l_r110FIC_aux.NUMCAN) ||
                           ' já possui uma Ficha de número ' || CONVERT(NUMBER_TO_CHAR, l_CodFic) ||
                           ' na Empresa ' || CONVERT(NUMBER_TO_CHAR, l_NumEmp);
               RAISERROR 103 l_errstr;
          END IF;
     END LOOP;

     BEGIN
          DELETE FROM R110FIC_AUX;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro Exclusão da R110FIC_AUX.';
     END;
END␀?ß␀␀		SENIOR;0è"␀␀TRIGGER R110FIC_EI AFTER INSERT ON R110FIC 
FOR EACH ROW
DECLARE
l_QtdOriOpe NUMBER;
  l_QtdDef    NUMBER;
  l_DatDef    DATE;
  l_TemMod    VARCHAR(1);
  l_data_fim   DATE;
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
  NEW_OBSFIC VARCHAR(8001); 
BEGIN
	/* Sempre que inserir registro novo na R110FIC, insere registro equivalente na R110HFM com data de término sendo a maior data do sistema */
	l_data_fim := '04/06/2080,00:00:00';
	BEGIN
		INSERT INTO R110HFM (NUMEMP,CODFIC,DATTER,TIPATN,TIPCOL,NUMCAD,NUMCAN,CODDEP) VALUES (:NEW.NumEmp,:NEW.CodFic,l_data_fim,:NEW.TipAtn,:NEW.TipCol,:NEW.NumCad,:NEW.NumCan,:NEW.CodDep);
	EXCEPTION
    	WHEN OTHERS THEN
        	RAISERROR 103 'Erro na Inclusão do Histórico de Ficha Médica';
    END;
            
  	IF (:NEW.TIPATN = 4) THEN
       BEGIN
            INSERT INTO R110FIC_AUX(NUMEMP,CODFIC, NUMCAN)
                 VALUES (:NEW.NUMEMP, :NEW.CODFIC, :NEW.NUMCAN);
       EXCEPTION
            WHEN OTHERS THEN
                 RAISERROR 103 'Erro na Inclusão da Ficha Médica na tabela Auxiliar da mesma.';
       END;
  	END IF;

  /* Verifica se o campo R110TRI.OriOpe possui registros */
  BEGIN
    SELECT COUNT(*) INTO l_QtdOriOpe FROM R110TRI;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_QtdOriOpe := 0;
  END;

  /* Se não existe registro na tabela R110TRI, quer dizer que a trigger foi disparada por uma alteração na Ficha Médica */
  IF (l_QtdOriOpe = 0) THEN
    /* Inclui registro na tabela R110TRI afirmando que a alteração partiu da Ficha Médica */
    RH_SETORIOPE('F');

    IF (:NEW.CODDEF <> 0) THEN
      /* Verifica se o histórico da "nova" deficiência já existe */
      BEGIN
        SELECT COUNT(*) INTO l_QtdDef FROM R110HDF
         WHERE NUMEMP = :NEW.NUMEMP
           AND CODFIC = :NEW.CODFIC
           AND CODDEF = :NEW.CODDEF;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT da tabela R110HDF.';
      END;

      /* Se deficiência não existe no histórico então insere */
      IF (l_QtdDef = 0) THEN
        IF (:NEW.TIPATN = 1) THEN /* Busca data de nascimento do Colaborador */
          BEGIN
            SELECT DATNAS INTO l_DatDef FROM R034FUN
             WHERE NUMEMP = :NEW.NUMEMP
               AND TIPCOL = :NEW.TIPCOL
               AND NUMCAD = :NEW.NUMCAD;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT da tabela R034FUN.';
          END;
        ELSIF (:NEW.TIPATN = 2) THEN /* Busca data de nascimento do Depedente */
          BEGIN
            SELECT DATNAS INTO l_DatDef FROM R036DEP
             WHERE NUMEMP = :NEW.NUMEMP
               AND TIPCOL = :NEW.TIPCOL
               AND NUMCAD = :NEW.NUMCAD
               AND CODDEP = :NEW.CODDEP;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT da tabela R036DEP.';
          END;
        ELSIF (:NEW.TIPATN = 3) THEN /* Se for visitante pega Data Atual */
          l_DatDef := CURDATE();
        ELSIF (:NEW.TIPATN = 4) THEN /* Busca data de nascimento do Candidato */
          BEGIN
            SELECT DATNAS INTO l_DatDef FROM R122CEX
             WHERE NUMCAN = :NEW.NUMCAN;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT da tabela R122CEX.';
          END;
        END IF;

        /* Insere a deficiencia nova no histórico de defiência */
        BEGIN
          INSERT INTO R110HDF (NUMEMP,CODFIC,CODDEF,DATDEF,PRIDEF)
               VALUES (:NEW.NUMEMP,:NEW.CODFIC,:NEW.CODDEF,l_DatDef,'S');
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao Inserir Deficiência na tabela R110HDF.';
        END;
      END IF;

      /* altera deficiência no cadastro do colaborador/candidato */
      IF (:NEW.TIPATN = 1) THEN
        BEGIN
          UPDATE R034FUN SET DEFFIS = :NEW.DEFFIS, CODDEF = :NEW.CODDEF, BENREA = :NEW.BENREA, COTDEF = :NEW.COTDEF
                   WHERE NUMEMP = :NEW.NUMEMP
                     AND TIPCOL = :NEW.TIPCOL
                     AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao Atualizar Deficiência no cadastro do Colaborador.';
        END;
      ELSIF (:NEW.TIPATN = 4) THEN
        BEGIN
          UPDATE R122CEX SET DEFFIS = :NEW.DEFFIS, CODDEF = :NEW.CODDEF, BENREA = :NEW.BENREA
                   WHERE NUMCAN = :NEW.NUMCAN;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao Atualizar Deficiência no cadastro do Candidato.';
        END;
      END IF;
    ELSE
      /* altera deficiência no cadastro do colaborador/candidato */
      IF (:NEW.TIPATN = 1) THEN
        BEGIN
          UPDATE R034FUN SET DEFFIS = :NEW.DEFFIS, CODDEF = :NEW.CODDEF, BENREA = :NEW.BENREA, COTDEF = :NEW.COTDEF
                   WHERE NUMEMP = :NEW.NUMEMP
                     AND TIPCOL = :NEW.TIPCOL
                     AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao Atualizar Deficiência no cadastro do Colaborador.';
        END;
      ELSIF (:NEW.TIPATN = 4) THEN
        BEGIN
          UPDATE R122CEX SET DEFFIS = :NEW.DEFFIS, CODDEF = :NEW.CODDEF, BENREA = :NEW.BENREA
                   WHERE NUMCAN = :NEW.NUMCAN;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao Atualizar Deficiência no cadastro do Candidato.';
        END;
      END IF;
    END IF;

    /* Exclui valor do campo R110TRI.OriOpe */
    RH_DELORIOPE('F');
  END IF;
  
  l_codSistema := 1;
  l_codcpa := 127;  /* Código da categoria de auditoria - Ficha Médica*/
  l_codtpa := 385;  /* Código do tipo de auditoria - Inclusão*/

  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110FIC_EI', '');

    /* Insere os campos chave na tabela de auditoria R995PRC*/
    BEGIN
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIC));
    EXCEPTION
      WHEN OTHERS THEN RAISERROR 103 'R110FIC_AI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
    END;

    /* Insere os valores dos campos na tabela de auditoria R995PRT*/
    BEGIN
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Inclusão');
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPATN', CONVERT(NUMBER_TO_CHAR, :NEW.TIPATN));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDEP', CONVERT(NUMBER_TO_CHAR, :NEW.CODDEP));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMCAN', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAN));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'GRUSAN', :NEW.GRUSAN);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'PESATN', CONVERT(NUMBER_TO_CHAR, :NEW.PESATN));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ALTATN', CONVERT(NUMBER_TO_CHAR, :NEW.ALTATN));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPFIS', :NEW.TIPFIS);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'COLDOA', :NEW.COLDOA);
      SP_DATSTR(:NEW.ULTDOA, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ULTDOA', l_datTemp);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ANTPES', :NEW.ANTPES);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ANTFAM', :NEW.ANTFAM);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'ANTPRO', :NEW.ANTPRO);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OBSFIC', :NEW.OBSFIC);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODUSU', CONVERT(NUMBER_TO_CHAR, :NEW.CODUSU));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DEFFIS', :NEW.DEFFIS);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODDEF', CONVERT(NUMBER_TO_CHAR, :NEW.CODDEF));
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'BENREA', :NEW.BENREA);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TEMSUB', :NEW.TEMSUB);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'COTDEF', :NEW.COTDEF);
    END;
  END IF;
END␀Bß␀␀	SENIOR;0Ò␀␀

/* Efetua a leitura da tabela auxiliar R110FIC_AUX após a alteração de registros na R110FIC e para cada registro */
/* encontrado, efetua verificação para não duplicar Candidatos */
TRIGGER R110FIC_SU AFTER UPDATE ON R110FIC

DECLARE
CURSOR C_R110FIC_UPD IS SELECT NUMEMP, CODFIC, NUMCAN FROM R110FIC_AUX;

  TYPE t_r110FIC_aux IS RECORD(
      NUMEMP   R110FIC_AUX.NUMEMP%TYPE,
      CODFIC   R110FIC_AUX.CODFIC%TYPE,
      NUMCAN   R110FIC_AUX.NUMCAN%TYPE);

  l_r110FIC_aux t_r110FIC_aux;

  l_NumEmp        R110FIC.NUMEMP%TYPE;
  l_CodFic        R110FIC.CODFIC%TYPE;
  l_errstr      VARCHAR2(255);
BEGIN
     FOREACH C_R110FIC_UPD INTO l_r110FIC_aux.NUMEMP,
                                l_r110FIC_aux.CODFIC,
                                l_r110FIC_aux.NUMCAN
     LOOP
          BEGIN
               SELECT NUMEMP, CODFIC INTO l_NumEmp, l_CodFic FROM R110FIC
                WHERE CODFIC <> l_r110FIC_aux.CODFIC AND NUMEMP = l_r110FIC_aux.NUMEMP AND NUMCAN = l_r110FIC_aux.NUMCAN AND TIPATN = 4;
          EXCEPTION
               WHEN NO_DATA_FOUND THEN
                    l_NumEmp := 0;
                    l_CodFic := 0;
          END;

          IF   (l_CodFic > 0) THEN
               l_errstr := 'O Candidato ' || CONVERT(NUMBER_TO_CHAR, l_r110FIC_aux.NUMCAN) ||
                           ' já possui uma Ficha de número ' || CONVERT(NUMBER_TO_CHAR, l_CodFic) ||
                           ' na Empresa ' || CONVERT(NUMBER_TO_CHAR, l_NumEmp);
               RAISERROR 103 l_errstr;
          END IF;
     END LOOP;

     BEGIN
          DELETE FROM R110FIC_AUX;
     EXCEPTION
          WHEN OTHERS THEN
               RAISERROR 103 'Erro Exclusão da R110FIC_AUX.';
     END;
END␀@ß␀␀		SENIOR;0wA␀␀

TRIGGER R110FIC_EU AFTER UPDATE ON R110FIC 
FOR EACH ROW
DECLARE
  l_QtdOriOpe  NUMBER;
  l_QtdDef     NUMBER;
  l_temHist    NUMBER;
  l_DatDef     DATE;
  l_data_ontem DATE;
  l_data_fim   DATE;
  l_temAud BOOLEAN;
  l_codRPA NUMBER(15);
  l_codSistema NUMBER(2);
  l_codcpa NUMBER(4);
  l_codtpa NUMBER(4);
  l_datTemp VARCHAR(10);
  NEW_OBSFIC VARCHAR(8001);
  OLD_OBSFIC VARCHAR(8001);  
BEGIN
	l_data_ontem := CURDATE() - 1;
	l_data_fim := '04/06/2080,00:00:00';

	/* Inclusão de registro no histórico de ficha médica, quando trocar o "dono" da mesma */
	IF ((:OLD.TipCol <> :NEW.TipCol) OR (:OLD.NumCad <> :NEW.NumCad) OR (:OLD.NumCan <> :NEW.NumCan) OR (:OLD.CodDep <> :NEW.CodDep)) THEN
		BEGIN
		/* Verifica se já existe histórico na data de ontem */
		SELECT COUNT(*) INTO l_temHist FROM R110HFM 
			WHERE NUMEMP = :NEW.NumEmp AND CODFIC = :NEW.CodFic AND DATTER = l_data_ontem;
		EXCEPTION
			WHEN NO_DATA_FOUND THEN
				l_temHist := 0;
		END;
		
		/* Se tem histórico com data de ontem, apenas atualiza o histórico sem data de término(maior data do sistema).
		 * Senão atualiza o histórico sem data de término(maior data do sistema) com a data de ontem.
		 * E insere novo registro de histórico sem data de término(maior data do sistema)
		 */
		IF (l_temHist > 0) THEN
			BEGIN
				UPDATE R110HFM SET TIPATN = :NEW.TipAtn, TIPCOL = :NEW.TipCol, NUMCAD = :NEW.NumCad, NUMCAN = :NEW.NumCan, CODDEP = :NEW.CodDep WHERE NUMEMP = :NEW.NumEmp AND CODFIC = :NEW.CodFic AND DATTER = l_data_fim;
			EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'Erro na atualização do Histórico de Ficha Médica.';
			END;
		ELSE
			BEGIN
				UPDATE R110HFM SET DATTER = l_data_ontem WHERE NUMEMP = :NEW.NumEmp AND CODFIC = :NEW.CodFic AND DATTER = l_data_fim;
				INSERT INTO R110HFM (NUMEMP,CODFIC,DATTER,TIPATN,TIPCOL,NUMCAD,NUMCAN,CODDEP) VALUES (:NEW.NumEmp,:NEW.CodFic,l_data_fim,:NEW.TipAtn,:NEW.TipCol,:NEW.NumCad,:NEW.NumCan,:NEW.CodDep);
			EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'Erro na atualização do Histórico de Ficha Médica.';
			END;
		END IF;
	END IF;
    
  IF (:NEW.TIPATN = 4) AND (:OLD.NUMCAN <> :NEW.NUMCAN) THEN
    BEGIN
      INSERT INTO R110FIC_AUX(NUMEMP,CODFIC, NUMCAN)
           VALUES (:NEW.NUMEMP, :NEW.CODFIC, :NEW.NUMCAN);
      EXCEPTION
           WHEN OTHERS THEN
             RAISERROR 103 'Erro na Inclusão da Ficha Médica na tabela Auxiliar da mesma.';
      END;
  END IF;

  /* Verifica se os campos relacionados a deficiência foram alterados */
  IF ((:NEW.CODDEF <> :OLD.CODDEF) OR
	  (IFNULL(:NEW.DEFFIS, ' ') <> IFNULL(:OLD.DEFFIS, ' ')) OR
	  (IFNULL(:NEW.BENREA, ' ') <> IFNULL(:OLD.BENREA, ' ')) OR
	  (IFNULL(:NEW.COTDEF, ' ') <> IFNULL(:OLD.COTDEF, ' '))) THEN

    /* Verifica se campo R110TRI.OriOpe possui registros */
    BEGIN
      SELECT COUNT(*) INTO l_QtdOriOpe FROM R110TRI;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_QtdOriOpe := 0;
    END;

  ELSE
    /* Seta valor padrão na qual indica que não houve alterações
       em relação a deficiência, não sendo necessário atualizar ficha
       médica e histórico */
    l_QtdOriOpe := 1;
  END IF;

  /* Se não existe registro na tabela R110TRI, quer dizer que a trigger foi disparada por uma alteração
     na Ficha Médica */
  IF (l_QtdOriOpe = 0) THEN
    /* Inclui registro na tabela R110TRI */
    RH_SETORIOPE('F');

    IF (:NEW.CODDEF <> 0) AND (:NEW.CODDEF <> :OLD.CODDEF) THEN

      /* Verifica se o histórico da "nova" deficiência já existe */
      BEGIN
        SELECT COUNT(*) INTO l_QtdDef FROM R110HDF
         WHERE NUMEMP = :NEW.NUMEMP
           AND CODFIC = :NEW.CODFIC
           AND CODDEF = :NEW.CODDEF;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT da tabela R110HDF.';
      END;

      /* Deleta a deficiencia antiga no histórico de defiência */
      BEGIN
        DELETE FROM R110HDF
         WHERE NUMEMP = :NEW.NUMEMP
           AND CODFIC = :NEW.CODFIC
           AND CODDEF = :OLD.CODDEF;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no DELETE da tabela R110HDF.';
      END;

      /* Retira assinalamento de deficiência principal das outras deficiências já existentes */
      BEGIN
        UPDATE R110HDF SET PRIDEF = 'N'
                 WHERE NUMEMP = :NEW.NUMEMP
                   AND CODFIC = :NEW.CODFIC
                   AND PRIDEF = 'S';
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao Retirar assinalamento de Deficiência principal.';
      END;

      /* Se deficiência não existe no histórico então insere */
      IF (l_QtdDef = 0) THEN
        IF (:NEW.TIPATN = 1) THEN /* Busca data de nascimento do Colaborador */
          BEGIN
            SELECT DATNAS INTO l_DatDef FROM R034FUN
             WHERE NUMEMP = :NEW.NUMEMP
               AND TIPCOL = :NEW.TIPCOL
               AND NUMCAD = :NEW.NUMCAD;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT da tabela R110HDF.';
          END;
        ELSIF (:NEW.TIPATN = 2) THEN /* Busca data de nascimento do Dependente */
          BEGIN
           SELECT DATNAS INTO l_DatDef FROM R036DEP
             WHERE NUMEMP = :NEW.NUMEMP
               AND TIPCOL = :NEW.TIPCOL
               AND NUMCAD = :NEW.NUMCAD
               AND CODDEP = :NEW.CODDEP;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT da tabela R036DEP.';
          END;
        ELSIF (:NEW.TIPATN = 3) THEN /* Se for visitante pega Data Atual */
          l_DatDef := CURDATE();
        ELSIF (:NEW.TIPATN = 4) THEN /* Busca data de nascimento do Candidato */
          BEGIN
            SELECT DATNAS INTO l_DatDef FROM R122CEX
             WHERE NUMCAN = :NEW.NUMCAN;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro no SELECT da tabela R122CEX.';
          END;
        END IF;

        /* Insere a deficiência nova no histórico de defiência */
        BEGIN
          INSERT INTO R110HDF (NUMEMP,CODFIC,CODDEF,DATDEF,PRIDEF)
               VALUES (:NEW.NUMEMP,:NEW.CODFIC,:NEW.CODDEF,l_DatDef,'S');
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao Inserir Deficiência na tabela R110HDF.';
        END;
      ELSE
        /* Se a deficiência já existe então seta ela como principal */
        BEGIN
          UPDATE R110HDF SET PRIDEF = 'S'
                       WHERE NUMEMP = :NEW.NUMEMP
                         AND CODFIC = :NEW.CODFIC
                         AND CODDEF = :NEW.CODDEF;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao setar Deficiência como principal.';
        END;
      END IF;

      /* Altera deficiência no cadastro do colaborador/candidato */
      IF (:NEW.TIPATN = 1) THEN
        BEGIN
          UPDATE R034FUN SET DEFFIS = :NEW.DEFFIS, CODDEF = :NEW.CODDEF, BENREA = :NEW.BENREA, COTDEF = :NEW.COTDEF
                   WHERE NUMEMP = :NEW.NUMEMP
                     AND TIPCOL = :NEW.TIPCOL
                     AND NUMCAD = :NEW.NUMCAD;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao Atualizar Deficiência no cadastro do Colaborador.';
        END;
      ELSIF (:NEW.TIPATN = 4) THEN
        BEGIN
          UPDATE R122CEX SET DEFFIS = :NEW.DEFFIS, CODDEF = :NEW.CODDEF, BENREA = :NEW.BENREA
                   WHERE NUMCAN = :NEW.NUMCAN;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro ao Atualizar Deficiência no cadastro do Candidato.';
        END;
      END IF;
    ELSE
      IF (:NEW.CODDEF = 0) AND (:OLD.CODDEF <> 0) THEN

        /* Deleta a deficiencia antiga no histórico de defiência */
        BEGIN
          DELETE FROM R110HDF
           WHERE NUMEMP = :NEW.NUMEMP
             AND CODFIC = :NEW.CODFIC
             AND CODDEF = :OLD.CODDEF;
        EXCEPTION WHEN OTHERS THEN
          RAISERROR 103 'Erro no DELETE da tabela R110HDF.';
        END;

        /* Altera deficiência no cadastro do colaborador/candidato */
        IF (:NEW.TIPATN = 1) THEN
          BEGIN
            UPDATE R034FUN SET DEFFIS = :NEW.DEFFIS, CODDEF = :NEW.CODDEF, BENREA = :NEW.BENREA, COTDEF = :NEW.COTDEF
                     WHERE NUMEMP = :NEW.NUMEMP
                       AND TIPCOL = :NEW.TIPCOL
                       AND NUMCAD = :NEW.NUMCAD;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao Atualizar Deficiência no cadastro do Colaborador.';
          END;
        ELSIF (:NEW.TIPATN = 4) THEN
          BEGIN
            UPDATE R122CEX SET DEFFIS = :NEW.DEFFIS, CODDEF = :NEW.CODDEF, BENREA = :NEW.BENREA
                     WHERE NUMCAN = :NEW.NUMCAN;
          EXCEPTION WHEN OTHERS THEN
            RAISERROR 103 'Erro ao Atualizar Deficiência no cadastro do Candidato.';
          END;
        END IF;

      ELSE
           
		IF (:NEW.CODDEF = :OLD.CODDEF) AND
		    ((IFNULL(:NEW.DEFFIS, ' ') <> IFNULL(:OLD.DEFFIS, ' ')) OR
			 (IFNULL(:NEW.BENREA, ' ') <> IFNULL(:OLD.BENREA, ' ')) OR
			 (IFNULL(:NEW.COTDEF, ' ') <> IFNULL(:OLD.COTDEF, ' '))) THEN

          /* Altera deficiência no cadastro do colaborador/candidato */
          IF (:NEW.TIPATN = 1) THEN
            BEGIN
              UPDATE R034FUN SET DEFFIS = :NEW.DEFFIS, BENREA = :NEW.BENREA, COTDEF = :NEW.COTDEF
                       WHERE NUMEMP = :NEW.NUMEMP
                         AND TIPCOL = :NEW.TIPCOL
                         AND NUMCAD = :NEW.NUMCAD;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao Atualizar Deficiência no cadastro do Colaborador.';
            END;
          ELSIF (:NEW.TIPATN = 4) THEN
            BEGIN
              UPDATE R122CEX SET DEFFIS = :NEW.DEFFIS, BENREA = :NEW.BENREA
                       WHERE NUMCAN = :NEW.NUMCAN;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'Erro ao Atualizar Deficiência no cadastro do Candidato.';
            END;
          END IF;

        END IF;

      END IF;
    END IF;

    /* Exclui valor do campo R110TRI.OriOpe */
    RH_DELORIOPE('F');
  END IF;
  IF (
  :OLD.TIPATN <>:NEW.TIPATN OR
  :OLD.TIPCOL <>:NEW.TIPCOL OR
  :OLD.NUMCAD <>:NEW.NUMCAD OR
  :OLD.NUMCAN <>:NEW.NUMCAN OR
  :OLD.CODDEP <>:NEW.CODDEP OR
  :OLD.GRUSAN <>:NEW.GRUSAN OR
  :OLD.PESATN <>:NEW.PESATN OR
  :OLD.ALTATN <>:NEW.ALTATN OR
  :OLD.TIPFIS <>:NEW.TIPFIS OR
  :OLD.COLDOA <>:NEW.COLDOA OR
  :OLD.ULTDOA <>:NEW.ULTDOA OR
  :OLD.ANTPES <>:NEW.ANTPES OR
  :OLD.ANTFAM <>:NEW.ANTFAM OR
  :OLD.ANTPRO <>:NEW.ANTPRO OR
  :OLD.OBSFIC <>:NEW.OBSFIC OR
  :OLD.CODUSU <>:NEW.CODUSU OR
  :OLD.DEFFIS <>:NEW.DEFFIS OR
  :OLD.CODDEF <>:NEW.CODDEF OR
  :OLD.BENREA <>:NEW.BENREA OR
  :OLD.TEMSUB <>:NEW.TEMSUB OR
  :OLD.COTDEF <>:NEW.COTDEF
  ) THEN
    /* Geração de logs Ficha Médica (Tabela: R110FIC)*/
    l_codSistema := 1;  /* Código do sistema vetorh*/
    l_codcpa := 127;     /* Ficha Médica (Tabela: R110FIC) -- Ajustar o código da categoria se necessário*/
    l_codtpa := 386;     /* Ajustar o código do tipo de auditoria se necessário*/

  	SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);

  	IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, l_codSistema, l_codcpa, 1, l_codtpa, 1, 'R110FIC_EU', '');

      BEGIN
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIC', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIC));
      EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'R110FIC_AU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
      END;

      BEGIN
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'TIPOPE', 'Alteração');
        /* Campos com valores antigos e novos*/
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPATN', CONVERT(NUMBER_TO_CHAR, :OLD.TIPATN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPATN', CONVERT(NUMBER_TO_CHAR, :NEW.TIPATN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPCOL', CONVERT(NUMBER_TO_CHAR, :OLD.TIPCOL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPCOL', CONVERT(NUMBER_TO_CHAR, :NEW.TIPCOL));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMCAD', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMCAD', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAD));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODDEP', CONVERT(NUMBER_TO_CHAR, :OLD.CODDEP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODDEP', CONVERT(NUMBER_TO_CHAR, :NEW.CODDEP));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDNUMCAN', CONVERT(NUMBER_TO_CHAR, :OLD.NUMCAN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWNUMCAN', CONVERT(NUMBER_TO_CHAR, :NEW.NUMCAN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDGRUSAN', :OLD.GRUSAN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWGRUSAN', :NEW.GRUSAN);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDPESATN', CONVERT(NUMBER_TO_CHAR, :OLD.PESATN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWPESATN', CONVERT(NUMBER_TO_CHAR, :NEW.PESATN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDALTATN', CONVERT(NUMBER_TO_CHAR, :OLD.ALTATN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWALTATN', CONVERT(NUMBER_TO_CHAR, :NEW.ALTATN));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTIPFIS', :OLD.TIPFIS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTIPFIS', :NEW.TIPFIS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCOLDOA', :OLD.COLDOA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCOLDOA', :NEW.COLDOA);
        SP_DATSTR(:OLD.ULTDOA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDULTDOA', l_datTemp);
        SP_DATSTR(:NEW.ULTDOA, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWULTDOA', l_datTemp);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDANTPES', :OLD.ANTPES);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWANTPES', :NEW.ANTPES);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDANTFAM', :OLD.ANTFAM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWANTFAM', :NEW.ANTFAM);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDANTPRO', :OLD.ANTPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWANTPRO', :NEW.ANTPRO);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDOBSFIC', :OLD.OBSFIC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWOBSFIC', :NEW.OBSFIC);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODUSU', CONVERT(NUMBER_TO_CHAR, :OLD.CODUSU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODUSU', CONVERT(NUMBER_TO_CHAR, :NEW.CODUSU));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDDEFFIS', :OLD.DEFFIS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWDEFFIS', :NEW.DEFFIS);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCODDEF', CONVERT(NUMBER_TO_CHAR, :OLD.CODDEF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCODDEF', CONVERT(NUMBER_TO_CHAR, :NEW.CODDEF));
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDBENREA', :OLD.BENREA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWBENREA', :NEW.BENREA);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDTEMSUB', :OLD.TEMSUB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWTEMSUB', :NEW.TEMSUB);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDCOTDEF', :OLD.COTDEF);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWCOTDEF', :NEW.COTDEF);
      END;
    END IF;
  END IF;  
