SP_CMDTSI
SP_RETICARD
#␀␀PROCEDURE SP_ATUCPFTSI(P_ICARD CHAR(12),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20))
 IS

  l_temconcpf          CHAR(1);
  l_usutel             VARCHAR2(31);
  l_comando_contcpf    VARCHAR2(2048);
  l_cmdinscpf          VARCHAR2(2048);
  l_numdoc             VARCHAR2(11);
  l_numpas	           VARCHAR2(11);
  l_numreal	           VARCHAR2(11);
  l_count              NUMBER(2);
  l_asc                NUMBER(2);
  l_tipdoc             CHAR(1);
  l_haltContcpfINSERT  BOOLEAN;
  l_ascStr		       CHAR(2);
  l_numpasSize         NUMBER(2);
  l_ascSize            NUMBER(2);
  l_icard_num          NUMBER(12);
  l_icardA             VARCHAR2(12);
  l_icardR             VARCHAR2(12);
  l_numser             VARCHAR2(12);
BEGIN
    l_count := 0;
    l_haltContcpfINSERT := FALSE;

    /* Busco o ICARD, de acordo com a parametrização para crachás de tecnologia 3 - SmartCard feita pelo usuário */
    l_icard_num := CONVERT(CHAR_TO_NUMBER, p_icard);
    SP_RETICARD(NULL, l_icard_num, l_icardA OUT, l_icardR OUT, l_numser OUT);

    IF (Length(p_numdoc) > 11) THEN   
      l_numdoc:= SUBSTRING(LTRIM(RTRIM(p_numdoc)),1,11);
    ELSE
      l_numdoc := LTRIM(RTRIM(p_numdoc));
    END IF;

    l_numreal:= l_numdoc;

    BEGIN
        /*Busca na R070TSI para verificar se existe a tabela CONTCPF*/
        SELECT CONCPF INTO l_temconcpf FROM R070TSI;
    EXCEPTION
        WHEN OTHERS THEN RAISERROR 103 'SP_ATUCPFTSI: Não Conseguiu Efetuar SELECT na Tabela R070TSI.';
    END;

    /*Busca o usuário da Telemática para SQL Server*/
    SP_USUTEL(l_usutel OUT);

    /*Só atualiza a CONTCPF se o documento for CPF ou Passaporte e tiver a tabela CONTCPF*/
    IF ((l_temconcpf = 'S') OR (l_temconcpf = 'Q')) AND (p_tipdoc <> 0) AND NOT (p_tipdoc IS NULL) THEN

        /*Para o tipo de documento passaporte converte a parte em letras em valor ASCII, pois o smart só aceita números*/
        /*Passaporte AA12345 convertido  '656512345' */
        IF (p_tipdoc = 4) AND (l_temconcpf = 'Q') THEN
            l_numpas:= '';
			l_ascStr:= '';
			BEGIN
				LOOP
					/*Controle do Loop.*/
					IF (Length(l_numdoc) > l_count) THEN
						l_count := l_count + 1;
						l_asc:= ASCII(UPPER(SUBSTRING(l_numdoc,l_count,1)));
						l_ascSize := LENGTH(LTRIM(RTRIM(l_asc)));
						l_numpasSize := LENGTH(LTRIM(RTRIM(l_numpas)));
						IF (l_numpasSize IS NULL) THEN
							l_numpasSize := 0;
						END IF;						
						IF ((l_asc >= 65) AND (l_asc <= 90)) THEN
							IF ((l_numpasSize + l_ascSize) <= 11)THEN
								SP_INTSTR(l_asc,'99',l_ascStr OUT);
								IF (l_count = 1) THEN									
									l_numpas:= l_ascStr;
								ELSE
									l_numpas:= LTRIM(RTRIM(l_numpas))||l_ascStr;
								END IF;
							ELSE
								l_haltContcpfINSERT := TRUE;
								EXIT;
							END IF;
						ELSE
							IF ((l_asc >= 48) AND (l_asc <= 57)) THEN
								IF (l_numpasSize <= 10) THEN
									IF (l_count = 1) THEN
										l_numpas:= SUBSTRING(l_numdoc,l_count,1);
									ELSE
										l_numpas:= LTRIM(RTRIM(l_numpas))||SUBSTRING(l_numdoc,l_count,1);
									END IF;
								ELSE
									l_haltContcpfINSERT := TRUE;
									EXIT;
								END IF;
							END IF;
						END IF;
					ELSE
						EXIT;
					END IF;
				END LOOP;
			EXCEPTION
				WHEN OTHERS THEN l_numpas := '0'; l_haltContcpfINSERT := TRUE;
			END;

            l_numdoc:= l_numpas;
        END IF;

        LOOP
          /*Controle do Loop.*/
          IF (Length(l_numdoc) > 10) THEN
              EXIT;
          END IF;
          l_numdoc := '0'||l_numdoc;
        END LOOP;

        /*Caso exista um registro com o CPF ou ICARD o mesmo será deletado da CONTCPF para em seguida ser inserido*/
        l_comando_contcpf := 'DELETE FROM '|| l_usutel ||'CONTCPF WHERE CPF = '||''''||l_numdoc||''''||' OR ICARD = '||''''||l_icardA||'''';
        SP_CMDTSI(l_comando_contcpf);

        /*Grava o CPF na tabela de 4 campos*/
        IF (p_tipdoc = 2) AND (l_temconcpf = 'Q') THEN
            l_tipdoc := '2';
	     l_cmdinscpf := 'INSERT INTO '|| l_usutel ||'CONTCPF (ICARD,CPF,REAL,TIPODOC) VALUES ('||''''|| l_icardA ||''''||','||''''|| l_numdoc ||''''||','||''''|| l_numreal ||''''||','||''''|| l_tipdoc ||''''||')';
	     SP_CMDTSI(l_cmdinscpf);
        END IF;

        /*Grava o CPF na tabela de 2 campos*/
        IF (p_tipdoc = 2) AND (l_temconcpf = 'S') THEN
            l_cmdinscpf := 'INSERT INTO '|| l_usutel ||'CONTCPF (ICARD,CPF) VALUES ('||''''|| l_icardA ||''''||','||''''|| l_numdoc ||''''||')';
	     SP_CMDTSI(l_cmdinscpf);
	 ELSE
            /*Grava o Passaporte somente na tabela de 4 campos*/
            IF (p_tipdoc = 4) AND (l_temconcpf = 'Q') AND (LENGTH(l_numdoc) <= 11) AND (l_haltContcpfINSERT = FALSE) THEN
                l_tipdoc := '3';
	         l_cmdinscpf := 'INSERT INTO '|| l_usutel ||'CONTCPF (ICARD,CPF,REAL,TIPODOC) VALUES ('||''''|| l_icardA ||''''||','||''''|| l_numdoc ||''''||','||''''|| l_numreal ||''''||','||''''|| l_tipdoc ||''''||')';
	         SP_CMDTSI(l_cmdinscpf);
            END IF;
        END IF;
    END IF;
END		SENIOR;23.SP_USUTEL
SP_INTSTR
SP_CMDTSI
SP_RETICARD
#␀␀PROCEDURE SP_ATUCPFTSI(P_ICARD CHAR(12),P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20))
 IS

  l_temconcpf          CHAR(1);
  l_usutel             VARCHAR2(31);
