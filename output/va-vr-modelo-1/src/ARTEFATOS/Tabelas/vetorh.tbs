        nativas conforme declarado no fim do arquivo 'R070BIO_triggers.rdbmf'.
*/
TRIGGER R070BIO_ED AFTER DELETE ON R070BIO FOR EACH ROW
DECLARE
l_idtpes          CHAR(23);
l_numcpf          NUMBER(11);
l_codtbi_str      VARCHAR2(2);
