PROCEDURE R034DAC_ATUCON(P_TIPCOL NUMBER,P_NUMEMP NUMBER,P_NUMCAD NUMBER,P_CODPRM NUMBER,P_PRMSAB NUMBER,P_PRMDOM NUMBER,P_PRMFER NUMBER,P_CONADP CHAR,P_CONIAL CHAR,P_TEMALM NUMBER,P_CONFAI NUMBER,P_VERPRM CHAR,P_CONCRE NUMBER,P_DATASO DATE,P_DATTSE DATE,P_VERAFA CHAR,P_CONPAC CHAR,P_TEMPAC NUMBER,P_TOLACP NUMBER,P_USABIO NUMBER,P_CONINT CHAR,P_TOLINT NUMBER,P_GRACON NUMBER,P_CONREA CHAR,P_REPONL CHAR,P_RECVIS CHAR,P_CONREE CHAR,P_USARFA CHAR)
 IS

l_cracha       NUMBER(12);
  l_cracha_pro   NUMBER(12);
  l_sqlstr       VARCHAR2(255);
  l_datval       CHAR(16);
  l_datstr       CHAR(6);
  l_menDatCra    BOOLEAN;
  /* Definições de acesso por colaborador R034DAC */
  l_anti_dupla   CHAR(1); /* Controla Anti-Dupla */
  l_fx_flg       CHAR(1); /* Controla Intervalo de Almoço */
  l_tempo_alm    CHAR(3); /* Tempo Mínimo de Almoço (Minutos) */
  l_ver_hora     CHAR(1); /* Controla Faixa Horária de Acesso */
  l_ver_local    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_cred     CHAR(1); /* Controla Creditos de Acesso */
  l_ver_valid    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_afast    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);  
  l_datfim       DATE;
  l_dataso       DATE;
  l_dattse       DATE;
  l_datcon       DATE;
  l_dathch       DATE;
  l_horfim       NUMBER(5);
  l_codprm       NUMBER(5);
  l_prmsab       NUMBER(5);
  l_prmdom       NUMBER(5);
  l_prmfer       NUMBER(5);
  l_horfim_str   CHAR(4);
  l_grupo        CHAR(5);
  l_gruposab     CHAR(5);
  l_grupodom     CHAR(5);
  l_grupofer     CHAR(5);
  l_Straux       VARCHAR2(2047);
  l_conadp       NUMBER(1);
  l_conial       NUMBER(1);
  l_verprm       NUMBER(1);
  l_verafa       NUMBER(1);
  l_gracon       NUMBER(3);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_conpac       NUMBER(1);
  l_tempac       NUMBER(3);
  l_tolacp       NUMBER(2);
  l_conrea       NUMBER(1);
  l_recvis       NUMBER(1);
  /*Interjornada*/
  l_conInt_Int   NUMBER(1);
  l_tolInt       NUMBER(3);
  /* REP */
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_pisStr       CHAR(11);
  l_conree       NUMBER(1);
  l_usarfa       NUMBER(1);
BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());  
  l_menDatCra  := FALSE;

  /* sempre atualiza os dados no crachá titular para TBS tipo 15 e 18 */
  SP_RetCra_idtpes (1,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
  IF   l_cracha = 0 THEN
      SP_RetCra_idtpes (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
  END IF;

  l_anti_dupla := '1';
  l_fx_flg     := '0';
  l_tempo_alm  := '000';
  l_ver_hora   := '1';
  l_ver_local  := '1';
  l_ver_valid  := '1';
  l_ver_afast  := '1';
  l_ver_cred   := '0';
  l_conInt_Int := 0;
  l_tolInt := 0;

  /* Verifica se Colaborador possui Cracha */
  IF   l_cracha <> 0  THEN
        /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
        SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
        IF (l_crapri = 0) THEN
            l_crapri := l_cracha;
        END IF;

        IF  p_conadp = 'S' THEN
            l_anti_dupla := '1';
            l_conadp := 1;
        ELSE
            l_anti_dupla := '0';
            l_conadp := 0;
        END IF;

        IF  p_conial = 'S' THEN
            l_fx_flg := '1';
            l_conial := 1;
        ELSE
            l_fx_flg := '0';
            l_conial := 0;
        END IF;

        SP_INTSTR(p_temalm,'999',l_tempo_alm OUT);

        SP_INTSTR(p_confai,'9',l_ver_hora OUT);

        /*Interjornada*/
        IF p_conint = 'S' THEN
            l_conInt_Int := 1;
            l_tolInt := p_tolInt;
        END IF;

        IF  p_verprm = 'S' THEN
            l_ver_local := '1';
            l_verprm := 1;
        ELSE
            l_ver_local := '0';
            l_verprm := 0;
        END IF;

        IF  p_verafa = 'S' THEN
            l_ver_afast := '1';
            l_verafa := 1;
        ELSE
            l_ver_afast := '0';
            l_verafa := 0;
        END IF;

        IF  p_conrea = 'S' THEN
            l_conrea := 1;
        ELSE
            l_conrea := 0;
        END IF;
        
        IF  p_recvis = 'S' THEN
            l_recvis := 1;
        ELSE
            l_recvis := 0;
        END IF;        

        IF  p_conree = 'S' THEN
            l_conree := 1;
        ELSE
            l_conree := 0;
        END IF;
        
        IF  p_usarfa = 'S' THEN
            l_usarfa := 1;
        ELSE
            l_usarfa := 0;
        END IF;

        IF  p_conpac = 'S' THEN
            l_conpac := 1;
            l_tempac := p_tempac;
            IF  p_tolacp > 99 THEN
                l_tolacp := 99;
            ELSE
                l_tolacp := p_tolacp;
            END IF;
        ELSE
            l_conpac := 0;
            l_tempac := 0;
            l_tolacp := 0;
        END IF;

        IF p_gracon IS NULL THEN
            /*Não não estiver informado, define o valor pradão para grau de conferência*/
            l_gracon := 50;
        ELSE
            l_gracon := p_gracon;
        END IF;

        SP_INTSTR(p_concre,'9',l_ver_cred OUT);

        /* Atualiza Controle */
        l_codprm:= p_codprm;
        l_prmsab:= p_prmsab;
        l_prmdom:= p_prmdom;
        l_prmfer:= p_prmfer;

        BEGIN
            SELECT CODPRM, PRMSAB, PRMDOM, PRMFER INTO l_codprm, l_prmsab, l_prmdom, l_prmfer FROM R064TPE WHERE
                   NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND
                   (DATINI < l_data_atual OR (DATINI = l_data_atual AND HORINI <= l_hora_atual))  AND 
                   (DATFIM > l_data_atual OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual) OR (DATFIM = l_data_zero));
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN RAISERROR 103 'ON-Line: Erro em R064TPE - TOO MANY ROWS';
            WHEN NO_DATA_FOUND THEN l_codprm:=p_codprm;
                                    l_prmsab:=p_prmsab;
                                    l_prmdom:=p_prmdom;
                                    l_prmfer:=p_prmfer;
            WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no SELECT R064TPE';
        END;

        SP_INTSTR(l_codprm,'99999',l_grupo OUT);
        SP_INTSTR(l_prmsab,'99999',l_gruposab OUT);
        SP_INTSTR(l_prmdom,'99999',l_grupodom OUT);
        SP_INTSTR(l_prmfer,'99999',l_grupofer OUT);
        LOOP
            /* contrato */
            IF  (p_tipcol = 2) OR (p_tipcol = 3) THEN
                SP_HISCON(p_numemp,p_tipcol,p_numcad,l_datcon OUT);
            ELSE
                l_datcon := '31/12/2050,00:00:00';
            END IF;

            /* verifica data final para terceiros e parceiros (período previsto, validade aso e validade treinamento) */
            IF   (p_dataso = l_data_zero) THEN
                 l_dataso := '31/12/2050,00:00:00';
            ELSE l_dataso := p_dataso;
            END IF;
            IF   (p_dattse = l_data_zero) THEN
                 l_dattse := '31/12/2050,00:00:00';
            ELSE l_dattse := p_dattse;
            END IF;
            IF   (l_datcon = l_data_zero) THEN
                 l_datcon := '31/12/2050,00:00:00';
            END IF;

            /*Obtem a Data de Validade do Crachá*/
            BEGIN
                SELECT DATFIM, HORFIM INTO l_dathch, l_horfim
                FROM R038HCH A
                WHERE NUMCRA = l_cracha AND
                DATINI = (SELECT MAX(DATINI) FROM R038HCH WHERE NUMCRA = l_cracha) AND
                HORINI = (SELECT MAX(HORINI) FROM R038HCH WHERE NUMCRA = l_cracha AND DATINI = A.DATINI);
            EXCEPTION
                WHEN OTHERS THEN NULL;
            END;
            IF (l_dathch = l_data_zero) THEN
                 l_dathch := '31/12/2050,00:00:00';
            END IF;

            IF   (l_dataso < l_dattse) THEN
                 IF   (l_dataso < l_datcon) THEN
                      l_datfim := l_dataso;
                 ELSE
                      IF  (l_dattse < l_datcon) THEN
                           l_datfim := l_dattse;
                      ELSE
                           l_datfim := l_datcon;
                      END IF;
                 END IF;
            ELSE
                 IF   (l_dattse < l_datcon)  THEN
                      l_datfim := l_dattse;
                 ELSE
                      l_datfim := l_datcon;
                 END IF;
            END IF;
            /*Compara se a data do crachá é a menor entre as datas*/
            IF l_dathch <= l_datfim THEN
                l_datfim := l_dathch;
                l_menDatCra := TRUE;
            END IF;

            /* converte data para str sem os separadores no formato DDMMYY */
            SP_DATSTR(l_datfim,'DDMMYY',l_datstr OUT);
            IF (l_menDatCra = TRUE) THEN
                IF (l_datstr = '311250') THEN
                    l_datval := l_datstr ||'2359000000';
                ELSE
                    SP_INTSTR(l_horfim,'HHMM',l_horfim_str OUT);
                    l_datval := l_datstr || l_horfim_str ||'000000';
                END IF;
            ELSE
                l_datval := l_datstr ||'2359000000';
            END IF;
            
            IF (l_datval = '0000002359000000') THEN
		        l_datval := '3112502359000000';
	        END IF;	

            /* atualiza o nome da pessoa para controle do REP*/
            l_nomfun := '';
            l_numpis := 0;
            l_pisStr := '';
            IF  (p_reponl <> 'S') THEN
                l_nomfun := '';
                l_numpis := 0;
                l_pisStr := '';
            ELSE
                BEGIN
                    SELECT NOMFUN, NUMPIS INTO l_nomfun, l_numpis FROM R034FUN WHERE
                           NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND (NUMPIS > 0 OR NUMCPF > 0);
                EXCEPTION
                    WHEN TOO_MANY_ROWS THEN RAISERROR 103 'ON-Line: Erro em R034FUN - TOO MANY ROWS';
                    WHEN NO_DATA_FOUND THEN l_nomfun := '';
                                            l_numpis := 0;
                                            l_pisStr := '';
                    WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no SELECT R034FUN';
                END;
            END IF;
            SP_INTSTR(l_numpis,'99999999999',l_pisStr OUT);

            /* atualiza r070con */
            BEGIN
                UPDATE R070CON SET
                        CODPRM=l_codprm,PRMSAB=l_prmsab,PRMDOM=l_prmdom,PRMFER=l_prmfer,
                        CONADP=l_conadp,CONIAL=l_conial,TEMALM=p_temalm,CONFAI=p_confai,
                        VERPRM=l_verprm,CONCRE=p_concre,VERAFA=l_verafa,USABIO=p_usabio,
                        DATVAL=l_datval,GRACON=l_gracon,CONINT=l_conInt_Int,TOLINT=l_tolInt,
                        CONPAC=l_conpac,TEMPAC=l_tempac,TOLACP=l_tolacp,CONREA=l_conrea,
                        NOMFUN=l_nomfun,NUMPIS=CONVERT(CHAR_TO_NUMBER, l_pisStr),RECVIS=l_recvis,CONREE=l_conree,
                        USARFA=l_usarfa
                 WHERE NUMFIS = l_crapri;
            EXCEPTION
                 WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro UPDATE R070CON.';
            END;
           
            /*Atualiza o(s) outro(s) Número(s) Fisico(s) na R070CON.*/
            SP_UPDFIS(l_cracha,' ',l_datval);
            /*Atualiza a permissão dos crachás secundários*/
            SP_UPDPRM(l_cracha,l_codprm,l_prmsab,l_prmdom,l_prmfer,' ',' ',' ');

            /*Atualiza informações que precisam ser repassadas para todos os os Crachás Secundários*/
            IF (l_tecpri <> 0) THEN
              /*Atualiza o Crachá de Barras se exisir*/
              IF (l_numbar <> 0) AND (l_tecpri <> 1) THEN
                  BEGIN
                      UPDATE R070CON SET VERPRM = l_verprm, NOMFUN=l_nomfun, NUMPIS=CONVERT(CHAR_TO_NUMBER, l_pisStr), VERAFA=l_verafa
                       WHERE NUMFIS = l_numbar;
                  EXCEPTION
                      WHEN OTHERS THEN NULL;
                  END;
              END IF;
              /*Atualiza o Crachá de Proximidade se exisir*/
              IF (l_numpro <> 0) AND (l_tecpri <> 2)THEN
                  BEGIN
                      UPDATE R070CON SET VERPRM = l_verprm, NOMFUN=l_nomfun, NUMPIS= CONVERT(CHAR_TO_NUMBER, l_pisStr), VERAFA=l_verafa
                       WHERE NUMFIS = l_numpro;
                  EXCEPTION
                      WHEN OTHERS THEN NULL;
                  END;
              END IF;
              /*Atualiza o Crachá Smart se exisir*/
              IF (l_numsma <> 0) AND (l_tecpri <> 3) THEN
                  BEGIN
                      UPDATE R070CON SET VERPRM = l_verprm, NOMFUN=l_nomfun, NUMPIS= CONVERT(CHAR_TO_NUMBER, l_pisStr), VERAFA=l_verafa
                       WHERE NUMFIS = l_numsma;
                  EXCEPTION
                      WHEN OTHERS THEN NULL;
                  END;
              END IF;
            END IF;
            /*Atualiza a Pend_grupo se possuir smart*/
            IF (l_numsma > 0) THEN
                /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
                IF (l_tecpri = 3) THEN
                    SP_ATUPRM(l_cracha, l_numsma, l_codprm, 0, 0, 0, l_prmsab, l_prmdom, l_prmfer);
                ELSE
                    SP_ATUPRM(l_crapri, l_numsma, l_codprm, 0, 0, 0, l_prmsab, l_prmdom, l_prmfer);
                END IF;
            END IF;
            /*Controle do Looping, onde deve ser efetuado o update no crachá provisório caso o mesmo exista.*/
            SP_RetCra_idtpes (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
            IF (l_cracha_pro = l_cracha) OR (l_cracha_pro = 0) THEN
                EXIT;
            ELSE
               l_cracha := l_cracha_pro;
               /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
               SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
               IF (l_crapri = 0) THEN
                   l_crapri := l_cracha;
               END IF;
            END IF;
        END LOOP;
        /*Obtem o Tipo de Pessoa*/
        SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
        SP_INTSTR(p_numemp,'9999',l_numemp OUT);
        SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
        SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
        l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
        /*Preenche o campo com espaços para completar 23 posições*/
        l_idtpes := lTrim(l_idtpes);
        l_idtpes := rTrim(l_idtpes);
        LOOP
            /*Controle do Loop.*/
            IF (Length(l_idtpes) > 22) THEN
                EXIT;
            END IF;
            l_idtpes := ' '||l_idtpes;
        END LOOP;
        /*Atualiza a Controle*/
        SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
  END IF;
END		SENIOR;20jSP_RETCRA_IDTPES
SP_MAPFIS
SP_INTSTR
SP_HISCON
SP_DATSTR
SP_UPDFIS
SP_UPDPRM
SP_ATUPRM
SP_ATUTSI
<<␀␀

PROCEDURE R034DAC_ATUCON(P_TIPCOL NUMBER,P_NUMEMP NUMBER,P_NUMCAD NUMBER,P_CODPRM NUMBER,P_PRMSAB NUMBER,P_PRMDOM NUMBER,P_PRMFER NUMBER,P_CONADP CHAR,P_CONIAL CHAR,P_TEMALM NUMBER,P_CONFAI NUMBER,P_VERPRM CHAR,P_CONCRE NUMBER,P_DATASO DATE,P_DATTSE DATE,P_VERAFA CHAR,P_CONPAC CHAR,P_TEMPAC NUMBER,P_TOLACP NUMBER,P_USABIO NUMBER,P_CONINT CHAR,P_TOLINT NUMBER,P_GRACON NUMBER,P_CONREA CHAR,P_REPONL CHAR,P_RECVIS CHAR,P_CONREE CHAR,P_USARFA CHAR)
 IS

l_cracha       NUMBER(12);
  l_cracha_pro   NUMBER(12);
  l_sqlstr       VARCHAR2(255);
  l_datval       CHAR(16);
  l_datstr       CHAR(6);
  l_menDatCra    BOOLEAN;
  /* Definições de acesso por colaborador R034DAC */
  l_anti_dupla   CHAR(1); /* Controla Anti-Dupla */
  l_fx_flg       CHAR(1); /* Controla Intervalo de Almoço */
  l_tempo_alm    CHAR(3); /* Tempo Mínimo de Almoço (Minutos) */
  l_ver_hora     CHAR(1); /* Controla Faixa Horária de Acesso */
  l_ver_local    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_cred     CHAR(1); /* Controla Creditos de Acesso */
  l_ver_valid    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_afast    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);  
  l_datfim       DATE;
  l_dataso       DATE;
  l_dattse       DATE;
  l_datcon       DATE;
  l_dathch       DATE;
  l_horfim       NUMBER(5);
  l_codprm       NUMBER(5);
  l_prmsab       NUMBER(5);
  l_prmdom       NUMBER(5);
  l_prmfer       NUMBER(5);
  l_horfim_str   CHAR(4);
  l_grupo        CHAR(5);
  l_gruposab     CHAR(5);
  l_grupodom     CHAR(5);
  l_grupofer     CHAR(5);
  l_Straux       VARCHAR2(2047);
  l_conadp       NUMBER(1);
  l_conial       NUMBER(1);
  l_verprm       NUMBER(1);
  l_verafa       NUMBER(1);
  l_gracon       NUMBER(3);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_conpac       NUMBER(1);
  l_tempac       NUMBER(3);
  l_tolacp       NUMBER(2);
  l_conrea       NUMBER(1);
  l_recvis       NUMBER(1);
  /*Interjornada*/
  l_conInt_Int   NUMBER(1);
  l_tolInt       NUMBER(3);
  /* REP */
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_pisStr       CHAR(11);
  l_conree       NUMBER(1);
  l_usarfa       NUMBER(1);
BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());  
  l_menDatCra  := FALSE;

  /* sempre atualiza os dados no crachá titular para TBS tipo 15 e 18 */
  SP_RetCra_idtpes (1,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
  IF   l_cracha = 0 THEN
      SP_RetCra_idtpes (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
  END IF;

  l_anti_dupla := '1';
  l_fx_flg     := '0';
  l_tempo_alm  := '000';
  l_ver_hora   := '1';
  l_ver_local  := '1';
  l_ver_valid  := '1';
  l_ver_afast  := '1';
  l_ver_cred   := '0';
  l_conInt_Int := 0;
  l_tolInt := 0;

  /* Verifica se Colaborador possui Cracha */
  IF   l_cracha <> 0  THEN
        /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
        SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
        IF (l_crapri = 0) THEN
            l_crapri := l_cracha;
        END IF;

        IF  p_conadp = 'S' THEN
            l_anti_dupla := '1';
            l_conadp := 1;
        ELSE
            l_anti_dupla := '0';
            l_conadp := 0;
        END IF;

        IF  p_conial = 'S' THEN
            l_fx_flg := '1';
            l_conial := 1;
        ELSE
            l_fx_flg := '0';
            l_conial := 0;
        END IF;

        SP_INTSTR(p_temalm,'999',l_tempo_alm OUT);

        SP_INTSTR(p_confai,'9',l_ver_hora OUT);

        /*Interjornada*/
        IF p_conint = 'S' THEN
            l_conInt_Int := 1;
            l_tolInt := p_tolInt;
        END IF;

        IF  p_verprm = 'S' THEN
            l_ver_local := '1';
            l_verprm := 1;
        ELSE
            l_ver_local := '0';
            l_verprm := 0;
        END IF;

        IF  p_verafa = 'S' THEN
            l_ver_afast := '1';
            l_verafa := 1;
        ELSE
            l_ver_afast := '0';
            l_verafa := 0;
        END IF;

        IF  p_conrea = 'S' THEN
            l_conrea := 1;
        ELSE
            l_conrea := 0;
        END IF;
        
        IF  p_recvis = 'S' THEN
            l_recvis := 1;
        ELSE
            l_recvis := 0;
        END IF;        

        IF  p_conree = 'S' THEN
            l_conree := 1;
        ELSE
            l_conree := 0;
        END IF;
        
        IF  p_usarfa = 'S' THEN
            l_usarfa := 1;
        ELSE
            l_usarfa := 0;
        END IF;

        IF  p_conpac = 'S' THEN
            l_conpac := 1;
            l_tempac := p_tempac;
            IF  p_tolacp > 99 THEN
                l_tolacp := 99;
            ELSE
                l_tolacp := p_tolacp;
            END IF;
        ELSE
            l_conpac := 0;
            l_tempac := 0;
            l_tolacp := 0;
        END IF;

        IF p_gracon IS NULL THEN
            /*Não não estiver informado, define o valor pradão para grau de conferência*/
            l_gracon := 50;
        ELSE
            l_gracon := p_gracon;
        END IF;

        SP_INTSTR(p_concre,'9',l_ver_cred OUT);

        /* Atualiza Controle */
        l_codprm:= p_codprm;
        l_prmsab:= p_prmsab;
        l_prmdom:= p_prmdom;
        l_prmfer:= p_prmfer;

        BEGIN
            SELECT CODPRM, PRMSAB, PRMDOM, PRMFER INTO l_codprm, l_prmsab, l_prmdom, l_prmfer FROM R064TPE WHERE
                   NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND
                   (DATINI < l_data_atual OR (DATINI = l_data_atual AND HORINI <= l_hora_atual))  AND 
                   (DATFIM > l_data_atual OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual) OR (DATFIM = l_data_zero));
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN RAISERROR 103 'ON-Line: Erro em R064TPE - TOO MANY ROWS';
            WHEN NO_DATA_FOUND THEN l_codprm:=p_codprm;
                                    l_prmsab:=p_prmsab;
                                    l_prmdom:=p_prmdom;
                                    l_prmfer:=p_prmfer;
            WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no SELECT R064TPE';
        END;

        SP_INTSTR(l_codprm,'99999',l_grupo OUT);
        SP_INTSTR(l_prmsab,'99999',l_gruposab OUT);
        SP_INTSTR(l_prmdom,'99999',l_grupodom OUT);
        SP_INTSTR(l_prmfer,'99999',l_grupofer OUT);
        LOOP
            /* contrato */
            IF  (p_tipcol = 2) OR (p_tipcol = 3) THEN
                SP_HISCON(p_numemp,p_tipcol,p_numcad,l_datcon OUT);
            ELSE
                l_datcon := '31/12/2050,00:00:00';
            END IF;

            /* verifica data final para terceiros e parceiros (período previsto, validade aso e validade treinamento) */
            IF   (p_dataso = l_data_zero) THEN
                 l_dataso := '31/12/2050,00:00:00';
            ELSE l_dataso := p_dataso;
            END IF;
            IF   (p_dattse = l_data_zero) THEN
                 l_dattse := '31/12/2050,00:00:00';
            ELSE l_dattse := p_dattse;
            END IF;
            IF   (l_datcon = l_data_zero) THEN
                 l_datcon := '31/12/2050,00:00:00';
            END IF;

            /*Obtem a Data de Validade do Crachá*/
            BEGIN
                SELECT DATFIM, HORFIM INTO l_dathch, l_horfim
                FROM R038HCH A
                WHERE NUMCRA = l_cracha AND
                DATINI = (SELECT MAX(DATINI) FROM R038HCH WHERE NUMCRA = l_cracha) AND
                HORINI = (SELECT MAX(HORINI) FROM R038HCH WHERE NUMCRA = l_cracha AND DATINI = A.DATINI);
            EXCEPTION
                WHEN OTHERS THEN NULL;
            END;
            IF (l_dathch = l_data_zero) THEN
                 l_dathch := '31/12/2050,00:00:00';
            END IF;

            IF   (l_dataso < l_dattse) THEN
                 IF   (l_dataso < l_datcon) THEN
                      l_datfim := l_dataso;
                 ELSE
                      IF  (l_dattse < l_datcon) THEN
                           l_datfim := l_dattse;
                      ELSE
                           l_datfim := l_datcon;
                      END IF;
                 END IF;
            ELSE
                 IF   (l_dattse < l_datcon)  THEN
                      l_datfim := l_dattse;
                 ELSE
                      l_datfim := l_datcon;
                 END IF;
            END IF;
            /*Compara se a data do crachá é a menor entre as datas*/
            IF l_dathch <= l_datfim THEN
                l_datfim := l_dathch;
                l_menDatCra := TRUE;
            END IF;

            /* converte data para str sem os separadores no formato DDMMYY */
            SP_DATSTR(l_datfim,'DDMMYY',l_datstr OUT);
            IF (l_menDatCra = TRUE) THEN
                IF (l_datstr = '311250') THEN
                    l_datval := l_datstr ||'2359000000';
                ELSE
                    SP_INTSTR(l_horfim,'HHMM',l_horfim_str OUT);
                    l_datval := l_datstr || l_horfim_str ||'000000';
                END IF;
            ELSE
                l_datval := l_datstr ||'2359000000';
            END IF;
            
            IF (l_datval = '0000002359000000') THEN
		        l_datval := '3112502359000000';
	        END IF;	

            /* atualiza o nome da pessoa para controle do REP*/
            l_nomfun := '';
            l_numpis := 0;
            l_pisStr := '';
            IF  (p_reponl <> 'S') THEN
                l_nomfun := '';
                l_numpis := 0;
                l_pisStr := '';
            ELSE
                BEGIN
                    SELECT NOMFUN, NUMPIS INTO l_nomfun, l_numpis FROM R034FUN WHERE
                           NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND (NUMPIS > 0 OR NUMCPF > 0);
                EXCEPTION
                    WHEN TOO_MANY_ROWS THEN RAISERROR 103 'ON-Line: Erro em R034FUN - TOO MANY ROWS';
                    WHEN NO_DATA_FOUND THEN l_nomfun := '';
                                            l_numpis := 0;
                                            l_pisStr := '';
                    WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no SELECT R034FUN';
                END;
            END IF;
            SP_INTSTR(l_numpis,'99999999999',l_pisStr OUT);

            /* atualiza r070con */
            BEGIN
                UPDATE R070CON SET
                        CODPRM=l_codprm,PRMSAB=l_prmsab,PRMDOM=l_prmdom,PRMFER=l_prmfer,
                        CONADP=l_conadp,CONIAL=l_conial,TEMALM=p_temalm,CONFAI=p_confai,
                        VERPRM=l_verprm,CONCRE=p_concre,VERAFA=l_verafa,USABIO=p_usabio,
                        DATVAL=l_datval,GRACON=l_gracon,CONINT=l_conInt_Int,TOLINT=l_tolInt,
                        CONPAC=l_conpac,TEMPAC=l_tempac,TOLACP=l_tolacp,CONREA=l_conrea,
                        NOMFUN=l_nomfun,NUMPIS=l_pisStr,RECVIS=l_recvis,CONREE=l_conree,
                        USARFA=l_usarfa
                 WHERE NUMFIS = l_crapri;
            EXCEPTION
                 WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro UPDATE R070CON.';
            END;
           
            /*Atualiza o(s) outro(s) Número(s) Fisico(s) na R070CON.*/
            SP_UPDFIS(l_cracha,' ',l_datval);
            /*Atualiza a permissão dos crachás secundários*/
            SP_UPDPRM(l_cracha,l_codprm,l_prmsab,l_prmdom,l_prmfer,' ',' ',' ');

            /*Atualiza informações que precisam ser repassadas para todos os os Crachás Secundários*/
            IF (l_tecpri <> 0) THEN
              /*Atualiza o Crachá de Barras se exisir*/
              IF (l_numbar <> 0) AND (l_tecpri <> 1) THEN
                  BEGIN
                      UPDATE R070CON SET VERPRM = l_verprm, NOMFUN=l_nomfun, NUMPIS=l_pisStr, VERAFA=l_verafa
                       WHERE NUMFIS = l_numbar;
                  EXCEPTION
                      WHEN OTHERS THEN NULL;
                  END;
              END IF;
              /*Atualiza o Crachá de Proximidade se exisir*/
              IF (l_numpro <> 0) AND (l_tecpri <> 2)THEN
                  BEGIN
                      UPDATE R070CON SET VERPRM = l_verprm, NOMFUN=l_nomfun, NUMPIS=l_pisStr, VERAFA=l_verafa
                       WHERE NUMFIS = l_numpro;
                  EXCEPTION
                      WHEN OTHERS THEN NULL;
                  END;
              END IF;
              /*Atualiza o Crachá Smart se exisir*/
              IF (l_numsma <> 0) AND (l_tecpri <> 3) THEN
                  BEGIN
                      UPDATE R070CON SET VERPRM = l_verprm, NOMFUN=l_nomfun, NUMPIS=l_pisStr, VERAFA=l_verafa
                       WHERE NUMFIS = l_numsma;
                  EXCEPTION
                      WHEN OTHERS THEN NULL;
                  END;
              END IF;
            END IF;
            /*Atualiza a Pend_grupo se possuir smart*/
            IF (l_numsma > 0) THEN
                /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
                IF (l_tecpri = 3) THEN
                    SP_ATUPRM(l_cracha, l_numsma, l_codprm, 0, 0, 0, l_prmsab, l_prmdom, l_prmfer);
                ELSE
                    SP_ATUPRM(l_crapri, l_numsma, l_codprm, 0, 0, 0, l_prmsab, l_prmdom, l_prmfer);
                END IF;
            END IF;
            /*Controle do Looping, onde deve ser efetuado o update no crachá provisório caso o mesmo exista.*/
            SP_RetCra_idtpes (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
            IF (l_cracha_pro = l_cracha) OR (l_cracha_pro = 0) THEN
                EXIT;
            ELSE
               l_cracha := l_cracha_pro;
               /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
               SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
               IF (l_crapri = 0) THEN
                   l_crapri := l_cracha;
               END IF;
            END IF;
        END LOOP;
        /*Obtem o Tipo de Pessoa*/
        SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
        SP_INTSTR(p_numemp,'9999',l_numemp OUT);
        SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
        SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
        l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
        /*Preenche o campo com espaços para completar 23 posições*/
        l_idtpes := lTrim(l_idtpes);
        l_idtpes := rTrim(l_idtpes);
        LOOP
            /*Controle do Loop.*/
            IF (Length(l_idtpes) > 22) THEN
                EXIT;
            END IF;
            l_idtpes := ' '||l_idtpes;
        END LOOP;
        /*Atualiza a Controle*/
        SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
  END IF;
END		SENIOR;21jSP_RETCRA_IDTPES
SP_MAPFIS
SP_INTSTR
SP_HISCON
SP_DATSTR
SP_UPDFIS
SP_UPDPRM
SP_ATUPRM
SP_ATUTSI
<<␀␀

PROCEDURE R034DAC_ATUCON(P_TIPCOL NUMBER,P_NUMEMP NUMBER,P_NUMCAD NUMBER,P_CODPRM NUMBER,P_PRMSAB NUMBER,P_PRMDOM NUMBER,P_PRMFER NUMBER,P_CONADP CHAR,P_CONIAL CHAR,P_TEMALM NUMBER,P_CONFAI NUMBER,P_VERPRM CHAR,P_CONCRE NUMBER,P_DATASO DATE,P_DATTSE DATE,P_VERAFA CHAR,P_CONPAC CHAR,P_TEMPAC NUMBER,P_TOLACP NUMBER,P_USABIO NUMBER,P_CONINT CHAR,P_TOLINT NUMBER,P_GRACON NUMBER,P_CONREA CHAR,P_REPONL CHAR,P_RECVIS CHAR,P_CONREE CHAR,P_USARFA CHAR)
 IS

l_cracha       NUMBER(12);
  l_cracha_pro   NUMBER(12);
  l_sqlstr       VARCHAR2(255);
  l_datval       CHAR(16);
  l_datstr       CHAR(6);
  l_menDatCra    BOOLEAN;
  /* Definições de acesso por colaborador R034DAC */
  l_anti_dupla   CHAR(1); /* Controla Anti-Dupla */
  l_fx_flg       CHAR(1); /* Controla Intervalo de Almoço */
  l_tempo_alm    CHAR(3); /* Tempo Mínimo de Almoço (Minutos) */
  l_ver_hora     CHAR(1); /* Controla Faixa Horária de Acesso */
  l_ver_local    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_cred     CHAR(1); /* Controla Creditos de Acesso */
  l_ver_valid    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_ver_afast    CHAR(1); /* Verifica se Tem Permissão de Acesso */
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);  
  l_datfim       DATE;
  l_dataso       DATE;
  l_dattse       DATE;
  l_datcon       DATE;
  l_dathch       DATE;
  l_horfim       NUMBER(5);
  l_codprm       NUMBER(5);
  l_prmsab       NUMBER(5);
  l_prmdom       NUMBER(5);
  l_prmfer       NUMBER(5);
  l_horfim_str   CHAR(4);
  l_grupo        CHAR(5);
  l_gruposab     CHAR(5);
  l_grupodom     CHAR(5);
  l_grupofer     CHAR(5);
  l_Straux       VARCHAR2(2047);
  l_conadp       NUMBER(1);
  l_conial       NUMBER(1);
  l_verprm       NUMBER(1);
  l_verafa       NUMBER(1);
  l_gracon       NUMBER(3);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tippes_str   CHAR(2);
  l_numemp       CHAR(4);
  l_tipcol       CHAR(1);
  l_numcad       CHAR(10);
  l_conpac       NUMBER(1);
  l_tempac       NUMBER(3);
  l_tolacp       NUMBER(2);
  l_conrea       NUMBER(1);
  l_recvis       NUMBER(1);
  /*Interjornada*/
  l_conInt_Int   NUMBER(1);
  l_tolInt       NUMBER(3);
  /* REP */
  l_nomfun       VARCHAR2(40);
  l_numpis       NUMBER(11);
  l_pisStr       CHAR(11);
  l_conree       NUMBER(1);
  l_usarfa       NUMBER(1);
BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_data_atual := CURDATE();
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());  
  l_menDatCra  := FALSE;

  /* sempre atualiza os dados no crachá titular para TBS tipo 15 e 18 */
  SP_RetCra_idtpes (1,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
  IF   l_cracha = 0 THEN
      SP_RetCra_idtpes (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha OUT);
  END IF;

  l_anti_dupla := '1';
  l_fx_flg     := '0';
  l_tempo_alm  := '000';
  l_ver_hora   := '1';
  l_ver_local  := '1';
  l_ver_valid  := '1';
  l_ver_afast  := '1';
  l_ver_cred   := '0';
  l_conInt_Int := 0;
  l_tolInt := 0;

  /* Verifica se Colaborador possui Cracha */
  IF   l_cracha <> 0  THEN
        /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
        SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
        IF (l_crapri = 0) THEN
            l_crapri := l_cracha;
        END IF;

        IF  p_conadp = 'S' THEN
            l_anti_dupla := '1';
            l_conadp := 1;
        ELSE
            l_anti_dupla := '0';
            l_conadp := 0;
        END IF;

        IF  p_conial = 'S' THEN
            l_fx_flg := '1';
            l_conial := 1;
        ELSE
            l_fx_flg := '0';
            l_conial := 0;
        END IF;

        SP_INTSTR(p_temalm,'999',l_tempo_alm OUT);

        SP_INTSTR(p_confai,'9',l_ver_hora OUT);

        /*Interjornada*/
        IF p_conint = 'S' THEN
            l_conInt_Int := 1;
            l_tolInt := p_tolInt;
        END IF;

        IF  p_verprm = 'S' THEN
            l_ver_local := '1';
            l_verprm := 1;
        ELSE
            l_ver_local := '0';
            l_verprm := 0;
        END IF;

        IF  p_verafa = 'S' THEN
            l_ver_afast := '1';
            l_verafa := 1;
        ELSE
            l_ver_afast := '0';
            l_verafa := 0;
        END IF;

        IF  p_conrea = 'S' THEN
            l_conrea := 1;
        ELSE
            l_conrea := 0;
        END IF;
        
        IF  p_recvis = 'S' THEN
            l_recvis := 1;
        ELSE
            l_recvis := 0;
        END IF;        

        IF  p_conree = 'S' THEN
            l_conree := 1;
        ELSE
            l_conree := 0;
        END IF;
        
        IF  p_usarfa = 'S' THEN
            l_usarfa := 1;
        ELSE
            l_usarfa := 0;
        END IF;

        IF  p_conpac = 'S' THEN
            l_conpac := 1;
            l_tempac := p_tempac;
            IF  p_tolacp > 99 THEN
                l_tolacp := 99;
            ELSE
                l_tolacp := p_tolacp;
            END IF;
        ELSE
            l_conpac := 0;
            l_tempac := 0;
            l_tolacp := 0;
        END IF;

        IF p_gracon IS NULL THEN
            /*Não não estiver informado, define o valor pradão para grau de conferência*/
            l_gracon := 50;
        ELSE
            l_gracon := p_gracon;
        END IF;

        SP_INTSTR(p_concre,'9',l_ver_cred OUT);

        /* Atualiza Controle */
        l_codprm:= p_codprm;
        l_prmsab:= p_prmsab;
        l_prmdom:= p_prmdom;
        l_prmfer:= p_prmfer;

        BEGIN
            SELECT CODPRM, PRMSAB, PRMDOM, PRMFER INTO l_codprm, l_prmsab, l_prmdom, l_prmfer FROM R064TPE WHERE
                   NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND
                   (DATINI < l_data_atual OR (DATINI = l_data_atual AND HORINI <= l_hora_atual))  AND 
                   (DATFIM > l_data_atual OR (DATFIM = l_data_atual AND HORFIM > l_hora_atual) OR (DATFIM = l_data_zero));
        EXCEPTION
            WHEN TOO_MANY_ROWS THEN RAISERROR 103 'ON-Line: Erro em R064TPE - TOO MANY ROWS';
            WHEN NO_DATA_FOUND THEN l_codprm:=p_codprm;
                                    l_prmsab:=p_prmsab;
                                    l_prmdom:=p_prmdom;
                                    l_prmfer:=p_prmfer;
            WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no SELECT R064TPE';
        END;

        SP_INTSTR(l_codprm,'99999',l_grupo OUT);
        SP_INTSTR(l_prmsab,'99999',l_gruposab OUT);
        SP_INTSTR(l_prmdom,'99999',l_grupodom OUT);
        SP_INTSTR(l_prmfer,'99999',l_grupofer OUT);
        LOOP
            /* contrato */
            IF  (p_tipcol = 2) OR (p_tipcol = 3) THEN
                SP_HISCON(p_numemp,p_tipcol,p_numcad,l_datcon OUT);
            ELSE
                l_datcon := '31/12/2050,00:00:00';
            END IF;

            /* verifica data final para terceiros e parceiros (período previsto, validade aso e validade treinamento) */
            IF   (p_dataso = l_data_zero) THEN
                 l_dataso := '31/12/2050,00:00:00';
            ELSE l_dataso := p_dataso;
            END IF;
            IF   (p_dattse = l_data_zero) THEN
                 l_dattse := '31/12/2050,00:00:00';
            ELSE l_dattse := p_dattse;
            END IF;
            IF   (l_datcon = l_data_zero) THEN
                 l_datcon := '31/12/2050,00:00:00';
            END IF;

            /*Obtem a Data de Validade do Crachá*/
            BEGIN
                SELECT DATFIM, HORFIM INTO l_dathch, l_horfim
                FROM R038HCH A
                WHERE NUMCRA = l_cracha AND
                DATINI = (SELECT MAX(DATINI) FROM R038HCH WHERE NUMCRA = l_cracha) AND
                HORINI = (SELECT MAX(HORINI) FROM R038HCH WHERE NUMCRA = l_cracha AND DATINI = A.DATINI);
            EXCEPTION
                WHEN OTHERS THEN NULL;
            END;
            IF (l_dathch = l_data_zero) THEN
                 l_dathch := '31/12/2050,00:00:00';
            END IF;

            IF   (l_dataso < l_dattse) THEN
                 IF   (l_dataso < l_datcon) THEN
                      l_datfim := l_dataso;
                 ELSE
                      IF  (l_dattse < l_datcon) THEN
                           l_datfim := l_dattse;
                      ELSE
                           l_datfim := l_datcon;
                      END IF;
                 END IF;
            ELSE
                 IF   (l_dattse < l_datcon)  THEN
                      l_datfim := l_dattse;
                 ELSE
                      l_datfim := l_datcon;
                 END IF;
            END IF;
            /*Compara se a data do crachá é a menor entre as datas*/
            IF l_dathch <= l_datfim THEN
                l_datfim := l_dathch;
                l_menDatCra := TRUE;
            END IF;

            /* converte data para str sem os separadores no formato DDMMYY */
            SP_DATSTR(l_datfim,'DDMMYY',l_datstr OUT);
            IF (l_menDatCra = TRUE) THEN
                IF (l_datstr = '311250') THEN
                    l_datval := l_datstr ||'2359000000';
                ELSE
                    SP_INTSTR(l_horfim,'HHMM',l_horfim_str OUT);
                    l_datval := l_datstr || l_horfim_str ||'000000';
                END IF;
            ELSE
                l_datval := l_datstr ||'2359000000';
            END IF;
            
            IF (l_datval = '0000002359000000') THEN
		        l_datval := '3112502359000000';
	        END IF;	

            /* atualiza o nome da pessoa para controle do REP*/
            l_nomfun := '';
            l_numpis := 0;
            l_pisStr := '';
            IF  (p_reponl <> 'S') THEN
                l_nomfun := '';
                l_numpis := 0;
                l_pisStr := '';
            ELSE
                BEGIN
                    SELECT NOMFUN, NUMPIS INTO l_nomfun, l_numpis FROM R034FUN WHERE
                           NUMEMP=p_numemp AND TIPCOL=p_tipcol AND NUMCAD=p_numcad AND (NUMPIS > 0 OR NUMCPF > 0);
                EXCEPTION
                    WHEN TOO_MANY_ROWS THEN RAISERROR 103 'ON-Line: Erro em R034FUN - TOO MANY ROWS';
                    WHEN NO_DATA_FOUND THEN l_nomfun := '';
                                            l_numpis := 0;
                                            l_pisStr := '';
                    WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro no SELECT R034FUN';
                END;
            END IF;
            SP_INTSTR(l_numpis,'99999999999',l_pisStr OUT);

            /* atualiza r070con */
            BEGIN
                UPDATE R070CON SET
                        CODPRM=l_codprm,PRMSAB=l_prmsab,PRMDOM=l_prmdom,PRMFER=l_prmfer,
                        CONADP=l_conadp,CONIAL=l_conial,TEMALM=p_temalm,CONFAI=p_confai,
                        VERPRM=l_verprm,CONCRE=p_concre,VERAFA=l_verafa,USABIO=p_usabio,
                        DATVAL=l_datval,GRACON=l_gracon,CONINT=l_conInt_Int,TOLINT=l_tolInt,
                        CONPAC=l_conpac,TEMPAC=l_tempac,TOLACP=l_tolacp,CONREA=l_conrea,
                        NOMFUN=l_nomfun,NUMPIS=l_pisStr,RECVIS=l_recvis,CONREE=l_conree,
                        USARFA=l_usarfa
                 WHERE NUMFIS = l_crapri;
            EXCEPTION
                 WHEN OTHERS THEN RAISERROR 103 'ON-Line: Erro UPDATE R070CON.';
            END;
           
            /*Atualiza o(s) outro(s) Número(s) Fisico(s) na R070CON.*/
            SP_UPDFIS(l_cracha,' ',l_datval);
            /*Atualiza a permissão dos crachás secundários*/
            SP_UPDPRM(l_cracha,l_codprm,l_prmsab,l_prmdom,l_prmfer,' ',' ',' ');

            /*Atualiza informações que precisam ser repassadas para todos os os Crachás Secundários*/
            IF (l_tecpri <> 0) THEN
              /*Atualiza o Crachá de Barras se exisir*/
              IF (l_numbar <> 0) AND (l_tecpri <> 1) THEN
                  BEGIN
                      UPDATE R070CON SET VERPRM = l_verprm, NOMFUN=l_nomfun, NUMPIS=l_pisStr, VERAFA=l_verafa
                       WHERE NUMFIS = l_numbar;
                  EXCEPTION
                      WHEN OTHERS THEN NULL;
                  END;
              END IF;
              /*Atualiza o Crachá de Proximidade se exisir*/
              IF (l_numpro <> 0) AND (l_tecpri <> 2)THEN
                  BEGIN
                      UPDATE R070CON SET VERPRM = l_verprm, NOMFUN=l_nomfun, NUMPIS=l_pisStr, VERAFA=l_verafa
                       WHERE NUMFIS = l_numpro;
                  EXCEPTION
                      WHEN OTHERS THEN NULL;
                  END;
              END IF;
              /*Atualiza o Crachá Smart se exisir*/
              IF (l_numsma <> 0) AND (l_tecpri <> 3) THEN
                  BEGIN
                      UPDATE R070CON SET VERPRM = l_verprm, NOMFUN=l_nomfun, NUMPIS=l_pisStr, VERAFA=l_verafa
                       WHERE NUMFIS = l_numsma;
                  EXCEPTION
                      WHEN OTHERS THEN NULL;
                  END;
              END IF;
            END IF;
            /*Atualiza a Pend_grupo se possuir smart*/
            IF (l_numsma > 0) THEN
                /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
                IF (l_tecpri = 3) THEN
                    SP_ATUPRM(l_cracha, l_numsma, l_codprm, 0, 0, 0, l_prmsab, l_prmdom, l_prmfer);
                ELSE
                    SP_ATUPRM(l_crapri, l_numsma, l_codprm, 0, 0, 0, l_prmsab, l_prmdom, l_prmfer);
                END IF;
            END IF;
            /*Controle do Looping, onde deve ser efetuado o update no crachá provisório caso o mesmo exista.*/
            SP_RetCra_idtpes (2,p_numemp, p_tipcol, p_numcad, 0,'',0,'',l_cracha_pro OUT);
            IF (l_cracha_pro = l_cracha) OR (l_cracha_pro = 0) THEN
                EXIT;
            ELSE
               l_cracha := l_cracha_pro;
               /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
               SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
               IF (l_crapri = 0) THEN
                   l_crapri := l_cracha;
               END IF;
            END IF;
        END LOOP;
        /*Obtem o Tipo de Pessoa*/
        SP_INTSTR(p_tipcol,'99',l_tippes_str OUT);
        SP_INTSTR(p_numemp,'9999',l_numemp OUT);
        SP_INTSTR(p_tipcol,'9',l_tipcol OUT);
        SP_INTSTR(p_numcad,'999999999',l_numcad OUT);
        l_idtpes:= l_tippes_str||l_numemp||l_tipcol||l_numcad;
        /*Preenche o campo com espaços para completar 23 posições*/
        l_idtpes := lTrim(l_idtpes);
        l_idtpes := rTrim(l_idtpes);
        LOOP
            /*Controle do Loop.*/
            IF (Length(l_idtpes) > 22) THEN
                EXIT;
            END IF;
            l_idtpes := ' '||l_idtpes;
        END LOOP;
        /*Atualiza a Controle*/
        SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
  END IF;
END		SENIOR;22jSP_RETCRA_IDTPES
SP_MAPFIS
SP_INTSTR
SP_HISCON
SP_DATSTR
SP_UPDFIS
