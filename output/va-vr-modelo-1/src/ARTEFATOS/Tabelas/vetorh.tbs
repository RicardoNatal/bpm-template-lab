SENIOR;0Ï
␀␀TRIGGER R017CAR_SI AFTER INSERT ON R017CAR

DECLARE
/* CURSOR c/ os registros gravados na tabela R017CAR_AUX */
  CURSOR c_r017car_ins IS SELECT ESTPOS, POSTRA, DATINI, DATFIM FROM R017CAR_AUX;

  TYPE t_r017car_aux IS RECORD(
    ESTPOS   R017CAR_AUX.ESTPOS%TYPE,
    POSTRA   R017CAR_AUX.POSTRA%TYPE,
    DATINI   R017CAR_AUX.DATINI%TYPE,
    DATFIM   R017CAR_AUX.DATFIM%TYPE);

  l_r017car_aux t_r017car_aux;

  l_datAux  DATE;
  l_datTer  DATE;
  l_datTerAnt  DATE;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r017car_ins INTO  l_r017car_aux.ESTPOS,
                              l_r017car_aux.POSTRA,
                              l_r017car_aux.DATINI,
                              l_r017car_aux.DATFIM
  LOOP
    BEGIN
      SELECT MAX(R017CAR.DATINI)
        INTO l_datTerAnt
        FROM R017CAR
       WHERE R017CAR.ESTPOS = l_r017car_aux.ESTPOS  AND
             R017CAR.POSTRA = l_r017car_aux.POSTRA AND
             R017CAR.DATINI < l_r017car_aux.DATINI;
    EXCEPTION WHEN OTHERS THEN
      NULL;
    END;

    IF (NOT l_datTerAnt IS NULL) THEN
      /* Atualiza data de término do anterior */
      BEGIN
         l_datAux := DATETIMEADD(DD, -1, l_r017car_aux.DATINI);

         UPDATE R017CAR
            SET DATFIM = l_datAux
          WHERE R017CAR.ESTPOS = l_r017car_aux.ESTPOS AND
                R017CAR.POSTRA = l_r017car_aux.POSTRA AND
                R017CAR.DATINI = l_datTerAnt;
      EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro ao atualizar tabela R017CAR.';
      END;
    END IF;

    /* Pega data de inicio do próximo */
    BEGIN
      SELECT MIN(DATINI)
        INTO l_datTer
        FROM R017CAR
       WHERE R017CAR.ESTPOS = l_r017car_aux.ESTPOS AND
             R017CAR.POSTRA = l_r017car_aux.POSTRA AND
             R017CAR.DATINI > l_r017car_aux.DATINI;

    EXCEPTION WHEN OTHERS THEN
        RAISERROR 103 'Erro no SELECT R017CAR.';
    END;

    /* Se não achou data posterior, então atualiza com a data 04/06/2080 */
    IF (l_datTer IS NULL) THEN
      l_datTer :='04/06/2080,00:00:00';
    ELSE
      l_datTer := DATETIMEADD(DD, -1, l_datTer);
    END IF;

    /* Atualiza data de término */
    BEGIN
       UPDATE R017CAR
          SET DATFIM = l_datTer
        WHERE R017CAR.ESTPOS = l_r017car_aux.ESTPOS AND
              R017CAR.POSTRA = l_r017car_aux.POSTRA AND
              R017CAR.DATINI = l_r017car_aux.DATINI;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar tabela R017CAR.';
    END;

  END LOOP;

  /* Apaga Registro OLD em R017CAR_AUX */
  BEGIN
    DELETE FROM R017CAR_AUX;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao excluir registros da tabela R017CAR_AUX.';
  END;
END␀vĞ␀␀		SENIOR;0]␀␀

TRIGGER R017CAR_EI AFTER INSERT ON R017CAR FOR EACH ROW

BEGIN
  BEGIN
    /* Insere Registro Old */
    INSERT INTO R017CAR_AUX (ESTPOS, POSTRA, DATINI, DATFIM)
                     VALUES (:NEW.ESTPOS, :NEW.POSTRA, :NEW.DATINI, :NEW.DATFIM);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R017CAR_AUX.';
  END;
END␀wĞ␀␀	SENIOR;0‡␀␀

TRIGGER R017CAR_SD AFTER DELETE ON R017CAR

DECLARE
/* CURSOR c/ os registros gravados no R017CAR_AUX */
  CURSOR c_r017car_del IS SELECT ESTPOS, POSTRA, DATINI, DATFIM FROM R017CAR_AUX;

  TYPE t_r017car_aux IS RECORD(
    ESTPOS   R017CAR_AUX.ESTPOS%TYPE,
    POSTRA   R017CAR_AUX.POSTRA%TYPE,
    DATINI   R017CAR_AUX.DATINI%TYPE,
    DATFIM   R017CAR_AUX.DATFIM%TYPE);

  l_r017car_aux2 t_r017car_aux;

  l_datTerAnt2 DATE;
BEGIN
  /* Le Registro do CURSOR */
  FOREACH c_r017car_del INTO  l_r017car_aux2.ESTPOS,
                              l_r017car_aux2.POSTRA,
                              l_r017car_aux2.DATINI,
                              l_r017car_aux2.DATFIM
  LOOP
    BEGIN
      SELECT MAX(R017CAR.DATINI)
        INTO l_datTerAnt2
        FROM R017CAR
       WHERE R017CAR.ESTPOS = l_r017car_aux2.ESTPOS AND
             R017CAR.POSTRA = l_r017car_aux2.POSTRA AND
             R017CAR.DATINI < l_r017car_aux2.DATINI;
    EXCEPTION WHEN OTHERS THEN
      NULL;
    END;

    BEGIN
      IF (NOT l_datTerAnt2 IS NULL) THEN
          UPDATE R017CAR
             SET DATFIM = l_r017car_aux2.DatFim
                 WHERE R017CAR.ESTPOS = l_r017car_aux2.ESTPOS AND
                 R017CAR.POSTRA = l_r017car_aux2.POSTRA AND
                 R017CAR.DATINI = l_datTerAnt2;
      END IF;
    EXCEPTION WHEN OTHERS THEN
      RAISERROR 103 'Erro ao atualizar data final da características.';
    END;
  END LOOP;

  /* Apaga Registro OLD da R017CAR_AUX */
  BEGIN
    DELETE FROM R017CAR_AUX;
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro ao excluir registros da tabela R017CAR_AUX.';
  END;
END␀uĞ␀␀		SENIOR;0]␀␀

TRIGGER R017CAR_ED AFTER DELETE ON R017CAR FOR EACH ROW

BEGIN
  BEGIN
    /* Insere Registro Old */
    INSERT INTO R017CAR_AUX (ESTPOS, POSTRA, DATINI, DATFIM)
                     VALUES (:OLD.ESTPOS, :OLD.POSTRA, :OLD.DATINI, :OLD.DATFIM);
  EXCEPTION WHEN OTHERS THEN
    RAISERROR 103 'Erro no INSERT em R017CAR_AUX.';
  END;
END␀␀␀ÇÄ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀sĞ␀␀+f±␀Ôÿ!␀␀␀␀␀␀=÷eËfq␀Æÿ␀␀ÿ␀Ä␀␀4Ôÿ!␀␀␀␀␀(Ap:Û;f␀␀␀ÿ␀␀ş¸␀␀␀EÑ␀Ôÿ!␀␀␀␀␀=L¢G¢GqC␀êÿ␀␀ÿ␀åDÑ␀Ôÿ!␀␀␀␀␀NNÔFqC␀êÿ␀␀ÿ␀␀␀␀␀␀␀ÊÄ␀␀␀␀␀␀␀yĞ␀␀+f±␀	Ôÿ!␀␀␀␀␀›>÷eËfq␀Æÿ␀␀€Ğ␀␀␀Ä␀␀4	Ôÿ!␀␀␀␀␀(Ap:Û;f␀␀␀ÿ␀␀ş¸␀␀␀EÑ␀	Ôÿ!␀␀␀␀␀<L¢G¢GqC␀êÿ␀␀tĞ␀␀␀f´␀	Ôÿ!␀␀␀␀␀ü<ïe»fr␀Æÿ␀␀)Ñ␀␀␀c'4	Ôÿ!␀␀␀␀␀@µ'µ'}␀␀ÿ␀␀Ñ␀␀␀␀␀␀	0;1;2;3;4␀␀ÈÄ␀␀␀␀␀␀␀␀zĞ␀␀+f±␀	Ôÿ1␀␀␀␀␀=øeËfq␀Æÿ␀␀d`␀Ä␀␀4	Ôÿ1␀␀␀␀␀¶Ä␀␀‘Ä␀␀¶Ä␀␀f␀␀␀ÿ␀␀ş¸␀␀␀¦%␀=Ôÿ1␀␀␀␀␀ä%␀{%␀Ï%␀c␀␀␀ÿ␀␀ÿ␀C-·␀Ôÿ1␀␀␀␀␀À¿␀␀¿␀␀£¿␀␀t␀Æÿ␀␀ÿ␀Æ␀␀·␀Ôÿ1␀␀␀␀␀Â¿␀␀¨¿␀␀©¿␀␀t␀Æÿ␀␀ÿ␀Æ␀␀·␀Ôÿ1␀␀␀␀␀Ã¿␀␀±¿␀␀²¿␀␀t␀Æÿ␀␀ÿ␀Æ␀␀·␀Ôÿ1␀␀␀␀␀Á¿␀␀¥¿␀␀¦¿␀␀t␀Æÿ␀␀ÿ␀Æ␀␀·␀Ôÿ1␀␀␀␀␀¾¿␀␀µ¿␀␀É¿␀␀t␀Æÿ␀␀ÿ␀~1(Ôÿ1␀␀␀␀␀g6lf6n␀Æÿ␀␀ÿ␀D1=Ôÿ1␀␀␀␀␀{6 ¯␀␀{6c␀␀␀ÿ␀␀ÿ␀f1Ôÿ1␀␀␀␀␀\6T6X6n␀Æÿ␀␀ÿ␀—1=Ôÿ1␀␀␀␀␀t6q6s6c␀␀␀ÿ␀␀ÿ␀¿	␀±␀Ôÿ1␀␀␀␀␀6
