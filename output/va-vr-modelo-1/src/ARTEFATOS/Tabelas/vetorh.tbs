DECLARE
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_coddsp       VARCHAR2(9);
  l_catmod       NUMBER(2);
  l_plfcon       CHAR(1);
  l_stalfc       NUMBER(1);
  l_ade_gerpen   BOOLEAN;
  l_dsp_camera   BOOLEAN;
  l_assapi       NUMBER(2);
BEGIN
  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R058DSP');

  IF (l_auditoria = 'S') THEN

      SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
      :NEW.SEQREG := l_seqreg;

      BEGIN
          INSERT INTO R058DSP_AUD (SEQREG,VERSEQ,CODDSP,MODRLG,DESDSP,VERPLF,CODPLF,DSPPAI,STADSP,
		                           OBSDSP,STAATU)
                           VALUES (l_seqreg,l_verseq,:NEW.CODDSP,:NEW.MODRLG,:NEW.DESDSP,:NEW.VERPLF,
						           :NEW.CODPLF,:NEW.DSPPAI,:NEW.STADSP,:NEW.OBSDSP,:NEW.STAATU);

          SP_AUDGENREG(l_seqreg,l_verseq,'R058DSP','INSERÇÃO');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
  
  SELECT CATMOD INTO l_catmod FROM R058MOD WHERE MODRLG = :NEW.MODRLG; 
  
  /* 1 - Terminal, 3 - Placa Controladora, 4 - Módulo Controlador, 5 - Leitor, 6 - Interface Entrada, 7 - Interface Saída */
  IF (l_catmod = 1 OR l_catmod = 3 OR l_catmod = 4 OR l_catmod = 5 OR l_catmod = 6 OR l_catmod = 7) THEN
      SP_INTSTR(:NEW.CODDSP, '999999999', l_coddsp OUT);
      SP_SAM_PENDENCIES(23, 1, l_coddsp);
  END IF;

  /* Verifica se o dispositivo é Telemática, pois pendências para disps. Telemática são geradas com o status 1 - Pendente */
  BEGIN
    SELECT 1 INTO l_stalfc FROM R058RLG RLG, R058MOD MOD WHERE RLG.MODRLG = MOD.MODRLG AND MOD.FABMOD = 1 AND RLG.CODDSP = :NEW.CODDSP;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_stalfc := 0;
    WHEN OTHERS THEN
      l_stalfc := 0;
  END;

  IF (:NEW.PLFENT IS NOT NULL) THEN
      /* Incluir no novo PLFENT */
      BEGIN
          SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = :NEW.VERPLF AND CODPLF = :NEW.PLFENT;
      EXCEPTION
          WHEN NO_DATA_FOUND THEN
              l_plfcon := 'N';
      END;

     IF (l_plfcon = 'S') THEN
          SP_PENDLFC(:NEW.CODDSP, :NEW.VERPLF, :NEW.PLFENT, 'I', l_stalfc);
      END IF;
  END IF;
  IF ((:NEW.PLFSAI IS NOT NULL) AND (:NEW.PLFENT IS NULL OR :NEW.PLFSAI <> :NEW.PLFENT)) THEN
      /* Incluir no novo PLFSAI */
      BEGIN
          SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = :NEW.VERPLF AND CODPLF = :NEW.PLFSAI;
      EXCEPTION
          WHEN NO_DATA_FOUND THEN
              l_plfcon := 'N';
      END;

      IF (l_plfcon = 'S') THEN
          SP_PENDLFC(:NEW.CODDSP, :NEW.VERPLF, :NEW.PLFSAI, 'I', l_stalfc);
      END IF;
  END IF;

  IF (:NEW.LATDSP IS NOT NULL AND :NEW.LATDSP <> 0 AND :NEW.LONDSP IS NOT NULL AND :NEW.LONDSP <> 0) THEN
      SP_VERCAM(:NEW.CODDSP, l_dsp_camera OUT);
      IF (l_dsp_camera = FALSE) THEN
          l_assapi := 51; /* Dispositivos de acesso */
      ELSE
          l_assapi := 52; /* Câmeras */
      END IF;

      SP_RECALF_GERPEN(l_assapi, l_ade_gerpen OUT);

      IF (l_ade_gerpen = TRUE) THEN
          SP_PENDADE_DSP('I', :NEW.CODDSP, :NEW.MODRLG, :NEW.VERPLF, :NEW.CODPLF, NULL);
      END IF;
  END IF;
END␀ˆ×␀␀		SENIOR;0␀-␀␀

TRIGGER R058DSP_EU AFTER UPDATE ON R058DSP FOR EACH ROW

DECLARE
  l_alterou          BOOLEAN;
  l_camposAlterados  VARCHAR(2000);
  l_verseq           NUMBER(10);
  l_seqreg           NUMBER(15);
  l_auditoria        CHAR(1);
  l_coddsp           VARCHAR2(9);
  l_catmod           NUMBER(2);
  l_comrlgaux        NUMBER(1);
  l_plfcon           CHAR(1);
  l_stalfc           NUMBER(1);
  l_ade_gerpen       BOOLEAN;
  l_dsp_camera       BOOLEAN;
  l_assapi           NUMBER(2);
  l_gerpen           BOOLEAN;
BEGIN
  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R058DSP');

  IF (l_auditoria = 'S') THEN

    l_camposAlterados := 'Campo(s) alterado(s): ';
    l_alterou := FALSE;

    IF (:NEW.CODDSP <> :OLD.CODDSP) THEN 
      l_alterou := TRUE;  
      l_camposAlterados := l_camposAlterados||'CODDSP ';
    END IF;

    IF (:NEW.MODRLG <> :OLD.MODRLG) THEN 
      l_alterou := TRUE;  
      l_camposAlterados := l_camposAlterados||'MODRLG ';
    END IF;

    IF (:NEW.DESDSP <> :OLD.DESDSP) THEN 
      l_alterou := TRUE;  
      l_camposAlterados := l_camposAlterados||'DESDSP ';
    END IF;

    IF (:NEW.VERPLF <> :OLD.VERPLF) THEN 
      l_alterou := TRUE;  
      l_camposAlterados := l_camposAlterados||'VERPLF ';
    END IF;

    IF (:NEW.CODPLF <> :OLD.CODPLF) THEN 
      l_alterou := TRUE;  
      l_camposAlterados := l_camposAlterados||'CODPLF ';
    END IF;

    IF (:NEW.DSPPAI <> :OLD.DSPPAI) THEN 
      l_alterou := TRUE;  
      l_camposAlterados := l_camposAlterados||'DSPPAI ';
    END IF;

    IF (:NEW.STADSP <> :OLD.STADSP) THEN 
      l_alterou := TRUE;  
      l_camposAlterados := l_camposAlterados||'STADSP ';
    END IF;

    IF (:NEW.OBSDSP <> :OLD.OBSDSP) THEN 
      l_alterou := TRUE;  
      l_camposAlterados := l_camposAlterados||'OBSDSP ';
    END IF;

    IF (:NEW.STAATU <> :OLD.STAATU) THEN 
      l_alterou := TRUE;  
      l_camposAlterados := l_camposAlterados||'STAATU ';
    END IF;

    IF (l_alterou = TRUE) THEN

      l_camposAlterados := 'ALTERAÇÃO - '||l_camposAlterados;

      l_seqreg := :NEW.SEQREG;

      IF ((:NEW.SEQREG IS NULL) OR (:NEW.SEQREG < 1)) THEN

        BEGIN
          SELECT MAX(SEQREG) INTO l_seqreg
            FROM R058DSP_AUD
            WHERE CODDSP = :OLD.CODDSP;
        EXCEPTION
          WHEN OTHERS THEN
            RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
        END;
      END IF;

      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
        INSERT INTO R058DSP_AUD (SEQREG,VERSEQ,CODDSP,MODRLG,DESDSP,VERPLF,CODPLF,DSPPAI,STADSP,OBSDSP,STAATU)
                       VALUES (l_seqreg,l_verseq,:NEW.CODDSP,:NEW.MODRLG,:NEW.DESDSP,:NEW.VERPLF,
                         :NEW.CODPLF,:NEW.DSPPAI,:NEW.STADSP,:NEW.OBSDSP,:NEW.STAATU);

        SP_AUDGENREG(l_seqreg,l_verseq,'R058DSP',l_camposAlterados);
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
    END IF;
  END IF; /*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
  
  l_gerpen := FALSE;

  IF (:NEW.DESDSP <> :OLD.DESDSP) OR
  	 (:NEW.DSPPAI <> :OLD.DSPPAI) OR
  	 (:NEW.MODRLG <> :OLD.MODRLG) OR
  	 (:NEW.VERPLF <> :OLD.VERPLF) OR
  	 (:NEW.CODPLF <> :OLD.CODPLF) OR
  	 (:NEW.PLFENT <> :OLD.PLFENT) OR
  	 (:NEW.PLFSAI <> :OLD.PLFSAI)
  THEN
  	 l_gerpen := TRUE;
  END IF;

  SELECT CATMOD INTO l_catmod FROM R058MOD WHERE MODRLG = :NEW.MODRLG;

  IF (l_gerpen = TRUE) THEN
      /* 1 - Terminal, 3 - Placa Controladora, 4 - Módulo Controlador, 5 - Leitor, 6 - Interface Entrada, 7 - Interface Saída */
      IF (l_catmod IN (1, 3, 4, 5, 6, 7)) THEN
         SP_INTSTR(:NEW.CODDSP, '999999999', l_coddsp OUT);
         SP_SAM_PENDENCIES(23, 2, l_coddsp);
     END IF;
  END IF;

  /* Verifica se o dispositivo é Telemática, pois pendências para disps. Telemática são geradas com o status 1 - Pendente */
  BEGIN
    SELECT 1 INTO l_stalfc FROM R058RLG RLG, R058MOD MOD WHERE RLG.MODRLG = MOD.MODRLG AND MOD.FABMOD = 1 AND RLG.CODDSP = :NEW.CODDSP;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      l_stalfc := 0;
    WHEN OTHERS THEN
      l_stalfc := 0;
  END;

  /* Caso seja alteração de status Ativo/Inativo, deverá ser gerada uma pendência para o SAM */
  IF ((:NEW.STADSP <> :OLD.STADSP) AND (l_catmod IN (1, 3, 4, 5, 6, 7))) THEN  
    /*Tratamento para oracle que não aceita null */
    BEGIN
      SELECT COMRLG INTO l_comrlgaux FROM R058RLG WHERE CODDSP = :NEW.CODDSP;
    EXCEPTION
      WHEN OTHERS THEN
        l_comrlgaux := 2;
    END;

    /* Verifica o tipo de comunicação do dispositivo (R058RLG.COMRLG) para disp. gerenciadores. Para os demais, o retorno será sempre NULL */
    IF (l_comrlgaux = NULL OR l_comrlgaux = 2) THEN  	 	 	
      /* Verifica se o novo status do dispositivo é INATIVO, para gerar o mesmo status que a CSM Center envia ao SAM */
      SP_INTSTR(:NEW.CODDSP, '999999999', l_coddsp OUT);
      SP_SAM_PENDENCIES(23, 2, l_coddsp);
    END IF;

    /* Se o disp. for leitoras ou disp. Telemática (que tenha PLFENT e/ou PLFSAI informado), gero pendências de LFC*/
    IF (:NEW.STADSP = 1 AND l_comrlgaux IS NOT NULL AND l_comrlgaux = 2) THEN
      IF (:NEW.PLFENT IS NOT NULL) THEN
        /* Incluir no novo PLFENT*/
        BEGIN
          SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = :NEW.VERPLF AND CODPLF = :NEW.PLFENT;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_plfcon := 'N';
        END;

        IF (l_plfcon = 'S') THEN
          SP_PENDLFC(:NEW.CODDSP, :NEW.VERPLF, :NEW.PLFENT, 'I', l_stalfc);
        END IF;
      END IF;
      IF ((:NEW.PLFSAI IS NOT NULL) AND (:NEW.PLFENT IS NULL OR :NEW.PLFSAI <> :NEW.PLFENT)) THEN
        /* Incluir no novo PLFSAI*/
        BEGIN
          SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = :NEW.VERPLF AND CODPLF = :NEW.PLFSAI;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_plfcon := 'N';
        END;

        IF (l_plfcon = 'S') THEN
          SP_PENDLFC(:NEW.CODDSP, :NEW.VERPLF, :NEW.PLFSAI, 'I', l_stalfc);
        END IF;
      END IF;
    ELSE
      IF (:NEW.PLFENT IS NOT NULL) THEN
        /* Remover do antigo PLFENT*/
        BEGIN
          SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = :NEW.VERPLF AND CODPLF = :NEW.PLFENT;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_plfcon := 'N';
        END;

        IF (l_plfcon = 'S') THEN
          SP_PENDLFC(:NEW.CODDSP, :NEW.VERPLF, :NEW.PLFENT, 'E', l_stalfc);
        END IF;
      END IF;
      IF ((:NEW.PLFSAI IS NOT NULL) AND (:NEW.PLFENT IS NULL OR :NEW.PLFSAI <> :NEW.PLFENT)) THEN
        /* Remover do antigo PLFSAI*/
        BEGIN
          SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = :NEW.VERPLF AND CODPLF = :NEW.PLFSAI;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            l_plfcon := 'N';
        END;

        IF (l_plfcon = 'S') THEN
          SP_PENDLFC(:NEW.CODDSP, :NEW.VERPLF, :NEW.PLFSAI, 'E', l_stalfc);
        END IF;
      END IF;
    END IF;
  END IF; /* IF ((:NEW.STADSP <> :OLD.STADSP)*/

  IF ((:NEW.PLFENT <> :OLD.PLFENT) OR (:NEW.PLFSAI <> :OLD.PLFSAI)) THEN
    IF (:OLD.PLFENT IS NOT NULL AND (:NEW.PLFENT IS NULL OR :OLD.PLFENT <> :NEW.PLFENT) AND (:NEW.PLFSAI IS NULL OR :OLD.PLFENT <> :NEW.PLFSAI)) THEN
        /* Remover do antigo PLFENT*/
        BEGIN
            SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = :NEW.VERPLF AND CODPLF = :OLD.PLFENT;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_plfcon := 'N';
        END;

        IF (l_plfcon = 'S') THEN
            SP_PENDLFC(:NEW.CODDSP, :NEW.VERPLF, :OLD.PLFENT, 'E', l_stalfc);
        END IF;
    END IF;
    IF (:OLD.PLFSAI IS NOT NULL AND (:NEW.PLFENT IS NULL OR :OLD.PLFSAI <> :NEW.PLFENT) AND (:NEW.PLFSAI IS NULL OR :OLD.PLFSAI <> :NEW.PLFSAI)) THEN
      /* Remover do antigo PLFSAI*/
        BEGIN
            SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = :NEW.VERPLF AND CODPLF = :OLD.PLFSAI;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_plfcon := 'N';
        END;

        IF (l_plfcon = 'S') THEN
            SP_PENDLFC(:NEW.CODDSP, :NEW.VERPLF, :OLD.PLFSAI, 'E', l_stalfc);
        END IF;
    END IF;
    IF (:NEW.PLFENT IS NOT NULL AND (:OLD.PLFENT IS NULL OR :NEW.PLFENT <> :OLD.PLFENT) AND (:OLD.PLFSAI IS NULL OR :NEW.PLFENT <> :OLD.PLFSAI)) THEN
        /* Incluir no novo PLFENT*/
        BEGIN
            SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = :NEW.VERPLF AND CODPLF = :NEW.PLFENT;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_plfcon := 'N';
        END;

        IF (l_plfcon = 'S') THEN
            SP_PENDLFC(:NEW.CODDSP, :NEW.VERPLF, :NEW.PLFENT, 'I', l_stalfc);
        END IF;
    END IF;
    IF (:NEW.PLFSAI IS NOT NULL AND (:OLD.PLFENT IS NULL OR :NEW.PLFSAI <> :OLD.PLFENT) AND (:OLD.PLFSAI IS NULL OR :NEW.PLFSAI <> :OLD.PLFSAI)) THEN
        /* Incluir no novo PLFSAI*/
        BEGIN
            SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = :NEW.VERPLF AND CODPLF = :NEW.PLFSAI;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                l_plfcon := 'N';
        END;

        IF (l_plfcon = 'S') THEN
            SP_PENDLFC(:NEW.CODDSP, :NEW.VERPLF, :NEW.PLFSAI, 'I', l_stalfc);
        END IF;
    END IF;
  END IF;

  SP_VERCAM(:NEW.CODDSP, l_dsp_camera OUT);
  IF (l_dsp_camera = FALSE) THEN
      l_assapi := 51; /* Dispositivos de acesso */
  ELSE
      l_assapi := 52; /* Câmeras */
  END IF;

  SP_RECALF_GERPEN(l_assapi, l_ade_gerpen OUT);
  IF (l_ade_gerpen = TRUE) THEN
      IF (:NEW.PROTCL IS NULL OR (:OLD.PROTCL IS NOT NULL AND :OLD.PROTCL = :NEW.PROTCL)) THEN
          IF (((:OLD.LATDSP IS NULL OR :OLD.LATDSP = 0) AND :NEW.LATDSP IS NOT NULL AND :NEW.LATDSP <> 0) AND
              ((:OLD.LONDSP IS NULL OR :OLD.LONDSP = 0) AND :NEW.LONDSP IS NOT NULL AND :NEW.LONDSP <> 0)) THEN
              /* Se nunca teve coordenadas, gera pendência de insert */
              SP_PENDADE_DSP('I', :NEW.CODDSP, :NEW.MODRLG, :NEW.VERPLF, :NEW.CODPLF, NULL);
          ELSE IF ((:OLD.LATDSP IS NOT NULL AND :OLD.LATDSP <> 0 AND (:NEW.LATDSP IS NULL OR :NEW.LATDSP = 0)) AND
                   (:OLD.LONDSP IS NOT NULL AND :OLD.LONDSP <> 0 AND (:NEW.LONDSP IS NULL OR :NEW.LONDSP = 0))) THEN
                   /* Se removeu as coordenadas, gera pendência de exclusão */
                   SP_PENDADE_DSP('E', :NEW.CODDSP, :NEW.MODRLG, :OLD.VERPLF, :OLD.CODPLF, :OLD.PROTCL);
               ELSE IF (:NEW.LATDSP IS NOT NULL AND :NEW.LATDSP <> 0 AND :NEW.LONDSP IS NOT NULL AND :NEW.LONDSP <> 0 AND
                        (:NEW.LATDSP <> :OLD.LATDSP OR :NEW.LONDSP <> :OLD.LONDSP OR :NEW.AZIMUT <> :OLD.AZIMUT OR 
                         (:OLD.STAADE = 0 AND :NEW.STAADE = 1) OR (:OLD.STAADE = 1 AND :NEW.STAADE = 0))) THEN
                        /* Se realmente só alterou as coordenadas ou azimut ou o status para inativo ou ativo, gera pendência de retificação */
                        SP_PENDADE_DSP('R', :NEW.CODDSP, :NEW.MODRLG, :NEW.VERPLF, :NEW.CODPLF, :OLD.PROTCL);
                    END IF;
               END IF;
          END IF;
      END IF;
  END IF;
END␀†×␀␀		SENIOR;0ğ␀␀

TRIGGER R058DSP_ED AFTER DELETE ON R058DSP FOR EACH ROW

DECLARE
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_coddsp       VARCHAR2(9);
  l_catmod       NUMBER(2);
  l_plfcon       CHAR(1);
  l_ade_gerpen   BOOLEAN;
  l_dsp_camera   BOOLEAN;
  l_assapi       NUMBER(2);
BEGIN
  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R058DSP');

  IF (l_auditoria = 'S') THEN
      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg
                FROM R058DSP_AUD
               WHERE CODDSP = :OLD.CODDSP;
           EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
          INSERT INTO R058DSP_AUD (SEQREG,VERSEQ,CODDSP,MODRLG,DESDSP,VERPLF,CODPLF,DSPPAI,STADSP,
		                           OBSDSP,STAATU)
                           VALUES (l_seqreg,l_verseq,:OLD.CODDSP,:OLD.MODRLG,:OLD.DESDSP,:OLD.VERPLF,
						           :OLD.CODPLF,:OLD.DSPPAI,:OLD.STADSP,:OLD.OBSDSP,:OLD.STAATU);

          SP_AUDGENREG(l_seqreg,l_verseq,'R058DSP','DELETE');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/
  
  SELECT CATMOD INTO l_catmod FROM R058MOD WHERE MODRLG = :OLD.MODRLG; 
  
  /* 1 - Terminal, 3 - Placa Controladora, 4 - Módulo Controlador, 5 - Leitor, 6 - Interface Entrada, 7 - Interface Saída */
  IF (l_catmod = 1 OR l_catmod = 3 OR l_catmod = 4 OR l_catmod = 5 OR l_catmod = 6 OR l_catmod = 7) THEN
      SP_INTSTR(:OLD.CODDSP, '999999999', l_coddsp OUT);
      SP_SAM_PENDENCIES(23, 3, l_coddsp);
  END IF;

  /* Ao remover um dispositivo, gero pendência de exclusão do dispositivo, com o status 1 - Pendente, para tratamento imediato.
   * É necessária apenas 1 pendência por dispositivo. */
  IF (:OLD.PLFENT IS NOT NULL OR :OLD.PLFSAI IS NOT NULL) THEN
      /* Remover do antigo PLFENT*/
      BEGIN
          SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = :OLD.VERPLF AND CODPLF = :OLD.PLFENT;
      EXCEPTION
          WHEN NO_DATA_FOUND THEN
              l_plfcon := 'N';
      END;

      IF (l_plfcon = 'S') THEN
          SP_PENDLFC(:OLD.CODDSP, :OLD.VERPLF, 0, 'E', 1);
      END IF;
      
      /* Remover do antigo PLFSAI*/
      IF (l_plfcon = 'N') THEN
          BEGIN
              SELECT PLFCON INTO l_plfcon FROM R158PLF WHERE VERPLF = :OLD.VERPLF AND CODPLF = :OLD.PLFSAI;
          EXCEPTION
              WHEN NO_DATA_FOUND THEN
                  l_plfcon := 'N';
          END;

          IF (l_plfcon = 'S') THEN
              SP_PENDLFC(:OLD.CODDSP, :OLD.VERPLF, 0, 'E', 1);
          END IF;
      END IF;
  END IF;

  IF (:OLD.LATDSP IS NOT NULL AND :OLD.LATDSP <> 0 AND :OLD.LONDSP IS NOT NULL AND :OLD.LONDSP <> 0) THEN
      SP_VERCAM(:OLD.CODDSP, l_dsp_camera OUT);
      IF (l_dsp_camera = FALSE) THEN
          l_assapi := 51; /* Dispositivos de acesso */
      ELSE
          l_assapi := 52; /* Câmeras */
      END IF;

      SP_RECALF_GERPEN(l_assapi, l_ade_gerpen OUT);
      IF (l_ade_gerpen = TRUE) THEN
          SP_PENDADE_DSP('E', :OLD.CODDSP, :OLD.MODRLG, :OLD.VERPLF, :OLD.CODPLF, :OLD.PROTCL);
      END IF;
  END IF;
END␀␀␀û]␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀„×␀␀ş␀␀¢␀	„␀␀␀␀␀␀Şş␀␀Eü␀␀Şş␀␀i␀Æÿ␀␀ÿ␀­%␀‹␀	„␀␀␀␀␀␀&␀}%␀&␀a␀Æÿ␀␀ÿ␀m,Ì␀	„␀␀␀␀␀␀N@¤:¤:{␀Æÿ␀␀ÿ␀} ␀␀´␀␀␀␀␀␀␀ç@T¡␀␀T¡␀␀r␀Æÿ␀␀Í×␀␀␀kTc„␀␀␀␀␀␀ÜX°V°V`␀␀ÿ␀␀ÿ␀¥%␀±␀␀␀␀␀␀␀?&␀;&␀;&␀q␀Æÿ␀␀6Ø␀␀␀3-Á␀␀␀␀␀␀␀Ï@˜š␀␀˜š␀␀y␀Æÿ␀␀å×␀␀␀ò^Ì␀␀␀␀␀␀␀P@Ç;Ç;{␀Æÿ␀␀…×␀␀␀␀Ö␀␀␀␀␀␀İ␀R␀R␀n␀Æÿ␀␀ÿ␀|‹␀␀Ò␀␀␀␀␀␀␀f‹␀␀V‹␀␀V‹␀␀ÿ␀ÿÿ␀␀ÿ␀u³␀␀€␀␀␀␀␀␀␀ñ³␀␀ñ³␀␀ñ³␀␀!␀␀ÿ␀␀ÿ␀␀\␀␀␀␀␀␀È␀“␀“␀n␀Æÿ␀␀ÿ␀Â±␀␀␀␀␀␀␀ÅÃÄq␀Æÿ␀␀ÿ␀Ë—␀␀␀␀␀␀␀␀Õ—␀␀Ô—␀␀Ô—␀␀#␀␀ÿ␀␀ÿ␀I›␀␀␀␀␀␀␀␀O›␀␀N›␀␀N›␀␀#␀␀ÿ␀␀ÿ␀␀␀␀0;1;2␀␀ü]␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀‰×␀␀m,Ì␀	␀␀␀␀␀␀N@¤:¤:{␀Æÿ␀␀…×␀␀␀Å	␀±␀␀␀␀␀␀␀
␀
␀
␀q␀Æÿ␀␀ÿ␀©í␀␀␀␀␀␀␀ÙÙÙn␀Æÿ␀␀ÿ␀İ	␀±␀␀␀␀␀␀␀
