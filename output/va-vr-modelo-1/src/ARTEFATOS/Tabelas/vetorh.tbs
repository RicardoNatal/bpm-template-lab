TRIGGER R086ACT_AD AFTER DELETE ON R086ACT FOR EACH ROW
BEGIN
	DELETE FROM R240ACT
	WHERE
		NUMEMP = :OLD.NUMEMP AND TIPCOL = :OLD.TIPCOL AND NUMCAD = :OLD.NUMCAD AND DATACT = :OLD.DATACT AND HORACT =
		:OLD.HORACT;
EXCEPTION
	WHEN OTHERS THEN
		RAISERROR 103 'Erro no Delete da Tabela R240ACT. ';
