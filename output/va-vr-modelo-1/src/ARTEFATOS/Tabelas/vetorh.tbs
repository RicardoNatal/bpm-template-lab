TRIGGER R304CPE_ED BEFORE DELETE ON R304CPE FOR EACH ROW
DECLARE
	l_QtdReg NUMBER;
BEGIN
	/* Verifica se tem registros na tabela filha R304BCP */
	l_QtdReg := 0;	
	BEGIN
		SELECT COUNT(1) INTO l_QtdReg FROM R304BCP WHERE PIDSTA = :OLD.PidSta;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar quantidade de registros na tabela R304BCP.';
	END;	
	IF (l_QtdReg > 0) THEN
		RAISERROR 103 'Não é possível efetuar a exclusão da Concessão de Pensão, pois existem beneficiário(s) da concessão da pensão cadastrados para o mesmo.';
	END IF;
	
	/* Verifica se tem registros na tabela filha R304PCP */
	l_QtdReg := 0;	
	BEGIN
		SELECT COUNT(1) INTO l_QtdReg FROM R304PCP WHERE PIDSTA = :OLD.PidSta;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar quantidade de registros na tabela R304PCP.';
	END;	
	IF (l_QtdReg > 0) THEN
		RAISERROR 103 'Não é possível efetuar a exclusão da concessão de Pensão, pois existem proventos(s) da concessão da pensão cadastrados para o mesmo.';
	END IF;
	
	/* Verifica se tem registros na tabela filha R304TCP */
	l_QtdReg := 0;	
	BEGIN
		SELECT COUNT(1) INTO l_QtdReg FROM R304TCP WHERE PIDSTA = :OLD.PidSta;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar quantidade de registros na tabela R304TCP.';
	END;	
	IF (l_QtdReg > 0) THEN
		RAISERROR 103 'Não é possível efetuar a exclusão da concessão de Pensão, pois existem tempo(s) de serviço da concessão da pensão cadastrados para o mesmo.';
	END IF;
	
	/* Verifica se tem registros na tabela filha R304ACP */
	l_QtdReg := 0;	
	BEGIN
		SELECT COUNT(1) INTO l_QtdReg FROM R304ACP WHERE PIDSTA = :OLD.PidSta;
	EXCEPTION
		WHEN OTHERS THEN
			RAISERROR 103 'Erro ao buscar quantidade de registros na tabela R304ACP.';
	END;	
	IF (l_QtdReg > 0) THEN
		RAISERROR 103 'Não é possível efetuar a exclusão da concessão de Pensão, pois existem arquivo(s) da concessão da pensão cadastrados para o mesmo.';
	END IF;
END␀␀␀&*␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀…å␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀.␀t	Ôÿ?␀␀␀␀␀Ü␀t␀Ü␀n␀Æÿ␀␀ˆÓ␀␀␀c¬␀␀Ì␀	Ôÿ?␀␀␀␀␀P%€$0.w␀Æÿ␀␀…Ó␀␀␀ª¬␀␀	Ôÿ?␀␀␀␀␀°␀␀H¯␀␀°␀␀%␀␀ÿ␀␀ÿ␀s¬␀␀␀	Ôÿ␀␀␀␀␀c?‰#±␀␀Q␀Æÿ␀␀ÿ␀Û&␀Ñ␀	Ôÿ␀␀␀␀␀ KÈG5KqC␀êÿ␀␀ÿ␀ş␀␀Ì␀	Ôÿ?␀␀␀␀␀xş␀␀xş␀␀xş␀␀{␀Æÿ␀␀ÿ␀␀¤	Ôÿ␀␀␀␀␀U␀U␀U␀p␀Æÿ␀␀ÿ␀0,Ôÿ?␀␀␀␀␀
