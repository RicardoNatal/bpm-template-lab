;0:	␀␀TRIGGER R058GRL_EI AFTER INSERT ON R058GRL FOR EACH ROW
DECLARE
    l_codgrr NUMBER(3);
    l_verplf NUMBER(3);
    l_codplf NUMBER(7);
    l_temrec NUMBER(1);
    alfmen   VARCHAR2(255);

    CURSOR c_prmgrp IS SELECT CODPRM FROM R058GRP WHERE CODGRR = l_codgrr;

    TYPE t_prmgrp IS RECORD(
           CODPRM   R058GRP.CodPrm%TYPE);

    l_prmgrp t_prmgrp;

BEGIN
    l_codgrr := :NEW.CODGRR;

    /* Ao incluir um dispositivo em um grupo de dispositivos:
       - Pego o local físico do dispositivo, e vejo se é um local físico alfandegado (recinto alfandegado);
       - Se sim, verifico todas as permissões que possuem este grupo, e verifico se esse recinto alfandegado já está associado à permissão;
         - Se ainda não está associado, incluo a associação permissão x recinto alfandegado (cada permissão que possui este grupo). */
    BEGIN
       SELECT DSP.VERPLF, DSP.CODPLF INTO l_verplf, l_codplf
        FROM R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE DSP.CODDSP = :NEW.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF AND PLF.CATPLF = 9
         AND PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3;
    EXCEPTION WHEN OTHERS THEN
        l_verplf := 0;
        l_codplf := 0;
    END;

    IF (l_codplf > 0) THEN
        FOREACH c_prmgrp INTO l_prmgrp.CODPRM
        LOOP
            BEGIN
               SELECT 1 INTO l_temrec FROM R058PRR 
                WHERE CODPRM = l_prmgrp.CODPRM AND VERPLF = l_verplf AND CODPLF = l_codplf;
            EXCEPTION
                WHEN OTHERS THEN l_temrec := 0;
            END;

            IF (l_temrec = 0) THEN
                BEGIN
                    INSERT INTO R058PRR (CODPRM, VERPLF, CODPLF)
                         VALUES (l_prmgrp.CODPRM, l_verplf, l_codplf);
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'R058GRL_EI: Erro ao inserir associação entre permissão e local físico. Permissão: '
                          || CONVERT(NUMBER_TO_CHAR, l_prmgrp.CODPRM) || '. Versão: ' || CONVERT(NUMBER_TO_CHAR, l_verplf)
                          || '. Cód. Local Físico: ' || CONVERT(NUMBER_TO_CHAR, l_codplf) || '. Grupo: ' || CONVERT(NUMBER_TO_CHAR, :NEW.CODGRR);
                    RAISERROR 103 alfmen;
                END;
            END IF;
        END LOOP;
    END IF;
END␀§×␀␀		SENIOR;0K␀␀

TRIGGER R058GRL_ED AFTER DELETE ON R058GRL FOR EACH ROW
DECLARE
    l_codgrr NUMBER(3);
    l_verplf NUMBER(3);
    l_codplf NUMBER(7);
    l_temrlp NUMBER(1);
    l_temgrp NUMBER(1);
    alfmen   VARCHAR2(255);

    CURSOR c_prmgrp IS SELECT CODPRM FROM R058GRP WHERE CODGRR = l_codgrr;

    TYPE t_prmgrp IS RECORD(
           CODPRM   R058GRP.CodPrm%TYPE);

    l_prmgrp t_prmgrp;

BEGIN
    l_codgrr := :OLD.CODGRR;
    /* Ao remover um dispositivo de um grupo de dispositivos:
       - Pego o local físico do dispositivo, e vejo se é um local físico alfandegado (recinto alfandegado);
       - Se sim, verifico todas as permissões que possuem este grupo, e verifico se existem outros dispositivos
         ou grupos de dispositivos nessa permissão que dão acesso a este recinto alfandegado;
         - Se não existe mais nenhum dispositivo ligado ao recinto alfandegado, excluo da associação permissão x recinto alfandegado. */
    BEGIN
       SELECT DSP.VERPLF, DSP.CODPLF INTO l_verplf, l_codplf
        FROM R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE DSP.CODDSP = :OLD.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF AND PLF.CATPLF = 9
         AND PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3;
    EXCEPTION WHEN OTHERS THEN
        l_verplf := 0;
        l_codplf := 0;
    END;

    IF (l_codplf > 0) THEN
        FOREACH c_prmgrp INTO l_prmgrp.CODPRM
        LOOP
            BEGIN
               SELECT 1 INTO l_temrlp FROM R058RLP RLP, R058DSP DSP
                WHERE RLP.CODDSP = DSP.CODDSP
                  AND RLP.CODPRM = l_prmgrp.CODPRM AND DSP.VERPLF = l_verplf AND DSP.CODPLF = l_codplf;
            EXCEPTION
                WHEN OTHERS THEN l_temrlp := 0;
            END;

            BEGIN
               SELECT 1 INTO l_temgrp FROM R058GRP GRP, R058GRL GRL, R058DSP DSP
                WHERE GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP
                  AND GRP.CODPRM = l_prmgrp.CODPRM AND DSP.VERPLF = l_verplf AND DSP.CODPLF = l_codplf;
            EXCEPTION
                WHEN OTHERS THEN l_temgrp := 0;
            END;

            IF (l_temrlp = 0 AND l_temgrp = 0) THEN
                BEGIN
                    DELETE FROM R058PRR WHERE CODPRM = l_prmgrp.CODPRM AND VERPLF = l_verplf AND CODPLF = l_codplf;
                EXCEPTION WHEN OTHERS THEN
                    alfmen := 'R058GRL_ED: Erro ao excluir associação entre permissão e local físico. Permissão: '
                          || CONVERT(NUMBER_TO_CHAR, l_prmgrp.CODPRM) || '. Versão: ' || CONVERT(NUMBER_TO_CHAR, l_verplf)
                          || '. Cód. Local Físico: ' || CONVERT(NUMBER_TO_CHAR, l_codplf) || '. Grupo: ' || CONVERT(NUMBER_TO_CHAR, :OLD.CODGRR);
                    RAISERROR 103 alfmen;
                END;
            END IF;
        END LOOP;
    END IF;
END␀␀␀±.␀␀␀␀©×␀␀C-·␀	␀␀␀␀␀␀~=¿␀␀¿␀␀t␀Æÿ␀␀ı×␀␀␀¯,±␀	␀␀␀␀␀␀‚@ÇtÇtq␀Æÿ␀␀­×␀␀␀,±␀␀␀␀␀␀␀
=llq␀Æÿ␀␀ÿ␀␀␀␀0;1«×␀␀		SENIOR;0␀␀TRIGGER R058GRP_EI AFTER INSERT ON R058GRP FOR EACH ROW
DECLARE
    l_codgrr NUMBER(3);
    l_temrec NUMBER(1);
    alfmen   VARCHAR2(255);

    CURSOR C_RECGRR IS
      SELECT PLF.VERPLF, PLF.CODPLF 
        FROM R058GRL GRL, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE GRL.CODGRR = l_codgrr AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF AND PLF.CATPLF = 9
         AND PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3;

    TYPE T_RECGRR IS RECORD (
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE);

    l_recgrr T_RECGRR;

BEGIN
    l_codgrr := :NEW.CODGRR;

    /* Ao incluir um grupo de dispositivos em uma permissão:
        - Verifico os recintos alfandegados do grupo de dispositivos;
        - Para cada recinto:
          - Verifico se esse recinto alfandegado já está associado à permissão;
          - Se ainda não está associado, incluo a associação permissão x recinto alfandegado.*/
    FOREACH C_RECGRR INTO l_recgrr.VERPLF,
                          l_recgrr.CODPLF
    LOOP
        BEGIN
           SELECT 1 INTO l_temrec FROM R058PRR 
            WHERE CODPRM = :NEW.CODPRM AND VERPLF = l_recgrr.VERPLF AND CODPLF = l_recgrr.CODPLF;
        EXCEPTION
            WHEN OTHERS THEN l_temrec := 0;
        END;

        IF (l_temrec <> 1) THEN
            BEGIN
                INSERT INTO R058PRR (CODPRM, VERPLF, CODPLF)
                     VALUES (:NEW.CODPRM, l_recgrr.VERPLF, l_recgrr.CODPLF);
            EXCEPTION WHEN OTHERS THEN
                alfmen := 'R058GRP_EI: Erro ao inserir associação entre permissão e local físico. Permissão: '
                      || CONVERT(NUMBER_TO_CHAR, :NEW.CODPRM) || '. Versão: ' || CONVERT(NUMBER_TO_CHAR, l_recgrr.VERPLF)
                      || '. Cód. Local Físico: ' || CONVERT(NUMBER_TO_CHAR, l_recgrr.CODPLF);
                RAISERROR 103 alfmen;
            END;
        END IF;
    END LOOP;
END␀ª×␀␀		SENIOR;0
␀␀

TRIGGER R058GRP_ED AFTER DELETE ON R058GRP FOR EACH ROW
DECLARE
    l_codgrr NUMBER(3);
    l_temrlp NUMBER(1);
    l_temgrp NUMBER(1);
    alfmen   VARCHAR2(255);

    CURSOR C_RECGRR IS
      SELECT PLF.VERPLF, PLF.CODPLF 
        FROM R058GRL GRL, R058DSP DSP, R058PLF PLF, R151PLF PLL, R151LEG LEG
       WHERE GRL.CODGRR = l_codgrr AND GRL.CODDSP = DSP.CODDSP AND DSP.VERPLF = PLF.VERPLF AND DSP.CODPLF = PLF.CODPLF AND PLF.CATPLF = 9
         AND PLL.VERPLF = PLF.VERPLF AND PLL.CODPLF = PLF.CODPLF AND LEG.CODLEG = PLL.CODLEG AND LEG.TIPLEG = 3;

    TYPE T_RECGRR IS RECORD (
      VERPLF   R058PLF.VERPLF%TYPE,
      CODPLF   R058PLF.CODPLF%TYPE);

    l_recgrr T_RECGRR;

BEGIN
    l_codgrr := :OLD.CODGRR;

    /* Ao remover um grupo de dispositivos em uma permissão:
        - Verifico os recintos alfandegados do grupo de dispositivos;
        - Para cada recinto:
          - Verifico se existem outros dispositivos ou grupos de dispositivos nessa permissão que dão acesso a este recinto alfandegado;
          - Se não existe, excluo o recinto alfandegado da associação permissão x recinto alfandegado. */
    FOREACH C_RECGRR INTO l_recgrr.VERPLF,
                          l_recgrr.CODPLF
    LOOP
        BEGIN
           SELECT 1 INTO l_temrlp FROM R058RLP RLP, R058DSP DSP
            WHERE RLP.CODDSP = DSP.CODDSP
              AND RLP.CODPRM = :OLD.CODPRM AND DSP.VERPLF = l_recgrr.VERPLF AND DSP.CODPLF = l_recgrr.CODPLF;
        EXCEPTION
            WHEN OTHERS THEN l_temrlp := 0;
        END;

        BEGIN
           SELECT 1 INTO l_temgrp FROM R058GRP GRP, R058GRL GRL, R058DSP DSP
            WHERE GRP.CODGRR = GRL.CODGRR AND GRL.CODDSP = DSP.CODDSP
              AND GRP.CODPRM = :OLD.CODPRM AND DSP.VERPLF = l_recgrr.VERPLF AND DSP.CODPLF = l_recgrr.CODPLF;
        EXCEPTION
            WHEN OTHERS THEN l_temgrp := 0;
        END;

        IF (l_temrlp = 0 AND l_temgrp = 0) THEN
            BEGIN
                DELETE FROM R058PRR WHERE CODPRM = :OLD.CODPRM AND VERPLF = l_recgrr.VERPLF AND CODPLF = l_recgrr.CODPLF;
            EXCEPTION WHEN OTHERS THEN
                alfmen := 'R058GRP_ED: Erro ao excluir associação entre permissão e local físico. Permissão: '
                      || CONVERT(NUMBER_TO_CHAR, :OLD.CODPRM) || '. Versão: ' || CONVERT(NUMBER_TO_CHAR, l_recgrr.VERPLF)
                      || '. Cód. Local Físico: ' || CONVERT(NUMBER_TO_CHAR, l_recgrr.CODPLF);
                RAISERROR 103 alfmen;
            END;
        END IF;
    END LOOP;
END␀␀␀u␀␀␀¬×␀␀¯,±␀	”ÿ1␀␀␀␀␀‚@Çtn;q␀Æÿ␀␀­×␀␀␀¢T(”ÿ1␀␀␀␀␀ğX°V°V1␀␀ÿ␀␀ÿ␀(§␀␀
