PROCEDURE SP_PESFROMIDTPES(P_IDTPES VARCHAR2(23),P_TIPPES OUT NUMBER(2),P_NUMEMP OUT NUMBER(4),P_TIPCOL OUT NUMBER(1),P_NUMCAD OUT NUMBER(9),P_TIPDOC OUT NUMBER(1),P_NUMDOC OUT VARCHAR2(20),P_NUMMAT OUT VARCHAR2(15),P_PROPAC OUT VARCHAR2(20))
