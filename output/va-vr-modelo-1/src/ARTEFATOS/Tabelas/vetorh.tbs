 'EFETIVO POR LOCAL' DESOPE,
  R080EFD.CMPQUA,
  NIVLOC.NOMNV1,
  NIVLOC.NOMNV2,
  NIVLOC.NOMNV3,
  NIVLOC.NOMNV4,
  NIVLOC.NOMNV5,
  NIVLOC.NOMNV6,
  NIVLOC.NOMNV7,
  NIVLOC.NOMNV8,
  NIVLOC.NOMNV9,
  NIVLOC.NOMNVA,
  NIVLOC.NOMNVB,
  NIVLOC.NOMNVC,
  NIVLOC.NOMNVD,
  NIVLOC.NOMNVE,
  NIVLOC.NOMNVF,
  NIVLOC.NOMNVG,
  NIVLOC.NOMNVH,
  NIVLOC.NOMNVI,
  NIVLOC.NOMNVJ,
  NIVLOC.NOMNVK,
  NIVLOC.NOMNVL,
  NIVLOC.NOMNVM,
  NIVLOC.NOMNVN,
  NIVLOC.NOMNVO,
  R024CAR.TITRED,
  R030EMP.NUMEMP,
  R030EMP.APEEMP,
  0 CODFIL,
  ' ' NOMFIL,
  R022VAG.DESTIP,
  0 QTDVAG,
  0 QTDEFE,
  0 QTDNEG,
  R080EFD.VAGGER,
  R080EFD.VAGTU1,
  R080EFD.VAGTU2,
  R080EFD.VAGTU3,
  R080EFD.VAGTU4,
  R080EFD.VAGMIS,
  R080EFD.VAGGEA,
  R080EFD.VAGT1A,
  R080EFD.VAGT2A,
  R080EFD.VAGT3A,
  R080EFD.VAGT4A,
  R080EFD.VAGMIA,
  0 VAGGET,
  0 VAGT1T,
  0 VAGT2T,
  0 VAGT3T,
  0 VAGT4T,
  0 VAGMIT 
FROM R080EFD,R022VAG,R030EMP,R024CAR,VBI_LOCTODNVL NIVLOC 
WHERE R080EFD.TIPVAG = R022VAG.TIPVAG 
  AND R030EMP.NUMEMP = R080EFD.NUMEMP 
  AND R080EFD.ESTCAR = R024CAR.ESTCAR 
  AND R080EFD.CODCAR = R024CAR.CODCAR 
  AND NIVLOC.TABORG  = R080EFD.TABORG 
  AND NIVLOC.NUMLOC  = R080EFD.NUMLOC 
UNION 

SELECT 
  'LOTAÇÃO POR LOCAL' DESOPE,
  R080QUD.CMPQUA,
  NIVLOC.NOMNV1,
  NIVLOC.NOMNV2,
  NIVLOC.NOMNV3,
  NIVLOC.NOMNV4,
  NIVLOC.NOMNV5,
  NIVLOC.NOMNV6,
  NIVLOC.NOMNV7,
  NIVLOC.NOMNV8,
  NIVLOC.NOMNV9,
  NIVLOC.NOMNVA,
  NIVLOC.NOMNVB,
  NIVLOC.NOMNVC,
  NIVLOC.NOMNVD,
  NIVLOC.NOMNVE,
  NIVLOC.NOMNVF,
  NIVLOC.NOMNVG,
  NIVLOC.NOMNVH,
  NIVLOC.NOMNVI,
  NIVLOC.NOMNVJ,
  NIVLOC.NOMNVK,
  NIVLOC.NOMNVL,
  NIVLOC.NOMNVM,
  NIVLOC.NOMNVN,
  NIVLOC.NOMNVO,
  R024CAR.TITCAR,
  R030EMP.NUMEMP,
  R030EMP.APEEMP,
  0 CODFIL,
  ' ' NOMFIL,
  R022VAG.DESTIP,
  0 QTDVAG,
  0 QTDEFE,
  0 QTDNEG,
  R080QUD.VAGGER,
  R080QUD.VAGTU1,
  R080QUD.VAGTU2,
  R080QUD.VAGTU3,
  R080QUD.VAGTU4,
  R080QUD.VAGMIS,
  0 VAGGEA,
  0 VAGT1A,
  0 VAGT2A,
  0 VAGT3A,
  0 VAGT4A,
  0 VAGMIA,
  R080QUD.VAGGET,
  R080QUD.VAGT1T,
  R080QUD.VAGT2T,
  R080QUD.VAGT3T,
  R080QUD.VAGT4T,
  R080QUD.VAGMIT 
FROM R080QUD,R022VAG,R030EMP,R024CAR,VBI_LOCTODNVL NIVLOC 
WHERE R080QUD.TIPVAG = R022VAG.TIPVAG 
  AND R030EMP.NUMEMP = R080QUD.NUMEMP 
  AND R080QUD.ESTCAR = R024CAR.ESTCAR 
  AND R080QUD.CODCAR = R024CAR.CODCAR 
  AND NIVLOC.TABORG  = R080QUD.TABORG 
  AND NIVLOC.NUMLOC  = R080QUD.NUMLOC 

UNION 

SELECT 
  'REQUISIÇÕES' DESOPE,
  R126RQU.DATRQU,
  NIVLOC.NOMNV1,
  NIVLOC.NOMNV2,
  NIVLOC.NOMNV3,
  NIVLOC.NOMNV4,
  NIVLOC.NOMNV5,
  NIVLOC.NOMNV6,
  NIVLOC.NOMNV7,
  NIVLOC.NOMNV8,
  NIVLOC.NOMNV9,
  NIVLOC.NOMNVA,
  NIVLOC.NOMNVB,
  NIVLOC.NOMNVC,
  NIVLOC.NOMNVD,
  NIVLOC.NOMNVE,
  NIVLOC.NOMNVF,
  NIVLOC.NOMNVG,
  NIVLOC.NOMNVH,
  NIVLOC.NOMNVI,
  NIVLOC.NOMNVJ,
  NIVLOC.NOMNVK,
  NIVLOC.NOMNVL,
  NIVLOC.NOMNVM,
  NIVLOC.NOMNVN,
  NIVLOC.NOMNVO,
  R024CAR.TITCAR,
  R030EMP.NUMEMP,
  R030EMP.APEEMP,
  R030FIL.CODFIL,
  R030FIL.NOMFIL,
  R022VAG.DESTIP,
  R126RQU.QTDRQU,
  TABEFE.QTDEFE - TABNEG.QTDNEG QTDEFE,
  TABNEG.QTDNEG,
  0 VAGGER,
  0 VAGTU1,
  0 VAGTU2,
  0 VAGTU3,
  0 VAGTU4,
  0 VAGMIS,
  0 VAGGEA,
  0 VAGT1A,
  0 VAGT2A,
  0 VAGT3A,
  0 VAGT4A,
  0 VAGMIA,
  0 VAGGET,
  0 VAGT1T,
  0 VAGT2T,
  0 VAGT3T,
  0 VAGT4T,
  0 VAGMIT 
FROM R126RQU,R024CAR,R030EMP,R030FIL,R022VAG,VBI_LOCTODNVL NIVLOC,VBI_QTDNEG TABNEG,VBI_QTDEFE TABEFE 

WHERE 
  R126RQU.ESTCAR = R024CAR.ESTCAR 
  AND R126RQU.CODCAR = R024CAR.CODCAR 
