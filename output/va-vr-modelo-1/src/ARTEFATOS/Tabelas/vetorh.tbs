		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;

		SP_VALUPDATE_DES(:OLD.DetJud, :NEW.DetJud, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;

		SP_VALUPDATE_NUM(:OLD.PenMor, :NEW.PenMor, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;

		SP_VALUPDATE_NUM(:OLD.CpfIns, :NEW.CpfIns, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;

		SP_VALUPDATE_DAT(:OLD.DatIns, :NEW.DatIns, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;

		SP_VALUPDATE_NUM(:OLD.CNPJAn, :NEW.CNPJAn, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;

		SP_VALUPDATE_DES(:OLD.BenAnt, :NEW.BenAnt, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;

		SP_VALUPDATE_DAT(:OLD.DatSuc, :NEW.DatSuc, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;

		SP_VALUPDATE_DES(:OLD.DscSuc, :NEW.DscSuc, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;

		SP_VALUPDATE_DAT(:OLD.DatTer, :NEW.DatTer, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;

		SP_VALUPDATE_NUM(:OLD.MtvTer, :NEW.MtvTer, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;
		
		SP_VALUPDATE_NUM(:OLD.NumEmp, :NEW.NumEmp, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_AlterouChave := TRUE;
		END IF;
		
		SP_VALUPDATE_NUM(:OLD.TipCol, :NEW.TipCol, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_AlterouChave := TRUE;
		END IF;
		
		SP_VALUPDATE_NUM(:OLD.NumCad, :NEW.NumCad, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_AlterouChave := TRUE;
		END IF;
		
		SP_VALUPDATE_NUM(:OLD.SitHom, :NEW.SitHom, l_Valido OUT);
        IF (l_Valido = TRUE) THEN
        	l_Alterou := TRUE;
        END IF; 
            
		SP_VALUPDATE_DAT(:OLD.DatHom, :NEW.DatHom, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;          
            
        SP_VALUPDATE_NUM(:OLD.TipDep, :NEW.TipDep, l_Valido OUT);
        IF (l_Valido = TRUE) THEN
        	l_Alterou := TRUE;
        END IF; 
            
        SP_VALUPDATE_DES(:OLD.DesDep, :NEW.DesDep, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
		END IF;  
		
		IF (l_Alterou = TRUE) OR (l_AlterouChave = TRUE) THEN
			SP_CONCATENAR_DES('NROBEN', :NEW.NroBen, l_Valor OUT);
			SP_CONCATENAR_NUM('SEQBEN', :NEW.SeqBei, l_Valor OUT);
