TRIGGER R346IRT_EU BEFORE UPDATE ON R346IRT FOR EACH ROW
DECLARE
	l_Valor VARCHAR2(2000);
	l_Alterou BOOLEAN;
	l_Valido BOOLEAN;
	l_JsonCamposAlterados VARCHAR2(2000);
	l_VersaoESocial NUMBER;
	l_isGerarPendencia BOOLEAN;
BEGIN
  l_Valor := '';
  l_VersaoESocial := 0;
  l_JsonCamposAlterados := ''; 

  SP_GERAR_PEN_S2501(:NEW.NUMEMP, :NEW.TIPCOL, :NEW.NUMCAD, :NEW.CODPRO, :NEW.CMPPAG, l_isGerarPendencia OUT);
  
  IF (l_isGerarPendencia = TRUE) THEN
	SP_ESOCIAL_S250X(:NEW.NUMEMP, :NEW.CMPPAG, l_VersaoESocial OUT);

	IF (l_VersaoESocial >= 6) THEN
		SP_VALUPDATE_NUM(:OLD.VLRRTR, :NEW.VLRRTR, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
			SP_CONCAT_FLO_JSON('VLRRTR', :NEW.VLRRTR, :OLD.VLRRTR, 2, l_JsonCamposAlterados OUT);
		END IF;

		SP_VALUPDATE_NUM(:OLD.VLRR13, :NEW.VLRR13, l_Valido OUT);
		IF (l_Valido = TRUE) THEN
			l_Alterou := TRUE;
