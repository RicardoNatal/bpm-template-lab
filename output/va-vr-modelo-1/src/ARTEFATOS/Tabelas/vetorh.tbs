  l_DataZero   DATE;
  l_data_fim   DATE;
  l_idtpes     CHAR(23);
  
  /* Tabela temporária */
  CREATE_TEMP_TABLE R064TES_AUX;
  
BEGIN
  BEGIN
    INSERT INTO R064TES_AUX (TIPCOL,NUMEMP,NUMCAD,DATINI,DATFIM,STAACC,CODESC)
           VALUES (:OLD.TIPCOL,:OLD.NUMEMP,:OLD.NUMCAD,:OLD.DATINI,:OLD.DATFIM,:OLD.STAACC,:OLD.CODESC);
