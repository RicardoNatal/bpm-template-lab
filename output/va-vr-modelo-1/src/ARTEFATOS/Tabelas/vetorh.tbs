PROCEDURE SP_AUDGETUSU(PCODUSU OUT NUMBER(10),PTIPDOC OUT NUMBER(1),PNUMDOC OUT VARCHAR2(20),PNOMUSU OUT VARCHAR2(40))
 IS

l_numsec    NUMBER(14);
l_achouUsu  BOOLEAN;
l_machine VARCHAR(20);
l_program VARCHAR(40);
BEGIN
  pCodUsu := 0;
  pTipDoc := 0;
  pNumDoc := '';
  pNomUsu := '';
  l_achouUsu := TRUE;
  SP_GETSESSIONID(l_numsec OUT, l_program OUT, l_machine OUT);
  BEGIN
      SELECT USUARIO.CODUSU, USUARIO.NOMUSU, USU.TIPDOC, USU.NUMDOC
        INTO pCodUsu, pNomUsu, pTipDoc, pNumDoc
        FROM R034USU USU,R999USU USUARIO,R911SEC SEC
       WHERE USU.CODUSU = USUARIO.CODUSU AND
             USUARIO.NOMUSU = SEC.APPUSR AND
             SEC.NUMSEC = l_numsec;
   EXCEPTION
     WHEN NO_DATA_FOUND THEN
         l_achouUsu := FALSE;
     WHEN OTHERS THEN
         RAISERROR 103 'Erro ao obter os dados do usuário conectado.';
  END;

  IF (l_achouUsu = TRUE) THEN
      IF (pNomUsu IS NULL) THEN
          RAISERROR 103 'Nome do usuário associado não pode ser nulo.';
      END IF;

      IF ((pNumDoc IS NULL) OR NOT (pTipDoc IN (1,2,6))) THEN
          RAISERROR 103 'Usuário não possui um documento válido.';
      END IF;
  ELSE
      l_achouUsu := TRUE;
      BEGIN
          SELECT APPNAM, APPUSR
            INTO pNumDoc, pNomUsu
            FROM R911SEC
           WHERE (APPNAM = 'SSERVER' OR APPNAM = 'VETORHSERVER') AND
                 NUMSEC = l_numsec;
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
           l_achouUsu := FALSE;
        WHEN OTHERS THEN
           RAISERROR 103 'Erro ao obter aplicativo de processo automático conectado. ';
      END;

      IF (pNumDoc = 'SSERVER') THEN
         BEGIN
            SELECT USUARIO.CODUSU, USUARIO.NOMUSU, USU.TIPDOC, USU.NUMDOC
            INTO pCodUsu, pNomUsu, pTipDoc, pNumDoc
            FROM R034USU USU,R999USU USUARIO,R300PRO SEC
           WHERE USU.CODUSU = USUARIO.CODUSU AND
                 USUARIO.CODUSU = SEC.CODUSU AND
                 SEC.STAPRO = 1 AND
                 SEC.NUMSEC = l_numsec;
         EXCEPTION
           WHEN OTHERS THEN
             l_achouUsu := FALSE;
         END;
      END IF;

  END IF;
  IF (l_achouUsu = FALSE) THEN
    pNumDoc:= l_machine;
    pNomUsu:= l_program;
  END IF;
END		SENIOR;21SP_GETSESSIONID
ë␀␀

