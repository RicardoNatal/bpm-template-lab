DECLARE
l_log VARCHAR(200);
  l_seqreg NUMBER(15);
  l_verseq NUMBER(10);
  l_auditoria CHAR(1);
BEGIN
  IF (:NEW.MARCAR = 'S') THEN
      l_log := 'ALTERAÇÃO NO CADASTRO DE TABELAS AUDITADAS - AUDITORIA ATIVADA';
  ELSE
      l_log := 'ALTERAÇÃO NO CADASTRO DE TABELAS AUDITADAS - AUDITORIA DESATIVADA';
  END IF;
  SP_AUDGETVERSEQ (0,l_seqreg OUT, l_verseq OUT);
