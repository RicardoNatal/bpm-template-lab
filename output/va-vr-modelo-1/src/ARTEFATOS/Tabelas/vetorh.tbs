BEGIN
  NULL;
END	ORACLE;0
␀␀CREATE OR REPLACE PROCEDURE sp_concat_des_json(P_CAMPO IN VARCHAR2, P_VALOR_NEW IN VARCHAR2, P_VALOR_OLD IN VARCHAR2, P_RETORNO IN OUT VARCHAR2) IS
  l_valor_new VARCHAR2(2500);
  l_valor_old VARCHAR2(2500);
BEGIN
  l_Valor_New := REPLACE (P_VALOR_NEW, '\', '\\');
  l_Valor_Old := REPLACE (P_VALOR_OLD, '\', '\\');
  l_Valor_New := REPLACE (l_Valor_New, '"', '\"');
  l_Valor_Old := REPLACE (l_Valor_Old, '"', '\"');
  IF ((p_Retorno IS NULL) OR (p_Retorno='')) THEN
    p_Retorno := '{"' || p_Campo || '":{"NEW":"' || l_Valor_New || '","OLD":"' || l_Valor_Old || '"}}';
  ELSE
    p_Retorno := SUBSTR(p_Retorno,1,(LENGTH(p_Retorno)-1));
    p_Retorno := p_Retorno || ',"' || p_Campo || '":{"NEW":"' || l_Valor_New || '","OLD":"' || l_Valor_Old || '"}}';
  END IF;
END;	MSSQL;0
¾␀␀CREATE PROCEDURE sp_concat_des_json(@P_CAMPO VARCHAR(6), @P_VALOR_NEW VARCHAR(2000), @P_VALOR_OLD VARCHAR(2000), @P_RETORNO VARCHAR(5000) OUTPUT) AS
BEGIN
DECLARE @l_valor_new VARCHAR(2500)
DECLARE @l_valor_old VARCHAR(2500)
  DECLARE @ChkError INTEGER
  SELECT @ChkError = 0
  SELECT @l_Valor_New = REPLACE (@P_VALOR_NEW, '\', '\\')
  SELECT @l_Valor_Old = REPLACE (@P_VALOR_OLD, '\', '\\')
  SELECT @l_Valor_New = REPLACE (@l_Valor_New, '"', '\"')
  SELECT @l_Valor_Old = REPLACE (@l_Valor_Old, '"', '\"')
  IF (@p_Retorno IS NULL) 
      OR (@p_Retorno='')
  BEGIN
    SELECT @p_Retorno = '{"'+@p_Campo+'":{"NEW":"'+@l_Valor_New+'","OLD":"'+@l_Valor_Old+'"}}'
  END
  ELSE
  BEGIN
    SELECT @p_Retorno = SUBSTRING(@p_Retorno,1,(DATALENGTH(@p_Retorno)-1))
    SELECT @p_Retorno = @p_Retorno+',"'+@p_Campo+'":{"NEW":"'+@l_Valor_New+'","OLD":"'+@l_Valor_Old+'"}}'
  END
  BEGIN
    RETURN @ChkError
  END
FIM:
  RETURN @ChkError
END	POSTGRESQL;0
␀␀CREATE OR REPLACE PROCEDURE sp_concat_des_json(p_campo varchar, p_valor_new varchar, p_valor_old varchar, p_retorno IN OUT varchar) 
LANGUAGE 'plpgsql'
AS $BODY$
declare
l_valor_new VARCHAR(2500);
l_valor_old VARCHAR(2500);
BEGIN
	l_valor_new := REPLACE(p_valor_new, '\', '\\');
	l_valor_old := REPLACE(p_valor_old, '\', '\\');
	l_valor_new := REPLACE(l_valor_new, '"', '\"');
	l_valor_old := REPLACE (l_valor_old, '"', '\"');
	IF ((p_retorno is null) OR (p_retorno = '')) THEN
		p_retorno := '{"' || p_Campo || '":{"NEW":"' || l_Valor_New || '","OLD":"' || l_Valor_Old || '"}}';
	ELSE
		p_retorno := SUBSTR(p_Retorno,1,(LENGTH(p_Retorno)-1));
	 	p_Retorno := p_Retorno || ',"' || p_Campo || '":{"NEW":"' || l_Valor_New || '","OLD":"' || l_Valor_Old || '"}}';
	END IF;
END
$BODY$;␀ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0SP_CONCAT_NUM_JSON
