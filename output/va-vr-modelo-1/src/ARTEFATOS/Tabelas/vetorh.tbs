£␀␀PROCEDURE R073RES_ATUCON(P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(10),P_CODPRM NUMBER,P_PRMSAB NUMBER,P_PRMDOM NUMBER,P_PRMFER NUMBER,P_CONTPM CHAR,P_USABIO NUMBER,P_GRACON NUMBER,P_CONADP CHAR,P_CONREE CHAR,P_USARFA CHAR)
 IS

