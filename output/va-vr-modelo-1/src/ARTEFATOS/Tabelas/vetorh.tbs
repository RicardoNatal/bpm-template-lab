TRIGGER R090MVI_ED AFTER DELETE ON R090MVI FOR EACH ROW
DECLARE
l_data_zero    DATE;
  l_online       BOOLEAN;
  l_crafis       NUMBER(12);
  l_idtpes       VARCHAR2(23);
  l_verseq       NUMBER(10);
  l_seqreg       NUMBER(15);
  l_auditoria    CHAR(1);
  l_verdoc       NUMBER(1);
  l_mblvis       NUMBER(3);

BEGIN
/*------------- Trata Visitante ------------*/
  SP_VerOnLine(l_online OUT);
  IF   (l_online = TRUE)
  AND  (:OLD.NUMCRA <> 0) THEN

      /* Procedure que atualiza os creditos de acesso.*/
       R090MVI_ATUCRV('D',:OLD.NUMEMP,:OLD.TIPCOL,:OLD.NUMCAD,:OLD.TIPDOC,:OLD.NUMDOC,:OLD.DATENT,:OLD.DATVAL,:OLD.TIPVIS);

       l_idtpes := ' ';
       /*Monta o Identificador da Pessoa*/
       l_idtpes := '04'||CONVERT(NUMBER_TO_CHAR,:OLD.TIPDOC)||:OLD.NUMDOC;
       /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
       l_idtpes := lTrim(l_idtpes);
       l_idtpes := rTrim(l_idtpes);
       LOOP
           /*Controle do Loop.*/
           IF (Length(l_idtpes) > 22) THEN
               EXIT;
           END IF;
           l_idtpes := ' '||l_idtpes;
       END LOOP;

       /*Faz update no valaut para gerar updateAutorization excluindo o visitante dos autorizadores*/
       BEGIN
           UPDATE R070CON SET VALAUT = 0
            WHERE IDTPES = l_idtpes;
       EXCEPTION
         WHEN OTHERS THEN
            RAISERROR 103 'TR090MVI: Não conseguiu gerar a exclusão de autorizadores.';
       END;

       /*------------- Trata Visitante ------------*/
       l_data_zero := '31/12/1900,00:00:00';
       /* Apaga Cracha do CONTROLE */
       IF (:OLD.DATSAI = l_data_zero) THEN
           /* busca número de crachá fisico caso exista. */
           SP_RETFIS(:OLD.NUMCRA, 0,l_crafis OUT);
           AtuSitCra('1',l_crafis);
       END IF;
  END IF;

  /* Verifica definições de acesso */
  l_verdoc := 0;
  l_mblvis := 0;
  BEGIN
	  SELECT VERDOC, MBLVIS INTO l_verdoc, l_mblvis FROM R070DAC;
  EXCEPTION
	  WHEN OTHERS THEN l_verdoc := 0;
  END;

  /* Bloqueia se houver colaborador associado */
  IF (l_verdoc > 2) AND                            /* se bloqueia colaborador */
	 (l_mblvis > 0) AND                            /* se tem motivo para bloqueio cadastrado*/
	 ((:OLD.TIPDOC = 2) OR (:OLD.TIPDOC = 4)) THEN /* só considera CPF ou passaporte */
	 SP_BloColVIS(:OLD.TIPDOC, :OLD.NUMDOC, :OLD.DATENT, :OLD.HORENT, :OLD.DATVAl, :OLD.HORVAL, :OLD.CODUSU, 0); /* Motivo = 0 é para excluir*/
  END IF;

  /* INICIO CONTROLE DE AUDITORIA DE REGISTROS*/
  l_auditoria := 'N';
  SP_AUDVER(l_auditoria OUT, 'R090MVI');

  IF (l_auditoria = 'S') THEN
      l_seqreg := :OLD.SEQREG;

      IF ((:OLD.SEQREG IS NULL) OR (:OLD.SEQREG < 1)) THEN

          BEGIN
              SELECT MAX(SEQREG) INTO l_seqreg
                FROM R090MVI_AUD
               WHERE DATENT = :OLD.DATENT AND
                     HORENT = :OLD.HORENT AND
                     SEQENT = :OLD.SEQENT;
           EXCEPTION
            WHEN OTHERS THEN
              RAISERROR 103 'Erro ao selecionar a sequência do registro. ';
          END;
      END IF;
      SP_AUDGETVERSEQ (l_seqreg,l_seqreg OUT, l_verseq OUT);

      BEGIN
           INSERT INTO R090MVI_AUD (SEQREG,VERSEQ,DATENT,HORENT,SEQENT,NUMCRA,NUMEMP,TIPCOL,NUMCAD,TABORG,
                                    NUMLOC,CODPOR,TIPDOC,NUMDOC,SEGTDO,SEGDOC,PLAVEE,CODPRM,DDITEL,DDDTEL,
                                    DATVAL,HORVAL,TIPVIS,OBSVIS,CODUSU,DATSAI,HORSAI,DATSLO,HORSLO,PLAVES,
                                    TELCON,PLACAE,PLACAS,ASSVID,CODOEM,NUMCON,EMPCCU,CODCCU,NOMOEM,CODLIB,
                                    CODNAC,CODMOT,CRAVEI,PLACE2, PLACE3, PLACS2, PLACS3)
                            VALUES (l_seqreg,l_verseq,:OLD.DATENT,:OLD.HORENT,:OLD.SEQENT,:OLD.NUMCRA,:OLD.NUMEMP,
                                   :OLD.TIPCOL,:OLD.NUMCAD,:OLD.TABORG,:OLD.NUMLOC,:OLD.CODPOR,:OLD.TIPDOC,
                                   :OLD.NUMDOC,:OLD.SEGTDO,:OLD.SEGDOC,:OLD.PLAVEE,:OLD.CODPRM,:OLD.DDITEL,
                                   :OLD.DDDTEL,:OLD.DATVAL,:OLD.HORVAL,:OLD.TIPVIS,:OLD.OBSVIS,:OLD.CODUSU,
                                   :OLD.DATSAI,:OLD.HORSAI,:OLD.DATSLO,:OLD.HORSLO,:OLD.PLAVES,:OLD.TELCON,
                                   :OLD.PLACAE,:OLD.PLACAS,:OLD.ASSVID,:OLD.CODOEM,:OLD.NUMCON,:OLD.EMPCCU,
                                   :OLD.CODCCU,:OLD.NOMOEM,:OLD.CODLIB,:OLD.CODNAC,:OLD.CODMOT,:OLD.CRAVEI,
                                   :OLD.PLACE2, :OLD.PLACE3, :OLD.PLACS2, :OLD.PLACS3);

          SP_AUDGENREG(l_seqreg,l_verseq,'R090MVI','DELETE');
      EXCEPTION
        WHEN OTHERS THEN
            RAISERROR 103 'Erro gerar registro para auditoria. ';
      END;
  END IF;/*FIM DO CONTROLE DE AUDITORIA DE REGISTRO*/


  /* excluir notificação do tipo 3 e 4 (notificação de chegada do visitante, ao visitado), se tiver*/
  BEGIN
	DELETE FROM R115CNO WHERE CODNOT IN (SELECT CODNOT FROM R115NOT WHERE CODORI = :OLD.LOCAGV AND STANOT = 0);
    DELETE FROM R115NOT WHERE CODORI = :OLD.LOCAGV AND STANOT = 0;
  EXCEPTION
	WHEN OTHERS THEN NULL;
  END;
END		SENIOR;21s␀␀

