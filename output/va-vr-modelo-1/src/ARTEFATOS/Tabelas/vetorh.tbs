		/* Verifica se já tem histórico de estabilidade iniciando na data de inscrição informada */
		BEGIN
			SELECT COUNT(1) INTO l_QtdEst FROM R038HEB 
			 WHERE NumEmp = :NEW.NumEmp AND TipCol = :NEW.TipCol AND NumCad = :NEW.NumCad
			   AND IniEtb = :NEW.DatIns;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao verificar se já tem histórico de estabilidade cadastrado.';		
		END;
		
		/* Cria histórico de estabilidade na nova data de inscrição, caso ainda não exista um histórico na data */
		IF (l_QtdEst = 0) THEN
			BEGIN
				SELECT DatTer INTO l_DatTerMan FROM R030MAN
			 	 WHERE NUMEMP = :NEW.NumEmp AND CODMAN = :NEW.CodMan;
			EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'Não foi encontrado informações do mandato.';
			END;
		
			l_DatFimEtb := DATETIMEADD(YY, 1, l_DatTerMan);
			
			BEGIN
				INSERT INTO R038HEB (NUMEMP, TIPCOL, NUMCAD, INIETB, FIMETB, CODETB, STAATU, ORIEST)
				VALUES (:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, :NEW.DatIns, l_DatFimEtb, 27, 0, 5);
			EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'Erro ao inserir histórico de estabilidade.';
			END;
		END IF;
	END IF;
END␀éÑ␀␀		SENIOR;0p␀␀

TRIGGER R030CAN_EU AFTER UPDATE ON R030CAN FOR EACH ROW
DECLARE
	l_IncluirEstabilidade BOOLEAN;
	l_ExcluirEstabilidade BOOLEAN;
	l_QtdEst INTEGER;
	l_DatTerMan   R030MAN.DatTer%TYPE;
	l_DatFimEtb   R038HEB.FimEtb%TYPE;
BEGIN
	l_ExcluirEstabilidade := FALSE;
	l_IncluirEstabilidade := FALSE;

	IF (:OLD.CanEle = 'S') AND (:NEW.CanEle = 'S') THEN
		IF (:OLD.DatIns <> :NEW.DatIns) THEN
			l_ExcluirEstabilidade := TRUE;
			l_IncluirEstabilidade := TRUE;
		END IF;
	ELSE
		IF (:OLD.CanEle <> 'S') AND (:NEW.CanEle = 'S') THEN
			l_IncluirEstabilidade := TRUE;
		ELSE
			IF (:OLD.CanEle = 'S') AND (:NEW.CanEle <> 'S') THEN
				l_ExcluirEstabilidade := TRUE;
			END IF;
		END IF;
	END IF;
	
	IF (l_ExcluirEstabilidade = TRUE) THEN
		BEGIN
			DELETE FROM R038HEB 
			 WHERE NumEmp = :OLD.NumEmp AND TipCol = :OLD.TipCol AND NumCad = :OLD.NumCad 
			   AND IniEtb = :OLD.DatIns AND OriEst = 5;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao excluir histórico de estabilidade.';
		END;
	END IF;
	
	IF (l_IncluirEstabilidade = TRUE) THEN	
		/* Verifica se já tem histórico de estabilidade iniciando na data de inscrição informada */
		BEGIN
			SELECT COUNT(1) INTO l_QtdEst FROM R038HEB
			 WHERE NumEmp = :NEW.NumEmp AND TipCol = :NEW.TipCol AND NumCad = :NEW.NumCad
			   AND IniEtb = :NEW.DatIns;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao verificar se já tem histórico de estabilidade cadastrado.';		
		END;
		
		/* Cria histórico de estabilidade na data de inscrição, caso ainda não exista um histórico na data */
		IF (l_QtdEst = 0) THEN
			BEGIN
				SELECT DatTer INTO l_DatTerMan FROM R030MAN
			 	 WHERE NUMEMP = :NEW.NumEmp AND CODMAN = :NEW.CodMan;
			EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'Erro ao buscar data de término do mandato.';
			END;
	
			l_DatFimEtb := DATETIMEADD(YY, 1, l_DatTerMan);
		
			BEGIN
				INSERT INTO R038HEB (NUMEMP, TIPCOL, NUMCAD, INIETB, FIMETB, CODETB, STAATU, ORIEST)
				VALUES (:NEW.NumEmp, :NEW.TipCol, :NEW.NumCad, :NEW.DatIns, l_DatFimEtb, 27, 0, 5);
			EXCEPTION
				WHEN OTHERS THEN
					RAISERROR 103 'Erro ao inserir histórico de estabilidade.';
			END;
		END IF;
	END IF;
END␀çÑ␀␀		SENIOR;0¨␀␀

TRIGGER R030CAN_ED AFTER DELETE ON R030CAN FOR EACH ROW
BEGIN
	IF (:OLD.CanEle = 'S') THEN
		/* Exclui histórico de estabilidade, caso exista */	
		BEGIN
			DELETE FROM R038HEB 
			 WHERE NumEmp = :OLD.NumEmp AND TipCol = :OLD.TipCol AND NumCad = :OLD.NumCad 
			   AND IniEtb = :OLD.DatIns AND OriEst = 5;
		EXCEPTION
			WHEN OTHERS THEN
				RAISERROR 103 'Erro ao excluir histórico de estabilidade.';
		END;
	END IF;
END␀␀␀†/␀␀␀␀␀␀␀␀êÑ␀␀…¬␀␀´␀	Ôï1␀␀␀␀␀‘<XbXbr‡␀Æÿ␀␀Ò␀␀␀mDÑ␀	Ôï1␀␀␀␀␀>IşEşEqC␀êÿ␀␀ÿ␀f´␀Ôï1␀␀␀␀␀÷<ïe»fr␀Æÿ␀␀)Ñ␀␀␀␀␀␀0;1␀␀cb␀␀␀ëÑ␀␀…¬␀␀´␀	Ôÿ?␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀—,¼␀	Ôÿ?␀␀␀␀␀=nnX)␀␀Æÿ␀␀!#␀mDÑ␀	Ôÿ?␀␀␀␀␀‡JşEşEqC␀êÿ␀␀ÿ␀Á␀Ôÿ?␀␀␀␀␀¤"¤"¤"y␀Æÿ␀␀ÿ␀+ÚÔÿ?␀␀␀␀␀¨"¨"¨"c␀␀␀ÿ␀␀ÿ␀Œ+Á␀Ôÿ?␀␀␀␀␀¦"¥"¦"y␀Æÿ␀␀ÿ0000000*␀áÔÿ?␀␀␀␀␀á␀R␀R␀n␀Æÿ␀␀ÿ␀␀␀␀0;1;2íÑ␀␀		SENIOR;0Õ␀␀TRIGGER R030CNA_EI BEFORE INSERT ON R030CNA FOR EACH ROW
DECLARE
	l_Valor VARCHAR2(2000);
	l_ProximaData DATE;
	l_Where VARCHAR(2000);
	l_EmpresaStr VARCHAR(11);
    l_FilialStr VARCHAR(11);
    l_datcna       DATE;
BEGIN
    l_Valor := '';
   
    SELECT R030FIL.DATCNA INTO l_datcna
	  FROM R030FIL
	 WHERE R030FIL.NUMEMP = :NEW.NUMEMP 
	   AND R030FIL.CODFIL = :NEW.CODFIL;
  		
	IF (:NEW.STAHIS = 1) AND ((:NEW.DATALT >= l_datcna) OR (l_datcna IS NULL)) THEN
		UPDATE R030FIL
           SET DATCNA = :NEW.DATALT,
               ATIIRF = :NEW.ATIIRF,
               CNAPRE = :NEW.CNAPRE,
               CNAFIS = :NEW.CNAFIS
         WHERE R030FIL.NUMEMP = :NEW.NUMEMP AND
			   R030FIL.CODFIL = :NEW.CODFIL;
	END IF;
     
    l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP);
    l_FilialStr := CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL);
    l_Where := 'NUMEMP = ' ||  l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr;
    SP_PROXIMOHIST('DATALT', 'R030CNA', l_Where, :NEW.DATALT, l_ProximaData OUT);
	SP_CONCATENAR_NUM('CODFIL', :NEW.CODFIL, l_Valor OUT);
    
	SP_E_SOCIAL('S-1005', 'R030CNA', 'T', 'I', :NEW.DATALT, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030CNA_EI');
END␀îÑ␀␀		SENIOR;0␀␀

TRIGGER R030CNA_EU BEFORE UPDATE ON R030CNA FOR EACH ROW 
DECLARE
	l_Valor VARCHAR2(2000);
	l_Valido BOOLEAN;
	l_AlterouRegistro_S1005 BOOLEAN;
	l_ProximaData DATE;
	l_Where VARCHAR(2000);
	l_EmpresaStr VARCHAR(11);
    l_FilialStr VARCHAR(11);
	l_datcna       DATE;
BEGIN
    l_Valor := '';

	SELECT R030FIL.DATCNA INTO l_datcna
	  FROM R030FIL
	 WHERE R030FIL.NUMEMP = :NEW.NUMEMP 
	   AND R030FIL.CODFIL = :NEW.CODFIL;
  		
	IF (:NEW.STAHIS = 1) AND ((:NEW.DATALT >= l_datcna) OR (l_datcna IS NULL)) THEN
		UPDATE R030FIL
           SET DATCNA = :NEW.DATALT,
               ATIIRF = :NEW.ATIIRF,
               CNAPRE = :NEW.CNAPRE,
               CNAFIS = :NEW.CNAFIS
         WHERE R030FIL.NUMEMP = :NEW.NUMEMP AND
			   R030FIL.CODFIL = :NEW.CODFIL;
	END IF;

	l_AlterouRegistro_S1005 := FALSE;
	
	SP_VALUPDATE_NUM(:NEW.CNAFIS, :OLD.CNAFIS, l_Valido OUT);
  	IF (l_Valido = TRUE) THEN
    	l_AlterouRegistro_S1005 := TRUE;  
  	END IF;

    IF (l_AlterouRegistro_S1005 = TRUE) THEN
	    l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP);
    	l_FilialStr := CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL);
    	l_Where := 'NUMEMP = ' ||  l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr;
    	SP_PROXIMOHIST('DATALT', 'R030CNA', l_Where, :NEW.DATALT, l_ProximaData OUT);
		SP_CONCATENAR_NUM('CODFIL', :NEW.CODFIL, l_Valor OUT);
		              
		SP_E_SOCIAL('S-1005', 'R030CNA', 'T', 'A', :NEW.DATALT, l_ProximaData, :NEW.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030CNA_EU');
	END IF;
END␀ìÑ␀␀		SENIOR;0Ô␀␀

TRIGGER R030CNA_ED BEFORE DELETE ON R030CNA FOR EACH ROW 
DECLARE
	l_Valor VARCHAR2(2000);
	l_ProximaData DATE;
	l_Where VARCHAR(2000);
	l_EmpresaStr VARCHAR(11);
    l_FilialStr VARCHAR(11);	
BEGIN
    l_Valor := '';

    l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP);
    l_FilialStr := CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL);
    l_Where := 'NUMEMP = ' ||  l_EmpresaStr || ' AND CODFIL = ' || l_FilialStr;
    SP_PROXIMOHIST('DATALT', 'R030CNA', l_Where, :OLD.DATALT, l_ProximaData OUT);
    SP_CONCATENAR_NUM('CODFIL', :OLD.CODFIL, l_Valor OUT);
    
    SP_E_SOCIAL('S-1005', 'R030CNA', 'T', 'E', :OLD.DATALT, l_ProximaData, :OLD.NUMEMP, 0, 0, l_Valor, '', 0, NULL, NULL, 0, 'R030CNA_ED');
END␀␀␀	n␀␀␀␀␀␀␀␀ïÑ␀␀…¬␀␀´␀	␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀$+Ñ␀	␀␀␀␀␀␀Ó/Ó/Ó/œ␀␀␀êÿ␀␀ÿ␀U(µ	␀␀␀␀␀␀e(e(e(<)␀␀Æÿ␀␀ÿ␀ErQ␀␀␀␀␀␀/␀␀sIsn␀Æÿ␀␀ÿ␀FrQ␀␀␀␀␀␀0␀␀ sJsn␀Æÿ␀␀ÿ␀HrQ␀␀␀␀␀␀2␀␀"s"sn␀Æÿ␀␀ÿ␀GrQ␀␀␀␀␀␀1␀␀!s!sn␀␀Æÿ␀␀ÿ␀␀␀␀0;1;2␀␀ˆ*␀␀␀␀␀␀␀␀␀ğÑ␀␀…¬␀␀´␀	 ␀␀␀␀␀␀‘<XbXbr␀Æÿ␀␀Ò␀␀␀D-Ì␀	 ␀␀␀␀␀␀ë±␀␀,­␀␀É¯␀␀k␀Æÿ␀␀†Ò␀␀␀k¶␀␀	 ␀␀␀␀␀␀H·␀␀‘¶␀␀Î¶␀␀n␀Æÿ␀␀ÿ␀¼³␀␀ˆ␀ ␀␀␀␀␀␀Ú´␀␀¯´␀␀¯´␀␀|␀␀␀ÿ␀␀ÿ␀¤EÑ␀ ␀␀␀␀␀␀DJ¯H°HqC␀␀êÿ␀␀ÿ␀y␀å ␀␀␀␀␀␀Ù␀É␀Ì␀h␀␀␀␀ÿ␀␀ÿ␀-Á␀ ␀␀␀␀␀␀LB¤␀␀¤␀␀y␀␀Æÿ␀␀ÿ␀î‰␀␀T ␀␀␀␀␀␀?0<z;]␀␀␀ÿ␀␀ÿ␀£DÑ␀ ␀␀␀␀␀␀JQFQFqC␀␀êÿ␀␀ÿ␀â(Â ␀␀␀␀␀␀J+␀ä(ä(n␀␀Æÿ␀␀ÿ␀¡+␀ ␀␀␀␀␀␀ï"Ó"Ó"h␀␀Æÿ␀␀ÿ␀ç) ␀␀␀␀␀␀ï"Ó"Ó"£␀␀␀ÿ␀␀O"␀␀␀␀0;1␀␀Ş*␀␀␀␀␀␀␀␀␀␀␀␀␀␀ñÑ␀␀…¬␀␀´␀	␀␀␀␀␀␀␀‘<XbXbr‡␀Æÿ␀␀Ò␀␀␀—,¼␀	␀␀␀␀␀␀␀=nnX)␀␀Æÿ␀␀!#␀®DÑ␀	␀␀␀␀␀␀␀É”␀␀Ç”␀␀Ç”␀␀œ␀␀␀êÿ␀␀ÿ␀Ïí␀␀¶␀␀␀␀␀␀␀•␀␀␀n␀Æÿ␀␀ÿ␀!mÑ␀␀␀␀␀␀␀␀S␀R␀R␀qC␀êÿ␀␀ÿ␀␀␀␀0;1;2óÑ␀␀		SENIOR;0]␀␀TRIGGER R030DAR_EI AFTER INSERT ON R030DAR FOR EACH ROW
DECLARE
	l_temAud       BOOLEAN;
	l_codRPA       NUMBER(15);
	l_codSistema   NUMBER(2);
	l_codcpa       NUMBER(4);
	l_codtpa       NUMBER(4);
	l_datTemp      VARCHAR(10);
BEGIN
  
  /* Geração de logs Filial - DARF*/
  l_codSistema := 1;  /* Código do sistema vetorh.*/
  l_codcpa := 31;     /* R030DAR - CADASTRO FILIAIS - DARF */
  l_codtpa := 172;    /* Incluir/Excluir   */
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);  
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R030DAR_EI', 'FR030FIL'); 
     
     /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
    BEGIN
	    INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :NEW.NUMEMP));
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :NEW.CODFIL));
        SP_DATSTR(:NEW.DATDAR, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATDAR', l_datTemp);  		
	EXCEPTION
	    WHEN OTHERS THEN RAISERROR 103 'R030DAR_EI: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	END;
	 
	BEGIN
	    INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RECDAR', CONVERT(NUMBER_TO_CHAR, :NEW.RECDAR));
        SP_DATSTR(:NEW.FCEDAR, 'DD/MM/YYYY', l_datTemp OUT);
        INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FCEDAR', l_datTemp);  
	END;	
  END IF;  
END␀ôÑ␀␀		SENIOR;0q␀␀


TRIGGER R030DAR_EU AFTER UPDATE ON R030DAR FOR EACH ROW
DECLARE
	l_temAud       BOOLEAN;
	l_codRPA       NUMBER(15);
	l_codSistema   NUMBER(2);
	l_codcpa       NUMBER(4);
	l_codtpa       NUMBER(4);
	l_datTemp      VARCHAR(10);
BEGIN
  
  /* Geração de logs Filial - Cadastro*/
  l_codSistema := 1;  /* Código do sistema vetorh.*/
  l_codcpa := 31;     /* R030DAR - CADASTRO FILIAIS - DARF */
  l_codtpa := 173;    /* Incluir/Excluir  */
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);  
  
  IF  ((:OLD.NumEmp <> :NEW.NumEmp)
    OR (:OLD.CodFil <> :NEW.CodFil)
    OR (:OLD.DatDar <> :NEW.DatDar)
    OR (:OLD.RecDar <> :NEW.RecDar)
    OR (:OLD.FceDar <> :NEW.FceDar)) THEN
	  
    IF (l_temAud = TRUE) THEN
      SP_RET_REG_AUD(l_codrpa OUT);
      SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R030FIL_EU', 'FR030FIL'); 
      /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
	    BEGIN
		 INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
         INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
         SP_DATSTR(:NEW.DATDAR, 'DD/MM/YYYY', l_datTemp OUT);
         INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATDAR', l_datTemp);
	    EXCEPTION
		    WHEN OTHERS THEN RAISERROR 103 'R030DAR_EU: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	    END; 
	  
	    BEGIN	  
  	     INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDRECDAR', CONVERT(NUMBER_TO_CHAR, :OLD.RECDAR));
         INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWRECDAR', CONVERT(NUMBER_TO_CHAR, :NEW.RECDAR));
         SP_DATSTR(:OLD.FCEDAR, 'DD/MM/YYYY', l_datTemp OUT);
         INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'OLDFCEDAR', l_datTemp);
         SP_DATSTR(:NEW.FCEDAR, 'DD/MM/YYYY', l_datTemp OUT);
         INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NEWFCEDAR', l_datTemp);
	    END;
    END IF;
  END IF;  
END␀òÑ␀␀		SENIOR;0W␀␀


TRIGGER R030DAR_ED AFTER DELETE ON R030DAR FOR EACH ROW
DECLARE
	l_temAud       BOOLEAN;
	l_codRPA       NUMBER(15);
	l_codSistema   NUMBER(2);
	l_codcpa       NUMBER(4);
	l_codtpa       NUMBER(4);
	l_datTemp      VARCHAR(10);
BEGIN
  
  /* Geração de logs Filial - Cadastro*/
  l_codSistema := 1;  /* Código do sistema vetorh.*/
  l_codcpa := 31;     /* R030DAR - CADASTRO FILIAIS - DARF */
  l_codtpa := 172;    /* Incluir/Excluir   */
  
  SP_EXISTE_LOG(l_codcpa, l_codtpa, l_codSistema, l_temAud OUT);  
  
  IF (l_temAud = TRUE) THEN
    SP_RET_REG_AUD(l_codrpa OUT);
    SP_INS_REG_AUD(l_codrpa, 1, l_codcpa, 1, l_codtpa, 1, 'R030DAR_ED', 'FR030FIL'); 
     
     /* insere os campos chave  - Tabela R995PRC (Parâmetros da categoria) */
    BEGIN
	  INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'NUMEMP', CONVERT(NUMBER_TO_CHAR, :OLD.NUMEMP));
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'CODFIL', CONVERT(NUMBER_TO_CHAR, :OLD.CODFIL));
      SP_DATSTR(:OLD.DATDAR, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRC (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'DATDAR', l_datTemp);  	
	EXCEPTION
	    WHEN OTHERS THEN RAISERROR 103 'R030DAR_ED: Erro ao inserir registros chave para a tabela de log de auditoria R995PRC.';
	END;
	 
	BEGIN	
	  INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'RECDAR', CONVERT(NUMBER_TO_CHAR, :OLD.RECDAR));
      SP_DATSTR(:OLD.FCEDAR, 'DD/MM/YYYY', l_datTemp OUT);
      INSERT INTO R995PRT (CODRPA, NAMPPA, CONPPA) VALUES (l_codrpa, 'FCEDAR', l_datTemp);		
	END;	
  END IF;
END␀␀␀n␀␀␀␀␀õÑ␀␀»ts	Ôÿ?␀␀␀␀␀ïtïtğtn␀Æÿ␀␀ÿ␀ÅEÑ␀Ôÿ?␀␀␀␀␀Ü”␀␀Ü”␀␀Ü”␀␀qC␀êÿ␀␀ÿ␀‘␀␀Ñ␀Ôÿ?␀␀␀␀␀LK±”␀␀MKqC␀êÿ␀␀ÿ
