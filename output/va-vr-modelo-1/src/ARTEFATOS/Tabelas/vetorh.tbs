PROCEDURE SP_FAIPRO(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56),P_DATINI OUT VARCHAR2(6),P_DATFIM OUT VARCHAR2(6),P_HORINI OUT VARCHAR2(4),P_HORFIM OUT VARCHAR2(4))
 IS

l_data          DATE;
  l_datini        DATE;
  l_data_limite   DATE;
  l_dia_anterior  DATE;
  l_dia_posterior DATE;
  l_dia_semana  NUMBER(1);
  l_codhor      NUMBER(4);
  l_horant      NUMBER(4);
  l_horref      NUMBER(5);
  l_faiace      VARCHAR2(255);
  l_faipto      VARCHAR2(255);
  l_strini      CHAR(4);
  l_strfim      CHAR(4);
  l_horbat      INTEGER;
  l_total1      NUMBER(5);
  l_iniace      NUMBER(5);
  l_inipto      NUMBER(5);
  l_fimace      NUMBER(5);
  l_fimpto      NUMBER(5);
  l_faidom_ace  VARCHAR(56);
  l_faiseg_ace  VARCHAR(56);
  l_faiter_ace  VARCHAR(56);
  l_faiqua_ace  VARCHAR(56);
  l_faiqui_ace  VARCHAR(56);
  l_faisex_ace  VARCHAR(56);
  l_faisab_ace  VARCHAR(56);
  l_faidom_pto  VARCHAR(56);
  l_faiseg_pto  VARCHAR(56);
  l_faiter_pto  VARCHAR(56);
  l_faiqua_pto  VARCHAR(56);
  l_faiqui_pto  VARCHAR(56);
  l_faisex_pto  VARCHAR(56);
  l_faisab_pto  VARCHAR(56);
  l_contfai     INTEGER;
  l_lengfai     INTEGER;
  l_maxseq      NUMBER(2);
  l_jorhor      CHAR;
  l_hora_atual  NUMBER(4);
  l_datafa      DATE;
  l_datter      DATE;
  l_iniafa      CHAR(6);
  l_fimafa      CHAR(6);
  l_horafa      NUMBER(4);
  l_horter      NUMBER(4);
  l_data_zero   DATE;
  l_datatu      DATE;
  l_datant      DATE;
  l_fimjor      NUMBER;
  l_TemAfa      BOOLEAN;
  l_jorace      NUMBER;
  l_prifxA      NUMBER;
  l_prifxP      NUMBER;
  l_codHorAtu   NUMBER;
  l_numcra      NUMBER(12);
  l_HorIni      NUMBER(4);
  l_HorFim      NUMBER(4);
  l_TipCra      NUMBER(1);
  l_codfil      NUMBER(6);

  /* OBTEM O HORÁRIO DAS ATIVIDADES E DISCIPLINAS DO PROFESSOR */
  CURSOR c_horariosPro IS
  SELECT HORSEG,HORTER,HORQUA,HORQUI,HORSEX,HORSAB,HORDOM
    FROM R171APF
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
      DATINI <= l_data AND ((DATFIM >= l_data) OR (DATFIM = l_data_zero)) UNION ALL
  (SELECT HORSEG,HORTER,HORQUA,HORQUI,HORSEX,HORSAB,HORDOM
    FROM R171DPF
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
      DATINI <= l_data AND ((DATFIM >= l_data) OR (DATFIM = l_data_zero)));
  TYPE t_horariosPro IS RECORD(
      HORSEG   R073ATA.HORSEG%TYPE,
      HORTER   R073ATA.HORTER%TYPE,
      HORQUA   R073ATA.HORQUA%TYPE,
      HORQUI   R073ATA.HORQUI%TYPE,
      HORSEX   R073ATA.HORSEX%TYPE,
      HORSAB   R073ATA.HORSAB%TYPE,
      HORDOM   R073ATA.HORDOM%TYPE);
  l_horariosPro t_horariosPro;


  /* PEGA AS FAIXAS HORARIAS DO HORARIO, AS PROGRAMAÇÕES DE HORAS EXTRAS */
  /* E OS AFASTAMENTOS CUJA ORIGEM FOR SAIDA AUTORIZADA */
  CURSOR c_r004fhr IS
    SELECT CODHOR, SEQFAI, INIACE, FIMACE, INIPTO, FIMPTO
    FROM R004FHR FHR WHERE NOT EXISTS (SELECT 1 FROM R004FHF WHERE R004FHF.CODHOR = FHR.CODHOR AND R004FHF.NUMEMP = p_numemp AND R004FHF.CODFIL = l_codfil) AND
             (FHR.CODHOR = l_codhor)
    UNION(
    SELECT CODHOR, SEQFAI, INIACE, FIMACE, INIPTO, FIMPTO
    FROM R004FHF FHF WHERE FHF.NUMEMP = p_numemp AND FHF.CODFIL = l_codfil AND
             (FHF.CODHOR = l_codhor))   
   ORDER BY 1,2,3,4;

  TYPE t_r004fhr IS RECORD(
    CODHOR   R004FHR.CODHOR%TYPE,
    SEQFAI   R004FHR.SEQFAI%TYPE,
    INIACE   R004FHR.INIACE%TYPE,
    FIMACE   R004FHR.FIMACE%TYPE,
    INIPTO   R004FHR.INIPTO%TYPE,
    FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;


  /* CURSOR DA TABELA TEMPORARIA.. */
  CURSOR c_r004TMP IS
  SELECT DATHOR,TIPFAI,FAIINI,FAIFIM,TURTRB FROM R004TMP WHERE DATHOR = l_data AND NUMEMP = p_numemp AND
         TIPCOL = p_tipcol AND NUMCAD = p_numcad ORDER BY 1,2,3;
  TYPE t_r004TMP IS RECORD(
    DATHOR   R004TMP.DATHOR%TYPE,
    TIPFAI   R004TMP.TIPFAI%TYPE,
    FAIINI   R004TMP.FAIINI%TYPE,
    FAIFIM   R004TMP.FAIFIM%TYPE,
    TURTRB   R004TMP.TURTRB%TYPE);
  l_r004TMP t_r004TMP;

  /*CURSOR para Verificar as Liberações de Faixas Horárias*/
  CURSOR c_r070lfh IS
  SELECT A.NUMCRA, A.DATLIB, A.HORINI, A.HORFIM FROM R070LFH A, R038HCH B
             WHERE
             B.TIPCRA = l_tipcra AND B.STAACC = 1 AND
             A.NUMCRA = B.NUMCRA AND B.NUMEMP = p_numemp AND B.TIPCOL = p_tipcol AND B.NUMCAD = p_numcad AND
             ((B.DATINI < l_datatu) OR (B.DATINI = l_datatu)) AND
             ((B.DATFIM > l_datatu) OR (B.DATFIM = l_datatu) OR B.DATFIM = L_DATA_ZERO) AND
             ((A.DATLIB = l_datatu) OR
              (A.DATLIB = l_datant AND (A.HORINI > A.HORFIM) AND (A.HORFIM > l_hora_atual))
             );
  TYPE t_r070lfh IS RECORD(
    NUMCRA   R070LFH.NUMCRA%TYPE,
    DATLIB   R070LFH.DATLIB%TYPE,
    HORINI   R070LFH.HORINI%TYPE,
    HORFIM   R070LFH.HORFIM%TYPE);
  l_r070lfh t_r070lfh;

  /*Verifica as autorizações de horas extras e saída*/
  CURSOR c_r064xxx IS
  SELECT 2 CODREG, HORINI INIACE,HORFIM FIMACE, HORINI INIPTO, HORFIM FIMPTO, TOLAEA,TOLASA,TOLAEP,TOLASP
  FROM R064EXT
   WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI <= l_data AND DATFIM >= l_data
   UNION
  (SELECT 3 CODREG, HORASA INIACE,HORTER FIMACE, HORASA INIPTO, HORTER FIMPTO, 0 TOLAEA,0 TOLASA,0 TOLAEP,0 TOLASP
    FROM R064ASA
   WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATASA = l_data)
   ORDER BY CODREG,INIACE,FIMACE,INIPTO;
   TYPE t_r064xxx IS RECORD(
    CODREG   R004FHR.CODHOR%TYPE,
    INIACE   R064EXT.HORINI%TYPE,
    FIMACE   R064EXT.HORFIM%TYPE,
    INIPTO   R064EXT.HORINI%TYPE,
    FIMPTO   R064EXT.HORFIM%TYPE,
    TOLAEA   R064EXT.TOLAEA%TYPE,
    TOLASA   R064EXT.TOLASA%TYPE,
    TOLAEP   R064EXT.TOLAEP%TYPE,
    TOLASP   R064EXT.TOLASP%TYPE);
  l_r064xxx t_r064xxx;
  
  /* Declaracao para criar tabela temporária */
  CREATE_TEMP_TABLE R004TMP;

BEGIN

  /* Limpa tabela temporaria R004TMP */
  DELETE FROM R004TMP WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;

  /* Inicializa */
  l_datini := CURDATE();
  /* começar um dia antes em caso de haver 3o. turno. */
  l_datini := DATETIMEADD(DD,-1,l_datini);
  l_data := l_datini;
  l_horant := 0;
  l_faidom_ace  := '';
  l_faiseg_ace  := '';
  l_faiter_ace  := '';
  l_faiqua_ace  := '';
  l_faiqui_ace  := '';
  l_faisex_ace  := '';
  l_faisab_ace  := '';
  l_faidom_pto  := '';
  l_faiseg_pto  := '';
  l_faiter_pto  := '';
  l_faiqua_pto  := '';
  l_faiqui_pto  := '';
  l_faisex_pto  := '';
  l_faisab_pto  := '';
  l_data_zero   := '31/12/1900,00:00:00';
  l_datafa      := '';
  l_datter      := '';
  l_horafa      := 0 ;
  l_iniafa      := '';
  l_fimafa      := '';
  l_datatu      := CURDATE();
  l_hora_atual  := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_fimjor      := 0;
  l_TemAfa      := TRUE;

  RH_DatFim (l_data_limite OUT);

  /* Pega o codigo da filial */
  BEGIN
      SELECT HFI.CODFIL INTO l_codfil FROM R038HFI HFI WHERE
             HFI.NUMEMP = p_numemp AND HFI.TIPCOL = p_tipcol AND HFI.NUMCAD = p_numcad AND
             HFI.DATALT = (SELECT MAX(HFI2.DATALT) FROM R038HFI HFI2
                             WHERE HFI2.NUMEMP = p_numemp AND HFI2.TIPCOL = p_tipcol AND HFI2.NUMCAD = p_numcad AND HFI2.DATALT <= CURDATE());
  EXCEPTION
      WHEN OTHERS THEN l_codfil := 0;
  END;

  LOOP
    l_faiace := '';
    l_faipto := '';

    l_dia_anterior := DATETIMEADD(DD, -1, l_data);
    l_dia_posterior := DATETIMEADD(DD, 1, l_data);

    FOREACH c_horariosPro INTO l_horariosPro.horseg,
                               l_horariosPro.horter,
                               l_horariosPro.horqua,
                               l_horariosPro.horqui,
                               l_horariosPro.horsex,
                               l_horariosPro.horsab,
                               l_horariosPro.hordom
    LOOP
        /*Verifica qual o dia da semana atual para pegar o horário correspondente*/
        l_dia_semana  := DAYOFWEEK(l_data);
        IF    l_dia_semana = 1 THEN /* domingo */
            l_codhor := l_horariosPro.hordom;
        ELSIF l_dia_semana = 2 THEN /* segunda */
            l_codhor := l_horariosPro.horseg;
        ELSIF l_dia_semana = 3 THEN /* terca */
            l_codhor := l_horariosPro.horter;
        ELSIF l_dia_semana = 4 THEN /* quarta */
            l_codhor := l_horariosPro.horqua;
        ELSIF l_dia_semana = 5 THEN /* quinta */
            l_codhor := l_horariosPro.horqui;
        ELSIF l_dia_semana = 6 THEN /* sexta */
            l_codhor := l_horariosPro.horsex;
        ELSE
            l_codhor := l_horariosPro.horsab;
        END IF;

        BEGIN
            SELECT MAX(SEQFAI) INTO l_maxseq FROM R004FHR WHERE CODHOR = l_codhor;
        EXCEPTION WHEN OTHERS THEN
            l_maxseq := 1;
        END;
        l_prifxA    := 0;
        l_prifxP    := 0;
        l_codHorAtu := 0;


        FOREACH c_r004fhr INTO l_r004fhr.codhor,
                               l_r004fhr.seqfai,
                               l_r004fhr.iniace,
                               l_r004fhr.fimace,
                               l_r004fhr.inipto,
                               l_r004fhr.fimpto
        LOOP
            /* se for um registro de faixa horaria. */
            l_iniace := l_r004fhr.iniace;
            l_fimace := l_r004fhr.fimace;
            l_inipto := l_r004fhr.inipto;
            l_fimpto := l_r004fhr.fimpto;

            l_horbat  := -1;

            /* pega a primeira hora do horario */
            BEGIN
              SELECT HORBAT INTO l_horbat FROM R004MHR WHERE CODHOR = l_r004fhr.codhor AND SEQMAR = 1;
            EXCEPTION
              WHEN TOO_MANY_ROWS THEN
                  RAISERROR 103 'SP_Faihor: Erro No SELECT R004MHR (TOO_MANY_ROWS).';
              WHEN NO_DATA_FOUND THEN /* no caso dos horários 9997 e 9998 */
                  l_horbat := -1;
              WHEN OTHERS THEN
                  RAISERROR 103 'SP_Faihor: Erro No SELECT R004MHR.';
            END;

            /* verifica o tipo de jornada do horario. */
            /* Pela Saída atualiza próximo dia, Pela Entrada atualiza dia anterior */
            BEGIN
              SELECT JORHOR, JORACE INTO l_jorhor, l_jorace FROM R004HOR WHERE CODHOR = l_r004fhr.codhor;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'RH_Faihor: Erro No SELECT R004HOR.';
            END;
            /* salva o valor da primeira faixa do horáio para ser verificado quando for 3º turno */
            IF  l_r004fhr.codhor <> l_codhoratu THEN
                l_prifxA    := l_iniace;
                l_priFxP    := l_inipto;
                l_codHorAtu := l_r004fhr.codhor;
            END IF;

            IF  (l_r004fhr.iniace = 0) AND (l_r004fhr.fimace = 0) THEN
                NULL;
            ELSE
                /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
                IF   (l_r004fhr.iniace > l_r004fhr.fimace) THEN
                     /* tipo de jornada pela Saída ou Hora da batida as 00:00 a faixa começa no dia anterior. */
                     /* tipo de jornada pela Entrada a faixa termina no próximo dia. */
                     IF  (l_jorhor = 'S') OR (l_horbat = 0) THEN
                         IF  (l_horant <> 0) THEN
                             IF l_r004fhr.fimace = 0 THEN
                                  SP_GRA004TMP(l_data, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                  SP_GRA004TMP(l_dia_anterior, 'A', l_r004fhr.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             END IF;

                             IF  l_r004fhr.fimace > 0 THEN
                                 SP_GRA004TMP(l_data, 'A', 0, l_r004fhr.fimace , 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         SP_GRA004TMP(l_data, 'A', l_r004fhr.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                         IF   l_r004fhr.fimace > 0 THEN
                             SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r004fhr.fimace ,3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     END IF;
                ELSE
                     /* 3º turno com intervalos nas faixas                            */
                     /* será verificado se a faixa atual é menor que a primeira faixa */
                     /* neste caso a faixa atual diz respeito ao próximo dia          */
                     IF (l_jorace = 3) THEN
                         IF  l_iniace < l_prifxA THEN
                             IF  (l_jorhor = 'E') THEN
                                 SP_GRA004TMP(l_dia_posterior, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         ELSE
                             /* primeiro horário da faixa */
                             IF  (l_jorhor = 'S') THEN
                                 SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         /* horário turno 1 (inicia e finaliza no mesmo dia) */
                         SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                     END IF;
                END IF;
            END IF;

            IF  (l_r004fhr.inipto = 0) AND (l_r004fhr.fimpto = 0) THEN
                NULL;
            ELSE
                /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
                IF   (l_r004fhr.inipto > l_r004fhr.fimpto) THEN
                     /* se a faixa finaliza no próximo dia */
                     IF  (l_jorhor = 'S') OR (l_horbat = 0) THEN
                         IF  (l_horant <> 0) THEN

                             IF l_r004fhr.fimpto = 0 THEN
                                  SP_GRA004TMP(l_data, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                  SP_GRA004TMP(l_dia_anterior, 'P', l_r004fhr.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;

                         IF   l_r004fhr.fimpto > 0 THEN
                             SP_GRA004TMP(l_data, 'P', 0, l_r004fhr.fimpto , 3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     ELSE

                         SP_GRA004TMP(l_data, 'P', l_r004fhr.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                         IF   l_r004fhr.fimpto > 0 THEN
                              SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r004fhr.fimpto ,3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     END IF;
                ELSE
                     /* 3º turno com intervalos nas faixas                            */
                     /* será verificado se a faixa atual é menor que a primeira faixa */
                     /* neste caso a faixa atual diz respeito ao próximo dia          */ 
                     IF (l_jorace = 3) THEN
                         IF  l_inipto < l_prifxP THEN
                             IF  (l_jorhor = 'E') THEN
                                 SP_GRA004TMP(l_dia_posterior, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         ELSE
                             /* primeiro horário da faixa */
                             IF  (l_jorhor = 'S') THEN
                                 SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         /* horário turno 1 (inicia e finaliza no mesmo dia) */
                         SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                     END IF;
                END IF;
            END IF;
        END LOOP;

        /* salva o valor do horário anterior */
        l_horant := l_codhor;

    END LOOP;  /*Loop R171APF e R171DPF*/

    /*Processa as autorizações de horas extras e saída*/
    FOREACH c_r064XXX INTO l_r064xxx.codreg,
                           l_r064xxx.iniace,
                           l_r064xxx.fimace,
                           l_r064xxx.inipto,
                           l_r064xxx.fimpto,
                           l_r064xxx.tolaea,
                           l_r064xxx.tolasa,
                           l_r064xxx.tolaep,
                           l_r064xxx.tolasp
    LOOP
        /* Inicializações */
        l_iniace := l_r064xxx.iniace;
        l_fimace := l_r064xxx.fimace;
        l_inipto := l_r064xxx.inipto;
        l_fimpto := l_r064xxx.fimpto;

        IF  (l_r064xxx.iniace = 0) AND (l_r064xxx.fimace = 0) THEN
            NULL;
        ELSE
            /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
            IF   (l_r064xxx.iniace > l_r064xxx.fimace) THEN
                IF  (l_r064xxx.codreg = 2) THEN
                    IF  l_r064xxx.tolaea > 0 THEN
                        IF   l_r064xxx.tolaea < l_r064xxx.iniace THEN
                             l_iniace := l_r064xxx.iniace - l_r064xxx.tolaea;
                        ELSE l_iniace := 1440 - l_r064xxx.tolaea + l_r064xxx.iniace;
                             SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             l_iniace := 0;
                        END IF;
                    END IF;
                    IF  l_r064xxx.tolasa > 0 THEN
                        l_total1 := l_r064xxx.fimace + l_r064xxx.tolasa;
                        IF l_r064xxx.fimace = 0 THEN
                             l_total1 := l_total1 + 1440;
                        END IF;
                        IF   l_total1 < 1439 THEN
                             l_fimace := l_total1;
                        ELSE
                             l_fimace := l_total1 - 1440;
                             SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                             l_fimace := 1439;
                        END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimace > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                ELSE
                    /*Autorização de saida*/
                    SP_GRA004TMP(l_data, 'A', l_r064xxx.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimace > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r064xxx.fimace ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                END IF;
            ELSE
                /* se for registro de programação de horas extras ver tolerancias */
                IF  l_r064xxx.codreg = 2 THEN
                    IF  l_r064xxx.tolaea > 0 THEN
                       IF   l_r064xxx.tolaea < l_r064xxx.iniace THEN
                            l_iniace := l_r064xxx.iniace - l_r064xxx.tolaea;
                       ELSE l_iniace := 1440 - l_r064xxx.tolaea + l_r064xxx.iniace;
                            SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                            l_iniace := 0;
                       END IF;
                    END IF;

                    /* se tolerancia para acesso for maior que 0 */
                    IF  l_r064xxx.tolasa > 0 THEN
                       l_total1 := l_r064xxx.fimace + l_r064xxx.tolasa;
                       IF l_r064xxx.fimace = 0 THEN
                            l_total1 := l_total1 + 1440;
                       END IF;
                       IF   l_total1 < 1439 THEN
                            l_fimace := l_total1;
                       ELSE
                            l_fimace := l_total1 - 1440;
                            SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                            l_fimace := 1439;
                       END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);

                ELSE
                    /*Autorização de Acesso*/
                    SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                END IF;
            END IF;
        END IF;

        IF  (l_r064xxx.inipto = 0) AND (l_r064xxx.fimpto = 0) THEN
            NULL;
        ELSE
            /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
            IF   (l_r064xxx.inipto > l_r064xxx.fimpto) THEN
                IF  (l_r064xxx.codreg = 2) THEN
                    IF  l_r064xxx.tolaep > 0 THEN
                        IF   l_r064xxx.tolaep < l_r064xxx.inipto THEN
                             l_inipto := l_r064xxx.inipto - l_r064xxx.tolaep;
                        ELSE l_inipto := 1440 - l_r064xxx.tolaep + l_r064xxx.inipto;
                             SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             l_inipto := 0;
                        END IF;
                    END IF;
                    IF  l_r064xxx.tolasp > 0 THEN
                        l_total1 := l_r064xxx.fimpto + l_r064xxx.tolasp;
                        IF l_r064xxx.fimpto = 0 THEN
                             l_total1 := l_total1 + 1440;
                        END IF;
                        IF   l_total1 < 1439 THEN
                             l_fimpto := l_total1;
                        ELSE
                             l_fimpto := l_total1 - 1440;
                             SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                             l_fimpto := 1439;
                        END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimpto > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;

                ELSE
                    /*Autorização de Saída*/
                    SP_GRA004TMP(l_data, 'P', l_r064xxx.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimpto > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r064xxx.fimpto ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                END IF;
            ELSE
                /* se for registro de programação de horas extras ver tolerancias */
                IF  l_r064xxx.codreg = 2 THEN
                    /* se tolerancia para ponto for maior que 0 */
                    IF  l_r064xxx.tolaep > 0 THEN
                       IF   l_r064xxx.tolaep < l_r064xxx.inipto THEN
                            l_inipto := l_r064xxx.inipto - l_r064xxx.tolaep;
                       ELSE l_inipto := 1440 - l_r064xxx.tolaep + l_r064xxx.inipto;
                            SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                            l_inipto := 0;
                       END IF;
                    END IF;

                    /* se tolerancia para ponto for maior que 0 */
                    IF  l_r064xxx.tolasp > 0 THEN
                       l_total1 := l_r064xxx.fimpto + l_r064xxx.tolasp;
                       IF   l_total1 < 1439 THEN
                            l_fimpto := l_total1;
                       ELSE
                            l_fimpto := l_total1 - 1440;
                            SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                            l_fimpto := 1439;
                       END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                ELSE
                    SP_GRA004TMP(l_data, 'P', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                END IF;
            END IF;
        END IF;
    END LOOP; 

    /* Condicao p/ Controle LOOP. Deve estar antes de incrementar a data, pois deve percorrer um dia a mais. */
    /* Motivo para isso é quando o proximo dia inicia no dia anterior. */
    IF   (l_data > l_data_limite) THEN
         EXIT;
    END IF;

    /* Incremento p/ Controle LOOP */
    l_data := DATETimeAdd(DD,1,l_data);
  END LOOP;

  l_data := CURDATE();

  l_datatu        := CURDATE();
  l_datant        := DATETIMEADD(DD, -1, l_datatu);
  l_dia_posterior := DATETIMEADD(DD, 1, l_datatu);
  l_hora_atual    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  /* verifica liberação da faixa horária (R070LFH) */
  l_numcra:= 0;
  l_tipcra:= 2;

  /*Verifica Liberação de Faixa Horária para Crachá Provisório*/
  FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM
  LOOP
          /* para data atual, verifica se hora termina no dia ou no próximo dia */
          IF  (l_r070lfh.datlib = l_datatu) THEN
              IF (l_r070lfh.HORFIM < l_r070lfh.HORINI) THEN
                  /*termina no outro dia*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);

                  SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              ELSE
                  /*termina no dia atual*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              END IF;
          ELSE
              /* para o dia anteior, então libera da hora zero até a hora final*/
              SP_GRA004TMP(l_datatu, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              SP_GRA004TMP(l_datatu, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
          END IF;

          l_numcra := l_r070lfh.NUMCRA;
  END LOOP;
  /*Se não encontrou, Verifica Liberação de Faixa Horária para o Crachá do Titular*/
  IF  (l_NumCra = 0) THEN
      l_tipcra := 1;
      FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM
      LOOP
          /* para data atual, verifica se hora termina no dia ou no próximo dia */
          IF  (l_r070lfh.datlib = l_datatu) THEN
              IF (l_r070lfh.HORFIM < l_r070lfh.HORINI) THEN
                  /*termina no outro dia*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);

                  SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              ELSE
                  /*termina no dia atual*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              END IF;
          ELSE
              /* para o dia anteior, então libera da hora zero até a hora final*/
              SP_GRA004TMP(l_datatu, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              SP_GRA004TMP(l_datatu, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
          END IF;
      END LOOP;
  END IF;

  /* calcula faixas que estão no mesmo período */
  SP_UnePro(l_datini, l_data_limite,'A', p_numemp, p_tipcol, p_numcad);
  SP_UnePro(l_datini, l_data_limite,'P', p_numemp, p_tipcol, p_numcad);

  LOOP
    l_faiace := '';
    l_faipto := '';

    FOREACH c_r004TMP INTO l_r004TMP.DatHor,
                           l_r004TMP.TipFai,
                           l_r004TMP.FaiIni,
                           l_r004TMP.FaiFim,
                           l_r004TMP.TurTrb

    LOOP
      /* SE TIVER MOBILIDADE DE HORARIO ENTAO CONSIDERA-LA.*/
      SP_INTSTR(l_r004tmp.FaiIni,'HHMM',l_strini OUT);
      SP_INTSTR(l_r004tmp.FaiFim,'HHMM',l_strfim OUT);
      IF  l_r004TMP.TipFai = 'A' THEN
          l_faiace := l_faiace || l_strini || l_strfim;
      END IF;
      IF  l_r004TMP.TipFai = 'P' THEN
          l_faipto := l_faipto || l_strini || l_strfim;
      END IF;

      /* verifica último turno para afastamento (final jornada = maior horario do 3º turno).*/
      IF  (l_r004TMP.DatHor = l_datatu) AND
          (l_r004TMP.TurTrb = 3)        AND
          (l_fimjor < l_r004TMP.FaiFim) AND
          (l_r004TMP.tipfai = 'A')      THEN
          l_fimjor := l_r004TMP.FaiFim;
      END IF;

    END LOOP;

    /* PREENCHE O RESTO DO CAMPO COM 2400 */
    l_faiace := IFNULL(l_faiace,'');
    IF (l_faiace IS NULL) OR (l_faiace = '0') OR (l_faiace = '') THEN
      l_lengfai := 7;
      l_faiace :='';
    ELSE
      l_lengfai := (56 - LENGTH(l_faiace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
      l_faiace := l_faiace || '24002400';
      l_contfai := l_contfai + 1;
      IF (l_contfai >= l_lengfai) THEN
        EXIT;
      END IF;
    END LOOP;
    /* PREENCHE O RESTO DO CAMPO COM 2400 */
    l_faipto := IFNULL(l_faipto,'');
    IF (l_faipto IS NULL) OR (l_faipto = '0') OR (l_faipto = '') THEN
      l_lengfai := 7;
      l_faipto := '';
    ELSE
      l_lengfai := (56 - LENGTH(l_faipto)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
      l_faipto := l_faipto || '24002400';
      l_contfai := l_contfai + 1;
      IF (l_contfai >= l_lengfai) THEN
        EXIT;
      END IF;
    END LOOP;


    l_faiace     := SUBSTRING(l_faiace,1,56);
    l_faipto     := SUBSTRING(l_faipto,1,56);
    l_dia_semana := DAYOFWEEK(l_data);
    IF    l_dia_semana = 1 THEN /* domingo */
          l_faidom_ace := l_faiace;
          l_faidom_pto := l_faipto;
    ELSIF l_dia_semana = 2 THEN /* segunda */
          l_faiseg_ace := l_faiace;
          l_faiseg_pto := l_faipto;
    ELSIF l_dia_semana = 3 THEN /* terca */
          l_faiter_ace := l_faiace;
          l_faiter_pto := l_faipto;
    ELSIF l_dia_semana = 4 THEN /* quarta */
          l_faiqua_ace := l_faiace;
          l_faiqua_pto := l_faipto;
    ELSIF l_dia_semana = 5 THEN /* quinta */
          l_faiqui_ace := l_faiace;
          l_faiqui_pto := l_faipto;
    ELSIF l_dia_semana = 6 THEN /* sexta */
          l_faisex_ace := l_faiace;
          l_faisex_pto := l_faipto;
    ELSE  l_faisab_ace := l_faiace;
          l_faisab_pto := l_faipto;
    END IF;

    /* Incremento p/ Controle LOOP */
    l_data := DATETimeAdd(DD,1,l_data);
    IF   (l_data > l_data_limite) THEN
         EXIT;
    END IF;
  END LOOP;

  /* monta a faixa do refeitorio que deve sempre comecar pelo domingo. */
  p_fairef := '24002400240024002400240024002400240024002400240024002400';

  l_faidom_ace := SUBSTRING(l_faidom_ace,1,56);
  l_faiseg_ace := SUBSTRING(l_faiseg_ace,1,56);
  l_faiter_ace := SUBSTRING(l_faiter_ace,1,56);
  l_faiqua_ace := SUBSTRING(l_faiqua_ace,1,56);
  l_faiqui_ace := SUBSTRING(l_faiqui_ace,1,56);
  l_faisex_ace := SUBSTRING(l_faisex_ace,1,56);
  l_faisab_ace := SUBSTRING(l_faisab_ace,1,56);
  l_faidom_pto := SUBSTRING(l_faidom_pto,1,56);
  l_faiseg_pto := SUBSTRING(l_faiseg_pto,1,56);
  l_faiter_pto := SUBSTRING(l_faiter_pto,1,56);
  l_faiqua_pto := SUBSTRING(l_faiqua_pto,1,56);
  l_faiqui_pto := SUBSTRING(l_faiqui_pto,1,56);
  l_faisex_pto := SUBSTRING(l_faisex_pto,1,56);
  l_faisab_pto := SUBSTRING(l_faisab_pto,1,56);
  p_faidom_ace  := l_faidom_ace;
  p_faiseg_ace  := l_faiseg_ace;
  p_faiter_ace  := l_faiter_ace;
  p_faiqua_ace  := l_faiqua_ace;
  p_faiqui_ace  := l_faiqui_ace;
  p_faisex_ace  := l_faisex_ace;
  p_faisab_ace  := l_faisab_ace;
  p_faidom_pto  := l_faidom_pto;
  p_faiseg_pto  := l_faiseg_pto;
  p_faiter_pto  := l_faiter_pto;
  p_faiqua_pto  := l_faiqua_pto;
  p_faiqui_pto  := l_faiqui_pto;
  p_faisex_pto  := l_faisex_pto;
  p_faisab_pto  := l_faisab_pto; 
  /* Atualiza Afastamentos */
  BEGIN
      SELECT R038AFA.DATAFA, R038AFA.HORAFA, R038AFA.DATTER, R038AFA.HORTER
      INTO l_datafa, l_horafa, l_datter, l_horter
      FROM R010SIT,R038AFA
      WHERE R038AFA.NUMEMP = p_numemp AND R038AFA.TIPCOL = p_tipcol AND R038AFA.NUMCAD = p_numcad AND
           (R038AFA.DATAFA < l_datatu OR (R038AFA.DATAFA = l_datatu AND R038AFA.HORAFA <= l_hora_atual)) AND
           (R038AFA.DATTER = l_data_zero OR R038AFA.DATTER > l_datatu OR
           (R038AFA.DATTER = l_datatu AND R038AFA.HORTER >= l_hora_atual) OR
           (R038AFA.DATTER = l_datatu AND R038AFA.HORTER = 0)) AND
            R038AFA.SITAFA = R010SIT.CODSIT AND R010SIT.BLOACE = 'S' AND
            R010SIT.TIPSIT <> 7;
  EXCEPTION
      WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SPFaiHor: Erro em R038AFA - TOO MANY ROWS.';
      WHEN NO_DATA_FOUND THEN l_TemAfa := FALSE;
      WHEN OTHERS        THEN RAISERROR 103 'SPFaihor: Erro no SELECT em R038AFA.';
  END;

  IF  (l_TemAfa = TRUE) THEN
      /* para terceiro turno é inserido afastamento com data inicial zero.  */
      /* neste caso é necessário verificar se já finalizou a jornada para   */
      /* não bloquear o colaborador na saída. se o final da jornado for 1439*/
      /* significa que ele tem faixa de acesso livre e não precisa verificar*/
      /* a jornada.                                                         */

      IF  (l_horafa = 0) THEN
          IF  (l_hora_atual > l_fimjor) OR (l_fimjor = 1439) THEN
              SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);
              IF  (l_datter <> l_data_zero) THEN
                  SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
              ELSE
                  l_fimafa := '311250';
                  l_horter:= 1439;
              END IF;
          END IF;
      ELSE
          IF  (l_datatu > l_datafa) OR (l_datatu = l_datafa AND l_hora_atual >= l_horafa) THEN
              SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);
              IF  (l_datter <> l_data_zero) THEN
                  SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
              ELSE
                  l_fimafa := '311250';
                  l_horter:= 1439;
              END IF;
          END IF;
      END IF;
      /*Hora final 00:00 considerar como 23:59*/
      IF l_horter = 0 THEN
        l_horter:= 1439;
      END IF;
  ELSE
      l_iniafa := '      ';
      l_fimafa := '      ';
      l_horafa := 0;
      l_horter := 0;
  END IF;
  
  IF (l_horafa = 0) THEN
      p_horini:= '0000';
  ELSE
      SP_INTSTR(l_horafa,'HHMM',p_horini OUT);
  END IF;
  IF (l_horter = 0) THEN
      p_horfim:= '0000';
  ELSE
      SP_INTSTR(l_horter,'HHMM',p_horfim OUT);
  END IF;

  p_datini := l_iniafa;
  p_datfim := l_fimafa;

  /* Limpa tabela temporaria R004TMP */
  BEGIN
      DELETE FROM R004TMP WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
      DROP_TEMP_TABLE R004TMP;
  EXCEPTION WHEN OTHERS THEN
      NULL;
  END;  
END		SENIOR;21:RH_DATFIM
SP_GRA004TMP
SP_UNEPRO
SP_INTSTR
SP_DATSTR
r’␀␀


PROCEDURE SP_FAIPRO(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56),P_DATINI OUT VARCHAR2(6),P_DATFIM OUT VARCHAR2(6),P_HORINI OUT VARCHAR2(4),P_HORFIM OUT VARCHAR2(4))
 IS

l_data          DATE;
  l_datini        DATE;
  l_data_limite   DATE;
  l_dia_anterior  DATE;
  l_dia_posterior DATE;
  l_dia_semana  NUMBER(1);
  l_codhor      NUMBER(4);
  l_horant      NUMBER(4);
  l_horref      NUMBER(5);
  l_faiace      VARCHAR2(255);
  l_faipto      VARCHAR2(255);
  l_strini      CHAR(4);
  l_strfim      CHAR(4);
  l_horbat      INTEGER;
  l_total1      NUMBER(5);
  l_iniace      NUMBER(5);
  l_inipto      NUMBER(5);
  l_fimace      NUMBER(5);
  l_fimpto      NUMBER(5);
  l_faidom_ace  VARCHAR(56);
  l_faiseg_ace  VARCHAR(56);
  l_faiter_ace  VARCHAR(56);
  l_faiqua_ace  VARCHAR(56);
  l_faiqui_ace  VARCHAR(56);
  l_faisex_ace  VARCHAR(56);
  l_faisab_ace  VARCHAR(56);
  l_faidom_pto  VARCHAR(56);
  l_faiseg_pto  VARCHAR(56);
  l_faiter_pto  VARCHAR(56);
  l_faiqua_pto  VARCHAR(56);
  l_faiqui_pto  VARCHAR(56);
  l_faisex_pto  VARCHAR(56);
  l_faisab_pto  VARCHAR(56);
  l_contfai     INTEGER;
  l_lengfai     INTEGER;
  l_maxseq      NUMBER(2);
  l_jorhor      CHAR;
  l_hora_atual  NUMBER(4);
  l_datafa      DATE;
  l_datter      DATE;
  l_iniafa      CHAR(6);
  l_fimafa      CHAR(6);
  l_horafa      NUMBER(4);
  l_horter      NUMBER(4);
  l_data_zero   DATE;
  l_datatu      DATE;
  l_datant      DATE;
  l_fimjor      NUMBER;
  l_TemAfa      BOOLEAN;
  l_jorace      NUMBER;
  l_prifxA      NUMBER;
  l_prifxP      NUMBER;
  l_codHorAtu   NUMBER;
  l_numcra      NUMBER(12);
  l_HorIni      NUMBER(4);
  l_HorFim      NUMBER(4);
  l_TipCra      NUMBER(1);
  l_codfil      NUMBER(6);

  /* OBTEM O HORÁRIO DAS ATIVIDADES E DISCIPLINAS DO PROFESSOR */
  CURSOR c_horariosPro IS
  SELECT HORSEG,HORTER,HORQUA,HORQUI,HORSEX,HORSAB,HORDOM
    FROM R171APF
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
      DATINI <= l_data AND ((DATFIM >= l_data) OR (DATFIM = l_data_zero)) UNION ALL
  (SELECT HORSEG,HORTER,HORQUA,HORQUI,HORSEX,HORSAB,HORDOM
    FROM R171DPF
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
      DATINI <= l_data AND ((DATFIM >= l_data) OR (DATFIM = l_data_zero)));
  TYPE t_horariosPro IS RECORD(
      HORSEG   R073ATA.HORSEG%TYPE,
      HORTER   R073ATA.HORTER%TYPE,
      HORQUA   R073ATA.HORQUA%TYPE,
      HORQUI   R073ATA.HORQUI%TYPE,
      HORSEX   R073ATA.HORSEX%TYPE,
      HORSAB   R073ATA.HORSAB%TYPE,
      HORDOM   R073ATA.HORDOM%TYPE);
  l_horariosPro t_horariosPro;


  /* PEGA AS FAIXAS HORARIAS DO HORARIO, AS PROGRAMAÇÕES DE HORAS EXTRAS */
  /* E OS AFASTAMENTOS CUJA ORIGEM FOR SAIDA AUTORIZADA */
  CURSOR c_r004fhr IS
    SELECT CODHOR, SEQFAI, INIACE, FIMACE, INIPTO, FIMPTO
    FROM R004FHR FHR WHERE NOT EXISTS (SELECT 1 FROM R004FHF WHERE R004FHF.CODHOR = FHR.CODHOR AND R004FHF.NUMEMP = p_numemp AND R004FHF.CODFIL = l_codfil) AND
             (FHR.CODHOR = l_codhor)
    UNION(
    SELECT CODHOR, SEQFAI, INIACE, FIMACE, INIPTO, FIMPTO
    FROM R004FHF FHF WHERE FHF.NUMEMP = p_numemp AND FHF.CODFIL = l_codfil AND
             (FHF.CODHOR = l_codhor))   
   ORDER BY 1,2,3,4;

  TYPE t_r004fhr IS RECORD(
    CODHOR   R004FHR.CODHOR%TYPE,
    SEQFAI   R004FHR.SEQFAI%TYPE,
    INIACE   R004FHR.INIACE%TYPE,
    FIMACE   R004FHR.FIMACE%TYPE,
    INIPTO   R004FHR.INIPTO%TYPE,
    FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;


  /* CURSOR DA TABELA TEMPORARIA.. */
  CURSOR c_r004TMP IS
  SELECT DATHOR,TIPFAI,FAIINI,FAIFIM,TURTRB FROM R004TMP WHERE DATHOR = l_data AND NUMEMP = p_numemp AND
         TIPCOL = p_tipcol AND NUMCAD = p_numcad ORDER BY 1,2,3;
  TYPE t_r004TMP IS RECORD(
    DATHOR   R004TMP.DATHOR%TYPE,
    TIPFAI   R004TMP.TIPFAI%TYPE,
    FAIINI   R004TMP.FAIINI%TYPE,
    FAIFIM   R004TMP.FAIFIM%TYPE,
    TURTRB   R004TMP.TURTRB%TYPE);
  l_r004TMP t_r004TMP;

  /*CURSOR para Verificar as Liberações de Faixas Horárias*/
  CURSOR c_r070lfh IS
  SELECT A.NUMCRA, A.DATLIB, A.HORINI, A.HORFIM FROM R070LFH A, R038HCH B
             WHERE
             B.TIPCRA = l_tipcra AND B.STAACC = 1 AND
             A.NUMCRA = B.NUMCRA AND B.NUMEMP = p_numemp AND B.TIPCOL = p_tipcol AND B.NUMCAD = p_numcad AND
             ((B.DATINI < l_datatu) OR (B.DATINI = l_datatu)) AND
             ((B.DATFIM > l_datatu) OR (B.DATFIM = l_datatu) OR B.DATFIM = L_DATA_ZERO) AND
             ((A.DATLIB = l_datatu) OR
              (A.DATLIB = l_datant AND (A.HORINI > A.HORFIM) AND (A.HORFIM > l_hora_atual))
             );
  TYPE t_r070lfh IS RECORD(
    NUMCRA   R070LFH.NUMCRA%TYPE,
    DATLIB   R070LFH.DATLIB%TYPE,
    HORINI   R070LFH.HORINI%TYPE,
    HORFIM   R070LFH.HORFIM%TYPE);
  l_r070lfh t_r070lfh;

  /*Verifica as autorizações de horas extras e saída*/
  CURSOR c_r064xxx IS
  SELECT 2 CODREG, HORINI INIACE,HORFIM FIMACE, HORINI INIPTO, HORFIM FIMPTO, TOLAEA,TOLASA,TOLAEP,TOLASP
  FROM R064EXT
   WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI <= l_data AND DATFIM >= l_data
   UNION
  (SELECT 3 CODREG, HORASA INIACE,HORTER FIMACE, HORASA INIPTO, HORTER FIMPTO, 0 TOLAEA,0 TOLASA,0 TOLAEP,0 TOLASP
    FROM R064ASA
   WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATASA = l_data)
   ORDER BY CODREG,INIACE,FIMACE,INIPTO;
   TYPE t_r064xxx IS RECORD(
    CODREG   R004FHR.CODHOR%TYPE,
    INIACE   R064EXT.HORINI%TYPE,
    FIMACE   R064EXT.HORFIM%TYPE,
    INIPTO   R064EXT.HORINI%TYPE,
    FIMPTO   R064EXT.HORFIM%TYPE,
    TOLAEA   R064EXT.TOLAEA%TYPE,
    TOLASA   R064EXT.TOLASA%TYPE,
    TOLAEP   R064EXT.TOLAEP%TYPE,
    TOLASP   R064EXT.TOLASP%TYPE);
  l_r064xxx t_r064xxx;
  
  /* Declaracao para criar tabela temporária */
  CREATE_TEMP_TABLE R004TMP;

BEGIN

  /* Limpa tabela temporaria R004TMP */
  DELETE FROM R004TMP WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;

  /* Inicializa */
  l_datini := CURDATE();
  /* começar um dia antes em caso de haver 3o. turno. */
  l_datini := DATETIMEADD(DD,-1,l_datini);
  l_data := l_datini;
  l_horant := 0;
  l_faidom_ace  := '';
  l_faiseg_ace  := '';
  l_faiter_ace  := '';
  l_faiqua_ace  := '';
  l_faiqui_ace  := '';
  l_faisex_ace  := '';
  l_faisab_ace  := '';
  l_faidom_pto  := '';
  l_faiseg_pto  := '';
  l_faiter_pto  := '';
  l_faiqua_pto  := '';
  l_faiqui_pto  := '';
  l_faisex_pto  := '';
  l_faisab_pto  := '';
  l_data_zero   := '31/12/1900,00:00:00';
  l_datafa      := '';
  l_datter      := '';
  l_horafa      := 0 ;
  l_iniafa      := '';
  l_fimafa      := '';
  l_datatu      := CURDATE();
  l_hora_atual  := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_fimjor      := 0;
  l_TemAfa      := TRUE;

  RH_DatFim (l_data_limite OUT);

  /* Pega o codigo da filial */
  BEGIN
      SELECT HFI.CODFIL INTO l_codfil FROM R038HFI HFI WHERE
             HFI.NUMEMP = p_numemp AND HFI.TIPCOL = p_tipcol AND HFI.NUMCAD = p_numcad AND
             HFI.DATALT = (SELECT MAX(HFI2.DATALT) FROM R038HFI HFI2
                             WHERE HFI2.NUMEMP = p_numemp AND HFI2.TIPCOL = p_tipcol AND HFI2.NUMCAD = p_numcad AND HFI2.DATALT <= CURDATE());
  EXCEPTION
      WHEN OTHERS THEN l_codfil := 0;
  END;

  LOOP
    l_faiace := '';
    l_faipto := '';

    l_dia_anterior := DATETIMEADD(DD, -1, l_data);
    l_dia_posterior := DATETIMEADD(DD, 1, l_data);

    FOREACH c_horariosPro INTO l_horariosPro.horseg,
                               l_horariosPro.horter,
                               l_horariosPro.horqua,
                               l_horariosPro.horqui,
                               l_horariosPro.horsex,
                               l_horariosPro.horsab,
                               l_horariosPro.hordom
    LOOP
        /*Verifica qual o dia da semana atual para pegar o horário correspondente*/
        l_dia_semana  := DAYOFWEEK(l_data);
        IF    l_dia_semana = 1 THEN /* domingo */
            l_codhor := l_horariosPro.hordom;
        ELSIF l_dia_semana = 2 THEN /* segunda */
            l_codhor := l_horariosPro.horseg;
        ELSIF l_dia_semana = 3 THEN /* terca */
            l_codhor := l_horariosPro.horter;
        ELSIF l_dia_semana = 4 THEN /* quarta */
            l_codhor := l_horariosPro.horqua;
        ELSIF l_dia_semana = 5 THEN /* quinta */
            l_codhor := l_horariosPro.horqui;
        ELSIF l_dia_semana = 6 THEN /* sexta */
            l_codhor := l_horariosPro.horsex;
        ELSE
            l_codhor := l_horariosPro.horsab;
        END IF;

        BEGIN
            SELECT MAX(SEQFAI) INTO l_maxseq FROM R004FHR WHERE CODHOR = l_codhor;
        EXCEPTION WHEN OTHERS THEN
            l_maxseq := 1;
        END;
        l_prifxA    := 0;
        l_prifxP    := 0;
        l_codHorAtu := 0;


        FOREACH c_r004fhr INTO l_r004fhr.codhor,
                               l_r004fhr.seqfai,
                               l_r004fhr.iniace,
                               l_r004fhr.fimace,
                               l_r004fhr.inipto,
                               l_r004fhr.fimpto
        LOOP
            /* se for um registro de faixa horaria. */
            l_iniace := l_r004fhr.iniace;
            l_fimace := l_r004fhr.fimace;
            l_inipto := l_r004fhr.inipto;
            l_fimpto := l_r004fhr.fimpto;

            l_horbat  := -1;

            /* pega a primeira hora do horario */
            BEGIN
              SELECT HORBAT INTO l_horbat FROM R004MHR WHERE CODHOR = l_r004fhr.codhor AND SEQMAR = 1;
            EXCEPTION
              WHEN TOO_MANY_ROWS THEN
                  RAISERROR 103 'SP_Faihor: Erro No SELECT R004MHR (TOO_MANY_ROWS).';
              WHEN NO_DATA_FOUND THEN /* no caso dos horários 9997 e 9998 */
                  l_horbat := -1;
              WHEN OTHERS THEN
                  RAISERROR 103 'SP_Faihor: Erro No SELECT R004MHR.';
            END;

            /* verifica o tipo de jornada do horario. */
            /* Pela Saída atualiza próximo dia, Pela Entrada atualiza dia anterior */
            BEGIN
              SELECT JORHOR, JORACE INTO l_jorhor, l_jorace FROM R004HOR WHERE CODHOR = l_r004fhr.codhor;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'RH_Faihor: Erro No SELECT R004HOR.';
            END;
            /* salva o valor da primeira faixa do horáio para ser verificado quando for 3º turno */
            IF  l_r004fhr.codhor <> l_codhoratu THEN
                l_prifxA    := l_iniace;
                l_priFxP    := l_inipto;
                l_codHorAtu := l_r004fhr.codhor;
            END IF;

            IF  (l_r004fhr.iniace = 0) AND (l_r004fhr.fimace = 0) THEN
                NULL;
            ELSE
                /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
                IF   (l_r004fhr.iniace > l_r004fhr.fimace) THEN
                     /* tipo de jornada pela Saída ou Hora da batida as 00:00 a faixa começa no dia anterior. */
                     /* tipo de jornada pela Entrada a faixa termina no próximo dia. */
                     IF  (l_jorhor = 'S') OR (l_horbat = 0) THEN
                         IF  (l_horant <> 0) THEN
                             IF l_r004fhr.fimace = 0 THEN
                                  SP_GRA004TMP(l_data, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                  SP_GRA004TMP(l_dia_anterior, 'A', l_r004fhr.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             END IF;

                             IF  l_r004fhr.fimace > 0 THEN
                                 SP_GRA004TMP(l_data, 'A', 0, l_r004fhr.fimace , 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         SP_GRA004TMP(l_data, 'A', l_r004fhr.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                         IF   l_r004fhr.fimace > 0 THEN
                             SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r004fhr.fimace ,3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     END IF;
                ELSE
                     /* 3º turno com intervalos nas faixas                            */
                     /* será verificado se a faixa atual é menor que a primeira faixa */
                     /* neste caso a faixa atual diz respeito ao próximo dia          */
                     IF (l_jorace = 3) THEN
                         IF  l_iniace < l_prifxA THEN
                             IF  (l_jorhor = 'E') THEN
                                 SP_GRA004TMP(l_dia_posterior, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         ELSE
                             /* primeiro horário da faixa */
                             IF  (l_jorhor = 'S') THEN
                                 SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         /* horário turno 1 (inicia e finaliza no mesmo dia) */
                         SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                     END IF;
                END IF;
            END IF;

            IF  (l_r004fhr.inipto = 0) AND (l_r004fhr.fimpto = 0) THEN
                NULL;
            ELSE
                /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
                IF   (l_r004fhr.inipto > l_r004fhr.fimpto) THEN
                     /* se a faixa finaliza no próximo dia */
                     IF  (l_jorhor = 'S') OR (l_horbat = 0) THEN
                         IF  (l_horant <> 0) THEN

                             IF l_r004fhr.fimpto = 0 THEN
                                  SP_GRA004TMP(l_data, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                  SP_GRA004TMP(l_dia_anterior, 'P', l_r004fhr.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;

                         IF   l_r004fhr.fimpto > 0 THEN
                             SP_GRA004TMP(l_data, 'P', 0, l_r004fhr.fimpto , 3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     ELSE

                         SP_GRA004TMP(l_data, 'P', l_r004fhr.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                         IF   l_r004fhr.fimpto > 0 THEN
                              SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r004fhr.fimpto ,3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     END IF;
                ELSE
                     /* 3º turno com intervalos nas faixas                            */
                     /* será verificado se a faixa atual é menor que a primeira faixa */
                     /* neste caso a faixa atual diz respeito ao próximo dia          */ 
                     IF (l_jorace = 3) THEN
                         IF  l_inipto < l_prifxP THEN
                             IF  (l_jorhor = 'E') THEN
                                 SP_GRA004TMP(l_dia_posterior, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         ELSE
                             /* primeiro horário da faixa */
                             IF  (l_jorhor = 'S') THEN
                                 SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         /* horário turno 1 (inicia e finaliza no mesmo dia) */
                         SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                     END IF;
                END IF;
            END IF;
        END LOOP;

        /* salva o valor do horário anterior */
        l_horant := l_codhor;

    END LOOP;  /*Loop R171APF e R171DPF*/

    /*Processa as autorizações de horas extras e saída*/
    FOREACH c_r064XXX INTO l_r064xxx.codreg,
                           l_r064xxx.iniace,
                           l_r064xxx.fimace,
                           l_r064xxx.inipto,
                           l_r064xxx.fimpto,
                           l_r064xxx.tolaea,
                           l_r064xxx.tolasa,
                           l_r064xxx.tolaep,
                           l_r064xxx.tolasp
    LOOP
        /* Inicializações */
        l_iniace := l_r064xxx.iniace;
        l_fimace := l_r064xxx.fimace;
        l_inipto := l_r064xxx.inipto;
        l_fimpto := l_r064xxx.fimpto;

        IF  (l_r064xxx.iniace = 0) AND (l_r064xxx.fimace = 0) THEN
            NULL;
        ELSE
            /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
            IF   (l_r064xxx.iniace > l_r064xxx.fimace) THEN
                IF  (l_r064xxx.codreg = 2) THEN
                    IF  l_r064xxx.tolaea > 0 THEN
                        IF   l_r064xxx.tolaea < l_r064xxx.iniace THEN
                             l_iniace := l_r064xxx.iniace - l_r064xxx.tolaea;
                        ELSE l_iniace := 1440 - l_r064xxx.tolaea + l_r064xxx.iniace;
                             SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             l_iniace := 0;
                        END IF;
                    END IF;
                    IF  l_r064xxx.tolasa > 0 THEN
                        l_total1 := l_r064xxx.fimace + l_r064xxx.tolasa;
                        IF l_r064xxx.fimace = 0 THEN
                             l_total1 := l_total1 + 1440;
                        END IF;
                        IF   l_total1 < 1439 THEN
                             l_fimace := l_total1;
                        ELSE
                             l_fimace := l_total1 - 1440;
                             SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                             l_fimace := 1439;
                        END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimace > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                ELSE
                    /*Autorização de saida*/
                    SP_GRA004TMP(l_data, 'A', l_r064xxx.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimace > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r064xxx.fimace ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                END IF;
            ELSE
                /* se for registro de programação de horas extras ver tolerancias */
                IF  l_r064xxx.codreg = 2 THEN
                    IF  l_r064xxx.tolaea > 0 THEN
                       IF   l_r064xxx.tolaea < l_r064xxx.iniace THEN
                            l_iniace := l_r064xxx.iniace - l_r064xxx.tolaea;
                       ELSE l_iniace := 1440 - l_r064xxx.tolaea + l_r064xxx.iniace;
                            SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                            l_iniace := 0;
                       END IF;
                    END IF;

                    /* se tolerancia para acesso for maior que 0 */
                    IF  l_r064xxx.tolasa > 0 THEN
                       l_total1 := l_r064xxx.fimace + l_r064xxx.tolasa;
                       IF l_r064xxx.fimace = 0 THEN
                            l_total1 := l_total1 + 1440;
                       END IF;
                       IF   l_total1 < 1439 THEN
                            l_fimace := l_total1;
                       ELSE
                            l_fimace := l_total1 - 1440;
                            SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                            l_fimace := 1439;
                       END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);

                ELSE
                    /*Autorização de Acesso*/
                    SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                END IF;
            END IF;
        END IF;

        IF  (l_r064xxx.inipto = 0) AND (l_r064xxx.fimpto = 0) THEN
            NULL;
        ELSE
            /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
            IF   (l_r064xxx.inipto > l_r064xxx.fimpto) THEN
                IF  (l_r064xxx.codreg = 2) THEN
                    IF  l_r064xxx.tolaep > 0 THEN
                        IF   l_r064xxx.tolaep < l_r064xxx.inipto THEN
                             l_inipto := l_r064xxx.inipto - l_r064xxx.tolaep;
                        ELSE l_inipto := 1440 - l_r064xxx.tolaep + l_r064xxx.inipto;
                             SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             l_inipto := 0;
                        END IF;
                    END IF;
                    IF  l_r064xxx.tolasp > 0 THEN
                        l_total1 := l_r064xxx.fimpto + l_r064xxx.tolasp;
                        IF l_r064xxx.fimpto = 0 THEN
                             l_total1 := l_total1 + 1440;
                        END IF;
                        IF   l_total1 < 1439 THEN
                             l_fimpto := l_total1;
                        ELSE
                             l_fimpto := l_total1 - 1440;
                             SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                             l_fimpto := 1439;
                        END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimpto > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;

                ELSE
                    /*Autorização de Saída*/
                    SP_GRA004TMP(l_data, 'P', l_r064xxx.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimpto > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r064xxx.fimpto ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                END IF;
            ELSE
                /* se for registro de programação de horas extras ver tolerancias */
                IF  l_r064xxx.codreg = 2 THEN
                    /* se tolerancia para ponto for maior que 0 */
                    IF  l_r064xxx.tolaep > 0 THEN
                       IF   l_r064xxx.tolaep < l_r064xxx.inipto THEN
                            l_inipto := l_r064xxx.inipto - l_r064xxx.tolaep;
                       ELSE l_inipto := 1440 - l_r064xxx.tolaep + l_r064xxx.inipto;
                            SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                            l_inipto := 0;
                       END IF;
                    END IF;

                    /* se tolerancia para ponto for maior que 0 */
                    IF  l_r064xxx.tolasp > 0 THEN
                       l_total1 := l_r064xxx.fimpto + l_r064xxx.tolasp;
                       IF   l_total1 < 1439 THEN
                            l_fimpto := l_total1;
                       ELSE
                            l_fimpto := l_total1 - 1440;
                            SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                            l_fimpto := 1439;
                       END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                ELSE
                    SP_GRA004TMP(l_data, 'P', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                END IF;
            END IF;
        END IF;
    END LOOP; 

    /* Condicao p/ Controle LOOP. Deve estar antes de incrementar a data, pois deve percorrer um dia a mais. */
    /* Motivo para isso é quando o proximo dia inicia no dia anterior. */
    IF   (l_data > l_data_limite) THEN
         EXIT;
    END IF;

    /* Incremento p/ Controle LOOP */
    l_data := DATETimeAdd(DD,1,l_data);
  END LOOP;

  l_data := CURDATE();

  l_datatu        := CURDATE();
  l_datant        := DATETIMEADD(DD, -1, l_datatu);
  l_dia_posterior := DATETIMEADD(DD, 1, l_datatu);
  l_hora_atual    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  /* verifica liberação da faixa horária (R070LFH) */
  l_numcra:= 0;
  l_tipcra:= 2;

  /*Verifica Liberação de Faixa Horária para Crachá Provisório*/
  FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM
  LOOP
          /* para data atual, verifica se hora termina no dia ou no próximo dia */
          IF  (l_r070lfh.datlib = l_datatu) THEN
              IF (l_r070lfh.HORFIM < l_r070lfh.HORINI) THEN
                  /*termina no outro dia*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);

                  SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              ELSE
                  /*termina no dia atual*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              END IF;
          ELSE
              /* para o dia anteior, então libera da hora zero até a hora final*/
              SP_GRA004TMP(l_datatu, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              SP_GRA004TMP(l_datatu, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
          END IF;

          l_numcra := l_r070lfh.NUMCRA;
  END LOOP;
  /*Se não encontrou, Verifica Liberação de Faixa Horária para o Crachá do Titular*/
  IF  (l_NumCra = 0) THEN
      l_tipcra := 1;
      FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM
      LOOP
          /* para data atual, verifica se hora termina no dia ou no próximo dia */
          IF  (l_r070lfh.datlib = l_datatu) THEN
              IF (l_r070lfh.HORFIM < l_r070lfh.HORINI) THEN
                  /*termina no outro dia*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);

                  SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              ELSE
                  /*termina no dia atual*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              END IF;
          ELSE
              /* para o dia anteior, então libera da hora zero até a hora final*/
              SP_GRA004TMP(l_datatu, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              SP_GRA004TMP(l_datatu, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
          END IF;
      END LOOP;
  END IF;

  /* calcula faixas que estão no mesmo período */
  SP_UnePro(l_datini, l_data_limite,'A', p_numemp, p_tipcol, p_numcad);
  SP_UnePro(l_datini, l_data_limite,'P', p_numemp, p_tipcol, p_numcad);

  LOOP
    l_faiace := '';
    l_faipto := '';

    FOREACH c_r004TMP INTO l_r004TMP.DatHor,
                           l_r004TMP.TipFai,
                           l_r004TMP.FaiIni,
                           l_r004TMP.FaiFim,
                           l_r004TMP.TurTrb

    LOOP
      /* SE TIVER MOBILIDADE DE HORARIO ENTAO CONSIDERA-LA.*/
      SP_INTSTR(l_r004tmp.FaiIni,'HHMM',l_strini OUT);
      SP_INTSTR(l_r004tmp.FaiFim,'HHMM',l_strfim OUT);
      IF  l_r004TMP.TipFai = 'A' THEN
          l_faiace := l_faiace || l_strini || l_strfim;
      END IF;
      IF  l_r004TMP.TipFai = 'P' THEN
          l_faipto := l_faipto || l_strini || l_strfim;
      END IF;

      /* verifica último turno para afastamento (final jornada = maior horario do 3º turno).*/
      IF  (l_r004TMP.DatHor = l_datatu) AND
          (l_r004TMP.TurTrb = 3)        AND
          (l_fimjor < l_r004TMP.FaiFim) AND
          (l_r004TMP.tipfai = 'A')      THEN
          l_fimjor := l_r004TMP.FaiFim;
      END IF;

    END LOOP;

    /* PREENCHE O RESTO DO CAMPO COM 2400 */
    l_faiace := IFNULL(l_faiace,'');
    IF (l_faiace IS NULL) OR (l_faiace = '0') OR (l_faiace = '') THEN
      l_lengfai := 7;
      l_faiace :='';
    ELSE
      l_lengfai := (56 - LENGTH(l_faiace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
      l_faiace := l_faiace || '24002400';
      l_contfai := l_contfai + 1;
      IF (l_contfai >= l_lengfai) THEN
        EXIT;
      END IF;
    END LOOP;
    /* PREENCHE O RESTO DO CAMPO COM 2400 */
    l_faipto := IFNULL(l_faipto,'');
    IF (l_faipto IS NULL) OR (l_faipto = '0') OR (l_faipto = '') THEN
      l_lengfai := 7;
      l_faipto := '';
    ELSE
      l_lengfai := (56 - LENGTH(l_faipto)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
      l_faipto := l_faipto || '24002400';
      l_contfai := l_contfai + 1;
      IF (l_contfai >= l_lengfai) THEN
        EXIT;
      END IF;
    END LOOP;


    l_faiace     := SUBSTRING(l_faiace,1,56);
    l_faipto     := SUBSTRING(l_faipto,1,56);
    l_dia_semana := DAYOFWEEK(l_data);
    IF    l_dia_semana = 1 THEN /* domingo */
          l_faidom_ace := l_faiace;
          l_faidom_pto := l_faipto;
    ELSIF l_dia_semana = 2 THEN /* segunda */
          l_faiseg_ace := l_faiace;
          l_faiseg_pto := l_faipto;
    ELSIF l_dia_semana = 3 THEN /* terca */
          l_faiter_ace := l_faiace;
          l_faiter_pto := l_faipto;
    ELSIF l_dia_semana = 4 THEN /* quarta */
          l_faiqua_ace := l_faiace;
          l_faiqua_pto := l_faipto;
    ELSIF l_dia_semana = 5 THEN /* quinta */
          l_faiqui_ace := l_faiace;
          l_faiqui_pto := l_faipto;
    ELSIF l_dia_semana = 6 THEN /* sexta */
          l_faisex_ace := l_faiace;
          l_faisex_pto := l_faipto;
    ELSE  l_faisab_ace := l_faiace;
          l_faisab_pto := l_faipto;
    END IF;

    /* Incremento p/ Controle LOOP */
    l_data := DATETimeAdd(DD,1,l_data);
    IF   (l_data > l_data_limite) THEN
         EXIT;
    END IF;
  END LOOP;

  /* monta a faixa do refeitorio que deve sempre comecar pelo domingo. */
  p_fairef := '24002400240024002400240024002400240024002400240024002400';

  l_faidom_ace := SUBSTRING(l_faidom_ace,1,56);
  l_faiseg_ace := SUBSTRING(l_faiseg_ace,1,56);
  l_faiter_ace := SUBSTRING(l_faiter_ace,1,56);
  l_faiqua_ace := SUBSTRING(l_faiqua_ace,1,56);
  l_faiqui_ace := SUBSTRING(l_faiqui_ace,1,56);
  l_faisex_ace := SUBSTRING(l_faisex_ace,1,56);
  l_faisab_ace := SUBSTRING(l_faisab_ace,1,56);
  l_faidom_pto := SUBSTRING(l_faidom_pto,1,56);
  l_faiseg_pto := SUBSTRING(l_faiseg_pto,1,56);
  l_faiter_pto := SUBSTRING(l_faiter_pto,1,56);
  l_faiqua_pto := SUBSTRING(l_faiqua_pto,1,56);
  l_faiqui_pto := SUBSTRING(l_faiqui_pto,1,56);
  l_faisex_pto := SUBSTRING(l_faisex_pto,1,56);
  l_faisab_pto := SUBSTRING(l_faisab_pto,1,56);
  p_faidom_ace  := l_faidom_ace;
  p_faiseg_ace  := l_faiseg_ace;
  p_faiter_ace  := l_faiter_ace;
  p_faiqua_ace  := l_faiqua_ace;
  p_faiqui_ace  := l_faiqui_ace;
  p_faisex_ace  := l_faisex_ace;
  p_faisab_ace  := l_faisab_ace;
  p_faidom_pto  := l_faidom_pto;
  p_faiseg_pto  := l_faiseg_pto;
  p_faiter_pto  := l_faiter_pto;
  p_faiqua_pto  := l_faiqua_pto;
  p_faiqui_pto  := l_faiqui_pto;
  p_faisex_pto  := l_faisex_pto;
  p_faisab_pto  := l_faisab_pto; 
  /* Atualiza Afastamentos */
  BEGIN
      SELECT R038AFA.DATAFA, R038AFA.HORAFA, R038AFA.DATTER, R038AFA.HORTER
      INTO l_datafa, l_horafa, l_datter, l_horter
      FROM R010SIT,R038AFA
      WHERE R038AFA.NUMEMP = p_numemp AND R038AFA.TIPCOL = p_tipcol AND R038AFA.NUMCAD = p_numcad AND
           (R038AFA.DATAFA < l_datatu OR (R038AFA.DATAFA = l_datatu AND R038AFA.HORAFA <= l_hora_atual)) AND
           (R038AFA.DATTER = l_data_zero OR R038AFA.DATTER > l_datatu OR
           (R038AFA.DATTER = l_datatu AND R038AFA.HORTER >= l_hora_atual) OR
           (R038AFA.DATTER = l_datatu AND R038AFA.HORTER = 0)) AND
            R038AFA.SITAFA = R010SIT.CODSIT AND R010SIT.BLOACE = 'S' AND
            R010SIT.TIPSIT <> 7;
  EXCEPTION
      WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SPFaiHor: Erro em R038AFA - TOO MANY ROWS.';
      WHEN NO_DATA_FOUND THEN l_TemAfa := FALSE;
      WHEN OTHERS        THEN RAISERROR 103 'SPFaihor: Erro no SELECT em R038AFA.';
  END;

  IF  (l_TemAfa = TRUE) THEN
      /* para terceiro turno é inserido afastamento com data inicial zero.  */
      /* neste caso é necessário verificar se já finalizou a jornada para   */
      /* não bloquear o colaborador na saída. se o final da jornado for 1439*/
      /* significa que ele tem faixa de acesso livre e não precisa verificar*/
      /* a jornada.                                                         */

      IF  (l_horafa = 0) THEN
          IF  (l_hora_atual > l_fimjor) OR (l_fimjor = 1439) THEN
              SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);
              IF  (l_datter <> l_data_zero) THEN
                  SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
              ELSE
                  l_fimafa := '311250';
                  l_horter:= 1439;
              END IF;
          END IF;
      ELSE
          IF  (l_datatu > l_datafa) OR (l_datatu = l_datafa AND l_hora_atual >= l_horafa) THEN
              SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);
              IF  (l_datter <> l_data_zero) THEN
                  SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
              ELSE
                  l_fimafa := '311250';
                  l_horter:= 1439;
              END IF;
          END IF;
      END IF;
      /*Hora final 00:00 considerar como 23:59*/
      IF l_horter = 0 THEN
        l_horter:= 1439;
      END IF;
  ELSE
      l_iniafa := '      ';
      l_fimafa := '      ';
      l_horafa := 0;
      l_horter := 0;
  END IF;
  
  IF (l_horafa = 0) THEN
      p_horini:= '0000';
  ELSE
      SP_INTSTR(l_horafa,'HHMM',p_horini OUT);
  END IF;
  IF (l_horter = 0) THEN
      p_horfim:= '0000';
  ELSE
      SP_INTSTR(l_horter,'HHMM',p_horfim OUT);
  END IF;

  p_datini := l_iniafa;
  p_datfim := l_fimafa;

  /* Limpa tabela temporaria R004TMP */
  BEGIN
      DELETE FROM R004TMP WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
      DROP_TEMP_TABLE R004TMP;
  EXCEPTION WHEN OTHERS THEN
      NULL;
  END;  
END		SENIOR;22:RH_DATFIM
SP_GRA004TMP
SP_UNEPRO
SP_INTSTR
SP_DATSTR
r’␀␀


PROCEDURE SP_FAIPRO(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56),P_DATINI OUT VARCHAR2(6),P_DATFIM OUT VARCHAR2(6),P_HORINI OUT VARCHAR2(4),P_HORFIM OUT VARCHAR2(4))
 IS

l_data          DATE;
  l_datini        DATE;
  l_data_limite   DATE;
  l_dia_anterior  DATE;
  l_dia_posterior DATE;
  l_dia_semana  NUMBER(1);
  l_codhor      NUMBER(4);
  l_horant      NUMBER(4);
  l_horref      NUMBER(5);
  l_faiace      VARCHAR2(255);
  l_faipto      VARCHAR2(255);
  l_strini      CHAR(4);
  l_strfim      CHAR(4);
  l_horbat      INTEGER;
  l_total1      NUMBER(5);
  l_iniace      NUMBER(5);
  l_inipto      NUMBER(5);
  l_fimace      NUMBER(5);
  l_fimpto      NUMBER(5);
  l_faidom_ace  VARCHAR(56);
  l_faiseg_ace  VARCHAR(56);
  l_faiter_ace  VARCHAR(56);
  l_faiqua_ace  VARCHAR(56);
  l_faiqui_ace  VARCHAR(56);
  l_faisex_ace  VARCHAR(56);
  l_faisab_ace  VARCHAR(56);
  l_faidom_pto  VARCHAR(56);
  l_faiseg_pto  VARCHAR(56);
  l_faiter_pto  VARCHAR(56);
  l_faiqua_pto  VARCHAR(56);
  l_faiqui_pto  VARCHAR(56);
  l_faisex_pto  VARCHAR(56);
  l_faisab_pto  VARCHAR(56);
  l_contfai     INTEGER;
  l_lengfai     INTEGER;
  l_maxseq      NUMBER(2);
  l_jorhor      CHAR;
  l_hora_atual  NUMBER(4);
  l_datafa      DATE;
  l_datter      DATE;
  l_iniafa      CHAR(6);
  l_fimafa      CHAR(6);
  l_horafa      NUMBER(4);
  l_horter      NUMBER(4);
  l_data_zero   DATE;
  l_datatu      DATE;
  l_datant      DATE;
  l_fimjor      NUMBER;
  l_TemAfa      BOOLEAN;
  l_jorace      NUMBER;
  l_prifxA      NUMBER;
  l_prifxP      NUMBER;
  l_codHorAtu   NUMBER;
  l_numcra      NUMBER(12);
  l_HorIni      NUMBER(4);
  l_HorFim      NUMBER(4);
  l_TipCra      NUMBER(1);
  l_codfil      NUMBER(6);

  /* OBTEM O HORÁRIO DAS ATIVIDADES E DISCIPLINAS DO PROFESSOR */
  CURSOR c_horariosPro IS
  SELECT HORSEG,HORTER,HORQUA,HORQUI,HORSEX,HORSAB,HORDOM
    FROM R171APF
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
      DATINI <= l_data AND ((DATFIM >= l_data) OR (DATFIM = l_data_zero)) UNION ALL
  (SELECT HORSEG,HORTER,HORQUA,HORQUI,HORSEX,HORSAB,HORDOM
    FROM R171DPF
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
      DATINI <= l_data AND ((DATFIM >= l_data) OR (DATFIM = l_data_zero)));
  TYPE t_horariosPro IS RECORD(
      HORSEG   R073ATA.HORSEG%TYPE,
      HORTER   R073ATA.HORTER%TYPE,
      HORQUA   R073ATA.HORQUA%TYPE,
      HORQUI   R073ATA.HORQUI%TYPE,
      HORSEX   R073ATA.HORSEX%TYPE,
      HORSAB   R073ATA.HORSAB%TYPE,
      HORDOM   R073ATA.HORDOM%TYPE);
  l_horariosPro t_horariosPro;


  /* PEGA AS FAIXAS HORARIAS DO HORARIO, AS PROGRAMAÇÕES DE HORAS EXTRAS */
  /* E OS AFASTAMENTOS CUJA ORIGEM FOR SAIDA AUTORIZADA */
  CURSOR c_r004fhr IS
    SELECT CODHOR, SEQFAI, INIACE, FIMACE, INIPTO, FIMPTO
    FROM R004FHR FHR WHERE NOT EXISTS (SELECT 1 FROM R004FHF WHERE R004FHF.CODHOR = FHR.CODHOR AND R004FHF.NUMEMP = p_numemp AND R004FHF.CODFIL = l_codfil) AND
             (FHR.CODHOR = l_codhor)
    UNION(
    SELECT CODHOR, SEQFAI, INIACE, FIMACE, INIPTO, FIMPTO
    FROM R004FHF FHF WHERE FHF.NUMEMP = p_numemp AND FHF.CODFIL = l_codfil AND
             (FHF.CODHOR = l_codhor))   
   ORDER BY 1,2,3,4;

  TYPE t_r004fhr IS RECORD(
    CODHOR   R004FHR.CODHOR%TYPE,
    SEQFAI   R004FHR.SEQFAI%TYPE,
    INIACE   R004FHR.INIACE%TYPE,
    FIMACE   R004FHR.FIMACE%TYPE,
    INIPTO   R004FHR.INIPTO%TYPE,
    FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;


  /* CURSOR DA TABELA TEMPORARIA.. */
  CURSOR c_r004TMP IS
  SELECT DATHOR,TIPFAI,FAIINI,FAIFIM,TURTRB FROM R004TMP WHERE DATHOR = l_data AND NUMEMP = p_numemp AND
         TIPCOL = p_tipcol AND NUMCAD = p_numcad ORDER BY 1,2,3;
  TYPE t_r004TMP IS RECORD(
    DATHOR   R004TMP.DATHOR%TYPE,
    TIPFAI   R004TMP.TIPFAI%TYPE,
    FAIINI   R004TMP.FAIINI%TYPE,
    FAIFIM   R004TMP.FAIFIM%TYPE,
    TURTRB   R004TMP.TURTRB%TYPE);
  l_r004TMP t_r004TMP;

  /*CURSOR para Verificar as Liberações de Faixas Horárias*/
  CURSOR c_r070lfh IS
  SELECT A.NUMCRA, A.DATLIB, A.HORINI, A.HORFIM FROM R070LFH A, R038HCH B
             WHERE
             B.TIPCRA = l_tipcra AND B.STAACC = 1 AND
             A.NUMCRA = B.NUMCRA AND B.NUMEMP = p_numemp AND B.TIPCOL = p_tipcol AND B.NUMCAD = p_numcad AND
             ((B.DATINI < l_datatu) OR (B.DATINI = l_datatu)) AND
             ((B.DATFIM > l_datatu) OR (B.DATFIM = l_datatu) OR B.DATFIM = L_DATA_ZERO) AND
             ((A.DATLIB = l_datatu) OR
              (A.DATLIB = l_datant AND (A.HORINI > A.HORFIM) AND (A.HORFIM > l_hora_atual))
             );
  TYPE t_r070lfh IS RECORD(
    NUMCRA   R070LFH.NUMCRA%TYPE,
    DATLIB   R070LFH.DATLIB%TYPE,
    HORINI   R070LFH.HORINI%TYPE,
    HORFIM   R070LFH.HORFIM%TYPE);
  l_r070lfh t_r070lfh;

  /*Verifica as autorizações de horas extras e saída*/
  CURSOR c_r064xxx IS
  SELECT 2 CODREG, HORINI INIACE,HORFIM FIMACE, HORINI INIPTO, HORFIM FIMPTO, TOLAEA,TOLASA,TOLAEP,TOLASP
  FROM R064EXT
   WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI <= l_data AND DATFIM >= l_data
   UNION
  (SELECT 3 CODREG, HORASA INIACE,HORTER FIMACE, HORASA INIPTO, HORTER FIMPTO, 0 TOLAEA,0 TOLASA,0 TOLAEP,0 TOLASP
    FROM R064ASA
   WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATASA = l_data)
   ORDER BY CODREG,INIACE,FIMACE,INIPTO;
   TYPE t_r064xxx IS RECORD(
    CODREG   R004FHR.CODHOR%TYPE,
    INIACE   R064EXT.HORINI%TYPE,
    FIMACE   R064EXT.HORFIM%TYPE,
    INIPTO   R064EXT.HORINI%TYPE,
    FIMPTO   R064EXT.HORFIM%TYPE,
    TOLAEA   R064EXT.TOLAEA%TYPE,
    TOLASA   R064EXT.TOLASA%TYPE,
    TOLAEP   R064EXT.TOLAEP%TYPE,
    TOLASP   R064EXT.TOLASP%TYPE);
  l_r064xxx t_r064xxx;
  
  /* Declaracao para criar tabela temporária */
  CREATE_TEMP_TABLE R004TMP;

BEGIN

  /* Limpa tabela temporaria R004TMP */
  DELETE FROM R004TMP WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;

  /* Inicializa */
  l_datini := CURDATE();
  /* começar um dia antes em caso de haver 3o. turno. */
  l_datini := DATETIMEADD(DD,-1,l_datini);
  l_data := l_datini;
  l_horant := 0;
  l_faidom_ace  := '';
  l_faiseg_ace  := '';
  l_faiter_ace  := '';
  l_faiqua_ace  := '';
  l_faiqui_ace  := '';
  l_faisex_ace  := '';
  l_faisab_ace  := '';
  l_faidom_pto  := '';
  l_faiseg_pto  := '';
  l_faiter_pto  := '';
  l_faiqua_pto  := '';
  l_faiqui_pto  := '';
  l_faisex_pto  := '';
  l_faisab_pto  := '';
  l_data_zero   := '31/12/1900,00:00:00';
  l_datafa      := '';
  l_datter      := '';
  l_horafa      := 0 ;
  l_iniafa      := '';
  l_fimafa      := '';
  l_datatu      := CURDATE();
  l_hora_atual  := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_fimjor      := 0;
  l_TemAfa      := TRUE;

  RH_DatFim (l_data_limite OUT);

  /* Pega o codigo da filial */
  BEGIN
      SELECT HFI.CODFIL INTO l_codfil FROM R038HFI HFI WHERE
             HFI.NUMEMP = p_numemp AND HFI.TIPCOL = p_tipcol AND HFI.NUMCAD = p_numcad AND
             HFI.DATALT = (SELECT MAX(HFI2.DATALT) FROM R038HFI HFI2
                             WHERE HFI2.NUMEMP = p_numemp AND HFI2.TIPCOL = p_tipcol AND HFI2.NUMCAD = p_numcad AND HFI2.DATALT <= CURDATE());
  EXCEPTION
      WHEN OTHERS THEN l_codfil := 0;
  END;

  LOOP
    l_faiace := '';
    l_faipto := '';

    l_dia_anterior := DATETIMEADD(DD, -1, l_data);
    l_dia_posterior := DATETIMEADD(DD, 1, l_data);

    FOREACH c_horariosPro INTO l_horariosPro.horseg,
                               l_horariosPro.horter,
                               l_horariosPro.horqua,
                               l_horariosPro.horqui,
                               l_horariosPro.horsex,
                               l_horariosPro.horsab,
                               l_horariosPro.hordom
    LOOP
        /*Verifica qual o dia da semana atual para pegar o horário correspondente*/
        l_dia_semana  := DAYOFWEEK(l_data);
        IF    l_dia_semana = 1 THEN /* domingo */
            l_codhor := l_horariosPro.hordom;
        ELSIF l_dia_semana = 2 THEN /* segunda */
            l_codhor := l_horariosPro.horseg;
        ELSIF l_dia_semana = 3 THEN /* terca */
            l_codhor := l_horariosPro.horter;
        ELSIF l_dia_semana = 4 THEN /* quarta */
            l_codhor := l_horariosPro.horqua;
        ELSIF l_dia_semana = 5 THEN /* quinta */
            l_codhor := l_horariosPro.horqui;
        ELSIF l_dia_semana = 6 THEN /* sexta */
            l_codhor := l_horariosPro.horsex;
        ELSE
            l_codhor := l_horariosPro.horsab;
        END IF;

        BEGIN
            SELECT MAX(SEQFAI) INTO l_maxseq FROM R004FHR WHERE CODHOR = l_codhor;
        EXCEPTION WHEN OTHERS THEN
            l_maxseq := 1;
        END;
        l_prifxA    := 0;
        l_prifxP    := 0;
        l_codHorAtu := 0;


        FOREACH c_r004fhr INTO l_r004fhr.codhor,
                               l_r004fhr.seqfai,
                               l_r004fhr.iniace,
                               l_r004fhr.fimace,
                               l_r004fhr.inipto,
                               l_r004fhr.fimpto
        LOOP
            /* se for um registro de faixa horaria. */
            l_iniace := l_r004fhr.iniace;
            l_fimace := l_r004fhr.fimace;
            l_inipto := l_r004fhr.inipto;
            l_fimpto := l_r004fhr.fimpto;

            l_horbat  := -1;

            /* pega a primeira hora do horario */
            BEGIN
              SELECT HORBAT INTO l_horbat FROM R004MHR WHERE CODHOR = l_r004fhr.codhor AND SEQMAR = 1;
            EXCEPTION
              WHEN TOO_MANY_ROWS THEN
                  RAISERROR 103 'SP_Faihor: Erro No SELECT R004MHR (TOO_MANY_ROWS).';
              WHEN NO_DATA_FOUND THEN /* no caso dos horários 9997 e 9998 */
                  l_horbat := -1;
              WHEN OTHERS THEN
                  RAISERROR 103 'SP_Faihor: Erro No SELECT R004MHR.';
            END;

            /* verifica o tipo de jornada do horario. */
            /* Pela Saída atualiza próximo dia, Pela Entrada atualiza dia anterior */
            BEGIN
              SELECT JORHOR, JORACE INTO l_jorhor, l_jorace FROM R004HOR WHERE CODHOR = l_r004fhr.codhor;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'RH_Faihor: Erro No SELECT R004HOR.';
            END;
            /* salva o valor da primeira faixa do horáio para ser verificado quando for 3º turno */
            IF  l_r004fhr.codhor <> l_codhoratu THEN
                l_prifxA    := l_iniace;
                l_priFxP    := l_inipto;
                l_codHorAtu := l_r004fhr.codhor;
            END IF;

            IF  (l_r004fhr.iniace = 0) AND (l_r004fhr.fimace = 0) THEN
                NULL;
            ELSE
                /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
                IF   (l_r004fhr.iniace > l_r004fhr.fimace) THEN
                     /* tipo de jornada pela Saída ou Hora da batida as 00:00 a faixa começa no dia anterior. */
                     /* tipo de jornada pela Entrada a faixa termina no próximo dia. */
                     IF  (l_jorhor = 'S') OR (l_horbat = 0) THEN
                         IF  (l_horant <> 0) THEN
                             IF l_r004fhr.fimace = 0 THEN
                                  SP_GRA004TMP(l_data, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                  SP_GRA004TMP(l_dia_anterior, 'A', l_r004fhr.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             END IF;

                             IF  l_r004fhr.fimace > 0 THEN
                                 SP_GRA004TMP(l_data, 'A', 0, l_r004fhr.fimace , 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         SP_GRA004TMP(l_data, 'A', l_r004fhr.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                         IF   l_r004fhr.fimace > 0 THEN
                             SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r004fhr.fimace ,3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     END IF;
                ELSE
                     /* 3º turno com intervalos nas faixas                            */
                     /* será verificado se a faixa atual é menor que a primeira faixa */
                     /* neste caso a faixa atual diz respeito ao próximo dia          */
                     IF (l_jorace = 3) THEN
                         IF  l_iniace < l_prifxA THEN
                             IF  (l_jorhor = 'E') THEN
                                 SP_GRA004TMP(l_dia_posterior, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         ELSE
                             /* primeiro horário da faixa */
                             IF  (l_jorhor = 'S') THEN
                                 SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         /* horário turno 1 (inicia e finaliza no mesmo dia) */
                         SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                     END IF;
                END IF;
            END IF;

            IF  (l_r004fhr.inipto = 0) AND (l_r004fhr.fimpto = 0) THEN
                NULL;
            ELSE
                /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
                IF   (l_r004fhr.inipto > l_r004fhr.fimpto) THEN
                     /* se a faixa finaliza no próximo dia */
                     IF  (l_jorhor = 'S') OR (l_horbat = 0) THEN
                         IF  (l_horant <> 0) THEN

                             IF l_r004fhr.fimpto = 0 THEN
                                  SP_GRA004TMP(l_data, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                  SP_GRA004TMP(l_dia_anterior, 'P', l_r004fhr.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;

                         IF   l_r004fhr.fimpto > 0 THEN
                             SP_GRA004TMP(l_data, 'P', 0, l_r004fhr.fimpto , 3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     ELSE

                         SP_GRA004TMP(l_data, 'P', l_r004fhr.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                         IF   l_r004fhr.fimpto > 0 THEN
                              SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r004fhr.fimpto ,3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     END IF;
                ELSE
                     /* 3º turno com intervalos nas faixas                            */
                     /* será verificado se a faixa atual é menor que a primeira faixa */
                     /* neste caso a faixa atual diz respeito ao próximo dia          */ 
                     IF (l_jorace = 3) THEN
                         IF  l_inipto < l_prifxP THEN
                             IF  (l_jorhor = 'E') THEN
                                 SP_GRA004TMP(l_dia_posterior, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         ELSE
                             /* primeiro horário da faixa */
                             IF  (l_jorhor = 'S') THEN
                                 SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         /* horário turno 1 (inicia e finaliza no mesmo dia) */
                         SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                     END IF;
                END IF;
            END IF;
        END LOOP;

        /* salva o valor do horário anterior */
        l_horant := l_codhor;

    END LOOP;  /*Loop R171APF e R171DPF*/

    /*Processa as autorizações de horas extras e saída*/
    FOREACH c_r064XXX INTO l_r064xxx.codreg,
                           l_r064xxx.iniace,
                           l_r064xxx.fimace,
                           l_r064xxx.inipto,
                           l_r064xxx.fimpto,
                           l_r064xxx.tolaea,
                           l_r064xxx.tolasa,
                           l_r064xxx.tolaep,
                           l_r064xxx.tolasp
    LOOP
        /* Inicializações */
        l_iniace := l_r064xxx.iniace;
        l_fimace := l_r064xxx.fimace;
        l_inipto := l_r064xxx.inipto;
        l_fimpto := l_r064xxx.fimpto;

        IF  (l_r064xxx.iniace = 0) AND (l_r064xxx.fimace = 0) THEN
            NULL;
        ELSE
            /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
            IF   (l_r064xxx.iniace > l_r064xxx.fimace) THEN
                IF  (l_r064xxx.codreg = 2) THEN
                    IF  l_r064xxx.tolaea > 0 THEN
                        IF   l_r064xxx.tolaea < l_r064xxx.iniace THEN
                             l_iniace := l_r064xxx.iniace - l_r064xxx.tolaea;
                        ELSE l_iniace := 1440 - l_r064xxx.tolaea + l_r064xxx.iniace;
                             SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             l_iniace := 0;
                        END IF;
                    END IF;
                    IF  l_r064xxx.tolasa > 0 THEN
                        l_total1 := l_r064xxx.fimace + l_r064xxx.tolasa;
                        IF l_r064xxx.fimace = 0 THEN
                             l_total1 := l_total1 + 1440;
                        END IF;
                        IF   l_total1 < 1439 THEN
                             l_fimace := l_total1;
                        ELSE
                             l_fimace := l_total1 - 1440;
                             SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                             l_fimace := 1439;
                        END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimace > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                ELSE
                    /*Autorização de saida*/
                    SP_GRA004TMP(l_data, 'A', l_r064xxx.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimace > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r064xxx.fimace ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                END IF;
            ELSE
                /* se for registro de programação de horas extras ver tolerancias */
                IF  l_r064xxx.codreg = 2 THEN
                    IF  l_r064xxx.tolaea > 0 THEN
                       IF   l_r064xxx.tolaea < l_r064xxx.iniace THEN
                            l_iniace := l_r064xxx.iniace - l_r064xxx.tolaea;
                       ELSE l_iniace := 1440 - l_r064xxx.tolaea + l_r064xxx.iniace;
                            SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                            l_iniace := 0;
                       END IF;
                    END IF;

                    /* se tolerancia para acesso for maior que 0 */
                    IF  l_r064xxx.tolasa > 0 THEN
                       l_total1 := l_r064xxx.fimace + l_r064xxx.tolasa;
                       IF l_r064xxx.fimace = 0 THEN
                            l_total1 := l_total1 + 1440;
                       END IF;
                       IF   l_total1 < 1439 THEN
                            l_fimace := l_total1;
                       ELSE
                            l_fimace := l_total1 - 1440;
                            SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                            l_fimace := 1439;
                       END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);

                ELSE
                    /*Autorização de Acesso*/
                    SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                END IF;
            END IF;
        END IF;

        IF  (l_r064xxx.inipto = 0) AND (l_r064xxx.fimpto = 0) THEN
            NULL;
        ELSE
            /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
            IF   (l_r064xxx.inipto > l_r064xxx.fimpto) THEN
                IF  (l_r064xxx.codreg = 2) THEN
                    IF  l_r064xxx.tolaep > 0 THEN
                        IF   l_r064xxx.tolaep < l_r064xxx.inipto THEN
                             l_inipto := l_r064xxx.inipto - l_r064xxx.tolaep;
                        ELSE l_inipto := 1440 - l_r064xxx.tolaep + l_r064xxx.inipto;
                             SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             l_inipto := 0;
                        END IF;
                    END IF;
                    IF  l_r064xxx.tolasp > 0 THEN
                        l_total1 := l_r064xxx.fimpto + l_r064xxx.tolasp;
                        IF l_r064xxx.fimpto = 0 THEN
                             l_total1 := l_total1 + 1440;
                        END IF;
                        IF   l_total1 < 1439 THEN
                             l_fimpto := l_total1;
                        ELSE
                             l_fimpto := l_total1 - 1440;
                             SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                             l_fimpto := 1439;
                        END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimpto > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;

                ELSE
                    /*Autorização de Saída*/
                    SP_GRA004TMP(l_data, 'P', l_r064xxx.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimpto > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r064xxx.fimpto ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                END IF;
            ELSE
                /* se for registro de programação de horas extras ver tolerancias */
                IF  l_r064xxx.codreg = 2 THEN
                    /* se tolerancia para ponto for maior que 0 */
                    IF  l_r064xxx.tolaep > 0 THEN
                       IF   l_r064xxx.tolaep < l_r064xxx.inipto THEN
                            l_inipto := l_r064xxx.inipto - l_r064xxx.tolaep;
                       ELSE l_inipto := 1440 - l_r064xxx.tolaep + l_r064xxx.inipto;
                            SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                            l_inipto := 0;
                       END IF;
                    END IF;

                    /* se tolerancia para ponto for maior que 0 */
                    IF  l_r064xxx.tolasp > 0 THEN
                       l_total1 := l_r064xxx.fimpto + l_r064xxx.tolasp;
                       IF   l_total1 < 1439 THEN
                            l_fimpto := l_total1;
                       ELSE
                            l_fimpto := l_total1 - 1440;
                            SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                            l_fimpto := 1439;
                       END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                ELSE
                    SP_GRA004TMP(l_data, 'P', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                END IF;
            END IF;
        END IF;
    END LOOP; 

    /* Condicao p/ Controle LOOP. Deve estar antes de incrementar a data, pois deve percorrer um dia a mais. */
    /* Motivo para isso é quando o proximo dia inicia no dia anterior. */
    IF   (l_data > l_data_limite) THEN
         EXIT;
    END IF;

    /* Incremento p/ Controle LOOP */
    l_data := DATETimeAdd(DD,1,l_data);
  END LOOP;

  l_data := CURDATE();

  l_datatu        := CURDATE();
  l_datant        := DATETIMEADD(DD, -1, l_datatu);
  l_dia_posterior := DATETIMEADD(DD, 1, l_datatu);
  l_hora_atual    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  /* verifica liberação da faixa horária (R070LFH) */
  l_numcra:= 0;
  l_tipcra:= 2;

  /*Verifica Liberação de Faixa Horária para Crachá Provisório*/
  FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM
  LOOP
          /* para data atual, verifica se hora termina no dia ou no próximo dia */
          IF  (l_r070lfh.datlib = l_datatu) THEN
              IF (l_r070lfh.HORFIM < l_r070lfh.HORINI) THEN
                  /*termina no outro dia*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);

                  SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              ELSE
                  /*termina no dia atual*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              END IF;
          ELSE
              /* para o dia anteior, então libera da hora zero até a hora final*/
              SP_GRA004TMP(l_datatu, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              SP_GRA004TMP(l_datatu, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
          END IF;

          l_numcra := l_r070lfh.NUMCRA;
  END LOOP;
  /*Se não encontrou, Verifica Liberação de Faixa Horária para o Crachá do Titular*/
  IF  (l_NumCra = 0) THEN
      l_tipcra := 1;
      FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM
      LOOP
          /* para data atual, verifica se hora termina no dia ou no próximo dia */
          IF  (l_r070lfh.datlib = l_datatu) THEN
              IF (l_r070lfh.HORFIM < l_r070lfh.HORINI) THEN
                  /*termina no outro dia*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);

                  SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              ELSE
                  /*termina no dia atual*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              END IF;
          ELSE
              /* para o dia anteior, então libera da hora zero até a hora final*/
              SP_GRA004TMP(l_datatu, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              SP_GRA004TMP(l_datatu, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
          END IF;
      END LOOP;
  END IF;

  /* calcula faixas que estão no mesmo período */
  SP_UnePro(l_datini, l_data_limite,'A', p_numemp, p_tipcol, p_numcad);
  SP_UnePro(l_datini, l_data_limite,'P', p_numemp, p_tipcol, p_numcad);

  LOOP
    l_faiace := '';
    l_faipto := '';

    FOREACH c_r004TMP INTO l_r004TMP.DatHor,
                           l_r004TMP.TipFai,
                           l_r004TMP.FaiIni,
                           l_r004TMP.FaiFim,
                           l_r004TMP.TurTrb

    LOOP
      /* SE TIVER MOBILIDADE DE HORARIO ENTAO CONSIDERA-LA.*/
      SP_INTSTR(l_r004tmp.FaiIni,'HHMM',l_strini OUT);
      SP_INTSTR(l_r004tmp.FaiFim,'HHMM',l_strfim OUT);
      IF  l_r004TMP.TipFai = 'A' THEN
          l_faiace := l_faiace || l_strini || l_strfim;
      END IF;
      IF  l_r004TMP.TipFai = 'P' THEN
          l_faipto := l_faipto || l_strini || l_strfim;
      END IF;

      /* verifica último turno para afastamento (final jornada = maior horario do 3º turno).*/
      IF  (l_r004TMP.DatHor = l_datatu) AND
          (l_r004TMP.TurTrb = 3)        AND
          (l_fimjor < l_r004TMP.FaiFim) AND
          (l_r004TMP.tipfai = 'A')      THEN
          l_fimjor := l_r004TMP.FaiFim;
      END IF;

    END LOOP;

    /* PREENCHE O RESTO DO CAMPO COM 2400 */
    l_faiace := IFNULL(l_faiace,'');
    IF (l_faiace IS NULL) OR (l_faiace = '0') OR (l_faiace = '') THEN
      l_lengfai := 7;
      l_faiace :='';
    ELSE
      l_lengfai := (56 - LENGTH(l_faiace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
      l_faiace := l_faiace || '24002400';
      l_contfai := l_contfai + 1;
      IF (l_contfai >= l_lengfai) THEN
        EXIT;
      END IF;
    END LOOP;
    /* PREENCHE O RESTO DO CAMPO COM 2400 */
    l_faipto := IFNULL(l_faipto,'');
    IF (l_faipto IS NULL) OR (l_faipto = '0') OR (l_faipto = '') THEN
      l_lengfai := 7;
      l_faipto := '';
    ELSE
      l_lengfai := (56 - LENGTH(l_faipto)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
      l_faipto := l_faipto || '24002400';
      l_contfai := l_contfai + 1;
      IF (l_contfai >= l_lengfai) THEN
        EXIT;
      END IF;
    END LOOP;


    l_faiace     := SUBSTRING(l_faiace,1,56);
    l_faipto     := SUBSTRING(l_faipto,1,56);
    l_dia_semana := DAYOFWEEK(l_data);
    IF    l_dia_semana = 1 THEN /* domingo */
          l_faidom_ace := l_faiace;
          l_faidom_pto := l_faipto;
    ELSIF l_dia_semana = 2 THEN /* segunda */
          l_faiseg_ace := l_faiace;
          l_faiseg_pto := l_faipto;
    ELSIF l_dia_semana = 3 THEN /* terca */
          l_faiter_ace := l_faiace;
          l_faiter_pto := l_faipto;
    ELSIF l_dia_semana = 4 THEN /* quarta */
          l_faiqua_ace := l_faiace;
          l_faiqua_pto := l_faipto;
    ELSIF l_dia_semana = 5 THEN /* quinta */
          l_faiqui_ace := l_faiace;
          l_faiqui_pto := l_faipto;
    ELSIF l_dia_semana = 6 THEN /* sexta */
          l_faisex_ace := l_faiace;
          l_faisex_pto := l_faipto;
    ELSE  l_faisab_ace := l_faiace;
          l_faisab_pto := l_faipto;
    END IF;

    /* Incremento p/ Controle LOOP */
    l_data := DATETimeAdd(DD,1,l_data);
    IF   (l_data > l_data_limite) THEN
         EXIT;
    END IF;
  END LOOP;

  /* monta a faixa do refeitorio que deve sempre comecar pelo domingo. */
  p_fairef := '24002400240024002400240024002400240024002400240024002400';

  l_faidom_ace := SUBSTRING(l_faidom_ace,1,56);
  l_faiseg_ace := SUBSTRING(l_faiseg_ace,1,56);
  l_faiter_ace := SUBSTRING(l_faiter_ace,1,56);
  l_faiqua_ace := SUBSTRING(l_faiqua_ace,1,56);
  l_faiqui_ace := SUBSTRING(l_faiqui_ace,1,56);
  l_faisex_ace := SUBSTRING(l_faisex_ace,1,56);
  l_faisab_ace := SUBSTRING(l_faisab_ace,1,56);
  l_faidom_pto := SUBSTRING(l_faidom_pto,1,56);
  l_faiseg_pto := SUBSTRING(l_faiseg_pto,1,56);
  l_faiter_pto := SUBSTRING(l_faiter_pto,1,56);
  l_faiqua_pto := SUBSTRING(l_faiqua_pto,1,56);
  l_faiqui_pto := SUBSTRING(l_faiqui_pto,1,56);
  l_faisex_pto := SUBSTRING(l_faisex_pto,1,56);
  l_faisab_pto := SUBSTRING(l_faisab_pto,1,56);
  p_faidom_ace  := l_faidom_ace;
  p_faiseg_ace  := l_faiseg_ace;
  p_faiter_ace  := l_faiter_ace;
  p_faiqua_ace  := l_faiqua_ace;
  p_faiqui_ace  := l_faiqui_ace;
  p_faisex_ace  := l_faisex_ace;
  p_faisab_ace  := l_faisab_ace;
  p_faidom_pto  := l_faidom_pto;
  p_faiseg_pto  := l_faiseg_pto;
  p_faiter_pto  := l_faiter_pto;
  p_faiqua_pto  := l_faiqua_pto;
  p_faiqui_pto  := l_faiqui_pto;
  p_faisex_pto  := l_faisex_pto;
  p_faisab_pto  := l_faisab_pto; 
  /* Atualiza Afastamentos */
  BEGIN
      SELECT R038AFA.DATAFA, R038AFA.HORAFA, R038AFA.DATTER, R038AFA.HORTER
      INTO l_datafa, l_horafa, l_datter, l_horter
      FROM R010SIT,R038AFA
      WHERE R038AFA.NUMEMP = p_numemp AND R038AFA.TIPCOL = p_tipcol AND R038AFA.NUMCAD = p_numcad AND
           (R038AFA.DATAFA < l_datatu OR (R038AFA.DATAFA = l_datatu AND R038AFA.HORAFA <= l_hora_atual)) AND
           (R038AFA.DATTER = l_data_zero OR R038AFA.DATTER > l_datatu OR
           (R038AFA.DATTER = l_datatu AND R038AFA.HORTER >= l_hora_atual) OR
           (R038AFA.DATTER = l_datatu AND R038AFA.HORTER = 0)) AND
            R038AFA.SITAFA = R010SIT.CODSIT AND R010SIT.BLOACE = 'S' AND
            R010SIT.TIPSIT <> 7;
  EXCEPTION
      WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SPFaiHor: Erro em R038AFA - TOO MANY ROWS.';
      WHEN NO_DATA_FOUND THEN l_TemAfa := FALSE;
      WHEN OTHERS        THEN RAISERROR 103 'SPFaihor: Erro no SELECT em R038AFA.';
  END;

  IF  (l_TemAfa = TRUE) THEN
      /* para terceiro turno é inserido afastamento com data inicial zero.  */
      /* neste caso é necessário verificar se já finalizou a jornada para   */
      /* não bloquear o colaborador na saída. se o final da jornado for 1439*/
      /* significa que ele tem faixa de acesso livre e não precisa verificar*/
      /* a jornada.                                                         */

      IF  (l_horafa = 0) THEN
          IF  (l_hora_atual > l_fimjor) OR (l_fimjor = 1439) THEN
              SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);
              IF  (l_datter <> l_data_zero) THEN
                  SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
              ELSE
                  l_fimafa := '311250';
                  l_horter:= 1439;
              END IF;
          END IF;
      ELSE
          IF  (l_datatu > l_datafa) OR (l_datatu = l_datafa AND l_hora_atual >= l_horafa) THEN
              SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);
              IF  (l_datter <> l_data_zero) THEN
                  SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
              ELSE
                  l_fimafa := '311250';
                  l_horter:= 1439;
              END IF;
          END IF;
      END IF;
      /*Hora final 00:00 considerar como 23:59*/
      IF l_horter = 0 THEN
        l_horter:= 1439;
      END IF;
  ELSE
      l_iniafa := '      ';
      l_fimafa := '      ';
      l_horafa := 0;
      l_horter := 0;
  END IF;
  
  IF (l_horafa = 0) THEN
      p_horini:= '0000';
  ELSE
      SP_INTSTR(l_horafa,'HHMM',p_horini OUT);
  END IF;
  IF (l_horter = 0) THEN
      p_horfim:= '0000';
  ELSE
      SP_INTSTR(l_horter,'HHMM',p_horfim OUT);
  END IF;

  p_datini := l_iniafa;
  p_datfim := l_fimafa;

  /* Limpa tabela temporaria R004TMP */
  BEGIN
      DELETE FROM R004TMP WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
      DROP_TEMP_TABLE R004TMP;
  EXCEPTION WHEN OTHERS THEN
      NULL;
  END;  
END		SENIOR;23:RH_DATFIM
SP_GRA004TMP
SP_UNEPRO
SP_INTSTR
SP_DATSTR
r’␀␀


PROCEDURE SP_FAIPRO(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56),P_DATINI OUT VARCHAR2(6),P_DATFIM OUT VARCHAR2(6),P_HORINI OUT VARCHAR2(4),P_HORFIM OUT VARCHAR2(4))
 IS

l_data          DATE;
  l_datini        DATE;
  l_data_limite   DATE;
  l_dia_anterior  DATE;
  l_dia_posterior DATE;
  l_dia_semana  NUMBER(1);
  l_codhor      NUMBER(4);
  l_horant      NUMBER(4);
  l_horref      NUMBER(5);
  l_faiace      VARCHAR2(255);
  l_faipto      VARCHAR2(255);
  l_strini      CHAR(4);
  l_strfim      CHAR(4);
  l_horbat      INTEGER;
  l_total1      NUMBER(5);
  l_iniace      NUMBER(5);
  l_inipto      NUMBER(5);
  l_fimace      NUMBER(5);
  l_fimpto      NUMBER(5);
  l_faidom_ace  VARCHAR(56);
  l_faiseg_ace  VARCHAR(56);
  l_faiter_ace  VARCHAR(56);
  l_faiqua_ace  VARCHAR(56);
  l_faiqui_ace  VARCHAR(56);
  l_faisex_ace  VARCHAR(56);
  l_faisab_ace  VARCHAR(56);
  l_faidom_pto  VARCHAR(56);
  l_faiseg_pto  VARCHAR(56);
  l_faiter_pto  VARCHAR(56);
  l_faiqua_pto  VARCHAR(56);
  l_faiqui_pto  VARCHAR(56);
  l_faisex_pto  VARCHAR(56);
  l_faisab_pto  VARCHAR(56);
  l_contfai     INTEGER;
  l_lengfai     INTEGER;
  l_maxseq      NUMBER(2);
  l_jorhor      CHAR;
  l_hora_atual  NUMBER(4);
  l_datafa      DATE;
  l_datter      DATE;
  l_iniafa      CHAR(6);
  l_fimafa      CHAR(6);
  l_horafa      NUMBER(4);
  l_horter      NUMBER(4);
  l_data_zero   DATE;
  l_datatu      DATE;
  l_datant      DATE;
  l_fimjor      NUMBER;
  l_TemAfa      BOOLEAN;
  l_jorace      NUMBER;
  l_prifxA      NUMBER;
  l_prifxP      NUMBER;
  l_codHorAtu   NUMBER;
  l_numcra      NUMBER(12);
  l_HorIni      NUMBER(4);
  l_HorFim      NUMBER(4);
  l_TipCra      NUMBER(1);
  l_codfil      NUMBER(6);

  /* OBTEM O HORÁRIO DAS ATIVIDADES E DISCIPLINAS DO PROFESSOR */
  CURSOR c_horariosPro IS
  SELECT HORSEG,HORTER,HORQUA,HORQUI,HORSEX,HORSAB,HORDOM
    FROM R171APF
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
      DATINI <= l_data AND ((DATFIM >= l_data) OR (DATFIM = l_data_zero)) UNION ALL
  (SELECT HORSEG,HORTER,HORQUA,HORQUI,HORSEX,HORSAB,HORDOM
    FROM R171DPF
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
      DATINI <= l_data AND ((DATFIM >= l_data) OR (DATFIM = l_data_zero)));
  TYPE t_horariosPro IS RECORD(
      HORSEG   R073ATA.HORSEG%TYPE,
      HORTER   R073ATA.HORTER%TYPE,
      HORQUA   R073ATA.HORQUA%TYPE,
      HORQUI   R073ATA.HORQUI%TYPE,
      HORSEX   R073ATA.HORSEX%TYPE,
      HORSAB   R073ATA.HORSAB%TYPE,
      HORDOM   R073ATA.HORDOM%TYPE);
  l_horariosPro t_horariosPro;


  /* PEGA AS FAIXAS HORARIAS DO HORARIO, AS PROGRAMAÇÕES DE HORAS EXTRAS */
  /* E OS AFASTAMENTOS CUJA ORIGEM FOR SAIDA AUTORIZADA */
  CURSOR c_r004fhr IS
    SELECT CODHOR, SEQFAI, INIACE, FIMACE, INIPTO, FIMPTO
    FROM R004FHR FHR WHERE NOT EXISTS (SELECT 1 FROM R004FHF WHERE R004FHF.CODHOR = FHR.CODHOR AND R004FHF.NUMEMP = p_numemp AND R004FHF.CODFIL = l_codfil) AND
             (FHR.CODHOR = l_codhor)
    UNION(
    SELECT CODHOR, SEQFAI, INIACE, FIMACE, INIPTO, FIMPTO
    FROM R004FHF FHF WHERE FHF.NUMEMP = p_numemp AND FHF.CODFIL = l_codfil AND
             (FHF.CODHOR = l_codhor))   
   ORDER BY 1,2,3,4;

  TYPE t_r004fhr IS RECORD(
    CODHOR   R004FHR.CODHOR%TYPE,
    SEQFAI   R004FHR.SEQFAI%TYPE,
    INIACE   R004FHR.INIACE%TYPE,
    FIMACE   R004FHR.FIMACE%TYPE,
    INIPTO   R004FHR.INIPTO%TYPE,
    FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;


  /* CURSOR DA TABELA TEMPORARIA.. */
  CURSOR c_r004TMP IS
  SELECT DATHOR,TIPFAI,FAIINI,FAIFIM,TURTRB FROM R004TMP WHERE DATHOR = l_data AND NUMEMP = p_numemp AND
         TIPCOL = p_tipcol AND NUMCAD = p_numcad ORDER BY 1,2,3;
  TYPE t_r004TMP IS RECORD(
    DATHOR   R004TMP.DATHOR%TYPE,
    TIPFAI   R004TMP.TIPFAI%TYPE,
    FAIINI   R004TMP.FAIINI%TYPE,
    FAIFIM   R004TMP.FAIFIM%TYPE,
    TURTRB   R004TMP.TURTRB%TYPE);
  l_r004TMP t_r004TMP;

  /*CURSOR para Verificar as Liberações de Faixas Horárias*/
  CURSOR c_r070lfh IS
  SELECT A.NUMCRA, A.DATLIB, A.HORINI, A.HORFIM FROM R070LFH A, R038HCH B
             WHERE
             B.TIPCRA = l_tipcra AND B.STAACC = 1 AND
             A.NUMCRA = B.NUMCRA AND B.NUMEMP = p_numemp AND B.TIPCOL = p_tipcol AND B.NUMCAD = p_numcad AND
             ((B.DATINI < l_datatu) OR (B.DATINI = l_datatu)) AND
             ((B.DATFIM > l_datatu) OR (B.DATFIM = l_datatu) OR B.DATFIM = L_DATA_ZERO) AND
             ((A.DATLIB = l_datatu) OR
              (A.DATLIB = l_datant AND (A.HORINI > A.HORFIM) AND (A.HORFIM > l_hora_atual))
             );
  TYPE t_r070lfh IS RECORD(
    NUMCRA   R070LFH.NUMCRA%TYPE,
    DATLIB   R070LFH.DATLIB%TYPE,
    HORINI   R070LFH.HORINI%TYPE,
    HORFIM   R070LFH.HORFIM%TYPE);
  l_r070lfh t_r070lfh;

  /*Verifica as autorizações de horas extras e saída*/
  CURSOR c_r064xxx IS
  SELECT 2 CODREG, HORINI INIACE,HORFIM FIMACE, HORINI INIPTO, HORFIM FIMPTO, TOLAEA,TOLASA,TOLAEP,TOLASP
  FROM R064EXT
   WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI <= l_data AND DATFIM >= l_data
   UNION
  (SELECT 3 CODREG, HORASA INIACE,HORTER FIMACE, HORASA INIPTO, HORTER FIMPTO, 0 TOLAEA,0 TOLASA,0 TOLAEP,0 TOLASP
    FROM R064ASA
   WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATASA = l_data)
   ORDER BY CODREG,INIACE,FIMACE,INIPTO;
   TYPE t_r064xxx IS RECORD(
    CODREG   R004FHR.CODHOR%TYPE,
    INIACE   R064EXT.HORINI%TYPE,
    FIMACE   R064EXT.HORFIM%TYPE,
    INIPTO   R064EXT.HORINI%TYPE,
    FIMPTO   R064EXT.HORFIM%TYPE,
    TOLAEA   R064EXT.TOLAEA%TYPE,
    TOLASA   R064EXT.TOLASA%TYPE,
    TOLAEP   R064EXT.TOLAEP%TYPE,
    TOLASP   R064EXT.TOLASP%TYPE);
  l_r064xxx t_r064xxx;
  
  /* Declaracao para criar tabela temporária */
  CREATE_TEMP_TABLE R004TMP;

BEGIN

  /* Limpa tabela temporaria R004TMP */
  DELETE FROM R004TMP WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;

  /* Inicializa */
  l_datini := CURDATE();
  /* começar um dia antes em caso de haver 3o. turno. */
  l_datini := DATETIMEADD(DD,-1,l_datini);
  l_data := l_datini;
  l_horant := 0;
  l_faidom_ace  := '';
  l_faiseg_ace  := '';
  l_faiter_ace  := '';
  l_faiqua_ace  := '';
  l_faiqui_ace  := '';
  l_faisex_ace  := '';
  l_faisab_ace  := '';
  l_faidom_pto  := '';
  l_faiseg_pto  := '';
  l_faiter_pto  := '';
  l_faiqua_pto  := '';
  l_faiqui_pto  := '';
  l_faisex_pto  := '';
  l_faisab_pto  := '';
  l_data_zero   := '31/12/1900,00:00:00';
  l_datafa      := '';
  l_datter      := '';
  l_horafa      := 0 ;
  l_iniafa      := '';
  l_fimafa      := '';
  l_datatu      := CURDATE();
  l_hora_atual  := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_fimjor      := 0;
  l_TemAfa      := TRUE;

  RH_DatFim (l_data_limite OUT);

  /* Pega o codigo da filial */
  BEGIN
      SELECT HFI.CODFIL INTO l_codfil FROM R038HFI HFI WHERE
             HFI.NUMEMP = p_numemp AND HFI.TIPCOL = p_tipcol AND HFI.NUMCAD = p_numcad AND
             HFI.DATALT = (SELECT MAX(HFI2.DATALT) FROM R038HFI HFI2
                             WHERE HFI2.NUMEMP = p_numemp AND HFI2.TIPCOL = p_tipcol AND HFI2.NUMCAD = p_numcad AND HFI2.DATALT <= CURDATE());
  EXCEPTION
      WHEN OTHERS THEN l_codfil := 0;
  END;

  LOOP
    l_faiace := '';
    l_faipto := '';

    l_dia_anterior := DATETIMEADD(DD, -1, l_data);
    l_dia_posterior := DATETIMEADD(DD, 1, l_data);

    FOREACH c_horariosPro INTO l_horariosPro.horseg,
                               l_horariosPro.horter,
                               l_horariosPro.horqua,
                               l_horariosPro.horqui,
                               l_horariosPro.horsex,
                               l_horariosPro.horsab,
                               l_horariosPro.hordom
    LOOP
        /*Verifica qual o dia da semana atual para pegar o horário correspondente*/
        l_dia_semana  := DAYOFWEEK(l_data);
        IF    l_dia_semana = 1 THEN /* domingo */
            l_codhor := l_horariosPro.hordom;
        ELSIF l_dia_semana = 2 THEN /* segunda */
            l_codhor := l_horariosPro.horseg;
        ELSIF l_dia_semana = 3 THEN /* terca */
            l_codhor := l_horariosPro.horter;
        ELSIF l_dia_semana = 4 THEN /* quarta */
            l_codhor := l_horariosPro.horqua;
        ELSIF l_dia_semana = 5 THEN /* quinta */
            l_codhor := l_horariosPro.horqui;
        ELSIF l_dia_semana = 6 THEN /* sexta */
            l_codhor := l_horariosPro.horsex;
        ELSE
            l_codhor := l_horariosPro.horsab;
        END IF;

        BEGIN
            SELECT MAX(SEQFAI) INTO l_maxseq FROM R004FHR WHERE CODHOR = l_codhor;
        EXCEPTION WHEN OTHERS THEN
            l_maxseq := 1;
        END;
        l_prifxA    := 0;
        l_prifxP    := 0;
        l_codHorAtu := 0;


        FOREACH c_r004fhr INTO l_r004fhr.codhor,
                               l_r004fhr.seqfai,
                               l_r004fhr.iniace,
                               l_r004fhr.fimace,
                               l_r004fhr.inipto,
                               l_r004fhr.fimpto
        LOOP
            /* se for um registro de faixa horaria. */
            l_iniace := l_r004fhr.iniace;
            l_fimace := l_r004fhr.fimace;
            l_inipto := l_r004fhr.inipto;
            l_fimpto := l_r004fhr.fimpto;

            l_horbat  := -1;

            /* pega a primeira hora do horario */
            BEGIN
              SELECT HORBAT INTO l_horbat FROM R004MHR WHERE CODHOR = l_r004fhr.codhor AND SEQMAR = 1;
            EXCEPTION
              WHEN TOO_MANY_ROWS THEN
                  RAISERROR 103 'SP_Faihor: Erro No SELECT R004MHR (TOO_MANY_ROWS).';
              WHEN NO_DATA_FOUND THEN /* no caso dos horários 9997 e 9998 */
                  l_horbat := -1;
              WHEN OTHERS THEN
                  RAISERROR 103 'SP_Faihor: Erro No SELECT R004MHR.';
            END;

            /* verifica o tipo de jornada do horario. */
            /* Pela Saída atualiza próximo dia, Pela Entrada atualiza dia anterior */
            BEGIN
              SELECT JORHOR, JORACE INTO l_jorhor, l_jorace FROM R004HOR WHERE CODHOR = l_r004fhr.codhor;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'RH_Faihor: Erro No SELECT R004HOR.';
            END;
            /* salva o valor da primeira faixa do horáio para ser verificado quando for 3º turno */
            IF  l_r004fhr.codhor <> l_codhoratu THEN
                l_prifxA    := l_iniace;
                l_priFxP    := l_inipto;
                l_codHorAtu := l_r004fhr.codhor;
            END IF;

            IF  (l_r004fhr.iniace = 0) AND (l_r004fhr.fimace = 0) THEN
                NULL;
            ELSE
                /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
                IF   (l_r004fhr.iniace > l_r004fhr.fimace) THEN
                     /* tipo de jornada pela Saída ou Hora da batida as 00:00 a faixa começa no dia anterior. */
                     /* tipo de jornada pela Entrada a faixa termina no próximo dia. */
                     IF  (l_jorhor = 'S') OR (l_horbat = 0) THEN
                         IF  (l_horant <> 0) THEN
                             IF l_r004fhr.fimace = 0 THEN
                                  SP_GRA004TMP(l_data, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                  SP_GRA004TMP(l_dia_anterior, 'A', l_r004fhr.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             END IF;

                             IF  l_r004fhr.fimace > 0 THEN
                                 SP_GRA004TMP(l_data, 'A', 0, l_r004fhr.fimace , 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         SP_GRA004TMP(l_data, 'A', l_r004fhr.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                         IF   l_r004fhr.fimace > 0 THEN
                             SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r004fhr.fimace ,3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     END IF;
                ELSE
                     /* 3º turno com intervalos nas faixas                            */
                     /* será verificado se a faixa atual é menor que a primeira faixa */
                     /* neste caso a faixa atual diz respeito ao próximo dia          */
                     IF (l_jorace = 3) THEN
                         IF  l_iniace < l_prifxA THEN
                             IF  (l_jorhor = 'E') THEN
                                 SP_GRA004TMP(l_dia_posterior, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         ELSE
                             /* primeiro horário da faixa */
                             IF  (l_jorhor = 'S') THEN
                                 SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         /* horário turno 1 (inicia e finaliza no mesmo dia) */
                         SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                     END IF;
                END IF;
            END IF;

            IF  (l_r004fhr.inipto = 0) AND (l_r004fhr.fimpto = 0) THEN
                NULL;
            ELSE
                /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
                IF   (l_r004fhr.inipto > l_r004fhr.fimpto) THEN
                     /* se a faixa finaliza no próximo dia */
                     IF  (l_jorhor = 'S') OR (l_horbat = 0) THEN
                         IF  (l_horant <> 0) THEN

                             IF l_r004fhr.fimpto = 0 THEN
                                  SP_GRA004TMP(l_data, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                  SP_GRA004TMP(l_dia_anterior, 'P', l_r004fhr.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;

                         IF   l_r004fhr.fimpto > 0 THEN
                             SP_GRA004TMP(l_data, 'P', 0, l_r004fhr.fimpto , 3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     ELSE

                         SP_GRA004TMP(l_data, 'P', l_r004fhr.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                         IF   l_r004fhr.fimpto > 0 THEN
                              SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r004fhr.fimpto ,3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     END IF;
                ELSE
                     /* 3º turno com intervalos nas faixas                            */
                     /* será verificado se a faixa atual é menor que a primeira faixa */
                     /* neste caso a faixa atual diz respeito ao próximo dia          */ 
                     IF (l_jorace = 3) THEN
                         IF  l_inipto < l_prifxP THEN
                             IF  (l_jorhor = 'E') THEN
                                 SP_GRA004TMP(l_dia_posterior, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         ELSE
                             /* primeiro horário da faixa */
                             IF  (l_jorhor = 'S') THEN
                                 SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         /* horário turno 1 (inicia e finaliza no mesmo dia) */
                         SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                     END IF;
                END IF;
            END IF;
        END LOOP;

        /* salva o valor do horário anterior */
        l_horant := l_codhor;

    END LOOP;  /*Loop R171APF e R171DPF*/

    /*Processa as autorizações de horas extras e saída*/
    FOREACH c_r064XXX INTO l_r064xxx.codreg,
                           l_r064xxx.iniace,
                           l_r064xxx.fimace,
                           l_r064xxx.inipto,
                           l_r064xxx.fimpto,
                           l_r064xxx.tolaea,
                           l_r064xxx.tolasa,
                           l_r064xxx.tolaep,
                           l_r064xxx.tolasp
    LOOP
        /* Inicializações */
        l_iniace := l_r064xxx.iniace;
        l_fimace := l_r064xxx.fimace;
        l_inipto := l_r064xxx.inipto;
        l_fimpto := l_r064xxx.fimpto;

        IF  (l_r064xxx.iniace = 0) AND (l_r064xxx.fimace = 0) THEN
            NULL;
        ELSE
            /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
            IF   (l_r064xxx.iniace > l_r064xxx.fimace) THEN
                IF  (l_r064xxx.codreg = 2) THEN
                    IF  l_r064xxx.tolaea > 0 THEN
                        IF   l_r064xxx.tolaea < l_r064xxx.iniace THEN
                             l_iniace := l_r064xxx.iniace - l_r064xxx.tolaea;
                        ELSE l_iniace := 1440 - l_r064xxx.tolaea + l_r064xxx.iniace;
                             SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             l_iniace := 0;
                        END IF;
                    END IF;
                    IF  l_r064xxx.tolasa > 0 THEN
                        l_total1 := l_r064xxx.fimace + l_r064xxx.tolasa;
                        IF l_r064xxx.fimace = 0 THEN
                             l_total1 := l_total1 + 1440;
                        END IF;
                        IF   l_total1 < 1439 THEN
                             l_fimace := l_total1;
                        ELSE
                             l_fimace := l_total1 - 1440;
                             SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                             l_fimace := 1439;
                        END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimace > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                ELSE
                    /*Autorização de saida*/
                    SP_GRA004TMP(l_data, 'A', l_r064xxx.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimace > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r064xxx.fimace ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                END IF;
            ELSE
                /* se for registro de programação de horas extras ver tolerancias */
                IF  l_r064xxx.codreg = 2 THEN
                    IF  l_r064xxx.tolaea > 0 THEN
                       IF   l_r064xxx.tolaea < l_r064xxx.iniace THEN
                            l_iniace := l_r064xxx.iniace - l_r064xxx.tolaea;
                       ELSE l_iniace := 1440 - l_r064xxx.tolaea + l_r064xxx.iniace;
                            SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                            l_iniace := 0;
                       END IF;
                    END IF;

                    /* se tolerancia para acesso for maior que 0 */
                    IF  l_r064xxx.tolasa > 0 THEN
                       l_total1 := l_r064xxx.fimace + l_r064xxx.tolasa;
                       IF l_r064xxx.fimace = 0 THEN
                            l_total1 := l_total1 + 1440;
                       END IF;
                       IF   l_total1 < 1439 THEN
                            l_fimace := l_total1;
                       ELSE
                            l_fimace := l_total1 - 1440;
                            SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                            l_fimace := 1439;
                       END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);

                ELSE
                    /*Autorização de Acesso*/
                    SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                END IF;
            END IF;
        END IF;

        IF  (l_r064xxx.inipto = 0) AND (l_r064xxx.fimpto = 0) THEN
            NULL;
        ELSE
            /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
            IF   (l_r064xxx.inipto > l_r064xxx.fimpto) THEN
                IF  (l_r064xxx.codreg = 2) THEN
                    IF  l_r064xxx.tolaep > 0 THEN
                        IF   l_r064xxx.tolaep < l_r064xxx.inipto THEN
                             l_inipto := l_r064xxx.inipto - l_r064xxx.tolaep;
                        ELSE l_inipto := 1440 - l_r064xxx.tolaep + l_r064xxx.inipto;
                             SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             l_inipto := 0;
                        END IF;
                    END IF;
                    IF  l_r064xxx.tolasp > 0 THEN
                        l_total1 := l_r064xxx.fimpto + l_r064xxx.tolasp;
                        IF l_r064xxx.fimpto = 0 THEN
                             l_total1 := l_total1 + 1440;
                        END IF;
                        IF   l_total1 < 1439 THEN
                             l_fimpto := l_total1;
                        ELSE
                             l_fimpto := l_total1 - 1440;
                             SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                             l_fimpto := 1439;
                        END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimpto > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;

                ELSE
                    /*Autorização de Saída*/
                    SP_GRA004TMP(l_data, 'P', l_r064xxx.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimpto > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r064xxx.fimpto ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                END IF;
            ELSE
                /* se for registro de programação de horas extras ver tolerancias */
                IF  l_r064xxx.codreg = 2 THEN
                    /* se tolerancia para ponto for maior que 0 */
                    IF  l_r064xxx.tolaep > 0 THEN
                       IF   l_r064xxx.tolaep < l_r064xxx.inipto THEN
                            l_inipto := l_r064xxx.inipto - l_r064xxx.tolaep;
                       ELSE l_inipto := 1440 - l_r064xxx.tolaep + l_r064xxx.inipto;
                            SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                            l_inipto := 0;
                       END IF;
                    END IF;

                    /* se tolerancia para ponto for maior que 0 */
                    IF  l_r064xxx.tolasp > 0 THEN
                       l_total1 := l_r064xxx.fimpto + l_r064xxx.tolasp;
                       IF   l_total1 < 1439 THEN
                            l_fimpto := l_total1;
                       ELSE
                            l_fimpto := l_total1 - 1440;
                            SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                            l_fimpto := 1439;
                       END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                ELSE
                    SP_GRA004TMP(l_data, 'P', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                END IF;
            END IF;
        END IF;
    END LOOP; 

    /* Condicao p/ Controle LOOP. Deve estar antes de incrementar a data, pois deve percorrer um dia a mais. */
    /* Motivo para isso é quando o proximo dia inicia no dia anterior. */
    IF   (l_data > l_data_limite) THEN
         EXIT;
    END IF;

    /* Incremento p/ Controle LOOP */
    l_data := DATETimeAdd(DD,1,l_data);
  END LOOP;

  l_data := CURDATE();

  l_datatu        := CURDATE();
  l_datant        := DATETIMEADD(DD, -1, l_datatu);
  l_dia_posterior := DATETIMEADD(DD, 1, l_datatu);
  l_hora_atual    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  /* verifica liberação da faixa horária (R070LFH) */
  l_numcra:= 0;
  l_tipcra:= 2;

  /*Verifica Liberação de Faixa Horária para Crachá Provisório*/
  FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM
  LOOP
          /* para data atual, verifica se hora termina no dia ou no próximo dia */
          IF  (l_r070lfh.datlib = l_datatu) THEN
              IF (l_r070lfh.HORFIM < l_r070lfh.HORINI) THEN
                  /*termina no outro dia*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);

                  SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              ELSE
                  /*termina no dia atual*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              END IF;
          ELSE
              /* para o dia anteior, então libera da hora zero até a hora final*/
              SP_GRA004TMP(l_datatu, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              SP_GRA004TMP(l_datatu, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
          END IF;

          l_numcra := l_r070lfh.NUMCRA;
  END LOOP;
  /*Se não encontrou, Verifica Liberação de Faixa Horária para o Crachá do Titular*/
  IF  (l_NumCra = 0) THEN
      l_tipcra := 1;
      FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM
      LOOP
          /* para data atual, verifica se hora termina no dia ou no próximo dia */
          IF  (l_r070lfh.datlib = l_datatu) THEN
              IF (l_r070lfh.HORFIM < l_r070lfh.HORINI) THEN
                  /*termina no outro dia*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);

                  SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              ELSE
                  /*termina no dia atual*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              END IF;
          ELSE
              /* para o dia anteior, então libera da hora zero até a hora final*/
              SP_GRA004TMP(l_datatu, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              SP_GRA004TMP(l_datatu, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
          END IF;
      END LOOP;
  END IF;

  /* calcula faixas que estão no mesmo período */
  SP_UnePro(l_datini, l_data_limite,'A', p_numemp, p_tipcol, p_numcad);
  SP_UnePro(l_datini, l_data_limite,'P', p_numemp, p_tipcol, p_numcad);

  LOOP
    l_faiace := '';
    l_faipto := '';

    FOREACH c_r004TMP INTO l_r004TMP.DatHor,
                           l_r004TMP.TipFai,
                           l_r004TMP.FaiIni,
                           l_r004TMP.FaiFim,
                           l_r004TMP.TurTrb

    LOOP
      /* SE TIVER MOBILIDADE DE HORARIO ENTAO CONSIDERA-LA.*/
      SP_INTSTR(l_r004tmp.FaiIni,'HHMM',l_strini OUT);
      SP_INTSTR(l_r004tmp.FaiFim,'HHMM',l_strfim OUT);
      IF  l_r004TMP.TipFai = 'A' THEN
          l_faiace := l_faiace || l_strini || l_strfim;
      END IF;
      IF  l_r004TMP.TipFai = 'P' THEN
          l_faipto := l_faipto || l_strini || l_strfim;
      END IF;

      /* verifica último turno para afastamento (final jornada = maior horario do 3º turno).*/
      IF  (l_r004TMP.DatHor = l_datatu) AND
          (l_r004TMP.TurTrb = 3)        AND
          (l_fimjor < l_r004TMP.FaiFim) AND
          (l_r004TMP.tipfai = 'A')      THEN
          l_fimjor := l_r004TMP.FaiFim;
      END IF;

    END LOOP;

    /* PREENCHE O RESTO DO CAMPO COM 2400 */
    l_faiace := IFNULL(l_faiace,'');
    IF (l_faiace IS NULL) OR (l_faiace = '0') OR (l_faiace = '') THEN
      l_lengfai := 7;
      l_faiace :='';
    ELSE
      l_lengfai := (56 - LENGTH(l_faiace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
      l_faiace := l_faiace || '24002400';
      l_contfai := l_contfai + 1;
      IF (l_contfai >= l_lengfai) THEN
        EXIT;
      END IF;
    END LOOP;
    /* PREENCHE O RESTO DO CAMPO COM 2400 */
    l_faipto := IFNULL(l_faipto,'');
    IF (l_faipto IS NULL) OR (l_faipto = '0') OR (l_faipto = '') THEN
      l_lengfai := 7;
      l_faipto := '';
    ELSE
      l_lengfai := (56 - LENGTH(l_faipto)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
      l_faipto := l_faipto || '24002400';
      l_contfai := l_contfai + 1;
      IF (l_contfai >= l_lengfai) THEN
        EXIT;
      END IF;
    END LOOP;


    l_faiace     := SUBSTRING(l_faiace,1,56);
    l_faipto     := SUBSTRING(l_faipto,1,56);
    l_dia_semana := DAYOFWEEK(l_data);
    IF    l_dia_semana = 1 THEN /* domingo */
          l_faidom_ace := l_faiace;
          l_faidom_pto := l_faipto;
    ELSIF l_dia_semana = 2 THEN /* segunda */
          l_faiseg_ace := l_faiace;
          l_faiseg_pto := l_faipto;
    ELSIF l_dia_semana = 3 THEN /* terca */
          l_faiter_ace := l_faiace;
          l_faiter_pto := l_faipto;
    ELSIF l_dia_semana = 4 THEN /* quarta */
          l_faiqua_ace := l_faiace;
          l_faiqua_pto := l_faipto;
    ELSIF l_dia_semana = 5 THEN /* quinta */
          l_faiqui_ace := l_faiace;
          l_faiqui_pto := l_faipto;
    ELSIF l_dia_semana = 6 THEN /* sexta */
          l_faisex_ace := l_faiace;
          l_faisex_pto := l_faipto;
    ELSE  l_faisab_ace := l_faiace;
          l_faisab_pto := l_faipto;
    END IF;

    /* Incremento p/ Controle LOOP */
    l_data := DATETimeAdd(DD,1,l_data);
    IF   (l_data > l_data_limite) THEN
         EXIT;
    END IF;
  END LOOP;

  /* monta a faixa do refeitorio que deve sempre comecar pelo domingo. */
  p_fairef := '24002400240024002400240024002400240024002400240024002400';

  l_faidom_ace := SUBSTRING(l_faidom_ace,1,56);
  l_faiseg_ace := SUBSTRING(l_faiseg_ace,1,56);
  l_faiter_ace := SUBSTRING(l_faiter_ace,1,56);
  l_faiqua_ace := SUBSTRING(l_faiqua_ace,1,56);
  l_faiqui_ace := SUBSTRING(l_faiqui_ace,1,56);
  l_faisex_ace := SUBSTRING(l_faisex_ace,1,56);
  l_faisab_ace := SUBSTRING(l_faisab_ace,1,56);
  l_faidom_pto := SUBSTRING(l_faidom_pto,1,56);
  l_faiseg_pto := SUBSTRING(l_faiseg_pto,1,56);
  l_faiter_pto := SUBSTRING(l_faiter_pto,1,56);
  l_faiqua_pto := SUBSTRING(l_faiqua_pto,1,56);
  l_faiqui_pto := SUBSTRING(l_faiqui_pto,1,56);
  l_faisex_pto := SUBSTRING(l_faisex_pto,1,56);
  l_faisab_pto := SUBSTRING(l_faisab_pto,1,56);
  p_faidom_ace  := l_faidom_ace;
  p_faiseg_ace  := l_faiseg_ace;
  p_faiter_ace  := l_faiter_ace;
  p_faiqua_ace  := l_faiqua_ace;
  p_faiqui_ace  := l_faiqui_ace;
  p_faisex_ace  := l_faisex_ace;
  p_faisab_ace  := l_faisab_ace;
  p_faidom_pto  := l_faidom_pto;
  p_faiseg_pto  := l_faiseg_pto;
  p_faiter_pto  := l_faiter_pto;
  p_faiqua_pto  := l_faiqua_pto;
  p_faiqui_pto  := l_faiqui_pto;
  p_faisex_pto  := l_faisex_pto;
  p_faisab_pto  := l_faisab_pto; 
  /* Atualiza Afastamentos */
  BEGIN
      SELECT R038AFA.DATAFA, R038AFA.HORAFA, R038AFA.DATTER, R038AFA.HORTER
      INTO l_datafa, l_horafa, l_datter, l_horter
      FROM R010SIT,R038AFA
      WHERE R038AFA.NUMEMP = p_numemp AND R038AFA.TIPCOL = p_tipcol AND R038AFA.NUMCAD = p_numcad AND
           (R038AFA.DATAFA < l_datatu OR (R038AFA.DATAFA = l_datatu AND R038AFA.HORAFA <= l_hora_atual)) AND
           (R038AFA.DATTER = l_data_zero OR R038AFA.DATTER > l_datatu OR
           (R038AFA.DATTER = l_datatu AND R038AFA.HORTER >= l_hora_atual) OR
           (R038AFA.DATTER = l_datatu AND R038AFA.HORTER = 0)) AND
            R038AFA.SITAFA = R010SIT.CODSIT AND R010SIT.BLOACE = 'S' AND
            R010SIT.TIPSIT <> 7;
  EXCEPTION
      WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SPFaiHor: Erro em R038AFA - TOO MANY ROWS.';
      WHEN NO_DATA_FOUND THEN l_TemAfa := FALSE;
      WHEN OTHERS        THEN RAISERROR 103 'SPFaihor: Erro no SELECT em R038AFA.';
  END;

  IF  (l_TemAfa = TRUE) THEN
      /* para terceiro turno é inserido afastamento com data inicial zero.  */
      /* neste caso é necessário verificar se já finalizou a jornada para   */
      /* não bloquear o colaborador na saída. se o final da jornado for 1439*/
      /* significa que ele tem faixa de acesso livre e não precisa verificar*/
      /* a jornada.                                                         */

      IF  (l_horafa = 0) THEN
          IF  (l_hora_atual > l_fimjor) OR (l_fimjor = 1439) THEN
              SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);
              IF  (l_datter <> l_data_zero) THEN
                  SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
              ELSE
                  l_fimafa := '311250';
                  l_horter:= 1439;
              END IF;
          END IF;
      ELSE
          IF  (l_datatu > l_datafa) OR (l_datatu = l_datafa AND l_hora_atual >= l_horafa) THEN
              SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);
              IF  (l_datter <> l_data_zero) THEN
                  SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
              ELSE
                  l_fimafa := '311250';
                  l_horter:= 1439;
              END IF;
          END IF;
      END IF;
      /*Hora final 00:00 considerar como 23:59*/
      IF l_horter = 0 THEN
        l_horter:= 1439;
      END IF;
  ELSE
      l_iniafa := '      ';
      l_fimafa := '      ';
      l_horafa := 0;
      l_horter := 0;
  END IF;
  
  IF (l_horafa = 0) THEN
      p_horini:= '0000';
  ELSE
      SP_INTSTR(l_horafa,'HHMM',p_horini OUT);
  END IF;
  IF (l_horter = 0) THEN
      p_horfim:= '0000';
  ELSE
      SP_INTSTR(l_horter,'HHMM',p_horfim OUT);
  END IF;

  p_datini := l_iniafa;
  p_datfim := l_fimafa;

  /* Limpa tabela temporaria R004TMP */
  BEGIN
      DELETE FROM R004TMP WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
      DROP_TEMP_TABLE R004TMP;
  EXCEPTION WHEN OTHERS THEN
      NULL;
  END;  
END		SENIOR;24:RH_DATFIM
SP_GRA004TMP
SP_UNEPRO
SP_INTSTR
SP_DATSTR
r’␀␀


PROCEDURE SP_FAIPRO(P_NUMEMP NUMBER,P_TIPCOL NUMBER,P_NUMCAD NUMBER,P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56),P_DATINI OUT VARCHAR2(6),P_DATFIM OUT VARCHAR2(6),P_HORINI OUT VARCHAR2(4),P_HORFIM OUT VARCHAR2(4))
 IS

l_data          DATE;
  l_datini        DATE;
  l_data_limite   DATE;
  l_dia_anterior  DATE;
  l_dia_posterior DATE;
  l_dia_semana  NUMBER(1);
  l_codhor      NUMBER(4);
  l_horant      NUMBER(4);
  l_horref      NUMBER(5);
  l_faiace      VARCHAR2(255);
  l_faipto      VARCHAR2(255);
  l_strini      CHAR(4);
  l_strfim      CHAR(4);
  l_horbat      INTEGER;
  l_total1      NUMBER(5);
  l_iniace      NUMBER(5);
  l_inipto      NUMBER(5);
  l_fimace      NUMBER(5);
  l_fimpto      NUMBER(5);
  l_faidom_ace  VARCHAR(56);
  l_faiseg_ace  VARCHAR(56);
  l_faiter_ace  VARCHAR(56);
  l_faiqua_ace  VARCHAR(56);
  l_faiqui_ace  VARCHAR(56);
  l_faisex_ace  VARCHAR(56);
  l_faisab_ace  VARCHAR(56);
  l_faidom_pto  VARCHAR(56);
  l_faiseg_pto  VARCHAR(56);
  l_faiter_pto  VARCHAR(56);
  l_faiqua_pto  VARCHAR(56);
  l_faiqui_pto  VARCHAR(56);
  l_faisex_pto  VARCHAR(56);
  l_faisab_pto  VARCHAR(56);
  l_contfai     INTEGER;
  l_lengfai     INTEGER;
  l_maxseq      NUMBER(2);
  l_jorhor      CHAR;
  l_hora_atual  NUMBER(4);
  l_datafa      DATE;
  l_datter      DATE;
  l_iniafa      CHAR(6);
  l_fimafa      CHAR(6);
  l_horafa      NUMBER(4);
  l_horter      NUMBER(4);
  l_data_zero   DATE;
  l_datatu      DATE;
  l_datant      DATE;
  l_fimjor      NUMBER;
  l_TemAfa      BOOLEAN;
  l_jorace      NUMBER;
  l_prifxA      NUMBER;
  l_prifxP      NUMBER;
  l_codHorAtu   NUMBER;
  l_numcra      NUMBER(12);
  l_HorIni      NUMBER(4);
  l_HorFim      NUMBER(4);
  l_TipCra      NUMBER(1);
  l_codfil      NUMBER(6);

  /* OBTEM O HORÁRIO DAS ATIVIDADES E DISCIPLINAS DO PROFESSOR */
  CURSOR c_horariosPro IS
  SELECT HORSEG,HORTER,HORQUA,HORQUI,HORSEX,HORSAB,HORDOM
    FROM R171APF
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
      DATINI <= l_data AND ((DATFIM >= l_data) OR (DATFIM = l_data_zero)) UNION ALL
  (SELECT HORSEG,HORTER,HORQUA,HORQUI,HORSEX,HORSAB,HORDOM
    FROM R171DPF
      WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND
      DATINI <= l_data AND ((DATFIM >= l_data) OR (DATFIM = l_data_zero)));
  TYPE t_horariosPro IS RECORD(
      HORSEG   R073ATA.HORSEG%TYPE,
      HORTER   R073ATA.HORTER%TYPE,
      HORQUA   R073ATA.HORQUA%TYPE,
      HORQUI   R073ATA.HORQUI%TYPE,
      HORSEX   R073ATA.HORSEX%TYPE,
      HORSAB   R073ATA.HORSAB%TYPE,
      HORDOM   R073ATA.HORDOM%TYPE);
  l_horariosPro t_horariosPro;


  /* PEGA AS FAIXAS HORARIAS DO HORARIO, AS PROGRAMAÇÕES DE HORAS EXTRAS */
  /* E OS AFASTAMENTOS CUJA ORIGEM FOR SAIDA AUTORIZADA */
  CURSOR c_r004fhr IS
    SELECT CODHOR, SEQFAI, INIACE, FIMACE, INIPTO, FIMPTO
    FROM R004FHR FHR WHERE NOT EXISTS (SELECT 1 FROM R004FHF WHERE R004FHF.CODHOR = FHR.CODHOR AND R004FHF.NUMEMP = p_numemp AND R004FHF.CODFIL = l_codfil) AND
             (FHR.CODHOR = l_codhor)
    UNION(
    SELECT CODHOR, SEQFAI, INIACE, FIMACE, INIPTO, FIMPTO
    FROM R004FHF FHF WHERE FHF.NUMEMP = p_numemp AND FHF.CODFIL = l_codfil AND
             (FHF.CODHOR = l_codhor))   
   ORDER BY 1,2,3,4;

  TYPE t_r004fhr IS RECORD(
    CODHOR   R004FHR.CODHOR%TYPE,
    SEQFAI   R004FHR.SEQFAI%TYPE,
    INIACE   R004FHR.INIACE%TYPE,
    FIMACE   R004FHR.FIMACE%TYPE,
    INIPTO   R004FHR.INIPTO%TYPE,
    FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;


  /* CURSOR DA TABELA TEMPORARIA.. */
  CURSOR c_r004TMP IS
  SELECT DATHOR,TIPFAI,FAIINI,FAIFIM,TURTRB FROM R004TMP WHERE DATHOR = l_data AND NUMEMP = p_numemp AND
         TIPCOL = p_tipcol AND NUMCAD = p_numcad ORDER BY 1,2,3;
  TYPE t_r004TMP IS RECORD(
    DATHOR   R004TMP.DATHOR%TYPE,
    TIPFAI   R004TMP.TIPFAI%TYPE,
    FAIINI   R004TMP.FAIINI%TYPE,
    FAIFIM   R004TMP.FAIFIM%TYPE,
    TURTRB   R004TMP.TURTRB%TYPE);
  l_r004TMP t_r004TMP;

  /*CURSOR para Verificar as Liberações de Faixas Horárias*/
  CURSOR c_r070lfh IS
  SELECT A.NUMCRA, A.DATLIB, A.HORINI, A.HORFIM FROM R070LFH A, R038HCH B
             WHERE
             B.TIPCRA = l_tipcra AND B.STAACC = 1 AND
             A.NUMCRA = B.NUMCRA AND B.NUMEMP = p_numemp AND B.TIPCOL = p_tipcol AND B.NUMCAD = p_numcad AND
             ((B.DATINI < l_datatu) OR (B.DATINI = l_datatu)) AND
             ((B.DATFIM > l_datatu) OR (B.DATFIM = l_datatu) OR B.DATFIM = L_DATA_ZERO) AND
             ((A.DATLIB = l_datatu) OR
              (A.DATLIB = l_datant AND (A.HORINI > A.HORFIM) AND (A.HORFIM > l_hora_atual))
             );
  TYPE t_r070lfh IS RECORD(
    NUMCRA   R070LFH.NUMCRA%TYPE,
    DATLIB   R070LFH.DATLIB%TYPE,
    HORINI   R070LFH.HORINI%TYPE,
    HORFIM   R070LFH.HORFIM%TYPE);
  l_r070lfh t_r070lfh;

  /*Verifica as autorizações de horas extras e saída*/
  CURSOR c_r064xxx IS
  SELECT 2 CODREG, HORINI INIACE,HORFIM FIMACE, HORINI INIPTO, HORFIM FIMPTO, TOLAEA,TOLASA,TOLAEP,TOLASP
  FROM R064EXT
   WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATINI <= l_data AND DATFIM >= l_data
   UNION
  (SELECT 3 CODREG, HORASA INIACE,HORTER FIMACE, HORASA INIPTO, HORTER FIMPTO, 0 TOLAEA,0 TOLASA,0 TOLAEP,0 TOLASP
    FROM R064ASA
   WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad AND DATASA = l_data)
   ORDER BY CODREG,INIACE,FIMACE,INIPTO;
   TYPE t_r064xxx IS RECORD(
    CODREG   R004FHR.CODHOR%TYPE,
    INIACE   R064EXT.HORINI%TYPE,
    FIMACE   R064EXT.HORFIM%TYPE,
    INIPTO   R064EXT.HORINI%TYPE,
    FIMPTO   R064EXT.HORFIM%TYPE,
    TOLAEA   R064EXT.TOLAEA%TYPE,
    TOLASA   R064EXT.TOLASA%TYPE,
    TOLAEP   R064EXT.TOLAEP%TYPE,
    TOLASP   R064EXT.TOLASP%TYPE);
  l_r064xxx t_r064xxx;
  
  /* Declaracao para criar tabela temporária */
  CREATE_TEMP_TABLE R004TMP;

BEGIN

  /* Limpa tabela temporaria R004TMP */
  DELETE FROM R004TMP WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;

  /* Inicializa */
  l_datini := CURDATE();
  /* começar um dia antes em caso de haver 3o. turno. */
  l_datini := DATETIMEADD(DD,-1,l_datini);
  l_data := l_datini;
  l_horant := 0;
  l_faidom_ace  := '';
  l_faiseg_ace  := '';
  l_faiter_ace  := '';
  l_faiqua_ace  := '';
  l_faiqui_ace  := '';
  l_faisex_ace  := '';
  l_faisab_ace  := '';
  l_faidom_pto  := '';
  l_faiseg_pto  := '';
  l_faiter_pto  := '';
  l_faiqua_pto  := '';
  l_faiqui_pto  := '';
  l_faisex_pto  := '';
  l_faisab_pto  := '';
  l_data_zero   := '31/12/1900,00:00:00';
  l_datafa      := '';
  l_datter      := '';
  l_horafa      := 0 ;
  l_iniafa      := '';
  l_fimafa      := '';
  l_datatu      := CURDATE();
  l_hora_atual  := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_fimjor      := 0;
  l_TemAfa      := TRUE;

  RH_DatFim (l_data_limite OUT);

  /* Pega o codigo da filial */
  BEGIN
      SELECT HFI.CODFIL INTO l_codfil FROM R038HFI HFI WHERE
             HFI.NUMEMP = p_numemp AND HFI.TIPCOL = p_tipcol AND HFI.NUMCAD = p_numcad AND
             HFI.DATALT = (SELECT MAX(HFI2.DATALT) FROM R038HFI HFI2
                             WHERE HFI2.NUMEMP = p_numemp AND HFI2.TIPCOL = p_tipcol AND HFI2.NUMCAD = p_numcad AND HFI2.DATALT <= CURDATE());
  EXCEPTION
      WHEN OTHERS THEN l_codfil := 0;
  END;

  LOOP
    l_faiace := '';
    l_faipto := '';

    l_dia_anterior := DATETIMEADD(DD, -1, l_data);
    l_dia_posterior := DATETIMEADD(DD, 1, l_data);

    FOREACH c_horariosPro INTO l_horariosPro.horseg,
                               l_horariosPro.horter,
                               l_horariosPro.horqua,
                               l_horariosPro.horqui,
                               l_horariosPro.horsex,
                               l_horariosPro.horsab,
                               l_horariosPro.hordom
    LOOP
        /*Verifica qual o dia da semana atual para pegar o horário correspondente*/
        l_dia_semana  := DAYOFWEEK(l_data);
        IF    l_dia_semana = 1 THEN /* domingo */
            l_codhor := l_horariosPro.hordom;
        ELSIF l_dia_semana = 2 THEN /* segunda */
            l_codhor := l_horariosPro.horseg;
        ELSIF l_dia_semana = 3 THEN /* terca */
            l_codhor := l_horariosPro.horter;
        ELSIF l_dia_semana = 4 THEN /* quarta */
            l_codhor := l_horariosPro.horqua;
        ELSIF l_dia_semana = 5 THEN /* quinta */
            l_codhor := l_horariosPro.horqui;
        ELSIF l_dia_semana = 6 THEN /* sexta */
            l_codhor := l_horariosPro.horsex;
        ELSE
            l_codhor := l_horariosPro.horsab;
        END IF;

        BEGIN
            SELECT MAX(SEQFAI) INTO l_maxseq FROM R004FHR WHERE CODHOR = l_codhor;
        EXCEPTION WHEN OTHERS THEN
            l_maxseq := 1;
        END;
        l_prifxA    := 0;
        l_prifxP    := 0;
        l_codHorAtu := 0;


        FOREACH c_r004fhr INTO l_r004fhr.codhor,
                               l_r004fhr.seqfai,
                               l_r004fhr.iniace,
                               l_r004fhr.fimace,
                               l_r004fhr.inipto,
                               l_r004fhr.fimpto
        LOOP
            /* se for um registro de faixa horaria. */
            l_iniace := l_r004fhr.iniace;
            l_fimace := l_r004fhr.fimace;
            l_inipto := l_r004fhr.inipto;
            l_fimpto := l_r004fhr.fimpto;

            l_horbat  := -1;

            /* pega a primeira hora do horario */
            BEGIN
              SELECT HORBAT INTO l_horbat FROM R004MHR WHERE CODHOR = l_r004fhr.codhor AND SEQMAR = 1;
            EXCEPTION
              WHEN TOO_MANY_ROWS THEN
                  RAISERROR 103 'SP_Faihor: Erro No SELECT R004MHR (TOO_MANY_ROWS).';
              WHEN NO_DATA_FOUND THEN /* no caso dos horários 9997 e 9998 */
                  l_horbat := -1;
              WHEN OTHERS THEN
                  RAISERROR 103 'SP_Faihor: Erro No SELECT R004MHR.';
            END;

            /* verifica o tipo de jornada do horario. */
            /* Pela Saída atualiza próximo dia, Pela Entrada atualiza dia anterior */
            BEGIN
              SELECT JORHOR, JORACE INTO l_jorhor, l_jorace FROM R004HOR WHERE CODHOR = l_r004fhr.codhor;
            EXCEPTION WHEN OTHERS THEN
              RAISERROR 103 'RH_Faihor: Erro No SELECT R004HOR.';
            END;
            /* salva o valor da primeira faixa do horáio para ser verificado quando for 3º turno */
            IF  l_r004fhr.codhor <> l_codhoratu THEN
                l_prifxA    := l_iniace;
                l_priFxP    := l_inipto;
                l_codHorAtu := l_r004fhr.codhor;
            END IF;

            IF  (l_r004fhr.iniace = 0) AND (l_r004fhr.fimace = 0) THEN
                NULL;
            ELSE
                /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
                IF   (l_r004fhr.iniace > l_r004fhr.fimace) THEN
                     /* tipo de jornada pela Saída ou Hora da batida as 00:00 a faixa começa no dia anterior. */
                     /* tipo de jornada pela Entrada a faixa termina no próximo dia. */
                     IF  (l_jorhor = 'S') OR (l_horbat = 0) THEN
                         IF  (l_horant <> 0) THEN
                             IF l_r004fhr.fimace = 0 THEN
                                  SP_GRA004TMP(l_data, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                  SP_GRA004TMP(l_dia_anterior, 'A', l_r004fhr.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             END IF;

                             IF  l_r004fhr.fimace > 0 THEN
                                 SP_GRA004TMP(l_data, 'A', 0, l_r004fhr.fimace , 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         SP_GRA004TMP(l_data, 'A', l_r004fhr.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                         IF   l_r004fhr.fimace > 0 THEN
                             SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r004fhr.fimace ,3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     END IF;
                ELSE
                     /* 3º turno com intervalos nas faixas                            */
                     /* será verificado se a faixa atual é menor que a primeira faixa */
                     /* neste caso a faixa atual diz respeito ao próximo dia          */
                     IF (l_jorace = 3) THEN
                         IF  l_iniace < l_prifxA THEN
                             IF  (l_jorhor = 'E') THEN
                                 SP_GRA004TMP(l_dia_posterior, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         ELSE
                             /* primeiro horário da faixa */
                             IF  (l_jorhor = 'S') THEN
                                 SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, l_fimace, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         /* horário turno 1 (inicia e finaliza no mesmo dia) */
                         SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace, 0, p_numemp, p_tipcol, p_numcad);
                     END IF;
                END IF;
            END IF;

            IF  (l_r004fhr.inipto = 0) AND (l_r004fhr.fimpto = 0) THEN
                NULL;
            ELSE
                /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
                IF   (l_r004fhr.inipto > l_r004fhr.fimpto) THEN
                     /* se a faixa finaliza no próximo dia */
                     IF  (l_jorhor = 'S') OR (l_horbat = 0) THEN
                         IF  (l_horant <> 0) THEN

                             IF l_r004fhr.fimpto = 0 THEN
                                  SP_GRA004TMP(l_data, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                  SP_GRA004TMP(l_dia_anterior, 'P', l_r004fhr.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;

                         IF   l_r004fhr.fimpto > 0 THEN
                             SP_GRA004TMP(l_data, 'P', 0, l_r004fhr.fimpto , 3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     ELSE

                         SP_GRA004TMP(l_data, 'P', l_r004fhr.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                         IF   l_r004fhr.fimpto > 0 THEN
                              SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r004fhr.fimpto ,3, p_numemp, p_tipcol, p_numcad);
                         END IF;
                     END IF;
                ELSE
                     /* 3º turno com intervalos nas faixas                            */
                     /* será verificado se a faixa atual é menor que a primeira faixa */
                     /* neste caso a faixa atual diz respeito ao próximo dia          */ 
                     IF (l_jorace = 3) THEN
                         IF  l_inipto < l_prifxP THEN
                             IF  (l_jorhor = 'E') THEN
                                 SP_GRA004TMP(l_dia_posterior, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         ELSE
                             /* primeiro horário da faixa */
                             IF  (l_jorhor = 'S') THEN
                                 SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, l_fimpto, 3, p_numemp, p_tipcol, p_numcad);
                             ELSE
                                 SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                             END IF;
                         END IF;
                     ELSE
                         /* horário turno 1 (inicia e finaliza no mesmo dia) */
                         SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto, 0, p_numemp, p_tipcol, p_numcad);
                     END IF;
                END IF;
            END IF;
        END LOOP;

        /* salva o valor do horário anterior */
        l_horant := l_codhor;

    END LOOP;  /*Loop R171APF e R171DPF*/

    /*Processa as autorizações de horas extras e saída*/
    FOREACH c_r064XXX INTO l_r064xxx.codreg,
                           l_r064xxx.iniace,
                           l_r064xxx.fimace,
                           l_r064xxx.inipto,
                           l_r064xxx.fimpto,
                           l_r064xxx.tolaea,
                           l_r064xxx.tolasa,
                           l_r064xxx.tolaep,
                           l_r064xxx.tolasp
    LOOP
        /* Inicializações */
        l_iniace := l_r064xxx.iniace;
        l_fimace := l_r064xxx.fimace;
        l_inipto := l_r064xxx.inipto;
        l_fimpto := l_r064xxx.fimpto;

        IF  (l_r064xxx.iniace = 0) AND (l_r064xxx.fimace = 0) THEN
            NULL;
        ELSE
            /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
            IF   (l_r064xxx.iniace > l_r064xxx.fimace) THEN
                IF  (l_r064xxx.codreg = 2) THEN
                    IF  l_r064xxx.tolaea > 0 THEN
                        IF   l_r064xxx.tolaea < l_r064xxx.iniace THEN
                             l_iniace := l_r064xxx.iniace - l_r064xxx.tolaea;
                        ELSE l_iniace := 1440 - l_r064xxx.tolaea + l_r064xxx.iniace;
                             SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             l_iniace := 0;
                        END IF;
                    END IF;
                    IF  l_r064xxx.tolasa > 0 THEN
                        l_total1 := l_r064xxx.fimace + l_r064xxx.tolasa;
                        IF l_r064xxx.fimace = 0 THEN
                             l_total1 := l_total1 + 1440;
                        END IF;
                        IF   l_total1 < 1439 THEN
                             l_fimace := l_total1;
                        ELSE
                             l_fimace := l_total1 - 1440;
                             SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                             l_fimace := 1439;
                        END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimace > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                ELSE
                    /*Autorização de saida*/
                    SP_GRA004TMP(l_data, 'A', l_r064xxx.iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimace > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r064xxx.fimace ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                END IF;
            ELSE
                /* se for registro de programação de horas extras ver tolerancias */
                IF  l_r064xxx.codreg = 2 THEN
                    IF  l_r064xxx.tolaea > 0 THEN
                       IF   l_r064xxx.tolaea < l_r064xxx.iniace THEN
                            l_iniace := l_r064xxx.iniace - l_r064xxx.tolaea;
                       ELSE l_iniace := 1440 - l_r064xxx.tolaea + l_r064xxx.iniace;
                            SP_GRA004TMP(l_dia_anterior, 'A', l_iniace, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                            l_iniace := 0;
                       END IF;
                    END IF;

                    /* se tolerancia para acesso for maior que 0 */
                    IF  l_r064xxx.tolasa > 0 THEN
                       l_total1 := l_r064xxx.fimace + l_r064xxx.tolasa;
                       IF l_r064xxx.fimace = 0 THEN
                            l_total1 := l_total1 + 1440;
                       END IF;
                       IF   l_total1 < 1439 THEN
                            l_fimace := l_total1;
                       ELSE
                            l_fimace := l_total1 - 1440;
                            SP_GRA004TMP(l_dia_posterior, 'A', 0, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                            l_fimace := 1439;
                       END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);

                ELSE
                    /*Autorização de Acesso*/
                    SP_GRA004TMP(l_data, 'A', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                END IF;
            END IF;
        END IF;

        IF  (l_r064xxx.inipto = 0) AND (l_r064xxx.fimpto = 0) THEN
            NULL;
        ELSE
            /* se o colaborador começa a trabalhar a zero hora então atualizar o dia anterior também. */
            IF   (l_r064xxx.inipto > l_r064xxx.fimpto) THEN
                IF  (l_r064xxx.codreg = 2) THEN
                    IF  l_r064xxx.tolaep > 0 THEN
                        IF   l_r064xxx.tolaep < l_r064xxx.inipto THEN
                             l_inipto := l_r064xxx.inipto - l_r064xxx.tolaep;
                        ELSE l_inipto := 1440 - l_r064xxx.tolaep + l_r064xxx.inipto;
                             SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                             l_inipto := 0;
                        END IF;
                    END IF;
                    IF  l_r064xxx.tolasp > 0 THEN
                        l_total1 := l_r064xxx.fimpto + l_r064xxx.tolasp;
                        IF l_r064xxx.fimpto = 0 THEN
                             l_total1 := l_total1 + 1440;
                        END IF;
                        IF   l_total1 < 1439 THEN
                             l_fimpto := l_total1;
                        ELSE
                             l_fimpto := l_total1 - 1440;
                             SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                             l_fimpto := 1439;
                        END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimpto > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;

                ELSE
                    /*Autorização de Saída*/
                    SP_GRA004TMP(l_data, 'P', l_r064xxx.inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                    IF   l_r064xxx.fimpto > 0 THEN
                         SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r064xxx.fimpto ,3, p_numemp, p_tipcol, p_numcad);
                    END IF;
                END IF;
            ELSE
                /* se for registro de programação de horas extras ver tolerancias */
                IF  l_r064xxx.codreg = 2 THEN
                    /* se tolerancia para ponto for maior que 0 */
                    IF  l_r064xxx.tolaep > 0 THEN
                       IF   l_r064xxx.tolaep < l_r064xxx.inipto THEN
                            l_inipto := l_r064xxx.inipto - l_r064xxx.tolaep;
                       ELSE l_inipto := 1440 - l_r064xxx.tolaep + l_r064xxx.inipto;
                            SP_GRA004TMP(l_dia_anterior, 'P', l_inipto, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                            l_inipto := 0;
                       END IF;
                    END IF;

                    /* se tolerancia para ponto for maior que 0 */
                    IF  l_r064xxx.tolasp > 0 THEN
                       l_total1 := l_r064xxx.fimpto + l_r064xxx.tolasp;
                       IF   l_total1 < 1439 THEN
                            l_fimpto := l_total1;
                       ELSE
                            l_fimpto := l_total1 - 1440;
                            SP_GRA004TMP(l_dia_posterior, 'P', 0, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                            l_fimpto := 1439;
                       END IF;
                    END IF;
                    SP_GRA004TMP(l_data, 'P', l_inipto, l_fimpto ,0, p_numemp, p_tipcol, p_numcad);
                ELSE
                    SP_GRA004TMP(l_data, 'P', l_iniace, l_fimace ,0, p_numemp, p_tipcol, p_numcad);
                END IF;
            END IF;
        END IF;
    END LOOP; 

    /* Condicao p/ Controle LOOP. Deve estar antes de incrementar a data, pois deve percorrer um dia a mais. */
    /* Motivo para isso é quando o proximo dia inicia no dia anterior. */
    IF   (l_data > l_data_limite) THEN
         EXIT;
    END IF;

    /* Incremento p/ Controle LOOP */
    l_data := DATETimeAdd(DD,1,l_data);
  END LOOP;

  l_data := CURDATE();

  l_datatu        := CURDATE();
  l_datant        := DATETIMEADD(DD, -1, l_datatu);
  l_dia_posterior := DATETIMEADD(DD, 1, l_datatu);
  l_hora_atual    := HOUR(CURTIME())*60 + MINUTE(CURTIME());

  /* verifica liberação da faixa horária (R070LFH) */
  l_numcra:= 0;
  l_tipcra:= 2;

  /*Verifica Liberação de Faixa Horária para Crachá Provisório*/
  FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM
  LOOP
          /* para data atual, verifica se hora termina no dia ou no próximo dia */
          IF  (l_r070lfh.datlib = l_datatu) THEN
              IF (l_r070lfh.HORFIM < l_r070lfh.HORINI) THEN
                  /*termina no outro dia*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);

                  SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              ELSE
                  /*termina no dia atual*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              END IF;
          ELSE
              /* para o dia anteior, então libera da hora zero até a hora final*/
              SP_GRA004TMP(l_datatu, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              SP_GRA004TMP(l_datatu, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
          END IF;

          l_numcra := l_r070lfh.NUMCRA;
  END LOOP;
  /*Se não encontrou, Verifica Liberação de Faixa Horária para o Crachá do Titular*/
  IF  (l_NumCra = 0) THEN
      l_tipcra := 1;
      FOREACH c_r070lfh INTO l_r070lfh.NUMCRA,l_r070lfh.datlib,l_r070lfh.HORINI,l_r070lfh.HORFIM
      LOOP
          /* para data atual, verifica se hora termina no dia ou no próximo dia */
          IF  (l_r070lfh.datlib = l_datatu) THEN
              IF (l_r070lfh.HORFIM < l_r070lfh.HORINI) THEN
                  /*termina no outro dia*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, 1439 ,0, p_numemp, p_tipcol, p_numcad);

                  SP_GRA004TMP(l_dia_posterior, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_dia_posterior, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              ELSE
                  /*termina no dia atual*/
                  SP_GRA004TMP(l_r070lfh.datlib, 'A', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
                  SP_GRA004TMP(l_r070lfh.datlib, 'P', l_r070lfh.HorIni, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              END IF;
          ELSE
              /* para o dia anteior, então libera da hora zero até a hora final*/
              SP_GRA004TMP(l_datatu, 'A', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
              SP_GRA004TMP(l_datatu, 'P', 0, l_r070lfh.HorFim ,0, p_numemp, p_tipcol, p_numcad);
          END IF;
      END LOOP;
  END IF;

  /* calcula faixas que estão no mesmo período */
  SP_UnePro(l_datini, l_data_limite,'A', p_numemp, p_tipcol, p_numcad);
  SP_UnePro(l_datini, l_data_limite,'P', p_numemp, p_tipcol, p_numcad);

  LOOP
    l_faiace := '';
    l_faipto := '';

    FOREACH c_r004TMP INTO l_r004TMP.DatHor,
                           l_r004TMP.TipFai,
                           l_r004TMP.FaiIni,
                           l_r004TMP.FaiFim,
                           l_r004TMP.TurTrb

    LOOP
      /* SE TIVER MOBILIDADE DE HORARIO ENTAO CONSIDERA-LA.*/
      SP_INTSTR(l_r004tmp.FaiIni,'HHMM',l_strini OUT);
      SP_INTSTR(l_r004tmp.FaiFim,'HHMM',l_strfim OUT);
      IF  l_r004TMP.TipFai = 'A' THEN
          l_faiace := l_faiace || l_strini || l_strfim;
      END IF;
      IF  l_r004TMP.TipFai = 'P' THEN
          l_faipto := l_faipto || l_strini || l_strfim;
      END IF;

      /* verifica último turno para afastamento (final jornada = maior horario do 3º turno).*/
      IF  (l_r004TMP.DatHor = l_datatu) AND
          (l_r004TMP.TurTrb = 3)        AND
          (l_fimjor < l_r004TMP.FaiFim) AND
          (l_r004TMP.tipfai = 'A')      THEN
          l_fimjor := l_r004TMP.FaiFim;
      END IF;

    END LOOP;

    /* PREENCHE O RESTO DO CAMPO COM 2400 */
    l_faiace := IFNULL(l_faiace,'');
    IF (l_faiace IS NULL) OR (l_faiace = '0') OR (l_faiace = '') THEN
      l_lengfai := 7;
      l_faiace :='';
    ELSE
      l_lengfai := (56 - LENGTH(l_faiace)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
      l_faiace := l_faiace || '24002400';
      l_contfai := l_contfai + 1;
      IF (l_contfai >= l_lengfai) THEN
        EXIT;
      END IF;
    END LOOP;
    /* PREENCHE O RESTO DO CAMPO COM 2400 */
    l_faipto := IFNULL(l_faipto,'');
    IF (l_faipto IS NULL) OR (l_faipto = '0') OR (l_faipto = '') THEN
      l_lengfai := 7;
      l_faipto := '';
    ELSE
      l_lengfai := (56 - LENGTH(l_faipto)) / 8;
    END IF;
    l_contfai := 0;
    LOOP
      l_faipto := l_faipto || '24002400';
      l_contfai := l_contfai + 1;
      IF (l_contfai >= l_lengfai) THEN
        EXIT;
      END IF;
    END LOOP;


    l_faiace     := SUBSTRING(l_faiace,1,56);
    l_faipto     := SUBSTRING(l_faipto,1,56);
    l_dia_semana := DAYOFWEEK(l_data);
    IF    l_dia_semana = 1 THEN /* domingo */
          l_faidom_ace := l_faiace;
          l_faidom_pto := l_faipto;
    ELSIF l_dia_semana = 2 THEN /* segunda */
          l_faiseg_ace := l_faiace;
          l_faiseg_pto := l_faipto;
    ELSIF l_dia_semana = 3 THEN /* terca */
          l_faiter_ace := l_faiace;
          l_faiter_pto := l_faipto;
    ELSIF l_dia_semana = 4 THEN /* quarta */
          l_faiqua_ace := l_faiace;
          l_faiqua_pto := l_faipto;
    ELSIF l_dia_semana = 5 THEN /* quinta */
          l_faiqui_ace := l_faiace;
          l_faiqui_pto := l_faipto;
    ELSIF l_dia_semana = 6 THEN /* sexta */
          l_faisex_ace := l_faiace;
          l_faisex_pto := l_faipto;
    ELSE  l_faisab_ace := l_faiace;
          l_faisab_pto := l_faipto;
    END IF;

    /* Incremento p/ Controle LOOP */
    l_data := DATETimeAdd(DD,1,l_data);
    IF   (l_data > l_data_limite) THEN
         EXIT;
    END IF;
  END LOOP;

  /* monta a faixa do refeitorio que deve sempre comecar pelo domingo. */
  p_fairef := '24002400240024002400240024002400240024002400240024002400';

  l_faidom_ace := SUBSTRING(l_faidom_ace,1,56);
  l_faiseg_ace := SUBSTRING(l_faiseg_ace,1,56);
  l_faiter_ace := SUBSTRING(l_faiter_ace,1,56);
  l_faiqua_ace := SUBSTRING(l_faiqua_ace,1,56);
  l_faiqui_ace := SUBSTRING(l_faiqui_ace,1,56);
  l_faisex_ace := SUBSTRING(l_faisex_ace,1,56);
  l_faisab_ace := SUBSTRING(l_faisab_ace,1,56);
  l_faidom_pto := SUBSTRING(l_faidom_pto,1,56);
  l_faiseg_pto := SUBSTRING(l_faiseg_pto,1,56);
  l_faiter_pto := SUBSTRING(l_faiter_pto,1,56);
  l_faiqua_pto := SUBSTRING(l_faiqua_pto,1,56);
  l_faiqui_pto := SUBSTRING(l_faiqui_pto,1,56);
  l_faisex_pto := SUBSTRING(l_faisex_pto,1,56);
  l_faisab_pto := SUBSTRING(l_faisab_pto,1,56);
  p_faidom_ace  := l_faidom_ace;
  p_faiseg_ace  := l_faiseg_ace;
  p_faiter_ace  := l_faiter_ace;
  p_faiqua_ace  := l_faiqua_ace;
  p_faiqui_ace  := l_faiqui_ace;
  p_faisex_ace  := l_faisex_ace;
  p_faisab_ace  := l_faisab_ace;
  p_faidom_pto  := l_faidom_pto;
  p_faiseg_pto  := l_faiseg_pto;
  p_faiter_pto  := l_faiter_pto;
  p_faiqua_pto  := l_faiqua_pto;
  p_faiqui_pto  := l_faiqui_pto;
  p_faisex_pto  := l_faisex_pto;
  p_faisab_pto  := l_faisab_pto; 
  /* Atualiza Afastamentos */
  BEGIN
      SELECT R038AFA.DATAFA, R038AFA.HORAFA, R038AFA.DATTER, R038AFA.HORTER
      INTO l_datafa, l_horafa, l_datter, l_horter
      FROM R010SIT,R038AFA
      WHERE R038AFA.NUMEMP = p_numemp AND R038AFA.TIPCOL = p_tipcol AND R038AFA.NUMCAD = p_numcad AND
           (R038AFA.DATAFA < l_datatu OR (R038AFA.DATAFA = l_datatu AND R038AFA.HORAFA <= l_hora_atual)) AND
           (R038AFA.DATTER = l_data_zero OR R038AFA.DATTER > l_datatu OR
           (R038AFA.DATTER = l_datatu AND R038AFA.HORTER >= l_hora_atual) OR
           (R038AFA.DATTER = l_datatu AND R038AFA.HORTER = 0)) AND
            R038AFA.SITAFA = R010SIT.CODSIT AND R010SIT.BLOACE = 'S' AND
            R010SIT.TIPSIT <> 7;
  EXCEPTION
      WHEN TOO_MANY_ROWS THEN RAISERROR 103 'SPFaiHor: Erro em R038AFA - TOO MANY ROWS.';
      WHEN NO_DATA_FOUND THEN l_TemAfa := FALSE;
      WHEN OTHERS        THEN RAISERROR 103 'SPFaihor: Erro no SELECT em R038AFA.';
  END;

  IF  (l_TemAfa = TRUE) THEN
      /* para terceiro turno é inserido afastamento com data inicial zero.  */
      /* neste caso é necessário verificar se já finalizou a jornada para   */
      /* não bloquear o colaborador na saída. se o final da jornado for 1439*/
      /* significa que ele tem faixa de acesso livre e não precisa verificar*/
      /* a jornada.                                                         */

      IF  (l_horafa = 0) THEN
          IF  (l_hora_atual > l_fimjor) OR (l_fimjor = 1439) THEN
              SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);
              IF  (l_datter <> l_data_zero) THEN
                  SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
              ELSE
                  l_fimafa := '311250';
                  l_horter:= 1439;
              END IF;
          END IF;
      ELSE
          IF  (l_datatu > l_datafa) OR (l_datatu = l_datafa AND l_hora_atual >= l_horafa) THEN
              SP_DATSTR(l_datafa,'DDMMYY',l_iniafa OUT);
              IF  (l_datter <> l_data_zero) THEN
                  SP_DATSTR(l_datter,'DDMMYY',l_fimafa OUT);
              ELSE
                  l_fimafa := '311250';
                  l_horter:= 1439;
              END IF;
          END IF;
      END IF;
      /*Hora final 00:00 considerar como 23:59*/
      IF l_horter = 0 THEN
        l_horter:= 1439;
      END IF;
  ELSE
      l_iniafa := '      ';
      l_fimafa := '      ';
      l_horafa := 0;
      l_horter := 0;
  END IF;
  
  IF (l_horafa = 0) THEN
      p_horini:= '0000';
  ELSE
      SP_INTSTR(l_horafa,'HHMM',p_horini OUT);
  END IF;
  IF (l_horter = 0) THEN
      p_horfim:= '0000';
  ELSE
      SP_INTSTR(l_horter,'HHMM',p_horfim OUT);
  END IF;

  p_datini := l_iniafa;
  p_datfim := l_fimafa;

  /* Limpa tabela temporaria R004TMP */
  BEGIN
      DELETE FROM R004TMP WHERE NUMEMP = p_numemp AND TIPCOL = p_tipcol AND NUMCAD = p_numcad;
      DROP_TEMP_TABLE R004TMP;
  EXCEPTION WHEN OTHERS THEN
      NULL;
  END;  
END␀7ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE SP_FAIRES(P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56))
 IS
BEGIN
  NULL;
END		SENIOR;20SP_INTSTR
!7␀␀


PROCEDURE SP_FAIRES(P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56))
 IS

l_data_atual  DATE;
  l_striac      CHAR(4);
  l_strfac      CHAR(4);
  l_stript      CHAR(4);
  l_strfpt      CHAR(4);
  l_faidom_ace  VARCHAR2(255);
  l_faiseg_ace  VARCHAR2(255);
  l_faiter_ace  VARCHAR2(255);
  l_faiqua_ace  VARCHAR2(255);
  l_faiqui_ace  VARCHAR2(255);
  l_faisex_ace  VARCHAR2(255);
  l_faisab_ace  VARCHAR2(255);
  l_faidom_pto  VARCHAR2(255);
  l_faiseg_pto  VARCHAR2(255);
  l_faiter_pto  VARCHAR2(255);
  l_faiqua_pto  VARCHAR2(255);
  l_faiqui_pto  VARCHAR2(255);
  l_faisex_pto  VARCHAR2(255);
  l_faisab_pto  VARCHAR2(255);
  l_contfai     INTEGER;
  l_lengfai     INTEGER;
  l_data_zero   DATE;
  l_horseg      NUMBER(4);
  l_horter      NUMBER(4);
  l_horqua      NUMBER(4);
  l_horqui      NUMBER(4);
  l_horsex      NUMBER(4);
  l_horsab      NUMBER(4);
  l_hordom      NUMBER(4);
  l_dia_semana  NUMBER(1);
  L_NODATAFOUND  BOOLEAN;

  /* HORÁRIOS */
  CURSOR c_r004fhr IS
  SELECT CODHOR,INIACE,FIMACE,INIPTO,FIMPTO FROM R004FHR;
  TYPE t_r004fhr IS RECORD(
      CODHOR   R004FHR.CODHOR%TYPE,
      INIACE   R004FHR.INIACE%TYPE,
      FIMACE   R004FHR.FIMACE%TYPE,
      INIPTO   R004FHR.INIPTO%TYPE,
      FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;

BEGIN
  /* Inicializa */
  l_data_zero := '31/12/1900,00:00:00';
  l_data_atual:= CURDATE();

  l_faidom_ace  := '';
  l_faiseg_ace  := '';
  l_faiter_ace  := '';
  l_faiqua_ace  := '';
  l_faiqui_ace  := '';
  l_faisex_ace  := '';
  l_faisab_ace  := '';
  l_faidom_pto  := '';
  l_faiseg_pto  := '';
  l_faiter_pto  := '';
  l_faiqua_pto  := '';
  l_faiqui_pto  := '';
  l_faisex_pto  := '';
  l_faisab_pto  := '';

  L_NODATAFOUND:=FALSE;
  BEGIN
    SELECT CODHOR HORSEG,CODHOR HORTER,CODHOR HORQUA,CODHOR HORQUI,CODHOR HORSEX,HORSAB,HORDOM
    INTO l_horseg,l_horter,l_horqua,l_horqui,l_horsex,l_horsab,l_hordom
    FROM R073RES WHERE TIPDOC = p_tipdoc AND NUMDOC = p_numdoc;
  EXCEPTION
    WHEN OTHERS THEN L_NODATAFOUND:=TRUE;
  END;
  IF  L_NODATAFOUND = FALSE THEN
    FOREACH c_r004fhr INTO l_r004fhr.codhor,
             l_r004fhr.iniace,
             l_r004fhr.fimace,
             l_r004fhr.inipto,
             l_r004fhr.fimpto
    LOOP
      SP_INTSTR(l_r004fhr.iniace,'HHMM',l_striac OUT);
      SP_INTSTR(l_r004fhr.fimace,'HHMM',l_strfac OUT);
      SP_INTSTR(l_r004fhr.inipto,'HHMM',l_stript OUT);
      SP_INTSTR(l_r004fhr.fimpto,'HHMM',l_strfpt OUT);

      IF  (l_r004fhr.codhor = l_hordom) THEN
          /* domingo */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faidom_ace)) < 49) OR ((LENGTH(l_faidom_ace) IS NULL)) THEN
        l_faidom_ace := l_faidom_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faidom_pto)) < 49) OR ((LENGTH(l_faidom_pto) IS NULL)) THEN
        l_faidom_pto := l_faidom_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horseg) THEN
          /* segunda-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiseg_ace)) < 49) OR ((LENGTH(l_faiseg_ace) IS NULL)) THEN
        l_faiseg_ace := l_faiseg_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiseg_pto)) < 49) OR ((LENGTH(l_faiseg_pto) IS NULL)) THEN
        l_faiseg_pto := l_faiseg_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horter) THEN
          /* terça-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiter_ace)) < 49) OR ((LENGTH(l_faiter_ace) IS NULL)) THEN
        l_faiter_ace := l_faiter_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiter_pto)) < 49) OR ((LENGTH(l_faiter_pto) IS NULL)) THEN
        l_faiter_pto := l_faiter_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horqua) THEN
          /* quarta-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiqua_ace)) < 49) OR ((LENGTH(l_faiqua_ace) IS NULL)) THEN
        l_faiqua_ace := l_faiqua_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiqua_pto)) < 49) OR ((LENGTH(l_faiqua_pto) IS NULL)) THEN
        l_faiqua_pto := l_faiqua_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horqui) THEN
          /* quinta-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiqui_ace)) < 49) OR ((LENGTH(l_faiqui_ace) IS NULL)) THEN
        l_faiqui_ace := l_faiqui_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiqui_pto)) < 49) OR ((LENGTH(l_faiqui_pto) IS NULL)) THEN
        l_faiqui_pto := l_faiqui_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horsex) THEN
          /* sexta-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faisex_ace)) < 49) OR ((LENGTH(l_faisex_ace) IS NULL)) THEN
        l_faisex_ace := l_faisex_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faisex_pto)) < 49) OR ((LENGTH(l_faisex_pto) IS NULL)) THEN
        l_faisex_pto := l_faisex_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horsab) THEN
          /* sábado */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faisab_ace)) < 49) OR ((LENGTH(l_faisab_ace) IS NULL)) THEN
        l_faisab_ace := l_faisab_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faisab_pto)) < 49) OR ((LENGTH(l_faisab_pto) IS NULL)) THEN
        l_faisab_pto := l_faisab_pto || l_stript || l_strfpt;
          END IF;
      END IF;
    END LOOP; /* LOOP r004fhr */
  END IF;
  
  /* PREENCHE O RESTO DO CAMPO COM 2400 */
  l_faidom_ace := IFNULL(l_faidom_ace,'');
  IF  (l_faidom_ace IS NULL) OR (l_faidom_ace = '') THEN
      l_lengfai := 7;
      l_faidom_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faidom_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faidom_ace := l_faidom_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faidom_pto := IFNULL(l_faidom_pto,'');
  IF  (l_faidom_pto IS NULL) OR (l_faidom_pto = '') THEN
      l_lengfai := 7;
      l_faidom_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faidom_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faidom_pto := l_faidom_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiseg_ace := IFNULL(l_faiseg_ace,'');
  IF  (l_faiseg_ace IS NULL) OR (l_faiseg_ace = '') THEN
      l_lengfai := 7;
      l_faiseg_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiseg_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiseg_ace := l_faiseg_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiseg_pto := IFNULL(l_faiseg_pto,'');
  IF  (l_faiseg_pto IS NULL) OR (l_faiseg_pto = '') THEN
      l_lengfai := 7;
      l_faiseg_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiseg_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiseg_pto := l_faiseg_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiter_ace := IFNULL(l_faiter_ace,'');
  IF  (l_faiter_ace IS NULL) OR (l_faiter_ace = '') THEN
      l_lengfai := 7;
      l_faiter_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiter_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiter_ace := l_faiter_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiter_pto := IFNULL(l_faiter_pto,'');
  IF  (l_faiter_pto IS NULL) OR (l_faiter_pto = '') THEN
      l_lengfai := 7;
      l_faiter_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiter_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiter_pto := l_faiter_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqua_ace := IFNULL(l_faiqua_ace,'');
  IF  (l_faiqua_ace IS NULL) OR (l_faiqua_ace = '') THEN
      l_lengfai := 7;
      l_faiqua_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqua_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqua_ace := l_faiqua_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqua_pto := IFNULL(l_faiqua_pto,'');
  IF  (l_faiqua_pto IS NULL) OR (l_faiqua_pto = '') THEN
      l_lengfai := 7;
      l_faiqua_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqua_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqua_pto := l_faiqua_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqui_ace := IFNULL(l_faiqui_ace,'');
  IF  (l_faiqui_ace IS NULL) OR (l_faiqui_ace = '') THEN
      l_lengfai := 7;
      l_faiqui_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqui_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqui_ace := l_faiqui_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqui_pto := IFNULL(l_faiqui_pto,'');
  IF  (l_faiqui_pto IS NULL) OR (l_faiqui_pto = '') THEN
      l_lengfai := 7;
      l_faiqui_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqui_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqui_pto := l_faiqui_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisex_ace := IFNULL(l_faisex_ace,'');
  IF  (l_faisex_ace IS NULL) OR (l_faisex_ace = '') THEN
      l_lengfai := 7;
      l_faisex_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisex_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisex_ace := l_faisex_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisex_pto := IFNULL(l_faisex_pto,'');
  IF  (l_faisex_pto IS NULL) OR (l_faisex_pto = '') THEN
      l_lengfai := 7;
      l_faisex_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisex_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisex_pto := l_faisex_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisab_ace := IFNULL(l_faisab_ace,'');
  IF  (l_faisab_ace IS NULL) OR (l_faisab_ace = '') THEN
      l_lengfai := 7;
      l_faisab_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisab_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisab_ace := l_faisab_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisab_pto := IFNULL(l_faisab_pto,'');
  IF  (l_faisab_pto IS NULL) OR (l_faisab_pto = '') THEN
      l_lengfai := 7;
      l_faisab_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisab_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisab_pto := l_faisab_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  /* monta a faixa do refeitorio que deve sempre comecar pelo domingo. */
  p_fairef := '24002400240024002400240024002400240024002400240024002400';

  l_faidom_ace  := SUBSTRING(l_faidom_ace,1,56);
  l_faiseg_ace  := SUBSTRING(l_faiseg_ace,1,56);
  l_faiter_ace  := SUBSTRING(l_faiter_ace,1,56);
  l_faiqua_ace  := SUBSTRING(l_faiqua_ace,1,56);
  l_faiqui_ace  := SUBSTRING(l_faiqui_ace,1,56);
  l_faisex_ace  := SUBSTRING(l_faisex_ace,1,56);
  l_faisab_ace  := SUBSTRING(l_faisab_ace,1,56);
  l_faidom_pto  := SUBSTRING(l_faidom_pto,1,56);
  l_faiseg_pto  := SUBSTRING(l_faiseg_pto,1,56);
  l_faiter_pto  := SUBSTRING(l_faiter_pto,1,56);
  l_faiqua_pto  := SUBSTRING(l_faiqua_pto,1,56);
  l_faiqui_pto  := SUBSTRING(l_faiqui_pto,1,56);
  l_faisex_pto  := SUBSTRING(l_faisex_pto,1,56);
  l_faisab_pto  := SUBSTRING(l_faisab_pto,1,56);

  p_faidom_ace  := l_faidom_ace;
  p_faiseg_ace  := l_faiseg_ace;
  p_faiter_ace  := l_faiter_ace;
  p_faiqua_ace  := l_faiqua_ace;
  p_faiqui_ace  := l_faiqui_ace;
  p_faisex_ace  := l_faisex_ace;
  p_faisab_ace  := l_faisab_ace;
  p_faidom_pto  := l_faidom_pto;
  p_faiseg_pto  := l_faiseg_pto;
  p_faiter_pto  := l_faiter_pto;
  p_faiqua_pto  := l_faiqua_pto;
  p_faiqui_pto  := l_faiqui_pto;
  p_faisex_pto  := l_faisex_pto;
  p_faisab_pto  := l_faisab_pto;
END		SENIOR;21SP_INTSTR
!7␀␀


PROCEDURE SP_FAIRES(P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56))
 IS

l_data_atual  DATE;
  l_striac      CHAR(4);
  l_strfac      CHAR(4);
  l_stript      CHAR(4);
  l_strfpt      CHAR(4);
  l_faidom_ace  VARCHAR2(255);
  l_faiseg_ace  VARCHAR2(255);
  l_faiter_ace  VARCHAR2(255);
  l_faiqua_ace  VARCHAR2(255);
  l_faiqui_ace  VARCHAR2(255);
  l_faisex_ace  VARCHAR2(255);
  l_faisab_ace  VARCHAR2(255);
  l_faidom_pto  VARCHAR2(255);
  l_faiseg_pto  VARCHAR2(255);
  l_faiter_pto  VARCHAR2(255);
  l_faiqua_pto  VARCHAR2(255);
  l_faiqui_pto  VARCHAR2(255);
  l_faisex_pto  VARCHAR2(255);
  l_faisab_pto  VARCHAR2(255);
  l_contfai     INTEGER;
  l_lengfai     INTEGER;
  l_data_zero   DATE;
  l_horseg      NUMBER(4);
  l_horter      NUMBER(4);
  l_horqua      NUMBER(4);
  l_horqui      NUMBER(4);
  l_horsex      NUMBER(4);
  l_horsab      NUMBER(4);
  l_hordom      NUMBER(4);
  l_dia_semana  NUMBER(1);
  L_NODATAFOUND  BOOLEAN;

  /* HORÁRIOS */
  CURSOR c_r004fhr IS
  SELECT CODHOR,INIACE,FIMACE,INIPTO,FIMPTO FROM R004FHR;
  TYPE t_r004fhr IS RECORD(
      CODHOR   R004FHR.CODHOR%TYPE,
      INIACE   R004FHR.INIACE%TYPE,
      FIMACE   R004FHR.FIMACE%TYPE,
      INIPTO   R004FHR.INIPTO%TYPE,
      FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;

BEGIN
  /* Inicializa */
  l_data_zero := '31/12/1900,00:00:00';
  l_data_atual:= CURDATE();

  l_faidom_ace  := '';
  l_faiseg_ace  := '';
  l_faiter_ace  := '';
  l_faiqua_ace  := '';
  l_faiqui_ace  := '';
  l_faisex_ace  := '';
  l_faisab_ace  := '';
  l_faidom_pto  := '';
  l_faiseg_pto  := '';
  l_faiter_pto  := '';
  l_faiqua_pto  := '';
  l_faiqui_pto  := '';
  l_faisex_pto  := '';
  l_faisab_pto  := '';

  L_NODATAFOUND:=FALSE;
  BEGIN
    SELECT CODHOR HORSEG,CODHOR HORTER,CODHOR HORQUA,CODHOR HORQUI,CODHOR HORSEX,HORSAB,HORDOM
    INTO l_horseg,l_horter,l_horqua,l_horqui,l_horsex,l_horsab,l_hordom
    FROM R073RES WHERE TIPDOC = p_tipdoc AND NUMDOC = p_numdoc;
  EXCEPTION
    WHEN OTHERS THEN L_NODATAFOUND:=TRUE;
  END;
  IF  L_NODATAFOUND = FALSE THEN
    FOREACH c_r004fhr INTO l_r004fhr.codhor,
             l_r004fhr.iniace,
             l_r004fhr.fimace,
             l_r004fhr.inipto,
             l_r004fhr.fimpto
    LOOP
      SP_INTSTR(l_r004fhr.iniace,'HHMM',l_striac OUT);
      SP_INTSTR(l_r004fhr.fimace,'HHMM',l_strfac OUT);
      SP_INTSTR(l_r004fhr.inipto,'HHMM',l_stript OUT);
      SP_INTSTR(l_r004fhr.fimpto,'HHMM',l_strfpt OUT);

      IF  (l_r004fhr.codhor = l_hordom) THEN
          /* domingo */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faidom_ace)) < 49) OR ((LENGTH(l_faidom_ace) IS NULL)) THEN
        l_faidom_ace := l_faidom_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faidom_pto)) < 49) OR ((LENGTH(l_faidom_pto) IS NULL)) THEN
        l_faidom_pto := l_faidom_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horseg) THEN
          /* segunda-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiseg_ace)) < 49) OR ((LENGTH(l_faiseg_ace) IS NULL)) THEN
        l_faiseg_ace := l_faiseg_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiseg_pto)) < 49) OR ((LENGTH(l_faiseg_pto) IS NULL)) THEN
        l_faiseg_pto := l_faiseg_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horter) THEN
          /* terça-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiter_ace)) < 49) OR ((LENGTH(l_faiter_ace) IS NULL)) THEN
        l_faiter_ace := l_faiter_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiter_pto)) < 49) OR ((LENGTH(l_faiter_pto) IS NULL)) THEN
        l_faiter_pto := l_faiter_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horqua) THEN
          /* quarta-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiqua_ace)) < 49) OR ((LENGTH(l_faiqua_ace) IS NULL)) THEN
        l_faiqua_ace := l_faiqua_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiqua_pto)) < 49) OR ((LENGTH(l_faiqua_pto) IS NULL)) THEN
        l_faiqua_pto := l_faiqua_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horqui) THEN
          /* quinta-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiqui_ace)) < 49) OR ((LENGTH(l_faiqui_ace) IS NULL)) THEN
        l_faiqui_ace := l_faiqui_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiqui_pto)) < 49) OR ((LENGTH(l_faiqui_pto) IS NULL)) THEN
        l_faiqui_pto := l_faiqui_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horsex) THEN
          /* sexta-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faisex_ace)) < 49) OR ((LENGTH(l_faisex_ace) IS NULL)) THEN
        l_faisex_ace := l_faisex_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faisex_pto)) < 49) OR ((LENGTH(l_faisex_pto) IS NULL)) THEN
        l_faisex_pto := l_faisex_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horsab) THEN
          /* sábado */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faisab_ace)) < 49) OR ((LENGTH(l_faisab_ace) IS NULL)) THEN
        l_faisab_ace := l_faisab_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faisab_pto)) < 49) OR ((LENGTH(l_faisab_pto) IS NULL)) THEN
        l_faisab_pto := l_faisab_pto || l_stript || l_strfpt;
          END IF;
      END IF;
    END LOOP; /* LOOP r004fhr */
  END IF;
  
  /* PREENCHE O RESTO DO CAMPO COM 2400 */
  l_faidom_ace := IFNULL(l_faidom_ace,'');
  IF  (l_faidom_ace IS NULL) OR (l_faidom_ace = '') THEN
      l_lengfai := 7;
      l_faidom_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faidom_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faidom_ace := l_faidom_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faidom_pto := IFNULL(l_faidom_pto,'');
  IF  (l_faidom_pto IS NULL) OR (l_faidom_pto = '') THEN
      l_lengfai := 7;
      l_faidom_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faidom_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faidom_pto := l_faidom_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiseg_ace := IFNULL(l_faiseg_ace,'');
  IF  (l_faiseg_ace IS NULL) OR (l_faiseg_ace = '') THEN
      l_lengfai := 7;
      l_faiseg_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiseg_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiseg_ace := l_faiseg_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiseg_pto := IFNULL(l_faiseg_pto,'');
  IF  (l_faiseg_pto IS NULL) OR (l_faiseg_pto = '') THEN
      l_lengfai := 7;
      l_faiseg_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiseg_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiseg_pto := l_faiseg_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiter_ace := IFNULL(l_faiter_ace,'');
  IF  (l_faiter_ace IS NULL) OR (l_faiter_ace = '') THEN
      l_lengfai := 7;
      l_faiter_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiter_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiter_ace := l_faiter_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiter_pto := IFNULL(l_faiter_pto,'');
  IF  (l_faiter_pto IS NULL) OR (l_faiter_pto = '') THEN
      l_lengfai := 7;
      l_faiter_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiter_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiter_pto := l_faiter_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqua_ace := IFNULL(l_faiqua_ace,'');
  IF  (l_faiqua_ace IS NULL) OR (l_faiqua_ace = '') THEN
      l_lengfai := 7;
      l_faiqua_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqua_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqua_ace := l_faiqua_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqua_pto := IFNULL(l_faiqua_pto,'');
  IF  (l_faiqua_pto IS NULL) OR (l_faiqua_pto = '') THEN
      l_lengfai := 7;
      l_faiqua_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqua_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqua_pto := l_faiqua_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqui_ace := IFNULL(l_faiqui_ace,'');
  IF  (l_faiqui_ace IS NULL) OR (l_faiqui_ace = '') THEN
      l_lengfai := 7;
      l_faiqui_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqui_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqui_ace := l_faiqui_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqui_pto := IFNULL(l_faiqui_pto,'');
  IF  (l_faiqui_pto IS NULL) OR (l_faiqui_pto = '') THEN
      l_lengfai := 7;
      l_faiqui_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqui_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqui_pto := l_faiqui_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisex_ace := IFNULL(l_faisex_ace,'');
  IF  (l_faisex_ace IS NULL) OR (l_faisex_ace = '') THEN
      l_lengfai := 7;
      l_faisex_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisex_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisex_ace := l_faisex_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisex_pto := IFNULL(l_faisex_pto,'');
  IF  (l_faisex_pto IS NULL) OR (l_faisex_pto = '') THEN
      l_lengfai := 7;
      l_faisex_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisex_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisex_pto := l_faisex_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisab_ace := IFNULL(l_faisab_ace,'');
  IF  (l_faisab_ace IS NULL) OR (l_faisab_ace = '') THEN
      l_lengfai := 7;
      l_faisab_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisab_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisab_ace := l_faisab_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisab_pto := IFNULL(l_faisab_pto,'');
  IF  (l_faisab_pto IS NULL) OR (l_faisab_pto = '') THEN
      l_lengfai := 7;
      l_faisab_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisab_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisab_pto := l_faisab_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  /* monta a faixa do refeitorio que deve sempre comecar pelo domingo. */
  p_fairef := '24002400240024002400240024002400240024002400240024002400';

  l_faidom_ace  := SUBSTRING(l_faidom_ace,1,56);
  l_faiseg_ace  := SUBSTRING(l_faiseg_ace,1,56);
  l_faiter_ace  := SUBSTRING(l_faiter_ace,1,56);
  l_faiqua_ace  := SUBSTRING(l_faiqua_ace,1,56);
  l_faiqui_ace  := SUBSTRING(l_faiqui_ace,1,56);
  l_faisex_ace  := SUBSTRING(l_faisex_ace,1,56);
  l_faisab_ace  := SUBSTRING(l_faisab_ace,1,56);
  l_faidom_pto  := SUBSTRING(l_faidom_pto,1,56);
  l_faiseg_pto  := SUBSTRING(l_faiseg_pto,1,56);
  l_faiter_pto  := SUBSTRING(l_faiter_pto,1,56);
  l_faiqua_pto  := SUBSTRING(l_faiqua_pto,1,56);
  l_faiqui_pto  := SUBSTRING(l_faiqui_pto,1,56);
  l_faisex_pto  := SUBSTRING(l_faisex_pto,1,56);
  l_faisab_pto  := SUBSTRING(l_faisab_pto,1,56);

  p_faidom_ace  := l_faidom_ace;
  p_faiseg_ace  := l_faiseg_ace;
  p_faiter_ace  := l_faiter_ace;
  p_faiqua_ace  := l_faiqua_ace;
  p_faiqui_ace  := l_faiqui_ace;
  p_faisex_ace  := l_faisex_ace;
  p_faisab_ace  := l_faisab_ace;
  p_faidom_pto  := l_faidom_pto;
  p_faiseg_pto  := l_faiseg_pto;
  p_faiter_pto  := l_faiter_pto;
  p_faiqua_pto  := l_faiqua_pto;
  p_faiqui_pto  := l_faiqui_pto;
  p_faisex_pto  := l_faisex_pto;
  p_faisab_pto  := l_faisab_pto;
END		SENIOR;22SP_INTSTR
!7␀␀


PROCEDURE SP_FAIRES(P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56))
 IS

l_data_atual  DATE;
  l_striac      CHAR(4);
  l_strfac      CHAR(4);
  l_stript      CHAR(4);
  l_strfpt      CHAR(4);
  l_faidom_ace  VARCHAR2(255);
  l_faiseg_ace  VARCHAR2(255);
  l_faiter_ace  VARCHAR2(255);
  l_faiqua_ace  VARCHAR2(255);
  l_faiqui_ace  VARCHAR2(255);
  l_faisex_ace  VARCHAR2(255);
  l_faisab_ace  VARCHAR2(255);
  l_faidom_pto  VARCHAR2(255);
  l_faiseg_pto  VARCHAR2(255);
  l_faiter_pto  VARCHAR2(255);
  l_faiqua_pto  VARCHAR2(255);
  l_faiqui_pto  VARCHAR2(255);
  l_faisex_pto  VARCHAR2(255);
  l_faisab_pto  VARCHAR2(255);
  l_contfai     INTEGER;
  l_lengfai     INTEGER;
  l_data_zero   DATE;
  l_horseg      NUMBER(4);
  l_horter      NUMBER(4);
  l_horqua      NUMBER(4);
  l_horqui      NUMBER(4);
  l_horsex      NUMBER(4);
  l_horsab      NUMBER(4);
  l_hordom      NUMBER(4);
  l_dia_semana  NUMBER(1);
  L_NODATAFOUND  BOOLEAN;

  /* HORÁRIOS */
  CURSOR c_r004fhr IS
  SELECT CODHOR,INIACE,FIMACE,INIPTO,FIMPTO FROM R004FHR;
  TYPE t_r004fhr IS RECORD(
      CODHOR   R004FHR.CODHOR%TYPE,
      INIACE   R004FHR.INIACE%TYPE,
      FIMACE   R004FHR.FIMACE%TYPE,
      INIPTO   R004FHR.INIPTO%TYPE,
      FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;

BEGIN
  /* Inicializa */
  l_data_zero := '31/12/1900,00:00:00';
  l_data_atual:= CURDATE();

  l_faidom_ace  := '';
  l_faiseg_ace  := '';
  l_faiter_ace  := '';
  l_faiqua_ace  := '';
  l_faiqui_ace  := '';
  l_faisex_ace  := '';
  l_faisab_ace  := '';
  l_faidom_pto  := '';
  l_faiseg_pto  := '';
  l_faiter_pto  := '';
  l_faiqua_pto  := '';
  l_faiqui_pto  := '';
  l_faisex_pto  := '';
  l_faisab_pto  := '';

  L_NODATAFOUND:=FALSE;
  BEGIN
    SELECT CODHOR HORSEG,CODHOR HORTER,CODHOR HORQUA,CODHOR HORQUI,CODHOR HORSEX,HORSAB,HORDOM
    INTO l_horseg,l_horter,l_horqua,l_horqui,l_horsex,l_horsab,l_hordom
    FROM R073RES WHERE TIPDOC = p_tipdoc AND NUMDOC = p_numdoc;
  EXCEPTION
    WHEN OTHERS THEN L_NODATAFOUND:=TRUE;
  END;
  IF  L_NODATAFOUND = FALSE THEN
    FOREACH c_r004fhr INTO l_r004fhr.codhor,
             l_r004fhr.iniace,
             l_r004fhr.fimace,
             l_r004fhr.inipto,
             l_r004fhr.fimpto
    LOOP
      SP_INTSTR(l_r004fhr.iniace,'HHMM',l_striac OUT);
      SP_INTSTR(l_r004fhr.fimace,'HHMM',l_strfac OUT);
      SP_INTSTR(l_r004fhr.inipto,'HHMM',l_stript OUT);
      SP_INTSTR(l_r004fhr.fimpto,'HHMM',l_strfpt OUT);

      IF  (l_r004fhr.codhor = l_hordom) THEN
          /* domingo */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faidom_ace)) < 49) OR ((LENGTH(l_faidom_ace) IS NULL)) THEN
        l_faidom_ace := l_faidom_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faidom_pto)) < 49) OR ((LENGTH(l_faidom_pto) IS NULL)) THEN
        l_faidom_pto := l_faidom_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horseg) THEN
          /* segunda-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiseg_ace)) < 49) OR ((LENGTH(l_faiseg_ace) IS NULL)) THEN
        l_faiseg_ace := l_faiseg_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiseg_pto)) < 49) OR ((LENGTH(l_faiseg_pto) IS NULL)) THEN
        l_faiseg_pto := l_faiseg_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horter) THEN
          /* terça-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiter_ace)) < 49) OR ((LENGTH(l_faiter_ace) IS NULL)) THEN
        l_faiter_ace := l_faiter_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiter_pto)) < 49) OR ((LENGTH(l_faiter_pto) IS NULL)) THEN
        l_faiter_pto := l_faiter_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horqua) THEN
          /* quarta-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiqua_ace)) < 49) OR ((LENGTH(l_faiqua_ace) IS NULL)) THEN
        l_faiqua_ace := l_faiqua_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiqua_pto)) < 49) OR ((LENGTH(l_faiqua_pto) IS NULL)) THEN
        l_faiqua_pto := l_faiqua_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horqui) THEN
          /* quinta-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiqui_ace)) < 49) OR ((LENGTH(l_faiqui_ace) IS NULL)) THEN
        l_faiqui_ace := l_faiqui_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiqui_pto)) < 49) OR ((LENGTH(l_faiqui_pto) IS NULL)) THEN
        l_faiqui_pto := l_faiqui_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horsex) THEN
          /* sexta-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faisex_ace)) < 49) OR ((LENGTH(l_faisex_ace) IS NULL)) THEN
        l_faisex_ace := l_faisex_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faisex_pto)) < 49) OR ((LENGTH(l_faisex_pto) IS NULL)) THEN
        l_faisex_pto := l_faisex_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horsab) THEN
          /* sábado */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faisab_ace)) < 49) OR ((LENGTH(l_faisab_ace) IS NULL)) THEN
        l_faisab_ace := l_faisab_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faisab_pto)) < 49) OR ((LENGTH(l_faisab_pto) IS NULL)) THEN
        l_faisab_pto := l_faisab_pto || l_stript || l_strfpt;
          END IF;
      END IF;
    END LOOP; /* LOOP r004fhr */
  END IF;
  
  /* PREENCHE O RESTO DO CAMPO COM 2400 */
  l_faidom_ace := IFNULL(l_faidom_ace,'');
  IF  (l_faidom_ace IS NULL) OR (l_faidom_ace = '') THEN
      l_lengfai := 7;
      l_faidom_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faidom_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faidom_ace := l_faidom_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faidom_pto := IFNULL(l_faidom_pto,'');
  IF  (l_faidom_pto IS NULL) OR (l_faidom_pto = '') THEN
      l_lengfai := 7;
      l_faidom_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faidom_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faidom_pto := l_faidom_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiseg_ace := IFNULL(l_faiseg_ace,'');
  IF  (l_faiseg_ace IS NULL) OR (l_faiseg_ace = '') THEN
      l_lengfai := 7;
      l_faiseg_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiseg_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiseg_ace := l_faiseg_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiseg_pto := IFNULL(l_faiseg_pto,'');
  IF  (l_faiseg_pto IS NULL) OR (l_faiseg_pto = '') THEN
      l_lengfai := 7;
      l_faiseg_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiseg_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiseg_pto := l_faiseg_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiter_ace := IFNULL(l_faiter_ace,'');
  IF  (l_faiter_ace IS NULL) OR (l_faiter_ace = '') THEN
      l_lengfai := 7;
      l_faiter_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiter_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiter_ace := l_faiter_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiter_pto := IFNULL(l_faiter_pto,'');
  IF  (l_faiter_pto IS NULL) OR (l_faiter_pto = '') THEN
      l_lengfai := 7;
      l_faiter_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiter_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiter_pto := l_faiter_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqua_ace := IFNULL(l_faiqua_ace,'');
  IF  (l_faiqua_ace IS NULL) OR (l_faiqua_ace = '') THEN
      l_lengfai := 7;
      l_faiqua_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqua_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqua_ace := l_faiqua_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqua_pto := IFNULL(l_faiqua_pto,'');
  IF  (l_faiqua_pto IS NULL) OR (l_faiqua_pto = '') THEN
      l_lengfai := 7;
      l_faiqua_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqua_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqua_pto := l_faiqua_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqui_ace := IFNULL(l_faiqui_ace,'');
  IF  (l_faiqui_ace IS NULL) OR (l_faiqui_ace = '') THEN
      l_lengfai := 7;
      l_faiqui_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqui_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqui_ace := l_faiqui_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqui_pto := IFNULL(l_faiqui_pto,'');
  IF  (l_faiqui_pto IS NULL) OR (l_faiqui_pto = '') THEN
      l_lengfai := 7;
      l_faiqui_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiqui_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiqui_pto := l_faiqui_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisex_ace := IFNULL(l_faisex_ace,'');
  IF  (l_faisex_ace IS NULL) OR (l_faisex_ace = '') THEN
      l_lengfai := 7;
      l_faisex_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisex_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisex_ace := l_faisex_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisex_pto := IFNULL(l_faisex_pto,'');
  IF  (l_faisex_pto IS NULL) OR (l_faisex_pto = '') THEN
      l_lengfai := 7;
      l_faisex_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisex_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisex_pto := l_faisex_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisab_ace := IFNULL(l_faisab_ace,'');
  IF  (l_faisab_ace IS NULL) OR (l_faisab_ace = '') THEN
      l_lengfai := 7;
      l_faisab_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisab_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisab_ace := l_faisab_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faisab_pto := IFNULL(l_faisab_pto,'');
  IF  (l_faisab_pto IS NULL) OR (l_faisab_pto = '') THEN
      l_lengfai := 7;
      l_faisab_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faisab_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faisab_pto := l_faisab_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  /* monta a faixa do refeitorio que deve sempre comecar pelo domingo. */
  p_fairef := '24002400240024002400240024002400240024002400240024002400';

  l_faidom_ace  := SUBSTRING(l_faidom_ace,1,56);
  l_faiseg_ace  := SUBSTRING(l_faiseg_ace,1,56);
  l_faiter_ace  := SUBSTRING(l_faiter_ace,1,56);
  l_faiqua_ace  := SUBSTRING(l_faiqua_ace,1,56);
  l_faiqui_ace  := SUBSTRING(l_faiqui_ace,1,56);
  l_faisex_ace  := SUBSTRING(l_faisex_ace,1,56);
  l_faisab_ace  := SUBSTRING(l_faisab_ace,1,56);
  l_faidom_pto  := SUBSTRING(l_faidom_pto,1,56);
  l_faiseg_pto  := SUBSTRING(l_faiseg_pto,1,56);
  l_faiter_pto  := SUBSTRING(l_faiter_pto,1,56);
  l_faiqua_pto  := SUBSTRING(l_faiqua_pto,1,56);
  l_faiqui_pto  := SUBSTRING(l_faiqui_pto,1,56);
  l_faisex_pto  := SUBSTRING(l_faisex_pto,1,56);
  l_faisab_pto  := SUBSTRING(l_faisab_pto,1,56);

  p_faidom_ace  := l_faidom_ace;
  p_faiseg_ace  := l_faiseg_ace;
  p_faiter_ace  := l_faiter_ace;
  p_faiqua_ace  := l_faiqua_ace;
  p_faiqui_ace  := l_faiqui_ace;
  p_faisex_ace  := l_faisex_ace;
  p_faisab_ace  := l_faisab_ace;
  p_faidom_pto  := l_faidom_pto;
  p_faiseg_pto  := l_faiseg_pto;
  p_faiter_pto  := l_faiter_pto;
  p_faiqua_pto  := l_faiqua_pto;
  p_faiqui_pto  := l_faiqui_pto;
  p_faisex_pto  := l_faisex_pto;
  p_faisab_pto  := l_faisab_pto;
END		SENIOR;23SP_INTSTR
!7␀␀


PROCEDURE SP_FAIRES(P_TIPDOC NUMBER(1),P_NUMDOC VARCHAR2(20),P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56))
 IS

l_data_atual  DATE;
  l_striac      CHAR(4);
  l_strfac      CHAR(4);
  l_stript      CHAR(4);
  l_strfpt      CHAR(4);
  l_faidom_ace  VARCHAR2(255);
  l_faiseg_ace  VARCHAR2(255);
  l_faiter_ace  VARCHAR2(255);
  l_faiqua_ace  VARCHAR2(255);
  l_faiqui_ace  VARCHAR2(255);
  l_faisex_ace  VARCHAR2(255);
  l_faisab_ace  VARCHAR2(255);
  l_faidom_pto  VARCHAR2(255);
  l_faiseg_pto  VARCHAR2(255);
  l_faiter_pto  VARCHAR2(255);
  l_faiqua_pto  VARCHAR2(255);
  l_faiqui_pto  VARCHAR2(255);
  l_faisex_pto  VARCHAR2(255);
  l_faisab_pto  VARCHAR2(255);
  l_contfai     INTEGER;
  l_lengfai     INTEGER;
  l_data_zero   DATE;
  l_horseg      NUMBER(4);
  l_horter      NUMBER(4);
  l_horqua      NUMBER(4);
  l_horqui      NUMBER(4);
  l_horsex      NUMBER(4);
  l_horsab      NUMBER(4);
  l_hordom      NUMBER(4);
  l_dia_semana  NUMBER(1);
  L_NODATAFOUND  BOOLEAN;

  /* HORÁRIOS */
  CURSOR c_r004fhr IS
  SELECT CODHOR,INIACE,FIMACE,INIPTO,FIMPTO FROM R004FHR;
  TYPE t_r004fhr IS RECORD(
      CODHOR   R004FHR.CODHOR%TYPE,
      INIACE   R004FHR.INIACE%TYPE,
      FIMACE   R004FHR.FIMACE%TYPE,
      INIPTO   R004FHR.INIPTO%TYPE,
      FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;

BEGIN
  /* Inicializa */
  l_data_zero := '31/12/1900,00:00:00';
  l_data_atual:= CURDATE();

  l_faidom_ace  := '';
  l_faiseg_ace  := '';
  l_faiter_ace  := '';
  l_faiqua_ace  := '';
  l_faiqui_ace  := '';
  l_faisex_ace  := '';
  l_faisab_ace  := '';
  l_faidom_pto  := '';
  l_faiseg_pto  := '';
  l_faiter_pto  := '';
  l_faiqua_pto  := '';
  l_faiqui_pto  := '';
  l_faisex_pto  := '';
  l_faisab_pto  := '';

  L_NODATAFOUND:=FALSE;
  BEGIN
    SELECT CODHOR HORSEG,CODHOR HORTER,CODHOR HORQUA,CODHOR HORQUI,CODHOR HORSEX,HORSAB,HORDOM
    INTO l_horseg,l_horter,l_horqua,l_horqui,l_horsex,l_horsab,l_hordom
    FROM R073RES WHERE TIPDOC = p_tipdoc AND NUMDOC = p_numdoc;
  EXCEPTION
    WHEN OTHERS THEN L_NODATAFOUND:=TRUE;
  END;
  IF  L_NODATAFOUND = FALSE THEN
    FOREACH c_r004fhr INTO l_r004fhr.codhor,
             l_r004fhr.iniace,
             l_r004fhr.fimace,
             l_r004fhr.inipto,
             l_r004fhr.fimpto
    LOOP
      SP_INTSTR(l_r004fhr.iniace,'HHMM',l_striac OUT);
      SP_INTSTR(l_r004fhr.fimace,'HHMM',l_strfac OUT);
      SP_INTSTR(l_r004fhr.inipto,'HHMM',l_stript OUT);
      SP_INTSTR(l_r004fhr.fimpto,'HHMM',l_strfpt OUT);

      IF  (l_r004fhr.codhor = l_hordom) THEN
          /* domingo */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faidom_ace)) < 49) OR ((LENGTH(l_faidom_ace) IS NULL)) THEN
        l_faidom_ace := l_faidom_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faidom_pto)) < 49) OR ((LENGTH(l_faidom_pto) IS NULL)) THEN
        l_faidom_pto := l_faidom_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horseg) THEN
          /* segunda-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiseg_ace)) < 49) OR ((LENGTH(l_faiseg_ace) IS NULL)) THEN
        l_faiseg_ace := l_faiseg_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiseg_pto)) < 49) OR ((LENGTH(l_faiseg_pto) IS NULL)) THEN
        l_faiseg_pto := l_faiseg_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horter) THEN
          /* terça-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiter_ace)) < 49) OR ((LENGTH(l_faiter_ace) IS NULL)) THEN
        l_faiter_ace := l_faiter_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiter_pto)) < 49) OR ((LENGTH(l_faiter_pto) IS NULL)) THEN
        l_faiter_pto := l_faiter_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horqua) THEN
          /* quarta-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiqua_ace)) < 49) OR ((LENGTH(l_faiqua_ace) IS NULL)) THEN
        l_faiqua_ace := l_faiqua_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiqua_pto)) < 49) OR ((LENGTH(l_faiqua_pto) IS NULL)) THEN
        l_faiqua_pto := l_faiqua_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horqui) THEN
          /* quinta-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faiqui_ace)) < 49) OR ((LENGTH(l_faiqui_ace) IS NULL)) THEN
        l_faiqui_ace := l_faiqui_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faiqui_pto)) < 49) OR ((LENGTH(l_faiqui_pto) IS NULL)) THEN
        l_faiqui_pto := l_faiqui_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horsex) THEN
          /* sexta-feira */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faisex_ace)) < 49) OR ((LENGTH(l_faisex_ace) IS NULL)) THEN
        l_faisex_ace := l_faisex_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faisex_pto)) < 49) OR ((LENGTH(l_faisex_pto) IS NULL)) THEN
        l_faisex_pto := l_faisex_pto || l_stript || l_strfpt;
          END IF;
      END IF;
      IF  (l_r004fhr.codhor = l_horsab) THEN
          /* sábado */
          IF  (l_r004fhr.iniace <> 0) AND (l_r004fhr.fimace <> 0) AND ((LENGTH(l_faisab_ace)) < 49) OR ((LENGTH(l_faisab_ace) IS NULL)) THEN
        l_faisab_ace := l_faisab_ace || l_striac || l_strfac;
          END IF;
          IF  (l_r004fhr.inipto <> 0) AND (l_r004fhr.fimpto <> 0) AND ((LENGTH(l_faisab_pto)) < 49) OR ((LENGTH(l_faisab_pto) IS NULL)) THEN
        l_faisab_pto := l_faisab_pto || l_stript || l_strfpt;
          END IF;
      END IF;
    END LOOP; /* LOOP r004fhr */
  END IF;
  
  /* PREENCHE O RESTO DO CAMPO COM 2400 */
  l_faidom_ace := IFNULL(l_faidom_ace,'');
  IF  (l_faidom_ace IS NULL) OR (l_faidom_ace = '') THEN
      l_lengfai := 7;
      l_faidom_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faidom_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faidom_ace := l_faidom_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faidom_pto := IFNULL(l_faidom_pto,'');
  IF  (l_faidom_pto IS NULL) OR (l_faidom_pto = '') THEN
      l_lengfai := 7;
      l_faidom_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faidom_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faidom_pto := l_faidom_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiseg_ace := IFNULL(l_faiseg_ace,'');
  IF  (l_faiseg_ace IS NULL) OR (l_faiseg_ace = '') THEN
      l_lengfai := 7;
      l_faiseg_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiseg_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiseg_ace := l_faiseg_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiseg_pto := IFNULL(l_faiseg_pto,'');
  IF  (l_faiseg_pto IS NULL) OR (l_faiseg_pto = '') THEN
      l_lengfai := 7;
      l_faiseg_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiseg_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiseg_pto := l_faiseg_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiter_ace := IFNULL(l_faiter_ace,'');
  IF  (l_faiter_ace IS NULL) OR (l_faiter_ace = '') THEN
      l_lengfai := 7;
      l_faiter_ace := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiter_ace)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiter_ace := l_faiter_ace || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiter_pto := IFNULL(l_faiter_pto,'');
  IF  (l_faiter_pto IS NULL) OR (l_faiter_pto = '') THEN
      l_lengfai := 7;
      l_faiter_pto := '';
  ELSE
      l_lengfai := (56 - LENGTH(l_faiter_pto)) / 8;
  END IF;
  l_contfai := 0;
  LOOP
      IF  (l_contfai >= l_lengfai) THEN
          EXIT;
      END IF;
      l_faiter_pto := l_faiter_pto || '24002400';
      l_contfai := l_contfai + 1;
  END LOOP;

  l_faiqua_ace := IFNULL(l_faiqua_ace,'');
  IF  (l_faiqua_ace IS NULL) OR (l_faiqua_ace = '') THEN
      l_lengfai := 7;
      l_faiqua_ace := '';
  ELSE
