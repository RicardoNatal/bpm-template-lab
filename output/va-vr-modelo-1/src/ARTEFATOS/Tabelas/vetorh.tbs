RH_RET_DATADM
RH_DEF_ESOCIAL
š2␀␀PROCEDURE SP_E_SOCIAL(P_LAYOUT VARCHAR2(6),P_TABELA VARCHAR2(7),P_EVENTO CHAR,P_OPERACAO CHAR,P_INIVAL DATE,P_FIMVAL DATE,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_VALOR1 VARCHAR2(2000),P_VALOR2 VARCHAR2(2000),P_USUARIO NUMBER(10),P_DATAENC DATE,P_DATAREF DATE, P_PENEXT NUMBER(1), P_ORIGEM VARCHAR2(60))
 IS

  l_DataAtual DATE;
  l_DataStr VARCHAR2(8);
  l_HoraStr VARCHAR2(2);
  l_MinutoStr VARCHAR2(2);
  l_SegundoStr VARCHAR2(2);
  l_Milisegundo NUMBER;  
  l_MilisegundoStr VARCHAR2(3);  
  l_Contador NUMBER(4);
  l_ContadorStr VARCHAR2(4);
  l_DataHoraAtual NUMBER(14,6);
  l_Usuario NUMBER(10);
  l_NomeUsuario VARCHAR2(40);
  l_PidPen VARCHAR2(30);
  l_IniVal DATE;
  l_FimVal DATE;
  l_ChaveExiste VARCHAR2(1);
  l_EncontrouMatricula BOOLEAN;
  l_EncontrouMatriculaSST BOOLEAN;
  l_CarIniFeitaOuCarIni BOOLEAN;
  l_EmpresaGeraEventosFolha BOOLEAN;
  l_GerEvt   R030DES.GerEvt%TYPE;
  l_Cie NUMBER;
  l_DataEnc DATE;
  l_DataRef DATE;
  l_EmpresaStr VARCHAR2(4);
  l_LayOut VARCHAR2(5);
  l_EsocialEncerrado BOOLEAN;
  l_PendenciaExtemporanea VARCHAR2(1);
  l_EmpresaSaiuSistema BOOLEAN;
  l_PendenciaEncerramento BOOLEAN;  
  l_RealizarGeracaoPendencia  BOOLEAN;
  l_ConsideraParceiro BOOLEAN;
  l_IsLayoutSST BOOLEAN;
  l_IsLayoutFolha BOOLEAN;
  l_TratarPendenciaSST BOOLEAN;
  l_DataInicioSST DATE;
  l_DataZero DATE;
  l_DataFechamentoTreinamento DATE;
  l_IsLayoutProcTrab BOOLEAN;

  l_DataInicioTabelas DATE;
  l_DataInicioEsocial DATE; 
  l_DataInicioNaoPeriodicos DATE;
  l_DataInicioPeriodicos DATE; 
  l_DataInicioMigracao DATE;
  l_DataAdmissaoColaboradorSemMatricula DATE;
  l_statusMigracao NUMBER;
  l_exists_matricula NUMBER;
  l_IsSwapR350TMP BOOLEAN;/*Controle de swap(R350PEN <-> R350TMP) dos layouts de colaborador quando em processo de migração*/
BEGIN
  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  l_ConsideraParceiro := FALSE;
  l_IsLayoutSST := FALSE;
  l_IsLayoutFolha := FALSE;
  l_TratarPendenciaSST := FALSE;
  l_RealizarGeracaoPendencia := FALSE;
  l_DataFechamentoTreinamento := l_DataZero; 
  l_IsLayoutProcTrab := FALSE;
  l_IsSwapR350TMP := FALSE;
  
  /* Verifica se o Layout passado por parametro é de Processo Trabalhista.*/
  JR_LAYOUT_PROCTRAB(P_LAYOUT, l_IsLayoutProcTrab OUT);
  
  /* Verifica se o Layout passado por parametro é de SST.*/
  SM_LAYOUT_SST(P_LAYOUT, l_IsLayoutSST OUT);
  IF ((l_IsLayoutSST = FALSE) AND (l_IsLayoutProcTrab = FALSE)) THEN
  	
  	IF (P_LAYOUT = 'S-3000') THEN
  	  l_IsLayoutSST := TRUE;
  	END IF;
  
    l_IsLayoutFolha := TRUE;
  END IF;	
	

  IF ((p_Tipcol <> 3) OR (l_IsLayoutSST = TRUE) OR (l_IsLayoutProcTrab = TRUE)) THEN
    l_DataAtual := CURDATE();
    l_HoraStr := CONVERT(NUMBER_TO_CHAR, HOUR(CURTIME()));
    l_MinutoStr := CONVERT(NUMBER_TO_CHAR, MINUTE(CURTIME()));
    l_CarIniFeitaOuCarIni := TRUE;
    l_EncontrouMatricula := FALSE;
	l_EncontrouMatriculaSST := FALSE;
    l_Usuario := 0;
    l_ChaveExiste := NULL;
    l_Contador := 1;
    l_EsocialEncerrado := FALSE;
    l_EmpresaSaiuSistema := FALSE;
	
	/*Passando DATADM no P_INIVAL para contornar problema de trigger mutante no oracle, mais informações nos comentários da task.*/
    l_IniVal := p_IniVal;
    IF (p_IniVal IS NULL OR P_TABELA = 'R034ADM') THEN
      l_IniVal := DATETIME(31, 12, 1900, 0, 0, 0);
    END IF;

    l_FimVal := p_FimVal;
    IF (p_FimVal IS NULL) THEN
      l_FimVal := DATETIME(31, 12, 1900, 0, 0, 0);
    END IF;

    l_DataEnc := p_DataEnc;
    IF (p_DataEnc IS NULL) THEN
      l_DataEnc := DATETIME(31, 12, 1900, 0, 0, 0);
    END IF;

    l_DataRef := p_DataRef;
    IF (p_DataRef IS NULL) THEN
      l_DataRef := DATETIME(31, 12, 1900, 0, 0, 0);
    END IF;
    
    l_EmpresaGeraEventosFolha := TRUE;
    
    BEGIN
      SELECT GerEvt INTO l_GerEvt
        FROM R030DES
       WHERE NumEmp = p_NumEmp;
   
       IF ((l_GerEvt = 3) OR (l_GerEvt = 6)) THEN
         l_EmpresaGeraEventosFolha := FALSE;         
       END IF;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_EmpresaGeraEventosFolha := FALSE;        
    END;
      
	IF (l_EmpresaGeraEventosFolha = TRUE) THEN
      BEGIN
        SELECT 1 INTO l_Cie
          FROM R350STA STA, R350EMP EMP
         WHERE EMP.NUMEMP = p_NumEmp
           AND EMP.PIDEXC = STA.PIDEXC
	       AND (STA.NUMREC IS NOT NULL AND LTRIM(RTRIM(STA.NUMREC)) || 'VAZIO' <> 'VAZIO')
           AND (l_FimVal = DATETIME(31, 12, 1900, 0, 0, 0) OR EMP.INIVAL <= l_FimVal);
      EXCEPTION
        WHEN NO_DATA_FOUND THEN
          IF ('S-1000' = P_LAYOUT) THEN
            l_CarIniFeitaOuCarIni := TRUE;
          ELSE
            l_CarIniFeitaOuCarIni := FALSE;
          END IF;
        WHEN TOO_MANY_ROWS THEN
          l_CarIniFeitaOuCarIni := TRUE;
      END;
    END IF;
    
    /* Uma vez informada a data de encerramento do eSocial, não gera mais pendências*/
    BEGIN
      SELECT 1 INTO l_Cie
        FROM R030DES DES
       WHERE DES.NUMEMP = p_NumEmp           
         AND (DES.TERUES = DATETIME(31, 12, 1900, 0, 0, 0) OR DES.TERUES IS NULL);
   
       IF (l_Cie = 1) THEN
         l_EsocialEncerrado := FALSE;         
       END IF;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_EsocialEncerrado := TRUE;        
    END;	

    /* Se a empresa não está mais utilizando o sistema também não gera mais pendências*/
    BEGIN
      SELECT 1 INTO l_Cie
        FROM R030DES DES
       WHERE DES.NUMEMP = p_NumEmp
         AND (DES.TERSIS > l_DataAtual OR DES.TERSIS = DATETIME(31, 12, 1900, 0, 0, 0) OR DES.TERSIS IS NULL);
       IF (l_Cie = 1) THEN
         l_EmpresaSaiuSistema := FALSE;         
       END IF;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        l_EmpresaSaiuSistema := TRUE;        
    END;
      
    IF ((P_LAYOUT = 'S-1000') AND (p_Tabela = 'R030DES') AND (l_DataEnc <> DATETIME(31, 12, 1900, 0, 0, 0))) THEN
      l_PendenciaEncerramento := TRUE;
    ELSE
      l_PendenciaEncerramento := FALSE;
    END IF;

    IF ((l_EsocialEncerrado = FALSE AND l_EmpresaSaiuSistema = FALSE) OR (l_PendenciaEncerramento = TRUE)) THEN	
      l_RealizarGeracaoPendencia := TRUE;
    END IF;

    /* Se a alteração é referente a um evento de folha, mas a empresa não gera eventos de folha, não gera pendência */
    IF ((l_EmpresaGeraEventosFolha = FALSE) AND (l_IsLayoutFolha = TRUE AND l_IsLayoutSST = FALSE AND l_IsLayoutProcTrab = FALSE)) THEN 
      l_RealizarGeracaoPendencia := FALSE;
    END IF;

    IF ((l_CarIniFeitaOuCarIni = TRUE) AND (l_RealizarGeracaoPendencia = TRUE)) THEN	     
	  IF ((p_TipCol > 0) AND (p_NumCad > 0)) THEN
	    l_EncontrouMatricula := TRUE;
	    
        IF (p_Tabela <> 'R034MAT') THEN
          RH_NUMMAT(p_NumEmp, p_TipCol, p_NumCad, l_EncontrouMatricula OUT, l_EncontrouMatriculaSST OUT, l_DataFechamentoTreinamento OUT);
        END IF;
      END IF;
      
      IF (((p_Tabela <> 'R034MAT') AND (p_NumCad > 0)) OR (P_LAYOUT = 'S-2190')) THEN

      	SELECT IFNULL(MAX(stamig), -1), IFNULL(MAX(1), 0)  INTO l_statusMigracao, l_exists_matricula FROM R034MAT WHERE NumEmp = P_NumEmp AND tipCol = p_tipCol AND numcad = p_NumCad;

      	IF (l_exists_matricula = 0) THEN
      		/*Passando DATADM no P_INIVAL para contornar problema de trigger mutante no oracle, mais informações nos comentários da task.*/
      		IF (p_Tabela = 'R034ADM') THEN
      			l_DataAdmissaoColaboradorSemMatricula := P_INIVAL;
      		ELSE
      			RH_RET_DATADM(p_NumEmp, p_TipCol, p_NumCad, l_DataAdmissaoColaboradorSemMatricula OUT);
      		END IF;
	 		RH_DEF_ESOCIAL(p_NumEmp, l_DataInicioTabelas OUT, l_DataInicioEsocial OUT, l_DataInicioNaoPeriodicos OUT, l_DataInicioPeriodicos OUT, l_DataInicioSST OUT, l_DataInicioMigracao OUT);
      	END IF;		
    
      	IF ((l_statusMigracao = 2) OR 
      		(l_exists_matricula = 0
      			AND (l_DataInicioMigracao IS NOT NULL) 
      			AND (l_DataInicioMigracao > l_DataZero)  
      			AND (l_DataAdmissaoColaboradorSemMatricula < l_DataInicioMigracao))
      	) THEN
	      	l_IsSwapR350TMP := TRUE;
	      END IF;
      END IF;
	
      IF (((l_EncontrouMatricula = TRUE) AND (l_IsLayoutFolha = TRUE)) OR 
          ((l_EncontrouMatriculaSST = TRUE) AND (l_IsLayoutSST = TRUE)) OR 
          (p_NumCad = 0) OR (l_IsLayoutProcTrab = TRUE) OR (l_IsSwapR350TMP = TRUE)) THEN
          
        SP_DATAHORA(l_DataHoraAtual OUT, 'DH');

        IF (p_Usuario = 0) THEN
          SP_GETCODUSU(l_Usuario OUT, l_nomeUsuario OUT);
        ELSE
          l_Usuario := p_Usuario;
        END IF;
				
        SP_DATSTR(l_DataAtual, 'YYYYMMDD', l_DataStr OUT);
        IF (LENGTH(l_HoraStr)) = 1 THEN
          l_HoraStr := '0' || l_HoraStr;
        END IF;
		
        IF (LENGTH(l_MinutoStr)) = 1 THEN
          l_MinutoStr := '0' || l_MinutoStr;
        END IF;
				
        l_EmpresaStr := CONVERT(NUMBER_TO_CHAR, p_NumEmp);
        IF (LENGTH(l_EmpresaStr)) = 1 THEN
          l_EmpresaStr := '000' || l_EmpresaStr;
        END IF;	
			
        IF (LENGTH(l_EmpresaStr)) = 2 THEN						  
          l_EmpresaStr := '00' || l_EmpresaStr;
        END IF;	

        IF (LENGTH(l_EmpresaStr)) = 3 THEN						
          l_EmpresaStr := '0' || l_EmpresaStr;						
        END IF;
				
        l_LayOut := SUBSTRING(p_LayOut, 3, 6);
        l_LayOut := 'S' || l_LayOut;

        WHILE ((l_ChaveExiste = 'S') OR (l_ChaveExiste IS NULL)) LOOP
          l_SegundoStr := CONVERT(NUMBER_TO_CHAR, SECOND(CURTIME()));
          IF (LENGTH(l_SegundoStr)) = 1 THEN
            l_SegundoStr := '0' || l_SegundoStr;
          END IF;
				
          SP_MILLISECOND(l_Milisegundo OUT, 3);
          l_MilisegundoStr := CONVERT(NUMBER_TO_CHAR, l_Milisegundo);
          IF (LENGTH(l_MilisegundoStr)) = 1 THEN
            l_MilisegundoStr := '00' || l_MilisegundoStr;
          END IF;	
				
          IF (LENGTH(l_MilisegundoStr)) = 2 THEN
            l_MilisegundoStr := '0' || l_MilisegundoStr;				
          END IF;
					
          l_ContadorStr := CONVERT(NUMBER_TO_CHAR, l_Contador);
          IF (LENGTH(l_ContadorStr)) = 1 THEN
            l_ContadorStr := '000' || l_ContadorStr;
          END IF;	

          IF (LENGTH(l_ContadorStr)) = 2 THEN						
            l_ContadorStr := '00' || l_ContadorStr;
          END IF;	

          IF (LENGTH(l_ContadorStr)) = 3 THEN						
            l_ContadorStr := '0' || l_ContadorStr;						
          END IF;
					
          l_PidPen := l_EmpresaStr || l_LayOut || l_DataStr || l_HoraStr || l_MinutoStr || l_SegundoStr || l_MilisegundoStr || l_ContadorStr;  
			
          BEGIN
			IF (l_IsSwapR350TMP = TRUE) THEN 
                SELECT 'S' INTO l_ChaveExiste
                  FROM R350TMP 
                 WHERE PIDPEN = l_PidPen;
            ELSE
                SELECT 'S' INTO l_ChaveExiste
                  FROM R350PEN 
                WHERE PIDPEN = l_PidPen;
            END IF;
					
            IF (l_ChaveExiste = 'S') THEN
			  l_Contador := l_Contador + 1;
			ELSE
              l_ChaveExiste := 'N';
            END IF;
          EXCEPTION
			WHEN NO_DATA_FOUND THEN
			  l_ChaveExiste := 'N';
          END;			
		END LOOP;

        l_PendenciaExtemporanea := 'N';
		IF (P_PENEXT = 1) THEN
		  l_PendenciaExtemporanea := 'S';
		END IF;

		IF (l_IsSwapR350TMP = TRUE) THEN
			BEGIN
				INSERT INTO R350TMP(PidPen, DatHor, TabPen, OpePen, EvePen, UsuPen, NumEmp, FilEmp, TipCol, NumCad, IniVal, FimVal, VlrPe1, VlrPe2, LayOut, DatEnc, DatRef, PenExt, OriPen) 
            	VALUES(l_PidPen, l_DataHoraAtual, p_Tabela, p_Operacao, p_Evento, l_Usuario, p_NumEmp, 0, p_TipCol, p_NumCad, l_IniVal, l_FimVal, p_Valor1, p_Valor2, p_LayOut, l_DataEnc, l_DataRef, l_PendenciaExtemporanea, P_ORIGEM);
			EXCEPTION
              WHEN DUPVALONINDEX THEN
                RAISERROR 103 'Erro ao inserir registro duplicado na tabela de Pendências temporárias do eSocial.';
              WHEN OTHERS THEN
                RAISERROR 103 'Erro ao inserir registro na tabela de Pendênciass temporárias do eSocial.';
          	END;
		ELSE BEGIN
			INSERT INTO R350PEN(PidPen, DatHor, TabPen, OpePen, EvePen, UsuPen, NumEmp, FilEmp, TipCol, NumCad, IniVal, FimVal, VlrPe1, VlrPe2, LayOut, DatEnc, DatRef, PenExt, OriPen) 
			VALUES(l_PidPen, l_DataHoraAtual, p_Tabela, p_Operacao, p_Evento, l_Usuario, p_NumEmp, 0, p_TipCol, p_NumCad, l_IniVal, l_FimVal, p_Valor1, p_Valor2, p_LayOut, l_DataEnc, l_DataRef, l_PendenciaExtemporanea, P_ORIGEM);
		EXCEPTION
		  WHEN DUPVALONINDEX THEN
		    RAISERROR 103 'Erro ao inserir registro duplicado na tabela de Pendências eSocial.';
		  WHEN OTHERS THEN
			RAISERROR 103 'Erro ao inserir registro na tabela de Pendências eSocial.';
		  END;
		END IF;		
      END IF;	  
	END IF;
  END IF;
END␀1ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0‚SP_E_SOCIAL
RH_RET_DATINISST
SM_LAYOUT_SST
RH_VER_MODULO_PRP
SM_CONPAR_SST
RH_LAYOUTCOLAB
N_GR_PEN_BENEF
SP_GERPEN_EVTSST
Ÿ␀␀PROCEDURE SP_E_SOCIAL_SM(P_LAYOUT VARCHAR2(6),P_TABELA VARCHAR2(7),P_EVENTO CHAR,P_OPERACAO CHAR,P_INIVAL DATE,P_FIMVAL DATE,P_NUMEMP NUMBER(4),P_TIPCOL NUMBER(1),P_NUMCAD NUMBER(9),P_VALOR1 VARCHAR2(2000),P_VALOR2 VARCHAR2(2000),P_USUARIO NUMBER(10),P_DATAENC DATE,P_DATAREF DATE, P_PENEXT NUMBER(1), P_ORIGEM VARCHAR2(60))
 IS

  l_DataInicioSST DATE;
  l_DataZero DATE;  
  l_IsLayoutSST BOOLEAN;    
  l_ConsideraParceiro BOOLEAN;
  l_TratarPendenciaSST BOOLEAN;  
  l_GerarPendencia BOOLEAN;  
  l_layout VARCHAR2(6);
  l_PosLayExc INTEGER;
  l_LayExc VARCHAR2(6); 
  l_TemModSeguranca BOOLEAN; 
  l_Qtd        NUMBER(5);
  l_GeraPendecia2240 BOOLEAN; 
  l_TemMod       VARCHAR2(1);
BEGIN
  l_DataZero := DATETIME(31, 12, 1900, 0, 0, 0);
  l_IsLayoutSST := FALSE;
  l_ConsideraParceiro := FALSE;
  l_TratarPendenciaSST := FALSE;
  l_GerarPendencia := TRUE;  
      
  IF ((P_TIPCOL > 0) AND (P_NUMCAD > 0)) THEN
	RH_LAYOUTCOLAB(P_NUMEMP, P_TIPCOL, P_NUMCAD, l_layout OUT);
	 IF (l_layout IS NOT NULL)THEN
	 	N_GR_PEN_BENEF(l_layout, l_GerarPendencia OUT);  
	 END IF;	
  END IF;
    
  SM_LAYOUT_SST(P_LAYOUT, l_IsLayoutSST OUT);  	
	
  IF ((l_IsLayoutSST = TRUE OR P_LAYOUT = 'S-3000') AND (l_GerarPendencia = TRUE)) THEN
    RH_RET_DATINISST(P_NUMEMP, l_DataInicioSST OUT);
    
    l_GeraPendecia2240 := FALSE;
    IF ((l_DataInicioSST > l_DataZero ) AND ( P_LAYOUT = 'S-2240'))  THEN
      RH_VER_MODULO_PRP(10, l_TemMod OUT); /* MÓDULO SEGURANÇA */
      IF (l_TemMod = 'S') THEN
          l_TemModSeguranca    := TRUE;
      END IF ;
      
      l_Qtd := 0;
      /*verifica se tem assinalamento para SST*/
      IF  (l_TemModSeguranca = TRUE) THEN
      BEGIN
         SELECT COUNT(1) INTO l_Qtd FROM R030COS WHERE NUMEMP = P_NUMEMP AND GS2240 IN (1,2) ;
         EXCEPTION
         WHEN NO_DATA_FOUND THEN
           l_Qtd:=0;
         WHEN OTHERS THEN
           RAISERROR 103 'Erro no SELECT R030COS - em SP_E_SOCIAL_SM';
        END;
       
        IF ( l_Qtd > 0 ) THEN
          l_GeraPendecia2240 := TRUE;
        END IF;
      END IF;
    END IF;    
    
    IF (l_DataInicioSST > l_DataZero) THEN
      /* Verifica se a data de referencia é maior do que o início do SST */
      IF (P_DATAREF >= l_DataInicioSST) THEN
  	    l_TratarPendenciaSST := TRUE;
      END IF;
      
      /* Quando é evento de tabelas SST apenas cria pendência sem consistir datas */
      IF (P_EVENTO = 'T') THEN
        l_TratarPendenciaSST := TRUE;
      END IF;
      
      IF ((P_LAYOUT = 'S-2240') AND (l_GeraPendecia2240 = FALSE)) THEN
         l_TratarPendenciaSST := FALSE;
      END IF;
      
      SM_CONPAR_SST(P_NUMEMP, l_ConsideraParceiro OUT);
    END IF;
	
	IF ((l_TratarPendenciaSST = TRUE) AND ((p_Tipcol <> 3) OR (l_ConsideraParceiro = TRUE))) THEN
	  SP_E_SOCIAL(P_LAYOUT, P_TABELA, P_EVENTO ,P_OPERACAO, P_INIVAL, P_FIMVAL, P_NUMEMP, P_TIPCOL, P_NUMCAD, P_VALOR1, P_VALOR2, P_USUARIO, P_DATAENC, P_DATAREF, P_PENEXT, P_ORIGEM);
	END IF;
  END IF;
END␀2ø␀␀ÿÿÿÿÿÿÿÿ	SENIOR;0
␀␀PROCEDURE SP_FAIALU(P_NUMMAT VARCHAR2(15),P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56))
 IS
BEGIN
  NULL;
END		SENIOR;20SP_INTSTR
»y␀␀


PROCEDURE SP_FAIALU(P_NUMMAT VARCHAR2(15),P_FAIDOM_ACE OUT VARCHAR2(56),P_FAISEG_ACE OUT VARCHAR2(56),P_FAITER_ACE OUT VARCHAR2(56),P_FAIQUA_ACE OUT VARCHAR2(56),P_FAIQUI_ACE OUT VARCHAR2(56),P_FAISEX_ACE OUT VARCHAR2(56),P_FAISAB_ACE OUT VARCHAR2(56),P_FAIDOM_PTO OUT VARCHAR2(56),P_FAISEG_PTO OUT VARCHAR2(56),P_FAITER_PTO OUT VARCHAR2(56),P_FAIQUA_PTO OUT VARCHAR2(56),P_FAIQUI_PTO OUT VARCHAR2(56),P_FAISEX_PTO OUT VARCHAR2(56),P_FAISAB_PTO OUT VARCHAR2(56),P_FAIREF OUT VARCHAR2(56))
 IS

l_data_atual  DATE;
  l_striac      CHAR(4);
  l_strfac      CHAR(4);
  l_stript      CHAR(4);
  l_strfpt      CHAR(4);
  l_faidom_ace  VARCHAR2(255);
  l_faiseg_ace  VARCHAR2(255);
  l_faiter_ace  VARCHAR2(255);
  l_faiqua_ace  VARCHAR2(255);
  l_faiqui_ace  VARCHAR2(255);
  l_faisex_ace  VARCHAR2(255);
  l_faisab_ace  VARCHAR2(255);
  l_faidom_pto  VARCHAR2(255);
  l_faiseg_pto  VARCHAR2(255);
  l_faiter_pto  VARCHAR2(255);
  l_faiqua_pto  VARCHAR2(255);
  l_faiqui_pto  VARCHAR2(255);
  l_faisex_pto  VARCHAR2(255);
  l_faisab_pto  VARCHAR2(255);
  l_contfai     INTEGER;
  l_lengfai     INTEGER;
  l_data_zero   DATE;
  l_horseg      NUMBER(4);
  l_horter      NUMBER(4);
  l_horqua      NUMBER(4);
  l_horqui      NUMBER(4);
  l_horsex      NUMBER(4);
  l_horsab      NUMBER(4);
  l_hordom      NUMBER(4);
  l_dia_semana  NUMBER(1);
  l_tipcra      NUMBER(1);
  l_count       NUMBER(2);

  /* DISCIPLINAS DOS ALUNOS */
  CURSOR c_r073dia IS
  SELECT CURALU,CODFAS,CODDPF,TMAALU  FROM R073DIA WHERE
      NUMMAT = p_nummat AND DATINI <= l_data_atual AND ((DATFIM >= l_data_atual) OR (DATFIM = l_data_zero)) ORDER BY 1;
  TYPE t_r073dia IS RECORD(
      CURALU   R073DIA.CURALU%TYPE,
      CODFAS   R073DIA.CODFAS%TYPE,
      CODDPF   R073DIA.CODDPF%TYPE,
      TMAALU   R073DIA.TMAALU%TYPE);
  l_r073dia t_r073dia;

  /* HORÁRIOS */
  CURSOR c_r004fhr IS
  SELECT CODHOR,INIACE,FIMACE,INIPTO,FIMPTO FROM R004FHR;
  TYPE t_r004fhr IS RECORD(
      CODHOR   R004FHR.CODHOR%TYPE,
      INIACE   R004FHR.INIACE%TYPE,
      FIMACE   R004FHR.FIMACE%TYPE,
      INIPTO   R004FHR.INIPTO%TYPE,
      FIMPTO   R004FHR.FIMPTO%TYPE);
  l_r004fhr t_r004fhr;

  /* ATIVIDADES DO ALUNO*/
  CURSOR c_r073ata IS
  SELECT NUMMAT,DATINI,DATFIM,HORSEG,HORTER,HORQUA,HORQUI,HORSEX,HORSAB,HORDOM
      FROM R073ATA WHERE
      NUMMAT = p_nummat AND DATINI <= l_data_atual AND ((DATFIM >= l_data_atual) OR (DATFIM = l_data_zero))
      ORDER BY 1;
  TYPE t_r073ata IS RECORD(
      NUMMAT   R073ATA.NUMMAT%TYPE,
      DATINI   R073ATA.DATINI%TYPE,
      DATFIM   R073ATA.DATFIM%TYPE,
      HORSEG   R073ATA.HORSEG%TYPE,
      HORTER   R073ATA.HORTER%TYPE,
      HORQUA   R073ATA.HORQUA%TYPE,
      HORQUI   R073ATA.HORQUI%TYPE,
      HORSEX   R073ATA.HORSEX%TYPE,
      HORSAB   R073ATA.HORSAB%TYPE,
      HORDOM   R073ATA.HORDOM%TYPE);
  l_r073ata t_r073ata;

  /* AUTORIZAÇÃO DE SAÍDA */
  CURSOR c_r073asa IS
  SELECT DATASA, HORASA,HORTER FROM R073ASA WHERE NUMMAT = p_nummat AND DATASA = l_data_atual;
  TYPE t_r073asa IS RECORD(
      DATASA   R073ASA.DATASA%TYPE,
      HORASA   R073ASA.HORASA%TYPE,
      HORTER   R073ASA.HORTER%TYPE);
  l_r073asa t_r073asa;

  /*CURSOR para Verificar as Liberações de Faixas Horárias*/
  CURSOR c_r070lfh IS
  SELECT A.NUMCRA, A.DATLIB, A.HORINI, A.HORFIM FROM
             R070LFH A, R073HCH B WHERE A.DATLIB >= l_data_atual AND B.TIPCRA = l_tipcra AND B.STAATU = 1 AND
             A.NUMCRA = B.NUMCRA AND B.NUMMAT = p_nummat AND
             ((A.DATLIB > B.DATINI) OR (A.DATLIB = B.DATINI AND A.HORINI >= B.HORINI)) AND
             ((B.DATINI < l_data_atual) OR (B.DATINI = l_data_atual)) AND
             ((B.DATFIM > l_data_atual) OR (B.DATFIM = l_data_atual) OR B.DATFIM = l_data_zero);
  TYPE t_r070lfh IS RECORD(
    NUMCRA   R070LFH.NUMCRA%TYPE,
    DATLIB   R070LFH.DATLIB%TYPE,
    HORINI   R070LFH.HORINI%TYPE,
    HORFIM   R070LFH.HORFIM%TYPE);
  l_r070lfh t_r070lfh;

BEGIN
  /* Inicializa */
  l_data_zero := '31/12/1900,00:00:00';
  l_data_atual:= CURDATE();

  l_faidom_ace  := '';
  l_faiseg_ace  := '';
  l_faiter_ace  := '';
  l_faiqua_ace  := '';
  l_faiqui_ace  := '';
  l_faisex_ace  := '';
  l_faisab_ace  := '';
  l_faidom_pto  := '';
  l_faiseg_pto  := '';
  l_faiter_pto  := '';
  l_faiqua_pto  := '';
  l_faiqui_pto  := '';
  l_faisex_pto  := '';
  l_faisab_pto  := '';

  /* LOOP para pegar as disciplinas do aluno */
  FOREACH c_r073dia INTO l_r073dia.curalu,
                         l_r073dia.codfas,
                         l_r073dia.coddpf,
                         l_r073dia.tmaalu
  LOOP
      BEGIN
          SELECT HORSEG,HORTER,HORQUA,HORQUI,HORSEX,HORSAB,HORDOM
          INTO l_horseg,l_horter,l_horqua,l_horqui,l_horsex,l_horsab,l_hordom
          FROM R073DPF WHERE CURALU = l_r073dia.curalu AND CODFAS = l_r073dia.codfas
          AND CODDPF = l_r073dia.coddpf AND TMAALU = l_r073dia.tmaAlu;
      EXCEPTION
          WHEN OTHERS THEN EXIT;
      END;

      FOREACH c_r004fhr INTO l_r004fhr.codhor,
                             l_r004fhr.iniace,
                             l_r004fhr.fimace,
                             l_r004fhr.inipto,
                             l_r004fhr.fimpto
      LOOP
          SP_INTSTR(l_r004fhr.iniace,'HHMM',l_striac OUT);
          SP_INTSTR(l_r004fhr.fimace,'HHMM',l_strfac OUT);
          SP_INTSTR(l_r004fhr.inipto,'HHMM',l_stript OUT);
          SP_INTSTR(l_r004fhr.fimpto,'HHMM',l_strfpt OUT);

          IF  (l_r004fhr.codhor = l_hordom) THEN
              /* domingo */
              IF  ((LENGTH(l_faidom_ace)) < 49) OR ((LENGTH(l_faidom_ace) IS NULL)) THEN
                  l_faidom_ace := l_faidom_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faidom_pto)) < 49) OR ((LENGTH(l_faidom_pto) IS NULL)) THEN
                  l_faidom_pto := l_faidom_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_horseg) THEN
              /* segunda-feira */
              IF  ((LENGTH(l_faiseg_ace)) < 49) OR ((LENGTH(l_faiseg_ace) IS NULL)) THEN
                  l_faiseg_ace := l_faiseg_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiseg_pto)) < 49) OR ((LENGTH(l_faiseg_pto) IS NULL)) THEN
                  l_faiseg_pto := l_faiseg_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_horter) THEN
              /* terça-feira */
              IF  ((LENGTH(l_faiter_ace)) < 49) OR ((LENGTH(l_faiter_ace) IS NULL)) THEN
                  l_faiter_ace := l_faiter_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiter_pto)) < 49) OR ((LENGTH(l_faiter_pto) IS NULL)) THEN
                  l_faiter_pto := l_faiter_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_horqua) THEN
              /* quarta-feira */
              IF  ((LENGTH(l_faiqua_ace)) < 49) OR ((LENGTH(l_faiqua_ace) IS NULL)) THEN
                  l_faiqua_ace := l_faiqua_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiqua_pto)) < 49) OR ((LENGTH(l_faiqua_pto) IS NULL)) THEN
                  l_faiqua_pto := l_faiqua_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_horqui) THEN
              /* quinta-feira */
              IF  ((LENGTH(l_faiqui_ace)) < 49) OR ((LENGTH(l_faiqui_ace) IS NULL)) THEN
                  l_faiqui_ace := l_faiqui_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiqui_pto)) < 49) OR ((LENGTH(l_faiqui_pto) IS NULL)) THEN
                  l_faiqui_pto := l_faiqui_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_horsex) THEN
              /* sexta-feira */
              IF  ((LENGTH(l_faisex_ace)) < 49) OR ((LENGTH(l_faisex_ace) IS NULL)) THEN
                  l_faisex_ace := l_faisex_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faisex_pto)) < 49) OR ((LENGTH(l_faisex_pto) IS NULL)) THEN
                  l_faisex_pto := l_faisex_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_horsab) THEN
              /* sábado */
              IF  ((LENGTH(l_faisab_ace)) < 49) OR ((LENGTH(l_faisab_ace) IS NULL)) THEN
                  l_faisab_ace := l_faisab_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faisab_pto)) < 49) OR ((LENGTH(l_faisab_pto) IS NULL)) THEN
                  l_faisab_pto := l_faisab_pto || l_stript || l_strfpt;
              END IF;
          END IF;
      END LOOP; /* LOOP r004fhr */
  END LOOP; /* LOOP r073dia */

  /* Atividades do Aluno */
  /* LOOP para pegar as atividades do aluno */
  FOREACH c_r073ata INTO l_r073ata.nummat,
                         l_r073ata.DATINI,
                         l_r073ata.DATFIM,
                         l_r073ata.horseg,
                         l_r073ata.horter,
                         l_r073ata.horqua,
                         l_r073ata.horqui,
                         l_r073ata.horsex,
                         l_r073ata.horsab,
                         l_r073ata.hordom
  LOOP
      FOREACH c_r004fhr INTO l_r004fhr.codhor,
                             l_r004fhr.iniace,
                             l_r004fhr.fimace,
                             l_r004fhr.inipto,
                             l_r004fhr.fimpto
      LOOP
          SP_INTSTR(l_r004fhr.iniace,'HHMM',l_striac OUT);
          SP_INTSTR(l_r004fhr.fimace,'HHMM',l_strfac OUT);
          SP_INTSTR(l_r004fhr.inipto,'HHMM',l_stript OUT);
          SP_INTSTR(l_r004fhr.fimpto,'HHMM',l_strfpt OUT);

          IF  (l_r004fhr.codhor = l_r073ata.hordom) THEN
              /* domingo */
              IF  ((LENGTH(l_faidom_ace)) < 49) OR ((LENGTH(l_faidom_ace) IS NULL)) THEN
                  l_faidom_ace := l_faidom_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faidom_pto)) < 49) OR ((LENGTH(l_faidom_pto) IS NULL)) THEN
                  l_faidom_pto := l_faidom_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_r073ata.horseg) THEN
              /* segunda-feira */
              IF  ((LENGTH(l_faiseg_ace)) < 49) OR ((LENGTH(l_faiseg_ace) IS NULL)) THEN
                  l_faiseg_ace := l_faiseg_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiseg_pto)) < 49) OR ((LENGTH(l_faiseg_pto) IS NULL)) THEN
                  l_faiseg_pto := l_faiseg_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_r073ata.horter) THEN
              /* terça-feira */
              IF  ((LENGTH(l_faiter_ace)) < 49) OR ((LENGTH(l_faiter_ace) IS NULL)) THEN
                  l_faiter_ace := l_faiter_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiter_pto)) < 49) OR ((LENGTH(l_faiter_pto) IS NULL)) THEN
                  l_faiter_pto := l_faiter_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_r073ata.horqua) THEN
              /* quarta-feira */
              IF  ((LENGTH(l_faiqua_ace)) < 49) OR ((LENGTH(l_faiqua_ace) IS NULL)) THEN
                  l_faiqua_ace := l_faiqua_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiqua_pto)) < 49) OR ((LENGTH(l_faiqua_pto) IS NULL)) THEN
                  l_faiqua_pto := l_faiqua_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_r073ata.horqui) THEN
              /* quinta-feira */
              IF  ((LENGTH(l_faiqui_ace)) < 49) OR ((LENGTH(l_faiqui_ace) IS NULL)) THEN
                  l_faiqui_ace := l_faiqui_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faiqui_pto)) < 49) OR ((LENGTH(l_faiqui_pto) IS NULL)) THEN
                  l_faiqui_pto := l_faiqui_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_r073ata.horsex) THEN
              /* sexta-feira */
              IF  ((LENGTH(l_faisex_ace)) < 49) OR ((LENGTH(l_faisex_ace) IS NULL)) THEN
                  l_faisex_ace := l_faisex_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faisex_pto)) < 49) OR ((LENGTH(l_faisex_pto) IS NULL)) THEN
                  l_faisex_pto := l_faisex_pto || l_stript || l_strfpt;
              END IF;
          END IF;
          IF  (l_r004fhr.codhor = l_r073ata.horsab) THEN
              /* sábado */
              IF  ((LENGTH(l_faisab_ace)) < 49) OR ((LENGTH(l_faisab_ace) IS NULL)) THEN
                  l_faisab_ace := l_faisab_ace || l_striac || l_strfac;
              END IF;
              IF  ((LENGTH(l_faisab_pto)) < 49) OR ((LENGTH(l_faisab_pto) IS NULL)) THEN
                  l_faisab_pto := l_faisab_pto || l_stript || l_strfpt;
              END IF;
          END IF;
      END LOOP; /* LOOP r004fhr */
  END LOOP; /* LOOP r073ata */


  /* Autorização de Saída */
  FOREACH c_r073asa INTO l_r073asa.datasa,
                         l_r073asa.horasa,
                         l_r073asa.horter
  LOOP
      SP_INTSTR(l_r073asa.horasa,'HHMM',l_striac OUT);
      SP_INTSTR(l_r073asa.horter,'HHMM',l_strfac OUT);
      SP_INTSTR(l_r073asa.horasa,'HHMM',l_stript OUT);
      SP_INTSTR(l_r073asa.horter,'HHMM',l_strfpt OUT);

      l_dia_semana := DAYOFWEEK(l_r073asa.datasa);
