SP_UPDPRM
SP_ATUPRM
SP_INTSTR
SP_ATUTSI
h␀␀PROCEDURE R090VIS_ATUCON(P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_CODPRM NUMBER)
 IS

l_comando_nulo BOOLEAN;
  l_cracha       NUMBER(12);
  l_craaux       NUMBER(12);
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tipdoc       CHAR(1);
  l_tippes       CHAR(2);

BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();

  BEGIN
    SELECT NUMCRA INTO l_cracha
      FROM R090HCH
     WHERE R090HCH.TIPDOC = p_tipdoc AND
           R090HCH.NUMDOC = p_numdoc AND
           (R090HCH.DATINI < l_data_atual OR
            (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
           (R090HCH.DATFIM = l_data_zero OR
            R090HCH.DATFIM > l_data_atual OR
            (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
  EXCEPTION
    WHEN TOO_MANY_ROWS THEN
      RAISERROR 103 'Erro em R090VIS_BU - TOO MANY ROWS';
    WHEN NO_DATA_FOUND THEN
      l_cracha := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'ON-Line: Erro no SELECT R090HCH em R090VIS_BU.';
  END;

  /* se visitante possui cracha entao atualiza controle */
  IF   l_cracha <> 0 THEN

       /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
       SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
       IF (l_crapri = 0) THEN
           l_crapri := l_cracha;
       END IF;

       /* atualiza r070con */
       BEGIN
           UPDATE R070CON SET CODPRM=p_codprm, PRMSAB=p_codprm, PRMDOM=p_codprm, PRMFER=p_codprm
           WHERE NUMFIS = l_crapri;
       EXCEPTION
           WHEN OTHERS THEN NULL;
       END;
       /*Atualiza as permissões para os demais crachás da pessoa*/
       SP_UPDPRM(l_cracha, p_codprm, p_codprm, p_codprm, p_codprm, ' ', ' ', ' ');

       /*Atualiza Pend_Grupo*/
        IF (l_numsma > 0) THEN
            /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
            IF (l_tecpri = 3) THEN
                SP_ATUPRM(l_cracha, l_numsma, p_codprm, 0, 0, 0, p_codprm, p_codprm, p_codprm);
            ELSE
                SP_ATUPRM(l_crapri, l_numsma, p_codprm, 0, 0, 0, p_codprm, p_codprm, p_codprm);
            END IF;
        END IF;

       /*Montagem do Identificador*/
       l_tippes:= '04';
       SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
       /*Monta o Identificador da Pessoa*/
       l_idtpes := l_tippes||l_tipdoc||p_numdoc;
       /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_idtpes) > 22) THEN
              EXIT;
          END IF;
          l_idtpes := ' '||l_idtpes;
      END LOOP;
      /*Atualiza Controle*/
      SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
  END IF;
END		SENIOR;237SP_MAPFIS
SP_UPDPRM
SP_ATUPRM
SP_INTSTR
SP_ATUTSI
h␀␀PROCEDURE R090VIS_ATUCON(P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_CODPRM NUMBER)
 IS

l_comando_nulo BOOLEAN;
  l_cracha       NUMBER(12);
  l_craaux       NUMBER(12);
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);
  l_idtpes       VARCHAR2(23);
  l_tipdoc       CHAR(1);
  l_tippes       CHAR(2);

BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();

  BEGIN
    SELECT NUMCRA INTO l_cracha
      FROM R090HCH
     WHERE R090HCH.TIPDOC = p_tipdoc AND
           R090HCH.NUMDOC = p_numdoc AND
           (R090HCH.DATINI < l_data_atual OR
            (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
           (R090HCH.DATFIM = l_data_zero OR
            R090HCH.DATFIM > l_data_atual OR
            (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
  EXCEPTION
    WHEN TOO_MANY_ROWS THEN
      RAISERROR 103 'Erro em R090VIS_BU - TOO MANY ROWS';
    WHEN NO_DATA_FOUND THEN
      l_cracha := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'ON-Line: Erro no SELECT R090HCH em R090VIS_BU.';
  END;

  /* se visitante possui cracha entao atualiza controle */
  IF   l_cracha <> 0 THEN

       /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
       SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
       IF (l_crapri = 0) THEN
           l_crapri := l_cracha;
       END IF;

       /* atualiza r070con */
       BEGIN
           UPDATE R070CON SET CODPRM=p_codprm, PRMSAB=p_codprm, PRMDOM=p_codprm, PRMFER=p_codprm
           WHERE NUMFIS = l_crapri;
       EXCEPTION
           WHEN OTHERS THEN NULL;
       END;
       /*Atualiza as permissões para os demais crachás da pessoa*/
       SP_UPDPRM(l_cracha, p_codprm, p_codprm, p_codprm, p_codprm, ' ', ' ', ' ');

       /*Atualiza Pend_Grupo*/
        IF (l_numsma > 0) THEN
            /*Se o Crachá Principal foi o 3 então o icard é a "matrícula"*/
            IF (l_tecpri = 3) THEN
                SP_ATUPRM(l_cracha, l_numsma, p_codprm, 0, 0, 0, p_codprm, p_codprm, p_codprm);
            ELSE
                SP_ATUPRM(l_crapri, l_numsma, p_codprm, 0, 0, 0, p_codprm, p_codprm, p_codprm);
            END IF;
        END IF;

       /*Montagem do Identificador*/
       l_tippes:= '04';
       SP_INTSTR(p_tipdoc, '9', l_tipdoc OUT);
       /*Monta o Identificador da Pessoa*/
       l_idtpes := l_tippes||l_tipdoc||p_numdoc;
       /*Preenche o campo com espaços para completar 23 posições para o identificador da pessoa*/
      l_idtpes := lTrim(l_idtpes);
      l_idtpes := rTrim(l_idtpes);
      LOOP
          /*Controle do Loop.*/
          IF (Length(l_idtpes) > 22) THEN
              EXIT;
          END IF;
          l_idtpes := ' '||l_idtpes;
      END LOOP;
      /*Atualiza Controle*/
      SP_ATUTSI(l_idtpes, l_crapri, FALSE, FALSE, FALSE, FALSE);
  END IF;
END		SENIOR;21SP_MAPFIS
SP_UPDPRM
Õ␀␀PROCEDURE R090VIS_ATUCON(P_TIPDOC INTEGER,P_NUMDOC VARCHAR2(20),P_CODPRM NUMBER)
 IS

l_comando_nulo BOOLEAN;
  l_cracha       NUMBER(12);
  l_craaux       NUMBER(12);
  l_data_atual   DATE;
  l_data_zero    DATE;
  l_hora_atual   NUMBER(4);
  l_numbar       NUMBER(12);
  l_numpro       NUMBER(12);
  l_numsma       NUMBER(12);
  l_crapri       NUMBER(12);
  l_tecpri       NUMBER(1);  
BEGIN
  l_data_zero  := '31/12/1900,00:00:00';
  l_hora_atual := HOUR(CURTIME())*60 + MINUTE(CURTIME());
  l_data_atual := CURDATE();

  BEGIN
    SELECT NUMCRA INTO l_cracha
      FROM R090HCH
     WHERE R090HCH.TIPDOC = p_tipdoc AND
           R090HCH.NUMDOC = p_numdoc AND
           (R090HCH.DATINI < l_data_atual OR
            (R090HCH.DATINI = l_data_atual AND R090HCH.HORINI <= l_hora_atual)) AND
           (R090HCH.DATFIM = l_data_zero OR
            R090HCH.DATFIM > l_data_atual OR
            (R090HCH.DATFIM = l_data_atual AND R090HCH.HORFIM >= l_hora_atual));
  EXCEPTION
    WHEN TOO_MANY_ROWS THEN
      RAISERROR 103 'Erro em R090VIS_BU - TOO MANY ROWS';
    WHEN NO_DATA_FOUND THEN
      l_cracha := 0;
    WHEN OTHERS THEN
      RAISERROR 103 'ON-Line: Erro no SELECT R090HCH em R090VIS_BU.';
  END;

  /* se visitante possui cracha entao atualiza controle */
  IF   l_cracha <> 0 THEN

       /*Atualiza o Crachá Principal e obtem o(s) numero(s) físico(s). */
       SP_MAPFIS(l_cracha, l_numbar OUT, l_numpro OUT, l_numsma OUT, l_tecpri OUT, l_crapri OUT);
       IF (l_crapri = 0) THEN
           l_crapri := l_cracha;
       END IF;

       /* atualiza r070con */
       BEGIN
           UPDATE R070CON SET CODPRM=p_codprm, PRMSAB=p_codprm, PRMDOM=p_codprm, PRMFER=p_codprm
           WHERE NUMFIS = l_crapri;
       EXCEPTION
           WHEN OTHERS THEN NULL;
       END;
       /*Atualiza as permissões para os demais crachás da pessoa*/
       SP_UPDPRM(l_cracha, p_codprm, p_codprm, p_codprm, p_codprm, ' ', ' ', ' ');
  END IF;
END		SENIOR;22SP_MAPFIS
