DECLARE
l_xUtiPos CHAR;
  l_xEstPos NUMBER(3);
  l_xCodPlv NUMBER(4);
BEGIN
  /* Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
  QL_UTIPOSTRA(:NEW.NUMEMP, :NEW.DATRQU, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
  IF (l_xUtiPos = 'S') THEN
    QL_PROCERQU('I', :NEW.NUMEMP, l_xEstPos, l_xCodPlv, :NEW.POSTRA, :NEW.QTDRQU, :NEW.DATRQU, :NEW.SITRQU, :NEW.SITRQU, :NEW.CODTAP, :NEW.CODRQU);
  END IF;
END␀4á␀␀		SENIOR;0ò␀␀

TRIGGER R126RQU_EU AFTER UPDATE ON R126RQU FOR EACH ROW

DECLARE
l_xUtiPos CHAR;
  l_xEstPos NUMBER(3);
  l_xCodPlv NUMBER(4);
BEGIN
  /* CODTAP - Tipo atuação
     POSTRA - Posto de trabalho
     QTDRQU - Quantidade de vagas
     SITRQU - Situação
  Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
  QL_UTIPOSTRA(:NEW.NUMEMP, :NEW.DATRQU, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
  IF (l_xUtiPos = 'S') THEN
    IF ((:NEW.DATRQU <> :OLD.DATRQU) OR (:NEW.POSTRA <> :OLD.POSTRA) OR (:NEW.QTDRQU <> :OLD.QTDRQU) OR (:NEW.CODTAP <> :OLD.CODTAP)) THEN
      /* Necessário primeiramente creditar e depois efetuar o débito, o QL_AJUQTDEFE não está negativando o QTDRQU */
      QL_PROCERQU('U', :NEW.NUMEMP, l_xEstPos, l_xCodPlv, :NEW.POSTRA, :NEW.QTDRQU, :NEW.DATRQU, :NEW.SITRQU, :OLD.SITRQU, :NEW.CODTAP, :NEW.CODRQU);
      QL_PROCERQU('O', :OLD.NUMEMP, l_xEstPos, l_xCodPlv, :OLD.POSTRA, :OLD.QTDRQU, :OLD.DATRQU, :OLD.SITRQU, :OLD.SITRQU, :OLD.CODTAP, :OLD.CODRQU);
    ELSE
      IF (:NEW.SITRQU <> :OLD.SITRQU) THEN
        QL_PROCERQU('S', :NEW.NUMEMP, l_xEstPos, l_xCodPlv, :NEW.POSTRA, :NEW.QTDRQU, :NEW.DATRQU, :NEW.SITRQU, :OLD.SITRQU, :NEW.CODTAP, :NEW.CODRQU);
      END IF;
    END IF;
  END IF;
END␀2á␀␀		SENIOR;0␀␀

TRIGGER R126RQU_ED AFTER DELETE ON R126RQU FOR EACH ROW

DECLARE
l_xUtiPos CHAR;
  l_xEstPos NUMBER(3);
  l_xCodPlv NUMBER(4);
BEGIN
  /* 0 - Não iniciada
     1 - Em andamento
     2 - Cancelada
     3 - Finalizada
     4 - Proposta
     5 - Suspensa
  Caso trabalho com postos de trabalho atualizamos o efetivo por posto */
  QL_UTIPOSTRA(:OLD.NUMEMP, :OLD.DATRQU, l_xUtiPos OUT, l_xEstPos OUT, l_xCodPlv OUT);
  IF (l_xUtiPos = 'S') AND (:OLD.SITRQU NOT IN(5,2)) THEN
    QL_PROCERQU('D', :OLD.NUMEMP, l_xEstPos, l_xCodPlv, :OLD.POSTRA, :OLD.QTDRQU, :OLD.DATRQU, :OLD.SITRQU, :OLD.SITRQU, :OLD.CODTAP, :OLD.CODRQU);
  END IF;
